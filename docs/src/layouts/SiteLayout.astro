---
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
	active?: 'explore' | 'categories' | 'browse';
}

const { title, description, active = 'explore' } = Astro.props;
const base = import.meta.env.BASE_URL;

const navItems = [
	{ id: 'explore', label: 'Explore Recipes', href: base },
	{ id: 'categories', label: 'Categories', href: `${base}#highlights` },
	{ id: 'browse', label: 'Browse Index', href: `${base}#browse` },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="site-header-inner">
				<a class="brand" href={base} aria-label="Pepper Kitchen home">
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path
								d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
							></path>
						</svg>
					</span>
					<span>
						<span class="brand-name">Pepper Kitchen</span>
						<span class="brand-tag">Recipe &amp; Meal Hub</span>
					</span>
				</a>

				<nav class="site-nav" aria-label="Global navigation">
					{navItems.map((item) => (
						<a
							class:list={['nav-link', item.id === active && 'is-active']}
							href={item.href}
							aria-current={item.id === active ? 'page' : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>

				<div class="header-actions">
					<a class="btn btn-primary" href={`${base}#browse`}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path
								d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						<span>Browse all</span>
					</a>
				</div>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="site-footer-inner">
				<div class="footer-brand-row">
					<div class="footer-brand">
						<span class="footer-mark" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="currentColor">
								<path
									d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
								></path>
							</svg>
						</span>
						Pepper Kitchen &amp; Meal Planner
					</div>
					<nav class="footer-nav" aria-label="Footer">
						<a href={base}>Recipe catalog</a>
						<a href={`${base}privacy-policy/`}>Privacy Policy</a>
						<a href={`${base}terms-and-conditions/`}>Terms &amp; Conditions</a>
					</nav>
				</div>
				<div class="footer-meta">
					<p>&copy; 2026 Pepper Meal Planner</p>
					<p>Recipe catalog built from the pepper-meal-recipes repository indexes.</p>
				</div>
			</div>
		</footer>
	</body>
</html>

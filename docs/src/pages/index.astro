---
import SiteLayout from '../layouts/SiteLayout.astro';
import recipesIndex from '../../../recipes/v1/indexes/recipes.index.json';
import categoriesIndex from '../../../recipes/v1/indexes/categories.index.json';
import tagsIndex from '../../../recipes/v1/indexes/tags.index.json';
import ingredientsIndex from '../../../recipes/v1/indexes/ingredients.index.json';

const base = import.meta.env.BASE_URL;

const recipes = [...recipesIndex.recipes].sort((a, b) => a.name.localeCompare(b.name));
const categoryNames = new Map(categoriesIndex.categories.map((category) => [category.slug, category.name]));

const categories = [...categoriesIndex.categories]
	.filter((category) => category.recipe_count > 1)
	.sort((a, b) => b.recipe_count - a.recipe_count)
	.slice(0, 8);

const tags = [...tagsIndex.tags]
	.filter((tag) => tag.recipe_count > 1)
	.sort((a, b) => b.recipe_count - a.recipe_count)
	.slice(0, 10);

const sortedTimes = recipes
	.map((recipe) => recipe.total_time_minutes ?? 0)
	.filter((minutes) => minutes > 0)
	.sort((a, b) => a - b);

const medianMinutes = sortedTimes.length ? sortedTimes[Math.floor(sortedTimes.length / 2)] : 0;
const quickMeals = sortedTimes.filter((minutes) => minutes <= 30).length;

const stats = [
	{ label: 'Tested recipes', value: recipes.length.toLocaleString() },
	{ label: 'Categories', value: categoriesIndex.categories.length.toLocaleString() },
	{ label: 'Cuisine tags', value: tagsIndex.tags.length.toLocaleString() },
	{ label: 'Ingredients', value: ingredientsIndex.ingredients.length.toLocaleString() },
];

const updatedLabel = (() => {
	const generated = new Date(recipesIndex.generated_at);
	return Number.isNaN(generated.getTime())
		? 'Indexed catalog'
		: generated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
})();

const titleCase = (value: string) =>
	value
		.split(/([\s_-]+)/)
		.map((part) => (/[\s_-]+/.test(part) ? part : part.charAt(0).toUpperCase() + part.slice(1).toLowerCase()))
		.join('');

const difficultyLabel = (value: string | null | undefined) => (value ? titleCase(value) : '');
---

<SiteLayout
	title="Pepper Kitchen · Recipe & Meal Hub"
	description="Browse the Pepper Meal Planner recipe index by time, category, or ingredients."
>
	<main class="catalog" id="main">
		<svg class="icon-sprite" aria-hidden="true" focusable="false">
			<symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<polyline points="12 6 12 12 16 14"></polyline>
			</symbol>
			<symbol id="i-bookmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path
					d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</symbol>
			<symbol id="i-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
			</symbol>
		</svg>

		<!-- Hero + collection snapshot -->
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-main">
				<span class="pill hero-pill">
					<span class="hero-pulse" aria-hidden="true"></span>
					Recipe index &amp; discovery
				</span>
				<h1 id="hero-title">
					Find a recipe by <span class="mark">time</span>, <span class="mark">category</span>, or
					<span class="mark">ingredients</span>.
				</h1>
				<p class="hero-lede">
					Search {recipes.length.toLocaleString()} kitchen-tested recipes, jump into popular categories and
					dietary tags, or open a dish straight from the browse grid when you already know what to cook.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary btn-lg" href="#browse">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path
								d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						Start browsing
					</a>
					<a class="btn btn-outline btn-lg" href="#highlights">Explore category tags</a>
				</div>
			</div>

			<aside class="snapshot panel" aria-labelledby="snapshot-title">
				<div class="snapshot-head">
					<h2 id="snapshot-title">Collection snapshot</h2>
					<span class="pill pill-live">{updatedLabel}</span>
				</div>
				<div class="stat-grid">
					{stats.map((stat) => (
						<div class="stat-card">
							<span class="stat-value">{stat.value}</span>
							<span class="stat-label">{stat.label}</span>
						</div>
					))}
				</div>
				<div class="median-card">
					<div class="median-copy">
						<span class="median-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"></circle>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
						</span>
						<div>
							<span class="median-value">{medianMinutes} mins</span>
							<span class="median-label">Median prep &amp; cook</span>
						</div>
					</div>
					<span class="median-badge">{quickMeals.toLocaleString()} under 30 min</span>
				</div>
			</aside>
		</section>

		<!-- Quick picks -->
		<section class="panel quick-picks" id="highlights" aria-labelledby="collections-heading">
			<div class="section-head">
				<div>
					<span class="eyebrow">Quick jump</span>
					<h2 id="collections-heading">Top categories &amp; dietary tags</h2>
				</div>
				<p class="section-hint">Click any pill to instantly apply the filter</p>
			</div>

			<div class="quick-body">
				<div>
					<span class="group-label">Popular meal types</span>
					<div class="chip-row">
						{categories.map((category, index) => (
							<button
								class:list={['chip', index === 0 && 'chip-featured']}
								type="button"
								data-category={category.slug}
								aria-pressed="false"
							>
								<span>{category.name}</span>
								<span class="chip-count">{category.recipe_count.toLocaleString()}</span>
							</button>
						))}
					</div>
				</div>

				<div class="tag-group">
					<span class="group-label">Trending themes &amp; kitchen favorites</span>
					<div class="tag-row">
						{tags.map((tag) => (
							<button class="tag-chip" type="button" data-tag={tag.slug} aria-pressed="false">
								#{titleCase(tag.name)} <span>({tag.recipe_count.toLocaleString()})</span>
							</button>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Sticky search + filters -->
		<section class="toolbar" id="browse" aria-label="Search and filter recipes">
			<div class="toolbar-inner">
				<div class="search-wrap">
					<span class="search-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round"
							></path>
						</svg>
					</span>
					<label class="sr-only" for="search">Search recipes</label>
					<input
						class="field search-field"
						id="search"
						type="search"
						autocomplete="off"
						placeholder="Search by recipe name, cuisine, ingredient, or keyword…"
					/>
					<button class="search-shortcut" id="search-shortcut" type="button" aria-label="Focus search">
						⌘K
					</button>
				</div>

				<div class="filter-row">
					<label class="sr-only" for="category-filter">Filter by category</label>
					<select class="field" id="category-filter">
						<option value="">All categories</option>
						{categoriesIndex.categories
							.slice()
							.sort((a, b) => a.name.localeCompare(b.name))
							.map((category) => <option value={category.slug}>{category.name}</option>)}
					</select>

					<label class="sr-only" for="tag-filter">Filter by tag</label>
					<select class="field" id="tag-filter">
						<option value="">All tags</option>
						{tagsIndex.tags
							.slice()
							.sort((a, b) => a.name.localeCompare(b.name))
							.map((tag) => <option value={tag.slug}>{tag.name}</option>)}
					</select>

					<label class="sr-only" for="difficulty-filter">Filter by difficulty</label>
					<select class="field" id="difficulty-filter">
						<option value="">Any difficulty</option>
						<option value="easy">Easy</option>
						<option value="medium">Medium</option>
						<option value="hard">Hard</option>
					</select>

					<label class="sr-only" for="time-filter">Filter by cook time</label>
					<select class="field" id="time-filter">
						<option value="">Any time</option>
						<option value="15">Under 15 min</option>
						<option value="30">Under 30 min</option>
						<option value="60">Under 1 hour</option>
						<option value="slow">Slow cook (2h+)</option>
					</select>

					<button class="btn btn-outline reset-btn" id="reset-filters" type="button">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path
								d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						Reset
					</button>
				</div>

				<div class="result-bar">
					<span class="result-summary" id="result-summary">Showing all recipes.</span>
					<span class="result-sort">Sorted by: <strong>Recipe name</strong></span>
				</div>
			</div>
		</section>

		<!-- Recipe grid -->
		<section class="recipe-grid" id="recipe-grid" aria-label="Recipes">
			{recipes.map((recipe, index) => {
				const categoryLabel = recipe.category_slugs.map((slug) => categoryNames.get(slug) ?? slug)[0] ?? recipe.recipe_type ?? 'Recipe';
				const searchTerms = [
					recipe.ingredient_names.join(' '),
					recipe.category_slugs.join(' '),
					recipe.tag_slugs.join(' '),
					recipe.difficulty ?? '',
					recipe.recipe_type ?? '',
				]
					.join(' ')
					.replace(/-/g, ' ')
					.toLowerCase();
				const timeLabel = recipe.total_time_minutes ? `${recipe.total_time_minutes} min` : 'Time n/a';
				const initialImage = index < 30;

				return (
					<article
						class="recipe-card"
						data-search={searchTerms}
						data-categories={recipe.category_slugs.join(',')}
						data-tags={recipe.tag_slugs.join(',')}
						data-difficulty={recipe.difficulty ?? ''}
						data-time={recipe.total_time_minutes ?? ''}
					>
						<div class="card-media">
							{recipe.image_url ? (
								<img
									src={initialImage ? recipe.image_url : undefined}
									data-src={recipe.image_url}
									alt=""
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="card-media-fallback" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="currentColor">
										<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
									</svg>
								</div>
							)}
							<div class="card-badges">
								<span class="badge badge-type">{categoryLabel}</span>
								{recipe.difficulty ? (
									<span class:list={['badge', 'badge-difficulty', `is-${recipe.difficulty}`]}>
										{difficultyLabel(recipe.difficulty)}
									</span>
								) : null}
							</div>
							<button
								class="bookmark-btn"
								type="button"
								data-bookmark={recipe.slug}
								aria-pressed="false"
								aria-label={`Save ${recipe.name}`}
							>
								<svg class="icon" aria-hidden="true"><use href="#i-bookmark"></use></svg>
							</button>
						</div>

						<div class="card-body">
							<div class="card-meta">
								<span class="time-chip">
									<svg class="icon" aria-hidden="true"><use href="#i-clock"></use></svg>
									{timeLabel}
								</span>
								<span class="meta-dot" aria-hidden="true">•</span>
								<span>{recipe.ingredient_names.length} ingredients</span>
							</div>
							<h3 class="card-title">{recipe.name}</h3>
							<p class="card-description">{recipe.brief_description}</p>
						</div>

						<div class="card-foot">
							<span class="card-servings">
								{recipe.servings ? `Serves ${recipe.servings}` : titleCase(recipe.recipe_type ?? 'Recipe')}
							</span>
							<span class="card-cta">
								View recipe
								<svg class="icon" aria-hidden="true"><use href="#i-arrow"></use></svg>
							</span>
						</div>

						<a class="card-hit" href={`${base}recipes/${recipe.slug}/`} aria-label={`Open ${recipe.name}`}></a>
					</article>
				);
			})}
		</section>

		<div class="load-more">
			<button class="btn btn-outline btn-lg load-more-btn" id="load-more-btn" type="button">
				<span id="load-more-label">Load 24 more recipes</span>
			</button>
			<span class="load-more-hint" id="load-more-hint">Viewing 24 of {recipes.length.toLocaleString()} recipes</span>
		</div>
	</main>

	<script is:inline>
		const BATCH_SIZE = 24;

		const searchInput = document.querySelector('#search');
		const searchShortcut = document.querySelector('#search-shortcut');
		const categoryFilter = document.querySelector('#category-filter');
		const tagFilter = document.querySelector('#tag-filter');
		const difficultyFilter = document.querySelector('#difficulty-filter');
		const timeFilter = document.querySelector('#time-filter');
		const resetButton = document.querySelector('#reset-filters');
		const resultSummary = document.querySelector('#result-summary');
		const loadMoreBtn = document.querySelector('#load-more-btn');
		const loadMoreLabel = document.querySelector('#load-more-label');
		const loadMoreHint = document.querySelector('#load-more-hint');
		const cards = Array.from(document.querySelectorAll('.recipe-card'));
		const normalize = (value) => String(value ?? '').trim().toLowerCase();

		for (const card of cards) {
			card.dataset.fullSearch = normalize(
				[
					card.dataset.search,
					card.querySelector('.card-title')?.textContent,
					card.querySelector('.card-description')?.textContent,
				].join(' '),
			);
		}

		let visibleLimit = BATCH_SIZE;
		let matchingCards = [];

		/* ------------------------------- rendering ----------------------------- */
		const render = () => {
			const totalMatching = matchingCards.length;
			const renderedCount = Math.min(visibleLimit, totalMatching);

			for (const card of cards) {
				card.hidden = true;
			}

			for (let i = 0; i < renderedCount; i++) {
				const card = matchingCards[i];
				card.hidden = false;

				const image = card.querySelector('img[data-src]');
				if (image && !image.hasAttribute('src')) {
					image.src = image.dataset.src;
				}
			}

			if (totalMatching === 0) {
				resultSummary.textContent = 'No recipes found matching your criteria.';
			} else if (renderedCount < totalMatching) {
				resultSummary.textContent = `Showing ${renderedCount.toLocaleString()} of ${totalMatching.toLocaleString()} matching recipes`;
			} else if (totalMatching === cards.length) {
				resultSummary.textContent = `Showing all ${totalMatching.toLocaleString()} recipes`;
			} else {
				resultSummary.textContent = `Showing all ${totalMatching.toLocaleString()} matching recipes`;
			}

			loadMoreLabel.textContent = `Load ${Math.min(BATCH_SIZE, totalMatching - renderedCount).toLocaleString()} more recipes`;
			loadMoreHint.textContent =
				totalMatching === 0
					? 'No recipes to show'
					: `Viewing ${renderedCount.toLocaleString()} of ${totalMatching.toLocaleString()} recipes`;

			const hasMore = renderedCount < totalMatching;
			loadMoreBtn.hidden = !hasMore;
		};

		const matchesTime = (minutes, filter) => {
			if (!filter) return true;
			if (filter === 'slow') return minutes >= 120;
			const limit = Number(filter);
			return Number.isFinite(limit) ? minutes > 0 && minutes <= limit : true;
		};

		const filterRecipes = () => {
			const query = normalize(searchInput.value);
			const selectedCategory = normalize(categoryFilter.value);
			const selectedTag = normalize(tagFilter.value);
			const selectedDifficulty = normalize(difficultyFilter.value);
			const selectedTime = normalize(timeFilter.value);

			matchingCards = cards.filter((card) => {
				const searchTerms = card.dataset.fullSearch ?? '';
				const categories = (card.dataset.categories ?? '').split(',').filter(Boolean);
				const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
				const difficulty = card.dataset.difficulty ?? '';
				const minutes = Number(card.dataset.time ?? 0);

				return (
					(!query || searchTerms.includes(query)) &&
					(!selectedCategory || categories.includes(selectedCategory)) &&
					(!selectedTag || tags.includes(selectedTag)) &&
					(!selectedDifficulty || difficulty === selectedDifficulty) &&
					matchesTime(minutes, selectedTime)
				);
			});

			for (const chip of document.querySelectorAll('[data-category]')) {
				const isActive = Boolean(selectedCategory) && chip.dataset.category === selectedCategory;
				chip.classList.toggle('is-active', isActive);
				chip.setAttribute('aria-pressed', String(isActive));
			}

			for (const chip of document.querySelectorAll('[data-tag]')) {
				const isActive = Boolean(selectedTag) && chip.dataset.tag === selectedTag;
				chip.classList.toggle('is-active', isActive);
				chip.setAttribute('aria-pressed', String(isActive));
			}

			visibleLimit = BATCH_SIZE;
			render();
		};

		const loadMore = () => {
			if (visibleLimit < matchingCards.length) {
				visibleLimit += BATCH_SIZE;
				render();
			}
		};

		loadMoreBtn.addEventListener('click', loadMore);

		for (const control of [searchInput, categoryFilter, tagFilter, difficultyFilter, timeFilter]) {
			control.addEventListener('input', filterRecipes);
			control.addEventListener('change', filterRecipes);
		}

		for (const chip of document.querySelectorAll('[data-category], [data-tag]')) {
			chip.addEventListener('click', () => {
				const select = chip.dataset.category ? categoryFilter : tagFilter;
				const value = chip.dataset.category ?? chip.dataset.tag;

				select.value = select.value === value ? '' : value;
				filterRecipes();
			});
		}

		resetButton.addEventListener('click', () => {
			searchInput.value = '';
			categoryFilter.value = '';
			tagFilter.value = '';
			difficultyFilter.value = '';
			timeFilter.value = '';
			filterRecipes();
		});

		const focusSearch = () => {
			searchInput.focus();
			searchInput.select();
		};

		searchShortcut.addEventListener('click', focusSearch);

		document.addEventListener('keydown', (event) => {
			if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				focusSearch();
			}
		});

		filterRecipes();
	</script>

	<script>
		import '../scripts/bookmarks';
	</script>

	<style is:global>
		.catalog {
			width: 100%;
			max-width: var(--page-width);
			margin: 0 auto;
			padding: 2rem var(--gutter) 1rem;
			display: flex;
			flex-direction: column;
			gap: 2.5rem;
		}

		.icon-sprite {
			position: absolute;
			width: 0;
			height: 0;
			overflow: hidden;
		}

		.icon {
			width: 1rem;
			height: 1rem;
			flex-shrink: 0;
		}

		/* ------------------------------- hero -------------------------------- */

		.hero {
			display: grid;
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
			gap: 1.5rem;
			align-items: stretch;
		}

		.hero-main {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 2rem;
			padding: clamp(1.5rem, 4vw, 2.5rem);
			border: 1px solid var(--warm-200);
			border-radius: var(--radius-lg);
			background: linear-gradient(135deg, #fff 0%, #fff 55%, rgba(254, 216, 185, 0.35) 100%);
			box-shadow: var(--shadow-xs);
		}

		.hero-pill {
			letter-spacing: 0.07em;
			font-size: 0.6875rem;
			align-self: flex-start;
		}

		.hero-pulse {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 999px;
			background: var(--brand-500);
			box-shadow: 0 0 0 3px rgba(224, 93, 38, 0.18);
		}

		.hero h1 {
			margin-top: 1rem;
			font-size: clamp(2rem, 3.6vw, 3.1rem);
			font-weight: 800;
			max-width: 22ch;
			line-height: 1.08;
		}

		.hero h1 .mark {
			color: var(--brand-600);
			text-decoration: underline;
			text-decoration-color: var(--brand-300);
			text-decoration-thickness: 4px;
			text-underline-offset: 5px;
		}

		.hero-lede {
			margin-top: 1rem;
			max-width: 60ch;
			font-size: 1.0625rem;
			line-height: 1.65;
			color: var(--warm-600);
		}

		.hero-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.85rem;
			margin-top: 0.5rem;
		}

		/* ------------------------------ snapshot ----------------------------- */

		.snapshot {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 1.25rem;
			padding: 1.5rem;
		}

		.snapshot-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--warm-100);
		}

		.snapshot-head h2 {
			font-family: var(--font-sans);
			font-size: 0.6875rem;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--warm-600);
		}

		.stat-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.stat-card {
			padding: 0.9rem;
			border: 1px solid var(--warm-200);
			border-radius: var(--radius-md);
			background: rgba(251, 250, 248, 0.75);
			transition: border-color 160ms ease;
		}

		.stat-card:hover {
			border-color: var(--brand-300);
		}

		.stat-value {
			display: block;

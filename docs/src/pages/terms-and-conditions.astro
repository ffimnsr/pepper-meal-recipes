---
import LegalPage from '../components/LegalPage.astro';

const lastUpdated = 'June 18, 2026';
const base = import.meta.env.BASE_URL;

const sections = [
	{
		heading: 'Use of the service',
		paragraphs: [
			'PMP Recipes provides recipe browsing and related content for personal, non-commercial use unless otherwise stated.',
		],
	},
	{
		heading: 'Content',
		paragraphs: [
			'Recipe names, descriptions, and related catalog information are provided as-is. We may update, remove, or reorganize content at any time.',
		],
	},
	{
		heading: 'No warranty',
		paragraphs: [
			'The service is provided without warranties of any kind, express or implied. We do not guarantee that the app or website will always be available or error-free.',
		],
	},
	{
		heading: 'Limitation of liability',
		paragraphs: [
			'To the maximum extent permitted by law, we are not liable for damages arising from use of the service or reliance on its content.',
		],
	},
	{
		heading: 'Changes to these terms',
		paragraphs: [
			'We may update these terms from time to time. Continued use of the service means you accept the updated terms.',
		],
	},
];
---

<LegalPage
	heading="Terms and Conditions"
	description="Terms and conditions for the Pepper Kitchen recipe catalog."
	updated={lastUpdated}
	sections={sections}
	related={{ label: 'Read the privacy policy', href: `${base}privacy-policy/` }}
/>

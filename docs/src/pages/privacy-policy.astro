---
import LegalPage from '../components/LegalPage.astro';

const lastUpdated = 'June 18, 2026';
const base = import.meta.env.BASE_URL;

const sections = [
	{
		heading: 'Summary',
		paragraphs: [
			'PMP Recipes is designed to help you browse and save recipes without building a user profile. The app does not use advertising SDKs, analytics SDKs, or background tracking.',
		],
	},
	{
		heading: 'What the app stores on your device',
		paragraphs: [
			'Some settings, saved recipes, or browsing state may be stored locally on your device so the app can remember your preferences and work offline where possible. This local data stays on your device unless you choose to remove it.',
		],
	},
	{
		heading: 'What we do not collect',
		paragraphs: [
			'We do not intentionally collect account information, contact lists, location data, ad identifiers, usage analytics, crash telemetry, payment details, or personal recipe preferences from your device.',
		],
	},
	{
		heading: 'Network activity',
		paragraphs: [
			'If the app requests recipe data, images, or related content from the internet, those requests are used only to load the content you asked to view. The app does not send your personal saved data as part of those requests.',
		],
	},
	{
		heading: 'Third-party services',
		paragraphs: [
			'PMP Recipes does not rely on third-party advertising networks or behavioral tracking services. If the app uses external libraries or hosted content, they are used only for basic app functionality.',
		],
	},
	{
		heading: 'Data sharing',
		paragraphs: [
			'We do not sell personal information. We do not share your local app data with data brokers, advertisers, or analytics providers.',
		],
	},
	{
		heading: "Children's privacy",
		paragraphs: [
			'Because the app is not designed to collect personal data, it does not knowingly collect information from children.',
		],
	},
	{
		heading: 'Changes to this policy',
		paragraphs: [
			'If our privacy practices change in a meaningful way, this policy will be updated before the change is released.',
		],
	},
	{
		heading: 'Contact',
		paragraphs: [
			'If you have questions about this policy, please contact the app publisher through the support channel listed for the app.',
		],
	},
];
---

<LegalPage
	heading="Privacy Policy"
	description="Privacy policy for the Pepper Kitchen recipe catalog, including what is stored on your device, what we do not collect, and how we handle network requests."
	updated={lastUpdated}
	sections={sections}
	related={{ label: 'Read the terms & conditions', href: `${base}terms-and-conditions/` }}
/>

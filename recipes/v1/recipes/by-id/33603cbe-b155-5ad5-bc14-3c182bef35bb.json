  "id": "33603cbe-b155-5ad5-bc14-3c182bef35bb",
  "slug": "bracciole-flank-steak-rolls",
  "name": "Bracciole (Flank Steak Rolls)",
  "recipe_type": "main",
  "brief_description": "Parsley, hard-boiled egg, and Parmesan cheese are rolled into a flank steak and simmered in a tomato sauce for a delicious Italian meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium heat. Add onion; cook and stir until tender, about 10 minutes. Season with 1 teaspoon salt and 1 teaspoon pepper."
    },
    {
      "position": 2,
      "text": "Combine parsley, Parmesan cheese, garlic, hard-boiled egg, 1 pinch salt, and 1 pinch black pepper in a bowl; drizzle in about 1 tablespoon olive oil, stirring continuously, until a sticky consistency is reached."
    },
    {
      "position": 3,
      "text": "Spread parsley filling in a thin layer on flank steak. Roll steak in a jelly-roll style; fasten closed with toothpicks to contain filling."
    },
    {
      "position": 4,
      "text": "Add remaining 1 tablespoon olive oil to skillet with onion mixture over medium heat, then add steak roll, turning until browned on all sides, 2 to 3 minutes per side. Add tomato sauce, chopped tomato, and sugar; simmer over very low heat until steak cooked through and sauce slightly reduced, 1 to 1 1/2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

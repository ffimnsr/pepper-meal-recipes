  "id": "56b0c8fb-f7c2-50c5-9996-2860089bf139",
  "slug": "cream-of-coconut-pineapple-upside-down-cake",
  "name": "Cream of Coconut Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "Sweeten any special occasion with this tropical upside-down cake that tastes like a fluffy pina colada.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 baking pans."
    },
    {
      "position": 2,
      "text": "Place brown sugar, 1/4 cup butter, and coconut flakes in a microwave-safe container and heat until warm, about 2 minutes. Mix into a paste."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, and salt in a separate bowl. Whip egg whites in a metal bowl with a clean electric mixer until stiff peaks are formed."
    },
    {
      "position": 4,
      "text": "Beat 1/2 cup white sugar and 7 1/3 tablespoons butter in a bowl with an electric mixer until creamy. Add remaining 1/2 cup white sugar, cream of coconut, reserved pineapple juice, egg yolks, and vanilla extract; mix thoroughly. Add the flour mixture; stir batter slowly until fully combined. Fold in the whipped egg whites using a spatula."
    },
    {
      "position": 5,
      "text": "Spread the brown sugar paste over the bottoms of the prepared pans. Arrange pineapple chunks on top. Pour in the batter."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tops are brown and crisp and a toothpick inserted into the centers comes out clean, about 1 hour. Let cool, about 25 minutes. Flip cakes over onto a serving plate and out of the baking pans."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 62,
  "preparation_time_minutes": 20,

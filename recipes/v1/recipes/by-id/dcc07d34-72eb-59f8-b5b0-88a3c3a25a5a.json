  "id": "dcc07d34-72eb-59f8-b5b0-88a3c3a25a5a",
  "slug": "slow-cooker-tuscan-chicken-meatballs-with-gnocchi-recipe-8718448",
  "name": "Slow Cooker Tuscan Chicken Meatballs with Gnocchi",
  "recipe_type": "main",
  "brief_description": "Slow cooker Tuscan chicken meatballs with gnocchi are the perfect comfort meal for fall and autumn nights.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "For meatballs, preheat the oven to 375 degrees F (190 degrees C). Line a 15x10x1-inch baking pan with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine egg, bread crumbs, onion, 2 tablespoons dried tomatoes, milk, 1 tablespoon Parmesan cheese, garlic, 1/2 teaspoon Italian seasoning, salt and pepper in a bowl."
    },
    {
      "position": 4,
      "text": "Add chicken, mix well. Shape mixture into 20 1 1/2-inch meatballs. Place in the prepared baking pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set and lightly browned (they don\u2019t have to be done at this point), about 15 minutes."
    },
    {
      "position": 6,
      "text": "Add meatballs to a 3 1/2- to 4-quart slow cooker. Add broth, cream, wine, 1/3 cup dried tomatoes, and 1/2 teaspoon Italian seasoning. Cover and cook on Low 6 hours or on High 3 hours."
    },
    {
      "position": 7,
      "text": "If using Low, turn to High. Add gnocchi. Cover and cook 20 minutes."
    },
    {
      "position": 8,
      "text": "Stir in spinach and Parmesan cheese."
    },
    {
      "position": 9,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "expert",

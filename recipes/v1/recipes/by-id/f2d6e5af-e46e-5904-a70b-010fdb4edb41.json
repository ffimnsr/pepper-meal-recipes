  "slug": "bloody-mary-mix",
  "name": "Bloody Mary Mix",
  "recipe_type": "drink",
  "brief_description": "My sister got this recipe from a restaurant in Ohio and all our family loves it. This is very spicy, and needs time to blend flavors.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pitcher, combine juice cocktail, lemon juice and brown sugar. Season with Worcestershire sauce, horseradish, hot sauce and celery salt. Cover, and refrigerate 8 to 12 hours to allow flavors to meld."
    }
  ],
  "servings": 8,

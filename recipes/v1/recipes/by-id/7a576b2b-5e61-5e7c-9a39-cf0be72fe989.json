  "id": "7a576b2b-5e61-5e7c-9a39-cf0be72fe989",
  "slug": "beef-and-broccoli-udon-noodles-recipe-7371677",
  "name": "Beef and Broccoli Udon Noodles",
  "recipe_type": "main",
  "brief_description": "Make this easy, delicious broccoli beef, with udon noodles and a flavorful sauce, faster than you can pick up takeout.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together sesame oil, cornstarch, 1 tablespoon soy sauce, salt, and baking soda together in a bowl. Add sliced steak to the bowl and marinate for 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk mirin, water, 3 tablespoons soy sauce, dark soy sauce, sweet soy sauce, oyster sauce, and rice vinegar together in a small bowl; set sauce aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil over high heat."
    },
    {
      "position": 4,
      "text": "Heat a wok over medium high heat, and cook and stir steak in the hot wok until steak pieces are caramelized and browned, 3 to 4 minutes. Remove steak from wok; set aside to keep warm."
    },
    {
      "position": 5,
      "text": "Add broccoli to the wok with a small amount of water. Cover with a lid and steam broccoli until bright green, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Add udon noodles to boiling water; return water to a boil and cook until noodles are tender with a bite, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Add garlic and ginger to the wok. Return steak to wok."
    },
    {
      "position": 8,
      "text": "Drain noodles; stir noodles and prepared sauce into the wok to combine. Sprinkle with green onions, black sesame seeds, and toasted sesame seeds to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

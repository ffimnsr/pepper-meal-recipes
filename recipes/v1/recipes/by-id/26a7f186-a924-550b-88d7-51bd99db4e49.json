  "id": "26a7f186-a924-550b-88d7-51bd99db4e49",
  "slug": "twisted-chicken-salad-with-tostadas",
  "name": "Twisted Chicken Salad with Tostadas",
  "recipe_type": "salad",
  "brief_description": "This easy chicken salad includes diced jalapenos, which make it spicy and delicious. You can eat it with crackers, but it tastes much better with tostadas.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large heavy skillet over medium-high heat. One at a time, slip a tortilla into the hot oil. If the tortilla starts to puff up, press it down with a fork. When crisp and brown, remove to paper towels. Repeat with remaining tortillas."
    },
    {
      "position": 2,
      "text": "Place the chicken in a bowl, and separate with a fork. Stir in the mayonnaise. Dice the jalapenos (reserving the liquid), and stir them into chicken salad. Pour in 1 tablespoon jalapeno juice, season with salt and pepper, and stir well. To serve, spread the chicken salad on the tostadas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

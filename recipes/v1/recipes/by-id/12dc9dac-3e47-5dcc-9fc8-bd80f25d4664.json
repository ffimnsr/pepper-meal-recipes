  "id": "12dc9dac-3e47-5dcc-9fc8-bd80f25d4664",
  "slug": "roasted-beet-arugula-and-walnut-salad",
  "name": "Arugula Beet Salad",
  "recipe_type": "salad",
  "brief_description": "This arugula beet salad is made with tender roasted beets and walnuts tossed with an easy vinaigrette for a colorful, crunchy salad that happens to be vegan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix beets, 1 tablespoon olive oil, 1/4 teaspoon salt, and 1/8 teaspoon black pepper together on a baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until beets are tender, about 40 minutes."
    },
    {
      "position": 4,
      "text": "Mix roasted beets, arugula, walnuts, balsamic vinegar, 1 tablespoon olive oil, 1/4 teaspoon salt, and 1/8 teaspoon pepper together in a bowl until well combined."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

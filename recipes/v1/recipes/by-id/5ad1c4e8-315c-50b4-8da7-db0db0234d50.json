  "id": "5ad1c4e8-315c-50b4-8da7-db0db0234d50",
  "slug": "cottage-cheese-pancakes",
  "name": "Cottage Cheese Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These cottage cheese pancakes are tender, fluffy, and easy to make with just five ingredients for a tasty and filling way to the day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cottage cheese, flour, eggs, and oil together in a large bowl."
    },
    {
      "position": 2,
      "text": "Spray a large skillet with cooking spray and heat over medium heat. Pour 1/3 cup batter for each pancake onto the skillet. Cook until bubbles appear on the surface, 3 to 5 minutes. Flip and cook until browned on the other side, 3 to 4 minutes more. Serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "22cb8407-f34e-5a71-b813-5b9a6dc30a0b",
  "slug": "middle-eastern-tomato-salad",
  "name": "Middle Eastern Tomato Salad",
  "recipe_type": "salad",
  "brief_description": "A fresh summertime salad of garden cucumbers, tomatoes, and sweet onion is flavored generously with parsley and fresh mint. The dressing is just olive oil and lemon juice.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place diced cucumber into a colander and sprinkle with 1 teaspoon salt; allow to drain for about 15 minutes."
    },
    {
      "position": 2,
      "text": "Toss drained cucumber with tomato, sweet onion, parsley, and mint. Drizzle salad with olive oil and fresh lemon juice; season with salt and black pepper. Serve immediately."
    }
  ],

  "id": "7560e4b6-87ed-596a-9e26-79f678d0e6a9",
  "slug": "graham-cracker-crust-ii",
  "name": "Sugar-Free Graham Cracker Crust",
  "recipe_type": "dessert",
  "brief_description": "If you're thinking light desserts, then this crust is a must. There's no sugar in this recipe, just graham crackers and butter. This is the perfect quick-fix crust if you need to make a slew of pies. It stirs up and bakes in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together graham cracker crumbs and melted butter. Place mixture in a 9-inch pie pan and press firmly into the bottom and sides of the pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 8 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 8,

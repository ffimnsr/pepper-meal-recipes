  "id": "27efddbb-bd21-5e7d-a2e5-3ac24c8e6e11",
  "slug": "salmon-tartare",
  "name": "Salmon Tartare",
  "recipe_type": "appetizer",
  "brief_description": "Salmon tartare is a delicious yet simple way to enjoy raw fish with fresh herbs and lemon juice. Just make sure to use the freshest fish you can find.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Remove salmon skin and cut out the grey-colored bloodline so you have only the shiny pink flesh. Cut salmon into small cubes and place in a bowl."
    },
    {
      "position": 2,
      "text": "Stir in shallot, parsley, chives, pickle, lemon juice, sea salt, and pepper. Let marinate for 5 minutes before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "7a90f304-8d44-57e7-b86e-abaa39dd4f90",
  "slug": "tuna-lime-tostadas",
  "name": "Tuna Tostadas",
  "recipe_type": "main",
  "brief_description": "These tuna tostadas are light and refreshing on a hot summer day! Tuna, onion, and corn are mixed with the flavors of lime, cilantro, and hot sauce.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place tuna in a bowl and flake with a fork. Stir in corn, onion, cilantro, salsa, and lime juice. Season with a few dashes of hot sauce, and salt and pepper to taste; stir to combine."
    },
    {
      "position": 2,
      "text": "Spoon onto tostada shells. Top each tostada with a dollop of sour cream and a bit more hot sauce."
    }
  ],
  "servings": 8,

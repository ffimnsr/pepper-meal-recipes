  "slug": "soft-gingerbread-cookies-recipe-7975842",
  "name": "Soft Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "What's the key to these six-ingredient soft gingerbread cookies? Spice cake mix. Perfect for last-minute holiday baking and gift-giving, these pillowy cookies are almost too easy to throw together on a whim.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Whisk together cake mix, ginger, and cloves. Stir egg, oil, and molasses into the cake mix mixture until combined."
    },
    {
      "position": 3,
      "text": "Using a cookie scoop or tablespoon, drop the dough about two inches apart onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are set, 10 to 12 minutes. Cool on the baking sheet for 5 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

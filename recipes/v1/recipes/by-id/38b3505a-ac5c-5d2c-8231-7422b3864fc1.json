  "schema_version": 1,
  "id": "38b3505a-ac5c-5d2c-8231-7422b3864fc1",
  "slug": "mexican-chicken-taco-casserole",
  "name": "Mexican Chicken Taco Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken taco casserole recipe is an easier way to eat tacos! Grab a fork and enjoy traditional taco ingredients layered with tortillas and cheese.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch casserole dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "Heat oil in a large nonstick skillet over medium to medium-high heat. Add ground chicken and onion; cook, stirring occasionally to break up the meat, until onion is mostly tender and meat is cooked through, about 5 minutes. Season with chili powder, cumin, garlic powder, and salt."
    },
    {
      "position": 3,
      "text": "Add black beans, corn, diced tomatoes and green chiles, and tomato sauce; stir until well combined. Bring mixture to a low simmer and cook for about 10 minutes. Taste mixture and adjust the seasonings as desired."
    },
    {
      "position": 4,
      "text": "Spoon a couple of good-sized scoops of meat mixture onto the bottom of the prepared casserole dish; spread into a thin layer. Place 3 or 4 tortillas over the sauce, breaking them in half as needed to make a fairly even layer without too much overlap. Spread the remaining meat mixture over the tortillas. Top with the remaining tortillas, again breaking into pieces as necessary to evenly cover the surface."
    },
    {
      "position": 5,
      "text": "Cover with shredded cheese. Spray a piece of foil with nonstick spray; place over the casserole dish, sprayed-side down. (This helps prevent \"cheese loss\" when you remove the foil.)"
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until casserole is bubbly and cheese is nicely melted, about 30 minutes. Allow to cool for 10 to 15 minutes before cutting into wedges or scooping out to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

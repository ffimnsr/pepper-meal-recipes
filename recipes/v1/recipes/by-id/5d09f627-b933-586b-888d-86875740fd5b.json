  "id": "5d09f627-b933-586b-888d-86875740fd5b",
  "slug": "chocolate-surprise-cupcakes",
  "name": "Chocolate Surprise Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Rich chocolate surprise cupcakes with cream cheese and chocolate chip center. They are also known as black bottom cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, 2 cups sugar, cocoa, baking soda, and 1 teaspoon salt together in a large bowl. Stir in water, oil, vinegar, and vanilla until combined. Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 3,
      "text": "Beat cream cheese, remaining 1/2 cup sugar, egg, and remaining 1/4 teaspoon salt in a medium bowl until light and fluffy. Stir in chocolate chips until incorporated; drop a heaping teaspoonful into each cupcake."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cupcake centers bounce back when gently pressed, about 25 minutes. Allow to cool before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

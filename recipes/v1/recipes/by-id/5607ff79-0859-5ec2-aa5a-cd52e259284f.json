  "id": "5607ff79-0859-5ec2-aa5a-cd52e259284f",
  "slug": "sparkling-peach-sangria-recipe-7559189",
  "name": "Sparkling Peach Sangria",
  "recipe_type": "appetizer",
  "brief_description": "Sparkling peach sangria, made with prosecco, fresh peaches, mint, and ginger, make a refreshing, bubbly summer sip.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Early in the day, refrigerate prosecco. Combine peach slices, Cointreau, half of lime slices, mint leaves, and grated ginger in a container with a lid. Refrigerate at least 6 hours, making sure peaches are submerged in liquid."
    },
    {
      "position": 2,
      "text": "When ready to serve, pour peach mixture into a large serving pitcher and add prosecco. Stir briefly to combine."
    },
    {
      "position": 3,
      "text": "Place some of the fruit in each glass, add sangria, and top with 2 ounces sparkling water, or to taste. Garnish with reserved lime slices and additional mint leaves, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

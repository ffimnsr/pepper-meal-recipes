  "id": "480c4e9d-f7af-536a-8fa5-443fc990198b",
  "slug": "easy-chili-i",
  "name": "Easy Chili",
  "recipe_type": "soup",
  "brief_description": "This easy chili is a snap to make with beef, bell peppers, tomatoes, spices, and beans in a large pot. Kick things up a notch with fresh jalapeños.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ground beef, onion, and bell pepper in a large saucepan over medium-high heat. Cook and stir until beef is browned, about 5 minutes. Drain excess fat."
    },
    {
      "position": 3,
      "text": "Season with chili powder, garlic, cumin, and bay leaf."
    },
    {
      "position": 4,
      "text": "Stir in tomatoes, tomato sauce, and jalapeños. Bring to a boil and reduce heat to low. Cover and simmer, stirring occasionally, for 1 1/2 hours. Stir in beans and allow to heat through."
    },
    {
      "position": 5,
      "text": "Season with salt and pepper to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

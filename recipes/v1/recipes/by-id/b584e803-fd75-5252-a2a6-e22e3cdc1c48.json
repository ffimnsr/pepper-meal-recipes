  "id": "b584e803-fd75-5252-a2a6-e22e3cdc1c48",
  "slug": "sweet-kugel",
  "name": "Sweet Kugel",
  "recipe_type": "dessert",
  "brief_description": "Kugel, a traditional Jewish noodle custard dish, can be either sweet or savory, and this version is rich and sweet with apples, golden raisins, and cinnamon.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "While noodles are cooking, mix sour cream, cheese, sugar, and butter together in a large bowl. Add eggs, apple, and raisins. Add drained egg noodles and cinnamon; stir until well combined. Pour into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until slightly golden brown and custard has set, about 1 hour. Cool for 10 to 15 minutes before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 10,

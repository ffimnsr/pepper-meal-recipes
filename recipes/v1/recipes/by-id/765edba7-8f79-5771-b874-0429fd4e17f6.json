  "id": "765edba7-8f79-5771-b874-0429fd4e17f6",
  "slug": "chocolate-meringue-cookies",
  "name": "Chocolate Meringue Cookies",
  "recipe_type": "dessert",
  "brief_description": "These deliciously light chocolate meringue cookies have double the chocolaty taste, thanks to the addition of cocoa powder and semisweet chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a cookie sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat egg whites, vanilla, and cream of tartar in a glass, metal, or ceramic bowl until soft peaks form. Slowly add sugar and continue to beat until stiff peaks form and mixture becomes glossy. Fold in cocoa powder and chocolate chips. Drop mixture by teaspoonfuls onto the prepared cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 25 to 30 minutes. Remove from the oven and let cool to room temperature."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

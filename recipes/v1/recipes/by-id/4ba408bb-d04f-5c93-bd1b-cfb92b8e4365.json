  "id": "4ba408bb-d04f-5c93-bd1b-cfb92b8e4365",
  "slug": "chewy-oatmeal-coconut-bar-cookies",
  "name": "Chewy Oatmeal Coconut Bar Cookies",
  "recipe_type": "appetizer",
  "brief_description": "Baking vegan coconut bar cookies couldn't get any simpler, using 5 basic ingredients, including rolled oats, for an addictive chewy texture.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt brown sugar, coconut oil, and agave nectar in a small pot over medium heat; bring to a boil. Remove from heat; add oats and flour. Pour into an 8-inch baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes. Refrigerate until solid, at least 20 minutes. Cut into squares; you may need to pick up the whole thing and cut it from the side."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

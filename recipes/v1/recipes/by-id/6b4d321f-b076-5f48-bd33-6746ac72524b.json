  "slug": "fruity-fun-skewers",
  "name": "Fruity Fun Skewers",
  "recipe_type": "appetizer",
  "brief_description": "A fun, beautiful, and distinctive way to serve fruit at your next party! Try these fruit skewers out with a variety of fruit dips to make them even more exciting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Thread strawberries, cantaloupe, banana, and apple pieces alternately onto skewers, placing at least 2 pieces of fruit on each skewer. Arrange skewers decoratively on a serving platter."
    }
  ],

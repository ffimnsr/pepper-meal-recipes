  "id": "71bb8530-a7bb-56f2-a2d4-0f76633f0c17",
  "slug": "cold-macaroni-and-tuna-salad",
  "name": "Cold Macaroni and Tuna Salad",
  "recipe_type": "salad",
  "brief_description": "Macaroni, diced hard-boiled eggs, peas, and tuna are tossed together in a satisfying mayonnaise dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add macaroni pasta and cook for 8 to 10 minutes or until al dente; drain and rinse under cold water."
    },
    {
      "position": 3,
      "text": "Put frozen peas into a colander and rinse with hot water; drain well."
    },
    {
      "position": 4,
      "text": "Place macaroni and peas in a large bowl. Dice eggs and add to the bowl. Put tuna in the bowl, flaking it apart."
    },
    {
      "position": 5,
      "text": "Stir mayonnaise into tuna mixture, a little at a time, until mixture is moist but not soggy. Season with salt and pepper and mix one last time. Cover and refrigerate for a least 1 hour or overnight."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

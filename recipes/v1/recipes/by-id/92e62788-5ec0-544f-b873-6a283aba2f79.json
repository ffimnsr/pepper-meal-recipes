  "id": "92e62788-5ec0-544f-b873-6a283aba2f79",
  "slug": "top-shelf-margaritas-on-the-rocks",
  "name": "Top Shelf Margaritas on the Rocks",
  "recipe_type": "drink",
  "brief_description": "Top Shelf Margaritas sure to please the avid 'rita fanatic; as with anything, fresh ingredients are the key to a quality result, so we start with our own syrup and sour mix.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Make a simple syrup by stirring together and bringing 2/3 cup sugar and 1/3 cup water to a boil until the sugar dissolves; set aside to cool."
    },
    {
      "position": 2,
      "text": "Make the sour mix by briskly stirring together the 2 1/4 cups water, lemon juice, 1/4 cup sugar, and egg white; set aside."
    },
    {
      "position": 3,
      "text": "Combine the ice cubes, tequila, Cointreau, lime juice, 1 ounce of the simple syrup, and 1/2 cup of the sour mix in a pitcher; stir vigorously to infuse the ice, 8 to 15 seconds."
    },
    {
      "position": 4,
      "text": "Run a lime wedge along the rim of an 8-ounce glass. Spread the kosher salt onto a plate and dip the glass rims in the salt to coat; add ice if desired. Strain the mixture from the cocktail shaker into the glass to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

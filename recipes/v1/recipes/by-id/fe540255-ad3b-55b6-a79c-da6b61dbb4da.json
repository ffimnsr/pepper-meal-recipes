  "id": "fe540255-ad3b-55b6-a79c-da6b61dbb4da",
  "slug": "fresh-strawberry-cheesecake-pie",
  "name": "Fresh Strawberry Cheesecake Pie",
  "recipe_type": "dessert",
  "brief_description": "This fresh strawberry cheesecake pie recipe features a creamy baked cheesecake filling topped with juicy sliced strawberries suspended in a sweet glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bake pie crust until golden, about 10 minutes. Remove crust from oven; set aside to cool. Reduce the oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Beat cream cheese, \u00bd cup sugar, eggs, and 2 tablespoons lemon juice in a bowl until smooth; pour filling into crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is set, about 30 minutes. Cool completely."
    },
    {
      "position": 5,
      "text": "Whisk water, remaining \u00bd cup sugar, cornstarch, gelatin mix, and remaining 1 tablespoon lemon juice together in a medium saucepan until smooth; bring to a simmer over medium heat. Cook, stirring constantly, until gelatin dissolves and glaze thickens, 5 to 10 minutes. Cool slightly."
    },
    {
      "position": 6,
      "text": "Arrange sliced strawberries on top of pie; pour warm glaze over strawberries. Chill thoroughly in the refrigerator before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

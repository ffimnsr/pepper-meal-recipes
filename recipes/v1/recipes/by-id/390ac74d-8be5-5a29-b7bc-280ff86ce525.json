  "id": "390ac74d-8be5-5a29-b7bc-280ff86ce525",
  "slug": "baby-spinach-omelet",
  "name": "Baby Spinach Omelet",
  "recipe_type": "breakfast",
  "brief_description": "Make this delicious spinach omelet with baby greens, Parmesan cheese, and a little nutmeg for a simple and quick meal\u2014perfect for any time of day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs in a bowl, and stir in baby spinach and Parmesan cheese."
    },
    {
      "position": 3,
      "text": "Season with onion powder, nutmeg, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Spray a small skillet with cooking spray and place over medium heat. Once warm, add in the egg mixture and cook until partially set, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Flip with a spatula, and continue cooking, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Reduce heat to low and continue cooking, 2 to 3 minutes, or until omelet reaches desired doneness. Serve warm and enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

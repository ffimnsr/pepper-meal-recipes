  "id": "5e6a4097-3543-5f36-bad7-8939872ef4a4",
  "slug": "instant-pot-steamed-artichokes",
  "name": "Instant Pot Steamed Artichokes",
  "recipe_type": "drink",
  "brief_description": "Instant Pot artichokes are easy to prep for tender results when steamed under high pressure; serve with melted butter or more lemon juice for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, garlic, bay leaf, and salt inside a multi-functional pressure cooker (such as Instant Pot\u00ae). Place steamer in the pot. Add artichokes, trimmed top facing up; drizzle with lemon juice. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove lid."
    },
    {
      "position": 3,
      "text": "Cool until easily handled. Pull off outer petals one at a time. Pull through teeth to remove the soft portion of the petal. Discard remaining petal. Spoon out fuzzy center near the stem and discard. Eat the bottom whole or cut into pieces."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

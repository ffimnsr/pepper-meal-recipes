  "id": "0bbec418-5d7f-5990-b2c0-4d01f23eb185",
  "slug": "sugar-free-date-cookies",
  "name": "Sugar-Free Date Cookies",
  "recipe_type": "dessert",
  "brief_description": "Your family will love these healthy date cookies with crunchy pecans--they contain no additional sugar and are sweetened only by dates and banana.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine the dates, pecans, water, banana, egg, butter, and vanilla extract in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, cinnamon, and salt together in a separate bowl. Add to the date mixture and stir until well combined."
    },
    {
      "position": 4,
      "text": "Drop dough by tablespoonfuls about 1 inch apart onto the prepared baking sheet and flatten lightly with the palm of your hand."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cookies start to brown around the edges, being careful not to over-bake, for 11 to 13 minutes. Transfer cookies immediately to a wire rack to cool."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

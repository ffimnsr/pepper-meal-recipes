  "id": "0357270a-9f85-5284-b9db-0c4839d1b1fc",
  "slug": "old-fashioned-potato-kugel",
  "name": "Potato Kugel",
  "recipe_type": "side",
  "brief_description": "This easy potato kugel is made with grated potatoes, onion, and eggs, baked until golden brown and crispy on top for a delicious Passover side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with 1 tablespoon vegetable oil."
    },
    {
      "position": 2,
      "text": "Combine grated potatoes and onions in a large bowl. Mix in eggs, 1/3 cup of vegetable oil, salt, and pepper until well combined; pour mixture into the prepared dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown and crisp on top, 1 \u00bd to 2 hours."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,

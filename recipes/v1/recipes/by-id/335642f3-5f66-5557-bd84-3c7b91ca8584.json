  "slug": "best-egg-salad-recipe-11924378",
  "name": "Best Egg Salad",
  "recipe_type": "salad",
  "brief_description": "If you\u2019re ready to make your best egg salad, give this a try. It kicks up the classic a notch; adding bacon and Cheddar is the utmost upgrade for perfect sandwiches, lettuce wraps, or snacking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayonnaise, vinegar, Ranch seasoning, mustard, dill relish, and Worcestershire in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Fold in hard boiled eggs, Cheddar, bacon, and celery. Store in an airtight container in the fridge."
    }
  ],
  "servings": 2,

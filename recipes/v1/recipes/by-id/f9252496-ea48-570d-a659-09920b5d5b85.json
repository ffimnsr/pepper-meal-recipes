  "id": "f9252496-ea48-570d-a659-09920b5d5b85",
  "slug": "greek-hamburgers-bifteki-recipe-11898000",
  "name": "Greek Hamburgers (Bifteki)",
  "recipe_type": "salad",
  "brief_description": "These Greek hamburgers, or bifteki, are very tasty, juicy with good flavor from mint and lemon juice, and they are easy to make. Serve them with Greek-style potatoes and an easy Greek salad.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with aluminum foil. Heat oil in a large skillet over medium heat. Add onion and cook until tender and starting to brown, 3 minutes."
    },
    {
      "position": 2,
      "text": "Add garlic and cook until fragrant, 1 minute. Remove from skillet and let cool for 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine bread crumbs and milk in a large bowl. Add eggs, parsley, vinegar, salt, oregano, mint, and pepper; stir to combine."
    },
    {
      "position": 4,
      "text": "Add cooled onion mixture and ground beef. Mix just until combined. Do not overmix."
    },
    {
      "position": 5,
      "text": "Shape into 12 (3/4-inch-thick) patties and arrange on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center of a patty registers 160 degrees F (71 degrees C), about 20 minutes."
    },
    {
      "position": 7,
      "text": "Serve warm with lemon wedges and Greek style potatoes or an easy Greek salad."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

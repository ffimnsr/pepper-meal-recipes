  "id": "6e6790dd-9cc6-5762-8bc6-7dff8cbf0016",
  "slug": "cherry-crunch",
  "name": "Cherry Crunch",
  "recipe_type": "dessert",
  "brief_description": "Cherry pie filling is lovingly sandwiched between 2 layers of crunchy oaty goodness. Substitute apple pie filling and sprinkle a little extra cinnamon over the top if you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine the rolled oats, flour, brown sugar and cinnamon. Cut in butter until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Sprinkle one half of crumb mixture in the bottom of a 9 inch square baking dish. Cover with cherry pie filling. Sprinkle remaining crumb mixture over pie filling."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 40 minutes, or until topping is golden brown. Serve warm."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

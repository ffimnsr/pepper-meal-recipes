  "id": "827fcf5d-3f0f-511e-8082-95a84aa3fb53",
  "slug": "shrimp-artichoke-dip",
  "name": "Shrimp Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This marvelous spinach artichoke dip made with Cheddar, Parmesan, and shrimp is baked until warm and bubbly. Serve with tortilla chips.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix artichoke hearts, Cheddar, Parmesan, shrimp, mayonnaise, green onions, and garlic salt together in a medium baking dish. Sprinkle paprika over top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned and bubbly, about 20 minutes."
    }
  ],
  "servings": 32,

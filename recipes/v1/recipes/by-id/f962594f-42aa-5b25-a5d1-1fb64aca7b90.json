  "id": "f962594f-42aa-5b25-a5d1-1fb64aca7b90",
  "slug": "guinness-chili-recipe-11919212",
  "name": "Guinness Chili",
  "recipe_type": "soup",
  "brief_description": "This Guinness chili with with ground beef, kidney beans, and fire-roasted tomatoes is perfectly seasoned. Worcestershire and stout beer deepen the flavor and it's ready in under 1 hour, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground beef and onion in a 6-quart pot over medium heat, breaking up beef with a wooden spoon, until beef is no longer pink, about 8 minutes. Drain grease."
    },
    {
      "position": 2,
      "text": "Season with chili powder, garlic, cumin, salt, cayenne pepper, and cinnamon. Cook and stir until fragrant, 1 minute."
    },
    {
      "position": 3,
      "text": "Mix in undrained tomatoes, beans, beer, Worcestershire, maple syrup, and tomato paste. Bring to a boil over high heat. Reduce heat to medium-low and simmer, uncovered, until thickened, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Garnish with sour cream and green onions, if desired. Recipe developed by Juliana Hale"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

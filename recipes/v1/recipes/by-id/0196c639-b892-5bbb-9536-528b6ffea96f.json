  "id": "0196c639-b892-5bbb-9536-528b6ffea96f",
  "slug": "praline-pumpkin-dessert",
  "name": "Praline Pumpkin Dessert",
  "recipe_type": "dessert",
  "brief_description": "Creamy pumpkin puree is topped with butter pecan cake mix and pecans creating a delightful praline pumpkin dessert perfect for Thanksgiving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Whisk pumpkin, evaporated milk, sugar, eggs, and cinnamon together in a bowl until smooth; pour into prepared baking pan. Sprinkle cake mix and pecans over pumpkin mixture; top with melted butter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a knife inserted in the center of the dessert comes out clean, 50 to 60 minutes. Cool for 30 minutes before slicing."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,

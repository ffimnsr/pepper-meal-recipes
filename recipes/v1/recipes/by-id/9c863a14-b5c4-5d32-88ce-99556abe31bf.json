  "id": "9c863a14-b5c4-5d32-88ce-99556abe31bf",
  "slug": "curry-pineapple-fried-rice",
  "name": "Curry Pineapple Fried Rice",
  "recipe_type": "main",
  "brief_description": "This quick curry fried rice with chicken and pineapple was inspired by a dish at my favorite Thai restaurant.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and rice in a saucepan over high heat; bring to a boil. Reduce heat to medium-low, cover, and simmer until rice is tender and all liquid has been absorbed, 20 to 25 minutes. Set rice aside."
    },
    {
      "position": 2,
      "text": "Whisk fish sauce, pineapple juice, and curry powder together in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet or wok over medium-high heat until shimmering. Cook and stir chicken and onion in hot oil until chicken is no longer pink and onions are translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in cooked rice, pineapple chunks, and curry mixture; cook and stir until rice is hot, 5 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

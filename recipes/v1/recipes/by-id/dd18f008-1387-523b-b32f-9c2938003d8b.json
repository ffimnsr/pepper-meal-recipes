  "id": "dd18f008-1387-523b-b32f-9c2938003d8b",
  "slug": "chicken-soba-noodle-soup",
  "name": "Chicken Soba Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "With just a bit of prep work, you can enjoy this homemade chicken soup with soba noodles for either lunch or dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a stockpot over medium heat. Add onion and garlic and saute for 2 minutes. Add carrots and celery and saute for 2 more minutes. Add chicken broth and bring to a boil. Stir in curry powder, salt, and both peppers. Reduce heat to a simmer."
    },
    {
      "position": 2,
      "text": "At the same time, melt butter in a skillet over medium-high heat. Add chicken and saute until golden brown and the juices run clear, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Add cooked chicken to the simmering broth and return to a boil. Add soba noodles and peas; cook, stirring occasionally, until noodles are tender yet firm to the bite, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "44fc8b83-0ce9-5951-af5c-090980dd6bca",
  "slug": "a-farewell-to-basil-fettuccine",
  "name": "A Farewell to Basil Fettuccine",
  "recipe_type": null,
  "brief_description": "This basil fettuccine tastes like summer in Italy. Enjoy a delectable mouthful of homemade pasta flavored simply with freshly chopped basil.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Process basil leaves in a food processor until chopped very fine. Add 1 1/2 cups flour and pulse two or three times, or until combined. Mix in egg and oil. Add water until dough forms a ball shape. If dough seems dry, add a bit more water."
    },
    {
      "position": 2,
      "text": "Wrap dough in a piece of plastic wrap which has been coated in a few drops of olive oil. Refrigerate for 2 hours."
    },
    {
      "position": 3,
      "text": "Remove dough from the refrigerator and cut into 6 equal size portions. Run pasta though a pasta machine or roll with a rolling pin to desired thickness. Use additional flour to coat pasta while rolling. Once dough is desired thickness, run through the machine on the fettuccine setting to create noodles."
    },
    {
      "position": 4,
      "text": "Allow pasta to dry for 1 hour prior to cooking."
    },
    {
      "position": 5,
      "text": "Cook in a large pot of boiling water until al dente, 3 to 5 minutes depending on the thickness of the pasta."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

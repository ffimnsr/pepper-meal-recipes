  "id": "b24d3461-da8e-5e99-a697-d253e7b291a6",
  "slug": "transformed-spinach-mushroom-quiche",
  "name": "Spinach Mushroom Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This spinach mushroom quiche made with fresh spinach, mushrooms, onion, feta, and Swiss cheese makes a flavorful vegetarian breakfast or brunch dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Gently combine spinach, mushrooms, onion, and feta cheese in a bowl. Spread mixture into prepared pie crust; top with 1/2 of the Swiss cheese."
    },
    {
      "position": 3,
      "text": "Whisk eggs, milk, parsley, garlic, salt, black pepper, and nutmeg in the bowl. Pour egg mixture evenly over filling, swirling egg mixture in bowl to evenly distribute seasonings. Top with remaining Swiss cheese, then place quiche on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly puffed and browned, 45 to 50 minutes. A toothpick inserted into the center of the filling should come out clean. Cool for 30 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f2ce944a-f795-5d90-b44f-c638df693edd",
  "slug": "hearty-halibut-chowder",
  "name": "Hearty Halibut Chowder",
  "recipe_type": "soup",
  "brief_description": "I got this recipe when I lived in Anchorage, Alaska. It's made from Alaskan halibut. The shredded carrots and Cheddar cheese in this chowder make it distinctive.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onion; cook until softened and translucent, about 5 minutes. Add potatoes and garlic; cook until potatoes softened slightly, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add chicken stock, tomatoes, and carrots; bring to a boil, then reduce heat to medium-low, cover, and simmer for 10 minutes. Stir in milk and cream; season with salt and black pepper, then stir in halibut and simmer uncovered until halibut is flaky and no longer translucent in center, about 10 minutes. Gently stir in Cheddar cheese and pepper flakes until cheese melted. Serve immediately."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,

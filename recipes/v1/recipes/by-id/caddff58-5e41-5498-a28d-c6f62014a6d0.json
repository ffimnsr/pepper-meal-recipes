  "id": "caddff58-5e41-5498-a28d-c6f62014a6d0",
  "slug": "bastani-saffron-and-rose-ice-cream-recipe-8661887",
  "name": "Bastani (Saffron and Rose Ice Cream)",
  "recipe_type": "dessert",
  "brief_description": "Bastani is flavored with rose water, the key to this vibrant and delicious saffron and rose ice cream. Rose water has a strong flavor, so start with 2 tablespoons if you want a more delicate floral note.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together egg yolks and sugar in a medium bowl until thick and pale yellow, 1 to 2 minutes."
    },
    {
      "position": 2,
      "text": "Warm the milk, rose water, and vanilla in a medium saucepan over medium heat just until mixture lightly simmers. Gradually pour milk mixture into yolk mixture, whisking constantly."
    },
    {
      "position": 3,
      "text": "Return mixture to saucepan and cook over medium-low heat, stirring constantly, until an instant-read thermometer registers 170 degrees F (77 degrees C) and mixture is thick enough to coat the back of a spoon, 5 to 8 minutes. Remove from heat. Add saffron, stirring until mixture takes on a deep-yellow color, about 1 minute. Stir in whipping cream. Cover surface with plastic wrap; chill at least 8 hours or up to 24 hours."
    },
    {
      "position": 4,
      "text": "Churn mixture in an ice cream maker according to manufacturer\u2019s directions until it reaches the texture of soft-serve ice cream. Add pistachios (if using) during the last few minutes of churning."
    },
    {
      "position": 5,
      "text": "Transfer to a freezer-safe container, cover surface with parchment paper, and freeze until firm, at least 4 hours."
    },
    {
      "position": 6,
      "text": "Scoop into bowls. Garnish with pistachios and rose petals. (Freeze in an airtight container up to 1 week.)"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

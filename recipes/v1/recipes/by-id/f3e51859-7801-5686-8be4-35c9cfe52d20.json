  "id": "f3e51859-7801-5686-8be4-35c9cfe52d20",
  "slug": "briam-greek-baked-zucchini-and-potatoes",
  "name": "Briam (Greek Baked Zucchini and Potatoes)",
  "recipe_type": "main",
  "brief_description": "This briam recipe with potatoes, zucchini, red onions, tomatoes, parsley, and olive oil is baked in the oven for a mouthwatering Greek vegetable dish.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread potatoes, zucchini, and red onions in an extra-large baking dish (9x13-inch or larger, or 2 baking dishes)."
    },
    {
      "position": 3,
      "text": "Cover with pur\u00e9ed tomatoes, olive oil, and parsley; season liberally with sea salt and pepper. Toss until vegetables are evenly coated."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 1 hour. Stir gently, then continue baking until vegetables are tender and moisture has evaporated, about 30 minutes more."
    },
    {
      "position": 5,
      "text": "Cool briam slightly before serving or serve at room temperature."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,

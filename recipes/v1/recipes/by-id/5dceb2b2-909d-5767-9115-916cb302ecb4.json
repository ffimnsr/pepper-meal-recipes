  "id": "5dceb2b2-909d-5767-9115-916cb302ecb4",
  "slug": "brunch-enchiladas",
  "name": "Brunch Enchiladas",
  "recipe_type": "breakfast",
  "brief_description": "This is a delicious enchilada breakfast casserole made with flour tortillas. It's filled with ham, vegetables, and cheese and baked in an egg batter.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ham in food processor, and pulse until finely ground. Mix together ham, green onions, and green peppers. Spoon 1/3 cup of ham mixture and 3 tablespoons shredded cheese onto each tortilla, then roll up. Carefully place filled tortillas, seam side down, in a greased 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together eggs, cream, and milk, flour, garlic powder, and hot pepper sauce. Pour egg mixture over tortillas. Cover, and refrigerate 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "The next morning, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, in preheated oven for 50 to 60 minutes, or until set. Sprinkle casserole with remaining 1 cup shredded cheese. Bake about 3 minutes more, or until cheese melts. Let stand a least 10 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,

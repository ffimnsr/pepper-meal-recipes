  "id": "4c259140-3a65-5695-b42b-2646d61e09ae",
  "slug": "homemade-refrigerator-pickles",
  "name": "Homemade Refrigerator Pickles",
  "recipe_type": "snack",
  "brief_description": "Refrigerator pickles are so easy to make with garden fresh cucumbers, green bell peppers, and onions. Keep them on hand for sandwiches or snacking!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Inspect several canning jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until needed. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 3,
      "text": "Bring vinegar, sugar, and salt to a boil in a medium saucepan over medium heat. Boil until sugar dissolves, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Place cucumbers, onions, and bell peppers into a large glass mixing bowl. Pour brine over top and toss vegetables for several minutes."
    },
    {
      "position": 5,
      "text": "Transfer vegetables and brine to the sterilized jars; don\u2019t worry if the brine doesn\u2019t cover the vegetables. Refrigerate for 1 to 4 days before eating."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

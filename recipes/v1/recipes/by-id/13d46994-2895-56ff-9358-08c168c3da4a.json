  "id": "13d46994-2895-56ff-9358-08c168c3da4a",
  "slug": "sturdy-whipped-cream-frosting",
  "name": "Sturdy Whipped Cream Frosting",
  "recipe_type": "dessert",
  "brief_description": "This whipped cream frosting whips cream cheese, heavy cream, vanilla, and sugar together to make a stable frosting that won't melt at room temp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, vanilla extract, and almond extract in the bowl of a stand mixer. Mix with the whisk attachment on medium speed until smooth."
    },
    {
      "position": 3,
      "text": "With the mixer on, slowly pour in heavy cream."
    },
    {
      "position": 4,
      "text": "Stop and scrape the bottom of the bowl occasionally. Continue whipping until cream reaches a stiff peak."
    },
    {
      "position": 5,
      "text": "Use to decorate cakes or cupcakes. Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

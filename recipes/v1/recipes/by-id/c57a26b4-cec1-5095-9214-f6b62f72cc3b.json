  "id": "c57a26b4-cec1-5095-9214-f6b62f72cc3b",
  "slug": "bellas-rosemary-red-potatoes",
  "name": "Bella's Rosemary Red Potatoes",
  "recipe_type": "side",
  "brief_description": "These rosemary red potatoes are the simplest, most elegant side dish ever! This is the best way to impress company without any extra effort. Substitute 1 teaspoon dried rosemary if you do not have fresh rosemary",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Mix together melted butter and oil, then pour into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place potatoes into the prepared dish; stir until coated. Sprinkle with rosemary, salt, and pepper. Cover with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until potatoes are tender, about 30 minutes. Stir potatoes occasionally to ensure even cooking."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

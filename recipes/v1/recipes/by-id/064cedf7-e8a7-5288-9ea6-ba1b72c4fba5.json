  "id": "064cedf7-e8a7-5288-9ea6-ba1b72c4fba5",
  "slug": "kabocha-squash-mini-muffins",
  "name": "Kabocha Squash Mini Muffins",
  "recipe_type": "main",
  "brief_description": "These roasted kabocha mini muffins spiced with cinnamon are a comforting bite-size treat that are easy to make when squash is in season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and grease lightly with cooking spray."
    },
    {
      "position": 2,
      "text": "Place kabocha squash skin-side down on the baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until fork-tender, 30 to 40 minutes. Cool until easily handled, about 10 minutes. Scoop squash flesh into a food processor; puree until smooth. Discard skin."
    },
    {
      "position": 4,
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C). Grease 2 mini muffin tins with cooking spray."
    },
    {
      "position": 5,
      "text": "Stir white sugar, brown sugar, canola oil, and olive oil in a large bowl until smooth. Beat in eggs, 1 at a time. Stir in 3/4 cup pureed squash and vanilla extract."
    },
    {
      "position": 6,
      "text": "Mix whole wheat flour, all-purpose flour, cinnamon, baking powder, baking soda, and salt together in a bowl. Stir gradually into sugar mixture, alternating with apple cider, until smooth. Pour into prepared muffin tins, filling each cup 3/4 full."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 10 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

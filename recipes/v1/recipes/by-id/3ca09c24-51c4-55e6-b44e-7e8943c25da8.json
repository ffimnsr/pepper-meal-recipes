  "id": "3ca09c24-51c4-55e6-b44e-7e8943c25da8",
  "slug": "simple-chili",
  "name": "Simple Chili",
  "recipe_type": "soup",
  "brief_description": "This easy chili recipe is ready in under an hour and features a simple ingredient list of ground beef, kidney beans, crushed tomatoes, and chili powder.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a 2-quart saucepan over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 7 to 10 minutes. Add onion and garlic; cook until onion is translucent, about 5 minutes. Drain any excess fat."
    },
    {
      "position": 2,
      "text": "Stir in beans, crushed tomatoes, chili powder, vinegar, salt, and pepper; bring to a boil. Reduce the heat, cover, and simmer for 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,

  "id": "f240f6c6-8fb2-54f7-998e-e771811cb050",
  "slug": "mini-orange-mince-pies",
  "name": "Traditional Mince Pies",
  "recipe_type": "dessert",
  "brief_description": "These mince pies are easy to make with homemade pastry flavored with orange zest and prepared mincemeat filling for a classic British Christmas treat.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift flour, 1/4 cup confectioners' sugar, and cinnamon together in a large bowl. Use a pastry cutter or two forks to mix in butter until mixture resembles fine crumbs. Stir in orange zest. Sprinkle with ice water and gather dough into a ball. Roll out on a lightly floured surface to 1/4 inch thick. Cut out approximately 18 (3-inch) diameter circles, and 18 (2-inch) circles, re-rolling dough as needed."
    },
    {
      "position": 3,
      "text": "Line muffin cups or mini tart tins using the 3-inch pastry circles. Fill each pastry cup with about 1 tablespoon of mincemeat filling. Top with 2-inch pastry circles, sealing edges firmly together or crimping lightly with a fork to prevent the filling from leaking as they cook. Brush the top of each pie with egg."
    },
    {
      "position": 4,
      "text": "Bake mince pies in preheated oven until tops are golden brown, 15 to 20 minutes. Cool slightly on wire racks. Dust with remaining 1/4 cup confectioners' sugar just before serving."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

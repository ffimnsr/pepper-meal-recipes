  "id": "5705cb0c-620c-5241-b408-20c7dbe627ac",
  "slug": "healthy-pumpkin-cranberry-muffins",
  "name": "Healthy Pumpkin Cranberry Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This healthy pumpkin cranberry muffin recipe is made with oats and whole wheat flour, making it a tasty on-the-go breakfast or holiday snack to enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine milk and vinegar in a small bowl until evenly blended. Set aside. Whisk whole wheat flour, all-purpose flour, oats, baking soda, ginger, baking powder, cinnamon, nutmeg, and salt together in a large bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk pumpkin, brown sugar, white sugar, vegetable oil, and egg together in a separate bowl; stir in milk mixture until smooth. Stir in flour mixture until just combined: fold in fresh and dried cranberries."
    },
    {
      "position": 4,
      "text": "Divide batter among the prepared muffin cups, filling each to the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 25 minutes. Cool in the tins for 5 minutes before transferring muffins to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

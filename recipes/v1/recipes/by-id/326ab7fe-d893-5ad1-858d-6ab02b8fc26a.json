  "id": "326ab7fe-d893-5ad1-858d-6ab02b8fc26a",
  "slug": "no-bake-cookies-i",
  "name": "No-Bake Cookies",
  "recipe_type": "dessert",
  "brief_description": "These no-bake cookies are incredibly quick to make with oats, creamy peanut butter, and cocoa for a chocolaty treat without having to heat the oven!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, milk, and cocoa in a medium saucepan; bring to a boil, stirring often. Boil for exactly 1 \u00bd minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat; stir in peanut butter."
    },
    {
      "position": 4,
      "text": "Add oats and vanilla; stir until well combined."
    },
    {
      "position": 5,
      "text": "Drop batter by teaspoonfuls onto waxed paper."
    },
    {
      "position": 6,
      "text": "Let cool until hardened. Enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

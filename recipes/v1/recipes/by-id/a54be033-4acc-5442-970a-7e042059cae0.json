  "id": "a54be033-4acc-5442-970a-7e042059cae0",
  "slug": "rosenmunnar",
  "name": "Rosenmunnar",
  "recipe_type": "dessert",
  "brief_description": "Butter, sugar, flour and jam are all you need to make these Swedish thumbprint cookies. Proof that just a few ingredients can amount to perfect little bites.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream butter and sugar until light and fluffy. Add sifted flour, and mix well. Shape dough into 1-inch balls and place on cookie sheets. Imprint your thumb in the center to make a 1/2-inch indentation. Fill with your favorite preserves."
    },
    {
      "position": 3,
      "text": "Bake 15 to 20 minutes or until golden brown at the edges."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 40,

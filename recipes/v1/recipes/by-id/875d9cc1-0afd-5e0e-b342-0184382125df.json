  "slug": "vegetarian-chili",
  "name": "Vegetarian Chili",
  "recipe_type": "soup",
  "brief_description": "They'll never know it's vegetarian!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot, combine meat substitute, black beans, kidney beans, diced tomatoes, tomato juice, onions, chili powder, cumin, garlic powder, bay leaves, salt and pepper. Bring to a simmer and cover. Let the chili simmer for at least 1 hour before serving."
    }
  ],

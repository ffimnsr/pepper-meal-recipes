  "id": "5a988b21-b670-59ce-9d94-5712b89aa55f",
  "slug": "air-fryer-seasoned-breakfast-potatoes",
  "name": "Air Fryer Seasoned Breakfast Potatoes",
  "recipe_type": "breakfast",
  "brief_description": "These easy breakfast potatoes are tossed with olive oil, salt, onion powder, paprika, and pepper, then cooked in the air fryer until perfectly crisp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large bowl, cover with cold water, and let sit for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Drain potatoes and pat dry with a paper towel. Add olive oil, salt, onion powder, paprika, and pepper to potatoes; stir until evenly combined. Place potatoes in the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 20 minutes, shaking halfway through cook time."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

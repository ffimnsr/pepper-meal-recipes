  "id": "443eb833-41b3-5bd1-861c-aae8123b0ffd",
  "slug": "easy-crustless-pumpkin-pie",
  "name": "Crustless Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This creamy crustless pumpkin pie is perfect for a gluten-free Thanksgiving dessert. It's so deliciously silky, decadent, and full of fall flavor!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat pumpkin puree, milk, sweetener, egg substitute, vanilla, cinnamon, ginger, and nutmeg in a bowl until smooth; pour into the prepared pie dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the center is set, about 30 minutes. Remove from the oven and cool completely before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ace2c5a7-f65a-5c03-b136-2c10d0753b28",
  "slug": "high-protein-scrambled-pancakes-recipe-11694315",
  "name": "High Protein Scrambled Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These high protein scrambled pancakes are made with an egg, oat, and cottage cheese batter, dolloped into a skillet, then scrambled in the pan like scrambled eggs. Serve with butter and syrup, or a side of fresh berries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs, cottage cheese, oats, protein shake, baking powder, cinnamon, and vanilla, in order, into the jar of a high-powered blender (such as a Vitamix\u00ae). Blend until smooth."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium heat and lightly coat with cooking spray."
    },
    {
      "position": 3,
      "text": "Pour batter into small pancakes. Before the batter begins to set, push the batter around to scramble the pancakes. Flip and fluff the pancakes, and cook until they acquire some golden color in places, 3 to 5 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "841706d5-463e-583a-96a8-5abe5c9ccd4a",
  "slug": "blubaughs-blueberry-buckle-shortcake",
  "name": "Blubaugh's Blueberry Buckle Shortcake",
  "recipe_type": "dessert",
  "brief_description": "Blueberries take the cake in this favorite family recipe with German/Pennsylvania origins. Spread the shortcake dough over a baking sheet, make a well and spoon blueberry pie filling into each square, then bake for a dessert or breakfast treat.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Cream the sugar and margarine together in a mixing bowl. Stir in the eggs, one at a time, beating thoroughly after each. Stir in the vanilla and flour, and mix well. Spread the batter over the prepared baking sheet to form a rectangle. Use a knife to mark off 12 squares. Use a spoon to make a small well in each square. Place 1 tablespoon pie filling in each well."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until top is light brown, about 25 minutes. Cool on pan, and cut into 12 squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

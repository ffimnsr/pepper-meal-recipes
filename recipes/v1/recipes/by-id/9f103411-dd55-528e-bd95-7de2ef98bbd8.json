  "slug": "peanut-butter-fudge-with-condensed-milk",
  "name": "Peanut Butter Fudge with Condensed Milk",
  "recipe_type": "dessert",
  "brief_description": "Made with just three ingredients, this peanut butter fudge with condensed milk is a quick and easy dessert option for parties or potlucks.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a saucepan over medium heat. Pour in condensed milk. Pour in peanut butter chips. Stir until blended."
    },
    {
      "position": 2,
      "text": "Pour into a parchment-lined 9x9-inch pan. Let cool, 30 minutes to 1 hour. Cut into pieces and serve."
    }
  ],

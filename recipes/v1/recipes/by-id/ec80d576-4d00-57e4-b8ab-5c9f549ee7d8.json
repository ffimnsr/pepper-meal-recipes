{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ec80d576-4d00-57e4-b8ab-5c9f549ee7d8",
  "slug": "stuffed-and-rolled-pork-tenderloin",
  "name": "Stuffed and Rolled Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "Chef John's recipe for stuffed and rolled pork tenderloin looks impressive to guests and is very easy to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Remove flap of meat at wider end of tenderloin and trim last 2 inches off narrow end; chop trimmings and reserve."
    },
    {
      "position": 3,
      "text": "Place tenderloin with a short end toward you. Cut into tenderloin with knife parallel to cutting board about 1-inch from bottom (in the middle) along entire length of one long edge of tenderloin; continue cutting stopping about 1/2-inch from other long edge, without cutting all the way through. Open tenderloin like a book. Cut a few shallow slashes in the flattened meat, being careful not to cut all the way through."
    },
    {
      "position": 4,
      "text": "Cover flattened tenderloin with heavy plastic; pound with the smooth side of a meat mallet to about a 1/2-inch thickness. Roll up pounded tenderloin, cover with plastic wrap, and refrigerate to keep cold."
    },
    {
      "position": 5,
      "text": "Mix chopped pork trimmings, parsley, bread crumbs, currants, garlic, rosemary, egg, olive oil, 2 teaspoons salt, 1 1/2 teaspoons black pepper, and cayenne pepper together in a bowl with a fork until stuffing well-combined."
    },
    {
      "position": 6,
      "text": "Unroll tenderloin on work surface. Spread stuffing over tenderloin, leaving a 2-inch border on one of the long edges. Roll up tenderloin, ending at the 2-inch border; tie with twine to secure shape. Season tenderloin on all sides with salt and black pepper."
    },
    {
      "position": 7,
      "text": "Heat an oven-safe skillet on stovetop over high heat until hot. Add tenderloin; cook until browned, 3 to 4 minutes per side."
    },
    {
      "position": 8,
      "text": "Cook in the preheated oven until tenderloin slightly pink in the center, about 30 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Transfer to a plate and let rest for 15 minutes before removing twine and slicing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

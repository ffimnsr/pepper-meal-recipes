  "id": "961090cb-cd3f-5b44-9f3f-068e9f6bf851",
  "slug": "best-green-bean-casserole",
  "name": "Best Green Bean Casserole",
  "recipe_type": "soup",
  "brief_description": "This best green bean casserole recipe uses only four ingredients: Canned green beans, condensed mushroom soup, French-fried onions, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix green beans and soup together in a large microwave-safe bowl until well combined. Microwave on high until warm, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir 1/2 cup cheese into mixture. Microwave on high, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Spread mixture evenly in a casserole dish. Sprinkle remaining cheese over top; sprinkle with fried onions."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese melts and onions lightly brown, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

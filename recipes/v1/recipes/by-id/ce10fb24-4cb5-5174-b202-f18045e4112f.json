  "id": "ce10fb24-4cb5-5174-b202-f18045e4112f",
  "slug": "air-fryer-steak-for-fajitas",
  "name": "Air Fryer Steak for Fajitas",
  "recipe_type": "main",
  "brief_description": "Cook marinated steak strips in the air fryer with peppers, onions, and spices, then serve them with all the fixings for steak fajitas or fajita bowls.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine olive oil, salt, garlic powder, cumin, jalape\u00f1o chile powder, chili powder, and coriander in a resealable plastic bag. Add steak, onion, and bell pepper, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Line an air fryer basket with a sheet of perforated parchment paper. Add marinated onion, pepper, and steak."
    },
    {
      "position": 3,
      "text": "Air fry for 5 minutes at 400 degrees F (200 degrees C). Remove the air fryer basket and shake to ensure even cooking. Air fry until steak is cooked through, about 4 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

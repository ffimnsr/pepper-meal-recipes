  "slug": "slow-cooker-creamed-corn",
  "name": "Slow Cooker Creamed Corn",
  "recipe_type": "side",
  "brief_description": "This slow cooker creamed corn recipe, made with cream cheese, butter, and milk, is simmered until rich and silky, making it a comforting holiday side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine corn, cream cheese, butter, milk, and sugar in a slow cooker. Season with salt and pepper to taste."
    },
    {
      "position": 2,
      "text": "Cook on Low for 4 to 6 hours, or High for 2 to 4 hours, stirring once or twice during cooking to prevent sticking."
    }
  ],
  "servings": 12,

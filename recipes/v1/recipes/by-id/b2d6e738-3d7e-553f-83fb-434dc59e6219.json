  "slug": "air-fryer-tortilla-quiche-recipe-11873606",
  "name": "Air Fryer Tortilla Quiche",
  "recipe_type": "main",
  "brief_description": "This air fryer tortilla quiche is quick and easy to prepare. You can add any toppings or seasonings you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line your air fryer with an air fryer liner. Place tortilla into the air fryer, so the sides are covered."
    },
    {
      "position": 2,
      "text": "Whisk eggs and cottage cheese together in a bowl. Pour into the tortilla in the air fryer and season with salt and pepper. Sprinkle with bell pepper and spinach. Top with cheese."
    },
    {
      "position": 3,
      "text": "Air fry at 350 degrees F (180 degrees C) until eggs are set, about 20 minutes. Remove, allow to cool for a few minutes, quarter, and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "6d7c90dc-5fb3-531d-8b7c-5550c63febeb",
  "slug": "egg-roll-wrappers",
  "name": "Egg Roll Wrappers",
  "recipe_type": "appetizer",
  "brief_description": "Make your own egg roll wrappers with just four ingredients! They fry up in peanut oil in minutes and are a great alternative to store-bought.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk cold water, egg, and salt together in a medium bowl. Add flour in 3 batches, mixing well after each addition. Let stand at room temperature for 15 minutes."
    },
    {
      "position": 2,
      "text": "Heat a wok over high heat. Remove from the heat and thinly coat with 1 tablespoon peanut oil. Return to the heat and reduce the temperature to low."
    },
    {
      "position": 3,
      "text": "Pour 1/4 of the egg mixture into the warm wok to make an 8-inch diameter circle. Rotate the wok quickly to spread batter into an even layer. Cook until the bottom is golden brown and the edges begin to curl, 45 to 60 seconds. Carefully remove from the wok and place onto a paper towel with the browned side down. Repeat to make one more wrapper."
    },
    {
      "position": 4,
      "text": "Rub the wok with remaining 1 tablespoon of peanut oil, then make remaining two wrappers as directed above."
    },
    {
      "position": 5,
      "text": "When wrappers have cooled completely, cut each one in half to yield eight wrappers."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

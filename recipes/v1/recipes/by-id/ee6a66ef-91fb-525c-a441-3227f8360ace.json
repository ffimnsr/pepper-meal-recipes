  "id": "ee6a66ef-91fb-525c-a441-3227f8360ace",
  "slug": "baked-vegetable-rice-pilaf",
  "name": "Baked Vegetable Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "Baked vegetable rice pilaf is topped with Cheddar cheese for a quick and easy side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix chicken broth, rice, corn, peas, carrot, and onion together in a casserole dish; cover with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until rice is tender and broth has been absorbed, about 30 minutes. Remove aluminum foil and sprinkle pilaf with Cheddar cheese; cover with aluminum foil. Continue baking until cheese is melted, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

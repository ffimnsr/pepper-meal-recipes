  "id": "092d423e-a93e-522b-b537-feba0e17c815",
  "slug": "potato-leek-and-spinach-soup",
  "name": "Potato, Leek, and Spinach Soup",
  "recipe_type": "soup",
  "brief_description": "Leeks, potatoes, bacon, and spinach are the base for this hearty soup. Serve with crusty bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put leeks in a bowl with enough water to cover completely. Set aside to soak."
    },
    {
      "position": 2,
      "text": "Heat a large pot over medium-high heat. Fry bacon in the hot pot until crisp, 5 to 7 minutes. Remove bacon with a slotted spoon to a plate lined with paper towels to drain. Remove all but 2 tablespoons bacon drippings from the pot."
    },
    {
      "position": 3,
      "text": "Drain leeks and shake vigorously to dry. Fry leeks and garlic in reserved bacon drippings until translucent, 5 to 7 minutes. Stir potatoes into leeks; add bay leaves. Pour chicken stock over potatoes; bring to a simmer and cook until potatoes are tender, 10 to 15 minutes. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Scoop about 1/2 of the potatoes, leeks, and garlic into a food processor bowl with enough liquid to cover; process until pur\u00e9ed. Stir pur\u00e9e, bacon, spinach, and half-and-half into the pot; continue heating soup until again hot, 1 to 2 minutes. Add chicken broth from the can or half-and-half to achieve desired consistency."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

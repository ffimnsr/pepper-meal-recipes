  "slug": "insalata-caprese-i",
  "name": "Insalata Caprese I",
  "recipe_type": "salad",
  "brief_description": "Thick wedges of ripe tomatoes, fresh Mozzarella and slices of red onion are tossed in olive oil and vinegar and sprinkled with chopped, fresh basil. Chill and eat.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine the tomatoes, cheese, onion, oil, vinegar, basil, and salt and pepper to taste. Toss and chill for 1 hour. Serve on large platter."
    }
  ],
  "servings": 4,

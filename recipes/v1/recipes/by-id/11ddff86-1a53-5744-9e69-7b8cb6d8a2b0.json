  "id": "11ddff86-1a53-5744-9e69-7b8cb6d8a2b0",
  "slug": "oven-roasted-lamb-chops",
  "name": "The Best Lamb Chops",
  "recipe_type": "main",
  "brief_description": "Lamb chops seasoned with garlic and rosemary are roasted in the oven and always turn out flavorsome, perfectly juicy, and tender in under 30 minutes.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut away excess fat from lamb chops (some fat does add flavor). Coat each chop lightly in olive oil. Season lamb chops with garlic, rosemary, salt, and pepper. Place lamb chops in a cast iron skillet."
    },
    {
      "position": 3,
      "text": "Bake uncovered in the preheated oven until cooked through, 8 to 10 minutes. An instant-read thermometer inserted into the center should read at least 140 degrees F (60 degrees C) for medium-well doneness."
    },
    {
      "position": 4,
      "text": "Remove from the oven and cover tightly with foil; let rest for 8 to 10 minutes. Serve with mint jelly on the side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "ff70e2a0-b57b-5869-a53a-74f9836c775f",
  "slug": "poppy-seed-shortbread",
  "name": "Poppy Seed Shortbread",
  "recipe_type": "dessert",
  "brief_description": "Take classic buttery shortbread cookies to another level by adding delicious and nutritious poppy seeds to the dough. Make sure to cut them right after baking while still warm.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, butter, confectioners' sugar, poppy seeds, vanilla extract, and salt in the bowl of a food processor; pulse to combine. Dough will be dry and crumbly."
    },
    {
      "position": 3,
      "text": "Press dough into a 11x7-inch baking pan. Pierce entire surface with a fork to prevent the dough from rising during baking."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges start to turn slightly brown, 30 to 40 minutes."
    },
    {
      "position": 5,
      "text": "Remove shortbread from pan and cut into 12 equal-sized bars while still warm. Place on a wire rack to cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

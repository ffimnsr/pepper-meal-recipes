  "id": "32e37695-0406-5c17-a71e-a94ad9fcd570",
  "slug": "carols-chicken-salad",
  "name": "Carol's Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Tender chicken breast chunks are mixed with sweet green grapes, diced Swiss cheese, crunchy celery, and minced green onions, and folded into a tangy, creamy dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, whisk together the mayonnaise, salt, poultry seasoning, onion powder, garlic powder, pepper, and lemon juice."
    },
    {
      "position": 2,
      "text": "In a large bowl, toss together the chicken, celery, green onions, water chestnuts, Swiss cheese, and grapes. Add the mayonnaise mixture, and stir to coat. Chill until serving."
    }
  ],

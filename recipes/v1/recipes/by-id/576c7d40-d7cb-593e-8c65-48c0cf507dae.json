  "id": "576c7d40-d7cb-593e-8c65-48c0cf507dae",
  "slug": "very-chocolate-ice-cream",
  "name": "Very Chocolate Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This chocolate ice cream uses cocoa powder and melted chocolate in a custard base for an ultra-rich and creamy texture with amazing chocolate flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine milk, sugar, cocoa powder, and salt in a saucepan over medium heat. Bring to a simmer, stirring constantly."
    },
    {
      "position": 3,
      "text": "Place egg yolks into a small bowl. Gradually whisk in about 1/2 cup of hot milk mixture, then return to the saucepan. Heat and stir until thickened, but do not boil."
    },
    {
      "position": 4,
      "text": "Remove from the heat and stir in chopped chocolate until melted."
    },
    {
      "position": 5,
      "text": "Pour into a chilled bowl and refrigerate, stirring occasionally, until cold, about 2 hours."
    },
    {
      "position": 6,
      "text": "Stir in cream and vanilla. Pour mixture into an ice cream maker and freeze according to manufacturer\u2019s instructions, about 20 minutes. Transfer ice cream to an airtight container and freeze until firm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "108b8a24-6dae-5a12-80da-1dee74d92f36",
  "slug": "amazingly-good-eggnog",
  "name": "Amazingly Good Eggnog",
  "recipe_type": "drink",
  "brief_description": "This amazingly good eggnog recipe is thickened with egg yolks, flavored with warm spices, and a splash of rum for a creamy, festive adult beverage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, 1/2 teaspoon vanilla extract, cinnamon, and cloves in a large saucepan over low heat; stir and heat for 5 minutes. Increase the heat to medium-low; Gradually bring to a boil. Remove from the heat."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks in a large bowl until they turn light yellow. Add sugar; whisk until light and fluffy."
    },
    {
      "position": 3,
      "text": "Pour some of the hot milk mixture into egg yolk mixture; whisk quickly to avoid scrambling eggs. Continue adding hot milk and whisking until all milk is incorporated."
    },
    {
      "position": 4,
      "text": "Pour mixture back into the saucepan. Cook over medium heat, stirring constantly, until thick, about 3 minutes; do not boil."
    },
    {
      "position": 5,
      "text": "Strain; let cool for 1 hour. Stir in cream, rum, remaining 2 teaspoons vanilla extract, and nutmeg. Refrigerate 8 hours to overnight before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "68e8780c-c65a-5691-9f73-d88bd2bd695e",
  "slug": "summer-roll-bowl-recipe-11769546",
  "name": "Summer Roll Bowl",
  "recipe_type": "main",
  "brief_description": "These summer roll bowls, inspired by Vietnamese summer rolls, are a cool, refreshing meal in a bowl. Rice vermicelli, lettuce, herbs, carrots, shrimp, and pork are drizzled with a peanut-hoisin sauce, with a little, or a lot of heat\u2014you decide!",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a pan of lightly salted water to a boil; add shrimp and cook until they are pink and curled into a tight \u201cC\u201d shape. Immediately remove shrimp and place into a bowl of ice water. When cool, slice shrimp thinly, from head to tail, and refrigerate."
    },
    {
      "position": 3,
      "text": "Cook pork in a small nonstick skillet, breaking meat up into small bits. After about 2 minutes, add onion, salt, and sugar, and continue cooking until onion is translucent, 4 to 5 minutes. Remove pork to a plate lined with paper towels to drain. Remove paper towel, and refrigerate until needed."
    },
    {
      "position": 4,
      "text": "For sauce, add oil and garlic to a small saucepan; place over medium heat. Cook, stirring, until garlic is fragrant, about 30 seconds. Add hoisin sauce, peanut butter, and water, stirring to combine. Bring to a boil, then remove from heat. Add chili paste and allow to cool. Set aside."
    },
    {
      "position": 5,
      "text": "When ready to make the bowls, bring 5 cups of water to boil in a large saucepan. Add rice noodles and stir, to avoid clumping. Boil and stir for 2 to 3 minutes. Pour into a mesh strainer and rinse thoroughly with cold water."
    },
    {
      "position": 6,
      "text": "Evenly divide vermicelli into 4 serving bowls. Working in sections, place cooked shrimp, ground pork mixture, lettuce, herbs, and carrots on top of vermicelli."
    },
    {
      "position": 7,
      "text": "Drizzle each bowl with sauce. Sprinkle each bowl with crushed peanuts, and garnish with green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

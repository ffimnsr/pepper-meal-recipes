  "id": "02c1cfe7-cb23-5c7c-a9cc-d70644d151eb",
  "slug": "italian-chicken-sliders-recipe-11829022",
  "name": "Italian Chicken Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These Italian chicken sliders are pull-apart sliders stuffed with juicy chicken, creamy ricotta, marinated artichokes, spinach, and melty mozzarella, with a pop of sweet peppers in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Grease or line a 9\u00d713-inch baking dish."
    },
    {
      "position": 2,
      "text": "Toss shredded chicken with 1 tablespoon olive oil if desired; set aside."
    },
    {
      "position": 3,
      "text": "In a small bowl, stir together ricotta cheese, 2 tablespoons chopped artichokes, 2 tablespoons Parmesan cheese, salt, and black pepper until smooth; set aside."
    },
    {
      "position": 4,
      "text": "Slice rolls in half horizontally, keeping the top and bottom halves intact. Spread garlic dip over cut side of bottom half. Add a layer of spinach. Spread ricotta mixture over spinach."
    },
    {
      "position": 5,
      "text": "Evenly scatter shredded chicken on top. Distribute the remaining artichoke hearts and sweety drop peppers. Lay down fresh mozzarella slices and sprinkle with remaining Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Place the top rolls on. Brush tops with olive oil or melted butter. Sprinkle with garlic salt. Cover loosely with foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until mozzarella melts and sliders are warmed through, 12 to 15 minutes."
    },
    {
      "position": 8,
      "text": "Slice into individual sliders, drizzle with balsamic glaze, and enjoy warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

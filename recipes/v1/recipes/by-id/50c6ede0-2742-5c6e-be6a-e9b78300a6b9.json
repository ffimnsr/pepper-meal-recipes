{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "50c6ede0-2742-5c6e-be6a-e9b78300a6b9",
  "slug": "skillet-cheeseburger-pasta-recipe-8401021",
  "name": "Skillet Cheeseburger Pasta",
  "recipe_type": "main",
  "brief_description": "This skillet cheeseburger dish will make you nostalgic for grilling season while being a perfect off-season weeknight comfort meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter with oil in a deep cast iron skillet over medium heat. Add chopped onion and cook until translucent, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Add minced garlic and ground beef; cook and stir, breaking up the meat with a spatula, until beef is crumbly and browned, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir in tomato sauce and evaporated milk. Add pickle relish, Dijon mustard, granulated garlic, granulated onion, Montreal steak seasoning, chili powder, smoked paprika, salt, and pepper, and stir to combine."
    },
    {
      "position": 4,
      "text": "Reserve 1/4 cup beef broth, and pour remaining beef broth into the skillet. Whisk flour and the 1/4 cup beef broth together in a small bowl to make a slurry; stir slurry into the skillet."
    },
    {
      "position": 5,
      "text": "Stir in dry macaroni until pasta is fully submerged. Bring mixture to a boil, reduce the heat to low, and simmer, covered, until macaroni is tender with a bite, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Set a rack about 6 inches from the heat source and preheat the oven\u2019s broiler."
    },
    {
      "position": 7,
      "text": "Stir 2 cups cheese into macaroni mixture. Sprinkle remaining cheese evenly across the top of the skillet. Broil until cheese is golden, about 3 minutes. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

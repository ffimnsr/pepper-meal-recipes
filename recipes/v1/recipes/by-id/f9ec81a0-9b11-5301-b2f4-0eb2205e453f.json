{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f9ec81a0-9b11-5301-b2f4-0eb2205e453f",
  "slug": "tortilla-pinwheel-kabobs-with-yogurt-sauce-recipe-11967064",
  "name": "Tortilla Pinwheel Kebabs with Yogurt Sauce",
  "recipe_type": "main",
  "brief_description": "Tortilla pinwheel kabobs with yogurt sauce offer a whole new way to present ordinary ground beef. Seasoned with garlic and spices, baked in a very hot oven, and served with a lemony dipping sauce, these skewers are extra delicious (and fun).",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Combine ground beef, onion, garlic, paprika, cumin, coriander, 1 teaspoon salt, and 1/2 teaspoon pepper in a bowl. Use a microplane to grate about 1 teaspoon lemon zest into a small bowl and set aside. Cut lemon in half and squeeze 1 tablespoon of juice into the meat mixture and mix well."
    },
    {
      "position": 2,
      "text": "Spread meat mixture evenly onto the tortillas in a thin layer, leaving a 1/4-inch border around the edges. Roll each tortilla tightly and trim off the ends to form a straight edge. Cut each roll into 3/4-inch slices."
    },
    {
      "position": 3,
      "text": "Thread each pinwheel onto a skewer, piercing the loose end of the tortilla to hold it closed."
    },
    {
      "position": 4,
      "text": "Spread olive oil into the bottom of a rimmed baking sheet. Place skewer down on the oil and flip it so that both sides are lightly coated with oil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 13 to 15 minutes, flipping halfway through."
    },
    {
      "position": 6,
      "text": "Meanwhile, stir yogurt into reserved lemon zest and add any remaining lemon juice from the lemon. Add remaining salt and pepper and stir until well combined."
    },
    {
      "position": 7,
      "text": "Serve kabobs with yogurt sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

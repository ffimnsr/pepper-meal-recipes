  "slug": "easy-corn-salsa",
  "name": "Easy Corn Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This colorful corn salsa is simple to make in minutes with canned or fresh corn, bell pepper, jalape\u00f1o, red onion, cilantro, and lime juice.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Stir corn, bell pepper, red onion, jalape\u00f1o, cilantro, lime juice, honey, crushed red pepper, salt, and pepper together in a bowl. For best flavor results, chill until ready to serve."
    }
  ],

  "id": "52c3442c-b7c9-557c-8cd5-c8998ea9220b",
  "slug": "cornish-pastie-ii",
  "name": "Cornish Pastie II",
  "recipe_type": "appetizer",
  "brief_description": "These savory beef and potato pastries are delicious hot or cold.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Divide pastry in three equal parts. Roll 1/3 to make 8x15 inch rectangle. Trim edges and cut to make two 7-inch squares. Place on baking sheet. Repeat with other two thirds of pastry."
    },
    {
      "position": 2,
      "text": "Arrange layer of potatoes on half of each pastry square, top with layer of onion and then with beef. Sprinkle with salt and pepper and dot with butter."
    },
    {
      "position": 3,
      "text": "Moisten pastry edges with cold water and fold over to make triangles; press edges together to make tight seal. A tight seal retains steam and makes juicy pastries."
    },
    {
      "position": 4,
      "text": "Bake at 375 degrees F (190 degrees C) for 1 hour or until meat is tender. Serve hot with chili sauce, ketchup, or pickle relish or serve cold for sandwiches."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

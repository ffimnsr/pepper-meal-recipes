  "id": "7dfdcd20-400a-5d88-ada0-fa0ae819bfdf",
  "slug": "slow-cooker-mashed-potatoes",
  "name": "Slow Cooker Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These creamy crockpot mashed potatoes are easy to make ahead for a slow cooker and taste fantastic thanks to garlic, butter, and cream cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes, bouillon, and garlic in a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Drain in a colander over a large bowl, reserving cooking water."
    },
    {
      "position": 4,
      "text": "Mash potatoes with sour cream and cream cheese until smooth and creamy, adding a little reserved water if needed to reach desired consistency."
    },
    {
      "position": 5,
      "text": "Transfer mashed potato mixture to a slow cooker, cover, and cook on Low for 2 to 3 hours."
    },
    {
      "position": 6,
      "text": "Just before serving, stir in butter and season with salt and pepper to taste."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 135,

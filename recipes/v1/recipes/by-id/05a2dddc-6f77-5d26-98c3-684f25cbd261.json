  "id": "05a2dddc-6f77-5d26-98c3-684f25cbd261",
  "slug": "roast-beef-and-cheddar-sliders-recipe-8650250",
  "name": "Cheesy Roast Beef Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These warm roast beef sliders are baked on Hawaiian rolls with BBQ sauce and melty cheese for the ultimate easy, shareable party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Brush bottom and sides of a 9x13-inch baking dish with melted butter until lightly coated."
    },
    {
      "position": 2,
      "text": "Arrange bottom halves of rolls in baking dish. Top evenly with roast beef slices; drizzle with BBQ sauce and dollop cheese sauce evenly over beef. Place top halves of rolls on top."
    },
    {
      "position": 3,
      "text": "Stir remaining 3 tablespoons melted butter with garlic powder and onion powder; brush over roll tops. Sprinkle evenly with everything bagel seasoning."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the center is warm, cheese is melted, and rolls are toasted and golden brown on top, 12 to 14 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

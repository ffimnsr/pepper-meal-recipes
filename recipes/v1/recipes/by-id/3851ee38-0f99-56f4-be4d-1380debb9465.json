  "id": "3851ee38-0f99-56f4-be4d-1380debb9465",
  "slug": "award-winning-chili",
  "name": "Award-Winning Chili",
  "recipe_type": "soup",
  "brief_description": "This award-winning chili features a base of tomatoes, carrots, onions, bell pepper, wine, and steak sauce with seasoned ground beef, bacon, and beans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, onion, celery, carrot, tomato paste, steak sauce, bell peppers, wine, and red pepper flakes in a large pot. Bring to a simmer over medium-low heat."
    },
    {
      "position": 3,
      "text": "While tomato mixture simmers, cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 4,
      "text": "Cook and stir beef in bacon drippings over medium-high heat until brown and crumbly; drain. Stir in chili seasoning."
    },
    {
      "position": 5,
      "text": "Stir seasoned beef, bacon, and cumin into tomato mixture. Continue to simmer until vegetables are tender and flavors are well blended. Stir in beans, cilantro, and parsley. Continue cooking until beans are heated through. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

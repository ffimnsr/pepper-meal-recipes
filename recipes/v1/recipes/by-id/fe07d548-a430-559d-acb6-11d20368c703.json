  "id": "fe07d548-a430-559d-acb6-11d20368c703",
  "slug": "my-moms-spritz-cookies",
  "name": "My Mom's Spritz Cookies",
  "recipe_type": "dessert",
  "brief_description": "This spritz cookie recipe makes beautiful sweet and buttery pressed cookies. Color or decorate with Christmas sprinkles for the holiday season!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butter and sugar in a bowl. Beat with an electric mixer until creamy. Add egg yolks and vanilla extract. Mix until well combined. Beat in flour and baking powder. Use your hands to finish mixing if dough does not come together."
    },
    {
      "position": 3,
      "text": "Add dough to a cookie press and press spritz-shaped cookies onto the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are lightly browned, 8 to 10 minutes. Cool on the baking sheets briefly; carefully transfer to a wire rack to cool completely before decorating."
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

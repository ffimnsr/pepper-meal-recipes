  "slug": "tomato-watermelon-salad",
  "name": "Tomato Watermelon Salad",
  "recipe_type": "salad",
  "brief_description": "This watermelon tomato salad tosses fresh cubes of watermelon with onion, feta, tomatoes, and mint for a delicious and refreshing combo of flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gently mix watermelon, tomatoes, feta cheese, onion, and mint in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, vinegar, salt, and pepper together in a small bowl; drizzle over salad and gently toss to coat."
    }
  ],

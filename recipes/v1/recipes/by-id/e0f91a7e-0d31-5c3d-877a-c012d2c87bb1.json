  "id": "e0f91a7e-0d31-5c3d-877a-c012d2c87bb1",
  "slug": "broccoli-salad-with-red-grapes-bacon-and-sunflower-seeds",
  "name": "Broccoli Salad with Red Grapes, Bacon, and Sunflower Seeds",
  "recipe_type": "salad",
  "brief_description": "This traditional broccoli salad with red grapes, bacon, and sunflower seeds is a nice combination of sweet and savory. Perfect for summer picnics!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned and crisp, about 10 minutes. Drain bacon slices on paper towels. Crumble 7 slices of bacon; mix with sunflower seeds in a resealable plastic bag and set aside."
    },
    {
      "position": 2,
      "text": "Combine broccoli, grapes, and onion in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, vinegar, sugar, and pepper together in a separate bowl; crumble remaining slice of bacon and fold into dressing."
    },
    {
      "position": 4,
      "text": "Pour dressing over broccoli mixture; toss to coat evenly. Cover the bowl with plastic wrap and refrigerate for flavors to blend, about 2 hours. Sprinkle bacon-sunflower seed mixture over salad before serving; mix well."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

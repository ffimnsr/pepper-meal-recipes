{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "fa89079f-e0da-57b0-9011-d13675025dba",
  "slug": "chiles-rellenos-stuffed-peppers",
  "name": "Chiles Rellenos (Stuffed Peppers)",
  "recipe_type": "main",
  "brief_description": "This chiles rellenos recipe may be time-consuming, but you\u2019ll agree that it\u2019s worth every minute to serve your family this traditional Mexican dish.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Roast whole peppers over an open flame on a gas stovetop burner, turning frequently, until skins are evenly black and blistered. Transfer peppers to a resealable plastic bag. Seal the bag and let peppers sweat for a while; this will allow the skins to peel off easily."
    },
    {
      "position": 3,
      "text": "While the peppers are sweating, cook ground beef in a skillet over medium-high heat evenly browned and crumbly, 5 to 7 minutes. Add tomatoes, onion, and garlic; cook for a few more minutes. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Wear food-safe gloves if desired and remove peppers from the bag. Peel off and discard burnt skins. Run peppers under cool running water to rinse away any burnt pieces, then blot dry with a paper towel. Make a small vertical slit in the side of each pepper. Remove the seeds and veins through the slits."
    },
    {
      "position": 5,
      "text": "Stuff each pepper halfway with beef mixture, then fill the rest of the way with shredded mozzarella. Close the slits and secure with toothpicks."
    },
    {
      "position": 6,
      "text": "Beat egg whites in a large glass or metal bowl until thick and fluffy. Beat in egg yolks until blended in, about 1 minute. Place flour in a shallow bowl."
    },
    {
      "position": 7,
      "text": "Heat 1/4 inch of oil in a large, heavy skillet over medium-high heat. Coat stuffed peppers with a light dusting of flour, then dip into eggs until fully covered. Carefully place peppers into hot oil and fry on both sides until golden. Drain on paper towels, then serve on a large platter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

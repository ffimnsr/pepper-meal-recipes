  "name": "Ex-Girlfriend's Mom's Salsa Fresca (Pico de Gallo)",
  "recipe_type": "appetizer",
  "brief_description": "This salsa fresca recipe is a fresh-tasting combination of tomatoes, red onion, jalapeño, cilantro, and lime to serve with chips or your favorite Mexican dishes.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix red onion, jalapeño pepper, and lime juice in a bowl. Allow to stand for 5 minutes. Mix in tomatoes, cilantro, and salt; allow to stand 15 more minutes for flavors to blend."
    }
  ],

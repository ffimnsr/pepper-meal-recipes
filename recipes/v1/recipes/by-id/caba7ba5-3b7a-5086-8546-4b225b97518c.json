  "id": "caba7ba5-3b7a-5086-8546-4b225b97518c",
  "slug": "sloppy-joe-mamas",
  "name": "Sloppy Joe Mamas Recipe",
  "recipe_type": "main",
  "brief_description": "This Sloppy Joes mamas recipe gets a kick from Mexican hot sauce, Worcestershire sauce, mustard, and vinegar for a spicy spin on an American classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add onion and garlic; saut\u00e9 until browned, 5 to 7 minutes. Add ground beef; cook and stir until beef is completely browned, 7 to 10 minutes. Drain and discard grease from the skillet. Transfer beef mixture to a slow cooker."
    },
    {
      "position": 2,
      "text": "Stir hot tomato sauce, ketchup, brown sugar, Worcestershire sauce, mustard, vinegar, and chili powder into beef mixture. Cover the slow cooker."
    },
    {
      "position": 3,
      "text": "Cook on Low for 2 hours (or on High for 1 hour)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

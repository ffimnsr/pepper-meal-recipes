  "id": "263b438f-cab8-5436-af7d-ff03e6f344b1",
  "slug": "beef-tenderloin-fondue",
  "name": "Beef Tenderloin Fondue",
  "recipe_type": "soup",
  "brief_description": "Cooking beef tenderloin in hot vegetable broth is a perfect, low-effort Valentine's Day dinner for two.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix soy sauce, Worcestershire sauce, and garlic in a resealable plastic bag. Add cubed beef and seal bag. Lay flat in the refrigerator for a minimum of 4 hours, turning occasionally."
    },
    {
      "position": 2,
      "text": "Remove beef from the marinade and pat dry with paper towels."
    },
    {
      "position": 3,
      "text": "Pour vegetable broth into a fondue pot and heat to 225 degrees F (105 degrees C). Add wine and green onions to the simmering broth. Use fondue forks to dip beef cubes into the broth until cooked, 1 to 2 minutes per forkful."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bad4e6e7-06fa-5da6-9d07-87efebb9ecf6",
  "slug": "dutch-oven-ground-beef-goulash",
  "name": "Dutch Oven Ground Beef Goulash",
  "recipe_type": "soup",
  "brief_description": "Smoky, rich, and hearty, this Dutch oven goulash with cavatappi pasta and fresh herbs makes the perfect main dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a Dutch oven over medium heat. Cook and stir onion in the hot oil until translucent, about 5 minutes. Increase heat to medium-high. Add ground beef, black pepper, and salt; cook and stir until browned and crumbly, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Pour in tomatoes, beef broth, wine, paprika, garlic, Worcestershire, thyme, caraway seeds, rosemary, and bay leaves. Reduce heat to medium and simmer until reduced to a thick, stew-like consistency, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook cavatappi in the boiling water, stirring occasionally, until tender yet firm to the bite, 9 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir bell pepper and lemon juice into the beef mixture and cook for 10 minutes more. Stir in cooked pasta to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

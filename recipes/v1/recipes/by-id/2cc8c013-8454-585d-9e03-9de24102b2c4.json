  "id": "2cc8c013-8454-585d-9e03-9de24102b2c4",
  "slug": "keto-air-fryer-jalapeno-poppers",
  "name": "Keto Air Fryer Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These keto-friendly air fryer jalape\u00f1o poppers are a great appetizer! They're made with just three ingredients and are ready to devour in just 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill each jalape\u00f1o half with cream cheese and wrap with a halved bacon strip. Tuck in bacon ends or use toothpicks to secure."
    },
    {
      "position": 3,
      "text": "Place jalape\u00f1o poppers inside the air fryer basket, working in batches to avoid overcrowding if necessary."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer until bacon is done to your liking, 10 to 12 minutes. Keep poppers warm in an oven on the lowest setting while air-frying the remaining poppers."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "5614f1cc-cd83-530c-b1b7-b29458743e3b",
  "slug": "french-toast-pancakes",
  "name": "French Toast Pancakes",
  "recipe_type": "dessert",
  "brief_description": "French toast pancakes are made with a cinnamon-nutmeg pancake batter to create a perfect fusion of breakfast favorites for a family-pleasing brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 teaspoons oil in a griddle or skillet over medium-high heat."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, baking soda, salt, nutmeg, and cinnamon together in a bowl; make a well in the center. Beat milk, egg, 2 tablespoons oil, and vanilla extract together in a separate bowl; pour into the well in the flour mixture and stir until batter is smooth."
    },
    {
      "position": 3,
      "text": "Drop about 1/4 cup batter per pancake onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

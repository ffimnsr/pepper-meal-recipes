  "id": "4d30c599-cc59-5ae3-99ed-ad5a0e569575",
  "slug": "mincemeat-cookies-i",
  "name": "Easy Mincemeat Cookies",
  "recipe_type": "dessert",
  "brief_description": "This is an easy recipe for festive mincemeat cookies made with lots of fruity mincemeat and chopped walnuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Beat butter, sugar, and eggs together in a large bowl with an electric mixer until light and fluffy; beat in vanilla. Sift the flour, salt and baking soda together, and add to butter mixture. Mix until well blended. Stir in the nuts and mincemeat and mix well."
    },
    {
      "position": 3,
      "text": "Drop by teaspoonfuls, about 2 inches apart, on prepared cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until light brown at the edges, 8 to 10 minutes."
    }
  ],
  "servings": 84,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

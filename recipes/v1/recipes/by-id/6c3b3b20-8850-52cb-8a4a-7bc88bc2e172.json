  "slug": "one-pan-sausage-gnocchi-recipe-11794015",
  "name": "One-Pan Sausage Gnocchi",
  "recipe_type": "main",
  "brief_description": "This one-pan sausage gnocchi is a delicious and comforting midweek skillet meal, with the added convenience of easy cleanup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add sausage; cook and stir until golden, about 5 minutes. Add garlic and cook until fragrant, about 30 seconds. Transfer sausage and garlic to a plate and keep warm."
    },
    {
      "position": 2,
      "text": "Add gnocchi and chicken broth to the skillet; cover and cook for 4 minutes. Stir in heavy cream and spinach; cook until gnocchi are tender and spinach is wilted, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Return sausage mixture to the skillet. Stir to combine. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

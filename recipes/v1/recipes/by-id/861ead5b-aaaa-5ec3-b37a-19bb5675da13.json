  "id": "861ead5b-aaaa-5ec3-b37a-19bb5675da13",
  "slug": "graham-cracker-pudding-pie",
  "name": "Graham Cracker Pudding Pie",
  "recipe_type": "dessert",
  "brief_description": "This graham cracker pudding pie is filled with hot chocolate custard, then chilled until set for an easy, luscious dessert great for feeding a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover the bottom of a 9x13-inch dish with a layer of graham crackers. Set aside."
    },
    {
      "position": 2,
      "text": "Combine milk and pudding mix in a large saucepan. Prepare according to package directions."
    },
    {
      "position": 3,
      "text": "Pour hot pudding over graham crackers into the dish. Cover pudding with another layer of graham crackers. Chill in the refrigerator until pudding is set, at least 4 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "slug": "no-bake-pizza-appetizer",
  "name": "No Bake Pizza Appetizer",
  "recipe_type": "appetizer",
  "brief_description": "This is a pizza bread crust slathered with spinach dip and covered with scrumptious toppings: broccoli, chicken or turkey, green onions, and tomato.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Spread spinach dip evenly over the pizza crust to within 1/2 inch of the edge. Top with broccoli, chicken, green onions and tomato. Cut into wedges to serve."
    }

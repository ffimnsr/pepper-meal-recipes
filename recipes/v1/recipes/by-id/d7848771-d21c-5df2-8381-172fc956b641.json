  "id": "d7848771-d21c-5df2-8381-172fc956b641",
  "slug": "fresh-fruit-cobbler",
  "name": "Fresh Fruit Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This fresh fruit cobbler recipe features fresh peaches, pears, plums, and cherries piled into a large casserole dish and covered with a sweet batter.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Arrange peaches, apples, pears, blueberries, cherries, and plums in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Whisk sugar, milk, and egg together in a bowl until smooth. Sift flour, baking powder, and salt together into a separate bowl; stir into sugar mixture until combined. Stir in melted butter and vanilla extract until incorporated; pour batter over fruit to cover."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and lightly browned on top, about 30 minutes. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

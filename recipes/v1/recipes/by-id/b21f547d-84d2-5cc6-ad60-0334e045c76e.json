  "id": "b21f547d-84d2-5cc6-ad60-0334e045c76e",
  "slug": "classic-meatloaf",
  "name": "Classic Meatloaf",
  "recipe_type": "main",
  "brief_description": "Chef John's traditional meatloaf recipe uses classic ingredients like saut\u00e9ed vegetables, spices, and bread crumbs. An old-fashioned glaze adds flavor to every slice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking dish with lightly greased foil."
    },
    {
      "position": 3,
      "text": "Place carrot, celery, onion, bell pepper, mushrooms, and garlic in a food processor; pulse until very finely chopped, almost to a pur\u00e9e. Transfer to a large mixing bowl."
    },
    {
      "position": 4,
      "text": "Add ground chuck to the vegetables, along with Worcestershire sauce, egg, Italian herbs, salt, black pepper, and cayenne. Mix gently with a wooden spoon until ingredients are just combined. Sprinkle in bread crumbs and gently mix with your fingertips until just combined; don't overmix."
    },
    {
      "position": 5,
      "text": "Shape the mixture into a loaf, about 4 inches high by 6 inches across. Place in the prepared baking pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven just until the meatloaf is hot, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, stir brown sugar, ketchup, Dijon, and Sriracha for glaze in a small bowl until brown sugar has dissolved."
    },
    {
      "position": 8,
      "text": "Remove meatloaf from the oven. Spoon glaze on the top of the meatloaf with the back of a spoon, then pull a tiny bit glaze down the sides."
    },
    {
      "position": 9,
      "text": "Return to the oven, and bake until no longer pink inside, 45 to 75 more minutes. An instant-read thermometer inserted into the thickest part of the loaf should read at least 160 degrees F (70 degrees C), so start checking at 45 minutes and continue baking until meatloaf reaches that temperature. Cooking time will depend on shape and thickness of the meatloaf."
    },
    {
      "position": 10,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "6eae3236-9b2f-5bc8-ae73-3fe333a42e9f",
  "slug": "key-lime-pie-mini-dessert",
  "name": "Key Lime Pie Mini Dessert",
  "recipe_type": "dessert",
  "brief_description": "This key lime pie shooter-style dessert is light, refreshing, tangy, and sweet. It has a lovely presentation of a mini parfait and a luscious taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine graham cracker crumbs, butter, and sugar in a bowl. Add 1 tablespoon of mixture to the bottom of ten 2-ounce shooter glasses."
    },
    {
      "position": 2,
      "text": "Use an electric mixer to beat cream cheese and yogurt together in a medium-sized bowl until smooth. Set aside."
    },
    {
      "position": 3,
      "text": "Stir together condensed milk and key lime juice in a separate bowl. Add to the cream cheese mixture, beating until well combined. Divide mixture in half and tint one portion with green food coloring. Place each portion in a separate resealable plastic bag and snip one corner from each."
    },
    {
      "position": 4,
      "text": "Fill each shooter glass halfway with white mixture. Tap each glass on the counter to level the cheesecake. Repeat with green cheesecake mixture. Place filled glasses in the refrigerator to chill for at least 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

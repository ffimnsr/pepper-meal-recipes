  "id": "40d0e623-d4b6-550a-8891-94323868c951",
  "slug": "best-hamburger-ever",
  "name": "Best Hamburger Ever",
  "recipe_type": "main",
  "brief_description": "The best burger recipe you'll make all summer! These juicy hamburgers are bursting with flavor thanks to onion, cheese, herbs, and lots of seasonings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine ground beef, onion, cheese, egg, onion soup mix, minced garlic, garlic powder, soy sauce, Worcestershire sauce, parsley, basil, oregano, rosemary, salt, and pepper in a large bowl."
    },
    {
      "position": 3,
      "text": "Use your hands to form the mixture into 4 patties."
    },
    {
      "position": 4,
      "text": "Cook patties on the preheated grill until no longer pink in the center and the juices run clear, about 4 to 5 minutes per side."
    },
    {
      "position": 5,
      "text": "An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "391f64d3-8bf0-5976-9b3f-043c43da08d9",
  "slug": "grilled-country-style-ribs",
  "name": "Grilled Country-Style Ribs",
  "recipe_type": "main",
  "brief_description": "This grilled country-style rib recipe is easy to prepare by marinating pork ribs, before grilling and basting them with barbecue sauce until tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine wine, \u00bc cup barbecue sauce, cider vinegar, hot sauce, Worcestershire sauce, and mustard in a medium bowl until well mixed. Place ribs in a baking dish; pour wine mixture over ribs and coat thoroughly."
    },
    {
      "position": 2,
      "text": "Combine onion powder and garlic powder in a small bowl; sprinkle over ribs. Marinate at room temperature for 2 hours, flipping once."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill to medium-low, indirect heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Cook ribs on the preheated grill, covered, over indirect heat for 45 minutes, flipping once. Baste with barbecue sauce; continue grilling until meat is tender, about 15 minutes more, flipping and basting frequently."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

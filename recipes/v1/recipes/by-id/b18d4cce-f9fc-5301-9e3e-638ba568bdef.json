  "id": "b18d4cce-f9fc-5301-9e3e-638ba568bdef",
  "slug": "creamy-mushroom-soup",
  "name": "Creamy Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "This fresh and creamy soup is easy to make, and filled with hearty chopped mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt the butter in a large saucepan over medium-high heat. Saute the shiitake mushrooms, portobello mushrooms, and shallots for about 5 minutes, or until soft. Mix in the flour until smooth. Gradually stir in the chicken broth. Cook, stirring, 5 minutes, or until thick and bubbly."
    },
    {
      "position": 2,
      "text": "Stir in the half-and-half, season with salt and pepper, and sprinkle with cinnamon. Heat through, but do not boil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

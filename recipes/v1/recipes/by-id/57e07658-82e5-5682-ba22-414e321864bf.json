  "id": "57e07658-82e5-5682-ba22-414e321864bf",
  "slug": "minestrone-soup-i",
  "name": "Hearty Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "This tasty minestrone soup recipe is a hearty combination of fresh veggies, cabbage, potatoes, beans, and macaroni pasta, topped with Parmesan cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt margarine in a heavy stockpot over medium heat. Add onion, carrots, and celery; saut\u00e9 until beginning to soften, 3 to 4 minutes. Add broth, beans, tomatoes, potatoes, cabbage, parsley, tomato paste, garlic, and salt; bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce the heat, cover, and simmer until vegetables are tender, about 1 hour. Add pasta and simmer for 30 minutes more. Adjust seasoning as needed."
    },
    {
      "position": 3,
      "text": "Ladle into bowls and garnish with Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 25,

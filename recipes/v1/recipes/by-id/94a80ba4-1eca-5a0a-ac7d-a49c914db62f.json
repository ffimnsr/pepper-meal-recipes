  "id": "94a80ba4-1eca-5a0a-ac7d-a49c914db62f",
  "slug": "peanut-butter-chocolate-chip-cookies-from-heaven",
  "name": "Peanut Butter Chocolate Chip Cookies from Heaven",
  "recipe_type": "dessert",
  "brief_description": "The name says it all. Use the heavenly combination of chocolate and peanut butter with this recipe for cookies everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together brown sugar and butter. Beat in peanut butter, eggs, and vanilla. Add flour, cornstarch, baking soda, salt, and baking powder. Stir in chocolate chips."
    },
    {
      "position": 3,
      "text": "Drop 1 1/2 teaspoonfuls of dough 2 inches apart onto ungreased cookie sheets. Flatten slightly because they do not spread much while baking."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

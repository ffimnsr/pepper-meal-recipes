  "slug": "arugula-hummus",
  "name": "Arugula Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Classic hummus gets a little kick with the addition of peppery arugula. Serve this as a dip or sandwich spread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place garbanzo beans, arugula, tahini, lemon juice, and garlic in a food processor; pulse until garbanzo beans are chopped. Slowly drizzle olive oil into garbanzo bean mixture while blending until mixture is smooth. Season with salt and pepper."
    }
  ],

  "id": "5a4873e8-bd66-5fd3-b17c-e80858c1ae9d",
  "slug": "3-ingredient-lemon-scones",
  "name": "3-Ingredient Lemon Scones",
  "recipe_type": "breakfast",
  "brief_description": "These deliciously light scones are quick and easy to make with just 3 ingredients: self-rising flour, lemon soda, and cream. Serve with whipped cream and berry jam.",
  "cuisine": "Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet with cooking spray; lightly dust with flour."
    },
    {
      "position": 2,
      "text": "Sift self-rising flour into a large bowl. Combine lemon soda and cream and pour over the flour. Mix until dough is just combined. Turn dough out onto the prepared baking sheet. Flour your hands and gently pat dough into a large rectangle. Do not overwork the dough. Cut into triangles or squares."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden, 10 to 12 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

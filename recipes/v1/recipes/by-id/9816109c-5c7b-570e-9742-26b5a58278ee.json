  "id": "9816109c-5c7b-570e-9742-26b5a58278ee",
  "slug": "impossible-stuffed-peppers",
  "name": "Impossible Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These easy vegetarian stuffed peppers are loaded with goodness, such as fresh spinach, black beans, rice, spices, and Impossible Burger.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and rice in a saucepan; bring to a boil. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat 2 tablespoons olive oil in a medium pot. Add 1/2 of the onion, 1/2 of the poblano, and 1/2 of the garlic; saut\u00e9 for 3 minutes. Stir in black beans and 1/2 of the tomatoes. Cover and simmer for 5 minutes. Stir cooked rice into black bean mixture. Season with cumin, chipotle, and salt. Set aside."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon olive oil in a skillet. Add remaining onion, poblano, and garlic; saut\u00e9 for 3 minutes. Add Impossible Burger; be sure to crumble well. Season with adobo and salt. Cook and stir until no longer pink, 5 to 6 minutes. Add black bean-rice mixture, spinach, and remaining tomatoes to the skillet. Mix well and simmer for 3 minutes."
    },
    {
      "position": 5,
      "text": "Cut tops off bell peppers and remove cores. Use a spoon to stuff each pepper with filling. Arrange in a baking dish."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until peppers are tender, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "deb730cd-619c-5460-990b-3f6b5c601e5c",
  "slug": "linguine-and-clam-sauce",
  "name": "Linguine and Clam Sauce",
  "recipe_type": "salad",
  "brief_description": "This is a very easy and tasty recipe. My family loves it. Try serving it with a green salad and garlic bread if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain and reserve."
    },
    {
      "position": 2,
      "text": "In a small saucepan over medium heat, warm oil, butter, reserved clam juice, garlic and parsley; stir and simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Add clams and salt and pepper to taste. Pour over pasta and toss with Parmesan cheese; serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

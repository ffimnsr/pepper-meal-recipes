  "id": "3bc52d2c-cca8-5d50-877d-e11848b40d89",
  "slug": "grandmas-very-easy-pie-crust",
  "name": "Grandma's Very Easy Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "A simple, tasty pie crust needs just flour, vegetable oil, a little milk, and salt. No kneading is required. Just roll out the crust between pieces of waxed paper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sift flour and salt into a bowl. Pour vegetable oil into a 1-cup measure and fill the measure with milk up to the 7-ounce mark. Whisk oil and milk together and pour immediately into the bowl with flour. Mix the crust together with a fork just until it holds together. Do not knead."
    },
    {
      "position": 2,
      "text": "Divide crust in half, form into balls, and roll each half out between sheets of waxed paper. Peel waxed paper from crusts to fit into pie plate."
    }
  ],
  "servings": 8,

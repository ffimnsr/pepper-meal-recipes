  "id": "f2109ccf-3911-58cf-896a-015271037151",
  "slug": "chef-johns-pumpkin-creme-brulee",
  "name": "Chef John\u2019s Pumpkin Creme Brulee",
  "recipe_type": "dessert",
  "brief_description": "This classic creme brulee gets a seasonal twist with pumpkin puree, cinnamon, allspice, and nutmeg.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks and brown sugar together in a large bowl. Stir in heavy cream, pumpkin puree, allspice, cinnamon, nutmeg, and salt."
    },
    {
      "position": 3,
      "text": "Divide pumpkin mixture between seven (5-inch) ramekins about 1/2 inch from the top."
    },
    {
      "position": 4,
      "text": "Place the ramekins in a baking dish and fill with the baking dish hot water to reach halfway up the sides of the ramekins."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until just set, 30 to 35 minutes. Remove ramekins and refrigerate until completely cool, at least 2 hours."
    },
    {
      "position": 6,
      "text": "Sprinkle about 1 tablespoon of sugar onto each creme brulee. Melt the sugar with a chef\u2019s torch until crisp and dark brown, 1 to 2 minutes. Allow to cool before serving."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

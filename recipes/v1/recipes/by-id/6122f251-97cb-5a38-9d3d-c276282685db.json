  "slug": "very-easy-fruit-salad",
  "name": "Very Easy Fruit Salad",
  "recipe_type": "salad",
  "brief_description": "Who knew that peach pie filling tasted so good when stirred into a bowl of sliced fruit - kiwi, bananas, grapes, and strawberries? Makes eight very generous servings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine the strawberries, grapes, kiwis, and bananas. Gently mix in peaches. Chill for 1 hour before serving."
    }

  "id": "34142245-44d6-55cb-87ff-8cfc67298474",
  "slug": "raspberry-ice-cream-recipe-7487374",
  "name": "Raspberry Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "Raspberry ice cream is quick and easy to make at home and delicious year round.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk egg yolks briefly in a small bowl. Heat 3/4 cup cream and 1/2 cup sugar in a heavy-bottomed pot over medium heat, until sugar dissolves and cream is hot. Whisk a little of the hot cream into the egg yolks to temper. Then whisk warm yolk mixture into hot cream and cook, stirring constantly, until mixture thickens enough to coat the back of a spoon. Do not let mixture boil. Remove from heat and quickly strain through a sieve into a bowl."
    },
    {
      "position": 2,
      "text": "Whisk in remaining 3/4 cup cream, cover mixture, and chill in the refrigerator."
    },
    {
      "position": 3,
      "text": "Puree raspberries in a food processor, and pass the puree through a fine-mesh sieve to remove the seeds. Stir in 2 tablespoons sugar until sugar has dissolved. Add raspberry puree to the cold cream mixture. Stir in vanilla extract and salt. Chill in the refrigerator until mixture is cold, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer\u2019s instructions, about 20 minutes. Transfer to an airtight container and freeze until firm, about 4 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

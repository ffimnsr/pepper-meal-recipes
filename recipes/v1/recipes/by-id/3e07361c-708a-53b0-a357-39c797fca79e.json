  "id": "3e07361c-708a-53b0-a357-39c797fca79e",
  "slug": "peanut-butter-chocolate-pretzel-pie-recipe-11792998",
  "name": "Peanut Butter Chocolate Pretzel Pie",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter chocolate pretzel pie has a lush cream cheese and peanut butter layer atop a lightly baked pretzel crust, finished with layers of chocolate pudding, whipped topping, and crushed chocolate peanut butter candy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Stir pretzels, sugar, and melted butter together and press lightly into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven just until fragrant, about 10 minutes. Let cool to room temperature, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Beat cream cheese, peanut butter, confectioner's sugar, and vanilla together with an electric mixer until well blended, light, and fluffy. Fold in 2 1/2 cups whipped topping."
    },
    {
      "position": 4,
      "text": "Spread peanut butter mixture evenly over cooled crust."
    },
    {
      "position": 5,
      "text": "Whisk together chocolate pudding mix and milk until smooth, well combined, and slightly thickened."
    },
    {
      "position": 6,
      "text": "Carefully spread chocolate pudding mixture over peanut butter layer, taking care not to mix layers together. Top with remaining whipped topping."
    },
    {
      "position": 7,
      "text": "Sprinkle with chopped candies and refrigerate for at least 4 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

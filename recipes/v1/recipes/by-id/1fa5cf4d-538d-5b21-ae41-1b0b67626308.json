  "id": "1fa5cf4d-538d-5b21-ae41-1b0b67626308",
  "slug": "easy-apple-cinnamon-muffins",
  "name": "Easy Apple Cinnamon Muffins",
  "recipe_type": "dessert",
  "brief_description": "These moist apple muffins with cinnamon have a sweet and crunchy streusel topping; an easy recipe to make with your favorite fall apples.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C). Line 6 large (3\u00bd-inch) muffin cups with paper muffin liners."
    },
    {
      "position": 2,
      "text": "To make the muffins: Stir flour, sugar, baking powder, cinnamon, and salt together in a large bowl. Mix in egg, oil, and milk until just combined. Fold in chopped apples."
    },
    {
      "position": 3,
      "text": "Spoon \u00bd cup of batter into each muffin liner."
    },
    {
      "position": 4,
      "text": "To make the streusel topping: Place sugar, flour, butter, and cinnamon into a small bowl; mash mixture with a fork until mixture begins to cling together. Sprinkle topping evenly over unbaked muffins."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 5 minutes. Reduce oven temperature to 350 degrees F (175 degrees C) and bake until a toothpick inserted into the center of a muffin comes out clean, 25 to 30 minutes. Let cool in pan briefly; remove muffins and cool on a wire rack."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

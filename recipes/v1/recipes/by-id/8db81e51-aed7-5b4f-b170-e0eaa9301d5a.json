  "id": "8db81e51-aed7-5b4f-b170-e0eaa9301d5a",
  "slug": "pad-thai-noodles",
  "name": "Pad Thai Noodles",
  "recipe_type": "dessert",
  "brief_description": "Make authentic Pad Thai at home with this recipe for the popular noodle dish with a delicate balance of spicy, sweet, and sour flavors.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Place noodles in a large bowl and cover with hot water. Set aside until noodles are flexible but still firm, about 10 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Heat a wok or large skillet over medium-high heat until it starts to smoke. Add oil; heat until it shimmers. Add peanuts; cook and stir until roasted, 1 to 2 minutes. Remove from wok."
    },
    {
      "position": 3,
      "text": "Stir chile peppers, shallot, and garlic into the oil; cook and stir until garlic just begins to brown, about 30 seconds. Add chicken and tofu; cook until no longer pink in the center and the juices run clear, 4 to 5 minutes. Add noodles, stirring quickly to mix in and prevent them from sticking. Add sugar, tamarind paste, fish sauce, and white pepper together; cook, stirring constantly, until sauce thickens, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Push noodle mixture to one side of the wok; crack egg into the empty space. Stir until scrambled, 1 to 2 minutes; fold into noodles. Stir in shrimp; cook until opaque, 2 to 3 minutes. Add roasted peanuts, bean sprouts, chives, and lime juice; cook and stir until flavors combine, 1 to 2 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

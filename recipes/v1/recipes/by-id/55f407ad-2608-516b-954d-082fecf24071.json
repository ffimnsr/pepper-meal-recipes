  "id": "55f407ad-2608-516b-954d-082fecf24071",
  "slug": "creamy-saffron-shrimp-with-gnocchi-and-caramelized-onion",
  "name": "Creamy Saffron Shrimp with Gnocchi and Caramelized Onion",
  "recipe_type": "main",
  "brief_description": "It sounds fancy, but this shrimp with gnocchi and caramelized onion recipe is a simple and delicious meal you can easily make for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium heat. Stir in onion, mushrooms, and brown sugar. Cook and stir until onion has cooked to a deep brown color, about 10 minutes. Remove caramelized onions to a plate and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once water is boiling, stir in gnocchi and return to a boil. Cook until gnocchi floats to the top, about 3 minutes; drain and keep warm."
    },
    {
      "position": 3,
      "text": "Place the same skillet over medium-high heat and add shrimp. Cook and stir until shrimp have turned pink on the outside and are no longer translucent in the center, about 5 minutes. Add caramelized onions, sour cream, paprika, and saffron. Cook and stir until mixture begins to simmer, then gently fold in cooked gnocchi. Season with salt."
    },
    {
      "position": 4,
      "text": "Pour gnocchi mixture into a serving dish and sprinkle with Parmesan cheese and basil to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

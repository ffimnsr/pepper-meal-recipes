  "id": "afa17164-13c7-5fe6-8477-b1d2347aee58",
  "slug": "favorite-bourbon-pecan-pie",
  "name": "Bourbon Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This gooey bourbon pecan pie swaps vanilla for bourbon, giving this classic holiday dessert a rich, decadent flavor you won\u2019t forget!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all your ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix white sugar, brown sugar, and butter together in a bowl."
    },
    {
      "position": 3,
      "text": "Stir in corn syrup, eggs, and bourbon, then fold in pecans."
    },
    {
      "position": 4,
      "text": "Pour mixture into the pie crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue to bake until the center is set but slightly jiggly, 25 to 30 minutes more."
    },
    {
      "position": 6,
      "text": "Remove from the oven and cool completely on a wire rack before slicing. Pie will set as it cools."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

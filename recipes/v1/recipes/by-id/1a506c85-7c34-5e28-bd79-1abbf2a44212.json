  "id": "1a506c85-7c34-5e28-bd79-1abbf2a44212",
  "slug": "easy-vegetable-galette-recipe-11866892",
  "name": "Easy Vegetable Galette",
  "recipe_type": "main",
  "brief_description": "This easy vegetable galette is a rustic pie, baked on a flat surface. A few shortcuts make the baking easier: refrigerated pie crust, frozen mixed vegetables, and Boursin cheese take much of the effort out of making this luxurious, savory pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) and line a sheet pan or cookie sheet with parchment paper. Unroll pie dough on the prepared pan."
    },
    {
      "position": 2,
      "text": "Heat vegetables in a microwave-safe bowl, with no added water, until warm, about 3 minutes. Line a platter with paper towels, and pour vegetables on the paper towels to drain thoroughly."
    },
    {
      "position": 3,
      "text": "Slice bacon crosswise into 1/4-inch strips, or lardons. Place lardons in a nonstick skillet and cook over medium heat until brown and crispy, 3 to 5 minutes. Line a plate with paper towels; remove lardons to the plate to drain; set aside. Leave bacon fat in the skillet."
    },
    {
      "position": 4,
      "text": "Add onion to the same skillet, and cook until softened, 3 to 5 minutes. Sprinkle flour over all, and stir 1 to 2 minutes, making sure all the flour is moistened by the bacon fat. Gradually stir in cream, stirring constantly, until bubbly, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Crumble Boursin into sauce and stir until melted, 1 to 2 minutes. Remove from heat and allow to cool, 3 to 5 minutes; sauce will be thick. Season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Stir drained vegetables into sauce until well mixed; pour onto pie crust and spread to within 2 inches of crust edges. Fold up the edge over the vegetables; dampen fingers to pinch dough into little pleats. Brush dough with egg wash."
    },
    {
      "position": 7,
      "text": "Bake in the center of the preheated oven, until crust is golden brown, 35 to 40 minutes."
    },
    {
      "position": 8,
      "text": "Remove from the oven; scatter lardons over the top. Cool on a wire rack for about 5 minutes. Cut into 6 pieces, and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

  "id": "cddcfde0-9a70-5f99-af04-e09222f7dbc9",
  "slug": "spicy-shrimp-stuffed-mushrooms",
  "name": "Spicy Shrimp-Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These mushroom appetizers are stuffed with spicy cayenne-infused cream cheese, then breaded and topped with shrimp for the perfect indulgent finger food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Carefully remove mushroom stems and chop stems into small pieces. Set mushroom caps aside."
    },
    {
      "position": 3,
      "text": "Heat butter in a skillet over medium heat. Add mushroom stems and garlic. Cook and stir until soft, 3 to 5 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Combine cream cheese, cayenne pepper, black pepper, and salt together in a bowl. Stir in cooked mushroom stem mixture, retaining butter in the skillet."
    },
    {
      "position": 5,
      "text": "Return skillet to medium heat and add shrimp. Cook and stir until shrimp are just opaque, 3 to 5 minutes. Remove from heat."
    },
    {
      "position": 6,
      "text": "Pour bread crumbs into a shallow bowl. Fill each mushroom cap with cream cheese mixture and press mushroom, cream cheese-side down, into the bread crumbs to coat the top. Stick a cooked shrimp on top of each filled mushroom and place into a baking pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until hot and juicy, about 20 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "66a7ceb9-8d73-5f9a-90d1-b63bcf50ccda",
  "slug": "italian-sausage-stuffed-cabbage-rolls",
  "name": "Italian Sausage-Stuffed Cabbage Rolls",
  "recipe_type": "main",
  "brief_description": "You can make this Italian sausage and rice-stuffed cabbage rolls recipe with mild or spicy sausage. It is easy to make and is bursting with Italian flavor.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Add olive oil to a medium-sized baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add cabbage leaves; cook until tender, about 12 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, add sausage to a skillet over medium-high heat; cook and stir until browned and crumbly, breaking into pieces as it cooks, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine marinara sauce and tomato sauce in a saucepan over medium-low heat; cook until warm, about 3 minutes. Set sauce aside."
    },
    {
      "position": 5,
      "text": "Combine sausage, cooked rice, \u00bd cup sauce, 2 teaspoons basil, and 2 teaspoons oregano in a bowl; spread onto cabbage leaves and roll up like small burritos. The amount of filling will vary depending on size of cabbage leaves. Place cabbage rolls close together in the prepared baking dish; spoon remaining \u00bd sauce over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cooked through, about 30 minutes. Garnish with basil and oregano."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "9029a2eb-564b-5259-9d1e-d8c50fcd144d",
  "slug": "stuffed-eggs",
  "name": "Stuffed Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Hard-boiled egg halves are stuffed with a creamy mixture of mayo, mustard, and grated Parmesan cheese for a guaranteed crowd pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a large pot and cover with cool water. Bring to a boil and cook, stirring occasionally, for 10 minutes. Transfer eggs to a bowl of cold water using tongs. Peel."
    },
    {
      "position": 2,
      "text": "Cut eggs in half. Slice a small piece off bottoms so halves don't tip over. Place yolks in a mixing bowl. Add mayonnaise, mustard, Parmesan cheese, salt, and pepper. Mix until creamy, 1 or 2 minutes."
    },
    {
      "position": 3,
      "text": "Spoon yolk mixture into egg white halves. Garnish with a dot of ketchup on top. Refrigerate about 20 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

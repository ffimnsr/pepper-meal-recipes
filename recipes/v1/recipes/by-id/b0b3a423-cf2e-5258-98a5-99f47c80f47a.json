  "schema_version": 1,
  "id": "b0b3a423-cf2e-5258-98a5-99f47c80f47a",
  "slug": "roast-leg-of-lamb",
  "name": "Roast Leg of Lamb",
  "recipe_type": "main",
  "brief_description": "This foolproof leg of lamb recipe with garlic and rosemary is incredibly simple to prep for a tender, flavorsome, and impressive holiday meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut deep slits on the top of leg of lamb every 3 to 4 inches; push slices of garlic down into the slits. Generously season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place lamb on a roasting pan; arrange several sprigs of fresh rosemary under and on top of the lamb."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven for 1 3/4 to 2 hours, or until an instant-read thermometer inserted into the center of the lamb reads at least 135 degrees F (57 degrees C) for medium-rare to medium doneness."
    },
    {
      "position": 5,
      "text": "Cover lamb with aluminum foil and let rest for at least 10 minutes before carving."
    },
    {
      "position": 6,
      "text": "Serve with your favorite sides, enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 105,

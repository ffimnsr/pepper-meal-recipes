  "id": "5d2a9154-4bb1-51d6-a46e-19903b4426f3",
  "slug": "potato-salad-with-beans-and-yogurt-dressing-recipe-8425567",
  "name": "Potato Salad with Beans and Yogurt Dressing",
  "recipe_type": "salad",
  "brief_description": "This potato salad with beans and yogurt dressing gets its creamy texture from a yogurt dressing, cannellini beans, and lima beans rather than mayonnaise.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes and lima beans in a large pot, and cover with salted water by about 1 inch. Bring water to a boil, then reduce heat, and simmer until potatoes are tender, 9 to 12 minutes. Drain and cool for 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk yogurt, vinegar, Dijon, salt, and pepper together in a bowl until well combined."
    },
    {
      "position": 3,
      "text": "Add cannellini beans, dill, red onion, Kalamata olives, celery, potatoes, and lima beans. Toss gently until everything is well coated, and season to taste with salt and pepper."
    },
    {
      "position": 4,
      "text": "This may be served at room temperature or chilled. To serve, evenly divide lettuce among serving plates, and top with potato salad."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

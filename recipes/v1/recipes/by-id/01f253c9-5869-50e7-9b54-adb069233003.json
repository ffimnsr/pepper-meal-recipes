  "schema_version": 1,
  "id": "01f253c9-5869-50e7-9b54-adb069233003",
  "slug": "fresh-blackberry-crumble-bars",
  "name": "Fresh Blackberry Crumble Bars",
  "recipe_type": "dessert",
  "brief_description": "Fresh blackberries and blackberry preserves make the filling in these blackberry crumble bars wonderfully rich and moist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine blackberries, blackberry preserves, white sugar, cornstarch, and 1/8 teaspoon kosher salt in a small saucepan."
    },
    {
      "position": 2,
      "text": "Heat on medium-high heat, stirring constantly, until the mixture comes to a boil. Reduce heat to medium, and continue stirring, occasionally, 7 to 10 minutes, making sure the mixture doesn't stick to the bottom of the pan."
    },
    {
      "position": 3,
      "text": "When the mixture has thickened, remove from the heat and allow to cool."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C) and line an 8x 8-inch baking pan with a large piece of parchment paper, covering the bottom and coming up on 2 sides, to make a sling. Spray parchment paper and exposed sides of the pan with cooking spray."
    },
    {
      "position": 5,
      "text": "Combine oats, flour, light brown sugar, sliced almonds, cinnamon, soda, and salt in a bowl; stir until well mixed. Drizzle in melted butter, tossing and stirring the crumble ingredients until the flour and oats are incorporated."
    },
    {
      "position": 6,
      "text": "Spread out 2 cups of the crumble mixture onto the prepared pan, using finger tips or the bottom of a measuring cup to firmly flatten and smooth."
    },
    {
      "position": 7,
      "text": "Pre-bake in the preheated oven about 10 minutes. Remove from oven and allow to cool for 5 minutes."
    },
    {
      "position": 8,
      "text": "Pour filling over the crust, and sprinkle on remaining crumble mixture evenly over the top. Return the pan to the oven and bake until the top is lightly browned and the filling is bubbly, about 40 minutes."
    },
    {
      "position": 9,
      "text": "Cool completely in the pan, 1 to 2 hours."
    },
    {
      "position": 10,
      "text": "When the bars are cool, use the parchment to lift the them out of the pan. Cut into 9 servings, and serve at room temperature. Refrigerate any leftovers."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

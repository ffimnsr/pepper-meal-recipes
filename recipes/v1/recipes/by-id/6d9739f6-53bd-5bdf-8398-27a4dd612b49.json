  "id": "6d9739f6-53bd-5bdf-8398-27a4dd612b49",
  "slug": "blueberry-and-basil-bourbon-smash-recipe-12012219",
  "name": "Blueberry and Basil Bourbon Smash",
  "recipe_type": "appetizer",
  "brief_description": "For this bourbon martini, summer blueberries and basil are muddled together to provide a beautiful color and herbal, fruity flavor. A little fresh lemon juice and a smidge of simple syrup balance the cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place basil and blueberries into a cocktail shaker and mash well with a cocktail muddler. Pour in bourbon, blueberry lemonade, lemon juice, and simple syrup. Fill with ice, cover, and shake until the outside of the shaker has frosted."
    },
    {
      "position": 2,
      "text": "Strain into a chilled rocks glass and garnish with a lemon wedge, basil leaf, or fresh blueberries."
    }
  ],
  "servings": 1,

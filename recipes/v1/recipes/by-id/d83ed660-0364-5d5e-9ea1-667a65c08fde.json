  "id": "d83ed660-0364-5d5e-9ea1-667a65c08fde",
  "slug": "easy-lemon-cheesecake-bars",
  "name": "Easy Lemon Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "A sweet mixture of lemon pie filling and cream cheese is baked between sheets of crescent roll dough in this simple recipe for lemon cheesecake bars.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Unroll both pieces of crescent dough. Lay one piece on the bottom of the prepared pan. Set second piece aside."
    },
    {
      "position": 3,
      "text": "Combine cream cheese and 1/2 cup white sugar in a bowl; beat with an electric mixer until smooth. Mix in lemon pie filling, lemon zest and juice, and vanilla extract. Pour over crescent dough in the baking pan and cover with the second piece of dough. Pour melted butter over top and sprinkle with remaining white sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and place on a wire rack until completely cool, about 30 minutes. Chill in the refrigerator for at least 3 hours, or overnight."
    },
    {
      "position": 6,
      "text": "Dust with confectioners' sugar and cut into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d31ae2c4-1e4a-527d-baf8-10f504c1c046",
  "slug": "air-fryer-garlic-and-parsley-baby-potatoes",
  "name": "Air Fryer Garlic and Parsley Baby Potatoes",
  "recipe_type": "side",
  "brief_description": "Simple air fryer baby potatoes tossed in avocado oil, garlic, and parsley, then cooked until crispy on the outside and tender on the inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes into a bowl; add oil and toss to coat. Add garlic, parsley, and salt; toss until well distributed. Transfer potatoes to the air fryer basket."
    },
    {
      "position": 3,
      "text": "Place the basket into the preheated air fryer and cook, tossing occasionally, until golden brown, 20 to 25 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

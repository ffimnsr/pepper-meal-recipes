  "id": "ae821ebc-75e5-5b7c-9058-893ac8dc2064",
  "slug": "fresh-fig-cake",
  "name": "Fresh Fig Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist fig cake has pieces of fresh ripe figs in the cake and a layer of homemade fig preserves. Top with fresh fig slices for a beautiful dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray two 8-inch round cake pans with cooking spray."
    },
    {
      "position": 2,
      "text": "To make the fig cake: Sift flour, salt, and baking powder together in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter together in a large mixing bowl with an electric beater until fluffy. Add egg and beat well. Add flour mixture alternately with evaporated milk. Fold in vanilla, almond extract, and 1 cup chopped figs."
    },
    {
      "position": 4,
      "text": "Spoon cake batter evenly into the prepared cake pans. Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool cake layers on a wire rack."
    },
    {
      "position": 5,
      "text": "To make the fig filling: Combine 2 cups chopped figs, brown sugar, water, and lemon juice in a saucepan. Bring to a boil. Reduce heat to a simmer and cook until thickened, about 20 minutes. Spread thinly between cooled cake layers and on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

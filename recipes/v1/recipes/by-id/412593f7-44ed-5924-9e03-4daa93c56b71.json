  "id": "412593f7-44ed-5924-9e03-4daa93c56b71",
  "slug": "easy-oven-pulled-pork",
  "name": "Easy Oven Pulled Pork",
  "recipe_type": "main",
  "brief_description": "This no-fail pork recipe produces tender, moist, rich meat which can be used in sandwiches, tacos, stews, and pasta ragu.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Use a pairing knife to cut 8 small slits into the pork, about 1 \u00bd inches deep. Insert a garlic clove into each slit. Sprinkle pork evenly on all sides with salt and pepper. Place pork, fat-side up, in a 9x13-inch metal baking dish or Dutch oven."
    },
    {
      "position": 3,
      "text": "Cook in the preheated oven for 30 minutes."
    },
    {
      "position": 4,
      "text": "Reduce heat to 325 degrees F (165 degrees C). Carefully pour 3/4 cup water around the sides of the pork. Cover with foil or a lid and cook for 2 \u00bd hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove from the oven and let stand for 20 minutes. Remove large fat layer and any other large pieces of fat. Pull pork apart and shred."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 15,

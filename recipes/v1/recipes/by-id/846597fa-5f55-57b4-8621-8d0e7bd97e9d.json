  "id": "846597fa-5f55-57b4-8621-8d0e7bd97e9d",
  "slug": "easy-tuna-pasta-salad",
  "name": "Easy Tuna Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This simple and colorful tuna pasta salad with boiled eggs, peas, red onion, and a creamy honey-lemon dressing is always a hit at summer parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; cook pasta at a boil until tender yet firm to the bite, 9 to 10 minutes. Drain and transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "To make the dressing: Whisk mayonnaise, 3 tablespoons lemon juice, honey, garlic powder, salt, and pepper together in a medium bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Stir tuna, celery, onion, peas, parsley, olives, and 1 teaspoon lemon juice into pasta. Pour dressing over salad, toss until coated, and add hard-boiled eggs on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

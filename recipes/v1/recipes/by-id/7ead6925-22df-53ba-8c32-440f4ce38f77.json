{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7ead6925-22df-53ba-8c32-440f4ce38f77",
  "slug": "stuffed-cabbage-rolls-with-tomato-sauce",
  "name": "Stuffed Cabbage Rolls with Tomato Sauce",
  "recipe_type": "main",
  "brief_description": "Stuffed cabbage rolls with savory tomato sauce and a deliciously seasoned filling of beef, pork, veal, and rice will warm you up on a cold winter night.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage, core-side down, into an 8- to 10-cup microwave-safe casserole dish. Add 1/2 cup water, cover, and microwave on high until outer leaves are soft, 10 to 15 minutes. Drain and cool."
    },
    {
      "position": 2,
      "text": "While the cabbage is cooling, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine ground beef, pork, veal, rice, onion, parsley, egg, garlic, salt, and pepper in a large bowl. Add 1 teaspoon each of thyme, basil, and oregano; mix until well combined."
    },
    {
      "position": 4,
      "text": "Remove 12 outer leaves from the cooled cabbage and trim off any thick stems to make them easier to roll. Reserve remaining cabbage for another use or discard."
    },
    {
      "position": 5,
      "text": "Divide meat mixture into 12 equal portions. Place one portion onto the stem end of each cabbage leaf. Roll up the leaves and fold in the ends. Place the rolls, seam-side down, in a single layer in a casserole dish."
    },
    {
      "position": 6,
      "text": "Combine crushed tomatoes with remaining thyme, basil, and oregano and pour over cabbage rolls."
    },
    {
      "position": 7,
      "text": "Cover and bake in the preheated oven until meat is cooked through, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C). Let stand for 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

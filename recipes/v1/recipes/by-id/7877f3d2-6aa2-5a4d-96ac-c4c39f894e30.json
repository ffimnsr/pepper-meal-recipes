  "id": "7877f3d2-6aa2-5a4d-96ac-c4c39f894e30",
  "slug": "pressure-cooker-bone-in-pork-chops-baked-potatoes-and-carrots",
  "name": "Pressure Cooker Bone-In Pork Chops, Baked Potatoes, and Carrots",
  "recipe_type": "main",
  "brief_description": "This pressure cooker pork chop recipe features bone-in chops, baked potatoes, and carrots cooked in a pressure cooker for a quick and easy meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season pork chops with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter in a pressure cooker over medium-high heat. Working in batches, cook pork chops in hot butter until browned, 3 to 5 minutes per side. Transfer pork chops to a plate."
    },
    {
      "position": 4,
      "text": "Melt remaining 2 tablespoons butter in the pressure cooker. Saut\u00e9 onion and carrots in hot butter until fragrant, about 2 minutes; pour in broth and Worcestershire sauce."
    },
    {
      "position": 5,
      "text": "Return pork chops to the pressure cooker pot."
    },
    {
      "position": 6,
      "text": "Set a steamer basket on top of pork chops and place potatoes in the basket."
    },
    {
      "position": 7,
      "text": "Close and lock the lid. Select high pressure according to the manufacturer\u2019s instructions; set the timer for 13 minutes. Allow 10 to 15 minutes for pressure to build. Release pressure using the natural-release method, 10 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 8,
      "text": "Slice potatoes along their tops and serve with pork chops and carrots."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

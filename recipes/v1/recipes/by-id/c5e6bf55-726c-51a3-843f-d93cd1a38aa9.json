  "id": "c5e6bf55-726c-51a3-843f-d93cd1a38aa9",
  "slug": "one-bowl-blackberry-cobbler-recipe-8646365",
  "name": "One Bowl Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This one bowl blackberry cobbler is super easy to make with only 6 ingredients. For an extra-crunchy topping, place it in the air fryer for 5 minutes after it is finished baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray an 8x8-inch baking dish with nonstick cooking spray. Evenly distribute blackberries in the dish; set aside."
    },
    {
      "position": 2,
      "text": "Combine sugar, flour, egg, butter and vanilla in a bowl and stir until well combined. Drop by spoonfuls over fruit and spread with a spatula."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until fruit is bubbly, 38 to 43 minutes."
    },
    {
      "position": 4,
      "text": "Optional: Heat an air fryer to 400 degrees F (200 degrees C). Place cobbler in the air fryer until topping is crunchy, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

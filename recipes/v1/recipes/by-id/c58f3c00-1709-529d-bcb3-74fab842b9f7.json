  "id": "c58f3c00-1709-529d-bcb3-74fab842b9f7",
  "slug": "mini-banana-bread-loaves",
  "name": "Mini Banana Bread Loaves",
  "recipe_type": "appetizer",
  "brief_description": "These moist mini banana bread loaves with oats and raisins are perfect for breakfast or a late-day snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flours, oats, baking soda, cinnamon, and salt in a medium bowl. Mash bananas into the dry ingredients."
    },
    {
      "position": 3,
      "text": "Combine sugars and margarine in a large bowl; beat with an electric mixer until creamy. Mix in milk and vanilla extract. Add the flour mixture and raisins; mix well. Pour batter into 4 mini silicone loaf pans. Place loaf pans on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

  "id": "3efc9b83-8c3a-520a-af7e-d71c8a6e4494",
  "slug": "hot-cocoa-mix-in-a-jar",
  "name": "Hot Cocoa Mix in a Jar",
  "recipe_type": "drink",
  "brief_description": "Dress up this hot cocoa mix in a jar for a fun holiday gift! We love to take these to holiday parties and on camping trips for a quick hot chocolate by the fire.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make two tags with the following instructions: \"Hot Cocoa: Dissolve 1/3 cup cocoa mix in 1 cup boiling water.\""
    },
    {
      "position": 2,
      "text": "Whisk powdered milk, drink mix, pudding mix, powdered creamer, confectioners' sugar, and cocoa together in a large bowl. Divide mixture between two 1-quart jars. Seal the jars, decorate as desired, and attach the tags."
    }
  ],

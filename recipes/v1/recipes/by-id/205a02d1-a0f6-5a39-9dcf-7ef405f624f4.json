  "id": "205a02d1-a0f6-5a39-9dcf-7ef405f624f4",
  "slug": "instant-pot-creme-brulee",
  "name": "Instant Pot Creme Brulee",
  "recipe_type": "dessert",
  "brief_description": "Creme brulee, everyone's favorite French dessert, is quick and easy to make in the Instant Pot.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Place a trivet in a multi-functional pressure cooker (such as Instant Pot); add 1 cup water."
    },
    {
      "position": 2,
      "text": "Heat heavy cream in the microwave until very hot, but not boiling, about 45 seconds."
    },
    {
      "position": 3,
      "text": "Whisk egg yolks, 2 1/2 tablespoons sugar, vanilla, and salt together in a mixing bowl. Add 2 tablespoons of the warm cream and whisk quickly. Slowly add in the remaining cream, stirring well. Pour the mixture into three 6-ounce ramekins."
    },
    {
      "position": 4,
      "text": "Cover ramekins with foil and place on the trivet, stacking if necessary. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 8 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Check custard; it should jiggle around the edges but not be liquid; it will set up more as it cools. Let cool to room temperature, 15 to 30 minutes. Refrigerate for 4 hours."
    },
    {
      "position": 6,
      "text": "Top each custard with 1 teaspoon sugar. Heat sugar with a kitchen torch until caramelized, about 30 seconds. Serve immediately."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

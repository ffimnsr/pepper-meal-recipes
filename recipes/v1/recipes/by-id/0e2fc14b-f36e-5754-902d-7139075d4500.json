  "id": "0e2fc14b-f36e-5754-902d-7139075d4500",
  "slug": "easy-philly-oreo-cheesecake",
  "name": "Oreo Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This Oreo cheesecake combines chocolate sandwich cookies and cream cheese with a chocolate cookie crust for a rich, decadent, easy-to-prepare dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place 16 cookies in a resealable plastic bag. Flatten bag to remove excess air, then seal bag. Finely crush cookies by rolling a rolling pin across the bag."
    },
    {
      "position": 3,
      "text": "Place crushed cookies in a bowl. Add melted butter; mix well."
    },
    {
      "position": 4,
      "text": "Press mixture firmly onto bottom of a 9-inch springform pan."
    },
    {
      "position": 5,
      "text": "Beat cream cheese, sugar, and vanilla in a large bowl with an electric mixer on medium speed until well-blended."
    },
    {
      "position": 6,
      "text": "Beat in eggs, 1 at a time, until just blended."
    },
    {
      "position": 7,
      "text": "Chop remaining 8 cookies; gently stir 1/2 of the chopped cookies into cream cheese batter."
    },
    {
      "position": 8,
      "text": "Pour over prepared crust; sprinkle remaining chopped cookies on top."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until center is just set, about 45 minutes."
    },
    {
      "position": 10,
      "text": "Refrigerate for 3 hours to overnight. Cut cheesecake into 12 equal pieces; store leftovers in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

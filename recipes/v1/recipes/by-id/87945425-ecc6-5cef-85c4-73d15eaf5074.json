  "id": "87945425-ecc6-5cef-85c4-73d15eaf5074",
  "slug": "rich-almond-milk-eggnog-recipe-8409698",
  "name": "Rich Almond Milk Eggnog",
  "recipe_type": "appetizer",
  "brief_description": "This rich almond milk eggnog is dairy-free, and suitable for anyone who is lactose intolerant or just prefers plant-based milks. Its richness comes from the addition of a duck egg, and it has a thinner texture than commercial eggnog,",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Crack duck egg into a glass bowl. Using an electric wire whip, whip egg until yellow and frothy. Add almond milk, sugar, and vanilla; whip until combined."
    },
    {
      "position": 2,
      "text": "Divide beverage between two cups. Garnish with non-dairy whipped topping and freshly grated nutmeg. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

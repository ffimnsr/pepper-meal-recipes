  "id": "6afc34b3-1217-5c54-b548-2b377e34a05f",
  "slug": "gluten-free-peanut-butter-cookies",
  "name": "Gluten-Free Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This recipe is gluten-free and delicious! Pecans are great in these, but feel free to use peanuts or any other nut you choose.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheet."
    },
    {
      "position": 2,
      "text": "Combine peanut butter, eggs, and sugar and mix until smooth. Mix in chocolate chips and nuts, if desired. Spoon dough by tablespoons onto a cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake for 10 to 12 minutes or until lightly browned. Let the cookies cool on the cookie sheets for 5 to 10 minutes before removing."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,

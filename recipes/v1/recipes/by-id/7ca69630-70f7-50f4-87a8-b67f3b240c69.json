  "id": "7ca69630-70f7-50f4-87a8-b67f3b240c69",
  "slug": "easy-pizza-fondue",
  "name": "Easy Pizza Fondue",
  "recipe_type": "appetizer",
  "brief_description": "This kid-pleasing recipe for pizza fondue with mozzarella and Cheddar cheeses is a snap to make and always a hit!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium-high heat. Saute onion in hot oil until soft and translucent, 4 to 6 minutes."
    },
    {
      "position": 2,
      "text": "Heat a large pot over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 3,
      "text": "Stir beef, onion, and pizza sauce together in the same pot over medium-high heat. Add mozzarella cheese and Cheddar cheese one handful at a time, stirring until cheeses melt into the fondue before adding the next handfuls. Ladle fondue into bowls."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "4613bda5-fc65-5624-bf6b-ded8e6a7e462",
  "slug": "slaw-of-many-colors-recipe-8707151",
  "name": "Slaw of Many Colors",
  "recipe_type": "salad",
  "brief_description": "Made with red cabbage, green bell pepper, and tomato, this recipe is almost as colorful as Dolly Parton's song \"Coat of Many Colors.\"",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cabbage, green pepper, and onion in a large bowl. In a small bowl, whisk together mayonnaise, vinegar, powdered sugar, salt, and black pepper until smooth. Pour dressing over vegetables, tossing well to combine. Cover and chill at least 2 hours to allow everything to marinate."
    },
    {
      "position": 2,
      "text": "When ready to serve, gently stir in tomato and season to taste with additional salt and pepper. (Chill, covered, up to 5 days.)"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

  "id": "4b352f5b-773f-59de-be49-2d210c2c2573",
  "slug": "blueberry-gelatin-salad",
  "name": "Blueberry Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "This is a recipe I discovered about 25 years ago when grape gelatin was hard to find! It's a terrific side dish or a delicious dessert. It's very rich in flavor and can be made ahead of time. Also good with cherry gelatin and cherry pie filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix together gelatin powder, boiling water, pineapple and pie filling. Pour into a mold, or glass baking dish, and refrigerate until set, at least 2 hours."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together the cream cheese, sour cream, sugar and vanilla until smooth. Spread over the top of the gelatin. If using a mold, unmold the gelatin before applying topping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

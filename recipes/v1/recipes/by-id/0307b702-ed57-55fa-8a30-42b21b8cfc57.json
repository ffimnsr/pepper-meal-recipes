  "id": "0307b702-ed57-55fa-8a30-42b21b8cfc57",
  "slug": "coffee-mug-cake",
  "name": "Coffee Mug Cake",
  "recipe_type": "dessert",
  "brief_description": "This single-serving cake is made in a coffee mug and 'baked' in the microwave. Quick and easy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir 1 tablespoon softened butter and white sugar together in a coffee mug until fluffy; stir egg, sour cream, and vanilla extract into the butter mixture. Add 1/4 cup flour and baking powder into the mixture; stir until smooth."
    },
    {
      "position": 2,
      "text": "Mix 2 tablespoons flour, brown sugar, and cinnamon together in a bowl. Mash 1 tablespoon butter into the flour mixture with a fork or pastry cutter until mixture is crumbly; sprinkle over the cake batter in the mug."
    },
    {
      "position": 3,
      "text": "Cook in microwave oven on high for 1 minute. Continue cooking in 10-second intervals until a toothpick inserted into the middle comes out clean."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 8,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "name": "Rice Cooker Oats",
  "recipe_type": "breakfast",
  "brief_description": "Oatmeal made in the rice cooker is simple to prepare and is ready in about 20 minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix oats, water, milk, honey, sugar, vanilla extract, and salt together in a rice cooker."
    },
    {
      "position": 2,
      "text": "Cook oats in rice cooker until desired consistency is reached, 10 to 15 minutes."
    }
  ],

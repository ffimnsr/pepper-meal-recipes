  "id": "c2376287-f430-57d9-8339-bdb4c2b7e2ff",
  "slug": "viking-stew-recipe-11711198",
  "name": "Viking Stew",
  "recipe_type": "soup",
  "brief_description": "This Viking stew, made with meat, berries, mushrooms, plenty of fresh herbs, and root vegetables typically available to the Vikings, is a seemingly primitive dish with a remarkably sophisticated flavor.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Add pork to a large soup pot or Dutch oven. Add salt, honey, berries, lingonberry jam, and cold water, and turn the heat to high."
    },
    {
      "position": 2,
      "text": "While stew is coming to a boil, add garlic, dry thyme, and ground coriander. When mixture comes to a rolling boil, reduce heat to low, and simmer gently for 45 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Stir in onion, leeks, and mushrooms, and simmer until meat is almost, but not quite fork tender, about 45 minutes more."
    },
    {
      "position": 4,
      "text": "Stir in cabbage, carrots, and fennel; continue to simmer until vegetables and meat are very tender, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Season to taste with salt. Serve with fresh herbs scattered over the top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

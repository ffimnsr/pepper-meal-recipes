  "id": "4676920a-fdd5-57b7-a3b1-5a3322a6ff67",
  "slug": "blueberry-shortcake-recipe-7552490",
  "name": "Blueberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "Blueberries sandwiched between homemade shortcake topped with cream - blueberry shortcake is the perfect summer dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather your ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or a silicone baking mat."
    },
    {
      "position": 2,
      "text": "In a small bowl whisk together cream, egg, vanilla, and lemon zest, if desired; set aside."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, sugar, and salt in a large bowl."
    },
    {
      "position": 4,
      "text": "Cut in butter with a pastry blender until the mixture is the consistency of coarse crumbs."
    },
    {
      "position": 5,
      "text": "Gently stir in cream mixture, just until moistened."
    },
    {
      "position": 6,
      "text": "Roll on a lightly floured surface to 3/4-inch thick."
    },
    {
      "position": 7,
      "text": "Cut biscuits using a 2 1/2- to 3-inch round cutter or cut the dough as desired."
    },
    {
      "position": 8,
      "text": "Place biscuits on the prepared baking sheet. Bake until golden brown, 15 minutes."
    },
    {
      "position": 9,
      "text": "Cool biscuits for 5 minutes on the baking sheet. Cool completely on a wire rack."
    },
    {
      "position": 10,
      "text": "Combine 2 cups blueberries, sugar, and lemon juice in a medium saucepan."
    },
    {
      "position": 11,
      "text": "Bring mixture to a simmer and cook until thickened on medium-low, about 15 minutes, stirring regularly."
    },
    {
      "position": 12,
      "text": "Stir in remaining 1 cup blueberries. Cool for about 15 minutes."
    },
    {
      "position": 13,
      "text": "Add heavy whipping cream and powdered sugar to a medium bowl."
    },
    {
      "position": 14,
      "text": "Beat until medium peaks form, 3 to 4 minutes."
    },
    {
      "position": 15,
      "text": "Split shortcakes in half horizontally."
    },
    {
      "position": 16,
      "text": "Spoon half of the blueberry compote on the bottom halves of the shortcakes."
    },
    {
      "position": 17,
      "text": "Stack the shortcake tops on top. Top with remaining blueberry compote and whipped cream, if using."
    }
  ],
  "servings": 6,

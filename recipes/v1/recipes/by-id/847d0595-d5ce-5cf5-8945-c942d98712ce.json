  "id": "847d0595-d5ce-5cf5-8945-c942d98712ce",
  "slug": "lemony-steamed-fish",
  "name": "Lemony Steamed Fish",
  "recipe_type": "drink",
  "brief_description": "This simple steamed fish recipe relies on lemon juice, a flavorful blend of herbs, and simple foil packets to deliver moist and delicious fish every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Cut six squares of aluminum foil large enough for each fillet."
    },
    {
      "position": 2,
      "text": "Center each fillet on a foil square. Season with dill, onion powder, parsley, paprika, seasoned salt, lemon-pepper seasoning, and garlic powder, then sprinkle with lemon juice. Fold the foil squares around the fillets to make pockets. Fold the edges to seal. Place sealed packets onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

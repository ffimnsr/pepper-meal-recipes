  "schema_version": 1,
  "id": "9a28bf52-55ef-594b-abdf-e29b1567a82d",
  "slug": "nicholes-pineapple-upside-down-cake",
  "name": "Nichole's Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This upside-down pineapple cake is topped with rows of halved pineapple rings which create an unexpected geometric pattern.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a 9-inch square baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Melt 1/2 cup butter in a saucepan over medium-high heat. Add 1 cup plus 2 tablespoons brown sugar, stirring until just dissolved. Cook until bubbling, about 2 minutes. Pour into the prepared pan."
    },
    {
      "position": 3,
      "text": "Arrange pineapple in a single layer of diagonal rows over the brown sugar mixture."
    },
    {
      "position": 4,
      "text": "Whisk together both flours, baking powder, cornstarch, and salt in a bowl."
    },
    {
      "position": 5,
      "text": "Beat together white sugar and 1 cup butter in a large bowl with an electric mixer at medium speed until light and fluffy, 3 to 4 minutes. Beat in eggs, one at a time, then stir in vanilla. Beat in 1/2 of the flour mixture, followed by 1/2 of the sour cream; repeat."
    },
    {
      "position": 6,
      "text": "Spread batter over pineapple in the pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 65 to 70 minutes."
    },
    {
      "position": 8,
      "text": "Cool in the pan on a wire rack for 10 minutes, then invert onto a platter."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

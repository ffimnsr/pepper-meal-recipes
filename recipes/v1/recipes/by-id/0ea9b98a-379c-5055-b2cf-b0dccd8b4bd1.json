  "id": "0ea9b98a-379c-5055-b2cf-b0dccd8b4bd1",
  "slug": "easy-crab-cakes",
  "name": "Easy Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "These fresh-tasting, easy crab cakes are perfect for dinner any night of the week--just serve them with a simple, low-carb mustard sauce or 1/2 tablespoon of mayonnaise.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix crabmeat, eggs, mayonnaise, red and green bell peppers, parsley, baking powder, Worcestershire sauce, and seafood seasoning in a large bowl until blended."
    },
    {
      "position": 2,
      "text": "Spray a large skillet with cooking spray and heat over medium-high heat."
    },
    {
      "position": 3,
      "text": "Working in batches, use a tablespoon to carefully spoon poker chip-sized mini \"cakes\" into the skillet; batter will be loose. Cook on one side until firm, about 2 minutes. Flip and cook until lightly browned and heated through, about 1 minute more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

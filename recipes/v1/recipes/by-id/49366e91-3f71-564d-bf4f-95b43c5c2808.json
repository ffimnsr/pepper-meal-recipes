  "id": "49366e91-3f71-564d-bf4f-95b43c5c2808",
  "slug": "fluffy-strawberry-pie",
  "name": "Fluffy Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This strawberry fluffy pie is made with sweet filling, plenty of fresh strawberries, and whipped topping, then loaded into a graham cracker crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix strawberry-flavored gelatin mix, sugar, and boiling water together in a large bowl, stirring until gelatin and sugar have dissolved."
    },
    {
      "position": 2,
      "text": "Refrigerate gelatin mixture until it begins to turn thick and syrupy, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Gently fold frozen whipped topping into gelatin mixture until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Fold the 2 1/2 cups of sliced strawberries into whipped topping mixture."
    },
    {
      "position": 5,
      "text": "Spoon filling into graham cracker crust and decorate edge of filling with 8 strawberry halves."
    },
    {
      "position": 6,
      "text": "Refrigerate at least 2 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

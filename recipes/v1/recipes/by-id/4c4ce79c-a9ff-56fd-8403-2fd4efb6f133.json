  "id": "4c4ce79c-a9ff-56fd-8403-2fd4efb6f133",
  "slug": "steak-and-cheese-egg-rolls",
  "name": "Steak and Cheese Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Deep-fried egg rolls stuffed with shaved steak, American cheese, and bell peppers are a gooey appetizer you can dip in a variety of sauces.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir half of the shaved steak in a large skillet over medium heat until browned, 3 to 5 minutes. Transfer to a plate. Repeat with remaining steak. Drain juices from the steak; cut into small pieces."
    },
    {
      "position": 2,
      "text": "Combine steak, American cheese, green bell pepper, red bell pepper, and yellow bell pepper in a bowl. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Lay 1 egg roll wrapper on a flat surface in the shape of a diamond. Place a large spoonful of the steak mixture in the center. Fold the bottom corner and opposing sides over the steak mixture; roll up wrapper towards the top corner. Repeat with remaining egg roll wrappers and steak mixture."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep-fryer or large saucepan. Place a few egg rolls in the hot oil, seam-side down. Fry, turning occasionally, until golden brown, 2 to 3 minutes. Repeat with remaining rolls."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

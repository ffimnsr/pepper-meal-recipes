  "id": "56d35831-c8bd-5056-98aa-e1475c686f82",
  "slug": "baked-fajitas",
  "name": "Baked Fajitas",
  "recipe_type": "main",
  "brief_description": "Baked fajitas, made with chicken seasoned with chili powder, paprika, and onion powder, are a quick meal to prepare for weeknight dinners.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cornstarch, chili powder, paprika, sugar, salt, onion powder, garlic powder, and cumin together in a bowl."
    },
    {
      "position": 3,
      "text": "Combine chicken, red bell peppers, and onion in a bowl; add cornstarch mixture and stir until evenly coated. Transfer to a baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until chicken is cooked through, about 30 minutes. Serve chicken mixture in corn tortillas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

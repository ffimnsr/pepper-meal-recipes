  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "862dea54-9136-5777-9650-5c93667c4979",
  "slug": "pepper-jelly",
  "name": "Green Bell Pepper Jelly",
  "recipe_type": "appetizer",
  "brief_description": "A 4-ingredient green bell pepper jelly recipe, with peppers, sugar, white vinegar, and pectin, is an easy appetizer served with cream cheese and crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring sugar, green pepper, and white vinegar to a boil in a large, stainless steel saucepan over medium-high heat, stirring constantly, 6 minutes."
    },
    {
      "position": 2,
      "text": "Stir in liquid pectin, then cook, stirring constantly, 3 more minutes. Skim off foam with a metal spoon; remove from heat."
    },
    {
      "position": 3,
      "text": "Pack jelly into hot, sterilized jars, filling to within 1/4 inch of the top. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe the rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 4,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

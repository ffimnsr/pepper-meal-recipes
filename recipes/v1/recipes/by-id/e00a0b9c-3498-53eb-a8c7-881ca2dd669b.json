  "id": "e00a0b9c-3498-53eb-a8c7-881ca2dd669b",
  "slug": "broiled-spanish-mackerel",
  "name": "Broiled Spanish Mackerel",
  "recipe_type": "main",
  "brief_description": "This simple recipe for fish cooked under the broiler uses lemon slices, paprika, salt, and pepper to season fresh Spanish mackerel.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source. Lightly grease a baking dish."
    },
    {
      "position": 2,
      "text": "Rub both sides of each mackerel fillet with olive oil and place with the skin side down into the prepared baking dish. Season each fillet with the paprika, salt, and pepper. Top each fillet with two lemon slices."
    },
    {
      "position": 3,
      "text": "Bake the fillets under the broiler until the fish just begins to flake, 5 to 7 minutes. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

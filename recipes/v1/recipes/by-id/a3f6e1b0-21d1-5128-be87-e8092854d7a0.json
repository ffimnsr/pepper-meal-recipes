  "id": "a3f6e1b0-21d1-5128-be87-e8092854d7a0",
  "slug": "pineapple-coconut-zucchini-bread",
  "name": "Pineapple Coconut Zucchini Bread",
  "recipe_type": "breakfast",
  "brief_description": "This moist zucchini bread with pineapple and coconut recipe is bursting with tropical taste, plus warm spicy notes from cinnamon and pumpkin pie spice.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Combine flour, baking soda, baking powder, salt, cinnamon, and pumpkin pie spice in a large bowl until well blended."
    },
    {
      "position": 3,
      "text": "Whisk oil, white sugar, brown sugar, and eggs together in a separate large bowl until well combined; stir in zucchini, pineapple, sour cream, coconut, and vanilla. Stir in flour mixture until just moistened. Divide batter between the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 50 to 60 minutes. Cool loaves in the pans for 10 minutes, then remove from the pans and finish cooling on a wire rack."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,

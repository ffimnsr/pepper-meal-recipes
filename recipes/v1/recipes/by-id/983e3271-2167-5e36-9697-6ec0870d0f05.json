  "id": "983e3271-2167-5e36-9697-6ec0870d0f05",
  "slug": "easy-rhubarb-crisp",
  "name": "Easy Rhubarb Crisp",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb crisp recipe combines tart rhubarb in a sweet syrup with layers of crunchy buttery oats for a yummy dessert and easy way to use rhubarb.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Mix flour, brown sugar, oats, butter, and cinnamon together in a bowl until crumbly. Press 1/2 of the oat mixture into the bottom of prepared baking dish."
    },
    {
      "position": 4,
      "text": "Sprinkle rhubarb over oat mixture."
    },
    {
      "position": 5,
      "text": "Combine white sugar, water, cornstarch, and vanilla in a saucepan over medium heat; cook and stir until thick and clear, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Pour sugar mixture over rhubarb."
    },
    {
      "position": 7,
      "text": "Sprinkle remaining oat mixture over rhubarb."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until the crisp is lightly brown and bubbling, about 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

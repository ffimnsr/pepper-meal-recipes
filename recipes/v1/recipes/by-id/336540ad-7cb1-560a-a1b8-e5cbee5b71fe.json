  "id": "336540ad-7cb1-560a-a1b8-e5cbee5b71fe",
  "slug": "cheesecake-in-a-jar",
  "name": "Cheesecake in a Jar",
  "recipe_type": "dessert",
  "brief_description": "Make cheesecake in a jar for the perfect portable summer dessert that's incredibly easy to make and a delicious way to use seasonal strawberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cookie crumbs, butter, and 2 tablespoons sugar in a bowl until combined. Divide mixture evenly among jars, about 3 1/2 tablespoons each, and gently press (do not pack) into bottoms."
    },
    {
      "position": 2,
      "text": "Halve 6 strawberries for garnish, and set aside. Chop remaining strawberries."
    },
    {
      "position": 3,
      "text": "Beat cream cheese, 1/2 cup sugar, and lemon juice in bowl with an electric mixer at medium speed until smooth. Fold in whipped cream and chopped berries; divide evenly among jars, about 1/2 cup each. Top each with a 2 berry halves and cover with lids. Chill at least 2 hours and up to 3 days."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

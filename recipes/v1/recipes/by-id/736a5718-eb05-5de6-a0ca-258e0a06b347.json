  "id": "736a5718-eb05-5de6-a0ca-258e0a06b347",
  "slug": "apple-upside-down-cake",
  "name": "Apple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This apple upside-down cake is a delicious twist on a classic! Its mouthwatering aroma will make you eager to dig in! It's ideal for family parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cover the bottom of a 10x15-inch baking pan with brown sugar and 2 tablespoons cinnamon. Layer apple slices on top."
    },
    {
      "position": 3,
      "text": "Place flour, apple juice, sugar, butter, eggs, milk, vanilla, baking powder, salt, and remaining 1 tablespoon cinnamon in the bowl of a stand mixer fitted with the paddle attachment. Mix until completely smooth, 5 to 10 minutes; the longer you mix, the fluffier the cake will be."
    },
    {
      "position": 4,
      "text": "Pour batter over apples making sure they are evenly covered."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 55 minutes. Cool for 20 to 30 minutes. lace a large serving dish over cake and carefully flip over."
    },
    {
      "position": 6,
      "text": "Remove cake from the pan by placing a large serving dish over the pan and carefully flipping it over."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

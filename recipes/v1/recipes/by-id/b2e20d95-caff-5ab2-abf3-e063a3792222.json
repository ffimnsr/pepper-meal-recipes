  "id": "b2e20d95-caff-5ab2-abf3-e063a3792222",
  "slug": "air-fried-double-cherry-mini-egg-rolls",
  "name": "Air-Fried Double Cherry Mini Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These air-fried mini dessert egg rolls are stuffed with a one-two punch of cherry (from jam and dried cherries!) plus yummy cream cheese, and a sweet cinnamon-sugar coating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together cream cheese and jam in a small bowl; stir in dried cherries."
    },
    {
      "position": 3,
      "text": "Place a wonton wrapper on a work surface with a corner pointing toward you. Moisten edges with water. Spoon a rounded teaspoon of cherry mixture just below center of wrapper. Fold bottom corner over filling, tucking it under on the other side. Fold side corners over filling; roll egg roll away from you toward remaining corner. Repeat with remaining wrappers and filling."
    },
    {
      "position": 4,
      "text": "Coat both sides of egg rolls with cooking spray. Arrange egg rolls, in batches if necessary, in a single layer in the air fryer basket."
    },
    {
      "position": 5,
      "text": "Cook in the preheated air fryer until well browned, 4 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, whisk together sugar and cinnamon in a shallow bowl."
    },
    {
      "position": 7,
      "text": "Remove egg rolls from the air fryer and immediately roll in cinnamon sugar, using two forks. Cool on a wire rack for 5 to 10 minutes. Serve warm."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

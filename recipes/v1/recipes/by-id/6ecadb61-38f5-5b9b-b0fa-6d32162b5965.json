  "id": "6ecadb61-38f5-5b9b-b0fa-6d32162b5965",
  "slug": "clam-sauce-with-linguine",
  "name": "Clam Sauce with Linguine",
  "recipe_type": "salad",
  "brief_description": "This is a super fast and easy recipe. One of my favorites. Linguine is tossed with a buttery clam and mushroom sauce. Fettuccine can also be used. Tastes even better with fresh baked rolls or French bread and a garden salad.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Melt butter in large skillet over medium heat. Saute garlic and mushrooms until golden brown. Stir in clams with juice, parsley, salt and white pepper. Cook over medium heat until hot. Toss with pasta until evenly coated. Serve garnished with Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

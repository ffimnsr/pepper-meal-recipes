  "id": "11a436fb-12f8-5c4a-9f3c-a83d487827bf",
  "slug": "perfect-pancakes-recipe-7568285",
  "name": "Perfect Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Serve these pancakes with butter and syrup, or up the ante with toppings such as sprinkles, chopped bittersweet chocolate, and sliced or chopped fruit for a perfect breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a griddle to 300 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together milk and vinegar in a small bowl or a 4-cup liquid measuring cup."
    },
    {
      "position": 3,
      "text": "Whisk together flour, sugar, baking powder, baking soda, and salt in a second bowl."
    },
    {
      "position": 4,
      "text": "Beat eggs in a large bowl until smooth. Add vanilla and milk mixture; whisk together. Add flour mixture to bowl with egg mixture and whisk until just combined. (Batter will be lumpy.) Let rest 3 minutes and gently stir again."
    },
    {
      "position": 5,
      "text": "Melt some butter on the griddle, then carefully wipe with a paper towel. (You want just a bit of a sheen; don\u2019t overgrease the griddle.) Spoon batter in 1/3-cup portions onto griddle. Cook until bubbles form on surface of batter, about 2 1/2 minutes."
    },
    {
      "position": 6,
      "text": "Flip pancakes and cook until browned on the other side, about 1 1/2 minutes more. Repeat with remaining batter. Serve immediately with butter and toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 3,
  "difficulty": "medium",

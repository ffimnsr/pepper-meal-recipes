  "schema_version": 1,
  "id": "2421cd45-9dc3-50eb-9ff5-7cf43e46cdd3",
  "slug": "basic-pizza-dough",
  "name": "Basic Pizza Dough",
  "recipe_type": "main",
  "brief_description": "Yeast, flour, and oils are easily combined in a mixer and left to rise to perfection in this basic pizza dough recipe that will put store-bought pizza crust to shame.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast in warm water about 110 degrees F (43 degrees C) in a bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Whisk together all-purpose flour, bread flour, sugar, and salt in the bowl of a stand mixer. Pour in canola oil, olive oil, and warm yeast mixture. Mix on low speed using the dough hook until dough comes together and pulls away from the bowl. Increase mixing speed to medium-high; let knead for 10 minutes."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured work surface and form into a ball. Place dough ball into a bowl that's been brushed or sprayed with oil; cover with plastic wrap. Let dough rise for 1 hour."
    },
    {
      "position": 4,
      "text": "Place dough onto a lightly floured work surface and punch down. Divide dough in 1/2 and form into 2 balls. Cover with a kitchen towel and let rise for an additional 45 minutes."
    },
    {
      "position": 5,
      "text": "Place each dough ball on a lightly floured work surface and form into a 12-inch round pizza crust."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Top pizzas as desired."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden, 18 to 24 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

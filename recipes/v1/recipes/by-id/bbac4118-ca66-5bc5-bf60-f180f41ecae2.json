  "id": "bbac4118-ca66-5bc5-bf60-f180f41ecae2",
  "slug": "copycat-chilis-southwestern-eggrolls-recipe-8653098",
  "name": "Copycat Chili\u2019s Southwestern Eggrolls",
  "recipe_type": "appetizer",
  "brief_description": "Get ready to enjoy the crispy, savory flavors of your favorite Chili\u2019s appetizer from your very own kitchen. Our Copycat Chili\u2019s Southwestern Eggrolls recipe turns your go-to restaurant order into an easy-to-make app perfect for your next get-together.",
  "cuisine": "Copycat Tex-Mex Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the avocado ranch dip : Mash 1 avocado half with a fork until smooth and creamy in a small bowl. Save remaining avocado half for another use. Whisk in mayonnaise, buttermilk, and ranch seasoning until smooth. Cover and refrigerate avocado ranch dip until ready to use."
    },
    {
      "position": 3,
      "text": "Make the eggrolls : Stir together chicken, cheese, corn, black beans, spinach, red bell pepper, scallions, pickled jalape\u00f1o, taco seasoning, and salt in a medium bowl until well combined."
    },
    {
      "position": 4,
      "text": "Place about 1/2 cup of filling in the center of a tortilla. Fold in two sides of the tortilla over the filling and roll up very tightly. Secure seam with a toothpick. Transfer the eggroll to a large plate. Repeat process with remaining tortillas and chicken mixture."
    },
    {
      "position": 5,
      "text": "Pour oil to a depth of 1/2-inch in a 12-inch cast-iron skillet over medium-high until a thermometer reads 350 degrees F (175 degrees C), about 8 minutes. Add 3 to 4 eggrolls into hot oil, seam side down, and cook, until golden brown and crispy all over, 3 to 4 minutes, flipping halfway through cooking. Transfer to a paper towel lined plate to drain. Repeat with remaining eggrolls."
    },
    {
      "position": 6,
      "text": "Remove toothpicks and slice each eggroll at an angle. Serve with the avocado ranch dip. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8158d7ad-e497-5b56-b7cc-f4419bc9dc14",
  "slug": "simple-roasted-butternut-squash",
  "name": "Simple Roasted Butternut Squash",
  "recipe_type": "dessert",
  "brief_description": "This simple roasted butternut squash recipe with only 4 ingredients makes a delicious side that caramelizes and sweetens as it roasts in the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Peel butternut squash with a vegetable peeler. Halve lengthwise; scoop out and discard seeds."
    },
    {
      "position": 3,
      "text": "Cut halves into 1-inch cubes."
    },
    {
      "position": 4,
      "text": "Combine butternut squash cubes, oil, and garlic in a large bowl; toss to coat. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Arrange in a single layer on a baking sheet."
    },
    {
      "position": 6,
      "text": "Roast in the preheated oven until squash is golden and tender when pierced with a fork, 25 to 35 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

  "id": "5cc86b18-139f-543a-abba-85d04c60bb30",
  "slug": "shrimp-with-broccoli-in-garlic-sauce",
  "name": "Shrimp with Broccoli in Garlic Sauce",
  "recipe_type": "main",
  "brief_description": "Shrimp and broccoli are stir-fried with ginger, garlic, water chestnuts, and a combination of soy and oyster sauces for a simple and delicious Chinese-style dish.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine broccoli and water in a glass bowl; steam in microwave oven until slightly tender, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Heat peanut oil in a large skillet or wok over medium-high heat. Add garlic and cook until fragrant, about 1 minute. Reduce heat to low. Add chicken broth, soy sauce, oyster sauce, and ginger root to the garlic; bring to a boil. Add shrimp; cook and stir until the shrimp turn pink, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Toss steamed broccoli and water chestnuts with shrimp mixture to coat with sauce. Stir cornstarch into mixture, 1 tablespoon at a time, until sauce thickens, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

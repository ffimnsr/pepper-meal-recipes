  "id": "c3f1fcff-09f2-525c-abfb-3feb1151cccd",
  "slug": "oreo-devils",
  "name": "Oreo\u00ae Devils",
  "recipe_type": "dessert",
  "brief_description": "Dress up a package of Oreo\u00ae cookies as little devils for Halloween with some red candy melts and candy eyes, a perfect DIY project with the kids .",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Shape red fondant into 72 little horns relative to the size of the cookies. Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Place red confectioner's coating in the top of a double boiler over simmering water. Stir constantly, scraping down the sides with a rubber spatula to avoid scorching, until melted, about 5 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Use a spoon to cover the top and sides of each cookie with melted red coating. Place on the prepared baking sheet. Stick 2 small devil horns near the top and add 2 candy eyeballs. Let stand until dry, about 1 hour."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

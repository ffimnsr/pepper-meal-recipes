  "id": "c472da3f-db93-5591-9d58-59086b6134de",
  "slug": "seans-falafel-and-cucumber-sauce",
  "name": "Sean\u2019s Falafel and Cucumber Sauce",
  "recipe_type": "main",
  "brief_description": "This falafel sauce recipe is quick to make with cucumber, yogurt, and dill while you form and fry chickpea patties made with onion, egg, and herbs.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Make sauce: Combine yogurt, cucumber, mayonnaise, dill, salt, and pepper in a small bowl; mix well. Chill in the refrigerator for at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Make falafel: Mash chickpeas in a large bowl until thick and pasty; do not use a blender as the consistency will be too thin."
    },
    {
      "position": 3,
      "text": "Place onion, parsley, and garlic in a blender; blend until smooth. Stir into mashed chickpeas until well combined."
    },
    {
      "position": 4,
      "text": "Combine egg, cumin, coriander, salt, lemon juice, baking powder, black pepper, and cayenne in a small bowl. Stir into chickpea mixture along with olive oil. Mix in bread crumbs, a little at a time, until mixture holds together but is not sticky. Form mixture into 8 balls, then flatten into falafel patties."
    },
    {
      "position": 5,
      "text": "Heat 1 inch oil in a large skillet over medium-high heat. Fry falafels in hot oil until brown on both sides. Serve 2 falafels in each pita half, topped with chopped tomatoes and sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

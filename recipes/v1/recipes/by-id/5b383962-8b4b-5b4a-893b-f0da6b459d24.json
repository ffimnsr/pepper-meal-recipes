  "id": "5b383962-8b4b-5b4a-893b-f0da6b459d24",
  "slug": "easy-decadent-truffles",
  "name": "Decadent Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "This chocolate truffles recipe is easy to make with just 4 ingredients for deliciously decadent sweet treats perfect for gifting on any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream cheese in a large bowl until smooth. Gradually beat in confectioners' sugar until well blended."
    },
    {
      "position": 3,
      "text": "Stir in melted chocolate and vanilla until no streaks remain. Refrigerate until just set so about 15 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Shape chilled mixture into 1-inch balls."
    },
    {
      "position": 5,
      "text": "Roll balls into your favorite toppings, if desired. Enjoy!"
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 0,

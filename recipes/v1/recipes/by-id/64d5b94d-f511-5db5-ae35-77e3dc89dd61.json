  "id": "64d5b94d-f511-5db5-ae35-77e3dc89dd61",
  "slug": "red-salmon-pate",
  "name": "Red Salmon Pâté",
  "recipe_type": "appetizer",
  "brief_description": "A creamy salmon pâté flavored with onion, horseradish, lemon juice, and parsley. Delicious spread on crackers or toast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix together salmon, cream cheese, horseradish, lemon juice, and onion. Chill if necessary until firm enough to handle, then form into a ball. Roll in parsley and pecans if desired. Refrigerate until serving. Serve with assorted crackers."
    }
  ],

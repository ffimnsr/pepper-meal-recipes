  "slug": "easy-biscuits",
  "name": "Easy Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "This three-ingredient recipe gets biscuits on your table in a quick and easy manner for when you need biscuits now!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine and mix ingredients together. Pour out on floured waxed paper. Pat the dough out with your hands until dough is not sticky (add a little flour if necessary). Fold double. Cut biscuits with a biscuit cutter."
    },
    {
      "position": 2,
      "text": "Bake on a cookie sheet at 425 degrees F (220 degrees C) for 20-25 minutes."
    }
  ],

  "id": "7daafa82-1511-5f08-a5dc-d24fdd29bea0",
  "slug": "green-no-bean-hummus-recipe-7566683",
  "name": "Green No-Bean Hummus",
  "recipe_type": "appetizer",
  "brief_description": "A delicious green zucchini hummus made by blending roasted zucchini with tahini, garlic, lemon juice, basil, cumin, and cayenne pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim ends from zucchini and cut into quarters. Trim out seeds if zucchini are really big. Cut into 1 \u00bd-inch pieces and add to a bowl. Toss thoroughly with 2 tablespoons kosher salt and let sit for 15 to 20 minutes, tossing halfway through."
    },
    {
      "position": 2,
      "text": "Transfer zucchini to a strainer and rinse off salt very thoroughly. Let drain well before transferring to a bowl."
    },
    {
      "position": 3,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with foil."
    },
    {
      "position": 4,
      "text": "Toss zucchini with 2 tablespoons olive oil, toss, and spread out in a single layer on the prepared baking sheet, making sure zucchini pieces touch each other."
    },
    {
      "position": 5,
      "text": "Broil on high heat until zucchini start to brown and are lightly charred, 5 to 6 minutes. Remove pan and turn zucchini pieces over. Return and broil until zucchini are tender but not mushy, and nicely browned, 5 to 6 minutes longer."
    },
    {
      "position": 6,
      "text": "Transfer zucchini to a strainer and let drain until cooled to room temperature, about 45 minutes."
    },
    {
      "position": 7,
      "text": "Combine drained zucchini, remaining 2 tablespoons olive oil, tahini, garlic, lemon juice, basil, \u00bd teaspoon salt, cumin, black pepper, and cayenne in a blender. Blend until smooth, and taste for seasoning. You can also use an immersion blender."
    },
    {
      "position": 8,
      "text": "For best flavor, cover and chill the hummus before serving."
    }
  ],
  "servings": 16,

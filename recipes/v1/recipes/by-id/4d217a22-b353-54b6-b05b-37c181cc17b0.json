{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4d217a22-b353-54b6-b05b-37c181cc17b0",
  "slug": "grilled-chicken-nachos-with-lime-crema",
  "name": "Grilled Chicken Nachos with Lime Crema",
  "recipe_type": "appetizer",
  "brief_description": "Marinated and grilled chicken breast, cheeses, and a lime crema top tortilla chips in this easy nacho recipe that's perfect for a party.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk tequila, oil, lime juice, cilantro, cumin, garlic powder, salt, and cayenne for marinade together in a bowl. Place chicken slices into a plastic bag, add marinade, and refrigerate for 30 minutes."
    },
    {
      "position": 2,
      "text": "Mix sour cream, mayonnaise, lime zest and juice, and enough heavy cream to make crema thin enough together in a bowl and refrigerate."
    },
    {
      "position": 3,
      "text": "Remove chicken from the refrigerator and let come to room temperature for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Cook chicken on the preheated grill until caramelized and no longer pink in the center, about 5 minutes on each side."
    },
    {
      "position": 6,
      "text": "Lay tortilla chips out in a single layer over two cookie sheets. Mix pepper Jack and Mexican cheese together and sprinkle half of the mixture over the chips. Cut the grilled chicken into bite-sized pieces and distribute evenly over cheese. Top chicken with remaining cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted, 10 to 15 minutes. Drizzle lime crema over nachos and sprinkle with cilantro."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

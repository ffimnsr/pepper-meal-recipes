  "slug": "refreshing-cucumber-salsa",
  "name": "Refreshing Cucumber Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Top fish tacos or chips with a refreshing salsa made from cucumbers, spinach, tomatoes, and lemon juice.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix spinach, cucumber, tomato, red onion, garlic, lemon juice, olive oil, salt, and black pepper in a large bowl. Cover with plastic wrap and refrigerate, 1 hour to overnight."
    }
  ],

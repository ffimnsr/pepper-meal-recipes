  "schema_version": 1,
  "id": "634fa0a5-14a5-5509-8c05-5f4854cd6e80",
  "slug": "chef-johns-ham-and-potato-soup",
  "name": "Chef John's Ham and Potato Soup",
  "recipe_type": "soup",
  "brief_description": "You can never have too many soup recipes. This hearty soup is definitely filling enough to serve as a main course.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a stockpot over medium heat until golden brown. Stir in carrot, celery, onion, ham, and garlic; cook and stir for 5-6 minutes, until the vegetables soften and the onions are translucent."
    },
    {
      "position": 2,
      "text": "Stir in flour; cook for about 3 minutes. Stir in chicken broth, 1 cup at a time. Add water and stir to combine. Turn the heat to high and bring to a simmer. Simmer on medium-low for 15 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Taste the soup for salt and add more if necessary. Stir in potatoes; cook for 15 minutes, until potatoes are tender. Skim fat if desired."
    },
    {
      "position": 4,
      "text": "With a potato masher, mash the soup a few times, leaving plenty of whole chunks of potato. Season with salt and pepper to taste, add cayenne if desired, and add cream. Stir to combine and heat through. Garnish with fresh chives."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

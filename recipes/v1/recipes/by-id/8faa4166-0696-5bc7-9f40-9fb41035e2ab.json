  "id": "8faa4166-0696-5bc7-9f40-9fb41035e2ab",
  "slug": "mini-chocolate-chip-cookies-recipe-11857110",
  "name": "Mini Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These mini chocolate chip cookies are really cute and so delicious. They are crunchy on the bottoms, and chewy inside, just like a great full-size cookie, but bite-sized.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Arrange racks in the upper and lower thirds of the oven. Line 4 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking soda, and salt in a small bowl."
    },
    {
      "position": 3,
      "text": "Beat butter with an electric mixer in a bowl until creamy, about 30 seconds. Add brown sugar and white sugar; beat until light and fluffy, 1 to 2 minutes. Beat in egg, egg yolk, and vanilla until combined. Gradually beat in flour mixture until just incorporated."
    },
    {
      "position": 4,
      "text": "Stir in chocolate chips."
    },
    {
      "position": 5,
      "text": "Divide dough in fourths, wrap each portion in plastic wrap and chill dough for at least 1 1/2 hours and up to 24 hours."
    },
    {
      "position": 6,
      "text": "Roll 1 portion of dough at a time into a rope about 1/2 inch in diameter on a lightly floured surface. Cut crosswise into about 1/2-inch pieces. A bench scraper is helpful for this. Arrange pieces on a prepared baking sheet, spacing slightly apart. Repeat with remaining dough."
    },
    {
      "position": 7,
      "text": "Bake 2 sheets at a time until cookies are golden brown, about 8 to 9 minutes, rotating pans halfway through. Let cookies cool completely on the sheets before serving."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e97bff03-f7b4-5e3b-bf58-c0edfabb5579",
  "slug": "cheddar-zucchini-bread-recipe-11761963",
  "name": "Cheddar Zucchini Bread",
  "recipe_type": "side",
  "brief_description": "This Cheddar zucchini bread is a great way to use extra zucchini in the summer months. It tastes a bit like a cheesy biscuit with a crisp crust and a moist interior.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Coat 9x5-inch loaf pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Coarsely shred zucchini. Wrap shredded zucchini in a clean kitchen towel or cheesecloth. Squeeze well and discard excess liquid. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk together flour, baking powder and salt in a large bowl."
    },
    {
      "position": 4,
      "text": "Whisk together buttermilk and egg in a bowl. Stir in melted butter."
    },
    {
      "position": 5,
      "text": "Stir buttermilk mixture into dry ingredients, being careful not to overmix."
    },
    {
      "position": 6,
      "text": "Fold in shredded zucchini, cheese, green onions and chives until combined (batter will be thick)."
    },
    {
      "position": 7,
      "text": "Spread batter evenly into the prepared pan."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, 55 to 60 minutes. Allow bread to cool in the pan for 15 minutes."
    },
    {
      "position": 9,
      "text": "Remove from pan and cool completely on a wire rack. Recipe developed by Barrett Heald."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

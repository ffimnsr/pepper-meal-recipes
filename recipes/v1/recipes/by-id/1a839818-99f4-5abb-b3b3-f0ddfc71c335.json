  "slug": "slow-cooker-cider-applesauce-no-sugar-added",
  "name": "Slow Cooker Cider Applesauce (No Sugar Added)",
  "recipe_type": "dessert",
  "brief_description": "This slow cooker cider applesauce recipe has no sugar added because the apples, spiced with cinnamon, nutmeg, and cloves are sweet enough on their own.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Layer apples in a slow cooker; sprinkle cinnamon, cloves, and nutmeg evenly over top. Cover the slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on High until apples are soft, 4 to 5 hours. Vigorously whisk apples for a chunkier-style applesauce. Pur\u00e9e with an immersion blender for a smoother applesauce."
    }
  ],

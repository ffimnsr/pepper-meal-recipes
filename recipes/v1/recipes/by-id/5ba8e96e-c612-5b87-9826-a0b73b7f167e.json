  "id": "5ba8e96e-c612-5b87-9826-a0b73b7f167e",
  "slug": "banana-pineapple-bread",
  "name": "Banana Pineapple Bread",
  "recipe_type": "dessert",
  "brief_description": "This banana pineapple bread uses easy baking ingredients, canned pineapple, and applesauce to make a very moist cake with tropical flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, bananas, oil, applesauce, pineapple, eggs, cinnamon, baking soda, and salt together in a large bowl until blended. Pour into the prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 50 to 60 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

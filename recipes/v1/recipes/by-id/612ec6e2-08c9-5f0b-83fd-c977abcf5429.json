  "id": "612ec6e2-08c9-5f0b-83fd-c977abcf5429",
  "slug": "pecan-pie-vii",
  "name": "Custard Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This custard pecan pie is a simple yet delicious old-fashioned dessert that's made without the corn syrup that most pecan pie recipes call for nowadays.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, combine brown sugar, flour, margarine, milk, vanilla and eggs. Blend until smooth. Stir in chopped pecans. Pour into pie crust. Place whole pecan meats gently on top in decorative manner."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until golden brown and filling is set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

  "id": "f1eb0e35-1478-5b67-871c-d96fba4d61fe",
  "slug": "shamrock-lucky-charms-treats",
  "name": "Shamrock Lucky Charms Treats",
  "recipe_type": "appetizer",
  "brief_description": "Try these shamrock shaped Lucky Charms treats if you're looking for a fun snack for St. Patrick's Day.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x13-inch pan with parchment paper and coat with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over low heat. Add marshmallows and stir until completely melted. Remove from heat and mix in a few drops of green food coloring (to your desired color)."
    },
    {
      "position": 3,
      "text": "Place the cereal in a large bowl. Add marshmallow mixture and stir until the cereal is well coated."
    },
    {
      "position": 4,
      "text": "Evenly and gently press the cereal mixture into the prepared pan with a greased spatula. Set aside to cool."
    },
    {
      "position": 5,
      "text": "Once cooled, remove the treats (with the parchment paper) from the pan and place on top of a cutting board. Cut the cereal treats into shamrock shapes using a shamrock cookie cutter."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

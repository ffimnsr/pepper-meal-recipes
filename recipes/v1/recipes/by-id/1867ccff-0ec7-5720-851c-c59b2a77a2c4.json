{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1867ccff-0ec7-5720-851c-c59b2a77a2c4",
  "slug": "traditional-gyros",
  "name": "Traditional Gyros",
  "recipe_type": "main",
  "brief_description": "Make a Greek gyro sandwich at home by layering delicious homemade gyro meat, hummus, tzatziki sauce, tomatoes, and feta cheese on a large pita bread.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place onion in a food processor and finely chop. Transfer onion to a piece of cheesecloth and squeeze out the liquid. Place onion in a large bowl."
    },
    {
      "position": 2,
      "text": "Mix lamb, beef, garlic, oregano, cumin, marjoram, thyme, rosemary, black pepper, and salt with the onion using your hands until well mixed. Cover bowl with plastic wrap and refrigerate until flavors blend, about 2 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "Place meat mixture in a food processor and pulse until finely chopped and tacky, about 1 minute. Pack meat mixture into a 7x4-inch loaf pan, ensuring there are no air pockets. Place the loaf pan into a roasting pan and pour enough boiling water around the loaf pan to reach halfway up the sides for a water bath."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until no longer pink in the center, 45 to 60 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Pour off any accumulated fat and cool slightly."
    },
    {
      "position": 6,
      "text": "Thinly slice the cooked gyro meat loaf."
    },
    {
      "position": 7,
      "text": "Spread 1 tablespoon hummus onto each pita bread. Then top each with some of the gyro meat slices, shredded lettuce, tomato slices, red onion slices, feta cheese crumbles, and 2 tablespoons tzatziki sauce to complete each sandwich."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

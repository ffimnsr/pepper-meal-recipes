  "id": "e9a93337-f88c-5ae3-b179-1f86365a4dac",
  "slug": "hash-brown-potato-soup",
  "name": "Creamy Hash Brown Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This hash brown soup recipe is made with frozen potatoes to speed up the preparation of this rich and creamy soup topped with crispy bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels, reserving drippings in the skillet. Chop bacon into small pieces; set aside."
    },
    {
      "position": 2,
      "text": "Combine hash brown potatoes, O'Brien hash brown potatoes, prepared bouillon, celery seed, and black pepper in a large pot over medium heat; bring to a boil. Reduce heat and simmer, covered, until potatoes are tender, 20 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Pur\u00e9e potatoes in the pot with an immersion blender until smooth. Stir in condensed soup, milk, and reserved drippings. Simmer until heated through, about 10 minutes. Sprinkle bacon on top."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

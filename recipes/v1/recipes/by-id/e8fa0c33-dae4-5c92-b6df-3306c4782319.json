  "id": "e8fa0c33-dae4-5c92-b6df-3306c4782319",
  "slug": "slow-cooker-au-jus-pot-roast",
  "name": "Slow Cooker Au Jus Pot Roast",
  "recipe_type": "main",
  "brief_description": "My slow cooker au jus pot roast recipe uses chuck roast, Worcestershire sauce, steak seasoning, beef bouillon, and coffee, yielding very tender meat.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Rub chuck roast with 1 tablespoon Worcestershire sauce; sprinkle Montreal-style steak seasoning all over roast."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add roast; sear until browned, about 5 minutes per side. Transfer roast to a slow cooker."
    },
    {
      "position": 3,
      "text": "Dissolve bouillon cube in coffee; pour over roast. Pour tomato sauce over roast; season with oregano, and drizzle with remaining 2 teaspoons Worcestershire sauce. Cover slow cooker."
    },
    {
      "position": 4,
      "text": "Cook on Low until roast is tender, 8 to 10 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 500,
  "preparation_time_minutes": 15,

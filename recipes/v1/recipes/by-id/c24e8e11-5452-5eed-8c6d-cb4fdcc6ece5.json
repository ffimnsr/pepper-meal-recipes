  "id": "c24e8e11-5452-5eed-8c6d-cb4fdcc6ece5",
  "slug": "cheese-stuffed-pork-tenderloin",
  "name": "Cheese-Stuffed Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "Pork tenderloin is rolled around a Cheddar and cream cheese filling and baked for a flavorful main dish sure to be a crowd-pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine Cheddar cheese, green onions, bacon, cream cheese, spinach, mushrooms, garlic, parsley, salt, and black pepper in a bowl. Spread onto one side pounded tenderloin; roll tenderloin, jelly roll style, around filling. Coat rolled tenderloin with bread crumbs; place on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pork no longer pink in center, about 1 1/2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

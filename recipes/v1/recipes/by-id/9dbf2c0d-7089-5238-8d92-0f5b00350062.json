  "id": "9dbf2c0d-7089-5238-8d92-0f5b00350062",
  "slug": "biscuits-and-gravy-skillet-pot-pie-recipe-11850882",
  "name": "Biscuits and Gravy Skillet Pot Pie",
  "recipe_type": "breakfast",
  "brief_description": "This biscuits and gravy skillet pot pie is an easy, family-pleasing, budget-friendly breakfast, lunch, or dinner that is pure comfort, even down to the minimal clean-up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Set an ovenproof skillet and over medium-high heat, add sausage and cook, crumbling with a wooden spoon, until browned, about 5 minutes. Add white parts of the onions and cook 1 minute."
    },
    {
      "position": 2,
      "text": "Sprinkle flour evenly over sausage and cook, stirring constantly for 2 minutes. Add milk and cook, stirring constantly until well blended."
    },
    {
      "position": 3,
      "text": "Bring mixture to a simmer and cook until thickened, about 5 minutes. Stir in remaining green onions and hot sauce and turn off heat."
    },
    {
      "position": 4,
      "text": "Separate 6 biscuits, or as many as needed, into 2 or 3 layers and shingle biscuit dough over sausage mixture. Reserve any unused biscuits for another use. Brush a thin layer of egg evenly over biscuits and sprinkle evenly with everything seasoning."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until biscuits are golden brown and cooked through, 18 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

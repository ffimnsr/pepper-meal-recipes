  "schema_version": 1,
  "id": "4fd988ea-9d56-506d-a3f6-e7ef9d2136d9",
  "slug": "quick-and-easy-air-fryer-nachos",
  "name": "Quick and Easy Air Fryer Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer nachos with savory beef, black beans, cheese, and salsa are easy to make for a finger-licking good appetizer that's ready in minutes!",
  "cuisine": "Mexican Inspired Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer at 360 degrees F (182 degrees C) for about 5 minutes. Line the air fryer basket with foil or a parchment liner, and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a small skillet over medium heat and cook ground beef until browned and crumbly, about 3 minutes; drain grease. Stir in water, taco seasoning, cayenne, salt, and pepper. Remove skillet from heat."
    },
    {
      "position": 3,
      "text": "Set tortilla chips in the basket, spreading them out and overlapping slightly so the melted cheese won't drip through the open gaps. Evenly sprinkle Cheddar cheese over the chips. Only add a couple of layers of chips with cheese in between in the fryer basket, or just add a single layer and cook in batches."
    },
    {
      "position": 4,
      "text": "Evenly distribute ground beef and black beans over the cheese, sprinkle green onions on top, and add spoonfuls of salsa."
    },
    {
      "position": 5,
      "text": "Transfer the basket into the air fryer and cook until cheese is melted and starting to slightly brown on the edges, 4 to 6 minutes. The nachos will cook evenly and quickly but watch closely so they don't burn."
    },
    {
      "position": 6,
      "text": "Remove nachos to a serving plate, garnish with sour cream, and serve immediately. Put extra toppings in small bowls and let everybody customize their nachos."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

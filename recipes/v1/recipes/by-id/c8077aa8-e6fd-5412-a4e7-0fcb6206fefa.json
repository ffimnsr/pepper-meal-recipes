  "id": "c8077aa8-e6fd-5412-a4e7-0fcb6206fefa",
  "slug": "mediterranean-dip",
  "name": "Mediterranean Dip",
  "recipe_type": "appetizer",
  "brief_description": "Garlicky, lemony cream cheese acts as the base of this Mediterranean dip with hummus in the middle and feta, tomatoes, cucumbers, and olives on top.",
  "cuisine": "Mediterranean Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese, garlic, lemon juice, and Italian seasoning together. Spread mixture onto the bottom of a round 10-inch dish. Spread hummus on top."
    },
    {
      "position": 2,
      "text": "Mix tomatoes, cucumbers, olives, and red onion together in a bowl; spread over the hummus. Sprinkle feta cheese on top. Refrigerate for at least 1 hour."
    }
  ],

  "id": "841fc666-e7ce-589e-8bee-959d3fdd4eca",
  "slug": "five-cheese-ziti-al-forno-recipe-7972409",
  "name": "Five Cheese Ziti al Forno",
  "recipe_type": "main",
  "brief_description": "This five cheese ziti al forno is a delicious pasta bake made with marinara and Alfredo sauce and Italian cheeses, topped with panko crumbs and Parmesan.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cook the pasta 1 minute less than directed on the package. Drain pasta and transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Set aside 1/2 cup of the Italian five cheese blend shredded cheese."
    },
    {
      "position": 4,
      "text": "Add marinara sauce, Alfredo sauce, remaining Italian blend cheeses, and ricotta cheese to the pasta; toss to combine."
    },
    {
      "position": 5,
      "text": "Transfer pasta mixture to the prepared dish. Top with reserved 1/2 cup cheese."
    },
    {
      "position": 6,
      "text": "For the topping, in a small bowl, combine panko, Parmesan, melted butter, and garlic. Sprinkle over the pasta mixture in the baking dish."
    },
    {
      "position": 7,
      "text": "Bake until golden brown and bubbly, 30 minutes. Let stand 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

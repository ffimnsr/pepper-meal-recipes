  "id": "ac57ece8-cd73-57a5-8056-006975df5702",
  "slug": "graham-cracker-crunch-topping",
  "name": "Graham Cracker Crunch Topping",
  "recipe_type": "dessert",
  "brief_description": "A warm graham cracker crunch to top your ice cream with! Really tasty, really easy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a small baking pan."
    },
    {
      "position": 2,
      "text": "In a small bowl, mix together crumbled graham crackers, brown sugar and cinnamon. Combine melted butter and vanilla, then stir in. Spread evenly in prepared pan. Sprinkle white sugar and salt over the top."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 15 minutes, or until lightly browned."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "bab42066-e1d7-55b2-8fa3-e84bb2173c3c",
  "slug": "easy-chicken-fajita-marinade",
  "name": "Easy Chicken Fajita Marinade",
  "recipe_type": "side",
  "brief_description": "This chicken fajita marinade is made with oil, chili powder, paprika, lime, and honey for tender and succulent grilled chicken to use in fajitas.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Whisk vegetable oil, chili powder, lime juice, honey, garlic powder, paprika, and black pepper together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Place chicken strips in a large resealable plastic bag. Pour in marinade and knead to coat; squeeze out excess air, seal bag, and marinate in the refrigerator for 4 hours to overnight."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove chicken strips from marinade; discard any unused marinade."
    },
    {
      "position": 5,
      "text": "Cook chicken on the preheated grill until browned on all sides and chicken is no longer pink in the center, about 10 minutes per side. An instant-read meat thermometer inserted into the thickest piece should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

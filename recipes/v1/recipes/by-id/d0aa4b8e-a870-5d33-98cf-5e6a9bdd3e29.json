  "id": "d0aa4b8e-a870-5d33-98cf-5e6a9bdd3e29",
  "slug": "my-grandmas-guacamole",
  "name": "My Grandma's Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "An authentic guacamole recipe passed down through generations includes chile de arbol peppers, tomatoes, cilantro, and a squeeze of lime juice.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Arrange chile peppers on a baking sheet."
    },
    {
      "position": 2,
      "text": "Toast chile peppers in the preheated until browned, about 7 minutes. Remove stems."
    },
    {
      "position": 3,
      "text": "Mix avocados, onion, and roma tomatoes together in a bowl."
    },
    {
      "position": 4,
      "text": "Blend canned tomatoes, cilantro, toasted chile peppers, garlic powder, and salt in a blender until smooth. Pour about half the blended tomato mixture into avocado mixture. Reserve remaining tomato mixture for another use or for dipping."
    },
    {
      "position": 5,
      "text": "Squeeze lime juice into avocado mixture and gently stir until evenly combined. Transfer guacamole to a smaller serving bowl; place reserved avocado pit in the middle to prevent browning."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

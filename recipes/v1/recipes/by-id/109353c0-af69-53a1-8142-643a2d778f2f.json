  "id": "109353c0-af69-53a1-8142-643a2d778f2f",
  "slug": "aunt-jewels-chicken-dressing-casserole",
  "name": "Aunt Jewel's Chicken Dressing Casserole",
  "recipe_type": "soup",
  "brief_description": "A family Southern chicken and dressing casserole recipe. Chicken breast gets topped with creamy soups, broth, and stuffing mixture, then baked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken in a large saucepan full of lightly salted water."
    },
    {
      "position": 3,
      "text": "Bring to a boil. Boil until chicken is cooked through (juices run clear), about 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove chicken from pan, reserving broth."
    },
    {
      "position": 5,
      "text": "Cut chicken into bite-sized pieces and place in the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Mix together condensed soups in a medium bowl."
    },
    {
      "position": 7,
      "text": "Fill one empty soup can with milk and mix milk with soups."
    },
    {
      "position": 8,
      "text": "Pour mixture over chicken."
    },
    {
      "position": 9,
      "text": "Combine stuffing and broth in a small bowl; mix together and spoon the mixture over the casserole."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven for 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

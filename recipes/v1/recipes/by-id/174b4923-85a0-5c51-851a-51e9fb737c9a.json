  "id": "174b4923-85a0-5c51-851a-51e9fb737c9a",
  "slug": "fresh-raspberry-mojito",
  "name": "Fresh Raspberry Mojito",
  "recipe_type": "drink",
  "brief_description": "This raspberry mojito combines silver rum and raspberry vodka with fresh berries, lime juice, and mint leaves to make a refreshing happy hour drink!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Muddle mint leaves, raspberries, simple syrup, and lime juice together in a shaker. Fill the shaker with ice and add vodka and rum; cover and shake until chilled. Pour entire contents of shaker into a Collins glass and top with club soda."
    }
  ],
  "servings": 1,

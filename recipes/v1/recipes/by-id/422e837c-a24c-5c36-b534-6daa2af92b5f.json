  "id": "422e837c-a24c-5c36-b534-6daa2af92b5f",
  "slug": "sweet-potato-brownies-recipe-8363632",
  "name": "Sweet Potato Brownies",
  "recipe_type": "dessert",
  "brief_description": "These sweet potato brownies are light and moist, loaded with chocolate chips, and topped with more chips and pecans. You really won't taste the sweet potato, but it's what gives them their fudgy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Whisk together flour, cocoa powder, baking soda, and salt in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Combine sweet potato puree, brown sugar, butter, egg, and vanilla in a large bowl. Beat with an electric mixer on low speed until smooth."
    },
    {
      "position": 4,
      "text": "Add flour mixture and mix until just moistened. Fold in 1 cup of the chocolate chips."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan. Sprinkle with remaining 1/2 cup chocolate chips and pecans, if desired."
    },
    {
      "position": 6,
      "text": "Bake until edges and surface of brownies are set but still soft, about 25 minutes. Cool in pan for at least 30 minutes. For best results, chill at least 4 hours before cutting."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

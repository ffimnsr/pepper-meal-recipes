  "id": "b13bba0d-4c5a-5758-b47a-6df42b11e9c4",
  "slug": "creamy-sausage-and-mushroom-gnocchi-skillet",
  "name": "Creamy Sausage and Mushroom Gnocchi Skillet",
  "recipe_type": "main",
  "brief_description": "This creamy sausage gnocchi is a comforting, indulgent one-skillet dish that combines potato gnocchi with white wine, cream, shallots, and turkey sausage.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a heavy skillet over medium-high heat. Cook and stir sausage in the hot skillet until crumbly and no longer pink, about 7 minutes. Add mushrooms, shallots, butter, and oil; cook, stirring occasionally, until mushrooms and shallots are soft and beginning to brown, about 5 minutes. Add garlic and cook for 1 to 2 minutes. Pour in white wine and simmer until wine has reduced by half, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook gnocchi in boiling water until pasta floats to the top, 2 to 4 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Add gnocchi, cream, Italian herbs, pepper flakes, salt, and pepper. Cook over medium-low heat until sauce has thickened, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

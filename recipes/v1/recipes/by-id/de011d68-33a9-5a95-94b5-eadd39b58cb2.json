  "id": "de011d68-33a9-5a95-94b5-eadd39b58cb2",
  "slug": "easy-chicken-curry-egg-rolls",
  "name": "Easy Chicken Curry Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These crispy baked egg rolls filled with chicken, vegetables, and curry powder make for a unique, flavorful appetizer.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon olive oil and 1 tablespoon soy sauce in a large saucepan over medium heat. Add chicken and cook until no longer pink, 3 to 5 minutes. Add cabbage, onion, and carrot; cook, stirring occasionally, until softened."
    },
    {
      "position": 2,
      "text": "Mix remaining soy sauce, mayonnaise, curry powder, curry paste, garlic, and chile powder together in a bowl. Fold into the chicken mixture."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly brush a rimmed baking sheet with some olive oil."
    },
    {
      "position": 4,
      "text": "Place about 1/4 cup of the chicken mixture diagonally across an egg roll wrapper. Fold the bottom half over the chicken mixture; fold in sides and roll up like a burrito. Repeat until all the chicken mixture and wraps have been used."
    },
    {
      "position": 5,
      "text": "Place egg rolls seam-side down on the prepared baking sheet. Brush tops and sides of the rolls with remaining olive oil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

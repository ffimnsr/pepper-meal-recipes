  "id": "ed0e8478-6922-591e-a843-4adaeadf06ba",
  "slug": "juicy-thanksgiving-turkey",
  "name": "Juicy Thanksgiving Turkey",
  "recipe_type": "soup",
  "brief_description": "This juicy Thanksgiving turkey recipe yields a foolproof roasted turkey with herbs and a champagne broth, making it a succulent holiday centerpiece.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a roasting pan with enough aluminum foil to wrap around turkey."
    },
    {
      "position": 2,
      "text": "Stir parsley, rosemary, sage, thyme, lemon-pepper seasoning, and salt together in a small bowl."
    },
    {
      "position": 3,
      "text": "Rub herb mixture into turkey cavity; stuff with orange wedges, onion, carrot, and celery. Tie turkey legs together with kitchen twine; tuck wings behind body."
    },
    {
      "position": 4,
      "text": "Place turkey on the foil in the roasting pan. Pour champagne and chicken broth over turkey, getting some in cavity."
    },
    {
      "position": 5,
      "text": "Bring the aluminum foil up and around turkey; try to keep the foil from touching turkey."
    },
    {
      "position": 6,
      "text": "Roast turkey in the preheated oven until juices run clear, 2 \u00bd to 3 hours. Uncover turkey; continue cooking until skin turns golden brown, 30 to 60 minutes more. An instant-read thermometer inserted into the thickest part of thigh near the bone, should read 180 degrees F (80 degrees C)."
    },
    {
      "position": 7,
      "text": "Remove turkey from the oven, cover with two sheets of aluminum foil; let rest in a warm area, 10 to 15 minutes before carving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

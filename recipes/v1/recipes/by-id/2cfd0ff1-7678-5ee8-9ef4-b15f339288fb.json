  "schema_version": 1,
  "id": "2cfd0ff1-7678-5ee8-9ef4-b15f339288fb",
  "slug": "jelly-doughnut-focaccia-recipe-12004120",
  "name": "Jelly Doughnut Focaccia",
  "recipe_type": "dessert",
  "brief_description": "This jelly doughnut focaccia transforms simple no-knead bread dough into a bakery-worthy treat. Filled with your favorite jam or jelly and finished with a sweet glaze, it has all the flavors of a classic jelly doughnut in an easy homemade loaf.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine warm water, instant yeast, flour, and salt in a large bowl. Stir together until a shaggy, wet dough forms. Cover and let rise for 30 minutes."
    },
    {
      "position": 2,
      "text": "Dip your fingertips in water (this helps keep the dough from sticking to you!) and grab one \u201cedge\u201d of the dough in the bowl. Lift it up and fold it over the rest of the dough. Rotate 90 degrees and repeat this 3 times, until you have done 4 stretch-and-folds."
    },
    {
      "position": 3,
      "text": "Cover dough and let sit for 30 minutes, then do another set of 4 stretch-and-folds. Cover dough and let sit for another 30 minutes."
    },
    {
      "position": 4,
      "text": "Add 1 tablespoon of olive oil to a 9x13-inch baking pan and spread to coat the pan."
    },
    {
      "position": 5,
      "text": "Dump focaccia dough into the pan and push to the edges of the pan with oiled fingers. If dough resists or shrinks, let it rest 10 minutes and push to the edges again. Cover the pan with a kitchen towel or plastic wrap and let the dough rise in a warm place for 1 hour, until very jiggly and puffy."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Drizzle remaining olive oil on top of the dough and push in with your fingertips to create small dimples."
    },
    {
      "position": 7,
      "text": "Bake the focaccia for 20 to 24 minutes, until golden brown. Remove from oven and let cool completely."
    },
    {
      "position": 8,
      "text": "Meanwhile, for glaze: whisk confectioner's sugar and milk together until smooth. Set aside."
    },
    {
      "position": 9,
      "text": "When focaccia is cooled, use a wooden spoon to poke large holes in a 3x4 pattern about halfway through the dough."
    },
    {
      "position": 10,
      "text": "Add jam to a ziploc bag and snip the corner. Squeeze the jam into the 12 holes to fill. Drizzle the glaze over the top of the bread and spread evenly. Let sit for 10 minutes, then slice and serve. Enjoy!"
    }
  ],
  "servings": 12,

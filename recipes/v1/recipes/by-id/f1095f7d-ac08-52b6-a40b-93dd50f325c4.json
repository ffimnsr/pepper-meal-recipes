  "id": "f1095f7d-ac08-52b6-a40b-93dd50f325c4",
  "slug": "irish-cream-truffles",
  "name": "Irish Cream Truffles",
  "recipe_type": "dessert",
  "brief_description": "These Irish cream-infused chocolate truffles are perfect for special occasions. Roll them in melted chocolate, finely chopped nuts, or cocoa powder for a finishing touch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk heavy cream and sugar together in a small saucepan over medium heat. Heat until the edges of the cream show fine bubbles but mixture does not boil, allowing sugar to dissolve. Remove from heat."
    },
    {
      "position": 2,
      "text": "Whisk butter, chocolate chips, and Irish cream into cream mixture until butter and chocolate chips are melted. Cool to room temperature."
    },
    {
      "position": 3,
      "text": "Scoop up the chocolate mixture about 1 tablespoon at a time and roll into a 1-inch ball; set truffles on a plate."
    },
    {
      "position": 4,
      "text": "Refrigerate until firm, about 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "070e8fb3-1406-50ec-bbba-8ae6858490aa",
  "slug": "black-beans-and-rice",
  "name": "Black Beans and Rice",
  "recipe_type": "side",
  "brief_description": "Black beans and rice flavored with garlic, cumin, and cayenne pepper makes a wholesome, budget-friendly, vegetarian meal or tasty side dish.",
  "cuisine": "Latin Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over medium-high heat. Add onion; cook and stir until onion has softened, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add rice, garlic, salt, cumin, and cayenne. Cook and stir for 2 to 3 minutes to lightly toast the rice and warm the spices until fragrant."
    },
    {
      "position": 4,
      "text": "Add vegetable broth and bring to a boil. Reduce heat to low, cover, and simmer until liquid is absorbed and rice is tender, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Stir in black beans and cook until warmed through, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

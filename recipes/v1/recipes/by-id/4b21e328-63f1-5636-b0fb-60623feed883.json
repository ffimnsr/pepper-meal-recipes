  "id": "4b21e328-63f1-5636-b0fb-60623feed883",
  "slug": "tom-and-jerry",
  "name": "Tom and Jerry",
  "recipe_type": "drink",
  "brief_description": "Almost like eggnog, but warm and creamy. We have an annual Christmas Tom & Jerry Party and this is the recipe we've perfected.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Separate the eggs. In a large bowl beat the egg whites until frothy. Whisk in 3/4 cup of the confectioners' sugar and beat until stiff peaks are formed."
    },
    {
      "position": 2,
      "text": "Beat the egg yolks with the remaining 1/2 cup of confectioners' sugar and about 4 to 5 tablespoons of the brandy until light and lemon colored. Fold the egg whites into the egg yolks and refrigerate."
    },
    {
      "position": 3,
      "text": "In a large stock pot heat the milk until hot but do not boil. Reduce heat and keep milk hot."
    },
    {
      "position": 4,
      "text": "To each mug add 2 tablespoons brandy (or more to taste) and 1 large heaping tablespoon of egg mixture. Stir and fill mug with hot milk. Place another tablespoon of egg mixture on top and sprinkle with nutmeg."
    }
  ],
  "servings": 24,

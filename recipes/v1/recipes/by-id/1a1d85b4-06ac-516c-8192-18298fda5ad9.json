  "id": "1a1d85b4-06ac-516c-8192-18298fda5ad9",
  "slug": "super-easy-oven-baked-garlic-parmesan-fries",
  "name": "Super Easy Oven-Baked Garlic-Parmesan Fries",
  "recipe_type": "side",
  "brief_description": "You will never want to buy fries anywhere else after you see how easy and delicious they come out baked at home!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Pour olive oil into a large resealable plastic bag and add potatoes. Seal the bag and shake to coat every piece with oil."
    },
    {
      "position": 3,
      "text": "Combine Parmesan cheese, garlic powder, onion powder, paprika, salt, and pepper in a second resealable bag. Pour oiled potatoes into the bag, seal, and toss well to coat."
    },
    {
      "position": 4,
      "text": "Spread potatoes on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Flip potatoes over and bake until crisp on the outside and soft on the inside, about 15 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "589cded0-a67c-5388-a62d-21d0d65a68ab",
  "slug": "easy-banana-nut-pancakes",
  "name": "Easy Banana Nut Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These banana walnut pancakes flavored with cinnamon and nutmeg taste like warm banana bread and are simple to make for an easy breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together flour, walnuts, sugar, baking powder, nutmeg, cinnamon, baking soda, and salt in a large bowl; make a well in the center and set aside."
    },
    {
      "position": 2,
      "text": "Whisk together almond milk, bananas, melted butter, and vanilla in a separate bowl until smooth. Whisk in egg. Pour mixture into the well of flour mixture; stir until batter is just combined."
    },
    {
      "position": 3,
      "text": "Heat a lightly greased skillet over medium-high heat. Drop 1/4 cup batter into the hot skillet; tilt gently to spread batter evenly. Cook until bubbles form on top and the edges are firm, 3 to 4 minutes. Flip and cook until browned on the other side, 1 to 2 minutes more. Repeat with remaining batter."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

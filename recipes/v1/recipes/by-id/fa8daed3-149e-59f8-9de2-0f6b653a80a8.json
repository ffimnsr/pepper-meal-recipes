  "id": "fa8daed3-149e-59f8-9de2-0f6b653a80a8",
  "slug": "hearty-chicken-vegetable-soup-i",
  "name": "Hearty Chicken Vegetable Soup I",
  "recipe_type": "soup",
  "brief_description": "Chicken, tortellini and egg noodle soup with carrots, yellow squash, zucchini, mushrooms, and bell pepper.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken, onion, celery, salt, basil, and pepper in a 10 quart stock pot. Fill stock pot with water until ingredients are fully covered and bring to a boil. Let simmer for 1 and 1/2 hours or until chicken is tender."
    },
    {
      "position": 2,
      "text": "Remove chicken from pot with slotted spoon and set aside for later."
    },
    {
      "position": 3,
      "text": "Add carrots, squash, zucchini, mushrooms, red pepper, tortellini, chicken soup base and uncooked noodles to stock pot and increase temperature to medium heat."
    },
    {
      "position": 4,
      "text": "While noodles and vegetables are cooking, tear chicken apart from bones. Cut up into pieces and add to soup in stock pot. Be sure to add additional water if ingredients are not fully covered. Bring to a boil, then reduce to a simmer for about 10 minutes or just until noodles are cooked. Enjoy"
    }
  ],
  "servings": 40,

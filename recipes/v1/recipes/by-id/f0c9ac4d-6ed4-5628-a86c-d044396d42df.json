  "slug": "pink-fluff",
  "name": "Pink Fluff",
  "recipe_type": "salad",
  "brief_description": "This pink fluff recipe is a creamy mix of cottage cheese, whipped topping, pineapple, cherry pie filling, and raspberry gelatin, and topped with pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cottage cheese, pineapple, cherry pie filling, and whipped topping in a large bowl; pour gelatin over top and mix well. Divide fluff among serving bowls; chill for 8 hours to overnight."
    }
  ],
  "servings": 6,

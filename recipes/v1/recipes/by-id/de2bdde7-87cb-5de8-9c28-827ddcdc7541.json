  "id": "de2bdde7-87cb-5de8-9c28-827ddcdc7541",
  "slug": "leftover-corned-beef-hash",
  "name": "Leftover Corned Beef Hash",
  "recipe_type": "main",
  "brief_description": "Use up leftover corned beef hash from St. Patrick's Day by frying it with potatoes and eggs on the stovetop for a quick and easy meal.",
  "cuisine": "American Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a pan over medium-high heat until sizzling. Place potatoes in the oil and cook, turning every couple of minutes, until golden brown, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Shred corned beef and toss into the pan. Cook until heated through, about 10 minutes. Season with salt and pepper and give a good stir. Crack eggs on top, sprinkle with more salt and pepper, and cover until eggs are set, 3 to 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

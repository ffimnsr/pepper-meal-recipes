  "id": "e8d14736-d3a5-57ec-99e2-c678b39f8932",
  "slug": "red-pear-pomegranate-and-gorgonzola-salad",
  "name": "Red Pear, Pomegranate, and Gorgonzola Salad",
  "recipe_type": "salad",
  "brief_description": "Red pears, pomegranate arils, Gorgonzola cheese, toasted walnuts and a simple vinaigrette top Romaine lettuce for a delicious salad.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine apple cider vinegar, extra-virgin olive oil, honey, Dijon mustard, salt, and white pepper in a small container with a lid. Cover tightly and shake until well combined. Set aside."
    },
    {
      "position": 2,
      "text": "Place lettuce in a salad bowl. Sprinkle with toasted walnut pieces and cheese crumbles. Fan pear slices on the top of the salad and sprinkle with pomegranate arils and chopped scallion."
    },
    {
      "position": 3,
      "text": "Drizzle with vinaigrette and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "f5e7ef24-ee58-503f-b53f-7c13a56ad8d1",
  "slug": "korean-bbq-style-chicken-sandwich-recipe-12019021",
  "name": "Korean BBQ-Style Chicken Sandwich",
  "recipe_type": "main",
  "brief_description": "This Korean BBQ-style chicken sandwich is loaded with saucy chunks of chicken breast flavored with gochujang, ginger, garlic, soy sauce, and more. Topped with Sriracha mayo, lettuce, and pickles, it makes one seriously satisfying sandwich.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat avocado oil in a medium skillet over medium heat. Add chicken and cook and stir until browned and no longer pink at the center, about 5 minutes. Remove skillet from the heat; set aside."
    },
    {
      "position": 2,
      "text": "Add sesame oil, garlic paste, ginger paste, gochujang paste, soy sauce, brown sugar, honey, and rice wine vinegar to a small saucepan. Cook over low heat, stirring frequently, until thickened and heated through, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Return the skillet with chicken back to low heat. Add sauce to chicken and stir, cooking through until warm. Meanwhile, stir Sriracha and mayonnaise together in a small bowl."
    },
    {
      "position": 4,
      "text": "To assemble, lay the buns on a plate. Cover each bun with lettuce, and drizzle with Sriracha mayonnaise. Spoon chicken over lettuce, add pickle slices, sprinkle with green onion, and drizzle with more Sriracha mayonnaise."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

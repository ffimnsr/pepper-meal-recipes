  "id": "b26b754e-5968-578c-8f16-ce896b20c8af",
  "slug": "whoopie-pies",
  "name": "Cake Mix Whoopie Pies",
  "recipe_type": "dessert",
  "brief_description": "Little chocolate cakes with creamy filling. This recipe has been handed down in my family for quite sometime and hasn't had any complaints yet.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "To make the cakes: Prepare mix as directed on package except using only 3/4 cup of water. Drop batter onto greased cookie sheet (or use parchment paper to line pan) in 2 1/2 to 3 inch circles. Bake until toothpick inserted in center comes out clean. Let cool."
    },
    {
      "position": 2,
      "text": "To make the filling: In a saucepan, combine milk and flour and cook, stirring constantly until it forms a thick paste. Let cool."
    },
    {
      "position": 3,
      "text": "In a medium bowl, beat sugar and shortening until fluffy. Add vanilla. Add cooled flour mixture and beat until double in volume."
    },
    {
      "position": 4,
      "text": "Turn the little cakes over on their backs. Spoon a dollop of filling onto half of the little cakes. Place the other half of the cakes on top of the filling to form sandwiches."
    }
  ],
  "servings": 24,

  "id": "91f4277d-9941-5e1a-ad3c-358c2b700be5",
  "slug": "honey-angel-food-cake",
  "name": "Honey Angel Food Cake",
  "recipe_type": "dessert",
  "brief_description": "Try this recipe for honey-flavored angel food cake that has served at least one family well through the generations and is now shared for the benefit of yours.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place a 10-inch tube pan in the oven. Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat egg whites with salt in a glass or metal bowl until foamy. Add cream of tartar and continue to beat until egg whites stand in peaks. Gradually add honey while beating continually to integrate until stiff peaks form. Lift your beater or whisk straight up: the egg whites will form sharp peaks."
    },
    {
      "position": 3,
      "text": "Sift flour and white sugar together. Add 1/3 of the flour mixture into the egg whites and fold gently with a spoon to integrate; repeat in two more additions of the flour mixture to completely incorporate. Stir vanilla into the batter."
    },
    {
      "position": 4,
      "text": "Remove hot tube pan from the preheated oven. Pour the batter into the hot pan. Thump pan several times on a flat surface to break air bubbles in batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and the top springs back when lightly pressed, 22 to 25 minutes. Cool cake in pan on a wire pastry rack for at least 2 hours. Run a long, thin metal spatula or knife around edge of pan to loosen cake from pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

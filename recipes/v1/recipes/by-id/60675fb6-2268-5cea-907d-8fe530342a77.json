  "id": "60675fb6-2268-5cea-907d-8fe530342a77",
  "slug": "fajita-marinade-i",
  "name": "Fajita Marinade",
  "recipe_type": "drink",
  "brief_description": "Delicious fajita marinade made with lime juice, olive oil, and soy sauce, and spiced up with cayenne and black pepper. This recipe makes enough marinade for 2 pounds of meat.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk water, lime juice, olive oil, garlic, soy sauce, salt, and liquid smoke flavoring together in a bowl."
    },
    {
      "position": 3,
      "text": "Stir in cayenne and black pepper until combined."
    },
    {
      "position": 4,
      "text": "Use to marinate 2 pounds of meat; marinate in the refrigerator for at least 2 hours to overnight before cooking as desired."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 16,

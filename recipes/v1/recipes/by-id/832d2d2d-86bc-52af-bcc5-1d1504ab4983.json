  "id": "832d2d2d-86bc-52af-bcc5-1d1504ab4983",
  "slug": "asparagus-parmesan",
  "name": "Asparagus Parmesan",
  "recipe_type": "side",
  "brief_description": "Pan-fried asparagus with Parmesan cheese, saut\u00e9ed to perfection in olive oil and butter, is a quick, delicious, and easy four-ingredient side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter with olive oil in a large skillet over medium heat. Add asparagus spears; cook, stirring occasionally, until desired firmness, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Drain off and discard excess oil; sprinkle with Parmesan cheese, salt, and pepper."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

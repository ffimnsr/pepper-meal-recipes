{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8bf01dd9-91a6-5f8c-aa05-4c7d3b9bde4e",
  "slug": "ground-turkey-burritos-that-will-fool-your-kids",
  "name": "Ground Turkey Burritos That Will Fool Your Kids",
  "recipe_type": "main",
  "brief_description": "This ground turkey burritos that will fool your kids recipe wraps turkey, tomatoes, rice, onions, garlic, and celery in cabbage within a tortilla shell.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring brown rice with enough water to cover in a saucepan to a boil. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 45 to 50 minutes."
    },
    {
      "position": 2,
      "text": "Cut off red cabbage stem. Gently peel off leaves, being careful not to tear; place individual leaves into a large pot of water and bring to a boil. Cook for 5 minutes; reduce heat and simmer until tender but still crunchy and red, 8 to 10 minutes more. Drain."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium-high heat. Saut\u00e9 celery, onion, and garlic until softened, 5 to 7 minutes. Mix in turkey; season with salt. Cook and stir until turkey is browned and crumbly, 5 to 7 minutes. Add crushed tomatoes and cooked rice; cook, stirring occasionally, until flavors combine, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Place 1 cabbage leaf on top of each tortilla. Fill with turkey-rice mixture; fold up bottom end and roll into a tight burrito."
    },
    {
      "position": 5,
      "text": "Heat a grill pan over medium heat. Cook burritos, in batches, until outsides are crunchy, about 5 minutes, flipping as necessary. Repeat with remaining burritos."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

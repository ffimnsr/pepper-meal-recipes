  "id": "55a2aee3-3afc-5614-9f1d-771833809956",
  "slug": "vegan-gluten-free-mushroom-soup",
  "name": "Vegan Gluten-Free Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "This vegan and gluten-free mushroom and coconut milk soup is quick and easy to make for a tasty weeknight meal. Pack the leftovers for lunch!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Cook and stir onions until they start to soften, about 5 minutes. Add mushrooms and thyme; stir until fragrant, about 5 minutes. Stir in broth, bay leaves, and soy sauce. Bring soup to a boil."
    },
    {
      "position": 2,
      "text": "Whisk cornstarch and water together in a small bowl; pour into soup and stir well to incorporate. Reduce heat and simmer soup until it starts to thicken, about 10 minutes. Add coconut milk, salt, and black pepper. Simmer just until coconut milk is heated through (do not allow to boil), about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

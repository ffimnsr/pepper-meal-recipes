  "id": "9975365a-d5e7-5557-a21b-4baac60d9bcf",
  "slug": "homemade-pancakes",
  "name": "Homemade Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Whip up a batch of homemade pancakes to kick off your weekend brunch with this quick and easy, no-frills recipe that works every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, milk, egg, butter, sugar, baking powder, and salt together."
    },
    {
      "position": 2,
      "text": "Heat a lightly oiled griddle over low heat. Scoop 1/4 cup batter onto the griddle and cook until top and edges are dry, 3 to 4 minutes. Flip and cook until lightly browned on the other side, 2 to 3 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,

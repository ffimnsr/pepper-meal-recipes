  "id": "108d032f-d55f-5dcc-9bbc-f0975d917f16",
  "slug": "kid-friendly-taco-burritos",
  "name": "Kid-Friendly Taco-Burritos",
  "recipe_type": "main",
  "brief_description": "These fast, easy, bean taco-burritos stay together nicely, so your little one can eat the WHOLE THING! Refried beans, lettuce, tomato, avocado, green onions and cheese are put in a tortilla, folded over, and folded again into a wedge shape. The wedge shape keeps everything contained!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "In a large serving dish, arrange green onions. diced tomato, sliced olives, lettuce and avocado. Set aside."
    },
    {
      "position": 2,
      "text": "Empty the can of refried beans into a microwave-safe bowl. Season with onion flakes, garlic, salt, cumin, chili powder and oregano. Stir in water, cover, and cook in microwave, on high, for about 2 minutes."
    },
    {
      "position": 3,
      "text": "Take a tortilla and spread a thin layer of beans on half of it. Sprinkle on the cheese, and whatever toppings you would like. Spread sour cream over the other half of the tortilla."
    },
    {
      "position": 4,
      "text": "Fold the tortilla in half, and then into quarters, and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

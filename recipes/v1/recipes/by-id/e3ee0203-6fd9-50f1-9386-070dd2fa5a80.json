  "slug": "batanga-cocktail-recipe-11701237",
  "name": "Batanga Cocktail",
  "recipe_type": "appetizer",
  "brief_description": "The Batanga cocktail, with tequila, cola, and lime, in a salted glass is similar to a Cuba libre, but with tequila.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Run a lime wedge around the edge of a glass and rim with salt if desired. Fill cup with ice and add tequila and lime juice Top with cola and add a pinch of salt. Stir and enjoy with a wedge of lime."
    }
  ],

  "id": "52d8f9e4-cfcc-5c43-ae12-db9f32c481e5",
  "slug": "jalapeno-spinach-dip-recipe-8781590",
  "name": "Jalapeno Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "This jalapeno spinach dip recipe takes this crowd favorite up a notch\u2014the jalapenos add a nice kick. Feel free to use more jalapenos if you\u2019d like it hotter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat butter or olive oil in a cast iron skillet over medium heat. Add green onions, jalapenos, and garlic; cook and stir for 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Add spinach, greens seasoning, and water. Cook and stir until spinach is wilted, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir cream cheese and mayonnaise together in a separate bowl; stir in spinach and Parmesan cheese. Spread evenly into an oven safe dish. Sprinkle with a little Parmesan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until hot and bubbly, 20 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

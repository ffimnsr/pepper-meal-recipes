  "id": "058e5e68-5f43-5afd-8742-e9c6b4092405",
  "slug": "ginger-lime-pork-rolls-recipe-11813216",
  "name": "Ginger Lime Pork Spring Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These ginger lime pork spring rolls are filled with ginger and lime-seasoned sauteed ground pork, green onions, and cilantro.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground pork in a skillet over medium heat until no longer pink, about 7 minutes. Season meat with salt (or add a splash of soy sauce), and season with white pepper. Stir 1 minute; remove from heat."
    },
    {
      "position": 2,
      "text": "Transfer meat to a bowl and cool slightly. Add ginger and lime zest. Cut lime in half and squeeze in juice from 1/2 lime; mix well."
    },
    {
      "position": 3,
      "text": "Dip rice wrappers in warm water for about 10 seconds, then transfer to a cutting board. Spread about 2 tablespoons meat mixture along the bottom edge of wrapper."
    },
    {
      "position": 4,
      "text": "Lay some green onion and cilantro leaves on top of meat. Fold the bottom of the wrapper up over meat, then fold in sides. Roll wrapper up to seal."
    },
    {
      "position": 5,
      "text": "Serve with soy sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

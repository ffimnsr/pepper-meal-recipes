  "id": "99b42ad0-8df2-5df9-9d69-457cb1a897ee",
  "slug": "air-fryer-lemon-garlic-parmesan-chicken-recipe-8726749",
  "name": "Air Fryer Lemon Garlic Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "These simple lemon garlic Parmesan chicken thighs are cooked in the air fryer. Seasoned with lemon zest, garlic, and oregano and coated in Parmesan cheese they come out juicy and tender",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Place chicken in a large bowl. Add garlic, lemon zest, paprika, oregano, salt, and crushed red pepper; toss to coat chicken in the seasonings."
    },
    {
      "position": 4,
      "text": "Combine Parmesan cheese and panko in a shallow dish. Dredge chicken in Parmesan mixture to coat. Sprinkle any remaining mixture over chicken; pat to adhere."
    },
    {
      "position": 5,
      "text": "Coat the chicken generously with cooking spray."
    },
    {
      "position": 6,
      "text": "Lightly coat air fryer basket with cooking spray. Place chicken in prepared basket (cook in batches, if needed). Air fry 12 minutes or until an instant-read thermometer inserted in the center reads 170 degrees F (77 degrees C)."
    },
    {
      "position": 7,
      "text": "Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

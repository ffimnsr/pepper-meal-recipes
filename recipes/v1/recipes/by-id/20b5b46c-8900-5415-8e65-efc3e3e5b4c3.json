  "id": "20b5b46c-8900-5415-8e65-efc3e3e5b4c3",
  "slug": "tex-mex-chicken-casserole",
  "name": "Tex-Mex Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This creamy, comforting Tex-Mex chicken casserole recipe with a nacho cheese-flavored corn chip crust is a version of the King Ranch chicken casserole.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Spread corn chip crumbs over bottom of the baking dish; press crumbs into place."
    },
    {
      "position": 3,
      "text": "Melt butter in a large skillet over medium-high heat. Add onion; cook and stir until tender, 6 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Combine diced tomatoes, cream of chicken soup. cream of mushroom soup, green chiles, milk, sour cream, chili powder, and cumin in a large bowl; stir in chicken and onion to combine. Pour over corn chips; top with Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly and cheese is melted, 55 to 60 minutes. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

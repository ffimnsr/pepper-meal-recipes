  "id": "67573643-2306-5858-bc85-7a8b4bb7dc38",
  "slug": "chicken-cordon-bleu-meatballs-recipe-8724477",
  "name": "Chicken Cordon Bleu Meatballs",
  "recipe_type": "main",
  "brief_description": "These chicken Cordon Bleu meatballs have everything \u2014 chicken, ham, Swiss cheese, a crispy coating, and a creamy sauce, in a fun meatball form.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine shallot, half and half, parsley, egg, and 1/3 cup Italian breadcrumbs in a mixing bowl and stir together."
    },
    {
      "position": 2,
      "text": "Add ham and chicken; season with salt, pepper, garlic powder, and paprika. Mix all ingredients together just until uniform."
    },
    {
      "position": 3,
      "text": "Add remaining Italian bread crumbs and panko to a shallow dish and stir to combine. Roll meat mixture into 12 balls and stuff a Swiss cheese cube into the center. Roll each ball in breadcrumbs until evenly coated; place on a plate or baking sheet. Freeze meatballs for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C) and set a wire rack inside a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Heat oil in a large skillet over medium-high heat. Add meatballs and cook until browned on all sides, 5 to 10 minutes. Transfer meatballs to the prepared wire rack."
    },
    {
      "position": 6,
      "text": "Bake meatballs in the preheated oven until an instant read thermometer, inserted near the center, reads 165 degrees F (74 degrees C), about 10 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, make sauce. Wipe skillet clean and melt butter over medium heat. Whisk in flour and cook 1 minute. Whisk in broth and half-and-half. Stir in mustard, salt, and pepper and bring to a simmer. Reduce heat and simmer until sauce is rich and creamy, about 5 minutes. Remove from heat and stir in lemon juice."
    },
    {
      "position": 8,
      "text": "Serve meatballs with Dijon cream sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

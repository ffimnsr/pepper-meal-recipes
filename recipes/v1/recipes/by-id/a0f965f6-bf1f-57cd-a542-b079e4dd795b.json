  "id": "a0f965f6-bf1f-57cd-a542-b079e4dd795b",
  "slug": "antipasti-garlic-bread-recipe-8716000",
  "name": "Antipasti Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This antipasti garlic bread is vibrant with a pop of brightly colored cherry tomatoes, creamy mozzarella cheese, basil, and prosciutto on golden-toasted garlic butter French bread.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven\u2019s broiler to 500 degrees F (260 degrees C), and set a rack 6 inches from the heat source. Line a baking sheet with foil. Lay bread slices on the prepared sheet."
    },
    {
      "position": 2,
      "text": "Rub peeled garlic cloves over a microplane grater to make a paste. Add garlic paste to a bowl; sprinkle with salt. Add softened butter and mix well. Spread 1 to 2 teaspoons garlic butter on each bread slice."
    },
    {
      "position": 3,
      "text": "Broil garlic bread under the preheated broiler until golden, 1 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove garlic bread from oven to cool slightly on a wire rack. Place mozzarella and tomatoes in a bowl; gently toss mixture, and divide evenly between bread slices. Garnish with prosciutto and basil; serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

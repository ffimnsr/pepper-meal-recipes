  "id": "82f3ced8-c19e-51d4-a2de-d48c96265d6c",
  "slug": "cuban-style-yuca",
  "name": "Cuban-Style Yuca",
  "recipe_type": "drink",
  "brief_description": "Yuca is cooked until tender and served with a hot dressing made with onion, garlic, olive oil, and lemon juice. A refreshingly different side dish!",
  "cuisine": "Cuban",
  "instructions": [
    {
      "position": 1,
      "text": "Place yuca into a pan and fill with enough water to cover. Stir in salt. Bring to a boil over medium-high heat, cover, and cook until tender, about 15 minutes. Drain; place yuca on a serving plate."
    },
    {
      "position": 2,
      "text": "Meanwhile, place olive oil, onion, garlic, and lemon juice into a pan. Cook over medium heat for about 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour the hot olive oil mixture over the yuca; serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "a39848f8-8c6f-5f27-b647-b52883a53ef1",
  "slug": "3-ingredient-mango-ice-cream-recipe-7554240",
  "name": "Mango Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This mango ice cream is creamy, scoopable, and super easy to make in an ice cream maker with just 3 ingredients: fresh mango pulp, cream, and sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients"
    },
    {
      "position": 2,
      "text": "Peel and dice mangoes. Place in a blender and blend until pureed; measure out 1 \u00bd cups puree; set aside. Refrigerate any remaining puree for another use."
    },
    {
      "position": 3,
      "text": "Whip heavy cream and sugar together in a large bowl with an electric mixer on high speed until soft peaks form."
    },
    {
      "position": 4,
      "text": "Reduce the mixer speed to low and mix in prepared mango puree."
    },
    {
      "position": 5,
      "text": "Pour into a freezer-safe bowl. Freeze for 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "Remove ice cream from freezer and let sit for 8 to 10 minutes or until soft enough to scoop."
    }
  ],

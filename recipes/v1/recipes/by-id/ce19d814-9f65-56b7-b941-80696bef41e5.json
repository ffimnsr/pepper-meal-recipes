  "id": "ce19d814-9f65-56b7-b941-80696bef41e5",
  "slug": "vanishing-oatmeal-raisin-cookies",
  "name": "Vanishing Oatmeal Raisin Cookies",
  "recipe_type": "dessert",
  "brief_description": "Classic oatmeal raisin cookies make tasty after-school snacks or lunchbox treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and sugars together in a large bowl with an electric mixer on medium speed until creamy. Add eggs and vanilla; beat well."
    },
    {
      "position": 3,
      "text": "Add combined flour, baking soda, cinnamon and salt; mix well."
    },
    {
      "position": 4,
      "text": "Add oats and raisins; mix well."
    },
    {
      "position": 5,
      "text": "Drop dough by rounded tablespoonfuls onto ungreased cookie sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until light golden brown, about 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Cool briefly on cookie sheets; remove to wire rack. Cool completely. Store tightly covered."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

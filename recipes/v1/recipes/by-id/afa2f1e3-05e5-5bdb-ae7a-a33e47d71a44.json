  "id": "afa2f1e3-05e5-5bdb-ae7a-a33e47d71a44",
  "slug": "meatless-mincemeat-pie",
  "name": "Meatless Mincemeat Pie",
  "recipe_type": "dessert",
  "brief_description": "This meatless mincemeat pie recipe makes a cozy, dessert with walnuts, apples, sugar, lemon, and rum (or brandy or apple juice) for a rich filling.",
  "cuisine": "American British",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mincemeat, apples, walnuts, brown sugar, rum, and lemon juice in a bowl. Cover bowl with plastic wrap; refrigerate 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) with a rack in the lowest position."
    },
    {
      "position": 3,
      "text": "Remove filling from the refrigerator; bring to room temperature. Meanwhile, place 1 crust in bottom of a 9-inch pie plate."
    },
    {
      "position": 4,
      "text": "Stir mincemeat filling well; pour into the bottom crust. Top with remaining 1 pie crust; crimp edges. Cut vent slits in top crust (or cut top crust into strips and weave for a lattice top)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

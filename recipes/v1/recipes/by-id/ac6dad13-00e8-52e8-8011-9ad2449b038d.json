  "id": "ac6dad13-00e8-52e8-8011-9ad2449b038d",
  "slug": "ramen-coleslaw",
  "name": "Ramen Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This ramen noodle coleslaw is a crunchy, satisfying salad with shredded cabbage, toasted almonds, and sesame seeds tossed in sweet, tangy dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cabbage, green onions, and crushed ramen noodles in a large salad bowl; set aside."
    },
    {
      "position": 3,
      "text": "Spread almonds and sesame seeds evenly onto a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, make dressing: Whisk together vinegar, oil, sugar, salt, pepper, and seasoning packet in a medium bowl."
    },
    {
      "position": 6,
      "text": "Pour dressing over cabbage mixture; toss to coat evenly. Sprinkle with toasted almonds and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

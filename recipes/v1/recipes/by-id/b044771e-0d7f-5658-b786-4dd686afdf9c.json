  "id": "b044771e-0d7f-5658-b786-4dd686afdf9c",
  "slug": "cinnamon-apple-strata",
  "name": "Cinnamon-Apple Strata",
  "recipe_type": "dessert",
  "brief_description": "This sweet, make-ahead cinnamon-apple strata provides an easy, warm breakfast for fall or winter mornings.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Place apples, butter, brown sugar, 1/2 tablespoon cinnamon, and salt into a skillet over medium heat. Saute until sugar bubbles, about 5 minutes. Set aside."
    },
    {
      "position": 3,
      "text": "Place eggs, half-and-half, cream cheese, and remaining cinnamon into a blender and blend until smooth."
    },
    {
      "position": 4,
      "text": "Scatter cubed bagels, cooked apples, and pecans in the bottom of the prepared baking dish. Pour egg mixture on top, making sure to submerge bagel cubes. Let sit in the refrigerator 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until no liquid remains, 30 to 40 minutes. Serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

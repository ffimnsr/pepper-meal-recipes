  "slug": "fireside-coffee",
  "name": "Fireside Coffee",
  "recipe_type": "drink",
  "brief_description": "This fireside coffee recipe is a comforting, warming drink, perfect for unwinding. Its creamy, chocolaty blend of coffee and spices melts away tension.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix non-dairy creamer, instant coffee, sugar, hot chocolate mix, cinnamon, and nutmeg in a bowl."
    },
    {
      "position": 2,
      "text": "To use, mix 2 to 3 heaping tablespoons in a mug with hot water. Store remaining mixture in an airtight container."
    }
  ],

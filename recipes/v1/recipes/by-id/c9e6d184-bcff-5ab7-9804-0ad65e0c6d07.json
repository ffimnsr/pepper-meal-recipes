  "id": "c9e6d184-bcff-5ab7-9804-0ad65e0c6d07",
  "slug": "german-chocolate-fudge",
  "name": "German Chocolate Fudge",
  "recipe_type": "dessert",
  "brief_description": "This rich chocolate fudge recipe is as easy to make as it is fattening!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine chocolate chips, German sweet chocolate and marshmallow creme in large bowl."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, evaporated milk and salt in heavy skillet. Bring to a boil over medium heat. Cook for 6 minutes, stirring constantly."
    },
    {
      "position": 3,
      "text": "Pour hot syrup over chocolate mixture. Stir with wooden spoon until smooth. Stir in pecans."
    },
    {
      "position": 4,
      "text": "Spread into buttered 10x15 inch pan. Let stand until firm; cut into squares."
    }
  ],
  "servings": 80,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 15,

  "id": "b1158be6-01af-5e80-a010-e3f48854d323",
  "slug": "stuffed-mushroom-casserole-recipe-8417107",
  "name": "Stuffed Mushroom Casserole",
  "recipe_type": "appetizer",
  "brief_description": "Stuffed mushroom casserole is your favorite party appetizer but in casserole form.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon of the oil in a large nonstick skillet over medium-high. Add sausage; cook, stirring often, until browned and crumbled, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Using a slotted spoon, transfer cooked sausage to a large bowl, leaving drippings in skillet."
    },
    {
      "position": 4,
      "text": "Return skillet to medium-high. Add remaining 1 tablespoon oil to drippings. Add mushrooms; cook, stirring occasionally, until mushrooms are softened, browned, and have released most of their liquid, 8 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Add garlic; cook, stirring constantly, until fragrant, about 30 seconds. Stir in cream cheese and Gournay cheese; cook, stirring constantly, until cheese is melted and evenly coating mushrooms, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Transfer mushroom mixture to bowl with sausage, and stir in mozzarella and 1/2 cup of the Parmesan cheese until evenly combined."
    },
    {
      "position": 7,
      "text": "Spoon into an even layer in a 13- x 9-inch baking dish coated with cooking spray."
    },
    {
      "position": 8,
      "text": "Stir together panko, melted butter, and remaining 1/4 cup Parmesan cheese in a small bowl. Sprinkle evenly over top of mushroom mixture."
    },
    {
      "position": 9,
      "text": "Bake in preheated oven until topping is golden, about 25 minutes. Sprinkle with parsley. Serve hot. Recipe developed by Julia Levy"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

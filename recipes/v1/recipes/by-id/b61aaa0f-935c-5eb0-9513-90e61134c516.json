  "id": "b61aaa0f-935c-5eb0-9513-90e61134c516",
  "slug": "healthier-tuna-noodle-casserole",
  "name": "Healthier Tuna Noodle Casserole",
  "recipe_type": "main",
  "brief_description": "Put a lighter spin on the classic tuna noodle casserole by upping the veggies and opting for low-fat Alfredo sauce and whole wheat bread crumbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 2-quart baking dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow-tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a large skillet over medium heat. Add mushrooms, onion, celery, bell pepper, and carrot; cook until vegetables are tender, about 8 minutes."
    },
    {
      "position": 4,
      "text": "Whisk together Alfredo sauce, sour cream, 2 tablespoons Parmesan, dill, and black pepper in a large bowl. Stir in cooked pasta, vegetables, and tuna until combined. Transfer to the prepared dish. In a small bowl, stir together panko and remaining 2 tablespoons Parmesan; sprinkle over casserole. Lightly coat with nonstick spray."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, uncovered, until browned and bubbly, about 25 minutes. Serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

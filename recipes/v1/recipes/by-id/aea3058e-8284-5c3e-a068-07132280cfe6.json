  "id": "aea3058e-8284-5c3e-a068-07132280cfe6",
  "slug": "campfire-chicken-pot-pie",
  "name": "Campfire Chicken Pot Pie",
  "recipe_type": null,
  "brief_description": "This recipe uses prepared biscuit dough to top a creamy mixture of chicken and vegetables so you can have chicken pot pie at your campsite using some careful campfire cooking.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir vegetables, chicken soup, mushroom soup, and chicken cubes together in a Dutch oven with a flat lid."
    },
    {
      "position": 2,
      "text": "Cook over campfire coals until warmed through but not boiling, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Arrange biscuit dough segments in a layer atop the vegetable mixture. Put lid on the Dutch oven and carefully arrange some hot coals atop the lid."
    },
    {
      "position": 4,
      "text": "Heat until the biscuits are cooked through, 15 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

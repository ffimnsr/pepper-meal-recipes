  "id": "2d90d191-b5a9-5a3a-87e5-4a8b53da2d45",
  "slug": "culver-s-copycat-wisconsin-butter-burgers-recipe-11949472",
  "name": "Culver's Copycat Wisconsin Butter Burgers",
  "recipe_type": "main",
  "brief_description": "These Culver's copycat Wisconsin butter burgers have a lot of flavor and are very quick and easy to make. Griddled smashed burgers are layered with American cheese, topped with lettuce, tomato, and pickle, and served on a buttered Kaiser roll.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Divide beef into 8 (3 ounce) portions. Form loosely into balls and refrigerate until ready to use, at least 5 minutes and up to 24 hours."
    },
    {
      "position": 2,
      "text": "Heat oil on a griddle or a large cast iron skillet over medium heat. Working in batches, toast Kaiser rolls cut-side down until lightly golden, about 1 minute. Transfer to a serving platter and generously brush cut sides with melted butter."
    },
    {
      "position": 3,
      "text": "Increase heat to high. Working in batches, place beef balls onto the hot griddle. Immediately smash each ball with a sturdy metal spatula or burger press into a 1/4-inch thick patty. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Cook without moving until edges are browned and crisp, 1 to 2 minutes. Flip, top each patty with a slice of cheese, and cook until the second side is browned and cheese is melted, about 1 minute more. Cook to an internal temperature of 160 degrees F (71 degrees C). Transfer to a plate."
    },
    {
      "position": 5,
      "text": "To assemble, spread mayonnaise on bottom buns and add desired toppings. Top each with 2 patties and close with top buns. Serve immediately. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

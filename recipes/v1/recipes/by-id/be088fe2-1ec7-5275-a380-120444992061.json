  "slug": "teri-tips",
  "name": "Teri Tips",
  "recipe_type": "main",
  "brief_description": "Cubed beef steak is marinated in soy sauce, sesame oil, and sugar for at least 4 hours. The meat is sauteed and added to the reduced marinade along with chopped green onions and white wine.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, sugar, and sesame oil in a shallow dish to make the marinade. Add meat, and refrigerate for 4 hours."
    },
    {
      "position": 2,
      "text": "Place a large skillet over medium high heat, and cook meat until done."
    },
    {
      "position": 3,
      "text": "Pour the marinade into a medium saucepan, and place over medium high heat. Bring to a boil, and cook for 5 minutes. Add cooked meat, green onions, and wine to the boiling marinade. Transfer the entire contents of the saucepan to a large bowl, and serve hot."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,

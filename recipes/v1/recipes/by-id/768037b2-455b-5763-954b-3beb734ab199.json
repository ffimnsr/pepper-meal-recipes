  "slug": "kalua-pig-in-a-slow-cooker",
  "name": "Kalua Pig in a Slow Cooker",
  "recipe_type": "main",
  "brief_description": "This kalua pork recipe seasons a pork butt roast which simmers in the slow cooker for fall-apart tender pork without digging a hole in your backyard!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pierce pork all over with a carving fork; rub in salt then liquid smoke. Transfer pork into a slow cooker."
    },
    {
      "position": 3,
      "text": "Cover, and cook on Low for 16 to 20 hours, turning once during cooking time."
    },
    {
      "position": 4,
      "text": "Remove pork from slow cooker; shred with two forks, adding drippings as needed to moisten."
    }
  ],

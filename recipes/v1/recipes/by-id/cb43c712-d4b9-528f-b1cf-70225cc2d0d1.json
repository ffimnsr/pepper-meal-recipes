  "id": "cb43c712-d4b9-528f-b1cf-70225cc2d0d1",
  "slug": "air-fryer-potato-slices-with-dipping-sauce-recipe-11799563",
  "name": "Air Fryer Potato Slices with Dipping Sauce",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer potato slices with dipping sauce are a tasty finger food somewhere between a French fry and a potato chip. Do take the time to make the beer ketchup dipping sauce\u2014it\u2019s worth it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ketchup, beer, Worcestershire sauce, onion powder, and cayenne in a small saucepan. Bring to a boil, then reduce heat, and simmer for 3 to 5 minutes. Remove from heat, and cool. Cover and store in the refrigerator until ready to use."
    },
    {
      "position": 2,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C). Spray the basket with cooking spray or line with a disposable parchment liner."
    },
    {
      "position": 3,
      "text": "Slice potatoes 1/4-inch thick (use a mandoline if you have one), and place in a bowl. Spray potatoes with olive oil spray, and sprinkle with garlic powder, salt and pepper. Give the potatoes a good stir."
    },
    {
      "position": 4,
      "text": "Place potatoes in a single layer in the air fryer, and cook, shaking occasionally, until they start to crisp up a bit and turn golden brown, 14 to 17 minutes. Cooking times can vary depending on the brand and size of the fryer, and you may have to cook in batches."
    },
    {
      "position": 5,
      "text": "Remove from the fryer, and serve with beer ketchup dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

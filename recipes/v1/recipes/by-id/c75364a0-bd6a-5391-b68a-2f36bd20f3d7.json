  "id": "c75364a0-bd6a-5391-b68a-2f36bd20f3d7",
  "slug": "fully-loaded-deviled-eggs",
  "name": "Fully Loaded Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Savory deviled eggs with sour cream loaded with Cheddar cheese and bacon bits make a nice appetizer or a light meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs into a large pot and cover with lightly salted water. Bring to a boil and reduce heat to medium; boil eggs for 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Drain boiling water and fill the pot with cold water. Let eggs sit in cold water for 2 minutes, then pour off water and replace with more cold water. Repeat until eggs are thoroughly chilled, 10 to 15 minutes. Peel eggs; set aside."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a small skillet over medium heat; cook and stir onion until translucent, about 5 minutes. Remove from heat and let cool."
    },
    {
      "position": 4,
      "text": "Slice eggs in half lengthwise and scoop yolks into a bowl; transfer egg white halves to a plate."
    },
    {
      "position": 5,
      "text": "Mash egg yolks with a fork; stir in sour cream, mayonnaise, ranch dressing, Dijon mustard, garlic powder, onion powder, and lemon pepper seasoning until yolk mixture is smooth. Stir in saut\u00e9ed onions, bacon bits, and Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Generously fill egg halves with filling and sprinkle each deviled egg with paprika. Refrigerate until chilled before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

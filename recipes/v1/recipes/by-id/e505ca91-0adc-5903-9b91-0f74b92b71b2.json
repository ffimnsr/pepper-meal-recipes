  "id": "e505ca91-0adc-5903-9b91-0f74b92b71b2",
  "slug": "cuban-mojito",
  "name": "Cuban Mojito",
  "recipe_type": "dessert",
  "brief_description": "This Cuban mojito blends sugar, fresh lime juice, mint sprigs, rum, and club soda for a sweet, citrusy refreshing drink perfect on a hot summer day.",
  "cuisine": "Cuban Latin",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 teaspoon sugar each into two 12-ounce glasses. Squeeze juice from a lime wedge into each glass and drop in the wedge. Place 2 mint sprigs into each glass. Use a spoon or muddler to mash lime mixture together in the bottom of the glasses."
    },
    {
      "position": 2,
      "text": "Fill each glass about half full with crushed ice. Pour 1/4 cup rum into each glass. Fill the glasses with club soda, stir, and garnish with remaining lime wedges."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "a3ab9f70-0502-5e35-8991-aa30cbc28509",
  "slug": "never-fail-fruit-cake",
  "name": "Never Fail Fruit Cake",
  "recipe_type": "dessert",
  "brief_description": "This sweetened condensed milk fruit cake recipe combines candied cherries and pineapple with dates and pecans and bakes them into a delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Lightly grease a 10-inch tube pan. Line bottom of pan with greased parchment paper. Set aside."
    },
    {
      "position": 2,
      "text": "Chop fruit and nuts in a large mixing bowl. Add coconut and mix well with hands. Stir in flour, then sweetened condensed milk. Blend well."
    },
    {
      "position": 3,
      "text": "Pack firmly in prepared tube pan. Bake for 1 1/2 hours. Remove from oven. Run knife around edge of cake and remove rim of pan. When barely warm, remove tube bottom and paper from cake."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,

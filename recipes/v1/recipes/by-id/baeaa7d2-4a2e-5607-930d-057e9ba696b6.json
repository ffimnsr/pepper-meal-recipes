  "id": "baeaa7d2-4a2e-5607-930d-057e9ba696b6",
  "slug": "easy-authentic-mexican-rice",
  "name": "Easy Authentic Mexican Rice",
  "recipe_type": "side",
  "brief_description": "This easy Mexican rice recipe with onion powder, garlic powder, and tomato sauce makes for an easy side dish that\u2019s ready to serve in just 25 minutes!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat canola oil in a skillet over medium-high heat; season with onion powder and garlic powder. Stir in rice and cook until golden, 2 to 4 minutes."
    },
    {
      "position": 2,
      "text": "Stir in water and tomato sauce; bring to a boil. Reduce heat to medium-low, cover, and simmer until rice is tender, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

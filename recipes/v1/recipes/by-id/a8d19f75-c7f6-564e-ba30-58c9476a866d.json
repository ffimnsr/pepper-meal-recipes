  "id": "a8d19f75-c7f6-564e-ba30-58c9476a866d",
  "slug": "hamburger-jazz",
  "name": "Cheesy Hamburger Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This hamburger rice casserole with cheese is quick and easy comfort food. Get dinner on the table with just five ingredients!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble the ground beef into a skillet over medium-high heat. Cook and stir until evenly browned. Drain off grease, and stir in the cream of mushroom soup, tomatoes, and uncooked rice. Cover, and simmer over low heat, stirring occasionally, until rice is tender, about 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven's broiler. When the rice is done cooking, transfer the contents of the skillet into a 9x9-inch casserole dish. Cover with a layer of cheese."
    },
    {
      "position": 3,
      "text": "Broil until the cheese is melted and toasty. Season with salt and pepper to taste, and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

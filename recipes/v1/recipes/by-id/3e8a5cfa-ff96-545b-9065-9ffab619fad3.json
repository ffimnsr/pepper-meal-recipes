  "name": "Copycat Blueberry Cream Cheese Spread",
  "recipe_type": "appetizer",
  "brief_description": "This copycat blueberry cream cheese spread is a simple, budget-friendly recipe to duplicate that famous blueberry cream cheese spread. You don\u2019t even need fresh blueberries to achieve a sweet spread that\u2019s perfect for bagels, muffins, or toast.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Place cream cheese, half-and-half, and vanilla in a mixing bowl. Use an electric mixer to beat until completely smooth. Add blueberry preserves, and mix until you reach your desired spreading consistency."
    },
    {
      "position": 2,
      "text": "Serve immediately, or store in the fridge in an airtight container."
    }
  ],

  "id": "d9c28939-5b6f-5961-b564-6f9f748dde02",
  "slug": "air-fryer-eggplant-recipe-8700773",
  "name": "Air Fryer Eggplant",
  "recipe_type": "side",
  "brief_description": "For this air fryer eggplant, there\u2019s no need for time-consuming breading. This quick-and-easy eggplant is tasty, soft, and creamy on the inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Place a disposable paper liner in the air fry basket or give it a spritz of cooking spray."
    },
    {
      "position": 2,
      "text": "Stir eggplant cubes in a large bowl with avocado oil. Sprinkle with garlic powder, thyme, lemon pepper, and salt. Toss until all pieces are well coated."
    },
    {
      "position": 3,
      "text": "Place the eggplant cubes in a single layer in the air fryer basket, and mist with cooking spray. Cook until browned on the outside and tender inside, 15 to 17 minutes, shaking the basket halfway through. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

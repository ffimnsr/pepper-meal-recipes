  "id": "156e3fcb-fdbc-5e98-9525-e2c6e13522e4",
  "slug": "hidden-veggie-meatloaf",
  "name": "Hidden Veggie Meatloaf",
  "recipe_type": "main",
  "brief_description": "This flavorful meatloaf made with ground turkey, lean ground beef, bell pepper, onion, and celery is a great way to sneak veggies into your unsuspecting kids.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ground beef, ground turkey, egg, celery, rolled oats, skim milk, ketchup, onion, green pepper, parsley, dry mustard, salt, minced garlic, and black pepper in a bowl until thoroughly combined; mixture will be moist. Transfer mixture into a 9x5-inch loaf pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until an instant-read meat thermometer inserted into the center of the meatloaf reads at least 160 degrees F (70 degrees C), about 1 1/2 hours. Meatloaf may still look pink inside due to ketchup."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

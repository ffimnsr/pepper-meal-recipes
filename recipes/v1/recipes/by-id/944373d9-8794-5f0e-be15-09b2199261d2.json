  "id": "944373d9-8794-5f0e-be15-09b2199261d2",
  "slug": "chocolate-beer-cupcakes-with-whiskey-filling-and-irish-cream-icing",
  "name": "Chocolate Beer Cupcakes With Whiskey Filling And Irish Cream Icing",
  "recipe_type": "dessert",
  "brief_description": "Chocolate beer cupcakes with Irish whiskey-flavored chocolate cream filling and a delectable Irish cream frosting \u2014 perfect for a St. Patrick's Day party!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Bring Irish stout beer and 1 cup butter to a boil in a saucepan and set aside until butter has melted, stirring occasionally. Mix in cocoa powder until smooth."
    },
    {
      "position": 3,
      "text": "Whisk together flour, sugar, baking soda, and salt in a bowl until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Beat eggs with sour cream in a large bowl with an electric mixer on low until well combined. Slowly beat in beer mixture, then flour mixture; beat until batter is smooth."
    },
    {
      "position": 5,
      "text": "Divide batter between the prepared cupcake cups, filling each cup about 2/3 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a cupcake comes out clean, about 17 minutes."
    },
    {
      "position": 7,
      "text": "Cool the cupcakes completely. Cut cores out of the center of each cupcake with a sharp paring knife. Discard cores."
    },
    {
      "position": 8,
      "text": "Bring cream to a simmer in a saucepan over low heat; stir in bittersweet chocolate until melted."
    },
    {
      "position": 9,
      "text": "Mix in 2 tablespoons butter and Irish whiskey until butter is melted; let mixture cool to room temperature. Filling will thicken as it cools."
    },
    {
      "position": 10,
      "text": "Spoon the filling into the cored cupcakes."
    },
    {
      "position": 11,
      "text": "For frosting: Whip 1/2 cup butter in a bowl with an electric mixer until fluffy, 2 to 3 minutes."
    },
    {
      "position": 12,
      "text": "Set mixer to low speed and slowly beat in confectioners' sugar, one cup at a time, until frosting is smooth and spreadable. Beat in Irish cream liqueur; adjust the thickness of frosting with more confectioners' sugar if needed."
    },
    {
      "position": 13,
      "text": "Spread frosting on filled cupcakes."
    }
  ],
  "servings": 24,

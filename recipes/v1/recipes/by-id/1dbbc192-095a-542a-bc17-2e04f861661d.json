  "id": "1dbbc192-095a-542a-bc17-2e04f861661d",
  "slug": "pecan-pie-vi",
  "name": "Pecan Pie VI",
  "recipe_type": "dessert",
  "brief_description": "Nobody can resist a sweet and nutty pecan pie! This pecan pie is made with brown sugar and light corn syrup and is even more delicious when served with whipped cream.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, cream the butter and brown sugar. Beat in the corn syrup, eggs, salt and vanilla. Stir in the chopped pecans. Pour filling into pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Reduce temperature to 325 degrees F (165 degrees C) and bake for 30 to 40 minutes, or until golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

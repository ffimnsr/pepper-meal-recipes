  "id": "ba863c54-f2f3-53c4-86b6-d64a1c0f2b95",
  "slug": "easy-beet-hummus",
  "name": "Easy Beet Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Beet hummus made with cooked beets, chickpeas, tahini, garlic, and lemon juice is the perfect way to use summer beets for a colorful, delicious dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beets, chickpeas, lemon juice, tahini, garlic, salt, and cumin in the bowl of a food processor; pulse until pureed. Pour reserved chickpea liquid in slowly, with the processor running, until hummus is smooth and desired consistency is achieved."
    }
  ],

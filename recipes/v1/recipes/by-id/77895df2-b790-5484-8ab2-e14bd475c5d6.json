  "id": "77895df2-b790-5484-8ab2-e14bd475c5d6",
  "slug": "corn-dogs",
  "name": "Homemade Corn Dogs",
  "recipe_type": "main",
  "brief_description": "Make your own corn dogs using beef frankfurters skewered on sticks, dipped in corn batter, and fried until golden brown for a carnival treat at home.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cornmeal, flour, sugar, baking powder, salt, and pepper in a medium bowl; stir in milk and egg to make a batter."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Meanwhile, pat frankfurters dry and insert a skewer into each one."
    },
    {
      "position": 5,
      "text": "Roll frankfurters in batter until well coated."
    },
    {
      "position": 6,
      "text": "Fry 2 or 3 corn dogs at a time in preheated oil until lightly browned, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Drain on paper towels."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,

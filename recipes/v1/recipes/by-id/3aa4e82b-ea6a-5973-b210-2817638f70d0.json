  "id": "3aa4e82b-ea6a-5973-b210-2817638f70d0",
  "slug": "special-deviled-eggs",
  "name": "Special Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Learn how to make deviled eggs with relish, mayonnaise, onion, and horseradish for tasty appetizers with a sweet kick perfect for summer barbecues.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, and peel."
    },
    {
      "position": 2,
      "text": "Slice each egg in half lengthwise and remove yolks; set aside egg white halves and place yolks in a medium bowl. Use a fork to mash yolks, then mix in mayonnaise, relish, onion, horseradish, and mustard until well combined."
    },
    {
      "position": 3,
      "text": "Use a spoon or pastry bag to fill egg white halves with yolk mixture. Garnish with paprika, salt, and pepper. Chill in the refrigerator until serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "8efbe479-bf4e-5c3c-84dd-87fadcd5104a",
  "slug": "creamy-dirty-martini-spaghetti-recipe-11929242",
  "name": "Creamy Dirty Martini Spaghetti",
  "recipe_type": "side",
  "brief_description": "This creamy dirty martini spaghetti is quick and easy to make, but the flavor is so enticing it\u2019s worthy of a special dinner. Gin, green castelvetrano olives and brine, and lemon zest season the creamy sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Scoop out about a cup of pasta water and set aside. Drain spaghetti."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add garlic and olives and saute until garlic becomes fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Carefully stir in gin and continue to stir until most of the alcohol has evaporated. Add in butter. Once butter has melted, add olive brine, pasta water, and cream cheese, and whisk until well combined. You can add a little more pasta water if sauce is too thick."
    },
    {
      "position": 4,
      "text": "Season sauce with Parmesan cheese, black pepper, and lemon zest."
    },
    {
      "position": 5,
      "text": "Add cooked spaghetti to the skillet and toss until well coated. Serve with blue cheese crumbles, parsley, and more lemon zest if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "4e13e533-4313-5fde-a15e-b4f938993d78",
  "slug": "garlic-knot-monkey-bread-recipe-11881271",
  "name": "Garlic Knot Monkey Bread",
  "recipe_type": "appetizer",
  "brief_description": "This garlic knot monkey bread is an ideal appetizer when you want something quick but incredibly tasty. Pizza dough pieces are rolled into balls and dipped in garlic-herb butter, then baked with Parmesan cheese. It's fantastic!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter a round casserole dish."
    },
    {
      "position": 2,
      "text": "In a mixing bowl, combine butter, green onion, parsley, egg, garlic powder, and salt."
    },
    {
      "position": 3,
      "text": "Tear dough into small chunks, then roll into balls. Dip each ball in egg mixture, then lay on the bottom of the casserole dish. Repeat with all the dough."
    },
    {
      "position": 4,
      "text": "Sprinkle Parmesan cheese on top. Cover with foil or lid and let rise for about 30 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Invert the bread onto a plate and if the bottom needs a little more baking, slide the bread back into the casserole dish and bake the bottom until golden, about 10 minutes more."
    },
    {
      "position": 8,
      "text": "Remove and serve warm with dipping sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

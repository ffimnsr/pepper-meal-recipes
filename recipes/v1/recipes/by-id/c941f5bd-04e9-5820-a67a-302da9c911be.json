  "id": "c941f5bd-04e9-5820-a67a-302da9c911be",
  "slug": "pineapple-fritters",
  "name": "Pineapple Fritters",
  "recipe_type": "dessert",
  "brief_description": "These unique fritters are like bread doughnuts, studded with pineapple and finished with pineapple glaze for just the right amount of sweetness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk pineapple, flour, milk, and egg together to form a light and fluffy batter."
    },
    {
      "position": 3,
      "text": "Bring reserved pineapple juice to a boil in a small saucepan. Add white sugar and stir to dissolve; lower heat. Simmer until thickened glaze forms, about 10 minutes. Remove from heat and cool to room temperature, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Drop spoonfuls of batter in the hot oil, 2 to 3 pieces at a time, and fry until golden brown, 3 to 4 minutes. Drain on paper towels."
    },
    {
      "position": 5,
      "text": "Drizzle glaze over fritters and dust with confectioners' sugar."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 13,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

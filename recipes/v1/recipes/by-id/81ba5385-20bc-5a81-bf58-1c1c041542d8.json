  "id": "81ba5385-20bc-5a81-bf58-1c1c041542d8",
  "slug": "smoked-pork-chops",
  "name": "Smoked Pork Chops",
  "recipe_type": "dessert",
  "brief_description": "These smoked pork chops are seasoned with a homemade rub that has the perfect balance of sweet, salty, and smoky. Try a new way to enjoy pork chops.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the smoker to 250 degrees F (120 degrees C). Add wood chips according to the manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Combine salt, brown sugar, pepper, paprika, ground mustard, garlic powder, onion powder, and oregano in a small bowl. Sprinkle over both sides pork chops."
    },
    {
      "position": 3,
      "text": "Place pork chops, unstacked, onto smoker grate. Smoke for 2 hours 30 minutes. Remove chops from the smoker and let rest for 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,

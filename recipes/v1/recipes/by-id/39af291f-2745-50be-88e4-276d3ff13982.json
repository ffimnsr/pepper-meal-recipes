  "id": "39af291f-2745-50be-88e4-276d3ff13982",
  "slug": "best-beef-jerky",
  "name": "Best Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "Snack on the best homemade beef brisket jerky, marinated in a knee-weakening seasoning that checks all the boxes: smoky, sweet, and savory.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place beef brisket in the freezer for 1 hour to make slicing easier."
    },
    {
      "position": 2,
      "text": "Place brisket on a flat work surface. Slice on the grain into the thinnest possible strips, about 1/4-inch-thick."
    },
    {
      "position": 3,
      "text": "Place beef strips in the bottom of a large bowl or container. Pour in teriyaki sauce, soy sauce, Worcestershire sauce, corn syrup, liquid smoke, brown sugar, sesame seeds, garlic powder, honey, onion powder, and cayenne pepper. Mix well until beef is evenly coated and submerged. Cover with plastic wrap and marinate in the refrigerator for 24 hours."
    },
    {
      "position": 4,
      "text": "Remove beef and pat dry using paper towels. Place beef in a single layer on the trays of a dehydrator machine. Cook at 155 degrees F (68 degrees C), or according to manufacturer's instructions, until dry and firm, yet slightly pliable, about 5 hours."
    },
    {
      "position": 5,
      "text": "Leave beef out in the air to cool until dry; the longer you leave it out, the drier it will get."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

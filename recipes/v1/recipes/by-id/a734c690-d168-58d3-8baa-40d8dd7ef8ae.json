  "id": "a734c690-d168-58d3-8baa-40d8dd7ef8ae",
  "slug": "sheet-pan-chicken-alfredo-lasagna-recipe-8772256",
  "name": "Sheet Pan Chicken Alfredo Lasagna",
  "recipe_type": "main",
  "brief_description": "Use a sheet pan to create this easy chicken Alfredo lasagna with store-bought Alfredo sauce and shredded chicken.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Break lasagna noodles into 4 to 5 pieces and drop into the boiling water. Cook for 8 minutes, stirring occasionally, until just al dente. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat 1 tablespoon olive oil in a large deep skillet over medium-high heat. Add onion and cook until soft, stirring constantly, about 3 minutes. Add spinach and cook, stirring constantly until wilted and liquid has evaporated. Stir in alfredo sauce and cook for 1 minute. Stir in chicken, 2/3 cup mozzarella and basil, if using. Remove from heat and stir in cooked pasta."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees C (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Drizzle remaining olive oil evenly over a 18 x 13-inch rimmed baking sheet (half sheet pan). Pour lasagna mixture into the pan and spread it evenly to the edges. Dollop ricotta randomly over the pasta and sprinkle with remaining mozzarella and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned and bubbly, about 25 minutes. Sprinkle with parsley and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

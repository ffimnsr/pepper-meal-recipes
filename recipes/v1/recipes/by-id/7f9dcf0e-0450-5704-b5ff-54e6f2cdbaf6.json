  "id": "7f9dcf0e-0450-5704-b5ff-54e6f2cdbaf6",
  "slug": "air-fryer-cheesy-bacon-ranch-french-fries-recipe-7560981",
  "name": "Air Fryer Cheesy Bacon Ranch French Fries",
  "recipe_type": "side",
  "brief_description": "Cheesy bacon ranch fries made in the air fryer start with frozen fries, so they're great for a last-minute side or for when unexpected guests arrive. They never disappoint.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees Fahrenheit (200 degrees C). Place frozen French fries in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk olive oil and dry ranch salad mix in a separate small bowl until smooth. Pour olive oil mixture over the fries and toss to coat. Add bacon bits and salt. Toss again."
    },
    {
      "position": 3,
      "text": "Place seasoned fries in the basket of the air fryer. Cook for 7 minutes. Shake the basket and cook 5 minutes more."
    },
    {
      "position": 4,
      "text": "Sprinkle shredded cheese over the fries. Cook 2 minutes. Using a spatula, transfer to a serving platter and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

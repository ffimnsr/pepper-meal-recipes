  "id": "9a6729e8-2c00-5c2d-9543-fc24047692b1",
  "slug": "caramel-flan-recipe-11965542",
  "name": "Caramel Flan",
  "recipe_type": "dessert",
  "brief_description": "This caramel flan is a classic caramel baked flan, chilled until deliciously creamy and cool with a perfect texture.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Make caramel: Melt sugar and water in a saucepan over medium heat, swirling occasionally until it turns a smooth, golden amber color. Quickly pour into a 9-inch round pan and tilt to evenly coat the bottom. Set aside to cool and harden."
    },
    {
      "position": 3,
      "text": "Make flan: Blend condensed milk, evaporated milk, heavy whipping cream, vanilla, eggs, egg yolks, and cardamom until smooth. Strain mixture to remove bubbles. Pour over the caramel. Cover the cake pan tightly with foil."
    },
    {
      "position": 4,
      "text": "Place the cake pan in a larger pan or foil tray. Pour water halfway up the sides."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour 30 to 1 hour 40 minutes. The center should jiggle slightly but not be liquid."
    },
    {
      "position": 6,
      "text": "Remove from the oven and water bath, uncover, and cool to room temperature. Then cover with plastic wrap and refrigerate overnight to fully set."
    },
    {
      "position": 7,
      "text": "When ready to serve, invert onto a large plate or platter. Slice and spoon the caramel over the top. Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 15,

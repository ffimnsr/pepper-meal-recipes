  "id": "6a18a9fb-c329-597d-b4d3-8f41c0f54c2c",
  "slug": "gourmet-microwave-popcorn",
  "name": "Gourmet Microwave Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Make your own microwave popcorn. All you need is popcorn, olive oil, salt, and brown paper bag!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place popcorn in a brown paper bag. Tightly seal the bag by folding the top several times."
    },
    {
      "position": 2,
      "text": "Microwave on High until the popping slows, about 2 minutes. Carefully open the bag. Season with salt and drizzle with olive oil. Reclose the bag and shake to distribute the seasoning."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

  "id": "c8058707-d7e9-530e-9d86-fccc0c10ea73",
  "slug": "shrimp-scampi-with-pasta",
  "name": "Shrimp Scampi with Pasta",
  "recipe_type": "main",
  "brief_description": "Shrimp scampi pasta is a delicious dish of tender shrimp in a garlicky white wine butter sauce with linguine pasta for a quick and impressive dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil; cook linguine in boiling water until nearly tender, 6 to 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter with 2 tablespoons olive oil in a large skillet over medium heat."
    },
    {
      "position": 4,
      "text": "Add shallots, garlic, and red pepper flakes; cook and stir until shallots are translucent, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Season shrimp with kosher salt and black pepper. Add to the skillet; cook until pink, stirring occasionally, 2 to 3 minutes. Transfer shrimp to a plate; keep warm."
    },
    {
      "position": 6,
      "text": "Add white wine and lemon juice to the skillet; bring to a boil while scraping the browned bits of food off of the bottom of the skillet with a wooden spoon."
    },
    {
      "position": 7,
      "text": "Melt remaining 2 tablespoons butter in skillet; stir in 2 tablespoons olive oil and bring to a simmer."
    },
    {
      "position": 8,
      "text": "Toss linguine, shrimp, and parsley in butter mixture until coated; season with salt and black pepper. Drizzle with 1 teaspoon olive oil to serve."
    },
    {
      "position": 9,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

  "id": "06ec1be6-8f4d-5be3-b095-9b75cf86b284",
  "slug": "my-grandmothers-potato-chip-cookies",
  "name": "My Grandmother's Potato Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These easy potato chip cookies are irresistible, have a lovely crunch, and use just 5 simple ingredients to make a sweet and salty eggless treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease baking sheets."
    },
    {
      "position": 2,
      "text": "Beat together butter, sugar, and vanilla in a large bowl with an electric mixer until creamy and well combined. Mix in flour a little at a time until incorporated. Gently fold in potato chips. Drop dough by spoonfuls onto the prepared baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the edges are golden brown, about 15 minutes. Transfer cookies to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "cd95dff3-8c52-5dcb-8271-8517f5c8da1d",
  "slug": "pork-lo-mein",
  "name": "Pork Lo Mein",
  "recipe_type": "main",
  "brief_description": "This pork lo mein recipe features thinly sliced pork tenderloin, vegetables, and linguine noodles drenched in a delicious ginger-sesame-soy- sauce.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; cook the linguine at a boil until tender yet firm to the bite, 8 to 9 minutes; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk soy sauce, vinegar, cornstarch, sugar, and sesame oil together in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat canola oil in a large skillet over medium-high heat. Add snap peas and onion; cook and stir until onion is translucent, about 2 minutes. Add pork, mushrooms, red bell pepper, 1/3 of the garlic, and ginger; cook until pork is no longer pink, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add remaining garlic to the skillet and cook until fragrant, about 1 minute. Pour in soy sauce mixture; cook and stir until sauce thickens, about 1 minute. Remove from the heat."
    },
    {
      "position": 5,
      "text": "Stir linguine into the skillet until coated; sprinkle green onions over top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

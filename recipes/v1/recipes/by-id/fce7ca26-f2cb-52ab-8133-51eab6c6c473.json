  "id": "fce7ca26-f2cb-52ab-8133-51eab6c6c473",
  "slug": "southwest-chicken-power-salad-recipe-8778848",
  "name": "Southwest Chicken Power Salad",
  "recipe_type": "salad",
  "brief_description": "This Southwest chicken power salad is not your average green salad. Packed with chicken, beans, corn, and hearty vegetables, and dressed with a delicious cilantro vinaigrette, this high-protein salad will keep you satisfied for hours.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "To make the vinaigrette: Place cilantro, olive oil, lime juice, honey, garlic, cumin, and cayenne in the bowl of a blender or mini food processor and pulse several times until well blended. For a creamy dressing, include the optional Mexican crema. Season to taste with salt and pepper."
    },
    {
      "position": 2,
      "text": "For salad, line a serving plate with mixed salad greens. Arrange chicken, pinto beans, corn, yellow bell pepper, red bell pepper, cherry tomatoes, cotija, avocado, and red onion in a pleasing design on top of greens."
    },
    {
      "position": 3,
      "text": "Drizzle with vinaigrette (alternatively, place all ingredients in a large salad bowl and toss with vinaigrette). Garnish with pumpkin seeds and jalape\u00f1o slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

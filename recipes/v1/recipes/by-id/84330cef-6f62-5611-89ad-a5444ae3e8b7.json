  "id": "84330cef-6f62-5611-89ad-a5444ae3e8b7",
  "slug": "waffles-ii",
  "name": "Waffles II",
  "recipe_type": "breakfast",
  "brief_description": "Yummy waffles that are quick and easy to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat waffle iron. In a large mixing bowl, sift together flour, baking powder and salt. Stir in milk, oil and egg yolks until mixture is smooth. In a separate bowl, beat egg whites until soft peaks form. Gently fold egg whites into batter."
    },
    {
      "position": 2,
      "text": "Spray preheated waffle iron with non-stick cooking spray. Pour mix onto hot waffle iron. Cook until golden; serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "8a65b0f8-1e16-5eb8-9d8f-0e82e40f2a89",
  "slug": "garlic-herb-bubble-bread-recipe-12020242",
  "name": "Garlic Herb Bubble Bread",
  "recipe_type": "side",
  "brief_description": "This garlicherb bubble bread is made with a simple yeast dough. Small balls of risen dough are coated with butter, garlic, and pizza seasoning and baked in a loaf pan for a fun, pull-apart treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add flour, yeast, tapioca flour, dry milk, sugar, salt, butter, water, and milk to the bowl of a stand mixer fitted with a dough hook. Mix until a soft dough forms, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Cover the bowl and let the dough rise until doubled in size, 60 to 90 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a loaf pan or line with parchment."
    },
    {
      "position": 4,
      "text": "For coating, combine 2 tablespoons butter with pizza seasoning and garlic powder."
    },
    {
      "position": 5,
      "text": "Break dough into 15 to 20 small balls. Dip each ball into butter mixture, then arrange coated dough balls evenly in the prepared pan. Set the pan aside and let rise for 20 minutes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the top is golden brown, 30 to 40 minutes. Brush with additional melted butter and garlic."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

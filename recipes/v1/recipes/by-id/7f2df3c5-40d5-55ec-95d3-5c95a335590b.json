  "schema_version": 1,
  "id": "7f2df3c5-40d5-55ec-95d3-5c95a335590b",
  "slug": "canadian-maple-scones",
  "name": "Canadian Maple Scones",
  "recipe_type": "breakfast",
  "brief_description": "Canadian maple scones are best served warm with a dollop of whipped cream and drizzled with a little extra maple syrup.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread walnuts onto a baking sheet."
    },
    {
      "position": 2,
      "text": "Toast walnuts in the preheated oven until nuts turn golden brown and become fragrant, about 5 minutes. Watch carefully; nuts can burn quickly. Set aside to cool to room temperature."
    },
    {
      "position": 3,
      "text": "Increase oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Place 3 tablespoons flour, 3 tablespoons brown sugar, and 1/2 cup cooled walnuts in a small bowl. Cut in 2 tablespoons butter using two knives or a pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 5,
      "text": "Whisk together 2 cups flour, 2 tablespoons brown sugar, baking powder, and salt. Cut in 1/2 cup butter using two knives or a pastry blender until mixture resembles fine crumbs. Stir in remaining 1/2 cup walnuts."
    },
    {
      "position": 6,
      "text": "Whisk together 1/3 cup maple syrup and egg in a small bowl; stir into flour mixture. Gradually stir in just enough milk for the dough to leave the sides of the bowl and form a ball."
    },
    {
      "position": 7,
      "text": "Place dough on a lightly floured surface. Roll gently in flour to coat; knead lightly about 10 times. Pat into an 8-inch circle on an ungreased baking sheet. Brush with milk; sprinkle evenly with topping. Score dough circle into 8 wedges with a knife, but do not separate wedges."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes. Remove immediately from the baking sheet, and separate the scones. Serve warm with whipped cream and maple syrup."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

  "id": "c49eae29-4590-5bd3-a54f-a7cd1a86122d",
  "slug": "baked-buffalo-dip-with-canned-chicken",
  "name": "Baked Buffalo Dip with Canned Chicken",
  "recipe_type": "appetizer",
  "brief_description": "Turn canned chicken into this zesty, cheesy, baked Buffalo dip with simple ingredients--perfect for a party or potluck!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix chicken chunks, cream cheese, Cheddar cheese, Buffalo sauce, and ranch dressing together until well combined. Transfer to a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbly and browned, stirring at least once so the top doesn't burn, 30 to 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "cdb02de2-1e1d-55cd-b9b6-2a0d2744b562",
  "slug": "egg-butter",
  "name": "Egg Butter",
  "recipe_type": "appetizer",
  "brief_description": "Use this unusual egg and butter spread as a sandwich filling, or as a topping for crackers or bagels.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the eggs into a saucepan in a single layer and fill with water to cover the eggs by 1 inch. Cover the saucepan and bring the water to a boil over high heat. Once the water is boiling, remove from the heat and let the eggs stand in the hot water for 15 minutes. Cool the eggs under cold running water. Peel, and remove yolks from white. Chop yolks; reserve whites for another use."
    },
    {
      "position": 2,
      "text": "Beat butter in a large bowl until soft and fluffy. Mix in the egg yolks, cayenne pepper, and Worcestershire sauce. Beat until smooth."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

  "id": "f9c7e13e-c67a-5aff-a6ee-5df3de76bbc4",
  "slug": "grilled-mushrooms-stuffed-with-basil-and-blue-cheese-butter",
  "name": "Grilled Mushrooms Stuffed with Basil and Blue Cheese Butter",
  "recipe_type": "appetizer",
  "brief_description": "Follow this quick and easy recipe for tender grilled mushrooms filled with a crowd-pleasing blue cheese, basil, and butter stuffing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat tops of mushrooms with olive oil. Place mushrooms top-down in a grill-safe dish."
    },
    {
      "position": 2,
      "text": "Mix blue cheese, butter, garlic, basil, salt, and pepper thoroughly in a bowl. Scoop evenly into the mushroom caps."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Cook mushrooms until tender and heated through, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

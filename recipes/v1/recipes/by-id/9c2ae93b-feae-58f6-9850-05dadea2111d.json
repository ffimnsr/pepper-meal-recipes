  "id": "9c2ae93b-feae-58f6-9850-05dadea2111d",
  "slug": "easy-pasta-fagioli",
  "name": "Easy Pasta Fagioli",
  "recipe_type": "soup",
  "brief_description": "This pasta fagioli recipe is a hearty bean and pasta soup with lots of veggies, tomatoes, and flavorful herbs for a comforting Italian meal on a chilly day!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a saucepan over medium heat. Add carrot, celery, and onion; cook and stir until soft. Add garlic and sauté briefly."
    },
    {
      "position": 2,
      "text": "Stir in tomato sauce, chicken broth, parsley, basil, and pepper; simmer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Add ditalini pasta and cook for 8 minutes or until al dente; drain."
    },
    {
      "position": 4,
      "text": "Add beans and cooked pasta to soup; simmer until heated through, 1 or 2 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

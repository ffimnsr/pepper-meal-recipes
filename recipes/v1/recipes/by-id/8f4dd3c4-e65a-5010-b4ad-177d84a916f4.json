  "id": "8f4dd3c4-e65a-5010-b4ad-177d84a916f4",
  "slug": "baked-spaghetti-squash",
  "name": "Baked Spaghetti Squash",
  "recipe_type": "side",
  "brief_description": "Tender baked spaghetti squash is a cinch to prep and cook in the oven until tender and the flesh is easy to shred for a delicious low-carb side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet with olive oil. Place spaghetti squash, cut-side down, onto the baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until tender and skin can easily be pierced with a fork, 40 to 60 minutes, depending on the size."
    },
    {
      "position": 3,
      "text": "Remove from the oven and allow to rest until cool enough to handle. Scrape out the flesh with a fork and discard the skins."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

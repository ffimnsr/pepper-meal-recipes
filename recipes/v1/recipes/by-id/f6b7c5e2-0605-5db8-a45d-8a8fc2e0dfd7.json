  "id": "f6b7c5e2-0605-5db8-a45d-8a8fc2e0dfd7",
  "slug": "french-onion-soup-i",
  "name": "French Onion Soup I",
  "recipe_type": "soup",
  "brief_description": "This French onion soup recipe features slices of toasted French bread topped with melted cheese in a bowl of rich, savory broth with caramelized onions.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a 4-quart saucepan over medium heat. Add onions and sugar; cook, stirring occasionally, until onions are golden brown, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in flour until well blended with onions and pan juices. Add water, wine, and beef broth. Bring to a boil, then reduce the heat to low. Cover and simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "While the soup is simmering, cut four 1-inch-thick slices from baguette; reserve the remaining bread for serving. Toast baguette slices in the preheated oven just until browned, about 10 minutes. Remove from the oven and set aside. Increase the oven temperature to 425 degrees F (220 degrees C)."
    },
    {
      "position": 5,
      "text": "Ladle soup into four 12-ounce, oven-safe bowls. Place one slice toasted baguette on top of the soup in each bowl. Fold Swiss cheese slices, and fit onto toasted bread slices. Place soup bowls onto a cookie sheet for easier handling."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven just until cheese is melted, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

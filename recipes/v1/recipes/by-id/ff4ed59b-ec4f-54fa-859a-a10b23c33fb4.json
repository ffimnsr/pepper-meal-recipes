  "id": "ff4ed59b-ec4f-54fa-859a-a10b23c33fb4",
  "slug": "chocolate-peanut-butter-fudge",
  "name": "Chocolate Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "This mixture of evaporated milk, cocoa, peanut butter, sugar, and margarine is such an easy and fun fudge recipe to make.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter one 9x9 inch pan."
    },
    {
      "position": 2,
      "text": "Combine the sugar, evaporated milk and cocoa in saucepan. Stir over high heat until mixture comes to a rolling boil. Lower heat to medium and continue cooking to a soft ball stage."
    },
    {
      "position": 3,
      "text": "Remove from heat, add peanut butter and margarine. Beat by hand until creamy; pour into prepared pan. Allow to cool and cut into squares."
    }
  ],
  "servings": 32,

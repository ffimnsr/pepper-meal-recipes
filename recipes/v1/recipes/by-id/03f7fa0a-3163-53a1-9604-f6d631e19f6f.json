  "id": "03f7fa0a-3163-53a1-9604-f6d631e19f6f",
  "slug": "judys-strawberry-pretzel-salad",
  "name": "Judy’s Strawberry Pretzel Salad",
  "recipe_type": "salad",
  "brief_description": "This strawberry pretzel dessert salad features layers of salty, crunchy crust, sweet cream cheese, and Jell-O for a gorgeous, chilled dish everyone loves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients, and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together pretzels, melted butter, and 4 1/2 tablespoons sugar in a medium bowl until well combined. Press into the bottom of a 9x13-inch dish."
    },
    {
      "position": 3,
      "text": "Press into the bottom of a 9x13 inch pan. Bake for 10 minutes, or until lightly toasted. Set aside to cool completely."
    },
    {
      "position": 4,
      "text": "In a medium bowl, beat the sugar and cream cheese until smooth."
    },
    {
      "position": 5,
      "text": "Fold in whipped topping and spread evenly over the cooled crust. Refrigerate until set, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Stir together boiling water and gelatin mix in a second large bowl. Mix in frozen strawberries; stir until thawed."
    },
    {
      "position": 7,
      "text": "Pour over cream cheese mixture in the dish. Refrigerate until completely chilled, at least 1 hour."
    },
    {
      "position": 8,
      "text": "Refrigerate until completely chilled, at least 1 hour. Slice and enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

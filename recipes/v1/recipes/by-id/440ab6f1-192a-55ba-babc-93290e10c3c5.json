  "id": "440ab6f1-192a-55ba-babc-93290e10c3c5",
  "slug": "the-perfect-basic-burger",
  "name": "The Perfect Basic Burger",
  "recipe_type": "main",
  "brief_description": "This hamburger patty recipe combines ground beef, bread crumbs, and seasonings to make 4 flavorsome patties that are ready to grill in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat and lightly oil grate."
    },
    {
      "position": 2,
      "text": "Whisk egg, salt, and pepper together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Add ground beef and bread crumbs; mix with your hands or a fork until well blended."
    },
    {
      "position": 4,
      "text": "Form into four 3/4-inch-thick patties."
    },
    {
      "position": 5,
      "text": "Place patties on the preheated grill. Cover and cook 6 to 8 minutes per side, or to desired doneness. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

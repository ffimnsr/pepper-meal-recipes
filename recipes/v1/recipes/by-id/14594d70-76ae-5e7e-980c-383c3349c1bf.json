  "id": "14594d70-76ae-5e7e-980c-383c3349c1bf",
  "slug": "seafood-paella-recipe-8727168",
  "name": "Seafood Paella",
  "recipe_type": "main",
  "brief_description": "This seafood paella, short grain rice flavored with saffron and chorizo, is topped with steamed clams, mussels, and shrimp.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place a medium-sized paella pan over medium-high heat, and add oil, onion, bell pepper, chorizo, and dried chili and cook until vegetables soften, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Using a box grater, grate tomatoes straight into the pan. Stir and cook until liquid has reduced by half."
    },
    {
      "position": 3,
      "text": "Reduce heat to low, and add tomato paste, white wine, garlic, saffron, and paprika. Cook paste mixture down, stirring, until fully incorporated."
    },
    {
      "position": 4,
      "text": "Add rice and chicken stock and stir until everything is all mixed in. Simmer over low heat, without stirring, for 15 minutes. Every now and then, peek with a spoon to make sure nothing is sticking or burning while simmering."
    },
    {
      "position": 5,
      "text": "After 15 minutes add shrimp, mussels, and clams. Cover with a lid or foil and cook on low for another 5 minutes. Turn off heat and let the pan sit for 5 minutes."
    },
    {
      "position": 6,
      "text": "Remove the lid. The rice should be fluffy with a slightly toasted bottom, mussels and clams should be open all of the way, and your shrimp should be pink. Fluff paella with a fork before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d7d4190a-2125-5cb7-a308-cecd12ae7607",
  "slug": "quick-and-easy-chicken-spaghetti",
  "name": "Quick and Easy Chicken Spaghetti",
  "recipe_type": "main",
  "brief_description": "This chicken spaghetti recipe is quick and easy to make with cooked chicken, mushrooms, and pasta simmered in a creamy cheese sauce with tomatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook angel hair pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes. Drain pasta and return it to the pot."
    },
    {
      "position": 2,
      "text": "Add chopped chicken, condensed soup, diced tomatoes with chile peppers, processed cheese, mushrooms, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Cook and stir over low heat until cheese is melted and mixture is heated through, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

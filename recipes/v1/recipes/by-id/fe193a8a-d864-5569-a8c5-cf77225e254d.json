  "id": "fe193a8a-d864-5569-a8c5-cf77225e254d",
  "slug": "cheesy-artichoke-dip",
  "name": "Cheesy Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Loads of cheese and artichoke hearts, plus a little bit of spiciness, make this hot dip a real crowd pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix artichoke hearts, marinated artichoke hearts, green chile peppers, mayonnaise, Parmesan cheese and mozzarella cheese."
    },
    {
      "position": 3,
      "text": "Spread the mixture in a small baking dish. Bake in the preheated oven 30 minutes, until lightly browned and bubbly."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

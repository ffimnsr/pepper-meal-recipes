{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8b4a613e-ba39-519e-9579-849dff356b51",
  "slug": "flan-mexicano-mexican-flan",
  "name": "Flan Mexicano (Mexican Flan)",
  "recipe_type": "dessert",
  "brief_description": "This Mexican flan is deliciously rich and creamy with a golden syrupy topping of caramelized sugar for an impressive and decadent dessert.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place sugar into a heavy saucepan over medium-high heat. Cook, stirring constantly, until sugar melts and turns a golden amber color, about 10 minutes. Watch carefully once syrup begins to change color because it burns quickly. Carefully pour caramel syrup into a flan mold. Set aside to cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place an oven rack in the middle position."
    },
    {
      "position": 3,
      "text": "Place sweetened condensed milk, whole milk, eggs, egg yolks, orange juice, orange zest, vanilla, and cornstarch into a blender; blend until smooth, about 1 minute. Pour in cream and pulse several times to incorporate. Pour mixture over cooled caramel syrup in the flan mold."
    },
    {
      "position": 4,
      "text": "Line a roasting pan with a damp kitchen towel. Place the filled flan mold carefully on the towel in the roasting pan, then place the roasting pan on the oven rack. Fill the roasting pan with enough boiling water to reach halfway up the sides of the flan mold."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the center of flan is set but still slightly jiggles when nudged, 45 minutes to 1 hour. Let cool, then refrigerate for at least 4 hours."
    },
    {
      "position": 6,
      "text": "To serve, run a sharp paring knife around the inside of the mold to release flan. Place a serving plate on the mold, then flip the mold over. Gently lift the mold to release flan and allow caramel syrup to cascade over custard. Remove the mold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

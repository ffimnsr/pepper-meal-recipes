  "slug": "buttery-nipple-gourmet-pudding-shots",
  "name": "Buttery Nipple Gourmet Pudding Shots",
  "recipe_type": "dessert",
  "brief_description": "Butterscotch pudding shots are all grown up, thanks to these gourmet buttery nipple pudding shots that taste like butterscotch candies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir milk, schnapps, Irish cream liqueur, vodka, and coffee-flavored liqueur together in a pitcher. Add pudding mix and blend thoroughly."
    },
    {
      "position": 2,
      "text": "Pour mixture into disposable shot cups and refrigerate until chilled, at least 30 minutes."
    }
  ],
  "servings": 12,

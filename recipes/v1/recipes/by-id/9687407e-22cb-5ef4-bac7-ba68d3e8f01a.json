  "id": "9687407e-22cb-5ef4-bac7-ba68d3e8f01a",
  "slug": "caprese-skewers",
  "name": "Caprese Skewers",
  "recipe_type": "appetizer",
  "brief_description": "Fresh mozzarella cheese is wrapped with basil and placed on skewers with cherry tomatoes for an easy and elegant caprese appetizer that's perfect for entertaining.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Wrap each mozzarella ball with a basil leaf."
    },
    {
      "position": 2,
      "text": "Thread a tomato half, a basil-wrapped mozzarella ball, and another tomato half onto a skewer. Repeat until all tomatoes are on skewers. Sprinkle with salt and pepper."
    }
  ],
  "servings": 24,

  "id": "6395e248-b06d-5b9d-8cbf-0b082d5672f3",
  "slug": "english-pound-cake",
  "name": "English Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This English pound cake recipe is made with sour cream, sugar, and butter, yielding a dense cake with three extracts \u2014 vanilla, orange, and almond.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda and salt together into a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy; it should be noticeably lighter in color. Add eggs, one at a time, beating well after each addition. Stir in extracts; blend in flour mixture, alternating with sour cream, until fully incorporated. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour 10 minutes. Cool cake on a wire rack before removing from pan to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

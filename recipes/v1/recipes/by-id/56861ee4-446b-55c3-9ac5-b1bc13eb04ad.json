  "slug": "crancrack-cranberry-salad",
  "name": "\"CranCrack\" Cranberry Salad",
  "recipe_type": "salad",
  "brief_description": "Cranberry salad, made with fresh cranberries, cherry Jell-O\u00ae, and pineapple creates a tasty salad welcome at any holiday or dinner table.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Process cranberries and orange in a food processor until finely ground."
    },
    {
      "position": 2,
      "text": "Stir boiling water, sugar, and gelatin together in a bowl until gelatin and sugar dissolve. Add cranberry mixture and pineapple with juice; stir. Pour into a 8-inch square serving dish, cover the dish with plastic wrap, and refrigerate until set, about 45 minutes."
    }
  ],

  "id": "97ebf26d-db41-507d-892f-33e663a5b9e7",
  "slug": "sausage-cheese-grits",
  "name": "Sausage Cheese Grits",
  "recipe_type": "breakfast",
  "brief_description": "This is a great, flavorful way to prepare grits. You can also use mild sausage and less or no hot sauce if you prefer not to have the extra spice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook sausage in a large skillet over medium-high heat, stirring until sausage is crumbly and lightly browned. Drain off grease and place sausage in a bowl. Meanwhile, bring water to a boil in a large saucepan over high heat. Stir in grits, and reduce heat to medium-low. Cook and stir constantly for 5 minutes until grits are tender, or follow package directions."
    },
    {
      "position": 3,
      "text": "Stir together sausage, cheese, butter, hot pepper sauce, and eggs. Fold in grits until combined, then spread into an ungreased, small casserole dish. Bake in the preheated oven until golden brown on top, 30 to 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

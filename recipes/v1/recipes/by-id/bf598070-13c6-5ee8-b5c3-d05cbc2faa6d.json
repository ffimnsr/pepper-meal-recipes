{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bf598070-13c6-5ee8-b5c3-d05cbc2faa6d",
  "slug": "paleo-stuffed-cabbage",
  "name": "Paleo Stuffed Cabbage",
  "recipe_type": "main",
  "brief_description": "These paleo cabbage rolls are stuffed with shredded cauliflower and zucchini instead of rice, along with a meaty beef and pork filling. Delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomatoes, chicken broth, 1 clove garlic, and 1 teaspoon parsley in a medium saucepan; bring to a boil. Add tomato paste. Fill the can 1/4 of the way with hot water; swirl to dissolve any tomato paste remaining in the can and pour into the saucepan. Season sauce with 1 teaspoon sea salt and 1/2 teaspoon pepper. Simmer until flavors combine, about 30 minutes. Set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Mix together beef, pork, onion, remaining 3 cloves garlic, basil, oregano, remaining 1/2 teaspoon parsley, 1/2 teaspoon sea salt, and remaining 1/4 teaspoon pepper in a large bowl until well combined."
    },
    {
      "position": 4,
      "text": "Bring a large pot of water to a boil; add 2 tablespoons sea salt. Add cauliflower; cook in boiling water for 5 minutes. Transfer to another large bowl using a slotted spoon. Add 1 head of cabbage to boiling water; cook for 5 minutes. Remove with the slotted spoon. Repeat with second cabbage. Separate cabbage leaves."
    },
    {
      "position": 5,
      "text": "Shred cauliflower and zucchini in a food processor fitted with the shredder disk. Add enough to beef mixture so there is an equal ratio of both. Stir in eggs and almond flour until incorporated."
    },
    {
      "position": 6,
      "text": "Lay 1 cabbage leaf on a flat surface. Roll 1 tablespoon beef mixture into a log and place in the middle of leaf. Overlap with the bottom of leaf; fold in opposing edges and roll up. Repeat with remaining leaves and beef mixture."
    },
    {
      "position": 7,
      "text": "Coat the bottom of a large baking dish with a layer of tomato sauce. Arrange cabbage rolls seam-side down in the dish; cover with remaining tomato sauce. Cover the dish with aluminum foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until sauce is bubbling, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 115,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

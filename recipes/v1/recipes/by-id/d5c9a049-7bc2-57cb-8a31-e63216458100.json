  "id": "d5c9a049-7bc2-57cb-8a31-e63216458100",
  "slug": "air-fryer-crispy-onions-recipe-11722288",
  "name": "Air Fryer Crispy Onions",
  "recipe_type": "side",
  "brief_description": "These air fryer crispy onions are delicious over steaks, in burgers, or just as a side dish, plus this might be the easiest way to achieve golden, crispy onions ever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Combine flour, cayenne pepper, and salt in a bowl. Add onion slices and toss until well coated."
    },
    {
      "position": 3,
      "text": "Place onions in basket and spray with avocado oil. Air fry until golden brown, 18 to 23 minutes, shaking basket every 4 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

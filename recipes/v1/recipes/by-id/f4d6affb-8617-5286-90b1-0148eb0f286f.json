  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f4d6affb-8617-5286-90b1-0148eb0f286f",
  "slug": "thai-red-curry-soup",
  "name": "Thai Red Curry Soup",
  "recipe_type": "soup",
  "brief_description": "Instead of rice noodles, jasmine rice is blended into this smooth, rich Thai red curry soup starring coconut milk, ginger, bell pepper, and plenty of herbs for garnish.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon olive oil in a large Dutch oven over medium heat. Season shrimp with salt and pepper. Add shrimp to pot and cook 2 to 3 minutes or until pink, turning halfway through. Set aside."
    },
    {
      "position": 2,
      "text": "Add remaining olive oil, bell pepper, onion, and garlic to pot. Cook, stirring occasionally, about 3 minutes or until tender. Stir in curry paste and ginger. Cook 1 minute, or until fragrant."
    },
    {
      "position": 3,
      "text": "Stir in stock, coconut milk, and rice, scraping any browned bits from the bottom of the pot."
    },
    {
      "position": 4,
      "text": "Bring to a boil over high heat; reduce heat and cook, stirring occasionally, until reduced, about 10 minutes. Stir in fish sauce and brown sugar. Remove from heat."
    },
    {
      "position": 5,
      "text": "Using an immersion blender, puree soup in pot. Or carefully transfer soup in batches to a large food processor or blender, covering opening with a dish towel, and blend until pureed. Return soup to pot."
    },
    {
      "position": 6,
      "text": "Stir in green onions, cilantro, basil, and lime juice. Divide soup evenly among 6 bowls and top each bowl with 3 shrimp. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

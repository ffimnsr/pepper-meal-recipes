  "id": "30c17ea6-bd06-583e-a500-1fbc74848c1b",
  "slug": "easy-slow-cooker-meatballs",
  "name": "Easy Slow Cooker Meatballs",
  "recipe_type": "main",
  "brief_description": "This crockpot meatballs recipe is quick and easy to prep. Let your slow cooker do all the work for a comforting hot meal at the end of the day!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place ground beef, bread crumbs, onion, garlic, parsley, and egg in a large bowl. Mix well until evenly combined; shape into 16 meatballs."
    },
    {
      "position": 3,
      "text": "Pour spaghetti sauce and crushed tomatoes into the slow cooker; stir in tomato puree. Place the meatballs into the sauce mixture."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 6 to 8 hours."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 20,

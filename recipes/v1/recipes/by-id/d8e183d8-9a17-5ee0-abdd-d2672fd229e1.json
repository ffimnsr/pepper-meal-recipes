  "id": "d8e183d8-9a17-5ee0-abdd-d2672fd229e1",
  "slug": "keema-indian-style-ground-meat",
  "name": "Keema (Indian-Style Ground Meat)",
  "recipe_type": "main",
  "brief_description": "This Indian recipe for ground lamb is saut\u00e9ed with onions and lots of masala, then served over rice or noodles for a quick, flavorful meal.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook lamb in a large, heavy skillet over medium heat until browned and crumbly, 5 to 7 minutes. Use a slotted spoon to transfer lamb to a bowl; drain off all but 1 tablespoon fat from the skillet."
    },
    {
      "position": 2,
      "text": "Add onion to the skillet and saut\u00e9 until soft and translucent, about 5 minutes. Stir in garlic and cook until fragrant, about 1 minute. Stir in garam masala and salt; cook for 1 minute. Return browned lamb to the pan with broth and tomato paste. Reduce the heat and simmer until lamb is fully cooked through and liquid has evaporated, 10 to 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "13ee0cb5-135a-52ee-98e5-3c5ef3e00a47",
  "slug": "crunchy-pumpkin-pie-granola",
  "name": "Crunchy Pumpkin Pie Granola",
  "recipe_type": "dessert",
  "brief_description": "A big bowl of granola is a great way to start your day. In this crunchy version, sweetened rolled oats and nuts are mixed with pumpkin pie spice, baked until crispy, and tossed with dried fruit.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 250 degrees F (120 degrees C). Coat 2 baking sheets with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, pumpkin pie spice, rolled oats, almonds, and pecans in a large bowl. Mix the applesauce, honey, and vanilla in a separate large bowl. Stir the oat mixture into the applesauce mixture, until granola begins to gather in clusters. Spoon granola evenly onto prepared baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven, stirring every 20 minutes, until lightly browned and crispy, about 1 hour."
    },
    {
      "position": 4,
      "text": "Remove from oven; cool to room temperature. Stir in raisins and cranberries; store in an airtight container."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

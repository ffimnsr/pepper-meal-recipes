  "id": "09da1679-d47e-5ac9-a4ed-314abe122f18",
  "slug": "sous-vide-lemon-butter-shrimp",
  "name": "Sous Vide Lemon-Butter Shrimp",
  "recipe_type": "main",
  "brief_description": "These tender and juicy sous vide shrimp are infused with the wonderful flavors of thyme, lemon, and Creole seasoning. They are so easy to make, they practically cook themselves!",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Set up a large pot or water bath and place your sous vide cooker into the water. Set temperature to 135 degrees F (57 degrees C) according to manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Combine shrimp and Creole seasoning in a bowl and toss to coat. Place shrimp in a single layer inside a large vacuum bag. Place lemon peel, thyme, and butter evenly on top. Seal the bag using a vacuum sealer."
    },
    {
      "position": 3,
      "text": "Place bag into the water and set timer for 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove cooked shrimp from bag and serve. Sprinkle additional Creole seasoning on top, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7c0c91ec-a26b-53f3-8ad2-72a896a8ce5a",
  "slug": "tuna-noodle-casserole-ii",
  "name": "Tuna Noodle Casserole II",
  "recipe_type": "soup",
  "brief_description": "Pasta combined with tuna, mushroom and celery soups; layered with American cheese, topped with crushed potato chips and baked until bubbly and slightly browned.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Boil pasta in lightly salted water for 10 minutes, or until al dente; drain well. Return the pasta to the pot it was cooked in."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 2 1/2 quart casserole dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Mix tuna with cream of mushroom soup, cream of celery soup, milk, salt, black pepper, and garlic in a medium saucepan. Place pan over medium low heat, and heat through. Alternatively, place these ingredients in a microwave safe dish, and warm in the microwave."
    },
    {
      "position": 4,
      "text": "Mix tuna mixture with pasta. Spread 1/2 of the noodles into the prepared dish. Arrange the cheese slices over the noodles, then spread the remaining noodle mixture over the cheese. Top with crushed potato chips."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, for 20 to 30 minutes; cook until the casserole is hot, and the chips begin to brown. Let cool for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

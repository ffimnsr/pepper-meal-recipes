{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e19185a4-4209-59d2-953b-39cebe3cd9ab",
  "slug": "boursin-chicken-baked-ziti-recipe-8733330",
  "name": "Boursin Chicken Baked Ziti",
  "recipe_type": "salad",
  "brief_description": "Ziti and chicken baked in a yummy Boursin sauce? Yes, please! Use leftover, cubed chicken and a cup of fresh, chopped spinach for this dish. We like this with hot garlic bread and a green salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) and grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine grated pecorino and breadcrumbs in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of salted water to a boil. Add ziti, and cook until tender with a bite, about 11 minutes. Drain; reserve about 2 tablespoons pasta water."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt butter in a large nonstick skillet over medium heat. Add chopped onion; cook and stir until onion begins to soften, 2 to 3 minutes. Stir in garlic, herb seasoning, and red pepper flakes, and cook about 30 seconds."
    },
    {
      "position": 5,
      "text": "Turn off heat. Stir in chicken, spinach, cream, Boursin, and mozzarella, stirring until cheeses are melted and ingredients are well combined."
    },
    {
      "position": 6,
      "text": "Stir drained ziti into chicken mixture. Loosen the sauce with reserved pasta water, if needed. Pour chicken and sauce mixture into the prepared baking dish. Sprinkle pecorino and bread crumb mixture over the top."
    },
    {
      "position": 7,
      "text": "Bake in the center of the preheated oven until bubbly and lightly browned, 20 to 30 minutes. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

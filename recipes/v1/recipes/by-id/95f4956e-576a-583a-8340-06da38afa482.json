  "id": "95f4956e-576a-583a-8340-06da38afa482",
  "slug": "million-dollar-ravioli-bake-recipe-11805482",
  "name": "Million Dollar Ravioli Bake",
  "recipe_type": "main",
  "brief_description": "This million dollar ravioli bake is made easier with frozen ravioli, prepared marinara, and pre-shredded cheese. This is the ultimate comfort food, very family-friendly.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a 9x13-inch baking dish with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Cook sausage in a large skillet over medium-high heat until browned, breaking up clumps with a spatula, about 10 minutes. Drain fat from the skillet. Stir in marinara sauce and set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine ricotta, softened cream cheese, sour cream, Parmesan cheese, Italian seasoning, and garlic powder. Add ravioli. Toss to coat."
    },
    {
      "position": 4,
      "text": "Spread ravioli in the bottom of the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Pour meat sauce over ravioli. Top with mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake uncovered in the preheated oven until bubbly, about 45 minutes. Allow to cool for 10 to 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

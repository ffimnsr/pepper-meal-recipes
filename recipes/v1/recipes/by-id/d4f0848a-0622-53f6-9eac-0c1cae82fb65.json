  "slug": "peanut-butter-freezer-fudge-2-ingredient",
  "name": "Peanut Butter Freezer Fudge (2-Ingredient)",
  "recipe_type": "dessert",
  "brief_description": "This quick, easy, 2-ingredient freezer fudge combines peanut butter and maple syrup for a yummy, sweet, salty, sink-your-teeth-in treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk peanut butter and maple syrup together in a bowl until combined. Pour onto a single sheet of parchment paper. Cover peanut butter mixture with the second sheet of parchment paper; flatten."
    },
    {
      "position": 2,
      "text": "Place flattened peanut butter mixture into the freezer until hardened, about 10 minutes."
    }
  ],
  "servings": 4,

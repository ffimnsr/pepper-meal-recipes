  "id": "38d9087a-d8ed-5622-8865-a2e61b892a96",
  "slug": "tuna-and-rice-casserole",
  "name": "Tuna and Rice Casserole",
  "recipe_type": "soup",
  "brief_description": "This tuna and rice casserole might look soupy going in the oven, but the dry rice will absorb all the extra liquid during the 90-minute bake, yielding flavorful and creamy results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 2-quart casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine milk, both soups, tuna, rice, celery, onion, bell pepper, garlic, oregano, parsley, black pepper, and salt in a large bowl and mix until well incorporated. Pour into the prepared dish and cover with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until rice is tender, about 1 hour and 30 minutes. Let cool slightly before serving, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

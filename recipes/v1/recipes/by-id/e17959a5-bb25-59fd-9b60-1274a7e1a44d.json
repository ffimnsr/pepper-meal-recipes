{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e17959a5-bb25-59fd-9b60-1274a7e1a44d",
  "slug": "italian-sausage-beans-and-greens-recipe-11881660",
  "name": "Italian Sausage, Beans, and Greens",
  "recipe_type": "dessert",
  "brief_description": "Chef John's sausage, beans, and greens dish is going to be your favorite Italian recipe that doesn't involve pasta. Savory sausage, earthy beans, bittersweet escarole, and just the right seasonings make this the best dish for a cold, windy wintry day.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Add olive oil to a large deep skillet or braising dish, and set over medium-high heat. Transfer in sausage and poke 3 or 4 times on both sides with the tip of a knife. Cook until sausage is browned and just cooked through, about 5 minutes per side. The heat can be reduced down to medium after the sausage is turned over if the pan is getting too hot. Remove sausage to a plate and let cool. Transfer to refrigerator until needed."
    },
    {
      "position": 2,
      "text": "Add diced onion and salt to the skillet, and cook, stirring, until onion turns translucent and starts to brown, about 5 minutes. Add black pepper, chili flakes, oregano, and garlic, and a couple tablespoons of olive oil if there's not already enough fat in the pan. Cook, stirring, for about 30 seconds to 1 minute; pour in broth. Raise heat to high and bring to a boil."
    },
    {
      "position": 3,
      "text": "Add beans, reduce heat to medium-high, and simmer, stirring occasionally, until liquid reduces by about half, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, cut escarole into 2-inch pieces. Wash in cold water and drain thoroughly."
    },
    {
      "position": 5,
      "text": "Slice sausage into 1/4-inch slices, and add to the pan. Reduce heat to medium and cook, stirring, for about 10 minutes. Raise heat to high and bring to a boil, then stir in greens."
    },
    {
      "position": 6,
      "text": "Cook, stirring. for about 3 to 10 minutes depending on how tender you want the greens. Reduce heat to medium-low and taste for seasoning. Adjust if needed."
    },
    {
      "position": 7,
      "text": "Garnish with freshly chopped Italian parsley, more chili flakes, and another drizzle of olive oil if desired. Use a microplane to zest some of the lemon over the dish, then cut lemon into wedges."
    },
    {
      "position": 8,
      "text": "Serve in bowls topped with freshly grated Parmesan and lemon wedges on the side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "4e278593-1f2f-5e43-9d65-3c317951bcf7",
  "slug": "easy-air-fryer-chicken-taquitos",
  "name": "Easy Air Fryer Chicken Taquitos",
  "recipe_type": "appetizer",
  "brief_description": "Easy chicken taquitos cooked in the air fryer. Serve with toppings of choice like salsa, pico de gallo, guacamole, or Greek yogurt.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Working with one tortilla at a time, place 2 tablespoons of shredded chicken on one end of the tortilla. Place 1 tablespoon shredded cheese on top of the chicken. Roll to form the taquito, starting at the filled side. Use 2 toothpicks to secure the taquito along the seam. Repeat with remaining ingredients."
    },
    {
      "position": 3,
      "text": "Open up the air fryer and spray the basket with cooking spray. Place 4 taquitos (toothpicks will be facing up) into the basket, making sure they're not touching, and spray the tops with more cooking spray."
    },
    {
      "position": 4,
      "text": "Air-fry until the taquitos are brown and crispy to your liking, 5 to 6 minutes. Repeat with remaining taquitos. Remove toothpicks before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "3f8101e6-7564-5572-9b8d-26e7c95f6dbe",
  "slug": "salisbury-steak-meatballs-recipe-11844152",
  "name": "Salisbury Steak Meatballs",
  "recipe_type": "main",
  "brief_description": "This Salisbury steak meatballs are easy to make and pack a lot of flavor. Simmered in mushroom gravy, they come out soft and delicate without falling apart. Serve over mashed potatoes or rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine the ground beef, panko bread crumbs, onion, egg, 1 tablespoon ketchup, 1 1/2 teaspoons Worcestershire sauce, mustard powder, salt, and pepper in a large bowl. Mix until just combined."
    },
    {
      "position": 3,
      "text": "Shape mixture into 20 (1 1/2-inch) meatballs."
    },
    {
      "position": 4,
      "text": "Add olive oil to a large skillet and heat over medium-high heat. Cooking in batches, add half the meatballs to the skillet and brown on all sides, about 5 minutes. Meatballs will not be fully cooked. Remove the meatballs from the skillet; set aside."
    },
    {
      "position": 5,
      "text": "Reduce heat to medium and add butter to the skillet. Once melted, add mushrooms and cook until golden brown. Add flour to the mushrooms and cook for 1 minute. Slowly whisk in beef stock, the remaining 2 teaspoons Worcestershire sauce, and 2 teaspoons ketchup. Bring mixture to a simmer, whisking constantly, until thickened, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Return meatballs to the skillet. Spoon gravy over meatballs. Cover and cook until heated through and meatballs are done (160 degrees F or 72 degrees C), about 5 minutes."
    },
    {
      "position": 7,
      "text": "Top the meatballs with chopped parsley and serve with mashed potatoes. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "a27eb33b-0bb1-5d8a-84b2-48df9ead7012",
  "slug": "super-delicious-zuppa-toscana",
  "name": "Super-Delicious Zuppa Toscana",
  "recipe_type": "soup",
  "brief_description": "Zuppa Toscana made with sausage, potatoes, cream, spinach, and red pepper flakes. Tastes just like the one at your local Italian chain restaurant.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook Italian sausage and red pepper flakes in a Dutch oven over medium-high heat until crumbly, browned, and no longer pink, 10 to 15 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Cook bacon in the same Dutch oven over medium heat until crisp, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Drain, leaving a few tablespoons of drippings with the bacon in the bottom of the Dutch oven. Stir in onions and garlic; cook until onions are soft and translucent, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in chicken broth and bring to a boil over high heat."
    },
    {
      "position": 6,
      "text": "Add potatoes and simmer until fork tender, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Reduce heat to medium; stir in cream, cooked sausage, and spinach."
    },
    {
      "position": 8,
      "text": "Cook and stir until spinach has wilted and sausage is warmed through; serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

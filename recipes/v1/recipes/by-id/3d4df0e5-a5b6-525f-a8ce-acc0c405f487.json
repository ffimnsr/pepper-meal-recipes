{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3d4df0e5-a5b6-525f-a8ce-acc0c405f487",
  "slug": "new-mexico-green-chile-breakfast-burritos",
  "name": "New Mexico Green Chile Breakfast Burritos",
  "recipe_type": "breakfast",
  "brief_description": "A hearty recipe for a style of breakfast burrito found in every eatery, taco stand, and gas station around Santa Fe, made with the famous green chiles from Hatch, New Mexico.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Place shredded potatoes in a bowl, cover with water, and set aside."
    },
    {
      "position": 2,
      "text": "Bring onion, garlic, green chiles, and chicken broth to a boil in a saucepan over high heat. Reduce heat to low and simmer until the sauce thickens; turn off the heat."
    },
    {
      "position": 3,
      "text": "Meanwhile, place bacon strips in a single layer on paper towels on a microwave-safe plate. Microwave on High until crisp, checking frequently after 5 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Drain the potatoes and add them to the skillet. Sprinkle with onion powder, salt, and pepper. Cook, stirring occasionally, until the potatoes are cooked through and crispy bits form, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Place tortillas between two damp paper towels. Microwave on High until warm, about 30 seconds."
    },
    {
      "position": 6,
      "text": "Spray a separate skillet with butter-flavored cooking spray. Cook and stir the eggs over medium heat until completely set; turn off the heat."
    },
    {
      "position": 7,
      "text": "Lay a tortilla flat on a work surface. Place some potatoes, scrambled eggs, and 2 strips bacon on the lower third, leaving about 1 inch at the bottom and about 1 1/2 inches on each side. Spoon a little green chile sauce over the filling and sprinkle with Cheddar cheese."
    },
    {
      "position": 8,
      "text": "Fold the left and right sides of the tortilla over the filling. Fold the bottom edge over the filling and tuck it in tightly. Continue rolling into a tight cylinder and place seam-side down. Repeat with the remaining ingredients. Serve immediately, with additional green chile sauce if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

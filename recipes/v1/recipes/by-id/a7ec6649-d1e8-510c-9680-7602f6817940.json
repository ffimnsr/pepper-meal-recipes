  "id": "a7ec6649-d1e8-510c-9680-7602f6817940",
  "slug": "grandpas-easy-vegan-gingerbread-cookies",
  "name": "Grandpa's Easy Vegan Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "Perfect for the holidays or any special occasion, these vegan gingerbread cookies look like something you'd buy in a bakery!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine molasses, brown sugar, and shortening in a large bowl; beat with an electric mixer until smooth and creamy. Add cold water and blend until smooth. (Shortening may separate a bit; this is fine.)"
    },
    {
      "position": 2,
      "text": "Sift together flour, baking soda, cinnamon, cloves, allspice, ginger, and salt in a separate bowl. Add flour mixture to molasses mixture, blending until incorporated and dough is soft. Shape dough into 2 balls and place in the refrigerator until chilled, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 4,
      "text": "Working in batches, place one ball of chilled dough on a lightly floured surface and roll to 1/4-inch thickness, or 1/2-inch thickness for softer cookies. Cut out cookies with desired cookie cutters and place 1 inch apart on the prepared baking sheet. Repeat with remaining dough."
    },
    {
      "position": 5,
      "text": "Bake cookies in the preheated oven until edges are firm, 12 to 13 minutes. Transfer to a wire rack immediately after baking to cool. Allow to cool completely if frosting."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

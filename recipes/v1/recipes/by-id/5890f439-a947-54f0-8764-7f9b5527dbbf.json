  "schema_version": 1,
  "id": "5890f439-a947-54f0-8764-7f9b5527dbbf",
  "slug": "cinnamon-rolls-ii",
  "name": "Pat's Homemade Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "These homemade cinnamon rolls can be made the night before and baked in the morning for a moist and decadently rich breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Warm 1 cup of milk in a small saucepan until it just starts to bubble, then remove from heat. Add \u00bd cup of butter and stir until melted. Add water and let cool until lukewarm."
    },
    {
      "position": 2,
      "text": "Place lukewarm milk mixture, yeast, white sugar, salt, eggs, and 2 cups flour in a large bowl; stir well to combine. Stir in the remaining flour, 1/2 cup at a time, mixing well after each addition."
    },
    {
      "position": 3,
      "text": "When the dough has pulled together, turn it out onto a lightly floured surface and knead until smooth and elastic, about 8 minutes."
    },
    {
      "position": 4,
      "text": "Divide dough into two equal pieces. Using a floured rolling pin, roll each piece into a 12x9-inch rectangle."
    },
    {
      "position": 5,
      "text": "Stir cinnamon and brown sugar together in a bowl. Spread each piece of rolled dough with \u00bc cup butter and half of the cinnamon sugar mixture."
    },
    {
      "position": 6,
      "text": "Roll up dough, using a little water to seal the seam."
    },
    {
      "position": 7,
      "text": "Cut each roll into 12 slices using a very sharp knife. Arrange rolls cut-side down onto two 9x13-inch greased baking pans. Cover with greased plastic wrap and let rise in a warm place until doubled in volume, about 1 hour."
    },
    {
      "position": 8,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 9,
      "text": "Bake cinnamon rolls in preheated oven until golden brown, 20 to 25 minutes."
    },
    {
      "position": 10,
      "text": "Meanwhile, make the frosting: Beat confectioners sugar, softened cream cheese, 1 tablespoon softened butter, and vanilla together in a bowl. Add milk gradually until frosting reaches a spreading consistency."
    },
    {
      "position": 11,
      "text": "Spread frosting over warm (but not hot) cinnamon rolls."
    },
    {
      "position": 12,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 24,

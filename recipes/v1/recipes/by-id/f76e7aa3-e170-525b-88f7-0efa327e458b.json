{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f76e7aa3-e170-525b-88f7-0efa327e458b",
  "slug": "cheeseburger-garbage-bread-recipe-8553117",
  "name": "Cheeseburger Garbage Bread",
  "recipe_type": "appetizer",
  "brief_description": "This cheeseburger garbage bread is absolutely perfect for when you\u2019re having a party. All the elements of a bacon cheeseburger, right down to the dill pickle, are rolled in thin pizza dough, baked until golden brown, and sliced into gorgeous spirals.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon over medium heat in a nonstick skillet until crisp, about 5 minutes. Drain bacon on a paper towel-lined plate; set aside. Do not wipe out the pan."
    },
    {
      "position": 2,
      "text": "Add onions and pinch of salt to the pan with the bacon grease, and turn heat to medium-high. Saut\u00e9 until onions soften up and start to take on golden-brown color, 3 to 4 minutes. Add beef; cook, breaking up the meat with a spatula up into small crumbles, until browned, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir salt, freshly ground black pepper, cayenne, and Worcestershire sauce into the beef; continue to cook until beef is browned and any liquid in the pan has evaporated."
    },
    {
      "position": 4,
      "text": "Turn off the heat. Stir in reserved bacon, 2 tablespoons ketchup, 1 tablespoon mustard, and 1/2 the shredded Cheddar cheese. Let mixture cool to room temperature before using, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 6,
      "text": "Using only as much flour as needed, press, roll and stretch pizza dough out into a 10x15-inch rectangle."
    },
    {
      "position": 7,
      "text": "Transfer meat mixture onto dough, leaving 1 1/2 inches of dough uncovered on both short sides, as well as the long edge closest to you. Leave about 2 1/2 inches uncovered on the opposite edge."
    },
    {
      "position": 8,
      "text": "Scatter dill pickle and green onions over beef, and then top evenly with remaining cheese. Brush a little water along the long edge of dough, where the roll will finish."
    },
    {
      "position": 9,
      "text": "Fold the dough from each side over the filling, and then begin rolling up from the bottom. As you roll, make sure the dough on each end stays sealed and holds in filling. When the roll is almost complete, stretch the edge of the dough and complete rolling with the seam on the bottom."
    },
    {
      "position": 10,
      "text": "Transfer roll to the prepared sheet pan. Brush with melted butter or a beaten egg, and sprinkle with sesame seeds."
    },
    {
      "position": 11,
      "text": "Bake in the preheated oven until well browned, and fat from the beef has started to leak out from the bottom or ends of the roll, about 35 minutes."
    },
    {
      "position": 12,
      "text": "Meanwhile for \u201cSecret Sauce\u201d, whisk mayonnaise, 3 tablespoons ketchup, 2 tablespoons mustard, 2 tablespoons dill pickle, and 1 tablespoon sliced green onions together in a small bowl."
    },
    {
      "position": 13,
      "text": "Transfer to a cooling rack, and let rest 20 to 30 minutes before serving. Serve with \u201cSecret Sauce.\u201d"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 20,

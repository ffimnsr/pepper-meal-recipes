  "id": "b9c9868a-c2bd-5cc6-b784-e424bdd31876",
  "slug": "pistachio-pesto-pasta-with-shrimp-recipe-8789185",
  "name": "Pistachio Pesto Pasta with Shrimp",
  "recipe_type": "side",
  "brief_description": "This pistachio pesto pasta with shrimp begins with a basil-pistachio pesto\u2014you are likely familiar with pesto made with pine nuts, but pesto is very flexible, and you can use almost any nut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For pesto, place a skillet over medium-high heat, and toast pistachios until fragrant, tossing frequently, about 1 minute. Remove pistachios to a plate to cool completely, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Combine pistachios, basil, Parmesan cheese, olive oil, and garlic in a blender or food processor and pur\u00e9e until smooth. Season to taste with salt and lemon juice."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook fusilli in the boiling water, stirring occasionally, until tender yet firm to the bite, 10 to 12 minutes. Reserve 1 tablespoon pasta water; drain."
    },
    {
      "position": 4,
      "text": "Gently stir 1/4 cup pesto into pasta with a slotted spoon."
    },
    {
      "position": 5,
      "text": "Add shrimp, garlic powder, salt, and black pepper to a bowl. Toss to thoroughly coat shrimp in seasonings."
    },
    {
      "position": 6,
      "text": "Heat a large skillet over medium heat. Add butter; once melted, add shrimp to the skillet in a single even layer. Cook shrimp on one side until seared, 2 to 3 minutes. Flip shrimp and cook until shrimp is seared, pink, and opaque, 2 to 3 minutes more."
    },
    {
      "position": 7,
      "text": "Add shrimp to pasta. Add reserved pasta water if needed to thin sauce, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

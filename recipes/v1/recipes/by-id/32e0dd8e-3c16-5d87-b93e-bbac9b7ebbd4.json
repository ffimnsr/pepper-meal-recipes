  "schema_version": 1,
  "id": "32e0dd8e-3c16-5d87-b93e-bbac9b7ebbd4",
  "slug": "cajun-spiced-chicken-fettuccine-recipe-11947404",
  "name": "Cajun-Spiced Chicken Fettuccine",
  "recipe_type": "main",
  "brief_description": "This Cajun-spiced chicken fettuccine combines smoky sausage, tender chicken, and bold Cajun flavors in a satisfying pasta dinner inspired by jambalaya.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil for 1 minute less than specified on the package, about 7 minutes. Set aside; do not rinse. Reserve 1 cup of pasta water."
    },
    {
      "position": 2,
      "text": "Meanwhile, season chicken with 1 tablespoon Cajun spice; set aside. Mix the sausage, bell pepper, onion, garlic, salt, and pepper together in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Bring a large skillet or wok to medium-high heat. Add oil and let heat."
    },
    {
      "position": 4,
      "text": "Add chicken to the skillet first and cook, stirring frequently, until no longer looking pink, about 5 minutes. Add sausage mixture and cook, stirring frequently, until sausage starts to brown and vegetables begin to soften, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Pour in chicken stock, pizza sauce, and remaining 1 tablespoon Cajun seasoning. Cook and stir until well combined, 1 to 2 minutes. Add cooked fettuccine to the skillet, and using tongs, toss it all together. If the sauce is too thick, add in a few tablespoons of the reserved pasta water at a time until the sauce is at your desired thickness."
    },
    {
      "position": 6,
      "text": "Serve in large wide bowls or plates. Garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a23256da-61b0-57b8-afa1-3927ebd59733",
  "slug": "baked-oatmeal-ii",
  "name": "Baked Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "This baked oatmeal recipe features nutritious oats and milk flavored with cinnamon and cranberries, baked until golden on top for a comforting breakfast.",
  "cuisine": "Pennsylvania Dutch American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together oats, brown sugar, cinnamon, baking powder, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Beat in eggs, milk, melted butter, and vanilla extract. Stir in dried cranberries."
    },
    {
      "position": 4,
      "text": "Spread into a 9x13-inch baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is golden, about 40 minutes. Remove from the oven and let cool for a few minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

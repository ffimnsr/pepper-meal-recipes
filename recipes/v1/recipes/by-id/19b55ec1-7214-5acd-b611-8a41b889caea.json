  "id": "19b55ec1-7214-5acd-b611-8a41b889caea",
  "slug": "low-fat-chicken-pot-pie",
  "name": "Low-Fat Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This low-fat chicken pot pie features tender chicken, potatoes, celery, onion, and mixed veggies in a savory sauce, baked in a deep-dish pie shell.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts into a pot. Fill with just enough water to cover, then add garlic powder, salt, and pepper. Bring to a boil, then remove from the heat, cover, and let cool in the pot."
    },
    {
      "position": 2,
      "text": "Meanwhile, place potatoes into a large pot and cover with salted water; bring to a boil. Reduce the heat to medium-low and simmer until almost fork-tender, about 15 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Heat oil in a large heavy skillet over medium heat; add onion and celery and saut\u00e9 for 5 to 8 minutes. Add frozen vegetables and cook for 5 minutes. Stir in flour and cook for about 30 seconds. Add chicken broth and bring to a boil. Cook until broth has thickened, then add potatoes."
    },
    {
      "position": 5,
      "text": "Remove cooled chicken from the pot. Discard bones and cut meat into bite-sized pieces. Add meat to vegetable mixture and season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Press one pie pastry into a pie pan. Pour in chicken and vegetable mixture, then cover with remaining pie pastry. Crimp pie pastry edges together so no juices spill in the oven."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until pie shell is cooked and golden brown, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

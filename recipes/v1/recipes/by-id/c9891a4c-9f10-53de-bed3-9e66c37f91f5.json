  "id": "c9891a4c-9f10-53de-bed3-9e66c37f91f5",
  "slug": "hot-artichoke-dip-with-green-chiles",
  "name": "Hot Artichoke Dip with Green Chiles",
  "recipe_type": "appetizer",
  "brief_description": "Green chile peppers and garlic spice up this easy and delicious hot dip. It's great to serve while your guests are enjoying wine and waiting on the main course. It goes very well with tortilla chips.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix the creamy salad dressing, garlic, Parmesan cheese, green chile peppers and artichoke hearts."
    },
    {
      "position": 3,
      "text": "Transfer the mixture to a small baking dish. Bake uncovered in the preheated oven 30 minutes, or until bubbly and lightly brown. Garnish with green onions and tomato."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 30,

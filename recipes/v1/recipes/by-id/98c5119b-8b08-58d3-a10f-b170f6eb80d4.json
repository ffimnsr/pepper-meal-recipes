  "id": "98c5119b-8b08-58d3-a10f-b170f6eb80d4",
  "slug": "shrimp-and-sausage-and-chicken-gumbo",
  "name": "Shrimp, Sausage, and Chicken Gumbo",
  "recipe_type": "soup",
  "brief_description": "This hearty Indiana gumbo with chicken, Italian sausage, and shrimp is a great cold weather meal.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir flour in a large, heavy pot over medium-low heat until flour turns golden brown, about 15 minutes. Pour browned flour into a bowl and return pot to heat."
    },
    {
      "position": 2,
      "text": "Increase heat to medium and add oil to the pot. Cook and stir onions and bell peppers in hot oil until slightly softened, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir garlic, thyme, and bay leaves into onion mixture; cook and stir for 1 minute. Add sausage to onion mixture and cook and stir until browned and crumbly, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir diced tomatoes with juice, shredded chicken, chicken broth, vegetable juice cocktail, browned flour, and Creole seasoning into sausage mixture. Bring to a boil, reduce heat to low, cover the pot, and simmer, stirring often, until mixture is hot and flavors blend, 20 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Pour shrimp into sausage-chicken mixture; bring to a simmer. Cook shrimp until they are pink on the outside and the meat is no longer transparent in the center, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Discard bay leaves. Season gumbo with salt and pepper to taste."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

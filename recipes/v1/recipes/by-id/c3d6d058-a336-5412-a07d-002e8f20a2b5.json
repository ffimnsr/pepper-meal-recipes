  "id": "c3d6d058-a336-5412-a07d-002e8f20a2b5",
  "slug": "honey-lime-vinaigrette",
  "name": "Honey-Lime Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This lime vinaigrette gets zing from lime juice, sweetness from honey, and spicy notes from mustard and cumin. A refreshing dressing on any salad!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Blend lime juice, honey, sugar, mustard, garlic powder, salt, black pepper, and cumin together in a blender; stream olive oil and canola oil into lime juice mixture while blending until well combined."
    }
  ],
  "servings": 8,

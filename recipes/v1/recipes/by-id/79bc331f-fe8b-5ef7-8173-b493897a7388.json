  "id": "79bc331f-fe8b-5ef7-8173-b493897a7388",
  "slug": "old-fashioned-brown-gravy",
  "name": "Old Fashioned Brown Gravy",
  "recipe_type": "side",
  "brief_description": "Homemade brown gravy is more delicious than store-bought and easily made on the stove with pan drippings from roast beef, pork, chicken, or turkey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Immediately after removing roasted meat from its pan, drain off drippings, reserving 2 tablespoons in the pan."
    },
    {
      "position": 2,
      "text": "Sprinkle flour over drippings; cook and stir over medium heat until brown. Gradually stir in milk, whisking with a fork to scrape up all of the meaty bits from the pan, then gradually whisk in water."
    },
    {
      "position": 3,
      "text": "Increase heat to medium-high; cook, stirring constantly, until gravy thickens, about 10 minutes. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

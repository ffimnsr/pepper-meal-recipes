  "id": "c7c25297-2c37-5be4-83cd-81b4150f644c",
  "slug": "air-fryer-ravioli",
  "name": "Air Fryer Ravioli",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer ravioli make a deliciously crisp, cheesy appetizer or snack; dip them in marinara sauce for a savory treat without the guilt!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) according to manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Beat egg and water together in a small bowl. Combine bread crumbs and Pecorino Romano cheese on a plate. Dip 1 ravioli into beaten egg mixture, then into bread crumb mixture, pressing to coat. Place breaded ravioli on a plate and repeat with remaining ravioli. Lightly spray ravioli with cooking spray."
    },
    {
      "position": 3,
      "text": "Place as many ravioli in the air fryer basket as you can without overlapping them."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 6 minutes; flip ravioli using tongs and cook for 4 minutes more. Remove from the air fryer and repeat with remaining ravioli. Serve with your favorite marinara sauce for dipping."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

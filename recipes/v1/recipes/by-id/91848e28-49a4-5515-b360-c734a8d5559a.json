  "id": "91848e28-49a4-5515-b360-c734a8d5559a",
  "slug": "crunchy-baked-caramel-corn",
  "name": "Crunchy Baked Caramel Corn",
  "recipe_type": "dessert",
  "brief_description": "Your relatives won't be able to resist this on this sticky, crunchy snack: baked caramel corn made from with a tried-and-true family recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over medium-high heat. Put 4 popcorn kernels into the oil and cover until popped; add remaining kernels to the saucepan in an even layer. Cover and remove from heat, about 30 seconds. Return to heat and gently shake pan back and forth over the burner until popping slows to several seconds between pops, 1 to 2 minutes. Remove from heat and transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, butter, corn syrup, and salt in a 2-quart saucepan. Bring to a boil, stirring constantly. Let boil for 5 minutes more without stirring. Remove from heat and stir in vanilla extract and baking soda. Stir well. Pour over the popcorn; mix until evenly coated. Transfer to a shallow oven-safe pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, stirring every 15 minutes, until a cooled piece of popcorn is crunchy, about 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 72,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

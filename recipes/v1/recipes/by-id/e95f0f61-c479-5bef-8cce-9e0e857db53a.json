{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e95f0f61-c479-5bef-8cce-9e0e857db53a",
  "slug": "triple-seared-whiskey-burger-recipe-8668974",
  "name": "Triple Seared Whiskey Burger",
  "recipe_type": "main",
  "brief_description": "Chef John's extraordinarily delicious burger uses the same technique as his Japanese-style triple seared steak, producing a juicy burger with a beautifully glazed exterior.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Wet your hands, and form 2 (8-ounce) burgers; place on a plate, cover, and refrigerate until ready to grill. For this process, cold meat works best."
    },
    {
      "position": 2,
      "text": "Before starting the triple-searing process, build a very hot hardwood charcoal fire. Oak, mesquite or hickory are great choices. The coals should be glowing red, and radiating extreme heat before the meat hits the grill."
    },
    {
      "position": 3,
      "text": "Rub burgers all over with oil. Coat with sea salt until entire surface area is completely covered."
    },
    {
      "position": 4,
      "text": "Pour whiskey into a shallow bowl; set aside."
    },
    {
      "position": 5,
      "text": "Place burgers on hottest spot on the grill, and sear both sides, 2 minutes per side."
    },
    {
      "position": 6,
      "text": "Transfer burgers into bowl of whiskey, and turn constantly for at least 1 minute. Most of the salt will rinse off."
    },
    {
      "position": 7,
      "text": "Place burgers back onto the hottest spot on the grill, and sear both sides again, 2 minutes per side. You can baste steak with a small amount of whiskey while searing."
    },
    {
      "position": 8,
      "text": "Add soy sauce to another shallow bowl. Add burgers to the bowl, and turn constantly for at least 1 minute."
    },
    {
      "position": 9,
      "text": "Return burgers to the hottest spot on the grill for the 3rd and final sear. Grill each side until desired doneness is reached, about 2 minutes. For a rosy-pink (medium-rare) inside, remove when an instant-read thermometer inserted near the center reads 125 to 130 F (52 to 54 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,
  "difficulty": "medium",

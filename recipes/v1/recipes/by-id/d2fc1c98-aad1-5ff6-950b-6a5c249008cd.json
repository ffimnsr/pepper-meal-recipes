  "id": "d2fc1c98-aad1-5ff6-950b-6a5c249008cd",
  "slug": "chocolate-almond-macaroons",
  "name": "Chocolate-Almond Macaroon Cookies",
  "recipe_type": "dessert",
  "brief_description": "These chewy macaroon cookies, made with ground almonds and chocolate, add a new twist to an old favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line cookie sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Finely grind the almonds, sugar, cinnamon, and salt in a food processor."
    },
    {
      "position": 3,
      "text": "Separate one of the eggs and add the white, the other egg, and almond extract, and process until the mixture holds together. Transfer to a bowl and stir in the chocolate."
    },
    {
      "position": 4,
      "text": "Moisten hands and roll mixture into 1-inch balls. Place on prepared cookie sheet. Flatten to 1/3-inch thick rounds."
    },
    {
      "position": 5,
      "text": "Bake until tops puff and centers are still soft, about 12 minutes. Remove to a rack and cool completely. Replace parchment paper for next round of cookies."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

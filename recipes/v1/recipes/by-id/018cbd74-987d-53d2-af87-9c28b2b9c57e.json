  "id": "018cbd74-987d-53d2-af87-9c28b2b9c57e",
  "slug": "slow-cooker-steel-cut-oats",
  "name": "Slow Cooker Steel-Cut Oats",
  "recipe_type": "breakfast",
  "brief_description": "These slow cooker oats are simmered with water, milk, oats, apple, brown sugar, butter, and cinnamon for a delicious and easy make-ahead breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, milk, oats, apple, brown sugar, butter, cinnamon, and salt in a slow cooker; mix well."
    },
    {
      "position": 2,
      "text": "Cook on Low for 1 hour. Reduce heat to Simmer or Warm and cook for 7 to 8 more hours."
    }
  ],
  "servings": 4,

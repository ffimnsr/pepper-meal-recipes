  "id": "e68ce75f-d9fb-51ac-bb67-7ade22aa3168",
  "slug": "grandaddys-sweet-potato-meringue-pie",
  "name": "Grandaddy's Sweet Potato Meringue Pie",
  "recipe_type": "dessert",
  "brief_description": "A smooth, creamy sweet potato pie gets a topping of fluffy baked meringue in this vintage recipe.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place the sweet potatoes into a large pot and cover with water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and allow to steam dry for a minute or two. Transfer the sweet potatoes into a mixing bowl, and allow to cool for about 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9-inch pie dish with unbaked pie crust."
    },
    {
      "position": 3,
      "text": "Mash the sweet potatoes smoothly, and mix in butter, 3/4 cup of sugar, salt, milk, egg yolks, cinnamon, and vanilla extract. Pour the filling into the pie crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the filling is set and the pie crust is beginning to brown, 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Place the egg whites into a clean mixing bowl, and beat until stiff with an electric mixer set on medium, 3 to 5 minutes. Beat in 1/4 cup sugar and 1/2 teaspoon of vanilla extract, until the mixture holds firm peaks and is glossy. Remove the pie from the oven and spoon meringue over the sweet potato filling, swirling the meringue into attractive peaks. Return to oven, and bake until the meringue turns golden brown, about 10 minutes, watching carefully to avoid burning. Allow to cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

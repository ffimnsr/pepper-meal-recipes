  "id": "8df468b3-d401-542b-8f16-f449c1f3d37b",
  "slug": "corn-and-avocado-salsa",
  "name": "Corn and Avocado Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This easy salsa combines corn, avocado, onion, and bell pepper to make a quick, yummy tortilla chip dip or a tasty topping for grilled chicken or steak.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Place the corn in a large pot with enough water to cover, and bring to a boil. Cook until kernels are tender but crisp, about 5 minutes. Drain, and cool in cold water. Use a knife to cut kernels from the cobs."
    },
    {
      "position": 2,
      "text": "Place kernels in a medium bowl. Stir in avocados, red onion, bell pepper, vinegar, cilantro, lime juice, olive oil, garlic, cumin, and crushed red pepper flakes. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

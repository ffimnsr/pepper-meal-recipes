  "id": "7df53b78-668f-5631-b4d8-cfa0fe040472",
  "slug": "air-fryer-keto-pork-chops",
  "name": "Air Fryer Keto Pork Chops",
  "recipe_type": "main",
  "brief_description": "This air fryer recipe for keto pork chops guarantees crisp, tasty, tender pork chops every time. Perfect for a last-minute dinner with minimal cleanup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg in a medium bowl. Mix Parmesan cheese, almond flour, salt, pepper, and garlic powder together in a second bowl."
    },
    {
      "position": 2,
      "text": "Season pork chops with salt and pepper on both sides. Dip each pork chop into egg, then into Parmesan-flour mixture to coat. Place into the air fryer basket and spritz with cooking spray."
    },
    {
      "position": 3,
      "text": "Cook in the air fryer at 375 degrees F (190 degrees C) until lightly browned, 8 to 10 minutes. Flip pork chops, spritz with cooking spray, and cook until pork is no longer pink in the center, 3 to 4 minutes more. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

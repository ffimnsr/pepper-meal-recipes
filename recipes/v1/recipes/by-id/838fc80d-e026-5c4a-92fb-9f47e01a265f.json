  "slug": "pretzel-crust",
  "name": "Pretzel Crust",
  "recipe_type": "dessert",
  "brief_description": "Pretzel crust adds a salty and crunchy element to any pie. This makes a 9x13-inch pie crust, but may be modified to use in a 9-inch pie dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together margarine, sugar, and pretzels. Press the mixture into a 9x13-inch baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes; fill with desired pie filling."
    }
  ],

  "id": "897b7e65-00ef-5f62-8f7b-2301e826831a",
  "slug": "pumpkin-banana-oat-muffins",
  "name": "Pumpkin Banana Oat Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This healthy pumpkin banana oat muffin recipe combines oats, pumpkin, and banana with autumn spices and Greek yogurt for a grab-and-go snack or breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk all-purpose flour, oat flour, baking soda, baking powder, salt, cinnamon, ginger, nutmeg, and cloves together in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat butter, brown sugar, and white sugar together in a separate bowl with an electric mixer on low speed until moistened; beat in yogurt, eggs, and vanilla extract on medium speed. Beat in pumpkin pur\u00e9e and mashed bananas: fold in \u00bd cup chocolate chips and \u00bd cup pecans. Stir flour mixture into batter. Set aside."
    },
    {
      "position": 4,
      "text": "Combine granola, \u00be cup chocolate chips, and \u00bd cup pecans in a bowl."
    },
    {
      "position": 5,
      "text": "Divide batter among the prepared muffin cups, filling each \u2154 full; sprinkle with granola topping."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 25 to 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

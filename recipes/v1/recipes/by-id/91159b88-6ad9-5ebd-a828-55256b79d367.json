  "id": "91159b88-6ad9-5ebd-a828-55256b79d367",
  "slug": "mexican-style-cornbread",
  "name": "Mexican-Style Cornbread",
  "recipe_type": "main",
  "brief_description": "This Mexican cornbread made with creamed corn, cheese, onion, and jalape\u00f1o peppers is delicious. A melted Cheddar crust tops makes it irresistible!",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square pan or a cast iron skillet."
    },
    {
      "position": 3,
      "text": "Beat eggs in a small bowl; mix in buttermilk and corn oil. Stir in 1 cup shredded cheese, creamed corn, onion, and jalape\u00f1os."
    },
    {
      "position": 4,
      "text": "Whisk cornmeal, flour, baking powder, baking soda, and salt together in a large bowl; stir in egg mixture until combined."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan; sprinkle remaining 1/2 cup cheese on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top is golden brown and a toothpick inserted in the center comes out clean, about 30 to 35 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

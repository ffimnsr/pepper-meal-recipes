  "id": "fa7b6b41-9b37-596f-801f-52126283f075",
  "slug": "chicken-taco-dump-dinner-recipe-8761615",
  "name": "Chicken Taco Dump Dinner",
  "recipe_type": "main",
  "brief_description": "This easy chicken taco dump casserole, with shredded chicken, black beans, and salsa, layered with corn tortillas and cheese, is sure to please the whole family.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Combine salsa, green chiles, chili powder, cumin, and salt in a large bowl. Stir in chicken, black beans, and corn."
    },
    {
      "position": 4,
      "text": "Place half of tortilla pieces in the bottom of the prepared dish. Top with half of chicken mixture and 1 cup cheese. Repeat layers of tortilla pieces and chicken mixture."
    },
    {
      "position": 5,
      "text": "Cover the dish with aluminum foil. Bake in the preheated oven for 35 minutes."
    },
    {
      "position": 6,
      "text": "Remove the foil and sprinkle with remaining 2 cups cheese. Continue to bake until heated through and cheese is melted and just starting to brown, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Top each serving with desired taco toppings."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

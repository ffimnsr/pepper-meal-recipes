  "id": "18b9735a-c0ae-5aa7-8774-4e0b34b74b82",
  "slug": "quinoa-and-black-beans",
  "name": "Quinoa and Black Beans",
  "recipe_type": "side",
  "brief_description": "This quinoa recipe features a combination of garlicky quinoa with black beans, corn, cumin, and cilantro for a flavorsome vegan main or tasty side.",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until lightly browned, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix quinoa into onion mixture and cover with vegetable broth; season with cumin, cayenne pepper, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Bring to a boil; cover, reduce heat, and simmer until quinoa is tender and broth is absorbed, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Stir in frozen corn and continue to simmer until heated through, about 5 minutes. Mix in black beans and cilantro."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

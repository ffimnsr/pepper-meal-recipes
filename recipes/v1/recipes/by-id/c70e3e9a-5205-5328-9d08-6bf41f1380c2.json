  "id": "c70e3e9a-5205-5328-9d08-6bf41f1380c2",
  "slug": "spinach-dip",
  "name": "Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "Red pepper, onion, and cumin make this spinach dip nippy and colorful. Sour cream and mayonnaise make it creamy and dippable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Squeeze water out of the spinach; place spinach into a mixing bowl. Add onion, bell pepper, and garlic; stir in sour cream, mayonnaise, and cumin. Season to taste with salt."
    },
    {
      "position": 2,
      "text": "Let the dip stand at room temp for 30 minutes for the flavors to mix; stir again before serving."
    }
  ],

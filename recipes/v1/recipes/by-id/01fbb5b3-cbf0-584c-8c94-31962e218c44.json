  "slug": "slow-cooker-reuben-dip",
  "name": "Slow Cooker Reuben Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Reuben dip combines corned beef, sauerkraut, and loads of cheese in a slow cooker until deliciously creamy and warm. Perfect for potlucks.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sauerkraut, cream cheese, Swiss cheese, corned beef, and Thousand Island dressing in a slow cooker; cover, and cook on high until hot, stirring occasionally while cooking, about 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,

  "id": "4533550c-1652-54bd-a077-702a270a1a5c",
  "slug": "spanish-style-french-toast-torrijas-recipe-8735953",
  "name": "Spanish-Style French Toast (Torrijas)",
  "recipe_type": "breakfast",
  "brief_description": "Spanish-style French toast, or torrijas, is basically French toast, bread pudding, and creme brulee all rolled into one, and Chef John's version is nothing short of magical.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, white sugar, salt, orange zest, lemon zest, cinnamon, cloves, and vanilla in a saucepan, whisk, and bring to a simmer over medium-heat. Reduce heat to medium-low and simmer gently for 5 minutes."
    },
    {
      "position": 2,
      "text": "Strain milk through a mesh strainer and transfer 2 cups into a shallow dish in which to soak stale bread; set aside."
    },
    {
      "position": 3,
      "text": "Transfer remaining 2 cups infused milk into a saucepan to make the custard sauce; add yolks and whisk thoroughly. Return saucepan to medium-low heat, and cook, stirring with a spatula and scraping the bottom constantly, until the mixture gets hot and thickens enough to coat the back of a spoon. Remove from heat; immediately pour through a fine mesh strainer. Let cool and refrigerate until needed."
    },
    {
      "position": 4,
      "text": "Soak stale bread in milk, turning a few times, until most of milk is absorbed and bread is saturated. Remove to a pan or plate and refrigerate until needed."
    },
    {
      "position": 5,
      "text": "Beat whole eggs in a wide shallow bowl. Coat bread on both sides in the egg."
    },
    {
      "position": 6,
      "text": "Pour olive oil, 1/4 to 1/2 inch deep into a nonstick skillet, and heat over medium heat. Fry soaked bread in the hot oil until browned and puffed, about 4 minutes per side. When fully cooked, the bread will spring back when touched in the center."
    },
    {
      "position": 7,
      "text": "Remove to a plate. Top each slice with 1 tablespoon turbinado sugar. Use a blowtorch with a low flame to br\u00fbl\u00e9e the surface. Serve immediately with custard sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

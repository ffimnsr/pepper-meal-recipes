  "id": "fa263e0a-ed75-519a-8f0d-ba42ade9bbd9",
  "slug": "classic-tuna-noodle-casserole",
  "name": "Classic Tuna Noodle Casserole",
  "recipe_type": "soup",
  "brief_description": "This classic tuna noodle casserole features tender pasta, peas, and pimentos in a creamy condensed soup sauce with a buttery bread crumb topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together noodles, tuna, condensed soup, peas, milk, and pimentos in a 1 1/2-quart baking dish until well combined."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, mix together bread crumbs and melted butter in a small bowl until combined."
    },
    {
      "position": 5,
      "text": "Sprinkle bread crumb mixture over the top of casserole. Continue baking until topping is golden brown, about 5 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

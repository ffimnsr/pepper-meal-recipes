  "id": "d317338b-9c4e-5b9e-b52e-57f1f4e1bac8",
  "slug": "pan-seared-red-snapper",
  "name": "Pan-Seared Red Snapper",
  "recipe_type": "main",
  "brief_description": "Learn how to cook red snapper fillets with this quick and easy recipe that features pan-seared fish served with a tangy honey, mustard, ginger sauce.",
  "cuisine": "World American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together green onions, lemon juice, vinegar, olive oil, honey, mustard, and ginger in a shallow bowl; set aside."
    },
    {
      "position": 3,
      "text": "Rinse snapper under cold water and pat dry with paper towels."
    },
    {
      "position": 4,
      "text": "Heat a large nonstick skillet over medium heat. Dip snapper into marinade to coat both sides."
    },
    {
      "position": 5,
      "text": "Cook snapper in the hot skillet until opaque and lightly browned, 2 to 3 minutes per side."
    },
    {
      "position": 6,
      "text": "Pour remaining marinade into the skillet. Reduce heat and simmer until fish flakes easily with a fork, 2 to 3 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

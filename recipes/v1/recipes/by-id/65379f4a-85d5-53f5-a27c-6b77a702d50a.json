  "id": "65379f4a-85d5-53f5-a27c-6b77a702d50a",
  "slug": "shrimp-quesadillas-with-cilantro-and-lime",
  "name": "Shrimp Quesadillas with Cilantro and Lime",
  "recipe_type": "snack",
  "brief_description": "Fresh cilantro and lime impart Mexican-inspired flavor to these quick and easy shrimp quesadillas that are perfect for lunch, dinner, or a snack!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine roasted red peppers, cilantro, lime juice, and chili powder in a shallow dish. Toss chopped shrimp in the lime mixture. Chill in the refrigerator."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a skillet over medium heat and add olive oil. Saute onion in the hot oil until tender and translucent, about 5 minutes. Add shrimp and lime mixture and saute until shrimp are pink and cooked through, about 3 minutes. Remove mixture from the skillet."
    },
    {
      "position": 3,
      "text": "Assemble quesadillas by placing shrimp mixture and Mexican cheese in between 2 tortillas."
    },
    {
      "position": 4,
      "text": "Heat tortillas in the skillet over medium-low heat until cheese is melted and tortillas are crispy, 3 to 4 minutes. Cut quesadillas into bite-sized segments and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

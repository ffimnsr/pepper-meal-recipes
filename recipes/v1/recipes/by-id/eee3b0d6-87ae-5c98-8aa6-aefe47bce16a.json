  "id": "eee3b0d6-87ae-5c98-8aa6-aefe47bce16a",
  "slug": "shrimp-egg-foo-young",
  "name": "Shrimp Egg Foo Young",
  "recipe_type": "main",
  "brief_description": "This egg foo young recipe makes golden egg patties with shrimp, bean sprouts, and green onions, plus a special Chinese restaurant sauce to spoon on top!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Mix bean sprouts, shrimp, eggs, green onions, and garlic powder together in a large bowl until well combined."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add about 1/2 cup of egg mixture into the skillet to make a patty. Repeat to add more egg patties to the skillet. Working in batches, fry patties until golden brown, about 4 minutes per side."
    },
    {
      "position": 3,
      "text": "Meanwhile, to make the sauce: Whisk chicken broth, cornstarch, sugar, cooking wine, and soy sauce together in a saucepan over medium-low heat; simmer until sauce thickens, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Spoon sauce over egg patties."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

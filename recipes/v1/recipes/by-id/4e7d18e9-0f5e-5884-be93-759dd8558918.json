  "id": "4e7d18e9-0f5e-5884-be93-759dd8558918",
  "slug": "deviled-potato-bites-recipe-8734075",
  "name": "Deviled Potato Bites",
  "recipe_type": "appetizer",
  "brief_description": "These potato-based bites have all the flavors of a deviled egg, making them an ideal (and easy to make) appetizer for holiday parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Take a cake pan that\u2019ll fit into a large pot or a wide, deep skillet. Line the cake pan with a piece of baking paper (cut a square of baking paper that\u2019s a little larger than the cake pan, scrunch it up, unscrunch it and press into the pan). Carefully separate the eggs to make sure the yolks don\u2019t break. Set yolks into the cake pan (save whites for another use)."
    },
    {
      "position": 3,
      "text": "Place a steaming rack into the bottom of a large pot or wide skillet and add a few inches of water. Set cake pan on top of the steaming rack. Bring to a simmer over medium-low heat, cover, and steam until yolks are cooked through, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Tip cooked yolks into a bowl and allow to cool. Add mayonnaise, mustard, lemon juice, and a pinch of salt; mash with a fork to break up the yolks."
    },
    {
      "position": 5,
      "text": "Use a stick blender to blitz the mixture until smooth and season with Tabasco to taste. If mixture is too thick, add \u00bd to 1 tablespoon water and blitz again until desired consistency is reached."
    },
    {
      "position": 6,
      "text": "Chill yolk mixture in the fridge until needed."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). While oven preheats, place hash brown patties onto a baking sheet and soften in the oven for 5 to 10 minutes. Don't allow patties to get crispy\u2014you only want them to soften."
    },
    {
      "position": 8,
      "text": "Remove hash brown patties from the oven and, once cool enough to handle, break into thirds. Press each third into the well of a mini muffin pan."
    },
    {
      "position": 9,
      "text": "Push your thumb into the hash brown cups to give them each a little dip."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until golden and crispy, 25 to 30 minutes."
    },
    {
      "position": 11,
      "text": "Transfer hash brown bottoms to a wire rack to cool slightly before piping (or spooning) on chilled egg yolk mixture."
    },
    {
      "position": 12,
      "text": "Garnish with chives, smoked paprika, and a little pinch of flaky salt then serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "3b9d7afc-bc31-5efa-bc6e-5f89e16a0a52",
  "slug": "cabbage-roll-skillet",
  "name": "Cabbage Roll Skillet",
  "recipe_type": "main",
  "brief_description": "This skillet dinner of cabbage, rice, ground beef, and onions delivers the taste of cabbage rolls without all the work.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Season beef with salt and pepper; cook and stir in the hot skillet until browned, about 5 minutes. Add onion and garlic; cook until onion is translucent, 2 to 3 minutes. Add tomato sauce, beef broth, brown sugar, lemon juice, and Worcestershire sauce. Stir until well mixed."
    },
    {
      "position": 2,
      "text": "Add cabbage to the skillet and bring to a simmer. Cover and let simmer until cabbage is tender, about 20 minutes. Serve over rice with a little sour cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

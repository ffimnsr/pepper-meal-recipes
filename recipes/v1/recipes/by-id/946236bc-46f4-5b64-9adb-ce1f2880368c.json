  "id": "946236bc-46f4-5b64-9adb-ce1f2880368c",
  "slug": "the-best-lemon-pepper-wings-recipe-11868292",
  "name": "The Best Lemon Pepper Wings",
  "recipe_type": "appetizer",
  "brief_description": "These fried lemon pepper wings are tossed in a sweet and tangy lemon-butter sauce and are simply the best.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a Dutch oven over medium high heat to 360 to 370 degrees F (182 to 188 degrees C)."
    },
    {
      "position": 2,
      "text": "Meanwhile, dry wings thoroughly by patting them with a paper towel and place on a wire rack set inside a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Whisk flour, cornstarch, garlic powder, onion powder, 1/4 teaspoon cayenne, paprika, 2 teaspoons salt, and 1 teaspoon lemon pepper together in a large shallow dish until well combined."
    },
    {
      "position": 4,
      "text": "Working in batches, toss dried wings in flour mixture and shake off any excess flour mixture so there is only a thin coating of flour mixture on each wing. Return wings to wire rack."
    },
    {
      "position": 5,
      "text": "Working in batches, fry wings, while trying to maintain an oil temperature of 350 degrees F (180 degrees C) for about 12 minutes, tossing occasionally until cooked through, browned and crispy. Set wings on a clean wire rack set inside a rimmed baking sheet to drain."
    },
    {
      "position": 6,
      "text": "Combine remaining cayenne pepper, salt, and lemon pepper with butter, lemon zest, lemon juice, and honey in a small saucepan over medium heat and cook, stirring occasionally, until melted and well combined. Toss wings in lemon butter sauce and serve immediately."
    },
    {
      "position": 7,
      "text": "Sprinkle with more lemon pepper if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

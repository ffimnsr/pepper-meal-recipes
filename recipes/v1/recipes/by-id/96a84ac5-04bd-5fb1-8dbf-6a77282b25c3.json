  "id": "96a84ac5-04bd-5fb1-8dbf-6a77282b25c3",
  "slug": "cast-iron-skillet-vegetable-frittata",
  "name": "Cast Iron Skillet Vegetable Frittata",
  "recipe_type": "breakfast",
  "brief_description": "A variety of fresh vegetables join seasonings and mozzarella cheese in this quick breakfast frittata that's easily prepared in a cast iron skillet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a cast iron skillet over medium to medium-low heat. Add 2 tablespoons bacon grease. Stir in broccoli, onion, bell pepper, olives, garlic, oregano, basil, salt, and pepper and cook until vegetables are tender, 7 to 10 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Beat eggs in a bowl using a fork. Add mozzarella cheese and cooked vegetable mixture and stir to combine."
    },
    {
      "position": 4,
      "text": "Reheat the skillet over low heat; add remaining bacon grease. Pour egg mixture into the skillet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm and slightly browned, 20 to 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b9bac87b-2662-5b98-a0c2-344831c9768c",
  "slug": "lasagna-alfredo",
  "name": "Lasagna Alfredo",
  "recipe_type": "main",
  "brief_description": "This chicken Alfredo lasagna features layers of noodles, ricotta, spinach, creamy white sauce, and mozzarella cheese for a family-favorite dinner.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook until tender yet firm to the bite, 8 to 10 minutes; drain."
    },
    {
      "position": 3,
      "text": "Place frozen spinach and 1/2 cup water in a 2-quart nonstick saucepan; bring to a boil. Reduce heat to medium-high, cover, and cook, stirring occasionally, until spinach is tender, 6 to 7 minutes. Drain and squeeze out any excess water."
    },
    {
      "position": 4,
      "text": "Stir together chicken and 1 jar Alfredo sauce in a medium bowl until well combined."
    },
    {
      "position": 5,
      "text": "Mix together ricotta and spinach in a second medium bowl until well combined."
    },
    {
      "position": 6,
      "text": "Arrange a single layer of lasagna noodles in a 9x13-inch baking dish, edges overlapping. Pour chicken-Alfredo mixture over noodles and spread evenly. Sprinkle with 1 cup mozzarella. Cover with another layer of noodles. Spread spinach mixture evenly over noodles. Pour 1/2 of the remaining jar of Alfredo sauce over spinach mixture and spread evenly. Sprinkle with 1 cup mozzarella. Lay on a final noodle layer and top with remaining 1/2 jar Alfredo sauce and 2 cups mozzarella. Season with salt and pepper."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the top is brown and bubbly, 50 to 60 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,

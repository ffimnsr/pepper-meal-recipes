  "id": "e65e14df-9ab2-5725-804d-dd956a4bdb27",
  "slug": "pecan-pie-cupcakes",
  "name": "Pecan Pie Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "If you like the taste of butter pecan, you will love these quick and easy pecan pie cupcakes that you can bake up for guests in less than half the time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners and coat liners with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, pecans, and flour in a large bowl; make a well in the center."
    },
    {
      "position": 3,
      "text": "Beat eggs in a large bowl with an electric mixer until foamy, 3 to 5 minutes. Fold in butter and vanilla. Pour into the center of the brown sugar mixture. Stir until batter is well mixed."
    },
    {
      "position": 4,
      "text": "Spoon batter into the muffin tin, filling each cup 2/3 of the way."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

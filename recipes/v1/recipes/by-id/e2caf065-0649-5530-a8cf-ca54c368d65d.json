  "id": "e2caf065-0649-5530-a8cf-ca54c368d65d",
  "slug": "avocado-and-black-bean-dip",
  "name": "Avocado and Black Bean Dip",
  "recipe_type": "appetizer",
  "brief_description": "Avocado and black beans are warmed with a Cheddar cheese topping for a colorful and fiber-filled dip. Serve with pita or tortilla chips.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix avocado, black beans, lime juice, and garlic together in a microwave-safe bowl. Sprinkle with Cheddar cheese."
    },
    {
      "position": 2,
      "text": "Microwave dip on high until cheese is melted, about 1 minute. Season with sea salt if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 1,

  "id": "20fa3363-8301-53af-8d84-c672891f434a",
  "slug": "loaded-tater-tot-casserole-recipe-8769287",
  "name": "Loaded Tater Tot Casserole",
  "recipe_type": "main",
  "brief_description": "This loaded tater tot casserole layers a sour cream and Cheddar sauce with tater tots and bacon. With more bacon on top, a dill cream topping, and a final sprinkle of green onions, it's incredibly tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (230 degrees C). Grease a 2-quart square baking dish."
    },
    {
      "position": 3,
      "text": "Cook bacon in a large skillet until crisp, about 8 minutes. Drain on paper towels. When cool enough to handle, crumble bacon. Drain all but 2 tablespoons bacon drippings from the skillet."
    },
    {
      "position": 4,
      "text": "Add onion to the skillet. Cook and stir until tender, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Add flour and cayenne pepper to skillet; cook and stir 1 minute."
    },
    {
      "position": 6,
      "text": "Add 2 cups milk to the skillet. Cook and stir until thickened and bubbly, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Gradually add 1 cup cheese to skillet, stirring until melted. Stir in half of green onions."
    },
    {
      "position": 8,
      "text": "Place 1/2 cup sour cream in a small bowl. Gradually whisk in about 1/2 cup of hot sauce mixture. Return mixture to the skillet. Return to a simmer."
    },
    {
      "position": 9,
      "text": "Add half of tots to the prepared baking dish. Top with half of sauce and half of bacon. Top with remaining tots, remaining sauce, remaining bacon, and remaining cheese."
    },
    {
      "position": 10,
      "text": "Bake until bubbly and cheese on top is lightly browned, 35 minutes."
    },
    {
      "position": 11,
      "text": "For dill cream, whisk together 1/4 cup sour cream, 1 tablespoon milk, and dill."
    },
    {
      "position": 12,
      "text": "Drizzle over the casserole and top with remaining green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,

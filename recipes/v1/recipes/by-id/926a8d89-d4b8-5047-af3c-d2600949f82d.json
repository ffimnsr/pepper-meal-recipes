  "id": "926a8d89-d4b8-5047-af3c-d2600949f82d",
  "slug": "rhubarb-snickerdoodles-recipe-8657530",
  "name": "Rhubarb Snickerdoodles",
  "recipe_type": "dessert",
  "brief_description": "These rhubarb snickerdoodles pair the buttery cinnamon flavor of snickerdoodles with the fruity tartness of rhubarb. These cookies have a lovely flavor and a nice chewy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rhubarb and 1 1/2 teaspoons sugar in a large bowl; toss to combine. Allow to sit for at least 30 minutes or until rhubarb begins to release its juices."
    },
    {
      "position": 2,
      "text": "Drain accumulated juice from rhubarb; discard juice. Add cornstarch to rhubarb and toss until thoroughly coated. Set aside."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment."
    },
    {
      "position": 4,
      "text": "Beat butter and 3/4 cup sugar together in a large bowl until fluffy, about 5 minutes. Add in egg and vanilla and beat for another 3 minutes. Add in flour, cream of tartar, baking soda, salt, and nutmeg and mix until just combined. Fold in rhubarb."
    },
    {
      "position": 5,
      "text": "In a small bowl, mix together 3 tablespoons sugar and cinnamon."
    },
    {
      "position": 6,
      "text": "Scoop out 1 1/2 tablespoons dough, roll into a ball, and roll ball in cinnamon sugar until thoroughly coated. Place dough balls 1 1/2 inches apart on the prepared baking sheets. Repeat with remaining dough."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven, one baking sheet at a time, until cookies are set and just beginning to turn golden, 15 to 20 minutes. Cool cookies on the pan for 5 minutes; remove to a wire rack to cool completely."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 30,
  "difficulty": "medium",

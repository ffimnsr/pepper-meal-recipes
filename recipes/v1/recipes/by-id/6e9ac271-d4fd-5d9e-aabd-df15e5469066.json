  "id": "6e9ac271-d4fd-5d9e-aabd-df15e5469066",
  "slug": "cock-a-leekie-soup",
  "name": "Cock-a-Leekie Soup",
  "recipe_type": "soup",
  "brief_description": "Scottish cock-a-leekie soup has many variations, but most of them feature leeks simmered in chicken stock. This version is thickened with barley.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken into a large pot; pour in water and add onion and barley. Bring to a boil over high heat, then reduce the heat to low and simmer for 1 hour."
    },
    {
      "position": 2,
      "text": "Use tongs to transfer chicken to a cutting board. Discard skin and bones; chop meat into bite-sized pieces and return to the pot."
    },
    {
      "position": 3,
      "text": "Add condensed broth, leeks, celery, parsley, salt, pepper, and thyme; simmer until vegetables are tender, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "6f0a7d26-4447-589b-a974-82fe7d24977d",
  "slug": "sweet-and-savory-candied-bacon-recipe-11960182",
  "name": "Sweet and Savory Candied Bacon",
  "recipe_type": "salad",
  "brief_description": "It's easy to make this sweet, savory candied bacon. A bit of brown sugar, a few spices, and a little time in the oven, and you'll have bacon that's great for breakfast, on a sandwich, or in a salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Arrange bacon in a single layer on a lightly greased wire rack set inside a foil or parchment paper lined baking sheet."
    },
    {
      "position": 2,
      "text": "Stir brown sugar, black pepper, cayenne, and crushed red pepper together in a small bowl and lightly pat the sugar mixture evenly over the bacon slices."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crisp and browned, 35 to 40 minutes. Let stand until cooled completely, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

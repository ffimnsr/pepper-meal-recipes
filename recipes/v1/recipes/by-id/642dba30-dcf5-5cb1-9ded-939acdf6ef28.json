  "id": "642dba30-dcf5-5cb1-9ded-939acdf6ef28",
  "slug": "coquito-de-puerto-rico",
  "name": "Coquito de Puerto Rico",
  "recipe_type": "drink",
  "brief_description": "This egg-free version of Coquito, a Puerto Rican coconut rum cocktail served at Christmas, is sure to be a hit at your next holiday party.",
  "cuisine": "Puerto Rican",
  "instructions": [
    {
      "position": 1,
      "text": "Place cream of coconut, condensed milk, evaporated milk, coconut rum, water, ice cream, and vanilla extract in a blender. Blend until smooth and well-combined, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour coconut mixture into two 20-ounce glass bottles or jars. Add 1 cinnamon stick and 1 clove to each container; shake well. Chill coquito 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Shake container before pouring coquito into shot glasses or small cups. Sprinkle cinnamon or nutmeg on top before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "f9118669-41a3-5d1d-9b86-2b755002cf1f",
  "slug": "tomato-olive-oil-cake-recipe-12057802",
  "name": "Tomato Olive Oil Cake",
  "recipe_type": "dessert",
  "brief_description": "This tomato olive oil cake is a simple olive oil cake with a rich creme fraiche whip, topped with lightly-sweetened, halved cherry tomatoes. Is is surprising? Yes. Delicious? Absolutely!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a 9-inch round cake pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine eggs, sugar, and lemon zest in a bowl and beat with an electric mixer until light and fluffy,1 to 2 minutes. Stream in olive oil with mixer running."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, baking soda, and salt in a small bowl. Alternate adding flour mixture and milk and beat until combined."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, 28 to 32 minutes. Remove from the oven and allow to cool completely, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, for mascarpone cream, combine mascarpone, heavy cream, and sugar in the bowl of a stand mixer. Whip until stiff peaks just start to form."
    },
    {
      "position": 6,
      "text": "Spread whipped cream on top of the cooled cake."
    },
    {
      "position": 7,
      "text": "Toss cherry tomatoes with sugar in a bowl and distribute on top of the cake. Drizzle with extra olive oil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

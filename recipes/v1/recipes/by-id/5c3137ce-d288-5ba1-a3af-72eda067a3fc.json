  "id": "5c3137ce-d288-5ba1-a3af-72eda067a3fc",
  "slug": "easy-carrot-cake",
  "name": "Easy Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "This recipe makes a fabulous and moist carrot cake. Try it for Thanksgiving instead of or in addition to pumpkin pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9 or 10 inch tube pan."
    },
    {
      "position": 2,
      "text": "Combine the sugar, flour, salt, cinnamon, soda, oil. With an electric mixer beat in the eggs one at a time. Stir in the carrots and the walnuts. Pour the batter into the prepared baking pan."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour 20 minutes. Note: this cake can be made in two 9 inch layer cake pans just change the baking time to 40 minutes."
    },
    {
      "position": 4,
      "text": "To Make Frosting: With an electric mixer blend the cream cheese and cream. Add the vanilla and confectioners' sugar. Frosting can be spread and a still warm cake."
    }
  ],
  "servings": 14,

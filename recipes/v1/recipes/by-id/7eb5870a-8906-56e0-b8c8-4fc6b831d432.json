  "id": "7eb5870a-8906-56e0-b8c8-4fc6b831d432",
  "slug": "saras-beef-jerky",
  "name": "Sara's Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "No smoker or dehydrator is required here. Thinly sliced sirloin or London broil steak is mixed with liquid smoke and seasonings, then baked at low temperature for 8 hours.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 200 degrees F (95 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium, nonporous bowl, combine the salt, liquid smoke, garlic powder, monosodium glutamate, onion powder, soy sauce, Worcestershire sauce and ground black pepper to taste."
    },
    {
      "position": 3,
      "text": "Place meat slices in this mixture and coat well. Then place the meat slices onto two 10x15 inch baking dishes in a single layer."
    },
    {
      "position": 4,
      "text": "Bake at 200 degrees F (95 degrees C) for 8 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

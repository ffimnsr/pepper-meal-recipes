  "id": "43c50ce9-5e12-5b80-9174-85735d588c09",
  "slug": "banana-slush-punch",
  "name": "Banana Slush Punch",
  "recipe_type": "drink",
  "brief_description": "In this easy banana punch recipe, three portions of banana citrus slush are frozen, then served with ginger ale for a fun party drink!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a blender, combine bananas, sugar, and 3 cups water. Blend until smooth. Pour into a large bowl and stir in pineapple juice. Blend in orange juice concentrate, lemonade concentrate, and 3 cups water. Divide into 3 plastic containers and freeze until solid, 4 hours to overnight."
    },
    {
      "position": 2,
      "text": "Remove from freezer 3 to 4 hours before serving. Using one portion at a time, place slush in a punch bowl and pour in 1 liter of ginger ale for each."
    }
  ],
  "servings": 54,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

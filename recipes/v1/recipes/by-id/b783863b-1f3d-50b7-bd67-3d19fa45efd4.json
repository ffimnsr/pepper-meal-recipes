  "id": "b783863b-1f3d-50b7-bd67-3d19fa45efd4",
  "slug": "southern-ham-and-brown-beans",
  "name": "Southern Ham and Brown Beans",
  "recipe_type": "soup",
  "brief_description": "This Southern pinto beans recipe turns a pound of dry pinto beans and a ham hock into a family-favorite meal that will be enjoyed by multiple generations.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine beans, ham hock, onion, garlic, and water in a large stockpot."
    },
    {
      "position": 3,
      "text": "Season with chili powder, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Bring to a boil, and cook for 2 minutes. Remove from the heat, cover, and let stand for 1 hour."
    },
    {
      "position": 5,
      "text": "After 1 hour, return the pot to the stovetop and return to a boil. Reduce the heat to medium-low and simmer until flavors have blended and broth has thickened, at least 3 hours, or up to 6 hours."
    },
    {
      "position": 6,
      "text": "During the last 15 minutes of simmering, transfer ham hock to a cutting board. Let sit until cool enough to handle, 5 to 10 minutes, then pull meat from the bone."
    },
    {
      "position": 7,
      "text": "Return meat to the stockpot and discard the bone. Adjust seasonings to taste."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 200,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

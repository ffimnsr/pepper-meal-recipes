  "id": "fa7d4932-f6ae-5aa5-9c53-bf648af97b0d",
  "slug": "roasted-duck",
  "name": "Roasted Duck",
  "recipe_type": "main",
  "brief_description": "This roasted duck recipe is coated with a simple, flavorful spice rub and basted with butter as it roasts in the oven until tender, juicy, and golden.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine paprika, salt, and pepper in a small bowl; rub spice mixture onto skin of duck. Place duck in a roasting pan, breast side up. Roast in the preheated oven for 1 hour."
    },
    {
      "position": 3,
      "text": "Spoon 1/4 cup butter over duck; continue roasting for 45 minutes."
    },
    {
      "position": 4,
      "text": "Spoon remaining 1/4 cup butter over duck; roast until golden brown, about 15 minutes more. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read at least 165 degrees F (74 degrees C),"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

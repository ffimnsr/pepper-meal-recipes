  "slug": "mini-pepperoni-pizza-cups-recipe-7644701",
  "name": "Mini Pepperoni Pizza Cups",
  "recipe_type": "appetizer",
  "brief_description": "These mini pepperoni cups that are easy to make with just 5 ingredients in 15 minutes have an amazing classic pepperoni pizza taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Using kitchen shears, snip four 1/2-inch cuts around the edges of each large pepperoni slice, leaving the center uncut."
    },
    {
      "position": 2,
      "text": "In a 24-count mini muffin pan, press each pepperoni down, followed by a crouton, a spoonful of pizza sauce, cheese, and mini pepperonis."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese melts, about 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

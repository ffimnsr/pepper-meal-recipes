  "id": "3e93edb3-8097-5ec7-aaf8-951f690d814b",
  "slug": "swamp-potatoes-and-sausage-recipe-11763852",
  "name": "Swamp Potatoes and Sausage",
  "recipe_type": "drink",
  "brief_description": "These swamp potatoes and sausage are so hearty, full of flavor and comforting. Highly recommended serving alongside crusty bread for soaking in the delicious juices.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Add potatoes and chopped onion to the bottom of a slow cooker. Drizzle with olive oil and season with salt, pepper, and Cajun seasoning. Toss to coat evenly."
    },
    {
      "position": 2,
      "text": "Layer the sliced smoked sausage and green beans on top. Sprinkle with onion soup mix and garlic powder. Place pieces of butter evenly over the top."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low until potatoes are tender and everything is well flavored, 6 to 7 hours, stirring a few times throughout the process and just before serving. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 15,

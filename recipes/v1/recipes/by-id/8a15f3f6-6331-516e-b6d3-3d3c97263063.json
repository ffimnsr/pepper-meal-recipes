  "schema_version": 1,
  "id": "8a15f3f6-6331-516e-b6d3-3d3c97263063",
  "slug": "one-pot-ginger-chicken-and-rice-recipe-11975341",
  "name": "One-Pot Ginger Chicken and Rice",
  "recipe_type": "salad",
  "brief_description": "This one-pot ginger chicken and rice is an easy, flavorful dinner that comes together in a single dish. While it finishes in the oven, you\u2019ll have time to toss a salad, warm some bread, and get the rest of the meal ready.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine coconut cream, lime zest, lime juice, garlic, brown sugar, fish sauce, soy sauce, grated ginger, and Sriracha sauce in a blender. Blend on high speed until mixture is completely smooth. Set ginger sauce aside."
    },
    {
      "position": 2,
      "text": "Pat chicken thighs dry with paper towels, and sprinkle both sides with 1 teaspoon salt."
    },
    {
      "position": 3,
      "text": "Heat oil in a Dutch oven over medium high heat. Carefully add chicken thighs in batches into the hot oil, making sure not to crowd the pan. Cook undisturbed until browned, 3 to 5 minutes. Turn chicken and brown the other side, 3 to 5 minutes. Remove to a plate, and repeat the process with any remaining chicken pieces."
    },
    {
      "position": 4,
      "text": "Add bell pepper and onion slices to the same Dutch oven and cook, stirring, about 3 minutes. Pour in chicken stock and stir up any browned bits from the bottom of the pan. Add rice and remaining salt, and stir to combine."
    },
    {
      "position": 5,
      "text": "Layer in carrots and petite green peas, and set browned chicken thighs on top. Drizzle 3/4 cup of the ginger sauce over the chicken pieces, and allow the liquid to come to a boil."
    },
    {
      "position": 6,
      "text": "Meanwhile, preheat the oven to 350 degrees F (180 degrees C) and set an oven rack in the center of the oven."
    },
    {
      "position": 7,
      "text": "Cover Dutch oven and transfer into the center of the preheated oven. Bake until chicken is no longer pink at the center and the juices run clear, about 25 minutes. An instant-read thermometer should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 8,
      "text": "Transfer Dutch oven onto a wire rack and allow to stand, covered, until the rice is completely tender but not mushy, about 10 minutes."
    },
    {
      "position": 9,
      "text": "Place chicken on a serving platter. Fluff the rice and vegetables with a fork, and stir in remaining ginger sauce and chopped cilantro. Garnish with thinly sliced green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "1d993007-100b-5476-a95f-80af21c0277b",
  "slug": "easy-peanut-butter-energy-balls",
  "name": "Easy Peanut Butter Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for peanut butter and oatmeal energy balls with chocolate chips and honey is just the ticket when you need a boost of energy during the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat oats, peanut butter, walnuts, chocolate chips, and honey in the bowl of a stand mixer fitted with the paddle attachment until well combined, adding more honey if mixture is not holding together."
    },
    {
      "position": 2,
      "text": "Scoop mixture with a cookie scoop and form into 24 balls; place on a cookie sheet. Refrigerate until firm, 30 to 60 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

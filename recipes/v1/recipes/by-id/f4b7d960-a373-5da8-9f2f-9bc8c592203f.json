  "schema_version": 1,
  "id": "f4b7d960-a373-5da8-9f2f-9bc8c592203f",
  "slug": "chicken-tortilla-soup-with-charred-corn-and-fire-roasted-tomatoes-recipe-11748641",
  "name": "Chicken Tortilla Soup with Charred Corn and Fire-Roasted Tomatoes",
  "recipe_type": "soup",
  "brief_description": "This chicken tortilla soup, flavored with charred corn and fire-roasted tomatoes, warmed by green chilis and chipotle, is served with toasted tortilla strips and grated cotija cheese.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven’s broiler and set a rack about 3 inches from the heat source."
    },
    {
      "position": 2,
      "text": "Place corn under the preheated broiler, directly on the oven rack. Broil, turning every 3 to 4 minutes. Watch carefully; allow some kernels to take on a deep brown color, but not become blackened. Remove to a plate to cool."
    },
    {
      "position": 3,
      "text": "Place tortillas on a sheet pan in a single layer and lightly mist with cooking spray. Place sheet pan in the middle of the oven and reduce heat to 400 degrees F (200 degrees C); toast until crisp, 10 to 15 minutes. Remove from the oven to cool."
    },
    {
      "position": 4,
      "text": "Use a serrated knife to remove kernels from cobs. Reserve kernels; discard cobs."
    },
    {
      "position": 5,
      "text": "Heat olive oil in a 4-quart saucepan over medium heat. When oil is hot, add bell pepper and chopped onions. Cook, stirring, until onions become translucent, 4 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Stir in cumin, chili powder, smoked paprika, and coriander, and cook about 1 minute. Add garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 7,
      "text": "Pour in chicken broth, and stir well. Add tomatoes and their liquid, green chilies, and chicken."
    },
    {
      "position": 8,
      "text": "Mince 1 chipotle pepper and add to the pot. Place any remaining chilies and adobo sauce in a freezer bag and freeze for a later use."
    },
    {
      "position": 9,
      "text": "Stir in zucchini and corn; bring to a boil, then reduce heat and simmer, uncovered, about 5 minutes. At this point, zucchini and corn will be somewhat firm; simmer longer if you prefer softer vegetables."
    },
    {
      "position": 10,
      "text": "Serve soup warm. Garnish servings tortilla strips, shredded Cotija cheese, fresh cilantro sprigs, and lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

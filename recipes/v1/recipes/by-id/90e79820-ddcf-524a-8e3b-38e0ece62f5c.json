  "id": "90e79820-ddcf-524a-8e3b-38e0ece62f5c",
  "slug": "grilled-pineapple",
  "name": "Grilled Pineapple",
  "recipe_type": "dessert",
  "brief_description": "This grilled pineapple is easy to make by marinating pineapple rings in melted butter and honey, then grilling until caramelized and full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place pineapple rings in a large resealable plastic bag. Add butter, honey, hot pepper sauce, and salt."
    },
    {
      "position": 3,
      "text": "Seal the bag and shake to coat evenly. Marinate for at least 30 minutes, or preferably overnight."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for high heat and lightly oil grate. Grill pineapple rings until heated through and grill marks appear, 2 to 3 minutes per side."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

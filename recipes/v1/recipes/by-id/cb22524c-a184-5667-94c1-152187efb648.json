  "slug": "guacamole-with-corn",
  "name": "Guacamole with Corn",
  "recipe_type": "appetizer",
  "brief_description": "This easy Mexican guacamole with corn and tomatoes tastes great with corn chips. As with all guacamole recipes, make sure you are using ripe avocados.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocados, lime juice, and salt together in a medium bowl. Mix in tomato, onion, serrano chile, and olive oil. Stir in corn kernels. Serve immediately."
    }
  ],
  "servings": 12,

  "slug": "easy-slow-cooker-chicken-fajitas",
  "name": "Easy Slow Cooker Chicken Fajitas",
  "recipe_type": "main",
  "brief_description": "This easy slow cooker chicken fajitas recipe is made with white meat, salsa, black beans, corn, and taco seasoning for a delicious, no-fuss meal.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken, corn, beans, salsa, and taco seasoning into a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low until chicken is tender and flavors have combined, about 8 hours."
    },
    {
      "position": 3,
      "text": "Shred chicken meat using 2 forks."
    }
  ],
  "servings": 4,

  "slug": "kale-and-pear-salad-with-sesame-ginger-dressing-recipe-8347902",
  "name": "Kale and Pear Salad with Sesame-Ginger Dressing",
  "recipe_type": "salad",
  "brief_description": "This kale salad with pear and a simple shake-together sesame-ginger dressing is the perfect partner for your favorite cold-weather mains.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Shake together canola oil, vinegar, toasted sesame oil, tamari, garlic, and ginger in a canning jar for the dressing."
    },
    {
      "position": 2,
      "text": "Put kale in a large bowl; pour dressing over kale, reserving 1 to 2 tsp. in jar. Massage kale until wilted, about 3 minutes. Add sesame seeds; toss. Top with pear and drizzle with reserved dressing."
    }
  ],
  "servings": 4,

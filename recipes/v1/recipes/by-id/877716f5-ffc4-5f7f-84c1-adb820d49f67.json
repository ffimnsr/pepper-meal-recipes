  "id": "877716f5-ffc4-5f7f-84c1-adb820d49f67",
  "slug": "easy-prime-rib-roast",
  "name": "Easy Prime Rib Roast",
  "recipe_type": "main",
  "brief_description": "This easy recipe for prime rib roast has plenty of flavor from a garlic rub and a soy sauce-based marinade.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix garlic, rosemary, sage, thyme, salt, and pepper together in a small bowl. Pat garlic mixture over entire roast. Make an incision down the middle of the roast, keeping parallel with the bones. Place the roast in a plastic roasting bag and pour Worcestershire sauce and soy sauce into the bag, concentrating on the incision in the roast. Tie the bag and refrigerate roast to marinate, turning often, at least 2 hours."
    },
    {
      "position": 2,
      "text": "Remove roast from refrigerator and allow to come to room temperature, 1 to 2 hours. Remove roast from bag and discard marinade. Place roast, fat-side up, in a roasting pan."
    },
    {
      "position": 3,
      "text": "Preheat an oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Lower heat to 350 degrees F (175 degrees C) and continue cooking until an internal temperature of 145 degrees F (65 degrees C), about 1 hour. Let roast stand for 20 minutes before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,

  "id": "e5ee43cc-816f-5777-9297-ee0f560c0045",
  "slug": "tangy-tomato-tuna-casserole",
  "name": "Tangy Tomato Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "This tangy tuna noodle casserole topped with buttery bread crumbs is a quick and easy weeknight meal and is perfect for Friday nights during Lent.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until cooked through but firm to the bite, 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 2 1/2-quart casserole dish."
    },
    {
      "position": 3,
      "text": "Mix macaroni, tomato sauce, tuna, cottage cheese, onion, cream cheese, sour cream, and salt together in the prepared casserole dish. Stir bread crumbs and butter together in a bowl; spread over tuna mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until casserole is cooked through and bubbling, 35 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

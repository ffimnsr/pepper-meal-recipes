  "id": "26974f1e-d5ea-52b0-bb4b-065225b479a4",
  "slug": "graham-moist-lemon-bars",
  "name": "Graham Moist Lemon Bars",
  "recipe_type": "soup",
  "brief_description": "When my brother about broke his teeth on the crust of some lemon bars, I thought I would try to make them chewier with graham cracker crumbs as the crust.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine graham cracker crumbs, softened butter or margarine, and 2 tablespoons sugar. Press mixture onto bottom of a greased 9 x 13 inch baking pan. Bake for 20 minutes."
    },
    {
      "position": 3,
      "text": "Beat eggs, sugar, flour, and lemon juice. (If mixture is too thick, water may be added to thin it.) Pour the mixture over the hot graham cracker crust. Bake for 25 minutes, or until golden brown."
    },
    {
      "position": 4,
      "text": "Dust the top with confectioners' sugar. After cooling, cut into squares."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

  "id": "b3cebdac-555c-5b4f-a700-03867221efad",
  "slug": "chayote-squash-side-dish",
  "name": "Chayote Squash Side Dish",
  "recipe_type": "side",
  "brief_description": "This chayote recipe features the plump, pear-shaped mirliton squash saut\u00e9ed with garlic, spices, and red wine vinegar for a tasty vegetable side dish.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a medium skillet over medium-high heat. Cook and stir squash, garlic, salt, sugar, red pepper flakes, and black pepper in hot oil for 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour in vinegar; cook and stir until squash is slightly wilted but still firm and crunchy, 2 to 3 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

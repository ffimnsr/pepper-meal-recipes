  "schema_version": 1,
  "id": "419b31a7-6ac9-58a5-8473-637f23f471a3",
  "slug": "chicken-makhani-indian-butter-chicken",
  "name": "Chicken Makhani (Indian Butter Chicken)",
  "recipe_type": "main",
  "brief_description": "This butter chicken recipe, or chicken makhani, is a favorite Indian dish that features a full-flavored sauce with spices that complement chicken.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a large saucepan over medium-high heat. Saut\u00e9 shallot and onion until soft and translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in butter, ginger-garlic paste, lemon juice, 1 teaspoon garam masala, chili powder, cumin, and bay leaf. Cook and stir for 1 minute. Add tomato sauce, and cook for 2 minutes, continuing to frequently stir."
    },
    {
      "position": 3,
      "text": "Stir in half-and-half and yogurt. Reduce heat to low, and simmer for 10 minutes, frequently stirring. Season with salt and pepper. Remove from heat and set aside."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon oil in a large heavy skillet over medium heat. Cook chicken until lightly browned, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Reduce heat, and season with remaining 1 teaspoon garam masala and cayenne. Stir in a few spoonfuls of sauce, and simmer until liquid has reduced, and chicken is no longer pink. Add cooked chicken into sauce and stir together."
    },
    {
      "position": 6,
      "text": "Dissolve cornstarch into water, then mix into the sauce. Cook for 5 to 10 minutes, or until thickened."
    },
    {
      "position": 7,
      "text": "Serve over rice with naan."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

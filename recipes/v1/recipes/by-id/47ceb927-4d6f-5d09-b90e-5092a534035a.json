  "slug": "vampiros-mexicanos-mexican-vampires",
  "name": "Vampiros Mexicanos (Mexican Vampires)",
  "recipe_type": "drink",
  "brief_description": "Vampiros Mexicanos is an authentic Mexican cocktail. It's easy to make by combining, in one glass, the best of Mexico: tequila and sangrita!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a highball glass with ice cubes."
    },
    {
      "position": 3,
      "text": "Pour in sangrita, tequila, citrus soda, lime juice, and chili-lime seasoning. Stir to mix well."
    }
  ],

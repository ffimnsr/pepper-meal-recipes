  "id": "f2c816bb-30a7-5641-a97d-ab41cc0e05d2",
  "slug": "air-fryer-polenta-fries",
  "name": "Air Fryer Polenta Fries",
  "recipe_type": "side",
  "brief_description": "These air-fried polenta fries made with tubed polenta are simple, crunchy, delicious, and addictive.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice polenta into long, thin slices resembling french fries."
    },
    {
      "position": 3,
      "text": "Spray the bottom of the basket with cooking spray. Place 1/2 of the polenta fries in the basket and lightly mist the tops with cooking spray. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 10 minutes. Flip the fries with a spatula and cook until crispy, about 5 minutes longer. Transfer fries to a paper towel-lined plate. Repeat with remaining half of fries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

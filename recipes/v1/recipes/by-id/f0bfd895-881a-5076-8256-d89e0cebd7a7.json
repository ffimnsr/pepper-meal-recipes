  "slug": "air-fryer-sauteed-onions-recipe-11721774",
  "name": "Air Fryer Sauteed Onions",
  "recipe_type": "side",
  "brief_description": "Air fryer sauteed onions add a lot to burgers, sandwiches, tacos, fajitas, or even on rice or mashed potatoes. They're great as a topping for steaks\u2014the possibilities are endless.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place onion petals and olive oil in a bowl; season with salt and pepper and toss to coat."
    },
    {
      "position": 3,
      "text": "Pour mixture into the basket of the air fryer. Cook 10 minutes. Shake the basket and cook 2 minutes more."
    }
  ],

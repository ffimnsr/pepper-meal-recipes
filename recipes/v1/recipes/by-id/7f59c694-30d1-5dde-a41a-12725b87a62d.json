  "id": "7f59c694-30d1-5dde-a41a-12725b87a62d",
  "slug": "crockpot-buffalo-chicken-mac-n-cheese-recipe-11773924",
  "name": "Crockpot Buffalo Chicken Mac N Cheese",
  "recipe_type": "main",
  "brief_description": "This crockpot Buffalo chicken mac 'n cheese is a nice, spicy twist on macaroni and cheese, and the addition of chicken makes it a full meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts in the bottom of a slow cooker. Sprinkle with ranch seasoning; pour in chicken bone broth and Buffalo sauce."
    },
    {
      "position": 2,
      "text": "Cover and cook until chicken is cooked through and tender, on High for 2 1/2 hours, or Low for 4 to 5 hours."
    },
    {
      "position": 3,
      "text": "Remove chicken and chop, then return to the slow cooker. Set slow cooker to High."
    },
    {
      "position": 4,
      "text": "Add uncooked pasta, cream cheese, cottage cheese, and 1 1/2 cups Cheddar cheese. Stir to combine and cover."
    },
    {
      "position": 5,
      "text": "Cook on High until pasta is tender with a bite and creamy, about 30 minutes. Stir and top with remaining cheese. Cover and let stand for 10 minutes before serving."
    },
    {
      "position": 6,
      "text": "Sprinkle with green onions and drizzle with more Buffalo sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 10,

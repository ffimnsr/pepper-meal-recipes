  "id": "53c4ef7a-45cc-5985-8dd9-6765ade00cb8",
  "slug": "strawberry-banana-chocolate-chip-baked-oatmeal-recipe-7372058",
  "name": "Strawberry Banana Chocolate Chip Baked Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "This baked oatmeal makes the perfect hands-off breakfast: just pop it into the oven! Made with strawberries, bananas, chocolate chips, and Almond Breeze Almondmilk, you can enjoy this right away or save it for the rest of the week!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x9 pan with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Mix together mashed banana, eggs, Almond Breeze Unsweetened Vanilla Almondmilk, coconut oil, and vanilla in a large bowl until mostly smooth. Add rolled oats, baking powder, cinnamon and salt until well combined. Gently fold in strawberries and chocolate chips."
    },
    {
      "position": 3,
      "text": "Pour mixture into prepared pan and bake until edges start to become slightly golden brown, 25 to 35 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3e4ab748-fe4d-5ce4-a57a-a402dced81b3",
  "slug": "plum-cobbler-for-two-recipe-8304143",
  "name": "Easy Plum Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This plum cobbler is made with juicy fresh plums, simmered under a biscuit-like dough until bubbling and delicious. Perfect for a late summer dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Halve and pit the plums, then slice or quarter, depending on size. Place fruit in a single layer in a baking dish. Drizzle lemon juice over fruit, add 2 tablespoons sugar, cornstarch, and vanilla extract, and toss to coat; set aside."
    },
    {
      "position": 3,
      "text": "Add flour, 2 tablespoons sugar, baking powder, and salt to a bowl, and mix until well combined. Cut butter into small cubes, and mash into the flour mixture using a fork or pastry cutter until crumbly. Stir in boiling water to form a dough. Use your fingers or drop small spoonfuls of the dough on top of the plums."
    },
    {
      "position": 4,
      "text": "Bake until a toothpick inserted into cobbler dough comes out clean and top is lightly browned, 25 to 30 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

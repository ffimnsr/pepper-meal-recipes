  "id": "9a7c54de-9b0b-5648-8a54-31da9741ff6b",
  "slug": "brandy-pecan-pie",
  "name": "Brandy Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This is the one pie that I always required my mom to make for the holidays. I would always want to cut into it right when it came out of the oven, but I would have to wait until after dinner! It is worth the wait!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, beat eggs together with half-and-half. Mix in sugar, flour, salt, molasses, corn syrup, vanilla, and brandy. Stir in pecans. Pour into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 40 to 50 minutes, or until done."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,

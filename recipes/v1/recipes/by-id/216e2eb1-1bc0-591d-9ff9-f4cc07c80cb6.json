{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "216e2eb1-1bc0-591d-9ff9-f4cc07c80cb6",
  "slug": "bumbleberry-pie-ii",
  "name": "Bumbleberry Pie II",
  "recipe_type": "dessert",
  "brief_description": "I've made these fruit pies for years. They always get great results and reviews. They're not too sweet and the fresh fruit flavor really shines through!",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "For the dough: Combine flour and salt in a large bowl. Cut in shortening until mixture resembles coarse crumbs. Whisk water, egg, and vinegar together in a medium bowl. Stir into flour until mixture forms a ball."
    },
    {
      "position": 3,
      "text": "Divide dough into 4 equal balls. Wrap in plastic and refrigerate for 4 hours or overnight. Roll out dough to fit two 9-inch pie pans. Place bottom crusts in 2 pie pans. Roll out and set aside top crusts."
    },
    {
      "position": 4,
      "text": "For the filling: Combine apples, rhubarb, strawberries, blueberries, raspberries, and lemon juice in a large bowl. Combine sugar, flour, and tapioca in a medium bowl. Gently toss with fruit mixture."
    },
    {
      "position": 5,
      "text": "Divide fruit mixture into 2 prepared pastry-lined pie pans. Cover with top crusts. Trim and crimp edges. Whisk together egg yolk and water in a small bowl. Brush tops of pies with egg wash. Cut a few slits in pie tops to allow steam to vent."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 50 to 60 minutes, or until filling is bubbly in center and top is golden brown."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "dabaffa7-77de-57b4-80f9-815f2cb9ad74",
  "slug": "cowboy-quiche-recipe-8775349",
  "name": "Cowboy Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This cowboy quiche checks all the boxes\u2014it\u2019s extra special with caramelized onions, bacon, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C )."
    },
    {
      "position": 2,
      "text": "Prick crust bottom and sides with a fork. Place crust on a rimmed baking sheet. Bake crust in the preheated oven for 5 minutes. Set aside. Leave oven on."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a skillet over medium-low heat; add onions, and saute until deep golden brown, about 20 minutes. Season with salt and cayenne. Line a small bowl with a paper towel, then add onions to cool and drain."
    },
    {
      "position": 4,
      "text": "In the same skillet, cook bacon until just cooked, but not yet crisp. Drain on a plate lined with paper towels. Crumble when cool enough to handle. Set aside."
    },
    {
      "position": 5,
      "text": "Whisk eggs and cream together in a bowl. Season with salt, black pepper, and cayenne pepper."
    },
    {
      "position": 6,
      "text": "Sprinkle onions into the bottom of crust, then cover with crumbled bacon. Scatter Cheddar cheese evenly over the top. Pour egg mixture into the pie shell."
    },
    {
      "position": 7,
      "text": "Bake quiche in the preheated oven on the rimmed baking sheet until a sharp knife inserted near the center comes out clean, 30 to 45 minutes. Check for doneness at 30 minutes. If crust is getting too brown, lightly cover the dish with foil. Let cool for 10 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

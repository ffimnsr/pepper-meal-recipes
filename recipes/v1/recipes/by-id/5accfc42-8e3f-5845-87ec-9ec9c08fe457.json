  "id": "5accfc42-8e3f-5845-87ec-9ec9c08fe457",
  "slug": "minced-pork-and-watermelon-lettuce-wraps",
  "name": "Minced Pork and Watermelon Lettuce Wraps",
  "recipe_type": "appetizer",
  "brief_description": "This minced pork and watermelon lettuce wraps recipe stir-fries ground pork with aromatics and veggies, then folds in watermelon for a tasty filling.",
  "cuisine": "Asian Thai Chinese Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, nonstick skillet over high heat. Add onion, garlic, and ginger; cook and stir until fragrant, about 1 minute. Add pork; cook until brown, 7 to 10 minutes. Drain excess liquid from the skillet. Reduce the heat to medium."
    },
    {
      "position": 2,
      "text": "Add celery and carrot to the skillet; cook and stir until soft, 2 to 3 minutes. Stir in green onions and soy sauce. Off heat, stir in pine nuts and hoisin sauce; fold in watermelon."
    },
    {
      "position": 3,
      "text": "Spoon pork mixture into lettuce leaves; wrap to cover filling. Serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

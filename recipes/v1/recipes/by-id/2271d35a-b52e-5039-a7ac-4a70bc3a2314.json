  "id": "2271d35a-b52e-5039-a7ac-4a70bc3a2314",
  "slug": "baked-ziti-ii",
  "name": "Easy Baked Ziti",
  "recipe_type": "main",
  "brief_description": "This baked ziti with ricotta recipe cooks ziti pasta in a creamy spaghetti sauce with two other Italian cheeses \u2014 mozzarella and Parmesan.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add ziti pasta and cook for 8 to 10 minutes or until al dente; drain and rinse."
    },
    {
      "position": 3,
      "text": "Combine cooked ziti, ricotta cheese, mozzarella cheese, egg, and 1 \u00bd cups spaghetti sauce in a medium bowl."
    },
    {
      "position": 4,
      "text": "Transfer into the prepared baking dish. Top with remaining spaghetti sauce, then sprinkle with Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes; let stand for 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

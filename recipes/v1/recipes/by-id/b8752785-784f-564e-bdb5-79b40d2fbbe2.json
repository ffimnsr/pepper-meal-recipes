  "id": "b8752785-784f-564e-bdb5-79b40d2fbbe2",
  "slug": "amys-lavender-lemonade",
  "name": "Amy's Lavender Lemonade",
  "recipe_type": "drink",
  "brief_description": "Amy's lavender lemonade recipe makes a refreshing, any-time drink. A glass of this soothing beverage is sure to help you unwind after a tough day.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Place lavender in a medium heat-proof bowl; add boiling water and steep about 10 minutes."
    },
    {
      "position": 2,
      "text": "Strain lavender water into a large heat-proof bowl; discard lavender. Stir sugar into lavender water until dissolved. Pour lavender syrup into a large pitcher filled with ice."
    },
    {
      "position": 3,
      "text": "Squeeze lemon juice into pitcher; top off with cold water. Taste; adjust sugar and lemon. Pour into tall glasses and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

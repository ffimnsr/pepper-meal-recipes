  "id": "f51e516f-4901-5965-9d40-47aaa409cd9e",
  "slug": "onion-gravy-for-british-bangers-and-mash",
  "name": "Onion Gravy for British Bangers and Mash",
  "recipe_type": "soup",
  "brief_description": "This tasty onion gravy is made from scratch with caramelized onions, broth, and red wine; perfect with mashed potatoes and your favorite bangers.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a heavy-bottomed pan over medium heat. Add onion; cook and stir until softened, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low; cover, and cook until onions are caramelized, stirring occasionally, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Stir in flour until well mixed."
    },
    {
      "position": 5,
      "text": "Stir in chicken stock, red wine, Dijon mustard, and Worcestershire sauce; simmer until sauce is thickened, stirring frequently, about 15 minutes. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "413cd10f-27c0-5874-93a9-cfb8f871aa91",
  "slug": "chorizo-stuffed-bell-peppers",
  "name": "Chorizo Stuffed Bell Peppers",
  "recipe_type": "main",
  "brief_description": "Bell peppers are stuffed with a spicy blend of chorizo, onions, garlic, fresh herbs, Worcestershire, three kinds of cheese, and rice. If you have a taste for spice, you\u2019ll love them.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to boil. Place peppers in boiling water, and cook 5 minutes. Remove, and set aside to cool."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "In a large skillet, cook chorizo until almost brown. Drain fat. Stir in celery, carrots, onions, and garlic. Cook until soft, about 5 minutes. Season with salt and pepper. Stir in tomatoes, Worcestershire sauce, parsley, basil, rice, and water. Cover, and simmer until rice is cooked, about 15 minutes. Remove from heat, and mix in Monterey Jack, Cheddar, and Mozzarella cheeses."
    },
    {
      "position": 4,
      "text": "Place peppers upright on a baking sheet. Stuff each pepper with the chorizo mixture. Sprinkle extra cheese on top."
    },
    {
      "position": 5,
      "text": "In a small bowl, combine tomato soup with just enough water to give the soup the consistency of gravy. Pour generously over peppers. Cover with foil."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

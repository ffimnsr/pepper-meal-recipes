{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8d9ffc83-1210-5c5e-81eb-d56ec4999ccb",
  "slug": "home-made-souse",
  "name": "Homemade Souse",
  "recipe_type": "side",
  "brief_description": "Souse is a form of head cheese - a gelled loaf made with pig's ears, feet and tongues and seasoned with herbs, spices, pickles, and peppers.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Place tongues, pig's ears, pig's feet, and onions in a large stock pot; add water to cover. Season with salt, pepper, whole peppercorns, sage, cloves, bay leaves, pickling spice, garlic powder and vinegar. Bring to a boil, and cook until meat is cooked, about 2 1/2 hours."
    },
    {
      "position": 2,
      "text": "Remove meat; set aside to cool. Strain broth, and measure 8 cups into another pot. Return broth to stove, and let simmer."
    },
    {
      "position": 3,
      "text": "Peel skin from ears, leaving the ear as intact as possible. Place the ears aside. Remove gristle and fat from pig's feet, and combine with ear trimmings. Cut off large portion of tongue and set aside. Trim loose meat from remainder of tongue, and combine with other trimmings. Put trimmings through a coarse meat grinder, then stir into broth; continue to simmer."
    },
    {
      "position": 4,
      "text": "Slice tongues into thin strips, and place lengthwise into 2 glass loaf pans, 9x5x3 inches. Slice ears into thin strips, then cut the strips into 1/2 inch pieces. Arrange the ear pieces among the tongue strips. Divide the pimiento and pepperoncini between the two molds. Sprinkle with pickle relish."
    },
    {
      "position": 5,
      "text": "Dissolve gelatin in 1 cup water. Stir into the simmering broth. Carefully ladle enough broth into each mold to completely cover the meat. Prod with a fork to uniformly distribute. Let stand 15 minutes, then cover with remaining broth. Allow to cool at room temperature, until they begin to jell, 2 to 3 hours. Refrigerate for 8 to 10 hours."
    },
    {
      "position": 6,
      "text": "When cool, run a thin knife around the sides of the mold to release the souse. Remove any fat that has accumulated on the surface."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 120,

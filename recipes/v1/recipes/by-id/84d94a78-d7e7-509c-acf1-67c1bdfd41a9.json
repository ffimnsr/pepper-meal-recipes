{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "84d94a78-d7e7-509c-acf1-67c1bdfd41a9",
  "slug": "chef-johns-corn-tortillas",
  "name": "Chef John's Corn Tortillas",
  "recipe_type": "breakfast",
  "brief_description": "Chef John's corn tortillas recipe is a simple 3-ingredient recipe that's easy to learn using any equipment you have. Practice makes perfect tortillas.",
  "cuisine": "Mexican Latin South American",
  "instructions": [
    {
      "position": 1,
      "text": "Add masa harina to a large bowl; add water and salt. Stir with your fingers until dough starts to pull together."
    },
    {
      "position": 2,
      "text": "Knead for a few minutes until smooth and texture resembles modeling clay or putty. Add more water if dough is too dry and more flour if too wet."
    },
    {
      "position": 3,
      "text": "Place a damp towel over dough to keep it from drying out. Let rest for 20 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Cut a resealable plastic bag into 2 rounds the same size as your tortilla press; set aside. Place a clean kitchen towel over a pie dish for cooked tortillas; set aside"
    },
    {
      "position": 5,
      "text": "Place 1 plastic round on bottom of the tortilla press. Pull off a little piece of dough, enough to roll into a 1 1/2-inch, about 1-ounce ball. Place dough ball in center of plastic round and press down lightly; cover dough with remaining plastic round."
    },
    {
      "position": 6,
      "text": "Fold tortilla press over, applying pressure to lever arm until tortilla flattens to desired thickness."
    },
    {
      "position": 7,
      "text": "Open tortilla press; peel off top plastic round. Align your index finger on edge of bottom plastic round at edge of tortilla; flip it over into your other hand using your index finger. Carefully peel off plastic."
    },
    {
      "position": 8,
      "text": "Gently slide tortilla, with your palm up, into a hot, dry skillet over medium- to medium-high heat. Cook 1 side for 30 to 45 seconds; flip and cook other side for 1 minute. Flip and press once or twice with a spatula until tortilla puffs up slightly; cook for 30 seconds. Flip and cook 5 to 10 seconds."
    },
    {
      "position": 9,
      "text": "Quickly transfer tortilla to the prepared pie dish; fold towel over to keep warm. Repeat pressing and cooking with the remaining dough, stacking and wrapping tortillas."
    },
    {
      "position": 10,
      "text": "Leave tortilla stack wrapped until soft and supple, at least 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,

  "id": "aca0595a-bbc2-52f5-9db0-379e88616de6",
  "slug": "cucumber-caprese-salad",
  "name": "Cucumber Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "Elevate your caprese salad with cucumber! Crisp slices of fresh cucumber add textural interest to everybody\u2019s favorite Italian summer salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring balsamic vinegar to a boil in a small saucepan over medium heat. Boil until reduced to 1/4 cup, about 8 minutes. Remove from the heat and allow to cool to room temperature."
    },
    {
      "position": 2,
      "text": "While the balsamic vinegar is cooling, arrange tomatoes, cucumber, mozzarella slices, and basil leaves in a layered pattern on a small serving platter until the platter is covered. Drizzle with olive oil and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Drizzle 1 to 2 tablespoons of the cooled balsamic vinegar over the salad. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

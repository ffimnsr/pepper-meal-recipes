  "slug": "scotts-sweet-potato-and-butternut-squash-mashers",
  "name": "Scott's Sweet Potato and Butternut Squash Mashers",
  "recipe_type": "dessert",
  "brief_description": "Sweet potatoes and butternut squash are mashed together to create this tasty side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place sweet potatoes and butternut squash into a large pot and cover with water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and allow to steam dry for a minute or two."
    },
    {
      "position": 2,
      "text": "Mash sweet potatoes and butternut squash, then add cinnamon, nutmeg, and syrup. Mix until smooth."
    }
  ],
  "servings": 8,

  "id": "866b0778-035c-506c-81a4-6ce9c91d1fd6",
  "slug": "cherry-berry-peach-pie",
  "name": "Cherry Berry Peach Pie",
  "recipe_type": "dessert",
  "brief_description": "Use your summer peaches, blueberries, and cherries to create a colorful lattice-top pie to enjoy with a scoop of vanilla ice cream on a hot summer evening.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Press 1 pie crust pastry into a 9-inch pie plate. Cut remaining pie crust pastry into 3/4-inch strips for the lattice top and set aside."
    },
    {
      "position": 2,
      "text": "Mix together peaches, cherries, blueberries, and lemon juice in a large bowl. Add 1/2 cup white sugar, brown sugar, flour, cinnamon, and salt; stir to coat. Pour fruit mixture into the prepared pie crust."
    },
    {
      "position": 3,
      "text": "Use pie crust strips to weave a lattice top over fruit filling. Brush top with milk; sprinkle with 1 teaspoon white sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C); continue baking until fruit filling is bubbling and lattice top is lightly browned, 45 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,

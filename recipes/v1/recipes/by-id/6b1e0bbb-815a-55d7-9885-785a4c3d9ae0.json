  "id": "6b1e0bbb-815a-55d7-9885-785a4c3d9ae0",
  "slug": "shrimp-tacodillas",
  "name": "Shrimp Tacodillas",
  "recipe_type": "main",
  "brief_description": "This easy, family-friendly shrimp tacodillas recipe is a cross between a crispy taco and a cheesy quesadilla and features melty pepper Jack cheese.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C) with rack in the lowest position. Brush two baking sheets with 1 tablespoon vegetable oil each."
    },
    {
      "position": 2,
      "text": "Heat extra-virgin olive oil in a large skillet until shimmering. Add tomatoes, onion, cilantro, ketchup, garlic, serrano, salt, and black pepper; cook and stir until onion is translucent, 6 to 8 minutes. Add shrimp; cook until shrimp are opaque but not cooked completely, about 2 minutes. Shrimp will continue to cook in the oven. Remove from heat."
    },
    {
      "position": 3,
      "text": "Place 5 tortillas on 1 prepared baking sheet and 4 tortillas on remaining prepared baking sheet. Brush tortilla tops with remaining 1 tablespoon vegetable oil. Divide pepper Jack cheese among tortillas, followed by shrimp mixture."
    },
    {
      "position": 4,
      "text": "Bake, one baking sheet at a time, in the preheated oven until tortillas start to turn golden brown and cheese has melted, 7 to 9 minutes. Repeat with remaining baking sheet and tortillas."
    },
    {
      "position": 5,
      "text": "Transfer tacodillas to a serving platter, one at a time, working as quickly as possible; fold in half, like tacos."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

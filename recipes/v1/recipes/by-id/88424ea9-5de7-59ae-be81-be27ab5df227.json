  "id": "88424ea9-5de7-59ae-be81-be27ab5df227",
  "slug": "vegetarian-mexican-inspired-stuffed-peppers",
  "name": "Mexican Vegetarian Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These vegetarian stuffed peppers have a flavorful filling made with rice, beans, and tomatoes, spiced with chili and cumin and topped with cheese.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water and 1 tablespoon salt to a boil. Add green bell peppers and cook until slightly softened, 3 to 4 minutes. This will prevent the bell peppers from becoming crispy as they bake."
    },
    {
      "position": 3,
      "text": "Drain bell peppers and arrange cut-side up in a 9x9-inch baking dish."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a skillet over medium heat. Add onion; cook and stir until softened, 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Transfer cooked onion into a large bowl; add rice, black beans, and tomatoes. Stir in chili powder, garlic salt, cumin, and 1/2 teaspoon salt until well combined. Fold in 1 1/2 cups Mexican cheese blend."
    },
    {
      "position": 6,
      "text": "Spoon rice mixture evenly into bell peppers; sprinkle with remaining Mexican cheese blend."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

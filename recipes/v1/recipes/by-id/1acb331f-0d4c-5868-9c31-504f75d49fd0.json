  "id": "1acb331f-0d4c-5868-9c31-504f75d49fd0",
  "slug": "mexican-shepherds-pie",
  "name": "Mexican Shepherd's Pie",
  "recipe_type": "salad",
  "brief_description": "This is a Mexican version of the Shepherd's Pie that is so popular in the UK. I decided to try this one night when I did not have any mashed potatoes. Its cheap, quick and easy...and my kids loved it! Serve with a tossed green salad for a great family meal!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a 9x13 inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Place the beef and onion in a skillet over medium heat. Cook until beef is evenly brown and onion is tender. Drain grease. Season with garlic powder, salt, and pepper. Mix in the tomatoes, and cook 5 minutes. Stir in the taco seasoning and water. Bring to a boil, reduce heat to low, and continue cooking 5 minutes, until thickened. Transfer to the prepared baking dish, and top evenly with corn."
    },
    {
      "position": 3,
      "text": "Prepare the corn muffin mix according to package directions. Spread evenly over the corn layer in the baking dish."
    },
    {
      "position": 4,
      "text": "Bake 20 minutes in the preheated oven, or until puffed and golden. Garnish with olives and cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

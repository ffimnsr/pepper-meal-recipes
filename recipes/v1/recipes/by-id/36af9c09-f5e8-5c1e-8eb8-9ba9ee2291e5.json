  "id": "36af9c09-f5e8-5c1e-8eb8-9ba9ee2291e5",
  "slug": "beef-stroganoff-iii",
  "name": "Beef Stroganoff",
  "recipe_type": "soup",
  "brief_description": "This creamy beef stroganoff is made with tender beef, hearty mushrooms, broth, mustard, white wine, and sour cream for the most delicious results!",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Remove any fat and gristle from chuck roast; cut into strips \u00bd-inch thick by 2-inches long. Season with \u00bd teaspoon salt and \u00bd teaspoon pepper."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add beef and brown quickly."
    },
    {
      "position": 3,
      "text": "Push beef to one side of the skillet. Add onions; cook and stir for 3 to 5 minutes, then push to the side with beef."
    },
    {
      "position": 4,
      "text": "Stir flour into pan juices on the empty side of the pan. Pour in beef broth and bring to a boil, stirring constantly. Reduce heat to low and stir in mustard. Cover and simmer until beef is tender, about 1 hour."
    },
    {
      "position": 5,
      "text": "Five minutes before serving, stir in mushrooms, sour cream, and white wine. Cook until heated through; season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Enjoy served over hot cooked noodles."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "abefbb96-2986-59cc-89f2-4327348efcc4",
  "slug": "sticky-bun-casserole-recipe-11853262",
  "name": "Sticky Bun Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This sticky bun casserole is topped with a warm buttery pecan glaze. Perfect for holiday mornings or potluck gatherings, this crowd-pleasing dish delivers all the flavor of homemade sticky buns with hardly any effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Pour melted butter into a 9x13 inch baking dish, set aside."
    },
    {
      "position": 3,
      "text": "Cut each cinnamon roll into 4 pieces and place in the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Whisk together eggs, 1/2 cup cream, cinnamon, and vanilla in a bowl. Pour egg mixture over the cinnamon rolls. Bake until golden brown and internal temperature reaches 200 degrees F (95 degrees C), 30 to 35 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile prepare the sticky bun topping. Combine brown sugar, corn syrup, remaining 1/2 cup heavy cream, 1/4 cup butter, and salt in a saucepan. Bring to a boil over medium-high heat, stirring frequently. Reduce heat to medium and boil gently until the caramel coats the back of a spoon, about 10 minutes. Remove from heat and stir in pecans. Keep the topping warm until the casserole comes out of the oven."
    },
    {
      "position": 6,
      "text": "When the casserole is out of the oven let cool for 10 minutes. Top with sticky bun topping. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

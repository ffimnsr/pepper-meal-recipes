  "id": "b586fe11-0f93-5275-a332-28ad115c3ff1",
  "slug": "applesauce-pumpkin-bread",
  "name": "Applesauce Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "This moist applesauce pumpkin bread recipe is loaded with walnuts, chocolate chips, and warm spices for a crowd-pleasing treat to enjoy in any season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Combine white sugar and applesauce in a bowl; stir in pumpkin pur\u00e9e and eggs until smooth. Stir in baking powder, baking soda, cinnamon, salt, ginger, cloves, and mace until incorporated. Fold in walnuts and chocolate chips. Stir in flour until fully blended. Divide batter between the prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing from the pans; transfer to a wire rack to cool completely, about 50 minutes more."
    },
    {
      "position": 4,
      "text": "Sprinkle loaves with confectioners\u2019 sugar before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

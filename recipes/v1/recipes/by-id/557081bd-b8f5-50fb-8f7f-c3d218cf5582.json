{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "557081bd-b8f5-50fb-8f7f-c3d218cf5582",
  "slug": "make-ahead-sweet-potato-and-chorizo-breakfast-burritos",
  "name": "Make-Ahead Sweet Potato and Chorizo Breakfast Burritos",
  "recipe_type": "dessert",
  "brief_description": "The sweetness from the sweet potatoes is the perfect complement to the spicy chorizo inside these make-ahead breakfast burritos you can freeze and thaw.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place sweet potatoes and green onions on the prepared baking sheet. Drizzle with olive oil and sprinkle with garlic powder, salt, and pepper. Toss to combine and spread out evenly."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until soft, about 25 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, cook chorizo in a medium skillet over medium-high heat, breaking apart with a wooden spoon, 8 to 10 minutes. Drain any excess fat; transfer chorizo to a bowl and set aside to cool. Wipe out the skillet and return it to the stove."
    },
    {
      "position": 5,
      "text": "Whisk eggs in a medium bowl until smooth. Heat butter in the skillet over medium-high heat. Pour in eggs and scramble until just set, 3 to 5 minutes. Scrape scrambled eggs into a clean bowl and let cool."
    },
    {
      "position": 6,
      "text": "Line up tortillas in assembly-line fashion. Divide chorizo between 8 tortillas. Top each with a portion of sweet potato-onion mixture, scrambled eggs, 1 tablespoon salsa, and queso fresco. Fold the bottom of each tortilla up over filling, then fold in both sides and roll up burritos."
    },
    {
      "position": 7,
      "text": "Flip burritos so they are seam-side down. Wrap each individually with aluminum foil and place into a resealable plastic bag."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

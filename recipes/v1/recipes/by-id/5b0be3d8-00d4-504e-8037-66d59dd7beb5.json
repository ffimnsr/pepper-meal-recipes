  "id": "5b0be3d8-00d4-504e-8037-66d59dd7beb5",
  "slug": "reuben-pizza",
  "name": "Reuben Pizza",
  "recipe_type": "main",
  "brief_description": "Sliced corned beef, sauerkraut, Swiss cheese, and dill pickles all feature in this Reuben pizza for a delicious twist on a classic sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a large pizza pan."
    },
    {
      "position": 2,
      "text": "On a lightly floured surface, roll bread dough out into a large circle about 18-inches in diameter; transfer to the prepared pizza pan. Build up the edges, and prick the center all over with a fork so it doesn't form a dome when baking."
    },
    {
      "position": 3,
      "text": "Bake for 20 to 25 minutes in the preheated oven, or until golden."
    },
    {
      "position": 4,
      "text": "Spread 1/2 of the salad dressing over hot crust. Sprinkle with 1/2 of the Swiss cheese. Arrange corned beef on top of cheese, then drizzle with remaining salad dressing. Top with sauerkraut and remaining Swiss cheese. Sprinkle with caraway seed."
    },
    {
      "position": 5,
      "text": "Bake for another 10 minutes in the preheated oven, until cheese melts and toppings are heated through. Sprinkle with chopped pickle. Let stand for 5 minutes before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e21d3bd0-9766-54f8-9825-360b30d39bcf",
  "slug": "grilled-portobello-mushrooms-with-mashed-cannellini-beans-and-harissa-sauce",
  "name": "Grilled Portobello Mushrooms with Mashed Cannellini Beans and Harissa Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Grilled portobello mushrooms are filled with mashed cannellini beans and harissa sauce in this vegetarian appetizer with bold flavors.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix roasted red pepper, shallot, garlic, 1 teaspoon olive oil, mint, lime juice, Dijon mustard, cilantro, 1/2 teaspoon salt, red pepper flakes, coriander, 1 pinch black pepper, and cayenne pepper together in a bowl to make harissa sauce."
    },
    {
      "position": 2,
      "text": "Combine cannellini beans and water in a small saucepan over medium-low heat; heat until warmed through, about 5 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Combine drained beans, 2 teaspoons truffle oil, 1/2 teaspoon salt, and 1/4 teaspoon pepper in a food processor; puree until smooth."
    },
    {
      "position": 4,
      "text": "Preheat grill for medium heat and lightly oil the grate. Brush mushroom caps on both sides with 4 teaspoons olive oil; season with 1/4 teaspoon salt and 1/4 teaspoon pepper. Grill mushrooms, gill-side up, basting frequently with vegetable broth, about 4 minutes per side."
    },
    {
      "position": 5,
      "text": "Top each mushroom cap with 1/2 cup bean puree and 2 tablespoons of harissa sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 13,
  "preparation_time_minutes": 25,

  "id": "5c0bfc5b-76f8-5004-a687-abca6cfba5f6",
  "slug": "authentic-key-lime-pie",
  "name": "Traditional Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "This traditional Key lime pie recipe is simple to make with fresh Key lime juice for a simply delicious refreshing dessert, just like it should be.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk condensed milk and egg yolks together in a large mixing bowl. Mix in Key lime juice; mixture will be thin at first but will thicken as it is whisked. Whisk until smooth and thick. Pour into the graham cracker crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until filling is firm to the touch and only slightly jiggly in the center, 12 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Cool to room temperature, then refrigerate before serving, 5 hours to overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "97b38f7e-6fe4-547b-9ec4-e514631c0823",
  "slug": "amish-friendship-cake",
  "name": "Amish Friendship Cake",
  "recipe_type": "appetizer",
  "brief_description": "This Amish friendship cake uses a starter, vanilla, walnuts, and other pantry staples to make two delicious cakes. Add bananas, dates, or raisins for variety.",
  "cuisine": "Amish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Mix flour, sourdough starter, sugar, oil, eggs, baking powder, vanilla, and salt together in a bowl. Stir in chopped walnuts. Stir in baking soda and pour batter into the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 minutes to 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

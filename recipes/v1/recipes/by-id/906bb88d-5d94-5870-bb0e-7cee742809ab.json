  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "906bb88d-5d94-5870-bb0e-7cee742809ab",
  "slug": "spinach-lasagna-iii",
  "name": "Spinach Lasagna",
  "recipe_type": "main",
  "brief_description": "This fresh spinach lasagna recipe with plenty of ricotta, Romano, and mozzarella makes a deliciously cheesy, vegetarian dish that's sure to be a hit!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a skillet over medium-high heat. Add mushrooms, onions, and garlic and cook until onions are tender; drain excess liquid and cool."
    },
    {
      "position": 4,
      "text": "At the same time, bring a small pot of water to a boil; add spinach and simmer for 5 minutes. Drain and cool slightly; squeeze out any excess liquid and finely chop."
    },
    {
      "position": 5,
      "text": "Combine ricotta cheese, Romano cheese, egg, salt, oregano, basil, and pepper in a bowl."
    },
    {
      "position": 6,
      "text": "Add cooled mushroom mixture and spinach; beat with an electric mixer on low speed for 1 minute."
    },
    {
      "position": 7,
      "text": "Lay 5 lasagna noodles in the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 8,
      "text": "Spread 1/3 of the ricotta-spinach mixture over noodles, then sprinkle with 1 cup mozzarella cheese and 1/3 cup Parmesan cheese."
    },
    {
      "position": 9,
      "text": "Spread 1 cup pasta sauce over top. Repeat layers two more times, then cover with aluminum foil."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven for 1 hour. Cool 15 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

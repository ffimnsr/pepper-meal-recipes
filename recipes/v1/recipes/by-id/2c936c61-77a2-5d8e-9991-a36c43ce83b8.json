  "id": "2c936c61-77a2-5d8e-9991-a36c43ce83b8",
  "slug": "midgs-mouth-watering-beef-jerky",
  "name": "Midg's Mouth Watering Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "A soy- and Worcestershire sauce-flavored marinade adds terrific flavor to mesquite or hickory-smoked beef jerky.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut beef into 1/4-inch thick slices. Combine soy sauce, water, Worcestershire sauce, sugar, salt, onion powder, garlic powder, and liquid smoke. Pour marinade into heavy-duty resealable bag. Add beef and mix well; seal bag and refrigerate 12 hours."
    },
    {
      "position": 2,
      "text": "Remove beef from marinade, pat dry with paper towels, and allow to stand for 30 minutes. Discard used marinade. Meanwhile, soak wood chips."
    },
    {
      "position": 3,
      "text": "Preheat smoker for 10 minutes."
    },
    {
      "position": 4,
      "text": "Arrange beef on drying racks. Smoke for 5 to 7 hours, depending on how you like it, replenishing wood chips as necessary."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 15,

  "id": "3990d0df-611d-5144-8587-719a089e8b2c",
  "slug": "tuna-lettuce-wraps",
  "name": "Tuna Lettuce Wraps",
  "recipe_type": "salad",
  "brief_description": "Swap green lettuce leaves for tortillas in these light and tasty tuna salad wraps that are ready in about 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tuna, mayonnaise, onion, salt, and pepper in a bowl."
    },
    {
      "position": 2,
      "text": "Lay lettuce leaves out. Divide tuna mixture among the leaves, placing it in the middle of each leaf. Sprinkle Cheddar cheese over the tuna. Roll leaves up to create wraps."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

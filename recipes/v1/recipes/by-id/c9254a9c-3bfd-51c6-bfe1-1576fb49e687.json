  "id": "c9254a9c-3bfd-51c6-bfe1-1576fb49e687",
  "slug": "grandmas-homemade-banana-bread",
  "name": "Grandma's Homemade Banana Bread",
  "recipe_type": "appetizer",
  "brief_description": "Grandma's banana bread recipe is a number one family favorite! It's been handed down from generation to generation. Get creative with add-ins.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, bananas, and eggs in a large mixing bowl. Add in flour, milk, vanilla, baking soda, and salt; beat well. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 60 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

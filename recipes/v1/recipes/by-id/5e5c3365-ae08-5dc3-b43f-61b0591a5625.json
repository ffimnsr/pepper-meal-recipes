  "id": "5e5c3365-ae08-5dc3-b43f-61b0591a5625",
  "slug": "brown-sugar-blondies",
  "name": "Brown Sugar Blondies",
  "recipe_type": "dessert",
  "brief_description": "This no-frills, basic brown sugar blondie recipe can be adjusted to your liking with a variety of additions, but has a delicious, chewy caramel taste all on its own!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Mix brown sugar, flour, walnuts, butter, eggs, baking powder, vanilla extract, and salt together in a bowl by hand until smooth. Spread evenly into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the top is dry and edges have started to pull away from the sides of the pan, 25 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and let cool for 10 to 15 minutes before slicing."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b130a647-d53c-59fe-9f44-2e21befe0555",
  "slug": "irish-boxty",
  "name": "Irish Boxty",
  "recipe_type": "dessert",
  "brief_description": "Boxty is a traditional Irish potato pancake made with grated and mashed potatoes; pan-fry until golden and crispy on the outside and fluffy inside.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Toss grated potatoes with flour in a large bowl. Stir in mashed potatoes until combined."
    },
    {
      "position": 3,
      "text": "Whisk egg and milk together in a separate bowl; mix into the potatoes. Season to taste with salt and pepper."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium-high heat. Drop in potato mixture, forming patties about 2 inches in diameter. Fry on both sides until golden brown, 3 to 4 minutes per side. Drain on a paper towel-lined plate. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "c21a2eec-2b36-5441-bec5-585a72123a17",
  "slug": "my-chicken-parmesan",
  "name": "My Chicken Parmesan",
  "recipe_type": "main",
  "brief_description": "Your family will love this chicken Parmesan recipe that features tenderloins served with pasta and sauce with a blanket of melted Italian-blend cheese.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a large baking dish."
    },
    {
      "position": 2,
      "text": "Combine flour, 1/2 teaspoon salt, garlic powder, black pepper, and cayenne pepper in a resealable plastic bag. Place chicken tenderloins into flour mixture, seal the bag, and shake to coat."
    },
    {
      "position": 3,
      "text": "Beat egg and half-and-half thoroughly in a shallow bowl. Mix together bread crumbs, Parmesan cheese, and parsley in a second shallow bowl. Dip floured chicken tenderloins into beaten egg mixture, let excess egg drip off, then press chicken into bread crumb mixture to coat. Let breaded chicken rest on a plate to set coating, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large skillet over medium heat. Cook chicken in hot oil until no longer pink in the center, the juices run clear, and coating is golden brown, about 5 minutes per side. An instant-read thermometer inserted into the center should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Bring water and 1 tablespoon salt to a boil in a large pot. Cook angel hair pasta in boiling water, stirring occasionally, until cooked through, about 5 minutes. Drain."
    },
    {
      "position": 6,
      "text": "Pour 3/4 cup marinara sauce into the prepared baking dish and top with cooked pasta. Pour remaining 3/4 cup sauce over pasta and arrange chicken tenderloins on top. Sprinkle with Italian cheese blend."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

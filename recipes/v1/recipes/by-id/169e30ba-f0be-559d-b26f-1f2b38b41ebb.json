  "id": "169e30ba-f0be-559d-b26f-1f2b38b41ebb",
  "slug": "mini-frittatas-with-quinoa",
  "name": "Mini Frittatas with Quinoa",
  "recipe_type": "breakfast",
  "brief_description": "Savory bites of quinoa, eggs, zucchini, cheese, and ham are equally excellent hot or cold. Ideal for breakfast, brunch, lunch, or dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 6 muffin cups."
    },
    {
      "position": 2,
      "text": "Bring the quinoa and water to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until the quinoa is tender and the water has been absorbed, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Combine cooked quinoa, eggs, egg whites, zucchini, Swiss cheese, ham, parsley, Parmesan cheese, and white pepper in a large bowl and mix until thoroughly combined. Spoon mixture to the top of each prepared muffin cup."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until the edges of frittatas are golden brown, about 30 minutes. Allow to cool at least 5 minutes in the pan before serving. Serve hot or cold."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "5d0ccea4-4074-5432-94c9-b83b336b1cc5",
  "slug": "cinnamon-rice",
  "name": "Cinnamon Rice",
  "recipe_type": "dessert",
  "brief_description": "This easy rice recipe is flavored with raisins, a splash of nonfat milk, cinnamon, and sugar for a simple yet satisfying rice dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring rice, water, milk, raisins, and margarine to a boil in a saucepan over medium-high heat, stirring occasionally. Reduce heat to low, cover, and cook until liquid has absorbed and rice is tender, about 15 minutes. Mix together cinnamon and sugar; sprinkle over rice to serve."
    }
  ],

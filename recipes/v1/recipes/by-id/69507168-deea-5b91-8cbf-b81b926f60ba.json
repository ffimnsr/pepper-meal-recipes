  "id": "69507168-deea-5b91-8cbf-b81b926f60ba",
  "slug": "sugar-free-brownies",
  "name": "Sugar Free Brownies",
  "recipe_type": "dessert",
  "brief_description": "Wow! Deluxe chocolate flavored brownies with frosting and no sugar! Now everyone can have as many brownies as they want.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 8x8 inch pan."
    },
    {
      "position": 2,
      "text": "In a small saucepan over medium heat, melt margarine and cocoa together, stirring occasionally until smooth. Remove from heat and set aside to cool. In a large bowl, beat eggs until frothy. Stir in the sucrolose sweetener. Combine the flour and salt; stir into the egg mixture then mix in the cocoa and margarine. Finally stir in the 1/4 cup of milk and if desired, the walnuts. Pour into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake for 25 to 30 minutes in the preheated oven, until a toothpick inserted into the center, comes out clean. To make frosting, Mix together the sugar free chocolate pudding mix and 1 cup skim milk using an electric mixer. Mix for about two minutes or until thick. Spread over cooled brownies before cutting into squares."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

  "id": "ee19051b-1879-57e4-ab85-5a41b1fdcce3",
  "slug": "toris-air-fryer-pumpkin-bagels",
  "name": "Tori's Air Fryer Pumpkin Bagels",
  "recipe_type": null,
  "brief_description": "These quick homemade bagels use a pumpkin and Greek yogurt dough and are sprinkled with cheese before baking in the air fryer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 280 degrees F (140 degrees C) according to manufacturer's instructions, about 3 minutes. Line the air fryer basket with parchment paper and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix flour, brown sugar, baking powder, and salt together in a medium bowl. Add pumpkin puree and yogurt. Stir to combine."
    },
    {
      "position": 3,
      "text": "Place dough on a lightly floured surface; divide into 4 balls. Roll each ball into 8-inch long ropes. Join the ends together to form bagels."
    },
    {
      "position": 4,
      "text": "Mix oats and cinnamon together in a small bowl. Whisk egg white, honey, and water together in another small bowl until smooth. Brush bagels with egg mixture; sprinkle oats and cinnamon on both sides."
    },
    {
      "position": 5,
      "text": "Place bagels in the prepared basket and bake for 13 minutes. Sprinkle Cheddar cheese over bagels and bake for 2 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

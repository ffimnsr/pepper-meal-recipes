  "id": "e687bd47-ecb3-5496-8de7-0d0a5c507307",
  "slug": "quick-and-easy-pizza-crust",
  "name": "Easy Homemade Pizza Dough",
  "recipe_type": "main",
  "brief_description": "An easy pizza crust recipe that will hold all your favorite toppings is simple to make with basic pantry ingredients like yeast, flour, vegetable oil, sugar, and salt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 450 degrees F (230 degrees C), and lightly grease a pizza pan."
    },
    {
      "position": 2,
      "text": "Place warm water in a bowl; add yeast and sugar. Mix and let stand until creamy, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Add flour, oil, and salt to the yeast mixture; beat until smooth. You can do this by hand or use a stand mixer fitted with a dough hook to make it easier."
    },
    {
      "position": 4,
      "text": "Let rest for 5 minutes."
    },
    {
      "position": 5,
      "text": "Turn dough out onto a lightly floured surface and pat or roll into a 12-inch circle."
    },
    {
      "position": 6,
      "text": "Transfer to the prepared pizza pan."
    },
    {
      "position": 7,
      "text": "Spread crust with sauce and toppings of your choice."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes. Remove from the oven and let cool for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

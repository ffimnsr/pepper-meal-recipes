  "id": "1114545b-f21b-51b3-8340-3d118392c71b",
  "slug": "easy-creamy-chicken-enchiladas",
  "name": "Easy Creamy Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "These creamy chicken enchiladas come together easily using shredded roast chicken, seasoning mix, and red enchilada sauce for a family-pleasing meal.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 13x9-inch baking dish with cooking spray. Spread 1/4 cup of enchilada sauce in the bottom of the baking dish."
    },
    {
      "position": 2,
      "text": "Mix chicken, 1 cup of Cheddar cheese, cream cheese, and seasoning mix in a medium bowl; spoon slightly less than 1/2 cup of filling onto each tortilla. Roll up each tortilla tightly; place seam-side down in the prepared baking dish. Drizzle with remaining enchilada sauce. Sprinkle remaining 1/2 cup Cheddar cheese on top; cover with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes; uncover and bake 15 minutes longer or until bubbly and lightly browned."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

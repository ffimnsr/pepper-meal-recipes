  "id": "cfd67e45-a93d-5f93-8c31-34bd1ff9e616",
  "slug": "cheese-drop-biscuits",
  "name": "Cheese Drop Biscuits",
  "recipe_type": "main",
  "brief_description": "These easy-to-make Cheddar drop biscuits will add flavor to any meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Mix together flour, baking powder, chives, garlic salt, and salt in a large bowl. Cut in shortening until mixture has only small lumps."
    },
    {
      "position": 3,
      "text": "Add milk and cheese; stir until moistened. Drop dough by heaping spoonfuls onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

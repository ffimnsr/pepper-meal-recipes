  "id": "2f5967e5-535d-5605-8db4-6eb6b4e6853b",
  "slug": "cheesy-baked-zucchini-bites-recipe-11975281",
  "name": "Cheesy Baked Zucchini Bites",
  "recipe_type": "appetizer",
  "brief_description": "These cheesy baked zucchini bites combine tender zucchini with creamy pimento cheese for a flavorful Southern-inspired appetizer. Baked until crisp and golden, they\u2019re perfect for entertaining (or snacking).",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Shred zucchini using the large holes of a box grater. Toss zucchini with salt and let stand for 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Wrap zucchini in a clean kitchen towel and squeeze tightly until liquid releases and zucchini is very dry."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Combine drained zucchini, pimento cheese, egg, 1/2 cup panko, Parmesan, garlic powder, black pepper, and smoked paprika in a bowl."
    },
    {
      "position": 5,
      "text": "Scoop mixture into about 1 tablespoon each and form into small patties or balls."
    },
    {
      "position": 6,
      "text": "Lightly dredge zucchini bites in remaining panko for extra crunch. Place bites on the prepared baking sheet. Spray lightly with olive oil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until deeply golden, flipping halfway through, 18 to 22 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

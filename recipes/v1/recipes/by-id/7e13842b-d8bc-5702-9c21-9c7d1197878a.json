  "id": "7e13842b-d8bc-5702-9c21-9c7d1197878a",
  "slug": "cinnamon-rolls-iii",
  "name": "Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "This cinnamon roll recipe starts with an easy bread machine dough that's filled, rolled, and proofed \u2014 then baked for just 15 minutes in the oven.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make the dough: Place milk, water, melted butter, egg, bread flour, pudding mix, sugar, salt, and yeast into a bread machine in the order listed, or follow the order recommended by the manufacturer if different. Run Dough cycle. Remove dough from the machine after the cycle is done, about 90 minutes."
    },
    {
      "position": 2,
      "text": "When the dough is almost finished, start the filling: Mix brown sugar, pecans, and cinnamon together in a bowl until well combined. Butter a 9x13-inch baking pan."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and roll into a 17x10-inch rectangle. Spread 1/2 cup softened butter over the rectangle, then sprinkle brown sugar mixture over top."
    },
    {
      "position": 4,
      "text": "Beginning with the long side, roll dough over filling into a log; cut log into sixteen 1-inch slices. Place slices, cut-sides up, into the prepared pan. Let rise in a warm place until doubled in volume, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake rolls in the preheated oven until golden brown, 15 to 20 minutes. Remove from the oven and let cool for 10 minutes."
    },
    {
      "position": 7,
      "text": "While the rolls are cooling, make the frosting: Stir confectioners' sugar, softened butter, cream cheese, milk, and vanilla together in a bowl until well combined. Spread over warm rolls."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

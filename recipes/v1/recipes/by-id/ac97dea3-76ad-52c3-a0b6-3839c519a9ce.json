  "id": "ac97dea3-76ad-52c3-a0b6-3839c519a9ce",
  "slug": "slow-cooker-pulled-pork-with-root-beer",
  "name": "Slow Cooker Pulled Pork with Root Beer Recipe",
  "recipe_type": "dessert",
  "brief_description": "This slow cooker pulled pork shoulder recipe is simmered in root beer, brown sugar, and spices and it makes the best sandwiches on Hawaiian sweet bread.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Pat pork shoulder dry; place in a slow cooker. Pour root beer over pork."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, cumin, paprika, salt, black pepper, garlic powder, onion powder, and oregano in a small bowl; sprinkle on top pork and lightly rub until entire surface coated."
    },
    {
      "position": 3,
      "text": "Cook on Low for 5 hours; increase heat to High and continue cooking until pork is tender and easily pulled apart with a fork, about 3 hours more."
    },
    {
      "position": 4,
      "text": "Carefully transfer pork to a platter; shred with 2 forks. Drizzle some cooking liquid over pork to moisten."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 15,

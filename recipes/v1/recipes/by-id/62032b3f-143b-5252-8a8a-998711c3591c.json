  "schema_version": 1,
  "id": "62032b3f-143b-5252-8a8a-998711c3591c",
  "slug": "eggs-benedict-casserole",
  "name": "Eggs Benedict Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This eggs Benedict casserole delivers all the flavors of the popular breakfast dish with an easy overnight recipe that's great for when guests come.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "To prepare the casserole: Whisk milk, eggs, green onions, onion powder, and salt together in a large bowl until well combined. Set aside."
    },
    {
      "position": 3,
      "text": "Layer 1/2 of the Canadian bacon in the prepared baking dish; cover with English muffins."
    },
    {
      "position": 4,
      "text": "Top with remaining Canadian bacon and pour egg mixture over everything. Cover the baking dish with plastic wrap and refrigerate, 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Remove plastic wrap and sprinkle casserole with paprika; cover the baking dish with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until eggs are nearly set, about 30 minutes. Remove the foil and continue baking until eggs are completely set, about 15 minutes more."
    },
    {
      "position": 7,
      "text": "Meanwhile, make the sauce: Whisk 1 cup milk and Hollandaise sauce mix in a saucepan over medium heat. Add butter; cook, stirring frequently, until boiling. Reduce heat to medium-low and simmer, stirring constantly, until thickened, about 1 minute."
    },
    {
      "position": 8,
      "text": "To serve: Slice casserole into 10 pieces; transfer each piece onto a plate and drizzle warm sauce on top."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

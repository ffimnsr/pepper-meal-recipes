  "id": "c492005a-cd49-5260-bc06-2fb17272f7e8",
  "slug": "true-dominican-sancocho-latin-7-meat-stew",
  "name": "True Dominican Sancocho (Meat and Vegetable Stew)",
  "recipe_type": "soup",
  "brief_description": "Sancocho (Dominican meat and vegetable stew) features pork, chicken, and beef with hearty vegetables, including pumpkin, sweet potato, and plantains.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Mash oregano, garlic, and 1 teaspoon salt in a bowl until well combined."
    },
    {
      "position": 2,
      "text": "Mix beef, pork, chicken, and lemon juice together in a large bowl; drain 1/2 of the liquid. Mix in onions, mashed garlic mixture, 2 tablespoons oil, and vinegar."
    },
    {
      "position": 3,
      "text": "Heat 1/2 cup vegetable oil in a large skillet over medium-high heat. Add meat mixture in three batches and cook until browned on all sides, 10 to 15 minutes per batch."
    },
    {
      "position": 4,
      "text": "Transfer browned meats to an 8-quart Dutch oven. Pour in 1/2 of the water, then add chicken broth, beef consomm\u00e9, 2 bouillon cubes, and remaining 1 teaspoon salt. Bring to a boil, then reduce the heat to low, cover, and simmer until meats are more than halfway cooked through, about 40 minutes."
    },
    {
      "position": 5,
      "text": "Add pumpkin, sweet potatoes, eddeos, yuca, potatoes, plantains, corn, celery, carrots, bell pepper, cilantro, remaining bouillon cubes, and adobo seasoning to the Dutch oven. Increase the heat to medium and return to a boil. Reduce the heat to low and simmer, stirring in remaining water as needed in gradual increments to replace evaporated liquid, until root vegetables are soft and liquid has thickened, 1 to 2 hours."
    },
    {
      "position": 6,
      "text": "During the last 30 minutes of cooking, transfer beef, pork, and chicken to a cutting board. Let cool slightly, then remove bones and chop or shred meat. Return meat to the stew and finish cooking."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,

  "id": "dc5601bd-4d6e-51c4-8db2-f60b9aad86f3",
  "slug": "homemade-whipped-cream",
  "name": "3-Ingredient Whipped Cream",
  "recipe_type": "dessert",
  "brief_description": "This whipped cream recipe flavored with sugar and vanilla is a 3-ingredient topping that's made from scratch and way better than what comes in a can.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a medium bowl and mixer beaters into the freezer to chill, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour cream into the chilled bowl and beat with an electric mixer until frothy. Add sugar and vanilla gradually, continuing to beat until soft peaks form."
    }
  ],
  "servings": 4,

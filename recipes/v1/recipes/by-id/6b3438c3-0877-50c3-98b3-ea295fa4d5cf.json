  "id": "6b3438c3-0877-50c3-98b3-ea295fa4d5cf",
  "slug": "best-ever-irish-soda-bread",
  "name": "Best Ever Irish Soda Bread",
  "recipe_type": null,
  "brief_description": "This is the best Irish soda bread recipe for your St. Patrick's Day feast or anytime you'd like a quick and delicious homemade bread.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pan."
    },
    {
      "position": 2,
      "text": "Stir flour, sugar, salt, baking powder, and baking soda together in a large bowl. Using a pastry cutter, cut the butter gently into the flour mixture until well combined; stir in raisins. Whisk buttermilk and eggs together in a separate bowl; lightly beat egg mixture into flour mixture. Place dough into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the bread has risen and the top is golden brown, 45 minutes to 1 hour. A knife inserted into the center of the bread should come out clean. Cool the bread in the pan on a wire rack for 10 minutes before removing. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e240d2fb-f487-5587-a4e5-36919ff6ee57",
  "slug": "lobster-ravioli-bake-recipe-11879631",
  "name": "Lobster Ravioli Bake",
  "recipe_type": "soup",
  "brief_description": "This lobster ravioli bake is rich, creamy, and cheesy, and could not be easier, thanks to store bought lobster ravioli and lobster bisque.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 9x13-inch baking dish with butter or spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Cook the lobster ravioli 1 minute shy of the package cooking time. Drain gently."
    },
    {
      "position": 3,
      "text": "Spoon a few scoops of lobster bisque onto the bottom of the prepared baking dish and spread into an even layer."
    },
    {
      "position": 4,
      "text": "Arrange the cooked ravioli in the dish. Pour remaining lobster bisque over the top, gently nudging the soup in between the ravioli so everything is coated."
    },
    {
      "position": 5,
      "text": "Sprinkle evenly with mozzarella and Parmesan."
    },
    {
      "position": 6,
      "text": "Cover loosely with foil and bake for 20 minutes. Remove foil and bake until bubbly and lightly golden on top, 10 to 15 minutes more."
    },
    {
      "position": 7,
      "text": "Garnish with chopped parsley."
    },
    {
      "position": 8,
      "text": "Serve warm and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fba5c8e5-566b-5e3c-a750-a2fc88424c91",
  "slug": "sun-dried-tomato-pesto",
  "name": "Sun-Dried Tomato Pesto",
  "recipe_type": "appetizer",
  "brief_description": "This sun-dried tomato pesto is a blend of sun-dried tomatoes, basil, pine nuts, garlic, olive oil, and Parmesan for a rich and tasty pasta sauce or spread.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place sun-dried tomatoes in a bowl and cover with warm water for 5 minutes, or until tender."
    },
    {
      "position": 2,
      "text": "Place sun-dried tomatoes, pine nuts, onion, basil, parsley, and garlic in a food processor or blender; process until well blended. Add crushed tomatoes, vinegar, red wine, and tomato paste; blend to desired consistency. Stir in olive oil and Parmesan cheese; season to taste."
    }
  ],

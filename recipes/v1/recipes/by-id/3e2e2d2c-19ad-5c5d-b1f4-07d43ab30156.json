  "id": "3e2e2d2c-19ad-5c5d-b1f4-07d43ab30156",
  "slug": "jazzy-stuffed-peppers-recipe-8547058",
  "name": "Jazzy Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These jazzy stuffed peppers are bell peppers filled with ground turkey and New Orleans-style dirty rice from a packaged mix, so they are perfectly seasoned and easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground turkey in the hot skillet until browned and crumbly, 5 to 7 minutes; drain. Add dirty rice mix, water, and vegetable oil; bring to a simmer, reduce the heat, and cook until rice is tender, about 25 minutes."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil over high heat. Add pepper halves, 4 at a time, and cook until beginning to soften, 2 to 3 minutes. Remove to a colander to drain."
    },
    {
      "position": 4,
      "text": "Spread stewed tomatoes in a 9x13-inch casserole dish. Place pepper halves on top of tomatoes, cut side up. Stuff each with dirty rice mixture; sprinkle with cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is heated through and cheese is melted, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

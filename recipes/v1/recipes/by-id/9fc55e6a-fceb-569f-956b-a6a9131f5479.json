  "id": "9fc55e6a-fceb-569f-956b-a6a9131f5479",
  "slug": "chocolate-cherry-pie",
  "name": "Chocolate Cherry Pie",
  "recipe_type": "dessert",
  "brief_description": "A vanilla cookie crust is host to a heavenly, yet sinful creamy filling, made with butter, chocolate, cherries and whipped eggs. Please note: this recipe contains raw eggs. We recommend that pregnant women, young children, the elderly and the infirm do not consume raw eggs. Important: be sure to use only fresh eggs for this recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C.) In a medium bowl, combine crumbs, and 1/4 cup softened butter. Press onto the bottom and sides of an 8 inch pie pan. Bake in preheated oven for 8 minutes. Cool."
    },
    {
      "position": 2,
      "text": "In a microwave-safe bowl, microwave chocolate until melted. Stir occasionally until chocolate is smooth. Set aside. In a large bowl, cream 1/2 cup butter and sugar until light and fluffy. Blend in melted chocolate, salt and vanilla. Add eggs, one at a time, beating 5 minutes for each egg. Stir in chopped cherries. Spread into cooled crust. Chill 4 hours."
    },
    {
      "position": 3,
      "text": "Before serving, garnish pie with whipped cream and maraschino cherries."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

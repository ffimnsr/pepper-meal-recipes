  "id": "00f24d50-7ee6-54f8-83ad-4506a27b4aab",
  "slug": "eggnog-cheesecake-iii",
  "name": "Eggnog Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This eggnog cheesecake with a decadent cream cheese and eggnog filling on a graham cracker crust makes the perfect festive dessert for eggnog lovers!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the crust: Mix graham cracker crumbs, melted butter, and sugar together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Press graham mixture into the bottom of a 9-inch springform pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes; transfer the pan to a wire rack and allow crust to cool. Increase the oven temperature to 425 degrees F (220 degrees C)."
    },
    {
      "position": 5,
      "text": "While the crust is cooling, make the filling: Combine cream cheese, sugar, eggnog, and flour in a food processor; process until smooth. Blend in eggs, rum, and nutmeg."
    },
    {
      "position": 6,
      "text": "Pour eggnog mixture into cooled crust."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 10 minutes. Reduce the heat to 250 degrees F (120 degrees C) and continue to bake until edges are puffed and surface is firm except for a small spot in the center that will jiggle when the pan is gently shaken, about 45 minutes. Loosen the sides of the springform pan; let cheesecake cool before removing the rim completely."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

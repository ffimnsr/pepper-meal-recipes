  "id": "4e5e7ad3-2f07-5502-bf95-480d9effaef9",
  "slug": "mini-ham-and-cheese-rolls",
  "name": "Mini Ham And Cheese Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These savory sandwiches--made with storebought dinner rolls--turn rich and flavorful when drizzled with a buttery onion topping just before baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "In a small mixing bowl, combine onion flakes, mustard, poppy seeds and margarine."
    },
    {
      "position": 3,
      "text": "Split each dinner roll. Make a sandwich of the ham and cheese and the dinner rolls. Arrange the sandwiches on a baking sheet. Drizzle the poppy seed mixture over the sandwiches."
    },
    {
      "position": 4,
      "text": "Bake for 20 minutes, or until cheese has melted. Serve these sandwiches warm."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

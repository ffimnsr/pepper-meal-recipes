  "id": "cfbbf4f7-6063-5356-a393-aca4e1b2d991",
  "slug": "tiny-tomato-pickles-recipe-11998306",
  "name": "Tiny Tomato Pickles",
  "recipe_type": "salad",
  "brief_description": "These tiny tomato pickles couldn't be easier to make. Just pack a jar with fresh baby cherry tomatoes, pour over a quick pickling brine, and let the fridge do the rest. After 24 hours, you'll have crisp, tangy bites perfect for sandwiches, salads, charcuterie boards, or anything else you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add tomatoes, garlic, peppercorns, and basil to 1-quart-size glass jar fitted with a lid."
    },
    {
      "position": 2,
      "text": "Combine water, vinegar, salt, sugar, and crushed red pepper in a small saucepan, and place over high heat. Cook, stirring often, until salt and sugar have fully dissolved. Remove from heat just before the mixture comes to a simmer."
    },
    {
      "position": 3,
      "text": "Pour hot brine over tomatoes and seal jar. Allow jar to cool to room temperature, then place in the refrigerator until completely chilled, at least 8 hours. Best served after 24 hours and up to 2 weeks."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

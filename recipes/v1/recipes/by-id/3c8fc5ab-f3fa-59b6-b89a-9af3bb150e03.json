  "id": "3c8fc5ab-f3fa-59b6-b89a-9af3bb150e03",
  "slug": "easy-key-lime-pie-ii",
  "name": "Easy Key Lime Pie II",
  "recipe_type": "dessert",
  "brief_description": "This recipe has egg whites folded into the basic recipe which makes it light and airy. And the lime zest gives this creamy, refreshing pie a little extra lime-oomph!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (125 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large glass or metal bowl, beat egg whites until stiff peaks form. Set aside."
    },
    {
      "position": 3,
      "text": "In a medium bowl, beat egg yolks, then stir in condensed milk, lime rind, and lime juice. Mix well, then fold mixture into beaten egg whites. Pour mixture into graham cracker crust."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 10 minutes. Chill before serving. Garnish with whipped topping if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

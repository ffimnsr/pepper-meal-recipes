{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f6b5bd5b-e054-571b-b80b-0b2336a1a987",
  "slug": "sweet-potato-pie-with-marshmallow-meringue-topping",
  "name": "Sweet Potato Pie with Marshmallow Meringue Topping",
  "recipe_type": "dessert",
  "brief_description": "A satiny sweet potato filling in a graham cracker crust is topped with a luscious marshmallow meringue topping guaranteed to win applause from guests at Thanksgiving or any special occasion.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix the graham cracker crumbs together with 1/3 cup white sugar, butter, and 1/8 teaspoon salt in a mixing bowl. Spread evenly over the bottom and sides of a 9 inch pie pan."
    },
    {
      "position": 3,
      "text": "Bake the graham cracker crust in preheated oven until lightly browned, about 5 minutes. Remove from oven, and cool on a rack."
    },
    {
      "position": 4,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 5,
      "text": "To make the sweet potato filling, place the mashed sweet potatoes in a mixing bowl. Whisk in the brown sugar, whipping cream, eggs, vanilla, cinnamon, mace, and salt until smooth and evenly blended. Pour the sweet potato mixture into the baked graham cracker crust."
    },
    {
      "position": 6,
      "text": "Bake the pie in preheated oven until the center is set, about 45 minutes. Remove from oven and cool on a rack."
    },
    {
      "position": 7,
      "text": "To make the marshmallow meringue, place the marshmallows and milk in a pan; cook over low heat, folding mixture gently until marshmallows are half melted. Remove pan from the heat. Continue folding until marshmallows melt completely, and the mixture becomes smooth and fluffy."
    },
    {
      "position": 8,
      "text": "Place the egg whites in a separate mixing bowl, and beat until soft peaks form. Gradually add 1/4 cup white sugar, and continue beating until stiff peaks form. Beat in vanilla and salt. Gently fold the egg whites into the marshmallow mixture, and spread over the top of the pie."
    },
    {
      "position": 9,
      "text": "Return the pie to the oven and cook until the meringue is toasted, 5 to 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 51,
  "preparation_time_minutes": 20,

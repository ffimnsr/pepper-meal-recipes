  "id": "456b8c33-468c-5b17-a168-1c9807428cdc",
  "slug": "lazy-hazy-beef-chili-recipe-7562950",
  "name": "Lazy Hazy Beef Chili",
  "recipe_type": "soup",
  "brief_description": "Despite all the shortcuts, this lazy hazy beef chili is tremendously delicious. For a little-to-no work beef chili, this lacks for nothing. Chunky salsa does all the chopping for you, and the hazy IPA adds a subtle bitterness, a little acidity, and a certain something nobody will be able to pick out. As everybody knows, the most fun part of cheating is getting away with it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add beef to a dry cold pot, and turn heat to high."
    },
    {
      "position": 2,
      "text": "When beef begins to sizzle, break up into small pieces with a potato masher or spatula. Meat can be broken up into very fine crumbles, or into larger chunks, depending on the desired texture. Continue to cook and break up beef until no longer pink, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Add chili powder, chipotle, black pepper, salt, and cinnamon to the pot. Cook, stirring, for 1 minute, then pour in beer."
    },
    {
      "position": 4,
      "text": "Stir, scraping the browned bits from the bottom of the pot as you do. Let mixture boil until liquid is reduced by about half, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Add sugar, oregano, garlic powder, diced tomatoes and jarred salsa. Stir in; return mixture to a simmer."
    },
    {
      "position": 6,
      "text": "Stir in beans, reduce heat to medium-low, and cook, stirring occasionally, until chili is thickened and flavor is developed to your liking, about 1 hour."
    },
    {
      "position": 7,
      "text": "Taste, adjust the seasoning. Top with sour cream, green onions, Cheddar cheese, and cilantro as desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "66d3bf7e-46be-5fb2-a449-6a03a9def70a",
  "slug": "campfire-baked-potatoes",
  "name": "Campfire Baked Potatoes",
  "recipe_type": "side",
  "brief_description": "These campfire baked potatoes are smeared with butter, wrapped in foil, then cooked in the hot embers until perfectly tender, fluffy, and delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Poke each potato several times all over with a fork. Smear each potato with 1 tablespoon of butter, then double wrap in aluminum foil."
    },
    {
      "position": 2,
      "text": "Bury potatoes in the hot coals of a campfire and cook until crispy on the outside and tender inside, about 30 to 60 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,

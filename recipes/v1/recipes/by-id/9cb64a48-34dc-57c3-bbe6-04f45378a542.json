  "id": "9cb64a48-34dc-57c3-bbe6-04f45378a542",
  "slug": "pumpkin-chocolate-chip-cookies-i",
  "name": "Easy Pumpkin Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "You will be glad you tried this unique combination of nuts, chocolate, spices, and pumpkin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Cream shortening and sugar together in a large bowl until light and fluffy. Beat in egg, then stir in the pumpkin and vanilla. Combine flour, baking powder, baking soda, salt, nutmeg, and cinnamon; gradually mix into the creamed mixture. Stir in walnuts and chocolate chips. Drop dough by teaspoonfuls onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until light brown on top, about 15 minutes. Cool on wire racks."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

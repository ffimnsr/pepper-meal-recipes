  "slug": "fresh-fruit-salad",
  "name": "Fresh Fruit Salad",
  "recipe_type": "salad",
  "brief_description": "This is a simple fruit salad with fresh berries, mango, banana, and orange. Add yogurt and maple syrup for extra flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss orange, mango, blueberries, strawberries, raspberries, and banana in a large bowl. Stir yogurt and syrup into the mixture to coat evenly. Sprinkle sugar over the salad; stir to serve."
    }
  ],

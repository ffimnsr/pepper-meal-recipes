  "slug": "corned-beef-special-sandwiches",
  "name": "Corned Beef Special Sandwiches",
  "recipe_type": null,
  "brief_description": "You\u2019ll love this corned beef sandwich recipe if you're a fan of Reuben. Served on untoasted rye bread, this sandwich uses coleslaw instead of sauerkraut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread 1/4 of the Russian salad dressing onto one side of each of four bread slices. Top each with 4 ounces corned beef, 2 ounces coleslaw, and remaining bread slices. Cut each sandwich in half diagonally and serve."
    }
  ],

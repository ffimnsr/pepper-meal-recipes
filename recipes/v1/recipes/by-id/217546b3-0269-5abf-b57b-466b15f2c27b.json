  "id": "217546b3-0269-5abf-b57b-466b15f2c27b",
  "slug": "homestyle-potato-chips",
  "name": "Homestyle Potato Chips",
  "recipe_type": "appetizer",
  "brief_description": "Homemade potato chips? Absolutely! They're golden, crispy, and delicious, and they smell heavenly. Plus you can use any oil and amount of salt you like.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Transfer potato slices to a large bowl of cold water as you slice them."
    },
    {
      "position": 3,
      "text": "Drain slices and rinse under cold water. Refill the bowl with water, add 3 tablespoons salt, and put slices back in the bowl. Let potatoes soak in the salty water for at least 30 minutes."
    },
    {
      "position": 4,
      "text": "Drain and rinse slices again. Pat dry."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep-fryer to 365 degrees F (185 degrees C)."
    },
    {
      "position": 6,
      "text": "Working in small batches, fry potato slices until golden. Remove with a slotted spoon and drain on paper towels. Continue until all of the slices are fried."
    },
    {
      "position": 7,
      "text": "Season potato chips with additional salt if desired."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,

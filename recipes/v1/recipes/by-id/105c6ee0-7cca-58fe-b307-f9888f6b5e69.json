{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "105c6ee0-7cca-58fe-b307-f9888f6b5e69",
  "slug": "one-pot-orzo-and-chicken-meatballs-recipe-11970246",
  "name": "One Pot Orzo and Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "I love one pan dinners, and these marry me chicken meatballs and orzo simmer in a version of the popular \u201cmarry me\u201d sauce. The chicken meatballs take a turn in the skillet, and afterward, orzo cooks in the sauce. The orzo and the meatballs \u201cget married\u201d near the end of the cook.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, 1/2 cup Parmesan cheese, granulated garlic, 1 teaspoon Italian seasoning, 1 teaspoon paprika, breadcrumbs, egg in a bowl; season with salt and pepper. Mix gently with clean hands, and form into 16 meatballs."
    },
    {
      "position": 2,
      "text": "Measure out 1 tablespoon oil from the sun-dried tomatoes and heat in a large, nonstick skillet over medium heat. Add meatballs and cook until lightly browned on all sides, 8 to 10 minutes. Remove to a plate and keep warm."
    },
    {
      "position": 3,
      "text": "Add the olive oil and butter to the same skillet; heat until butter stops sizzling and add uncooked orzo. Cook, stirring, until orzo is lightly toasted and fragrant, 2 to 3 minutes. Add garlic and cook about 30 seconds, stirring constantly."
    },
    {
      "position": 4,
      "text": "Add chicken stock and stir up any browned bits. Stir in remaining Italian herb seasoning blend, paprika, and red pepper flakes. Add cream and stir. Cover and cook over medium-low heat about 8 minutes."
    },
    {
      "position": 5,
      "text": "Add sundried tomatoes and remaining Parmesan cheese. When well blended, return meatballs to the skillet and simmer until the meatballs are heated through and the orzo is tender, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Garnish with fresh parsley and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

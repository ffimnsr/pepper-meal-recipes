  "id": "d8de1748-63d5-5f9c-912f-1d2286240bdd",
  "slug": "quick-chinese-style-vermicelli-rice-noodles",
  "name": "Quick Chinese-Style Vermicelli (Rice Noodles)",
  "recipe_type": "side",
  "brief_description": "Rice vermicelli are quick-cooking rice noodles. In this recipe, they get jazzed up with a spicy soy sauce glaze for a quick and delicious side dish.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water and bring to a rolling boil; stir in rice noodles and return to a boil. Cook until al dente, 2 to 3 minutes; try not to overcook as they will become mushy. Drain."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add garlic and saut\u00e9 until tender. Stir in noodles; season with soy sauce, chili sauce, salt, and pepper. Sprinkle with chopped green onion."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

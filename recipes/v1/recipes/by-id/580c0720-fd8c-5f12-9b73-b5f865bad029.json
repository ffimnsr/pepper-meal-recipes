  "id": "580c0720-fd8c-5f12-9b73-b5f865bad029",
  "slug": "roasted-butternut-squash-soup-recipe-6563399",
  "name": "Roasted Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This roasted butternut squash soup with coconut milk, fresh ginger, roasted garlic, and curry powder is creamy, comforting, and perfect for fall.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Wrap each garlic half in foil and place on the prepared baking sheet. Add squash, cut-side down. Add onion, leek, and ginger."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until vegetables are golden and squash skin is easily pierced with a fork, 45 minutes to 1 hour."
    },
    {
      "position": 4,
      "text": "Squeeze out roasted garlic cloves and scoop out squash flesh into a food processor or blender with onion, leek, and ginger. Add 2 cups broth and pur\u00e9e (in batches if necessary) until smooth. Transfer to a soup pot."
    },
    {
      "position": 5,
      "text": "Place the pot over medium heat and add remaining broth. Whisk in coconut milk, curry powder, and cayenne pepper. Season with salt and black pepper, and cook until heated through, about 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

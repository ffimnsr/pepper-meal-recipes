  "id": "d84ded26-7bdd-5bf9-a70b-6779c683afff",
  "slug": "tater-tot-hot-dish-ii",
  "name": "Tater Tot Hot Dish II",
  "recipe_type": "soup",
  "brief_description": "Layers of seasoned ground beef, tater tots, creamy soups and French-fried onion rings build a great autumn casserole.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large skillet cook ground beef with onion, salt and pepper; drain and spread into the bottom of a 9x13 inch baking dish. Add tater tots; mix cream of mushroom and cream of celery soup together and pour mixture over dish. Top with onion rings, if using."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

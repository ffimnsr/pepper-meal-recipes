  "id": "97d5a79c-39aa-58df-bb9f-a13677fcaf41",
  "slug": "spicy-orange-zest-beef",
  "name": "Spicy Orange Zest Beef",
  "recipe_type": "main",
  "brief_description": "While Chef John warns that it's not authentic Chinese or even Americanized Chinese, this easy stir-fry is a perfectly delicious dinner served over rice.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beef, orange juice, rice vinegar, soy sauce, hot chili paste, brown sugar, and garlic in a large bowl. Cover and refrigerate for 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "Strain beef in a colander set over a large bowl, allowing beef to drain thoroughly, about 5 minutes. Reserve marinade."
    },
    {
      "position": 3,
      "text": "Stir water and cornstarch into the bowl of marinade. Whisk until cornstarch is dissolved, set aside."
    },
    {
      "position": 4,
      "text": "Spray skillet with cooking spray and place over high heat. Cook beef for 1 minute without stirring; cook and stir for an additional minute."
    },
    {
      "position": 5,
      "text": "Stir in light parts of green onion and orange zest; cook for 30 seconds."
    },
    {
      "position": 6,
      "text": "Stir in marinade and green onion tops; cook and stir until beef is no longer pink inside and sauce is reduced and thick, about 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Season with salt and black pepper to taste."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

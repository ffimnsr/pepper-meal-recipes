  "id": "8b1d20e8-7c3d-5cd0-8080-70fbca9132a0",
  "slug": "air-fryer-sweet-potato-chips-recipe-7510177",
  "name": "Air Fryer Sweet Potato Chips",
  "recipe_type": "appetizer",
  "brief_description": "Use your air fryer to make these yummy sweet potato chips. The best chips came from a mandoline that was set just a hair thicker than 1/16 inch (about 3/32 inch thick) after much experimenting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice potato into 1/16-inch-thick rounds using a mandoline. Put potato slices in a large bowl of cold water; soak about 20 minutes. Drain and pat dry with paper towels. Wipe out bowl."
    },
    {
      "position": 2,
      "text": "Return potato slices to dried bowl. Add oil, salt, and pepper; toss gently to coat."
    },
    {
      "position": 3,
      "text": "Preheat air fryer to 350 degrees F (175 degrees C). Lightly coat air fryer basket with cooking spray. Working in batches if needed, arrange potato slices in an even layer in basket (do not overcrowd)."
    },
    {
      "position": 4,
      "text": "Cook until lightly golden and crispy, 12 to 16 minutes, turning and rearranging chips into an even layer every 4 minutes. Watch closely during the last 2 to 3 minutes of cooking. Check chips about every 30 seconds, using tongs to remove golden chips from the basket as needed to avoid overcooking and ending up with bitter chips."
    },
    {
      "position": 5,
      "text": "Let chips cool about 5 minutes. Chips will continue to crisp as they cool.Store in an airtight container up to 3 days."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

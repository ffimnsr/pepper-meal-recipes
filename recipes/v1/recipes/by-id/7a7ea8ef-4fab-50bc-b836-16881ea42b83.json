  "id": "7a7ea8ef-4fab-50bc-b836-16881ea42b83",
  "slug": "slow-cooker-thai-peanut-chicken-recipe-11880281",
  "name": "Slow Cooker Thai Peanut Chicken",
  "recipe_type": "main",
  "brief_description": "This slow cooker Thai peanut chicken dish is incredibly tasty. Super easy to throw together and the flavors are just incredible. Serve over rice with a little drizzle of extra Sriracha on top if you like some more heat.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together coconut milk, chicken broth, peanut butter, soy sauce, brown sugar, ginger, garlic, and salt in a 3 1/2- to 4-quart slow cooker until smooth."
    },
    {
      "position": 2,
      "text": "Add chicken to slow cooker; stir to combine."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 5 to 6 hours or on High for 2 1/2 to 3 hours, until an instant-read thermometer inserted into the thickest part of the chicken reads at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Stir together cornstarch and water in a small bowl. Add to the slow cooker, stirring until combined. Cover and cook on High for 15 minutes, or until thickened."
    },
    {
      "position": 5,
      "text": "Stir in lime juice, Sriracha, and fish sauce, if using."
    },
    {
      "position": 6,
      "text": "Garnish with peanuts, cilantro, and additional Sriracha. Serve with lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 315,
  "preparation_time_minutes": 15,

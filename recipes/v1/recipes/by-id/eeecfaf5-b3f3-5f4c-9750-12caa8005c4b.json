  "id": "eeecfaf5-b3f3-5f4c-9750-12caa8005c4b",
  "slug": "fresh-broccoli-salad",
  "name": "Broccoli Salad",
  "recipe_type": "salad",
  "brief_description": "This easy broccoli salad, with crispy bacon, red onion, almonds, raisins, and a creamy, sweet, and tangy dressing, is perfect for holiday potlucks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place bacon in a deep skillet and cook over medium-high heat until evenly brown, 7 to 10 minutes; drain, cool, and crumble."
    },
    {
      "position": 3,
      "text": "Combine bacon, broccoli, onion, raisins, and almonds together in a bowl; mix well."
    },
    {
      "position": 4,
      "text": "To make the dressing: Mix mayonnaise, sugar, and vinegar together until smooth."
    },
    {
      "position": 5,
      "text": "Stir dressing into the salad until broccoli is evenly coated."
    },
    {
      "position": 6,
      "text": "Serve immediately or chill the salad before serving, as desired. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "cbaafb6b-2108-5a67-9520-b29b8d2bf01a",
  "slug": "gluten-free-gingersnap-cookies",
  "name": "Gluten-Free Gingersnap Cookies",
  "recipe_type": "dessert",
  "brief_description": "Made with gluten-free ingredients and fresh ginger, these gingersnap cookies are great for holiday parties and potlucks.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter, brown sugar, and 1/2 cup cane sugar together in a bowl using an electric mixer until creamy. Add egg and mix to combine. Mix in molasses and vanilla extract."
    },
    {
      "position": 2,
      "text": "Mix oat flour, almond flour, coconut flour, fresh ginger, ground ginger, baking soda, 1 teaspoon cinnamon, 1 teaspoon nutmeg, and cloves together in a separate bowl. Add to butter mixture slowly and combine. Refrigerate dough for at least 1 hour, to overnight; dough will be very wet before it's chilled."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 large baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Combine 1/4 cup cane sugar, 1/2 teaspoon cinnamon, and 1/4 teaspoon nutmeg in a shallow dish."
    },
    {
      "position": 5,
      "text": "Scoop dough by tablespoonfuls and roll into balls. Roll balls in cinnamon-sugar mixture to coat and place onto the prepared baking sheets, making sure not to overcrowd the sheets as they will flatten and spread."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until set and golden, 10 to 12 minutes. Let cookies sit for 5 minutes before transferring to a wire rack to cool. Serve warm or let cool completely before storing in an airtight container."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

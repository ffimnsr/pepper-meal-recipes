  "slug": "eastern-north-carolina-bbq-sauce",
  "name": "Eastern North Carolina BBQ Sauce",
  "recipe_type": "side",
  "brief_description": "This Carolina vinegar BBQ sauce requires no cooking and is simple to make with cider vinegar, white vinegar, brown sugar, cayenne, and hot sauce.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine white vinegar, cider vinegar, brown sugar, cayenne pepper, hot pepper sauce, salt, and pepper in a jar or bottle with a tight-fitting lid; shake well."
    },
    {
      "position": 2,
      "text": "Refrigerate sauce, shaking occasionally, until flavors blend, 1 to 2 days. Store in the refrigerator for up to 2 months."
    }
  ],
  "servings": 32,

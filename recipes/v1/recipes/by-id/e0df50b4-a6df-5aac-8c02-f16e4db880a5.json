  "schema_version": 1,
  "id": "e0df50b4-a6df-5aac-8c02-f16e4db880a5",
  "slug": "grilled-pheasant-poppers",
  "name": "Grilled Pheasant Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These grilled pheasant poppers are easy to make with jalape\u00f1o peppers and bacon for a spicy, crisp, and delicious appetizer that always gets rave reviews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut pheasant breast into 36 pieces and place into a large bowl. Pour liquid from jalape\u00f1o peppers over pheasant; stir and marinate at room temperature for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Drain marinade from pheasant and discard. Place a jalape\u00f1o pepper slice on each piece of pheasant breast and wrap with 1/3 of a bacon strip. Skewer 6 bacon-wrapped pheasant pieces onto each skewer."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill, turning frequently, until bacon is crispy, 15 to 20 minutes. Remove pheasant pieces from the skewers and insert a toothpick into each piece to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

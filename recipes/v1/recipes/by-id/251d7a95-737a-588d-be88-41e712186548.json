  "id": "251d7a95-737a-588d-be88-41e712186548",
  "slug": "easy-cheese-and-garlic-scones",
  "name": "Easy Cheese and Garlic Scones",
  "recipe_type": "soup",
  "brief_description": "This is my favorite, very simple, recipe for savory scones. They are wonderful served hot, spread with a little butter, and eaten alongside a steamy hot soup. It's important not to over handle these scones, as they will be heavy and tough.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "In a large bowl, sift together flour and salt. Rub in butter lightly with finger tips until mixture resembles coarse breadcrumbs. Stir in cheese and garlic. Make a well in the center of the mixture and pour in the milk, reserving 1 teaspoon for a glazing the scones. Gently mix, just until combined."
    },
    {
      "position": 3,
      "text": "Turn out onto a lightly floured board and knead briefly and lightly. Be careful not to overwork the dough. Press out dough to form a 1 inch thick round. Cut into 8 wedges. Place on prepared tray and brush with reserved milk."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 10 to 20 minutes, or until light brown. Serve hot or let cool on a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

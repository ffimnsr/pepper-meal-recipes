  "id": "03781394-a958-5194-bc19-6d335aa0658f",
  "slug": "ez-restaurant-style-hummus",
  "name": "EZ Restaurant-Style Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This easy recipe for restaurant-style hummus uses some of the chickpea soaking liquid, aquafaba, to make an extra creamy, lemony dip.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place garbanzo beans, 1 1/2 tablespoon reserved aquafaba, and lemon juice in a food processor. Let soak until flavors combine, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Pulse soaked garbanzo beans until roughly chopped. Add tahini, olive oil, garlic, cayenne, sugar, salt, and black pepper; blend, thinning with reserved aquafaba, until hummus is smooth and reaches desired consistency."
    }
  ],
  "servings": 24,

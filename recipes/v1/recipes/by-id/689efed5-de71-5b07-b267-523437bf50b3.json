  "id": "689efed5-de71-5b07-b267-523437bf50b3",
  "slug": "italian-sausage-ravioli-bake",
  "name": "Italian Sausage Ravioli Bake",
  "recipe_type": "soup",
  "brief_description": "This baked ravioli with Italian sausage, tomatoes, chicken broth, fresh basil, and spaghetti sauce is an easy dinner to make on a busy weeknight.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch dish and set aside."
    },
    {
      "position": 2,
      "text": "Cook Italian sausage in a skillet over medium-high heat until browned and crumbly, 5 to 10 minutes. Drain off grease. Add spaghetti sauce, diced tomatoes, beef broth, Italian dressing, and sugar. Mix until well combined. Remove from heat and add uncooked ravioli; stir to combine. Pour into the prepared dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until ravioli are tender, 45 to 55 minutes."
    },
    {
      "position": 4,
      "text": "Top with mozzarella cheese and let sit until cheese is melted. Sprinkle with basil before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "a21a1998-7646-50f8-a990-0c7d8865d06b",
  "slug": "greek-pasta-salad-with-roasted-vegetables-and-feta",
  "name": "Greek Pasta Salad with Roasted Vegetables and Feta",
  "recipe_type": "salad",
  "brief_description": "This salad is best served warm so all of the fabulous flavors can strut their stuff. The veggies are roasted for this salad and then combined with bow tie pasta, arugula, sun-dried tomatoes, basil, and a splash of olive oil.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Line a cookie sheet with foil, and spray with non-stick cooking spray."
    },
    {
      "position": 2,
      "text": "In a medium bowl toss the red bell pepper, yellow bell pepper, eggplant, and squash with 2 tablespoons of the olive oil, salt, and pepper. Arrange on the prepared cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake vegetables 25 minutes in the preheated oven, tossing occasionally, until lightly browned."
    },
    {
      "position": 4,
      "text": "In a large pot of salted boiling water, cook pasta 10 to 12 minutes, until al dente, and drain."
    },
    {
      "position": 5,
      "text": "Drain the softened sun-dried tomatoes and reserve the water. In a large bowl, toss together the roasted vegetables, cooked pasta, sun-drained tomatoes, arugula, and basil. Mix in remaining olive oil, reserved water from tomatoes, balsamic vinegar, garlic, and feta cheese; toss to coat. Season with salt and pepper to taste. Serve immediately, or refrigerate until chilled."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

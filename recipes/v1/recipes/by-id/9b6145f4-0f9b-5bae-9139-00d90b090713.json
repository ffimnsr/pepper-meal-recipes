  "id": "9b6145f4-0f9b-5bae-9139-00d90b090713",
  "slug": "easy-minestrone-soup",
  "name": "Easy Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "Using leftover marinara sauce is a smart shortcut in this easy minestrone soup packed with beans and veggies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot or Dutch oven over medium-high heat until shimmering. Add celery, carrots, and onion. Cook, stirring frequently, until onion begins to turn translucent, about 4 minutes. Add garlic and stir until fragrant, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Add vegetable broth, marinara sauce, tomato paste, and Italian seasoning. Stir to combine. Bring to a boil. Reduce heat to medium-low and simmer, uncovered, until carrots are soft, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Add pasta and zucchini. Cook until pasta is tender, about 10 minutes. Stir in beans, kale, salt, and pepper. Remove from heat and allow soup to cool slightly. Spoon into individual bowls and garnish with Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

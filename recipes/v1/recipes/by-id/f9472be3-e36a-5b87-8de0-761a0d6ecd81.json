  "id": "f9472be3-e36a-5b87-8de0-761a0d6ecd81",
  "slug": "new-england-clam-chowder-ii",
  "name": "New England Clam Chowder II",
  "recipe_type": "soup",
  "brief_description": "Bottled clam juice is the secret ingredient for this extra-flavorful chowder. Otherwise, this is a fairly standard chowder recipe with lots of potatoes, bacon, and onions.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "In a large saucepan over medium high heat, fry the bacon until crisp, about 10 minutes. Drain on paper towels, reserving the bacon fat in the pan, crumble and set aside."
    },
    {
      "position": 2,
      "text": "In the same saucepan with the bacon fat, saute the onion and potatoes for 3 to 5 minutes. Sprinkle with the flour and stir well to coat."
    },
    {
      "position": 3,
      "text": "Pour in the clam juice, bring to a boil, reduce heat to low and simmer for about 15 minutes, or until potatoes are tender."
    },
    {
      "position": 4,
      "text": "Add the half-and-half and minced clams and season with salt and pepper to taste. Finally, whisk in the heavy cream, if desired. Allow to heat through, about 5 minutes. Garnish with the parsley and crumbled bacon. (Note: Do not boil if adding cream.)"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

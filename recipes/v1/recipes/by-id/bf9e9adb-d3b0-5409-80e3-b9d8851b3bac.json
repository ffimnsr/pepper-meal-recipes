  "id": "bf9e9adb-d3b0-5409-80e3-b9d8851b3bac",
  "slug": "southwestern-breakfast-burrito",
  "name": "Southwestern Breakfast Burrito",
  "recipe_type": "breakfast",
  "brief_description": "This low carb breakfast is quick and easy. This is a tasty breakfast with plenty of protein and fiber. Take the tortillas out of the refrigerator so that can come to room temperature while you prepare the filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a mixing bowl, beat the eggs with the cream, salsa, cumin and a pinch of salt and pepper."
    },
    {
      "position": 2,
      "text": "In a non stick skillet over medium-high heat, melt the butter and then scramble the eggs. Just before they are set, add the cheese and fold-in until it begins to melt."
    },
    {
      "position": 3,
      "text": "Lay the tortillas on a flat surface. Divide the eggs equally between the two and place on the bottom third of each tortilla. Fold the bottom third over tucking in. Fold in the two sides and then roll up. Serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "c1189037-ef21-5ea2-9caf-d76be76e3e97",
  "slug": "tamarind-margarita-recipe-7966103",
  "name": "Tamarind Margarita",
  "recipe_type": "dessert",
  "brief_description": "This tamarind margarita is a sweet-tart twist on a classic margarita made with tamarind paste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle chili-lime seasoning onto a plate. Moisten the rim of a glass with the lime wedge. Press the moistened rim into the seasoning. Fill glass with ice."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker half-full with ice. Add tamarind paste, tequila, agave nectar, lime juice and triple sec to the shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds. Strain mixture into the glass. Garnish with the lime wedge."
    }
  ],

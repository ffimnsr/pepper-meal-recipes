  "id": "81c578c3-dd36-5399-a299-b26233f4127d",
  "slug": "chicken-tetrazzini-i",
  "name": "Creamy Chicken Tetrazzini",
  "recipe_type": "soup",
  "brief_description": "Chicken, mushrooms, cream of chicken soup, sour cream, and spaghettini come together in this easy, comforting baked casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Break spaghettini into 1 inch pieces. Cook according to package directions; drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook mushrooms in butter until softened. Cut cooked chicken into large pieces and mix with mushrooms. Stir in sour cream and condensed soup. Fold in spaghettini. Transfer mixture to a buttered casserole dish and sprinkle with Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 40 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

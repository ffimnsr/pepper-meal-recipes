  "id": "12efb8ed-fd2c-527d-813f-daefa6edbaa0",
  "slug": "absolute-mexican-cornbread",
  "name": "Absolute Mexican Cornbread",
  "recipe_type": "main",
  "brief_description": "This Mexican cornbread is the best. Moist and packed with flavor from bits of corn, chiles, and cheese baked in for a tasty spin on a classic dish.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat together butter and sugar in a large bowl."
    },
    {
      "position": 3,
      "text": "Beat in eggs one at a time."
    },
    {
      "position": 4,
      "text": "Blend in corn, chiles, Monterey Jack cheese, and Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Stir together flour, cornmeal, baking powder, and salt in a separate bowl. Add flour mixture to corn mixture; stir until smooth."
    },
    {
      "position": 6,
      "text": "Pour batter into the prepared pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 1 hour, or until a toothpick inserted into the center of the pan comes out clean."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

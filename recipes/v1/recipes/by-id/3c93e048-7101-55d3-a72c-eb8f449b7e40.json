  "id": "3c93e048-7101-55d3-a72c-eb8f449b7e40",
  "slug": "very-easy-potato-bacon-soup",
  "name": "Very Easy Potato Bacon Soup",
  "recipe_type": "soup",
  "brief_description": "This potato bacon soup recipe is quick and easy to make with onion, milk, dill, and parsley for a hearty meal that will impress your whole family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over medium heat; cook and stir onion in hot butter until lightly browned, about 10 minutes. Add potatoes, water, dill weed, salt, and pepper; bring to a boil. Reduce heat and simmer until potatoes are tender and water is almost all evaporated, at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Stir milk and bacon bits into potato mixture; bring to a boil. Remove from heat and stir parsley into soup."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

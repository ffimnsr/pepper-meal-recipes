{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "77bd542c-6ce9-523f-b1f8-c5495d3f5dd7",
  "slug": "fried-pork-chop",
  "name": "Fried Pork Chops",
  "recipe_type": "main",
  "brief_description": "These fried pork chops are flavorfully seasoned, then pan-fried until golden brown and juicy for a delicious home-cooked meal ready in 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat."
    },
    {
      "position": 2,
      "text": "Combine flour, seasoning salt, salt, and pepper in a paper or plastic bag."
    },
    {
      "position": 3,
      "text": "Place pork chops in the bag and shake to coat. Shake off any excess flour."
    },
    {
      "position": 4,
      "text": "Fry chops in hot oil until golden on the outside and juices run clear, 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Drain on a wire rack or paper towels before serving."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "7a0fd6bc-218f-5575-92ba-f2510ad04e72",
  "slug": "chocolate-chip-muffins",
  "name": "Chocolate Chip Muffins",
  "recipe_type": "snack",
  "brief_description": "These chocolate chip muffins are moist, tender, and deliciously chocolaty. You won't believe how easily and quickly you can have them on the table!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine milk, oil, and egg in a small bowl until well blended."
    },
    {
      "position": 3,
      "text": "Combine flour, 1/2 cup sugar, baking powder, and salt together in a large bowl, making a well in the center."
    },
    {
      "position": 4,
      "text": "Pour milk mixture into well and stir until batter is just combined; fold in chocolate chips."
    },
    {
      "position": 5,
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 6,
      "text": "Combine 1 \u00bd tablespoons white sugar and 1 tablespoon brown sugar in a small bowl; sprinkle on tops of muffins."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 18 to 20 minutes."
    },
    {
      "position": 8,
      "text": "Cool in the tin briefly, then transfer to a wire rack. Serve warm or cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "67c3f09b-8cc5-589e-9d08-1ca376898900",
  "slug": "hot-dog-brown-bears-recipe-12001902",
  "name": "Hot Dog Brown Bears",
  "recipe_type": "main",
  "brief_description": "Hot dog brown bears are baked hot dogs, snug in a blanket of crescent roll dough and brushed with garlic butter. The dogs are easy to wrap and quick to bake\u2014serve them with mustard for a delicious dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a small baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Roll out crescent dough on a silicon mat. Press 2 triangles together to form a rectangle; and repeat with 6 other triangles to make 4 rectangles total."
    },
    {
      "position": 3,
      "text": "Place a hot dog in the middle of each rectangle. Fold up 1 side to completely cover the hot dog, and fold the ends in. Fold up the other side to completely cover the hot dog. Press on the dough seams to seal. Repeat with remaining dough and hot dogs. Place each hot dog parcel on the baking sheet."
    },
    {
      "position": 4,
      "text": "Stir melted butter and granulated garlic together in a small bowl. Brush each dog liberally with garlic butter. Sprinkle each parcel with Parmesan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly golden brown, about 10 minutes. Remove from the oven and gently turn over. Bake until top is golden, about 10 minutes more. Garnish with parsley; serve warm with mustard."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

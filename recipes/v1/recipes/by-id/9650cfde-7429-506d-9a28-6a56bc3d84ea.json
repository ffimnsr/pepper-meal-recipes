  "id": "9650cfde-7429-506d-9a28-6a56bc3d84ea",
  "slug": "roasted-chicken-with-risotto-and-caramelized-onions",
  "name": "Roasted Chicken with Risotto and Caramelized Onions",
  "recipe_type": "soup",
  "brief_description": "This chicken risotto recipe features creamy Arborio rice cooked in white wine and broth, mixed with tender, roasted chicken and caramelized onions.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in a medium saucepan over medium heat. Saut\u00e9 onion in hot oil until dark golden brown, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and stir in balsamic vinegar; set aside."
    },
    {
      "position": 3,
      "text": "Heat remaining 2 tablespoons olive oil in a large skillet over medium heat. Cook and stir rice in hot oil for 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour in wine while stirring. Reduce heat to medium-low."
    },
    {
      "position": 5,
      "text": "Pour in 1 cup hot broth; cook and stir until broth is absorbed."
    },
    {
      "position": 6,
      "text": "While stirring constantly, continue adding remaining broth, 1 cup at a time, until all broth is absorbed and rice is tender yet firm to the bite, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Stir in reserved onion mixture until heated through. Remove from heat."
    },
    {
      "position": 8,
      "text": "Stir in chicken and butter; season with salt and pepper. Garnish each serving with thyme."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

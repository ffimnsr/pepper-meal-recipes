  "id": "9bc8d77f-6a55-5f20-a8b6-e8d0eabf9012",
  "slug": "fluffy-low-fat-vegan-blueberry-muffins",
  "name": "Fluffy Low-Fat Vegan Blueberry Muffins",
  "recipe_type": "appetizer",
  "brief_description": "Baking the perfect vegan blueberry muffins is possible with soy milk and applesauce for moisture, dates for sweetness, and oats for texture.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy milk, water, dates, and flax seeds in a bowl."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine ground oats, brown sugar, baking powder, and cinnamon in a large bowl."
    },
    {
      "position": 4,
      "text": "Combine the date mixture, applesauce, and vanilla extract in a blender. Blend until evenly mixed; pour into the bowl with the oat mixture. Stir until no dry spots remain. Fold in blueberries. Pour batter into a 12-cup muffin tin."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes. Let cool in the tin."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

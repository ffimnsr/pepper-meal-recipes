  "id": "dcf686d9-d009-502c-9894-47a244c25bcd",
  "slug": "halloween-spiderweb-layered-dip",
  "name": "Halloween Spiderweb Layered Dip",
  "recipe_type": "appetizer",
  "brief_description": "This easy and delicious 5-layer dip recipe is decorated spookily with a spider web for Halloween!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread guacamole in the bottom of a round serving dish in an even layer."
    },
    {
      "position": 2,
      "text": "Mix 1 cup of the sour cream with the taco seasoning in a bowl. Spread the seasoned sour cream mixture evenly over the guacamole layer."
    },
    {
      "position": 3,
      "text": "Sprinkle cheese on top of the sour cream, then pour salsa evenly over the cheese, covering ot completely."
    },
    {
      "position": 4,
      "text": "Pour refried beans into a microwave-safe container and warm until softened (this will make it easier to spread). Spread over the top of the salsa layer, leaving about 1 inch of the salsa showing around the edge of the dish."
    },
    {
      "position": 5,
      "text": "Place the remaining 1/2 cup of sour cream into a piping bag, or a plastic bag with the corner snipped off. Pipe a spiderweb pattern on top of the bean layer."
    },
    {
      "position": 6,
      "text": "Add a spider to the top by cutting the large black olive in half lengthwise to make the spider's body. Cut four of the sliced olives in half to create eight legs. Arrange the pieces on top of the web."
    },
    {
      "position": 7,
      "text": "Arrange the remaining sliced black olives and the chopped green onions around the edge of the dip."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b4c960f2-99cd-5107-b046-787791f2945d",
  "slug": "cajun-shrimp-and-sausage-alfredo",
  "name": "Cajun Shrimp and Sausage Alfredo",
  "recipe_type": "main",
  "brief_description": "This shrimp and sausage Alfredo recipe combines Creole seasoning, shrimp, and sausage to make an easy and filling dish that your family will love.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter and olive oil in a large skillet pan over medium-high heat. Add sausage, frozen vegetables, and mushrooms. Saut\u00e9 until sausage is almost fully cooked, onions are tender, and any liquid from frozen vegetables has almost fully evaporated, 10 to 12 minutes. Stir in Creole seasoning, garlic, and pepper; cook for 2 minutes. Add shrimp, Alfredo sauce, and Parmesan cheese. Cook and stir until sauce has thickened and shrimp are bright pink on the outside and meat is opaque, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, 8 to 10 minutes. Drain fettuccine, top with shrimp-sausage mixture, and sprinkle with bread crumbs and parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

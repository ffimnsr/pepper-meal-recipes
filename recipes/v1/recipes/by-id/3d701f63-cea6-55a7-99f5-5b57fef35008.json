{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3d701f63-cea6-55a7-99f5-5b57fef35008",
  "slug": "chicken-and-spinach-alfredo-lasagna",
  "name": "Chicken and Spinach Alfredo Lasagna",
  "recipe_type": "main",
  "brief_description": "This creamy white chicken lasagna with shredded chicken, spinach, Alfredo sauce, and three Italian cheeses is a delicious twist on classic lasagna.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook until al dente, about 8 to 10 minutes. Drain, and rinse with cold water."
    },
    {
      "position": 3,
      "text": "Mix heavy cream, cream of mushroom soup, Parmesan cheese, and butter in a saucepan over low heat; simmer, stirring frequently, until well blended."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a skillet over medium heat. Cook and stir onion in olive oil until tender, then add garlic and mushrooms."
    },
    {
      "position": 5,
      "text": "Mix in chicken, and cook until heated through. Season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Lightly coat the bottom of a 9x13-inch baking dish with enough of the cream sauce mixture to coat."
    },
    {
      "position": 7,
      "text": "Layer with 1/3 of the lasagna noodles, 1/2 cup ricotta, 1/2 of the spinach."
    },
    {
      "position": 8,
      "text": "Add 1/2 the chicken mixture, and 1 cup mozzarella. Top with 1/3 the cream sauce mixture, and repeat the layers."
    },
    {
      "position": 9,
      "text": "Place the remaining noodles on top, and spread with remaining sauce."
    },
    {
      "position": 10,
      "text": "Bake 1 hour in the preheated oven, or until brown and bubbly. Top with the remaining mozzarella, and continue baking until cheese is melted and lightly browned."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

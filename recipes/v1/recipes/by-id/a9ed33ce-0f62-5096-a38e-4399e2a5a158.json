  "id": "a9ed33ce-0f62-5096-a38e-4399e2a5a158",
  "slug": "baked-pasta",
  "name": "Baked Pasta",
  "recipe_type": "main",
  "brief_description": "This oven-baked pasta is a hearty ground beef and pasta casserole in a creamy tomato sauce flavored with brown gravy, perfect for chilly evenings.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large frying pan or Dutch oven over medium-high heat. Cook and stir ground beef in the hot pan until browned and crumbly, 5 to 7 minutes. Add tomato sauce, gravy, half-and-half, Parmesan cheese, garlic, oregano, and basil. Simmer for 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil. Stir in ziti, bring back to a boil, and cook pasta over medium heat until tender yet firm to the bite, 10 to 12 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Stir ziti into meat sauce, then spread into the prepared baking dish. Sprinkle top with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly, 20 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d0616fa4-25c6-5e65-bcfd-84069fd0ea11",
  "slug": "dirty-martini-pasta-salad-recipe-12018934",
  "name": "Dirty Martini Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This dirty martini pasta salad is unlike any you\u2019ve ever had. With the briny, bright tang of a dirty martini, it\u2019s sure to be a hit at your next BBQ party or summer gathering. Just for fun, consider serving the pasta salad in a martini glass.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil, add pasta, and cook until al dente according to package instructions. Drain and rinse well with cold water."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine chopped olives and vermouth, and set aside. For dressing, whisk olive brine, lemon juice, garlic, and Dijon together in a large bowl. Gradually whisk in olive oil until well blended."
    },
    {
      "position": 3,
      "text": "Add pasta, olives with vermouth, Parmesan, and parsley, and toss until pasta is well coated. Season with salt and freshly ground black pepper, and gently stir in feta or blue cheese."
    },
    {
      "position": 4,
      "text": "Refrigerate for at least 30 minutes before serving. Store in the refrigerator in an airtight container, and serve chilled."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c43fce88-aeab-5edd-a2ac-bae70981cad1",
  "slug": "frozen-strawberry-salad",
  "name": "Frozen Strawberry Dessert Salad",
  "recipe_type": "salad",
  "brief_description": "This crowd-pleasing strawberry dessert salad is made with strawberries, pineapple, and cream cheese then frozen for a delicious summer treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese and sugar in a bowl; add strawberries and pineapple. Fold in the whipped topping."
    },
    {
      "position": 2,
      "text": "Line a loaf pan with parchment paper. Pour the strawberry mixture into the loaf pan."
    },
    {
      "position": 3,
      "text": "Place in the freezer until firm, about 6 hours. Set loaf pan in a warm water bath to loosen. Flip mixture onto a cutting board to remove; cut into slices."
    }
  ],
  "servings": 16,

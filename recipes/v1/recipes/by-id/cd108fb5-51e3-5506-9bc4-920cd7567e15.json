  "id": "cd108fb5-51e3-5506-9bc4-920cd7567e15",
  "slug": "swamp-dogs-recipe-12006614",
  "name": "Swamp Dogs",
  "recipe_type": "main",
  "brief_description": "These swamp dogs, scored and marinated with onions in a savory, Cajun-seasoned marinade, cook in a cast iron skillet. Serve them in hot dog buns with plenty of saucy onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Using a sharp knife, make shallow diagonal cuts across one side of each hot dog, 1/8 to 1/4 inch deep and 1/4 inch apart."
    },
    {
      "position": 2,
      "text": "Place scored hot dogs in a large resealable plastic bag and add dressing, Worcestershire, Cajun seasoning, and onions. Seal bag tightly, and turn to coat everything thoroughly. Refrigerate for at least 8 hours, or overnight for best flavor, flipping the bag occasionally."
    },
    {
      "position": 3,
      "text": "Preheat a large cast iron or metal skillet over medium-high heat."
    },
    {
      "position": 4,
      "text": "Remove the hot dogs from the marinade, letting excess drip off, and add to the hot pan. Reserve onions and marinade. Cook, undisturbed, until browned on one side, about 2 minutes. Rotate the hot dogs and cook until mostly browned, 2 to 3 more minutes."
    },
    {
      "position": 5,
      "text": "Add reserved marinade and onions to the pan and cook, stirring occasionally, about 2 minutes. Add water to deglaze the pan and cook, stirring to loosen any browned bits from the pan. Reduce heat to medium-low and simmer until onions are very tender, 10 to 15 minutes, stirring occasionally."
    },
    {
      "position": 6,
      "text": "Stir in ketchup and mustard and simmer a few minutes longer."
    },
    {
      "position": 7,
      "text": "Serve hot dogs on buns topped with plenty of saucy onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

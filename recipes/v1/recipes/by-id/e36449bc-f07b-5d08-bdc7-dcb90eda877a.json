  "name": "Copycat Chick-Fil-A Honey Mustard",
  "recipe_type": "salad",
  "brief_description": "Now you can make this distinct, addictive copycat version of Chick-Fil-A honey mustard at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mustard, honey, corn syrup, molasses, tamarind paste, and salt in a bowl until well blended. Chill until ready to serve. Store in an airtight container in the refrigerator up to 2 weeks."
    }
  ],

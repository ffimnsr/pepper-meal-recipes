  "id": "37e53042-8df2-594d-bf01-a42b918eb74d",
  "slug": "quick-and-easy-spanish-rice",
  "name": "Quick and Easy Spanish Rice",
  "recipe_type": "drink",
  "brief_description": "This quick and easy Spanish rice uses instant rice, vegetable juice, and taco seasoning for a spicy side dish.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir onion, garlic, and vegetable oil in a skillet over medium heat until onions are softened, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir rice into onion mixture and cook, stirring often, until rice becomes slightly opaque, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir chicken broth, vegetable juice, and taco seasoning into rice mixture and bring to a boil. Cover and simmer over low heat until rice has absorbed most of the liquid, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "slug": "cherry-cheese-pie-i",
  "name": "No-Bake Cherry Cheese Pie",
  "recipe_type": "dessert",
  "brief_description": "This cherry cream cheese pie without condensed milk features cream cheese and whipped topping folded together to make this no-bake pie light and fluffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium mixing bowl, beat together softened cream cheese and sugar until light and fluffy. Fold in whipped topping and blend until mixture is smooth. Spread into graham cracker crust and spoon pie filling over top. Cover with plastic wrap and chill 2 hours before serving."
    }
  ],
  "servings": 8,

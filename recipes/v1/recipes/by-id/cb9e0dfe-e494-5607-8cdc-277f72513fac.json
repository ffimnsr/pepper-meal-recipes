  "id": "cb9e0dfe-e494-5607-8cdc-277f72513fac",
  "slug": "copycat-taco-bell-nacho-fries-recipe-11895073",
  "name": "Copycat Taco Bell Nacho Fries",
  "recipe_type": "appetizer",
  "brief_description": "These copycat Taco Bell nacho fries are just like the real fast food thing, but easy, faster, and more convenient when you make them at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes. Stir paprika, garlic powder, onion powder, and salt together in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Add fries to the air fryer basket, and fry for 5 minutes. Shake, then fry for 5 more minutes. Shake out into a large bowl. Season to taste with paprika mixture. Toss to combine and let rest while you make the sauce."
    },
    {
      "position": 3,
      "text": "Tear cheese into small pieces and put in a microwave-safe bowl. Add milk and hot sauce. Microwave on Melt (Low) until just melted; stir to combine. Serve on the side with fries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

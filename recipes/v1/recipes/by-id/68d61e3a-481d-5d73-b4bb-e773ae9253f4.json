  "id": "68d61e3a-481d-5d73-b4bb-e773ae9253f4",
  "slug": "seafood-mac-and-cheese-recipe-11747757",
  "name": "Seafood Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This creamy seafood mac and cheese with lobster, crab, Gruyère cheese, and a splash of white wine takes comfort food to a new level.",
  "cuisine": "American Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Reserve 2 cups cooking water; drain macaroni. Rinse with cold water; drain again."
    },
    {
      "position": 3,
      "text": "Return reserved pasta water to pot; add lobster tails. Bring to a boil; reduce heat to medium-low, cover, and steam until lobster meat is firm and opaque, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Transfer lobster tails to a tray; let cool 2 to 3 minutes. Remove meat and cut into bite-size pieces. Rinse pot."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine Gruyère, Swiss, and flour in a large bowl."
    },
    {
      "position": 6,
      "text": "Melt 1 tablespoon butter in the empty pasta pot over medium heat. Add shallot and garlic; cook, stirring occasionally, until shallot is softened, about 3 minutes. Gradually add milk and wine; heat just until bubbles form around edge of pot. Gradually whisk in cheese mixture, 1 cup at a time, just until cheese is melted; mixture may not be completely smooth at this point. Remove from heat. Stir in lobster, crabmeat, 1 teaspoon seafood seasoning, and pepper. Stir in macaroni."
    },
    {
      "position": 7,
      "text": "Pulse bread cubes in a food processor to get large coarse crumbs. Melt remaining 3 tablespoons butter; stir in remaining 1/2 teaspoon seafood seasoning. Add bread crumbs; toss to combine."
    },
    {
      "position": 8,
      "text": "Pour macaroni mixture into prepared baking dish. Top with bread crumb mixture."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until hot and bubbly and top is golden brown, 15 to 20 minutes. Garnish with chives and additional seafood seasoning. Serve with lemon wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

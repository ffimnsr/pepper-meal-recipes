  "id": "556a5535-fc5f-5b56-b2d2-54790b4ee960",
  "slug": "siopao-filipino-steamed-buns",
  "name": "Siopao (Filipino Steamed Buns)",
  "recipe_type": "side",
  "brief_description": "Make the best siopao, popular Filipino steamed buns, with this recipe for the perfect fluffy, chewy dough that's relatively quick to rise.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, sugar, salt, and yeast together in a large bowl. Add water and 1/4 cup oil; mix into a dough. Knead until smooth and elastic, at least 10 minutes. Dust with extra flour if necessary."
    },
    {
      "position": 2,
      "text": "Warm up the oven for 1 minute. Turn oven off."
    },
    {
      "position": 3,
      "text": "Oil a large bowl; place dough inside and cover with cheesecloth. Place in the warmed oven until size has doubled, about 1 hour."
    },
    {
      "position": 4,
      "text": "Punch down dough. Keep in the oven until risen, at least 15 minutes more. Knead dough onto a flat work surface and divide into 12 golf-sized balls. Roll out each ball and fill with choice of filling (see footnote for my chicken and pork filling). Gather and twist the edges together to secure the filling."
    },
    {
      "position": 5,
      "text": "Place each siopao on a 3x3-inch piece of wax paper."
    },
    {
      "position": 6,
      "text": "Place siopao in a steamer and steam for 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "336ec139-fe05-5fc0-b75d-d8c498bcbdd8",
  "slug": "air-fryer-chicken-katsu-with-homemade-katsu-sauce",
  "name": "Air Fryer Chicken Katsu with Homemade Katsu Sauce",
  "recipe_type": "side",
  "brief_description": "Air fryer chicken katsu with homemade sauce is a quick and easy dish \u2014 perfectly crispy on the outside, tender and juicy on the inside, and delicious.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Prepare sauce: Whisk ketchup, soy sauce, brown sugar, sherry, Worcestershire sauce, and garlic together in a bowl until sugar has dissolved. Set katsu sauce aside. Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Meanwhile, lay chicken pieces on a clean work surface. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Place beaten eggs in a flat dish or shallow bowl. Pour bread crumbs into a second flat dish. Dredge chicken pieces in egg and then in bread crumbs. Repeat by dredging chicken in egg and then bread crumbs again, pressing down so the bread crumbs stick to the chicken."
    },
    {
      "position": 5,
      "text": "Place chicken pieces in the basket of the preheated air fryer. Spray the tops with nonstick cooking spray."
    },
    {
      "position": 6,
      "text": "Air fry for 10 minutes. Flip chicken pieces over using a spatula and spray the tops with nonstick cooking spray. Cook for 8 minutes more. Transfer chicken to a cutting board and slice. Serve with katsu sauce."
    },
    {
      "position": 7,
      "text": "Serve with katsu sauce and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

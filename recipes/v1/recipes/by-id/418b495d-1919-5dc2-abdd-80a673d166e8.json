  "id": "418b495d-1919-5dc2-abdd-80a673d166e8",
  "slug": "bacon-stuffed-french-toast-sliders-recipe-8674932",
  "name": "Bacon-Stuffed French Toast Sliders",
  "recipe_type": "dessert",
  "brief_description": "These French toast sliders stuffed with bacon and maple syrup make a terrific smoky, salty, sweet, and savory breakfast for a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil, and lay bacon strips in a single layer on the sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until browned and crisp, about 15 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 3,
      "text": "Reduce the oven temperature to 325 degrees F (160 degrees C). Slice rolls in half lengthwise. Spread 2 tablespoons butter over the cut side of bottom half of rolls. Top evenly with brown sugar and cayenne pepper. Arrange bacon slices over brown sugar mixture."
    },
    {
      "position": 4,
      "text": "Spread 1 tablespoon butter evenly into the bottom of a 9x13-inch casserole dish. Place the prepared sandwich half in the buttered pan."
    },
    {
      "position": 5,
      "text": "Whisk eggs, half-and-half, vanilla, salt, and syrup together in a separate 9x13-inch baking dish. Add top half of rolls to egg mixture and turn a couple times to coat and lightly soak the bread. Allow the excess egg mixture to drip off and place top half of rolls over bacon layer. Cover with foil. Discard any excess egg mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. Uncover and bake until golden brown and lightly toasted, 5 to 10 minutes more."
    },
    {
      "position": 7,
      "text": "Spread remaining butter over the tops. Cut into 12 servings. Dust with confectioner's sugar. Serve with syrup for dipping."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

  "id": "1cbd95d2-8ced-50c9-922c-b2ef2e047e8b",
  "slug": "ice-cream-sandwich-cake",
  "name": "Ice Cream Sandwich Cake",
  "recipe_type": "dessert",
  "brief_description": "This ice cream cake is made by layering ice cream sandwiches with hot fudge, caramel, and whipped topping for a decadent no-bake frozen dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Arrange a layer of ice cream sandwiches in the bottom of a 9x13-inch dish; top with a layer of whipped topping, hot fudge topping, and caramel topping."
    },
    {
      "position": 3,
      "text": "Repeat layering with remaining ice cream sandwiches, whipped topping, hot fudge topping, and caramel topping, ending with a top layer of whipped topping. Sprinkle with pecans."
    },
    {
      "position": 4,
      "text": "Cover the dish with aluminum foil and freeze until set, about 30 minutes. Slice and serve with your favorite toppings!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

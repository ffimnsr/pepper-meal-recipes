  "id": "5bb994c4-dfa7-5700-aec9-6d6cdda36c38",
  "slug": "original-buffalo-wings",
  "name": "Original Buffalo Wings",
  "recipe_type": "appetizer",
  "brief_description": "Cook these mini wings in a deep fryer, then add the peppery butter sauce just before serving.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep-fat fryer or large heavy pot to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut off tips, and separate each wing at the joint. Sprinkle with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place half of the wings in the deep fryer. When the wings are golden brown and crisp, remove them and drain well. Salt wings to taste. Add remaining wings and repeat frying process. Once wings have drained a bit, place them in a large mixing bowl."
    },
    {
      "position": 4,
      "text": "Melt butter or margarine in a small saucepan. Mix in hot sauce and vinegar. Pour melted sauce over the cooked wings, and mix to coat the wings with sauce."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

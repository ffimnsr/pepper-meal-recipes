  "id": "ed5c1732-26a9-5a18-a649-f1f3c85de3e7",
  "slug": "indian-relish",
  "name": "Indian Relish",
  "recipe_type": "appetizer",
  "brief_description": "This zesty Indian relish recipe combines bell peppers and sweet onion simmered in wine vinegar and pepper flakes. Top crackers or spread on cream cheese.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine bell peppers, onion, white wine vinegar, sugar, and red pepper flakes in a medium saucepan over medium heat. Bring to a boil, then reduce heat to a simmer. Cook until thickened, stirring occasionally, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Transfer to a sterilized glass container; cover. Refrigerate before serving, 4 hours to overnight."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,

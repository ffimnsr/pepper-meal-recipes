  "id": "fc564166-bd27-5817-92f3-96a303ce716b",
  "slug": "chef-johns-irish-pork-stew",
  "name": "Chef John's Irish Pork Stew",
  "recipe_type": "soup",
  "brief_description": "This Irish stew is made with pork shoulder and veggies cooked in a delicious dark gravy flavored with caraway seed. A great stew for St. Patrick's Day!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Season pork with salt and black pepper."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over high heat. Working in batches, cook and stir pork in hot oil until browned on all sides, 5 to 10 minutes. Transfer pork to a bowl."
    },
    {
      "position": 3,
      "text": "Melt butter in the same pot over medium heat. Cook and stir onion in hot butter with a pinch of salt until onion is softened and translucent, 7 to 10 minutes. Add garlic; saut\u00e9 until fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Stir flour into onion mixture; cook and stir until flour is completely incorporated, about 2 minutes. Add bay leaf and caraway seed; cook for 2 minutes more. Pour in beer. Cook and stir until thickened, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir browned pork, broth, carrots, and celery into beer mixture; bring to a simmer. Stir 1/4 cup parsley and balsamic vinegar into stew; reduce heat to medium-low and simmer until pork is fork-tender, about 2 hours."
    },
    {
      "position": 6,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook Brussels sprouts in boiling water until almost tender, about 5 minutes. Drain."
    },
    {
      "position": 7,
      "text": "Stir Brussels sprouts into stew and simmer until heated through, about 5 minutes. Season with salt and pepper."
    },
    {
      "position": 8,
      "text": "Divide mashed potatoes between 6 bowls. Ladle stew over potatoes and garnish with 1 teaspoon parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 145,
  "preparation_time_minutes": 25,

  "id": "4b794176-e112-587a-ac43-31d374683bd6",
  "slug": "apricot-fruitcake",
  "name": "Apricot Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "This is another great fruitcake for the holidays. Originally submitted to CakeRecipe.com. Pecans can be substituted for walnuts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 275 degrees F (135 degrees C). Grease two 9 inch tube pans."
    },
    {
      "position": 2,
      "text": "In a saucepan over medium heat cook apricots in the water until they are mushy. Press them through a sieve and let them cool."
    },
    {
      "position": 3,
      "text": "Separate the eggs. Beat the egg yolks until lemony colored. Then beat the egg whites until stiff peaks are formed. Set aside."
    },
    {
      "position": 4,
      "text": "Cream the butter or margarine and sugar together. Add the beaten egg yolks and the apricots, and mix thoroughly."
    },
    {
      "position": 5,
      "text": "Combine the raisins, candied cherries, candied pineapple, and mixed dried fruits in a bowl coated with one cup of the flour."
    },
    {
      "position": 6,
      "text": "Combine the remaining flour, baking soda, and salt. Add this flour mixture alternately to the creamed mixture with the apricot juice. Blend this batter into the mixed fruits. Add the chopped pecans or walnuts and fold in the beaten egg whites. Turn the batter into the prepared pans."
    },
    {
      "position": 7,
      "text": "Bake at 275 degrees F (135 degrees C) for 2 hours. Garnish cakes with candied pineapples and cherries. Makes about 24 servings."
    }
  ],
  "servings": 24,

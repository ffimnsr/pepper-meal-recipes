  "id": "00dddc0a-1b84-58c9-8ccd-844dec7fafd4",
  "slug": "mojito-perfecto",
  "name": "Mojito Perfecto",
  "recipe_type": "drink",
  "brief_description": "This mojito recipe is made by muddling mint, sugar, and lime wedges in a flat-bottomed glass before adding lemon-flavored rum for a 'perfecto' version of a mojito.",
  "cuisine": "Cuban",
  "instructions": [
    {
      "position": 1,
      "text": "Put 3 mint leaves and 2 teaspoons sugar into each of 2 glass tumblers; vigorously stir sugar and mint together, crushing mint with the back of a spoon to release oils."
    },
    {
      "position": 2,
      "text": "Add 3 lime wedges to each glass; again stir vigorously to release some lime juice."
    },
    {
      "position": 3,
      "text": "Pour 1 jigger rum into each glass, then fill glasses with ice cubes. Top with carbonated water; stir."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

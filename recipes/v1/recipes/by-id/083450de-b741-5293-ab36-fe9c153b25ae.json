  "id": "083450de-b741-5293-ab36-fe9c153b25ae",
  "slug": "tiramisu-toast",
  "name": "Tiramisu Toast",
  "recipe_type": "dessert",
  "brief_description": "Chef John's tiramisu toast provides the classic dessert flavor in an individual-sized portion that's quick and easy to prepare.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line a baking pan with aluminum foil."
    },
    {
      "position": 2,
      "text": "Crack egg into a baking dish. Add white sugar, espresso, and vanilla extract. Whisk to combine. Place bread slices into the dish and toss in the mixture to saturate; let sit for 10 to 15 minutes to fully absorb."
    },
    {
      "position": 3,
      "text": "Transfer bread slices to the prepared pan and drizzle any accumulated coffee mixture liquid over top."
    },
    {
      "position": 4,
      "text": "Bake toast in the center of the preheated oven until custard is cooked and bread bounces back slightly when touched, 20 to 25 minutes. Transfer slices to a wire rack to cool to room temperature."
    },
    {
      "position": 5,
      "text": "Meanwhile, pour wine into a saucepan. Add sugar and cook over medium heat until reduced to about 1 tablespoon. Remove from heat and let cool."
    },
    {
      "position": 6,
      "text": "Place mascarpone cheese into a bowl and add cooled wine reduction and a very small pinch of salt. Stir with a spatula until combined. Chill before piping or spreading on cooled toast. Top with shaved chocolate."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

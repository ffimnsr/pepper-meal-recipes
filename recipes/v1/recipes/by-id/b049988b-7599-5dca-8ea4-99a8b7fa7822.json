  "id": "b049988b-7599-5dca-8ea4-99a8b7fa7822",
  "slug": "tempeh-fajitas",
  "name": "Tempeh Fajitas",
  "recipe_type": "drink",
  "brief_description": "Tempeh is sauteed with soy sauce, lime juice and lots of veggies including green bell peppers and spinach. Chopped green chile peppers and cilantro add a fresh kick. Serve with tortillas, refried beans and rice.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Saute tempeh with soy sauce and lime juice until tempeh browns. Stir in bell peppers, mushrooms, spinach, chile peppers, cilantro and dried onion."
    },
    {
      "position": 2,
      "text": "Increase heat to medium-high and cook until fluids have reduced, stirring occasionally."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

  "slug": "air-fryer-teriyaki-snap-peas-and-mushrooms",
  "name": "Air Fryer Teriyaki Snap Peas and Mushrooms",
  "recipe_type": "side",
  "brief_description": "Try these easy air fryer teriyaki snap peas and mushrooms that go great with grilled steak, chicken, or pork.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine snap peas, mushrooms, teriyaki sauce, and olive oil in a large bowl; stir until evenly combined. Transfer vegetable mixture to the air fryer basket. Air fry for 12 minutes, shaking halfway through cook time."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 12,

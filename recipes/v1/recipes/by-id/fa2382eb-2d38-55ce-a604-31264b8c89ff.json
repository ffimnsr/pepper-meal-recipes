  "id": "fa2382eb-2d38-55ce-a604-31264b8c89ff",
  "slug": "southern-cheese-grits",
  "name": "Southern Cheese Grits",
  "recipe_type": "side",
  "brief_description": "These easy Southern cheese grits make the perfect side dish whether on a regular weeknight or to serve when entertaining during the holidays.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2-quart casserole dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Bring water and salt to a boil in a pot over high heat. Add grits, reduce heat to low, and let simmer until tender, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Pour grits into a large mixing bowl. Add beaten egg slowly, followed by 1 1/4 cups Cheddar cheese, milk, Worcestershire sauce, butter, pepper, garlic powder, and hot sauce. Mix thoroughly and pour into the prepared dish. Sprinkle remaining Cheddar cheese on top and sprinkle lightly with paprika for coloring. Cover."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until thickened and cheese is melted, about 1 hour, uncovering the last 10 minutes to let a crust form on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

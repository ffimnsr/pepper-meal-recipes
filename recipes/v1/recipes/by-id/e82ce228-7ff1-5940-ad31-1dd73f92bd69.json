  "id": "e82ce228-7ff1-5940-ad31-1dd73f92bd69",
  "slug": "best-stovetop-bbq-ribs",
  "name": "Best Stovetop BBQ Ribs",
  "recipe_type": "main",
  "brief_description": "Simple slow-cooked pork ribs on the stovetop, simmered in a homemade barbecue sauce. This country-style recipe is an easy-to-make crowd-pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together steak sauce, ketchup, water, Worcestershire sauce, soy sauce, and garlic in a bowl until smooth."
    },
    {
      "position": 2,
      "text": "Place pork ribs in a saucepan with a lid, and pour the sauce over the ribs."
    },
    {
      "position": 3,
      "text": "Spread raw onion rings over the ribs, and cover the pan."
    },
    {
      "position": 4,
      "text": "Bring to a boil over medium heat, and simmer the ribs in the sauce until tender, about 45 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

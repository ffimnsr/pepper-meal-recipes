  "id": "cafc9b56-2f2d-5dbf-a294-dab84d5b9160",
  "slug": "creamy-baked-ziti",
  "name": "Creamy Baked Ziti",
  "recipe_type": "main",
  "brief_description": "Ziti pasta bakes with layers of creamy tomato sauce and mozzarella cheese in an easy and comforting dish that's ready in less than an hour.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 375 degrees F."
    },
    {
      "position": 2,
      "text": "Cook pasta in large saucepan as directed on package, omitting salt. Remove from pan; drain. Meanwhile, add marinara sauce, tomatoes and cream cheese to same pan; cook on medium heat 5 min. or until cream cheese is melted and mixture is well blended, stirring frequently. Return pasta to pan; mix well."
    },
    {
      "position": 3,
      "text": "Layer half the pasta mixture in 13x9-inch baking dish; cover with layers of sour cream, 1 cup mozzarella and remaining pasta mixture. Top with remaining mozzarella and Parmesan."
    },
    {
      "position": 4,
      "text": "Bake 20 min. or until heated through."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

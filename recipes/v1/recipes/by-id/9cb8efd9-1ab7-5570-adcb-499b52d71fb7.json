  "id": "9cb8efd9-1ab7-5570-adcb-499b52d71fb7",
  "slug": "greek-yogurt-breakfast-parfait",
  "name": "Greek Yogurt Breakfast Parfait",
  "recipe_type": "dessert",
  "brief_description": "Creamy Greek yogurt and fresh berries are combined with crunchy granola in this quick and easy breakfast parfait.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add blueberries and strawberries to a small bowl. Sprinkle with sugar; stir to coat the berries."
    },
    {
      "position": 2,
      "text": "Place 2 tablespoons granola in the bottom of 2 parfait glasses. Spoon 2 tablespoons yogurt on top and sprinkle with 1/2 teaspoon lemon zest. Top with 1/3 of the berries. Repeat layers until the parfait glasses are full."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

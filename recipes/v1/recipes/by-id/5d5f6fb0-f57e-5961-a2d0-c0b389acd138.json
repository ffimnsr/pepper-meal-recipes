  "schema_version": 1,
  "id": "5d5f6fb0-f57e-5961-a2d0-c0b389acd138",
  "slug": "deep-fried-camembert-and-cranberry-sauce",
  "name": "Deep-Fried Camembert and Cranberry Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Camembert cheese is breaded and deep fried and served alongside cranberry sauce in this quick and easy appetizer that\u2019s sure to impress.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Freeze Camembert cheese for 30 minutes."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Pour flour into a bowl. Beat eggs and milk together in a separate bowl. Pour bread crumbs into a third bowl."
    },
    {
      "position": 4,
      "text": "Remove cheese from the freezer and cut each round into 6 wedges. Roll each wedge in flour and dip into the egg-milk mixture. Press each wedge into bread crumbs until evenly coated."
    },
    {
      "position": 5,
      "text": "Fry each breaded wedge in the hot oil until bread crumbs are browned, 2 to 3 minutes per side. Transfer fried cheese to a paper towel-lined plate using a slotted spoon. Serve cranberry sauce on the side."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 4,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

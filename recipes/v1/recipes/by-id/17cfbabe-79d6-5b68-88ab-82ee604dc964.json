  "id": "17cfbabe-79d6-5b68-88ab-82ee604dc964",
  "slug": "biscuit-cinnamon-rolls",
  "name": "Biscuit Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "This version of cinnamon rolls uses biscuit dough for a quick and easy method of preparing the sweet breakfast or dessert treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter the bottom of an 8-inch round or square baking pan and sprinkle with 2 tablespoons brown sugar."
    },
    {
      "position": 2,
      "text": "Combine white sugar, cinnamon, 2 tablespoons brown sugar, and vanilla extract in a bowl. Mix filling well."
    },
    {
      "position": 3,
      "text": "Combine confectioners' sugar and milk for glaze in another bowl until well mixed."
    },
    {
      "position": 4,
      "text": "Separate biscuits and roll or punch down each one until flat. Coat with melted butter and sprinkle each with filling mixture to coat. Roll up each piece of dough and cut in 1/2, placing each cut-side down into the prepared pan, yielding 20 pieces."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until biscuit portion on top of rolls begins to brown, about 15 minutes. Remove from the oven and glaze."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

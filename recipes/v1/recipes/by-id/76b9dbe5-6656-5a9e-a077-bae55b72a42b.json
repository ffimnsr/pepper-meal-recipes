  "id": "76b9dbe5-6656-5a9e-a077-bae55b72a42b",
  "slug": "newfie-goulash",
  "name": "Newfie Goulash",
  "recipe_type": "soup",
  "brief_description": "An Atlantic-Canada version of good old macaroni goulash uses corned beef instead of hamburger meat. The one-dish dinner is sprinkled with Parmesan cheese and served hot.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once water is boiling, stir in macaroni, and return to a boil. Cook pasta uncovered, occasionally stirring, until pasta has cooked through, but is still firm to the bite, about 8 minutes. Drain well in a colander set in the sink."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium heat, and cook onion and garlic until onion is soft, about 5 minutes; stir in green pepper, and cook until tender, about 8 more minutes. Mash corned beef into the pot, and simmer until hot. Mix in tomato soup, ketchup, cooked macaroni, salt, and black pepper; stir to combine, and bring mixture to a simmer over medium-low heat. Sprinkle Parmesan cheese on top, and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

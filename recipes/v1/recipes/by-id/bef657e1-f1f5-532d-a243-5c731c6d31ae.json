  "id": "bef657e1-f1f5-532d-a243-5c731c6d31ae",
  "slug": "slow-cooker-chicken-and-noodles",
  "name": "Slow Cooker Chicken and Noodles",
  "recipe_type": "soup",
  "brief_description": "This chicken and noodles crockpot recipe is a wonderfully simple soup to cook while at work or on a busy day. A slow cooker makes it easy to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken, water, onion, celery, salt, and pepper into a slow cooker. Set temperature to Low and cook for 6 to 8 hours."
    },
    {
      "position": 2,
      "text": "When chicken is tender, remove from the slow cooker and tear or chop into bite-sized pieces. Set aside in a small casserole dish to keep warm."
    },
    {
      "position": 3,
      "text": "Turn the slow cooker up to High and stir in frozen egg noodles. Cook until noodles are tender then return chicken pieces to broth. Adjust seasonings to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,

  "id": "55ef3f2c-a77f-5443-bc2b-6e7e7efc61b2",
  "slug": "hawaiian-ham-and-cheese-sliders",
  "name": "Hawaiian Ham and Cheese Sliders",
  "recipe_type": "appetizer",
  "brief_description": "The best Hawaiian sliders with ham, cheese, sweet rolls, and a buttery poppy seed sauce. These are perfect for potlucks and quick and easy to prepare.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium-low heat; cook and stir onion in the melted butter until softened, about 5 to 10 minutes. Add mustard, poppy seeds, and Worcestershire sauce; cook and stir for 5 minutes."
    },
    {
      "position": 3,
      "text": "Arrange the roll bottoms in the prepared baking dish. Spoon 2/3 of the onion mixture over top."
    },
    {
      "position": 4,
      "text": "Layer ham and Swiss cheese evenly over the roll bottoms."
    },
    {
      "position": 5,
      "text": "Place the roll tops over the cheese layer, then brush the remaining onion mixture over top."
    },
    {
      "position": 6,
      "text": "Cover the dish with aluminum foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 15 minutes. Remove aluminum foil and bake until the roll tops are lightly browned, about 5 to 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

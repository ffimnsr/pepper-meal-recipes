  "id": "48062dfc-663d-520a-9184-b162b879bc94",
  "slug": "west-coast-trail-cookies",
  "name": "West Coast Trail Cookies",
  "recipe_type": "dessert",
  "brief_description": "This perfect nut-free trail cookie, loaded with chocolate chips and dried cranberries, gets its name from the West Coast Trail on Vancouver Island.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together all-purpose flour, whole wheat flour, flax seed meal, cinnamon, baking soda, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Beat together butter, brown sugar, and white sugar in a large bowl until smooth and creamy; Stir in eggs and vanilla. Stir flour mixture into creamed butter mixture until dough is just combined. Fold oats, chocolate chips, cranberries, coconut, and pumpkin seeds into dough just until evenly combined."
    },
    {
      "position": 4,
      "text": "Shape dough into 1 1/2-inch balls or drop by heaping tablespoonfuls onto the prepared baking sheets about 2 inches apart; press to flatten slightly."
    },
    {
      "position": 5,
      "text": "Bake cookies in the preheated oven until lightly golden at the edges, about 12 minutes. Cool on the baking sheet for 10 minutes; transfer to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 20,

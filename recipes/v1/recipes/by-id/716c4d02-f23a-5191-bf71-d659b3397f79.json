  "id": "716c4d02-f23a-5191-bf71-d659b3397f79",
  "slug": "curried-chicken-lettuce-wraps",
  "name": "Curried Chicken Lettuce Wraps",
  "recipe_type": "salad",
  "brief_description": "Leftover chicken is transformed into a delicious curried chicken salad and served chilled in these simple lettuce wraps the whole family will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium heat. Add chicken, lime juice, and salt; cook and stir until chicken is no longer pink, 7 to 10 minutes. Remove from the heat."
    },
    {
      "position": 2,
      "text": "Add apple, cranberries, almonds, and green onions to the chicken."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise and curry powder together in a large bowl. Add to chicken mixture and stir to coat. Transfer to the refrigerator until flavors have blended together, at least 1 hour, or overnight for more flavor."
    },
    {
      "position": 4,
      "text": "Spoon chilled chicken salad into individual lettuce leaves. Wrap and eat with your fingers."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b651214e-d0e3-55ca-8d74-86852b2496d3",
  "slug": "fruit-and-cream-pie-ii",
  "name": "Fruit and Cream Pie II",
  "recipe_type": "dessert",
  "brief_description": "A large pie with 2 types of fruit and a sour cream topping. Any combination of fruit fillings may be used in this pie. Apple, blueberry, peach or cherries all work well.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour and salt together. Pour milk, sugar and oil into one measuring cup, and add all at once to flour. Stir until mixed. Pat dough onto the bottom and sides of a 2 quart casserole dish."
    },
    {
      "position": 3,
      "text": "Spread fruit filling over dough and sprinkle with cinnamon. In a medium bowl, combine eggs, sour cream and vanilla. Mix until smooth and pour over fruit filling. Sprinkle top with cinnamon."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 45 to 60 minutes, or until topping is set. Allow to cool and store in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

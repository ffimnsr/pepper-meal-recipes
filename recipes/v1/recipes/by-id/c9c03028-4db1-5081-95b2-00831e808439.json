  "id": "c9c03028-4db1-5081-95b2-00831e808439",
  "slug": "actually-delicious-turkey-burgers",
  "name": "Best Turkey Burgers",
  "recipe_type": "main",
  "brief_description": "This turkey burger recipe is quick to make with easy ingredients for tasty turkey burgers that are full of savory flavors your family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix ground turkey, seasoned bread crumbs, onion, egg whites, parsley, garlic, salt, and pepper together in a large bowl."
    },
    {
      "position": 3,
      "text": "Form into 12 patties."
    },
    {
      "position": 4,
      "text": "Cook the patties in a medium skillet over medium heat, turning once, to an internal temperature of 180 degrees F (85 degrees C)."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "511f41d7-45b9-5244-99a5-5d0f0900825d",
  "slug": "perfect-chicken-brine",
  "name": "Perfect Chicken Brine",
  "recipe_type": "side",
  "brief_description": "This simple chicken brine will add a ton of flavor to whole chickens or bone-in pieces, while ensuring the meat stays super moist as it\u2019s cooked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, kosher salt, sugar, sage, basil, garlic, peppercorns, and bay leaf to a simmer in a large pot over medium-high heat; cook, stirring occasionally, until salt and sugar dissolve completely, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat; cover and let steep for 20 to 30 minutes. Set pot in an ice bath and stir occasionally until brine cools to room temperature, 20 to 30 minutes. Refrigerate until fully chilled before using, at least 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

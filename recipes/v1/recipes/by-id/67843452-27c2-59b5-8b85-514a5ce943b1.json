{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "67843452-27c2-59b5-8b85-514a5ce943b1",
  "slug": "turkey-tetrazzini-a-la-stouffers",
  "name": "Turkey Tetrazzini a la Stouffer's",
  "recipe_type": "main",
  "brief_description": "Leftover cooked turkey never had it so good as when combined with angel hair pasta and mushrooms in a delicate cream sauce flavored with sherry and baked in a casserole.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a casserole dish with 2 teaspoons of butter."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook angel hair in boiling water, occasionally stirring until cooked through but firm to the bite, 4 to 5 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter in a large pot over medium heat; cook and stir celery until it begins to soften, 1 minute. Stir mushrooms into celery; cook and stir until mushrooms are softened, 3 minutes more."
    },
    {
      "position": 4,
      "text": "Remove vegetables from skillet; melt remaining 2 tablespoons butter and whisk flour into hot butter to make a paste. Slowly whisk chicken broth and bring to a simmer; reduce heat to low and cook, constantly whisking, until sauce is thickened. Mix in cream, sherry, salt, and white pepper."
    },
    {
      "position": 5,
      "text": "Fold turkey, celery, and mushrooms into sauce; mix in angel hair pasta. Transfer mixture to the prepared casserole dish and sprinkle panko crumbs on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until sauce is bubbling and crumb topping has browned, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

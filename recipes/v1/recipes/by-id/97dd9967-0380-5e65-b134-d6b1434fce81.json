  "id": "97dd9967-0380-5e65-b134-d6b1434fce81",
  "slug": "rhubarb-pie-single-crust",
  "name": "Rhubarb Pie - Single Crust",
  "recipe_type": "dessert",
  "brief_description": "This single crust rhubarb pie takes advantage of summer's bounty of fresh rhubarb and a prepared pie crust. The easy pie relies on just five ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat butter in microwave oven in a 4-cup microwave-safe measuring cup until melted but not hot, about 1 minute. Beat eggs, sugar, and flour into butter until smooth. Spread rhubarb in unbaked pie crust; pour egg mixture over rhubarb."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until filling is lightly browned, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

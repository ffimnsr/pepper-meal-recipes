  "schema_version": 1,
  "id": "d2af509f-9a00-5f55-b1bd-20720da543e4",
  "slug": "drunken-ribs",
  "name": "Drunken Ribs",
  "recipe_type": "main",
  "brief_description": "Spareribs are soaked in a beer marinade, then grilled with a rich, tangy sauce!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix garlic powder, white pepper, seasoned salt, onion salt, and oregano."
    },
    {
      "position": 2,
      "text": "Place ribs in a large roasting pan, and rub evenly with the garlic powder mixture to coat. Pour distilled white vinegar and 1/2 the beer, or enough to cover ribs, into the pan. Cover pan, and marinate ribs in the refrigerator 8 hours, or overnight."
    },
    {
      "position": 3,
      "text": "Prepare an outdoor grill for indirect, medium heat, and lightly oil grate."
    },
    {
      "position": 4,
      "text": "In a large saucepan, whisk together remaining beer, ketchup, Worcestershire sauce, maple syrup, brown sugar, liquid smoke, margarine, apple cider vinegar, and honey mustard. Bring to boil. Cover, reduce heat, and simmer 15 minutes, or until a thick sauce has formed."
    },
    {
      "position": 5,
      "text": "Remove ribs from the marinade mixture, and coat liberally with the sauce. Place on the prepared grill, and cook 1 1/2 to 2 hours, to an internal temperature of 160 degrees F (70 degrees C). Brush frequently with the sauce while cooking."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,

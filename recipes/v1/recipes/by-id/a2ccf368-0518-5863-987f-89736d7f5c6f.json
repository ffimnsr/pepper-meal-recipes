  "id": "a2ccf368-0518-5863-987f-89736d7f5c6f",
  "slug": "crispy-tuna-croquettes",
  "name": "Crispy Tuna Croquettes",
  "recipe_type": "appetizer",
  "brief_description": "Tuna seasoned with lemon and fresh herbs is coated with bread crumbs and fried into crispy golden croquettes in this Spanish-inspired recipe.",
  "cuisine": "American Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk egg yolk, garlic, and 1 tablespoon lemon juice in a bowl until well-blended. Drizzle in 1 tablespoon olive oil and canola oil slowly, whisking constantly, until blended. Drizzle in remaining olive oil and canola oil, whisking constantly, until thick and smooth. Season with salt, pepper, and paprika. Transfer aioli to the refrigerator."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-low heat. Stir in flour to make a paste, about 1 minute. Reduce heat to low. Stir in milk gradually until sauce thickens, 2 to 3 minutes. Stir in tuna, parsley, chives, dill, 1/2 teaspoon lemon juice, lemon zest, and nutmeg. Cook and stir until mixture is the consistency of mashed potatoes, about 3 minutes. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Spread tuna mixture in a baking dish. Cover with plastic wrap and cool in refrigerator, 2 to 3 hours or overnight."
    },
    {
      "position": 4,
      "text": "Whisk 2 eggs in a small bowl."
    },
    {
      "position": 5,
      "text": "Pour panko bread crumbs into a shallow dish."
    },
    {
      "position": 6,
      "text": "Divide chilled tuna mixture into 8 equal portions; shape into cylinders or patties with lightly moistened hands. Dip cylinders into egg wash and roll in bread crumbs to coat. Arrange on a plate and chill until firm, about 1 hour."
    },
    {
      "position": 7,
      "text": "Heat vegetable oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 8,
      "text": "Fry croquettes in batches until golden brown, 5 to 8 minutes. Remove with a slotted spoon and drain on paper towels. Serve alongside aioli."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 11,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

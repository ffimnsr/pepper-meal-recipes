  "id": "cfa57284-28e9-5461-b70f-e78c766bb3f0",
  "slug": "coconut-conch-chowder",
  "name": "Coconut Conch Chowder",
  "recipe_type": "soup",
  "brief_description": "This creamy coconut conch chowder recipe is a vibrant blend of tender seafood and a variety of fresh vegetables. Use mango pepper for a tropical take.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Place conch meat in a pot with enough water to cover; bring to a boil and cook 15 minutes. Drain. Transfer to the bowl of a food processor; pulse until finely chopped. Set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt 2 tablespoons margarine in a skillet over medium heat. Add sweet potato, bell pepper, carrot, celery, green onions, and corn; cook and stir about 5 minutes."
    },
    {
      "position": 3,
      "text": "Melt remaining 2 tablespoons margarine in a large pot; whisk in flour to form a thick paste the consistency of cake frosting. Whisk in half-and-half, fish stock, coconut milk, and ginger; season with salt and black pepper. Add conch and vegetable mixture to the pot; bring to a boil. Reduce heat to low; simmer 15 minutes. Stir in cilantro and hot sauce; cook to desired consistency, about 15 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

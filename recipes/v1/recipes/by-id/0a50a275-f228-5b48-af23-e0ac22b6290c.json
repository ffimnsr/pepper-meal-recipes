  "schema_version": 1,
  "id": "0a50a275-f228-5b48-af23-e0ac22b6290c",
  "slug": "spaghetti-squash-carbonara-recipe-8728271",
  "name": "Spaghetti Squash Carbonara",
  "recipe_type": "main",
  "brief_description": "This spaghetti squash carbonara is the best away to eat spaghetti squash, and this recipe has the best technique for prepping spaghetti squash, to give it a texture closest to pasta or spaghetti.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Cut 1 inch off each end of squash. Carefully cut squash crosswise into 3 equal sections. Use a spoon to scrape out all the seeds."
    },
    {
      "position": 3,
      "text": "Place squash pieces on the prepared baking sheet. Coat both sides of each section with 1 tablespoon olive oil. Generously season both sides with salt."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven until squash is tender, and strands can be easily pulled apart, 1 to 2 hours. Separate strands with two forks into \u201cspaghetti.\u201d"
    },
    {
      "position": 5,
      "text": "Meanwhile, cook pancetta in remaining 2 tablespoons olive oil until lightly browned, or as browned as you like, 5 to 10 minutes. Remove from heat; set aside."
    },
    {
      "position": 6,
      "text": "Add egg yolks, water, and freshly ground black pepper to a large mixing bowl, and whisk thoroughly."
    },
    {
      "position": 7,
      "text": "Transfer hot squash \u201cspaghetti\u201d into the bowl, and add butter and cooked pancetta, along with all rendered fat in the pan. Toss thoroughly with forks until evenly mixed. If desired, reserve a tablespoon or two of cooked pancetta to garnish the top once the final dish is baked."
    },
    {
      "position": 8,
      "text": "Add the Parmigiano and pecorino cheeses, and toss again. Taste for salt and add more if needed. Transfer into a shallow baking dish, and top with a little more grated Parmigiano Reggiano."
    },
    {
      "position": 9,
      "text": "Return to the oven at 400 degrees F (200 degrees C) until heated through, about 15 minutes. To serve, scatter reserved pancetta over the top and sprinkle with a little more grated cheese and parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

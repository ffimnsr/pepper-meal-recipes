  "id": "560fc63b-3c16-5037-bc93-f32952507673",
  "slug": "japanese-style-teriyaki-sauce",
  "name": "Japanese Style Teriyaki Sauce",
  "recipe_type": "dessert",
  "brief_description": "This is a Japanese style teriyaki sauce/marinade that uses pineapple with skins, apples and mirin. You can adjust sweetness to your specifications by altering the amount of sugar.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan, combine soy sauce, mirin, orange juice, pineapple, Granny Smith apple, garlic, ginger, and half of the sugar; bring to a boil. Reduce heat, and simmer 20 minutes. Adjust sweetness to taste with remaining sugar."
    },
    {
      "position": 2,
      "text": "Strain through a fine mesh sieve; cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,

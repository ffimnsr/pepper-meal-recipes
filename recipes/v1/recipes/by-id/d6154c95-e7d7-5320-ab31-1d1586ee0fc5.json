  "id": "d6154c95-e7d7-5320-ab31-1d1586ee0fc5",
  "slug": "scallop-scampi",
  "name": "Scallop Scampi",
  "recipe_type": "soup",
  "brief_description": "Tender bay scallops are cooked quickly in a tasty sauce of garlic, onion, white wine, chicken broth and Romano cheese. Toss fresh green parsley into the mix and pour over cooked linguine. Serve with a sprinkling of Romano cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet, melt margarine over medium heat and saute garlic and onion until translucent. Add wine, salt, ground black pepper and 1/4 cup cheese."
    },
    {
      "position": 2,
      "text": "Add chicken broth and scallops; increase heat and boil rapidly for 7 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 4,
      "text": "Reduce heat for scallop mixture and add parsley; place sauce on top of linguine. Sprinkle with remaining cheese; serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

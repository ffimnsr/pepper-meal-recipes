  "id": "9c5ecde4-3c2f-50ed-a9f0-f262e737c4df",
  "slug": "classic-turkey-and-rice-soup",
  "name": "Classic Turkey and Rice Soup",
  "recipe_type": "soup",
  "brief_description": "This classic turkey and rice soup recipe combines leftover Thanksgiving turkey with rice and vegetables in a tasty homemade stock for a comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine carcass, onion, carrot, celery, garlic, rosemary, thyme, bay leaves, salt, and pepper in a stockpot. Pour in enough water to cover; bring stock to a boil, cover the pot, reduce heat, and simmer until flavors blend, about 1 hour."
    },
    {
      "position": 2,
      "text": "Remove meat from bones and set aside; discard carcass. Remove and discard vegetables and bay leaves with a slotted spoon."
    },
    {
      "position": 3,
      "text": "Stir in onions, carrots, celery, garlic, poultry seasoning, rosemary, and onion powder. Bring soup to a boil; reduce heat, cover the pot, and simmer until vegetables are tender, 20 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Add cooked rice and reserved meat; season with salt and pepper. Cook until warmed through, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 20,

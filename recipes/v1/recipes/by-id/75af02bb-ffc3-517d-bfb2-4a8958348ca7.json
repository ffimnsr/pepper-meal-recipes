  "id": "75af02bb-ffc3-517d-bfb2-4a8958348ca7",
  "slug": "4-ingredient-cowboy-peach-cobbler-recipe-11996403",
  "name": "4-Ingredient Cowboy Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This 4-Ingredient Cowboy Peach Cobbler is an yummy dessert that turns simple pantry staples into a warm, bubbly treat in about 1 hour. With juicy peaches, tender cake topping, and a hint of spice, this easy cobbler is perfect served warm with a scoop of vanilla ice cream or a dollop of whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "Melt butter in a 6-quart Dutch oven over medium heat. Remove from heat. Add peaches with their syrup, cake mix, and soda; stir until mostly combined (some dry spots are okay). Sprinkle with cinnamon and/or nutmeg, if desired."
    },
    {
      "position": 3,
      "text": "Cover and bake in the preheated oven until the top is set and a toothpick inserted in the center comes out clean, 30 to 35 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and let stand, covered, 15 minutes. Serve with ice cream or whipped cream, if desired. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,

  "id": "9c2235bc-5c77-5bff-80ce-0fd67e2fa2dd",
  "slug": "sugar-cookie-icing",
  "name": "Sugar Cookie Icing",
  "recipe_type": "dessert",
  "brief_description": "This sugar cookie icing is a simple glaze that's easy to make and color in minutes. It's smooth, glossy, and hardens perfectly for pretty decorated cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir confectioners' sugar and milk together in a small bowl until smooth."
    },
    {
      "position": 3,
      "text": "Whisk in corn syrup and almond extract until icing is smooth and glossy. If icing is too thick, add more corn syrup."
    },
    {
      "position": 4,
      "text": "Divide icing into separate bowls; add food colorings to each until reaches desired intensity."
    },
    {
      "position": 5,
      "text": "Dip cookies into icing, or paint icing onto cookies with a brush."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "51c4669a-a657-5652-8e68-988047d757ee",
  "slug": "greek-style-beef-stew-stifado",
  "name": "Greek-Style Beef Stew (Stifado)",
  "recipe_type": "soup",
  "brief_description": "Chef John's delicious Greek-style beef stifado stew pairs tender beef with sweet shallots in a tangy and aromatic slow-simmered sauce.",
  "cuisine": "Greek Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place beef in a bowl and season generously with pepper and kosher salt. Cover and transfer to the refrigerator until ready to use; up to 1 day is fine."
    },
    {
      "position": 3,
      "text": "Leaving the root ends in place, cut off the shallot tops. Remove and discard skins."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons oil in a heavy skillet over high heat. Add \u00bd of the beef and cook until nicely seared, 4 to 6 minutes per side. Remove to a plate and repeat to sear remaining beef."
    },
    {
      "position": 5,
      "text": "Turn off the heat and add 1 tablespoon oil to the empty skillet. Add shallots and let the skillet cool for 2 to 3 minutes. Turn the heat back on to medium and toss shallots until browned, 2 to 4 minutes. Remove shallots to a plate."
    },
    {
      "position": 6,
      "text": "Add the remaining 1 tablespoon oil to the skillet with onion, garlic, and a pinch of salt; cook and stir for about 1 minute. Stir in tomato paste and cook until toasted, about 2 minutes."
    },
    {
      "position": 7,
      "text": "Add red wine vinegar and white wine and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Increase heat to medium-high and add sugar, cinnamon, allspice, cloves, oregano, bay leaves, and rosemary sprigs. Stir to combine and cook until reduced by about half, 2 to 3 minutes."
    },
    {
      "position": 8,
      "text": "Add browned beef and shallots to the skillet and toss carefully until coated. Pour in 2 cups beef broth and bring to a simmer."
    },
    {
      "position": 9,
      "text": "Reduce heat to low or medium-low. Cover and cook at a gentle simmer for 1 hour, then uncover and cook for at least 1 more hour, stirring occasionally to move the beef and shallots around. Add more broth if needed during the cooking time and skim off some fat if preferred."
    },
    {
      "position": 10,
      "text": "The meat is done when a fork slides in easily, but the meat isn't falling apart on its own; it may take longer than 2 hours."
    },
    {
      "position": 11,
      "text": "Taste and adjust seasonings before serving."
    },
    {
      "position": 12,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,

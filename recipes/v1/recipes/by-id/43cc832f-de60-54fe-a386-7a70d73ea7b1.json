  "id": "43cc832f-de60-54fe-a386-7a70d73ea7b1",
  "slug": "english-muffin-bread",
  "name": "English Muffin Bread",
  "recipe_type": "breakfast",
  "brief_description": "This recipe will make 2 loaves of chewy English muffin bread. It's leavened with yeast and baking soda.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Warm the milk and water in a small saucepan until very warm (125 degrees F/50 degrees C). Lightly grease two 8x4 inch loaf pans; sprinkle cornmeal inside pans."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together 3 cups flour, yeast, sugar, salt and soda. Stir milk into the flour mixture; beat well. Stir in the remaining flour, 1 cup at a time, until a stiff batter is formed. Spoon batter into prepared pans. Cover and let rise in a warm place for until nearly doubled in size, about 45 minutes. Meanwhile, preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until golden brown, about 25 minutes. Remove from pans immediately and cool."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 60,

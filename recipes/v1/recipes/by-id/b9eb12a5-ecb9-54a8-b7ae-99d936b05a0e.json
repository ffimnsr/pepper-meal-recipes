  "id": "b9eb12a5-ecb9-54a8-b7ae-99d936b05a0e",
  "slug": "grandmas-old-fashioned-apple-crisp",
  "name": "Grandma's Old-Fashioned Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "This grandma's beloved old-fashioned crisp recipe uses fresh Granny Smith apples for a fall-ready dessert that's easy and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine apples, sugar, cinnamon, and nutmeg for filling in a bowl; transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, flour, oats, butter, and cinnamon for topping in a large bowl. Sprinkle on top of filling."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until apple filling is bubbling, and top is crisp and golden, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

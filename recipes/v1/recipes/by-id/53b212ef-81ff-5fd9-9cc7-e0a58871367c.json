{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "53b212ef-81ff-5fd9-9cc7-e0a58871367c",
  "slug": "keto-tex-mex-ground-beef-casserole",
  "name": "Keto Tex-Mex Ground Beef Casserole",
  "recipe_type": "main",
  "brief_description": "Keto and tacos do go together, try this Tex-Mex ground beef casserole recipe with cauliflower rice that has all the flavors of tacos without the carbs.",
  "cuisine": "Tex Mex American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat an 11x7-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large nonstick skillet over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes. Stir in 1 \u00bd teaspoons chili powder, 1 teaspoon onion powder, 1 teaspoon garlic powder, cumin, coriander, salt, and black pepper until evenly distributed. Cook until fragrant, 4 to 5 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Whisk eggs and cream together in a bowl; add to beef mixture. Transfer to the prepared baking dish; pat down evenly."
    },
    {
      "position": 4,
      "text": "Wipe skillet clean; add olive oil and heat over medium heat. Add onion; cook until soft and translucent, about 2 minutes. Add remaining 1 teaspoon each chili powder, garlic powder, and onion powder; season with salt and black pepper. Stir in tomato paste; cook, stirring often, 2 to 3 minutes. Add cauliflower rice; continue cooking for 4 to 5 minutes. Remove from heat, stir in 1 cup Cheddar cheese; transfer to top beef mixture, smoothing with a spatula to flatten top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 to 30 minutes. Sprinkle remaining \u00bd cup Cheddar over top; continue baking until cheese has melted, about 5 minutes more. Remove from oven; cool about 5 minutes. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

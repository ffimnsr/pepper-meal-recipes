  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "94717b42-fd84-5626-9aba-0b5a161ec76e",
  "slug": "kifta-and-potatoes-with-tahini-sauce",
  "name": "Kifta and Potatoes with Tahini Sauce",
  "recipe_type": "main",
  "brief_description": "Seasoned lamb rolls are baked with potatoes and topped with a citrusy tahini sauce in this mouthwatering Middle Eastern kifta dish.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Make lamb rolls: Combine lamb, onion, parsley, salt, allspice, and pepper in a large bowl. Roll meat into 2 1/2-inch-long pieces and arrange in a baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 4,
      "text": "Make potatoes: While meat is cooking, heat vegetable oil in a large frying pan over medium heat. Add potatoes; fry in hot oil until lightly golden, about 5 minutes. Set aside on paper towels to drain excess oil. Sprinkle with salt."
    },
    {
      "position": 5,
      "text": "Remove lamb from the oven; drain and discard any fat from meat. Leave the oven on."
    },
    {
      "position": 6,
      "text": "Make tahini sauce: Blend garlic, lemon juice, water, tahini, salt, and pepper in a food processor until smooth. Set sauce aside."
    },
    {
      "position": 7,
      "text": "Arrange potatoes on top of lamb in the baking dish and pour sauce on top. Drizzle with olive oil. Return the baking pan to the oven."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until lamb is no longer pink and an instant-read thermometer inserted into the center reads at least 150 degrees F (65 degrees C), about 30 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

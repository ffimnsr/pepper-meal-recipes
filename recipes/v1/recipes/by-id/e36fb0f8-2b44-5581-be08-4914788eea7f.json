  "slug": "good-and-easy-sloppy-joes",
  "name": "Good and Easy Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "The sauce for these sloppy joes is a mixture of chili sauce, brown sugar, mustard, and vinegar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 7 to 10 minutes; drain and discard grease. Return skillet and beef to stove and reduce heat to medium-low."
    },
    {
      "position": 2,
      "text": "Stir chili sauce, mustard, brown sugar, and vinegar into the ground beef; simmer until the sauce thickens, 5 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

  "id": "438f7d68-58d1-58c5-b2b7-889a63a8f297",
  "slug": "vegan-bean-taco-filling",
  "name": "Vegan Bean Taco Filling",
  "recipe_type": "main",
  "brief_description": "Black beans mingle with onions, peppers, garlic, cornmeal, and spices in this tasty taco filling. Try it in burritos or as a dip for tortilla chips. No black beans? Red, pink, or pinto beans are great subs.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a medium skillet over medium heat. Stir in onion, garlic, and bell pepper; cook until tender. Stir in mashed beans. Add the cornmeal. Mix in cumin, paprika, cayenne, chili powder, and salsa. Cover, and cook 5 minutes."
    }
  ],
  "servings": 8,

  "id": "f584c0e9-2af1-54f3-95b0-13fcb9107c10",
  "slug": "sweet-potato-potato-salad",
  "name": "Sweet Potato Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This sweet potato salad is made with white potatoes and sweet potatoes, mayonnaise, a bit of mustard, celery, and hard-boiled eggs for a unique, tasty salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add white potatoes and sweet potato; cook in boiling water until a knife is easily inserted into the centers, about 30 minutes. Drain, cool, peel, and chop potatoes into bite-sized pieces."
    },
    {
      "position": 2,
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil. Cover, remove from heat, and let eggs stand in hot water until fully hard cooked, 10 to 12 minutes. Remove from hot water; cool, peel, and chop into bite-sized pieces."
    },
    {
      "position": 3,
      "text": "Combine potatoes, eggs, celery, and onion in a large serving bowl."
    },
    {
      "position": 4,
      "text": "Whisk together mayonnaise, mustard, pepper, and salt in a small bowl until well combined. Add to potato mixture and stir to coat. Refrigerate and serve chilled."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

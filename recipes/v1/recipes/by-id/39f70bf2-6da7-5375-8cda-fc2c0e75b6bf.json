  "id": "39f70bf2-6da7-5375-8cda-fc2c0e75b6bf",
  "slug": "pork-chop-and-potato-casserole",
  "name": "Pork Chop and Potato Casserole",
  "recipe_type": "side",
  "brief_description": "Everyone loves this pork chop casserole recipe. It's easy and delicious. Pork is baked in a creamy mushroom sauce with potatoes, onion, and cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Place pork chops in the oil, and sear."
    },
    {
      "position": 3,
      "text": "Combine condensed soup and milk in a medium bowl."
    },
    {
      "position": 4,
      "text": "Arrange potatoes and onions in a 9x13-inch baking dish."
    },
    {
      "position": 5,
      "text": "Place browned pork chops over potatoes and onions, then pour the soup mixture over everything in the dish."
    },
    {
      "position": 6,
      "text": "Bake uncovered for 30 minutes in the preheated oven."
    },
    {
      "position": 7,
      "text": "Top with cheese and bake, uncovered, until cheese is melted and potatoes are tender, about 30 more minutes. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

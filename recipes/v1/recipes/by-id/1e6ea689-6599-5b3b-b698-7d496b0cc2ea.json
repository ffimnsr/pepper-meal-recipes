  "slug": "slow-cooker-tortellini-meatballs-recipe-11864480",
  "name": "Slow Cooker Tortellini Meatballs",
  "recipe_type": "main",
  "brief_description": "These slow cooker tortellini meatballs only require a few minutes of hands-on time, and features prepared meatballs and tortellini in a rich, cheesy, creamy marinara sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add meatballs, marinara, Italian seasoning, salt, and pepper to a slow cooker. Cook on Low for 3 to 4 hours."
    },
    {
      "position": 2,
      "text": "Add cream cheese to the slow cooker and stir to combine. Stir in tortellini and top with shredded mozzarella. Cook for an additional 30 minutes to 1 hour on High."
    },
    {
      "position": 3,
      "text": "Garnish with parsley or basil and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,

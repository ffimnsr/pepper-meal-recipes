  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "cefd7575-8e94-512b-aa74-1911df07bbcf",
  "slug": "berry-rhubarb-pie",
  "name": "Berry Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This scrumptious rhubarb pie with a sweet raspberry and blackberry filling baked in a homemade crust makes for a winning flavor combination.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the filling: Combine blackberries, raspberries, and rhubarb in a medium bowl. Mix 3/4 cup sugar and 1/4 cup flour together in a separate bowl; sprinkle over fruit mixture and stir gently. Cover bowl and refrigerate for 2 hours to overnight."
    },
    {
      "position": 2,
      "text": "To make the crust: Mix 2 cups flour with salt in a large bowl. Cut in shortening and 2 tablespoons butter until texture is like coarse cornmeal. Place 1/3 of mixture in a separate bowl. To the smaller portion, add water and mix to form a paste. Add this mixture back to the rest of flour mixture and stir just until dough forms a ball. Allow to rest at least 20 minutes before rolling out. Divide dough in half. Roll out bottom crust and place in 9-inch pie pan."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Mix 1 tablespoon melted butter and lemon juice into fruit filling, then spoon into pastry-lined pie pan. Roll out top crust and place over filling. Crimp edges and cut steam vents in top. Brush lightly with half and half and sprinkle lightly with sugar."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for 10 minutes. Reduce temperature to 350 degrees F (175 degrees C) and bake until crust is golden, about an additional 40 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

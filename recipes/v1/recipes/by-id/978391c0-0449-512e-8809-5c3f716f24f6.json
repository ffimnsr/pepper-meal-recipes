  "id": "978391c0-0449-512e-8809-5c3f716f24f6",
  "slug": "st-louis-toasted-ravioli",
  "name": "St. Louis Toasted Ravioli",
  "recipe_type": "main",
  "brief_description": "Toasted ravioli traces its roots to St. Louis. This breaded and fried treat is sprinkled with Parmesan cheese and served with marinara sauce for dipping.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat marinara sauce in a saucepan over medium heat until bubbling; reduce the heat to low and simmer until needed."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk egg and milk together in a small bowl. Whisk bread crumbs and salt together in a second small bowl."
    },
    {
      "position": 4,
      "text": "Dip each ravioli in milk mixture, then in bread crumbs to coat."
    },
    {
      "position": 5,
      "text": "Heat 2 inches oil in a large, heavy pan until a small amount of breading sizzles and turns brown. Fry ravioli, a few at a time, until golden, about 1 minute per side. Drain on paper towels."
    },
    {
      "position": 6,
      "text": "Sprinkle warm ravioli with Parmesan and serve immediately with hot marinara sauce on the side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "fe047f8a-cec5-5d55-97b4-4af48fc78e32",
  "slug": "mascarpone-stuffed-french-toast-with-peaches",
  "name": "Mascarpone Stuffed French Toast with Peaches",
  "recipe_type": "breakfast",
  "brief_description": "Mascarpone stuffed French toast with peaches recipe stuffs thick bread with lemon zest and mascarpone, batter dips, fries, and tops with peach sauce.",
  "cuisine": "American French",
  "instructions": [
    {
      "position": 1,
      "text": "Slice peaches over a heavy-duty saucepan to catch juices; discard pits. Stir in sugar, cinnamon, and nutmeg; cook over medium heat until bubbly and sauce reaches a syrupy consistency, stirring occasionally, about 10 minutes. Remove from heat; set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, cut off and discard ends of rolls. Cut rolls into 1 1/4-inch-thick slices. Cut a horizontal pocket into each slice, leaving three sides intact; set aside."
    },
    {
      "position": 3,
      "text": "Stir mascarpone, confectioners' sugar, and lemon zest together until smooth; transfer to a small resealable plastic bag. Snip off one corner of the bag; pipe as much filling into pocket of each bread slice as fits without overflowing."
    },
    {
      "position": 4,
      "text": "Whisk eggs, milk, and vanilla together in a shallow bowl."
    },
    {
      "position": 5,
      "text": "Melt butter with oil in a large nonstick skillet over medium heat. Dip stuffed bread slices in egg mixture. Add to the skillet; cook until browned on both sides. Serve hot with warm peach sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4986342a-5032-5bc0-a141-71e2f9d2678a",
  "slug": "beef-and-green-bean-stir-fry-recipe-8362946",
  "name": "Beef and Green Bean Stir Fry",
  "recipe_type": "main",
  "brief_description": "For this beef and green bean stir-fry, you\u2019ll want to have all your ingredients ready to go, because once you start cooking, you\u2019ll need less than 10 minutes.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Spread sirloin strips on a plate or shallow bowl in a single layer. Sprinkle baking soda over the strips and toss lightly to coat. Refrigerate for 20 minutes."
    },
    {
      "position": 2,
      "text": "Rinse meat strips with tap water and blot with paper towels to dry."
    },
    {
      "position": 3,
      "text": "Stir cornstarch and water together in a small mixing bowl, making sure there are no lumps. Add sugar, soy sauce, Shaoxing wine, Chinese 5-spice powder, and white pepper. Stir to combine."
    },
    {
      "position": 4,
      "text": "Remove all but 2 tablespoons of the liquid mixture from the mixing bowl and reserve. Add meat strips to the 2 tablespoons of liquid and toss to coat."
    },
    {
      "position": 5,
      "text": "Heat vegetable oil in a large skillet or wok over high heat, and add the meat slices, spreading them flat. Cook undisturbed for 1 minute, then stir and cook another minute."
    },
    {
      "position": 6,
      "text": "Stir in onion slices, julienned carrots, and green beans. Cook, stirring constantly, 1 to 2 minutes."
    },
    {
      "position": 7,
      "text": "Add garlic and ginger. Cook and stir for about 30 seconds, and add the reserved liquid mixture and 1 cup stock or broth. Stir frequently until the vegetables are tender-crisp and the sauce is bubbly, 1 to 2 minutes. Stir in sesame oil, to taste."
    },
    {
      "position": 8,
      "text": "Serve over hot cooked rice or cauliflower rice. Garnish with sesame seeds, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

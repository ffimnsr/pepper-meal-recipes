  "id": "bf0272b0-27ac-5d93-b618-1108e34ac009",
  "slug": "better-baked-beans",
  "name": "Better Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "This baked beans recipe uses canned baked beans to make an easy, tangy, sweet, semi-homemade favorite old-fashioned side dish for any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together baked beans, onion, syrup, brown sugar, ketchup, and mustard in a large bowl."
    },
    {
      "position": 3,
      "text": "Pour into a 9x13-inch baking dish. Lay bacon slices across the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the bacon is browned and the beans have thickened, 35 to 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

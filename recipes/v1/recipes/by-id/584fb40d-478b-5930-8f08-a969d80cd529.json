  "id": "584fb40d-478b-5930-8f08-a969d80cd529",
  "slug": "ground-turkey-stir-fry-recipe-11714821",
  "name": "I Whip Up This High-Protein Stir Fry Every Sunday for Easy Meal Prep",
  "recipe_type": "main",
  "brief_description": "This flavorful and nutritious ground turkey stir fry, with mushrooms, carrots, celery, and a spicy sauce, comes together quickly on those busy weeknights. Serve with your favorite rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together soy sauce, honey, gochujang, sesame oil, and garlic in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon vegetable oil in wok or large skillet over medium-high heat. Add mushrooms, white parts of green onions, carrots, and celery. Stir-fry veggies, stirring constantly, until crisp-tender, about 4 to 6 minutes. Transfer to a bowl."
    },
    {
      "position": 4,
      "text": "Heat remaining 2 tablespoons vegetable oil in the wok. Add ground turkey and cook, stirring every 15 to 20 seconds, and break up any large chunks, until evenly browned, about 5 to 6 minutes."
    },
    {
      "position": 5,
      "text": "Return veggies to the wok and pour sauce over top. Stir to combine and simmer for 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Top with green parts from green onions and season to taste with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "425407c1-750b-5de7-83af-2462083b983a",
  "slug": "traditional-creamy-coleslaw",
  "name": "Creamy Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This traditional coleslaw recipe features a sweet and creamy mayonnaise dressing with lemon and horseradish for a kick of heat and freshness.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, sugar, vinegar, lemon juice, horseradish, onion powder, dry mustard, celery salt, salt, and pepper in a large mixing bowl until sugar has dissolved."
    },
    {
      "position": 3,
      "text": "Fold coleslaw mix into dressing until well combined."
    }
  ],
  "servings": 12,

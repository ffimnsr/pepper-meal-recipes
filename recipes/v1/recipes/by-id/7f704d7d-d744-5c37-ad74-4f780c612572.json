  "id": "7f704d7d-d744-5c37-ad74-4f780c612572",
  "slug": "sweet-potato-pound-cake",
  "name": "Sweet Potato Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pound cake is delicately spiced, baked in a Bundt pan, and topped with a sweet orange glaze for a delicious holiday dessert.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch tube or Bundt pan."
    },
    {
      "position": 2,
      "text": "Make cake: Cream sugar and butter in a large bowl with an electric mixer on medium speed until light and fluffy. Mix in mashed sweet potatoes and vanilla until well blended. Add eggs, one at a time, mixing well after each addition. Sift together flour, baking powder, cinnamon, baking soda, nutmeg, and salt in a separate bowl; beat into potato mixture on low speed until combined. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the cake comes out clean, about 1 hour and 20 minutes. Cool cake for 20 minutes in the pan, then invert onto a serving plate."
    },
    {
      "position": 4,
      "text": "Make glaze: Stir together confectioners\u2019 sugar with 3 to 5 teaspoons orange juice in a small bowl until a drizzling consistency is reached."
    },
    {
      "position": 5,
      "text": "Spoon glaze over warm cake and sprinkle with orange zest."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 80,

  "id": "b5c5044c-6568-555a-bd44-085e55e480e7",
  "slug": "roasted-asparagus-zucchini-and-tomatoes",
  "name": "Roasted Asparagus, Zucchini, and Tomatoes",
  "recipe_type": "side",
  "brief_description": "Fresh asparagus, zucchini, yellow squash and zucchini are roasted in the oven with garlic and olive oil. A touch of lemon adds flavor and freshness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place asparagus in a microwave-safe dish with a splash of water; cook in the microwave for 3 to 4 minutes. Set aside."
    },
    {
      "position": 3,
      "text": "Spread zucchini, yellow squash, and grape tomatoes on the prepared baking sheet. Drizzle with olive oil; sprinkle with garlic and sea salt."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven for 5 minutes. Add asparagus and roast until vegetables are tender, 3 to 5 more minutes."
    },
    {
      "position": 5,
      "text": "Transfer roasted vegetables to a serving bowl; squeeze lemon juice over the top and season with sea salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

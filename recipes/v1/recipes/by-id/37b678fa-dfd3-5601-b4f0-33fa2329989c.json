  "id": "37b678fa-dfd3-5601-b4f0-33fa2329989c",
  "slug": "savory-spanish-potato-salad",
  "name": "Savory Spanish Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This Spanish-style potato salad includes red potatoes, bell pepper, and olives tossed in an olive oil-based dressing for a crowd-pleasing side.",
  "cuisine": "Mediterranean Inspired Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain and cool until easily handled. Slice potatoes about 1/2-inch thick and place in a bowl."
    },
    {
      "position": 2,
      "text": "Whisk olive oil and vinegar together in a bowl; stir in garlic. Pour dressing over potatoes and lightly toss to coat."
    },
    {
      "position": 3,
      "text": "Mix red bell pepper, green olives, shallot, parsley, salt, and pepper into potatoes. Serve salad with lemon wedges to squeeze over each serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

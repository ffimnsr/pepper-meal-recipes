{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8b76cced-3e48-5c22-bb86-76db89bf4723",
  "slug": "loaded-bundt-pan-copycat-taco-bell-nacho-fries-recipe-11948805",
  "name": "Loaded Bundt Pan Copycat Taco Bell Nacho Fries",
  "recipe_type": "appetizer",
  "brief_description": "These loaded Bundt pan copycat Taco Bell nacho fries have it all, from taco-seasoned beef and Mexican cheese to pickled jalapenos and chile con queso. Plus, they're loaded fries baked in a Bundt pan, for a tower of cheesy goodness!",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Cook frozen fries according to package directions and set aside to cool slightly for 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 12 to 14-cup nonstick Bundt pan generously with cooking spray."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high. Add beef and cook, breaking up meat into small pieces until browned, about 5 minutes. Stir in taco seasoning and water; cook according to package directions. Transfer cooked beef to a plate to cool for 5 minutes."
    },
    {
      "position": 4,
      "text": "Add about a third of the cooked fries to the bottom of the prepared Bundt pan, followed by 1 cup of the Mexican blend cheese and half of the beef mixture. Spoon 1/4 cup of the queso evenly on top of the beef; sprinkle with 1/2 cup tomatoes and 1 cup of the Mexican blend cheese. Repeat layers once more. Top with remaining fries and 1 cup Mexican blend cheese."
    },
    {
      "position": 5,
      "text": "Generously coat a sheet of aluminum foil with cooking spray; tightly cover Bundt pan with foil, sprayed side down."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Discard foil and carefully invert Bundt pan onto large serving platter. Top with lettuce and jalape\u00f1os. Serve with pico de gallo, hot sauce, and additional chili con queso, if desired. Recipe developed by Isabell Easter"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,

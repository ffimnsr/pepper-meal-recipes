  "id": "20d2967e-6fbe-5e89-b3d2-121591922bc2",
  "slug": "amazing-peach-sangria",
  "name": "Amazing Peach Sangria",
  "recipe_type": "drink",
  "brief_description": "Light, refreshing, and super easy to make and chill ahead for parties, this peach white wine sangria is sure to be a hit.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine triple sec, sugar, and lemon juice in a bowl and stir to dissolve; add peaches. Put in the refrigerator for 8 hours, or overnight."
    },
    {
      "position": 2,
      "text": "Pour peach mixture into a pitcher, top with Prosecco, and serve immediately. Garnish each glass with a few frozen grapes and strawberries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

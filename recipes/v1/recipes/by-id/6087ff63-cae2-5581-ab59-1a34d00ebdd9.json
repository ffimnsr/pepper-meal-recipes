  "id": "6087ff63-cae2-5581-ab59-1a34d00ebdd9",
  "slug": "super-meat-lovers-cheddar-biscuit-breakfast-sandwich-recipe-11699665",
  "name": "Super Meat Lovers Cheddar Biscuit Breakfast Sandwich",
  "recipe_type": "breakfast",
  "brief_description": "This super meat lovers Cheddar biscuit breakfast sandwich is not your average bacon, egg, and cheese breakfast sammie. The combination of Cheddar biscuits, bacon, and sausage takes it to the next level\u2014perfect for hearty appetites!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) and line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Add flour, grated Cheddar, parsley, baking powder, garlic powder and salt to a bowl and mix to combine. Add milk and shortening. Use a fork or pastry cutter to cut shortening into dry ingredients until combined."
    },
    {
      "position": 3,
      "text": "Turn dough onto a cutting board and form into an 8-inch square. Cut into 4 pieces, then transfer to prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until biscuits are golden brown, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, fry bacon in a nonstick skillet over medium-high heat until crisp, turning occasionally, about 5 minutes. Drain bacon on a plate lined with paper towels; drain any excess grease from the skillet. Add sausage patties; fry, turning occasionally, until no longer pink at the center, about 5 minutes. Remove to a plate."
    },
    {
      "position": 6,
      "text": "Add olive oil to the skillet and fry or scramble eggs to your taste."
    },
    {
      "position": 7,
      "text": "Slice biscuits open horizontally, and assemble the sandwich, from top to bottom: bottom half of biscuit, egg, Cheddar cheese slice, bacon, and sausage, then finish it with the other biscuit half on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

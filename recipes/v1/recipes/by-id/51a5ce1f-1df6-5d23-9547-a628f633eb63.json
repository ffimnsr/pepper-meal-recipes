  "id": "51a5ce1f-1df6-5d23-9547-a628f633eb63",
  "slug": "chilaquiles-scramble",
  "name": "Chilaquiles Scramble",
  "recipe_type": "breakfast",
  "brief_description": "This recipe for chilaquiles with scrambled eggs, Cotija cheese, and avocado is a tasty way to start the day.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon olive oil in a skillet over medium-high heat. Add onion and jalape\u00f1o; cook and stir until onion is translucent, about 5 minutes. Add tomato and garlic; cook and stir for 1 minute. Add salsa and scrape any browned bits off the bottom of the pan. Season with cumin, salt, and pepper. Reduce the heat and simmer for 2 minutes. Add tortilla chips to the pan and stir until coated with sauce."
    },
    {
      "position": 2,
      "text": "Heat remaining 1 tablespoon oil in a separate skillet over medium-high heat. Whisk eggs together in a bowl, then pour into the hot pan and cook until starting to set, about 2 minutes. Scrape cooked egg from the edges and fold into the center. Cook until eggs are halfway cooked but still runny, 2 to 3 minutes more."
    },
    {
      "position": 3,
      "text": "Fold eggs into tortilla chip mixture. Keep stirring to finish scrambling the eggs, about 2 minutes. Add Cotija cheese and turn off the heat."
    },
    {
      "position": 4,
      "text": "Divide egg mixture among four plates. Garnish with avocado, cilantro, and sour cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

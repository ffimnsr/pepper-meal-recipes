  "id": "0e13e186-371b-5989-92ed-f6786fa18fee",
  "slug": "chicken-pad-thai-with-peanut-sauce",
  "name": "Chicken Pad Thai with Peanut Sauce",
  "recipe_type": "dessert",
  "brief_description": "This chicken pad Thai with peanut sauce is perfect for those who love Thai food. Rice noodles and sweet-and-savory peanut sauce go great with chicken.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Place noodles in a large bowl and cover with cold water. Soak until soft, 30 to 50 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Combine soy sauce and cornstarch in a bowl; stir to dissolve cornstarch. Place chicken in a separate bowl and pour soy sauce mixture on top. Stir well and set aside."
    },
    {
      "position": 3,
      "text": "Mix together 1/4 cup sugar, fish sauce, tamarind juice, and lime juice in a saucepan over medium heat and simmer for about 5 minutes. Keep sauce warm."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon of oil in a second skillet over medium-high heat and add chicken. Cook until no longer pink in the middle and juices run clear, 5 to 10 minutes. Reduce heat and keep chicken warm."
    },
    {
      "position": 5,
      "text": "Heat remaining 2 tablespoons oil in a large wok over medium heat. Add garlic and eggs, stirring to scramble, about 5 minutes. Add cooked chicken and stir until well mixed. Add drained noodles and stir until warmed through, 5 to 10 minutes more."
    },
    {
      "position": 6,
      "text": "Stir sauce, 3/4 teaspoon sugar, and salt into noodle mixture in the wok. Stir in peanuts and chili powder. Remove from heat and top with chives. Serve pad thai with bean sprouts on the side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

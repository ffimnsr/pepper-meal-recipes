  "id": "70e4334f-4c30-598c-90af-9d706f9c3ecc",
  "slug": "wine-and-garlic-pork-portuguese-vina-dosh",
  "name": "Wine and Garlic Pork (Portuguese Vina Dosh)",
  "recipe_type": "main",
  "brief_description": "This wine and garlic pork (Portuguese vina dosh) recipe calls for marinating pork shoulder for days in red wine vinegar, wine, and various seasonings.",
  "cuisine": "Portuguese American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk red wine vinegar, red wine, garlic, black pepper, salt, cloves, bay leaves, and thyme together in a bowl; pour into a resealable plastic bag. Add pork, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator 2 to 4 days, turning occasionally."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove pork from marinade and shake off excess, Reserve 1/2 cup marinade; discard remaining marinade. Put pork and reserved 1/2 cup marinade in a baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pork is completely warmed, about 20 minutes. Drain as much liquid from pork as possible."
    },
    {
      "position": 5,
      "text": "Heat vegetable oil in a large skillet over medium-low heat. Add pork to the skillet in batches; cook and stir until completely browned and no longer pink in centers, 10 to 15 minutes. Repeat with remaining pork."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

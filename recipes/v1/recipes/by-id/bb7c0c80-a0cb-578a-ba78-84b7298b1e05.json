  "id": "bb7c0c80-a0cb-578a-ba78-84b7298b1e05",
  "slug": "spicy-chicken-noodle-soup",
  "name": "Spicy Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This simple, quick one-pot chicken vegetable noodle soup is too easy to taste this amazing.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir chicken in a large pot over medium heat until lightly browned, about 5 minutes; stir in garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Stir vegetable broth, carrots, and corn into chicken mixture; bring to a boil. Stir rice noodles, red pepper, basil, and chili flakes into chicken mixture; reduce heat and simmer until noodles are tender, about 5 minutes."
    }
  ],
  "servings": 8,

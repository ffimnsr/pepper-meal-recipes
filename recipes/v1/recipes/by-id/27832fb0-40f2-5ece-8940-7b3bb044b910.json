  "id": "27832fb0-40f2-5ece-8940-7b3bb044b910",
  "slug": "irish-soda-bread-and-whiskey-butter",
  "name": "Irish Soda Bread and Whiskey Butter",
  "recipe_type": "snack",
  "brief_description": "Delicious whiskey butter, made from raisin-infused whiskey, is a real treat slathered over warm slices of Irish soda bread from an old family recipe.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place raisins into a small bowl. Pour in whiskey and allow to soak, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "The next day, strain raisins, reserving whiskey. Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, baking powder, salt, and baking soda in a large bowl. Stir in drained raisins, orange peel, and caraway seeds. Beat in buttermilk and 1/4 cup melted butter until incorporated and batter is thick. Transfer to the prepared casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown on top and a toothpick inserted into the center comes out clean, about 1 hour and 10 minutes."
    },
    {
      "position": 5,
      "text": "Beat 1/2 cup butter in a bowl until fluffy; beat in reserved whiskey, 1 teaspoon at a time, to taste. Serve with soda bread."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "8abec42d-f8cf-53bf-a457-14f01e67bd00",
  "slug": "barbadian-plain-cake",
  "name": "Barbadian Plain Cake",
  "recipe_type": "dessert",
  "brief_description": "This Barbadian plain cake recipe is a simple pound cake that's been enjoyed for generations. It's a staple in many Caribbean households.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Lightly grease and flour a 9- or 10-inch Bundt pan. Sift flour and baking powder together into a bowl."
    },
    {
      "position": 2,
      "text": "Use a spatula to cream butter and sugar together by hand until light and fluffy. Add eggs all at once and mix well. Mix in flour mixture and 1 cup milk; batter will be doughy. Mix in remaining 1 cup milk along with vanilla and almond extracts. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 hour. Reduce the heat to 350 degrees F (175 degrees C) and continue baking for 15 more minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 25,

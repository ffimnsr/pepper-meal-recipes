  "id": "60f52225-e19e-5e7c-b571-37a6bd4b1e38",
  "slug": "hot-spiked-cider",
  "name": "Hot Spiked Cider",
  "recipe_type": "drink",
  "brief_description": "This hot spiked cider adds rum, brown sugar, and butter; simply delicious for fall or holiday gatherings to warm you up from the inside out!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water into a large saucepan and bring to a boil."
    },
    {
      "position": 2,
      "text": "Remove from heat and add orange spice tea bags. Cover and let steep for 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove tea bags and stir in apple cider, rum, brown sugar, and 2 cinnamon sticks. Heat cider over medium-low heat until just steaming."
    },
    {
      "position": 4,
      "text": "Ladle hot cider into 6 mugs and drop 1/2 teaspoon butter into each. Garnish with a cinnamon \"swizzle\" stick."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

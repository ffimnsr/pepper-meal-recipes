  "id": "83a0d7c1-0671-51b5-bae0-33e678c90496",
  "slug": "easy-nachos-with-refried-beans",
  "name": "Easy Nachos with Refried Beans",
  "recipe_type": "appetizer",
  "brief_description": "Nachos with refried beans make an easy party favorite. Tortilla chips are topped with a seasoned bean mixture, cheese, and jalape\u00f1os before baking.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine refried beans, garlic powder, onion powder, and cumin in a bowl; mix well."
    },
    {
      "position": 3,
      "text": "Pour tortilla chips onto a baking sheet in one layer. Spoon bean mixture over tortilla chips. Top with Colby-Monterey Jack cheese and jalape\u00f1os."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

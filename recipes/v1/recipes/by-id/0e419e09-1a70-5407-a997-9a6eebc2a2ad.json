  "slug": "corned-beef-hash",
  "name": "Corned Beef Hash",
  "recipe_type": "breakfast",
  "brief_description": "This corned beef hash with potatoes is prepared in one skillet with leftover or canned corned beef for a quick and filling breakfast with eggs.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine potatoes, corned beef, onion, and broth in a large, deep skillet over medium heat. Cover and simmer until potatoes are soft enough to mash and liquid is almost gone."
    },
    {
      "position": 3,
      "text": "Mix well and serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

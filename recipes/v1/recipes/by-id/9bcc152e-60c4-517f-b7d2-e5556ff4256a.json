  "id": "9bcc152e-60c4-517f-b7d2-e5556ff4256a",
  "slug": "blt-salad",
  "name": "BLT Salad",
  "recipe_type": "salad",
  "brief_description": "This BLT salad with romaine lettuce, pieces of crispy bacon, tomatoes, crunchy croutons, and a creamy garlic dressing makes a great summertime dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble and set aside"
    },
    {
      "position": 2,
      "text": "Combine mayonnaise, milk, garlic powder, and black pepper together in a blender or food processor; blend until smooth. Season with salt."
    },
    {
      "position": 3,
      "text": "Combine lettuce, crumbled bacon, tomatoes, and croutons in a large salad bowl. Toss with dressing, and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

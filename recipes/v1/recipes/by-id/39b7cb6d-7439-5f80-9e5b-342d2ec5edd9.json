  "id": "39b7cb6d-7439-5f80-9e5b-342d2ec5edd9",
  "slug": "green-chutney",
  "name": "Green Chutney",
  "recipe_type": "drink",
  "brief_description": "This is a very tasty cilantro-based chutney that can be prepared in minutes. Just add fresh lemon juice, a small green chili, peanuts, salt, garlic, and fresh ginger to the cilantro and process until smooth.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Blend the following in a food processor until smooth: cilantro, garlic, ginger, green chili, peanuts, salt to taste, and lemon juice. Add a few drops of water if the mixture is too dry."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

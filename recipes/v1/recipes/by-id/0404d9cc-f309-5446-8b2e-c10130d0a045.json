  "id": "0404d9cc-f309-5446-8b2e-c10130d0a045",
  "slug": "pumpkin-pie-overnight-oats",
  "name": "Pumpkin Pie Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Warm spices and a hint of brown sugar mixed with pumpkin add a fall flavor to these overnight oats. This grab-and-go breakfast tastes like Thanksgiving pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a pint jar or at least 12 ounce glass, mix oats and almondmilk. In a small bowl, mix pumpkin, brown sugar and spice. Spoon over oats. Cover; refrigerate 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "To serve, stir mixture and top with pepitas."
    },
    {
      "position": 3,
      "text": "Refrigerate leftovers."
    }
  ],

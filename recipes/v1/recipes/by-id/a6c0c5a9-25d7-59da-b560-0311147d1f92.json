  "id": "a6c0c5a9-25d7-59da-b560-0311147d1f92",
  "slug": "instant-potato-pancakes",
  "name": "Instant Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These potato pancakes with instant potato flakes are Chef John's easy recipe for crispy and flavorful mashed potato pancakes, perfect as a side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together cold water, egg, and salt in a large bowl until salt has dissolved. Mix in dry potato flakes until incorporated. Stir in 1 tablespoon chives; season with black pepper and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Divide potato mixture into 4 equal portions and shape into pancakes."
    },
    {
      "position": 3,
      "text": "Heat oil and butter in a large skillet over medium-high heat. Swirl the pan to combine."
    },
    {
      "position": 4,
      "text": "Place pancakes in the pan, reduce heat to medium, and cook until the bottoms are browned, about 10 minutes. Flip and flatten slightly. Cook until other sides are browned, 7 to 8 more minutes."
    },
    {
      "position": 5,
      "text": "Transfer pancakes to a serving plate. Top each with a dollop of sour cream and sprinkle with remaining chives."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "de418cdc-b175-52d7-849e-175d53e7d494",
  "slug": "chinese-stir-fried-sticky-rice-with-chinese-sausage",
  "name": "Chinese Stir-Fried Sticky Rice with Chinese Sausage",
  "recipe_type": "main",
  "brief_description": "Sticky rice is slowly cooked on the stove with sausage, similar to the way risotto is cooked, in this flavorful Chinese-style stir-fry.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Soak rice in a large bowl of water until mostly translucent, about 4 hours. Rinse and drain thoroughly."
    },
    {
      "position": 2,
      "text": "When the rice is almost finished soaking, soak shrimp, scallops, and mushrooms in three separate bowls of water until softened, about 15 minutes. Drain shrimp and scallops. Drain mushrooms and reserve mushroom water. Chop shrimp, scallops, and mushrooms into small pieces."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat. Pour in eggs and swirl the skillet to spread into a thin layer. Cook until mostly firm, about 1 minute. Flip and cook until no longer runny, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer eggs to a cutting board and allow to cool slightly. Roll into a long tube and slice into thin ribbons."
    },
    {
      "position": 5,
      "text": "Stir Chinese sausage into the same skillet over medium heat. Cook and stir until fragrant and some of the oil is released, about 3 minutes. Add shrimp, scallops, and mushrooms; cook for 3 to 5 minutes, then transfer to a bowl."
    },
    {
      "position": 6,
      "text": "Stir drained rice into the skillet. Cook and stir until lightly toasted, 1 to 2 minutes. Pour in reserved mushroom water and stir constantly until water is absorbed. Add hot water, 1/2 cup at a time, stirring until water is absorbed between each addition. Cook until rice is softened, about 25 minutes."
    },
    {
      "position": 7,
      "text": "Season rice with both soy sauces and sugar. Stir in egg ribbons and sausage mixture. Top with cilantro before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

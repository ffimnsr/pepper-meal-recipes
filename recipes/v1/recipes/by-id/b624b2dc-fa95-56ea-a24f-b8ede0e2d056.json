  "schema_version": 1,
  "id": "b624b2dc-fa95-56ea-a24f-b8ede0e2d056",
  "slug": "bacon-cheddar-deviled-eggs",
  "name": "Bacon Cheddar Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These bacon deviled eggs are a tasty option for any party. Filled with a creamy blend of yolks, mayo, bacon, Cheddar, and mustard, they won't last long!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil, then immediately remove from the heat. Cover the pan and let eggs stand in hot water for 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Remove eggs from the hot water and rinse under cold running water to cool."
    },
    {
      "position": 3,
      "text": "While the eggs are standing in hot water, cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels, then crumble."
    },
    {
      "position": 4,
      "text": "Peel cooled eggs and cut in half lengthwise. Transfer yolks to a bowl."
    },
    {
      "position": 5,
      "text": "Add mayonnaise, bacon, Cheddar, and mustard to yolks, then mash to combine. Spoon egg yolk mixture into egg white halves. Serve immediately or cover and refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "82bbf0b4-42d7-5824-83da-f872a78f1833",
  "slug": "hummus-i",
  "name": "Hummus I",
  "recipe_type": "appetizer",
  "brief_description": "If you only have one recipe for this wonderful dip, this is it. Everything goes into the food processor - garbanzo beans, roasted tahini, lemon juice, garlic, parsley and green onion. Zap, and you have it.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place garbanzo beans, tahini, lemon juice, lemon zest, garlic, parsley, and green onion in the bowl of a food processor. Blend until smooth, adding water if the mixture is too thick. Season to taste with salt and pepper."
    }
  ],

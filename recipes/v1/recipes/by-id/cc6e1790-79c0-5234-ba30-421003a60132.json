  "id": "cc6e1790-79c0-5234-ba30-421003a60132",
  "slug": "southwestern-quinoa-salad",
  "name": "Southwestern Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "Southwestern quinoa salad made with quinoa mixed with corn, black beans, tomato, fresh cilantro, and feta cheese.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse quinoa thoroughly under cold water; drain."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Cook and stir quinoa until water evaporates and quinoa is lightly toasted, about 3 minutes. Pour in chicken broth and bring to a boil. Reduce heat to low and simmer until quinoa has absorbed broth, about 10 minutes. Cool quinoa in the refrigerator for at least 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix together green bell pepper, red onion, corn, black beans, cilantro, tomato, lime juice, red wine vinegar, olive oil, adobo seasoning, and feta cheese in a large salad bowl."
    },
    {
      "position": 4,
      "text": "Lightly stir in quinoa; season with salt, pepper, and additional lime juice to taste. Chill salad at least 30 minutes before serving; serve cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "75f75a4d-85cf-5abf-b5df-534260fdf9d2",
  "slug": "southern-style-neck-bones",
  "name": "Southern-Style Neck Bones",
  "recipe_type": "main",
  "brief_description": "Pork neck bones cooked until tender and succulent are roasted to a golden brown in this satisfying Southern-style recipe. Delicious with greens!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sprinkle 3/4 of the chopped onions and 3/4 of the chopped garlic into the bottom of a roasting pan; pour in water and vinegar. Season neck bones with salt and pepper and place in the roasting pan. Sprinkle remaining onions and garlic over top and cover the roasting pan tightly with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 2 hours, basting every 30 minutes and recovering with the foil every time you baste."
    },
    {
      "position": 4,
      "text": "Remove the foil and continue cooking until neck bones are golden brown, about 45 more minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 15,

  "id": "388b50fa-35e8-59b2-a45b-9589975d03b8",
  "slug": "one-pot-chicken-pomodoro-recipe-8730087",
  "name": "One Pot Chicken Pomodoro",
  "recipe_type": "main",
  "brief_description": "This one pot chicken pomodoro features boneless chicken, a bright, fresh-flavored tomato sauce, and pasta, cooked all in one deep skillet. It is a fabulous weeknight dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Heat a deep cast iron skillet over medium heat."
    },
    {
      "position": 2,
      "text": "Season chicken breasts with salt, garlic, and Italian seasoning."
    },
    {
      "position": 3,
      "text": "Pour 2 teaspoons oil into the skillet. Once hot, add chicken. Cook until golden, turning once, about 4 minutes per side. Move chicken to one side of the skillet."
    },
    {
      "position": 4,
      "text": "Pour remaining oil into the skillet. Add minced shallot; cook until softened, about 3 minutes. Add the garlic, stir until fragrant, about 1 minute."
    },
    {
      "position": 5,
      "text": "Add the crushed tomatoes, salt, sugar, red pepper flakes, and basil. Pour in chicken broth and wine. Stir to combine."
    },
    {
      "position": 6,
      "text": "Add pasta to the skillet. Nestle chicken pieces on top of pasta. Reduce heat to medium-low. Cover, and cook until pasta is tender with a bite, about 8 minutes. Taste and adjust seasoning; serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "c0c39f3c-11c8-591d-b34d-1fd452fdaa92",
  "slug": "air-fryer-shoestring-pickles-recipe-12065365",
  "name": "Air Fryer Shoestring Pickles",
  "recipe_type": "appetizer",
  "brief_description": "These crispy shoestring pickles are made from whole spiralized pickles that are breaded and cooked in the air fryer until golden. Quick and easy to make, they\u2019re a fun twist on fried pickles and deliver \u201cperfect crunch in every bite.\u201d",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Using a spiralizer, spiralize pickles into long \u201cshoestrings.\u201d Gently combine pickles with beaten eggs in a large bowl."
    },
    {
      "position": 2,
      "text": "Combine flour, breadcrumbs, seasoning salt, and dried dill in a separate bowl."
    },
    {
      "position": 3,
      "text": "Working in small batches so they do not clump together, carefully coat pickles by gently pressing breadcrumb mixture onto the pickle strings."
    },
    {
      "position": 4,
      "text": "Spray the air fryer tray with cooking spray and spread out the pickle strings into the air fryer, leaving space between them. You may have to work in batches. Spray the pickle strings with cooking spray."
    },
    {
      "position": 5,
      "text": "Air fry at 400 degrees F (200 degrees C) until golden brown, 5 to 7 minutes. Place pickles on a paper towel- lined plate to allow them to crisp up before serving."
    },
    {
      "position": 6,
      "text": "Serve immediately with ranch dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

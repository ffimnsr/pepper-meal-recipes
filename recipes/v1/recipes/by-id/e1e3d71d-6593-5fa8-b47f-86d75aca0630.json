  "id": "e1e3d71d-6593-5fa8-b47f-86d75aca0630",
  "slug": "gramas-corn-flake-peanut-butter-cookies",
  "name": "Grama's Cornflake Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter cornflake cookies are easy to make for a sweet treat! Once the sugar mixture has boiled, your kids can help with the rest!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring sugar and corn syrup to a boil in a saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Stir in butter and peanut butter until thoroughly combined, then remove from the heat."
    },
    {
      "position": 4,
      "text": "Place cornflakes into a large bowl. Pour peanut butter mixture over top and mix until cornflakes are well coated."
    },
    {
      "position": 5,
      "text": "Drop 1-tablespoon scoops of the mixture onto a waxed-paper lined baking sheet. Flatten slightly if desired, then allow to cool for 30 minutes before serving."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

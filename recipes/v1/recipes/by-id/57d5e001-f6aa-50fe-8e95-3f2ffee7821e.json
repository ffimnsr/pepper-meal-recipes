  "id": "57d5e001-f6aa-50fe-8e95-3f2ffee7821e",
  "slug": "cast-iron-skillet-buttermilk-cornbread",
  "name": "Cast Iron Skillet Buttermilk Cornbread",
  "recipe_type": null,
  "brief_description": "White and yellow cornmeal are combined with lard and buttermilk and baked in a cast iron skillet in this traditional Southern cornbread.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place a cast iron skillet in the oven and preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together white cornmeal, yellow cornmeal, flour, baking powder, and salt in a large bowl until well combined. Add buttermilk, lard, and vegetable oil; stir well to combine. Mix in egg until smooth batter forms."
    },
    {
      "position": 3,
      "text": "Remove hot cast iron skillet from the oven, melt butter in the hot skillet, then pour in batter. Top with paprika and kosher salt. Return the skillet to the preheated oven."
    },
    {
      "position": 4,
      "text": "Reduce temperature to 425 degrees F (220 degrees C) and bake until cornbread is golden brown and pulling away from the sides of the skillet, about 15 minutes. Remove from the oven to cool slightly, about 5 minutes. Cut into wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

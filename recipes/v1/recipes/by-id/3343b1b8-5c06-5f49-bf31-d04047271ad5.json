  "id": "3343b1b8-5c06-5f49-bf31-d04047271ad5",
  "slug": "blue-hawaiian-cocktail",
  "name": "Blue Hawaiian Cocktail",
  "recipe_type": "drink",
  "brief_description": "The Blue Hawaiian is a classic tiki cocktail made with rum, cream of coconut, pineapple juice, and Curacao liqueur to create its iconic blue color.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine crushed ice, pineapple juice, rum, blue Curacao, and cream of coconut in a blender."
    },
    {
      "position": 2,
      "text": "Blend on high speed until smooth and an even blue color."
    },
    {
      "position": 3,
      "text": "Pour into a chilled highball glass. Garnish with a slice of pineapple and a maraschino cherry."
    }
  ],
  "servings": 1,

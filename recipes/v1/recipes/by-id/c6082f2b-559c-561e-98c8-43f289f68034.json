  "id": "c6082f2b-559c-561e-98c8-43f289f68034",
  "slug": "chicken-parm-smashed-tacos-with-caprese-salsa-recipe-11933529",
  "name": "Chicken Parm Smashed Tacos with Caprese Salsa",
  "recipe_type": "main",
  "brief_description": "Try these chicken Parm smashed tacos topped with a Caprese salsa of tomatoes, mozzarella, basil, and olive oil. It's your next dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, 1/4 cup Parmesan cheese, garlic, Italian seasoning, 1/2 teaspoon salt, and 1/4 teaspoon pepper in a bowl. Mix until well combined."
    },
    {
      "position": 2,
      "text": "Spread mixture evenly and all the way to the edges of each tortilla."
    },
    {
      "position": 3,
      "text": "Place eggs in a shallow dish. Stir together breadcrumbs and remaining Parmesan cheese in second shallow dish."
    },
    {
      "position": 4,
      "text": "Dip each tortilla, meat side down, into egg mixture, allowing any excess to drip off and then press lightly into breadcrumb mixture to coat."
    },
    {
      "position": 5,
      "text": "Working in batches, in a large skillet, heat 2 tablespoons oil over medium-high heat until just shimmering. Place tortillas, breaded side down, in the skillet and allow to cook until golden brown and crisp, about 4 minutes. Flip and cook until lightly golden brown, about 1 more minute. Repeat with remaining tortillas and add more oil as needed."
    },
    {
      "position": 6,
      "text": "For Caprese salsa, stir tomatoes, mozzarella, basil, 1 tablespoon olive oil, vinegar, and remaining salt and pepper together in a bowl."
    },
    {
      "position": 7,
      "text": "Fold tacos in half and serve, topped with Caprese salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

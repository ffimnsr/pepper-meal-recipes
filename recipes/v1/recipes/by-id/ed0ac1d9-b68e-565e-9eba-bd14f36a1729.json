  "id": "ed0ac1d9-b68e-565e-9eba-bd14f36a1729",
  "slug": "bolognese-sauce",
  "name": "Bolognese Sauce",
  "recipe_type": "main",
  "brief_description": "Simple Bolognese recipe for meaty, chunky pasta sauce with beef, pork, bacon, onion, and chopped vegetables simmered in herby wine and tomato sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Warm oil in a large skillet over medium heat. Saut\u00e9 onion, bacon, and garlic in hot oil until bacon is browned and crisp, about 10 minutes. Use a slotted spoon to transfer bacon mixture to a paper towel-lined plate to drain; set aside."
    },
    {
      "position": 2,
      "text": "Place the same large skillet over medium-high heat. Cook and stir ground beef and pork in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Stir bacon mixture, tomatoes, mushrooms, tomato sauce, carrots, celery, wine, stock, basil, oregano, salt, and pepper into meat mixture. Bring to a boil. Cover, reduce heat, and simmer sauce for 1 hour, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add pasta and cook in boiling water until al dente, 8 to 10 minutes; drain."
    },
    {
      "position": 5,
      "text": "Serve sauce over hot pasta."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "551d5a66-673b-550e-8efc-8f0b076fc773",
  "slug": "rhode-island-clam-chowder",
  "name": "Rhode Island Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "Neither red nor white, this clear soup brings out the pure flavors of clams and potatoes.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Bring shucked clams, clam juice, and chicken stock to a simmer in a large pot over medium-high heat. Reduce heat to medium-low and simmer 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Stir in onion and celery; cook and stir until vegetables are tender. Stir onion mixture and potatoes into clams. Season with dill, black pepper, salt, cayenne pepper, and hot pepper sauce. Simmer 15 minutes longer. Sprinkle with parsley to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,

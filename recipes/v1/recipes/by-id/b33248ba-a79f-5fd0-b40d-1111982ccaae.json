  "slug": "slow-cooker-chicken-and-gravy-recipe-11693381",
  "name": "Slow Cooker Chicken and Gravy",
  "recipe_type": "main",
  "brief_description": "This slow cooker chicken and gravy could not be easier. You'll want to serve this over hot rice or mashed potatoes for the ultimate comfort food dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a 6-quart slow cooker, whisk together canned soup, gravy mix. chicken broth, salt, and pepper. Add chicken. Cover and cook on Low for 4 hours."
    },
    {
      "position": 2,
      "text": "Before serving, carefully shred chicken using a hand mixer."
    }
  ],
  "servings": 6,

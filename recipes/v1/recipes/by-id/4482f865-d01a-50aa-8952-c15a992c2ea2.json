  "id": "4482f865-d01a-50aa-8952-c15a992c2ea2",
  "slug": "japanese-wasabi-deviled-eggs",
  "name": "Japanese Wasabi Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "In this Japanese wasabi deviled eggs recipe, wasabi adds a nice, zesty twist to deviled eggs. They\u2019re garnished with fresh pea shoots and pickled ginger.",
  "cuisine": "American Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan; cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel."
    },
    {
      "position": 2,
      "text": "Cut eggs in half lengthwise; place egg yolks in a bowl. Mash yolks with a fork until smooth; stir in mayonnaise, green onions, rice wine vinegar, and wasabi paste. Season with salt."
    },
    {
      "position": 3,
      "text": "Arrange egg white halves, cut-sides up on a serving platter. Spoon yolk mixture into whites; garnish with pea shoots and pickled ginger."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8944c20e-ec3c-5513-9149-9fd226cd1c30",
  "slug": "4-ingredient-chocolate-donuts-recipe-11961388",
  "name": "4-Ingredient Chocolate Donuts",
  "recipe_type": "dessert",
  "brief_description": "These super-easy 4-ingredient chocolate donuts satisfy a craving in a hurry. They have no sugar, so if you'd like them a little sweeter, roll them in sugar or sprinkles while they are still hot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together flour, cocoa powder and baking powder in a bowl until fully combined"
    },
    {
      "position": 3,
      "text": "Mix in Greek yoghurt until you get a thick, sticky dough. Transfer to a piping bag and pipe small balls onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 12 minutes."
    },
    {
      "position": 5,
      "text": "Brush with melted butter and coat with your favourite toppings."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "31cbd4db-2f06-5b60-8b5a-7166ad53c186",
  "slug": "bloody-mary-cocktail",
  "name": "Bloody Mary Cocktail",
  "recipe_type": "drink",
  "brief_description": "Spice up your brunch with this lively, eye-opening cocktail, which delivers a bold, flavorful punch that'll awaken your senses and kick-start your day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a pint glass or goblet with 1 1/2 cups ice. Set aside."
    },
    {
      "position": 2,
      "text": "Combine tomato juice, vodka, lemon juice, hot pepper sauce, Worcestershire sauce, salt, black pepper, and 1 cup ice in a mixing glass. Stir until chilled and strain into the reserved ice-filled pint glass or goblet."
    },
    {
      "position": 3,
      "text": "Garnish with celery stalk."
    }
  ],
  "servings": 1,

  "id": "28ea9b16-0762-5a75-a939-e259cb16e92f",
  "slug": "grilled-marinated-shrimp",
  "name": "Grilled Marinated Shrimp",
  "recipe_type": "main",
  "brief_description": "A simple shrimp marinade made with lemon, garlic, parsley, and hot sauce adds flavor to juicy shrimp grilled on skewers for a great summer meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, parsley, lemon juice, hot pepper sauce, garlic, tomato paste, oregano, salt, and black pepper together in a mixing bowl. Reserve a small amount for basting later."
    },
    {
      "position": 3,
      "text": "Pour remaining marinade into a large resealable plastic bag; add shrimp, coat with the marinade, squeeze out excess air, and seal the bag. Marinate shrimp in the refrigerator for 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat a grill to medium-low heat. Thread shrimp onto skewers, piercing once near the tail and once near the head. Discard any remaining marinade."
    },
    {
      "position": 5,
      "text": "Lightly oil the grill grate. Cook shrimp until opaque, about 5 minutes per side, basting frequently with reserved marinade."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

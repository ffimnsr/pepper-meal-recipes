  "id": "e0bc9936-d0de-5b4a-8daa-03fa3a477798",
  "slug": "very-easy-risotto",
  "name": "Very Easy Risotto",
  "recipe_type": "main",
  "brief_description": "This easy risotto recipe is made with sautee\u00e9d green onion and Parmesan for a quick and easy stovetop dish that doesn't require constant stirring.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium-high heat. Cook and stir green onion in hot butter briefly, then add rice. Cook and stir until rice is toasted, 2 to 3 minutes. Pour in water; season with chicken bouillon and pepper. Bring to a boil, then reduce heat to medium-low. Cover and simmer for 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat. Let stand, covered, for 5 minutes. Stir in Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

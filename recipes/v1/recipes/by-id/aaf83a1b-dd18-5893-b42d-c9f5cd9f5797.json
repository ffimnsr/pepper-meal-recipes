  "schema_version": 1,
  "id": "aaf83a1b-dd18-5893-b42d-c9f5cd9f5797",
  "slug": "caramel-cinnamon-rolls",
  "name": "Caramel Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "Treat yourself to gooey caramel rolls laced with pecans and a sticky caramel sauce that'll make ordinary cinnamon rolls a thing of the past.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat milk in a small saucepan over medium heat until it begins to bubble, about 5 minutes. Sir in salt, shortening, and 1/2 cup sugar. Let cool until lukewarm, at least 10 minutes."
    },
    {
      "position": 2,
      "text": "Dissolve yeast in a bowl of 1/4 cup warm water. Pour into the milk mixture; add flour and eggs. Mix well; cover loosely with damp cloth and let dough rise until doubled in volume, about 1 hour."
    },
    {
      "position": 3,
      "text": "Punch down dough. Cover and let rise again until doubled in volume, about 40 minutes."
    },
    {
      "position": 4,
      "text": "Place dough on a lightly floured surface. Roll into three 9x15-inch rectangles. Spread each rectangle with 2 tablespoons butter."
    },
    {
      "position": 5,
      "text": "Mix 3/4 cup brown sugar and cinnamon together in a bowl. Sprinkle mixture equally over the 3 rectangles. Roll each rectangle tightly beginning at the long side. Cut into 9 equal slices, yielding 27 rolls total."
    },
    {
      "position": 6,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Combine 1 1/2 cups brown sugar, 3/4 cup butter, pecans, and corn syrup in a bowl. Sprinkle mixture equally into 3 baking pans."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until caramel is bubbly, 5 to 10 minutes. Remove from oven and place 9 rolls in each pan. Let rise again until doubled in volume, about 40 minutes."
    },
    {
      "position": 9,
      "text": "Bake in the hot oven until golden brown, about 30 minutes. Invert rolls onto another dish or aluminum foil immediately. Serve warm."
    }
  ],
  "servings": 27,

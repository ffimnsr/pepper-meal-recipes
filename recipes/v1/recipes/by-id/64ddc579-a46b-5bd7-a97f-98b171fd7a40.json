  "id": "64ddc579-a46b-5bd7-a97f-98b171fd7a40",
  "slug": "cheesecake-cupcakes",
  "name": "Cheesecake Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These mini cheesecake cupcakes have a creamy sour cream topping\u2014add an optional spoonful of your favorite pie filling for a finishing touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line cupcake pans with 18 paper liners."
    },
    {
      "position": 2,
      "text": "Beat cream cheese and 1 cup sugar in a large bowl until well combined. Add eggs one at a time, mixing well after each addition. Stir in 1 teaspoon vanilla. Spoon batter into the prepared cupcake pans, 2/3 to 3/4 full."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes. Remove from the oven and cool for 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Whisk sour cream, remaining 1 cup sugar, and remaining 1 teaspoon vanilla in a medium bowl until smooth. Spoon into the well on the top of each cupcake."
    },
    {
      "position": 5,
      "text": "Return to the oven and bake until set, 5 to 7 more minutes. Place the pans on wire racks to cool. Do not remove cupcakes from the pans until completely cool."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

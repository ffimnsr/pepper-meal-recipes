  "id": "5b8eeb1b-1aa4-5d41-8771-3550d0dd4434",
  "slug": "cranberry-and-cilantro-quinoa-salad",
  "name": "Cranberry and Cilantro Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "Quinoa is tossed with toasted almonds, dried cranberries, bell peppers, curry powder, and cilantro in this cranberry and cilantro quinoa salad recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil, covered, in a saucepan over high heat; add quinoa. Reduce heat to low; simmer quinoa, covered, until water has been absorbed, 15 to 20 minutes. Transfer to a bowl; refrigerate until cold."
    },
    {
      "position": 2,
      "text": "Stir in red onion, carrots, cranberries, red bell pepper, yellow bell pepper, cilantro, almonds, lime juice, and curry powder; season with salt and black pepper. Chill before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "882cd7e0-a63c-5dc4-a588-696f597e6333",
  "slug": "honey-citrus-turkey-brine",
  "name": "Honey Citrus Turkey Brine",
  "recipe_type": null,
  "brief_description": "Honey, oranges, lemons, and red pepper flakes make this a nicely spiced and refreshing brine for your next turkey dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place orange juice, water, honey, brown sugar, lemon, oranges, black pepper, red pepper flakes, garlic, and bay leaf in a large pot; bring to a boil. Cook and stir until sugar is dissolved, 10 minutes. Remove from heat and gradually stir in ice to start chilling the brine."
    },
    {
      "position": 2,
      "text": "Pour brine into a large bucket; add more ice to finish cooling."
    }
  ],
  "servings": 20,

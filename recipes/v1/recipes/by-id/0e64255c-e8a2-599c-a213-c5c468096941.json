  "id": "0e64255c-e8a2-599c-a213-c5c468096941",
  "slug": "gingerbread-i",
  "name": "Gingerbread I",
  "recipe_type": "dessert",
  "brief_description": "Gingerbread is an old-fashioned, warm, and spicy treat you can make easily at home with this recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees (175 degrees C). Grease and lightly flour one 8 inch square baking pan."
    },
    {
      "position": 2,
      "text": "Cream shortening and sugar until light. Add the egg and molasses and beat thoroughly."
    },
    {
      "position": 3,
      "text": "Sift together the flour, salt, baking soda, ground ginger, and ground cinnamon."
    },
    {
      "position": 4,
      "text": "Bring water to a boil and add alternately with flour mixture to the creamed mixture, beating well after each addition. Pour batter into prepared pan."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes. Serve warm and enjoy."
    }
  ],
  "servings": 12,

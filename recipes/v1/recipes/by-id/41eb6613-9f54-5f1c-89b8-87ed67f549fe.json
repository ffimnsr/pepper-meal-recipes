  "schema_version": 1,
  "id": "41eb6613-9f54-5f1c-89b8-87ed67f549fe",
  "slug": "fresh-strawberry-lemon-shortcake",
  "name": "Fresh Strawberry Lemon Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This fresh strawberry lemon shortcake recipe features lemon-enhanced shortcakes, lemony yogurt-sour cream sauce, fresh berries, and billowy whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries and 2 tablespoons sugar in a bowl; cover the bowl with plastic wrap and refrigerate until ready to use."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine flour, remaining 2 tablespoons sugar, baking powder, and salt in a bowl; cut in butter with a knife or pastry blender until mixture resembles coarse crumbs. Whisk milk, egg yolk, and \u00be teaspoon lemon zest together in a separate bowl; stir into flour mixture until a dough forms."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a lightly floured surface; knead 10 turns. Divide dough in half. Pat or roll each half into a \u00be-inch thick round; transfer to a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes. Transfer to a wire rack to cool, 15 minutes. Split shortcakes in half horizontally."
    },
    {
      "position": 6,
      "text": "Combine yogurt, sour cream, agave nectar, and remaining \u00bd teaspoon lemon zest in a bowl; set aside. Beat cream and 1 teaspoon sugar together in a separate bowl until stiff peaks form."
    },
    {
      "position": 7,
      "text": "Arrange shortcake bottoms on dessert plates; divide yogurt mixture between bottoms. Top each with \u00bc each strawberries and whipped cream. Place cake tops on whipped cream; top each with remaining \u00bc each strawberries and whipped cream."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

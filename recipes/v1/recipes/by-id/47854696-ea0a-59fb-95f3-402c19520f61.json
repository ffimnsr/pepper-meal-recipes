  "id": "47854696-ea0a-59fb-95f3-402c19520f61",
  "slug": "stick-of-butter-steak-and-rice-recipe-11768175",
  "name": "Stick of Butter Steak and Rice",
  "recipe_type": "soup",
  "brief_description": "This stick of butter steak and rice takes just minutes to put together. Cube steak bakes on a bed of buttery mushroom rice flavored with canned soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Stir together rice, onion, mushrooms, consomme, French onion soup, and water in a 9x13-inch baking dish. Top with butter and sprinkle with 3/4 cups cheese."
    },
    {
      "position": 2,
      "text": "Season steak with garlic powder, salt, and pepper and place on top of rice mixture. Top with remaining cheese. Cover with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 minutes. Uncover and continue to bake until liquid is absorbed and rice is cooked and golden brown on top, 20 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

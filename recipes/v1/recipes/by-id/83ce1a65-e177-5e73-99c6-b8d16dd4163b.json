{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "83ce1a65-e177-5e73-99c6-b8d16dd4163b",
  "slug": "chicken-rice-and-biscuit-casserole",
  "name": "Chicken, Rice, and Biscuit Casserole",
  "recipe_type": "soup",
  "brief_description": "If you love rice, cream of chicken soup, and biscuits, this is the biscuit casserole for you. Easy to make and comforting for those cool rainy days.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until the rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Pour just enough water into a large skillet to cover the bottom in a shallow layer; add chicken pieces in a single layer. Season chicken with salt and pepper. Turn heat to medium-high and cook chicken until no longer pink in the center and the juices run clear, adding water as needed to keep pan wet, 7 to 10 minutes; drain liquid."
    },
    {
      "position": 4,
      "text": "Stir cooked rice, cooked chicken, cream of chicken soup, milk, and Mexican blend cheese together in a casserole dish. Smooth the top of the mixture with the back of a spoon. Arrange biscuit dough over the rice and chicken mixture, breaking dough pieces as needed to get maximum coverage and to avoid overlap."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the biscuit topping is golden brown and the bottom layer is heated through completely, 20 to 35 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

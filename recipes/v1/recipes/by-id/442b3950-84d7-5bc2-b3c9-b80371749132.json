  "schema_version": 1,
  "id": "442b3950-84d7-5bc2-b3c9-b80371749132",
  "slug": "flan-ii",
  "name": "Easy Flan",
  "recipe_type": "dessert",
  "brief_description": "Caramelized sugar, milk and eggs\u2014a sweet and simple baked custard.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1/2 cup sugar in a heavy bottomed saucepan over medium heat until golden. Carefully pour hot sugar evenly into four 7- to 9-ounce oven-proof ramekins or custard cups, tilting cups to coat bottoms evenly."
    },
    {
      "position": 3,
      "text": "Bring milk just to boiling over medium heat in a separate saucepan. Stir hot milk, a little at a time, into beaten eggs and egg yolks, until well combined. Stir in sugar. Pour milk mixture evenly into ramekins."
    },
    {
      "position": 4,
      "text": "Line a roasting pan with a damp kitchen towel. Place ramekins on towel, inside roasting pan, and place roasting pan on oven rack. Fill roasting pan with boiling water to reach halfway up the sides of the ramekins."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven 40 minutes, until set. Let cool, invert and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

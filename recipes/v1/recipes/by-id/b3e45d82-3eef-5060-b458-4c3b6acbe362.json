  "id": "b3e45d82-3eef-5060-b458-4c3b6acbe362",
  "slug": "real-strawberry-frosting",
  "name": "Real Strawberry Frosting",
  "recipe_type": "dessert",
  "brief_description": "This strawberry frosting uses 4 simple ingredients, including fresh strawberries, for a gorgeous-colored, naturally flavored icing with no gelatin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries in a blender; pur\u00e9e until smooth."
    },
    {
      "position": 2,
      "text": "Transfer strawberry pur\u00e9e to a saucepan over medium heat; bring to a boil, stirring often, until reduced by at least half, about 20 minutes. Remove from heat and cool completely."
    },
    {
      "position": 3,
      "text": "Beat butter with an electric mixer in a bowl until light and fluffy. Beat in 1 cup confectioners' sugar until combined. Beat 2 tablespoons cooled strawberry pur\u00e9e and vanilla extract into butter mixture until just blended."
    },
    {
      "position": 4,
      "text": "Beat in 1 cup confectioners' sugar until combined, followed by 2 tablespoons strawberry pur\u00e9e. Repeat this step once more."
    },
    {
      "position": 5,
      "text": "Beat remaining 1/2 cup confectioners' sugar into mixture until just blended."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

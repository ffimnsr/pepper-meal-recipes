  "id": "4077b006-d800-5bc1-a3ed-b67d6a18ec51",
  "slug": "rich-and-creamy-beef-stroganoff",
  "name": "Rich and Creamy Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "This beef stroganoff recipe with sour cream and cream cheese is a cozy dish of tender beef and mushrooms in a thick gravy seasoned with red pepper.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef into a large bowl. Stir in red wine, salt, and black pepper. Marinate for 10 minutes, then remove beef and pat dry with a paper towel. Reserve remaining marinade."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Stir in beef; cook and stir until browned, 5 to 7 minutes. Transfer beef to a plate, then drain any remaining grease from the skillet."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter in the skillet over medium heat. Stir in onion, garlic, and a pinch of salt. Cook and stir until onion is soft and translucent, 3 to 4 minutes. Transfer onion mixture to the plate with beef; set aside."
    },
    {
      "position": 4,
      "text": "Melt 2 tablespoons butter in the skillet over medium heat. Add mushrooms; cook and stir until tender, about 10 minutes. Transfer mushrooms to a bowl; set aside."
    },
    {
      "position": 5,
      "text": "Melt 1/4 cup butter in the skillet over medium heat. Whisk in flour; cook and stir until flour no longer tastes raw, about 4 minutes. Slowly whisk in beef stock. Bring to a boil, stirring constantly, then reduce heat to medium-low."
    },
    {
      "position": 6,
      "text": "Pour in reserved marinade, Worcestershire sauce, red pepper flakes, and mustard, then add beef and onion mixture. Cover and simmer until meat is tender, about 1 hour. Season with salt and black pepper."
    },
    {
      "position": 7,
      "text": "Stir in mushrooms, cream cheese, and sour cream about 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "f0a6121d-d1b5-54ce-8548-57f9d6ae7cc2",
  "slug": "chicken-pot-pie-iii",
  "name": "Chicken Pot Pie III",
  "recipe_type": "soup",
  "brief_description": "Creamy and savory, this pie is filled with cream of chicken and cream of potato soups, along with a bit of thyme. It cooks up thick and hearty full of chicken and mixed veggies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a 9 inch pie dish with pastry."
    },
    {
      "position": 2,
      "text": "Blanch frozen mixed vegetables for 3 to 4 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Dice chicken and place in a large bowl. Add vegetables, thyme, celery soup and potato soup. Stir together."
    },
    {
      "position": 4,
      "text": "Pour filling into pastry lined pie dish. Arrange top layer of pie crust, seal and flute the edges. Cut slits in the top of the crust to allow for steam to escape."
    },
    {
      "position": 5,
      "text": "Place pie on cookie sheet. Put aluminum foil around the pie crust edges. Bake at 400 degrees F (200 degrees C) for 30 minutes. Remove foil and continue to bake for an additional 30 minutes until golden brown. Remove from oven and let stand for 5 minutes and then serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

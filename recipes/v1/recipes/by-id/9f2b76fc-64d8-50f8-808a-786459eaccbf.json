  "id": "9f2b76fc-64d8-50f8-808a-786459eaccbf",
  "slug": "lorraines-sugar-cookies-recipe-8748356",
  "name": "Lorraine\u2019s Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "Allrecipes Allstar Lorraine Rector uses both almond extract and vanilla extract for an extra flavorful cookie. She says it's this secret that makes her kids and grandkids keep coming back for more!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Cut parchment paper to fit a 13x18-inch baking sheet."
    },
    {
      "position": 2,
      "text": "Combine butter and sugar in a large bowl and cream with an electric mixer until fluffy. Beat in egg, butter vanilla emulsion, and almond extract."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, and salt in a small bowl. Gradually add flour mixture to butter mixture, 1 cup at a time, mixing after each addition. The dough will be very stiff; mix the last of the flour in by hand. Add milk, 1 teaspoon at a time, if dough is too dry or crumbly. Do not chill dough."
    },
    {
      "position": 4,
      "text": "Divide the dough into 2 balls. On a floured surface, roll out dough until 1/4 inch thick. Dip the cookie cutter in flour before each use. Cut out cookies and place the prepared baking sheet 1 inch apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cookies are lightly browned on the bottom, 8 to 11 minutes. Smaller cookies will take less time to bake. Transfer cookies to a wire rack and allow to cool completely."
    },
    {
      "position": 6,
      "text": "When cookies are cool, decorate the cookies using your favorite cookie icing."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

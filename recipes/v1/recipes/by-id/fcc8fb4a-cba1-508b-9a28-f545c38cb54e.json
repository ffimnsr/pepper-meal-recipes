  "id": "fcc8fb4a-cba1-508b-9a28-f545c38cb54e",
  "slug": "air-fryer-hot-honey-glazed-carrots-recipe-11721752",
  "name": "Air Fryer Hot Honey Glazed Carrots",
  "recipe_type": "side",
  "brief_description": "These air fryer hot honey glazed carrots are a delicious side dish, and so easy to make, with only 3 ingredients\u2014baby carrots, hot honey, and butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Spray the basket with nonstick spray."
    },
    {
      "position": 2,
      "text": "Combine butter and hot honey in a bowl; add carrots and toss to coat. Place carrots in the air fryer basket, allowing any excess sauce to drip off; set bowl with remaining sauce aside."
    },
    {
      "position": 3,
      "text": "Cook in the preheated air fryer, tossing every 7 minutes, until carrots are roasted and fork-tender, about 15 to 22 minutes. Toss cooked carrots in reserved sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

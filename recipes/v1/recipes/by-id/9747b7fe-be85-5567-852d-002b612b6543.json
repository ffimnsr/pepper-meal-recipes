  "id": "9747b7fe-be85-5567-852d-002b612b6543",
  "slug": "anns-rice-pilaf",
  "name": "Ann\u2019s Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "Golden bits of vermicelli pasta add a toasted flavor to this quick pilaf. Use your favorite seasoning in place of Greek seasoning, if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve chicken bouillon in water in a bowl."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-high heat. Cook and stir vermicelli pieces until golden brown, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour bouillon mixture into the skillet with the vermicelli."
    },
    {
      "position": 4,
      "text": "Stir rice, black pepper, salt, and Greek seasoning into the vermicelli mixture and bring to a boil. Cover and reduce heat to low; simmer until rice is tender and liquid is absorbed, 20 to 25 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

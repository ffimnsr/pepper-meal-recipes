  "slug": "easy-white-albacore-ceviche",
  "name": "Easy White Albacore Ceviche",
  "recipe_type": "salad",
  "brief_description": "This ceviche is very easy to put together, using white albacore really makes the difference, fresh taste and a firm texture come together to prepare a delicious meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place tuna in a mixing bowl. Add the lemon juice, salt and pepper. Let sit for 10 minutes to blend flavors. Add chopped tomatoes, cilantro, and purple onion to the bowl. Combine well; season to taste with additional salt."
    },
    {
      "position": 2,
      "text": "Serve white albacore ceviche over the tostadas and garnish with jalapeno strips."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,

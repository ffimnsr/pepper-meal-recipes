  "id": "7a3ddf6d-5c7b-5676-84fe-45dfaa48c674",
  "slug": "tortellini-primavera",
  "name": "Tortellini Primavera",
  "recipe_type": "salad",
  "brief_description": "This tortellini primavera is packed with delicious flavors and is the perfect pasta salad for picnics and potlucks.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook tortellini in boiling water until tender yet firm to the bite and filling is warmed through, 5 to 7 minutes; drain."
    },
    {
      "position": 2,
      "text": "Combine cooked tortellini, tomatoes, broccoli, yellow bell pepper, Parmesan cheese, and pepperoni in a large serving bowl. Pour in 1 cup Italian dressing and toss to coat. Cover the bowl and refrigerate for at least 4 hours. If salad looks dry, stir in remaining 1/4 cup Italian dressing before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,

  "id": "bc334d95-5e36-564a-b4a0-01d7a562f306",
  "slug": "shrimp-scampi-with-rice",
  "name": "Shrimp Scampi with Rice",
  "recipe_type": "main",
  "brief_description": "Shrimp scampi in a yummy sauce with garlic, butter, white wine, and lemon served over rice is a quick and easy dinner any day of the week.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine olive oil and butter in a large, nonstick skillet and melt butter over medium heat. Add shallots and cook until softened, 2 to 3 minutes. Add garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Pour in white wine and lemon juice. Season with salt, black pepper, and red pepper flakes and mix to combine. Bring to a boil and cook for 4 minutes."
    },
    {
      "position": 3,
      "text": "Add shrimp and 4 sprigs thyme, and cook until shrimp just begin to change color, 2 to 3 minutes. Remove shrimp from cooking liquid, place on a plate, and set aside."
    },
    {
      "position": 4,
      "text": "Continue boiling the liquid until reduced by half, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Return shrimp to the skillet, remove thyme sprigs, and add parsley. Cook until shrimp are bright pink on the outside and the meat is opaque, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Serve shrimp and sauce over hot, fluffy rice. Garnish each plate with fresh thyme sprigs, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

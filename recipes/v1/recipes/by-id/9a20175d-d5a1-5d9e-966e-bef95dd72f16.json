{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9a20175d-d5a1-5d9e-966e-bef95dd72f16",
  "slug": "berry-chantilly-sheet-cake-recipe-11998240",
  "name": "Berry Chantilly Sheet Cake",
  "recipe_type": "dessert",
  "brief_description": "This berry Chantilly sheet cake takes everything you love about the signature Whole Foods cake and turns it into an easy-to-serve sheet cake, layered with fluffy Chantilly cream and topped with four kinds of fresh berries. It\u2019s the perfect dessert for cookouts, summer gatherings, and Fourth of July celebrations\u2014and you\u2019ll understand the obsession after one bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan and line with parchment. Set aside."
    },
    {
      "position": 2,
      "text": "Add eggs and sugar to the bowl of a stand mixer fitted with whisk attachment. Whip on medium-high speed until very thick and pale, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk together cake flour and baking powder in a separate bowl."
    },
    {
      "position": 4,
      "text": "Heat milk and butter until butter has melted and milk is steaming, but not boiling; remove from heat and stir in vanilla and salt."
    },
    {
      "position": 5,
      "text": "Add half of flour mixture to eggs and sugar, and mix on lowest speed until almost combined. Beat in warm milk mixture on low speed. Beat in remaining flour mixture just until no flour streaks remain. Pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 28 to 32 minutes. Let cool."
    },
    {
      "position": 7,
      "text": "Stir strawberries, blackberries, raspberries, and blueberries together in a small bowl and set aside."
    },
    {
      "position": 8,
      "text": "For chantilly cream: beat cream cheese, mascarpone, and confectioner\u2019s sugar until creamy. Add half of heavy cream slowly with mixer running on low until incorporated, then add remaining cream. Whip on medium-high until medium peaks form, 2 to 3 minutes."
    },
    {
      "position": 9,
      "text": "Spread chantilly cream on top of cooled cake. Top with berry mixture. Best served immediately, but can be refrigerated for a few hours ahead of time."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,

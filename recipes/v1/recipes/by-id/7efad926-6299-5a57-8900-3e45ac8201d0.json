  "id": "7efad926-6299-5a57-8900-3e45ac8201d0",
  "slug": "deviled-egg-macaroni-salad-recipe-11708304",
  "name": "Deviled Egg Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "This deviled egg macaroni salad mimics everyone's favorite appetizer and picnic dish with a dressing of mashed egg yolk, mayonnaise, and mustard, in a pasta salad with plenty of chopped hard boiled egg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Add 1 tablespoon salt and pasta. Carefully add eggs and return to a boil. Cook until pasta is tender with a bite, about 9 minutes. Drain. Remove eggs and add to an ice bath. Rinse pasta with cold water and drain well. Add pasta to a large bowl."
    },
    {
      "position": 2,
      "text": "Peel eggs; separate yolks and whites. Roughly chop egg whites and add to pasta bowl. Place yolks in a medium bowl and set aside."
    },
    {
      "position": 3,
      "text": "Reserve 2 tablespoons green onions for garnish and add remaining green onions to pasta bowl. Add in celery, carrots, and pickles."
    },
    {
      "position": 4,
      "text": "Mash egg yolks in the medium bowl and add remaining salt, mayonnaise, sugar, vinegar, mustard, and pepper. Stir mixture until smooth and pour over pasta mixture. Toss until well combined. Sprinkle with reserved green onions and paprika and serve immediately, or refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

  "id": "442a456a-7587-5722-b906-c835f5bc63fd",
  "slug": "hot-chicken-salad-i",
  "name": "Easy Hot Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This tangy hot chicken salad is loaded with tender chicken, celery, and almonds, baked in a cheesy cream sauce topped with a cornflake crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine chicken, celery, almonds, mayonnaise, sour cream, American cheese, lemon juice, and onion in a bowl; transfer to the prepared baking dish. Top with crushed corn flakes."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until heated through, 45 to 60 minutes."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

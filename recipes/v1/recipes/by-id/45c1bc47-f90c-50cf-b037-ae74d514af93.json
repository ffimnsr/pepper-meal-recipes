  "id": "45c1bc47-f90c-50cf-b037-ae74d514af93",
  "slug": "simple-savory-pork-roast",
  "name": "Simple Savory Pork Roast",
  "recipe_type": "main",
  "brief_description": "This easy pork roast recipe features pork loin seasoned with a blend of rosemary, garlic, and thyme, then roasted in the oven until tender and juicy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine rosemary, garlic salt, thyme, and pepper in a large resealable plastic bag. Place pork loin in the bag, seal, and toss until thoroughly coated with spice mixture. Transfer to a medium baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cooked through, about 1 hour. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

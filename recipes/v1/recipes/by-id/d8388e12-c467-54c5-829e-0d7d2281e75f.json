  "id": "d8388e12-c467-54c5-829e-0d7d2281e75f",
  "slug": "air-fryer-parmesan-chicken-bites",
  "name": "Air Fryer Parmesan Chicken Bites",
  "recipe_type": "appetizer",
  "brief_description": "Use your air fryer to whip up these tasty Parmesan chicken bites that make a tasty appetizer or snack for after school.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine egg, whipping cream, and 1/2 of the salt in a bowl. Whisk until yellow and frothy."
    },
    {
      "position": 3,
      "text": "Mix panko, herbs. and remaining salt together in a separate shallow bowl until well combined."
    },
    {
      "position": 4,
      "text": "Dip chicken pieces first into egg mixture, followed by panko, and set in the air fryer basket."
    },
    {
      "position": 5,
      "text": "Air-fry for 13 minutes, shaking the basket every 5 minutes. Spray with cooking spray and sprinkle with Parmesan cheese. Air-fry until chicken is no longer pink in the center and the juices run clear and Parmesan is melted, about 2 more minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

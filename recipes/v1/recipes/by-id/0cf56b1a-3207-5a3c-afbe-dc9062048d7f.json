  "id": "0cf56b1a-3207-5a3c-afbe-dc9062048d7f",
  "slug": "pearl-couscous-salad",
  "name": "Pearl Couscous Salad",
  "recipe_type": "salad",
  "brief_description": "This pearl couscous recipe makes a hearty and fresh-tasting couscous salad with tomatoes, red onion, golden raisins, and a bright lemon dressing.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "To make couscous: Heat 1 tablespoon olive oil in a skillet over medium heat. Cook and stir couscous in hot oil until toasted and fragrant, 3 to 4 minutes. Pour in water and bring to a boil; cover, reduce heat to medium-low, and simmer until couscous is tender, about 10 minutes. Drain and rinse couscous under cold water in a colander, then transfer to a large serving bowl. Stir in remaining 4 tablespoons olive oil until well coated."
    },
    {
      "position": 2,
      "text": "Place lentils in a small pan and cover with water; bring to a boil. Reduce heat to medium-low and simmer until lentils are tender, 15 to 20 minutes. Drain and rinse lentils under cold water in a colander; add to couscous."
    },
    {
      "position": 3,
      "text": "To make the salad: Add tomatoes, cucumber, red bell pepper, cranberries, raisins, red onion, chives, green onion, parsley, and sumac to couscous mixture."
    },
    {
      "position": 4,
      "text": "To make the dressing: Whisk olive oil, lemon juice, honey, salt, and pepper in a small bowl until well combined."
    },
    {
      "position": 5,
      "text": "Pour dressing over salad; stir until coated. Chill in the refrigerator until flavors blend before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b4aadb12-ee97-5408-bc4d-693d29d66365",
  "slug": "orange-sherbet-salad",
  "name": "Orange Sherbet Salad",
  "recipe_type": "salad",
  "brief_description": "This orange sherbet salad made with orange gelatin, orange sherbert, and canned mandarin oranges is a lovely, light orange dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk gelatin into boiling water until dissolved; allow to cool for 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in orange sherbet until completely melted. Once gelatin begins to thicken, stir in mandarin oranges. Pour into a gelatin mold; refrigerate until set, about 6 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

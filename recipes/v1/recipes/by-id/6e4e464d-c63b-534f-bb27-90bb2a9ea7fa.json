  "schema_version": 1,
  "id": "6e4e464d-c63b-534f-bb27-90bb2a9ea7fa",
  "slug": "korean-saewoo-bokkeumbap-shrimp-fried-rice",
  "name": "Korean Saewoo Bokkeumbap (Shrimp Fried Rice)",
  "recipe_type": "main",
  "brief_description": "This Korean-style shrimp fried rice dish makes gives leftover rice a second lease on life! Top it with a perfectly fried egg and kimchi if you like.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium heat. Add carrot and bell pepper; cook and stir until slightly softened, about 5 minutes. Stir in shrimp, onion, corn, and garlic; cook and stir until shrimp turn pink and are no longer translucent, 5 more minutes. Pour off any liquid, reduce the heat to low, and let simmer."
    },
    {
      "position": 2,
      "text": "Heat remaining 1 tablespoon olive oil in a separate skillet over medium heat. Pour in beaten eggs and scramble until firm and no longer runny, 2 to 3 minutes. Gently mix scrambled eggs into shrimp and vegetables."
    },
    {
      "position": 3,
      "text": "Stir rice, oyster sauce, soy sauce, 3 teaspoons butter, and salt into shrimp mixture, tossing until thoroughly combined and rice and shrimp are coated with sauce."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 teaspoon butter in a small nonstick skillet over medium heat until melted and no longer foaming. Crack one whole egg into the skillet, cover, and cook until the bottom is slightly browned, the yolk is runny, and the top of the white is slightly firm, about 3 minutes. Transfer to a plate and repeat with remaining eggs, adding more butter as needed."
    },
    {
      "position": 5,
      "text": "Serve fried eggs on top of shrimp fried rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

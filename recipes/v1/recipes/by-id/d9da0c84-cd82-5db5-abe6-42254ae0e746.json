  "id": "d9da0c84-cd82-5db5-abe6-42254ae0e746",
  "slug": "chocolate-chip-coconut-no-bake-granola-bars",
  "name": "Chocolate Chip Coconut No-Bake Granola Bars",
  "recipe_type": "appetizer",
  "brief_description": "Chocolate chip and coconut no-bake granola bars with dates, nuts, and seeds are great on-the-go snacks and lunchbox treats for the kids.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x13-inch baking dish with waxed paper so that the paper hangs over the edges of dish."
    },
    {
      "position": 2,
      "text": "Combine dates and water in a food processor or blender; process until a paste forms, adding more water if needed to thin it."
    },
    {
      "position": 3,
      "text": "Combine oats, coconut, chocolate chips, almonds, pumpkin seeds, sunflower seeds, and cinnamon in a large bowl. Add date paste, almond butter, applesauce, and vanilla extract; mix, using your hands, until wet ingredients are fully incorporated."
    },
    {
      "position": 4,
      "text": "Press mixture into the prepared baking dish. Cover with another piece of waxed paper and press down using a can or mini roller. Freeze for 1 hour."
    },
    {
      "position": 5,
      "text": "Remove dish from freezer and lift out of dish using the edges of the waxed paper. Cut into 25 squares."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

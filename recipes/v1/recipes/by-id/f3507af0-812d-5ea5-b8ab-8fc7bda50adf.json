  "id": "f3507af0-812d-5ea5-b8ab-8fc7bda50adf",
  "slug": "orange-gingerbread-cheesecake-bars",
  "name": "Orange-Gingerbread Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "These tasty cheesecakes bars with a spicy gingerbread crust and a creamy, orange zest-flavored filling make a lovely treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with enough parchment paper to have overhang on all sides. Lightly grease parchment."
    },
    {
      "position": 2,
      "text": "Whisk together flour, ginger, cinnamon, baking soda, cloves, nutmeg, allspice, and salt for the gingerbread in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Cream brown sugar and butter in a separate bowl with an electric mixed until light and fluffy. Add egg and vanilla extract and beat until thoroughly combined. Mix in molasses."
    },
    {
      "position": 4,
      "text": "Add flour mixture to butter mixture in 3 separate additions, mixing only until just combined; dough will be fairly thick. Press 2/3 of the dough firmly and evenly into the bottom of the prepared baking pan, using floured hands to prevent sticking."
    },
    {
      "position": 5,
      "text": "Beat cream cheese, sugar, and salt for the filling in a large bowl until completely smooth and fluffy. Add eggs, 1 at a time, mixing well after each addition. Mix in vanilla extract and orange zest. Pour filling evenly over gingerbread crust and smooth with a spatula. Sprinkle remaining gingerbread dough over the filling and gently press down."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are set and the center of the cheesecake only slightly jiggles, 35 to 40 minutes. Cool completely in pan. Once cooled, remove from pan using parchment \"handles\" and slice into bars."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "hard",

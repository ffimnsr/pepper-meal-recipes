  "id": "aab93c5f-cfec-5966-8d6f-f0b4d871f4b4",
  "slug": "chocolate-chip-cookie-dough-truffles",
  "name": "Chocolate Chip Cookie Dough Truffles",
  "recipe_type": "dessert",
  "brief_description": "Cookie dough truffles coated in chocolate are a decadent treat to make during the holiday season and are quick and easy to prepare.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese, brown sugar, and vanilla extract together in a bowl until smooth; add flour and mix until incorporated. Sprinkle salt over dough and fold in chocolate chips. Form dough into 1- to 2-inch balls and arrange on a baking sheet. Freeze until set, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Melt confectioners' chocolate in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching. Dip cookie balls into chocolate and place on a sheet of aluminum foil or waxed paper until hardened, at least 20 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "schema_version": 1,
  "id": "afcb54c7-9579-52d6-aaf9-6da87d313aab",
  "slug": "poblano-and-ground-pork-tacos",
  "name": "Phenomenal Pork Tacos",
  "recipe_type": "main",
  "brief_description": "These pork tacos are easy to make with ground pork, Mexican seasoning, and charred poblano pepper, served in soft tortillas for a delicious taco treat!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mince a few slices of onion to get 1 tablespoon. Add minced onion, tomato, kiwi, juice from 2 lime wedges, 3/4 of the cilantro, salt, and pepper to a small bowl. Mix into a salsa."
    },
    {
      "position": 2,
      "text": "Juice 1/4 of the lime into another small bowl; mix in sour cream to make the crema."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large pan over medium-high heat. Add sliced onion and poblano pepper. Cook, tossing occasionally, until softened and lightly charred, 3 to 4 minutes. Add pork and Mexican seasoning. Cook until pork is browned throughout, 4 to 5 minutes. Reduce heat to medium-low. Add chicken stock, tomato paste, salt, and pepper. Cook and stir until everything is coated, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Wrap tortillas in a damp cloth and microwave for 30 seconds. Divide tortillas over plates; spread lime crema on top. Top tortillas with pork mixture and salsa. Garnish with remaining cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

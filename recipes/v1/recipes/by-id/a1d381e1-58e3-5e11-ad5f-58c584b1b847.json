  "id": "a1d381e1-58e3-5e11-ad5f-58c584b1b847",
  "slug": "instant-pot-cabbage-roll-casserole",
  "name": "Instant Pot Cabbage Roll Casserole",
  "recipe_type": "main",
  "brief_description": "This Instant Pot cabbage roll casserole recipe offers elements of traditional cabbage rolls like tomato sauce and rice, but uses ground turkey not beef.",
  "cuisine": "Eastern European Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add turkey and onion; cook and stir until turkey is brown and crumbly and onion is translucent, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Add cabbage, diced tomatoes, chicken broth, water, rice, Worcestershire sauce, 1 teaspoon basil, salt, and black pepper; make sure mixture does not exceed maximum fill line. Stir occasionally until mixture starts to boil, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions. Set timer for 5 minutes, allowing pressure to build, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method, about 8 minutes. Then use the quick-release method to release remaining pressure in short bursts according to manufacturer's instructions."
    },
    {
      "position": 6,
      "text": "Unlock and remove the lid; stir in 1 cup Cheddar cheese."
    },
    {
      "position": 7,
      "text": "Combine tomato sauce, sugar, and remaining \u00bd teaspoon basil in a bowl; pour \u00bd sauce into a 9x13-inch baking dish. Spoon cabbage-rice mixture over sauce; spoon remaining \u00bd sauce over top. Sprinkle with remaining 1 cup Cheddar cheese."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until heated through, 25 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a683ba19-a861-5ca7-9c3d-2ee3eefc031d",
  "slug": "cranberry-sauce-with-apples",
  "name": "Cranberry Sauce with Apples",
  "recipe_type": "side",
  "brief_description": "Pectin from Granny Smith apples helps this cranberry sauce set and brings another layer of flavor to a classic recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cranberries, apples, water, sugar, and cinnamon in a medium saucepan over medium heat; bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce heat to low and simmer until cranberries pop and apples are soft, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Remove from the heat and cool completely. Serve, or cover and refrigerate until ready to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,

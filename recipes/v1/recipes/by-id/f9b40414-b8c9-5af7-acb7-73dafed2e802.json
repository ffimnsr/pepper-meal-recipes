  "slug": "baby-blue-punch",
  "name": "Baby Blue Punch",
  "recipe_type": "dessert",
  "brief_description": "This beautiful baby blue shower punch recipe can be made with any flavor or color of unsweetened drink mix; top with scoops of floating ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine lemon-lime soda, white cranberry juice, and drink mix in a large punch bowl until well mixed; stir in sugar until reaches desired sweetness."
    },
    {
      "position": 2,
      "text": "Float ice cream on top. The ice cream will start to melt and look like frothy white clouds floating on top."
    }
  ],

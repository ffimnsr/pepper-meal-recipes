  "id": "fdc43ccd-5d6a-585b-b494-ebc3e6d3ed0b",
  "slug": "worlds-best-guacamole",
  "name": "World's Best Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "Pomegranate seeds replace tomatoes in this guacamole recipe.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the onion with the juice of 2 limes in a small bowl; allow the onion to soak in the lime juice for 2 hours. Strain through a fine-mesh sieve and discard the lime juice. Set the onions aside."
    },
    {
      "position": 2,
      "text": "Grind the serrano chile peppers, the juice of 2 limes, and salt together in a food processor until smooth; add the avocado and continue processing until creamy and smooth. Transfer the mixture into a small serving bowl; fold the soaked onions, chopped cilantro, and about half the pomegranate seeds into the avocado mixture. Top with the remaining pomegranate seeds and garnish with the cilantro sprig to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

  "id": "c4b71538-6f81-5e4a-aafa-62e609e001df",
  "slug": "screwdriver-jello-shots-recipe-11684352",
  "name": "Screwdriver Jello Shots",
  "recipe_type": "appetizer",
  "brief_description": "These screwdriver jello shots are so fun. Orange peels are filled with fresh orange juice, vodka, and gelatin, then cut into jello shot wedges.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut oranges in half and juice them using a reamer. Use a paring knife to loosen the pith from the rind and carefully remove the insides from the orange halves; reserve the hollowed peels."
    },
    {
      "position": 2,
      "text": "Strain orange juice using a fine mesh strainer over a bowl and add a little water if needed to measure 1 1/2 cups total juice."
    },
    {
      "position": 3,
      "text": "Add orange juice to a small saucepan and stir in sugar. Bring mixture to a boil, stirring often, until sugar has dissolved."
    },
    {
      "position": 4,
      "text": "Meanwhile, in a separate bowl, whisk vodka, triple sec, and gelatin together until gelatin dissolves."
    },
    {
      "position": 5,
      "text": "Pour hot orange juice mixture into the bowl with gelatin mixture and whisk until combined."
    },
    {
      "position": 6,
      "text": "Place orange peel halves onto a plate or small rimmed baking sheet, side by side to ensure they stay upright. Secure oranges with foil or ramekins as needed to hold them upright during filling and transferring to the refrigerator."
    },
    {
      "position": 7,
      "text": "Carefully pour orange mixture into each orange peel, making sure to fill each one to the top. Place oranges into the refrigerator and chill until gelatin is firmly set, at least 3 hours."
    },
    {
      "position": 8,
      "text": "Slice oranges into wedges and serve. Keep chilled until ready to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "9553af2e-53e6-5edc-9bba-2e5aca15a91b",
  "slug": "cranberry-salad-ii",
  "name": "Cranberry Salad",
  "recipe_type": "salad",
  "brief_description": "This cranberry salad combines fresh cranberries, orange, pineapple, and walnuts in a gelatin base for a sweet and tangy holiday favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cranberries, orange (including rind), and sugar in a food processor. Pulse together until cranberries and orange are coarsely chopped and well combined with sugar."
    },
    {
      "position": 3,
      "text": "Transfer to a bowl. Stir in celery, walnuts, and pineapple until thoroughly mixed."
    },
    {
      "position": 4,
      "text": "Place gelatin in a bowl and pour hot water over top; whisk immediately to dissolve completely."
    },
    {
      "position": 5,
      "text": "Pour gelatin over the cranberry mixture. Stir to combine."
    },
    {
      "position": 6,
      "text": "Pour into the mold of your choice and chill until you are ready to serve."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 7,

  "id": "acd8bd39-ece0-5eaa-8ee8-e9d8cfbec53a",
  "slug": "minute-breakfast-burrito",
  "name": "Minute Breakfast Burrito",
  "recipe_type": "breakfast",
  "brief_description": "Fill a tortilla with microwaved scrambled egg, salsa, and a slice of American cheese for a fast and filling DIY breakfast for the road.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Spray a cereal bowl with nonstick cooking spray. Crack the eggs into the bowl, add the salsa, and stir."
    },
    {
      "position": 3,
      "text": "Microwave on high for 1 minute, stir, and cook for another minute or until the mixture firms up."
    },
    {
      "position": 4,
      "text": "Place cheese in center of tortilla and top with egg mixture."
    },
    {
      "position": 5,
      "text": "Wrap it all up like a burrito and head for the car!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 2,

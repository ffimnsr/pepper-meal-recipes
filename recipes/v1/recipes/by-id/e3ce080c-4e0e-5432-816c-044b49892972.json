{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e3ce080c-4e0e-5432-816c-044b49892972",
  "slug": "dill-pickle-meatballs-recipe-8648374",
  "name": "Dill Pickle Meatballs",
  "recipe_type": "side",
  "brief_description": "With this dill pickle meatball recipe, we brought the briny, savory, herbaceous flavors you know and love to tender beef meatballs. Paired with a creamy yogurt sauce, this dish brings brand-new flavors and textures to the table. Here's how to make dill pickle meatballs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Generously spray a large rimmed baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Add beef, cracker crumbs, onion, egg, garlic powder, black pepper, 1/2 cup feta, chopped dill pickles, 4 tablespoons pickle juice, 1/2 cup herbs, and 1 teaspoon salt to a large bowl; stir gently using a fork or clean hands until just combined, being sure not to overwork meat. Cover and chill in the refrigerator for at least 15 minutes or up to 12 hours. The meatballs are easiest to form when cold."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) with rack in top third position."
    },
    {
      "position": 4,
      "text": "Roll beef mixture into 24 (about 1 1/4 ounce; 1 tablespoon plus 2 teaspoons) meatballs. Arrange meatballs on the prepared baking sheet evenly spaced apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Increase oven temperature to broil, do not remove meatballs from oven. Broil until tops are browned and meatballs are cooked through, about 6 minutes."
    },
    {
      "position": 6,
      "text": "While meatballs bake, whisk together yogurt, remaining 1 tablespoon pickle juice, remaining 1/4 cup herbs, and remaining 1/4 teaspoon salt in a small bowl until combined."
    },
    {
      "position": 7,
      "text": "Divide buttered rice among 4 plates. Top evenly with meatballs and remaining 1/2 cup feta cheese. Serve with yogurt sauce and garnish with pepper and herbs."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

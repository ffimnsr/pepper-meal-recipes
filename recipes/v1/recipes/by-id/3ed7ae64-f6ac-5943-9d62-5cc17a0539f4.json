  "id": "3ed7ae64-f6ac-5943-9d62-5cc17a0539f4",
  "slug": "lumpia-shanghai-version",
  "name": "Lumpia (Shanghai Version)",
  "recipe_type": "appetizer",
  "brief_description": "Lumpia Shanghai are Filipino spring rolls that have a meatier filling compared to other lumpia. Serve these crispy savory treats with a dipping sauce.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground pork, ground beef, onion, and carrot in a large bowl; mix well with hands. Gradually blend in soy sauce, salt, garlic powder, and pepper until incorporated."
    },
    {
      "position": 2,
      "text": "Working one at a time, lay a wrapper on a flat surface with a corner pointing at you. Place about 2 tablespoons filling in a line, no thicker than your thumb, across the center of the wrapper. Moisten the edges of wrapper with water. Fold the bottom edge of wrapper snugly over filling. Fold in the left and right sides of wrapper towards the center. Roll up tightly to seal in filling."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep fryer or heavy skillet to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Working in batches, fry lumpia in hot oil, turning once, until golden brown, 3 to 4 minutes. Drain on a paper towel-lined plate. Cut lumpia in half, or serve as-is with dipping sauce."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,

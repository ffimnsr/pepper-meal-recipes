  "id": "fd4dc1e5-52ae-5248-aca7-60dd727e4dfc",
  "slug": "easy-gluten-free-macaroni-and-cheese",
  "name": "Easy Gluten-Free Macaroni and Cheese",
  "recipe_type": "main",
  "brief_description": "This gluten-free mac and cheese recipe is deliciously creamy with a crunchy crumb topping; perfect for a family-pleasing meal any night of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until cooked through but firm to the bite, 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Melt 1/4 cup butter in a saucepan over medium heat. Stir salt and mustard powder into melted butter; remove from heat and set aside."
    },
    {
      "position": 4,
      "text": "Whisk milk and cornstarch together in a bowl until smooth; stir into butter mixture until well blended. Return saucepan to stove; cook milk mixture, stirring constantly, over medium heat until sauce is thickened, about 5 minutes. Remove saucepan from heat."
    },
    {
      "position": 5,
      "text": "Stir 3 cups Cheddar cheese into sauce until the heat from sauce melts cheese. Add pasta to cheese sauce and stir well; pour into the prepared baking dish."
    },
    {
      "position": 6,
      "text": "Combine remaining 1 cup Cheddar cheese, gluten-free bread crumbs, 1 teaspoon butter, and paprika in a bowl; sprinkle over pasta mixture."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until top is crunchy, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

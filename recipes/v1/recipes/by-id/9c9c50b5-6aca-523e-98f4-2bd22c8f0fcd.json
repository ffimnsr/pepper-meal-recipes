{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9c9c50b5-6aca-523e-98f4-2bd22c8f0fcd",
  "slug": "air-fryer-coconut-chicken",
  "name": "Air Fryer Coconut Chicken",
  "recipe_type": "main",
  "brief_description": "These air fryer coconut-panko crusted chicken strips are crunchy and oil-free. Chicken strips are double dipped in egg and in the coconut-panko mixture to ensure crispiness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place coconut milk, pineapple juice, brown sugar, soy sauce, Sriracha sauce, and ginger in a medium sized bowl and whisk to combine. Add chicken strips and toss to coat. Cover with plastic wrap and refrigerate 2 hours or overnight."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Whisk eggs in a bowl. Combine shredded coconut, panko, salt, and pepper in a separate bowl."
    },
    {
      "position": 4,
      "text": "Remove chicken strips from the marinade and shake off excess. Discard the remaining marinade. Dip chicken strips in beaten egg, then in coconut-panko mixture, then again in egg mixture, and again in coconut-panko mixture, double dipping and double coating each strip."
    },
    {
      "position": 5,
      "text": "Spray the air fryer basket with cooking spray."
    },
    {
      "position": 6,
      "text": "Place breaded chicken strips in the air fryer basket, making sure they are not touching; work in batches if necessary."
    },
    {
      "position": 7,
      "text": "Cook for 6 minutes, flip strips, and continue cooking until lightly browned and toasted, 4 to 6 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

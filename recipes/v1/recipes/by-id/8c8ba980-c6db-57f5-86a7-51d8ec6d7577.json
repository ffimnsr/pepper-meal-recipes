  "id": "8c8ba980-c6db-57f5-86a7-51d8ec6d7577",
  "slug": "fluffy-flapjack-pancakes",
  "name": "Fluffy Flapjack Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These flapjack pancakes are a delicious breakfast using pantry ingredients. Start your brunch with these filling, quick and easy fluffy flapjacks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together flour, sugar, baking powder, baking soda, and salt in a bowl until no lumps remain."
    },
    {
      "position": 3,
      "text": "Add milk, eggs, and oil; whisk until batter is runny and smooth."
    },
    {
      "position": 4,
      "text": "Heat a nonstick griddle over medium heat and lightly coat with cooking spray."
    },
    {
      "position": 5,
      "text": "Working in batches, ladle a generous 1/4 cup batter for each pancake onto the preheated grill and cook until bubbles appear, 3 to 4 minutes. Flip and cook, pressing middle gently with the spatula, until bottom is lightly browned, 2 to 3 minutes more. Repeat with remaining batter."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7fa167e1-ae25-53f1-860c-f99e652ff1a3",
  "slug": "loaded-potato-chip-nachos-recipe-8547930",
  "name": "Loaded Potato Chip Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Loaded potato chip nachos are like a loaded potato skin meets a nacho. With cheese, ranch seasoning, and crumbled bacon, these crispy chips are complemented by a cool, tangy, sour cream dip.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large rimmed baking sheet with parchment and spread chips out in an even layer."
    },
    {
      "position": 2,
      "text": "Add 1 tablespoon ranch seasoning to sour cream and stir well to combine; set aside."
    },
    {
      "position": 3,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble when cool enough to handle."
    },
    {
      "position": 4,
      "text": "Toss remaining ranch seasoning with shredded cheeses and sprinkle cheese mixture evenly over all the chips. Top evenly with bacon."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and chips are beginning to brown and crisp around the edges, 10 to 12 minutes. Top with green onions and hot sauce. Serve with reserved sour cream dipping sauce."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

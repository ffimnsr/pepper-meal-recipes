  "id": "dd2c25cd-071e-57ac-81a4-25cae2a2ccf9",
  "slug": "spiced-slow-cooker-applesauce",
  "name": "Slow Cooker Applesauce",
  "recipe_type": "side",
  "brief_description": "This crockpot applesauce is flavored with pumpkin pie spice for a delicious fruity side dish or topping for oatmeal. Sure to become a fall favorite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine apples and water in a slow cooker."
    },
    {
      "position": 3,
      "text": "Cook on Low for 6 to 8 hours."
    },
    {
      "position": 4,
      "text": "Stir in brown sugar and pumpkin pie spice."
    },
    {
      "position": 5,
      "text": "Continue cooking another 30 minutes."
    }
  ],
  "servings": 8,

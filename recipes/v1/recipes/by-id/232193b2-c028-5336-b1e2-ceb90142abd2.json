  "id": "232193b2-c028-5336-b1e2-ceb90142abd2",
  "slug": "updated-shepherds-pie",
  "name": "Kraft\u2019s Shepherd\u2019s Pie",
  "recipe_type": "main",
  "brief_description": "This shepherd\u2019s pie from Kraft is made with lean ground beef and has a light but flavorful layer of creamy mashed potatoes with Cheddar cheese on top.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Cook potatoes and garlic in boiling water in large saucepan 20 min. or until potatoes are tender. Meanwhile, brown meat in large nonstick skillet. Stir in flour; cook 1 min. Add mixed vegetables, broth and ketchup; cook 5 min., stirring frequently."
    },
    {
      "position": 2,
      "text": "Heat oven to 375 degrees F. Drain potatoes; return to pan. Add sour cream; mash until potatoes are smooth and mixture is well blended. Stir in 1/4 cup cheese."
    },
    {
      "position": 3,
      "text": "Spoon meat mixture into 8-inch square baking dish; cover with potatoes."
    },
    {
      "position": 4,
      "text": "BAKE 18 min. Top with remaining cheese; bake 2 min. or until melted."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

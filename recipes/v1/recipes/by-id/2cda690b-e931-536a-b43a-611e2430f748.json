  "id": "2cda690b-e931-536a-b43a-611e2430f748",
  "slug": "basic-chicken-salad",
  "name": "Best Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This classic chicken salad recipe is easy to make and perfect for using leftover shredded chicken; mayo, almonds, and celery add flavor and crunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place almonds in a skillet over medium-low heat. Cook until golden brown and toasted, shaking frequently and watching carefully, as they burn easily."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise, lemon juice, and pepper together in a medium bowl until combined."
    },
    {
      "position": 4,
      "text": "Add chicken, toasted almonds, and celery; toss until just combined."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

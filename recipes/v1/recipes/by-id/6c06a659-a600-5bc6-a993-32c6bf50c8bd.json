  "id": "6c06a659-a600-5bc6-a993-32c6bf50c8bd",
  "slug": "strawberry-tarts",
  "name": "Strawberry Tarts",
  "recipe_type": "dessert",
  "brief_description": "These sensational strawberry tarts are easy to make with mini tart shells and fresh strawberries topped with a sweet glaze. Delicious with cream!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "To make the glaze: Blend sugar, cornstarch, and salt together; stir into apple juice. Cook over medium heat, stirring constantly, until smooth and thick. Allow to cool for 10 minutes."
    },
    {
      "position": 3,
      "text": "Brush a small amount of glaze over the bottom of each pastry crust. Arrange strawberries on top of glaze, slicing if necessary to fit. Spoon remaining glaze carefully over strawberries, covering them well."
    },
    {
      "position": 4,
      "text": "Chill strawberry tarts for 2 to 4 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "3f947c29-3b63-57f6-85de-c482ce36a618",
  "slug": "chef-johns-pumpkin-pie",
  "name": "Chef John's Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "The best pumpkin pie recipe is made with a rich, custard-like filling that's easy to make with sweetened condensed milk, egg yolks, and spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk pumpkin, egg yolks, and egg together in a large bowl until smooth. Add sweetened condensed milk, cinnamon, ginger, salt, nutmeg, and Chinese 5-spice powder; whisk until thoroughly smooth and combined."
    },
    {
      "position": 3,
      "text": "Line a 9-inch pie plate with pie crust; crimp edges."
    },
    {
      "position": 4,
      "text": "Pour filling into crust; lightly tap on the counter to release air bubbles. Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 5,
      "text": "Reduce heat to 350 degrees F (175 degrees C) and bake until just set in the middle, 30 to 40 more minutes. A paring knife inserted into the filling, 1 inch from the edge, should come out clean. Allow to cool completely before slicing and serving; garnish with whipped cream and freshly grated nutmeg."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

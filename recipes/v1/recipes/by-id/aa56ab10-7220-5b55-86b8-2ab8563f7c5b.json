  "id": "aa56ab10-7220-5b55-86b8-2ab8563f7c5b",
  "slug": "rocks-t-bone-steaks",
  "name": "Rock's T-Bone Steaks",
  "recipe_type": "main",
  "brief_description": "Grill a T-bone steak with a simple blend of seasonings, including paprika, garlic, coriander, and turmeric, to make it taste fantastic and flavorful.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Stir together salt, paprika, black pepper, onion powder, garlic powder, cayenne pepper, coriander, and turmeric in a small bowl."
    },
    {
      "position": 4,
      "text": "Rub seasoning over steaks on all sides."
    },
    {
      "position": 5,
      "text": "Cook steaks on the preheated grill to the desired degree of doneness, 3 to 3 1/2 minutes per side for medium-rare. An instant-read thermometer inserted into the center of each steak should read 130 degrees F (54 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "36ee819d-080b-5feb-824c-a852df8bc9c2",
  "slug": "brys-chocolate-lamb-chili",
  "name": "Bry's Chocolate Lamb Chili",
  "recipe_type": "soup",
  "brief_description": "Chocolate and lamb in chili? Of Course!!! This is a wonderful chili recipe, concocted by my son Bryan. We use Icelandic lamb because it is really lean. Lean lamb is a must.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot, cook onions and ground lamb in olive oil over medium heat."
    },
    {
      "position": 2,
      "text": "When onions are soft and meat browned, season with red pepper flakes, basil, cumin, cinnamon, garlic, chili powder, dried oregano, cocoa powder, sugar, and bay leaf, and salt and pepper to taste. Cook for 1 or 2 minutes. Stir in tomatoes and beans. Increase heat to bring soup to a boil. Reduce heat, and simmer for 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

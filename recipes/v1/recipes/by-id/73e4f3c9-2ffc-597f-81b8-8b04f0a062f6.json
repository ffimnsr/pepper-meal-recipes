  "id": "73e4f3c9-2ffc-597f-81b8-8b04f0a062f6",
  "slug": "carrot-cake-freezer-energy-balls",
  "name": "Carrot Cake Freezer Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "These carrot cake bites are made to freeze so you can have a nutritious snack at the ready made with oats, flax meal, peanut butter, honey, walnuts, and raisins.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment paper and set aside."
    },
    {
      "position": 2,
      "text": "Combine carrots, oats, flax meal, peanut butter, honey, walnuts, raisins, vanilla, cinnamon, ginger, and salt in a bowl. Beat with a hand mixer until well combined."
    },
    {
      "position": 3,
      "text": "Roll mixture into 12 equal-sized balls and place on the baking sheet. Freeze until they hold their shape, at least 1 hour. Transfer to a freezer-safe container and store in the freezer."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

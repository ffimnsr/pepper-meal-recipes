  "id": "bd985750-b00e-59c6-84ab-29c6f5344e74",
  "slug": "simple-teriyaki-sauce",
  "name": "Simple Teriyaki Sauce",
  "recipe_type": "side",
  "brief_description": "This quick and easy homemade teriyaki sauce adds the perfect Japanese touch to meat, fish, noodle stir fries, and rice, or dipping sauce for chicken wings and dumplings.",
  "cuisine": "Asian Inspired Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine 1 cup water, soy sauce, brown sugar, honey, ginger, and garlic powder in a saucepan over medium heat. Cook until nearly heated through, about 1 minute."
    },
    {
      "position": 3,
      "text": "Mix cornstarch and 1/4 cold water together in a cup; stir until dissolved. Add to the saucepan."
    },
    {
      "position": 4,
      "text": "Cook and stir sauce until thickened, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

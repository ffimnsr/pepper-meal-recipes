  "id": "236f1848-3256-5513-8568-de0a8c94bcb2",
  "slug": "pork-chop-stir-fry-recipe-8647029",
  "name": "Pork Chop Stir-Fry",
  "recipe_type": "dessert",
  "brief_description": "This pork chop stir-fry with lots of veggies, garlic, and ginger in a homemade sweet and savory honey-soy sauce can be on the table in just 30 minutes.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a large skillet over medium-high heat. Add cauliflower and stir-fry for 2 to 3 minutes. Add carrots and stir-fry for 2 minutes. Add corn and peas; cook until veggies are crisp-tender, about 2 minutes. Remove all veggies to a bowl and keep warm."
    },
    {
      "position": 2,
      "text": "Add remaining 1 tablespoon oil to the skillet. Add pork and stir-fry for 2 minutes. Add green onions, garlic, ginger, and chili powder; fry until pork is no longer pink, about 2 to 3 minutes. Remove from the skillet and keep warm."
    },
    {
      "position": 3,
      "text": "Add 1 cup water, soy sauce, honey, and bouillon to the skillet. Stir 2 tablespoons cold water and cornstarch together in a small bowl, then gradually add to the skillet, stirring constantly; bring to a boil. Cook and stir until thickened, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Return vegetables and pork to the pan; cook until heated through. Stir in peanuts and serve over hot cooked rice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

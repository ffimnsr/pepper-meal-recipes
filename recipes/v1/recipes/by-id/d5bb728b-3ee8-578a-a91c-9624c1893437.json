  "id": "d5bb728b-3ee8-578a-a91c-9624c1893437",
  "slug": "deviled-shrimp-tostadas-recipe-7488406",
  "name": "Deviled Shrimp Tostadas",
  "recipe_type": "dessert",
  "brief_description": "This deviled shrimp tostada with avocado, jalape\u00f1o, and juicy shrimp on a crispy fried corn tortilla delivers a combo of sweet, sour, and spicy flavors.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Fry tortillas in vegetable oil in a skillet over medium heat until blistered, golden brown, and very crispy. Blot lightly on a paper towel; sprinkle with salt. Place on a wire rack to cool fully. Store in an airtight container until needed."
    },
    {
      "position": 2,
      "text": "Discard all but 1 tablespoon vegetable oil from the skillet; heat over medium-high. Add shrimp; sear on each side for 30 seconds. The shrimp should still be almost raw inside. Transfer to a plate; cool for 5 minutes."
    },
    {
      "position": 3,
      "text": "Cut shrimp into small pieces; transfer to a bowl. Stir in \u00bc cup lime juice, olive oil, ketchup, chipotle, cumin, paprika, and pinch salt; cover and refrigerate, 1 to 8 hours."
    },
    {
      "position": 4,
      "text": "Mash avocado and salt with the back of a fork until desired smoothness. Stir in juice of 1 lime, jalape\u00f1o, and 2 tablespoons cilantro; refrigerate until needed."
    },
    {
      "position": 5,
      "text": "Once shrimp chilled; stir in tomato, cucumber, \u00bc cup cilantro, and red onion. Taste; adjust seasonings as needed."
    },
    {
      "position": 6,
      "text": "Spread crispy tortillas with avocado spread; top with deviled shrimp. Drizzle with Mexican crema or thinned out sour cream."
    },
    {
      "position": 7,
      "text": "Tostadas should be eaten as soon as they are dressed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

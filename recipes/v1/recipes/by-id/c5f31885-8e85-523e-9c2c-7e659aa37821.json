  "id": "c5f31885-8e85-523e-9c2c-7e659aa37821",
  "slug": "rum-balls",
  "name": "The Best Rum Balls",
  "recipe_type": "dessert",
  "brief_description": "The best rum balls recipe uses only four ingredients: rum, vanilla wafers, chocolate, and confectioners' sugar for adult rum balls that everyone wants.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Process cookies in a food processor into fine crumbs."
    },
    {
      "position": 2,
      "text": "Heat chocolate and corn syrup together in a medium saucepan over low heat. Cook, stirring often, until chocolate is smooth, about 5 minutes. Remove from heat; stir in rum and confectioners' sugar until smooth. Fold in cookie crumbs; dough will be sticky."
    },
    {
      "position": 3,
      "text": "Refrigerate mixture until dough is firm, about 15 minutes. Cover 2 plates with waxed paper; dust with confectioners' sugar."
    },
    {
      "position": 4,
      "text": "Roll dough into 1-inch balls; place on the prepared plates. Dust with confectioners' sugar. Refrigerate until firm, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Transfer to a resealable bag with more confectioners' sugar. Seal the bag and gently shake to coat."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,

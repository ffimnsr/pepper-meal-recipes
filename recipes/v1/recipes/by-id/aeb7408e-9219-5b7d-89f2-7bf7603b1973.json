  "id": "aeb7408e-9219-5b7d-89f2-7bf7603b1973",
  "slug": "taco-beef-lettuce-cups-recipe-11735386",
  "name": "Taco Beef Lettuce Cups",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's taco beef lettuce cups give crispy taco shells the day off, and deliver the most perfectly seasoned taco beef in Bibb lettuce leaves. This very flavorful, very savory beef, lightly scattered with cheese, tomato, and green onion, can be served pre-portioned on a tray, or as a taco beef lettuce cup bar.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Add oil to a nonstick skillet, and place over high heat. Add white and light green parts of sliced green onion; reserve the darker green part for garnish. Add beef, and use a spatula to break into small crumbles, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Reduce the heat to medium-high. Add salt, black pepper, garlic powder, chili powder, cumin, oregano, tomato paste, and ketchup and cook, stirring, for about 2 minutes."
    },
    {
      "position": 3,
      "text": "Use a spatula to smooth and pat the mixture down into an even layer. Let cook without stirring for 1 to 2 minutes more, or until the pieces of meat start to form a brown crust. Give the mixture a stir and repeat the browning process once more."
    },
    {
      "position": 4,
      "text": "Add in the water, and continue to cook, stirring occasionally, until the meat mixture reaches your desired texture, 1 to 2 more minutes\u2014cook briefly for a saucier version, or longer for a dryer, stickier version. More liquid can always be added to the pan to adjust if needed."
    },
    {
      "position": 5,
      "text": "Taste for seasoning, and adjust if needed. To serve, spoon beef into lettuce cups, and garnish with grated cheese, red onion, and tomato. Finish by sprinkling with reserved dark green onion tops."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

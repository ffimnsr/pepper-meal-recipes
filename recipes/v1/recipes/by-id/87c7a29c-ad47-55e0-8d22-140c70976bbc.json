  "id": "87c7a29c-ad47-55e0-8d22-140c70976bbc",
  "slug": "cinnamon-and-lime-chicken-fajitas",
  "name": "Cinnamon and Lime Chicken Fajitas",
  "recipe_type": "main",
  "brief_description": "Potatoes and chicken breast meat flavored with warm and lively seasonings are the fixings for some seriously tasty fajitas! Complete the dish with your favorite toppings, and serve with beans and rice.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes in a shallow baking dish. Drizzle with about 1/2 the oil, and season with salt. Bake 30 to 40 minutes in the preheated oven, until tender."
    },
    {
      "position": 3,
      "text": "Meanwhile, season chicken with cinnamon, salt, and pepper. Arrange in a separate baking dish, and bake 30 minutes in the preheated oven, until no longer pink and juices run clear. Cool and shred."
    },
    {
      "position": 4,
      "text": "Heat remaining oil in a skillet over medium heat, and saute onion and garlic until tender. Mix in shredded chicken, jalapeno, and lime juice. Cook until heated through."
    },
    {
      "position": 5,
      "text": "Serve the chicken and potatoes in warmed tortillas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

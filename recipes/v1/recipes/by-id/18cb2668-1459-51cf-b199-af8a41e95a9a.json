  "schema_version": 1,
  "id": "18cb2668-1459-51cf-b199-af8a41e95a9a",
  "slug": "traditional-sauerbraten",
  "name": "Traditional Sauerbraten",
  "recipe_type": "main",
  "brief_description": "This sauerbraten is marinated for at least two days for a deeply flavorful roast both tangy and savory. It's easy to see why this is such a classic.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef rump roast, onions, vinegar, water, 1 tablespoon salt, 1 tablespoon black pepper, sugar, cloves, and bay leaves in a large pot. Cover and refrigerate for 2 to 3 days, turning meat daily. Remove meat from marinade and pat dry with paper towels, reserving marinade."
    },
    {
      "position": 2,
      "text": "Season flour to taste with salt and black pepper in a large bowl. Sprinkle flour mixture over beef."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large Dutch oven or pot over medium heat; cook beef until brown on all sides, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Pour reserved marinade over beef, cover, and reduce heat to medium-low. Simmer until beef is tender, 3 1/2 to 4 hours."
    },
    {
      "position": 5,
      "text": "Remove beef to a platter and slice."
    },
    {
      "position": 6,
      "text": "Strain solids from remaining liquid and continue cooking over medium heat. Add gingersnap cookies and simmer until gravy is thickened, about 10 minutes. Serve gravy over sliced beef."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

  "id": "f6efcf74-9813-588b-a286-d9d64295d317",
  "slug": "strawberry-yogurt-pie-ii",
  "name": "Strawberry Yogurt Pie",
  "recipe_type": "dessert",
  "brief_description": "Frozen strawberries and yogurt are blended together, and then they're combined with whipped topping and unflavored gelatin. This light and airy filling is piled into a baked crust and chilled in the fridge overnight. Serve this sweet and creamy pie with freshly whipped cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries and yogurt in a blender or food processor. Blend until strawberries are in small chunks."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together whipped topping and gelatin. Stir in strawberry mixture. Pour mixture into baked pastry shell and chill overnight."
    }
  ],

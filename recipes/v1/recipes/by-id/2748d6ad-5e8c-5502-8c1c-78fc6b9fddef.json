  "id": "2748d6ad-5e8c-5502-8c1c-78fc6b9fddef",
  "slug": "no-bake-chocolate-coconut-cookies",
  "name": "No-Bake Chocolate Coconut Cookies",
  "recipe_type": "dessert",
  "brief_description": "These no-bake chocolate coconut cookies are made with a simple chocolate syrup, oats, and flaked coconut for quick and easy chocolate treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with waxed paper."
    },
    {
      "position": 2,
      "text": "Mix oats and coconut in a large bowl until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Stir sugar, cocoa powder, milk, and butter together in a saucepan over medium heat until smooth. Bring to a boil and cook, stirring constantly, for 2 minutes. Pour over oats and coconut; mix quickly to coat."
    },
    {
      "position": 4,
      "text": "Drop tablespoonfuls onto the prepared baking sheet. Let cookies cool and harden; store in an airtight container."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

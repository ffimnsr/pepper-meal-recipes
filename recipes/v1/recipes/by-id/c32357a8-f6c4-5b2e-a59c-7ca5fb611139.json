  "id": "c32357a8-f6c4-5b2e-a59c-7ca5fb611139",
  "slug": "amazing-simple-thai-tofu",
  "name": "Amazing Simple Thai Tofu",
  "recipe_type": "main",
  "brief_description": "You'd never guess it's Tofu! Peanut and ginger flavors combine to create a wonderful Asian-flavored dish that everyone will love. Serve over white rice.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil and sesame oil in a skillet over medium-high heat. Reduce heat to medium, and cook green onions for one minute. Add tofu, and continue cooking 4 minutes more, sprinkling with soy sauce halfway through. Gently stir in the peanut butter and ginger, being careful not to break the tofu, until well incorporated."
    },
    {
      "position": 2,
      "text": "Remove from heat, and toss in coconut. Transfer to a serving dish, and sprinkle with sesame seeds."
    }
  ],
  "servings": 4,

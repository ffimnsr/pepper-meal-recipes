  "id": "a0a44f6d-100e-59bb-a6f0-dd4b11cae0c5",
  "slug": "spiced-sweet-roasted-red-pepper-hummus",
  "name": "Spiced Sweet Roasted Red Pepper Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This red pepper hummus is both spicy and sweet, and it's so easy to make \u2014 just pop everything into the food processor, pulse, and chill!",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "In an electric blender or food processor, pur\u00e9e garbanzo beans, red peppers, lemon juice, tahini, garlic, cumin, cayenne, and salt. Use long pulses to process until mixture is fairly smooth and slightly fluffy, scraping down the sides in between pulses. Transfer to a serving bowl and refrigerate for at least 1 hour or up to 3 days."
    },
    {
      "position": 2,
      "text": "Return to room temperature and sprinkle with chopped parsley before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "184e8a70-5870-5df1-b51c-0ccdea367ee0",
  "slug": "danish-almond-puff",
  "name": "Danish Almond Puff",
  "recipe_type": null,
  "brief_description": "This elegant Danish is surprisingly easy to make. Slices freeze well, too.",
  "cuisine": "Danish Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 cup of flour in a medium bowl. Mix in butter using a fork or a pastry blender. Sprinkle 2 tablespoons of water over, and stir with a fork until dough comes together. Divide into two balls. Pat dough into two long strips on an ungreased baking sheet, about 14 inches long and 3 inches wide. Set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "In a saucepan, combine 1/2 cup of butter and 1 cup of water. Bring to a rolling boil. Add 1 teaspoon of almond extract and remove from the heat. Immediately stir in 1 cup of flour until the mixture pulls away from the sides of the pan. Gradually stir in the eggs until well blended. Divide evenly, and spread over the two crusts on the baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 1 hour. Allow to cool almost to room temperature before frosting."
    },
    {
      "position": 5,
      "text": "To make the frosting, mix together the confectioners' sugar, 1 teaspoon of almond extract and a splash of milk in a small bowl until smooth. Add more milk if necessary to make a pourable glaze. Drizzle over the Danish, and decorate with candy sprinkles if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

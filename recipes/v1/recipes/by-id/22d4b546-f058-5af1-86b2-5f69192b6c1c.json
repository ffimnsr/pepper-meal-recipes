  "id": "22d4b546-f058-5af1-86b2-5f69192b6c1c",
  "slug": "santa-fe-carrot-cake",
  "name": "Santa Fe Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "Baking at high altitude is easier than ever with this classic recipe for everyone's favorite carrot cake featuring walnuts and raisins.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease two 8-inch cake pans."
    },
    {
      "position": 2,
      "text": "Mix olive oil, eggs, sugar, and vanilla extract together. Combine flour, salt, cinnamon, baking soda, baking powder, and nutmeg in a separate bowl."
    },
    {
      "position": 3,
      "text": "Stir flour mixture into oil mixture until well blended. Fold in carrots, walnuts, and raisins. Portion batter evenly between the cake pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back with lightly touched, 25 to 35 minutes. Adjust temperature if cakes are browning too quickly. Let cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Beat cream cheese and butter together just until smooth. Add confectioners' sugar; beat until smooth. Spread frosting over the cooled cakes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

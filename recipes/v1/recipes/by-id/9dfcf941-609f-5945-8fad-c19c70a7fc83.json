  "id": "9dfcf941-609f-5945-8fad-c19c70a7fc83",
  "slug": "quick-eggplant-parmesan",
  "name": "Quick Eggplant Parmesan",
  "recipe_type": "main",
  "brief_description": "This quick eggplant recipe uses the microwave and stovetop to make a simple and tasty Italian meal with jarred spaghetti sauce in just 15 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together egg and water in a small bowl. Place bread crumbs in a shallow dish."
    },
    {
      "position": 2,
      "text": "Dip eggplant slices in egg mixture, then press in bread crumbs to coat."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat. Add eggplant slices to hot oil, then reduce heat to medium. Cook until golden brown and tender, 3 to 4 minutes per side. Sprinkle mozzarella cheese over eggplant during the last minute of cooking to melt."
    },
    {
      "position": 4,
      "text": "While eggplant is cooking, combine spaghetti sauce and red pepper flakes in a microwave-safe measuring cup. Cover with plastic wrap and cook on high until heated through, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Top fried eggplant slices with sauce and Parmesan cheese to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

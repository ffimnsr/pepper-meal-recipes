  "id": "22f08a28-443a-5061-acaf-98df0a9e3957",
  "slug": "instant-pot-butternut-squash-soup",
  "name": "Instant Pot Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This Instant Pot butternut squash soup with thyme and marjoram is smooth, velvety, and quick to make in any electric pressure cooker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Heat olive oil and add onion, carrot, and celery; cook until translucent and tender, about 6 to 8 minutes. Add squash, thyme, and marjoram; cook until the squash has begun to sweat and absorb the flavors, about 5 minutes more. Pour in broth."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove lid. Adjust seasoning with salt and pepper. Blend with an immersion blender until creamy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

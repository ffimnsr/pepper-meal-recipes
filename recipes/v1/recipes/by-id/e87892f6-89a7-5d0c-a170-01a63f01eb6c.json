  "slug": "tainted-fruit-shots",
  "name": "Tainted Fruit Shots",
  "recipe_type": "drink",
  "brief_description": "This tainted Jell-O fruit vodka shot recipe is quick and easy to make with fruit-flavored gelatin for fun and colorful single-serving party cocktails.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir boiling water and gelatin together in a large bowl until gelatin dissolves; stir in chilled vodka and cold water. Pour gelatin mixture into plastic shot glasses."
    },
    {
      "position": 2,
      "text": "Chill in the refrigerator until set, about 1 hour."
    }
  ],
  "servings": 20,

  "id": "c208bfad-1900-5d01-968e-32aec847f75e",
  "slug": "slow-cooker-neiman-marcus-chicken-casserole-recipe-11887291",
  "name": "Slow Cooker Neiman Marcus Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker Neiman Marcus chicken casserole is super hearty and cozy, just like any chicken casserole should be. Almonds add that little bit of texture that many casseroles are dying for, and hot sauce brings some acidity and heat to balance the rich, creamy base.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a plate with paper towels; arrange bacon in a single layer on the plate. Cover entirely with additional paper towels and microwave on High until cooked through and crispy, 4 to 6 minutes. Chop bacon and place in a large bowl."
    },
    {
      "position": 2,
      "text": "Add shredded chicken, chicken soup, sour cream, scallions, almonds, hot sauce, and 2 cups cheese to the bowl with bacon. Stir to combine and spread mixture in an even layer in the bottom of a 6-quart slow cooker."
    },
    {
      "position": 3,
      "text": "Cover and cook until bubbly and browned around edges, about 1 hour, 40 minutes on High or 3 hours on Low."
    },
    {
      "position": 4,
      "text": "Sprinkle evenly with remaining cheese; cover and continue to cook on High until cheese has melted, 18 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, stir together crackers and butter in a bowl until evenly coated. Sprinkle evenly on top of casserole; cover and cook on High until warmed through, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Garnish with scallions and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

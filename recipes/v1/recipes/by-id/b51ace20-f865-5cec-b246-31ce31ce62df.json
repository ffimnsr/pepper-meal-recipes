  "slug": "strawberry-banana-protein-smoothie",
  "name": "Strawberry Banana Protein Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This balanced strawberry banana protein smoothie is easy to make with banana, strawberries, almonds, and protein powder; great for after a workout.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries, banana, almonds, and water into a blender; blend to combine. Add ice cubes and puree until smooth. Add protein powder and mix until evenly incorporated, about 30 seconds."
    }
  ],

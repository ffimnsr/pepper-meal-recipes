  "slug": "sensational-chicken-noodle-soup",
  "name": "Sensational Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This sensational chicken noodle soup recipe requires only six ingredients\u2014chicken broth, chicken or turkey, carrots, celery, egg noodles, and pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring broth, carrot, celery, and generous dash black pepper to a boil in a 2-quart saucepan over medium-high heat."
    },
    {
      "position": 2,
      "text": "Stir in chicken and noodles; reduce heat to medium. Cook until noodles are tender, 10 minutes, stirring occasionally."
    }
  ],
  "servings": 4,

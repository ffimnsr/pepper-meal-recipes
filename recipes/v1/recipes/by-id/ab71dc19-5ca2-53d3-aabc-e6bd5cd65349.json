  "schema_version": 1,
  "id": "ab71dc19-5ca2-53d3-aabc-e6bd5cd65349",
  "slug": "swedish-meatballs-svenska-kottbullar",
  "name": "Swedish Meatballs (Svenska Kottbullar)",
  "recipe_type": "main",
  "brief_description": "Juicy Swedish meatballs made with seasoned ground beef and pork, baked and served with a savory brown gravy sauce for a family-friendly comfort meal.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bread crumbs into a small bowl; mix in cream. Allow to stand until crumbs absorb cream, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt 1 teaspoon butter in a skillet over medium heat; cook and stir onion until light brown, about 10 minutes. Transfer onion to a mixing bowl."
    },
    {
      "position": 4,
      "text": "Mix ground beef, ground pork, egg, brown sugar, salt, black pepper, nutmeg, allspice, and ginger with onion in the mixing bowl. Lightly mix in bread crumbs and cream."
    },
    {
      "position": 5,
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat. Pinch off about 1 \u00bd tablespoons meat mixture per meatball; form into balls. Place meatballs into the skillet and cook, turning often, until browned, about 5 minutes. Insides of meatballs will still be pink."
    },
    {
      "position": 6,
      "text": "Place browned meatballs into a baking dish, pour in chicken broth, and cover with foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until meatballs are tender, about 40 minutes. Remove meatballs to a serving dish."
    },
    {
      "position": 8,
      "text": "Pour pan drippings into a saucepan over medium heat. Whisk flour into drippings until smooth."
    },
    {
      "position": 9,
      "text": "Gradually whisk in enough beef broth to total about 2 \u00bd cups liquid."
    },
    {
      "position": 10,
      "text": "Bring gravy to a simmer, whisking constantly, until thickened, about 5 minutes."
    },
    {
      "position": 11,
      "text": "Just before serving, whisk in sour cream. Season with salt and black pepper. Serve gravy with meatballs."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

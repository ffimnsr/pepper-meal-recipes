  "id": "f188fb9d-b6e9-5301-ba14-337c7020aee0",
  "slug": "air-fryer-teriyaki-pork-skewers-recipe-11943592",
  "name": "Air Fryer Teriyaki Pork Skewers",
  "recipe_type": "appetizer",
  "brief_description": "There's no need to fire up the grill for these air fryer teriyaki pork skewers, so you can enjoy them in any weather. Marinate for a couple of hours, thread onto skewers with pineapple and red onion, and air fry for just a few minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add pork pieces with 2/3 cup teriyaki sauce, salt, crushed red pepper and pineapple juice to a large zip lock bag. Seal the bag and toss to incorporate the ingredients thoroughly and refrigerate for 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "Remove pork from the bag and discard marinade. Thread pork evenly onto skewers along with pineapple chunks and red onion."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 375 degrees F (190 degrees C). Lightly coat the air fryer basket with cooking spray and cook skewers 15 minutes, flipping halfway through."
    },
    {
      "position": 4,
      "text": "Stir remaining teriyaki sauce with water in a small bowl and microwave until warm. Sprinkle skewers with green onions and serve with sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

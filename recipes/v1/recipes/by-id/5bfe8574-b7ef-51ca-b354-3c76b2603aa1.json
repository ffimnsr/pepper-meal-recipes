  "id": "5bfe8574-b7ef-51ca-b354-3c76b2603aa1",
  "slug": "clams-and-chourico",
  "name": "Clams and Chourico",
  "recipe_type": "appetizer",
  "brief_description": "These clams are steamed in dark beer with chourico sausage and red onions for a full flavored meal.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Place clams in a large pot with enough water to cover. Stir in cornmeal. Let stand for about 20 minutes. Rinse clams thoroughly before cooking."
    },
    {
      "position": 2,
      "text": "Heat the olive oil and garlic in a large pot over medium heat. When the garlic is fragrant, add the chourico, onion, and red pepper flakes. Cook for 2 or 3 minutes, then pour in about 3/4 of the beer. Let simmer for a few more minutes, then add the clam juice, tomatoes, and rinsed clams."
    },
    {
      "position": 3,
      "text": "Cover, and simmer until all clams have opened. Season with oregano, salt and pepper before serving. Drink or discard remaining beer."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

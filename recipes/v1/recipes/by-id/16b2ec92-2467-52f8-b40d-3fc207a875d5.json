  "id": "16b2ec92-2467-52f8-b40d-3fc207a875d5",
  "slug": "black-rice",
  "name": "Black Rice",
  "recipe_type": "side",
  "brief_description": "This black rice pilaf with onion and almonds is a unique, flavorful side dish that's quick and easy to make and pairs well with many main courses.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Add black rice, onion, and almonds; cook and stir until lightly toasted, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Add water and bouillon; bring to a boil."
    },
    {
      "position": 4,
      "text": "Reduce the heat to low, cover, and simmer until rice is tender and liquid is absorbed, 25 to 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

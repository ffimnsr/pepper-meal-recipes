  "id": "c9b18353-7ac5-5f6f-a9a6-9eaa63a81ef3",
  "slug": "banana-zucchini-bread",
  "name": "Banana Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "This banana zucchini bread is deliciously moist thanks to shredded zucchini and ripe bananas; sweet cranberries and walnuts add flavor and crunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch bread loaf pans."
    },
    {
      "position": 2,
      "text": "Beat eggs in a large bowl with an electric mixer until light yellow and frothy. Add white sugar, zucchini, oil, bananas, brown sugar, and vanilla; beat until well combined. Stir in flour, cinnamon, baking powder, baking soda, and salt. Fold in cranberries and nuts if using. Divide batter evenly between the prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 50 minutes. Allow to cool in the loaf pans on a wire rack before removing and serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

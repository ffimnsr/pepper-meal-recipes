  "id": "b3dce71e-e048-5bd2-9fb4-4d5ebd6a0d80",
  "slug": "gingerbread-tiramisu-recipe-11829134",
  "name": "Gingerbread Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This gingerbread tiramisu is a variation of classic tiramisu with gingerbread spices in the layers. The gingersnap sprinkles on top are the perfect topping. A perfect dessert to crown a holiday meal or served with afternoon coffee.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large saucepan with a few inches of water. Bring to a boil over medium heat. Place a bowl or a double boiler insert on top of the saucepan (it should not touch the water). Add egg yolks and sugar to the double boiler. Whisk until mixture is smooth and the sugar is dissolved, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove from the heat. Mix in molasses, cinnamon, ginger, cloves, allspice, nutmeg, salt, and vanilla."
    },
    {
      "position": 4,
      "text": "Transfer mixture to a bowl if using a double boiler insert, cover, and put into the refrigerator to cool completely, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Beat mascarpone cheese into the egg yolk mixture with an electric mixer on medium until smooth."
    },
    {
      "position": 6,
      "text": "Whip 2 cups of cream to stiff peaks with clean beaters in a separate bowl. Fold whipped cream into the mascarpone mixture. Set aside."
    },
    {
      "position": 7,
      "text": "Dunk one third (about 16) of the ladyfingers, one at a time, into the coffee and line the bottom of a 9x13-inch baking dish with them. Cut the ladyfingers, if needed, to fill the dish in an even layer. Top ladyfingers with 2 cups mascarpone mixture, spreading evenly."
    },
    {
      "position": 8,
      "text": "Repeat with another layer of soaked ladyfingers and mascarpone mixture. Top with the remaining ladyfingers for three layers of ladyfingers in total (you won\u2019t use up all the coffee)."
    },
    {
      "position": 9,
      "text": "Top ladyfingers with 2 cups mascarpone filling, leaving about 1 1/2 cups mixture remaining. Whip the remaining 1/2 cup whipped cream to stiff peaks and fold into the remaining mascarpone mixture. Spread mixture over the top and chill for at least 4 hours or overnight."
    },
    {
      "position": 10,
      "text": "Finely crush gingersnaps in a plastic bag. Transfer to a fine mesh sieve and sprinkle over tiramisu."
    }
  ],
  "servings": 12,

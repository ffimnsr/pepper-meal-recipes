  "schema_version": 1,
  "id": "d4220b25-3532-5412-b401-fa80acbccea6",
  "slug": "quick-gnocchi",
  "name": "Quick Gnocchi",
  "recipe_type": "main",
  "brief_description": "Make tender, delicious gnocchi using instant mashed potatoes to slash prep time. Blend egg, salt, pepper, flour and mashed potatoes into a dough, cut into bite -size pieces and cook in boiling water. Serve with the sauce of your choice.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potato flakes in a medium-size bowl. Pour in boiling water; stir until blended. Let cool."
    },
    {
      "position": 2,
      "text": "Stir in egg, salt, and pepper. Blend in enough flour to make a fairly stiff dough. Turn dough out on a well floured board. Knead lightly."
    },
    {
      "position": 3,
      "text": "Divide dough in half. Shape each half into a long thin roll, the thickness of a breadstick. With a knife dipped in flour, cut into bite-size pieces."
    },
    {
      "position": 4,
      "text": "Place a few gnocchi in boiling water. As the gnocchi rise to the top of the pot, remove them with a slotted spoon. Repeat until all are cooked."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

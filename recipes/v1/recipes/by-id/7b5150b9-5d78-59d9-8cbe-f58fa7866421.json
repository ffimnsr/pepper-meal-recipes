  "slug": "rush-hour-refried-beans",
  "name": "Rush Hour Refried Beans",
  "recipe_type": "side",
  "brief_description": "Quick and easy refried beans can be made in 20 minutes. Simply combine pan-fried onion and garlic with mashed pinto beans and cumin for a flavorful side dish.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat bacon grease in a skillet over medium heat. Cook and stir onion and garlic in hot bacon grease until onion is softened, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Mash pinto beans and cumin into onion mixture using a potato masher until desired consistency is reached. Cook and stir bean mixture until heated through, 3 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

  "id": "f044dffa-0bc3-55c4-bf29-b24005c742fc",
  "slug": "mini-chicken-pot-pies-recipe-11857602",
  "name": "Mini Chicken Pot Pies",
  "recipe_type": "appetizer",
  "brief_description": "These mini chicken pot pies are cleverly made using frozen mini pie shells for bottom crusts, and refrigerated pie dough, cut into circles, for top crusts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a sheet pan with parchment paper, and place individual pie shells on the sheet. Allow refrigerated pie crust to come to room temperature on the counter, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Place frozen vegetables into a microwave-safe dish, add water, cover, and microwave on High until hot, about 5 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Stir Boursin into vegetables until melted. Stir in cream, chicken, and black pepper; season with salt. Distribute mixture evenly among pie shells."
    },
    {
      "position": 5,
      "text": "Using a 3-inch round biscuit cutter, cut 8 circles from refrigerated pie crust. Place a circle on top of each pie and crimp edges together. Using a sharp knife, cut two slits in the form of an \"X\" in the center of each top crust. Stir egg and water together in a cup until well combined; brush each pie lightly with egg wash."
    },
    {
      "position": 6,
      "text": "Bake in the center of the preheated oven until lightly browned, about 20 to 25 minutes, or until lightly browned. Remove to cool on a rack before removing from tins, 5 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Remove foil tins from pies and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

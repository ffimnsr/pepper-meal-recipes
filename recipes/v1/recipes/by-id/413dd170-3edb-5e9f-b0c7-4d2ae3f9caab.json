  "id": "413dd170-3edb-5e9f-b0c7-4d2ae3f9caab",
  "slug": "marry-me-blueberry-pie",
  "name": "Marry-Me Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This marry-me blueberry pie recipe, accompanied by a homemade flaky pie crust, is so delicious it may elicit a marriage proposal to the talented baker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine self-rising flour, oil, and water in a large bowl until dough is well-mixed. Divide dough in half; roll each half into a ball. Roll out each dough ball between 2 pieces of waxed paper until flattened and about 9 inches in diameter. Peel off top piece waxed paper from 1 piece dough; flip over a pie plate and press into pie plate. Peel off remaining piece waxed paper; trim crust if needed. Set remaining dough aside."
    },
    {
      "position": 3,
      "text": "Combine blueberries, sugar, all-purpose flour, lemon juice, and salt in a medium bowl until evenly mixed; pour into crust in pie plate. Cover filling with remaining dough; crimp edges together. Arrange butter cubes on top crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is thick and crust is golden brown, about 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

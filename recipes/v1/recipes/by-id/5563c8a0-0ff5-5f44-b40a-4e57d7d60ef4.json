  "id": "5563c8a0-0ff5-5f44-b40a-4e57d7d60ef4",
  "slug": "easy-one-pan-baked-rice-krispy-treats-recipe-11802611",
  "name": "Easy One Pan Baked Rice Krispy Treats",
  "recipe_type": "dessert",
  "brief_description": "These easy one pan baked rice krispy treats skip the stovetop step. Bake until the marshmallows melt, stir together right in the pan, press to the edges and cool. If you bake this just right, you even get a little bit of golden brown marshmallow flavor - so good!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place butter pieces in bottom of the prepared dish. Add vanilla to baking dish, then add in marshmallows. Carefully pour cereal over marshmallows."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until until very lightly browned and marshmallows have melted, 13 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir mixture carefully until well combined. Press mixture into dish; let stand 1 hour to cool completely; mixture should be very well held together. Lightly grease a knife and cut into 12 or 16 squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "10e27160-8755-53a8-bcd4-3b457f732540",
  "slug": "lemon-crumb-bars-recipe-8781116",
  "name": "Lemon Crumb Bars",
  "recipe_type": "dessert",
  "brief_description": "These lemon crumb bars have a buttery shortbread crust, with a tart, tangy lemon filling, and a golden crumb topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a 9x9-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "For crust and crumb, stir together melted butter, white sugar, brown sugar, salt, and vanilla until thoroughly combined. Add in flour and baking powder and mix until mixture comes together in large clumps. Measure out a loosely-packed 1 3/4 cups crumbs and press firmly and evenly into the bottom of prepared pan. Reserve remaining crumb mixture for topping."
    },
    {
      "position": 3,
      "text": "Break an egg into a large bowl and whisk for a few seconds. Lightly brush a thin layer of egg over the crust; you will use any egg left in the filling. Place crust into the freezer for about 10 to 15 minutes while you prepare filling."
    },
    {
      "position": 4,
      "text": "For filling, to the egg you used as egg wash, add the remaining 2 eggs, 1 cup plus 2 tablespoons sugar, cornstarch, lemon zest, and pinch salt. Whisk until completely smooth and combined. Whisk in the 3 tablespoons melted butter until incorporated. Pour in lemon juice and whisk until combined."
    },
    {
      "position": 5,
      "text": "Remove crust from freezer and pour the filling evenly over the top."
    },
    {
      "position": 6,
      "text": "Bake bars in the preheated oven for 25 minutes."
    },
    {
      "position": 7,
      "text": "Remove pan from oven and sprinkle reserved crumb topping evenly over the top, breaking up any larger crumbs as needed. Return pan to the oven."
    },
    {
      "position": 8,
      "text": "Bake until crumbs just begin to turn golden, 20 to 25 minutes more. Allow bars to cool completely, about 30 minutes, before cutting and serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

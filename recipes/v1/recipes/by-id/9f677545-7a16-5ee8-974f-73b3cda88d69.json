  "slug": "the-best-avocado-toast-recipe-11699506",
  "name": "The Best Avocado Toast",
  "recipe_type": "breakfast",
  "brief_description": "This truly is the best avocado toast you'll ever have. If you like an added protein boost, top with scrambled or boiled eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Assemble the avocado toast by smashing and smearing the avocado onto the toast."
    },
    {
      "position": 2,
      "text": "Top with cottage cheese, then sprinkle with nuts/seeds, crushed red pepper flakes, salt and pepper to taste, and a drizzle of honey. Serve immediately."
    }
  ],

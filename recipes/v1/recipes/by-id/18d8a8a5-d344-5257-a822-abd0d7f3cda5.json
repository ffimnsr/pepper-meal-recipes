  "id": "18d8a8a5-d344-5257-a822-abd0d7f3cda5",
  "slug": "tofu-and-veggies-in-peanut-sauce",
  "name": "Tofu and Veggies in Peanut Sauce",
  "recipe_type": "main",
  "brief_description": "Tofu and vegetables in a peanut butter sauce is a quick and easy way to make a balanced, tasty meal. Broccoli, peppers, and more saut\u00e9ed together.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet or wok over medium-high heat. Saut\u00e9 tofu, broccoli, bell pepper, and mushrooms for 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine peanut butter, hot water, vinegar, soy sauce, molasses, and cayenne pepper in a small bowl. Pour over vegetables and tofu. Simmer until vegetables are tender-crisp, 3 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

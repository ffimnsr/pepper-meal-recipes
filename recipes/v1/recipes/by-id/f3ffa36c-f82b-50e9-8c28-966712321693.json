  "id": "f3ffa36c-f82b-50e9-8c28-966712321693",
  "slug": "thanksgiving-egg-rolls",
  "name": "Thanksgiving Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These crispy Thanksgiving egg rolls have a delicious savory filling made with leftover turkey, stuffing, mashed potatoes, cranberry sauce, and gravy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pan on the stovetop until it reaches 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir turkey and gravy together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Lay an egg roll wrapper on a clean work surface with one corner pointing up (so it forms a diamond shape). Spoon 2 tablespoons mashed potatoes, 2 tablespoons turkey mixture, 2 tablespoons stuffing, and \u00bd tablespoon cranberry sauce in a vertical line in the center of the wrapper."
    },
    {
      "position": 4,
      "text": "Dip your fingertips in a small bowl of water and moisten the edges of the wrapper. Fold the top and bottom corners over the filling, then fold in one side and roll tightly to seal. Repeat with remaining wrappers and filling."
    },
    {
      "position": 5,
      "text": "Fry egg rolls in batches in hot oil, turning often, until golden brown and heated through, 3 to 4 minutes. Transfer to a paper towel-lined plate to drain and cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

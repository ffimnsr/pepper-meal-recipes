  "id": "3ce01896-fe42-5fa7-9516-f8e4da7c43d1",
  "slug": "strawberry-pretzel-salad",
  "name": "Strawberry Pretzel Salad",
  "recipe_type": "salad",
  "brief_description": "Strawberry pretzel salad is the perfect crowd-pleasing dessert featuring a crunchy pretzel crust with a creamy filling and sweet strawberry layer on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir crushed pretzels, melted butter, and 3 tablespoons sugar together until well-combined; mix well and press mixture into the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, about 8 to 10 minutes; set aside to cool."
    },
    {
      "position": 4,
      "text": "Place cream cheese and 1 cup sugar in a large bowl. Beat with an electric mixer until smooth; fold in whipped topping. Spread mixture onto cooled crust."
    },
    {
      "position": 5,
      "text": "Dissolve gelatin in boiling water. Stir in still-frozen strawberries and allow to set for a few minutes, until the mixture \"looks like egg whites.\" Spoon and spread over cream cheese layer; refrigerate until set, at least 2 hours."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 130,
  "preparation_time_minutes": 20,

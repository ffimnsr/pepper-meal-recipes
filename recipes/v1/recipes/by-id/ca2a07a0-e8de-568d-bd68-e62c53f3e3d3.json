  "id": "ca2a07a0-e8de-568d-bd68-e62c53f3e3d3",
  "slug": "easy-one-pot-ground-turkey-pasta",
  "name": "Easy One-Pot Ground Turkey Pasta",
  "recipe_type": "soup",
  "brief_description": "This quick and easy one-pot dish for ground turkey pasta is ready to eat in less than 30 minutes. Substitute your favorite ground meat, broth, spices, and pasta shape.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a high-sided 12-inch skillet with a lid over medium heat. Add ground turkey, onion, and garlic; cook and stir until turkey browned, about 8 minutes. Season with oregano, garlic powder, and basil. Stir in rotini until well combined."
    },
    {
      "position": 2,
      "text": "Add pasta sauce and broth, making sure rotini is completely covered. Bring to a boil, then reduce heat, cover, and cook until rotini tender yet firm to the bite, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Top with Parmesan cheese to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

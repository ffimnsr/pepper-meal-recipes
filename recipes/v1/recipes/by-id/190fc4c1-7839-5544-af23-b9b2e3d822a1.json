  "id": "190fc4c1-7839-5544-af23-b9b2e3d822a1",
  "slug": "chicken-stew-with-dumplings",
  "name": "Chicken Stew with Dumplings",
  "recipe_type": "soup",
  "brief_description": "This chicken stew with dumplings is easy to make with store-bought rotisserie chicken and frozen veggies for a quick and comforting winter dinner.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "To prepare the stew: Debone rotisserie chicken; cut meat into chunks or shred. Set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a large Dutch oven over medium heat; cook and stir onion and celery in hot butter until soft, about 10 minutes. Sprinkle in flour and whisk continuously to make a thick roux, about 2 minutes. Slowly pour in broth, whisking to remove any lumps. Add potatoes, frozen vegetables, salt, black pepper, basil, and thyme. Cover and cook over medium heat until vegetables are tender, 15 to 20 minutes. Stir in chicken meat and continue to simmer."
    },
    {
      "position": 3,
      "text": "Meanwhile, make the dumplings: Combine flour, baking powder, and salt in a large bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Stir in milk and dill until dough comes together."
    },
    {
      "position": 4,
      "text": "Drop rounded tablespoonfuls of dough into simmering stew. Cook, uncovered, for 10 minutes. Cover and cook until dumplings are tender, 8 to 10 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a2d2ccaf-d3be-5129-b43e-d24efeb50592",
  "slug": "zucchini-patties",
  "name": "Zucchini Patties",
  "recipe_type": "dessert",
  "brief_description": "Crispy cheesy zucchini patties make a lovely change from potato pancakes during summer squash season. Serve with tomato sauce or sour cream on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place grated zucchini in a clean kitchen towel or paper towels and squeeze it tightly with your hands to remove excess water."
    },
    {
      "position": 2,
      "text": "Place drained zucchini in a medium bowl; add eggs, flour, Parmesan cheese, mozzarella cheese, onion, and salt and stir until well combined."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium-high heat."
    },
    {
      "position": 4,
      "text": "Scoop tablespoonfuls of zucchini mixture into hot oil and fry, working in batches, until crisp and golden brown, about 2 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

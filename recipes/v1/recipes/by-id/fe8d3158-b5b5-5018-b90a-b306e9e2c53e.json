  "id": "fe8d3158-b5b5-5018-b90a-b306e9e2c53e",
  "slug": "thai-cucumber-salad",
  "name": "Thai Cucumber Salad",
  "recipe_type": "salad",
  "brief_description": "This Thai cucumber salad with cilantro, peanuts, and a sweet and tangy rice vinegar dressing tastes just like cucumber salad from a Thai restaurant.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Toss cucumbers with salt in a colander; leave in the sink to drain for 30 minutes. Rinse with cold water, then drain and pat dry with paper towels."
    },
    {
      "position": 2,
      "text": "Whisk sugar and vinegar together in a mixing bowl until sugar has dissolved. Add cucumbers, jalape\u00f1os, and cilantro; toss to combine. Sprinkle chopped peanuts on top just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

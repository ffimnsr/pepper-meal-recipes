  "id": "32183ecb-995f-5cbf-a5a6-c38cf8c3c976",
  "slug": "chocolate-gingersnaps",
  "name": "Chocolate Gingersnaps",
  "recipe_type": "dessert",
  "brief_description": "Molasses, chocolate chips, and warm spices are a delicious match in these chocolate gingersnaps that pair perfectly with a cold glass of milk.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butter and brown sugar in a large bowl; beat together until fluffy. Beat in molasses and water."
    },
    {
      "position": 3,
      "text": "Combine flour, cocoa, baking soda, cinnamon, ginger, and nutmeg in a separate bowl. Slowly mix into the creamed butter mixture until smooth."
    },
    {
      "position": 4,
      "text": "Place 1 cup chocolate chips in a microwave-safe bowl. Melt in the microwave in 15-second intervals, stirring after each interval, 1 to 3 minutes. Add to the dough and mix well."
    },
    {
      "position": 5,
      "text": "Shape dough into 1-inch balls and roll in white sugar. Insert 1 chocolate chip into the center of each ball of dough. Make sure you can still see a bit of the chocolate chip sticking out, but not too much. Arrange on baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tops begin to crack, 10 to 12 minutes. Cool on the baking sheets for 3 minutes before moving to wire racks to finish cooling."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

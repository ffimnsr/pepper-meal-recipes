  "id": "fb0b202e-f425-534c-8f89-e0fd7f498a99",
  "slug": "apple-squares",
  "name": "Apple Squares",
  "recipe_type": "dessert",
  "brief_description": "These tasty apple bars are studded with walnuts and fresh apple chunks, dusted with a sweet cinnamon and sugar topping, and baked until golden brown.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, salt, and 1/4 teaspoon of cinnamon into a medium bowl. Stir 2 tablespoons white sugar and remaining 2 teaspoons cinnamon together in a small bowl."
    },
    {
      "position": 3,
      "text": "Mix brown sugar, 1/2 cup white sugar, and melted butter together in a large bowl with a wooden spoon until smooth. Stir in egg and vanilla. Blend in flour mixture until just combined, then stir in apple and walnuts. Spread mixture evenly into the prepared pan and sprinkle cinnamon-sugar mixture over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top springs back when lightly pressed, 25 to 30 minutes. Let cool completely in the pan before cutting into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

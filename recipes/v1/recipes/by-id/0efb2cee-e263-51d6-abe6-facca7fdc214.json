  "id": "0efb2cee-e263-51d6-abe6-facca7fdc214",
  "slug": "lunch-lady-pretzel-bars-recipe-11828094",
  "name": "Lunch Lady Pretzel Bars",
  "recipe_type": "dessert",
  "brief_description": "These no-bake lunch lady pretzel bars, reminiscent of the school cafeteria, are no-bake peanut butter bars with a smooth chocolate and peanut butter ganache layer over the top. Easy to make, they need only an hour to chill before cutting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Line a large casserole dish with aluminum foil and spray with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Place melted butter, pretzels, confectioner's sugar, and 1 cup peanut butter in a bowl. Mix together completely, then pour into prepared pan. Press evenly into the bottom of the pan."
    },
    {
      "position": 3,
      "text": "Place chocolate chips and remaining peanut butter in a microwave-safe dish. Heat on High for 30 second intervals, stirring in between, until thoroughly melted. Pour over bars and spread evenly with a spatula."
    },
    {
      "position": 4,
      "text": "Press additional pretzels on top, then place in the refrigerator to chill for at least 1 hour. Cut to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

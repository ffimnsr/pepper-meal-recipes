  "id": "2eba4f72-58c7-5e0a-b681-da28d5308f00",
  "slug": "quick-apple-cobbler",
  "name": "Quick Apple Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Apple slices are spread over a basic batter and sprinkled with cinnamon sugar in this quick and easy cobbler perfect for a weeknight dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Pour butter into 9-inch round baking pan."
    },
    {
      "position": 2,
      "text": "Mix 1 cup sugar, flour, and baking powder together in a bowl. Stir in milk. Pour batter into the baking pan."
    },
    {
      "position": 3,
      "text": "Arrange apples over the batter; sprinkle remaining 1/4 cup sugar and cinnamon on top. Pour in water."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

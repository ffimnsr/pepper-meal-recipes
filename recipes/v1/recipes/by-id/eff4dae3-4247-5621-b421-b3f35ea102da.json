  "id": "eff4dae3-4247-5621-b421-b3f35ea102da",
  "slug": "instant-pot-lebanese-lentil-soup-shorbat-adas",
  "name": "Instant Pot Lebanese Lentil Soup (Shorbat Adas)",
  "recipe_type": "soup",
  "brief_description": "This Lebanese Instant Pot red lentil soup is a beautiful sunny color thanks to red lentils, which cooks down in 10 minutes at high pressure.",
  "cuisine": "Lebanese Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Heat olive oil in the pot. Add onion, potato, carrot, tomato, celery, and garlic; cook and stir until slightly softened, 3 to 5 minutes. Sprinkle salt, cumin, cinnamon, and allspice over vegetables and stir until fragrant."
    },
    {
      "position": 3,
      "text": "Pour in broth, water, and lentils. Close and lock the lid. Select high pressure according to the manufacturer's instructions; set the timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Meanwhile, spread pita squares on a lined baking sheet. Spray with cooking spray and season with salt."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until toasted, about 8 minutes."
    },
    {
      "position": 6,
      "text": "Release pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Puree soup using an immersion blender. Stir in juice of 1 lemon."
    },
    {
      "position": 7,
      "text": "Divide soup among bowls and scatter a handful of pita chips over each. Cut second lemon into wedges and serve alongside."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

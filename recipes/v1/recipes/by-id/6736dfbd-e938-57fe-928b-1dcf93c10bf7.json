  "id": "6736dfbd-e938-57fe-928b-1dcf93c10bf7",
  "slug": "puff-pastry-waffles",
  "name": "Puff Pastry Waffles",
  "recipe_type": "dessert",
  "brief_description": "Turn puff pastry into waffles that are crispy on the outside and tender on the inside for a sweet, tasty breakfast treat or snack, ready in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a cutting board with parchment paper. Unfold puff pastry onto cutting board. Cut each sheet into 4 equal squares."
    },
    {
      "position": 2,
      "text": "Preheat a waffle iron according to manufacturer's instructions. Grease with cooking spray."
    },
    {
      "position": 3,
      "text": "Place one puff pastry square in the preheated waffle iron; cook until golden brown, 3 to 5 minutes. Repeat with remaining puff pastry squares."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "1b06159f-0379-5249-b477-e54f939dd08a",
  "slug": "baked-swamp-beans-recipe-11851134",
  "name": "Baked Swamp Beans",
  "recipe_type": "soup",
  "brief_description": "These baked swamp beans are a refreshing change from typical sweet baked beans, a little more savory with andouille sausage, seasoned turnip greens, and onion soup mix, and with a nice heat level from jalapeno and Cajun seasoning.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Coat a 9x13-inch baking dish with cooking spray; set aside. Heat oil in a large skillet over medium-high heat, and add sausage; cook, stirring often, until brown in spots, about 6 minutes. Drain and discard fat, if desired."
    },
    {
      "position": 2,
      "text": "Stir in onions, bell pepper, and jalape\u00f1o; cook, stirring often, until softened, about 5 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Whisk together ketchup, brown sugar, mustard, Worcestershire, soup and dip mix, Cajun seasoning, and vinegar in a large bowl until smooth."
    },
    {
      "position": 4,
      "text": "Add beans, turnip greens, and sausage mixture; stir to combine. Transfer to prepared baking dish"
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly, 50 minutes to 1 hour. Let stand at least 10 minutes before serving. Recipe developed by Julia Levy"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

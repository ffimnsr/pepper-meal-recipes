  "slug": "easy-cheesy-cream-of-broccoli-soup",
  "name": "Easy Cheesy Cream of Broccoli Soup",
  "recipe_type": "soup",
  "brief_description": "A simple broccoli soup recipe made with just 4 ingredients: frozen chopped broccoli, cream of mushroom soup, milk, and American cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare broccoli according to directions. Drain off excess water."
    },
    {
      "position": 2,
      "text": "Add cream of mushroom soup and milk to broccoli; stir and heat thoroughly on low."
    },
    {
      "position": 3,
      "text": "Add cheese, stirring until melted; season to taste with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

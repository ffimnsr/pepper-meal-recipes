  "id": "e21d1e96-43cf-5f94-867b-79f9438cb353",
  "slug": "sweet-dill-pickles",
  "name": "Sweet Dill Pickles",
  "recipe_type": "dessert",
  "brief_description": "For this recipe, dill pickles are macerated in sugar overnight, then marinated in a sweet vinegar brine, which makes the pickles taste like candy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain pickles; slice into \u00bc-inch pieces and place in a bowl. Stir in 2 cups sugar, cover, and set aside at room temperature for 8 hours to overnight. After soaking, keep the liquid with the pickles\u2014the sugar will draw out moisture and create a syrup that\u2019s used in the next step."
    },
    {
      "position": 2,
      "text": "Combine remaining 2 cups sugar, vinegar, water, and pickling spice in a medium saucepan; bring to a boil. Pour sweet brine over pickles; set aside at room temperature for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Meanwhile, inspect glass canning jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until pickles ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 4,
      "text": "Pack pickles in sterilized jars. Top with lids and screw rings on tightly. Store in the refrigerator. Serve chilled."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,

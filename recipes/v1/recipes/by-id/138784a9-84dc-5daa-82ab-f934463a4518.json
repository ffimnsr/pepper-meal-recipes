  "id": "138784a9-84dc-5daa-82ab-f934463a4518",
  "slug": "chocolate-fondant-a-la-maille",
  "name": "Chocolate Fondant A La Maille\u00ae",
  "recipe_type": "dessert",
  "brief_description": "These rich, chocolate mini cakes with a center of creamy honey mustard make an elegant dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix the whipping cream and Maille\u00ae Honey mustard. Pour into cube shaped silicone molds and freeze until solid. Melt chocolate and butter in double boiler. Mix egg yolks with flour and cocoa. Pour melted chocolate and butter into egg mixture and stir."
    },
    {
      "position": 2,
      "text": "Beat egg whites until bubbly, and then add sugar. Blend egg whites into chocolate mix."
    },
    {
      "position": 3,
      "text": "Line molds (3\" high, 3\" diameter) with greased wax paper. Fill with chocolate mixture. Place a frozen cube in center and cover with chocolate mix. Bake at 350 degrees for 7 minutes. Cool, remove from mold and serve."
    }
  ],
  "servings": 6,

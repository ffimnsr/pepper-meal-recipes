  "schema_version": 1,
  "id": "8787f6c2-9c6b-5094-9872-ddb0886d9862",
  "slug": "vegan-bread-machine-cinnamon-rolls",
  "name": "Vegan Bread Machine Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "A bread machine takes care of all the kneading necessary in this simple recipe for vegan cinnamon rolls.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Prepare dough: Place almond milk, melted vegan margarine, 1/2 cup sugar, salt, vanilla, and flour into a bread machine in the order listed. Start the Dough setting."
    },
    {
      "position": 2,
      "text": "Mix warm water, 1 tablespoon sugar, and yeast in a glass measuring cup."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 300 degrees F (150 degrees C) for 1 minute. Turn the oven off and immediately place the yeast mixture inside to proof for 15 minutes."
    },
    {
      "position": 4,
      "text": "Add proofed yeast mixture to the bread machine and let the cycle finish, about 1 hour 45 more minutes."
    },
    {
      "position": 5,
      "text": "Remove dough and roll into an 12x18-inch rectangle. Mix brown sugar, walnuts, and cinnamon for filling in a bowl; spread evenly over the dough. Starting at the long end of the rectangle, roll dough into a log; slice log into 1-inch wide pieces. Transfer to a greased baking pan with cut-sides up."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) for 1 minute. Turn the oven off; immediately place the rolls inside along with an uncovered bowl of boiling water. Allow rolls to proof for 1 hour."
    },
    {
      "position": 7,
      "text": "Remove rolls from the oven. Preheat to 350 degrees F (175 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake rolls in the preheated oven for 15 minutes."
    },
    {
      "position": 9,
      "text": "Meanwhile, mix powdered sugar, almond milk, and melted vegan margarine for glaze in a bowl."
    },
    {
      "position": 10,
      "text": "Remove rolls from the oven and spread glaze evenly over top."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,

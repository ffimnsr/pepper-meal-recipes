  "id": "2a7ed202-af0a-532d-a086-41b7179dff46",
  "slug": "protein-packed-vegetarian-fried-rice",
  "name": "Protein-Packed Vegetarian Fried Rice",
  "recipe_type": "main",
  "brief_description": "This tasty vegetarian fried rice is packed with vegetables and protein thanks to the addition of tofu. Top with Sriracha sauce for a kick of heat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium-high heat. Add tofu, carrots, celery, onion, and garlic; cook and stir until vegetables are just soft; 5 to 10 minutes. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Stir rice, egg, and spinach into tofu mixture until egg is no longer runny, about 5 minutes. Stir in Sriracha sauce; season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

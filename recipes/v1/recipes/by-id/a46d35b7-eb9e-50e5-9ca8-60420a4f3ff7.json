  "id": "a46d35b7-eb9e-50e5-9ca8-60420a4f3ff7",
  "slug": "balsamic-bruschetta",
  "name": "Balsamic Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Homemade bruschetta comes together in no time. Sun-ripened tomatoes, fresh basil, and high-quality balsamic vinegar are key ingredients in this summer appetizer.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Brush bread slices on both sides lightly with 1 tablespoon oil and place on large baking sheet. Toast bread until golden, about 5 to 10 minutes, turning halfway through."
    },
    {
      "position": 3,
      "text": "Meanwhile, toss together tomatoes, basil, Parmesan cheese, and garlic in a bowl."
    },
    {
      "position": 4,
      "text": "Mix in balsamic vinegar, 2 teaspoons olive oil, kosher salt, and pepper."
    },
    {
      "position": 5,
      "text": "Spoon tomato mixture onto toasted bread slices."
    },
    {
      "position": 6,
      "text": "Serve immediately and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

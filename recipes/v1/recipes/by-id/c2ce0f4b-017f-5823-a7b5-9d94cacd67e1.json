  "slug": "quick-pickled-carrots-and-radishes-recipe-8741725",
  "name": "Quick-Pickled Carrots and Radishes",
  "recipe_type": "side",
  "brief_description": "Add these pickled veggies to your party spread with cheese, charcuterie, dried fruit, crackers, and more. You can prep them up to three weeks in advance.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put vegetables in 2 (1-quart) screw-top jars (carrots in one; radishes in the other)."
    },
    {
      "position": 2,
      "text": "Combine vinegar, water, sugar, and salt in a medium saucepan; bring to a simmer over medium heat, stirring to dissolve salt and sugar. Remove from heat and pour over vegetables in the jars, pressing down to fully submerge (each jar should get about half the liquid). Screw on lids and shake to combine. Chill, covered, for at least 4 hours (and up to 3 weeks)."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

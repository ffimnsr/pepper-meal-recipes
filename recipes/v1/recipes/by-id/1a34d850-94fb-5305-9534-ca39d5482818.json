  "id": "1a34d850-94fb-5305-9534-ca39d5482818",
  "slug": "greek-ribs",
  "name": "Greek Ribs",
  "recipe_type": "drink",
  "brief_description": "Baby back ribs are marinated with olive oil, lemon juice, and oregano in these Greek-inspired ribs with just the right amount of garlic.",
  "cuisine": "Greek Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine baby back ribs, onion, olive oil, lemon juice, oregano, honey, garlic, salt, and pepper in a large resealable plastic bag. Turn to ensure ribs are well coated."
    },
    {
      "position": 2,
      "text": "Marinate in the refrigerator, turning occasionally, 4 to 8 hours."
    },
    {
      "position": 3,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil; grease with cooking spray."
    },
    {
      "position": 4,
      "text": "Arrange ribs on the prepared baking sheet, leaving space between them."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until browned, about 10 minutes. Reduce oven temperature to 300 degrees F (150 degrees C). Continue baking until ribs are tender, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

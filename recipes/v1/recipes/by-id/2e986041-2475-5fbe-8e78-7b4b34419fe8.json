  "id": "2e986041-2475-5fbe-8e78-7b4b34419fe8",
  "slug": "easy-zucchini-relish",
  "name": "Easy Zucchini Relish",
  "recipe_type": "side",
  "brief_description": "This easy zucchini relish recipe makes 14 small jelly jars, so it's great for gifting. Use it as a condiment on sandwiches and meats for extra flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss zucchini and onion with salt in a large bowl. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Rinse vegetables with cold water and drain well."
    },
    {
      "position": 3,
      "text": "Mix dry mustard, celery seed, nutmeg, and pepper together in a bowl."
    },
    {
      "position": 4,
      "text": "Combine sugar, vinegar, and bell pepper in a large pot with drained vegetables and spice mixture. Bring to a simmer over medium heat and cook until vegetables are tender, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, inspect fourteen 1/2-pint jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until relish is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 6,
      "text": "Pack vegetables into hot, sterilized jars, filling to within 1/4 inch of the top. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe the rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 7,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower the jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover the jars by at least 1 inch. Bring to a rolling boil, cover, and process for 25 minutes."
    },
    {
      "position": 8,
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 134,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 50,

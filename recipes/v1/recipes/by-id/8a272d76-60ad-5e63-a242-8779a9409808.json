  "id": "8a272d76-60ad-5e63-a242-8779a9409808",
  "slug": "simply-parmesan-chicken",
  "name": "Simply Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "These easy Parmesan chicken breasts are dipped in egg and coated with herby Parmesan bread crumbs for a simple dinner the whole family will love.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place beaten egg in a shallow bowl. Mix together bread crumbs, Parmesan cheese, and Italian seasoning in a second shallow bowl."
    },
    {
      "position": 3,
      "text": "Dip chicken breasts in egg, then press in bread crumb mixture to coat. Place coated chicken in a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 minutes. Flip chicken over and continue baking until no longer pink in the center and the juices run clear, 5 to 10 more minutes. An instant-read thermometer inserted into the center of chicken should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

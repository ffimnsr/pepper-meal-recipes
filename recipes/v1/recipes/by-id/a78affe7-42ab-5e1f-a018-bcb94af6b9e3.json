  "id": "a78affe7-42ab-5e1f-a018-bcb94af6b9e3",
  "slug": "easy-and-incredible-cinnamon-roll-bites",
  "name": "Easy and Incredible Cinnamon Roll Bites",
  "recipe_type": "dessert",
  "brief_description": "Deliciously buttery and crisp on the edges, these mini cinnamon roll bites are super soft on the inside and perfect for a weekend treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat an 8- or 9-inch square baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Cut each biscuit into quarters and place in a 1-gallon resealable bag. Add sugar and cinnamon and seal the bag. Shake the bag until biscuits are well coated, then empty the bag onto the prepared pan. Drizzle melted butter over top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 22 minutes."
    },
    {
      "position": 4,
      "text": "While the cinnamon roll bites are baking, prepare frosting. Combine powdered sugar, milk, softened butter, and vanilla in a bowl and stir until smooth."
    },
    {
      "position": 5,
      "text": "Remove cinnamon roll bites from the oven and spread frosting over top immediately."
    },
    {
      "position": 6,
      "text": "Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

  "id": "2220c31a-029e-5068-89ce-b3c61748516a",
  "slug": "sheet-pan-teriyaki-glazed-pork-tenderloin-and-potatoes-recipe-11817889",
  "name": "Sheet Pan Teriyaki Glazed Pork Tenderloin and Potatoes",
  "recipe_type": "main",
  "brief_description": "This sheet pan dinner of teriyaki glazed pork tenderloin, potatoes, and green beans is as easy as it gets. The resting time at the end is important\u2014it's what keeps the pork juicy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 450 degrees F (235 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with foil. Place tenderloins in the center of the baking sheet and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place oil, potatoes, and green beans in a large mixing bowl. Season with salt and pepper and toss to coat. Arrange vegetables around tenderloins."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Remove baking sheet from the oven and baste both tenderloins with teriyaki glaze."
    },
    {
      "position": 5,
      "text": "Place the sheet back in the oven until tenderloins are no longer pink at the center, about 15 minutes more. An instant read thermometer inserted near the center of pork should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove the baking sheet from the oven, tent pork with foil, and let rest for 10 minutes. Slice and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,

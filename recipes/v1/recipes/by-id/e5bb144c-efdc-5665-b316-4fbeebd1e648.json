  "id": "e5bb144c-efdc-5665-b316-4fbeebd1e648",
  "slug": "quick-and-easy-instant-pot-chicken-noodle-soup",
  "name": "Instant Pot Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This instant pot chicken noodle soup is easy to make with chicken breasts, egg noodles, and simple veggies for the most amazing comfort food ever!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, onion, carrots, celery, salt, garlic powder, and pepper in a multi-functional pressure cooker (such as Instant Pot). Pour chicken broth into the pot; stir well. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Select Saut\u00e9 function. Add egg noodles, and simmer until tender, about 6 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

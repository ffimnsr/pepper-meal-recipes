  "schema_version": 1,
  "id": "20715193-cbd1-5ce5-bb00-23fe1db933d8",
  "slug": "homemade-lasagna",
  "name": "Homemade Lasagna",
  "recipe_type": "main",
  "brief_description": "This mom's homemade lasagna is a family favorite. The recipe pairs a meaty, from-scratch tomato sauce with a cheesy filling and lots of mozzarella on top.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine pork and ground beef in a large, deep skillet over medium-high heat; cook and stir until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Add onion and cook until translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in crushed tomatoes, tomato sauce, 1 tablespoon fresh parsley, garlic, basil, salt, oregano, and sugar. Reduce heat to medium-low and simmer, stirring occasionally, for 30 minutes."
    },
    {
      "position": 5,
      "text": "While the sauce is simmering, bring a large pot of lightly salted water to a boil. Cook lasagna noodles in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain and set aside. While the noodles are cooking, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Mix cottage cheese, Parmesan cheese, eggs, remaining 1 tablespoon fresh parsley, salt, and pepper in a large bowl until combined."
    },
    {
      "position": 7,
      "text": "Assemble lasagna: Spread a spoon or two of sauce over the bottom of a 9x13-inch baking dish just to to coat it. Place two layers of noodles over the sauce to cover."
    },
    {
      "position": 8,
      "text": "Layer with 1/2 of the cheese mixture, 1/2 of the remaining sauce, and 1/2 of the mozzarella cheese. Repeat layers once more using the remaining noodles, cheese mixture, sauce, and mozzarella. Cover the baking dish with aluminum foil."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven for 30 to 40 minutes. Remove the foil and bake until cheese is golden brown, 5 to 10 more minutes."
    },
    {
      "position": 10,
      "text": "Remove from the oven and let stand for 10 minutes before cutting and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 85,
  "rest_time_minutes": null,

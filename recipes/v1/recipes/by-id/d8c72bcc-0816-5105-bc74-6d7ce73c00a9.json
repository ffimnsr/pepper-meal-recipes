{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d8c72bcc-0816-5105-bc74-6d7ce73c00a9",
  "slug": "caramel-apple-cinnamon-rolls-recipe-11793041",
  "name": "Caramel Apple Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "These caramel apple cinnamon rolls are fluffy cinnamon rolls amped up with a sweet apple and caramel filling. Serve them with a drizzle of warmed caramel sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together milk and water in a glass measuring cup. Microwave mixture until it reaches 105 to 115 degrees F (40 to 46 degrees C), 30 to 60 seconds."
    },
    {
      "position": 2,
      "text": "Whisk together 2 cups flour, sugar, yeast, and salt in the bowl of a stand mixer fitted with the paddle attachment. Add eggs, melted butter, and milk mixture. Beat at low speed until combined. Beat at high speed 15 seconds. Switch to dough hook attachment. Add remaining 2 cups flour, 1/2 cup at a time, mixing until a soft dough forms and begins to pull away from sides of bowl, 3 to 5 minutes\u2014dough will be sticky. Transfer dough to a lightly greased bowl, turning to coat. Chill, covered, until dough is easy to handle, at least 2 hours or up to overnight."
    },
    {
      "position": 3,
      "text": "Grease 2 (9 inch) round cake pans or 2 (8 inch) square baking pans. Stir together brown sugar and cinnamon in a small bowl; set aside. Punch down dough. Divide dough in half. Roll one portion of dough on a lightly floured surface into a 6x16-inch rectangle. If dough springs back when rolling, cover and let rest for 5 to 10 minutes, then try rolling again. Spread 1/3 cup caramel sauce over rolled-out dough portion; sprinkle with half the cinnamon-sugar and apples."
    },
    {
      "position": 4,
      "text": "Starting on a long side, roll up dough to form a log; pinch seam to seal. Slice dough log into 8 (2-inch-thick) pieces. Put rolls, cut sides down, in one of the prepared pans. Repeat with remaining dough, 1/3 cup caramel sauce, cinnamon-sugar, and apples. Let rolls rise, covered, in a warm place until nearly double in size, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake rolls in the preheated oven until golden brown, 20 to 24 minutes. Cool in pan on a wire rack for 10 minutes. Drizzle rolls with 1/2 cup caramel sauce and serve warm."
    }
  ],

  "id": "cb2fdc36-6ca4-5e6c-85f5-c588c38218cc",
  "slug": "garlic-mashed-cauliflower-recipe-8623930",
  "name": "Garlic Mashed Cauliflower",
  "recipe_type": "side",
  "brief_description": "This garlic mashed cauliflower makes an excellent stand-in for mashed potatoes. So, next time you want to sneak in a vegetable, instead of mashed potatoes, try this for your family dinner table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet, over medium heat. Add minced garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Stir in thawed, riced cauliflower, salt, pepper, and nutmeg. Add chicken broth and bring to a boil, stirring frequently."
    },
    {
      "position": 3,
      "text": "Cook, covered, about 8 minutes, then remove cover and continue cooking and stirring until most of the liquid evaporates, an additional 5 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Use an immersion blender to pur\u00e9e cauliflower until smooth. If an immersion blender is not available, spoon cauliflower into a blender to pur\u00e9e. When smooth, place in a serving bowl and garnish with snipped chives."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

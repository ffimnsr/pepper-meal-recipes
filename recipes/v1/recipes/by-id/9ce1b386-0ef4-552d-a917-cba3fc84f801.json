  "id": "9ce1b386-0ef4-552d-a917-cba3fc84f801",
  "slug": "dont-go-heatin-the-house-gluten-free-fresh-cherry-crumble",
  "name": "Don't Go Heatin' the House Gluten-Free Fresh Cherry Crumble",
  "recipe_type": "dessert",
  "brief_description": "This gluten free fresh cherry crumble recipe with vanilla powder, nutmeg, and cinnamon bakes in an air fryer for a dessert that doesn't heat up the house.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cube butter; place in the freezer until very firm, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 325 degrees F (165 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Combine cherries, 2 tablespoons sugar, and lemon juice in a large bowl until cherries are evenly coated; transfer to an air fryer-safe baking dish."
    },
    {
      "position": 4,
      "text": "Whisk flour and 6 tablespoons sugar together in a bowl until well combined; cut in chilled butter using fingers until pea-sized pieces remain. Sprinkle over cherries; press down lightly."
    },
    {
      "position": 5,
      "text": "Stir remaining 2 tablespoons sugar, vanilla powder, nutmeg, and cinnamon together in a bowl until well combined; sprinkle over cherries and flour mixture."
    },
    {
      "position": 6,
      "text": "Cook in the preheated air fryer until slightly browned; check at 25 minutes if not yet browned. Continue cooking until slightly browned, checking at 5-minute intervals. Close air fryer drawer; turn air fryer off, leaving crumble inside for 10 minutes. Transfer crumble to a cutting board; cool slightly, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

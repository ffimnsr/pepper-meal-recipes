  "id": "1a9e21e5-018b-548a-b46f-31137a240aef",
  "slug": "tteokbokki-korean-spicy-rice-cakes",
  "name": "Tteokbokki (Korean Spicy Rice Cakes)",
  "recipe_type": "dessert",
  "brief_description": "A Korean street food known for its chewy texture and spicy sauce, this tteokbokki recipe doesn't disappoint. These rice cakes are found all over Korea.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and anchovies in a saucepan; bring to a boil and cook for 10 minutes. Remove and discard anchovies; set anchovy water aside."
    },
    {
      "position": 2,
      "text": "Combine chile paste, sugar, soy sauce, and corn syrup in a bowl."
    },
    {
      "position": 3,
      "text": "Add rice cakes, onion, and chile paste mixture to anchovy water; bring to a boil and boil for 5 minutes, stirring occasionally. Add spring onion; boil 3 minutes more."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

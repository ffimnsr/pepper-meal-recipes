  "id": "af6d0ad2-8180-5add-a8c7-35378e528257",
  "slug": "ginger-fried-rice",
  "name": "Ginger Fried Rice",
  "recipe_type": "side",
  "brief_description": "A simple ginger fried rice recipe full of delicious flavor from carrots, green onions, and seasoning makes the perfect side to any Asian-inspired meal.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1/4 cup olive oil in a large skillet over medium heat. Add green onions, shredded carrots, eggs, ginger paste, minced garlic, and salt. Stir gently until eggs are cooked through, 4 to 5 minutes. Transfer to a bowl."
    },
    {
      "position": 2,
      "text": "Pour remaining 1/4 cup oil into the same skillet and add rice. Fry for 2 minutes. Add soy sauce, oyster sauce, Sriracha sauce, and sesame oil; stir to combine. Add egg mixture back into the skillet and stir gently to combine. Cook for 2 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

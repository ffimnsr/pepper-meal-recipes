  "id": "92c6d05d-0898-56b7-9227-15b83049b95b",
  "slug": "avocado-deviled-eggs",
  "name": "Avocado Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These avocado deviled eggs have a creamy filling made with hard-boiled egg yolks, avocado, mayo, lime, and crispy bacon for a delicious flavor twist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Scoop egg yolks into a bowl; add avocado, 2/3 of chopped turkey bacon, mayonnaise, lime juice, garlic, cayenne pepper, and salt. Mash egg yolk mixture until filling is evenly combined."
    },
    {
      "position": 2,
      "text": "Spoon filling into a piping bag or plastic bag with a snipped corner. Pipe filling into each egg white; top with a turkey bacon piece, jalape\u00f1o slice, and dash hot sauce."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

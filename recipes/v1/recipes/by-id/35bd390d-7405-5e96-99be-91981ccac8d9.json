  "id": "35bd390d-7405-5e96-99be-91981ccac8d9",
  "slug": "lemon-curd-bars-with-coconut",
  "name": "Lemon Curd Bars with Coconut",
  "recipe_type": "dessert",
  "brief_description": "This bar has the two crusts as requested, and has a strong tangy lemon taste, so much better than most of the lemon bar recipes out there due to the lemon curd and added coconut!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl cream the butter. Add the flour, sugar and baking soda. Mix until the mixture forms coarse crumbs"
    },
    {
      "position": 3,
      "text": "Pat 2/3 of the mixture into the bottom of one 9x13 inch baking pan. Bake at 375 degrees F (190 degrees C) for 10 minutes. Remove and let cool slightly."
    },
    {
      "position": 4,
      "text": "Spread the lemon curd over the baked layer. To the remaining 1/3 of crumb mixture add the coconut and the almonds. Sprinkle over the top of the lemon curd."
    },
    {
      "position": 5,
      "text": "Lower oven temperature to 350 degrees F (175 degrees C). Bake bars for 25 minutes or until lightly browned."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

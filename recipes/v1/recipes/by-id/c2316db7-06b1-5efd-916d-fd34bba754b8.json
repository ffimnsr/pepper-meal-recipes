  "id": "c2316db7-06b1-5efd-916d-fd34bba754b8",
  "slug": "candy-cane-cookies-i",
  "name": "Candy Cane Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cute candy cane cookies are made with red and white cookie dough twisted into a classic holiday shape, and baked for a fun festive treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat confectioners\u2019 sugar, butter, and shortening in a large bowl until creamy. Beat in egg, almond extract, and vanilla extract until smooth."
    },
    {
      "position": 3,
      "text": "Whisk flour and salt together in a separate bowl; gradually stir into the butter mixture until combined. Divide dough in half. Stir red food coloring into one half until evenly tinted."
    },
    {
      "position": 4,
      "text": "For each cookie, roll 1 teaspoon red dough and 1 teaspoon plain dough on a lightly floured surface into 4-inch strips. Place dough strips side by side, press lightly together, and twist to form a rope. Curve top of rope down to look like the handle of a candy cane. Place shaped cookie on an ungreased baking sheet. Repeat with remaining dough, forming one complete cookie at a time so the dough does not dry out."
    },
    {
      "position": 5,
      "text": "Bake cookies in the preheated oven until lightly golden, about 9 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Remove cookies from the oven and sprinkle with a mixture of crushed peppermint candies and granulated sugar, if desired. Cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

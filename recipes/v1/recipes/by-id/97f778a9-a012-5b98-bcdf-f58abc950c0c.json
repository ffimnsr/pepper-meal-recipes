  "id": "97f778a9-a012-5b98-bcdf-f58abc950c0c",
  "slug": "authentic-turkish-doner-kebab",
  "name": "Turkish Doner Kebab",
  "recipe_type": "main",
  "brief_description": "This doner kebab is made from scratch with perfectly seasoned ground lamb that's baked, then sliced and served in pita for a street food favorite.",
  "cuisine": "Turkish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, oregano, salt, garlic powder, onion powder, Italian seasoning, black pepper, and cayenne pepper in a large bowl. Add ground lamb and knead until thoroughly mixed together, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Shape seasoned lamb mixture and place into a loaf pan; set on top of a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, turning halfway to ensure even browning, for about 1 hour and 20 minutes."
    },
    {
      "position": 5,
      "text": "Wrap loaf in aluminum foil and let rest for about 10 minutes. Slice as thinly as possible to make doner kebab pieces."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

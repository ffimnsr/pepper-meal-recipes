  "id": "c8e49d5f-693e-5e21-9d28-6873efa82904",
  "slug": "honey-pumpkin-seeds",
  "name": "Honey Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This honey pumpkin seed recipe is perfect for fall. The seeds are coated in plenty of honey and baked into a sweet treat to serve after carving pumpkins.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C) with oven rack in the highest position. Line a large baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine honey, butter, brown sugar, and salt in a bowl; add pumpkin seeds and toss to coat. Spread coated seeds onto the prepared baking sheet in a single layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes; stir then continue baking 20 minutes more. Sprinkle seeds with white sugar; bake until lightly browned, about 20 minutes more. Cool. Store in an airtight container."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9604201c-fbfd-5a36-b173-63adc53bd0e4",
  "slug": "chicken-teriyaki-and-noodles",
  "name": "Chicken Teriyaki and Noodles",
  "recipe_type": null,
  "brief_description": "This quick chicken teriyaki and noodles dish is ready in 20 minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken pieces with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat sesame oil in a large skillet over medium-high heat. Add chicken pieces and cook, stirring, until chicken is browned, 3 to 5 minutes. Remove chicken to a plate and keep warm."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a pot of water to a boil over high heat. Add noodles and vegetables and cook until noodles are softened, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Combine soy sauce, mirin, sake, brown sugar, garlic, ginger, and red pepper flakes in a bowl. Stir to combine and pour sauce into the skillet. Cook stirring frequently until sauce is thickened, about 3 minutes. Add chicken back into skillet with sauce."
    },
    {
      "position": 5,
      "text": "Drain noodles and vegetables and add to skillet. Stir to combine and serve"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

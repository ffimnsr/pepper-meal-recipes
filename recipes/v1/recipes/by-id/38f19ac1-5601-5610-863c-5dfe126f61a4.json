  "id": "38f19ac1-5601-5610-863c-5dfe126f61a4",
  "slug": "dill-pickle-ranch-potato-salad-recipe-12011343",
  "name": "Dill Pickle Ranch Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This dill pickle ranch potato salad combines tender potatoes with a creamy ranch dressing made with fresh herbs and garlic. Crisp celery, red onion, and chopped dill pickles add fresh crunch and a bright, tangy finish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a single layer in a large saucepan. Add enough cold water to cover eggs by 1 inch. Bring to a rapid boil over high heat. Remove from heat, cover and let stand 15 minutes; drain. Place eggs in ice water until cool enough to handle; drain. Peel and coarsely chop."
    },
    {
      "position": 2,
      "text": "Meanwhile, place potatoes in a large saucepan with enough salted water to cover. Bring to boiling, reduce heat and simmer, covered, until just tender, about 10 minutes; drain. Spread on a baking sheet or tray and let cool slightly, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, for dressing, in a large bowl, whisk together mayonnaise, sour cream, pickle brine, dill, parsley, chives, garlic, salt and pepper."
    },
    {
      "position": 4,
      "text": "Add eggs, potatoes, celery, pickles, and onion to the bowl; toss to combine."
    },
    {
      "position": 5,
      "text": "Cover and chill 1 to 2 hours before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

  "id": "58c8f3d0-99e5-57cd-b7f9-eb79449efde7",
  "slug": "pralines",
  "name": "Pralines",
  "recipe_type": "dessert",
  "brief_description": "Pralines are sweet confections made on the stovetop with toasted pecans, butter, sugar, and milk for a creamy Southern candy that melts in your mouth.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine pecans, white sugar, brown sugar, milk, butter, and vanilla in a large saucepan over medium heat; bring to a boil. Do not stir once mixture begins to boil. Heat to 240 degrees F (115 degrees C) or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from water and placed on a flat surface."
    },
    {
      "position": 3,
      "text": "Drop by spoonfuls onto the prepared baking sheet. Let cool completely."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

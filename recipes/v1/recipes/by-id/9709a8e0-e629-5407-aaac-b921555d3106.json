  "id": "9709a8e0-e629-5407-aaac-b921555d3106",
  "slug": "spicy-quince-and-cranberry-chutney",
  "name": "Spicy Quince and Cranberry Chutney",
  "recipe_type": "side",
  "brief_description": "This is a much more lively alternative to plain cranberry sauce and is one of my very favorites. I buy the quinces (membrillos) at a local Mexican grocery store. It is so worth the extra effort!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir the sugar, cloves, allspice, cinnamon, and salt together in a large saucepan. Stir in the water, then bring to a boil over high heat, stirring until the sugar dissolves. Add the quince, and reduce heat to low. Cook and stir until the quince have turned rose colored, 4 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in the orange zest, orange juice, vinegar, and cranberries. Bring to a boil over high heat, then reduce heat to medium-low, and cook until the cranberries have burst and the chutney has thickened, about 20 minutes. Cool completely before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

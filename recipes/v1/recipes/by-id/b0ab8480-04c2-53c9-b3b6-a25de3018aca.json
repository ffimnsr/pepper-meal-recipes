  "id": "b0ab8480-04c2-53c9-b3b6-a25de3018aca",
  "slug": "artichoke-spinach-dip",
  "name": "Artichoke Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "Spinach and artichokes swim in a dish of creamy, cheesy delights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over medium heat. Stir in the spinach and artichoke hearts. Cook until tender, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Mix cream cheese and sour cream into the spinach mixture. Stir in Parmesan cheese and garlic salt. Cook, stirring occasionally, until thickened, 10 to 15 minutes. Serve warm."
    }
  ],

  "id": "a5ba9a19-8b54-51b8-bb43-ea678ebcd56e",
  "slug": "creamy-goat-cheese-and-honey",
  "name": "Creamy Goat Cheese and Honey",
  "recipe_type": "appetizer",
  "brief_description": "Creamy goat cheese is lightly dusted with pecans, honey, and rosemary. Spread it on your favorite crostini, bagel chips, or melba toasts as an appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Divide goat cheese into 12 equal portions; roll each into a ball."
    },
    {
      "position": 2,
      "text": "Combine pecans and cinnamon in a bowl. Roll cheese balls in pecan mixture until covered. Gently pat balls into patties; transfer to a serving plate."
    },
    {
      "position": 3,
      "text": "Drizzle honey over patties; sprinkle rosemary on top. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

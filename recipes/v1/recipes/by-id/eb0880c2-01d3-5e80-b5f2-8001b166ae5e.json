  "slug": "coffee-brandy-alexander-recipe-11769274",
  "name": "Coffee Brandy Alexander",
  "recipe_type": "dessert",
  "brief_description": "Wake up the standard brandy Alexander. This version adds fresh-brewed coffee and complex, bittersweet amaro\u2014and flexes as a warm or iced cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker half full with ice. Add coffee, brandy, cr\u00e8me de cacao, half-and-half, and Amaro Averna. Cover and shake until very cold."
    },
    {
      "position": 2,
      "text": "Strain into a cocktail glass. Garnish with coffee beans and/ or nutmeg."
    }
  ],

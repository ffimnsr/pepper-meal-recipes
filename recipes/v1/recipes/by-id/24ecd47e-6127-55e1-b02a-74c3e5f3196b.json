  "id": "24ecd47e-6127-55e1-b02a-74c3e5f3196b",
  "slug": "key-lime-cheesecake-i",
  "name": "Key Lime Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "A Key lime cheesecake that's sure to become a favorite to make and share. The sweet, tart, and creamy flavors all balance to make a perfect dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine graham cracker crumbs with butter. Press into the bottom and partially up the sides of a 9-inch springform pan; refrigerate while you prepare the filling."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Fill a shallow pan half full of hot water and place on the lower rack to minimize cracking."
    },
    {
      "position": 4,
      "text": "To make the filling: Beat cream cheese, sugar, lime zest, and cornstarch in a large bowl with an electric mixer until smooth and fluffy. Beat in eggs one at a time, blending just until smooth. Add Key lime juice with mixer on low."
    },
    {
      "position": 5,
      "text": "Finish mixing by hand. Do not overbeat, or the cake will crack during baking. Pour batter into the prepared crust."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 55 to 65 minutes, or until set. Turn the oven off, and let cheesecake stand in the oven for 30 minutes with the door open at least 4 inches. Remove from oven."
    },
    {
      "position": 7,
      "text": "Refrigerate cheesecake 8 hours to overnight, and up to 3 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

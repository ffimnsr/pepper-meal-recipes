  "id": "054fb454-dc25-56d0-b8f2-55d7a1bffc99",
  "slug": "instant-pot-asian-style-shrimp-scampi",
  "name": "Instant Pot Asian-Style Shrimp Scampi",
  "recipe_type": "main",
  "brief_description": "This Asian-inspired twist on shrimp scampi is prepped in an Instant Pot in under 30 minutes from start to finish.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Melt butter in the pot. Add shallot and saute for 1 minute. Add garlic and ginger to the pot and saute for 1 minute more."
    },
    {
      "position": 2,
      "text": "Pour in sherry and scrape the bottom of the pot to loosen any browned bits. Allow sherry to cook for 3 minutes, then push Cancel. Stir in the chicken broth, soy sauce, and pepper. Add shrimp to the pot."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 1 minute. Allow 5 to 10 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Stir in 2 tablespoons green onions and sesame oil. Garnish with sesame seeds and remaining green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

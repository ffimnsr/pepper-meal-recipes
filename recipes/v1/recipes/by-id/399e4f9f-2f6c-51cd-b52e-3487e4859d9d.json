  "id": "399e4f9f-2f6c-51cd-b52e-3487e4859d9d",
  "slug": "german-potato-pancakes",
  "name": "German Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This German potato pancake recipe pan-fries shredded potatoes and onion until golden and crispy for a savory twist on regular pancakes.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs, flour, baking powder, salt, and pepper together in a large bowl; stir in shredded potatoes and onion."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Drop heaping tablespoonfuls of potato mixture into hot oil, working in batches. Flatten slightly by pressing with a spatula."
    },
    {
      "position": 4,
      "text": "Cook until golden brown and crisp, about 3 minutes per side."
    },
    {
      "position": 5,
      "text": "Transfer to a paper towel-lined plate to drain. You can cover them very loosely with aluminum foil to hold in heat without steaming them."
    },
    {
      "position": 6,
      "text": "Repeat with remaining potato mixture. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

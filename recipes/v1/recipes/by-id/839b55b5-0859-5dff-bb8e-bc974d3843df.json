  "id": "839b55b5-0859-5dff-bb8e-bc974d3843df",
  "slug": "chocolate-cantucci",
  "name": "Chocolate Cantucci",
  "recipe_type": "dessert",
  "brief_description": "Cantucci or Italian biscotti (\"twice baked\") are typical Tuscan cookies made here with dark chocolate and are a great treat for Christmas.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine sugar, eggs, and vanilla extract in a large bowl; beat with an electric mixer until frothy. Add flour and baking powder and mix well. Fold in chocolate pieces until a sticky dough forms. Separate dough into 2 portions and shape each portion into a long, thick log. Place logs 2 inches apart on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake logs in the preheated oven until golden brown, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Remove logs from the oven and cool until easily handled, about 5 minutes. Transfer to a cutting board; slice logs diagonally into 3/4-inch slices using a serrated knife."
    },
    {
      "position": 5,
      "text": "Return cantucci slices to the baking sheet and return to the oven. Turn off oven and allow cantucci to dry in the warm oven for 30 minutes. Cool to room temperature, about 10 minutes, before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

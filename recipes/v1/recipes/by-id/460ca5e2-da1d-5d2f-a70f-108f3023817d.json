  "id": "460ca5e2-da1d-5d2f-a70f-108f3023817d",
  "slug": "best-darn-minestrone-soup-around",
  "name": "Best Darn Minestrone Soup Around",
  "recipe_type": "soup",
  "brief_description": "This creamy minestrone soup recipe makes enough to feed a small army. It tastes very similar to the famous minestrone soup from Lelli's in Detroit.",
  "cuisine": "U.S. Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large stock pot over medium heat. Add onions and saut\u00e9 until soft. Add mixed vegetables, broth, kidney beans, tomatoes, spinach, and tomato paste; simmer gently for 1 1/2 hours."
    },
    {
      "position": 2,
      "text": "Use a slotted spoon to transfer about 1/2 of the vegetables to a blender or food processor, reserving the liquid in the stockpot. Pur\u00e9e vegetables until smooth, then return to the pot."
    },
    {
      "position": 3,
      "text": "Stir in heavy cream, macaroni, garbanzo beans, 1/2 of the Parmesan cheese, garlic powder, parsley, pepper, basil, and salt. Cook, stirring frequently, for 30 minutes."
    },
    {
      "position": 4,
      "text": "Ladle into bowls and sprinkle with remaining Parmesan cheese."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

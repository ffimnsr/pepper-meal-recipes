  "id": "ac959174-c814-503d-af41-64071674e0b1",
  "slug": "oven-baked-potato-slices",
  "name": "Oven-Baked Potato Slices",
  "recipe_type": "side",
  "brief_description": "These sliced baked potatoes are seasoned with a flavorful spice blend, drizzled with olive oil, and baked to crispy perfection for an easy side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes, garlic powder, black pepper, celery seed, paprika, cayenne pepper, and salt into a zip-top bag. Shake to coat evenly."
    },
    {
      "position": 3,
      "text": "Pour the entire contents of the bag onto a large baking sheet and spread evenly. Drizzle with olive oil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until potatoes reach desired crispness, turning frequently to brown evenly, 40 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven. Let cool slightly and transfer into a serving dish."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

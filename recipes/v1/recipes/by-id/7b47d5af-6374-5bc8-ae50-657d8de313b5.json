  "slug": "homemade-tangy-barbecue-sauce-recipe-11948824",
  "name": "Homemade Tangy Barbecue Sauce",
  "recipe_type": "side",
  "brief_description": "You can make this homemade tangy barbecue sauce in under a half hour and keep it on hand for your next barbecue. Versatile and delicious, it's made with pantry ingredients and seasonings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomato puree, water, molasses, Worcestershire, hot sauce, apple cider vinegar, white vinegar, mustard, brown sugar, onion powder, garlic powder, salt, and black pepper in a saucepan. Bring to a simmer over medium heat, stirring occasionally. Reduce heat to maintain a gentle simmer and cook 15-20 minutes."
    },
    {
      "position": 2,
      "text": "Adjust seasonings as desired. Let cool completely and store in airtight jars in the fridge for up to 2 months."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 15,

  "id": "8ee6f281-501a-55c9-b3b2-38f10a45aa5d",
  "slug": "garden-tuna-pasta-salad",
  "name": "Garden Tuna Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This delicious pasta salad tastes great and is full of vegetables. Substitute canned shrimp in place of canned tuna to change it up a bit.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine tuna, bell pepper, celery, carrot, radishes, green onions, and parsley in a large bowl."
    },
    {
      "position": 3,
      "text": "Drain macaroni and rinse in cold water. Drain again and add to the bowl with the tuna mixture."
    },
    {
      "position": 4,
      "text": "Combine mayonnaise, ranch dressing, Parmesan cheese, black pepper, and salt in a small bowl. Pour dressing over salad and toss to coat. Refrigerate at least 2 hours before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

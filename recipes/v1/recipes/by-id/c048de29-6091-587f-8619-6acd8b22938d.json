{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c048de29-6091-587f-8619-6acd8b22938d",
  "slug": "mama-s-pork-and-shrimp-wonton-recipe-11879718",
  "name": "Mama\u2019s Pork and Shrimp Wontons",
  "recipe_type": "appetizer",
  "brief_description": "For these pork and shrimp wonton, Mama recommends the Golden Mountain\u00ae brand of Thai seasoning sauce, which is sold at many Asian grocery stores. Don\u2019t overfill the dumplings\u2014it\u2019ll make them harder to fold and might come apart during cooking. Serve with noodles and greens or a soy-based dipping sauce.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Put shrimp in a food processor and pulse until very finely diced (it should be smooth but not pur\u00e9ed). Transfer to a large mixing bowl and add ground pork."
    },
    {
      "position": 2,
      "text": "Add sesame oil, seasoning sauce, thin soy sauce, rice wine, salt, cornstarch, sugar, white pepper, and beaten egg to the bowl. Mix well using a spatula or massage the mixture with your hands until all the liquid disappears (Mom\u2019s secret to a moist, flavorful filling). Transfer filling to a medium bowl."
    },
    {
      "position": 3,
      "text": "Prepare a wonton-folding station with a large cutting board or silicon mat, a small bowl of water, the bowl of filling, the wonton wrappers (lightly covered with a moist paper towel to keep them from drying out), and a large plate sprinkled with flour (to hold the folded wontons)."
    },
    {
      "position": 4,
      "text": "Place a wonton wrapper flat on the cutting board and put about 1 \u00bd teaspoons filling in the center. Dab a finger in water and wet the edges of half the wrapper. Fold the wonton in half, making a half moon shape."
    },
    {
      "position": 5,
      "text": "With the flat side of the wonton facing the bottom of your cutting board, dab water onto one of the wonton\u2019s corners and bring both corners to overlap in the center. Pinch them together to seal and make a gold ingot shape (historical currency in Imperial China). It will look like a little boat with upward sides and a flat bottom."
    },
    {
      "position": 6,
      "text": "Repeat with the rest of the wonton wrappers and filling. To cook wontons, bring a large pot of water to a rolling boil over medium-high heat. Cook wontons in batches, 8 to 10 at a time, until they float to the top, 3 to 4 minutes."
    },
    {
      "position": 7,
      "text": "To freeze the wontons to cook later, put them on a parchment-lined sheet pan after you fold them and pop them into your icebox. Once frozen, they\u2019ll keep in a zip-top bag for up to 3 months. To cook frozen wontons, boil them for 5 to 7 minutes or until they float to the top."
    }
  ],

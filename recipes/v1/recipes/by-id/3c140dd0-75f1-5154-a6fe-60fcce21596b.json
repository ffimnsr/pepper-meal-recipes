  "slug": "halloween-cheese-ball",
  "name": "Halloween Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Rolled in Doritos® and topped with a pepper stem, this spicy, creamy \"pumpkin\" cheese ball is perfect for a Halloween party!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese, Cheddar, and chili powder until well mixed. Form into a ball and refrigerate until ready to serve."
    },
    {
      "position": 2,
      "text": "Just before serving, roll in corn chip crumbs and top with bell pepper stem to look like a pumpkin."
    }
  ],
  "servings": 16,

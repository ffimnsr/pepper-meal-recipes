  "id": "7095e8c8-475c-5557-8d57-fbc42662bc25",
  "slug": "easy-sausage-gravy-and-biscuits",
  "name": "Easy Sausage Gravy and Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "This biscuits and gravy recipe with refrigerated jumbo biscuits and homemade creamy sausage gravy is ready in just 15 minutes for a hearty breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Arrange biscuits 1 to 2 inches apart on an ungreased cookie sheet. Bake in the preheated oven until golden brown, about 13 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook sausage in a large skillet over medium heat until thoroughly heated, stirring frequently, about 5 to 6 minutes."
    },
    {
      "position": 4,
      "text": "Stir in flour until well combined."
    },
    {
      "position": 5,
      "text": "Gradually add milk, stirring continuously, until the gravy thickens and comes to a boil. Reduce heat to medium-low; simmer and stir for 2 more minutes. Season to taste with salt and pepper."
    },
    {
      "position": 6,
      "text": "Split biscuits in half. Place 2 halves on each of 8 plates; top with about 1/3 cup gravy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

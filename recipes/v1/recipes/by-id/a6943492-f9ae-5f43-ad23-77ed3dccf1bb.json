  "id": "a6943492-f9ae-5f43-ad23-77ed3dccf1bb",
  "slug": "elises-slow-cooker-chicken-cacciatore",
  "name": "Elise's Slow Cooker Chicken Cacciatore",
  "recipe_type": "soup",
  "brief_description": "This slow cooker dish of chicken, bell peppers, onion, and mushrooms in a red wine tomato broth makes a hearty meal with a bowl of pasta.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a slow cooker on High."
    },
    {
      "position": 2,
      "text": "Stir tomatoes, wine, chicken stock, tomato paste, and chicken bouillon together in a large bowl. Trim chicken as necessary; sprinkle with Italian herb blend."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium-low heat. Cook chicken breasts until browned, 3 to 5 minutes per side. Transfer chicken to slow cooker along with any accumulated juices."
    },
    {
      "position": 4,
      "text": "Place bell peppers, onion, mushrooms, and garlic in skillet, along with more olive oil if needed. Cook and stir until onion is translucent, about 5 minutes. Stir in flour; cook until vegetables are soft, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in tomato mixture; bring to a boil. Simmer until thickened slightly, about 5 minutes more. Stir in olives; transfer mixture to slow cooker."
    },
    {
      "position": 6,
      "text": "Reduce slow cooker heat to Low and cook until chicken is very tender, 5 1/2 to 6 1/2 hours. Stir pesto and sugar into chicken mixture; cook for 30 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 378,
  "preparation_time_minutes": 20,

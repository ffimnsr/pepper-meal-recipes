  "id": "10021ec8-648a-531e-b5e0-51da590c3a66",
  "slug": "unbelievable-grilled-garlic-bread",
  "name": "Unbelievable Grilled Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "A blend of Cheddar and Parmesan cheeses is spread over lightly toasted French bread. The bread is finished off on the grill.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat grill for medium heat."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix the mayonnaise, garlic, and Parmesan cheese. In a saucepan over medium-low heat, mix the Cheddar cheese, half-and-half, and paprika. Stir constantly until melted and smooth. Pour into the bowl with mayonnaise mixture, stirring until well blended."
    },
    {
      "position": 3,
      "text": "Place the French bread on the grill cut side down, and let it toast for a few minutes. Remove from the grill, and spread the cheese mixture on each side. Place the halves back together, and wrap the loaf in aluminum foil. Return to the grill for about 15 minutes, turning occasionally, until the loaf is heated through and the cheese mixture is hot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "3a23efd6-5de7-54c9-a1e6-b5a96d2bf622",
  "slug": "easy-red-beans-and-rice",
  "name": "Easy Red Beans and Rice",
  "recipe_type": "main",
  "brief_description": "This easy red beans and rice recipe is ready in 40 minutes yet big on flavor. It is a delicious take on a Louisiana classic made with turkey kielbasa.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Prepare the rice: Bring water to a boil in a saucepan. Add rice and stir. Reduce heat, cover, and simmer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook sausage in a large skillet over low heat for 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in onion, green pepper, and garlic; saute until tender."
    },
    {
      "position": 5,
      "text": "Add in beans and tomatoes with juice. Season with oregano, pepper, and salt."
    },
    {
      "position": 6,
      "text": "Simmer uncovered for 20 minutes. Serve over rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "b7dea63c-84f1-57a8-ba3c-50f7adfcb4d7",
  "slug": "one-pan-cheeseburger-rice-recipe-11703787",
  "name": "One-Pan Cheeseburger Rice",
  "recipe_type": "main",
  "brief_description": "This one pan cheeseburger rice can be made with either ground turkey or ground beef. Topped with broiled cheese and served with a tasty burger sauce, plus dill pickles if you like, it\u2019s a quick and easy every day rice dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to Low Broil."
    },
    {
      "position": 2,
      "text": "Heat oil in a large, deep oven\u2013proof skillet over medium-high heat. Add onion and cook, stirring constantly, 1 minute. Add ground turkey and cook, crumbling with a spoon until lightly browned, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Season with salt, 1/2 teaspoon pepper, garlic powder, 3 tablespoons ketchup, and Worcestershire sauce and stir to combine. Add broth and water and bring to a boil, stirring often to loosen any browned bits from the bottom of the pan."
    },
    {
      "position": 4,
      "text": "Stir in rice and return to a boil. Cover and reduce heat to medium-low and simmer until liquid is absorbed and rice is tender, about 20 minutes. Add up to 1/4 cup additional water if needed if liquid is evaporated before rice is tender."
    },
    {
      "position": 5,
      "text": "Just before it is finished, stir in 1 1/4 cups of cheese to rice mixture and top with remaining cheese."
    },
    {
      "position": 6,
      "text": "Broil in the preheated oven just until cheese is melted and bubbly, about 3 minutes. Let stand for 5 minutes before serving."
    },
    {
      "position": 7,
      "text": "Meanwhile, for burger sauce, add remaining pepper and remaining ketchup with mayonnaise and mustard in a small bowl. Stir until well combined and set aside. Serve topped with pickles, lettuce, and burger sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

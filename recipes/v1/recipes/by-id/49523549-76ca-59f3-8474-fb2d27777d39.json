  "id": "49523549-76ca-59f3-8474-fb2d27777d39",
  "slug": "banana-snickerdoodle-bars-recipe-7255290",
  "name": "Banana Snickerdoodle Bars",
  "recipe_type": "dessert",
  "brief_description": "Cross banana bread with snickerdoodles and you'll get these soft, fluffy, tasty banana snickerdoodle bars.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Whisk flour, cream of tartar, baking soda, salt, 1/4 teaspoon cinnamon, and nutmeg together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat butter, 1/2 cup white sugar, and brown sugar in a large bowl with an electric mixer until light and fluffy. Beat in banana and vanilla extract on low speed until thoroughly combined; mix in flour mixture just until dough comes together. Using lightly floured hands, press dough firmly and evenly into the bottom of the prepared pan."
    },
    {
      "position": 4,
      "text": "Whisk together the 1 tablespoon white sugar and 1/2 teaspoon cinnamon; sprinkle cinnamon sugar evenly over the dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven just until the dough in the center of the pan feels set when lightly touched with a finger, about 25 minutes."
    },
    {
      "position": 6,
      "text": "Let bars cool in the pan for 10 minutes before removing to a wire rack to cool completely. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1f6ac07b-6938-5887-804f-a413811708a7",
  "slug": "big-batch-freezer-coconut-margaritas-recipe-12016219",
  "name": "Big Batch Freezer Coconut Margaritas",
  "recipe_type": "appetizer",
  "brief_description": "These big batch freezer coconut margaritas are the perfect make-ahead cocktail to have on hand all summer long. Made with just five ingredients and no blender required, simply stash a batch in the freezer for a frosty, ready-anytime margarita whenever friends stop by.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour out 1 cup of tequila from the bottle and save for later use."
    },
    {
      "position": 2,
      "text": "To the remaining tequila in the bottle, add lime juice, triple sec, and cream of coconut. If any room remains at the top of the bottle, you can add more coconut if desired."
    },
    {
      "position": 3,
      "text": "Place top on bottle and tilt several times to incorporate the ingredients. Place bottle in freezer for at least 8 hours."
    },
    {
      "position": 4,
      "text": "To serve, fill a cup with ice. Add 3 ounces of coconut margarita mix and top with sparkling water. Stir and serve with a lime wedge."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "2fc83895-1502-5842-8804-59dfdfbd9257",
  "slug": "lentil-and-buckwheat-soup",
  "name": "Lentil and Buckwheat Soup",
  "recipe_type": "soup",
  "brief_description": "Lentils and buckwheat groats, simmered with onions, carrots, and spinach, result in a hearty Italian soup. Make and serve this recipe with crusty bread.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Soak lentils in a bowl of cold water for 1 hour. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a Dutch oven or heavy-bottomed pot over medium heat. Add onion and carrot; cook until soft, 3 to 5 minutes. Add lentils and bay leaves; stir until coated with oil. Pour in 3 cups vegetable broth, stir, and bring to a boil. Cook at a slow boil for 10 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to a simmer; add buckwheat groats. Simmer until lentils are soft but not mushy and buckwheat is cooked through, about 25 minutes. Add remaining 1 \u00bd cups broth if needed. Off heat, stir in spinach until wilted. Remove bay leaves."
    },
    {
      "position": 4,
      "text": "Drizzle each serving with \u00bd tablespoon extra-virgin olive oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

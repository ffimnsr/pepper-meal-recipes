  "id": "02356435-9e2e-5113-b3c6-97200834ef27",
  "slug": "grandmas-pineapple-upside-down-cake",
  "name": "Grandma\u2019s Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "Ready in under 1 hour, this classic upside-down cake is made with pineapple rings and pecans to create a quick and easy crowd-pleasing treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a 9-inch cast iron skillet over medium heat. Stir in brown sugar; heat until bubbly. Remove from heat. Arrange pineapple rings and pecans on top."
    },
    {
      "position": 3,
      "text": "Sift flour, baking powder, and salt together in a bowl; repeat sifting twice more."
    },
    {
      "position": 4,
      "text": "Beat white sugar and eggs together in a bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 5,
      "text": "Alternate folding flour mixture and pineapple juice into egg mixture in 3 batches, beginning and ending with flour mixture. Pour over pineapple slices."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 30 to 35 minutes. Let cool in the skillet for 5 minutes. Invert carefully onto a serving platter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

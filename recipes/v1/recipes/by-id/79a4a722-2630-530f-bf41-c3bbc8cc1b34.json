  "slug": "melon-cucumber-gazpacho-recipe-11756284",
  "name": "Melon Cucumber Gazpacho",
  "recipe_type": "appetizer",
  "brief_description": "This melon cucumber gazpacho is a fruity blend of pureed and chopped fresh produce, with a mint-yogurt topping. Serve this cold soup as an appetizer for a summer backyard cookout, brunch, or a light and refreshing snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add watermelon to a blender or food processor, and pulse just until smooth but not completely liquified."
    },
    {
      "position": 2,
      "text": "Combine watermelon puree, cucumber, cantaloupe, salt, lemon juice, and tarragon in a bowl. Cover and refrigerate until fully chilled, at least 2 hours."
    },
    {
      "position": 3,
      "text": "Combine yogurt, basil, and mint in a small bowl. Pour gazpacho into cups or small bowls, top with a dollop of the yogurt mixture, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 15,

  "id": "60b4cb02-8120-5078-9f32-491605026670",
  "slug": "super-easy-chilaquiles",
  "name": "Super Easy Chilaquiles",
  "recipe_type": "breakfast",
  "brief_description": "Chilaquiles are a quick brunch item with scrambled eggs, salsa, cheese, and tortillas. This super easy chilaquiles recipe can be scaled up or down.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat; fry tortilla triangles until just starting to turn golden brown and crisp, 3 to 5 minutes. Add salsa; reduce heat to medium-low. Carefully mix tortillas and salsa with a spatula; cook 5 minutes."
    },
    {
      "position": 2,
      "text": "Beat eggs, salt, and black pepper together in a small bowl; add to tortilla mixture. Increase heat to medium-high; gently scramble eggs until just set. Top with pepper Jack cheese, cover skillet, and turn off heat. Let sit for 3 minutes until cheese is melted."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "26221e7d-df34-5e3e-b21d-eb5ba51704c7",
  "slug": "strawberry-creme-brulee-pie",
  "name": "Strawberry Creme Brulee Pie",
  "recipe_type": "dessert",
  "brief_description": "A vintage recipe for custard pie has a sweet creamy filling, a layer of sweetened strawberries, and an unusual broiled sugar topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss strawberries with brown sugar in a bowl and let stand while you complete remaining steps, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Whisk flour, 1 tablespoon white sugar, and 1/4 teaspoon salt in a bowl until thoroughly combined. Cut butter into the flour mixture until it resembles coarse crumbs, and drizzle in milk. Mix just until the dough holds together. Turn dough out onto a floured surface and roll out into a 10-inch circle. Fit dough into a 9-inch pie dish. Prick the dough several times on the bottom and sides; fill with dry beans or pie weights."
    },
    {
      "position": 4,
      "text": "Bake the crust in the preheated oven until golden brown, about 25 minutes. Remove crust and let cool."
    },
    {
      "position": 5,
      "text": "Bring cream just barely to a simmer in a saucepan over low heat. Whisk egg yolks thoroughly in a bowl with 1/4 teaspoon salt and add about 1 tablespoon of the hot cream to the beaten yolks, whisking constantly. Continue to add and whisk hot cream into the yolks until about 2/3 cup of cream has been added, then whisk the yolk mixture into the remaining hot cream in the saucepan, pouring it in a thin stream. Continue whisking until cream mixture is thick and smooth, about 5 more minutes; do not let boil or custard will curdle. Remove custard from heat and let stand until it reaches room temperature, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Drain juice from strawberries and layer them into the bottom of the baked pie shell. Spread cream custard over the berries; refrigerate until set, about 4 hours."
    },
    {
      "position": 7,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 8,
      "text": "Sprinkle 1/4 cup white sugar evenly over top of pie and broil until the sugar is browned, about 5 minutes. Let pie stand 5 minutes for sugar topping to cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,

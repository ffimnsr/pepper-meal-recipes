  "id": "f36a7478-5715-55f0-a4a9-e28cf67a2dd0",
  "slug": "classic-italian-pastina-soup-recipe-7971739",
  "name": "Classic Italian Pastina Soup",
  "recipe_type": "soup",
  "brief_description": "This comforting pastina soup with chicken, Italian pasta, and tender vegetables is perfect for chilly days or when you're feeling under the weather.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a large pot and pour water over to cover."
    },
    {
      "position": 2,
      "text": "Roughly chop 2 ribs of celery, 1 \u00bd onions, and 2 carrots; add to pot with chicken. Season with 2 teaspoon salt and 1 teaspoon pepper and bring pot to a boil over high heat. Reduce the heat to medium-low and allow the chicken to simmer 1 hour, covered."
    },
    {
      "position": 3,
      "text": "Remove chicken from the pot and allow to cool before removing and shredding the meat. Strain the stock and discard the solids. Reserve liquid and add water if necessary to measure 12 cups of liquid. Wipe pot clean."
    },
    {
      "position": 4,
      "text": "Finely chop remaining celery, onion and carrot. Place pot over medium-high heat and add oil. Add chopped vegetables, remaining salt, pepper and garlic and cook frequently until vegetables are tender and onion is translucent (the veggies should not be browned). Add reserved stock and chicken base and stir to combine. Bring mixture to a boil and reduce it to simmer. Allow soup to simmer 10 minutes."
    },
    {
      "position": 5,
      "text": "Increase heat to high and bring to a boil. Add pasta and cook, stirring occasionally 15 minutes or until pasta is tender. Reduce heat to low and add chicken and season if desired. Cook 5 additional minutes. Stir in chopped parsley and serve with grated Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "268ef24f-5899-5dcf-99ea-df9e8777ae63",
  "slug": "bacon-for-the-family-or-a-crowd",
  "name": "Bacon for the Family or a Crowd",
  "recipe_type": "breakfast",
  "brief_description": "Baking bacon at 350 degrees F is the best way to get crisp bacon without having to constantly turn it and watch over it. Perfect for a hungry family!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Arrange the bacon in a single layer on the prepared sheet with the edges touching or slightly overlapping."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven to desired degree of doneness, 10 to 15 minutes. Remove bacon from the baking sheet with tongs or a fork, and drain on a paper towel-lined plate."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

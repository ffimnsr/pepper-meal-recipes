  "id": "cf6f63ca-5e2b-5923-aff2-bb1f92d113e8",
  "slug": "coconut-ice-cream",
  "name": "Coconut Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This easy coconut ice cream is made in an ice cream maker with just 3 ingredients, including cream of coconut, for a sweet and creamy frozen dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream of coconut and milk in a food processor or blender; mix thoroughly. Stir in cream and flaked coconut (if using) until combined."
    },
    {
      "position": 3,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer\u2019s instructions, about 25 minutes. Transfer ice cream to an airtight container and freeze until firm or desired consistency."
    }
  ],

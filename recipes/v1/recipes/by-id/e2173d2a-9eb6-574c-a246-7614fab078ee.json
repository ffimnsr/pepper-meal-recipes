  "slug": "zucchini-chocolate-oatmeal-bites",
  "name": "Zucchini Chocolate Oatmeal Bites",
  "recipe_type": "appetizer",
  "brief_description": "Made with zucchini, oats, honey, and almond butter, this no-bake zucchini chocolate oatmeal bite recipe makes a gluten free, quick, and easy snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, almond butter, zucchini, chocolate chips, honey, flaxseed meal, and ground cinnamon in a large bowl."
    },
    {
      "position": 2,
      "text": "Roll mixture into 18 bite-sized balls; arrange in a storage container and refrigerate until set, about 1 hour."
    }
  ],
  "servings": 18,

  "id": "b46bf235-96db-568c-b126-18fbe36cac19",
  "slug": "alabama-fire-crackers",
  "name": "Alabama Fire Crackers",
  "recipe_type": "appetizer",
  "brief_description": "Fire crackers are easy to make with saltine crackers, garlic, onion, black pepper, and plenty of red chili flakes for a fiery hot, savory snack.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place vegetable oil, ranch dressing mix, crushed red pepper flakes, garlic powder, onion powder, and black pepper in a 2-gallon resealable plastic bag."
    },
    {
      "position": 3,
      "text": "Seal the bag and squeeze with your hands until oil and spices are well combined."
    },
    {
      "position": 4,
      "text": "Place crackers into the bag, seal, and turn the bag over to coat crackers with spice mix."
    },
    {
      "position": 5,
      "text": "Let sit for about 1 hour, then turn again. Repeat several times until crackers are well-coated with spice mix, then allow the bag to sit 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "Remove crackers and serve."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

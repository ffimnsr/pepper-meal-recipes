  "id": "505b10be-d7e1-5604-82b5-f83560a6cc11",
  "slug": "air-fryer-quesadillas-recipe-8651442",
  "name": "Air Fryer Quesadillas",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer quesadillas are golden and crispy, quick and easy to make, and there are no skillets to wash. Both flour and corn tortillas work for this recipe and the choice of cheese is up to you.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat tortillas in the microwave until pliable, about 15 seconds."
    },
    {
      "position": 2,
      "text": "Place 1/4 cup cheese on one half of each tortilla; fold other half of tortilla over cheese. Place in air fryer. Spray with non-stick cooking spray."
    },
    {
      "position": 3,
      "text": "Set temperature to 375 degrees F (190 degrees C). Place quesadillas in the basket of the air fryer, and cook until golden brown, 4 to 6 minutes. Flip quesadillas, press down with a spatula, and air fry an additional 2 to 3 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

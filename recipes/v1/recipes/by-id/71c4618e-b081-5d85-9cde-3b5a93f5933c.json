  "id": "71c4618e-b081-5d85-9cde-3b5a93f5933c",
  "slug": "churro-bites-recipe-8625431",
  "name": "Churro Bites",
  "recipe_type": "appetizer",
  "brief_description": "These churro bites are crisp, sweet, cinnamon-spiced snack bites made by baking mini peanut butter sandwich cookies with a brown sugar and butter syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a large-rimmed baking sheet with parchment paper. Add crackers in one even layer."
    },
    {
      "position": 2,
      "text": "Add butter, 1/3 cup plus 2 tablespoons brown sugar, vanilla extract, and 1/2 teaspoon cinnamon to a saucepan over medium-high heat; cook, stirring often, until well combined and simmering, 2 to 4 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Carefully pour butter mixture over the layer of crackers. Using a silicone spatula, toss crackers until well coated in butter mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbling and golden brown, about 10 minutes, flipping and tossing crackers halfway through cooking time."
    },
    {
      "position": 5,
      "text": "Meanwhile, stir granulated sugar and remaining 3/4 teaspoon cinnamon together in a small bowl."
    },
    {
      "position": 6,
      "text": "Remove crackers from the oven and allow to cool, 1 to 2 minutes. Transfer to a large bowl and toss with cinnamon sugar mixture until well coated. Transfer to a serving bowl. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 8,
  "rest_time_minutes": null,
  "difficulty": "medium",

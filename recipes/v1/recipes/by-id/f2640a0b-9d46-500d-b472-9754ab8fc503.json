  "id": "f2640a0b-9d46-500d-b472-9754ab8fc503",
  "slug": "slow-cooker-mac-and-cheese",
  "name": "Slow Cooker Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This slow cooker mac and cheese is easy to prep and make in your slow cooker for a creamy, comforting weeknight dinner. It's sure to be an instant hit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in macaroni pasta and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and transfer pasta to a slow cooker."
    },
    {
      "position": 3,
      "text": "Stir butter into pasta until melted; season with salt and black pepper. Sprinkle about \u00bd Cheddar cheese over pasta; stir."
    },
    {
      "position": 4,
      "text": "Whisk evaporated milk and eggs together in a bowl until smooth; stir into pasta mixture."
    },
    {
      "position": 5,
      "text": "Whisk whole milk and condensed soup together in a bowl until smooth; stir into pasta mixture."
    },
    {
      "position": 6,
      "text": "Sprinkle remaining \u00bd Cheddar cheese over pasta mixture; sprinkle with paprika."
    },
    {
      "position": 7,
      "text": "Cook on Low for 3 hours, checking the edges are not getting too brown after 2 \u00bd hours."
    },
    {
      "position": 8,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

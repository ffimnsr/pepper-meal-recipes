  "id": "0a1482bd-591d-5250-a6ad-30808015035b",
  "slug": "air-fryer-roasted-okra",
  "name": "Air Fryer Roasted Okra",
  "recipe_type": "side",
  "brief_description": "This air fryer okra recipe simply coats the vegetable in olive oil and cooks it in a single layer for a deliciously crispy texture in just 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place okra, olive oil, salt, and pepper in a large bowl; stir gently to coat. Arrange okra in a single layer in the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook in the preheated air fryer for 10 minutes, tossing the basket halfway."
    },
    {
      "position": 4,
      "text": "Toss the basket once more; continue to cook until crispy, about 2 minutes more."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

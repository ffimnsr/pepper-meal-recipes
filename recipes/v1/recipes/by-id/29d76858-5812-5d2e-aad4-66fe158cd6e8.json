  "id": "29d76858-5812-5d2e-aad4-66fe158cd6e8",
  "slug": "slow-cooker-frittata",
  "name": "Slow Cooker Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This vegetarian slow cooker frittata is a great breakfast or brunch option with vegetables, cheese, and Italian seasoning. Add sausage, if you like!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a slow cooker generously with cooking spray."
    },
    {
      "position": 2,
      "text": "Melt ghee in a skillet over medium heat. Add mushrooms, spinach, cherry tomatoes, and green onions. Saut\u00e9 until soft, about 5 minutes. Season with salt and pepper. Transfer to the slow cooker."
    },
    {
      "position": 3,
      "text": "Whisk eggs, Cheddar cheese, parsley, Parmesan cheese, and Italian seasoning together. Pour egg mixture over vegetables in the slow cooker."
    },
    {
      "position": 4,
      "text": "Cook until set, 1 to 2 hours on High, or 3 to 4 hours on Low."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

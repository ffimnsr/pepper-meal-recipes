  "id": "e3ca5b92-83b7-5529-bd24-706eeff345f7",
  "slug": "instant-pot-carne-adovado",
  "name": "Instant Pot Carne Adovado",
  "recipe_type": "main",
  "brief_description": "Chunks of pork shoulder smothered in an easy homemade New Mexico red chile sauce are cooked to succulent tenderness in an Instant Pot.",
  "cuisine": "U.S. Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place New Mexico chiles in a heat-proof bowl."
    },
    {
      "position": 2,
      "text": "Bring chicken broth to a boil in a small saucepan. Pour over the chiles; left soften, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Turn on a multi-cooker (such as Instant Pot) and the select Saute function. Coat pork with flour and add to pot in batches; saute until golden brown, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Transfer soaked chiles to a blender. Add broth, garlic, and chipotle peppers; blend until smooth."
    },
    {
      "position": 5,
      "text": "Combine blended chile sauce, onion, vinegar, salt, oregano, and cumin in a bowl; pour sauce over the pork."
    },
    {
      "position": 6,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 20 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 7,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove lid."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

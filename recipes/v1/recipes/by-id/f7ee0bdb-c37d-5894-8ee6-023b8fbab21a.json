  "id": "f7ee0bdb-c37d-5894-8ee6-023b8fbab21a",
  "slug": "ham-and-split-pea-soup-recipe-a-great-soup",
  "name": "Ham and Split Pea Soup Recipe \u2014 A Great Soup",
  "recipe_type": "soup",
  "brief_description": "This tasty split pea soup with ham from Chef John is rich and hearty with a subtle smoky flavor; it is a super satisfying way to use leftover ham.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large soup pot over medium-low heat. Stir in celery, onion, and sliced garlic; cook and stir until onions are translucent but not brown, 5 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Stir in split peas, ham, and bay leaf. Pour in chicken stock and water; stir to combine and simmer until peas are tender and soup has thickened, about 1 hour and 15 minutes. Stir occasionally."
    },
    {
      "position": 4,
      "text": "Season with salt and black pepper to serve."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,

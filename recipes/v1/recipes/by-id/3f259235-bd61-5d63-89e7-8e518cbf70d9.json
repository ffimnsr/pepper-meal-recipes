  "id": "3f259235-bd61-5d63-89e7-8e518cbf70d9",
  "slug": "african-sweet-potato-and-peanut-soup",
  "name": "African Sweet Potato and Peanut Soup",
  "recipe_type": "soup",
  "brief_description": "Peanut flavor is balanced by warm spices and the earthy sweetness of sweet potatoes.",
  "cuisine": "West African",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oil in a large saucepan over medium-high heat. Saute the onion 10 minutes, until lightly browned. Mix in the garlic, ginger, cumin, coriander, cinnamon, and cloves. Stir in the tomatoes, sweet potatoes, and carrot, and continue to cook and stir about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour water into the saucepan, and season the mixture with salt. Bring to a boil, reduce heat, and simmer 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove the soup mixture from heat. In a food processor or blender, blend the soup and peanuts until almost smooth. Season with cayenne pepper. Return to the saucepan. Whisk in the peanut butter, and cook until heated through. Serve warm topped with fresh cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

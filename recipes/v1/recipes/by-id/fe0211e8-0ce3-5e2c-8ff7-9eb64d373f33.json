  "id": "fe0211e8-0ce3-5e2c-8ff7-9eb64d373f33",
  "slug": "veronicas-hot-spinach-artichoke-and-chile-dip",
  "name": "Veronica's Hot Spinach, Artichoke and Chile Dip",
  "recipe_type": "appetizer",
  "brief_description": "Green chiles and jalapeno peppers spice up this spin on the classic party dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together the cream cheese and mayonnaise in a bowl until smooth. Stir in the green chiles, Parmesan cheese, artichokes, peppers, and spinach. Spoon the mixture into a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until slightly browned, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "slug": "crumb-topping-for-pies",
  "name": "Crumb Topping for Pies",
  "recipe_type": "dessert",
  "brief_description": "This easy crumb topping is perfect for apple pie or for a streusel-like topping on your favorite fruit crisp, crumble, or coffee cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix sugar and flour together in a medium bowl. Cut in cold butter with 2 knives or pastry blender until the topping is crumbly."
    },
    {
      "position": 3,
      "text": "Sprinkle crumb topping evenly over fruit pie filling before baking."
    }
  ],
  "servings": 2,

  "slug": "marias-pepper-steak",
  "name": "Maria's Pepper Steak",
  "recipe_type": "main",
  "brief_description": "This simple pepper steak recipe features a mixture of sliced flank steak and vegetables cooked in equal parts soy sauce, honey, and red wine vinegar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add bell peppers, onion, and garlic; saut\u00e9 until crisp-tender, 3 to 4 minutes. Transfer to a bowl."
    },
    {
      "position": 2,
      "text": "Increase the heat to medium-high and pour soy sauce, honey, and vinegar into the skillet. Add beef and cook, stirring frequently, for 10 to 15 minutes. Return cooked vegetables to the skillet and cook for 10 to 15 more minutes."
    }
  ],
  "servings": 6,

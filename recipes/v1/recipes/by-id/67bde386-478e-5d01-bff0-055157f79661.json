  "id": "67bde386-478e-5d01-bff0-055157f79661",
  "slug": "cheesy-baked-cauliflower-florets",
  "name": "Cheesy Baked Cauliflower Florets",
  "recipe_type": "side",
  "brief_description": "Cheesy cauliflower florets are a delicious side dish--they start off in the oven and finish up in a rich and creamy Cheddar cheese sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray a large baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread cauliflower evenly onto the prepared baking sheet. Spray cauliflower with cooking spray, then season with 1 teaspoon salt, 1/2 teaspoon pepper, and garlic powder."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender, stirring halfway through, about 25 minutes."
    },
    {
      "position": 4,
      "text": "While cauliflower is baking, whisk evaporated milk, eggs, dry mustard, and hot sauce together in a small bowl."
    },
    {
      "position": 5,
      "text": "Remove cauliflower from the oven."
    },
    {
      "position": 6,
      "text": "Melt butter in a medium saucepan over medium-low heat. Carefully add cauliflower; toss to coat. Stir in milk-egg mixture. Add Cheddar cheese and gently stir until creamy, about 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

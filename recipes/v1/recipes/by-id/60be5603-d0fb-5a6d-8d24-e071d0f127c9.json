  "slug": "apple-cider-turkey-brine",
  "name": "Apple Cider Turkey Brine",
  "recipe_type": null,
  "brief_description": "Tart apple cider, peppercorns, and herbs are boiled and then cooled with ice in this effortless turkey brine that the whole family will love.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 4 cups water, apple cider, kosher salt, sage, rosemary, thyme, and peppercorns together in a large stockpot. Bring to a boil; cook and stir brine until the salt is just dissolved. Remove from heat; add ice cubes."
    }
  ],
  "servings": 12,

  "id": "b5344a2b-63b3-558a-8244-db125a94477a",
  "slug": "titaina",
  "name": "Titaina",
  "recipe_type": "salad",
  "brief_description": "Tomatoes and peppers are simmered with tomatoes and tuna. I had this at a tapas bar in Spain way back and was able to figure out how to mimic it. It's an easy way to clean out the fridge and pantry. And, perfect for a low carb diet. I was introduced to this as a tapa. But you could always pair it with a salad or other veggie side dish for dinner.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Toast the pine nuts in a dry skillet over medium heat for about 5 minutes, or until fragrant. Remove from heat, and set aside to cool."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add the red and green bell peppers, onion, and garlic. Cook and stir until wilted and soft, about 10 minutes. Stir in the tomatoes, and continue to cook and stir for another 15 minutes. Mix in the tuna, sugar, cinnamon, nutmeg, salt, and pepper. Simmer for about 15 more minutes. Stir in the pine nuts, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

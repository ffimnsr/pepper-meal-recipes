  "id": "acc0e6d4-abde-55b1-9177-33573c7b799e",
  "slug": "no-fail-bean-pie",
  "name": "No-Fail Bean Pie",
  "recipe_type": "dessert",
  "brief_description": "This bean pie is a traditional Muslim recipe made with canned navy beans, evaporated milk, and sugar. It's similar to pumpkin pie but not as sweet.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place each pie pastry into a 9-inch pie pan."
    },
    {
      "position": 2,
      "text": "Place navy beans and evaporated milk into a food processor. Add sugar, melted butter, eggs, egg yolks, flour, vanilla, cinnamon, and nutmeg; pulse a few times, then process until smooth, about 1 minute. Pour mixture into the prepared pie crusts."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes, then reduce heat to 350 degrees F (175 degrees C) and bake until filling is set and crust is golden brown, about 35 more minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and let cool for 1 hour before slicing."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

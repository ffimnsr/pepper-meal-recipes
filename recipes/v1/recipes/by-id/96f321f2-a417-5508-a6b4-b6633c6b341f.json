  "id": "96f321f2-a417-5508-a6b4-b6633c6b341f",
  "slug": "acorn-squash",
  "name": "Acorn Squash",
  "recipe_type": "dessert",
  "brief_description": "Acorn squash is baked with just butter and brown sugar until perfectly soft and tender, sweet, and buttery for a deliciously easy fall side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Place squash halves, cut-side down, on a baking sheet. Bake in the preheated oven until flesh begins to soften, about 30 to 45 minutes."
    },
    {
      "position": 4,
      "text": "Remove squash from the oven and transfer one squash half, cut-side up, to a deep baking dish. Spoon butter and brown sugar into the cavity. Place remaining squash half, cut-side down, over top to seal."
    },
    {
      "position": 5,
      "text": "Return to the oven and continue to bake until flesh is soft, 30 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 60,

  "slug": "roasted-pumpkin-seeds",
  "name": "Roasted Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This roasted pumpkin seeds recipe turns a handful of seeds into a crispy, delicious snack with just butter and salt, which you likely already have.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss seeds in a large bowl with the butter and salt. Spread in a single layer on a baking sheet; bake until golden, stirring occasionally, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,

  "id": "41d60b59-ef4d-5aa7-a015-f7335d603707",
  "slug": "southern-grilled-barbecued-ribs",
  "name": "Southern Grilled BBQ Ribs",
  "recipe_type": "main",
  "brief_description": "These grilled BBQ ribs are baked, then cooked on the grill and basted with a homemade tangy BBQ sauce until tender and juicy.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place ribs in two 10x15-inch roasting pans. Pour water and red wine vinegar into a bowl; stir to mix and pour over ribs. Cover the pans with foil and bake in the preheated oven for 1 hour to 1 hour 15 minutes. Baste the ribs with juices halfway through cooking."
    },
    {
      "position": 2,
      "text": "Meanwhile, make the BBQ sauce: Mix ketchup, water, vinegar, Worcestershire sauce, mustard, butter, brown sugar, hot pepper sauce, and salt together in a medium saucepan; bring to a boil. Reduce heat to low, cover, and simmer until sauce has thickened, about 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat."
    },
    {
      "position": 4,
      "text": "Lightly oil preheated grill. Transfer ribs from the oven to the grill, discarding cooking liquid. Grill over medium heat for 15 minutes, turning ribs once. Baste ribs generously with some of the BBQ sauce, and grill for 5 minutes. Turn ribs, baste again with BBQ sauce, and grill 5 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "f50418e0-d701-52b7-838c-98b1957c7df3",
  "slug": "easy-key-lime-pie-i",
  "name": "Easy Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy key lime pie is made tart and creamy with yolks, key lime juice, and condensed milk baked in a graham cracker crust for a winning dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine sweetened condensed milk, key lime juice, and egg yolks in a large bowl; mix well."
    },
    {
      "position": 4,
      "text": "Pour mixture into unbaked graham cracker crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is set, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Allow to cool completely before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

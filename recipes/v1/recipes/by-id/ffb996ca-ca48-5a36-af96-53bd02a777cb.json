  "id": "ffb996ca-ca48-5a36-af96-53bd02a777cb",
  "slug": "baked-potato-latkes",
  "name": "Baked Potato Latkes",
  "recipe_type": "dessert",
  "brief_description": "Mix baked potatoes or leftover mashed potatoes with onion, garlic, salt, pepper, and eggs, then shape into pancakes to make these delicious latkes.",
  "cuisine": "Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes, onion, garlic, salt, ground peppercorns, flour, and eggs into a bowl. Fold the mixture together with a rubber spatula, breaking up any large potato chunks, until ingredients are evenly mixed."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or large skillet to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Form latke dough into 3-inch diameter balls and flatten into 1-inch thick rounds."
    },
    {
      "position": 4,
      "text": "Working in batches, place latkes in hot oil and cook until edges are golden brown, 3 to 5 minutes. Flip latkes using a slotted spoon and cook until crisp, 2 to 3 minutes more. Transfer to a paper towel-lined plate to cool."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

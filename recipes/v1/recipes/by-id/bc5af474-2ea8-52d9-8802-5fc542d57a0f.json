  "id": "bc5af474-2ea8-52d9-8802-5fc542d57a0f",
  "slug": "vodka-pan-pizza-recipe-11806666",
  "name": "Vodka Pan Pizza",
  "recipe_type": "main",
  "brief_description": "In this vodka pan pizza, the traditional margherita pizza is transformed by the addition of vodka sauce. Store bought dough and sauce will allow you to have pizza faster than delivery, start to finish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 12-inch cake pan."
    },
    {
      "position": 2,
      "text": "Stretch and roll out pizza dough and place in the prepared pan. Prick pizza dough with fork tines."
    },
    {
      "position": 3,
      "text": "Bake pizza dough in the preheated oven for 5 minutes. Remove pizza from the oven; spread vodka sauce on pizza to within 1/2 inch of the crust edge."
    },
    {
      "position": 4,
      "text": "Lay mozzarella slices on the pizza. Sprinkle with Parmesan."
    },
    {
      "position": 5,
      "text": "Bake for 15 minutes more. Remove and add tomato halves. Bake until pizza crust is golden, about 5 more minutes."
    },
    {
      "position": 6,
      "text": "Remove pizza from the oven; garnish with basil. If desired, add garlic granules to olive oil; brush along the exposed crust. Cut into 8 to 10 slices; serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

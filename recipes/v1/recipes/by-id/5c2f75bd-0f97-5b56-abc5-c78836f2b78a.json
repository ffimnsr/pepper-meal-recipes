  "id": "5c2f75bd-0f97-5b56-abc5-c78836f2b78a",
  "slug": "crunchy-romaine-salad",
  "name": "Crunchy Romaine Salad",
  "recipe_type": "salad",
  "brief_description": "A wonderful combination of flavors in this very easy to prepare salad. A ton of crunch comes from ramen noodles, pecans, and romaine lettuce.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Add sugar, oil, vinegar, soy sauce, salt, and black pepper to a jar with a tight-fitting lid; shake until well blended. Set aside."
    },
    {
      "position": 2,
      "text": "Break ramen noodles into small pieces; set aside. Discard flavor packet."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium heat. Add pecans and noodles; cook and stir until browned, about 5 minutes. Drain on paper towels; let cool."
    },
    {
      "position": 4,
      "text": "Toss broccoli, romaine lettuce, green onions, pecans, and noodles together in a bowl. Add 1 cup, or more, dressing; toss to coat."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "maple-syrup-cranberry-sauce",
  "name": "Maple Syrup Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "A Thanksgiving staple, this cranberry sauce recipe dresses up fresh cranberries with maple syrup, a splash of brandy, lemon juice, and brown sugar.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and maple syrup in a saucepan; bring to a boil. Add cranberries; cook at a boil until berries pop, 10 to 15 minutes. Stir in brown sugar and lemon juice until sugar is completely dissolved. Stir in brandy."
    }
  ],
  "servings": 6,

  "id": "2ba97369-6418-5572-8a2e-9cc14400711d",
  "slug": "crustless-cheesecake-recipe-11972206",
  "name": "Crustless Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "A super easy cheesecake that doesn't require much time to make! The crust is self-forming using the butter and flour applied to the pan prior to adding the ingredients. Great for beginners and those who have been baking for years.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a 9-or 10-inch pie plate with butter. Sprinkle with flour until covered. (This combination will bake into a thin \u201ccrust.\u201d)"
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, and vanilla extract in the bowl of a stand mixer fitted with a paddle attachment. Add eggs, 1 at a time, and mix well after each addition until each egg is fully incorporated into the batter. Pour cheesecake filling into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 35 minutes (if using a 10-inch pan) or 45 minutes (if using a 9-inch pan)."
    },
    {
      "position": 4,
      "text": "Remove from the oven, and allow the cheesecake to stand for 5 minutes. It will fall in the middle."
    },
    {
      "position": 5,
      "text": "While cheesecake rests, preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 6,
      "text": "Mix sour cream and sugar together in a small bowl using a fork or a whisk. Pour sour cream mixture over the fallen middle of the cheesecake. Spread toward the edges, leaving a rim around the exterior."
    },
    {
      "position": 7,
      "text": "Return cheesecake to the oven and bake for 5 minutes more."
    },
    {
      "position": 8,
      "text": "Remove from the oven and allow cheesecake to cool completely before serving or refrigerate for up to 4 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

  "id": "14b9f3d0-0905-5fa7-b080-a1c6a870a8d8",
  "slug": "baked-ham-and-cheese-party-sandwiches",
  "name": "Baked Ham and Cheese Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These baked ham and cheese sliders layer deli ham and Swiss cheese on soft rolls with a buttery Dijon-poppy seed topping for an easy party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix butter, Dijon mustard, Worcestershire sauce, poppy seeds, and dried onion in a bowl."
    },
    {
      "position": 3,
      "text": "Separate the tops from the bottoms of the rolls; arrange the bottom pieces in a layer in the prepared baking dish. Layer about 1/2 of the ham onto the rolls; add a layer of Swiss cheese and top with remaining ham slices."
    },
    {
      "position": 4,
      "text": "Place the tops of the rolls onto the sandwiches. Pour mustard mixture evenly over the rolls"
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the rolls are lightly browned and the cheese has melted, about 20 minutes. Slice into individual rolls through the ham and cheese layers to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1670c40b-22cb-551a-8185-d85dcfb26ac8",
  "slug": "mini-cinnamon-rolls",
  "name": "Mini Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "This recipe for mini cinnamon rolls uses refrigerated crescent dough to make quick and easy sweet treats, perfect served warm after a weeknight meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Make rolls: Unroll crescent roll dough onto a silicone baking mat or lightly greased work surface and separate into 4 rectangles; firmly press diagonal perforations with your fingers to smooth them out."
    },
    {
      "position": 3,
      "text": "Mix together brown sugar and cinnamon in a small bowl; sprinkle evenly over rectangles."
    },
    {
      "position": 4,
      "text": "Roll each rectangle into a log starting from the longer side; cut each log into 1/2-inch-thick slices. Arrange cinnamon rolls close to one another on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, 10 to 13 minutes. Transfer cinnamon rolls to a plate and let cool for 1 minute."
    },
    {
      "position": 6,
      "text": "While cinnamon rolls are baking, make icing: Stir together confectioners\u2019 sugar, milk, and vanilla in a small bowl until smooth."
    },
    {
      "position": 7,
      "text": "Pour icing over warm rolls."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

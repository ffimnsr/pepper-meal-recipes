  "id": "e6ffd4ae-be27-5a25-b032-aa34223c57b9",
  "slug": "mashed-potatoes-with-cream-cheese",
  "name": "Mashed Potatoes with Cream Cheese",
  "recipe_type": "side",
  "brief_description": "These cream cheese mashed potatoes are rich and creamy, smooth, and delicious \u2014 perfect for weeknight dinners or holiday meals.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and transfer to a bowl."
    },
    {
      "position": 3,
      "text": "While potatoes are still hot and steaming, add cream cheese, milk, butter, and salt."
    },
    {
      "position": 4,
      "text": "Blend with an electric hand mixer until creamy and smooth."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

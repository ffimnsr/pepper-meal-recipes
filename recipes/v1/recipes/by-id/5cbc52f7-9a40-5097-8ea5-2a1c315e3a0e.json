  "id": "5cbc52f7-9a40-5097-8ea5-2a1c315e3a0e",
  "slug": "buffalo-chicken-smashed-tacos-recipe-11897718",
  "name": "Buffalo Chicken Smashed Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These Buffalo chicken smashed tacos are the way to feed the hungry game day crowd. Ranch and Buffalo sauce-seasoned ground chicken, fried and topped with a Buffalo-style slaw, makes a brilliant smashed taco.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, green onions, ranch seasoning, 1/2 teaspoon salt, 1/4 teaspoon pepper, cheese, and 2 tablespoons Buffalo sauce in a bowl. Mix well; spread evenly all the way to the edges of each flour tortilla."
    },
    {
      "position": 2,
      "text": "Heat a griddle or pan over medium-high heat. Coat lightly with oil and place tacos, meat side down onto the griddle. Cook 5 minutes, undisturbed, until browned and cooked through. Flip tortillas and cook 1 minute longer."
    },
    {
      "position": 3,
      "text": "Meanwhile, toss cabbage, celery, carrots, blue cheese, vinegar, olive oil, sugar, and remaining salt and pepper in a large bowl until well combined."
    },
    {
      "position": 4,
      "text": "Serve slaw on tacos and drizzle with remaining Buffalo sauce."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

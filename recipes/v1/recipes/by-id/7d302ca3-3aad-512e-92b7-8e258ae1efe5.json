  "slug": "antipasto-on-a-stick",
  "name": "Antipasto on a Stick",
  "recipe_type": "appetizer",
  "brief_description": "This fun antipasto appetizer is threaded onto toothpicks! Salami, mozzarella, artichokes, and olives are drizzled with olive oil for an Italian-inspired appetizer.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Thread ingredients onto toothpicks in the following order: salami roll, mozzarella cube, olive, tomato half, artichoke heart, and basil leaf. Arrange toothpicks on a serving platter and drizzle olive oil over top."
    }
  ],
  "servings": 8,

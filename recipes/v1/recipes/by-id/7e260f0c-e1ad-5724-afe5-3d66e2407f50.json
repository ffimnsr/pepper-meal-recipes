  "id": "7e260f0c-e1ad-5724-afe5-3d66e2407f50",
  "slug": "chicken-fajita-smashed-tacos-recipe-12058025",
  "name": "Chicken Fajita Smashed Tacos",
  "recipe_type": "main",
  "brief_description": "This Chicken Fajita Smashed Tacos recipe is a fun cross between sizzling fajitas and crispy-edged smashburgers. Ground chicken is smashed onto flour tortillas and cooked with peppers and onions on a hot griddle for a quick, flavor-packed meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add chicken, garlic, chili powder, cumin, 1/2 teaspoon salt, and 1/4 teaspoon black pepper to a bowl and mix until well combined."
    },
    {
      "position": 2,
      "text": "Spread mixture evenly and all the way to the edges of the tortillas."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon of oil on a large griddle or in a skillet over medium-high heat. Add peppers and onions and cook, stirring frequently until tender, 5 to 7 minutes. Season with remaining salt, remaining black pepper, and garlic powder and cook 1 more minute. Set vegetables aside."
    },
    {
      "position": 4,
      "text": "Working in batches if necessary, add remaining oil to hot griddle and add tortillas, meat side down. Cook until cooked through and browned, 3 to 4 minutes. Flip and cook until toasted on the second side, 30 seconds to 1 minute longer."
    },
    {
      "position": 5,
      "text": "Top with peppers and onions and fold tortillas in half to form a taco. Top as desired and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

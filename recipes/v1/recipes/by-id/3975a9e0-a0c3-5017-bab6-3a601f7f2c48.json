  "id": "3975a9e0-a0c3-5017-bab6-3a601f7f2c48",
  "slug": "pickled-banana-peppers",
  "name": "Pickled Banana Peppers",
  "recipe_type": null,
  "brief_description": "These homemade pickled banana peppers are made with a pickling mixture of vinegar, sugar, garlic, and herbs for a zesty, crunchy condiment.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice tops off all peppers, then slice peppers into thin discs. Put peppers into a 6-quart jar."
    },
    {
      "position": 2,
      "text": "Mix canola oil, vinegar, water, salt, oregano, garlic, and sugar together in a large bowl until salt and sugar are dissolved. Pour over peppers in the jar; stir and refrigerator for 24 hours."
    },
    {
      "position": 3,
      "text": "Stir peppers before serving; store remaining pickled peppers in the refrigerator."
    }
  ],
  "servings": 160,

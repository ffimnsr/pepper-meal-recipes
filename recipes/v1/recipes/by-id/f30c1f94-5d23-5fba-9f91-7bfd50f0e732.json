  "id": "f30c1f94-5d23-5fba-9f91-7bfd50f0e732",
  "slug": "cream-puffs",
  "name": "Cream Puffs",
  "recipe_type": "dessert",
  "brief_description": "Cream puffs made with choux pastry that puffs up when baked; fill with vanilla cream and drizzle melted chocolate on top for a crowd-pleasing dessert.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream, milk, and pudding mix in a bowl; cover the bowl with plastic wrap and refrigerate to set."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Bring water and butter to a rolling boil in a large pot."
    },
    {
      "position": 4,
      "text": "Stir in flour and salt until the mixture forms a ball."
    },
    {
      "position": 5,
      "text": "Transfer dough to a large bowl; beat in eggs, one at a time, beating well after each using a wooden spoon or stand mixer."
    },
    {
      "position": 6,
      "text": "Drop batter by tablespoonfuls onto an ungreased baking sheet, spaced about 2 inches apart."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until puffs are golden brown and centers are dry, 20 to 25 minutes. Let puffs cool."
    },
    {
      "position": 8,
      "text": "When puffs are cool, split and fill with pudding mixture, or pipe pudding into shells use a pastry bag."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

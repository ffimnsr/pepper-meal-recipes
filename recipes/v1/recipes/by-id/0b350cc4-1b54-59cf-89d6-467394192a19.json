  "id": "0b350cc4-1b54-59cf-89d6-467394192a19",
  "slug": "petras-strawberry-shortcake",
  "name": "Petra's Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "Petra's strawberry shortcake recipe features airy sponge cake made cloud-light with whipped egg whites that pairs well with sweet, fresh strawberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries and 1 cup sugar in a bowl. Cover the bowl; refrigerate 2 hours to overnight, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Whisk flour, cornstarch, and baking powder together in a bowl; set aside. Beat egg yolks and vanilla extract together in a separate bowl until smooth; set aside."
    },
    {
      "position": 4,
      "text": "Whip egg whites in a separate bowl with an electric mixer until very stiff. Fold in remaining 1 \u00bc cups sugar, a few tablespoons at a time, until well combined. Fold in yolk mixture until mostly blended. Fold in flour mixture until just combined (a few small lumps of flour should remain). Transfer batter to the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 22 to 25 minutes. Cool for 5 minutes, invert cake onto waxed paper, cut into 8 equal pieces, and continue to cool."
    },
    {
      "position": 6,
      "text": "Whip cream and confectioners' sugar together in a bowl until soft peaks form."
    },
    {
      "position": 7,
      "text": "Halve each cake square horizontally; transfer to plates. Divide strawberries and syrup among cakes; top with cake tops. Dollop with whipped cream, then serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

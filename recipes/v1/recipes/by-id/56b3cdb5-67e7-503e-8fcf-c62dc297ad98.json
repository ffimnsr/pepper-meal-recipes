  "id": "56b3cdb5-67e7-503e-8fcf-c62dc297ad98",
  "slug": "honey-walnut-shrimp",
  "name": "Honey Walnut Shrimp",
  "recipe_type": "main",
  "brief_description": "This honey walnut shrimp is a Chinese-style recipe for crispy fried shrimp in a creamy honey-mayonnaise sauce, topped with homemade candied walnuts.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir water and sugar together in a small saucepan over high heat. Bring to a boil and add walnuts. Boil for 2 minutes, then drain and place walnuts on a cookie sheet to dry."
    },
    {
      "position": 3,
      "text": "Whip egg whites in a medium bowl until foamy. Stir in mochiko until it has a pasty consistency."
    },
    {
      "position": 4,
      "text": "Heat oil in a heavy deep skillet over medium-high heat. Dip shrimp in mochiko batter, then fry in batches in hot oil until golden brown, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Remove with a slotted spoon and drain on paper towels."
    },
    {
      "position": 6,
      "text": "Stir together mayonnaise, honey, and sweetened condensed milk in a medium serving bowl."
    },
    {
      "position": 7,
      "text": "Add fried shrimp and toss to coat with sauce. Sprinkle candied walnuts on top and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fbdc9e4a-3514-5efa-a58e-587eb425237e",
  "slug": "caramel-snickerdoodle-bars",
  "name": "Caramel Snickerdoodle Bars",
  "recipe_type": "dessert",
  "brief_description": "A layer of dulce de leche caramel in the middle of these snickerdoodle-blondie hybrid bars makes them an extra-special sweet treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper, leaving a 1-inch overhang over each side."
    },
    {
      "position": 2,
      "text": "Combine brown sugar and butter in a large bowl; beat with an electric mixer until light and fluffy. Beat in eggs and vanilla extract."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, and salt together in a separate bowl. Beat flour mixture gradually into the creamed butter mixture until batter is combined. Spread batter in the bottom of the lined baking pan."
    },
    {
      "position": 4,
      "text": "Mix white sugar and cinnamon together in a small bowl. Sprinkle 2 tablespoons of the cinnamon sugar over the batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are light brown, 25 to 30 minutes. Transfer to a wire rack to cool completely, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Spread dulce de leche over cooled crust."
    },
    {
      "position": 7,
      "text": "Combine white chocolate, heavy cream, and light corn syrup in a small saucepan. Cook and stir over low heat until smooth, about 5 minutes. Let cool slightly, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Spread white chocolate mixture over dulce de leche. Sprinkle remaining cinnamon sugar on top. Cover baking pan and refrigerate until firm, at least 1 hour."
    },
    {
      "position": 9,
      "text": "Lift out of the baking pan using the parchment paper ends. Cut into bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

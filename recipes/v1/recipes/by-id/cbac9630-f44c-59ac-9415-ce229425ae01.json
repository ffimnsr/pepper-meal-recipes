  "slug": "almond-gelatin",
  "name": "Almond Gelatin",
  "recipe_type": "salad",
  "brief_description": "A refreshing and fruity almond-flavored gelatin dessert.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine gelatin with boiling water, stirring until dissolved. Stir in sugar, milk, and almond extract. Pour into a 9 inch square pan and refrigerate overnight. Cut into cubes and serve with fruit cocktail."
    }
  ],

  "id": "d0d0f665-e6f2-59e7-8efc-001118b4c6b1",
  "slug": "vegetarian-shepherds-pie",
  "name": "Hearty Vegetarian Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This meatless comfort food is packed with high-antioxidant vegetables, plus curry's anti-cancer curcumin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees. In a large skillet over medium heat, heat 1 tablespoon oil; add onions, garlic, curry and cumin. Saut\u00e9 until onions are soft, about 5 minutes. Remove to a bowl."
    },
    {
      "position": 2,
      "text": "Heat remaining oil in skillet; add peppers, eggplant, tomatoes and 1/2 cup water. Saute until soft, about 20 minutes. Stir in onions. Place in a shallow 8-by-8- inch baking dish."
    },
    {
      "position": 3,
      "text": "In a saucepan, boil potatoes until done. Drain and smash. Stir in half and half, peas, salt and pepper. Spread over vegetables and top with Parmesan."
    },
    {
      "position": 4,
      "text": "Bake 15 minutes. Brown in broiler. Serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

  "id": "6eb53f37-cb48-5189-acf2-86598f9665dc",
  "slug": "vegan-cashew-cream-dessert",
  "name": "Vegan Cashew Cream Dessert",
  "recipe_type": "dessert",
  "brief_description": "You only need a few ingredients for this delicious raw-vegan cashew cream. After the cashews have been soaked, it takes only minutes to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover cashews with cold water in a bowl and soak for 2 to 3 hours or overnight. Drain."
    },
    {
      "position": 2,
      "text": "Combine cashews, coconut milk, agave syrup, vanilla extract, and rose water in a blender; blend until smooth. Pour into a bowl and garnish with pomegranate seeds."
    }
  ],
  "servings": 4,

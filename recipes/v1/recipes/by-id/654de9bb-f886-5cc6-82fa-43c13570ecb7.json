  "id": "654de9bb-f886-5cc6-82fa-43c13570ecb7",
  "slug": "apple-walnut-cinnamon-roll-monkey-bread",
  "name": "Apple-Walnut Cinnamon Roll Monkey Bread",
  "recipe_type": "breakfast",
  "brief_description": "Freshly minced apples and toasted walnuts fill the corners of this totally indulgent monkey bread made easy thanks to refrigerated cinnamon roll dough.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Brush the inside of a fluted tube pan with 1 tablespoon melted butter."
    },
    {
      "position": 2,
      "text": "Mix sugar, cinnamon, and nutmeg in a bowl. Combine 1/4 cup of the spiced sugar mixture with minced apples and stir until coated."
    },
    {
      "position": 3,
      "text": "Separate cinnamon roll dough rounds and cut into quarters. Set aside the icing."
    },
    {
      "position": 4,
      "text": "Spoon 1/2 of the apple mixture and 1/2 of the walnuts into the bottom of the prepared pan. Roll 1/2 of the cinnamon roll quarters in the remaining spiced sugar and place on top of the apples and walnuts. Spoon 1/2 of the remaining butter over dough. Repeat with remaining apples, walnuts, dough, and butter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 45 minutes. Let bread cool in the pan for 10 minutes, then invert onto a plate. Cool for 5 more minutes before coating with icing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "slug": "fresh-basil-pesto",
  "name": "Fresh Basil Pesto",
  "recipe_type": "side",
  "brief_description": "This basil pesto recipe with fresh basil, toasted pine nuts, Pecorino, garlic, and lemon makes a bright and nutty pasta sauce or topping for pizza.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine basil leaves, oil, pine nuts, and garlic in a food processor or blender; pur\u00e9e until smooth."
    },
    {
      "position": 3,
      "text": "Stir in Pecorino Romano cheese; season to taste with lemon juice, salt, and pepper."
    }
  ],

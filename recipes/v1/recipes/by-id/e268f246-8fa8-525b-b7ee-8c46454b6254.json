  "id": "e268f246-8fa8-525b-b7ee-8c46454b6254",
  "slug": "overnight-bacon-brunch-casserole",
  "name": "Overnight Bacon Brunch Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This make-ahead bacon casserole with brioche, eggs, and cheese is baked in the morning for a hearty and crowd-pleasing holiday breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch pan. Layer brioche cubes evenly in the prepared pan."
    },
    {
      "position": 2,
      "text": "Cook the bacon in a skillet over medium heat, stirring occasionally, until it is cooked through, about 10 minutes. Remove from heat, including any rendered bacon fat, and allow to cool slightly, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Heat a small amount of bacon fat in the same skillet over medium-high heat. Saute onion and bell pepper until soft, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat eggs in a large bowl. Mix milk, Cheddar cheese, mustard powder, pepper, and salt into the beaten eggs. Mix in bacon and onion-bell pepper mixture when done. Carefully pour the egg mixture over the brioche bread cubes and give it a gentle stir so everything is evenly distributed. Gently press the cubes into the egg mixture as needed, so all the bread cubes are sitting in the liquid. Cover and refrigerate for 8 hours, to overnight."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven on the middle rack until set, the top is browned, and a toothpick inserted into the center of the casserole comes out clean, 45 to 55 minutes. Remove from the oven and allow to cool slightly before serving, 5 to 10 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "5f588322-1a30-5efd-83c2-2a569eaf7659",
  "slug": "strawberry-brown-sugar-sour-cream-pie",
  "name": "Strawberry Brown Sugar Sour Cream Pie",
  "recipe_type": "dessert",
  "brief_description": "This strawberry brown sugar sour cream pie recipe is based on the delicious combination of fresh strawberries, dipped in sour cream, and brown sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven 450 degrees F (230 degrees C) with rack in the lowest position."
    },
    {
      "position": 2,
      "text": "Combine \u00be cup brown sugar, white sugar, sour cream, \u00bc cup flour, and egg in a bowl. Place strawberries in pie crust; spoon sour cream mixture over berries."
    },
    {
      "position": 3,
      "text": "Combine \u2153 cup brown sugar, and \u2153 cup flour in a bowl; stir in melted butter until mixture resembles coarse crumbs. Sprinkle over filling."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C). Continue baking until pie is set and golden, about 45 minutes more. Cool completely, preferably overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

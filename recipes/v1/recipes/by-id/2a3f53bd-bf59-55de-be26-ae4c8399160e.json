  "id": "2a3f53bd-bf59-55de-be26-ae4c8399160e",
  "slug": "glazed-cheese-danish-squares",
  "name": "Glazed Cheese Danish Squares",
  "recipe_type": "dessert",
  "brief_description": "Perfect for breakfast or a potluck brunch, these simple glazed Danish squares filled with cream cheese take just 15 minutes to prepare and can be eaten cold or at room temperature.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, egg, and vanilla extract in a large bowl; beat with an electric mixer until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Spread 1 can crescent roll dough onto the bottom of the prepared baking pan. Spread cream cheese mixture over top, and top with remaining can of crescent roll dough."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 30 minutes. Let cool to room temperature, at least 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, mix together powdered sugar and milk to make a glaze. Pour glaze on top of cooled Danishes and cut into squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

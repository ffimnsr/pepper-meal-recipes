  "id": "2743e4cd-2fa8-50d3-ae3b-34a9b18f5ead",
  "slug": "cookie-delight-recipe-11979256",
  "name": "Cookie Delight",
  "recipe_type": "dessert",
  "brief_description": "Cookie delight is a yummy, nostalgic no-bake dessert with layers of a chocolate cookie crust, a creamy cheesecake filling and rich pudding layers. It cuts well and is the perfect dessert to make ahead for a potluck or other gatherings. Kids of all ages will love it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine 2 cups crushed cookies and melted butter in a bowl; stir until evenly moistened. Press mixture firmly into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, 10 to 12 minutes. Remove from the oven and cool completely on a wire rack."
    },
    {
      "position": 4,
      "text": "Combine cream cheese and powdered sugar in a bowl and beat with an electric mixer on medium speed until smooth. Slowly add whipping cream and continue to beat until mixture becomes thick and soft peaks form, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Whisk together milk, cookies and cream pudding mix, and chocolate pudding mix in a separate large bowl until thickened, 2 minutes."
    },
    {
      "position": 6,
      "text": "Spread half of the cream cheese mixture evenly over the cooled crust."
    },
    {
      "position": 7,
      "text": "Spread the pudding evenly over the cream cheese layer."
    },
    {
      "position": 8,
      "text": "Spread remaining cream cheese mixture evenly over the pudding layer. Sprinkle top with remaining 1/2 cup crushed cookies and miniature chocolate chips."
    },
    {
      "position": 9,
      "text": "Cover and refrigerate until fully set, at least 8 hours or overnight."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,

  "id": "ccb54f08-d2b9-50fa-a918-a66506018070",
  "slug": "chicken-long-rice-soup",
  "name": "Chicken Long Rice Soup",
  "recipe_type": "soup",
  "brief_description": "This Hawaiian-style chicken soup has been a family favorite for many generations. The leftovers are great, and it freezes well. Even my Texas man loves it!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring chicken broth, chicken, salt, and ginger to a boil in a large pot over high heat, then reduce heat to medium-low and simmer until chicken tender and no longer pink, about 35 minutes. Remove chicken; strain broth into a new pot. Discard remaining solids."
    },
    {
      "position": 2,
      "text": "Meanwhile, place noodles in a large bowl and cover with hot water. Set aside until noodles softened, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Stir onion into broth; bring to a boil, then reduce heat to medium-low. Meanwhile, remove skin and bones from chicken; discard. Roughly chop chicken meat."
    },
    {
      "position": 4,
      "text": "After noodles sat 30 minutes, stir noodles, chicken, green onion, and bok choy into broth; simmer until noodles tender."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

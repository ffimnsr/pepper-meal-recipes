  "slug": "creole-seasoning-blend",
  "name": "Creole Seasoning Blend",
  "recipe_type": "soup",
  "brief_description": "This Creole seasoning adds amazing flavor to rice, meats, soups, and stews with a spice blend of paprika, onion, garlic, oregano, thyme, and cayenne.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine paprika, salt, onion powder, garlic powder, oregano, basil, thyme, black pepper, white pepper, and cayenne pepper."
    },
    {
      "position": 3,
      "text": "Store in an airtight container."
    }
  ],

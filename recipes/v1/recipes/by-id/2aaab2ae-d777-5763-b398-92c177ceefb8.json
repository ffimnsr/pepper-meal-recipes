  "id": "2aaab2ae-d777-5763-b398-92c177ceefb8",
  "slug": "indonesian-chicken-skewers-with-peanut-sauce-satay-ayam",
  "name": "Indonesian Chicken Skewers with Peanut Sauce (Satay Ayam)",
  "recipe_type": "appetizer",
  "brief_description": "Satay ayam is a sweet and salty Indonesian peanut sauce. Serve with pan-fried or grilled chicken skewers for an irresistible summer appetizer.",
  "cuisine": "Indonesian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken thighs, 3/4 teaspoon salt, white pepper, and sunflower seed oil in a bowl. Cover and refrigerate for 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "Soak wooden skewers in water to prevent burning during cooking."
    },
    {
      "position": 3,
      "text": "Bring water, peanut butter, kecap manis, brown sugar, garlic, and 1/2 teaspoon salt to a boil in a small saucepan; stir to combine. Remove from heat and add lime juice; transfer peanut sauce into a bowl."
    },
    {
      "position": 4,
      "text": "Thread marinated chicken onto skewers; brush 2 tablespoons of peanut sauce over chicken skewers."
    },
    {
      "position": 5,
      "text": "Heat a grill pan or large skillet over medium-high heat. Arrange chicken skewers in batches on the grill pan and cook until chicken is no longer pink in the center, 1 to 2 minutes per side. Serve skewers with remaining peanut sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

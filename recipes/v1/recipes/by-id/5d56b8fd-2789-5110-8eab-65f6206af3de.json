  "id": "5d56b8fd-2789-5110-8eab-65f6206af3de",
  "slug": "monikas-omas-lebkuchen-men",
  "name": "Monika's Oma's Lebkuchen Men",
  "recipe_type": "dessert",
  "brief_description": "Cinnamon, cloves, and honey flavor these classic German gingerbread (lebkuchen) men that you can hang as Christmas decorations or nibble on!",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two baking sheets."
    },
    {
      "position": 2,
      "text": "Mix ground almonds, flour, white sugar, 2 teaspoons cocoa powder, cinnamon, cloves, baking powder, and salt together in a large bowl. Use your fingers or a pastry blender to rub in the butter until mixture resembles fine crumbs. Add honey and egg; mix together to form a dough."
    },
    {
      "position": 3,
      "text": "Dust work surface with flour. Roll out dough into a circle about 1/8-inch thick. Cut into gingerbread men shapes with a floured cookie cutter. Place 2 inches apart on baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are brown, 15 to 20 minutes. Cool in the pan 1 to 2 minutes before transferring to a wire rack to cool completely, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Combine confectioners' sugar and 2 tablespoons cocoa powder in a bowl. Mix in enough boiling water to make a smooth and spreadable icing. Spread icing on cooled cookies using a table knife. Set aside until icing hardens, about 2 hours."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

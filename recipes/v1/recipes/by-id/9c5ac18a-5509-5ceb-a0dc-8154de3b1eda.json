  "id": "9c5ac18a-5509-5ceb-a0dc-8154de3b1eda",
  "slug": "no-bake-espresso-martini-cheesecakes-recipe-8777811",
  "name": "No Bake Espresso Martini Cheesecakes",
  "recipe_type": "dessert",
  "brief_description": "These no bake espresso martini cheesecakes have a base layer of crushed OREO cookies, topped with a sumptuous dark chocolate no-bake cheesecake, served in martini glasses.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt chocolate chips in a microwave-safe bowl in the microwave until just melted, 1 to 2 minutes, stirring every 15 seconds. Set aside to cool completely to room temperature."
    },
    {
      "position": 2,
      "text": "Pulse cookies in a food processor until fine crumbs form. Add melted butter and pulse until just moistened. Divide cookie mixture between 6 martini glasses or small dessert bowls and refrigerate while filling is prepared."
    },
    {
      "position": 3,
      "text": "Stir together espresso and hot water in a mixing bowl until espresso is dissolved. Add in cocoa powder and Kahlua and stir until thickened. Add cream cheese and sugar and beat on medium speed with an electric mixer until smooth and creamy, about 2 minutes. Add cooled melted chocolate and mix until just combined."
    },
    {
      "position": 4,
      "text": "Fold whipped topping into cream cheese mixture until just combined. Divide mixture among glasses and smooth the top. Cheesecake is best if refrigerated for at least 2 hours."
    },
    {
      "position": 5,
      "text": "Serve with a sprinkle of cocoa powder and garnish with an espresso bean, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

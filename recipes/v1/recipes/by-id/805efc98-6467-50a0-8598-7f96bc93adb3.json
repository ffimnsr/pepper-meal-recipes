  "id": "805efc98-6467-50a0-8598-7f96bc93adb3",
  "slug": "vanilla-ice-cream",
  "name": "Vanilla Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "Try this easy vanilla ice cream recipe that blends heavy cream, half-and-half, sugar, and vanilla extract into a deliciously decadent dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk heavy cream and half-and-half together in a large bowl."
    },
    {
      "position": 3,
      "text": "Gradually whisk in sugar until blended, then whisk in vanilla."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate until very cold, at least 3 hours or up to 3 days."
    },
    {
      "position": 5,
      "text": "Remove from the refrigerator and whisk mixture to blend."
    },
    {
      "position": 6,
      "text": "Pour into an ice cream maker and freeze according to the manufacturer's instructions, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Transfer to an airtight container and freeze until firm, about 4 hours."
    }
  ],
  "servings": 8,

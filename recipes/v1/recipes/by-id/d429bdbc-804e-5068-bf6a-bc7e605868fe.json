  "slug": "walnut-pesto",
  "name": "Walnut Pesto",
  "recipe_type": "drink",
  "brief_description": "This walnut pesto sauce is easy to make by blending basil leaves, walnuts, garlic, and lemon juice for a delicious alternative to pine nut pesto.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Blend basil, walnuts, olive oil, garlic, and lemon juice together in a food processor until pesto has a paste-like consistency."
    }

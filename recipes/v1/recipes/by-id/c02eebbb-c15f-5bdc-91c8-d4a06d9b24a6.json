{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c02eebbb-c15f-5bdc-91c8-d4a06d9b24a6",
  "slug": "caesar-potato-salad",
  "name": "Caesar Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This warm potato salad with Caesar salad dressing, crispy bacon, potatoes, and green onion is super easy to make for a delightful summer salad dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, occasionally turning, until evenly browned, about 10 minutes. Drain bacon slices on paper towels and crumble."
    },
    {
      "position": 3,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until slightly tender, about 8 minutes. Drain and transfer potatoes to a baking dish. Drizzle olive oil over potatoes and season with black pepper."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tender, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Mix potatoes, bacon bits, Caesar salad dressing, and green onions together in a bowl. Serve warm."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

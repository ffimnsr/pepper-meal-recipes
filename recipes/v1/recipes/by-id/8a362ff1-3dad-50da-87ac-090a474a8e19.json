  "id": "8a362ff1-3dad-50da-87ac-090a474a8e19",
  "slug": "kale-and-roasted-delicata-squash-salad-with-pomegranate-vinaigrette-recipe-8780013",
  "name": "Kale and Roasted Delicata Squash Salad with Pomegranate Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This kale and roasted delicata squash salad pairs tender squash, crisp pear, pomegranate, bacon, and almonds with a tangy pomegranate vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a sheet pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Split delicata squash lengthwise and scoop out seeds and strands. Cut each squash half crosswise into 1/2-inch-thick slices. Place squash pieces in a bowl and toss with olive oil, salt, black pepper, and ginger. Arrange on the prepared pan in a single layer."
    },
    {
      "position": 3,
      "text": "Roast squash in the preheated oven for 8 to 10 minutes. Using tongs, turn each piece and continue to roast until squash is tender and lightly browned, 8 to 10 minutes more. Set aside to cool."
    },
    {
      "position": 4,
      "text": "For the vinaigrette: Add pomegranate juice, olive oil, balsamic vinegar, Dijon mustard, honey, salt, white pepper, and cayenne to a jar with a tight-fitting lid. Cover and shake until well blended, about 30 seconds."
    },
    {
      "position": 5,
      "text": "For the salad: Place kale, pear slices, pomegranate arils, and red onion in a large salad bowl. Cut squash into bite-sized pieces; add to the bowl. Shake vinaigrette again, then toss with salad."
    },
    {
      "position": 6,
      "text": "Arrange salad on 4 plates and top with sliced almonds and crumbled bacon; garnish with cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

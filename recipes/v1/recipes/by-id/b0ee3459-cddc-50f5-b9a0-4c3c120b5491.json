  "id": "b0ee3459-cddc-50f5-b9a0-4c3c120b5491",
  "slug": "oven-scrambled-eggs",
  "name": "Baked Scrambled Eggs",
  "recipe_type": "breakfast",
  "brief_description": "Baked scrambled eggs are quick to make in the oven and turn out light and fluffy every time. An easy, hands-off dish that\u2019s perfect for a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour melted butter into a 9x13-inch glass baking dish."
    },
    {
      "position": 3,
      "text": "Whisk eggs and salt together in a large bowl until well blended. Gradually whisk in milk. Pour egg mixture into the buttered dish."
    },
    {
      "position": 4,
      "text": "Bake uncovered in the preheated oven for 10 to 15 minutes. Stir egg mixture and continue to bake about 10 minutes more; stir again. Continue to bake until until eggs are just set and no longer runny, about 5 more minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "1306753a-16fe-5219-bb6f-c2822962e90e",
  "slug": "carries-artichoke-and-sun-dried-tomato-pasta",
  "name": "Carrie's Artichoke and Sun-Dried Tomato Pasta",
  "recipe_type": "main",
  "brief_description": "This sun-dried tomato and artichoke pasta is tossed in a wine-based sauce made with garlic, mushrooms, and olives. Add shrimp or chicken if you like!",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring it to a rolling boil. Keep at a boil until needed."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter over medium heat in a large saucepan. Add mushrooms, onion, and garlic; cook and stir until tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in artichoke hearts, sun-dried tomatoes in oil, and olives, then pour in wine and lemon juice; bring to a boil. Reduce the heat and simmer until liquid is reduced by a third, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Just before sauce is ready, cook fettucine in the boiling water until tender yet firm to the bite, about 2 minutes. Drain."
    },
    {
      "position": 5,
      "text": "Toss fettuccine with sauce. Top with Parmesan cheese and tomato; season with pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

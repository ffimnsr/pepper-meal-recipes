  "id": "dac8e6ef-b6be-5483-869c-2a82512ab910",
  "slug": "instant-pot-chicago-beef-recipe-8696994",
  "name": "Instant Pot Chicago Beef",
  "recipe_type": "main",
  "brief_description": "This Instant Pot Chicago beef takes a tougher cut of beef, beef chuck, and turns it into the best ever working man\u2019s hoagie, a Chicago beef sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season beef with salt, black pepper, dried oregano, garlic powder, onion powder, red pepper, paprika."
    },
    {
      "position": 2,
      "text": "Turn the Instant oPt setting to High Saute setting; add oil. Add seasoned beef and sear on both sides for 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove beef, and add onion, garlic, and Fresno chili. Deglaze the pot with 2 cups beef stock, and add sport pepper juice, bay leaf, and thyme. Return the meat to the Instant Pot."
    },
    {
      "position": 4,
      "text": "Place the lid on the pot and cook on High Pressure for 4 minutes, then set the pot to the Keep Warm setting, and leave it for 40 minutes."
    },
    {
      "position": 5,
      "text": "Take the meat out and slice thin. Strain the braising liquid, and place braising liquid and sliced meat back into the pot. Add remaining 1 cup broth to the pot."
    },
    {
      "position": 6,
      "text": "If desired, dip the inner face of split hoagie rolls in the braising liquid. Add meat to hoagie rolls. Garnish with chopped giardiniera and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

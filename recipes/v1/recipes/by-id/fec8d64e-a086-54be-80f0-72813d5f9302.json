  "id": "fec8d64e-a086-54be-80f0-72813d5f9302",
  "slug": "asian-style-country-ribs",
  "name": "Asian Style Country Ribs",
  "recipe_type": "main",
  "brief_description": "this is a super slow cooker recipe for country ribs that is tasty, versatile, and EASY! Serve with sushi rice and your favorite stir-fry vegetables.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together the brown sugar, soy sauce, sesame oil, olive oil, rice vinegar, lime juice, garlic, ginger, and Sriracha in the crock of a slow cooker. Add the ribs; cover and refrigerate. Allow ribs to marinate in the refrigerator for 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "Before cooking, drain marinade and discard. Cook on Low for 9 hours. Drain cooked meat and shred, using 2 forks."
    }
  ],
  "servings": 6,

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3199b4f6-70cd-5624-8c4c-d6e7d195f116",
  "slug": "gingerbread-cookies-with-cream-cheese-frosting",
  "name": "Gingerbread Cookies with Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "For your next holiday cookie swap, bake a batch of these gingerbread cookies frosted with cream cheese frosting and partially sweetened with stevia.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, whisk together flour, cinnamon, baking soda, salt, allspice, nutmeg, and cloves."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together brown sugar, stevia, molasses, applesauce, ginger, and egg. Fold dry ingredients into wet ingredients just until combined. Cover and refrigerate at least 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F. Line a large baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Use a tablespoon to scoop out dough. Roll dough into balls. Place on the baking sheet 1 inch apart. Very slightly flatten cookies with your palm."
    },
    {
      "position": 5,
      "text": "Bake until puffy and set, 12 to 15 minutes. Let cool completely."
    },
    {
      "position": 6,
      "text": "For frosting, in a large bowl or the bowl of a stand mixer fitted with the paddle attachment, beat cream cheese on medium speed until very smooth. With mixer running, add butter a little at a time, beating constantly. Add powdered sugar, stevia, and vanilla and beat just until smooth."
    },
    {
      "position": 7,
      "text": "Use a small offset spatula to spread frosting on top of cookies."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

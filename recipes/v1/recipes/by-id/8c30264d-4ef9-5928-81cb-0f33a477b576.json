  "id": "8c30264d-4ef9-5928-81cb-0f33a477b576",
  "slug": "skillet-baked-beans",
  "name": "Skillet Baked Beans",
  "recipe_type": "side",
  "brief_description": "This skillet baked beans recipe combines canned pork and beans, crispy bacon, onion, sugar, molasses, and mustard for a quick and easy barbecue side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large skillet over medium-high heat, stirring occasionally, until crisp, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir pork and beans, onion, brown sugar, molasses, and mustard into bacon in the skillet; bring to a boil, reduce heat to medium-low, and simmer, stirring occasionally, until thickened, 15 to 20 minutes."
    }
  ],

  "slug": "awesome-slow-cooker-pot-roast-plus-extras",
  "name": "Awesome Slow Cooker Pot Roast Plus Extras Recipe",
  "recipe_type": "soup",
  "brief_description": "This awesome slow cooker pot roast plus extras recipe simmers a beef roast in cream of mushroom soup and an array of vegetables for a hearty one-pot meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soup, water, and onion soup mix in a slow cooker. Add pot roast to the slow cooker; spoon soup mixture over top. Add potatoes, carrots, squash, and zucchini. Cover the slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on High until the roast is cooked through, 3 to 4 hours (or on Low for 5 to 6 hours). An instant-read thermometer inserted into center should read 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 16,

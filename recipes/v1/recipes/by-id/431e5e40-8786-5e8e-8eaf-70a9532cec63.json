  "id": "431e5e40-8786-5e8e-8eaf-70a9532cec63",
  "slug": "easy-drop-beignets",
  "name": "Easy Drop Beignets",
  "recipe_type": "dessert",
  "brief_description": "This easy recipe for beignets without yeast do not require rolling or cutting; spoonfuls of dough are simply dropped into hot oil for frying.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, water, milk, egg, baking powder, sugar, and salt in a large mixing bowl. Mix until smooth."
    },
    {
      "position": 2,
      "text": "Pour oil into a deep skillet or pot and heat over medium-high heat to 360 degrees F (180 degrees C)."
    },
    {
      "position": 3,
      "text": "Drop spoonfuls of batter into hot oil. Fry, turning once, until they rise to the surface and turn golden brown and puffy, 3 to 5 minutes per batch. Drain on paper towels."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

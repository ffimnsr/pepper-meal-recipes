  "id": "77c7a444-87dc-5993-a55f-4e1be5228d98",
  "slug": "vickis-hush-puppies",
  "name": "Vicki's Hush Puppies",
  "recipe_type": "appetizer",
  "brief_description": "This homemade hush puppies recipe combines cornmeal and flour with eggs and diced onion, then deep-fries the hush puppies until golden and crisp.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 2 inches oil in a deep saucepan over medium heat to 365 degrees F (185 degrees C)."
    },
    {
      "position": 3,
      "text": "While oil is heating, mix together onion, sugar, and eggs in a medium bowl. Blend in flour and cornmeal to make a batter."
    },
    {
      "position": 4,
      "text": "Drop batter by rounded teaspoonfuls, 4 at a time, into hot oil and fry until golden brown, 1 to 2 minutes per side. Transfer to a paper towel-lined plate to drain."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

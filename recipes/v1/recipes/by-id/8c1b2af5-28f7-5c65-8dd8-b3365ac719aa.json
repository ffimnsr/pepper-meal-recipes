  "id": "8c1b2af5-28f7-5c65-8dd8-b3365ac719aa",
  "slug": "pot-roast-in-foil",
  "name": "Pot Roast in Foil",
  "recipe_type": "main",
  "brief_description": "This basic recipe is recommended for blushing brides and other beginners. Vegetables, such as carrots, potatoes, and celery can be done along with the roast, if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Place a piece of foil, about 30 inches long, into the bottom of a 9x13 inch roasting pan. Place the roast on the foil in the pan."
    },
    {
      "position": 3,
      "text": "In a separate small bowl, combine the mushroom soup with the onion soup mix. Mix well and pour over the roast. Sprinkle with the water. Fold foil over and seal all edges."
    },
    {
      "position": 4,
      "text": "Bake at 300 degrees F (150 degrees C) for 4 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 10,

  "id": "86128e3a-4bc3-553d-8e8d-5236e3d51c72",
  "slug": "cathead-biscuits",
  "name": "Cathead Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "This is the old-time recipe from our grandmamas. Wonderful and tasty heavy biscuit. Great with homemade sausage gravy.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 475 degrees F (245 degrees C). Grease an 8-inch cake pan."
    },
    {
      "position": 2,
      "text": "Sift flour and salt together into a large mixing bowl. Make a dent in flour by pushing flour from center toward sides of bowl. Add 2 walnut-size lumps of shortening and a splash of buttermilk to the flour where you made the dent. Work the shortening into the flour using fingers in a twisting motion (rub thumb against pointer and middle finger motion) until the shortening is fully incorporated into the flour."
    },
    {
      "position": 3,
      "text": "Pour buttermilk into the flour about 1/4 cup at a time, continuing to work it in with your fingers until the buttermilk is completely incorporated into a sticky dough."
    },
    {
      "position": 4,
      "text": "Roll dough into 8 large balls and drop into prepared cake pan, working around the outside and putting the last one in middle to fill the pan. Press dough balls with back of fingers to flatten until they touch and are about 3/4- to 1-inch thick."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until the tops are golden brown, 15 to 20 minutes. Brush tops with melted butter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "68a83a87-318e-5340-9d80-995f8a366c13",
  "slug": "summertime-sweet-pickles",
  "name": "Summertime Sweet Pickles",
  "recipe_type": "dessert",
  "brief_description": "Follow this easy sweet pickle recipe the next time you have a bumper crop of cucumbers in your garden. They're perfect for snacking and gifting!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect a 1-quart jar for cracks, then immerse in simmering water until needed. Wash a new, unused lid and ring in warm soapy water."
    },
    {
      "position": 2,
      "text": "Bring cider vinegar, sugar, salt, mustard seed, and turmeric to a boil in a small saucepan over medium-high heat. Boil for 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, slice cucumbers and onions. Loosely pack vegetables in the sterilized jar."
    },
    {
      "position": 4,
      "text": "Pour hot brine over vegetables. Seal the jar and refrigerate for 24 hours before eating."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

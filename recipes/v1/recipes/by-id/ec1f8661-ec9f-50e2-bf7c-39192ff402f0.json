  "id": "ec1f8661-ec9f-50e2-bf7c-39192ff402f0",
  "slug": "zucchini-raisin-muffins",
  "name": "Zucchini Raisin Muffins",
  "recipe_type": "dessert",
  "brief_description": "Loaded with zucchini and raisins, this recipe for nutmeg-scented muffins is moist and perfectly sweet \u2014 they're a perfect grab-and-go breakfast or snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, salt, nutmeg, baking soda, and baking powder together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Beat sugar, oil, and egg together in a large bowl with an electric mixer until well mixed; fold in zucchini and raisins, then stir in flour mixture until combined. Spoon batter into the prepared muffin cups, filling each about \u2154 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until muffins are golden and the tops spring back when lightly pressed, about 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

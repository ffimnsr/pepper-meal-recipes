  "id": "ef8d27a8-14f9-5283-92d5-259f40527836",
  "slug": "make-ahead-steel-cut-oats",
  "name": "Make-Ahead Steel-Cut Oats",
  "recipe_type": "breakfast",
  "brief_description": "Steel-cut oats are cooked on the stovetop and blended with raisins, walnuts, and spices before they're refrigerated overnight for a hearty make-ahead breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and salt to a boil in a pot. Pour in oats and return to a boil while stirring. Reduce heat and let simmer until water is absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Remove oats from heat and immediately stir in walnuts and raisins. Stir in agave nectar, vanilla extract, and cinnamon."
    },
    {
      "position": 3,
      "text": "Divide oat mixture into 4 portions in bowls. Cover and refrigerate overnight, or up to 5 days."
    },
    {
      "position": 4,
      "text": "When ready to prepare, add 2 tablespoons milk to each portion. Heat in a microwave for 1 minute and 30 seconds, stirring halfway through cook time."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

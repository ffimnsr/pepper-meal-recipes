  "id": "2cf80ddb-0580-5604-9431-bebb5782349c",
  "slug": "savory-chicken-brine",
  "name": "Savory Chicken Brine",
  "recipe_type": "main",
  "brief_description": "Brining a chicken with soy sauce makes a juicier and more flavorful chicken. Great for baked, grilled or fried chicken.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Remove giblets from chicken cavity, rinse chicken inside and out."
    },
    {
      "position": 2,
      "text": "In a large stock pot or container, mix water, sage, celery seed, thyme, salt, sugar and soy sauce to create brine. Stir well until the sugar and salt are dissolved. Place the chicken in the brine, cover and refrigerate for at least 4 hours or overnight."
    },
    {
      "position": 3,
      "text": "Remove chicken from the brine and rinse well inside and out. Sprinkle with 2 tablespoons of seasoned salt. Bake the chicken at 400 degrees F for 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,

  "id": "e6919a15-a5d4-51b7-90af-60714bd061a4",
  "slug": "chicken-bacon-ranch-potato-casserole-recipe-11730220",
  "name": "Chicken Bacon Ranch Potato Casserole",
  "recipe_type": "side",
  "brief_description": "This chicken bacon ranch potato casserole is creamy, gooey, and savory\u2014a favorite in our house, and it will surely be in yours, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a 9x13-inch baking dish with cooking spray or grease the dish."
    },
    {
      "position": 2,
      "text": "Add diced potatoes to a large pot of cold water (salted if desired). Bring potatoes to a boil over high heat. Cook until fork tender, 8 to 10 minutes. Drain potatoes and then return to the pot."
    },
    {
      "position": 3,
      "text": "Add diced chicken breast, bacon, 1 cup Cheddar Jack cheese, ranch dressing mix, mayonnaise, sour cream, and heavy cream to the pot with drained potatoes. Stir until well combined."
    },
    {
      "position": 4,
      "text": "Transfer potato mixture to the prepared baking dish; sprinkle the casserole with remaining 1 cup Cheddar Jack cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly and the cheese is melted, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

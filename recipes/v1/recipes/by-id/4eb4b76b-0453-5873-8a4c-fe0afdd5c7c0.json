  "id": "4eb4b76b-0453-5873-8a4c-fe0afdd5c7c0",
  "slug": "best-marinara-sauce-yet",
  "name": "Best Marinara Sauce Yet",
  "recipe_type": null,
  "brief_description": "This marinara sauce recipe is a delicious blend of tomatoes, parsley, garlic, and oregano simmered with onion and white wine for amazing flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place tomatoes, tomato paste, parsley, garlic, oregano, salt, and pepper in a food processor; blend until smooth."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add onion and cook until slightly softened, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir in blended tomato sauce and white wine."
    },
    {
      "position": 4,
      "text": "Simmer, stirring occasionally, until sauce has thickened, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

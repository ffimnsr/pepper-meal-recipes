  "slug": "sun-dried-tomato-high-protein-hummus-recipe-11930004",
  "name": "Sun-Dried Tomato High Protein Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This sun-dried tomato high-protein hummus is a tasty snack to help you hit your daily protein goal with no sacrifice of flavor. Cottage cheese adds to the creamy texture, but does not change the incredible flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add chickpeas, cottage cheese, sun-dried tomatoes, basil, tahini, garlic, lemon juice, and sun-dried tomato oil to a food processor or powerful blender. Blend for 2 to 3 minutes until you get a creamy and smooth consistency. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "If necessary, add reserved chickpea water (aquafaba), 1 tablespoon at a time, blending until you reach your desired consistency. Taste, and adjust seasonings, if needed. Store in an airtight container in the refrigerator."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": null,

  "id": "a719e8ff-65c2-5efb-b553-705409c78225",
  "slug": "cinnamon-crinkles",
  "name": "Cinnamon Crinkles",
  "recipe_type": "dessert",
  "brief_description": "Spicy cinnamon harmonizes with the mellow flavor of Duncan Hines French Vanilla Cake Mix. Choose your favorite nut - almonds or pecans - and you've got a big hit with these little Cinnamon Crinkles.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F. Combine sugar and cinnamon in small bowl. Set aside. Combine egg whites and water in another small bowl; beat lightly with fork. Set aside."
    },
    {
      "position": 2,
      "text": "Combine butter, egg yolks and vanilla extract in large bowl. Blend in cake mix gradually. Beat at low speed with electric mixer until blended. Roll 1 rounded teaspoon of dough into ball. Dip half the ball into egg white mixture then into cinnamon-sugar mixture. Place ball sugar side up on ungreased baking sheet. Press nut on top. Repeat with remaining dough, placing balls 2-inches apart."
    },
    {
      "position": 3,
      "text": "Bake at 375 degrees F for 9 to 12 minutes or until edges are light golden brown. Cool 2 minutes on baking sheets. Remove to cooling racks. Store in airtight container."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

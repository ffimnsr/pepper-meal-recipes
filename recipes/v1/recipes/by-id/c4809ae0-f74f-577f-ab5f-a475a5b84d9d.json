{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c4809ae0-f74f-577f-ab5f-a475a5b84d9d",
  "slug": "frozen-yogurt-bars-with-berries-recipe-12027747",
  "name": "Frozen Yogurt Bars with Berries",
  "recipe_type": "dessert",
  "brief_description": "These frozen yogurt bars with berries are an easy make-ahead treat that comes together in just minutes before freezing until firm. Layered with creamy yogurt and fresh berries, they\u2019re fun to customize with your favorite fruit, spices, or citrus zest for a light, refreshing treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8 1/2x4 1/2-inch loaf pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Stir yogurt, almond butter, maple syrup, vanilla, cinnamon, nutmeg, and salt together in a bowl until completely smooth and combined. Spread half of the mixture evenly into the bottom of the prepared loaf pan. Sprinkle berries evenly over the yogurt. Top with remaining yogurt and carefully spread into an even layer over berries. Tap pan on the counter several times to help the mixture settle."
    },
    {
      "position": 3,
      "text": "Cover pan with aluminum foil and place into the freezer until firm, at least 4 hours."
    },
    {
      "position": 4,
      "text": "Remove pan from the freezer. Remove bars from the pan using the parchment overhang, and place onto a cutting board. Carefully peel off the parchment. Run the blade of a sharp knife under hot water, and wipe dry. Cut the bars into about 3/4-inch thick slabs. Serve immediately, or keep stored in an airtight container in the freezer until ready to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "slug": "blackened-seasoning-mix",
  "name": "Blackened Seasoning Mix",
  "recipe_type": "side",
  "brief_description": "This blackened seasoning recipe uses just 8 pantry ingredients to make a delicious homemade, salt-free Cajun seasoning mix great on grilled meats.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together paprika, garlic powder, onion powder, thyme, black pepper, cayenne pepper, basil, and oregano in a bowl until evenly mixed."
    },
    {
      "position": 3,
      "text": "Store in an airtight container in a cool, dry place."
    }
  ],
  "servings": 12,

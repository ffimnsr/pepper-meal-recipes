  "schema_version": 1,
  "id": "5da2d2c0-ca56-5871-a8b5-d9526ecd5fb4",
  "slug": "instant-pot-mushroom-risotto",
  "name": "Instant Pot Mushroom Risotto",
  "recipe_type": "main",
  "brief_description": "This creamy Instant Pot risotto is easy to make in your pressure cooker with little effort and minimal stirring required for a delicious meal anytime!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Sauté function. Add butter and olive oil; stir until butter melts, about 2 minutes. Add mushrooms; cook, stirring occasionally, until slightly softened, about 3 minutes. Stir in onion; cook for 2 minutes. Add rosemary sprig; cook for 1 minute."
    },
    {
      "position": 2,
      "text": "Stir rice into the Pot until each grain is coated with butter and olive oil mixture, about 2 minutes. Pour in wine; simmer for 3 minutes."
    },
    {
      "position": 3,
      "text": "Pour in stock, stirring to scrape the sides of the Pot; simmer for 1 minute."
    },
    {
      "position": 4,
      "text": "Close and lock the lid; turn the venting knob to sealing. Select high pressure according to manufacturer's instructions; set timer for 6 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure carefully using the quick-release method according to the manufacturer’s instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 6,
      "text": "Stir risotto until creamy, about 1 minute. Discard rosemary sprig. Season with salt and black pepper; stir in Parmesan cheese until melted and combined."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

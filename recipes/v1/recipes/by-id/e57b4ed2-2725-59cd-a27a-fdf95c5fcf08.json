  "id": "e57b4ed2-2725-59cd-a27a-fdf95c5fcf08",
  "slug": "creamy-crockpot-macaroni-and-cheese-recipe-8661631",
  "name": "Creamy Crockpot Macaroni and Cheese",
  "recipe_type": "side",
  "brief_description": "This supremely creamy crockpot macaroni and cheese is the way to go when you'd rather not have the oven on. It's as rich as baked macaroni and cheese, without the heat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil over high heat; add macaroni and salt. Cook pasta until just barely tender, about 5 minutes. Drain and rinse with cold water to stop the cooking process."
    },
    {
      "position": 2,
      "text": "Spray the inside of a slow cooker with cooking spray. Add drained pasta to the slow cooker and stir in milk, evaporated milk, butter, cream cheese and pepper. Whisk together egg and egg yolk in a small bowl until well combined; stir into pasta mixture. Set aside 3/4 cup shredded cheese. Stir remaining cheese into pasta mixture, cover, and cook on Low until bubbly and lightly browned around the edges, about 1 \u00bd hours."
    },
    {
      "position": 3,
      "text": "Sprinkle with reserved cheese, cover, and cook until cheese is melted, about 15 minutes more. Serve immediately. Alternatively, turn crockpot to Warm or Off until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

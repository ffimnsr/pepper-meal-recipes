{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "014a26e4-3f3b-5757-af01-cfc6c7c7d217",
  "slug": "creme-brulee-brownies-recipe-11908391",
  "name": "Cr\u00e8me Br\u00fbl\u00e9e Brownies",
  "recipe_type": "dessert",
  "brief_description": "These creme brulee brownies taste even better than they look. Use a brownie mix to simplify the process, and torch the pudding topping on each brownie just before serving. The crackly top and creamy inside are over the top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C), or as specified by the brownie mix you are using. Line a 9x9-inch baking pan with parchment and grease with cooking spray."
    },
    {
      "position": 2,
      "text": "Prepare brownie batter as directed on the box, add to the pan, and spread in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven according to package directions. Set aside to cool."
    },
    {
      "position": 4,
      "text": "Meanwhile, for the pudding, whisk together eggs, 3/4 cup sugar, salt, and cornstarch in a bowl."
    },
    {
      "position": 5,
      "text": "Pour milk and cream into a saucepan. Add remaining 1/4 cup sugar and place over medium-low heat."
    },
    {
      "position": 6,
      "text": "When milk just begins to simmer, remove from heat. Whisk about half the milk into egg mixture. Stir in vanilla bean paste."
    },
    {
      "position": 7,
      "text": "Pour egg mixture into the pot and whisk until combined. Cook over low-medium heat until thickened into a pudding, 5 to 6 minutes. Remove from heat and stir in butter until melted and smooth. Optional: pass the pudding through a fine mesh strainer for a smoother consistency."
    },
    {
      "position": 8,
      "text": "Spread pudding on top of brownies in an even layer. Press a piece of plastic wrap directly on the surface and refrigerate until set, 2 to 3 hours."
    },
    {
      "position": 9,
      "text": "When ready to serve, slice brownies into 12 rectangles. Sprinkle a generous layer of sugar (1 to 2 teaspoons) on each brownie and use a kitchen torch to caramelize the top for about 30 seconds. Let cool slightly before serving. Repeat with remaining brownies."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

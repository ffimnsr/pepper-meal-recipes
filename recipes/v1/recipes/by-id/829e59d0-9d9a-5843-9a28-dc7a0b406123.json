{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "829e59d0-9d9a-5843-9a28-dc7a0b406123",
  "slug": "veggie-breakfast-egg-bake-recipe-11785580",
  "name": "Veggie Breakfast Egg Bake",
  "recipe_type": "breakfast",
  "brief_description": "This colorful veggie breakfast egg bake is tasty and versatile. You can use different vegetables depending on your preference.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 425 degrees F (218 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place potatoes on the baking sheet and toss with olive oil, salt, and several grinds of pepper. Spread out evenly on the baking sheet and roast until tender and browned, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with olive oil. Whisk together eggs, milk, and \u00bc teaspoon salt in a large bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Add onion and season with 1 teaspoon salt, and several grinds of pepper. Cook, stirring occasionally, until onion is soft and translucent, 5 to 8 minutes. Add bell peppers and garlic; cook, stirring occasionally, for 2 minutes. Add spinach and \u00bd of the green onions and toss until spinach is just wilted."
    },
    {
      "position": 5,
      "text": "Spread out potatoes in an even layer in the prepared baking dish. Top with 1 cup Cheddar cheese, followed by the saut\u00e9ed veggies. Pour egg mixture on top and sprinkle with remaining \u00bd cup Cheddar cheese and green onions."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until eggs are set, 40 to 45 minutes."
    },
    {
      "position": 7,
      "text": "Let stand for 5 minutes before slicing and serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

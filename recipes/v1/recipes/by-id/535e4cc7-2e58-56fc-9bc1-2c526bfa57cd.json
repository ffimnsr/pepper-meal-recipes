  "id": "535e4cc7-2e58-56fc-9bc1-2c526bfa57cd",
  "slug": "tuna-macaroni-salad",
  "name": "Tuna Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "A creamy and refreshing pasta salad made with elbow macaroni, tuna, and mayonnaise. Perfect as a side dish or light meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Prepare the macaroni by boiling water in a cooking pot."
    },
    {
      "position": 2,
      "text": "Once the water starts to boil, add the macaroni. Let the water reboil. Continue to boil in medium heat for 7 minutes. Note: Gently stir once every minute when boiling."
    },
    {
      "position": 3,
      "text": "Drain the water. Let the macaroni cool down."
    },
    {
      "position": 4,
      "text": "Arrange the macaroni in a large mixing bowl."
    },
    {
      "position": 5,
      "text": "Add all the remaining ingredients, including Lady's Choice Mayonnaise. Toss until all ingredients are well blended."
    },
    {
      "position": 6,
      "text": "Cover the bowl. Refrigerate for at least 1 hour."
    },
    {
      "position": 7,
      "text": "Serve."
    },
    {
      "position": 8,
      "text": "Share and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 10,

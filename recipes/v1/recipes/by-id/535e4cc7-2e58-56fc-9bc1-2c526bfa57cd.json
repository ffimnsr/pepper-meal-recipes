  "id": "535e4cc7-2e58-56fc-9bc1-2c526bfa57cd",
  "slug": "tuna-macaroni-salad",
  "name": "Easy Tuna Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "Cooked macaroni is tossed with your favorite Italian dressing, then marinated overnight, for a creamy tuna-mac salad with loads of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook macaroni in a large pot of boiling salted water until done. Drain."
    },
    {
      "position": 2,
      "text": "Marinate macaroni in Italian dressing for 2 to 3 hours or overnight."
    },
    {
      "position": 3,
      "text": "Mix sour cream, mayonnaise, onion, celery, garlic powder, tuna, and salt and pepper into macaroni. Chill before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

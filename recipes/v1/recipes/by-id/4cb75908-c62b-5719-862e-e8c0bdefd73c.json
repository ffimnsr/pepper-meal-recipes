  "schema_version": 1,
  "id": "4cb75908-c62b-5719-862e-e8c0bdefd73c",
  "slug": "indian-butter-chicken-chicken-makhani",
  "name": "Butter Chicken (Murgh Makhani)",
  "recipe_type": "main",
  "brief_description": "This butter chicken recipe is rich, creamy, and easy to make at home. Serve this tasty curry with rice and naan for a restaurant-worthy Indian meal.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Make a spice mix by combining garam masala, tandoori masala, curry powder, cumin, cardamom, cayenne, salt, and black pepper in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Place chicken in a large bowl and add 1/2 of the spice mixture; turn to coat evenly."
    },
    {
      "position": 4,
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat. Add chicken; cook and stir until lightly browned, about 10 minutes. Remove from heat."
    },
    {
      "position": 5,
      "text": "Melt remaining 2 tablespoons butter in a large saucepan over medium heat. Add onion; cook and stir until soft and translucent, about 5 minutes. Stir in remainder of the spice mixture, garlic, lemon juice, and ginger; cook and stir until combined, about 1 minute."
    },
    {
      "position": 6,
      "text": "Stir tomato puree into onion mixture and cook, stirring frequently, about 2 minutes. Pour in half-and-half and yogurt. Reduce heat to low and simmer sauce, stirring frequently, about 10 minutes. Remove from heat."
    },
    {
      "position": 7,
      "text": "Blend cashews in a blender until finely ground. Add sauce to the blender; puree until smooth."
    },
    {
      "position": 8,
      "text": "Pour blended sauce over chicken in the skillet. Simmer until thickened, 10 to 15 minutes. Garnish with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

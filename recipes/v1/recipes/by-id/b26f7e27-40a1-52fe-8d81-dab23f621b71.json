  "id": "b26f7e27-40a1-52fe-8d81-dab23f621b71",
  "slug": "mason-jar-instant-noodles-recipe-7975114",
  "name": "Mason Jar Instant Noodles",
  "recipe_type": "soup",
  "brief_description": "This recipe for mason jar instant noodles is written for 1 mason jar, and you can easily scale it for the number of jars you would like to make. My noodles come in an 8-ounce box, so I typically prepare 4 jars at a time.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Place chopped chicken in the bottom of the mason jar. Add carrots, cabbage, mushrooms, and green onion."
    },
    {
      "position": 2,
      "text": "Top with sesame oil, soy sauce, and Sriracha sauce. Add noodles. Crumble bouillon cube over the top. Refrigerate until ready to use."
    },
    {
      "position": 3,
      "text": "When ready to serve, pour boiling water into the jar. Screw the lid on and let sit 5 minutes. Stir well and eat."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,

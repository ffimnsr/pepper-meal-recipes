  "slug": "pear-and-apple-overnight-oats-recipe-11822816",
  "name": "Pear and Apple Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These pear and apple overnight oats are an easy make-ahead breakfast for the season when apples and pears are abundant. With the addition of Greek yogurt, this muesli will sustain you all morning long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, milk, yogurt, pear, apple, raisins, brown sugar, and 1 tablespoon honey in a bowl. Cover and soak oats in the refrigerator overnight."
    },
    {
      "position": 2,
      "text": "Drizzle with remaining honey to serve."
    }
  ],
  "servings": 4,

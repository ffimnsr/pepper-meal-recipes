  "id": "22a90a82-dc71-5197-bf14-0f92e8e100a1",
  "slug": "gelato",
  "name": "Gelato",
  "recipe_type": "dessert",
  "brief_description": "This Italian gelato recipe makes the perfect rich and creamy base for your favorite flavor add-ins from vanilla to chocolate, to any fruit in between.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix milk and cream in a medium saucepan. Warm until foam forms around the edges. Remove from heat."
    },
    {
      "position": 3,
      "text": "Beat egg yolks and sugar until frothy in a large bowl. Gradually pour warm milk into egg yolks and sugar, whisking constantly. Return mixture to saucepan; cook over medium heat, stirring with a wooden spoon until the mixture gels slightly and coats the back of the spoon. If small egg lumps begin to show, remove from heat immediately."
    },
    {
      "position": 4,
      "text": "Pour the mixture through a sieve or fine strainer into a bowl. Cover, and chill for 2 hours to overnight."
    },
    {
      "position": 5,
      "text": "Pour the mixture into an ice cream maker, and freeze according to the manufacturer's instructions. Transfer to a sealed container, and freeze until firm, at least 2 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

  "id": "e923ed99-9d29-525b-91b6-a0fd06fd1395",
  "slug": "old-fashioned-stuffing",
  "name": "Best Homemade Stuffing",
  "recipe_type": "soup",
  "brief_description": "This best homemade stuffing recipe is a classic, made with toasted bread, celery, onions, eggs, broth, garlic, and herbs for a flavorful holiday side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Spread the toasted bread slices in a single layer on baking sheets. Bake until completely dry and crisp, 20 to 30 minutes, turning once. This helps dries out the toast so it can absorb the broth without turning soggy. Remove from the oven and let cool slightly."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Crush toast into crumbs with a rolling pin; transfer to a large bowl."
    },
    {
      "position": 4,
      "text": "Melt butter in a medium saucepan over medium heat. Add onion and celery; cook until soft, 5 to 7 minutes. Remove from heat; drain."
    },
    {
      "position": 5,
      "text": "Stir broth and eggs into bread crumbs until moist, but not soggy. Add water, if needed. Fold in onion and celery, sage, and garlic powder; season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Press mixture into the prepared baking dish."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until top is brown and crisp, about 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "ef0e6271-1fd2-5c23-b0b1-ed5307cef486",
  "slug": "slow-cooker-beef-stew-i",
  "name": "Slow Cooker Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This beef stew recipe is easy to make in a slow cooker with potatoes, carrots, celery, broth, herbs, and spices for a hearty and comforting dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place beef in the slow cooker."
    },
    {
      "position": 3,
      "text": "Mix flour, salt, and pepper together in a small bowl; pour over beef and stir until coated."
    },
    {
      "position": 4,
      "text": "Add beef broth, carrots, potatoes, onion, celery, Worcestershire sauce, paprika, garlic, and bay leave; stir to combine."
    },
    {
      "position": 5,
      "text": "Cover, and cook until beef is tender enough to cut with a spoon, on Low for 8 to 12 hours, or on High for 4 to 6 hours."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,

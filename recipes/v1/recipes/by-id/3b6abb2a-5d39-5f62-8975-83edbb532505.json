  "slug": "tortilla-rollups-iv",
  "name": "Tortilla Rollups",
  "recipe_type": "appetizer",
  "brief_description": "These tortilla rollups are filled with Cheddar cheese, cream cheese, salsa, and sour cream flavored with ranch for quick and easy lunch wraps.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together Cheddar cheese, salsa, sour cream, cream cheese, and ranch dressing mix in a medium bowl until combined. Spread evenly onto tortillas. Roll up tortillas and chill in the refrigerator until ready to serve."
    },
    {
      "position": 2,
      "text": "To serve, cut rolled tortillas into 3/4-inch slices and arrange on a large serving platter."
    }
  ],
  "servings": 25,

  "slug": "banana-pudding-protein-yogurt-cups-recipe-12026421",
  "name": "Banana Pudding Protein Yogurt Cups",
  "recipe_type": "appetizer",
  "brief_description": "These banana pudding protein yogurt cups are good to have ready for an on-the-go snack. Greek yogurt, with added protein powder, banana pudding mix, nilla wafers, and banana slices tastes just like dessert, but won\u2019t slow you down.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove lid from yogurt cup; gradually stir in protein powder and pudding mix until smooth and well combined."
    },
    {
      "position": 2,
      "text": "Press vanilla wafers into the pudding cup. Cover with plastic wrap and refrigerate at least 2 hours and up to overnight."
    },
    {
      "position": 3,
      "text": "Top with banana slices before serving."
    }
  ],

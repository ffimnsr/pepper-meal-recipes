  "id": "fa530f8b-3d2e-54be-94e9-76a10114ba4f",
  "slug": "einkorn-banana-bread",
  "name": "Einkorn Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "Pack more minerals, protein, and flavor into your banana bread recipe by using einkorn flour. Einkorn flour is just as versatile as regular all-purpose flour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Stir sugar and melted butter together in a bowl. Mix in eggs, milk, and vanilla until well combined."
    },
    {
      "position": 3,
      "text": "Combine sifted flour, cinnamon, baking soda, baking powder, and salt in a separate bowl. Stir flour mixture into butter mixture until smooth. Fold bananas and walnuts into the batter until fully incorporated. Spread batter evenly into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center of the loaf reads 195 degrees F (90 degrees C), about 55 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and cool in the pan for 10 minutes. Remove loaf from the pan and finish cooling on a wire rack."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,

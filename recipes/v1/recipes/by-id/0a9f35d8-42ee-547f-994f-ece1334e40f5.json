  "id": "0a9f35d8-42ee-547f-994f-ece1334e40f5",
  "slug": "chopped-cheese-pickle-taco-recipe-11971614",
  "name": "Chopped Cheese Pickle Taco",
  "recipe_type": "main",
  "brief_description": "These sensational chopped cheese pickle tacos are loaded with seasoned beef, melty cheese, pickles, and spicy sauce for all the flavors of a cheeseburger with a tortilla twist. They\u2019re quick, satisfying, and ready in less than 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mayonnaise, ketchup, hot sauce, and pickle juice in a small bowl and set aside."
    },
    {
      "position": 2,
      "text": "Heat a large cast iron skillet or griddle over high heat. Season 1 side of ground beef with half the salt, pepper, and garlic powder. Add beef, seasoned side down, into the hot pan and use spatula to flatten it into a large patty about a 1/2-inch thick. Let the beef cook undisturbed until browned, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Flip the beef and let it cook 1 more minute before using the spatula to chop the meat into smaller pieces. Add onion and continue to cook, while chopping the mixture into very small pieces."
    },
    {
      "position": 4,
      "text": "Top with cheese and allow to melt, about one minute. Add pickles and then use 1 or 2 spatulas to combine the ingredients. Remove from heat."
    },
    {
      "position": 5,
      "text": "Divide meat mixture among tortillas and top with shredded lettuce, crushed chips and a drizzle of reserved sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

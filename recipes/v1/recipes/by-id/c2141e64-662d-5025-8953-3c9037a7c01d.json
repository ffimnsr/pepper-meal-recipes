  "id": "c2141e64-662d-5025-8953-3c9037a7c01d",
  "slug": "slow-cooker-teriyaki-pulled-chicken",
  "name": "Slow Cooker Teriyaki Pulled Chicken",
  "recipe_type": "main",
  "brief_description": "Use your slow cooker to prepare chicken breasts and chicken thighs to make teriyaki pulled chicken--simple to make and perfect with rice and vegetables or in a crusty bun.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken pieces, soy sauce, honey, garlic, ginger, and rice vinegar in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook until chicken is no longer pink in the centers, on Low, 6 to 8 hours, or High for 4 to 6 hours. Remove chicken to a cutting board and shred using 2 forks."
    },
    {
      "position": 3,
      "text": "Pour liquid from the slow cooker into a small saucepan and heat over low heat. Mix tapioca flour and water in a small bowl to create a slurry and add to the liquid. Simmer until sauce has thickened to desired consistency, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Pour sauce over pulled chicken and mix well."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 245,
  "preparation_time_minutes": 10,

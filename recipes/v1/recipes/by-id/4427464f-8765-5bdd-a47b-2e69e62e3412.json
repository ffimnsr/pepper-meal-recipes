  "id": "4427464f-8765-5bdd-a47b-2e69e62e3412",
  "slug": "kale-and-fennel-frond-frittata",
  "name": "Kale and Fennel Frond Frittata",
  "recipe_type": "breakfast",
  "brief_description": "A very green frittata that makes delicious use of fennel fronds. Fennel fronds have a very delicate flavor and the kale and feta cheese in this frittata are a perfect match.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a small ovenproof skillet over medium heat. Add kale and cook until wilted, 3 to 5 minutes. Add fennel fronds and cook for 1 minute more."
    },
    {
      "position": 3,
      "text": "Season beaten eggs with salt and pepper and pour into the skillet. Stir briefly, then leave to allow the bottom of the frittata to set. Once you see the bottom setting, take a spatula to the edges of the pan to ensure that the frittata isn't sticking. When the frittata starts to set around the edges, sprinkle crumbled feta cheese over the top."
    },
    {
      "position": 4,
      "text": "Place skillet under the broiler and cook until the frittata is fully set and the edges slightly browned, 5 to 10 minutes. Serve immediately or at room temperature."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

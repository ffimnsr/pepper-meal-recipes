  "id": "2db83f6c-89d1-5425-a988-a4ff7e9e9813",
  "slug": "roasted-vegetable-wreath-recipe-11890442",
  "name": "Roasted Vegetable Wreath",
  "recipe_type": "appetizer",
  "brief_description": "Use this roasted vegetable wreath to add holiday flair to roasted mixed vegetables. Arrange them in a circle on a serving plate and place a tangy yogurt-Boursin dip in the center. Sprigs of fresh rosemary simulate evergreen branches, and sun-dried tomatoes add pops of festive color.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place an 11x17-inch baking sheet in the oven and preheat to 425 degrees F (220 degrees C). Keep sheet pan in the oven until ready to use."
    },
    {
      "position": 2,
      "text": "Combine butternut squash, carrots, parsnips, sweet potato, and red onion in a large bowl. Add olive oil, minced rosemary, sea salt, pepper, and garlic granules and stir to coat. Spread vegetable mixture in a single layer onto the heated baking sheet from the oven."
    },
    {
      "position": 3,
      "text": "Roast vegetables in the preheated oven for 15 minutes; stir and continue roasting until tender, 15 to 20 minutes more."
    },
    {
      "position": 4,
      "text": "Meanwhile, for dip, combine yogurt, mayonnaise, Boursin, and 1 Tablespoon olive oil in a small mixing bowl. Use an electric mixer to combine. If dip seems too stiff, stir in up to 1 tablespoon more olive oil."
    },
    {
      "position": 5,
      "text": "If desired, arrange roasted vegetables in a ring on a serving plate, garnish with fresh rosemary sprigs, and strips of sun-dried tomatoes. Place dip in a small bowl in the center of the vegetables on the plate. Drizzle additional olive oil on top of the dip, and sprinkle on a few small pieces of sun-dried tomato."
    },
    {
      "position": 6,
      "text": "Serve warm or at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "57362642-389a-52b5-b8f4-1ecdf0f14c2e",
  "slug": "neiman-marcus-rolls-recipe-11924388",
  "name": "Neiman Marcus Rolls",
  "recipe_type": "side",
  "brief_description": "These Neiman Marcus rolls are like a savory version of a cinnamon roll; rich, soft spiral rolls with crumbled bacon, Cheddar cheese, and chives. If you prefer to work ahead, you can make the dough and refrigerate it overnight before forming the rolls.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk and butter in a small pot. Cook over medium heat just until butter is melted, 1 to 2 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Pour milk mixture into the bowl of a stand mixer fitted with the hook attachment. Add yeast, sugar, and eggs and mix to combine."
    },
    {
      "position": 3,
      "text": "Add flour and salt to the bowl. Knead on medium-low speed until smooth and elastic, 8 to 9 minutes. If dough is too sticky, add up to 1/4 cup flour and mix for another minute."
    },
    {
      "position": 4,
      "text": "Cover the bowl and let dough rise in a warm place until doubled, at least 1 hour. Alternatively, let dough rise in the refrigerator overnight and continue the next day."
    },
    {
      "position": 5,
      "text": "Lightly flour a work surface and roll dough into a 10x14-inch rectangle. Spread softened butter over the surface."
    },
    {
      "position": 6,
      "text": "Cut bacon into small bits and sprinkle over butter. Sprinkle on Cheddar cheese, followed by chives. Roll the dough into a log. Slice log crosswise into 10 rolls."
    },
    {
      "position": 7,
      "text": "Line a baking sheet with parchment; place rolls, cut side up, onto the sheet and cover with a kitchen towel. Let rise until very puffy, 30 minutes to 1 hour."
    },
    {
      "position": 8,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) towards the end of the rise. You can brush rolls with egg wash or cream for extra browning."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until golden brown, 21 to 24 minutes. Let cool slightly before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,

  "id": "c51a8abc-7904-57ba-a342-2ed32597b30f",
  "slug": "ravioli-lasagna",
  "name": "Ravioli Lasagna",
  "recipe_type": "main",
  "brief_description": "This ravioli lasagna with ricotta cheese is made of frozen cheese ravioli layered with spinach, Romano cheese, and ricotta, then baked with sauce.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray an 8x8-inch baking dish with cooking spray and set aside."
    },
    {
      "position": 2,
      "text": "Mix ricotta cheese, spinach, 1 1/2 cups Romano cheese, eggs, salt, and pepper to taste in a bowl."
    },
    {
      "position": 3,
      "text": "To assemble lasagna, spread 1/4 cup of spaghetti sauce in the bottom of the prepared baking dish, and place frozen ravioli on top in a single layer. Spread about 1 cup of ricotta mixture over ravioli. Repeat layers 3 more times, ending with a layer of frozen ravioli. Spread with 1/2 cup spaghetti sauce, and sprinkle remaining 1/2 cup of Romano cheese on top. Cover dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 40 minutes, until casserole is bubbling. Then remove the aluminum foil, and bake another 10 minutes to brown cheese on top. Let sit for 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

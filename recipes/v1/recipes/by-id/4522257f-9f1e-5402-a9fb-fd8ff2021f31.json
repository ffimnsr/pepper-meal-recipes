{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4522257f-9f1e-5402-a9fb-fd8ff2021f31",
  "slug": "skillet-pork-chops-with-mushroom-gravy-recipe-8603915",
  "name": "Skillet Pork Chops with Mushroom Gravy",
  "recipe_type": "main",
  "brief_description": "These smothered pork chops with mushroom gravy are a delightful way to serve pork chops in a skillet dish your family will love! Pork chops are browned, and a pan sauce is made in the same skillet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blot chops dry with paper towels and season both sides with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil and 1 tablespoon butter in a large nonstick skillet over medium-high heat. When butter sizzles, add chops and brown on both sides, 4 to 5 minutes per side. Remove chops from the skillet and keep warm."
    },
    {
      "position": 3,
      "text": "To the same skillet, add remaining olive oil and butter. When butter is melted, add onions, mushrooms, and 1/2 teaspoon salt, and cook, stirring, until onions begin to turn translucent and mushrooms are softened, 4 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in minced garlic and cook until fragrant, about 30 seconds. Add chicken stock, wine, and dried thyme, and bring to a boil."
    },
    {
      "position": 5,
      "text": "Return chops and any accumulated juices to the skillet, nestling chops down into vegetables and broth. Remove about 1/4 cup of broth for later use. Cover, reduce heat to low, and cook until an instant-read thermometer inserted near the center reads 145 degrees F (63 degrees C), 4 to 5 minutes. See note."
    },
    {
      "position": 6,
      "text": "Stir cornstarch into the reserved cooking liquid, and stir until there are no lumps. While stirring the skillet sauce, add cornstarch mixture, and continue stirring 3 to 4 minutes, or until the sauce thickens."
    },
    {
      "position": 7,
      "text": "Serve chops with mushrooms and sauce on top, and garnish with fresh thyme sprigs, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

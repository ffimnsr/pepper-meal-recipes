  "id": "9d4d0c30-3edd-57b9-8f88-ce9ec74fc270",
  "slug": "mediterranean-orzo-vegetable-soup-recipe-11880989",
  "name": "Mediterranean Orzo Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "This Instant Pot orzo vegetable soup uses simple Mediterranean flavors and is an ideal recipe for busy weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function.Add olive oil and allow to get hot. Add onions and saute for 2 minutes. Add garlic and saute until fragrant, about 45 seconds. Add orzo and saute for 30 seconds. Turn off the Saute function."
    },
    {
      "position": 2,
      "text": "Pour in vegetable broth and stir to combine. Add zucchini, squash, carrots, and green beans. Do not stir. Pour crushed tomatoes on top. Do not stir. Close and lock the lid"
    },
    {
      "position": 3,
      "text": "Select High pressure according to manufacturer\u2019s instructions; set timer for 2 minutes. Allow 10 to 15 minutes for pressure to build. Release pressure carefully using the quick-release method according to manufacturer\u2019s instructions, about 5 minutes. Unlock and carefully remove the lid."
    },
    {
      "position": 4,
      "text": "Add spinach; stir to wilt. Stir in garlic granules, Greek seasoning, and lemon juice, and season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

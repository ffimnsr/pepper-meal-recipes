  "id": "48a501d1-483e-543a-b651-c352390294aa",
  "slug": "spinach-tomato-tortellini",
  "name": "Spinach Tomato Tortellini",
  "recipe_type": "main",
  "brief_description": "A creamy sauce with tomatoes and spinach tops tortellini filled with cheese in this quick and easy meal that's ready in just about 45 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Add tortellini and cook until tender, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine tomatoes, spinach, basil, garlic, salt, and pepper in a large saucepan over medium heat. Cook and stir until the mixture begins to bubble."
    },
    {
      "position": 3,
      "text": "Whisk milk, cream, and flour together in a medium bowl. Add to the saucepan along with Parmesan; stir together. Cook until sauce is heated through, 3 to 5 minutes. Reduce the heat to low and simmer until thick, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Drain tortellini, but do not rinse. Gently add to the saucepan and stir to coat with sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

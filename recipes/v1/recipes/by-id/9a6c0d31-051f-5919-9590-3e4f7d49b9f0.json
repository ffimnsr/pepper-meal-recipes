  "id": "9a6c0d31-051f-5919-9590-3e4f7d49b9f0",
  "slug": "easy-pilaf",
  "name": "Easy Pilaf",
  "recipe_type": "soup",
  "brief_description": "All you need for this rice pilaf recipe is butter, onion, salt, chicken broth, and rice. Try this simple side dish at your next dinner!",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 1-quart baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Add onion and saut\u00e9 until translucent, 3 to 5 minutes. Stir in rice and cook until slightly golden, 2 to 3 minutes. Pour in chicken broth, season with salt, and simmer for 5 minutes. Transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the broth is completely absorbed, 35 to 40 minutes. Fluff with a fork to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

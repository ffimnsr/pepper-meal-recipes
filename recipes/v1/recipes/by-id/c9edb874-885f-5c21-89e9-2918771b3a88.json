  "id": "c9edb874-885f-5c21-89e9-2918771b3a88",
  "slug": "lemon-bars-i",
  "name": "Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "This recipe levels up by putting lemon bars onto a shortbread base, blending two great ideas into one delightful treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix 1 cup flour and 1/4 cup confectioners sugar in a medium bowl. Melt butter and stir into flour mixture. Press evenly into an 8x8-inch baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 4,
      "text": "While crust bakes, make topping: Mix 1 cup white sugar, 2 tablespoons flour, and baking powder in a large bowl. Beat eggs and add to mixture, stirring well. Add lemon juice and zest; mix well. Pour over crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 minutes. Cool slightly, then cut into squares while warm; dust with confectioners' sugar."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

  "id": "c332213c-c29d-5ddc-bcbb-ec68440c524b",
  "slug": "lancashire-hot-pot",
  "name": "Lancashire Hot Pot",
  "recipe_type": "main",
  "brief_description": "Very simple lamb and potato casserole made with layers of sliced potatoes, browned onion and leg of lamb, fresh thyme, stock and seasoning.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium high heat. Saute onion until soft and deep golden in color. Remove from skillet and set aside. Add lamb to skillet and fry (in batches if necessary) until rich chestnut brown in color, 12 to 15 minutes. Drain fat and reserve."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Spread 1/2 of the potatoes in the bottom of a 9x13 inch baking dish. Season with salt and pepper to taste. Place browned lamb and onions on top, then sprinkle with thyme and season to taste. Cover with remaining potatoes, season to taste and dot with butter. Pour stock over all."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 1 1/2 to 2 hours. Note: If casserole is drying out while cooking, add more stock as needed. If casserole is browning too quickly, cover with aluminum foil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

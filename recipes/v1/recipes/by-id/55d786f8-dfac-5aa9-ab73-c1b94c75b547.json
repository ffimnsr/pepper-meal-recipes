  "id": "55d786f8-dfac-5aa9-ab73-c1b94c75b547",
  "slug": "quick-and-easy-avocado-hummus",
  "name": "Easy Avocado Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This creamy avocado hummus is a delicious blend of chickpeas, tahini, spinach, ripe avocados, lime juice, and cumin for a gorgeous green dip or spread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chickpeas, water, tahini, lime juice, salt, garlic, and cumin in a food processor. Puree until smooth, about 2 minutes. Add avocados, spinach, and olive oil; puree until creamy, 2 to 3 minutes."
    }
  ],

  "id": "a76525a6-68c6-514d-af67-3570c2e82238",
  "slug": "brown-sugar-meatloaf-with-ketchup-glaze",
  "name": "Brown Sugar Meatloaf with Ketchup Glaze",
  "recipe_type": "main",
  "brief_description": "A meatloaf topping of brown sugar, ketchup, and chili makes this meatloaf an irresistibly delicious and flavorful dish for an easy weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Stir ketchup, brown sugar, salt, and chili powder together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Spread a small amount of ketchup mixture into the bottom of the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Mix ground beef, croutons, onion, eggs, milk, and black pepper together in a large bowl."
    },
    {
      "position": 5,
      "text": "Shape into a loaf and put into the prepared pan. Spread remaining ketchup mixture over loaf."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

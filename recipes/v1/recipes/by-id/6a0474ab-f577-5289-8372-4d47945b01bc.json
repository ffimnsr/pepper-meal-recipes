  "id": "6a0474ab-f577-5289-8372-4d47945b01bc",
  "slug": "easy-pavlova",
  "name": "Easy Pavlova",
  "recipe_type": "dessert",
  "brief_description": "This pavlova has a crisp meringue exterior and soft, fluffy center; top with mounds of whipped cream and fresh fruit for a showstopping dessert.",
  "cuisine": "Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with parchment paper; draw a 9-inch circle on the parchment paper."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff but not dry. Gradually add sugar, about 1 tablespoon at a time, beating well after each addition. Continue beating until meringue is thick, white, and glossy."
    },
    {
      "position": 4,
      "text": "Gently fold in cornstarch, vanilla extract, and lemon juice."
    },
    {
      "position": 5,
      "text": "Spoon mixture inside the circle drawn on the parchment paper. Working from the center, spread mixture toward the outside edge and build the edge slightly. This should leave a slight depression in the center."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until meringue is dry and sounds hollow when tapped, about 1 hour. Cool on a wire rack."
    },
    {
      "position": 7,
      "text": "Beat heavy cream in a medium bowl until stiff peaks form; set aside. Remove meringue from the parchment paper and place on a flat serving plate."
    },
    {
      "position": 8,
      "text": "Fill center of meringue with whipped cream and top with kiwi slices."
    },
    {
      "position": 9,
      "text": "Top with fruit and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

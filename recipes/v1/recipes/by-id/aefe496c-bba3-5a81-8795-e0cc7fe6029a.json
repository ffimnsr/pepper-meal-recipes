  "id": "aefe496c-bba3-5a81-8795-e0cc7fe6029a",
  "slug": "vegan-zucchini-bread",
  "name": "Vegan Zucchini Banana Bread",
  "recipe_type": null,
  "brief_description": "This moist zucchini banana bread is dairy-free, egg-free, and nut-free.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Sift flour, salt, baking soda, baking powder, and cinnamon together in a large bowl."
    },
    {
      "position": 3,
      "text": "Beat bananas, applesauce, vegetable oil, brown sugar, white sugar, vanilla extract, and lemon juice together in a separate large bowl. Beat flour mixture into banana mixture; add zucchini and mix until combined. Pour mixture into the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 90 minutes. Cool in the pans for 20 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

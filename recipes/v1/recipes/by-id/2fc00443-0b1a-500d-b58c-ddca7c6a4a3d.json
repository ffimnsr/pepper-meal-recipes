  "id": "2fc00443-0b1a-500d-b58c-ddca7c6a4a3d",
  "slug": "easy-no-churn-ice-cream-recipe-8581998",
  "name": "Easy No-Churn Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This easy no-churn ice cream is so simple to make, very creamy, tasty, and easy to scoop. This version is vanilla-flavored, but it's easy to create different flavors with this easy method.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Add heavy cream to the bowl of a stand mixer with a whisk attachment. Beat on medium-high speed until stiff peaks form, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Add sweetened condensed milk, vanilla and salt. Mix on low speed until fully combined, 20 to 30 seconds, scraping sides of bowl as needed."
    },
    {
      "position": 4,
      "text": "Transfer mixture into a 9x5-inch loaf pan, spreading evenly in the pan. Cover with plastic wrap, gently pressing down to touch the ice cream mixture and seal out any air bubbles. Freeze until firm, at least 6 hours before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

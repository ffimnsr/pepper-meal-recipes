  "id": "2f599921-9d09-55af-ba89-f29c2f414fa8",
  "slug": "bries-banana-and-honey-dog-treats",
  "name": "Brie's Banana and Honey Dog Treats",
  "recipe_type": "snack",
  "brief_description": "These banana and honey dog biscuits made with whole-wheat flour will surely make your little dog happy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Lightly grease 2 large baking sheets."
    },
    {
      "position": 3,
      "text": "Combine water, mashed bananas, honey, vanilla, and egg in a large bowl."
    },
    {
      "position": 4,
      "text": "Stir in whole-wheat flour and baking powder."
    },
    {
      "position": 5,
      "text": "Beat dough with an electric mixer on medium speed until ingredients are thoroughly combined, adding more water if needed."
    },
    {
      "position": 6,
      "text": "Turn dough onto a floured surface and knead until no longer sticky, 5 to 8 minutes."
    },
    {
      "position": 7,
      "text": "Roll out dough to 1/4-inch thickness and cut into mini shapes with your favorite cookie cutter."
    },
    {
      "position": 8,
      "text": "Place dough shapes on prepared baking sheets."
    },
    {
      "position": 9,
      "text": "Bake in preheated oven until cookies are lightly browned, about 20 minutes."
    },
    {
      "position": 10,
      "text": "Turn off the oven and leave cookies until thoroughly dry and crisp, 30 to 40 more minutes."
    },
    {
      "position": 11,
      "text": "Remove baking sheets from oven and allow cookies to cool on pans for 10 minutes. Transfer cookies to wire rack to fully cool."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

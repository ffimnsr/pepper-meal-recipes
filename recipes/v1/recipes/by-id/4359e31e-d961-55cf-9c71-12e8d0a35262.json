  "id": "4359e31e-d961-55cf-9c71-12e8d0a35262",
  "slug": "tailgate-tandoori-chicken-recipe-11827792",
  "name": "Tailgate Tandoori Chicken",
  "recipe_type": "dessert",
  "brief_description": "Chef John's Indian spiced, party-friendly sheet pan chicken is briefly marinated in a spiced yogurt marinade, roasted in the oven over sweet potato slices, and served in a bun. This is sure to be the fan favorite at your next tailgate.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ginger, lemon juice, and tomato paste in a large bowl. Whisk together and let sit for about 10 minutes while you gather marinade ingredients."
    },
    {
      "position": 2,
      "text": "Add garlic, paprika, cumin, coriander, cayenne, garam masala, turmeric, salt, black pepper, sugar, vegetable oil, and Greek yogurt to ginger mixture, and whisk to combine thoroughly."
    },
    {
      "position": 3,
      "text": "Cut each chicken thigh into 3 equal parts. Transfer into marinade and mix thoroughly. Be sure every part of chicken is coated. Cover and refrigerate for 30 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C). Line a sheet pan with parchment paper, and butter the parchment."
    },
    {
      "position": 5,
      "text": "Toss sweet potato slices with lime juice. Place sweet potatoes, evenly spaced, on the prepared sheet pan and season with salt."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until sweet potatoes are about 75% tender, 10 to 15 minutes. Remove from the oven; set aside until chicken is done marinating."
    },
    {
      "position": 7,
      "text": "Increase the oven temperature to 500 degrees F (260 degrees C)."
    },
    {
      "position": 8,
      "text": "Place chicken pieces on top of sweet potato slices, distributing evenly. Place strips of peppers and onions between and around chicken pieces, being careful not to cover any of the meat. Drizzle chicken with melted butter."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until edges of chicken have begun to turn golden brown, chicken is no longer pink at the center, and juices run clear, 30 to 35 minutes. Scatter cilantro over chicken before serving."
    },
    {
      "position": 10,
      "text": "For the optional yogurt sauce, whisk Greek yogurt, garlic, lemon juice, salt, and cayenne together in a small bowl until smooth."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "60f281b6-8fe2-587c-9882-e72509789213",
  "slug": "peach-cobbler-iv",
  "name": "Simple Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This simple peach cobbler is easy to make by spooning biscuit batter into a baking dish, arranging canned peaches on top, and baking until bubbly and golden.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butter in an 8X8 glass baking dish. Place dish in oven until butter is melted."
    },
    {
      "position": 3,
      "text": "In a medium bowl, combine flour and sugar. Mix well, then stir in milk. Spoon mixture into baking dish, on top of melted butter. Pour peaches over flour mixture."
    },
    {
      "position": 4,
      "text": "Bake cobbler in the preheated oven until peaches are bubbly and crust is lightly browned, 50 to 60 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

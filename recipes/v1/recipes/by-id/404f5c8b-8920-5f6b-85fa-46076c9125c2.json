  "id": "404f5c8b-8920-5f6b-85fa-46076c9125c2",
  "slug": "one-pot-chili-mac-and-cheese",
  "name": "One-Pot Chili Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This delicious chili mac and cheese with ground beef, diced tomatoes, rich tomato sauce, chili beans and spices is cooked all in one pot--including the macaroni!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large Dutch oven or pot over medium-high heat. Add onion, garlic, and beef. Stirring frequently, cook until meat is browned and crumbly, about 3 minutes. Drain excess fat."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, Ragu\u00ae sauce, diced tomatoes with mild green chilies, beans, chili powder, and cumin. Season with salt and pepper, to taste. Bring to a boil and stir in pasta; cover, reduce heat to a simmer and cook until pasta is al dente, about 14 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat. Stir in the cheese and parsley. Serve immediately, garnished with additional cheese and parsley, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

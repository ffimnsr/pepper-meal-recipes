  "id": "6f664126-824d-51e2-af47-25505d664bea",
  "slug": "suzys-mashed-red-potatoes",
  "name": "Suzy's Mashed Red Potatoes",
  "recipe_type": "side",
  "brief_description": "These mashed red potatoes with butter, milk, and sour cream are deliciously creamy. Red potato skins are full of flavor, making this side dish well worth a try!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add red potatoes, and cook until tender but still firm, about 10 minutes; drain."
    },
    {
      "position": 3,
      "text": "Transfer potatoes to a large bowl; add butter, milk, sour cream, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Mash mixture together until smooth and creamy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

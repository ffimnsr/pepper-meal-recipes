  "id": "9a4f2827-df89-539f-97c4-0d097cc5a230",
  "slug": "hot-beef-sundae",
  "name": "Hot Beef Sundae",
  "recipe_type": "side",
  "brief_description": "This hot beef sundae is a savory way to serve your leftovers. They look just like a hot fudge sundae, right down to the cherry tomato on top.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Pile mashed potatoes in each serving bowl to resemble a scoop of ice cream. Top with roast beef with gravy to resemble hot fudge."
    },
    {
      "position": 2,
      "text": "Sprinkle on Cheddar cheese. Dollop sour cream for the \"whipped cream,\" on top. Garnish each sundae with a cherry tomato."
    }
  ],
  "servings": 4,

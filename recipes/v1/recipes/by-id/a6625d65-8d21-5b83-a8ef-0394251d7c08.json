  "id": "a6625d65-8d21-5b83-a8ef-0394251d7c08",
  "slug": "super-easy-strawberry-shortcake-biscuits",
  "name": "Super Easy Shortcake Biscuits",
  "recipe_type": "dessert",
  "brief_description": "These buttery shortcake biscuits are quick and easy to make in just 30 minutes. The perfect base for topping with sweet strawberries and cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking powder, and salt together in a bowl. Cut in shortening and mix to combine."
    },
    {
      "position": 3,
      "text": "Beat eggs in a separate bowl and mix in milk to combine. Add to the dry ingredients and mix until moistened. Pour batter evenly into each of the prepared muffin cups and transfer to the oven as quickly as possible."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

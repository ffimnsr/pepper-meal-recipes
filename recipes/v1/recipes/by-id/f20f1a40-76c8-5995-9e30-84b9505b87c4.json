  "id": "f20f1a40-76c8-5995-9e30-84b9505b87c4",
  "slug": "grammas-date-squares",
  "name": "Gramma's Date Squares",
  "recipe_type": "dessert",
  "brief_description": "The best recipe for delicious date squares with buttery layers of goodness and a chewy oatmeal crust. The whole family will love this sweet treat.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine oats, pastry flour, 1 cup brown sugar, baking soda, and salt in a large bowl. Mix in butter until crumbly. Press half of the mixture into the bottom of a 9-inch square baking pan."
    },
    {
      "position": 3,
      "text": "Combine dates, water, and remaining 1/3 cup brown sugar in a small saucepan over medium heat. Bring to a boil, and cook until thickened. Stir in lemon juice, and remove from heat. Spread the filling over the base, and spread the remaining crumb mixture on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is lightly toasted, 20 to 25 minutes. Cool before cutting into 12 squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,

  "id": "b092e9ee-538e-5e97-9d1a-4142a61b62be",
  "slug": "fabulous-chicken-cordon-bleu-casserole-recipe-8413848",
  "name": "Fabulous Chicken Cordon Bleu Casserole",
  "recipe_type": "main",
  "brief_description": "This fabulous chicken Cordon Bleu casserole recipe is a rich, creamy and decadent chicken, ham, noodle, and Swiss cheese casserole with a crunchy garlic crouton and Parmesan cheese topping. It comes together quickly when you have cooked chicken to use up.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in noodles and return to a boil. Cook noodles uncovered, stirring occasionally, until tender yet firm to the bite, 5 to 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, make a roux: Melt butter in a saucepan over low heat. Stir in flour and cook, stirring constantly, until bubbly and light brown, about 5 minutes. Add milk, half-and-half, salt, and pepper. Bring to a simmer, stirring frequently, until mixture thickens."
    },
    {
      "position": 4,
      "text": "Remove from heat; stir in wine, shredded Swiss cheese, cubed chicken, and ham and mix well."
    },
    {
      "position": 5,
      "text": "Stir cooked noodles and chicken mixture together in a large bowl until well mixed. Pour into the prepared casserole dish."
    },
    {
      "position": 6,
      "text": "Add croutons and Parmesan to the bowl of a food processor, and pulse until finely ground. Pour in melted butter and pulse a few times to mix. Top casserole with crouton mixture."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until hot, bubbly, and lightly browned on top, 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

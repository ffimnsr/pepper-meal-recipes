  "id": "aa918785-b586-59f7-b1af-8e6b5adc5d7d",
  "slug": "zucchini-spice-cake",
  "name": "Zucchini Spice Cake",
  "recipe_type": "dessert",
  "brief_description": "You can add raisins, coconut, or nuts to this flexible recipe for a moist, dense zucchini cake, reminiscent of carrot cake.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease one 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Place grated zucchini in a colander and set aside to drain."
    },
    {
      "position": 3,
      "text": "Whisk together flour, baking soda, baking powder, white sugar, brown sugar, cinnamon, cloves, nutmeg, and salt in a large bowl until well blended."
    },
    {
      "position": 4,
      "text": "Beat eggs, applesauce, oil, and vanilla in a separate bowl until smooth. Fold in flour mixture, then stir in zucchini."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake until a toothpick inserted in the center comes out clean, 45 to 55 minutes. Allow to cool completely before cutting."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

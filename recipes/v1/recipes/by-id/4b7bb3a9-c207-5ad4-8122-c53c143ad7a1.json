{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4b7bb3a9-c207-5ad4-8122-c53c143ad7a1",
  "slug": "bean-and-honey-burrito-casserole",
  "name": "Bean and Honey Burrito Casserole",
  "recipe_type": "main",
  "brief_description": "Here's a great way to feed burritos to a crowd. Layer chicken, veggies, and a creamy honey sauce with tortillas, and bake until bubbly and brown. Serve with shredded lettuce and fresh chopped tomatoes .",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare yellow rice as directed on package; reserve 1 1/2 cups. Refrigerate any remaining rice for another use."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray a 9x13 inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Line bottom of baking dish with 4 tortillas. To make the honey sauce, whisk together the mustard, sour cream, and 1/3 cup honey in a small bowl. Combine the red pepper, green pepper, garbanzo beans, black beans, and corn in a large bowl. Scoop out 1/2 cup of the bean mixture and reserve for topping."
    },
    {
      "position": 4,
      "text": "Stir the chicken, 1/4 cup mozzarella cheese, 1/4 cup Cheddar cheese, cumin, yellow rice, and honey sauce into the bean mixture. Mix well. Pour mixture into the baking dish. Top with 4 tortillas; sprinkle with the remaining 1/4 cup mozzarella cheese, 1/4 cup Cheddar cheese, and the reserved 1/2 cup bean mixture."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until hot and bubbly, 30 to 45 minutes. Cover with aluminum foil if top browns excessively. Remove from oven, drizzle with the remaining 2 tablespoons of honey."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

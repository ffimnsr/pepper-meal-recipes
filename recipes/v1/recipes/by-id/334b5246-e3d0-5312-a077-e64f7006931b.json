  "id": "334b5246-e3d0-5312-a077-e64f7006931b",
  "slug": "watermelon-mojitos",
  "name": "Watermelon Mojitos",
  "recipe_type": "drink",
  "brief_description": "Try this simple watermelon mojito recipe for a delicious and refreshing cocktail made with juicy watermelon, lime juice, club soda, mint, and white rum.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Place watermelon cubes into a blender; blend until smooth. Transfer to a mesh strainer set over a bowl to remove pulp. Measure 2 cups strained watermelon juice; set aside."
    },
    {
      "position": 2,
      "text": "Place mint leaves in the bottom of a pitcher. Add \u00bd watermelon juice to the pitcher; mash mint leaves with a cocktail muddler or bottom of a wooden spoon."
    },
    {
      "position": 3,
      "text": "Stir in remaining \u00bd watermelon juice, rum, lime juice, and simple syrup. Fill pitcher with ice; top with club soda to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "42d1d198-8d76-5506-ad51-744fffff6261",
  "slug": "chickpea-tikka-masala-recipe-7497387",
  "name": "Chickpea Tikka Masala",
  "recipe_type": "main",
  "brief_description": "Chickpea tikka masala is a classic Indian curry where chickpeas are cooked in a flavorful creamy sauce. Serve over rice or with naan.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high. Add onion and carrots and cook until tender, 5 to 6 minutes."
    },
    {
      "position": 3,
      "text": "Stir in garam masala, cumin, and black pepper; cook and stir until mixture is fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Add tomato paste, ginger paste, garlic paste, and jalape\u00f1o pepper; cook and stir for 2 minutes."
    },
    {
      "position": 5,
      "text": "Stir in chickpeas, tomato sauce, sugar, salt, and cayenne pepper. Cook over medium-high heat until mixture is hot. Reduce heat to low. Cover and simmer for 10 minutes."
    },
    {
      "position": 6,
      "text": "Stir in 3/4 cup water and half-and-half. Continue cooking on low until heated through, about 1 minute. For a saucier mixture, add more water if desired. Remove from heat; cover and keep warm."
    },
    {
      "position": 7,
      "text": "Top with cilantro and serve with hot cooked basmati rice and/or naan."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

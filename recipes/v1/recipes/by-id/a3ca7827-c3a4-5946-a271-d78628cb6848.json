  "slug": "peanut-butter-cottage-cheese-ice-cream-recipe-11716367",
  "name": "Peanut Butter Cottage Cheese Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "Peanut butter cottage cheese ice cream is low in calories, high in protein, and best of all it is a delicious soft-serve ice cream. No ice cream maker is needed, since it is made in a powerful blender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine cottage cheese, peanut butter, maple syrup, peanut butter powder, peanut butter syrup, vanilla, and salt in blender cup of a powerful blender such as a Vitamix. Blend until completely smooth, using a tamper if needed."
    },
    {
      "position": 3,
      "text": "Pour into a freezer-safe container. Freeze until consistency is that of soft-serve ice cream, stirring every 30 minutes to avoid ice crystals, about 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

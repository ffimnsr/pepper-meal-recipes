{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "df165f85-1977-5536-b671-369e89899f9c",
  "slug": "chinese-hand-pulled-noodles-in-beef-broth",
  "name": "Chinese Hand-Pulled Noodles in Beef Broth",
  "recipe_type": "soup",
  "brief_description": "Fresh hand-pulled noodles are served in a rich and flavor-packed beef broth with veggies and chili oil for an authentic and delicious Chinese meal at home.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a large pot. Add beef, ginger, Szechuan peppercorns, dried tsaoko, dried mandarin peels, and bay leaves; bring soup back to a boil, reduce to a simmer and cook, covered, for 2 hours."
    },
    {
      "position": 2,
      "text": "Discard whole spices. Season beef broth with salt to taste. Cover and keep warm."
    },
    {
      "position": 3,
      "text": "Place flour in a large bowl and gradually mix in water. Mix until dough comes together; knead until smooth, 15 to 20 minutes. Cover with plastic wrap and let rest for 15 minutes."
    },
    {
      "position": 4,
      "text": "Knead dough again for 2 minutes; cover and let rest for 15 minutes."
    },
    {
      "position": 5,
      "text": "Knead dough one more time for 2 minutes. Divide into 4 equal pieces. Roll each piece into a 3/8-inch-thick sheet. Brush both sides of each sheet with oil. Stack sheets together; cover with plastic wrap and let rest for 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Fill a large saucepan with water and bring to a boil. Add sliced daikon and cook for 10 to 15 minutes. Remove using a slotted spoon and drain well; set aside. Save water to cook the noodles."
    },
    {
      "position": 7,
      "text": "Place 1 sheet of dough on a cutting board and slice into 1/8-inch-wide strips. Take one end of a strip in each hand and stretch it until it is 30 to 35 inches long. Fold it into thirds and stretch again to the same length; shake and slap against the counter several times to lengthen it to 2 to 3 yards. Drop it into the boiling water. Add 2 to 3 more strips of noodles to the boiling water; cook until tender, 5 to 10 minutes. Transfer drained noodles to a serving bowl."
    },
    {
      "position": 8,
      "text": "Repeat the process with the remaining sheets of dough. Pour beef broth on top of the drained noodles and top with cooked beef, daikon, chopped green garlic, cilantro, and chili oil."
    }
  ],
  "servings": 8,

  "id": "48f2cd0a-9609-507e-8d89-2a86128a002b",
  "slug": "instant-pot-garlicky-mushroom-soup",
  "name": "Instant Pot Garlicky Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "Whip up this garlicky Instant Pot mushroom soup as a quick and easy way to satisfy your cravings for cream of mushroom soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in the pot of a multi-functional electric pressure cooker (such as Instant Pot) set to Saute mode. Add mushrooms and saute for 3 minutes. Add garlic and stir until fragrant. Slowly pour in chicken stock and bring to a boil while scraping any browned bits off the bottom of the pot."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 3 minutes. Allow 10 to 15 minutes for pressure to build. Meanwhile, mix cream and flour together in a bowl to form a slurry."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Pour slurry into the soup; stir to combine."
    },
    {
      "position": 4,
      "text": "Switch pot to Saute mode. Stir until soup is slightly thickened. Add garlic salt, thyme, and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

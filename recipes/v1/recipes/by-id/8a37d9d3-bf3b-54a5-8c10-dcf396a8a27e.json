  "id": "8a37d9d3-bf3b-54a5-8c10-dcf396a8a27e",
  "slug": "bologna-sliders-with-fried-onions-recipe-7814308",
  "name": "Bologna Sliders with Fried Onions",
  "recipe_type": "appetizer",
  "brief_description": "These fried bologna sliders with fried onions are Midwestern comfort food, and a perfect snack or game day offering, especially with a cold beer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice slider rolls in half horizontally. Spread 1 teaspoon mustard on the bottom of each roll, top with a pickle slice, and set aside."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons olive oil in a large skillet over medium heat. Add sliced onions to skillet, cook for 1 minute and add the bologna wedges. Cook until onions are tender and translucent, and the bologna is browned on each side, stirring and flipping occasionally, about 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Add 2 bologna wedges on top of each bottom bun and top with fried onions. Put tops of slider rolls back onto sliders; serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

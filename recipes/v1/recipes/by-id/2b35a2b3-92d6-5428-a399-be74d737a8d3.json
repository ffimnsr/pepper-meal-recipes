  "id": "2b35a2b3-92d6-5428-a399-be74d737a8d3",
  "slug": "christmas-wreath-cake",
  "name": "Christmas Wreath Cake",
  "recipe_type": "dessert",
  "brief_description": "A really good fruit cake recipe, one you can eat the same day you make it; it's even better if you let sit for awhile. It's baked in a tube pan to make a wreath shape.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Line a tube pan with 2 layers of brown paper or parchment, and grease well."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together flour, baking powder, and salt. Mix in raisins, dates, cherries, pineapple, walnuts, and coconut. Stir until all fruit is coated."
    },
    {
      "position": 3,
      "text": "In another large bowl, cream the butter with the white sugar. Add lemon rind, lemon juice, and eggs; mix well. Stir in fruit mixture. Spread batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake for 2 hours or until a tester comes out clean. Cool completely on a wire rack."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,

  "id": "18f1a42e-361e-5eca-bcd4-ecfa8414a0f3",
  "slug": "pumpkin-swirl-bread",
  "name": "Pumpkin Swirl Bread",
  "recipe_type": "dessert",
  "brief_description": "This quick pumpkin swirl bread recipe features ribbons of sweetened cream cheese throughout a cinnamon- and nutmeg-spiced loaf, for an autumnal treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Beat \u00bc cup sugar, cream cheese, and 1 egg in a large bowl with an electric mixer until smooth and creamy. Set aside."
    },
    {
      "position": 3,
      "text": "Combine remaining 1 \u00bd cups sugar, flour, baking soda, cinnamon, salt, and nutmeg in a separate bowl. Combine remaining 1 egg, pumpkin, butter, and water in a separate bowl; stir in flour mixture until moistened."
    },
    {
      "position": 4,
      "text": "Reserve 2 cups pumpkin batter. Pour remaining batter into the prepared pan; pour cream cheese mixture over top. Top with reserved 2 cups pumpkin batter; cut through batter several times with a knife for a swirl effect."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 70 minutes. Cool in the pan for 10 minutes, then remove from the pan, and transfer to a wire rack to cool completely."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

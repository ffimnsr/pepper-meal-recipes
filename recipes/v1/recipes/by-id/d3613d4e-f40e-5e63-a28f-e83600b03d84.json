  "id": "d3613d4e-f40e-5e63-a28f-e83600b03d84",
  "slug": "award-winning-soft-chocolate-chip-cookies",
  "name": "Award Winning Soft Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "The best recipe for chocolate chip cookies, much-loved and even award-winning with a secret ingredient \u2014 instant pudding mix. Always a favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift together flour and baking soda in a medium bowl, set aside."
    },
    {
      "position": 3,
      "text": "Cream together butter, brown sugar, and white sugar in a large bowl. Beat in instant pudding mix until blended. Stir in eggs and vanilla."
    },
    {
      "position": 4,
      "text": "Add flour mixture to the butter mixture until it\u2019s well incorporated. Fold in chocolate chips and nuts."
    },
    {
      "position": 5,
      "text": "Drop cookies by rounded spoonfuls onto ungreased cookie sheets."
    },
    {
      "position": 6,
      "text": "Bake in batches in the preheated oven until the edges are golden brown, 10 to 12 minutes, switching racks halfway through."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

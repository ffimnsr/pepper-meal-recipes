  "schema_version": 1,
  "id": "3cedf8c0-13a2-5e56-8a1f-c821dc319ef5",
  "slug": "blt-deviled-eggs",
  "name": "BLT Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "For these BLT deviled eggs, smoky bacon and fresh cherry tomatoes, with bright green dried parsley, bring the flavor of a BLT to regular deviled eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan; cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels; crumble bacon when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Cut eggs in half lengthwise; place egg yolks in a bowl. Mash yolks with a fork; stir in crumbled bacon, mayonnaise, tomatoes, and parsley. Season with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Arrange egg white halves on a serving platter; spoon yolk mixture into egg whites. Refrigerate, covered, until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

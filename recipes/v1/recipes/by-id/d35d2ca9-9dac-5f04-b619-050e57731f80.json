  "slug": "elevated-appletini-recipe-11790482",
  "name": "Elevated Appletini",
  "recipe_type": "drink",
  "brief_description": "This elevated appletini cocktail is very strong. For a lower- alcohol version, substitute unfiltered apple juice for the applejack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a mixing glass half-full with ice. Add gin, applejack, Lillet Blanc, and orange bitters. Stir until well chilled. Strain into a cocktail glass; top with apple slice."
    }
  ],

  "id": "c4bbd700-ed78-5e1a-bd8d-335bde3094e8",
  "slug": "sun-brewed-mint-tea",
  "name": "Sun-Brewed Mint Tea",
  "recipe_type": "dessert",
  "brief_description": "In just two hours, the power of the sun is harnessed to brew a refreshing lemon-tinged mint tea that's delicately sweetened with wildflower honey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water into a large glass container with a lid. Stir in honey until dissolved. Zest lemon, being careful not to include any white pith. Juice lemon, then add both zest and juice to the glass container."
    },
    {
      "position": 2,
      "text": "Working with one bunch at a time, hold mint in one hand; use your other hand to twist and squeeze the leaves, slightly bruising them to release their fragrance and oils. Immerse the squeezed bunches in the water mixture. Cover the container and place it in direct sunlight for 2 hours."
    },
    {
      "position": 3,
      "text": "Remove and discard mint leaves. Shake the tea, then pour over ice in tall glasses. Garnish with mint sprigs."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "slug": "blueberry-chia-pudding-with-almond-milk",
  "name": "Blueberry Chia Pudding",
  "recipe_type": "dessert",
  "brief_description": "This chia pudding recipe combines almond milk, chia seeds, blueberries, and maple syrup for a creamy and delicious vegan dessert or wholesome snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine almond milk, chia seeds, blueberries, maple syrup, vanilla extract, and cinnamon in a blender; blend until smooth. Pour into 3 ramekins or glasses."
    },
    {
      "position": 2,
      "text": "Chill until set, 8 hours to overnight. Serve chilled."
    }
  ],
  "servings": 3,

  "id": "589f0016-c598-5db5-8a06-739971a3abf6",
  "slug": "paalu-mithai-milk-sweet",
  "name": "Paalu Mithai (Milk Sweet)",
  "recipe_type": "dessert",
  "brief_description": "Milk, sugar, and clarified butter make the base of this treat accented with cashews and cardamom.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the ghee in a heavy-bottomed pan over medium heat; fry the cashews in the ghee until golden brown, about 5 minutes. Scrape onto a cutting board to cool, leaving some of the ghee in the pan and return the pan to the stove. When the cashews are cool, chop coarsely."
    },
    {
      "position": 2,
      "text": "Mix the milk, sugar, and semolina flour into the ghee remaining in the pan. Bring the mixture to a boil; reduce heat to low and cook, stirring frequently, until the mixture becomes very thick, 30 to 45 minutes. Stir the cardamom into the mixture."
    },
    {
      "position": 3,
      "text": "Lightly grease a rimmed platter. Pour the milk mixture onto the prepared platter and spread into an even layer. Sprinkle the chopped cashews over the mixture. Score the mithai into squares and allow to cool completely before cutting."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

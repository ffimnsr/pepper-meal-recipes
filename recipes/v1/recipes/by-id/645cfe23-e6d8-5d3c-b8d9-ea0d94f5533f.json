{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "645cfe23-e6d8-5d3c-b8d9-ea0d94f5533f",
  "slug": "bloody-broken-glass-cupcakes",
  "name": "Bloody Broken Glass Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "This spooky Halloween bloody broken glass cupcakes recipe features sugary hard candy \"shards\" atop edible blood made of corn syrup and food coloring.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners."
    },
    {
      "position": 2,
      "text": "Beat cake mix, 1 cup water, eggs, and vegetable oil together in a large bowl with an electric mixer on low speed for 2 minutes."
    },
    {
      "position": 3,
      "text": "Divide batter among the prepared muffin cups, filling to the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 18 to 22 minutes. Cool in the tins for 5 minutes; transfer cupcakes to a wire rack to cool, about 20 minutes. Spread frosting over cooled cupcakes."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine white sugar, 2 cups water, 1 cup corn syrup, and cream of tartar in a saucepan over medium heat; attach a candy thermometer to the saucepan and bring to a boil. Cook, without stirring, until mixture thickens and reaches 300 degrees F (150 degrees C). Immediately pour onto a metal baking pan. Cool completely. Break into \"shards\" using a meat mallet."
    },
    {
      "position": 6,
      "text": "Combine \u00bd cup corn syrup and cornstarch in a large bowl. Slowly stir in \u00bc cup water, adding more if necessary, until mixture thickened to the consistency of blood; stir in red and blue food coloring."
    },
    {
      "position": 7,
      "text": "Stab frosted cupcakes with a few shards of broken sugar glass: drizzle with drops of edible blood."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "e3fe03c3-c6cd-5faf-a13d-38d319511f8f",
  "slug": "pickled-jalapenos",
  "name": "Pickled Jalape\u00f1os",
  "recipe_type": "side",
  "brief_description": "This pickled jalape\u00f1os recipe is easy to make at home with fresh jalape\u00f1os, garlic, and a tangy pickling brine for a refreshing garnish on any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vinegar, water, sugar, salt, and garlic in a pot over medium-high heat. Bring to a boil, stirring until sugar and salt dissolve. Remove from the heat."
    },
    {
      "position": 2,
      "text": "Stir jalape\u00f1o peppers into the pot. Let stand until slightly cooled, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Transfer jalape\u00f1o peppers into a large sterilized Mason jar using tongs or a slotted spoon. Pour in pickling liquid to cover. Let cool to room temperature, about 30 minutes. Seal the jar and store pickles in the refrigerator."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

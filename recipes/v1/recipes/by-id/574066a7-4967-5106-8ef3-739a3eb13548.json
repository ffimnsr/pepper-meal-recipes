  "id": "574066a7-4967-5106-8ef3-739a3eb13548",
  "slug": "crunchy-peanut-cabbage-slaw-recipe-11890051",
  "name": "Crunchy Peanut Cabbage Slaw",
  "recipe_type": "salad",
  "brief_description": "This crunchy peanut cabbage slaw, with edamame, carrots, and peanuts, is a fresh, colorful salad, packed full of flavor. It pairs nicely with a Thai-inspired meal but also stands on its own at a picnic.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk peanut butter, rice vinegar, soy sauce, sesame oil, Sriracha, and ginger paste in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Place shredded cabbage, edamame, carrots, cucumber, and green onions in a large bowl. Toss to combine."
    },
    {
      "position": 3,
      "text": "Pour peanut butter dressing over salad. Stir to combine. Cover and refrigerate for 1 hour."
    },
    {
      "position": 4,
      "text": "Just before serving, top salad with peanuts and sesame seeds."
    }
  ],
  "servings": 12,

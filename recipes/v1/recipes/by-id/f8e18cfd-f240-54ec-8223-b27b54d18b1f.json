  "id": "f8e18cfd-f240-54ec-8223-b27b54d18b1f",
  "slug": "basil-pesto",
  "name": "Basil Pesto",
  "recipe_type": "side",
  "brief_description": "This basil pesto with pine nuts and Parmigiano-Reggiano cheese is quickly made in a food processor for a bright, flavorful sauce to enhance dishes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine basil, cheese, and olive oil in a food processor. Pulse to combine. Add pine nuts, garlic, salt, and pepper. Pulse until mixture is smooth and blended."
    },
    {
      "position": 2,
      "text": "Pour mixture onto a large sheet of plastic wrap; roll into a tube shape and seal. Store in the refrigerator until needed."
    }
  ],

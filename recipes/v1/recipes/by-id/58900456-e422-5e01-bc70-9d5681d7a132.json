  "id": "58900456-e422-5e01-bc70-9d5681d7a132",
  "slug": "cranberry-muffins",
  "name": "Cranberry Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These cranberry muffins are made from scratch with tart cranberries and zesty orange for a bright and colorful holiday breakfast or festive treat.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin pan with paper liners."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt into a bowl."
    },
    {
      "position": 3,
      "text": "Beat sugar and vegetable oil in a large bowl with an electric mixer until light in color and well blended, about 3 minutes. Add egg and beat until smooth. Mix in orange juice and zest."
    },
    {
      "position": 4,
      "text": "Add flour mixture in batches, stirring until just combined. Fold in cranberries."
    },
    {
      "position": 5,
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tops until tops are golden and a toothpick inserted in the center comes out clean, 20 to 25 minutes. Cool muffins in the pan briefly before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "71c2e7f5-b2ad-5771-bf44-b4c6dffef9f9",
  "slug": "corn-chowder-fast-and-great",
  "name": "Cheesy Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This is a velvety, delicious cheesy corn chowder with potatoes and bacon. Cheeses are added at the end, giving this soup an unforgettable flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir bacon in a large pot over medium heat until crisp, about 10 minutes. Drain off grease, leaving about 1 tablespoon in the pot. Break bacon into pieces in the pot."
    },
    {
      "position": 2,
      "text": "Place onion in the pot and cook until transparent, about 5 minutes. Mix in potatoes and cook until they begin to turn translucent, about 10 minutes more. Stir in chicken broth and season with oregano, salt, and pepper. Bring to a boil over high heat. Cover and simmer over low heat until potatoes are soft, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Pour in cream-style corn and whole kernel corn and cook for 10 more minutes."
    },
    {
      "position": 4,
      "text": "Stir in cream, Monterey Jack cheese, and Cheddar cheese over low heat until the soup is hot and the cheeses have melted. Do not boil. Remove from the heat and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

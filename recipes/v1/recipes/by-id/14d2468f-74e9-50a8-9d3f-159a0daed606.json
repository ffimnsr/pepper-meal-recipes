  "id": "14d2468f-74e9-50a8-9d3f-159a0daed606",
  "slug": "kalbi-korean-bbq-short-ribs-authentic-recipe",
  "name": "Homemade Kalbi (Korean BBQ Short Ribs)",
  "recipe_type": "dessert",
  "brief_description": "This kalbi, Korean BBQ short ribs genuine recipe involves marinating beef short ribs in a cola-based marinade for two hours creating, sweet, tender meat.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk cola, sugar, soy sauce, water, green onions, sesame oil, garlic, sesame seeds, and black pepper together in a bowl until combined. Pour into a resealable plastic bag. Add short ribs, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove short ribs from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 3,
      "text": "Cook until browned and reaches desired doneness, 3 to 4 minutes per side. An instant-read thermometer inserted into center should read 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

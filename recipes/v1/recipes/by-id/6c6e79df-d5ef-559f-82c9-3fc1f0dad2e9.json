  "id": "6c6e79df-d5ef-559f-82c9-3fc1f0dad2e9",
  "slug": "tex-mex-burger-with-cajun-mayo",
  "name": "Tex-Mex Burger with Cajun Mayo",
  "recipe_type": "main",
  "brief_description": "This Tex-Mex burger with Cajun mayo recipe is a full-flavor, beefy burger that will tantalize your taste buds. The Cajun mayonnaise truly jazzes it up.",
  "cuisine": "Tex Mex Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Combine mayonnaise and 1 teaspoon Cajun seasoning in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Combine ground sirloin, onion, remaining 3 teaspoons Cajun seasoning, jalape\u00f1o, garlic, and Worcestershire sauce in a large bowl. Divide into 4 balls; flatten into patties."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill until burgers are no longer pink in centers, about 5 minutes per side, topping each burger with 1 cheese slice, during the last 2 minutes. An instant-read thermometer inserted into centers should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 5,
      "text": "Spread mayo on buns, add burgers, lettuce, and tomatoes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

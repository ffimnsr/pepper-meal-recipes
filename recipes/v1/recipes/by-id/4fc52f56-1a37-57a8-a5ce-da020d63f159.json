  "id": "4fc52f56-1a37-57a8-a5ce-da020d63f159",
  "slug": "easter-deviled-eggs",
  "name": "Easter Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Pastel-colored Easter deviled eggs are easy to make for a pretty and fun twist on a classic party appetizer that all your guests will love!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place eggs into a large saucepan; cover with cold water and bring to a boil. Let eggs boil for 3 minutes; turn off heat, cover pot, and let eggs cook in hot water for at least 20 minutes. Drain and cover eggs with cold water. Peel cooled eggs."
    },
    {
      "position": 3,
      "text": "Cut hard-boiled eggs in half lengthwise and remove yolks; mash yolks in a bowl with creamy salad dressing, dry mustard, salt, pepper, and hot sauce until smooth."
    },
    {
      "position": 4,
      "text": "Place red, blue, and green food coloring into 3 different bowls and add about 1 cup water to each bowl. Steep 8 egg white halves in each bowl, tinting the egg whites pink, light blue, and green. If color is too pale, add more food coloring to bowls. Drain colored egg whites on paper towels."
    },
    {
      "position": 5,
      "text": "Pipe or spoon egg yolk filling into colored egg white halves; cover and chill before serving, at least 30 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

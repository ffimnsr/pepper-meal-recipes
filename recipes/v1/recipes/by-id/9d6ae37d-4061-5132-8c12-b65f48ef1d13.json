  "id": "9d6ae37d-4061-5132-8c12-b65f48ef1d13",
  "slug": "chicken-florentine-dip",
  "name": "Chicken Florentine Dip",
  "recipe_type": "appetizer",
  "brief_description": "Make this cheesy chicken Florentine dip your go-to for parties. It's quick to make and you can easily double it for large gatherings.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine condensed soup, chicken, sour cream mozzarella cheese, 1/2 cup skim milk, and Parmesan cheese in a slow cooker. Add spinach, pulling it apart and shredding it as you put it in. Mix until well blended."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low until all cheeses are melted and the dip is deliciously gooey, 1 to 1 1/2 hours. Add up to 1/2 cup more milk if you feel the dip is cooking up too thick."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

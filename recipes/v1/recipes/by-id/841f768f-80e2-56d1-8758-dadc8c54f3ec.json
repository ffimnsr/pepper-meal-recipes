  "schema_version": 1,
  "id": "841f768f-80e2-56d1-8758-dadc8c54f3ec",
  "slug": "sri-lankan-caramelized-pineapple-upside-down-cake",
  "name": "Sri Lankan Caramelized Pineapple-Upside Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This Sri Lankan version of pineapple upside-down cake made with caramelized jaggery and star anise makes a great treat for afternoon tea.",
  "cuisine": "Sri Lankan",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter for topping in a medium saucepan over medium heat. Add jaggery and bring to a simmer, stirring every so often until jaggery is dissolved. Once it starts to bubble, turn off heat and immediately pour the mixture into a 9-inch round cake pan. Arrange pineapple slices on top of the caramel mixture. Set aside while you prepare the cake."
    },
    {
      "position": 3,
      "text": "Combine almond flour, cornmeal, baking powder, and salt in a bowl. Grind star anise pod with a mortar and pestle and add to the flour mixture."
    },
    {
      "position": 4,
      "text": "Beat butter in a bowl with an electric mixer until smooth and creamy. Add sugar and beat until creamed together. Beat in eggs on high speed until combined. Mix in vanilla and lemon zest. Pour the dry ingredients into the wet ingredients and beat on low speed until combined and no lumps remain; do not overmix. Pour batter over the pineapple topping in the pan and spread evenly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 45 minutes; do not overbake."
    },
    {
      "position": 6,
      "text": "Remove from the oven and place on a wire rack; let cool for 10 to 15 minutes. Invert cake onto a cake stand or serving plate."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

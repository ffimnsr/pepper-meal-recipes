  "id": "b0936bf7-e3d6-5636-8669-f3ef5d352c3c",
  "slug": "tasty-collard-greens",
  "name": "Tasty Collard Greens",
  "recipe_type": "side",
  "brief_description": "This recipe for Southern collard greens with smoked turkey is a classic Thanksgiving favorite. Crushed red pepper flakes add a spicy kick!",
  "cuisine": "Southern American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Add garlic; gently saut\u00e9 until fragrant and golden brown, about 1 minute. Pour in chicken stock and add turkey leg; cover and simmer for 30 minutes."
    },
    {
      "position": 2,
      "text": "Add collard greens and increase heat to medium-high. Cover and cook, stirring occasionally, until greens have cooked down, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium. Season with salt and pepper to taste; cover and continue to cook until greens are tender and dark green, 45 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Drain greens, reserving cooking liquid. Mix in red pepper flakes if desired. Use reserved cooking liquid to reheat leftovers."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

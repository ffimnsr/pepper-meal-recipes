  "schema_version": 1,
  "id": "291e693d-11e0-533e-97c3-0be7daf14056",
  "slug": "apple-cider-turkey-gravy-recipe-11810821",
  "name": "Apple Cider Turkey Gravy",
  "recipe_type": "soup",
  "brief_description": "This rich, make-ahead apple cider turkey gravy starts with making a flavorful homemade turkey stock, then finishes with pan drippings, a silky roux, and a splash of reduced apple cider for depth. It\u2019s smooth, savory, and perfect for pouring generously over turkey, potatoes, and all your holiday favorites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Place turkey legs and wings on a heavy baking sheet, rub lightly with oil, and season with salt, pepper, rosemary, and thyme."
    },
    {
      "position": 2,
      "text": "Roast in the preheated oven until golden brown, about 45 minutes. Reserve drippings; discard herbs."
    },
    {
      "position": 3,
      "text": "Transfer roasted legs and wings to a large stock pot. Add carrots, celery, onion, and fresh sage. Cover with water approximately 1 inch over the turkey parts and bring to a boil. Reduce to a low simmer and cook until stock is rich in flavor, 3 to 4 hours, skimming occasionally. Strain and discard solids."
    },
    {
      "position": 4,
      "text": "Meanwhile, pour apple cider into in a small saucepan and simmer over medium heat until reduced by about half. Set aside."
    },
    {
      "position": 5,
      "text": "After roasting the turkey wings and legs, scrape up any browned bits from the baking sheet and transfer those along with any drippings to a saucepan. Add 1/2 cup turkey stock and cook over low heat."
    },
    {
      "position": 6,
      "text": "Sprinkle in 3 tablespoons of flour, whisking constantly to form a roux. Cook for 2 to 3 minutes until lightly browned (this prevents a floury taste)."
    },
    {
      "position": 7,
      "text": "Slowly whisk in 3 cups turkey stock and the reduced apple cider, 1 cup at a time, until smooth and thickened. Simmer gently for 5 to 10 minutes. Season with salt and pepper to taste."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 270,

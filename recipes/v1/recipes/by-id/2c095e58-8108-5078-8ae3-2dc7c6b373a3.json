  "id": "2c095e58-8108-5078-8ae3-2dc7c6b373a3",
  "slug": "breakfast-pasta-for-dinner",
  "name": "Breakfast Pasta for Dinner",
  "recipe_type": "breakfast",
  "brief_description": "Eggs, bacon, and Parmesan cheese make a rich, creamy sauce in this carbonara-like pasta dish that feels like you're having breakfast for dinner!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, for 8 minutes. Pasta should still be firm. Drain."
    },
    {
      "position": 2,
      "text": "At the same time, place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels and crumble when cool enough to handle. Reserve bacon drippings in the skillet."
    },
    {
      "position": 3,
      "text": "Return crumbled bacon to the skillet with green onion and garlic; cook in the drippings over medium heat until onion starts to soften, about 5 minutes. Add drained spaghetti and mix well."
    },
    {
      "position": 4,
      "text": "Slowly add beaten eggs and scramble with the spaghetti mixture for 1 to 2 minutes. Season with salt and pepper. Add Parmesan cheese, garlic powder, and onion powder; continue to scramble until all ingredients are combined. Stir in diced tomatoes and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

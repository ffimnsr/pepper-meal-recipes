  "id": "0c2ca1e8-26ec-55fb-ac1a-f060253df01c",
  "slug": "thumbprint-cookies-iii",
  "name": "Thumbprint Cookies III",
  "recipe_type": "dessert",
  "brief_description": "Like a butter cookie rolled in nuts with jam in the center. I make these every Christmas to give to relatives and friends. They all love this cookie! For even more flavorful cookies, try using almond extract instead of the vanilla.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar in large bowl at low speed until mixture becomes fluffy. Separate the eggs and beat in egg yolks, vanilla and salt until blended. Add flour all at once. Beat at low speed, scraping side of bowl often, 2 minutes or until well mixed."
    },
    {
      "position": 3,
      "text": "Beat egg whites, slightly."
    },
    {
      "position": 4,
      "text": "Roll dough into 1 inch balls and dip each ball into egg whites. Roll in nuts. Place about 1 inch apart on greased sheets. Make a depression in center of each cookie with thumb."
    },
    {
      "position": 5,
      "text": "Bake for about 10 minutes or until light brown. Cool on wire rack. Fill with jam. To Make Ahead: Cookies can be frozen after baking if you do not put jam in them. The cookies can also be dusted with confectioners' sugar."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": null,

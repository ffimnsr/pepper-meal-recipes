  "slug": "oh-so-good-chicken",
  "name": "Oh-So-Good Chicken",
  "recipe_type": "main",
  "brief_description": "Mexican-style seasonings and cooked mushrooms make this oh-so-good chicken and rice casserole recipe a tasty version of the family-friendly favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add mushrooms; cook and stir."
    },
    {
      "position": 3,
      "text": "Combine mushrooms, rice, salsa, chicken, Cheddar cheese, and sour cream in a bowl; transfer to a greased casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 to 35 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

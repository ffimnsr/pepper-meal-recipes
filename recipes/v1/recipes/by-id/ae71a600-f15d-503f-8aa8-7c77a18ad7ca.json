  "id": "ae71a600-f15d-503f-8aa8-7c77a18ad7ca",
  "slug": "chorizo-breakfast-casserole-recipe-8634313",
  "name": "Chorizo Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Chorizo adds heat and umami to this chorizo breakfast casserole, that is super easy to make. Cooking the bell pepper in the rendered fat helps add depth of flavor to the veggies, keeping every element nicely seasoned.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a 13- x 9-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high. Add chorizo, and cook, stirring to break up meat into small pieces, until browned, about 8 minutes. Transfer to a paper towel-lined plate. Do not wipe skillet clean."
    },
    {
      "position": 3,
      "text": "Add bell pepper and poblano to drippings in skillet; cook over medium, stirring occasionally, until softened, about 5 minutes. Remove skillet from heat."
    },
    {
      "position": 4,
      "text": "Whisk together eggs, half-and-half, garlic salt, onion powder, black pepper, and chili powder in a large bowl until fully combined. Stir in sausage, bell pepper and poblano, and cheeses until well combined."
    },
    {
      "position": 5,
      "text": "Spread hashbrowns in an even layer in prepared baking dish. Pour egg mixture over hashbrowns, pressing to fully submerge hash browns."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until eggs are set in center and top is golden brown, 40 to 45 minutes. Let stand for 10 minutes. Top evenly with avocado slices. Sprinkle evenly with scallions. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "schema_version": 1,
  "id": "0ec2497a-43ae-5bea-b414-58462a61c9ba",
  "slug": "sashas-vegan-borscht",
  "name": "Sasha's Vegan Borscht",
  "recipe_type": "soup",
  "brief_description": "This Russian family's vegan borscht recipe features lots of other root vegetables besides beets. Adding the cooked beets in the end gives the borscht its bright red color.",
  "cuisine": "Russian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Cut the greens off the beets. Remove stems and discard. Wash and dry leaves, then chop. Set aside."
    },
    {
      "position": 2,
      "text": "Scrub beets and place into a saucepan. Cover with water and bring to a boil. Reduce heat and cook, covered, until beets can be easily pierced with a knife, 30 to 40 minutes. Drain and rinse under cold water until cool enough to handle. Peel immediately and grate coarsely. Set aside."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large wide pot or Dutch oven over low heat. Add onion and slowly cook until soft and translucent, stirring often, 3 to 5 minutes. Add garlic and cook until fragrant without browning, about 1 minute."
    },
    {
      "position": 4,
      "text": "Add carrots, rutabaga, and parsnip and cook over medium heat until vegetables start to soften, 12 to 15 minutes. Sprinkle with brown sugar and continue cooking until vegetables start to brown in some spots, 3 to 5 minutes. Add 2 quarts water, cabbage, salt, and bay leaf; stir well."
    },
    {
      "position": 5,
      "text": "Bring to a boil, reduce heat, and simmer until the vegetables are soft, 10 to 15 minutes. Stir in beet greens in the last 2 minutes. Leave the pot uncovered so beet greens maintain their color."
    },
    {
      "position": 6,
      "text": "Mix in grated beets and remove borscht from the heat immediately to stop the cooking process; this will preserve its bright color. Season with vinegar, salt, and pepper."
    },
    {
      "position": 7,
      "text": "Serve sprinkled with parsley and a dollop of sour cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "slug": "dirt-road-martini-recipe-8707143",
  "name": "Dirt Road Martini",
  "recipe_type": "drink",
  "brief_description": "Dolly Parton and Rachel Parton George share their unique twist on a classic martini in their cookbook \"Good Lookin' Cookin'.\" In addition to olives, the sisters add in iced tea and pickled vegetables.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vodka, tea, and brine in an ice-filled mixing glass; stir well to chill."
    },
    {
      "position": 2,
      "text": "Fill a lowball or rocks glass with ice. Strain martini over ice. Garnish with olives and vegetable pieces."
    }
  ],

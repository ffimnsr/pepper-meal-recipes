  "id": "6658debd-5323-5d72-a369-0165f6cfc98d",
  "slug": "peanut-butter-bugle-bites-recipe-8724424",
  "name": "Peanut Butter Bugle Bites",
  "recipe_type": "appetizer",
  "brief_description": "These peanut butter bugle bites, made by tossing crunchy Bugles with a sweet peanut butter coating, then drizzling with melted chocolate, are the perfect sweet and salty snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment or waxed paper. Spread Bugles out on the sheet."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, peanut butter, and corn syrup in a small saucepan over medium heat. Bring mixture to a boil, stirring often. Boil for 2 minutes and remove from heat; stir in baking soda. Pour mixture over Bugles and toss quickly to coat and spread into an even layer."
    },
    {
      "position": 3,
      "text": "Combine chocolate chips and coconut oil in a small bowl. Melt in the microwave in 30 second increments, stirring in between each. Drizzle melted chocolate over bugles and let cool completely. For best results, refrigerate for 5 minutes to allow chocolate to harden. Break into large pieces; store in an airtight container in a cool dry place."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

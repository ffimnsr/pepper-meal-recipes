  "id": "70ec4884-0cf7-50b2-99f8-c9941a2c2fe4",
  "slug": "cavatelli-and-broccoli",
  "name": "Cavatelli and Broccoli",
  "recipe_type": "side",
  "brief_description": "This cavatelli and broccoli dish features blanched florets saut\u00e9ed in garlicky olive oil, then tossed with hot pasta, red pepper flakes, and Parmesan.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Cook broccoli in boiling water for about 5 minutes. Use a slotted spoon to remove broccoli to a large bowl and set aside."
    },
    {
      "position": 2,
      "text": "Season boiling water in the same pot with salt. Cook cavatelli in boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat. Saut\u00e9 garlic in hot oil until lightly golden, being careful not to burn it. Add broccoli; cook, stirring occasionally, until tender yet crisp to the bite, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Add cooked cavatelli to the skillet; toss well with broccoli mixture until warmed through. Season with salt and hot pepper flakes. Serve with Parmesan cheese."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

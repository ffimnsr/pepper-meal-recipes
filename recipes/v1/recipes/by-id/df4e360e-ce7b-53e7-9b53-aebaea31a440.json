  "id": "df4e360e-ce7b-53e7-9b53-aebaea31a440",
  "slug": "courts-creamy-and-quick-burritos",
  "name": "Court's Creamy and Quick Burritos",
  "recipe_type": "soup",
  "brief_description": "Court's creamy and quick burritos is a simple recipe for six beef burritos topped with creamy Cheddar cheese, mushroom soup, and sour cream sauce.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook ground beef and onion in a skillet over medium heat until beef is completely browned, 7 to 10 minutes. Drain excess grease from the skillet. Stir 1 cup Cheddar cheese, refried beans, and taco seasoning into ground beef; set aside."
    },
    {
      "position": 3,
      "text": "Combine soup, sour cream, and salsa in a bowl; spread about \u00bd into the bottom of a 9x13-inch baking dish. Set aside."
    },
    {
      "position": 4,
      "text": "Spoon beef mixture down center of each tortilla; roll tortillas around filling. Arrange rolled tortillas in a single layer in the baking dish, seam-sides down. Pour remaining \u00bd soup mixture over tortillas. Top with remaining 1 \u00bd cups Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is bubbly and melted, 30 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

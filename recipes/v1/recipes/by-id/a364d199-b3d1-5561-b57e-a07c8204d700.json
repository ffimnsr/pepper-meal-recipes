  "slug": "alfredo-sauce",
  "name": "Alfredo Sauce",
  "recipe_type": "side",
  "brief_description": "This creamy Alfredo sauce recipe makes a rich and creamy sauce flavored with garlic and Parmesan cheese that's delicious tossed with warm pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium saucepan over low heat; stir in cream and simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk in cheese and garlic, whisking continuously until heated through. Stir in parsley."
    },
    {
      "position": 4,
      "text": "Serve immediately and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

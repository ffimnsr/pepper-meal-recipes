  "id": "a70f90d0-ce78-5381-a7e6-bd952608f2c8",
  "slug": "chocolate-chip-shortbread-cookies-ii",
  "name": "Chocolate Chip Shortbread Cookies II",
  "recipe_type": "dessert",
  "brief_description": "Shortbread cookies with chocolate chips and pecans. If you don't like pecans, you could add toasted coconut instead. Don't be put off by the amount of butter, this recipe makes a very large batch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and 2 cups confectioners' sugar. Beat in the vanilla and coconut extracts and salt. Add flour one cup at a time, mixing well after each. Stir in the chocolate chips and pecans. Roll the dough into 1 inch balls and place them 2 inches apart onto an ungreased cookie sheet. Flatten with a fork dipped in confectioners' sugar."
    },
    {
      "position": 3,
      "text": "Bake for 12 to 15 minutes in the preheated oven, until a light golden brown. While cookies are still warm from the oven, dust with the remaining confectioners' sugar."
    }
  ],
  "servings": 96,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "59f7a6d9-1d07-50d7-9abb-a4ad5449ac64",
  "slug": "hawaiian-beef-stew",
  "name": "Hawaiian Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This hearty Hawaiian beef stew is made of beef chuck, potatoes, and carrots simmered together and enhanced with tomato paste, red wine, and spices.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a pot over medium-high heat. Add beef; cook and stir until browned, about 10 minutes. Add garlic; cook until aromatic, 2 to 3 minutes. Add wine; cook until alcohol has cooked off, about 5 minutes. Add celery and onions; cook until tender, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour 10 cups water into the pot. Add tomato paste, salt, sugar, bay leaves, and pepper. Bring to a boil. Lower heat to medium-low. Cover and cook stew until beef is tender, about 1 hour."
    },
    {
      "position": 3,
      "text": "Place carrots into stew; cook until slightly tender, about 10 minutes. Add potatoes; cook until tender, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Mix cornstarch and 1/4 cup water together in a bowl; add to the stew. Let simmer until thickened, about 3 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 30,

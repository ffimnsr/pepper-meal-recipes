  "id": "2ed3a810-c9ad-53d8-a631-a63f9e4c1266",
  "slug": "chex-muddy-buddies",
  "name": "Chex Muddy Buddies",
  "recipe_type": "dessert",
  "brief_description": "This Muddy Buddies party mix made with Chex cereal, chocolate, peanut butter, butter, vanilla, and sugar is a fun, sweet, and crunchy snack that's easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine rice, corn, and chocolate cereals in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Place chocolate chips, peanut butter, and butter in a 1-quart microwave-safe bowl. Microwave, uncovered, on high for 1 minute; stir. Continue microwaving mixture until smooth and combined, about 30 seconds more. Stir in vanilla extract."
    },
    {
      "position": 4,
      "text": "Pour chocolate mixture over cereals; stir until evenly coated. Transfer to a 2-gallon resealable plastic bag."
    },
    {
      "position": 5,
      "text": "Add confectioners' sugar to the bag and seal; shake until well-coated."
    },
    {
      "position": 6,
      "text": "Spread cereal mixture onto waxed paper to cool."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 18,

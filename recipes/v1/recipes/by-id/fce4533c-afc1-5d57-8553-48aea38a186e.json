  "slug": "guacamole-with-nopales-mexican-cactus",
  "name": "Guacamole with Nopales (Mexican Cactus)",
  "recipe_type": "appetizer",
  "brief_description": "This easy recipe for guacamole con nopales (guacamole with cactus) comes straight from Mexico where guacamole comes in many yummy variations.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a small nonstick skillet over medium heat. Add nopales and cook, stirring occasionally, until soft, about 10 minutes. Let cool."
    },
    {
      "position": 2,
      "text": "Mash avocado in a bowl with lime juice, olive oil, and salt. Stir in tomato, jalapeno, cilantro, and cooked nopales."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

  "slug": "sweet-and-mild-cooked-tomato-salsa",
  "name": "Sweet and Mild Cooked Tomato Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This slowly-simmered salsa featuring fresh tomatoes and canned green chiles is a delightfully-sweet dip.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the tomatoes, onion, green chiles, vinegar, brown sugar, garlic powder, cumin, oregano, coriander, salt, and hot sauce in a Dutch oven or large pot over medium-low heat. Simmer, stirring occasionally, until the salsa reaches your preferred consistency, about 3 hours. Store in refrigerator until using."
    }
  ],

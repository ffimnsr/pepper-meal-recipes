  "id": "9d838688-1fba-5a66-bddd-e6d86246b178",
  "slug": "chicken-bhuna-recipe-7485475",
  "name": "Chicken Bhuna",
  "recipe_type": "main",
  "brief_description": "Chicken bhuna is a rich Indian curry that's easy to make with fried onions, fragrant spices, garlic, tomatoes, and chiles for a delicious takeaway meal at home.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a nonstick pan over high heat. Add onion and salt; cook and stir until onion has softened, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to low; stir in garlic and ginger until fragrant. Add hot water; cover, and cook, stirring occasionally, until water has evaporated, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add chili powder, ground coriander, cumin, and turmeric; cook and stir over high heat until spices are toasted, about 5 minutes. Stir in tomatoes and green chiles; cover and cook over low heat for 5 minutes."
    },
    {
      "position": 4,
      "text": "Add chicken; cook and stir over high heat until browned, 5 to 7 minutes. Stir in curry paste; reduce heat to low, cover and cook until chicken is cooked through, adding a little water if necessary, about 5 minutes. Check seasoning and sprinkle with freshly chopped cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

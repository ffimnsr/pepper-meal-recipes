  "id": "4e70dcea-90b5-51ed-920b-5685953d8b5f",
  "slug": "dallas-style-sloppy-joes",
  "name": "Dallas-Style Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "A zesty sauce, fresh onion, and bell pepper make this easy-to-make sandwich a Dallas-area favorite.",
  "cuisine": "Southwestern American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook the ground beef in a large skillet over medium heat until completely browned, 5 to 7 minutes. Add the onion and bell pepper, season with sea salt and black pepper, and cook until vegetables soften, about 7 minutes."
    },
    {
      "position": 2,
      "text": "Stir in the ketchup, vinegar, Worcestershire sauce, brown sugar, mustard, and barbeque sauce. Reduce heat to low and simmer the mixture until thickened, about 10 minutes. Add Parmesan cheese and serve on toasted hamburger buns."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

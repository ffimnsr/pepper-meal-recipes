  "id": "ad0eaeb3-e9fe-5ac2-84d9-acc1e01d4366",
  "slug": "bacon-and-eggs-potato-salad",
  "name": "Bacon and Eggs Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This bacon and eggs potato salad recipe is loaded with crispy bacon, hard-boiled eggs, minced onion, peas, and mustard in a creamy mayonnaise dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain and set aside to cool."
    },
    {
      "position": 2,
      "text": "Mix potatoes, mayonnaise, peas, eggs, bacon, onion, mustard, salt, and pepper together in a bowl. Refrigerate to allow flavors to blend and bacon to soften, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

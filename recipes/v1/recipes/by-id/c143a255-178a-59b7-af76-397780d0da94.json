  "id": "c143a255-178a-59b7-af76-397780d0da94",
  "slug": "pressure-cooker-beef-stew",
  "name": "Pressure Cooker Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This pressure cooker beef stew recipe features tender cubes of beef cooked with onions, carrots, and potatoes in a thick gravy in just 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in the bottom of a pressure cooker over medium-high heat. (If the cooker has an insert, remove it, and cook directly in the bottom of the pot.) Add beef and onion; cook until beef is browned on the outside."
    },
    {
      "position": 2,
      "text": "Stir in 2 cups water, carrots, and bouillon cubes. Close the lid and secure the pressure regulator. Heat until mixture sizzles, then reduce heat to medium and set the timer for 20 minutes. If you have an adjustable pressure regulator, set it for 10 pounds of pressure."
    },
    {
      "position": 3,
      "text": "Meanwhile, place potatoes in a saucepan with enough water to cover. Bring to a boil and cook until tender, about 10 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Let pressure release naturally according to manufacturer\u2019s instructions, 5 to 10 minutes. (Mine must sit under cold running water for 5 minutes until the lid can be released.)"
    },
    {
      "position": 5,
      "text": "Remove the lid and place the pot over medium heat. Bring to a boil. Stir cornstarch into a small amount of cold water in a small bowl to make a slurry. Stir slurry into stew; cook until thickened, 2 to 3 minutes. Add potatoes to stew or place in serving dishes and ladle stew over them."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

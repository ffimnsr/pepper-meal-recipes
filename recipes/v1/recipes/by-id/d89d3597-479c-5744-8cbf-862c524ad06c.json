  "id": "d89d3597-479c-5744-8cbf-862c524ad06c",
  "slug": "curry-tuna-and-rice-casserole",
  "name": "Curry Tuna and Rice Casserole",
  "recipe_type": null,
  "brief_description": "A childhood favorite of rice and tuna mixed with a curry twist.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cream of celery soup, milk, curry powder, and mustard powder in a large bowl. Stir rice, tuna, and onion into the soup mixture; transfer to a casserole dish."
    },
    {
      "position": 3,
      "text": "Mix bread crumbs, melted butter, and parsley in a bowl; sprinkle over tuna mixture."
    },
    {
      "position": 4,
      "text": "Bake casserole in preheated oven until bread crumb mixture is golden brown, about 25 minutes; top with sliced eggs and return to over to bake another 5 minutes. Let casserole cool 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f2d4b525-f266-5a1b-8219-d016ba5646c6",
  "slug": "french-onion-beef-and-noodles-recipe-8732520",
  "name": "French Onion Beef and Noodles",
  "recipe_type": "main",
  "brief_description": "This French onion beef and noodle dish tastes like an onion-y beef stroganoff topped with tasty fried onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a 4- to 5-quart Dutch oven over medium-high heat. Add beef stew meat. Cook until well-browned on all sides, stirring once or twice, 2 to 3 minutes. Transfer meat from Dutch oven to a plate."
    },
    {
      "position": 3,
      "text": "Add remaining 1 tablespoon oil to the Dutch oven. Add onion and garlic. Cook over medium heat until tender and starting to brown, stirring frequently, about 6 minutes. If needed, add a splash of broth to the Dutch oven. Scrape up any browned bits from the bottom of the Dutch oven with a wooden spoon."
    },
    {
      "position": 4,
      "text": "Return beef to the Dutch oven. Add remaining broth, soup, and pepper. Bring to a boil. Reduce heat and simmer, covered, 25 to 30 minutes or until meat is tender"
    },
    {
      "position": 5,
      "text": "Whisk together sour cream and Parmesan cheese in a small bowl."
    },
    {
      "position": 6,
      "text": "Add about 1/2 cup of hot broth mixture from the Dutch oven to the bowl. Stir to combine."
    },
    {
      "position": 7,
      "text": "Add mixture back to the pot and stir to combine."
    },
    {
      "position": 8,
      "text": "Add egg noodles to the pot. Cover and simmer, stirring occasionally, 5 to 7 minutes or until noodles and beef are tender."
    },
    {
      "position": 9,
      "text": "Top servings with French-fried onions and parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

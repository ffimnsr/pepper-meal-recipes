  "slug": "strawberry-chicken-salad-for-sandwiches",
  "name": "Strawberry Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This delightful strawberry chicken salad combines strawberries, chicken, and pecans with homemade poppy seed dressing for a zingy sandwich filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix mayonnaise, lemon juice, honey, and poppy seeds together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Add chicken, strawberries, pecans, celery, green onions, parsley; toss to combine. Season with salt and pepper."
    }
  ],
  "servings": 2,

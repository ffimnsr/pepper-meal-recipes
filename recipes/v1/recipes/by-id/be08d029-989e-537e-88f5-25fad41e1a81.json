  "id": "be08d029-989e-537e-88f5-25fad41e1a81",
  "slug": "quick-and-easy-yorkshire-pudding",
  "name": "Quick and Easy Yorkshire Pudding",
  "recipe_type": "side",
  "brief_description": "Yorkshire pudding is made with a simple batter of eggs, flour, and milk baked in sizzling hot fat for tall, fluffy, crispy puddings perfect for gravy.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat eggs and milk together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Stir in flour."
    },
    {
      "position": 4,
      "text": "Divide butter evenly into the cups of a 12-cup muffin tin, about 1/2 teaspoon per cup."
    },
    {
      "position": 5,
      "text": "Place the muffin tin in the preheated oven until butter has melted and is sizzling hot, 2 to 3 minutes. Remove from oven, and distribute batter evenly among each cup."
    },
    {
      "position": 6,
      "text": "Return to the oven and bake for 5 minutes. Reduce the heat to 350 degrees F (175 degrees C) and bake until puffed and golden, without peeking, about 25 minutes more. Serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

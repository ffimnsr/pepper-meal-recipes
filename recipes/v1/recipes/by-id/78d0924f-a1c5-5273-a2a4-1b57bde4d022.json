  "slug": "fresh-summer-salsa-recipe-11998317",
  "name": "Fresh Summer Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This fresh summer salsa is just right for a cookout or a picnic. With fresh corn, fresh peppers, pineapple, and canned black beans, it's marvelously crunchy, juicy, spicy, and completely delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir corn, bell pepper, jalapeno, pineapple, onion, black beans, cilantro, salt, cumin, and lime juice together in a medium bowl. Cover and refrigerate at least 30 minutes or up to one day. Stir before serving."
    }
  ],

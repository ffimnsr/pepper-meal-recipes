  "id": "d604bd8f-3529-5f56-b469-f7d1343fd07e",
  "slug": "mint-cucumber-mojitos",
  "name": "Mint-Cucumber Mojitos",
  "recipe_type": "drink",
  "brief_description": "These mojitos feature a refreshing burst of cucumber. We love these at special gatherings and summer barbeques. Make a pitcher ahead of time, and add the rum right before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Squeeze the lime quarters into a highball glass, and drop the limes into the glass. Add the mint leaves and sugar. Muddle well with the back of a spoon or with a muddler. Place the cucumber slices into the glass, and fill with ice cubes. Pour in the rum, then top off with club soda. Stir gently and serve."
    }
  ],

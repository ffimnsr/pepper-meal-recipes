  "id": "4726a9c1-4ccc-5350-88b5-fa884a5c1daf",
  "slug": "grilled-jalapeno-poppers",
  "name": "Grilled Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These grilled jalape\u00f1o poppers are stuffed with a creamy Cheddar cheese mixture, wrapped in bacon, and cooked until crispy and irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, Cheddar, Parmesan, and garlic powder together in a bowl until the mixture is thoroughly blended."
    },
    {
      "position": 3,
      "text": "Lay jalape\u00f1o pepper on a work surface and cut a lengthwise sliver from the side of the pepper, exposing seeds and white membrane. With the handle of a teaspoon, scrape out seeds and membrane, leaving the hollow pepper. Repeat for the rest of the peppers."
    },
    {
      "position": 4,
      "text": "Chop up pepper slivers and mix into cheese stuffing. Stuff each pepper with cheese mixture and wrap each stuffed pepper in a half bacon slice. Secure with toothpicks."
    },
    {
      "position": 5,
      "text": "Grill stuffed jalape\u00f1os on a less-hot part of the grill, turning as needed, until peppers are tender and juicy and bacon is browned and crisp, 30 to 40 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

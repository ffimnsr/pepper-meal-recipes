  "id": "526623b7-1cec-5f66-ba96-bbed7a95bc5e",
  "slug": "meatball-subs-on-a-stick-recipe-8780157",
  "name": "Meatball Subs on a Stick",
  "recipe_type": "appetizer",
  "brief_description": "These meatball subs on a stick are easy to make, fun to serve, and work as either an entree or an appetizer. Serve with warm marinara sauce for dipping.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Place skewers in water to soak. Line a sheet pan with parchment paper."
    },
    {
      "position": 2,
      "text": "For meatballs, combine beef, egg, bread crumbs, Parmesan cheese, onion, garlic paste, salt, oregano, parsley, basil, and chili flakes in a large bowl until evenly mixed."
    },
    {
      "position": 3,
      "text": "Weigh out 1.13 ounces of mixture and form it around 1 mozzarella cube. Roll in hands to ensure a tight seal. Place meatball on prepared pan; repeat with remaining mozzarella and meatball mixture to make 24 balls."
    },
    {
      "position": 4,
      "text": "On a lightly floured cutting board or other work surface, roll out pizza dough. Slice into 12 even strips."
    },
    {
      "position": 5,
      "text": "Place 2 meatballs on the work surface and coil 1 strip around them, alternating sides to form an S. Use finger tips to hold down the first meatball and gently insert the skewer through it and the dough, twisting the skewer slightly until it comes out the other end."
    },
    {
      "position": 6,
      "text": "In a separate bowl, combine melted butter, garlic and parsley. Using a pastry brush, brush the butter mixture over dough."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Serve with warmed marinara sauce."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

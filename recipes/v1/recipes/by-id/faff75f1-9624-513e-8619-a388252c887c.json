  "id": "faff75f1-9624-513e-8619-a388252c887c",
  "slug": "easy-apple-cider",
  "name": "Easy Apple Cider",
  "recipe_type": "drink",
  "brief_description": "This easy apple cider recipe flavored with cinnamon, whole cloves, and allspice is made in a slow cooker to keep it warm for as long as it lasts!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine apple cider and cinnamon sticks in a slow cooker."
    },
    {
      "position": 3,
      "text": "Place allspice and cloves onto the center of an 8-inch square piece of cheesecloth."
    },
    {
      "position": 4,
      "text": "Gather edges of the cheesecloth together and tie to secure; place in the slow cooker. Stir in brown sugar. Cook on High, covered, until mixture is steaming and sugar has dissolved. Reduce heat to Low and keep warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,

  "id": "6e637c94-8538-5e6d-bd39-6375f7954307",
  "slug": "bruschetta-iii",
  "name": "Bruschetta with Cheese",
  "recipe_type": "appetizer",
  "brief_description": "A bruschetta with cheese recipe with two kinds of cheeses make this simple appetizer or snack everyone's favorite. Adjust the herbs to taste.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice baguette into 1/2-inch thick diagonal slices. Arrange slices in a single layer on a baking sheet. Brush both sides of each slice with olive oil. Place tomato slices and a sprinkling of basil and oregano on bread slices. Sprinkle tomatoes, basil, and oregano with garlic powder and white pepper. Cover tomato slices with mozzarella and provolone. Place more basil, oregano, and tomato slices on top of the cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is bubbly, 7 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "55704bc4-404e-596f-9cbe-82b8c61702af",
  "slug": "zucchini-risotto",
  "name": "Zucchini Risotto",
  "recipe_type": "side",
  "brief_description": "This creamy main dish, zucchini risotto, with less butter and no wine, gets a splash of color by adding zucchini, sun-dried tomatoes, and fresh basil.",
  "cuisine": "Italian American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring stock to a boil in a saucepan, then reduce heat to a low simmer."
    },
    {
      "position": 2,
      "text": "Melt butter in a large, heavy bottomed stock pot over medium heat. Add onion; cook until softened, 2 minutes."
    },
    {
      "position": 3,
      "text": "Add rice; cook until lightly toasted, 2 minutes, stirring constantly. Gradually add simmering stock, stirring continuously. Risotto will become \u201ccreamy\u201d and slightly sticky. When almost finished, stir in zucchini, sun-dried tomatoes, and thyme, adding stock as needed and stirring continuously. When finished, the rice should be tender yet firm to the bite."
    },
    {
      "position": 4,
      "text": "Stir in 3 tablespoons Parmesan cheese and basil just before serving; divide among six bowls. Sprinkle servings with remaining 3 tablespoons cheese; season with black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

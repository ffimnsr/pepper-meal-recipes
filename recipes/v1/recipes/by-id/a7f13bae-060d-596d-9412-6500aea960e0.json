  "id": "a7f13bae-060d-596d-9412-6500aea960e0",
  "slug": "orange-pecan-french-toast",
  "name": "Orange Pecan French Toast",
  "recipe_type": "breakfast",
  "brief_description": "A simple baked French toast that won't have you slaving over a hot stove. An orange batter and caramel pecan coating make this baked French toast so delicious, you won't need any syrup.",
  "cuisine": "North American American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, stir together the brown sugar, melted butter, and corn syrup. Pour into a greased 9x13 inch baking dish, and spread evenly. Sprinkle pecans over the sugar mixture. Arrange the bread slices in the bottom of the dish so they are in a snug single layer."
    },
    {
      "position": 2,
      "text": "In a medium bowl, whisk together the orange zest, orange juice, milk, sugar, cinnamon, vanilla, egg whites, and eggs. Pour this mixture over the bread, pressing on the bread slices to help absorb the liquid. Cover and refrigerate for at least one hour, or overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C ). Remove the cover from the baking dish, and let stand for 20 minutes at room temperature."
    },
    {
      "position": 4,
      "text": "Bake for 35 minutes in the preheated oven, until golden brown. Dust with confectioners' sugar before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

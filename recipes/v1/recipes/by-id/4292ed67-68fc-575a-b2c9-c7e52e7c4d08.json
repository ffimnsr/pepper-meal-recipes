  "id": "4292ed67-68fc-575a-b2c9-c7e52e7c4d08",
  "slug": "low-and-slow-prime-rib",
  "name": "Low and Slow Prime Rib",
  "recipe_type": "main",
  "brief_description": "The simplest, most fail-safe version for cooking a Prime Rib - boneless or bone-in.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place beef on a pan, and rub with salt. Place meat on a rack or twisted foil so air can circulate under roast, and transfer to the fridge for 24 to 48 hours."
    },
    {
      "position": 3,
      "text": "Remove from the refrigerator and let it rest for a few hours to come to room temperature (optional)."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Transfer roast into a roasting pan, preferably on a rack."
    },
    {
      "position": 5,
      "text": "Mix butter with coarse salt, pepper, and cayenne in a small bowl and spread onto the sides and top of the roast. Then add more salt to the top. Pour water into the bottom of the pan."
    },
    {
      "position": 6,
      "text": "Roast in the preheated oven until internal temperature is 115 to 120 degrees F (46 to 48 degrees C), about 1 hour and 20 minutes (about 20 minutes per pound). Remove from the oven, cover with foil and let rest for at least 20 minutes before serving."
    },
    {
      "position": 7,
      "text": "Drippings from the pan can be deglazed with broth or water, and served alongside meat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1ba0b764-433f-5893-a8ed-4bfa9008531f",
  "slug": "pumpkin-spice-martini",
  "name": "Pumpkin Spice Martini",
  "recipe_type": "drink",
  "brief_description": "This pumpkin martini made with vanilla vodka, Irish cream, and pumpkin-flavored liqueur tastes like pumpkin pie in a glass—perfect for parties!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice."
    },
    {
      "position": 3,
      "text": "Pour vanilla-flavored vodka, Irish cream liqueur, and pumpkin-flavored liqueur over ice. Cover and shake until the outside of the shaker has frosted."
    },
    {
      "position": 4,
      "text": "Strain into a chilled martini glass. Garnish with ground cinnamon and ground nutmeg."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 1,

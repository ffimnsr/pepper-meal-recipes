  "id": "5c7f0988-80d2-5ed2-8cca-ba62644f5581",
  "slug": "vegan-overnight-oats-with-chia-seeds-and-fruit",
  "name": "Vegan Overnight Oats with Chia Seeds and Fruit",
  "recipe_type": "breakfast",
  "brief_description": "Chia seeds, oats, and banana soak overnight in almond milk for a nutritious vegan breakfast of champions. In the morning, it can either be eaten cold or heated up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine almond milk, bananas, oats, water, chia seeds, and cinnamon in a jar or airtight container; stir together. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Place oat mixture in a saucepan over low heat and gently cook for about 5 minutes. Divide between 2 bowls and top with blueberries, blackberries, and nectarine."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

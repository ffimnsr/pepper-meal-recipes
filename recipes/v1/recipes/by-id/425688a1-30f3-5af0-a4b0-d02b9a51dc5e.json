{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "425688a1-30f3-5af0-a4b0-d02b9a51dc5e",
  "slug": "garlic-and-citrus-mojo-pork-recipe-7509604",
  "name": "Garlic and Citrus Mojo Pork",
  "recipe_type": "main",
  "brief_description": "Chef John's roasted pork shoulder is marinated in a Caribbean-inspired marinade for 6 hours or overnight. Serve with baked beans and fresh lime.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mint, orange juice, fresh oregano, olive oil, garlic cloves, lime juice, salt, cumin, paprika, pepper, ground oregano, and cayenne pepper in a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Poke pork all over with a small sharp knife and place into a container just large enough to fit the meat. You can also use a resealable plastic bag."
    },
    {
      "position": 3,
      "text": "Pour over marinade and toss to coat. Spoon any excess marinade from the bottom of the container over the top of the meat before covering. Marinate in the refrigerator for 24 hours. You can go as few as 6 or as long as 48 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 5,
      "text": "Place onions in a roasting pan, and make a space in the middle. Place pork in the pan, fat side up, and transfer the marinade over the onions on each side. Pour in water."
    },
    {
      "position": 6,
      "text": "Transfer into the preheated oven and roast until internal temperature reaches 190 to 195 degrees F (87 to 90 degrees C), about 5 hours. For best results baste pork occasionally with liquids in the pan. Add more water if the pan gets too dry."
    },
    {
      "position": 7,
      "text": "When pork is done, remove from the oven, and cover with foil. Let rest for 1 hour."
    },
    {
      "position": 8,
      "text": "Serve by tearing meat apart like for pulled pork, or by removing large chunks, and slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 20,

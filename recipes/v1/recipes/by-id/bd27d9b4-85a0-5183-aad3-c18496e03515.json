  "schema_version": 1,
  "id": "bd27d9b4-85a0-5183-aad3-c18496e03515",
  "slug": "shrimp-and-pasta-shell-salad",
  "name": "Shrimp Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This shrimp pasta salad with celery, red bell pepper, paprika, dill, and Chef John's special dressing is sure to become your favorite summer salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1 \u00bc cups mayonnaise, Dijon mustard, ketchup, Worcestershire sauce, salt, and cayenne pepper together in a bowl; add lemon juice and 1/3 cup chopped dill. Whisk until thoroughly combined; keep refrigerated."
    },
    {
      "position": 2,
      "text": "Bring a pot of well-salted water to a boil and stir in pasta shells; cook until tender, 8 to 10 minutes. Drain and rinse with cold water to cool pasta slightly; drain again. Transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Toss shrimp with pasta; add red bell pepper, celery, and dressing to pasta mixture. Mix thoroughly to coat and fill shells with dressing. Cover bowl with plastic wrap and refrigerate until chilled, 2 to 3 hours."
    },
    {
      "position": 4,
      "text": "Stir salad again before serving and season to taste with more salt, black pepper, lemon juice, and cayenne pepper if desired. If salad seems a little dry, mix in a little more mayonnaise. Garnish with paprika and sprigs of dill."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

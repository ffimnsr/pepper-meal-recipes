  "id": "42ec4745-81d8-5d9d-bf57-a3cccd1b37cf",
  "slug": "savory-roasted-butternut-squash-soup",
  "name": "Savory Roasted Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This savory butternut squash soup is hearty with just the right amount of kick from cayenne pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Rub olive oil on the cut-side of butternut squash halves; sprinkle each with salt and black pepper. Lay squash, cut-side down, on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender, about 1 hour. Scoop squash flesh into a bowl, mash well, and set aside."
    },
    {
      "position": 4,
      "text": "Melt butter in a medium pot over medium heat. Cook and stir onion and garlic in melted butter until onion is slightly softened, 3 to 5 minutes. Add carrot; cook and stir until carrot and onion are tender, 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Stir mashed squash, marjoram, celery seed, cayenne pepper, salt, and black pepper into onion mixture; cook and stir until heated through, 5 to 10 minutes. Stir in chicken stock; bring mixture to a boil."
    },
    {
      "position": 6,
      "text": "Gradually add cream and cream cheese to squash mixture; stir until cream cheese is melted and incorporated. Bring to a simmer and cook until flavors blend, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

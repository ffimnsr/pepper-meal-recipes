  "id": "17589423-ceef-5191-99d4-c5359518691e",
  "slug": "amazing-slow-roasted-prime-rib",
  "name": "Amazing Slow-Roasted Prime Rib",
  "recipe_type": "drink",
  "brief_description": "This amazing slow-roasted prime rib recipe relies on a garlic, Worcestershire, and liquid seasoning marinade and slow-roasting to seal in all the juices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine liquid seasoning, Worcestershire sauce, and garlic in a bowl; pour over prime rib in a large glass or ceramic bowl. Marinate in the refrigerator for 1 to 2 hours, flipping every 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Place prime rib on a baking rack set inside a large baking dish."
    },
    {
      "position": 4,
      "text": "Cook in the preheated oven until all juices are sealed in, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Reduce oven temperature to 325 degrees F (165 degrees C). Continue cooking until an instant-read thermometer inserted into center reads 130 to 140 degrees F (54 to 60 degrees C), about 2 hours more."
    },
    {
      "position": 6,
      "text": "Rest prime rib sit before slicing, 30 minutes to 1 hour."
    }
  ],
  "servings": 24,

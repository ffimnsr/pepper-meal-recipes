  "id": "5b83b6cd-8d16-5970-8fdc-a2be91e53fbf",
  "slug": "sausage-breakfast-dumplings-recipe-11864962",
  "name": "Sausage Breakfast Dumplings",
  "recipe_type": "breakfast",
  "brief_description": "These breakfast sausage dumplings, biscuits wrapped around savory sausage and swaddled in a pepper-flecked cream gravy, land somewhere between cozy casserole and diner-style indulgence. It\u2019s the kind of morning bake that feels unashamedly comforting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Separate biscuits; split each biscuit horizontally to form 16 rounds. Flatten rounds slightly. Place 1 sausage half in center of each round; wrap dough around sausage, and pinch to seal."
    },
    {
      "position": 3,
      "text": "Place seam side down in an even layer in the prepared baking dish. Brush with 2 tablespoons melted butter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown and set, 18 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, heat remaining 1/4 cup butter in a medium saucepan over medium heat. Whisk in flour; cook, whisking constantly, until smooth and lightly bubbling, 1 to 2 minutes. Slowly whisk in milk until smooth. Stir in Worcestershire, salt, pepper, garlic powder, onion powder, and hot sauce. Bring to a simmer and cook, whisking often, until slightly thickened, 5 to 8 minutes."
    },
    {
      "position": 6,
      "text": "Pour gravy evenly over partially baked dumplings. Sprinkle with Cheddar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until gravy bubbles and cheese melts, about 5 minutes. Garnish with more black pepper and serve. Recipe developed by Marianne Williams"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

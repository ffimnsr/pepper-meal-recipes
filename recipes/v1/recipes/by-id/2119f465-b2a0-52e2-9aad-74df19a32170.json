{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2119f465-b2a0-52e2-9aad-74df19a32170",
  "slug": "greek-style-stuffed-peppers",
  "name": "Greek-Style Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "One of the few dishes that is better served cold rather than hot. Absolutely delicious and very Mediterranean!!! It can be made vegetarian by replacing meat with soya.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place green and red bell peppers in a bowl with enough warm water to cover, and soak 5 minutes."
    },
    {
      "position": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Place pork and onions in the skillet, season with salt and pepper, and cook until pork is evenly brown. Drain grease, and mix in wine and tomato puree. Continue cooking 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer skillet mixture to a large bowl, and mix in feta cheese, cooked rice, raisins, pine nuts, and parsley. Stuff peppers with the mixture, and arrange in a baking dish. Cover with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake 30 minutes in the preheated oven. Remove foil, and continue baking 10 minutes, until stuffing is lightly browned. May be served hot or cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

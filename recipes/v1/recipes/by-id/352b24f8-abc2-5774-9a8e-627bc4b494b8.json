  "id": "352b24f8-abc2-5774-9a8e-627bc4b494b8",
  "slug": "puerto-rican-canned-corned-beef-stew",
  "name": "Puerto Rican Canned Corned Beef Stew",
  "recipe_type": "soup",
  "brief_description": "Use corned beef in a can and other common pantry items to make this delicious and satisfying stew for a weeknight dinner the whole family will love.",
  "cuisine": "Puerto Rican American Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a small pot of water to a boil. Add potato and cook, uncovered, until slightly tender, about 5 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet or Dutch oven over medium-high heat. Add drained potatoes, corn, sofrito, and garlic; cook and stir until fragrant, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Add tomato sauce, oregano, and bay leaf; cook and stir until flavors combine, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Add water and bring to a boil. Reduce the heat to medium-low and stir in corned beef; cook until heated through, 6 to 8 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

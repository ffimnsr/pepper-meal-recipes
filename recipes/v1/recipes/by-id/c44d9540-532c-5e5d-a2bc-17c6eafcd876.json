  "id": "c44d9540-532c-5e5d-a2bc-17c6eafcd876",
  "slug": "cranberry-sauce",
  "name": "Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "This cranberry sauce recipe combines fresh cranberries, sugar, and orange juice to make a bright and tangy Thanksgiving classic in just 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat sugar and juice in a medium saucepan over medium heat until sugar dissolves."
    },
    {
      "position": 2,
      "text": "Add cranberries; cook until they start to pop and sauce starts to thicken, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and transfer sauce to a bowl; it will thicken as it cools."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

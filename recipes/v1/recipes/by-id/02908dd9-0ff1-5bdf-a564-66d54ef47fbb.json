  "id": "02908dd9-0ff1-5bdf-a564-66d54ef47fbb",
  "slug": "midwest-salisbury-steak",
  "name": "Midwest Salisbury Steak",
  "recipe_type": "dessert",
  "brief_description": "This Salisbury steak recipe uses ground sirloin to get a leaner, meatier-tasting main dish with enough mushroom and onion gravy to top your sides, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Make the patties: Mix ground sirloin, panko bread crumbs, egg, milk, 1/2 packet onion soup mix, Worcestershire sauce, and black pepper together in a large bowl; shape into 5 patties."
    },
    {
      "position": 3,
      "text": "Heat a skillet over medium heat. Cook patties in the hot skillet until browned, 3 to 5 minutes per side."
    },
    {
      "position": 4,
      "text": "Make the gravy: Melt butter in a separate skillet over medium-high heat. Saut\u00e9 mushrooms and onion in melted butter until tender, about 5 minutes. Stir flour and remaining 1/2 packet onion soup mix into mushroom mixture until combined."
    },
    {
      "position": 5,
      "text": "Gradually add beef stock and water, stirring continually, until simmering. Reduce heat to medium; cook, stirring frequently, until gravy has thickened, about 4 to 5 minutes. Season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Place browned patties into gravy; simmer until very tender, about 30 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b0890d3a-a252-56c0-a3b5-87b2fdb8415b",
  "slug": "strawberry-balsamic-pasta-salad-recipe-12004145",
  "name": "Strawberry Balsamic Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This strawberry balsamic pasta salad is a perfect spring and summer side dish for a picnic or backyard cookout. Strawberries work surprisingly well with pasta, especially when combined with a slightly sweet balsamic dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add cellentani, stir occasionally, and following package directions, cook until tender, typically around 10 to 12 minutes. Drain, rinse under cold water, and cool for several minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk olive oil, balsamic vinegar, maple syrup, and Dijon mustard together in a small bowl. Season to taste with salt and pepper and set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine cooked pasta, strawberries, mozzarella pearls, red onion, and basil. Drizzle with dressing, and toss gently. Taste, and adjust seasonings, if necessary. Sprinkle with toasted sliced almonds and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "a05d4fa8-ee46-5d91-8f2a-f9db8c34f318",
  "slug": "malted-milk-funfetti-bars-recipe-8603260",
  "name": "Malted Milk Funfetti Bars",
  "recipe_type": "dessert",
  "brief_description": "Malted milk powder flavors these malted milk funfetti bars, with crispy edges and ooey-gooey-chewy centers, combining two favorite flavors into one easy and delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "In a large bowl, beat cream cheese, brown sugar, and melted butter until smooth. Add in egg, vanilla, and almond extract; mix until thoroughly combined. Add in flour, malted milk powder, salt, and baking soda and mix until just incorporated. Fold in white chocolate chips and sprinkles."
    },
    {
      "position": 3,
      "text": "Spread batter evenly into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bars are golden and just set, 25 to 30 minutes. Allow bars to cool completely in he pan before removing using parchment overhang. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3181debd-02ea-5962-be9c-5f9a0ee210f6",
  "slug": "seafood-gumbo",
  "name": "Seafood Gumbo",
  "recipe_type": "soup",
  "brief_description": "A recipe for seafood gumbo that contains oysters, crab, and shrimp in a spicy thick broth made with spices, aromatic vegetables, and a dark roux.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the red, white, and black peppers, paprika, thyme, oregano, bay leaf, and salt; set aside."
    },
    {
      "position": 2,
      "text": "In a heavy pot, 5 quart or larger, heat oil over medium heat, warming the pot first. Add onions, celery, and green pepper. Turn heat to high. Stirring frequently, add garlic, file, hot sauce, and the pepper-herb mixture. Cook for 5 minutes, stirring constantly."
    },
    {
      "position": 3,
      "text": "Add tomato sauce, and stir as it reduces over high heat. Add fish stock and bring to a boil. Reduce heat, and simmer for 1 hour, stirring occasionally."
    },
    {
      "position": 4,
      "text": "When ready to serve, add shrimp, oysters, and crabmeat. Cover, and wait 5 minutes. Turn off heat, and let stand for 10 minutes. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "schema_version": 1,
  "id": "1b6e602b-16f9-507e-8ba3-ef6d1048ad98",
  "slug": "peanut-butter-balls-iii",
  "name": "Peanut Butter Balls",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter balls recipe is a no-bake wonder\u2014rich and creamy from peanut butter, crunchy from rice cereal, and dipped in a chocolaty coating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt peanut butter and butter together in a medium saucepan over low heat; stir often."
    },
    {
      "position": 2,
      "text": "Mix confectioners' sugar and cereal together in a large bowl until well combined. Pour in peanut butter mixture and stir until well combined; mixture will be crumbly but will hold together when pressed."
    },
    {
      "position": 3,
      "text": "Form into 1-inch balls; place on parchment-lined cookie sheets. Cover with plastic wrap and refrigerate until firm, 3 hours to overnight."
    },
    {
      "position": 4,
      "text": "Melt chocolate in a double boiler over low heat."
    },
    {
      "position": 5,
      "text": "Place 1 peanut butter ball into chocolate; use 2 forks to roll in mixture to coat. Let excess chocolate drip back into the pot; place on a wire rack set over parchment paper. Repeat with remaining peanut butter balls."
    },
    {
      "position": 6,
      "text": "Refrigerate until firm before serving."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

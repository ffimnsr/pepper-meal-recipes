  "id": "aa30d126-875c-55f0-a848-d2dc18f5198e",
  "slug": "easy-lemon-pepper-chicken-wings",
  "name": "Easy Lemon-Pepper Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "Lemon-pepper wings inspired by a restaurant favorite. Quick, easy, and delicious, and with just 4 ingredients they're a game-day (or any-day) winner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Stir olive oil and lemon-pepper seasoning together in a bowl; set aside."
    },
    {
      "position": 4,
      "text": "Fry wings in hot oil until no longer pink at the bone and the juices run clear, about 8 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Toss hot wings with lemon-pepper mixture to coat."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

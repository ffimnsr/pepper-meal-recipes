  "id": "e9cbec74-4ffc-5aff-8593-d767bbaed469",
  "slug": "oven-baked-caramel-french-toast",
  "name": "Oven-Baked Caramel French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This oven-baked caramel French toast combines buttery caramel, pecans, and custardy bread in an easy overnight breakfast perfect for brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1 cup brown sugar, 1/2 cup butter, and 2 tablespoons corn syrup in a small saucepan. Cook over medium heat, stirring constantly, until thickened."
    },
    {
      "position": 2,
      "text": "Pour caramel mixture into a 9x13-inch baking dish; sprinkle with 1/2 cup pecans. Place 6 bread slices on top; sprinkle with remaining pecans and cover with remaining 6 bread slices."
    },
    {
      "position": 3,
      "text": "Combine eggs, milk, cinnamon, vanilla, nutmeg, and salt in a blender; blend until smooth. Pour egg mixture evenly over bread slices. Cover baking dish with plastic wrap; refrigerate 8 hours or overnight."
    },
    {
      "position": 4,
      "text": "Remove French toast from refrigerator 30 minutes prior to baking. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the French toast is puffed, lightly browned, and a knife inserted in the center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, make the caramel sauce: Combine remaining 1/2 cup brown sugar, remaining 1/4 cup butter and remaining 1 tablespoon corn syrup; cook until thickened, stirring constantly."
    },
    {
      "position": 7,
      "text": "Drizzle warm sauce over French toast just before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

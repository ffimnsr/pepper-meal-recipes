  "slug": "boiled-peanuts",
  "name": "Boiled Peanuts",
  "recipe_type": "appetizer",
  "brief_description": "Boiled peanuts, cooked in salt water until soft and juicy, are a Southern staple and make a tasty, savory snack that will be an instant favorite.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Wash peanuts and place them in a pot. Add salt, then water to cover. Bring water to a boil."
    },
    {
      "position": 2,
      "text": "Let peanuts boil in water for at least 3 hours."
    },
    {
      "position": 3,
      "text": "After three hours, take out a peanut and try it \u2013 if it\u2019s not soft enough, keep boiling until the desired softness is reached."
    }
  ],

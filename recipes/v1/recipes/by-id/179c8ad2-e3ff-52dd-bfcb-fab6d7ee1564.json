  "id": "179c8ad2-e3ff-52dd-bfcb-fab6d7ee1564",
  "slug": "ham-and-cheese-quiche",
  "name": "Ham and Cheese Quiche",
  "recipe_type": "breakfast",
  "brief_description": "A Swiss cheese, spinach and mushroom layer is topped with a thick egg mixture, a layer of ham and a sprinkling of Cheddar. This robust pie is tucked into an oven and baked for an hour. It \u2018s perfect for lunch or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat together flour, salt, half-and-half and eggs in a medium bowl."
    },
    {
      "position": 3,
      "text": "Place Swiss cheese flat in the pie crust. Arrange spinach evenly over Swiss cheese, then cover with mushrooms. Pour the flour and egg mixture over mushrooms. Cover with flaked ham and top with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven 45 to 55 minutes, until surface is golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

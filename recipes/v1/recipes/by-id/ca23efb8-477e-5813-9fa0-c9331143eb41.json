  "slug": "reese-s-cup-overnight-oats-recipe-11695967",
  "name": "Reese's Cup Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These Reese\u2019s Cup overnight oats with peanut butter and chocolate prove that the flavors of overnight oats are limited only by your imagination.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, protein shake, Greek yogurt, and peanut butter syrup in a mason jar with a tight-fitting lid and stir well. Close the lid and refrigerate overnight."
    },
    {
      "position": 2,
      "text": "Add chocolate chips to a microwave-safe bowl. Microwave on High in 30 second intervals, stirring until smooth. Pour melted chocolate on top of oats. Add peanut butter in small dollops, and swirl into melted chocolate."
    }
  ],

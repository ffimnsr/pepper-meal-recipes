  "id": "d8b21a31-5fe3-5bb5-bd45-4f516ec6b8a1",
  "slug": "pumpkin-spice-soft-sugar-cookies",
  "name": "Pumpkin Spice Soft Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "A delicious cross between a pumpkin pie and soft sugar cookies, these pumpkin spice sugar cookies are loaded with all the flavors of fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat 2 cups sugar and butter with an electric mixer in a large bowl until creamy. Add eggs and vanilla; beat until smooth."
    },
    {
      "position": 2,
      "text": "Sift flour, pumpkin pie spice, baking powder, and salt together. Add flour mixture to butter mixture and beat until flour is completely incorporated. Cover and refrigerate until chilled, at least 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray baking sheets with cooking spray."
    },
    {
      "position": 4,
      "text": "Pour remaining 1/4 cup sugar into a shallow bowl. Fill another small bowl with water."
    },
    {
      "position": 5,
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets. Moisten the bottom of a glass with water, then dip it in sugar. Gently flatten cookie dough with the bottom of the sugared glass, rewetting and dipping as necessary."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until set, 5 to 7 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

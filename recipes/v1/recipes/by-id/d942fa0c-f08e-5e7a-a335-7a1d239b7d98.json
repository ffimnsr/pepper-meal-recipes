  "id": "d942fa0c-f08e-5e7a-a335-7a1d239b7d98",
  "slug": "mini-sloppy-joes-with-pulled-pork",
  "name": "Mini Sloppy Joes with Pulled Pork",
  "recipe_type": "main",
  "brief_description": "Leftover pulled pork can easily be turned into these sloppy Joe-type sandwiches for a twist on hamburger.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large nonstick skillet over medium heat. Add onion and bell pepper, and cook, stirring, about 5 minutes. Add beef stock, ketchup, brown sugar, Worcestershire sauce, mustard, garlic, and chili powder; stir until well mixed."
    },
    {
      "position": 2,
      "text": "Mix in pulled pork until well combined. Season with hot sauce, salt, and pepper. Bring mixture to a boil, reduce heat to low, and allow to bubble gently until thickened and reduced, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Place about 1/2 cup of the mixture on each sliced mini Kaiser roll and serve immediately."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "439b3129-2695-57f8-9579-2235a7520245",
  "slug": "classic-bloody-mary",
  "name": "Classic Bloody Mary",
  "recipe_type": "drink",
  "brief_description": "This classic Bloody Mary is made from scratch with vodka, tomato juice, and simple seasonings for a savory, spicy cocktail perfect for brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour salt onto a small plate. Moisten the rim of a glass and press into the salt. Fill the glass with ice cubes."
    },
    {
      "position": 3,
      "text": "Fill a cocktail shaker with ice cubes; add vegetable juice cocktail, vodka, Worcestershire sauce, hot pepper sauce, salt, and pepper. Cover and shake until the outside of shaker has frosted, about 20 seconds."
    },
    {
      "position": 4,
      "text": "Strain Bloody Mary into the prepared glass. Garnish with celery stalk and olives."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,

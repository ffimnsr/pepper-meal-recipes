  "id": "05b33ab3-98ca-50e5-8a32-62eece802459",
  "slug": "raw-cashew-cheesy-kale-chips",
  "name": "Raw Cashew Cheesy Kale Chips",
  "recipe_type": "appetizer",
  "brief_description": "These raw kale chips coated with a savory cashew and nutritional yeast \"cheese\" are a great vegan snack to prepare in your dehydrator.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place cashews in a bowl. Cover with water; let soak for at least 1 hour. Drain and rinse."
    },
    {
      "position": 2,
      "text": "Transfer cashews to a blender; blend until finely chopped, scraping the sides of the bowl periodically. Add red bell pepper, onion, lemon juice, jalapeno pepper, and garlic; blend until well chopped. Scrape the sides of the bowl; add 3/4 cup water, nutritional yeast, paprika, turmeric, mustard, salt, and pepper. Blend until smooth, adding more water if necessary."
    },
    {
      "position": 3,
      "text": "Combine cashew mixture and kale in a large bowl; scrunch kale with your hands until evenly coated with cashew mixture. Spread in a single layer on an unlined dehydrator tray."
    },
    {
      "position": 4,
      "text": "Dehydrate kale at 105 degrees F (41 degrees C) until crisp, about 8 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

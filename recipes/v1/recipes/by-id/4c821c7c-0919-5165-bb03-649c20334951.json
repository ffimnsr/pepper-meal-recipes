  "id": "4c821c7c-0919-5165-bb03-649c20334951",
  "slug": "southern-style-french-onion-soup",
  "name": "Southern-Style French Onion Soup",
  "recipe_type": "soup",
  "brief_description": "Make this easy French onion soup recipe for steaming bowls of savory broth, tender onions, crisp-gone-soggy bread, and melty mozzarella cheese.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Add onion and saut\u00e9 for 5 to 10 minutes, or until tender. Stir in thyme, then remove from the heat."
    },
    {
      "position": 3,
      "text": "In a large pot over high heat, combine the consomm\u00e9, bay leaves, and white wine. Bring to a boil, then reduce heat to low, stir in the saut\u00e9ed onions, and cook until heated through, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Ladle soup into four individual oven-safe bowls, filling each about 3/4 full. Top each bowl with two baguette slices and cover with mozzarella."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until mozzarella is melted and bubbly, 10 to 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

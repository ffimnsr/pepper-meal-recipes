{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5ec71831-c423-50fd-aa5b-ac589e8b6118",
  "slug": "lovers-beef-burgundy-filet",
  "name": "Lover's Beef Burgundy Filet",
  "recipe_type": "main",
  "brief_description": "Juicy filet mignon steaks are soaked in a heady marinade of Burgundy wine and oyster sauce, then grilled and finished off with a dollop of peppery butter.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make the marinade: Mix wine, oyster sauce, oil, soy sauce, garlic, and oregano in a medium saucepan. Bring to a boil, then remove from the heat. Place in the refrigerator until chilled, about 1 hour."
    },
    {
      "position": 2,
      "text": "Marinate the steaks: Place steaks into a 9x13-inch baking dish and pour chilled marinade over top. Cover tightly with foil and marinate in the refrigerator for at least 3 hours, or overnight if possible."
    },
    {
      "position": 3,
      "text": "Make the butter: Cream butter and wine in a bowl with an electric mixer. Mix in shallots, green onions, and white pepper by hand. Cover tightly and refrigerate until needed."
    },
    {
      "position": 4,
      "text": "When ready to cook, preheat an outdoor grill for high heat and lightly oil the grate. Preheat the oven to 200 degrees F (95 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove steaks from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 6,
      "text": "Grill steaks on the preheated grill until they are beginning to firm and are hot and slightly pink in the center, 5 to 7 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium."
    },
    {
      "position": 7,
      "text": "Remove from the grill and place into a clean 9x13-inch baking dish. Dollop some butter mixture over each steak."
    },
    {
      "position": 8,
      "text": "Cook in the preheated oven until butter melts, 1 to 2 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

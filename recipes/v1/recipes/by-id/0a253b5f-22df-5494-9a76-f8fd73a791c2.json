  "id": "0a253b5f-22df-5494-9a76-f8fd73a791c2",
  "slug": "one-minute-chocolate-icing",
  "name": "One Minute Chocolate Icing",
  "recipe_type": "dessert",
  "brief_description": "Make chocolate frosting without powdered sugar by beating a mixture of boiled milk, butter, cocoa powder, and sugar to a fudge-like consistency.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar, cocoa powder, milk, butter, and vanilla in a saucepan. Bring to a rolling boil, stirring constantly; cook for 1 minute. Remove from heat."
    },
    {
      "position": 2,
      "text": "Beat icing with an electric mixer until mixture cools and thickens to spreading consistency, about 3 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,

  "id": "ab197f10-8006-567a-8330-831dcf4e0a1b",
  "slug": "pressure-cooker-butternut-squash-soup",
  "name": "Pressure Cooker Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "Trust your pressure cooker to deliver a classic fall favorite butternut squash soup recipe filled with sweet potatoes, apples, and warm autumn spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a stovetop pressure cooker over medium-high heat. Saut\u00e9 onion until translucent but not browned, about 5 minutes. Add squash, broth, apples, sweet potatoes, garlic, salt, cinnamon, nutmeg, black pepper, cumin, and ginger ."
    },
    {
      "position": 2,
      "text": "Close cooker securely and place pressure regulator over vent according to the manufacturer's instructions. Heat to high pressure until steam escapes in a steady flow and makes a whistling sound, according to the manufacturer's instructions, 10 to 15 minutes. Reduce heat to medium-low; cook until squash and sweet potatoes are fork-tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Carefully let pressure release using the quick-release method according to the manufacturer's instructions. Unlock and remove lid."
    },
    {
      "position": 4,
      "text": "Pur\u00e9e soup with an immersion blender until smooth. Stir in half-and-half. Serve with a dollop of yogurt on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

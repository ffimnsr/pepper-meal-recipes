  "id": "99c3782e-46a2-5756-8c30-99fde180f2d4",
  "slug": "rachels-cranberry-chicken-salad",
  "name": "Rachel's Cranberry Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This cranberry chicken salad made with cooked chopped chicken, mayo, pecans, apple, and tart cranberries is creamy, crunchy, and full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir chicken and mayonnaise together in a medium bowl until evenly coated. Stir in green onions, dried cranberries, apple, pecans, lime juice, dill weed, salt, and pepper."
    },
    {
      "position": 2,
      "text": "Serve immediately or refrigerate for several hours or overnight (the flavor just gets better)."
    }
  ],
  "servings": 4,

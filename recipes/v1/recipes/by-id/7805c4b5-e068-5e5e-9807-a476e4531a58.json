  "id": "7805c4b5-e068-5e5e-9807-a476e4531a58",
  "slug": "easy-batter-fruit-cobbler",
  "name": "Easy Batter Fruit Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This easy batter fruit cobbler recipe comes together quickly with any summer fruit, and makes a cakey batter for a delicious old-fashioned dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Position the rack in the upper-middle of the oven. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Put butter in an 8-inch square or 9-inch round pan; melt in the oven. Remove from the oven and set aside."
    },
    {
      "position": 3,
      "text": "Whisk flour, 3/4 cup sugar, baking powder, and salt in a medium bowl. Whisk in milk until a smooth batter forms."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Scatter fruit over batter. Sprinkle with 1 tablespoon sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top is light brown, and fruit bubbles, 50 to 60 minutes."
    },
    {
      "position": 7,
      "text": "Serve warm or at room temperature."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "253d5a09-ca2a-5836-a35e-e07e5d1e8dd2",
  "slug": "outrageous-warm-chicken-nacho-dip",
  "name": "Outrageous Warm Chicken Nacho Dip",
  "recipe_type": "appetizer",
  "brief_description": "This crockpot chicken queso dip is loaded with shredded chicken, jalape\u00f1os, tomatoes, chiles, and of course, smooth and creamy Velveeta cheese.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir processed cheese food, diced tomatoes with chiles, shredded cooked chicken, sour cream, green onion, jalape\u00f1o, and taco seasoning together in a slow cooker."
    },
    {
      "position": 3,
      "text": "Cover and cook on High, stirring occasionally, until cheese has melted and dip is hot, 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Stir in black beans and cook until heated through, 15 minutes."
    },
    {
      "position": 5,
      "text": "Serve with chips."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,

  "id": "29e8b0e2-b327-5b2d-814f-25234588b814",
  "slug": "melon-salad-with-feta-recipe-11694470",
  "name": "Melon Salad with Feta",
  "recipe_type": "salad",
  "brief_description": "This melon salad with feta, made with 3 varieties of melon, slivered almonds, and an orange-balsamic vinaigrette, is colorful and refreshing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add honeydew, cantaloupe, and watermelon to a bowl."
    },
    {
      "position": 2,
      "text": "For dressing, add olive oil, balsamic vinegar, orange juice, mint, and agave syrup to a bowl and whisk together, or add to a jar with tight fitting lid, cover the jar, and shake well."
    },
    {
      "position": 3,
      "text": "Pour as much dressing as desired over melons and mix well; add feta and mix again. Garnish with mint leaves, sprinkle with almonds, and drizzle with a small amount of balsamic glaze."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

  "id": "46307694-507f-5209-ab5a-239f2a735d04",
  "slug": "vegetarian-sloppy-joes",
  "name": "Vegetarian Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "Tempeh stands in for the traditional ground beef in a vegetarian version of the all-American classic sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep, 10-inch skillet over medium-low heat. Cook the onion in the oil until translucent. Crumble the tempeh into the skillet; cook and stir until golden brown. Add the green pepper and garlic; cook another 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Stir in the tomato sauce, Worcestershire sauce, honey, molasses, cayenne pepper, celery seed, cumin, salt, coriander, thyme, oregano, paprika, and black pepper; stir. Simmer another 10 to 15 minutes. Spoon hot onto hamburger buns to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

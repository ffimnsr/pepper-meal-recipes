  "id": "52aceb31-073f-539a-bbbd-256c7272b714",
  "slug": "classic-caramel-corn",
  "name": "Classic Caramel Corn",
  "recipe_type": "dessert",
  "brief_description": "This easy caramel corn recipe makes a deliciously sweet and crunchy crowd-pleasing snack that's great for get togethers and gifting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Spray a large shallow roasting pan with cooking spray, then fill with popcorn. Place in the preheated oven while preparing caramel."
    },
    {
      "position": 3,
      "text": "Mix brown sugar, corn syrup, butter, and salt together in a heavy 2-quart saucepan over medium heat; stir constantly until mixture comes to a boil."
    },
    {
      "position": 4,
      "text": "Stop stirring, and boil mixture for 5 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the heat and stir in baking soda and vanilla until well combined."
    },
    {
      "position": 6,
      "text": "Pour syrup over warmed popcorn and stir until evenly coated."
    },
    {
      "position": 7,
      "text": "Return to the oven and bake for 45 minutes, stirring occasionally."
    },
    {
      "position": 8,
      "text": "Remove from the oven and spread onto a large foil sheet greased with cooking spray."
    },
    {
      "position": 9,
      "text": "Cool, then break apart and store in a tightly covered container."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

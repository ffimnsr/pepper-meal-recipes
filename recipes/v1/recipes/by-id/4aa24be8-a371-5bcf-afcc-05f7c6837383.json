  "slug": "reduced-calorie-chocolate-banana-oatmeal",
  "name": "Reduced-Calorie Chocolate Banana Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "This chocolate-banana oatmeal uses reduced-calorie ingredients for a breakfast that not only tastes great, but comes without the guilt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour cocoa powder into a microwave-safe bowl and stir in cinnamon, sweetener, and salt. Add hot water and stir thoroughly until cocoa powder has dissolved. Stir in cold water until well combined. Stir in oats and banana until mixed well."
    },
    {
      "position": 2,
      "text": "Microwave for 2 minutes. Remove, stir, and allow oatmeal to cool and thicken."
    }
  ],
  "servings": 1,

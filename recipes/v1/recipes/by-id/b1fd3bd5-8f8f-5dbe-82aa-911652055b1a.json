  "id": "b1fd3bd5-8f8f-5dbe-82aa-911652055b1a",
  "slug": "italian-stuffed-toast-toast-farcito",
  "name": "Italian \"Stuffed\" Toast (Toast Farcito)",
  "recipe_type": "appetizer",
  "brief_description": "This Italian \"stuffed\" toast (toast farcito) recipe cooks prosciutto, Fontina cheese, and giardiniera (pickled Italian vegetables) between bread slices.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a panini press according to the manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Place 1 slice each prosciutto and Fontina cheese onto 1 bread slice each; add 2 tablespoons giardiniera on top each cheese layer. Top sandwiches with remaining bread slices."
    },
    {
      "position": 3,
      "text": "Cook panino in the press until cheese melted and bread toasted, 3 to 5 minutes. Repeat with remaining panino. Serve hot pickled peppers on the side."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

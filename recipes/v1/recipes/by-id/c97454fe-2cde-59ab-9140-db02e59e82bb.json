  "slug": "garlic-bread-fantastique",
  "name": "Garlic Bread Fantastique",
  "recipe_type": "appetizer",
  "brief_description": "This garlic bread recipe is a zippy change from the norm. A mixture of butter, mayonnaise, garlic, and herbs is spread on a baguette and toasted to perfection.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Mix butter, mayonnaise, garlic, oregano, salt, pepper, and sage in a bowl until well combined. Spread mixture evenly on baguette halves, then sprinkle Parmesan cheese over top."
    },
    {
      "position": 3,
      "text": "Place baguette under the preheated broiler until lightly toasted, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

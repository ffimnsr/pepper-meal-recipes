  "id": "c3c4efca-36af-56c2-8221-a56626b00915",
  "slug": "bbq-chicken-calzones",
  "name": "BBQ Chicken Calzones",
  "recipe_type": "main",
  "brief_description": "If you like BBQ Chicken Pizza, you'll like this easy-to-make bbq chicken calzone!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble."
    },
    {
      "position": 3,
      "text": "Add shredded chicken and onion to hot bacon grease in the pan. Cook and stir over medium heat until onion is tender. Stir in 1/3 cup barbeque sauce; remove from heat. Mix in crumbled bacon."
    },
    {
      "position": 4,
      "text": "Roll pizza crust dough onto a greased cookie sheet. Press out to an even thickness, then cut in half. Divide chicken mixture between dough pieces, spreading over 1/2 of each dough piece to within 1/2 inch of the edge."
    },
    {
      "position": 5,
      "text": "Drizzle remaining barbeque sauce over the filling. Sprinkle with cheese and cilantro. Fold uncovered portion of dough over the filling. Press the edges together with a fork to seal."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned, about 25 minutes. Cool for a few minutes, then cut each calzone in half for 4 servings. Serve with additional barbeque sauce if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

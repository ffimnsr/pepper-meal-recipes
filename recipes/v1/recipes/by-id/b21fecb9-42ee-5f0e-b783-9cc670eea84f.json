  "id": "b21fecb9-42ee-5f0e-b783-9cc670eea84f",
  "slug": "4-ingredient-spinach-artichoke-chicken-texas-toast-recipe-11960006",
  "name": "4-Ingredient Spinach Artichoke Chicken Texas Toast",
  "recipe_type": "appetizer",
  "brief_description": "This 4-ingredient spinach artichoke chicken Texas toast dinner is incredibly easy to make. Cooked chicken and spinach artichoke dip spread on baked Texas toast take minutes to assemble and less than a half hour to bake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place toast on a parchment paper lined baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven for 12 minutes."
    },
    {
      "position": 3,
      "text": "Flip each piece of toast; use a spoon to press the center of each piece down to form a well inside the crust."
    },
    {
      "position": 4,
      "text": "Divide chicken among toast slices. Warm spinach artichoke dip in the microwave for 1 minute. Stir in mozzarella cheese, and top each toast evenly with dip."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through, 8 to 10 minutes. Turn broiler on High and continue to cook until just bubbly around the edges and lightly browned, 1 to 2 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

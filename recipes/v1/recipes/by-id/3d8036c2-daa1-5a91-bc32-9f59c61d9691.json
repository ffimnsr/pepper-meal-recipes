  "id": "3d8036c2-daa1-5a91-bc32-9f59c61d9691",
  "slug": "slow-cooker-mediterranean-lentil-stew",
  "name": "Slow Cooker Mediterranean Lentil Stew",
  "recipe_type": "soup",
  "brief_description": "This flavorful lentil stew with potatoes, carrots, spinach, cumin, and coriander is made in a slow cooker for a no-fuss Mediterranean-inspired dish.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Warm water and vegetable bouillon in a slow cooker on High until dissolved. Add lentils, carrots, and potatoes."
    },
    {
      "position": 2,
      "text": "Heat a medium saucepan over medium heat. Add cumin and coriander and cook and stir until fragrant, about 20 seconds. Add olive oil, followed by onion. Cook, stirring occasionally, 2 to 3 minutes. Add garlic and saut\u00e9 for 30 seconds. Remove from heat and transfer to the slow cooker. Stir in tomato paste, salt, and pepper. Stir in spinach."
    },
    {
      "position": 3,
      "text": "Cook on High, stirring every 30 minutes, until lentils are tender and stew has thickened, 3 to 4 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 190,
  "preparation_time_minutes": 20,

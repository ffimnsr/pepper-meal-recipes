  "schema_version": 1,
  "id": "9550c991-ff0e-5e34-a8b1-70a02e94a590",
  "slug": "purim-hamantaschen-with-prune-filling",
  "name": "Purim Hamantaschen with Prune Filling",
  "recipe_type": "dessert",
  "brief_description": "These sweet hamantaschen cookies traditionally served on the Jewish holiday of Purim are filled with a classic homemade prune filling.",
  "cuisine": "U.S. Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Combine honey, lemon juice, and prunes in a small saucepan. Add enough water to cover. Bring to a boil; reduce heat and simmer until prunes are softened, about 10 minutes. Remove prune filling from heat and let cool."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 3 baking sheets with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 4,
      "text": "Beat sugar, butter, and shortening together with a wooden spoon until creamy. Add eggs; stir until smooth. Stir in orange juice and vanilla extract. Gently fold in flour mixture, mixing until a dough forms. Divide dough into 3 balls."
    },
    {
      "position": 5,
      "text": "Roll out 1 ball of dough on a floured work surface to 1/4-inch thickness, using a piece of parchment paper under the rolling pin to prevent sticking. Use the rim of a glass to cut dough into circles."
    },
    {
      "position": 6,
      "text": "Place 1/2 teaspoon prune filling in the center of each circle of dough. Pinch edges together to secure filling and form triangular pockets. Transfer cookies to baking sheet. Repeat rolling, cutting, and filling remaining balls of dough."
    },
    {
      "position": 7,
      "text": "Bake cookies in the preheated oven until lightly golden, about 18 minutes."
    }
  ],
  "servings": 50,
  "cooking_time_minutes": 33,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

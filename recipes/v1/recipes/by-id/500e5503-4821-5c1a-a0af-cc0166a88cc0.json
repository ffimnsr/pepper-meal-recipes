  "id": "500e5503-4821-5c1a-a0af-cc0166a88cc0",
  "slug": "basic-curry-sauce",
  "name": "Easy Curry Sauce",
  "recipe_type": "side",
  "brief_description": "This curry sauce is fragrant and rich, made with coriander, cumin, turmeric, garlic, and ginger, mixed with pur\u00e9ed tomatoes, chile pepper, and yogurt.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil and margarine in a small skillet or wok over medium-high heat. Add onion and saut\u00e9 until very brown, 10 to 15 minutes; do not undercook or sauce will taste funny."
    },
    {
      "position": 3,
      "text": "Add garlic and ginger to onions; saut\u00e9 for an additional 2 minutes."
    },
    {
      "position": 4,
      "text": "Transfer mixture to a food processor and blend until smooth. Do not rinse the food processor. Place blended onion mixture in a large saucepan. Stir in coriander, cumin, cinnamon, black pepper, cayenne pepper, and turmeric; cook over low heat until mixture is thick and has a paste-like consistency."
    },
    {
      "position": 5,
      "text": "Pur\u00e9e tomatoes, chile peppers, and cilantro in the food processor until smooth."
    },
    {
      "position": 6,
      "text": "Add to onion mixture and stir over low heat, cooking off moisture from tomatoes and peppers."
    },
    {
      "position": 7,
      "text": "Add yogurt a little bit at a time, stirring constantly to avoid curdling."
    },
    {
      "position": 8,
      "text": "Blend mixture in the food processor until smooth"
    },
    {
      "position": 9,
      "text": "Return to saucepan, add water, and increase heat to high; bring sauce to a rolling boil. Cover saucepan and boil for 3 to 5 minutes."
    },
    {
      "position": 10,
      "text": "Reduce heat and simmer until desired consistency is reached."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "ec5979b0-a530-50a0-a76c-040938864fea",
  "slug": "chef-johns-pecan-pie",
  "name": "Chef John\u2019s Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "Chef John\u2019s recipe for pecan pie has the perfect blend of nuts and sticky toffee filling with a wonderfully crisp crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Roll pie dough in a 9 1/2-inch glass pie dish and crimp the edges. Cover dough in parchment paper and press paper down to line the dough; pour pie weights on top of the parchment paper and spread evenly over the bottom."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes. Remove parchment paper and pie weights to a bowl. Bake crust until lightly golden and set, about 10 minutes more."
    },
    {
      "position": 4,
      "text": "Spread pecans out on a baking sheet. Bake in the oven until lightly toasted, 7 to 8 minutes."
    },
    {
      "position": 5,
      "text": "Stir brown sugar, butter, white sugar, corn syrup, flour, milk, bourbon, vanilla extract, and salt together in a saucepan over medium heat; bring to a boil, whisking constantly. Remove from heat and cool for 5 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Whisk eggs in a large bowl. Slowly drizzle sugar mixture into eggs, whisking constantly."
    },
    {
      "position": 7,
      "text": "Spread pecans out in the bottom of the crust. Pour sugar mixture over nuts and gently stir with a spatula to coat all of the nuts."
    },
    {
      "position": 8,
      "text": "Bake pie in the preheated oven until crust is golden brown and pie is set, 40 to 45 minutes. Cool completely."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "f2a90b24-dd52-55fe-ae3f-6dd8b4fe1991",
  "slug": "southern-tuna-macaroni-salad",
  "name": "Southern Tuna Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "Oil-packed tuna joins chow-chow, hard-boiled eggs, and Southern-inspired seasonings in this macaroni salad that's ideal for picnics and parties.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place diced onion in a large bowl and cover with cold water. Let sit for 5 minutes. Drain into a colander."
    },
    {
      "position": 2,
      "text": "While onion soaks, bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain into the same colander as red onion and run under cold water to stop cooking and cool to room temperature."
    },
    {
      "position": 3,
      "text": "Place mayonnaise, pimentos, relish, chow-chow, mustard, Cajun seasoning, and salt in a large bowl and stir to combine. Add pasta, red onion, and celery and stir to combine. Gently fold in tuna and eggs to combine."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

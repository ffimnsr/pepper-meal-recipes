  "id": "137c1e42-44ef-5984-8114-032e39cbeb84",
  "slug": "slow-cooker-baked-beans-with-ham-hock",
  "name": "Slow Cooker Baked Beans with Ham Hock",
  "recipe_type": "side",
  "brief_description": "For those who love to do it themselves, here's a terrific recipe for genuine baked beans - and it's so easy to make! Soak white beans and then pop them into your slow cooker with ham hocks, onion, brown sugar, maple syrup, ketchup and mustard.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over high heat, combine the beans with water to cover and bring to a boil for 10 minutes. Remove from heat but let sit for 1 hour. Drain beans and place them in a slow cooker. Add the ham hocks, onion, brown sugar, maple syrup, salt and water."
    },
    {
      "position": 2,
      "text": "Mix well, cover and cook on high setting for 4 to 5 hours, stirring occasionally. During the final hour of cooking, add the ketchup and mustard, remove the ham from the hocks and discard the hocks. Mix well and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 300,

  "id": "1a93a194-9dfe-5256-a887-fe88b04f6094",
  "slug": "best-italian-sausage-soup",
  "name": "Best Italian Sausage Soup",
  "recipe_type": "soup",
  "brief_description": "Italian sausage, zucchini and spinach fettucine are featured in this beef broth soup seasoned flavored with red wine, basil and oregano.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot, cook sausage over medium heat until brown. Remove with a slotted spoon, and drain on paper towels. Drain fat from pan, reserving 3 tablespoons."
    },
    {
      "position": 2,
      "text": "Cook garlic and onion in reserved fat for 2 to 3 minutes. Stir in tomatoes, wine, broth, basil, and oregano. Transfer to a slow cooker, and stir in sausage, zucchini, bell pepper, and parsley."
    },
    {
      "position": 3,
      "text": "Cover, and cook on Low for 4 to 6 hours."
    },
    {
      "position": 4,
      "text": "Bring a pot of lightly salted water to a boil. Cook pasta in boiling water until al dente, about 7 minutes. Drain water, and add pasta to the slow cooker. Simmer for a few minutes, and season with salt and pepper before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,

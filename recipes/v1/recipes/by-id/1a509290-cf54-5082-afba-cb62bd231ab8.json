  "id": "1a509290-cf54-5082-afba-cb62bd231ab8",
  "slug": "crescent-dough-garlic-bread",
  "name": "Crescent Dough Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This easy seven-ingredient, 30-minute garlic bread recipe uses refrigerator crescent roll dough, Parmesan cheese, Italian seasoning, and fresh garlic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butter, Parmesan cheese, and garlic in a bowl."
    },
    {
      "position": 3,
      "text": "Open can of dough but do not unroll. Cut dough into 12 equal pieces using a serrated knife; place slices onto the prepared baking sheet. Brush with garlic butter; sprinkle with Italian seasoning, black pepper, and paprika."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 16 to 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

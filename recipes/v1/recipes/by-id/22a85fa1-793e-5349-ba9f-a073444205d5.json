  "slug": "bucket-of-margaritas",
  "name": "Bucket of Margaritas",
  "recipe_type": "drink",
  "brief_description": "These slushy margaritas are made in the freezer. No blending required! But they must be made ahead to allow time to freeze.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix the water, tequila, limeade, and orange liqueur in a freezer-proof container with a lid; stir. Cover and store in freezer until it reaches a slush-like consistency, about 24 hours. Serve in glasses garnished with lime wedges."
    }
  ],

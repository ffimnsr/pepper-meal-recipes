  "id": "b87bb88d-e319-521e-9f28-f42380c17aad",
  "slug": "butternut-squash-leek-soup",
  "name": "Butternut Squash Leek Soup",
  "recipe_type": "soup",
  "brief_description": "Butternut squash, leeks, and carrots come together in this silky fall soup garnished with caramelized apples and thickened with bread instead of cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 teaspoons oil in large stockpot over medium heat. Add carrots, leeks, and onions. Cook and stir until softened and no longer crispy, 5 to 10 minutes. Add squash; saute for 2 to 3 minutes. Add water and bring to a boil. Reduce heat to medium and cover."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons oil in a skillet over medium heat. Gently fry bread until browned, 3 to 5 minutes. Add bread to the stockpot; stir in allspice and ginger. Cook, covered, until squash has softened, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat remaining oil in a frying pan over medium heat. Add apple and brown sugar. Fry until apples are well browned and start to form a crispy crust, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Puree the contents of the stockpot using an immersion blender until smooth and free of chunks. Garnish soup with the caramelized apples."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

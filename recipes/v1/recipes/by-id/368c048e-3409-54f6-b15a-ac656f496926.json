{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "368c048e-3409-54f6-b15a-ac656f496926",
  "slug": "chef-johns-pasta-con-le-sarde",
  "name": "Chef John's Pasta con le Sarde",
  "recipe_type": "main",
  "brief_description": "Pasta con le sarde is a delicious Sicilian seafood pasta dish made with oil-packed sardines, anchovies, fennel, saffron, pine nuts, and golden raisins.",
  "cuisine": "Sicilian Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a skillet over medium heat. Add bread crumbs; cook and stir until crispy and toasted, 2 to 5 minutes. Transfer bread crumbs to a bowl."
    },
    {
      "position": 2,
      "text": "Grind saffron threads with a mortar and pestle; pour white wine into the mortar and stir to combine."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook bucatini in boiling water, stirring occasionally, until almost fully cooked through but still firm to the bite, 10 to 11 minutes. Drain, reserving 1/2 cup of the pasta water."
    },
    {
      "position": 4,
      "text": "Heat remaining 4 tablespoons olive oil in large skillet over medium heat. Add onion, fennel, and salt; cook and stir until onion is soft, about 10 minutes. Add raisins, garlic, and anchovy; cook and stir until heated through, about 1 minute."
    },
    {
      "position": 5,
      "text": "Pour wine mixture into the skillet and cook until almost evaporated, about 2 minutes. Pour 1 ladleful reserved pasta water into the skillet and bring to a simmer. Stir in pine nuts and red pepper flakes; simmer until flavors combine and sauce is reduced, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Stir bucatini and sardines into the skillet. Increase the heat to high and cook, stirring frequently and adding more reserved pasta water as necessary, until sauce and pasta are heated through, about 5 minutes. Remove from the heat."
    },
    {
      "position": 7,
      "text": "Ladle into bowls and top with fennel fronds and toasted bread crumbs."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

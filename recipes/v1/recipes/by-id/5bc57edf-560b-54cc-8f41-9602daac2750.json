  "id": "5bc57edf-560b-54cc-8f41-9602daac2750",
  "slug": "mini-cheeseburgers",
  "name": "Mini Cheeseburgers",
  "recipe_type": "side",
  "brief_description": "These tasty mini cheeseburgers have cheese inside the small patties and on top. Serve in buns for a tasty dinner the whole family will enjoy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Mix ground beef, 1/2 cup ketchup, 1/2 cup shredded cheese, egg, and garlic powder in a large bowl. Form mixture into 1 inch balls, and gently press onto prepared baking sheet to form mini-burgers."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 20 minutes. Spread remaining ketchup on burgers, and sprinkle with remaining cheese. Return burgers to the oven, and bake until cheese is melted and bubbly, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

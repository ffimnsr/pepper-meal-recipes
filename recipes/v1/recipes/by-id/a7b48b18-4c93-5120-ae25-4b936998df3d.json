{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a7b48b18-4c93-5120-ae25-4b936998df3d",
  "slug": "mardi-gras-king-cake",
  "name": "Mardi Gras King Cake",
  "recipe_type": "dessert",
  "brief_description": "King cake is a sweet and colorful cake made with sweet dough and pecan filling, and, if you're lucky, a plastic baby traditionally served at Mardi Gras.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "To make the dough: Heat milk in a small saucepan over medium heat, stirring often, until steaming and small bubbles form around the edges, about 5 minutes. Remove from heat and stir in butter until melted and fully combined, about 2 minutes. Allow mixture to cool to room temperature, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir together warm water, yeast, and 1 tablespoon of the sugar in a large bowl. Let stand until foamy, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Add cooled milk mixture, eggs, salt, nutmeg, and remaining 7 tablespoons sugar to yeast mixture, whisk until combined, about 30 seconds."
    },
    {
      "position": 5,
      "text": "Beat flour into yeast mixture, 1 cup at a time, with an electric mixer fitted with dough hook attachment on medium speed until dough comes together, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Transfer dough onto a lightly floured surface and knead until smooth and elastic, adding additional flour as needed, 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Place dough in a lightly oiled large bowl; turn to coat. Cover with a damp cloth or plastic wrap; let rise in a warm place until doubled in volume, about 1 \u00bd hours. When risen, punch down and divide dough in half."
    },
    {
      "position": 8,
      "text": "Return dough to a lightly floured work surface, roll out each half into a 10x16-inch rectangle, dusting work surface and rolling pin with additional flour if needed."
    },
    {
      "position": 9,
      "text": "To make the filling: Combine brown sugar, pecans, flour, raisins, and cinnamon in a medium bowl. Pour melted butter on top and mix until crumbly."
    },
    {
      "position": 10,
      "text": "Sprinkle filling evenly over dough, about 1 cup per cake, using your hands or a spatula to press into dough."
    },
    {
      "position": 11,
      "text": "Starting at one of the long ends, roll each dough rectangle into a tight log."
    },
    {
      "position": 12,
      "text": "Bring the ends of each roll together, pinching the seams together to form 2 individual oval-shaped rings. Transfer each ring, seam side down, onto a large rimmed baking sheet lined with parchment. With scissors, make cuts 1/3 of the way through the rings at 1-inch intervals."
    },
    {
      "position": 13,
      "text": "Cover with plastic wrap or a damp towel, and let rise in a warm spot until doubled in size, 30 to 45 minutes. Meanwhile, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 14,
      "text": "Bake both rings in the preheated oven in the upper and lower thirds until golden brown and a toothpick inserted comes out clean, or when a thermometer inserted into the center of the dough reads 190 F, about 25 minutes, rotating sheet trays 180 degrees and top to bottom, halfway through baking to ensure even browning. Some filling might leak out during baking."
    },
    {
      "position": 15,
      "text": "Remove cakes and carefully push 1 doll into bottom of each warm cake. Let cool slightly, about 30 minutes."
    },
    {
      "position": 16,
      "text": "To make the glaze: Whisk confectioners' sugar and 2 tablespoons water together in a small bowl until smooth, adding another 1 tablespoon water if needed to reach desired consistency."
    },
    {
      "position": 17,
      "text": "Spread glaze evenly over the tops of both warm cakes."
    },
    {
      "position": 18,
      "text": "Sprinkle sanding sugar immediately over glaze if desired."
    }
  ],
  "servings": 16,

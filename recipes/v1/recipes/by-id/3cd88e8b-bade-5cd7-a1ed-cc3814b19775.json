  "id": "3cd88e8b-bade-5cd7-a1ed-cc3814b19775",
  "slug": "pumpkin-custard-pie-i",
  "name": "Pumpkin Custard Pie I",
  "recipe_type": "dessert",
  "brief_description": "The proportions are perfect in this old Amish recipe with just the right amount of sugar, eggs and spices mixed into the pumpkin puree and milk. The thick and creamy filling bakes up deliciously after an hour in the oven. Serve with whipped cream and a sprinkling of candied ginger.",
  "cuisine": "Amish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl combine pumpkin, eggs, flour, brown sugar, white sugar, salt, nutmeg, cinnamon, and milk. Beat until smooth. Pour into pastry-lined pie plate."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 50 minutes, or until set in center."
    }
  ],
  "servings": 8,

  "id": "a57cf01e-0883-5e6d-ac7b-3362edd66726",
  "slug": "hot-cinnamon-apple-brandy-cider",
  "name": "Hot Cinnamon Apple Brandy Cider",
  "recipe_type": "dessert",
  "brief_description": "This sweet, hot apple brandy cider recipe is spiced perfectly with cloves, nutmeg, ginger, cinnamon, and orange zest, and can be spiked with apple brandy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apple cider, apple brandy, \u00bc cup plus 1 tablespoon brown sugar, honey, cinnamon, ginger, nutmeg, cloves, black pepper, and salt in a saucepan over medium-high heat; simmer until flavors combine, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Pour apple cider mixture into heat-proof mugs. Twist orange zest strips between fingers to release essential oils; drop 1 into each mug. Add 1 cinnamon stick to each mug."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

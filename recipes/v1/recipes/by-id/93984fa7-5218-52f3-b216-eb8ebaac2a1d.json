  "id": "93984fa7-5218-52f3-b216-eb8ebaac2a1d",
  "slug": "chocolate-covered-strawberry-pie",
  "name": "Chocolate-Covered Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This chocolate-covered strawberry pie recipe layers a blend of cream cheese and sour cream with fresh strawberries and jam in a chocolate-coated crust",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 2 ounces chocolate and 2 tablespoons butter in a microwave-safe bowl. Microwave on 30% power for 2 \u00bd minutes, stirring occasionally, until melted. Spread chocolate mixture over bottom and up sides of pie crust; place crust in the freezer."
    },
    {
      "position": 2,
      "text": "Beat cream cheese in a large bowl using an electric mixer until smooth; beat in sour cream, sugar, and vanilla bean paste. Pour cream cheese filling into chilled crust."
    },
    {
      "position": 3,
      "text": "Combine strawberries and jam in a bowl; spread over cream cheese filling."
    },
    {
      "position": 4,
      "text": "Combine remaining 1 ounce chocolate and remaining 1 tablespoon butter in a microwave-safe bowl. Microwave on 30% power, about 1 minute, until melted. Drizzle chocolate mixture over pie with a spoon. Refrigerate before serving, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

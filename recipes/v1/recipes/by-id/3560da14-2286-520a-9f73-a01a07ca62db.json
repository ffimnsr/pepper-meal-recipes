  "id": "3560da14-2286-520a-9f73-a01a07ca62db",
  "slug": "tofu-quiche-with-broccoli",
  "name": "Tofu Quiche with Broccoli",
  "recipe_type": "breakfast",
  "brief_description": "This vegan tofu quiche is made with broccoli baked with a creamy mixture of pureed tofu and soy milk with a hint of Dijon mustard and garlic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bake pie crust in the preheated oven until golden brown, 10 to 12 minutes. Set aside."
    },
    {
      "position": 3,
      "text": "Place broccoli in a steamer over 1-inch boiling water. Cover and cook until tender but still firm, 2 to 6 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium-high heat. Saut\u00e9 onion and garlic until golden. Stir in cooked broccoli and heat through. Set aside."
    },
    {
      "position": 5,
      "text": "Combine tofu, soy milk, mustard, salt, nutmeg, ground red pepper, black pepper, parsley, and Parmesan soy cheese in a blender; process until smooth. Pour into a large bowl and stir in broccoli mixture. Transfer mixture to pie crust."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until quiche is set, 35 to 40 minutes. Allow to stand for at least 5 minutes before cutting."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

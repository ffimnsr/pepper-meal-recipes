  "id": "ec76cb10-681a-5bb3-aba3-b6ea287f0636",
  "slug": "saltine-toffee-cookies",
  "name": "Saltine Cracker Toffee",
  "recipe_type": "dessert",
  "brief_description": "Saltine cracker toffee is easy to make for a sweet, salty, and chocolaty treat with lots of great crunch. Perfect for gifting during the holidays!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients, and preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a rimmed baking sheet with saltine crackers in single layer."
    },
    {
      "position": 3,
      "text": "Combine butter and sugar in a saucepan. Bring to a boil; boil for 3 minutes."
    },
    {
      "position": 4,
      "text": "Immediately pour over saltines and spread to cover crackers completely. Bake in the preheated oven for 5 to 6 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and sprinkle chocolate chips over top. Let sit 5 minutes."
    },
    {
      "position": 6,
      "text": "Spread softened chocolate evenly. Sprinkle with pecans. Allow to cool completely, about 25 minutes."
    },
    {
      "position": 7,
      "text": "Break toffee into pieces. Enjoy!"
    }
  ],
  "servings": 35,
  "cooking_time_minutes": 15,

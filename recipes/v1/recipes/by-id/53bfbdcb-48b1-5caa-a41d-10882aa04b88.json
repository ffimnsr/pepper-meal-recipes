  "id": "53bfbdcb-48b1-5caa-a41d-10882aa04b88",
  "slug": "slow-cooker-honey-mustard-chicken-recipe-11949495",
  "name": "Slow Cooker Honey Mustard Chicken",
  "recipe_type": "salad",
  "brief_description": "This slow cooker honey mustard chicken only takes minutes to prepare, and just a couple of hours to cook. The saucy shredded chicken makes a terrific sandwich, or you can serve it over rice or in a chicken salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine salt, pepper, paprika, and onion powder in a small bowl. Rub spice mixture evenly over chicken breasts."
    },
    {
      "position": 2,
      "text": "Whisk together the honey, Dijon mustard, and garlic in another bowl."
    },
    {
      "position": 3,
      "text": "Place the seasoned chicken in a 4-quart slow cooker. Pour honey-mustard mixture over the chicken."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until chicken is tender and an instant-read thermometer inserted into the thickest portion registers 165 degrees F (74 degrees C), 2 hours 30 minutes."
    },
    {
      "position": 5,
      "text": "Transfer chicken to a cutting board and shred with 2 forks. Return shredded chicken to the slow cooker and stir to coat with sauce. Stir in 1 to 2 tablespoons additional Dijon mustard to taste before serving. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,

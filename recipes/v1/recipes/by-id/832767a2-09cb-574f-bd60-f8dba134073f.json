  "id": "832767a2-09cb-574f-bd60-f8dba134073f",
  "slug": "glazed-yeast-doughnuts",
  "name": "Glazed Yeast Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "These yeast doughnuts covered with glazed icing are even better than the store-bought ones! This yeast donut recipe is easy and fun to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together scalded milk, sugar, and salt in a large bowl; set aside to cool until tepid. Dissolve yeast in warm water in a small bowl; let stand until creamy, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir together flour and nutmeg in a bowl. Add 2 cups flour mixture to milk mixture; beat until well-blended."
    },
    {
      "position": 3,
      "text": "Stir yeast mixture into milk and flour mixture, then mix in butter and eggs. Mix in remaining flour mixture, 1/2 cup at a time. When dough is firm enough, turn it onto a floured surface and knead for 3 to 4 minutes. Place into an oiled bowl, cover, and allow dough to rise until doubled, 30 to 35 minutes."
    },
    {
      "position": 4,
      "text": "Roll dough out on a lightly floured surface to 1/2-inch thickness. Cut into circles using a donut or round cutter. Set aside to rise until light, 30 to 40 minutes."
    },
    {
      "position": 5,
      "text": "Heat 1-inch-deep oil in a deep, heavy frying pan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Fry donuts in hot oil a few at a time. Cook each side until golden brown, then remove to drain on paper towels. Glaze while warm, or sprinkle with sugar."
    },
    {
      "position": 7,
      "text": "Stir together confectioners' sugar and 6 tablespoons milk in a bowl until smooth. Dip warm donuts into glaze; set aside to cool."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

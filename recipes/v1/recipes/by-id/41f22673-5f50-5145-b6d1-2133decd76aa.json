  "id": "41f22673-5f50-5145-b6d1-2133decd76aa",
  "slug": "slow-cooker-jackfruit-joes",
  "name": "Slow Cooker Jackfruit Joes",
  "recipe_type": "main",
  "brief_description": "Your lunchroom favorite goes vegetarian in this twist on sloppy Joes. Slow-cooked green jackfruit adds texture without compromising flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Add oil, onion, and bell pepper and cook until slightly softened, 3 to 5 minutes. Turn off Saute function and add jackfruit in a single layer on top of vegetables."
    },
    {
      "position": 2,
      "text": "Whisk tomato sauce, brown sugar, mustard, tomato paste, Worcestershire sauce, sriracha sauce, vinegar, garlic powder, parsley, salt, and pepper together in a bowl. Pour this mixture evenly over jackfruit in the pressure cooker. Close and lock the lid; choose the Slow Cook option and set the timer for 4 hours."
    },
    {
      "position": 3,
      "text": "Toast hamburger buns and serve topped with cooked jackfruit."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 245,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

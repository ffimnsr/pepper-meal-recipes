  "id": "dd32a7bf-99f5-5dc2-83bc-deb92fde3af5",
  "slug": "hibachi-style-fried-rice",
  "name": "Hibachi-Style Fried Rice",
  "recipe_type": "side",
  "brief_description": "Hibachi-style fried rice cooked with chicken, green onion, egg, and soy sauce is a quick and easy side dish to any meal. It can be easily customized.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a wok or nonstick skillet over medium-high heat; add olive oil. Cook and stir eggs in the hot oil until cooked through, 2 to 3 minutes. Add chicken, green onion, and garlic to scrambled eggs; cook and stir until heated through, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Mix rice into egg mixture; cook and stir until rice is warmed, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add soy sauce; cook and stir until rice mixture is evenly coated, about 3 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

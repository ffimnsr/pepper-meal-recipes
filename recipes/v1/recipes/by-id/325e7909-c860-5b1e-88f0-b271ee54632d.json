  "id": "325e7909-c860-5b1e-88f0-b271ee54632d",
  "slug": "my-favorite-beet-salad",
  "name": "My Favorite Beet Salad",
  "recipe_type": "salad",
  "brief_description": "This beet salad recipe with roasted beets, spinach, tomato, and feta includes a homemade dressing for a colorful side dish with deep earthy flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place beets in a large bowl; drizzle with 1/4 cup olive oil, salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Lay out 2 large squares of aluminum foil on a work surface, and place 3 beets onto the center of each sheet. Fold foil into packets, sealing beets inside. Place the packets into a baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven and roast until tender when pierced with a fork, 1 to 1 \u00bd hours. Unwrap and let cool until easy to handle; peel and slice."
    },
    {
      "position": 5,
      "text": "Arrange spinach leaves on a serving platter; sprinkle pieces of tomato and avocado over spinach and top with chopped red onion. Top with warm sliced beets and sprinkle with feta cheese."
    },
    {
      "position": 6,
      "text": "Whisk together balsamic vinegar, 1/2 cup olive oil, and Dijon mustard until smooth."
    },
    {
      "position": 7,
      "text": "Drizzle over salad before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

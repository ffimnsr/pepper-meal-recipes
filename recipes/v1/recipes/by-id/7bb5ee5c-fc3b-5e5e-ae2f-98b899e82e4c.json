  "id": "7bb5ee5c-fc3b-5e5e-ae2f-98b899e82e4c",
  "slug": "frito-salad-recipe-11714358",
  "name": "Frito Salad",
  "recipe_type": "salad",
  "brief_description": "This Frito salad is a great summer salad, and summer is right around the corner. Fritos, corn, Cheddar cubes, chili beans, and tomatoes are tossed with Romaine lettuce and Catalina dressing, and topped with sliced avocado. The vibrant colors are a big plus.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir ground chicken in a skillet over medium-high heat, breaking up large clumps with a spatula, until browned and crumbly, about 7 minutes. Stir in taco seasoning and water; set aside."
    },
    {
      "position": 2,
      "text": "Add lettuce to a large salad bowl. Drain off the first 1/2-inch of liquid from chili beans; add beans and remaining liquid, tomatoes, and dressing to lettuce; toss to coat."
    },
    {
      "position": 3,
      "text": "Add cheese, corn chips, and corn. Add chicken, toss again. Divide onto serving plates and add sliced avocado pieces. Serve and enjoy."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

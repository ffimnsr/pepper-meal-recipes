  "id": "cf72e886-41aa-5d81-9834-8d52adf0bc1e",
  "slug": "pecan-delight",
  "name": "Pecan Delight",
  "recipe_type": "dessert",
  "brief_description": "Egg whites are whipped until stiff, and then pecans, crushed buttery crackers, sugar, vanilla, and baking powder are gently folded in. This yummy filling is then spooned into a prepared pie tin and baked. Top with whipped topping and serve.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg whites until slightly stiff. Add sugar, vanilla, baking powder, Ritz crackers and pecans. Mix well, and pour into greased 9 inch pie plate."
    },
    {
      "position": 2,
      "text": "Bake at 350 degrees F (175 degrees C) for 25 minutes exactly."
    },
    {
      "position": 3,
      "text": "Allow pie to cool to room temperature, and then cover with nondairy whipped topping. Refrigerate for 2 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

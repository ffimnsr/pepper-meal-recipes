  "id": "94e57728-5cb1-5e51-98a5-49d613b5cca8",
  "slug": "mini-strawberry-tarts",
  "name": "Mini Strawberry Tarts",
  "recipe_type": "dessert",
  "brief_description": "Cream cheese pastry crusts are filled with fresh strawberries and a strawberry gelatin glaze to make cute mini tarts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease mini muffin pans."
    },
    {
      "position": 2,
      "text": "Place cream cheese and butter in a large bowl. Beat with an electric mixer until smooth and fluffy. Gradually beat in flour, one cup at a time, until all is incorporated. Roll dough into 70 small balls, and press each into a mini muffin pan cup to form the pastry crusts."
    },
    {
      "position": 3,
      "text": "Bake crusts in preheated oven until golden brown, 15 to 18 minutes. Remove from oven, and allow to cool."
    },
    {
      "position": 4,
      "text": "Stir gelatin, sugar, and food coloring into the boiling water. Place over high heat; bring back to a boil. Stir together cornstarch and water to make a paste. Stir the cornstarch mixture in the boiling gelatin until dissolved. Remove from heat and allow to cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Spoon cooled gelatin mixture evenly into tart shells. Push a strawberry half down into each tart. If desired, top each tart with a small amount of whipped cream or whipped topping just before serving."
    }
  ],
  "servings": 35,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "name": "Easy Pumpkin Spice Coffee Creamer",
  "recipe_type": "breakfast",
  "brief_description": "Keep this easy pumpkin spice coffee creamer ready in the refrigerator for the whole fall season. You can mix it up in just a few minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add half-and-half, maple syrup, pumpkin puree, sweetened condensed milk, cinnamon, nutmeg, ginger, cloves, and vanilla to a 1-quart jar or container with a tight-fitting lid. Whisk or shake until well blended. Refrigerate until ready to use."
    }
  ],

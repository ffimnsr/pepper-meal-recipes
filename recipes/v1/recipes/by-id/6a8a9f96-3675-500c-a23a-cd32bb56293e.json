  "schema_version": 1,
  "id": "6a8a9f96-3675-500c-a23a-cd32bb56293e",
  "slug": "real-fig-preserves",
  "name": "Real Fig Preserves",
  "recipe_type": "dessert",
  "brief_description": "Pack these fig preserves in half-pint canning jars and share them with friends and family \u2014 they'll love the sweet figs packed in lemony golden syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large bowl with cool water; add baking soda and stir to dissolve. Add figs and gently stir to clean. Drain water and rinse figs thoroughly with fresh, cool water. Drain again."
    },
    {
      "position": 2,
      "text": "Transfer figs to a large pot; add sugar, water, butter, lemon slices, lemon juice, cinnamon, vanilla, ginger, and cloves. Stir gently to dissolve sugar, keeping figs as intact as possible."
    },
    {
      "position": 3,
      "text": "Bring mixture to a boil over medium heat. Reduce the heat and simmer, stirring gently a few times to keep figs from burning onto the bottom, until figs are golden brown and coated in syrup, about 1 hour. Add salt to tame the sweetness if desired."
    },
    {
      "position": 4,
      "text": "Meanwhile, inspect 8 half-pint jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until figs are ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 5,
      "text": "Pack figs into hot, sterilized jars and top off with syrup, filling to within 1/4 inch of the top. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 6,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 15 minutes."
    },
    {
      "position": 7,
      "text": "Remove the jars from the stockpot and place onto a cloth-covered or wood surface. Let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Store in a cool, dark area, and wait at least 2 days before opening."
    }
  ],

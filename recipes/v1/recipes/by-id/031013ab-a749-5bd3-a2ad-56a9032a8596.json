  "id": "031013ab-a749-5bd3-a2ad-56a9032a8596",
  "slug": "air-fryer-honey-mustard-salmon-recipe-8789582",
  "name": "Air Fryer Honey Mustard Salmon",
  "recipe_type": "dessert",
  "brief_description": "This air fryer honey mustard salmon is quick enough to make for a weeknight. Sweet-sharp honey mustard is a perfect flavor match for succulent salmon, and preparing it in the air fryer is the next best thing to grilling with half the trouble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir Dijon and honey together in a small bowl; brush over salmon. Season with salt and pepper. Place salmon in a single layer in the air fryer basket."
    },
    {
      "position": 3,
      "text": "Air fry salmon in the preheated air fryer until fish flakes easily with a fork, 7 to 9 minutes. depending on thickness."
    },
    {
      "position": 4,
      "text": "For sauce, melt butter in a small saucepan over medium heat. Remove from heat and pour in whiskey. Return saucepan to heat and allow flame to burn off the alcohol."
    },
    {
      "position": 5,
      "text": "Stir in cream, Dijon, and honey; bring to a gentle boil and cook until sauce thickens slightly, 1 to 2 minutes. Season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Transfer salmon to plates, and garnish with sauce and fresh thyme."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

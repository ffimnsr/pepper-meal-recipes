  "id": "9a55ec83-be4e-5904-804c-acdf2847fa65",
  "slug": "raw-fermented-beets",
  "name": "Raw Fermented Beets",
  "recipe_type": "side",
  "brief_description": "Beets are fermented with garlic in a simple brine of water and salt in this easy recipe for fermented raw beets with everyday ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Distribute beet chunks between two jars with lids. Add 2 cloves garlic, 3 peppercorns, and 1 bay leaf to each jar."
    },
    {
      "position": 2,
      "text": "Combine water and salt in a bowl to make the brine; stir until salt is completely dissolved. Pour enough brine into the jars to completely cover the beets."
    },
    {
      "position": 3,
      "text": "Screw on lids and let jars sit at room temperature until foam starts to appear on top, about 1 week. Transfer jars to a cool place (50 degrees F, 10 degrees C) for 2 to 3 days after foam appears. Store in the refrigerator."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

  "id": "43d48904-de2d-5ff5-b939-60486bbf5bf3",
  "slug": "pizza-dough-breadsticks-recipe-7368465",
  "name": "Pizza Dough Breadsticks",
  "recipe_type": "appetizer",
  "brief_description": "These pizza dough breadsticks made with premade dough are quick and easy to make and kids love them. Serve plain or top off with Mozzarella cheese.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper and set aside."
    },
    {
      "position": 3,
      "text": "Roll out pizza dough into an approximate 8 x 12-inch rectangle and place on prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Pre-bake pizza dough for 10 minutes."
    },
    {
      "position": 5,
      "text": "Mix butter, Italian seasoning, and garlic powder in a small bowl until well combined."
    },
    {
      "position": 6,
      "text": "Brush pizza dough with butter mixture and top with Mozzarella cheese."
    },
    {
      "position": 7,
      "text": "Return to the oven and bake until cheese is melted and edges of dough have started to brown, 6 to 10 more minutes."
    },
    {
      "position": 8,
      "text": "Cut into slices and serve at once."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "17d46957-0bb6-536b-8f62-e60c6c73d712",
  "slug": "grandmas-best-ever-sour-cream-lasagna",
  "name": "Grandma's Best Ever Sour Cream Lasagna",
  "recipe_type": "main",
  "brief_description": "Grandma's best lasagna recipe with sour cream added as a surprise ingredient! Mixed in the mozzarella and Parmesan layer, it adds a rich and tangy taste.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook sausage, ground beef, and garlic in a large skillet over medium-high heat, stirring occasionally, until browned and crumbly, 5 to 7 minutes. Drain any excess grease."
    },
    {
      "position": 3,
      "text": "Stir in diced tomatoes, tomato sauce, parsley, basil, oregano, and sugar. Bring to a boil over high heat, then reduce the heat to medium-low and simmer, stirring occasionally, until thickened, about 30 minutes."
    },
    {
      "position": 4,
      "text": "When the sauce has simmered for about 15 minutes, bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook, uncovered, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 5,
      "text": "Stir sour cream, 1/2 of the mozzarella, Parmesan, olives, eggs, salt, and pepper together in a bowl."
    },
    {
      "position": 6,
      "text": "Assemble the lasagna: Spread a thin layer of meat sauce evenly over the bottom of a 9x13-inch baking dish. Cover with 1/3 of the lasagna noodles, 1/3 of the remaining meat sauce, and 1/3 of the cheese mixture; repeat layers two more times with remaining noodles, sauce, and cheese mixture. Sprinkle remaining mozzarella evenly over top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until sauce is bubbly and the cheese is golden brown, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

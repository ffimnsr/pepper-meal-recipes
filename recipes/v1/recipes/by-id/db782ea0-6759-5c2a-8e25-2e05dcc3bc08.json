  "slug": "easy-liver-pate",
  "name": "Easy Liver P\u00e2t\u00e9",
  "recipe_type": "appetizer",
  "brief_description": "This liver p\u00e2t\u00e9 is made with Braunschweiger, a smoked version of liverwurst. It is perfect for gatherings or parties. Seasonings may be adjusted to taste.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together sausage, cream cheese, milk, and onion in a medium bowl. Season with Worcestershire sauce, chili powder, sugar, and garlic, and mix until well blended."
    },
    {
      "position": 2,
      "text": "Wrap in plastic wrap, and refrigerate for at least 2 hours, until firm."
    }
  ],

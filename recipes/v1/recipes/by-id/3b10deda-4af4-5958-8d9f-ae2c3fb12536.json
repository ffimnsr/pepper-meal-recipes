  "id": "3b10deda-4af4-5958-8d9f-ae2c3fb12536",
  "slug": "sweet-potato-shepherds-pie",
  "name": "Sweet Potato Shepherd's Pie",
  "recipe_type": "dessert",
  "brief_description": "Shepherd's pie has endless variations - this tempting version uses Veggie Ground Round and is topped with sweet potato mash.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In pot of boiling water, cook potatoes for about 15 minutes or until tender."
    },
    {
      "position": 3,
      "text": "Drain well and return to pot. Add margarine and half of the fresh ground pepper and mash until smooth; set aside."
    },
    {
      "position": 4,
      "text": "In a non-stick skillet, heat oil over medium heat. Cook ground round, green pepper and garlic, stirring for 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in flour and cook, stirring, for 1 minute."
    },
    {
      "position": 6,
      "text": "Add stock to skillet; bring to a boil."
    },
    {
      "position": 7,
      "text": "Add peas, corn, carrots, and remaining ground pepper."
    },
    {
      "position": 8,
      "text": "Spread mixture into 8-inch (2 L) square baking dish. Spread mashed potato over top."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven for about 15 minutes or until bubbly around edges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

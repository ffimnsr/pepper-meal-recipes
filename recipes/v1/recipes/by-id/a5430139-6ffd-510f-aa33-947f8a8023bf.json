  "id": "a5430139-6ffd-510f-aa33-947f8a8023bf",
  "slug": "poor-mans-shepherds-pie",
  "name": "Poor Man's Shepherd's Pie",
  "recipe_type": "salad",
  "brief_description": "This easy dish of ground beef, cream of mushroom soup, green onion and Worcestershire sauce served over brown rice is full of flavor and goes great with corn and a salad.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan, bring water and brown rice to a boil. Reduce heat, cover and simmer for 45 to 50 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a medium skillet over high heat, brown the ground beef and drain fat."
    },
    {
      "position": 3,
      "text": "Stir the mushroom soup, green onion, Worcestershire sauce, soy sauce and pepper into the skillet with the beef. Simmer on medium low heat for 10 minutes. Serve over the rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

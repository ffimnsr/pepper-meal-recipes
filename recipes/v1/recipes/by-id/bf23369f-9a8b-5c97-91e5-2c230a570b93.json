  "slug": "moose-milk",
  "name": "Moose Milk",
  "recipe_type": "dessert",
  "brief_description": "Try this moose milk recipe for a creamy punch flavored with dark rum and coffee liqueur. It goes down sweet and smooth like a milkshake and packs a wallop.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ice cream, milk, rum, coffee liqueur, and vodka in a large punch bowl; whisk until frothy and liquified."
    },
    {
      "position": 2,
      "text": "Ladle into punch glasses and garnish with nutmeg."
    }
  ],

  "id": "2ce1a704-62d6-5326-8455-a87eee794af4",
  "slug": "apple-pie-cinnamon-roll-bubble-up-recipe-11812020",
  "name": "Apple Pie Cinnamon Roll Bubble Up",
  "recipe_type": "dessert",
  "brief_description": "This apple pie cinnamon roll bubble up is a simple but special breakfast treat, great for the holidays. Apple pie filling is dolloped over cinnamon roll pieces, and baked with a crumble topping until golden.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Cut cinnamon rolls into quarters."
    },
    {
      "position": 2,
      "text": "Pour heavy cream into a pie dish and add cinnamon rolls on top."
    },
    {
      "position": 3,
      "text": "Add apple pie filling over the top of cinnamon rolls."
    },
    {
      "position": 4,
      "text": "In a small mixing bowl, combine melted butter, flour, brown sugar, oats , and cinnamon together until mixture is dry and crumbly. Crumble evenly on top of apple pie filling."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly golden, puffed, and bubbly, 45 to 50 minutes."
    },
    {
      "position": 6,
      "text": "Drizzle with icing from cinnamon rolls can before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

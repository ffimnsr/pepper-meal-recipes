  "id": "9e413ac6-6c9d-5f83-9a54-d9a1a2aa2548",
  "slug": "gingerbread-cookie-mix-in-a-jar",
  "name": "Gingerbread Cookie Mix in a Jar",
  "recipe_type": "dessert",
  "brief_description": "Gingerbread cookie mix is layered in a jar; attach a gingerbread man cookie cutter and the baking instructions with a ribbon for a gorgeous gift!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together 2 cups flour, baking soda, and baking powder in a medium bowl."
    },
    {
      "position": 2,
      "text": "Mix together remaining 1 1/2 cups flour, ginger, cloves, cinnamon, and allspice in a separate bowl."
    },
    {
      "position": 3,
      "text": "Layer flour-baking powder mixture, brown sugar, and flour-spice mixture into a 1-quart wide mouth canning jar, in that order. Pack firmly after adding each layer."
    },
    {
      "position": 4,
      "text": "Cover the jar with a lid and seal well. Write an instructions tag and attach it to the jar."
    }
  ],
  "servings": 18,

  "id": "2c56b87c-5f73-5a3b-9bbd-b9c55285d169",
  "slug": "quick-and-easy-parmesan-zucchini-fries",
  "name": "Quick and Easy Parmesan Zucchini Fries",
  "recipe_type": "side",
  "brief_description": "These baked Parmesan zucchini fries are flavored with paprika, garlic, and mixed herbs. Easy to make, and carb-conscious as well!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk eggs in a shallow bowl. Combine Parmesan cheese, mixed herbs, garlic powder, paprika, and pepper in a separate shallow bowl; mix well."
    },
    {
      "position": 3,
      "text": "Dip zucchini fries into beaten eggs, in batches; shake to remove excess, and roll in Parmesan mixture until fully coated. Place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, turning once, until golden and crispy, 30 to 35 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

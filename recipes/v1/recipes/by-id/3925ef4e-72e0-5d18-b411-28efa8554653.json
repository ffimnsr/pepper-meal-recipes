  "id": "3925ef4e-72e0-5d18-b411-28efa8554653",
  "slug": "classic-carbonara-with-pancetta",
  "name": "Classic Carbonara with Pancetta",
  "recipe_type": "main",
  "brief_description": "Penne pasta tossed in a creamy sauce spiked with Parmesan cheese and pancetta, the Italian version of bacon, makes this marvelously satisfying pancetta carbonara dish for weeknight suppers.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together eggs, cream, and 1 cup Parmesan cheese in a bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta; cook until al dente, 8 to 10 minutes. Drain pasta; return it to the pot off heat and cover to keep warm."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Add onion and cook until translucent, about 8 minutes. Transfer onion to a bowl; cover to keep warm."
    },
    {
      "position": 4,
      "text": "Cook pancetta in the same skillet over medium heat until browned; toss with nutmeg. Drain on paper towels."
    },
    {
      "position": 5,
      "text": "Combine pasta, onion, pancetta, pine nuts, salt, and pepper in the same large skillet over low heat. Slowly stir in egg mixture, tossing gently, so eggs don't scramble. Cook until just heated through."
    },
    {
      "position": 6,
      "text": "Remove from heat and toss with parsley and remaining 1/2 cup Parmesan cheese. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

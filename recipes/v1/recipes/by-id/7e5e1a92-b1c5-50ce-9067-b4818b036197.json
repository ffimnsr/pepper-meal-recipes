  "id": "7e5e1a92-b1c5-50ce-9067-b4818b036197",
  "slug": "chinese-buffet-green-beans",
  "name": "Chinese Garlic Green Beans",
  "recipe_type": "dessert",
  "brief_description": "These Chinese garlic green beans are quickly stir-fried with garlic and tossed with a sweet and savory sauce until tender and lightly crisp for an easy side.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a wok or large skillet over medium-high heat. Stir in garlic; cook until edges begin to brown, about 20 seconds."
    },
    {
      "position": 3,
      "text": "Add green beans; cook and stir until they begin to soften, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in oyster sauce, sugar, and soy sauce."
    },
    {
      "position": 5,
      "text": "Cook and stir until beans have attained the desired degree of tenderness, 2 to 4 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

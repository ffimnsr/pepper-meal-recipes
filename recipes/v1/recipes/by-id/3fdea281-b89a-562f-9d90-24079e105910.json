  "id": "3fdea281-b89a-562f-9d90-24079e105910",
  "slug": "skillet-braised-boneless-pork-chops-recipe-11907671",
  "name": "Skillet Braised Boneless Pork Chops",
  "recipe_type": "main",
  "brief_description": "These skillet braised boneless pork chops are tender, juicy, and full of flavor, seasoned with savory herbes de Provence and bright lemon pepper. Serve with mashed potatoes or a great crusty bread to soak up the delicious braising liquid.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat chops dry with paper towels and season each side with lemon pepper, herbes de Provence, salt, and pepper (See Note)."
    },
    {
      "position": 2,
      "text": "Stir Better-Than-Bouillon beef base into boiling water and set aside."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon butter and olive oil in a large skillet over medium-high heat. When butter stops sizzling, add seasoned chops and sear for 1 to 2 minutes per side. Remove chops from heat and keep warm."
    },
    {
      "position": 4,
      "text": "Melt remaining butter in the same skillet. Add shallots and mushrooms, reduce heat to medium, and cook, stirring, until vegetables are softened, 2 to 3 minutes. Add garlic and cook until fragrant, about 30 seconds more."
    },
    {
      "position": 5,
      "text": "Stir in broth; add chops and any accumulated juices to the pan. Spoon a bit of broth over chops, cover, and reduce heat. Simmer chops until pork is slightly pink in the center, 5 to 10 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Spoon mushrooms, shallots, and broth over each chop, garnish with chopped parsley, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "trader-joe-s-wonton-salad-recipe-11795662",
  "name": "Trader Joe\u2019s Wonton Salad",
  "recipe_type": "salad",
  "brief_description": "This Trader Joe\u2019s wonton salad uses 2 favorite TJ\u2019s products to make dinner in an instant, or a meaty salad side dish. Chicken wontons and a salad kit are all you need.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook wontons according to package directions."
    },
    {
      "position": 2,
      "text": "Add salad greens, wontons, and dressing in a large bowl; toss to combine."
    },
    {
      "position": 3,
      "text": "Garnish with crispy noodles and crushed peanuts provided in the salad kit. Serve immediately."
    }
  ],

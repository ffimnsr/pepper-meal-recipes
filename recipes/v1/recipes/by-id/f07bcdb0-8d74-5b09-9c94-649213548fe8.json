  "slug": "fruited-curry-chicken-salad",
  "name": "Fruited Curry Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Diced chicken dressed with curry mayonnaise sports a wonderful assortment of apple, raisins and grapes, plus celery, onion and pecans for savory crunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large salad bowl combine the chicken, celery, onion, apple, raisins, grapes, pecans, pepper, curry powder and mayonnaise. Mix all together, tossing to coat. Salad is ready to serve!"
    }
  ],

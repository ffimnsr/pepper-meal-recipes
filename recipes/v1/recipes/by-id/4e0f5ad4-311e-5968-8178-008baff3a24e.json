  "schema_version": 1,
  "id": "4e0f5ad4-311e-5968-8178-008baff3a24e",
  "slug": "chef-johns-classic-strawberry-shortcake",
  "name": "Chef John's Classic Strawberry Shortcake",
  "recipe_type": "appetizer",
  "brief_description": "This classic strawberry shortcake, made with browned butter, is Chef John's modified version of his grandfather's recipe for strawberry shortbread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Melt butter in small saucepan over medium heat. Stir continually, letting foam dissipate, just until butter begins to brown, 2 to 3 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Whisk self-rising flour and 1/4 cup white sugar together in a bowl. Add milk, 1/4 cup cream, and toasted butter; mix just until combined."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a floured surface; press or roll into a rectangle about 1-inch thick. Cut in half lengthwise, then cut each half into three portions. Place shortcake portions on the prepared baking sheet. Brush with cream; sprinkle with sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 15 to 18 minutes. Transfer shortcakes to a rack to cool completely."
    },
    {
      "position": 6,
      "text": "Sprinkle sliced strawberries with 1/4 cup sugar; stir until sugar begins to dissolve. Refrigerate until juice from berries is extracted, about 1 hour."
    },
    {
      "position": 7,
      "text": "Beat 3/4 cup cream, 1 tablespoon sugar, and few drops vanilla extract in a bowl with an electric mixer until soft peaks form."
    },
    {
      "position": 8,
      "text": "Split shortcakes in half; place bottom half in a bowl. Spoon strawberries and juice over shortcake half; top with shortcake top. Spoon more strawberries and juice over shortbread. Finish with a dollop of whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "e8db8bdb-a431-5dcf-bb23-13c81e633c10",
  "slug": "creamy-cajun-spiced-swamp-cabbage-recipe-12057410",
  "name": "Creamy Cajun-Spiced Swamp Cabbage",
  "recipe_type": "side",
  "brief_description": "This creamy Cajun-spiced swamp cabbage combines smoky andouille sausage and tender cabbage in a rich Parmesan cream sauce with bold Cajun seasoning. Ready in about 30 minutes, it\u2019s an out-of-this-world side dish that just might change the way you make cabbage.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large Dutch oven over medium-high heat. Add sausage and cook until ends begin to turn brown, about 5 minutes. Mix in yellow onion and reduce heat to medium. Season with Cajun seasoning to taste and continue cooking until onion begins to soften and sausage is browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add cabbage and continue cooking until edges begin to brown, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Add chicken stock and continue cooking until liquid has reduced by about half, about 5 minutes. Stir in heavy cream and Parmesan cheese and continue cooking until mixture begins to thicken, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

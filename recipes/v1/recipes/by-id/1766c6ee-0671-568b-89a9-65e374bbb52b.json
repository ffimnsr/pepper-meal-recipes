  "id": "1766c6ee-0671-568b-89a9-65e374bbb52b",
  "slug": "galuskies",
  "name": "Galuskies",
  "recipe_type": "main",
  "brief_description": "These galuskies feature a savory filling of ground beef, pork sausage, rice, and sauerkraut rolled up in cabbage for a tasty German-Russian dish.",
  "cuisine": "U.S. German Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage in a large stockpot filled halfway with water; add vinegar. Cover and steam over low heat until leaves are tender, 1 to 1 1/2 hours. Remove cabbage, reserving vinegar cooking water. Rinse cabbage with cold water to chill, then separate leaves."
    },
    {
      "position": 2,
      "text": "While cabbage is cooking, bring 3 cups water and rice to a boil in a saucepan over high heat, then reduce heat to low, cover, and simmer until rice is tender, about 20 minutes. Remove from heat and fluff with a fork; set aside to cool."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium heat. Cook and stir ground beef, pork sausage, onion, salt, garlic salt, and pepper until meat is browned and crumbly, 7 to 10 minutes. Drain and set aside to cool."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 5,
      "text": "Cover the bottom of a large roasting pan with a single layer of cabbage leaves."
    },
    {
      "position": 6,
      "text": "Stir together cooked rice, meat mixture, and sauerkraut in a large bowl until well blended. Place 1/3 cup rice-meat filling into each remaining cabbage leaf and roll into a cylinder, tucking in the ends. Arrange rolls over cabbage leaves in the roasting pan. Pour in enough reserved vinegar cooking water to reach halfway up the sides of cabbage rolls. Cover the pan with a tight-fitting lid or aluminum foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 1 1/2 hours. Serve warm or at room temperature."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 60,

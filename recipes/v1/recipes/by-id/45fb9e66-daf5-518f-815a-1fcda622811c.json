  "id": "45fb9e66-daf5-518f-815a-1fcda622811c",
  "slug": "keto-beef-egg-roll-slaw",
  "name": "Keto Beef Egg Roll Slaw",
  "recipe_type": "appetizer",
  "brief_description": "Serve up this keto beef slaw in 30 minutes or less for a quick and tasty stir-fry dinner of crunchy coleslaw and juicy ground beef seasoned with Asian-inspired flavors.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add diced onion, white parts of the green onions, and garlic. Saute until onions are translucent and garlic is fragrant, about 5 minutes. Add ground beef, sriracha, ginger, salt, and black pepper. Saute until beef is browned and crumbly, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir coleslaw mix, soy sauce, and cider vinegar into the beef mixture. Saute until coleslaw is tender, about 4 minutes more. Top with the rest of the green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "serbian-salad",
  "name": "Serbian Salad",
  "recipe_type": "salad",
  "brief_description": "This simple Serbian salad recipe with tomato wedges, cubed cucumbers, red onion, and banana peppers is usually dressed with just olive oil and salt.",
  "cuisine": "European",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomatoes, cucumber, and red onion in a bowl. Drizzle with olive oil; stir. Season with salt. Sprinkle banana pepper slices on top; garnish with parsley."
    }
  ],

  "id": "73d3d02c-2d4a-51a4-b0f9-c9ae19a4b279",
  "slug": "danish-pastry-apple-bars",
  "name": "Danish Pastry Apple Bars",
  "recipe_type": "dessert",
  "brief_description": "This Danish pastry apple bars recipe is a great way to enjoy apple pie in a bar form. The recipe features a homemade crust filled with tender apples.",
  "cuisine": "Danish American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C.)"
    },
    {
      "position": 2,
      "text": "Combine flour and salt in a large bowl. Cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Beat egg yolk in measuring cup; add enough milk to make 2/3 cup total liquid. Stir into flour mixture until mixture is damp."
    },
    {
      "position": 4,
      "text": "Divide dough in half. Roll one dough piece on a lightly floured surface; fit into a 9x13-inch pan."
    },
    {
      "position": 5,
      "text": "Combine apples, brown sugar, white sugar, cinnamon and nutmeg in a separate large bowl; top dough with apple mixture."
    },
    {
      "position": 6,
      "text": "Roll out remaining dough piece; place over apples. Seal edges; cut slits in top to vent."
    },
    {
      "position": 7,
      "text": "Beat egg white till frothy; brush on crust."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until pastry is golden brown, about 50 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

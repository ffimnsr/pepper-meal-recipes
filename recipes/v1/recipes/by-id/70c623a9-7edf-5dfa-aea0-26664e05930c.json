  "slug": "easy-eton-mess-recipe-7485220",
  "name": "Eton Mess",
  "recipe_type": "dessert",
  "brief_description": "Eton mess is incredibly easy dessert to make with chunky pieces of sweet meringue, whipped cream, and juicy berries for a sensational summer treat.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form."
    },
    {
      "position": 2,
      "text": "Break meringue cookies into bite-sized chunks and add to whipped cream; fold in berries lightly with a metal spoon until you see streaks of dark pink but still retain some chunks of meringue."
    },
    {
      "position": 3,
      "text": "Spoon Eton mess into four glass dishes and serve."
    }
  ],
  "servings": 4,

  "id": "fa1a969f-5fb5-59cf-a0ab-790a7a898cb1",
  "slug": "corn-dog-fries-recipe-12017227",
  "name": "Corn Dog Fries",
  "recipe_type": "appetizer",
  "brief_description": "These corn dog fries are crispy, surprisingly light, and even more snackable than their state-fair cousin. Thin strips of hot dog are coated in cornmeal batter, fried until golden, and made for dunking in ketchup and mustard. Don\u2019t expect them to last long!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat hot dogs dry with paper towels and place in an even layer on a large plate or small baking sheet. Freeze until firm, at least 30 minutes. Meanwhile, pour vegetable oil to a depth of about 2 inches into a medium Dutch oven. Heat over medium to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together corn muffin mix, egg, buttermilk, cornstarch, garlic powder, salt, and smoked paprika in a medium bowl until a thick batter forms."
    },
    {
      "position": 3,
      "text": "Working in batches, dip frozen hot dog strips into batter, allowing excess to drip off. Carefully add to hot oil. Fry, turning occasionally, until batter is deep golden brown and crisp and hot dogs are heated through, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Transfer corn dog fries to a paper towel-lined baking sheet. Serve immediately with ketchup and mustard. Recipe deverloped by Marianne Williams"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "c7e28115-a699-5bce-8bbf-ca8af932f8dd",
  "slug": "big-batch-freezer-strawberry-cosmopolitans-recipe-11733218",
  "name": "Big Batch Freezer Strawberry Cosmopolitans",
  "recipe_type": "appetizer",
  "brief_description": "Here's a big batch freezer strawberry Cosmopolitan recipe to start your next party. It's easy to make the strawberry simple syrup, and then to combine it with vodka, lime juice and orange liqueur in the vodka bottle. Keep it in the freezer until ready to pour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries, sugar and 3/4 cup water in a small saucepan over medium-high heat. Bring to a boil, stirring occasionally. Reduce heat to a simmer and cook until mixture has thickened slightly and reduced a little, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Strain strawberry mixture into a jar and discard solids. Let cool completely and refrigerate until ready to use."
    },
    {
      "position": 3,
      "text": "Pour 1 3/4 cups vodka from bottle and reserve for another use. To the remaining vodka, add 1/2 cup cooled strawberry simple syrup, orange liqueur, lime juice, and remaining 1/4 cup water. Seal the bottle and tilt it gently to mix the ingredients."
    },
    {
      "position": 4,
      "text": "Place bottle in freezer for at least 6 hours or until ready to serve."
    },
    {
      "position": 5,
      "text": "Lightly shake bottle before serving in a martini glass and garnish individual cosmos with a slice of lime if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

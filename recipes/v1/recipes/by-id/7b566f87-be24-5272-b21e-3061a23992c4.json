  "id": "7b566f87-be24-5272-b21e-3061a23992c4",
  "slug": "microwave-popcorn",
  "name": "Microwave Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Microwave popcorn is easy to make using standard popping corn and a brown paper lunch bag \u2014 it's low-fat, delicious, and works perfectly every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together unpopped popcorn and oil in a cup or small bowl."
    },
    {
      "position": 3,
      "text": "Pour the coated corn into a brown paper lunch sack, and sprinkle in the salt. Fold the top of the bag over twice to seal in the ingredients."
    },
    {
      "position": 4,
      "text": "Cook in the microwave at full power for 2 1/2 to 3 minutes, or until you hear pauses of about 2 seconds between pops. Carefully open the bag to avoid steam, and pour into a serving bowl."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 2,

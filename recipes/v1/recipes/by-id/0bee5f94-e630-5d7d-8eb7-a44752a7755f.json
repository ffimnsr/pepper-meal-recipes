{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0bee5f94-e630-5d7d-8eb7-a44752a7755f",
  "slug": "blueberry-pie-with-flax-and-almonds",
  "name": "Blueberry Pie with Flax and Almonds",
  "recipe_type": "dessert",
  "brief_description": "In this tasty pie, ground flax seed, almonds, yogurt, and honey add flavor and replace some of the sugar and butter of typical sour-cream blueberry pie recipes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the graham cracker crumbs, flax seed meal, and ground almonds in a bowl; stir in the melted butter. Add a few drops of water, if necessary, for the crumb mixture to stick together. Press half of the crumb mixture into the bottom and sides of a 9-inch pie pan; the crust should only be about 1/8-inch thick. Set the other half of the crumb mixture aside."
    },
    {
      "position": 3,
      "text": "Combine the sour cream, yogurt, ground oats, sugar, honey, vanilla, and salt in a blender. Blend until combined. Transfer the blueberries to the pie pan and pour in the filling."
    },
    {
      "position": 4,
      "text": "To make the topping, stir 2 tablespoons of honey, or to taste, into the reserved crumb mixture. It should form a very thick paste. Drop teaspoonfuls of the topping on the surface of the pie."
    },
    {
      "position": 5,
      "text": "Bake the pie in the preheated oven on the middle rack for 30 to 45 minutes, or until the center is set and a knife inserted near the center of the pie comes out clean. Turn off the oven and let the pie rest in the warm oven for 10 minutes."
    },
    {
      "position": 6,
      "text": "Remove the pie from the oven and let cool on a wire rack. Chill in the refrigerator until the pie is cool and set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d2e66a56-d1d0-52f7-bd45-17badc791ebd",
  "slug": "quick-microwave-chicken-cordon-bleu-casserole",
  "name": "Quick Microwave Chicken Cordon Bleu Casserole",
  "recipe_type": "soup",
  "brief_description": "This chicken Cordon Bleu casserole is cooked in the microwave and uses shortcut ingredients like canned chicken and cream of chicken soup to cut down on time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Add egg noodles and cook at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Combine drained noodles, chicken, ham, and Swiss cheese in a large mixing bowl; mix until well combined."
    },
    {
      "position": 3,
      "text": "Stir together cream of chicken soup, milk, and sour cream in a separate bowl until smooth. Pour sauce over noodles and mix until sauce is well distributed. Transfer mixture to a large microwave-safe casserole dish."
    },
    {
      "position": 4,
      "text": "Place butter in a microwave-safe bowl. Cook on high until melted, about 30 to 45 seconds. Add bread crumbs and Parmesan cheese. Mix until well blended and crumbly and sprinkle on top of casserole."
    },
    {
      "position": 5,
      "text": "Microwave casserole uncovered for 10 minutes. Allow to cool for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "006b903f-5a40-59eb-9631-9e4bf0fd3ed6",
  "slug": "carries-pad-thai-salad",
  "name": "Carrie's Pad Thai Salad",
  "recipe_type": "salad",
  "brief_description": "This Thai salad with noodles, egg, cilantro, and peanuts, dressed with sweet-soy lime and tamarind sauce is a refreshing take on pad Thai.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Place noodles in a large bowl with enough hot water to cover; soak noodles until soft, about 10 minutes. Strain."
    },
    {
      "position": 2,
      "text": "Combine sugar, water, lime juice, soy sauce, fish sauce, and tamarind in a large saucepan over medium heat. Simmer gently, stirring occasionally, until sauce is slightly thickened, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Heat peanut oil in a large skillet over medium heat. Add garlic; stir just until fragrant, 30 to 60 seconds. Add eggs; cook and stir until almost set, 2 to 3 minutes. Add noodles to egg mixture; stir in 1/2 of soy-tamarind sauce mixture. Continue to cook and stir noodle mixture until hot, adding additional sauce as desired, 2 to 3 minutes more. Sprinkle paprika and chili powder over noodles."
    },
    {
      "position": 4,
      "text": "Layer lettuce on a serving dish or in individual bowls; drizzle with flaxseed oil. Place noodle mixture on lettuce; garnish with bean sprouts, green onion, cilantro, and peanuts. Serve with lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

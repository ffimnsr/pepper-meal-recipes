{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ab21d3b3-008a-5bd2-86d3-4bc18239f8b5",
  "slug": "sweet-potato-sonker-recipe-11851116",
  "name": "This Cozy North Carolina Dessert Might Be the Best Holiday Dessert You've Never Tried",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato sonker is a crust-and-lattice deep dish pie, very similar in flavor to sweet potato pie, but the milk dip sets it apart. It melts into the sugar-crunch topped crust, making its own sauce, like melting ice cream on apple pie. This may be the dessert most talked about on your holiday table.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) with a rack in the bottom third position. Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Working on another large sheet of parchment, unroll 2 dough rounds and place 1 on top of the other. Roll out dough to a 17x13-inch rectangle, about 1/8-inch thick; fit into the bottom and sides of a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Repeat shaping and rolling with remaining 2 dough rounds.Trim dough to create an even rectangle; cut into 10 (1-inch wide) strips. Use scraps to patch any bare edges of dough in the baking dish. Transfer dough strips to prepared baking sheet, and cover both crust and strips with a clean kitchen towel. Refrigerate crust and strips for at least 30 minutes or until ready to use."
    },
    {
      "position": 4,
      "text": "Meanwhile, place sweet potatoes and 1 tablespoon salt in a large saucepan and cover with 1 inch of cold water; bring to a boil over high heat. Reduce heat to medium-low and simmer until just tender, 6 to 8 minutes. Set aside 3/4 cup of cooking water, and drain potatoes well."
    },
    {
      "position": 5,
      "text": "Whisk brown sugar, melted butter, cornstarch, lemon juice, vanilla, cinnamon, ginger, and remaining salt together in a large bowl until smooth."
    },
    {
      "position": 6,
      "text": "Whisk reserved 3/4 cup cooking water into brown sugar mixture. Add cooked sweet potatoes and gently toss to coat."
    },
    {
      "position": 7,
      "text": "Transfer sweet potatoes with a slotted spoon to crust-lined baking dish and spread in an even layer. Pour remaining brown sugar mixture in the bowl into a small saucepan and bring to a simmer over medium heat; continue to cook, whisking constantly, until mixture resembles applesauce, about 45 seconds. Pour evenly over sweet potatoes in baking dish."
    },
    {
      "position": 8,
      "text": "With long side of dish facing you, lay 4 of the dough strips lengthwise over sweet potato mixture. Weave remaining 6 strips into a lattice pattern. Trim strips to edge of baking dish. Fold bottom crust over lattice strips and roll. Crimp as desired."
    },
    {
      "position": 9,
      "text": "Brush crust and lattice with egg and sprinkle evenly with white sugar."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until deep golden brown, 50 to 55 minutes, rotating dish front to back halfway through baking."
    },
    {
      "position": 11,
      "text": "Meanwhile, for milk dip, whisk milk, sugar, and salt together in a large saucepan. Place over medium-high heat, and bring to a gentle boil, whisking occasionally. Meanwhile, whisk together cornstarch and water in a small bowl until smooth; whisk into milk mixture. Reduce heat to medium-low, and cook, whisking constantly, until thickened, 2 to 3 minutes. Remove from heat and whisk in vanilla. Reserve 3/4 cup milk dip; set aside remaining milk dip to cool."
    },
    {
      "position": 12,
      "text": "Remove sonker from the oven and pour reserved 3/4 cup milk dip evenly over the top, then return to oven and continue baking until bubbly, 5 to 10 minutes more."
    },
    {
      "position": 13,
      "text": "Remove from oven; cool on wire rack for at least 1 1/2 hours. Drizzle remaining milk dip over each piece to serve. Recipe developed by Julia Levy"
    }
  ],
  "servings": 12,

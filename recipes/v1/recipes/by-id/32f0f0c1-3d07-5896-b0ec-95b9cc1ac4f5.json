  "id": "32f0f0c1-3d07-5896-b0ec-95b9cc1ac4f5",
  "slug": "billys-bbq-chicken-recipe",
  "name": "Billy's BBQ Chicken Recipe",
  "recipe_type": "main",
  "brief_description": "An easy BBQ Chicken Recipe that anyone can prepare. Get that chicken and corn grilling and enjoy the food!",
  "cuisine": "american",
  "instructions": [
    {
      "position": 1,
      "text": "Coat the chicken pieces with oil and rub salt and pepper all over."
    },
    {
      "position": 2,
      "text": "Start heating-up your grill. Both charcoal and gas grills are ok to use."
    },
    {
      "position": 3,
      "text": "Place the chicken on the hot grill. Let each side grill for 7 minutes. Baste the uncooked side of the chicken with BBQ sauce."
    },
    {
      "position": 4,
      "text": "Turn-over the chicken. Baste the grilled side with BBQ sauce. Close the grill. Have the chicken grill for 8 to 10 minutes. Continue to turn over the chicken and grill for 5 minutes on each side until the inside temp reaches 170F (you need a meat thermometer to be on the safe side)."
    },
    {
      "position": 5,
      "text": "Serve this with grilled corn on the cob."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,

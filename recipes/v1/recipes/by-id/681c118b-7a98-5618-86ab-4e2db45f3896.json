  "id": "681c118b-7a98-5618-86ab-4e2db45f3896",
  "slug": "zuppa-di-pesce-fra-di-avolo",
  "name": "Zuppa Di Pesce Fra Di Avolo",
  "recipe_type": "main",
  "brief_description": "Zuppa di pesce is a rustic Italian seafood stew packed with shellfish, tomatoes, and herbs. This version spices things up with red chili flakes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 3 tablespoons olive oil in a large skillet over medium heat; cook and stir sea scallops, shrimp, and calamari rings in the hot oil until scallops and calamari are opaque and shrimp are pink, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Bring a separate pot of water to a boil and add mussels and littleneck clams to the boiling water; cook until shells have opened, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove shellfish and rinse with hot water."
    },
    {
      "position": 5,
      "text": "Pour crushed tomatoes, water, 2 cans chopped clams, 1/4 cup olive oil, onion, red pepper flakes, garlic, oregano, parsley, and salt into a large pot and bring to a boil."
    },
    {
      "position": 6,
      "text": "Stir cooked scallops, shrimp, calamari, mussels in shells, and littleneck clams in shells into tomato mixture. Reduce heat to low and simmer for 1 hour."
    },
    {
      "position": 7,
      "text": "About 10 minutes before serving, bring a large pot of lightly salted water to a boil; cook the linguine at a boil until tender yet firm to the bite, about 10 minutes; drain and rinse pasta in hot water to prevent sticking."
    },
    {
      "position": 8,
      "text": "Serve seafood and sauce over pasta."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

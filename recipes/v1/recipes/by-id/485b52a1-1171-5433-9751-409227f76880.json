  "id": "485b52a1-1171-5433-9751-409227f76880",
  "slug": "cheesy-stuffed-garlic-hawaiian-rolls-recipe-8623154",
  "name": "Cheesy Stuffed Garlic Hawaiian Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These cheesy stuffed garlic Hawaiian rolls are a quick and easy upgrade to the Hawaiian rolls for party food or dinner. They're baked with string cheese tucked inside, and parsley-garlic butter brushed over top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Separate each roll and, using a paring knife, cut a 1/2-inch slit in the side and hollow out a small hole, taking care not to cut all the way through."
    },
    {
      "position": 2,
      "text": "Cut each string cheese in half and stick 1 piece into each prepared roll. Place rolls in a baking dish nestled close to each other."
    },
    {
      "position": 3,
      "text": "Place butter, garlic, parsley, salt, and pepper in a small microwave-safe bowl or measuring cup and cover loosely with a paper towel. Microwave until melted, stirring halfway through, until melted, 30 seconds to 1 minute. Brush butter mixture generously over each roll and sprinkle with grated Parmesan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until rolls are golden brown and lightly toasted, 15 to 18 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

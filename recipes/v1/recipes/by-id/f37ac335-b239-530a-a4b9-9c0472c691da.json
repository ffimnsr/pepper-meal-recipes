  "id": "f37ac335-b239-530a-a4b9-9c0472c691da",
  "slug": "jif-irresistible-peanut-butter-cookies",
  "name": "Jif Irresistible Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This Jif irresistible peanut butter cookies recipe uses Jif peanut butter and butter flavor Crisco to take a favorite cookie classic to the next level.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F. Place sheets of foil on the countertop for cooling cookies."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, Jif peanut butter, shortening, milk, and vanilla in a large bowl. Beat with an electric mixer on medium speed until well blended. Add egg; beat until just blended."
    },
    {
      "position": 3,
      "text": "Combine flour, baking soda, and salt in a medium bowl. Add to sugar-peanut butter mixture; beat on low speed until just blended."
    },
    {
      "position": 4,
      "text": "Drop by rounded tablespoonfuls 2 inches apart onto ungreased cookie sheets. Flatten slightly in a crisscross pattern with the tines of a fork."
    },
    {
      "position": 5,
      "text": "Bake 1 sheet at a time in the preheated oven until set and just beginning to brown, 7 to 8 minutes. Do not overbake. Cool for 2 minutes on the baking sheet. Remove cookies to the foil sheets on the counter to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

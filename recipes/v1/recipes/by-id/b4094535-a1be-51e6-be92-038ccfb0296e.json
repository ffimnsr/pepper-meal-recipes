  "id": "b4094535-a1be-51e6-be92-038ccfb0296e",
  "slug": "veronicas-apple-pancakes",
  "name": "Apple Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These apple pancakes are made with a simple pancake batter loaded with freshly grated apple and cinnamon. Perfect for a fall breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sift flour, sugar, baking powder, and cinnamon together in a large bowl."
    },
    {
      "position": 3,
      "text": "Make a well in the center and add milk, melted butter, and egg; mix until smooth. Stir grated apple into pancake batter until just combined."
    },
    {
      "position": 4,
      "text": "Heat a lightly oiled griddle or frying pan over medium-high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each pancake; cook until bubbles form and the edges are dry, about 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Flip and cook until browned on the other side. Repeat with remaining pancake batter."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "95c9dfe4-a06a-5d76-8eca-fe63392bd0f7",
  "slug": "vanilla-cupcakes-with-swiss-meringue-buttercream",
  "name": "Vanilla Cupcakes with Swiss Meringue Buttercream",
  "recipe_type": "dessert",
  "brief_description": "Try this vanilla cupcake recipe for two dozen deliciously moist cupcakes topped with a light and fluffy frosting of Swiss meringue buttercream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners."
    },
    {
      "position": 2,
      "text": "Make the cupcakes: Mix flour, baking powder, and salt together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar with an electric mixer in a large bowl until creamy. Add eggs, 1 at a time, followed by vanilla, beating well after each addition. Mix in flour mixture alternately with milk until smooth. Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 15 to 23 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and cool in the tins for 5 minutes. Transfer cupcakes to a wire rack and let cool completely, about 20 minutes."
    },
    {
      "position": 6,
      "text": "While the cupcakes are cooling, make the buttercream: Bring a pan of water to a simmer. Combine sugar, egg whites, and salt in the bowl of a stand mixer. Place the bowl on top of the pan and whisk until sugar dissolves."
    },
    {
      "position": 7,
      "text": "Attach the bowl to the stand mixer and beat with a whisk attachment until mixture is cool and glossy and stiff peaks form. Add butter, a few tablespoons at a time, beating well after each addition. Add vanilla and mix until smooth."
    },
    {
      "position": 8,
      "text": "Spread buttercream onto cooled cupcakes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,

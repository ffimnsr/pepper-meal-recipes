{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3b147491-7a63-5b58-84cd-d158fefc8eb0",
  "slug": "butternut-squash-and-spicy-sausage-soup",
  "name": "Butternut Squash and Spicy Sausage Soup",
  "recipe_type": "soup",
  "brief_description": "This perfect autumn soup, this hearty dish with a chicken broth base combines baked butternut squash, spicy turkey sausage, rice, corn, and heavy cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Pour 1 cup water into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place butternut squash into the prepared baking dish, cut-side down."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until squash is easily pierced with a fork, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place rice and remaining 1 cup water into a medium saucepan. Bring to a boil, uncovered, over medium-high heat. Reduce heat to low, cover, and simmer until water is absorbed and rice is fluffy, about 20 minutes. Remove from the heat and fluff with a fork."
    },
    {
      "position": 5,
      "text": "Heat olive oil in a large soup pot over medium-high heat. Stir in onion and cook until tender and transparent, about 5 minutes. Mix in turkey sausage; cook until crumbly and evenly browned. Drain any excess fat. Stir in cooked rice and corn."
    },
    {
      "position": 6,
      "text": "Scoop out cooked squash and place in a blender or bowl of a food processor. Discard squash peels. Pour chicken broth into the blender or bowl of a food processor with squash. Blend until smooth, about 1 minute."
    },
    {
      "position": 7,
      "text": "Stir squash mixture into sausage mixture until well blended. Season with pepper and salt to taste. Stir in heavy cream. Simmer soup over medium heat until heated through, about 15 minutes; do not boil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "074ca79f-2f2b-5abd-8cf2-56965bdfd8ee",
  "slug": "buffalo-chicken-burgers-with-blue-cheese-dressing",
  "name": "Buffalo Chicken Burgers with Blue Cheese Dressing",
  "recipe_type": "main",
  "brief_description": "This recipe for Buffalo chicken burgers with blue cheese dressing packs the bold, tangy kick of Buffalo wings without the usual mess or extra calories.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Combine sour cream, blue cheese, and Worcestershire sauce in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Combine chicken, 1/4 cup hot sauce, celery salt, paprika, poultry seasoning, and cayenne pepper in a bowl until well mixed; form into four 3/4-inch-thick patties."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill until grill marks appear, 6 to 7 minutes; flip burgers. Coat top rolls with cooking spray; lightly toast on grill if desired. Brush cooked side of burgers with 1 tablespoon hot sauce; cook until no longer pink in centers and juices run clear, about 5 minutes more. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Place 1 lettuce leaf each on bottom rolls; top each with 1 burger, 2 tablespoons blue cheese sauce, 2 tablespoons celery, and top roll."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "easy-cheese-ball-ii",
  "name": "Easy Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Ranch dressing mix lends an herb-y tang to this easy Cheddar and cream cheese ball; the crunch comes from chopped pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mash cream cheese in a medium sized bowl. Mix dressing mix and Cheddar cheese into cream cheese. Shape the mixture into a ball. Roll the cheese ball in the chopped nuts. Refrigerate covered until ready to serve."
    }
  ],

  "id": "2228dccb-50d6-5cc9-b158-002a46068df6",
  "slug": "slow-cooker-pulled-pork",
  "name": "Slow Cooker Pulled Pork",
  "recipe_type": "main",
  "brief_description": "This easy slow cooker pulled pork recipe uses root beer to make the most tender pork\u2014just shred, toss with BBQ sauce, and pile onto toasted buns.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place pork tenderloin in a slow cooker; pour root beer over top."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low until pork shreds easily, 6 to 7 hours. Note: the actual length of time may vary according to the individual slow cooker."
    },
    {
      "position": 4,
      "text": "Drain well. Stir in barbecue sauce."
    },
    {
      "position": 5,
      "text": "Pile pulled pork onto hamburger buns."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,

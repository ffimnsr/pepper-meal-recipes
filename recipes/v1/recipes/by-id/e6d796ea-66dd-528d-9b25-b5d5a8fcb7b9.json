  "id": "e6d796ea-66dd-528d-9b25-b5d5a8fcb7b9",
  "slug": "delicious-black-bean-burritos",
  "name": "Delicious Black Bean Burritos",
  "recipe_type": "main",
  "brief_description": "This bean burrito recipe makes a hearty black bean and cheese filling for tortillas that's flavored with onion, garlic, cream cheese, and jalape\u00f1o.",
  "cuisine": "Southwestern Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Wrap tortillas in foil."
    },
    {
      "position": 2,
      "text": "Bake wrapped tortillas in the preheated oven until heated through, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a 10-inch skillet over medium heat. Add onion, bell pepper, garlic, and jalape\u00f1o; cook and stir for 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir in beans and cook until heated through, about 3 minutes. Stir in cream cheese and salt; cook, stirring occasionally, for 2 minutes. Stir in cilantro."
    },
    {
      "position": 5,
      "text": "Spoon filling in a line across the middle of each tortilla. Fold opposing edges of the tortilla to overlap the filling. Roll 1 of the opposing edges around the filling creating a burrito. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

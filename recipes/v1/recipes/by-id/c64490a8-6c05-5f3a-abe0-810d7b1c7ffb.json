  "id": "c64490a8-6c05-5f3a-abe0-810d7b1c7ffb",
  "slug": "worlds-best-honey-garlic-pork-chops",
  "name": "World\u2019s Best Honey Garlic Pork Chops",
  "recipe_type": "main",
  "brief_description": "These glazed honey garlic pork chops are quick and simple to cook on the grill in less than 30 minutes for a mouth-watering meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat grill for medium heat and lightly oil the grate. Gather ingredients."
    },
    {
      "position": 2,
      "text": "Whisk ketchup, honey, soy sauce, and garlic together in a bowl to make a glaze."
    },
    {
      "position": 3,
      "text": "Sear the pork chops on both sides on the preheated grill. Lightly brush glaze onto each side of the chops as they cook; grill until no longer pink in the center, about 7 to 9 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

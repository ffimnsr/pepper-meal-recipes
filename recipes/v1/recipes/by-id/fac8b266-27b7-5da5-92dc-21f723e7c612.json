  "id": "fac8b266-27b7-5da5-92dc-21f723e7c612",
  "slug": "pull-apart-chicken-sliders",
  "name": "Pull-Apart Chicken Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These chicken sliders are topped with garlic butter and baked until golden and oozing with melted cheese, tender chicken, red onion, and BBQ sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place roll bottoms on a baking sheet. Divide chicken, Cheddar cheese, BBQ sauce, onion, and parsley equally over rolls."
    },
    {
      "position": 3,
      "text": "Cover with roll tops; brush with melted butter. Sprinkle Parmesan cheese and garlic on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown and cheese is melted, about 20 minutes. Slice and serve."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

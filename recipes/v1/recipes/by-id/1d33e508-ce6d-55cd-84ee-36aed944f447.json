{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1d33e508-ce6d-55cd-84ee-36aed944f447",
  "slug": "gnocchi-spinach-and-meatball-soup",
  "name": "Gnocchi, Spinach, and Meatball Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy gnocchi spinach soup with mini meatballs, pasta, herbs, and fresh greens is a comforting, soothing dish to enjoy on a cold winter day.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium-low heat and saut\u00e9 onion in hot oil until soft and translucent, about 5 minutes. Add garlic; cook and stir until fragrant, about 30 seconds. Add chicken broth, bay leaf, Italian seasoning, sea salt, and pepper; bring slowly to a simmer, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, prepare meatballs: Combine ground beef, beaten egg, bread crumbs, 2 tablespoons Parmesan cheese, onion powder, Italian seasoning, Worcestershire sauce, garlic salt, and pepper in a large bowl. Mix until well combined. Roll mixture into tiny 1/2-inch meatballs."
    },
    {
      "position": 3,
      "text": "Drop meatballs carefully, one at a time, into simmering soup in the pot. Bring to a slow simmer and cook for 20 minutes. Skim off any foam that comes to the surface with a spoon and discard."
    },
    {
      "position": 4,
      "text": "Add gnocchi, escarole, and carrot; bring soup back to a simmer. Stir in half-and-half, spinach, and basil. When gnocchi rise to the top, remove from heat."
    },
    {
      "position": 5,
      "text": "Discard bay leaf and garnish with 1/4 cup Parmesan cheese to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

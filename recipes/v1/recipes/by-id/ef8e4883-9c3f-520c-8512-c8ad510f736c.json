  "id": "ef8e4883-9c3f-520c-8512-c8ad510f736c",
  "slug": "slow-cooker-pork-rib-tips",
  "name": "Slow Cooker Pork Rib Tips",
  "recipe_type": "main",
  "brief_description": "These pork rib tips are cooked with smoky BBQ sauce for hours in a slow cooker until tender, then caramelized under the broiler until hot and sticky.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together brown sugar, chili powder, salt, black pepper, garlic powder, and onion powder in a large bowl until combined. Add rib tips and mix until ribs are thoroughly coated. Let rest at room temperature for 10 minutes."
    },
    {
      "position": 3,
      "text": "Place coated ribs in a slow cooker. Stir together 3/4 of the BBQ sauce with liquid smoke in a medium bowl until well combined. Pour evenly over ribs. Cook on Low until ribs are tender, 4 to 6 hours. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking tray or broiler rack with aluminum foil."
    },
    {
      "position": 4,
      "text": "Remove ribs to the prepared tray and baste with remaining BBQ sauce."
    },
    {
      "position": 5,
      "text": "Cook ribs under the preheated broiler until sauce is hot and sticky, 3 to 5 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 245,
  "preparation_time_minutes": 10,

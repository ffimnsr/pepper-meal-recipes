  "id": "bfde26a8-4bea-5f82-973e-8ae5e1ea4043",
  "slug": "3-cheese-enchiladas",
  "name": "3-Cheese Enchiladas",
  "recipe_type": "main",
  "brief_description": "Cheese enchiladas are perfect for a quick and easy dinner! Filled with green onions and your favorite salsa, these 3-cheese enchiladas are ready in just 40 minutes.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 2 cups salsa, cream cheese, and \u00bd green onions in a bowl."
    },
    {
      "position": 3,
      "text": "Stir in 2 cups Cheddar cheese and 2 cups Monterey Jack cheese to combine."
    },
    {
      "position": 4,
      "text": "Spoon a scant \u00bd cup cheese filling in a line across middle of each tortilla. Roll tortillas around filling."
    },
    {
      "position": 5,
      "text": "Place enchiladas, seam-sides down, in a 9x13-inch baking dish."
    },
    {
      "position": 6,
      "text": "Spread remaining 1 cup salsa over top of enchiladas."
    },
    {
      "position": 7,
      "text": "Combine remaining \u00bd cup each Cheddar and Monterey Jack in a bowl; sprinkle over enchiladas, then scatter remaining green onions over top. Cover the dish with aluminum foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until enchiladas are warmed through and cheese is melted and bubbly, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

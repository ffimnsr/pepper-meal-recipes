  "id": "e80f114e-9d26-5e5f-8bbe-014884f7c312",
  "slug": "savory-parmesan-french-toast",
  "name": "Savory Parmesan French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Savory French toast made with whole wheat bread, eggs, milk, Parmesan, and pepper. A tasty recipe for a quick and easy cheesy take on French toast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs, Parmesan cheese, milk, and black pepper in a shallow bowl until light and fluffy, about 1 minute."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat."
    },
    {
      "position": 3,
      "text": "Dip both sides of each slice of bread in egg mixture; place bread in hot butter in the skillet. Cook until golden brown, 2 to 3 minutes per side."
    },
    {
      "position": 4,
      "text": "Transfer to a warmed plate and dot with butter to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "20bb27fd-2492-557f-8701-a62cbb294e47",
  "slug": "cinnamon-apple-baked-french-toast-recipe-7372061",
  "name": "Cinnamon Apple Baked French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This twist on a classic french toast adds in apples and honey to create a crisp summertime breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a standard-sized loaf pan with parchment paper. Set aside. Cut bread into 1 inch thick slices. Set aside."
    },
    {
      "position": 2,
      "text": "Whisk eggs, maple syrup or honey, cinnamon, vanilla extract, and salt together in a bowl. Stir in Almond Breeze Unsweetened Vanilla Almondmilk. Soak sliced bread in the mixture, turning to coat both sides evenly."
    },
    {
      "position": 3,
      "text": "Meanwhile, slice apples horizontally into thin rings. Use a corer or a metal frosting tip to core the apple core from the slices."
    },
    {
      "position": 4,
      "text": "Layer soaked bread slices and apples in the prepared loaf pan, alternating 1 slice of bread to 3 slices of apples. If you have any egg mixture left over once you\u2019re done, pour it over the entire loaf. Sprinkle with chopped Blue Diamond Almonds and cover loosely with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 45 to 50 minutes, removing the tin foil after 30 minutes. Allow to cool for 10 minutes before sprinkling with powdered sugar!"
    },
    {
      "position": 6,
      "text": "To serve, use a bread knife to cut slices from the loaf. Drizzle with maple syrup!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5db4cdb5-befb-53ac-a3fb-46cbf751b4a2",
  "slug": "puff-pastry-ham-and-broccoli-quiche-recipe-8665973",
  "name": "Puff Pastry Ham and Broccoli Quiche",
  "recipe_type": "breakfast",
  "brief_description": "For this puff pastry ham and broccoli quiche, the crust is made using a sheet of puff pastry instead of a pie shell. You'll love the flakiness, and the flavor.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Thaw puff pastry in the refrigerator until cold to the touch but easy to manipulate, about 4 hours, or according to package directions."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly flour a work surface. Place thawed puff pastry on the floured surface and unfold gently. Roll out pastry to a 13-inch square. Trim the corners of pastry to a 13-inch circle and place in a 9-inch quiche or pie pan."
    },
    {
      "position": 3,
      "text": "Fill pastry with pie weights or dried beans, and prick the sides with a fork. Place the pie pan on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the center of the preheated oven for 8 to 10 minutes. If pastry puffs up while baking, gently press with the back of a fork and continue baking."
    },
    {
      "position": 5,
      "text": "Remove from the oven and allow to cool slightly. Remove pie weights or dried beans."
    },
    {
      "position": 6,
      "text": "Toss chopped broccoli, chopped ham, shredded cheese, and minced onion together in a bowl, and then pour into the baked crust."
    },
    {
      "position": 7,
      "text": "Using the same bowl, add eggs, heavy cream, whole milk, and cayenne. Beat until the mixture has a uniform color and texture. Slowly pour egg mixture into crust and gently stir, to distribute egg mixture evenly with other ingredients."
    },
    {
      "position": 8,
      "text": "Bake quiche on the baking sheet in the preheated oven, until a knife inserted into the center comes out clean, 35 to 40 minutes. If the knife has liquid on it when inserted, continue baking 3 to 5 minutes, and retest."
    },
    {
      "position": 9,
      "text": "Remove to cool on a rack for 10 to 15 minutes. Garnish with fresh parsley or chopped scallions. Serve warm or at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "08f790f2-b11b-5ae9-b362-6c9db7914da6",
  "slug": "grilled-brussels-sprouts-with-bacon-and-peppers-recipe-11990560",
  "name": "Grilled Brussels Sprouts with Bacon and Peppers",
  "recipe_type": "dessert",
  "brief_description": "In these grilled Brussels sprouts with bacon and peppers, grilling sweetens the vegetables while the bacon sears. The magic all happens in one pan in just a few minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare a charcoal grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Place Brussel sprouts, bacon, bell peppers, 1 tablespoon olive oil, and 1 tablespoon vegetable seasoning in a large bowl and toss well."
    },
    {
      "position": 3,
      "text": "Place a grill wok or veggie grill pan on the hot side of the grill and add veggies. Close grill lid. Allow to grill for 5 minutes. Remove lid; mix veggies with a grill-safe spoon. Vegetables should begin to char."
    },
    {
      "position": 4,
      "text": "Move grill wok to the cool side of the grill, close lid, and allow to grill 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Drizzle honey and olive oil directly on the veggies, mix well, and close lid. Continue grilling until vegetables are soft, about 5 minutes more. Remove grill wok from the grill. Place vegetables in a bowl. Add remaining veggie seasoning and mix well."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

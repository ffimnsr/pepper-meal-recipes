  "slug": "confetti-puffed-corn",
  "name": "Confetti Puffed Corn",
  "recipe_type": "appetizer",
  "brief_description": "This confetti puffed corn recipe dresses up puffed corn with white chocolate and colored sprinkles. Adjust sprinkle colors to match specific holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place almond bark into a microwave-safe bowl. Microwave on high power until melted, about 4 minutes, stirring every 30 seconds."
    },
    {
      "position": 2,
      "text": "Place puffed corn in a large bowl; pour melted almond bark on top and toss until evenly coated."
    },
    {
      "position": 3,
      "text": "Distribute sprinkles evenly over puffed corn. Cool before storing."
    }
  ],

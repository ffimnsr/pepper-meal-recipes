  "id": "c9df4bae-b4a2-5f53-a1d6-a286ee62583a",
  "slug": "pumpkin-pie-french-toast",
  "name": "Pumpkin Pie French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This pumpkin pie French toast recipe is a fun spin on a traditional breakfast dish. Pumpkin spice and pie lovers can now enjoy it served for breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly oil a skillet and heat over medium heat."
    },
    {
      "position": 2,
      "text": "Whisk eggs, half-and-half, pumpkin pur\u00e9e, cinnamon, vanilla, and pumpkin pie spice together in a bowl; stir in walnuts."
    },
    {
      "position": 3,
      "text": "Dip 1 bread slice into pumpkin mixture; soak. Add soaked bread slices to the hot skillet, in batches. Repeat with remaining bread slices, stirring pumpkin mixture to redistribute walnuts as necessary."
    },
    {
      "position": 4,
      "text": "Cook batches until golden brown, about 3 minutes per side. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

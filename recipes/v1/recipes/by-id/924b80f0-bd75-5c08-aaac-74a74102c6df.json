  "id": "924b80f0-bd75-5c08-aaac-74a74102c6df",
  "slug": "everything-bagel-grilled-cheese-recipe-8753365",
  "name": "Everything Bagel Grilled Cheese",
  "recipe_type": "breakfast",
  "brief_description": "This everything bagel grilled cheese sandwich is taken to another level just by starting with an everything-seasoned bagel. It\u2019s perfectly crunchy on the outside, and really, any melty cheese will work.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a skillet over medium heat. Slather 1/2 tablespoon mayonnaise on each cut side of bagel."
    },
    {
      "position": 2,
      "text": "Place 1 bagel half, mayonnaise side down, in the skillet. Place both slices of cheese on top; then place second bagel half, cut side up, on top of cheese."
    },
    {
      "position": 3,
      "text": "Press down on sandwich with a spatula, and cook until golden brown, 2 to 4 minutes. Flip sandwich over, press down, and cook until browned, 2 to 4 minutes more."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

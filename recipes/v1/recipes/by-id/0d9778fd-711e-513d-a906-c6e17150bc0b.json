  "id": "0d9778fd-711e-513d-a906-c6e17150bc0b",
  "slug": "spiced-cutouts",
  "name": "Spiced Cutouts",
  "recipe_type": "dessert",
  "brief_description": "A delicious gingerbread cookie with a hint of orange. These smell so good, you can't keep them a secret.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream butter and sugar. Beat in the molasses and egg. Sift together the flour, baking soda, cinnamon, ginger, cloves, and cardamom; stir into the creamed mixture alternately with the orange juice. Then stir in the orange zest."
    },
    {
      "position": 3,
      "text": "On a lightly floured surface, roll the dough out to 1/8 inch thickness. Cut out cookies with cookie cutters, and place them on an unprepared cookie sheet. Bake in the preheated oven for 8 to 10 minutes, edges should be slightly browned. Cool cookies on wire racks."
    }
  ],
  "servings": 54,

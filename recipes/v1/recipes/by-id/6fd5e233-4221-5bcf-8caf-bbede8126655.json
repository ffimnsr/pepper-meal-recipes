  "slug": "sheet-pan-pumpkin-spice-french-toast-recipe-11775464",
  "name": "Sheet Pan Pumpkin-Spice French Toast",
  "recipe_type": "dessert",
  "brief_description": "This sheet pan pumpkin spice French toast is sweetened with flavored coffee creamer. For extra fall flavor, top off this breakfast dish with pumpkin butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Coat a 10x15-inch rimmed sheet pan with cooking spray or line with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together eggs, creamer, pumpkin, maple syrup, and salt in a bowl; pour into a shallow dish. Soak bread slices in egg mixture, turning once, until well soaked. Shingle bread slices in the prepared pan; sprinkle with pumpkin pie spice."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 25 to 30 minutes. Serve with pumpkin butter, almonds, powdered sugar, and/or additional maple syrup."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

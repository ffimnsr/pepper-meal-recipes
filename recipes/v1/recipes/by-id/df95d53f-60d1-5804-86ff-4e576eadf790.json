  "id": "df95d53f-60d1-5804-86ff-4e576eadf790",
  "slug": "stefs-whoopie-pies-with-peanut-butter-frosting",
  "name": "Stef's Whoopie Pies with Peanut Butter Frosting",
  "recipe_type": "dessert",
  "brief_description": "This easy recipe for homemade whoopie pies with peanut butter frosting are perfect for a peanutty, chocolaty, cakey treat!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together 1 cup butter and egg. Add 1 cup white sugar, vanilla, and hot water. Stir in flour, cocoa, and baking soda and mix well."
    },
    {
      "position": 3,
      "text": "Drop from a teaspoon onto cookie sheets and bake in the preheated oven for 10 to 12 minutes; set aside to cool."
    },
    {
      "position": 4,
      "text": "To make peanut butter frosting: Blend 1 tablespoon butter and peanut butter together until smooth. Stir in confectioners' sugar and add enough milk to make frosting soft enough to spread. Spread between the flat sides of two cookies and sandwich together. Repeat with remaining cookies."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

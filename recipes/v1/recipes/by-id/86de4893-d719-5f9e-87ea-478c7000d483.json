  "id": "86de4893-d719-5f9e-87ea-478c7000d483",
  "slug": "beef-or-moose-jerky",
  "name": "Beef or Moose Jerky",
  "recipe_type": "appetizer",
  "brief_description": "This beef or moose jerky recipe is smoky, savory, and sweet, made with a marinated rump roast for flavor and finished in a dehydrator in just 12 hours.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice roast into slabs approximately \u00bc-inch thick. Trim off fat from the edges. Cut the slabs into pencil-like strips, about \u00bc-inch wide and about 4 inches long."
    },
    {
      "position": 2,
      "text": "Whisk soy sauce, brown sugar, and hickory-flavored liquid smoke together in a large bowl. Add meat and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove meat from marinade and shake off excess. Discard remaining marinade. Place meat strips in a food dehydrator for about 12 to 20 hours, depending on how dry you like your jerky. Rotate the trays after 6 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 720,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

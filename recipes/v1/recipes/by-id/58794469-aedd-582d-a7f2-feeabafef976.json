  "id": "58794469-aedd-582d-a7f2-feeabafef976",
  "slug": "chicken-bacon-ranch-tater-tot-casserole-recipe-8751351",
  "name": "Chicken Bacon Ranch Tater Tot Casserole",
  "recipe_type": "main",
  "brief_description": "Chicken Bacon Ranch Tater Tot Casserole combines crispy tater tots, creamy ranch, savory chicken, and smoky bacon for the ultimate comfort food dish. Loaded with shortcuts, this easy recipe is perfect for a weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 450 degrees F (200 degrees C). Lightly coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread potato tots on a large baking sheet into an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden and crispy, about 35 minutes. Remove from oven and set aside. Reduce oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "While potato tots cook, whisk together cream of chicken soup, sour cream, ranch dressing, ranch dressing mix, black pepper, and granulated garlic in a large bowl until thoroughly combined. Fold in chicken, Cheddar, and 1 cup of the cooked bacon until fully coated in sour cream mixture."
    },
    {
      "position": 5,
      "text": "Transfer chicken mixture to prepared baking dish and spread it into an even layer. Top evenly with cooked potato tots. Bake in preheated oven until bubbling around edges, 30 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Sprinkle evenly with remaining 1/4 cup cooked bacon; garnish with scallions. Recipe developed by Craig Ruff"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

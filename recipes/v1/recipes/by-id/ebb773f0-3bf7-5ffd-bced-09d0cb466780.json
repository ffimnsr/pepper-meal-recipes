  "id": "ebb773f0-3bf7-5ffd-bced-09d0cb466780",
  "slug": "sweet-deviled-eggs",
  "name": "Sweet Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Try these sweet deviled eggs with just a bit more sugar than normally used in classic deviled eggs. You'll be pleasantly surprised with the taste!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, then remove from then heat and let stand in hot water for 15 minutes. Transfer eggs to a bowl of ice water and let stand for 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Peel eggs, then slice in half lengthwise; set whites aside. Place yolks into a bowl and mash with a fork or pastry blender until powdery. Stir in mayonnaise, sugar, honey mustard, vinegar, salt, and pepper until well combined."
    },
    {
      "position": 3,
      "text": "Spoon or pipe yolk mixture into halved egg whites. Arrange on a plate and lightly sprinkle with paprika. Chill for 20 to 30 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

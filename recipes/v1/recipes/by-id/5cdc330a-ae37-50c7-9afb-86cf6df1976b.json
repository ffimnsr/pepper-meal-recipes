  "id": "5cdc330a-ae37-50c7-9afb-86cf6df1976b",
  "slug": "butter-beans-alla-vodka-recipe-8660103",
  "name": "These Viral Butter Beans alla Vodka Are the Easiest Weeknight Dinner",
  "recipe_type": "main",
  "brief_description": "These simple butter beans alla vodka in a slightly spicy homemade sauce in just 45 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a 4-quart saucepan or Dutch oven over medium heat. Add onion and season with \u00bd teaspoon salt. Cook until onions are soft, about 7 minutes. Add garlic and continue cooking until onions are translucent but not browned, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Add tomato paste and stir until thickened, 3 to 4 minutes. Add crushed tomatoes. Stir to combine. Cook until the sauce thickens, stirring often, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Add heavy cream. For slightly chunky sauce, stir to combine. For smooth sauce, puree using an immersion blender."
    },
    {
      "position": 5,
      "text": "Stir in Parmesan cheese. Once combined, reduce to medium-low heat. Add vodka and bring sauce to low simmer and cook for 15 minutes, stirring frequently."
    },
    {
      "position": 6,
      "text": "Transfer half of the sauce to an airtight container. Refrigerate or freeze for future use."
    },
    {
      "position": 7,
      "text": "Add beans to remaining sauce and gently stir to combine. Allow to sit at a simmer for 2-3 minutes."
    },
    {
      "position": 8,
      "text": "Serve drizzled with olive oil and balsamic vinegar and topped with freshly grated parmesan cheese and a sprinkle of chili flakes and chopped parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

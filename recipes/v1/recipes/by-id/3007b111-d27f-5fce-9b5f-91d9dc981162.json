  "schema_version": 1,
  "id": "3007b111-d27f-5fce-9b5f-91d9dc981162",
  "slug": "mediterranean-crispy-rice-chicken-bowl-recipe-8778475",
  "name": "Mediterranean Crispy Rice Chicken Bowl",
  "recipe_type": "main",
  "brief_description": "This Mediterranean crispy rice chicken bowl features Greek flavors from seasoned chicken, tomatoes, Kalamata olives, feta cheese, banana peppers, and cucumber. It's dressed with a red wine vinaigrette, then topped with crunchy rice, crisped in the oven.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet or line with parchment."
    },
    {
      "position": 2,
      "text": "Combine chicken, 1 tablespoon oil, 1 teaspoon Greek seasoning, paprika, garlic, and salt in a bowl. Stir until well coated; set aside."
    },
    {
      "position": 3,
      "text": "For dressing, whisk olive oil, red wine vinegar, pepper brine, honey, Dijon mustard, salt, and black pepper together in a small bowl until well combined; set aside."
    },
    {
      "position": 4,
      "text": "Combine cooked rice and soy sauce with remaining 3 tablespoons olive oil and 1 teaspoon Greek seasoning in a bowl. Spread rice onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake rice in the preheated oven until rice is crispy and lightly browned, about 40 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, heat a small amount of oil in a skillet over medium-high heat. Add chicken and cook, undisturbed, until chicken is browned on one side and releases easily from pan, 3 to 4 minutes. Continue to cook and stir until chicken is no longer pink at the center and browned on all sides, about 4 minutes more. Add water to the skillet and continue to stir until bottom of skillet is deglazed. Remove from heat."
    },
    {
      "position": 7,
      "text": "To serve, divide chicken, tomatoes, cucumber, red onion, banana peppers, parsley, and olives among 4 bowls. Top evenly with crispy rice and feta cheese and drizzle with dressing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "da747308-214a-5b2f-837e-7d40b1a74a03",
  "slug": "easy-broccoli-and-ham-quiche",
  "name": "Easy Broccoli and Ham Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This ham and broccoli quiche with Cheddar and onion features a milk and egg custard baked in a tender crust for a delicious meal any time of day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place broccoli into a glass bowl. Cover the bowl with plastic wrap. Cook in the microwave in 1-minute intervals until evenly heated through, about 5 minutes; drain and set aside."
    },
    {
      "position": 3,
      "text": "Melt butter in a large saucepan over medium heat. Saut\u00e9 onion and garlic in melted butter until onion is slightly translucent, about 5 minutes. Stir ham and broccoli into onion mixture, then transfer to pie crust."
    },
    {
      "position": 4,
      "text": "Beat together cheese, milk, eggs, and black pepper in a medium bowl; pour over ham mixture in crust. Sprinkle with paprika."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 30 to 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a5f9a3bf-26d4-5dae-ad4f-a3aa5db6752b",
  "slug": "nutty-strawberry-salad",
  "name": "Nutty Strawberry Salad",
  "recipe_type": "salad",
  "brief_description": "This nutty strawberry salad recipe features romaine lettuce, fresh strawberries, and toasted almonds, tossed in a tangy apple cider vinegar vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk vinegar, sugar, oil, paprika, and Worcestershire sauce together in a small bowl until well combined. Cover and refrigerate vinaigrette for at least 6 hours."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium skillet over medium heat. Add almonds; cook until toasted and golden brown. Cool."
    },
    {
      "position": 3,
      "text": "Toss romaine, strawberries, and toasted almonds together in a large bowl until well combined; toss with vinaigrette just before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

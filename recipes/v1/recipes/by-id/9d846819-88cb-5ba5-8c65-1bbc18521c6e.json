  "schema_version": 1,
  "id": "9d846819-88cb-5ba5-8c65-1bbc18521c6e",
  "slug": "chinese-cocktail-buns",
  "name": "Chinese Cocktail Buns",
  "recipe_type": "appetizer",
  "brief_description": "Chinese coconut-filled cocktail buns are a popular treat from the Chinese bakery. Make your own with this recipe for your next fancy Chinese meal.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Place milk and \u2153 cup sugar in a small saucepan; stir until sugar is dissolved. Add \u00bc cup butter; gently heat mixture until butter melts and mixture is warm but not hot \u2014 no more than 100 degrees F (40 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk 2 \u00bd cups flour and yeast together until well combined; stir in milk mixture. Beat 1 egg in a small bowl; stir into flour mixture until forms a sticky, wet dough. Turn dough out onto a well-floured surface; knead for about 10 minutes, gradually kneading in 1 cup more flour, or as needed, to make a smooth, elastic dough."
    },
    {
      "position": 3,
      "text": "Form dough into a round ball, place into an oiled bowl and turn to coat. Cover bowl with a cloth and let rise in a warm place until doubled in volume, about 1 hour."
    },
    {
      "position": 4,
      "text": "Beat \u00bd cup sugar and remaining \u00bc cup butter in a bowl until light and fluffy; stir in coconut, milk powder, and remaining \u00bd cup flour until smooth and combined. Set filling aside. Line baking sheets with parchment paper."
    },
    {
      "position": 5,
      "text": "Punch down dough on a floured surface; cut into 2 equal pieces. Cut each piece into 8 equal-sized pieces (16 pieces total). Form each piece into an oblong shape; flatten with a floured rolling pin. Spoon about 1 tablespoon filling in center of 1 flattened dough piece. Pull and pinch edges of dough together to enclose filling; place buns seam-side down onto a prepared baking sheet. Repeat with remaining filling and flattened dough pieces. Cover buns with a cloth; let rise in a warm place for 1 hour."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Beat remaining 1 egg in a bowl; brush on each bun for a glossy coating. Sprinkle each bun with sesame seeds."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden brown, 10 to 15 minutes. Cool before serving."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,

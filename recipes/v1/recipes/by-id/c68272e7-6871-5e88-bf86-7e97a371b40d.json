  "id": "c68272e7-6871-5e88-bf86-7e97a371b40d",
  "slug": "parkers-famous-margaritas",
  "name": "Parker's Famous Margaritas",
  "recipe_type": "drink",
  "brief_description": "This is the signature drink at my in-law's home. My father-in-law developed a taste for margaritas made from scratch during the summer they spent in Zihuatanejo during the 1960s. After decades of tinkering he has arrived at this foolproof recipe for the ultimate Mexican cocktail.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Measure the tequila, lime juice, sweetened lime juice and triple sec into a cocktail shaker and add a generous scoop of ice. Cover and shake until the shaker is frosty, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Rub a lime wedge around the rim of a margarita glass and dip in salt. Fill each glass with ice. Strain equal amounts of the cocktail into the glasses to serve. Garnish with a lime wedge."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

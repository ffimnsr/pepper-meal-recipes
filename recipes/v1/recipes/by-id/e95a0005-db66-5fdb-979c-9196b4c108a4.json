  "id": "e95a0005-db66-5fdb-979c-9196b4c108a4",
  "slug": "general-tao-chicken",
  "name": "General Tao Chicken",
  "recipe_type": "dessert",
  "brief_description": "This General Tao chicken features pan-fried chicken bites coated in a sweet, tangy sauce made with oyster sauce, green onion, soy sauce, and ketchup.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Coat chicken pieces with cornstarch in a bowl; set aside. Beat eggs, salt, and pepper in a mixing bowl until combined. Stir in flour and baking powder until no large lumps remain. Mix in chicken pieces until evenly coated."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large skillet or wok over high heat. Cook chicken in hot oil until golden brown and no longer pink on the inside, about 12 minutes. Set chicken aside; keep warm."
    },
    {
      "position": 4,
      "text": "Make sauce: Reduce heat to medium-high; add green onion, ginger, and sesame oil to the skillet. Cook and stir until onion is limp and ginger begins to brown, about 1 minute. Pour in water, sugar, and vinegar; bring to a boil"
    },
    {
      "position": 5,
      "text": "Dissolve cornstarch in soy sauce in a small bowl and stir into vinegar mixture along with oyster sauce and ketchup. Cook until sauce has thickened and is no longer cloudy. Stir in chicken; simmer until heated through."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

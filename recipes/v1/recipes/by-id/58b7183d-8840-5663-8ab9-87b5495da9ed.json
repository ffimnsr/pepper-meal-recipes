  "id": "58b7183d-8840-5663-8ab9-87b5495da9ed",
  "slug": "multigrain-pancakes",
  "name": "Multigrain Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These easy multigrain pancakes can be customized by adding chopped fruit, mashed banana, nuts, or chocolate chips to the batter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk both flours, oats, cornmeal, sweetener, baking powder, salt, baking soda, and cinnamon together in a medium bowl."
    },
    {
      "position": 2,
      "text": "Whisk egg whites, yogurt, milk, and water together in a separate bowl. Pour into the flour mixture and mix until just moistened."
    },
    {
      "position": 3,
      "text": "Spray a skillet with cooking spray and heat over medium heat. Working in batches if necessary, pour about 1/3 cup batter per pancake onto the skillet. Cook until bubbles begin to form in the center, 2 to 4 minutes. Flip and cook until golden brown on the other side, 1 to 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "c6129a97-bee9-5fda-83b6-49fa85b8fbd3",
  "slug": "perfect-porterhouse-steak",
  "name": "Perfect Porterhouse Steak",
  "recipe_type": "main",
  "brief_description": "Tenderize porterhouse steak and marinate it for 20 minutes, then pop it on the BBQ for a perfectly grilled cut of beef that's worthy of a special occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place steak onto a plate; coat with olive oil, rub with tenderizer, then gently rub with steak seasoning. Cover with plastic wrap and let stand for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat a grill for high heat. When hot, lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Cook steak on the preheated grill until hot, slightly pink in the center, and beginning to firm, 3 to 5 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

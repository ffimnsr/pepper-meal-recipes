  "id": "b930f6a1-7c16-54e5-8608-27a932335e52",
  "slug": "amazing-artichoke-and-spinach-dip",
  "name": "Amazing Artichoke and Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for spinach and artichoke dip uses four different types of cheese for a creamy dip sure to please all your guests.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the artichoke hearts, onion, salad dressing, mayonnaise, sour cream, Swiss cheese, mozzarella cheese, 1/2 cup Parmesan cheese, Romano cheese, garlic powder, salt, and pepper in a large mixing bowl; mix evenly. Gently fold the spinach into the mixture; spread into the bottom of an 8x8 casserole pan. Sprinkle 1/4 cup Parmesan cheese over the top. Cover with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven 15 minutes. Remove the aluminum foil and bake until top begins to brown, about 10 minutes more. Allow to cool 10 to 15 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

  "id": "e543c6cc-6562-538d-92f1-21543c8b0b7a",
  "slug": "easy-granola-bars",
  "name": "Easy Granola Bars",
  "recipe_type": "appetizer",
  "brief_description": "Fantastic bars that have a lot of flexibility. You can adapt the recipe to your liking. Great for hikes, long road trips and camping as they store well and keep fairly long - unless you eat them all! Use any combination of chocolate chips, dried fruit, coconut, pecans, almond slices, or any other tidbits you'd like in a granola bar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the oats, sweetened condensed milk, butter, coconut, almonds, chocolate chips and cranberries with your hands until well blended. Press flat into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake for 20 to 25 minutes in the preheated oven, depending on how crunchy you want them. Lightly browned just around the edges will give you moist, chewy bars. Let cool for 5 minutes, cut into squares then let cool completely before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

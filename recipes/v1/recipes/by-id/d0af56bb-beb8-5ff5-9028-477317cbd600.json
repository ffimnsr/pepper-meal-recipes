  "id": "d0af56bb-beb8-5ff5-9028-477317cbd600",
  "slug": "grandmas-farmhouse-turkey-brine",
  "name": "Grandma's Farmhouse Turkey Brine",
  "recipe_type": "drink",
  "brief_description": "Grandma's farmhouse turkey brine recipe is a must-do for the tastiest, juicy turkey. It uses vegetable stock, cranberry juice, and poultry seasoning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine salt, poultry seasoning, onion powder, and black pepper in a large stockpot; pour in vegetable stock, water, and cranberry juice and bring to a boil. Reduce heat to medium-low; simmer 20 minutes. Remove from heat; cool to room temperature."
    },
    {
      "position": 2,
      "text": "Submerge a turkey into cooled brine; refrigerate 12 to 16 hours. Drain turkey; pat dry before roasting according to your recipe's instructions."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

  "id": "5e8eb65f-eb9e-5bdc-a46a-bc051135cae1",
  "slug": "ash-e-jow-iranianpersian-barley-soup",
  "name": "Ash-e-jow (Iranian/Persian Barley Soup)",
  "recipe_type": "soup",
  "brief_description": "I've seen a lot of recipes for this soup; however, my mother-in-law adds tomato paste for a bit of a different flavour and she doesn't add any lentils or beans. It's thick, filling, and delicious, and you could make it vegetarian by using vegetable stock.",
  "cuisine": "Persian Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat chicken stock in a large saucepan to a gentle simmer."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large pot over medium heat. Add onion; saut\u00e9 until translucent. Add barley; stir 1 minute. Stir in hot stock, tomato paste, lime juice, turmeric, salt, and pepper; bring to a boil, then reduce heat to low, and simmer 1 hour."
    },
    {
      "position": 3,
      "text": "Stir in carrots; continue simmering until soup thickened and carrots and barley tender, about 30 minutes. If soup is too thick, add hot water, 1 tablespoon at a time."
    },
    {
      "position": 4,
      "text": "Slowly pour 1/2 cup hot soup into sour cream in a bowl, whisking constantly; gradually add to soup, whisking constantly. Stir in parsley. Serve with fresh lime wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

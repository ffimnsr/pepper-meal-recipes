  "id": "9347f353-c98b-5a6c-8e69-bb96630b9b1b",
  "slug": "sweet-potato-waffles",
  "name": "Sweet Potato Waffles",
  "recipe_type": "dessert",
  "brief_description": "These crispy sweet potato waffles made with mashed sweet potatoes, cinnamon, and brown sugar are a delicious fall twist on a classic breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pierce a sweet potato with a fork and place in a microwave-safe bowl; heat in microwave until tender, 5 to 10 minutes. Cool and measure out 3/4 cup sweet potato, reserving the rest for another use."
    },
    {
      "position": 2,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, cinnamon, and salt together in a large bowl."
    },
    {
      "position": 4,
      "text": "Mix sweet potato, eggs, melted butter, brown sugar, lime juice, vanilla extract, and grated lime zest together in a bowl. Pour sweet potato mixture into the flour mixture; stir until batter is smooth."
    },
    {
      "position": 5,
      "text": "Spoon batter into the waffle iron and cook according to manufacturer's instructions until golden brown, about 5 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

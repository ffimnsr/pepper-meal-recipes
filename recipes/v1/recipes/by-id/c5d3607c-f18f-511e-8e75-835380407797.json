  "schema_version": 1,
  "id": "c5d3607c-f18f-511e-8e75-835380407797",
  "slug": "pheasant-pot-pie",
  "name": "Pheasant Pot Pie",
  "recipe_type": "main",
  "brief_description": "Transform pheasant meat into a pheasant pot pie filled with vegetables in a creamy sauce for a warm and comforting meal in the winter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring broth to a boil in a pot; add pheasant, carrots, and celery and boil until pheasant is cooked through, about 15 minutes. Add peas to broth and boil for 1 minute. Drain and reserve broth from pot."
    },
    {
      "position": 3,
      "text": "Melt butter in a separate pot over medium heat; cook and stir onion until translucent, about 5 minutes. Gradually stir flour into butter until smooth. Pour reserved broth and milk into flour mixture, stirring constantly. Add salt, rosemary, pepper, sage, and celery seed to broth mixture and simmer over medium-low heat until sauce is thickened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Lower oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Press 1 pie crust into a pie plate and lightly brush with egg white."
    },
    {
      "position": 6,
      "text": "Bake crust in the oven until lightly browned, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Spoon about 1/4 of the pheasant-vegetable mixture into the baked pie crust. Mix remaining pheasant-vegetable mixture into the sauce; pour into baked pie crust. Place second crust on top of the filling, pinching the edges together to form a seal. Cut your initials into the top crust for ventilation."
    },
    {
      "position": 8,
      "text": "Bake in the oven until top is golden brown, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

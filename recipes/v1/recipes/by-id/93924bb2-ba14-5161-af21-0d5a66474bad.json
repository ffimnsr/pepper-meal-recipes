{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "93924bb2-ba14-5161-af21-0d5a66474bad",
  "slug": "sarahs-slow-cooker-corned-beef-and-cabbage",
  "name": "Sarah's Slow-Cooker Corned Beef and Cabbage",
  "recipe_type": "main",
  "brief_description": "Make your Saint Patrick's Day celebration complete with a full meal made in the slow cooker. It even has the beer already in it!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place the corned beef into the bottom of a large slow cooker."
    },
    {
      "position": 2,
      "text": "Scatter the pickling spice over the brisket."
    },
    {
      "position": 3,
      "text": "Layer the celery, carrots, potatoes, and onion atop the brisket, respectively."
    },
    {
      "position": 4,
      "text": "Pour the stout beer into the slow cooker. Add enough hot water to the slow cooker to cover the brisket by at least 1 inch."
    },
    {
      "position": 5,
      "text": "Cook on High until the brisket reaches the desired consistency, 7 to 8 hours."
    },
    {
      "position": 6,
      "text": "Remove the brisket and vegetables from the slow cooker to a large bowl; cover with aluminum foil to keep warm."
    },
    {
      "position": 7,
      "text": "Remove 1 cup of the liquid in the slow cooker; pour into a small pot over medium heat. Cook the liquid until the volume is reduced by about half, about 10 minutes. Transfer the reduced liquid to a small bowl; stir the horseradish and sour cream into the liquid to make a sauce."
    },
    {
      "position": 8,
      "text": "Submerge the cabbage wedges in the liquid remaining in the slow cooker; cook until the cabbage softens yet retains some crispiness, 20 to 30 minutes. Remove the cabbage to a platter. Ladle remaining liquid from the slow cooker into a bowl."
    },
    {
      "position": 9,
      "text": "Slice the brisket across the grain. Serve with the vegetable mixture, cabbage, horseradish sauce, and liquid from the slow cooker."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 450,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "expert",

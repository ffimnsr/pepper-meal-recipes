  "id": "32f89287-c44a-5d31-8f35-7b318be25508",
  "slug": "sweet-potato-pecan-pie",
  "name": "Sweet Potato Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pecan pie has a luscious filling made with sweet potatoes, eggs, spices, and cream, topped with a rich caramelized pecan topping.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Blend beaten eggs and sweet potatoes together in a large bowl; stir in sugar, salt, cinnamon, ginger, and cloves. Blend in cream. Pour into prepared pie shell."
    },
    {
      "position": 3,
      "text": "Bake pie in the preheated oven until knife inserted halfway between center and edge of pie comes out clean, about 45 to 55 minutes. Cool completely on a rack."
    },
    {
      "position": 4,
      "text": "To make the caramelized pecan topping: Combine butter, brown sugar, and pecans in a bowl. Gently drop by spoonfuls over cooled pie to cover the top. Broil 5 inches below heat until topping begins to bubble, about 3 minutes. Watch closely to prevent burning. Cool completely on a rack before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

  "id": "5bdf0847-a3c7-5786-a2ad-5c17bfb5db42",
  "slug": "ultimate-tomahawk-steak-recipe-7550363",
  "name": "Ultimate Tomahawk Steak",
  "recipe_type": "main",
  "brief_description": "This is the ultimate tomahawk steak recipe, destined to impress, whether you're sharing it with one hungry loved one or serving it up to your whole family. Be sure to call your butcher ahead of time to reserve a tomahawk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove steak from refrigerator and let stand at room temperature 30 minutes to an hour before cooking."
    },
    {
      "position": 2,
      "text": "Preheat the grill to medium-high, 400 to 450 degrees F (200 to 230 degrees C). Sprinkle steak evenly and liberally on all sides with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Lightly coat grill grates with oil or grilling spray. Place steak on hot grates, and grill, undisturbed, until it releases easily from the grates, about 4 minutes. Flip, and repeat on the other side. Continue grilling, turning occasionally, until a thermometer inserted into the thickest portion of steak registers 125 degrees F (52 degrees C), 30 to 40 minutes."
    },
    {
      "position": 4,
      "text": "Transfer steak to a cutting board; let rest 15 minutes. Run a knife along the inside edge of the bone to remove steak from the bone in 1 piece; slice against the grain to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 15,

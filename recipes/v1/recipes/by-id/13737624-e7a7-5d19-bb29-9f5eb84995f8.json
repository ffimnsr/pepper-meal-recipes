  "id": "13737624-e7a7-5d19-bb29-9f5eb84995f8",
  "slug": "panko-buffalo-chicken-tenders",
  "name": "Panko Buffalo Chicken Tenders",
  "recipe_type": "main",
  "brief_description": "Buffalo sauce-flavored chicken breast strips are coated in panko bread crumbs and baked until golden, delicious, and irresistible!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine panko bread crumbs, Italian-seasoned bread crumbs, garlic powder, salt, and pepper in a bowl. Pour Buffalo wing sauce into a separate bowl."
    },
    {
      "position": 3,
      "text": "Coat chicken breast pieces on both sides with Buffalo sauce then evenly coat with bread crumb mixture. Lay pieces flat on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, juices run clear, and chicken has reached desired crispiness, about 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

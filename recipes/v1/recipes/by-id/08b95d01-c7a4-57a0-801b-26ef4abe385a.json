  "id": "08b95d01-c7a4-57a0-801b-26ef4abe385a",
  "slug": "old-fashioned-lemon-pound-cake",
  "name": "Old-Fashioned Lemon Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "Old-fashioned lemon pound cake, just like grandma used to make, is quick and easy to bake and is perfect alongside a cup of coffee or tea.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Combine sugar, flour, eggs, shortening, whole milk, vanilla extract, lemon extract, and baking powder in a large bowl; pour into the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

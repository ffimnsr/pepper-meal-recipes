  "slug": "3-ingredient-peanut-butter-oatmeal-cookies-recipe-7971929",
  "name": "3-Ingredient Peanut Butter Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "These no-bake 3-ingredient peanut butter oatmeal cookies are quick and so easy to make. Store them in an airtight container in the refrigerator and they will stay fresh.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment. Place peanut butter and maple syrup in a microwave safe bowl. Microwave until peanut butter is melted, about 1 minute. Stir in oats."
    },
    {
      "position": 2,
      "text": "Using a medium-sized cookie scoop, drop dough onto prepared baking sheet. Using your fingers, gently pat down dough to form a round cookie."
    },
    {
      "position": 3,
      "text": "Refrigerate until firm, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 10,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e583acf1-2f26-52f7-bc0b-ae4e7e0d4b19",
  "slug": "nutella-swirl-cheesecake-bars-recipe-8779386",
  "name": "Nutella Swirl Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "These Nutella swirl cheesecake bars feature a rich, Nutella-swirled cheesecake filling atop an OREO and hazelnut-studded crust for a truly delectable dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a 9x9-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Combine OREO crumbs, chopped hazelnuts, brown sugar, and pinch of salt in a food processor; pulse until finely ground. Add in melted butter and pulse until mixture is evenly moistened. Pour mixture into the prepared pan and press firmly and evenly into the bottom of the pan."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven for 10 minutes. Remove from oven and allow crust to cool for 10 minutes. Keep the oven on."
    },
    {
      "position": 4,
      "text": "Beat cream cheese, white sugar, vanilla, 1/2 teaspoon salt, and nutmeg together in a large bowl with an electric mixer until completely smooth and combined. Add in heavy cream and lemon juice and beat until smooth and combined. Add in egg and mix until just incorporated. Pour batter over crust and spread into an even layer."
    },
    {
      "position": 5,
      "text": "Place Nutella in a small microwave-safe bowl and microwave until slightly warmed, about 30 seconds. Place dollops of warm Nutella randomly over cheesecake filling. Use a sharp knife to gently swirl the batters together, taking care not to go too deep and cut the crust. Tap the pan on the counter a few times to help the batter to settle again."
    },
    {
      "position": 6,
      "text": "Bake bars in the preheated oven until edges of bars begin to turn golden, and bars still have a slight jiggle in the center, 35 to 40 minutes. Allow bars to cool to room temperature; then refrigerate until fully chilled, at least 4 hours. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

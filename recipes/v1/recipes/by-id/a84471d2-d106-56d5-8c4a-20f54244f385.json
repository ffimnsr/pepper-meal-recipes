  "name": "Cabbage with Butter and Soy Sauce",
  "recipe_type": "side",
  "brief_description": "This cabbage with butter and soy sauce pairs well with Asian-inspired main dishes, or is a delicious side for oven-roasted or grilled pork chops. 3 ingredients is all you need for this simple side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium-high heat. Add cabbage. Cover and cook for 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir in soy sauce and cook 5 minutes more."
    }
  ],

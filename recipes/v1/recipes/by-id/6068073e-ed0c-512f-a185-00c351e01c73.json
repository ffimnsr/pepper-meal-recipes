  "id": "6068073e-ed0c-512f-a185-00c351e01c73",
  "slug": "chimichurri-potato-salad-recipe-11726820",
  "name": "Chimichurri Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John's chimichurri potato salad is full of herbs and flavors and in addition the best potluck or barbecue take-along salad: it complements anything from the grill, there are no perishable ingredients, and it's delicious warm or cold.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut potatoes in quarters lengthwise, and then slice across into 3/8 inch thick pieces."
    },
    {
      "position": 2,
      "text": "Place potatoes in a pot with 2 tablespoons kosher salt and enough cold water to cover; bring to a simmer over high heat. Reduce the heat to medium-low and simmer until just barely tender. Potatoes may cook in 10 minutes or less once water is simmering, so test early and often\u2014the tip of a knife should slide in easily."
    },
    {
      "position": 3,
      "text": "Drain potatoes thoroughly and let cool in the strainer until just warm, about 20 minutes; transfer into a bowl and set aside."
    },
    {
      "position": 4,
      "text": "Combine garlic, red pepper flakes, cumin, black pepper, dried oregano, olive oil, champagne vinegar, and salt in a blender or blender cup. Blend until smooth; add fresh oregano, cilantro, and parsley, and continue blending until a relatively smooth pur\u00e9e is formed."
    },
    {
      "position": 5,
      "text": "Pour over potatoes and mix thoroughly with a spatula. Cover and refrigerate for at least 1 hour and up to 12 hours."
    },
    {
      "position": 6,
      "text": "Remove from the refrigerator to sit at room temperature for 1 hour. Stir in chives, then taste and adjust seasoning. adding more salt if necessary. The texture of the salad can be adjusted with more oil and vinegar, or a spoon of mayonnaise for a creamier version."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

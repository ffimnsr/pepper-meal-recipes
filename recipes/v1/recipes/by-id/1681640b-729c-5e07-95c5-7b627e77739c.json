  "id": "1681640b-729c-5e07-95c5-7b627e77739c",
  "slug": "chinese-cabbage-salad",
  "name": "Asian Cabbage Salad",
  "recipe_type": "salad",
  "brief_description": "A wonderful Asian cabbage salad made with shredded cabbage and carrots tossed in a tangy rice vinegar and sesame dressing with crunchy ramen noodles.",
  "cuisine": "World Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Toast sesame seeds in a small skillet, shaking frequently, over medium heat until golden brown and fragrant. Transfer toasted seeds to a small plate and set aside."
    },
    {
      "position": 2,
      "text": "Toss together cabbage, carrots, and crushed ramen noodles in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk together olive oil, sugar, vinegar, sesame oil, salt, pepper, and ramen seasoning packet in a small bowl until combined."
    },
    {
      "position": 4,
      "text": "Pour over cabbage mixture; toss to coat. Top with sesame seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

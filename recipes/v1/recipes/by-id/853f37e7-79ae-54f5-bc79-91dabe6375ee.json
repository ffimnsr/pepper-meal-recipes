  "id": "853f37e7-79ae-54f5-bc79-91dabe6375ee",
  "slug": "basic-quiche-by-shelly",
  "name": "Basic Quiche by Shelly",
  "recipe_type": "breakfast",
  "brief_description": "Learn how long to bake quiche using this delicious foolproof recipe. Keep it simple or add chopped ham, sauteed leeks, or whatever you like!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk cream and eggs together in a large bowl. Season with white pepper, nutmeg, and salt. Place shredded Jarlsberg and mozzarella into the pie shell."
    },
    {
      "position": 3,
      "text": "Pour egg mixture over cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and bake until crust is golden and filling is set, 25 minutes. Allow quiche to set before serving, 5 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

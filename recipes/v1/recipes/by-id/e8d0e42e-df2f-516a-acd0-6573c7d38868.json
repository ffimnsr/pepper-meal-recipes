  "id": "e8d0e42e-df2f-516a-acd0-6573c7d38868",
  "slug": "mushroom-scallion-and-cheese-omelet",
  "name": "Mushroom, Scallion, and Cheese Omelet",
  "recipe_type": "breakfast",
  "brief_description": "For a protein-packed breakfast, make this quick and easy omelet that has mushrooms, green onions, and a generous helping of Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs together with milk, salt, and pepper in a bowl."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add mushrooms; cook and stir until softened, about 5 minutes. Mix in green onions; cook until slightly softened, about 1 minute. Pour in the beaten eggs. Cook and stir until the edges harden, 2 to 3 minutes. Flip and sprinkle Cheddar cheese on top. Cook until egg is set and cheese is melted, 1 to 2 minutes. Fold omelet in half; top with more Cheddar cheese."
    }
  ],
  "servings": 1,

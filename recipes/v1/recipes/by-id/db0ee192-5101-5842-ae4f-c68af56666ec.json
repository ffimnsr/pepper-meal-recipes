  "id": "db0ee192-5101-5842-ae4f-c68af56666ec",
  "slug": "bbq-chicken-pizza",
  "name": "BBQ Chicken Pizza",
  "recipe_type": "main",
  "brief_description": "This BBQ chicken pizza is loaded with diced chicken, spicy barbecue sauce, pepperoncini peppers, onion, and cilantro, topped with Colby-Jack cheese.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pizza crust on a baking sheet. Spread barbeque sauce on crust."
    },
    {
      "position": 3,
      "text": "Top with chicken, pepperoncini peppers, onion, and cilantro."
    },
    {
      "position": 4,
      "text": "Cover with Colby-Jack cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

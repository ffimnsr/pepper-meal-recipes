  "id": "d190861d-8efb-58b1-b416-d02615119a31",
  "slug": "dumplings",
  "name": "Homemade Dumplings",
  "recipe_type": "soup",
  "brief_description": "These homemade dumplings are light, fluffy, and tender. They're quick and easy to make and delicious in chicken soup and stews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Stir together flour, baking powder, sugar, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Cut in butter until mixture is crumbly. Stir in milk and mix until a batter forms that is thick enough to be scooped with a spoon. Allow batter to rest for 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Drop batter by spoonfuls into boiling stew or soup. Cover and simmer without lifting the lid for 15 minutes. Serve."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

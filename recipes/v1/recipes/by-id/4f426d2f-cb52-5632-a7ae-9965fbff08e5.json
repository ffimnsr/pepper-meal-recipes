  "id": "4f426d2f-cb52-5632-a7ae-9965fbff08e5",
  "slug": "buffalo-chicken-stuffed-shells",
  "name": "Buffalo Chicken Stuffed Shells",
  "recipe_type": "appetizer",
  "brief_description": "The football snack favorite flavor of Buffalo-style chicken doesn't have to come in the form of wings. Try this recipe with seasoned ground chicken stuffed into pasta shells.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground chicken in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 2,
      "text": "Melt butter in the skillet with the cooked chicken. Stir cayenne pepper sauce into the chicken mixture and remove from heat."
    },
    {
      "position": 3,
      "text": "Squeeze as much moisture from the ricotta cheese using a cheese cloth or paper towels; put drained cheese in a large bowl. Add chicken mixture to the cheese and stir. Refrigerate until completely chilled, 3 to 4 hours."
    },
    {
      "position": 4,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Prepare a 13x9-inch baking dish with cooking spray."
    },
    {
      "position": 5,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta shells in the boiling water until cooked through but firm to the bite, about 10 minutes; drain. Rinse with cold water until no longer hot; drain."
    },
    {
      "position": 6,
      "text": "Spoon chicken mixture into cooked pasta shells and arrange into the prepared baking dish. Sprinkle Cheddar-Monterey Jack cheese blend over the stuffed shells; season with salt and pepper."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until the cheese is slightly melted and the stuffing is hot in the middle, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

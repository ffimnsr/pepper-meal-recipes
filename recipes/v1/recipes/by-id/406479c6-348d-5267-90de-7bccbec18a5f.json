  "id": "406479c6-348d-5267-90de-7bccbec18a5f",
  "slug": "tinas-shortbread-chocolate-chip-cookies",
  "name": "Chocolate Chip Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These buttery chocolate chip shortbread cookies are rich, delicious, and irresistible! Make the dough ahead, freeze, and bake when ready.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar with an electric mixer in a medium bowl until fluffy, 2 to 3 minutes. Stir in flour mixture in two batches, then stir in chocolate chips and walnuts."
    },
    {
      "position": 4,
      "text": "Roll or scoop dough into walnut-sized balls and place 1 1/2 inches apart on ungreased cookie sheets. Press on each cookie slightly to flatten."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until light golden brown, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and transfer to wire racks to cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

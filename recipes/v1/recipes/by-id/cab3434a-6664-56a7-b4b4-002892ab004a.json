  "id": "cab3434a-6664-56a7-b4b4-002892ab004a",
  "slug": "flourless-crepe-tortillas",
  "name": "Flourless Crepe Tortillas",
  "recipe_type": "breakfast",
  "brief_description": "These quick and easy flourless tortillas, with tapioca, coconut flour, and eggs, are a great addition to a paleo or gluten-free lifestyle.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix water and ghee together in a bowl; beat in eggs until mixture is frothy. Add tapioca flour, coconut flour, and sea salt; whisk until batter is smooth."
    },
    {
      "position": 2,
      "text": "Heat an 8-inch nonstick skillet over medium-low heat. Spoon 2 tablespoons batter into the hot skillet, swirling the skillet to cover the bottom evenly. Cook for about 30 seconds; flip and cook other side for 30 seconds. Transfer to a plate and repeat with remaining batter."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 10,

  "id": "22ee9f80-37f2-5b53-8308-730c358f1e88",
  "slug": "hawaiian-iced-tea",
  "name": "Hawaiian Iced Tea",
  "recipe_type": "drink",
  "brief_description": "Iced black tea accented with pineapple juice shows off its Hawaiian roots and makes a refreshing party drink.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour the barely boiling hot water into a large pitcher, and add the tea bags. Steep the tea, 2 to 4 minutes. Remove the tea bags and pour in the ice water. Pour in the pineapple juice. Refrigerate until thoroughly chilled, about 1 1/2 hours."
    },
    {
      "position": 2,
      "text": "Pour the tea over ice, garnish with pineapple spears, and serve."
    }
  ],
  "servings": 8,

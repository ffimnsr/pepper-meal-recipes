  "id": "bd729c3e-5784-5aa2-8062-e8f2c1caad97",
  "slug": "italian-amaretto-margaritas",
  "name": "Italian Margarita",
  "recipe_type": "drink",
  "brief_description": "This Italian margarita cocktail is a tasty twist on the classic; it's easy to make with amaretto liqueur, tequila, orange juice, and lime blended with ice.",
  "cuisine": "Mexican Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Dip the rims of 4 margarita glasses in amaretto, then into sugar; set aside."
    },
    {
      "position": 3,
      "text": "Pour limeade, tequila, amaretto, orange juice, and ice into a blender; blend until smooth."
    },
    {
      "position": 4,
      "text": "Pour into prepared margarita glasses and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "slug": "homemade-best-o-pesto-ever",
  "name": "Homemade Best-O Pesto Ever",
  "recipe_type": "side",
  "brief_description": "Whip up a quick and easy batch of homemade pesto in no time with nuts, basil, and garlic for a show-stopping sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pulse pine nuts, almonds, and garlic in a food processor for about 20 seconds. Add basil, 1 cup olive oil, salt, and pepper. Blend for about 1 minute. Add additional olive oil until desired consistency is reached."
    }
  ],

  "id": "83443bef-63ea-553c-badc-5d144bf3276f",
  "slug": "mocha-cookie-bars",
  "name": "Mocha Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "Like a cross between a cookie and a brownie, these mocha cinnamon bars are reminiscent of Mexican hot chocolate.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Stir espresso powder and coffee together in a small bowl until espresso powder is completely dissolved."
    },
    {
      "position": 3,
      "text": "Whisk flour, cocoa, cream of tartar, baking soda, salt, and 1/4 teaspoon cinnamon together in a bowl; set aside."
    },
    {
      "position": 4,
      "text": "Beat butter, 1/2 cup white sugar, and brown sugar with an electric mixer together until light and fluffy in a bowl. Beat in espresso mixture, egg, and vanilla until well combined. Stir in flour mixture; mix until a dough just begins to form. Press dough firmly and evenly into the prepared pan using lightly floured hands."
    },
    {
      "position": 5,
      "text": "Whisk 1 tablespoon white sugar and remaining 1/2 teaspoon cinnamon together in a small bowl; sprinkle sugar mixture evenly over the dough."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven just until the dough in the center of the pan feels barely set, 20 to 23 minutes."
    },
    {
      "position": 7,
      "text": "Allow cookies to cool in the pan for 10 minutes. Use the overhanging parchment to lift cookies out to a wire rack; cool completely before cutting into bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

  "id": "ff2133de-b106-50f1-86dd-9877fdebf131",
  "slug": "simple-pasta-salad",
  "name": "Simple Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "An easy pasta salad with Italian dressing, fresh veggies, and a sprinkle of cheese. The perfect simple yet yummy dish to bring to a picnic or potluck.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Place pasta in the pot, cook for 8 to 12 minutes, until al dente, and drain."
    },
    {
      "position": 3,
      "text": "Toss cooked pasta with Italian dressing, cucumbers, tomatoes, and green onions in a large bowl."
    },
    {
      "position": 4,
      "text": "Mix Parmesan cheese and Italian seasoning in a small bowl, and gently mix into the salad."
    },
    {
      "position": 5,
      "text": "Refrigerate pasta salad until chilled for best results, at least 30 minutes before serving. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

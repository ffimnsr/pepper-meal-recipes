  "id": "c184903c-a38e-5c54-84be-f4e2632da9f5",
  "slug": "quick-and-easy-vegetable-soup",
  "name": "Quick and Easy Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "This hearty vegetable soup recipe features tender potatoes, green beans, carrots, and corn in a tomato broth for a quick and easy comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, chicken broth, tomato juice, carrots, celery, potato, green beans, corn, and water in a large stockpot. Season with salt, pepper, and Creole seasoning."
    },
    {
      "position": 3,
      "text": "Bring to a boil over medium heat and simmer until vegetables are tender, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,

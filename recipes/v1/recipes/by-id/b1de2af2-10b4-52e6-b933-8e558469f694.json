  "id": "b1de2af2-10b4-52e6-b933-8e558469f694",
  "slug": "homemade-valentines-chocolates",
  "name": "Homemade Valentine's Chocolates",
  "recipe_type": "dessert",
  "brief_description": "This Chef John recipe for the best Valentine's Day chocolates makes decadent truffles tossed in cocoa powder with a hint of spicy chipotle pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate into a bowl; add chipotle pepper and salt."
    },
    {
      "position": 2,
      "text": "Heat cream in a small saucepan over medium-low heat until it comes to a boil. Pour over chocolate and let stand for 3 minutes. Stir gently until chocolate mixture is completely smooth."
    },
    {
      "position": 3,
      "text": "Pour chocolate mixture out onto a sheet of plastic wrap on a work surface. Pick up one edge of the plastic and roll chocolate into a rough log shape. Continue to roll, wrapping chocolate in the plastic. Refrigerate until chilled and firm, 30 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Place cocoa powder in a small bowl."
    },
    {
      "position": 5,
      "text": "Unwrap chocolate and cut in half crosswise; cut each half into halves lengthwise. Rough-cut candy into 1/2-inch squares."
    },
    {
      "position": 6,
      "text": "Place chocolate squares into cocoa powder and toss gently to coat."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f100ca09-40d3-517b-9052-be93ebf32eb9",
  "slug": "cookies-and-cream-brownies-recipe-8647010",
  "name": "Cookies and Cream Brownies",
  "recipe_type": "dessert",
  "brief_description": "These cookies and cream brownies have a fudgy homemade brownie layer topped with Oreo cookies and a creamy topping for an indulgent chocolaty treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Mix sugar, flour, cocoa powder, salt, and baking powder together in a mixing bowl."
    },
    {
      "position": 3,
      "text": "Whisk butter, eggs, and vanilla together in a separate bowl. Add butter mixture to the flour mixture and mix until well combined."
    },
    {
      "position": 4,
      "text": "Pour 1/2 of the batter into the prepared baking pan and smooth out with a spatula. Add 16 Oreo cookies in an even layer (4 rows of 4 cookies), then spread the remaining 1/2 of the batter on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are brown and center is set, 30 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Remove pan from the oven and set on a wire rack. Let brownies cool completely, at least 30 minutes."
    },
    {
      "position": 7,
      "text": "Crush 12 of the remaining Oreo cookies. Place whipped topping in a bowl and fold in crushed cookies; spread mixture over the top of the brownies. Crush the remaining 4 cookies; sprinkle over the top of the whipped cream mixture."
    },
    {
      "position": 8,
      "text": "Keep refrigerated until you are ready to slice and serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

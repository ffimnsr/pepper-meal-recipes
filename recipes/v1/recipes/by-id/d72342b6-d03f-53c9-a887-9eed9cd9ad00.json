  "id": "d72342b6-d03f-53c9-a887-9eed9cd9ad00",
  "slug": "best-strawberry-lemonade-ever",
  "name": "Best Strawberry Lemonade Ever",
  "recipe_type": "dessert",
  "brief_description": "This simple strawberry lemonade recipe is sweetened with simple syrup and features fresh berries and lemon juice for the best pink summer drink ever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Toss strawberries with \u00bc cup sugar in a medium bowl until evenly coated; set aside until juices release from strawberries, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring 1 cup water to a boil in a small saucepan; add remaining \u00be cup sugar. Cook and stir until sugar is dissolved, about 5 minutes. Cool simple syrup to room temperature, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Combine remaining 6 cups water, ice, lemon juice, and simple syrup in a pitcher; stir in sweetened strawberries with juices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

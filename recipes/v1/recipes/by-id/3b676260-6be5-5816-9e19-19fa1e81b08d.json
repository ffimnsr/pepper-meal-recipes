  "id": "3b676260-6be5-5816-9e19-19fa1e81b08d",
  "slug": "eggplant-parmesan-for-the-slow-cooker",
  "name": "Slow Cooker Eggplant Parmesan",
  "recipe_type": "main",
  "brief_description": "Make a big batch of eggplant Parmesan in your slow cooker, and dinner will be waiting when you get home. No need to heat up your kitchen with a hot oven.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggplant slices in a large bowl in layers, sprinkling each layer with salt. Let stand for 30 minutes to drain. Rinse and dry on paper towels."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Whisk together eggs, water, and flour in a medium bowl until batter is smooth. Dip eggplant slices in batter and fry in hot oil until golden brown, working in batches of 2 to 3 slices at a time. Drain on a paper towel-lined plate."
    },
    {
      "position": 3,
      "text": "Mix together Parmesan cheese and seasoned bread crumbs in a small bowl until well combined. Place 1/4 of the eggplant slices into a slow cooker and top with 1/4 of the bread crumb mixture, 1/4 of the marinara sauce, and 1/4 of the mozzarella cheese. Repeat layers three more times."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until tender and flavors have blended, 4 to 5 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 260,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

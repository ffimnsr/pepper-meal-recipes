  "schema_version": 1,
  "id": "45ef41cd-2acc-536e-a7e5-fcd7a1a55748",
  "slug": "caramel-glazed-flan",
  "name": "Caramel-Glazed Flan",
  "recipe_type": "dessert",
  "brief_description": "More egg whites than yolks and low-fat sweetened condensed milk are the signature features of this altered flan.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a heavy skillet over medium-low heat, cook and stir sugar until melted and light brown. Carefully pour into a 9-inch round baking dish, tilting the dish to coat the bottom completely."
    },
    {
      "position": 3,
      "text": "In a medium bowl, beat egg yolks and egg whites. Stir in water, condensed milk, vanilla and salt until smooth. Pour into prepared dish. Line a roasting pan with a damp kitchen towel. Place baking dish on towel, inside roasting pan, and place roasting pan on oven rack. Fill roasting pan with boiling water to reach halfway up the sides of the baking dish."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven 1 hour, until center is just set (still a bit jiggly). Remove dish to a wire rack to cool for one hour. Then refrigerate several hours or overnight."
    },
    {
      "position": 5,
      "text": "To unmold, run a knife around the edge of the pan and invert onto a rimmed serving platter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

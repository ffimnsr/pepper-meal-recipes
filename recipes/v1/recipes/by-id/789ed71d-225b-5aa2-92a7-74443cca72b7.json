  "id": "789ed71d-225b-5aa2-92a7-74443cca72b7",
  "slug": "chocolate-chip-cookies-gluten-free",
  "name": "Gluten-Free Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These easy gluten-free chocolate chip cookies bake up golden and chewy for a delicious sweet treat with gooey chocolate chips in every bite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F ( 190 degrees C). Grease baking sheets."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a medium bowl until lighter in color. Gradually beat in egg substitute and vanilla. Sift gluten- free flour mix, baking soda, baking powder, and salt together; stir into butter mixture until blended. Finally, stir in the chocolate chips."
    },
    {
      "position": 3,
      "text": "Drop spoonfuls of cookie dough 2 inches apart on prepared baking sheets. Bake in preheated oven until edges are golden brown, about 6 to 8 minutes. Let cookies cool on baking sheet for a few minutes before removing to wire racks."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "eac49931-ff9f-5c48-a70c-4df225d2d30e",
  "slug": "slow-cooker-beef-stroganoff-ii",
  "name": "Slow Cooker Beef Stroganoff II",
  "recipe_type": "soup",
  "brief_description": "A delicious beef stroganoff recipe for the slow cooker. This one uses round steak and golden mushroom soup mixed with egg noodles and sour cream. Very simple to assemble and the slow cooker does the work for you.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium high heat. Roll the beef in flour and saute in the hot oil until well browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Transfer the meat to the slow cooker and top with the soup, water and bouillon."
    },
    {
      "position": 3,
      "text": "Cook on high setting for 8 hours. Stir in the sour cream during the last 30 minutes."
    },
    {
      "position": 4,
      "text": "Cook the egg noodles according to package directions. Serve the meat over the noodles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 520,
  "preparation_time_minutes": 10,

  "id": "132ff068-e530-57c0-9421-7ae812c8c9de",
  "slug": "grandmas-english-muffin-bread",
  "name": "Grandma's English Muffin Bread",
  "recipe_type": "breakfast",
  "brief_description": "With this grandma's recipe, dough for English muffins is made in a bread machine, baked in the oven, and finally sliced and toasted to taste just right.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place milk, water, flour, sugar, salt, baking powder, and yeast into a bread machine in the order listed, or follow the order recommended by the manufacturer if different. Run Dough cycle. Remove dough from the machine after the cycle is done, about 90 minutes."
    },
    {
      "position": 2,
      "text": "Shape 2/3 of the dough into a loaf; place into a 9x5-inch nonstick loaf pan. Shape remaining dough into a smaller loaf; place into a 7x3-inch nonstick loaf pan. Cover and let rise until doubled in volume, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake loaves in the preheated oven until golden brown on top, about 15 minutes. Carefully tip loaves out of the pans onto a work surface and gently tap bottoms. If they sound hollow, bread is done."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "7a516a5c-8c63-5c2e-8c2a-62b9d774b8b2",
  "slug": "rhubarb-crunch",
  "name": "Rhubarb Crunch",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb crunch has a tender and juicy layer of tart rhubarb with a sweet and buttery oat crumble on top that bakes up golden brown and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place rhubarb in a large mixing bowl. Add white sugar and 3 tablespoons flour; stir well to coat and spread evenly in the bottom of the prepared baking dish. Set aside."
    },
    {
      "position": 3,
      "text": "Combine 1 \u00bd cups flour, brown sugar, and oats in a separate mixing bowl; cut in butter until the mixture is crumbly. Sprinkle crumble mixture over rhubarb layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until rhubarb filling is bubbling and crumble on top is golden brown, about 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

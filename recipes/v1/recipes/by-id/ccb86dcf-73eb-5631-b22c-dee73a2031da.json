  "id": "ccb86dcf-73eb-5631-b22c-dee73a2031da",
  "slug": "pepperoni-stromboli",
  "name": "Pepperoni Stromboli",
  "recipe_type": "main",
  "brief_description": "Bread dough is stuffed pepperoni and mozzarella cheese, and topped with a decorative braid.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Punch dough down. On a lightly floured surface, roll each loaf into 20x8 inch rectangle. Place one rectangle on a greased baking sheet. Spread spaghetti sauce in an 18x4 inch strip down the center. Sprinkle with oregano, pepperoni and mozzarella cheese. Fold long sides of dough up toward filling; set aside. Cut the remaining rectangle into three strips. Loosely braid strips; pinch ends to seal. Place bread on top of the cheese; pinch braid to dough to seal. Sprinkle with Parmesan cheese."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 30 minutes, or until golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "a225e837-b898-508e-82f2-6e06e4f3a9a7",
  "slug": "chef-johns-salmon-loaf",
  "name": "Chef John's Salmon Loaf",
  "recipe_type": "snack",
  "brief_description": "Canned salmon is an inexpensive source of protein and omegas, so grab a can from your pantry to make Chef John's easy and tasty salmon loaf recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Generously butter a loaf pan."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in a skillet over medium heat until bubbling. Add onion; cook and stir for 1 minute. Turn off the heat; cool."
    },
    {
      "position": 3,
      "text": "Place salmon in a large bowl; mash with a fork. Add cracker crumbs, vinegar, salt, Worcestershire sauce, cayenne pepper, and onion mixture; mix and mash with a spatula or spoon until smooth."
    },
    {
      "position": 4,
      "text": "Separate eggs, adding yolks to salmon mixture and adding whites to a clean glass, metal, or ceramic bowl. Stir egg yolks into salmon mixture until well combined."
    },
    {
      "position": 5,
      "text": "Whisk egg whites to medium stiff peaks; gently fold into salmon mixture in 2 additions."
    },
    {
      "position": 6,
      "text": "Transfer salmon mixture into the prepared pan. Smooth top with a spatula to even out; shake and tap the pan to remove any air bubbles."
    },
    {
      "position": 7,
      "text": "Bake in the center of the preheated oven until a toothpick inserted into center comes out clean, about 45 minutes. Rest for 5 minutes, then carefully invert loaf onto a cutting board. Slice and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0307ae11-224d-5429-af8e-4de4bc7e4a4b",
  "slug": "fideo",
  "name": "Fideo",
  "recipe_type": "side",
  "brief_description": "Fideo is easy to make with toasted pasta simmered in tomato sauce seasoned with cumin, garlic, and chili powder for a comforting Mexican side dish.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over medium-high heat. Add fideo; cook and stir until golden brown and toasted."
    },
    {
      "position": 3,
      "text": "Add 1 cup water and 1/2 of the tomato sauce to fideo."
    },
    {
      "position": 4,
      "text": "Season with chili powder, cumin, and garlic salt; stir to blend."
    },
    {
      "position": 5,
      "text": "Bring to a boil and cook until liquid has almost evaporated."
    },
    {
      "position": 6,
      "text": "Stir in remaining 1/2 cup water and remaining tomato sauce. Cover and cook over medium heat until fideo is tender and sauce thickens, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

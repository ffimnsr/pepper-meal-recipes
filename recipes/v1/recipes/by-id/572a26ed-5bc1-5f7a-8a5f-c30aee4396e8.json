  "id": "572a26ed-5bc1-5f7a-8a5f-c30aee4396e8",
  "slug": "shrimp-and-crab-enchiladas",
  "name": "Shrimp and Crab Enchiladas",
  "recipe_type": "main",
  "brief_description": "Enchiladas made with shrimp, crab and Jack cheese. This is a great dish with a Southwestern flair.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Lay tortillas on a flat surface. In the middle of each tortilla place equal amounts of cheese, crab, and shrimp. Set aside some cheese to sprinkle on top of the tortillas. Roll the tortillas to form enchiladas. Arrange side by side in a 9x13 inch baking pan."
    },
    {
      "position": 3,
      "text": "Pour green enchilada sauce over all of the enchiladas; the green sauce should cover the enchiladas completely. Sprinkle the remaining cheese over the enchiladas."
    },
    {
      "position": 4,
      "text": "Cover, and bake for 30 minutes in the preheated oven. Remove cover, and continue baking 15 minutes. Top enchiladas with sour cream and green onions to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,

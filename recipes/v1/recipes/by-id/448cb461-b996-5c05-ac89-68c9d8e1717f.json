  "id": "448cb461-b996-5c05-ac89-68c9d8e1717f",
  "slug": "mississippi-chicken-salad-recipe-11976292",
  "name": "Mississippi Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Mississippi Chicken Salad takes a deli-style spin on the classic recipe, turning it into an easy lunch or light dinner served with greens and crusty bread. Rotisserie chicken, pepperoncini peppers, and bold seasonings come together in a creamy, tangy dish packed with flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together the mayonnaise, sour cream, pepperoncini brine, ranch dressing mix, and au jus seasoning mix in a large bowl."
    },
    {
      "position": 2,
      "text": "Add chicken, pepperoncini, and green onions; stir until evenly coated."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate at least 1 hour before serving. Serve with crackers or bread. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,

  "id": "f436c23a-e015-5ff0-8dd9-6a70a3b50008",
  "slug": "spicy-cheesy-refried-beans",
  "name": "Spicy Cheesy Refried Beans",
  "recipe_type": "side",
  "brief_description": "These refried beans with cheese are baked with cream cheese, Cheddar cheese, garlic, and onion to make a creamy and delicious side dish for tacos.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat; cook and stir onion and garlic until onion becomes translucent, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Cook and stir refried beans into onion mixture until heated through, 3 to 5 minutes. Remove from heat and stir cream cheese into bean mixture. Spread mixture into a pie plate; top with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

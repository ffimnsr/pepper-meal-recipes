  "id": "d54a91f2-5091-5ced-9d23-88555e55369e",
  "slug": "matcha-green-tea-chocolate-chip-cookies",
  "name": "Matcha Green Tea Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "White chocolate chip cookies get a fun green twist with the addition of matcha green tea powder to the mix.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease baking sheets or line with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift flour, matcha, baking soda, and salt together in a bowl. Beat brown sugar, butter, and white sugar together in a large bowl using an electric mixer until blended; beat in vanilla extract, egg, and egg yolk until light and creamy."
    },
    {
      "position": 3,
      "text": "Mix flour mixture into creamed butter mixture until dough is just blended; fold in chocolate chips using a wooden spoon. Drop cookie dough, 1 heaping tablespoon per cookie, onto the prepared baking sheet 2 to 3 inches apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are lightly browned, 8 to 10 minutes. Cool cookies on the baking sheet for 2 to 3 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

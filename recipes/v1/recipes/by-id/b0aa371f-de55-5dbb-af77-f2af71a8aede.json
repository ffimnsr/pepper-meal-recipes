  "id": "b0aa371f-de55-5dbb-af77-f2af71a8aede",
  "slug": "crab-stuffed-mushrooms",
  "name": "Crab-Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Crab-stuffed mushrooms are a favorite appetizer or party treat and super-easy to make. Use fresh, canned, or imitation crabmeat in this speedy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine crabmeat, green onions, thyme, oregano, savory, and pepper in a medium bowl. Mix in mayonnaise and 1/4 cup Parmesan until well combined. Refrigerate filling until ready to use."
    },
    {
      "position": 3,
      "text": "Wipe mushrooms clean with a damp towel. Remove stems. Spoon out the gills and the base of the stem, making deep cups. Discard gills and stems."
    },
    {
      "position": 4,
      "text": "Fill mushroom caps with rounded teaspoonfuls of filling and place them in an ungreased shallow baking dish. Sprinkle tops with Parmesan and paprika."
    },
    {
      "position": 5,
      "text": "Bake mushrooms in preheated oven until heated through, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

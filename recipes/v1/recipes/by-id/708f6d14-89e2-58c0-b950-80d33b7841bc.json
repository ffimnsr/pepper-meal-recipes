{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "708f6d14-89e2-58c0-b950-80d33b7841bc",
  "slug": "gluten-free-homemade-orecchiette-with-rice-semolina",
  "name": "Gluten-Free Homemade Orecchiette with Rice Semolina",
  "recipe_type": null,
  "brief_description": "This recipe uses rice semolina for a gluten-free version of orecchiette pasta that makes a perfect base for a variety of sauces and additions.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve salt in warm water in a bowl. Place semolina flour into a separate bowl and add salted water. Mix together until dough becomes a ball you can work with, adding more flour or warm water as needed; mixture should be slightly wet, barely sticking to your hands."
    },
    {
      "position": 2,
      "text": "Knead dough until slightly more stiff. Wrap in plastic wrap and refrigerate for 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove dough from the refrigerator and separate into 4 pieces. Use a small amount of semolina flour to dust your work table and work each piece of dough into a cylinder or snake shape. Dust your hands lightly with flour and pinch off a 1-inch piece of dough; make a dent using your thumb while rolling it away from you. Repeat with remaining dough."
    },
    {
      "position": 4,
      "text": "Let pasta sit for 7 to 8 minutes."
    },
    {
      "position": 5,
      "text": "Bring a pot of lightly salted water to a boil; place pasta into the boiling water and cook until pasta floats to the top, making sure not to stir, about 8 minutes. Scoop out cooked pasta using a slotted spoon from the water and transfer to a plate."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

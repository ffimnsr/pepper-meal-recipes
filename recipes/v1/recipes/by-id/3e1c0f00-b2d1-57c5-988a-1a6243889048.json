  "slug": "slow-cooker-london-broil",
  "name": "Slow Cooker London Broil",
  "recipe_type": "soup",
  "brief_description": "This crockpot London Broil is easy and tasty. The steak is flavored with condensed soup, with dry onion soup mix added on top \u2014 together in the slow cooker for a one-pot meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place meat in the bottom of the slow cooker; if necessary, slice meat to make it fit."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together mushroom and tomato soup. Pour mixture over beef. Sprinkle dry onion soup mix over top."
    },
    {
      "position": 3,
      "text": "Cover, and cook on Low for 8 to 10 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 480,

  "id": "8f89a9c1-5be0-5b39-a55e-1043149e66bc",
  "slug": "greek-pasta-salad-with-shrimp-tomatoes-zucchini-peppers-and-feta",
  "name": "Greek Pasta Salad with Shrimp, Tomatoes, Zucchini, Peppers, and Feta",
  "recipe_type": "salad",
  "brief_description": "This Greek pasta salad with shrimp, tomatoes, zucchini, peppers, and feta recipe grills the zucchini and peppers\u2014toss the salad right before serving.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk rice wine vinegar, Dijon mustard, garlic, pinch of salt, and black pepper together in a bowl; slowly whisk in 2/3 cup extra-virgin olive oil, whisking constantly. Transfer vinaigrette to a jar with a tight-fitting lid."
    },
    {
      "position": 2,
      "text": "Set an oven rack to highest position preheat the oven's broiler on high."
    },
    {
      "position": 3,
      "text": "Toss zucchini and bell pepper with 2 tablespoons olive oil; season with salt and black pepper. Arrange on a large baking sheet with sides"
    },
    {
      "position": 4,
      "text": "Broil in the preheated oven until spotty brown, 8 to 10 minutes, flipping zucchini slices and pepper halves once. Transfer to a large bowl to cool, then cut into bite-sized pieces."
    },
    {
      "position": 5,
      "text": "Fill a large pot with 1 gallon water and 2 tablespoons salt; bring to a boil. Add shells and cook, stirring occasionally, until tender yet firm to the bite, about 9 minutes. Drain thoroughly (do not rinse); transfer to the baking sheet. Set aside to cool."
    },
    {
      "position": 6,
      "text": "Transfer zucchini, bell pepper, pasta shells, shrimp, tomatoes, feta cheese, olives, onion, and oregano to a bowl or gallon-sized resealable plastic bag (it can be refrigerated for several hours). When ready to serve, add vinaigrette; toss to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "577b0866-31a6-54e5-bbcb-be008dca0158",
  "slug": "chicken-tender-parmesan-casserole-recipe-11947652",
  "name": "Chicken Tender Parmesan Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken tender Parmesan casserole is a one-dish version of a favorite, with frozen, breaded chicken tenders for simplicity. It's a hearty family dinner with minimal cleanup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch casserole dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "Place penne in the casserole dish. Pour 2 cups marinara sauce over the pasta. Add chicken bone broth and gently stir to combine."
    },
    {
      "position": 3,
      "text": "Sprinkle in half of the spinach (if using), Italian seasoning, salt, and pepper. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pasta is tender and most liquid is absorbed, 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Remove casserole from oven. Stir in remaining spinach until wilted. Arrange frozen chicken tenders evenly on top of the pasta. Spoon remaining sauce over chicken, just enough to cover lightly. Sprinkle mozzarella and Parmesan evenly over the top."
    },
    {
      "position": 6,
      "text": "Bake casserole until chicken tenders reach at least 165 degrees F (74 degrees C) and cheese is bubbly and golden, 15 to 20 minutes. Let the casserole sit 5 minutes before serving so it sets slightly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "20a4c5af-6429-56b7-8343-592ff6a2200e",
  "slug": "potato-soup-with-chorizo-recipe-8584977",
  "name": "Potato Soup with Chorizo",
  "recipe_type": "soup",
  "brief_description": "This delicious potato soup with chorizo is inspired by the popular Mexican breakfast of Papas con Chorizo (Potatoes with Chorizo). Serve it with chips on the side.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chorizo and onions in a soup pot over medium heat and cook until onions are soft and translucent and chorizo is fully cooked, 7 to 8 minutes. Add garlic and cook until garlic is fragrant, about 1 minute more."
    },
    {
      "position": 2,
      "text": "Add chicken broth, potatoes, chicken granules, cumin, and oregano. Bring to a boil and simmer until potatoes are fork tender, 6 to 10 minutes. Reduce heat and stir in heavy whipping cream. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

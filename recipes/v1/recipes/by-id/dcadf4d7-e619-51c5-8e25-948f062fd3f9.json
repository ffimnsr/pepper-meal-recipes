  "id": "dcadf4d7-e619-51c5-8e25-948f062fd3f9",
  "slug": "omelet-in-a-bag",
  "name": "Omelet in a Bag",
  "recipe_type": "breakfast",
  "brief_description": "An omelet in a bag makes it easy to make several different omelets at once with different additions. Eggs get cooked in resealable plastic bags.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Crack eggs into a large resealable freezer bag. Press out most of the air, and seal. Shake or squeeze to beat the eggs."
    },
    {
      "position": 3,
      "text": "Open the bag, and add ham, Cheddar, tomato, mushrooms, onion, bell pepper, and salsa. Squeeze out as much of the air as you can and seal the bag again."
    },
    {
      "position": 4,
      "text": "Bring a large pot of water to a boil. Place the bag (up to 8 bags at a time) into the boiling water. Cook for exactly 13 minutes."
    },
    {
      "position": 5,
      "text": "Open the bag, and let the omelet roll out onto a plate. The omelet should roll out easily."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

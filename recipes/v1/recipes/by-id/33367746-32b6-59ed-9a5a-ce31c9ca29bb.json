  "id": "33367746-32b6-59ed-9a5a-ce31c9ca29bb",
  "slug": "next-best-thing-to-robert-redford-pie",
  "name": "Next-Best-Thing-To-Robert-Redford Pie",
  "recipe_type": "dessert",
  "brief_description": "For this delectable pie, a scrumptious nut crust is baked and filled with a rich cream cheese layer, a chocolate pudding layer, a vanilla pudding layer, and, finally, a whipped topping along with grated chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine flour, butter, and chopped nuts."
    },
    {
      "position": 3,
      "text": "Press into the bottom of a 9 x 13 x 2 inch pan. Bake at 350 degrees F (175 degrees C) for 25 minutes, or until golden brown."
    },
    {
      "position": 4,
      "text": "Combine cream cheese, sugar, and 1 container of whipped topping until well mixed."
    },
    {
      "position": 5,
      "text": "Spread evenly over the cooled crust."
    },
    {
      "position": 6,
      "text": "Mix pudding mixes and milk well until thick. Spread evenly over the cream cheese filling."
    },
    {
      "position": 7,
      "text": "Spread remaining container of whipped topping over the pudding layer. Sprinkle grated chocolate over the top."
    },
    {
      "position": 8,
      "text": "Refrigerate for 6 to 8 hours before serving."
    }
  ],
  "servings": 8,

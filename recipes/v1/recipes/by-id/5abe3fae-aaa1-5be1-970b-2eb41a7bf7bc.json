  "schema_version": 1,
  "id": "5abe3fae-aaa1-5be1-970b-2eb41a7bf7bc",
  "slug": "flaming-greek-cheese-saganaki",
  "name": "Saganaki (Flaming Greek Cheese)",
  "recipe_type": "appetizer",
  "brief_description": "Saganaki is a Greek appetizer made with fried kasseri cheese. Chef John's recipe includes flamb\u00e9ing the cheese for a show-stopping presentation!",
  "cuisine": "Greek Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Brush each side of kasseri cheese with water; dredge both sides in flour, making sure the surface is completely covered."
    },
    {
      "position": 2,
      "text": "Preheat a well-seasoned cast iron skillet on medium-high heat until smoking; pour in olive oil. Carefully place floured cheese in hot oil and cook until cheese begins to ooze and a golden-brown crust forms, about 2 minutes. Quickly flip cheese over with a spatula. Fry until the bottom is golden brown, about 30 seconds more."
    },
    {
      "position": 3,
      "text": "Remove from the heat and place skillet onto a napkin-lined plate. Pour brandy into the skillet over the cheese. Light the brandy using a fireplace lighter. Squeeze some lemon juice on top to extinguish the last few flames and garnish with parsley."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "49a1e5de-05ad-563b-9720-9caf3e17fc2b",
  "slug": "lemon-fudge-with-sweetened-condensed-milk",
  "name": "Lemon Fudge with Sweetened Condensed Milk",
  "recipe_type": "dessert",
  "brief_description": "If you're craving something sweet, try this easy lemon fudge made with sweetened condensed milk.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a small rimmed baking sheet with parchment paper or greased aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine butter, condensed coconut milk, and lemon pudding mix in a heavy saucepan over medium heat. Cook, stirring continuously, until mixture has thickened, about 10 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Beat in sweetener and lemon extract. Pour mixture onto the lined baking sheet and spread it out to an 1/4-inch thickness."
    },
    {
      "position": 4,
      "text": "Refrigerate until fudge is set, about 1 hour. Lift fudge out of the baking sheet using the parchment paper and cut into 1-inch squares. Serve chilled."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "be23f994-52ce-5f24-b891-4302048a55cd",
  "slug": "beef-bean-and-beer-chili",
  "name": "Beef, Bean, and Beer Chili",
  "recipe_type": "soup",
  "brief_description": "Chef John uses beer in chili to add incredible flavor and depth to this hearty ground beef and pinto bean dish, perfect for a summer picnic or BBQ.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a large pot over high heat; drizzle in oil. Cook and stir ground beef, onion, and salt in hot oil until beef is crumbly and browned and any released liquid evaporates, about 4 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-high. Add chile powder, garlic, cumin, paprika, black pepper, and cinnamon. Cook and stir until mixture begins to darken, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Pour in beer. Add water, tomato pur\u00e9e, cocoa powder, oregano, and cayenne; stir well. Bring to a simmer; reduce heat to medium-low and cook for 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir in beans and poblano pepper. Simmer until peppers are tender and flavors have blended, about 30 minutes; add more water if chili becomes too thick."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "8064d656-3b56-5d18-905f-41acde078aa2",
  "slug": "african-peanut-soup",
  "name": "West African Peanut Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy African peanut soup is made with red bell peppers, tomatoes, chunky peanut butter, and brown rice for a surprisingly satisfying soup.",
  "cuisine": "West African African",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large stock pot over medium-high heat. Add onions and bell peppers; cook and stir until tender. Stir in garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in vegetable stock, tomatoes, pepper, and chili powder. Reduce heat to low and simmer, uncovered, for 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir in rice; cover and simmer until rice is tender, about 15 minutes. Stir in peanut butter until well blended; serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

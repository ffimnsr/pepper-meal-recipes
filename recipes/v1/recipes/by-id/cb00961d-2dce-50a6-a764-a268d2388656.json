  "schema_version": 1,
  "id": "cb00961d-2dce-50a6-a764-a268d2388656",
  "slug": "pineapple-baked-rice-main-course-for-chinese-new-year",
  "name": "Pineapple Baked Rice (Main Course for Chinese New Year)",
  "recipe_type": "main",
  "brief_description": "Baking fried rice in a pineapple 'bowl' fills your house with a delicious aroma and makes for an impressive main dish on Chinese New Year.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Rinse jasmine rice and place in a rice cooker with water. Cook rice according to manufacturer's instructions, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 3,
      "text": "Cut pineapple in half lengthwise. Cut out flesh, leaving a thin layer on the skin. Chop 1/2 cup of the flesh; place in a bowl. Reserve remaining flesh for another use. Place pineapple 'bowls' on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until fragrant, about 5 minutes. Remove from the oven."
    },
    {
      "position": 5,
      "text": "Increase oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Heat 2 tablespoons vegetable oil in a nonstick skillet over medium heat. Pour in beaten eggs; cook until set, about 5 minutes. Transfer to a plate and cut into small pieces. Use a paddle to fluff the cooked rice."
    },
    {
      "position": 7,
      "text": "Cook and stir Chinese sausage in a separate, dry skillet until fat renders, about 5 minutes. Transfer sausage to a bowl, reserving fat in the skillet."
    },
    {
      "position": 8,
      "text": "Stir remaining 2 tablespoons oil into the skillet used to cook the sausage. Heat it until you can feel the heat above the skillet. Stir in carrot for 1 minute. Add onion, peas, and corn; stir-fry until onion softens, 3 to 5 minutes. Add 1/2 of the rice; stir well to combine. Mix in remaining rice. Add egg pieces and sausage slices. Mix in pineapple cubes evenly."
    },
    {
      "position": 9,
      "text": "Transfer fried rice to the pineapple bowls. Cover with aluminum foil."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until heated through, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

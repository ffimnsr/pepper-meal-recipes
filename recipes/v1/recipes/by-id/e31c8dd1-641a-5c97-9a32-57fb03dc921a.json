  "id": "e31c8dd1-641a-5c97-9a32-57fb03dc921a",
  "slug": "french-toast-i",
  "name": "French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This simple French toast recipe turns thick-cut bread, eggs, milk, and a few spices into golden, fluffy slices in minutes for a breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk milk, eggs, vanilla, cinnamon, and salt together in a shallow bowl until combined and smooth."
    },
    {
      "position": 3,
      "text": "Lightly butter a griddle or skillet and heat over medium-high heat. Soak each slice of bread in egg mixture, about 5 to 10 seconds per side, allowing it to absorb the mixture without becoming soggy."
    },
    {
      "position": 4,
      "text": "Transfer to the hot skillet and cook until golden brown and slightly crisp, 3 to 4 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy with butter and syrup."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

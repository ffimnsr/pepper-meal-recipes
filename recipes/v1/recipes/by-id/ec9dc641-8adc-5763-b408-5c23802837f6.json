  "id": "ec9dc641-8adc-5763-b408-5c23802837f6",
  "slug": "easy-broccoli-frittata",
  "name": "Easy Broccoli Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This fluffy broccoli frittata is a family-friendly choice for brunch that is quick and easy to make with ingredients you likely have on hand.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add broccoli; cook in boiling water until tender, about 5 minutes. Drain and let cool, about 10 minutes. Transfer to an oven-proof pan with 2-inch sides."
    },
    {
      "position": 3,
      "text": "Whisk together eggs, milk, paprika, salt, and pepper in a large bowl until well combined. Pour over broccoli in the pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are golden and center is set, about 35 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

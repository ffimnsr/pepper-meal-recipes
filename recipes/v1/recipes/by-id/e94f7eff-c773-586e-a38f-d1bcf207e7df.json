  "id": "e94f7eff-c773-586e-a38f-d1bcf207e7df",
  "slug": "vegan-sweet-potato-chickpea-curry",
  "name": "Vegan Sweet Potato Chickpea Curry",
  "recipe_type": "dessert",
  "brief_description": "This chickpea curry recipe made with sweet potatoes, spinach, tomatoes, and coconut milk uses fragrant Indian spices to make a delicious vegan meal.",
  "cuisine": "Indian Inspired Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium heat. Cook onion, garlic, and ginger in hot oil until softened, about 5 minutes. Add chickpeas, tomatoes, coconut milk, and sweet potato. Bring to a boil, reduce heat to low, and simmer until tender, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Season with garam masala, cumin, turmeric, salt, and chile flakes. Add spinach right before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

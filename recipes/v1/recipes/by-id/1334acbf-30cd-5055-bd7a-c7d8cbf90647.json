  "schema_version": 1,
  "id": "1334acbf-30cd-5055-bd7a-c7d8cbf90647",
  "slug": "coconut-and-marzipan-macaroons",
  "name": "Coconut and Marzipan Macaroons",
  "recipe_type": "dessert",
  "brief_description": "These chocolate-dipped macaroons (L\u00fcbecker Kokosmakronen) originate from the German city of L\u00fcbeck, famous for its marzipan.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a baking sheet or line with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until foamy. Continue beating until stiff peaks form."
    },
    {
      "position": 3,
      "text": "Combine marzipan with 1/2 of the confectioners' sugar and rub with your fingers until mixture resembles bread crumbs. Add coconut, remaining confectioners' sugar, lemon zest, and rum. Mix well. Fold in stiff egg whites."
    },
    {
      "position": 4,
      "text": "Using 2 teaspoons, drop small dollops of mixture onto the prepared baking sheet. Sprinkle with sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the macaroons are golden but soft to the touch, about 20 minutes. Transfer to a cooling rack and cool completely, 30 minutes to 1 hour."
    },
    {
      "position": 6,
      "text": "Place 3/4 of the chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Remove from heat and stir in remaining chocolate until melted."
    },
    {
      "position": 7,
      "text": "Dip 1/3 of each cooled macaroon into the melted chocolate. Set macaroons on waxed paper until chocolate has set. Store the macaroons in an airtight container, with waxed paper between the layers."
    }
  ],
  "servings": 65,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "27f24c76-5f2d-579b-8c40-ac49e3698aef",
  "slug": "cabbage-and-noodles-with-ham",
  "name": "Cabbage and Noodles with Ham",
  "recipe_type": "main",
  "brief_description": "Ham, cabbage, and noodles are tossed with onions in this easy skillet meal. It's a great and delicious way to use the leftover ham in the fridge.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter in a large skillet over medium heat. Cook and stir onion and garlic in hot butter until onion has softened and turned translucent, about 5 minutes. Add cabbage; cook and stir until cabbage has softened, about 20 minutes."
    },
    {
      "position": 2,
      "text": "While cabbage is cooking, fill a large pot with lightly salted water and bring to a rolling boil over high heat. Cook gnocchi in boiling water until they float to the top, about 3 minutes; drain."
    },
    {
      "position": 3,
      "text": "Stir cooked gnocchi and ham into cabbage mixture and cook until heated through. Season with salt and black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "83972c2e-1a83-57a2-95be-89e23f8370b8",
  "slug": "raw-hummus",
  "name": "Raw Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This raw hummus is an organic treat from traditionally cooked hummus. When I serve this, I make a well in the middle and fill it with olive oil.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Soak beans for 24 hours. Drain, and let sit for 2 to 3 days until beans' sprouts are about 1/2-inch long. Rinse beans once or twice a day."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Remove from heat, and let stand for 1 minute. Place sprouted beans in hot water and let sit for 1 minute. Drain. If you do not do this step, hummus will be awful."
    },
    {
      "position": 3,
      "text": "Place sprouted beans into the container of a large food processor. Add tahini, sea salt, lemon juice, and garlic. Process until smooth, adding water if necessary. It will take 3 to 5 minutes to blend. Let sit in the food processor for 5 minutes to allow beans to absorb as much of water as possible. If too thick, add more water, and blend again. Taste and adjust seasonings if needed. Spoon into a serving dish and garnish with paprika."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

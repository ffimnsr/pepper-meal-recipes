  "id": "e973241d-412c-56c6-b2d9-1a8ef009c048",
  "slug": "peanut-butter-crispies-ii",
  "name": "Peanut Butter Rice Krispie Treats",
  "recipe_type": "dessert",
  "brief_description": "Peanut butter Rice Krispies treats without marshmallows combine everyone's favorite cereal snack with peanut butter for a perfect after school treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium sauce pan, mix together sugar, peanut butter, and corn syrup. Be careful not to let it burn, or it will ruin the recipe. Stir mixture until well melted. Remove pan from heat."
    },
    {
      "position": 2,
      "text": "Combine warm peanut butter mixture with crisp rice cereal."
    },
    {
      "position": 3,
      "text": "Grease well a 9x13 inch pan with butter or margarine. Spread mixture in pan. Allow to cool. When mixture is no longer sticky to the touch, cut into bars."
    }
  ],
  "servings": 12,

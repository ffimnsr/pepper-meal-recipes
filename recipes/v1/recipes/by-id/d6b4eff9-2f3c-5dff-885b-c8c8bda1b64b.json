  "id": "d6b4eff9-2f3c-5dff-885b-c8c8bda1b64b",
  "slug": "hawaiian-spareribs",
  "name": "Hawaiian Spareribs",
  "recipe_type": "main",
  "brief_description": "Baked pork ribs take a tasty, tropical turn with this Hawaiian-inspired recipe that features crushed pineapple in the sauce.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "In a saucepan over medium heat, stir together vinegar, ketchup, soy sauce, and pineapple. Stir in brown sugar, cornstarch, salt, and ginger. Cook, stirring constantly, until slightly thickened, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Arrange a layer of spareribs in a roasting pan. Pour 1/2 of the sauce over the top. Arrange another layer of spareribs, and top with remaining sauce. Cover pan tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tender, about 1 1/2 to 2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "fa068dd0-4cbd-5ca3-8da2-8c39af1fb8d1",
  "slug": "turkey-gravy-from-giblets",
  "name": "Turkey Gravy from Giblets",
  "recipe_type": "soup",
  "brief_description": "This simple but tasty turkey gravy recipe starts with simmering neck and giblets into the broth for super savory flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine broth, turkey neck, giblets, onion, celery, salt, and pepper in a large pot. Cover and simmer for 2 hours."
    },
    {
      "position": 2,
      "text": "Strain broth; you should have close to 4 cups."
    },
    {
      "position": 3,
      "text": "Heat a frying pan over medium heat. Add turkey drippings. Stir in flour until smooth. Add broth and giblets. Cook and stir until well blended and thickened, 15 to 20 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 135,

  "schema_version": 1,
  "id": "e80e38d9-a75d-5bdd-80a5-07420b93ccf6",
  "slug": "strawberry-pavlova",
  "name": "Strawberry Pavlova",
  "recipe_type": "dessert",
  "brief_description": "This strawberry pavlova is filled with whipped cream spiked with orange liqueur and topped with fresh strawberries for a gorgeous summer dessert.",
  "cuisine": "Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a baking sheet with parchment paper or aluminum foil."
    },
    {
      "position": 2,
      "text": "Beat egg whites, cream of tartar, and salt in a large bowl with an electric mixer until soft peaks form. Beat in sugar, 1 tablespoon at a time, until stiff, glossy peaks form. Mix in cornstarch, vinegar, and vanilla until blended."
    },
    {
      "position": 3,
      "text": "Spread egg white mixture on the prepared baking sheet into a 10-inch (25cm) circle with a raised edge and a slight indentation in the center."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until meringue is cream-colored and firm to the touch, about 1 hour 15 minutes. If meringue appears to be browning, reduce the oven temperature to 225 degrees F (105 degrees C). Remove meringue from the oven and let cool."
    },
    {
      "position": 5,
      "text": "When ready to serve, peel parchment paper off the bottom of meringue. Place meringue onto a serving plate."
    },
    {
      "position": 6,
      "text": "Whip cream in a medium bowl with an electric mixer until stiff peaks form. Gently stir in liqueur until incorporated. Spread whipped cream over meringue, leaving edge of meringue visible. Top with strawberries. Cut into wedges to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "hard",

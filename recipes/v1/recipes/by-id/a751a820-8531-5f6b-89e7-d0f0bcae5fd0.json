  "id": "a751a820-8531-5f6b-89e7-d0f0bcae5fd0",
  "slug": "soft-gingersnaps",
  "name": "Soft Gingersnaps",
  "recipe_type": "dessert",
  "brief_description": "This chewy, soft gingersnap cookie recipe is packed with old-fashioned flavors of molasses, brown sugar, ground ginger, ground cinnamon, and ground cloves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat 1 cup flour, brown sugar, shortening, molasses, egg, baking soda, ginger, cinnamon, and cloves in a large bowl until thoroughly combined; stir in remaining 1 \u00bc cups flour."
    },
    {
      "position": 3,
      "text": "Roll dough into 1-inch balls; roll in white sugar. Place 2 inches apart on ungreased baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until set and tops are crackled, 8 to 10 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

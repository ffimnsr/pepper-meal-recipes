  "id": "2940eda6-344c-5ec1-bd9d-45ca378cd599",
  "slug": "bluebarb-pie",
  "name": "Bluebarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This bluebarb pie recipe features fresh blueberries and rhubarb flavored with sugar, nutmeg, and lemon juice for a tempting pie perfect for summer parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil; place on lower oven rack."
    },
    {
      "position": 2,
      "text": "Place 1 pie crust in a 9-inch pie plate. Set aside."
    },
    {
      "position": 3,
      "text": "Combine rhubarb and blueberries in a large bowl; stir in 1 \u2153 cups sugar, flour, lemon juice, nutmeg, and salt until evenly combined. Pour into the prepared pie crust; dot with butter."
    },
    {
      "position": 4,
      "text": "Cover filling with remaining 1 pie crust; flute the edges. Cut a few decorative steam vents in top crust. Sprinkle with 1 tablespoon sugar; cover fluted edges with aluminum foil to prevent excessive browning. Place pie on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); bake 35 minutes more. Remove foil; continue baking until crust is golden and juice is bubbling through slits, about 15 minutes more. Cool completely before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

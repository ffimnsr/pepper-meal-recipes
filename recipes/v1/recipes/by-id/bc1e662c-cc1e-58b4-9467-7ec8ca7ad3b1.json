  "id": "bc1e662c-cc1e-58b4-9467-7ec8ca7ad3b1",
  "slug": "chicken-and-waffle-bites-recipe-11752992",
  "name": "3-Ingredient Chicken and Waffle Bites",
  "recipe_type": "dessert",
  "brief_description": "You only need 3 ingredients to get the full chicken and waffle experience with these shortcut chicken and waffle bites. Lightly breaded chicken tenders are dipped in pancake batter, and popped into a waffle iron until they are crisp and golden. Serve with syrup for dipping.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare chicken tenders according to package directions."
    },
    {
      "position": 2,
      "text": "Prepare pancake mix according to instructions. Pour mixture into a bowl."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat up a waffle iron. Spray waffle iron with nonstick spray. Take 1 to 4 chicken tenders at a time, depending on the size of your waffle iron, and dip tenders halfway into pancake batter; place onto the waffle iron. Cook until golden brown."
    },
    {
      "position": 4,
      "text": "Remove from the waffle iron to a plate; continue cooking remaining chicken."
    },
    {
      "position": 5,
      "text": "Serve immediately with syrup for dipping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

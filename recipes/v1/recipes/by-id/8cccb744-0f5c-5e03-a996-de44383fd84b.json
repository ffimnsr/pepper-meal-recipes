  "slug": "mexina-salsa-verde",
  "name": "Mexina Salsa Verde",
  "recipe_type": "appetizer",
  "brief_description": "This spicy green tomato salsa verde recipe with jalape\u00f1o peppers, lime juice, and cilantro is guaranteed to add a kick to your favorite dishes!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place tomatoes and jalape\u00f1os in a pot; cover with water. Bring to a boil; cook until tomatoes and jalape\u00f1os turn light green, about 15 minutes. Drain well."
    },
    {
      "position": 2,
      "text": "Transfer tomatoes and jalape\u00f1os to a blender; add onion, lime juice, salt, pepper, and cilantro. Puree to desired consistency and chill."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,

  "id": "2f488d65-9340-5d8e-b0be-faf873656924",
  "slug": "moms-smoked-salmon-fried-rice",
  "name": "Mom's Smoked Salmon Fried Rice",
  "recipe_type": "main",
  "brief_description": "Traditional fried rice gets a flavor twist thanks to smoked salmon in this quick and easy, main dish recipe. Use leftover rice if you have it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water into a saucepan; add rice and bring to a boil. Cover, reduce heat to low, and simmer until rice is tender and water is absorbed, about 20 minutes. Set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, place 2 tablespoons of cooking oil into a large skillet and heat over medium heat. Stir in eggs and cook until scrambled to desired consistency. Remove eggs from the pan; set aside."
    },
    {
      "position": 3,
      "text": "Using the same skillet, add remaining 1 tablespoon oil and heat over medium heat. Stir in onion and green onion; cook until onion is transparent, about 5 minutes. Stir in salmon, rice, peas, and scrambled eggs; toss until evenly blended. Cook and stir rice mixture until heated through. Season to taste with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

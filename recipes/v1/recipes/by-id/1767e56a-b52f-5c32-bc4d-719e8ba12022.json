  "id": "1767e56a-b52f-5c32-bc4d-719e8ba12022",
  "slug": "spam-risotto-recipe-11890135",
  "name": "Spam Risotto",
  "recipe_type": "side",
  "brief_description": "This SPAM risotto features tantalizing spears of pan-fried SPAM over a bowl of baked rice, seasoned with Parmesan, cilantro, and green onion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a plate with paper towels."
    },
    {
      "position": 2,
      "text": "Bring chicken stock to a simmer. Add rice to an ovenproof pot. Pour in 2 cups stock and stir. Cover the pot with a lid."
    },
    {
      "position": 3,
      "text": "Bake rice in the preheated oven for 35 minutes, Keep remaining stock warm."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a cast iron skillet over medium-low heat; add avocado oil. Add SPAM and cook on all sides until browned and heated through. Remove to the prepared plate; set aside to keep warm."
    },
    {
      "position": 5,
      "text": "Remove the pot from the oven; stir in Parmesan, butter, and remaining 1/2 cup warm stock. Spoon into shallow bowls and layer on several pieces of SPAM. Garnish with green onion and cilantro."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

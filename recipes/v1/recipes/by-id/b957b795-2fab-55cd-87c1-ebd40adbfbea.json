{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b957b795-2fab-55cd-87c1-ebd40adbfbea",
  "slug": "moms-pasta-al-forno",
  "name": "Mom's Pasta al Forno",
  "recipe_type": "main",
  "brief_description": "This pasta al forno recipe is a special treat--hearty layers of ziti, beef, cheese, and peas are baked in the oven until golden brown and bubbly.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Add onion; saute until translucent, about 5 minutes. Mix in tomato puree and water; cook for 10 minutes. Stir in sugar and basil. Reduce heat to low; simmer for 30 minutes, stirring occasionally."
    },
    {
      "position": 2,
      "text": "While the sauce is cooking, bring a very large pot of lightly salted water to a boil. Add ziti and cook, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and return to the pot."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Add ground beef to cooked pasta. Mix in enough tomato sauce to lightly coat the pasta."
    },
    {
      "position": 4,
      "text": "Mix ricotta cheese and water in a bowl until it reaches a spreadable consistency."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Spread a ladleful of sauce in the bottom of a 9x13-inch baking dish. Add 1/2 of the pasta, all of the ricotta cheese, peas, and 1/2 of the Parmesan cheese. Layer the sliced eggs on every section of the pasta; cover with 1/2 of the mozzarella cheese. Pour remaining pasta, Parmesan cheese, sauce, and mozzarella on top. Cover with aluminum foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown and bubbly, 40 to 50 minutes. Let stand for about 10 minutes before cutting, so slices don't fall apart."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 85,

  "id": "039f27ee-def3-5021-a6b7-7170d9033360",
  "slug": "best-refried-beans",
  "name": "Best Refried Beans",
  "recipe_type": "side",
  "brief_description": "Of all the refried bean recipes, this one may be the best! Pinto beans are simmered with many seasonings and fire-roasted tomatoes for unmatched flavor.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Put pinto beans into a bowl and cover with 2 inches of water. Soak for 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Drain beans. Transfer to a medium saucepan and cover with water by about 1 inch. Add onion, garlic, chili powder, cumin, celery seed, salt, and black pepper. Bring to a boil, then reduce the heat to low, cover, and cook for 1 1/2 hours."
    },
    {
      "position": 3,
      "text": "Use a colander to separate the liquid from the solids. Transfer the solids to a food processor. Add diced tomatoes, hot sauce, oregano, and cayenne; blend to desired consistency."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

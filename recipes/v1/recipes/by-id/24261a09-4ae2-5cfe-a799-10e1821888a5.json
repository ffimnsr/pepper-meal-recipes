  "id": "24261a09-4ae2-5cfe-a799-10e1821888a5",
  "slug": "vegan-split-pea-soup",
  "name": "Megan's Vegan Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This vegan, gluten-free split pea soup is a bowl of warmth and comfort filled with vegetables, such as sweet potatoes, and plenty of spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large pot over medium-high heat. Add onion, celery, carrots, green bell pepper, red bell pepper, and a splash of vegetable broth. Cook and stir until vegetables are softened, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir garlic, oregano, cayenne pepper, paprika, salt, and black pepper into the vegetable mixture. Saute until fragrant, about 5 minutes. Add the remaining broth, split peas, sweet potato, and bay leaf. Reduce heat to medium-low. Simmer, covered, until split peas begin to soften and pop, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Transfer 1/2 the soup into a blender; puree until smooth. Pour back into the pot and stir well. Pour soup into serving bowls and garnish with green onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

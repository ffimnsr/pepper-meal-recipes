  "id": "bb312d5e-3353-5ccf-a7c1-ece8222047e6",
  "slug": "chicken-nugget-parmesan-recipe-11880261",
  "name": "Chicken Nugget Parmesan",
  "recipe_type": "main",
  "brief_description": "Chicken Nugget Parmesan turns a freezer staple into a quick and easy dinner: crispy chicken nuggets are layered with marinara sauce, melted mozzarella, and Parmesan cheese. It\u2019s a fun, family-friendly twist on classic chicken Parmesan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a 13x18-inch rimmed baking sheet with foil. Coat foil with cooking spray."
    },
    {
      "position": 2,
      "text": "Arrange chicken nuggets in a single layer on the prepared baking sheet. Bake until heated through and crispy, 13 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Adjust oven rack to the top third of the oven. Preheat broiler."
    },
    {
      "position": 4,
      "text": "Group the baked chicken nuggets into servings of 5 nuggets each."
    },
    {
      "position": 5,
      "text": "Combine the mozzarella and Parmesan cheeses in a bowl. Spoon 3 tablespoons marinara sauce evenly over each portion. Sprinkle with Italian seasoning and crushed red pepper. Top each portion with 1/3 cup cheese mixture."
    },
    {
      "position": 6,
      "text": "Broil 4 to 5 inches from the heat until the cheese is melted and bubbly, 1 to 2 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with basil or parsley before serving, if desired."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

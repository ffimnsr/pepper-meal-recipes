  "id": "6379c1ca-f915-5ce1-9d33-9487e64f2d98",
  "slug": "no-mayonnaise-ranch-dressing",
  "name": "No-Mayonnaise Ranch Dressing",
  "recipe_type": "salad",
  "brief_description": "If you do not like mayonnaise, this recipe is for you! It's so creamy, you'll never be able to tell that it's reduced fat! Couldn't be easier!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sour cream and buttermilk into a mixing bowl. Season with parsley, chives, garlic powder, dill, onion powder, salt, and pepper. Whisk together until smooth. Cover and refrigerate at least 30 minutes before serving."
    }
  ],

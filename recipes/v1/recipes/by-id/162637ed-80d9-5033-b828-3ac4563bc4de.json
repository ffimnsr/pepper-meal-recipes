  "id": "162637ed-80d9-5033-b828-3ac4563bc4de",
  "slug": "apple-pie-baked-beans-recipe-11821475",
  "name": "Apple Pie Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "These apple pie baked beans are long-simmered sweet-spicy barbecued beans. Apple pie filling adds warm spices and a fruity note.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a Dutch oven over medium-high heat and add sausage. Cook, crumbling with a spoon until browned and fat has rendered out."
    },
    {
      "position": 2,
      "text": "Add onion, bell pepper, and salt to the sausage and cook, stirring frequently, until vegetables have softened."
    },
    {
      "position": 3,
      "text": "Add baked beans, apple pie filling, barbecue sauce, yellow mustard Worcestershire, hot sauce, and barbecue rub seasoning, and stir to combine. Use a spoon to break up the apple pieces a bit. Bring mixture to a simmer, reduce heat to medium-low, and cook 1 hour, stirring occasionally."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

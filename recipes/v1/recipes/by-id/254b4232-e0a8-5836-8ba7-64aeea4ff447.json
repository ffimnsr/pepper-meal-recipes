  "id": "254b4232-e0a8-5836-8ba7-64aeea4ff447",
  "slug": "moist-apple-crisp",
  "name": "Moist Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "In this moist apple crisp recipe, sliced apples, brown sugar, white sugar, oats, butter, cinnamon, and vanilla unite in this oat crumble layered crisp.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, oats, melted butter, and cinnamon in a bowl; stir until crumbly. Press \u00bd oat mixture into a 9x13-inch baking dish; cover with sliced apples."
    },
    {
      "position": 3,
      "text": "Combine white sugar, water, cornstarch, and vanilla extract in a medium saucepan over medium heat; cook and stir until thick and clear, about 10 minutes. Pour over sliced apples; top with remaining \u00bd oat mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and golden, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "7d90e85c-bc38-5f4f-b353-90ab3e41d913",
  "slug": "sweet-and-sour-meatballs-ii",
  "name": "Sweet and Sour Meatballs",
  "recipe_type": "dessert",
  "brief_description": "Sweet and sour meatballs made with ground beef are simmered in a deliciously thick sweet-sour sauce. Serve over rice for a quick and easy dinner!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the meatballs: Mix beef, bread crumbs, onion, egg, salt, and pepper together in a large bowl until well combined."
    },
    {
      "position": 2,
      "text": "Shape mixture into 1 \u00bd-inch diameter balls."
    },
    {
      "position": 3,
      "text": "Cook meatballs in a large nonstick skillet over medium heat until evenly browned and cooked through."
    },
    {
      "position": 4,
      "text": "To make the sauce: Mix brown sugar, water, ketchup, vinegar, soy sauce, and cornstarch together in a medium bowl until smooth."
    },
    {
      "position": 5,
      "text": "Pour sauce over meatballs. Reduce heat to low and simmer until sauce is thick, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

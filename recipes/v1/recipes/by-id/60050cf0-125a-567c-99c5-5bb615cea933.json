  "id": "60050cf0-125a-567c-99c5-5bb615cea933",
  "slug": "oatmeal-coffee-cake-with-pecan-streusel",
  "name": "Oatmeal Coffee Cake with Pecan Streusel",
  "recipe_type": "dessert",
  "brief_description": "Perfect for brunch, a snack, or with a hot cup of coffee, this oat-filled coffee cake has a sweet pecan streusel topping that's hard to resist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 9x12-inch baking dish."
    },
    {
      "position": 2,
      "text": "To make the streusel: Mix together brown sugar, pecans, butter, and flour in a small bowl until well combined. Set aside."
    },
    {
      "position": 3,
      "text": "To make the cake: Pour boiling water over oats in a medium bowl. Combine flour, baking powder, baking soda, and salt in a separate bowl."
    },
    {
      "position": 4,
      "text": "Beat brown sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating briefly after each addition. Scrape down the bowl and continue beating until mixture is smooth. Mix in soaked oats, vanilla, and cinnamon. Stir in flour mixture with a rubber scraper or wooden spoon. Pour batter into the prepared baking dish and cover with streusel."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

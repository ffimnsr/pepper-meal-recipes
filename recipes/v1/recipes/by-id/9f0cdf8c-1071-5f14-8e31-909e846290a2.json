  "id": "9f0cdf8c-1071-5f14-8e31-909e846290a2",
  "slug": "hot-cocoa-fudge-recipe-11871132",
  "name": "Hot Cocoa Fudge",
  "recipe_type": "dessert",
  "brief_description": "This hot cocoa fudge is so rich, delicious, and creamy; the marshmallow bits will make you think of a cup of cocoa. With only 6 ingredients, you'll impress with very little effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8x8-inch baking dish with parchment paper; spray paper with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir hot chocolate packets and butter together in a saucepan over low heat. Add sweetened condensed milk, whisk until smooth."
    },
    {
      "position": 3,
      "text": "Stir in milk chocolate chips and semisweet chocolate chips; heat gently and stir just until melted and smooth. Remove from heat; stir in vanilla."
    },
    {
      "position": 4,
      "text": "Pour fudge into prepared baking dish and smooth the top. Sprinkle marshmallows over fudge and gently press in. Refrigerate for 4 hours or overnight."
    },
    {
      "position": 5,
      "text": "Remove fudge from pan; cut into squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

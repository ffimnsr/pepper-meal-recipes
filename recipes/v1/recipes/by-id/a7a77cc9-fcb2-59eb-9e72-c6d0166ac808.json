  "id": "a7a77cc9-fcb2-59eb-9e72-c6d0166ac808",
  "slug": "creamy-butternut-squash-soup-with-fresh-ginger-and-quinoa",
  "name": "Creamy Butternut Squash Soup with Fresh Ginger and Quinoa",
  "recipe_type": "soup",
  "brief_description": "Creamy butternut squash soup with fresh ginger and quinoa is a hearty, gluten-free meal for cold winter evenings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon butter and olive oil together in a skillet over medium heat; cook and stir onion until softened, 5 to 10 minutes. Add chicken broth, butternut squash, ginger, and cumin to onion and simmer over medium heat until squash is very soft, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Pour squash mixture into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until smooth. Season soup with salt and pepper."
    },
    {
      "position": 3,
      "text": "Bring salted water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes. Stir 1 tablespoon butter into cooked quinoa and season with salt. Spoon quinoa into soup."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

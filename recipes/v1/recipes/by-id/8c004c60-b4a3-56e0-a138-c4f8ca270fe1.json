  "id": "8c004c60-b4a3-56e0-a138-c4f8ca270fe1",
  "slug": "orange-cranberry-ricotta-cookies-recipe-11844096",
  "name": "Orange Cranberry Ricotta Cookies",
  "recipe_type": "dessert",
  "brief_description": "These orange cranberry ricotta cookies puff up during baking like little cakes. Light and tasty, they are glazed and topped with chopped cranberries\u2013perfect for Christmas or on a holiday cookie plate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line 3 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking soda, and salt in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat together butter and sugar in a large bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 4,
      "text": "Add ricotta cheese and cream cheese; beat well. Add egg, milk, orange zest, and vanilla extract; beat until just combined."
    },
    {
      "position": 5,
      "text": "Beat in flour mixture until just combined. Fold in dried cranberries."
    },
    {
      "position": 6,
      "text": "Scoop dough into 20 portions using a 3-tablespoon (#20) scoop. Arrange dough portions 2 inches apart on the prepared baking sheets. Flatten cookies slightly with the bottom of a glass dipped in sugar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until bottoms are lightly golden brown, 10 to 12 minutes. Transfer cookies to a wire rack and allow to cool."
    },
    {
      "position": 8,
      "text": "For the glaze, whisk together powdered sugar, orange zest, orange juice, and whipping cream in a small bowl."
    },
    {
      "position": 9,
      "text": "Dip tops of cooled cookies into the glaze. Sprinkle with chopped dried cranberries, if desired."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

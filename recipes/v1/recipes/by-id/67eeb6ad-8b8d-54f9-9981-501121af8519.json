  "id": "67eeb6ad-8b8d-54f9-9981-501121af8519",
  "slug": "amazing-pineapple-cranberry-sauce",
  "name": "Amazing Pineapple Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "This amazing cranberry sauce recipe contains a secret ingredient that makes this classic cranberry sauce sing: canned pineapple chunks with juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain juice from pineapple into a measuring cup. Fill the measuring cup with enough water to equal 1 cup liquid total."
    },
    {
      "position": 2,
      "text": "Stir pineapple juice mixture and sugar together in a saucepan; bring to a boil, stirring constantly. Add cranberries and return to a boil. Reduce heat to low and simmer until cranberries burst, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix pineapple chunks into cranberry mixture. Cool to room temperature before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "705858f0-b536-56a6-9c82-8a3b27a1940e",
  "slug": "individual-no-bake-key-lime-pies",
  "name": "Individual No-Bake Key Lime Pies",
  "recipe_type": "dessert",
  "brief_description": "Tart, creamy, light, and sweet, these individual no-bake key lime pies are the perfect dessert after a heavy meal or barbecue.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 12-cup muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Combine 1 cup plus 2 tablespoons graham cracker crumbs, melted butter, and sugar in a medium bowl. Stir well until consistency is like slightly wet sand. Press mixture into the prepared muffin cups and refrigerate for 15 minutes."
    },
    {
      "position": 3,
      "text": "Whisk condensed milk, whipped topping, limeade concentrate, and lime zest in a medium bowl until smooth, thick, and creamy. Fill each muffin cup to the top with lime mixture, reserving any extra for another use. Freeze at least 2 hours or until ready to serve."
    },
    {
      "position": 4,
      "text": "Garnish with lime slices."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

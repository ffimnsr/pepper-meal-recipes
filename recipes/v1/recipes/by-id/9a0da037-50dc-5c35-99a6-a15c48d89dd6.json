  "id": "9a0da037-50dc-5c35-99a6-a15c48d89dd6",
  "slug": "best-ever-rugelach",
  "name": "Best Ever Rugelach",
  "recipe_type": "dessert",
  "brief_description": "This rugelach cookies recipe is the best ever and substitutes cottage cheese for cream cheese creating a light, tangy flavor, and flaky texture.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Beat 1 cup butter and cottage cheese together in a bowl; gradually stir in flour. Dough will be sticky. Divide dough into thirds, roll into balls, wrap, and refrigerate, at least 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, pecans, raisins, remaining \u00bc cup butter, and cinnamon in a bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Roll one dough ball into a 9-inch circle on a floured surface. Keep remaining dough refrigerated."
    },
    {
      "position": 5,
      "text": "Spread 1 tablespoon orange marmalade on dough circle; gently press \u2153 brown sugar mixture into dough. Cut circle into 16 wedges; roll each wedge tightly, starting with wide end. Place cookies, point-sides down, on the prepared baking sheet. Repeat with remaining dough, marmalade, and brown sugar mixture. Beat egg white with water in a small bowl; brush onto each cookie."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 18 to 20 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 50,
  "rest_time_minutes": null,

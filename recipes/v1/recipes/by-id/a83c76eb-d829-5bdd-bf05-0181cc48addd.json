  "id": "a83c76eb-d829-5bdd-bf05-0181cc48addd",
  "slug": "creamy-cajun-sausage-spaghetti-recipe-11892234",
  "name": "Creamy Cajun Sausage Spaghetti",
  "recipe_type": "main",
  "brief_description": "This creamy Cajun sausage spaghetti makes 2 generous servings of cheesy, creamy, Cajun-spiced pasta. The sausage brings so much flavor, and it's quite simple to make.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in medium sized skillet to medium heat. Slice sausage coins in half, then add to the pan. Cook sausage, turning occasionally, until brown on all sides and fully cooked. Remove to a bowl lined with paper towels. Set aside."
    },
    {
      "position": 2,
      "text": "Bring a pot of salted water to a boil. Add pasta and cook until tender with a bite, about 9 minutes. Drain and hold in the strainer."
    },
    {
      "position": 3,
      "text": "Bring a heavy-bottomed sauce pan to medium-low heat and add butter. Once melted, add shallots, garlic and Cajun seasoning. Stir to combine. Stir in lemon juice. Slowly add cream, stirring continually. Reduce heat; let the sauce simmer to thicken for about 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat and stir in Parmesan. Add sausage to the sauce, then stir in noodles. Serve in shallow bowls with green onion or parsley garnish."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

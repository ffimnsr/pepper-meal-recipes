  "id": "495b4a2b-fe7c-59c3-aec1-96259dc6f563",
  "slug": "cowboy-butter-steak-toast-recipe-11810923",
  "name": "Cowboy Butter Steak Toast",
  "recipe_type": "side",
  "brief_description": "This cowboy butter steak toast features a compound butter that pairs perfectly with steak, and is used to butter and toast thick French bread slices, topped with a quick pan-seared steak.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with a silicone liner or parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butter, garlic, lemon zest, Dijon mustard, salt, red pepper flakes, smoked paprika, black pepper, cayenne pepper, thyme, chives, and parsley in a bowl; mash and mix until evenly combined. Add lemon juice and mix until thoroughly incorporated."
    },
    {
      "position": 3,
      "text": "Generously apply the butter to both sides of bread slices and place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes, then turn the bread over, and bake until toast is as browned and crisp around the edge as you like, 7 to 10 minutes. Set aside until needed."
    },
    {
      "position": 5,
      "text": "Transfer remaining butter onto a piece of plastic wrap, and shape into a 2-inch diameter cylinder. Refrigerated until needed, then slice into medallions for serving."
    },
    {
      "position": 6,
      "text": "Turn the steak on its side, and slice down the middle, cutting the filet into 2 equal sized 4-ounce portions. Season both sides with salt."
    },
    {
      "position": 7,
      "text": "Place a skillet over high heat, and add avocado oil. Once the oil is shimmering, sear steaks for about 2 minutes on each side, or until they are cooked to your desired doneness. Turn off the heat, and transfer the steaks on your plate to rest for 3 to 4 minutes, while you deglaze the pan."
    },
    {
      "position": 8,
      "text": "To deglaze pan, add beef broth into the still-hot pan, and scrape the bottom with a spoon or spatula to release any caramelized bits. There should be enough heat in the pan to reduce the liquid down to about 2 tablespoons, but if not, turn the heat to medium-high until reduced."
    },
    {
      "position": 9,
      "text": "Place steak on toast, and drizzle over the pan drippings. Top with a slice of cowboy butter, and enjoy."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 5,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "c408dafe-ab29-5267-a67b-5cb49c6e123f",
  "slug": "lemon-tiramisu-recipe-8416444",
  "name": "Lemon Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This lemon tiramisu recipe is made with lemon curd, limoncello lemon syrup, and mascarpone cheese. It tastes light and wonderfully citrusy.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Combine 2 cups white sugar, 1 \u00bd cups lemon juice, eggs, egg yolks, and salt in a large non-reactive saucepan."
    },
    {
      "position": 3,
      "text": "Cook, stirring constantly, over medium heat until mixture thickens and starts to bubble; reduce heat to medium-low and continue cooking for 2 minutes more. Remove from heat."
    },
    {
      "position": 4,
      "text": "Strain lemon curd through a fine-mesh sieve into a medium bowl."
    },
    {
      "position": 5,
      "text": "Stir in butter and vanilla. Cover curd's surface with plastic wrap. Refrigerate until chilled, 1 to 2 hours. Reserve \u00bc cup lemon curd to spread over final layer when assembling tiramisu."
    },
    {
      "position": 6,
      "text": "Combine 1 \u00bd cups white sugar, limoncello, 3 strips lemon peel, and \u00bd cup lemon juice in a small non-reactive saucepan; bring to a boil over medium-high heat, stirring occasionally, and cook until sugar has completely dissolved."
    },
    {
      "position": 7,
      "text": "Discard lemon peel. Transfer syrup to a glass bowl or 4-cup glass measuring cup. Set syrup aside to cool."
    },
    {
      "position": 8,
      "text": "Beat cream and confectioners' sugar in a large bowl with an electric mixer until stiff peaks form. Set aside."
    },
    {
      "position": 9,
      "text": "Beat mascarpone and minced lemon zest in an extra-large bowl until combined and creamy; fold in \u00be cup lemon curd."
    },
    {
      "position": 10,
      "text": "Fold whipped cream into mascarpone mixture in 3 batches, folding gently until everything is combined."
    },
    {
      "position": 11,
      "text": "Arrange \u00bd ladyfingers in a single layer in bottom of a 9x13-inch baking dish, trimming ladyfingers as needed. Generously brush or drizzle \u00bd syrup over ladyfingers."
    },
    {
      "position": 12,
      "text": "Top ladyfingers with \u00bd remaining lemon curd."
    },
    {
      "position": 13,
      "text": "Layer \u00bd mascarpone filling over lemon curd."
    },
    {
      "position": 14,
      "text": "Repeat layering remaining lady fingers in a single layer, brush with remaining lemon syrup (reserve any excess syrup and/or ladyfingers for another use). Top with remaining each lemon curd and mascarpone filling."
    },
    {
      "position": 15,
      "text": "Drizzle or spread the reserved \u00bc cup lemon curd over tiramisu."
    },
    {
      "position": 16,
      "text": "Cover with plastic wrap and chill in the refrigerator 6 to 8 hours or overnight before serving. Slice and enjoy!"
    }
  ],
  "servings": 14,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,

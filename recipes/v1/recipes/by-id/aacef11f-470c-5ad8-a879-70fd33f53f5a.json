  "id": "aacef11f-470c-5ad8-a879-70fd33f53f5a",
  "slug": "three-packet-slow-cooker-roast",
  "name": "Three Packet Slow Cooker Roast",
  "recipe_type": "main",
  "brief_description": "This 3-packet roast couldn't be easier to prep! Ranch and Italian dressing are combined with gravy mix to create a savory sauce for slow cooker beef.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk water, ranch dressing mix, Italian dressing mix, and brown gravy mix together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Place the beef roast into a slow cooker; pour the dressing mix on top."
    },
    {
      "position": 4,
      "text": "Cook on Low until the roast is easily pierced by a fork, 6 to 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,

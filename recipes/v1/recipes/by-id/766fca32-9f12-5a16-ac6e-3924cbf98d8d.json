  "id": "766fca32-9f12-5a16-ac6e-3924cbf98d8d",
  "slug": "pop-mix",
  "name": "Pop Mix",
  "recipe_type": "appetizer",
  "brief_description": "Toss this buttery cheese popcorn mix together with toasted cereal snack mix and a sprinkle of Parmesan for a salty movie night delight!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place packaged popcorn in the microwave; cook on high until popping begins to slow down, about 2 1/2 minutes. Mix in Parmesan cheese. Drizzle melted butter over popcorn. Mix in savory snack mix and salt."
    }
  ],

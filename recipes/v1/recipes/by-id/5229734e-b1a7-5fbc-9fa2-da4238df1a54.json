  "id": "5229734e-b1a7-5fbc-9fa2-da4238df1a54",
  "slug": "zesty-lemon-loaf",
  "name": "Zesty Lemon Loaf",
  "recipe_type": "dessert",
  "brief_description": "This dressed-up pound cake-style zesty lemon loaf has a hint of ginger. The decadence of Grand Marnier makes this zesty lemon loaf recipe special.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 loaf pans."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, ground ginger, and salt together in a bowl; set aside. Beat 2 cups sugar and butter together in a separate large bowl; beat in eggs. Stir in lemon zest and orange liqueur. Add buttermilk, then gently whisk in flour mixture. Pour batter into the prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick or small knife inserted into centers comes out clean, about 50 minutes. Remove from pans; transfer to a wire rack to cool."
    },
    {
      "position": 4,
      "text": "Meanwhile, whisk remaining \u00be cup sugar and lemon juice together until sugar dissolves; gently drizzle over hot loaves. Cool loaves completely before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

  "id": "7a4a0de8-cf3b-505c-ad87-e8373a449684",
  "slug": "spicy-flank-steak",
  "name": "Spicy Flank Steak",
  "recipe_type": "main",
  "brief_description": "This spicy flank steak recipe is packed with flavor thanks to a quick marinade made of paprika, cumin, and coriander, plus ranch dressing for dipping.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine paprika, coriander, cumin, garlic salt, and black pepper in a large resealable plastic bag. Add steak, shake to coat, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 20 minutes."
    },
    {
      "position": 2,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Lightly grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Remove steak from marinade; place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Cook under the preheated broiler until desired doneness, about 5 minutes per side. Serve steak with ranch dressing for dipping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

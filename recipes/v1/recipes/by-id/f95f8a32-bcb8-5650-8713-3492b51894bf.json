  "id": "f95f8a32-bcb8-5650-8713-3492b51894bf",
  "slug": "viral-pork-dumpling-lasagna-recipe-11883823",
  "name": "Viral Pork Dumpling Lasagna",
  "recipe_type": "main",
  "brief_description": "This viral pork dumpling lasagna, inspired by @april_eatz' viral creation, is the easiest way to achieve the amazing pork dumpling flavor you crave. Two layers of seasoned pork, topped by layers of wonton wrappers, are baked like lasagna\u2014no folding, no pinching, no boiling step. It\u2019s delicious.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pork, soy sauce, garlic, ginger, oyster sauce, rice wine, sesame oil, and green onions in a large bowl. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "In a 9x9-inch or 8x10-inch baking dish, spread half the pork mixture into an even layer. Lay half of wonton wrappers evenly over pork, then spread remaining pork mixture over wonton."
    },
    {
      "position": 4,
      "text": "Add water to the dish, and lay remaining wonton wrappers over. Press the top layer of wonton wrappers down to submerge them in water."
    },
    {
      "position": 5,
      "text": "Fill a 9x13-inch baking dish about halfway with hot water. Place dumpling lasagna dish into the 9x13. Cover tightly with foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until pork is cooked, 15 to 20 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C)."
    },
    {
      "position": 7,
      "text": "Serve with chili crisp, green onions, and sesame seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

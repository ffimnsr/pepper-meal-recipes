  "id": "a68230d3-8c5d-51ba-bb51-49f9ebed856e",
  "slug": "fluffy-mayo-pancakes-recipe-11979757",
  "name": "Fluffy Mayo Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy mayo pancakes are light, tender, and incredibly easy to make with pantry staples. The mayonnaise adds richness and helps create a perfectly soft texture, making these pancakes extra fluffy and delicious with butter and syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together flour, sugar, baking powder, and salt in a bowl and create a well in the center."
    },
    {
      "position": 2,
      "text": "Add mayo, water, and vanilla extract to the well and stir until well combined, then fold the wet ingredients into the dry ingredients and stir until just combined."
    },
    {
      "position": 3,
      "text": "Melt butter over medium heat in a large nonstick skillet or griddle. Spoon about 1/4 cup batter into the prepared pan and spread it into a round shape."
    },
    {
      "position": 4,
      "text": "Cook, undisturbed, until bubbles form on the surface and lightly browned around the edges, about 3 minutes. Flip and cook until lightly browned on the second side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

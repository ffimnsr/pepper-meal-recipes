  "id": "3b432cd0-05fa-5b9a-8347-9faefabb72ed",
  "slug": "worlds-best-sweet-potato-pie",
  "name": "World's Best Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pie recipe with evaporated milk has been passed down through the years and is so crowd-pleasing it's been coined \"the world's best.\"",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place sweet potatoes into a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender, 40 to 50 minutes. Drain water; peel and mash sweet potatoes in a large bowl until smooth."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Mix together beaten eggs and melted butter in a medium bowl until well combined; stir into mashed sweet potatoes. Mix in milk, sugar, flour, vanilla, nutmeg, baking powder, and lemon juice until smooth; pour mixture evenly into pie shells."
    },
    {
      "position": 4,
      "text": "Bake pies in the preheated oven for 10 minutes. Decrease oven temperature to 350 degrees F (175 degrees C) and continue baking until a toothpick inserted into the center of a pie comes out clean, about 40 minutes more. Cool pies for 15 to 30 minutes before refrigerating to cool completely, 1 to 2 hours."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

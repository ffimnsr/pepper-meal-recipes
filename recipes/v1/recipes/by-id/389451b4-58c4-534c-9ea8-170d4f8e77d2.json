  "id": "389451b4-58c4-534c-9ea8-170d4f8e77d2",
  "slug": "greek-style-potatoes",
  "name": "Greek-Style Potatoes",
  "recipe_type": "soup",
  "brief_description": "These delicious Greek potatoes are baked with olive oil, garlic, and herbs in a savory lemon broth until soft and creamy inside with crispy edges.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange potatoes evenly in the bottom of a medium baking dish."
    },
    {
      "position": 3,
      "text": "Mix water, olive oil, lemon juice, garlic, bouillon cubes, thyme, rosemary, and pepper together in a small bowl. Pour mixture over potatoes."
    },
    {
      "position": 4,
      "text": "Cover and bake in the preheated oven, turning occasionally, until potatoes are tender yet firm, 1 \u00bd to 2 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,

  "id": "c897a929-cf35-5868-bd41-e0c268ea88a5",
  "slug": "perfectly-moist-irish-wheaten-bread",
  "name": "Perfectly Moist Irish Wheaten Bread",
  "recipe_type": null,
  "brief_description": "This Northern Irish-style wheaten bread recipe made with bread flour, whole wheat flour, buttermilk, sugar, and margarine makes a perfect loaf every time.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a shallow baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Sift both flours, 2 teaspoons sugar, salt, and baking soda together into a bowl. Cut in margarine until mixture resembles coarse crumbs. Make a well in the center of the mixture and pour in 2 cups buttermilk and oil; stir with a spatula until dry mixture is completely moistened."
    },
    {
      "position": 3,
      "text": "Transfer dough to a lightly floured surface and knead gently for no more than 1 minute. Place dough into the prepared pan; pat down and around to form a round loaf. Cut a cross in the top of the loaf with your finger. Brush the top with 1 tablespoon buttermilk, then sprinkle with 1 teaspoon sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes. Reduce the heat to 375 degrees F (190 degrees C), then rotate the pan and bake for 30 more minutes. Remove from the oven and let cool on a wire rack before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

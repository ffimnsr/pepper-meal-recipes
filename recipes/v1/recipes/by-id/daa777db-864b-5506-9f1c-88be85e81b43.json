  "id": "daa777db-864b-5506-9f1c-88be85e81b43",
  "slug": "classic-american-blueberry-crisp",
  "name": "Blueberry Crisp",
  "recipe_type": "dessert",
  "brief_description": "This blueberry crisp recipe, bursting with juicy blueberries, fresh orange juice, and cinnamon, gets a crispy brown sugar topping for a timeless treat.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, cold butter, and salt in the bowl of a food processor; pulse into coarse crumbs. Set topping aside."
    },
    {
      "position": 3,
      "text": "Combine white sugar, orange juice, tapioca, and cinnamon in a large bowl; stir in blueberries until completely coated. Spoon blueberry filling into a large baking dish; sprinkle topping over blueberries."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until topping is golden brown and filling bubbles, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

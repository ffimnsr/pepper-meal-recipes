  "id": "11a3faff-7a0c-52a3-8538-79343baff6d3",
  "slug": "baked-oatmeal",
  "name": "Josh's Baked Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "This baked oatmeal recipe includes plenty of oats, roasted cinnamon, and maple syrup for a sweet and heavenly breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix oats, brown sugar, cinnamon, baking powder, and salt together in a bowl. Beat in milk, butter, maple syrup, eggs, and vanilla extract; fold in cranberries. Spread mixture into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbling, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

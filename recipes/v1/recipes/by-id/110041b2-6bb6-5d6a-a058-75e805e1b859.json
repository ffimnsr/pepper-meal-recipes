  "id": "110041b2-6bb6-5d6a-a058-75e805e1b859",
  "slug": "butternut-squash-sweet-potato-ginger-bisque",
  "name": "Butternut Squash-Sweet Potato Ginger Bisque",
  "recipe_type": "soup",
  "brief_description": "Butternut squash and sweet potatoes blend with ginger, garlic, and onion in this creamy, pureed soup that's ideal for warming body and soul in wintertime.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the squash, sweet potatoes, onion, ginger, and garlic in a large pot. Pour in enough water to cover the vegetables. Bring to simmer over medium heat, and cook until vegetables are tender and can be easily pierced with a fork, 30 to 45 minutes."
    },
    {
      "position": 2,
      "text": "Remove pot from heat. Place soup in batches into a blender or the bowl of a food process. Pulse until smooth. Return soup to pot, and whisk in yogurt. Season with salt and pepper to taste. If necessary, reheat soup over low heat, but do not allow to boil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

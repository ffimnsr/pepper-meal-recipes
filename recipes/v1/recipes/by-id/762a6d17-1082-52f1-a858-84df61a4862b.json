  "id": "762a6d17-1082-52f1-a858-84df61a4862b",
  "slug": "one-pan-chicken-sausage-vegetables-and-orzo-recipe-11681595",
  "name": "One Pan Chicken Sausage, Vegetables, and Orzo",
  "recipe_type": "main",
  "brief_description": "For this one pan chicken sausage, vegetables, and orzo, everything goes into one skillet. Cut and measure the ingredients before you start cooking, because this colorful dish comes together quickly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Warm olive oil and butter in a 12-inch skillet over medium heat."
    },
    {
      "position": 2,
      "text": "When the butter stops sizzling, add sausage pieces. Cook until warmed, 1 to 2 minutes, then add onion. Cook together, stirring, about 2 minutes, and add mushrooms. Cook until soft, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Add garlic and cook, stirring, until fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Stir in French-sliced green beans, matchstick carrots, red bell pepper strips, and continue to cook and stir about 2 minutes."
    },
    {
      "position": 5,
      "text": "Add wine, and stir about 1 minute, then add chicken broth and Italian seasoning blend. Taste; season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Increase heat to medium-high and bring to a boil. Stir in orzo, and return to a boil. Reduce heat to medium-low and place artichokes on top. Allow mixture to bubble lightly until orzo and vegetables are tender and most of liquid is absorbed, 12 to 14 minutes. Stir occasionally, so orzo does not stick to the bottom of the pan."
    },
    {
      "position": 7,
      "text": "Garnish with parsley; serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

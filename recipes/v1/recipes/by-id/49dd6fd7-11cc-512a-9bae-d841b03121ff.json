  "id": "49dd6fd7-11cc-512a-9bae-d841b03121ff",
  "slug": "wasabi-and-soy-sauce-hummus",
  "name": "Wasabi and Soy Sauce Hummus",
  "recipe_type": "appetizer",
  "brief_description": "A Middle Eastern staple takes a trip to the Orient with the addition of wasabi and soy sauce in this hummus recipe.",
  "cuisine": "Middle Eastern Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine about 1/2 the chickpeas, soy sauce, olive oil, lemon juice, tahini, wasabi powder, garlic, and black pepper in a blender; blend until smooth, scraping down the sides of the blender bowl with a spatula to assure ingredients fully integrated. Scrape mixture into a bowl."
    },
    {
      "position": 2,
      "text": "Put remaining chickpeas into the blender, reserving 5 to 7 individual beans for later use. Blend until smooth, adding reserved liquid from the cans if moisture is needed to get them smooth; add to the prior batch and stir."
    },
    {
      "position": 3,
      "text": "Make a shallow pool in the center of the hummus with the back of a spoon; garnish with reserved chickpeas and a small amount of olive oil."
    },
    {
      "position": 4,
      "text": "Cover bowl with plastic wrap and refrigerate at least 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

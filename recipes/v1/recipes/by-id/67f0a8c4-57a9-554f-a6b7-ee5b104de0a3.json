  "schema_version": 1,
  "id": "67f0a8c4-57a9-554f-a6b7-ee5b104de0a3",
  "slug": "jalapeno-popper-creamed-corn-recipe-11760031",
  "name": "Jalape\u00f1o Popper Creamed Corn",
  "recipe_type": "side",
  "brief_description": "For this jalapeno popper creamed corn, frozen corn is jazzed up with all the elements of jalape\u00f1o poppers\u2014bacon, cream cheese, Cheddar cheese, and of course, jalape\u00f1os, for a little kick! Serve as a side for barbecue pork or chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook bacon in a skillet over medium heat until fat is rendered. Add onion and jalape\u00f1os and cook, stirring frequently, until onion begins to turn clear and bacon is browned, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in frozen corn and cook, about 6 to 8 minutes, stirring often. Pour in cream, add cumin and black pepper, and cook until cream is warm, about 1 minute."
    },
    {
      "position": 4,
      "text": "Add Boursin by tablespoons, mashing and stirring until it melts into the sauce. Remove from heat and stir in Cheddar; stir until cheese is melted."
    },
    {
      "position": 5,
      "text": "Garnish with lime wedges and parsley or cilantro sprigs. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

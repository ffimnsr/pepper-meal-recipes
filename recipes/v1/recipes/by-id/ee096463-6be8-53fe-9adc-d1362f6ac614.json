  "id": "ee096463-6be8-53fe-9adc-d1362f6ac614",
  "slug": "gluten-free-quinoa-noodles",
  "name": "Gluten-Free Quinoa Noodles",
  "recipe_type": null,
  "brief_description": "This quinoa noodles recipe uses quinoa and rice flour, which keeps the egg noodles gluten free \u2014 perfect when you're craving chicken and noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1 cup rice flour, quinoa flour, xanthan gum, basil, rosemary, oregano, and salt together in a large bowl; make a well in the center."
    },
    {
      "position": 2,
      "text": "Whisk eggs and egg yolk together in a small bowl; whisk in water and olive oil. Pour into well in flour mixture; mix thoroughly until a dough forms."
    },
    {
      "position": 3,
      "text": "Transfer dough to a work surface lightly dusted with 2 \u00bd tablespoons rice flour; knead until smooth and elastic, 8 to 12 minutes. Cover dough; rest, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Divide dough into 4 equal pieces. Dust work surface with remaining 2 \u00bd tablespoons rice flour; roll each dough piece into a square shape about 1/16-inch thick. Rest dough, uncovered, for 20 minutes."
    },
    {
      "position": 5,
      "text": "Loosely roll up each dough square; cut into \u00bc-inch pieces. Unroll noodles."
    },
    {
      "position": 6,
      "text": "Bring a large pot of lightly salted water to a boil. Cook noodles in the boiling water until tender yet firm to the bite, about 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

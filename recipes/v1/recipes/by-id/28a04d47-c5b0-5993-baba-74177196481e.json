  "id": "28a04d47-c5b0-5993-baba-74177196481e",
  "slug": "apple-bavarian-torte",
  "name": "Apple Bavarian Torte",
  "recipe_type": "dessert",
  "brief_description": "This apple Bavarian torte recipe is cleverly made in a springform pan, with a no-fuss crust, a tangy cream cheese filling, and an apple-almond topping.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, butter, 1/3 cup sugar, and 1/4 teaspoon vanilla extract together in a medium bowl. Press crust into bottom of a 9-inch springform pan. Set aside."
    },
    {
      "position": 3,
      "text": "Blend cream cheese, 1/4 cup sugar, egg, and 1/2 teaspoon vanilla extract together in a large bowl until well combined. Pour filling over crust."
    },
    {
      "position": 4,
      "text": "Mix apples, 1/3 cup sugar, and cinnamon together in a large bowl; spread over filling."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 400 degrees F (200 degrees C); continue baking for 25 minutes. Sprinkle almonds over torte; continue baking until apples are tender and almonds are golden. Cool; remove from pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

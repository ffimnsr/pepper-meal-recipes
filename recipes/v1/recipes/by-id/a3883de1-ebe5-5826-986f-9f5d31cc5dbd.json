  "id": "a3883de1-ebe5-5826-986f-9f5d31cc5dbd",
  "slug": "pasta-salad",
  "name": "Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This pasta salad is loaded with colored pasta and fresh vegetables tossed with zesty Italian dressing for a classic summer salad full of flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, about 10 to 12 minutes; rinse under cold water and drain."
    },
    {
      "position": 3,
      "text": "Whisk Italian dressing and salad spice mix together until smooth. Combine pasta, tomatoes, bell peppers, and olives in a salad bowl."
    },
    {
      "position": 4,
      "text": "Pour dressing over salad and toss to coat."
    },
    {
      "position": 5,
      "text": "For the best flavor, refrigerate the pasta salad for 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

  "schema_version": 1,
  "id": "8585bb21-9f5f-5f41-ad4f-86483e4d0c96",
  "slug": "bbq-meatball-sliders",
  "name": "BBQ Meatball Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These meatball sliders are super easy to make with Hawaiian rolls, meatballs coated with BBQ sauce, and melted cheese for the perfect party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine meatballs and BBQ sauce in a small sauce pan and bring to a simmer over medium heat. Reduce heat to medium-low and simmer 10 minutes or until the meatballs are heated through."
    },
    {
      "position": 3,
      "text": "Slice rolls in half lengthwise, leaving the rolls connected to one another. Brush some butter to make a light coating on the bottom of a 9x13-inch baking dish; place the bottom half of the rolls in the dish, with the cut-side facing up. Set remaining butter aside. Spoon out some of the BBQ sauce from the sauce pan and spread lightly over bread."
    },
    {
      "position": 4,
      "text": "Combine Cheddar cheese and Monterey Jack cheese in a bowl and sprinkle 1/2 of cheese mixture over the sauce. Top with pickles and sprinkle evenly with onion strips."
    },
    {
      "position": 5,
      "text": "Use a 1-inch cookie cutter, or a small knife, to cut a small 1 inch hole into the tops of each roll. Place top half of rolls over the onion strips. Stir garlic powder into remaining melted butter and brush the mixture over the rolls, allowing any excess to drip into the cut out spaces. Spoon one meatball and about 1 teaspoon of sauce into the holes on each roll. Sprinkle with remaining cheese."
    },
    {
      "position": 6,
      "text": "Cover with foil and bake in the preheated oven until cheese is melted throughout, uncovering halfway through, for about 20 minutes. Sprinkle green onions on top."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f3480bfc-8373-5b88-8db3-398f0d92b3d3",
  "slug": "one-egg-biscuit-and-sausage-gravy-recipe-12071556",
  "name": "One-Egg Biscuit and Sausage Gravy",
  "recipe_type": "breakfast",
  "brief_description": "This one-egg biscuit and sausage gravy recipe is a quick, comforting breakfast or a supremely satisfying breakfast-for-dinner. A freshly baked two-ingredient biscuit makes a shortcut you\u2019ll be happy to know, while the egg cooks right in the quick yet creamy sausage gravy that coats the whole thing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (235 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Stir flour and cream together to form a dough. Use plastic wrap to shape into a round 1/2-inch thick patty. Transfer to a lined baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly golden brown, 12 to 15 minutes. Flip biscuit so the flat, darker side is up, and press lightly down so that it sits flat. Transfer to a cooling rack until needed."
    },
    {
      "position": 4,
      "text": "Meanwhile, for sausage gravy, add butter and sausage to a small skillet over medium-high heat. Cook and stir sausage until browned, breaking into small crumbles with a spatula. Add green onions and cook, stirring, for 1 minute."
    },
    {
      "position": 5,
      "text": "Add flour and cook, stirring, for 1 minute. Reduce heat to medium if needed and whisk in milk; add black pepper, cayenne, and salt. Wait for the gravy to simmer and thicken, stirring occasionally. Transfer egg into center of the skillet on top of gravy; cover and cook until the egg is cooked to your liking, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "To serve, spoon gravy over the biscuit and top with the egg. Spoon remaining gravy around the egg and biscuit, and top with sliced green onion."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

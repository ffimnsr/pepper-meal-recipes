  "id": "4eb832fa-c807-58a5-82c5-82fa9b4ebd47",
  "slug": "sun-dried-tomato-pesto-no-nuts",
  "name": "Sun-Dried Tomato Pesto (No Nuts)",
  "recipe_type": "side",
  "brief_description": "A traditional pesto, made without nuts, gets more colorful with the addition of sun-dried tomatoes. Pour this pesto over your pasta for a quick weeknight meal.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place sun-dried tomatoes in a small pot and cover with water; bring to a boil. Remove from heat and let tomatoes soften, about 10 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Blend tomatoes, basil, Parmesan cheese, garlic, and salt in a blender until mixed. Slowly add olive oil, about 1/4 cup at a time; blend until smooth."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

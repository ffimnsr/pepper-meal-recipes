  "slug": "chicken-potato-salad",
  "name": "Chicken Potato Salad",
  "recipe_type": "salad",
  "brief_description": "The addition of chicken to this picnic essential lets it do double duty as main dish or side salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Chop the chicken, eggs, potatoes and pickled cucumbers into very small pieces. Mix all together. Add the salt and mayonnaise, then the olive oil. Toss to coat. Refrigerate for 2 to 3 hours before serving."
    }
  ],

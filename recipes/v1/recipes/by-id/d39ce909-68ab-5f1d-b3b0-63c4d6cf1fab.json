  "id": "d39ce909-68ab-5f1d-b3b0-63c4d6cf1fab",
  "slug": "mock-mincemeat-pie",
  "name": "Mock Mincemeat Pie",
  "recipe_type": "dessert",
  "brief_description": "This mock mincemeat pie recipe is meatless and contains apples, raisins, orange juice, cinnamon, and cloves. A splash of brandy enhances the flavors.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine apples, raisins, apple cider, orange juice, and orange zest in a large saucepan over medium heat; simmer, stirring occasionally, until apples are very soft, about 20 minutes. Stir in sugar, soda crackers, cinnamon, and cloves until well combined."
    },
    {
      "position": 3,
      "text": "Pour apple mixture into pie crust; top with second crust. Pinch and crimp edges to seal. Pierce top crust in several places with a fork. (Or refrigerate apple mixture until ready to use.)"
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C). Bake until top is golden brown, about 30 minutes more. Cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

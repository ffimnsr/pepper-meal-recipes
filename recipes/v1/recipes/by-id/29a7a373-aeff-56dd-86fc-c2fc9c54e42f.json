  "id": "29a7a373-aeff-56dd-86fc-c2fc9c54e42f",
  "slug": "coffee-and-donuts-tiramisu",
  "name": "Coffee and Donuts Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "Mini powdered donuts are dipped in strong coffee, layered with creamy, sweet pudding, and sprinkled with cocoa powder, resulting in the easiest version of tiramisu ever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk milk and pudding mix together in a large bowl until smooth. Fold in whipped topping and set aside."
    },
    {
      "position": 2,
      "text": "Pour coffee into a shallow bowl. Dip one donut into the coffee and hold for 5 to 10 seconds on each side. Place in the bottom of an 8-inch square baking dish. Repeat with 11 more donuts to fill the bottom of the dish."
    },
    {
      "position": 3,
      "text": "Spread 1/2 of the pudding mixture over the donuts. Repeat the process with remaining 12 donuts and pudding mixture. Lightly sprinkle cocoa powder over top."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate, 8 hours to overnight. Serve chilled."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "3bd2448b-e1d8-5808-b09f-6f17e06d822c",
  "slug": "air-fryer-gnocchi-recipe-11882085",
  "name": "Air Fryer Gnocchi",
  "recipe_type": "appetizer",
  "brief_description": "This air fryer gnocchi turns a shelf stable item into a delicious appetizer with endless possibilities for flavor combinations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 350 degrees F (180 degrees C). Lightly spray the air fryer basket with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir gnocchi, olive oil, garlic powder, onion powder, black pepper, chili flakes, and Parmesan cheese together in a bowl. Toss until gnocchi are coated."
    },
    {
      "position": 3,
      "text": "Place gnocchi in the air fryer basket, preferably in 1 layer to ensure doneness. Fry at 390 degrees F (199 degrees C) for 5 minutes. Remove basket and give it a shake, Return to the air fryer and fry until crisp, about 6 minutes more."
    },
    {
      "position": 4,
      "text": "Serve with marinara sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 11,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

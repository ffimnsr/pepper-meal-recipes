  "id": "d11df061-9a0c-5ba8-9a30-8a3fa218f8ff",
  "slug": "lemon-panko-crusted-salmon",
  "name": "Lemon Panko-Crusted Salmon",
  "recipe_type": "main",
  "brief_description": "Seasoned panko on salmon bakes up into a crispy, crunchy crust that adds excellent flavor and texture to this simple recipe for tender, flaky salmon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine panko, Parmesan, lemon-pepper seasoning, thyme, parsley, garlic, and lemon zest in a bowl."
    },
    {
      "position": 3,
      "text": "Place salmon onto the prepared baking sheet. Brush melted butter over top, then sprinkle with panko mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 20 to 25 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "89548368-1ea4-5649-9bc9-784853f1e190",
  "slug": "the-best-veggie-sandwich",
  "name": "The Best Veggie Sandwich",
  "recipe_type": "main",
  "brief_description": "English muffins are layered with avocado, sprouts, tomato, Ranch dressing, sesame seeds and smoked Cheddar, then lightly broiled. Garnish each with a black olive, if desired.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to broil."
    },
    {
      "position": 2,
      "text": "Place each muffin open-faced on a cookie sheet. Spread each half with mashed avocado; place halves close together. Distributing ingredients evenly, cover each half with sprouts, tomatoes, onion, dressing, sesame seeds and cheese."
    },
    {
      "position": 3,
      "text": "Place under broiler for about 5 minutes, or until cheese is melted and bubbly."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "90518d4e-c0ac-5862-a403-75221b9a7187",
  "slug": "strawberry-preserves-i",
  "name": "Strawberry Preserves",
  "recipe_type": "side",
  "brief_description": "Delicious homemade strawberry preserves made with whole strawberries to make a rich, thick, and chunky fruity jam perfect for spreading.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine whole strawberries, sugar, vinegar, and salt together in a large stockpot. Bring to a rolling boil, and cook stirring frequently for 15 to 20 minutes, or until the temperature of the mixture has reached 220 degrees F (105 degrees C)."
    },
    {
      "position": 2,
      "text": "Transfer preserves to hot sterile jars, leaving 1/2-inch headspace, and seal. Process jars for 10 minutes in a water bath. Refrigerate jam once the seal is broken."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 20,

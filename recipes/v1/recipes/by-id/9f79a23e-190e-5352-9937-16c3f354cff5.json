  "id": "9f79a23e-190e-5352-9937-16c3f354cff5",
  "slug": "creamy-chicken-gnocchi-soup",
  "name": "Creamy Chicken Gnocchi Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy chicken gnocchi soup, with plenty of colorful vegetables, tender pasta, and rotisserie meat, is a warming meal that soothes the soul.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter with olive oil in a large soup pot over medium heat. Cook and stir zucchini, celery, onion, red bell pepper, carrots, and garlic in hot butter-oil until vegetables are soft, 8 to 10 minutes. Stir in flour until vegetables are coated; cook for 2 more minutes."
    },
    {
      "position": 2,
      "text": "Pour in chicken broth and stir until flour paste combines with broth and soup is thick and smooth, about 5 minutes. Pour in both kinds of half-and-half; bring to a simmer. Cook until soup is slightly thickened, about 5 more minutes."
    },
    {
      "position": 3,
      "text": "Gently fold chicken, gnocchi, and spinach into soup. Season with thyme, nutmeg, salt, and pepper. Adjust thickness by adding more chicken broth, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

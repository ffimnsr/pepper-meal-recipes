  "id": "074fd7c1-eb5a-5c93-a645-57e2a8cb27e9",
  "slug": "orange-and-milk-braised-pork-carnitas",
  "name": "Orange and Milk-Braised Pork Carnitas",
  "recipe_type": "main",
  "brief_description": "Chunks of pork shoulder are braised in milk with herbs and orange zest in Chef John's recipe for pork carnitas.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Season pork with pepper and salt."
    },
    {
      "position": 2,
      "text": "Heat oil in large pot over high heat. Working in batches, cook pork in the hot oil until browned on all sides, about 5 minutes. Return all cooked pork and accumulated juice to pot."
    },
    {
      "position": 3,
      "text": "Season pork with bay leaves, cumin, dried oregano, and cayenne pepper. Stir in fresh orange juice, orange zest, and milk. Bring mixture to a boil over high heat; reduce heat to low. Cover and simmer, stirring occasionally, until meat is fork tender but not falling apart, about 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove pork from liquid. Skim some fat from the pot to grease a baking dish. Transfer the pieces of pork to the baking dish. Drizzle about 2 more tablespoons of the floating fat over the meat. Season with more salt, if needed."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until pork is browned, about 15 minutes. Stir pork."
    },
    {
      "position": 7,
      "text": "Turn on oven's broiler. Cook pork under broiler until crisp, 2 to 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,

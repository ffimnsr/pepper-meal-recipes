  "schema_version": 1,
  "id": "1603f4c2-fef7-5c32-9746-99b57a4bb1f8",
  "slug": "barbeque-style-braised-short-ribs",
  "name": "Barbecue-Braised Short Ribs",
  "recipe_type": "main",
  "brief_description": "A thick, rich barbecue sauce adds bold flavor to these braised beef short ribs, cooked until meltingly tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil over medium heat in a large, heavy, oven-safe pot or Dutch oven. Add ribs; brown on all sides, about 5 minutes, working in batches if necessary. Season ribs with black pepper as they brown. Transfer browned ribs to a paper-towel-lined plate to drain."
    },
    {
      "position": 3,
      "text": "Stir onion rings and carrots into same pot; cook and stir until onions turn translucent and start to brown, about 8 minutes. Stir in garlic; cook until fragrant, about 1 minute more. Stir in tomato sauce, barbecue sauce, and beef broth; bring to a boil, and simmer for 1 minute to blend flavors. Stir in browned ribs."
    },
    {
      "position": 4,
      "text": "Cover pot; bake in the preheated oven until the meat is very tender, turning ribs occasionally, about 2 1/2 hours. Season to taste before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "8d932950-8a25-5308-9299-9a5b3ae53fd5",
  "slug": "instant-pot-corned-beef",
  "name": "Instant Pot Corned Beef",
  "recipe_type": "main",
  "brief_description": "Instant Pot corned beef with all the fixings is ready in just 2 hours with an electric pressure cooker. Guaranteed juicy, tender corned beef every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water, beer, and garlic in a multi-functional pressure cooker (such as Instant Pot)."
    },
    {
      "position": 3,
      "text": "Place trivet inside. Place brisket on the trivet and sprinkle spice packet on top. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 90 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Transfer brisket to a baking sheet, cover with aluminum foil, and rest for 10 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "394a8be1-5c2c-5148-a840-548b79527e74",
  "slug": "malian-ginger-juice",
  "name": "Malian Ginger Juice",
  "recipe_type": "drink",
  "brief_description": "A popular and refreshing ginger drink recipe from West Africa is just the drink to go with heavy or fried foods for a light and flavorful balance.",
  "cuisine": "West African",
  "instructions": [
    {
      "position": 1,
      "text": "Place ginger into a blender, cover with 1 1/2 cups water, and blend until ginger is thick and pasty. Strain and squeeze juice from ginger pulp into a 2-quart pitcher, squeezing ginger mixture as dry as possible."
    },
    {
      "position": 2,
      "text": "Stir lemon juice and sugar into ginger juice until sugar has dissolved. Pour 7 cups water into mixture, stir to combine, and serve garnished with crushed mint leaves."
    }
  ],

  "id": "8dfe943e-b749-541b-9e79-a246fabf7d5b",
  "slug": "cookie-dough-ice-cream-sandwiches-recipe-11881257",
  "name": "Cookie Dough Ice Cream Sandwiches",
  "recipe_type": "dessert",
  "brief_description": "These cookie dough ice cream sandwiches have a twist\u2014half of them are baked, and half of them are raw, so you can have the cookie the way you like it the most. Choose your favorite ice cream, and use plenty of rainbow sprinkles!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven according to the cookie package instructions. Shake out sprinkles in an even layer on a sheet tray."
    },
    {
      "position": 2,
      "text": "Unwrap the cookie dough log and roll in sprinkles until evenly coated on the outside. Cut into 1/4-inch slices."
    },
    {
      "position": 3,
      "text": "Set half of the cookies on a plate and place in the freezer. Place the other half on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake half of the cookies in the preheated oven according to package instructions. Remove to cool on a wire rack."
    },
    {
      "position": 5,
      "text": "Meanwhile, remove cookie dough pieces from the freezer, and assemble cookie dough sandwiches: Take one slice of dough, add a scoop of ice cream and press down with a spoon to flatten the ice cream. Top with another slice of dough. Repeat until all sandwiches are formed and return to the freezer."
    },
    {
      "position": 6,
      "text": "When the baked cookies are done and cooled, repeat the process to make sandwiches: Take one baked cookie, add a scoop of ice cream, and press down with a spoon to flatten ice cream."
    },
    {
      "position": 7,
      "text": "Top with another baked cookie. Repeat until all sandwiches are formed. Place in the freezer for 5 to 10 minutes to set."
    },
    {
      "position": 8,
      "text": "Once all sandwiches are assembled, enjoy! I recommend having one of each."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

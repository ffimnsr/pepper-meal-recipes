  "id": "105d2884-1ba5-50d1-beae-7555aed750c2",
  "slug": "chopped-greek-chicken-sandwich-recipe-8629838",
  "name": "Chopped Greek Chicken Sandwich",
  "recipe_type": "salad",
  "brief_description": "This chopped Greek chicken sandwich makes life easy when you can't decide between a Greek salad and a chicken sandwich. Pile up the components of a salad, chop, mix, and pack them into a sandwich roll, and you will absolutely love the result.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut sandwich roll 3/4 of the way in, and if desired, remove some of the crumb from the inside to make more room for filling."
    },
    {
      "position": 3,
      "text": "Pile up chicken, green pepper, tomatoes, cucumber, olives, and onion. Season with salt, black pepper, cayenne, and oregano, and then use a cleaver or large knife to chop everything into about 1/2-inch pieces."
    },
    {
      "position": 4,
      "text": "Add Romaine, and chop again until everything into about 1/4-inch pieces, or as fine as you want."
    },
    {
      "position": 5,
      "text": "Top with feta, lemon juice, and olive oil. Perform one last, brief chopping until everything is evenly mixed. Taste and adjust seasoning."
    },
    {
      "position": 6,
      "text": "Transfer filling into roll, and serve immediately."
    }
  ],
  "servings": 1,

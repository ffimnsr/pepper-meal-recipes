{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "53a34d66-fd9b-5521-84de-1901932c04bd",
  "slug": "vegan-baked-polenta-with-radicchio",
  "name": "Vegan Baked Polenta with Radicchio",
  "recipe_type": "side",
  "brief_description": "This vegan baked polenta with vegan cheese blend and radicchio is adapted from a popular dish from the Lombardy region of Italy.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 355 degrees F (180 degrees C). Grease an 8x8-inch baking pan with 1 teaspoon olive oil."
    },
    {
      "position": 2,
      "text": "Combine vegetable broth and 1 cup water in a large pot and bring to a boil over high heat. Reduce heat to medium and keep at a low boil. Pour in unsweetened oat milk and bring to a boil. Sprinkle in cornmeal, whisking constantly to avoid clumps from forming. Reduce heat to medium-low and continue stirring until polenta begins to thicken. Add more water if needed. Stir until polenta has softened and thickened, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat remaining 2 teaspoons olive oil in a skillet. Add onion and carrot. Saute until vegetables have just begun to soften. Add radicchio and saute until wilted. Season with pepper and turmeric. Cook until vegetables are tender and cooked throughout, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Spread out 1/2 of the polenta in the greased baking dish. Evenly layer 1/2 of the vegan Gouda and 1/2 of the vegan mozzarella on top. Top with 1/2 of the radicchio mixture. Repeat layers with remaining polenta, cheeses, and radicchio mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese has melted and is bubbling, about 20 minutes. Allow to rest for 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

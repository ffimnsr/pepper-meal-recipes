  "id": "ae933248-5f5e-5c9f-b92b-ac6e06c66bf3",
  "slug": "easy-brazilian-lemonade",
  "name": "Easy Brazilian Lemonade",
  "recipe_type": "dessert",
  "brief_description": "This creamy lemonade drink is sweet limeade mixed with sweetened condensed milk to make a creamy, cold drink perfect for a sunny day. Easy and breezy!",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "Wash limes thoroughly. Cut ends off and discard, then slice into about 8 pieces."
    },
    {
      "position": 2,
      "text": "Place limes, water, sugar, and sweetened condensed milk in a blender. Pulse 5 times. Strain mixture through a sieve into a large pitcher. Serve over ice."
    }
  ],
  "servings": 3,

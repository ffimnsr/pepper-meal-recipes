  "id": "b42196e9-3786-5558-b59b-81e24ee1fad8",
  "slug": "hummingbird-muffins-recipe-11724431",
  "name": "Hummingbird Muffins",
  "recipe_type": "dessert",
  "brief_description": "These hummingbird muffins are moist, fruit-forward banana pineapple muffins, with a nice, crisp streusel. Perfect for breakfast or light dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Line 12 standard muffin cups with paper liners or coat with cooking spray."
    },
    {
      "position": 2,
      "text": "For batter, whisk together flour, baking powder, cinnamon, salt, baking soda, and allspice in a small bowl."
    },
    {
      "position": 3,
      "text": "Whisk together bananas, pineapple, white sugar, brown sugar, melted butter, milk, egg, and vanilla in a large bowl."
    },
    {
      "position": 4,
      "text": "Fold in flour mixture until just combined. Fold in pecans."
    },
    {
      "position": 5,
      "text": "Add batter to the prepared muffin cups. They will be nearly full."
    },
    {
      "position": 6,
      "text": "For streusel, combine flour, brown sugar, cinnamon, and salt in a bowl. Cut in salted butter with a pastry blender until the mixture resembles coarse crumbs. Stir in pecans."
    },
    {
      "position": 7,
      "text": "Sprinkle streusel over the muffin batter."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of muffins comes out clean, 20 to 25 minutes. Let cool in the pan for 10 minutes."
    },
    {
      "position": 9,
      "text": "Remove muffins to cool completely on a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

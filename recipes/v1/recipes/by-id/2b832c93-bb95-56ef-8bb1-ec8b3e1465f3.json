{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2b832c93-bb95-56ef-8bb1-ec8b3e1465f3",
  "slug": "teenas-overnight-southern-buttermilk-biscuits",
  "name": "Teena's Overnight Southern Buttermilk Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "Buttermilk makes the difference in these easy Southern-style biscuits that are refrigerated overnight to ensure they rise high, light and beautiful.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Sift together flour and sugar in a large bowl. Cut in shortening until mixture resembles a fine crumb or cornmeal texture. Stir in buttermilk with a fork until a soft dough forms."
    },
    {
      "position": 2,
      "text": "Turn dough out onto a floured surface, pulling off any pieces sticking inside the bowl. Gather dough into a ball and knead about 20 times, until smooth and elastic. Wrap in plastic wrap and refrigerate for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 4,
      "text": "Working on a floured surface, roll or pat dough out to 1-inch thickness. Cut into rounds with a 2-inch biscuit cutter or the floured rim of a glass, by pressing straight down and up. Twisting the cutter will prevent biscuits from rising as high. Place biscuits about 1 inch apart on an ungreased baking sheet and allow to rest a few minutes."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly brown, 12 to 15 minutes. Cool on a wire rack. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

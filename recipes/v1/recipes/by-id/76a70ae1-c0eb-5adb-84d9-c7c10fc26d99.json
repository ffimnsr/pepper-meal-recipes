  "id": "76a70ae1-c0eb-5adb-84d9-c7c10fc26d99",
  "slug": "marinated-beet-salad",
  "name": "Marinated Beet Salad",
  "recipe_type": "salad",
  "brief_description": "Canned beets makes this a no-fuss salad to whip up. The sweet and sour dressing is heated and poured over the beets and diced red onion, and then it's popped into the refrigerator to chill.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain beets, reserving 1/4 cup liquid, and slice into 1/4 to 1/2 inch slivers. Add onions and toss."
    },
    {
      "position": 2,
      "text": "In a saucepan over medium heat, cook the sugar, mustard and reserved 1/4 cup liquid until dissolved. Add vinegar and bring to boil; remove from heat and allow to cool."
    },
    {
      "position": 3,
      "text": "Pour over the beet slices and onions, toss and refrigerate for 4 to 6 hours. Remove from refrigerator and serve at room temperature."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

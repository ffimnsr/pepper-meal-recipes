  "id": "f68e2aa1-66a6-52d9-a983-0b75f3c5ad1d",
  "slug": "crab-legs-with-garlic-butter-sauce",
  "name": "Crab Legs with Garlic Butter Sauce",
  "recipe_type": "main",
  "brief_description": "This crab legs recipe couldn't be easier! Don't pay marked-up restaurant prices when you can make crab legs in a tasty butter sauce at home for much less.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut a slit, length-wise, into the shell of each piece of crab."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add garlic and cook until translucent, 1 to 2 minutes. Stir in parsley, pepper, and salt. Continue to heat mixture until bubbling."
    },
    {
      "position": 3,
      "text": "Add crab legs to the skillet; toss to coat with butter mixture. Simmer until completely heated through, 5 to 6 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

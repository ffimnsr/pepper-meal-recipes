  "id": "e0708140-b422-5f5c-b684-bdb1c43b6330",
  "slug": "peanut-butter-cup-brownies",
  "name": "Peanut Butter Cup Brownies",
  "recipe_type": "dessert",
  "brief_description": "Use chocolate brownie mix and miniature peanut butter cups with this easy recipe for a yummy treat that everyone will love!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine brownie mix, oil, egg and water in a large bowl. Stir 50 strokes with a spoon."
    },
    {
      "position": 3,
      "text": "Place batter in a cupcake pan (cupcake wrappers recommended). Once cups are 3/4 of the way full, place an unwrapped miniature peanut butter cup in the middle, then bake for 30-35 minutes keeping an eye on them while they're baking. Let them cool and then they're ready to eat!!"
    }
  ],
  "servings": 6,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e1934828-f10a-520c-ad4d-e9d77dda9c76",
  "slug": "smoked-corned-beef-brisket",
  "name": "Smoked Corned Beef Brisket",
  "recipe_type": "main",
  "brief_description": "This smoked corned beef brisket is seasoned with a dry rub of coriander, mustard seed, fennel, and paprika that enhances the flavor of the tender meat.",
  "cuisine": "American Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine coriander, fennel seeds, brown sugar, paprika, garlic powder, onion powder, and mustard seed in a small bowl until spice mixture is well combined."
    },
    {
      "position": 2,
      "text": "Place brisket in a glass baking dish and rub spice mixture all over meat. Cover with plastic wrap and place in the refrigerator for 2 to 3 days."
    },
    {
      "position": 3,
      "text": "Soak wood chips in water for at least 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat a smoker to 240 degrees F (116 degrees C) according to manufacturer's instructions. Maintain temperature for 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Drain wood chips and place on coals. Place a water pan on the smoker and add water to the depth of the fill line. Unwrap brisket and place on the lower cooking grate; cover with the smoker lid."
    },
    {
      "position": 6,
      "text": "Cook in the preheated smoker for 2 hours. Pull brisket from the smoker and wrap tightly in foil. Return to the smoker until an instant-read thermometer inserted into the thickest part of brisket reads at least 190 to 200 degrees F (88 to 93 degrees C), about 3 hours."
    },
    {
      "position": 7,
      "text": "Remove brisket from the smoker and let rest for 40 minutes. Slice corned beef against the grain."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

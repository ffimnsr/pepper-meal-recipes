  "id": "997b4bc0-17ef-5efe-9330-9acec0f520c3",
  "slug": "slow-cooker-split-pea-soup-with-bacon-and-hash-browns",
  "name": "Slow Cooker Split Pea Soup with Bacon and Hash Browns",
  "recipe_type": "soup",
  "brief_description": "This slow cooker split pea soup recipe features hash brown potatoes and bacon (instead of ham) simmered with veggies for a hearty and filling meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, stirring occasionally, until lightly browned, about 5 minutes. Drain on a paper towel-lined plate."
    },
    {
      "position": 2,
      "text": "Place cooked bacon, split peas, hash brown potatoes, onion, celery, carrots, garlic, black pepper, and red pepper flakes in a slow cooker. Pour in chicken broth; stir to combine."
    },
    {
      "position": 3,
      "text": "Cook on Low for 8 hours or High for 6 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 365,
  "preparation_time_minutes": 25,

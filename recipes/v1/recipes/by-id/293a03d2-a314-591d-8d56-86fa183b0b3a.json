  "id": "293a03d2-a314-591d-8d56-86fa183b0b3a",
  "slug": "pumpkin-black-cocoa-swirl-cake-recipe-7974201",
  "name": "Pumpkin-Black Cocoa Swirl Cake",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin-black cocoa swirl cake recipe creates a dramatic Bundt cake swirled with two distinct colors and flavors: pumpkin and black cocoa.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 12-cup Bundt pan with baking spray with flour."
    },
    {
      "position": 2,
      "text": "Sift flour, pumpkin pie spice, baking powder, baking soda, and salt together in a large bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat butter, oil, and 2 cups white sugar together in another large bowl with an electric mixer on medium-high speed until creamy, about 3 minutes. Add eggs, 1 at a time, beating well after each addition."
    },
    {
      "position": 4,
      "text": "Beat mixture on medium-high speed until doubled in volume, about 5 minutes. Add pumpkin puree and vanilla; mix until just combined. Reduce the mixer speed to low; add half of the flour mixture and continue mixing until just combined. Add sour cream; mix until just combined. Add remaining half of the flour mixture, mixing until just combined for the pumpkin batter."
    },
    {
      "position": 5,
      "text": "Pour 3 cups batter into a medium bowl. Add 3 tablespoon black cocoa powder, unsweetened cocoa powder, 2 tablespoons white sugar, milk, espresso powder, and semi-sweet chocolate for the black cocoa batter. Mix on low speed until well combined."
    },
    {
      "position": 6,
      "text": "Pour 1/3 black cocoa batter evenly into the prepared Bundt pan. Carefully pour 1/2 pumpkin batter evenly over black cocoa layer. Pour 1/3 black cocoa batter evenly over pumpkin batter. Pour in remaining 1/2 pumpkin batter. Finish with remaining 1/3 black cocoa batter."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out mostly clean, 60 to 65 minutes. Cool in the pan, 25 to 30 minutes, before inverting onto a wire rack to cool completely."
    },
    {
      "position": 8,
      "text": "Combine confectioners' sugar, heavy cream, 2 tablespoons black cocoa, 1 teaspoon vanilla extract, and a pinch of salt together in a medium bowl; whisk until smooth. Drizzle icing over cake."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 35,

  "id": "1bdb609e-dc64-5710-907e-01db4b215590",
  "slug": "tempeh-mock-tuna-salad",
  "name": "Tempeh Mock Tuna Salad",
  "recipe_type": "salad",
  "brief_description": "This flavorful mock tuna salad is made with tempeh soy protein and soy mayonnaise, a real vegetarian treat. Serve it as a salad filling or on fresh greens.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat the broth to a light boil over medium-high heat. Add the tempeh to the broth, and simmer for 25 minutes. Drain and let cool to room temperature for 15 minutes. Once cooled, grate tempeh into a large bowl."
    },
    {
      "position": 2,
      "text": "In a small bowl, whisk together the soy sauce, lemon juice, garlic, and seaweed flakes. Pour the seaweed mixture in with the grated tempeh and stir until well mixed. Mix in the red onion, celery, and dill pickles. Toss with the mayonnaise. This salad can be served immediately, but is best when chilled for several hours to allow the flavors to blend."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

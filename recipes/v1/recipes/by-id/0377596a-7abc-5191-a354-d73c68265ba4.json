  "id": "0377596a-7abc-5191-a354-d73c68265ba4",
  "slug": "stuffed-green-peppers-ii",
  "name": "Easy Stuffed Green Peppers",
  "recipe_type": "main",
  "brief_description": "Easy, delicious stuffed bell peppers. Green bell peppers stuffed with ground beef, onion and rice, and then baked and topped with tomato sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Brown beef and onion in a large skillet or medium stock pot over medium heat. Drain fat."
    },
    {
      "position": 2,
      "text": "Add rice, water, diced tomatoes, and stewed tomatoes. Season with salt and pepper. Simmer until rice is tender."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "Cut tops off bell peppers and clean out seeds and membrane (you may have to slightly slice the bottom of peppers to make them stand up.) Fill peppers with meat mixture."
    },
    {
      "position": 5,
      "text": "Place in a casserole dish and bake in the preheated oven until peppers are tender, about 20 minutes. Served topped with spaghetti sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a38f5999-5f62-5d62-8b14-6735a5e0e33e",
  "slug": "rhubarb-slush",
  "name": "Rhubarb Slush",
  "recipe_type": "drink",
  "brief_description": "This refreshing rhubarb slush is an old-fashioned summertime drink made with fresh rhubarb, orange juice, lemonade, and fizzy soda. Gin is optional!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place rhubarb in a large saucepan with water to cover. Bring to a boil over medium-high heat and cook until tender."
    },
    {
      "position": 3,
      "text": "Drain; mash or pur\u00e9e in a blender."
    },
    {
      "position": 4,
      "text": "Stir together rhubarb pur\u00e9e, sugar, orange juice concentrate, lemonade concentrate, gin, and water."
    },
    {
      "position": 5,
      "text": "Freeze for 1 to 3 hours, depending on the consistency you like."
    },
    {
      "position": 6,
      "text": "Place scoops of the frozen mixture into serving glasses and fill the rest of the glass with lemon-lime soda."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

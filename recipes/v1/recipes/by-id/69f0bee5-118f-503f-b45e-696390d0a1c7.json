  "id": "69f0bee5-118f-503f-b45e-696390d0a1c7",
  "slug": "lebanese-zaatar-zaatar-bread",
  "name": "Lebanese Zaatar (Za'atar) Bread",
  "recipe_type": "appetizer",
  "brief_description": "Traditional Lebanese bread with a healthy dose of za'atar is a crisp, flaky cracker to be served alongside main and side dishes.",
  "cuisine": "Lebanese",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix water, yeast, salt, and sugar together in a large bowl. Add all-purpose flour, whole wheat flour, olive oil, and corn oil; mix using your hands, adding more whole wheat flour if needed, until dough holds together. Mix za'atar into dough until evenly incorporated (see notes)."
    },
    {
      "position": 3,
      "text": "Shape dough, about 1/4 cup per piece, into rounds on a floured work surface. Arrange rounds on baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 25 minutes."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d50c6c22-a15a-5dc8-bc51-e3ee9d8ee0c3",
  "slug": "lemon-garlic-butter-chicken-spiedini-recipe-8727930",
  "name": "Lemon Garlic Butter Chicken Spiedini",
  "recipe_type": "appetizer",
  "brief_description": "These lemon garlic butter chicken spiedini are air-fried crispy, golden breaded chicken skewers with a light lemon garlic butter drizzle.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together olive oil, wine, 2 tablespoons lemon juice, lemon zest, 1/2 of the garlic, crushed red pepper, oregano, 1 teaspoon salt, and 1/2 teaspoon pepper in a bowl. Add chicken and toss to coat. Cover and refrigerate 30 minutes to 1 hour."
    },
    {
      "position": 2,
      "text": "Stir together remaining salt and pepper with bread crumbs, panko, Parmesan cheese, and garlic powder in a shallow dish. Remove chicken from marinade and toss to coat in breadcrumb mixture, pressing to adhere as necessary. Thread chicken onto skewers and coat with olive oil cooking spray."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 390 degrees F (198 degrees C). Air fry until chicken is no longer pink at the center and juices run clear, and is until lightly golden brown and crisp, about 12 minutes. An instant read thermometer, inserted near the center, should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt butter with remaining garlic in a microwave-safe dish on High in the microwave, about 10 seconds. Stir in remaining lemon juice and parsley. Drizzle butter mixture over chicken just before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5e14f522-dc62-549d-b7f5-132db63949e3",
  "slug": "warm-broccoli-caesar-salad-recipe-8778487",
  "name": "Warm Broccoli Caesar Salad",
  "recipe_type": "salad",
  "brief_description": "This warm broccoli Caesar salad with crispy bacon, toasted panko crumbs, and a quickly blended creamy dressing made with hard-cooked eggs, is surprisingly light.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread out broccoli on a large rimmed baking sheet. Toss with 2 tablespoons of the canola oil, 3/4 teaspoon of the salt, and 1/4 teaspoon of the black pepper until evenly coated."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until broccoli is bright green and browned in spots, 18 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine 1/2 cup oil, 1/4 cup Parmesan cheese, hard-cooked eggs, lemon juice, Worcestershire sauce, garlic, Dijon mustard, 3/4 teaspoon black pepper, and 3/4 teaspoon salt in a blender; process until smooth, about 2 minutes. Refrigerate until ready to serve."
    },
    {
      "position": 5,
      "text": "Add bacon to a large skillet over medium heat and cook, stirring occasionally, until crispy, about 10 minutes. Using a slotted spoon, transfer to a paper towel-lined plate. Reserve 1 tablespoon of bacon fat in skillet and do not wipe clean; discard remaining drippings."
    },
    {
      "position": 6,
      "text": "Add panko and remaining 1/4 teaspoon black pepper to skillet over low heat; cook, stirring constantly, until golden brown, about 3 minutes. Remove from heat."
    },
    {
      "position": 7,
      "text": "Transfer broccoli to a large serving bowl. Top with panko, bacon, and remaining 1/4 cup Parmesan. Drizzle with desired amount of Caesar dressing. Refrigerate remaining Caesar dressing for up to 4 days. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

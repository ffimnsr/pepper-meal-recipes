  "id": "2e805711-3a8f-5f9c-bbb1-05abb02e91ac",
  "slug": "best-chocolate-chip-cookies",
  "name": "Best Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This classic chocolate chip cookie recipe makes deliciously buttery cookies with crisp edges, chewy middles, and gooey chocolate chips in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather your ingredients, making sure your butter is softened, and your eggs are room temperature."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Beat butter, white sugar, and brown sugar together in a large bowl with an electric mixer until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Beat in eggs, one at a time, then stir in vanilla."
    },
    {
      "position": 4,
      "text": "Dissolve baking soda in hot water; add to batter along with salt and mix until combined."
    },
    {
      "position": 5,
      "text": "Stir in flour, chocolate chips, and walnuts until a soft dough forms."
    },
    {
      "position": 6,
      "text": "Drop rounded spoonfuls of cookie dough 2 inches apart onto ungreased baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until edges are lightly browned, about 10 minutes."
    },
    {
      "position": 8,
      "text": "Cool on the baking sheets briefly before transferring to a wire rack to cool completely."
    },
    {
      "position": 9,
      "text": "Store in an airtight container or serve immediately and enjoy!"
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

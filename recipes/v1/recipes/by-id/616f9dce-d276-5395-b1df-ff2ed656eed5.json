  "id": "616f9dce-d276-5395-b1df-ff2ed656eed5",
  "slug": "apricot-leather",
  "name": "Apricot Leather",
  "recipe_type": "appetizer",
  "brief_description": "Make your own apricot fruit leather with this easy recipe. It\u2019s a great way to use fresh apricots to make a delicious snack that keeps for a long time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 150 degrees F (165 degrees C), or the lowest setting you have."
    },
    {
      "position": 2,
      "text": "Combine lemon juice, apricots, and sugar in a saucepan. Cook over medium heat until sugar has dissolved. Transfer to a blender and puree until smooth."
    },
    {
      "position": 3,
      "text": "Cover an 11x17-inch pan or cookie sheet with a layer of plastic wrap. Pour pureed fruit onto the prepared pan and spread evenly to within 1 inch of the edge."
    },
    {
      "position": 4,
      "text": "Bake for 4 to 6 hours in the preheated oven, using a spoon or a pair of tongs to keep the door slightly ajar, or until puree has dried and is no longer sticky. Once dry, you can cut it into strips; store in an airtight container."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 30,

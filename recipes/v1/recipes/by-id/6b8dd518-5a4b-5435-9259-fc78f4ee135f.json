  "id": "6b8dd518-5a4b-5435-9259-fc78f4ee135f",
  "slug": "easy-meatballs",
  "name": "Easy Meatballs",
  "recipe_type": "main",
  "brief_description": "This quick meatball recipe uses easy ingredients like egg, panko crumbs, garlic, and fresh basil. Serve plain or simmer in your favorite sauce.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk eggs, Italian seasoning, basil, salt, pepper, and garlic powder in a large bowl until combined. Add ground beef and panko; mix thoroughly."
    },
    {
      "position": 3,
      "text": "Shape beef mixture into about 40 golf ball-sized meatballs (about 1 \u00bd-inches). Arrange on ungreased, rimmed baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in centers, 10 to 15 minutes, flipping halfway through. An instant-read thermometer inserted into centers should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

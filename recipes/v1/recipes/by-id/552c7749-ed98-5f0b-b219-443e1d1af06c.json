  "id": "552c7749-ed98-5f0b-b219-443e1d1af06c",
  "slug": "tomato-mozzarella-salad",
  "name": "Tomato Mozzarella Salad",
  "recipe_type": "salad",
  "brief_description": "This tomato mozzarella salad, or caprese, is the perfect summer salad to make with creamy mozzarella, juicy tomatoes, and lots of fresh basil.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place tomato slices, alternating with mozzarella slices, on a large serving platter."
    },
    {
      "position": 3,
      "text": "Combine oil, balsamic vinegar, salt, and pepper in a jar with a tight-fitting lid; shake well."
    },
    {
      "position": 4,
      "text": "Drizzle over tomatoes and mozzarella; sprinkle with basil."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

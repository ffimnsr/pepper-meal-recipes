  "id": "b4a39717-a700-555b-b89d-1c67e5f444cc",
  "slug": "easy-danish-almond-pastries",
  "name": "Easy Danish Almond Pastries",
  "recipe_type": "dessert",
  "brief_description": "Danish pastry is time- and labor-intensive. This easy Danish almond pastries recipe is quicker and yields flaky, buttery, almond paste-filled pastries.",
  "cuisine": "American Fusion Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Unroll 1 tube crescent roll dough; spread into the bottom of the prepared pan. Seal dough seams to prevent separation."
    },
    {
      "position": 3,
      "text": "Roll almond paste to size of dough in the baking pan; trim with a knife or a pizza cutter. Set aside."
    },
    {
      "position": 4,
      "text": "Beat mascarpone, 1/2 cup white sugar, and egg yolk in a bowl with an electric mixer until well combined and smooth; spread evenly on top of dough in the pan. Place reserved almond paste on top of mascarpone layer."
    },
    {
      "position": 5,
      "text": "Unroll remaining 1 tube crescent roll dough; place on top of almond paste layer ensuring dough completely covers. Seal dough seams."
    },
    {
      "position": 6,
      "text": "Beat egg white in a bowl; brush onto dough top. Sprinkle almonds evenly over dough; sprinkle 1 tablespoon white sugar evenly over almonds."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until top is golden brown, 25 to 30 minutes. Cool."
    },
    {
      "position": 8,
      "text": "Meanwhile, whisk confectioners' sugar and water together in a bowl; drizzle over cooled Danish."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

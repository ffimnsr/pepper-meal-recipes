  "id": "aea9e79a-d2ad-569e-bad6-43eaf02a0f8b",
  "slug": "hearty-chicken-cacciatore-soup-with-rice",
  "name": "Hearty Chicken Cacciatore Soup with Rice",
  "recipe_type": "soup",
  "brief_description": "Hearty, full of flavor, and easy enough to have on the table for a weeknight supper, this tasty chicken cacciatore soup is sure to become a family-favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken broth, condensed soup, 2 cans water, diced tomatoes, and 1 tablespoon vegetable seasoning in an 8-quart stockpot over medium heat; bring to a slow, rolling boil."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add chicken, mushrooms, onion, and remaining 1 tablespoon vegetable seasoning and cook until onion is translucent and chicken is cooked through, about 7 minutes. Stir in garlic salt, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Transfer chicken mixture to the stockpot and bring to a rolling boil. Cook, stirring frequently, for 30 minutes."
    },
    {
      "position": 4,
      "text": "While the soup is cooking, bring 1 1/2 cups water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Add rice to the soup and continue to simmer, adding more water to reach desired consistency, for 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 10,

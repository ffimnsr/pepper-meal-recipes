  "id": "d6fb96c3-4bb8-5c3d-bb08-8ceb71f56ed6",
  "slug": "simple-smoked-mac-and-cheese-recipe-7507103",
  "name": "Smoked Mac and Cheese Is Perfect for All Your Summertime Barbecue Needs",
  "recipe_type": "side",
  "brief_description": "This simple smoked macaroni and cheese takes on smoke flavor quickly and complements smoked ribs, chicken, and brisket.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an electric smoker to 250 degrees F (120 degrees C), and add wood chips according to manufacturers\u2019 directions. Use any wood chips that you would use for smoking meat."
    },
    {
      "position": 2,
      "text": "If prepared macaroni and cheese is not already in a heatproof dish, spoon it into a dish that can sit directly on the rack of a smoker. Divide cheese slices over the top."
    },
    {
      "position": 3,
      "text": "Place the dish directly on the rack of the smoker, and smoke until hot and bubbly, about 1 1/2 hours. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 5,

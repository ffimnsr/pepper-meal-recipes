  "id": "71535ac3-76ac-5732-8214-a61e8216e2b6",
  "slug": "vegan-chocolate-truffles",
  "name": "Vegan Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "Customize your vegan chocolate truffles with toppings of your choice like coconut and cocoa powder in this easy recipe that is sure to impress.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese until smooth. Add confectioners' sugar gradually, beating until well blended. Add melted chocolate and vanilla extract. Chill in the refrigerator for 1 hour."
    },
    {
      "position": 2,
      "text": "Shape the chocolate mixture into 1-inch balls. Roll in cocoa powder, coconut, or almonds. Store in the refrigerator."
    }
  ],

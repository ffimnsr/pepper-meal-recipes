  "id": "8be048a1-cd86-5bd4-9a88-96eaa0f63377",
  "slug": "easy-chicken-piccata-orzo-casserole-recipe-11781735",
  "name": "This Dump-and-Bake Chicken Piccata Casserole Is Ready in Under an Hour",
  "recipe_type": "main",
  "brief_description": "This easy chicken piccata orzo casserole is a one-dish dinner with lemon-garlic chicken atop creamy orzo. It takes minutes to assemble, and is on the table in under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cream of chicken soup, broth, lemon juice, and capers in a bowl."
    },
    {
      "position": 3,
      "text": "Add uncooked orzo to a 9x13-inch baking dish. Pour chicken soup mixture over orzo and stir carefully to combine."
    },
    {
      "position": 4,
      "text": "Set chicken cutlets evenly on top of the orzo. Season with garlic, salt, and pepper. Top with Parmesan cheese, panko, butter, and lemon slices. Cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil; bake until the chicken is no longer pink at the center, juices run clear, and panko is golden brown, about 15 minutes more. An instant read thermometer inserted into the center of chicken should reach 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Garnish with fresh parsley and sliced lemons."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

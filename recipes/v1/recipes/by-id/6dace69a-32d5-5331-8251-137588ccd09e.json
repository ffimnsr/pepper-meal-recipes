  "id": "6dace69a-32d5-5331-8251-137588ccd09e",
  "slug": "pan-fried-fennel",
  "name": "Pan-Fried Fennel",
  "recipe_type": "side",
  "brief_description": "This simple fennel recipe is a quick and delicious way to cook fennel bulbs for an easy vegetable side full of flavor without much fuss.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Chop fennel greens and set aside."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a nonstick pan over medium heat. Lay some fennel slices in a single layer in the pan; cook until nicely browned on both sides, about 5 minutes. Season with salt and lemon pepper. Remove from pan. Add another tablespoon oil and layer in the next batch of fennel slices and cook the same way. Repeat with remaining oil and fennel. Serve sprinkled with fennel greens."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

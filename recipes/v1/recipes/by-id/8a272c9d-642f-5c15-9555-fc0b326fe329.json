  "schema_version": 1,
  "id": "8a272c9d-642f-5c15-9555-fc0b326fe329",
  "slug": "homemade-gluten-free-cinnamon-rolls",
  "name": "Homemade Gluten-Free Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "These gluten-free Cinnabon-like rolls taste just like the popular mall treats. You can pretend you made a special trip to the mall to buy Cinnabon rolls for your family because these homemade gluten-free cinnamon rolls taste so similar!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make dough: Combine sugar and yeast in a small bowl. Mix flour, baking powder, xanthan gum, baking soda, and salt together in a separate bowl."
    },
    {
      "position": 2,
      "text": "Place milk and butter in a microwave-safe bowl. Cook on high, stirring every 15 seconds, until 110 to 115 degrees F (43 to 46 degrees C), about 45 seconds. Whisk into yeast mixture and set aside to proof, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine proofed yeast with olive oil, egg, and vanilla extract in a large bowl; mix for a few seconds, then slowly add flour mixture. Mix with an electric mixer on medium-high speed until dough thickens and loses some of its stickiness, about 1 1/2 minutes."
    },
    {
      "position": 4,
      "text": "Cover a work surface with plastic wrap and a light layer of flour. Place dough in the center, dust with a little more flour, and cover with another sheet of plastic wrap. Roll out to a 10x13-inch rectangle; remove the top layer of plastic wrap."
    },
    {
      "position": 5,
      "text": "Make filling: Combine brown sugar and cinnamon in a small bowl. Spread melted butter over dough; sprinkle brown sugar mixture evenly over top."
    },
    {
      "position": 6,
      "text": "Starting at a long edge, roll dough up like a jelly roll, using the plastic wrap to help lift and roll as you go. Lightly sprinkle dough with more flour and cut into 10 pieces with a sharp knife. Place rolls in a greased baking dish, cover with plastic wrap, and place in a warm spot to rise for 15 minutes."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake rolls in the preheated oven until tops are golden brown, 22 to 27 minutes."
    },
    {
      "position": 9,
      "text": "Make frosting: Beat butter and cream cheese in a mixing bowl until smooth. Add powdered sugar; mix until smooth. Mix in lemon juice, vanilla extract, and salt."
    },
    {
      "position": 10,
      "text": "Remove cinnamon rolls from the oven and immediately drizzle frosting over top."
    }
  ],
  "servings": 10,

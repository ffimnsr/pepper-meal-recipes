  "slug": "tomato-corn-and-avocado-salsa",
  "name": "Tomato, Corn, and Avocado Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Fresh tomatoes, corn, and avocado combine in this colorful salsa recipe, which is seasoned with lime juice and onions. Serve with your favorite chips.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together corn, olives, tomatoes, onion, red pepper, and jalapeño pepper in a large bowl until well combined. Gently fold in avocados, olive oil, lime juice, and salt."
    }
  ],

  "id": "286480c4-d651-51c0-8d54-64fde6b733f4",
  "slug": "cozy-fish-chowder-recipe-11829889",
  "name": "Cozy Fish Chowder",
  "recipe_type": "soup",
  "brief_description": "This cozy fish chowder, creamy and indulgent but still fresh, is perfect for sharing on a chilly evening. It\u2019s like a hug in a bowl.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a pot over medium heat, and cook bacon until crisp, about 5 minutes. Remove bacon with a slotted spoon; set aside. Leave 1 to 2 teaspoons drippings in the pot."
    },
    {
      "position": 2,
      "text": "Add onion and celery to the pot; saut\u00e9 until softened, about 4 minutes. Stir in garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add potatoes, stock, and bay leaf. Bring to a boil, then reduce heat and cook at a gentle simmer until potatoes are nearly tender, 8 to 10 minutes. Stir in cream."
    },
    {
      "position": 4,
      "text": "Add the frozen mahi-mahi chunks directly into the hot chowder. Simmer uncovered until fish is opaque and flakes easily with a fork, 10 to 12 minutes."
    },
    {
      "position": 5,
      "text": "Remove bay leaf. Stir in bacon. Season with salt and pepper. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

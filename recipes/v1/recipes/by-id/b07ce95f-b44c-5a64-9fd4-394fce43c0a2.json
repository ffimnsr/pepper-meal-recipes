  "id": "b07ce95f-b44c-5a64-9fd4-394fce43c0a2",
  "slug": "tex-mex-grilled-flank-steak",
  "name": "Tex-Mex Grilled Flank Steak",
  "recipe_type": "salad",
  "brief_description": "Three ingredients is all you need for this melt in your mouth tender flank steak. This can be eaten on its own but I like to use it for tacos or grilled steak salads.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Pour all 8 packets of sazon seasoning into a gallon-sized resealable plastic bag. Add beer, seal, and shake until sazon seasoning is dissolved. Add flank steak and refrigerate 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove steak from the bag and discard marinade."
    },
    {
      "position": 3,
      "text": "Grill steak on the hot grill for about 6 minutes on each side for medium or until desired doneness. Remove steak from gill and let rest 10 minutes. Slice against the grain."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 5,

  "id": "0b7921c5-3498-5348-ae82-c96c561c0689",
  "slug": "northern-italian-beef-stew",
  "name": "Northern Italian Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This hearty beef stew packed with vegetables and herbs is a family favorite.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook beef in batches in hot oil until browned completely, about 5 minutes per batch. Remove browned beef cubes to a plate lined with paper towels, keeping skillet over heat and retaining the beef drippings."
    },
    {
      "position": 2,
      "text": "Cook and stir onion, celery, and carrots in the retained beef drippings until just softened, 2 to 3 minutes. Stir mushrooms and garlic into the onion mixture."
    },
    {
      "position": 3,
      "text": "Pour red wine into the pan; bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Continue cooking the mixture until the wine evaporates, 7 to 10 minutes. Stir tomatoes into the mixture."
    },
    {
      "position": 4,
      "text": "Return beef to skillet with potatoes, basil, thyme, marjoram, and sage. Pour beef stock and tomato sauce over the mixture. Bring the liquid to a simmer."
    },
    {
      "position": 5,
      "text": "Reduce heat to low and simmer until the beef is very tender and the sauce is thick, 4 to 6 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 260,
  "preparation_time_minutes": 30,

  "id": "9cb35bc2-eab1-59fc-851d-2419f1077256",
  "slug": "classic-spanish-sangria",
  "name": "Classic Spanish Sangria",
  "recipe_type": "dessert",
  "brief_description": "This fruity sangria makes a tangy-sweet cocktail. Add different fruits to make it season-specific, like apples or pears for fall or berries for summer.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Refrigerate orange, lemon, lime, wine, rum, and orange juice until cold."
    },
    {
      "position": 2,
      "text": "Slice orange, lemon, and lime into thin rounds. Place in a large glass pitcher. Add rum and sugar. Refrigerate to allow flavors to blend, about 2 hours."
    },
    {
      "position": 3,
      "text": "Crush fruit lightly with a wooden spoon. Stir in wine and orange juice. Adjust sweetness as desired."
    }
  ],
  "servings": 6,

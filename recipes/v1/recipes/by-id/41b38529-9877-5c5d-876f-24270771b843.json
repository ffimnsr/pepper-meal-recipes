  "id": "41b38529-9877-5c5d-876f-24270771b843",
  "slug": "roscoes-korean-fried-chicken-recipe-8707371",
  "name": "Roscoe's Korean Fried Chicken",
  "recipe_type": "appetizer",
  "brief_description": "This Korean fried chicken is coated in a thin batter, dredged, and then fried twice, and served with a spicy ginger, garlic, and gochujang sauce.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place a wire rack inside a rimmed baking sheet. In a large bowl toss chicken wings, chicken legs, ginger, garlic, salt, pepper, and water together. Mix well."
    },
    {
      "position": 2,
      "text": "In another bowl combine flour, potato starch, cornstarch, and EverCrisp in a large mixing bowl. Whisk ingredients until fully mixed. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Add 1 cup of flour mixture to the bowl with chicken. Mix into chicken and water to make a very thin batter."
    },
    {
      "position": 4,
      "text": "Add chicken to the flour bowl and toss and press until completely dredged in mixture. Place on the prepared wire rack until ready to fry."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep fryer or large saucepan to 325 degrees F (165 degrees C). Line a second rimmed baking sheet with paper towels, and place a clean wire rack on top."
    },
    {
      "position": 6,
      "text": "Add chicken pieces to the hot oil about 5 pieces at a time so as not to drop the temperature of the oil. Fry for 6 minutes. Transfer chicken to the rack over the paper towel-lined baking sheet tray. Continue with remaining chicken pieces."
    },
    {
      "position": 7,
      "text": "Increase oil temperature to 350 degrees F (175 degrees C) until continuously boiling. Carefully add the first batch of cooked chicken and fry again until cooked through and crispy, about 5 minutes more. Transfer to a plate lined with paper towels to drain. Repeat with the second batch of chicken pieces."
    },
    {
      "position": 8,
      "text": "Transfer chicken to a medium-sized serving bowl. Heat a small saucepan over medium-low heat. Add sesame oil, grated garlic, grated ginger, brown sugar, gochujang paste, vinegar, and 1/2 cup water. Cook and stir continuously until sugar has melted and sauce is smooth, about 5 minutes. Drizzle sauce over twice-fried chicken pieces, garnish with sesame seed and peanuts, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

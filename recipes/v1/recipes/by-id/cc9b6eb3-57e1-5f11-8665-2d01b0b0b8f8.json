  "id": "cc9b6eb3-57e1-5f11-8665-2d01b0b0b8f8",
  "slug": "texas-teriyaki-marinade",
  "name": "Texas Teriyaki Marinade",
  "recipe_type": "side",
  "brief_description": "Marinade for wood smoking bird, beef or pork in an indirect heat smoker. Full wood smoke or partial wood and charcoal. This is especially good for beef brisket.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix together the brown sugar, teriyaki sauce, Worcestershire sauce, liquid smoke and meat tenderizer. Pour over meat, and refrigerate in a sealed container. Shake container occasionally to cover meat. Take out of the refrigerator before cooking, and let come to room temperature while the smoker heats up. Never use barbeque sauce with this marinade."
    }
  ],

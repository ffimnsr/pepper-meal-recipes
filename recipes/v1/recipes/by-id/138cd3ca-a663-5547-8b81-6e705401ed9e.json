  "id": "138cd3ca-a663-5547-8b81-6e705401ed9e",
  "slug": "vegan-red-lentil-soup",
  "name": "Vegan Red Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "A bowl of this vegan red lentil soup with is the perfect choice for lunch or a light dinner. It's creamy and delicious with coconut milk and spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Add onion, ginger, garlic, and fenugreek; cook and stir until onion is tender."
    },
    {
      "position": 2,
      "text": "Add lentils, squash, and cilantro, then stir in water, coconut milk, and tomato paste. Season with curry powder, cayenne pepper, nutmeg, salt, and pepper; bring to a boil. Reduce the heat to low and simmer for 30 minutes, or until lentils and squash are tender."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,

  "schema_version": 1,
  "id": "fb64453c-cba0-5be7-a54f-8cc350c7beeb",
  "slug": "20-minute-sausage-broccoli-gnocchi-alfredo",
  "name": "20-Minute Sausage-Broccoli Gnocchi Alfredo",
  "recipe_type": "main",
  "brief_description": "This hearty Alfredo gnocchi recipe with Italian sausage and broccoli relies on common freezer and pantry items to deliver a meal in under 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place broccoli into a microwave-safe dish and microwave for 7 minutes."
    },
    {
      "position": 2,
      "text": "While the broccoli is cooking, bring a large pot of lightly salted water to a boil over high heat."
    },
    {
      "position": 3,
      "text": "At the same time, heat a large, deep skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned, crumbly, and almost crunchy, about 10 minutes, scraping the bottom of the pan to incorporate any browned pieces using a metal spatula."
    },
    {
      "position": 4,
      "text": "Add gnocchi to the boiling water and cook until they float to the top, 2 to 4 minutes."
    },
    {
      "position": 5,
      "text": "While the gnocchi cooks, add butter, garlic, and Italian seasoning to the sausage in the skillet. Reduce the heat to medium; cook and stir for 1 minute. Stir in Alfredo sauce. Pour water into the sauce jar, shake, and pour into the skillet. Add Parmesan cheese. Stir in cooked broccoli and season with pepper."
    },
    {
      "position": 6,
      "text": "Scoop cooked gnocchi out of the cooking water and add to the skillet. Stir to combine with sausage and broccoli."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

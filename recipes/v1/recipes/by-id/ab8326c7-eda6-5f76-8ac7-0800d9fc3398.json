  "id": "ab8326c7-eda6-5f76-8ac7-0800d9fc3398",
  "slug": "spicy-mango-guacamole",
  "name": "Spicy Mango Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "Add a sweet and spicy kick to classic guacamole with the addition of fresh mango and chopped jalapeno peppers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocados, lime juice, and salt lightly together in a bowl, so some avocado chunks remain. Mix in mango, onion, cilantro, and jalapeno peppers."
    },
    {
      "position": 2,
      "text": "Refrigerate guacamole for about 1 hour. Drizzle hot sauce on top before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

  "id": "d4833e74-2fa5-51cc-8e06-df2598f18b7f",
  "slug": "sues-minestrone",
  "name": "Sue's Minestrone",
  "recipe_type": "soup",
  "brief_description": "Browned ground turkey and crisp-cooked bacon are combined with Italian-style mixed vegetables, beef consomme, dried pasta, and a can of bean and bacon soup in this dish seasoned with oregano and basil.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over high heat, combine the meat, bacon, consomme, soup, water, tomato sauce, basil and oregano. Bring to a boil and reduce heat to low. Cover and simmer for 10 minutes."
    },
    {
      "position": 2,
      "text": "Add the vegetables and simmer for another 20 to 30 minutes. Add the egg noodles and simmer uncovered for another 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

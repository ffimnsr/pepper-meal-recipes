  "id": "547a6f69-2eb6-5d86-83cc-44833edf5856",
  "slug": "kalamata-olive-tapenade",
  "name": "Kalamata Olive Tapenade",
  "recipe_type": "appetizer",
  "brief_description": "This olive tapenade made with garlic, Kalamata olives, parsley, capers, olive oil, and lemon juice is a deliciously zippy, briny crostini spread.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place garlic cloves into a blender or food processor; pulse to mince."
    },
    {
      "position": 3,
      "text": "Add olives, parsley, capers, lemon juice, and olive oil. Pulse until finely chopped and combined."
    },
    {
      "position": 4,
      "text": "Season with salt and pepper. Transfer tapenade to a serving bowl. Serve immediately, or refrigerate in an airtight container for up to 1 week."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

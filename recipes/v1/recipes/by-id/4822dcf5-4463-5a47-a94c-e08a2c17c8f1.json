  "id": "4822dcf5-4463-5a47-a94c-e08a2c17c8f1",
  "slug": "peanut-butter-kiss-cookies",
  "name": "Peanut Butter Kiss Cookies",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter kiss cookies recipe is topped with a Hershey Kiss to make classic peanut butter blossoms\u2014perfect for cookie swaps at holiday time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir sugar, peanut butter, and egg together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Shape dough into 1-inch balls. If dough is too sticky, refrigerate until easy to handle, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Place dough balls on an ungreased cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are set and tops are slightly cracked, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Press a chocolate kiss into center of each warm cookie. Remove to a wire rack to cool."
    }
  ],
  "servings": 18,

  "id": "8f7d0f3e-a3c3-574b-8d56-5790ddc4a34a",
  "slug": "cavatappi-pasta-salad-with-tuna-and-olives",
  "name": "Cavatappi Pasta Salad with Tuna and Olives",
  "recipe_type": "salad",
  "brief_description": "Served at room temperature or chilled, this delicious cavatappi pasta salad with tuna and black olives is perfect for picnics and potlucks.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add cavatappi and cook, stirring occasionally, until tender yet firm to the bite, 9 to 10 minutes. Drain and run under cold water until no longer hot. Drain again and transfer to a big bowl."
    },
    {
      "position": 2,
      "text": "Add mayonnaise, tuna, olives, celery, onion, salt, and pepper to the pasta; toss until fully combined. Serve immediately or chill in the refrigerator until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

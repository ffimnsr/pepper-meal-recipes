  "id": "b2461e5d-0854-5f3e-84a5-36892bd6fdd1",
  "slug": "bbq-meatballs-recipe-11749973",
  "name": "BBQ Meatballs",
  "recipe_type": "main",
  "brief_description": "Sheet pan-baked BBQ meatballs are bursting with all the goodness of the grill. Smoky and tangy, they are perfect on a sub sandwich or just for eating on their own.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Add ground beef, egg, tortilla chips, ketchup, brown sugar, smoked paprika, garlic powder, onion powder, cayenne, oregano, salt, and black pepper to a large bowl. Mix together gently with your hands until evenly combined. Roll mixture into balls, about the size of a golf ball. Place meatballs on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 12 minutes. Remove from the oven and baste with BBQ sauce. Return to the oven and bake about 12 more minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Serve as desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

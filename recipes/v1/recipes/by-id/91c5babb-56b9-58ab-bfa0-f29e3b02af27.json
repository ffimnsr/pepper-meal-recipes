  "id": "91c5babb-56b9-58ab-bfa0-f29e3b02af27",
  "slug": "kahlua-sweet-potatoes",
  "name": "Kahlua Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "Sweet potatoes are given a fresh twist with the addition of coffee-flavored liqueur that's sure to brighten up your Thanksgiving table.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread yams into a casserole dish. Pour milk over yams and sprinkle with brown sugar. Dot yams with butter pieces. Pour coffee-flavored liqueur over the top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until heated through and bubbling, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

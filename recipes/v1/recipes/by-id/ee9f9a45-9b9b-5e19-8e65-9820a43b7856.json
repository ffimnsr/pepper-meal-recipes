  "id": "ee9f9a45-9b9b-5e19-8e65-9820a43b7856",
  "slug": "vegan-say-what-gumbo",
  "name": "Vegan (Say What?!) Gumbo",
  "recipe_type": "soup",
  "brief_description": "With all the classic flavors of a traditional gumbo, this vegan version gets it's meaty texture from red beans and eggplant.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon canola oil in a skillet over medium high heat."
    },
    {
      "position": 2,
      "text": "Stir in the onion, bell peppers, celery, and garlic; cook and stir until the onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Transfer the vegetable mixture to a large bowl; set aside."
    },
    {
      "position": 4,
      "text": "Heat the remaining 1/3 cup canola oil in the same skillet over medium heat for about 30 seconds."
    },
    {
      "position": 5,
      "text": "Whisk in the flour, stirring constantly until the roux darkens and has a nutty scent, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Reduce heat to low and pour in about one cup of vegetable broth, whisking constantly until the mixture is smooth."
    },
    {
      "position": 7,
      "text": "Stir in the vegetable mixture and tomatoes."
    },
    {
      "position": 8,
      "text": "Pour in about one more cup of vegetable broth, stirring to combine."
    },
    {
      "position": 9,
      "text": "Mix in the eggplant, okra, red beans, salt, thyme, basil, file powder, cayenne pepper, black pepper, paprika, cumin, liquid smoke, bay leaves, and remaining 4 cups of broth."
    },
    {
      "position": 10,
      "text": "Cover and continue to simmer for 1 1/2 hours, stirring occasionally."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "2086900a-6506-5356-9717-c58964fc40a7",
  "slug": "chicken-leg-toast",
  "name": "Chicken Leg Toast",
  "recipe_type": "breakfast",
  "brief_description": "Think savory French toast soaked in an eggy batter and topped with a whole chicken leg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken drumsticks, carrots, onions, celery, and broth in a saucepan. Bring to a simmer over high heat. Reduce heat to medium-low, cover, and simmer for 20 minutes. Turn drumsticks over, cover, and cook for another 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove chicken and transfer to a plate. Allow to cool, wrap, and transfer into the refrigerator until needed."
    },
    {
      "position": 3,
      "text": "Turn heat to medium-high and reduce cooking liquids in the saucepan to about 1/3 cup. Strain liquid into a mixing bowl, pressing some of the cooked vegetables through the sieve. Season gravy with black pepper, salt, thyme leaves, lemon zest, and cayenne; add creme fraiche and eggs and whisk everything together until a smooth batter forms."
    },
    {
      "position": 4,
      "text": "Place bread in a shallow baking dish just large enough to fit the slices, and pour over the batter. Toss several times, wrap and place in the fridge for 1 hour or until almost all the batter is absorbed."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with foil and lightly grease with butter."
    },
    {
      "position": 6,
      "text": "Melt butter in a small skillet over medium heat and brown bread for a few minutes per side. Transfer bread onto the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Press one drumstick into the top of each slice of bread. Brush over any excess batter. Sprinkle with salt, dust with Parmesan cheese, and finish with a shake of cayenne."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until nicely browned, 30 to 35 minutes."
    },
    {
      "position": 9,
      "text": "Mix together maple syrup, Sriracha hot sauce, and cayenne pepper in a little bowl (\"dragon syrup\")."
    },
    {
      "position": 10,
      "text": "Serve chicken leg toast drizzled with dragon syrup."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

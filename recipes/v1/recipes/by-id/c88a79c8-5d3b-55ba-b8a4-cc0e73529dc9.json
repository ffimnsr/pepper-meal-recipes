{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c88a79c8-5d3b-55ba-b8a4-cc0e73529dc9",
  "slug": "risotto-con-radicchio-gorgonzola-noci-e-crema-di-balsamico",
  "name": "Risotto Con Radicchio, Gorgonzola, Noci, e Crema di Balsamico",
  "recipe_type": "main",
  "brief_description": "This creamy risotto with radicchio, Gorgonzola cheese, and walnuts is a traditional Italian dish topped with balsamic glaze and Parmigiano.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring vegetable stock to a boil in a saucepan; reduce heat to low and keep simmering."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons olive oil in a stockpot over medium heat; cook and stir carrot, celery, and onion until onion is translucent, about 2 minutes. Add remaining 2 tablespoons olive oil; stir in rice. Cook and stir until rice is coated with oil and warm, 1 to 2 minutes. Pour in red wine and stir until rice is coated and wine is absorbed, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Pour 1 ladleful of warm vegetable stock into the rice mixture; cook, stirring continuously, until stock is absorbed, 2 to 3 minutes. Continue adding stock, 1 ladleful at a time, cooking and stirring after each addition until liquid is absorbed and risotto is easily broken when chewed, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir radicchio, Gorgonzola cheese, and walnuts into risotto until cheese is completely melted, 2 to 3 minutes. Add more stock and cook until risotto is tender yet firm to the bite, about 5 minutes more. Remove from heat and cover stockpot for 1 minute."
    },
    {
      "position": 5,
      "text": "Spoon risotto onto plates and top with balsamic glaze and Parmigiano-Reggiano."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 32,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

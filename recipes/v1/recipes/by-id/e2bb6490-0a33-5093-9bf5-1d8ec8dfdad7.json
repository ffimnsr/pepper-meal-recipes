  "id": "e2bb6490-0a33-5093-9bf5-1d8ec8dfdad7",
  "slug": "3bc-best-baked-bean-casserole",
  "name": "3BC (Best Baked Bean Casserole)",
  "recipe_type": "dessert",
  "brief_description": "Once you taste these easy, smokey-sweet baked beans, you\u2019ll want them at every cookout or holiday meal. These beans are delicious with just about anything!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over low heat. Add onion and cook until soft and translucent, 10 to 15 minutes. Transfer to a 2-quart casserole dish and set aside. Cook bacon in the same skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon on a paper towel-lined plate. Cut bacon into bite-sized pieces and set aside."
    },
    {
      "position": 3,
      "text": "Combine baked beans, ketchup, Worcestershire sauce, and mustard in the casserole dish. Stir in 2/3 cooked bacon and 1/4 brown sugar until mixture is combined. Top bean mixture with remaining bacon and sprinkle with remaining brown sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until hot and bubbly, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

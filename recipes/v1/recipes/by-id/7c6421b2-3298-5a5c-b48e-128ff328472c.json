  "id": "7c6421b2-3298-5a5c-b48e-128ff328472c",
  "slug": "beef-empanadas-with-olives-and-raisins",
  "name": "Beef Empanadas with Olives and Raisins",
  "recipe_type": "appetizer",
  "brief_description": "A sweet and savory mix of eggs, olives, and raisins star in this multi-generational recipe for baked beef empanadas.",
  "cuisine": "Argentine Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium-high heat. Saute onion and garlic in the hot oil until soft, about 5 minutes. Add ground beef, paprika, salt, and pepper; cook and stir until browned and crumbly, 5 to 7 minutes. Transfer mixture to a mixing bowl."
    },
    {
      "position": 3,
      "text": "Mix hard-boiled eggs, olives, raisins, and parsley into the meat mixture."
    },
    {
      "position": 4,
      "text": "Using a spoon or your fingers, take a little of the ground beef mixture and place it in the middle of the dough discs. Fold the disc over and crimp the edges on both sides with the fork, leaving an indentation in the dough. Coat the outsides of the empanadas with egg yolk using a brush and place on a flat baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the shells are somewhat browned, 24 to 28 minutes. Let cool for at least 15 minutes before enjoying."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

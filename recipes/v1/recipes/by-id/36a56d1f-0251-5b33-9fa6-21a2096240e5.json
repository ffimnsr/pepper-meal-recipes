  "id": "36a56d1f-0251-5b33-9fa6-21a2096240e5",
  "slug": "mrs-fields-sugar-cookies",
  "name": "Mrs. Fields Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "Just like Mrs. Field's sugar cookies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl combine the flour and salt with a wire whisk. In a large mixing bowl cream the butter and sugar with an electric mixer on medium speed. Add the egg and vanilla, and beat until well blended. Scrape down sides of bowl, then add the flour mixture. Blend on low speed just until combined. Do not overmix."
    },
    {
      "position": 3,
      "text": "Gather dough into a ball. Flatten the ball into a disk and wrap tightly in plastic wrap or a plastic bag. Refrigerate one hour until firm."
    },
    {
      "position": 4,
      "text": "On a floured surface, roll out dough to a 1/4 inch thickness. With cookie cutters, cut dough into desired shapes and place on ungreased cookie sheets. Decorate with colored sugars or sprinkles. Bake for 13-15 minutes, being careful not to brown. Immediately transfer cookies with a spatula to a cool, flat surface."
    }
  ],
  "servings": 18,

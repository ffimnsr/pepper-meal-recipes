  "id": "e86cf9a0-1f57-5fbc-b5af-afa43a3cc117",
  "slug": "candy-cane-fudge",
  "name": "Candy Cane Fudge",
  "recipe_type": "dessert",
  "brief_description": "This easy peppermint fudge recipe is made with vanilla chips, condensed milk, peppermint extract, and crushed candy canes. Guaranteed to disappear quickly!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8-inch square baking pan with aluminum foil; spray with nonstick spray and set aside."
    },
    {
      "position": 2,
      "text": "Combine vanilla chips and sweetened condensed milk in a saucepan over medium heat. Stir frequently until chips are almost melted; remove from heat and continue to stir until smooth. Stir in candy canes, peppermint extract, and food coloring."
    },
    {
      "position": 3,
      "text": "Spread evenly in the bottom of the prepared pan. Chill for 2 hours, then cut into squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

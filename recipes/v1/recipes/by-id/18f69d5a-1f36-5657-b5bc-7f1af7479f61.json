  "id": "18f69d5a-1f36-5657-b5bc-7f1af7479f61",
  "slug": "honey-mustard-spaghetti-recipe-8760484",
  "name": "Honey Mustard Spaghetti",
  "recipe_type": "dessert",
  "brief_description": "Sweet-salty, rich honey mustard spaghetti simmers pasta and chicken in a honey mustard cream. The dish is finished with crisp bacon and a sprinkling of green onion..",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together mustard and honey in a small bowl and set aside. Meanwhile, bring a large pot of salted water to a boil. Cook pasta until tender with a bite, about 9 minutes, or according to package instructions. Reserve 1/2 cup pasta water, drain, and set aside."
    },
    {
      "position": 2,
      "text": "While pasta cooks, heat a large deep skillet over medium heat. Add bacon and cook until crisp, about 5 minutes. Remove bacon from skillet to a paper towel-lined plate and reserve drippings in the skillet."
    },
    {
      "position": 3,
      "text": "Add chicken to the hot skillet; cook until browned on all sides (chicken will not be fully cooked through at this point). Remove chicken from skillet and keep warm. Add light green parts of the onions to skillet and cook until tender, 1 to 2 minutes. Stir in honey mustard and heavy cream."
    },
    {
      "position": 4,
      "text": "Return chicken to skillet and add salt and pepper. Bring to a simmer and cook, stirring occasionally, until slightly thickened and chicken is no longer pink at the center. Add pasta and reserved pasta water to skillet and cook until heated through. Crumble reserved bacon over the top, and sprinkle with green onions to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

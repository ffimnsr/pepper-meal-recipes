  "id": "a1c055e0-fec2-5536-9cc2-2449272407f9",
  "slug": "tuna-tostadas",
  "name": "Tuna and Avocado Tostadas",
  "recipe_type": "salad",
  "brief_description": "For a twist on tuna salad, this combines the tuna we love with salsa and fresh flavors spread over crispy tostadas for a quick and easy meal.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix tuna, mayonnaise, and salsa together in a bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil over medium-high heat in a frying pan. Add tortillas in batches and fry until golden and slightly crisp, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Spread tuna mixture over tortillas evenly. Top with tomato, spinach, and onions. Sprinkle with Cheddar cheese and top with avocado slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

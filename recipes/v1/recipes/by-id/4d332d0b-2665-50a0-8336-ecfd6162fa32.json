  "id": "4d332d0b-2665-50a0-8336-ecfd6162fa32",
  "slug": "air-fried-cinnamon-and-sugar-doughnuts",
  "name": "Air-Fried Cinnamon and Sugar Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "An air fryer makes healthier donuts with less oil; these use a rich sour cream dough and are lightly brushed with butter and cinnamon sugar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Press 1/2 cup white sugar and butter together in a bowl until crumbly. Add egg yolks and stir until well combined."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt into a separate bowl. Place 1/3 of the flour mixture and 1/2 the sour cream into the sugar-egg mixture; stir until combined. Mix in the remaining flour and sour cream. Refrigerate dough until ready to use."
    },
    {
      "position": 3,
      "text": "Mix 1/3 cup sugar and cinnamon together in a bowl."
    },
    {
      "position": 4,
      "text": "Roll dough out onto a lightly floured work surface to 1/2-inch thick. Cut 9 large circles in the dough; cut a small circle out of the center of each large circle to create doughnut shapes."
    },
    {
      "position": 5,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Brush 1/2 of the melted butter over both sides of the doughnuts."
    },
    {
      "position": 7,
      "text": "Place 1/2 doughnuts into the basket of the air fryer; cook for 8 minutes. Paint cooked donuts with the remaining melted butter and immediately dip into the cinnamon-sugar mixture. Repeat with the remaining doughnuts."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "6d5ede5d-4616-5200-b02b-befa49dec1e6",
  "slug": "easy-zucchini-mushroom-skillet-recipe-8753947",
  "name": "Easy Zucchini Mushroom Skillet",
  "recipe_type": "side",
  "brief_description": "Try this easy zucchini mushroom skillet, full of colorful and tasty vegetables, for a quick vegetarian dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet, heat olive oil and butter over medium-high heat, until butter is melted and bubbling."
    },
    {
      "position": 2,
      "text": "Add onions, mushrooms, and bell peppers; season lightly with salt and pepper. Cook, stirring often, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Add zucchini, garlic, and Italian seasoning, and stir to combine. Cook about 4 minutes, stirring often. Continue to cook and stir until vegetables are as tender as you like, a total of 5 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat and sprinkle with grated Parmesan cheese. Garnish with fresh parsley sprigs. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

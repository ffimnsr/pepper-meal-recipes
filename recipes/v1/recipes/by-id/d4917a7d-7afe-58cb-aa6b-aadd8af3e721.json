  "id": "d4917a7d-7afe-58cb-aa6b-aadd8af3e721",
  "slug": "crispy-rice-sushi-bites-recipe-11878300",
  "name": "Crispy Rice Sushi Bites",
  "recipe_type": "appetizer",
  "brief_description": "Try these crispy rice sushi bites topped with spicy salmon and avocado. The air fryer crisps up leftover rice perfectly.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cooked rice with rice vinegar, honey, and salt. Line a rectangular dish with plastic wrap and spoon rice into the dish. Flatten with a spatula and pat down tightly. Cover with plastic wrap and freeze for at least 30 minutes (the longer the better)."
    },
    {
      "position": 2,
      "text": "For the spicy salmon, combine canned salmon, ponzu, sesame oil, Japanese mayonnaise, Sriracha, and fresh chopped green onions in a bowl; mix until well combined. Refrigerate to marinade until ready to use."
    },
    {
      "position": 3,
      "text": "Cut frozen rice into bite sized squares. Brush generously with avocado oil and place int the air fryer."
    },
    {
      "position": 4,
      "text": "Air fry at 400 degrees F (200 degrees C) until rice is very crisp, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Transfer air fried crispy rice onto a wire rack and allow to cool slightly."
    },
    {
      "position": 6,
      "text": "Top each crispy rice square with 2 slices of avocado and a few spoonfuls of spicy salmon mixture."
    },
    {
      "position": 7,
      "text": "Drizzle with unagi sauce and sprinkle with chopped green onions and furikake. Enjoy right away!"
    }
  ],
  "servings": null,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

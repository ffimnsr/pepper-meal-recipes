  "id": "4404e60f-2706-58d5-9b6a-e5094c3d76d8",
  "slug": "lactation-cookies",
  "name": "Lactation Cookies",
  "recipe_type": "dessert",
  "brief_description": "These delicious lactation cookies feature brewer's yeast, wheat germ, flax seeds, and oats to help support milk production for breastfeeding mothers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flaxseed meal with water in a small bowl and let soak for 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat butter, white sugar, and brown sugar together in a large mixing bowl until creamy. Add egg yolks and vanilla extract; beat to incorporate. Stir in flaxseed mixture."
    },
    {
      "position": 4,
      "text": "Mix flour, brewer's yeast, wheat germ, baking soda, salt, and cream of tartar, in a separate bowl."
    },
    {
      "position": 5,
      "text": "Add dry ingredients to the wet ingredients and stir until just combined. Fold in oats and chocolate chips."
    },
    {
      "position": 6,
      "text": "Roll dough into walnut-sized balls and place 2 inches apart onto a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the edges are golden, 10 to 12 minutes. Allow cookies to cool on the baking sheet for 1 minute before removing to a wire rack to cool completely."
    },
    {
      "position": 8,
      "text": "Once cool, serve and enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

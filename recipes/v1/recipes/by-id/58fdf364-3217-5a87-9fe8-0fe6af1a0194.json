  "id": "58fdf364-3217-5a87-9fe8-0fe6af1a0194",
  "slug": "fried-potato-wedges",
  "name": "Fried Potato Wedges",
  "recipe_type": "side",
  "brief_description": "Irresistible fried potato wedges. Before they're fried, these sliced russet potatoes are dredged with flour and seasoning to seal in the flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice potatoes into 16 wedges."
    },
    {
      "position": 3,
      "text": "Combine flour, chili powder, chicken bouillon, paprika, black pepper, and cayenne in a 1-gallon resealable plastic bag."
    },
    {
      "position": 4,
      "text": "Dip potato wedges in milk, then shake them in the flour mixture. Fry in the hot oil until golden brown, 5 to 6 minutes per batch. Let drain on paper towels."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

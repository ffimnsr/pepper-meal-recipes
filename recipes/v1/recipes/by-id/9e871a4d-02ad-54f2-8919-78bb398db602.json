  "id": "9e871a4d-02ad-54f2-8919-78bb398db602",
  "slug": "beef-jerky-in-a-smoker",
  "name": "Smoked Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "Learn how to make beef jerky in a smoker with this easy recipe that features marinated sliced sirloin dried slowly for a chewy, spicy, and savory snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, black pepper, vinegar, hot pepper sauce, and Worcestershire sauce in a large, nonporous bowl; add sirloin slices and mix well to coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Arrange sirloin slices, unstacked, onto wire racks; discard marinade. Place the racks into an outdoor smoker. Add wood chips according to manufacturer's directions."
    },
    {
      "position": 3,
      "text": "Smoke over low heat until edges of sirloin slices appear dry with just a slight hint of moisture in the center, 6 to 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

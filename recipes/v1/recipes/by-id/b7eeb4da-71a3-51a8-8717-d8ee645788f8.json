  "id": "b7eeb4da-71a3-51a8-8717-d8ee645788f8",
  "slug": "edible-cookie-dough",
  "name": "Edible Cookie Dough",
  "recipe_type": "dessert",
  "brief_description": "This edible cookie dough recipe is egg-free and easy to make. Stash any leftovers in your freezer for an emergency sweet treat with or without baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "To heat-treat your flour so it is safe to use: Place flour in a microwave-safe dish and cook for 1 minute and 15 seconds, stirring it every 15 seconds. Set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter with an electric mixer in a large bowl until creamy."
    },
    {
      "position": 4,
      "text": "Beat in vanilla extract and salt. Add heat-treated flour; mix until a crumbly dough forms."
    },
    {
      "position": 5,
      "text": "Stir in milk until dough is just combined; fold in milk chocolate chips and mini chocolate chips."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

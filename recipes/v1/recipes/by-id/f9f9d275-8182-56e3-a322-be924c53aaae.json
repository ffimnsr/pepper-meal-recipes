  "id": "f9f9d275-8182-56e3-a322-be924c53aaae",
  "slug": "creamy-gochujang-tortellini",
  "name": "Creamy Gochujang Tortellini",
  "recipe_type": "main",
  "brief_description": "Miso paste, gochujang, and cream are turned into a delicious cream sauce paired with tortellini - ultimate fusion comfort food.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat; stir in tortellini (in batches if necessary) and return to a boil. Cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Scoop tortellini into a bowl with a slotted spoon. Drain water, reserving 1 cup of pasta water."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in the same pot over medium heat. Add minced garlic and saut\u00e9 until fragrant, 30 to 45 seconds. Stir in miso, cream, and pasta water. Whisk continuously until miso dissolves. Add 1 tablespoon gochujang sauce and stir to combine."
    },
    {
      "position": 4,
      "text": "Add tortellini and Parmesan cheese, stirring briskly until cheese is blended in and sauce is smooth."
    },
    {
      "position": 5,
      "text": "Garnish each serving with a bit of remaining gochujang sauce"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

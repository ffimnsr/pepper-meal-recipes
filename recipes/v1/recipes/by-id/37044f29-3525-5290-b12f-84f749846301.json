  "id": "37044f29-3525-5290-b12f-84f749846301",
  "slug": "moms-peach-crisp",
  "name": "Mom\u2019s Peach Crisp",
  "recipe_type": "dessert",
  "brief_description": "This peach crisp recipe features a layer of sweet and juicy fresh peaches with a crunchy brown sugar and oat topping for a sensational summer dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange sliced peaches evenly in an 8x8-inch baking dish."
    },
    {
      "position": 3,
      "text": "Mix flour, brown sugar, butter, cinnamon, and salt in a bowl using a pastry cutter until crumbly."
    },
    {
      "position": 4,
      "text": "Fold oats into flour mixture."
    },
    {
      "position": 5,
      "text": "Sprinkle mixture evenly over peaches, pressing down lightly."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crispy and golden brown on top, about 30 minutes. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

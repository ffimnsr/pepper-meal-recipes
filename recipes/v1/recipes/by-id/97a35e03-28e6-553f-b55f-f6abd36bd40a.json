  "id": "97a35e03-28e6-553f-b55f-f6abd36bd40a",
  "slug": "asian-beef-with-snow-peas",
  "name": "Asian Beef with Snow Peas",
  "recipe_type": "main",
  "brief_description": "Stir-fried beef with snow peas in a light gingery sauce.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, rice wine, brown sugar, and cornstarch in a small bowl until smooth; set aside."
    },
    {
      "position": 2,
      "text": "Heat oil in a wok or skillet over medium-high heat. Stir-fry ginger and garlic until fragrant, about 30 seconds. Add steak and stir-fry until evenly browned, about 2 minutes. Stir in snow peas and cook until crisp-tender, about 3 minutes. Pour in soy sauce mixture and bring to a boil, stirring constantly. Reduce heat to medium-low and simmer until sauce is thickened and smooth. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

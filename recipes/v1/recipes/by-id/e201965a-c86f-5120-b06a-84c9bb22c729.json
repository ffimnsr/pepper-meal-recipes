  "id": "e201965a-c86f-5120-b06a-84c9bb22c729",
  "slug": "giant-chocolate-chip-cookie",
  "name": "Giant Chocolate Chip Cookie",
  "recipe_type": "dessert",
  "brief_description": "This giant cookie cake recipe features chocolate chip cookie dough baked in a large pizza pan for a kid-friendly dessert the whole family will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 14-inch round pizza pan."
    },
    {
      "position": 3,
      "text": "Beat butter, white sugar, brown sugar, and vanilla in a large bowl with an electric mixer on medium speed until light and fluffy."
    },
    {
      "position": 4,
      "text": "Beat in eggs, one at a time, mixing well after each addition."
    },
    {
      "position": 5,
      "text": "Gradually add flour, salt, and baking soda, beating until well blended."
    },
    {
      "position": 6,
      "text": "Stir in chocolate chips and nuts."
    },
    {
      "position": 7,
      "text": "Spread dough evenly into the prepared pan."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Cool cookie in the pan on a cooling rack. Decorate as desired."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

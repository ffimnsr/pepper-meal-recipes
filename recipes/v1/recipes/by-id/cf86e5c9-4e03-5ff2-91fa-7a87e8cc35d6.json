  "slug": "peanut-butter-protein-balls",
  "name": "Peanut Butter Protein Balls",
  "recipe_type": "appetizer",
  "brief_description": "These no-bake protein balls are mixed up and rolled in minutes, providing tons of wholesome, sweet flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, peanut butter, oats, chocolate chips, protein powder, and cinnamon in a medium mixing bowl and mix."
    },
    {
      "position": 2,
      "text": "Scoop and shape into balls using a spoon. Place into a freezer bag and store in the freezer."
    }
  ],
  "servings": 12,

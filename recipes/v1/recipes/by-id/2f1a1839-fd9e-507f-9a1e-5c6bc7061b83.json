  "schema_version": 1,
  "id": "2f1a1839-fd9e-507f-9a1e-5c6bc7061b83",
  "slug": "irish-boiled-dinner-corned-beef",
  "name": "Irish Boiled Dinner (Corned Beef)",
  "recipe_type": "main",
  "brief_description": "Easy boiled dinner of tender corned beef and cabbage, with onions, white potatoes, and carrots cooked in water for an easy, no-fuss Irish meal.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse brisket under cold water and place in a large pot. Add enough water to cover roast by 6 inches."
    },
    {
      "position": 3,
      "text": "Peel onions and place them in the pot. Bring to a boil; cook for about 30 minutes at a rolling boil. Reduce heat to medium-low, so water is at a gentle boil. Cover and cook for 3 \u00bd hours."
    },
    {
      "position": 4,
      "text": "Remove onions and cut them into wedges. Return them to the pot. Add carrots to the pot, then place cabbage over roast. Place potatoes on top of cabbage. Cover and cook until potatoes are tender, about 30 minutes more. The potatoes should be immersed in the water by now, but if not, keep the lid on so they can steam."
    },
    {
      "position": 5,
      "text": "Remove vegetables from the pot and place in a separate serving bowl. Keep corned beef in the pot until ready to slice and serve to prevent it from drying out too quickly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 15,

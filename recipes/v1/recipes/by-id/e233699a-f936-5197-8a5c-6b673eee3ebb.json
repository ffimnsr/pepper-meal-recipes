  "slug": "joyful-chocolate-overnight-oats",
  "name": "Joyful Chocolate Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Components of a popular candy bar come together for fun, chocolaty overnight oats you can make the night before.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In pint jar or at least 12-ounce glass, mix oats, almondmilk, powdered sugar, and cocoa powder. Cover; refrigerate at least 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "To serve, stir mixture and top with almonds, chocolate chips, and coconut."
    }
  ],

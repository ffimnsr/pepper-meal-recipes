  "id": "d4047661-3225-56b3-82de-300c5705946e",
  "slug": "instant-pot-potato-and-bacon-soup",
  "name": "Instant Pot Potato and Bacon Soup",
  "recipe_type": "soup",
  "brief_description": "Try this comforting, homemade potato soup recipe in the Instant Pot, made from scratch with flavorful red potatoes and garnished with crispy bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add oil and let heat for 1 minute. Add bacon and cook until bacon is crispy and fat has rendered out, about 8 minutes. Transfer bacon to a paper towel-lined plate using a slotted spoon."
    },
    {
      "position": 2,
      "text": "Add onion and celery to bacon drippings and cook for 2 minutes. Add garlic and thyme and cook for 1 minute. Cancel Saut\u00e9 mode. Add potatoes and broth. Close and lock the lid. Select high pressure according to manufacturer\u2019s instructions; set timer for 8 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Whisk together 2 tablespoons milk and cornstarch in a small bowl to make a slurry. Open the pot and stir in cornstarch slurry and 1 cup milk. Season with salt and pepper. Let soup sit, stirring several times until thickened, about 10 minutes. Ladle into bowls and sprinkle with bacon."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

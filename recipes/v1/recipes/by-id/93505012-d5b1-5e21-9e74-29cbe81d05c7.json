  "id": "93505012-d5b1-5e21-9e74-29cbe81d05c7",
  "slug": "easy-pie-crust",
  "name": "Easy Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "This easy pie crust is so simple to make with flour, sugar, salt, oil, and milk. And best of all, you don't need a mixing bowl or rolling pin!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, oil, milk, sugar, and salt in a 9-inch pie pan; stir with a fork until mixture comes together."
    },
    {
      "position": 3,
      "text": "Pat into the bottom and up the sides of the pan."
    },
    {
      "position": 4,
      "text": "Poke holes in the bottom and sides with a fork."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until light golden brown, about 15 minutes. Use as directed in your favorite pie recipe."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

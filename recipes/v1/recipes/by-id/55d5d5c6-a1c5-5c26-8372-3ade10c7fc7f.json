  "id": "55d5d5c6-a1c5-5c26-8372-3ade10c7fc7f",
  "slug": "super-simple-sweet-potato-dog-treats",
  "name": "Super Simple Sweet Potato Dog Treats",
  "recipe_type": "dessert",
  "brief_description": "These sweet potato dog treats made with applesauce, eggs, and whole wheat flour are budget-friendly chews for your pet and great for gift giving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Prick sweet potato several times with a fork. Cook in the microwave on high until tender, about 6 minutes. Let sit until cool enough to handle."
    },
    {
      "position": 3,
      "text": "Cut potato in half and scoop flesh into a bowl; discard skin. Mash potato with a fork or potato masher. Transfer about 1 cup mashed potato to a large bowl, saving any remaining for another use."
    },
    {
      "position": 4,
      "text": "Mix whole wheat flour, eggs, and applesauce into sweet potato in the bowl until a dough forms."
    },
    {
      "position": 5,
      "text": "Turn dough out onto a well-floured surface and roll dough to about 1/2-inch thickness. Cut out shapes using a cookie cutter or cut dough into strips with a pizza cutter. Arrange cookies on an ungreased baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crisp, 35 to 45 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

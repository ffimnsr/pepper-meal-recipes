  "schema_version": 1,
  "id": "b09cf091-54e1-57f9-a0ae-df5c88426dbc",
  "slug": "sweet-potato-chili",
  "name": "Sweet Potato Chili",
  "recipe_type": "soup",
  "brief_description": "This sweet potato chili with turkey, beef, beans, and smoky spices is easy to make in a slow cooker for a hearty meal that's ready by dinnertime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place sweet potatoes, stewed tomatoes, tomato sauce, onion, celery, water, chili powder, cumin, cinnamon, salt, black pepper, cayenne pepper, garlic powder, and onion powder in a slow cooker. Cook on high, stirring occasionally, for 5 hours."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat and stir in ground turkey and ground beef. Cook and stir until meat is crumbly, evenly browned, and no longer pink, 10 to 15 minutes. Drain and discard any excess grease."
    },
    {
      "position": 4,
      "text": "Add cooked ground turkey, cooked ground beef, black beans, and corn to sweet potato mixture in the slow cooker; cook until flavors have blended, 1 to 2 more hours."
    },
    {
      "position": 5,
      "text": "Serve warm and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

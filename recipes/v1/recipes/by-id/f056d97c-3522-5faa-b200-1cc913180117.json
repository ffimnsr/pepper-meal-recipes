  "id": "f056d97c-3522-5faa-b200-1cc913180117",
  "slug": "j-js-shepherds-pie",
  "name": "J. J.'s Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "The secret ingredients in this recipe for the classic comfort food shepherd's pie are American cheese and cream-style corn.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 3,
      "text": "Stir cream-style corn and corn niblets together in a saucepan over medium heat; cook and stir until heated through, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Spread ground beef out in the bottom of a casserole dish. Top with 8 slices American cheese, corn mixture, remaining cheese slices, and mashed potatoes, respectively."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until corn mixture bubbles along the edges of the dish, about 30 minutes. Cool briefly before slicing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

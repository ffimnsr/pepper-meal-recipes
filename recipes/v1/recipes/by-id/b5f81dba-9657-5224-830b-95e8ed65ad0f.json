  "slug": "mango-pico-de-gallo-recipe-8636041",
  "name": "Mango Pico de Gallo",
  "recipe_type": "appetizer",
  "brief_description": "This mango pico de gallo is a colorful, spicy fruit salsa that enhances grilled or seared fish, chicken, or shrimp. For extra heat, use more jalapeños, or substitute serrano peppers, if you dare.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place mango, red onion, jalapeño, tomato, cilantro, and lime zest and juice in a medium bowl. Season to taste with salt. Toss to combine."
    },
    {
      "position": 2,
      "text": "Refrigerate at least 30 minutes to an hour. Garnish with additional lime slices and cilantro sprigs. Serve cold."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

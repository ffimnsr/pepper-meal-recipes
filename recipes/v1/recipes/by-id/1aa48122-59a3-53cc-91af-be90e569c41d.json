  "id": "1aa48122-59a3-53cc-91af-be90e569c41d",
  "slug": "blackberry-ice-cream",
  "name": "Blackberry Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This blackberry ice cream is easy to make at home for the fresh summery taste of juicy, ripe blackberries in every smooth, creamy, cold bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine blackberries, sugar, and lemon zest in the bowl of a food processor; process until mixture is blended. Let sit for 10 minutes."
    },
    {
      "position": 2,
      "text": "Strain blackberry mixture through a fine mesh sieve and discard seeds; return mixture to the food processor. Add cream, milk, and vanilla extract. Pulse until mixture is whipped, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions, about 20 minutes. Transfer to an airtight container and freeze until firm, 2 hours to overnight."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

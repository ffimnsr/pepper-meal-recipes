  "id": "e3d38490-6201-5f0c-9609-cac44a2bb530",
  "slug": "easy-chicken-and-broccoli-alfredo",
  "name": "Easy Chicken and Broccoli Alfredo",
  "recipe_type": "main",
  "brief_description": "This creamy chicken and broccoli Alfredo pasta dish with fresh broccoli, tender chunks of chicken breast, Parmesan cheese, and basil is sure to please!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook pasta as directed on package, adding broccoli to the boiling water for the last 2 minutes of the pasta cooking time. Drain pasta mixture."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat dressing in large nonstick skillet on medium-high heat. Add chicken and cook until no longer pink in the center, stirring occasionally, about 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir in milk, cream cheese, Parmesan cheese, and basil. Bring to a boil, stirring constantly. Cook until sauce is well blended and heated through, about 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Add chicken mixture to pasta mixture; mix lightly."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

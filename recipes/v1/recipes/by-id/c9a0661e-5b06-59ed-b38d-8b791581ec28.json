  "id": "c9a0661e-5b06-59ed-b38d-8b791581ec28",
  "slug": "smoked-eggs",
  "name": "Smoked Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Smoked eggs are bursting with delicious smoky flavor and will take any hard-cooked egg dish to new heights. They are easy to make in the smoker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a smoker grill to 225 degrees F (110 degrees C). Add wood chips according to manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Place whole eggs directly on the grate of the preheated smoker. Cook, without turning, for 2 hours, maintaining an even temperature."
    },
    {
      "position": 3,
      "text": "Transfer eggs to a plate and allow to cool completely before peeling. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,

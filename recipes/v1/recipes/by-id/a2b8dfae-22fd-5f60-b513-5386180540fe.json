  "id": "a2b8dfae-22fd-5f60-b513-5386180540fe",
  "slug": "tuna-stuffed-mushrooms",
  "name": "Tuna-Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "In this nine-ingredient tuna-stuffed mushrooms recipe, creamy tuna is tossed with Swiss cheese, stuffed into button mushrooms, and baked into perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine tuna, Swiss cheese, mayonnaise, sweet relish, dried onion, onion powder, salt, and black pepper in a large bowl. Fill mushroom caps with tuna mixture; place on a baking sheet, filled-side up."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until mushrooms are soft and begin to give up their juices, 20 to 25 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

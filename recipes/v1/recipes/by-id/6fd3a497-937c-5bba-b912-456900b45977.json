  "id": "6fd3a497-937c-5bba-b912-456900b45977",
  "slug": "grilled-chicken-caesar-salad-recipe-7552423",
  "name": "Grilled Chicken Caesar Salad",
  "recipe_type": "salad",
  "brief_description": "This grilled chicken Caesar salad recipe gets a flavor boost thanks to grilling the chicken on an outdoor barbecue. The homemade Caesar dressing is worth the effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add garlic cloves, anchovy filets, mustard, mayonnaise, red wine vinegar, Worcestershire sauce and Parmesan cheese to the jar of a high-powered blender (such as Vitamix). Blend on high until smooth. Season to taste with salt and pepper."
    },
    {
      "position": 2,
      "text": "Pour half the dressing into a lidded glass jar; refrigerate dressing until ready to use. Pour remaining dressing into a resealable plastic bag. Add chicken breasts, reseal the bag, and place in the refrigerator to marinate overnight."
    },
    {
      "position": 3,
      "text": "Preheat a gas grill to 400 degrees F (200 degrees C) and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Grill chicken on the preheated grill with lid closed, until browned and juices run clear, 4 to 5 minutes per side. An instant-read thermometer inserted near the center should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove chicken to rest on a plate for 10 minutes; slice into strips. Refrigerate chicken strips until chilled."
    },
    {
      "position": 6,
      "text": "To assemble, roughly pull Romaine lettuce apart into bite-sized pieces. Pour chilled dressing over lettuce, toss. Divide salad onto 4 plates, top with croutons, shaved Parmesan and chicken strips. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

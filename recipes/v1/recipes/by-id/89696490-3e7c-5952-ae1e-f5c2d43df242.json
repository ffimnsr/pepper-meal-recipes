  "id": "89696490-3e7c-5952-ae1e-f5c2d43df242",
  "slug": "northern-italian-style-chicken-cacciatore",
  "name": "Northern Italian-Style Chicken Cacciatore",
  "recipe_type": "main",
  "brief_description": "Mushrooms, tomatoes, and onions simmer in a rustic tomato sauce in this Northern Italian-style chicken cacciatore recipe.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse chicken pieces and pat dry."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add chicken and brown, 4 to 5 minutes per side. Remove chicken to a plate."
    },
    {
      "position": 3,
      "text": "Add mushrooms, onion, and celery to the pan drippings and saut\u00e9 until soft, about 5 minutes. Add garlic and cook until fragrant, about 2 more minutes."
    },
    {
      "position": 4,
      "text": "Return chicken to the skillet. Add white wine and cook until it has almost completely evaporated, 2 to 3 minutes. Add diced tomatoes, chicken broth, parsley, oregano, pepper flakes, salt, and pepper. Cover and simmer until chicken is no longer pink at the bone and the juices run clear, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

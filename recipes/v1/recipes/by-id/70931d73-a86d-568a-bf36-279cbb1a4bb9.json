  "id": "70931d73-a86d-568a-bf36-279cbb1a4bb9",
  "slug": "deluxe-bacon-onion-omelet",
  "name": "Deluxe Bacon Onion Omelet",
  "recipe_type": "breakfast",
  "brief_description": "For a satisfying, no-cheese breakfast dish that's quick and easy to make, simply combine crispy baked bacon, eggs, butter, and onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Arrange bacon on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until just crisped, 10 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Beat eggs and water together in a bowl."
    },
    {
      "position": 4,
      "text": "Let the bacon cool on paper towels, about 5 minutes. Break into small pieces."
    },
    {
      "position": 5,
      "text": "Spray a 10-inch non-stick skillet with cooking spray. Melt butter over medium heat until foaming, about 2 minutes. Add onion once butter is no longer foaming. Cook and stir until tender but not browned, 4 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Increase heat to medium-high. Pour eggs into the skillet and cook until mostly set, about 2 minutes. Lift the omelet with a spatula as the center rises; tilt the skillet so that uncooked eggs run to the center of the pan. Cook until set, 2 to 4 minutes. Sprinkle bacon pieces onto the omelet and fold in half using the spatula."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

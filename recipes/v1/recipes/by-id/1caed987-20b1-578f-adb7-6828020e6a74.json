{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1caed987-20b1-578f-adb7-6828020e6a74",
  "slug": "pumpkin-pie-with-maple-mascarpone-swirl",
  "name": "Pumpkin Pie with Maple Mascarpone Swirl",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin pie is topped with a maple mascarpone swirl which adds a complex, autumnal flavor with just four ingredients.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Fit pie crust into a 9-inch pie dish and place it on a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine pumpkin puree, condensed milk, eggs, and pumpkin pie spice in a large bowl. Mix until combined and set aside."
    },
    {
      "position": 3,
      "text": "Make the cheesecake swirl: In a medium, microwave-safe bowl stir together mascarpone, milk, maple syrup, and flour. Microwave on high power until the cheese is completely melted, 20 to 30 seconds. Stir the mixture until completely smooth. (This will make swirling easier.)"
    },
    {
      "position": 4,
      "text": "Add about two-thirds of the cheese mixture into the pumpkin filling and stir to combine. Pour the pumpkin filling into the pie shell. Spoon the remaining mascarpone mixture on top in about 10 or so dollops. Use a thin knife or toothpick to swirl the cheesecake dollops into the pumpkin pie filling to create a swirl pattern."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue to bake until filling is set around the sides but jiggles like jello in the center, erring on the side of undercooking as the pie continues to cook as it cools, 30 to 35 minutes. Turn the oven off, open the oven door, and let cool for one hour in the oven before transferring into the fridge to cool completely."
    },
    {
      "position": 6,
      "text": "Remove from the oven, set on a wire rack, and cool completely before serving."
    }
  ],
  "servings": 8,

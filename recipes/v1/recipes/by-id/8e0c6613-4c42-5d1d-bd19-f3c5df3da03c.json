  "id": "8e0c6613-4c42-5d1d-bd19-f3c5df3da03c",
  "slug": "butternut-squash-fritters-recipe-7969440",
  "name": "Butternut Squash Fritters",
  "recipe_type": "appetizer",
  "brief_description": "These crispy butternut squash fritters are made with shredded squash and simple pantry ingredients for the perfect fall appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine the squash, cheese, flour, eggs, thyme, salt, and pepper in a large bowl."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in a large skillet over medium. Working in batches, drop batter by 3 tablespoon portions into hot oil. Flatten mounds into 3 inch circles."
    },
    {
      "position": 4,
      "text": "Cook until golden, 3 to 4 minutes, turning once."
    },
    {
      "position": 5,
      "text": "Sprinkle with salt immediately after removing from the skillet . Keep warm in a 200 degrees F (95 degrees C) oven while cooking remaining fritters. Add additional oil as needed during cooking. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,

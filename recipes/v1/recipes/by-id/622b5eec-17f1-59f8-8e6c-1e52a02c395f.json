  "id": "622b5eec-17f1-59f8-8e6c-1e52a02c395f",
  "slug": "quick-black-beans-and-rice",
  "name": "Quick Black Beans and Rice",
  "recipe_type": "main",
  "brief_description": "This easy rice and beans recipe is pretty straight forward. Brown rice, black beans, tomatoes, and some onion \u2014 in 15 minutes you have a hearty meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil over medium-high in a large saucepan. Add onion; cook and stir until tender. Add beans, tomatoes, oregano, and garlic powder. Bring to a boil."
    },
    {
      "position": 2,
      "text": "Stir in rice. Cover; reduce heat and simmer for 5 minutes. Remove from heat; let stand 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

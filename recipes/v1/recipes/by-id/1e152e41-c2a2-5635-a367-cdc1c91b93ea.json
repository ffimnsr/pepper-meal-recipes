  "slug": "honey-apple-pork-chops-recipe-11831843",
  "name": "Honey Apple Pork Chops",
  "recipe_type": "main",
  "brief_description": "Honey-apple pork chops are simmered to tender perfection in this simple recipe that you can tell everyone had you working in the kitchen all day long!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat pork chops dry with paper towels, then sprinkle both sides with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium-high heat. Add chops and brown well, about 5 minutes per side. Stir in honey, apple wedges, and garlic; cover and simmer until pork is tender, about 8 minutes. An instant-read thermometer, inserted into the center, should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 3,
      "text": "Serve chops topped with apples and pan juices. Garnish with sage leaves. Recipe developed with Christie Biggers"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

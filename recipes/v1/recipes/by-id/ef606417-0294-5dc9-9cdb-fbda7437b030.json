  "id": "ef606417-0294-5dc9-9cdb-fbda7437b030",
  "slug": "roasted-rack-of-lamb",
  "name": "Roasted Rack of Lamb",
  "recipe_type": "main",
  "brief_description": "A rack of lamb is seared, coated with mustard, and encrusted with garlic and rosemary-flavored bread crumbs before it's roasted to perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 450 degrees F (230 degrees C). Move the oven rack to the center position."
    },
    {
      "position": 2,
      "text": "Combine bread crumbs, garlic, rosemary, 1 teaspoon salt, and 1/4 teaspoon pepper in a small bowl; stir in 2 tablespoons olive oil to moisten the mixture. Set aside."
    },
    {
      "position": 3,
      "text": "Season rack of lamb all over with 1 teaspoon salt and 1 teaspoon pepper."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons olive oil in a large heavy oven-proof skillet over high heat. Add lamb and sear on all sides, about 1 to 2 minutes: set lamb aside for a few minutes."
    },
    {
      "position": 5,
      "text": "Brush lamb with mustard and roll in bread crumb mixture until evenly coated. Cover the ends of the bones with foil to prevent charring."
    },
    {
      "position": 6,
      "text": "Arrange the breaded rack of lamb bone-side down in the same skillet. Roast in preheated oven for 12 to 18 minutes for medium; an instant-read thermometer inserted into the center should read at least 130 degrees F (54 degrees C), or continue to cook to desired doneness."
    },
    {
      "position": 7,
      "text": "Remove lamb from the skillet and allow to rest for 5 to 7 minutes, loosely covered with foil, before carving between the ribs."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

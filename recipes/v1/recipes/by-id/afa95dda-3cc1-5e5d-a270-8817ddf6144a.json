  "id": "afa95dda-3cc1-5e5d-a270-8817ddf6144a",
  "slug": "2-ingredient-dough-garlic-knots",
  "name": "2-Ingredient Dough Garlic Knots",
  "recipe_type": "appetizer",
  "brief_description": "These restaurant-style garlic knots are made with a dough that requires only two ingredients to prepare. Perfect for a side to pasta.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour and Greek yogurt together in a medium bowl until a shaggy dough forms. Transfer to a surface dusted with more self-rising flour, and knead for 8 to 10 minutes. Continue adding flour as needed if the dough is too sticky."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine melted butter, garlic, parsley, and salt in a small bowl."
    },
    {
      "position": 4,
      "text": "Cut the dough into 8 pieces, roughly 2 ounces each. Roll each segment into an even 12-inch log. Shape the logs into knots by forming a cross, wrapping the top piece around the bottom piece, then connecting the two ends. Press together tightly to seal."
    },
    {
      "position": 5,
      "text": "Move the knots to the prepared baking sheet and brush with garlic butter."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly browned, 15 to 20 minutes. Brush with remaining garlic butter, garnish with more parsley, and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

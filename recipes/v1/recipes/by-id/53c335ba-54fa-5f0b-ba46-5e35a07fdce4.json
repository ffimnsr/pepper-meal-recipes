  "id": "53c335ba-54fa-5f0b-ba46-5e35a07fdce4",
  "slug": "slow-cooker-beef-tips-and-gravy-recipe-11748455",
  "name": "Slow Cooker Beef Tips and Gravy",
  "recipe_type": "main",
  "brief_description": "This slow cooker beef tips and gravy is perfect to serve over mashed potatoes, noodles, or rice. There's nothing more comforting for Sunday dinner than this hearty, yet tender beef dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Set a heavy cast-iron skillet over medium-high heat; add oil. Toss beef steak tips with salt, granulated garlic, Cantanzaro herbs, and pepper."
    },
    {
      "position": 3,
      "text": "Sear beef in batches until browned on all sides. Transfer steak tips to a slow cooker."
    },
    {
      "position": 4,
      "text": "Combine beef bone broth, soup, and dry gravy mix; pour over steak tips. Add mushrooms to the slow cooker."
    },
    {
      "position": 5,
      "text": "Cover and cook on Low for 8 hours or on High for 5 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 310,
  "preparation_time_minutes": 10,

  "slug": "melon-smoothie",
  "name": "Melon Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "Cantaloupe and honeydew melon is blended with lime juice and sugar. This one is great when melons are in season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a blender, combine cantaloupe, honeydew, lime juice and sugar. Blend until smooth. Pour into glasses and serve."
    }
  ],

  "id": "a44e72cb-fb73-5bfd-baf8-1155d29c1d8b",
  "slug": "french-onion-soup-ix",
  "name": "French Onion Soup IX",
  "recipe_type": "soup",
  "brief_description": "Thickly sliced onions are slowly cooked in butter, then combined with beef broth and Romano cheese before being ladled into bowls, and topped with toast and cheese.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over low heat, melt butter. Cook onions in butter until soft and golden brown, 15 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Pour in beef broth and consomme and simmer 10 minutes."
    },
    {
      "position": 3,
      "text": "Preheat oven broiler."
    },
    {
      "position": 4,
      "text": "Whisk Romano into soup and season with salt and pepper. Pour soup into 8 ovenproof bowls. Top with toasted slices of bread and grated Gruyere."
    },
    {
      "position": 5,
      "text": "Place bowls under broiler until cheese melts."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

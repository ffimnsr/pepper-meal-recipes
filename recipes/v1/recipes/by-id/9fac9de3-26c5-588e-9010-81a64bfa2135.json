  "id": "9fac9de3-26c5-588e-9010-81a64bfa2135",
  "slug": "garlic-fried-rice",
  "name": "Garlic Fried Rice",
  "recipe_type": "drink",
  "brief_description": "Garlic, onions, and lemon juice to add interest to plain white rice.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the rice and water in a saucepan and bring to a boil. Cover, reduce heat to low, and simmer until rice is tender and water is absorbed. Set aside to cool."
    },
    {
      "position": 2,
      "text": "Melt the butter in a large skillet over medium-high heat. Add onion and garlic; cook and stir until fragrant and lightly browned. Stir in rice and cook until coated and heated through. Remove from the heat and stir in the lemon juice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 4,

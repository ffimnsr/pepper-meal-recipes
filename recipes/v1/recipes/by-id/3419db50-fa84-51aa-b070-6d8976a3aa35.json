  "id": "3419db50-fa84-51aa-b070-6d8976a3aa35",
  "slug": "cheesy-baked-eggs",
  "name": "Cheesy Baked Eggs",
  "recipe_type": "breakfast",
  "brief_description": "This is an interesting concoction featuring eggs, cheese, and flour. To add a little extra kick, add a small can of diced chiles or jalapenos into the mix. Serve with sour cream, salsa, and green taco sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare a 9x13-inch baking dish with the melted butter."
    },
    {
      "position": 2,
      "text": "Whisk together the eggs, pepper Jack cheese, cottage cheese, flour, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Pour the mixture into the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until eggs are completely set, about 1 hour."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

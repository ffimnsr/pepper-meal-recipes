  "id": "06b38b73-9426-5e37-b952-c36b0a263fa7",
  "slug": "easy-two-ingredient-pulled-pork",
  "name": "Easy, Two-Ingredient Pulled Pork",
  "recipe_type": "main",
  "brief_description": "An easy pulled pork recipe. These sandwiches are as tasty as they are simple. With a bottle of your favorite BBQ sauce, you're ready to feed a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork in a slow cooker and add enough water to cover the bottom of the slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 7 hours. Transfer pork to a bowl and shred with two forks. Return pork to slow cooker and stir in barbeque sauce. Continue to cook on Low for 45 minutes to 1 hour."
    },
    {
      "position": 3,
      "text": "Spoon a generous amount of pork into each roll to serve."
    }
  ],

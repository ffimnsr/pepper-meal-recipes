  "name": "Colored Sugar",
  "recipe_type": "dessert",
  "brief_description": "Learn how to make your own colored sugar with liquid food coloring for the perfect finishing touch on festive cookies, cakes, and candies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Place sugar into a jar with a tight-fitting lid. Drip food coloring onto sugar, close the lid."
    },
    {
      "position": 3,
      "text": "Shake vigorously until blended and even in color, about 1 minute."
    }

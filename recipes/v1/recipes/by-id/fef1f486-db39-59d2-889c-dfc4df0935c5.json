  "id": "fef1f486-db39-59d2-889c-dfc4df0935c5",
  "slug": "copycat-starbucks-cheese-danish-recipe-11960021",
  "name": "Copycat Starbucks Cheese Danish",
  "recipe_type": "breakfast",
  "brief_description": "If you love a Starbucks cheese Danish, you have to try making them at home. This copycat is so easy, and even better than the original.Serve them plain or with jam and a drizzle of icing.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) and line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, sugar, vanilla, lemon juice, and salt together in a bowl until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Roll out puff pastry slightly and cut into 6 equal rectangles. Transfer to the prepared baking sheet. Using a knife, lightly score a smaller rectangle inside each piece (do not cut all the way through). Prick throughout the center with a fork."
    },
    {
      "position": 4,
      "text": "Pipe or spoon the cream cheese filling into the center of each pastry in a thick oval or log shape, staying within the scored area. Brush the edges of the pastry with egg wash."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the pastry is golden brown and puffed, 15 to 18 minutes. Let cool for 5 to 10 minutes."
    },
    {
      "position": 6,
      "text": "For icing whisk powdkered sugar, milk, and vanilla together until smooth. Drizzle over cooled Danishes. Serve with strawberry jam on the side or spooned alongside for dipping. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

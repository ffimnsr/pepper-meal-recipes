  "id": "b4a57956-a021-5299-a3f8-ccdbbbe20203",
  "slug": "turkey-shepherds-pie",
  "name": "Turkey Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This turkey shepherd's pie recipe uses ground meat saut\u00e9ed with carrots, mushrooms, garlic, and seasonings \u2014 topped with mashed potatoes and baked.",
  "cuisine": "English American",
  "instructions": [
    {
      "position": 1,
      "text": "Start the topping: Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "While the potatoes are cooking, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "At the same time, make the filling: Heat olive oil in a skillet over medium heat; stir in onion. Saut\u00e9 onion until soft and translucent, about 5 minutes. Stir in ground turkey, mushrooms, carrot, parsley, garlic, bouillon powder, and thyme. Cook and stir until meat is broken up and cooked through, 5 to 7 minutes. Season with salt and pepper. Stir in flour and cook for 1 minute more. Remove from the heat and set aside."
    },
    {
      "position": 4,
      "text": "Finish the topping: Drain potatoes and transfer to a bowl. Add milk and butter and mash to desired consistency. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Transfer filling to a deep-dish pie pan or casserole dish. Spread topping over filling and swirl with a fork."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the topping is lightly browned, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

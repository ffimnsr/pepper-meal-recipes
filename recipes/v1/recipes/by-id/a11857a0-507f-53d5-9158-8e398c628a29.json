  "id": "a11857a0-507f-53d5-9158-8e398c628a29",
  "slug": "ham-and-cheese-croissant-casserole",
  "name": "Ham and Cheese Croissant Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Croissants, ham and Swiss cheese sandwiches, baked casserole-style, make a perfect weekend breakfast or casual lunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together butter, Dijon, onion, maple syrup, and Worcestershire in a small bowl. Evenly spread butter mixture on the cut sides of the croissants."
    },
    {
      "position": 2,
      "text": "Place the croissant bottom halves on a cutting board; layer on ham, folding to fit the croissant. Sprinkle cheese evenly among the croissants; place top halves on each."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Spray a casserole dish or a cast iron skillet large enough to accommodate croissants with cooking spray. Place croissants in a single layer in the prepared pan."
    },
    {
      "position": 5,
      "text": "Whisk together eggs, milk, salt, pepper, and garlic powder in a medium bowl, and pour evenly over the croissants. Sprinkle each croissant with bagel seasoning. Set the dish aside for about 10 minutes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until croissants are golden brown and egg mixture is perfectly set, 32 to 38 minutes. Check casserole at about 25 minutes, and if croissants are getting very browned, cover with foil. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 10,
  "difficulty": "medium",

  "id": "9acaada4-7fa9-538f-b913-820d98c3abe8",
  "slug": "old-fashioned-sweet-potato-pie",
  "name": "Old-Fashioned Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "This is a down home fresh sweet potato pie. I hope you enjoy this recipe as much as my family.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix the sweet potatoes, eggs, evaporated milk, cinnamon, nutmeg, cloves and salt. Pour into the pie crust."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 50 minutes, or until a knife inserted in center comes out clean. Top with whipped topping or serve warm with vanilla ice cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,

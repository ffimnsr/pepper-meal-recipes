  "id": "524a10aa-4a71-5c62-84b9-a2d0220757bd",
  "slug": "best-carrot-cake-ever",
  "name": "Best Carrot Cake Ever",
  "recipe_type": "dessert",
  "brief_description": "The best carrot cake recipe uses grated carrots, crushed pineapple, and juicy raisins to create the most deliciously moist and tender cake ever!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine grated carrots and brown sugar in a medium bowl. Let sit for 1 hour, then stir in raisins."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 10-inch round cake pans. Beat eggs in a large bowl until lighter in color."
    },
    {
      "position": 4,
      "text": "Gradually beat in white sugar, oil, and vanilla. Stir in pineapple."
    },
    {
      "position": 5,
      "text": "Combine flour, cinnamon, baking soda, and salt in a separate bowl, then stir into egg mixture until absorbed."
    },
    {
      "position": 6,
      "text": "Stir in carrot mixture and walnuts. Pour evenly into the prepared cake pans."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 45 to 50 minutes."
    },
    {
      "position": 8,
      "text": "Cool for 10 minutes before removing cake from the pans; let cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

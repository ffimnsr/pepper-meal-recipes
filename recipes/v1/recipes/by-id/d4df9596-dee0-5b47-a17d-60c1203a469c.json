  "id": "d4df9596-dee0-5b47-a17d-60c1203a469c",
  "slug": "boardwalk-quality-maple-walnut-fudge",
  "name": "Boardwalk Quality Maple Walnut Fudge",
  "recipe_type": "dessert",
  "brief_description": "This maple walnut fudge is a combination of white chocolate chips with creamy sweetened condensed milk for a classic maple-flavored candy treat.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease an 8x8-inch glass baking dish, and line with an 8x12-inch sheet of parchment paper. The ends will hang over the side of the dish."
    },
    {
      "position": 2,
      "text": "Melt white chocolate, sweetened condensed milk, and butter in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, for 1 to 3 minutes (depending on your microwave). Do not overheat or chocolate will scorch. Stir in maple flavored extract until just combined, then add walnuts."
    },
    {
      "position": 3,
      "text": "Pour fudge mixture into the prepared baking dish; refrigerate until set, about 1 hour. Remove fudge by lifting the parchment paper, then cut into squares."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

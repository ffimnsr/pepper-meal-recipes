  "id": "5a12ca18-0056-5241-bd44-0e92eb25cd9f",
  "slug": "grilled-peach-and-mozzarella-salad-recipe-12028379",
  "name": "Grilled Peach and Mozzarella Salad",
  "recipe_type": "salad",
  "brief_description": "This grilled peach and mozzarella salad is absolutely divine. Grilled, lightly caramelized peach slices are layered with fresh mozzarella and drizzled with a fresh peach, lime, and basil glaze for a bright, sweet-and-savory summer dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut the ends off peaches, then cut peaches horizontally into 1/4-inch-thick rounds, cutting inward until you reach the pit (like a donut shape). Turn peach to the opposite end and repeat."
    },
    {
      "position": 2,
      "text": "Dice end pieces to yield 1 cup fresh peaches. Add diced peaches, olive oil, brown sugar, whiskey, sriracha, and lime juice to a small saucepan. Stirring constantly, bring just to a gentle boil. Remove from heat, stir in basil and lime zest, and allow to cool for 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Spray a grill pan with cooking spray; set over medium-high heat. Brush peach rounds with peach mixture."
    },
    {
      "position": 4,
      "text": "Place peach rounds in the grill pan just long enough to caramelize a little and get good grill marks, 2 to 3 minutes per side."
    },
    {
      "position": 5,
      "text": "On a platter, lay peach slices alternately with mozzarella slices, like shingles. Drizzle with remaining peach glaze and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

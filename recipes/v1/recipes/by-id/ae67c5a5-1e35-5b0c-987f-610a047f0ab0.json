  "id": "ae67c5a5-1e35-5b0c-987f-610a047f0ab0",
  "slug": "everything-bagel-cheese-ball",
  "name": "Everything Bagel Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Cream cheese and sharp Cheddar are mixed with everything bagel seasoning, then rolled in chopped pecans in this party-ready cheese ball with salty, savory flavor in every bite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese and bagel seasoning together. Add Cheddar cheese and mix thoroughly. Shape mixture into a ball with your hands or a spoon."
    },
    {
      "position": 2,
      "text": "Roll the cheese ball in chopped pecans until completely coated. Cover and refrigerate for 1 hour before serving."
    }
  ],
  "servings": 16,

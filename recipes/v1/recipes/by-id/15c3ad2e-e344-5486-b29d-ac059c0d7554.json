  "id": "15c3ad2e-e344-5486-b29d-ac059c0d7554",
  "slug": "rosemary-garlic-beer-bread-recipe-8349164",
  "name": "Rosemary-Garlic Beer Bread",
  "recipe_type": "side",
  "brief_description": "This rosemary beer bread recipe couldn't be easier: You don't have to activate any yeast, there's no rise time, and it comes together shockingly quickly with a homemade shortcut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For Homemade Bisquick: In a large mixing bowl, whisk together the flour, cornstarch, baking powder, sugar, and salt. It\u2019s important to give this mixture a very thorough whisking to aerate the ingredients and make sure they are evenly distributed."
    },
    {
      "position": 2,
      "text": "Using a food processor, pastry blender, or your fingertips, cut the chilled shortening and/or butter into the dry ingredients until the mixture resembles sand."
    },
    {
      "position": 3,
      "text": "For Rosemary Beer Bread: Preheat the oven to 375 degrees F (190 degrees C). Grease the bottom of a 9x5 loaf pan with 1 tablespoon butter. Set aside."
    },
    {
      "position": 4,
      "text": "Stir together 3 cups Homemade Bisquick, sugar, dried rosemary, garlic powder, thyme, garlic salt, and cayenne pepper. Add beer and stir until smooth"
    },
    {
      "position": 5,
      "text": "Pour beer mixture into loaf pan. Bake until golden-brown, about 50 minutes."
    },
    {
      "position": 6,
      "text": "Let cool in pan for 5 minutes. Brush with remaining 2 tablespoons (melted) butter. Transfer to wire rack and garnish with fresh rosemary. Let cool another 15 minutes before slicing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

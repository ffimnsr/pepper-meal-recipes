  "id": "65ba8728-e82e-57d5-b3aa-cf52ac888fa5",
  "slug": "hamantashen-ii",
  "name": "Hamantashen II",
  "recipe_type": "dessert",
  "brief_description": "This recipe makes cookie dough for rolling and cutting.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs, add oil and mix. Add the sugar, vanilla, baking powder and salt. Add the flour gradually and mix well."
    },
    {
      "position": 2,
      "text": "Refrigerate a few hours or overnight."
    },
    {
      "position": 3,
      "text": "Kneed dough until it becomes soft enough to roll. Cut dough with three inch cup or three inch round cookie cutters. Put about 1 tablespoon of pie filling into the middle of each circle. Fold up the edges of the circle into the middle and pinch together."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (180 degrees C) for 20 minutes."
    }
  ],
  "servings": 17,
  "cooking_time_minutes": null,

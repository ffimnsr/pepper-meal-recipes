  "id": "62f038d2-cd74-57fa-96cd-85428a16c591",
  "slug": "artichoke-dip-wonton-cups-recipe-11865149",
  "name": "Artichoke Dip Wonton Cups",
  "recipe_type": "appetizer",
  "brief_description": "These artichoke dip wonton cups are a fun twist on the traditional spinach artichoke dip with tortilla chips. Served as individual bites, they're ideal for a party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a standard 12-cup muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Line each muffin cup with a wonton wrapper. Press the center of the wrapper down into the cup, leaving the edges sticking up out of the cup. Spray each wrapper lightly with cooking spray."
    },
    {
      "position": 3,
      "text": "Bake cups in the preheated oven for 5 minutes, then remove from the oven."
    },
    {
      "position": 4,
      "text": "Add spinach, artichoke hearts, mayonnaise, sour cream, cream cheese, Parmesan cheese, and garlic in a bowl until well incorporated. Divide mixture evenly between wonton cups."
    },
    {
      "position": 5,
      "text": "Return to the oven and bake until filling is heated through and edges of wrappers are golden brown, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

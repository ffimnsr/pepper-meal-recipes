  "id": "7b0de8d1-07d1-5557-ba98-08eab7836a0e",
  "slug": "buffalo-chicken-cheese-ball",
  "name": "Buffalo Chicken Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This zesty Buffalo chicken cheese ball makes the perfect appetizer for a party or snack when tailgating.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir cream cheese until smooth. Mix in chicken until well incorporated. Add Buffalo sauce, mayonnaise, garlic, and ranch dressing mix; mix well."
    },
    {
      "position": 2,
      "text": "Scoop onto plastic wrap. Wrap and roll into a tight ball. Refrigerate for 8 hours, or overnight."
    }
  ],

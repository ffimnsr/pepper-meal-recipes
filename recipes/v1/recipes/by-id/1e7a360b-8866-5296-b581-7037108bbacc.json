  "id": "1e7a360b-8866-5296-b581-7037108bbacc",
  "slug": "applesauce-cake-vi",
  "name": "Applesauce Cake VI",
  "recipe_type": "dessert",
  "brief_description": "Easy as can be, but can be a dessert you will be proud to serve or give. I let it cool and dust with confectioners\u2019 sugar. You may add 1 cup of chopped nuts if you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch tube pan. Sift together the flour, baking powder, baking soda, salt and cinnamon. Set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the flour, baking powder, baking soda, salt and cinnamon. Make a well in the center and pour in the eggs, sugar, oil, applesauce and vanilla. Mix well and pour into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 to 60 minutes, or until a toothpick inserted into the center of the cake comes out clean. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

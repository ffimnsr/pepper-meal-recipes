  "id": "89b6e83e-3062-5186-9991-594fcfb1cd2e",
  "slug": "easy-keto-alfredo-sauce",
  "name": "Easy Keto Alfredo Sauce",
  "recipe_type": "main",
  "brief_description": "This creamy keto Alfredo sauce is super quick and easy to make in just 15 minutes using heavy cream, butter, garlic, cream cheese, and Parmesan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium saucepan over low heat. Add garlic and cook until fragrant, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir in heavy cream and cream cheese. Gradually add Parmesan cheese, stirring constantly until well incorporated and melted, about 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Stir in salt, nutmeg, and white pepper. The sauce will thicken as it cools."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

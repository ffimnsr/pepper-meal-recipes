  "id": "05e1324d-b120-565d-bf8b-778d59d17c92",
  "slug": "shredded-pork-fajita-tacos",
  "name": "Shredded Pork Fajita Tacos",
  "recipe_type": "main",
  "brief_description": "The whole family will enjoy these easy, tasty pork fajitas that quickly cook onion and green bell pepper, then add fully cooked shredded pork.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter in a large skillet over medium heat until melted, 3 to 5 minutes. Stir in onion and green pepper; cook and stir until softened, about 5 minutes. Add shredded pork, water, and fajita seasoning; cook and stir until heated through, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Place tortillas in a skillet over low heat until warmed, 1 to 2 minutes. Remove tortillas from the skillet. Spoon shredded pork mixture into tortillas; top with lettuce, tomato, Cheddar cheese, salsa, and sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 10,

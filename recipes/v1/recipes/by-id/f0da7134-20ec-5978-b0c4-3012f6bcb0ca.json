  "id": "f0da7134-20ec-5978-b0c4-3012f6bcb0ca",
  "slug": "southern-grits-casserole",
  "name": "Southern Grits Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This grits casserole made with sausage, grits, and Cheddar cheese is ready in an hour and can be kept warm in a slow cooker at your breakfast buffet.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a large baking dish."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a large saucepan; stir in grits. Reduce the heat, cover, and simmer until liquid has been absorbed, about 5 minutes. Mix in 2 cups Cheddar cheese and 1/2 of the butter until melted."
    },
    {
      "position": 3,
      "text": "Cook sausage in a skillet over medium-high heat until browned and crumbly, 5 to 7 minutes. Drain and add to grits mixture."
    },
    {
      "position": 4,
      "text": "Whisk eggs and milk together in a bowl. Pour into the skillet used to cook the sausage. Lightly scramble eggs over medium-low heat, then mix into grits mixture."
    },
    {
      "position": 5,
      "text": "Pour grits mixture into the prepared baking dish. Dot with remaining butter, sprinkle with remaining 1 cup Cheddar, and season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly browned, about 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

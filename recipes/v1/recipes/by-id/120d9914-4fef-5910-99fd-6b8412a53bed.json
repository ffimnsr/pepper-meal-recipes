  "slug": "dried-fruit-cheese-ball",
  "name": "Dried Fruit Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Tired of the same old cheese ball? Serve this one, made of cream cheese, mild Cheddar and dried fruit and pecans, with graham crackers or tea biscuits for a change from the ordinary.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl combine cream cheese and honey; beat until smooth. Stir in cheese and chopped fruit; mix well."
    },
    {
      "position": 2,
      "text": "Form into a ball and roll in chopped nuts. Chill for at least 3 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

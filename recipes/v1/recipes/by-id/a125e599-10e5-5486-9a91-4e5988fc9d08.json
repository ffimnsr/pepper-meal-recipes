  "id": "a125e599-10e5-5486-9a91-4e5988fc9d08",
  "slug": "5-ingredient-carrot-cake-recipe-11934653",
  "name": "5-Ingredient Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "This 5-ingredient carrot cake is made by adding finely shredded carrots, eggs, and oil to spice cake mix and icing with cream cheese frosting. It's moist, delicious, and easy to make. Toasted walnuts are optional, but add a nice crunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to to 350 degrees F (175 degrees C). Grease bottoms of 2 8-inch round cake pans. Line bottoms of pans with parchment paper. Grease and flour pans."
    },
    {
      "position": 2,
      "text": "Use the small hole side of a box grater to finely shred carrots. You should have about 1 1/3 cups finely shredded carrots."
    },
    {
      "position": 3,
      "text": "Combine cake mix and carrots in a medium bowl. Add 1 cup water, eggs, and oil. Beat with a hand mixer on medium speed until smooth and well combined, about 2 minutes. Divide batter among prepared pans."
    },
    {
      "position": 4,
      "text": "Bake until a wooden toothpick inserted in the center of the cakes comes out clean, 26 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Cool cakes in pans on a wire rack for 10 minutes. Loosen edges and turn out onto racks; remove parchment paper and cool completely, about 50 minutes."
    },
    {
      "position": 6,
      "text": "Place one cake layer on a serving plate and spread 1/2 cup frosting evenly over top. Top with remaining layer and frost top and sides."
    },
    {
      "position": 7,
      "text": "Garnish sides of cake with walnuts, if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

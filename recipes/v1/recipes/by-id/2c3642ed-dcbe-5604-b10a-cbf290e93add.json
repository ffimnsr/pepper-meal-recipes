  "id": "2c3642ed-dcbe-5604-b10a-cbf290e93add",
  "slug": "grandmas-best-pot-roast",
  "name": "Grandma's Best Pot Roast",
  "recipe_type": "main",
  "brief_description": "Cooked to tender perfection with minimal seasonings, this grandma's best pot roast is a simple recipe you'll want to share with family and friends.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Trim excess fat from roast, leaving about 1/4 inch fat. Liberally season all sides with salt, pepper, and garlic powder. Place roast, fat-side up, in a Dutch oven. Place onions on and around the roast."
    },
    {
      "position": 3,
      "text": "Cover and bake until aromatic, about 1 1/2 hours. Reduce heat to 350 degrees F (175 degrees C) and continue to bake, turning the meat every 30 minutes and keeping covered, until roast is browned and cooked through, about 3 hours more. An instant-read thermometer inserted in the thickest part of the roast should read 145 degrees F (65 degrees C)."
    },
    {
      "position": 4,
      "text": "Check tenderness of roast with a fork; if not tender enough, add additional cook time in 30-minute increments until meat easily falls apart."
    },
    {
      "position": 5,
      "text": "Remove from the oven and transfer roast to a cutting board. Tent with foil and let rest for at least 20 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, whisk water and flour together in a small bowl."
    },
    {
      "position": 7,
      "text": "Place the Dutch oven, uncovered, on the stovetop over medium heat. Smash the remaining onion pieces and stir, being careful not to let the gravy burn. Slowly add water-flour mixture, whisking until cooked through and desired thickness is achieved."
    },
    {
      "position": 8,
      "text": "Slice roast and serve alongside gravy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 10,

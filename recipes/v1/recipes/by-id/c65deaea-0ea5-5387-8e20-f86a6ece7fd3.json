  "id": "c65deaea-0ea5-5387-8e20-f86a6ece7fd3",
  "slug": "authentic-tortellini-soup",
  "name": "Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "This comforting tortellini soup packed with tender pasta, veggies, and Italian sausage in a savory broth makes a cozy meal on cold evenings.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 can broth into a small saucepan and add tortellini; bring to a boil. Cook tortellini until tender yet firm to the bite, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Heat oil in a large stockpot over medium heat; cook and stir sausage, onion, garlic, and Italian seasoning until sausage is browned and crumbly, 5 to 10 minutes. Add tortellini-broth mixture, remaining can of broth, tomato puree, and spinach to sausage mixture; cover stockpot and simmer until flavors blend, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

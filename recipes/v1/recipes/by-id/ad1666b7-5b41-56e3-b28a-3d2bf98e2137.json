  "id": "ad1666b7-5b41-56e3-b28a-3d2bf98e2137",
  "slug": "guinness-bread",
  "name": "Guinness Bread",
  "recipe_type": "soup",
  "brief_description": "This Guinness beer bread made with buttermilk and Irish stout is an incredibly flavorful and hearty brown soda bread that's great with soup.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease an 8x8-inch baking pan."
    },
    {
      "position": 2,
      "text": "Mix oats, flour, sugar, baking soda, baking powder, and salt together in a bowl. Stir butter, vanilla, buttermilk, and Guinness together in a separate large bowl. Pour flour mixture into beer mixture, and gently stir until well combined. Pour batter into the prepared baking pan, and sprinkle with additional oats if desired."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 30 minutes, then turn the temperature down to 400 degrees F (200 degrees C), and bake for an additional 30 minutes. Turn the oven off, open the door, and allow to cool for 30 minutes in the oven before turning out onto a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

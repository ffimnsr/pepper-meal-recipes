  "id": "2f411d61-9c33-51ce-b446-aef3e75950a6",
  "slug": "roasted-buffalo-brussels-sprouts",
  "name": "Roasted Buffalo Brussels Sprouts",
  "recipe_type": "side",
  "brief_description": "Baked Brussels sprouts with butter and hot sauce are transformed into a Buffalo-flavored side dish, much like Buffalo wings, but vegetarian.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine Brussels sprouts, olive oil, salt, and pepper in a bowl; mix until evenly coated. Spread sprouts onto the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are starting to wilt, about 20 minutes. Transfer sprouts to a bowl."
    },
    {
      "position": 4,
      "text": "Heat butter and hot sauce in a saucepan over low heat until melted and smooth, 2 to 3 minutes. Pour mixture over sprouts and stir until coated."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 22,
  "preparation_time_minutes": 10,

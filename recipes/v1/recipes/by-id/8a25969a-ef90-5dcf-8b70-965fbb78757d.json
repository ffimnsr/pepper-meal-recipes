  "id": "8a25969a-ef90-5dcf-8b70-965fbb78757d",
  "slug": "grammys-overnight-lasagna",
  "name": "Grammy's Overnight Lasagna",
  "recipe_type": "main",
  "brief_description": "This easy lasagna layers uncooked noodles with cheese, jarred marinara sauce, and crumbled ground beef. After an overnight rest in the refrigerator, it bakes up soft, bubbly, and delicious.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Cook the ground beef in a large saucepan over medium-high heat until browned and no longer pink, about 5 minutes; drain fat. Stir in the marinara sauce, water, and salt. Bring to a boil. Remove sauce from heat."
    },
    {
      "position": 2,
      "text": "Arrange 6 noodles in a 9x13-inch baking dish, breaking if necessary to fit. Spoon 1/2 of the sauce over noodles. Top with 1/2 of the cottage cheese and 1/2 of the mozzarella cheese. Repeat layers with remaining noodles, sauce, cottage cheese, and mozzarella cheese. Top with Parmesan cheese. Cover tightly with foil; refrigerate overnight."
    },
    {
      "position": 3,
      "text": "Preheat an oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake lasagna, covered, until noodles are soft, cheese is melted, and sauce is bubbly, about 1 hour. Allow to sit for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

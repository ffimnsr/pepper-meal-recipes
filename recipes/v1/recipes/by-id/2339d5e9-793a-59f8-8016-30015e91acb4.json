  "id": "2339d5e9-793a-59f8-8016-30015e91acb4",
  "slug": "leftover-pork-fried-rice",
  "name": "Leftover Pork Fried Rice",
  "recipe_type": "side",
  "brief_description": "This fried rice recipe makes use of leftover pork and rice in the most delicious way. It's faster than ordering takeout!",
  "cuisine": "Asian Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs and soy sauce in a bowl. Stir in rice, breaking up clumps; set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a wok over medium-high heat. Stir in garlic, white part of green onion, peas and carrots, and onion slices. Stir fry for 3 minutes; stir in pork."
    },
    {
      "position": 3,
      "text": "Pour egg mixture into wok; stir fry until eggs are cooked through and rice is golden, and all ingredients are hot, about 7 minutes. Season with salt and ground black pepper; garnish with chopped green onion tops."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

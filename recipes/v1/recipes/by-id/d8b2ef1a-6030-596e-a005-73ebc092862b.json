  "id": "d8b2ef1a-6030-596e-a005-73ebc092862b",
  "slug": "megans-granola",
  "name": "Megan's Granola",
  "recipe_type": "dessert",
  "brief_description": "This granola recipe is packed with healthy toasted oats, crunchy nuts, and seeds sweetened with maple syrup for a delicious homemade breakfast cereal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line two large baking sheets with parchment paper or aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine oats, wheat germ, oat bran, sunflower seeds, almonds, pecans, and walnuts in a large bowl."
    },
    {
      "position": 3,
      "text": "Stir oil, honey, brown sugar, maple syrup, cinnamon, vanilla, and salt together in a saucepan over medium heat. Bring to a boil, then pour over dry ingredients and stir to coat. Transfer to the prepared baking sheets and spread out evenly."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crispy and toasted, about 20 minutes, stirring once halfway through. Let cool for 15 to 20 minutes, then stir in raisins."
    }
  ],
  "servings": 34,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d8e0f93c-20bc-5bb5-bfe2-b995c6a916b3",
  "slug": "no-egg-chocolate-mug-cake",
  "name": "No Egg Chocolate Mug Cake",
  "recipe_type": "dessert",
  "brief_description": "This easy eggless mug cake is made with cocoa powder, chocolate chips, and sliced almonds. It cooks in the microwave in just 3 minutes or less.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, milk, cocoa powder, olive oil, and baking powder in a large mug until well combined. Stir in chocolate chips and almonds."
    },
    {
      "position": 3,
      "text": "Place mug in the microwave and cook until cake has risen by 50 percent, 30 seconds to 2 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 2,

  "id": "297316a8-9e5f-55d6-a8dd-b2b3b1e0c235",
  "slug": "spicy-green-tomato-salsa",
  "name": "Spicy Green Tomato Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This green tomato salsa with cilantro and lime juice is a great way to use up those green tomatoes; jalape\u00f1o and serrano peppers add a fiery kick.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine green tomatoes, onions, jalape\u00f1o peppers, serrano peppers, and red bell pepper in a large bowl."
    },
    {
      "position": 3,
      "text": "Mix cilantro, sugar, garlic, oregano, and cayenne pepper together in a small bowl."
    },
    {
      "position": 4,
      "text": "Fill a blender with about 2 cups tomato mixture, 1 teaspoon lime juice, and 1/4 of the spice mixture; blend to desired consistency and pour into a large bowl."
    },
    {
      "position": 5,
      "text": "Repeat blending with remaining tomato mixture, lime juice, and spice mixture, working in batches, until all ingredients are blended. Stir vinegar into salsa."
    },
    {
      "position": 6,
      "text": "Portion salsa into bags and store in the freezer or refrigerator."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": null,

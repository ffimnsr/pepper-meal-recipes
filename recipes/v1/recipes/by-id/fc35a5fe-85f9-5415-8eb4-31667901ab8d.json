  "id": "fc35a5fe-85f9-5415-8eb4-31667901ab8d",
  "slug": "red-velvet-neiman-marcus-cake-recipe-11922375",
  "name": "Red Velvet Neiman Marcus Cake",
  "recipe_type": "dessert",
  "brief_description": "This red velvet Neiman Marcus cake is a dense, moist snacking cake with a creamy, cheesy vanilla cheesecake layer on top. If that sounds complicated, it really is not, and this cake is so tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Generously grease a 9-inch square baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir cake mix, oil, and 2 eggs in a large bowl until well combined. The batter will be very thick. Transfer cake batter to the prepared baking pan, spreading it into an even layer."
    },
    {
      "position": 3,
      "text": "Whisk confectioner's sugar, cream cheese, butter, vanilla, and remaining 2 eggs in a separate bowl, until fully combined and no lumps remain. Spread evenly over the top of the cake batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are set, top is golden brown, and the center has a slight jiggle, 40 to 45 minutes. Let cake cool completely on a wire rack before slicing, about 1 \u00bd hours. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "9d8efd22-3e04-5a38-8518-542812b50ccf",
  "slug": "easy-eggnog-creme-brulee",
  "name": "Easy Eggnog Creme Brulee",
  "recipe_type": "dessert",
  "brief_description": "The flavors of eggnog lend delicious spice and depth to traditional creme brulee in this simple, festive recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks and 1 tablespoon sugar together in a bowl until sugar is dissolved. Whisk in eggnog, cream, and vanilla extract until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Pour eggnog mixture into 4 ramekins. Place ramekins in baking dish; pour in enough boiling water to come half way up the sides of ramekins."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until set, about 1 hour. Cool slightly, cover ramekins with plastic wrap, and refrigerate at least 4 hours."
    },
    {
      "position": 5,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 6,
      "text": "Remove plastic wrap from ramekins. Sprinkle 1 tablespoon of sugar in a thin layer over top of each ramekin. Brown the sugar using a kitchen torch or under a broiler until golden and caramelized, 30 seconds to 1 minute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

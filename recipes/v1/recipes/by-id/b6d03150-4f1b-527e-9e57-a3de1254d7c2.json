  "slug": "arugula-caprese-salad",
  "name": "Arugula Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "Peppery arugula adds a zingy bite to this fresh tomato and mozzarella salad.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss arugula, tomatoes, mozzarella cheese balls, and croutons in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk basil paste into the balsamic salad dressing; pour on salad and toss to combine. Season salad with salt and black pepper, if desired."
    }
  ],

  "id": "a1f3280c-5eb7-524b-95e0-b7b3019ec3d5",
  "slug": "everything-bagel-seasoned-chicken-casserole-recipe-7969090",
  "name": "Everything Bagel Seasoned Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This everything bagel seasoned chicken casserole features artichoke spinach dip for minimal prep and maximum flavor. With orzo and a crispy crumb topping, this is comfort food in a casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 12x8-inch casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Add orzo into the casserole dish. Pour in chicken broth. Add spinach artichoke dip, minced garlic, and crushed red pepper flakes; stir to combine."
    },
    {
      "position": 3,
      "text": "Season chicken with salt and Italian seasoning. Add chicken to the casserole dish; cover with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until orzo is tender with a bite, and chicken is no longer pink at the center, about 45 minutes. An instant-read thermometer inserted near the center of chicken should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove casserole from the oven, uncover, and sprinkle evenly with panko, mozzarella cheese, and bagel seasoning."
    },
    {
      "position": 6,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Broil casserole until topping is golden, about 5 minutes. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

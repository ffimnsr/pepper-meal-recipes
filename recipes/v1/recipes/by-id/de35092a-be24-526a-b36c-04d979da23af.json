  "id": "de35092a-be24-526a-b36c-04d979da23af",
  "slug": "easy-white-chocolate-oreo-truffles",
  "name": "Easy White Chocolate Oreo Truffles",
  "recipe_type": "dessert",
  "brief_description": "Cream cheese Oreo balls dipped in white chocolate! These truffles are easy to make and can be customized for any occasion with food coloring.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a large baking sheet with waxed paper."
    },
    {
      "position": 2,
      "text": "Place all cookies in a food processor; pulse into fine crumbs."
    },
    {
      "position": 3,
      "text": "Transfer cookie crumbs to a large bowl. Add cream cheese and beat with an electric mixer until a soft dough forms, scraping down the sides of the bowl and the beaters as needed to ensure even mixing."
    },
    {
      "position": 4,
      "text": "Roll dough mixture into 1-inch balls. Place balls onto the prepared baking sheet and refrigerate until firm, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Place white chocolate into a microwave-safe glass or ceramic bowl; microwave in 1-minute intervals, stirring after each interval, until melted, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Use two forks to dip each ball into melted chocolate; turn until ball is coated, then lift, letting excess chocolate drip back into the bowl, and return to the waxed paper. Refrigerate until chocolate coating is set, about 30 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

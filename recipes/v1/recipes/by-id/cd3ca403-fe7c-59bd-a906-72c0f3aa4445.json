  "id": "cd3ca403-fe7c-59bd-a906-72c0f3aa4445",
  "slug": "tex-mex-air-fryer-hash-browns",
  "name": "Tex-Mex Air Fryer Hash Browns",
  "recipe_type": "breakfast",
  "brief_description": "Use an air fryer to make this crispy, tasty potato hash featuring bell peppers and jalapenos with Tex-Mex seasoning.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Soak potatoes in cool water for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the air fryer to 320 degrees F (160 degrees C). Drain the potatoes, dry them with a clean towel, and transfer to a large bowl. Drizzle 1 tablespoon olive oil over the potatoes and toss to coat. Add them to the preheated air fryer basket. Set the timer for 18 minutes."
    },
    {
      "position": 3,
      "text": "Put bell pepper, onion, and jalapeno in the bowl previously used for the potatoes. Sprinkle in 1/2 teaspoon olive oil, taco seasoning, ground cumin, salt, and pepper. Toss to coat."
    },
    {
      "position": 4,
      "text": "Transfer potatoes from the air fryer to the bowl with the vegetable mixture. Return the empty basket to the air fryer and raise the temperature to 356 degrees F (180 degrees C)."
    },
    {
      "position": 5,
      "text": "Quickly toss the contents of the bowl to mix the potatoes evenly with the vegetables and seasoning. Transfer mixture into the basket. Cook for 6 minutes, shake the basket, and continue cooking until potatoes are browned and crispy, about 5 minutes more. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

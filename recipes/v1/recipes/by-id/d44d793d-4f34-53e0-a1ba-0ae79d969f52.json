  "id": "d44d793d-4f34-53e0-a1ba-0ae79d969f52",
  "slug": "butternut-squash-carrot-soup",
  "name": "Butternut Squash Carrot Soup",
  "recipe_type": "soup",
  "brief_description": "This butternut squash and carrot soup recipe yields a smooth pur\u00e9e flavored with honey, ginger, and curry powder. It's a great cold weather dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Add shallots, carrots, garlic, and ginger; cook and stir until shallots are soft, 5 to 10 minutes. Add squash, chicken broth, curry powder, honey, white pepper, and cayenne pepper; bring to a boil. Reduce heat, cover, and simmer until squash is soft, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Pur\u00e9e soup with an immersion blender until smooth. Cook until warmed through, about 3 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

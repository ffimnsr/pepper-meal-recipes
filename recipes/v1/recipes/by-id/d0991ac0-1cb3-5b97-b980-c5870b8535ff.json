{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d0991ac0-1cb3-5b97-b980-c5870b8535ff",
  "slug": "air-fryer-everything-bagel-chicken-cutlets-recipe-11737038",
  "name": "Air Fryer Everything Bagel Chicken Cutlets",
  "recipe_type": "dessert",
  "brief_description": "These air fryer everything bagel chicken cutlets, breaded with everything-seasoned panko breadcrumbs and air fried, are drizzled with a spicy-sweet ginger garlic sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C), or according to manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Pat chicken cutlets dry with paper towels; season lightly with salt and pepper. Place flour in a resealable plastic bag; set aside."
    },
    {
      "position": 3,
      "text": "Beat eggs with milk until well blended in a shallow bowl. On a plate, stir everything bagel seasoning and panko together."
    },
    {
      "position": 4,
      "text": "Add cutlets to the bag with flour. Seal the bag and toss until cutlets are coated."
    },
    {
      "position": 5,
      "text": "Working with 1 cutlet at a time, shake off any extra flour, dip each cutlet into egg mixture, and shake off any excess. Press each cutlet into panko mixture, then turn and press crumbs into the other side to adhere. Place breaded cutlets on a sheet of parchment; continue until all cutlets are coated."
    },
    {
      "position": 6,
      "text": "Generously spray each cutlet with olive oil spray on both sides, and place cutlets in the air fryer in a single layer, working in batches if needed."
    },
    {
      "position": 7,
      "text": "Air fry for 8 to 12 minutes, turning over halfway through, if desired. Thin cutlets will take less time, and thick cutlets will take more. An instant read thermometer inserted near the center should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 8,
      "text": "Meanwhile, for glaze, combine rice vinegar, water, brown sugar, Sriracha, ginger, garlic, and soy sauce in a small saucepan and bring to a boil over medium heat. Reduce heat, and simmer until barely thickened, 3 to 5 minutes."
    },
    {
      "position": 9,
      "text": "Drizzle each cutlet with glaze and serve warm. Garnish with fresh parsley sprigs."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

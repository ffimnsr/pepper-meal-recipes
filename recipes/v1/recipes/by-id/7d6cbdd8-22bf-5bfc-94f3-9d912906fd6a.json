  "id": "7d6cbdd8-22bf-5bfc-94f3-9d912906fd6a",
  "slug": "chicken-bacon-caesar-sandwich-recipe-11887238",
  "name": "Chicken Bacon Caesar Sandwich",
  "recipe_type": "salad",
  "brief_description": "This chicken bacon Caesar sandwich is served in a bun, drizzled with Caesar dressing, piled with sliced sauteed chicken and a scoop of Caesar salad, and finished with Parmesan and bacon\u2014so good!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 2,
      "text": "Season chicken with garlic, thyme, salt, and pepper. Heat olive oil in a skillet over medium-high heat, and cook chicken until no longer pink in the center and juices run clear, about 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Meanwhile, prepare Caesar salad kit according to package directions."
    },
    {
      "position": 4,
      "text": "Once chicken is done, remove to a board, and allow to cool slightly, about 5 minutes. Slice chicken and squeeze lemon juice over the top."
    },
    {
      "position": 5,
      "text": "Cut bun in half, drizzle with olive oil, and add Caesar dressing, chicken, a scoop of salad, sliced Parmesan, and bacon. Add the top of bun."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

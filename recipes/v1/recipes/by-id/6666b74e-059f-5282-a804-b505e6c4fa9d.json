  "id": "6666b74e-059f-5282-a804-b505e6c4fa9d",
  "slug": "creamy-lemon-parmesan-chicken-recipe-7555287",
  "name": "Creamy Lemon Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "This lemon Parmesan chicken dish features boneless chicken thighs simmered in a deliciously rich and creamy cheese sauce flavored with garlic, lemon, and oregano.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine 1/4 cup Parmesan cheese and flour in a shallow dish."
    },
    {
      "position": 3,
      "text": "Sprinkle chicken with salt and pepper. Dredge chicken in flour mixture to coat."
    },
    {
      "position": 4,
      "text": "Heat oil in a 12-inch skillet over medium-high heat. Add chicken, half at a time, and brown well, 3 to 4 minutes per side. Remove chicken from skillet."
    },
    {
      "position": 5,
      "text": "Add garlic to skillet and cook over medium until fragrant, about 1 minute."
    },
    {
      "position": 6,
      "text": "Whisk together broth, mascarpone, lemon zest, lemon juice, and remaining 1/2 cup Parmesan cheese in a medium bowl. Add to skillet. Bring to a boil."
    },
    {
      "position": 7,
      "text": "Whisk together cornstarch and water in a small bowl. Add to skillet, stirring until thickened and bubbly."
    },
    {
      "position": 8,
      "text": "Return chicken to skillet, return to boiling. Reduce heat, cover and simmer until chicken is no longer pink (170\u00b0F), 5 to 6 minutes."
    },
    {
      "position": 9,
      "text": "Slice chicken and return to sauce."
    },
    {
      "position": 10,
      "text": "Serve mixture topped with fresh oregano. Serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "slug": "gingersnap-cheesecake-crust",
  "name": "Gingersnap Cheesecake Crust",
  "recipe_type": "dessert",
  "brief_description": "This gingersnap cheesecake crust made with just four ingredients is a snap to prepare. A delicious way to start any cheesecake!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9-inch springform pan."
    },
    {
      "position": 2,
      "text": "Combine gingersnap crumbs, sugar, melted butter, and salt in a bowl. Press onto the bottom and 1 inch up the sides of the prepared pan. Fill right away or chill crust for up to 2 hours."
    }
  ],
  "servings": 8,

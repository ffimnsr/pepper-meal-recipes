  "id": "e0decb6e-78d5-5056-b3fb-45a674af4f4d",
  "slug": "easy-chicken-rice-and-noodle-soup-recipe-11702264",
  "name": "Easy Chicken, Rice, and Noodle soup",
  "recipe_type": "soup",
  "brief_description": "This easy chicken, rice, and noodle soup features fresh mushrooms and rotisserie chicken. With only a few fresh veggies to chop, this is perfect for days when you are short on time in the kitchen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter in a large stockpot over medium-high heat. Add onion, celery, carrots, and mushrooms. Cook until onions are translucent, about 4 minutes."
    },
    {
      "position": 2,
      "text": "Add broth and chicken. Bring to a boil."
    },
    {
      "position": 3,
      "text": "Add rice packet, reduce heat, and simmer 8 minutes. Turn heat off and let stand for 8 minutes. Ladle into bowls and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

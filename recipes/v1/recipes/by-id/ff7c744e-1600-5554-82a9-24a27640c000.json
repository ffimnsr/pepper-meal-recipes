  "id": "ff7c744e-1600-5554-82a9-24a27640c000",
  "slug": "sardine-pasta-recipe-11967464",
  "name": "Sardine Pasta",
  "recipe_type": "main",
  "brief_description": "This sardine pasta, with fresh and sun-dried tomatoes, artichokes, and hints of lemon and garlic, is a light yet flavorful dish that\u2019s made for summer dinners on the porch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil; add spaghetti and cook until tender with a bite, about 10 minutes. Reserve 1 cup pasta water, then drain spaghetti and keep warm."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a cast iron skillet with olive oil over medium heat. Add onions, garlic, and tomatoes. Stir and cook until tomatoes begin to burst, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add olives and artichokes. Stir and cook for 2 to 3 minutes. Stir in lemon juice."
    },
    {
      "position": 4,
      "text": "Add sardines and another tablespoon olive oil, if needed. Stir sardines gently into the sauce, just until well combined."
    },
    {
      "position": 5,
      "text": "Add Greek seasoning, pasta water, and spinach to the sardine mixture and mix until combined. Add in pasta a little at a time and toss well. Add sun-dried tomatoes and fresh thyme; remove from heat."
    },
    {
      "position": 6,
      "text": "Once plated, drizzle with olive oil, sprinkle with lemon zest, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

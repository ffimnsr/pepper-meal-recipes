  "id": "18ca0174-81e8-5ded-b541-b9577cbba312",
  "slug": "peppermint-meringues",
  "name": "Peppermint Meringues",
  "recipe_type": "dessert",
  "brief_description": "These peppermint meringue cookies are topped with crushed peppermint candy for a deliciously minty sweet treat perfect for the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 225 degrees F (110 degrees C). Line 2 cookie sheets with foil or parchment paper."
    },
    {
      "position": 2,
      "text": "In a large glass or metal mixing bowl, beat egg whites, salt, and cream of tartar to soft peaks. Gradually add sugar, continuing to beat until whites form stiff peaks. Drop by spoonfuls 1 inch apart on the prepared cookie sheets. Sprinkle crushed peppermint candy over the cookies."
    },
    {
      "position": 3,
      "text": "Bake for 1 \u00bd hours in preheated oven. Meringues should be completely dry on the inside. Do not allow them to brown. Turn off oven. Keep oven door ajar, and let meringues sit in the oven until completely cool. Loosen from foil with metal spatula. Store loosely covered in cool dry place for up to 2 months."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "0165f998-c259-5e4e-a5bc-59759287a886",
  "slug": "no-bake-granola-bars",
  "name": "No Bake Granola Bars",
  "recipe_type": "appetizer",
  "brief_description": "These no-bake granola bars make a perfect on-the-go snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Stir oats, peanut butter, flaxseed, honey, cranberries, chocolate chips, and almonds together in a bowl; press into a 9x11-inch baking dish, using the back of a spatula to press into a flat layer."
    },
    {
      "position": 3,
      "text": "Refrigerate mixture at least 1 hour."
    },
    {
      "position": 4,
      "text": "Cut into 12 bars and wrap each individually in plastic wrap for storage."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

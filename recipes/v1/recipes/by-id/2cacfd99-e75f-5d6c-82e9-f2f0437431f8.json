  "slug": "mango-relish",
  "name": "Mango Relish",
  "recipe_type": "dessert",
  "brief_description": "The sweet flavors of this mango relish create a zesty accompaniment to fish or chicken. Try pairing with Thai, Indian, or Caribbean dishes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine mango, oil, bell pepper, scallions, cilantro, and lime juice in a small bowl. Stir to combine. Season with salt, pepper, and honey. Refrigerate or serve immediately."
    }
  ],

  "id": "3bf4f76e-6a80-5639-bbce-621111263b3f",
  "slug": "oven-roasted-lamb-ribs",
  "name": "Oven-Roasted Lamb Ribs",
  "recipe_type": "dessert",
  "brief_description": "These lamb ribs are marinated in a sweet and savory mixture of mustard, molasses, and warm spices then oven-roasted until sticky and tender.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Wash ribs thoroughly. Soak in a large bowl of water, changing the water every 30 minutes, to remove excess fat, about 2 hours. Drain and pat dry with paper towels."
    },
    {
      "position": 2,
      "text": "Mix lemon juice, molasses, vinegar, mustard, ketchup, cinnamon, curry powder, cumin, salt, and pepper in a large, deep bowl."
    },
    {
      "position": 3,
      "text": "Combine onion, tomatoes, sweet peppers, parsley, garlic, and cayenne pepper in a food processor; pulse to form a paste."
    },
    {
      "position": 4,
      "text": "Stir onion paste into the lemon juice mixture in the bowl. Add lamb ribs; turn to coat. Cover with plastic wrap. Marinate in the refrigerator, at least 10 hours."
    },
    {
      "position": 5,
      "text": "Preheat oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 6,
      "text": "Line a large baking sheet with aluminum foil and set a rack on top. Arrange ribs on the rack."
    },
    {
      "position": 7,
      "text": "Bake ribs in the preheated oven until fat has rendered and meat is tender, 1 1/2 to 2 hours. Cover ribs with aluminum foil and let rest for 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "expert",

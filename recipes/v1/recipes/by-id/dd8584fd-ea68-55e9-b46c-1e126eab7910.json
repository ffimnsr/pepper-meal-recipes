{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "dd8584fd-ea68-55e9-b46c-1e126eab7910",
  "slug": "golabki-stuffed-cabbage-rolls",
  "name": "Golabki (Stuffed Cabbage Rolls)",
  "recipe_type": "soup",
  "brief_description": "This golabki recipe features tender cabbage rolls that are stuffed with a savory mixture of ground beef, pork, and spices, then simmered in tomato soup.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Place cabbage head into the pot, cover, and cook until leaves are softened enough to remove from the head, about 3 minutes. Remove cabbage from the pot and let sit until leaves are cool enough to handle, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Remove 18 whole leaves from the cabbage head, cutting out any thick tough center ribs. Set whole leaves aside. Chop the remaining cabbage and spread it in the bottom of a casserole dish."
    },
    {
      "position": 3,
      "text": "Melt butter in a large skillet over medium-high heat. Add onion and saut\u00e9 until tender, 5 to 10 minutes. Remove from the heat and let cool, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Combine beef, pork, cooked rice, garlic, salt, and pepper in a large bowl. Add onion and mix until well combined."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Place about 1/2 cup beef mixture onto a cabbage leaf. Roll the leaf around beef mixture, tucking in the sides to create an envelope around the meat. Repeat to make remaining cabbage rolls. Place cabbage rolls in a layer over chopped cabbage in the casserole dish. Season with salt and pepper."
    },
    {
      "position": 7,
      "text": "Whisk condensed soup, tomato juice, and ketchup together in a bowl; pour over cabbage rolls and cover the dish tightly with aluminum foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until cabbage is tender and meat is cooked through, about 1 hour. Uncover for the last 20 to 30 minutes of cooking. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

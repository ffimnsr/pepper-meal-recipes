  "id": "abdb8018-7270-5891-a65a-63af2d3db920",
  "slug": "grilled-mushroom-swiss-burgers",
  "name": "Mushroom Swiss Burger",
  "recipe_type": "main",
  "brief_description": "A satisfying mushroom Swiss burger, made with a juicy homemade beef patty, topped with savory sliced mushrooms and gooey melted Swiss cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Divide ground beef into 6 equal-sized patties; season with meat tenderizer, salt, and pepper. Set aside."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium heat. Add mushrooms and soy sauce; cook and stir until browned. Set aside and keep warm."
    },
    {
      "position": 4,
      "text": "Grill patties on the preheated grill for about 2-4 minutes per side. Increase or decrease the cook time according to your desired doneness. For a well done burger, an instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    },
    {
      "position": 5,
      "text": "Spoon mushroom mixture evenly on top of patties on the grill; top each one with a slice of Swiss cheese. Cover the grill until cheese melts, about 1 minute."
    },
    {
      "position": 6,
      "text": "Remove patties from the grill and serve on hamburger buns."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

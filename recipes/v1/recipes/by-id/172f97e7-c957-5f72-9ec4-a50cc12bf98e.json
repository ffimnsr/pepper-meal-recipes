  "id": "172f97e7-c957-5f72-9ec4-a50cc12bf98e",
  "slug": "jalapeno-popper-risotto",
  "name": "Jalapeno Popper Risotto",
  "recipe_type": "main",
  "brief_description": "Made with Greek yogurt, this risotto contains all of the delicious flavor of a jalapeno popper in a wholesome, dinner-friendly form.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable broth in a pot over medium-high heat until boiling; reduce heat to a simmer."
    },
    {
      "position": 2,
      "text": "Heat a heavy-bottomed pot over medium heat. Add rice and begin to toast, flipping it to ensure it toasts evenly. Continue until rice becomes golden and fragrant, about 10 minutes. Do not burn."
    },
    {
      "position": 3,
      "text": "Remove rice from the pot. Add jalapeno and vegetable oil. Saute over medium heat until softened, about 8 minutes. Add toasted rice and stir to absorb the jalapeno flavor."
    },
    {
      "position": 4,
      "text": "Stir 1/2 cup heated broth into the rice mixture until broth is absorbed. Continue adding broth, 1/2 cup at a time, stirring continuously, until liquid is absorbed and rice has doubled in size. Add Greek yogurt. Mix well until melted and incorporated, adding more broth as necessary until rice is al dente."
    },
    {
      "position": 5,
      "text": "Turn off heat and add pepper Jack cheese, saving 1 to 2 teaspoons as garnish. Wait until starches settle, about 2 minutes. Distribute evenly between 4 plates. Top with reserved pepper Jack cheese. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

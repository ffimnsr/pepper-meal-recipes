  "id": "76c6f19d-2bba-5fa0-9d78-bb6abe538487",
  "slug": "moms-nova-scotia-seafood-chowder",
  "name": "Mom's Nova Scotia Seafood Chowder",
  "recipe_type": "soup",
  "brief_description": "This seafood chowder recipe makes a deliciously creamy soup loaded with fish and shellfish including salmon, shrimp, scallops, clams, and lobster.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot halfway with lightly salted water; bring to a boil. Add onions and carrots; cook until slightly tender, 10 minutes."
    },
    {
      "position": 3,
      "text": "Add potatoes; cook until tender, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Stir in salmon, cod, scallops, shrimp, lobster, and crab; cook over medium heat until salmon and cod are firm but chunks are still slightly translucent in the center, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Drain half the water from the pot and add clams, heavy cream, and half-and-half. Place butter chunks atop the soup; season with salt and black pepper."
    },
    {
      "position": 6,
      "text": "Cover and simmer, stirring occasionally, until salmon and cod are fully cooked and flake easily with a fork, about 30 minutes. Do not boil once cream is added."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 25,

  "schema_version": 1,
  "id": "047b9d7d-2e78-5b23-a597-a1c9a5da76d6",
  "slug": "awesome-carrot-cake-with-cream-cheese-frosting",
  "name": "Carrot Cake with Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "This moist carrot cake with fluffy cream cheese frosting and chopped pecans is easy to make at home for a delicious dessert at Easter or any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Combine grated carrots, flour, white sugar, baking soda, baking powder, salt, and cinnamon in a large bowl; stir in eggs, oil, 1 \u00bc teaspoons vanilla, pineapple, and \u00be cup chopped pecans. Spoon batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 30 to 40 minutes. Let cake cool."
    },
    {
      "position": 4,
      "text": "To make the frosting: Combine confectioners' sugar, Neufchatel cheese, \u00bd cup butter and 1 \u00bc teaspoons vanilla in a medium bowl; beat until smooth. Fold in 1 cup chopped pecans. Spread frosting on cooled cake."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

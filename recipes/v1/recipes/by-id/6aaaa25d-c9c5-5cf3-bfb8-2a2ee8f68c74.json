  "id": "6aaaa25d-c9c5-5cf3-bfb8-2a2ee8f68c74",
  "slug": "the-best-slow-cooker-baked-beans-dads-recipe",
  "name": "The Best Slow Cooker Baked Beans (Dad's Recipe)",
  "recipe_type": "side",
  "brief_description": "Navy beans and salt pork are simmered in a brown sugar-molasses sauce creating the best slow cooker baked beans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the navy beans into a large container and cover with several inches of cool water; let stand 8 hours to overnight. Drain and transfer beans to a pot; add enough water to cover beans."
    },
    {
      "position": 2,
      "text": "Bring water to a boil, reduce heat, cover pot, and simmer until beans are slightly tender, about 1 hour."
    },
    {
      "position": 3,
      "text": "Mix 4 cups water, molasses, brown sugar, salt, mustard, and pepper together in a bowl until smooth."
    },
    {
      "position": 4,
      "text": "Mix beans, salt pork, and onion together in a slow cooker. Add molasses mixture and more water to cover beans if needed; stir well."
    },
    {
      "position": 5,
      "text": "Cook on Low for 8 to 10 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 540,

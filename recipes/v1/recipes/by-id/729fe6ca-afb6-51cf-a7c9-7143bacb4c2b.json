  "id": "729fe6ca-afb6-51cf-a7c9-7143bacb4c2b",
  "slug": "creamy-banana-bread",
  "name": "Creamy Banana Bread",
  "recipe_type": "breakfast",
  "brief_description": "A ribbon of pecan streusel runs through this rich cream cheese-banana bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Cream the margarine and cream cheese together. Gradually add the white sugar, and continue beating until light and fluffy. Add eggs one at a time, beating well after each addition. Stir in the mashed bananas and vanilla. Add flour, baking powder, and baking soda; mix until batter is just moist."
    },
    {
      "position": 3,
      "text": "In a small bowl, mix together chopped pecans, 2 tablespoons brown sugar, and cinnamon."
    },
    {
      "position": 4,
      "text": "Divide half the batter between the two prepared loaf pans. Sprinkle pecan mixture over the batter in the pans, and top with remaining batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of each loaf comes out clean, about 45 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,

  "id": "75525359-ad61-5855-9000-c300bf091ad3",
  "slug": "grilled-garlic-butter-artichokes-recipe-6577750",
  "name": "Grilled Garlic Butter Artichokes",
  "recipe_type": "side",
  "brief_description": "These flavorful artichokes are brushed with garlic butter; grilling adds the perfect smoky flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil; add artichokes and season with salt and pepper. Throw in half of garlic and half of shallot. Boil until a fork is easily inserted into the stem of the artichokes, about 30 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for low heat."
    },
    {
      "position": 3,
      "text": "Melt butter in a small pan over medium heat, and stir in remaining garlic and shallot. Cook just until fragrant, then remove from the heat."
    },
    {
      "position": 4,
      "text": "Place artichoke halves onto the preheated grill. Brush some of the melted butter onto them. Cook for 5 to 10 minutes, brushing with butter occasionally, until lightly toasted. Serve with remaining butter as a dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "804d47d2-4a1b-5fa3-aa3b-084f642e35d9",
  "slug": "pesto-pasta-with-chicken",
  "name": "Pesto Pasta with Chicken",
  "recipe_type": "main",
  "brief_description": "Easy chicken pesto pasta recipe made with saut\u00e9ed garlic chicken tossed with bow tie pasta, sun-dried tomatoes, and pesto sauce, ready in 30 minutes.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Saut\u00e9 garlic until tender."
    },
    {
      "position": 4,
      "text": "Stir in chicken and season with red pepper flakes. Cook until chicken is golden and cooked through."
    },
    {
      "position": 5,
      "text": "Combine pasta, chicken, pesto, and sun-dried tomatoes in a large bowl; toss to coat evenly."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "slug": "the-best-ground-beef-taco-meat-recipe-11781080",
  "name": "The Best Ground Beef Taco Meat",
  "recipe_type": "main",
  "brief_description": "This recipe for the best ground beef taco meat is a keeper, the basic recipe you need to make tacos at home.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add beef and cook, breaking up clumps with a spatula, until fat renders out and beef begins to brown, about 4 minutes. Add onion and cook, stirring constantly until onion is softened and beef is crumbly, about 4 minutes. Drain fat if desired."
    },
    {
      "position": 2,
      "text": "Add desired amount of taco seasoning and cook 1 minute. Add in tomato paste and water and cook, using a spoon to loosen any browned bits from the pan, and stir until well combined. Reduce heat to medium-low and simmer until thickened, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil; stir in sugar until dissolved. Add corn; cover the pot. Turn off the heat, leaving the pot on the hot burner; steep corn in hot water until tender, about 25 minutes. Drain."
    }

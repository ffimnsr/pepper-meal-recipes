  "slug": "spicy-tuna-and-hummus-salad",
  "name": "Spicy Tuna and Hummus Salad",
  "recipe_type": "salad",
  "brief_description": "Hummus replaces mayo in this recipe for a spicy, flavorful twist on everyone's favorite sandwich filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Drain roasted red peppers and pat dry. Puree in a food processor until finely chopped."
    },
    {
      "position": 2,
      "text": "Transfer roasted red peppers to a bowl. Add tuna, hard-boiled eggs, hummus, green onions, celery, Sriracha sauce, capers, and seafood seasoning. Mix together. Divide into individual 1-cup portions and refrigerate."
    }
  ],
  "servings": 4,

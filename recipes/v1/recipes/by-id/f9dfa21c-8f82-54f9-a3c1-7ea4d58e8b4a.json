  "id": "f9dfa21c-8f82-54f9-a3c1-7ea4d58e8b4a",
  "slug": "instant-pot-cherry-orange-cranberry-sauce",
  "name": "Instant Pot Cherry-Orange Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "This cranberry sauce practically makes itself! It's quick, and you won't have to keep a constant eye on it. Substitute the water for apple or orange juice.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, cherries, water, cinnamon, and salt in the inner pot of a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 2 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 5 minutes. Switch to the quick-release method according to manufacturer's instructions to release remaining pressure, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 3,
      "text": "Select Saute function and low heat. Add orange marmalade and brown sugar to the cranberry mixture. Cook and stir to combine, breaking up cranberries, 2 to 3 minutes. Turn off Instant Pot and let cranberry sauce cool. Sauce will thicken upon cooling. Store in the refrigerator. For best flavor, bring to room temperature before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

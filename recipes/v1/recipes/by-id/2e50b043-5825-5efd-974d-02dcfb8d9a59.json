  "id": "2e50b043-5825-5efd-974d-02dcfb8d9a59",
  "slug": "skin-on-savory-mashed-potatoes",
  "name": "Skin-On Savory Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These mashed potatoes with skin provide added nutrition in every bite and can be made with any type of spud for a simple and delicious side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook potatoes in boiling water until tender, about 15 minutes. Drain and transfer potatoes to a large bowl."
    },
    {
      "position": 2,
      "text": "Add butter to the bowl; use a potato masher or electric mixer to mash potato mixture until mostly smooth. Add milk and sour cream; continue mashing to desired texture. Be careful not to overmix potatoes once they are creamy."
    },
    {
      "position": 3,
      "text": "Stir garlic and basil into mashed potatoes. Season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

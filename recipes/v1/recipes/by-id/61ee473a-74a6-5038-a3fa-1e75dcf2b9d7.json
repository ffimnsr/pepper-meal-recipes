  "id": "61ee473a-74a6-5038-a3fa-1e75dcf2b9d7",
  "slug": "lime-sherbet-punch",
  "name": "Lime Sherbet Punch",
  "recipe_type": "dessert",
  "brief_description": "A festive, tangy lime sherbert punch made with green sherbet, pineapple juice, and ginger ale that you can make for your guests in just a few minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Scoop lime sherbet into a punch bowl."
    },
    {
      "position": 3,
      "text": "Pour in ginger ale and pineapple juice."
    },
    {
      "position": 4,
      "text": "Stir well."
    },
    {
      "position": 5,
      "text": "Stir in maraschino cherries and float lemon and lime slices in the punch."
    }
  ],
  "servings": 18,

  "id": "151ea1d7-3123-538a-a74b-ef5c3cde8123",
  "slug": "lemon-chicken-gnocchi-recipe-11810480",
  "name": "Lemon Chicken Gnocchi",
  "recipe_type": "main",
  "brief_description": "In this lemon chicken gnocchi, thinly sliced chicken breasts, lightly seasoned and pan-seared to perfection is served with tender gnocchi tossed in a vibrant creamy lemon pan sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium high heat. Melt butter with olive oil in the skillet."
    },
    {
      "position": 2,
      "text": "Thinly slice chicken breast at a 45-degree angle to create medallions. Stir paprika, oregano, salt, and pepper together in a small bowl; sprinkle seasoning over chicken medallions."
    },
    {
      "position": 3,
      "text": "Cook medallions until lightly browned and no longer pink at the center, about 2 minutes on each side; transfer to a plate and keep warm."
    },
    {
      "position": 4,
      "text": "For lemon cream sauce, saute garlic in the same skillet without wiping out the skillet. Add in gnocchi; bone broth, milk, and heavy cream and simmer for about 7 minutes. Stir in half of lemon juice and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Taste the sauce, add in remaining lemon juice until desired flavor is achieved and season with salt and pepper. Return chicken medallions to the dish. Garnish with basil and serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

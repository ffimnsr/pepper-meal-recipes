  "id": "b2a46323-3ae4-58db-b690-ad97069e72fb",
  "slug": "strachan-fresh-cranberry-orange-relish",
  "name": "Strachan Fresh Cranberry Orange Relish",
  "recipe_type": "dessert",
  "brief_description": "Cranberry orange relish with an added crunch of walnuts and a helping of triple sec is a sweet accompaniment to turkey, pork, or biscuits.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place cranberries in food processor; pulse until evenly chopped. Transfer to a mixing bowl."
    },
    {
      "position": 2,
      "text": "Quarter the orange and place in the food processor with walnuts; pulse until finely chopped. Add to bowl with cranberries."
    },
    {
      "position": 3,
      "text": "Mix sugar, cinnamon, nutmeg, and triple sec into cranberry-orange mixture until coated. Cover and refrigerate at least 1 hour before serving."
    }
  ],
  "servings": 12,

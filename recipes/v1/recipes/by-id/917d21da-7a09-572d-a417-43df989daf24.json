  "name": "Whipped Lemonade",
  "recipe_type": "dessert",
  "brief_description": "This 3-ingredient whipped lemonade, made with freshly-squeezed lemon juice, cream, and sweetened condensed milk, blends into a frothy, summery, creamy lemonade drink in seconds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine heavy cream, lemon juice, sweetened condensed milk, and ice in a blender cup. Blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour into glasses and serve immediately."
    }
  ],

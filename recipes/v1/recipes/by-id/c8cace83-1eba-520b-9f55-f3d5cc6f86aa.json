  "id": "c8cace83-1eba-520b-9f55-f3d5cc6f86aa",
  "slug": "mamas-fab-u-lous-fajitas",
  "name": "Mama's Fab-u-lous Fajitas",
  "recipe_type": "drink",
  "brief_description": "Mama's fabulous quick and easy steak fajitas recipe features a marinade made with lime juice, cilantro, cumin, and jalape\u00f1o for amazing flavor.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk lime juice, cilantro, olive oil, jalape\u00f1o, garlic, and cumin together in a large glass or ceramic bowl until well combined. Add skirt steak, bell peppers, and onion; toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator, 30 minutes to 2 hours."
    },
    {
      "position": 2,
      "text": "Remove steak, bell peppers, and onion from marinade and shake off excess; discard remaining marinade."
    },
    {
      "position": 3,
      "text": "Heat 1 teaspoon vegetable oil in a large skillet over high heat until oil shimmers. Add steak; cook and stir until browned on all sides and still pink in center, about 3 minutes per side. Transfer steak to a plate, tent with aluminum foil, and rest for 5 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat remaining 1 teaspoon oil in the same skillet over medium-high heat. Add bell peppers and onion; cook until just tender but still crisp to the bite, 5 to 6 minutes. Return steak to the skillet; cook and stir until heated through."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

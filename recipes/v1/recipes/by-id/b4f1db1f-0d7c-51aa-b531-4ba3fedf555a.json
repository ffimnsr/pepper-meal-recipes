  "id": "b4f1db1f-0d7c-51aa-b531-4ba3fedf555a",
  "slug": "hush-puppies",
  "name": "Hush Puppies",
  "recipe_type": "appetizer",
  "brief_description": "These hush puppies are made from a simple batter with a hint of celery and garlic. They are quick and easy and ready in less than 30 minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, cornmeal, onion, milk, egg, celery, garlic, and Cajun seasoning in a bowl."
    },
    {
      "position": 3,
      "text": "Drop ping pong ball-sized balls of batter, about 5 at a time, into the hot oil. Fry until golden brown, about 5 minutes. Remove hush puppies with a slotted spoon and drain on a paper towel-lined plate. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

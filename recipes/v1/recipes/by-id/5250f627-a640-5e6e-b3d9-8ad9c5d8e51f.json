{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5250f627-a640-5e6e-b3d9-8ad9c5d8e51f",
  "slug": "chef-johns-pasta-primavera",
  "name": "Chef John's Pasta Primavera",
  "recipe_type": "main",
  "brief_description": "Chef John's pasta primavera recipe includes fettuccine with spring herbs and vegetables\u2013basil, zucchini, asparagus plus sugar snap and English peas.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large bowl with ice and cold water; set next to stovetop. Bring a large pot of lightly salted water to a boil. Hold basil bunch by stems; dip basil leaves in boiling water until bright green, about 2 seconds. Immediately immerse basil in ice water for several minutes to stop the cooking process. Drain well. Remove basil leaves from stems; discard stems."
    },
    {
      "position": 2,
      "text": "Combine basil leaves, 1 cup chicken broth, 1/2 cup olive oil, and garlic together in a blender; blend until smooth."
    },
    {
      "position": 3,
      "text": "Return the same pot of water to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain; transfer to a large bowl."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat 2 tablespoons olive oil in a large saucepan or Dutch oven over medium heat. Add leek and green onions; cook and stir until softened, about 5 minutes. Add jalape\u00f1o and salt; cook and stir until jalape\u00f1o is soft, about 5 minutes. Increase heat to medium-high. Stir in remaining 2 cups chicken broth, zucchini, sugar snap peas, and English peas; bring to a simmer and cook for 5 minutes. Add asparagus; cook until asparagus is soft, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Add 1/4 cup basil-garlic pur\u00e9e to vegetable mixture; cook and stir until heated through, about 1 minute. Remove from heat."
    },
    {
      "position": 6,
      "text": "Pour vegetable mixture over fettuccine; toss. Add remaining basil-garlic pur\u00e9e, sprinkle with Parmesan cheese, and toss briefly to combine. Wrap bowl tightly with aluminum foil; set aside until fettuccine and vegetables soak up most of the juices and oil, about 5 minutes. Toss."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4d89d9e0-925e-55c1-a390-fa63ad249f1f",
  "slug": "indian-naan-ii",
  "name": "Indian Naan",
  "recipe_type": "side",
  "brief_description": "Indian naan is delicious, and this easy recipe brushes the bread with ghee, then cooks it under the broiler for the perfect side to any Indian curry.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk warm water with yeast and sugar until yeast is dissolved. Cover and let stand in a warm place for 10 minutes."
    },
    {
      "position": 2,
      "text": "Sift flour and salt three times into a large bowl. Add yeast mixture, yogurt, and 1/2 of the ghee. Mix into a soft dough, then knead on a floured surface until dough is smooth and elastic, about 5 minutes. Place dough into a large greased bowl, cover, and let stand in a warm place for 1 1/2 hours or until doubled in volume."
    },
    {
      "position": 3,
      "text": "Punch down dough, then knead for 5 minutes. Divide dough into six equal pieces. Roll each piece out into 8-inch rounds."
    },
    {
      "position": 4,
      "text": "Cover an oven tray with foil and grease the foil. Brush dough rounds with remaining ghee and sprinkle with kalonji. Cook one at a time under the broiler until puffed and lightly browned, about 2 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

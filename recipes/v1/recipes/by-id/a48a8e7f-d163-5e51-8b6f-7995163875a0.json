  "id": "a48a8e7f-d163-5e51-8b6f-7995163875a0",
  "slug": "mulled-cranberry-juice-recipe-8384692",
  "name": "Mulled Cranberry Juice",
  "recipe_type": "appetizer",
  "brief_description": "Serve this mulled cranberry juice at your next gathering\u2014this lovely treat will put your guests in a holiday mood. If you like, you may leave out the sugar and add some orange liqueur, like Cointreau, for the grown-up party crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberry juice cocktail, granulated sugar, whole cloves, cinnamon stick, and orange slices in a 4-quart saucepan over medium heat."
    },
    {
      "position": 2,
      "text": "Bring to a boil; stir until sugar dissolves. Reduce heat to low and simmer for 10 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Allow to cool slightly, and ladle into punch cups. Float one orange slice in each cup and garnish with a cinnamon stick. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

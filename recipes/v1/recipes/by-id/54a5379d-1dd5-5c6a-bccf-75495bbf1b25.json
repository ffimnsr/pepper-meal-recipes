{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "54a5379d-1dd5-5c6a-bccf-75495bbf1b25",
  "slug": "puff-pastry-chicken-pot-pie",
  "name": "Puff Pastry Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This chicken pot pie with puff pastry is filled with tender chicken and vegetables in a rich and creamy sauce for the ultimate comfort food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Roll out 1 sheet of puff pastry into an 11-inch square. Press into a 9-inch pie dish, cut off extra pastry, and prick thoroughly with a fork. Press a sheet of aluminum foil right onto pastry."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pastry is puffed up and golden browned, about 25 minutes. Remove from oven, remove foil, and set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt better in a skillet over medium-low heat and cook onions and celery until soft and translucent, about 5 minutes. Add flour, salt, pepper, and celery seed. Cook and stir until mixture is paste-like."
    },
    {
      "position": 5,
      "text": "Slowly add milk to the skillet while stirring constantly, about 5 minutes. Continue stirring and slowly add broth a little at a time. Cook until thickened, 7 to 10 minutes, constantly stirring. Add chicken and frozen vegetables. Cook until vegetables are thawed, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Pour chicken mixture into pre-baked puff pastry shell. Roll out a second sheet of pastry into an 11-inch square and place on top of chicken mixture. Cut off extra pastry and crimp edges."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until pastry is lightly browned, 45 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,

  "id": "52f67c39-d846-5308-a377-44d2a143b0db",
  "slug": "creamy-beef-and-shells-recipe-11914501",
  "name": "Creamy Beef and Shells",
  "recipe_type": "main",
  "brief_description": "This creamy beef and shell pasta is a one-pot dish of pasta and beef, in a creamy, beefy tomato and extra-sharp Cheddar sauce. You'll turn a humble pound of ground beef into a family-friendly dinner that is all homemade.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add pasta and cook for 8 minutes. The pasta should be cooked through but just under al dente. Drain and set aside."
    },
    {
      "position": 2,
      "text": "In a heavy-bottomed pot, heat olive oil over medium heat. Add ground beef and break it up with the back of a spoon while it browns. Once cooked through, transfer to a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Add onions to the pot and cook, stirring, until they begin to soften, about 3 minutes. Mix in garlic and Italian seasoning. Cook and stir for 30 seconds. Sprinkle flour on top and stir. The mixture will be dry."
    },
    {
      "position": 4,
      "text": "Slowly whisk in beef broth, then add tomato sauce. Whisk until smooth. Taste and season with salt and pepper. Bring sauce to a boil, reduce heat, and simmer, stirring frequently, until reduced and slightly thickened, 8 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Add beef, pasta shells, and half-and-half to sauce and mix until well combined. Stir in cheese until completely melted."
    },
    {
      "position": 6,
      "text": "Serve in wide bowls with parsley and Parmesan cheese for garnish."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

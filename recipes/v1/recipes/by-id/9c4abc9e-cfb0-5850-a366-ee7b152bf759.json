  "id": "9c4abc9e-cfb0-5850-a366-ee7b152bf759",
  "slug": "mini-cheesecakes-i",
  "name": "Mini Cheesecakes",
  "recipe_type": "dessert",
  "brief_description": "This mini cheesecake recipe makes the perfect bite-sized dessert for parties, holidays, or any special occasion. Easy to serve and even easier to eat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 24-cup miniature muffin tins with paper liners."
    },
    {
      "position": 3,
      "text": "Crush vanilla wafers in a food processor or resealable plastic bag until fine crumbs form. Press about \u00bd teaspoon crumbs into each paper liner."
    },
    {
      "position": 4,
      "text": "Beat cream cheese, sugar, eggs, and vanilla in a mixing bowl until light and fluffy. Fill each miniature muffin liner with this mixture, almost to the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes until the cheesecake is set. Cool completely in the pan. Top each mini cheesecake with about a teaspoon of cherry pie filling before serving."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

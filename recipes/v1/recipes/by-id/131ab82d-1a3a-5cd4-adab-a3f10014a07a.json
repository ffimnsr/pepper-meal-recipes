  "id": "131ab82d-1a3a-5cd4-adab-a3f10014a07a",
  "slug": "chocolate-mousse-ii",
  "name": "Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "Traditional chocolate mousse recipe made with semisweet chocolate, hot water, and eggs.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate chips in a blender; pulse until ground. Add boiling water and blend until chocolate is melted. Add egg yolks, one at a time, blending well after each addition; transfer to a mixing bowl."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form. Gently fold egg whites into chocolate mixture. Pour mousse into wine glasses or other serving glasses and chill in the refrigerator until set, 2 to 3 hours."
    }
  ],
  "servings": 7,

  "id": "a32fb8e5-b2d6-52d1-aa68-dbeb80e2b4a7",
  "slug": "creamy-iced-applesauce-bars",
  "name": "Creamy Iced Applesauce Bars",
  "recipe_type": "dessert",
  "brief_description": "Like smooth apple sherbet without the bite, these creamy iced applesauce bars will charm your taste buds! A perfect summer treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend applesauce, milk, warm water, orange juice, poppy seeds, cinnamon, and nutmeg together in a blender until smooth. Pour into a loaf pan, cover with plastic wrap, and freeze until very cold, at least 1 to 2 hours. Cut into squares or bars and top with a dollop of dulce de leche."
    }
  ],

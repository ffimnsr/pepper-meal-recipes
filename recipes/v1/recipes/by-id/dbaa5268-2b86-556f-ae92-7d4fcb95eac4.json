  "id": "dbaa5268-2b86-556f-ae92-7d4fcb95eac4",
  "slug": "sawdust-salad",
  "name": "Sawdust Salad",
  "recipe_type": "salad",
  "brief_description": "Sawdust salad is a layered lemon and orange gelatin salad with crushed pineapple, marshmallows, and a custard layer topped with sliced bananas and toasted coconut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine lemon and orange gelatin powders and boiling water. Stir until powders are dissolved, then stir in drained pineapple and marshmallows. Refrigerate until firm."
    },
    {
      "position": 3,
      "text": "While gelatin mixture is chilling, whisk together pineapple juice, sugar, eggs, and flour in a medium saucepan and cook over medium heat until thick. Stir constantly and do not allow mixture to scorch."
    },
    {
      "position": 4,
      "text": "Remove from heat and let cool before spreading over the set gelatin mixture."
    },
    {
      "position": 5,
      "text": "Toss sliced bananas with lemon juice to prevent browning. Drain, then layer sliced bananas over custard mixture."
    },
    {
      "position": 6,
      "text": "Prepare whipped topping mix according to package directions, then beat in cream cheese until smooth."
    },
    {
      "position": 7,
      "text": "Spread mixture over bananas. Sprinkle with toasted coconut."
    },
    {
      "position": 8,
      "text": "Chill salad for 2 to 4 hours before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

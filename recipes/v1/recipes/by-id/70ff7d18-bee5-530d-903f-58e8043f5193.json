  "id": "70ff7d18-bee5-530d-903f-58e8043f5193",
  "slug": "veggie-nacho-salad",
  "name": "Veggie Nacho Salad",
  "recipe_type": "salad",
  "brief_description": "These nachos are loaded with crunchy veggies, including purple cabbage, lettuce, and onions, as well as corned beef for a complete meal that's both fun and satisfying to eat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread tortilla chips on a baking sheet and sprinkle shredded cheese over chips."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until cheese has melted, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a frying pan over medium heat. Add corned beef and cook until heated through, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Pile corned beef, lettuce, cabbage, tomato, and onion on top of the chips. Add guacamole, sour cream, and green onions. Sprinkle seasoned salt on top. Toss lightly at the table."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

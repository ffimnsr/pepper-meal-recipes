  "id": "1127dcf1-95b2-579b-acd1-51abb27ba509",
  "slug": "creamy-shrimp-scampi",
  "name": "Creamy Shrimp Scampi",
  "recipe_type": "main",
  "brief_description": "This creamy shrimp scampi recipe features fresh shrimp in a rich, silky sauce made with shallots, garlic, white wine, and a hint of lemon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place flour in a shallow dish; season with salt and pepper. Toss shrimp in flour; shake off any excess."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat; add shrimp and cook until pink, about 2 minutes per side. Remove shrimp from skillet; set aside. Discard all but 1 tablespoon of oil from the skillet. Add shallots and garlic; cook and stir until soft, about 2 minutes. Pour in 1/2 cup chicken broth, wine, and lemon juice. Simmer until reduced to about 3/4 cup, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in remaining 1/2 cup of chicken broth and cream; simmer until sauce is reduced and thickened slightly, approximately 10 minutes more. Add butter and stir until melted."
    },
    {
      "position": 4,
      "text": "Return shrimp to the skillet; simmer until heated through, about 3 minutes. Sprinkle with Romano cheese and parsley before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

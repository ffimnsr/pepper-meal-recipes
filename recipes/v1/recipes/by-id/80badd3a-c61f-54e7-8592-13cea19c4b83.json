  "id": "80badd3a-c61f-54e7-8592-13cea19c4b83",
  "slug": "crawfish-etouffee-like-maw-maw-used-to-make",
  "name": "Crawfish \u00c9touff\u00e9e Like Maw-Maw Used to Make",
  "recipe_type": "soup",
  "brief_description": "Start this \u00e9touff\u00e9e with a homemade roux, then add onions, bell peppers, and garlic, plus crawfish and seasonings for an impressive entr\u00e9e.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a stockpot, melt butter over medium heat until bubbling. Add flour to make a roux, stirring constantly to prevent or remove any lumps. Cook the roux for 5 minutes. Do not brown."
    },
    {
      "position": 2,
      "text": "Stir in onions and bell peppers; saut\u00e9 for 10 minutes, or until onions are translucent. Add garlic and saut\u00e9 for 3 minutes. Stir in crawfish tails. Slowly pour in enough water to reach a consistency that's a little thicker than soup. Season with cumin, Worcestershire sauce, hot sauce, salt, and pepper. Reduce the heat and simmer for 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

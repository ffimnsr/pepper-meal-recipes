  "slug": "slow-cooker-split-pea-sausage-soup",
  "name": "Slow Cooker Split Pea Sausage Soup",
  "recipe_type": "soup",
  "brief_description": "Dried split peas and smoked sausages are combined in this slow cooker soup with carrots, potatoes, oregano and garlic powder. Allow 5 hours cooking time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a 5-quart slow cooker, combine peas, water, sausage, bouillon, carrot, celery, potatoes, garlic powder, oregano, bay leaves, and onion."
    },
    {
      "position": 2,
      "text": "Cover and cook on High for 4 to 5 hours. Remove bay leaves before ladling into bowls."
    }
  ],
  "servings": 8,

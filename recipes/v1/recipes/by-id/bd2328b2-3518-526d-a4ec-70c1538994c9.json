  "id": "bd2328b2-3518-526d-a4ec-70c1538994c9",
  "slug": "caramelized-onions-on-the-grill",
  "name": "Caramelized Onions on the Grill",
  "recipe_type": "side",
  "brief_description": "These are absolutely melt in your mouth delicious! You can make them on the grill or in the oven. Even friends of ours that don't care for onions loved these! I would recommend that you use 1 large onion for every 2 people. Some people want one whole onion to themselves so you might want to make some extra! They are also good heated up the next day but we rarely have any extra!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat."
    },
    {
      "position": 2,
      "text": "Place onion wedges on a sheet of heavy-duty aluminum foil. Dot with butter; sprinkle with bouillon, garlic salt, and pepper. Fold aluminum foil into a packet, leaving only a small hole at the top to allow steam to escape."
    },
    {
      "position": 3,
      "text": "Place packet on the preheated grill. Cook until onions softened and a deep, rich brown color, 45 minutes to 1 hour, stirring onions after 30 minutes, or as needed, to keep from burning."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

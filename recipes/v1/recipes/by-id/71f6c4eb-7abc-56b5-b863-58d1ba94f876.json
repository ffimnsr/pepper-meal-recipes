  "id": "71f6c4eb-7abc-56b5-b863-58d1ba94f876",
  "slug": "baked-caramel-apple-french-toast",
  "name": "Baked Caramel-Apple French Toast",
  "recipe_type": "breakfast",
  "brief_description": "You do most of the leg work the night before so the bread and apples can really soak up the flavors. In the morning, simply pop them in the oven and prepare the luscious caramel sauce to ladle over all.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cut bread into 1 1/2 inch thick slices and place in a lightly greased 9x13 inch baking pan. In a large bowl, beat eggs with 1 1/2 cup skim milk, 1/3 cup white sugar, and 1 tablespoon vanilla. Pour egg mixture over bread slices."
    },
    {
      "position": 2,
      "text": "Arrange apple slices on top of bread. Sprinkle cinnamon, nutmeg, and 2 tablespoons white sugar over apples. Cover, and refrigerate overnight."
    },
    {
      "position": 3,
      "text": "In the morning: Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake toast in preheated oven until golden brown, about 1 hour. Meanwhile, combine 1/2 cup white sugar, flour, and margarine. Stir in brown sugar, 1/2 cup skim milk, and 2 teaspoons vanilla in a small saucepan. Cook until thick. Serve French toast hot with warm sauce."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4fb241dc-93a7-5944-ac00-c7054490ab92",
  "slug": "one-pan-creamy-parmesan-chicken-and-vegetables-recipe-7376035",
  "name": "One-Pan Creamy Parmesan Chicken and Vegetables",
  "recipe_type": "main",
  "brief_description": "This one-pan creamy Parmesan chicken and vegetables dish is a colorful skillet meal and a great way to add some vegetables to your family\u2019s diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat chicken thighs dry with paper towels and season with Italian seasoning. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Combine 1 tablespoon olive oil and 1 tablespoon unsalted butter in a large, non-stick skillet or wok over medium-high heat."
    },
    {
      "position": 3,
      "text": "When oil is hot and butter is bubbling, add chicken thighs and cook until browned, 5 to 7 minutes. Turn chicken, reduce heat to medium-low, cover, and cook until juices no longer run pink, about 5 minutes more. An instant-read thermometer inserted near the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove chicken from the skillet, place on a serving platter, and keep warm."
    },
    {
      "position": 5,
      "text": "To the same pan, over medium high heat, add remaining olive oil and butter, and allow butter to melt. Stir in onions and red pepper flakes and cook 1 to 2 minutes, then add mushrooms and bell peppers. Cook an additional 2 minutes, stirring frequently."
    },
    {
      "position": 6,
      "text": "Add broccoli florets, zucchini, and carrots. Cook, stirring, 1 to 2 minutes."
    },
    {
      "position": 7,
      "text": "Add asparagus, tomatoes, and garlic; cook until garlic is fragrant, about a minute."
    },
    {
      "position": 8,
      "text": "Pour in chicken broth and allow to come to a boil. Reduce heat to a simmer and stir in peas. When broth is lightly bubbling, add cream slowly, stirring, and stir in Parmesan cheese."
    },
    {
      "position": 9,
      "text": "To serve place 2 chicken thighs on each plate and top with vegetables and Parmesan cream. Garnish with fresh flat-leaf parsley. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

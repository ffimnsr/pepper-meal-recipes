  "id": "5a135f38-d80d-5d7d-a912-ad12fd1ebc9c",
  "slug": "yummy-no-bake-cinnamon-rolls-for-kids",
  "name": "Yummy No-Bake Cinnamon Rolls for Kids",
  "recipe_type": "snack",
  "brief_description": "Slices of white bread are spread with butter and cinnamon sugar, then rolled and sliced into pinwheels, in an easy snack kids can make for themselves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Roll the bread slices until very flat. Butter the bread, and sprinkle with cinnamon sugar. Starting on one side, roll up the bread slice until tight. Repeat with the second bread slice. Cut the bread rolls into 1 inch slices."
    },
    {
      "position": 2,
      "text": "Mix the confectioners' sugar with the water in a small bowl to make a thin frosting. Drizzle frosting over the bread slices, and serve."
    }
  ],
  "servings": 4,

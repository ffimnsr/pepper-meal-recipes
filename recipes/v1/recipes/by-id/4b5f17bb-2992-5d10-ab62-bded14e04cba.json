  "id": "4b5f17bb-2992-5d10-ab62-bded14e04cba",
  "slug": "best-peanut-butter-cookies-ever",
  "name": "Best Peanut Butter Cookies Ever",
  "recipe_type": "dessert",
  "brief_description": "Kids will love to help make these easy, flourless peanut butter cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a medium bowl, stir peanut butter and sugar together until smooth. Beat in the eggs, one at a time, then stir in the baking soda, salt, and vanilla. Roll dough into 1 inch balls and place them 2 inches apart onto the prepared cookie sheets. Press a criss-cross into the top using the back of a fork."
    },
    {
      "position": 3,
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

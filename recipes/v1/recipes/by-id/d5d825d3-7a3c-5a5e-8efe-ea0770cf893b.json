  "id": "d5d825d3-7a3c-5a5e-8efe-ea0770cf893b",
  "slug": "vegan-fajitas",
  "name": "Vegan Fajitas",
  "recipe_type": "main",
  "brief_description": "This vegan fajitas recipe is full of zucchini, yellow squash, bell peppers and onion \u2014 marinated and then saut\u00e9ed. Serve with tortillas or rice.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Make the marinade: Combine olive oil, vinegar, oregano, chili powder, sugar, garlic salt, salt, and pepper in a large bowl."
    },
    {
      "position": 2,
      "text": "Prepare fajitas: Add zucchini, yellow squash, onion, and bell peppers to the marinade. Marinate vegetables in the refrigerator for at least 30 minutes, but not more than 24 hours."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat. Drain vegetables and saut\u00e9 until tender, about 10 to 15 minutes. Stir in corn and black beans. Increase the heat to high to brown vegetables, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

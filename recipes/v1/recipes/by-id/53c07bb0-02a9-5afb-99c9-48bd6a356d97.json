  "schema_version": 1,
  "id": "53c07bb0-02a9-5afb-99c9-48bd6a356d97",
  "slug": "mini-blueberry-marscarpone-pies",
  "name": "Mini Blueberry-Marscarpone Pies",
  "recipe_type": "dessert",
  "brief_description": "A smooth, creamy filling of fresh blueberry puree and mascarpone cheese sets up nicely in mini pie crusts in this impressive dessert that's perfect for your next dinner party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Set out six 6-inch mini pie tins."
    },
    {
      "position": 2,
      "text": "Roll dough out and cut a circle to fit the bottom and sides of a pie tin. Place crust in the tin, then crimp the edges and poke the bottoms and sides with a fork. Continue, re-rolling the dough as necessary, to make remaining crusts."
    },
    {
      "position": 3,
      "text": "Place a round piece of parchment paper on top of each crust and add pie weights."
    },
    {
      "position": 4,
      "text": "Bake crusts in the preheated oven until edges are golden, 12 to 15 minutes. Carefully remove the weights and parchment paper. Let crusts cool to room temperature, about 30 minutes."
    },
    {
      "position": 5,
      "text": "While the crusts are cooling, blend 2 cups blueberries and lemon juice in a blender until smooth, 1 to 2 minutes. Transfer to a small saucepan and add gelatin. Cook over medium heat, stirring constantly, until gelatin has completely dissolved, about 4 minutes. Transfer to a bowl and cool to room temperature, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Stir mascarpone cheese and 1/4 cup sugar into the cooled blueberry mixture until well combined."
    },
    {
      "position": 7,
      "text": "Beat 1 1/2 cups heavy cream and 1 teaspoon vanilla with an electric mixer until foamy, about 30 seconds. Increase speed slowly to medium-high and gradually beat in remaining 1/4 cup sugar until stiff peaks form, about 1 minute. Gradually fold whipped cream mixture into the blueberry mixture. Spoon evenly into the cooled pie crusts."
    },
    {
      "position": 8,
      "text": "Cover and chill in the refrigerator for at least 4 hours, or overnight."
    },
    {
      "position": 9,
      "text": "When ready to serve, whip remaining remaining 1/2 cup heavy cream and 1/2 teaspoon vanilla together. Slowly mix in 1 tablespoon sugar until whipped cream forms."
    },
    {
      "position": 10,
      "text": "Top each pie with whipped cream and blueberries."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

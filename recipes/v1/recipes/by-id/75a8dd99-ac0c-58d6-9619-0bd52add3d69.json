  "id": "75a8dd99-ac0c-58d6-9619-0bd52add3d69",
  "slug": "campbells-tuna-noodle-casserole",
  "name": "Campbell's Tuna Noodle Casserole",
  "recipe_type": "soup",
  "brief_description": "This tuna noodle casserole uses mushroom soup to add flavor to a creamy sauce that's mixed with noodles, tuna, and peas to make this family favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir cooked noodles, condensed soup, tuna, peas, and milk in a 3-quart casserole."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until hot, about 30 minutes; stir well."
    },
    {
      "position": 4,
      "text": "Mix bread crumbs with melted butter in a bowl; sprinkle over tuna casserole and continue to bake until bread crumbs are golden brown and crispy, 5 minutes more."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

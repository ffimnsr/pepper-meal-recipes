  "id": "549324e3-aa37-5bec-b23a-a63c0a6e6cd8",
  "slug": "blt-egg-sliders-recipe-8743788",
  "name": "BLT Egg Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These BLT egg sliders have everything you love in a BLT sandwich minus the bread, and are a really fun tailgating appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Break bacon slices into thirds when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Slice eggs in half lengthwise. Place 12 egg halves on a serving plate. Set other egg halves aside."
    },
    {
      "position": 3,
      "text": "Spread mayonnaise on 12 egg halves. Top each with 2 pieces of bacon. Top each with 1 tomato slice and 1 folded lettuce leaf."
    },
    {
      "position": 4,
      "text": "Top each with a reserved egg half. Secure each \"slider\" with a toothpick. Sprinkle with seasoned salt and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

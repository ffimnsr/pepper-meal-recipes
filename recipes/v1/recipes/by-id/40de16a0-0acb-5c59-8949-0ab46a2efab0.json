  "id": "40de16a0-0acb-5c59-8949-0ab46a2efab0",
  "slug": "rhubarb-cherry-pie",
  "name": "Cherry Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This cherry rhubarb pie can be made with fresh or frozen rhubarb combined with cherry pie filling for a fruity and comforting springtime dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rhubarb, cherry pie filling, sugar, and tapioca in a large bowl. Let stand for 15 minutes. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour filling into unbaked pie shell, and cover with pie crust. Brush top with milk, and sprinkle on sugar."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pastry is golden and filling is bubbling, about 40 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

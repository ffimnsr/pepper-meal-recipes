  "id": "15a6900b-188e-52e2-acbe-a0099f8b0fcb",
  "slug": "salmon-terrine",
  "name": "Salmon Terrine",
  "recipe_type": "appetizer",
  "brief_description": "In this salmon terrine recipe, salmon, butter, Dijon mustard, and fresh tarragon paired with toasted baguette slices for make a delicious appetizer.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a large saucepan and add salt. Add salmon fillet, reduce to a simmer, and cook until just cooked through, 6 to 8 minutes. Transfer salmon to a plate using a slotted spoon and let cool 10 minutes. Flake salmon into a large bowl, discarding skin, and toss with smoked salmon, green onion, parsley, and tarragon."
    },
    {
      "position": 2,
      "text": "Whisk together butter, mayonnaise, mustard, lemon juice, and pepper in a bowl until smooth. Add mayonnaise mixture to salmon mixture and gently stir until well combined."
    },
    {
      "position": 3,
      "text": "Cover and chill 3 hours. Serve with toasted baguette slices or crackers."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "b218f79f-9dcf-5d85-a214-709133162831",
  "slug": "creamy-white-chili",
  "name": "Creamy White Chili",
  "recipe_type": "soup",
  "brief_description": "This white chicken chili with white beans, chunks of tender chicken, green chiles, spices, and sour cream is a comforting chili that's sure to please.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large saucepan over medium heat. Add chicken, onion, and garlic; cook and stir until chicken is no longer pink in centers and the juices run clear, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in beans, chicken broth, green chiles, salt, cumin, oregano, black pepper, and cayenne pepper; bring to a boil. Reduce heat; simmer until flavors have blended, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Off heat, stir in sour cream and heavy cream until incorporated."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

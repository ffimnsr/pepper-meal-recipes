  "id": "b3a98683-8483-51e0-9e39-89526923abc3",
  "slug": "cake-mix-birthday-cake-pancakes",
  "name": "Cake Mix Birthday Cake Pancakes",
  "recipe_type": "dessert",
  "brief_description": "The birthday party begins at breakfast with pancakes made from cake mix and candy sprinkles.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk melted butter, milk, and eggs together in a large bowl; whisk in cupcake mix just until ingredients are moistened. It's okay if there are some lumps."
    },
    {
      "position": 2,
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter."
    },
    {
      "position": 3,
      "text": "Serve with whipped cream and sprinkles if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

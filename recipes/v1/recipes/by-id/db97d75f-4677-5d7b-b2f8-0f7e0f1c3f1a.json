  "id": "db97d75f-4677-5d7b-b2f8-0f7e0f1c3f1a",
  "slug": "authentic-paella-valenciana",
  "name": "Authentic Paella Valenciana",
  "recipe_type": "main",
  "brief_description": "Try this traditional paella Valenciana made with chicken and rabbit. No seafood here in this classic, original version of a favorite rice dish.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a paella pan over medium-high heat, and coat with olive oil. Add chicken, rabbit, and garlic; cook and stir until nicely browned. Move the browned meat to the sides of the pan, and add tomato, butter beans, peas, and green beans. Season with paprika, and mix well."
    },
    {
      "position": 2,
      "text": "Fill the paella pan almost to the top with water, measuring the water as you add it so you can determine the amount of rice to add later. Bring to a boil. Simmer for about 1 hour to make a nice broth."
    },
    {
      "position": 3,
      "text": "Season with a generous amount of salt, just enough saffron for a yellow color, thyme, and rosemary. Stir in half as much rice as the amount of water added to the pan. Cover, reduce heat to low, and simmer until all of the liquid has been absorbed, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

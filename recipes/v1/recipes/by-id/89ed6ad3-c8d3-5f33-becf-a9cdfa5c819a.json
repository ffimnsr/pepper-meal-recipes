  "slug": "coconut-rum-brazilian-lemonade-recipe-8662721",
  "name": "Coconut Rum Brazilian Lemonade",
  "recipe_type": "dessert",
  "brief_description": "This creamy spiked Brazilian lemonade made with coconut rum and sweetened condensed milk is a delicious refreshing summer drink.",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse limes and cut the ends off. Cut each lime in 8 wedges and add to a blender. Add water, coconut rum, and sweetened condensed milk; blend until creamy."
    },
    {
      "position": 2,
      "text": "Fill 3 glasses with ice and strain lemonade over."
    }
  ],
  "servings": 3,

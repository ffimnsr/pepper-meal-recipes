  "id": "f2abfa51-37e0-515d-91c0-eb17b1ee8f1b",
  "slug": "tuna-stroganoff-casserole",
  "name": "Tuna Stroganoff Casserole",
  "recipe_type": "soup",
  "brief_description": "Sour cream joins cream of celery soup and more standard ingredients in this simple tuna stroganoff casserole recipe that is ready in under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine soup, Cheddar cheese, tuna, milk, sour cream, mayonnaise, parsley, lemon juice, salt, and black pepper in a 9x5-inch loaf pan; stir until sauce is well mixed."
    },
    {
      "position": 3,
      "text": "Stir pasta into sauce until thoroughly coated; sprinkle bread crumbs over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bread crumbs are golden brown and sauce is bubbly, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

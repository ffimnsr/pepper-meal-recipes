  "id": "3bb810cf-a219-5f2b-9ddd-3310d639717b",
  "slug": "peanut-butter-and-jelly-french-toast-casserole-recipe-7371603",
  "name": "Peanut Butter and Jelly French Toast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This fun twist on French toast is a combination of bread pudding and a peanut butter and jelly sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 9x13-inch baking dish with nonstick cooking spray; set aside."
    },
    {
      "position": 2,
      "text": "Spread 1 tablespoon peanut butter on 7 slices of bread and 1 tablespoon jam on the remaining 7 slices. Pair one peanut butter slice with one jam slice to make 7 sandwiches."
    },
    {
      "position": 3,
      "text": "Cut each sandwich into quarters, making 28 mini sandwiches total. Arrange the pieces snugly in rows in the prepared baking dish, with the cut sides facing up."
    },
    {
      "position": 4,
      "text": "To make the custard: Whisk milk, eggs, honey, vanilla, and salt together in a bowl until well combined. Slowly drizzle custard evenly over sandwiches, making sure all pieces are coated. Don\u2019t worry if some custard pools at the bottom\u2014the bread will absorb it. Cover the dish with foil, and refrigerate for at least 8 hours or overnight."
    },
    {
      "position": 5,
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake casserole in the preheated oven, covered, for 30 minutes. Remove foil, and bake until lightly crisp and golden brown on top, 20 to 30 minutes more. Sprinkle with confectioners sugar or drizzle with maple syrup before serving."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,

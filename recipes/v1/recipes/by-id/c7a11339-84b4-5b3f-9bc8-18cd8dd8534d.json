  "id": "c7a11339-84b4-5b3f-9bc8-18cd8dd8534d",
  "slug": "shortcut-cheesy-chicken-and-broccoli-casserole-recipe-11993283",
  "name": "Shortcut Cheesy Chicken and Broccoli Casserole",
  "recipe_type": "main",
  "brief_description": "This shortcut cheesy chicken and broccoli casserole turns a container of prepared macaroni, cooked chicken, broccoli, and 2 kinds of cheese into the ultimate comfort-food casserole, making it perfect for busy weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Saut\u00e9 garlic in butter for about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add prepared macaroni and cheese; cook, stirring occasionally, just until warmed through. Add in chicken, broccoli, mozzarella, 1/4 cup Parmesan cheese, Italian seasoning, and pepper."
    },
    {
      "position": 4,
      "text": "Transfer mixture into a greased dish. Top with panko and remaining Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until hot and bubbly, and panko is golden brown, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

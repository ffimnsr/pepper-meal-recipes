{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "71b00f2a-10de-58d5-ba62-fd0880caa399",
  "slug": "cream-of-asparagus-and-mushroom-soup",
  "name": "Cream of Asparagus and Mushroom Soup",
  "recipe_type": "appetizer",
  "brief_description": "This cream of asparagus soup with mushroom, bacon, onion, potato, and celery has mouthwatering savory flavors perfect for a starter course.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large, deep skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon on a paper towel-lined plate. Crumble bacon when cool; set aside. Reserve 1 tablespoon bacon drippings in a small bowl. Set aside the skillet."
    },
    {
      "position": 2,
      "text": "Melt butter with drippings in a large saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Cook and stir celery and onion in hot butter-drippings until onion is translucent, about 4 minutes. Whisk in flour and cook for 1 minute. Whisk in chicken broth and bring to a boil. Add potato and asparagus, reserving asparagus tips for later. Season with salt and ground black pepper. Reduce heat and simmer soup for 20 minutes."
    },
    {
      "position": 4,
      "text": "Pour soup into a blender, filling the pitcher no more than halfway. Holding down the lid of the blender with a folded kitchen towel, start the blender, using a few quick pulses to get soup moving before leaving it on to pur\u00e9e. Pur\u00e9e in batches until smooth and pour into a clean pot. Alternately, you can use a stick blender and pur\u00e9e soup right in the cooking pot."
    },
    {
      "position": 5,
      "text": "Cook and stir mushrooms and asparagus tips in the same skillet used for bacon until mushrooms release their liquid, 5 to 8 minutes. Season with salt and ground black pepper, if needed."
    },
    {
      "position": 6,
      "text": "Stir mushrooms, asparagus tips, and half-and-half cream into pur\u00e9ed soup. Cook until thoroughly heated."
    },
    {
      "position": 7,
      "text": "Portion soup into bowls and garnish with crumbled bacon."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

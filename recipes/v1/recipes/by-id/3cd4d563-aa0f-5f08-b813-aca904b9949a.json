  "id": "3cd4d563-aa0f-5f08-b813-aca904b9949a",
  "slug": "slow-cooker-cowboy-beans",
  "name": "Slow Cooker Cowboy Beans",
  "recipe_type": "dessert",
  "brief_description": "This hearty cowboy beans recipe combines baked beans with pork, kidney beans, lima beans, and ground beef in sweet and tangy homemade barbecue sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and bacon together in the hot skillet until beef is browned and crumbly, about 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer hamburger and bacon into a slow cooker; stir in baked beans with pork, kidney beans, lima beans, onions, ketchup, brown sugar, and mustard."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until thickened and bubbling, at least 3 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 190,
  "preparation_time_minutes": 10,

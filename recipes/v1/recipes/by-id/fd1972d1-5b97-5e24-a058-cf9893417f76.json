  "slug": "2-ingredient-frozen-fruit-smoothie-recipe-7497358",
  "name": "2-Ingredient Frozen Fruit Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This frozen fruit smoothie has two ingredients, frozen fruit and coconut water, and is both refreshing and hydrating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour coconut water into a Vitamix blender. Add frozen fruit. Slowly turn the blender to Variable 10, then to High 10. Blend for 45 seconds."
    },
    {
      "position": 3,
      "text": "Pour smoothie into glass; garnish with strawberry and blackberry if desired."
    }
  ],

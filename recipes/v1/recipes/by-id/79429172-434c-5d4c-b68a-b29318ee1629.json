  "id": "79429172-434c-5d4c-b68a-b29318ee1629",
  "slug": "chucks-favorite-mac-and-cheese",
  "name": "Chuck's Favorite Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This mac and cheese with cottage cheese, shredded Cheddar, and grated Parmesan is topped with a buttery breaded topping. It's super cheesy and delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Mix bread crumbs and melted butter together in a small bowl."
    },
    {
      "position": 4,
      "text": "Transfer drained macaroni to the prepared baking dish. Add cottage cheese, Cheddar, sour cream, Parmesan, salt, and pepper; stir until well combined. Sprinkle bread crumb mixture over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown on top, 30 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

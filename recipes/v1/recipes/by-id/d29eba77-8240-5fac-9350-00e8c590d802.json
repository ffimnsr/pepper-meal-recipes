  "id": "d29eba77-8240-5fac-9350-00e8c590d802",
  "slug": "five-food-groups-macaroni-salad",
  "name": "Five Food Groups Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "This may have some strange ingredients, but it is the only kind of macaroni salad I will eat! It started as a fourth grade experiment on trying to incorporate all five food groups into a simple, tasty recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta, cook for 8 to 10 minutes, until al dente. Drain, and cool."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix the cooled pasta, creamy salad dressing, ranch dressing mix, tuna, Cheddar cheese, apple, carrot, and raisins. Chill 1 hour in the refrigerator before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,

  "id": "eb0ab432-78ed-59b8-ada1-b603e754492b",
  "slug": "cheeseburger-meatballs-recipe-11993245",
  "name": "Cheeseburger Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These cheeseburger meatballs pack all the classic flavors of a cheeseburger into tender, oven-baked meatballs. Easy to make and perfect for dipping in your choice of sauce, they\u2019re a fun twist on a comfort food favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Place ground beef, salt, pepper, cayenne, and shredded Cheddar cheese in a bowl. Mix well until evenly combined. With damp hands, form into 1-inch balls and place on the prepared sheet. Brush meatballs all over with melted butter, then brush with BBQ sauce."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until meatballs are no longer pink at the center, 7 to 10 minutes. Brush with BBQ sauce halfway through cooking time, or more often if meatballs seem dry."
    },
    {
      "position": 4,
      "text": "Sprinkle with sesame seeds before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

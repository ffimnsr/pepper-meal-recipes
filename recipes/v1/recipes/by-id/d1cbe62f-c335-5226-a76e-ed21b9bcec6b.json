  "id": "d1cbe62f-c335-5226-a76e-ed21b9bcec6b",
  "slug": "avocado-spinach-dip",
  "name": "Avocado-Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "Sour cream gives this guacamole-inspired avocado spinach dip an extra level of creaminess.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Process spinach, avocado, sour cream, red onion, lime juice, jalapeno pepper, garlic, salt, black pepper, and hot sauce in a food processor until smooth."
    },
    {
      "position": 2,
      "text": "Scrape dip into a serving bowl, cover with plastic wrap, and refrigerate until chilled, at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

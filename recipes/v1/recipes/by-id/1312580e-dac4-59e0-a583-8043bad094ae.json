  "id": "1312580e-dac4-59e0-a583-8043bad094ae",
  "slug": "potato-pancakes-i",
  "name": "Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Potato pancakes are a comfort classic. Serve topped with smoked salmon for brunch, with applesauce for a light meal, or plain as a side dish.",
  "cuisine": "Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 200 degrees F (95 degrees C)."
    },
    {
      "position": 2,
      "text": "Finely grate potatoes and onion into a large bowl. Drain off any excess liquid."
    },
    {
      "position": 3,
      "text": "Mix in egg, salt, and pepper. Add enough flour to make the mixture thick, about 2 to 4 tablespoons all together."
    },
    {
      "position": 4,
      "text": "Heat 1/4 inch of oil in the bottom of a heavy skillet over medium-high heat. Drop 1/4-cup mounds of batter, two or three at a time, into hot oil and flatten with back of a spatula to make 1/2-inch-thick pancakes."
    },
    {
      "position": 5,
      "text": "Fry, turning pancakes once, until golden brown and crisp. Transfer to a paper towel\u2013lined plate to drain. Keep warm in the preheated oven until ready to serve. Repeat until all potato mixture is used."
    },
    {
      "position": 6,
      "text": "Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "parmesan-fondue",
  "name": "Parmesan Fondue",
  "recipe_type": "appetizer",
  "brief_description": "You can have a warm, mild, and creamy fondue on your table in just moments by melting Neufchatel cream cheese and Parmesan cheese in milk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir Neufchatel cream cheese in milk in a saucepan over medium-low heat until melted, 2 to 3 minutes. Add Parmesan cheese and garlic salt. Cook and stir until the Parmesan melts, 2 to 3 minutes more. Serve with bread cubes."
    }
  ],

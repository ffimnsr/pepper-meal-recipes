  "id": "a4ff5501-b940-5985-85ca-9a48641de199",
  "slug": "milk-chocolate-pecan-pie",
  "name": "Milk Chocolate Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "A sweet, butter and egg mixture is combined with lots of pecans and milk chocolate pieces, spooned into a prepared pie crust and baked. The chocolate melts, the pecans get gooey, and the crust turns golden brown.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In medium mixing bowl beat eggs lightly with a rotary beater or fork. Stir in corn syrup, sugar, and butter; mix well. Stir in pecan and chocolate pieces."
    },
    {
      "position": 3,
      "text": "To prevent overbrowning, cover edges of pie shell with aluminum foil. Place pie shell on oven rack and pour filling into it."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 25 minutes. Remove foil from crust edges and bake an additional 25 minutes, or until a knife inserted in center comes out clean. Chill before serving. May be served with whipped cream or vanilla ice cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

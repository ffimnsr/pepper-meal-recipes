  "id": "ad110831-3db3-5e82-b011-95fa15e483a6",
  "slug": "hot-spinach-artichoke-and-swiss-cheese-dip",
  "name": "Hot Spinach, Artichoke, and Swiss Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "Perfect for your next party, this hot, creamy Swiss cheese dip with spinach and artichokes can be served with crackers or sliced baguettes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Blend mayonnaise, Swiss cheese, spinach, artichoke hearts, and onion in a food processor. Spoon into a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 25 minutes. Sprinkle Parmesan cheese over top and continue to bake until lightly browned and bubbly, about 25 more minutes."
    },
    {
      "position": 4,
      "text": "Serve hot."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 5,

  "id": "afd649ae-0395-576f-9783-316d291759f9",
  "slug": "halibut-mango-ceviche",
  "name": "Halibut-Mango Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "This delicious tropical ceviche is perfect for fancy gatherings. The halibut 'cooks' in lemon and lime juice with a splash of tequila and lots of fresh mango.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cubed halibut, lime juice, lemon juice, tequila, minced jalape\u00f1o peppers, and 1 diced mango in a non-metallic bowl. Cover and refrigerate for 1 \u00bd hours."
    },
    {
      "position": 2,
      "text": "After the ceviche has sat for 1 \u00bd hours, add green pepper, sweet onion, and red onion. Mix well, then cover and refrigerate for another 30 minutes."
    },
    {
      "position": 3,
      "text": "Fold in the remaining diced mango, cilantro, and parsley; season to taste with salt before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "expert",

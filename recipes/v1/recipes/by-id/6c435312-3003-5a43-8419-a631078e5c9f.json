  "id": "6c435312-3003-5a43-8419-a631078e5c9f",
  "slug": "make-ahead-moroccan-lamb-stew",
  "name": "Make-Ahead Moroccan Lamb Stew",
  "recipe_type": "soup",
  "brief_description": "This rich and flavorful Moroccan-style stew with ground lamb, a plethora of spices, vegetables, and beans comes together easily despite the long list of ingredients.",
  "cuisine": "Moroccan",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cinnamon, cumin, salt, ginger, cloves, nutmeg, turmeric, and curry powder in a large bowl."
    },
    {
      "position": 2,
      "text": "Add lamb to spice mixture and mix until well combined."
    },
    {
      "position": 3,
      "text": "Melt butter in a large pot over medium heat. Add onion and saut\u00e9 until soft and just beginning to brown, 5 to 10 minutes. Add spiced lamb; cook and stir until browned and crumbly, 6 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Add consomm\u00e9, garbanzo beans, beef broth, chicken broth, diced tomatoes, sweet potatoes, carrots, lentils, apricots, and honey; bring to a boil."
    },
    {
      "position": 5,
      "text": "Reduce the heat to low and simmer until vegetables and lentils are tender, about 30 minutes. Season with pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

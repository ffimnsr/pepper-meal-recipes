  "id": "21698eea-9c0e-560a-89af-708f492197e8",
  "slug": "spicy-umami-maple-ice-cream-topper-recipe-12035134",
  "name": "Spicy Umami Maple Ice Cream Topper",
  "recipe_type": "dessert",
  "brief_description": "Salted caramel lovers will especially enjoy this spicy, umami-packed version. Try this over vanilla ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together maple syrup, avocado oil, and soy sauce in a small saucepan until well combined."
    },
    {
      "position": 2,
      "text": "Cook over medium heat, stirring occasionally, until bubbly and slightly thickened, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat. Stir in 1 teaspoon chili crisp; stir in up to 1 teaspoon more if desired."
    },
    {
      "position": 4,
      "text": "Let cool at least 5 minutes before using. Serve over vanilla ice cream with chopped pecans. Makes 1/3 cup."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "slug": "5-minute-baileys-chocolate-mousse",
  "name": "5 Minute Baileys Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "This Baileys chocolate mousse flavored with Irish cream is incredibly easy to make and ready in 5 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine heavy whipping cream, Bailey's, cocoa powder, powdered sugar, vanilla extract, and salt a large bowl. Beat with an electric mixer until stiff peaks form."
    },
    {
      "position": 2,
      "text": "Serve immediately or chill until serving."
    }
  ],

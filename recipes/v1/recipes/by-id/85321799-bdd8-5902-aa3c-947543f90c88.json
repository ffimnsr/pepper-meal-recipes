  "id": "85321799-bdd8-5902-aa3c-947543f90c88",
  "slug": "chicken-cordon-bleu-casserole-for-one-recipe-11687565",
  "name": "Chicken Cordon Bleu Casserole for One",
  "recipe_type": "main",
  "brief_description": "This chicken Cordon Bleu casserole is everything you want from a chicken Cordon Bleu, but with way less effort. All the flavor is there in a version you can whip up on a weeknight, and easily scale to serve more people.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "For topping, place panko in a small bowl; add in butter, Parmesan, and season with pepper. Stir together until evenly combined and mixture resembles coarse sand; set aside."
    },
    {
      "position": 3,
      "text": "Cut chicken into 1/2-inch cubes and transfer into a bowl. Season with salt, black pepper, cayenne, thyme, and salt. Add cream, Dijon, ham, and 2/3 of the grated Gruyere. Stir to combine, and transfer into a small baking dish. Top evenly with remaining 1/3 of the cheese,"
    },
    {
      "position": 4,
      "text": "Spoon crumb mixture evenly over the top. Poke crumbs down lightly into the chicken mixture with the tip of the spoon before evening out the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until chicken is cooked through, the casserole is bubbling around the edges, and the top is nicely browned, about 25 minutes. Let rest for 5 minutes before serving."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 5,
  "difficulty": "medium",

  "id": "b05e8808-9715-50aa-9566-35bf0220772d",
  "slug": "grandmothers-pound-cake-ii",
  "name": "Grandmother's Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This traditional pound cake recipe uses equal parts butter, sugar, eggs, and flour for a rich, dense, classic dessert you can flavor as you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease three 8x4-inch loaf pans, then line with parchment paper."
    },
    {
      "position": 2,
      "text": "Cream together sugar and butter in a large bowl with an electric mixer on medium speed until light and fluffy. Beat in eggs, one at a time, mixing well after each addition. Beat in flour alternately with milk, beginning and ending with flour, until just combined. Do not overmix. Divide batter evenly among prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cakes comes out clean, about 70 minutes."
    },
    {
      "position": 4,
      "text": "Run a small knife around the edges of each pan. Allow cakes to cool in the pans for 10 minutes, then invert, peel off the parchment, and cool completely on wire racks."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 70,

  "id": "b01c61b6-060d-571f-9504-e621462a771e",
  "slug": "hot-roasted-red-pepper-and-artichoke-dip",
  "name": "Hot Roasted Red Pepper and Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This almost one-dish appetizer is cooked and kept warm in a slow cooker so your guests can enjoy it for hours to come!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese, sour cream, and mayonnaise together with an electric mixer in a large bowl until smooth."
    },
    {
      "position": 2,
      "text": "Stir in roasted red peppers, artichoke hearts, and about half the mozzarella cheese."
    },
    {
      "position": 3,
      "text": "Pour mixture into a slow cooker."
    },
    {
      "position": 4,
      "text": "Sprinkled the remaining mozzarella on top."
    },
    {
      "position": 5,
      "text": "Cook on Low until cheese is melted and the dip is bubbly, 2 to 3 hours. Serve with Italian bread slices."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

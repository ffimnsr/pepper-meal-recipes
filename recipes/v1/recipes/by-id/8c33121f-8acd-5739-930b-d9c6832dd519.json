  "id": "8c33121f-8acd-5739-930b-d9c6832dd519",
  "slug": "crispitos-recipe-8655236",
  "name": "Crispitos",
  "recipe_type": "appetizer",
  "brief_description": "Crispitos are a stuffed tortilla with perfectly seasoned ground beef and lots of cheese, deep-fried until crispy and delicious for a Tex-Mex treat.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon of the oil to a skillet over medium heat. Add onion and garlic; cook and stir for 1 to 2 minutes. Add beef and taco seasoning and cook until beef is brown and crumbly, about 5 minutes. Drain extra liquid from skillet."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over low heat."
    },
    {
      "position": 3,
      "text": "Meanwhile, spread a teaspoon of queso sauce onto a tortilla as \"glue\". Add 1/4 cup browned beef in the center and top with 2 tablespoons cheese. Roll up tortilla and secure roll with a toothpick. Repeat with remaining ingredients."
    },
    {
      "position": 4,
      "text": "Carefully place rolled up tortillas into the hot oil. Fry until golden brown, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Transfer to a wire rack with a slotted spoon. Serve with salsa con questo and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

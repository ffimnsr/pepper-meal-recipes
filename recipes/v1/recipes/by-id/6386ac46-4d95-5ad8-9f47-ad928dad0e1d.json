  "slug": "fresh-salsa",
  "name": "Fresh Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This raw salsa recipe is loaded with vegetables, including plum tomatoes, jalapeno peppers, onions, and jicama.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together tomato, jalape\u00f1o peppers, red onion, green onions, garlic, cilantro, lime juice, lemon juice, cumin, jicama, and diced tomatoes with chilies in a bowl. Season with salt and pepper. Allow to sit at least 1 hour before serving."
    }
  ],

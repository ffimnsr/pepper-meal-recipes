  "id": "9e859c73-dadd-5aeb-ab98-104090d2486f",
  "slug": "chicken-tetrazzini",
  "name": "Chicken Tetrazzini",
  "recipe_type": "main",
  "brief_description": "Leftover chicken flavors this baked spaghetti casserole topped with Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain; transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Melt margarine in a skillet over medium heat. Add onion; cook and stir until soft and translucent, 5 to 7 minutes. Stir into spaghetti along with chicken, evaporated milk, cream of chicken soup, 4 ounces Cheddar cheese, celery salt, salt, and black pepper; toss to combine. Transfer to prepared dish; sprinkle remaining 4 ounces Cheddar cheese over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbling and cheese melted, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

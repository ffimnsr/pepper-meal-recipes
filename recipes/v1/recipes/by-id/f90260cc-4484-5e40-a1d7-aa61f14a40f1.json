  "id": "f90260cc-4484-5e40-a1d7-aa61f14a40f1",
  "slug": "oatmeal-cinnamon-cream-pies",
  "name": "Oatmeal Cinnamon Cream Pies",
  "recipe_type": "dessert",
  "brief_description": "These soft and chewy oatmeal cookie pies with a creamy cinnamon marshmallow filling are sure to be a favorite treat in any lunch box!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, baking soda, 1/2 teaspoon salt, and 1/4 teaspoon cinnamon in a bowl."
    },
    {
      "position": 3,
      "text": "Combine butter, brown sugar, white sugar, eggs, molasses, and 1 teaspoon vanilla extract in a separate bowl; beat with an electric mixer until creamy and smooth. Stir in flour mixture until dough comes together. Stir in oats."
    },
    {
      "position": 4,
      "text": "Drop cookie dough onto the lined baking sheets, a few inches apart, using a 2-teaspoon cookie scoop."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are starting to brown, 7 to 10 minutes. Transfer to a wire rack to cool completely."
    },
    {
      "position": 6,
      "text": "Stir hot water and 1/4 teaspoon salt together in a small bowl until salt is dissolved. Let cool, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Combine marshmallow cream, shortening, confectioners' sugar, 3/4 teaspoon vanilla extract, and 1/4 teaspoon cinnamon in a large bowl; beat with an electric mixer on high speed until fluffy. Mix in cooled salt water."
    },
    {
      "position": 8,
      "text": "Spread some of the filling on the back of 1 cooled cookie. Add another cookie to form a sandwich. Repeat with remaining filling and cookies."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

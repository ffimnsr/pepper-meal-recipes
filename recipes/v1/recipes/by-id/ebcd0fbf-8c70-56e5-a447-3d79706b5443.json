  "id": "ebcd0fbf-8c70-56e5-a447-3d79706b5443",
  "slug": "air-fryer-buffalo-wings-recipe-8645970",
  "name": "Air Fryer Buffalo Wings",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer Buffalo wings are perfectly seasoned and incredibly easy to prep in minutes for crispy, juicy, spicy wings without the mess!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 380 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine sea salt, garlic powder, mustard powder, coriander, smoked paprika, cayenne pepper, and black pepper in a shallow bowl. Dredge each chicken wing in the spice mixture and set into the air fryer basket in one layer."
    },
    {
      "position": 3,
      "text": "Cook in the air fryer until chicken wings are no longer pink at the bone and the juices run clear, about 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C). If wings are smaller, reduce cooking time."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

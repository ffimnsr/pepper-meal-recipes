  "id": "697404ca-122b-5779-b3ae-5764ede83b22",
  "slug": "one-pan-chicken-gnocchi-recipe-8647662",
  "name": "One Pan Chicken Gnocchi",
  "recipe_type": "main",
  "brief_description": "This creamy chicken gnocchi cooks in one pan, from chicken to veggies to creamy sauce, and uses store-bought gnocchi.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil and butter in a heavy skillet over medium heat. Slice chicken breasts in half horizontally to create thin breasts. Sprinkle with seasonings."
    },
    {
      "position": 2,
      "text": "Place chicken in the skillet and cook until golden brown on each side, about 4 minutes. Remove chicken to a plate and keep warm."
    },
    {
      "position": 3,
      "text": "In the same skillet, melt butter. Add gnocchi and season with salt and pepper. Cook until gnocchi is golden, 6 to 7 minutes. Remove gnocchi to a bowl."
    },
    {
      "position": 4,
      "text": "Add broccoli, zucchini, squash, mushrooms, and bell pepper and season with Italian seasoning. Saute until vegetables are crisp and tender, 5 to 7 minutes, depending on the thickness of the vegetables. Add minced garlic during the last 45 seconds; quickly saute until fragrant. Remove vegetables to the same bowl with gnocchi."
    },
    {
      "position": 5,
      "text": "Melt 2 teaspoons butter in the same skillet; and cook shallot until softened and fragrant, about 3 minutes. Pour in chicken broth, half-and-half, and heavy cream. Whisk in flour, and cook, whisking to prevent lumps, until thickened, about 3 minutes. Squeeze in lemon juice to taste."
    },
    {
      "position": 6,
      "text": "Combine gnocchi and vegetables with cream sauce, and top with cooked chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "dbe30214-bfc1-5886-b222-d2d034c9cabd",
  "slug": "shiitake-mushroom-stir-fry-recipe-8722745",
  "name": "Shiitake Mushroom Stir Fry",
  "recipe_type": "dessert",
  "brief_description": "In this shiitake mushroom stir fry, mushrooms, bell peppers, onion, and zucchini are glazed with a delicious sweet-salty soy-chili sauce. Add a protein if you like, and serve over rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, oyster sauce, rice vinegar, sweet Thai chili sauce, maple syrup, and red pepper chili flakes in a small bowl. Stir until smooth and set aside."
    },
    {
      "position": 2,
      "text": "Add mushrooms to a bowl, drizzle with 1 tablespoon soy sauce, and toss until coated. Sprinkle cornstarch over mushrooms and toss until completely coated."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon sesame oil in a wok or large skillet over medium-high heat. Add mushrooms; cook until golden brown, about 5 minutes per side. Transfer mushrooms into a dish; set aside."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon sesame oil in the same wok or skillet over medium-high heat. Add onions, orange peppers, and zucchini, and cook until softened, about 5 minutes. Stir sauce into pan and cook until thickened, about 3 minutes. Add mushrooms back into stir fry; toss to coat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

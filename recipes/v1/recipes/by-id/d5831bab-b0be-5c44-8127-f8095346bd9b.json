  "id": "d5831bab-b0be-5c44-8127-f8095346bd9b",
  "slug": "butternut-squash-fries",
  "name": "Butternut Squash Fries",
  "recipe_type": "dessert",
  "brief_description": "These butternut squash fries are baked in the oven until browned and crisp for a tasty, low-carb alternative to regular fries or sweet potato fries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Use a sharp knife to carefully cut away the peel from the squash. Cut the squash into sticks, about 1/3 inch thick."
    },
    {
      "position": 3,
      "text": "Blot any moisture from the butternut squash fries with paper towels, then arrange squash pieces on a baking sheet. Season with salt."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until brown and crisp on the edges, about 20 minutes, turning once."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

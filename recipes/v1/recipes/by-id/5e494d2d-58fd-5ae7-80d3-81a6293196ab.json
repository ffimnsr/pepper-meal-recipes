  "id": "5e494d2d-58fd-5ae7-80d3-81a6293196ab",
  "slug": "holiday-hot-spinach-dip",
  "name": "Holiday Hot Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "Serve your favorite crackers with this colorful red and green Christmas appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together spinach, bell pepper, garlic, artichokes, sour cream, and parmesan cheese. Season with salt and pepper. Mixture will be thick; add cream to thin to dip consistency. Spoon into a 1-quart baking dish."
    },
    {
      "position": 3,
      "text": "Bake for 20 minutes, or until bubbly. Serve with crackers."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,

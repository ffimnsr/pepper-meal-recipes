  "id": "53b743aa-9dc4-574d-b91a-0cd360b89bca",
  "slug": "rum-truffles",
  "name": "Rum Truffles",
  "recipe_type": "dessert",
  "brief_description": "Premium quality dark chocolate, cream, cake crumbs and rum are the essentials in these exquisite morsels. These truffles will be soft inside despite that it feels firm on the outside. You only need to store them in a cool place, but not necessarily the fridge.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a sheet pan with aluminum foil or parchment paper. Place chopped chocolate in a heatproof bowl."
    },
    {
      "position": 2,
      "text": "In a saucepan, combine cream and butter. Place over low heat, and bring to a boil. Pour over chocolate, and stir until chocolate is melted and smooth. Stir in cake crumbs and rum. Set aside until firm, but not hard."
    },
    {
      "position": 3,
      "text": "Roll heaping teaspoons of chocolate mixture into balls, then roll in the chocolate sprinkles. Place on the prepared tray. Refrigerate 30 minutes or until firm. Serve in small paper cups."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "dee9df4d-d785-5749-b88d-340463d83e91",
  "slug": "traditional-beef-samosas",
  "name": "Traditional Beef Samosas",
  "recipe_type": "appetizer",
  "brief_description": "Coriander, garam masala, and cumin are just a preview of the many spices that flavor these beef samosas made with wonton wrappers.",
  "cuisine": "Indian Inspired Indian Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium heat. Add ground beef, onion, and garlic; cook until beef is browned and crumbly, 5 to 7 minutes. Reduce heat to low."
    },
    {
      "position": 2,
      "text": "Mix in coriander, cumin, salt, turmeric, chile powder, and ginger. Add peas and water; bring to boil. Cover and simmer, stirring occasionally, about 25 minutes. Uncover and cook over medium heat, stirring frequently, until any remaining liquid evaporates."
    },
    {
      "position": 3,
      "text": "Stir jalapenos and garam masala into the beef mixture. Remove from heat and stir in lemon juice; let cool until safe to handle, at least 15 minutes."
    },
    {
      "position": 4,
      "text": "Drop about 1 tablespoon of the beef mixture onto the center of a wonton wrapper. Moisten edges with water, fold them over the filling, and seal. Repeat with remaining filling and wonton wrappers."
    },
    {
      "position": 5,
      "text": "Heat about 1/2 inch oil in a large saucepan over medium-high heat. Add samosas in batches; fry until browned, 1 to 2 inches per side."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "01a49692-b42d-5035-8b85-8578874f445a",
  "slug": "authentic-pad-thai-noodles",
  "name": "Authentic Pad Thai Noodles",
  "recipe_type": "main",
  "brief_description": "Make your own pad Thai recipe at home using this simple vegetarian recipe of rice noodles cooked with scrambled egg and tofu and topped with a perfectly-balanced sauce.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Soak rice vermicelli noodles in a bowl filled with hot water until softened, 30 minutes to 1 hour. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Heat peanut oil over medium heat in a large wok."
    },
    {
      "position": 3,
      "text": "Cook and stir tofu in the wok, turning the pieces until they are golden on all sides."
    },
    {
      "position": 4,
      "text": "Remove tofu with a slotted spoon and drain on plate lined with paper towels."
    },
    {
      "position": 5,
      "text": "Pour all but 1 tablespoon of used oil from the wok into a small bowl; it will be used again in a later step."
    },
    {
      "position": 6,
      "text": "Heat the remaining 1 tablespoon of oil in the wok over medium heat until it starts to sizzle."
    },
    {
      "position": 7,
      "text": "Pour in beaten egg and lightly toss in the hot oil to scramble the egg."
    },
    {
      "position": 8,
      "text": "Remove egg from the wok and set aside."
    },
    {
      "position": 9,
      "text": "Pour reserved peanut oil in the small bowl back into the wok."
    },
    {
      "position": 10,
      "text": "Toss garlic and drained noodles in wok until they are coated with oil."
    },
    {
      "position": 11,
      "text": "Stir in vegetable broth, lime juice, soy sauce, and sugar. Toss and gently push noodles around the pan to coat with sauce."
    },
    {
      "position": 12,
      "text": "Gently mix in tofu, scrambled egg, salt, chili flakes, and 3 tablespoons peanuts; toss to mix all ingredients."
    },
    {
      "position": 13,
      "text": "Mix in bean sprouts and green onions, reserving about 1 tablespoon of each for garnish. Cook and stir until bean sprouts have softened slightly, 1 to 2 minutes."
    },
    {
      "position": 14,
      "text": "Arrange noodles on a warm serving platter and garnish with 3 tablespoons peanuts and reserved bean sprouts and green onions. Place lime wedges around the edges of the platter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

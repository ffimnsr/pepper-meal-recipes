  "slug": "cinnamon-accented-french-toast",
  "name": "Cinnamon-Accented French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Cinnamon French toast is a delicious addition to any brunch, but this tasty recipe is quick and easy enough for breakfast any day of the week.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix beaten eggs, sugar, milk, cinnamon, and salt together in a large, shallow bowl. Dip bread slices into egg mixture to coat."
    },
    {
      "position": 2,
      "text": "Spray a skillet with cooking spray and heat over medium heat. Working in batches, cook bread in the hot skillet until browned, 2 to 3 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

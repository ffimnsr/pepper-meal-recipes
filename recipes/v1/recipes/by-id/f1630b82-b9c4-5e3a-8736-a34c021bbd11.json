  "id": "f1630b82-b9c4-5e3a-8736-a34c021bbd11",
  "slug": "chorizo-queso-potato-bombs-recipe-7971406",
  "name": "Chorizo Queso Potato Bombs",
  "recipe_type": "appetizer",
  "brief_description": "Try these chorizo queso potato bombs if you feel like trying out something new. The perfect appetizer, they are crunchy on the outside and rich and creamy on the inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes and salt in a medium saucepan and add water to cover by 1 inch. Place the pot over high heat and bring to a boil. Cook until just tender, 8 to 10 minutes. Do not cook until soft. Drain and let cool until easy to handle."
    },
    {
      "position": 2,
      "text": "Slice potatoes in half across the center and carefully scoop out the centers, leaving a 1/8-inch border of flesh."
    },
    {
      "position": 3,
      "text": "Combine chorizo sausage and queso dip in a medium bowl; stir until creamy."
    },
    {
      "position": 4,
      "text": "Spoon chorizo mixture into one potato half and place shredded Monterey Jack cheese in the corresponding potato half. Press halves together gently, allowing the potato starch to help seal them. Dip each potato bomb into beaten egg, letting excess drip off, then lightly coat with bread crumbs, taking care not to separate the potato halves."
    },
    {
      "position": 5,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Lightly spray potato bombs with vegetable oil or cooking spray."
    },
    {
      "position": 6,
      "text": "Air fry in batches if necessary until golden and crispy, 8 to 10 minutes. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

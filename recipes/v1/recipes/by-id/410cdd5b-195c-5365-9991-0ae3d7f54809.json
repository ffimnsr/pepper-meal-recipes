  "id": "410cdd5b-195c-5365-9991-0ae3d7f54809",
  "slug": "air-fryer-fries",
  "name": "Air-Fryer Fries",
  "recipe_type": "side",
  "brief_description": "Crispy fries can be made in an air fryer with all the crunch but none of the extra calories and fat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover potatoes with water and let soak for 30 minutes. Drain and pat dry with paper towels. Drizzle with oil; toss to coat."
    },
    {
      "position": 2,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Arrange potatoes in a double layer in the fryer basket. Cook, tossing every 5 minutes, until golden brown, 15 to 20 minutes. Sprinkle with salt and desired seasoning."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

  "id": "602e1d6f-85bf-59a7-a143-3615f946740d",
  "slug": "authentic-mexican-shrimp-cocktail-coctel-de-camarones-estilo-mexicano",
  "name": "Authentic Mexican Shrimp Cocktail (Coctel de Camarones estilo Mexicano)",
  "recipe_type": "appetizer",
  "brief_description": "This truly authentic Mexican shrimp cocktail with plenty of spicy flavors, cucumber, jalapeno, and avocado makes a very refreshing summer appetizer.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix onion with lime juice in a small bowl and allow to stand for 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, toss shrimp, roma tomatoes, cucumber, celery, jalapeno, salt, and black pepper in a medium bowl until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Whisk tomato and clam juice cocktail, ketchup, cilantro, and hot pepper sauce in a separate bowl; stir dressing into shrimp mixture."
    },
    {
      "position": 5,
      "text": "Gently fold in avocados. Stir in onion mixture. Cover and chill thoroughly, at least 1 hour."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

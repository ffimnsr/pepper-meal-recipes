  "id": "a904539b-6ec8-5b04-bdbb-8ac4aea1c2e7",
  "slug": "cauliflower-pizza-crust-from-green-giant",
  "name": "Cauliflower Pizza Crust from Green Giant",
  "recipe_type": "main",
  "brief_description": "No need to chop, process or grate. Start with a bag of our Riced Cauliflower to make this easier-than-ever pizza crust. Bake, then top with all of your favorite pizza toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F."
    },
    {
      "position": 2,
      "text": "Microwave Green Giant Riced Cauliflower according to package directions. Drain cooked cauliflower in a colander, pressing out as much moisture as possible with paper towels. Stir in egg and cheeses."
    },
    {
      "position": 3,
      "text": "Spray baking sheet with nonstick cooking spray. Press cauliflower mixture into an 11-inch circle."
    },
    {
      "position": 4,
      "text": "Bake 25 minutes or until edges are brown and crust is crisp."
    },
    {
      "position": 5,
      "text": "Top with desired pizza toppings. Bake 8 to 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 33,
  "preparation_time_minutes": 10,

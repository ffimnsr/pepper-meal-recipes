  "id": "b144ed8a-c6b4-5476-a53b-fa97a4278a3c",
  "slug": "basic-fondue",
  "name": "Basic Fondue",
  "recipe_type": "appetizer",
  "brief_description": "An easy cheese fondue recipe without wine but with big flavor from Cheddar, garlic, mustard, and more. Perfect for dipping bread or vegetables.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix together milk, flour, Worcestershire sauce, mustard, and garlic in a medium saucepan over low heat. Heat until almost boiling."
    },
    {
      "position": 2,
      "text": "Gradually stir in Cheddar cheese. Continue heating until all the cheese has melted."
    },
    {
      "position": 3,
      "text": "Keep the mixture warm and melted in a fondue dish."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 10,

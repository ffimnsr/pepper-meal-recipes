  "slug": "taco-dip-i",
  "name": "Taco Dip",
  "recipe_type": "appetizer",
  "brief_description": "This tasty taco dip features a spicy layer of cream cheese and sour cream, topped with lettuce, cheese, tomato, and bell pepper. Happy dipping!",
  "cuisine": "Mexican Inspired Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Mix sour cream, cream cheese, and taco seasoning together in a medium bowl until smooth. Spread mixture in a 9- or 10-inch round serving dish."
    },
    {
      "position": 2,
      "text": "Top with shredded lettuce, then sprinkle Cheddar cheese, tomatoes, bell pepper, and black olives on top."
    }
  ],
  "servings": 25,

  "id": "db118b0d-4f0b-52c3-824d-e0c4831775f1",
  "slug": "berry-and-white-chocolate-blondies",
  "name": "Berry and White Chocolate Blondies",
  "recipe_type": "dessert",
  "brief_description": "These blondies with white chocolate chips and mixed berries are fluffier and softer than traditional blondies, and they taste fantastic!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x9-inch pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Mix together melted butter, brown sugar, and white sugar in a large bowl with an electric mixer until thoroughly combined and mixture begins to lighten in color. Mix in egg, vanilla, and almond extract until thoroughly combined. Add in flour, baking soda, salt, and nutmeg, and mix until just combined. Gently fold in berries and white chocolate chips."
    },
    {
      "position": 3,
      "text": "Pour batter into the prepared pan. Carefully spread into an even layer."
    },
    {
      "position": 4,
      "text": "Place pan into preheated oven and bake until blondies are golden brown and set, 35 to 40 minutes. Remove blondies from oven and allow to cool completely in the pan. Gently lift out of the pan using the excess parchment paper. Cut into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

  "id": "610caf3b-b904-511d-90d3-2c6b43b37f72",
  "slug": "chicken-mushroom-linguine",
  "name": "Chicken Mushroom Linguine",
  "recipe_type": "main",
  "brief_description": "This is a relatively easy recipe featuring chicken breasts and fresh mushrooms in a light creamy sauce over linguine pasta. It's very tasty!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add linguine and cook until tender, about 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add onion and mushrooms and cook until tender. Remove from the skillet with a slotted spoon and set aside."
    },
    {
      "position": 3,
      "text": "Add chicken pieces to the pan and sprinkle with garlic. Cook and stir until evenly browned and cooked through. Whisk flour and salt into the pan drippings until smooth. Gradually whisk in chicken broth and simmer over low heat until slightly thickened."
    },
    {
      "position": 4,
      "text": "Return mushrooms and garlic to the pan and stir in sour cream; season with pepper. Cook until heated through, but do not boil. Serve over linguine."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

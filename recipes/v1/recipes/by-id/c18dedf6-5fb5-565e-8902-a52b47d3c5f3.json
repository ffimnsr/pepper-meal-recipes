  "id": "c18dedf6-5fb5-565e-8902-a52b47d3c5f3",
  "slug": "best-salmon-bake",
  "name": "Best Salmon Bake",
  "recipe_type": "main",
  "brief_description": "Cook salmon in the oven for a deliciously quick and simple dinner. The salmon is topped with tomato and green onion, and baked to perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Place salmon on a lightly oiled sheet pan or in a shallow baking dish, folding under thin outer edges of fillets for even cooking."
    },
    {
      "position": 4,
      "text": "Top salmon with chopped tomatoes and green onions, and season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Cook salmon in the preheated oven, uncovered, until fish flakes easily with a fork, about 20 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

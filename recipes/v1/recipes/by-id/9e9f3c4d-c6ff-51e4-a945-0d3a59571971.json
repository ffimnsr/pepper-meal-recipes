  "id": "9e9f3c4d-c6ff-51e4-a945-0d3a59571971",
  "slug": "baked-chicken-wings",
  "name": "Baked Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "These flavorful chicken wings with a spicy coating are baked in the oven until crispy perfection for a fuss-free way to prepare chicken wings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine olive oil, garlic, chili powder, garlic powder, salt, and pepper in a large, resealable bag; seal and shake to combine. Add chicken wings; reseal and shake to coat. Arrange chicken wings on a baking sheet."
    },
    {
      "position": 3,
      "text": "Cook chicken wings in the preheated oven until crisp and cooked through, about 30 to 45 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "4d9702cc-327c-5a06-870e-4ac495068a26",
  "slug": "baked-philly-cheesesteak-sliders",
  "name": "Baked Philly Cheesesteak Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These tasty cheesesteak sliders from Chef John feature mini sandwich rolls filled with tender sirloin, provolone cheese, pickled peppers, and onions.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium-high heat. Season steaks generously with salt, black pepper, and cayenne. Cook steaks in hot oil for 5 to 6 minutes. Flip and add onions around steaks. Continue cooking until steaks begin to firm and are hot and slightly pink in the center, 5 to 6 minutes more. Push onions under steaks and cook until browned but still crunchy, 2 to 3 minutes more. Remove steaks and saut\u00e9ed onions to a plate."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking tray with aluminum foil."
    },
    {
      "position": 3,
      "text": "Place rolls on the prepared baking tray. Hollow out the top of each roll by cutting in at a 45-degree angle. Pinch off some of the bread inside to make room for the filling."
    },
    {
      "position": 4,
      "text": "Slice steaks into thin strips, then across into 1/2-inch pieces. Transfer to a mixing bowl. Add saut\u00e9ed onions and accumulated meat juices. Toss in 1 \u00bd cups provolone, pickled peppers, cream cheese, 1 teaspoon kosher salt, and 1/4 teaspoon black pepper; mix until thoroughly combined. Taste and season with salt if needed. Spoon filling into rolls and top with remaining 1 cup provolone cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and the edges of rolls start to brown, about 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "18d5ee75-c0c7-58de-9d22-d74dd698f8d2",
  "slug": "tropical-salad-with-pineapple-vinaigrette",
  "name": "Tropical Salad with Pineapple Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "An easy salad to make with a bag of salad greens, pineapple, bacon bits, nuts and toasted coconut. Use fresh pineapple, if you can, and substitute toasted almonds for the macadamia nuts, if desired.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly browned, about 10 minutes. Drain, crumble, and set aside."
    },
    {
      "position": 2,
      "text": "Combine pineapple juice, red wine vinegar, oil, pepper and salt in a lidded jar or cruet. Cover and shake well."
    },
    {
      "position": 3,
      "text": "Toss lettuce, pineapple, macadamia nuts, green onions and bacon together in a large bowl. Pour dressing over salad and toss to coat. Garnish with toasted coconut."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

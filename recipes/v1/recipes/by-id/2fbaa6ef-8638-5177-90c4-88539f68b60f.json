  "id": "2fbaa6ef-8638-5177-90c4-88539f68b60f",
  "slug": "easy-spring-rolls-air-fried",
  "name": "Easy Spring Rolls (Air Fried)",
  "recipe_type": "appetizer",
  "brief_description": "Let your air fryer deliver spring rolls that are crispy, golden, and stuffed with rice noodles, beef, and vegetables \u2014 rolled with love and care.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Soak noodles in a bowl of hot water until soft, about 5 minutes. Cut noodles into shorter strands."
    },
    {
      "position": 3,
      "text": "Heat sesame oil in a wok over medium-high heat. Add ground beef, mixed vegetables, onion, and garlic. Cook until beef is almost browned throughout, about 6 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Stir in noodles; let stand until juices have been absorbed."
    },
    {
      "position": 5,
      "text": "Add soy sauce to the filling. Preheat the air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Lay out 1 egg roll wrapper onto a flat work surface; place a diagonal strip of filling across the wrapper."
    },
    {
      "position": 7,
      "text": "Fold the top corner over the filling; fold in the two side corners; brush center with cold water and roll spring roll over to seal. Repeat with the remaining wrappers and filling."
    },
    {
      "position": 8,
      "text": "Brush the tops of the spring rolls with vegetable oil."
    },
    {
      "position": 9,
      "text": "Arrange a batch of spring rolls into the basket of the air fryer; cook until crisped and lightly browned, about 8 minutes. Repeat until all are cooked."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

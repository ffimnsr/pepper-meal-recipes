  "id": "1942c0cb-4932-53c0-bb0b-8b34a2967401",
  "slug": "bretts-slow-cooker-loaded-baked-potato-soup",
  "name": "Brett's Slow Cooker Loaded Baked Potato Soup",
  "recipe_type": "soup",
  "brief_description": "Simmer Brett's slow cooker loaded baked potato soup recipe with bacon in your slow cooker for an easy, comfort food dish that you can make ahead of time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine potatoes, chicken broth, onion, butter, salt, and black pepper in a slow cooker. Cover."
    },
    {
      "position": 2,
      "text": "Cook on High until soup flavors have melded and potatoes are extremely soft, 4 to 5 hours."
    },
    {
      "position": 3,
      "text": "Stir in bacon, half-and-half, Cheddar cheese, and sour cream. Cook on Low until thick and creamy, 15 to 20 minutes more."
    },
    {
      "position": 4,
      "text": "Mash soup with a potato masher to your desired consistency."
    },
    {
      "position": 5,
      "text": "Garnish with additional Cheddar cheese, sour cream, and chives."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 255,

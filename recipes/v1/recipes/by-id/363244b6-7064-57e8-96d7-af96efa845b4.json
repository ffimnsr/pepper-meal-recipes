  "id": "363244b6-7064-57e8-96d7-af96efa845b4",
  "slug": "matcha-mousse",
  "name": "Matcha Mousse",
  "recipe_type": "dessert",
  "brief_description": "The beloved flavor of matcha shines in this ultra-light and fluffy mousse dessert that's also a breeze to prepare, making it a great idea for entertaining.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve gelatin in 4 tablespoons hot water in a bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Mix brown sugar and egg yolks together in a medium bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Heat milk in a saucepan over low heat, about 5 minutes. Stir in gelatin mixture until dissolved, making sure not to overheat milk. Remove from heat. Pour milk mixture into egg mixture gradually, stirring well."
    },
    {
      "position": 4,
      "text": "Mix 2 tablespoons hot water and green tea powder together in a bowl. Set bowl of gelatin mixture on top of a bowl filled with ice water; stir matcha paste into mixture as it cools."
    },
    {
      "position": 5,
      "text": "Whip heavy cream in a bowl using an electric mixer until firm but not yet forming peaks, about 3 minutes. Add to matcha mixture; stir well until fully incorporated, about 1 minute."
    },
    {
      "position": 6,
      "text": "Pour mousse evenly into 8 serving glasses. Chill in the refrigerator at least 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

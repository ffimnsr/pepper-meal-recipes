{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0fc2a6ca-9162-5c47-b40d-73d580587e3f",
  "slug": "no-bake-millionaire-s-shortbread-recipe-11703318",
  "name": "No-Bake Millionaire\u2019s Shortbread",
  "recipe_type": "dessert",
  "brief_description": "This no-bake millionaire's shortbread has a buttery, tender base followed by a layer of homemade melt-in-your mouth caramel and topped with dark chocolate. Sprinkle with sea salt to cut the sweetness if you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease a 9x9-inch square baking pan and line with parchment paper so parchment paper overhangs edges by 1-inch."
    },
    {
      "position": 2,
      "text": "Pulse cookies in a food processor until fine crumbs form."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt 1/2 cup butter and add to the cookie crumbs in the food processor; pulse until combined."
    },
    {
      "position": 4,
      "text": "Press crumb mixture firmly and evenly into the bottom of the prepared baking pan using the flat bottom of a measuring cup or glass. Refrigerate for 30 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine 6 tablespoons butter, sweetened condensed milk, brown sugar, and salt in a saucepan. Cook over medium-high heat until boiling, stirring often."
    },
    {
      "position": 6,
      "text": "Reduce heat to medium. Cook, stirring continuously, until a candy thermometer reads 230 to 235 degrees F (110 to 113 degrees C) or until thickened and darkened in color, 6 to 8 minutes. Pour caramel over the chilled shortbread base and spread evenly. Refrigerate for 2 hours."
    },
    {
      "position": 7,
      "text": "Once caramel has chilled, combine dark chocolate chips and remaining 2 tablespoons butter in a microwave safe bowl."
    },
    {
      "position": 8,
      "text": "Microwave chocolate on High until melted and smooth, 1 to 2 minutes, stirring every 20 seconds. Spread melted chocolate mixture evenly over the chilled caramel layer."
    },
    {
      "position": 9,
      "text": "Sprinkle with coarse sea salt after standing for 10 minutes, if desired. Refrigerate until set, about 1 hour."
    },
    {
      "position": 10,
      "text": "Remove from the pan, place on a cutting board, and let stand for 30 minutes."
    },
    {
      "position": 11,
      "text": "Cut into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

  "slug": "basic-congee-recipe-8726810",
  "name": "Basic Congee (Chinese Rice Porridge)",
  "recipe_type": "soup",
  "brief_description": "This creamy congee recipe simmers rice in fragrant ginger broth to make a velvety rice porridge. Top with chili oil, crispy onions, or anything you like!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Add stock, rice, salt, and ginger to a large saucepan, and bring to a boil over medium heat, stirring occasionally, making sure rice does not stick to the bottom. Reduce heat to low; simmer, stirring every 10 minutes, until thick and creamy, about 1 hour."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,

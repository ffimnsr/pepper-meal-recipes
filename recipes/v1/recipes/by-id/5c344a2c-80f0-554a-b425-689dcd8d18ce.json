  "id": "5c344a2c-80f0-554a-b425-689dcd8d18ce",
  "slug": "chicken-fajita-bake",
  "name": "Chicken Fajita Bake",
  "recipe_type": "main",
  "brief_description": "This rich baked fajita is composed of black beans, pinto beans, tortillas, and cheese between layers of sauteed chicken and vegetables.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium heat. Add chicken; cook and stir until browned on all sides, about 6 minutes. Transfer chicken to a plate."
    },
    {
      "position": 3,
      "text": "Heat oil in the hot skillet. Add tomato, bell pepper, and onion; cook and stir until softened, 5 to 7 minutes. Mix in cooked chicken, water, and fajita seasoning."
    },
    {
      "position": 4,
      "text": "Line the bottom of the prepared pan with 5 tortillas; pour pinto beans on top. Spread 1/2 of the chicken mixture over the beans; cover with Cheddar cheese. Layer the remaining tortillas, black beans, and chicken mixture on top. Cover with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tortillas are lightly browned and chicken juices run clear, 25 to 30 minutes. Top with green onions and cilantro."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 36,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

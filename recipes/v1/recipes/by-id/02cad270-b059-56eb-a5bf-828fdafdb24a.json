  "id": "02cad270-b059-56eb-a5bf-828fdafdb24a",
  "slug": "powdered-sugar-cookies-i",
  "name": "Powdered Sugar Cookies I",
  "recipe_type": "dessert",
  "brief_description": "If you want sugar cookies that melt in your mouth, this is the recipe for you.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat sugars, margarine, vegetable oil and salt very well. Add eggs and dry ingredients."
    },
    {
      "position": 2,
      "text": "Make into balls, roll in sugar and place 1 inch apart on ungreased cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 8 minutes. For holidays or special occasions, roll in colored sugar instead of white sugar."
    }
  ],

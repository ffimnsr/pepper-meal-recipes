  "id": "9af992a4-ce96-52b3-9be1-82f655e1656c",
  "slug": "jens-nachos",
  "name": "Jen's Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Barbecue sauce is the surprise ingredient here--it's sauteed with ground beef and more traditional nacho toppings for a tangy twist on this everyday dish.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Brown beef in a large skillet over a medium-high heat. Drain the fat from the pan once the meat is browned."
    },
    {
      "position": 2,
      "text": "Mix Cheddar cheese, tomatoes, corn and barbecue sauce into the meat. Heat this mixture, stirring occasionally."
    },
    {
      "position": 3,
      "text": "While the mixture is heating, make beds of chips onto 4 plates. Pour the hot mixture over the chips. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

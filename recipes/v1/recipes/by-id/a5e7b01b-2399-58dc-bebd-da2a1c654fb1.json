  "id": "a5e7b01b-2399-58dc-bebd-da2a1c654fb1",
  "slug": "the-best-loaded-baked-beans-recipe-11998753",
  "name": "The Best Loaded Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "The best loaded baked beans recipe earns its name with sweet, smoky, savory flavor in every bite. Hearty, crowd-pleasing, and packed with seasoned beef and sausage, this is the kind of side dish you\u2019ll be proud to bring to any potluck, cookout, or family gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add beef and cook, crumbling with a spoon until browned and finely crumbled. Drain beef and set aside. Return skillet to the stove over medium-high heat."
    },
    {
      "position": 2,
      "text": "Add sausage and cook, stirring often, until beginning to brown and fat has rendered, about 3 minutes. Add onion and bell pepper and cook, stirring often, 1 minute. Transfer sausage and vegetable mixture to a large bowl."
    },
    {
      "position": 3,
      "text": "Add ground beef to the bowl along with jalapeno, baked beans, barbecue sauce, yellow mustard, brown sugar, garlic powder, hot sauce, Worcestershire, salt, and black pepper. Stir until well combined and pour mixture into a 9x13-inch baking dish. Cover with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated 350 degree F oven for 35 to 40 minutes. Uncover and bake until browned and bubbly, 15 to 20 minutes. Let stand 10 minutes before serving. Serve topped with green onions if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

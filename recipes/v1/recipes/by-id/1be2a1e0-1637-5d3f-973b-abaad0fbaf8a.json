  "id": "1be2a1e0-1637-5d3f-973b-abaad0fbaf8a",
  "slug": "thanksgiving-yams",
  "name": "Thanksgiving Yams",
  "recipe_type": "dessert",
  "brief_description": "This 5-ingredient Thanksgiving yam recipe, made with canned sweet potatoes, gingersnap cookies, and marshmallows on top, makes this dish a real treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sweet potatoes, butter, and lemon juice in a large saucepan over medium heat. Break gingersnap cookies into sweet potatoes mixture; cook, stirring occasionally, until thick, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Spread desired amount of marshmallows over sweet potato mixture. Off heat, cover with a lid until marshmallows melted, about 5 minutes. Serve warm."
    }
  ],
  "servings": 12,

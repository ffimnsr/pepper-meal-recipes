  "slug": "festive-fresh-blueberry-and-cranberry-relish",
  "name": "Festive Fresh Blueberry and Cranberry Relish",
  "recipe_type": "side",
  "brief_description": "Blueberries add a new spin to the traditional cranberry relish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat cranberries, blueberries, orange juice, sugar, orange zest, and vanilla in a saucepan over medium heat. Cook and stir until the sugar dissolves and berries soften, about 15 minutes. Cover and chill until ready to serve."
    }
  ],

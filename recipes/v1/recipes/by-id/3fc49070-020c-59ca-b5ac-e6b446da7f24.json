  "slug": "dry-onion-soup-mix",
  "name": "Dry Onion Soup Mix",
  "recipe_type": "soup",
  "brief_description": "Whip up onion soup mix using dry ingredients you may already have in your pantry. This is an easy homemade substitute to store-bought for soup or dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir onion flakes, beef bouillon granules, onion powder, parsley flakes, celery seed, paprika, and black pepper together in a bowl. Use as a substitute for a 1-ounce envelope of dry onion soup mix."
    }
  ],
  "servings": 4,

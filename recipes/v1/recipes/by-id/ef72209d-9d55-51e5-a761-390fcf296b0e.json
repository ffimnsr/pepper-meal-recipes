  "id": "ef72209d-9d55-51e5-a761-390fcf296b0e",
  "slug": "air-fryer-sriracha-fries-recipe-8694021",
  "name": "Air Fryer Sriracha Fries",
  "recipe_type": "side",
  "brief_description": "These air fryer Sriracha fries are the best French fries for anyone who loves spicy food\u2014golden, crispy, and spicy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut potatoes into fries. Place cut fries into a bowl of water; soak for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Line a baking sheet with paper towels and set a wire rack over the sheet."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 375 degrees F according to manufacturer\u2019s instructions."
    },
    {
      "position": 4,
      "text": "Drain fries, and pat dry with a paper towel. Place fries in a resealable plastic bag. Add oil, 1 tablespoon Sriracha, and salt. Seal the bag and toss to coat."
    },
    {
      "position": 5,
      "text": "Add fries to bottom of air fryer basket in a single flat layer, not stacked. You will have to work in batches."
    },
    {
      "position": 6,
      "text": "Air fry until crispy and golden brown, about 13 minutes."
    },
    {
      "position": 7,
      "text": "Place fries on the prepared baking sheet; keep warm in the preheated oven. Repeat with remaining fries."
    },
    {
      "position": 8,
      "text": "Place fries on a platter; drizzle with remaining sriracha. Enjoy."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

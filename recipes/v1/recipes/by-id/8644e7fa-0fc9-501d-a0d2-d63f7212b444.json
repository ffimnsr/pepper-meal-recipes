  "id": "8644e7fa-0fc9-501d-a0d2-d63f7212b444",
  "slug": "sloppy-joe-garlic-bread-recipe-11706291",
  "name": "Sloppy Joe Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This sloppy Joe garlic bread is a great way to use up the leftovers from making sloppy Joes, or even chili, but if you don\u2019t have leftovers, you can buy any number of canned or jarred versions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Lay ciabatta halves, cut sides up, on the parchment paper. If the top half rocks a bit, just slice a bit off the top so that it lays flat."
    },
    {
      "position": 3,
      "text": "Butter cut sides, then lightly sprinkle with garlic salt. Spread sloppy Joe mixture over to cover bread to the edges. Sprinkle with Cheddar cheese, then mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 15 minutes. To serve as an appetizer, slice each half into 2 pieces. Sprinkle with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "aea98090-8022-5e71-96e1-816991c72858",
  "slug": "marinated-flank-steak-with-horseradish-cream",
  "name": "Marinated Flank Steak with Horseradish Cream",
  "recipe_type": "main",
  "brief_description": "Flank steak is marinated overnight in a rosemary-soy sauce mixture before it's grilled and served with a horseradish cream sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, sherry, onion, olive oil, brown sugar, rosemary, garlic, and pepper in a bowl and mix well. Pierce flanks steak throughout using a large fork, flip, and repeat. Place steak in a plastic zip-top bag and pour in marinade to cover. Marinate in the refrigerator, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Combine sour cream, green onions, horseradish, salt, and pepper in a bowl. Cover and refrigerate sauce until ready to use, up to 24 hours."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Drain steak and pour marinade into a small saucepan. Bring marinade to a boil over high heat and boil for 1 minute. Remove from heat. Season steak with pepper."
    },
    {
      "position": 5,
      "text": "Cook steak on the preheated grill to desired doneness, basting occasionally with marinade, about 5 minutes per side for medium doneness. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C)."
    },
    {
      "position": 6,
      "text": "Transfer steak to a plate and let rest for 15 minutes. Cut across the grain into thin diagonal slices. Serve hot or at room temperature with horseradish sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "c50ea614-c676-5c60-b912-c8431ecd125d",
  "slug": "blue-cranberry-sauce",
  "name": "Blueberry Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "A pint of fresh blueberries is incorporated into this recipe for a traditional cranberry sauce made from scratch. This sauce can be made a day or two ahead.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Wash and pick over cranberries. Place in a medium saucepan with water, and sugar. Bring to a boil, reduce heat, stir and simmer for 10 minutes or until cranberries burst."
    },
    {
      "position": 2,
      "text": "Slightly mash the cranberries with the back of a wooden spoon to insure all skins are broken. Add the cinnamon, nutmeg and allspice. Mix well."
    },
    {
      "position": 3,
      "text": "Remove from heat and mix in the blueberries (don't be afraid to break a few, but don't over mash either). The sauce will thicken as it cools."
    },
    {
      "position": 4,
      "text": "Transfer to a bowl, cool slightly and place plastic wrap directly on top of sauce to cover. Refrigerate until chilled."
    }
  ],
  "servings": 9,

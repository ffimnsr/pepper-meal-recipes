  "id": "318aa89e-a50f-57f3-a0fa-03c690902f09",
  "slug": "mushroom-and-artichoke-soup",
  "name": "Mushroom and Artichoke Soup",
  "recipe_type": "soup",
  "brief_description": "Need to feed 50 vegetarians? This delicious soup (and there is lots of it) is full of artichoke hearts, white mushrooms, dried portobello mushrooms, red onion, shallots, and carrots. A great recipe for a big party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place artichokes in a food processor, slice thinly and set aside. It works well when using a 3 millimeter slicing disk."
    },
    {
      "position": 2,
      "text": "Using a extra-large stock pot saute onions, garlic and shallots in olive oil and set on low. Cook for 15 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle flour over onions and cook for 1 minute. Stir in vinegar and cook for approximately 3 minutes, in order for vinegar to evaporate."
    },
    {
      "position": 4,
      "text": "Stir in water, vegetable base, salt, pepper, cayenne, nutmeg, thyme and sliced artichokes and cook for 25 minutes."
    },
    {
      "position": 5,
      "text": "Add dried mushrooms along with the water they soaked in, fresh mushrooms and carrots. Let cook for 15 minutes."
    },
    {
      "position": 6,
      "text": "Stir in capers and parsley, season with salt and serve."
    }
  ],
  "servings": 50,
  "cooking_time_minutes": null,

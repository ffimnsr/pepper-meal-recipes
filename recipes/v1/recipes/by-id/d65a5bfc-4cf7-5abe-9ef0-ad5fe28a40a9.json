  "id": "d65a5bfc-4cf7-5abe-9ef0-ad5fe28a40a9",
  "slug": "instant-pot-pinto-beans-no-soaking",
  "name": "Instant Pot Pinto Beans (No Soaking)",
  "recipe_type": "side",
  "brief_description": "This easy recipe for Instant Pot pinto beans requires no soaking! Just pop the beans in your multi-functional pressure cooker and let them cook.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add bacon and cook, turning once, 4 to 6 minutes."
    },
    {
      "position": 3,
      "text": "Add chicken broth, pinto beans, water, onions, chile peppers, garlic powder, salt, chili powder, cumin, and paprika. Close and lock the lid."
    },
    {
      "position": 4,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 45 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 6,
      "text": "Remove bacon and chile peppers; chop to desired consistency and return to the pot. Mash beans with a potato masher until they reach desired consistency."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

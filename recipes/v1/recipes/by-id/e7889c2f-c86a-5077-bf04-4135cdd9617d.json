  "id": "e7889c2f-c86a-5077-bf04-4135cdd9617d",
  "slug": "creamy-tortellini-soup-with-spinach-and-boursin",
  "name": "Creamy Tortellini Soup with Spinach and Boursin",
  "recipe_type": "soup",
  "brief_description": "One-pot creamy tortellini soup with spinach, Boursin cheese, and Italian sausage is ready in 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook sausage in a large stockpot over medium heat, crumbling and breaking up with a spatula, until evenly browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in tomatoes, tortellini, vegetable broth, evaporated milk, heavy cream, and Boursin cheese."
    },
    {
      "position": 3,
      "text": "Bring to a simmer; cook, uncovered, until tortellini float to the top and the filling is hot, about 8 minutes. Stir in the spinach; cook until wilted, about 2 minutes. Season with Italian seasoning and Parmesan cheese."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

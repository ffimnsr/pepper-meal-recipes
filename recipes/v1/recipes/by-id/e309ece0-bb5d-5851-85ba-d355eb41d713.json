  "id": "e309ece0-bb5d-5851-85ba-d355eb41d713",
  "slug": "german-heaven-and-earth-potatoes-himmel-und-erde-recipe-11946149",
  "name": "German Heaven and Earth Potatoes (Himmel und Erde)",
  "recipe_type": "side",
  "brief_description": "Heaven and Earth potatoes (Himmel und Erde) are a traditional German rustic side dish which originated in Rhineland. It\u2019s more than mashed potatoes, and its simplicity lies in a mixture of apples (heaven) paired with potatoes (earth), but those onions are also divine. It\u2019s often served with sausage or pork dishes, but goes well with just about everything.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium heat, and melt 2 tablespoons butter. Add onions and cook, stirring occasionally, until browned and just a bit crispy around the edges, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, add potatoes and apples to a large saucepan filled with just enough generously salted water to cover them by about 1 inch. Bring to a low boil over medium heat. Cook until potatoes and apples are fork tender, 10 to 15 minutes. The apples will soften more quickly than the potatoes."
    },
    {
      "position": 3,
      "text": "Drain potato-apple mixture and return to the saucepan. Stir in remaining butter, sugar, garlic powder, salt, pepper, and nutmeg, and mash to your preference, either chunky or smooth."
    },
    {
      "position": 4,
      "text": "Cover the saucepan to keep warm. Spoon onions over potatoes to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "70ae7296-0753-5534-aac0-45c67a4c9984",
  "slug": "cafe-tropical-burrito-recipe-8777851",
  "name": "Caf\u00e9 Tropical Burrito",
  "recipe_type": "breakfast",
  "brief_description": "This breakfast burrito comes together quickly. Scrambled eggs, bacon, cheese, and a hashbrown patty are served up in a tortilla for a satisfying start into your day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned and crisp, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Drain most of the bacon grease out of the skillet. Add hashbrown patty to the remaining hot bacon grease and fry over medium heat until hot, crispy, and golden brown, about 5 minutes. You can also use canola or grapeseed oil instead of bacon grease"
    },
    {
      "position": 4,
      "text": "Meanwhile, pour beaten eggs into a nonstick pan or flat top; let cook undisturbed until the bottom of the eggs begins to firm, 1 to 2 minutes. Stir in Cheddar and Swiss cheese and season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Cook and stir until eggs are nearly set, light, and fluffy, 3 to 4 minutes more."
    },
    {
      "position": 6,
      "text": "While eggs are cooking, heat tortilla on the stovetop until lightly browned and warm."
    },
    {
      "position": 7,
      "text": "To assemble the burrito, place hashbrown patty onto the tortilla. Top with scrambled eggs and bacon. Fold two sides of the burrito to the center, roll up, and serve."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

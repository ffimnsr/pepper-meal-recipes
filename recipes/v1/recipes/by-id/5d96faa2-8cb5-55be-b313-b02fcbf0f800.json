  "id": "5d96faa2-8cb5-55be-b313-b02fcbf0f800",
  "slug": "easy-mayonnaise-biscuits",
  "name": "Easy Mayonnaise Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These homemade mayonnaise biscuits are tender, flavorful, and so easy to make with just 3 simple ingredients, including self-rising flour and milk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease 6 large muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together flour, milk, and mayonnaise in a large bowl until smooth. Pour evenly into the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

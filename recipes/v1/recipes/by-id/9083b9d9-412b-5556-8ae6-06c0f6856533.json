  "id": "9083b9d9-412b-5556-8ae6-06c0f6856533",
  "slug": "holiday-ginger-snap-crust",
  "name": "Holiday Gingersnap Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "A gingersnap pie crust is perfect for holiday pies or cheesecakes, providing a bit more taste than plain old graham crackers, but just as easy to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Set aside 12 to 18 whole gingersnap cookies. Crush remaining cookies until you have 1 1/2 cups fine crumbs. Reserve any remaining cookies for another use."
    },
    {
      "position": 4,
      "text": "Mix gingersnap crumbs, brown sugar, and melted butter together in a bowl until well combined."
    },
    {
      "position": 5,
      "text": "Press mixture into the bottom of a 9-inch springform pan."
    },
    {
      "position": 6,
      "text": "Arrange whole gingersnap cookies upright around the border of the springform pan, pressing into the base and overlapping slightly if necessary, so that they stand firmly."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until set, about 7 minutes. Cool crust completely before filling."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

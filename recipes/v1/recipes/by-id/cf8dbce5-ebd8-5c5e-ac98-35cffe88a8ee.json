  "id": "cf8dbce5-ebd8-5c5e-ac98-35cffe88a8ee",
  "slug": "caramel-apple-overnight-oats-recipe-8706324",
  "name": "Caramel Apple Overnight Oats",
  "recipe_type": "dessert",
  "brief_description": "Easy, cozy, and packed with seasonal flavors, Caramel Apple Overnight Oats are the perfect fall breakfast. Between the tart apples, sweet caramel, and warm apple pie spice, they bring full fall flavor in a small, satisfying package. Here's how to make Caramel Apple Overnight Oats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together oats, apple cider, yogurt, caramel sauce, chia seeds, apple pie spice, and 1 cup of the apples in a medium bowl until combined."
    },
    {
      "position": 3,
      "text": "Drizzle caramel sauce inside 4 (12-oz.) jars."
    },
    {
      "position": 4,
      "text": "Spoon oat mixture evenly into prepared jars (about 1 1/4 cups each). Cover with plastic wrap and refrigerate for at least 8 hours or up to 4 days."
    },
    {
      "position": 5,
      "text": "When ready to serve, top each with 1/4 cup remaining apples and drizzle with additional caramel sauce. Top as desired. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

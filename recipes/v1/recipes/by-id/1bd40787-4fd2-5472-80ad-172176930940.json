  "id": "1bd40787-4fd2-5472-80ad-172176930940",
  "slug": "angel-food-cake-ii",
  "name": "Light and Fluffy Angel Food Cake",
  "recipe_type": "dessert",
  "brief_description": "This homemade angel food cake makes a great birthday cake. Decorate with frosting or dress it up with strawberry sauce and whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Wash angel food tube pan in hot soapy water to ensure it is totally grease free. Let dry completely. Sift flour and 3/4 cup confectioners' sugar together three times; set aside."
    },
    {
      "position": 2,
      "text": "In mixing bowl, beat egg whites and salt on high speed until foamy. Add cream of tartar, 1 teaspoon vanilla, and almond flavoring; beat until soft peaks form. Peaks should be soft enough so they bend over slightly at the tips. Gradually add 1 cup white sugar, continuing to beat until stiff peaks form. Sift about 1/4 of the flour mixture over the egg whites, and using flat spatula, quickly but gently fold into egg whites. Repeat using 1/4 of the flour mixture each time. Pour batter into clean tube pan. Gently cut through batter with knife to remove air pockets."
    },
    {
      "position": 3,
      "text": "Bake for about 30 to 35 minutes, until an inserted wooden pick comes out clean. Invert pan onto a wire rack to cool for 1 hour."
    },
    {
      "position": 4,
      "text": "Beat 2 cups confectioners' sugar, butter, cream, and 1 teaspoon vanilla together until smooth. Add more cream or confectioners' sugar as needed. Frost the cooled cake."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

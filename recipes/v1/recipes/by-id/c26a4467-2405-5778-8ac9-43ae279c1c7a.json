  "id": "c26a4467-2405-5778-8ac9-43ae279c1c7a",
  "slug": "instant-pot-quinoa",
  "name": "Instant Pot\u00ae Quinoa",
  "recipe_type": "side",
  "brief_description": "This quinoa is so quick and easy--in no time at all you'll have a delicious, gluten-free side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and quinoa in a multi-functional pressure cooker (such as Instant Pot\u00ae); mix well. Close and lock the lid; set the pressure release valve to the sealing position. Press Steam button twice and set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,

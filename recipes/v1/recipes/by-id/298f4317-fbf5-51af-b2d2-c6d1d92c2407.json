  "schema_version": 1,
  "id": "298f4317-fbf5-51af-b2d2-c6d1d92c2407",
  "slug": "raspberry-almond-coffeecake",
  "name": "Raspberry Almond Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist, light cake is \u201cberry\u201d delicious as a dessert or for breakfast. Your house will smell just wonderful while it is baking and cooling. Recipe doubles well.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8-inch round cake pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine raspberries and brown sugar in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine flour, sugar, baking soda, baking powder, and salt. Combine sour cream, butter or margarine, 1 teaspoon vanilla, and egg, and add to flour mixture. Stir just until moist. Spoon 2/3 of batter into the prepared pan. Spread raspberry mixture evenly over batter. Spoon remaining batter over raspberry mixture. Top with almonds."
    },
    {
      "position": 4,
      "text": "Bake for 40 minutes, or until a wooden pick inserted in center comes out clean. Let cool for 10 minutes on a wire rack."
    },
    {
      "position": 5,
      "text": "Combine confectioners\u2019 sugar, milk, and 1/4 teaspoon vanilla. Stir well. Drizzle glaze over cake. Serve warm or at room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

  "slug": "new-years-champagne-punch",
  "name": "New Year\u2019s Champagne Punch",
  "recipe_type": "dessert",
  "brief_description": "This holiday Champagne punch made with sherbet, orange juice, ginger ale, and Champagne is colorful, delicious, and will really get a party going!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sherbet block in the center of a large punch bowl. Pour orange juice over top, followed by ginger ale and Champagne. Stir gently to mix liquids until top of punch begins to foam. Serve immediately."
    }
  ],

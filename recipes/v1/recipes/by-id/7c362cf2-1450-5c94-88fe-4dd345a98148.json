  "slug": "chocolate-coconut-overnight-oats",
  "name": "Chocolate Coconut Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Chocolate coconut overnight oats, made with almond milk, is a dairy-free, vegan breakfast perfect for on-the-go eating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix almond milk, oats, chia seeds, coconut, maple syrup, cocoa powder, and vanilla extract in a 12-ounce mason jar."
    },
    {
      "position": 2,
      "text": "Cover and refrigerate, 8 hours to overnight. Stir and serve cold."
    }
  ],

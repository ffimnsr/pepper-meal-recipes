  "id": "330a96e1-5042-5ee7-888d-1c375411c899",
  "slug": "the-best-buffalo-chicken-dip",
  "name": "The Best Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "This easy Buffalo chicken dip recipe makes a creamy and delicious party dip with cooked chicken, cheese, and hot sauce for the perfect amount of heat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken onto a large sheet of foil and sprinkle evenly with salt, pepper, and garlic powder. Wrap foil around chicken to form a pouch, sealing it around the edges. Place foil pouch onto a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 hour. Remove from the oven and let stand for 15 minutes to cool slightly."
    },
    {
      "position": 4,
      "text": "Meanwhile, increase the oven temperature to 375 degrees F (190 degrees C). Lightly grease a baking dish with cooking spray."
    },
    {
      "position": 5,
      "text": "Stir together cream cheese, ranch dressing, and hot sauce in a large bowl until well combined."
    },
    {
      "position": 6,
      "text": "Roughly chop or shred cooked chicken. Add to cream cheese mixture along with Cheddar cheese; stir to combine. Pour mixture into the prepared baking dish and sprinkle with blue cheese."
    },
    {
      "position": 7,
      "text": "Bake, uncovered, until bubbly and golden around the edges, about 30 minutes. Remove from the oven and let stand for 10 minutes. Sprinkle with green onions and serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

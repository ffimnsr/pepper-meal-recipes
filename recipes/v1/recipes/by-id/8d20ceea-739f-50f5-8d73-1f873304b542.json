  "id": "8d20ceea-739f-50f5-8d73-1f873304b542",
  "slug": "strawberry-banana-blended-baked-oats-recipe-11699652",
  "name": "Strawberry Banana Blended Baked Oats",
  "recipe_type": "dessert",
  "brief_description": "These strawberry banana blended baked oats are easy to make, kid friendly and packed with healthy ingredients. Everything comes together in a blender and bakes up into a perfectly portioned, delicious treat that tastes just like having cake for breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine oats, banana, eggs, almond milk, honey, baking powder, vanilla, cinnamon, and salt in a high speed blender and blend until smooth. Remove the blade and fold in chopped strawberries."
    },
    {
      "position": 3,
      "text": "Divide batter evenly between 4 ramekins and sprinkle chocolate chips on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until baked oats are puffed and light golden brown, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Let cool for at least 5 minutes and serve warm or at room temperature."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

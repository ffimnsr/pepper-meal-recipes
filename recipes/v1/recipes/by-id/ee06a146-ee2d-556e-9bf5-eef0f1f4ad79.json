  "id": "ee06a146-ee2d-556e-9bf5-eef0f1f4ad79",
  "slug": "vegan-pumpkin-pie-blondies",
  "name": "Vegan Pumpkin Pie Blondies",
  "recipe_type": "dessert",
  "brief_description": "For an easy vegan pumpkin dessert, try these pumpkin pie blondies! Full of spices reminiscent of pumpkin pie, these vegan blondies always get rave reviews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9-inch square baking pan."
    },
    {
      "position": 3,
      "text": "Sift flour, white sugar, brown sugar, baking powder, baking soda, cinnamon, cloves, ginger, nutmeg, and salt together in a bowl. Add pumpkin puree, canola oil, and vanilla extract to the flour mixture and stir until a thick batter forms. Pour batter into the prepared baking pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and cool completely before cutting into 1 1/2-inch squares."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "efdb375f-c43e-5807-87a8-0035c0bfcd2e",
  "slug": "chef-johns-copycat-mcrib-sandwich",
  "name": "Chef John's Copycat McRib Sandwich",
  "recipe_type": "main",
  "brief_description": "Discover the joy of boneless baby back ribs with Chef John's clean-eating version of the McRib sandwich that's slow-baked and finished on the grill.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix salt, brown sugar, chili powder, pepper, cumin, and cayenne together for the rub."
    },
    {
      "position": 3,
      "text": "Place ribs on a foil-lined baking sheet. Season both sides generously with some of the rub. Reserve remaining rub for another use. Cover top with parchment paper and wrap foil over the edges. Cover the whole baking sheet with another large sheet of foil, sealing in the sides."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tender, about 2 hours and 45 minutes."
    },
    {
      "position": 5,
      "text": "Unwrap ribs and let cool briefly until safe to handle. Pull out the bones, stuffing any loose pieces of meat back into the holes and checking carefully for bone fragments. Wrap ribs back up and refrigerate until cold, 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "Cut each rack in half. Brush both sides generously with barbecue sauce."
    },
    {
      "position": 7,
      "text": "Preheat a charcoal grill for high heat and lightly oil the grate."
    },
    {
      "position": 8,
      "text": "Grill ribs until heated through, 3 to 4 minutes per side. Remove from grill and brush with more barbecue sauce."
    },
    {
      "position": 9,
      "text": "Drizzle more barbecue sauce onto each roll. Sandwich each rib section between a roll and top with coleslaw."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 170,
  "preparation_time_minutes": 10,

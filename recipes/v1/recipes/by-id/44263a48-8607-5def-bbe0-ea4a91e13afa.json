  "id": "44263a48-8607-5def-bbe0-ea4a91e13afa",
  "slug": "colleens-slow-cooker-jambalaya",
  "name": "Colleen's Slow Cooker Jambalaya",
  "recipe_type": "soup",
  "brief_description": "This slow cooker jambalaya is made by simmering shrimp, chicken, sausage, and rice in a spicy broth for an easy-to-prep, crowd-pleasing dinner.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix tomatoes with juice, chicken, sausage, onion, green bell pepper, celery, and broth in a slow cooker."
    },
    {
      "position": 3,
      "text": "Season with oregano, parsley, Cajun seasoning, cayenne pepper, and thyme."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 7 to 8 hours, or on High for 3 to 4 hours. Stir in shrimp during the last 30 minutes of cook time."
    },
    {
      "position": 5,
      "text": "Serve over rice."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 180,

  "slug": "red-bbq-slaw",
  "name": "Red BBQ Slaw",
  "recipe_type": "salad",
  "brief_description": "A tangy red bbq cabbage slaw recipe, made with ketchup for color and red pepper flakes for heat, makes a nice side for pulled pork or barbecued meats.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage in a salad bowl. Whisk vinegar, ketchup, sugar, pepper flakes, and hot sauce together until sugar has dissolved; pour over cabbage and toss thoroughly. Refrigerate before serving, at least 1 hour."
    }
  ],

  "id": "977e8a7b-7caf-5c14-875e-99e6b02e1157",
  "slug": "bauernomlett-farmers-omelet",
  "name": "Bauernomlett (Farmer's Omelet)",
  "recipe_type": "breakfast",
  "brief_description": "Eggs, bacon and potatoes all blend into one dish for a simple breakfast option. Serve it with ketchup for the kids or with a dill pickle for a German-style brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a saucepan covered by lightly salted water. Bring to a boil over high heat, then reduce heat to medium, and simmer until tender, 10 to 15 minutes. Drain and allow to cool, then cut into 1/4-inch slices."
    },
    {
      "position": 2,
      "text": "Melt the butter in a skillet over medium heat. Cook the bacon strips in the butter until browned, 5 to 7 minutes; remove bacon and set aside. Add the potatoes to the bacon fat and cook over medium-high heat until browned, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat the eggs with the salt and pepper. Pour the egg mixture into the skillet, and mix with the potatoes and bacon; allow to cook until eggs are set, 3 to 5 minutes, turning once."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

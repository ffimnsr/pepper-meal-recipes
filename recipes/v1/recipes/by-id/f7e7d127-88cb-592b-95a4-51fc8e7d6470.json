  "schema_version": 1,
  "id": "f7e7d127-88cb-592b-95a4-51fc8e7d6470",
  "slug": "stuffed-mushrooms-ii",
  "name": "Stuffed Mushrooms II",
  "recipe_type": "appetizer",
  "brief_description": "Fresh parsley and breadcrumbs set these seafood-stuffed mushrooms apart--butter and eggs add extra richness.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a cookie sheet."
    },
    {
      "position": 2,
      "text": "Clean mushrooms and remove stems. Chop enough stem to yield one cup. Use a pastry brush to brush the caps with vegetable oil."
    },
    {
      "position": 3,
      "text": "In a skillet, melt 2 tablespoons butter or margarine. Add chopped stems and onion to the hot butter. Saute the mixture for 4 minutes, remove it from the heat and let cool."
    },
    {
      "position": 4,
      "text": "In a large mixing bowl, combine the mushroom-onion mixture, crabmeat, cream cheese, egg, 1 cup bread crumbs, parsley, salt, and pepper. Spoon the mixture into the mushroom caps. Arrange the caps on the prepared cookie sheet."
    },
    {
      "position": 5,
      "text": "In a small skillet, melt the remaining butter and add the remaining bread crumbs to the melted butter. Once the bread crumbs are coated lightly sprinkle them over the mushroom caps."
    },
    {
      "position": 6,
      "text": "Bake for 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

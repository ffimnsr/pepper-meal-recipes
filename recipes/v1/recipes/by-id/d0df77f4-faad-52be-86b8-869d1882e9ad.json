  "id": "d0df77f4-faad-52be-86b8-869d1882e9ad",
  "slug": "birthday-cake-for-your-cat",
  "name": "Birthday Cake for Your Cat",
  "recipe_type": "dessert",
  "brief_description": "This cat birthday cake is purr-fect for those looking for a special treat for a favorite feline. Your kitty will love this easy tuna fish cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray 2 muffin tin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine tuna, flour, egg white, and Cheddar cheese in a bowl. Fill the prepared muffin cups equally with the mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Let cool in the tin for 5 minutes. Invert onto a wire rack to cool completely."
    },
    {
      "position": 4,
      "text": "Garnish cakes with shrimp."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

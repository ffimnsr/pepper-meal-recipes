  "id": "fb0806ca-91ab-5f00-84fb-53ec6f6a412f",
  "slug": "ultimate-refried-beans-with-cheese",
  "name": "Ultimate Refried Beans with Cheese",
  "recipe_type": "side",
  "brief_description": "Made with black beans and kidney beans and topped with cheese, these are the ultimate refried beans for your next party or potluck.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cover beans with 4 inches of water and soak for at least 12 hours, or overnight."
    },
    {
      "position": 2,
      "text": "Place the pot with beans and water on the stove and heat to a boil. Reduce heat to medium-low and simmer until much of the water has been absorbed and beans are soft enough to mash, about 2 hours."
    },
    {
      "position": 3,
      "text": "Crush the beans thoroughly with a potato masher. Simmer for 1 hour more."
    },
    {
      "position": 4,
      "text": "Take an immersion blender to the pot and pulverize the beans until there are no visible solids left. If any water remains, simmer until it evaporates and beans are reduced to a thick paste."
    },
    {
      "position": 5,
      "text": "Add milk, lard, garlic powder, salt, chile pepper, cumin, and cayenne and stir to combine. Cook for 10 minutes more."
    },
    {
      "position": 6,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 7,
      "text": "Transfer beans to a casserole dish and sprinkle with Oaxaca cheese. Cover with foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until cheese is melted, about 20 minutes, removing foil at the 15-minute mark. Serve immediately."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 215,
  "preparation_time_minutes": 20,

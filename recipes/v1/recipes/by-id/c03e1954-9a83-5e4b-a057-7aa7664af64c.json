  "id": "c03e1954-9a83-5e4b-a057-7aa7664af64c",
  "slug": "smothered-cajun-chicken-recipe-11781775",
  "name": "Smothered Cajun Chicken",
  "recipe_type": "main",
  "brief_description": "This smothered Cajun chicken is an easy slow cooker dinner. Chicken breasts cook with onion, bell pepper, and Cajun seasoning, and green beans are added in the last half hour. Serve over cooked rice.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken with 1 tablespoon Cajun seasoning; coat thoroughly and set aside."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Carefully add seasoned chicken to the skillet and sear just until all sides are browned, about 3 minutes. Remove and set aside."
    },
    {
      "position": 3,
      "text": "Deglaze the skillet with a few tablespoons water and reduce liquid by half. Add garlic, onion, and bell pepper to the skillet. Cook and stir until softened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer chicken and onion mixture to the slow cooker. Add in water, roasted chicken base and remaining 2 teaspoons Cajun seasoning."
    },
    {
      "position": 5,
      "text": "Cover and cook on Low for 3 hours. Add green beans and butter; cook on High for 30 minutes more. Season with salt and pepper. Garnish with fresh parsley and serve over rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 220,

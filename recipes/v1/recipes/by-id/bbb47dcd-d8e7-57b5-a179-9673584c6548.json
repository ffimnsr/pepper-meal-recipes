  "slug": "brown-spanish-rice",
  "name": "Brown Spanish Rice",
  "recipe_type": "side",
  "brief_description": "This easy brown Spanish rice recipe is what you'd expect from traditional Spanish rice, but it's loaded with extra fiber thanks to whole grain rice.",
  "cuisine": "Tex Mex Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring diced tomatoes, chicken broth, and salt to a boil in a medium saucepan. Add rice. Cover, reduce the heat to medium-low, and simmer until rice is cooked and liquid is absorbed, about 1 hour. Stir before serving."
    }
  ],

  "id": "d4c68a49-88cb-5cf3-bc70-18c23646a56b",
  "slug": "crabmeat-and-corn-soup",
  "name": "Crabmeat and Corn Soup",
  "recipe_type": "soup",
  "brief_description": "A rich chowder made with white kernel corn, fresh cracked crab meat, and green onions in a soup base of whole milk and half-and-half.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a heavy-bottomed pot; add flour and stir gently until blended, being careful not to let it brown. Gradually add milk, stirring constantly, then stir in half-and-half until smooth. Add corn and green onions; cook until tender, about a few minutes."
    },
    {
      "position": 2,
      "text": "Add crabmeat, pepper, salt, and soy sauce; simmer until heated through and small bubbles form around the edges\u2014do not let boil. Adjust seasonings to taste. Garnish with chopped fresh parsley and serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

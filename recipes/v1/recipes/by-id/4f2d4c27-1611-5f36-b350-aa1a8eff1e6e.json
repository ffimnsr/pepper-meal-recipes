  "id": "4f2d4c27-1611-5f36-b350-aa1a8eff1e6e",
  "slug": "spicy-turkey-sweet-potato-gumbo",
  "name": "Spicy Turkey Sweet Potato Gumbo",
  "recipe_type": "soup",
  "brief_description": "A hearty gumbo made with turkey thigh meat and turkey sausage has sweet potatoes and lots of vegetables and seasonings.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large pot over medium heat, and cook and stir the turkey thigh pieces until browned and no longer pink in the middle, about 10 minutes. Set the turkey aside. In the same pot, place the sausage, and break into chunks with a spatula. Cook and stir the sausage until browned and crumbly, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir the onion, celery, and green pepper into the pot. Continue to cook and stir until the onions are translucent, about 5 more minutes. Mix in the garlic and cook until fragrant, about 1 minute; then stir in the flour. Cook and stir the mixture until the flour forms a coating on the sausage and vegetables and begins to brown, 5 to 8 more minutes."
    },
    {
      "position": 3,
      "text": "Mix in the sweet potato, thyme, oregano, chicken broth, tomatoes, and bay leaf, and bring the gumbo to a boil. Reduce heat to medium-low, and simmer, stirring often, until thickened and the sweet potatoes are tender, about 15 minutes. Stir in the cooked turkey and hot sauce, and simmer until the turkey is heated through. Discard the bay leaf before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

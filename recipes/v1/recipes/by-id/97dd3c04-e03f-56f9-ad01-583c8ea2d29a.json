  "id": "97dd3c04-e03f-56f9-ad01-583c8ea2d29a",
  "slug": "beanie-weenie",
  "name": "Beanie Weenies",
  "recipe_type": "side",
  "brief_description": "Beanie Weenies is a classic dish of hot dogs and baked beans. This recipe flavors the beans with the perfect balance of seasonings for a weeknight winner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high. Add bacon, if using, and hot dogs (if not using bacon, add 1 tablespoon oil to skillet). Cook, stirring occasionally, until browned on both sides, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in baked beans, ketchup, Worcestershire, mustard, garlic powder, and onion powder until evenly combined."
    },
    {
      "position": 4,
      "text": "Bring to a boil over medium-high. Reduce heat to low and simmer until thickened, about 10 minutes, stirring occasionally. Stir in parsley. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

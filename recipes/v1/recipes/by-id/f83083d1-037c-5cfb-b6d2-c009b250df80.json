  "id": "f83083d1-037c-5cfb-b6d2-c009b250df80",
  "slug": "cabbage-jambalaya",
  "name": "Cabbage Jambalaya",
  "recipe_type": "soup",
  "brief_description": "An easy recipe that will have the kids eating cabbage like it's going out of style! Ground beef and sausage are simmered together with tomatoes, onion, celery, cabbage and rice.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground beef, smoked sausage, onion, celery, and garlic in a large stock pot over medium-high heat. Cook and stir until beef is evenly browned, about 5 minutes. Stir in cabbage, tomatoes, water, and rice. Season with garlic salt."
    },
    {
      "position": 2,
      "text": "Bring to a boil; reduce heat to low. Cover and cook, stirring once, until rice is tender, 35 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

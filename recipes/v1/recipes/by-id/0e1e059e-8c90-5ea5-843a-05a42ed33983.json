  "id": "0e1e059e-8c90-5ea5-843a-05a42ed33983",
  "slug": "yam-soup",
  "name": "Yam Soup",
  "recipe_type": "soup",
  "brief_description": "Make this yam soup with rice for a simple meal made from pantry staples that is comforting and packs a lot of flavor from curry, onion, and garlic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour chicken broth into a saucepan with curry powder, salt, pepper, onion powder, and garlic powder. Bring to a boil over medium heat."
    },
    {
      "position": 2,
      "text": "Add yams and onion and simmer for about 20 minutes."
    },
    {
      "position": 3,
      "text": "Add rice and cook until rice is tender, another 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 45,

  "id": "6f7c90e4-7eb3-5911-88fe-1b2109d381eb",
  "slug": "coffee-creamer-french-toast-recipe-8644003",
  "name": "Coffee Creamer French Toast",
  "recipe_type": "dessert",
  "brief_description": "This coffee creamer French toast is the classic breakfast recipe for French toast, but using cinnamon French toast flavor coffee creamer in place of milk brings just the perfect amount of sweet.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk egg, coffee creamer, brown sugar, cinnamon, vanilla, and salt together in a shallow dish until foamy and smooth; set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a large nonstick skillet over medium heat."
    },
    {
      "position": 3,
      "text": "Soak each slice of bread in egg mixture, 5 to 7 seconds per side. Place bread into the skillet, cook until golden brown on both sides, 3 to 4 minutes per side."
    },
    {
      "position": 4,
      "text": "Serve immediately. If desired, top with whipped cream, a dash of cinnamon, and caramel sauce."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

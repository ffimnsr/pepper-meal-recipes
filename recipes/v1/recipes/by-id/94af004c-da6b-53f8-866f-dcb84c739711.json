  "id": "94af004c-da6b-53f8-866f-dcb84c739711",
  "slug": "sausage-stuffed-mushrooms",
  "name": "Sausage-Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Crowd-pleasing sausage-stuffed mushroom appetizers start with buttery mushrooms filled with Italian sausage, mozzarella cheese, and Parmesan cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add mushrooms; cook and stir until softened, about 5 minutes. Transfer mushrooms to a plate; cool."
    },
    {
      "position": 3,
      "text": "Heat another skillet over medium-high heat. Add sausage, onion, and garlic; cook and stir until sausage is crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease. Transfer sausage mixture to a large bowl; stir in bread crumbs, Parmesan cheese, mozzarella cheese, Italian seasoning, and parsley."
    },
    {
      "position": 4,
      "text": "Arrange mushrooms, gill-sides-up, on the prepared baking sheet; spoon sausage mixture into caps."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheeses are melted, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

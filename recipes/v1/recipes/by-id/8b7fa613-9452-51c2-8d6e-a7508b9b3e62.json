  "schema_version": 1,
  "id": "8b7fa613-9452-51c2-8d6e-a7508b9b3e62",
  "slug": "apple-tarte-tatin",
  "name": "Tarte Tatin",
  "recipe_type": "dessert",
  "brief_description": "This tarte tatin from Chef John is a delicious French dessert made with sticky caramelized apples topped with flaky pastry baked upside-down.",
  "cuisine": "French Inspired French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Coat a heavy-bottomed 10-inch oven-proof skillet with butter. Sprinkle sugar evenly over the top of the butter."
    },
    {
      "position": 3,
      "text": "Place apple quarters, rounded sides down, on top of the butter and sugar in a circular pattern."
    },
    {
      "position": 4,
      "text": "Place skillet over medium-high heat and cook until butter melts and sugar dissolves and begins to caramelize. Continue to cook until apples soften and caramel begins to brown, 10 to 12 minutes. Remove from heat."
    },
    {
      "position": 5,
      "text": "Sprinkle work surface with flour and roll pie dough into an 11-inch circle. Pinch edge to create a ruffle around crust."
    },
    {
      "position": 6,
      "text": "Place crust on top of apples and tuck in edges around apples."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until crust is golden brown, about 20 minutes. Allow to cool for 5 minutes. Place a plate over the top of the pan and carefully invert to release tarte from the pan. Scrape any remaining apples stuck to the pan back on top of crust."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "07d05dd9-a815-5834-9e8a-9561dacb2ac5",
  "slug": "thai-chicken-balls",
  "name": "Thai Chicken Balls",
  "recipe_type": "appetizer",
  "brief_description": "These Thai chicken meatballs combine ground chicken, green onion, bread crumbs, coriander, chili sauce and lemon juice for a uniquely Thai flavor.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix together chicken and bread crumbs. Season with green onion, ground coriander, cilantro, chili sauce, and lemon juice; mix well."
    },
    {
      "position": 2,
      "text": "Using damp hands, form mixture into evenly shaped balls that are either small enough to eat with your fingers, or large enough to use as burgers."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Fry the chicken balls in batches until well browned all over."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

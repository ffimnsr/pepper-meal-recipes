{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2d0ed248-6b54-5c30-8eb6-1a83cb4c9a5f",
  "slug": "lions-head-meatballs",
  "name": "Lion's Head Meatballs",
  "recipe_type": "soup",
  "brief_description": "Flavorsome lion's head meatballs made with ground pork are simmered in a gingery-mushroom broth with napa cabbage for a classic Chinese soup.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Pour boiling water over shiitake mushrooms, and let sit until soft enough to slice, about 1 hour."
    },
    {
      "position": 2,
      "text": "Meanwhile, make the meatball mixture: Combine tofu and chestnuts in a large bowl. Add ground pork, green onions, garlic, and ginger. Pour in rice wine, soy sauce, brown sugar, egg, salt, and cayenne. Dust with cornstarch. Mix with a clean hand until thoroughly combined. Cover with plastic wrap and refrigerate for at least 1 hour."
    },
    {
      "position": 3,
      "text": "Form mixture into 6 large meatballs with wet hands."
    },
    {
      "position": 4,
      "text": "Set an oven rack about 8 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and oil lightly. Place meatballs on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Broil in the preheated oven until browned, 8 to 10 minutes. Remove from the oven and let cool while prepping the pot."
    },
    {
      "position": 6,
      "text": "For the cooking liquid: Trim off the bottom of the head of cabbage and slice 1/2 of the head. Arrange sliced cabbage on the bottom of a large soup pot or Dutch oven. Arrange remaining cabbage leaves on top. Slice and scatter mushrooms on top of cabbage; reserve shiitake liquid. Nestle meatballs into cabbage leaves and pour juices over."
    },
    {
      "position": 7,
      "text": "Strain reserved shiitake liquid into a bowl. Add chicken broth, soy sauce, sherry, sesame oil, brown sugar, cornstarch, and sesame oil. Whisk until dissolved. Add to the pot, pouring over each meatball. Bring to a boil over high heat."
    },
    {
      "position": 8,
      "text": "Reduce heat to medium-low, cover, and cook for 20 minutes. Uncover and increase heat to medium-high. Continue cooking, basting meatballs often, until liquid reduces slightly and meatballs are no longer pink in the center, about 10 minutes. Taste for seasoning."
    },
    {
      "position": 9,
      "text": "Ladle into serving bowls and arrange cabbage over meatballs. Top with green onions and chili oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,

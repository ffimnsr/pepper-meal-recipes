  "schema_version": 1,
  "id": "0036bba2-c7c4-5fab-b01a-e6d5675c35df",
  "slug": "seafood-chili",
  "name": "Seafood Chili",
  "recipe_type": "soup",
  "brief_description": "This unique chili recipe is a seafood lover's delight. Loaded with shrimp, crab, and scallops, it will take center-stage at any party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in large stockpot over medium-low heat; add tomatoes, bell peppers, garlic, and green onions. Cook and stir frequently until tomatoes have nearly liquefied, 30 minutes to 1 hour."
    },
    {
      "position": 2,
      "text": "Stir kidney beans, baby corn, and celery into the tomato mixture; add chili powder and lime juice and season with salt and ground black pepper. Cover and cook on low, stirring occasionally, until celery is soft but still has texture, about 1 hour."
    },
    {
      "position": 3,
      "text": "Stir crab meat and canned tomatoes with liquid into kidney bean mixture, breaking up tomatoes in thirds with a wooden spoon. Season with salt and pepper; add brown sugar if chili tastes too salty."
    },
    {
      "position": 4,
      "text": "Stir shrimp, scallops, and hearts of palm into chili; cook until shrimp are bright pink on the outside and the meat is opaque, 2 to 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "cb86ea97-f898-5bdd-a788-acd2b5090894",
  "slug": "chicken-cacciatore-with-rice",
  "name": "Chicken Cacciatore with Rice",
  "recipe_type": "main",
  "brief_description": "Quick and easy to make in just one pot, this chicken cacciatore recipe with rice features an aromatic mixture of vegetables and seasonings.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a pot over medium heat. Add chicken, onion, and garlic; cook until chicken is browned and onion and garlic are softened, 8 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in tomatoes, tomato sauce, bell pepper, salt, basil, and cayenne pepper; bring to boil. Cook for 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in rice, cover, and remove from the heat. Let stand until rice is tender, about 5 minutes. Stir before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "pickle-bacon-chopped-bagels-recipe-11719063",
  "name": "Pickle Bacon Chopped Bagels",
  "recipe_type": "main",
  "brief_description": "These pickle bacon chopped bagels are made with everything bagels, that are toasted and filled with a quick chopped cream cheese, bacon, and dill pickle spread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cream cheese onto a cutting board. Top cream cheese with pickles, brine, bacon, green onions, and dill. Chop all of the ingredients together and mix until well combined."
    },
    {
      "position": 2,
      "text": "Divide mixture onto the bottom halves of bagels; place top halves on. Cut in half and serve immediately."
    }
  ],
  "servings": 2,

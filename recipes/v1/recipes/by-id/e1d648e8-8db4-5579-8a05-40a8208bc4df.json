{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e1d648e8-8db4-5579-8a05-40a8208bc4df",
  "slug": "amazing-passover-chocolate-toffee-matzo",
  "name": "Amazing Passover Chocolate Toffee Matzo",
  "recipe_type": "dessert",
  "brief_description": "Crispy matzos with a buttery toffee coating get a topping of chocolate and a sprinkle of pecans in this traditional Passover dessert.",
  "cuisine": "Jewish American Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line baking sheets with aluminum foil; pinch edges into a lip to contain drips. Grease foil well with butter."
    },
    {
      "position": 2,
      "text": "Place matzos onto the prepared baking sheets, breaking in half if needed."
    },
    {
      "position": 3,
      "text": "Melt 1 cup butter with brown sugar in a saucepan over medium heat; bring to a boil, then reduce heat. Simmer until thickened, about 5 minutes. Ladle hot brown sugar mixture over matzos, spreading mixture with a rubber spatula to cover."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until sugar mixture is bubbling and thick, about 20 minutes. Cool until toffee coating is firm, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Place semisweet chocolate chips into a microwave-safe bowl. Microwave on low until just melted (do not let the chocolate overheat or scorch). Spread melted chocolate over toffee-coated matzos; sprinkle chopped pecans on top."
    },
    {
      "position": 6,
      "text": "Place baking sheets in the refrigerator until coated matzos are cold, about 30 minutes. Break matzos into pieces. Store in an airtight container or resealable plastic bags in the refrigerator or freezer."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4d3d41de-48f4-5eb1-91ff-ec46f108883a",
  "slug": "grandma-johnsons-scones",
  "name": "Grandma Johnson's Scones",
  "recipe_type": "dessert",
  "brief_description": "Using simple ingredients and only 30 minutes, this easy raisin scone recipe is a perfect sweet snack for the whole family.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, blend the sour cream and baking soda, and set aside."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a large baking sheet."
    },
    {
      "position": 3,
      "text": "In a large bowl, mix the flour, sugar, baking powder, cream of tartar, and salt. Cut in the butter. Stir the sour cream mixture and egg into the flour mixture until just moistened. Mix in the raisins."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a lightly floured surface, and knead briefly. Roll or pat dough into a 3/4 inch thick round. Cut into 12 wedges, and place them 2 inches apart on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake 12 to 15 minutes in the preheated oven, until golden brown on the bottom."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

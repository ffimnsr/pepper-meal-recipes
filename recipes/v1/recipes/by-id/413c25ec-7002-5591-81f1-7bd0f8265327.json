  "id": "413c25ec-7002-5591-81f1-7bd0f8265327",
  "slug": "chocolate-strawberry-baileys-pudding-shots",
  "name": "Chocolate-Strawberry-Baileys\u00ae Pudding Shots",
  "recipe_type": "dessert",
  "brief_description": "These creamy chocolate-strawberry pudding shots will disappear from your party table. Quick, easy, and ready in about 1 hour, they are perfect for St. Patrick's Day.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour chocolate pudding mix into a bowl. Add 1 cup milk and mix using a wire whisk until well combined. Stir in Irish cream liqueur. Fold in 4 ounces of whipped topping and mix well. Fill plastic shot cups halfway with chocolate mixture. Refrigerate for 30 minutes or until chocolate pudding is set."
    },
    {
      "position": 2,
      "text": "Pour strawberry pudding mix into a bowl. Add remaining 1 cup milk and mix using a wire whisk until well combined. Stir in strawberries and cream liqueur. Fold in remaining 4 ounces of whipped topping and mix well. Spoon strawberry pudding mixture over chocolate pudding in the shot glasses, filling nearly to the top."
    },
    {
      "position": 3,
      "text": "Refrigerate for 30 minutes or until pudding is set. Sprinkle set pudding shots with chocolate shavings."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

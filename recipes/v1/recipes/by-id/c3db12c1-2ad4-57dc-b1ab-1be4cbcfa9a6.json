  "id": "c3db12c1-2ad4-57dc-b1ab-1be4cbcfa9a6",
  "slug": "lemon-square-bars",
  "name": "Lemon Square Bars",
  "recipe_type": "dessert",
  "brief_description": "This lemon bars recipe makes a bright-flavored, zesty lemon filling layered on a homemade buttery crust for the ultimate sweet and tangy treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper, leaving an overhang for easy removal."
    },
    {
      "position": 2,
      "text": "Stir 2 \u00bc cups flour and confectioners\u2019 sugar together in a medium bowl; blend in cooled melted butter until dough is crumbly but holds together when pressed."
    },
    {
      "position": 3,
      "text": "Press mixture evenly into the prepared pan. Bake until golden and set, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, whisk eggs in a large bowl until pale and frothy. Combine white sugar, baking powder, \u00bc cup flour, and salt in a separate bowl; stir sugar mixture into eggs until smooth. Whisk in lemon juice and zest until combined."
    },
    {
      "position": 5,
      "text": "Pour filling over hot crust. Bake in the preheated oven until center is just set and no longer jiggly, about 20 minutes."
    },
    {
      "position": 6,
      "text": "Cool completely in the pan on a wire rack. Use parchment overhang to lift bars from pan before cutting into squares."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

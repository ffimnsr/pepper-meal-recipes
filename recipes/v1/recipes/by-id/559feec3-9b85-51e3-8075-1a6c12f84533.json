  "id": "559feec3-9b85-51e3-8075-1a6c12f84533",
  "slug": "blue-cheese-potato-salad",
  "name": "Blue Cheese Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This blue cheese potato salad recipe uses waxy red potatoes, tangy blue cheese, peppery green onions, and crunchy bacon bits for an unforgettable salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes. Drain, cool, and chop, leaving skins on. Set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, cook bacon in a large, deep skillet over medium-high heat until evenly browned. Drain, crumble, and set aside."
    },
    {
      "position": 3,
      "text": "Whisk green onions, oil, vinegar, black pepper, and salt together in a large bowl. Add potatoes, bacon, and cheese; toss to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "43c02c9b-bc01-5778-b94b-6f0c1d714582",
  "slug": "lamb-souvlaki",
  "name": "Lamb Souvlaki",
  "recipe_type": "main",
  "brief_description": "These lamb souvlaki skewers are made with tender chunks of lamb flavored with a lemon and oregano Greek marinade, grilled until juicy and charred.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, lemon juice, red wine vinegar, oregano, garlic, salt, and pepper together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Add cubed lamb and stir until lamb is coated with marinade. Cover and refrigerate 3 hours, or overnight."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Thread marinated lamb onto skewers, reserving any remaining marinade."
    },
    {
      "position": 5,
      "text": "Grill skewers until desired doneness, 10 to 12 minutes, basting with the reserved marinade and turning occasionally for even cooking."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

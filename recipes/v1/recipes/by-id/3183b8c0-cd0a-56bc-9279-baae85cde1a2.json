  "id": "3183b8c0-cd0a-56bc-9279-baae85cde1a2",
  "slug": "adult-cherry-vanilla-frozen-yogurt",
  "name": "Cherry Frozen Yogurt",
  "recipe_type": "dessert",
  "brief_description": "This cherry vanilla frozen yogurt combines cherries, cr\u00e8me de cassis, evaporated milk, and Greek yogurt to make this yummy frozen treat for adults.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pulse cherries in a food processor until coarse. Transfer to a large bowl. Add yogurt, evaporated milk, half-and-half, milk, sugar, and cr\u00e8me de cassis liqueur; mix well."
    },
    {
      "position": 2,
      "text": "Pour into an electric mixer's ice cream attachment. Follow manufacturer's instructions and mix for 25 minutes on the 'stir' setting. Alternatively, pour mixture into an ice cream maker and freeze according to manufacturer\u2019s instructions, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Transfer mixture to a freezer-proof container and freeze until it reaches \"soft-serve\" consistency, about 2 hours. Store with plastic wrap directly on the surface in a covered container."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

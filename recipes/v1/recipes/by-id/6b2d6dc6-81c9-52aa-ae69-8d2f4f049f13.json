  "id": "6b2d6dc6-81c9-52aa-ae69-8d2f4f049f13",
  "slug": "jewels-watermelon-margaritas",
  "name": "Watermelon Margarita",
  "recipe_type": "drink",
  "brief_description": "A watermelon margarita is a breeze to make with watermelon, tequila, and lime juice; serve frozen or on the rocks for a refreshing summer cocktail.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "To make a simple syrup: Bring 1/2 cup sugar, water, and orange zest in a small saucepan to boil, stirring constantly. Simmer until sugar is dissolved, about 3 minutes. Remove simple syrup from heat and allow to cool completely."
    },
    {
      "position": 2,
      "text": "Place watermelon in a blender or food processor; blend until pureed."
    },
    {
      "position": 3,
      "text": "Stir watermelon puree into a large pitcher with prepared simple syrup, tequila, and lime juice."
    },
    {
      "position": 4,
      "text": "Place a small amount of salt or sugar into a saucer. Rub edge of margarita glasses with a lime wedge to moisten. Lightly dip the rim of the glass into the saucer to rim the glass; tap off excess salt or sugar."
    },
    {
      "position": 5,
      "text": "Fill rimmed glasses with crushed ice; pour margarita mixture into glasses and garnish with lime wedges to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

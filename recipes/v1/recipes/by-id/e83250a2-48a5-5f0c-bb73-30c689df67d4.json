  "id": "e83250a2-48a5-5f0c-bb73-30c689df67d4",
  "slug": "cheesy-potato-soup-ii",
  "name": "Cheesy Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy, cheesy potato soup is made from scratch in one pot with cubed potatoes, broth, milk, and melty cheese for a comforting home-cooked meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Saut\u00e9 onions and celery in hot butter until tender, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in water and potatoes. Bring to a boil and simmer until potatoes are tender. Add cheese and stir until melted."
    },
    {
      "position": 3,
      "text": "Stir milk and flour together in a medium bowl until flour is mostly dissolved; pour slowly into soup, stirring constantly. Cook until soup is thickened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Portion soup into bowls and garnish with parsley to serve."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

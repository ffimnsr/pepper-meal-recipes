  "id": "f7ce3e7b-2283-5098-8994-691dd7263f11",
  "slug": "peanut-butter-cup-cookies",
  "name": "Peanut Butter Cup Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cute peanut butter cup cookies are easy to make in mini muffin pans for the most peanut buttery of treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Sift flour, salt, and baking soda together in a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Cream butter, sugar, peanut butter, and brown sugar together in a separate bowl until fluffy. Beat in egg, vanilla, and milk."
    },
    {
      "position": 3,
      "text": "Add flour mixture; mix well."
    },
    {
      "position": 4,
      "text": "Shape into 40 balls and place each into an ungreased mini muffin pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 8 minutes."
    },
    {
      "position": 6,
      "text": "Remove from oven and immediately press a mini peanut butter cup into each ball. Let cookies cool before carefully removing them from the pan."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

  "id": "0ba9aa7d-a9f0-50b8-9022-dacbe7a05678",
  "slug": "mushroom-ravioli-in-a-creamy-marsala-wine-sauce",
  "name": "Mushroom Ravioli in a Creamy Marsala Wine Sauce",
  "recipe_type": "main",
  "brief_description": "This mushroom ravioli topped with a Marsala cream sauce is simple to make and will have mushroom lovers asking for seconds!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add mushrooms and onion and saute until tender, 5 to 7 minutes. Add Marsala wine and garlic; bring to a boil. Boil for 5 to 6 minutes, adding salt and pepper to taste. Stir in cream and simmer until thickened and heated through, about 5 minutes."
    },
    {
      "position": 2,
      "text": "While the sauce is cooking, fill a large pot with about 4 quarts water. Set the burner to high and bring to a boil. Add ravioli to the boiling water. Cook until they float to the top of the water, 6 to 8 minutes, or according to package directions. Drain."
    },
    {
      "position": 3,
      "text": "Pour a generous amount of sauce over hot ravioli and top with fresh parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

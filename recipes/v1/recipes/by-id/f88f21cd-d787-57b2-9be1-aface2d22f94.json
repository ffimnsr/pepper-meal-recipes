  "schema_version": 1,
  "id": "f88f21cd-d787-57b2-9be1-aface2d22f94",
  "slug": "chicken-pot-pies-with-puff-pastry",
  "name": "Chicken Pot Pies with Puff Pastry",
  "recipe_type": "main",
  "brief_description": "This chicken pot pie recipe can be made with as many vegetables and seasonings as you'd like, and the only crust is the buttery puff pastry on top.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray 4 small ovenproof bowls with cooking spray."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Stir in 2 cups chicken broth and whisk in flour, gradually adding remaining 2 cups chicken broth until mixture is smooth and slightly thick. Mix in carrots, onion flakes, hot pepper sauce, black pepper, thyme, and bay leaf. Cook for about 5 minutes. Stir in chicken and potatoes; cook for 5 more minutes."
    },
    {
      "position": 3,
      "text": "Place a Swiss cheese slice into the bottom of each prepared bowl. Divide chicken mixture equally over cheese in the 4 bowls. Place a puff pastry square over the top of each bowl, pressing lightly around the rim."
    },
    {
      "position": 4,
      "text": "Mix together beaten egg and water in a small bowl until well combined. Brush over the top of each pastry. Place the bowls on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until pastry is puffed and golden brown, about 25 minutes. Let rest for at least 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

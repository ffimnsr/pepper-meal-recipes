  "id": "ef3b2f6d-536c-5a5e-a1b9-1070a9767dd6",
  "slug": "easy-french-dip-sandwiches",
  "name": "Easy French Dip Sandwiches",
  "recipe_type": "main",
  "brief_description": "This French dip sandwich is made in 15 minutes with thinly sliced roast beef soaked in flavorful au jus, served warm with melted provolone cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Open hoagie rolls and lay them out on a baking sheet."
    },
    {
      "position": 3,
      "text": "Heat beef consomm\u00e9 and water in a medium saucepan over medium-high heat to make a rich beef broth."
    },
    {
      "position": 4,
      "text": "Place roast beef in broth and warm for 3 minutes."
    },
    {
      "position": 5,
      "text": "Arrange meat on hoagie rolls and top each roll with 2 slices of provolone."
    },
    {
      "position": 6,
      "text": "Bake sandwiches in the preheated oven until cheese melts, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Serve sandwiches with small bowls of warm broth for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

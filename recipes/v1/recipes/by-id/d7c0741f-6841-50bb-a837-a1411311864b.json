  "id": "d7c0741f-6841-50bb-a837-a1411311864b",
  "slug": "ground-beef-teriyaki",
  "name": "Ground Beef Teriyaki",
  "recipe_type": "main",
  "brief_description": "This quick, easy, and delicious ground beef teriyaki with lots of vegetables is perfect for a filling lunch or dinner when served over rice, noodles, or zoodles.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground beef, carrots, and bell pepper in a large skillet over medium to medium-high heat; saute for 4 minutes. Sprinkle with salt and pepper. Add zucchini and continue to cook until ground beef is fully cooked through and vegetables are crisp-tender (to your preferred \"doneness\"), about 5 more minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine soy sauce, 1/3 cup plus 2 tablespoons water, sugar, brown sugar, vinegar, cornstarch, onion powder, ginger, and garlic powder in a small bowl for the sauce. Whisk until well blended."
    },
    {
      "position": 3,
      "text": "When the meat and veggies are cooked, whisk sauce once more and pour into the skillet. Use a spatula to mix and get everything off the sides and bottom."
    },
    {
      "position": 4,
      "text": "Turn the heat up until sauce begins to bubble, stirring occasionally until mixture becomes thickened and glossy. Turn heat off. Taste and adjust seasonings."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b47b8441-e193-55e7-b877-642ca88ab1f6",
  "slug": "foolproof-potato-latkes",
  "name": "Foolproof Potato Latkes",
  "recipe_type": "dessert",
  "brief_description": "Use a food processor to combine ingredients for these crispy latkes.",
  "cuisine": "Israeli",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1/4 of the potatoes, onion, eggs, salt, flour, and baking powder in the bowl of a food processor; pulse several times until the vegetables are finely chopped. Add remaining potatoes and pulse again until all potatoes are finely chopped and mixture is thoroughly combined."
    },
    {
      "position": 2,
      "text": "Heat canola oil in a skillet over medium heat. Scoop up about 1/3 cup of potato mixture at a time and place in skillet. Fry latkes until brown and crisp on the bottom, 2 to 3 minutes. Flip and cook other sides until brown, 2 to 3 minutes longer."
    },
    {
      "position": 3,
      "text": "Repeat with remaining potato mixture, replenishing oil as needed. Serve hot."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4d858500-f476-5d2a-b7fe-f9c7faa8411d",
  "slug": "easy-egg-tacos",
  "name": "Easy Egg Tacos",
  "recipe_type": "breakfast",
  "brief_description": "Serve these fun and easy egg tacos with your favorite toppings for the full taco treatment that kids love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a medium nonstick skillet over medium heat. Saut\u00e9 red bell pepper, jalape\u00f1o pepper, and garlic until softened, about 2 minutes. Add ham and chili powder; saut\u00e9 until heated through, about 2 minutes. Remove ham mixture to a bowl; cover to keep warm."
    },
    {
      "position": 2,
      "text": "Whisk eggs, salt, and pepper in a small bowl or measuring cup."
    },
    {
      "position": 3,
      "text": "Melt butter in the same skillet over medium heat; add eggs and cook, stirring gently, until set but still soft, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Spoon eggs onto each tortilla. Top with ham mixture, cheese, and onion. Serve with salsa and coriander."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

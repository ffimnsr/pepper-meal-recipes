  "id": "2c38594f-473a-579f-a494-2ecb7fa5016d",
  "slug": "the-italian-irishmans-pie",
  "name": "The Italian Irishman's Pie",
  "recipe_type": "main",
  "brief_description": "Shepherd's Pie topped with mashed potatoes starts out Irish and gets some Italian flavor twists for a fun main dish.",
  "cuisine": "Italian Inspired Italian Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Grease a 2-quart casserole dish."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium heat; cook and stir Italian sausage until browned and crumbly, about 10 minutes. Use a slotted spoon to transfer sausage to prepared casserole dish. Drain drippings and reserve 2 tablespoons drippings in the skillet."
    },
    {
      "position": 4,
      "text": "Melt 2 tablespoons margarine in a separate skillet over medium heat; cook and stir apple and onion slices until tender, about 8 minutes. Place apple and onion in casserole dish with sausage."
    },
    {
      "position": 5,
      "text": "Lightly stir sausage, apple, and onion together; season with salt, black pepper, and oregano."
    },
    {
      "position": 6,
      "text": "Brown flour in reserved drippings in skillet over medium heat. Whisk water into flour until thick gravy forms, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Pour gravy over sausage mixture in the casserole dish; spread mashed potatoes over the top with a spoon, creating peaks. Lightly brush mashed potatoes with 1 tablespoon melted margarine."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until the potatoes are lightly browned and the sausage mixture is bubbling, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "cabadcf1-e6ab-5631-8c51-223b5b0cbd14",
  "slug": "homemade-chicken-cacciatore-sicilian-style",
  "name": "Homemade Chicken Cacciatore, Sicilian-Style",
  "recipe_type": "main",
  "brief_description": "This homemade chicken cacciatore, Sicilian-style recipe is made with tomatoes, onions, bell peppers, wine, seasonings, and a whole cut-up chicken.",
  "cuisine": "Sicilian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large stockpot over medium heat. Add onion, bell pepper, and garlic; cook until begins to soften, about 3 minutes. Add tomatoes, wine, Italian seasoning, salt, black pepper, and garlic salt; cook and stir until mixture just begins to boil."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low; add chicken and cook until meat is fall-off-the-bone tender, about 1 \u00bd hours. Remove bones and skin from chicken; return meat to the pot."
    },
    {
      "position": 3,
      "text": "Place \u00be cup reserved canned tomato liquid in a microwave-safe bowl; microwave until just warmed. Stir in flour until thick; stir into the pot, stirring continuously, until begins to thicken. Remove from heat; set aside for about 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet still firm to the bite, about 12 minutes. Drain. Serve chicken cacciatore over spaghetti."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 115,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

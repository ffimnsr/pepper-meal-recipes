  "id": "0fb1f653-c0bc-57c2-b207-c589a1824085",
  "slug": "shorecooks-potato-salad-with-mayonnaise-dressing",
  "name": "Shorecook\u2019s Potato Salad with Mayonnaise Dressing",
  "recipe_type": "salad",
  "brief_description": "The fantastic flavor of this creamy Yukon Gold potato salad is created by peeling the potatoes and mixing in the rest of the ingredients while the potatoes are still warm.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with water; add salt and bring to a boil. Reduce heat to medium-low and simmer until potatoes are tender when pierced with a fork, about 30 minutes. Drain and set aside until cool enough to touch, but still warm."
    },
    {
      "position": 2,
      "text": "Peel potatoes and cut into chunks. Place in a bowl and add eggs and onion. Mix in mayonnaise, celery salt, and pepper until well combined. Refrigerate until flavors have melded, about 1 hour. Serve chilled."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

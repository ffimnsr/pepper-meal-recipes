  "id": "8644bb10-5657-518b-b690-41791d88315e",
  "slug": "chocolate-and-orange-tiramisu",
  "name": "Chocolate and Orange Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This chocolate and orange tiramisu recipe is a tweak on the Italian favorite with orange-soaked ladyfingers, creamy mascarpone, and a dusting of cocoa.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Beat mascarpone and 2 tablespoons orange-flavored liqueur together in a large bowl until smooth. Set aside."
    },
    {
      "position": 2,
      "text": "Beat cream, sugar, and vanilla extract together in a separate bowl using an electric mixer until soft peaks form. Fold about \u00bc whipped cream into mascarpone mixture using a large rubber spatula until smooth; fold in remaining \u00be whipped cream until smooth and well combined. Set aside."
    },
    {
      "position": 3,
      "text": "Combine orange juice and remaining 2 tablespoons orange-flavored liqueur in a shallow bowl. Separate ladyfingers; quickly dip ladyfingers in orange juice mixture, 2 to 3 at a time, just long enough to absorb a small amount of liquid. Arrange soaked ladyfingers in a 9x13-inch baking dish until bottom of dish is covered in a single layer."
    },
    {
      "position": 4,
      "text": "Spread about \u00bd mascarpone mixture over ladyfingers layer; sprinkle about \u00bd cocoa powder over mascarpone layer. Soak and layer in remaining ladyfingers, followed by remaining \u00bd mascarpone mixture, and remaining \u00bd cocoa powder."
    },
    {
      "position": 5,
      "text": "Cover the baking dish with plastic wrap; refrigerate until set, 5 hours to overnight."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

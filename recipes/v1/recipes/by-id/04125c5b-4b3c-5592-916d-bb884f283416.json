  "schema_version": 1,
  "id": "04125c5b-4b3c-5592-916d-bb884f283416",
  "slug": "french-fries-in-the-air-fryer",
  "name": "French Fries in the Air Fryer",
  "recipe_type": "snack",
  "brief_description": "Make French fries in the air fryer in under 30 minutes, then sit back and start snacking on deliciously crispy spud sticks made with almost no oil!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 380 degrees F (190 degrees C). Spray the basket with nonstick spray."
    },
    {
      "position": 2,
      "text": "Cut potato in half lengthwise, then into 1/4-inch slices. Cut slices into 1/4-inch sticks. Put fries into a bowl and rinse well under cold running water. Drain and pat dry with paper towels."
    },
    {
      "position": 3,
      "text": "Transfer dried fries to a bowl. Add oil and toss until well combined. Sprinkle with salt and season with pepper; toss to combine. Working in batches if necessary, place fries into the prepared basket; spread in an even layer and don't overlap."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 7 minutes. Turn fries and cook until golden brown and crisp, 7 to 9 more minutes. Remove from the air fryer and sprinkle with more salt to taste."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

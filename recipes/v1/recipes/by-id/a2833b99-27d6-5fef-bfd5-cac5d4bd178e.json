  "id": "a2833b99-27d6-5fef-bfd5-cac5d4bd178e",
  "slug": "one-pot-chicken-marsala-orzo-recipe-11927120",
  "name": "One Pot Chicken Marsala Orzo",
  "recipe_type": "main",
  "brief_description": "This chicken Marsala orzo is a dish you'll want to serve on repeat. It's not at all difficult, and so flavorful. Bite-sized chicken chunks are sauteed, then combined with orzo and mushrooms cooked in Marsala wine, all in one pot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken with salt, pepper, and paprika. Add olive oil to a deep skillet or Dutch oven over medium-high heat. Add chicken; cook and stir until no longer pink at the center, about 5 minutes. Remove chicken from the skillet to a plate; set aside."
    },
    {
      "position": 2,
      "text": "Heat 1 1/2 tablespoons butter over medium-high heat in the same skillet. Add mushrooms and onions; cook and stir until softened, about 5 minutes. Stir in garlic paste."
    },
    {
      "position": 3,
      "text": "Add orzo and cook, stirring frequently, until orzo is lightly toasted. Pour in half the Marsala; cook and stir, until wine is nearly absorbed."
    },
    {
      "position": 4,
      "text": "Add beef stock and bring to a boil. Reduce heat, then simmer until pasta is cooked and tender, about 10 minutes. Taste; season with salt and pepper as needed."
    },
    {
      "position": 5,
      "text": "Add chicken, remaining Marsala, and remaining butter. Cook until chicken is heated through and liquid is mostly absorbed. Serve in wide bowls; garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "700e6d6d-8e8e-58bb-b1b3-e211d56729be",
  "slug": "walking-taco-sliders-recipe-11995140",
  "name": "Walking Taco Sliders",
  "recipe_type": "main",
  "brief_description": "These walking taco sliders are a fun twist on Taco Tuesday, made with seasoned taco meat and soft Hawaiian rolls for an easy handheld meal. Pile them high with sour cream, crunchy Doritos, lettuce, and fire-roasted tomatoes, or any other toppings your family loves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef in a large nonstick skillet over medium-high heat, breaking beef up with a spatula, until beef is browned and crumbly, about 7 minutes; drain excess grease. Add taco seasoning and mix well."
    },
    {
      "position": 3,
      "text": "Slice the package of rolls apart horizontally, without separating into individual rolls. Place the sheet of roll bottoms on a baking sheet; set the top sheet of rolls aside. Add 6 slices of pepper Jack cheese on the bottom buns. Top cheese with ground beef. Add 6 more slices of pepper Jack cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Add all the toppings you like. I suggest sour cream, fire-roasted tomatoes, sliced lettuce, and crushed spicy Doritos. You can spice it up by adding sliced jalape\u00f1os. Top with the reserved sheet of roll tops, cut into individual sliders, and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "00132374-1b90-5043-9cec-fd95d761d69d",
  "slug": "air-fryer-buffalo-chicken-wings-from-frozen",
  "name": "Air Fryer Buffalo Chicken Wings from Frozen",
  "recipe_type": "appetizer",
  "brief_description": "Use your air fryer to cook chicken wings from frozen. All you need are frozen wings and Buffalo wing sauce, no thawing required.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place wings in the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook wings for 15 minutes, turn, and cook for 15 more minutes. Meanwhile, place wing sauce in a small saucepan and heat on low heat."
    },
    {
      "position": 4,
      "text": "Flip wings one more time and cook until crispy, about 6 more minutes."
    },
    {
      "position": 5,
      "text": "Transfer wings to a large bowl and pour warmed Buffalo wing sauce over the top. Toss and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

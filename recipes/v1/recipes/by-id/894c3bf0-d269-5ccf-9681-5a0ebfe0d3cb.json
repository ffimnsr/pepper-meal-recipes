  "slug": "chocolate-banana-tofu-pudding",
  "name": "Chocolate-Banana Tofu Pudding",
  "recipe_type": "dessert",
  "brief_description": "This delightful, guilt-free tofu pudding recipe can be made in 5 minutes. It\u2019s a dessert for everyone, vegans and chocolate lovers alike. The banana and chocolate mask the tofu.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place banana, tofu, sugar, cocoa powder, soy milk, and cinnamon into a blender. Cover, and puree until smooth."
    },
    {
      "position": 2,
      "text": "Pour into individual serving dishes, and refrigerate for 1 hour before serving."
    }
  ],
  "servings": 4,

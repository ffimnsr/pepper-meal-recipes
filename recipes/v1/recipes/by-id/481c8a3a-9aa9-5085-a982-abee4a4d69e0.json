  "id": "481c8a3a-9aa9-5085-a982-abee4a4d69e0",
  "slug": "blt-pasta-salad",
  "name": "BLT Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This BLT pasta salad with crispy bacon, lettuce, tomato, and pasta shells tossed in creamy salad dressing is perfect for summer potlucks and parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil; add pasta, and cook until tender, about 8 minutes. Drain, and rinse under cold water to cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook bacon in a large deep skillet over medium-high heat until browned and crisp."
    },
    {
      "position": 4,
      "text": "Remove from the pan and drain on paper towels; crumble and set aside."
    },
    {
      "position": 5,
      "text": "Combine cooked pasta, 3/4 of the bacon, tomatoes, onion, ranch dressing, and pepper in a large bowl; toss to coat."
    },
    {
      "position": 6,
      "text": "Mix in lettuce. Top with remaining bacon."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,

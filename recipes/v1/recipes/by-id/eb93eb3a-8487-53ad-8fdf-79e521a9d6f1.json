  "id": "eb93eb3a-8487-53ad-8fdf-79e521a9d6f1",
  "slug": "spicy-jalapeno-hummus",
  "name": "Spicy Jalapeno Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Homemade spicy hummus, made with jalapeno peppers, is a flavorful twist on traditional hummus and tastes better than store-bought versions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend garbanzo beans, jalapeno peppers, juice from jalapeno peppers, lemon juice, olive oil, tahini, and garlic in a blender or food processor until smooth; add reserved garbanzo bean liquid and blend to reach desired consistency. Add cayenne pepper, cumin, oregano, black pepper, and paprika; blend until smooth."
    },
    {
      "position": 2,
      "text": "Chill hummus until flavors blend, about 4 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

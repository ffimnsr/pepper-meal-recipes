  "id": "64818eea-891c-54bb-a0b3-4764871786c4",
  "slug": "hot-dog-pinecones-recipe-11755512",
  "name": "Hot Dog Pinecones",
  "recipe_type": "appetizer",
  "brief_description": "These hot dog pinecones are spicy charred hot dog bites topped with BBQ sauce\u2014perfect for your next gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Score hot dogs in a cross-stitch pattern and place on the prepared baking sheet. Cover with mustard, Creole seasoning, and black pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the crust has set and hot dogs are opening up, 20 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove from oven and cut hot dogs into thirds. Transfer to a large ovenproof skillet set over medium-high heat and cover with BBQ sauce. Heat until sauce is warmed through, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Increase oven temperature to 350 degrees F (175 degrees C). Place skillet with hot dogs back into the oven and bake until charred, 20 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove and allow to cool for 10 minutes before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

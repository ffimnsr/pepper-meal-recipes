  "id": "de0beb9b-0d53-5380-9125-519426aee6c0",
  "slug": "chicken-tinola",
  "name": "Chicken Tinola",
  "recipe_type": "soup",
  "brief_description": "Tinola, an easy Filipino soup made with chicken, bok choy, and spinach, features a savory broth flavored with fresh ginger and fish sauce.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium heat. Add onion and garlic; cook and stir until fragrant, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Add ginger and fish sauce; cook and stir for 1 to 2 minutes. Stir in chicken and cook for 5 minutes."
    },
    {
      "position": 4,
      "text": "Pour in chicken broth and cook for 5 minutes. Add squash and simmer until chicken is no longer pink in the center, about 10 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Add bok choy and spinach; cook until spinach is just wilted, 1 to 2 minutes. Serve hot."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

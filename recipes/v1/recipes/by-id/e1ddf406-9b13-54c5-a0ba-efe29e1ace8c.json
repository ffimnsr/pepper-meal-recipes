  "id": "e1ddf406-9b13-54c5-a0ba-efe29e1ace8c",
  "slug": "schlotskys-bread",
  "name": "Schlotsky\u2019s Bread",
  "recipe_type": "main",
  "brief_description": "This is a light white bread with more liquid than most, but don \u2018t worry because the tender loaf turns out just fine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl stir together the warm water, sugar, and yeast. Stir to dissolve and set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl dissolve baking soda with the 1 1/2 teaspoons warm water. Add the warm milk, salt, and one cup of the flour. Beat with a wire whisk until smooth. Beat in yeast mixture and remaining flour. Batter should be thick, sticky, and smooth."
    },
    {
      "position": 3,
      "text": "Prepare 2 pie pans with non-stick spray. Dust pans with cornmeal. Place 1/2 dough in each pie pan. Batter will spread during rising time. Spray top of dough with non-stick cooking spray. Cover and let rise for one hour."
    },
    {
      "position": 4,
      "text": "Repeat spraying of bread with non-stick cooking spray. Bake in a preheated 375 degree F (190 degrees C) for 20 minutes."
    },
    {
      "position": 5,
      "text": "Allow to cool for an hour before slicing."
    }
  ],
  "servings": 12,

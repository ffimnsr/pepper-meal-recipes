  "schema_version": 1,
  "id": "f873f4db-e3d6-5a35-a7d9-eda25b8f0771",
  "slug": "ribollita-tuscan-bread-soup-recipe-11782482",
  "name": "Ribollita (Tuscan Bread Soup)",
  "recipe_type": "soup",
  "brief_description": "Ribollita, or Tuscan bread soup, might be so thick and hearty that it's hardly a soup any more. With toasted Italian bread simmered in a tomato and cannellini bean base, this is the epitome of rustic Italian comfort food.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Crush garlic and salt together in a mortar or small bowl, and stir in olive oil. Set aside."
    },
    {
      "position": 3,
      "text": "Tear bread into about 2-inch pieces, and spread out on a baking sheet. Drizzle over the garlic oil, and toss to combine."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bread is dried out and getting crisp on the edges, 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Transfer 1 can beans into a mixing bowl, and mash with a potato masher until almost smooth. Add canned tomatoes, and use the masher to break into very small pieces. Set aside."
    },
    {
      "position": 6,
      "text": "Add 2 tablespoons olive oil to a soup pot set over medium-high heat. Saut\u00e9 onions, carrots, and celery with a big pinch of salt until onions start to turn translucent, about 4 minutes. Add garlic, oregano, thyme, rosemary, and bay leaf, and cook, stirring, for another minute."
    },
    {
      "position": 7,
      "text": "Add chicken broth. Use about 1/2 cup water to rinse out the tomato can and add to the soup. Bring to simmer over high heat, then reduce to medium-low, and simmer for about 10 minutes."
    },
    {
      "position": 8,
      "text": "Raise the heat back to high; when the soup is boiling, stir in kale and cook for about 5 minutes, stirring occasionally."
    },
    {
      "position": 9,
      "text": "Add in parsley, remaining can of beans, crushed bean and tomato mixture, black pepper, and cayenne. Rinse the tomato bowl with about 1 cup water, and add that to the soup. Transfer in half the bread, and 1/4 cup Parmesan cheese. Stir everything to combine. When mixture comes back to a simmer, reduce heat to medium, and simmer until greens are very tender, stirring occasionally, about 15 minutes."
    },
    {
      "position": 10,
      "text": "Taste for seasoning and add more salt if needed."
    },
    {
      "position": 11,
      "text": "Turn off heat, and add half of the remaining bread to the top. Use a spoon or spatula to poke some bread into the surface."
    },
    {
      "position": 12,
      "text": "Ladle soup into serving bowls; top with the extra toasted bread, a generous grating of Parmesan cheese, red chili flakes, freshly chopped parsley, and a drizzle of olive oil. Fresh lemon juice can also be squeezed over."
    }
  ],
  "servings": 6,

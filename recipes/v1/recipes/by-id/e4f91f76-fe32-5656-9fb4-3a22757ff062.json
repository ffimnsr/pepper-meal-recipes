  "id": "e4f91f76-fe32-5656-9fb4-3a22757ff062",
  "slug": "copycat-little-debbie-oatmeal-creme-pies-recipe-8373904",
  "name": "Copycat Little Debbie Oatmeal Creme Pies",
  "recipe_type": "dessert",
  "brief_description": "Get ready to recreate the childhood delight of Little Debbie Oatmeal Creme Pies with this easy recipe. Swapping the thin cakes for soft oatmeal cookies, our copycat version is chewier, heartier, and even more irresistible than the pre-packaged snack cakes. Ready in under 30 minutes, these homemade treats are giving Little Debbie's classic a run for its money.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the oatmeal cookies: Beat butter and sugars together in a large bowl with an electric mixer on medium speed until combined. Beat in eggs, one at a time, until incorporated; stir in vanilla."
    },
    {
      "position": 3,
      "text": "Stir flour, baking soda, and salt together in a bowl; gradually add to the butter mixture, stirring until combined. Stir in oats until incorporated."
    },
    {
      "position": 4,
      "text": "Roll dough into walnut-sized balls and place on parchment-lined baking sheets. Bake in the preheated oven until lightly browned, 8 to 9 minutes. Let cool on baking sheets for 5 minutes before transferring to a wire rack to cool completely."
    },
    {
      "position": 5,
      "text": "To make the cr\u00e8me filling: Beat butter and shortening on medium-high speed, until pale and fluffy, about 3 minutes. Add powdered sugar, and beat on low speed until combined. Beat in marshmallow cr\u00e8me until smooth."
    },
    {
      "position": 6,
      "text": "Pipe or spread desired amount of cr\u00e8me onto half of cooled cookies, and top with remaining half of cookies."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

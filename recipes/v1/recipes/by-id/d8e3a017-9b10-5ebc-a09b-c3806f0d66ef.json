  "id": "d8e3a017-9b10-5ebc-a09b-c3806f0d66ef",
  "slug": "pumpkin-tahini-pie",
  "name": "Pumpkin Tahini Pie",
  "recipe_type": "soup",
  "brief_description": "The inspiration for this pumpkin pie with tahini came from a very unlikely source: soup!",
  "cuisine": "American Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place prepared pie crust onto a baking sheet."
    },
    {
      "position": 3,
      "text": "In a bowl, whisk together pumpkin, sweetened condensed milk, eggs, pumpkin pie spice, tahini, heavy cream, vanilla, and salt until smooth and combined. Pour into prepared pie crust."
    },
    {
      "position": 4,
      "text": "Place pan into oven and bake for 15 minutes. Reduce oven temp to 350 degrees F (175 degrees C) and continue baking until pie is set but the middle is still slightly jiggly, 30 to 35 minutes. Remove from the oven and allow pie to cool completely, at least 4 hours."
    },
    {
      "position": 5,
      "text": "If desired, garnish with toasted sesame seeds before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "801ea181-8205-58dc-b967-25699b107dc4",
  "slug": "marinated-peppers",
  "name": "Marinated Peppers",
  "recipe_type": "side",
  "brief_description": "Red, green, and yellow peppers marinated in a mixture of herbs and oils. Serve with toasted Italian or French bread slices.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (200 degrees C). Place the whole red, green and yellow peppers in the oven directly on the rack. Roast for about 15 minutes, turning if needed, until the skin is well scorched. Immediately place in a bowl covered with plastic wrap or in a paper bag, and allow to cool."
    },
    {
      "position": 2,
      "text": "Remove the skins from the peppers by rubbing with your hands, and rinse under cold water. Cut in half, remove stem and seeds, then cut into strips."
    },
    {
      "position": 3,
      "text": "Place peppers into a medium serving bowl, and stir in the garlic, vinegar, oil, basil, parsley, salt and pepper."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

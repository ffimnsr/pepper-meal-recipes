  "slug": "slow-cooker-cheesy-hash-brown-potatoes",
  "name": "Slow Cooker Cheesy Hash Brown Potatoes",
  "recipe_type": "breakfast",
  "brief_description": "This cheesy crockpot hash brown casserole is an easy, tasty recipe that's great for potlucks and game-day parties \u2014 made right in a slow cooker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place frozen hash browns in a slow cooker. Pour melted butter over hash browns. Pour in condensed soup and sour cream, stirring between each addition. Add Cheddar cheese."
    },
    {
      "position": 2,
      "text": "Cook on Low for 4 to 5 hours. Stir mixture after 2 hours of cooking."
    }
  ],
  "servings": 10,

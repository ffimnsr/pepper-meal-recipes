  "id": "488559ab-6a11-5390-bcc1-90f25cb8b833",
  "slug": "strawberry-acai-lemonade",
  "name": "Strawberry Acai Lemonade",
  "recipe_type": "drink",
  "brief_description": "Fresh strawberries and acai powder add color and flavor to classic homemade lemonade.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries, lemon juice, acai powder, and 1 cup water in a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour into a pitcher and add remaining 2 cups water and 1 tablespoon sweetener. Add more sweetener according to sweetness desired. Serve over ice."
    }
  ],
  "servings": 2,

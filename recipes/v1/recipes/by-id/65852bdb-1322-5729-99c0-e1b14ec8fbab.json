  "id": "65852bdb-1322-5729-99c0-e1b14ec8fbab",
  "slug": "chanterelle-mushroom-soup",
  "name": "Chanterelle Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "Chanterelles have a lovely mellow flavor and a beautiful light-orange color. If you can't get your hands on chanterelles, any other wild mushroom or store-bought chestnut mushrooms will do.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter and oil in a heavy-bottomed pot over low heat. Add onion and garlic, cover, and cook until soft, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Increase heat to medium and stir in chanterelle mushrooms. Sprinkle with flour and pour in boiling water, stirring constantly. Season with chicken bouillon, bay leaves, thyme, white pepper, and nutmeg and bring to a simmer. Cover and simmer until mushrooms are soft and flavors are well combined, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Remove bay leaves. Puree chanterelle soup with an immersion blender until smooth."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

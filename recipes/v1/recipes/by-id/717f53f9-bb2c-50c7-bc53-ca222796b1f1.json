  "id": "717f53f9-bb2c-50c7-bc53-ca222796b1f1",
  "slug": "jewish-apple-cake-i",
  "name": "Jewish Apple Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist Jewish apple cake is loaded with freshly sliced apples and cinnamon. It's a must for Rosh Hashanah but just as delicious any time!",
  "cuisine": "World American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "To make the cinnamon-sugar: Combine sugar and cinnamon in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "To make the cake: Combine flour, sugar, baking powder, and salt in a large mixing bowl. Stir in oil, eggs, orange juice, and vanilla until well combined."
    },
    {
      "position": 4,
      "text": "Pour 1/2 of the batter into the prepared pan, then top with 1/2 of the sliced apples and sprinkle with 1/2 of the cinnamon-sugar. Repeat once more with remaining batter, apples, and cinnamon-sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 70 to 90 minutes. Cool briefly in the pan; run a table knife around the edges to loosen. Invert carefully onto a serving plate or rack and let cool completely."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,

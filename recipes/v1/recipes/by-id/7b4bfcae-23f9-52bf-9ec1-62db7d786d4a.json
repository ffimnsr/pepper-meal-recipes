  "id": "7b4bfcae-23f9-52bf-9ec1-62db7d786d4a",
  "slug": "holiday-sangria",
  "name": "Holiday Sangria",
  "recipe_type": "drink",
  "brief_description": "A clove pomander adds a festive touch to this red wine sangria made with brandy, orange liqueur, and fresh citrus.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour Rioja into a large pitcher. Add brandy and orange liqueur. Cut orange, grapefruit, and lemon into wedges. Squeeze juice into the pitcher. Toss in fruit with rinds. Refrigerate until flavors combine, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Add pomander to the sangria several hours before serving."
    },
    {
      "position": 3,
      "text": "Strain liquid into chilled glasses of ice. Top with a splash of seltzer. Garnish with lime slices."
    }
  ],
  "servings": 6,

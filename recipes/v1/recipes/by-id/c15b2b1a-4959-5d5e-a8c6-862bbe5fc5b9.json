  "id": "c15b2b1a-4959-5d5e-a8c6-862bbe5fc5b9",
  "slug": "loaded-chili-dog-bake-recipe-11739275",
  "name": "Loaded Chili Dog Bake",
  "recipe_type": "main",
  "brief_description": "This loaded chili dog bake is a fun way to eat chili dogs. They're made by adding hot dogs into Hawaiian rolls, then are loaded with chili, nacho cheese sauce, and melted Cheddar, and baked until bubbly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spread butter along bottom and sides of a 9x13-inch casserole dish. Place rolls in dish and cut a slit into each roll, taking care not to cut all the way through."
    },
    {
      "position": 2,
      "text": "Place a hot dog half in the slit of each roll. Drizzle a thin layer of mustard over the top. Top evenly with chili and cheese sauce. Top with 1/2 cup shredded Cheddar, scatter jalapeno slices evenly over, and sprinkle with remaining cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbly, 30 to 35 minutes. Top with onions and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

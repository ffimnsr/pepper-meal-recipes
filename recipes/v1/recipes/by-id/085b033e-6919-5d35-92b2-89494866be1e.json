  "schema_version": 1,
  "id": "085b033e-6919-5d35-92b2-89494866be1e",
  "slug": "cherry-pie-iv",
  "name": "Cherry Pie IV",
  "recipe_type": "dessert",
  "brief_description": "Sour cherries and a hint of almond extract flavor this simple, classic cherry pie with a homemade crust.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine flour and salt. Cut in the cold shortening until pea-sized (you may use the paddle of a stand mixer for this step, or pulse in a food processor, then transfer to a bowl). Stir in water until mixture forms a ball. Divide dough in half and shape into balls. Wrap in plastic and refrigerate for at least 1 hour or overnight."
    },
    {
      "position": 2,
      "text": "On a lightly floured work surface, roll out half the dough to fit a 9-inch pie plate. Place bottom crust in pie plate, loosely cover with plastic, and refrigerate."
    },
    {
      "position": 3,
      "text": "Whisk together sugar and cornstarch in a saucepan; add cherries and toss to coat. Let stand for about 10 minutes to draw out the cherry juices."
    },
    {
      "position": 4,
      "text": "Preheat oven to 475 degrees F (245 degrees C). Place a baking sheet in the oven to preheat."
    },
    {
      "position": 5,
      "text": "Bring cherry filling to a boil over medium heat, stirring constantly. Lower the heat and simmer for 1 minute or until the juices thicken and become translucent (filling will thicken further as it cools). Remove from heat and stir in the butter and almond extract. Mix thoroughly and allow to cool to room temperature."
    },
    {
      "position": 6,
      "text": "Roll out second crust and cut into lattice strips or decorative shapes. When filling is cool, pour into bottom pie shell. Cover filling with top crust or cutouts and crimp edges."
    },
    {
      "position": 7,
      "text": "Reduce oven to 375 degrees F (190 degrees C) and place pie on hot baking sheet."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until crust is golden brown and filling is bubbly, 45 to 55 minutes. Let pie cool and set several hours before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 45,

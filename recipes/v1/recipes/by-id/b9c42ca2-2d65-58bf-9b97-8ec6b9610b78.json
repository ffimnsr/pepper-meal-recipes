  "id": "b9c42ca2-2d65-58bf-9b97-8ec6b9610b78",
  "slug": "griswolds-turkey-jerky",
  "name": "Griswolds Turkey Jerky",
  "recipe_type": "appetizer",
  "brief_description": "This flavorful turkey jerky is seasoned with spices and salts and prepared with a dehydrator--perfect for snacking or taking on camping or hiking trips.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground turkey, water, liquid smoke, kosher salt, pink salt, pepper, onion powder, paprika, garlic powder, and sage in a large bowl. Mix until evenly combined. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Form as many sticks as you can fit on the racks of a dehydrator using a jerky gun."
    },
    {
      "position": 3,
      "text": "Set the dehydrator to 155 degrees F (68 degrees C)."
    },
    {
      "position": 4,
      "text": "Cook for 2 1/2 hours. Unplug the dehydrator and remove the lid. Let jerky sit for 1 hour for final drying."
    }
  ],
  "servings": 35,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

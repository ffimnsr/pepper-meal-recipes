  "id": "f0c7f549-0dde-57ea-b70d-fa7790938683",
  "slug": "creamy-cottage-cheese-scrambled-eggs",
  "name": "Creamy Cottage Cheese Scrambled Eggs",
  "recipe_type": "breakfast",
  "brief_description": "These fluffy cottage cheese scrambled eggs are cooked in butter to make a delicious low-carb breakfast for two in just 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Pour beaten eggs into the skillet; let cook undisturbed until the bottom of the eggs begins to firm, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir cottage cheese and chives into eggs and season with black pepper."
    },
    {
      "position": 4,
      "text": "Cook and stir until eggs are nearly set, 3 to 4 minutes more."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

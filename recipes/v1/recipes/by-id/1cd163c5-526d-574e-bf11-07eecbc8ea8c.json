  "id": "1cd163c5-526d-574e-bf11-07eecbc8ea8c",
  "slug": "chef-johns-beef-and-barley-stew",
  "name": "Chef John's Beef and Barley Stew",
  "recipe_type": "soup",
  "brief_description": "Chef John's old-fashioned beef barley soup features shank simmered for hours with vegetables until meltingly tender for a hearty, cold-weather meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season beef all over with kosher salt and black pepper."
    },
    {
      "position": 3,
      "text": "Heat oil in a large pot over high heat. Cook beef in hot oil until browned on all sides, about 10 minutes. Transfer beef to a plate; set aside."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium and stir onion into the same pot with a pinch of salt. Cook and stir until onion is soft and translucent, 4 to 5 minutes. Add garlic; cook and stir until fragrant, about 1 minute."
    },
    {
      "position": 5,
      "text": "Add tomato paste; cook and stir until tomato paste is brick red, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Pour in broth."
    },
    {
      "position": 7,
      "text": "Add celery, carrots, rosemary, and bay leaf."
    },
    {
      "position": 8,
      "text": "Return beef with any accumulated juices to the pot; push beef down to cover with cooking liquid."
    },
    {
      "position": 9,
      "text": "Bring to a simmer, then reduce heat to low. Cover the pot and cook until beef is fork tender, 2 to 3 hours. Remove beef to a large bowl."
    },
    {
      "position": 10,
      "text": "Pour barley into cooking liquid in the pot; bring to a simmer and cook until barley is tender, about 45 minutes."
    },
    {
      "position": 11,
      "text": "Return beef to the pot. Cover the pot and cook until heated through, about 10 minutes. Season with salt."
    },
    {
      "position": 12,
      "text": "Ladle stew into bowls and garnish with parsley and horseradish."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 200,

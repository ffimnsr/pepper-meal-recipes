  "id": "8af2ea83-5a47-58d2-b89b-c1b362d6a9d9",
  "slug": "big-mac-pickle-recipe-11937205",
  "name": "Big Mac Pickle",
  "recipe_type": "main",
  "brief_description": "This Big Mac pickle is a chopped and sauced version of your favorite burger, served in a big pickle. You may have extra sauce, and feel free to adjust the chopped ingredients to your taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir mayonnaise, relish, onion, mustard, ketchup, vinegar, and onion powder together in a small bowl. Season with paprika and salt; set aside."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef in a nonstick skillet until browned and crumbly, about 5 minutes; set aside."
    },
    {
      "position": 3,
      "text": "Slice off the side of each pickle and hollow out the core of pickle with a spoon to create a space to fill; set aside."
    },
    {
      "position": 4,
      "text": "To assemble, add tomato, onion, pickles, ground beef, and cheese to a board. Drizzle with burger sauce, then chop all ingredients together. Scoop up a small amount of mixture and fill each pickle. Drizzle with more burger sauce and enjoy. Refrigerate any extra sauce in a jar with a lid for up to 2 weeks."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

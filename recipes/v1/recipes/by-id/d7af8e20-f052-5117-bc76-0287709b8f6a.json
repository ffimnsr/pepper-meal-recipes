  "id": "d7af8e20-f052-5117-bc76-0287709b8f6a",
  "slug": "easy-slow-cooker-french-dip",
  "name": "Easy Slow Cooker French Dip",
  "recipe_type": "soup",
  "brief_description": "An easy French dip recipe made in the slow cooker that uses rump roast, beef broth, onion soup, and beer to create a delicious sandwich filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Trim excess fat from rump roast and place in a slow cooker."
    },
    {
      "position": 3,
      "text": "Pour in beer, onion soup, and beef broth. Cover and cook on Low setting for 7 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Split French bread rolls and arrange them on a baking sheet; spread with butter. Warm in the preheated oven for 10 minutes, or until heated through."
    },
    {
      "position": 6,
      "text": "Meanwhile, remove rump roast from the slow cooker and thinly slice on the diagonal."
    },
    {
      "position": 7,
      "text": "Pile sliced beef onto heated rolls. Serve with sauce for dipping. Enjoy!"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 420,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

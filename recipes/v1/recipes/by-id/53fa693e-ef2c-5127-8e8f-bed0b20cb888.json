  "id": "53fa693e-ef2c-5127-8e8f-bed0b20cb888",
  "slug": "ny-style-rye-crackers",
  "name": "New York-Style Rye Crackers",
  "recipe_type": "appetizer",
  "brief_description": "These crispy rye crackers are seasoned with caraway, garlic, and onion powder.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine rye flour, all-purpose flour, caraway seed, salt, onion powder, and garlic powder in a bowl. Stir in canola oil and honey. While stirring with a fork, slowly add water until dough comes together in a ball. Cover and rest for 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Divide dough into 4 sections, rolling each piece out on parchment paper to be 1/8-inch thick. Cut into desired shapes then place on a baking sheet. Prick each cracker a few times with a fork."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the edges are brown and crackers are crisp, 10 to 12 minutes. Move to a cooling rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

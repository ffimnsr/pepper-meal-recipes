  "id": "2894e5ac-a80c-55e7-9bc6-325df9850719",
  "slug": "maple-soy-snack-mix-recipe-12035175",
  "name": "Maple-Soy Snack Mix",
  "recipe_type": "appetizer",
  "brief_description": "Umami-forward soy sauce complements sweet maple syrup in this crispy, crunchy maple-soy snack mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (121 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together pure maple syrup, melted butter, soy sauce, and vanilla extract in a large bowl."
    },
    {
      "position": 3,
      "text": "Add rice square cereal, wheat square cereal, oyster crackers, mini pretzel sticks, and cashews. Toss to coat. Sprinkle with furikake seasoning. Toss to coat evenly."
    },
    {
      "position": 4,
      "text": "Spread on a 13x18-inch rimmed baking sheet. Bake, stirring every 15 minutes, until well toasted and fragrant, 45 to 50 minutes. Let cool completely before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

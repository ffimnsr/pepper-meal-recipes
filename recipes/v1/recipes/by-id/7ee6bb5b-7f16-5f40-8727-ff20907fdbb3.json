  "slug": "vegan-raw-sunchoke-salad-with-apples",
  "name": "Vegan Raw Sunchoke Salad with Apples",
  "recipe_type": "salad",
  "brief_description": "Thinly sliced raw sunchokes (Jerusalem artichokes) are combined with apples in this refreshing vegan salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange sliced sunchokes and apples on a serving platter."
    },
    {
      "position": 2,
      "text": "Combine olive oil, orange juice, salt, pepper, and sugar in a blender; blend until creamy. Drizzle over sunchoke-apple mixture."
    }
  ],

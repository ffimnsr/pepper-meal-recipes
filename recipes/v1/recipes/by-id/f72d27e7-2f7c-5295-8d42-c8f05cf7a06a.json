  "id": "f72d27e7-2f7c-5295-8d42-c8f05cf7a06a",
  "slug": "air-fryer-beignets",
  "name": "Air Fryer Beignets",
  "recipe_type": "dessert",
  "brief_description": "These sweet air fryer beignets are \"fried\" with no oil, then dusted with powdered sugar for a treat you can feel a little better about eating.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 370 degrees F (185 degrees C). Spray a 7-cavity silicone egg bite mold with nonstick spray."
    },
    {
      "position": 2,
      "text": "Whisk flour, 1/4 cup plus 2 tablespoons white sugar, water, egg yolk, melted butter, baking powder, vanilla, and salt together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Beat egg white in a small bowl with an electric mixer on medium speed until soft peaks form. Fold egg white into batter. Scoop batter into the prepared mold with a small-hinged ice cream scoop. Place the mold into the air fryer basket."
    },
    {
      "position": 4,
      "text": "Fry in the preheated air fryer for 10 minutes. Remove mold from the basket carefully; pop beignets out and flip over onto a parchment paper round."
    },
    {
      "position": 5,
      "text": "Place parchment round with beignets back into the air fryer basket. Cook for an additional 4 minutes. Remove beignets from the air fryer basket and dust with confectioners' sugar."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

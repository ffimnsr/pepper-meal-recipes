  "id": "4afe7951-8669-57ac-a306-2e3d37da68ff",
  "slug": "easy-roasted-broccoli",
  "name": "Easy Roasted Broccoli",
  "recipe_type": "side",
  "brief_description": "Roasted broccoli florets and broccoli stems are cooked with just olive oil, salt, and pepper. So much more flavorsome than boiled or steamed broccoli!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut broccoli florets from the stalk."
    },
    {
      "position": 3,
      "text": "Peel the stalk and slice into 1/4-inch slices."
    },
    {
      "position": 4,
      "text": "Mix florets and stem pieces with olive oil in a bowl and transfer to a baking sheet; season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven until broccoli is tender and lightly browned, about 18 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

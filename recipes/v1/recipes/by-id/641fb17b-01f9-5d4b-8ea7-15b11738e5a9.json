  "id": "641fb17b-01f9-5d4b-8ea7-15b11738e5a9",
  "slug": "gyros",
  "name": "Gyros",
  "recipe_type": "main",
  "brief_description": "Homemade gyros start with this delicious gyros meat recipe; serve on pitas with lettuce, tomatoes, tzatziki sauce, and feta for a gorgeous Greek meal.",
  "cuisine": "Mediterranean Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Process red onion in a food processor until finely minced. Scoop onion into a piece of cheesecloth and squeeze it to release as much moisture as possible."
    },
    {
      "position": 3,
      "text": "Return onion to the food processor. Add garlic and process until the garlic is well integrated. Blend in marjoram, rosemary, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Gradually blend ground beef and ground lamb with the onion and seasoning mixture by alternately adding small amounts of each meat to the mixture and processing until well incorporated before adding the next batch."
    },
    {
      "position": 5,
      "text": "Firmly pack the meat mixture into a 9x5-inch loaf pan, assuring no air pockets are trapped in the meat."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour 15 minutes. An instant-read thermometer inserted into the center should read at least 175 degrees F (80 degrees C)."
    },
    {
      "position": 7,
      "text": "Drain grease and slice thinly to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

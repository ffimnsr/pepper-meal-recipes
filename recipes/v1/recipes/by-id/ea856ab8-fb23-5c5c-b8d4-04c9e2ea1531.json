  "schema_version": 1,
  "id": "ea856ab8-fb23-5c5c-b8d4-04c9e2ea1531",
  "slug": "gnocchi-with-pomodoro-sauce",
  "name": "Gnocchi with Pomodoro Sauce",
  "recipe_type": "main",
  "brief_description": "You can use homemade or store-bought gnocchi for this classic Italian dish. Gnocchi are topped with homemade tomato sauce and fresh mozzarella cheese and then broiled in the oven.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Open marinated mozzarella balls and measure out 1/4 cup of the oil."
    },
    {
      "position": 2,
      "text": "Pour oil into a heavy skillet over medium-high heat. Cook gnocchi in batches in the hot oil until golden and heated through. Divide gnocchi evenly amongst 4 gratin dishes."
    },
    {
      "position": 3,
      "text": "Add garlic and red chili flakes to the oil in the same skillet. Cook until garlic is fragrant, about 30 seconds. Stir in salt and sugar. Pour in tomatoes. Use a wooden spoon to break up and crush the tomatoes."
    },
    {
      "position": 4,
      "text": "Bring sauce to a boil, reduce heat, cover and simmer tomatoes for 15 minutes."
    },
    {
      "position": 5,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 6,
      "text": "Taste sauce and adjust seasonings if desired. Spoon tomato sauce over the gnocchi. Top each dish with 3 marinated mozzarella balls and set on a baking sheet."
    },
    {
      "position": 7,
      "text": "Add baking sheet to oven and broil until mozzarella balls are melted and golden browned, 3 to 5 minutes. Garnish with parsley or basil if desired and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

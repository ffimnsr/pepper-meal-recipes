  "id": "15fca364-550f-586d-8b57-a8855872117a",
  "slug": "nacho-pizza",
  "name": "Nacho Pizza",
  "recipe_type": "appetizer",
  "brief_description": "This nacho pizza is exactly what it sounds like - all the toppings you'd get on a plate of nachos on a thin pizza crust! Add your own favorites to customize the recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook beef in a large skillet under no longer pink, about 5 minutes. Drain. Stir in seasoning mix until evenly combined."
    },
    {
      "position": 3,
      "text": "Place pizza crust on a work surface. Spread queso dip evenly over the crust. Top with Cheddar cheese, cooked beef mixture, jalapeno, and green onions. Spoon salsa onto the pizza in random spots, making sure it's not mixed in with the other toppings. Sprinkle crushed tortilla chips on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven directly on the middle oven rack until cheese is hot and melted, about 8 minutes. Serve with sour cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

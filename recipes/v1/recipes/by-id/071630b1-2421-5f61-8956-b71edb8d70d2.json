  "id": "071630b1-2421-5f61-8956-b71edb8d70d2",
  "slug": "indonesian-ratatouille-with-tempeh",
  "name": "Indonesian Ratatouille with Tempeh",
  "recipe_type": "main",
  "brief_description": "This dish is also known as sayur lodeh, which is a vegetable medley that includes tempeh as the main ingredient topped with coconut milk.",
  "cuisine": "Indonesian Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Coat the bottom of a skillet with oil and place it over medium heat. Combine shallots, peppers, tomato, and garlic in the skillet and stir until fragrant, about 3 minutes. Add tempeh, bell pepper, and okra; stir quickly to combine. Add broth and eggplant; bring to a low boil and cook for about 5 minutes. Reduce heat, cover, and simmer until all vegetables are tender, 5 to 7 minutes. Stir in coconut milk and brown sugar. Season with salt and pepper."
    }
  ],
  "servings": 2,

  "id": "78946bcc-0363-59aa-b497-bc9bda3680e4",
  "slug": "black-eyed-pea-gumbo",
  "name": "Black-Eyed Pea Gumbo",
  "recipe_type": "soup",
  "brief_description": "A hearty black-eyed pea gumbo with bell peppers, brown rice, and diced tomatoes with green chiles. Perfect for New Year\u2019s Day with warm cornbread!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium heat. Add onion, pepper, and celery; cook until tender."
    },
    {
      "position": 2,
      "text": "Pour in chicken broth; stir in rice, black-eyed peas with liquid, diced tomatoes with green chiles, diced tomatoes, and garlic. Bring to a boil, reduce heat to low, and simmer for 45 minutes, or until rice is tender. Add water if gumbo is too thick."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,

  "id": "49e3ba9a-f20f-5964-b413-183cc92b2cf6",
  "slug": "crispy-bacon-and-sweet-onion-omelet",
  "name": "Crispy Bacon and Sweet Onion Omelet",
  "recipe_type": "dessert",
  "brief_description": "Sauteed onions, crispy bacon, and a blend of cheddar and American cheeses provide the filling for this fluffy omelet.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a skillet over medium-high heat until crisp. Remove with a slotted spoon to paper towels to drain and cool; crumble the bacon and set aside."
    },
    {
      "position": 2,
      "text": "Melt the butter in a skillet over medium heat. Cook and stir the onions in the butter until tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Prepare a 10-inch non-stick skillet with cooking spray and place over a cold burner. Whisk together the eggs and water; pour the egg mixture into the cold skillet. Cover and turn the burner on for medium-low heat. Cook until steam begins to vent from the skillet. Remove the lid. Sprinkle the crumbled bacon, Cheddar cheese, American cheese, salt, and red pepper over the eggs. Spread the onions over the eggs. Gently swirl the skillet in a circular motion to release the omelet and slide it onto a plate. Fold the omelet in half. Allow the cheese to melt, about 2 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

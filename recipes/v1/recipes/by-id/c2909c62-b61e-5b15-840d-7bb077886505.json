  "id": "c2909c62-b61e-5b15-840d-7bb077886505",
  "slug": "grandmas-meat-and-tater-hotdish",
  "name": "Grandma's Meat and Tater Hotdish",
  "recipe_type": "side",
  "brief_description": "Grandma's meat and tater hotdish recipe combines hearty ground beef, canned green beans, potato nuggets, and cheese with a creamy mushroom sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain grease. Add onion; cook and stir until soft and translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir green bean liquid, condensed soup, and sour cream together in a bowl until well combined. Set sauce aside."
    },
    {
      "position": 4,
      "text": "Stir green beans into beef-onion mixture to combine; transfer to a casserole dish. Top with cheese slices; cover with frozen potato nuggets. Pour sauce over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until potatoes are browned and sauce is bubbly, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

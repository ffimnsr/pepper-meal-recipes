  "id": "95900c23-a6cd-51fa-9d9c-287e669a4a7b",
  "slug": "healthier-boilermaker-tailgate-chili",
  "name": "Healthier Boilermaker Tailgate Chili",
  "recipe_type": "soup",
  "brief_description": "This boilermaker tailgate chili, made healthier with lean beef, chicken sausage, beans, and spices, is hearty, delicious, and sure to please every football fan!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef and chicken sausage into a large stock pot over medium-high heat; cook and stir until evenly browned, 10 to 12 minutes. Drain excess grease."
    },
    {
      "position": 2,
      "text": "Pour in diced tomatoes, chili beans, spicy chili beans, and tomato paste; add onion, celery, green bell pepper, red bell pepper, chile peppers, and beer. Season with chili powder, Worcestershire sauce, garlic, oregano, cumin, hot pepper sauce, basil, salt, ground pepper, cayenne, paprika, and sugar. Stir to blend, cover, and simmer over low heat, stirring occasionally, for at least 2 hours."
    },
    {
      "position": 3,
      "text": "Taste and season with more chili powder if necessary. Ladle into bowls; top with baked tortilla chips, red onion, cilantro, or diced avocado to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,

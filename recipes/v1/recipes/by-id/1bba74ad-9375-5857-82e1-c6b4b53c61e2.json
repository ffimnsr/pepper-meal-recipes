  "id": "1bba74ad-9375-5857-82e1-c6b4b53c61e2",
  "slug": "my-favorite-sloppy-joes",
  "name": "My Favorite Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "This quick Sloppy Joe meal is a perfect weeknight dinner, and one the kids will love. Who knew basic pantry ingredients would result in such a tasty meal?",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir ground beef in a large skillet over medium heat until browned and crumbly, about 10 minutes; drain excess grease. Mix ketchup, dried onion, brown sugar, mustard, Worcestershire sauce, liquid smoke, and garlic into beef, stirring until brown sugar has dissolved."
    },
    {
      "position": 2,
      "text": "Stir in broth and bring to a boil. Reduce the heat to low and simmer until thick, about 30 minutes. Season with salt and black pepper. Serve on buns."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

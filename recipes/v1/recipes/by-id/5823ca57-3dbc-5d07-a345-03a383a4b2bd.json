  "id": "5823ca57-3dbc-5d07-a345-03a383a4b2bd",
  "slug": "tamale-casserole",
  "name": "Tamale Casserole",
  "recipe_type": "main",
  "brief_description": "Canned beef tamales are cut into chunks and combined in a casserole with onion, cheese, tortilla chips and (beanless) chili. These are baked for 40 to 45 minutes.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Unwrap tamales and cut into thick chunks. Place a portion of the chopped tamales in the bottom of a 2 quart casserole dish. Then layer the onions, cheese, tortilla chips and chili without beans."
    },
    {
      "position": 3,
      "text": "Repeat this until all ingredients are used, topping off with cheese and chips. Then sprinkle with the water."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, at 350 degrees F (175 degrees C) for 40 to 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

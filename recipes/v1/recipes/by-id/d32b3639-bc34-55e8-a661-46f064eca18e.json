  "id": "d32b3639-bc34-55e8-a661-46f064eca18e",
  "slug": "sweet-soy-and-balsamic-chicken-and-mushrooms-recipe-11895518",
  "name": "Sweet Soy and Balsamic Chicken and Mushrooms",
  "recipe_type": "dessert",
  "brief_description": "This sweet soy and balsamic chicken and mushrooms stir-fry uses simple ingredients, comes together quickly, and is so tasty. Serve it in bowls over white rice, topped with chopped green onion and toasted sesame seeds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For sauce, place a heavy-bottomed pot over medium heat. Add sugar, balsamic vinegar, soy sauce, white pepper, ginger, and coriander to the pot and bring to a simmer, stirring frequently, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, place a skillet over medium heat. Add oil to the skillet. Season chicken lightly with salt on both sides. Cut chicken breast into bite-sized chunks. Add chicken and cook and stir until barely pink at the center, about 5 minutes. Add mushrooms and continue to cook, stirring frequently, until chicken is no longer pink at the center and mushrooms are softened to taste, a few minutes more."
    },
    {
      "position": 3,
      "text": "Add chicken and mushrooms to sauce. Stir to coat; cook until heated through, about 1 minute. Serve over white rice. Garnish with green onions and sesame seeds."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

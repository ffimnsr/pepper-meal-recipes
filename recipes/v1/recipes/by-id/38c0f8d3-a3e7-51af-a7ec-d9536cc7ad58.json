  "id": "38c0f8d3-a3e7-51af-a7ec-d9536cc7ad58",
  "slug": "hearty-breakfast-muffins",
  "name": "Hearty Breakfast Muffins",
  "recipe_type": "breakfast",
  "brief_description": "Hearty, healthy breakfast muffins loaded with carrots, zucchini, pecans, coconut, and bananas. Guaranteed to get your day off to a good start!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper liners."
    },
    {
      "position": 2,
      "text": "Mix carrots, banana, zucchini, vegetable oil, yogurt, and eggs together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Whisk flour and baking soda together in a separate bowl. Mix brown sugar, oats, coconut, pecans, cherries, cinnamon, salt, and ginger into flour mixture until all ingredients are coated in flour. Stir banana mixture into flour mixture until just combined. Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 18 to 22 minutes. Cool in the tin for 10 minutes. Transfer to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

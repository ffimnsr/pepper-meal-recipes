  "id": "b0b449b1-a802-52b1-8bb8-20a9bed06eda",
  "slug": "bocconcini-salad",
  "name": "Bocconcini Salad",
  "recipe_type": "salad",
  "brief_description": "Bite-size balls of fresh mozzarella, known as bocconcini, make up this great salad made with cherry tomatoes, bell pepper, arugula, and fresh basil. It's a version of the popular 'insalata caprese.'",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a large salad bowl, combine the mozzarella, cherry tomatoes, bell pepper, celery, endive and arugula."
    },
    {
      "position": 2,
      "text": "Whisk together the lemon juice and olive oil; pour over the salad. Toss until all the ingredients are thoroughly coated with the dressing. Transfer salad to individual serving plates, if desired. Sprinkle the basil over the salad, season with salt and pepper, and serve immediately."
    }
  ],
  "servings": 4,

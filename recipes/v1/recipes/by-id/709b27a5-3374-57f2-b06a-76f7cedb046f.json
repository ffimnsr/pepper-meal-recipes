  "id": "709b27a5-3374-57f2-b06a-76f7cedb046f",
  "slug": "buffalo-style-chicken-pizza",
  "name": "Buffalo-Style Chicken Pizza",
  "recipe_type": "appetizer",
  "brief_description": "This Buffalo chicken pizza has your favorite appetizer fixings (chicken, hot sauce, and blue cheese) topped with mozzarella on a crispy pizza crust.",
  "cuisine": "U.S. American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Mix chicken, hot sauce, and melted butter in a bowl until well combined."
    },
    {
      "position": 4,
      "text": "Place crust onto a rimmed baking sheet or pizza pan. Spread salad dressing over crust."
    },
    {
      "position": 5,
      "text": "Top with chicken mixture and sprinkle with mozzarella."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crust is golden brown and cheese is bubbly, about 5 to 10 minutes. Let sit a few minutes before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

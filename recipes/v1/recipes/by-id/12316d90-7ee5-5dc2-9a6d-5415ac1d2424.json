  "id": "12316d90-7ee5-5dc2-9a6d-5415ac1d2424",
  "slug": "ham-and-cheese-stromboli",
  "name": "Ham and Cheese Stromboli",
  "recipe_type": "main",
  "brief_description": "A pizza with the filling in the middle! Pizza dough is slathered with sauce, then stuffed with ham, sausage, salami, pepperoni, mozzarella cheese, and a few vegetables.",
  "cuisine": "U.S. Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Let dough rise according to package instructions, then punch down, and divide into 4 pieces."
    },
    {
      "position": 2,
      "text": "On a floured surface, roll each piece of dough into a long oval shape. Spread each with sauce, then layer with ham, capacola, salami, and pepperoni. Sprinkle with garlic powder, then top with mozzarella, onion, mushrooms and bell pepper. Bring the long sides together over the center, and pinch together to seal. Turn over, so that the seam is on the bottom, and place on an ungreased baking sheet. With a sharp knife, cut 3 diagonal slices to allow the steam to escape."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 20 to 30 minutes, or until golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "db3eed3a-c809-5b87-8597-157be5400291",
  "slug": "dragon-roll",
  "name": "Dragon Roll",
  "recipe_type": "main",
  "brief_description": "This dragon roll is filled with shrimp tempura, cucumber, and rice and is fun to decorate to look like a dragon with slices of avocado and unagi.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse rice in a strainer until water runs clear. Combine rinsed rice and water in a medium saucepan; bring to a boil. Reduce heat to low, cover, and cook until rice is tender and water is absorbed, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Combine rice vinegar, sugar, and salt in a small saucepan over low heat; stir until sugar is dissolved, 1 to 2 minutes. Pour over rice; stir until rice cools and looks dry."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet with cooking spray."
    },
    {
      "position": 4,
      "text": "Arrange shrimp tempura on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and crispy, about 6 minutes per side. Cut the tails off of 4 tempura shrimp."
    },
    {
      "position": 6,
      "text": "Cover a bamboo sushi rolling mat with plastic wrap. Lay 1 nori sheet, shiny-side down, on the plastic wrap. Spread 1 cup rice over nori using moistened fingers, leaving a 1/3-inch border. Flip nori so rice is facing the mat."
    },
    {
      "position": 7,
      "text": "Arrange imitation crabmeat and cucumber along the bottom edge of nori. Place 2 tail-off shrimp in the center of nori. Place 2 tail-on shrimp on the end so that the tails extend over the sides of nori. Lift the edge of the mat and roll up nori into a tight log around filling."
    },
    {
      "position": 8,
      "text": "Transfer sushi roll to a serving plate. Layer avocado and unagi slices on top to cover the top and sides of roll. Slice roll into 8 pieces using a moistened knife. Repeat with remaining nori, rice, crabmeat, cucumber, avocado, and unagi to make a second roll."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a001d725-c0ce-52c7-be84-deb34420c9d1",
  "slug": "instant-pot-potato-leek-soup",
  "name": "Instant Pot Potato Leek Soup",
  "recipe_type": "soup",
  "brief_description": "This Instant Pot potato-leek soup recipe is an easy, basic, and tasty potato-leek soup. Top it with shredded cheese, chopped cooked bacon, and chives.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add butter and leeks; saut\u00e9 until leeks tender, 3 to 5 minutes. Season with table salt."
    },
    {
      "position": 2,
      "text": "Reserve \u00bc cup cubed potatoes; add remaining potatoes to the Pot with leeks. Place reserved potatoes in the steamer basket; place basket in the Pot. Pour in chicken broth."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Set the timer for 10 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Remove the steamer basket; set steamed potatoes aside. Pour half-and-half into the Pot. Blend soup using an immersion blender."
    },
    {
      "position": 6,
      "text": "Stir steamed potatoes and seasoned salt into soup."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

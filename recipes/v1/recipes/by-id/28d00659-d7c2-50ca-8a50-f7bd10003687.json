  "slug": "vegan-pumpkin-overnight-oats-in-the-slow-cooker",
  "name": "Vegan Pumpkin Overnight Oats in the Slow Cooker",
  "recipe_type": "breakfast",
  "brief_description": "All ingredients go in the slow cooker at night, and you'll have delicious vegan overnight oats flavored with pumpkin puree ready in the morning!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, steel-cut oats, almond milk, pumpkin puree, vanilla extract, pumpkin pie spice, and salt in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 hours."
    }
  ],
  "servings": 4,

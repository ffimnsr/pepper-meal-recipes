  "slug": "mississippi-roast-slow-cooker-pepperoncini-pot-roast",
  "name": "Mississippi Roast (Slow Cooker Pepperoncini Pot Roast)",
  "recipe_type": "main",
  "brief_description": "Mississippi pepperoncini roast \u2014 cooked with ranch and au jus mix along with pepperoncini peppers, of course, is an easy, zesty slow cooker recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place roast in a slow cooker. Form a pocket in the top of the roast and place butter, pepperoncini peppers, ranch dressing mix, and au jus mix in the pocket."
    },
    {
      "position": 3,
      "text": "Cook on Low for 8 hours."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,

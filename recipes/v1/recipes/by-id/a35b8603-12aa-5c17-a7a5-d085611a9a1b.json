  "id": "a35b8603-12aa-5c17-a7a5-d085611a9a1b",
  "slug": "viking-flatbread-recipe-11712861",
  "name": "Viking Flatbread",
  "recipe_type": "breakfast",
  "brief_description": "This Viking flatbread is so flavorful. Using flours the Vikings might have used\u2014spelt flour and rye flour\u2014and moistening the dough with buttermilk rather than water, the flatbreads have a bit of a sourdough note.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, spelt flour, rye flour, and salt in a bowl and stir with a wooden spoon to combine."
    },
    {
      "position": 2,
      "text": "Pour in buttermilk, and stir until a shaggy dough forms. Clean off the spoon and work the mixture with your hands until it comes together into a ball of dough, and the sides of the bowl are clean."
    },
    {
      "position": 3,
      "text": "Transfer onto a work surface, and using only enough flour to prevent sticking, knead until a smooth, elastic, and slightly sticky dough forms, about 2 minutes. Cover dough and let it rest for 15 minutes at room temperature."
    },
    {
      "position": 4,
      "text": "Divide into 6 equal portions and roll each one into a ball. Using just enough flour to prevent sticking, roll each portion out into a circle about 1/8-inch thick."
    },
    {
      "position": 5,
      "text": "Heat a dry cast iron pan over medium-high heat. Place in flatbread and cook until browned and blistered, about 1 to 1 1/2 minutes per side."
    },
    {
      "position": 6,
      "text": "Pile up cooked flatbreads on a plate and cover with a dry kitchen towel as they are being made. Let rest, covered, for about 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

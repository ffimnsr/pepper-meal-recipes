{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "cc6634ed-b5ef-5383-bd05-ba524d70beac",
  "slug": "alfajores-dulce-de-leche-sandwich-cookies",
  "name": "Alfajores (Dulce de Leche Sandwich Cookies)",
  "recipe_type": "dessert",
  "brief_description": "These Peruvian dulce de leche cookies called alfajores are buttery and sweet with a touch of vanilla. Try them for your next big gathering.",
  "cuisine": "Peruvian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, 1/2 cup confectioners' sugar, cornstarch, and salt together in a bowl."
    },
    {
      "position": 2,
      "text": "Beat butter with an electric mixer in a separate bowl until soft and fluffy. Mix in white sugar and vanilla until well combined."
    },
    {
      "position": 3,
      "text": "Add dry ingredients to wet ingredients in 3 batches, beating until just blended after each addition. Divide dough in half, roll each half into a log, and refrigerate until firm, about 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Slice dough logs into forty-eight 1/4-inch-thick cookies and place onto ungreased baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until just starting to turn golden around the edges, 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and let cool for 1 minute on the baking sheet. Transfer cookies to wire racks to cool completely, 25 to 30 minutes."
    },
    {
      "position": 8,
      "text": "Use a knife to generously spread dulce de leche onto 1/2 of the cooled cookies. Sandwich remaining cookies on top and place onto a serving tray."
    },
    {
      "position": 9,
      "text": "Lightly dust finished cookies with remaining confectioners' sugar."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "59992b9c-636c-5dca-a184-6b7776185b34",
  "slug": "bulgogi-ground-beef-stir-fry-recipe-11797163",
  "name": "Bulgogi Ground Beef Stir Fry",
  "recipe_type": "main",
  "brief_description": "This bulgogi ground beef stir fry uses store-bought bulgogi sauce for quick prep and delicious Korean-style flavor to make an easy weeknight meal.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat a cast iron skillet and a large wok-style pan to medium-high heat."
    },
    {
      "position": 2,
      "text": "Lightly season the beef with salt and pepper. Add beef to the cast iron skillet, and allow to lightly sear before gently breaking it up into small chunks, but not too fine."
    },
    {
      "position": 3,
      "text": "Add in soy sauce. Cook until beef is no longer pink, then set aside."
    },
    {
      "position": 4,
      "text": "Add beef tallow to the wok. Add onions and saute just to get some color on them. Add bell pepper and chopped bok choy stalks; stir fry for 1 to 2 minutes. Add in snow peas, then garlic. Cook, stirring regularly to ensure everything softens but also stays crisp."
    },
    {
      "position": 5,
      "text": "Add in bok choy leaves last. Give all the vegetables 1 full stir, then add bulgogi marinade. Stir, then stir beef into the mix."
    },
    {
      "position": 6,
      "text": "Serve over hot white rice; garnish with cilantro leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

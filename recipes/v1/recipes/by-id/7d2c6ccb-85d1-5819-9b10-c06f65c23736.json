  "id": "7d2c6ccb-85d1-5819-9b10-c06f65c23736",
  "slug": "gingerbread-fudge-recipe-8749111",
  "name": "Gingerbread Fudge",
  "recipe_type": "dessert",
  "brief_description": "Try this gingerbread fudge for the holidays - you only need a few pantry ingredients and some spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Line an 8x8-inch baking pan with aluminum foil and lightly grease or butter the foil; set aside."
    },
    {
      "position": 3,
      "text": "Set aside 1/2 cup white chocolate chips. Combine remaining white chocolate chips, sweetened condensed milk, molasses, and butter in a saucepan set over medium heat. Stir frequently until butter and chocolate chips are completely melted and ingredients are combined."
    },
    {
      "position": 4,
      "text": "Add vanilla extract, ginger, cinnamon, nutmeg, allspice, cloves and salt; stir well to combine."
    },
    {
      "position": 5,
      "text": "Pour mixture into the prepared pan and smooth out evenly."
    },
    {
      "position": 6,
      "text": "Working quickly, microwave the remaining 1/2 cup white chocolate chips in a small microwave-safe bowl until melted, 1 to 1 1/2 minutes, stirring every 30 seconds."
    },
    {
      "position": 7,
      "text": "Spoon dollops of the white chocolate mixture atop the fudge and use a knife to gently swirl the 2 mixtures together."
    },
    {
      "position": 8,
      "text": "Cover and chill about 2 hours or until firm."
    },
    {
      "position": 9,
      "text": "Use foil to lift uncut fudge out of the pan; cut into 1-inch squares. Makes 2 pounds 6 ounces."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

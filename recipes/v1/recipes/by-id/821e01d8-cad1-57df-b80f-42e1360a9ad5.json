  "schema_version": 1,
  "id": "821e01d8-cad1-57df-b80f-42e1360a9ad5",
  "slug": "godeungeo-jorim-korean-braised-mackerel-with-radish",
  "name": "Godeungeo Jorim (Korean Braised Mackerel with Radish)",
  "recipe_type": "dessert",
  "brief_description": "Fresh mackerel and daikon radish are braised in a sweet and spicy sauce flavored with gochujang and gochugaru in this unique Korean recipe.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine red chile pepper, green chile pepper, cooking wine, gochugaru, gochujang, soy sauce, brown sugar, garlic, and ginger in a small bowl; mix well to make sauce."
    },
    {
      "position": 2,
      "text": "Place water and daikon radish in a large pot. Bring to a boil; cook until radish is tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir mackerel pieces into the pot. Pour sauce over the mackerel. Cook over high heat, occasionally spooning sauce over mackerel but not stirring the mixture, until cooking liquid has reduced by half, about 10 minutes. Reduce heat and simmer, partially covered, until sauce thickens, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Garnish mackerel with green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4f04b635-ed9b-53d3-a6bb-2a053dc0ee8b",
  "slug": "roasted-winter-vegetable-soup",
  "name": "Roasted Winter Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "This is a tasty and satisfying pureed soup that makes the best of the humble produce that winter farmers' markets have to offer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "With a mortar and pestle, grind together rosemary and kosher salt. Pour in olive oil and continue to mash until the oil starts to turn a darker green. Set aside for about an hour."
    },
    {
      "position": 2,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Coat a shallow roasting pan with cooking spray."
    },
    {
      "position": 3,
      "text": "Place the squash, rutabagas, parsnips and potatoes in a large bowl. Pour the olive oil mixture through a fine-mesh strainer into the bowl. Toss vegetables with oil to coat."
    },
    {
      "position": 4,
      "text": "Evenly spread vegetables on the prepared pan. Roast 30 minutes in the preheated oven, until nicely browned and cooked through. You may need to remove some of the smaller pieces from the oven before all of the vegetables are cooked to avoid burning them."
    },
    {
      "position": 5,
      "text": "While the vegetables are roasting, simmer chicken stock in a large pot over medium low heat. When the vegetables are done add them to the simmering chicken stock and simmer together for about 10 minutes."
    },
    {
      "position": 6,
      "text": "Use an immersion blender to puree the soup in the pot, or puree in batches in a blender or food processor. Add extra broth or water if the soup is too thick. Season with salt and pepper to taste. Serve in warmed bowls, garnishing each serving by drizzling a quarter teaspoon of balsamic vinegar and a quarter teaspoon of white truffle oil over the soup."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

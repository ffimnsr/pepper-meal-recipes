  "slug": "coconut-rum-punch-recipe-11695386",
  "name": "Coconut Rum Punch",
  "recipe_type": "appetizer",
  "brief_description": "Shake up this coconut rum punch on a sunny afternoon and you will feel like you're in the tropics. Fresh lime and fresh pineapple garnish this sparkling drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker with ice; add rum, coconut pineapple juice, lime juice, and agave syrup. Shake until the outside of shaker is frosted, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Pour into a glass filled with ice, and top off with ginger ale. Garnish with lime and pineapple."
    }
  ],
  "servings": 1,

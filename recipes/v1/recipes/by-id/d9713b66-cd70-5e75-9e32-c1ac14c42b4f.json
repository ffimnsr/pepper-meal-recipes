  "id": "d9713b66-cd70-5e75-9e32-c1ac14c42b4f",
  "slug": "western-style-baked-beans",
  "name": "Western-Style Baked Beans",
  "recipe_type": "side",
  "brief_description": "My husband does not like baked beans but can't get enough of this Western-style dish, loaded with meats and a touch of molasses, and brown sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef into a large skillet over medium-high heat. Cook and stir until no longer pink, 5 to 10 minutes. Drain off grease and transfer beef to a 4-quart or larger slow cooker."
    },
    {
      "position": 2,
      "text": "Stir baked beans with pork, bacon, ham, ketchup, brown sugar, onion, chili powder, and molasses into beef in the slow cooker until well combined. If mixture seems thick, stir in water until incorporated."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 6 to 8 hours or High for 3 hours."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 15,

  "id": "f227318d-fe6d-5610-8079-5d41a454092a",
  "slug": "snickers-cheesecake-bars-recipe-11822745",
  "name": "Snickers Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "These Snickers cheesecake bars with an Oreo crust are super easy to make. The extra snickers pieces on top of the cheesecake really bring home the snickers flavor (feel free to add more!).",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Generously line a 9x9-inch baking pan with enough aluminum foil to have overhang on 2 sides. Grease with cooking spray."
    },
    {
      "position": 2,
      "text": "Place cookies in a food processor and pulse until finely ground. You should have 2 3/4 cups crumbs. Add melted butter and pulse until combined. Spread onto the bottom of the prepared baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 8 to 10 minutes. Remove from oven, but keep oven on."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat cream cheese, sugar, sour cream, egg, vanilla, and salt in a large bowl with an electric mixer until smooth."
    },
    {
      "position": 5,
      "text": "Set aside 1/2 cup of the chopped candy bars. Fold remaining chopped candy bars into the cream cheese mixture."
    },
    {
      "position": 6,
      "text": "Spread filling mixture over the crust."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the edges are browned and set, 35 to 40 minutes."
    },
    {
      "position": 8,
      "text": "Remove from oven and cool in the pan on a wire rack until cool to the touch, about 10 minutes. Add reserved candy bar pieces and gently press into the cheesecake. Cool completely, about 2 hours."
    },
    {
      "position": 9,
      "text": "Remove base from the pan by lifting foil. Cut into squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

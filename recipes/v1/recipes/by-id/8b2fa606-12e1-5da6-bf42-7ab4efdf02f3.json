  "id": "8b2fa606-12e1-5da6-bf42-7ab4efdf02f3",
  "slug": "ants-climbing-a-tree-glass-noodles-recipe-11720262",
  "name": "Ants Climbing a Tree Glass Noodles",
  "recipe_type": "main",
  "brief_description": "This is Chef John's take on the classic Sichuan dish Ants Climbing a Tree, a magnificent mix of glass noodles and ground pork that is rich, spicy, and savory. The name is derived from the way the bits of pork stick to the noodles in the finished dish.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Add dry glass noodles to a large bowl and cover with cold water. Gently loosen the noodles apart with your fingers, and submerge noodles completely in water. Let soak for 10 minutes. Drain well and reserve."
    },
    {
      "position": 2,
      "text": "Meanwhile, for the sauce, add oil to a skillet set over medium-high heat. Add pork, and cook for 3 or 4 minutes, breaking up the meat into small crumbles with a spatula. Continue to cook until pork starts to brown, 1 or 2 minutes more."
    },
    {
      "position": 3,
      "text": "Add garlic, ginger, and fermented bean sauce, and cook, stirring, for 1 minute. Add Sichuan pepper and sugar, and cook, stirring. 30 seconds more."
    },
    {
      "position": 4,
      "text": "Add soy sauce and chicken broth; raise the heat to high and bring sauce to a boil. Add drained noodles and green onions."
    },
    {
      "position": 5,
      "text": "Cook, stirring with tongs, until noodles are soft, but retain a slight chewiness, 2 to 3 minutes. Remove from heat; noodles will continue to soak up most of the liquid after removing from heat."
    },
    {
      "position": 6,
      "text": "Transfer into a serving bowl and garnish with more sliced green onions."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

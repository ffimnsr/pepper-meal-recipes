  "id": "53e82a83-a8e7-5055-994c-fdf5b47dc97c",
  "slug": "kool-aid-popcorn",
  "name": "Kool-Aid\u00ae Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Kool-Aid\u00ae-coated popcorn is a colorful and addictive treat that the whole family will enjoy preparing and eating.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 225 degrees F (110 degrees C). Grease a large baking sheet. Place popped popcorn in a large bowl."
    },
    {
      "position": 2,
      "text": "Combine sugar, corn syrup, and butter in a saucepan; bring to a boil until sugar dissolves, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Combine drink mix and baking soda in a large bowl; pour sugar mixture into drink mixture, stirring carefully. Sugar mixture will bubble. Pour mixture over popcorn; toss to evenly coat. Transfer coated popcorn to baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, stirring every 10 minutes, until coating has hardened, about 30 minutes. Cool and break popcorn into pieces."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

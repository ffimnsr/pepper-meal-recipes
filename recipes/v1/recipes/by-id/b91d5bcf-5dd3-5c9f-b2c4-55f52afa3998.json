  "id": "b91d5bcf-5dd3-5c9f-b2c4-55f52afa3998",
  "slug": "slow-cooker-lentil-soup",
  "name": "Slow Cooker Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "Lentil soup is perfect for the slow cooker. You can just toss all ingredients into your cooker in the morning and come home to a delicious soup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, ham, tomatoes, lentils, onion, carrots, celery, garlic, pepper, salt, thyme, and bay leaf in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low until lentils and vegetables are as soft as you like, 6 to 8 hours. Remove bay leaf before serving."
    }
  ],

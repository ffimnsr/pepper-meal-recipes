  "id": "21819c41-db2d-58f4-8f23-3a22bbd270cf",
  "slug": "creamy-low-fat-chocolate-fudge-recipe-6598466",
  "name": "Creamy Low-Fat Chocolate Fudge",
  "recipe_type": "dessert",
  "brief_description": "This low-calorie fudge is rich, creamy, and chocolatey. It's made with reduced-fat condensed milk, so you can enjoy this lightened-up version.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chocolate chips and condensed milk in a medium saucepan over medium-low heat; stir gently until chips are melted. Stir in vanilla and salt, then pour mixture into an ungreased 10-inch square pan."
    },
    {
      "position": 2,
      "text": "Place in the refrigerator and chill until set, about 3 hours."
    },
    {
      "position": 3,
      "text": "Cut chilled fudge into 25 squares."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 5,

  "schema_version": 1,
  "id": "2f4a82a2-80ec-5dd3-9249-743a5a1f1182",
  "slug": "saucy-stuffed-peppers",
  "name": "Saucy Stuffed Peppers",
  "recipe_type": "drink",
  "brief_description": "This family recipe for stovetop stuffed peppers is very filling. Green bell peppers are stuffed with ground beef, onion, and rice, then simmered in tomato juice.",
  "cuisine": "Czech",
  "instructions": [
    {
      "position": 1,
      "text": "Wash peppers thoroughly. Make a circular incision around stem to remove it. Remove seeds; rinse inside of pepper. Discard seeds and stems; set peppers aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat; saut\u00e9 onion until translucent, 3 to 4 minutes. Transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Mix ground beef into onions by hand. Season with salt and pepper. Slowly pour in rice while mixing by hand. Mix thoroughly. Stuff meat and rice mixture into peppers."
    },
    {
      "position": 4,
      "text": "Coat the bottom of 1 or 2 large pots with oil. Place stuffed bell peppers into the pot(s), leaving a 2-inch space at the top. Pour in tomato juice until peppers are covered. If there is leftover meat mixture, form it into balls and add to tomato juice."
    },
    {
      "position": 5,
      "text": "Cook over low heat, stirring every 20 to 45 minutes, until peppers split at the sides and juice thickens, 2 to 3 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

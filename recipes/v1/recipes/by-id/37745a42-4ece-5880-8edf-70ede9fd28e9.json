  "id": "37745a42-4ece-5880-8edf-70ede9fd28e9",
  "slug": "little-lamb-meatballs-in-a-spicy-eggplant-tomato-sauce",
  "name": "Little Lamb Meatballs in a Spicy Eggplant Tomato Sauce",
  "recipe_type": "dessert",
  "brief_description": "These lamb meatballs are seasoned and simmered in a spicy, sweet eggplant tomato sauce for a flavorful Chef John dish that will impress your family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper or a silicone baking mat."
    },
    {
      "position": 2,
      "text": "Combine eggplant, olive oil, salt, and black pepper in a large skillet over medium-high heat. Cook and stir until eggplant begins to soften, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Mix in 1/3 cup onion and red pepper flakes. Reduce heat to medium; cook and stir until onion is softened, about 4 minutes. Stir in broth and marinara sauce. Reduce heat to medium-low and simmer until sauce mixture has reduced by half, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, whisk together bread crumbs, egg, and Greek yogurt in a large bowl until bread crumbs absorb all the liquid, about 3 minutes. Mix in 1/4 cup onion, garlic, kosher salt, black pepper, cumin, cinnamon, and coriander until well combined. Crumble in lamb and sprinkle with cayenne pepper; mix well."
    },
    {
      "position": 5,
      "text": "Form lamb mixture into small meatballs and transfer to the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned but still pink inside, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Remove meatballs from the oven and stir into simmering sauce. Simmer over low heat until sauce begins to thicken and meatballs are cooked through, 30 to 45 minutes. An instant-read thermometer inserted into the center of a meatball should read 160 degrees F (72 degrees C)."
    },
    {
      "position": 8,
      "text": "Garnish meatballs and sauce with mint to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "f9a39561-4d8f-5c8c-b354-1d5035124497",
  "slug": "eggplant-parmesan-ii",
  "name": "Eggplant Parmesan",
  "recipe_type": "main",
  "brief_description": "This easy eggplant Parmesan has layers of crispy eggplant slices that have been baked instead of fried for a lighter version of the classic Italian dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Dip eggplant slices in beaten egg, then in bread crumbs to coat. Place in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 5 minutes. Flip and bake for 5 more minutes."
    },
    {
      "position": 4,
      "text": "Spread a thin layer of marinara sauce on the bottom of a 9x13-inch baking dish; arrange a layer of eggplant slices on top. Sprinkle with mozzarella and Parmesan cheeses."
    },
    {
      "position": 5,
      "text": "Repeat layers with remaining sauce, eggplant, and cheese, ending with a cheese layer. Sprinkle basil on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 35 minutes."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,

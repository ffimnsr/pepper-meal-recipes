  "id": "cd22d830-fc16-5dbf-aa81-a7b5a9f45153",
  "slug": "peanut-butter-and-jelly-thumbprint-cookies",
  "name": "Peanut Butter and Jelly Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "These easy, nostalgic peanut butter cookies get a scoop of jam in the middle for a kid and adult-pleasing peanut butter and jelly thumbprint cookie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sift flour, baking soda, and salt together in a bowl."
    },
    {
      "position": 2,
      "text": "Beat butter, peanut butter, white sugar, brown sugar, and vanilla together in a separate bowl with an electric mixer until light and fluffy, 1 to 2 minutes. Scrape sides of the bowl with a rubber spatula. Add egg to peanut butter mixture and beat on medium speed until blended. Scrape side of the bowl down again."
    },
    {
      "position": 3,
      "text": "Beat flour mixture into peanut butter mixture on low speed until just blended. Scrape the bowl and mix a few more seconds."
    },
    {
      "position": 4,
      "text": "Scoop dough into 2 tablespoon-sized balls and arrange on a baking sheet. Cover baking sheet and refrigerate at least 4 hours (overnight is ideal)."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper and arrange cookie balls on the paper."
    },
    {
      "position": 6,
      "text": "Bake cookies in the preheated oven until partially cooked, about 11 minutes."
    },
    {
      "position": 7,
      "text": "Place raspberry jam in a bowl and stir until syrupy."
    },
    {
      "position": 8,
      "text": "Make an indentation with a soda bottle cap into the center of each cookie until edges of cookies bulge and begin to crack. Fill each indentation with about 1 teaspoon jam."
    },
    {
      "position": 9,
      "text": "Bake cookies until edges are lightly browned, 7 minutes longer. Cool cookies completely on the baking sheet before transferring to a wire rack."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

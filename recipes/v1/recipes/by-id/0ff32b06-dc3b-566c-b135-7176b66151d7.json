  "id": "0ff32b06-dc3b-566c-b135-7176b66151d7",
  "slug": "spicy-shrimp-and-tomato-scampi",
  "name": "Spicy Shrimp and Tomato Scampi",
  "recipe_type": "main",
  "brief_description": "This spicy, garlicky shrimp and tomato sauce is terrific over pasta. Add more red pepper flakes if you like it extra hot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once the water is boiling, stir in the penne, and return to a boil. Cook the pasta uncovered, stirring occasionally, until the pasta has cooked through, but is still firm to the bite, about 11 minutes. Drain well in a colander set in the sink."
    },
    {
      "position": 2,
      "text": "Heat the olive oil in a skillet over medium heat. Stir in the garlic and onion; cook and stir until the onion has softened and turned translucent, about 5 minutes. Stir in the tomatoes; simmer until heated through, about 5 minutes more. Add the lemon juice and shrimp. Cook and stir until the shrimp are bright pink on the outside and the meat is no longer transparent in the center, about 5 minutes. Stir in the parsley, then season with salt, pepper, and red pepper flakes. Serve shrimp and sauce over prepared penne pasta. Sprinkle with Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

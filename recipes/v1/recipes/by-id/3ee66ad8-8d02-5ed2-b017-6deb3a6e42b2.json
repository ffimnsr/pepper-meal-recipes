  "schema_version": 1,
  "id": "3ee66ad8-8d02-5ed2-b017-6deb3a6e42b2",
  "slug": "roasted-butternut-squash-seeds",
  "name": "Roasted Butternut Squash Seeds",
  "recipe_type": "salad",
  "brief_description": "Next time you roast any type of winter squash like butternut, spaghetti, or acorn, save the seeds instead of tossing them, to make a crispy snack or salad topper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Clean pumpkin seeds so there are no strings or pulp attached to them. Pat dry or let air dry in a strainer."
    },
    {
      "position": 3,
      "text": "Spread seeds in a single layer on the prepared baking sheet. Drizzle seeds lightly with olive oil and stir to coat evenly. Sprinkle lightly with chili powder and sea salt."
    },
    {
      "position": 4,
      "text": "Bake, stirring every 5 minutes, until just slightly golden, about 15 minutes. Remove from oven and allow to cool."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

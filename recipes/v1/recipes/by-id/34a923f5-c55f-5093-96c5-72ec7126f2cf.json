  "id": "34a923f5-c55f-5093-96c5-72ec7126f2cf",
  "slug": "white-fruit-cake",
  "name": "White Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "This fruitcake recipe makes a rich, moist cake packed with golden raisins, candied fruits, and pecans\u2014perfect for gifting or holiday celebrations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Chop raisins, pineapple chunks, and cherries into smaller pieces and transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Add currants, orange peel, and citron peel to the bowl. Pour in orange juice, cover, and soak, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Place a small pan of water on a lower shelf in the oven. Line one 5x9-inch loaf pan and two 3x8-inch loaf pans with parchment paper."
    },
    {
      "position": 4,
      "text": "Beat butter in a large bowl with an electric mixer until creamy. Gradually beat in confectioners' sugar until incorporated."
    },
    {
      "position": 5,
      "text": "Whisk egg yolks in a separate bowl until thick and pale in color. Add to the butter mixture and mix until incorporated. Mix in the soaked fruit and orange juice mixture and pecans. Gradually mix in the sifted flour."
    },
    {
      "position": 6,
      "text": "Beat egg whites in a separate clean bowl using clean beaters until stiff peaks form. Fold egg whites into the batter. Fill each of the prepared loaf pans 2/3 full with batter."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown and a toothpick comes out clean when inserted in the center, 2 to 2 \u00bd hours."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 35,

  "id": "f3d40e6c-78cf-5bfb-9605-1fa1c6455d74",
  "slug": "jian-bing-chinese-crepes",
  "name": "Jian Bing (Chinese Cr\u00eapes)",
  "recipe_type": "appetizer",
  "brief_description": "Jian Bing, a.k.a. Chinese cr\u00eapes are a beloved Chinese street food featuring homemade cr\u00eapes folded around egg, green onions, and a crispy cracker.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk millet flour, soy milk, and vegetable oil together in a bowl to make a batter with the consistency of heavy cream. Add a teaspoon of water to thin the batter, if necessary."
    },
    {
      "position": 2,
      "text": "Mash black bean sauce in a small bowl with 1 teaspoon water to make it easy to spread. Mix hot chili sauce with 1 teaspoon of water in a separate small bowl. Set both sauces aside."
    },
    {
      "position": 3,
      "text": "Spray a large skillet generously with cooking spray, and heat over medium-low heat. Pour batter into the skillet, and spread evenly to make a thin cr\u00eape; cook until firm, about 1 to 2 minutes. Pour egg evenly over cr\u00eape; cook an additional 1 to 2 minutes, until egg is set. Sprinkle cr\u00eape with green onion slices and cilantro leaves, pressing them firmly into cooked egg."
    },
    {
      "position": 4,
      "text": "Flip cr\u00eape and spread with bean sauce and chili sauce. Place crackers in the center of cr\u00eape, leaving about 1/4 inch of space between the two crackers. Flip top third of cr\u00eape down over crackers; flip the bottom third up, and then fold the cr\u00eape in half so the crackers are stacked on top of each other in a tidy package. Serve hot."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b9246624-8772-5ba0-be29-bef754b426e6",
  "slug": "spicy-chicken-burgers-with-mango-salsa-recipe-7971039",
  "name": "Spicy Chicken Burgers With Mango Salsa",
  "recipe_type": "main",
  "brief_description": "These spicy chipotle chicken burgers, With a few simple ingredients, t will be on the grill in no time. Topped with gouda cheese, mayonnaise, lettuce, and mango salsa, they're just the right combination of spicy and cool.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, breadcrumbs, chopped onion, egg, lime zest, cilantro, garlic, and chipotle in a bowl. Shape mixture into four 1/4-pound patties."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir together chopped mangoes and the juice of the lime in a small bowl; set aside."
    },
    {
      "position": 4,
      "text": "Grill chicken burgers on the preheated grill until chicken is no longer pink inside, juices run clear, and burgers show browned grill marks, 5 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "About 2 minutes before burgers are done, place hamburger buns onto the grill to toast, about 1 minute per side. About 1 minute before the burgers are done, top each burger with a slice of Gouda cheese, and let melt."
    },
    {
      "position": 6,
      "text": "Spread each bun with 1 tablespoon mayonnaise and top with 1/4 cup shredded lettuce and grilled chicken burger. Spoon 1/4 of mango-lime mixture on each burger and top with the other half of the bun to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3b59c12d-c21c-5010-80cb-cf397f5eddb0",
  "slug": "campbells-cheesy-chicken-and-rice-casserole",
  "name": "Campbell's Cheesy Chicken and Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken, cheese, and rice casserole is loaded with mixed vegetables for a hearty and flavorsome meal the whole family will enjoy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix vegetables, condensed soup, water, rice, and onion powder together in a 12x8-inch shallow baking dish. Arrange chicken breasts on top; cover."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until chicken is no longer pink and cooked through, about 45 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Top with shredded cheese and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

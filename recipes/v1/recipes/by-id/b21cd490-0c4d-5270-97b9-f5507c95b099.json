{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b21cd490-0c4d-5270-97b9-f5507c95b099",
  "slug": "stuffed-jack-o-lantern-bell-peppers",
  "name": "Stuffed Jack-O'-Lantern Bell Peppers",
  "recipe_type": "main",
  "brief_description": "For these Halloween stuffed peppers, cut faces into stuffed peppers to make cute jack-o'-lanterns for your dinner. Use yellow or orange peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 11x17-inch baking dish."
    },
    {
      "position": 2,
      "text": "Lightly mix together ground beef, egg, bread cubes, onion, tomato, garlic, chili sauce, mustard, Worcestershire sauce, salt, and pepper in a bowl."
    },
    {
      "position": 3,
      "text": "Wash peppers, and cut jack-o'-lantern faces into peppers with a sharp paring knife, making triangle eyes and noses, and pointy-teeth smiles. Slice off tops of peppers, and scoop out seeds and cores. Stuff peppers lightly with beef stuffing, and place them into the prepared baking dish so they lean against each other."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until peppers are tender and the stuffing is cooked through and juicy, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

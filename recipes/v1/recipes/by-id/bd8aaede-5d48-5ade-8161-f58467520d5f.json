  "id": "bd8aaede-5d48-5ade-8161-f58467520d5f",
  "slug": "hot-apple-cider",
  "name": "Homemade Hot Apple Cider",
  "recipe_type": "dessert",
  "brief_description": "This homemade hot apple cider recipe is seasoned with warm spices and sweetened with pure maple syrup for the ultimate treat on a cold winter's day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour apple cider and maple syrup into a large stainless steel saucepan."
    },
    {
      "position": 2,
      "text": "Enclose cinnamon sticks, cloves, allspice berries, orange peel, and lemon peel in a piece of cheesecloth; tie with kitchen twine. Add to the saucepan."
    },
    {
      "position": 3,
      "text": "Cook over medium heat until cider is hot, but not boiling, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat; discard spice bundle."
    },
    {
      "position": 5,
      "text": "Ladle cider into mugs, adding cinnamon sticks to each, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

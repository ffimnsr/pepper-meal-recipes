  "id": "12868d2d-40d8-585b-8995-a44b467eb9fe",
  "slug": "empanadas-de-jamon-queso-y-huevo-duro-ham-cheese-and-hard-boiled-egg-empanadas",
  "name": "Empanadas de Jamon, Queso, y Huevo Duro (Ham, Cheese, and Hard-boiled Egg Empanadas)",
  "recipe_type": "appetizer",
  "brief_description": "Gouda, hard-boiled eggs, and smoked ham empanadas are light and full of flavor, just an easy midweek Mediterranean dinner or finger food.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (180 degrees C). Grease 2 baking sheets with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine ham, Gouda cheese, and hard-boiled eggs in a bowl; mix well."
    },
    {
      "position": 3,
      "text": "Arrange pastry disks on a flat surface; dab a little water around the rims. Place a large tablespoonful of ham and cheese mixture in the center; fold pastry over and press edge with a fork to seal well."
    },
    {
      "position": 4,
      "text": "Place empanadas on the prepared baking sheets. Brush with beaten egg."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, 20 to 25 minutes. Let cool for 5 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

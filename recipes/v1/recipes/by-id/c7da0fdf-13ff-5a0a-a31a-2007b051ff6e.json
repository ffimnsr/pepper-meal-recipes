  "id": "c7da0fdf-13ff-5a0a-a31a-2007b051ff6e",
  "slug": "mashed-potatoes-with-horseradish",
  "name": "Mashed Potatoes with Horseradish",
  "recipe_type": "side",
  "brief_description": "This is a great way to spice up plain old mashed potatoes! This recipe brings butter, sour cream, horseradish and parsley together with potatoes for a delicious side dish.",
  "cuisine": "American German",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain; return potatoes to pot."
    },
    {
      "position": 2,
      "text": "Off heat, mash potatoes with 1 tablespoon butter and black pepper. Stir in sour cream, horseradish, and parsley. Whip potatoes and place in a serving bowl."
    },
    {
      "position": 3,
      "text": "Melt remaining 1 tablespoon butter; pour over potatoes and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

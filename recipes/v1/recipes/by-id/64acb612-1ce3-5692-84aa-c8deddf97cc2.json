  "id": "64acb612-1ce3-5692-84aa-c8deddf97cc2",
  "slug": "quick-and-almost-professional-buttercream-icing",
  "name": "Quick and Almost-Professional Buttercream Icing",
  "recipe_type": "dessert",
  "brief_description": "Our favorite buttercream frosting recipe is creamy and fluffy, can be tinted for any occasion, and is perfect for piping and decorating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Cream butter in the bowl of a stand mixer fitted with the paddle attachment until smooth and fluffy."
    },
    {
      "position": 3,
      "text": "Gradually beat in confectioners' sugar until fully incorporated."
    },
    {
      "position": 4,
      "text": "Beat in vanilla extract."
    },
    {
      "position": 5,
      "text": "Add milk and beat for an additional 3 to 4 minutes, adding more confectioners sugar for a stiffer frosting, if desired."
    },
    {
      "position": 6,
      "text": "Add food coloring, if using, and beat for 30 seconds until smooth or until desired color is reached."
    },
    {
      "position": 7,
      "text": "Use to frost your favorite cakes and cupcakes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

  "id": "e2befb36-ac8e-5250-ac1d-09f99ad8a4d7",
  "slug": "birds-nests-iv",
  "name": "Birds' Nest Cookies",
  "recipe_type": "dessert",
  "brief_description": "These birds' nest cookies are cute pecan thumbprint cookies that melt in your mouth! Delicious plain or filled with creamy frosting and Easter candy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Beat 1 cup softened butter and \u00bd cup sugar together in a large bowl with an electric mixer until smooth. Add egg yolks, and beat well. Add flour and mix until combined."
    },
    {
      "position": 3,
      "text": "Roll dough into walnut-size balls; roll balls in egg white, and then in the chopped nuts. Place cookies 2 inches apart onto prepared cookie sheets; press center of cookie with thumb."
    },
    {
      "position": 4,
      "text": "Bake cookies in the preheated oven for 8 minutes; press center of cookie again and continue to bake until lightly browned, 4 to 6 minutes. Cool cookies on racks."
    },
    {
      "position": 5,
      "text": "To make the frosting: Blend water, shortening, vanilla, and 1/4 cup softened butter together; slowly add confectioners' sugar and mix until smooth and creamy. More water may be needed to make desired consistency."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,

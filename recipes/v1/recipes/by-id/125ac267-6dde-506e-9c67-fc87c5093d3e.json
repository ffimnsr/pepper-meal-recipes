  "id": "125ac267-6dde-506e-9c67-fc87c5093d3e",
  "slug": "bread-machine-calzone",
  "name": "Bread Machine Calzone",
  "recipe_type": "main",
  "brief_description": "The calzone dough is prepared in a bread machine and then stuffed with Italian sausage, pizza sauce, and mozzarella cheese and baked until golden brown.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "To make dough, place water, yeast, sugar, flour, salt, and powdered milk in the pan of the bread machine, in the order suggested by the manufacturer. Select Dough cycle. After cycle is completed, roll out dough on a lightly floured surface."
    },
    {
      "position": 2,
      "text": "Meanwhile, brown sausage for about 8 to 10 minutes in a large skillet over medium heat. Drain excess fat and reserve."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Shape dough into a 16x10-inch rectangle. Transfer to a lightly greased cookie sheet and spoon pizza sauce lengthwise down the center of dough, followed by browned sausage and cheese. Make diagonal cuts 1 1/2-inches apart down each long side of dough rectangle, cutting to within 1/2-inch of filling. Criss-cross cut strips of dough over filling and seal edges with water. Brush top of calzone with melted butter."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 45 minutes, or until golden brown. Remove from oven and cool for 5 minutes, then slice and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "d5232530-c205-591a-9280-d94855b32122",
  "slug": "instant-pot-buckwheat-minestra",
  "name": "Instant Pot Buckwheat Minestra",
  "recipe_type": "soup",
  "brief_description": "Showcase your favorite seasonal vegetables in this no-fail Instant Pot vegetable soup made hearty with buckwheat and lentils.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Add oil. Cook and stir carrots, onion, bell pepper, celery, parsley, and garlic until vegetables are fragrant and onion is translucent, about 8 minutes. Turn off Saute function."
    },
    {
      "position": 2,
      "text": "Add buckwheat and lentils; mix to coat with the oil and vegetables. Add potatoes, zucchini, and green beans. Pour in broth; stir to mix. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Open lid and stir in hummus and sambal oelek. Season with salt and pepper. Divide soup among 8 bowls. Top each with 1/2 tablespoon nutritional yeast. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

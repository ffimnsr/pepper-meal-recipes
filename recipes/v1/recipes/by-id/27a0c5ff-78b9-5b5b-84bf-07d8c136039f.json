  "id": "27a0c5ff-78b9-5b5b-84bf-07d8c136039f",
  "slug": "perfect-pumpkin-spice-waffles",
  "name": "Perfect Pumpkin Spice Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Autumn is pumpkin-spice season, and pumpkin spice waffles are a great way to join in when you have cinnamon, ginger, and cloves in your batter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a glass or metal bowl until soft peaks form. Lift your beater or whisk straight up: egg whites will form soft mounds rather than a sharp peak."
    },
    {
      "position": 3,
      "text": "Beat egg yolks, buttermilk, pumpkin, and butter together with a whisk in a large bowl until smooth; add flour, brown sugar, baking powder, cinnamon, baking soda, ginger, salt, and cloves. Stir mixture with the whisk just until you have a smooth batter."
    },
    {
      "position": 4,
      "text": "Fold egg whites into batter just until combined."
    },
    {
      "position": 5,
      "text": "Prepare cooking surfaces of your waffle iron with cooking spray. Ladle about 2/3 cup batter into the prepared iron and cook until browned, 4 to 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

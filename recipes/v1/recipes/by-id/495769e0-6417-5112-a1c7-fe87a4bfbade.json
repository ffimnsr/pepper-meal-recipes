  "id": "495769e0-6417-5112-a1c7-fe87a4bfbade",
  "slug": "pork-and-shrimp-pancit",
  "name": "Pork and Shrimp Pancit",
  "recipe_type": "main",
  "brief_description": "This pork and shrimp pancit is a standard Filipino pancit with rice noodles, bok choy, onion, garlic, ginger, oyster sauce, and red pepper flakes.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Soak rice noodles in warm water in a bowl for 20 minutes; drain."
    },
    {
      "position": 2,
      "text": "Heat 3 tablespoons oil in a wok or large heavy skillet over medium-high heat. Saut\u00e9 noodles for 1 minute; transfer to a serving dish. Keep warm. Add remaining 2 tablespoons oil to wok; saut\u00e9 shrimp, pork, onion, garlic, and ginger for 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in bok choy, chicken broth, and oyster sauce; season with pepper flakes. Cover; cook until bok choy is wilted, about 1 minute. Serve over noodles; garnish with green onion."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

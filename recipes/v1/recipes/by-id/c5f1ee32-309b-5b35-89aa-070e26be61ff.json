  "id": "c5f1ee32-309b-5b35-89aa-070e26be61ff",
  "slug": "black-pepper-gravy",
  "name": "Black Pepper Gravy",
  "recipe_type": "side",
  "brief_description": "This vegetarian pepper gravy is creamy and sharp yet simple at the same time thanks to milk, margarine, flour, and lots of ground black pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour milk into a microwave-safe container and heat in a microwave oven until warm, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Melt margarine in a saucepan over medium heat. Whisk in flour and continue cooking until the mixture bubbles, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour milk into the saucepan slowly while whisking. Cook and whisk until the mixture begins to thicken, about 3 minutes. Add pepper and salt. Continue whisking until the gravy comes to a boil, about 3 minutes more. Remove from heat."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

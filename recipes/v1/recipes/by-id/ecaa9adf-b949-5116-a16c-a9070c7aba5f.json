  "id": "ecaa9adf-b949-5116-a16c-a9070c7aba5f",
  "slug": "chicken-nachos-with-refried-beans",
  "name": "Chicken Nachos with Refried Beans",
  "recipe_type": "appetizer",
  "brief_description": "Nachos are upgraded with refried beans, chicken, jalape\u00f1os, and Cheddar cheese in this recipe for the party and potluck favorite that's a breeze to prepare.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a large rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Arrange tortilla chips on the prepared baking sheet. Spread refried beans over chips; layer on chicken and jalape\u00f1os. Top with Cheddar cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, about 6 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

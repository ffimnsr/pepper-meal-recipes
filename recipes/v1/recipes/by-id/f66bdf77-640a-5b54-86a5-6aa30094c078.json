  "id": "f66bdf77-640a-5b54-86a5-6aa30094c078",
  "slug": "alitas-tomato-beef-stew",
  "name": "Alita's Tomato Beef Stew",
  "recipe_type": "soup",
  "brief_description": "Tomato-based beef stew with plenty of carrots, potatoes, and mushrooms is a filling meal that everyone in the family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, salt, and pepper in a resealable bag; add stew meat and shake until meat is coated."
    },
    {
      "position": 2,
      "text": "Heat oil in a Dutch oven or large heavy-bottomed pot over medium heat. Add coated meat and loose flour from the bag to the hot oil; cook and stir until browned on all sides, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix tomatoes, onions, tomato sauce, water, Worcestershire sauce, garlic, paprika, sugar, and bay leaves into stew meat mixture; bring to a boil. Reduce heat to low and simmer stew, scraping bottom of Dutch oven every 30 minutes, about 1 hour."
    },
    {
      "position": 4,
      "text": "Stir carrots into stew and cook for 30 minutes more. Add potatoes to stew and cook until potatoes are tender, about 30 minutes. Add mushrooms to stew and cook until tender, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 140,
  "preparation_time_minutes": 20,

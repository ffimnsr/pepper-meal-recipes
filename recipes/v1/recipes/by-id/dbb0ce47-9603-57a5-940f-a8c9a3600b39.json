  "id": "dbb0ce47-9603-57a5-940f-a8c9a3600b39",
  "slug": "oven-roasted-red-potatoes-and-asparagus",
  "name": "Oven Roasted Red Potatoes and Asparagus",
  "recipe_type": "side",
  "brief_description": "Roasted potatoes and asparagus are seasoned with garlic, rosemary, and thyme. An easy and delicious casserole, it can be served hot or cold.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss potatoes with 1 tablespoon oil, garlic, rosemary, thyme, and 1 teaspoon salt in a large baking dish. Cover with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 4,
      "text": "Mix in asparagus, remaining 1 tablespoon oil, and remaining 1 teaspoon salt. Cover and continue to cook until potatoes are tender, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Increase oven temperature to 450 degrees F (230 degrees C). Remove foil and cook until potatoes are lightly browned, 5 to 10 more minutes. Season with pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

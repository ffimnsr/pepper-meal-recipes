  "id": "ff6f6ace-95be-5943-8bf9-bbe9f954c7a3",
  "slug": "slow-cooker-brisket-tacos-recipe-11696165",
  "name": "Slow Cooker Brisket Tacos",
  "recipe_type": "main",
  "brief_description": "The beef in these slow cooker brisket tacos comes out super tender and flavorful. Tomato, onion, pepper, and spices add warmth and depth to the meat and you can then dress up your tacos any way you like.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together 2 cups beef broth, enchilada sauce, and tomato paste in a 6-quart slow cooker. Stir in garlic, thyme, bay leaf, chili powder, onion powder, garlic powder, cumin, and salt."
    },
    {
      "position": 3,
      "text": "Place half of the onions and peppers in the slow cooker and set brisket on top, fat side up. Sprinkle remaining onions and peppers over the top. If meat isn\u2019t submerged in the cooking liquid, add enough beef broth to just cover the meat."
    },
    {
      "position": 4,
      "text": "Cover and cook until meat is fully cooked and shreds easily, 8 to 10 hours on Low or 4 to 5 hours on High."
    },
    {
      "position": 5,
      "text": "Transfer brisket to a large rimmed baking sheet. Using a slotted spoon, remove onions and peppers from the cooking liquid and set aside in a bowl."
    },
    {
      "position": 6,
      "text": "Skim fat from the cooking liquid and reserve cooking liquid to moisten the meat."
    },
    {
      "position": 7,
      "text": "Cut brisket into 2 to 3-inch chunks, then use 2 forks to shred meat."
    },
    {
      "position": 8,
      "text": "Combine shredded meat, cooked onions and peppers, lime juice, and enough cooking liquid to moisten meat in a serving bowl."
    },
    {
      "position": 9,
      "text": "Serve meat in tortillas with desired toppings."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 255,

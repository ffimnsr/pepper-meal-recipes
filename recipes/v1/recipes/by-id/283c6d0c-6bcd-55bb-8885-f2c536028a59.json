  "slug": "microwave-corn-on-the-cob-in-the-husk",
  "name": "Microwave Corn on the Cob in the Husk",
  "recipe_type": "dessert",
  "brief_description": "Cook corn in the husk with this easy microwave recipe that requires just a couple of paper towels for sweet, crunchy corn on the cob every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse corn in the husk under water briefly. Wrap with a paper towel and place on a microwave-safe plate."
    },
    {
      "position": 2,
      "text": "Cook corn in the microwave until hot and cooked through, 3 to 5 minutes. Remove from the microwave and let rest for 2 minutes. Remove corn husk."
    }
  ],

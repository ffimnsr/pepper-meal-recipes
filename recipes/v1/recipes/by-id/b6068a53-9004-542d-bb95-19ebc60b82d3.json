  "schema_version": 1,
  "id": "b6068a53-9004-542d-bb95-19ebc60b82d3",
  "slug": "fig-cake-i",
  "name": "Glazed Fig Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist fig cake is studded with pecans, flavored with a trio of warm spices, and topped with a sweet, decadent glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 9x13-inch dish."
    },
    {
      "position": 2,
      "text": "Make the cake: Mix flour, cinnamon, cloves, nutmeg, baking soda, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Cream sugar and butter in a large bowl with an electric mixer until light and fluffy. Stir in eggs. Beat in flour mixture alternately with buttermilk, mixing just until incorporated. Fold in figs and pecans. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour. Remove from the oven and let cool, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, make the glaze: Combine butter, sugar, evaporated milk, and baking soda in a large saucepan. Bring to a boil, stirring until sugar is dissolved. Continue to cook, without stirring, until the mixture turns brown and measures 240 degrees F (115 degrees C); a small amount of syrup dropped into cold water should form a soft ball that flattens when removed from the water and placed onto a flat surface."
    },
    {
      "position": 6,
      "text": "Pour into a small bowl and beat until it thickens to a spreading consistency. Quickly spread icing onto the cooled cake."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

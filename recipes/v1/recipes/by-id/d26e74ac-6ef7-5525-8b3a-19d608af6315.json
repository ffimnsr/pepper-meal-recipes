  "id": "d26e74ac-6ef7-5525-8b3a-19d608af6315",
  "slug": "quiche-lorraine-ii",
  "name": "Simple Quiche Lorraine",
  "recipe_type": "breakfast",
  "brief_description": "Make this easy quiche Lorraine featuring eggs, bacon, onion, and Swiss cheese baked in a store-bought crust, and serve it for any meal of the day!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pie pastry into a 9-inch pie pan; line with a double layer of aluminum foil and a layer of pie weights or dried beans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden on the edges, about 8 minutes. Carefully remove the foil and weights; continue baking until crust is set and dry, about 5 minutes more. Remove from the oven and reduce the temperature to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "While the crust is baking, cook bacon in a large skillet over medium-high heat until crisp, about 10 minutes. Transfer to a paper towel-lined plate and crumble when cool enough to handle. Drain all but 2 tablespoons drippings from the skillet."
    },
    {
      "position": 5,
      "text": "Add onion to drippings in the skillet; cook and stir over medium heat until tender, about 5 minutes. Use a slotted spoon and transfer to a bowl."
    },
    {
      "position": 6,
      "text": "Toss Swiss cheese and flour together in a small bowl. Whisk milk, eggs, and salt together in a large bowl, then stir in bacon and onion."
    },
    {
      "position": 7,
      "text": "Mix in cheese mixture until well combined, then pour into pie crust."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 35 to 40 minutes. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

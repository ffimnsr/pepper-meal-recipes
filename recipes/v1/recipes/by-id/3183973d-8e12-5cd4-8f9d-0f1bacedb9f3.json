  "id": "3183973d-8e12-5cd4-8f9d-0f1bacedb9f3",
  "slug": "spinach-frittata",
  "name": "Spinach Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This spinach frittata recipe is filled with spinach, ham, bell pepper, onion, and cheese for a delicious, quick brunch option made easy in a skillet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium heat. Add red pepper and onion. Cook and stir until tender, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Beat eggs and milk together in a bowl until smooth; add spinach, ham, mozzarella cheese, feta cheese, salt, and black pepper. Gently stir to mix evenly; pour into the skillet."
    },
    {
      "position": 3,
      "text": "Place a cover on the skillet and cook until the egg mixture is completely set in the center, 7 to 10 minutes. Cut into wedges to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

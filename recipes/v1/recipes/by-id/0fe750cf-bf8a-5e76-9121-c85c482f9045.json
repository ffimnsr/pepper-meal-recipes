  "id": "0fe750cf-bf8a-5e76-9121-c85c482f9045",
  "slug": "pumpkin-pancakes",
  "name": "Pumpkin Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin pancake recipe, spiced with ginger, cinnamon, and allspice, and made with fresh or canned pumpkin, is perfect for a cozy fall breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk milk, pumpkin, egg, oil, and vinegar together in a large bowl until well combined."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, baking soda, allspice, cinnamon, ginger, and salt together in a medium bowl. Whisk into pumpkin mixture until no dry streaks remain."
    },
    {
      "position": 3,
      "text": "Spray a griddle or skillet with cooking spray; heat over medium-high heat. Pour 3 to 4 tablespoons batter for each pancake onto the griddle; flatten slightly."
    },
    {
      "position": 4,
      "text": "Cook until small bubbles form on surface, and edges look set, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Flip and cook until golden, about 2 minutes more. Repeat with remaining batter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

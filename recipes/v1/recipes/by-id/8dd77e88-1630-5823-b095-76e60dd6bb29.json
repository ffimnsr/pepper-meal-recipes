{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8dd77e88-1630-5823-b095-76e60dd6bb29",
  "slug": "habanero-pepper-jelly",
  "name": "Habanero Pepper Jelly",
  "recipe_type": "side",
  "brief_description": "This habanero pepper jelly recipe with grated carrots packs some real heat, making it a fiery accompaniment to meat, fish, sandwiches, or cheeseboard.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect 8 (half-pint) jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until jelly is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 2,
      "text": "Combine sugar and vinegar in a saucepan over medium-high heat; cook and stir until sugar is dissolved. Stir in carrot and bell pepper; bring to a boil. Reduce heat to medium; simmer, 5 minutes. Stir in habaneros; simmer 5 minutes more. Stir in pectin; boil for 1 minute, stirring constantly. Skim and discard any foam from jelly."
    },
    {
      "position": 3,
      "text": "Pack jelly into hot, sterilized jars, filling to within \u00bc inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 4,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 5 minutes."
    },
    {
      "position": 5,
      "text": "Remove jars from the stockpot and place onto a cloth-covered or wood surface, several inches apart, until cool, 4 to 24 hours. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

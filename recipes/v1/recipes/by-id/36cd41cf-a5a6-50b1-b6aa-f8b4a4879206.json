  "id": "36cd41cf-a5a6-50b1-b6aa-f8b4a4879206",
  "slug": "mexican-style-mackerel-recipe-11985019",
  "name": "Mexican-Style Mackerel",
  "recipe_type": "dessert",
  "brief_description": "Mexican-style mackerel combines smoky, tomato-packed tinned fish with Spanish rice, black beans, sweet potatoes, and jalape\u00f1o for a quick one-skillet meal. Finished with fresh lime, cilantro, and a splash of hot sauce, this quick pantry-friendly dinner delivers vibrant flavor with minimal effort.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep skillet over medium heat. Add onions and cook for 1 minute. Add sweet potatoes and salt and cook until lightly browned and beginning to soften, 3 to 4 minutes. Add bell pepper and cook, stirring often, until softened, about 2 minutes. Add jalape\u00f1o and rice and cook until rice begins to toast, stirring occasionally, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Add water and stir, using a wooden spoon to scrape up any bits from the bottom. Add mackerel with sauce and slightly break up the fish into bite size pieces. Stir in beans and cook until heated through, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle with lime juice and cilantro and serve with hot sauce if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "37b0c36c-2604-52da-92f8-921b129b3de8",
  "slug": "easy-tortilla-pizza",
  "name": "Easy Tortilla Pizza",
  "recipe_type": "snack",
  "brief_description": "This tortilla pizza topped with chicken, bell pepper, and cheese makes a quick dinner for one. Quadruple the recipe for a crowd-pleasing party snack!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (205 degrees C)."
    },
    {
      "position": 2,
      "text": "Place tortilla on a baking sheet; brush with olive oil and sprinkle with garlic powder, salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Spread tomato sauce on top; arrange chicken breast, bell pepper, and green onions over tomato sauce. Sprinkle with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes. Sprinkle oregano over top; slice into wedges using a pizza cutter."
    },
    {
      "position": 6,
      "text": "Enjoy."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,

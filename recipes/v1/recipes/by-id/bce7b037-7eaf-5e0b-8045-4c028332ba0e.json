  "id": "bce7b037-7eaf-5e0b-8045-4c028332ba0e",
  "slug": "strawberry-frozen-pie",
  "name": "Frozen Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "Frozen strawberry pie is easy to make with strawberries, cream cheese, and condensed milk in a graham cracker crust, frozen for a delicious dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat sweetened condensed milk and cream cheese together in a bowl until smooth; add whipped topping and stir until smooth. Fold strawberries into whipped topping mixture; divide between pie crusts."
    },
    {
      "position": 2,
      "text": "Freeze pies until solid, 2 to 3 hours."
    }
  ],

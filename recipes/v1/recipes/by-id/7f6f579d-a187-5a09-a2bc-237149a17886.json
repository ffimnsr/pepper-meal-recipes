  "id": "7f6f579d-a187-5a09-a2bc-237149a17886",
  "slug": "fried-peach-cobbler-rolls-recipe-11965744",
  "name": "Fried Peach Cobbler Rolls",
  "recipe_type": "dessert",
  "brief_description": "For these fried peach cobbler rolls, peach pie filling and cream cheese are wrapped into an egg roll wrapper, then deep fried and sprinkled with cinnamon sugar for an incredible treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place one egg roll wrapper onto a clean surface. Using your finger, moisten the edges with water. Place 1 to 2 spoonfuls peach pie filling in the center of the wrap. Place a 1/2-inch slice of cream cheese on top of pie filling and roll up the wrap like a traditional egg roll. Continue with remaining ingredients. Place egg rolls onto a plate and refrigerate until ready to cook."
    },
    {
      "position": 2,
      "text": "Combine sugar and cinnamon in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, fill a deep skillet or Dutch oven halfway with vegetable oil. Heat oil to 375 degrees F (190 degrees C). Line a baking sheet with paper towel."
    },
    {
      "position": 4,
      "text": "Fry rolls, 3 to 4 at a time, in the hot oil, turning them over until golden brown on all sides. Place rolls onto prepared baking sheet. Sprinkle with cinnamon sugar while still warm. Serve immediately."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

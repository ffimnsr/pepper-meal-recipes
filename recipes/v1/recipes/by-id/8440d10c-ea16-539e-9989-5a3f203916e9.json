{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8440d10c-ea16-539e-9989-5a3f203916e9",
  "slug": "chef-johns-pate-de-campagne",
  "name": "Chef John's Pate de Campagne",
  "recipe_type": "appetizer",
  "brief_description": "Pork, duck, chicken livers, and bacon combine in this impressive pate de campagne that is a fun and delicious project for charcuterie lovers.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cloves, nutmeg, ginger, and cayenne pepper in a small bowl to make spice mixture."
    },
    {
      "position": 2,
      "text": "Place pork shoulder, duck meat, chopped bacon, chicken livers, onion, shallot, parsley, cognac, salt, garlic, pepper, 3/4 teaspoon spice mixture, and pink curing salt in a large bowl. Mix thoroughly until evenly distributed. Cover with plastic wrap and refrigerate about 2 hours."
    },
    {
      "position": 3,
      "text": "Whisk cream, bread crumbs, and eggs together in a bowl."
    },
    {
      "position": 4,
      "text": "Transfer pork mixture to a rimmed baking sheet lined with a silicone mat or parchment. Freeze for 15 to 20 minutes to facilitate grinding the meat."
    },
    {
      "position": 5,
      "text": "Grind pork mixture into a bowl using the meat-grinder attachment of a stand mixer. Add dried cherries and pistachios. Add the cream mixture; fold gently until just combined."
    },
    {
      "position": 6,
      "text": "Arrange bacon strips crosswise in a 9x5-inch loaf pan, letting ends hang over the edges of the pan. Trim some strips to fit the ends of the pan."
    },
    {
      "position": 7,
      "text": "Fill pan to the top with the ground pork mixture; smooth the top. Cover surface with strips of bacon. Fold side bacon piece edges over the top. Cover with a piece of parchment cut to fit the top of the pan; wrap tightly with heavy duty aluminum foil."
    },
    {
      "position": 8,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 9,
      "text": "Transfer pan to a deep pot or Dutch oven. Pour in hot tap water to reach 1/2 to 2/3 of the way up the side of the pan. Cover."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center reads 155 degrees F (68 degrees C), 1 3/4 to 2 hours."
    },
    {
      "position": 11,
      "text": "Transfer pan to a paper-towel lined surface to absorb any moisture. If mixture has risen above the top edge of the pan, press it down with a heavy pan. Remove the aluminum foil, leaving the parchment paper on top. Transfer pan to a paper-towel-lined baking dish. Cut a piece of cardboard to be slightly smaller than the top of the pan. Wrap with aluminum foil and place on the parchment paper. Press down with weights like canned food."
    },
    {
      "position": 12,
      "text": "Refrigerate at least 8 hours to chill and compress the pate."
    },
    {
      "position": 13,
      "text": "To unmold the pate, pour very hot water into a large bowl. Dip mold into hot water for 1 to 2 seconds. Turn out onto a paper-towel-lined dish; chill again before slicing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 105,

  "id": "e2f1ab12-0811-565f-84c2-dce27934e31f",
  "slug": "baked-pork-chops-with-cream-of-mushroom-soup",
  "name": "Baked Pork Chops with Cream of Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "These baked pork chops with cream of mushroom soup are made in the oven with just 5 ingredients for an easy weeknight meal the whole family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Place onion slices on the bottom of a glass baking dish. Lay pork chops over onions. Cover chops evenly with condensed soup."
    },
    {
      "position": 3,
      "text": "Add water and bouillon, breaking up the bouillon cubes to spread flavor. Cover the baking dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake pork chops in the preheated oven, stirring gravy once or twice, until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center of a chop should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

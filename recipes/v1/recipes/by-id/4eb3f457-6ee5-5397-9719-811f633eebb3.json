  "id": "4eb3f457-6ee5-5397-9719-811f633eebb3",
  "slug": "banana-peach-bread",
  "name": "Banana Peach Bread",
  "recipe_type": "breakfast",
  "brief_description": "This tender banana peach bread recipe is made with pur\u00e9ed fruit and a secret ingredient, hot chocolate mix, for a new take on a standard banana loaf.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Beat white sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in brown sugar and hot chocolate mix."
    },
    {
      "position": 3,
      "text": "Place bananas, peach, eggs, milk, and vanilla extract in a blender; blend until smooth. Stir pur\u00e9ed mixture into butter mixture until well incorporated."
    },
    {
      "position": 4,
      "text": "Whisk flour, walnuts, baking soda, and salt together in a separate bowl until evenly combined; stir into banana-butter mixture until just moistened. Pour batter into the prepared loaf pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 60 minutes. Cool in the pan for 5 minutes, then transfer bread to a wire rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

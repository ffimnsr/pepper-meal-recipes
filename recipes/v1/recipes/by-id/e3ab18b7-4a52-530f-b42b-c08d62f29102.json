{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e3ab18b7-4a52-530f-b42b-c08d62f29102",
  "slug": "zucchini-relish-with-sweet-peppers",
  "name": "Zucchini Relish with Sweet Peppers",
  "recipe_type": "dessert",
  "brief_description": "Sweet yellow and red bell peppers add color to this zucchini relish recipe with cider vinegar. It's better than any you\u2019ll find at the grocery store.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss zucchini, onion, and bell peppers with kosher salt in a large bowl until well combined; set aside for 8 hours."
    },
    {
      "position": 2,
      "text": "Thoroughly rinse and drain zucchini mixture; transfer to a large pot; stir in sugar, vinegar, cornstarch, celery seeds, and turmeric. Cook over medium heat until thickened, about 50 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, inspect 6 pint-sized jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until relish is ready, at least 5 minutes. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 4,
      "text": "Pack relish into hot, sterilized jars, filling to within \u00bc inch of tops. Run a clean knife or a thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 5,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into boiling water using a holder. Pour in more boiling water to cover the jars by at least 1 inch. Bring to a rolling boil, cover, and process for 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove jars from the stockpot; rest on a wood or cloth-covered surface, several inches apart, until cool. Press centers lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 96,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 35,

  "id": "18a075af-8e7d-5206-8ad4-c0955e27fae4",
  "slug": "antipasto",
  "name": "Antipasto",
  "recipe_type": "appetizer",
  "brief_description": "This recipe makes a huge amount. I can it and give it away as Christmas gifts. We usually make this as a group project to cut down on prep time and cost. The ingredient amounts may be altered proportionally as needed.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl with enough lightly salted water to cover, place the cauliflower, pearl onions, red bell peppers, green bell peppers, celery and cucumbers. Soak 8 to 12 hours, or overnight."
    },
    {
      "position": 2,
      "text": "In a small bowl with enough lightly salted water to cover, place the carrots. Soak 8 to 12 hours, or overnight."
    },
    {
      "position": 3,
      "text": "In a large saucepan, place the vegetable oil, vinegar, tomato paste and pickling spice. Bring the mixture to a boil. Drain and rinse the carrots, and place them in the mixture. Boil 10 minutes."
    },
    {
      "position": 4,
      "text": "Drain and rinse the vegetables in the cauliflower mixture. Place them into the saucepan. Cook 10 minutes, or until the cauliflower is tender but crisp."
    },
    {
      "position": 5,
      "text": "Stir black olives, green olives, mushrooms and tuna into the mixture. Remove the mixture from heat. Discard the wrapped pickling spice. While still hot, transfer to sterile containers and refrigerate."
    }
  ],
  "servings": 56,
  "cooking_time_minutes": 30,

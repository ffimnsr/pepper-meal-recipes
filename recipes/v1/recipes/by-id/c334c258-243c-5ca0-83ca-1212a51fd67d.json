  "id": "c334c258-243c-5ca0-83ca-1212a51fd67d",
  "slug": "brown-sugar-banana-bread",
  "name": "Brown Sugar Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "This brown sugar banana bread is super soft, moist, and packed with rich, deep flavor thanks to lots of ripe, sweet bananas, butter, and cinnamon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Place bananas into a large resealable plastic bag; seal the bag and smoosh bananas with your fingers until well mashed. Set aside."
    },
    {
      "position": 3,
      "text": "Mix together brown sugar and butter in a large bowl with an electric mixer on medium speed until light and fluffy, 1 to 2 minutes. Cut a corner from the plastic bag; squeeze mashed bananas into brown sugar mixture in the bowl. Add egg, milk, cinnamon, and vanilla; beat on medium speed until well combined. Mix in flour, baking powder, baking soda, and kosher salt on low speed just until smooth, about 1 minute. Spread into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned on top and a toothpick inserted into the center comes out clean, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

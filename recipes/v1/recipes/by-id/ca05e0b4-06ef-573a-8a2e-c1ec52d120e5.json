  "id": "ca05e0b4-06ef-573a-8a2e-c1ec52d120e5",
  "slug": "cheesy-chicken-pickle-smashed-tacos-recipe-11905529",
  "name": "Cheesy Chicken Pickle Smashed Tacos",
  "recipe_type": "main",
  "brief_description": "These cheesy chicken pickle smashed tacos, a snap to make and dressed with a quick pickle sauce, are tangy, savory, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, garlic powder, onion powder, smoked paprika, salt, and pepper in a bowl. Mix just until combined."
    },
    {
      "position": 2,
      "text": "Divide chicken mixture into 6 equal portions. Press a thin, even layer of chicken directly onto 1 side of each tortilla, spreading to the edges."
    },
    {
      "position": 3,
      "text": "Heat a large skillet or cast-iron pan over medium heat and grease lightly. Place tortillas, chicken side down, in the pan and cook for 3 to 4 minutes, pressing gently, until chicken is fully cooked and getting crispy."
    },
    {
      "position": 4,
      "text": "Flip tortillas so the chicken side is facing up. Arrange pickle chips in a single layer over chicken, then sprinkle evenly with shredded cheese."
    },
    {
      "position": 5,
      "text": "Cook until tortilla is golden and the cheese is fully melted, 1 to 2 more minutes."
    },
    {
      "position": 6,
      "text": "For pickle sauce, mix sour cream, mayonnaise, pickle brine, mustard, and dill together in a small bowl until smooth."
    },
    {
      "position": 7,
      "text": "Top each taco top off with more chopped pickles. Drizzle generously with pickle sauce, fold, and serve immediately. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

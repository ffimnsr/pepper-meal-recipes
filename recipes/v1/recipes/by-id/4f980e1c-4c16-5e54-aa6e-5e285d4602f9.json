  "schema_version": 1,
  "id": "4f980e1c-4c16-5e54-aa6e-5e285d4602f9",
  "slug": "cheesy-garlic-butter-rolls-recipe-11826148",
  "name": "Cheesy Garlic Butter Rolls\u2014No Rise!",
  "recipe_type": "appetizer",
  "brief_description": "These cheesy garlic butter rolls begin with refrigerated crescent roll sheets, so there's no rise time. Filled with garlic butter, Colby Jack cheese, and creamy mozzarella, they bake up tall and golden, and are ready in 45 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x9-inch baking dish or a sheet pan."
    },
    {
      "position": 2,
      "text": "Combine 1/4 cup butter, garlic, and parsley in a small bowl to form a smooth paste."
    },
    {
      "position": 3,
      "text": "Roll one sheet of crescent dough out onto the counter. Spread half of the garlic butter mixture evenly on dough. Sprinkle half of the Colby-Jack and half of the mozzarella cheese evenly over buttered dough."
    },
    {
      "position": 4,
      "text": "With the long edge of the dough facing you, use a pizza cutter to cut the sheet crosswise into 8 even strips. Starting at one short end, roll each strip up into a pinwheel and place in the prepared baking dish (touching for soft sides) or 2 inches apart on the baking sheet for crisp edges."
    },
    {
      "position": 5,
      "text": "Repeat with second sheet of dough, using remaining garlic butter and cheese."
    },
    {
      "position": 6,
      "text": "Bake until golden and puffed, 35 to 40 minutes for a baking dish, or 13 to 15 minutes for a baking sheet."
    },
    {
      "position": 7,
      "text": "Melt the remaining \u00bc cup butter and brush it over the warm rolls for a glossy finish. Serve warm."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

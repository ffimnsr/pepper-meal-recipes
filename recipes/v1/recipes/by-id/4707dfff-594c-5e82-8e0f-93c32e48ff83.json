  "id": "4707dfff-594c-5e82-8e0f-93c32e48ff83",
  "slug": "veggie-stroganoff",
  "name": "Veggie Stroganoff",
  "recipe_type": "main",
  "brief_description": "The elements of classic Stroganoff - beefy flavour, mushrooms and creamy sauce, served on a bed of noodles - appear in this veggie recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large non-stick skillet, heat 1 tablespoon (15 mL) of the oil over medium heat. Add onion; cook for 6 minutes, stirring occasionally, until soft. Add garlic and mushrooms; cook for 2 minutes, stirring often."
    },
    {
      "position": 2,
      "text": "Stir in the Beef Veggie Tenders; cook for 1 minute. Remove everything to a large plate."
    },
    {
      "position": 3,
      "text": "Add remaining 2 tablespoons (25 mL) oil to the skillet. Stir in flour; cook for about 2 minutes, stirring, until lightly browned."
    },
    {
      "position": 4,
      "text": "Stir in broth, Dijon, thyme and seasoning salt. Cook for 2 minutes, until thickened. Return mixture to skillet. Cover and simmer over low heat for 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in yogurt; warm through. Sprinkle top with parsley. Serve over hot cooked noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 10,

  "id": "7723960f-8df3-559a-9ba0-68da586d2e39",
  "slug": "french-onion-soup-vi",
  "name": "French Onion Soup VI",
  "recipe_type": "soup",
  "brief_description": "Beef rib bones form the stock for this onion soup seasoned with soy-based seasoning and topped with a garlic, paprika crouton and shredded mozzarella.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef ribs in a large stock pot over medium heat. Brown on all sides. Cover with water and bring to a boil, then cover, reduce heat and simmer 1 hour."
    },
    {
      "position": 2,
      "text": "Remove meat and bones to a cutting board to cool. Introduce onions, beef broth and salt to the rib water. Bring to a boil, then reduce heat and simmer 1 hour."
    },
    {
      "position": 3,
      "text": "When the bones are cool enough to handle, remove the meat with a knife. Finely chop the meat and add to the soup."
    },
    {
      "position": 4,
      "text": "After an hour of simmering, season the soup with the liquid seasoning and salt and pepper to taste. Simmer 30 minutes more."
    },
    {
      "position": 5,
      "text": "Preheat oven broiler."
    },
    {
      "position": 6,
      "text": "Cut French bread in slices that will fit in your serving bowls. Place slices on a baking sheet and brush with melted butter. Sprinkle with garlic powder and paprika. Place under preheated broiler until browned, 2 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Ladle soup into 6 ovenproof serving bowls. Lay one crouton over each serving. Top with mozzarella. Place bowls on a sturdy baking sheet and place under broiler to melt cheese, 1 minutes. Serve at once."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 130,
  "preparation_time_minutes": 30,

  "id": "ec850030-5bfd-5132-8a63-971e9bfc0d76",
  "slug": "chicken-piccata-ii",
  "name": "Chicken Piccata II",
  "recipe_type": "main",
  "brief_description": "Lemon in both breading and sauce makes an especially flavorful meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, beat the egg together with 1 tablespoon of the lemon juice. Set aside."
    },
    {
      "position": 2,
      "text": "In a shallow bowl or dish mix together the flour, garlic powder and paprika. Dip the chicken in the egg/lemon mixture, then in the seasoned flour."
    },
    {
      "position": 3,
      "text": "In a large skillet, melt butter/margarine and brown the coated chicken pieces."
    },
    {
      "position": 4,
      "text": "Dissolve the bouillon in the boiling water, then add the remaining 2 tablespoons of lemon juice. Pour liquid into skillet. Cover and let simmer for 20 minutes, turning chicken pieces after 10 minutes, until chicken is tender. Garnish as desired and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

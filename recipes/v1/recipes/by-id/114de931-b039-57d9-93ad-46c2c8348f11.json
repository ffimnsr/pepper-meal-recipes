  "schema_version": 1,
  "id": "114de931-b039-57d9-93ad-46c2c8348f11",
  "slug": "banana-nut-bread-baked-in-a-jar",
  "name": "Banana Nut Bread Baked in a Jar",
  "recipe_type": "dessert",
  "brief_description": "This traditional banana bread features an ingenious twist: It is baked in a canning jar! Such a fun and unique presentation makes it perfect for gifts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease insides of 8 (1 pint) straight sided, wide mouth canning jars."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream shortening and sugar until light and fluffy. Beat in eggs, bananas, and water. Sift together flour, baking powder, soda, salt, cinnamon, and cloves. Add to banana mixture. Stir in nuts."
    },
    {
      "position": 3,
      "text": "Pour mixture into greased WIDE MOUTH pint jars, filling 1/2 full of batter. Do NOT put lids on jars for baking. Be careful to keep the rims clean, wiping off any batter that gets on the rims."
    },
    {
      "position": 4,
      "text": "Bake at 325 degrees F (165 degrees C) for 45 minutes. Meanwhile, sterilize the lids and rings in boiling water."
    },
    {
      "position": 5,
      "text": "As soon as cake is done, remove from oven one at a time, wipe rims of jars and put on lid and ring. Jars will seal as cakes cool. Place the jars on the counter and listen for them to \"ping\" as they seal. If you miss the \"ping\", wait until they are completely cool and press on the top of the lid. If it doesn't move at all, it's sealed."
    },
    {
      "position": 6,
      "text": "Jars should be eaten immediately or kept sealed in refrigerator for up to a week."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

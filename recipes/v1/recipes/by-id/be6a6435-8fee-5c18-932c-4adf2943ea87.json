  "slug": "sugar-cookie-pumpkin-cupcake-muffins-recipe-11861644",
  "name": "Sugar Cookie Pumpkin Cupcake Muffins",
  "recipe_type": "dessert",
  "brief_description": "These sugar cookie pumpkin cupcake muffins take advantage of a super shortcut: refrigerated cookie dough plus 3 ingredients means almost no measuring. How easy is that!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a standard 12-well muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Add cookie dough, pumpkin puree, flour, eggs, and cinnamon to a large mixing bowl. Blend until smooth with an electric mixer. Divide batter evenly among 12 lined muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, about 20 minutes. Let cool completely., about 20 minutes."
    },
    {
      "position": 4,
      "text": "Top each cupcake with cream cheese frosting."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

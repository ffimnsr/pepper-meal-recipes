  "id": "b2474f23-ad3c-5f9d-a8ff-d12e1ca1c518",
  "slug": "easy-banana-brownies",
  "name": "Easy Banana Brownies",
  "recipe_type": "dessert",
  "brief_description": "These fudgy banana brownies are easy to make from scratch with chocolate chips and a ripe banana for a delicious chocolaty treat in less than an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium-low heat. Remove from the heat and stir in chocolate chips until melted. Set aside to cool for 5 minutes."
    },
    {
      "position": 3,
      "text": "While the chocolate mixture is cooling, lightly beat egg in a medium bowl. Stir in brown sugar, mashed banana, vanilla, and salt until well combined."
    },
    {
      "position": 4,
      "text": "Stir cooled melted chocolate mixture into banana mixture until well combined. Stir in flour until just incorporated. Spread batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Let pan cool on a wire rack before cutting into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

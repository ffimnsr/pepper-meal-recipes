  "id": "3d838f86-b6ae-5751-942c-21b49c0ad790",
  "slug": "baked-apricot-chicken",
  "name": "Baked Apricot Chicken",
  "recipe_type": "salad",
  "brief_description": "This sticky baked apricot chicken is easy to prep in a jiffy using chicken thighs, salad dressing, onion soup mix, and apricot jam.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir apricot preserves, dressing, and soup mix together in a medium bowl until combined."
    },
    {
      "position": 3,
      "text": "Place chicken thighs in a 9x13-inch baking dish. Pour apricot mixture over chicken."
    },
    {
      "position": 4,
      "text": "Bake uncovered in the preheated oven until an instant-read thermometer inserted near the bone reads 165 degrees F (74 degrees C), 50 to 60 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

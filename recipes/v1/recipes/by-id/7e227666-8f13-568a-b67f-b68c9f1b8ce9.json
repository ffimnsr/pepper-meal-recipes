  "id": "7e227666-8f13-568a-b67f-b68c9f1b8ce9",
  "slug": "banana-bread",
  "name": "Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "Of all the banana bread recipes, this one is the best! It makes two small loaves of moist, sweet banana bread to share with friends and family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 7x3-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking soda, and salt together in a bowl. Mix in melted butter and beaten eggs, then stir in mashed bananas. Pour batter into the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a wooden toothpick inserted into the center comes out clean, about 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

  "id": "a00c4609-9c86-56e0-94fc-79ac29d1338d",
  "slug": "red-lentil-chili-recipe-8647042",
  "name": "Red Lentil Chili",
  "recipe_type": "soup",
  "brief_description": "This vegetarian lentil chili is packed with fresh veggies, beans, and red lentils with paprika and poblano chili pepper for lots of smoky flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil over medium heat in a Dutch oven. Add carrots, zucchini, onion, poblano pepper, 1 tablespoon chili powder, 1 tablespoon cumin, and smoked paprika. Cook until onion is soft and translucent, 3 to 4 minutes."
    },
    {
      "position": 2,
      "text": "Remove zucchini from Dutch oven and set aside. Add garlic and jalape\u00f1o pepper to the vegetable mixture and stir to combine. Add tomato paste, 1 tablespoon chili powder, and 1 tablespoon cumin; stir for 2 to 3 minutes. Add diced tomatoes and vegetable broth, and bring to a boil. Once liquid boils, stir in kidney beans, black beans, and red lentils."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium-low, cover, leaving lid ajar, and simmer for 15 minutes. Season with remaining chili powder and cumin to taste."
    },
    {
      "position": 4,
      "text": "Return zucchini to the pot and reduce heat to low. Cover and allow flavors to blend for about 20 minutes. Taste and adjust seasoning if needed."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "id": "d2db5ea2-e71e-5af4-a6ec-c29fe6f3951d",
  "slug": "sharons-jamaican-fruit-cake",
  "name": "Sharon's Jamaican Fruit Cake",
  "recipe_type": "dessert",
  "brief_description": "This Jamaican fruitcake recipe produces two deliciously dark, rich, spiced fruitcakes. The perfect food gift for wine and dried fruit lovers!",
  "cuisine": "Jamaican Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans."
    },
    {
      "position": 2,
      "text": "Place butter and sugar into a large bowl; beat with an electric mixer until light and fluffy."
    },
    {
      "position": 3,
      "text": "Beat in eggs; add rum, lime juice, almond extract, vanilla, and lime zest."
    },
    {
      "position": 4,
      "text": "Stir in dried fruit, wine and molasses."
    },
    {
      "position": 5,
      "text": "Sift flour, baking powder, nutmeg, allspice, cinnamon, and salt together in a large bowl; gently fold into fruit mixture. Pour batter evenly into the prepared pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 80 to 90 minutes. Let cool in the pan for 10 minutes, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,

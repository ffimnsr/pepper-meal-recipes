  "schema_version": 1,
  "id": "e768af1c-d301-54a3-a40d-624e957be3a7",
  "slug": "gingerbread-cookies",
  "name": "Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "This gingerbread cookie recipe makes classic holiday gingerbread cookies that bake up soft in the center with crisp edges, perfect for decorating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter and sugar in a large bowl with an electric mixer on low speed until mostly incorporated, 1 to 2 minutes. Increase speed to medium-high and beat until light and fluffy, another 2 to 3 minutes. Beat in egg yolk, then molasses."
    },
    {
      "position": 2,
      "text": "Whisk sifted flour, salt, baking powder, baking soda, cinnamon, cloves, ginger, and nutmeg in a separate bowl until well combined. Gradually add flour mixture to the molasses mixture, beating until well blended and smooth."
    },
    {
      "position": 3,
      "text": "Divide dough in half and form each into a 1-inch-thick disk. Wrap in plastic wrap and refrigerate for at least 1 to 3 hours, or overnight."
    },
    {
      "position": 4,
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Working with one disk at a time, and leaving remaining disk in the refrigerator, unwrap chilled dough and place on a lightly floured surface. Working from the center to the edges, roll dough with a floured rolling pin to a thickness of 1/4 inch."
    },
    {
      "position": 6,
      "text": "Cut dough into desired shapes with cookie cutters, dipping the cutters into flour as needed so they don't stick to the dough. Fit the cookie cutters as closely together as possible to cut as many cookies as you can. This will minimize the number of times you have to re-roll the dough."
    },
    {
      "position": 7,
      "text": "Transfer gingerbread cookies to ungreased cookie sheets, spacing them 2 inches apart. Gather any dough scraps into a ball, flatten, re-wrap with plastic wrap, and refrigerate to use for later batches."
    },
    {
      "position": 8,
      "text": "Bake each sheet in the preheated oven until firm, 8 to 10 minutes. Transfer cookies to wire racks to cool completely while you finish rolling, cutting, and baking the remaining cookies."
    },
    {
      "position": 9,
      "text": "Frost or decorate cooled gingerbread cookies as desired."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "114c8ef5-a087-531a-8d0a-1fdd2ae58eea",
  "slug": "dairy-free-creamy-broccoli-soup",
  "name": "Dairy-Free Creamy Broccoli Soup",
  "recipe_type": "soup",
  "brief_description": "Potatoes, celery root, and chicken stock are pur\u00e9ed with broccoli to give this quick and easy soup a creamy texture without using dairy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a saucepan over medium-low heat. Add onion and garlic; cook and stir until translucent, 10 to 15 minutes. Add broccoli stalks, potatoes, broccoli florets, and celery root; toss until coated in oil. Cover vegetables with chicken stock; bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce heat and simmer, stirring occasionally, until vegetables are easily pierced with a fork, 20 to 25 minutes. Remove soup from heat."
    },
    {
      "position": 3,
      "text": "Fill a blender no more than halfway with liquid and vegetables. Cover and hold lid down; pulse a few times before increasing blender to maximum speed. Puree until soup is light green and creamy, 45 seconds to 1 minute. Repeat with remaining soup, working in batches."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

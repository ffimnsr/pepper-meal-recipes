  "id": "310d281e-630b-5e36-9c11-f30d1fabd361",
  "slug": "caprese-salad-with-balsamic-reduction",
  "name": "Caprese Salad with Balsamic Reduction",
  "recipe_type": "salad",
  "brief_description": "This caprese salad with sliced tomatoes, mozzarella, and fresh basil is finished with an easy homemade balsamic reduction for a standout summer salad",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine balsamic vinegar and honey in a small saucepan over high heat; bring to a boil. Reduce heat to low; simmer until mixture has reduced to \u2153 cup, about 10 minutes. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Arrange alternating tomato and mozzarella slices decoratively on a serving platter."
    },
    {
      "position": 4,
      "text": "Sprinkle with salt and black pepper; tuck basil leaves around slices. Drizzle with olive oil and balsamic reduction."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

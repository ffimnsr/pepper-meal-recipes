  "slug": "avocado-caprese-salad-recipe-8737146",
  "name": "Avocado Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "For this avocado caprese salad, add some chopped avocado to caprese for a new twist on an old favorite. Proportioned for two, this easy salad is perfect for a quick summer lunch with a friend.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mozzarella, halved cherry tomatoes, and chopped avocado in a small bowl. Tear basil leaves into pieces and sprinkle over the other ingredients."
    },
    {
      "position": 2,
      "text": "Drizzle on balsamic vinegar and extra virgin olive oil and toss to combine. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Divide into two serving bowls and garnish with additional fresh basil. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

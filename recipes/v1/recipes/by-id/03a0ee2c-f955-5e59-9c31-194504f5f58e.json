  "id": "03a0ee2c-f955-5e59-9c31-194504f5f58e",
  "slug": "the-humble-shepherd",
  "name": "The Humble Shepherd",
  "recipe_type": "main",
  "brief_description": "A twist on the original shepherd's pie using ground turkey in place of beef.",
  "cuisine": "U.S. American British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Lightly grease a medium baking dish."
    },
    {
      "position": 2,
      "text": "Cover potatoes with water in a saucepan and boil for 20 to 30 minutes, or until fork-tender. Drain and beat until smooth with an electric mixer. Add butter, milk, and salt and pepper to taste; beat to desired consistency."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon of oil in a large skillet over medium high heat. Cook and stir turkey and onion until turkey is fully cooked. Add gravy mix and water; stir often, until gravy is thick and bubbly. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Add turkey mixture to the baking dish. Next, layer the peas and carrots, and top with the mashed potatoes. Top with a layer of shredded cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 to 25 minutes, or until cheese is melted and the potatoes are golden on the top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

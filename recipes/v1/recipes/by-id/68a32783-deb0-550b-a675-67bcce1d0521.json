  "id": "68a32783-deb0-550b-a675-67bcce1d0521",
  "slug": "irish-cream-truffle-fudge",
  "name": "Irish Cream Truffle Fudge",
  "recipe_type": "dessert",
  "brief_description": "This is 'wicked good' stuff! This creamy sweet confection will disappear as fast as a wink.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 8x8 inch pan."
    },
    {
      "position": 2,
      "text": "In the top half of a double boiler melt the 3 cups semisweet chocolate chips, 1 cup white chocolate chips and 1/4 cup butter until soft enough to stir."
    },
    {
      "position": 3,
      "text": "Stir in the confectioner's sugar and Irish cream until mixture is smooth. Stir in nuts. Place mixture in the prepared pan and lay a sheet of plastic wrap over top; press and smooth top down."
    },
    {
      "position": 4,
      "text": "In the top half of a double boiler melt remaining chocolates until soft. Remove from heat and with a fork beat in the butter and Irish cream until smooth. Spread topping over cooled fudge with a knife. If a smooth top is important place plastic wrap over the top. Refrigerate until firm, 1 to 2 hours at least. This fudge can be easily frozen."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

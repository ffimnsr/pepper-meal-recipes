  "id": "c25a2010-5d63-54ff-b099-cc770095d0a0",
  "slug": "big-vs-slow-cooker-pulled-pork",
  "name": "Big V's Slow-Cooker Pulled Pork",
  "recipe_type": "main",
  "brief_description": "Picnic pork roast is marinated overnight with beer, mustard, and honey, then slow cooked until tender for a delicious dinner that's well worth the wait.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Mix beer, mustard, honey, Worcestershire sauce, garlic, cayenne pepper, and salt in a bowl until honey is dissolved. Pour a small amount of the beer marinade into a slow cooker; add pork. Pour remaining marinade over pork. Cover and refrigerate overnight, turning pork occasionally."
    },
    {
      "position": 2,
      "text": "Cook pork on Low in the slow cooker for 8 hours, basting occasionally. Add water if the pork becomes dry. Drop onion around pork and continue to cook until pork is very tender, about 2 hours more."
    },
    {
      "position": 3,
      "text": "Pull and shred pork with two forks, discarding any pieces of fat. Transfer pork to a serving dish. Skim remaining onion from the slow cooker using a sieve and add to pork."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 600,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "slug": "donut-ice-cream-sandwiches-recipe-8423867",
  "name": "Donut Ice Cream Sandwiches",
  "recipe_type": "dessert",
  "brief_description": "These donut ice cream sandwiches begin with a not-so-ordinary maple bacon bar, but butter pecan ice cream inside really takes them over the top. For a treat this good, who would think you\u2019d only need 5 minutes to make them?",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut maple bacon bar in half, then cut each piece in half horizontally."
    },
    {
      "position": 2,
      "text": "Spread the bottom of each bar donut half with butter pecan ice cream. Place the cut donut tops onto the ice cream. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

  "id": "430c7015-eb33-5eb7-9b2c-e09382aba18f",
  "slug": "potato-waffles",
  "name": "Potato Waffles",
  "recipe_type": "dessert",
  "brief_description": "These potato waffles are similar to potato pancakes, but cooked until golden brown in your waffle iron. Great way to use up leftover mashed potatoes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add onion and garlic; cook and stir until onion is tender, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Combine onion mixture, mashed potatoes, eggs, flour, salt, and black pepper in a large bowl until well blended."
    },
    {
      "position": 4,
      "text": "Scoop 1/4 to 1/2 cup batter (depending on size of waffle iron) into the center of waffle iron and close lid. Cook until golden brown, 3 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

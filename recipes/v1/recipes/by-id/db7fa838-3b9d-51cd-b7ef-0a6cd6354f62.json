  "schema_version": 1,
  "id": "db7fa838-3b9d-51cd-b7ef-0a6cd6354f62",
  "slug": "kentucky-bourbon-cake",
  "name": "Kentucky Bourbon Cake",
  "recipe_type": "dessert",
  "brief_description": "Kentucky bourbon cake is a deliciously dense fruit cake that's brushed with bourbon and wrapped in a bourbon-soaked cheesecloth for a festive treat.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Grease a 10-inch tube pan and line the bottom with parchment paper."
    },
    {
      "position": 2,
      "text": "Soak raisins and cherries in 2 cups of bourbon or whiskey for 48 hours. Before making cake, drain well and reserve bourbon."
    },
    {
      "position": 3,
      "text": "In a separate bowl, mix flour, nutmeg, and baking powder. Set aside."
    },
    {
      "position": 4,
      "text": "In a small bowl, cream butter with white sugar. In a separate small bowl, cream yolks and brown sugar until very light."
    },
    {
      "position": 5,
      "text": "In a large bowl, combine two sugar mixtures and blend well."
    },
    {
      "position": 6,
      "text": "Alternately, add flour mixture and reserved bourbon in three stages, mixing well with each addition."
    },
    {
      "position": 7,
      "text": "Add soaked fruit and fold in. Add nuts and fold in."
    },
    {
      "position": 8,
      "text": "In a clean medium bowl, whip egg whites until stiff but not dry. Fold into batter until evenly distributed; pour into the prepared 10-inch tube pan."
    },
    {
      "position": 9,
      "text": "Bake cake in the bottom of the preheated oven until a toothpick inserted into the center comes out clean, about 4 to 5 hours. Ovens vary, so it may take longer than 5 hours."
    },
    {
      "position": 10,
      "text": "Remove from the oven and allow to cool for 15 minutes before turning out. When almost cool, brush sides and inside hole heavily with bourbon. Wrap cake with a bourbon-soaked cheesecloth, then with plastic wrap. Refrigerate overnight and saturate again with bourbon. Cover with plastic wrap and then with foil and store for at least 2 weeks in a cool, dry place."
    }
  ],

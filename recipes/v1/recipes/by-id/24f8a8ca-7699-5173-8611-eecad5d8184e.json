  "id": "24f8a8ca-7699-5173-8611-eecad5d8184e",
  "slug": "prime-rib-its-easier-than-you-think",
  "name": "Prime Rib - It's Easier Than You Think",
  "recipe_type": "main",
  "brief_description": "Prime rib is easier than you think with this recipe and a few fool-proof ingredients: a little steak seasoning, garlic, and a good, accurate thermometer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place roast, bone-side down, onto a rack set in a roasting pan."
    },
    {
      "position": 3,
      "text": "Whisk olive oil, steak seasoning, garlic, Italian seasoning, and mustard powder together in a small bowl."
    },
    {
      "position": 4,
      "text": "Spread over roast; set aside until roast comes to room temperature, about 45 minutes. Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Insert a meat thermometer into the thickest part of the roast, not touching the bone. Reduce the oven temperature to 325 degrees F (165 degrees C)."
    },
    {
      "position": 6,
      "text": "Continue cooking until reaches desired degree of doneness, or an internal temperature of 145 degrees F (65 degrees C) for medium is reached, about 1 1/2 to 2 hours. Remove from the oven, cover with a doubled sheet of aluminum foil, and set aside to rest in a warm area before slicing, 10 to 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "b055019a-deef-5103-ab1d-f538325d59e0",
  "slug": "slow-cooker-pumpkin-oatmeal",
  "name": "Slow Cooker Pumpkin Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "This easy recipe for overnight oatmeal is made in the slow cooker, perfect for busy fall mornings when you're craving spiced pumpkin dishes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a small slow cooker lightly with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix oats, 1/2 cup brown sugar, cinnamon, and nutmeg together in a large bowl. Stir in pumpkin. Stir in water and half-and-half gradually. Stir in raisins and vanilla extract."
    },
    {
      "position": 3,
      "text": "Ladle oat mixture into the slow cooker. Cook on Low until oats are soft and creamy, 7 1/2 to 8 1/2 hours."
    },
    {
      "position": 4,
      "text": "Sprinkle 2 tablespoons plus 2 teaspoons brown sugar and 5 tablespoons plus 1 teaspoon walnuts over oatmeal."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 450,
  "preparation_time_minutes": 10,

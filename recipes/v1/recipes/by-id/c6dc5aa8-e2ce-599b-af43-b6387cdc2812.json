  "id": "c6dc5aa8-e2ce-599b-af43-b6387cdc2812",
  "slug": "vanilla-pumpkin-pie",
  "name": "Vanilla Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This is my husband's favorite pumpkin pie. It's less spicy than traditional pumpkin pies so you can really taste the pumpkin flavor!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine pumpkin, evaporated milk, eggs, sugar, flour, salt vanilla, and cinnamon. Pour filling into pie shell."
    },
    {
      "position": 3,
      "text": "Bake for 20 minutes in the oven then turn the oven temperature down to 350 degrees F (175 degrees C). Continue baking 40 more minutes or until a knife inserted in center comes out clean. Cool completely on a wire rack before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

  "slug": "overnight-coconut-pecan-steel-cut-oats",
  "name": "Overnight Coconut Pecan Steel Cut Oats",
  "recipe_type": "breakfast",
  "brief_description": "Soak your oats with milk, brown sugar, pecans, and coconut before bedtime for a ready-made breakfast the next morning.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix oats, coconut, pecans, brown sugar, and cinnamon in a small container; top with 1/3 cup milk. Cover and refrigerate for 8 hours or overnight. Stir 1 tablespoon milk into oat mixture before serving."
    }
  ],

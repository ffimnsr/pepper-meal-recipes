  "id": "4b928486-7849-541a-97b6-dea0a8735164",
  "slug": "easy-parmesan-crusted-chicken",
  "name": "Easy Parmesan-Crusted Chicken",
  "recipe_type": "main",
  "brief_description": "Try this Parmesan-crusted chicken recipe for juicy, tender chicken breasts coated in a mixture of Parmesan cheese and seasoned bread crumbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise and Parmesan together in a medium bowl until well combined."
    },
    {
      "position": 4,
      "text": "Arrange chicken on the prepared baking sheet. Spread mayonnaise mixture over top, then top with bread crumbs."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

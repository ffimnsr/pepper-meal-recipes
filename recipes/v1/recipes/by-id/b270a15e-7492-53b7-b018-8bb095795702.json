  "id": "b270a15e-7492-53b7-b018-8bb095795702",
  "slug": "orange-french-toast-bake-recipe-8559240",
  "name": "Orange French Toast Bake",
  "recipe_type": "breakfast",
  "brief_description": "This orange French toast bake gets its orange flavor from orange juice, orange zest, and orange liqueur. It's great when you're serving a large group.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease two large baking sheets or line with parchment paper, lightly sprayed with cooking spray, which will keep the bread from sticking."
    },
    {
      "position": 2,
      "text": "In a bowl, whisk eggs until light in color. Add milk, sugar, orange liqueur, orange juice, orange zest, orange extract, salt, and nutmeg, whisking until well combined."
    },
    {
      "position": 3,
      "text": "Coat bread slices in the egg custard, and place on the baking sheets without overlapping. Bake until golden brown, flipping halfway through baking time, about 15 minutes."
    },
    {
      "position": 4,
      "text": "To serve, sprinkle with confectioners sugar and drizzle with maple syrup."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0d3f162e-83df-5179-80aa-36bb2d926d51",
  "slug": "greek-yogurt-peanut-butter-bites",
  "name": "Greek Yogurt Peanut Butter Bites",
  "recipe_type": "appetizer",
  "brief_description": "Packed with peanut butter, Greek yogurt, oats, and flax seeds, these little yogurt ball snack bites are a healthier way to curb your sweet tooth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine peanut butter, Greek yogurt, and honey in a medium bowl. Stir with a spoon until smooth. Add oats, almond flour, flaxseed meal, and cacao nibs. Stir until well incorporated."
    },
    {
      "position": 2,
      "text": "Scoop up about 1 tablespoon of mixture with a small cookie scoop or spoon and roll lightly into a ball with your hands. Place in an airtight container and refrigerate for about 1 hour before serving."
    }
  ],
  "servings": 12,

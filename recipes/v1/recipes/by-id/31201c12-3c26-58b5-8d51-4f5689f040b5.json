  "id": "31201c12-3c26-58b5-8d51-4f5689f040b5",
  "slug": "tv-cobbler",
  "name": "T.V. Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This buttery tv cobbler is so quick and easy to prepare using just 7 simple ingredients that it makes the perfect weeknight tv-watching dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Place butter in an 8x8-inch microwave-safe baking dish."
    },
    {
      "position": 2,
      "text": "Heat butter in microwave until melted, 30 seconds to 1 minute."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, baking powder, and salt together in a bowl; whisk in milk until batter is smooth. Pour batter over butter without stirring. Spoon pie filling evenly over batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cobbler is golden brown, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "049d2359-c753-5a16-bf67-021d1f3cded4",
  "slug": "copycat-red-lobster-shrimp-scampi-recipe-8730066",
  "name": "Copycat Red Lobster Shrimp Scampi",
  "recipe_type": "main",
  "brief_description": "This copycat Red Lobster shrimp scampi is my recreation of the scampi served by the familiar seafood restaurant known for lobster, crab legs, and shrimp. Jumbo shrimp in a lemon, wine, and garlic sauce comes together quickly, and is truly restaurant-worthy.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven\u2019s broiler to 500 degrees F (260 degrees C)."
    },
    {
      "position": 2,
      "text": "Place shrimp in a pinwheel fashion in an oven-safe dish, such as a glass pie plate."
    },
    {
      "position": 3,
      "text": "Stir pinot grigio, melted butter, lemon juice, garlic, salt, and crushed red pepper flakes together in a cup."
    },
    {
      "position": 4,
      "text": "Pour mixture over shrimp. Sprinkle Parmesan over shrimp."
    },
    {
      "position": 5,
      "text": "Broil until shrimp is pink and tails curl inward, about 7 minutes."
    },
    {
      "position": 6,
      "text": "Sprinkle with chopped parsley and serve with lemon wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "e750ed6f-cc03-5dc8-9e58-6e090079479f",
  "slug": "tomato-martini-recipe-11828761",
  "name": "Tomato Martini",
  "recipe_type": "appetizer",
  "brief_description": "This tomato martini blends muddled cherry tomatoes, fresh basil, and Parmesan for a savory, umami-rich foundation, brightened with a touch of lemon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a martini glass in the freezer to chill."
    },
    {
      "position": 2,
      "text": "Muddle 5 cherry tomatoes, Parmigiano Reggiano cheese, basil leaves, and juice from 1 lemon wedge in a cocktail shaker until juice is released from tomatoes. Add gin, dry vermouth, pinch of salt and ice to shaker. Cover and shake until chilled, 15 to 20 seconds."
    },
    {
      "position": 3,
      "text": "Pour cocktail through a fine mesh strainer into the chilled martini glass. If desired, add a sprinkle of freshly-cracked pepper and a drizzle of olive oil. Garnish with remaining cherry tomato and lemon wedge."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

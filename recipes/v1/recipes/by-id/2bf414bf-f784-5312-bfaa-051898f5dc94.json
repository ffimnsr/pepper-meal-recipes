  "id": "2bf414bf-f784-5312-bfaa-051898f5dc94",
  "slug": "easy-cheesy-garlic-bread",
  "name": "Easy Cheesy Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This irresistibly easy, cheesy garlic bread recipe is loaded with melted butter and Parmesan cheese and transforms French bread into a delicious treat.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut bread into 1-inch thick slices, without cutting all the way through the loaf. Combine butter, Parmesan cheese, garlic powder, and parsley in a small bowl; spread between bread slices and over top of loaf. Wrap loaf in aluminum foil, leaving top partially uncovered."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until butter melts and bread toasts, 15 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

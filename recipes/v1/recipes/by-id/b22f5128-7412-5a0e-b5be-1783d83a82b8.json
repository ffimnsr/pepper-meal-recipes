  "id": "b22f5128-7412-5a0e-b5be-1783d83a82b8",
  "slug": "keto-cinnamon-granola",
  "name": "Keto Cinnamon Granola",
  "recipe_type": "dessert",
  "brief_description": "If you love something crunchy-sweet in the morning, this homemade keto cinnamon granola recipe is quick, easy, flavorful, and low in carbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix walnuts, pecans, coconut, and almonds together in a bowl."
    },
    {
      "position": 3,
      "text": "Stir cinnamon, erythritol, and sucralose into melted butter; pour over nut mixture and stir to coat. Spread granola in a single layer on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crunchy, 8 to 10 minutes. Remove from oven; stir and allow to cool."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 10,

  "id": "410d2902-52a0-5994-82e7-29c79b185f0c",
  "slug": "easy-homemade-sauerkraut",
  "name": "Easy Homemade Sauerkraut",
  "recipe_type": "side",
  "brief_description": "Homemade sauerkraut is easy to make on your own using 5 simple ingredients and a food-grade plastic bucket. Eat on its own or on a sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cabbage, onion, sea salt, and garlic together in a bowl. Firmly pack mixture into a large, clean, food-grade plastic bucket. The cabbage will start to make its own brine as the salt starts to draw out the water of the cabbage."
    },
    {
      "position": 2,
      "text": "Fill a large, clean, food-grade plastic bag with water and place over the salted cabbage mixture so none of the cabbage is exposed to air."
    },
    {
      "position": 3,
      "text": "Allow cabbage to ferment in a cool, dry place, 1 to 4 weeks (depending on how tangy you like your sauerkraut). The temperature of the room you ferment the sauerkraut in should not rise above 70 degrees F (21 degrees C)."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

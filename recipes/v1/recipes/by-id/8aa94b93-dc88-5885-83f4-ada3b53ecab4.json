  "id": "8aa94b93-dc88-5885-83f4-ada3b53ecab4",
  "slug": "sloppy-joe-sandwich-filling",
  "name": "Sloppy Joe Sandwich Filling",
  "recipe_type": "main",
  "brief_description": "The traditional sloppy Joe goes south of the border in this tangy, flavorful sandwich filling recipe.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Cook onion and poblano pepper until softened, about 5 minutes. Transfer mixture to a plate. Add ground beef and chorizo to the skillet. Cook, stirring often to break up meat, until browned and crumbly, 5 to 7 minutes. Add enchilada seasoning and tomato powder. Add water, ketchup, and Worcestershire sauce. Return cooked onion mixture to the skillet. Simmer until flavors combine, about 5 minutes more."
    },
    {
      "position": 2,
      "text": "Serve meat mixture on toasted buns topped with Oaxaca cheese and avocado."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

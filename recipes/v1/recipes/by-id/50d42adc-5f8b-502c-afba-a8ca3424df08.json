  "id": "50d42adc-5f8b-502c-afba-a8ca3424df08",
  "slug": "easiest-peanut-butter-granola-ever",
  "name": "Easiest Peanut Butter Granola Ever",
  "recipe_type": "breakfast",
  "brief_description": "Make your own peanut butter-flavored granola using just oats, raisins, cinnamon, honey, egg white, peanut butter, and this easy DIY recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with waxed paper."
    },
    {
      "position": 2,
      "text": "Mix oats, raisins, and cinnamon together in a bowl. Mix peanut butter with the oats mixture using your hands until ingredients are coated in peanut butter; add egg white and honey and continue mixing with hands until evenly mixed. Spread the mixture onto the baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 10 minutes, stir, and continue baking until beginning to brown, 5 to 10 minutes more."
    },
    {
      "position": 4,
      "text": "Let granola cool until it begins to harden, at least 30 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

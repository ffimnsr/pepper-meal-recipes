  "id": "bce2c6f6-74e5-5e34-978b-bec4eec7ff00",
  "slug": "smothered-burritos",
  "name": "Smothered Burritos",
  "recipe_type": "main",
  "brief_description": "Beef and refried bean burritos are baked under a creamy sauce topped with cheese in this easy smothered burritos recipe.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef, onion, and green chiles in the hot skillet until beef is browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 3,
      "text": "Add water, chili powder, salt, red pepper flakes, cumin, and garlic powder to beef mixture; bring to a boil. Reduce heat to medium-low and simmer. Stir in refried beans; cook until heated through, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Mix cream of mushroom soup and sour cream together in a bowl."
    },
    {
      "position": 5,
      "text": "Fill each tortilla with beef mixture and roll tortilla around filling. Arrange burritos in the prepared baking dish; top with sour cream mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 20 minutes. Cover burritos with Cheddar-Monterey Jack cheese blend. Bake until cheese is melted, about 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

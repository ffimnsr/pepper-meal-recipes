  "id": "52a810be-e913-532e-a174-be7f606b879d",
  "slug": "sushi-roll",
  "name": "Homemade Sushi",
  "recipe_type": "appetizer",
  "brief_description": "Make sushi rolls at home with this easy sushi recipe with crabmeat, avocado, cucumber, and pickled ginger, or customize with your favorite fillings.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a medium pot; stir in rice. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Mix rice vinegar, sugar, and salt in a small bowl. Gently stir into cooked rice in the pot and set aside."
    },
    {
      "position": 4,
      "text": "Lay nori sheets on a baking sheet."
    },
    {
      "position": 5,
      "text": "Heat nori in the preheated oven until warm, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Center 1 nori sheet on a bamboo sushi mat. Use wet hands to spread a thin layer of rice on top. Arrange 1/4 of the crabmeat, avocado, cucumber, and pickled ginger over rice in a line down the center."
    },
    {
      "position": 7,
      "text": "Lift one end of the mat and roll it tightly over filling to make a complete roll. Repeat with remaining ingredients."
    },
    {
      "position": 8,
      "text": "Use a wet, sharp knife to cut each roll into 4 to 6 slices."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

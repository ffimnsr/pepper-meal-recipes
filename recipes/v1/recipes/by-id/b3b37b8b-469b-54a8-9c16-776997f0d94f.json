  "id": "b3b37b8b-469b-54a8-9c16-776997f0d94f",
  "slug": "phoenicians-key-lime-pie",
  "name": "Phoenician's Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "This delicious Key lime pie recipe has a ground toasted almond crust with a creamy and refreshing filling flavored with Key lime juice and zest.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the crust: Pulse almonds in a food processor until finely ground, then pour into a medium bowl. Add graham cracker crumbs, sugar, and salt. Pour in melted butter and mix until evenly moistened. Press into a 9-inch pie plate."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust is golden brown, 10 to 13 minutes."
    },
    {
      "position": 4,
      "text": "While crust is baking, make the filling: Beat condensed milk, cream, egg yolks, and lime zest in a large bowl until well combined. Whisk in lime juice, a little at a time, to thicken custard. Pour custard into pie crust."
    },
    {
      "position": 5,
      "text": "Bake until custard is set, about 15 minutes. Cool to room temperature on a wire rack, then cover loosely with plastic wrap and chill in the refrigerator for 8 hours to overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9f31329e-a799-5e7a-b667-ed51522faee1",
  "slug": "delicious-and-easy-prime-rib",
  "name": "Delicious and Easy Prime Rib",
  "recipe_type": "main",
  "brief_description": "Melt-in-your-mouth prime rib cooked at a low temperature for several hours will quickly become a special occasion favorite in your home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice several slits into the top of prime rib; push garlic cloves into slits. Coat prime rib with olive oil and season with salt and pepper. Arrange rosemary sprigs and thyme sprigs atop prime rib and place in a roasting pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned on the outside and pink in the center, 3 1/2 to 4 hours. An instant-read thermometer inserted into the center should read at least 125 degrees F (52 degrees C). Allow prime rib to rest 15 minutes before slicing."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 15,

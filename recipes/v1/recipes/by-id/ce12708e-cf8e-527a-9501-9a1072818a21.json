  "id": "ce12708e-cf8e-527a-9501-9a1072818a21",
  "slug": "air-fryer-grilled-pimento-cheese-recipe-8720986",
  "name": "Air Fryer Grilled Pimento Cheese",
  "recipe_type": "main",
  "brief_description": "This air fryer grilled pimento cheese is inspired by the legendary sandwich sold at the annual Masters golf tournament, made with the Southern classic, pimento cheese. For an updated twist, add tomato slices on crusty bread, air fry to toasty perfection, and you\u2019ll have the ultimate sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 370 degrees F (188 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread one side of each bread slice lightly with mayonnaise. Lay 2 slices of bread, mayonnaise side down, and evenly spread with pimento cheese; top with tomato slices. Sprinkle with basil and season with salt and pepper. Top with remaining 2 bread slices, mayonnaise side up."
    },
    {
      "position": 3,
      "text": "Move sandwiches to the air fryer basket. Place a toothpick in the center of each sandwich and air fry until bread is fully toasted and golden brown, 8 to 10 minutes, flipping halfway through."
    },
    {
      "position": 4,
      "text": "Remove toothpick from sandwich, slice in half, and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

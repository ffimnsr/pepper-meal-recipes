  "id": "a45d94ac-dd1f-5734-a2ef-6de78a1f1943",
  "slug": "one-skillet-mexican-quinoa",
  "name": "One-Skillet Mexican Quinoa",
  "recipe_type": "main",
  "brief_description": "This Mexican quinoa dish with black beans, fire-roasted tomatoes, corn, and avocado is easy to make in one skillet for a family-friendly meal.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Saut\u00e9 jalape\u00f1o pepper and garlic in the hot oil until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Stir black beans, tomatoes, corn, quinoa, and chicken broth into the skillet. Season with pepper flakes, chili powder, cumin, salt, and black pepper; bring to a boil."
    },
    {
      "position": 3,
      "text": "Cover the skillet with a lid, reduce heat to low, and simmer until quinoa is tender and liquid is mostly absorbed, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Add avocado, lime juice, and cilantro; stir until combined."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

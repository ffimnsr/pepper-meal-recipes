  "id": "d38717c7-e130-5702-bd79-c25799b62011",
  "slug": "chocolate-covered-strawberries",
  "name": "Chocolate-Covered Strawberries",
  "recipe_type": "dessert",
  "brief_description": "DIY chocolate-covered strawberries are easy to make with just 3 ingredients for a beautiful Valentine's Day dessert, gorgeous food gift, or parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt chocolate and shortening in a double boiler, stirring occasionally until smooth."
    },
    {
      "position": 3,
      "text": "Insert toothpicks into tops (stem ends) of strawberries. Hold a strawberry by the toothpick and dip it into the chocolate mixture."
    },
    {
      "position": 4,
      "text": "Turn the strawberry upside down and insert the toothpick into a Styrofoam block or place strawberry on a sheet of waxed paper; allow chocolate coating to cool. Repeat with remaining strawberries."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

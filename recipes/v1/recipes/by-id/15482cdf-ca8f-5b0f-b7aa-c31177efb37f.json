  "id": "15482cdf-ca8f-5b0f-b7aa-c31177efb37f",
  "slug": "beef-tenderloin-with-dijon-cream-sauce-recipe-8741691",
  "name": "Beef Tenderloin with Dijon Cream Sauce",
  "recipe_type": "main",
  "brief_description": "No less than 15 friends texted me last year for my beef tenderloin recipe; it\u2019s an all-time favorite. Make and chill the Dijon Cream Sauce up to two weeks in advance.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Line a rimmed 10x15-inch baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Place beef tenderloin on the prepared baking sheet. Rub with butter, then drizzle with 1 1/2 teaspoons Worcestershire sauce and sprinkle with salt and pepper. Tuck tapered end of tenderloin underneath to ensure even cooking."
    },
    {
      "position": 3,
      "text": "Roast tenderloin in the preheated oven until an instant-read thermometer inserted into thickest part registers 135 degrees F (57 degrees C) for medium-rare, 25 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Transfer tenderloin to a cutting board and tent loosely with foil; let rest for 10 minutes. (After resting, thermometer should register 145 degrees F (63 degrees C))"
    },
    {
      "position": 5,
      "text": "For sauce, stir together mayonnaise, mustard, hot sauce, and remaining 2 teaspoons Worcestershire in a small bowl. Slice tenderloin. Serve with sauce and garnish with parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

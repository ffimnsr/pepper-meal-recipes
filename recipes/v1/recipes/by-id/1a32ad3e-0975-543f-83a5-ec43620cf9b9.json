  "id": "1a32ad3e-0975-543f-83a5-ec43620cf9b9",
  "slug": "bacon-pancake-dippers-recipe-11972436",
  "name": "Bacon Pancake Dippers",
  "recipe_type": "dessert",
  "brief_description": "These bacon pancake dippers are super easy to make and taste delicious. And you only need a couple of ingredients. Use your favorite pancake mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 2,
      "text": "Lightly oil a griddle."
    },
    {
      "position": 3,
      "text": "Whisk together low carb pancake mix and water according to package instructions. Fill batter into a piping bag and pipe long thin oval pancake shapes onto the griddle that are a little longer and wider than a piece of bacon. You can also use a spoon he batter onto the griddle."
    },
    {
      "position": 4,
      "text": "Lightly press a slice of cooked bacon into the batter of each pancake."
    },
    {
      "position": 5,
      "text": "Cook over medium-high heat until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter."
    },
    {
      "position": 6,
      "text": "Dunk in maple syrup and enjoy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 6,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "27666d9c-f407-53fd-8833-e82689267cd2",
  "slug": "cheesy-polenta-casserole",
  "name": "Cheesy Polenta Casserole",
  "recipe_type": "side",
  "brief_description": "This rich and filling polenta casserole comes together quickly using prepared ingredients like sliced polenta, marinara sauce, and an Italian cheese blend.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square casserole dish. Mix together provolone and fontina cheeses in a bowl."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over medium-high heat. Stir in bell pepper, green onions, and garlic; cook until pepper softens, about 3 minutes. Pour in marinara sauce and simmer for 5 to 7 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Spread a thin layer of sauce over the bottom of the prepared baking dish. Arrange 1/3 of the polenta slices in the dish, top with 1/3 of the cheese mixture, and spread a thin layer of sauce over the cheese. Repeat layers twice more. Top casserole with Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is bubbly and golden brown, about 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9df08f1e-9c5b-5cc9-9bd1-c052537d6a59",
  "slug": "stuffed-peppers-italian-style",
  "name": "Stuffed Peppers Italian Style",
  "recipe_type": "main",
  "brief_description": "These Italian stuffed peppers are filled with bread stuffing flavored with onions, garlic, olives, and anchovies slowly simmered in the oven.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large baking dish."
    },
    {
      "position": 2,
      "text": "Arrange bell peppers, cut-side-up, in the prepared baking dish; set aside."
    },
    {
      "position": 3,
      "text": "Place crumbled bread into a large bowl and sprinkle with 1/2 cup water; set aside."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large, heavy skillet over low heat. Saut\u00e9 onion in hot oil until translucent. Stir in garlic and cook for 2 minutes. Mix in moistened bread. Add anchovy fillets, olives, extra-virgin olive oil, black pepper, and red pepper flakes; stir until stuffing is well blended."
    },
    {
      "position": 5,
      "text": "Mound stuffing into pepper halves. Surround peppers with tomato sauce and a small amount of water. Cover the baking dish with foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until peppers are tender, 45 to 60 minutes. Uncover for the last 15 minutes of baking and baste occasionally with sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

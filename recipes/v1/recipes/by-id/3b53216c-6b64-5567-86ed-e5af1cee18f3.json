  "schema_version": 1,
  "id": "3b53216c-6b64-5567-86ed-e5af1cee18f3",
  "slug": "lentil-rice-and-veggie-bake",
  "name": "Lentil Rice and Veggie Bake",
  "recipe_type": "main",
  "brief_description": "Combine delicious lentils, rice, tomato sauce, herbs, and vegetables to make a wonderful lentil bake that vegans and non-vegans alike will enjoy.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place rice and 1 cup water in a pot and bring to a boil. Cover, reduce heat to low, and simmer 20 minutes. Place lentils in a pot with remaining 1 1/2 cups water, and bring to a boil. Cook 15 minutes, or until tender."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium heat, and stir in onion and garlic. Mix in tomato, celery, carrots, zucchini, and 1/2 the tomato sauce. Season with 1/2 the basil, 1/2 the oregano, 1/2 the cumin, salt, and pepper. Cook until vegetables are tender."
    },
    {
      "position": 4,
      "text": "Mix rice, lentils, and vegetables in a casserole dish. Top with remaining tomato sauce and sprinkle with remaining basil, oregano, and cumin."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "84e28d80-bcf2-5453-98be-afd9b283ac7b",
  "slug": "isaacs-carrot-cake",
  "name": "Isaac's Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "This light and wonderfully moist carrot cake contains a surprise treat inside: mandarin oranges!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13x2-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking soda, ground cinnamon, salt, and nutmeg together in a bowl. Beat carrots, mandarin oranges, oil, eggs, vanilla extract, and orange zest into flour mixture with an electric mixer until batter is smooth, about 2 minutes. Pour batter into prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 40 to 50 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

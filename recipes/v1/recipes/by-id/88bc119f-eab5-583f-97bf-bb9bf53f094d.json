  "id": "88bc119f-eab5-583f-97bf-bb9bf53f094d",
  "slug": "lemon-poppyseed-dressing",
  "name": "Lemon Poppyseed Dressing",
  "recipe_type": "salad",
  "brief_description": "Lemon juice, onion, and Dijon mustard provide a complexity of flavors in this poppy seed salad dressing you can make at home in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend sugar, lemon juice, onion, Dijon mustard, and salt in a blender until smooth. Stream canola oil in a thin stream into the mixture while blender is running. Add poppy seeds and pulse blender a few times, just to mix seeds into the dressing."
    }
  ],
  "servings": 12,

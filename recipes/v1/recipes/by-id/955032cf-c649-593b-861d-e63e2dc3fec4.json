  "id": "955032cf-c649-593b-861d-e63e2dc3fec4",
  "slug": "corned-beef-cheese-ball",
  "name": "Corned Beef Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This corned beef and cream cheese ball is rolled in pecans and is great served with crackers. It is perfect party food!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese, corned beef, green onions, mayonnaise, Worcestershire sauce, and horseradish in a bowl until thoroughly mixed."
    },
    {
      "position": 2,
      "text": "Shape cream cheese mixture into a ball."
    },
    {
      "position": 3,
      "text": "Place pecans into a shallow bowl. Roll and coat ball in chopped pecans. Refrigerate until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

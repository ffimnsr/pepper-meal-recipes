  "id": "837c7b40-5a41-5811-b73d-3e712c661aa2",
  "slug": "quick-tofu-stir-fry",
  "name": "Quick Tofu Stir Fry",
  "recipe_type": "main",
  "brief_description": "This crispy tofu stir fry with veggies, green onions, and Chinese black bean sauce is easy to make in minutes for a vegan meal packed with flavor.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat peanut oil in a wok over medium-high heat. Crumble the drained tofu and stir-fry until crispy, about 5 minutes. Remove tofu with a slotted spoon and drain on a paper towel."
    },
    {
      "position": 2,
      "text": "Add spring onions and frozen vegetables. Stir-fry until crisp and heated throughout, about 5 minutes. Remove from wok and add to the tofu."
    },
    {
      "position": 3,
      "text": "Pour black bean sauce and vegetable broth into the wok. Stir together and cook until sauce is hot and has thickened, 3 to 5 minutes. Return tofu and vegetables to the wok; toss well to coat. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "84be65ae-bf9e-5efb-b1db-f12c67488b0a",
  "slug": "creamy-asparagus-and-mushroom-pasta-recipe-8682796",
  "name": "Creamy Asparagus and Mushroom Pasta",
  "recipe_type": "side",
  "brief_description": "This creamy asparagus and mushroom pasta is a delicious meatless main dish for 4, or a fantastic side for 6, great to go with chicken or chops.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to boil. Add fettuccine and cook until tender with a bite, 7 to 10 minutes. Remove fettuccine to a colander to drain, and reserve pasta water."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil and butter in a large nonstick skillet over medium heat. When butter has melted, swirl the skillet to mix with the oil."
    },
    {
      "position": 3,
      "text": "Add asparagus and shallot to the skillet and cook, stirring, 2 to 3 minutes. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Add mushrooms and cook, stirring, about 2 minutes. Add garlic and Italian seasoning and cook an additional 30 seconds."
    },
    {
      "position": 5,
      "text": "Stir in heavy cream and bring to a boil. Add grated Parmesan cheese and stir until melted. See note. Stir in 1/4 to 1/2 cup reserved pasta water, if desired. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

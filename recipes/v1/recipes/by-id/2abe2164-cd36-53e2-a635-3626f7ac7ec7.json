  "id": "2abe2164-cd36-53e2-a635-3626f7ac7ec7",
  "slug": "slow-cooker-oxtail-stew",
  "name": "Slow Cooker Oxtail Stew",
  "recipe_type": "soup",
  "brief_description": "A slow cooker oxtail recipe to pull out for any occasion. The meat is cooked to perfection with carrots, celery, and potatoes in a rich, hearty stew.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Sear oxtail for 4 minutes. Flip and continue cooking until browned on all sides, about 4 minutes. Transfer oxtail to a slow cooker."
    },
    {
      "position": 3,
      "text": "Add potatoes, carrots, celery, onion, tomato sauce, beef broth, red wine, parsley, Worcestershire sauce, thyme, and paprika."
    },
    {
      "position": 4,
      "text": "Cook on Low for 7 hours. Add mushrooms and peas. Cook for 1 additional hour."
    },
    {
      "position": 5,
      "text": "Ladle into bowls and season with salt and pepper."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 490,

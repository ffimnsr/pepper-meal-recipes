  "id": "a9f13ee4-b345-523b-ad4d-f233e14c415c",
  "slug": "orange-jello-salad-recipe-11756063",
  "name": "My Aunt Faye\u2019s Jell-O Salad Is The Most-Coveted Recipe In My Family\u2014and It's So Easy To Make",
  "recipe_type": "salad",
  "brief_description": "My aunt Faye's orange Jell-O salad is a staple in our house - crushed pineapple, orange-flavored Jell-O, cream cheese, whipped topping and chopped pecans is all you need for this treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place crushed pineapple (do not drain) in a large heat-safe bowl. Microwave on HIGH for 30 seconds or until warmed through. Remove from Microwave, add orange-flavored gelatin, and stir until it is mostly dissolved."
    },
    {
      "position": 3,
      "text": "Carefully add boiling water to pineapple mixture and stir until Jell-O mixture is completely dissolved."
    },
    {
      "position": 4,
      "text": "Add cream cheese to a bowl and beat with an electric mixer until light and fluffy. You can also use a standalone mixer with a paddle attachment."
    },
    {
      "position": 5,
      "text": "Add cream cheese to Jell-O-pineapple mixture and beat on low until smooth; fold in whipped topping. If any clumps remain, beat on low until desired consistency is reached."
    },
    {
      "position": 6,
      "text": "Fold in pecans; cover with plastic wrap and refrigerate until completely set and firm to the touch, at least 4 hours and up to overnight."
    },
    {
      "position": 7,
      "text": "Serve chilled."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "27422b83-2a5c-5811-9e95-453dc6bf648a",
  "slug": "low-carb-almond-shortbread-cookies",
  "name": "Low-Carb Almond Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These low-carb, almond-flour and butter shortbread cookies are quick and easy to make--a perfect, crispy treat without the guilt of high carbs.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix almond flour, sweetener, and salt together in a small bowl with a fork. Add butter, egg white, and vanilla extract; continue mixing with a fork. Place in the freezer to help it harden for 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper or use a silicone baking mat."
    },
    {
      "position": 3,
      "text": "Remove batter from freezer. Measure out 1 teaspoon at a time; roll into balls and place on the prepared baking sheet. Place plastic wrap on the bottom of a glass and roll dough balls flat."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until light, golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

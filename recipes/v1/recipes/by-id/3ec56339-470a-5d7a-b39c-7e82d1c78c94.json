  "slug": "chili-sauce",
  "name": "Homemade Chili Sauce",
  "recipe_type": "side",
  "brief_description": "Chili sauce is easy to make at home in a flash with just 4 simple ingredients: tomato sauce, brown sugar, vinegar, and chili powder.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir tomato sauce, brown sugar, vinegar, and chili powder together in a mixing bowl until thoroughly blended. Season to taste with chili flakes."
    },
    {
      "position": 3,
      "text": "Pour into a covered container; refrigerate until ready to use."
    }
  ],
  "servings": 10,

  "id": "ca3f3633-06c4-5532-bcbd-f82d3a50857a",
  "slug": "basic-british-scones",
  "name": "Basic British Scones",
  "recipe_type": "breakfast",
  "brief_description": "This English scones recipe is easy to make in one bowl for tender, melt-in-your-mouth scones. Delicious with jam and clotted cream for afternoon tea.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift flour, cream of tartar, baking soda, and salt into a large bowl."
    },
    {
      "position": 3,
      "text": "Rub in butter until the mixture resembles fine breadcrumbs. Stir in sugar and enough milk to mix to a soft dough."
    },
    {
      "position": 4,
      "text": "Turn dough onto a floured surface, fold over 2 or 3 times, then roll out to a 3/4-inch thickness. Cut into 2-inch rounds and place on the prepared baking sheet; brush tops with milk to glaze."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until scones are risen and golden on top, about 10 minutes. Cool scones on a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

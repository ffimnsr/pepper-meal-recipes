  "schema_version": 1,
  "id": "3ffa0ea7-4e84-54a8-895e-6de67b3b8d33",
  "slug": "foolproof-flat-iron-steaks",
  "name": "Foolproof Flat Iron Steaks",
  "recipe_type": "main",
  "brief_description": "This recipe for flat iron steaks calls for a mixture of balsamic vinegar, garlic, and thyme. It is basically foolproof.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place steaks, balsamic vinegar, olive oil, green onions, garlic, soy sauce, thyme, mustard, and black pepper in an extra large resealable plastic bag, squeeze out excess air, and seal the bag. Knead the bag with your hands to distribute ingredients evenly and completely coat the steaks. Marinate in the refrigerator for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat grill for medium-high heat and lightly oil the grate. Remove steaks from refrigerator and let sit at room temperature for 10 minutes."
    },
    {
      "position": 3,
      "text": "Remove steaks from bag and discard marinade."
    },
    {
      "position": 4,
      "text": "Cook steaks on the preheated grill until they start to firm and are reddish-pink and juicy in the center, 6 to 7 minutes per side. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C). Remove steaks to a plate and let rest for 5 minutes before slicing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

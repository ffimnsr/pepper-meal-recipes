  "id": "d8b10b50-6445-5baf-96f7-8962d95323b6",
  "slug": "pumpkin-shortbread-cookies",
  "name": "Pumpkin Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "This spicy pumpkin shortbread cookie recipe is made with pumpkin pur\u00e9e, making them slightly softer than your average shortbread, but just as tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, pumpkin pie spice, salt, and baking soda together in a bowl until combined."
    },
    {
      "position": 2,
      "text": "Beat butter in a large bowl with an electric mixer until smooth; beat in \u00bd cup plus 2 tablespoons confectioners\u2019 sugar until smooth. Beat in pumpkin pur\u00e9e and vanilla extract on medium-high speed until completely incorporated. Beat in \u00bd flour mixture until just combined; beat in remaining \u00bd flour mixture until just combined."
    },
    {
      "position": 3,
      "text": "Cover the bowl with plastic wrap; chill in the refrigerator, about 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 5,
      "text": "Roll dough out on a lightly floured surface to \u00bc-inch thickness; cut into 1x2-inch rectangles using a pizza cutter or pastry wheel. Poke 3 holes into each cookie using the back of a bamboo skewer. Place cookies \u00bd inch apart on the prepared baking sheets: sprinkle with white sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are golden, 10 to 15 minutes. Cool on the baking sheet briefly before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

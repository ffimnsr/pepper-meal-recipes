  "id": "a70ddc51-b63c-5437-a68a-72460f89fc1e",
  "slug": "easy-french-bread-lasagna-boats-recipe-12001914",
  "name": "Easy French Bread Lasagna Boats",
  "recipe_type": "appetizer",
  "brief_description": "These easy French bread lasagna boats deliver all the comforting flavors of classic lasagna\u2014no noodles required. Crusty French rolls are layered with meaty spaghetti sauce, Parmesan, and mozzarella cheese, then baked until hot, melty, and toasty. Quick and simple to make, they\u2019re perfect for weeknight dinners, game day, or anytime you\u2019re craving lasagna without all the work.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Using a sharp knife, carve out a large V shape off the top of the loaf, and hollow out any thicker bread leftover to make a fairly even shell. Brush the inside of the shell with melted butter. Sprinkle with garlic."
    },
    {
      "position": 3,
      "text": "Bake shells in the preheated oven for 10 minutes. Remove and let cool slightly."
    },
    {
      "position": 4,
      "text": "Layer each shell with 1 tablespoon sauce, spreading it evenly over the bottom of the shell. Sprinkle with mozzarella cheese, followed by Parmesan. Repeat layers with remaining sauce and cheese."
    },
    {
      "position": 5,
      "text": "Bake in the oven until golden brown, about 10 minutes. Remove from the oven and garnish with parsley."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

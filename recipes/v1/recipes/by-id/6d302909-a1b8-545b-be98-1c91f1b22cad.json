  "id": "6d302909-a1b8-545b-be98-1c91f1b22cad",
  "slug": "bacon-wrapped-jalapeno-poppers",
  "name": "Bacon-Wrapped Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These jalape\u00f1o poppers are filled with a blend of cream cheese and Cheddar cheese in this easy to make, crowd-pleasing, bacon-wrapped appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Mix cream cheese and Cheddar cheese together in a bowl until evenly blended. Fill each jalape\u00f1o half with cheese mixture."
    },
    {
      "position": 3,
      "text": "Put halves back together and wrap each stuffed pepper with a slice of bacon. Arrange bacon-wrapped jalape\u00f1o peppers on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bacon is crispy, 25 to 35 minutes."
    },
    {
      "position": 5,
      "text": "Serve poppers hot with your favorite dipping sauce. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

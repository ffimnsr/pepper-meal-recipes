  "id": "80d19b13-30ab-5480-b12b-03330f8f29cb",
  "slug": "bloody-mary-pasta-salad-recipe-11720500",
  "name": "Bloody Mary Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This bloody mary pasta salad brings the magic of the cocktail to a pasta salad and is surprisingly delicious! Bloody mary mix is a great base for a vinaigrette, and with extra horseradish, this dressing is just made for pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil, add rotini, and cook until tender with a bite, 9 to 11 minutes. Drain well and arrange on a large rimmed baking sheet to cool to room temperature, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, add bacon to a large skillet over medium heat; cook, stirring often, until browned and crisp, about 10 minutes. Transfer to a paper towel-lined plate and discard drippings."
    },
    {
      "position": 4,
      "text": "Whisk together bloody mary mix, oil, horseradish, and pepperoncini brine in a medium bowl until emulsified. Set aside."
    },
    {
      "position": 5,
      "text": "Combine cooled pasta, cooked bacon, cherry tomatoes, celery, Cheddar, olives, and sliced pepperoncini in a large bowl; pour dressing over pasta mixture and toss to coat. Serve immediately or cover and refrigerate, stirring occasionally, until flavors meld, about 1 hour. Recipe developed by Julia Levy"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "e50040a8-f030-5c40-8917-822c6a87dcd7",
  "slug": "hawaiian-pineapple-upside-down-cake",
  "name": "Hawaiian Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This pineapple upside-down cake recipe features coconut flakes, cherries, banana, and macadamia nuts for a gorgeous and delicious tropical dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour melted butter into a 9x13-inch baking dish. Sprinkle brown sugar evenly over butter. Arrange pineapple rings in 2 rows in the baking dish."
    },
    {
      "position": 3,
      "text": "Sprinkle nuts, 1/4 cup coconut, and chopped pineapple between the rows of pineapple rings. Place a cherry in each pineapple ring, then scatter remaining 4 cherries over coconut mixture. Set the baking dish aside."
    },
    {
      "position": 4,
      "text": "Whisk together pineapple juice, coconut water, oil, and eggs in a large bowl. Stir in mashed banana, white cake mix, and remaining 1/4 cup coconut until well blended. Pour batter slowly into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Allow cake to cool in the baking dish for 10 minutes, then run a paring knife around the edges."
    },
    {
      "position": 6,
      "text": "Cover the baking dish with a large serving plate and invert cake onto the plate so pineapple slices face up."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

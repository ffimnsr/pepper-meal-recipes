  "id": "144904a4-8aeb-5d55-929f-5618d26d6c92",
  "slug": "trader-joes-spicy-garlic-pepperoni-pan-pizza-recipe-8304190",
  "name": "This Viral Pan Pizza Recipe Uses Your 9x13 and Easy Store-Bought Shortcuts",
  "recipe_type": "main",
  "brief_description": "Learn how to make the viral Trader Joe's pizza that takes store-bought dough and sauces and turns them into a delicious meal in your handy 9x13 pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Remove pizza dough from refrigerator 20 minutes before making pizza."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Coat a metal 9x13-inch baking pan with cooking spray."
    },
    {
      "position": 3,
      "text": "Place pizza dough in the prepared baking pan; stretch to reach corners. If it's hard to stretch dough and it springs back, place a clean kitchen towel over baking pan and let dough relax until pliable enough to stretch, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Spread Garlic Spread-Dip evenly over dough, edge to edge, with a spoon or small offset spatula. Dollop with Bomba Hot Pepper Sauce; spread evenly over Garlic Spread-Dip."
    },
    {
      "position": 5,
      "text": "Place \u00bd salami and \u00bd pepperoni over sauces; sprinkle with \u00be cup mozzarella. Top with remaining \u00bd each salami and pepperoni; sprinkle with remaining mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Dollop pesto, with a small spoon, about \u00bd teaspoon at a time, over pizza."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until dough has puffed, is golden brown around edges and bottom, and cheese has melted, 15 to 20 minutes, rotating pan back to front halfway through."
    },
    {
      "position": 8,
      "text": "Carefully transfer pizza to a cutting board using a large spatula. Sprinkle with basil leaves, slice, and serve. Recipe developed by Marianne Williams"
    }
  ],
  "servings": 4,

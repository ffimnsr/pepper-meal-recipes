  "id": "3df47820-cc10-5bf7-bbbd-b1f3793561f9",
  "slug": "fried-rice-i",
  "name": "Fried Rice",
  "recipe_type": "main",
  "brief_description": "Fried rice is a favorite. In this easy recipe, white rice is tossed with eggs, bacon, soy sauce, green peas, and green onions.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan, bring water to a boil. Add rice and stir. Reduce heat, cover, and simmer for 20 minutes. Meanwhile, season eggs with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat 1 teaspoon oil in small frying pan. Pour in eggs. Coat the bottom of the pan evenly with eggs; cook for about 3 minutes. Flip eggs, cook 1 minute more, and transfer them to a cool surface. Let cool, then cut into thin slices. Set aside."
    },
    {
      "position": 3,
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly browned. Drain, crumble, and set aside."
    },
    {
      "position": 4,
      "text": "Spoon remaining 2 teaspoons oil into the skillet with the bacon fat. Stir in cooked rice; break up any clumps and toss to coat with oil. Stir in bacon, soy sauce, peas, eggs, and green onions. Stir and cook until heated through, approximately 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

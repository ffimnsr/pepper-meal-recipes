  "id": "155c2369-7c3a-57e2-8bcb-050470615a11",
  "slug": "japanese-soup-with-tofu-and-mushrooms",
  "name": "Japanese Soup with Tofu and Mushrooms",
  "recipe_type": "soup",
  "brief_description": "This Japanese mushroom soup is a quick, healthy dish that is very popular and comforting. It's flavored with dashi, miso, shiitake mushrooms, and soy.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Bring dashi stock to a boil in a medium saucepan; reduce heat to simmer, add mushrooms, and cook for 3 minutes."
    },
    {
      "position": 2,
      "text": "Mix miso paste and soy sauce together in a small bowl; stir into stock along with tofu. Simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Serve topped with green onion."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

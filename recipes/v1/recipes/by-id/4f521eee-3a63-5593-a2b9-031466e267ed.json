  "id": "4f521eee-3a63-5593-a2b9-031466e267ed",
  "slug": "creamy-chicken-marsala",
  "name": "Creamy Chicken Marsala",
  "recipe_type": "soup",
  "brief_description": "This creamy chicken Marsala features tender cremini mushrooms and an easy sauce made from condensed cream of mushroom soup and Marsala wine.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium-high heat. Season chicken with salt and pepper, then add to hot oil and cook until browned, 3 to 5 minutes. Stir in onion and mushrooms; continue cooking until onion is translucent, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Pour condensed soup and Marsala wine over chicken mixture; cook until hot and chicken is no longer pink in the middle, 3 to 5 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "slug": "virgin-strawberry-daiquiri",
  "name": "Virgin Strawberry Daiquiri",
  "recipe_type": "drink",
  "brief_description": "This virgin strawberry daiquiri recipe makes the best drink to serve and enjoy at parties or on a hot day \u2014 sans alcohol. Easy to make in the blender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine lemon-lime soda, sugar, strawberries, and lemon juice in a blender; add ice and blend until smooth."
    },
    {
      "position": 3,
      "text": "Pour into a fancy glass to serve."
    }
  ],

  "id": "3e3977dc-810d-5d3e-8317-fd3775da9f09",
  "slug": "pina-colada-macaroons",
  "name": "Pina Colada Macaroons",
  "recipe_type": "dessert",
  "brief_description": "In this pi\u00f1a colada macaroons recipe, bits of pineapple and macadamia nuts, and just a hint of rum take these chewy coconut macaroons to the tropics.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper or silicone mats."
    },
    {
      "position": 2,
      "text": "Combine coconut, pineapple, flour, macadamia nuts, and salt in a large bowl; stir in sweetened condensed milk, rum extract, and vanilla extract. Drop golf ball-sized scoops of dough 2 inches apart onto the prepared baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until coconut is toasted, 12 to 15 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "599e25e2-ecf5-54ae-930d-8e0c233f4467",
  "slug": "easy-paella",
  "name": "Easy Paella",
  "recipe_type": "main",
  "brief_description": "Paella is a classic Spanish dish made with saffron rice, chorizo sausage, chicken, and seafood served in a large skillet for a crowd-pleasing meal.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix olive oil, paprika, oregano, salt, and pepper for marinade in a glass bowl."
    },
    {
      "position": 3,
      "text": "Add chicken and stir to coat. Cover and refrigerate until needed."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons olive oil in a large skillet or paella pan over medium heat. Stir in garlic and pepper flakes, then stir in rice. Cook and stir until rice is coated with oil, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Add saffron threads, bay leaf, parsley, chicken stock, and lemon zest. Stir until well combined and bring to a boil. Reduce heat to medium-low, cover, and simmer for 20 minutes."
    },
    {
      "position": 6,
      "text": "While the rice is cooking, heat olive oil in a separate skillet over medium heat. Stir in marinated chicken and cook for 3 minutes. Add onion and cook until translucent, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Add bell pepper and sausage; cook and stir, breaking sausage up with a spatula, for 5 minutes. Add shrimp; cook and stir until shrimp are bright pink on the outside and the meat is opaque, about 2 minutes."
    },
    {
      "position": 8,
      "text": "Spread rice mixture onto a serving tray. Top with meat and seafood mixture."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

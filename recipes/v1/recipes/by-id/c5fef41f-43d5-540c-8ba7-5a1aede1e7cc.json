  "id": "c5fef41f-43d5-540c-8ba7-5a1aede1e7cc",
  "slug": "canadian-cheddar-soup-recipe-11885523",
  "name": "Canadian Cheddar Soup",
  "recipe_type": "soup",
  "brief_description": "This Canadian Cheddar soup, topped with crisp-fried bacon bits, is comforting and hearty. It will remind you of a pub-style soup, minus the lager.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a saucepan over medium heat until crisp, about 5 minutes. Remove and set aside, leaving about 1 tablespoon fat in the pan."
    },
    {
      "position": 2,
      "text": "Add butter to the pan. Saut\u00e9 shallot and celery until very soft, 5 to 6 minutes. Add garlic and cook for 30 seconds."
    },
    {
      "position": 3,
      "text": "Sprinkle in flour and cook, stirring constantly, for 1 to 2 minutes. Slowly whisk in broth, then milk. Bring just to a gentle simmer (be careful not to boil)."
    },
    {
      "position": 4,
      "text": "Reduce heat to low. Add cheese in small handfuls, stirring until melted and smooth."
    },
    {
      "position": 5,
      "text": "Stir in Worcestershire, hot sauce, and mustard. Season with pepper. Serve topped with reserved bacon."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

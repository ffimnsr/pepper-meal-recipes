  "id": "4fac4c1d-d35c-5b52-af04-da3fc37606a0",
  "slug": "no-bake-cheesecake-with-cool-whip",
  "name": "No-Bake Cheesecake with Cool Whip",
  "recipe_type": "dessert",
  "brief_description": "This easy no-bake cheesecake has an extra light and fluffy cream cheese and Cool Whip filling and can be topped with fresh fruit or fruit filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, sugar, vanilla extract, and lemon extract together in a large bowl with an electric mixer until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Fold in whipped topping."
    },
    {
      "position": 4,
      "text": "Pour mixture into graham cracker crust; smooth evenly."
    },
    {
      "position": 5,
      "text": "Top with pie filling. Refrigerate until firm, 2 to 3 hours."
    },
    {
      "position": 6,
      "text": "Slice and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,

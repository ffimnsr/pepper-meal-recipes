  "id": "3fa2c9ed-b6f9-5e25-9b52-b7acd1959aea",
  "slug": "orzo-and-chicken-stuffed-peppers",
  "name": "Orzo and Chicken Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "This recipe for orzo and chicken stuffed peppers makes a hearty meal. Try topping the tri-colored peppers with portobello mushrooms and green onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Coat insides bell pepper halves with cooking spray; place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until slightly tender, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat 2 tablespoons oil and 1 tablespoon butter in a skillet over medium heat. Add 3 green onions and garlic; cook and stir until fragrant, 2 to 3 minutes. Add chicken, 1 teaspoon black pepper, and cumin; cook until chicken is no longer pink in the center and juices run clear, 4 to 5 minutes. Add chicken broth and orzo; simmer until orzo is cooked through but firm to the bite and broth is absorbed, about 11 minutes. Spoon chicken-orzo mixture into bell peppers; sprinkle with Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, about 7 minutes."
    },
    {
      "position": 6,
      "text": "Heat 1 teaspoon oil and 1 teaspoon butter in the same skillet. Add portobello mushrooms and 1 green onion; cook and stir until tender, about 5 minutes. Season with salt and black pepper; spoon about 2 tablespoons onto each stuffed pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

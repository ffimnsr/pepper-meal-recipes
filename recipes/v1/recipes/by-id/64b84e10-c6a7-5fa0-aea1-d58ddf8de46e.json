  "id": "64b84e10-c6a7-5fa0-aea1-d58ddf8de46e",
  "slug": "yam-and-apple-casserole",
  "name": "Yam and Apple Casserole",
  "recipe_type": "dessert",
  "brief_description": "Perfect for the Thanksgiving holiday, yams and apples are baked with a sweet glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place yams in a large saucepan with enough water to cover. Bring to a boil, and cook 30 minutes, or until tender but firm. Drain, peel, and cut into 1/3 inch thick slices."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 9x13 inch baking dish."
    },
    {
      "position": 3,
      "text": "In a small saucepan over medium heat, melt the butter with the cornstarch and brown sugar. Mix in the apple juice, lemon juice, cinnamon, and allspice."
    },
    {
      "position": 4,
      "text": "Alternate layers of yams and apples in the prepared baking dish. Pour the apple juice mixture over the layers."
    },
    {
      "position": 5,
      "text": "Cover, and bake 1 hour in the preheated oven. Remove cover, and continue baking 30 minutes. Baste frequently with the juices from the pan to prevent drying."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,

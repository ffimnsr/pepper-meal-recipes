  "id": "591dc40d-79b6-5f5f-a115-54d286d34269",
  "slug": "moist-holiday-honeycake",
  "name": "Moist Holiday Honeycake",
  "recipe_type": "dessert",
  "brief_description": "Serve this moist honey cake for the Jewesh New Year of Rosh Hashanah and delight all of your guests with its fragrant aroma and yummy taste.",
  "cuisine": "Jewish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place an oven rack in an upper position in the oven. Preheat the oven to 350 degrees F (175 degrees C). Spray a 10-inch fluted tube pan (such as Bundt) with cooking spray."
    },
    {
      "position": 2,
      "text": "In a bowl, whisk together flour, baking powder, baking soda, salt, cinnamon, cloves, and nutmeg until thoroughly combined. In a separate large bowl, whisk together canola oil, honey, white and brown sugars, eggs, vanilla, coffee, orange juice, and whiskey. With an electric mixer, beat the flour mixture into the honey mixture just until thoroughly incorporated. Pour the batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake on the upper shelf of the preheated oven until golden brown and a toothpick inserted into the center comes out with moist crumbs, about 1 hour. Cool for 20 minutes in the pan before turning out onto a serving platter."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

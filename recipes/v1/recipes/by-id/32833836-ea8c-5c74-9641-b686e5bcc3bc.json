  "id": "32833836-ea8c-5c74-9641-b686e5bcc3bc",
  "slug": "south-african-koeksisters",
  "name": "South African Koeksisters",
  "recipe_type": "dessert",
  "brief_description": "Koeksisters (cake sisters) are South African donuts. In this recipe, the cakes deep-fried until golden brown, then soaked in a lemon and ginger syrup.",
  "cuisine": "Dutch African",
  "instructions": [
    {
      "position": 1,
      "text": "Make the syrup: Bring sugar, water, lemon zest, ginger, and lemon juice to a boil in a saucepan over medium-high heat. Reduce the heat to medium and cook for 10 minutes. Remove from the heat and cool syrup to room temperature, 30 to 45 minutes. Transfer to bowl, cover, and refrigerate until the flavors blend, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Make the koeksisters: Sift flour, baking powder, and salt into in a bowl. Add butter and rub with your fingertips until the mixture has a cornmeal texture. Add milk and stir until a smooth dough forms. Wrap dough in plastic wrap and let rest for at least 2 hours."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and roll into a 5x14-inch rectangle about 1/4-inch thick. Cut into 28 half-inch wide strips. Twist two strips together and pinch the ends to seal. Repeat with remaining strips. Cover with a clean cloth and let rest for 15 minutes."
    },
    {
      "position": 4,
      "text": "Heat 2 inches oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C). Set a wire rack over a baking sheet. Pour some of the cold syrup into a bowl; return remaining syrup to the refrigerator."
    },
    {
      "position": 5,
      "text": "Fry three koeksisters in hot oil until fragrant and golden brown, 2 to 5 minutes. Remove with a slotted spoon and immediately immerse in cold syrup for 10 seconds. Transfer to the wire rack to cool. Repeat to fry and dip remaining koeksisters, replenishing cold syrup as necessary."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

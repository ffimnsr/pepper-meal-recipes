  "id": "4597fe6c-a863-50bf-abea-945c69f2ae5a",
  "slug": "marry-me-chicken-salad-recipe-11830474",
  "name": "Marry Me Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This marry me chicken salad with bacon, sun-dried tomatoes, and Parmesan, is perfectly balanced, slightly sweet, and utterly irresistible. It is great on its own, over fresh greens, or as a sandwich filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Add chicken, bacon, sun-dried tomatoes, and Parmesan cheese to a bowl."
    },
    {
      "position": 3,
      "text": "Whisk kewpie mayo, lemon juice, basil, garlic, oregano, and thyme together in a small bowl or cup. Taste; season with salt."
    },
    {
      "position": 4,
      "text": "Pour dressing over chicken; toss to combine evenly. Serve immediately, or chill for 30 minutes to overnight for flavors to meld."
    }
  ],
  "servings": 2,

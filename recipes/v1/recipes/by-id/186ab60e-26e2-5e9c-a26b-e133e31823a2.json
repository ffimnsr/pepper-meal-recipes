  "id": "186ab60e-26e2-5e9c-a26b-e133e31823a2",
  "slug": "the-best-chocolate-glaze",
  "name": "The Best Chocolate Glaze",
  "recipe_type": "dessert",
  "brief_description": "This chocolate glaze for cake is made with 5 ingredients for a quick and easy sweet topping, great for pouring over cakes, brownies, and ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt cocoa and butter together in a small saucepan over low heat, stirring until smooth, about 5 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Whisk in confectioners' sugar and vanilla extract. Gradually whisk in hot water, 1 teaspoon at a time, until glaze is thick and smooth."
    }
  ],
  "servings": 12,

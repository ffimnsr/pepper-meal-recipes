  "slug": "almond-milk-overnight-chia-oats",
  "name": "Almond Milk Overnight Chia Oats",
  "recipe_type": "breakfast",
  "brief_description": "Try these overnight oats with almond milk for a quick and easy, healthy yet tasty, on-the-go breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together almond milk, oats, chia seeds, honey, cinnamon, vanilla, and salt in a jar or container with a lid. Cover and refrigerate for 8 hours to overnight."
    }
  ],

  "id": "4b02a188-0d10-5e11-906f-c9c7ea013457",
  "slug": "bang-bang-salmon-recipe-8748368",
  "name": "Bang Bang Salmon",
  "recipe_type": "salad",
  "brief_description": "This bang bang salmon, an easy, sweet-spicy sheet pan preparation, is accompanied by a quick cucumber avocado salad.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place salmon filets on the prepared baking sheet and sprinkle with 1/8 teaspoon salt."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, sweet chili sauce, and Sriracha (R) together in a small bowl. Spoon half of sauce over filets; reserve remaining sauce for serving."
    },
    {
      "position": 4,
      "text": "Bake salmon in the preheated oven for 8 minutes. Turn broiler on High and broil until fish flakes easily with a fork, about 6 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, for salad, combine cucumber, avocado, cilantro, 1 1/2 teaspoons salt, and lime juice in a separate bowl."
    },
    {
      "position": 6,
      "text": "Drizzle reserved sauce over salmon, and serve with cucumber salad."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

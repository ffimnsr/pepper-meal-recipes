  "id": "7472e265-0dd2-5973-8d5b-a89b7b91472d",
  "slug": "easy-weeknight-chicken-cacciatore",
  "name": "Easy Weeknight Chicken Cacciatore",
  "recipe_type": "main",
  "brief_description": "Hearty, satisfying, and easy enough for a weeknight, this chicken cacciatore recipe is ready to serve over rice or pasta in just about an hour.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Dip chicken pieces in flour and shake off excess."
    },
    {
      "position": 2,
      "text": "Heat oil in a 10-inch skillet over medium-high heat. Add chicken and brown well, 4 to 5 minutes per side. Remove chicken from the pan and set aside. Drain most of the oil from the skillet, leaving about 1/8 inch."
    },
    {
      "position": 3,
      "text": "Add bell pepper, onion, garlic, oregano, pepper flakes, salt, and pepper to the skillet. Saut\u00e9, stirring constantly, for 2 minutes. Pour in spaghetti sauce and add enough water to thin mixture just a little; sauce will thicken as it cooks. Stir well and add chicken to the sauce. Spoon sauce over chicken to coat and bring to a simmer."
    },
    {
      "position": 4,
      "text": "Cover, lower heat, and cook, turning chicken and scraping the bottom of the pan often, until chicken is no longer pink at the bone and the juices run clear, about 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

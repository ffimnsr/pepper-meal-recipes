  "id": "5b212aa0-424d-5885-ac85-cd36c7ad7b9a",
  "slug": "antipasto-platter",
  "name": "Antipasto Platter",
  "recipe_type": "appetizer",
  "brief_description": "For this antipasti platter, a variety of cheeses and deli meat slices are layered with vegetables, peppers, and spices to create a mighty party platter that's filled with exciting flavors and easy on the eyes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Remove large outer leaves from the heads of lettuce. Arrange approximately 1/3 in a layer on a large serving platter. Sprinkle with 1/3 garlic powder, 1/3 oregano, and desired amount of dressing. Layer with ham and Provolone."
    },
    {
      "position": 2,
      "text": "Layer Provolone with another 1/3 of the lettuce, 1/3 garlic powder, 1/3 oregano, desired amount of dressing, salami, and capacola."
    },
    {
      "position": 3,
      "text": "Repeat layering with remaining lettuce, garlic powder, oregano, dressing, pepperoni, prosciutto, and roast beef."
    },
    {
      "position": 4,
      "text": "Layer with mushrooms, artichokes, roasted red peppers, black olives, pepperoncini, and green olives. Drizzle with more dressing as desired."
    },
    {
      "position": 5,
      "text": "Top with Gorgonzola, mozzarella, and Parmesan. Cover and chill in the refrigerator until serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

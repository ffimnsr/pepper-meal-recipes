  "slug": "raspberry-party-shots",
  "name": "Raspberry Party Shots",
  "recipe_type": "drink",
  "brief_description": "These party shots made with raspberry vodka and raspberry gelatin make for a colorful, fun, and fruity cocktail for holiday parties.",
  "cuisine": "North American American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir gelatin into boiling water until dissolved. Pour in ice water and vodka; mix well. Pour into party shot glasses. Chill in the refrigerator for 1 to 2 hours, until set."
    }
  ],

  "id": "d1b54699-6481-5105-b459-071085c8d7d4",
  "slug": "crab-rangoon-nachos-recipe-12007047",
  "name": "Crab Rangoon Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These crab Rangoon nachos have all the flavor of crab Rangoon without the work of filling, folding, and frying individual wontons\u2014in fact, there\u2019s no frying at all! Crisp baked wonton chips are piled high with a warm, creamy imitation crab topping, sweet chili drizzle, and fresh garnishes for an irresistible appetizer or snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) with racks in the upper and lower third positions. Coat 2 large rimmed baking sheets with cooking spray. Cut wonton wrappers in half on the diagonal to create triangles. Arrange in a single layer on prepared baking sheets; coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until golden and crisp, 6 to 8 minutes, rotating baking sheets top to bottom and back to front halfway through. Let cool on baking sheets slightly, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir together crabmeat, cream cheese, scallions, Sriracha, soy sauce, lemon juice, sugar, garlic powder, grated garlic, and salt in a bowl until combined."
    },
    {
      "position": 4,
      "text": "Arrange baked wonton chips in an even layer on a large rimmed baking sheet. Dollop crab mixture evenly over chips."
    },
    {
      "position": 5,
      "text": "Bake on upper third rack in preheated oven until crab mixture is warmed through, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven, drizzle evenly with sweet chili sauce, and garnish with additional scallions, cilantro, jalapenos, and sesame seeds, as desired. Serve immediately. Recipe developed by Nicole Hopper"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

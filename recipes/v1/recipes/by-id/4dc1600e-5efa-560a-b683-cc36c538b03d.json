  "id": "4dc1600e-5efa-560a-b683-cc36c538b03d",
  "slug": "no-fail-pie-crust-ii",
  "name": "Easy No-Fail Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "This pie crust uses vinegar and lard to keep the crust from becoming tough. This easy recipe makes enough dough for four tender and flaky pie crusts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, salt, and baking powder together in a bowl. Cut in lard until the mixture resembles coarse meal."
    },
    {
      "position": 2,
      "text": "Whisk water, egg, and vinegar together in another bowl; add to dry ingredients and stir until dough is thoroughly moistened and forms a ball."
    },
    {
      "position": 3,
      "text": "Divide dough into fourths; roll each portion into a ball and flatten into a disk."
    },
    {
      "position": 4,
      "text": "If using immediately, roll each disk on a lightly floured surface to fit your pie pan, then bake as directed in your recipe."
    },
    {
      "position": 5,
      "text": "If using later, wrap each disk tightly in plastic wrap. Refrigerate for up to three days, or place wrapped disks in a freezer bag and freeze for up to 3 months."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

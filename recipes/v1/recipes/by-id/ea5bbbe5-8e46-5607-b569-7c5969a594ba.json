  "id": "ea5bbbe5-8e46-5607-b569-7c5969a594ba",
  "slug": "highway-cafe-chess-pie",
  "name": "Highway Cafe Chess Pie",
  "recipe_type": "dessert",
  "brief_description": "I obtained this recipe 40-years ago from the cook at the Highway Cafe in Scappoose, Oregon. I have never found its equal. Whenever I serve it, I am always asked for the recipe.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Soak raisins in boiling water for 10 minutes. Drain, and chop."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together the sugar and butter until light and fluffy. Beat in the eggs one at a time, mixing well after each one. Stir in the vanilla, sour cream, walnuts and chopped raisins. Pour into the baked pie shell."
    },
    {
      "position": 3,
      "text": "Bake for 30 minutes in the preheated oven, or until firm in the center. Allow to cool completely before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

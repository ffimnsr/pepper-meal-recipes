  "id": "3dc8a4c3-dafe-588e-b134-a619c56bae74",
  "slug": "hearts-of-palm-risotto",
  "name": "Hearts of Palm Risotto",
  "recipe_type": "main",
  "brief_description": "This hearts of palm rice recipe is a lovely vegetarian risotto with onion, white wine, and Parmesan for a delicious, subtle change from the norm.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon butter and olive oil in a large, heavy-bottomed saucepan over medium-high heat. Cook and stir onion in hot butter-oil until onion begins to turn golden brown at the edges, about 2 minutes. Pour in rice; stir until rice is coated in oil and has started to toast, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium and stir in white wine. Cook until mostly evaporated, then stir in 1/3 of the boiling vegetable broth; continue stirring until incorporated. Repeat this process twice more, stirring constantly. Incorporating the broth should take 15 to 20 minutes total."
    },
    {
      "position": 3,
      "text": "When rice is mostly tender, but still has a very slight crunch, stir in hearts of palm and Parmesan cheese until incorporated; season with salt and pepper. Cook for 1 more minute to heat through, then stir in parsley and remaining 1 tablespoon butter. Serve hot."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

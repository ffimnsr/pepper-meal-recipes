  "id": "715b8a7f-e8c3-536f-8223-64a2fabcba53",
  "slug": "creamy-lemon-caesar-pasta-salad-recipe-12019168",
  "name": "Creamy Lemon Caesar Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy lemon Caesar pasta salad combines peas, Sweetie Drop peppers, fresh parsley, and Parmesan cheese in a bright, lemony Caesar-inspired dressing. It\u2019s a fresh, easy summer pasta salad that\u2019s perfect for picnics, potlucks, barbecues, or meal prep.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For dressing, add mayonnaise, yogurt, olive oil, lemon juice, lemon zest, Dijon mustard, Worcestershire sauce, garlic, Parmesan, and anchovies to the jar of a high powered blender; whisk together until smooth, about 30 seconds. Season with salt and pepper. Refrigerate until needed."
    },
    {
      "position": 2,
      "text": "Meanwhile, for salad, bring a large pot of salted water to a boil and cook pasta until just al dente according to package directions, 8 to 12 minutes. Drain pasta well; cool to room temperature, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Toss pasta with dressing in a large bowl. Fold in peas, 1/2 cup Parmesan cheese, parsley, and Sweety Drop peppers. Refrigerate for at least 1 hour before serving."
    },
    {
      "position": 4,
      "text": "To serve, sprinkle with remaining Parmesan and freshly cracked pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

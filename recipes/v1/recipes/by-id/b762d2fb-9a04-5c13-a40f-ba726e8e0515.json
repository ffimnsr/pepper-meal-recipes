  "id": "b762d2fb-9a04-5c13-a40f-ba726e8e0515",
  "slug": "no-bake-cookies-iii",
  "name": "No-Bake Chocolate Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "Make no-bake chocolate oatmeal cookies with peanut butter and cocoa without turning on the oven for a treat that the kids will love to help with.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring sugar, butter, milk, cocoa, and salt to a full rolling boil in a saucepan for 2 minutes."
    },
    {
      "position": 3,
      "text": "Add quick-cooking oats, peanut butter, and vanilla; mix well."
    },
    {
      "position": 4,
      "text": "Working quickly, drop by teaspoonfuls onto waxed paper. Let cookies cool until firm. You can refrigerate them for 20 minutes to speed up setting."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

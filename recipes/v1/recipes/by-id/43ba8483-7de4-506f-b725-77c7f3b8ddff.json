  "id": "43ba8483-7de4-506f-b725-77c7f3b8ddff",
  "slug": "pork-rub-rubbed-and-baked-pork-chops",
  "name": "Pork Rub Rubbed and Baked Pork Chops",
  "recipe_type": "main",
  "brief_description": "This pork chop rub recipe is quick and easy to prep with sugar and spice-shelf staples to bring out the flavor in these oven-baked pork chops.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix paprika, sugar, salt, pepper, garlic powder, onion powder, and cayenne pepper together in a wide, shallow bowl."
    },
    {
      "position": 3,
      "text": "Dredge pork chops in the spice mixture to coat and arrange on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake chops in preheated oven until no longer pink in the center, about 20 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

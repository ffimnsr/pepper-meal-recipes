  "id": "2044fb9a-5c96-52ce-a9ed-ff409f24b0ef",
  "slug": "buffalo-chicken-bites",
  "name": "Buffalo Chicken Bites",
  "recipe_type": "appetizer",
  "brief_description": "These crispy Buffalo chicken bites are delicious served with a garlicky hot sauce for a crowd-pleasing snack at your next game-day gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, cayenne pepper, salt, and pepper together in a medium bowl. Beat eggs in a separate bowl."
    },
    {
      "position": 3,
      "text": "Dip chicken pieces in beaten eggs; transfer chicken to flour mixture and coat completely. Heat oil in a large saucepan over medium heat."
    },
    {
      "position": 4,
      "text": "Fry coated chicken pieces in hot oil, working in batches, until no longer pink in the center, about 3 minutes per side. An instant-read thermometer inserted into the center of meat should read at least 165 degrees F (74 degrees C). Drain on a paper towel-lined plate."
    },
    {
      "position": 5,
      "text": "Combine hot sauce, garlic, and butter in a microwave-safe bowl; heat in the microwave until butter is melted and sauce is warm, about 1 minute."
    },
    {
      "position": 6,
      "text": "Serve hot sauce mixture as a dipping sauce or pour over chicken bites."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "09443201-0d9b-5c60-a0ff-a4f06efc1d44",
  "slug": "spiced-apple-topping-for-pancakes",
  "name": "Spiced Apple Topping for Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Full of fall flavor, this apple topping for pancakes can double as a dessert if served with ice cream or Greek yogurt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Combine flour, cinnamon, nutmeg, cloves, and salt in a small bowl."
    },
    {
      "position": 2,
      "text": "Grease a pie pan or 8-inch square baking pan with cooking spray. Place apple slices in the prepared pan and sprinkle with flour mixture. Drizzle milk, maple syrup, and vanilla over top; toss to coat."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until apples are tender (not mushy), 25 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

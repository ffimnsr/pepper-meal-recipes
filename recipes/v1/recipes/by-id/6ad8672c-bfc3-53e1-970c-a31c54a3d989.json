  "id": "6ad8672c-bfc3-53e1-970c-a31c54a3d989",
  "slug": "magic-vinaigrette-recipe-11933589",
  "name": "Magic Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This magic vinaigrette is the formula you need for homemade dressing. Mix it up quickly or keep it on hand to use on salad or roasted vegetables. The beauty of this dressing is that it is easily mixed and matched with whatever you have on hand\u2014just be sure to follow the method of balancing salt-fat-acid and it will be delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add extra virgin olive oil, champagne vinegar, Dijon, honey, salt, and 10 to 20 cranks of cracked pepper to a jar with a tight-fitting lid. This is optional, but add shallot or garlic if desired."
    },
    {
      "position": 2,
      "text": "Place the lid on the jar and shake until thoroughly combined and emulsified. (If you do not have a jar, simply use a bowl and whisk together with a small whisk or a fork.)"
    },
    {
      "position": 3,
      "text": "Taste and adjust following the salt-fat-acid triangle: If it tastes too salty , add a bit more extra virgin olive oil. If it tastes too acidic , add a bit more salt. If it tastes too fatty , add a bit more vinegar. If it needs a bit more sweetness , add a little more honey."
    },
    {
      "position": 4,
      "text": "Then re-mix and taste again."
    },
    {
      "position": 5,
      "text": "Set the vinaigrette aside to use on salad, over roasted vegetables or simply save for later. This will keep well in the fridge for up to 2 weeks."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

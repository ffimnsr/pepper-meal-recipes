  "id": "867c56ed-6a2d-5b05-8280-787c89580a90",
  "slug": "chef-johns-shakshuka",
  "name": "Chef John's Shakshuka",
  "recipe_type": "breakfast",
  "brief_description": "This shakshuka recipe makes a spicy tomato and bell pepper sauce simmered with soft-poached eggs on top for a delicious breakfast or anytime meal.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large, heavy skillet over medium-high heat. Add onion and mushrooms; season with salt. Cook and stir until mushrooms release all of their liquid and start to brown, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add bell pepper and jalapeño pepper. Cook and stir until peppers begin to soften, about 5 minutes. Season with cumin, paprika, turmeric, black pepper, and cayenne. Cook and stir to blend the flavors, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in tomatoes and water. Reduce heat to medium. Simmer uncovered, stirring occasionally, until vegetables are softened and sweet, 15 to 20 minutes. Add more water if sauce becomes too thick."
    },
    {
      "position": 4,
      "text": "Use a large spoon to make a depression in sauce for each egg. Crack an egg into a small ramekin and slide gently into an indentation; repeat with remaining eggs. Season eggs with salt and pepper. Cover and cook until eggs reach desired doneness."
    },
    {
      "position": 5,
      "text": "Top with feta cheese and parsley to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

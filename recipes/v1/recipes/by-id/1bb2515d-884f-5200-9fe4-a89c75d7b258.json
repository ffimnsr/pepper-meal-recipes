  "id": "1bb2515d-884f-5200-9fe4-a89c75d7b258",
  "slug": "irish-cream-loaf-cake-recipe-11920442",
  "name": "Irish Cream Loaf Cake",
  "recipe_type": "dessert",
  "brief_description": "This Irish cream loaf cake is studded with chocolate chips and topped with an Irish cream frosting. The loaf comes out moist but crumbly and almost feels like a cross between a cake and a soft cookie.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and line an 8x4-inch loaf pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together sugar and melted butter in a large bowl until smooth. Beat in eggs until fully combined. Stir in Irish cream liqueur and vanilla."
    },
    {
      "position": 3,
      "text": "Fold in flour, baking powder, and salt just until combined; do not overmix. Stir in chocolate chips. Spread batter evenly into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake until a toothpick inserted into the center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Cool loaf in the pan for 15 minutes, then remove from the pan and cool completely on a wire rack."
    },
    {
      "position": 6,
      "text": "Prepare the frosting: Combine cream cheese, powdered sugar, Irish cream liqueur, and salt in a bowl. Beat with an electric mixer on low speed until smooth, adding milk as needed to make a spreading consistency. Spread frosting over the cooled loaf. Slice and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

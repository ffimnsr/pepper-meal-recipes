  "instructions": [
    {
      "position": 1,
      "text": "Mix pineapple juice, grenadine, sugar, lemon juice, and instant tea powder together in a 2-gallon container; stir to dissolve sugar and tea powder. Add enough water to fill the container; stir to combine."
    }

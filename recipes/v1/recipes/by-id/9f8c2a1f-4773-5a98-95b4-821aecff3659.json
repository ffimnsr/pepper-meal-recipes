  "id": "9f8c2a1f-4773-5a98-95b4-821aecff3659",
  "slug": "4-ingredient-irish-cabbage-recipe-11842553",
  "name": "4-Ingredient Irish Cabbage",
  "recipe_type": "dessert",
  "brief_description": "This 4-ingredient Irish cabbage is a traditional buttered cabbage dish originating from Ireland. The richness of butter brings out the natural sweetness of cabbage. Use a high-quality butter such as Kerrygold\u2122.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Remove the tough outer leaves of the cabbage. Cut in half vertically, and cut out the core. With the cut side down, slice into 1/2-inch slices."
    },
    {
      "position": 2,
      "text": "Melt butter in a Dutch oven over medium heat. Add cabbage, and toss until well coated. Stir in the chicken broth, cover, and cook, stirring occasionally, until cabbage is tender but still a bit firm, 8 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Season with salt and pepper, and toss until well combined, Transfer to a serving dish, and sprinkle with crumbled bacon."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

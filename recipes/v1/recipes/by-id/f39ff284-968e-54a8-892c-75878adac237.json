  "id": "f39ff284-968e-54a8-892c-75878adac237",
  "slug": "red-onion-marmalade",
  "name": "Red Onion Marmalade",
  "recipe_type": "dessert",
  "brief_description": "This tasty onion marmalade made with sweet caramelized red onions simmered in a mixture of red wine and balsamic vinegar goes well with grilled meats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil and butter in a large skillet over medium heat until butter melts. Add onions and sugar; cook and stir until onions start to caramelize, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Pour red wine and balsamic vinegar into the skillet and bring to a boil. Reduce the heat to medium-low and simmer until liquid is evaporated, 15 to 20 minutes more. Season with salt."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

  "schema_version": 1,
  "id": "9ed79b07-68a6-54f7-adbf-ade50d9c1bda",
  "slug": "indonesian-fried-rice-nasi-goreng",
  "name": "Nasi Goreng (Indonesian Fried Rice)",
  "recipe_type": "dessert",
  "brief_description": "Nasi goreng is a traditional Indonesian fried rice dish that\u2019s savory, sweet, and salty thanks to the addition of kecap manis (Indonesian soy sauce).",
  "cuisine": "Indonesian Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large nonstick skillet over medium heat. Coat with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Pour eggs into the hot skillet and cook until the edges begin to set. Lift the edges to allow any uncooked egg to flow onto the hot pan, about 1 minute. Flip omelet in one piece and cook until fully set, about 30 seconds. Transfer omelet to a cutting board and slice into 1/2-inch strips. Set aside."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a wok or large frying pan over high heat. Stir in onion, leek, chile peppers, and garlic. Cook and stir until onion is soft, 3 to 5 minutes. Stir in chicken, shrimp, coriander, and cumin; mix well. Cook and stir for about 5 minutes."
    },
    {
      "position": 4,
      "text": "Mix in cooked rice, sweet soy sauce, and omelet strips; cook until rice is heated through and chicken is no longer pink in the center, 3 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

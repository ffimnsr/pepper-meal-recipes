  "id": "34e18b44-fb6a-5841-ae01-2099e95301dd",
  "slug": "annas-chocolate-chip-cookies",
  "name": "Anna's Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These chocolate chip cookies are soft, chewy, and full of rich buttery flavor\u2014an easy, classic cookie recipe that never disappoints.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter, brown sugar, and white sugar in a large bowl with an electric mixer on medium speed until smooth, about 2 minutes. Beat in vanilla and eggs, one at a time, until blended."
    },
    {
      "position": 3,
      "text": "Combine flour, baking soda, and salt; stir into sugar mixture. Finally, fold in chocolate chips until evenly distributed."
    },
    {
      "position": 4,
      "text": "Drop dough by rounded tablespoonfuls onto ungreased baking sheets, spacing about 2 inches apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes. Briefly cool on baking sheets, then transfer to wire racks to cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "9f5c5981-3bab-539e-91cc-34087242b82c",
  "slug": "minestrone-casserole-recipe-8765618",
  "name": "Minestrone Casserole",
  "recipe_type": "soup",
  "brief_description": "This minestrone casserole, with fresh vegetables, canned beans, and pasta in a tomato sauce, topped with mozzarella and Parmesan cheeses, is a delicious new twist on minestrone soup.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Lightly coat a 3-quart baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add pasta and cook, covered, for the minimum time according to package directions. Drain and transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a large skillet over medium heat. Add onion, carrots, and celery; cover and cook, stirring occasionally, until carrots are just tender, 5 to 8 minutes. Add zucchini and garlic. Cook and stir 1 minute more."
    },
    {
      "position": 4,
      "text": "Add carrot mixture, beans, tomatoes, green beans, tomato sauce, 1/4 cup Parmesan cheese, Italian seasoning, salt, and pepper to the bowl of pasta. Stir well to combine. Transfer pasta mixture to the prepared dish and cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Remove foil and top with mozzarella cheese; continue baking until heated through and cheese is melted,10 to 15 minutes. Top each serving with remaining Parmesan cheese and sprinkle with fresh herbs."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a14ae5ae-e49a-5d20-b446-8d9427dd7791",
  "slug": "easy-standing-rib-roast",
  "name": "Easy Standing Rib Roast",
  "recipe_type": "main",
  "brief_description": "This easy standing rib roast has a garlic-pepper crust and juicy, tender meat for an impressive yet simple centerpiece for holiday dinners.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Set a rack inside a shallow roasting pan."
    },
    {
      "position": 2,
      "text": "Brush rib roast lightly with olive oil, then rub sea salt, pepper, and garlic all over. Place onto the rack with the fatty side facing up."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until browned, about 30 minutes. Reduce the oven temperature to 325 degrees F (165 degrees C) and tent the pan with aluminum foil. Continue cooking until an instant-read thermometer inserted into the center of the rib roast registers 140 degrees (60 degrees C) for medium, about 1 hour (or 15 minutes per pound if your roast is a different size)."
    },
    {
      "position": 4,
      "text": "Remove roast from the oven and let rest for 10 to 20 minutes before carving. Remove the foil before slicing and serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

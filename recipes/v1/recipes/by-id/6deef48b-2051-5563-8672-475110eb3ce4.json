  "id": "6deef48b-2051-5563-8672-475110eb3ce4",
  "slug": "gingerbread-men-cookies-with-nutella-hazelnut-spread",
  "name": "Gingerbread Men Cookies with Nutella\u00ae hazelnut spread",
  "recipe_type": "dessert",
  "brief_description": "A must-do holiday tradition, these tasty gingerbread figures are even better with a layer of Nutella\u00ae hazelnut spread. Enjoy!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, mix together butter, honey and brown sugar. Mix in egg yolk."
    },
    {
      "position": 2,
      "text": "In a separate bowl, mix together flour, baking soda, gingerbread spice mix and salt; add to butter mixture and knead for 1 minute. Cover with plastic wrap; and refrigerate for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat oven to 320 degrees F."
    },
    {
      "position": 4,
      "text": "On a sheet of parchment paper, roll out dough to 1/6-inch thickness. Using small gingerbread-man cookie cutter or other small shaped-item (such as a glass), cut out gingerbread men."
    },
    {
      "position": 5,
      "text": "Transfer gingerbread men to parchment paper-lined baking sheet; bake on center rack for 8 to 9 minutes or until slightly golden."
    },
    {
      "position": 6,
      "text": "Let cool on rack for 15 minutes."
    },
    {
      "position": 7,
      "text": "Spread 1 1/4 tsp Nutella\u00ae hazelnut spread on the back of one gingerbread man then sandwich with another gingerbread man."
    },
    {
      "position": 8,
      "text": "Repeat with remaining gingerbread men and Nutella\u00ae hazelnut spread. Mix together confectioners' sugar and lemon juice, adding juice to the sugar, a 1/2 tsp at a time, to make smooth paste. Transfer to piping bag and decorate cookies with icing."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 9,
  "preparation_time_minutes": 45,

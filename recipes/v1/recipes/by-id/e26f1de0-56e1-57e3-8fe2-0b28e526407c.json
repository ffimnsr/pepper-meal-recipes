  "id": "e26f1de0-56e1-57e3-8fe2-0b28e526407c",
  "slug": "sheet-pan-mole-negro-recipe-12012699",
  "name": "Sheet Pan Mole Negro",
  "recipe_type": "dessert",
  "brief_description": "Mole negro gets its rich complexity from a combination of savory and sweet ingredients blended with spices and dried chilies. This recipe, based on the mole made by Daniel Zeledon of Don Maguey Mexican Restaurant in Miami, preserves the authentic flavors, but reduces the effort to almost nothing.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "On a rimmed baking sheet, arrange plantain, chilies, sweet roll, tortillas, peanuts, pepitas, almonds, capers, raisins, olives, sesame seeds, cinnamon, cloves, star anise, peppercorns, thyme, rosemary, and allspice in an even layer."
    },
    {
      "position": 3,
      "text": "Toast in the preheated oven until the chilies are deeply charred, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Transfer all of the toasted ingredients to a blender (discarding the rosemary stem). Add brown sugar and chocolate. Pour in as much of the broth as will comfortably fit in your blender. Blend until very smooth, scraping the sides of the jar as needed."
    },
    {
      "position": 5,
      "text": "Transfer mole sauce into a medium pot. Stir in any broth that didn\u2019t fit in the blender. Heat over low, stirring often, until slightly thickened and heated through, about 10 miuntes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

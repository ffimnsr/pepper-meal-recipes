  "id": "9d1e2ef7-c463-5a28-b09b-76dfd3c3061b",
  "slug": "beef-bulgogi",
  "name": "Beef Bulgogi",
  "recipe_type": "dessert",
  "brief_description": "Our best bulgogi recipe uses a sweet soy and sesame marinade. Also known as Korean BBQ beef, this thinly sliced grilled steak is easy to make at home.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk soy sauce, green onion, sugar, garlic, sesame seeds, sesame oil, and pepper together in a bowl."
    },
    {
      "position": 3,
      "text": "Place flank steak slices in a shallow dish. Pour marinade over top. Cover and refrigerate for at least 1 hour or overnight."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for high heat, and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Quickly grill flank steak slices on the preheated grill until slightly charred and cooked through, 1 to 2 minutes per side."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "slow-cooker-smothered-drumsticks-recipe-11965213",
  "name": "Slow Cooker Smothered Drumsticks",
  "recipe_type": "main",
  "brief_description": "These slow cooker smothered chicken drumsticks are simmered with mushrooms in a creamy sauce seasoned with spices every cook has on hand. This easy-to-prepare family dinner is comforting served over potatoes or rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together salt, pepper, garlic powder, onion powder, paprika, and cayenne in a small bowl. Rub seasoning mixture evenly all over the chicken and place chicken in the bottom of a slow cooker."
    },
    {
      "position": 2,
      "text": "Top chicken with onions and mushrooms."
    },
    {
      "position": 3,
      "text": "Stir together cream of chicken soup, Worcestershire, bouillon paste, and water, and spread creamy mixture over mushrooms and onions. Cover and cook on High for 3 hours or on Low for 5 to 6 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 180,

  "id": "8065746a-fddb-5781-9c8c-e41ba7705f9a",
  "slug": "tex-mex-stir-fry",
  "name": "Tex Mex Stir Fry",
  "recipe_type": "main",
  "brief_description": "Use a Chinese cooking technique on Mexican-inspired ingredients for a quick, tasty dinner of boneless chunks of chicken breast, red and green peppers, salsa, and black beans. Serve it on rice, and top it with Cheddar cheese.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 teaspoon of olive oil in a skillet over medium-high heat until the oil is very hot, and cook and stir the green and red bell pepper until they are starting to become tender, about 5 minutes. Set the peppers aside."
    },
    {
      "position": 2,
      "text": "Mix flour and taco seasoning in a bowl, and stir in chicken pieces, a few at a time, to thoroughly coat with the flour mixture. Heat 2 teaspoons of olive oil in a large skillet over medium-high heat, and cook and stir the chicken until no longer pink and the coating is browned, about 5 minutes. Stir in the bell peppers, black beans, and salsa, and let the mixture simmer for about 5 minutes to blend the flavors."
    },
    {
      "position": 3,
      "text": "To serve, sprinkle each portion with Cheddar cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c9a462a0-f3f9-5b52-8ff7-c316a1048144",
  "slug": "absolutely-wonderful-cheesy-creamy-spinach-artichoke-dip",
  "name": "Absolutely Wonderful Cheesy, Creamy Spinach Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Simply mix and bake spinach, artichokes, sour cream, and heavy cream together to make this wonderfully creamy and cheesy appetizer dip.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine all ingredients in a mixing bowl. Gently fold together until well mixed."
    },
    {
      "position": 3,
      "text": "Pour into a greased 8-inch or 9-inch pie plate or baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the oven for 25 to 35 minutes, or until slightly browned and bubbly. Toast bread slices in the oven for the last 10 minutes of the baking time."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

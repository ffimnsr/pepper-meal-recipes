{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2c0187ff-8895-5b65-af7c-dfc6d6289894",
  "slug": "instant-pot-beef-and-noodles",
  "name": "Instant Pot Beef and Noodles",
  "recipe_type": "main",
  "brief_description": "A perfect choice for cold nights, this warm, comforting take on beef stroganoff features seasoned beef and egg noodles in a flavorful mushroom sauce, all made conveniently in your Instant Pot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place frozen egg noodles in the refrigerator to thaw, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function."
    },
    {
      "position": 3,
      "text": "While the pot is heating, combine flour, salt, granulated onion, granulated garlic, and seasoning blend in a resealable bag. Add stew meat, seal the bag, and shake to thoroughly coat the meat."
    },
    {
      "position": 4,
      "text": "When the pot is hot, add oil and butter. Cook beef in batches until seared, about 5 minutes per batch, removing seared beef to a plate."
    },
    {
      "position": 5,
      "text": "Add mushrooms and onion to the pot; cook until slightly softened, about 3 to 5 minutes. Pour in beef broth and bring to a boil, scraping the browned bits from the bottom of the pot with a wooden spoon. Stir in egg noodles. Whisk water and dry onion and mushroom soup mix together in a small bowl; pour into the pot and stir to combine"
    },
    {
      "position": 6,
      "text": "Cancel Saut\u00e9 function and select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 7,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions for 15 minutes, then use the quick-release method for any remaining pressure. Unlock and remove the lid. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

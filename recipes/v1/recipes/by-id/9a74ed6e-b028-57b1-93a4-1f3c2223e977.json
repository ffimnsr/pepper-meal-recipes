  "id": "9a74ed6e-b028-57b1-93a4-1f3c2223e977",
  "slug": "strawberry-lemon-bars",
  "name": "Strawberry Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "This strawberry lemon bars recipe, featuring a sweet, fruity filling and a lemon zest crust, is a delicious treat that will become a family favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 2 cups flour, \u00bc cup confectioners\u2019 sugar, cornstarch, lemon zest, and \u215b teaspoon salt in the bowl of a food processor; pulse to combine. Add butter and oil; pulse until incorporated and crumbly. Press into an 8-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place strawberries in the bowl of a food processor; pulse until smooth. Strain mixture through a fine-mesh-sieve into a bowl; discard solids."
    },
    {
      "position": 5,
      "text": "Whisk 1 \u2153 cups white sugar, eggs, \u2153 cup flour, lemon juice, and \u215b teaspoon salt into strawberry pur\u00e9e until combined."
    },
    {
      "position": 6,
      "text": "Pour strawberry filling into hot crust; bake until filling is just set, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Cool on a wire rack, about 30 minutes. Chill in the refrigerator, about 2 hours. Dust with 2 tablespoons confectioners' sugar; cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

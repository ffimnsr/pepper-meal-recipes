  "id": "1a0ef7d8-2aee-59ca-b951-625431ad5c53",
  "slug": "strawberry-goat-cheese-bruschetta",
  "name": "Strawberry Goat Cheese Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Delicious strawberry bruschetta made with charred Italian bread topped with creamy goat cheese and a mixture of strawberries and balsamic vinegar.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vinegar in a small skillet over medium-low heat. Simmer until reduced by about half, 8 to 10 minutes. Remove from heat and allow to cool to room temperature."
    },
    {
      "position": 2,
      "text": "Prepare a grill for high heat. Place bread slices on a foil-lined baking sheet and drizzle with olive oil."
    },
    {
      "position": 3,
      "text": "Combine strawberries and thyme in a small bowl and set aside."
    },
    {
      "position": 4,
      "text": "Grill bread on the preheated grill until browned, about 3 minutes per side."
    },
    {
      "position": 5,
      "text": "Spread goat cheese on toasted bread. Add black pepper, salt, and reduced vinegar to the strawberry mixture. Spoon over the goat cheese topped bruschetta. Garnish with additional thyme."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "af0aba7c-856d-513c-a9b6-e27b3ab94db9",
  "slug": "monkey-bread-muffins",
  "name": "Monkey Bread Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This monkey bread muffins recipe uses refrigerated biscuit dough coated in sugar, apple pie spice, brown sugar, and butter, before baking in muffin tins.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Butter 6 muffin cups or line with paper liners."
    },
    {
      "position": 2,
      "text": "Combine white sugar and apple pie spice in a small bowl; roll dough pieces in sugar-spice mixture to coat."
    },
    {
      "position": 3,
      "text": "Divide dough pieces between the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Combine brown sugar, 3 tablespoons butter, and water in a small saucepan over medium heat; bring to a boil, stirring continuously. Boil mixture until sugar is completely dissolved, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Spoon brown sugar mixture over dough pieces."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden and tops spring back when lightly pressed, 8 to 12 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

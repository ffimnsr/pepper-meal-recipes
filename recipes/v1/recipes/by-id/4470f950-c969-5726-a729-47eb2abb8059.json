{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4470f950-c969-5726-a729-47eb2abb8059",
  "slug": "roasted-butternut-squash-soup-with-apples-and-bacon",
  "name": "Roasted Butternut Squash Soup with Apples and Bacon",
  "recipe_type": "soup",
  "brief_description": "This roasted butternut squash with apples, bacon, and curry soup recipe has a creamy consistency but is dairy-free, except for the optional sour cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss squash with olive oil in a large bowl until coated; season with salt and black pepper. Spread squash into a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until fork-tender and caramelized, 30 to 40 minutes, flipping once."
    },
    {
      "position": 4,
      "text": "Cook bacon in a Dutch oven over medium-high heat, stirring occasionally, until evenly browned, about 10 minutes. Drain on a paper towel-lined plate; reserve drippings in the Dutch oven."
    },
    {
      "position": 5,
      "text": "Add celery, carrots, onion, curry powder, thyme, bay leaf, salt, and black pepper to the Dutch oven; cook until celery and carrots are soft. Stir in apples and roasted squash; cook 5 minutes. Stir in garlic; cook 1 minute."
    },
    {
      "position": 6,
      "text": "Add apple cider, reduce heat to medium-low, and bring to a simmer. Simmer until reduced by half. Stir in chicken stock; simmer for 20 minutes."
    },
    {
      "position": 7,
      "text": "Fill blender halfway with soup or use an immersion blender. Cover and hold lid down with a dish towel; pulse a few times before leaving on to pur\u00e9e. Pour into a pot. Repeat with remaining soup."
    },
    {
      "position": 8,
      "text": "Stir nutmeg into soup. Garnish each serving with 1 tablespoon sour cream and some bacon pieces."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "hard",

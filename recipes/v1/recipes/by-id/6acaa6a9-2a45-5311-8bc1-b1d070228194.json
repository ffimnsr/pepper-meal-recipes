  "id": "6acaa6a9-2a45-5311-8bc1-b1d070228194",
  "slug": "slow-cooker-sweet-chili-sesame-chicken-recipe-11707278",
  "name": "Slow Cooker Sweet Chili Sesame Chicken",
  "recipe_type": "dessert",
  "brief_description": "Serve this slow cooker sweet chili sesame chicken over rice or noodles to soak up the delicious sauce.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Coat a 3 1/2- to 4-quart slow cooker with nonstick cooking spray. Add chicken and onion to the slow cooker."
    },
    {
      "position": 3,
      "text": "Whisk together Asian chili sauce, soy sauce, ketchup, honey, rice vinegar, ginger, garlic, and toasted sesame oil in a small bowl. Pour over the chicken. Stir to combine."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 5 to 6 hours or on High for 2 1/2 to 3 hours."
    },
    {
      "position": 5,
      "text": "Shred chicken in the slow cooker using two forks."
    },
    {
      "position": 6,
      "text": "Whisk together water and cornstarch in a small bowl. Stir mixture into the slow cooker."
    },
    {
      "position": 7,
      "text": "Cover and cook on High 30 minutes or until sauce is thickened. You may need to cook for up to 45 longer if originally cooking on Low to get cornstarch fully cooked (205 degrees F or 96 degrees C with an instant read thermometer)."
    },
    {
      "position": 8,
      "text": "Serve garnished with green onions and sesame seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 170,
  "preparation_time_minutes": 15,

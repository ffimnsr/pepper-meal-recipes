  "id": "eb0af1f4-4389-5731-a67c-832f50826989",
  "slug": "tomatillo-salsa-verde",
  "name": "Tomatillo Salsa Verde",
  "recipe_type": "appetizer",
  "brief_description": "Homemade tomatillo salsa made with fresh tomatillos, spicy chiles, garlic, and cilantro. Perfect with tortilla chips or topping Mexican tacos.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place tomatillos, onion, serrano, and garlic in a large saucepan; season with cilantro, oregano, salt, and cumin. Add water; bring to a boil over high heat. Reduce the heat to medium-low; simmer until tomatillos are soft, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Transfer tomatillo mixture to a blender in batches; blend until smooth."
    },
    {
      "position": 4,
      "text": "Serve with chips."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

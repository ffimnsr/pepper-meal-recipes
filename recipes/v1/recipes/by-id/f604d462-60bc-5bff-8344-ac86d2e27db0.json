  "id": "f604d462-60bc-5bff-8344-ac86d2e27db0",
  "slug": "easy-persimmon-jam",
  "name": "Easy Persimmon Jam",
  "recipe_type": "drink",
  "brief_description": "This persimmon jam recipe simmers chunks of fresh persimmons with sugar, lemon juice and zest for a delicious homemade preserve without pectin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine persimmon flesh, sugar, persimmon skin, lemon juice, and lemon zest in a small pot over medium heat; bring to a boil. Reduce heat to low and simmer until persimmon flesh softens and jam thickens, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Cool jam until set, about 30 minutes. Transfer to an airtight container and store in the refrigerator."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,

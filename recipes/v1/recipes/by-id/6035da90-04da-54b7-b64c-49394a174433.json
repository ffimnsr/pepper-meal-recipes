  "id": "6035da90-04da-54b7-b64c-49394a174433",
  "slug": "pumpkin-walnut-bread",
  "name": "Pumpkin Walnut Bread",
  "recipe_type": null,
  "brief_description": "This pumpkin walnut bread recipe is deliciously spiced with cinnamon, nutmeg, and cloves. It's so easy to make \u2014 your kids will want to help!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, baking soda, salt, cinnamon, nutmeg, cloves, baking powder, and ginger in a large bowl. Make a well in the center; add pumpkin pur\u00e9e, oil, and eggs. Stir well, then fold in walnuts. Pour batter into the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 90 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "coconut-milk-ice-cream-recipe-11686955",
  "name": "Coconut Milk Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This coconut milk ice cream, lightly flavored with vanilla, is a yummy dairy-free treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together coconut milk, sugar, vanilla extract, and salt in a small bowl until sugar dissolves. Chill until cold, at least 2 hours. Churn in an ice cream maker according to manufacturer\u2019s directions. Freeze in an airtight container at least 4 hours or up to 3 months."
    }

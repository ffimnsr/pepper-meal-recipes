  "id": "2c84b51c-871f-55c6-b150-85df5bffc6fb",
  "slug": "delicious-pumpkin-bread",
  "name": "Delicious Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "Pumpkin bread made with fresh pumpkin and walnuts (or raisins!) is perfectly spiced for breakfast or snacking. This easy recipe makes three loaves!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 7x3-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Stir flour, sugar, baking soda, salt, nutmeg, and cinnamon together in a large mixing bowl until well blended. Add mashed pumpkin, oil, water, and eggs; beat with an electric mixer until well combined. Fold in walnuts. Divide batter evenly among the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of each loaf comes out clean, about 1 hour."
    },
    {
      "position": 4,
      "text": "Remove from the oven and set pans on a wire rack. Let cool completely before slicing."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

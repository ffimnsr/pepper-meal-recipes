  "id": "7544c411-90f5-5f5a-a7d1-55ae3b6fb756",
  "slug": "ultimate-gluten-free-cornbread",
  "name": "Ultimate Gluten-Free Cornbread",
  "recipe_type": "main",
  "brief_description": "This great gluten-free cornbread recipe uses cornmeal and millet flour; no one will ever guess!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat eggs in a bowl; stir in milk, butter, and vinegar. Stir cornmeal, millet flour, sugar, baking powder, and salt into egg mixture until combined; spread batter into prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until golden brown, 16 to 20 minutes. Cool on wire rack for 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 10,

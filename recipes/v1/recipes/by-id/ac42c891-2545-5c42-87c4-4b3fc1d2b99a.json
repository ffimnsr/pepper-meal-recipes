  "schema_version": 1,
  "id": "ac42c891-2545-5c42-87c4-4b3fc1d2b99a",
  "slug": "general-tsos-tofu",
  "name": "General Tso's Tofu",
  "recipe_type": "dessert",
  "brief_description": "This General Tso's tofu recipe features crispy tofu coated in a spicy, sweet, and salty sauce. In this vegetarian version of General Tso's chicken",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place tofu on a paper towel-lined plate with several paper towel layers; cover with paper towels and another plate. Set a 3- to 5-pound object on top plate; press tofu for 30 minutes. Drain and discard any accumulated liquid."
    },
    {
      "position": 2,
      "text": "Place tofu cubes in a shallow bowl. Add 2 tablespoons soy sauce and 1 teaspoon sesame oil; gently stir to coat. Let sit until tofu has absorbed most of the liquid, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk 3 tablespoons soy sauce, maple syrup, green onions, sambal oelek, rice wine vinegar, garlic, 2 teaspoons sesame oil, and 2 teaspoons cornstarch together in a bowl. Set sauce aside."
    },
    {
      "position": 4,
      "text": "Drain and discard any remaining liquid from tofu. Place 5 tablespoons cornstarch in a gallon-sized resealable plastic bag. Add tofu, squeeze out excess air, and seal the bag; gently shake until tofu coated with cornstarch."
    },
    {
      "position": 5,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add tofu; cook for 4 minutes. Flip; cook until browned on all sides, about 4 minutes more. Transfer tofu to a plate; wipe the skillet clean."
    },
    {
      "position": 6,
      "text": "Add sauce to the skillet; cook until slightly thickened, about 2 minutes. Off heat, stir in tofu and toss to combine."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

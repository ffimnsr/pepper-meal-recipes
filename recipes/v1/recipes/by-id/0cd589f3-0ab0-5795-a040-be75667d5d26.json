  "slug": "polish-egg-salad",
  "name": "Polish Egg Salad",
  "recipe_type": "salad",
  "brief_description": "This egg salad is quite popular in Poland as a sandwich filling; instead of mayonnaise it is made with cream cheese, onion, and butter.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese and butter in a bowl and mash with a fork. If mixture is too thick, add more softened butter. Mix in eggs and onion. Season with salt and pepper; serve with parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

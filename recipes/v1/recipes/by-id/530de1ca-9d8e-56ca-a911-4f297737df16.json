  "id": "530de1ca-9d8e-56ca-a911-4f297737df16",
  "slug": "sheet-pan-lemon-garlic-salmon-with-green-beans-recipe-12027619",
  "name": "Sheet Pan Lemon Garlic Salmon with Green Beans",
  "recipe_type": "side",
  "brief_description": "For this sheet pan lemon garlic salmon and green beans, the salmon cooks in a foil packet while the green beans roast right alongside it on the sheet pan. It\u2019s an easy, flavorful dinner with minimal cleanup\u2014serve with steamed rice if you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 425 degrees F (220 degrees C). Line a small baking tray with foil."
    },
    {
      "position": 2,
      "text": "Place salmon on a piece of foil, drizzle with olive oil. Peel the garlic, and grate with a microplane grater to form a paste. Rub salmon with garlic paste; sprinkle with salt and pepper. Top the fillet with three thin overlapping lemon slices."
    },
    {
      "position": 3,
      "text": "Bring edges of foil up to the middle and fold down, fold top and bottom together to create a packet. Leave a little air space in the packet. Place packet on one half of baking tray."
    },
    {
      "position": 4,
      "text": "Toss the green beans with pecan oil, salt, and pepper. Spread them on the other half of the baking tray."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until beans are tender and salmon flakes easily with a fork, about 17 minutes. Toss green beans halfway through cooking time."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

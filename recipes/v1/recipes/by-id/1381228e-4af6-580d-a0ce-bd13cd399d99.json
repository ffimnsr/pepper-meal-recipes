  "id": "1381228e-4af6-580d-a0ce-bd13cd399d99",
  "slug": "cheesy-chili-enchiladas",
  "name": "Cheesy Chili Enchiladas",
  "recipe_type": "main",
  "brief_description": "Canned chili is the time saving key to this quick and zesty enchilada dish.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 baking dish."
    },
    {
      "position": 2,
      "text": "Warm oil in a small skillet. Use tongs to dip tortillas into the oil one at a time, turning to warm both sides. Sprinkle an even amount of Cheddar cheese down the center of each warmed tortilla. Roll tortillas to enclose cheese; place seam side down in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine the chili, onion, and half of the processed cheese in a large bowl. Pour the chili mixture over the tortillas; top with the remaining processed cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until hot and bubbly, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

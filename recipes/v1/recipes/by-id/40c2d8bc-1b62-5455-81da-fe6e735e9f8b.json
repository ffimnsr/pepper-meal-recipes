  "id": "40c2d8bc-1b62-5455-81da-fe6e735e9f8b",
  "slug": "sweet-potato-pie-with-evaporated-milk",
  "name": "Sweet Potato Pie with Evaporated Milk",
  "recipe_type": "dessert",
  "brief_description": "This potato pie is baked with a sweet almond topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Prepare the filling by blending together the sweet potatoes, evaporated milk, 1 cup brown sugar, 1/2 cup butter, eggs, cinnamon, vanilla, salt, ginger and nutmeg. Pour filling into prepared crust."
    },
    {
      "position": 3,
      "text": "Prepare the topping by combining the flour, 1/2 cup brown sugar, cinnamon, ginger and mace. Using a pastry knife, cut the butter into the flour mixture until coarse crumbs form. Stir in nuts."
    },
    {
      "position": 4,
      "text": "Sprinkle topping over filling and bake at 400 degrees F (200 degrees C) for 50 minutes or until golden and a knife inserted in the center comes out clean."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

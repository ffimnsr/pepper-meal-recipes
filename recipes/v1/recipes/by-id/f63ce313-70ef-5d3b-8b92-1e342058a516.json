  "id": "f63ce313-70ef-5d3b-8b92-1e342058a516",
  "slug": "orange-almond-biscotti-ii",
  "name": "Orange Almond Biscotti",
  "recipe_type": "dessert",
  "brief_description": "This orange almond biscotti recipe is made with sugar, sliced almonds, and orange zest. The recipe is low in fat but high in deliciousness. Enjoy!",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a baking sheet."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together flour, sugar, baking powder, salt, almonds, and orange zest. Make a well in the center and add eggs oil, and almond extract. Stir or mix by hand until mixture forms a ball."
    },
    {
      "position": 3,
      "text": "Separate dough into 2 pieces and roll each one into a log, about 8 inches long. Place logs on a prepared baking sheet and flatten so they are about 3/4-inch thick. Bake in the preheated oven for 20 to 25 minutes. Cool slightly, and remove from baking sheets. Slice diagonally into 1/2-inch slices with a serrated knife. Set cookies on side back onto the cookie sheet and bake for 10 to 15 more minutes, turning over after half of the time. Finished cookies should be hard and crunchy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fbf54748-b48c-5f80-8e5f-5d181d381fe7",
  "slug": "lemon-blueberry-cornbread-recipe-11946141",
  "name": "Lemon Blueberry Cornbread",
  "recipe_type": "dessert",
  "brief_description": "This lemon blueberry cornbread blurs the line a bit between bread and cake. It\u2019s bright, lemony, and sweet\u2014with a nice flavor and texture from the cornmeal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Butter a 9x9-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Whisk melted butter, honey, 2 tablespoons sugar, lemon zest, and salt together in a large bowl until combined. Whisk in eggs until incorporated. Add milk and lemon juice, and whisk until combined (mixture will look curdled, this is fine). Add 1 cup flour, cornmeal, and baking powder, and whisk until smooth and combined."
    },
    {
      "position": 3,
      "text": "Toss blueberries and remaining 2 tablespoons flour together in a separate bowl. Add blueberries to the batter and fold until incorporated."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared pan and spread into an even layer. Sprinkle remaining 2 tablespoons sugar over the batter."
    },
    {
      "position": 5,
      "text": "Bake cornbread in the preheated oven until a toothpick inserted into the center of the cornbread comes out clean, 20 to 25 minutes. Cool cornbread in the pan for 15 minutes before removing to a wire rack. Can be served warm or at room temperature."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

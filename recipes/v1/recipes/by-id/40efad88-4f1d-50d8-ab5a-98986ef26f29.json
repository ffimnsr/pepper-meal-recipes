  "id": "40efad88-4f1d-50d8-ab5a-98986ef26f29",
  "slug": "pecan-pie-energy-bites",
  "name": "Pecan Pie Energy Bites",
  "recipe_type": "appetizer",
  "brief_description": "Looking for easy-to-make, energy-packed bites that taste delicious? Try Chef John's pecan pie energy bites made with dates, oats, and pecans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Arrange a single layer of pecans on the prepared baking sheet. Top with rolled oats. Bake in the preheated oven until toasted, about 10 minutes. Allow to cool completely."
    },
    {
      "position": 3,
      "text": "Pulse pecans, oats, dates, cinnamon, salt, vanilla extract, and maple syrup in a food processor until nuts are ground to desired consistency."
    },
    {
      "position": 4,
      "text": "Shape mixture into twelve 2-inch tightly-packed balls. Refrigerate before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

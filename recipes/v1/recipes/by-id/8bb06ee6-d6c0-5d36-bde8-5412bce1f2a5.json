  "id": "8bb06ee6-d6c0-5d36-bde8-5412bce1f2a5",
  "slug": "adas-bil-hamod-lebanese-lentil-lemon-soup",
  "name": "Adas bil Hamod (Lebanese Lentil Lemon Soup)",
  "recipe_type": "soup",
  "brief_description": "This Lebanese version of traditional lentil soup with spinach is seasoned with mint and lemon juice. It's traditionally served with toasted French bread for dipping.",
  "cuisine": "Middle Eastern Inspired Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in large pot over high heat. When oil is very hot, add onions and stir until onions begin to turn dark brown and caramelize, about 10 minutes. Put the lentils, garlic, frozen spinach, and mint into the pot. Pour in enough water so that it is about 2 inches deeper than the lentil mixture. Stir well to loosen browned bits of onion on the bottom of the pot."
    },
    {
      "position": 2,
      "text": "Bring to a boil; reduce heat to medium. Simmer, uncovered, until lentils are tender, about 20 minutes. If soup gets too thick, add a little more water. Salt to taste. Lower heat and stir in lemon juice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

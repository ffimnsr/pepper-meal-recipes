  "slug": "chia-coconut-pudding-with-coconut-milk",
  "name": "Chia Coconut Pudding with Coconut Milk",
  "recipe_type": "dessert",
  "brief_description": "This chia seed pudding with coconut milk is a delicious dairy-free version of pudding high in omega-3s and sweetened with agave, ready in 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together sweetened and unsweetened coconut milks, agave nectar, vanilla extract, cinnamon, and salt in a bowl; stir in chia seeds. Allow mixture to soak until thickened, at least 20 minutes, or cover the bowl with plastic wrap and refrigerate overnight."
    },
    {
      "position": 2,
      "text": "Stir pudding and top with strawberries."
    }
  ],
  "servings": 6,

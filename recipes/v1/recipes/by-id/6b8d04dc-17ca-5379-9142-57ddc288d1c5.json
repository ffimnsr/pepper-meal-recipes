{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6b8d04dc-17ca-5379-9142-57ddc288d1c5",
  "slug": "chili-lime-sous-vide-chicken-thighs",
  "name": "Chili-Lime Sous Vide Chicken Thighs",
  "recipe_type": "main",
  "brief_description": "Get ready to be amazed at how juicy chicken thighs will turn out if you're cooking them sous vide, flavored with lime and chili peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water and place a sous vide immersion cooker into the water. Set temperature to 160 degrees F (71 degrees C) according to manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Cut one lime into 8 slices. Cut second lime into 4 wedges. Combine garlic powder, onion powder, chili powder, salt, chipotle powder, paprika, and cayenne together in a small bowl."
    },
    {
      "position": 3,
      "text": "Place chicken thighs, skin-side down, on a cutting board. Carefully remove any excess fat and flaps of skin. Sprinkle seasoning over both sides of chicken, rubbing some under the skin. Place chicken thighs into a large vacuum bag and place a slice of lime on the top and bottom of each thigh. Seal bag using a vacuum sealer."
    },
    {
      "position": 4,
      "text": "Place bag into the water and set timer for 2 hours. When timer is up, remove chicken from bag and pat dry completely with paper towels. Discard lime slices and bag juices. Lightly flatten each thigh with your palm and a paper towel, using gentle pressure to create a flat searing surface."
    },
    {
      "position": 5,
      "text": "Heat oil in a skillet over high heat. Lightly season chicken with salt and pepper. Place chicken in the hot skillet, skin-side down, and sear until nicely browned, about 1 minute. Move chicken around the skillet using tongs, holding the chicken up against the side of the skillet to get an even brown color on all edges. Flip thighs over and brown for 30 seconds more. Remove from heat and let sit for 2 to 3 minutes before serving. Squeeze lime wedges over top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

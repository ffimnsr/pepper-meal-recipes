  "id": "3346fd13-cfc2-5e28-82d2-0d0a64c6e097",
  "slug": "cherry-wink-bars-recipe-11861910",
  "name": "Cherry Wink Bars",
  "recipe_type": "dessert",
  "brief_description": "These cherry wink bars are delightfully nostalgic; soft and buttery with a golden, crisp cornflake crust. Maraschino cherries and dates add a candy-like chew, balanced by the nutty richness of pecans and coconut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C).. Coat a 9x13-inch baking pan with cooking spray, and line with parchment paper, leaving a 2-inch overhang on long sides."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar with an electric mixer in a large bowl on medium speed until light and fluffy, about 2 minutes. Add eggs 1 at a time, beating well after each addition. Beat in vanilla until combined."
    },
    {
      "position": 4,
      "text": "Whisk flour, baking powder, baking soda, and salt together in a separate bowl. Gradually add to butter mixture; beat on medium speed until just combined, about 1 minute. Fold in pecans, dates, coconut, and chopped maraschino cherries."
    },
    {
      "position": 5,
      "text": "Sprinkle half the crushed cornflakes evenly in the bottom of the prepared pan. Dollop dough evenly over cornflakes; press gently using wet hands into an even layer, about 1/2 inch to 3/4 inch thick."
    },
    {
      "position": 6,
      "text": "Sprinkle remaining 1 cup crushed cornflakes evenly over top, pressing lightly to adhere. Top evenly with quartered maraschino cherries."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until edges are set and center no longer appears wet, 28 to 30 minutes. Bars should be lightly golden and slightly puffed."
    },
    {
      "position": 8,
      "text": "Cool completely in pan on a wire rack, 1 hour and 30 minutes to 2 hours. Cut into 8 (3 1/4x4 1/2 inch) bars."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

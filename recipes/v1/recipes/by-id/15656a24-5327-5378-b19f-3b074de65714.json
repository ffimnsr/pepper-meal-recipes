  "id": "15656a24-5327-5378-b19f-3b074de65714",
  "slug": "grilled-salmon-i",
  "name": "Grilled Salmon",
  "recipe_type": "dessert",
  "brief_description": "Grilled salmon with a simple soy sauce and brown sugar marinade. The sweet-salty flavors in the marinade complement the rich salmon fillets perfectly.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season salmon fillets with lemon pepper, garlic powder, and salt."
    },
    {
      "position": 3,
      "text": "Stir soy sauce, brown sugar, water, and vegetable oil together in a small bowl until sugar is dissolved. Place fish in a large resealable plastic bag; add soy sauce mixture, seal, and turn to coat. Refrigerate for at least 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Place salmon on the preheated grill, and discard marinade. Cook salmon until fish flakes easily with a fork, about 6 to 8 minutes per side."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "a0f0d85e-40d5-5a80-8dd0-8390144893e6",
  "slug": "thai-coconut-chicken-soup-noodle-bowl",
  "name": "Thai Coconut Chicken Soup (Noodle Bowl)",
  "recipe_type": "soup",
  "brief_description": "A fragrant lemongrass, ginger, and coconut soup is ladled over Thai rice noodles in this chicken noodle bowl that's better than take-out.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Remove from heat, add noodles, and cover."
    },
    {
      "position": 2,
      "text": "Peel and discard tough outer leaves from lemongrass. Roughly chop pale inner stalk and transfer to a food processor; pulse until minced, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Bring chicken broth to a boil in another large pot. Add lemongrass, chicken, mushrooms, red chile pepper. Cook for 5 minutes. Reduce heat to medium; stir in coconut milk, ginger, fish sauce, and garlic. Simmer soup gently until an instant-read thermometer inserted into the chicken reads at least 165 degrees F (74 degrees C), 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Transfer chicken to a cutting board; slice thinly and return to the pot. Stir in lime juice and sugar."
    },
    {
      "position": 5,
      "text": "Drain noodles and divide among serving bowls. Ladle soup on top. Garnish with a lime wedge, green onions, and basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

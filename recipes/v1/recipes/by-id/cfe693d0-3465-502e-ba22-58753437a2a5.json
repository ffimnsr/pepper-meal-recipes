  "schema_version": 1,
  "id": "cfe693d0-3465-502e-ba22-58753437a2a5",
  "slug": "carrot-cupcakes-with-white-chocolate-cream-cheese-icing",
  "name": "Carrot Cupcakes with White Chocolate Cream Cheese Icing",
  "recipe_type": "dessert",
  "brief_description": "Moist and fluffy carrot cupcakes are topped with a delicious homemade white chocolate cream cheese frosting flavored with a hint of orange.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin pan with cupcake liners."
    },
    {
      "position": 2,
      "text": "To make the carrot cupcakes: Beat white sugar, brown sugar, and eggs together in a bowl; mix in oil and vanilla. Fold in carrots and pineapple."
    },
    {
      "position": 3,
      "text": "Mix flour, baking soda, cinnamon, salt, nutmeg and ginger in a separate bowl; add to carrot mixture until evenly moist. Fold in 1/2 of the chopped walnuts. Spoon batter into the prepared liners, filling each 3/4 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 25 minutes. Cool cupcakes completely on wire racks."
    },
    {
      "position": 5,
      "text": "Meanwhile, make the frosting: Melt white chocolate in small saucepan over low heat; stir until smooth and allow to cool to room temperature."
    },
    {
      "position": 6,
      "text": "Beat cream cheese and butter together in a large bowl with electric mixer until smooth. Mix in cooled white chocolate, 1 teaspoon vanilla, and orange extract. Gradually beat in confectioners\u2019 sugar until mixture is fluffy; mix in heavy cream. Top each cooled cupcake with frosting and sprinkling with remaining walnuts."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

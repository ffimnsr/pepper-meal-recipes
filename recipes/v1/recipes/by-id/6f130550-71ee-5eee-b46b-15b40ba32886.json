  "id": "6f130550-71ee-5eee-b46b-15b40ba32886",
  "slug": "buttermilk-strawberry-shortcake",
  "name": "Buttermilk Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "Light and airy buttermilk shortcake biscuits are topped with juicy, fresh strawberries in this easy recipe that makes a summer dessert favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, baking soda, 1/3 cup white sugar, and salt together in a mixing bowl."
    },
    {
      "position": 3,
      "text": "Cut in cold butter with a knife or pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 4,
      "text": "Stir in buttermilk until the flour mixture is moistened."
    },
    {
      "position": 5,
      "text": "Drop 1/3-cup scoops of the dough 2 inches apart onto the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Brush biscuits with heavy cream and sprinkle generously with turbinado sugar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes."
    },
    {
      "position": 8,
      "text": "Mix sliced strawberries, 1/4 cup white sugar, and lemon juice in a large bowl. Allow berries to rest until juices develop, about 30 minutes."
    },
    {
      "position": 9,
      "text": "Serve strawberries with juice over the baked biscuits."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

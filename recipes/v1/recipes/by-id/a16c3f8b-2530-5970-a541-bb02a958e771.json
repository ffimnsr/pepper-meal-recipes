  "slug": "devil-crab-cream-cheese-ball",
  "name": "Devil Crab Cream Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "A mildly spiced cream cheese and crab mixture. Pour cocktail sauce over the chilled ball, and serve with crackers. Sinfully delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together imitation crab, cream cheese, onion, celery, and Worcestershire sauce. Form into a ball, place on a plate, and cover loosely with plastic wrap. Refrigerate until firm."
    }
  ],
  "servings": 4,

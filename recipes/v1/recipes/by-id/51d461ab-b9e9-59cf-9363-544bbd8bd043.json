  "id": "51d461ab-b9e9-59cf-9363-544bbd8bd043",
  "slug": "easy-brownie-truffles-recipe-12026993",
  "name": "Easy Brownie Truffles",
  "recipe_type": "dessert",
  "brief_description": "These easy brownie truffles are fudgy and rich. Baked brownies are crumbled, mixed with cream cheese, rolled into balls, then dipped in melted chocolate. The recipe makes quite a lot, so they\u2019re good for a big party or potluck.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine brownie mix with oil, eggs, and water and pour into a square pan. Bake according to package directions, choosing the lower end of the recommended cook time for a fudgier center."
    },
    {
      "position": 2,
      "text": "While brownies are are slightly warm, crumble them into a large bowl. Add cream cheese and mix until very well combined and moist."
    },
    {
      "position": 3,
      "text": "Roll mixture into 1-inch balls and set aside."
    },
    {
      "position": 4,
      "text": "Place chocolate chips in a double boiler and cook, stirring often, until chocolate is melted. Keep warm."
    },
    {
      "position": 5,
      "text": "Use a fork to dip each ball into the melted chocolate; allow all the excess to drip off, leaving just a thin layer of chocolate over the brownie ball. Place on parchment or wax paper to cool completely until outer coating is hardened. Truffles may be refrigerated to accelerate the cooling process."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

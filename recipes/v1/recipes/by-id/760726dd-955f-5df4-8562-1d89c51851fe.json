  "id": "760726dd-955f-5df4-8562-1d89c51851fe",
  "slug": "easy-slow-cooker-vegetarian-minestrone",
  "name": "Easy Slow Cooker Vegetarian Minestrone",
  "recipe_type": "soup",
  "brief_description": "Full of chickpeas, veggies, and ditalini pasta, this slow cooker vegetarian minestrone is the perfect meal to serve on a busy weeknight.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in the bottom of a 4- or 6-quart slow cooker on High. Add zucchini, onion, carrot, celery, garlic, salt, and pepper; stir to combine."
    },
    {
      "position": 2,
      "text": "Pour in vegetable stock, chickpeas, undrained tomatoes, and green beans. Cover and cook on Low for 6 to 7 hours."
    },
    {
      "position": 3,
      "text": "Add ditalini and cook for 1 more hour. Stir in pesto and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 420,
  "preparation_time_minutes": 25,

  "id": "9bfd4d18-e2a7-5b95-9413-e6ebb6e0ed47",
  "slug": "crushed-pineapple-fruitcake",
  "name": "Crushed Pineapple Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "This is a very good cake for Christmas. Do not double this recipe. You don't need to age this cake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line an angel food pan with parchment paper and brush with melted butter."
    },
    {
      "position": 2,
      "text": "Cream butter or margarine, and then beat in sugar. Beat in eggs one at a time, beating well after each addition. Stir in extract. Mix in flour, baking powder, and salt. Stir in raisins, cherries, pineapple, and mixed peel. Cover bowl and let sit at room temperature, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Bake at 300 degrees F (150 degrees C) for 2 1/2 hours with a pan of hot water placed on the lowest rack of your oven during baking. Brush warm cake with some melted butter."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 150,

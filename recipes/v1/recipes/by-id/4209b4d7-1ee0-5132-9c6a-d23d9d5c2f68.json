  "id": "4209b4d7-1ee0-5132-9c6a-d23d9d5c2f68",
  "slug": "boiled-fruit-cake",
  "name": "Boiled Fruit Cake",
  "recipe_type": "dessert",
  "brief_description": "This is an Northern Ireland recipe given to me by my Mum many years ago!! This cake is always much tastier the following day! Enjoy!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 9x5 inch loaf pan, and line with parchment paper or aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine the water, mixed fruit, sugar and butter in a saucepan over medium heat. Bring to a boil, stirring occasionally, and boil gently for about 10 minutes. Sift the flour, baking soda and mixed spice into a large bowl. Pour in the boiled mixture, and stir until well blended. Mix in the eggs. Pour into the greased loaf pan."
    },
    {
      "position": 3,
      "text": "Bake for 90 minutes in the preheated oven, until a skewer or knife inserted into the top comes out clean. Cool cake in the pan for at least 10 minutes before removing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "3d6d73f4-974a-5366-83fe-5960a9cdb053",
  "slug": "easy-garlic-knots-recipe-8690072",
  "name": "Easy Garlic Knots",
  "recipe_type": "appetizer",
  "brief_description": "These easy garlic knots are so good, you'll want to make an extra batch to take pizza night to the next level.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large baking sheet."
    },
    {
      "position": 2,
      "text": "Roll out dough on a lightly floured surface to a 10x16-inch rectangle. Cut dough lengthwise into 12 strips. Halve strips to make 24 (8-inch-long) strips. Tie each strip in a knot. Arrange on prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 10 to 15 minutes. Transfer knots to a large bowl. Drizzle with oil. Sprinkle with garlic, Parmesan, parsley, crushed red pepper, and salt. Toss gently to coat."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

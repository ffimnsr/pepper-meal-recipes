  "id": "e26bfd97-9507-5405-b970-7260a68422b2",
  "slug": "best-roasted-pumpkin-seeds",
  "name": "Best Roasted Pumpkin Seeds",
  "recipe_type": "salad",
  "brief_description": "The best recipe for toasted pumpkin seeds. Fix this buttery, salty snack while the family is still carving the pumpkins! They're great on salads, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Clean and dry pumpkin seeds so there is no goo or strings."
    },
    {
      "position": 3,
      "text": "Melt butter onto a cookie sheet. Spread pumpkin seeds evenly over the buttered sheet and sprinkle with salt and water."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 to 15 minutes, shaking the pan every few minutes to ensure even baking."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

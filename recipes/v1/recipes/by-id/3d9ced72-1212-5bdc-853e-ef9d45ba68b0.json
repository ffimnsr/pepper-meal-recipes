  "id": "3d9ced72-1212-5bdc-853e-ef9d45ba68b0",
  "slug": "roti-bread-from-india",
  "name": "Roti Bread from India",
  "recipe_type": "appetizer",
  "brief_description": "For durability, this version of roti bread, a delicate Indian flatbread, is made with durum wheat flour (semolina), the kind often used to make pasta.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour, water, oil, and salt together in a medium bowl until well combined and pulling away from the sides. Turn dough out onto a well-floured surface and knead until smooth and pliable, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Divide dough into 12 equal pieces. Form each piece into a round. Working with one round at a time while all others are covered with a damp cloth, flatten with the palm of your hand, then use a rolling pin to roll into 6- to 8-inch diameter circle."
    },
    {
      "position": 3,
      "text": "Heat a dry skillet or tava over medium-high heat. Cook one roti at a time in the hot skillet until golden with some darker brown spots, about 1 minute per side, As it cooks, roll the next roti. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

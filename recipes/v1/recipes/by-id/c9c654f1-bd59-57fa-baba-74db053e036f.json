  "id": "c9c654f1-bd59-57fa-baba-74db053e036f",
  "slug": "easy-chicken-cacciatore",
  "name": "Easy Chicken Cacciatore",
  "recipe_type": "main",
  "brief_description": "A classic chicken cacciatore recipe that is easy and comforting. Chicken simmered with vegetables and tomatoes in a fragrant sauce with oregano.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Saut\u00e9 onion, bell pepper, and garlic in a large skillet until soft. Add chicken, then stir in tomatoes, beans, and oregano."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low and simmer, stirring constantly, for 8 to 10 minutes. Remove from heat and serve hot."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "27b6fb41-6236-503b-8d3b-9ec9043e3ca3",
  "slug": "thanksgiving-casserole-recipe-11825864",
  "name": "Thanksgiving Casserole",
  "recipe_type": "main",
  "brief_description": "Layer leftover Thanksgiving stuffing, turkey, mashed potatoes, gravy, and green bean casserole into a creamy, cheesy casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 2-quart square baking dish with cooking spray. Spread stuffing evenly on the bottom of the prepared dish."
    },
    {
      "position": 2,
      "text": "Stir together turkey, green bean casserole, 1/4 cup sour cream, and gravy in a bowl until combined; spoon over stuffing, spreading into an even layer."
    },
    {
      "position": 3,
      "text": "Microwave mashed potatoes in a bowl on High, stirring once, until slightly warmed. Add cheese and remaining 1/2 cup sour cream; stir until well combined, then spread evenly over turkey mixture in dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until hot and edges start to bubble and brown, 25 to 35 minutes. Serve topped with chives."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

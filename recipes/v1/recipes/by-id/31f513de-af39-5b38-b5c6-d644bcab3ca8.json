{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "31f513de-af39-5b38-b5c6-d644bcab3ca8",
  "slug": "eggplant-parmigiana-caponata",
  "name": "Eggplant Parmigiana Caponata",
  "recipe_type": "main",
  "brief_description": "Sauteed eggplant, red bell peppers, and onion are topped with a tangy tomato sauce, melted mozzarella, and Parmesan cheeses. Capers and (optional) anchovies add savory flavors to this cross between eggplant Parmesan and caponata. Serve with linguini or your favorite pasta.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 1/2 cup olive oil in a large heavy skillet. Saute eggplant until each piece becomes saturated with oil. Use eggplant to line the bottom of a 3 quart casserole dish. Saute the red peppers until tender, and layer over eggplant in casserole dish. Top with mozzarella."
    },
    {
      "position": 3,
      "text": "Heat remaining olive oil, and cook onions and garlic until lightly browned and caramelized. Stir in stewed tomatoes, basil, and oregano and simmer 5 minutes. Add balsamic vinegar, red wine vinegar, brown sugar, and tomato paste. Simmer for 10 minutes. Add anchovy fillets, if using, and capers. Season with salt and pepper. Pour over the mozzarella cheese in the casserole dish. Sprinkle Parmesan cheese on top of sauce."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 20 to 25 minutes, or until cheese is melted."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

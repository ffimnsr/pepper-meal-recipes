  "id": "b8cbb2b9-797f-567e-878e-c43dbcc0f5ad",
  "slug": "brazilian-cheese-bread-pao-de-queijo",
  "name": "Brazilian Cheese Bread (Pao de Queijo)",
  "recipe_type": "appetizer",
  "brief_description": "Pao de queijo are yummy, fragrant, and easy to make. These cheese-flavored breads use tapioca flour instead of wheat flour, so they're gluten free.",
  "cuisine": "Brazilian South American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Combine olive oil, water, milk, and salt in a large saucepan and place over high heat."
    },
    {
      "position": 2,
      "text": "Bring to a boil and immediately remove from the heat."
    },
    {
      "position": 3,
      "text": "Stir in tapioca flour and garlic, stirring until smooth. Set aside to rest for 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir cheese and eggs into tapioca mixture until combined; the dough will be chunky, like cottage cheese."
    },
    {
      "position": 5,
      "text": "Drop dough by 1/4 cup-size balls onto an ungreased baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the tops are lightly browned, 15 to 20 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

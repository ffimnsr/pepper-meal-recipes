  "id": "761da2b5-7a58-597f-b462-eec1113efa9c",
  "slug": "harvest-turkey-brine",
  "name": "Harvest Turkey Brine",
  "recipe_type": "main",
  "brief_description": "For the juiciest possible turkey, brine the bird a day or two in advance with this flavor-packed mixture of stocks, wine, fruits, and fresh herbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken stock, vegetable stock, and with wine in a large pot. Toss in apples, oranges, lemons, pear, garlic, and onion. Tie rosemary, thyme, and sage together with kitchen twine; add to the pot. Stir in 1 cup water, salt, sugar, dried peppers, vegetable flakes, peppercorns, and bay leaves. Bring to a boil; stir to dissolve salt and sugar."
    },
    {
      "position": 2,
      "text": "Remove brine from heat and let cool to room temperature. Store in the refrigerator."
    },
    {
      "position": 3,
      "text": "Combine brine with 1 gallon of heavily iced water 1 to 2 days before serving the turkey. Place thawed turkey in an extra-large turkey bag and pour in enough brine to cover completely. Refrigerate."
    },
    {
      "position": 4,
      "text": "Remove turkey from the brine and rinse inside and out with cold water. Discard brine and start cooking."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,

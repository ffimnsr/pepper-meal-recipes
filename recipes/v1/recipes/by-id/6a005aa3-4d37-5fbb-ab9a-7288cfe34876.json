  "id": "6a005aa3-4d37-5fbb-ab9a-7288cfe34876",
  "slug": "marinated-pork-tenderloin",
  "name": "Marinated Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "For this easy-to-follow recipe, pork tenderloin marinates in sherry, cinnamon, brown sugar and soy sauce, for sweet, moist and tender results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place soy sauce, brown sugar, sherry, dried onion, cinnamon, olive oil, and a touch of garlic powder in a large resealable plastic bag. Seal, and shake to mix. Place pork in bag with marinade, seal, and refrigerate for 6 to 12 hours."
    },
    {
      "position": 2,
      "text": "Preheat grill for high heat."
    },
    {
      "position": 3,
      "text": "Lightly oil grate. Place tenderloins on grill, and discard marinade. Cook 20 minutes, or to desired doneness. Slice into medallions, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

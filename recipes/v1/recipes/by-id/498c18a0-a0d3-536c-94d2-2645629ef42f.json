  "id": "498c18a0-a0d3-536c-94d2-2645629ef42f",
  "slug": "perfect-pita-chips",
  "name": "Perfect Pita Chips",
  "recipe_type": "appetizer",
  "brief_description": "This crispy, garlicky perfect pita chip recipe is quick and easy to make with just a package of pita pockets, olive oil, garlic powder, and garlic salt.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Brush one side of each pita pocket with oil; sprinkle with garlic powder, kosher salt, and garlic salt. Evenly slice each pocket into 4 triangles; arrange, oiled-sides up, on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pita chips are light brown, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

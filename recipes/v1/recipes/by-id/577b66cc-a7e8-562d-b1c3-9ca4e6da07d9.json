  "id": "577b66cc-a7e8-562d-b1c3-9ca4e6da07d9",
  "slug": "faux-kin-noodle-soup-vegan-chicken-noodle-soup",
  "name": "Faux-kin Noodle Soup (Vegan Chicken Noodle Soup)",
  "recipe_type": "soup",
  "brief_description": "This hearty vegan noodle soup with carrots, seitan, and pasta is comfort food when you're feeling under the weather and want something like mom used to make, only vegan style.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Saute carrots, celery, onion, leek, and shallot in a soup pot over medium-high heat until onion is translucent and carrots lose their crunch, 7 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Pour broth over vegetables in the pot and bring to a rolling boil. Dissolve bouillon into broth; reduce heat to a simmer."
    },
    {
      "position": 3,
      "text": "Add parsley, bay leaves, thyme, salt, and pepper. Cook until carrots are soft, about 10 minutes more."
    },
    {
      "position": 4,
      "text": "Add pasta and seitan and cook until pasta is al dente, another 7 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

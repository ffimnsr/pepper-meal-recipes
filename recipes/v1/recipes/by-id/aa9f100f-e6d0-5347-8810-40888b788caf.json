  "id": "aa9f100f-e6d0-5347-8810-40888b788caf",
  "slug": "whitney-and-ashleys-flawless-roasted-vegetables",
  "name": "Whitney and Ashley's Flawless Roasted Vegetables",
  "recipe_type": "side",
  "brief_description": "Whitney and Ashley's flawless roasted vegetables recipe includes zucchini, yellow squash, bell pepper, and onions, tossed with olive oil and dried herbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C) with rack in top position. Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place zucchini, yellow squash, onion, and bell pepper in a large bowl. Add olive oil, 2 teaspoons Italian seasoning, salt, and black pepper; toss to coat."
    },
    {
      "position": 3,
      "text": "Spread vegetables in a single layer on the prepared baking sheet; season with Italian seasoning."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven on the top rack until vegetables are crisp-tender, about 15 minutes; squeeze with lemon juice before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d4dc94de-7949-50f1-a170-db4c5510b8cd",
  "slug": "sweet-and-spicy-tempeh-with-long-beans",
  "name": "Sweet and Spicy Tempeh with Long Beans",
  "recipe_type": "dessert",
  "brief_description": "The combination of tempeh and long beans is especially delicious and makes for a great vegetarian meal. You can substitute green beans if you like.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine shallots, garlic, and ginger in a mortar and pestle and grind into a spice paste."
    },
    {
      "position": 2,
      "text": "Heat enough oil in a deep skillet for deep frying. Deep-fry tempeh until golden brown, 5 to 10 minutes. Transfer to a plate lined with paper towels to drain."
    },
    {
      "position": 3,
      "text": "Drain most of oil from the skillet, leaving about 2 tablespoon of oil. Saut\u00e9 spice paste and lemongrass until fragrant, about 3 minutes. Add long beans, soy sauce, garlic-chili oil, and palm sugar. Cook until long beans are tender but still have a bit of crunch, about 2 minutes. Add baby kale and cook until wilted, about 2 minutes. Remove lemongrass knot before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

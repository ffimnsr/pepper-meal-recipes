  "id": "50c7a29b-b148-53f0-9e48-7c5bf36b70aa",
  "slug": "go-to-crawfish-etouffee",
  "name": "Go-To Crawfish Etouffee",
  "recipe_type": "soup",
  "brief_description": "A simplified but delicious version of this Cajun favorite takes it from a once-in-a-while special treat to a weeknight favorite. You don't slave over a traditional roux, and the recipe only takes 40 minutes.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Melt the butter in a large, heavy skillet over medium heat, and stir in the onion, green bell pepper, green onions, and celery; cook the vegetables, stirring frequently, until the onion is translucent and the vegetables have begun to soften, about 10 minutes. Stir in the golden mushroom soup, parsley, Cajun seasoning, salt, and black pepper, and bring the sauce to a boil."
    },
    {
      "position": 2,
      "text": "Gently mix in the crawfish tail meat, and simmer until the crawfish tails are opaque, 10 to 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

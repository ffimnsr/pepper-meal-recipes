  "id": "142d2df0-4a7c-59e4-9c09-6bb0bfbf2f0f",
  "slug": "pressure-cooker-soup-from-moscow-with-cabbage",
  "name": "Pressure Cooker Soup: From Moscow with Cabbage",
  "recipe_type": "soup",
  "brief_description": "A comforting and nutritious weeknight dinner, this Russian-style cabbage soup is easy to make in an electric pressure cooker such as Instant Pot\u00ae.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a multi-functional pressure cooker on Saute mode. Saute onion, carrot, and celery until onion is translucent, about 5 minutes. Toss in cabbage and potato; cook until cabbage starts to break down, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Mix chicken stock, mustard, and ketchup into the cabbage mixture. Cook and stir until combined, about 1 minute. Stir in salt and pepper; add bay leaf and clove. Place garlic in the center of the pot."
    },
    {
      "position": 3,
      "text": "Close the pot and lock the lid. Select Soup setting or high pressure according to manufacturer's instructions; set timer for 6 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove lid."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

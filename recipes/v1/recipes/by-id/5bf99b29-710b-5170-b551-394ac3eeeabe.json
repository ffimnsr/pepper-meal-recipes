  "schema_version": 1,
  "id": "5bf99b29-710b-5170-b551-394ac3eeeabe",
  "slug": "bluezys-stuffed-jalapenos-with-bacon",
  "name": "Bluezy's Stuffed Jalapenos with Bacon",
  "recipe_type": "appetizer",
  "brief_description": "Jalapeno pepper halves are stuffed with creamy Cheddar cheese filling and topped with a bacon slice for a delicious warm appetizer with a hint of the heat. They're great on the grill, too.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Place bacon in a skillet over medium heat, working in batches, and cook until bacon is translucent and still flexible, about 2 minutes per side. Set bacon aside."
    },
    {
      "position": 3,
      "text": "Trim membranes from jalapeno pepper halves to reduce heat. Rinse peppers and set aside."
    },
    {
      "position": 4,
      "text": "Place whipped cream cheese and Cheddar cheese into a bowl and mix until well blended; stir in Worcestershire sauce. Spoon cheese mixture into a pastry bag fitted with a large tip. Pipe the cheese filling generously into the pepper halves. Top each filled pepper with a precooked bacon strip and arrange onto prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese filling is bubbling and the bacon strips are lightly browned, 8 to 14 minutes. Serve hot."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "watermelon-raspberry-lemonade",
  "name": "Watermelon-Raspberry Lemonade",
  "recipe_type": "drink",
  "brief_description": "This easy watermelon-raspberry lemonade recipe is made with fresh watermelon, raspberry, lemon juice, and simple syrup \u2014 thirst-quenching on a hot day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine \u2153 cup water and sugar in a small saucepan; bring to a boil, stirring constantly, until sugar dissolves. Cool."
    },
    {
      "position": 2,
      "text": "Place watermelon, raspberries, and remaining \u2154 cup water in a blender; blend until smooth. Transfer to a frosted pitcher; stir in simple syrup and lime juice. Refrigerate until chilled, about 1 hour."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

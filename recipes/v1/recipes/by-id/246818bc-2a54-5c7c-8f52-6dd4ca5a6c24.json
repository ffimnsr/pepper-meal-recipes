  "id": "246818bc-2a54-5c7c-8f52-6dd4ca5a6c24",
  "slug": "kentucky-pecan-pie",
  "name": "Kentucky Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "Corn syrup and brown sugar do magical things in this simple pecan pie with a rich, gooey, and delicious filling. Perfect for holiday bake sales.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together corn syrup, sugar, melted butter, and salt in a large bowl. Add eggs and beat until well combined. Pour mixture into the pie crust and sprinkle pecans over top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and let cool to room temperature before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

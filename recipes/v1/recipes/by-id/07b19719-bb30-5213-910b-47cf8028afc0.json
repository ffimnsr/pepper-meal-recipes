  "id": "07b19719-bb30-5213-910b-47cf8028afc0",
  "slug": "broccoli-and-cheddar-quiche",
  "name": "Broccoli and Cheddar Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This tender broccoli Cheddar quiche flavored with Dijon mustard, oregano, and thyme is incredibly easy to prep for a last-minute brunch or light dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Place pie crust into a 9-inch deep pie dish and prick crust all over with a fork; brush with oil. Place crust onto prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven for 8 minutes."
    },
    {
      "position": 4,
      "text": "Place broccoli into a bowl and microwave on high until broccoli is bright green and slightly tender, about 4 minutes. Whisk eggs, milk, Dijon mustard, oregano, salt, pepper, and thyme in a bowl; stir broccoli into egg mixture. Pour mixture into crust and sprinkle quiche with Cheddar and Parmesan cheeses. Place pie dish on the baking sheet."
    },
    {
      "position": 5,
      "text": "Bake until a knife inserted into the middle of the quiche comes out clean, about 40 minutes. Let stand 10 minutes before cutting."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

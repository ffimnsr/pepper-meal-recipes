  "id": "5c995594-cb9c-5590-b15b-3d5bc00ac8cd",
  "slug": "neiman-marcus-carrot-cake-recipe-11928998",
  "name": "Neiman Marcus Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "This copycat Neiman Marcus carrot cake is an easier riff on the department store version. Use carrot cake mix, with extra shredded carrots, in place of the original recipe, and bake with a vanilla cheesecake layer on top.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x9-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine cake mix, 2 eggs, 1 tablespoon vanilla, shredded carrots, and melted butter in a bowl; mix well. Batter will be thick. Spread batter on the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine cream cheese, remaining 2 eggs, remaining vanilla, 2 cups confectioner's sugar, and mix until smooth. Spread evenly on top of carrot cake mix."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is jiggly in the center but set on the sides (cake should be gooey), 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Remove cake to cool on a wire rack, then top with confectioner's sugar and enjoy."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

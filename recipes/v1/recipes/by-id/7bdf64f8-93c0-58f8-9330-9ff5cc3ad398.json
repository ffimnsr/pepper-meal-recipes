  "id": "7bdf64f8-93c0-58f8-9330-9ff5cc3ad398",
  "slug": "marry-me-chickpeas-recipe-11688105",
  "name": "Marry Me Chickpeas",
  "recipe_type": "side",
  "brief_description": "These marry me chickpeas combine convenient canned chickpeas with a rich sun-dried tomato and coconut sauce, for a delicious vegetarian dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a 10-inch skillet over medium heat. Add shallots and garlic. Cook until fragrant, 1 to 2 minutes."
    },
    {
      "position": 2,
      "text": "Add paprika, oregano, salt, and pepper flakes, and cook and stir to toast spices, about 1 minute. Add tomato paste, sundried tomatoes, and chickpeas, and stir well to fully coat chickpeas."
    },
    {
      "position": 3,
      "text": "Add vegetable broth and lemon juice, cover, and simmer for 10 minutes. Add a little more broth if mixture seems too thick. Add coconut milk, stir well, and remove from heat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

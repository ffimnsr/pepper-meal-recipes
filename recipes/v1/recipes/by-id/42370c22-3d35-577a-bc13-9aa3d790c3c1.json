  "id": "42370c22-3d35-577a-bc13-9aa3d790c3c1",
  "slug": "easy-chicken-gyro",
  "name": "Easy Chicken Gyro",
  "recipe_type": "main",
  "brief_description": "Try this easy chicken gyro recipe featuring warm pita sandwiches filled with marinated, broiled chicken, fresh vegetables, and a creamy tzatziki sauce.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the tzatziki: Combine yogurt, cucumber, garlic, oil, dill, vinegar, lemon juice, salt, and pepper in a blender. Blend until smooth, then cover and refrigerate until needed."
    },
    {
      "position": 3,
      "text": "Make the chicken: Whisk garlic, lemon juice, oil, oregano, vinegar, salt, and pepper together in a large glass or ceramic bowl. Add chicken and toss until evenly coated. Cover with plastic wrap and marinate in the refrigerator for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source. Line a rimmed baking sheet with foil."
    },
    {
      "position": 5,
      "text": "Remove chicken from the marinade and place onto the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Broil in the preheated oven until lightly browned and no longer pink in the center, 2 to 4 minutes per side. Transfer cooked chicken to a plate and let rest for 5 minutes."
    },
    {
      "position": 7,
      "text": "While the chicken is resting, make the gyros: Heat a large nonstick skillet over medium heat. Cook each pita in the hot skillet until warm and soft, about 1 minute per side."
    },
    {
      "position": 8,
      "text": "Top warm pitas with chicken strips, tzatziki, lettuce, tomato, and onion."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

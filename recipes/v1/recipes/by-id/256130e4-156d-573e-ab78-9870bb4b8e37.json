  "id": "256130e4-156d-573e-ab78-9870bb4b8e37",
  "slug": "cheesy-bacon-ham-and-swiss-tater-tots-poutine",
  "name": "Cheesy Bacon, Ham, and Swiss Tater Tots Poutine",
  "recipe_type": "appetizer",
  "brief_description": "These tater tots are smothered in bacon, ham, Swiss, and Cheddar cheese with gravy, similar to poutine — a great side dish or appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potato nuggets on a baking sheet in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned and crisp, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and top with gravy, diced ham, Swiss cheese, and Cheddar cheese. Return to the oven and bake until cheese is melted, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Top with crumbled bacon and chives. Scatter cheese curds around and serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

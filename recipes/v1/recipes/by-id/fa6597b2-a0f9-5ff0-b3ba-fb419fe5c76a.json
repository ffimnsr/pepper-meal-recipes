  "id": "fa6597b2-a0f9-5ff0-b3ba-fb419fe5c76a",
  "slug": "german-chocolate-cake-frosting",
  "name": "German Chocolate Cake Frosting",
  "recipe_type": "dessert",
  "brief_description": "This German chocolate cake frosting is made from scratch with coconut and pecans for a thick and creamy topping perfect on German chocolate cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine evaporated milk, brown sugar, butter, egg yolks, and vanilla in a saucepan over medium heat. Cook, stirring constantly, at a low boil until mixture turns a light caramel color and thickens, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in coconut and pecans. Let cool to room temperature before spreading on cake."
    },
    {
      "position": 4,
      "text": "Use to frost a German chocolate cake. Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

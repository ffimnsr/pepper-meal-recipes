  "id": "39f7c894-0d49-525c-9608-0dae3db598fe",
  "slug": "vegetarian-bean-burritos",
  "name": "Vegetarian Bean Burritos",
  "recipe_type": "main",
  "brief_description": "These vegetarian bean burritos have a flavorful layer of pureed pinto beans, rolled together with lettuce and Colby Jack cheese.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Blend pinto beans, tomato sauce, and taco seasoning in a food processor until a paste forms."
    },
    {
      "position": 2,
      "text": "Cook and stir pinto bean mixture in a skillet over medium heat until warmed, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Place tortillas on a plate and heat in microwave on high until warm, about 30 seconds. Spread warm pinto bean mixture, shredded lettuce, and Colby Jack cheese onto each warm tortilla. Roll the tortilla around the filling to form a burrito."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

  "slug": "thanksgiving-quesadilla",
  "name": "Thanksgiving Quesadilla",
  "recipe_type": "main",
  "brief_description": "These leftover turkey quesadillas with cranberry sauce, cheese, and jalape\u00f1o are a clever and tasty way to use your Thanksgiving leftovers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium heat. Place 1 tortilla in the skillet and top with 1/2 of the Cheddar cheese, turkey, cranberry sauce, jalape\u00f1o pepper, green onion, and remaining Cheddar cheese, respectively. Place remaining tortilla over the top."
    },
    {
      "position": 2,
      "text": "Cook until tortilla is golden brown and cheese is melted, 2 to 4 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

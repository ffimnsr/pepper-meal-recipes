  "id": "55bb02ae-0edf-5fc6-8068-98a6506b0270",
  "slug": "easy-marinated-feta",
  "name": "Easy Marinated Feta",
  "recipe_type": "appetizer",
  "brief_description": "Marinated feta is a great addition to any antipasti platter or serve it on its own with crusty bread as an appetizer or nibble with a glass of wine.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place feta cheese in a glass jar. Add chile pepper, herbes de Provence, and lemon zest. Fill jar with olive oil so feta is completely covered and seal."
    },
    {
      "position": 2,
      "text": "Marinate in a cool place, but not in the refrigerator, for 3 to 4 days. Remove chile pepper before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

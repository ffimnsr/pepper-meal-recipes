  "id": "82b1dd71-8f94-5e22-82b7-f05eeb8f25b6",
  "slug": "movie-star-popcorn",
  "name": "Movie Star Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "This homemade popcorn is made the old-fashioned way on the stovetop. It tastes great and is easy to make with pantry staples and nothing artificial!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a 2- to 3-quart saucepan or pot with a lid set over medium-high heat. Pour in popcorn kernels and sprinkle enough salt to cover the layer of kernels lightly. Remember, you can always add more salt later. Add butter to the pot and cover with the lid."
    },
    {
      "position": 2,
      "text": "As soon as kernels start to pop, shake the pot back and forth across the burner constantly until the popping slows down. When the pops are about 2 seconds apart, remove from heat and pour popcorn into a serving bowl. Taste and season with more salt if desired."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

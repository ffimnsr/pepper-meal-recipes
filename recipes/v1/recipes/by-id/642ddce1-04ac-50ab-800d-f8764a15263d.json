  "id": "642ddce1-04ac-50ab-800d-f8764a15263d",
  "slug": "chili-rellenos-casserole",
  "name": "Chili Relleno Casserole",
  "recipe_type": "main",
  "brief_description": "This chili relleno casserole has all the flavors of Mexican stuffed peppers in this easy dish made with canned chiles, cheese, egg, milk, and sauce.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Evenly layer poblano peppers from 1 can in the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Sprinkle with 1/2 of the Jack and Cheddar cheeses, then cover with remaining poblano peppers."
    },
    {
      "position": 4,
      "text": "Mix eggs, evaporated milk, and flour together in a bowl; if mixture is too thick, you can add 1/2 cup milk to thin to desired consistency. Pour over chiles."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 minutes. Pour enchilada sauce evenly over the top; continue baking for 15 more minutes."
    },
    {
      "position": 6,
      "text": "Turn broiler on. Sprinkle top with remaining Jack and Cheddar cheeses. Place under the broiler until cheese is melted, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

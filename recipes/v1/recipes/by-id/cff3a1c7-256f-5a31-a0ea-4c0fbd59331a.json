  "id": "cff3a1c7-256f-5a31-a0ea-4c0fbd59331a",
  "slug": "skillet-chicken-bulgogi",
  "name": "Skillet Chicken Bulgogi",
  "recipe_type": "main",
  "brief_description": "An easy recipe for chicken bulgogi that comes together in 30 minutes. Get dinner on the table quickly with this Korean skillet dish everyone loves.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk onion, soy sauce, brown sugar, garlic, sesame oil, sesame seeds, cayenne pepper, salt, and black pepper together in a bowl until marinade is smooth."
    },
    {
      "position": 2,
      "text": "Cook and stir chicken and marinade together in a large skillet over medium-high heat until chicken is cooked through, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "efaf09d0-7879-5fe0-8518-0a63cfad1944",
  "slug": "easy-baked-chicken-rice-and-broccoli-casserole",
  "name": "Easy Baked Chicken, Rice, and Broccoli Casserole",
  "recipe_type": "main",
  "brief_description": "This easy, budget-friendly baked chicken, rice, and broccoli casserole with cheese is perfect for busy weeknights and tastes comforting and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine chicken, condensed soup, broccoli, rice, and water in a bowl; mix thoroughly. Transfer mixture to the prepared baking pan and cover with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes. Uncover, stir, top with Cheddar cheese, and cover again. Continue to bake until chicken is no longer pink in the center, rice is tender, and cheese is melted and bubbly, about 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

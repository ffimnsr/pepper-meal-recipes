  "id": "885113fc-b5fc-51e2-86f8-4dd2041850ab",
  "slug": "sausage-egg-roll-in-bowl",
  "name": "Sausage Egg Roll in Bowl",
  "recipe_type": "appetizer",
  "brief_description": "This sausage egg roll in a bowl with greated vegetables and ground pork is a unique recipe for a deconstructed egg roll without the fried wrapper.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir pork sausage in the hot skillet until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Add coleslaw mix, carrots, green onions, garlic, soy sauce, and sesame oil. Cook and stir until vegetables are tender, 7 to 10 minutes. Stir in sunflower seeds and ginger."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

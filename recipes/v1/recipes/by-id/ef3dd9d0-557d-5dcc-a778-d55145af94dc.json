  "id": "ef3dd9d0-557d-5dcc-a778-d55145af94dc",
  "slug": "how-to-make-arroz-con-leche-recipe-7507398",
  "name": "How to Make Arroz con Leche",
  "recipe_type": "dessert",
  "brief_description": "This easy recipe will teach you how to make arroz con leche (Mexican rice pudding) with simple step-by step directions and photos so you can follow along.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water and cinnamon sticks in a medium saucepan over high heat."
    },
    {
      "position": 3,
      "text": "Bring to a boil. Reduce heat, cover, and simmer until cinnamon releases its color and flavor, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add rice; bring to a boil. Reduce heat, cover, and simmer until rice is tender and water is absorbed, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Stir in sweetened condensed milk, evaporated milk, and whole milk; cook, uncovered, over medium heat until mixture has thickened to desired consistency, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Serve warm or cold. Sprinkle servings with ground cinnamon."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

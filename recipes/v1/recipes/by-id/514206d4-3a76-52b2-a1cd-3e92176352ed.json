  "id": "514206d4-3a76-52b2-a1cd-3e92176352ed",
  "slug": "apples-by-the-fire",
  "name": "Apples by the Fire",
  "recipe_type": "dessert",
  "brief_description": "This recipe stuffs a tart apple with cinnamon and brown sugar, wraps it in foil, then places it in the coals of a fire for a camping or cookout dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Build a campfire or preheat an outdoor charcoal grill; allow fire to burn until a bed of coals has accumulated. Rake coals into a flat bed on one side of the fire."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine brown sugar and cinnamon in a small bowl; spoon into apple core. Wrap apple in a large piece of heavy-duty aluminum foil, twisting extra foil into a tail for a handle."
    },
    {
      "position": 3,
      "text": "Place foil-wrapped apple in the coals; cook until softened, 5 to 10 minutes. Remove apple from the coals; unwrap carefully to avoid being burnt by hot sugar."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

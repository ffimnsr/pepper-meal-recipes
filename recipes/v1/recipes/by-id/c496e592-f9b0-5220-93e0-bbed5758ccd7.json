  "id": "c496e592-f9b0-5220-93e0-bbed5758ccd7",
  "slug": "chicken-enchiladas-v",
  "name": "Chicken Enchiladas with Cream of Chicken Soup",
  "recipe_type": "soup",
  "brief_description": "This chicken enchilada recipe with cream of chicken soup is quick and easy with simple, flavorful ingredients \u2014 baked together in cheesy perfection.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix soup and sour cream in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Melt margarine in a medium saucepan over medium-high heat. Add onion and chili powder, and saut\u00e9 until tender. Stir in chicken, chile peppers, and 2 tablespoons of the soup mixture. Cook and stir until heated through."
    },
    {
      "position": 4,
      "text": "Spread 1/2 cup of the soup mixture in a 9x13-inch baking dish. Spoon about 1/4 cup of the chicken mixture down the center of each tortilla. Roll up tortillas and place, seam-sides-down, in the baking dish. Spoon remaining soup mixture on top, and sprinkle with cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly and lightly browned, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f279d027-53d8-50d2-afa0-e8e16fea4b29",
  "slug": "kielbasa-pierogi-soup-recipe-12107569",
  "name": "Kielbasa Pierogi Soup",
  "recipe_type": "soup",
  "brief_description": "Pillowy pierogi, hearty kielbasa, and tender cabbage bulk up paprika-flavored broth for a tasty, yet quick soup. For extra flavor, brown the pierogi in batches with 2 tablespoons butter in an extra-large skillet before adding them to the soup.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil over medium heat in a 6- to 8-quart Dutch oven. Add kielbasa; cook, stirring occasionally, until browned, about 5 minutes. Use a slotted spoon to transfer kielbasa to a paper towel-lined plate."
    },
    {
      "position": 2,
      "text": "Increase heat to medium-high. Add cabbage; cook, stirring occasionally, until browned, 4 to 5 minutes. Reduce heat to medium. Add onion, carrot, and celery; cook, stirring occasionally, until softened, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Return kielbasa to the pot; stir in broth, mustard, paprika, caraway seeds, and salt. Add pierogi to soup. Cook, uncovered, until pierogi are tender and float, about 5 minutes. Stir in lemon juice and dill. Garnish with celery leaves and additional dill. Serve with sour cream."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

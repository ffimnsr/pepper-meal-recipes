  "id": "85af872d-050d-53a5-bec0-792ebef9ed93",
  "slug": "cheesy-tuna-and-zucchini-noodle-casserole",
  "name": "Cheesy Tuna and Zucchini Noodle Casserole",
  "recipe_type": "main",
  "brief_description": "This mock macaroni and cheese dish with zucchini noodles and tuna is lower in carbs and higher in protein than the real thing, but still tastes delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place spiralized zucchini (zoodles) into a pot and cover with well salted water; bring to a boil. Boil for 3 to 4 minutes, then empty into a colander to drain. Let drain for 2 to 3 hours, occasionally pressing out as much moisture as you can."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly spray a 9x13-inch glass casserole with cooking spray and add drained zoodles."
    },
    {
      "position": 3,
      "text": "Bake zoodles in the preheated oven for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt butter in a skillet over medium heat. Add onion and cook until soft and translucent, about 5 minutes. Add garlic and cook until softened, about 1 minute. Add cream cheese and cook until softened, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Remove zoodles from the oven and pour off any liquid. Add the skillet mixture to the zoodles, along with tuna, peas, Cheddar cheese, salt, and pepper. Stir until well combined. Sprinkle almonds on top."
    },
    {
      "position": 6,
      "text": "Bake until cheese is melted and bubbly, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

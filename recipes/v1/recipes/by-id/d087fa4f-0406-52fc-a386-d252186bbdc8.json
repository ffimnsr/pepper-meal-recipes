  "slug": "air-fryer-butternut-squash-home-fries",
  "name": "Air Fryer Butternut Squash Home Fries",
  "recipe_type": "side",
  "brief_description": "This air fryer butternut squash home fries recipe calls for everything bagel seasoning and fresh rosemary for a perfectly caramelized, delicious side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss squash with oil in a large bowl. Add squash to the air fryer basket. Cook until lightly browned, stirring every 3 to 4 minutes, about 22 minutes total."
    },
    {
      "position": 3,
      "text": "Transfer to a plate; sprinkle seasoning blend evenly over top; garnish with rosemary."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 22,
  "preparation_time_minutes": 10,

  "id": "1b0b1d71-fa87-5835-8274-d872061aedd6",
  "slug": "amazing-ground-turkey-tomato-sauce",
  "name": "Amazing Ground Turkey Tomato Sauce",
  "recipe_type": "side",
  "brief_description": "Pasta sauce with ground turkey is a great option to ladle over your favorite noodles as turkey is leaner than beef. You may not even taste the difference!",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium-high heat. Add onion, tomato, basil, and garlic; saut\u00e9 until onion begins to soften, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Break ground turkey into small pieces and add to the pot; season with Italian seasoning and oregano. Cook and stir until turkey is completely browned, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in tomato sauce and bring to a boil. Reduce the heat to low and simmer until sauce has thickened slightly, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Stir in tomato paste until mixture is evenly colored; season with salt and pepper. Cook for 1 to 2 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

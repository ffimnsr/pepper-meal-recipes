  "id": "127ca9ea-22a7-51d4-ae2f-57c874f0dcde",
  "slug": "cindis-egg-rolls",
  "name": "Cindi's Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These are the best-tasting egg rolls you'll ever have. They're even better than the ones served at Asian restaurants.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons vegetable oil in large wok over medium-high heat. Stir-fry pork for 3 minutes. Transfer pork to paper towel-lined plate and set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix the cabbage, carrot, green bell pepper, onion, garlic and ginger. In a small bowl, mix the cornstarch, soy sauce, and molasses until smooth."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in wok. Stir in cabbage mixture in batches, cooking each batch 3 to 4 minutes, just until tender. Return vegetables to bowl, and mix in pork. Stir in the cornstarch mixture."
    },
    {
      "position": 4,
      "text": "Prepare a work surface for rolling the egg rolls. Lay several egg roll wrappers in a row. Place the water in a small bowl; you'll use this for sealing."
    },
    {
      "position": 5,
      "text": "Place about 2 to 3 tablespoons filling on each egg roll wrapper. Dip a finger in the water and run it along the edge of the wrapper. Fold one corner of wrapper over filling. Fold wrapper sides over filling. Roll wrappers to form egg rolls (See Cook's Note)."
    },
    {
      "position": 6,
      "text": "Heat 1 quart oil in a deep fryer to 365 degrees F (185 degrees C)."
    },
    {
      "position": 7,
      "text": "Fry egg rolls in batches in the hot oil until golden brown. Drain on paper towels and serve with sweet and sour sauce."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,

  "slug": "copycat-taco-bell-enchirito-recipe-12024872",
  "name": "Copycat Taco Bell Enchirito",
  "recipe_type": "main",
  "brief_description": "This copycat Taco Bell Enchirito brings the iconic fast food favorite home with soft flour tortillas, seasoned beef, refried beans, tangy red sauce, and plenty of melted cheese. It\u2019s a comforting lunch or dinner that\u2019s simple to make and perfect for satisfying Taco Bell cravings.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven\u2019s broiler and place a rack about 6 inches from the heat source."
    },
    {
      "position": 2,
      "text": "Place tortilla on a work surface. Spread refried beans down the center; top with taco meat and onion."
    },
    {
      "position": 3,
      "text": "Wrap the tortilla around the filling and place, seam-side down, in a small baking dish. Pour sauce evenly over the tortilla and top with cheese."
    },
    {
      "position": 4,
      "text": "Broil until the cheese is melted and the sauce is bubbly around the edges, 1 to 2 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

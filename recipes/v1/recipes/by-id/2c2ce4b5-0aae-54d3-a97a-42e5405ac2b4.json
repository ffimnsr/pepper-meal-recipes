  "id": "2c2ce4b5-0aae-54d3-a97a-42e5405ac2b4",
  "slug": "baked-ziti-i",
  "name": "Baked Ziti",
  "recipe_type": "main",
  "brief_description": "Baked ziti pasta with ground beef, spaghetti sauce, and three kinds of Italian cheese makes a surprisingly easy, family-pleasing weeknight meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti pasta, and cook until al dente, about 8 minutes; drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, brown ground beef and onion in a large skillet over medium heat; stir in spaghetti sauce and simmer for 15 minutes. Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Spread 1/2 of the ziti in the bottom of the prepared dish."
    },
    {
      "position": 5,
      "text": "Top with Provolone cheese."
    },
    {
      "position": 6,
      "text": "Top with sour cream."
    },
    {
      "position": 7,
      "text": "Add 1/2 of the meat sauce, remaining ziti, mozzarella cheese, and remaining meat sauce. Top with grated Parmesan cheese."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until heated through and cheeses have melted, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

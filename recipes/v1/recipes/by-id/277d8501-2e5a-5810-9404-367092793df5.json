  "id": "277d8501-2e5a-5810-9404-367092793df5",
  "slug": "tofu-broccoli-stir-fry-recipe-11710358",
  "name": "Tofu Broccoli Stir-Fry",
  "recipe_type": "main",
  "brief_description": "In this tofu broccoli stir-fry, crispy tofu, broccoli, and water chestnuts are cooked with kung pao sauce and peanuts - a quick dinner option for weeknights. Serve over rice or noodles.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Place tofu cubes in a bowl, sprinkle with cornstarch, and toss to combine."
    },
    {
      "position": 2,
      "text": "Cook tofu in the skillet for 4 minutes. Using tongs, flip cubes over and cook 4 minutes more. Drain tofu on a paper towel-lined plate."
    },
    {
      "position": 3,
      "text": "Drain skillet; wipe clean with paper towels. Add sesame oil and broccoli. Cook for 6 minutes, stirring continually. Add water chestnuts, kung pao sauce, and water. Cook for 4 minutes more. Turn off heat."
    },
    {
      "position": 4,
      "text": "Stir in reserved tofu. Toss until evenly combined. Top with green onions and peanuts. Serve over rice or noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

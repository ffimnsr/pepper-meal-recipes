  "id": "97058b60-32d6-523a-b1b9-fbcb676b7877",
  "slug": "fresh-pumpkin-pie",
  "name": "Fresh Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This fresh pumpkin pie recipe is made with fresh pur\u00e9ed pumpkin, honey, spices, eggs, milk, and cream, poured into a pie shell, and baked until set.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a jelly roll pan with aluminum foil; lightly oil the foil."
    },
    {
      "position": 2,
      "text": "Cut pumpkin in half; remove seeds. Lightly oil cut surfaces; place cut-sides down on the prepared jelly roll pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until flesh is fork-tender, about 45 minutes. Cool until just warm."
    },
    {
      "position": 4,
      "text": "Increase the oven temperature to 400 degrees F ( 205 degrees C)."
    },
    {
      "position": 5,
      "text": "Scrape out pumpkin flesh into a bowl; mash by hand or pur\u00e9e in small batches in a blender."
    },
    {
      "position": 6,
      "text": "Place pie dough into the bottom and up sides of a 9-inch pie plate; flute edges"
    },
    {
      "position": 7,
      "text": "Combine 2 cups pumpkin pur\u00e9e, salt, ginger, and cinnamon, in a large bowl; beat in eggs, honey, milk, and cream. Pour filling into pie shell."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a knife inserted 1 inch from the edge of pie comes out clean, 50 to 55 minutes. Cool on a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 20,

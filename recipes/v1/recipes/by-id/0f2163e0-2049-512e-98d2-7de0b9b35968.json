  "id": "0f2163e0-2049-512e-98d2-7de0b9b35968",
  "slug": "chocolate-nut-biscotti",
  "name": "Chocolate Nut Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Delicious, not too crispy biscotti, which can be dipped in or drizzled with melted chocolate. (You can use slivered almonds instead of the hazelnuts, if you wish.)",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (180 degrees C). Grease and lightly flour cookie sheet."
    },
    {
      "position": 2,
      "text": "In a small bowl, mix flour, baking powder and salt."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar in large bowl until light and fluffy. Beat in eggs and vanilla. Gradually add flour mixture, beating well after each addition. Stir in chocolate and nuts."
    },
    {
      "position": 4,
      "text": "Divide dough into two equal parts. On floured surface, shape dough into two logs, 14 inches long, 1-1/2 inches wide and 1 inch thick. Place two inches apart on prepared cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake for 25 minutes or until lightly browned. Remove to a cutting board. Let cool 5 minutes. Cut into 3/4 inch thick diagonal slices and return to cookie sheet, standing upright."
    },
    {
      "position": 6,
      "text": "Bake 10 minutes more or until slightly dry. Cool completely on wire racks."
    }
  ],
  "servings": 18,

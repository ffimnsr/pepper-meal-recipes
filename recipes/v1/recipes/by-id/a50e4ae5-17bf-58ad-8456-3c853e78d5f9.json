  "id": "a50e4ae5-17bf-58ad-8456-3c853e78d5f9",
  "slug": "easy-apple-kuchen",
  "name": "Easy Apple Kuchen",
  "recipe_type": "dessert",
  "brief_description": "This easy apple kuchen recipe makes a traditional, German-style slab pie with a cinnamon-spiced topping. It's the perfect crowd-pleasing fall dessert.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat milk, 1/4 cup butter, egg, and vanilla extract together in a large bowl until smooth. Stir in 1 1/2 cups flour, 1/2 cup sugar, baking powder, and salt until pie dough comes together. Spread evenly on a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Spread apples evenly over dough."
    },
    {
      "position": 4,
      "text": "Stir 1 cup sugar, 1/4 cup melted butter, 1/4 cup flour, and cinnamon together in a medium bowl until topping is combined. Sprinkle topping over apples."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until apples are tender and topping is golden, about 40 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

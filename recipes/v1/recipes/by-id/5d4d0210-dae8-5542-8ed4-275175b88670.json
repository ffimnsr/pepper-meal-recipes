  "id": "5d4d0210-dae8-5542-8ed4-275175b88670",
  "slug": "baked-lemon-butter-chicken-thighs",
  "name": "Baked Lemon Butter Chicken Thighs",
  "recipe_type": "main",
  "brief_description": "Succulent lemon and garlic baked chicken thighs; an easy and tasty weeknight meal that's guaranteed to impress the pickiest eaters!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place 3 tablespoons butter in a microwave-safe bowl and heat in a microwave oven until melted, 1 to 2 minutes. Smash garlic cloves with the side of a chef's knife and add garlic to the warm butter. Stir in lemon juice and onion powder; set aside."
    },
    {
      "position": 3,
      "text": "Sprinkle both sides of chicken thighs with salt and pepper. Heat remaining 1 tablespoon butter in a medium oven-safe skillet over medium-high heat. Brown chicken, skin-side down, for 3 to 4 minutes. Flip chicken over and brush skin with lemon-butter mixture. Pour remaining butter mixture into skillet and remove from heat."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until chicken is no longer pink at the bone and the juices run clear, about 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C). Brush skin every 10 minutes with pan juices."
    },
    {
      "position": 5,
      "text": "Remove skillet from the oven and place chicken on a serving platter. Drizzle chicken with pan juices and garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

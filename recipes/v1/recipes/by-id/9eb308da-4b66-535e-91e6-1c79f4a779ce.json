  "id": "9eb308da-4b66-535e-91e6-1c79f4a779ce",
  "slug": "lime-cilantro-rice",
  "name": "Lime Cilantro Rice",
  "recipe_type": "side",
  "brief_description": "This cilantro lime rice is easy to make and ready to serve in just 30 minutes. Perfect with salmon or chicken, or to jazz up burrito bowls and tacos.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and salt to a boil in a small saucepan. Stir in rice and butter. Reduce heat to low, cover, and simmer until rice is tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Just before serving, add cilantro, lime juice, and lime zest."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

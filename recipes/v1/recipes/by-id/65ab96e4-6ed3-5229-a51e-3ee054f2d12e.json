  "id": "65ab96e4-6ed3-5229-a51e-3ee054f2d12e",
  "slug": "linzer-torte-cookies",
  "name": "Linzer Torte Cookies",
  "recipe_type": "dessert",
  "brief_description": "These Linzer torte cookie bars are a version of the classic Austrian dessert. You can make them as cookie bars with a lattice top or use cookie cutters if desired.",
  "cuisine": "Austrian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 7x11-inch baking pan."
    },
    {
      "position": 2,
      "text": "Cream sugar and butter together in a medium bowl with an electric mixer. Beat in egg and lemon zest."
    },
    {
      "position": 3,
      "text": "Stir flour, ground almonds, cinnamon, and cloves together in a separate bowl. Gradually stir dry ingredients into wet ingredients. Dough will be stiff and may need to be kneaded by hand in order to come together."
    },
    {
      "position": 4,
      "text": "Divide dough in half. Press one half into the bottom of the prepared pan. Place remaining half onto a lightly floured surface and roll it with your hands into a long, 1/2-inch diameter rope."
    },
    {
      "position": 5,
      "text": "Spread jam over the dough in the pan. Cut dough rope into lengths and arrange them across the jam in a lattice pattern."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top crust is golden, about 40 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and set the pan on a wire rack to cool before cutting into 1x2-inch bars."
    }
  ],
  "servings": 38,
  "cooking_time_minutes": null,

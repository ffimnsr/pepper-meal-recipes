{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4bcec840-18ff-599b-b223-ed3a3a9c4b60",
  "slug": "air-fryer-mashed-potato-cakes",
  "name": "Air Fryer Mashed Potato Cakes",
  "recipe_type": "dessert",
  "brief_description": "These mashed potato cakes are cooked in the air fryer and have a crunchy topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set air fryer to 380 degrees F (190 degrees C) and allow it to heat while making the potato cakes."
    },
    {
      "position": 2,
      "text": "If using a basket style air fryer, cut two pieces of heavy duty aluminum foil about 4 inches wide and 16 inches long to form a foil sling. Spray the sling with cooking spray. For a tray or rack style air fryer, cut the long edges of the foil to fit the tray or rack."
    },
    {
      "position": 3,
      "text": "Crack egg into a mixing bowl and lightly beat with salt and pepper."
    },
    {
      "position": 4,
      "text": "Mix in cold mashed potatoes, 2 Tablespoons flour, and Cheddar cheese. Divide potato mixture into 6 equal-sized portions."
    },
    {
      "position": 5,
      "text": "Combine panko and 1/2 cup flour on a plate."
    },
    {
      "position": 6,
      "text": "Set a portion of the potato mixture onto the plate and flatten it into a cake, about 4 inches across. Gather up some flour and panko and pat into the top. Place on the oiled foil sling."
    },
    {
      "position": 7,
      "text": "Continue until all the potato cakes are formed and placed on the oiled slings, three patties close together on each sling. Leave enough foil on both ends of the sling to help lift the cakes in and our of the basket. See note. Liberally spray the tops of the cakes with olive oil."
    },
    {
      "position": 8,
      "text": "Carefully lift each sling and place it into the basket of the air fryer, allowing the ends of the foil to come up the sides of the basket. (See Cook's Note)."
    },
    {
      "position": 9,
      "text": "Air fry until desired doneness is achieved, about 10 minutes."
    },
    {
      "position": 10,
      "text": "Carefully remove the slings from the air fryer. Use a spatula to place the cakes on a serving plate, sprinkle with chives, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

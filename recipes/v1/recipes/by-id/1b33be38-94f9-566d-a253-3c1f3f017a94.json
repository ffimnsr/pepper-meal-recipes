  "id": "1b33be38-94f9-566d-a253-3c1f3f017a94",
  "slug": "caleys-classic-zucchini-bread",
  "name": "Caley's Classic Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "This zucchini bread recipe makes two moist, flavorful loaves packed with freshly grated squash, warm cinnamon, crunchy walnuts, and sweet vanilla.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Beat eggs in a mixing bowl with an electric mixer until frothy. Slowly add sugar while continually beating. Stir in oil and vanilla; continue beating until mixture is thick. Stir in zucchini."
    },
    {
      "position": 3,
      "text": "Mix flour, cinnamon, baking soda, salt, and baking powder together in a separate bowl; pour into zucchini mixture and stir until just combined. Mix in walnuts. Divide batter between the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of each loaf comes out clean, about 1 hour. Cool in the pans for 10 minutes, then loosen the edges with a knife, remove the loaves, and let cool completely on a wire rack."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

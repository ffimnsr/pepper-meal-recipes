  "id": "5a6f040b-e1d0-55f2-b791-729bc182e2d8",
  "slug": "polish-chicken-and-dumplings",
  "name": "Polish Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "This delicious and comforting Polish chicken soup with homemade dumplings is an old family recipe that has been perfected over the years!",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken, onion, and celery in a large pot; fill the pot with water. Season with poultry seasoning, whole allspice, basil, 1/2 teaspoon salt, 1 teaspoon pepper, and seasoning salt; bring to a boil. Reduce heat, and simmer for approximately 2 hours, or until chicken is cooked."
    },
    {
      "position": 2,
      "text": "Remove chicken from broth and set chicken aside to cool; strain broth to remove seasonings and any bone. Return broth to the pan, stir in cream of chicken soup and continue simmering."
    },
    {
      "position": 3,
      "text": "In a medium bowl, stir together eggs, olive oil, 1 tablespoon salt, and 1 teaspoon pepper with 2 cups water. Gradually add flour, and stir to form a thick dough."
    },
    {
      "position": 4,
      "text": "Using a large spoon and knife, scoop a spoonful of dough and cut small pieces into broth. Repeat with remaining dough. Stir, cover, and simmer for about 15 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, skin and debone chicken; cut meat into small pieces, add to broth and heat through."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 30,

  "id": "d71bab33-ca75-58fd-ada2-f2b6529ba554",
  "slug": "vegan-granola",
  "name": "Vegan Granola",
  "recipe_type": "breakfast",
  "brief_description": "This is an awesome, addictive, one hundred percent vegan granola. Excellent for sprinkling on soy yogurt or in a bowl with rice milk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare two cookie sheets with cooking spray."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine oats, wheat germ, almonds, cinnamon and nutmeg. In a separate bowl, mix apple juice, molasses and extract. Pour the wet ingredients into the dry ingredients, stirring to coat. Spread mixture onto baking sheets."
    },
    {
      "position": 3,
      "text": "Bake for 30 minutes in preheated oven, stirring mixture every 10 to 15 minutes, or until granola has a golden brown color. Let cool. Stir in dried fruit. Store in an airtight container."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

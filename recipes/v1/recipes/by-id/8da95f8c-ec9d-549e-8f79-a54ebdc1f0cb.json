  "id": "8da95f8c-ec9d-549e-8f79-a54ebdc1f0cb",
  "slug": "slow-cooker-chicken-enchilada-casserole-recipe-8788263",
  "name": "Slow Cooker Chicken Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker chicken enchilada casserole with tender shredded chicken thighs, black beans, corn, and tortillas in a flavorful sauce is cheesy and satisfying.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chicken, beans, corn, onion, garlic, salt, pepper, and cumin in a 3 \u00bd- to 4-quart slow cooker. Cover with enchilada sauce."
    },
    {
      "position": 3,
      "text": "Cover and cook for 3 to 4 hours on High or 6 to 7 hours on Low."
    },
    {
      "position": 4,
      "text": "Shred chicken in the slow cooker using two forks."
    },
    {
      "position": 5,
      "text": "Stir in half the cheese and the tortillas. Top with remaining cheese."
    },
    {
      "position": 6,
      "text": "Cover and cook on High until tortillas are softened and cheese is melted, 30 minutes."
    },
    {
      "position": 7,
      "text": "Top servings with lettuce, tomato, green onion, and sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 10,

  "id": "0751257d-5e17-5e84-808b-e36cd3a78cac",
  "slug": "naughty-chocolate-and-peanut-butter-chip-cookies",
  "name": "Naughty Chocolate and Peanut Butter Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This naughty little cookie is richly flavored with port wine. The cookies are redeemed when chocolate and peanut butter chips are melted into the center.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together the margarine and white sugar until smooth. Beat in the egg yolks, vanilla and port wine. Combine the flour and salt; stir into the creamed mixture. Roll the dough into walnut sized balls. Dip each ball in the remaining egg whites. Place cookies 2 inches apart onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 10 to 12 minutes in the preheated oven. Remove from the oven and immediately place 4 or 5 of the chocolate and/or peanut butter chips into the center of each cookie. Return to the oven for 2 more minutes to melt the chips. Remove from baking sheets to cool on wire racks."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

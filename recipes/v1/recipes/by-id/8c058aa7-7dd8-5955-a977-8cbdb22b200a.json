  "slug": "baked-beans-i",
  "name": "Super Easy Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "This super-easy baked beans recipe makes incredible baked beans in the oven with canned beans and other savory-sweet ingredients to deepen the flavor.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine baked beans, brown sugar, ketchup, and Worcestershire sauce in a casserole dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, covered, until hot and bubbly, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,

  "id": "43aac134-3aad-518c-a277-ae50f6573767",
  "slug": "loaded-baked-beans",
  "name": "Loaded Baked Beans",
  "recipe_type": "side",
  "brief_description": "This baked beans recipe is so comforting and loaded with three types of beans, bacon, green onions, bell pepper, barbecue sauce, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large nonstick skillet over medium-high heat, turning occasionally, until crisp. Drain on paper towels. Discard all but 3 tablespoons bacon drippings from the skillet."
    },
    {
      "position": 3,
      "text": "Add onion and bell pepper to the skillet; cook until softened, about 5 minutes. Add beans, barbecue sauce, and \u00bd bacon; bring to a boil. Transfer beans to a 1 \u00bd-quart baking dish; cover dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbling, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove foil; top with Cheddar cheese and reserved \u00bd bacon. Bake until cheese is melted, about 5 minutes. Sprinkle with green onions before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

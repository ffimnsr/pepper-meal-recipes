  "id": "3e3efd4e-a707-52f2-86dc-8e3f9e1581de",
  "slug": "lemon-pie-bars",
  "name": "Lemon Pie Bars",
  "recipe_type": "dessert",
  "brief_description": "Tangy lemon filling on a buttery short bread crust. This is a really easy recipe that my mom made before the lemon bar 'rage' was on!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix 2 cups of flour and confectioner's sugar together. Cut in the butter or margarine. Mix well until the dough resembles pie dough consistency. Press the dough into a 9x13 inch baking pan."
    },
    {
      "position": 3,
      "text": "Bake 15 to 20 minutes or until golden brown."
    },
    {
      "position": 4,
      "text": "Beat together eggs, sugar, 4 tablespoons flour, lemon juice and lemon rind for at least 1 minute. Pour the mixture over the baked crust."
    },
    {
      "position": 5,
      "text": "Bake the bars another 20 minutes, or until the lemon topping has set. Sprinkle with confectioner's sugar when cooled."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

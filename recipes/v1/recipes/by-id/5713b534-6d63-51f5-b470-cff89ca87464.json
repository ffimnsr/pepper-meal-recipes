  "id": "5713b534-6d63-51f5-b470-cff89ca87464",
  "slug": "best-ever-crab-cakes",
  "name": "Best Ever Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "These crab cakes are quick and easy to make with crabmeat, crushed crackers, and lemon juice fried in butter until golden, crispy, and delicious.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk egg, mayonnaise, green onions, lemon juice, tarragon, and pepper flakes together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Gently stir in crabmeat, being careful not to break up meat."
    },
    {
      "position": 4,
      "text": "Gradually mix in cracker crumbs, adding until desired consistency is achieved."
    },
    {
      "position": 5,
      "text": "Form crab mixture into 4 patties."
    },
    {
      "position": 6,
      "text": "Heat butter in a skillet over medium heat. Cook patties in the skillet until golden brown, 5 to 6 minutes on each side."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

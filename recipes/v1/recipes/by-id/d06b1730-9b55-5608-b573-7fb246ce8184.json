  "slug": "the-perfect-sunday-brunch-spinach-salad",
  "name": "Brunch Spinach Salad",
  "recipe_type": "salad",
  "brief_description": "This brunch salad is simple to prep with baby spinach, fruit, pine nuts, and poppy seed dressing for a colorful, crowd-pleasing addition to the table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place spinach in a large bowl. Arrange bananas, strawberries, mandarin oranges, cranberries, and pine nuts on top."
    },
    {
      "position": 3,
      "text": "Toss with poppy seed dressing before serving."
    }
  ],

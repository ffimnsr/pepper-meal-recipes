  "schema_version": 1,
  "id": "c6c40baa-ec79-53e4-bcc4-68c3357d6d87",
  "slug": "awesome-chicken-noodle-soup",
  "name": "Awesome Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "Homemade stock from boiled chicken gives this soup robust flavor, along with aromatics and a bit of lemongrass too. It's good for what ails you!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken into a large stockpot and pour in water. Bring to a boil over high heat. Reduce the heat, cover, and simmer, skimming fat as needed, for 30 minutes. Add whole carrots, whole celery, onion half, lemongrass, bay leaves, and peppercorns. Cover and simmer for 1 hour; chicken should no longer be pink at the bone and the juices should run clear. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 2,
      "text": "Transfer chicken to a platter and let sit until cool enough to handle. Strain stock, discarding solids."
    },
    {
      "position": 3,
      "text": "Return strained stock to the pot and set over high heat. Stir in sliced carrots, sliced celery (not the leaves), and chicken base. Bring to a boil, then reduce the heat, cover, and simmer until carrots are tender, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, remove and discard skin from cooled chicken. Chop meat into bite-sized pieces."
    },
    {
      "position": 5,
      "text": "Add noodles and celery leaves to the pot; simmer until noodles are tender yet firm to the bite, about 10 minutes. Stir in chicken and cook until heated through, 3 to 5 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 20,

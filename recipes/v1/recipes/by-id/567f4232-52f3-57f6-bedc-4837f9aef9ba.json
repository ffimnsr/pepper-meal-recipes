  "id": "567f4232-52f3-57f6-bedc-4837f9aef9ba",
  "slug": "pumpkin-muffins-with-cinnamon-streusel-topping",
  "name": "Pumpkin Muffins with Cinnamon Streusel Topping",
  "recipe_type": "breakfast",
  "brief_description": "Pumpkin muffins with a crunchy cinnamon streusel topping are moist, light, and perfectly spiced making them a cozy breakfast or an irresistible snack!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 18-muffin cup tin."
    },
    {
      "position": 2,
      "text": "For the muffins, beat brown sugar, white sugar, and butter together in a bowl with an electric mixer until smooth and creamy. Add eggs and beat until combined. Beat in pumpkin pur\u00e9e and water."
    },
    {
      "position": 3,
      "text": "Mix flour, baking soda, salt, cinnamon, ginger, and nutmeg in a separate bowl. Stir flour mixture into pumpkin mixture. Spoon batter into the prepared muffin tin."
    },
    {
      "position": 4,
      "text": "For the streusel, mix brown sugar, flour, butter, and cinnamon together in a bowl using two forks until mixture is crumbly. Sprinkle streusel onto each muffin."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the middle of muffins comes out clean, 20 to 25 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

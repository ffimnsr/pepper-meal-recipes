  "slug": "quick-and-easy-salad-dressing",
  "name": "Quick and Easy Salad Dressing",
  "recipe_type": "salad",
  "brief_description": "This quick and easy salad dressing is whipped together in a few minutes and tastes great on all types of salad, especially bitter greens.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together olive oil, balsamic vinegar, and maple syrup in a small bowl or cup until well blended. Mix in mustard and grated garlic. Season with salt and pepper."
    }
  ],
  "servings": 4,

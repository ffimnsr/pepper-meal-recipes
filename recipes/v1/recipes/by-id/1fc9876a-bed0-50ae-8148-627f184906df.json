  "id": "1fc9876a-bed0-50ae-8148-627f184906df",
  "slug": "pizza-dough-ii",
  "name": "Stephen's Pizza Dough",
  "recipe_type": "main",
  "brief_description": "This recipe uses both bread flour and whole-wheat flour to make three flavorful pizza crusts, which means you can freeze some for later use.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast and sugar in warm water in a large bowl. Let sit until creamy, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir whole wheat flour, oil, and salt into yeast mixture, then stir in 4 cups bread flour. Add remaining 1 1/2 cups bread flour, 1/2 cup at a time, stirring well after each addition. When dough pulls together, turn it out onto a lightly floured surface and knead until smooth and elastic, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Lightly oil a large mixing bowl. Place dough into the bowl and turn to coat with oil. Cover with a damp cloth and let rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 4,
      "text": "Punch down dough and turn it out onto a lightly floured surface. Divide into thirds and form each piece into a round. Cover and let rest for 10 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

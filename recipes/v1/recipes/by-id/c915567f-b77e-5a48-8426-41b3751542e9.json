  "id": "c915567f-b77e-5a48-8426-41b3751542e9",
  "slug": "crab-quiche",
  "name": "Crab Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This crab quiche features a deep-dish pie crust filled with a savory mixture of eggs, imitation crabmeat, cream, and hot sauce for a satisfying meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bake pie crust in the preheated oven until just starting to brown, about 10 minutes. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk together eggs, cream, salt, pepper, and hot sauce in a large bowl until well combined. Stir in crabmeat, Monterey Jack, Parmesan, and green onion."
    },
    {
      "position": 4,
      "text": "Pour crab mixture into cooled pie crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 to 30 minutes. Turn the oven off, keep the door closed, and leave quiche in the oven until firm, 20 to 30 minutes. Remove from the oven and serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

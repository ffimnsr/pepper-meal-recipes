  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d04e071e-a0a9-5e46-baf7-6e5d9b7fd392",
  "slug": "mexican-street-corn-chicken-chili-recipe-11850006",
  "name": "Mexican Street Corn Chicken Chili",
  "recipe_type": "soup",
  "brief_description": "This Mexican street corn chicken chili gets its rich, creamy texture from a blended mix of cannellini beans, salsa, and chicken bone broth. Combined with tender chicken, a flavorful Mexican street corn blend, and melted Monterey Jack, it\u2019s a comforting, protein-packed meal with a little fiesta flair.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter, salt, pepper, cumin, and chili powder in a large pot and set over low heat. Stir in diced chicken, and cook over low heat until lightly browned, about 5 minutes. Add half the jalape\u00f1o; set remaining jalape\u00f1o aside for garnish."
    },
    {
      "position": 2,
      "text": "Add beans, salsa, and broth to a high-powered blender, like a Vitamix, and blend on High for 45 seconds; stir into the pot."
    },
    {
      "position": 3,
      "text": "Add frozen corn blend to the soup, and simmer for 20 minutes, stirring occasionally, until heated through and slightly thickened."
    },
    {
      "position": 4,
      "text": "Lower heat, add crema con sal and Kewpie mayonnaise, and stir until fully melted and smooth. Stir in Monterey Jack cheese until melted. Adjust soup thickness with more broth if desired."
    },
    {
      "position": 5,
      "text": "Add a squeeze of lime juice to brighten it up. Ladle into bowls and top with cilantro, cotija cheese crumbles, jalape\u00f1o, and a sprinkle of chili powder."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

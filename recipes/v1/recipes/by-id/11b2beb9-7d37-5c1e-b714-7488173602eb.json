{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "11b2beb9-7d37-5c1e-b714-7488173602eb",
  "slug": "argentine-meat-empanadas",
  "name": "Argentine Meat Empanadas",
  "recipe_type": "appetizer",
  "brief_description": "This is my original version of the Argentinean recipe for and delicious empanadas. Any meat can be used for this recipe, just be sure to cut it up into tiny pieces.",
  "cuisine": "Argentine South American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread ground beef into a large sieve. Slowly pour boiling water over top for partial cooking. Let drain and cool."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt shortening in a skillet over medium heat. Add onions; cook and stir until just before they begin to turn golden, 12 to 15 minutes. Remove from the heat and stir in sweet paprika, hot paprika, and red pepper flakes; season with salt."
    },
    {
      "position": 3,
      "text": "Transfer cooled beef to a bowl. Mix in vinegar and cumin and season with salt. Mix in onions until well combined. Transfer to a large plate to cool and harden, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Cut puff pastry dough into 10 circles. Place a spoonful meat mixture onto each round, making sure at least 1/2 inch of the outer pastry edge stays clean and dry. Add olives, raisins, and hard-cooked eggs to each round. Slightly wet the edges of pastry rounds, fold in half into half-moons, and press the edges together. Seal empanadas by twisting and curling dough together between your thumb and index finger, adding pressure before releasing each pinch and moving on to the next one."
    },
    {
      "position": 6,
      "text": "Place empanadas onto the prepared baking sheet. Prick each empanada with a fork near the curled edge to allow steam to escape during baking. Brush empanadas with beaten egg."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden, 20 to 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

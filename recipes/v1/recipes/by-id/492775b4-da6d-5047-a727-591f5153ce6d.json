  "id": "492775b4-da6d-5047-a727-591f5153ce6d",
  "slug": "homemade-chicken-noodle-soup",
  "name": "Homemade Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This homemade chicken noodle soup gains rich flavor from saut\u00e9ed chicken and garlic and is quick and easy to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a large saucepan over medium heat. Cook and stir chicken in hot oil until browned and no longer pink in the center, about 10 minutes. Transfer to a plate and set aside."
    },
    {
      "position": 3,
      "text": "Add remaining 1 tablespoon oil to the saucepan. Saut\u00e9 celery, carrots, and garlic in hot oil over medium heat until soft, 5 to 7 minutes. Season with pepper."
    },
    {
      "position": 4,
      "text": "Pour chicken broth into the saucepan and deglaze by scraping up the bits of chicken and vegetables from the bottom of the hot pan. Bring to a boil. Add egg noodles, reduce heat to medium-low, and simmer until noodles are tender yet firm to the bite, 6 to 8 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Ladle soup into bowls and lay chicken on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

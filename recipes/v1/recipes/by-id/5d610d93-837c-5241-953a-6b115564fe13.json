  "id": "5d610d93-837c-5241-953a-6b115564fe13",
  "slug": "quick-and-easy-refried-beans",
  "name": "Quick and Easy Refried Beans",
  "recipe_type": "side",
  "brief_description": "These refried beans are made with pinto beans, garlic, spices, and lime in just 20 minutes. A perfect recipe for Taco Tuesdays or any weeknight!",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat canola oil in a heavy skillet over medium heat."
    },
    {
      "position": 3,
      "text": "Cook garlic cloves in hot oil, turning once, until brown on both sides, 4 to 5 minutes. Smash garlic cloves in the skillet with a fork."
    },
    {
      "position": 4,
      "text": "Stir pinto beans, cumin, chili powder, and salt into mashed garlic and cook until beans are thoroughly heated, about 5 minutes. Stir occasionally."
    },
    {
      "position": 5,
      "text": "Smash bean mixture with a potato masher to desired texture. Squeeze lime juice over smashed beans and stir until combined."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "49b75d0b-05cc-5ba1-8131-ffc2011aed7d",
  "slug": "shortcut-chicken-manicotti",
  "name": "Shortcut Chicken Manicotti",
  "recipe_type": "soup",
  "brief_description": "Manicotti stuffed with chicken, spinach and cottage cheese and baked in a sauce made of cream of chicken soup and sour cream flavored with Italian seasoning.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium skillet over medium heat, cook chicken until opaque and juices run clear."
    },
    {
      "position": 3,
      "text": "In a medium bowl, combine cooked chicken, egg, spinach, cottage cheese and Parmesan. Stuff uncooked manicotti shells with chicken mixture. Arrange shells, not touching one another, in a 9x13 inch baking dish."
    },
    {
      "position": 4,
      "text": "In a medium bowl, combine soup, sour cream, milk and Italian seasoning and stir until smooth. Pour over shells in dish and spread to cover completely. Carefully pour boiling water around the edge of the dish. Cover tightly with foil."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven 60 minutes, or until pasta is tender. Sprinkle with Cheddar and parsley and let stand 10 minutes before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

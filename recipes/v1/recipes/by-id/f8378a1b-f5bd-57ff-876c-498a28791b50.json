  "id": "f8378a1b-f5bd-57ff-876c-498a28791b50",
  "slug": "bacon-wrapped-cherries",
  "name": "Bacon-Wrapped Cherries",
  "recipe_type": "appetizer",
  "brief_description": "Broiled cherries wrapped in bacon are quick and easy enough to impress unexpected guests and tasty enough that they might not leave \u2014 make extra!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set the oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Wrap each cherry with a bacon half, secure with a toothpick, and arrange on a baking sheet. Drizzle reserved cherry juice over wrapped cherries."
    },
    {
      "position": 3,
      "text": "Broil in the preheated oven until bacon is crisped to your liking, 3 to 10 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 5,

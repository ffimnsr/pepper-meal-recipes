  "id": "23a4487b-f4df-52cd-994d-00a77c1e3153",
  "slug": "slow-cooker-chicken-vegetable-soup-with-egg-noodles",
  "name": "Slow Cooker Chicken Vegetable Soup with Egg Noodles",
  "recipe_type": "soup",
  "brief_description": "This flavorful and low-fat chicken noodle soup is prepared in the slow cooker with carrots, onion, green pepper, and tomatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a skillet with cooking spray and heat over medium heat. Add chicken to skillet and cook, stirring frequently, about 4 minutes. Add onion and cook until chicken is browned and onion is slightly translucent, about 3 more minutes. Transfer to the slow cooker."
    },
    {
      "position": 2,
      "text": "Add carrots, celery, bell pepper, thyme, and pepper to the slow cooker; mix to combine. Stir in diced tomatoes and enough chicken broth so vegetables are just covered with liquid."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 7 hours."
    },
    {
      "position": 4,
      "text": "While the soup is cooking, fill a large pot with lightly salted water and bring to a rolling boil. Stir in egg noodles and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, 6 to 8 minutes. Drain and set aside."
    },
    {
      "position": 5,
      "text": "When soup has finished cooking, stir in cooked egg noodles. Cover and cook until noodles are warm and tender, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 435,
  "preparation_time_minutes": 30,

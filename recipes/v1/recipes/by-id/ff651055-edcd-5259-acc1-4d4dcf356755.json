  "id": "ff651055-edcd-5259-acc1-4d4dcf356755",
  "slug": "spicy-chinese-barbeque-riblets",
  "name": "Spicy Chinese Barbeque Riblets",
  "recipe_type": "dessert",
  "brief_description": "This recipe for spicy Chinese pork barbecue riblets uses a sweet and spicy glazing sauce that tastes good on chicken and wings.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine hoisin sauce, sugar, soy sauce, tomato paste, white wine, garlic, and hot sauce in large bowl; mix well."
    },
    {
      "position": 3,
      "text": "Place riblets in a large roasting pan. Bake in the preheated oven, uncovered, for 45 minutes. Pour sauce over riblets; toss to coat. Continue baking until riblets are tender and sauce has thickened, stirring often, about 45 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,

  "id": "33223b39-243a-523e-86d3-a27945fb6f2a",
  "slug": "game-day-mini-tacos-recipe-12014095",
  "name": "Game Day Mini Tacos",
  "recipe_type": "appetizer",
  "brief_description": "This Game Day Mini Tacos recipe packs plenty of classic taco flavor into a fun, bite-sized package. Mini street tortillas are filled with seasoned taco meat and topped with crowd-friendly favorites like sour cream, jalape\u00f1os, and Mexican cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a large rimmed baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat oil in a large nonstick skillet over medium-high. Add beef and cook, stirring and breaking up beef into smaller pieces with a wooden spoon, until cooked through, about 5 minutes. Drain excess fat, and stir in the taco seasoning and water. Bring to a simmer over medium-high. Cook, stirring occasionally, until thickened, about 4 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Working with one tortilla at a time, lay the mini tortilla flat on your work surface. Place a spoonful of seasoned meat (about 2 1/2 tablespoons) and a pinch of cheese, if desired (about 2 teaspoons) right down the center of tortilla. Fold in half to form a taco shape. Position taco against one short edge of prepared baking sheet, using a heavy object like a glass measuring cup to prop it upright. Continue filling tortillas with meat and cheese, lining them up to create a single long row in center of baking sheet. As you finish the row, the tacos will support each other and remain standing. Lightly spray with cooking spray."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tortillas are crisp around edges, about 12 minutes. Sprinkle the remaining 1 cup cheese right over the top of the row of tacos. Bake until cheese is melted, about 5 minutes. Serve with sliced jalape\u00f1os, if desired, and sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

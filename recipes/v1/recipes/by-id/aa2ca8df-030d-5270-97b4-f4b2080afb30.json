  "schema_version": 1,
  "id": "aa2ca8df-030d-5270-97b4-f4b2080afb30",
  "slug": "cornbread-dressing-with-gravy",
  "name": "Cornbread Dressing With Gravy",
  "recipe_type": "side",
  "brief_description": "A big, tasty baked casserole of cornbread, stuffing, and chicken with a thick gravy for the dressing. Technically a side dish, but really a meal in itself.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 375 degrees F (190 degrees C). Spray a large roasting pan with nonstick spray and place in the preheating oven until hot, 7 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, prepare dressing: Combine cornbread mix and water in a mixing bowl; stir until smooth."
    },
    {
      "position": 3,
      "text": "Remove the hot pan from the oven and pour in the cornbread batter. Return to the oven and bake until golden brown, 17 to 21 minutes. Remove from the oven and let sit until cool enough to handle, 10 to 15 minutes; keep the oven on."
    },
    {
      "position": 4,
      "text": "Crumble cooled cornbread into a large bowl. Stir in stuffing mix, onion, and celery. Add chicken and both condensed soups, then stir in as much chicken broth as needed to moisten the dry ingredients. Stir in eggs and melted butter; season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Grease the roasting pan used for the cornbread with more nonstick spray, if needed. Lightly pack dressing mixture into the pan."
    },
    {
      "position": 6,
      "text": "Bake until the top is golden brown, 45 minutes to 1 hour."
    },
    {
      "position": 7,
      "text": "While the dressing is baking, make gravy: Combine chicken, onion, celery, and hard-cooked eggs in a large saucepan. Add container of chicken broth and simmer over medium-low heat, stirring occasionally, until vegetables are tender and broth has reduced slightly, about 45 minutes."
    },
    {
      "position": 8,
      "text": "Mix cornstarch with water in a small bowl; stir into the gravy and simmer, stirring occasionally, until thickened, about 5 minutes."
    },
    {
      "position": 9,
      "text": "Remove dressing from the oven and serve with hot gravy."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 70,

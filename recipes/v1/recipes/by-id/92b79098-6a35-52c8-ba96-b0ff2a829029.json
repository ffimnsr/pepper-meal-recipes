  "id": "92b79098-6a35-52c8-ba96-b0ff2a829029",
  "slug": "caramelized-french-toast",
  "name": "Caramelized French Toast",
  "recipe_type": "breakfast",
  "brief_description": "My family loves it when I make this variation of French toast that my grandma once made for me. It's a GREAT substitute for sticky cinnamon rolls and a lot less hassle ... ENJOY!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt two tablespoons of butter in a frying pan or skillet over medium high heat."
    },
    {
      "position": 2,
      "text": "Beat together eggs, milk and salt. Dip bread one at a time into egg mixture and fry until light brown and egg is cooked."
    },
    {
      "position": 3,
      "text": "After 4 slices of bread have been cooked, melt remaining 2 tablespoons butter. Cook remaining bread slices until light brown on both sides and egg is cooked."
    },
    {
      "position": 4,
      "text": "After all bread slices have been cooked and removed from pan, add brown sugar to pan. Stir until melted and sticky. Add water and stir. Place French toast in caramel sauce. Turn to coat, then remove from pan. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

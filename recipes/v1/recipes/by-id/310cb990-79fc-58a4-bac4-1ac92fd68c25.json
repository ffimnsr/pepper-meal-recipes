  "id": "310cb990-79fc-58a4-bac4-1ac92fd68c25",
  "slug": "simple-slow-cooked-korean-beef-soft-tacos",
  "name": "Simple Slow-Cooked Korean Beef Soft Tacos",
  "recipe_type": "dessert",
  "brief_description": "This Korean taco recipe features shredded beef chuck cooked in the slow cooker with a sweet, savory, zesty mixture of brown sugar, soy sauce, and jalape\u00f1o.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place chuck roast into a slow cooker with onion, brown sugar, soy sauce, garlic, jalape\u00f1o pepper, ginger, rice vinegar, sesame oil, salt, and pepper. Cover and cook until meat is tender and can easily be pulled apart with a fork, on Low for 10 hours or High for 8 hours."
    },
    {
      "position": 2,
      "text": "Transfer roast to a cutting board and shred meat with two forks. Return to the slow cooker and mix with the juices."
    },
    {
      "position": 3,
      "text": "Serve with corn tortillas."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "f6a3d798-b89f-55e0-9fc4-1b4b34fb528c",
  "slug": "blueberry-cheesecake-ice-cream",
  "name": "Blueberry Cheesecake Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This blueberry cheesecake ice cream recipe is made with homemade blueberry sauce, vanilla ice cream, and a graham cracker crust for the perfect treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine \u00bd cup sugar and cornstarch in a small saucepan; stir in water until smooth. Add blueberries and lemon juice; bring to a boil. Reduce heat to low and simmer, uncovered, until slightly thickened, about 5 minutes. Cover and refrigerate blueberry syrup until chilled, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine graham cracker crumbs, 2 tablespoons sugar, and cinnamon in a large bowl; stir in melted butter. Pat into an ungreased 10x15-inch baking sheet."
    },
    {
      "position": 4,
      "text": "Bake graham cracker crust mixture in the preheated oven until lightly browned, 10 to 15 minutes. Cool completely on a wire rack, then crumble."
    },
    {
      "position": 5,
      "text": "Whisk cream, milk, remaining 1 \u00bd cups sugar, pudding mix, and vanilla extract in a large bowl. Transfer mixture, in batches, to an ice cream maker; freeze according to the manufacturer's directions. Refrigerate remaining cream mixture; whisk before churning."
    },
    {
      "position": 6,
      "text": "Layer ice cream, graham cracker mixture, and blueberry sauce in a large bowl; swirl to combine. Freeze until ready to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "baked-beans-texas-ranger",
  "name": "Baked Beans, Texas Ranger",
  "recipe_type": "side",
  "brief_description": "Want to wow everyone at the bar-b-que? Then this is the recipe. This is one of my most requested recipes!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a Dutch oven, combine the baked beans, onion, bell pepper, and sausage. Season with chili powder, Worcestershire sauce, vinegar, brown sugar, ketchup, garlic powder and salt. Add a dash of cayenne if desired."
    },
    {
      "position": 3,
      "text": "Cover and bake for one hour in the preheated oven."
    }
  ],
  "servings": 6,

  "id": "ad1840a9-8ecb-552c-a155-109b25b2f200",
  "slug": "indian-chaat-inspired-potato-chip-salad",
  "name": "Indian Chaat-Inspired Potato Chip Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John's Indian chaat-inspired potato chip salad is reminiscent of nachos, making it a perfect appetizer for a party.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine yogurt, lime juice, tamarind paste, garam masala, cumin, hot sauce, and sugar in a bowl with a whisk until combined. Taste and adjust as needed; mix in water as needed to reach desired consistency."
    },
    {
      "position": 3,
      "text": "Layer chips, jalapeno, bell pepper, red and green onions, potatoes, mint, cilantro, and yogurt sauce as desired for individual portions, or this can be served salad bar-style and everyone can make their own plate."
    },
    {
      "position": 4,
      "text": "Squeeze lime juice from halves over top and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

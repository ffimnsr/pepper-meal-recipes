  "id": "2b3e5108-baba-53eb-9251-e9f19194c60f",
  "slug": "german-potato-bacon-soup",
  "name": "German Potato Bacon Soup",
  "recipe_type": "soup",
  "brief_description": "Bacon, onions, and potatoes are a classic combination utilized in this soup seasoned with caraway seed and marjoram.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a stockpot over medium heat; add onions, bacon, and bay leaf. Cook and stir until onions are nearly transparent, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Pour chicken broth into the pot; add potatoes, flour, marjoram, caraway seed, salt, and pepper. Bring to a boil, reduce heat to medium-low, and simmer until potatoes are tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Stir sour cream into soup; cook another 1 to 2 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

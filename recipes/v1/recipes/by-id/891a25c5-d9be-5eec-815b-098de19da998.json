{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "891a25c5-d9be-5eec-815b-098de19da998",
  "slug": "bruschetta-chicken-pasta-salad-recipe-7546484",
  "name": "Bruschetta Chicken Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Bruschetta chicken pasta salad combines three summer favorites in a single dish\u2013marinated grilled chicken, bruschetta-style tomatoes, and pasta salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place a chicken breast on a flat work surface. Slice horizontally through the middle, being careful not to cut all the way through to the other side. Open the 2 sides and spread them out like an open book. Repeat with remaining chicken breasts. Add chicken and vinaigrette to a resealable plastic bag; seal the bag and place in the refrigerator to marinate overnight."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Discard vinaigrette, and place chicken on the grill. Grill for 4 to 5 minutes. Turn chicken breast over with tongs. Continue to cook until juices no longer run pink, and an instant-read thermometer reads 165 degrees F (74 degrees C), 4 to 5 minutes more."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook fusilli in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain pasta and immediately submerge pasta in an ice water bath."
    },
    {
      "position": 5,
      "text": "Cut tomatoes in half and place in a bowl. Add oil, minced garlic, and basil. Season to taste with salt and pepper."
    },
    {
      "position": 6,
      "text": "Drain pasta again; add to tomato mixture. Lightly toss to distribute tomatoes and combine. Top with grilled chicken breast, and drizzle with balsamic glaze."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1e9354b3-99d1-5cfa-95f7-089b0f8e3a86",
  "slug": "strawberry-shortcake-from-scratch",
  "name": "Strawberry Shortcake from Scratch",
  "recipe_type": "dessert",
  "brief_description": "This from-scratch strawberry shortcake recipe, with sweet, juicy berries, tender cakes, and whipped cream, is the perfect balance of flavors and textures.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries and \u00bc cup sugar in a bowl. Refrigerate until sugar has dissolved, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine flour, remaining \u00bc cup sugar, baking powder, and salt in a large bowl. Cut butter into 8 pieces; add to the bowl and cut into flour mixture with a pastry cutter or 2 knives until finely crumbled. Stir in milk until dough just comes together."
    },
    {
      "position": 4,
      "text": "Transfer dough to a lightly floured surface; turn to coat with flour. Fold dough in half, press down, and push forward with the heel of your hand. Turn 90 degrees. Repeat 12 times."
    },
    {
      "position": 5,
      "text": "Roll dough out to \u00bd- to \u00be-inch thickness; cut into 4-inch circles with a ring or cookie cutter. Place shortcakes on an ungreased baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes. Cool slightly."
    },
    {
      "position": 7,
      "text": "Meanwhile, beat heavy cream in a large bowl with an electric mixer until increased in volume but still soft; mix in confectioners' sugar to combine."
    },
    {
      "position": 8,
      "text": "Top each shortcake with whipped cream; spoon strawberries on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

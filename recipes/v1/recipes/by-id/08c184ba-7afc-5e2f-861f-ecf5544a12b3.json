  "id": "08c184ba-7afc-5e2f-861f-ecf5544a12b3",
  "slug": "scrambled-eggs-with-chorizo",
  "name": "Scrambled Eggs with Chorizo",
  "recipe_type": "breakfast",
  "brief_description": "This chorizo and egg recipe is a quick, easy, flavorful scramble with spicy sausage that's perfect when you're looking for a no-cheese breakfast dish.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a large nonstick skillet with cooking spray; warm over medium-high heat. Cook and stir chorizo in the hot skillet until browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Whisk together eggs and salt in a medium bowl until combined; pour over chorizo in the skillet; cook and stir until eggs are set, about 5 minutes."
    }
  ],
  "servings": 2,

  "id": "43eeb3fb-3f28-59c0-b323-6d616ea5f659",
  "slug": "quiche-florentine",
  "name": "Quiche Florentine",
  "recipe_type": "breakfast",
  "brief_description": "Stuffed with spinach and Swiss cheese, this quiche Florentine is a delicious option for a savory brunch.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Prick pie shell with a fork."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until lightly golden, 6 to 8 minutes. Remove and let cool. Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Bring a small pot of water to a boil. Add spinach and cook until heated through and dark green, about 5 minutes. Drain well and let cool."
    },
    {
      "position": 4,
      "text": "Combine Swiss cheese and flour in a bag. Seal and shake until cheese is coated."
    },
    {
      "position": 5,
      "text": "Whisk milk, eggs, salt, pepper, and nutmeg together in a large bowl. Stir in spinach and flour-coated Swiss cheese. Pour into the cooled pie shell."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until middle is set, 50 to 60 minutes. Cool slightly before slicing and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "2be1791c-43fc-5337-b506-172813a5d9eb",
  "slug": "boiled-bagels",
  "name": "Boiled Bagels",
  "recipe_type": "breakfast",
  "brief_description": "Boiled bagels make for traditional, chewy treats. This recipe gives you a batch of plain bagels that you can simply enhance with favorite flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1 \u00bd cups flour and yeast in a large bowl. Mix water, 3 tablespoons sugar, and salt together; add to dry ingredients. Beat with a mixer for half a minute at low speed, scraping the sides of the bowl clean. Beat at a higher speed for 3 minutes. Then mix in enough flour by hand to make a moderately stiff dough."
    },
    {
      "position": 2,
      "text": "Turn out onto a lightly floured surface and knead until smooth and elastic, 8 to 10 minutes. Cover and let rest for 15 minutes."
    },
    {
      "position": 3,
      "text": "Cut into 12 portions and shape into smooth balls. Poke a hole in the center with your finger, and gently enlarge the hole while working the bagel into a uniform shape. Cover and let rise for 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, start a gallon of water boiling. Add in remaining 1 tablespoon sugar and mix it around a bit. Reduce to simmering."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "When bagels have risen, put 4 or 5 bagels into the water and cook for 7 minutes, turning once. Drain."
    },
    {
      "position": 7,
      "text": "Place drained bagels on a greased baking sheet and bake in the preheated oven for 30 to 35 minutes. Remove from the oven and eat hot or cold."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,

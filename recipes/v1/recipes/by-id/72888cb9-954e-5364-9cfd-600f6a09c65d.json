  "id": "72888cb9-954e-5364-9cfd-600f6a09c65d",
  "slug": "oatmeal-scotchies-in-a-pan",
  "name": "Oatmeal Scotchies in a Pan",
  "recipe_type": "dessert",
  "brief_description": "This oatmeal Scotchies in a pan recipe makes tasty bar cookies using oatmeal and butterscotch morsels. Just press the dough into a pan, bake, and slice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Mash butter, white sugar, and brown sugar together in a large bowl until smooth; beat in eggs until a creamy mixture forms. Gradually beat in flour mixture, 1 1/2 cups butterscotch chips, and rolled oats."
    },
    {
      "position": 4,
      "text": "Press dough into the prepared baking dish; sprinkle top with remaining 1/2 cup butterscotch chips."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is golden brown, 30 to 35 minutes. Cool in the pan before cutting into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

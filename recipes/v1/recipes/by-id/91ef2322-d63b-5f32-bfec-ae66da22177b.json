  "id": "91ef2322-d63b-5f32-bfec-ae66da22177b",
  "slug": "fresh-applesauce",
  "name": "Fresh Applesauce",
  "recipe_type": "snack",
  "brief_description": "Fill your kitchen with the tempting aroma of homemade fresh applesauce as you whip up this simple recipe using apples, water, sugar, and lemon juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all the ingredients."
    },
    {
      "position": 2,
      "text": "Place apples in a large saucepan barely covered with water over medium-low heat; simmer until apples are tender, 15 to 20 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Run apples through a food mill (or pur\u00e9e in a blender); return to the saucepan. Stir in sugar and lemon juice; cook over medium heat until sugar is dissolved and sauce is thickened, 3 to 5 minutes."
    }
  ],

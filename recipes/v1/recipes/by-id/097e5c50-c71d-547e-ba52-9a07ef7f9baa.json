  "id": "097e5c50-c71d-547e-ba52-9a07ef7f9baa",
  "slug": "4-ingredient-dubai-chocolate-cake-recipe-11913837",
  "name": "4-Ingredient Dubai Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This 4-ingredient Dubai Chocolate Cake is the easiest version ever. It's a rich, moist pistachio cake, topped with whipped chocolate frosting and crunchy threads of toasted kataifi.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch cake pan."
    },
    {
      "position": 2,
      "text": "Whisk Sprite and cake mix together in a bowl until smooth. Pour cake batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until inserted toothpick comes out mostly clean, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat chocolate frosting with an electric mixer to increase volume. Toast kataifi in a skillet over medium heat until lightly golden, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Allow cake to cool completely, about 30 minutes. Frost with whipped chocolate frosting, and top with toasted kataifi."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

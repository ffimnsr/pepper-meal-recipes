  "id": "edf97d86-2eb6-58e1-b874-61f7cf7217d9",
  "slug": "make-ahead-rhubarb-yogurt-parfaits",
  "name": "Make-Ahead Rhubarb Yogurt Parfaits",
  "recipe_type": "dessert",
  "brief_description": "A quick honey-sweetened rhubarb compote is the base of this make-ahead breakfast parfait recipe laced with graham cracker crumbs and crushed walnuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rhubarb, water, and salt in a medium saucepan over medium-high heat; bring to a boil, stirring occasionally. Reduce heat to medium-low; simmer, stirring occasionally, until rhubarb has broken down, 6 to 8 minutes. Stir in honey; cook and stir until mixture has thickened, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Arrange five 12- to 16-ounce jars on a work surface. Place 2 tablespoons rhubarb mixture in the bottom of each jar; top each with 2 tablespoons graham cracker crumbs and each with \u2154 cup yogurt, in that order. Divide remaining rhubarb mixture and graham cracker crumbs among parfaits; top each with 1 tablespoon walnuts."
    },
    {
      "position": 3,
      "text": "Seal jars; refrigerate until ready to eat."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

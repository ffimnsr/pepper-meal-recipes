  "id": "e712415f-4023-53aa-b000-92461103280f",
  "slug": "homemade-dog-treats",
  "name": "Homemade Dog Treats (Tango's Treats)",
  "recipe_type": null,
  "brief_description": "Try making these healthy homemade dog treats with carrots, apples, oats, and peanut butter for your furry friends and all of their friends at the dog park.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix carrots, oats, and apple together in a large bowl. Whisk peanut butter and eggs together in a second bowl; pour into the oat mixture and stir until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Drop 1 1/2 tablespoonfuls of batter onto the prepared baking sheets. Use your hands to flatten each scoop to a thickness of 1/2 inch."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until treats are firm to the touch and begin to brown on the bottom, 15 to 20 minutes. Let cool briefly on the baking sheets before removing to a wire rack to cool completely."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

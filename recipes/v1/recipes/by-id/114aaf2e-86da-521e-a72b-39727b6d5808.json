  "id": "114aaf2e-86da-521e-a72b-39727b6d5808",
  "slug": "chicken-liver-pate-recipe-8715400",
  "name": "Chicken Liver Pate",
  "recipe_type": "appetizer",
  "brief_description": "This chicken liver pate has a silky-smooth, creamy texture, and it\u2019s perfect for spreading on toasted thin baguette slices or crackers.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Trim chicken livers of any membrane, dry on paper towels, and set aside."
    },
    {
      "position": 2,
      "text": "Melt 4 tablespoons butter in a large skillet over medium heat. Add the shallots and garlic, and saute until softened, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add chicken livers, thyme, sherry, salt, and pepper to the pan, and increase temperature to medium-high. Cook, stirring occasionally, until livers are just turning light pink in the center, 3 to 4 minutes. If you\u2019re unsure how cooked the livers are, cut one in half to check."
    },
    {
      "position": 4,
      "text": "Transfer to a food processor. Add heavy cream, remaining 4 tablespoons butter, and nutmeg, and blend until very smooth, adding a little more cream if necessary to reach a good spreading consistency."
    },
    {
      "position": 5,
      "text": "Transfer to a bowl, cover, and refrigerate until firm, at least 3 hours or overnight."
    },
    {
      "position": 6,
      "text": "Serve in ramekins or small jars, and garnish as desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

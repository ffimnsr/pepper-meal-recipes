  "schema_version": 1,
  "id": "8d7bd3e3-8663-545b-b8d7-e4e2d37d1984",
  "slug": "warm-chicken-bacon-and-egg-salad-with-mayonnaise-dressing",
  "name": "Warm Chicken, Bacon, and Egg Salad with Mayonnaise Dressing",
  "recipe_type": "salad",
  "brief_description": "A salad bowl of crisp iceberg lettuce is topped with cooked chicken, mushrooms, bacon, and gently-cooked eggs, and served warm for a nice lunch for two.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on paper towels. Chop bacon when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Bring a saucepan of water to a boil, reduce heat to medium, and gently lower eggs into the boiling water using a spoon. Boil for 8 minutes. Remove immediately from heat, drain, and cover eggs with cold water."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a skillet over medium heat; cook and stir chicken cubes, onion, and mushrooms in the hot oil until the meat is no longer pink inside and mushrooms are softened, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Place iceberg lettuce into a salad bowl. Add chicken-mushroom mixture and bacon. Top with red bell pepper, cherry tomatoes, and white Cheddar cheese. Stir mayonnaise into salad, tossing gently to coat. Peel eggs and cut each egg in half; cut halves horizontally into 3 wedges apiece. Arrange eggs on top of salad; serve warm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

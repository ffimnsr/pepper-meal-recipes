  "id": "3edebd80-e676-5295-9fbc-1b9f184cf67e",
  "slug": "garlic-parmesan-monkey-bread",
  "name": "Garlic Parmesan Monkey Bread",
  "recipe_type": "snack",
  "brief_description": "Green onions, parsley, garlic powder, butter, eggs, Parmesan cheese, and bread dough come together in this savory garlic Parmesan monkey bread recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 10-inch Bundt pan or tube pan."
    },
    {
      "position": 2,
      "text": "Combine butter, green onion, parsley, eggs, garlic powder, and salt in a medium bowl until well blended. Break bread dough into walnut-sized pieces; dip into egg mixture."
    },
    {
      "position": 3,
      "text": "Place 1 layer egg-dipped dough pieces into the prepared pan until bottom is covered; sprinkle with Parmesan cheese. Repeat dipping, layering, and sprinkling until all dough pieces and Parmesan are in the pan. Loosely cover the pan; let rise until doubled in volume, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

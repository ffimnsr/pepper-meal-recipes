  "id": "be2ab508-d27e-56b0-b8c2-249a3a9128ee",
  "slug": "orange-marmalade-cake",
  "name": "Orange Marmalade Cake",
  "recipe_type": "dessert",
  "brief_description": "A spicy, fragrant Bundt cake with a hint of orange. This orange marmalade cake is delicious served with a hot cup of tea. When other types of jam are added in place of the marmalade, it's then called a jam cake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking powder, cinnamon, salt, cloves, and nutmeg in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Stir together eggs, melted butter, sugar, milk, and lemon juice in a large mixing bowl. Add flour mixture to egg mixture; mix until well blended. Stir in walnuts and marmalade until combined. Pour batter into the prepared Bundt pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cake springs back when lightly touched, 45 to 60 minutes. Cool for 10 minutes in the pan before inverting onto a wire rack to cool completely."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

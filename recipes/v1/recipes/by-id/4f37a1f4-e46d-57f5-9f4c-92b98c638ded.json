  "id": "4f37a1f4-e46d-57f5-9f4c-92b98c638ded",
  "slug": "gluten-free-carbonara",
  "name": "Gluten Free Carbonara",
  "recipe_type": "main",
  "brief_description": "This gluten-free carbonara is a take on a classic Italian pasta dish and serves as an easy, delicious gluten-free dinner! Try this scrumptious carbonara recipe with gluten-free spaghetti flavored with crispy bacon, asparagus, and Parmesan cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Cook pasta according to package directions. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, saut\u00e9 onion, bacon, and oil in a skillet over medium-high heat until bacon is rendered and onions are translucent, about 5 minutes. Add asparagus; saut\u00e9 for 3 to 4 minutes, then season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Mix yolks with cheese in a bowl. Season with salt and pepper; set aside."
    },
    {
      "position": 4,
      "text": "Toss pasta with bacon and asparagus mixture in the skillet until warmed through. Remove the skillet from heat."
    },
    {
      "position": 5,
      "text": "Fold yolk mixture into pasta; stir vigorously until yolks thicken and coat spaghetti. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

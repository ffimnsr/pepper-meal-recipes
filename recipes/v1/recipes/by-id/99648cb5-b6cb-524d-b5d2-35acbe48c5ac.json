  "id": "99648cb5-b6cb-524d-b5d2-35acbe48c5ac",
  "slug": "tex-mex-ground-beef-and-potato-skillet-recipe-8738717",
  "name": "Tex-Mex Ground Beef and Potato Skillet",
  "recipe_type": "main",
  "brief_description": "This loaded Tex-Mex ground beef and potato skillet uses convenient frozen hash browns and corn, fresh zucchini, and RO-TEL diced tomatoes with green chiles for a tasty one-dish meal. Serve with tortilla chips, or warm, buttered flour tortillas.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium heat. Cook and stir ground beef, breaking up the pieces as it cooks, until browned and crumbly. 3 to 5 minutes. Drain off excess fat."
    },
    {
      "position": 2,
      "text": "Add potatoes, corn, zucchini, beef broth, RO-TEL, taco seasoning, and cumin. Season with salt and pepper. Bring to a boil, cover, reduce heat, and simmer until vegetables are tender, 20 to 25 minutes. Taste and adjust seasonings."
    },
    {
      "position": 3,
      "text": "Stir in Cheddar, and allow to melt. Remove from heat. Garnish with dollops of sour cream and sliced green onions, and serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9038235d-b109-53d8-908a-981f1639be93",
  "slug": "florentine-artichoke-dip",
  "name": "Florentine Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Parmesan cheese bubbles on the surface of this rich chafing-dish dipper that gets its tang from marinated artichokes. Three cloves of garlic punch up the flavor of this favorite appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 7x11-inch baking dish."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together cream cheese and mayonnaise until smooth. Mix in artichoke hearts, spinach, and Parmesan cheese. Season with garlic and lemon juice. Spread evenly into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake covered for 20 minutes. Remove the cover, and let the dish bake uncovered for 5 more minutes or until the surface is lightly browned."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a9fc9bed-17ca-5b9f-81e8-c345a9dff4f5",
  "slug": "amaretto-shortbread-cookie",
  "name": "Amaretto Shortbread Cookie",
  "recipe_type": "dessert",
  "brief_description": "This is a classic Christmas almond shortbread cookie flavored with almond-flavored liqueur for an extra festive touch. You might need to hide them from your family!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter, sugar, orange zest, amaretto, vanilla extract, and salt in a large bowl; beat using an electric mixer until smooth and creamy. With mixer on low speed, add flour and mix until a dough starts to form. Mix in almonds using a spatula. Form dough into a log and freeze for 40 minutes, then place in the refrigerator for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Shape dough into small balls and flatten slightly. Place balls 1-inch apart on an ungreased baking sheet. Bake until edges are golden, about 12 minutes."
    },
    {
      "position": 4,
      "text": "Cool on the baking sheet for 10 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

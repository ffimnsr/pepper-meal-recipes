  "id": "37400b39-2b10-58d7-b9bb-c9c7b51230ca",
  "slug": "cherry-galettes-recipe-11998105",
  "name": "Mini Cherry Galettes",
  "recipe_type": "dessert",
  "brief_description": "These cherry galettes prove dessert can be as easy as pie. With sweet cherries tucked into flaky pastry and baked until golden brown, they deliver all the flavor of homemade pie with less work. Just don\u2019t forget the vanilla ice cream!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cherries, brown sugar, lemon juice, and cornstarch in a mixing bowl. Stir until combined. Set aside to macerate."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a sheet pan with parchment."
    },
    {
      "position": 3,
      "text": "Roll the pie dough out on a lightly floured work surface to about 1/8-inch thick. Use a 6-inch bowl or round cutter to cut out 4 circles of dough."
    },
    {
      "position": 4,
      "text": "Place dough circles on the prepared pan. Scoop about 1/3 cup of the cherry mixture onto the center of each, then fold the sides of the dough up and over the filling to make a 1/2-inch border."
    },
    {
      "position": 5,
      "text": "Whisk egg and milk together in a small bowl for egg wash; brush pie dough with egg wash and sprinkle with coarse sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 28 to 32 minutes, or until golden brown. Remove and let cool for 5 minutes."
    },
    {
      "position": 7,
      "text": "Serve warm with a scoop of vanilla ice cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

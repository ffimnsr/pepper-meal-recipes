  "schema_version": 1,
  "id": "1a09a499-ca23-5162-8e1a-fdba0b766a5c",
  "slug": "stuffed-jalapeno-sliders",
  "name": "Stuffed Jalapeno Sliders",
  "recipe_type": "appetizer",
  "brief_description": "Jalapenos stuffed with ground beef and Mexican cheese are sandwiched between mini homemade burger buns in this recipe for bold sliders.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium heat. Add onion; cook and stir until soft, about 5 minutes. Add beef; cook, stirring to break into very small pieces, until browned, about 5 minutes. Drain any excess grease. Stir in 2 tablespoons water and taco seasoning; cook until water evaporates, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Let beef mixture cool completely, about 10 minutes. Stir in Chihuahua cheese."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Cut tops off jalapeno peppers and scoop out seeds and ribs. Stuff with beef mixture, using the thick end of a chopstick to pack in mixture. Stack upright against the edge of a casserole dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until jalapeno peppers are soft, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Refrigerate jalapeno peppers until stuffing firms up, 1 to 2 hours."
    },
    {
      "position": 7,
      "text": "Combine 1/4 cup water, sugar, and yeast in a small bowl. Let stand until foamy, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Combine flour, 1 egg, milk, and butter in a large bowl. Pour in yeast mixture; mix until well combined. Turn dough onto a lightly floured surface and knead until mostly smooth but slightly sticky, about 5 minutes."
    },
    {
      "position": 9,
      "text": "Form dough into a ball and place in a lightly greased bowl. Cover with a towel and let rise, about 20 minutes."
    },
    {
      "position": 10,
      "text": "Line a baking sheet with parchment paper. Turn dough out onto a floured surface; push down to knock out air. Form into 1-inch buns and arrange 1 inch apart on the baking sheet. Cover with the towel and let rise until puffy, about 1 hour."
    },
    {
      "position": 11,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Brush tops of buns with beaten egg."
    },
    {
      "position": 12,
      "text": "Bake buns in the preheated oven until tops are golden brown, 6 to 7 minutes. Transfer to a cooling rack and let cool, about 10 minutes."
    },
    {
      "position": 13,
      "text": "Reduce oven temperature to 200 degrees F (95 degrees C)."
    },
    {
      "position": 14,
      "text": "Slice cold jalapeno peppers into 1/4-inch thick rings. Cut buns in half. Sandwich jalapeno pepper rings in the buns and secure with a toothpick. Arrange sliders in a casserole dish. Cover with aluminum foil."
    },
    {
      "position": 15,
      "text": "Bake sliders in the preheated oven until warmed through, about 10 minutes."
    }
  ],

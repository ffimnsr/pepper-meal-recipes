  "schema_version": 1,
  "id": "e4007773-1d76-5fad-9c91-1b98168bcf5c",
  "slug": "boudin-balls",
  "name": "Boudin Balls",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's recipe for fried boudin balls has a crispy outside and tender inside filled with meat, rice, and savory flavors. They're sure to be a hit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Stir pork shoulder, livers, onion, celery, poblano pepper, jalape\u00f1o pepper, garlic, salt, 1 1/2 tablespoons ground black pepper, chili powder, and 1 teaspoon cayenne pepper together in a large pot. Cover the pot with a lid and refrigerate until flavors combine, 2 hours to overnight."
    },
    {
      "position": 3,
      "text": "Pour enough water into the pork mixture to cover by 2 inches; bring to a boil, reduce heat to low, and simmer until meat is tender, about 1 1/2 hours. Remove from heat. Pour mixture through a strainer, reserving strained liquid and meat separately."
    },
    {
      "position": 4,
      "text": "Transfer drained meat mixture to a cutting board and finely chop."
    },
    {
      "position": 5,
      "text": "Stir chopped meat, rice, parsley, and green onion together in a bowl. Gradually add reserved cooking liquid, one ladleful at a time, to meat mixture, stirring until completely incorporated between each addition, until mixture has a paste-like consistency. Cover the bowl with plastic wrap and refrigerate until chilled, at least 2 hours to overnight."
    },
    {
      "position": 6,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Roll chilled meat mixture into 1-inch balls."
    },
    {
      "position": 7,
      "text": "Make a breading station: Whisk flour, 1 pinch cayenne pepper, salt, and black pepper together in a shallow bowl. Pour breadcrumbs into another shallow bowl. Beat eggs in another shallow bowl."
    },
    {
      "position": 8,
      "text": "Gently press a ball into flour mixture to coat; shake off the excess flour. Dip ball into beaten egg; press ball into bread crumbs. Place breaded ball onto a plate and repeat breading process with remaining balls."
    },
    {
      "position": 9,
      "text": "Working in batches, cook boudin balls in preheated oil, turning once, until crispy on the outside and hot on the inside, 3 to 4 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 45,

  "id": "24f0e749-3394-514d-aa79-7be51a4bd1ac",
  "slug": "creamy-chicken-tostadas",
  "name": "Creamy Chicken Tostadas",
  "recipe_type": "soup",
  "brief_description": "These tasty tostadas feature a combination of cooked chicken, onion, peppers, corn, black beans and creamy poblano and queso soup. Topped with fresh cilantro and a delicious avocado mixture, you won't be able to resist the incredible flavor!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oil in a 12-inch skillet over medium heat. Add the onion and peppers and cook for 5 minutes or until the vegetables are tender-crisp, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Add the corn, beans and chicken to the skillet and cook until the mixture is hot. Stir in the soup and milk and heat to a boil. Reduce the heat to low. Cook for 5 minutes."
    },
    {
      "position": 3,
      "text": "Squeeze 1 teaspoon juice from the lime. Place the avocado into a medium bowl. Add the lime juice and toss to coat."
    },
    {
      "position": 4,
      "text": "Divide the chicken mixture among the tostada shells. Top with the avocado mixture and cilantro. Season with hot pepper sauce, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0755412e-aeba-5c5a-a85c-7b8646333fbd",
  "slug": "peach-and-raspberry-crumble",
  "name": "Peach and Raspberry Crumble",
  "recipe_type": "dessert",
  "brief_description": "This peach and raspberry crumble recipe with a touch of cinnamon is topped with a sweet and crispy oat crumble for a fruity dessert to enjoy all summer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine peaches, raspberries, \u00bd cup white sugar, lemon juice, and \u00bd tablespoon cinnamon in a bowl."
    },
    {
      "position": 3,
      "text": "Combine oats, flour, butter, remaining \u00bc cup white sugar, brown sugar, remaining \u00bd tablespoon cinnamon, and salt in a separate bowl until thoroughly smooth and not lumpy."
    },
    {
      "position": 4,
      "text": "Pour peach-raspberry mixture into a large ceramic baking dish, spreading evenly; top evenly with oat crumble mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 35 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

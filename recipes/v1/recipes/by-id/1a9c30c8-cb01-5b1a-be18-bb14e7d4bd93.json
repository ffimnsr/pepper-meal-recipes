  "id": "1a9c30c8-cb01-5b1a-be18-bb14e7d4bd93",
  "slug": "chai-snickerdoodle-cookies",
  "name": "Chai Snickerdoodle Cookies",
  "recipe_type": "dessert",
  "brief_description": "Delight your family and friends by making this quick and easy recipe for scrumptious chai snickerdoodle cookies flavored with cinnamon and sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat 1 \u00be cups sugar, butter, eggs, and chai concentrate together in a bowl until light and fluffy. Whisk flour, baking soda, and salt together in another bowl; stir into butter mixture until dough is combined."
    },
    {
      "position": 3,
      "text": "Whisk 3 tablespoons sugar and cinnamon together in a small bowl."
    },
    {
      "position": 4,
      "text": "Form dough into 1-inch balls; roll each ball in cinnamon sugar to coat and place 2 inches apart on baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, about 10 minutes. Cool on wire racks."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

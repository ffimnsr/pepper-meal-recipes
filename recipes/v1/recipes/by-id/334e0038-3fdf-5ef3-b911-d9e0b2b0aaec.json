  "slug": "cucumber-salad-with-avocado-corn-and-feta-recipe-11958219",
  "name": "Cucumber Salad with Avocado, Corn, and Feta",
  "recipe_type": "salad",
  "brief_description": "This cucumber salad with avocado, corn, and feta is a delicious, low-effort, fresh salad with a vibrant lime vinaigrette. It\u2019s crunchy, colorful, creamy, and refreshing\u2014the perfect summer side salad in just minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk lime juice, olive oil, vinegar, garlic, salt, and pepper in a small bowl, and set aside."
    },
    {
      "position": 2,
      "text": "Combine cucumbers, onion, dill, and corn in a large bowl. Carefully fold in avocados and feta. Drizzle the dressing over the salad, toss gently to coat, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

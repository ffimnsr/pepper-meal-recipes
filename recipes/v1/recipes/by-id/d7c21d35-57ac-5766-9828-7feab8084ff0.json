  "id": "d7c21d35-57ac-5766-9828-7feab8084ff0",
  "slug": "air-fryer-chicken-tenders-recipe-11714303",
  "name": "These 4-Ingredient Chicken Tenders Are Weeknight Dinner Gold",
  "recipe_type": "appetizer",
  "brief_description": "Air fryer cooked chicken tenders are quick and easy to make and will surely become a family favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C). Coat basket with cooking spray."
    },
    {
      "position": 3,
      "text": "Whisk egg in a small bowl. In another bowl, stir together panko and oil until loose and crumbly."
    },
    {
      "position": 4,
      "text": "Dip each chicken tender into egg, allowing excess to drip off. Dip chicken in panko mixture to coat completely. Working in batches if needed."
    },
    {
      "position": 5,
      "text": "Arrange chicken in an even layer in the air fryer basket. Cook until chicken is no longer pink in the center and the juices run clear, about 12 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Serve hot garnished with freshly chopped parsley. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

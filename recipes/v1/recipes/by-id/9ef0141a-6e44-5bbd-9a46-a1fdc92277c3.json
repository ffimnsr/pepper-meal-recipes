  "id": "9ef0141a-6e44-5bbd-9a46-a1fdc92277c3",
  "slug": "easy-pumpkin-spice-muffins",
  "name": "Easy Pumpkin Spice Muffins",
  "recipe_type": "dessert",
  "brief_description": "These rich, moist, and spiced muffins require only a box of spice cake mix, a can of pumpkin purée, and cinnamon chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 18 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Mix spice cake mix, pumpkin purée, and cinnamon chips together in a bowl until cake mix is completely moistened; add nuts and stir. Spoon the batter into prepared muffin cups to about 2/3 full."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

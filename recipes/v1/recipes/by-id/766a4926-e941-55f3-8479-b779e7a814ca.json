  "id": "766a4926-e941-55f3-8479-b779e7a814ca",
  "slug": "self-filled-cupcakes-i",
  "name": "Cream Cheese-Filled Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "This recipe for cream cheese-filled cupcakes features chocolate cake mix and a mixture of cream cheese and chocolate chips for a new twist on plain chocolate cupcakes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C) or the temperature recommended on the cake mix package. Line a 12-cup muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Cream together cream cheese and sugar in a mixing bowl until smooth. Beat in egg until well blended, then stir in chocolate chips."
    },
    {
      "position": 3,
      "text": "Prepare chocolate cake mix according to package directions, but do not bake."
    },
    {
      "position": 4,
      "text": "Fill the prepared muffin cups 2/3 full with chocolate cake batter. Add 1 teaspoon cream cheese mixture to the center, then top with more chocolate cake batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven according to package directions for cupcakes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

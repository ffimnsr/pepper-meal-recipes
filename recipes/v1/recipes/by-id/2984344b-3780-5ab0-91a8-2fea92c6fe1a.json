  "id": "2984344b-3780-5ab0-91a8-2fea92c6fe1a",
  "slug": "weeknight-skillet-slaw",
  "name": "Weeknight Skillet Slaw",
  "recipe_type": "salad",
  "brief_description": "This colorful slaw made with ground turkey, fresh vegetables, and a savory sauce is perfect for a quick and hearty weeknight dinner.",
  "cuisine": "American Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix chipotle hot sauce, rice vinegar, soy sauce, ginger, and agave syrup together in a small bowl to make sauce."
    },
    {
      "position": 2,
      "text": "Heat olive oil and sesame oil in a wok or large skillet over medium heat. Add ground turkey; cook, stirring to break up clumps, until juices run clear, about 6 minutes. Season with salt and pepper. Transfer to a bowl, reserving juices in the wok."
    },
    {
      "position": 3,
      "text": "Combine coleslaw mix, red bell pepper, green onions, and garlic in the wok; cook and stir over medium heat until slaw is slightly wilted, 1 to 2 minutes. Add sauce; mix to combine, about 1 minute. Return turkey to the wok and stir until heated through, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle sesame seeds over slaw before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

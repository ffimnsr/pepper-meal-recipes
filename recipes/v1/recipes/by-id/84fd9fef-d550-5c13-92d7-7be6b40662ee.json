  "id": "84fd9fef-d550-5c13-92d7-7be6b40662ee",
  "slug": "grilled-corn-salad",
  "name": "Grilled Corn Salad",
  "recipe_type": "salad",
  "brief_description": "This easy grilled corn salad is packed with roasted corn, fresh veggies, and cilantro for a colorful side dish perfect for any BBQ or summer day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Roast corn on the preheated grill, turning occasionally, until tender and specks of black appear, about 10 minutes. Remove from the grill and let sit until just cool enough to handle, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Holding a corn cob over a large bowl, use a knife to carefully slice warm kernels directly into the bowl; discard cob. Repeat with remaining corn."
    },
    {
      "position": 4,
      "text": "Add bell pepper, tomatoes, onion, cilantro, olive oil, salt, and pepper; toss until evenly mixed. Let sit until flavors have blended, at least 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

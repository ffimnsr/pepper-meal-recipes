  "id": "388eb73c-2638-5b5a-af15-37409411d6e5",
  "slug": "easy-mexican-tortilla-soup",
  "name": "Easy Mexican Tortilla Soup",
  "recipe_type": "soup",
  "brief_description": "Enjoy this traditional Mexican tortilla soup with queso fresco to soften the flavors of tomatoes, oregano, mint, and smoky pasilla chiles!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut tortillas in half and slice crosswise into 1/8-inch strips. Place in a bowl and toss with 1 tablespoon oil until fully coated. Arrange tortilla strips in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crisp and light brown, about 15 minutes. Let cool."
    },
    {
      "position": 4,
      "text": "Heat remaining oil in a saucepan over medium heat. Add pasilla chiles; cook and stir until light brown, about 4 minutes. Transfer chiles to a plate. Add onion to the saucepan; cook until translucent, about 5 minutes. Add tomatoes; cook until soft, stirring occasionally, about 10 minutes. Reduce heat to medium-low."
    },
    {
      "position": 5,
      "text": "Return chiles to the pan; add mint and oregano. Simmer until fragrant, about 3 minutes. Pour in chicken broth, increase heat to medium-high, and bring to a boil. Add chicken bouillon; reduce heat and simmer until flavors meld, about 10 minutes more. Discard mint and oregano. Garnish with the tortilla strips, avocados, and queso fresco."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "098a8f43-50e3-5c49-a0e6-c51df5c95d34",
  "slug": "chef-johns-miso-soup",
  "name": "Chef John's Miso Soup",
  "recipe_type": "soup",
  "brief_description": "This classic Japanese miso soup is made entirely from scratch including the dashi.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour cold water into a saucepan. Add kombu and soak for 30 minutes."
    },
    {
      "position": 3,
      "text": "Set pan on the stove over medium heat, and wait until water just starts to simmer. Turn off heat, and remove kombu with a strainer. Squeeze out any liquid back into the pan, and discard kombu."
    },
    {
      "position": 4,
      "text": "Turn heat back on to med-high, and bring to a simmer. Stir bonito flakes into the simmering liquid, and turn off the heat. Let sit for 10 minutes, before staining and reserving the liquid, also known as the \"dashi.\""
    },
    {
      "position": 5,
      "text": "Pour dashi into a saucepan over medium heat. Add pre-soaked, shredded seaweed, soy sauce, and green onions. Bring to a simmer, and reduce heat to low. Place a small strainer over the pan, and add miso pastes. Submerge strainer halfway down into the hot dashi, and stir slowly until all the miso has dissolved and passed through into the soup."
    },
    {
      "position": 6,
      "text": "Stir in tofu, and continue cooking on low until tofu is heated through, about 2 minutes. Taste and season with more soy sauce if needed."
    },
    {
      "position": 7,
      "text": "Serve immediately with sliced green onions on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

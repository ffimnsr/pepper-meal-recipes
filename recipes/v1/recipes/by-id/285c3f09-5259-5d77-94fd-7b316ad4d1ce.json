  "slug": "vegan-butternut-squash-and-lentil-stew-in-the-slow-cooker",
  "name": "Vegan Butternut Squash and Lentil Stew in the Slow Cooker",
  "recipe_type": "soup",
  "brief_description": "A delicious, nutritious stew that will delight vegans and meat-eaters alike. Everything goes in the slow cooker, and you'll have a delicious meal 3 hours later.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Turn a slow cooker on High."
    },
    {
      "position": 2,
      "text": "Combine butternut squash, lentils, onion, carrots, olive oil, sage, sea salt, ginger, garlic powder, and cumin in the slow cooker. Pour in water and stock. Stir gently to evenly distribute spices and vegetables."
    },
    {
      "position": 3,
      "text": "Cook on High until vegetables are cooked through and lentils are soft, 2 1/2 to 3 hours. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 20,

  "id": "abb509ca-02bd-5b79-824a-5c429819d4d1",
  "slug": "cheddar-bay-butter-swim-biscuits-recipe-11941452",
  "name": "Cheddar Bay Butter Swim Biscuits",
  "recipe_type": "side",
  "brief_description": "These Cheddar Bay butter swim biscuits are a swim biscuit version of the Red Lobster favorite, made with Red Lobster's biscuit mix. You won\u2019t need extra butter to serve with them, because they\u2019re already buttery, cheesy, and soft.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray an oven-safe glass 8x8-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together the biscuit mix (set seasoning packet aside to use for topping), flour, baking powder, and garlic powder. Fold in Cheddar, Colby Jack, bacon, and parsley. Pour buttermilk over biscuit mixture, and gently stir until a sticky dough forms."
    },
    {
      "position": 3,
      "text": "Pour melted butter into the prepared baking dish. Add biscuit mixture, right on top of the butter, and gently spread into an even layer using a spatula. If the mixture sticks to the spatula, spray a little nonstick cooking spray on your hand to help spread the dough out evenly. Score dough into 9 squares, which will help to cut the squares once baked."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are crisping and top is golden brown, and a toothpick inserted near the center comes out clean, 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "For topping, combine butter, herb seasoning, and parsley. Remove biscuit dish from the oven and while hot, generously brush butter topping over the biscuits. Cool for 10 minutes to firm up, cut into squares, and serve warm."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

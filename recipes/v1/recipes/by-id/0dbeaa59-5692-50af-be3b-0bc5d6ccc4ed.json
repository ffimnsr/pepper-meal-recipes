  "schema_version": 1,
  "id": "0dbeaa59-5692-50af-be3b-0bc5d6ccc4ed",
  "slug": "doggy-meatloaf-with-vegetables",
  "name": "Doggy Meatloaf with Vegetables",
  "recipe_type": "main",
  "brief_description": "This is a simple, easy and nutritious recipe to use as a substitute for canned dog food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a large roasting pan with oil and set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the ground beef, 3 stalks of celery, grated carrots, apple, eggs, bread, oats, wheat germ and tomato paste using your hands. Divide the meat mixture into four equal parts and make loaf shapes. Place the loaves in the roasting pan. Surround them with the potatoes, remaining carrots and remaining celery. Cover the pan with a lid."
    },
    {
      "position": 3,
      "text": "Bake for 80 minutes in the preheated oven, or until the meat is cooked through. The internal temperature should be 175 degrees F (80 degrees C) when taken with a meat thermometer. Allow to cool."
    },
    {
      "position": 4,
      "text": "Portion the food into containers with one loaf and one quarter of the vegetables in each one. Refrigerate. To serve, give your dog 1/3 of a container with each portion of kibble."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

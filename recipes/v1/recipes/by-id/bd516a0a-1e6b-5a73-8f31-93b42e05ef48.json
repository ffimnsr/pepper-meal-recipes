  "slug": "whipped-cream-cream-cheese-frosting",
  "name": "Whipped Cream Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "A whipped cream cheese frosting that is delicate but creamy, making it the perfect icing on any cake. This will be your new favorite frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat whipping cream in a mixing bowl until stiff peaks form; set aside."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, salt, and vanilla in a large bowl. Beat until smooth, then fold in whipped cream."
    }
  ],

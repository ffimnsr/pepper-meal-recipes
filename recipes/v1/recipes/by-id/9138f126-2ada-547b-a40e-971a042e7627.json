  "slug": "grilled-cajun-corn-recipe-11759894",
  "name": "Grilled Cajun Corn",
  "recipe_type": "dessert",
  "brief_description": "This grilled Cajun corn is corn at its fined - think fresh sweet corn grilled and tossed in Cajun seasoned butter. It's the perfect easy side dish for your cookout.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill to medium-high heat."
    },
    {
      "position": 2,
      "text": "Cut each ear of corn into thirds."
    },
    {
      "position": 3,
      "text": "Place corn directly on the grates of the preheated grill. Cook 15 minutes, turning every 5 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile melt butter and Old Bay in a small skillet over low heat."
    },
    {
      "position": 5,
      "text": "Transfer grilled corn to a large bowl. Drizzle seasoned butter over the top and toss to coat. Transfer to serving plate and garnish with parsley flakes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

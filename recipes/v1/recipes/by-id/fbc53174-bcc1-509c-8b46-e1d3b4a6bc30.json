  "slug": "waldorf-salad-ii",
  "name": "Waldorf Salad",
  "recipe_type": "salad",
  "brief_description": "Waldorf salad is super simple to make with chunks of crisp apple, chopped celery, walnuts, and raisins in a creamy lemon and mayonnaise dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, sugar, lemon juice, and salt together in a serving bowl."
    },
    {
      "position": 3,
      "text": "Stir in apples, celery, walnuts, and raisins. Cover and chill in the refrigerator until ready to serve."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,

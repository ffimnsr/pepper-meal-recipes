  "id": "1c3ec2cc-722b-5a9a-a899-295ac3354a9e",
  "slug": "whole-grain-waffles",
  "name": "Whole Grain Waffles",
  "recipe_type": "breakfast",
  "brief_description": "This filling waffles made with whole wheat flour, flax seed meal, and wheat germ are quite delicious. Serve with homemade blueberry syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, whisk together the eggs, milk, oil, applesauce, and vanilla. Beat in whole wheat pastry flour, flax seed meal, wheat germ, all-purpose flour, baking powder, sugar, and salt until batter is smooth."
    },
    {
      "position": 2,
      "text": "Preheat a waffle iron, and coat with cooking spray. Pour batter into waffle iron in batches, and cook until crisp and golden brown."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

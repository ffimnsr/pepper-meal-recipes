  "id": "e150e7bf-e706-5f46-8360-70f8839283eb",
  "slug": "turkey-carcass-soup",
  "name": "Turkey Carcass Soup",
  "recipe_type": "soup",
  "brief_description": "This turkey carcass soup uses every last bit of your roasted turkey. It's loaded with vegetables and barley, making it a hearty post-holiday meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place turkey carcass in a large soup pot and cover with water; bring to a boil over medium heat. Reduce heat to a simmer, and cook until the remaining meat falls off the bones, about 1 hour."
    },
    {
      "position": 2,
      "text": "Remove turkey carcass from the pot; pick off and chop any remaining turkey meat, discarding bones."
    },
    {
      "position": 3,
      "text": "Strain broth through a fine mesh strainer into a clean soup pot. Add chopped turkey to the strained broth and bring to a boil."
    },
    {
      "position": 4,
      "text": "Reduce heat and stir in tomatoes, potatoes, carrots, onion, celery, cabbage, barley, Worcestershire sauce, salt, parsley, basil, bay leaf, pepper, paprika, poultry seasoning, and thyme. Simmer until vegetables and barley are tender, about 1 more hour. Remove bay leaf before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "schema_version": 1,
  "id": "88e3b66d-06a3-532d-a1a1-69bafc1ce212",
  "slug": "crispy-fried-chicken",
  "name": "Crispy Fried Chicken",
  "recipe_type": "side",
  "brief_description": "Discover the technique for making deliciously crispy fried chicken with a crunchy coating on the outside and juicy, tender chicken inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Skin cut up chicken pieces if you prefer."
    },
    {
      "position": 2,
      "text": "Place flour in a large plastic bag (let the amount of chicken you are cooking dictate the amount of flour you use). Season flour with paprika (which helps to brown the chicken), salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Dip chicken pieces in buttermilk, then transfer, a few at a time, to the bag with flour; seal the bag and shake until well coated. Repeat with remaining chicken."
    },
    {
      "position": 4,
      "text": "Place coated chicken on a baking sheet or tray; cover with a clean dish towel or waxed paper. LET SIT UNTIL THE FLOUR IS A PASTE-LIKE CONSISTENCY. THIS IS CRUCIAL!"
    },
    {
      "position": 5,
      "text": "Fill a large skillet (cast iron is best) about \u2153 to \u00bd full with vegetable oil. Heat until VERY hot."
    },
    {
      "position": 6,
      "text": "Carefully lower as many chicken pieces into the skillet as it can hold. Fry in HOT oil on both sides until brown."
    },
    {
      "position": 7,
      "text": "When browned, reduce heat and cover skillet; cook for 30 minutes (the chicken will be cooked through but not crispy). Remove cover, raise heat again, and continue frying until crispy."
    },
    {
      "position": 8,
      "text": "Drain fried chicken on paper towels. Depending on how much chicken you have, you may have to fry in a few batches. Keep the finished chicken in a slightly warm oven while frying the rest."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,

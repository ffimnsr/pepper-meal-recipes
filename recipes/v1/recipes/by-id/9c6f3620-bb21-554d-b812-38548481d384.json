  "id": "9c6f3620-bb21-554d-b812-38548481d384",
  "slug": "cherry-pound-cake",
  "name": "Cherry Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "My grandmother always made this creamy cake for Christmas morning. It\u2019s so pretty and tastes wonderful! Now that Nana is gone, I\u2019m continuing the tradition.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour an 8 inch tube pan. Mix together the flour, baking powder, and salt; set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter, cream cheese, and sugar until light and fluffy. Beat in the eggs one at a time, then stir in the vanilla and almond extract. Beat in the flour mixture, mixing just until incorporated. Dredge cherries in 1/4 cup flour, then fold into batter. Spread into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 80 minutes, or until a toothpick inserted into the center of the cake comes out clean. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

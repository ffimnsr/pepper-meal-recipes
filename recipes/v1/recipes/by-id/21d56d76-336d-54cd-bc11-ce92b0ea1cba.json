  "id": "21d56d76-336d-54cd-bc11-ce92b0ea1cba",
  "slug": "nutty-cranberry-sauce",
  "name": "Nutty Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "Stirring nuts into a homemade cranberry sauce made with orange juice and triple sec elevates the classic Thanksgiving condiment.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Stir sugar, orange juice, triple sec, and water together in a saucepan over medium heat until the sugar dissolves; add cranberries and cook until the berries begin to pop, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Pour cranberry sauce into a serving bowl; stir nuts into the sauce. Let sauce cool until thickened, 15 to 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,

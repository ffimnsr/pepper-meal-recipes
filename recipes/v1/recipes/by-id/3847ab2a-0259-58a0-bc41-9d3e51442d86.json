  "schema_version": 1,
  "id": "3847ab2a-0259-58a0-bc41-9d3e51442d86",
  "slug": "chicken-artichoke-and-spinach-stuffed-portobellos",
  "name": "Chicken, Artichoke, and Spinach-Stuffed Portobellos",
  "recipe_type": "appetizer",
  "brief_description": "Portobello mushrooms stuffed with chicken, artichokes, and spinach are baked in a Panasonic CIO to turn an appetizer recipe into a main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, Alfredo sauce, spinach, artichoke hearts, red pepper flakes, and 4 ounces of Parmesan cheese in a large bowl. Stir to combine."
    },
    {
      "position": 2,
      "text": "Lightly rub the outside of each portobello with olive oil using your hands; season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Divide the chicken filling among the mushroom caps and top with remaining Parmesan cheese. Place mushroom caps on the grill pan of the Panasonic Countertop Induction Oven."
    },
    {
      "position": 4,
      "text": "Press \"Auto Cook\". Select Poultry with Vegetables setting and press \"Start\". Turn the dial to select 2 pounds and press \"Start\" again. Cook until chicken is no longer pink and mushrooms are tender, about 23 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 23,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "slug": "shrimp-salsa",
  "name": "Shrimp Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Shrimp, tomatoes, red onion, cilantro, and lime juice combine for a unique and refreshing chunky salsa perfect for scooping up with tortilla chips.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Stir shrimp, tomatoes, onion, cilantro, lime juice, salt, pepper, and garlic together in a large glass bowl. Cover with plastic wrap and refrigerate until the flavors combine, at least 1 hour. Serve cold."
    }
  ],
  "servings": 12,

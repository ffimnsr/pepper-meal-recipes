  "id": "2fa97a7d-771a-557c-845d-5e834b8e545d",
  "slug": "best-brioche-french-toast",
  "name": "Best Brioche French Toast",
  "recipe_type": "breakfast",
  "brief_description": "The best brioche French toast, pan-fried and then finished in the oven, topped with browned butter and maple syrup. An easy yet decadent brunch dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk milk, eggs, vanilla, sugar, nutmeg, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Heat 1 1/2 teaspoons butter in a skillet over medium heat. Working in batches, dip each slice of brioche bread in the egg mixture and cook in the hot butter until golden, 2 to 3 minutes per side, adding more butter as needed. Transfer French toast to a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until puffed, 8 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Cook and stir 1/4 cup butter in a skillet over medium-low heat until browned and toasty, 3 to 5 minutes. Transfer browned butter to a cold dish. Drizzle browned butter over baked French toast and top each slice with 1 tablespoon maple syrup."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "aa87b1c2-53ec-5ed7-894d-6e8b20517264",
  "slug": "chicken-and-spinach-ravioli",
  "name": "Chicken and Spinach Ravioli",
  "recipe_type": null,
  "brief_description": "A delicious combination of chicken and spinach make a wonderful Italian meal. Make sure to have plenty of freshly grated Asiago cheese to top these ravioli.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, mix the eggs, water, 2 cups flour, and salt. Gradually mix in the remaining flour until smooth. Divide dough into 2 parts. Cover, and set aside in the refrigerator 20 minutes."
    },
    {
      "position": 2,
      "text": "In a skillet over medium heat, cook the ground chicken until evenly brown; drain."
    },
    {
      "position": 3,
      "text": "In a food processor, mix the chicken, spinach, and onion. Transfer to a bowl, and mix with butter, 3 tablespoons Asiago cheese, salt, garlic powder, nutmeg, and pepper."
    },
    {
      "position": 4,
      "text": "On a lightly floured surface, roll out each part of the dough to 1/8 inch thickness. Cut into 2 inch squares. Place about 1 teaspoon of the chicken mixture in the center of 1/2 the squares, and top with remaining squares. Seal the edges of the squares with a moistened fork to form the ravioli."
    },
    {
      "position": 5,
      "text": "Bring a large pot of lightly salted water to a boil, and cook the ravioli in small batches for about 8 minutes, or until al dente. Drain, and rinse under cold water."
    },
    {
      "position": 6,
      "text": "Place the marinara sauce in a saucepan, and cook until heated through. Serve ravioli topped with marinara sauce and remaining Asiago cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

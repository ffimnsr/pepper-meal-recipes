  "id": "75ec022c-0315-5919-af7a-7772f4b34a4f",
  "slug": "cheesy-hashbrown-casserole",
  "name": "Sallie's Cheesy Hashbrown Casserole",
  "recipe_type": "soup",
  "brief_description": "This cheesy hashbrown casserole made with cream of chicken soup is topped with a buttery cracker topping for a warm and comforting side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a glass 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine potatoes, cream of chicken soup, Cheddar cheese, sour cream, 1/2 cup melted butter, onion, salt, and pepper together in a bowl; spread into the prepared baking pan. Mix crushed crackers and 1/2 cup melted butter together in a bowl and sprinkle over potato mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbling and browned on top, 60 to 90 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

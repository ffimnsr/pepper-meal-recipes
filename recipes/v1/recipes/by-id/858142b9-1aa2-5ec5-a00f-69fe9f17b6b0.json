  "id": "858142b9-1aa2-5ec5-a00f-69fe9f17b6b0",
  "slug": "artichoke-crab-dip",
  "name": "Artichoke Crab Dip",
  "recipe_type": "appetizer",
  "brief_description": "This hot dip is simple and wonderful! Lump crabmeat is folded into a creamy artichoke mixture. Serve with crackers or warm bread slices.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place cream cheese in a medium baking dish with 3/4 of the artichoke hearts and Old Bay Seasoning TM. Blend until smooth. Gently fold in crabmeat, taking care not to break up lumps."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven 30 minutes, or until surface is golden brown. Remove from heat and garnish with remaining artichoke hearts."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

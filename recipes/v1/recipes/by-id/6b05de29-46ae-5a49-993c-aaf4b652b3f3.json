  "id": "6b05de29-46ae-5a49-993c-aaf4b652b3f3",
  "slug": "carrot-gelatin-salad",
  "name": "Carrot Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "Old-fashioned carrot Jell-O salad made with lemon and pineapple. Grandma didn't specify the amount of carrots. You probably can't use too much!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "In a large bowl, prepare lemon gelatin according to package directions using reserved pineapple juice in place of some of the water. Refrigerate until thickened, about 1 hour."
    },
    {
      "position": 3,
      "text": "When gelatin has thickened, stir in pineapple and shredded carrot."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate until set, at least 4 hours."
    }
  ],
  "servings": 8,

  "id": "5e6eb7fb-87d2-591d-96a2-02ad2187ae20",
  "slug": "homemade-red-wine-vinaigrette",
  "name": "Homemade Red Wine Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This red wine vinaigrette is easy to make with olive oil, red wine vinegar, lemon juice, and garlic for a tangy and refreshing dressing on any salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour olive oil, red wine vinegar, and lemon juice into a sealable glass jar. Add garlic. Season with dry mustard, dried onion, pepper, salt, paprika, and turmeric. Shake until well combined. Keep refrigerated until ready to use."
    }
  ],
  "servings": 10,

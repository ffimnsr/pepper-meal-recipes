  "id": "08bdd9a4-f7df-569a-85b0-821570e04c3e",
  "slug": "curried-microwave-popcorn",
  "name": "Curried Microwave Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Microwave your popcorn in a brown paper bag and season with curry powder for a quick and easy snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour popcorn into the paper bag; fold top over several times to seal."
    },
    {
      "position": 2,
      "text": "Heat in microwave until popping slows, about 2 minutes. Season popcorn with salt and curry powder; close bag and shake to evenly coat."
    }
  ],

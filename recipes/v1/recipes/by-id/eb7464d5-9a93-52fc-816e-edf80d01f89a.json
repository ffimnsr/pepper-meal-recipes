  "id": "eb7464d5-9a93-52fc-816e-edf80d01f89a",
  "slug": "blueberry-popovers",
  "name": "Blueberry Popovers",
  "recipe_type": "side",
  "brief_description": "This special blueberry popover recipe will add a lot of flavor to your next brunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place a piece of butter into each cup of a jumbo muffin tin."
    },
    {
      "position": 2,
      "text": "Place muffin tin into the preheating oven until butter melts, about 5 minutes. Remove and set aside."
    },
    {
      "position": 3,
      "text": "Stir 1 tablespoon sugar and cinnamon together in a small bowl."
    },
    {
      "position": 4,
      "text": "Beat milk, 1/4 cup sugar, eggs, and vanilla in a large bowl. Whisk in flour until incorporated. Divide batter among muffin cups. Drop an equal amount of blueberries into each cup, then sprinkle cinnamon-sugar mixture over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 5 minutes. Reduce the heat to 350 degrees F (175 degrees C) and continue baking until popovers are no longer moist in the center, about 25 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and transfer to a wire rack. Dust tops of popovers with confectioners' sugar and squeeze lemon halves over top. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8595dffa-f54b-58be-8051-c1f37afd00c9",
  "slug": "calico-bean-casserole",
  "name": "Calico Bean Casserole",
  "recipe_type": "side",
  "brief_description": "This calico bean casserole is made with ground beef, bacon, and onion baked with kidney beans, beans with pork, and butter beans for a hearty dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium heat. Cook and stir beef, bacon, and onion in the hot skillet until beef is browned and crumbly, 5 to 7 minutes. Drain fat."
    },
    {
      "position": 3,
      "text": "Combine baked beans with pork, kidney beans, and butter beans in a large bowl. Stir in brown sugar, ketchup, mustard, and vinegar. Add cooked beef mixture; mix thoroughly and season with salt and pepper. Transfer mixture to a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

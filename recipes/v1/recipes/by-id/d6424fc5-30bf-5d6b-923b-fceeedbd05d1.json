  "id": "d6424fc5-30bf-5d6b-923b-fceeedbd05d1",
  "slug": "cheesy-potato-pancakes",
  "name": "Cheesy Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Potato pancakes are flavored with Parmesan and Cheddar cheeses and are sure to please the whole family. Wrap them in foil and bring them along in your lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine potatoes, eggs, and milk together in a large bowl."
    },
    {
      "position": 2,
      "text": "Stir flour, Parmesan cheese, Cheddar cheese, bacon bits, onion salt, baking powder, salt, and black pepper into potato mixture using a fork."
    },
    {
      "position": 3,
      "text": "Heat corn oil and butter in a large skillet over medium heat."
    },
    {
      "position": 4,
      "text": "Drop potato mixture by 2 tablespoonfuls onto skillet. Cook patties until golden brown, about 4 minutes per side"
    },
    {
      "position": 5,
      "text": "Drain cooked pancakes on a paper towel-lined plate."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

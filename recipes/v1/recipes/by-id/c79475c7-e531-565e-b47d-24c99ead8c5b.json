  "id": "c79475c7-e531-565e-b47d-24c99ead8c5b",
  "slug": "italian-sausage-butternut-squash-soup-recipe-11832360",
  "name": "Italian Sausage Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This Italian sausage butternut squash soup is rich and deeply satisfying. Roasted vegetables are simmered in broth, blended, and combined with cream for a smooth, flavorful soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange butternut squash, carrots, and onion on a baking sheet. Drizzle with olive oil and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Roast vegetables in the preheated oven until tender and caramelized, 30 to 35 minutes, stirring halfway through."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a stock pot over medium heat. Add sausage and cook until browned and crumbly, 5 to 7 minutes. Drain excess fat if necessary, leaving about 1 tablespoon in the pot for flavor. Add garlic and thyme; stir until fragrant, about 30 seconds."
    },
    {
      "position": 5,
      "text": "Transfer roasted vegetables to the pot with the sausage. Add enough chicken bone broth to cover vegetables. Bring to a gentle simmer and cook for 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Remove thyme stems. Use an immersion blender to pur\u00e9e the soup directly in the pot until smooth. Stir in half-and-half and heavy cream; season with salt and pepper. Warm through without boiling"
    },
    {
      "position": 7,
      "text": "Finish with a splash of apple cider; stir to combine. Drizzle whipping cream on top of each bowl of soup."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

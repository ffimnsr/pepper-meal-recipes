  "slug": "slow-cooker-adobo-chicken",
  "name": "Slow Cooker Adobo Chicken",
  "recipe_type": "main",
  "brief_description": "An easy slow cooker recipe with soy sauce, garlic, and onion. Do not be put off by the vinegar -- it tenderizes the chicken and loses its potent flavor in the cooking.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a slow cooker. In a small bowl mix the onion, garlic, soy sauce, and vinegar, and pour over the chicken. Cook on Low for 6 to 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,

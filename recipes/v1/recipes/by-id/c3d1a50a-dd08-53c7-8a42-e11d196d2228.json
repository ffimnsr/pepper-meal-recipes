  "id": "c3d1a50a-dd08-53c7-8a42-e11d196d2228",
  "slug": "creamy-rice-pudding",
  "name": "Creamy Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This rice pudding with golden raisins makes a comforting dessert that everyone will love. Serve warm with a sprinkling of ground cinnamon or nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water in a saucepan to a boil over medium heat; stir in rice. Reduce heat to low, cover, and simmer until rice is tender and liquid has been absorbed, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Combine cooked rice, 1 \u00bd cups milk, sugar, and salt in a clean saucepan; cook over medium heat, stirring often, until thick and creamy, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir in remaining \u00bd cup milk, egg, and raisins; cook 2 minutes, stirring constantly. Off heat, stir in butter and vanilla extract until combined."
    },
    {
      "position": 5,
      "text": "Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

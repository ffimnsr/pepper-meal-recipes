  "schema_version": 1,
  "id": "5204dbb4-a494-59a3-811f-66df9922df5c",
  "slug": "butternut-squash-soup-with-a-kick",
  "name": "Butternut Squash Soup with a Kick",
  "recipe_type": "soup",
  "brief_description": "Fresh ginger and jalape\u00f1o pepper spice up this silky butternut squash soup with a kick recipe. Sour cream and fresh thyme cool it down to your liking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onion, jalape\u00f1o, and ginger; cook and stir until onion has softened and turned translucent, about 7 minutes."
    },
    {
      "position": 2,
      "text": "Add butternut squash and chicken broth; bring to a boil over high heat. Reduce heat to medium-low, cover, and simmer until squash is tender, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Stir in evaporated milk, coconut milk, sugar, salt, and black pepper; cook and stir 5 minutes more."
    },
    {
      "position": 4,
      "text": "Fill a blender halfway with soup. Cover and hold lid down with a folded kitchen towel; pulse a few times before leaving on to pur\u00e9e. Pour into a clean pot. Repeat with remaining soup. Or pur\u00e9e soup with an immersion blender until smooth. Garnish servings with sour cream and thyme."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d0f63aec-a367-5a11-9183-7f01d973d9d9",
  "slug": "tater-tot-casserole-iv",
  "name": "Tater Tot Casserole with Green Beans",
  "recipe_type": "soup",
  "brief_description": "Layers of green beans, creamy soup, browned ground beef and pork sausage and - of course - tater tots! An easy, tasty casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Saut\u00e9 onion in a large skillet until soft; add beef and sausage and cook until browned. Drain set aside."
    },
    {
      "position": 3,
      "text": "Spread soup and beans in the bottom of a 9x13-inch baking dish. Slowly add meat mixture, then top with tater tots and season with salt to taste."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until casserole is cooked through, about 30 to 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

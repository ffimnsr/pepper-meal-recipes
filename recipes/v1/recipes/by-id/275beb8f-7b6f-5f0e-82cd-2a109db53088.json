  "schema_version": 1,
  "id": "275beb8f-7b6f-5f0e-82cd-2a109db53088",
  "slug": "meringue-mushrooms",
  "name": "Meringue Mushrooms",
  "recipe_type": "dessert",
  "brief_description": "These meringue mushrooms are light and airy, take some time to make, and are perfect for decorating yule logs or adding to Christmas cookie platters.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 225 degrees F (110 degrees C). Line 2 cookie sheets with parchment paper or aluminum foil."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a large glass or metal bowl with an electric mixer until foamy. Add vanilla, cream of tartar, and salt."
    },
    {
      "position": 4,
      "text": "Continue whipping until soft peaks form. Gradually sprinkle in sugar so that it does not sink to the bottom and continue whipping until meringue holds stiff shiny peaks. Place a round tip into a pastry bag and fill the bag halfway with meringue."
    },
    {
      "position": 5,
      "text": "To pipe mushroom caps, squeeze out round mounds of meringue onto one of the prepared cookie sheets. Pull the bag off to the side to avoid making peaks on the top. Refill the bag with meringue as needed."
    },
    {
      "position": 6,
      "text": "To pipe mushroom stems, press out a tiny bit of meringue onto the remaining cookie sheet, then pull the bag straight up. They should resemble candy kisses. Do not worry about making all of the pieces exactly the same. The mushrooms will look more natural if the pieces are different sizes."
    },
    {
      "position": 7,
      "text": "Dust mushroom caps lightly with cocoa using a small sifter or strainer."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until meringues are dry enough to easily remove from the cookie sheets, about 1 hour. Set aside to cool completely."
    },
    {
      "position": 9,
      "text": "Melt coating chocolate in a metal bowl over simmering water or in a glass bowl in the microwave, stirring occasionally until smooth."
    },
    {
      "position": 10,
      "text": "Rotate the tip of a paring knife in the bottom of a mushroom cap to create a small hole. Spread chocolate over the bottom of the cap. Dip the tip of a stem in chocolate and press lightly into the hole."
    },
    {
      "position": 11,
      "text": "When chocolate sets, the cap and stem will hold together. Repeat with remaining meringues. Store at room temperature in a dry place or tin."
    }
  ],

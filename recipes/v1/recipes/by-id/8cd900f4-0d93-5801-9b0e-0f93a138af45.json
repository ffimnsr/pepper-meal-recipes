  "id": "8cd900f4-0d93-5801-9b0e-0f93a138af45",
  "slug": "coconut-pecan-pie",
  "name": "Coconut Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "Shredded coconut is folded into pecan pie filling for a sweet twist to the traditional pie. Serve during the holiday season.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Press pie crust into a 9-inch pie dish."
    },
    {
      "position": 2,
      "text": "Beat butter, eggs, lemon juice, and vanilla extract together in a bowl; beat in sugar until smooth. Fold coconut and pecans into butter mixture; pour into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pie is set in the middle, 45 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,

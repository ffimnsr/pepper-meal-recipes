  "schema_version": 1,
  "id": "c64ed7d6-9543-5366-b508-8d81a7059ce9",
  "slug": "shrimp-and-jalapeno-nachos",
  "name": "Shrimp and Jalapeno Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Light, crisp nachos topped with a shrimp, a sliver of jalapeno pepper, and some pepperjack cheese get a minute or 2 under the broiler for the perfect, tasty little bite.",
  "cuisine": "Mexican Inspired American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sour cream, avocado, and lemon juice in a blender or food processor; blend until smooth and creamy. Transfer into a plastic decorating bottle with a long tip. Refrigerate avocado-cream sauce until needed."
    },
    {
      "position": 2,
      "text": "Place shrimp into a bowl; combine with vegetable oil, ground chipotle pepper, salt, black pepper, and cayenne pepper."
    },
    {
      "position": 3,
      "text": "Place a large nonstick pan over high heat. Cook shrimp in the hot pan in a single layer until barely cooked through and pink, about 1 minute per side. Transfer to a plate and let shrimp cool."
    },
    {
      "position": 4,
      "text": "Preheat the oven's broiler. Line a baking sheet with aluminum foil and lightly grease the foil."
    },
    {
      "position": 5,
      "text": "Lay tortilla chips onto the prepared baking sheet in a single layer. Place 1 shrimp onto each chip. Add 1 slice jalapeno and 1 large pinch pepperjack cheese on top of each shrimp."
    },
    {
      "position": 6,
      "text": "Broil under preheated broiler until cheese is melted and chips are lightly toasted, about 1 minute. Watch carefully; chips will burn quickly."
    },
    {
      "position": 7,
      "text": "Remove nachos from baking sheet and arrange onto a serving platter; drizzle with avocado-cream sauce and sprinkle with cherry tomatoes and cilantro before serving."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

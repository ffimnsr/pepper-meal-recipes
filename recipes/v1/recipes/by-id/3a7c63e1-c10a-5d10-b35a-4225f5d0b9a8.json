  "id": "3a7c63e1-c10a-5d10-b35a-4225f5d0b9a8",
  "slug": "baked-mac-and-cheese-for-one",
  "name": "Baked Mac and Cheese for One",
  "recipe_type": "main",
  "brief_description": "This creamy mac and cheese for one made with real Cheddar cheese starts on the stovetop and finishes up in the oven with a cheesy breaded finish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease an oven-proof soup crock or 1-cup baking dish."
    },
    {
      "position": 2,
      "text": "Bring a small pot of lightly salted water to a boil. Cook macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Melt butter in the same pot over medium-high heat. Whisk in milk, flour, salt, onion powder, and pepper until smooth. Cook and stir for 2 minutes. Reduce the heat to low, then whisk in 1/3 cup Cheddar, mustard, Worcestershire sauce, and hot sauce."
    },
    {
      "position": 4,
      "text": "Stir in cooked macaroni until coated, then transfer to the prepared dish. Sprinkle with bread crumbs and 1 tablespoon Cheddar."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, in the preheated oven until macaroni is heated through and cheese is melted, about 10 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

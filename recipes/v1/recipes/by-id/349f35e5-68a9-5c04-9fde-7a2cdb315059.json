  "id": "349f35e5-68a9-5c04-9fde-7a2cdb315059",
  "slug": "grill-master-chicken-wings",
  "name": "Grill Master Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "These grilled chicken wings are marinated in a simple 2-ingredient marinade then grilled until golden and tossed in a spicy butter sauce. So good!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To prepare the wings: Combine chicken wings, soy sauce, and Italian dressing in a large resealable plastic bag; coat chicken wings with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 4 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "To make the spicy sauce: Melt butter in a small saucepan over low heat; stir in hot pepper sauce and soy sauce until combined. Remove from heat and set aside."
    },
    {
      "position": 4,
      "text": "Remove chicken wings from marinade and pat dry; discard any remaining marinade."
    },
    {
      "position": 5,
      "text": "Cook on the preheated grill, turning occasionally, until chicken is golden brown and no longer pink inside, 25 to 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Place grilled wings in a large bowl. Pour prepared spicy butter sauce over wings; toss until well-coated."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4fdb624a-6d59-5f91-a53a-c205e7765404",
  "slug": "raspberry-pain-au-chocolat-raspberry-chocolate-croissants",
  "name": "Raspberry Pain au Chocolat (Raspberry Chocolate Croissants)",
  "recipe_type": "breakfast",
  "brief_description": "This recipe for raspberry pain au chocolat (raspberry chocolate croissants) yields puff pastries filled with chocolate-hazelnut spread and raspberry spread.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Unfold puff pastry sheets on a lightly floured surface; cut each sheet into thirds along fold lines. Roll out each dough strip to about 16 inches long; cut strips into thirds."
    },
    {
      "position": 3,
      "text": "Spread about 1 teaspoon hazelnut spread onto one half of 1 rectangle to within \u00bd inch of edge. Spread about \u00bd teaspoon raspberry jam over hazelnut spread. Brush edges with egg; fold over other side to enclose the filling. Press edges firmly to seal. Repeat with remaining rectangles, hazelnut spread, and jam. Cut 5 slits across top of each pastry using a sharp knife; place onto baking sheets, spaced 2 inches apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 18 minutes. Transfer to wire racks to cool, then dust with confectioners' sugar."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

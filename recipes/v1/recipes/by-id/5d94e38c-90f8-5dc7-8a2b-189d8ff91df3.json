  "id": "5d94e38c-90f8-5dc7-8a2b-189d8ff91df3",
  "slug": "banana-margaritas",
  "name": "Banana Margaritas",
  "recipe_type": "drink",
  "brief_description": "The classic lime margarita gets a new twist with the addition of bananas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sugar the rims of 4 large margarita glasses. To do so, pour sugar onto a small plate, moisten the rims of the glasses on a damp towel and press them into the sugar."
    },
    {
      "position": 2,
      "text": "In a blender, combine tequila, limeade, triple sec and ice. Blend until smooth. Add bananas and blend again until smooth. Pour into glasses and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

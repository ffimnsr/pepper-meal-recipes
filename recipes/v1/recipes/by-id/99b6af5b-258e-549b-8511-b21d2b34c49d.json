  "id": "99b6af5b-258e-549b-8511-b21d2b34c49d",
  "slug": "copycat-big-boy-strawberry-pie-recipe-11763764",
  "name": "Copycat Big Boy Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This copycat Big Boy strawberry pie is just like the restaurant version. Packed with fresh strawberries in chilled strawberry gelatin, and topped with whipped cream, this pie is a cool treat for a hot summer day.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Wash, dry, and remove stems from strawberries. Arrange strawberries, tip-side up, in the prepared pie crust. Cut larger strawberries in half if needed to fit evenly. Strawberries should be piled high inside the crust."
    },
    {
      "position": 2,
      "text": "In a saucepan, whisk together corn starch and sugar. Add lemon-lime soda and water, and whisk to combine."
    },
    {
      "position": 3,
      "text": "Bring to a boil over medium heat, whisking frequently, until sugar is dissolved and mixture has thickened slightly."
    },
    {
      "position": 4,
      "text": "Remove from heat and whisk in the strawberry gelatin until fully dissolved."
    },
    {
      "position": 5,
      "text": "Let the mixture cool slightly, about 5 minutes, then carefully pour over the strawberries in the pie crust, covering evenly."
    },
    {
      "position": 6,
      "text": "Refrigerate for at least 4 hours, or until the filling is completely set."
    },
    {
      "position": 7,
      "text": "Slice and serve chilled. Top with whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

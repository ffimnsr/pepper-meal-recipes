  "id": "8b5e8303-6629-542c-9a4d-5a95fdb2d49e",
  "slug": "gorton-french-canadian-pork-spread",
  "name": "Gorton (French-Canadian Pork Spread)",
  "recipe_type": "appetizer",
  "brief_description": "This gorton recipe is a French-Canadian pork spread, also known as cretons, that\u2019s flavored with nutmeg and clove for a hearty spread on toast or crackers.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pork fat, ground pork, onions, water, cloves, and nutmeg in a large pot; season with salt and black pepper. Bring to a boil over medium-high heat, then reduce heat to medium-low, mashing mixture with a potato masher every 15 minutes as it cooks; simmer until pork is tender, at least 1 \u00bd hours. Add water as necessary to keep mixture from boiling dry. Reduce liquid as much as possible when ready to stop cooking without letting it burn. Transfer to lidded containers."
    },
    {
      "position": 2,
      "text": "Refrigerate gorton 8 hours to overnight. Remove and discard fat layer or stir into gorton for a creamier spread."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 15,

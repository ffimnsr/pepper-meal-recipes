  "id": "fa916f7b-0392-58bf-8a86-ebbba819ebe3",
  "slug": "dutch-oven-beef-stew",
  "name": "Dutch Oven Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This beef stew made in a Dutch oven is loaded with mushrooms, potatoes, carrots, and onion for a hearty, comforting dish perfect for a chilly night.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together flour, paprika, salt, and pepper in a medium bowl until well combined. Add beef and toss until evenly coated."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a cast iron Dutch oven or large pot over medium-high heat. Sear beef in hot oil until well browned, 2 to 3 minutes per side. Stir in broth, potatoes, mushrooms, carrots, onion, celery, Worcestershire sauce, garlic, and bay leaves."
    },
    {
      "position": 3,
      "text": "Cover the pot, reduce heat to low, and simmer, stirring occasionally, until meat and vegetables are tender, about 2 hours 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 155,
  "preparation_time_minutes": 30,

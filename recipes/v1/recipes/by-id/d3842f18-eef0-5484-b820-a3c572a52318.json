  "slug": "grandmas-harvard-beets",
  "name": "Grandma's Harvard Beets",
  "recipe_type": "salad",
  "brief_description": "These classic Harvard beets made with vinegar and sugar have a sweet and tangy flavor and make a colorful side or addition to salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine sugar, cornstarch, vinegar, and water in a saucepan. Bring to a boil, and cook for 5 minutes."
    },
    {
      "position": 3,
      "text": "Add beets to the liquid, and simmer for 30 minutes over low heat. Stir in butter, salt, and pepper, and remove from the heat. Serve warm or chilled."
    }
  ],
  "servings": 6,

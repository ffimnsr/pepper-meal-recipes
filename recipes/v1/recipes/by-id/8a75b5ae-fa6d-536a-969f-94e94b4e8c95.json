  "id": "8a75b5ae-fa6d-536a-969f-94e94b4e8c95",
  "slug": "creamy-lemon-pepper-parmesan-chicken-recipe-11940527",
  "name": "Creamy Lemon Pepper Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "This creamy lemon pepper Parmesan chicken features tender chicken thighs simmered in an easy sauce with lemon zest, black pepper, and Parmesan cheese. It's quick enough for any weeknight dinner, and would be nice over rice or orzo.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken thighs evenly on both sides with 1/2 teaspoon salt and 1/2 teaspoon black pepper."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a 12-inch skillet over medium-high heat. Add chicken thighs and cook until browned, turning once, 7 to 8 minutes total. Remove chicken from skillet and set aside."
    },
    {
      "position": 3,
      "text": "Add shallot and garlic to the same skillet. Cook, stirring, until fragrant, 1 to 2 minutes. Pour in chicken broth and heavy cream. Bring to a gentle simmer."
    },
    {
      "position": 4,
      "text": "Stir in Parmesan cheese, lemon zest, remaining 1 teaspoon black pepper, and remaining 1/4 teaspoon salt. Simmer until the sauce thickens slightly, 4 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Return chicken to the skillet and cook until heated through, a thermometer inserted into the thickest portion registers 165 degrees F (74 degrees C), and chicken is coated with sauce, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Garnish with parsley and serve with lemon wedges. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

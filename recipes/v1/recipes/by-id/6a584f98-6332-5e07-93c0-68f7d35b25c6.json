  "id": "6a584f98-6332-5e07-93c0-68f7d35b25c6",
  "slug": "sweet-corn-risotto-recipe-12020222",
  "name": "Sweet Corn Risotto",
  "recipe_type": "dessert",
  "brief_description": "This sweet corn risotto features one of the easiest ways to make risotto\u2014in the oven! Made with fresh summer corn, this versatile side dish is just as delicious served warm as it is chilled, and optional bacon and Parmesan add an extra layer of savory flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Bring broth to a simmer in a medium saucepan."
    },
    {
      "position": 2,
      "text": "Pour rice into a heavy-bottomed Dutch oven or oven-safe large sauce pot; stir in 2 cups broth. Reserve remaining broth and cover to keep warm. Stir corn into rice; season with salt and pepper. Cover the pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 45 minutes."
    },
    {
      "position": 4,
      "text": "Carefully remove the lid and fluff the rice. All stock should be absorbed and the rice should be tender. If rice is dry but still not tender, add a little more broth, cover the pot, return to the oven, and bake until tender, checking every 10 minutes."
    },
    {
      "position": 5,
      "text": "Turn rice out into a bowl and add butter. Stir and taste; season with salt, pepper, and Parmesan cheese. Serve with bacon on top while still warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "27c1a327-b581-58b1-b378-f7d6fc28ede2",
  "slug": "spaghetti-squash-i",
  "name": "Spaghetti Squash",
  "recipe_type": "side",
  "brief_description": "Spaghetti squash is roasted, then tossed with tomatoes, feta cheese, olives, and basil for a totally delicious gluten-free side or vegetarian main.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Place spaghetti squash cut-sides down on the prepared baking sheet. Bake in the preheated oven until a sharp knife can be inserted with only a little resistance, about 30 minutes. Remove squash from oven and set aside to cool enough to be easily handled."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a skillet over medium heat. Cook and stir onion in oil until tender. Add garlic; cook and stir until fragrant, 2 to 3 minutes. Stir in tomatoes and cook until tomatoes are warmed through."
    },
    {
      "position": 4,
      "text": "Use a large spoon to scoop the stringy pulp from the squash and place in a medium bowl."
    },
    {
      "position": 5,
      "text": "Toss with cooked onion-tomato mixture, feta cheese, olives, and basil."
    },
    {
      "position": 6,
      "text": "Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

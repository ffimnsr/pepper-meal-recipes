  "slug": "tuna-antipasto-salad-bowl",
  "name": "Tuna Antipasto Salad Bowl",
  "recipe_type": "salad",
  "brief_description": "This recipe yields a big batch of hearty pasta salad with tuna, pasta, garbanzo beans, artichoke hearts, olives, and greens in Italian dressing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss salad greens, garbanzo beans, black olives, artichoke hearts, tuna, shell pasta, cucumber, and tomato together in a large bowl. Cover and refrigerate salad until lettuce is crisp and mixture is chilled, at least 2 hours."
    },
    {
      "position": 2,
      "text": "Toss salad with salad dressing immediately before serving."
    }
  ],

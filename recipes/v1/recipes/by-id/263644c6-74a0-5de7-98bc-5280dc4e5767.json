  "id": "263644c6-74a0-5de7-98bc-5280dc4e5767",
  "slug": "sopranos-style-tiramisu",
  "name": "Sopranos Style Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This light Soprano-style amaretto tiramisu recipe dips ladyfingers in coffee and layers them with amaretto-infused mascarpone and grated chocolate.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mascarpone cheese, sugar, and amaretto liqueur together in a bowl until smooth."
    },
    {
      "position": 2,
      "text": "Beat cream in a glass or metal bowl until soft peaks form. Lift your beater or whisk straight up: whipped cream should form soft mounds rather than a sharp peak. Fold whipped cream into mascarpone mixture. Pour espresso into a separate bowl."
    },
    {
      "position": 3,
      "text": "Dip 12 ladyfingers into espresso; arrange dipped ladyfingers in an 8-inch square baking pan. Spread \u00bd mascarpone mixture over ladyfingers; grate 1 chocolate square over mascarpone layer. Dip remaining 12 ladyfingers into espresso; arrange dipped ladyfingers on top. Spread remaining \u00bd mascarpone mixture over ladyfingers; grate remaining 1 chocolate square over mascarpone layer. Refrigerate tiramisu until set, at least 2 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

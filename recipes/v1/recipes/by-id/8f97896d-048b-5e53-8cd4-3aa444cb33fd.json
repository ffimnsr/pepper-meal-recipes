  "slug": "easy-chinese-chicken-salad",
  "name": "Easy Chinese Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Ramen noodles, rotisserie chicken, and cabbage are dressed in a simple vinaigrette in this quick and easy chicken salad recipe.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Toss chicken meat, cabbage, onions, ramen noodles, sesame seeds, and almonds together in a large bowl. Beat olive oil, vinegar, sugar, salt, and pepper together in a small bowl; drizzle over the salad and toss to coat."
    }
  ],

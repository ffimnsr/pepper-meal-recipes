  "id": "d328884f-0890-5c4c-9e96-48758d02825a",
  "slug": "crispy-vegan-gingersnaps",
  "name": "Crispy Vegan Gingersnaps",
  "recipe_type": "dessert",
  "brief_description": "These gingersnap cookies are crispy, spicy, and perfect with a hot drink in autumn and winter. You won't miss the dairy or eggs.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine almond flour, coconut flour, ginger, cinnamon, allspice, baking soda, nutmeg, and salt in a bowl. Whisk almond butter, honey, and melted coconut oil together in a separate bowl. Pour wet ingredients into dry and mix together until a dough forms."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Form dough into balls, then press to flatten onto the prepared baking sheet using the palm of the hand, the back of a spoon, or a fork."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are browned but still soft, 15 to 18 minutes."
    },
    {
      "position": 5,
      "text": "Remove cookies from oven and let cool 5 minutes. Transfer to a wire rack to cool completely; store in an airtight container to keep cookies crispy."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

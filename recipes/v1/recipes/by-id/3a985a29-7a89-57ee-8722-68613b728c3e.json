  "id": "3a985a29-7a89-57ee-8722-68613b728c3e",
  "slug": "cowboy-mashed-potato-casserole-recipe-8760165",
  "name": "Cowboy Mashed Potato Casserole",
  "recipe_type": "side",
  "brief_description": "This cowboy mashed potato casserole, a smoky beef and veggie mixture topped with creamy mashed potatoes, is like a cowboy version of a shepherds pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 2-quart baking dish with cooking spray. Place baking dish on a baking sheet."
    },
    {
      "position": 3,
      "text": "Cook bacon in a large skillet over medium heat, turning occasionally, until crisp, about 10 minutes. Place bacon on a paper towel to drain. Drain all but 1 tablespoon of bacon fat in the skillet. Chop bacon when cool enough to handle."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of salted water to a boil. Add potatoes and return to a boil. Cook, covered, until potatoes are fork tender, 15 to 20 minutes. Drain potatoes. Return potatoes back to the pot along with evaporated milk, butter, 1/2 teaspoon salt, and 1/2 teaspoon pepper."
    },
    {
      "position": 5,
      "text": "Mash potatoes with a potato masher until smooth. Stir 1/4 cup chopped bacon into mashed potatoes."
    },
    {
      "position": 6,
      "text": "Add ground beef, onion, and bell pepper to the skillet with reserved bacon fat. Cook over medium heat until meat is browned and cooked through, stirring occasionally, 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Add corn kernels, garlic, and paprika to the skillet. Cook and stir for 1 minute."
    },
    {
      "position": 8,
      "text": "Stir in barbecue sauce, Worcestershire sauce, mustard, remaining 1 teaspoon salt, and 1/2 teaspoon pepper."
    },
    {
      "position": 9,
      "text": "Spread ground beef mixture in prepared baking dish."
    },
    {
      "position": 10,
      "text": "Spread potatoes evenly over beef. Sprinkle with cheese, remaining bacon, and French fried onions."
    },
    {
      "position": 11,
      "text": "Bake until meat mixture is bubbly and cheese is melted, 20 to 25 minutes. Garnish with parsley before serving."
    },
    {
      "position": 12,
      "text": "Serve warm and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

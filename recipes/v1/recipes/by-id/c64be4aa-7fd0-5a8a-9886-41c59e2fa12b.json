  "id": "c64be4aa-7fd0-5a8a-9886-41c59e2fa12b",
  "slug": "the-best-vegetarian-chili-in-the-world",
  "name": "The Best Vegetarian Chili in the World",
  "recipe_type": "soup",
  "brief_description": "This vegetarian chili is packed with beans, corn, tomatoes, and bell peppers. Jalapeños, green chiles, and chili powder kick things up a notch!",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium heat. Stir in onion and season with oregano, salt, cumin, and bay leaves. Cook and stir until onion is tender; stir in celery, green bell peppers, jalapeños, and garlic."
    },
    {
      "position": 3,
      "text": "Add green chile peppers and cook until heated through. Stir in vegetarian burger crumbles; reduce heat to low, cover pot, and simmer for 5 minutes"
    },
    {
      "position": 4,
      "text": "Stir in tomatoes; season with chili powder and black pepper. Stir in kidney beans, garbanzo beans, and black beans."
    },
    {
      "position": 5,
      "text": "Bring to a boil, reduce heat to low, and simmer for 45 minutes."
    },
    {
      "position": 6,
      "text": "Stir in the corn, and continue cooking for 5 minutes before serving."
    },
    {
      "position": 7,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

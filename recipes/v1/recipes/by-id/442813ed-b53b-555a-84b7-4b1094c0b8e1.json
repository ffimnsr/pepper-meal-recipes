  "id": "442813ed-b53b-555a-84b7-4b1094c0b8e1",
  "slug": "campfire-pepperoni-pizza",
  "name": "Campfire Pepperoni Pizza",
  "recipe_type": "main",
  "brief_description": "This campfire pepperoni pizza recipe is as easy as pie. The smoky flavor from a wood fire adds a great twist on a favorite with the help of a pizza stone.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a pizza stone on an outdoor grill directly over a wood fire. You may first need to spread out the wood if the flames are too high."
    },
    {
      "position": 2,
      "text": "Roll out pizza dough on a flat surface to desired thickness. Place on the pizza stone; cook until golden on one side, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer dough to a flat work surface; spread pizza sauce in an even layer onto cooked side of dough, leaving \u00bd-inch edge bare. Sprinkle mozzarella cheese on top sauce; top with pepperoni."
    },
    {
      "position": 4,
      "text": "Place pizza on the pizza stone; tent with aluminum foil and cook until cheese has melted, about 10 minutes. Transfer pizza to a cutting board. Cool slightly before cutting and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "3df4d8a8-57d8-5543-b72e-fde5d75b3852",
  "slug": "creamy-southern-shrimp-and-cheese-grits",
  "name": "Creamy Southern Shrimp and Cheese Grits",
  "recipe_type": "breakfast",
  "brief_description": "A few gourmet ingredients, including dry sherry and goat cheese, lift this colorful dish of shrimp served with cheesy grits to a new level. Serve it for a special occasion or a fancy brunch.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a large saucepan and slowly whisk in grits; reduce heat to medium-low and simmer until thickened and tender, 5 to 7 minutes, stirring occasionally. Stir farmers cheese, goat cheese, and American cheese into grits until cheese has melted. Set grits aside and keep warm."
    },
    {
      "position": 2,
      "text": "Melt butter with vegetable oil in a large skillet over medium heat. Cook and stir tomato, 2 green onions, and garlic in the hot skillet until the vegetables are tender, 5 to 7 minutes. Stir in bacon drippings until combined. Cook and stir shrimp with vegetables until bright pink, about 5 minutes; season to taste with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Mix grits into shrimp mixture and stir in half-and-half until smooth. Simmer the mixture to blend flavors, about 5 minutes, and add sherry. Simmer 3 more minutes before adjusting salt and black pepper. Garnish with sliced green tops of 1 green onion before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

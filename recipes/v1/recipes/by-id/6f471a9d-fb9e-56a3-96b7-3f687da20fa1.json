  "id": "6f471a9d-fb9e-56a3-96b7-3f687da20fa1",
  "slug": "amish-haystacks-recipe-11907555",
  "name": "Amish Haystacks",
  "recipe_type": "main",
  "brief_description": "These Amish haystacks are a hearty, comforting, build-your-own meal of taco-seasoned beef, layered over rice and topped with a variety of vegetables and crunch, including lettuce, tomatoes, cheese, and crunched-up saltines. They're quick to cook, and fun to assemble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook beef in a large cast-iron skillet over medium heat, stirring often, until browned and crumbly, 6 to 7 minutes. Drain excess fat."
    },
    {
      "position": 2,
      "text": "Stir taco seasoning mix, chicken stock, and fire-roasted tomatoes into beef in skillet. Bring to a simmer over medium heat. Reduce heat to medium-low, and cook, uncovered, stirring occasionally, until meat is cooked through, saucy, and liquid clings to beef, 7 to 8 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Fluff rice and transfer rice to a serving bowl. Transfer beef mixture to a separate serving bowl. Arrange lettuce, tomatoes, saltine crackers, Cheddar, bell pepper, onion, and sour cream in individual serving bowls."
    },
    {
      "position": 4,
      "text": "Assemble individual plates by layering beef mixture over rice and topping as desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

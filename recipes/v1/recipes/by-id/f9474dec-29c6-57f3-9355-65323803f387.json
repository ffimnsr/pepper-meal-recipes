  "id": "f9474dec-29c6-57f3-9355-65323803f387",
  "slug": "copycat-panera-creamy-tomato-soup-recipe-11712118",
  "name": "Copycat Panera Creamy Tomato Soup",
  "recipe_type": "soup",
  "brief_description": "This copycat Panera creamy tomato soup is a classic, comforting, slightly tangy, and with a vibrant color. In this recipe, roasting the onions and garlic intensifies the flavor, and heavy cream enhances the soup's rich texture.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking sheet sheet with cooking spray. Place garlic bulb and onion on the prepared sheet."
    },
    {
      "position": 2,
      "text": "Roast until very tender, 40 to 45 minutes; remove from oven and let cool until cool enough to handle."
    },
    {
      "position": 3,
      "text": "Chop half the onion; release 4 garlic cloves. Set aside remaining onion and garlic."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a Dutch oven over medium heat. Add chopped roasted onions and 4 roasted garlic cloves to the hot oil, and cook and stir until fragrant, up to 1 minute."
    },
    {
      "position": 5,
      "text": "Add both cans of San Marzano tomatoes (including juice), vegetable stock, and agave syrup. Bring to a simmer and cook until thickened, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Carefully transfer tomatoes and some of the liquid, remaining onion, remaining garlic, fresh basil, and fresh oregano into a food processor or blender. Blend until there are no chunks."
    },
    {
      "position": 7,
      "text": "Add soup mixture back into the Dutch oven along with heavy cream. Season with salt and pepper. Simmer on low to medium heat for 5 to 10 minutes to allow flavors to meld together."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7673358a-91c5-5a5e-85fa-3ac7be40f74b",
  "slug": "sweet-lamb-curry",
  "name": "Sweet Lamb Curry",
  "recipe_type": "dessert",
  "brief_description": "This sweet lamb curry recipe is a mild, fragrant mix of lamb, raisins, and apples, and yields a flavorful, slow-cooked curry perfect for fall.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Place flour in a resealable plastic bag; season with salt and black pepper. Add lamb to the bag; shake until evenly coated with flour."
    },
    {
      "position": 2,
      "text": "Melt 3 tablespoons butter in a large pot over medium-high heat. Add lamb, in batches; cook until golden brown on all sides, about 5 minutes per batch. Set aside."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium; add remaining 3 tablespoons butter. Stir in onions; cook until softened and translucent, about 5 minutes. Stir in apple, chicken stock, raisins, brown sugar, curry powder, and browned lamb; bring to a boil over medium-high heat. Reduce heat to medium-low, cover, and simmer until lamb is very tender, 1 to 1 \u00bd hours. Stir in lemon juice; cook 2 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "00234b65-7dbe-55ff-91f1-3fd08eaca6c9",
  "slug": "moms-baking-powder-biscuits",
  "name": "Mom's Baking Powder Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "This is the recipe for baking powder biscuits my mom always made. The amount of biscuits you get depends on how big you make them. Delicious and easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, baking powder, and salt in a bowl. Add shortening and cut into flour until incorporated into little pieces. Add milk a little at a time and mix until dough forms a ball."
    },
    {
      "position": 3,
      "text": "Roll out dough on a floured board to 1/2- to 1/4-inch thick. Cut out biscuits to desired size and dip in melted shortening. Place biscuits on an ungreased baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 12 to 15 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

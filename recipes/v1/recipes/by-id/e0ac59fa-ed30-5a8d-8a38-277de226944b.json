  "id": "e0ac59fa-ed30-5a8d-8a38-277de226944b",
  "slug": "persian-rice",
  "name": "Persian Rice",
  "recipe_type": "side",
  "brief_description": "Chef John's Persian rice features fluffy basmati rice flavored with butter, saffron, and cumin, topped with slices of beautiful golden crisp potatoes.",
  "cuisine": "Persian Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Place water and kosher salt in a pot; bring to a boil. Add rice; cook and stir for exactly 7 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a pot over medium-high heat. Cover bottom of the pot with 1 layer of potato slices. Sprinkle cumin and salt over potatoes. Cook until potatoes are sizzling, 2 to 3 minutes; top potatoes with rice to form an even layer. Reduce heat to low and place butter slices over rice."
    },
    {
      "position": 3,
      "text": "Top the pot with a layer of clean paper towels, then place the lid over the towels. Steam until rice is fluffy, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Grind saffron threads with a mortar and pestle. Mix crushed saffron with 1 \u00bd tablespoons hot water in a large bowl. Add a couple of spoonfuls of rice to saffron mixture and stir until rice is yellow."
    },
    {
      "position": 5,
      "text": "Spoon remaining rice into a serving bowl. Top with saffron rice and line the edges of the bowl with potatoes. Garnish with parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

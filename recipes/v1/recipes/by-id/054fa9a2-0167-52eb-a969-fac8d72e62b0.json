  "id": "054fa9a2-0167-52eb-a969-fac8d72e62b0",
  "slug": "marry-me-chicken-pot-pie-recipe-11835360",
  "name": "Marry Me Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This marry me chicken pot pie really delivers on its name. With a flakey crust on top and bottom, it is filled with creamy chicken, spinach, and sun dried tomatoes. A super tasty, beautiful dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a 9-inch deep dish pie plate with one of the pie crusts, set aside."
    },
    {
      "position": 3,
      "text": "Heat oil from sundried tomatoes in a 12-inch skillet over medium heat. Add onion and cook for 2 minutes."
    },
    {
      "position": 4,
      "text": "Add potatoes and cook, stirring occasionally, until potatoes are nearly tender, 5 minutes."
    },
    {
      "position": 5,
      "text": "Add garlic and cook for 1 minute. Remove potato mixture from the skillet and set aside."
    },
    {
      "position": 6,
      "text": "Add white wine to the skillet and cook, stirring to scrape up any browned bits from the bottom, until wine is reduced to half, about 1 minute."
    },
    {
      "position": 7,
      "text": "Add butter to the skillet. Once melted, whisk in flour to form a roux. Pour in chicken broth while continuing to stir. When thickened and bubbly, add cream, sun-dried tomatoes, Parmesan cheese, thyme, oregano, salt, paprika, and pepper. Return to a simmer."
    },
    {
      "position": 8,
      "text": "Return potato mixture, chicken, and spinach to the skillet; stir to combine. Cook just until spinach wilts, about 1 minute."
    },
    {
      "position": 9,
      "text": "Add filling to the prepared pie plate and top with remaining pie crust, crimping edges and making small slits in the top to allow steam to escape."
    },
    {
      "position": 10,
      "text": "Whisk together egg and water in a small bowl. Brush pastry with egg wash."
    },
    {
      "position": 11,
      "text": "Bake until the crust is golden brown and filling is bubbling through the slits, 30 to 35 minutes. Let stand for 20 minutes before serving. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 35,

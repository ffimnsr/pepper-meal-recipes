  "id": "3a93c82d-2e58-523b-8235-d306fe782a2b",
  "slug": "coconut-pie",
  "name": "Coconut Pie",
  "recipe_type": "dessert",
  "brief_description": "This coconut pie recipe has an easy filling made with flaked coconut and simple pantry ingredients for a sweet and delicious old-fashioned dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix sugar and flour together in a large bowl. Beat in eggs and butter until well combined. Stir in milk and vanilla until incorporated. Fold in coconut. Pour into prepared pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 hour. Cool completely before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

  "id": "34276af5-b593-51ad-9068-6b7eaf71ef4b",
  "slug": "pumpkin-oat-bread",
  "name": "Pumpkin Oat Bread",
  "recipe_type": "breakfast",
  "brief_description": "This moist pumpkin bread gets extra heartiness with the addition of rolled oats. Cinnamon, cloves, and nutmeg add even more flavor. Perfect for fall!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Stir together oil, eggs, and pumpkin in a large bowl. Stir in white and brown sugar, baking powder, salt, cinnamon, cloves, and nutmeg until well combined. Beat in flour and 1 1/2 cups of oats."
    },
    {
      "position": 3,
      "text": "Pour batter into the prepared loaf pans; sprinkle tops with remaining 1/4 cup of oats. Press oats lightly into top of the batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a knife inserted in the middle of a loaf comes out clean, 40 to 45 minutes. Let cool for 15 minutes before slicing."
    }
  ],
  "servings": 22,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

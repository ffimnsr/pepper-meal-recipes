  "id": "00fa9284-90c5-5acc-af1b-02457a17d46b",
  "slug": "grandmas-clover-leaf-rolls",
  "name": "Grandma\u2019s Clover Leaf Rolls",
  "recipe_type": "main",
  "brief_description": "My grandma\u2019s cloverleaf rolls recipe was always requested at family get-togethers. They\u2019re delicious, and I cherish my memories of baking them with her.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 12-cup muffin tin and a large bowl. Set them aside."
    },
    {
      "position": 2,
      "text": "Heat milk in a saucepan over medium heat just until bubbles begin to form. Stir in sugar, shortening, and salt; set aside until cooled to 110 degrees F (43 degrees C)."
    },
    {
      "position": 3,
      "text": "Sprinkle yeast over warm water and set aside until foamy, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Beat egg in a large bowl, then stir in yeast and milk mixtures until combined. Stir in 1/2 of the flour until no lumps remain, then stir in remaining flour, a little at a time, until a smooth dough forms. Place into the prepared bowl, turning once to grease the top of dough. Cover the bowl and let dough rise until doubled in size, about 2 hours."
    },
    {
      "position": 5,
      "text": "Deflate dough and transfer to a well-floured work surface. Divide dough into 36 equal pieces and shape into balls. Place 3 balls into each prepared muffin cup. Cover and let rise in a warm place until dough balls double in size, about 1 hour."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

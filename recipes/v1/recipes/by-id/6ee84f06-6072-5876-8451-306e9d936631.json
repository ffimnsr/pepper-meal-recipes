  "id": "6ee84f06-6072-5876-8451-306e9d936631",
  "slug": "french-75-jell-o-shots",
  "name": "French 75 Jell-O Shots",
  "recipe_type": "drink",
  "brief_description": "These red and yellow Jell-O shots inspired by the French 75 cocktail are an easy make-ahead treat for your Game Day party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour boiling water over lemon-flavored gelatin in a glass measuring cup; stir to combine. Stir in gin. Pour mixture into sixteen 2-ounce cups. Arrange cups in muffin tins, tilted to one side."
    },
    {
      "position": 2,
      "text": "Refrigerate until set, about 4 hours."
    },
    {
      "position": 3,
      "text": "Combine 1 1/4 cup sparkling wine and unflavored gelatin in a small pot. Let sit, about 3 minutes. Heat over low heat, stirring constantly, until gelatin is dissolved, 3 to 5 minutes. Add remaining 1/2 cup wine and food coloring; stir to combine."
    },
    {
      "position": 4,
      "text": "Remove muffin tins from refrigerator. Set cups upright; pour wine mixture over lemon mixture."
    },
    {
      "position": 5,
      "text": "Return to the refrigerator and chill until set, about 4 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

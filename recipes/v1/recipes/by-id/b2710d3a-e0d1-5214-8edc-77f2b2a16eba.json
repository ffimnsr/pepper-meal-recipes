  "id": "b2710d3a-e0d1-5214-8edc-77f2b2a16eba",
  "slug": "kalbi-korean-marinated-short-ribs",
  "name": "Kalbi (Korean Marinated Short Ribs)",
  "recipe_type": "dessert",
  "brief_description": "Korean ribs, also called kalbi, are marinated overnight in a sweet soy-sesame sauce with flavors of ginger, garlic, pear, and green onion.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place ribs in a bowl and cover with water; soak until water turns pink, about 1 hour. Drain and rinse in cold water."
    },
    {
      "position": 2,
      "text": "Combine soy sauce, Asian pear, onion, garlic, and ginger in a food processor. Pulse until smooth."
    },
    {
      "position": 3,
      "text": "Combine green onions, sesame oil, brown sugar, sesame seeds, honey, and black pepper in a large bowl; mix well. Add ribs and coat thoroughly with the marinade. Cover with plastic wrap and refrigerate 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Cook ribs on the grill until slightly charred and tender, about 4 minutes per side."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "crockpot-garlic-butter-steak-bites-recipe-11773897",
  "name": "Crockpot Garlic Butter Steak Bites",
  "recipe_type": "main",
  "brief_description": "These crockpot garlic butter steak bites are so, so easy, and the sauce is so, so good. Serve over mashed cauliflower or mashed potatoes, or with bread for dipping, so that you catch every drop.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place onions in the bottom of a slow cooker and sprinkle with au jus seasoning."
    },
    {
      "position": 2,
      "text": "Toss beef with steak seasoning and place on top of onions. Top with butter and garlic and pour broth around the edges."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low until meat is tender, about 6 hours."
    },
    {
      "position": 4,
      "text": "Stir in parsley just before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 360,

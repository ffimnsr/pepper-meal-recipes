  "id": "95c95515-9d12-5f9b-bb8c-12ff5e486b71",
  "slug": "shrimp-scampi",
  "name": "Shrimp Scampi",
  "recipe_type": "main",
  "brief_description": "This shrimp scampi recipe features flavorful saut\u00e9ed shrimp in a garlicky, buttery white wine sauce tossed with pasta for an easy weeknight dinner.",
  "cuisine": "European Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes. Drain; transfer pasta to a serving bowl and keep warm."
    },
    {
      "position": 3,
      "text": "Melt butter in a large saucepan over medium heat. Stir in shrimp and garlic; cook and stir until shrimp turns pink, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in white wine and pepper; bring to a boil. Cook and stir for 30 seconds."
    },
    {
      "position": 5,
      "text": "Pour shrimp with sauce over pasta in the serving bowl; toss well. Sprinkle with Parmesan cheese and parsley."
    },
    {
      "position": 6,
      "text": "Serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

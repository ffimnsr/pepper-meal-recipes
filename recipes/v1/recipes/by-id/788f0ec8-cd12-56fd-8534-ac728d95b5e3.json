  "id": "788f0ec8-cd12-56fd-8534-ac728d95b5e3",
  "slug": "chocolate-hummus",
  "name": "Chocolate Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Chocolate hummus is so deliciously chocolaty, and easy to make in just 10 minutes for a fudgy dessert dip to serve with graham crackers and fruit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate chips in a microwave-safe bowl and heat in the microwave until melted, 1 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Combine melted chocolate, garbanzo beans, cocoa powder, maple syrup, vanilla extract, and salt in the bowl of a food processor. Add almond milk, 1 tablespoon at a time, while blending to desired smoothness."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

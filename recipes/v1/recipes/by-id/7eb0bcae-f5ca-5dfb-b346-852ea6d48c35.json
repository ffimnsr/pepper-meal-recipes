  "id": "7eb0bcae-f5ca-5dfb-b346-852ea6d48c35",
  "slug": "easy-spanish-rice",
  "name": "Easy Spanish Rice",
  "recipe_type": "side",
  "brief_description": "A quick and easy recipe for Spanish rice is ready in under an hour and uses simple and flavorful ingredients for a family-pleasing side dish.",
  "cuisine": "Mexican Inspired Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place a pot over medium-heat heat; add oil and heat until oil shimmers slightly. Pour rice into hot oil, stirring constantly, until rice is golden to dark brown, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Mix water, tomatoes, onion, cilantro, and bouillon into rice. Bring to a boil, then turn off heat. Cover the pot tightly with a lid and let sit until liquid is absorbed, about 20 minutes. Adjust seasonings as needed."
    }
  ],

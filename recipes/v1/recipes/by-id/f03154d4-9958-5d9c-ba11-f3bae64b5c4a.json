  "id": "f03154d4-9958-5d9c-ba11-f3bae64b5c4a",
  "slug": "bryans-spicy-red-lentil-soup",
  "name": "Bryan's Spicy Red Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This spiced red lentil soup is cooked on the stovetop with tomatoes, spinach, onion, and spices, then pur\u00e9ed in a blender for a quick and easy meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Cook and stir onion in hot oil until golden brown. Season with salt and pepper. Mix in tomatoes, lentils, and spinach; pour in water. Season with basil, cardamom, cumin, cayenne pepper, and curry powder. Bring to a boil, reduce heat to low, and simmer for 25 minutes, stirring occasionally, until lentils are tender."
    },
    {
      "position": 2,
      "text": "Transfer soup to a blender and pur\u00e9e until smooth before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

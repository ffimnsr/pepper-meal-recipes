  "id": "7581e4a4-583a-56c1-a7c1-b7d823fbb65b",
  "slug": "crispy-buffalo-chicken-sandwiches-recipe-8646052",
  "name": "Crispy Buffalo Chicken Sandwiches",
  "recipe_type": "main",
  "brief_description": "This Buffalo chicken sandwich recipe delivers deliciously crispy fried chicken piled high in buns with Buffalo sauce, pickles, tomato, and lettuce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice each chicken breast horizontally into 2 thin fillets. Place 6 fillets in a resealable zip-top bag with buttermilk, 1 tablespoon Buffalo sauce, and garlic powder. Seal the bag and shake to blend ingredients and evenly coat the chicken. Refrigerate for at least 2 hours or overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine flour, poultry seasoning, and pepper in a shallow dish or pie plate. Blend with a fork or whisk."
    },
    {
      "position": 4,
      "text": "Remove chicken from the marinade and shake off excess. Dip chicken in the breading mixture until well and evenly coated on both sides. Discard the remaining marinade."
    },
    {
      "position": 5,
      "text": "Add enough oil to a large skillet so that it thickly coats the bottom and heat over medium-high heat until sizzling but not smoking. Place 2 chicken fillets in the skillet so they fit comfortably; do not overcrowd. Fry until crispy and golden brown, 2 to 3 minutes per side. Drain chicken on paper towels and repeat twice, adding more oil as necessary, to fry remaining chicken. Transfer chicken to a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, 8 to 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 7,
      "text": "Remove chicken from oven. Place a chicken fillet on the bottom half of a bun. Add Buffalo sauce to taste. Top with pickle slices, tomato, and lettuce. Spread ranch dressing on the inside of the top bun and place over the sandwich. Repeat to make remaining sandwiches."
    }
  ],
  "servings": 6,

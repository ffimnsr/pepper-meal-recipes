  "id": "e29698dd-fb79-5b40-8ecb-069d89b2b163",
  "slug": "buffalo-tempeh-tenders",
  "name": "Buffalo Tempeh Tenders",
  "recipe_type": "main",
  "brief_description": "Buffalo tempeh tenders are a vegetarian version of everyone's favorite Buffalo chicken tenders, just perfect for tailgating!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whip egg in a bowl for 30 seconds to 1 minute. Pour matzo meal into a separate bowl."
    },
    {
      "position": 2,
      "text": "Dip tempeh slices in egg, then coat in matzo meal to coat completely."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet to 350 degrees F (175 degrees C). Fry breaded tempeh until golden brown, 3 to 5 minutes. Transfer to a plate lined with paper towels to cool briefly."
    },
    {
      "position": 4,
      "text": "Transfer tempeh to a bowl and add enough Buffalo wing sauce to cover. Cover bowl and shake until evenly coated. Serve with blue cheese dressing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

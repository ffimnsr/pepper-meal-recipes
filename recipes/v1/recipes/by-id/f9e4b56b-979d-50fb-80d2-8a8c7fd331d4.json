  "id": "f9e4b56b-979d-50fb-80d2-8a8c7fd331d4",
  "slug": "salad-nicoise",
  "name": "Salad Ni\u00e7oise",
  "recipe_type": "salad",
  "brief_description": "Ni\u00e7oise salad is a fresh-tasting French salad packed with tuna, potatoes, green beans, hard-boiled eggs, and tomatoes for a delightful summer meal.",
  "cuisine": "European French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil; add potatoes and cook until tender but still firm, about 15 minutes. Drain and cool."
    },
    {
      "position": 3,
      "text": "Combine potatoes, green beans, tuna, onion, parsley, olives, and parsley in a large bowl; refrigerate for 2 to 4 hours."
    },
    {
      "position": 4,
      "text": "Toss greens with vinaigrette in a salad bowl; top with chilled potato mixture. Garnish with eggs, tomatoes, anchovies, and capers."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

  "id": "3dd73a96-42df-5355-8dd6-f7f621be370d",
  "slug": "roasted-turkey-legs",
  "name": "Roasted Turkey Legs",
  "recipe_type": "main",
  "brief_description": "These perfectly roasted turkey legs are tender and juicy with deliciously crispy skin. Great for a small Thanksgiving turkey dinner or any time of the year!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Rinse turkey legs and pat dry."
    },
    {
      "position": 3,
      "text": "Stand turkey legs upright (as if the turkey were standing). Press a knife downward into the deep tissue, creating 2 or 3 long pockets. Press a piece of celery into each opening. Pull back the skin on the legs, rub with butter, and season with a little salt. Put the skin back into place, rub with more butter, and season lightly with salt. Lay the turkey legs in a roasting pan. Pour in water."
    },
    {
      "position": 4,
      "text": "Roast uncovered until the legs are golden brown and the internal temperature is 180 degrees F (82 degrees C) when taken with a meat thermometer, about 1 \u00bd to 2 hours. Add more water if needed while roasting, and baste occasionally with the juices or melted butter."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

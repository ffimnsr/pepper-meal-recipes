  "id": "ed224dc6-f67a-5261-9054-db79b05bf6e4",
  "slug": "baked-pork-spring-rolls",
  "name": "Baked Pork Spring Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Try this pork spring roll recipe for delicious spring rolls filled with pork, vegetables, and spices. They're perfectly crunchy but not deep-fried!",
  "cuisine": "World Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Cook pork in a medium saucepan over medium-high heat until browned and crumbly, 5 to 7 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Transfer pork to a medium bowl. Mix in cabbage, carrot, green onions, ginger, oyster sauce, garlic, chile sauce, and sesame oil until well combined."
    },
    {
      "position": 4,
      "text": "Mix cornstarch and water together in a small bowl."
    },
    {
      "position": 5,
      "text": "Place about 1 tablespoon pork mixture into the center of a wrapper. Roll wrapper around pork, folding edges inward to close. Moisten fingers in the cornstarch and water mixture, and brush wrapper seams to seal. Repeat to make remaining spring rolls."
    },
    {
      "position": 6,
      "text": "Place spring rolls, seam-side down, onto the prepared baking sheet. Brush with vegetable oil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until hot and golden brown, about 20 minutes, turning halfway through if desired for crispier rolls."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

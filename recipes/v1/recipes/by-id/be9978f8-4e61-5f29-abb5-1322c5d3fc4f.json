  "id": "be9978f8-4e61-5f29-abb5-1322c5d3fc4f",
  "slug": "instant-pot-galbi-korean-style-short-ribs",
  "name": "Instant Pot Galbi (Korean-Style Short Ribs)",
  "recipe_type": "main",
  "brief_description": "This version of delicious Korean beef short ribs for your Instant Pot or other multi-cooker pressure cooker will have the ribs falling off the bone!",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Soak ribs in a large bowl of water for 1 hour."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine Asian pear, onion, garlic, and ginger in a blender or food processor; pur\u00e9e until smooth. Transfer mixture to a mixing bowl. Mix in 3/4 cup soy sauce, rice wine, water, brown sugar, 1 tablespoon sesame oil, and pepper to create a sauce. Set aside."
    },
    {
      "position": 3,
      "text": "Drain ribs and dry them well. Trim off excess fat. Place ribs in a multi-functional pressure cooker (such as Instant Pot), then add carrots and radishes. Pour Asian pear sauce on top. Close and lock the lid. Select Meat function according to manufacturer's instructions; set the timer for 35 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid. Transfer meat and vegetables to a plate and set aside."
    },
    {
      "position": 5,
      "text": "Select the Saut\u00e9 function on your Instant Pot. Stir in white sugar, remaining 1/4 cup soy sauce, and remaining 1 tablespoon sesame oil. Cook, stirring occasionally, until sugar has melted and sauce has thickened, about 10 minutes. Return ribs and vegetables to the pot; stir to coat with sauce."
    },
    {
      "position": 6,
      "text": "Garnish ribs and vegetables with green onions and sesame seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

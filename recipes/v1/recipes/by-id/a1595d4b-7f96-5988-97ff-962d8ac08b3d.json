  "id": "a1595d4b-7f96-5988-97ff-962d8ac08b3d",
  "slug": "easy-instant-pot-cranberry-sauce",
  "name": "Easy Instant Pot Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "This quick and easy homemade cranberry sauce is made just in minutes on your counter, not your stove!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, sugar, orange juice, orange zest, and salt in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove lid. Add cinnamon stick and select Saute function; cook until sauce thickens, 5 to 10 minutes. Remove and discard cinnamon stick."
    },
    {
      "position": 3,
      "text": "Blend sauce with an immersion blender for a smoother consistency. Let cool; sauce will continue to thicken naturally."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

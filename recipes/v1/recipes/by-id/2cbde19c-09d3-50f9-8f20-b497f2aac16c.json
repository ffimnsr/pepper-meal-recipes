  "id": "2cbde19c-09d3-50f9-8f20-b497f2aac16c",
  "slug": "smoked-salmon-canapes-recipe-11925168",
  "name": "Smoked Salmon Canapes",
  "recipe_type": "appetizer",
  "brief_description": "These smoked salmon canapes come together fast, and look incredibly elegant, plus they are big on flavor with crisp bagel chips topped with cream cheese, smoked salmon, and bright pops of color. With simple ingredients, it\u2019s wallet friendly!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange roasted garlic bagel chips on a serving platter."
    },
    {
      "position": 2,
      "text": "Fill a piping bag fitted with a star tip with the chive & onion cream cheese. Pipe a swirl of cream cheese onto each bagel chip."
    },
    {
      "position": 3,
      "text": "Roll slices of smoked salmon into rosette shapes and place on top the piped cream cheese."
    },
    {
      "position": 4,
      "text": "Place a small sprig of dill on each canap\u00e9. Add 2 capers per canap\u00e9. Place half a sweetie drop pepper for a pop of color."
    },
    {
      "position": 5,
      "text": "Serve immediately for best texture and appearance, or refrigerate, covered, for up to 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

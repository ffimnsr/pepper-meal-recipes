  "id": "affeb5a9-bb68-50da-8bca-f28e7d39379a",
  "slug": "yeast-waffles",
  "name": "Yeast Waffles",
  "recipe_type": "breakfast",
  "brief_description": "The batter for these tender and crunchy yeast waffles is mixed the night before, giving them a delicious tangy flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Warm milk in a small saucepan until it bubbles, then remove from heat."
    },
    {
      "position": 2,
      "text": "Dissolve yeast in warm water in a small bowl. Let stand until creamy, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Combine milk, yeast mixture, butter, salt, sugar, and flour in a large bowl. Mix thoroughly with an electric mixer until batter is smooth. Cover and let stand at room temperature overnight."
    },
    {
      "position": 4,
      "text": "The next morning, preheat a waffle iron."
    },
    {
      "position": 5,
      "text": "Stir beaten eggs and baking soda into batter; beat well."
    },
    {
      "position": 6,
      "text": "Spray the hot waffle iron with nonstick cooking spray. Pour mix onto waffle iron and cook until golden brown."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "e8eefeb1-96af-579d-b3d0-ef10a86f730b",
  "slug": "bacon-chicken-and-dumplings",
  "name": "Bacon Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "Chicken, potatoes, onion, chicken broth, cream and seasonings all simmered in bacon drippings with dumpling dough and crumbled bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside; reserve bacon drippings in skillet."
    },
    {
      "position": 2,
      "text": "Add potatoes, onion and chicken to bacon drippings and cook for 15 minutes, stirring occasionally. Pour in chicken broth; season with poultry seasoning, salt and pepper. Stir in corn, and simmer all together for 15 minutes."
    },
    {
      "position": 3,
      "text": "Pour in half-and-half and bring to a boil; add crumbled bacon. In a medium bowl, combine biscuit mix with milk and mix well (dough should be thick). Drop tablespoon sizes of dough into boiling mixture; reduce heat and simmer for 10 minutes uncovered, then another 10 minutes covered. (Note: Do not stir while simmering, or dumplings will break apart). Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

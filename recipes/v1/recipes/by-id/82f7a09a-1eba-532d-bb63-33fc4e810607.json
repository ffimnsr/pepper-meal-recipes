  "id": "82f7a09a-1eba-532d-bb63-33fc4e810607",
  "slug": "summer-fruit-salad-with-whipped-cream",
  "name": "Summer Fruit Salad with Whipped Cream",
  "recipe_type": "salad",
  "brief_description": "In this fruit salad with whipped cream, use raspberry-flavored liqueur to bring flavor to the nectarines, cherries, strawberries, and other fruits.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir water, 5 tablespoons sugar, 1/4 cup raspberry-flavored liqueur, and lemon juice together in a saucepan over medium-low heat. Bring mixture to a boil, reduce heat to low, and simmer, frequently stirring, until sugar dissolves completely, about 8 minutes. Set aside to cool."
    },
    {
      "position": 2,
      "text": "Mix nectarines, cherries, strawberries, raspberries, and blueberries in a large bowl. Pour cooled sugar mixture over fruit and toss gently to coat."
    },
    {
      "position": 3,
      "text": "Beat heavy whipping cream and 2 teaspoons sugar in a bowl with an electric hand mixer on high until stiff peaks form. Fold 1 teaspoon raspberry-flavored liqueur into whipped cream; spoon over fruit salad and sprinkle evenly with almonds."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4c5718f3-4aa4-583a-a93c-5a14b866bee8",
  "slug": "thai-sticky-black-rice-pudding",
  "name": "Thai Sticky Black Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "For this Thai sticky black rice pudding recipe, black rice is simmered with water, sugar, and coconut milk to make this lovely Asian dessert recipe.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, black rice, and salt in a saucepan; bring to a boil. Reduce heat; cover and simmer for 40 minutes."
    },
    {
      "position": 2,
      "text": "Stir in coconut milk and sugar; bring to a boil. Reduce heat; simmer, uncovered, until rice reaches a sticky consistency, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Cool. Stir and serve."
    }
  ],
  "servings": 4,

  "id": "b2cee521-189f-594b-87f0-56c853ecb3d6",
  "slug": "spicy-beef-bulgogi",
  "name": "Spicy Beef Bulgogi",
  "recipe_type": "main",
  "brief_description": "Flank steak is marinated in a fiery soy sauce and sesame marinade then grilled until slightly charred in this spicy take on Beef Bulgogi.",
  "cuisine": "Asian Inspired Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place flank steak slices in a shallow dish."
    },
    {
      "position": 2,
      "text": "Mix soy sauce, sriracha sauce, green onion, sugar, whole dried peppers, garlic, sesame seeds, sesame oil, ground cayenne, and black pepper together in a bowl. Pour over steak. Cover with plastic wrap and refrigerate to marinate, at least 1 hour but preferably overnight."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for high heat, and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove steak slices from marinade and grill on preheated grill until slightly charred and cooked through, 1 to 2 minutes per side."
    },
    {
      "position": 5,
      "text": "Simmer marinade in a wok or skillet over medium heat until thick and the consistency of gravy; pour over grilled steak."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "1d9c8caf-4c36-5893-80b1-b6f49490bd73",
  "slug": "pineapple-crisp",
  "name": "Pineapple Crisp",
  "recipe_type": "dessert",
  "brief_description": "Canned pineapple makes this versatile crisp dessert easy to make any time of year. Top this tropical dream with vanilla ice cream for even more richness!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread pineapple into a 9x9-inch square baking pan."
    },
    {
      "position": 3,
      "text": "Mix flour, sugar, baking powder, salt, and egg together in a medium bowl until well combined and crumbly."
    },
    {
      "position": 4,
      "text": "Spoon mixture evenly over pineapple. Pour melted butter over mixture, then sprinkle with cinnamon."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is lightly browned and filling is bubbly, 40 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot or cold. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

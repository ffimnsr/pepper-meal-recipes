  "id": "a38dd8de-1cb5-577f-b67b-f2c426d35b74",
  "slug": "margherita-baked-polenta-recipe-12005641",
  "name": "Margherita Baked Polenta",
  "recipe_type": "side",
  "brief_description": "This margherita baked polenta, fragrant with marinara sauce and basil pesto, is a delicious side dish with only 5 ingredients. For a meatier version, you can add Italian sausage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Coat a shallow baking dish with cooking spray; set aside."
    },
    {
      "position": 2,
      "text": "Add chicken stock to a large saucepan; bring to a roiling boil over medium-high heat. Stir in polenta and salt, reduce the heat, and simmer, stirring frequently with a long-handled spoon until soft and thickened, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in pesto; stir in 1 cup shredded mozzarella. Pour into the prepared pan, then smooth the top with the back of a spoon."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Remove and check for firmness. If it is still too soft in the middle, let it bake 10 minutes more."
    },
    {
      "position": 5,
      "text": "Remove polenta from the oven; spread marinara over the top, then sprinkle remaining mozzarella cheese on top. Return to the oven and bake until cheese is golden, about 15 minutes more."
    },
    {
      "position": 6,
      "text": "Let cool for 10 minutes. Slice and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

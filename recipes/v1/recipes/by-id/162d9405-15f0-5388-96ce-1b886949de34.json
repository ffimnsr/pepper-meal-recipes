  "id": "162d9405-15f0-5388-96ce-1b886949de34",
  "slug": "stout-slow-cooker-corned-beef-and-veggies",
  "name": "Slow Cooker Guinness Corned Beef and Veggies",
  "recipe_type": "dessert",
  "brief_description": "This slow cooker corned beef brisket is coated in brown sugar and cooked with Guinness, red and sweet potatoes, and cabbage for a warm winter meal.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 bottle Irish stout beer into a slow cooker."
    },
    {
      "position": 2,
      "text": "Rinse corned beef brisket and pat dry. Rub with brown sugar, including the bottom, and gently place brisket into the slow cooker with the stout beer."
    },
    {
      "position": 3,
      "text": "Arrange sweet potatoes, cabbage, onion, carrots, and red potatoes on and around the brisket in the slow cooker."
    },
    {
      "position": 4,
      "text": "Pour remaining 1/2 bottle Irish stout beer on and around brisket and vegetables to moisten the brown sugar."
    },
    {
      "position": 5,
      "text": "Cover the cooker and cook on Low until corned beef is tender, 6 to 8 hours. Allow brisket to stand 5 minutes before slicing."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 16,

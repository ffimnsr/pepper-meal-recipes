  "id": "6f609b2f-6c5c-55ed-b7bd-c64b230284a0",
  "slug": "popcorn-soup-corn-chowder",
  "name": "Popcorn Soup (Corn Chowder)",
  "recipe_type": "soup",
  "brief_description": "This popcorn soup will be a recipe that you won't lose. It is so good! Kids will love the idea of using popped corn instead of croutons on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Saut\u00e9 onion in butter with parsley flakes until onion is tender, about 8 minutes."
    },
    {
      "position": 2,
      "text": "Stir flour into onion mixture (mixture will be lumpy). Slowly stir in half-and-half until smooth and creamy. Add corn and cook until slightly thickened, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Season with salt and pepper. Ladle soup into bowls and garnish with popped corn."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

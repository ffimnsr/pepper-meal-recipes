  "id": "54c68d32-f676-53de-86fb-54cfdd94ad08",
  "slug": "greek-pumpkin-pie",
  "name": "Greek Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "A sweet filling of pumpkin, raisins, semolina, and spices is sandwiched between puff pastry sheets for unique version of pumpkin pie.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Grease a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Heat pumpkin puree in a skillet over medium heat, stirring occasionally, until most of the liquid has evaporated and puree is thick. Stir in sugar, raisins, semolina, cinnamon, cloves, and nutmeg. Remove from heat."
    },
    {
      "position": 4,
      "text": "Lay one puff pastry sheet into the prepared baking sheet. Spread the pumpkin mixture over the pastry and cover with the remaining pastry sheet. Brush the top of the puff pastry with beaten egg."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

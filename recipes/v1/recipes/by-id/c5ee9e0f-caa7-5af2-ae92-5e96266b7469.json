  "slug": "tzimmes-recipe-6582197",
  "name": "Tzimmes",
  "recipe_type": "dessert",
  "brief_description": "Tzimmes is a Jewish root vegetable side dish sweetened with honey, golden raisins, and orange juice. This recipe uses carrots to symbolized good luck.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a pan over medium-high heat. Add carrots, raisins, orange juice, honey, brown sugar, salt, and pepper; bring it to a boil. Reduce heat; cover and simmer until carrots are tender, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Uncover the pan, increase heat to high and cook until sauce has thickened, about 5 minutes. Sprinkle parsley on top before serving."
    }
  ],

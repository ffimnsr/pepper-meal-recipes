  "id": "23e562bd-733d-5f0a-bc72-3e9c880ac153",
  "slug": "grandma-betties-light-fruit-cake",
  "name": "Grandma Bettie's Light Fruit Cake",
  "recipe_type": "dessert",
  "brief_description": "Dried fruits, almonds, vanilla, and almond extracts unite in Grandma Bettie's light fruit cake recipe. Age it to enhance the seasonal scents and flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line two loaf pans with parchment paper."
    },
    {
      "position": 2,
      "text": "Toss cherries, raisins, pineapple, and almonds with 1 cup flour in a bowl."
    },
    {
      "position": 3,
      "text": "Beat sugar, butter, and eggs together in a separate bowl until creamy; sift in remaining 2 \u00bd cups flour, baking powder, and salt. Stir in extracts. Fold in dried fruit and almond mixture. Divide batter between the prepared pans, spreading evenly."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 1 \u00bd to 2 hours. Wrap cakes tightly; let age in a cool place for 2 to 4 weeks."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ff973fb3-ee6a-5a0f-b4bb-d91e74de1e4b",
  "slug": "roasted-butternut-squash-garlic-and-apple-soup",
  "name": "Roasted Butternut Squash, Garlic, and Apple Soup Recipe",
  "recipe_type": "appetizer",
  "brief_description": "Butternut squash, sweet potato, carrot, and garlic are roasted and added to onion, celery, apple, and vegetable broth in this autumnal soup recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Arrange butternut squash halves, carrot chunks, sweet potato chunks, and whole head garlic on the prepared baking sheet; drizzle with 1 1/2 tablespoons olive oil and season with rosemary, salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven for 20 minutes; flip sweet potato and carrot chunks. Continue roasting until vegetables are tender, 20 to 30 minutes more. Set aside to cool."
    },
    {
      "position": 4,
      "text": "Remove squash flesh from skin using a spoon. Cut sweet potato and carrot into small pieces. Squeeze roasted garlic from skin."
    },
    {
      "position": 5,
      "text": "Heat remaining 1 tablespoon olive oil in a large pot over medium heat; add celery and onion. Season with nutmeg and cayenne pepper; cook until celery and onion are tender, about 8 minutes. Add apples; cook and stir until apples begin to get hot, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Add vegetable broth and apple cider to the pot; bring just to a boil. Reduce heat to medium-low; simmer for 30 minutes."
    },
    {
      "position": 7,
      "text": "Add squash, sweet potato, carrot, and garlic to the pot. Pur\u00e9e with an immersion blender until smooth."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

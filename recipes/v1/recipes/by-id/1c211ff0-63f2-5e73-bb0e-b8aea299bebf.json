  "id": "1c211ff0-63f2-5e73-bb0e-b8aea299bebf",
  "slug": "italian-nachos-restaurant-style",
  "name": "Italian Nachos Restaurant-Style",
  "recipe_type": "appetizer",
  "brief_description": "Italian sausage, pepperoni, banana peppers, mozzarella, and pizza sauce make for great nachos.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat your oven's broiler."
    },
    {
      "position": 2,
      "text": "Crumble the sausage into a large skillet over medium heat. Cook and stir until no longer pink; drain."
    },
    {
      "position": 3,
      "text": "Arrange the tortilla chips on a baking sheet. Top with sausage, pepperoni, mozzarella cheese, and banana peppers. Place nachos under the preheated broiler until the cheese is melted, 5 to 8 minutes. Serve with pizza sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

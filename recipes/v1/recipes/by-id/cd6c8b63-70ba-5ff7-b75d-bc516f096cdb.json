  "id": "cd6c8b63-70ba-5ff7-b75d-bc516f096cdb",
  "slug": "cheese-and-lemon-blintzes",
  "name": "Cheese and Lemon Blintzes",
  "recipe_type": "dessert",
  "brief_description": "Blintzes make a traditional Shavuot holiday breakfast or dessert; these thin rolled pancakes are filled with cheese, raisins, and lemon peel.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, eggs, and salt together in a bowl until smooth and creamy."
    },
    {
      "position": 2,
      "text": "Lightly coat a small skillet with cooking spray. Pour 2 to 3 tablespoons of batter into the skillet. Swirl around until even and then place skillet over medium heat. Cook until sides begin to curl away, about 2 minutes. Turn and cook other side until lightly browned, about 1 minute more. Put onto a plate."
    },
    {
      "position": 3,
      "text": "Mix cream cheese, raisins, sugar, egg yolks, lemon peel, vanilla extract, and cinnamon together in a bowl to make the filling. Place 2 to 3 teaspoons of filling on each blintz and roll up like a small burrito."
    },
    {
      "position": 4,
      "text": "Melt 1 tablespoon butter in a skillet over medium heat. Cook the filled blintzes, turning carefully, until lightly browned, about 30 seconds each."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 4,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

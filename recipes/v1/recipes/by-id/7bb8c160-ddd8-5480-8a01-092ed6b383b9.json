  "slug": "gummy-candy",
  "name": "Gummy Candy",
  "recipe_type": "dessert",
  "brief_description": "Make this gummy candy recipe with the kids for a fun kitchen activity. Use candy molds if you have them, or use a baking sheet and small cookie cutters.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir water and both gelatins together in a saucepan until a dough forms. Warm over medium heat until melted."
    },
    {
      "position": 2,
      "text": "Pour mixture into candy molds or onto a rimmed baking sheet. Freeze until firm, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Unmold candies, or cut shapes with cookie cutters."
    }
  ],

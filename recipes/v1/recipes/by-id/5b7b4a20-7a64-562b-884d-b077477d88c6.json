  "slug": "sugar-free-frosting",
  "name": "Sugar-Free Frosting",
  "recipe_type": "dessert",
  "brief_description": "Versatile cream cheese frosting flavored with sugar-free instant pudding. It will frost one 9x13 or one 2 layer cake. Use any flavor of pudding mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, combine pudding mix and milk. Mix well and let stand until thickened."
    },
    {
      "position": 2,
      "text": "In a large bowl, beat cream cheese until smooth. Add pudding and mix well. Finally, fold in whipped topping."
    }
  ],

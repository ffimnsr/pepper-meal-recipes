  "id": "98280d4f-1e1b-5bb0-9e4e-0c5a68ffc881",
  "slug": "carrot-cake-bars",
  "name": "Easy Carrot Cake Bars",
  "recipe_type": "dessert",
  "brief_description": "This recipe for carrot bars is super moist and made with cinnamon and baby food carrots. Top with your favorite cream cheese frosting before cutting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10x15-inch jelly roll pan."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking soda, cinnamon, and salt in a large bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat together sugar, oil, and eggs in another large bowl until smooth."
    },
    {
      "position": 4,
      "text": "Mix in flour mixture until just combined. Stir in carrot baby food until incorporated."
    },
    {
      "position": 5,
      "text": "Spread batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Allow cake to cool completely on a wire rack before frosting and slicing."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

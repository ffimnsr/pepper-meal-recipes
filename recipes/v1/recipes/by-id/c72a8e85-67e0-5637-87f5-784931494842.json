  "id": "c72a8e85-67e0-5637-87f5-784931494842",
  "slug": "easy-pesto",
  "name": "Easy Pesto",
  "recipe_type": "side",
  "brief_description": "This is the easiest pesto recipe, using easy to find ingredients. It can be prepared in 2 minutes after you toast the almonds.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Place almonds on a cookie sheet, and bake for 10 minutes, or until lightly toasted."
    },
    {
      "position": 2,
      "text": "In a food processor, combine toasted almonds, garlic, basil, olive oil, nutmeg, salt and pepper. Process until a coarse paste is formed."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 2,

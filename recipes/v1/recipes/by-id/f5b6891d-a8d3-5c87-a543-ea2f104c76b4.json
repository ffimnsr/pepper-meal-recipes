  "id": "f5b6891d-a8d3-5c87-a543-ea2f104c76b4",
  "slug": "slow-cooker-baked-potatoes",
  "name": "Slow Cooker Baked Potatoes",
  "recipe_type": "side",
  "brief_description": "These crockpot baked potatoes are seasoned with olive oil and salt, wrapped in foil, then cooked in a slow cooker for 4 hours until soft and fluffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Prick potatoes with a fork several times, then rub with olive oil and season with salt."
    },
    {
      "position": 3,
      "text": "Wrap tightly in foil and place into the slow cooker."
    },
    {
      "position": 4,
      "text": "Cook until tender, on Low for 7 1/2 hours or on High for 4 1/2 to 5 hours."
    },
    {
      "position": 5,
      "text": "Serve with your choice of toppings and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 270,

  "id": "a831b0ad-3b19-534c-937a-a37e2dae4949",
  "slug": "fried-ice-cream",
  "name": "Fried Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This fried ice cream is made with balls of vanilla ice cream coated in egg white, rolled in corn flakes, then quickly fried for a heavenly dessert.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Scoop ice cream into eight 1/2-cup-sized balls."
    },
    {
      "position": 3,
      "text": "Place on a baking sheet and freeze until firm, about 1 hour."
    },
    {
      "position": 4,
      "text": "Combine cornflakes and cinnamon in a shallow dish. Beat egg whites until foamy in a separate bowl."
    },
    {
      "position": 5,
      "text": "Roll ice cream balls in egg whites."
    },
    {
      "position": 6,
      "text": "Then roll in crushed cornflakes, covering ice cream completely. Repeat if necessary. Freeze again until firm, about 3 hours."
    },
    {
      "position": 7,
      "text": "Heat oil in a deep-fryer or large, heavy saucepan to 375 degrees F (190 degrees C). Using a basket or slotted spoon, fry ice cream balls 1 or 2 at a time in hot oil until golden and crispy, 10 to 15 seconds."
    },
    {
      "position": 8,
      "text": "Drain quickly on paper towels and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

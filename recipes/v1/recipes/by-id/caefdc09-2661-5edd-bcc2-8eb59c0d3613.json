  "schema_version": 1,
  "id": "caefdc09-2661-5edd-bcc2-8eb59c0d3613",
  "slug": "pretzel-bratwurst-bites",
  "name": "Pretzel Bratwurst Bites",
  "recipe_type": "snack",
  "brief_description": "Stuff bratwurst slices into pretzel bites to create a fun party time snack made easy with pizza dough.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet or line with foil."
    },
    {
      "position": 2,
      "text": "Stir together water and baking soda in a large saucepan. Bring to a boil."
    },
    {
      "position": 3,
      "text": "Meanwhile, turn dough out onto a lightly floured surface. Roll into a 10x12-inch rectangle. Cut dough into twelve 1-inch strips. Wrap each strip tightly around a bratwurst in a spiral, pinching edges to seal and leaving about 1/2 inch of bratwurst peeking out of each end."
    },
    {
      "position": 4,
      "text": "Add 3 wrapped bratwurst at a time to the boiling water. Boil for about 30 seconds. Transfer bratwurst to the prepared baking sheet. Sprinkle with salt. Repeat with remaining wrapped bratwurst."
    },
    {
      "position": 5,
      "text": "Bake bratwursts until golden brown, about 12 minutes. Cut each bratwurst crosswise into thirds. Serve with mustard."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

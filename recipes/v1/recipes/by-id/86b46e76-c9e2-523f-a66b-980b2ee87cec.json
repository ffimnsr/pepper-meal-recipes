  "id": "86b46e76-c9e2-523f-a66b-980b2ee87cec",
  "slug": "sheet-pan-beef-fajitas",
  "name": "Sheet Pan Beef Fajitas",
  "recipe_type": "main",
  "brief_description": "Tender flank steak, onions, and peppers are cooked together on a sheet pan making your family fajita night a tasty, easy meal with hardly any cleanup!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a sheet pan with foil."
    },
    {
      "position": 2,
      "text": "Combine bell peppers, onion, 2 teaspoons oil, 3/4 teaspoon salt, 1/2 teaspoon chili powder, garlic powder, 1/4 teaspoon pepper, and 1/4 teaspoon cumin on the prepared pan; toss to coat. Spread veggie mixture around the sides of the pan creating a space in the center."
    },
    {
      "position": 3,
      "text": "Place flank steak in center of pan and brush with remaining 1 teaspoon oil. Sprinkle steak with remaining salt, chili powder, pepper, and cumin and rub to evenly coat."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until veggies are tender and browned around the edges and steak is beginning to firm and is hot and slightly pink in the center, 12 to 14 minutes, or to desired degree of doneness. An instant-read thermometer inserted into the center of the steak should read 140 degrees F (60 degrees C) for medium."
    },
    {
      "position": 5,
      "text": "Transfer steak to a cutting board and rest, 5 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Thinly slice steak and return to the sheet pan. Add lime wedges and serve with tortillas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f8c951d1-4da7-50fb-a9d3-b487e12999bc",
  "slug": "caldo-de-res-mexican-beef-soup",
  "name": "Caldo de Res (Mexican Beef Soup)",
  "recipe_type": "soup",
  "brief_description": "Caldo de res is a Mexican beef soup made with beef bones, cabbage, potatoes, corn, chayote, and cilantro for a deliciously hearty and satisfying meal.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut the meat from the beef bones into about \u00bd-inch pieces, leaving some on the bones."
    },
    {
      "position": 3,
      "text": "Heat a heavy soup pot over medium-high heat until very hot. Add oil, tilting the pan to coat the bottom. Add meat and bones and season with salt and pepper. Cook and stir until thoroughly browned."
    },
    {
      "position": 4,
      "text": "Add onion and cook until lightly browned; stir in broth and tomatoes. The liquid should cover the bones by \u00bd inch. If not, add some water to compensate."
    },
    {
      "position": 5,
      "text": "Reduce heat to low; simmer with the lid on loosely until meat is tender, about 1 hour."
    },
    {
      "position": 6,
      "text": "Pour in 4 cups water, and return to a simmer. Add carrots and 1/4 cup cilantro, and cook for 10 minutes. Stir in chayote, corn, and potato; simmer until vegetables are tender. Push cabbage wedges into soup; cook until tender, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Ladle soup into large bowls, including some meat, vegetables, and bones."
    },
    {
      "position": 8,
      "text": "Garnish with cilantro, jalape\u00f1os, and minced onion. Squeeze lime juice over soup and serve with radishes. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

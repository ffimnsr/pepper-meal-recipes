  "slug": "tasty-slow-cooker-pulled-pork",
  "name": "Tasty Slow Cooker Pulled Pork Recipe",
  "recipe_type": "soup",
  "brief_description": "This tasty slow cooker pulled pork recipe features simmered pork shoulder in a sweet and spicy ketchup, soup mix, brown sugar, and cider vinegar sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork roast in a slow cooker. Whisk ketchup, brown sugar, vinegar, onion soup mix, and hot sauce together in a bowl until well combined; pour over pork roast. Turn pork to coat completely."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 10 hours or High for 4 to 6 hours. Shred pork with 2 forks. Serve on hamburger buns."
    }
  ],
  "servings": 10,

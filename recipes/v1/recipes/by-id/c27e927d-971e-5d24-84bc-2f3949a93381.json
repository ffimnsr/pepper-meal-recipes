  "id": "c27e927d-971e-5d24-84bc-2f3949a93381",
  "slug": "easy-rib-eye-roast",
  "name": "Easy Rib Eye Roast",
  "recipe_type": "main",
  "brief_description": "Rib-eye roast on the bone is always a crowd-pleaser. This easy 5-ingredient recipe is a snap to prepare and carves up tender, juicy, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and garlic together in a small bowl until combined."
    },
    {
      "position": 3,
      "text": "Poke several holes in rib eye with a sharp knife. Rub butter mixture all over meat and season generously with salt and pepper. Place rib eye fat-side up in a roasting pan."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven for 20 minutes to develop a crust."
    },
    {
      "position": 5,
      "text": "Reduce heat to 325 degrees F (165 degrees C) and continue cooking until rib eye is reddish-pink and juicy in the center, 1 \u00bd to 2 hours. An instant-read thermometer inserted into the center will read 145 degrees F (63 degrees C) for medium. Let rest before slicing."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "8cf011c8-4639-5cc2-957e-28d771496dd6",
  "slug": "grandpas-tomato-gravy",
  "name": "Grandpa\u2019s Tomato Gravy",
  "recipe_type": "side",
  "brief_description": "Grandpa\u2019s simple tomato gravy recipe can be served over rice, pasta, biscuits, or grits. But it is really a sauce (because it does not contain flour).",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a Dutch oven over medium heat, stirring occasionally, until fat starts to render, about 2 minutes. Add onion; cook and stir until onion softened and turned translucent, about 5 minutes. Stir in diced tomatoes and tomato sauce; season with sugar and black pepper. Simmer until sauce is reduced by at least one-fourth and up to one-third, 30 to 45 minutes. Stir in butter just before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,

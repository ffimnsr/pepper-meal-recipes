{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a62b08c1-a6dc-5b7f-9218-6af78f8a5944",
  "slug": "homemade-orecchiette-pasta",
  "name": "Homemade Orecchiette Pasta",
  "recipe_type": "main",
  "brief_description": "This homemade orecchiette recipe lets you enjoy the pasta of Apulia (Puglia), the heel of Italy. Their name means \"little ear\" and describes their shape. This recipe explains how to make them from scratch.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together semolina flour and salt in a large bowl or on a marble work surface. Form a well in the center. Pour water into the well a little at a time, mixing it in with flour mixture. Add as much water as needed to make a sticky but compact dough."
    },
    {
      "position": 2,
      "text": "Knead dough with your hands by flattening, stretching, and folding the top towards the center. Turn 45 degrees and repeat until dough is elastic and smooth but not too soft, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Shape dough into a ball. Place in a bowl and cover with plastic wrap. Let rest at room temperature for about 30 minutes."
    },
    {
      "position": 4,
      "text": "Dust a work surface with semolina flour. Roll out a portion of dough to make a rope, about 1/3-inch thick; keep remaining dough covered to prevent drying out. Cut rope into 1/3-inch-thick pieces."
    },
    {
      "position": 5,
      "text": "Working with one dough piece at a time, carefully hold one side with your index finger. Use a knife with a rounded tip in your other hand to gently drag dough towards you. Lift the knife at the end to get a thicker edge and thinner center. Press disk of dough gently against your thumb to curve inward. Repeat with remaining dough."
    },
    {
      "position": 6,
      "text": "Transfer orecchiette onto a floured surface in a single layer; sprinkle with more semolina flour. Let dry before cooking, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

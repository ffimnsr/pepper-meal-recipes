  "id": "cc95bfa0-6743-52f8-a2d0-0d2480db45b0",
  "slug": "easy-beef-stroganoff",
  "name": "Easy Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "Make this easy recipe for a tart stroganoff sauce full of beef, mushrooms, and onions served over tender egg noodles. It's comfort food at its best!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium heat. Add mushrooms and onion; cook and stir until soft, about 5 minutes. Transfer to a bowl; do not clean the skillet."
    },
    {
      "position": 3,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain."
    },
    {
      "position": 4,
      "text": "While the noodles are cooking, melt remaining 2 tablespoons butter in the skillet over medium heat. Add ground beef and saut\u00e9 until browned and crumbly, 7 to 9 minutes."
    },
    {
      "position": 5,
      "text": "Mix in flour and cook for 1 minute."
    },
    {
      "position": 6,
      "text": "Stir in broth and cook until slightly thickened, 2 to 4 minutes."
    },
    {
      "position": 7,
      "text": "Add mushroom mixture, then stir in sour cream, salt, and pepper. Cook, stirring occasionally until sauce is hot, 2 to 3 minutes; do not boil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

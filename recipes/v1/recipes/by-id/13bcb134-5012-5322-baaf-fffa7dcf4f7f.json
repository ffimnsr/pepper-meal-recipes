  "id": "13bcb134-5012-5322-baaf-fffa7dcf4f7f",
  "slug": "beef-kelaguen",
  "name": "Beef Kelaguen",
  "recipe_type": "drink",
  "brief_description": "This kelaguen (beef ceviche), is a family recipe from Guam. The acidity in the lemon juice \"cooks\" thin slices of raw flank steak, ready in about an hour.",
  "cuisine": "Oceanic",
  "instructions": [
    {
      "position": 1,
      "text": "Pour lemon juice, soy sauce, and Tabasco into a large, glass bowl. Stir in beef and green onions. Add additional lemon juice if needed to cover the beef."
    },
    {
      "position": 2,
      "text": "Cover the bowl with plastic wrap, and allow to rest at room temperature for 1 hour, until meat turns a grayish-brown color and appears cooked."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

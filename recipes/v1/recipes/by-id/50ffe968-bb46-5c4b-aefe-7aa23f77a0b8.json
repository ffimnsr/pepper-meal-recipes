  "id": "50ffe968-bb46-5c4b-aefe-7aa23f77a0b8",
  "slug": "sous-vide-salmon",
  "name": "Sous Vide Salmon",
  "recipe_type": "main",
  "brief_description": "Salmon comes out wonderfully moist and flavorful in this recipe for sous vide salmon. If you like your salmon more tender, lower the cooking temperature.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with warm water. Attach a sous vide precision cooker to the pot and set temperature to 125 degrees F (51 degrees C)."
    },
    {
      "position": 2,
      "text": "Place shallot into a plastic bag and lay salmon on top, skin-side down. Use a vacuum sealer to remove air and seal the bag, or use the water-immersion method. Once water temperature has reached 125 degrees F (51\u00b0C), add the bag to the pot; set the timer for 45 minutes."
    },
    {
      "position": 3,
      "text": "Remove the bag from the pot when the timer goes off. Remove salmon and pat dry. Remove and discard shallot."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a nonstick or cast iron skillet over medium heat until it shimmers. Add salmon, skin-side down, and sear for 1 1/2 minutes. Flip and sear for an additional 1 1/2 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "b72ed98f-f1d9-57ea-83df-af4b148a84eb",
  "slug": "baked-pancakes",
  "name": "Baked Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Oven-baked pancakes, or Dutch babies, are an easy and delicious option for any meal. Their light, fluffy texture makes it my go-to for most weekend brunches.",
  "cuisine": "American German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butter in a 9-inch pie dish. Place in the preheating oven until butter is melted, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk together flour, milk, eggs, white sugar, and salt in a bowl. Pour mixture into butter in dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the edges are light brown, and a toothpick inserted into the center comes out clean, 20 to 24 minutes."
    },
    {
      "position": 5,
      "text": "Sprinkle lemon juice over pancake and dust with confectioners' sugar. Serve warm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

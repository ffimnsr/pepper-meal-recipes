  "id": "6ac8209a-2fe5-5990-9897-27ef937ab29f",
  "slug": "mango-quesadillas",
  "name": "Mango Quesadillas",
  "recipe_type": "main",
  "brief_description": "The flavor and texture of mango goes well with black beans and Cheddar cheese in this easy main dish. The recipe uses vegetarian chicken substitute, but real chicken would work just as well.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place the beans in a saucepan over medium heat, and cook 5 minutes. Partially mash with a potato masher or large spoon. Reduce heat to low, and keep warm until ready to serve."
    },
    {
      "position": 2,
      "text": "Heat the oil in a skillet over medium heat. Stir in the onion and red bell pepper. Season with chili powder, cayenne pepper, oregano, and basil. Cook and stir until vegetables are tender. Mix in mango and vegetarian chicken strips, and continue cooking about 2 minutes, until vegetarian chicken is heated through."
    },
    {
      "position": 3,
      "text": "In a separate skillet over medium heat, place the tortillas one at a time until soft and warm, about 2 minutes per side. Spread warm tortillas with equal amounts of the the black beans, mango mixture, Cheddar cheese, arugula, and jalapenos. Fold tortillas over the filling and top with salsa to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

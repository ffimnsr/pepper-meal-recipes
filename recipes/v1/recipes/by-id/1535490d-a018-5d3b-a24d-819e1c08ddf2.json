  "id": "1535490d-a018-5d3b-a24d-819e1c08ddf2",
  "slug": "glossy-royal-icing",
  "name": "Glossy Royal Icing",
  "recipe_type": "dessert",
  "brief_description": "This royal icing recipe with corn syrup is pure white, hardens nicely, and sets up glossy, perfect for making professional-looking cakes and cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together warm water, corn syrup, and almond extract in a small bowl until corn syrup and extract have dissolved."
    },
    {
      "position": 2,
      "text": "Place confectioners' sugar into a large bowl and pour in corn syrup mixture. Beat with an electric mixer on low speed until royal icing is smooth. Store in a lidded container for up to a week; stir thoroughly before using."
    }
  ],

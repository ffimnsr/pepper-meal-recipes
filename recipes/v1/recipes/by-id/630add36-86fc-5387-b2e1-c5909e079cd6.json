  "id": "630add36-86fc-5387-b2e1-c5909e079cd6",
  "slug": "slow-cooker-rice-pudding",
  "name": "Slow Cooker Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This creamy crockpot rice pudding, enriched with eggs and vanilla extract, is easy to make in a slow cooker for a classic comforting dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir 4 cups milk, sugar, and rice together in a slow cooker until sugar dissolves. Add margarine, cover, and cook on High for 2 1/2 hours."
    },
    {
      "position": 2,
      "text": "Whisk egg, 2 tablespoons milk, vanilla, almond extract, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Pour a small amount hot rice mixture into egg mixture, whisking quickly so egg doesn't cook. Pour mixture back into the slow cooker and whisk until combined. Continue to cook on High until creamy, about 15 more minutes."
    },
    {
      "position": 4,
      "text": "Transfer pudding to a glass baking dish. Cover with plastic wrap leaving two corners uncovered to vent, and refrigerate until chilled completely, at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 10,

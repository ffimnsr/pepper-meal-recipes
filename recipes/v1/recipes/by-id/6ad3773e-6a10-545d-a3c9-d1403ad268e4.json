  "slug": "cranberry-relish-with-grand-marnier-and-pecans",
  "name": "Cranberry Relish with Grand Marnier and Pecans",
  "recipe_type": "side",
  "brief_description": "Once you make this Grand Marnier cranberry relish with orange zest and toasted pecans, you might decide never to buy canned cranberry sauce again!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring sugar, orange liqueur, orange juice, ginger, and orange zest to a boil in a saucepan over medium-high heat; stir until sugar has dissolved."
    },
    {
      "position": 2,
      "text": "Add cranberries; cook and stir until they pop, about 5 minutes. Stir in pecans, pour into a bowl, and refrigerate for several hours until cold."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

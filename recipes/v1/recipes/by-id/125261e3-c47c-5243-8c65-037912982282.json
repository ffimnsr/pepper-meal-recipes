  "id": "125261e3-c47c-5243-8c65-037912982282",
  "slug": "tri-tip-bulgogi-recipe-8696823",
  "name": "Tri-Tip Bulgogi",
  "recipe_type": "main",
  "brief_description": "This bulgogi is a great dish to make with beef tri-tip. An acidic marinade and slicing thinly across the grain of the meat turn this tough cut tender.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pear, onion, ginger, 1/2 cup soy sauce, and 2 garlic cloves in the jar of a blender or food processor and pulse until marinade is smooth. Place tri-tip into a resealable plastic bag with the marinade. Refrigerate for at least 4 hours or up to overnight."
    },
    {
      "position": 2,
      "text": "Slice tri-tip thinly against the grain."
    },
    {
      "position": 3,
      "text": "Add grapeseed oil to a skillet over medium-high heat. When skillet is hot, sear meat until nice and charred, about 1 minute on each side. Remove meat from pan."
    },
    {
      "position": 4,
      "text": "Add gochujang, rice vinegar, soy sauce, white sugar, minced garlic, minced ginger, and 1/2 cup water to the skillet. Stir until blended and smooth. Simmer sauce for 3 minutes and return meat back to the pan; simmer meat in sauce until heated through, 1 to 2 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Remove bulgogi from heat, drizzle with sesame oil, and sprinkle with sesame seeds. Heat rice in the microwave for 90 seconds, or according to package directions."
    },
    {
      "position": 6,
      "text": "Plate bulgogi with rice, kimchi, and steamed veggies. Garnish with sliced scallions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

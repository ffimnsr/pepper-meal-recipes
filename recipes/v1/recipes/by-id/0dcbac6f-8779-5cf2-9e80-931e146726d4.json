  "id": "0dcbac6f-8779-5cf2-9e80-931e146726d4",
  "slug": "spanish-potato-and-chorizo-soup-recipe-11927305",
  "name": "Spanish Potato and Chorizo Soup",
  "recipe_type": "soup",
  "brief_description": "In this Spanish potato and chorizo soup, smoky paprika, spicy chorizo, and baby potatoes combine with vegetables and seasonings in a creamy broth. It's a humble soup with lots of flavor.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a 4-quart Dutch oven or large pot over medium heat."
    },
    {
      "position": 2,
      "text": "When the oil shimmers, add chorizo and cook until just beginning to brown, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in onions, carrots, and bell pepper and cook, stirring, until vegetables begin to soften, 2 to 3 minutes. Add garlic, Spanish paprika, red pepper flakes, oregano, cumin, salt, and pepper, and cook, stirring, until garlic is fragrant, about 30 seconds more."
    },
    {
      "position": 4,
      "text": "Add tomato paste and stir until well distributed, then stir in flour until evenly incorporated. Stir in broth and add potatoes."
    },
    {
      "position": 5,
      "text": "Bring to a boil, cover, and reduce heat to medium-low. Simmer until potatoes are fork-tender, about 15 minutes. Stir in cream and parsley and turn off the heat."
    },
    {
      "position": 6,
      "text": "Let stand, covered, about 3 minutes. Season to taste with salt and pepper. Serve warm; garnish with parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

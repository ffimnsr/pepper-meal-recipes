  "schema_version": 1,
  "id": "1b05cd34-f65f-57f2-be27-fd0f46d95fe0",
  "slug": "cheesesteak-egg-rolls",
  "name": "Cheesesteak Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "This mouthwatering appetizer combines cheesesteak and egg rolls. Golden, crispy wrappers are filled with a delicious cheesy mixture of steak and onion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon vegetable oil in a large skillet over medium heat. Cook and stir onion in hot oil until onion is translucent, about 5 minutes. Break frozen steak pieces into the skillet; cook and stir until steak is no longer pink, about 10 minutes. Remove from heat and set aside."
    },
    {
      "position": 2,
      "text": "Arrange 8 egg roll wrappers on a flat surface; place a half cheese slice on each one. Layer an equal amount of steak-onion mixture on top of each cheese slice. Roll up wrappers according to package directions and seal edges, wetting with water if necessary."
    },
    {
      "position": 3,
      "text": "Heat 1 inch oil in a deep fryer or large skillet to 375 degrees F (190 degrees C). Working in batches, fry egg rolls in hot oil until golden brown on all sides, about 5 minutes. Remove; drain on paper towels."
    },
    {
      "position": 4,
      "text": "Serve warm egg rolls with ketchup for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

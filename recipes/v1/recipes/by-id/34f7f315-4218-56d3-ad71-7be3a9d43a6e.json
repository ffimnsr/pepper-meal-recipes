  "id": "34f7f315-4218-56d3-ad71-7be3a9d43a6e",
  "slug": "djs-sliders",
  "name": "DJ's Sliders",
  "recipe_type": "main",
  "brief_description": "Quick and easy to bake or grill, these Creole-seasoned sliders ooze with Cheddar cheese and mayonnaise.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine Cheddar cheese and mayonnaise; refrigerate."
    },
    {
      "position": 3,
      "text": "Mix ground beef, salt, pepper, Creole seasoning, onion powder, and garlic powder together. Form mixture into 12 slider patties; place on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake patties in the preheated oven, flipping once, for about 15 minutes. Remove from oven and top each patty with 1 tablespoon of the cheese-mayonnaise mixture. Continue baking until cheese has melted, 1 to 2 minutes more. Serve on slider buns."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

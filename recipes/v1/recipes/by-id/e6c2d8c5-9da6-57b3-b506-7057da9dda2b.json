{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e6c2d8c5-9da6-57b3-b506-7057da9dda2b",
  "slug": "fortune-cookies-i",
  "name": "Fortune Cookies",
  "recipe_type": "dessert",
  "brief_description": "Fortunes cookies are fun to make at home for Chinese New Year or other parties. Plus, you get to write your own fortune with these homemade cookies!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C). Generously grease two cookie sheets with cooking spray."
    },
    {
      "position": 2,
      "text": "Write fortunes on strips of paper about 4 inches long and 1/2 inch wide."
    },
    {
      "position": 3,
      "text": "Mix egg white and vanilla together in a bowl until foamy but not stiff. Sift in flour, sugar, and salt; stir until blended."
    },
    {
      "position": 4,
      "text": "Drop two spoonfuls of batter at least 4 inches apart onto one prepared cookie sheet. Tilt the sheet to spread batter into 3-inch-diameter circles."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cookies are pale in the center and golden on the outer 1/2-inch edge, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Remove cookies from the oven. Quickly lift one cookie with a wide spatula and place upside down onto a wooden board. Place a fortune on the cookie (close to the middle) and fold cookie in half around the paper."
    },
    {
      "position": 7,
      "text": "Place the folded edge over the rim of a measuring cup or coffee mug and pull the pointed edges down, one inside the cup and one outside. Place cookie into a muffin tin or egg carton to hold its shape as it cools. Repeat to form and fill the second cookie."
    },
    {
      "position": 8,
      "text": "While the first batch is baking in Step 5, repeat Step 4 to form two more cookies on the second cookie sheet. When you are shaping the first batch of baked cookies in Step 6, bake the second batch. Repeat until all cookies are baked and shaped."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 55,

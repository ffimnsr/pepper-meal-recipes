  "id": "387f5117-94ef-5b7f-810d-944d920b6fa3",
  "slug": "green-chile-frittata",
  "name": "Green Chile Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This cottage cheese frittata recipe is great for either brunch or breakfast. Make it a day ahead and reheat in the microwave if you want to serve it for an early morning breakfast.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix eggs, flour, baking powder, and salt together in a large bowl. Stir in cottage cheese, Cheddar cheese, chile peppers, and melted butter. Pour into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the heat to 325 degrees F (165 degrees C), and continue baking for 35 to 40 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and allow to cool slightly before cutting and serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "7318b2d8-2b28-5280-b20c-b63652095d22",
  "slug": "black-pepper-chicken-recipe-8382732",
  "name": "Black Pepper Chicken",
  "recipe_type": "main",
  "brief_description": "This black pepper chicken tastes just like the Chinese takeout favorite, golden-fried chicken with peppers in a soy, wine, and black pepper sauce, and served over white rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather Ingredients."
    },
    {
      "position": 2,
      "text": "For Chicken Coating, whisk together cornstarch, soy sauce, Shaoxing wine, and pepper in a large bowl. Mixture will be quite thick. Add chicken pieces to bowl; stir to coat chicken. Let stand at room temperature for 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, for Black Pepper Sauce, whisk together chicken broth, oyster sauce, Shaoxing wine, soy sauce, water, cornstarch, and pepper in a medium bowl."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons vegetable oil in a 12-inch skillet over medium-high heat. Add half the chicken. Cook and stir until lightly browned and no longer pink, about 5 minutes. Transfer chicken to a plate; set aside. Repeat with remaining chicken. Remove chicken from skillet."
    },
    {
      "position": 5,
      "text": "Add remaining 1 tablespoon vegetable oil to skillet. Stir in minced garlic and ginger. Cook and stir until fragrant, about 30 seconds. Stir in bell pepper and onion. Cook and stir until crisp-tender, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Pour in Black Pepper Sauce and cook until sauce has thickened, 2 to 3 minutes. Return cooked chicken to skillet. Cook and stir until all ingredients are coated with sauce. Serve immediately over cooked white rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0971f868-b954-5139-9e3b-433d35ff4ff2",
  "slug": "chicken-fajita-burrito",
  "name": "Chicken Fajita Burrito",
  "recipe_type": null,
  "brief_description": "This burrito adds zesty fajita-seasoned chicken and peppers to your favorite burrito fillings, bringing the best of two dishes together.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken, onion, bell pepper, oil, lime juice, and fajita seasoning in a resealable plastic bag. Seal the bag and squeeze to ensure all ingredients are combined and well-coated; place in the refrigerator to marinate for 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a sheet pan with foil. Spread fajita mixture onto sheet pan in a single layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until chicken juices run clear, about 25 minutes. An instant-read thermometer inserted into the chicken strips should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Wrap tortillas in a damp paper towel, and warm in the microwave until soft and pliable, about 30 seconds. To assemble burritos, spread 1/4 of each of the refried beans, cheese, rice, fajita mixture, sour cream, and guacamole in a line across the middle of each tortilla."
    },
    {
      "position": 5,
      "text": "Fold opposing sides of the tortilla in, overlapping the filling. Roll the bottom edge up tightly around the filling, then roll the burrito away from you, keeping the sides folded in."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "56ef48de-22b3-51fe-a2be-a20f414f18d4",
  "slug": "super-easy-cream-cheese-flan",
  "name": "Super Easy Cream Cheese Flan",
  "recipe_type": "dessert",
  "brief_description": "A creamy custard is poured over caramelized sugar in this super easy cream cheese flan recipe that makes a great make-ahead dessert.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat together sugar and water in a small saucepan over medium heat, stirring occasionally, until sugar dissolves into a light brown caramel, 8 to 10 minutes. Pour into a round glass baking dish."
    },
    {
      "position": 3,
      "text": "Place condensed milk, evaporated milk, eggs, cream cheese, and vanilla in a blender; blend into a smooth custard. Pour over caramelized sugar in the baking dish."
    },
    {
      "position": 4,
      "text": "Place the baking dish in a deep baking pan. Pour in enough water to reach halfway up the sides of the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until custard is set and top is light brown, about 1 hour."
    },
    {
      "position": 6,
      "text": "Carefully transfer the baking dish to a wire rack to cool to room temperature. Cover the dish with plastic wrap and refrigerate until cold, 3 to 4 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,

  "id": "27f62129-2339-5698-8d4b-399dd42c4882",
  "slug": "d-best-chicken-n-dumplings",
  "name": "D' Best Chicken N' Dumplings",
  "recipe_type": "soup",
  "brief_description": "This is the best recipe for OLD TIME TASTE, DOWN HOME COOKING chicken and dumplings. For some of us that like getting our hands dirty when cooking, you will love this recipe. Old fashioned, hands on experience.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, sift flour, baking soda and salt. Cut in shortening until mixture resembles coarse crumbs. Stir in water until mixture forms a ball. Divide dough in half and shape into balls. Wrap in plastic and refrigerate for 2 hours or overnight."
    },
    {
      "position": 2,
      "text": "Remove the skin from the breast, thigh and back of the chicken, but leave it on the legs and wings. Season chicken with seasoning salt, and place in a large stock pot. Pour in water. Add onion, celery and margarine. Bring to a boil, then reduce heat to simmer. Cook for about 1 1/2 hours, until chicken falls off the bone."
    },
    {
      "position": 3,
      "text": "On a lightly floured surface, roll one ball of dough to about 1/8 inch thick. Cut into 2 inch squares. Drop into simmering broth, and let cook for about 2 minutes. Stir gently to prevent sticking; add more water if needed. Season broth while dumplings are cooking with salt, pepper and poultry seasoning. Simmer for about 15 minutes, or until dumplings are cooked through."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

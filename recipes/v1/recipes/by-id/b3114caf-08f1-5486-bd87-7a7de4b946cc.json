  "id": "b3114caf-08f1-5486-bd87-7a7de4b946cc",
  "slug": "instant-gingerbread-hot-chocolate-recipe-8418431",
  "name": "Instant Gingerbread Hot Chocolate",
  "recipe_type": "breakfast",
  "brief_description": "This instant gingerbread hot chocolate puts a seasonal twist on everybody's favorite hot cold weather drink. With gingerbread spices and a hint of molasses flavor from brown sugar, it makes a very special edible gift.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add cocoa, white sugar, brown sugar, ginger, cinnamon, cloves, salt, and cayenne to a bowl, and whisk thoroughly to combine."
    },
    {
      "position": 2,
      "text": "Store in an airtight container until needed. Be sure to stir very thoroughly before each use."
    },
    {
      "position": 3,
      "text": "To make hot chocolate, heat milk over medium heat until it almost starts to simmer. Whisk in 2 tablespoons of instant gingerbread hot chocolate mix per 1 cup milk."
    },
    {
      "position": 4,
      "text": "Once everything is mixed together and dissolved, and the milk is piping hot, transfer into mugs and enjoy."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

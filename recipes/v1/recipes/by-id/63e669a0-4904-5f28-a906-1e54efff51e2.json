  "id": "63e669a0-4904-5f28-a906-1e54efff51e2",
  "slug": "crab-and-lobster-stuffed-mushrooms",
  "name": "Crab and Lobster Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These delicious appetizer mushrooms are stuffed with chopped crabmeat, lobster, garlic, and seasoned croutons, then topped with mozzarella and baked.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Brush a large baking sheet with about 1/4 cup melted butter."
    },
    {
      "position": 2,
      "text": "Arrange mushroom caps, gill sides up, in a single layer on baking sheet."
    },
    {
      "position": 3,
      "text": "Combine lobster, 1 cup mozzarella cheese, crushed croutons, remaining 1/2 cup melted butter, crabmeat, and garlic. Spoon into mushroom caps."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned on top, 10 to 12 minutes. Sprinkle with remaining 1/4 cup mozzarella cheese; serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

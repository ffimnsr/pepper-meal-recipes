  "id": "800f3eb1-6110-54c3-8ee3-f875d5ab8972",
  "slug": "how-to-make-japanese-rice-balls-onigiri",
  "name": "How to Make Japanese Rice Balls (Onigiri)",
  "recipe_type": "appetizer",
  "brief_description": "Japanese rice balls filled with flaked salmon are a delicious meal or snack. You can customize the fillings and even make them with fried rice.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Pour rice into a bowl and rinse under running water. Give it a good scrubbing with your hands; rinse off the starch and drain."
    },
    {
      "position": 2,
      "text": "Place rice in a small pot with water and salt. Cover with a tight-fitting lid and turn the burner to high. Cook for 2 minutes, then reduce heat to low and cook for 20 minutes. Turn off the heat and let sit with the lid on to fully absorb the moisture for 10 minutes. Transfer rice to a cutting board to cool slightly."
    },
    {
      "position": 3,
      "text": "Season flaked salmon with soy sauce."
    },
    {
      "position": 4,
      "text": "Flatten cooled rice into a rectangle and divide into 6 portions. Place a portion of salmon on top of each section of rice. Wet your hands and pick up a section of rice. Gently cup the rice around the filling; keep cupping until filling is completely covered and you've formed a ball. Mold the rice ball into a triangle shape by placing the bottom on one palm and flattening the back with your fingers. Bend the other hand and press the rice into a triangle on your palm, flattening the front side if needed. Place a strip of nori on the bottom of the onigiri to make it easier to pick up."
    },
    {
      "position": 5,
      "text": "Repeat to make remaining rice balls, wetting your hands as necessary to prevent the rice from sticking."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

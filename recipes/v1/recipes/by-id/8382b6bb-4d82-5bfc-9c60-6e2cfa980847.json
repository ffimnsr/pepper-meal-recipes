  "schema_version": 1,
  "id": "8382b6bb-4d82-5bfc-9c60-6e2cfa980847",
  "slug": "ricotta-gnocchi-with-fresh-peas-and-mushrooms",
  "name": "Ricotta Gnocchi with Fresh Peas and Mushrooms",
  "recipe_type": "side",
  "brief_description": "The taste of spring comes to life in this light and delicious ricotta gnocchi recipe with fresh peas and mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Process ricotta, eggs, 1 teaspoon salt, pepper, and nutmeg in a food processor until smooth. Add flour and blend until a smooth, semi-stiff batter forms. Transfer gnocchi batter to a bowl, cover the bowl with plastic wrap, and refrigerate for 1 hour."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over medium-high heat. Saute mushrooms in hot oil until soft and fragrant, 3 to 5 minutes. Add garlic and saute for 1 minute. Add vegetable broth, bring to a boil and reduce to a simmer; stir in peas. Cook until peas are soft, 3 to 5 minutes. Season with salt and pepper to taste."
    },
    {
      "position": 3,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil."
    },
    {
      "position": 4,
      "text": "Working in batches, drop spoonfuls of ricotta batter into boiling water. Bring water back to a boil and cook for 3 minutes. Remove gnocchi to ice water to stop the cooking process, then drain and reserve. Repeat with remaining batter."
    },
    {
      "position": 5,
      "text": "Combine gnocchi and mushroom sauce in a saucepan and cook until heated through, 2 to 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

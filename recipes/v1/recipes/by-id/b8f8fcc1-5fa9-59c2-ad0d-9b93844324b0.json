  "id": "b8f8fcc1-5fa9-59c2-ad0d-9b93844324b0",
  "slug": "glazed-lemon-zucchini-bread",
  "name": "Glazed Lemon Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "Tender, moist, and simple to prepare, this glazed lemon zucchini bread recipe boasts a sweet, tangy flavor from buttermilk that's sure to be loved.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt together in a bowl until well mixed. Set aside."
    },
    {
      "position": 3,
      "text": "Beat eggs in a large bowl. Stir in sugar and oil until well blended. Stir in \u00bd cup buttermilk, 2 tablespoons lemon juice, and lemon zest until well blended. Fold in zucchini until incorporated. Stir in flour mixture until well combined. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine confectioners' sugar, 2 tablespoons lemon juice, and 1 tablespoon milk in a small bowl until smooth; spoon glaze over bread. Set loaf aside until glaze set ups."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

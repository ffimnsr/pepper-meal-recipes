{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c02e5091-ad7e-5413-a6d5-ba46cc7d02bb",
  "slug": "cordon-bleu-rollups-with-honey-mustard-wine-sauce",
  "name": "Cordon Bleu Rollups with Honey-Mustard Wine Sauce",
  "recipe_type": "main",
  "brief_description": "Rollups of chicken breast, Swiss cheese and ham are baked and topped with a white wine/honey/mustard sauce. This is one of my favorites. It was trial and error. Play with the ingredient amounts, because I never use a recipe and these are approximations!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To Marinate: Mix 2 cups wine, tarragon, parsley and oil in a nonporous glass dish or bowl and. Add chicken, and toss to coat. Cover dish or bowl, and refrigerate to marinate for at least 4 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken from marinade, and pour marinade into a large skillet over medium high heat. Cut chicken breasts in half vertically and quickly flatten each piece to 1/2 inch thickness with a meat mallet. Layer each piece a slice of cheese, slice of ham, and a sprinkle of brown sugar. Roll and secure with toothpicks, then brown in skillet with marinade."
    },
    {
      "position": 3,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "Place browned rollups in a 9x13 inch baking dish and pour a small amount of marinade over chicken, reserving at least 3 tablespoons in the skillet. Sprinkle chicken with salt and pepper to taste and a small amount of brown sugar."
    },
    {
      "position": 5,
      "text": "Bake chicken rollups in preheated oven for about 30 minutes, or until cooked through and chicken juices run clear."
    },
    {
      "position": 6,
      "text": "To Make Sauce: Meanwhile, add flour to skillet with reserved marinade. Add 2 cups wine, stirring constantly, letting sauce thicken. Then stir in mustard, honey, a bit of brown sugar and horseradish. Season with salt and pepper to taste, heat through and serve with chicken rollups."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

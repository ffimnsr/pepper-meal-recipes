  "id": "f97567d2-2db8-5481-b4fa-a9f7e0739a12",
  "slug": "big-batch-freezer-old-fashioned-recipe-11912554",
  "name": "Big Batch Freezer Old Fashioned",
  "recipe_type": "drink",
  "brief_description": "This Big Batch Freezer Old Fashioned makes entertaining a breeze, delivering a perfectly balanced, classic cocktail straight from the freezer whenever your guests arrive.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar, water and cinnamon stick (if using) in a small saucepan. Bring to a simmer, stirring often until sugar completely dissolves. Let cool completely."
    },
    {
      "position": 2,
      "text": "Pour a half cup of bourbon from the bottle and reserve for another use."
    },
    {
      "position": 3,
      "text": "Pour 3 ounces of the prepared simple syrup into the bottle and reserve remaining syrup for another use."
    },
    {
      "position": 4,
      "text": "Add bitters to the bottle and place the top on the bottle. Gently tip the bottle over to mix the ingredients and place the bottle in the freezer for at least 6 hours."
    },
    {
      "position": 5,
      "text": "To serve: pour 2-3 ounces over ice. Add an orange peel and cherry and stir. Allow the ice to slightly mellow and dilute the cocktail."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

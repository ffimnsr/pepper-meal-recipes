{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "08778ce5-f666-54d8-bcaa-70d6df341756",
  "slug": "chicken-adobo-tacos-recipe-11711210",
  "name": "Chicken Adobo Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These chicken adobo tacos fuse Mexican and Filipino cuisine. Wrap up some chicken adobo in a flour tortilla and top with mango salsa \u2014 so good! Make the mango salsa as directed, or save a few steps by purchasing some at the grocery store.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine soy sauce, vinegar, bay leaves, and garlic in a large plastic bag with a zipper. Gently squeeze to mix well. Add chicken and coat with marinade. Squeeze out as much air from the bag as possible, coat all the chicken pieces with marinade, seal, and refrigerate for at least 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine vinegar, fish sauce, avocado oil, sugar, and black pepper in a bowl for the salsa. Stir with a whisk or fork until sugar is dissolved. Add mango, tomato, red onion, jalape\u00f1o, and chopped cilantro to the bowl. Toss to combine, and refrigerate salsa until ready to serve."
    },
    {
      "position": 4,
      "text": "For tacos, remove chicken pieces from the marinade and reserve the marinade."
    },
    {
      "position": 5,
      "text": "Heat oil in a large nonstick skillet over medium-high heat. Carefully add the chicken thighs, and brown on each side, 1 to 2 minutes, then remove chicken to a plate."
    },
    {
      "position": 6,
      "text": "To the same skillet, add onion, and cook for about 1 minute. Stir in minced garlic and cook until fragrant, about 30 seconds. Add reserved marinade, water, brown sugar, and black pepper, and bring to a boil."
    },
    {
      "position": 7,
      "text": "Return chicken to the skillet, smooth side down. Reduce heat to low, and simmer chicken uncovered, about 15 minutes. The liquid should bubble gently. Turn chicken and simmer 10 minutes more. Remove chicken from skillet to rest."
    },
    {
      "position": 8,
      "text": "Cook sauce over medium heat until syrupy, thick, and reduced, about 10 minutes. Remove skillet from heat. Remove bay leaves and discard."
    },
    {
      "position": 9,
      "text": "Slice chicken into 1/2-inch slices and return to the skillet to coat in the sauce. Garnish with fresh cilantro and chopped green onions, if desired."
    },
    {
      "position": 10,
      "text": "Fill each tortilla with chicken strips and top with mango salsa. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "d477bf32-833b-51e2-abda-41bf30a3d6cb",
  "slug": "coffee-shop-pumpkin-scones",
  "name": "Coffee Shop Pumpkin Scones",
  "recipe_type": "breakfast",
  "brief_description": "These glazed spiced pumpkin scones are like the ones from my favorite coffee shop. This recipe is so tasty, quick, easy to make, and more economical.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Whisk flour, white sugar, baking powder, 1 teaspoon cinnamon, salt, nutmeg, cloves, and ginger together in a large bowl; cut in butter and shortening using a pastry cutter or 2 knives until mixture is crumbly."
    },
    {
      "position": 3,
      "text": "Combine pumpkin, egg, and half-and-half in a separate bowl; stir into flour mixture until just combined. Turn dough out onto a floured work surface; shape into a 1/2-inch-thick square. Cut dough into pizza-shaped wedges; arrange on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, 10 to 15 minutes. Transfer scones to a wire rack to cool."
    },
    {
      "position": 5,
      "text": "Whisk confectioners' sugar, milk, 1/4 teaspoon cinnamon, and pumpkin pie spice together in a bowl; drizzle over scones. Let set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

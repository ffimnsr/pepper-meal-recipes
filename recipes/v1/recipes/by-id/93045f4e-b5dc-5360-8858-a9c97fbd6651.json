  "id": "93045f4e-b5dc-5360-8858-a9c97fbd6651",
  "slug": "lemon-blueberry-magic-cake-recipe-11926124",
  "name": "Lemon Blueberry Magic Cake",
  "recipe_type": "dessert",
  "brief_description": "This lemon blueberry magic cake is bright and jammy. Wonderfully nostalgic, this cake transforms as it bakes. The blueberries sink into a luscious, jam-like bottom layer, while the marshmallows rise and caramelize into a glossy, golden top. In between, the lemon cake stays tender and citrusy with a soft, pudding-like center. It is sweet, tangy, gooey, and lightly crisp at the edges.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Generously coat a 9x13-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread marshmallows evenly over the bottom of the prepared pan. Whisk together cake mix, oil, eggs, and 1 cup water in a bowl until smooth. Fold in lemon zest. Gently pour batter evenly over marshmallows, spreading to reach the edges of pan. Do not stir."
    },
    {
      "position": 3,
      "text": "Sprinkle gelatin powder evenly over top. Sprinkle blueberries evenly over gelatin. Carefully drizzle remaining 3/4 cup water evenly over pan until most of the gelatin has dissolved."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is golden brown and set and edges are bubbling, about 50 minutes. Let cool at least 20 minutes or to room temperature. Dust with confectioner's sugar and serve. Recipe developed by Marianne Williams"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

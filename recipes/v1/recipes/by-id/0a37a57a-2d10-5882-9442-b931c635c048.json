  "id": "0a37a57a-2d10-5882-9442-b931c635c048",
  "slug": "real-nawlins-muffuletta",
  "name": "Real N'awlins Muffuletta",
  "recipe_type": "salad",
  "brief_description": "A classic muffuletta with olive salad, cold meats, and cheese stuffed into an Italian loaf for a gigantic sandwich just like you'd get in New Orleans!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Roughly chop green olives, Kalamata olives, pepperoncini, cauliflower, cocktail onions, garlic, capers, celery, and carrot; transfer to a bowl."
    },
    {
      "position": 2,
      "text": "Stir oregano, basil, black pepper, and celery seeds into olive mixture. Stir in olive oil, canola oil, and vinegar; transfer olive salad to a glass jar (or other nonreactive container). Pour in more oil to cover if needed."
    },
    {
      "position": 3,
      "text": "Cover jar or container; refrigerate at least 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Cut bread loaves in half horizontally; hollow out some excess bread to make room for filling."
    },
    {
      "position": 5,
      "text": "Evenly divide olive salad, including oil, among bread pieces."
    },
    {
      "position": 6,
      "text": "Divide and layer salami, ham, mortadella, mozzarella, and provolone slices between bottom halves of each bread loaf."
    },
    {
      "position": 7,
      "text": "Place top halves each loaf over layered meat and cheese. Cut sandwiches into quarters."
    },
    {
      "position": 8,
      "text": "Serve immediately, or wrap tightly and refrigerate for a few hours to allow the flavors to meld and the olive juice to soak into the bread."
    }
  ],
  "servings": 8,

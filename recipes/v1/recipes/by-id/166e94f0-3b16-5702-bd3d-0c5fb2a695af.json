  "id": "166e94f0-3b16-5702-bd3d-0c5fb2a695af",
  "slug": "deviled-eggs-ii",
  "name": "Traditional Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Delicious deviled eggs made with perfectly cooked hard-boiled eggs and an easy mayonnaise and mustard filling for a classic holiday appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with cold salted water. Bring to a boil, then reduce heat and simmer until hard-cooked, 10 to 12 minutes. Drain and cool in an ice bath. Once cool, peel hard boiled eggs. Slice eggs in half lengthwise and scoop out yolks."
    },
    {
      "position": 2,
      "text": "Mash yolks with vinegar, mayonnaise, mustard, salt, and pepper until smooth. You may need to add more mayonnaise to hold the mixture together, but it should be slightly dry."
    },
    {
      "position": 3,
      "text": "Carefully put egg yolk mixture back into egg whites but do not pack it. There will be enough mixture so the whites are overfilled. Sprinkle with paprika. Refrigerate until ready to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

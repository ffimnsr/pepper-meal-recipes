  "id": "f2683b7a-55e9-56a1-8dfd-ed51b34803bd",
  "slug": "slow-cooker-short-ribs",
  "name": "Slow Cooker Short Ribs",
  "recipe_type": "main",
  "brief_description": "This is a recipe for simple slow-cooked beef short ribs with a consomme-based dipping sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare a slow cooker crock with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread celery, carrots, onion, and garlic in the bottom of the crock. Season short ribs with salt and pepper; place atop the vegetables. Pour beef consomme and water into the crock."
    },
    {
      "position": 3,
      "text": "Cook on High until the ribs are fork-tender, 5 to 7 hours."
    },
    {
      "position": 4,
      "text": "Remove the ribs from the slow cooker to a platter. Strain the broth and discard the vegetables."
    },
    {
      "position": 5,
      "text": "Strip meat from the bones of the ribs. Discard bones and transfer meat to a bowl. Shred meat with 2 forks and serve with strained broth."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 300,

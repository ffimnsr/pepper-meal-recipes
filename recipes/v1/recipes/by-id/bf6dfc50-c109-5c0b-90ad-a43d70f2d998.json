  "id": "bf6dfc50-c109-5c0b-90ad-a43d70f2d998",
  "slug": "pumpernickel-spinach-dip-ii",
  "name": "Pumpernickel Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "A simple spinach dip is served in a hollowed-out pumpernickel loaf to make this tasty bread bowl dip. A share-worthy snack or party appetizer!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, blend dry vegetable soup mix, sour cream, and spinach."
    },
    {
      "position": 2,
      "text": "Remove top and insides of pumpernickel loaf, creating a bread bowl. Reserve removed bread."
    },
    {
      "position": 3,
      "text": "Spoon sour cream and spinach mixture into pumpernickel bread bowl. Serve with removed bread pieces for dipping."
    }
  ],
  "servings": 24,

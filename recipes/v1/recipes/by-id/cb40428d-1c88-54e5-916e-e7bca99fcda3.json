  "id": "cb40428d-1c88-54e5-916e-e7bca99fcda3",
  "slug": "extra-work-peanut-butter-fudge",
  "name": "Extra Work Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Extra-work peanut butter fudge is a genuine recipe. To make other flavors, replace peanut butter with white chocolate and any flavor extract you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat a 9x9-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring sugar and evaporated milk to a boil in a large, heavy-bottomed pot over medium-high heat, stirring constantly, until syrup reaches 234 degrees F (110 degrees C), 5 to 7 minutes. A teaspoon of hot syrup dropped into a glass of cold water should form a soft ball of candy."
    },
    {
      "position": 3,
      "text": "Remove from heat; immediately stir in peanut butter, butter, and vanilla extract, stirring constantly until smooth and thick. Pour fudge into the prepared pan. Cool before slicing into squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

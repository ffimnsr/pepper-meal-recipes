{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f5a0b802-3ee9-58bb-a830-515089b645af",
  "slug": "mushroom-swiss-smash-burgers-with-truffle-sauce",
  "name": "Mushroom Swiss Smash Burgers with Truffle Sauce",
  "recipe_type": "main",
  "brief_description": "Try this gourmet smash burger with sauteed mushrooms, Swiss cheese, and homemade truffle mayonnaise next time you're in a burger mood.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mayonnaise, lemon juice, truffle oil, parsley, garlic, 1/4 teaspoon salt, and 1/8 teaspoon pepper in a small bowl."
    },
    {
      "position": 2,
      "text": "Melt butter in a large cast-iron skillet over medium-high heat. Stir in mushrooms and thyme sprigs; cook, stirring occasionally, until mushrooms are tender and golden brown, about 10 minutes. Discard thyme sprigs. Season with 1/2 teaspoon salt and Worcestershire sauce. Transfer mushroom mixture to a bowl; keep warm for serving. Wipe out skillet."
    },
    {
      "position": 3,
      "text": "Stir together garlic powder, onion powder, paprika, and remaining 1/2 teaspoon each salt and pepper for the rub. Divide beef into 4 portions; gently shape into balls."
    },
    {
      "position": 4,
      "text": "Heat same skillet over medium-high heat. Working in batches as needed, add meat portions to dry skillet; press down firmly with a flat spatula or grill press into 41/2-inch-diameter patties. Sprinkle evenly with rub. Cook 2 minutes per side or until well browned. Top patties with Swiss cheese and cook about 30 seconds until cheese is melted and an instant- read thermometer inserted into centers registers at least 160 degrees F (71 degrees C)."
    },
    {
      "position": 5,
      "text": "To assemble burgers, spread bun tops and bottoms with truffle mayo. Fill buns with patties and saut\u00e9ed mushrooms."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

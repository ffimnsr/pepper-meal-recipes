  "id": "33ca7665-8e98-5705-8d85-439977961211",
  "slug": "cucumber-feta-couscous-salad-recipe-8710341",
  "name": "Cucumber Feta Couscous Salad",
  "recipe_type": "salad",
  "brief_description": "This cucumber feta couscous salad uses Israeli, or pearl couscous\u2014it\u2019s a little chewy, a little nutty. and a wonderful base for a tasty salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, combine vinegar, lemon juice, Dijon, and lemon zest. Add olive oil and whisk until well blended. Season with salt and pepper, and set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in saucepan over medium heat. Add couscous, stirring occasionally, until toasted and starting to turn light golden brown, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour chicken broth over couscous, stir in cranberries, and bring to a boil. Reduce heat to medium-low, cover, and simmer until most of the liquid has been absorbed, 8 to 9 minutes. Remove lid from saucepan, and allow couscous to cool for about 15 minutes."
    },
    {
      "position": 4,
      "text": "Fluff cooled couscous with a fork, add cucumber, feta cheese, and red onion. Drizzle dressing over couscous, and toss lightly."
    },
    {
      "position": 5,
      "text": "Taste and season with salt and pepper, if desired, and garnish with fresh mint. May be served immediately or chilled in the fridge."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

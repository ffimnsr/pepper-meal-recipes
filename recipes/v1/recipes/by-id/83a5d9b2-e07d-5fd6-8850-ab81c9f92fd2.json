  "id": "83a5d9b2-e07d-5fd6-8850-ab81c9f92fd2",
  "slug": "cuban-shredded-pork",
  "name": "Cuban Shredded Pork",
  "recipe_type": "soup",
  "brief_description": "This Cuban shredded pork recipe, aka lechon asado, simmers pork in a flavorful broth until tender. The pork is shredded and fried until just crispy.",
  "cuisine": "Cuban Caribbean Latin",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 cups water, juice of 1 lime, garlic powder, onion powder, thyme, peppercorns, and salt in a large pot; bring to a boil. Add pork, reduce heat to medium-low, and simmer until pork is very tender, 1 to 1 \u00bd hours. Add more water as necessary to keep pork covered."
    },
    {
      "position": 2,
      "text": "Off heat, rest pork in broth for 30 minutes. Transfer pork to a cutting board; shred using 2 forks, removing and discarding excess fat. Set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat. Add pork; fry until almost crisp, about 5 minutes. Add onion and garlic; cook until onion is crisp-tender, about 10 minutes more."
    },
    {
      "position": 4,
      "text": "Stir in remaining juice of 1 lime and cilantro."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

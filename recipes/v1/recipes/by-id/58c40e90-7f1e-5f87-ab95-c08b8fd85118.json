{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "58c40e90-7f1e-5f87-ab95-c08b8fd85118",
  "slug": "cheesy-vegetable-lasagna",
  "name": "Cheesy Vegetable Lasagna",
  "recipe_type": "main",
  "brief_description": "This rich lasagna is loaded with broccoli, carrots, onion, bell pepper, zucchini, and spinach in a homemade cheese sauce.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x13-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "Heat oil in a large cast iron skillet over medium heat. When oil is hot add broccoli, carrots, onions, bell peppers, zucchini and garlic. Saute for 7 minutes; set aside."
    },
    {
      "position": 4,
      "text": "Place flour in a medium saucepan and gradually whisk in milk until well blended. Bring to a boil over medium heat. Cook 5 minutes, or until thick, stirring constantly. Stir in 1/2 cup Parmesan cheese, salt and pepper; cook for 1 minute, stirring constantly. Remove from heat; stir in spinach. Reserve 1/2 cup spinach mixture. In a small bowl, combine cottage and ricotta cheeses; stir well."
    },
    {
      "position": 5,
      "text": "Spread about 1/2 cup of spinach mixture in the bottom of the prepared pan. Layer noodles, ricotta mixture, vegetables, spinach mixture, and 2 cups mozzarella cheese, ending with noodles. Top with reserved spinach mixture, 1/2 cup mozzarella cheese and 1/4 cup parmesan cheese."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven for 35 minutes, or until lightly browned on top. Cool for approximately 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

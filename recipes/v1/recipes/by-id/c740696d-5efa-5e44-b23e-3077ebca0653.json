  "id": "c740696d-5efa-5e44-b23e-3077ebca0653",
  "slug": "apple-potato-latkes",
  "name": "Apple-Potato Latkes",
  "recipe_type": "dessert",
  "brief_description": "Golden potato latkes sweetened with fresh apple and maple syrup make a delicious side dish and are a great excuse to use your spiralizer.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make a deep vertical cut on each side of the potato and apple."
    },
    {
      "position": 2,
      "text": "Attach potato to a spiralizer fitted with the small shredded blade and cut into thin shreds. Repeat with apple. Spread shredded potato and apple on several layers of paper towels; squeeze to release as much moisture as possible. Transfer to a bowl."
    },
    {
      "position": 3,
      "text": "Mix egg, flour, maple syrup, salt, and nutmeg into the bowl."
    },
    {
      "position": 4,
      "text": "Heat vegetable oil in a skillet over medium heat. Spoon 2 tablespoons of the potato mixture into the skillet; flatten slightly with a spatula. Cook until golden brown, 3 to 4 minutes per side. Drain on a plate lined with paper towels. Repeat with remaining mixture, adding more oil if needed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

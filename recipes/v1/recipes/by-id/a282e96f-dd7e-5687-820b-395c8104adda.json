  "id": "a282e96f-dd7e-5687-820b-395c8104adda",
  "slug": "easy-faux-chocolate-mousse",
  "name": "Easy Faux Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "This mascarpone chocolate \u201cmousse\u201d may play tricks on your eyes and your tastebuds since it tastes like authentic mousse \u2014 but it\u2019s made with no eggs!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix mascarpone cheese, whipping cream, and vanilla together in a bowl."
    },
    {
      "position": 2,
      "text": "Melt chocolate chips in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching."
    },
    {
      "position": 3,
      "text": "Fold melted chocolate into mascarpone cheese mixture. Refrigerate until set, 1 to 2 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

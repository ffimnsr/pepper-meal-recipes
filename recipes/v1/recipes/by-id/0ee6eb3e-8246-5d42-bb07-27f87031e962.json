  "id": "0ee6eb3e-8246-5d42-bb07-27f87031e962",
  "slug": "roasted-lemon-herb-chicken",
  "name": "Roasted Lemon Herb Chicken",
  "recipe_type": "main",
  "brief_description": "For this roasted lemon herb chicken recipe, rub a whole chicken with Italian seasoning, garlic, and mustard, drizzle with lemon and olive oil, then bake.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine Italian seasoning, garlic powder, seasoning salt, mustard powder, and black pepper in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Remove giblets from chicken cavity; rinse chicken thoroughly. Place chicken in a 9x13-inch baking dish. Sprinkle 1 \u00bd teaspoons spice mixture in chicken cavity; rub remaining spice mixture on outside of chicken."
    },
    {
      "position": 4,
      "text": "Combine lemon juice and olive oil in a small bowl; drizzle over chicken."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the juices run clear, about 1 \u00bd hours, basting several times with remaining lemon-oil mixture. An instant-read thermometer inserted into the thickest part of the thigh, near but not touching the bone, should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

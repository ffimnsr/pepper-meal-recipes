  "id": "d01539f3-993a-5366-a635-91901bdf0004",
  "slug": "maple-walnut-scones",
  "name": "Maple Walnut Scones",
  "recipe_type": "breakfast",
  "brief_description": "These tasty maple walnut scones are made with sugar, baking powder, and vanilla extract. They taste like they came from a specialty coffee shop.",
  "cuisine": "American British",
  "instructions": [
    {
      "position": 1,
      "text": "Set oven rack to lower center of oven. Preheat the oven to 375 degrees F (190 degrees C). Toast walnuts on a baking sheet in the oven for 3 to 5 minutes. Cool."
    },
    {
      "position": 2,
      "text": "Whisk together flour, sugar, baking powder, and salt in a large bowl. Toss butter pieces in flour mixture to coat. Use a pastry blender to cut in butter until mixture resembles fine crumbs. Stir in toasted walnuts. Beat egg in a large bowl. Mix in half-and-half, maple extract, and vanilla extract. Stir dry ingredients into wet ingredients, mixing until just blended, switching from a spoon to your hands as mixture comes together. Place dough in the refrigerator for 10 minutes."
    },
    {
      "position": 3,
      "text": "Roll chilled dough into a ball on a lightly floured surface. Flatten dough into a 3/4-inch circle. Cut into 8 wedges."
    },
    {
      "position": 4,
      "text": "Bake scones on a parchment lined baking sheet just until firm and the bottoms are lightly browned, 15 to 20 minutes. Cool for 3 minutes before transferring to cooling racks."
    },
    {
      "position": 5,
      "text": "Stir together confectioners' sugar, hot water, and remaining maple extract. Drizzle on scones to glaze."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "5ebeb797-5e10-5fab-b20d-019488fc8347",
  "slug": "vegan-air-fryer-potato-skins",
  "name": "Vegan Air Fryer Potato Skins",
  "recipe_type": "side",
  "brief_description": "Delicious and easy potato skins with a vegan filling, cooked in the air fryer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Wash potatoes and puncture holes in the skin with a fork."
    },
    {
      "position": 2,
      "text": "Cook potatoes in the microwave for 5 minutes on each side. Remove from microwave and cut in half lengthwise. Using a small spoon, scoop out the flesh, leaving 1/4 inch of potato flesh in the shell."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C). Spritz the inside of the potato shells with olive oil cooking spray. Set potatoes in the air fryer basket, hollowed-out side up."
    },
    {
      "position": 4,
      "text": "Air fry until edges start to crisp, about 5 minutes. Remove and fill each potato skin with about 1 tablespoon vegan cheese. Return to the air fryer basket and cook until cheese is melted, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Top cooked potato skins with 1 tablespoon diced tomatoes and 1 tablespoon textured vegetable protein."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "76a19f82-ed45-5e52-906a-8067ab8dff75",
  "slug": "shrimp-chowder",
  "name": "Shrimp Chowder",
  "recipe_type": "soup",
  "brief_description": "An easy shrimp chowder with cooked potatoes and saut\u00e9ed onions is enriched with white wine, cream cheese, and milk for a rich and creamy seafood soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat butter in a large soup pot over medium-low heat. Add celery and onions; cook and stir until vegetables are completely softened, about 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Add cream cheese and milk; stir over low heat until cream cheese is completely melted."
    },
    {
      "position": 4,
      "text": "Add potatoes, shrimp, dry white wine and salt. Heat thorough, stirring occasionally; serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "55c008c6-ca36-54a1-aeeb-d7d5babadf2b",
  "slug": "buffalo-dip-with-rotisserie-chicken",
  "name": "Buffalo Dip with Rotisserie Chicken",
  "recipe_type": "appetizer",
  "brief_description": "Enjoy all the great flavors of Buffalo wings without the bones in this oven-baked dip made with leftover rotisserie chicken, ranch dressing, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 3-cup oven-proof serving dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine shredded chicken, cream cheese, and cayenne in a 10-inch nonstick skillet over medium heat. Stir until cream cheese has melted, 2 to 3 minutes. Stir in ranch dressing, remove from heat, and pour into the prepared dish. Spread Buffalo sauce evenly over top and sprinkle with Cheddar."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until dip is warmed through and cheese is melted, about 20 minutes. Remove from the oven and sprinkle with blue cheese. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7e6665af-d9c3-56f0-baec-d6a42ac6f651",
  "slug": "cinnamon-toast-pumpkin-seeds",
  "name": "Cinnamon Sugar Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "These toasted cinnamon sugar pumpkin seeds are sweet, buttery, and so easy to make with fresh pumpkin seeds when you clean your pumpkins for carving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place pumpkin seeds into a large bowl. Mix butter, cinnamon, and salt together in a small bowl; pour over seeds and toss until evenly coated. Spread seeds in a single layer on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring occasionally, until seeds are light golden brown, about 40 minutes. Remove from the oven; sprinkle sugar over warm seeds and stir until evenly coated."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

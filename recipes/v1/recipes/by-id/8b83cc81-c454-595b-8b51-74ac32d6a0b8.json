  "id": "8b83cc81-c454-595b-8b51-74ac32d6a0b8",
  "slug": "peach-crumble-recipe-7559227",
  "name": "Best-Ever Peach Crumble",
  "recipe_type": "dessert",
  "brief_description": "This fresh peach crumble may be the best dessert you can make with fresh, ripe peaches. Serve it warm, with whipped cream, vanilla ice cream, or a splash of heavy whipping cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 2-1/2 quart baking dish."
    },
    {
      "position": 2,
      "text": "Place peaches in the prepared baking dish. Combine brown sugar, 3 tablespoons flour, lemon juice, lemon zest, and cinnamon; sprinkle over peaches."
    },
    {
      "position": 3,
      "text": "Combine 1 cup flour, sugar, baking powder, salt, and nutmeg. Stir in egg and mix until mixture has pea-sized crumbles. Sprinkle mixture over peaches. Pour butter evenly over crumbles."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is lightly browned, 37 to 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

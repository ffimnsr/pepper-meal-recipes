  "schema_version": 1,
  "id": "5fcc3df8-8c5b-573d-a1a1-8de86fc3ed94",
  "slug": "one-bite-thai-flavor-bomb-salad-wraps-miang-kham",
  "name": "One-Bite Thai \"Flavor Bomb\" Salad Wraps (Miang Kham)",
  "recipe_type": "salad",
  "brief_description": "Chef John's version of one-bite Thai salad wraps, or miang kham, features the classic sauce that ties together the immense flavors they hold. The perfect appetizer for parties!",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Combine coconut, peanuts, shallot, ginger, lime zest and juice, brown sugar, fish sauce, and water in a small saucepan, swirl to mix, and bring to a simmer over medium-high heat. Reduce heat to medium and simmer, stirring occasionally, until the mixture reduces by about half and starts to thicken up."
    },
    {
      "position": 2,
      "text": "Remove from heat and let cool to room temperature before using. Sauce will get thicker once cooled. If sauce is too thick, thin out with a little bit of water. If it's too runny, simply put it back on the heat and reduce it a little more."
    },
    {
      "position": 3,
      "text": "To make the wraps, place a heaping teaspoon of chicken in a spinach leaf, top with a big pinch of toasted coconut, a few peanuts, a Thai basil leaf, one piece of lime, one piece of Thai chili, one or two pieces of shallots, and one or two cubes of ginger."
    },
    {
      "position": 4,
      "text": "Top with 1 teaspoon of the sauce and wrap everything into one neat bite. These must be eaten in a single bite to get all the flavors working properly together."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

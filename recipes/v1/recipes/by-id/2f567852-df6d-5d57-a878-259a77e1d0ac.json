  "id": "2f567852-df6d-5d57-a878-259a77e1d0ac",
  "slug": "appeltaart-dutch-apple-tart",
  "name": "Appeltaart (Dutch Apple Tart)",
  "recipe_type": "dessert",
  "brief_description": "This delicious Dutch apple tart recipe features a buttery crust, apples, sultanas, and cinnamon. A lattice top makes this a stunning dessert.",
  "cuisine": "Dutch",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pan."
    },
    {
      "position": 2,
      "text": "Combine flour, butter, 1 1/2 eggs, 1/3 cup plus 1 tablespoon sugar, and 1 teaspoon cinnamon in a large bowl. Knead by hand to form a smooth, consistent dough."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured work surface. Roll out 3/4 of the dough into a 10-inch circle; press over the bottom and up the sides of the prepared pan."
    },
    {
      "position": 4,
      "text": "Mix apples, sultanas, 1/4 cup white sugar, and 1 tablespoon cinnamon together in a bowl. Spread over dough in the cake pan."
    },
    {
      "position": 5,
      "text": "Roll out remaining dough into a circle; cut into strips about 1/3-inch wide. Form an X in the center of the tart with the 2 longest strips. Create a lattice by weaving vertical and horizontal strips in an over-and-under pattern, using the shortest strips for the edges. Press ends of the strips firmly to the edge of the tart; trim excess dough with a knife."
    },
    {
      "position": 6,
      "text": "Brush remaining beaten egg over dough."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until pastry is light brown, 60 to 65 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

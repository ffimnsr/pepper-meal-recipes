  "id": "a29763ed-bb12-55f6-a80c-f57fcd532812",
  "slug": "bing-cherry-salad",
  "name": "Bing Cherry Salad",
  "recipe_type": "salad",
  "brief_description": "Pineapple, cherries, and cream cheese are suspended in this easy gelatin dessert. Use your favorite mold to make it extra festive.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Drain the pineapple juice and cherry water into a 2-cup measuring cup. Pour enough color to make 2 cups; discard the remaining soda. Pour the cola mixture into a saucepan."
    },
    {
      "position": 2,
      "text": "Bring the cola mixture to a boil over medium-high heat. Remove from heat, then stir in the pineapple, cherries, cream cheese, and cherry gelatin until gelatin dissolves, about 5 minutes. Pour mixture into a mold or glass baking dish. Refrigerate until set, about 3 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,

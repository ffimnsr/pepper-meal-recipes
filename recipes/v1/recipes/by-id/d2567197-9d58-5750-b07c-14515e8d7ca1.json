  "schema_version": 1,
  "id": "d2567197-9d58-5750-b07c-14515e8d7ca1",
  "slug": "barbecue-ribs",
  "name": "Barbecue Ribs",
  "recipe_type": "dessert",
  "brief_description": "These BBQ ribs are baked, then grilled and basted with a homemade sweet and spicy BBQ sauce with rum until sticky, smoky, and tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut spareribs into serving size portions; wrap in double thickness of foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 \u00bd hours. Unwrap and drain drippings. (I usually freeze drippings to use later in soups.) Place ribs in a large roasting pan."
    },
    {
      "position": 4,
      "text": "Mix brown sugar, chile sauce, ketchup, soy sauce, Worcestershire sauce, rum, garlic, mustard, and pepper together in a bowl. Coat ribs with sauce and marinate at room temperature for 1 hour or refrigerate for 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "Preheat the grill to medium heat. Position the grate 4 inches above heat source; grease the grate with cooking spray."
    },
    {
      "position": 6,
      "text": "Cook ribs on the preheated grill for 30 minutes, basting with marinade."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

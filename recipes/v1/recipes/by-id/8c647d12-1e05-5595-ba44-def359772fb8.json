  "id": "8c647d12-1e05-5595-ba44-def359772fb8",
  "slug": "butternut-curry-soup",
  "name": "Butternut Curry Soup",
  "recipe_type": "soup",
  "brief_description": "Combine the complex flavors of curry with seasonal butternut squash to create a soup that is perfect on your holiday table or for any cold weather meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in large saucepan over medium heat. Cook leeks 3 minutes. Add squash, curry powder and sugar; cook 2 minutes."
    },
    {
      "position": 2,
      "text": "Add broth; cover and bring to a boil. Reduce heat and simmer 15 minutes or until squash is soft. Remove from heat."
    },
    {
      "position": 3,
      "text": "Puree squash mixture with immersion blender or in food processor or blender until smooth. Serve with sour cream or Greek yogurt and chives, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

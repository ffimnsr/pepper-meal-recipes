  "id": "f08e401a-5ea5-54af-a994-72999e0a991e",
  "slug": "peanut-butter-banana-quesadilla",
  "name": "Peanut Butter Banana Quesadilla",
  "recipe_type": "dessert",
  "brief_description": "These sweet and simple quesadillas with peanut butter and banana are a light yet satisfying treat \u2014 perfect for breakfast, a midday snack, or dessert!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Spread 2 tablespoons peanut butter onto each tortilla. Top one tortilla with banana slices, then cover with remaining tortilla, peanut butter-side down."
    },
    {
      "position": 2,
      "text": "Spray cooking spray into a skillet and heat over medium heat. Place quesadilla into the hot skillet and cook until lightly browned, about 3 minutes per side. Cut in half to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,

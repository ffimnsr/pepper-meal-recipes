  "id": "55082a0d-9e32-52c9-b0db-0e72b0054f61",
  "slug": "canadian-yellow-split-pea-soup-with-ham",
  "name": "Canadian Yellow Split Pea Soup with Ham",
  "recipe_type": "soup",
  "brief_description": "Canadian-style yellow split pea soup is a great way to use up a ham bone, or smoked pork hocks. This hearty comforting soup is loaded with flavor.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place ham bone, yellow split peas, celery, carrots, onion, salt, thyme, bay leaf, and pepper into a large pot; pour in water. Bring mixture to a boil and skim off any foam with a spoon."
    },
    {
      "position": 3,
      "text": "Reduce heat and place a lid on the pot, slightly ajar to allow some evaporation. Simmer, stirring occasionally, until yellow split peas are tender and soup is thick, about 3 hours."
    },
    {
      "position": 4,
      "text": "Remove ham bone from soup; remove meat from ham bone, chop or shred, and return to the pot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 190,

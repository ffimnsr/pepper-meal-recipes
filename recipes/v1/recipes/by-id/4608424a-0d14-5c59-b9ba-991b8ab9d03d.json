  "id": "4608424a-0d14-5c59-b9ba-991b8ab9d03d",
  "slug": "skillet-macaroni-and-cheese",
  "name": "Skillet Macaroni and Cheese",
  "recipe_type": "main",
  "brief_description": "This quick and easy macaroni and cheese recipe from scratch is cooked in a skillet and ready in 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a medium skillet over medium-high heat. Pour in dry macaroni noodles. Pour in enough water to barely cover macaroni. Bring to a boil, stirring continuously."
    },
    {
      "position": 2,
      "text": "Continue stirring the macaroni until water is almost evaporated and pasta is tender yet firm to the bite, about 8 minutes. Pour in evaporated milk and cream. Add grated cheese and stir until cheese has melted and everything is well combined. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 8,

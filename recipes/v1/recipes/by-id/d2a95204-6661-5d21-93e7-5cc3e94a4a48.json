  "id": "d2a95204-6661-5d21-93e7-5cc3e94a4a48",
  "slug": "mighty-fine-turkey-brine",
  "name": "Mighty Fine Turkey Brine",
  "recipe_type": "drink",
  "brief_description": "Dark brown sugar, whiskey, apple juice, and fresh orange dial up the flavor on this mighty turkey brine that makes for a very juicy bird.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 1/2 cups water and salt in a small saucepan. Bring to a boil, stirring constantly, until salt is dissolved, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour water and salt mixture into a 5-gallon bucket. Add 1 gallon of water."
    },
    {
      "position": 3,
      "text": "Combine 2 1/2 cups water and brown sugar in a small saucepan. Bring to a boil, stirring constantly, until sugar is dissolved, about 3 minutes. Pour into the bucket."
    },
    {
      "position": 4,
      "text": "Stir apple juice, whiskey, and lemon juice into the bucket. Add chopped apple. Squeeze in orange juice and add in rinds."
    }
  ],
  "servings": 31,

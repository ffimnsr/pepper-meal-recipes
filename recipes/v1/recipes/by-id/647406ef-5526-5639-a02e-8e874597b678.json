  "id": "647406ef-5526-5639-a02e-8e874597b678",
  "slug": "broccoli-and-tortellini-salad",
  "name": "Broccoli and Tortellini Salad",
  "recipe_type": "salad",
  "brief_description": "Broccoli keeps very good company in this wonderful salad. There's fresh cheese tortellini, bacon, raisins, sunflower seeds, broccoli florets, red onion, and a sweet and sour mayonnaise dressing tossed in for good measure.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook tortellini in boiling water for 8 to 10 minutes or until al dente. Drain, and rinse under cold water."
    },
    {
      "position": 3,
      "text": "In a small bowl, mix together mayonnaise, sugar and vinegar to make the dressing."
    },
    {
      "position": 4,
      "text": "In a large bowl, combine broccoli, tortellini, bacon, raisins, sunflower seeds and red onion. Pour dressing over salad, and toss."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

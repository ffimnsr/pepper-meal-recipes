  "id": "25a0b9c5-461e-514a-9111-27c103ce3ce2",
  "slug": "best-fried-green-tomatoes",
  "name": "Best Fried Green Tomatoes",
  "recipe_type": "side",
  "brief_description": "These fried green tomatoes are perfectly crispy outside, juicy inside, and an easy way to use up green tomatoes for a wonderful late summer treat.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Slice tomatoes 1/2-inch thick. Discard the ends."
    },
    {
      "position": 3,
      "text": "Whisk eggs and milk together in a medium-sized bowl. Scoop flour onto a plate. Mix cornmeal, bread crumbs, salt, and pepper on another plate. Dip tomatoes into flour to coat. Then dip tomatoes into milk and egg mixture; dredge in bread crumbs to completely coat."
    },
    {
      "position": 4,
      "text": "Heat oil in a large deep skillet to 375 degrees F (190 degrees C). Place tomatoes in hot oil in batches of 4 or 5, to prevent them from touching; fry until crisp and golden brown on one side, then flip and fry on other side."
    },
    {
      "position": 5,
      "text": "Transfer fried tomatoes to a paper towel-lined plate to drain. Repeat with remaining tomatoes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

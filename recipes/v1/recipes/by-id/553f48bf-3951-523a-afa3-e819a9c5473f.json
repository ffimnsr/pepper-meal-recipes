  "id": "553f48bf-3951-523a-afa3-e819a9c5473f",
  "slug": "instant-pot-creamy-vanilla-rice-pudding",
  "name": "Instant Pot\u00ae Creamy Vanilla Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This extra-rich rice pudding recipe calls for already-cooked short-grain rice and is a great way to use leftover rice. Make it for breakfast, as a snack, or serve it for dessert!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cooked rice, 2 cups milk, sugar, and salt in a multi-functional pressure cooker (such as Instant Pot\u00ae) and stir well. Close and lock the lid. Select porridge function according to manufacturer's instructions and seal the vent. Set timer for 20 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and carefully remove the lid."
    },
    {
      "position": 3,
      "text": "Whisk egg yolks together well in a bowl. Add a small amount of cooked porridge and whisk quickly into yolks. Pour mixture into the pot and stir to combine well with rice. Add heavy cream, remaining milk, and vanilla extract. Stir to combine completely."
    },
    {
      "position": 4,
      "text": "Serve rice pudding in individual bowls garnished with cinnamon."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

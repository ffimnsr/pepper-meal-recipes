  "schema_version": 1,
  "id": "81cab43b-8a1a-5dd3-8750-0f374c671428",
  "slug": "bulgogi-beef-korean-style-barbecue",
  "name": "Bulgogi Beef (Korean-Style Barbecue)",
  "recipe_type": "dessert",
  "brief_description": "Thin slices of beef short rib are briefly marinated in a sweet and hot marinade, then quickly seared and served over rice in this classic Korean-style BBQ dish.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Mix garlic, grated onion, grated ginger, toasted sesame oil, and brown sugar together in a mixing bowl. Stir in grated pear, soy sauce, and red pepper flakes."
    },
    {
      "position": 2,
      "text": "Transfer meat to marinade and toss to coat on all sides. Cover and refrigerate, 1 to 2 hours."
    },
    {
      "position": 3,
      "text": "Season meat with salt and a drizzle of vegetable oil. Toss."
    },
    {
      "position": 4,
      "text": "Brush a cast iron skillet with a little vegetable oil and place over high heat. When the skillet is very hot, add beef in a single layer and cook until meat begins to caramelize around the edges and moisture begins to evaporate, 2 to 3 minutes per side. Serve over hot rice and top with green onion slices."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

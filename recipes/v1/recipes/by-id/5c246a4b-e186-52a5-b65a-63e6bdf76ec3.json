  "id": "5c246a4b-e186-52a5-b65a-63e6bdf76ec3",
  "slug": "dads-new-zealand-mince-stew",
  "name": "Dad's New Zealand Mince Stew",
  "recipe_type": "soup",
  "brief_description": "I'm not sure if it's chili, or stew, or a shepherd's pie without the crust, but there is nothing like it over some toast on a cold night. Rich and hearty, just downright yummy.",
  "cuisine": "New Zealand",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Saute onions until browned; remove from pot, and set aside. Add ground beef to pot, and cook until evenly brown. Add garlic, and cook for 2 minutes. Stir in browned onions, and cook on high heat for 3 to 5 minutes. Stir in 1 cup of water. Reduce heat, cover, and simmer for 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir in ketchup, beef stock, and teriyaki sauce. Season with pepper, curry powder, garlic powder, and onion powder. Cover, and simmer for about 2 hours."
    },
    {
      "position": 3,
      "text": "Mix together 1 tablespoon flour and 1/2 cup water. Stir into stew, and cook until thickened."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 45,

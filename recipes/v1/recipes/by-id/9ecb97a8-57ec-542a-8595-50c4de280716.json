  "schema_version": 1,
  "id": "9ecb97a8-57ec-542a-8595-50c4de280716",
  "slug": "sweet-potato-cheesecake",
  "name": "Sweet Potato Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato cheesecake has a smooth, creamy filling, buttery crust, and decadent pecan praline topping\u2014perfect for a fall or winter dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C )."
    },
    {
      "position": 2,
      "text": "Mix graham cracker crumbs, 1/4 cup sugar, and 1/4 cup melted butter together in a bowl until combined. Press crumb mixture firmly and evenly across the bottom and slightly up the sides of a 9 \u00bd-inch springform pan. Bake for 10 minutes; remove from oven and set aside. Keep the oven on."
    },
    {
      "position": 3,
      "text": "Beat cream cheese and 7/8 cup of white sugar until smooth. Mix in sour cream, 1/4 cup cream, and sweet potato puree. Beat in eggs one at a time, blending well after each. Pour filling into crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a tester inserted near the center comes out clean, about 1 hour (center may still be slightly jiggly). Turn off the oven. Let cake stand 1 hour in oven with door ajar."
    },
    {
      "position": 5,
      "text": "To make the praline topping: Combine brown sugar and 1/4 cup butter in a heavy small saucepan. Stir over low heat until sugar dissolves. Increase heat, and bring to a boil. Mix in 1/4 cup cream, then add pecans."
    },
    {
      "position": 6,
      "text": "Pour hot praline topping over cheesecake. Store leftover cheesecake in the refrigerator."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

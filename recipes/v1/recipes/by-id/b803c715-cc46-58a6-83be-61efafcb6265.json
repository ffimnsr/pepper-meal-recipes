  "id": "b803c715-cc46-58a6-83be-61efafcb6265",
  "slug": "pecan-pie",
  "name": "Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie recipe is a classic Southern dessert featuring toasted pecans in a rich and sticky caramel filling and a buttery crust.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine sugar, corn syrup, butter, water, and cornstarch together in a medium saucepan over medium heat. Bring to a boil; remove from heat and let cool."
    },
    {
      "position": 3,
      "text": "Beat eggs in a large bowl with an electric mixer until frothy. Gradually beat in sugar-syrup mixture. Stir in pecans, vanilla extract, and salt."
    },
    {
      "position": 4,
      "text": "Pour mixture into pie shell. Bake in the preheated oven until filling sets, 45 to 50 minutes. If the edges brown too quickly, loosely cover them with foil or a pie shield halfway through baking."
    },
    {
      "position": 5,
      "text": "Let the pie cool at room temperature for at least 2 hours before slicing so the filling fully sets."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

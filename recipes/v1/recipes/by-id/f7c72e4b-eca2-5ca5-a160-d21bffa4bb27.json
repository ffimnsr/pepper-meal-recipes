  "id": "f7c72e4b-eca2-5ca5-a160-d21bffa4bb27",
  "slug": "fiesta-tater-tot-casserole",
  "name": "Fiesta Tater Tot Casserole",
  "recipe_type": "soup",
  "brief_description": "Combine Tater Tots with creamy nacho cheese soup, ground beef, and Mexican blended cheese for a crowd-pleasing, quick casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9x13-inch casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat and stir in ground beef, green onion, and 1/2 package taco seasoning. Cook and stir mixture until the beef is crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease."
    },
    {
      "position": 3,
      "text": "Combine remaining taco seasoning mix with tomato soup, nacho cheese soup, and milk in a saucepan; heat soup mixture until just boiling."
    },
    {
      "position": 4,
      "text": "Layer potato nuggets in the prepared casserole dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until potato nuggets begin to crisp, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Spoon ground beef mixture over potato nuggets; pour in soup mixture."
    },
    {
      "position": 7,
      "text": "Bake until soup mixture is bubbling, 15 to 20 minutes. Sprinkle casserole with Mexican cheese blend; bake until cheese is melted, 5 to 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

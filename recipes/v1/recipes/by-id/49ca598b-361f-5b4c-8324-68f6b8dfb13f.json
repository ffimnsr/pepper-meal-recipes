  "id": "49ca598b-361f-5b4c-8324-68f6b8dfb13f",
  "slug": "pesto-chicken-caprese-recipe-11762268",
  "name": "Pesto Chicken Caprese",
  "recipe_type": "main",
  "brief_description": "This pesto chicken caprese comes out wonderfully moist and flavorful. Tomato slices add a nice acidity to the chicken breasts and melted mozzarella on top is the perfect finish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut chicken breasts in half horizontally and, if needed, pound each to even thickness with a meat mallet. Season both sides with salt."
    },
    {
      "position": 3,
      "text": "Heat oil in a 12-inch oven-proof skillet over medium heat. Add chicken to skillet and cook until lightly browned, 3 to 4 minutes. Flip and cook the other side until lightly browned, 3 to 4 minutes. Remove skillet from heat."
    },
    {
      "position": 4,
      "text": "Spread 1 tablespoon of pesto on top of each chicken portion."
    },
    {
      "position": 5,
      "text": "Place 1 tomato slice on top of each chicken portion and top with 2 slices of mozzarella."
    },
    {
      "position": 6,
      "text": "Transfer skillet to the preheated oven and bake until cheese is melted and chicken is cooked through (165 degrees F or 74 degrees C), about 10 minutes."
    },
    {
      "position": 7,
      "text": "Serve topped with torn basil leaves. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

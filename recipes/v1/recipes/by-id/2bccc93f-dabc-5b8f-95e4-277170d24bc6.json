  "id": "2bccc93f-dabc-5b8f-95e4-277170d24bc6",
  "slug": "chile-rellenos",
  "name": "Chiles Rellenos",
  "recipe_type": "main",
  "brief_description": "Delicious chiles rellenos are stuffed with Cheddar cheese, dipped in a simple batter, then fried in canola oil until crispy and golden brown.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Remove seeds and membranes from chile peppers. Stuff each pepper with a strip of Cheddar."
    },
    {
      "position": 2,
      "text": "Mix milk, 1 cup flour, egg, baking powder, baking soda, salt, and 1 teaspoon canola oil together in a small bowl until well combined. Place remaining 1/2 cup flour on a shallow plate."
    },
    {
      "position": 3,
      "text": "Pour 1 inch oil into a heavy frying pan. Heat over medium-high heat."
    },
    {
      "position": 4,
      "text": "Roll each pepper in flour, then dip in batter. Fry in batches until lightly browned on both sides."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c111792f-bba1-5c68-87dd-5d65bf2a42c0",
  "slug": "holiday-cranberry-relish",
  "name": "Holiday Cranberry Relish",
  "recipe_type": "side",
  "brief_description": "Chopped oranges, apples, and pecans add flavor and texture to this easy cranberry relish with Jell-O. Perfect to complement your holiday stuffing!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place oranges into a food processor bowl; pulse 2 or 3 times until chopped. Transfer fruit to a large bowl. Repeat with apples, then with cranberries. Place all chopped fruit into the same bowl."
    },
    {
      "position": 2,
      "text": "Stir sugar, pecans, and gelatin mix into fruit mixture until well combined. Cover and refrigerate until set, at least 4 hours."
    }
  ],
  "servings": 8,

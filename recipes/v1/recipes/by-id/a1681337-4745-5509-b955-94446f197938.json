  "id": "a1681337-4745-5509-b955-94446f197938",
  "slug": "eggnog-spiked-with-rum",
  "name": "Eggnog (Spiked with Rum)",
  "recipe_type": "drink",
  "brief_description": "This homemade spiked eggnog made with rum, cream, eggs, and sugar is easy to prepare for the perfect adult drink for your holiday party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix egg yolks, 2 cups sugar, rum, and nutmeg together in a large mixing bowl. Cover with plastic wrap and refrigerate 8 hours to overnight to \"cure.\""
    },
    {
      "position": 3,
      "text": "Beat egg whites and remaining 1 cup sugar in a bowl using an electric mixer until firm peaks form."
    },
    {
      "position": 4,
      "text": "Fold in heavy cream. Fold in the egg yolk mixture. Beat in half-and-half until well combined."
    },
    {
      "position": 5,
      "text": "Pour into lidded jars or containers, refrigerate, and shake before serving."
    }
  ],
  "servings": 16,

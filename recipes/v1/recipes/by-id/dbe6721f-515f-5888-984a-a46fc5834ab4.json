  "id": "dbe6721f-515f-5888-984a-a46fc5834ab4",
  "slug": "canada-squares",
  "name": "Canada Squares",
  "recipe_type": "dessert",
  "brief_description": "This recipe for Canada squares yields red and white mapley cookies. When sliced, they have a white base and top and a red middle, like tiny Canadian flags.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line bottom and sides of an 8-inch square baking pan with parchment paper; crease corners well."
    },
    {
      "position": 2,
      "text": "Whisk all-purpose flour and 2 tablespoons confectioners' sugar together in a bowl; cut in \u00bd cup butter using 2 knives or pastry blender until mixture resembles fine crumbs. Evenly pat base mixture into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes. Cool on a wire rack, about 15 minutes. Evenly top base with raspberry jam."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Beat white sugar and \u00bd cup butter together until fluffy; beat in eggs until fluffy and pale yellow. Beat in rice flour until well combined; stir in food coloring until filling batter reaches desired shade of red. Evenly spread filling over jam layer."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Cool completely in the pan; about 20 minutes."
    },
    {
      "position": 7,
      "text": "Beat 2 cups confectioners' sugar and \u2153 cup butter together in a bowl with an electric mixer until smooth; stir in milk and maple extract. Evenly spread icing over cooled bars."
    },
    {
      "position": 8,
      "text": "Lift squares out of pan by holding edges of parchment paper; transfer to a cutting board. Slice into 1-inch squares with a very sharp knife."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,

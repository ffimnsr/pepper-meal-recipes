  "slug": "spicy-canned-salmon-salad-rice-bowl-recipe-7558696",
  "name": "Spicy Canned Salmon Salad Rice Bowl",
  "recipe_type": "salad",
  "brief_description": "Canned salmon salad with Sriracha mayonnaise, cool cucumbers, and sliced avocado, make this one spicy rice bowl.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chopped cucumbers and soy sauce in a small bowl and set aside."
    },
    {
      "position": 2,
      "text": "In a small bowl, combine the salmon, Sriracha\u00ae, mayonnaise, and rice vinegar."
    },
    {
      "position": 3,
      "text": "In a bowl place cooked rice and top it with the salmon mixture, sliced avocado, and chopped cucumber mixture. Sprinkle with sesame seeds. Top with extra Sriracha and green onions if desired."
    }
  ],
  "servings": 2,

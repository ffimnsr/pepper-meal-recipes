  "id": "7b45ac07-37ad-555d-bb0f-8284ba0bbee4",
  "slug": "easiest-focaccia-recipe",
  "name": "Easiest Focaccia Recipe",
  "recipe_type": "snack",
  "brief_description": "Extremely easy, fast and cheap. Great for sandwiches and snacks. You may use more or less olive oil or salt if you wish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, dissolve sugar and yeast in warm water. Let stand until creamy, about 10 minutes."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine the yeast mixture with flour; stir well to combine. Stir in additional water, 1 tablespoon at a time, until all of the flour is absorbed. When the dough has pulled together, turn it out onto a lightly floured surface and knead briefly for about 1 minute."
    },
    {
      "position": 3,
      "text": "Lightly oil a large bowl, place the dough in the bowl and turn to coat with oil. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Preheat oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 5,
      "text": "Deflate the dough and turn it out onto a lightly floured surface; knead briefly. Pat or roll the dough into a sheet and place on a lightly greased baking sheet. Brush the dough with oil and sprinkle with salt."
    },
    {
      "position": 6,
      "text": "Bake focaccia in preheated oven for 10 to 20 minutes, depending on desired crispness. If you like it moist and fluffy, then you'll have to wait just about 10 minutes. If you like it crunchier and darker in the outside, you may have to wait 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "11630ad9-22a7-52d6-b53d-82fa09994410",
  "slug": "stuffed-mushrooms-with-sour-cream",
  "name": "Stuffed Mushrooms with Sour Cream",
  "recipe_type": "appetizer",
  "brief_description": "An easy yet fancy air fryer appetizer, these bite-size stuffed mushrooms are bursting with bacon, vegetables, sour cream, and ample cheese.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place mushroom stems, orange bell pepper, onion, carrot, and bacon in a skillet over medium heat. Cook and stir until softened, about 5 minutes. Stir in 1 cup Cheddar cheese and sour cream; cook until stuffing is well combined and cheese has melted, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Preheat air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Arrange mushroom caps on the baking tray. Add stuffing in a heaped fashion to each mushroom cap. Sprinkle 1 1/2 tablespoons Cheddar cheese on top."
    },
    {
      "position": 4,
      "text": "Place the tray of mushrooms into the basket of the air fryer. Cook until cheese melts, about 8 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

  "id": "3aa9a4f0-b3d7-56dc-b846-f14ede261e66",
  "slug": "homemade-chocolate-frosting",
  "name": "Homemade Chocolate Frosting",
  "recipe_type": "dessert",
  "brief_description": "This homemade chocolate frosting recipe is easy to whip up for a deliciously rich and chocolaty frosting that's perfect for cakes and cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk cocoa powder and warm melted butter together in a large bowl; let sit for 2 minutes."
    },
    {
      "position": 3,
      "text": "Beat in confectioners sugar, 5 tablespoons milk, and vanilla extract with an electric mixer until well blended, smooth, and creamy, about 2 minutes, adding 1 or 2 tablespoons more milk as needed until reaches desired consistency."
    }
  ],

  "id": "c8855f8c-bde5-5cea-9d55-a734641fe2ca",
  "slug": "air-fryer-meatballs",
  "name": "Air Fryer Meatballs",
  "recipe_type": "side",
  "brief_description": "Air fryer meatballs are quick, easy, and mess-free to make. The insides stay tender and juicy while the outsides brown up nicely. Serve with marinara.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine beef, pork, Parmesan cheese, bread crumbs, egg, garlic, Italian seasoning, and salt in a large bowl; mix until evenly combined."
    },
    {
      "position": 3,
      "text": "Form mixture into 16 equal meatballs (a small ice cream scoop is helpful); place on a baking sheet."
    },
    {
      "position": 4,
      "text": "Place \u00bd meatballs in the air fryer basket; cook 8 minutes. Shake the basket; cook 2 minutes more. Transfer to a serving plate; rest for 5 minutes. Repeat with remaining \u00bd meatballs."
    },
    {
      "position": 5,
      "text": "Serve warm and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

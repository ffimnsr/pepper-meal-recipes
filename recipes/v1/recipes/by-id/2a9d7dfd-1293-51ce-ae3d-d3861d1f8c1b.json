  "id": "2a9d7dfd-1293-51ce-ae3d-d3861d1f8c1b",
  "slug": "marble-swirl-pound-cake",
  "name": "Marble Swirl Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "A tube cake with vanilla and chocolate layers swirled together to achieve a marbled effect.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, with electric mixer at low speed, beat sugar and butter or margarine until blended. Increase speed to high, and beat until light and fluffy. Add flour, milk, baking powder, vanilla, salt, and eggs; beat at medium speed until well mixed. Increase speed to high, and beat batter 4 minutes longer."
    },
    {
      "position": 2,
      "text": "Remove about 2 1/2 cups batter to a medium bowl. With a wire whisk or fork, beat cocoa into batter in medium bowl until well blended."
    },
    {
      "position": 3,
      "text": "Grease a 10 inch tube pan. Alternately spoon vanilla and chocolate layers into prepared pan. With a large spoon, cut and twist through batters to obtain marbled effect."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour, or until a toothpick inserted in the center of the cake comes out clean. Cool cake in pan, and on a wire rack, for 10 minutes. Remove cake from pan, and cool completely."
    }
  ],
  "servings": 14,

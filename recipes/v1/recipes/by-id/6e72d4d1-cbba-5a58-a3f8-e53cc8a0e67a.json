  "id": "6e72d4d1-cbba-5a58-a3f8-e53cc8a0e67a",
  "slug": "instant-pot-asparagus-risotto",
  "name": "Instant Pot Asparagus Risotto",
  "recipe_type": "side",
  "brief_description": "This creamy Instant Pot risotto asparagus recipe is easy to make and an Italian classic that can be served as a first course, side, or main dish.",
  "cuisine": "European Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add butter and melt. Stir in shallots and garlic; cook for 2 minutes. Remove shallots and garlic with a slotted spoon and set aside. Add asparagus and saut\u00e9 in butter for 2 minutes; remove and set aside on a plate."
    },
    {
      "position": 2,
      "text": "Return shallots and garlic to the Instant Pot and pour in wine. Stir well, scraping the bottom of the pot with a wooden or plastic spoon, for 30 seconds. Stir in rice and saut\u00e9 in wine mixture for 2 1/2 minutes, stirring constantly and scraping the bottom of the pot to loosen any brown bits. Stir in chicken broth, cream, salt, pepper, and thyme. Cancel Saut\u00e9 function."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 6 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Gradually stir in Parmesan cheese and lemon juice, stirring until cheese is melted. Stir in reserved asparagus pieces. Allow risotto to thicken in the pot, uncovered, for 3 to 4 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

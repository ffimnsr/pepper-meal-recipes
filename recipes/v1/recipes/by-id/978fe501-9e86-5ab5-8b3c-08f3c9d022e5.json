  "id": "978fe501-9e86-5ab5-8b3c-08f3c9d022e5",
  "slug": "sous-vide-cauliflower",
  "name": "Sous Vide Cauliflower",
  "recipe_type": "side",
  "brief_description": "Tender cauliflower cooked in a savory, Asian-inspired sauce is made simple with this sous vide recipe for cauliflower.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat water in a sous vide vessel to 185 degrees F (85 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cauliflower, soy sauce, fish sauce, cayenne pepper, and black pepper in a bowl; toss to coat. Place mixture into a sous vide bag and vacuum seal."
    },
    {
      "position": 3,
      "text": "Cook cauliflower mixture in preheated water bath until tender, about 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,

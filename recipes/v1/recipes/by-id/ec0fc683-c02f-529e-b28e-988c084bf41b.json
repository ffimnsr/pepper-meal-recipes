  "id": "ec0fc683-c02f-529e-b28e-988c084bf41b",
  "slug": "strawberry-pie-ii",
  "name": "Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "Strawberry pie is a favorite, and this five-ingredient, picture-perfect version couldn't be easier to whip up. It's a must-try after berry picking!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Arrange 1/2 of strawberries in baked pastry shell. Place remaining strawberries in a medium saucepan."
    },
    {
      "position": 3,
      "text": "Add sugar to the strawberries in the saucepan; place over medium heat and bring to a boil, stirring frequently."
    },
    {
      "position": 4,
      "text": "Whisk cornstarch and water together in a small bowl. Gradually stir cornstarch mixture into boiling strawberry mixture. Reduce heat and simmer mixture until thickened, about 10 minutes, stirring constantly."
    },
    {
      "position": 5,
      "text": "Pour cooked strawberry mixture over berries in pastry shell. Refrigerate until chilled and set, at least 3 hours."
    },
    {
      "position": 6,
      "text": "Before serving, whip cream in a medium bowl until soft peaks form."
    },
    {
      "position": 7,
      "text": "Serve each slice of pie with a dollop of whipped cream. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1394f853-339b-56a3-ae17-c6b9004bcfb7",
  "slug": "vegan-butternut-squash-soup-with-ginger-apple-and-coconut-milk",
  "name": "Creamy Vegan Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This smooth vegan butternut squash soup is made creamy with coconut milk and gets a flavor boost from fresh ginger, apple, carrot, and maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over low heat. Add onion and ginger; cook and stir until soft and translucent without browning onion, about 10 minutes. Add butternut squash and carrot; cook and stir, about 3 minutes. Add apple and cook for 2 minutes. Pour in broth, increase heat to medium, and bring to a boil. Reduce heat to low and simmer until vegetables are soft, about 20 minutes. Puree soup with an immersion blender until smooth."
    },
    {
      "position": 2,
      "text": "Puree soup with an immersion blender until smooth."
    },
    {
      "position": 3,
      "text": "Pour in coconut milk and season with salt and pepper. Add lemon juice and maple syrup; stir until heated through, 2 to 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6a8277ed-5618-5de6-a791-cd90fb347089",
  "slug": "moroccan-harira-soup",
  "name": "Moroccan Harira Soup",
  "recipe_type": "soup",
  "brief_description": "Harira is a flavorsome Moroccan soup made with tomatoes, lentils, chickpeas, lamb, and warm aromatic spices for a wonderfully comforting meal.",
  "cuisine": "Moroccan",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a stock pot over medium-high heat and cook cubed lamb until nicely browned and some of the fat has rendered, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Toss in diced onion and a generous pinch of salt. Cook, stirring often, until onion is soft and lightly browned, 4 to 5 minutes. Season with smoked paprika, coriander, cumin, ground ginger, black pepper, and cinnamon. Add minced garlic and cook and stir until fragrant, 30 seconds to 1 minute."
    },
    {
      "position": 4,
      "text": "Add tomato paste and cook and stir for about 1 minute."
    },
    {
      "position": 5,
      "text": "Add chicken broth, crushed tomatoes, and celery; stir until well combined. Add water and bring to a boil over high heat."
    },
    {
      "position": 6,
      "text": "Once soup is boiling, add chickpeas and green lentils; season with salt to taste. Reduce heat to medium-low and simmer for 30 minutes, stirring occasionally."
    },
    {
      "position": 7,
      "text": "Mix flour and 2 tablespoons cold water in a small bowl and drizzle slurry into the soup to thicken."
    },
    {
      "position": 8,
      "text": "Bring back to a simmer and add 1/2 of the cilantro and 1/2 of the parsley; stir to combine."
    },
    {
      "position": 9,
      "text": "Simmer on medium-low heat until meat and lentils are perfectly tender and soup has thickened, about 20 more minutes."
    },
    {
      "position": 10,
      "text": "Stir in vermicelli pasta and cook until tender, 10 to 15 minutes. Taste and adjust seasoning with cayenne and salt. Add remaining chopped cilantro and parsley and finish by drizzling lemon juice to taste into the soup."
    },
    {
      "position": 11,
      "text": "Serve immediately with a drizzle of olive oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,

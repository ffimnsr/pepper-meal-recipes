  "id": "9c9a320f-ad4d-5827-abe7-3c0acbd1c083",
  "slug": "sausage-egg-mcmuffin-casserole-recipe-11892481",
  "name": "Sausage Egg McMuffin Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This sausage egg McMuffin casserole tastes and eats just like a classic McMuffin from the golden arches, but with way less prep and assembly. Just throw it together and let it bake. Essentially, the perfect breakfast does exist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Coat an 11x7-inch baking dish with cooking spray. Whisk together eggs, half-and-half, and salt in a large bowl until smooth. Set aside."
    },
    {
      "position": 2,
      "text": "Place bottom halves of each English muffin in the prepared baking dish. Muffins will sit tightly next to each other. Top each muffin half with 1 slice of cheese and 1 sausage patty."
    },
    {
      "position": 3,
      "text": "Carefully pour egg mixture into the baking dish."
    },
    {
      "position": 4,
      "text": "Top each sausage patty with 1 slice of cheese and cover with the top English muffin halves. Cover tightly with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until eggs are nearly set, 30 to 35 minutes. Remove foil and continue to bake until eggs are fully set and muffin tops are golden brown, 10 to 12 minutes more."
    },
    {
      "position": 6,
      "text": "Allow to cool before slicing and serving, about 10 minutes. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

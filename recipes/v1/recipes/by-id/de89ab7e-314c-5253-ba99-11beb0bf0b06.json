  "id": "de89ab7e-314c-5253-ba99-11beb0bf0b06",
  "slug": "hot-honey-shallot-green-beans-recipe-11865615",
  "name": "Hot Honey Shallot Green Beans",
  "recipe_type": "salad",
  "brief_description": "Style up your dinner with these hot honey shallot green beans. They're tangy with a sweet heat. Serve warm, at room temperature, or as a salad\u2014prepare them in advance and chill in the fridge.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk shallots, chicken broth, vinegar, hot honey, and Dijon together in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Bring about 1 inch of water to a boil in a large saucepan. The water should not touch the bottom of the steamer insert. If it does, pour out a bit of the water. Place the steamer insert with the green beans into the saucepan, cover, and cook until crisp tender, 5 to 8 minutes, or longer for softer green beans."
    },
    {
      "position": 3,
      "text": "Place green beans in a bowl, drizzle with the dressing, and toss until well coated. Season with salt and pepper, and serve either warm or chilled."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

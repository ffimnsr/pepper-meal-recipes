  "id": "aae68d07-8807-57cf-904b-74aaaff7bb2c",
  "slug": "sausage-head-charcuterie-board-recipe-8715948",
  "name": "Sausage Head Charcuterie Board",
  "recipe_type": "appetizer",
  "brief_description": "Sculpt this terrifying sausage head charcuterie board for your Halloween party. It's a labor of love, and so worth it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place foam head on a cake stand, and secure with tape, or place the base of head in a hollowed out pumpkin ring to secure in place."
    },
    {
      "position": 2,
      "text": "Secure each meat stick piece with a wooden pick, arranging them around the head, custom fitting each one to resemble a face. Tear prosciutto into pieces and use the pieces to fill in any white spaces between the meat sticks."
    },
    {
      "position": 3,
      "text": "Using wooden picks, place cheese round halves in foam head to resemble eyeballs. On the same picks, place an olive half over each cheese half to resemble pupils."
    },
    {
      "position": 4,
      "text": "Spread cream cheese on the rounded side of peanut halves. Stick peanuts over mouth area on head, to resemble teeth."
    },
    {
      "position": 5,
      "text": "Arrange roasted red pepper strips in between beef pieces on top of head to resemble veins."
    },
    {
      "position": 6,
      "text": "Arrange crackers, mustard, assorted cheeses, olives, and other charcuterie accompaniments of your choice around sausage head. Enjoy!"
    }
  ],

  "id": "e68db421-8e87-5a89-941d-bee7912b3364",
  "slug": "ts-peanut-butter-balls",
  "name": "T's Peanut Butter Balls",
  "recipe_type": "appetizer",
  "brief_description": "These crunchy, chocolaty peanut butter balls are filled with oats, flax seeds, hemp seeds, and are sweetened with a bit of agave nectar. Perfect as a quick energy snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat peanut butter in a bowl of a stand mixer on low speed until creamy. Add coconut oil, agave nectar, sea salt, flax seed, hempseed, rolled oats, dark chocolate chips, and pecan pieces respectively, beating dough well after each addition."
    },
    {
      "position": 2,
      "text": "Scoop dough into smalls balls onto a plate. Chill in the refrigerator until set, at least 30 minutes."
    }
  ],
  "servings": 40,

  "schema_version": 1,
  "id": "d2e7c622-e98a-5fb3-abb9-2fdaab190547",
  "slug": "bacon-mushroom-swiss-meatloaf",
  "name": "Bacon Mushroom Swiss Meatloaf",
  "recipe_type": "main",
  "brief_description": "Bacon, onion, mushrooms, and Swiss cheese are added to ground beef in this bacon, mushrooms, Swiss cheese meatloaf recipe for a tweak on an old favorite.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir bacon in a skillet over medium heat until browned. Transfer to a paper-towel-lined plate with a slotted spoon; set aside 1 tablespoon bacon. Discard all but 1 tablespoon drippings from the skillet."
    },
    {
      "position": 3,
      "text": "Add onion and mushrooms to the skillet; cook until soft."
    },
    {
      "position": 4,
      "text": "Combine beef, milk, and egg in a large bowl. Stir in onion and mushrooms. Add about 4 ounces Swiss cheese and all but 1 tablespoon bacon; stir to combine. Stir in cornflake crumbs until well blended."
    },
    {
      "position": 5,
      "text": "Shape into a loaf; place in a meatloaf pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 1 hour. Drain fat; sprinkle with remaining 2 ounces Swiss cheese and reserved 1 tablespoon bacon. Continue baking until cheese is melted, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Let meatloaf rest for a few minutes to make it easier to slice. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

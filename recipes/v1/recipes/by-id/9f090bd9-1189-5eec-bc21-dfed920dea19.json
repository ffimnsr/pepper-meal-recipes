  "id": "9f090bd9-1189-5eec-bc21-dfed920dea19",
  "slug": "easy-vegetarian-spinach-lasagna",
  "name": "Easy Vegetarian Spinach Lasagna",
  "recipe_type": "main",
  "brief_description": "Satisfying layers of stretchy melted mozzarella, creamy ricotta, and spinach combine with sauce-coated lasagna noodles for the ultimate comfort food.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a 1 1/2-quart casserole dish with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Place spinach in the water and boil until wilted and tender, about 2 minutes. Remove spinach with a slotted spoon, pressing out excess water. Set aside."
    },
    {
      "position": 3,
      "text": "Cook lasagna in the same boiling water, stirring occasionally, until cooked through but firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Mix spinach, ricotta cheese, 1/2 cup shredded mozzarella cheese, egg, nutmeg, basil, salt, and black pepper in a bowl until well combined."
    },
    {
      "position": 5,
      "text": "Spread 1/4 cup pasta sauce on the bottom of the prepared casserole dish. Top with 3 lasagna noodles, 1/2 of the ricotta-egg mixture, and 1/4 cup pasta sauce. Repeat layers of 3 more noodles, 1/2 cup ricotta-egg mixture, and 1/4 cup pasta sauce. End with remaining 3 noodles and 1/4 cup pasta sauce. Sprinkle with remaining 1/2 cup shredded mozzarella cheese. Top with Parmesan cheese. Cover casserole with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 25 minutes. Uncover casserole and continue baking until lasagna is bubbling and lightly browned, about 25 more minutes. Let lasagna stand 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "59e1699a-e0cd-537c-9dd6-0350e8b34bff",
  "slug": "ms-sloppy-joe-sauce",
  "name": "M's Sloppy Joe Sauce",
  "recipe_type": "main",
  "brief_description": "This Sloppy Joe recipe is a bit more flavorful and spicy than than what you're probably used to, thanks to barbecue sauce and a bit of Sriracha.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium heat. Add onion and bell pepper; cook until beginning to soften, about 5 minutes. Add garlic and ground turkey; cook and stir until turkey is completely crumbled and browned, another 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Stir in pur\u00e9ed tomatoes, barbecue sauce, ketchup, vinegar, Worcestershire sauce, mustard, and chile-garlic sauce. Simmer until completely heated, 7 to 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

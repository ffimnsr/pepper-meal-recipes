{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "de08262f-bff8-5516-990f-d41b978539f5",
  "slug": "home-style-tacos-al-pastor-chile-and-pineapple-pork-tacos",
  "name": "Home-style Tacos al Pastor (Chile and Pineapple Pork Tacos)",
  "recipe_type": "dessert",
  "brief_description": "This home-style tacos al pastor (chile and pineapple pork tacos) recipe features smoky, spicy chiles, sweet pineapples, fresh onions, and cilantro.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2 cups water to a boil in a medium saucepan over medium-high heat. Add guajillo and pasilla chiles. Reduce heat to medium-low; simmer until chiles soften, about 10 minutes. Transfer chiles to a plate; remove and discard stems and seeds. Discard water."
    },
    {
      "position": 2,
      "text": "Meanwhile, strain pineapple; reserve juice and pineapple chunks separately. Coarsely chop \u00bd onion; slice remaining \u00bd onion and set aside."
    },
    {
      "position": 3,
      "text": "Combine guajillo chiles, pasilla chiles, pineapple juice, chopped \u00bd onion, vinegar, garlic, chipotle, and cumin in the bowl of a food processor; pur\u00e9e until smooth, about 2 minutes. Transfer to a saucepan over medium-high heat; bring to a boil. Cook until chile paste loses raw onion taste, about 2 minutes. Season with adobo; cool."
    },
    {
      "position": 4,
      "text": "Combine pork cubes, cooled chile paste, and pineapple chunks in a large glass or ceramic bowl with a lid or in a large resealable plastic bag; toss to coat (cover the bowl or squeeze out excess air and seal the bag). Marinate in the refrigerator 2 to 24 hours."
    },
    {
      "position": 5,
      "text": "Heat oil in large skillet over medium-high heat. Remove pork and pineapple from marinade and shake off excess. Discard marinade. Cook pork and pineapple in batches in the skillet until dark golden brown on all sides and cooked through, about 15 minutes; transfer to a large serving plate."
    },
    {
      "position": 6,
      "text": "Serve pork and pineapple in warm tortillas with sliced onion, cilantro, and lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

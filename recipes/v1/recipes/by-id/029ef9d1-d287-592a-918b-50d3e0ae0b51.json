  "id": "029ef9d1-d287-592a-918b-50d3e0ae0b51",
  "slug": "fruit-dip-ii",
  "name": "Best Fruit Dip",
  "recipe_type": "appetizer",
  "brief_description": "This fruit dip with marshmallow and cream cheese is light, fluffy, and easy to make. Serve with your favorite fruit at parties, holidays, or any time!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather cream cheese and marshmallow creme."
    },
    {
      "position": 2,
      "text": "Place cream cheese and creme in a medium bowl"
    },
    {
      "position": 3,
      "text": "Blend cream cheese and marshmallow creme with an electric mixer until smooth and well combined."
    },
    {
      "position": 4,
      "text": "Serve with fruit and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

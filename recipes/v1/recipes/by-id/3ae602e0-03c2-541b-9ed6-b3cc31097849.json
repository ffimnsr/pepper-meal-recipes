  "id": "3ae602e0-03c2-541b-9ed6-b3cc31097849",
  "slug": "gluten-free-tuna-casserole",
  "name": "Gluten Free Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "A classic tuna casserole, now gluten free! This comforting dish combines gluten-free rotini with onion, peas, cream, spinach, and tuna, then is topped with gluten-free bread crumbs and baked to crispy, golden perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Add 2 tablespoons olive oil to a pan and saut\u00e9 onions over high heat until slightly translucent, about 4 minutes. Adjust heat to medium. Add peas and spinach and cook until spinach is wilted."
    },
    {
      "position": 3,
      "text": "Add cream to onion mixture. Season with salt and pepper and bring to a simmer. Gently fold in 2/3 of the cheese. Remove from heat."
    },
    {
      "position": 4,
      "text": "Cook pasta according to package directions. Drain pasta and toss with cream sauce and tuna."
    },
    {
      "position": 5,
      "text": "Place pasta mixture in a 9x13-inch baking dish and top with remaining cheese, gluten-free bread crumbs, remaining olive oil, salt, and pepper."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bread crumbs turn crispy and golden, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

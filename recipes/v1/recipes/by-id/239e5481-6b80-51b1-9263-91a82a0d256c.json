  "id": "239e5481-6b80-51b1-9263-91a82a0d256c",
  "slug": "oat-milk",
  "name": "Oat Milk",
  "recipe_type": "dessert",
  "brief_description": "This vegan oat milk is a perfect solution for your coffee, cereal, or just satisfying that cookie-dunking craving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak oats in enough cool water to cover them. Cover and set aside for 30 minutes."
    },
    {
      "position": 2,
      "text": "Drain the oats using a mesh colander. Combine oats, 3 cups water, and dates in a large bowl. Allow to sit undisturbed until skin on the dates softens, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Transfer oat mixture to a blender. Pulse the mixture a few times and then leave on medium-high speed until completely smooth, about 1 minute. Drain oat milk through a nut bag or cheesecloth to remove all solids. Serve cold or warm."
    }
  ],
  "servings": 2,

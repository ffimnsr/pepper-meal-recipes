  "id": "37dca2d3-e6c9-5aec-93aa-e31e2d7ef74c",
  "slug": "maple-granola",
  "name": "Maple Granola",
  "recipe_type": "breakfast",
  "brief_description": "Homemade maple granola with pecans and coconut oil is a hearty and crunchy cereal you can eat alone and sprinkle over yogurt or ice cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix maple syrup and coconut oil together in a bowl; add oats, pecans, and almond flour and mix until evenly coated. Spread onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, about 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,

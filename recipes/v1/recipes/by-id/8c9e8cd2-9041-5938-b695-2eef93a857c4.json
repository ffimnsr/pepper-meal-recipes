  "id": "8c9e8cd2-9041-5938-b695-2eef93a857c4",
  "slug": "amatriciana",
  "name": "Amatriciana",
  "recipe_type": "main",
  "brief_description": "For a quick and flavorful classic, saute bacon or pancetta and add onions, garlic and red pepper flakes. Cook with canned plum tomatoes for a mere 10 minutes, stir in fresh parsley or basil and toss with cooked spaghetti or linguine. Pass the Parmesan and enjoy!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook diced bacon in a large saucepan over medium high heat until crisp, about 5 minutes. Drain all but 2 tablespoons of drippings from the pan."
    },
    {
      "position": 2,
      "text": "Add onions, and cook over medium heat about 3 minutes. Stir in garlic and red pepper flakes; cook 30 seconds. Add canned tomatoes, undrained; simmer 10 minutes, breaking up tomatoes."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook the pasta in a large pot of 4 quarts boiling salted water until al dente. Drain."
    },
    {
      "position": 4,
      "text": "Stir basil into the sauce, and then toss with cooked pasta. Serve with grated Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

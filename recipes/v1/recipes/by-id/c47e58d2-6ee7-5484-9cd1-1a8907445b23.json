  "slug": "classic-overnight-oats",
  "name": "Classic Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Almond Breeze almond milk and oats make a great no-cook oatmeal that you can make for breakfast up to three days in advance.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir together almond milk and oats in a medium bowl. Spoon into 2 small bowls or canning jars if desired. Cover and refrigerate 8 hours to overnight, or for up to 3 days."
    },
    {
      "position": 2,
      "text": "Before eating, top with granola and almonds, if desired."
    }
  ],
  "servings": 2,

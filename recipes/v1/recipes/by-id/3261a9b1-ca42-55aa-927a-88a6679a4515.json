  "id": "3261a9b1-ca42-55aa-927a-88a6679a4515",
  "slug": "sheet-pan-mahi-mahi-fajitas",
  "name": "Sheet Pan Mahi Mahi Fajitas",
  "recipe_type": "main",
  "brief_description": "Mahi mahi, onions, and bell peppers are cooked on a sheet pan with fajita spices resulting in a tasty and easy weeknight meal that can be served in tortillas or over rice.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir olive oil, lemon juice, chili powder, cumin, onion powder, garlic salt, black pepper, and cayenne together in a bowl."
    },
    {
      "position": 3,
      "text": "Spread bell peppers and onion on the prepared sheet pan. Pour 1/2 the marinade over vegetables; toss until well coated."
    },
    {
      "position": 4,
      "text": "Roast vegetables in the preheated oven for 10 minutes."
    },
    {
      "position": 5,
      "text": "While vegetables are cooking, place mahi mahi in a bowl and cover with remaining marinade; toss until well coated. Let sit for 10 minutes."
    },
    {
      "position": 6,
      "text": "Remove vegetables from the oven and set mahi mahi pieces on top. Return to the oven and cook until fish is cooked through and flakes easily with a fork, about 12 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

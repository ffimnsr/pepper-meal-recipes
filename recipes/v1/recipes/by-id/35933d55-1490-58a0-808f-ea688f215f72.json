  "id": "35933d55-1490-58a0-808f-ea688f215f72",
  "slug": "breakfast-margarita-recipe-8742323",
  "name": "Breakfast Margaritas",
  "recipe_type": "breakfast",
  "brief_description": "This breakfast margarita is the freshest, most delicious margarita you can imagine, even better than a mimosa for brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a shaker halfway with ice; pour in tequila, orange liqueur, orange juice, lime juice, and marmalade."
    },
    {
      "position": 3,
      "text": "Shake until the outside of the shaker is frosted, 15 to 30 seconds."
    },
    {
      "position": 4,
      "text": "Pour into a glass; garnish with an orange slice."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 1,

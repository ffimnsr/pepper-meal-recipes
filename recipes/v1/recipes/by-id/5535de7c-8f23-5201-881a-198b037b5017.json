  "slug": "orange-gelatin-salad",
  "name": "Orange Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "An easy orange Jell-O recipe. This is a classic, delicious spin on fruit salad with oranges, pineapple, cottage cheese, whipped topping and Jell-O.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine oranges, pineapple, and gelatin mix in a mixing bowl. Mix well and chill for 30 minutes."
    },
    {
      "position": 3,
      "text": "Add cottage cheese to the fruit mixture; stir to combine."
    },
    {
      "position": 4,
      "text": "Gently fold in whipped topping; chill and serve."
    }
  ],
  "servings": 7,

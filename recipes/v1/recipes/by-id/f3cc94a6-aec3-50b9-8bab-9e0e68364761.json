  "id": "f3cc94a6-aec3-50b9-8bab-9e0e68364761",
  "slug": "dads-asian-slaw",
  "name": "Asian Slaw",
  "recipe_type": "salad",
  "brief_description": "This amazing Asian slaw recipe is super easy to make with prepared slaw mix, crunchy ramen noodles, almonds, green onions, and a zesty vinaigrette.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Crush ramen noodles in a bowl. Stir in seasoning packet, sunflower seeds, almonds, green onions, oil and vinegar dressing, and sugar; mix until sugar is dissolved."
    },
    {
      "position": 3,
      "text": "Place slaw mix into a large salad bowl; pour dressing mixture on top and toss lightly to combine well."
    }
  ],

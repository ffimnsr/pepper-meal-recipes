  "id": "ab52256e-03d3-5bd2-b413-3801faffb61b",
  "slug": "oatmeal-peanut-butter-cookies",
  "name": "Oatmeal Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter oatmeal cookie recipe is loaded with peanut butter flavor and packed with heart-healthy oats for a tasty twist on a classic treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat peanut butter, brown sugar, white sugar, shortening, and margarine in a large bowl with an electric mixer on medium speed until smooth and creamy. Beat in eggs, one at a time, until well blended."
    },
    {
      "position": 3,
      "text": "Combine flour, baking soda, and salt in a separate bowl; stir into creamed mixture until incorporated. Mix in oats until just combined."
    },
    {
      "position": 4,
      "text": "Drop teaspoonfuls of dough onto ungreased cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake cookies in the preheated oven until just lightly browned, 10 to 15 minutes. Do not overbake. Cool and store in an airtight container."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "ef354bc1-62cc-589c-b5e3-7f1858416d0a",
  "slug": "herbed-chicken-shepherds-pie",
  "name": "Herbed Chicken Shepherd\u2019s Pie",
  "recipe_type": "main",
  "brief_description": "Green beans, chicken, herbs, a creamy sauce, and mashed potatoes are the foundation of this variation on the classic shepherd\u2019s pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium-high heat. Saute onion and garlic in hot oil until onion is soft and translucent, 5 to 7 minutes. Stir chicken, chiles, rosemary, and thyme into onion mixture. Cook and stir until chicken is heated through, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir cream of chicken soup and evaporated milk together in a saucepan over medium-high heat until mixture is warm, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Spread green beans into the bottom of an 8-inch square baking dish and pour chicken mixture over the beans. Top chicken layer with cream of chicken soup mixture and spoon mashed potatoes over the top. Sprinkle Parmesan cheese and basil over the mashed potatoes."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until potatoes are lightly golden and casserole is heated through, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

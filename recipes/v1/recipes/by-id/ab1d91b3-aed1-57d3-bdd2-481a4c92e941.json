  "id": "ab1d91b3-aed1-57d3-bdd2-481a4c92e941",
  "slug": "cowboy-lasagna-recipe-8786096",
  "name": "Cowboy Lasagna",
  "recipe_type": "main",
  "brief_description": "This meaty cowboy lasagna, inspired by Trisha Yearwood's recipe, can serve a crowd of cowboys. Pasta sheets are layered with cheese, ground beef, pepperoni, and sausage. Jalapenos bring the heat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large deep skillet over medium-high heat. Add ground beef and sausage and cook, crumbling with a wooden spoon until browned, 5 to 7 minutes. Add jalapeno, onion, and garlic and cook, stirring often, until vegetables are softened, about 3 minutes. Add in pepperoni, tomatoes, tomato paste, oregano, and water and stir until well combined. Season to taste with salt and pepper. Bring to a simmer, reduce heat and cook, uncovered, stirring occasionally while pasta is prepared."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook lasagna noodles in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Coat a 9x13-inch baking dish with cooking spray. Spread a thin layer of sauce over the bottom of the prepared dish. Top with a layer of lasagna noodles, 1/2 of ricotta, and 1/3 of mozzarella cheese. Sprinkle with 1/3 of grated Parmesan cheese and 1/3 of sauce mixture. Repeat that layer once more. Top with remaining sauce, mozzarella cheese, and Parmesan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until browned around the edges and bubbly, about 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "186b7aca-a403-54c5-9818-9c396a3b7811",
  "slug": "ground-beef-pizza-recipe-11994144",
  "name": "Ground Beef Pizza",
  "recipe_type": "main",
  "brief_description": "This ground beef pizza was a fun alternative to our usual pepperoni deluxe! Great way to use up leftover ground beef!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) with a pizza stone set in the center of the oven."
    },
    {
      "position": 2,
      "text": "Spread pizza dough out on a floured work surface to form a 10 to 12 inch circle. Transfer to a pizza peel."
    },
    {
      "position": 3,
      "text": "Spread dough with sauce, then sprinkle with Parmesan cheese. Lay pepperoni slices over Parmesan cheese. Sprinkle with mozzarella. Spoon ground beef over mozzarella and press lightly to adhere."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is golden and cheese is melted and bubbly, 10 to 12 minutes."
    },
    {
      "position": 5,
      "text": "Remove and let stand for 2 minutes before slicing."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "copycat-taco-bell-red-sauce-recipe-12024687",
  "name": "Copycat Taco Bell Red Sauce",
  "recipe_type": "side",
  "brief_description": "This copycat Taco Bell red sauce is the perfect condiment to have on hand for quick Tex-Mex meals. It\u2019s easy to make, stores well in the refrigerator, and adds the signature Taco Bell flavor to everything from tacos and enchiladas to enchiritos and scrambled eggs.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Add tomato sauce, water, vinegar, taco seasoning, and chili powder to a small saucepan and whisk to combine. Bring mixture to a simmer over medium-high heat. Reduce heat to maintain a simmer and cook for 12 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and let cool completely. Store in an airtight container in the refrigerator until ready to use."
    }
  ],

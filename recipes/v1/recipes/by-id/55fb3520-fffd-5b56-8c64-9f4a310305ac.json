  "id": "55fb3520-fffd-5b56-8c64-9f4a310305ac",
  "slug": "keema-aloo-ground-beef-and-potatoes",
  "name": "Keema Aloo (Ground Beef and Potatoes)",
  "recipe_type": "main",
  "brief_description": "Keema aloo is an Indian curry made with ground beef and potatoes, tomatoes, peas, fresh ginger, cilantro, and lots of spices for a flavor-packed meal.",
  "cuisine": "Indian Inspired Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large saucepan over medium-high heat. Add onion; cook and stir until soft and beginning to brown, about 12 minutes. If browned bits of onion are stuck to the bottom of the pan, add water and stir to loosen."
    },
    {
      "position": 3,
      "text": "Stir ground beef, garlic, ginger, serrano chile, and cilantro into the pan; cook and stir until beef is browned and crumbly, 10 to 15 minutes. Reduce heat to medium-low."
    },
    {
      "position": 4,
      "text": "Stir in coriander, salt, cumin, cayenne pepper, and turmeric; cook and stir until flavors blend, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Add potatoes and tomatoes; cover and simmer until potatoes are tender, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Stir in green peas and cook until sauce has slightly thickened and flavors have blended, 10 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Sprinkle garam masala over top, cover, and let stand for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

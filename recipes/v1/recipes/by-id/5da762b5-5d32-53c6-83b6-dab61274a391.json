{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5da762b5-5d32-53c6-83b6-dab61274a391",
  "slug": "giant-cookie-dough-pop-tart-recipe-11860931",
  "name": "Giant Cookie Dough Pop Tart",
  "recipe_type": "dessert",
  "brief_description": "This giant cookie dough pop tart is a puff pastry creation, filled with chocolate chip cookie dough, glazed, and sprinkled to resemble your favorite anytime toaster treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Roll each sheet of puff pastry into a 12x9-inch rectangle. Place 1 puff pastry sheet on the prepared baking sheet and prick all over with a fork. Set the other one on top and refrigerate until ready to assemble."
    },
    {
      "position": 3,
      "text": "For cookie dough, beat butter, brown sugar, white sugar, vanilla, and salt together with an electric mixer until light and fluffy, 1 to 2 minutes. Add egg and mix until combined."
    },
    {
      "position": 4,
      "text": "Add flour and chocolate chips and mix on low until a soft dough forms."
    },
    {
      "position": 5,
      "text": "Remove puff pastry from the refrigerator; set the top layer aside. Spread cookie dough on the layer of puff pastry that was pricked with the fork, leaving a 1/2-inch border around the edges."
    },
    {
      "position": 6,
      "text": "For egg wash, whisk egg and milk together in a small bowl, and brush the exposed edges of the pastry, then add remaining sheet of puff pastry on top; pinch the edges to seal. Crimp with a fork to make a border and poke a few vent holes on top of the pastry. Brush the top of the tart with egg wash."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown and puffed, 20 to 22 minutes. Let cool for 10 minutes."
    },
    {
      "position": 8,
      "text": "For glaze, whisk confectioner\u2019s sugar, brown sugar, warm milk together until smooth. Spread on top of the baked pop tart, again leaving a small border around the edges. Sprinkle the top with mini chocolate chips to finish."
    },
    {
      "position": 9,
      "text": "Let the glaze set for 10 minutes, then cut the poptart into squares."
    },
    {
      "position": 10,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

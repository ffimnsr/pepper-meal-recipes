  "id": "c0039b40-71f1-5c84-94f3-1db5b31221b8",
  "slug": "kellys-ham-jell-o-salad",
  "name": "Kelly's Ham Jell-O Salad",
  "recipe_type": "salad",
  "brief_description": "This savory Jell-O salad is made with cabbage, chopped ham, mayonnaise, and spicy brown mustard.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve lemon gelatin in boiling water in a large bowl. Pour reserved pineapple juice and white wine vinegar into a measuring cup; add enough cold water to measure 1 cup. Stir water-juice mixture into gelatin mixture; refrigerate until cold and beginning to set, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Stir mayonnaise and spicy brown mustard together in a bowl; whisk mayonnaise mixture into cooled lemon gelatin mixture until smooth. Gently fold cabbage, ham, celery, and reserved pineapple into gelatin. Transfer mixture into a ring-shaped gelatin mold."
    },
    {
      "position": 3,
      "text": "Chill in the refrigerator until firmly set, about 4 hours."
    },
    {
      "position": 4,
      "text": "To serve, dip the gelatin mold into hot water to loosen the sides; place a plate on top of the mold, invert, and gently lift the mold from salad."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

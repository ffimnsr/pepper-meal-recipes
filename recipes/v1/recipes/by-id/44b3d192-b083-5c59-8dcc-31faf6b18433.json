  "slug": "indian-summer-raspberry-peach-sangria",
  "name": "Indian Summer Raspberry Peach Sangria",
  "recipe_type": "drink",
  "brief_description": "Red wine, peach schnapps, and raspberry soda water are the primary ingredients in this Indian summer sangria punch recipe with fresh fruit and juices.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Stir red wine, raspberry-flavored soda water, peach schnapps, pomegranate juice, and lemon juice together in a large pitcher or punch bowl; add peaches, lemons, raspberries, and oranges. Float ice cubes in sangria to chill."
    }
  ],

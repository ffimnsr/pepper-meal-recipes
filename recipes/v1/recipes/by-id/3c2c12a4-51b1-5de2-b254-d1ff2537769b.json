  "id": "3c2c12a4-51b1-5de2-b254-d1ff2537769b",
  "slug": "crab-quiche-i",
  "name": "Easy Crab Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This seafood quiche with crabmeat, Swiss cheese, onion, and eggs is easy to make in a prepared pie crust for a wonderful brunch or light dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat eggs, mayonnaise, flour, and milk in a medium bowl until thoroughly blended. Stir in crab, cheese, and onion; transfer into pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 40 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,

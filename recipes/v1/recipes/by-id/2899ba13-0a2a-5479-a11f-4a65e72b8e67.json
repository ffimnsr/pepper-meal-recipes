  "id": "2899ba13-0a2a-5479-a11f-4a65e72b8e67",
  "slug": "tuna-pasta-salad",
  "name": "Tuna Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This delightful salad is a quick and easy toss of delicate sea shell pasta, chopped lettuce, sliced scallions, canned tuna, peas and Cheddar cheese. Pour in your favorite mayonnaise or creamy salad dressing to finish the dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a boil. Stir in seashell pasta, and return to a boil. Cook pasta uncovered, stirring occasionally, until cooked through, but still firm to the bite, about 11 minutes; drain."
    },
    {
      "position": 2,
      "text": "Place green onions and lettuce in a large bowl. Add pasta, tuna, peas, and grated Cheddar cheese; mix well. Stir in dressing; toss to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

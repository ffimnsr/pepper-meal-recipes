  "id": "a4172ace-769b-53e7-9073-82e8d7e1f41e",
  "slug": "sloe-gin-fizz-cocktail",
  "name": "Sloe Gin Fizz Cocktail",
  "recipe_type": "dessert",
  "brief_description": "This sloe gin fizz uses a red liquor made from blackthorn berries mixed with club soda, sugar, and lemon juice for a refreshing, sweet-tart cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 2 ice cubes into a highball glass and set aside in the freezer."
    },
    {
      "position": 2,
      "text": "Combine sloe gin, lemon juice, and simple syrup in a cocktail shaker. Add 1 cup ice; cover and shake until the outside of the shaker is frosted. Strain into the prepared highball glass."
    },
    {
      "position": 3,
      "text": "Stir in club soda and garnish with a slice of lemon."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

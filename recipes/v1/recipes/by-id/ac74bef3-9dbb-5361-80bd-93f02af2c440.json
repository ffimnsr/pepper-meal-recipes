  "schema_version": 1,
  "id": "ac74bef3-9dbb-5361-80bd-93f02af2c440",
  "slug": "rattlesnake-pasta",
  "name": "Pasta with Veggies and Rattlesnake Meat",
  "recipe_type": "main",
  "brief_description": "This creamy pasta recipe features rattlesnake meat but can be made with chicken if it suits your tastes. It is loaded with summer vegetables and Cajun spices for a satisfying meal.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Cook pasta: Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine in boiling water until tender yet firm to the bite, about 8 minutes; drain."
    },
    {
      "position": 2,
      "text": "Make sauce: Heat oil in a large skillet over medium-high heat. Cook and stir mushrooms, zucchini, squash, and onions in hot oil until vegetables are heated through but still firm, about 5 minutes. Pour in cream and cooked fettuccine; simmer for 4 minutes. Mix in jalapeño, mustard, Cajun seasoning, and garlic; cook for 1 minute. Stir in Parmesan cheese and tomatoes. Reduce heat to low to keep warm."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook rattlesnake: Heat oil in a large skillet over high heat. Dredge rattlesnake meat in flour and fry in hot oil until cooked through, about 5 minutes. An instant-read thermometer inserted into the center of meat should read at least 165 degrees F (74 degrees C). Arrange on top of pasta to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5dbc09ed-c180-5a6d-89b4-7e793200600a",
  "slug": "strawberry-and-rhubarb-shortcakes",
  "name": "Strawberry and Rhubarb Shortcakes",
  "recipe_type": "dessert",
  "brief_description": "Fresh rhubarb and strawberries combine to make the perfect filling for rectangular-shaped biscuits in this homemade shortcake recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir together rhubarb, sugar, limoncello, and cornstarch for filling in a saucepan just until cornstarch dissolves. Bring to a simmer over medium heat. Cook, stirring, until rhubarb is softened and mixture is slightly thickened, 6 to 8 minutes. Remove from the heat and stir in strawberries."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Whisk together flour, white sugar, baking powder, baking soda, and salt for biscuits in a large bowl. Add butter and stir until coated. Cut in butter with 2 knives or a pastry blender until mixture resembles coarse, wet sand. (It should hold together when squeezed, then crumble away.)"
    },
    {
      "position": 4,
      "text": "Whisk together buttermilk, egg, and vanilla in a small bowl; pour into the flour mixture and quickly stir with a fork. When mixture begins to hold together, transfer to a floured surface."
    },
    {
      "position": 5,
      "text": "Knead just until a dough ball forms. Press into a 7x10-inch rectangle about 1/2 inch thick. Fold into thirds, then press into a 5x7-inch rectangle about 1 inch thick."
    },
    {
      "position": 6,
      "text": "Cut dough into 8 biscuits and arrange 1 1/2 inches apart on the prepared baking sheet. Brush with whipping cream and sprinkle with coarse sugar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden, 12 to 14 minutes. Transfer to a wire rack. Let cool about 15 minutes."
    },
    {
      "position": 8,
      "text": "Slice biscuits in half; serve with filling and whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,

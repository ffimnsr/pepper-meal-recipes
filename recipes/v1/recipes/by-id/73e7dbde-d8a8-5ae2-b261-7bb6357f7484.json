  "slug": "ginnys-cauliflower-and-pea-salad",
  "name": "Ginny\u2019s Cauliflower and Pea Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy cauliflower salad with peas, cheese, and bacon in a tangy dressing is an easy side dish ready in 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss together cauliflower, peas, onion, and celery in a large bowl. Mix in Cheddar, Parmesan, and bacon bits."
    },
    {
      "position": 2,
      "text": "Mix mayonnaise, sour cream, sweetener, vinegar, mustard, and seasoned salt in a separate bowl. Pour over vegetables and mix well."
    }
  ],

  "id": "a2962c61-8d0f-5495-bd8f-9768e8ae84c7",
  "slug": "peach-preserves",
  "name": "Peach Preserves",
  "recipe_type": "dessert",
  "brief_description": "This peach jam recipe is easy to make with just 3 ingredients so you can enjoy homemade preserves with the flavor of sweet summer peaches all year!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Crush 1 cup of chopped peaches in the bottom of a large saucepan. Add remaining peaches and set the pan over medium-low heat."
    },
    {
      "position": 3,
      "text": "Bring to a low boil and cook until peaches become liquid with a few bits of peach left, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Pour cooked peaches into a bowl, then measure 6 cups of peaches back into the pan (reserving any remaining peaches for another use). Add sugar and bring to a boil over medium heat."
    },
    {
      "position": 5,
      "text": "Gradually stir in dry pectin; boil for 1 minute."
    },
    {
      "position": 6,
      "text": "Remove from heat and pack jam into hot, sterilized jars, filling to within 1/4 inch of the top. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue."
    },
    {
      "position": 7,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes."
    },
    {
      "position": 8,
      "text": "Carefully remove jars from stockpot and let jam cool, then store on a shelf in a cool, dark place. Serve and enjoy!"
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

  "id": "b525bb5a-fc4e-5ec1-88df-639a3dcdc695",
  "slug": "vegan-spinach-artichoke-dip",
  "name": "Vegan Spinach Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Perfect for parties, this vegan dip packs all the taste of traditional spinach artichoke dip minus the dairy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix artichoke hearts, cream cheese spread, spinach, flour, garlic salt, thyme, and red pepper flakes together in a large bowl."
    },
    {
      "position": 3,
      "text": "Coat a large nonstick baking pan with cooking spray; fill pan with the artichoke mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until center is hot and dip is bubbling, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Sprinkle the top of the dip with Parmesan-style cheese."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

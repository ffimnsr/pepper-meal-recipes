  "id": "12347f45-4f53-5a50-a900-5af21b8869a2",
  "slug": "vegan-stuffed-mushrooms",
  "name": "Vegan Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These vegan stuffed mushrooms are filled with cashew cream, finely chopped mushroom stems, and nutritional yeast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak cashews in water for 1 to 2 hours. Drain."
    },
    {
      "position": 2,
      "text": "Blend cashews with 1 cup water until creamy. Add 1 to 2 tablespoons more water if needed to blend well."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 4,
      "text": "Clean mushrooms with a damp paper towel. Carefully break off stems and reserve the caps. Chop stems very finely, discarding tough ends."
    },
    {
      "position": 5,
      "text": "Heat oil in a large skillet over medium heat. Add chopped mushroom stems and garlic to the skillet. Fry until any moisture has disappeared, taking care not to burn garlic, about 3 minutes. Set aside to cool."
    },
    {
      "position": 6,
      "text": "Stir cashew cream, nutritional yeast, salt, black pepper, onion powder, and cayenne pepper into the cooled mushroom mixture. Use a little spoon to fill each mushroom cap with a generous amount of stuffing. Arrange the mushroom caps on the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until mushrooms are piping hot and liquid starts to form under the caps, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

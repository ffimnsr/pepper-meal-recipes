  "name": "Easiest Brown Gravy Ever",
  "recipe_type": "soup",
  "brief_description": "If your pantry is stocked with canned cream of mushroom soup, beef gravy, and Marsala wine, tasty gravy is always just minutes away.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together condensed soup, beef gravy, and Marsala wine in a saucepan. Bring to a simmer over medium heat and cook for 10 minutes, whisking frequently. Season with kosher salt before serving."
    }

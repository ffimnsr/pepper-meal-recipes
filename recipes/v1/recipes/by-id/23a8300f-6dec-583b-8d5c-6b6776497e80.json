  "id": "23a8300f-6dec-583b-8d5c-6b6776497e80",
  "slug": "chicken-and-rice-casserole",
  "name": "Chicken and Rice Casserole",
  "recipe_type": "soup",
  "brief_description": "Chicken breasts, rice, French onion soup mix, and cream of mushroom soup are all you need to make this easy chicken and rice casserole.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread rice into a casserole dish. Lay chicken breasts onto the bed of rice. Sprinkle French onion soup mix over the chicken. Pour cream of mushroom soup over the chicken. Cover casserole dish with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 45 minutes. Remove aluminum foil and continue baking until the rice is tender and the chicken no longer pink in the center, about 15 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

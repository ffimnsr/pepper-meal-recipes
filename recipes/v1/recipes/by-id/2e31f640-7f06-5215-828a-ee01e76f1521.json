  "id": "2e31f640-7f06-5215-828a-ee01e76f1521",
  "slug": "beef-with-vegetables",
  "name": "Beef with Vegetables",
  "recipe_type": "main",
  "brief_description": "Fresh ginger, oyster sauce, and soy sauce give this dish its flavor. Beef strips are stir-fried with vegetables, which may be varied to suit individual tastes.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet over medium high heat, saute the beef slices in the oil for 5 minutes, or until well browned. Add the onion, garlic and ginger and saute for 5 more minutes. Then add the green bell pepper, carrot and beef broth. Reduce heat to low and let simmer."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a separate small bowl, combine the corn flour, sugar, soy sauce and oyster sauce, if desired. Stir thoroughly, forming a smooth paste. Slowly add this to the simmering beef and vegetables, stirring well, and let simmer to desired thickness. Season with salt and pepper to taste."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

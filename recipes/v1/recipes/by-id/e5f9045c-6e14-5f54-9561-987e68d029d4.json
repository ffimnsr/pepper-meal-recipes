  "slug": "couscous-salad-with-kale-tomatoes-cranberries-and-feta",
  "name": "Couscous Salad with Kale, Tomatoes, Cranberries, and Feta",
  "recipe_type": "salad",
  "brief_description": "Full of color and wholesome ingredients, this couscous salad with kale, tomatoes, cranberries, and feta cheese is perfect to make ahead and eat for lunch throughout the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove kale leaves from stems; finely chop leaves and massage with oil in a large bowl until dark green and fragrant, about 30 seconds. Add cherry tomatoes and sprinkle with kosher salt. Add feta cheese, cranberries, couscous, pumpkin seeds, and sunflower seeds."
    },
    {
      "position": 2,
      "text": "Squeeze lemon juice over ingredients and toss until blended."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

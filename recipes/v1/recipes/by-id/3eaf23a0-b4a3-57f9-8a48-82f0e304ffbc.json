  "id": "3eaf23a0-b4a3-57f9-8a48-82f0e304ffbc",
  "slug": "rhubarb-margarita",
  "name": "Rhubarb Margarita",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb margarita, made in a blender with fresh rhubarb \u201cjuice\u201d, sugar, ice, and tequila, is a fabulous sweet-tart combo \u2014 perfect on a hot day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring rhubarb and water to a simmer in a saucepan, covered, over medium heat. Reduce heat to medium-low; continue simmering until rhubarb breaks down and releases its juices, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Strain rhubarb mixture through a fine-mesh sieve, pressing pulp to squeeze out as much juice as possible. Discard pulp. Stir sugar into hot juice. Refrigerate rhubarb syrup until very cold, at least 2 hours."
    },
    {
      "position": 3,
      "text": "Place ice into a blender; pour in rhubarb syrup and tequila. Cover and blend until mixture is smooth or until your desired consistency. Pour into chilled margarita glasses."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

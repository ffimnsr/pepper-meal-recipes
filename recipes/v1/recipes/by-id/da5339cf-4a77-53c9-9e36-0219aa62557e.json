  "id": "da5339cf-4a77-53c9-9e36-0219aa62557e",
  "slug": "guava-mojito",
  "name": "Guava Mojito",
  "recipe_type": "drink",
  "brief_description": "Passion fruit rum and guava nectar bring a fruity flavor to traditional mojitos using this super simple recipe perfect for warm evenings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a glass with ice."
    },
    {
      "position": 2,
      "text": "Muddle 3 sprigs mint and sugar together in a cocktail shaker; add ice, rum, lime juice, and guava nectar. Cover and shake 10 times. Strain drink into glass filled with ice; add club soda and garnish with 1 mint sprig."
    }
  ],

  "id": "4e617787-c785-5d0d-ac1e-dbc3839e1cac",
  "slug": "pumpkin-cranberry-bread",
  "name": "Pumpkin Cranberry Bread",
  "recipe_type": "dessert",
  "brief_description": "This moist pumpkin cranberry bread is flavored with pumpkin spice, tangy cranberries, and walnuts for a delicious addition to your holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans (or 4 mini loaf pans)."
    },
    {
      "position": 2,
      "text": "Combine flour, pumpkin pie spice, baking powder, and salt in a mixing bowl."
    },
    {
      "position": 3,
      "text": "Combine sugar, pumpkin pur\u00e9e, eggs, and oil in a small mixing bowl. Beat until just blended."
    },
    {
      "position": 4,
      "text": "Stir the wet mixture into the dry with a wooden spoon until batter is just moistened. Fold cranberries and walnuts into the batter. Spoon the batter into the prepared loaf pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 to 60 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

  "slug": "greek-salad-i",
  "name": "Greek Salad",
  "recipe_type": "salad",
  "brief_description": "This Greek salad recipe with cucumber, tomatoes, feta cheese, and an easy and refreshing oregano and olive oil dressing makes a standout summer salad!",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Combine romaine, cucumber, tomatoes, olives, bell peppers, and red onion in a large bowl; sprinkle with feta cheese."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, lemon juice, oregano, and black pepper together in a small bowl. Pour dressing over salad, toss well to combine, and serve."
    },
    {
      "position": 3,
      "text": "Pour dressing over salad, toss well to combine, and serve."
    }
  ],

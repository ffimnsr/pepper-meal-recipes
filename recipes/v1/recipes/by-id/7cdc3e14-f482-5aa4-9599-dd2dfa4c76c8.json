  "id": "7cdc3e14-f482-5aa4-9599-dd2dfa4c76c8",
  "slug": "real-hummus",
  "name": "Real Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This classic hummus recipe is easy to make by blending chickpeas, garlic, tahini, and lemon for a wonderful homemade snack or appetizer.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Chop garlic in a blender."
    },
    {
      "position": 2,
      "text": "Pour chickpeas into the blender, reserving about 1 tablespoon for garnish. Add reserved liquid, lemon juice, tahini, and salt to taste; blend until creamy and well mixed."
    },
    {
      "position": 3,
      "text": "Transfer mixture to a medium serving bowl. Drizzle olive oil and sprinkle pepper over the top. Garnish with reserved chickpeas."
    }
  ],
  "servings": 20,

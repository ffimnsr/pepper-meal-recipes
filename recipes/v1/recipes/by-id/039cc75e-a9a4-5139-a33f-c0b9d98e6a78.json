  "id": "039cc75e-a9a4-5139-a33f-c0b9d98e6a78",
  "slug": "vegan-refried-beans",
  "name": "Vegan Refried Beans",
  "recipe_type": "soup",
  "brief_description": "Canned pinto beans are simmered with onions, tomato paste, chili powder and vegetable broth, then mashed. It's a quick and easy way to make your own refried beans for burritos, tostadas or dips!",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a medium skillet over medium heat. Saute onions until tender. Stir in beans, tomato paste, chili powder and vegetable broth. Cook 5 minutes, or until stock has reduced. Mash with a potato masher."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

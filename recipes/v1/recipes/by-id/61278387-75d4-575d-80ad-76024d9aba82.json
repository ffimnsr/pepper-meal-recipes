  "slug": "simple-waldorf-salad",
  "name": "Simple Waldorf Salad",
  "recipe_type": "salad",
  "brief_description": "Who doesn\u2019t love a crunchy Waldorf salad? This recipe combines apples, celery, raisins, and walnuts in a creamy mayo and vinegar dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise and vinegar together in a mixing bowl."
    },
    {
      "position": 2,
      "text": "Add apples, celery, raisins, and walnuts. Season with salt and pepper; mix well."
    },
    {
      "position": 3,
      "text": "Chill salad before serving, at least 30 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,

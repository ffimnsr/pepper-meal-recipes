  "id": "739bd801-cdbd-5026-9a1f-397fed183a86",
  "slug": "south-african-inspired-butternut-soup",
  "name": "South African-Inspired Butternut Soup",
  "recipe_type": "soup",
  "brief_description": "Nutty butternut squash, onion, mild elephant garlic, and jalapeno combine to create incredible flavor in this easy South African-inspired soup recipe.",
  "cuisine": "South African",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a saucepan over medium heat. Add onions, jalapeno, and elephant garlic and cook until onions are soft and transparent, about 5 minutes. Stir in chicken stock and lemon juice until well mixed. Add butternut squash and water; bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce heat and simmer until squash is tender and soup is thick, about 1 hour. Puree with an immersion blender until smooth."
    },
    {
      "position": 3,
      "text": "Ladle hot soup into bowls and swirl cream in the center of each bowl just before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

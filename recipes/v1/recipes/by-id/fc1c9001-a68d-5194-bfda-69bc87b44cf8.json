  "id": "fc1c9001-a68d-5194-bfda-69bc87b44cf8",
  "slug": "land-of-nod-cinnamon-buns",
  "name": "Land of Nod Cinnamon Buns",
  "recipe_type": "breakfast",
  "brief_description": "Cinnamon buns made with frozen rolls are easy-to-make treats that rise overnight, then bake up with brown sugar, pudding mix, cinnamon, and raisins.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease a 10-inch Bundt pan. Place frozen rolls into the prepared pan and sprinkle with brown sugar, pudding mix, and cinnamon. Top with raisins. Pour melted butter over rolls. Cover the pan with a clean, damp dish cloth and let sit at room temperature for 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 25 minutes. Turn rolls out onto a serving plate and serve warm."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "4ec5a008-728a-5b80-ac5b-0c4a0fc29aaf",
  "slug": "tzatziki-chicken-salad-recipe-11784625",
  "name": "Tzatziki Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This tzatziki chicken salad has all the cool, creamy, crunchy flavors of classic tzatziki sauce with the added bonus of chicken, making it the perfect quick lunch or mid-day snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place 1/2 cup grated cucumber between 2 paper towels, and gently squeeze to remove excess moisture. Transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Add yogurt, lemon juice, dill, mayonnaise, oil, garlic, pepper, and salt to bowl with cucumber and stir until fully combined."
    },
    {
      "position": 4,
      "text": "Fold in chicken, feta, onion, and 1 1/2 cups diced cucumber until evenly coated; garnish with additional dill. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

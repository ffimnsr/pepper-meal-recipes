  "id": "9e80baaa-b4f9-530c-9e0e-62217665586d",
  "slug": "roasted-asparagus-with-parmesan",
  "name": "Roasted Asparagus with Parmesan",
  "recipe_type": "side",
  "brief_description": "This cheesy, garlicky Parmesan asparagus recipe is one of the easiest ways to cook fresh spring asparagus for a flavorful roasted vegetable side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray the inside of a 9x13 casserole dish with olive oil cooking spray. Place asparagus in the dish and lightly spray spears with cooking spray."
    },
    {
      "position": 3,
      "text": "Sprinkle asparagus with Parmesan cheese, sea salt, and garlic powder."
    },
    {
      "position": 4,
      "text": "Roast in preheated oven until fork easily punctures thickest part of stem, about 12 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

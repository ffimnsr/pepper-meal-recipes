  "slug": "cauliflower-and-broccoli-salad-with-honey-soy-dressing-recipe-8741564",
  "name": "Cauliflower and Broccoli Salad with Honey-Soy Dressing",
  "recipe_type": "salad",
  "brief_description": "This vibrant veggie dish brings together crisp red cabbage, crunchy cauliflower and broccoli, and a tangy orange-tamari dressing. The flavors deepen as the salad chills, making it easy to make ahead for holiday get-togethers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, whisk together juice, tamari, canola oil, honey, zest, garlic, sesame oil, salt, and crushed red pepper. Add red cabbage and cauliflower and/or broccoli; toss to coat."
    },
    {
      "position": 2,
      "text": "Let stand 30 minutes, stirring occasionally. Just before serving, top with almonds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

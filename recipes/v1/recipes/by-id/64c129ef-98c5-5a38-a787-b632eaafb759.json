  "id": "64c129ef-98c5-5a38-a787-b632eaafb759",
  "slug": "peanut-butter-granola-from-pam",
  "name": "Peanut Butter Granola from PAM\u00ae",
  "recipe_type": "breakfast",
  "brief_description": "A classic chunky granola with a hint of peanut butter. Delicious on its own, in a bowl with milk, or tossed into yogurt or a trail mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F. Spray large baking sheet with cooking spray; set aside."
    },
    {
      "position": 2,
      "text": "Combine peanut butter, oil and honey in small saucepan. Heat on low until smooth and pourable. Meanwhile, process 1 cup of oats in blender or food processor until finely ground. Combine ground oats with remaining oats, sugar and salt in large bowl. Pour warm peanut butter mixture over oat mixture and stir well. Pour onto prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake 30 minutes, stirring every 10 minutes. Let cool 10 minutes, break into chunks and allow to cool completely on baking sheet. Store in airtight container at room temperature for up to 7 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

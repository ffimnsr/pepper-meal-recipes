  "id": "2cf95869-de19-519e-950a-5ceb70b58914",
  "slug": "crispy-cereal-mix",
  "name": "Crispy Cereal Mix",
  "recipe_type": "appetizer",
  "brief_description": "This great cereal mix is another version of the favorite crispy cereal party mix that everyone loves!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (120 degrees C). Melt the margarine in a 9x13 inch baking pan."
    },
    {
      "position": 2,
      "text": "Remove baking pan from oven. Stir in the Worcestershire sauce, garlic powder, seasoning salt and onion powder. Gradually mix in the nuts, pretzels, bagel chips, crispy corn cereal squares, crispy rice cereal squares, and crispy wheat cereal squares. Evenly coat all ingredients."
    },
    {
      "position": 3,
      "text": "Bake approximately 1 hour in the preheated oven. Drain on paper towels."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

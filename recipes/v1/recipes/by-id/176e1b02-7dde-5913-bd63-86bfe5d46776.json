  "id": "176e1b02-7dde-5913-bd63-86bfe5d46776",
  "slug": "roasted-mushroom-soup",
  "name": "Roasted Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "This roasted mushroom soup is a mushroom lover's dream. Flavored with rosemary and thyme, this rich and creamy soup is both easy and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix mushrooms, 1 clove minced garlic, rosemary, and salt together in a bowl. Drizzle olive oil over the mushroom mixture and toss to coat evenly; transfer to a baking sheet."
    },
    {
      "position": 3,
      "text": "Roast mushrooms in the preheated oven until golden brown, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt butter in a large saucepan over medium heat. Stir onions, remaining cloves minced garlic, and thyme into melted butter; cook and stir until onions are completely soft, 7 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Combine mushroom mixture and onion mixture in the bowl of a blender or food processor with about 1/2 of the heavy cream; blend on low until combined yet slightly chunky. Return the blended mixture to the stockpot. Stir remaining heavy cream, chicken broth, milk, and black pepper through the blended mixture. Bring the soup to a simmer and cook until the flavors are thoroughly combined, at least 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9dc29432-4f6b-5662-a0ba-d12b70f9f474",
  "slug": "slow-cooker-stuffed-peppers",
  "name": "Slow Cooker Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "Bell peppers stuffed with ground beef, rice, and tomatoes can be made in the slow cooker for an easy weeknight meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 2,
      "text": "Mix ground beef, tomatoes, rice, ketchup, Worcestershire sauce, and black pepper together in a bowl."
    },
    {
      "position": 3,
      "text": "Stuff each green bell pepper with ground beef mixture."
    },
    {
      "position": 4,
      "text": "Arrange stuffed bell peppers in the crock of a slow cooker; place the reserved tops back onto each bell pepper. Pour water around the base of each stuffed bell pepper."
    },
    {
      "position": 5,
      "text": "Cook on Low for 6 to 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 365,

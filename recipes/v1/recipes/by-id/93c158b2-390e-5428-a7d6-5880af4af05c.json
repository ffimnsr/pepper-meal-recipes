  "id": "93c158b2-390e-5428-a7d6-5880af4af05c",
  "slug": "chocolate-bar-torte",
  "name": "Chocolate Bar Torte",
  "recipe_type": "dessert",
  "brief_description": "A fluffy chocolate and marshmallow cream filling tops a graham cracker crust for a dessert that's been a family holiday favorite for over 50 years.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour both amounts of milk into a saucepan, place over medium heat, and bring milk almost to a simmer, stirring often. Add marshmallows and chocolate candy bars. Stir until marshmallows and chocolate melt and the mixture is smooth. Set aside to cool."
    },
    {
      "position": 2,
      "text": "Whip cream in a large bowl until fluffy and cream holds stiff peaks when beaters are lifted straight up, about 5 minutes. Gently fold cooled marshmallow mixture into whipped cream."
    },
    {
      "position": 3,
      "text": "Combine graham cracker crumbs, sugar, and butter until crust mixture is evenly moist. Press mixture into the bottom of a 9x13-inch dish. Spread marshmallow filling evenly over the crumb crust. Refrigerate until set, about 2 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "2dbd4be9-b27b-561b-9a1c-5fd0acad0a53",
  "slug": "mexican-strawberry-water-agua-de-fresa",
  "name": "Mexican Strawberry Agua Fresca",
  "recipe_type": "drink",
  "brief_description": "Strawberry agua fresca is a refreshing blend of juicy strawberries, sugar, and water, served chilled over ice for a deliciously fruity Mexican drink.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together strawberries, sugar, and 1 cup cold water in a medium bowl. Cover the bowl with plastic wrap and place in the refrigerator for 4 hours."
    },
    {
      "position": 3,
      "text": "Pour chilled strawberry mixture into a blender. Blend on high until smooth."
    },
    {
      "position": 4,
      "text": "Pour through a wire mesh strainer set over a large bowl; discard pulp and seeds."
    },
    {
      "position": 5,
      "text": "Stir remaining 7 cups cold water into strawberry juice until aqua de fresa is well combined."
    },
    {
      "position": 6,
      "text": "Fill glasses with ice. Pour aqua de fresa over ice. Garnish each serving with lime wedges and mint leaves."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

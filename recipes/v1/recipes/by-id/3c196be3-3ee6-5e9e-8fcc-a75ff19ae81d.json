  "id": "3c196be3-3ee6-5e9e-8fcc-a75ff19ae81d",
  "slug": "homemade-teriyaki-sauce",
  "name": "Homemade Teriyaki Sauce",
  "recipe_type": "side",
  "brief_description": "This quick homemade teriyaki sauce simmers soy, vinegar, and spices together until thick and glossy for chicken, veggies, or your favorite stir fry.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, sugar, vinegar, water, garlic powder, onion powder, and ground ginger in a saucepan over medium heat."
    },
    {
      "position": 2,
      "text": "Add cornstarch and mix thoroughly to dissolve. Cook until bubbles start to appear, about 3 minutes. Reduce heat to low. Simmer until thickened, 5 to 10 minutes, stirring frequently."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

  "id": "cc2c4b83-688a-52d8-b51e-661a040f17a3",
  "slug": "animal-style-walking-nachos-recipe-11978284",
  "name": "Animal Style Walking Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These animal style walking nachos hit every flavor note. They are savory, tangy, cheesy, and ridiculously craveable. The seasoned beef and melted American cheese give that classic animal-style richness. While the pickles and sauce add that perfect briny flavor. Every bite has a combination of crunchy, messy textures that keep you wanting more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium-low heat. Add onions and saut\u00e9 until soft and caramelized, about 5 minutes. Transfer to a bowl and set aside."
    },
    {
      "position": 2,
      "text": "Add ground beef to the same skillet and cook until browned, crumbly, and cooked through, about 5 minutes. Drain excess fat. Stir in ketchup, mustard, garlic powder, onion powder, paprika, salt, and pepper with a splash of water. Allow to cook for 1 more minute. Remove from heat."
    },
    {
      "position": 3,
      "text": "Lay potato chip bag on a work surface. Use a sharp knife to carefully poke a hole in the center. Cut bag in criss-cross sections as shown. Fold open flaps to open up the bag to the chips."
    },
    {
      "position": 4,
      "text": "Arrange hot beef on top of the chips. Layer American cheese, caramelized onions and 1/4 cup chopped pickles on top."
    },
    {
      "position": 5,
      "text": "Whisk together mayonnaise, ketchup, mustard, pickle brine, 2 tablespoons chopped pickles, onion powder, garlic powder, salt, and paprika in a small bowl for the sauce. Drizzle sauce over walking nachos. Garnish with fresh dill and enjoy!"
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

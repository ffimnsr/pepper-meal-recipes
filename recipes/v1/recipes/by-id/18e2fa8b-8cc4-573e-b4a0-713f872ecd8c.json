  "id": "18e2fa8b-8cc4-573e-b4a0-713f872ecd8c",
  "slug": "fresh-cherry-cobbler",
  "name": "Fresh Cherry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This cherry cobbler recipe is made with fresh cherries and pantry staples for a comforting summer dessert. Pitting the cherries will be worth it!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butter in a 9x13-inch baking dish, and place in the oven to melt while the oven is preheating. Remove as soon as butter has melted, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir together 1 cup flour, 1 cup sugar, and baking powder in a medium bowl. Mix in milk until well blended, then pour the batter into the pan over the melted butter. Do not stir."
    },
    {
      "position": 4,
      "text": "Rinse out the bowl from the batter, and dry. Place cherries into the bowl, and toss with remaining 3/4 cup sugar and 1 tablespoon flour. Distribute the cherry mixture evenly over the batter. Do not stir."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 50 to 60 minutes. A toothpick inserted into the cobber should come out clean."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,

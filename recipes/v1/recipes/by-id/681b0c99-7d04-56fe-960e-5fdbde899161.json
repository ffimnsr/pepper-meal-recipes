  "id": "681b0c99-7d04-56fe-960e-5fdbde899161",
  "slug": "campbells-kitchen-beef-stroganoff",
  "name": "Campbell\u2019s Kitchen Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "Always a family favorite, this classic dish of quickly sauteed beef and onion in a creamy mushroom sauce is perfect over hot cooked noodles. Garnish with fresh parsley for a colorful table presence and serve with a family favorite green vegetable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice beef into very thin strips."
    },
    {
      "position": 2,
      "text": "Heat half the oil in skillet over medium-high heat. Cook beef until browned, stirring often. Set beef aside."
    },
    {
      "position": 3,
      "text": "Add remaining oil. Add onion and cook over medium heat until tender. Pour off fat."
    },
    {
      "position": 4,
      "text": "Add soup and paprika. Heat to a boil. Stir in sour cream and return beef to skillet. Heat through. Serve over noodles. Sprinkle with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

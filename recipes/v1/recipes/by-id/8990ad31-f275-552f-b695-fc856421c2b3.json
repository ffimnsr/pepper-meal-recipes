  "id": "8990ad31-f275-552f-b695-fc856421c2b3",
  "slug": "quick-and-easy-british-fruitcake",
  "name": "Quick and Easy British Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "Easy to prep in just one bowl, this easy British tea time fruitcake is studded with dried fruit and covered in a crunchy brown sugar topping.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 6-inch round cake pan."
    },
    {
      "position": 2,
      "text": "Place flour in a bowl. Rub butter into the flour until mixture resembles fine bread crumbs. Add mixed fruit, 1 cup plus 1 tablespoon sugar, and mixed spice. Stir to combine. Add milk and egg and mix until batter is soft and easy to drop."
    },
    {
      "position": 3,
      "text": "Drop batter into the prepared pan. Sprinkle light brown sugar on top and pat down with the back of a spoon."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 1 to 1 1/4 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

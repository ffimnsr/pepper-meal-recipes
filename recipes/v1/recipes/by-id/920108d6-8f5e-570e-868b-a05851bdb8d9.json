{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "920108d6-8f5e-570e-868b-a05851bdb8d9",
  "slug": "daves-rhubarb-custard-pie-with-meringue",
  "name": "Dave's Rhubarb Custard Pie with Meringue",
  "recipe_type": "dessert",
  "brief_description": "Dave's delicate rhubarb custard pie recipe features yolks in its filling for a rhubarb-flavored custard and egg whites in its fluffy meringue topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pie crust in a 9-inch pie plate; line with a double layer of aluminum foil and a layer of pie weights or dried beans."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven until edges are golden, about 10 minutes. Carefully remove foil and weights; continue baking until crust sets, about 5 minutes more. Cool crust."
    },
    {
      "position": 4,
      "text": "Reduce the oven temperature to 325 degrees F (165 degrees C); place a rack in the center position."
    },
    {
      "position": 5,
      "text": "Combine rhubarb, 1 \u2153 cups sugar, butter, and food coloring in a large saucepan over medium heat; simmer until rhubarb is tender and just starting to fall apart, 7 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Whisk 6 tablespoons sugar, egg yolks, light cream, cornstarch, and salt together in a medium bowl until well combined; add to rhubarb mixture, stirring constantly. Simmer and stir until mixture starts to thicken, 3 to 5 minutes. Remove from heat and keep warm."
    },
    {
      "position": 7,
      "text": "Beat egg whites in a separate glass, metal, or ceramic bowl until foamy; gradually beat in remaining 6 tablespoons sugar, continuing to beat until stiff peaks form. Add vanilla; beat on low speed until incorporated."
    },
    {
      "position": 8,
      "text": "Pour rhubarb mixture into pie crust; lightly pile meringue on top and spread to the edges to seal. Shape top of meringue into a nice pattern, with high points and edges that will brown when baked."
    },
    {
      "position": 9,
      "text": "Bake on the center rack in the preheated oven until firm and delicately browned, 15 to 20 minutes. Cool in the refrigerator until custard is set, about 2 hours. Store in the refrigerator until serving time."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

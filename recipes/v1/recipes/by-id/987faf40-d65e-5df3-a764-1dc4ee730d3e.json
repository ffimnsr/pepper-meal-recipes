  "slug": "sausage-and-cabbage-skillet-recipe-11895218",
  "name": "Sausage and Cabbage Skillet",
  "recipe_type": "main",
  "brief_description": "For this sausage and cabbage skillet, just a few ingredients and 1 skillet is all you need to put a simple and flavorful meal on your table in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat an extra-large skillet over medium heat. Add sliced sausage and cook for 8 minutes, making sure to flip slices often. Transfer sausage to a plate."
    },
    {
      "position": 2,
      "text": "Return the skillet to the stove. Add olive oil, onion, cabbage, garlic, salt, and pepper. Toss to combine. Cover and cook until cabbage is nearly tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in vinegar. Add reserved sausage, cover, and cook 2 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

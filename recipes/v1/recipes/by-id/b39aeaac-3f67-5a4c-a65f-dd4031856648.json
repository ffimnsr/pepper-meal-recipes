  "id": "b39aeaac-3f67-5a4c-a65f-dd4031856648",
  "slug": "tater-tots-nachos",
  "name": "Tater Tots\u00ae Nachos",
  "recipe_type": "appetizer",
  "brief_description": "This delicious dish takes classic nachos topped with taco meat, cheese, jalapeno, sour cream, and onion and replaces the chips with your favorite bite-size potato nuggets!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange potato nuggets in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake potato nuggets in the preheated oven until golden and heated through, 24 to 26 minutes."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Stir water and taco seasoning mix into beef; cook and stir until liquid is thickened, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Pour cheese sauce into a microwave-safe bowl; heat in the microwave for 30 seconds, stir. Continue heating in 15-second intervals until hot, stirring between intervals."
    },
    {
      "position": 6,
      "text": "Spread potato nuggets on a serving plate. Top with meat, cheese sauce, sour cream, onion, and jalapeno slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

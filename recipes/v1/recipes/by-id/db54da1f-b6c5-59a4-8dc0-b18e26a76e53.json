  "id": "db54da1f-b6c5-59a4-8dc0-b18e26a76e53",
  "slug": "skinny-spinach-and-artichoke-dip",
  "name": "Skinny Spinach and Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This easy, one-dish recipe makes a delicious, crowd-pleasing appetizer for game day or any casual gathering with family and friends.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix artichoke hearts, spinach, cream cheese, sour cream, Romano cheese, Parmesan cheese, roasted peppers, garlic, and lemon juice together in a baking dish and top with croutons."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbly and croutons are browned, about 35 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

  "id": "7c193dcc-7c83-524c-91d0-76199da63777",
  "slug": "orange-flavored-fudge",
  "name": "Orange Flavored Fudge",
  "recipe_type": "dessert",
  "brief_description": "A quick and easy microwave fudge flavored with grated orange peel and orange liqueur.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a 2 quart microwave safe dish combine sugar, evaporated milk and butter. Microwave on high for 8 minutes."
    },
    {
      "position": 2,
      "text": "Stir and add marshmallows and chocolate chips; heat on high for 3 minutes, or until melted."
    },
    {
      "position": 3,
      "text": "Stir in orange peel and liqueur. Chill for 2 hours, or until firm, and cut into squares."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 11,
  "preparation_time_minutes": 5,

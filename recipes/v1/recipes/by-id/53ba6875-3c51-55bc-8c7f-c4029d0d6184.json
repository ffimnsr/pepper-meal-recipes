  "id": "53ba6875-3c51-55bc-8c7f-c4029d0d6184",
  "slug": "neat-sloppy-joes",
  "name": "Neat Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "No green pepper in this recipe, so it's a hit with kids. We added this to the menu at a children's camp, and it has been a favorite for several years. The mixture is thick, so they are 'neat' rather than sloppy. This freezes and reheats well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground beef in a large skillet over medium heat until evenly browned, stirring to crumble. I like to use a potato masher to even out the lumps. Add celery and onion, cover and cook until tender and translucent, about 5 minutes. Drain off any grease."
    },
    {
      "position": 2,
      "text": "Stir in (undiluted) tomato soup, ketchup, brown sugar, vinegar, and Worcestershire sauce; season with salt and garlic powder. Heat over low heat until simmering; simmer until thoroughly heated, stirring frequently to prevent burning on the bottom."
    },
    {
      "position": 3,
      "text": "Spoon beef mixture on buns; serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

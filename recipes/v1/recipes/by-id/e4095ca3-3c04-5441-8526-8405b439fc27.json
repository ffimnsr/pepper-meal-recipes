  "id": "e4095ca3-3c04-5441-8526-8405b439fc27",
  "slug": "slow-cooker-chicken-tetrazzini",
  "name": "Slow Cooker Chicken Tetrazzini",
  "recipe_type": "main",
  "brief_description": "This fork-tender chicken is slow cooked in a thick and creamy sauce seasoned with Italian dressing. Serve with hearty egg noodles to catch every bit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in the slow cooker crock. Top with 2 tablespoons melted butter; sprinkle with Italian dressing mix."
    },
    {
      "position": 2,
      "text": "Cover, and cook on High for 3 hours."
    },
    {
      "position": 3,
      "text": "Heat the remaining 2 tablespoons of butter in a large skillet over medium heat. Stir in onion and garlic; cook and stir until onion is soft, about 5 minutes. Mix in the cream of chicken soup, chicken broth, and cream cheese. Pour mixture over the cooked chicken in the slow cooker."
    },
    {
      "position": 4,
      "text": "Cover, and continue to cook on Low until chicken in fork tender and the sauce has thickened, about 1 additional hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

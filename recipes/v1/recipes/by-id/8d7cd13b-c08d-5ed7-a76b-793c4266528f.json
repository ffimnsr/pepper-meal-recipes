  "id": "8d7cd13b-c08d-5ed7-a76b-793c4266528f",
  "slug": "buckwheat-grissini-with-real-butter-gluten-free",
  "name": "Buckwheat Grissini with Real Butter (Gluten Free)",
  "recipe_type": "salad",
  "brief_description": "These grissini are crunchy, thin breadsticks made with buckwheat flour and butter that will give your appetizers or salads a new twist.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix buckwheat flour, Parmigiano-Reggiano cheese, gluten-free flour, and 1 1/2 tablespoon butter in a bowl with your hands until the mixture resembles small pebbles. Mix in sesame seeds and thyme. Add water, 1 tablespoon at a time, until the mixture pulls together into a soft dough."
    },
    {
      "position": 3,
      "text": "Divide dough into 6 portions. Let dough rest for 5 minutes."
    },
    {
      "position": 4,
      "text": "Roll each portion of dough into a long, thin stick about 6 to 7 inches long. Arrange side by side on the baking sheet. Brush remaining 1 1/2 teaspoon butter over dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until completely browned, about 20 minutes. Cool completely before serving, about 10 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

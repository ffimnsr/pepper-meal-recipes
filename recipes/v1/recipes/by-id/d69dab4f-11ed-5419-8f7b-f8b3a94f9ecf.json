  "id": "d69dab4f-11ed-5419-8f7b-f8b3a94f9ecf",
  "slug": "supremely-spicy-hummus",
  "name": "Supremely Spicy Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This homemade spicy hummus is flavored with a generous amount of cayenne pepper and hot sauce for a smooth and creamy dip with a kick of heat.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tahini, olive oil, lemon juice, garlic, cayenne pepper, cumin, salt, sesame oil, and hot sauce in a food processor or blender; blend until very smooth, about 3 minutes. Add garbanzo beans and blend for 2 minutes. Add water and blend for 3 minutes more. Chill in refrigerator."
    }
  ],

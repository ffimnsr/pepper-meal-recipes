  "id": "bbc6536f-7b99-5c2e-9fd4-d3e7a3a4eab8",
  "slug": "mini-no-bake-cheesecakes-recipe-7499206",
  "name": "Mini No-Bake Cheesecakes",
  "recipe_type": "dessert",
  "brief_description": "These mini no-bake cheesecakes are great topped with fresh fruit, a drizzle of your favorite syrup or pie filling spooned on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Line a 12-cup muffin pan with muffin liners."
    },
    {
      "position": 2,
      "text": "To make the crust: Combine graham cracker crumbs, brown sugar, and melted butter in a small bowl until evenly combined."
    },
    {
      "position": 3,
      "text": "Press 1 rounded tablespoon of crumb mixture evenly into the bottom of each muffin cup. Use the bottom of a small jar or measuring cup to firmly press the crust into an even layer. Freeze the crusts until set, 15 to 20 minutes, while you prepare the filling."
    },
    {
      "position": 4,
      "text": "To make the filling: Beat the cold whipping cream in a medium bowl until stiff peaks form, 3 to 5 minutes. Set aside."
    },
    {
      "position": 5,
      "text": "Beat cream cheese and sugar in a large bowl on medium-high speed until smooth and creamy, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Add the sour cream, lemon juice, and vanilla extract to the cream cheese mixture. Beat until combined, about 1 minute."
    },
    {
      "position": 7,
      "text": "Fold in the reserved whipped cream, until just combined."
    },
    {
      "position": 8,
      "text": "Place the filling in a resealable 1 quart plastic bag. Snip off the corner of the bag to create a 1/2-inch opening."
    },
    {
      "position": 9,
      "text": "Pipe into prepared muffin pans, using about 2 1/2 tablespoons of mixture per cup. Smooth the tops as desired."
    },
    {
      "position": 10,
      "text": "Refrigerate, covered, for 3 hours or up to 5 days. Top with fresh berries or toppings of your choice."
    },
    {
      "position": 11,
      "text": "Unwrap and enjoy!"
    }
  ],
  "servings": 12,

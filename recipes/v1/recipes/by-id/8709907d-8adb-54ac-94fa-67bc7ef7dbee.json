  "id": "8709907d-8adb-54ac-94fa-67bc7ef7dbee",
  "slug": "strawberry-texas-sheet-cake-recipe-12022286",
  "name": "Strawberry Texas Sheet Cake",
  "recipe_type": "dessert",
  "brief_description": "This strawberry Texas sheet cake is an easy twist on the classic, made with boxed cake mix, strawberry JELL-O, and fresh strawberry pur\u00e9e for incredible flavor and a soft, moist crumb. Finished with a creamy strawberry glaze, it\u2019s a stunning strawberry dessert everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Generously coat a 10x15-inch rimmed baking sheet with baking spray."
    },
    {
      "position": 2,
      "text": "Blend strawberries in a blender or food processor until a smooth puree forms, about 30 seconds. Transfer 1/4 cup puree to a small bowl for Strawberry Glaze. Set aside 1 1/2 teaspoons of the strawberry-flavored Jell-O in a small bowl for strawberry glaze."
    },
    {
      "position": 3,
      "text": "For cake, stir cake mix, flour, and remaining 1/3 cup strawberry-flavored Jell-O together in a large bowl until well combined; set aside. In a separate medium bowl, stir water, oil, eggs, sour cream, 1 teaspoon vanilla extract, and remaining 3/4 cup strawberry puree together until smooth. Gently stir into the dry mixture until combined. Pour batter into the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cake is dry to the touch and a toothpick inserted near the center comes out clean, about 15 minutes. Cool for 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, for glaze, whisk powdered sugar, heavy cream, 1 teaspoon vanilla, reserved 1/4 cup strawberry puree, and reserved 1 1/2 teaspoons strawberry flavored Jell-O together until smooth."
    },
    {
      "position": 6,
      "text": "Pour glaze over cake, then spread evenly over cake with a spatula. Cool completely before serving, about 50 minutes. Garnish with fresh sliced strawberries, if desired. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "853f5bc6-5049-5c95-a688-b357c1d80c3e",
  "slug": "strawberry-glazed-pie",
  "name": "Strawberry Glazed Pie",
  "recipe_type": "dessert",
  "brief_description": "This delightful strawberry glazed pie is bursting with fresh strawberries coated with an easy to make strawberry glaze for a great make-ahead dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix sugar, water, gelatin, and cornstarch together in a medium large saucepan. Boil for one minute, then remove from heat."
    },
    {
      "position": 3,
      "text": "Fold in sliced strawberries, toss until well coated."
    },
    {
      "position": 4,
      "text": "Pour into prepared graham cracker crust."
    },
    {
      "position": 5,
      "text": "Chill until well set, about 2 to 4 hours. Serve topped with whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

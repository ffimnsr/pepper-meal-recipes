  "id": "c4360fb8-c5a1-55cc-9518-f0930a24b1a8",
  "slug": "perfect-coconut-macaroons",
  "name": "Perfect Coconut Macaroons",
  "recipe_type": "dessert",
  "brief_description": "These coconut macaroons are dipped in chocolate and taste like they came from the bakery.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Blend coconut, sugar, flour, vanilla extract, almond extract, and salt in a food processor until combined, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Beat egg whites in a bowl until soft peaks form."
    },
    {
      "position": 5,
      "text": "Fold coconut mixture into egg whites until just combined."
    },
    {
      "position": 6,
      "text": "Wet your hands. Roll spoonfuls of coconut mixture between palms to golf ball-size cookies; arrange on the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake cookies in the preheated oven until coconut is slightly golden and toasted, about 15 minutes. Transfer to a wire rack to cool, 30 minutes."
    },
    {
      "position": 8,
      "text": "Line baking sheet with new piece of parchment paper."
    },
    {
      "position": 9,
      "text": "Melt chocolate chips in the top of a double boiler over just-barely simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching."
    },
    {
      "position": 10,
      "text": "Dip half of each cookie in the chocolate and place on the prepared baking sheet. Place in refrigerator until chocolate is set, about 15 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,

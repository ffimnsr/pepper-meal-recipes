  "id": "aaed9385-6404-59c6-a51e-62c9686591c1",
  "slug": "drunken-baked-beans-frijoles-borrachos-recipe-7511596",
  "name": "Frijoles Borrachos (Drunken Baked Beans)",
  "recipe_type": "dessert",
  "brief_description": "Frijoles borrachos, or drunken baked beans, are super savory, sweet, and slightly spicy. Beer makes these one of the best-tasting baked bean recipes ever.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Add brown sugar, vinegar, and salsa to a 2 \u00bd- to 3-quart baking dish or casserole pan. Stir until sugar dissolves."
    },
    {
      "position": 3,
      "text": "Add pinto beans, onion, jalapeno peppers, mustard, paprika, black pepper, salt, garlic powder, oregano, and cayenne pepper. Pour lager over, and stir until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Lay bacon strips on top of casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until liquids have reduced and thickened, 1 to 1 \u00bd hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

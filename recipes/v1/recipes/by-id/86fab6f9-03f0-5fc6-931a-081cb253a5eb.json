  "id": "86fab6f9-03f0-5fc6-931a-081cb253a5eb",
  "slug": "fig-and-rosemary-cranberry-sauce",
  "name": "Fig and Rosemary Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "Traditional cranberry sauce gets a flavorful upgrade with the additions of figs and rosemary. Try it this Thanksgiving!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, brown sugar, and maple extract to a boil in a non-reactive saucepan. Add cranberries and figs. Cook over medium heat, stirring frequently, until slightly thickened, about 5 minutes. Add rosemary and cook until sauce is thickened, about 5 minutes more."
    },
    {
      "position": 2,
      "text": "Carefully remove rosemary sprig and discard. Remove pot from the burner and let cool, about 10 minutes. Pour sauce into a bowl and refrigerate until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

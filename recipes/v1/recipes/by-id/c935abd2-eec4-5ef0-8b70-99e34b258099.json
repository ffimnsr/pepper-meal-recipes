  "id": "c935abd2-eec4-5ef0-8b70-99e34b258099",
  "slug": "broiled-scallops",
  "name": "Broiled Scallops",
  "recipe_type": "dessert",
  "brief_description": "These broiled scallops are flavored with butter, lemon, and garlic salt, then quickly broiled until golden brown and sweet for a quick, easy dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the broiler to high heat."
    },
    {
      "position": 2,
      "text": "Rinse scallops and place in a shallow baking pan. Sprinkle with 2 tablespoons melted butter, lemon juice, and garlic salt."
    },
    {
      "position": 3,
      "text": "Broil in the preheated broiler until scallops begin to turn golden, 6 to 8 minutes. Remove from the oven and serve with extra melted butter on the side for dipping."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 6,

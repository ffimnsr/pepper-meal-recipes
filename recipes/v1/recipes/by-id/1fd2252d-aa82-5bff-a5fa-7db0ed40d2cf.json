  "slug": "apple-cider-syrup-recipe-12062549",
  "name": "Apple Cider Syrup",
  "recipe_type": "dessert",
  "brief_description": "This Apple Cider Syrup turns just one ingredient into a thick, concentrated syrup packed with deep apple flavor. It\u2019s super simple to make and delicious drizzled over pancakes or ice cream or stirred into your favorite fall drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour apple cider into a large pot and simmer until it reduces significantly by about 90%nd is a thick, syrup-like consistency, up to 4 hours."
    },
    {
      "position": 2,
      "text": "Stir frequently toward the end of the reduction to be sure syrup does not burn."
    },
    {
      "position": 3,
      "text": "Allow to cool before transferring it to a jar for storage. Enjoy syrup over your favorite fall foods!"
    }
  ],
  "servings": 12,

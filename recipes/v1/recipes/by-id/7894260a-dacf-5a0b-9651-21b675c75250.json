  "id": "7894260a-dacf-5a0b-9651-21b675c75250",
  "slug": "sous-vide-dill-pickles",
  "name": "Sous Vide Dill Pickles",
  "recipe_type": null,
  "brief_description": "These sous vide pickles are simple to make with a sous vide cooker, but if you don\u2019t have one, you can still make them with a sunny windowsill.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Layer cucumbers, garlic, and dill in a resealable plastic bag. Combine water, vinegar, kosher salt, and alum in a liquid measure; pour into the bag and seal securely."
    },
    {
      "position": 2,
      "text": "Immerse the bag in a heat-proof container of water with a sous vide cooker. Set the temperature to 140 degrees F (60 degrees C) and cook for 2 1/2 hours."
    },
    {
      "position": 3,
      "text": "Remove the bag and set aside to cool, about 1 hour. Transfer pickles and brine to a jar and refrigerate for 24 hours before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

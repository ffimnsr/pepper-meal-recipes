  "id": "87723b0c-d228-55a5-95c1-b1922f9b55ca",
  "slug": "do-it-yourself-salmon-poke-bowls",
  "name": "Do-It-Yourself Salmon Poke Bowls",
  "recipe_type": "main",
  "brief_description": "Do-it-yourself salmon poke bowls are easy with this flexible recipe any time you want a custom salmon poke bowl at home. The topping options are endless.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Divide rice among four bowls."
    },
    {
      "position": 2,
      "text": "Combine soy sauce, rice wine vinegar, sesame oil, and chile oil in a bowl; add salmon and toss to coat. Divide among the four bowls."
    },
    {
      "position": 3,
      "text": "Top bowls with avocado, bell pepper, edamame, seaweed, pickled ginger, and furikake seasoning. Garnish with chopped green onion; sprinkle with sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

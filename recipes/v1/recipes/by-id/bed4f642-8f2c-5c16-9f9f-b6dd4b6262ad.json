  "slug": "slow-cooker-apple-butter-meatballs-recipe-12024372",
  "name": "Slow Cooker Apple Butter Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These slow cooker apple butter meatballs are the ultimate set-it-and-forget-it fall appetizer. Frozen meatballs simmer in a sweet and tangy apple butter sauce, and with just five ingredients and five minutes of prep, they\u2019re perfect for tailgates, potlucks, and holiday gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place apple butter, chili sauce, maple syrup, and allspice in a slow cooker; stir to combine. Add the meatballs and stir to coat meatballs evenly in the sauce."
    },
    {
      "position": 2,
      "text": "Cook on High until meatballs are completely thawed and hot, about 3 hours. Serve with toothpicks."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,

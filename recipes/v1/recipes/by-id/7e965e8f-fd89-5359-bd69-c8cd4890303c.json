  "id": "7e965e8f-fd89-5359-bd69-c8cd4890303c",
  "slug": "lentils-and-rice-with-fried-onions-mujadarrah",
  "name": "Lentils and Rice with Fried Onions (Mujadarrah)",
  "recipe_type": "main",
  "brief_description": "Fried onions are mixed with rice and lentils, and topped with yogurt or sour cream. So simple, and so delicious!",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the olive oil in a large skillet over medium heat. Stir in the onions, and cook about 10 minutes, until browned. Remove from heat, and set aside."
    },
    {
      "position": 2,
      "text": "Place lentils in a medium saucepan with enough lightly salted water to cover. Bring to a boil, reduce heat, and simmer about 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir rice and enough water to cover into the saucepan with the lentils. Season with salt and pepper. Cover saucepan, and continue to simmer 15 to 20 minutes, until rice and lentils are tender."
    },
    {
      "position": 4,
      "text": "Mix half the onions into the lentil mixture. Top with yogurt or sour cream and remaining onions to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

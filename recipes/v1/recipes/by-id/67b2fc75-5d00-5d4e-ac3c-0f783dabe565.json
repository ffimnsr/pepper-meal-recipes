{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "67b2fc75-5d00-5d4e-ac3c-0f783dabe565",
  "slug": "boliche-cuban-pot-roast",
  "name": "Boliche (Cuban Pot Roast)",
  "recipe_type": "drink",
  "brief_description": "Eye of round roast is stuffed with chorizo and marinated in a Cuban-inspired blend of citrus juices, garlic, and oregano, then slowly cooked until tender.",
  "cuisine": "Cuban",
  "instructions": [
    {
      "position": 1,
      "text": "Lay roast flat on your work surface. Use the tip of a sharp boning or paring knife to cut a pocket in roast by inserting the knife all the way through the center of the roast, beginning on the flat side. Rotate the blade 90 degrees and insert the knife in the same spot, creating a cross shape that extends through the roast. Stuff chorizo pieces into pocket. Pierce roast all over using the same knife; transfer to a glass or ceramic bowl."
    },
    {
      "position": 2,
      "text": "Mash garlic and oregano with a mortar and pestle until a paste forms; rub all over roast, then season with paprika, salt, and pepper. Pour orange juice, lime juice, and lemon juice over roast. Cover with plastic wrap and marinate in the refrigerator for at least 3 hours, or overnight. Remove roast from marinade; shake off excess. Reserve marinade."
    },
    {
      "position": 3,
      "text": "Heat oil in a large Dutch oven over medium heat. Brown roast on all sides, about 10 minutes; transfer to a platter, and set aside. Add onions; cook and stir until softened and translucent, about 5 minutes. Return roast to the Dutch oven. Add beef broth, sherry, reserved marinade, and bay leaves. Increase heat to medium-high, bring to a boil, then cover and reduce heat to low; simmer 2 hours."
    },
    {
      "position": 4,
      "text": "Add potatoes to the Dutch oven, cover, and continue to simmer until potatoes are tender and easily pierced with a fork, about 30 minutes more, adding additional beef broth as needed."
    },
    {
      "position": 5,
      "text": "Transfer roast to a platter; cover with two layers of aluminum foil, and allow to rest in a warm area for 10 minutes. Slice roast into 1/2-inch-thick slices; arrange potatoes on the platter. Pour sauce over roast and potatoes to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 30,

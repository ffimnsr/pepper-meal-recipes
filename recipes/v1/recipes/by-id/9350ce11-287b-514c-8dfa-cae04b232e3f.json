  "id": "9350ce11-287b-514c-8dfa-cae04b232e3f",
  "slug": "keto-shrimp-scampi-with-broccoli-noodles",
  "name": "Keto Shrimp Scampi with Broccoli Noodles",
  "recipe_type": "main",
  "brief_description": "Sauteed shrimp scampi is served over spiralized broccoli noodles in this quick keto-friendly weeknight recipe.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut off broccoli florets and save for another use. Cut woody ends off the stems. Shave large knots off the stems using a vegetable peeler so that they are as uniform as possible. Cut into noodles using the smallest blade on a spiralizer."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a large skillet over medium-high heat. Add broccoli noodles, salt, and pepper; toss for 3 minutes. Remove from heat and set aside."
    },
    {
      "position": 3,
      "text": "Heat remaining olive oil and garlic in a separate skillet over medium heat. Cook for 1 minute. Add shrimp and cook until opaque, about 3 minutes per side. Transfer shrimp to a bowl."
    },
    {
      "position": 4,
      "text": "Add wine, lemon juice, butter, basil, chives, and red pepper to the skillet. Whisk over medium heat for 3 minutes. Return shrimp to the skillet and toss to coat."
    },
    {
      "position": 5,
      "text": "Spoon broccoli noodles into 4 serving bowls. Top with shrimp mixture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

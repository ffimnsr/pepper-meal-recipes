{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c9bd4d2f-a3fa-5ec0-8e80-860e3e86bc5e",
  "slug": "tortilla-de-patatas",
  "name": "Tortilla de Patatas",
  "recipe_type": "appetizer",
  "brief_description": "Tortilla de patatas (also known as Spanish omelette) is a delicious and popular tapa in Spain that's easy to make with eggs, potatoes, and onions.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep stockpot over medium-high heat until almost smoking, 2 to 4 minutes. Add potatoes and onion; they should be mostly covered with oil. Season with 1 \u00bd teaspoons salt. Cook, stirring occasionally and maintaining a gentle simmer, until potatoes are just fork-tender, 8 to 12 minutes; do not overcook."
    },
    {
      "position": 2,
      "text": "Drain potato-onion mixture in a colander; reserve oil for another use or discard. Allow to cool for a few minutes, then taste and season with more salt, if needed."
    },
    {
      "position": 3,
      "text": "Meanwhile, crack eggs into a large bowl and season with remaining 1/2 teaspoon salt; whisk until well beaten. Add potato-onion mixture and toss to coat."
    },
    {
      "position": 4,
      "text": "Heat a 10-inch nonstick skillet over high heat. Add 1 teaspoon olive oil, then pour in egg-potato mixture. Level it with a spatula and cook for 1 minute. Reduce heat to medium-low and cook for about 5 minutes. Run a rubber spatula around the outer edges to make sure it's not sticking and to help it form its shape."
    },
    {
      "position": 5,
      "text": "Once it starts to firm up around the edges and in the center (although it will still be a little runny), place a large plate over the skillet. Flip the omelet onto the plate, then slide it back into the skillet. Use the spatula to help press the edges in and under, to maintain a rounded edge. Cook over high heat for 1 minute, then reduce to low and cook until it feels set in the center and a knife inserted in the center comes out clean, 2 to 3 more minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

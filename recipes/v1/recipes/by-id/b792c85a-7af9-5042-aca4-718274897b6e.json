  "id": "b792c85a-7af9-5042-aca4-718274897b6e",
  "slug": "cauliflower-and-egg-salad",
  "name": "Cauliflower and Egg Salad",
  "recipe_type": "salad",
  "brief_description": "This cauliflower salad with egg features shaved carrots and green onions tossed in a creamy mayo dressing flavored with mustard and sweet relish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook cauliflower in boiling water until tender, about 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Mix together cauliflower, eggs, carrot, green onions, relish, mayonnaise, and mustard in a large bowl until well combined. Season with salt and black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

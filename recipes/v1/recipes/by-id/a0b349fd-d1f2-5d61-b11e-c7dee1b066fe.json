  "id": "a0b349fd-d1f2-5d61-b11e-c7dee1b066fe",
  "slug": "tortellini-skewers",
  "name": "Tortellini Skewers",
  "recipe_type": "appetizer",
  "brief_description": "This tortellini skewer recipe features tortellini and cherry tomatoes with pesto, skewered on toothpicks for a 3-ingredient appetizer ready in 25 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until tortellini float to the top, 5 to 6 minutes. Drain and rinse with cold water."
    },
    {
      "position": 2,
      "text": "Toss tortellini, cherry tomatoes, and pesto together in a large bowl until evenly coated."
    },
    {
      "position": 3,
      "text": "Skewer 1 tortellini and 1 tomato on each toothpick; arrange on a tray. Keep refrigerated until serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

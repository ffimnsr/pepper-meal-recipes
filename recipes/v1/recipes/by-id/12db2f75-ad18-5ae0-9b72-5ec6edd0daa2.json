  "id": "12db2f75-ad18-5ae0-9b72-5ec6edd0daa2",
  "slug": "bread-machine-ezekiel-bread",
  "name": "Bread Machine Ezekiel Bread",
  "recipe_type": null,
  "brief_description": "Use this recipe to make dough for Ezekiel bread in the bread machine with millet, rye, wheat germ, lentils, and barley, then bake the loaf in the oven.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grind black beans, lentils, kidney beans, and barley in a coffee grinder until fine."
    },
    {
      "position": 2,
      "text": "Place warm milk, warm water, egg, oil, honey, all-purpose flour, whole wheat flour, millet flour, rye flour, cracked wheat, ground bean mixture, wheat germ, salt, and yeast into a bread machine in the order listed. Run Dough cycle. Remove dough from the machine after the cycle is done, about 90 minutes."
    },
    {
      "position": 3,
      "text": "Roll dough out onto a pastry cloth, then form into a loaf. Place loaf into a greased pan; cover with a damp cloth and let rise until doubled in volume, about 40 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Lower the oven temperature to 350 degrees F (175 degrees C) and continue to bake until loaf is browned, 30 to 35 minutes more. Cool in the pan for 10 minutes, then transfer to a wire rack and let cool completely before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

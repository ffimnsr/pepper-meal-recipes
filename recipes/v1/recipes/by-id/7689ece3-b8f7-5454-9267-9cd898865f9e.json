  "id": "7689ece3-b8f7-5454-9267-9cd898865f9e",
  "slug": "double-chocolate-biscotti-with-cherries-recipe-8748242",
  "name": "Double Chocolate Biscotti with Cherries",
  "recipe_type": "dessert",
  "brief_description": "Inspired by Black Forest Cake, these biscotti cookies are deeply chocolatey and studded with candied cherries.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a high-rimmed baking sheet with parchment paper ."
    },
    {
      "position": 2,
      "text": "Combine softened butter and sugar in a large bowl and beat with an electric hand mixer until creamy. Beat in eggs and vanilla extract until well combined."
    },
    {
      "position": 3,
      "text": "Add all-purpose flour, unsweetened cocoa, and baking powder; mix until combined. Stir in the chocolate chunks and candied cherries by hand (dough will be thick)."
    },
    {
      "position": 4,
      "text": "Split dough in half and shape into rectangular logs, about 8x2x1 inch in size. Place on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "In a small bowl, whisk together egg and water and brush the tops of the logs with the egg wash."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and cool for 30 minutes."
    },
    {
      "position": 8,
      "text": "Slice logs into 1 inch slices diagonally with a serrated knife. Arrange slices on the baking sheet on their sides."
    },
    {
      "position": 9,
      "text": "Bake for 10 minutes at 375 degrees F (190 degrees C), turn, and bake for an additional 10 minutes."
    },
    {
      "position": 10,
      "text": "Cool completely and store biscotti in an airtight container."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

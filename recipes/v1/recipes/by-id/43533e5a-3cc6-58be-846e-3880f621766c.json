  "id": "43533e5a-3cc6-58be-846e-3880f621766c",
  "slug": "easy-slow-cooker-chicken-noodle-soup",
  "name": "Easy Slow Cooker Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This recipe for slow cooker chicken noodle soup may be one of the easiest you'll ever find! Chicken, noodles, and aromatics \u2014 what else do you need?",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, carrots, onion, celery, parsley, salt, garlic salt, pepper, and thyme in a slow cooker; mix well. Place chicken on top and push down slightly into the liquid. Cover and cook on Low for 8 hours or High for 4 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken and shred meat or cut into bite-sized pieces. Return to the slow cooker."
    },
    {
      "position": 3,
      "text": "Add noodles and cook on High until noodles are tender, 30 to 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

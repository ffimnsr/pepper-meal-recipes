  "id": "c294a490-cff9-524a-933b-511d33da0ed4",
  "slug": "spicy-beef-jerky",
  "name": "Spicy Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "This homemade beef jerky spiced up with cayenne and Creole seasoning is full of smoky, spicy flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together soy sauce, hot water, Worcestershire sauce, liquid smoke, onion powder, garlic powder, cayenne pepper, Creole seasoning, and Cajun seasoning in a microwave-safe bowl. Microwave for about 1 minute; stir well. Add beef and toss to evenly coat. Cover the bowl with plastic wrap; marinate in the refrigerator, 8 hours or overnight. Remove meat from marinade and rinse with hot water."
    },
    {
      "position": 2,
      "text": "Preheat oven to 160 degrees F (70 degrees C). Place a pan on the bottom of oven to catch drips."
    },
    {
      "position": 3,
      "text": "Place meat strips on a rack about 1 inch apart from each other; dehydrate in the oven for 5 to 6 hours, or until desired consistency is achieved."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 10,

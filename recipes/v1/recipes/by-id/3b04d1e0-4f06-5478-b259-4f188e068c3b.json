{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3b04d1e0-4f06-5478-b259-4f188e068c3b",
  "slug": "stuffed-cookie-butter-snickerdoodle-cookies-recipe-11805580",
  "name": "Cookie Butter Stuffed Snickerdoodles",
  "recipe_type": "dessert",
  "brief_description": "These cookie butter stuffed snickerdoodles take your favorite cinnamon sugar cookie to new heights. Fill slice-and-bake sugar cookie dough with Biscoff cinnamon-ginger cookie butter spread, pinch closed, roll in cinnamon sugar and bake for a stupendous cookie treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment. Spoon 8 heaping dollops of cookie butter, about 2 tablespoons per dollop onto parchment. Place in the freezer for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and line another baking sheet with parchment. Set aside."
    },
    {
      "position": 3,
      "text": "Cut roll of cookie dough into 16 even slices. They should be about a little less than 1/2-inch thick."
    },
    {
      "position": 4,
      "text": "Remove cookie butter from the freezer. Place each dollop onto 1 slice of cookie dough. Top with a second slice. Pinch sides to seal and then roll around gently in the palm of your hand to create rounded, smooth edges."
    },
    {
      "position": 5,
      "text": "In a small bowl, combine sugar and cinnamon. Working in batches, cover each cookie in the mixture. Place onto the cookie sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cookies start turning golden brown, 10 to 12 minutes."
    },
    {
      "position": 7,
      "text": "Cool on a wire rack for 5 minutes before serving."
    },
    {
      "position": 8,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "48f7f417-f3ef-575b-b2ec-582a77edec3d",
  "slug": "manicotti-shells",
  "name": "Manicotti Shells",
  "recipe_type": "side",
  "brief_description": "Make your own manicotti shells with just 4 ingredients. Fill with your favorite filling, fold over the sides, and bake with sauce and cheese.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix flour, water, eggs, and salt together in a bowl until a thin, smooth batter forms."
    },
    {
      "position": 3,
      "text": "Lightly spray a griddle with cooking spray and heat over medium-low heat. Spoon about 1/4 cup batter into the warm skillet and cook until dry and a film forms on top."
    },
    {
      "position": 4,
      "text": "Carefully transfer to a plate and repeat to make remaining shells."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

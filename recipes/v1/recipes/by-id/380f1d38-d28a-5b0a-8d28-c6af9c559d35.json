  "id": "380f1d38-d28a-5b0a-8d28-c6af9c559d35",
  "slug": "fresh-peach-cobbler-with-hot-sugar-crust-recipe-12009757",
  "name": "Fresh Peach Cobbler with Hot Sugar Crust",
  "recipe_type": "dessert",
  "brief_description": "This fresh peach cobbler has a hot sugar crust, and while you may resist the idea of pouring boiling water over a lot of sugar on top of your beautiful cobbler dough, don\u2019t be nervous. It makes a delightful, crackly crust over the tender dough, a perfect complement to fresh, juicy peaches.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Place peaches in a 9x13-inch baking dish; set the baking dish on a rimmed baking sheet."
    },
    {
      "position": 2,
      "text": "Add lemon zest, lemon juice, cornstarch, 1 1/2 tablespoons sugar, and cinnamon to peaches, and toss until well combined."
    },
    {
      "position": 3,
      "text": "Combine butter and 1 1/3 cups sugar in a bowl and beat on medium speed with an electric mixer until well combined. Add flour, baking powder, and salt and continue mixing until well blended. Add milk and mix until just combined."
    },
    {
      "position": 4,
      "text": "Spoon mixture over peaches; spread evenly into a thin layer."
    },
    {
      "position": 5,
      "text": "Sprinkle the top evenly with remaining sugar. Pour boiling water evenly over the sugar layer."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned and bubbly and the batter layer has just set, 65 to 75 minutes. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,

  "id": "247d2571-17fb-5d51-bbae-ebfb5283b332",
  "slug": "low-carb-cauliflower-rice-sushi-rolls",
  "name": "Low-Carb Cauliflower Rice Sushi Rolls",
  "recipe_type": "main",
  "brief_description": "Homemade cauliflower rice makes these fresh tuna, avocado, and cream cheese sushi rolls a lower-carb option that's still full of flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pulse cauliflower florets in a food processor until riced."
    },
    {
      "position": 2,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower rice, cover, and steam, stirring occasionally, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer cauliflower rice to a bowl and stir in cream cheese, rice vinegar, and sweetener. Place in the refrigerator to chill until cold, about 1 hour."
    },
    {
      "position": 4,
      "text": "Mix the chopped tuna with Sriracha in a separate bowl to desired spiciness."
    },
    {
      "position": 5,
      "text": "Spread 1/3 of the cauliflower mixture on a plastic wrap-covered bamboo rolling mat until you have a square roughly the size of a nori sheet."
    },
    {
      "position": 6,
      "text": "Place one sheet of nori on top of the cauliflower rice square. Place 1/3 of the avocado slices and 1/3 of the tuna mixture along one edge on top of the nori. Carefully roll, starting from the edge with the fillings. Sprinkle with 1/3 of the sesame seeds and cut the roll into 6 slices with a sharp knife. Repeat with remaining cauliflower rice, nori, avocado slices, tuna mixture, and sesame seeds."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

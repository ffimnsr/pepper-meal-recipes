  "id": "1efa0e40-3154-5494-9180-a4da1e151970",
  "slug": "lisas-best-ever-garlic-bread",
  "name": "Lisa's Best Ever Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "Real butter, sliced garlic cloves, and French bread give this easy side dish an authentic flavor.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a small saucepan; simmer garlic slices in hot butter over low heat until butter turns foamy, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 3,
      "text": "Place bread loaf halves under the preheated broiler to toast, 2 to 4 minutes. Watch carefully to prevent burning."
    },
    {
      "position": 4,
      "text": "Slice toasted bread into 2-inch thick slices. Dip toasted side of each slice into garlic butter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

  "id": "2025ece1-9ec5-5abd-b7e1-4a4ef7d973c3",
  "slug": "flank-steak-barbecue",
  "name": "Flank Steak Barbecue",
  "recipe_type": "main",
  "brief_description": "This flank steak on the grill is super tender with excellent flavor, thanks to a soy sauce and honey mixture that works as both a marinade and a sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk vegetable oil, soy sauce, vinegar, honey, garlic powder, ginger, and green onion together in a bowl; pour into a resealable plastic bag. Add flank steak, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator at least 4 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove flank steak from marinade and shake off excess. Pour marinade into a small saucepan and set aside."
    },
    {
      "position": 4,
      "text": "Cook flank steak on the preheated grill until firm and reddish-pink and juicy in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C) for medium-rare. Remove from the grill and cover with several sheets of aluminum foil. Let rest for 10 minutes, then slice thinly against the grain."
    },
    {
      "position": 5,
      "text": "While the steak is cooking and resting, bring marinade to a boil over medium-high heat. Reduce the heat to medium-low and simmer for 10 minutes. Pour over sliced steak to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

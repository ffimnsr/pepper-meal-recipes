  "id": "9cecaebb-fd1d-53fa-aff9-1cdf59d5ce56",
  "slug": "nutella-stuffed-french-toast",
  "name": "Nutella-Stuffed French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This French toast with Nutella features cinnamon bread sandwiches stuffed with chocolate-hazelnut spread, cooked in a hot pan for a tasty breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Spread 1 tablespoon chocolate-hazelnut spread onto one side of each of 2 slices cinnamon bread; top each with another bread slice to make 2 sandwiches."
    },
    {
      "position": 3,
      "text": "Whisk together milk, beaten egg, and vanilla in a shallow bowl until smooth. Soak each sandwich in milk mixture until bread is moistened, about 15 seconds per side."
    },
    {
      "position": 4,
      "text": "Coat a nonstick pan with cooking spray and heat over medium-high heat."
    },
    {
      "position": 5,
      "text": "Cook sandwiches in the hot pan until browned on the bottom, about 2 minutes. Flip sandwiches and continue cooking until the other side is browned, about 1 minute more."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

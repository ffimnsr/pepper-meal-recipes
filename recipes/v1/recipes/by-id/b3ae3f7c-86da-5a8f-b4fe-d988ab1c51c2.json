  "schema_version": 1,
  "id": "b3ae3f7c-86da-5a8f-b4fe-d988ab1c51c2",
  "slug": "spicy-yellowtail-sushi-roll",
  "name": "Spicy Yellowtail Sushi Roll",
  "recipe_type": "appetizer",
  "brief_description": "Skip takeout and make this spicy yellowtail sushi rolls recipe, topped with flying fish roe and rolled with fresh cucumber \u2014 everyone will be impressed.",
  "cuisine": "Asian Inspired Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse rice under cold running water until it runs clear."
    },
    {
      "position": 2,
      "text": "Bring water and rice to a boil in a large saucepan. Reduce heat to a simmer; simmer for 10 minutes. Turn off heat, let rice sit without opening the lid for 20 minutes; the remaining steam continues to cook the rice."
    },
    {
      "position": 3,
      "text": "Stir rice wine vinegar and sugar together in a small bowl until sugar mostly dissolved; stir into rice. Cool rice, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Chop yellowtail into 1/4-inch cubes; add to a bowl. Stir in mayonnaise and Sriracha; set aside. Cover a bamboo sushi rolling mat with plastic wrap; set aside."
    },
    {
      "position": 5,
      "text": "Lay 1 nori sheet on a work surface, shiny-side down. Place 1/4 rice on nori, spread evenly from edge to edge, about 1/4-inch thick. Flip nori onto the prepared plastic-covered mat. Place 1/4 each yellowtail mixture and cucumber in a line along one short edge."
    },
    {
      "position": 6,
      "text": "Roll rice and nori sheet around filling, using the bamboo mat to help. Press roll tightly to form a uniform log. Spread 1/2 tablespoon tobiko in a long thin line across top of roll. Press roll with bamboo mat. Repeat with remaining nori sheets, rice, yellowtail mixture, cucumber, and tobiko."
    },
    {
      "position": 7,
      "text": "Cover rolls with plastic wrap; press again with bamboo mat. Slice each roll into 8 pieces using a very sharp, wet, clean knife. Remove plastic wrap before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

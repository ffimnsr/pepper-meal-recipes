  "id": "0b73604a-8146-5ac1-bbb7-8df3531fffee",
  "slug": "kaiserschmarrn",
  "name": "Kaiserschmarrn",
  "recipe_type": "dessert",
  "brief_description": "Kaiserschmarrn is a sweet pancake with rum-soaked raisins cut into pieces and sprinkled with powdered sugar for a delicious traditional Austrian dessert.",
  "cuisine": "Austrian German",
  "instructions": [
    {
      "position": 1,
      "text": "Combine raisins and rum in a small bowl; let soak for 30 minutes, then drain."
    },
    {
      "position": 2,
      "text": "Beat eggs, milk, white sugar, vanilla, and salt together in a medium bowl; gradually whisk in flour to make a smooth batter. Stir in drained raisins."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter in a large skillet over medium heat; pour batter into the skillet and cook 5 to 6 minutes, or until the pancake has set and the bottom is golden brown. Flip pancake and cook until this side is also golden brown, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Tear pancake into bite-sized pieces using a spatula or two forks; drizzle in melted butter and sprinkle with confectioners' sugar. Increase heat to medium-high and gently toss the pancake pieces until sugar has caramelized, about 5 minutes. Sprinkle with additional confectioners' sugar and serve with apple sauce or plum preserves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "sweet-island-teriyaki-sauce",
  "name": "Sweet Island Teriyaki Sauce",
  "recipe_type": "dessert",
  "brief_description": "Quick and easy homemade teriyaki sauce gets a tropical twist with the addition of fresh pineapple. Marinate your favorite meat or vegetable with this tangy sauce!",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, sake, pineapple, honey, white sugar, garlic, ginger, and fish sauce in a saucepan over medium heat; cook and stir until just boiling, about 7 minutes. Remove from heat, cool, and store in refrigerator."
    }
  ],
  "servings": 10,

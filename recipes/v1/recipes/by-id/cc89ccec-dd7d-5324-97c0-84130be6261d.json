  "id": "cc89ccec-dd7d-5324-97c0-84130be6261d",
  "slug": "cake-mix-fudge-recipe-11855152",
  "name": "Cake Mix Fudge",
  "recipe_type": "dessert",
  "brief_description": "This cake mix fudge is so easy to make, and easy to change to suit your taste. Customize it choosing any flavor cake mix, and then adding your favorite sprinkles, nuts, or small candies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine condensed milk and white chocolate chips in a small saucepan and set over medium-low heat. Cook, stirring constantly, until chocolate chips are melted. Remove from heat and sprinkle cake mix and sprinkles (or desired mix-ins) in at the same time."
    },
    {
      "position": 2,
      "text": "Transfer mixture to an 8 x 8 baking pan lined with parchment paper. Press mixture into an even layer and top with more sprinkles for garnish if desired."
    },
    {
      "position": 3,
      "text": "Let cool completely or refrigerate until ready to serve."
    },
    {
      "position": 4,
      "text": "Cut into 20 to 25 squares and store in an airtight container."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

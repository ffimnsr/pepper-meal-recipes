{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3ec0503e-eb51-5285-b7e0-e9f5ca2aa2b5",
  "slug": "pumpkin-biscotti",
  "name": "Pumpkin Biscotti",
  "recipe_type": "dessert",
  "brief_description": "A pumpkin biscotti recipe that packs a crunch and balances sweetness with warm autumn spices, creating the perfect treat to pair with your coffee or cider.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, baking powder, cinnamon, nutmeg, salt, cloves, and ginger in a large bowl."
    },
    {
      "position": 2,
      "text": "Beat white sugar, butter, and brown sugar together in a separate bowl with an electric mixer until light and crumbly. Beat in eggs for 1 minute. Add pumpkin pur\u00e9e, molasses, and vanilla, beating until well blended, about 1 minute. Beat in flour mixture until dough is sticky and incorporated."
    },
    {
      "position": 3,
      "text": "Cover dough and refrigerate for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 5,
      "text": "Shape dough into two loaves that are 1 inch high, 3 to 4 inches wide, and 10 inches long, using wet hands. Place each loaf onto a prepared baking sheet; top with pumpkin seeds."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bottoms are dry, 20 to 24 minutes. Cool for 5 minutes. Reduce oven temperature to 275 degrees F (135 degrees C)."
    },
    {
      "position": 7,
      "text": "Transfer loaves to a flat work surface. Cut each into 10 diagonal slices about \u00bd inch thick. Place sliced biscotti back on the baking sheets."
    },
    {
      "position": 8,
      "text": "Continue baking until light golden brown, about 20 minutes. Reduce oven temperature to 200 degrees F (95 degrees C). Continue baking until dry, about 20 minutes more. Cool on wire racks."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b813a24f-11b5-550c-b914-f94e06f82881",
  "slug": "killer-pumpkin-pie",
  "name": "Killer Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This \"Killer Pumpkin Pie\" recipe is dairy\u2014and soy-free. It uses rice milk, pumpkin pur\u00e9e, brown and white sugar, cinnamon, ginger, nutmeg, and cloves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, 2 teaspoons sugar, and 1 teaspoon salt together in a 9-inch pie plate; make a well in the center. Pour \u00bd cup oil and 2 tablespoons rice milk into well; mix with a fork until a dough forms. Press evenly into the bottom and up sides of the pie plate using your hands; crimp edges of crust."
    },
    {
      "position": 3,
      "text": "Combine \u00bd cup white sugar, brown sugar, cinnamon, \u00bd teaspoon salt, ginger, nutmeg, and cloves in a large bowl; set aside. Whisk pumpkin pur\u00e9e, 1 \u00bc cups rice milk, eggs, 2 tablespoons oil, and vanilla together in a separate bowl until combined; stir into sugar mixture until fully combined. Pour filling into the prepared crust; place on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until a knife inserted near the center comes out clean, 40 to 50 minutes more. The center may still wiggle a little but will firm up once out of the oven. Cool on a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

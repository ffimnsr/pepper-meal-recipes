  "id": "f51c1282-ecf2-5dcc-80d2-fb19bc0ebc66",
  "slug": "chef-johns-tandoori-chicken",
  "name": "Chef John's Tandoori Chicken",
  "recipe_type": "main",
  "brief_description": "In this simple recipe, chicken is marinated in yogurt and tandoori masala, then grilled over hot coals to produce the complex flavors of Tandoori chicken.",
  "cuisine": "Indian Inspired Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk lime juice, yogurt, tandoori powder, salt, and pepper in a bowl. Pour mixture into a resealable plastic bag. Add chicken, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in refrigerator for at least 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove chicken from the bag and transfer to a plate or baking sheet lined with paper towels. Pat chicken pieces dry with more paper towels."
    },
    {
      "position": 4,
      "text": "Grill chicken on the preheated grill with the lid open for 2 minutes. Close lid and continue to grill chicken for 6 minutes."
    },
    {
      "position": 5,
      "text": "Turn chicken, close lid and grill until well-browned and meat is no longer pink in the center, about 6 minutes. An instant-read thermometer inserted into the thickest part of the thigh should read 180 degrees F (82 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "7f32d4b8-a942-52f6-88a7-f27be14a3bb9",
  "slug": "2-ingredient-pineapple-angel-food-cake",
  "name": "2-Ingredient Pineapple Angel Food Cake",
  "recipe_type": "dessert",
  "brief_description": "This 2-ingredient angel food cake recipe marries crushed pineapple (and its juices) and boxed angel food cake mix, yielding a tropical-flavored cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat crushed pineapple with juice and cake mix in a large bowl with an electric mixer on low speed for 30 seconds, then beat on medium speed for 1 minute. Pour into an ungreased 10-inch tube pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until deep golden brown, 40 to 45 minutes. Cool in the pan, inverted onto a wire rack, or thin-necked glass bottle (such as a wine bottle); this will prevent the cake from sinking, about 2 hours."
    },
    {
      "position": 4,
      "text": "Run a table knife around the edges of the tube pan; turn out onto a serving plate. Cut into slices using a serrated knife."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

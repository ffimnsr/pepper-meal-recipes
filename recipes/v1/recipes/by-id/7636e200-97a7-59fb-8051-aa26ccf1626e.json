{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7636e200-97a7-59fb-8051-aa26ccf1626e",
  "slug": "bean-tamales-tameles-de-frijoles",
  "name": "Tamales de Frijoles (Bean Tamales)",
  "recipe_type": "main",
  "brief_description": "In this authentic Mexican recipe for bean tamales, both the masa and the refried beans are mixed with ancho chile salsa for a mild, smoky flavor in every bite.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Start the tamales: Place corn husks into a bowl, cover with boiling water, and soak for about 3 hours. Drain, place on a work surface, and cover with a clean, damp towel."
    },
    {
      "position": 2,
      "text": "Make the salsa: Place ancho chiles into a saucepan, cover with water, and bring to a boil over medium heat; cook until soft, about 10 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Combine ancho chiles, garlic, cumin, salt, and pepper in a blender. Add water and blend until smooth. Strain through a sieve."
    },
    {
      "position": 4,
      "text": "Finish the tamales: Heat oil in a large skillet over medium heat. Add 1/2 of the salsa and cook for 3 to 5 minutes. Stir in refried beans until well combined; cook until most of the liquid has evaporated, about 5 minutes. Remove from the heat."
    },
    {
      "position": 5,
      "text": "Beat lard with an electric mixer in a large bowl until fluffy. Gradually add masa flour and beat until well combined. Add remaining salsa and continue beating until dough is uniformly red in color."
    },
    {
      "position": 6,
      "text": "Select one wide corn husk. Starting 2 inches from the bottom of the husk, spread about 2 tablespoons masa mixture over the surface, ending about 1/4 inch from the top. Place 1 tablespoon beans and 1 jalape\u00f1o slice in the center of masa mixture. Fold the sides of the husk together, one over the other. Fold the bottom of the husk over the seam of the two folded sides. Repeat to make remaining tamales."
    },
    {
      "position": 7,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add tamales with the open side up; cook until filling is heated through and separates from the husk, about 1 hour."
    },
    {
      "position": 8,
      "text": "Let tamales rest for 15 minutes before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 60,

  "id": "97a027ee-89ba-54aa-85aa-3765175469e8",
  "slug": "a-southern-fried-chicken",
  "name": "Crispy Southern Fried Chicken",
  "recipe_type": "main",
  "brief_description": "A cut-up chicken dredged in buttermilk and seasoned flour, then deep-fried to perfection.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a large shallow dish, mix together flour, seasoned salt, garlic powder, onion powder, and black pepper. In a separate bowl, beat eggs, then whisk in buttermilk, barbeque sauce, Worcestershire sauce, and steak sauce."
    },
    {
      "position": 2,
      "text": "Dredge chicken in milk mixture, then in seasoned flour, alternating in each at least twice. Heat oil in a large, deep-sided skillet to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Cook chicken in hot oil until golden brown on both sides, about 10 minutes each side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5f42e41b-679b-5c7f-adf1-bc449a27c105",
  "slug": "tortilla-espanola",
  "name": "Tortilla Espa\u00f1ola",
  "recipe_type": "appetizer",
  "brief_description": "This tortilla Espa\u00f1ola or Spanish tortilla recipe makes a delicious potato omelette that's easy to cook for a light meal or crowd-pleasing tapas.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in an oven-proof skillet over medium heat until it shimmers. Place potatoes into hot oil and season with salt and pepper. Sprinkle with smoked paprika. Pan-fry potatoes, stirring and tossing occasionally, until they start to soften, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Add onion and cook, stirring occasionally, until potatoes and onion are lightly browned and onion is translucent, about 10 more minutes. Remove the skillet from heat and allow to cool for about 5 minutes."
    },
    {
      "position": 4,
      "text": "Beat eggs with 1 teaspoon olive oil in a large bowl. Stir in parsley, then add potato-onion mixture until lightly combined."
    },
    {
      "position": 5,
      "text": "Heat 1 tablespoon olive oil in the same skillet over medium heat until it shimmers. Gently spoon egg-potato mixture into hot oil. Reduce heat to medium-low and shake the skillet a few times to help release omelette from the bottom of the skillet. Slide the skillet into the preheated oven."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until omelette is puffed and the top is golden brown, about 5 minutes. A toothpick inserted into the center of omelette should come out clean; cut into pie-shaped pieces and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7d864943-0683-54c2-89cb-7fb17fead263",
  "slug": "creamy-breakfast-enchiladas-recipe-11848933",
  "name": "Creamy Breakfast Enchiladas",
  "recipe_type": "breakfast",
  "brief_description": "These creamy breakfast enchiladas, with sausage, cheese, eggs, and plenty of salsa, are prepared as a casserole the night before to bake in the morning. They're family-friendly and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook sausage in a skillet over medium heat until browned and crumbly, about 7 minutes. Reserve 2 tablespoons green onion for garnish. Stir in bell pepper and remaining onion and remove from heat."
    },
    {
      "position": 2,
      "text": "Lightly grease a 9x13-inch baking dish. Divide meat mixture among the tortillas and top evenly with about 2 cups shredded cheese. Roll each tortilla and place seam side down in the prepared dish."
    },
    {
      "position": 3,
      "text": "Whisk together eggs, half-and-half, hot sauce, salt, pepper, garlic powder, flour, and 1/4 cup enchilada sauce in a medium bowl until well blended. Pour mixture over tortillas and top with remaining enchilada sauce. Cover with foil and refrigerate at least 4 hours or overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake casserole, covered, in the preheated oven for 30 minutes. Uncover and top with remaining cheese."
    },
    {
      "position": 6,
      "text": "Bake uncovered until cheese is melted and casserole is lightly browned and bubbly around the edges, 15 to 20 minutes more. Sprinkle with reserved green onions and serve with desired toppings."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

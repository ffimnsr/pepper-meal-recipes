  "id": "9f12257e-e601-5c17-97ca-23145183f31a",
  "slug": "easy-small-batch-blueberry-jam",
  "name": "Easy Small-Batch Blueberry Jam",
  "recipe_type": "dessert",
  "brief_description": "This blueberry jam recipe uses just 4 ingredients and no pectin to make a homemade jam that\u2019s sweet and spreadable with lots of blueberry flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix blueberries, sugar, lemon juice, and cinnamon in a saucepan."
    },
    {
      "position": 3,
      "text": "Cook, stirring constantly, over medium heat until thickened, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the heat and let the jam cool completely. Transfer to an airtight container and refrigerate until chilled and set. Enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,

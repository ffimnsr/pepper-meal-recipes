  "id": "e00c9698-c464-5dc6-a963-e80d27c1f536",
  "slug": "iced-pumpkin-spice-latte-recipe-11828113",
  "name": "Iced Pumpkin Spice Latte",
  "recipe_type": "breakfast",
  "brief_description": "This iced pumpkin spice latte tastes just like a coffee shop latte, and takes hardly any time to throw together\u2014and it\u2019s super customizable. You can use whatever kind of milk you prefer; and increase or decrease the amount of espresso, maple syrup, pumpkin, or spice to suit your tastes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place espresso, milk, maple syrup, pumpkin, vanilla, pumpkin pie spice, and salt into the cup of a high-speed blender. Blend on High speed until fully smooth and combined, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Fill a glass with ice. Pour pumpkin mixture over ice and serve cold. If desired, serve topped with whipped cream and an extra sprinkle of pumpkin pie spice."
    }
  ],

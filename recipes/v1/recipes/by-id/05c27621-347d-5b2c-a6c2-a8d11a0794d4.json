{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "05c27621-347d-5b2c-a6c2-a8d11a0794d4",
  "slug": "low-carb-turkey-stuffed-peppers",
  "name": "Low Carb Turkey-Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "This low-carb turkey-stuffed peppers recipe swaps ground turkey for ground beef and riced cauliflower for white rice in this variation on a favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Add ground turkey, onion, diced fresh jalape\u00f1o, and garlic; cook and stir until turkey browns and vegetables are tender, 8 to 10 minutes. Drain grease from the skillet. Add cauliflower rice, diced tomatoes, tomato sauce, water, chili paste, salt, and black pepper; stir until combined. Reduce heat; simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Place bell pepper halves in the prepared baking dish. Place 1 Colby-Jack cheese cube in each pepper half; fill with turkey mixture. Spoon remaining turkey mixture into the dish around peppers. Cover dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil; sprinkle peppers with shredded Colby-Jack cheese. Bake, uncovered, until peppers are soft and cheese is melted, about 10 minutes more."
    },
    {
      "position": 5,
      "text": "Spoon a little loose turkey mixture onto a plate; place 1 bell pepper half on top. Top each with 1 teaspoon sour cream and 2 slices pickled jalape\u00f1o."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f9565644-b8b8-5f85-b0a9-aa78fee3427c",
  "slug": "aunt-ruths-crab-cakes",
  "name": "Aunt Ruth's Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "This down-home crab cake recipe made with claw meat is heavy on the crab and light on the filler.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir together crushed crackers and water in a large bowl. Let stand until softened, about 1 minute. Fold in crabmeat, egg, mayonnaise, and mustard. Add seafood seasoning, Worcestershire sauce, salt, and pepper; stir gently until evenly mixed. Form crab mixture into 3/4-inch-thick patties and place on a tray."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large skillet over medium heat."
    },
    {
      "position": 3,
      "text": "Cook patties in hot oil until golden brown and hot in the center, about 2 minutes per side. Drain on a paper towel-lined plate before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

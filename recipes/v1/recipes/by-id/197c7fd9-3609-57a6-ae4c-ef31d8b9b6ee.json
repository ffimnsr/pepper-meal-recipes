  "id": "197c7fd9-3609-57a6-ae4c-ef31d8b9b6ee",
  "slug": "veggie-hash-recipe-8620501",
  "name": "Veggie Hash",
  "recipe_type": "breakfast",
  "brief_description": "This veggie hash is loaded with potatoes and fresh veggies and is a meal on its own. Adding a fried egg on top makes it a complete meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add potatoes, onion, and mushrooms. Cook, stirring, for 10 minutes."
    },
    {
      "position": 2,
      "text": "Add mini bell peppers, salt, paprika, parsley, and pepper. Cook for 10 minutes more."
    },
    {
      "position": 3,
      "text": "Stir in chickpeas and spinach. Cook until spinach is wilted, about 5 minutes. Divide mixture between serving plates and top each with a fried egg if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

  "id": "5ccc66c3-77bb-52db-89e1-ce54a04b9fbb",
  "slug": "mushroom-ramen-recipe-11681053",
  "name": "Mushroom Ramen",
  "recipe_type": "soup",
  "brief_description": "In this mushroom ramen, dried shiitake mushrooms season instant ramen broth while they hydrate, and you can toss that seasoning packet. Add a few more ingredients to give body to the broth, and then top with whatever you like best\u2014kimchi, chopped green onions, chili crisp, soft or hard boiled eggs\u2014for even more flavor.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, mushrooms, miso paste, soy sauce, vinegar, garlic, and ginger to a boil in a large soup pot. Reduce heat to low and simmer for 25 minutes."
    },
    {
      "position": 2,
      "text": "Add ramen noodles and dunk in the broth until they no longer float to the top. Cook 5 minutes."
    },
    {
      "position": 3,
      "text": "Ladle into serving bowls and top with your favorite ramen toppings."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

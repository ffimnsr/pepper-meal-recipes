{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a0b46437-38f2-5dc5-8421-3a1222ef2f7f",
  "slug": "pavlova-christmas-trees-recipe-8759319",
  "name": "Pavlova Christmas Trees",
  "recipe_type": "dessert",
  "brief_description": "Chef John's stacked meringues layered with cranberry sauce, pistachios, and whipped cream make a Christmas dessert that is not only beautiful to look at, but surprisingly light.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line 2 baking sheets with parchment paper. Whisk sugar and cornstarch together in a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Add room temperature egg whites, salt, and cream of tartar to a bowl, and beat on high speed with an electric mixer until foamy and doubled in size."
    },
    {
      "position": 3,
      "text": "Add sugar mixture in slowly, 1 tablespoon at a time, beating continuously, until sugar dissolves into egg whites (to test, pinch a small amount; if it feels gritty, beat a little longer). Add vanilla and vinegar, and continue to mix on high until mixture is thick, glossy, and forms stiff peaks."
    },
    {
      "position": 4,
      "text": "Transfer egg white mixture into a piping bag with a star tip. Pipe a circle about a 1/2 inch thick and 2 1/2 to 3 inches across. Make 3 more circles, each one smaller than the first, and then pipe a small meringue \u201ckiss.\u201d Pipe 3 sets per sheet pan, for 6 total sets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the surface of the meringue is no longer sticky, about 1 hour and 15 minutes. For best results, rotate pans halfway through. Exact time will depend on the exact size and shape of meringue, as well as humidity, so continue baking until they are no longer sticky to the touch."
    },
    {
      "position": 6,
      "text": "Turn oven off, prop the oven door slightly open with a wooden spoon, and leave meringues in the oven to cool for at least 1 hour."
    },
    {
      "position": 7,
      "text": "Combine cranberries, sugar, orange zest, star anise, salt, and orange juice in a saucepan and bring to a simmer over medium-high heat. Cook, stirring occasionally, for about 5 minutes, or until the berries are soft, but have not all completely fallen apart, and liquid is slightly reduced and syrupy. Remove from heat to cool, then refrigerate cranberry sauce until needed."
    },
    {
      "position": 8,
      "text": "Whip heavy cream in a bowl with an electric mixer until soft peaks form; refrigerate until needed."
    },
    {
      "position": 9,
      "text": "To assemble each tree, place largest meringue circle on the bottom. Cover with whipped cream, add a spoonful of cranberry sauce, and then sprinkle with chopped pistachios. Finish layer with a small dollop of whipped cream, and top with the second largest meringue circle."
    },
    {
      "position": 10,
      "text": "Continue to build layers in the same order, using successively smaller circles each time, and ending with the smallest meringue kiss. Repeat with remaining ingredients to assemble all 6 trees."
    },
    {
      "position": 11,
      "text": "Drip additional cranberry sauce down the sides, if desired, for a nicer look, then sprinkle with powdered sugar."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 45,

  "id": "18f07fa6-3089-58c7-bba9-35d36b4fdd60",
  "slug": "extreme-banana-nut-bread-ebnb",
  "name": "Extreme Banana Nut Bread 'EBNB'",
  "recipe_type": "main",
  "brief_description": "This banana nut bread is extra moist, dense, and delicious. The recipe makes generous loaves packed with banana flavor and studded with walnuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda, and salt into a large bowl."
    },
    {
      "position": 3,
      "text": "Cream sugar and butter together in a separate bowl. Stir in bananas, eggs, and walnuts until well blended."
    },
    {
      "position": 4,
      "text": "Pour wet ingredients into flour mixture and stir just until blended."
    },
    {
      "position": 5,
      "text": "Divide the batter evenly between the two prepared pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a paring knife inserted into the crown of each loaf comes out clean, 60 to 70 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and let loaves cool in the pans for at least 5 minutes. Turn out onto a cooling rack, and let cool completely, about 30 minutes."
    },
    {
      "position": 8,
      "text": "Slice and serve. For more intense flavor, wrap each loaf in aluminum foil to keep in the moisture, then refrigerate for at least 2 hours before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "b5913bfb-3cbf-53c0-ba2f-8f785ab1f3e5",
  "slug": "sheet-pan-nachos",
  "name": "Sheet Pan Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These sensational sheet pan nachos are loaded with savory chili beef, jalapeños, and cheese, warmed in the oven for the ultimate crispy appetizer.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a sheet pan with aluminum foil."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Mix in water, chili powder, cayenne, salt, and pepper until incorporated."
    },
    {
      "position": 3,
      "text": "Lay out tortilla chips on the prepared sheet pan. Top with ground beef mixture."
    },
    {
      "position": 4,
      "text": "Cover with jalapeño slices and olives. Sprinkle with Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Cook under the preheated broiler until cheese is bubbly and golden brown, 3 to 5 minutes. Serve with sour cream and salsa for dipping."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "5b02709e-987d-5e1c-ac6b-feca274f3b5d",
  "slug": "meatloaf-for-tomato-haters",
  "name": "Meatloaf for Tomato Haters",
  "recipe_type": "main",
  "brief_description": "Brighten up your dinner table with this meatloaf made without ketchup! This tomato-free dish gets its flavor from hot sauce and a package of gravy mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix onion, bell pepper, bread crumbs, hot pepper sauce, egg, salt, and pepper together in a large bowl. Add ground beef and mix until well combined. Press into a loaf pan and sprinkle gravy mix over top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned on the outside and no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Remove from the oven and let rest for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

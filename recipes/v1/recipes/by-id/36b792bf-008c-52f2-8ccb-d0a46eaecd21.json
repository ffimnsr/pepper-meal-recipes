  "id": "36b792bf-008c-52f2-8ccb-d0a46eaecd21",
  "slug": "chocolate-chip-and-pumpkin-bread",
  "name": "Chocolate Chip and Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "Chocolate pumpkin bread with a generous amount of chocolate chips is a holiday-favorite or treat any time of the year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray two 9x5-inch loaf pans with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat pumpkin puree, white sugar, brown sugar, eggs, vegetable oil, vanilla extract, and pumpkin pie spice together in a bowl; add flour and beat until batter forms. Fold chocolate chips into batter; divide between the 2 prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour. Cool bread in pans for 15 minutes before removing."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "4b3a73d5-6978-523b-b922-6bfb0f40cc21",
  "slug": "tostadas-de-salpicon-shredded-beef",
  "name": "Tostadas de Salpicon (Shredded Beef)",
  "recipe_type": "soup",
  "brief_description": "These tostadas de salpicon are made with shredded beef that is cooked in a savory broth with tomatoes, onion, lime juice, and serrano chiles.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chuck roast, broth, tomatoes, onion, bay leaves, serrano chiles, lime juice, vinegar, oregano, salt, and pepper in a large pot pot over medium-high heat. Bring to a boil, reduce heat to low, and simmer until meat is tender, about 1 1/2 hours."
    },
    {
      "position": 2,
      "text": "Remove roast from pot and shred meat with 2 forks."
    },
    {
      "position": 3,
      "text": "To assemble tostadas, spread a layer of refried beans on tortillas, layer shredded beef, lettuce, tomatoes, cheese, sour cream and salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

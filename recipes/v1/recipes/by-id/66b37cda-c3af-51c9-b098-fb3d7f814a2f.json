  "slug": "overnight-oats-with-strawberries-and-greek-yogurt",
  "name": "Overnight Oats with Strawberries and Greek Yogurt",
  "recipe_type": "breakfast",
  "brief_description": "Overnight oats with strawberries and Greek yogurt is the ultimate healthy pre-planned breakfast that is packed with fiber and protein.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir together oats, almond milk, and Greek yogurt in a bowl. Mix in strawberries, honey, and chia seeds until well combined. Spoon mixture into 3 glass jars with lids."
    },
    {
      "position": 2,
      "text": "Refrigerate the jars overnight to allow the oats to soften. Serve cold in the morning."
    }
  ],
  "servings": 3,

  "id": "7e234e17-edb9-524d-aa78-f299aaab5d66",
  "slug": "authentic-filipino-pancit",
  "name": "Authentic Filipino Pancit",
  "recipe_type": "main",
  "brief_description": "This authentic Filipino chicken pancit dish uses simple ingredients to impart tons of flavor, and it's super easy to prepare.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of water to a boil over high heat. Add chicken thighs and boil until no longer pink in the centers and juices run clear, about 30 minutes. Strain broth into a bowl to reserve. Shred chicken thighs using 2 forks."
    },
    {
      "position": 2,
      "text": "Place noodles in a large bowl and pour in hot chicken broth, adding hot water to cover if needed. Set aside until noodles are softened, 5 to 7 minutes. Blanch noodles with cold water and drain well. Place into a bowl and add soy seasoning, 1 tablespoon olive oil, and sesame oil. Mix well and set aside."
    },
    {
      "position": 3,
      "text": "Heat remaining olive oil in a skillet or large wok over medium-high heat. Saute garlic in the hot oil until it begins to brown, about 1 minute. Add onion and cook for 2 minutes. Add chicken, cabbage, and carrots. Stir-fry for 3 to 4 minutes; season with garlic salt. Mix chicken mixture with noodles, add soy seasoning to taste, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

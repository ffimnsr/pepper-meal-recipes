{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9a5c91ae-c579-5106-b9ab-658a491b368a",
  "slug": "sugar-cookie-bars-with-berries-recipe-11998028",
  "name": "Sugar Cookie Bars with Berries",
  "recipe_type": "dessert",
  "brief_description": "These sugar cookie bars with berries consist of a lemony cookie base, a tangy cream cheese frosting, and a fresh mixed berry topping. The cookie portion of the recipe can be made several days in advance; but wait to top with the berries until you\u2019re ready to serve.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "For cookies, beat butter, 1/2 cup white sugar, brown sugar, lemon zest, and salt together in a large bowl until light and fluffy, about 3 minutes. Add egg, vanilla, and lemon juice and beat until thoroughly incorporated, 1 to 2 minutes. Add flour, baking soda, and baking powder and mix until just combined."
    },
    {
      "position": 3,
      "text": "Place dough into the prepared pan. Using floured hands, press dough firmly and evenly into the bottom of the pan. Sprinkle dough with 1 1/2 teaspoons sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bars are golden brown, 20 to 25 minutes. Remove bars from the oven and place onto a wire rack; cool completely to room temperature in the pan, about 1 hour."
    },
    {
      "position": 5,
      "text": "For frosting. Beat butter and cream cheese together in a bowl until smooth and combined. Add confectioner\u2019s sugar, vanilla, and salt; beat until mixture is completely smooth and combined, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Spread frosting evenly over cooled bars. Sprinkle berries over frosting and press down lightly to adhere. If desired, refrigerate bars for about 30 minutes to allow frosting to set up slightly."
    },
    {
      "position": 7,
      "text": "Remove bars from the pan using the parchment overhang, and place onto a cutting board. Gently peel parchment paper off the bars, then cut with a very sharp knife into 9 bars. Refrigerate any extra bars."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

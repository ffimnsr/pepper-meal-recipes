  "id": "06ec3a4e-0d84-5c2a-a743-5b2bb4bde5f6",
  "slug": "strawberry-yogurt-pie-i",
  "name": "Strawberry Yogurt Pie I",
  "recipe_type": "dessert",
  "brief_description": "Strawberry yogurt, whipped topping and sliced strawberries are combined, poured into a baked crust and frozen overnight. Garnish this creamy-sweet pie with sprigs of mint and whole berries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix yogurt with 3 and 1/2 cups of the dessert topping until blended. Sweeten the strawberries, if necessary. Mix in strawberries and spoon into crust."
    },
    {
      "position": 2,
      "text": "Freeze for at least 3 hours or overnight, if possible, until it\u2019s firm."
    },
    {
      "position": 3,
      "text": "Remove from freezer and top with remainder of dessert topping. Store in freezer."
    }
  ],

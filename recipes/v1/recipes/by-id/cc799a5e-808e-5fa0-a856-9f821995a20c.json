  "id": "cc799a5e-808e-5fa0-a856-9f821995a20c",
  "slug": "cheese-n-rice-quesadillas",
  "name": "Cheese 'n Rice Quesadillas",
  "recipe_type": "appetizer",
  "brief_description": "Serve cheese and rice in quesadillas at your next party for a surefire hit. Green chiles and Mexican rice add spice to this out-of-this-world appetizer. Serve with guacamole, sour cream, and chopped fresh cilantro.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Bring water, rice, chiles, and spread to a boil in a medium saucepan. Reduce heat and simmer uncovered, stirring occasionally, until rice is tender, about 10 minutes. Let stand for 10 minutes."
    },
    {
      "position": 3,
      "text": "Place 5 tortillas on a baking sheet. Top each with rice mixture, sprinkle with cheese, and cover with another tortilla."
    },
    {
      "position": 4,
      "text": "Cook under the preheated broiler until tortillas are lightly toasted and cheese is melted, turning once."
    },
    {
      "position": 5,
      "text": "Cut each quesadilla into 4 wedges to serve."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

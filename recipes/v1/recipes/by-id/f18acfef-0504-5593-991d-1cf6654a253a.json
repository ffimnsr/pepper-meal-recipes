  "id": "f18acfef-0504-5593-991d-1cf6654a253a",
  "slug": "healthier-buffalo-chicken-dip",
  "name": "Healthier Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Buffalo chicken dip made with lean chicken, light ranch dressing, and reduced-fat cheese has had a healthy makeover without losing flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat chicken and hot sauce in a skillet over medium heat until heated through, about 5 minutes. Stir in cream cheese and ranch dressing; cook and stir until well blended and warm, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Mix in 1/2 of the Cheddar."
    },
    {
      "position": 4,
      "text": "Transfer mixture to a slow cooker. Sprinkle remaining Cheddar over top. Cover and cook on Low until hot and bubbly, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Serve with celery sticks and crackers."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

  "id": "61f22e0c-580a-58af-9868-bc45d134b8e7",
  "slug": "lighter-banana-muffins",
  "name": "Lighter Banana Muffins",
  "recipe_type": "snack",
  "brief_description": "There is no oil or butter in these muffins, but they are still rich and moist -with eggs and all that banana, how could they not be? So gobble them up with a clear conscience!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease or line 10 muffin cups."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine eggs and bananas. In a separate bowl, mix together flour, salt, sugar and baking soda. Stir banana mixture into flour mixture. Fold in walnuts if desired. Pour batter into prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 20 to 25 minutes, or until a toothpick inserted into center of a muffin comes out clean."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

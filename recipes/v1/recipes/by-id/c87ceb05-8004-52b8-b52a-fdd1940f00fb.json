  "id": "c87ceb05-8004-52b8-b52a-fdd1940f00fb",
  "slug": "mexican-pumpkin-empanadas",
  "name": "Pumpkin Empanadas",
  "recipe_type": "appetizer",
  "brief_description": "These pumpkin empanadas are made with a simple sweet dough stuffed with spiced pumpkin filling for a tasty Mexican breakfast, snack, or dessert.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "To make the dough: Whisk flour, sugar, salt, and baking powder together in a large bowl. Cut shortening into flour mixture until it resembles coarse crumbs. Add just enough water for dough to hold together; do not overmix. Knead dough a few times in the bowl."
    },
    {
      "position": 3,
      "text": "Transfer dough out onto a floured surface. Cut dough in quarters, then cut each quarter into thirds to make 12 equal portions. Roll each portion into a ball. Cover with a cloth and allow to rest while you make filling."
    },
    {
      "position": 4,
      "text": "To make the filling: Mix pumpkin, sugar, eggs, cinnamon, salt, ginger, and cloves together in a large bowl until smooth."
    },
    {
      "position": 5,
      "text": "Roll each dough ball out on a floured surface into a thin, 6-inch circle. Spoon about 1/3 cup filling into the center of each dough circle. Fold dough over filling to make a half-moon-shaped pie, then crimp the edges together with a fork. Place onto the prepared baking sheets. Brush the tops with beaten egg."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the filling is hot and crusts are golden brown, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

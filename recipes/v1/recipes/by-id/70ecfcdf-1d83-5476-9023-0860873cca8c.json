  "id": "70ecfcdf-1d83-5476-9023-0860873cca8c",
  "slug": "creamy-jalapeno-deviled-eggs",
  "name": "Creamy Jalapeno Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Creamy jalapeno deviled eggs topped with crumbled bacon are spicy twist on the traditional deviled egg recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Spoon egg yolks into a bowl. Add cream cheese, mayonnaise, and garlic powder; mix well. Fold 3 crumbled slices of bacon and jalapeno pepper into egg yolk mixture; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Fill each egg white half with egg yolk filling. Sprinkle remaining crumbled bacon over filling and top with paprika. Chill in refrigerator for about 1 hour before serving."
    }
  ],
  "servings": 10,

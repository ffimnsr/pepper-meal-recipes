  "id": "a7ddbbb2-cae6-5af3-ab7b-eb02b33ea2b0",
  "slug": "easy-chocolate-cupcakes",
  "name": "Easy Chocolate Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These chocolate cupcakes are easy to make and very tasty. You can also bake them as a cake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two muffin pans or line with 20 paper baking cups."
    },
    {
      "position": 2,
      "text": "In a medium bowl, beat the butter and sugar with an electric mixer until light and fluffy. Mix in the eggs, almond extract and vanilla. Combine the flour, cocoa, baking powder and salt; stir into the batter, alternating with the milk, just until blended. Spoon the batter into the prepared cups, dividing evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the tops spring back when lightly pressed, 20 to 25 minutes. Cool in the pan set over a wire rack. When cool, arrange the cupcakes on a serving platter. Frost with your favorite frosting."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

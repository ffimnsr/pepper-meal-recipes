  "id": "1ab0f8f3-6038-56d0-b8b5-edcfbf4f17a5",
  "slug": "pork-fried-rice",
  "name": "Pork Fried Rice",
  "recipe_type": "main",
  "brief_description": "This pork fried rice recipe with carrots, broccoli, and peas is flavored with garlic and ginger for a quick and easy way to enjoy leftover rice.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large non-stick skillet over medium heat. Add pork, green onion, carrot, and broccoli; cook and stir until pork is cooked through, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer pork mixture to a bowl and return skillet to medium heat. Stir egg into the skillet and scramble until completely set."
    },
    {
      "position": 4,
      "text": "Add pork mixture back into the skillet; stir in rice, peas, soy sauce, garlic powder, and ground ginger."
    },
    {
      "position": 5,
      "text": "Cook and stir until heated through, 7 to 10 minutes. Serve and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

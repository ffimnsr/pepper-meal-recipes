  "schema_version": 1,
  "id": "4ac88574-4fde-5723-9d37-b0c849303506",
  "slug": "chicken-parmesan-pasta-casserole",
  "name": "Chicken Parmesan Pasta Casserole",
  "recipe_type": "main",
  "brief_description": "Try this chicken Parmesan pasta bake. All the flavors and textures of a traditional chicken Parm are baked into this crowd-pleasing casserole recipe.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once the water is boiling, stir in pasta and return to a boil. Cook uncovered, stirring occasionally, until pasta has cooked through but is still firm to the bite, about 8 minutes. Drain well in a colander set in the sink."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C), and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Make a breading station: Place flour, egg, and bread crumbs in three separate bowls. Mix garlic powder into bread crumbs. Working in batches, coat chicken in flour, then dip in egg, and finally coat with bread crumbs."
    },
    {
      "position": 4,
      "text": "Carefully fry coated chicken in hot oil in small batches until golden brown and no longer pink in the center, 3 to 4 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Drain fried chicken over paper towels."
    },
    {
      "position": 5,
      "text": "Combine cooked pasta, fried chicken, 1/2 of the mozzarella cheese, and 1/2 cup grated Parmesan cheese in a large bowl. Stir in marinara sauce. Pour red wine into the empty marinara sauce jar; cover and shake the jar, and empty the contents into the bowl of pasta. Stir to combine. Spread pasta mixture in a large casserole dish and cover with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 30 minutes. Remove the aluminum foil and sprinkle with remaining mozzarella cheese and 1/2 cup of Parmesan. Return to the oven and continue baking until cheese has melted, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and allow to rest for 5 minutes before serving. Serve hot."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b7a1e64e-262a-58ba-b8c9-375cda0c9ab3",
  "slug": "cadbury-creme-egg-cookies-recipe-8601334",
  "name": "Cadbury Creme Egg Cookies",
  "recipe_type": "dessert",
  "brief_description": "After Domino's UK came out with a Cadbury Creme Egg-stuffed cookie, we saw versions popping up all over social media and knew we had to create our own version. This recipe starts store-bought brownie mix to make a super fudgy chocolate cookie dough with a fraction of the work. Here's how to make them.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Place creme eggs in the freezer and freeze until solid, at least 2 hours or up to 12 hours."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C) with rack in top third position. Line two large baking sheets with parchment paper, and set aside."
    },
    {
      "position": 3,
      "text": "Stir together brownie mix, chocolate syrup packet, flour, butter, egg, and espresso powder (if using) in a large bowl until just combined into a stiff dough that resembles the texture of Play-Doh. Stir in chocolate chips until just combined."
    },
    {
      "position": 4,
      "text": "Unwrap frozen creme eggs, and set aside. Portion cookie dough into 10 even portions (about 3 oz. each; about 1/4 cup packed dough). Working with 1 portion at a time, flatten dough in palm of your hand to form an even round. Place 1 frozen creme egg in center of dough round, and wrap dough to fully enclose the creme egg; place on prepared baking sheet. Repeat with remaining creme eggs and dough portions, ensuring that cookie dough balls are placed at least 2 inches apart on each baking sheet (5 per baking sheet)."
    },
    {
      "position": 5,
      "text": "Bake one baking sheet at a time in preheated oven until cookies are just set on the edges and on top, 10 to 11 minutes. Do not overbake or the creme eggs may seep out of the cookie. Let cool on baking sheet slightly, about15 minutes. Serve warm, or let cool completely on a wire rack and store in an airtight container for up to 2 days. Recipe developed by Nicole Hopper"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

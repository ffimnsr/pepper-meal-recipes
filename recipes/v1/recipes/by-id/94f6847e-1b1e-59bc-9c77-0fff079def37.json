  "id": "94f6847e-1b1e-59bc-9c77-0fff079def37",
  "slug": "aunt-freddie-s-pound-cake-recipe-11929417",
  "name": "Aunt Freddie\u2019s Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "My Aunt Freddie's traditional pound cake uses a pound each of butter, sugar, and eggs. Cake flour makes it light, and it has just a hint of lemon juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 16 cup tube pan."
    },
    {
      "position": 2,
      "text": "Beat butter alone in a bowl until smooth and creamy, then add sugar gradually; beat until light and fluffy. Add eggs 1 at a time, mixing after each addition."
    },
    {
      "position": 3,
      "text": "Whisk flour and salt together into a bowl, then add gradually, mixing after each addition. Beat in vanilla and lemon juice. Pour into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out mostly clean, about 1 hour. Let cool in the pan. Run a knife around the edge of the cake; invert onto a plate."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 60,

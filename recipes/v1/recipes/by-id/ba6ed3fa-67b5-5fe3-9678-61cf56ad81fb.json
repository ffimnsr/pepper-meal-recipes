  "id": "ba6ed3fa-67b5-5fe3-9678-61cf56ad81fb",
  "slug": "lentil-and-green-collard-soup",
  "name": "Lentil and Green Collard Soup",
  "recipe_type": "soup",
  "brief_description": "This lentil and collard soup is loaded red lentils, fresh collard greens, fragrant spices, and lemon juice. Enjoy it hot or cold in any weather.",
  "cuisine": "Lebanese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon olive oil in a large saucepan over medium heat. Stir in onion and salt; cook until softened and translucent, about 4 minutes. Stir in lentils and cook for 1 minute. Pour in water, increase the heat to high, and bring to a boil. Reduce the heat to medium-low, cover, and simmer until lentils are tender, about 15 minutes."
    },
    {
      "position": 2,
      "text": "While the lentils are cooking, heat remaining 2 tablespoons oil in a large skillet over medium heat. Add collard greens and cook until wilted, about 10 minutes."
    },
    {
      "position": 3,
      "text": "When lentils are tender, stir in collard greens, garlic, cumin, and cinnamon; simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir in lemon juice before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

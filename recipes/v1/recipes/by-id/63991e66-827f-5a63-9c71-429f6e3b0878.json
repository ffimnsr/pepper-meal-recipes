  "id": "63991e66-827f-5a63-9c71-429f6e3b0878",
  "slug": "oven-baked-bbq-ribs",
  "name": "Oven-Baked BBQ Ribs",
  "recipe_type": "main",
  "brief_description": "Spareribs are baked in the oven and basted continually with a tangy homemade BBQ sauce until fall of the bone tender and full of flavor!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Split ribs down the center between the bones."
    },
    {
      "position": 3,
      "text": "Mix onions, ketchup, water, vinegar, brown sugar, Worcestershire sauce, mustard powder, and salt together in a bowl. Set aside 1/2 of the sauce for basting."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium-high heat. Working in several batches, add ribs and sear until browned, 4 to 5 minutes per batch."
    },
    {
      "position": 5,
      "text": "Transfer ribs to two baking pans and arrange in a single layer. Pour remaining BBQ sauce over ribs."
    },
    {
      "position": 6,
      "text": "Bake ribs in the preheated oven, turning and basting with sauce every 20 minutes and adding reserved sauce as needed, until meat easily pulls away from the bone, about 2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

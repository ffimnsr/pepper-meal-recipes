  "id": "18f315b2-5d6f-5dd6-9023-9ed943cc75e7",
  "slug": "curry-chicken-salad-with-grapes",
  "name": "Curry Chicken Salad with Grapes",
  "recipe_type": "salad",
  "brief_description": "Curry chicken salad with grapes, almonds, and parsley is a nice salad topper, filling for a croissant, or a snack simply eaten with a fork.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over low heat. Remove from heat; cool to room temperature."
    },
    {
      "position": 2,
      "text": "Stir mayonnaise, garlic, parsley, and curry powder into butter until combined. Fold in chicken, grapes, and almonds; transfer to a serving bowl. Cover with plastic wrap; refrigerate until flavors blended, at least 1 hour."
    }
  ],
  "servings": 12,

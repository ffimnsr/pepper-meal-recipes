  "id": "0c304319-05b0-5e80-9ed1-4117387dfdcf",
  "slug": "banana-oat-energy-bars",
  "name": "Banana Oat Energy Bars",
  "recipe_type": "appetizer",
  "brief_description": "Banana oat energy bars with peanuts, carrots, and apples are a great pre- or post-workout snack or on-the-go energy booster.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix oats, bananas, carrots, apple, applesauce, and peanuts together in a bowl; spread into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

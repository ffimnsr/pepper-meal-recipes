  "slug": "bubbly-mojito",
  "name": "Bubbly Mojito",
  "recipe_type": "drink",
  "brief_description": "This bubbly mojito recipe is a tweak on the typical cocktail crafted with white rum and sparkling wine, for an incredibly festive summertime beverage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place mint leaves and sugar in the bottom of a Collins glass; mash well with a cocktail muddler. Add rum and lime wedges to the glass; muddle. Top with sparkling wine and crushed ice."
    }
  ],

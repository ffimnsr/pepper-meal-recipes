  "id": "0dc04b09-7e83-5d1e-af9e-6679036bc0ac",
  "slug": "pecan-pie-with-maple-syrup",
  "name": "Pecan Pie with Maple Syrup",
  "recipe_type": "dessert",
  "brief_description": "Try this pecan pie with maple syrup (instead of corn syrup)! It's easy to prepare and sure to please holiday guests with its sticky-sweet filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place a rack in the lowest position."
    },
    {
      "position": 2,
      "text": "Mix maple syrup, brown sugar, eggs, melted butter, and vanilla in a large bowl until well blended. Stir in pecans until coated."
    },
    {
      "position": 3,
      "text": "Pour batter into the pie shell."
    },
    {
      "position": 4,
      "text": "Bake on the lower rack of the preheated oven until the pie shell is golden brown and the filling is set, 35 to 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

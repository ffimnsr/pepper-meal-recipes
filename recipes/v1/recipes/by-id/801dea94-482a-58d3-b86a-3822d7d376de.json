  "id": "801dea94-482a-58d3-b86a-3822d7d376de",
  "slug": "orzo-with-parmesan-and-basil",
  "name": "Orzo with Parmesan and Basil",
  "recipe_type": "side",
  "brief_description": "This Parmesan orzo is sautéed in butter, simmered in chicken stock, then mixed with Parmesan cheese and fresh basil for an easy, flavorful side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a heavy skillet over medium-high heat. Stir in orzo and sauté until lightly browned."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth and bring to boil. Cover, reduce heat, and simmer until orzo is tender and liquid is absorbed, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Mix in Parmesan cheese and 1/4 cup chopped basil. Season with salt and pepper. Transfer to a shallow bowl and garnish with remaining basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

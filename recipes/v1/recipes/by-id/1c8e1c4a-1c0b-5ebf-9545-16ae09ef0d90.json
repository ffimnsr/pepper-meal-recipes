  "id": "1c8e1c4a-1c0b-5ebf-9545-16ae09ef0d90",
  "slug": "chinese-chicken-wings",
  "name": "Chinese Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "These Chinese chicken wings are marinated overnight in a mixture of soy sauce, brown sugar, and garlic powder, then oven-baked until hot and crisp.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together soy sauce, brown sugar, and garlic powder in a saucepan over medium heat. Cook and stir until sugar has dissolved. Remove from heat and allow to cool."
    },
    {
      "position": 2,
      "text": "Place chicken wings in a large bowl. Pour soy sauce mixture over wings and toss to coat evenly. Cover the bowl with plastic wrap. Allow chicken to marinate in the refrigerator for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Pour chicken wings and marinade into a 9x13-inch baking dish. Cover the baking dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until thoroughly hot, about 45 minutes. Remove foil and bake for 15 more minutes. Serve hot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 5,

  "id": "bf1a4400-db52-5fd2-bb82-172466674d92",
  "slug": "rice-pudding-with-saffron-and-cardamom",
  "name": "Rice Pudding with Saffron and Cardamom",
  "recipe_type": "dessert",
  "brief_description": "The saffron and cardamom in this quick and easy rice pudding deliver flavor and fragrance; try it as a great make-ahead Thanksgiving dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, rice flour, and sugar in a saucepan over medium heat. Cook, stirring constantly, until the mixture thickens, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Mix milk, rose water. saffron, and cardamom together in a bowl; add to rice mixture. Bring to a boil and stir until there are no clumps, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Carefully ladle hot mixture into 6 cups; garnish each with 3 pistachios. Refrigerate for at least 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

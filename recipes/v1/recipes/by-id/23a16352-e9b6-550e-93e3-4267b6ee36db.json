  "id": "23a16352-e9b6-550e-93e3-4267b6ee36db",
  "slug": "georgia-pot-roast-recipe-8349877",
  "name": "Georgia Pot Roast",
  "recipe_type": "dessert",
  "brief_description": "Georgia Pot Roast, a TikTok recipe from Allrecipes Allstar sweetpealifestyle, is a simple twist on the Mississippi Pot Roast recipe. Using pickled Vidalia onions, instead of pepperoncini, this recipe is sure to please everyone. Serve over rice, noodles, mashed potatoes, or mashed cauliflower.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add chuck roast to a slow cooker (no need to sear it first). Sprinkle roast with au jus packet, ranch seasoning packet. Pour pickled onions over roast."
    },
    {
      "position": 2,
      "text": "Cover the slow cooker; cook on High for 4 to 6 hours, or on Low 6 to 8 hours."
    },
    {
      "position": 3,
      "text": "Halfway through the cooking process, if you need to add some liquid, add beef stock as needed."
    },
    {
      "position": 4,
      "text": "When the roast is impossibly tender and falling apart, remove to shred. Return shredded beef to the liquid."
    },
    {
      "position": 5,
      "text": "In a bowl, mash butter with flour to make a paste; stir butter mixture into beef and liquid to thicken gravy. Continue to cook for 30 minutes, uncovered."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 5,

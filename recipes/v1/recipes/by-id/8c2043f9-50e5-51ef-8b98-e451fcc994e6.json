  "schema_version": 1,
  "id": "8c2043f9-50e5-51ef-8b98-e451fcc994e6",
  "slug": "sous-vide-butter-poached-lobster-tails",
  "name": "Sous Vide Butter-Poached Lobster Tails",
  "recipe_type": "main",
  "brief_description": "These sous vide lobster tails are poached with butter, dried parsley, lemon slices, and garlic for a delicious and romantic meal on Valentine's Day.",
  "cuisine": "American French",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with warm water. Attach the sous vide cooker to the pot; set the temperature to 130 degrees F (54 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut underside of lobster tail with kitchen shears and remove fins; carefully lift out meat."
    },
    {
      "position": 3,
      "text": "Place 1 lemon slice in the bottom of a resealable plastic bag. Place lobster tail meat over lemon and spread with 1 teaspoon butter. Season with a pinch of parsley and garlic. Repeat with remaining lobster tail, lemon, butter, parsley, and garlic using a second resealable plastic bag."
    },
    {
      "position": 4,
      "text": "Use the water immersion method to remove all air from the bags and place into the pot, securing with tongs so they are fully immersed."
    },
    {
      "position": 5,
      "text": "Cook in the preheated water for 30 minutes. Remove the bags from the pot, open, and move lobster tails to a warm plate."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

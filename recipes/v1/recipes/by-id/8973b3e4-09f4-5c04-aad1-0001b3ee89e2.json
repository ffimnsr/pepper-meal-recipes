  "schema_version": 1,
  "id": "8973b3e4-09f4-5c04-aad1-0001b3ee89e2",
  "slug": "grilled-hawaiian-chicken-and-pineapple-sandwiches",
  "name": "Grilled Hawaiian Chicken and Pineapple Sandwiches",
  "recipe_type": "main",
  "brief_description": "These tasty Hawaiian chicken sandwiches make a delicious lunch. Marinated, grilled chicken is stacked on onion buns with tart pineapple and buttery provolone cheese.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour marinade into a large resealable bag. Add chicken breasts, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 1 hour, or overnight."
    },
    {
      "position": 2,
      "text": "When ready to cook, preheat an outdoor grill for medium-high heat and lightly oil the grate with cooking spray."
    },
    {
      "position": 3,
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 4,
      "text": "Cook chicken on the preheated grill until no longer pink in the center and the juices run clear, about 10 minutes, turning halfway through. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "When you turn the chicken, place pineapple slices onto the grill; cook for about 2 minutes per side. Toast rolls on the grill if desired."
    },
    {
      "position": 6,
      "text": "Place a grilled pineapple slice onto each chicken breast, then top with provolone. Close the lid and cook until cheese is melted, about 1 minute."
    },
    {
      "position": 7,
      "text": "Transfer chicken breasts, pineapple rings, and cheese to bottom rolls, then top with lettuce and tomato. Spread dressing onto top rolls and place onto sandwiches."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

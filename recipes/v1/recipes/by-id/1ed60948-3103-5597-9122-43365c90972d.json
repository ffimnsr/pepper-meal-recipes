  "id": "1ed60948-3103-5597-9122-43365c90972d",
  "slug": "pumpkin-cookies-i",
  "name": "Butterscotch Pumpkin Cookies",
  "recipe_type": "dessert",
  "brief_description": "Yummy pumpkin cookies with spices and butterscotch morsels. Moist, delicious, and perfect for fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Cream shortening and sugar together in a medium bowl; stir in pumpkin and vanilla. Sift flour, salt, baking soda, baking powder, and cinnamon together; stir into creamed mixture. Mix in butterscotch chips. Drop dough by teaspoonfuls onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 8 to 10 minutes in preheated oven. Allow cookies to cool for a minute on cookie sheets before transferring to wire cooling racks."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

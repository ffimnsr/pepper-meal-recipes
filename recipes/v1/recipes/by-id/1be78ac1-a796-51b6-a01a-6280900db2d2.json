  "id": "1be78ac1-a796-51b6-a01a-6280900db2d2",
  "slug": "spaghetti-with-corned-beef",
  "name": "Spaghetti with Corned Beef",
  "recipe_type": "main",
  "brief_description": "Ready-made spaghetti sauce is simmered with savory corned beef to make a thick, hearty topping for spaghetti cooked in bouillon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve bouillon in boiling water. Break spaghetti noodles in half and add to boiling water until done."
    },
    {
      "position": 2,
      "text": "Over medium heat empty can of corned beef onto a skillet. Add spaghetti sauce to meat. Stir until heated; corned beef will come apart and a thick sauce will form. If desired, add Italian seasoning, garlic powder, dry onion, or any other spices."
    },
    {
      "position": 3,
      "text": "Once noodles are done, drain and combine with corned beef sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

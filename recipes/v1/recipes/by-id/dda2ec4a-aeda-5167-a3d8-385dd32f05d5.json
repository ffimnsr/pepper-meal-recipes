  "id": "dda2ec4a-aeda-5167-a3d8-385dd32f05d5",
  "slug": "chicken-thigh-bulgogi-tacos",
  "name": "Chicken Thigh Bulgogi Tacos",
  "recipe_type": "main",
  "brief_description": "These chicken thigh bulgogi tacos topped with quick-pickled cucumber, red cabbage slaw, and sriracha cream are surprisingly easy to whip up.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Mix 3 tablespoons vinegar, sugar, salt, and pepper together in a bowl. Mix in cucumbers."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add cabbage and white parts of scallions to the skillet; cook, stirring occasionally, until softened, 3 to 4 minutes. Transfer to a bowl and toss with salt and pepper and remaining vinegar."
    },
    {
      "position": 3,
      "text": "Season chicken with salt and pepper. Cook in the same skillet until juices run clear, 4 to 7 minutes. Stir in sauce; cook until reduced, about 2 minutes more."
    },
    {
      "position": 4,
      "text": "Mix sour cream, water, and sriracha sauce together. Spread some of the mixture over each tortilla. Top with bulgogi chicken, cucumbers, cabbage, and green parts of scallions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5bc73113-1311-5fc8-9beb-322245e85919",
  "slug": "bill-clintons-lemon-chess-pie",
  "name": "Bill Clinton's Lemon Chess Pie",
  "recipe_type": "dessert",
  "brief_description": "This lemon chess pie has a rich and smooth filling made with milk and eggs, flavored with lemon juice and lots of zest for a sweet and tangy dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a large mixing bowl until light and fluffy. Beat in eggs and milk. Add flour, cornmeal, lemon juice, and lemon zest. Mix until smooth. Pour mixture into prepared pastry crust."
    },
    {
      "position": 3,
      "text": "Bake pie in the preheated oven until center is set, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

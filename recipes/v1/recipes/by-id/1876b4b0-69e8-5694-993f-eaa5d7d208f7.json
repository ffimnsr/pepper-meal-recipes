  "id": "1876b4b0-69e8-5694-993f-eaa5d7d208f7",
  "slug": "oven-baked-chicken-teriyaki",
  "name": "Oven Baked Chicken Teriyaki",
  "recipe_type": "main",
  "brief_description": "Chicken is baked in a simple homemade teriyaki sauce for a quick and easy weeknight dinner.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk cornstarch and water together in a small bowl until dissolved; set aside. Combine soy sauce, sugar, mirin, ginger, garlic, and red pepper flakes together in a saucepan over medium heat until the mixture starts to simmer. Slowly whisk in cornstarch mixture. Bring to a boil; reduce heat to medium-low, and simmer until thickened, stirring often, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Pat chicken dry with paper towels; arrange in a baking dish. Pour sauce over chicken breasts, coating all sides."
    },
    {
      "position": 4,
      "text": "Bake chicken breasts in the preheated oven until no longer pink in the center and the juices run clear, 25 to 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (75 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

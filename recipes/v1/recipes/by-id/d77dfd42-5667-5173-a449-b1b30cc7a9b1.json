  "id": "d77dfd42-5667-5173-a449-b1b30cc7a9b1",
  "slug": "make-ahead-mashed-potatoes",
  "name": "Make-Ahead Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These make-ahead mashed potatoes are deliciously rich thanks to the addition of cream cheese and sour cream. Simply heat through when ready to serve!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large pot of lightly salted water. Bring to a boil and cook until tender, about 15 minutes; drain."
    },
    {
      "position": 3,
      "text": "Transfer potatoes into a large bowl and mash."
    },
    {
      "position": 4,
      "text": "Stir in sour cream, cream cheese, milk, onion salt, and pepper until well combined."
    },
    {
      "position": 5,
      "text": "Transfer into a large casserole dish. Let potatoes cool completely, 15 to 20 minutes. Cover with aluminum foil and refrigerate for up to 2 days."
    },
    {
      "position": 6,
      "text": "When ready to bake, remove casserole from the refrigerator and let sit for 30 minutes on the counter. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake, covered, in the preheated oven for 50 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

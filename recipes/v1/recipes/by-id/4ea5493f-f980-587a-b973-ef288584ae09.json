  "id": "4ea5493f-f980-587a-b973-ef288584ae09",
  "slug": "mediterranean-meat-pies-sfeeha",
  "name": "Mediterranean Meat Pies (Sfeeha)",
  "recipe_type": "appetizer",
  "brief_description": "This Lebanese meat pie recipe is a savory combo of ground beef and lamb tucked inside puff pastry and baked for crispy appetizer bites.",
  "cuisine": "Lebanese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Stir in ground beef, ground lamb, onion, pine nuts, cinnamon, and salt and black pepper. Cook and stir until meat is crumbly, evenly browned, and no longer pink. Drain and discard any excess grease."
    },
    {
      "position": 2,
      "text": "Stir in lemon juice. Taste and adjust the seasonings. Let the meat mixture cool."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet or line it with parchment paper."
    },
    {
      "position": 4,
      "text": "Roll out thawed pastry sheets to about 1/8 inch thick. Using a sharp 3-inch round cookie cutter, cut out at least 9 rounds per sheet. Lightly brush the inside edges with a little water, and place about 2 teaspoons of filling into the middle of each round. Fold the pastry round in half to cover the filling and seal the edges well. Transfer to the prepared baking sheet and repeat with the remaining dough circles."
    },
    {
      "position": 5,
      "text": "Brush each pie with a little egg wash. Bake in the preheated oven until golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

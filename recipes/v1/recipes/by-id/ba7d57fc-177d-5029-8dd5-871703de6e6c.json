  "id": "ba7d57fc-177d-5029-8dd5-871703de6e6c",
  "slug": "black-bean-tostadas",
  "name": "Black Bean Tostadas",
  "recipe_type": "main",
  "brief_description": "Prepare a vegetarian, Mexican-inspired weeknight meal in under 30 minutes by combining black beans with seasonings, cheese, and green chiles on crispy corn tostadas.",
  "cuisine": "Mexican Inspired American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Combine refried black beans, black beans, green chiles, garlic powder, chili powder, cayenne, salt, and pepper in a saucepan. Heat over medium heat until warm and combined, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Place tostada shells on an ungreased baking sheet and evenly distribute bean mixture between them. Top with Monterey Jack cheese."
    },
    {
      "position": 4,
      "text": "Broil in the preheated oven until cheese is melted, watching carefully to avoid burning tostadas, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Serve immediately and garnish with salsa, lettuce, sour cream, and guacamole."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "1bd4ffc7-7f4d-5060-88b7-228d3fbb390b",
  "slug": "pepperoncini-poppers-recipe-11933550",
  "name": "Pepperoncini Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These pepperoncini poppers, split peppers filled with Greek-seasoned feta, wrapped in prosciutto, and air fried, are a delicious variation on a classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice each pepper in half lengthwise and remove any seeds. Allow peppers to dry slightly on paper towels."
    },
    {
      "position": 2,
      "text": "Stir together cheese and Greek seasoning until well combined. Spoon cheese mixture into each hollowed-out pepper."
    },
    {
      "position": 3,
      "text": "Cut prosciutto slices into 30 strips and wrap each filled pepper with prosciutto."
    },
    {
      "position": 4,
      "text": "Air fry at 400 degrees F (200 degrees C) just until cheese is about to begin to ooze and prosciutto is slightly crispy, about 4 minutes. Let stand 10 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

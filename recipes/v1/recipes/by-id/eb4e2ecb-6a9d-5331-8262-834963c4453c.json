{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "eb4e2ecb-6a9d-5331-8262-834963c4453c",
  "slug": "no-water-chicken-soup-recipe-11906010",
  "name": "No Water Chicken Soup",
  "recipe_type": "soup",
  "brief_description": "This no water chicken soup will surprise you. A ton of delightfully water-rich vegetables will produce a ton of broth when simmered with a chicken on top. You'll be amazed to see the magic happen, and be even more so at the flavor. Season each bowl with the dipping sauce ingredients separately, or make the dipping sauce as shown.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add olive oil to a heavy duty Dutch oven with a tight fitting lid. Turn heat to medium-high, and add onions, leek, and salt. Give everything a stir, and as soon as the vegetables just start to sizzle, place on the lid and let cook for 10 minutes. Uncover, making sure any condensation on the lid drips into the Dutch oven."
    },
    {
      "position": 2,
      "text": "Add carrot, celery, mushroom, apple, cabbage, and escarole and carefully press everything down with your hand so they fit. Place the lid back on and cook for another 10 minutes. Remove the lid, once again making sure that any condensation drips into the pot. Give everything a stir, and make a space in the center."
    },
    {
      "position": 3,
      "text": "Place in the chicken, and sprinkle the top generously with more salt. Sprinkle over some cayenne to taste, and place sliced ginger on top of chicken."
    },
    {
      "position": 4,
      "text": "Cover the pot, and reduce the heat to low. Simmer gently until chicken is cooked through, about 1 1/2 hours. This step may require less or more time, depending on the size of the chicken. During this time, except to check for doneness, do not remove the lid or stir the soup. An instant read thermometer inserted into thickest parts should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Taste the broth for seasoning, and adjust if needed. Carefully use tongs to tear off and shred as much chicken as you want, and transfer into a soup bowl. Ladle in broth and vegetables, and serve with dipping sauce alongside."
    },
    {
      "position": 6,
      "text": "Alternatively, the soup can simply be served with condiments stirred into the bowl to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

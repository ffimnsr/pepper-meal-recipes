  "id": "39819267-bf13-5ad9-a960-60ad1c24608d",
  "slug": "chicken-cabbage-stir-fry-recipe-11898030",
  "name": "Chicken Cabbage Stir Fry",
  "recipe_type": "main",
  "brief_description": "This chicken cabbage stir fry is a great choice for weeknight dinner. It is made with shredded cabbage, carrots, peppers, and ground chicken, cooked in a tasty sauce with hoisin, soy sauce, rice vinegar, and honey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a 12-inch skillet over medium heat. Add chicken and cook, breaking it up with a wooden spoon, until no longer pink, about 5 minutes. Remove chicken from the skillet with a slotted spoon; set aside."
    },
    {
      "position": 2,
      "text": "Pour remaining 1 tablespoon oil to the skillet. Add onion, carrots, and bell pepper; cook and stir until softened, about 4 minutes. Add ginger and garlic and cook for 2 minutes more."
    },
    {
      "position": 3,
      "text": "Add 1/2 of the cabbage to the skillet. Cover and cook, stirring occasionally, until it begins to wilt, about 4 minutes. Add remaining cabbage. Cover and cook, stirring occasionally, until all the cabbage is tender and wilted, 6 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Whisk hoisin sauce, soy sauce, rice vinegar, honey, salt, and pepper together in a small bowl. Add sauce mixture and cooked chicken to the skillet. Cook and stir until heated through, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Garnish with sliced green onion before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

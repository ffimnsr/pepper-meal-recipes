{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "56c02783-b38d-5f06-ab00-e2e2ce8cb004",
  "slug": "bacon-cheese-and-caramelized-onion-quiche",
  "name": "Bacon, Cheese, and Caramelized Onion Quiche",
  "recipe_type": "breakfast",
  "brief_description": "Crispy bacon, caramelized onions, and gooey Cheddar cheese star in this fluffy and delicious quiche that makes a perfect brunch, lunch, or dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until crispy, about 10 minutes. Drain on paper towels. Let cool 10 minutes, then crumble and set aside."
    },
    {
      "position": 3,
      "text": "Roll out pastry crust using a lightly floured rolling pin to fit a 9-inch pie plate. Place crust in pie plate. Prick holes into crust bottom using a fork."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven on the middle rack for 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove crust from the oven; brush with beaten egg. Return crust to the oven; bake 5 minutes more."
    },
    {
      "position": 6,
      "text": "Heat butter in a pan over medium heat. Add onion; cook and stir until softened and translucent, about 5 minutes. Reduce heat to low; continue cooking and stirring until onion very tender and dark brown, about 40 minutes more."
    },
    {
      "position": 7,
      "text": "Whisk remaining 2 eggs together in a bowl. Add sour cream and cream cheese; beat with an electric mixer until well combined. Beat in salt and pepper."
    },
    {
      "position": 8,
      "text": "Spread caramelized onions with remaining butter onto pastry crust; sprinkle in 1/2 cup Cheddar cheese. Place crumbled bacon evenly over top; pour in egg mixture, then top with remaining 1/2 cup Cheddar cheese."
    },
    {
      "position": 9,
      "text": "Bake quiche in the preheated oven until golden and fluffy, about 30 minutes. Let cool 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 20,

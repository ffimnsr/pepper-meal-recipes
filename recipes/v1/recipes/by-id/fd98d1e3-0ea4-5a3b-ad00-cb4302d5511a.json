  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together tomato sauce and tomato paste in a medium bowl until smooth."
    },
    {
      "position": 3,
      "text": "Stir in oregano, garlic, and paprika to pizza sauce mixture."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }

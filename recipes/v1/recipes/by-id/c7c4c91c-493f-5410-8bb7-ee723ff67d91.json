  "id": "c7c4c91c-493f-5410-8bb7-ee723ff67d91",
  "slug": "chocolate-dipped-coconut-macaroons",
  "name": "Chocolate-Dipped Coconut Macaroons",
  "recipe_type": "dessert",
  "brief_description": "Condensed milk and tempered chocolate are Chef John's secrets to moist, tender, chewy coconut macaroons that are easy to make and bring to potlucks.",
  "cuisine": "Italian American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine condensed milk, almond extract, vanilla extract, salt, and egg white in a bowl. Whisk until thoroughly combined. Add about 2 1/3 cups shredded coconut. Mix with a spatula until mixture is sticky and holds together. Form into balls using a sorbet scoop."
    },
    {
      "position": 3,
      "text": "Roll balls in remaining coconut. Space macaroons evenly onto a silicone-lined baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 20 minutes. Let cool to room temperature, at least 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, place 3/4 of the chocolate in top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Remove from heat and stir in the rest of the chocolate until it melts."
    },
    {
      "position": 6,
      "text": "Dip the base of each cooled macaroon about 1/8 inch into the chocolate. Place cookies, chocolate-side down, on parchment paper. Let chocolate harden completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

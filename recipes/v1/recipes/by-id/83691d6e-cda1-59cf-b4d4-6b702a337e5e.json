  "id": "83691d6e-cda1-59cf-b4d4-6b702a337e5e",
  "slug": "coconut-curry-butternut-squash-soup",
  "name": "Coconut Curry Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This coconut curry butternut squash soup recipe simmers roasted butternut squash with curry powder, onion, coconut milk, and a hint of grated nutmeg.",
  "cuisine": "American Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butternut squash in a baking dish, flesh-sides up. Brush 1 tablespoon melted butter over flesh; season with \u00bd teaspoon salt, \u00bd teaspoon pumpkin pie spice, and cayenne pepper."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until tender, about 1 hour. Cool for 15 minutes."
    },
    {
      "position": 4,
      "text": "Place a large stockpot over medium heat; stir in 1 tablespoon butter until melted. Add onion; cook and stir for 2 minutes. Add curry powder; cook and stir for 1 minute. Stir in coconut milk; bring to a boil."
    },
    {
      "position": 5,
      "text": "Scoop flesh from butternut squash; stir into coconut milk mixture. Stir in 2 \u00bd cups vegetable stock; season with remaining \u00bd teaspoon salt, remaining \u00bc teaspoon pumpkin pie spice, and \u00bc teaspoon nutmeg. Bring to a boil, reduce heat to low, and simmer until soup is heated through."
    },
    {
      "position": 6,
      "text": "Blend soup using an immersion blender on low speed. Simmer until soup is smooth and thickened, about 20 minutes more. Add more vegetable stock for a thinner consistency; season with salt."
    },
    {
      "position": 7,
      "text": "Divide soup among bowls; top servings with pumpkin seeds and 1 pinch nutmeg."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

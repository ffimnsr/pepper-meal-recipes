  "id": "fb50eaec-6da6-55ce-b64e-4b99cfa6df8f",
  "slug": "haupia-and-purple-sweet-potato-pie",
  "name": "Haupia and Purple Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "In this Hawaiian pie recipe, a shortbread crust is topped with mashed purple sweet potatoes and a rich coconut cream, also known as haupia.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Mix flour and 1/3 cup white sugar together in a large bowl. Rub in butter with your fingers until mixture is sandy. Press into the greased baking pan."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven until golden brown around the edges, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Beat 1/2 cup butter and 1/2 cup white sugar in a bowl with an electric mixer until creamy. Beat in eggs one at a time. Mix in mashed sweet potatoes, milk, and vanilla extract until batter is the consistency of pancake batter. Pour over the crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until sweet potato layer is firm, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Whisk water, 1/2 cup white sugar, and cornstarch together in a small bowl until smooth."
    },
    {
      "position": 7,
      "text": "Pour coconut milk into a 5-quart saucepan. Bring to a simmer over low heat, about 5 minutes. Pour in water mixture, whisking constantly until coconut milk thickens, 3 to 5 minutes. Stir in shredded coconut; cook and stir until mixture thickens, about 5 minutes more."
    },
    {
      "position": 8,
      "text": "Pour coconut mixture over sweet potato layer. Refrigerate until firm, 4 hours to overnight."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 53,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

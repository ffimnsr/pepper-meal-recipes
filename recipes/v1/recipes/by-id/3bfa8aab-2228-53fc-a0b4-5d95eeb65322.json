  "id": "3bfa8aab-2228-53fc-a0b4-5d95eeb65322",
  "slug": "apple-cider-punch-recipe-8717933",
  "name": "Apple Cider Punch",
  "recipe_type": "drink",
  "brief_description": "This cozy apple cider punch combines cinnamon tea, maple syrup, and lemon juice for a warming fall drink\u2014perfect for holiday gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Steep tea bag and cinnamon stick in the boiling water 5 minutes or according to package directions. Discard tea bag and cinnamon stick. Let cool."
    },
    {
      "position": 2,
      "text": "Combine tea, apple cider, lemon juice, and maple syrup in a pitcher. Serve immediately or refrigerate up to 2 days."
    },
    {
      "position": 3,
      "text": "For garnish, pour maple syrup onto one small plate and Demerara sugar onto another. Dip rims of serving glasses first in maple syrup, then in sugar. Fill glasses with ice and pour punch over. Garnish each with a lemon wedge and cinnamon stick."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

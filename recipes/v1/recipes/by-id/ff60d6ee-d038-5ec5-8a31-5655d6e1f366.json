{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ff60d6ee-d038-5ec5-8a31-5655d6e1f366",
  "slug": "instant-pot-chicken-enchiladas",
  "name": "Instant Pot Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "Cook the chicken in your Instant Pot, then bake the chicken enchilada casserole in the oven! Green and red enchilada sauces are used instead of sour cream.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix chili powder, salt, and cumin together in a bowl. Rub mixture all over chicken."
    },
    {
      "position": 2,
      "text": "Pour chicken broth into a multi-functional pressure cooker (such as Instant Pot). Add a rack to the bottom of the pot and place seasoned chicken on top. Close and lock the lid. Select high pressure according to the manufacturer's instructions; set the timer for 5 minutes. Allow 10 to 15 minutes for the pressure to build."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Release the pressure using the natural-release method according to the manufacturer's instructions for 5 minutes, then release the remaining pressure using the quick-release method, about 5 more minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Meanwhile, stir 2 cups Monterey Jack cheese, 1 can green enchilada sauce, green chiles, onions, and jalape\u00f1os together in a large mixing bowl to thoroughly blend."
    },
    {
      "position": 6,
      "text": "Transfer cooked chicken to a cutting board and shred or chop into small pieces. Add chicken to the mixing bowl and stir until blended with cheese mixture."
    },
    {
      "position": 7,
      "text": "Heat olive oil in a skillet. Soften tortillas, one at a time, by dipping into the hot oil for 2 to 3 seconds per side. Drain on paper towels."
    },
    {
      "position": 8,
      "text": "Spoon 2 to 3 tablespoons chicken mixture onto each tortilla, then roll up and place seam-side down into the prepared baking dish."
    },
    {
      "position": 9,
      "text": "Combine remaining green enchilada sauce with red enchilada sauce in a bowl; pour over enchiladas in the baking dish. Sprinkle remaining 1 cup Monterey Jack cheese over top."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven for 20 to 25 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 35,

  "id": "77b0ea6e-02ab-5a3e-8515-2f510859059e",
  "slug": "lemon-crinkle-cookie-bars-recipe-11934637",
  "name": "Lemon Crinkle Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "These lemon crinkle cookie bars are soft, tender cookie bars with a cheesecake layer between top and bottom layers made with lemon cake mix. The top has a little crunch and a crinkly look.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x9x2-inch baking pan."
    },
    {
      "position": 2,
      "text": "For top and bottom layers, combine cake mix, vegetable oil, and 2 eggs in a large bowl. Stir until fully combined; the mixture may appear crumbly at first, but will come together."
    },
    {
      "position": 3,
      "text": "Divide dough in half. Press half the dough (about 1 cup) evenly into the bottom of the prepared baking pan; set remaining dough aside."
    },
    {
      "position": 4,
      "text": "For cheesecake layer, beat cream cheese and sugar in a small bowl with an electric mixer until smooth. Add 1 egg, vanilla and salt; beat until combined."
    },
    {
      "position": 5,
      "text": "Pour cream cheese mixture over dough in the baking pan, spreading evenly with the back of a spoon to cover the dough."
    },
    {
      "position": 6,
      "text": "Using 2 teaspoons, spoon remaining dough in small portions over cream cheese layer. Sift confectioner\u2019s sugar evenly over the top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the edges are set and lightly browned and an instant-read thermometer registers 195 to 200 degrees F (90 to 93 degrees C) when inserted in the center on, 20 to 25 minutes."
    },
    {
      "position": 8,
      "text": "Cool completely on a wire rack before cutting into bars and serving, about 1 hour. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

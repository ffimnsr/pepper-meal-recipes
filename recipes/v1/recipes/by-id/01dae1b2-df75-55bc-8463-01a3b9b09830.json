  "id": "01dae1b2-df75-55bc-8463-01a3b9b09830",
  "slug": "philadelphia-classic-cheesecake",
  "name": "Philadelphia Classic Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This Philadelphia cheesecake recipe makes a simple, classic cheesecake that's smooth and creamy with no water bath needed. Sure to be a hit!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cookie crumbs, butter, and 3 tablespoons sugar together until combined; press firmly onto the bottom of a 9-inch nonstick springform pan."
    },
    {
      "position": 3,
      "text": "Beat cream cheese, 1 cup sugar, and vanilla in a mixing bowl until smooth."
    },
    {
      "position": 4,
      "text": "Add eggs, one at a time, mixing on low speed until just blended. Pour over crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until center is almost set, about 45 to 55 minutes."
    },
    {
      "position": 6,
      "text": "Loosen cake from the pan rim; cool before removing rim."
    },
    {
      "position": 7,
      "text": "Refrigerate for 4 hours before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 55,

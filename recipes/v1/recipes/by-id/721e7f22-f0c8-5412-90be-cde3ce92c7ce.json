  "id": "721e7f22-f0c8-5412-90be-cde3ce92c7ce",
  "slug": "marshmallow-popcorn-balls",
  "name": "Marshmallow Popcorn Balls",
  "recipe_type": "dessert",
  "brief_description": "These marshmallow popcorn balls are made with freshly popped corn, butter, and mini marshmallows for an easy, nostalgic, kid-favorite sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking dish with cooking spray; set aside."
    },
    {
      "position": 2,
      "text": "Heat oil in a 4-quart saucepan over high heat. Add popcorn kernels to hot oil. Cover the pan and cook until popping ceases, shaking the pot occasionally. Remove from heat and pour popcorn into the prepared dish."
    },
    {
      "position": 3,
      "text": "Melt butter in a medium saucepan over low heat. Cook and stir marshmallows in hot butter until melted."
    },
    {
      "position": 4,
      "text": "Pour marshmallow mixture over popcorn, then use a spoon to mix thoroughly until evenly coated."
    },
    {
      "position": 5,
      "text": "Allow mixture to cool enough to handle. Spray your hands with cooking spray. Shape popcorn with your hands into 8 equal balls."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "5788b3d8-d2b9-57bc-9b40-b7c01e4a8b01",
  "slug": "tandoori-inspired-oven-chicken-skewers",
  "name": "Tandoori-Inspired Oven Chicken Skewers",
  "recipe_type": "appetizer",
  "brief_description": "Inspired by the flavors of India, these chicken thigh skewers take only 15 minutes in the oven, plus a couple of minutes under the broiler.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine yogurt, garam masala, lemon juice, lemon zest, grated ginger, and curry powder in a gallon-sized resealable plastic bag."
    },
    {
      "position": 2,
      "text": "Slice each chicken thigh lengthwise into 3 or 4 slices, add to the bag with the marinade, and refrigerate for 30 to 60 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) and move an oven rack to the center of the oven. Line a sheet pan with aluminum foil."
    },
    {
      "position": 4,
      "text": "Thread chicken thigh pieces onto six 15-inch metal skewers and place crossways across the prepared sheet pan, resting the ends of the skewers on the raised edges of the pan."
    },
    {
      "position": 5,
      "text": "Bake skewers in the preheated oven for 15 minutes. Remove from oven."
    },
    {
      "position": 6,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Broil chicken skewers for 3 minutes until meat is lightly charred, watching closely."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

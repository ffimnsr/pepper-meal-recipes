  "id": "d6479c94-6458-5ba4-b596-cce484845ca1",
  "slug": "swedish-chocolate-balls-chokladbollar",
  "name": "Swedish Chocolate Balls (Chokladbollar)",
  "recipe_type": "appetizer",
  "brief_description": "Swedish for \"chocolate ball,\" chokladbollar are the easiest wholesome snack around; Chef John packs his with oats, cocoa, coffee, and coconut oil for sustained energy.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a pan over medium heat and add oats. Toss and shake until fragrant and lightly toasted, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Combine sugar, cocoa powder, salt, cayenne, butter, coconut oil, vanilla extract, and coffee in a bowl. Add the oats and mix until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Portion dough into balls using a sorbet scoop. Roll balls in grated coconut and transfer to a parchment-lined baking pan. Let them firm up in the fridge for 15 to 20 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

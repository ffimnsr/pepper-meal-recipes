  "id": "00c7b93c-6daa-5c70-8891-993a6b3866e3",
  "slug": "slow-cooker-steak-fajitas",
  "name": "Slow Cooker Steak Fajitas",
  "recipe_type": "main",
  "brief_description": "These crockpot steak fajitas feature tender, slow-cooked strips of flank steak tossed in a deliciously spiced tomato sauce with onions and bell peppers.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Place flank steak pieces into a slow cooker. Stir in tomatoes, onion, bell peppers, jalape\u00f1o pepper, garlic, chili powder, cumin, coriander, and salt."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 10 hours or High for 4 to 6 hours, until steak is fall-apart tender."
    },
    {
      "position": 3,
      "text": "Remove steak from the slow cooker and shred. Return to the slow cooker and stir into the sauce."
    },
    {
      "position": 4,
      "text": "Serve hot with tortillas and shredded cheese, allowing everyone to make their own fajita."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 25,

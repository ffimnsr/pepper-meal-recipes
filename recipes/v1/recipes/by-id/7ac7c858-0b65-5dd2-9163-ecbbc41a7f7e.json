  "id": "7ac7c858-0b65-5dd2-9163-ecbbc41a7f7e",
  "slug": "double-ranch-fries",
  "name": "Double Ranch Fries",
  "recipe_type": "snack",
  "brief_description": "These ranch fries are soaked in milk, seasoned, then deep-fried until crisp and golden for a tasty side dish or savory snack your family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak prepared potatoes in a bowl with milk."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a deep fryer to 365 degrees F (185 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine ranch-style dressing mix and garlic salt on a plate or in a bag."
    },
    {
      "position": 4,
      "text": "Drain potatoes and roll in seasonings to coat; reserve any excess seasonings."
    },
    {
      "position": 5,
      "text": "Cook potatoes in hot oil in batches so they are not too crowded. Fry until golden brown, about 5 minutes. Drain on paper towels and sprinkle with leftover seasonings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

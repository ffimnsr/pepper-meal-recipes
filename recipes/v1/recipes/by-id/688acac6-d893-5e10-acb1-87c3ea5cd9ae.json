  "slug": "ham-ball",
  "name": "Ham Ball",
  "recipe_type": "appetizer",
  "brief_description": "This ham ball features softened cream cheese, chopped ham, and green onion rolled in chopped pecans for a great dip to serve with crackers or bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together cream cheese, ham, green onions, and seasoned salt in a large bowl until evenly mixed; roll into a ball."
    },
    {
      "position": 2,
      "text": "Spread pecans onto a flat surface. Roll ham ball in pecans to coat."
    }
  ],

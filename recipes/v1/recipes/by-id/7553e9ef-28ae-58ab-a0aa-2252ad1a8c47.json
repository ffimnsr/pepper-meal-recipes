  "slug": "peanut-butter-energy-balls",
  "name": "Peanut Butter Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "This peanut butter energy balls recipe includes wheat germ and powdered milk. You can add chocolate chips, raisins, or coconut and roll in coconut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine wheat germ, peanut butter, honey, and milk powder in a bowl; shape into 20 bite-sized balls. Arrange balls on a plate."
    },
    {
      "position": 2,
      "text": "Place in the freezer until solid, at least 1 hour."
    }
  ],

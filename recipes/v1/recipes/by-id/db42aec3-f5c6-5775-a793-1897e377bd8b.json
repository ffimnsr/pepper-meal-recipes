  "schema_version": 1,
  "id": "db42aec3-f5c6-5775-a793-1897e377bd8b",
  "slug": "karaage-japanese-fried-chicken-with-honey-mayoster-sauce",
  "name": "Karaage (Japanese Fried Chicken) with Honey Mayoster Sauce",
  "recipe_type": "main",
  "brief_description": "This karaage (Japanese fried chicken) with honey mayoster sauce recipe marinates chicken, coats in panko, and serves with a soy-mirin-Dijon-mayo sauce.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1 1/2 tablespoons soy sauce, 1 tablespoon honey, garlic, and ginger together in a large glass or ceramic bowl. Add chicken and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 3,
      "text": "Beat egg in a bowl until smooth. Add panko bread crumbs to a shallow bowl. Dip chicken into beaten egg. Lift up so excess egg drips back in the bowl. Press into panko until completely coated. Place the breaded chicken, unstacked, onto a plate. Repeat with remaining chicken."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C). Lower chicken carefully into the hot oil in batches. Fry until golden brown, about 5 minutes. Transfer to paper towels to drain. Repeat with remaining chicken."
    },
    {
      "position": 5,
      "text": "Whisk Japanese mayonnaise, mirin, 2 tablespoons honey, Dijon mustard, and 1 tablespoon soy sauce together in a bowl; pour sauce over chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

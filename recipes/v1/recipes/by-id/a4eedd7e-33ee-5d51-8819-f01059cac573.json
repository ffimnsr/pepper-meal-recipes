  "id": "a4eedd7e-33ee-5d51-8819-f01059cac573",
  "slug": "tomato-bredie",
  "name": "Tomato Bredie",
  "recipe_type": "main",
  "brief_description": "This tomato bredie is a South African lamb and vegetable stew with bay leaf, brown sugar, vinegar, and pepper that simmers for hours until flavorful.",
  "cuisine": "South African African",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, heavy-bottomed saucepan over medium-high heat."
    },
    {
      "position": 2,
      "text": "Dredge lamb in flour; shake off excess."
    },
    {
      "position": 3,
      "text": "Cook lamb in hot oil until browned all over. Transfer lamb to a plate, reserving drippings in the pan."
    },
    {
      "position": 4,
      "text": "Cook and stir onion in drippings until soft, about 5 minutes. Mix in tomatoes. Return lamb chops to the saucepan; season with bay leaves, bouillon, salt, brown sugar, white peppercorns, black pepper, and Worcestershire sauce. Cover, reduce heat, and simmer for 1 hour and 15 minutes. Stir occasionally, making sure nothing sticks to the bottom of the pan."
    },
    {
      "position": 5,
      "text": "Stir in potatoes; continue cooking until potatoes are cooked and meat is tender, about 45 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

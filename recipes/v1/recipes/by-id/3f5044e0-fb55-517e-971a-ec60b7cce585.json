{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3f5044e0-fb55-517e-971a-ec60b7cce585",
  "slug": "langostino-sheet-pan-lasagna-recipe-11830629",
  "name": "Langostino Sheet Pan Lasagna",
  "recipe_type": "soup",
  "brief_description": "This langostino sheet pan lasagna, layering tender noodles with a langostino and cherry tomato lobster bisque sauce, ricotta filling, bacon, and mozzarella, is a nod to the viral Trader Joe's langostino pasta. Bake until golden and bubbly, and garnish with fresh basil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a skillet over medium-high heat until slightly crisp. Remove bacon to a plate with a slotted spoon; leave about 2 tablespoons bacon grease in the pan."
    },
    {
      "position": 3,
      "text": "Add shallot to the skillet, cook until soft, about 3 minutes. Season with salt and pepper. Add cherry tomatoes and cook until they start to burst, about 2 minutes. Stir in garlic; cook until fragrant, about 45 seconds."
    },
    {
      "position": 4,
      "text": "Stir in lobster bisque, stock, and whipping cream. Simmer for 5 minutes. Stir in langostino tails, half the bacon, and half the Parmesan. Remove from heat."
    },
    {
      "position": 5,
      "text": "Mix ricotta with about 1 tablespoon Parmesan; season with salt and black pepper."
    },
    {
      "position": 6,
      "text": "Spread a thin layer of lobster-tomato sauce onto the bottom of a 10X13-inch sheet pan. Add a layer of uncooked noodles. Spread half the ricotta mixture in an even layer over noodles. Sprinkle half of bacon and mozzarella cheese over ricotta."
    },
    {
      "position": 7,
      "text": "Repeat layer once with remaining ingredients: lobster tomato sauce, noodles, ricotta, bacon; finish with mozzarella and remaining Parmesan cheese. You may have extra noodles. Cover tightly with foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil and bake until cheese is bubbly and golden, 10 to 15 minutes more."
    },
    {
      "position": 9,
      "text": "Rest for 10 minutes before slicing. Garnish with fresh basil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 10,
  "difficulty": "medium",

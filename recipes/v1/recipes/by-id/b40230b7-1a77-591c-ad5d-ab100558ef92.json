  "id": "b40230b7-1a77-591c-ad5d-ab100558ef92",
  "slug": "fabulous-wet-burritos",
  "name": "Fabulous Wet Burritos",
  "recipe_type": "main",
  "brief_description": "A wet burrito recipe made with flour tortillas filled with ground beef, refried beans, and chiles \u2014 topped with a generous amount of sauce and cheese.",
  "cuisine": "Southwestern American",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef into a skillet over medium-high heat. Cook and stir until evenly browned. Add onion and cook until translucent. Drain grease, and season with garlic, cumin, salt, and pepper. Stir in refried beans and green chilies until well blended. Turn off heat but keep warm."
    },
    {
      "position": 2,
      "text": "Combine canned chili, condensed soup, and enchilada sauce in a saucepan. Mix well and cook over medium heat until heated through. Turn off the heat and keep warm."
    },
    {
      "position": 3,
      "text": "Place warmed tortilla on a plate and spoon a generous 1/2 cup of the ground beef mixture onto the center. Top with a portion of lettuce and tomato to your liking. Roll up tortilla around the filling, while tucking in the sides. Spoon a generous amount of the sauce over the top and sprinkle with a portion of cheese and green onions. Heat in the microwave until cheese is melted, about 30 seconds. Repeat with remaining tortillas and fillings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

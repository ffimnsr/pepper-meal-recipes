  "id": "310f7677-a680-5e52-8864-778b9975fca3",
  "slug": "iced-peach-tea-lemonade-recipe-7495346",
  "name": "Iced Peach Tea Lemonade",
  "recipe_type": "appetizer",
  "brief_description": "This peach-infused iced tea lemonade is a riff on the familiar Arnold Palmer, which is a blend of tea and lemonade.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together 1 1/2 cups water, sugar, and sliced peaches in a large pot. Bring to a simmer, and simmer until sugar is dissolved, the mixture is syrupy, and syrup is infused with peach flavor, about 10 minutes. Set syrup aside to cool, then strain off peaches; reserve peaches for another use."
    },
    {
      "position": 2,
      "text": "Meanwhile, in another pot bring remaining 4 cups water to a boil. Turn heat off. Add tea bags; steep 4 to 6 minutes. Remove tea bags and discard."
    },
    {
      "position": 3,
      "text": "Add lemon juice to syrup. To each glass add ice and 6 ounces brewed tea. Sweeten each glass to taste with 1 to 2 ounces lemon-peach syrup."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

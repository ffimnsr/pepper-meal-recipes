  "id": "46fe78e8-3725-5650-aece-2423cb61ea34",
  "slug": "overnight-chia-oats",
  "name": "Overnight Chia Oats",
  "recipe_type": "breakfast",
  "brief_description": "This 4-ingredient overnight chia oat recipe features almond milk, rolled oats, banaan, and chia seeds for a healthy and hearty. grab-and-go breakfast.",
  "cuisine": "Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine almond milk, oats, mashed banana, and chia seeds in a 1-pint jar. Top with a lid: shake until well combined."
    },
    {
      "position": 2,
      "text": "Refrigerate until chia seeds have swelled and oats mixture is thick and gel-like, 8 hours to overnight."
    }
  ],

  "id": "c0fc82ab-cc02-58ac-bd08-0c4695631518",
  "slug": "everything-deviled-eggs",
  "name": "Everything Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These deviled eggs have a creamy filling flavored with Greek yogurt and mustard, plus a savory sprinkling of everything bagel seasoning on top.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel."
    },
    {
      "position": 2,
      "text": "Slice eggs in half lengthwise and set the whites aside. Place yolks in a mini blender or food processor; pulse several times until finely chopped. Add yogurt, mustard, vinegar, Worcestershire sauce, and sugar and blend until smooth."
    },
    {
      "position": 3,
      "text": "Transfer yolk mixture to pastry bag fitted with a large star tip and pipe filling into the egg whites (or stuff filling into egg whites with a spoon). Sprinkle with everything bagel seasoning and garnish with sliced scallions. Chill in the refrigerator until ready serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "085fcfa5-01f8-5115-8009-4b493b7550fd",
  "slug": "best-chicken-parmesan",
  "name": "Best Chicken Parmesan",
  "recipe_type": "main",
  "brief_description": "Try this chicken Parm recipe for juicy, tender chicken with a crispy Parmesan crust, a zesty homemade marinara sauce, and a golden layer of melted cheese.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Make the sauce: Heat oil in a large skillet over medium heat. Add onion and garlic; cook and stir until fragrant, about 2 minutes. Add crushed tomatoes, chicken broth, wine, garlic powder, onion powder, oregano, Italian seasoning, red pepper flakes, and sugar; season with salt and pepper. Stir to combine, reduce the heat to low, and simmer, stirring occasionally, until sauce thickens, about 15 minutes. Keep warm until needed."
    },
    {
      "position": 2,
      "text": "While the sauce is cooking, bring a large pot of lightly salted water to a boil. Add rigatoni and cook, stirring occasionally, until tender yet firm to the bite, about 13 minutes. Drain and keep warm."
    },
    {
      "position": 3,
      "text": "At the same time, start the chicken: Preheat the oven to 450 degrees F (230 degrees C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Set out three large mixing bowls for breading chicken. Combine flour, 1/2 teaspoon garlic powder, 1/4 teaspoon salt, and pepper in the first bowl. Whisk together eggs and milk in the second bowl. Combine bread crumbs, Parmesan cheese, oregano, Italian seasoning, 1/2 teaspoon garlic powder, and 1/4 teaspoon salt in the third bowl."
    },
    {
      "position": 5,
      "text": "Place chicken breasts in a resealable plastic bag and flatten with a meat mallet to a thickness of 1/4 inch. Dredge a chicken breast in flour mixture and shake off excess. Dip into egg mixture, then coat with bread crumb mixture. Place onto a plate. Repeat to bread remaining chicken."
    },
    {
      "position": 6,
      "text": "Fill a large, cast iron skillet with 1 inch oil; heat over medium-high heat until oil is hot but not smoking. Add breaded chicken in batches; cook until golden brown, 1 to 2 minutes per side. Transfer chicken to the prepared baking sheet. Sprinkle mozzarella and Parmesan over chicken."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until chicken reaches an internal temperature of 165 degrees F (74 degrees C) and the cheeses have melted, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Plate pasta portions. Stir basil into sauce and ladle over pasta. Top each portion with chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

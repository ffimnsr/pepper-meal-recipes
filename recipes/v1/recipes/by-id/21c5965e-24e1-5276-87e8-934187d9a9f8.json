  "id": "21c5965e-24e1-5276-87e8-934187d9a9f8",
  "slug": "bacon-and-potato-soup",
  "name": "Bacon and Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This potato soup features saut\u00e9ed onion, carrot, and celery cooked in chicken broth and mixed with cheese and crumbled bacon for a hearty winter dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a 3-quart saucepan over medium-high heat, turning occasionally, until evenly browned and crisp, about 10 minutes. Drain on a paper towel-lined plate. Discard bacon grease and wipe the pan thoroughly with a paper towel."
    },
    {
      "position": 2,
      "text": "Heat olive oil in the same saucepan over medium heat. Saut\u00e9 onion, carrots, and celery in hot oil until onion is soft but not brown, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Stir in broth, potatoes, and cayenne pepper; bring to a boil, reduce heat, and simmer, covered, until potatoes are tender, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir in cheese, heating just until melted; do not boil. Chop bacon and add to soup. Season with salt and serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

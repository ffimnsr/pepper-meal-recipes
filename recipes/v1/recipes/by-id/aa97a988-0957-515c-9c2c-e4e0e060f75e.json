  "id": "aa97a988-0957-515c-9c2c-e4e0e060f75e",
  "slug": "shrimp-quiche",
  "name": "Shrimp Quiche",
  "recipe_type": "breakfast",
  "brief_description": "An easy, oh-so-good quiche that will dazzle your brunch crowd. Cooked shrimp combine with rich, nutty-flavored Gruyere cheese, sour cream, green onions, and eggs in a prebaked pie crust.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread shrimp evenly across the bottom of the pie crust. Sprinkle cheese over the shrimp."
    },
    {
      "position": 3,
      "text": "Stir sour cream, green onions, salt and pepper into the beaten eggs; then pour mixture evenly over the shrimp and cheese."
    },
    {
      "position": 4,
      "text": "Bake in a preheated oven for 25 to 30 minutes. Serve warm or cold."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

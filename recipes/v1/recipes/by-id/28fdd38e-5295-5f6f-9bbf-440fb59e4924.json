  "id": "28fdd38e-5295-5f6f-9bbf-440fb59e4924",
  "slug": "tasty-spicy-rice-pilaf",
  "name": "Tasty Spicy Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "This spicy rice pilaf side dish is delicious and easy to prepare with roasted red pepper, onion, garlic, mushrooms, and instant white rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onion, red pepper, mushrooms, and garlic; cook and stir until tender, about 10 minutes. Stir in rice, then add chicken stock. Cover and boil until liquid is absorbed, about 10 minutes. Season with red pepper flakes, salt, and pepper."
    }
  ],

  "slug": "healthy-chicken-salad",
  "name": "Healthy Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This healthy chicken salad recipe made with Greek yogurt and cottage cheese instead of mayonnaise is creamy and delicious and packed with protein.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir Greek yogurt, cottage cheese, celery, apple, cranberries, onion, pecans, and Dijon mustard in a bowl until well combined."
    },
    {
      "position": 3,
      "text": "Mix in chicken. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Enjoy or refrigerate until ready to serve."
    }
  ],
  "servings": 4,

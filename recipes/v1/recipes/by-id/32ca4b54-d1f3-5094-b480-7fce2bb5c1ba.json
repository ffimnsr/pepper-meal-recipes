  "id": "32ca4b54-d1f3-5094-b480-7fce2bb5c1ba",
  "slug": "baked-cranberry-oatmeal",
  "name": "Baked Cranberry Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Baked oatmeal with apples, walnuts, and dried cranberries is a nice way to spice up plain oatmeal made on the stovetop.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring milk, brown sugar, cinnamon, nutmeg, and cloves to a boil in a saucepan; remove from heat. Combine oats, apples, dried cranberries, and walnuts in a bowl; transfer to the prepared baking dish. Pour milk mixture over oat mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, 30 to 35 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d18cf324-730e-5d9b-b26a-e089a11eec0c",
  "slug": "jills-summer-sangria",
  "name": "Jill's Summer Sangria",
  "recipe_type": "drink",
  "brief_description": "Jill's summer sangria recipe, featuring red wine, rum, orange juice, and fresh fruit makes a wonderful drink for the summer or for a holiday party.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine red wine, 2 cups rum, 2 cups orange juice, and sugar in a large pitcher; refrigerate 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine pineapple chunks and juice, strawberries, and cherries in a large bowl; cover with remaining 2 cups rum, and remaining 2 cups orange juice. Refrigerate 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Drain fruit; reserve liquid for another use, if desired. Stir fruit into pitcher with sangria mixture and serve."
    }
  ],

  "id": "ebad79f0-aa29-59fa-bfe3-1cfdf8a99d85",
  "slug": "new-england-clam-chowder-i",
  "name": "New England Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "This New England clam chowder with onions, potatoes, clams, and bacon in a rich and creamy broth is easy to prep for a deliciously comforting soup.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place diced bacon in a large stockpot over medium-high heat; cook and stir until almost crisp. Add onion; cook and stir until tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in potatoes and add water; season with salt and pepper and bring to a boil. Reduce heat to low and simmer, uncovered, until potatoes are tender, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Pour in half-and-half and add butter."
    },
    {
      "position": 5,
      "text": "Drain clams, reserving clam liquid; stir clams and 1/2 of the clam liquid into the soup. Cook until heated through, without boiling, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

  "id": "b7ad5a38-a665-5aaa-88db-80dcdd828aea",
  "slug": "copycat-chick-fil-a-mac-and-cheese-recipe-8572260",
  "name": "Copycat Chick-fil-A Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "This Copycat Chick-fil-A Mac and Cheese is made with 5 types of cheese, selected for their melting properties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in pasta and return to a boil. Cook, uncovered, stirring occasionally, until tender yet firm to the bite, 6 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 9x9-inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a heavy saucepan over medium-low heat. Whisk in flour until mixture is a smooth paste and no lumps remain. Slowly pour in evaporated milk, whisking continuously. Whisk in Worcestershire, Dijon mustard, and salt, and cook until slightly thickened, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add in 1/4 cup of Italian Cheddar, 1/4 cup Gruy\u00e8re, 1/4 cup Fontina, and 1/4 cup sharp Cheddar. Remove rind from Brie and add to sauce; stir until all the cheese has melted, about 1 minute."
    },
    {
      "position": 5,
      "text": "Drain pasta and add to the cheese sauce. Pour half of the macaroni and cheese into the prepared baking dish."
    },
    {
      "position": 6,
      "text": "Toss remaining 2 tablespoons each of Italian Cheddar, Gruy\u00e8re, Fontina, and sharp Cheddar together in a small bowl; sprinkle half of cheese mixture over pasta. Pour remaining pasta into the dish; sprinkle remaining cheese mixture over the top."
    },
    {
      "position": 7,
      "text": "Bake, uncovered, in the preheated oven until cheese is golden, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

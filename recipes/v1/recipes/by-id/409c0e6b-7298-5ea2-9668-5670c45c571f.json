  "schema_version": 1,
  "id": "409c0e6b-7298-5ea2-9668-5670c45c571f",
  "slug": "air-fryer-bang-bang-chicken",
  "name": "Air Fryer Bang-Bang Chicken",
  "recipe_type": "dessert",
  "brief_description": "This air fryer bang-bang chicken features crispy, Panko-breaded tenders tossed in a sweet and spicy sauce made with mayo, sweet chili, and Sriracha.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mayonnaise, sweet chili sauce, and Sriracha in a large bowl until sauce is well combined. Reserve 3/4 cup sauce and set aside."
    },
    {
      "position": 2,
      "text": "Place flour into a large resealable plastic bag. Add chicken; seal the bag and shake to coat. Transfer coated chicken pieces to sauce in the large bowl and stir to combine."
    },
    {
      "position": 3,
      "text": "Place panko bread crumbs in another large resealable plastic bag. Working in batches, drop chicken pieces into bread crumbs, seal, and shake to coat."
    },
    {
      "position": 4,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 5,
      "text": "Place as many chicken pieces into the air fryer basket without overcrowding."
    },
    {
      "position": 6,
      "text": "Cook in the preheated air fryer for 10 minutes. Flip chicken and cook for 5 more minutes. Repeat with remaining chicken."
    },
    {
      "position": 7,
      "text": "Transfer fried chicken to another large bowl and pour reserved sauce over the top. Sprinkle with green onions and toss to coat. Serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

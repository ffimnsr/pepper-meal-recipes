  "id": "174811a4-e661-5b79-b975-114e56ebe6b3",
  "slug": "turkish-red-lentil-soup-with-mint",
  "name": "Turkish Red Lentil Soup with Mint",
  "recipe_type": "soup",
  "brief_description": "This hearty red lentil soup recipe is made with red lentils and nutty bulgur in a tomato-based broth with garlic, dried mint, and paprika.",
  "cuisine": "Turkish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium heat. Add onion and saut\u00e9 until beginning to soften, about 2 minutes. Stir in garlic and cook for 2 minutes. Add diced tomatoes and cook for 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in chicken stock, lentils, bulgur, rice, tomato paste, mint, paprika, cayenne pepper, salt, and black pepper; bring to a boil. Reduce heat to medium-low and simmer until lentils and rice are tender, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Puree soup with an immersion blender until smooth."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

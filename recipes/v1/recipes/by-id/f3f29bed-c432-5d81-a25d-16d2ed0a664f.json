  "id": "f3f29bed-c432-5d81-a25d-16d2ed0a664f",
  "slug": "tater-tot-breakfast-casserole",
  "name": "Cheesy Tater Tot Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This cheesy Tater Tot breakfast casserole has layers of savory sausage and potato baked in a fluffy egg mixture with cheese until golden and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage and onion in the hot skillet until sausage is browned and crumbly, 5 to 7 minutes. Drain and cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk milk, eggs, onion powder, salt, garlic powder, and pepper together in a bowl."
    },
    {
      "position": 4,
      "text": "Spread sausage mixture over the bottom of the prepared baking dish. Pour egg mixture over the top."
    },
    {
      "position": 5,
      "text": "Layer with 1/2 of the Cheddar cheese and all of the potato nuggets. Cover with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 40 minutes. Remove foil and sprinkle with the remaining cheese. Bake until melted, about 20 minutes more. Remove from the oven and let stand briefly before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,

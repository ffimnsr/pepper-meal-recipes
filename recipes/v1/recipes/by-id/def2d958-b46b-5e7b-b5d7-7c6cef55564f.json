  "id": "def2d958-b46b-5e7b-b5d7-7c6cef55564f",
  "slug": "walnut-rugelach",
  "name": "Walnut Rugelach",
  "recipe_type": "dessert",
  "brief_description": "These beautiful, delicious rugelach cookies with walnut filling are a great addition to holiday feasts.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Sift flour, baking powder, and salt together onto a sheet of waxed paper."
    },
    {
      "position": 2,
      "text": "Beat 1/4 cup white sugar, butter, and cream cheese together in a bowl with an electric mixer until creamy. Beat in egg yolk and vanilla."
    },
    {
      "position": 3,
      "text": "Stir flour mixture into butter mixture until dough is just combined. Divide dough into 3 equal portions; shape each portion into a disk, wrap disks in plastic wrap, and refrigerate for at least 4 hours or overnight."
    },
    {
      "position": 4,
      "text": "Beat egg white in a bowl with an electric mixture until frothy. Mix walnuts and 1/2 cup white sugar into egg white."
    },
    {
      "position": 5,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove dough from plastic wrap and roll each disk out into a 7-inch circle. Spread 1/3 the egg white mixture onto each dough circle, leaving a 1/4-inch border around the edge of each circle. Cut each circle into 12 wedges. Roll up each wedge from the edge to the point and place, point-side down, on a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until lightly browned, 12 to 14 minutes. Transfer to wire racks to cool and dust with confectioners' sugar."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

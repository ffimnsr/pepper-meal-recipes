  "id": "c1e90149-b154-5006-b693-8427046665f0",
  "slug": "easy-upside-down-russian-biskvit-with-apples",
  "name": "Easy Upside Down Russian Biskvit With Apples",
  "recipe_type": "dessert",
  "brief_description": "This Russian apple upside-down cake is made with simple pantry basics and baking apples. You can whip one up anytime, and serve it warm or cooled.",
  "cuisine": "Russian",
  "instructions": [
    {
      "position": 1,
      "text": "Place egg whites into a mixing bowl with sugar, and beat with an electric mixer until the mixture forms soft peaks. Beat in egg yolks and vanilla."
    },
    {
      "position": 2,
      "text": "Whisk together the flour with baking powder in a separate bowl, and mix the flour mixture into the beaten egg mixture until just combined."
    },
    {
      "position": 3,
      "text": "Place butter and apples into the bottom of a 9x13-inch baking pan, and place into oven. Preheat oven to 350 degrees F (175 degrees C) to melt the butter. When oven is hot and butter has melted, stir the apples and butter together, and spread out in the pan. Pour the cake batter on top of the butter and apples."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until the top is golden brown, about 20 minutes. Loosen the edges of the cake with a spatula, and flip the cake over onto a serving platter to serve. Allow to cool for a few minutes before eating, or serve cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

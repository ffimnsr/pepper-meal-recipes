  "id": "c720259b-fd3b-56a3-8809-85faace4fc90",
  "slug": "pumpkin-pie-from-almond-breeze",
  "name": "Pumpkin Pie from Almond Breeze\u00ae",
  "recipe_type": "dessert",
  "brief_description": "This traditional pumpkin pie with cinnamon, ginger, and cloves uses vanilla almondmilk for extra creaminess and flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine eggs, egg yolk, sugar, cinnamon, salt, nutmeg, ginger and ground cloves."
    },
    {
      "position": 3,
      "text": "Gradually stir in Original or Vanilla Almond Breeze, then stir in pumpkin puree."
    },
    {
      "position": 4,
      "text": "Pour filling into premade pie shell."
    },
    {
      "position": 5,
      "text": "Bake for 50 to 55 minutes or until filling is set."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

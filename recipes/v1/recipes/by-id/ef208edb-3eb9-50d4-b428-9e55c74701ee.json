  "id": "ef208edb-3eb9-50d4-b428-9e55c74701ee",
  "slug": "cream-cheese-steak-stroganoff",
  "name": "Cream Cheese Steak Stroganoff",
  "recipe_type": "main",
  "brief_description": "Transform leftover steak into a hearty steak stroganoff using a cream cheese-based mushroom sauce served over farfalle pasta as a comforting weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in farfalle and return to a boil. Cook farfalle uncovered, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and transfer to a serving bowl."
    },
    {
      "position": 2,
      "text": "Heat olive oil and butter together in a large skillet over medium heat. Add mushrooms, onions, and garlic; cook and stir until mushrooms are tender, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Combine cream cheese, wine, tomato paste, lemon juice, cornstarch, bouillon cube, parsley, seasoned salt, and paprika together in a bowl; add steak. Add cream cheese mixture to mushroom mixture in skillet; cook and gently stir over low heat just until sauce is warmed and smooth, 5 to 10 minutes. Add enough milk to reach desired consistency."
    },
    {
      "position": 4,
      "text": "Pour sauce over farfalle and toss to coat. Season with black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

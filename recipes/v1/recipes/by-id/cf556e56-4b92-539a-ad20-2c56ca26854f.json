  "id": "cf556e56-4b92-539a-ad20-2c56ca26854f",
  "slug": "refreshing-peach-sangria",
  "name": "Refreshing Peach Sangria",
  "recipe_type": "drink",
  "brief_description": "This recipe is a tweak on typical sangria with peach schnapps, white wine, pineapple juice, frozen peaches, and grapes for a refreshing peach sangria.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Add wine, lemon-lime soda, peach schnapps, and pineapple juice to a cocktail shaker; add ice. Stir until sangria is chilled."
    },
    {
      "position": 2,
      "text": "Place frozen peach, red grapes, and green grapes in a martini glass; strain sangria into glass."
    }
  ],

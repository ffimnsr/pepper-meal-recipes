  "id": "ce7086d0-eac1-514f-bf03-8141ddd33a68",
  "slug": "chef-johns-chicken-tinga",
  "name": "Chef John's Chicken Tinga",
  "recipe_type": "main",
  "brief_description": "Chef John's chicken tinga is full of Mexican flavors and tastes just like you'd get at a taqueria; perfect on a crispy tortilla with your favorite toppings.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken thighs, chicken stock, water, halved onion, garlic cloves, salt, and oregano in a large pot. Bring to a simmer over high heat; reduce to medium-low and cook, stirring occasionally, for 30 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Transfer onion halves to a bowl with a slotted spoon; transfer chicken thighs to a separate bowl."
    },
    {
      "position": 3,
      "text": "Pour broth through a strainer into a large bowl."
    },
    {
      "position": 4,
      "text": "Heat olive oil in the same pot over medium heat. Add diced onions and cook until beginning to soften, about 4 minutes. Transfer strained liquid to onions. Bring mixture to a boil over high heat; turn heat to medium-low; reduce broth by about half, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Transfer reserved boiled onions to a blender. Add chipotle peppers in adobo sauce. Swirl a bit of water in the can and add to the blender. Add tomatoes. Cover blender with the lid; pulse on and off until mixture is partially blended, then blend on medium speed until smooth, 1 or 2 minutes. Transfer to pot with broth and onions."
    },
    {
      "position": 6,
      "text": "Increase heat to medium-high. Simmer 15 minutes or so, depending on how thick you want the sauce. Reduce heat to medium-low."
    },
    {
      "position": 7,
      "text": "Tear chicken into bite-size pieces and add to the pot. Cook another 10 to 15 minutes. Transfer to a serving dish; garnish with cilantro and crumbled cotija cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,

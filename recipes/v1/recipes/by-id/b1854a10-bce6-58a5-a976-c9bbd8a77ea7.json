  "id": "b1854a10-bce6-58a5-a976-c9bbd8a77ea7",
  "slug": "no-bake-chocolate-cheesecake-recipe-7485249",
  "name": "Best No-Bake Chocolate Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This no-bake chocolate cheesecake is a breeze to make for a decadent cheesecake dessert with a homemade rich and creamy mousse-like chocolaty filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather your ingredients."
    },
    {
      "position": 2,
      "text": "Mix graham cracker crumbs with melted butter and 1 tablespoon of sugar; press crumb mixture into bottom and 1/2-inch up the sides of an 8-inch springform pan. Refrigerate crust while you make the filling."
    },
    {
      "position": 3,
      "text": "Melt chocolate in a microwave-safe glass or ceramic bowl in the microwave on high power for 1 to 2 minutes, or until melted, stirring every 15 seconds; set aside to cool."
    },
    {
      "position": 4,
      "text": "Whisk cocoa powder and enough warm water together in a medium bowl to form a smooth paste."
    },
    {
      "position": 5,
      "text": "Beat cream cheese and remaining sugar into cocoa mixture until combined; set aside."
    },
    {
      "position": 6,
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form. Fold in cooled melted chocolate."
    },
    {
      "position": 7,
      "text": "Fold chocolate cream mixture into cream cheese mixture until thoroughly combined; spread on top of graham cracker crust."
    },
    {
      "position": 8,
      "text": "Freeze cheesecake for 1 hour. Thaw in the refrigerator for 30 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

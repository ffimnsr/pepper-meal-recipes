  "id": "ef93a848-8360-5e40-b856-f9d93a2d2ca7",
  "slug": "buffalo-and-ranch-pumpkin-seeds",
  "name": "Buffalo and Ranch Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "In this quick and easy recipe that's perfect as a crunchy, salty snack, buffalo wing sauce and ranch flavoring coat toasted pumpkin seeds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line baking sheet with wax paper."
    },
    {
      "position": 2,
      "text": "Combine buffalo sauce, ranch seasoning, lemon pepper, and salt in a small bowl. Toss pumpkin seeds in mixture until evenly coated. Spread on the prepared sheet in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring every 15 minutes, until seeds are golden brown and crunchy, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

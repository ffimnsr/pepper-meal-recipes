  "id": "23a38e4f-35de-54fd-86e4-f47b2fa03edc",
  "slug": "no-bake-pecan-pie-dip-recipe-8385619",
  "name": "No Bake Pecan Pie Dip",
  "recipe_type": "appetizer",
  "brief_description": "This no-bake pecan pie dip is creamy, crunchy, and sure to be a hit at your holiday gathering. Serve with apple slices, pretzel crisps, or crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, whipped topping, and powdered sugar in a mixing bowl; beat with an electric mixer until smooth."
    },
    {
      "position": 3,
      "text": "Spread mixture along the bottom of a 9-inch pie plate and refrigerate while you prepare the topping."
    },
    {
      "position": 4,
      "text": "To make the topping: Combine brown sugar, cold butter, corn syrup, pecans, vanilla extract, egg, and salt in a saucepan. Bring mixture to a gentle boil over medium-high heat, stirring constantly. Cook for 1 minute, stirring constantly, and remove from heat."
    },
    {
      "position": 5,
      "text": "Allow topping to cool for 10 minutes before stirring and pouring evenly over the cream cheese layer. Serve immediately or refrigerate until ready to serve."
    },
    {
      "position": 6,
      "text": "Serve with apple slices, pretzel crisps or graham crackers."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

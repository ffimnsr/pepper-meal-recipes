  "id": "f4643161-690e-51e9-8bf8-3fadfd4fafe2",
  "slug": "the-best-lemon-bars",
  "name": "The Best Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "These lemon bars are easy to make with fresh lemons and simple ingredients you probably already have for a deliciously rich and tart treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "To make the crust: Blend 2 cups flour, softened butter, and 1/2 cup sugar in a medium bowl until well combined."
    },
    {
      "position": 4,
      "text": "Press crust into the bottom of an ungreased 9x13-inch pan."
    },
    {
      "position": 5,
      "text": "Bake crust in the preheated oven until firm and golden, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, make the filling: Whisk remaining 1 1/2 cups sugar and 1/4 cup flour in a medium bowl. Whisk in eggs, then lemon juice until smooth."
    },
    {
      "position": 7,
      "text": "Pour filling over the baked crust."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven for 20 minutes. Set the pan aside to cool completely; the bars will firm up as they cool."
    },
    {
      "position": 9,
      "text": "When cooled, cut bars into uniform squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

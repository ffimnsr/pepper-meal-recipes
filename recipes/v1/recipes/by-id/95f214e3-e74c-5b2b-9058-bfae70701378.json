  "id": "95f214e3-e74c-5b2b-9058-bfae70701378",
  "slug": "tamagoyaki-japanese-rolled-omelette",
  "name": "Tamagoyaki (Japanese Rolled Omelette)",
  "recipe_type": "appetizer",
  "brief_description": "This Japanese rolled omelette recipe, called tamagoyaki, is seasoned with soy sauce, mirin, and dashi. Enjoy it as part of a meal or as an appetizer.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs, dashi stock, sugar, mirin, and soy sauce together in a bowl."
    },
    {
      "position": 2,
      "text": "Heat \u2153 oil in a large nonstick skillet over medium-high heat. Add about \u2153 egg mixture; quickly swirl the pan to evenly cover the bottom. Start rolling up omelette from one side to the other as soon as it is set."
    },
    {
      "position": 3,
      "text": "Keep roll to one side; add \u2153 more oil to the skillet and \u2153 more egg. Swirl the pan, ensuring entire bottom is covered, including around and underneath first roll; cook until set. Roll up omelette starting from side with first roll, and including first roll, so you end up with one roll."
    },
    {
      "position": 4,
      "text": "Repeat process with remaining \u2153 each oil and egg and so you end up with one roll; transfer to a bamboo rolling mat. Roll up omelette tightly; cool about 3 minutes."
    },
    {
      "position": 5,
      "text": "Unwrap omelette; slice into 6 pieces. Serve warm or cold."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "41cf46ea-7dd2-59c2-8067-2c0da7c58df2",
  "slug": "apple-dapple-cake",
  "name": "Apple Dapple Cake",
  "recipe_type": "dessert",
  "brief_description": "This apple dapple cake recipe is moist from apples, chewy from coconut, and crunchy from walnuts. The buttery-sweet glaze adds yet another dimension.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Combine sugar, oil, and softened butter in a large bowl for the cake; beat with an electric mixer until smooth and creamy. Mix in eggs, one at a time; mix in vanilla. Gradually add flour, baking soda, and salt; stir until well combined. Fold in apples, coconut, raisins, and walnuts. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a cake tester inserted in the center comes out clean, about 90 minutes. Let cool in the pan for a few minutes. Run a knife around edges to loosen; invert carefully onto a serving plate or cooling rack."
    },
    {
      "position": 4,
      "text": "Combine brown sugar, butter, and milk in a small saucepan for the glaze; bring to a boil; stir for 1 minute."
    },
    {
      "position": 5,
      "text": "Pour glaze over warm cake."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

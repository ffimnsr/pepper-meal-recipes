  "id": "47fcb08f-75e4-59f2-a282-6835fa4df885",
  "slug": "cabbage-roll-casserole",
  "name": "Cabbage Roll Casserole",
  "recipe_type": "main",
  "brief_description": "This cabbage roll casserole combines chopped cabbage with ground beef, tomato sauce, and rice. It's easer to make than standard stuffed cabbage rolls!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C) and gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Combine cabbage, tomato sauce, onion, rice, and salt in a large mixing bowl. Stir in cooked ground beef. Pour mixture into a 9x13-inch baking dish, then pour beef broth over top."
    },
    {
      "position": 4,
      "text": "Cover and bake in the preheated oven for 1 hour."
    },
    {
      "position": 5,
      "text": "Stir, re-cover, and bake until cabbage is tender and rice is done, 20 to 30 minutes more."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

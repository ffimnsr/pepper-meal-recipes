  "id": "dd91599e-4057-5c17-87b2-a80aeebb1025",
  "slug": "strawberry-vanilla-pancakes",
  "name": "Strawberry Vanilla Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy strawberry pancakes are packed with sweet strawberries and vanilla for a delicious breakfast that tastes like dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour, brown sugar, baking powder, and salt together in a medium bowl. Pour in milk, egg, oil, and vanilla; mix until well blended. Stir in strawberries."
    },
    {
      "position": 2,
      "text": "Grease and heat a large skillet or griddle over medium heat."
    },
    {
      "position": 3,
      "text": "Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 2 to 3 minutes. Flip and cook until browned on the other side, about 2 minutes more. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

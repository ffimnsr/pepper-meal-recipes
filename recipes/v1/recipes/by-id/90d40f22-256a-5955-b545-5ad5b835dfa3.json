  "id": "90d40f22-256a-5955-b545-5ad5b835dfa3",
  "slug": "teriyaki-chicken-meatballs",
  "name": "Teriyaki Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "Savory chicken ginger meatballs are cooked in a from-scratch teriyaki sauce with shiitake mushrooms and daikon in this Asian-inspired recipe.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, spring onions, 1 tablespoon sake, 1 tablespoon water, cornstarch, ginger, and 1 teaspoon soy sauce in a bowl; mix by hand until sticky and smooth. Shape into round balls."
    },
    {
      "position": 2,
      "text": "Heat oil in a wok or deep skillet over medium-high heat. Add meatballs; cook until browned, about 3 minutes. Add shiitake mushrooms and daikon; cook and stir until coated with oil, about 1 minute."
    },
    {
      "position": 3,
      "text": "Pour 1 cup water, 2 tablespoons sake, mirin, 2 tablespoons soy sauce, and sugar into the wok. Cover and simmer until flavors combine, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

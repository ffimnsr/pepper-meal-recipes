  "id": "602ce9e3-30c7-5e1f-99b8-3d52bf41e904",
  "slug": "ruby-drive-sloppy-joes",
  "name": "Ruby Drive Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "Sloppy Joes are extra saucy, extra spicy with the addition of chunky salsa. They're scrumptious served on soft potato rolls.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat and stir in the ground beef. Cook and stir until the beef is crumbly, evenly browned, and no longer pink. Drain and discard any excess grease."
    },
    {
      "position": 2,
      "text": "Stir in ketchup, salsa, brown sugar, Worcestershire sauce, white vinegar, Dijon mustard, and hot sauce. Bring to a simmer and cook, stirring occasionally, over low heat 20 to 30 minutes. Serve on potato rolls."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

  "id": "2162875d-d776-5eca-9697-81f41c150550",
  "slug": "swedish-glogg",
  "name": "Swedish Glogg",
  "recipe_type": "drink",
  "brief_description": "This is an authentic Swedish spiced wine. This Swedish glogg recipe is from Great Aunt Freda, brought from Sweden in the early 1900s.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a pot with cardamom, cinnamon, cloves, and orange zest; stir in sugar until dissolved. Remove from heat and allow to steep 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Place raisins and almonds into a large saucepan. Strain sugar water into raisins, then pour in Muscatel, port, and brandy. Place over medium-high heat and cook until hot but not simmering."
    },
    {
      "position": 3,
      "text": "Serve warm in a mug with some fruit and almonds in each cup."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

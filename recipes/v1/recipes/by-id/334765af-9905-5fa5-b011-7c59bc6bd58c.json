  "id": "334765af-9905-5fa5-b011-7c59bc6bd58c",
  "slug": "jalapeno-popper-pasta-salad-recipe-11976322",
  "name": "Jalape\u00f1o Popper Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Jalape\u00f1o Popper Pasta Salad transforms a favorite party appetizer into a creamy pasta salad loaded with bacon, Cheddar, and spicy peppers. Rich, cheesy, and packed with just the right amount of heat, it\u2019s perfect for cookouts, potlucks, and picnics.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook pasta according to package directions for al dente. Drain and rinse under cold water until cooled; drain well."
    },
    {
      "position": 2,
      "text": "Stir together cream cheese, mayonnaise, sour cream, jalape\u00f1os, salt, pepper, and garlic powder in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Add cooled pasta and toss until evenly coated. Fold in bacon, cheddar cheese, and green onions."
    },
    {
      "position": 4,
      "text": "Serve immediately, or cover and refrigerate for at least 1 hour or up to 3 days. Garnish with additional green onions before serving. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

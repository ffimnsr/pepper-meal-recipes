{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bbf33538-20a8-5019-bb51-88d48d39237b",
  "slug": "peach-and-pistachio-galettes-recipe-12032808",
  "name": "Peach and Pistachio Galettes",
  "recipe_type": "dessert",
  "brief_description": "These peach and pistachio galettes are individual rustic fruit tarts with a layer of pistachio frangipane beneath beautifully ripened summer peaches. Wrapped in a flaky, golden-brown pastry crust studded with coarse sugar, they\u2019re an elegant summer dessert with effortless charm.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Halve peaches and remove pits. Slice thinly."
    },
    {
      "position": 2,
      "text": "Combine peach slices, brown sugar, lemon juice, cornstarch, and cinnamon in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Roll pie dough out on a lightly-floured work surface to about 1/8-inch thick. Use a 6-inch bowl or round cutter to cut out 4 circles of dough. Refrigerate until ready to assemble."
    },
    {
      "position": 4,
      "text": "For frangipane: add pistachios, powdered sugar, flour, and salt to a food processor. Pulse three times, until crumbly. Add butter and vanilla extract and pulse until combined. Add 1 egg and process until it has a spreadable consistency."
    },
    {
      "position": 5,
      "text": "To assemble galettes, spread 2 tablespoons frangipane onto each circle of pie dough, then arrange 6 to 7 peach slices on top, leaving a 1 inch border. Fold the sides of the dough up and over the filling to make a 1/2-inch border."
    },
    {
      "position": 6,
      "text": "Whisk remaining egg and milk together in a small bowl for egg wash; brush pie dough with egg wash and sprinkle with coarse sugar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 28 to 32 minutes. Remove and let cool for 5 minutes."
    },
    {
      "position": 8,
      "text": "Serve warm with a scoop of vanilla ice cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "ab573a07-5d35-510f-8938-3ca5d5f43ba7",
  "slug": "slow-cooker-loaded-potato-soup",
  "name": "Slow Cooker Loaded Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This loaded potato soup has the same ingredients as loaded baked potatoes \u2014 bacon, Cheddar cheese, sour cream, and scallions but in soup form!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine potatoes, chicken stock, onion, salt, and pepper in a slow cooker. Cook on High until potatoes are tender, about 4 hours."
    },
    {
      "position": 2,
      "text": "Meanwhile, place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon on paper towels and wipe out most of the grease from the skillet."
    },
    {
      "position": 3,
      "text": "Puree potatoes in the slow cooker with an immersion blender until smooth. Add 1/2 cup Cheddar cheese and 1/2 of the cooked bacon, set temperature to Low, and cook for 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Melt butter in the skillet over medium-low heat. Whisk in flour and stir until the mixture becomes paste-like and light golden brown, about 5 minutes. Add heavy cream, sour cream, and garlic powder; whisk until thickened. Pour into the slow cooker and cook on Low for 1 more hour."
    },
    {
      "position": 5,
      "text": "Ladle into bowls and garnish with remaining bacon, remaining Cheddar, sour cream, and scallions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 30,

  "id": "255a4f39-a223-5b25-a58d-b80b743cb2f3",
  "slug": "caribbean-coconut-rice",
  "name": "Caribbean Coconut Rice",
  "recipe_type": "side",
  "brief_description": "This Caribbean coconut rice recipe saut\u00e9s and simmers rice with ginger, cinnamon, and coconut milk. It's an easy side dish for pairing with many dishes.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in saucepan over medium heat. Add ginger, garlic, and cinnamon stick; saut\u00e9 until fragrant, about 1 minute. Stir in rice; saut\u00e9 until rice grains are opaque, about 2 minutes. Stir in water, coconut milk, sugar, salt, lime zest, and white pepper; bring to a simmer. Stir once, cover, reduce heat to low, and simmer for 15 minutes."
    },
    {
      "position": 2,
      "text": "Fluff rice with a fork, cover, and let rest for 5 minutes. Garnish servings with toasted coconut."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

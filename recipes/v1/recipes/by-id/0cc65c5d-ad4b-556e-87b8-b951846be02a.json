  "id": "0cc65c5d-ad4b-556e-87b8-b951846be02a",
  "slug": "hot-wing-hummus",
  "name": "Hot Wing Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This hummus variation is perfect for game day--you won't miss the chicken wings when you're dipping fresh vegetables in this spicy hot wing-flavored hummus.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine garbanzo beans and great northern beans in a large colander; rinse and allow to drain."
    },
    {
      "position": 2,
      "text": "Place the beans, wing sauce, ranch dressing mix, lemon juice, tahini, and garlic in the bowl of a food processor; process until smooth, scraping down the sides as necessary. Add olive oil and blend until hummus has thinned to desired consistency. Season with salt and pepper."
    }
  ],

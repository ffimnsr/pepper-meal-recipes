  "id": "9260febe-79c7-5748-8f33-176dc756695a",
  "slug": "baked-polenta-with-sausage",
  "name": "Baked Polenta with Sausage",
  "recipe_type": "dessert",
  "brief_description": "This rich, tomato-based casserole made with sweet Italian sausage and baked in a polenta crust topped with mozzarella provides a flavorful alternative to typical pasta dishes.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine water and milk in a large saucepan with polenta. Bring to a boil over high heat; add Parmesan cheese and butter. Stir constantly until thickened, about 3 minutes. Pour polenta into a large, round casserole dish, filling about 1 inch deep."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a medium nonstick skillet over medium-high heat. Cook and stir sausage, mushrooms, onion, and garlic in the skillet until sausage is browned and crumbly, about 10 minutes. Add wine, tomatoes, tomato paste, sugar, Italian seasoning, and oregano; cook over medium heat for 30 minutes."
    },
    {
      "position": 4,
      "text": "Pour tomato sauce mixture over polenta. Top with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "850bfc22-37d5-5a19-b650-1d0f33290860",
  "slug": "alfajores-argentinean-style",
  "name": "Alfajores Argentinean Style",
  "recipe_type": "dessert",
  "brief_description": "This Argentinian-style alfajores recipe is for vanilla and lemon sandwich cookies with caramel and coconut. They're much loved in most Latin cultures.",
  "cuisine": "Argentine",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk cornstarch, flour, baking powder, and baking soda together; set aside."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar together in a large bowl with an electric mixer until light and fluffy. Beat in 2 egg yolks, one at a time, beating well after each addition; beat in third yolk along with lemon zest, vanilla rum, vanilla extract, and lemon extract. Gently fold in cornstarch mixture with a spoon, making a crumbly dough, until cohesive enough; press into a ball. Wrap dough in plastic wrap; chill 30 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Roll dough out, using as little flour as possible, until about \u00bc-inch thick. (The dough will have an unusual consistency.) Cut dough using a small round cookie cutter. Continue pressing dough together, rolling, and cutting until all dough is used. Place cookies spaced \u00bd-inch apart onto the prepared cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set but not browned, 7 to 10 minutes. Transfer cookies immediately to a wire rack to cool."
    },
    {
      "position": 6,
      "text": "Spread 1 teaspoon dulce de leche onto underside of 1 cooled cookie; sandwich with second cookie until caramel oozes out sides. Roll sides in shredded coconut. Repeat with remaining cookies, dulce de leche, and coconut."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

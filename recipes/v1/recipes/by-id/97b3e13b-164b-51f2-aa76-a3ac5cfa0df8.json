  "id": "97b3e13b-164b-51f2-aa76-a3ac5cfa0df8",
  "slug": "bulgogi-burgers",
  "name": "Bulgogi Burgers",
  "recipe_type": "dessert",
  "brief_description": "Fresh burgers seasoned with Korean-style flavorings like sesame seeds and sweet Asian wine are pan-fried to give you the flavor of the Korean beef barbeque without all the marinating and grilling.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Cook and stir sesame seeds in a small dry skillet over medium-low heat until they are fragrant and toasted, about 2 minutes. Transfer immediately into a small bowl and let cool."
    },
    {
      "position": 3,
      "text": "Mix ground beef, green onions, roasted garlic, mirin wine, soy sauce, sugar, sesame oil, black pepper, salt, and toasted sesame seeds together in a large bowl until thoroughly combined. Divide the meat mixture into 8 portions and form each portion into a large beef patty about 1/2 inch thick."
    },
    {
      "position": 4,
      "text": "Pan-fry the burgers in a large skillet over medium-low heat until browned and the meat is no longer pink inside, about 8 minutes per side. An instant-read meat thermometer inserted into the center of the burgers should read at least 145 degrees F (65 degrees F)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

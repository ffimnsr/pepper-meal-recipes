  "id": "d35dd354-6f5d-5744-9aad-69cdbcdab6fb",
  "slug": "air-fryer-tajin-sweet-potato-fries",
  "name": "Air Fryer Tajin Sweet Potato Fries",
  "recipe_type": "dessert",
  "brief_description": "This air fryer Tajin sweet potato fries recipe, with its warm, aromatic flavors, is a Mexican-inspired side. The tangy dipping sauce adds a nice kick.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's directions. Lightly coat the fryer basket with cooking spray."
    },
    {
      "position": 2,
      "text": "Place sweet potatoes in a large bowl, drizzle with oil and 1 1/2 teaspoons chili-lime seasoning; toss well. Transfer to the air fryer basket, working in batches if necessary."
    },
    {
      "position": 3,
      "text": "Cook sweet potatoes in the preheated air fryer until brown and crispy, 8 to 9 minutes, shaking and turning fries after 4 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, whisk mayonnaise, lime juice, and 1 teaspoon chili-lime seasoning together in a small bowl. Serve sweet potato fries with dipping sauce and lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "11a88eda-e4b0-5262-be35-f602c2ed41ec",
  "slug": "shawarma-spiced-roast-turkey-breast-recipe-8742124",
  "name": "Shawarma-Spiced Roast Turkey Breast",
  "recipe_type": "main",
  "brief_description": "Chef John's roast turkey breast recipe uses the same spices people love in a chicken shawarma wrap. It is moist, tender, and extremely flavorful, and the spices seem to work even better with the meatier taste of turkey. The gorgeously-colored pan sauce made from the drippings elevates the flavor still more.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Add paprika, cumin, coriander, cinnamon, ginger, garlic powder, black pepper, turmeric, cardamom, cayenne, and salt to a bowl; stir until well mixed and set aside."
    },
    {
      "position": 2,
      "text": "Place turkey breast meat side up on a cutting board, and make a deep cut into the thickest part at a 45-degree angle, about 2/3 of the way in, to butterfly open the breast. Make a few more shallow cuts to open up even more, and then coat all exposed meat with about 3/4 of the spice mixture. Be sure to rub spices in thoroughly."
    },
    {
      "position": 3,
      "text": "Fold turkey back together with the skin side up, and use 3 pieces of kitchen string to tie up tightly into a roll. Transfer to a bowl, and coat with 1 tablespoon olive oil and remaining spice mix. Refrigerate for at least 3 hours and up to 24 hours before roasting."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Scatter sliced onions evenly into the bottom of an ovenproof pan. Add chicken broth. Place turkey on top, and season skin with more salt if desired."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven for 20 minutes, then reduce temperature to 300 degrees F (150 degrees C). and roast for about 1 hour more. An instant read thermometer inserted near the center should read 155 degrees F (68 degrees C). Temperature will continue to rise while resting to 165 degrees F (74 degrees C). Cooking time depends on size of breast, so start checking for doneness early. Remove turkey to a plate and cover loosely with foil. Let rest for 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, place the roasting pan over medium-high heat, and bring to a boil until liquids have reduced. Reduce the heat to medium-low, and check the amount of rendered fat in the pan. If necessary add a 1 or 2 tablespoons of olive oil, so there will be enough fat to make a roux. If there are already a few tablespoons fat from the turkey, you will not need to add any more oil, and can move to the next step."
    },
    {
      "position": 7,
      "text": "Add flour and cook, stirring, for about a minute. Add lemon juice and chicken broth, and turn heat up to medium-high. Stir constantly while mixture comes back to a simmer. Add a little more broth if the sauce is too thick, or continue to simmer if sauce is too thin. Taste for salt and adjust. Reduce heat to low and keep hot until needed."
    },
    {
      "position": 8,
      "text": "Slice turkey, and serve with sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": 10,

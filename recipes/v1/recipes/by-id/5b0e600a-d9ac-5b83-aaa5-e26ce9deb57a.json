{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5b0e600a-d9ac-5b83-aaa5-e26ce9deb57a",
  "slug": "chef-johns-chinese-scallion-pancakes",
  "name": "Chef John's Chinese Scallion Pancakes",
  "recipe_type": "appetizer",
  "brief_description": "Moist, oniony inner layers accompany each bite of these crispy, fragrant scallion pancakes.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine bread flour and salt in a large bowl. Make a well in the middle and pour in hot water. Mix together with a wooden spoon to form a shaggy dough."
    },
    {
      "position": 2,
      "text": "Transfer dough onto a lightly floured work surface. Knead dough until sticky but relatively smooth and elastic, dusting with a minimal amount of flour if needed. Wrap in plastic wrap and let dough rest for 2 hours."
    },
    {
      "position": 3,
      "text": "Mix vegetable oil, sesame oil, and flour together in a skillet over medium heat until starting to bubble, about 3 minutes. Cook for 1 minute more. Remove from heat and cool to room temperature."
    },
    {
      "position": 4,
      "text": "Unwrap dough and cut in half. Roll out into a tube and press down with your fingers. Use a rolling pin to flatten dough into a rectangular shape about 1/8-inch thick, flipping over and dusting lightly with flour halfway through."
    },
    {
      "position": 5,
      "text": "Paint surface of the dough with the oil mixture until just covered, leaving 1 inch of space on the edges. Sprinkle scallions on top. Roll dough up tightly to seal in the scallions, starting with the long side. Pull the opposite edge over the top once you have reached it."
    },
    {
      "position": 6,
      "text": "Coil 1 end of the dough inward toward the middle; wrap the opposite end around the coil to finish, tucking the tip under the bottom. Dust the coil with flour and roll dough out into a pancake about 1/4-inch thick. Repeat with remaining dough, oil, and green onions to make the second pancake."
    },
    {
      "position": 7,
      "text": "Heat vegetable oil in a cast iron skillet over high heat. Add 1 pancake; lower heat to medium. Cook until crispy and browned, about 4 minutes per side. Repeat with the other pancake. Cut into wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "20f2a106-be0e-5aed-b11a-1f05260aa6b7",
  "slug": "hamantaschen",
  "name": "Hamantaschen",
  "recipe_type": "dessert",
  "brief_description": "These quick and easy hamantaschen cookies filled with the traditional poppy seed filling can be customized with the filling of your choice.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 baking sheets."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, and baking powder together in a large bowl. Cut in margarine with 2 knives or a pastry blender. Add eggs and vanilla extract; mix well until dough comes together and is smooth. If dough is sticky, add more flour."
    },
    {
      "position": 3,
      "text": "Roll out dough on floured work surface until it is about 1/4-inch thick. Press the rim of a glass into flour and then into the dough to cut out circles."
    },
    {
      "position": 4,
      "text": "Place 1/2 teaspoon filling into the center of each circle. Fold up the 3 sides into a triangle shape, pinching the sides together tightly to seal. Transfer cookies to baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cookies are golden brown, about 25 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

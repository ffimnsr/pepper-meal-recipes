  "id": "0c2d3c00-785e-5245-93f1-e37c6c73d33e",
  "slug": "ricotta-stuffed-squash",
  "name": "Ricotta Stuffed Squash",
  "recipe_type": "side",
  "brief_description": "This yummy squash recipe is easy and healthy to make. Serve it warm with pasta or rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Trim off ends of squash; cut squash in half (lengthwise). With a teaspoon scoop out seeds and part of the pulp leaving shells about 1/2 inch thick. Steam squash shells over boiling water until crisp-tender (about 5 minutes). Plunge into cold water, drain well and set aside."
    },
    {
      "position": 3,
      "text": "In a small frying pan over medium heat, melt one tablespoon of the butter. Add onion and garlic and cook until they are done. Squeeze the spinach to remove extra moisture and add to the garlic and onion and cook until thoroughly heated."
    },
    {
      "position": 4,
      "text": "In a medium size mixing bowl, combine eggs, ricotta, Parmesan, parsley, salt, pepper, Italian seasoning and spinach mixture. Fill the squash halves with this mixture, about three tablespoons per shell and place squash in a shallow baking dish. Melt the remaining butter and brush over the squash shells"
    },
    {
      "position": 5,
      "text": "Bake for 20 minutes. If desired, serve with tomato sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "easy",

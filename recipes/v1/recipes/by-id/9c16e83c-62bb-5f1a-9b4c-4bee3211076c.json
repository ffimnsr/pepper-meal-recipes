  "id": "9c16e83c-62bb-5f1a-9b4c-4bee3211076c",
  "slug": "korean-hot-wings",
  "name": "Korean Hot Wings",
  "recipe_type": "appetizer",
  "brief_description": "Crispy deep-fried chicken wings are tossed in a spicy Korean-style sauce made with ginger, chile-garlic sauce, soy sauce, brown sugar, and sesame oil.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Stir soy sauce, brown sugar, ketchup, barbeque sauce, garlic, vinegar, chile-garlic sauce, pepper, sesame oil, and ginger together in a saucepan; bring to a boil."
    },
    {
      "position": 2,
      "text": "Whisk cornstarch and water together in a small bowl; stir into sauce. Remove from heat and set aside to cool and thicken."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep-fryer or large saucepan to 360 degrees F (182 degrees C)."
    },
    {
      "position": 4,
      "text": "Season chicken wings with lemon-pepper seasoning."
    },
    {
      "position": 5,
      "text": "Fry chicken wings in batches of 6 to 8 at a time in hot oil until no longer pink at the bone and the juices run clear, 6 to 8 minutes per batch. An instant-read thermometer inserted into the meatiest part of the wing, near the bone, should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Place cooked wings into a large mixing bowl. Ladle sauce over the wings and toss to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

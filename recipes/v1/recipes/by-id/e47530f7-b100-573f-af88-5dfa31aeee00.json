  "id": "e47530f7-b100-573f-af88-5dfa31aeee00",
  "slug": "blueberry-turnovers",
  "name": "Blueberry Turnovers",
  "recipe_type": "dessert",
  "brief_description": "This blueberry turnover recipe features blueberries baked into flaky crescent rolls for a light, delicious treat. Drizzle with icing for more sweetness.",
  "cuisine": "American French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Roll out crescent dough triangles onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Place 1 tablespoon blueberries on widest end of each triangle; top each group blueberries with 1/2 teaspoon confectioners\u2019 sugar. Roll up crescent rolls around blueberries, starting with the wide ends. Pinch both sides to completely seal."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 12 minutes. Cool on a wire rack for 5 minutes."
    },
    {
      "position": 5,
      "text": "Dust turnovers with remaining confectioners\u2019 sugar. Drizzle with vanilla frosting."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

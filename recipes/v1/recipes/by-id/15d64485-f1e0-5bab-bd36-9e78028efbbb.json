  "id": "15d64485-f1e0-5bab-bd36-9e78028efbbb",
  "slug": "clam-linguine",
  "name": "Clam Linguine",
  "recipe_type": "main",
  "brief_description": "Enjoy linguine pasta with clams and tomatoes, tossed in a mixture of butter and olive oil with aromatic garlic and fresh parsley any night of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium skillet over medium heat, heat olive oil and butter. Add tomatoes, parsley, and garlic; simmer and let reduce, about 5 minutes. Add some clam juice if the sauce reduces too much."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add pasta and cook for 3 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "Add pasta and clams to the skillet and heat through; top with Parmesan cheese and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

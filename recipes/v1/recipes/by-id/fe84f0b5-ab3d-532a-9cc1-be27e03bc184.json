  "id": "fe84f0b5-ab3d-532a-9cc1-be27e03bc184",
  "slug": "cinnamon-ice-cream",
  "name": "Cinnamon Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "Make homemade cinnamon ice cream in your ice cream maker, then enjoy it as a delicious treat either by itself or blended with milk in a milkshake.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs together in a bowl."
    },
    {
      "position": 2,
      "text": "Stir half-and-half and sugar together in a saucepan over medium-low heat until mixture begins to simmer. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Pour 1/2 of the hot mixture into the eggs, whisking quickly to avoid scrambling the eggs. Pour the mixture back into the saucepan and whisk in heavy cream. Continue cooking over medium-low heat, whisking constantly, until thick enough to coat the back of a metal spoon. Remove from the heat, and whisk in cinnamon and vanilla. Set aside to cool, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions, about 20 minutes. Transfer to an airtight container and freeze until firm or desired consistency, about 2 to 4 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

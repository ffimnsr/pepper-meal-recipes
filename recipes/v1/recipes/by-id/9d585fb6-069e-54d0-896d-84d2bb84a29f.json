  "id": "9d585fb6-069e-54d0-896d-84d2bb84a29f",
  "slug": "jalapeno-popper-corn-dip-recipe-11991121",
  "name": "Jalape\u00f1o Popper Corn Dip",
  "recipe_type": "appetizer",
  "brief_description": "For this jalape\u00f1o popper corn dip, we took one of our favorite dips and brought it up a notch by adding in some corn from our previous season\u2019s garden. It was a great way to use some frozen corn, and the taste is incredible. Leftovers are going in enchiladas as a filling! Serve dip with corn chips or tortilla chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine corn, jalapenos, salt, garlic powder, onion powder, mozzarella, and cream cheese in a bowl. Use a fork to mash ingredients together until thoroughly combined. Spread dip in a 1-quart baking dish, and smooth the top. Sprinkle top with more mozzarella cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until hot and bubbly, and top is lightly browned, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "a8c72a3f-e750-596b-9c89-173389a134d8",
  "slug": "quinoa-chicken",
  "name": "Quinoa Chicken",
  "recipe_type": "side",
  "brief_description": "This ground chicken and quinoa recipe is quick and easy to make. Diced tomatoes with green chile peppers gives this one-dish dinner a spicy kick!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring chicken broth and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat vegetable oil in a large skillet over medium-high heat. Saut\u00e9 onion and garlic in hot oil until onion is translucent, about 5 minutes. Add ground chicken; cook and stir until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Stir cooked quinoa and diced tomatoes into chicken mixture; bring to a simmer and cook long enough for flavors to meld, about 10 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8d049934-bce5-550d-b6ee-022dd11eb430",
  "slug": "hiyashi-chuka-noodles",
  "name": "Hiyashi Chuka Noodles",
  "recipe_type": "salad",
  "brief_description": "Ramen noodles are served cold with chili sauce, cucumber, and carrots as well as ham and egg. This recipe is for a common cold noodle salad in Japan.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken stock, soy sauce, vinegar, sugar, sesame oil, and chili oil in a small bowl, stirring until sugar dissolves."
    },
    {
      "position": 2,
      "text": "Bring a saucepan of water to a boil. Cook ramen noodles in the boiling water for 2 minutes. Drain immediately; refrigerate noodles until cold."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat a small nonstick skillet over medium heat. Pour in beaten egg and tilt the skillet until egg thinly coats the bottom of the skillet and is firm; fold egg in half and remove from the skillet. Slice cooked egg into thin strips."
    },
    {
      "position": 4,
      "text": "Divide cold noodles between serving plates; top with separate piles egg, ham, carrot, and cucumber. Pour soy sauce mixture over top; sprinkle with nori. Serve with hot mustard on the side."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

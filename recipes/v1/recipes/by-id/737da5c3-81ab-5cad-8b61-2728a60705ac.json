  "id": "737da5c3-81ab-5cad-8b61-2728a60705ac",
  "slug": "blueberry-buckle",
  "name": "Blueberry Buckle",
  "recipe_type": "dessert",
  "brief_description": "This blueberry buckle is a tender, made-from-scratch coffee cake studded with fresh blueberries and topped with a buttery, crumbly cinnamon streusel.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch pan."
    },
    {
      "position": 2,
      "text": "Beat sugar, butter, and egg in a large bowl with an electric mixer until light and fluffy. Stir flour, baking powder, and salt together in a separate bowl. Add flour mixture to sugar mixture in 2 batches, alternating with milk, beating batter briefly after each addition. Fold in blueberries. Pour into the prepared pan."
    },
    {
      "position": 3,
      "text": "To make the topping: Combine sugar, flour, butter, and cinnamon in a bowl; mix with your hands until crumbly. Sprinkle over cake batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

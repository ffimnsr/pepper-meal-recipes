  "id": "36dcb90e-c577-5148-8b07-967f5c04d574",
  "slug": "crispy-buffalo-chicken-wontons",
  "name": "Crispy Buffalo Chicken Wontons",
  "recipe_type": "appetizer",
  "brief_description": "These Buffalo chicken wontons make a deliciously crispy, deep-fried appetizer with all the flavors of Buffalo chicken. Guaranteed to please a crowd!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine chicken, Cheddar cheese, ranch dressing, butter, and hot sauce in a bowl. Scoop about 1 tablespoon of chicken mixture onto the center of each wonton wrapper; fold wontons in half and press to seal. Arrange wontons on a baking sheet and freeze for 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Lower wontons carefully into the hot oil in batches. Fry until golden brown, about 2 to 3 minutes. Transfer to a paper towel-lined plate to drain. Repeat with remaining wontons."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

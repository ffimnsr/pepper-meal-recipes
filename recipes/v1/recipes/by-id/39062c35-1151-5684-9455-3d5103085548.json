  "id": "39062c35-1151-5684-9455-3d5103085548",
  "slug": "home-style-brown-rice-pilaf",
  "name": "Home-Style Brown Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "While the brown rice is bubbling on the stove, onions, carrots, garlic, chickpeas, and mushrooms are sauteed in butter until cooked and the flavors are mingled. Eggs are swirled into the pan, the rice is added, and then a nice smattering of parsley and cashews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 1-1/2 cups water to boil, add rice. Bring contents back to a boil, cover the pot and simmer for 45-50 minutes, or until rice is tender."
    },
    {
      "position": 2,
      "text": "Approximately 20 minutes before rice is finished cooking heat the butter in a large skillet over medium heat. Stir in onions and saute them, stirring frequently until they soften. Add the garlic and carrots and continue stirring for 5 minutes."
    },
    {
      "position": 3,
      "text": "Place mushrooms inside of skillet and cook until mushrooms begin to brown, about 10 minutes. Add the chickpeas and cook 1 more minute."
    },
    {
      "position": 4,
      "text": "When the rice is finished cooking pour the eggs into the skillet and cook the mixture, stirring constantly until the eggs are cooked. Remove the skillet from the heat, stir in pepper, parsley, and nuts."
    },
    {
      "position": 5,
      "text": "Spoon the cooked rice into the skillet and stir well. Serve the pilaf hot with soy sauce on the side for added flavor."
    }
  ],
  "servings": 4,

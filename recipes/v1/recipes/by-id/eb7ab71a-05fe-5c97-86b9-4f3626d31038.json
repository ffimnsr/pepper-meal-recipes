  "id": "eb7ab71a-05fe-5c97-86b9-4f3626d31038",
  "slug": "slow-cooked-stew-meat-chili",
  "name": "Slow-Cooked Stew Meat Chili",
  "recipe_type": "soup",
  "brief_description": "This hearty slow cooker steak chili with black beans, kidney beans, diced tomatoes, and lots of spices is perfect for potlucks or family gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Add beef; cook and stir until browned, about 3 to 5 minutes. Add chili powder and cumin; cook and stir until fragrant, about 1 minute. Stir in flour and cook for 1 minute more. Transfer meat to a large slow cooker."
    },
    {
      "position": 3,
      "text": "Stir in diced tomatoes, black beans, kidney beans, 1 1/2 cups beef broth, onion, bell pepper, parsley, barbecue sauce, brown sugar, garlic, and salt until well combined."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low, stirring occasionally, until beef is tender, 6 to 8 hours. Thin chili with remaining beef broth as it cooks if the consistency is too thick."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 365,

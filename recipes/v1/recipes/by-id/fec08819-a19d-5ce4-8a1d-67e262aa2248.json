  "id": "fec08819-a19d-5ce4-8a1d-67e262aa2248",
  "slug": "kielbasa-and-potato-bake",
  "name": "Kielbasa and Potato Bake",
  "recipe_type": "breakfast",
  "brief_description": "Polish sausage slices and potatoes are baked together in a creamy sauce to make this hearty brunch casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together soup, milk, garlic, salt, and pepper in a large bowl. Stir in potatoes and kielbasa. Transfer to a 7x11-inch casserole dish."
    },
    {
      "position": 3,
      "text": "Place casserole on a baking sheet, and bake in the preheated oven until potatoes are tender, about 90 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,

  "id": "f6357600-bd7f-5f39-be04-e23a9f8b438e",
  "slug": "moms-ranger-cookies",
  "name": "Mom's Ranger Cookies",
  "recipe_type": "dessert",
  "brief_description": "Golden-brown cookies bake up with a crunchy and chewy texture thanks to coconut, rolled oats, and corn flakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter, brown sugar, and white sugar together in a bowl until creamy."
    },
    {
      "position": 3,
      "text": "Beat in eggs and vanilla extract until smooth."
    },
    {
      "position": 4,
      "text": "In a separate bowl, whisk together both amounts of flour, salt, baking soda, and baking powder. Mix flour mixture into the liquid ingredients."
    },
    {
      "position": 5,
      "text": "Gently mix rolled oats, corn flakes, and coconut into the dough until thoroughly combined."
    },
    {
      "position": 6,
      "text": "Drop the dough by tablespoons onto baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the cookies are light golden brown, 10 to 12 minutes."
    },
    {
      "position": 8,
      "text": "Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,

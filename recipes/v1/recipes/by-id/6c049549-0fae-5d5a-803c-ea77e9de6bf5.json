  "id": "6c049549-0fae-5d5a-803c-ea77e9de6bf5",
  "slug": "slow-cooker-chicken-chile-relleno-casserole-recipe-11864950",
  "name": "Slow Cooker Chicken Chile Relleno Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker chicken chile relleno casserole tastes like a super cozy, cheesy chile relleno without the fuss of frying anything. It\u2019s truly delicious and so flavorful for a slow cooker recipe. The eggs are perfectly cooked, set, and creamy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly coat a 6-quart slow cooker with cooking spray. Arrange half the chiles in an even layer in the slow cooker. Sprinkle evenly with 1/2 cup each Cheddar and pepper Jack cheese. Top evenly with chicken. Top evenly with remaining chiles; sprinkle with 1/4 cup each pepper Jack and Cheddar."
    },
    {
      "position": 2,
      "text": "Whisk evaporated milk, eggs, cornstarch, salt, garlic powder, pepper, and paprika together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Pour egg mixture evenly over chile mixture in cooker."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until set around the edges and just set in the center, 3 1/2 to 4 hours."
    },
    {
      "position": 5,
      "text": "Remove lid. Dab top of casserole gently with paper towels to absorb excess moisture, if needed. Top with enchilada sauce, remaining 1/2 cup Cheddar, and remaining 1/4 cup pepper Jack cheese."
    },
    {
      "position": 6,
      "text": "Continue to cook, uncovered on Low, until cheese has melted, 15 to 20 minutes. Turn cooker off."
    },
    {
      "position": 7,
      "text": "Garnish with cilantro. Serve with sour cream. Recipe developed by Marianne Williams"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 225,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

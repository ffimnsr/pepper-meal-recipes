  "id": "e2cae6ae-6845-58d5-845d-b107087c33e9",
  "slug": "scottish-shepherds-pie",
  "name": "Scottish Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Cubed ham is arranged in the bottom of a casserole dish, topped with creamed corn and briefly heated in the oven. Mashed potatoes are spooned on top, and then the pie is returned to the oven. Just before serving, it 's dotted with butter and slipped under the broiler to brown.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place ham in a 2 quart casserole dish and top with corn. Heat in preheated oven 10 minutes. Remove and top with mashed potatoes. Heat in oven for 20 more minutes, then remove."
    },
    {
      "position": 3,
      "text": "Turn oven to \"broil\" setting. Dot potatoes with butter or margarine, then place pie under broiler just until golden brown on top, about 3 minutes. Serve immediately."
    }
  ],
  "servings": 8,

  "id": "84afd07c-6118-5661-9812-85316450fecb",
  "slug": "oatmeal-whole-wheat-quick-bread",
  "name": "Oatmeal Whole Wheat Quick Bread",
  "recipe_type": "appetizer",
  "brief_description": "A hearty quick bread with oatmeal, whole wheat flour and just a little honey.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Grind oatmeal in a food processor or blender. In a large bowl, combine oatmeal, flour, baking powder and salt. In a separate bowl, dissolve honey in vegetable oil then stir in the milk. Combine both mixtures and stir until a soft dough is formed. Form the dough into a ball and place on a lightly oiled baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for about 20 minutes, or until bottom of loaf sounds hollow when tapped."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

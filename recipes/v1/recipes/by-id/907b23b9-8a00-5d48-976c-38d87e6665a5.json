  "id": "907b23b9-8a00-5d48-976c-38d87e6665a5",
  "slug": "sauteed-garlic-asparagus",
  "name": "Saut\u00e9ed Asparagus",
  "recipe_type": "side",
  "brief_description": "This saut\u00e9ed asparagus dish is simple to make with fresh tender asparagus, butter, and garlic for a quick and delicious 10 minute side to meat or fish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add asparagus spears and garlic; cover and cook until asparagus is tender-crisp, about 5 to 10 minutes depending on thickness of asparagus."
    },
    {
      "position": 3,
      "text": "If you like your asparagus well done, reduce heat and cook for an additional few minutes."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

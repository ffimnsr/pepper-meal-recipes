  "id": "c0a5d59e-ad4d-5988-b25f-d24b450c7e9a",
  "slug": "mexican-lasagna-lite",
  "name": "Mexican Lasagna Lite",
  "recipe_type": "main",
  "brief_description": "This Mexican lasagna lite recipe uses lighter ingredients, including refried beans, enchilada sauce, sour cream, and ground turkey to make it healthier.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Brown turkey in a skillet over medium heat, breaking it up as it cooks, about 10 minutes. Stir in water and taco seasoning mix; bring to a boil. Reduce heat to low; simmer until thickened, about 5 minutes. Stir in green chilies. Set aside off heat."
    },
    {
      "position": 3,
      "text": "Spread a scant \u2154 cup enchilada sauce evenly over bottom of an 8x10-inch baking dish; top with 4 tortillas, overlapping if necessary. Spread \u00bd sour cream, \u00bd refried beans, \u00bd turkey mixture, and \u2153 cheese onto tortillas. Top with \u2154 cup enchilada sauce and 4 tortillas; firmly press down on tortillas to compact layers."
    },
    {
      "position": 4,
      "text": "Repeat layers, spreading remaining \u00bd sour cream, remaining \u00bd refried beans, remaining \u00bd turkey mixture, \u2153 cheese, and \u2154 cup enchilada sauce onto tortillas. Top with remaining 4 tortillas, remaining \u2154 cup enchilada sauce, and remaining \u2153 cheese."
    },
    {
      "position": 5,
      "text": "Bake uncovered in the preheated oven until cheese topping is melted and bubbling and casserole is hot, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

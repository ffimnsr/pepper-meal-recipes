{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "443fc78a-7fa3-5b1b-a2e6-11c6a93a1b60",
  "slug": "irish-roasties-recipe-12009965",
  "name": "Irish Roasties",
  "recipe_type": "side",
  "brief_description": "Every Irish cook has their own opinion about how to roast potatoes. This recipe is based on my mother-in-law\u2019s method for achieving the perfect golden-brown crackly exterior and fluffy interior.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Pour olive oil into a large sheet pan and set aside."
    },
    {
      "position": 2,
      "text": "Scrub and peel potatoes. If using large Russets, cut into quarters. If using a smaller potato, cut into halves."
    },
    {
      "position": 3,
      "text": "Place the potatoes in a large saucepan and cover with cold water. Set over high heat and bring to a boil. Once water boils, reduce to a strong simmer and parboil potatoes until the outsides are tender, but the inside is still firm, checking frequently with the tip of a paring knife, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Turn off the burner and drain potatoes in a colander. Place empty saucepan back on the hot burner to dry and place the prepped sheet pan in the preheated oven."
    },
    {
      "position": 5,
      "text": "Once the water is drained, \u201cfluff\u201d the potatoes by gently shaking and swirling the colander until the exteriors are roughened. Set the colander on top of the empty saucepan for 2 to 3 minutes, until the potatoes are completely dry."
    },
    {
      "position": 6,
      "text": "Carefully remove hot sheet pan from the oven. Tip potatoes on top of the sheet pan and gently stir to coat with the hot oil. Roast in the preheated oven for 40 minutes, then flip each potato and roast until the exterior is crackly and golden brown, another 20 minutes ."
    },
    {
      "position": 7,
      "text": "Serve alongside flaky sea salt and freshly cracked black pepper so each diner can season to taste like they often do in Ireland."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,

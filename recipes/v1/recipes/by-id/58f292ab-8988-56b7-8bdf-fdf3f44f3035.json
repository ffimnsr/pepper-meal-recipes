  "id": "58f292ab-8988-56b7-8bdf-fdf3f44f3035",
  "slug": "grandmas-corn-bread-dressing",
  "name": "Grandma's Cornbread Dressing",
  "recipe_type": "side",
  "brief_description": "This Southern cornbread dressing, flavored with sage and aromatics, is sure to become a family favorite for holidays and other special occasions.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 7x11-inch baking dish. Place crumbled cornbread in a large bowl."
    },
    {
      "position": 3,
      "text": "Melt butter in a large skillet over medium heat. Add onion and celery and saut\u00e9 until soft, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Add saut\u00e9ed onion and celery to the crumbled cornbread. Stir in chicken stock, eggs, sage, salt, and pepper until well combined. Pour dressing into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until dressing just starts to turn golden brown around the edges, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

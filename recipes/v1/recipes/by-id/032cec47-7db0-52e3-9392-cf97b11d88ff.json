  "slug": "savory-turkey-brine",
  "name": "Savory Turkey Brine",
  "recipe_type": null,
  "brief_description": "This easy-to-prep soy sauce-based turkey brine recipe is flavored with thyme, celery, and sage for flavorsome, juicy results.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix water with soy sauce, salt, sugar, sage, celery seed, and thyme in a large stockpot. Stir well until salt is dissolved. Let cool to room temperature."
    }

  "id": "4745b5a5-49a7-59c6-b112-10ac10e0a4f1",
  "slug": "pain-perdu-i",
  "name": "Pain Perdu",
  "recipe_type": "breakfast",
  "brief_description": "Pain perdu is French toast, but a superior one. Unlike regular French toast, this batter cooks into a custardy, crispy coating that leaves the bread creamy and oh so good.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place bread slices on a wire rack to dry while preparing batter."
    },
    {
      "position": 2,
      "text": "Melt 3 tablespoons butter in a saucepan over medium-low heat and allow to cool slightly."
    },
    {
      "position": 3,
      "text": "Whisk egg in a shallow bowl. Whisk sugar, salt, cinnamon, and nutmeg into egg. When butter has cooled slightly, slowly drizzle it into egg mixture while whisking. Add flour to egg mixture, a little at a time, until a smooth thick paste forms. Slowly blend in milk and vanilla; whisk until just smooth and set aside."
    },
    {
      "position": 4,
      "text": "Heat remaining butter in a large skillet over medium heat."
    },
    {
      "position": 5,
      "text": "Dip a bread slice in batter and allow to soak for no more than 30 seconds. Remove from batter and allow excess to drip back into the bowl. Place battered slice in the hot skillet. Repeat with remaining bread slices."
    },
    {
      "position": 6,
      "text": "Cook bread slices until golden, 2 to 3 minutes per side. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

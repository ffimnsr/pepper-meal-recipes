  "id": "bb50409c-a73f-5415-8daa-8f8e3cd0db59",
  "slug": "chef-johns-swedish-meatballs",
  "name": "Chef John's Swedish Meatballs",
  "recipe_type": "main",
  "brief_description": "These Swedish meatballs from Chef John's feature oven-baked balls of seasoned ground beef and pork, served in a luscious and savory pan gravy.",
  "cuisine": "Swedish Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Make meatballs: Melt butter in a large skillet over medium heat. Cook and stir onion and salt in hot butter until onion turns translucent, about 6 minutes."
    },
    {
      "position": 2,
      "text": "Transfer onion mixture to a large bowl. Stir in eggs, bread crumbs, milk, black pepper, nutmeg, allspice, and cayenne. Mix in ground beef and pork until well combined. Cover the bowl with plastic wrap and refrigerate for 1 hour."
    },
    {
      "position": 3,
      "text": "Make gravy: Melt butter in a large skillet over medium heat; whisk in flour and cook until golden brown, 4 to 5 minutes. Slowly whisk in beef broth. Increase heat to medium-high, whisk in cream, and bring to a simmer. Stir in sugar and Worcestershire. Simmer until slightly thickened, 6 to 7 minutes. Season with salt and black pepper. Remove from heat and set aside."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and lightly coat with cooking spray."
    },
    {
      "position": 5,
      "text": "Roll 2 to 3 tablespoons meatball mixture into a ball using wet hands; repeat with remaining meatball mixture. Place meatballs on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned and cooked through, about 20 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 7,
      "text": "Transfer meatballs to gravy and cook over medium-low heat until warmed through, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "9e8a974d-6c83-54c6-be20-3d02d82993b1",
  "slug": "vegan-mushroom-and-kale-soup",
  "name": "Vegan Mushroom and Kale Soup",
  "recipe_type": "soup",
  "brief_description": "Vegan main dishes don't get easier than this mushroom and kale soup seasoned with herbes de Provence and loaded with potatoes and carrots.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium heat. Add potatoes, carrots, celery, and onion. Cook and stir until fragrant, 3 to 5 minutes. Add broth, 1 package of mushrooms, salt, herbes de Provence, pepper, and bay leaf. Cook until vegetables are soft, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Place kale in a separate saucepan over low heat and add water to cover. Cook until tender, 5 to 8 minutes. Drain excess liquid."
    },
    {
      "position": 3,
      "text": "Coarsely chop the second package of mushrooms."
    },
    {
      "position": 4,
      "text": "Fill blender halfway with the vegetables and broth. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour into a pot. Repeat with remaining vegetables and broth. Pour all of the pureed soup back into the saucepan. Add the kale and chopped mushrooms. Let simmer until mushrooms are just tender, 5 to 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

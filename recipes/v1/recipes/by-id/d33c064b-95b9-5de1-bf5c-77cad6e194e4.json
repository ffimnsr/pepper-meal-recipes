  "id": "d33c064b-95b9-5de1-bf5c-77cad6e194e4",
  "slug": "favorite-strawberry-rhubarb-pie",
  "name": "Favorite Strawberry Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This delicious strawberry rhubarb pie recipe only requires a handful of ingredients: pie crust, strawberries, rhubarb, sugar, tapioca, and lemon juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Place a pie dish onto a baking sheet."
    },
    {
      "position": 2,
      "text": "Mix strawberries, rhubarb, sugar, tapioca, and lemon juice together in a bowl, and let stand for 15 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Arrange a pie crust into a 9-inch pie dish; pour filling into the bottom crust. Scatter pieces of butter over filling; arrange top crust on pie."
    },
    {
      "position": 4,
      "text": "Press the edges together and crimp with a fork to seal."
    },
    {
      "position": 5,
      "text": "Cut several slits in the top crust with a sharp knife."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the crust is golden brown and the filling is bubbling, 40 to 55 minutes."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

  "id": "24f16394-4512-5ed1-a01b-726159f0851e",
  "slug": "oat-whole-wheat-bread",
  "name": "Oat Whole Wheat Bread",
  "recipe_type": "appetizer",
  "brief_description": "Rolled oats provide additional texture in this oat whole wheat bread recipe. This recipe requires only seven ingredients and makes two 8x4-inch loaves.",
  "cuisine": "American Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Warm milk in a small saucepan to no more than 100 degrees F (40 degrees C); sprinkle yeast over top. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes; stir in sugar."
    },
    {
      "position": 2,
      "text": "Whisk whole wheat flour, all-purpose flour, oatmeal, and salt together in a mixing bowl; make a well in the center. Pour milk mixture into well; stir until dough has pulled together. Turn dough out onto a lightly-floured surface; knead until smooth and elastic, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Place dough in a large lightly oiled bowl and turn to coat. Cover with a light cloth and let rise in a warm place (80 to 95 degrees F/27 to 35 degrees C) until doubled in volume, about 45 minutes. Meanwhile, grease two 8x4-inch loaf pans; set aside."
    },
    {
      "position": 4,
      "text": "Punch down dough to deflate and turn onto a lightly floured surface; divide into two equal pieces using a knife, don\u2019t tear it. Shape into balls and let rest for 10 minutes. Form dough into loaves and place into the prepared pans. Cover loaves with a damp cloth and let rise until doubled in volume, about 40 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top is golden brown and bottom of the loaf sounds hollow when tapped, 25 to 30 minutes. Cool in the pans for 5 minutes before turning out onto a wire rack to cool completely."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

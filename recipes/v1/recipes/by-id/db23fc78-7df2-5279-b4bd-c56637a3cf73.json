{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "db23fc78-7df2-5279-b4bd-c56637a3cf73",
  "slug": "empanadas-de-queso-con-rajas-poblano-chile-and-cheese-empanadas",
  "name": "Empanadas de Queso con Rajas (Poblano Chile and Cheese Empanadas)",
  "recipe_type": "appetizer",
  "brief_description": "Roasted poblano chile pepper and Manchego cheese fills these easy empanadas for a vegetarian lunch or dinner that's full of flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place poblano directly on the grates of a gas stove. Cook over medium heat, flipping with tongs occasionally, until blackened and charred, about 5 minutes. Place in a sealed plastic bag and allow to cool, 7 to 8 minutes. Peel off charred skins, remove seeds, and cut flesh into 1-inch squares."
    },
    {
      "position": 3,
      "text": "Place 1 1/2 tablespoons Manchego cheese onto each empanada disc. Top each with 1/2 tablespoon poblano peppers. Fold dough over on top of filling to close. Wet fingers with water and run them along the edges to help seal. Press edges together. Place empanadas on the prepared baking sheet and brush with beaten egg."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 24 to 26 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

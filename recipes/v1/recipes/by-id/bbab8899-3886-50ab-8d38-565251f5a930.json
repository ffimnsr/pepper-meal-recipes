  "id": "bbab8899-3886-50ab-8d38-565251f5a930",
  "slug": "chinese-popcorn-snack-mix",
  "name": "Chinese Popcorn Snack Mix",
  "recipe_type": "appetizer",
  "brief_description": "Jazz up your popcorn snack mix by adding some Chinese-inspired seasonings to give it a unique taste.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a large baking sheet with aluminum foil or parchment paper."
    },
    {
      "position": 2,
      "text": "Combine popcorn, chow mein noodles, and peanuts in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk butter, soy sauce, lime juice, sesame oil, Sriracha, and ginger together in a small bowl. Drizzle the butter mixture over the popcorn, tossing to evenly coat. Distribute evenly on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes, stirring halfway through. Remove baking sheet from oven. Set aside to cool before storing in an airtight container."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

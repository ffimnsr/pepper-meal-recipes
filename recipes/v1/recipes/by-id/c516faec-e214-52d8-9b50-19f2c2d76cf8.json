  "id": "c516faec-e214-52d8-9b50-19f2c2d76cf8",
  "slug": "yam-smoothie",
  "name": "Yam Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This smoothie is a favorite in my family and is quick and easy to make. You could also use a large can of yams in place of cooking the fresh ones.",
  "cuisine": "North American",
  "instructions": [
    {
      "position": 1,
      "text": "Prick yams with a fork, and place on a plate. Cook in the microwave for 8 to 10 minutes, turning once, until tender. Cool, peel and dice."
    },
    {
      "position": 2,
      "text": "Combine the yams, yogurt, milk, ice cubes, sugar and banana in the container of a blender. Blend until smooth."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

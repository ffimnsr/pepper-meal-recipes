  "id": "6ea35d2e-d318-5514-b62a-020e49eaf9e7",
  "slug": "sweet-chili-thai-sauce",
  "name": "Sweet Chili Thai Sauce",
  "recipe_type": "dessert",
  "brief_description": "This sweet chili sauce makes a great stir-fry sauce and savory dip for spring rolls. It's easy to make with sugar, vinegar, ginger, and chile peppers.",
  "cuisine": "Asian Inspired Asian Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour water and vinegar into a saucepan; bring to a boil over high heat. Stir in sugar, ginger, chile pepper, ketchup, and garlic; simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Place cornstarch in a small bowl; mix in water until smooth. Whisk cornstarch mixture into chili sauce."
    },
    {
      "position": 4,
      "text": "Remove the saucepan from the stove; let cool. Transfer to a bowl, cover, and refrigerate until needed."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "93ea27ff-e601-5abb-bdf8-10d300aba75c",
  "slug": "million-dollar-ravioli-casserole-recipe-8771580",
  "name": "Million Dollar Ravioli Casserole",
  "recipe_type": "main",
  "brief_description": "This million dollar ravioli casserole, like million dollar spaghetti, is a new level of cheesy, rich and indulgent. Made with frozen ravioli, shredded cheese, and jarred sauce, it\u2019s perfect for a busy weeknight because it\u2019s fast to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium high heat. Cook and stir sausage in the hot skillet until browned and crumbly, breaking up large pieces with a wooden spoon, 5 to 7 minutes. Drain fat from the skillet."
    },
    {
      "position": 3,
      "text": "Pour marinara sauce into the skillet, and stir to combine with sausage. Turn off heat."
    },
    {
      "position": 4,
      "text": "Stir cottage cheese, softened cream cheese, yogurt, Parmesan cheese, parsley, and granulated garlic together in a large bowl. Add cheese ravioli to the bowl and toss together until all ravioli are coated with cheese mixture."
    },
    {
      "position": 5,
      "text": "Spread the ravioli mixture evenly in the baking dish. Pour meat sauce over ravioli and spread evenly. Sprinkle mozzarella cheese evenly on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is golden brown, about 45 minutes. Remove from the oven; rest about 10 minutes before serving. Sprinkle with thinly sliced basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 10,
  "difficulty": "medium",

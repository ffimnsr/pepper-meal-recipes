  "id": "8fdda478-f8c0-5996-8504-f14889dd2793",
  "slug": "t-birds-beef-jerky",
  "name": "T Bird's Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "This is the very best jerky you have ever tasted, I've tried a lot of them, and this one's the best - you will reward me on this one! I use venison when available, but cheap round steak is great also, and it's all done in your oven.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cut meat into strips no thicker than 1/4 inch. In a large bowl, mix together onion powder, pepper, garlic powder, salt and Italian seasoning. Stir in Worcestershire sauce, soy sauce and pepper sauce. Place meat into a container, and combine with marinade. Cover, and refrigerate 24 hours."
    },
    {
      "position": 2,
      "text": "Place oven rack on the highest level. Place aluminum foil on bottom of oven to catch drips. Preheat oven to 150 degrees F (65 degrees C)."
    },
    {
      "position": 3,
      "text": "Insert round toothpicks through the tops of the strips of meat, and hang them from the oven rack. Bake in preheated oven for 4 hours, or until dried to desired consistency."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 30,

  "slug": "hash-brown-taco-casserole-recipe-12034935",
  "name": "Hash Brown Taco Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This stir-together spicy egg and potato bake cuts down on prep with the help of frozen shredded hash browns and frozen pepper and onion mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Generously coat a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together eggs, chili powder, salt, and cayenne (if using) in a large bowl. Stir in hash browns, tomatoes, bell pepper and onion blend, and jalape\u00f1o. Pour into the prepared dish. Top with cheese."
    },
    {
      "position": 3,
      "text": "Bake until heated through and eggs are set, 25 to 30 minutes. Serve with pico de gallo, sour cream, and/or lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

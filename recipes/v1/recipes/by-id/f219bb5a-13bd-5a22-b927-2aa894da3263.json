{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f219bb5a-13bd-5a22-b927-2aa894da3263",
  "slug": "jalapeno-popper-potato-skins-recipe-11808261",
  "name": "Jalapeno Popper Potato Skins",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's jalapeno popper potato skins bring together 2 iconic sports bar appetizer menu items\u2014potato skins and jalapeno poppers\u2014into a new sports party snack. For you potato fanatics who also love cheesy, spicy food, this may be the perfect choice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a sheet pan with foil."
    },
    {
      "position": 2,
      "text": "Prick potatoes all over with the tip of a knife. Coat potatoes all over with oil, and place on the prepared sheet pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until centers of potatoes are soft when pierced with a knife, about 1 hour. Let cool until just warm, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; chop when cool enough to handle, and set aside."
    },
    {
      "position": 5,
      "text": "Slice the large center parts of jalapenos into 36 thick rings, and remove the seeds. Dice remaining parts of peppers, and additional peppers as needed to make about 1/2 cup, or more if desired."
    },
    {
      "position": 6,
      "text": "Add cream cheese and diced jalapeno to a bowl. Set aside about 1/2 cup Cheddar cheese for sprinkling on top of poppers, and add remaining cheese to the bowl. Mix well and set aside."
    },
    {
      "position": 7,
      "text": "Lay each potato down on its widest, flattest side on a cutting board, and cut in half lengthwise. Scoop out cooked potato into a bowl, leaving about 1/8-inch of cooked potato attached to the skin."
    },
    {
      "position": 8,
      "text": "Line a sheet pan with foil and coat with oil. Transfer scooped potato skins onto the sheet and season each one with salt. Divide cheese filling between the 12 potato skins, and spread out with a spoon."
    },
    {
      "position": 9,
      "text": "Top cheese filling with bacon, and then place 3 jalapeno rings on top of each skin. Scatter reserved cheese over the top."
    },
    {
      "position": 10,
      "text": "Increase the oven temperature to 475 degrees F (245 degrees C)."
    },
    {
      "position": 11,
      "text": "Bake in the preheated oven until the cheese is bubbling, and the edges of the potatoes are crispy, 25 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 30,

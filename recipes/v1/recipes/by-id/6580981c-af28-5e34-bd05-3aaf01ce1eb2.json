  "id": "6580981c-af28-5e34-bd05-3aaf01ce1eb2",
  "slug": "stove-top-pot-roast",
  "name": "Stove Top Pot Roast",
  "recipe_type": "main",
  "brief_description": "Learn how to cook pot roast with this simple and savory stovetop pot roast that's braised until fall-apart tender with turnips, carrots, and potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot or Dutch oven over medium-high heat; add roast and quickly brown on all sides."
    },
    {
      "position": 2,
      "text": "Add enough water to the pot to cover roast; add celery, garlic, onion, basil, salt, and pepper. Bring to a boil; reduce heat to low and simmer for 2 hours and 15 minutes, adding additional water if needed to keep the roast covered."
    },
    {
      "position": 3,
      "text": "Add turnips and potatoes; simmer for an additional 15 minutes."
    },
    {
      "position": 4,
      "text": "Add carrots; simmer for 30 minutes, or until roast can be pulled apart with a fork."
    },
    {
      "position": 5,
      "text": "Season to taste with salt and pepper if needed before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 15,

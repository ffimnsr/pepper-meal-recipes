  "id": "0b60e9ff-e2d6-59b5-98a7-2412f43837b7",
  "slug": "best-ever-chocolate-free-blondies",
  "name": "Best Ever Chocolate-Free Blondies",
  "recipe_type": "dessert",
  "brief_description": "These are the absolute favorite dessert of my boyfriend and all his friends. No tailgate, party or even dinner is complete without these gooey, peanut butter blondies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. Sift together the flour, baking powder, baking soda, salt and cinnamon (if desired); set aside."
    },
    {
      "position": 2,
      "text": "In a large saucepan over low heat, melt butter. Stir in the brown sugar until dissolved and remove from heat. Allow the mixture to cool. Beat eggs into the mixture one at a time then stir in the vanilla. Mix in the sifted ingredients one third at a time, mixing just enough to blend. Fold in peanut butter chips and pecans. Spread the batter evenly into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake for 30 to 35 minutes in the preheated oven for chewy blondies, or 35 to 40 minutes for drier, firmer blondies. When done, you can either let them cool and cut into squares for serving, or you can scoop out a hot blondie and cover with vanilla ice cream for a real treat."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

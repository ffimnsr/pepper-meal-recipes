{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "791e0ba5-468e-53ab-98b9-e4765a3022c1",
  "slug": "shrimp-sausage-and-fish-jambalaya",
  "name": "Shrimp, Sausage, and Fish Jambalaya",
  "recipe_type": "soup",
  "brief_description": "This seafood jambalaya combines shrimp, cod fillets, and andouille sausage in a well-seasoned rice and tomato mixture for one pot of deliciousness.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a heavy-bottomed pot over medium-high heat. Cook andouille sausage in the melted butter until completely browned, about 5 minutes. Remove the sausage with a slotted spoon to a plate lined with paper towel."
    },
    {
      "position": 2,
      "text": "Add onion, celery, and green bell pepper to the butter remaining in the pot; cook and stir until onion becomes translucent, 5 to 10 minutes. Add garlic; cook and stir together for 1 minute. Stir in tomato paste; cook and stir another 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Return andouille sausage to the pot along with diced tomatoes, Worcestershire sauce, Cajun seasoning, and black pepper; stir to combine. Pour chicken broth over the sausage mixture; bring to a boil."
    },
    {
      "position": 4,
      "text": "Stir in rice; reduce heat to medium-low, cover, and cook until rice is tender, 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Add shrimp and cod; increase heat to medium-high and bring to a boil. Reduce heat again to medium-low and cook uncovered for another 10 minutes, stirring occasionally."
    },
    {
      "position": 6,
      "text": "Season with salt and fold parsley into the jambalaya to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

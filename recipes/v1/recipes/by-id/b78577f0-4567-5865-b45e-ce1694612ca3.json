  "schema_version": 1,
  "id": "b78577f0-4567-5865-b45e-ce1694612ca3",
  "slug": "corn-fritters-with-whipped-sweet-potato-butter-recipe-12059498",
  "name": "Corn Fritters with Whipped Sweet Potato Butter",
  "recipe_type": "appetizer",
  "brief_description": "This Corn Fritters with Whipped Sweet Potato Butter recipe celebrates fresh sweet corn season with a little taste of fall. Charred corn fritters pair with creamy, whipped sweet potato butter for a sweet and savory combination you\u2019ll want to make all season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk cornmeal, flour, baking powder, black pepper, and chili together in a large bowl. In a separate bowl, whisk eggs, melted butter, and cottage cheese together. Pour egg mixture into cornmeal mixture and stir until combined. Fold in charred corn, green onion, and cilantro."
    },
    {
      "position": 2,
      "text": "Check the consistency of the batter. It should be moist, scoopable, and hold its shape. If it is too dry, add some cream or milk to loosen it up. Set the batter aside while you prepare the sweet potato butter."
    },
    {
      "position": 3,
      "text": "For sweet potato butter, whip the butter in a food processor and add in the mashed sweet potatoes. Mix to combine. Season with salt and pepper, Pour the mixture into a bowl and stir in cilantro, hot honey, orange zest, salt and pepper. Enjoy!"
    },
    {
      "position": 4,
      "text": "Pour enough oil to generously coat the bottom of a large nonstick pan. Heat the oil to medium-high. Using a 2-ounce ice cream scoop, portion the batter into the hot oil. Cook on one side until it is golden. Turn over and press down slightly. Turn again and fry until crisp on both sides. You may have to work in batches. Repeat with remaining fritter batter."
    },
    {
      "position": 5,
      "text": "Serve the warm corn fritters with a generous bowl of Whipped Sweet Potato Butter for dipping. Finish with one last drizzle of hot honey. Maldon salt, and a sprinkle of fresh chives. Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

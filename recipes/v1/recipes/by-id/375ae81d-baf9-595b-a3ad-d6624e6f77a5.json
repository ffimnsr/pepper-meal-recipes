  "id": "375ae81d-baf9-595b-a3ad-d6624e6f77a5",
  "slug": "easy-vegetarian-stuffed-mushrooms",
  "name": "Easy Vegetarian Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These vegetarian stuffed mushrooms are quick and easy to make. You only need a handful of ingredients and your guests will love them.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1 tablespoon butter in a skillet over medium heat. Add mushroom caps and saute until soft and browned, about 2 1/2 minutes per side. Transfer to a baking dish."
    },
    {
      "position": 3,
      "text": "Add diced mushroom stems to the same skillet, adding more butter if needed. Saute until mushrooms have softened, about 3 minutes. Transfer to a bowl along with any pan juices. Add cream cheese, green onions, and chives and mix while still hot. Stuff mixture into the mushroom caps until they are full."
    },
    {
      "position": 4,
      "text": "Melt remaining tablespoon butter in a skillet. Add bread crumbs and toss until well coated. Top each mushroom cap with a layer of the buttered crumbs."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops are browned and crispy, about 9 minutes. Remove and let cool for about 3 minutes before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

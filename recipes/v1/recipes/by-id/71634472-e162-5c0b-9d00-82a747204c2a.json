{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "71634472-e162-5c0b-9d00-82a747204c2a",
  "slug": "gorgonzola-and-wild-mushroom-risotto",
  "name": "Creamy Wild Mushroom Risotto",
  "recipe_type": "main",
  "brief_description": "Wild mushroom risotto with dried chanterelles, fresh mushrooms, garlic, white wine, and truffle oil; top with Gorgonzola for a rich and creamy main dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cover chanterelle mushrooms with hot water, cover, and set aside to soften for 30 minutes. Once soft, remove mushrooms from water and chop; discard water."
    },
    {
      "position": 2,
      "text": "Melt butter along with truffle oil in a large saucepan over medium-high heat. Add onion, shallot, and garlic; cook and stir two minutes until the onion begins to soften. Add fresh mushrooms; continue cooking until mushroom softens and begin to release their liquid. Stir in chopped chanterelle mushrooms, and cook 3 minutes more."
    },
    {
      "position": 3,
      "text": "Add Arborio rice; cook and stir for a few minutes until rice looks glossy and is well coated with onion mixture. Stir in white wine and cook until nearly evaporated."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium; add 1/3 of the hot chicken stock. Cook and stir until chicken stock has been mostly absorbed, about 5 minutes. The risotto should be simmering gently while you stir in chicken stock. Add 1/2 of the remaining stock, and stir for 5 minutes more. Finally add remaining stock, and continue cooking until risotto is creamy and rice is tender, about 5 minutes more. The rice should not be completely soft, but still have a little firmness when you bite into it. You can add a little water if needed to cook the rice to this state."
    },
    {
      "position": 5,
      "text": "Remove risotto from the heat, and stir in heavy cream and Gorgonzola cheese. Season to taste with salt and pepper, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

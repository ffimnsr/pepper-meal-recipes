  "id": "b25af497-1706-529c-804a-a4c5941e7d8d",
  "slug": "salsa-verde-chicken-and-rice-skillet-recipe-11814167",
  "name": "Salsa Verde Chicken and Rice Skillet",
  "recipe_type": "main",
  "brief_description": "This salsa verde chicken and rice skillet combines southwestern flavors with leftover cooked chicken, rice, and vegetables, a one-pot meal that's convenient, especially at cleanup time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chili powder, cumin, coriander, oregano, cayenne, salt, and black pepper in a small bowl and set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large, nonstick skillet over medium heat until oil shimmers. Add onion and cook until translucent, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Season onions with dry spice mixture, stirring well. Add garlic and rice, stirring until rice is coated with seasonings and oil, and the mix is fragrant, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Add broth, salsa verde, and green chilies, and bring to a boil. Cover, reduce heat, and simmer for 12 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Stir in corn, black beans, and chicken. Return the cover, and continue cooking until rice is tender, and all liquid is absorbed, about 5 minutes more. Remove from heat."
    },
    {
      "position": 6,
      "text": "Stir in juice of 1/2 lime. Sprinkle with Monterrey Jack. Garnish with chopped cilantro, lime slices, and avocado slices, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

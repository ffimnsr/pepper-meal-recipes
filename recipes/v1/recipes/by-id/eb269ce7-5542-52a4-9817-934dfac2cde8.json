  "id": "eb269ce7-5542-52a4-9817-934dfac2cde8",
  "slug": "pickled-cucumbers-recipe-8698400",
  "name": "Pickled Cucumbers",
  "recipe_type": "side",
  "brief_description": "For these quick pickled cucumbers, 2 main ingredients and some brine is all you need to have fresh pickles in a day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Divide cucumber slices and green onions between 2 1-quart jars."
    },
    {
      "position": 2,
      "text": "Bring vinegar, water, salt, pickling spice, bay leaves, and peppercorns to a boil in a saucepan; boil for 10 minutes. Remove from heat to cool for 30 minutes."
    },
    {
      "position": 3,
      "text": "Pour brine over cucumbers. Cover and refrigerate for a minimum of 8 hours, or 24 hours for best results."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

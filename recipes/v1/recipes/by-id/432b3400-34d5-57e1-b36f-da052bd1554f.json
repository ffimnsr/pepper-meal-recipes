  "name": "Peanut Butter Strawberry Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This simple peanut butter strawberry smoothie pairs strawberries and peanut butter with yogurt and milk. The recipe yields one smoothie in 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries, yogurt, milk, peanut butter, and brown sugar together in a blender; blend for 2 minutes then rest for 10 seconds. Blend until smooth, 2 minutes more."
    }

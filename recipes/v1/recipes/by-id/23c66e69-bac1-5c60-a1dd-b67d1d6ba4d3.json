  "id": "23c66e69-bac1-5c60-a1dd-b67d1d6ba4d3",
  "slug": "slow-roasted-winter-vegetables",
  "name": "Slow-Roasted Winter Vegetables",
  "recipe_type": "dessert",
  "brief_description": "Perfect for using up winter vegetables like yams, sweet potatoes, and parsnips, this slow-roasted recipe is easy and makes enough to feed a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butternut squash, yams, sweet potatoes, parsnips, carrots, turnip, mushrooms, shallots, and garlic in a large bowl. Add rosemary, salt, and pepper. Toss until evenly mixed, then add oil and toss until coated. Pour into large baking pans so that the vegetables are no more than 1 1/2 inches deep."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, tossing and scraping the bottom every 30 minutes, until vegetables are very tender, at least 90 minutes; longer is better."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "expert",

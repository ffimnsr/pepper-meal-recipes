  "id": "7affc5bf-7c97-55bb-98ce-fbbee5e77739",
  "slug": "white-chip-chocolate-cookies",
  "name": "White Chip Chocolate Cookies",
  "recipe_type": "dessert",
  "brief_description": "This white chocolate chip cookie recipe is quick and easy to make. It produces a large batch of chocolaty cookies studded with sweet milky morsels.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Add eggs, one at a time, beating well after each addition. Stir in vanilla."
    },
    {
      "position": 4,
      "text": "Combine flour, cocoa, baking soda, and salt in a bowl. Stir into the creamed mixture."
    },
    {
      "position": 5,
      "text": "Fold in white chocolate chips."
    },
    {
      "position": 6,
      "text": "Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until set, 8 to 10 minutes. Remove from the oven, let cool on the baking sheets for 5 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 54,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

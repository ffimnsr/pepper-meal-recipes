  "id": "8c03850f-98a1-5b89-a79a-d177b5e45156",
  "slug": "butter-cookies-ii",
  "name": "Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This simple butter cookie recipe can be made as a drop cookie, used in a cookie press, or shaped into a roll and sliced. Perfect for baking with kids!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter and sugar together in a large bowl with an electric mixer until light and fluffy. Beat in egg, then stir in the vanilla. Combine flour and salt in a separate bowl; add to butter mixture and mix to form a dough. Cover dough with plastic wrap and chill for at least one hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Chill two cookie sheets."
    },
    {
      "position": 3,
      "text": "Transfer chilled dough to a cookie press; press out onto chilled cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly golden at the edges, about 8 to 10 minutes. Transfer cookies to wire racks to cool."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "slug": "waldorf-salad-with-walnut-oil-vinaigrette",
  "name": "Waldorf Salad with Walnut Oil Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "A wonderful light Waldorf Salad without mayo. The flavors of the apples, walnuts, and raisins are so clean and fresh. It never fails to please.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss together apples, celery, walnuts, and raisins in a large bowl; set aside."
    },
    {
      "position": 2,
      "text": "Whisk together walnut oil, cider vinegar, salt, and pepper in a small bowl."
    },
    {
      "position": 3,
      "text": "Toss apples with dressing to serve."
    }
  ],
  "servings": 4,

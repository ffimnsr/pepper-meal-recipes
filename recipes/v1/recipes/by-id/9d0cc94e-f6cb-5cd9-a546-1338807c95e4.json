  "id": "9d0cc94e-f6cb-5cd9-a546-1338807c95e4",
  "slug": "artichoke-cheese-dip",
  "name": "Artichoke Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "A wonderful, rich appetizer, that is extremely delicious with toasted French Bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the mayonnaise, Cheddar cheese, Jack cheese, onion salt, dill weed, lemon pepper and artichoke hearts. Mix well and pour into a 2 quart baking dish."
    },
    {
      "position": 3,
      "text": "Bake uncovered for 30 minutes. Serve with toasted French bread or garlic bread."
    }
  ],
  "servings": 6,

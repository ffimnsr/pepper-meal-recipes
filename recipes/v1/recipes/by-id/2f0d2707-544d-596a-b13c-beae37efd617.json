  "id": "2f0d2707-544d-596a-b13c-beae37efd617",
  "slug": "wonton-wrappers",
  "name": "Wonton Wrappers",
  "recipe_type": "side",
  "brief_description": "Make wonton wrappers from scratch with this homemade step-by-step recipe to create tasty little dumplings stuffed with your favorite fillings.",
  "cuisine": "Asian Inspired Asian Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat egg in a medium bowl. Mix in 1/3 cup water."
    },
    {
      "position": 3,
      "text": "Combine flour and salt in a large bowl. Create a well in the center of the flour mixture and slowly pour in egg and water."
    },
    {
      "position": 4,
      "text": "Mix well. If the mixture is too dry, increase the amount of water 1 teaspoon at a time until a pliable dough has formed."
    },
    {
      "position": 5,
      "text": "Knead dough on a lightly floured surface until elastic."
    },
    {
      "position": 6,
      "text": "Cut dough into two separate balls. Cover dough balls with a damp cloth for a minimum of 10 minutes."
    },
    {
      "position": 7,
      "text": "Cut each ball into four equal pieces."
    },
    {
      "position": 8,
      "text": "Roll the pieces into 10 \u00bd x 10 \u00bd-inch squares. Then cut each square into nine 3 \u00bd x 3 \u00bd-inch squares for a total of 72 wonton wrappers. Use in any wonton recipe."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

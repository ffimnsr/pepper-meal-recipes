  "id": "7b075013-a1cc-56c7-971a-7f236824620f",
  "slug": "copycat-v8-juice",
  "name": "Copycat V8 Juice",
  "recipe_type": "drink",
  "brief_description": "This V8 drink recipe is made with tomatoes, celery, onion, bell pepper, beet, carrot, and garlic juice flavored with Worcestershire and horseradish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Process tomatoes, onion, 3 tablespoons plus 1/2 teaspoon celery, carrot, beet, green bell pepper, and garlic through a juicer."
    },
    {
      "position": 3,
      "text": "Stir together vegetable juices, water, lemon juice, 1 1/4 teaspoons sugar, horseradish, Worcestershire sauce, and black pepper in a large pot. Bring to a boil and cook until flavors blend, about 20 minutes. Meanwhile, sterilize the jar and lid in boiling water for at least 5 minutes."
    },
    {
      "position": 4,
      "text": "Ladle juice into the jar. Stir 1 tablespoon sugar and salt into juice. Wipe the rim of the jar with a moist paper towel to remove any residue. Top with the lid and screw on the ring."
    },
    {
      "position": 5,
      "text": "Process juice in a pressure canner at 10 pounds of pressure for 35 minutes."
    },
    {
      "position": 6,
      "text": "Remove the jar from the pressure canner and place onto a cloth-covered or wooden surface until cool. Press the center of the lid with a finger to ensure the lid does not move up or down. Remove the ring for storage and store in a cool, dark area."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "3-ingredient-sausage-biscuits-recipe-11708055",
  "name": "3 Ingredient Sausage Biscuits",
  "recipe_type": "dessert",
  "brief_description": "This 3 ingredient sausage biscuit recipe is extremely versatile and can be made sweet or savory by adding either jelly, eggs, or cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Split each biscuit into two thinner biscuit halves. Place a sausage patty on one half of each biscuit and top with 1 tablespoon grape jelly or filling of choice. Place remaining biscuit halves on top and press the edges together to seal the biscuit."
    },
    {
      "position": 3,
      "text": "Place onto the prepared baking sheet and bake until golden brown, 10 to 12 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

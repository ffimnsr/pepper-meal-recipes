  "id": "dd5c1a2b-69bb-5d6b-9c66-ba9ea03563f3",
  "slug": "bubbas-jambalaya",
  "name": "Bubba\u2019s Jambalaya",
  "recipe_type": "soup",
  "brief_description": "Easy Southern classic, with chicken, sausage, ham, and shrimp.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large pot over medium-high heat. Add bacon, and cook until crisp. Remove bacon pieces with a slotted spoon, and set aside. Add celery, bell pepper, and onion to the bacon drippings, and cook until tender."
    },
    {
      "position": 2,
      "text": "Add the ham, chicken and sausage to the pot, and pour in the tomatoes, beef broth and chicken broth. Season with thyme and Cajun seasoning. Bring to a boil, and add the rice. Bring to a boil, then turn the heat to low, cover, and simmer for about 20 minutes, until the rice is tender."
    },
    {
      "position": 3,
      "text": "Stir in the shrimp and bacon just before serving, and heat through. If you use uncooked shrimp, let it cook for about 5 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

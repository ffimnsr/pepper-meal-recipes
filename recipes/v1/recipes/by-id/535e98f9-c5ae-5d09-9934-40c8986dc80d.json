  "id": "535e98f9-c5ae-5d09-9934-40c8986dc80d",
  "slug": "lentil-ham-soup",
  "name": "Lentil Ham Soup",
  "recipe_type": "soup",
  "brief_description": "This rich lentil soup with ham recipe is quick and easy to prepare. Mustard, garlic, and a splash of red wine vinegar add a delicious boost of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Stir chicken broth, water, carrots, celery, onion, lentils, garlic, and red wine vinegar together in a large stockpot; bring to a boil, reduce heat to low, and simmer until carrots are tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in ham, mustard, salt, and pepper; simmer until lentils are tender, 20 to 30 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

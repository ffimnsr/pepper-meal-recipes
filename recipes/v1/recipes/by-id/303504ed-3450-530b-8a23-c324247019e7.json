  "id": "303504ed-3450-530b-8a23-c324247019e7",
  "slug": "spanish-potato-omelet",
  "name": "Spanish Omelette",
  "recipe_type": "appetizer",
  "brief_description": "A Spanish omelette, also known as a Spanish tortilla, is a delicious classic tapas dish made with eggs, crispy fried sliced potatoes, and onions.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil over medium-high heat in a large skillet. Add potatoes and season lightly with salt and pepper; cook, stirring occasionally, until golden brown and crisp, 10 to 14 minutes. Add onions; cook and stir until soft and beginning to brown, 6 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Whisk eggs in a bowl; season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Pour eggs into the skillet and stir gently to combine with potatoes and onion. Reduce the heat to low and cook until eggs begin to brown on the bottom, 4 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Loosen omelette with a spatula. Invert a large plate over the pan, and carefully flip omelette out onto the plate. Slide omelette, uncooked-side down, back into the pan. Cook until eggs are set, 4 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Serve warm, garnished with tomato and green onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "375ee838-b66d-56d7-8bd9-a27ec583b882",
  "slug": "oven-baked-garlic-and-parmesan-fries",
  "name": "Oven-Baked Garlic and Parmesan Fries",
  "recipe_type": "side",
  "brief_description": "Homemade garlic Parmesan fries are made with russet potatoes tossed with thyme and parsley and baked in the oven until crisp, cheesy, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large bowl and drizzle with olive oil. Season with garlic, thyme, and 1/4 teaspoon seasoned salt; toss until are evenly coated. Lift fries out of the bowl and spread evenly onto a nonstick baking sheet. Save remaining oil in the bowl."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes, flipping fries halfway. Return fries to the bowl with olive oil. Sprinkle with 1/2 cup Parmesan cheese and parsley; toss to coat. Spread again onto the baking sheet."
    },
    {
      "position": 4,
      "text": "Continue baking until cheese melts, about 10 minutes. Sprinkle with remaining 1/4 cup Parmesan cheese and 1/4 teaspoon seasoned salt to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5abf78b0-a29a-5de6-b116-5b33c2a5dc24",
  "slug": "mock-chocolate-cookie-crust",
  "name": "Mock Chocolate Cookie Crust",
  "recipe_type": "dessert",
  "brief_description": "You don't need to buy a package of chocolate sandwich creme cookies to make a yummy chocolate pie crust. Just use 5 simple pantry ingredients to mix up your own in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk sugar, flour, cocoa powder, and salt together in a bowl until thoroughly combined. Pour melted butter into the mixture and stir to incorporate. Press dough into the bottom and up the sides of a 9-inch pie pan."
    },
    {
      "position": 3,
      "text": "Bake crust in preheated oven until the sides are firm and the bottom bubbles slightly, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "cc1e752b-d6c8-5b60-b44c-285de18ac6bd",
  "slug": "quick-and-super-easy-chicken-and-dumplings",
  "name": "Quick and Super Easy Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "This is a great canned chicken and dumplings recipe for Southern-style chicken and dumplings. It's easy for the kids to help make, too.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together biscuit mix and milk in a medium bowl until dough comes together; set aside."
    },
    {
      "position": 2,
      "text": "Pour cans of chicken broth into a saucepan along with chicken; bring to a boil."
    },
    {
      "position": 3,
      "text": "Take a handful of biscuit dough and flatten it in your hand. Tear off 1- to 2-inch pieces and drop them into boiling broth. Make sure they are fully immersed, at least for a moment. Repeat this step with remaining biscuit dough, then carefully stir soup, so dumplings are covered by broth."
    },
    {
      "position": 4,
      "text": "Cover and simmer, stirring occasionally, over medium heat until dumplings are cooked through, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

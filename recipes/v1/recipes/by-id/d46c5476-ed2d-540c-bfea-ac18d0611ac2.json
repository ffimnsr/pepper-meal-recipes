  "id": "d46c5476-ed2d-540c-bfea-ac18d0611ac2",
  "slug": "perfect-bbq-baked-beans",
  "name": "Perfect BBQ Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "These hearty BBQ baked beans with ground beef, molasses, barbeque sauce, mustard, and cayenne have a sweet and smoky taste you\u2019ll love!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook ground beef, onion, and mesquite seasoning in a large skillet over medium heat until beef is no longer pink, breaking it up into crumbles as it cooks, about 10 minutes. Drain excess grease; transfer beef into a large baking dish."
    },
    {
      "position": 3,
      "text": "Stir in baked beans, molasses, brown sugar, barbeque sauce, dry mustard powder, and cayenne pepper until any small lumps of brown sugar have dissolved."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until beans are bubbling and the flavors have blended, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

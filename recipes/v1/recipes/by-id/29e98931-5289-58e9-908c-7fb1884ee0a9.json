  "id": "29e98931-5289-58e9-908c-7fb1884ee0a9",
  "slug": "parmesan-black-pepper-arborio-rice-pilaf",
  "name": "Parmesan-Black Pepper Arborio Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "A creamy rice pilaf made with arborio rice, Parmesan cheese, and plenty of freshly ground black pepper is a perfect accompaniment for a spring meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter and oil in a large saucepan over medium-high heat. Add onion; saute until softened, 3 to 4 minutes. Add rice; stir to coat. (Can turn off heat and let stand several hours.)"
    },
    {
      "position": 2,
      "text": "Add broth, cover, and bring to a simmer. Reduce heat to low and simmer, stirring occasionally, until stock is absorbed and rice is creamy and soft with a little \u201cchew\u201d at the center, about 12 minutes. Stir in cheese and pepper; add salt, if necessary. Serve hot."
    }
  ],
  "servings": 8,

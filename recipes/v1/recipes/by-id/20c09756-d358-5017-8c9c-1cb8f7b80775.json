  "id": "20c09756-d358-5017-8c9c-1cb8f7b80775",
  "slug": "lauras-famous-aebleskiver",
  "name": "Laura's Famous Aebleskiver",
  "recipe_type": "dessert",
  "brief_description": "This traditional Danish breakfast treat made in an Aebleskiver pan is a cross between a pancake and a popover. Sprinkle with confectioners' sugar or drizzle with maple syrup.",
  "cuisine": "Danish",
  "instructions": [
    {
      "position": 1,
      "text": "Sift together flour, salt, and baking soda in a large bowl. Add buttermilk and egg yolks; stir until batter is smooth."
    },
    {
      "position": 2,
      "text": "Whip egg whites in a separate large glass or metal mixing bowl until soft peaks form. Lift your beater or whisk straight up: egg whites will form soft mounds rather than a sharp peak. Fold whipped egg whites into batter until incorporated."
    },
    {
      "position": 3,
      "text": "Place an Aebleskiver pan over medium heat; grease each cup with cooking spray. Pour batter into each prepared cup to about 2/3 full. Cook until golden brown on each side, using a toothpick to flip, 1 to 2 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "d6724621-74f2-57e5-ad8e-a7a595af68a8",
  "slug": "vegetarian-bibimbap",
  "name": "Vegetarian Bibimbap",
  "recipe_type": "main",
  "brief_description": "This bibimbap recipe is a vegetarian version of the classic Korean rice bowl with warm white rice and tender mixed veggies, topped with a fried egg.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat sesame oil in a large skillet over medium heat; cook and stir carrot and zucchini in the hot oil until vegetables begin to soften, about 5 minutes. Stir in bean sprouts, bamboo shoots, and mushrooms. Cook and stir until carrots are tender, about 5 more minutes. Season to taste with salt; transfer vegetable mixture to a plate."
    },
    {
      "position": 2,
      "text": "Stir cooked rice, green onions, soy sauce, and black pepper in the same skillet until the rice is hot."
    },
    {
      "position": 3,
      "text": "In a separate skillet over medium heat, melt butter and gently fry eggs, turning once, until the yolks are still slightly runny but the egg whites are firm, about 3 minutes per egg."
    },
    {
      "position": 4,
      "text": "To serve, divide hot cooked rice mixture between 3 serving bowls and top each bowl with 1/3 of the vegetable mixture and a fried egg. Serve with sweet red chili sauce."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "41fd3dda-c4c5-551c-8372-f6e9ee09435c",
  "slug": "sweet-potato-hummus",
  "name": "Sweet Potato \"Hummus\"",
  "recipe_type": "appetizer",
  "brief_description": "Sweet potatoes prove a worthy alternative to chickpeas in Chef John's new spin on hummus starring the usual tahini, garlic, lemon, and olive oil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Scoop sweet potato flesh into a bowl. Let cool to room temperature."
    },
    {
      "position": 2,
      "text": "Add tahini and garlic to the sweet potatoes. Season with salt, cumin, chipotle, and cayenne. Drizzle in 1 tablespoon olive oil and lemon juice. Mash until hummus reaches desired smoothness. Add water to lighten the texture; whisk in 1 tablespoon at a time."
    },
    {
      "position": 3,
      "text": "Cover with plastic wrap and refrigerate for at least 2 hours."
    },
    {
      "position": 4,
      "text": "Taste and adjust seasonings as desired. Transfer hummus to a serving bowl. Drizzle remaining olive oil, Aleppo pepper, and parsley over the top."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

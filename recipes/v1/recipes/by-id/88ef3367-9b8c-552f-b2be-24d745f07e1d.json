  "id": "88ef3367-9b8c-552f-b2be-24d745f07e1d",
  "slug": "carrot-ribbon-salad-recipe-11699252",
  "name": "Carrot Ribbon Salad",
  "recipe_type": "salad",
  "brief_description": "This carrot ribbon salad, with a tangy dressing and bacon, is quick to shake together in a jar, and the ribbon-cut carrots make a beautiful presentation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together mayonnaise, sugar, vinegar, and salt in a 1-quart container with a lid."
    },
    {
      "position": 3,
      "text": "Add carrots, bacon, shallots, cranberries, pecan pieces, and parsley; cover and shake until carrots are evenly coated in mayonnaise mixture."
    },
    {
      "position": 4,
      "text": "Transfer to a serving bowl and garnish with parsley. Recipe developed by Amanda Holstein and tested by Giovanna Vazquez."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

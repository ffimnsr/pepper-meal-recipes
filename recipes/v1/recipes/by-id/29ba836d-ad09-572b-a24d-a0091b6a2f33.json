  "id": "29ba836d-ad09-572b-a24d-a0091b6a2f33",
  "slug": "spinach-and-mushroom-frittata",
  "name": "Spinach and Mushroom Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Looking for a vegetable with super health powers? Try spinach. It's packed with vitamins, minerals and antioxidants that can help protect you all your life.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together all ingredients until well mixed. Spray a 9-inch pie plate with cooking spray and fill it with spinach mixture."
    },
    {
      "position": 3,
      "text": "Bake for 30 minutes, or until browned and set. Let cool for 20 minutes, cut in wedges, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

  "id": "72b4d1a0-3b11-519b-9a42-b5b7197b6e42",
  "slug": "scotch-shortbread",
  "name": "The Best Scottish Shortbread",
  "recipe_type": "dessert",
  "brief_description": "This traditional shortbread cookie recipe is made with just three ingredients for a rich, buttery homemade holiday treat that melts in your mouth.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, butter, and 1/2 cup sugar in a bowl until well combined and the dough holds together."
    },
    {
      "position": 3,
      "text": "Press dough into an ungreased 11\u00bdx7\u00bd-inch jelly roll pan until evenly spread. Prick dough all over with a fork to prevent puffing while it bakes. Sprinkle sugar over the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are light golden brown, 20 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Cut shortbread into squares in the pan while still warm. Cool completely before removing squares from the pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

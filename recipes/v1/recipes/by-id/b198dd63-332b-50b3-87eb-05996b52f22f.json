  "id": "b198dd63-332b-50b3-87eb-05996b52f22f",
  "slug": "chicken-pot-pie-ix",
  "name": "Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "A delicious, homemade chicken pot pie made from scratch with carrots, peas, and celery. This comfort food classic will be a hit with your family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine chicken, carrots, peas, and celery in a saucepan; add water to cover. Bring to a boil; boil for 15 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a separate saucepan over medium heat. Add onion; cook until soft and translucent, 5 to 7 minutes. Stir in flour, salt, black pepper, and celery seeds."
    },
    {
      "position": 4,
      "text": "Slowly stir in chicken broth and milk."
    },
    {
      "position": 5,
      "text": "Reduce heat to medium-low; simmer until thick, 5 to 10 minutes. Set aside off heat."
    },
    {
      "position": 6,
      "text": "Place 1 crust in a 9-inch pie plate; add chicken and vegetables to the crust. Pour hot broth mixture over top."
    },
    {
      "position": 7,
      "text": "Cover pie with top crust, seal the edges, and trim any excess dough. Make several small slits in top crust to allow steam to escape."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until pastry is golden brown and filling is bubbly, 30 to 35 minutes. Cool for 10 minutes before serving."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

  "id": "30c974d0-a626-5969-b282-f225b7f57e80",
  "slug": "baked-cream-cheese-jalapeno-poppers",
  "name": "Baked Cream Cheese Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "Cream cheese jalape\u00f1o poppers that taste just like the ones you\u2019d get at a restaurant! The creamy, taco-seasoned filling is a nice contrast to the peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with foil or parchment paper."
    },
    {
      "position": 2,
      "text": "Blend cream cheese, Cheddar cheese, and seasoning mix together in a bowl. Spread mixture into jalape\u00f1o halves and arrange onto the prepared baking sheet. Sprinkle bread crumbs over cheese filling."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until peppers are just tender, 20 to 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

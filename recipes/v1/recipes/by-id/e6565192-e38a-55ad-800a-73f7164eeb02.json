  "id": "e6565192-e38a-55ad-800a-73f7164eeb02",
  "slug": "hillshire-farm-litl-smokies-and-brie-fondue",
  "name": "Hillshire Farm Lit'l Smokies and Brie Fondue",
  "recipe_type": "appetizer",
  "brief_description": "This easy party dip is creamy, smoky and perfect for a crowd of foodies ready to snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Chop 8 Lit'l Smokies smoked sausages and reserve the rest. In a saucepan over medium-high heat, heat chopped smoked sausages in olive oil with garlic until just browned."
    },
    {
      "position": 2,
      "text": "Add white wine and milk. In a separate bowl, toss the brie and Cheddar cheeses with flour, thoroughly coat. Slowly whisk cheese mixture into the saucepan. Continue to whisk until smooth and thick, about 5 minutes. Remove from heat and season with salt, pepper and nutmeg."
    },
    {
      "position": 3,
      "text": "Saute the remaining smoked sausages in a skillet until browned. Serve warm fondue with Lit'l Smokies smoked sausages, apple slices and toasted baguette. Drizzle fondue and apples with honey."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,

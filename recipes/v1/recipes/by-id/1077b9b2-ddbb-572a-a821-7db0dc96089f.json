  "slug": "air-fryer-stuffed-mini-peppers-recipe-7507354",
  "name": "Air Fryer Stuffed Mini Peppers",
  "recipe_type": "appetizer",
  "brief_description": "These air fried stuffed mini pepper appetizers are ready in less than 15 minutes and require just three ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C). Cut each pepper in half lengthwise, and remove seeds and stem."
    },
    {
      "position": 2,
      "text": "Slice prosciutto into pieces the size of pepper halves, and lay one piece in each pepper half. Spread 1 tablespoon cheese into each pepper half. If prosciutto hangs over pepper sides, fold it upward to cover cheese."
    },
    {
      "position": 3,
      "text": "Air fry until cheese is very warm and soft, about 5 minutes. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "fbc3986f-44f6-5487-a98e-e1721c493d8a",
  "slug": "4-ingredient-nutter-butter-cookie-balls-recipe-8737957",
  "name": "4-Ingredient Nutter Butter Cookie Balls",
  "recipe_type": "dessert",
  "brief_description": "These Nutter Butter\u00ae cookie balls use peanut butter instead of cream cheese for a no-bake version of the dessert treat that's easy and delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover a baking sheet with parchment paper and set aside."
    },
    {
      "position": 2,
      "text": "Crush peanut butter cookies in a food processor until they are crumbs. Pour into the bowl of a stand mixer and add peanut butter. Mix on medium speed until a dough forms, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Scoop dough and form 20 balls, placing them onto the prepared baking sheet. Freeze for 30 minutes so they will hold together while dipping."
    },
    {
      "position": 4,
      "text": "Melt chocolate candy in a microwave-safe bowl in a microwave, stirring frequently, in 30-second increments."
    },
    {
      "position": 5,
      "text": "Insert a toothpick into each cookie ball and dip into melted chocolate. Return balls to the prepared baking sheet and top with sprinkles."
    }
  ],
  "servings": 20,

  "id": "7f4efa99-0921-59cd-9ce6-100094e945b3",
  "slug": "real-wisconsin-fried-cheese-curds",
  "name": "Real Wisconsin Fried Cheese Curds",
  "recipe_type": "appetizer",
  "brief_description": "These cheese curds are beer battered and deep fried, and make for a real Wisconsin treat. A perfect way to enjoy this melty gooey irresistible snack.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Heat corn oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together flour, beer, milk, eggs, and salt to form a smooth, rather thin batter."
    },
    {
      "position": 3,
      "text": "Place cheese curds, about 6 or 8 at a time, into the batter, stir to coat, and remove with a wire strainer."
    },
    {
      "position": 4,
      "text": "Shake the curds a time or two to remove excess batter."
    },
    {
      "position": 5,
      "text": "Deep fry curds in hot oil until golden brown, 1 or 2 minutes. Drain on paper towels; serve hot."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "dcab4aee-a56d-504c-acb3-a4715a9cf599",
  "slug": "spruced-up-canned-corned-beef-hash",
  "name": "Spruced-Up Canned Corned Beef Hash",
  "recipe_type": "breakfast",
  "brief_description": "This canned corned beef hash recipe is spruced up with bacon, mushrooms, cheese, and eggs in a quick, one-skillet meal that is easy to customize.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Saut\u00e9 bacon, bell pepper, onion, and garlic in a large skillet over medium heat until bacon is cooked and onion is translucent, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix in corned beef hash and mushrooms. Season with salt and pepper. Cook, flipping sections of the hash occasionally, until browned, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, whisk eggs and milk together in a small bowl. Once corned beef hash is near done, pour egg mixture into the skillet. Cook, stirring occasionally, until eggs are cooked and no liquid remains, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in cheese and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

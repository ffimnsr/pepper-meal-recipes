{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0758b8cd-ce4b-5acd-9e49-37135ee6a9d4",
  "slug": "italian-style-stuffed-peppers",
  "name": "Italian-Style Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "Stuffed peppers take on an Italian feel with the help of Classico\u00ae Fresh Tomato & Basil Sauce, Italian sausage, Parmesan cheese, and Italian seasonings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a roasting pan (large enough to accommodate 8 pepper halves in a single layer) with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine the ground sirloin, Italian sausage, brown rice, Italian seasonings, salt, pepper, garlic, Parmesan cheese, egg, and 1/2 cup Classico\u00ae Tomato & Basil sauce in a large bowl. Mix until combined."
    },
    {
      "position": 3,
      "text": "Divide meat mixture evenly among the green pepper halves; press to compress slightly. Arrange halves in prepared pan. Spoon the remaining Classico\u00ae Tomato & Basil sauce onto the tops of the meat and peppers. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake until the peppers are soft and internal temperature of the meat reaches 165 degrees F, about 1 1/2 hours."
    },
    {
      "position": 5,
      "text": "Remove from oven. Remove foil and top each pepper with shredded cheese."
    },
    {
      "position": 6,
      "text": "Turn oven to broil. Place peppers, uncovered under the broiler. Broil until the cheese is melted and bubbly, about 5 minutes. Sprinkle with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

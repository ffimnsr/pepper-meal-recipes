  "id": "fa594a4d-c41c-57cd-ad6f-e79534fbd918",
  "slug": "easy-chorizo-street-tacos",
  "name": "Easy Chorizo Street Tacos",
  "recipe_type": "main",
  "brief_description": "Easy chorizo tacos made with crumbled chorizo quickly cooked with chipotle peppers, then topped with chopped cilantro and onion in a warm tortilla.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine crumbled chorizo and chipotle peppers in adobo sauce in a bowl."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium-high heat; add chorizo mixture and cook until crisp, 5 to 7 minutes. Transfer to a plate, reserving grease in the skillet."
    },
    {
      "position": 3,
      "text": "Heat tortillas in reserved grease in the skillet over medium heat until warmed, 1 to 2 minutes per side. Stack 2 tortillas for each taco, then fill with chorizo, onion, and cilantro."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

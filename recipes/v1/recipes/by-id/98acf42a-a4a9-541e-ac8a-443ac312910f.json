  "id": "98acf42a-a4a9-541e-ac8a-443ac312910f",
  "slug": "dijon-chicken-salad",
  "name": "Dijon Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This Dijon chicken salad recipe uses canned chicken along with seedless red and green grapes, dried cranberries, and celery for a tasty, light lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together chicken, celery, green grapes, red grapes, cranberries, and chives in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk together honey, mustard, mayonnaise, salt, and pepper in a medium bowl. Pour over chicken mixture and stir to coat."
    }
  ],
  "servings": 6,

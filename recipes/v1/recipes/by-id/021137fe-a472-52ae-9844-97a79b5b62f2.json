  "id": "021137fe-a472-52ae-9844-97a79b5b62f2",
  "slug": "brown-sugar-pie-i",
  "name": "Brown Sugar Pie I",
  "recipe_type": "dessert",
  "brief_description": "Something magical happens to brown sugar when it melts and bubbles and bakes. This pie is a testament to that. It \u2018s creamy, sweet and a cinch to make.",
  "cuisine": "French Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a saucepan, combine flour and sugar. Stir in milk, butter, salt and vanilla. Cook, stirring constantly, until mixture comes to a boil. Pour into an unbaked pie shell."
    },
    {
      "position": 3,
      "text": "Bake at 400 degrees F (200 degrees C) for 5 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue baking for 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

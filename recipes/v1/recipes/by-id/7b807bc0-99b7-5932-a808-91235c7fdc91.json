  "id": "7b807bc0-99b7-5932-a808-91235c7fdc91",
  "slug": "whipped-greek-yogurt-chocolate-mousse-recipe-12010092",
  "name": "Whipped Greek Yogurt Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "In this whipped chocolate mousse, the Greek yogurt adds a nice tang to the rich chocolate mousse. Serve it chilled alongside any fruit, berries, or maybe chopped nuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate chips in a microwave-safe bowl. Heat in the microwave in 30 second intervals, stirring after every 30 seconds, until melted; about 1 minute. Set aside to cool slightly."
    },
    {
      "position": 2,
      "text": "Beat Greek yogurt, cocoa power, maple syrup, vanilla, espresso powder and salt together in a large bowl with an electric mixer on medium speed until smooth and combined, about 30 seconds. Add melted chocolate and beat on medium speed until mixture is light and airy, 1 to 2 minutes. Taste, and add more maple syrup, if desired."
    },
    {
      "position": 3,
      "text": "Divide mousse between 2 serving cups. Mousse can be served right away; but for the best flavor, cover and refrigerate for at least 1 hour before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

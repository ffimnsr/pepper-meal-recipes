  "id": "f3e66e8d-feef-5b33-b546-094fcf0f80f6",
  "slug": "bermuda-fish-chowder",
  "name": "Bermuda Fish Chowder",
  "recipe_type": "soup",
  "brief_description": "A deliciously spicy Bermuda fish chowder with red snapper fillets and chunks of russet potatoes in a brothy soup made with clam juice, jalape\u00f1os, and aromatics.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large soup pot over medium heat. Add celery, carrots, onion, green pepper, and garlic; saut\u00e9 about 8 minutes."
    },
    {
      "position": 2,
      "text": "Stir in tomato paste, and cook for 1 minute. Add clam juice, potatoes, canned tomatoes with juice, Worcestershire sauce, jalape\u00f1o pepper, bay leaf, and ground black pepper. Simmer until potatoes are tender, stirring about every 30 minutes."
    },
    {
      "position": 3,
      "text": "Add fish. Simmer until snapper is easily flaked with fork, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "49f4b8c4-1911-5683-b3ff-f350d069db40",
  "slug": "arroz-con-leche-rice-pudding",
  "name": "Arroz con Leche (Rice Pudding)",
  "recipe_type": "dessert",
  "brief_description": "This arroz con leche (rice pudding) recipe, with cinnamon, is a Guatemalan version of rice pudding, where rice is simmered with water, milk, and sugar.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and rice in a bowl; soak at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Bring water and rice to a boil in a saucepan; reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Stir milk, sugar, cinnamon stick, and salt into rice; simmer until thick and the consistency of pudding, about 20 minutes. Discard cinnamon stick before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

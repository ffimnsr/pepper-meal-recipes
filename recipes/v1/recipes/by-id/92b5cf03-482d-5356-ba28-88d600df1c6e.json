  "id": "92b5cf03-482d-5356-ba28-88d600df1c6e",
  "slug": "steel-cut-oatmeal",
  "name": "Steel-Cut Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Steel-cut oatmeal recipe bulked up and flavored with dried cranberries, cashews, coconut, vanilla, and cinnamon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and salt to a boil in a saucepan. Stir oats into boiling water; cook oats until thick and soft, 20 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Stir milk, cashews, cranberries, coconut, vanilla extract, and cinnamon into cooked oats; continue cooking, stirring frequently, for 10 minutes more."
    },
    {
      "position": 3,
      "text": "Sprinkle sugar over oats to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

  "slug": "pan-con-tomate-spanish-tomato-bread-recipe-8646036",
  "name": "Pan con Tomate (Spanish Tomato Bread)",
  "recipe_type": "dessert",
  "brief_description": "Pan con tomate, or Spanish tomato bread, is a delicious Catalan dish that's so easy to make with toasted bread, garlic, sweet tomatoes, and olive oil.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place tomato in a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Toast the bread until browned, 1 to 3 minutes. Rub each slice of toast with garlic; this is easier to do if the peel is left on."
    },
    {
      "position": 3,
      "text": "Top each slice of toast with pureed tomato. Drizzle with olive oil and sprinkle with salt."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

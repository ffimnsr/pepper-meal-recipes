  "schema_version": 1,
  "id": "9b366c01-0abc-565e-920f-06e4620b5fae",
  "slug": "cheesy-bacon-slider-bake",
  "name": "Cheesy Bacon Slider Bake",
  "recipe_type": "appetizer",
  "brief_description": "For this cheesy bacon slider bake recipe, Hawaiian rolls are filled with Cheddar cheese, beef, and bacon, and glazed with butter, brown sugar, and Dijon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Place rolls, without separating them, on a flat work surface; cut in half horizontally. Arrange bottom half rolls in the prepared pan; sprinkle 1 cup Cheddar cheese on top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Add beef and onion to a skillet; cook and stir until beef is browned, 5 to 8 minutes. Drain grease. Stir in tomatoes, 1 1/2 teaspoons Dijon mustard, 1 1/2 teaspoons Worcestershire sauce, salt, and black pepper; cook until fully combined, 1 to 2 minutes."
    },
    {
      "position": 5,
      "text": "Spoon beef mixture over rolls; sprinkle remaining 1 cup Cheddar cheese and bacon on top. Cover with top half rolls."
    },
    {
      "position": 6,
      "text": "Combine butter, brown sugar, 1 tablespoon Dijon mustard, and 2 teaspoons Worcestershire sauce in a microwave-safe bowl; cover. Microwave on high until butter is melted, about 1 minute; stir until blended. Pour over rolls; sprinkle sesame seeds on top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven, uncovered, until golden brown, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f4421fef-9ec2-526b-8018-7be9d5bc7109",
  "slug": "cherry-wild-rice",
  "name": "Cherry Wild Rice",
  "recipe_type": "side",
  "brief_description": "This cherry wild rice recipe blends brown rice and wild rice with fresh cherries and glazed almonds for an appetizing side dish that will get rave reviews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2 cups water and wild rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender, 30 to 45 minutes. Drain excess liquid, fluff rice with a fork, and cook uncovered, about 5 minutes more."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring remaining 1/2 water and brown rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Combine cherries, brown sugar, and almonds in a large nonstick skillet; cook and stir over medium heat until brown sugar melts and cherries and almonds are coated, about 6 minutes. Stir in brown rice, wild rice, celery, orange juice, red wine vinegar, and orange zest; cook, stirring frequently, until heated through, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

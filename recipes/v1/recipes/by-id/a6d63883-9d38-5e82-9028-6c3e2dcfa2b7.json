{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a6d63883-9d38-5e82-9028-6c3e2dcfa2b7",
  "slug": "tomato-concasse",
  "name": "Tomato Concasse",
  "recipe_type": "appetizer",
  "brief_description": "Tomato concasse is a simple way to skin and seed vine-ripe tomatoes for use in sauces, stews, and more.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large bowl with ice cubes and water and set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil."
    },
    {
      "position": 3,
      "text": "Cut an X in the bottom of each tomato with a knife."
    },
    {
      "position": 4,
      "text": "Place prepared tomatoes in the pot of boiling water and cook until the skins begin to peel off, 10 to 40 seconds."
    },
    {
      "position": 5,
      "text": "Transfer tomatoes to the bowl of ice water and allow to cool for 2 to 3 minutes. When cool enough to handle, peel the skin off each tomato."
    },
    {
      "position": 6,
      "text": "Cut each tomato in half crosswise and remove and discard the seeds; finely dice the flesh."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

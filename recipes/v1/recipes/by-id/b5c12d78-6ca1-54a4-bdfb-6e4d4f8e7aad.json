  "id": "b5c12d78-6ca1-54a4-bdfb-6e4d4f8e7aad",
  "slug": "spicy-salmon-jerky",
  "name": "Spicy Salmon Jerky",
  "recipe_type": "appetizer",
  "brief_description": "Homemade spicy salmon jerky is easy to make using marinated salmon that is put in the food dehydrator and is great for snacks and hiking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice salmon into 4 equal sections, width-wise. Rotate each section 90 degrees and slice lengthwise, about 1/4-inch thick. Remove pin bones with needle-nose pliers. Don\u2019t slice bony sections near center of fillet."
    },
    {
      "position": 2,
      "text": "Whisk soy sauce, molasses, sugar, Worcestershire sauce, lemon juice, liquid smoke, black pepper, and hot sauce together in a large glass or ceramic bowl. Add salmon and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 4 hours."
    },
    {
      "position": 3,
      "text": "Remove salmon from marinade and shake off excess. Pat salmon dry using paper towels. Discard remaining marinade."
    },
    {
      "position": 4,
      "text": "Place salmon strips in a dehydrator; run according to manufacturer\u2019s instructions until desired doneness reached, about 6 hours. Check every few hours for doneness."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

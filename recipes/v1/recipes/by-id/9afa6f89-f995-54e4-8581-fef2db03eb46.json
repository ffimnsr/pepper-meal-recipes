  "id": "9afa6f89-f995-54e4-8581-fef2db03eb46",
  "slug": "green-minestrone",
  "name": "Green Minestrone",
  "recipe_type": "soup",
  "brief_description": "Give the traditional minestrone soup a green twist by leaving out the tomatoes and adding green beans, peas, and parsley for a fresh Italian-inspired soup.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in a heavy-bottomed pot over medium-high heat; cook and stir onion and garlic until onion is translucent, about 10 minutes. Add green beans, peas, and zucchini; toss to coat vegetables with oil."
    },
    {
      "position": 2,
      "text": "Slowly stream vegetable broth into vegetable mixture; bring to a simmer over medium heat. Stir in rosemary and great Northern beans and bring back to a simmer, about 5 minutes. Add ditalini pasta and simmer soup until pasta is tender but firm to the bite and soup has thickened, 10 to 15 minutes. Remove from heat; stir in parsley."
    },
    {
      "position": 3,
      "text": "Ladle soup into serving bowls and top each serving with 1 heaping tablespoon Parmesan cheese; season with salt and black pepper. Garnish soup with a drizzle of extra-virgin olive oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

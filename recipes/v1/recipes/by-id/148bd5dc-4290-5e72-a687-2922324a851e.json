  "slug": "chicken-egg-foo-young",
  "name": "Chicken Egg Foo Young",
  "recipe_type": "breakfast",
  "brief_description": "Start off your day with a tasty combination of eggs, vegetables, and leftover chicken in this quick and easy chicken egg foo young recipe.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together eggs, cooked chicken, onion, broccoli, coconut aminos, garlic powder, salt, and pepper in a bowl."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a saute pan over medium-low heat. Add 1/3 of the egg mixture and cook for 2 to 3 minutes. Flip and cook the other side for 2 to 3 minutes. Repeat twice more to cook remaining 2 servings, adding remaining oil as needed."
    },
    {
      "position": 3,
      "text": "Garnish servings with green onions."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

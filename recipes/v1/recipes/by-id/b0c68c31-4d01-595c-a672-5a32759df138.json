  "id": "b0c68c31-4d01-595c-a672-5a32759df138",
  "slug": "quick-chiles-rellenos-bake",
  "name": "Quick Chiles Rellenos Bake",
  "recipe_type": "main",
  "brief_description": "This is a great dish that is quick and easy and reheats well. Mild green chiles are filled with cheese, and wrapped in tortillas, then baked with a creamy enchilada sauce.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Split each chile lengthwise into halves and remove the seeds. Arrange 2 chile halves and about 3 1/2 tablespoons of the cheese near the outer edge of each tortilla. Roll tortilla to enclose the filling. Repeat process with remaining tortillas, chiles and cheese. Arrange the filled tortillas seam side down in a greased 9x13 inch baking pan. In a small bowl, whisk together the enchilada sauce and sour cream. Spoon over the filled tortillas."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 30 minutes, or until bubbly and heated through. Garnish with cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6abeca44-993f-5203-9dcd-106991a2e6fa",
  "slug": "chicken-bacon-ranch-sliders-recipe-8406817",
  "name": "Chicken Bacon Ranch Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These chicken bacon ranch sliders with shredded cheese on Hawaiian rolls are topped with savory ranch butter and baked for a pleasing party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Using a sharp serrated knife, carefully cut slider rolls in half horizontally. Set tops of rolls aside. Place bottom halves of rolls onto a rimmed baking tray."
    },
    {
      "position": 4,
      "text": "Add chicken and prepared ranch dressing to a bowl; stir to thoroughly coat chicken."
    },
    {
      "position": 5,
      "text": "Spread chicken onto slider rolls. Top chicken mixture with cheese and crumbled bacon. Place top halves of rolls on top of filling."
    },
    {
      "position": 6,
      "text": "Melt butter in the microwave in a microwave-safe bowl on High, about 30 seconds. Stir ranch seasoning into butter."
    },
    {
      "position": 7,
      "text": "Using a pastry brush, brush tops of sliders with ranch butter. Cover rolls with foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven for 20 minutes. Remove foil and bake until filling is hot, buns are golden, and cheese is melted, about 10 more minutes. Serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

  "id": "ac5cd34e-67b8-579f-a735-a9fa6d56fe56",
  "slug": "hot-cocoa-snack-mix-recipe-11854982",
  "name": "Hot Cocoa Snack Mix",
  "recipe_type": "appetizer",
  "brief_description": "This hot cocoa snack mix is a sweet, chocolatey treat that combines crunchy cereal with the cozy flavors of hot cocoa. Coated in melted chocolate and powdered sugar, then mixed with mini marshmallows and M&Ms, it's perfect for the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour rice or corn cereal into a large mixing bowl."
    },
    {
      "position": 2,
      "text": "Combine chocolate chips and oil in a separate microwave safe bowl. Microwave in 20 second intervals, stirring between each, until chocolate is melted and smooth."
    },
    {
      "position": 3,
      "text": "Pour melted chocolate over cereal and carefully stir until cereal is completely coated."
    },
    {
      "position": 4,
      "text": "Add powdered sugar and hot cocoa mix to the cereal mixture and toss gently until evenly coated. Allow the mixture to completely dry before storing."
    },
    {
      "position": 5,
      "text": "If desired, add in mini marshmallows and M&M\u2019s and mix."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

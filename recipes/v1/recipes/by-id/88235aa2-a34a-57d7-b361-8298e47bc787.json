  "id": "88235aa2-a34a-57d7-b361-8298e47bc787",
  "slug": "caramel-apple-upside-down-cake",
  "name": "Caramel-Apple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "You'll love the gooey, sweet apple topping with every bite of this delicious caramel-apple upside-down cake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line the bottom of a 9-inch nonstick cake pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Place brown sugar, butter, and cinnamon for topping in a pan over medium heat. Watch closely and stir everly 30 seconds until the mixture boils."
    },
    {
      "position": 3,
      "text": "Meanwhile, place apple slices on top of the parchment paper in the cake pan. As soon as the topping boils, remove it from the heat, pour over the apple slices, and spread it out evenly."
    },
    {
      "position": 4,
      "text": "Mix sugar and butter for cake in a large bowl with an electric mixer until fluffy. Mix in eggs, vanilla extract, and almond extract until completely combined. Mix in baking powder, baking soda, and 1/3 of the milk. Add remaining ingredients as follows, mixing briefly after each addition: 1/2 of the flour, 1/2 of the remaining milk, remaining flour, and remaining milk. Pour batter into the pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let sit for 5 minutes. Run a butter knife along the sides of the cake to separate it from the cake pan. Cut off the top of the cake with a serrated knife to flatten it. Invert on a cake plate and release cake. Serve hot or cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

  "id": "27c6699e-8ec0-5b42-a0a8-1fcb5c3575a3",
  "slug": "low-carb-bacon-cheeseburger-casserole",
  "name": "Low-Carb Bacon Cheeseburger Casserole",
  "recipe_type": "main",
  "brief_description": "This low-carb cheeseburger casserole is creamy and satisfying with all your burger favorites (beef, Cheddar, and bacon) but it leaves the buns behind!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook beef, garlic, and onion powder in a large nonstick skillet over medium-high heat, stirring often, until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Transfer beef to a 9x13-inch casserole pan. Add cooked bacon and stir to combine; spread in an even layer."
    },
    {
      "position": 4,
      "text": "Whisk eggs, cream, salt, and pepper together in a medium bowl until well combined. Stir in 3/4 of the Cheddar cheese. Pour mixture over beef in the casserole dish, then sprinkle remaining Cheddar over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown on top, 30 to 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "04623091-1bad-5ccd-835c-6d2e6747d2eb",
  "slug": "pesto-turkey-cottage-cheese-meatballs-recipe-11961760",
  "name": "Pesto Turkey Cottage Cheese Meatballs",
  "recipe_type": "salad",
  "brief_description": "These pesto turkey cottage cheese meatballs, savory with garlic, basil, parsley, and Parmesan cheese, can be served over pasta, in salads, or as a lettuce wrap. Versatile and nutritious, your family will love them.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Add eggs, cottage cheese, pesto, and garlic to a large bowl. Whisk with a fork to combine."
    },
    {
      "position": 3,
      "text": "Add breadcrumbs, ground turkey, onion, Parmesan cheese, parsley, salt, and pepper, and mix gently with your hands until combined."
    },
    {
      "position": 4,
      "text": "Let mixture stand for 5 to 10 minutes to hydrate breadcrumbs; shape into 1 1/2 ounce meatballs. Place on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until an instant read thermometer inserted near the center reads 165 degrees F (74 degrees C), 15 to 18 minutes."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

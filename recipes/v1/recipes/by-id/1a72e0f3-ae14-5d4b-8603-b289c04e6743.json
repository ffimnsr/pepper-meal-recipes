  "id": "1a72e0f3-ae14-5d4b-8603-b289c04e6743",
  "slug": "turkey-and-bacon-panini-with-chipotle-mayonnaise",
  "name": "Turkey and Bacon Panini with Chipotle Mayonnaise",
  "recipe_type": "main",
  "brief_description": "Turkey and bacon join melted provolone and a spicy mayonnaise in this crispy grilled sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned, about 10 minutes. Drain on a paper towel-lined plate."
    },
    {
      "position": 2,
      "text": "While the bacon is cooking, melt butter in a large skillet over medium heat. Add onion and cook, stirring occasionally, until soft and translucent, 7 to 10 minutes, adding garlic for the last minute. Stir in spinach and cook until wilted, about 3 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Preheat a panini press according to the manufacturer\u2019s instructions."
    },
    {
      "position": 4,
      "text": "Stir mayonnaise, chipotle peppers, and adobo sauce together in a small bowl. Spread mixture over 4 slices of focaccia bread, then top each slice with provolone, turkey, two slices bacon, spinach mixture, and remaining bread slices."
    },
    {
      "position": 5,
      "text": "Cook sandwiches in the preheated panini press until crispy and golden brown, about 5 minutes each."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

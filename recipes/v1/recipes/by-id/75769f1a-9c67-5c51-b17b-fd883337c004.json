  "id": "75769f1a-9c67-5c51-b17b-fd883337c004",
  "slug": "easy-apple-crisp-with-pie-filling",
  "name": "Easy Apple Crisp with Pie Filling",
  "recipe_type": "dessert",
  "brief_description": "This easy apple crisp with pie filling recipe using canned apple pie filling makes a tasty apple crisp with warm spices and a brown sugar crumbly top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread pie filling in an 8x8-inch baking dish. Sprinkle with cinnamon and nutmeg."
    },
    {
      "position": 3,
      "text": "Cream margarine and sugar together in a large bowl. Cut in flour with a pastry blender until mixture resembles coarse crumbs; sprinkle over pie filling."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top is brown and filling is bubbly, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

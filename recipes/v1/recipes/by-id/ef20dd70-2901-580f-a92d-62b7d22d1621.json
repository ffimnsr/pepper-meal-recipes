{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ef20dd70-2901-580f-a92d-62b7d22d1621",
  "slug": "grilled-chicken-meatballs-recipe-8648398",
  "name": "Grilled Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "This technique for grilled chicken meatballs is the only way to go. By pre-baking the meatballs, they finish quickly on the grill, and stay moist and juicy every time. A hoisin-ginger glaze makes a beautiful, glossy meatball, but you can flavor them just about any way you want.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add chicken, sesame oil, soy sauce, mirin, salt, pepper, cayenne, green onions, garlic, and bread crumbs to a bowl, and use a fork to gently but thoroughly mix everything together. Wrap and chill in the refrigerator for about 30 minutes before shaping."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with foil, and lightly grease the foil."
    },
    {
      "position": 3,
      "text": "Divide meatball mixture into 16 portions (about 2 rounded tablespoons each), and transfer onto the prepared pan. Using damp hands, roll each portion into a smooth meatball; and space out evenly on the baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Meatballs will be just cooked through, and an instant read thermometer inserted near the center will read 145 to 150 degrees F (63 to 66 degrees C)."
    },
    {
      "position": 5,
      "text": "Let cool; wrap and keep in the refrigerator until needed. These can be made the day before."
    },
    {
      "position": 6,
      "text": "Preheat an outdoor grill, preferably charcoal, for medium heat, and lightly oil the grate. Stir ketchup, hoisin, fresh ginger, and rice vinegar together in a small bowl, and set aside."
    },
    {
      "position": 7,
      "text": "Place 4 meatballs on each skewer, and grill until lightly charred and heated through, about 3 minutes per side. Turn over, and brush with glaze. Turn back over, so the brushed side is down, and let sear for about 30 seconds; meanwhile, brush top with glaze."
    },
    {
      "position": 8,
      "text": "Turn over once more and let sear for about 30 seconds; remove from the heat. Apply more glaze after removing from the grill, as desired. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,

  "id": "7f526be5-b159-5b15-b0d9-135db04eeccf",
  "slug": "apricot-lentil-soup",
  "name": "Apricot Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This pur\u00e9ed apricot and lentil soup is made with red lentils, dried apricots, and tomatoes cooked in a chicken broth flavored with chicken and thyme.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Saut\u00e9 apricots, onion, and garlic in olive oil, about 5 minutes. Add chicken stock and lentils and bring to a boil. Reduce the heat and simmer for 30 minutes."
    },
    {
      "position": 2,
      "text": "Stir in tomatoes and season with cumin, thyme, salt, and pepper to taste. Simmer for 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in lemon juice. Pur\u00e9e 1/2 of the soup in a blender, then return to the pot. Serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

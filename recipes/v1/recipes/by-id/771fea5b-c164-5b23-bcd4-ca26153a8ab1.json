  "id": "771fea5b-c164-5b23-bcd4-ca26153a8ab1",
  "slug": "scoopable-banana-pudding-cheesecake-recipe-12062072",
  "name": "Scoopable Banana Pudding Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This scoopable banana pudding cheesecake combines two classic desserts in one delicious, creamy, no-bake treat. Layers of fluffy cheesecake filling, banana pudding, and buttery vanilla wafer crumbles freeze together for an easy dessert that\u2019s perfect for scooping and sharing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cheesecake filling and cool whip in a large bowl and gently fold until well combined. Set aside."
    },
    {
      "position": 2,
      "text": "Whisk together instant pudding mix and cold milk together in a bowl for 2 minutes until thick. Set aside."
    },
    {
      "position": 3,
      "text": "Combine vanilla wafers and melted butter in a separate bowl until it forms a crumble. Set aside."
    },
    {
      "position": 4,
      "text": "In an 9x9 baking dish, pour in half of the cheesecake mixture and spread into an even layer. Sprinkle half of the crumble mixture on top and then spread the pudding mixture on top making sure to swirl layers slightly. Pour the remaining cheesecake mixture on top and spread evenly. Sprinkle with remaining crumble."
    },
    {
      "position": 5,
      "text": "Wrap dish with plastic wrap and freeze overnight."
    },
    {
      "position": 6,
      "text": "Unwrap and serve with spoon. If needed, allow to sit at room temperature to become easily scoopable."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

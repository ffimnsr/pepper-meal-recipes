  "slug": "shamrock-shakes",
  "name": "Shamrock Shake",
  "recipe_type": "dessert",
  "brief_description": "This copycat Shamrock Shake recipe is a creamy blend of ice cream, milk, mint extract, and green coloring for a favorite St. Patrick's Day treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Blend ice cream, milk, mint extract, and food coloring together in a blender until smooth."
    },
    {
      "position": 3,
      "text": "Drizzle chocolate syrup around the inside of 2 tall glasses; pour shake into the glasses. Top with whipped cream and green sugar."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,

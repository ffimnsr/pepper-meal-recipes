  "id": "8db85384-4b98-51bf-8b4b-f527719e63d7",
  "slug": "the-best-beef-carpaccio-recipe-8403938",
  "name": "The Best Beef Carpaccio",
  "recipe_type": "appetizer",
  "brief_description": "This is the best beef carpaccio, and also easy to make at home. Cold, tender, rich beef, sliced paper thin and plated with a tangy, salty sauce, Parmesan shavings, briny capers, and baby arugula is a surprisingly simple but sophisticated appetizer.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Wrap beef very tightly in plastic wrap and place in the freezer until just slightly firm, about 1 hour. Chill 4 large plates in the refrigerator until ready to serve."
    },
    {
      "position": 2,
      "text": "Meanwhile, prepare sauce. Combine mayonnaise, 2 tablespoons lemon juice, anchovies, and 1/4 teaspoon pepper in the bowl of a food processor. Blend until smooth and set aside."
    },
    {
      "position": 3,
      "text": "Remove plastic wrap from beef. Using a very sharp knife, carefully slice paper-thin slices of beef. Arrange beef in a single layer divided among 4 chilled plates."
    },
    {
      "position": 4,
      "text": "Toss arugula with remaining lemon juice and pepper, olive oil, and salt. Place arugula mixture in the center of the beef. Drizzle evenly with reserved sauce; sprinkle with capers and cheese. Serve immediately with baguette slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

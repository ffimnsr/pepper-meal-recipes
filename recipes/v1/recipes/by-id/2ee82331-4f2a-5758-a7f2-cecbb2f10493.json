  "id": "2ee82331-4f2a-5758-a7f2-cecbb2f10493",
  "slug": "birds-nest-eggs-recipe-11943851",
  "name": "Bird\u2019s Nest Eggs",
  "recipe_type": "breakfast",
  "brief_description": "These bird\u2019s nest eggs are a spin on eggs Napoleon, with crispy hash browns baked into ramekins and filled with savory sausage and melted cheese. Each one is topped with a perfectly cooked egg with a soft, rich yolk for a breakfast that tastes as good as it looks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Put 2 empty, greased ramekins in the oven for 5 minutes to heat up."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-high heat. Spread hashbrowns in a thin layer in the skillet; cook, stirring as little as possible, until golden and crispy."
    },
    {
      "position": 3,
      "text": "Carefully remove hot ramekins from the oven. Divide hashbrowns and carefully press hashbrowns into the bottom and up the sides of each ramekin. Press firmly. Sprinkle sausage evenly over hashbrowns; sprinkle with cheese."
    },
    {
      "position": 4,
      "text": "Make a small well in the center of each ramekin. Crack an egg into each well. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Carefully return ramekins to the oven; bake for 12 to 18 minutes, based upon how you want the yolk. 12 to 14 minutes will leave a runny yolk; at 15 to 18 minutes, the yolk should be jammy to firm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

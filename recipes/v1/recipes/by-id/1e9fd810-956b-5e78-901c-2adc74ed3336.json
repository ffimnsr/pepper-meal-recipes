  "id": "1e9fd810-956b-5e78-901c-2adc74ed3336",
  "slug": "spicy-lamb-patties",
  "name": "Spicy Lamb Patties",
  "recipe_type": "main",
  "brief_description": "Ground lamb meat and seasonings combine to make delicious grilled patties!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the grill for high heat."
    },
    {
      "position": 2,
      "text": "In a bowl, mix the lamb, green onions, garlic, curry powder, cumin, red pepper, salt and pepper. Form into 4 patties."
    },
    {
      "position": 3,
      "text": "Lightly oil grill grate. Grill patties 5 minutes on each side, or until done."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

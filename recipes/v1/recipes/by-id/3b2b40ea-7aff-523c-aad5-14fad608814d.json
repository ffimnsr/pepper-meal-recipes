  "schema_version": 1,
  "id": "3b2b40ea-7aff-523c-aad5-14fad608814d",
  "slug": "super-easy-polish-cabbage-rolls",
  "name": "Super Easy Polish Cabbage Rolls",
  "recipe_type": "main",
  "brief_description": "A simplified chicken cabbage roll recipe, made here with rice, tomato, and ground chicken, tastes great with less work for this classic dish.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring rice and water to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and the liquid has been absorbed, 20 to 25 minutes. Allow rice to cool slightly."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of water to a boil. Remove the core from the cabbage, and place cabbage in the boiling water. Remove the outer leaves as they soften. Set leaves aside."
    },
    {
      "position": 4,
      "text": "Heat butter in a skillet over medium heat, and cook and stir onion until softened and translucent, about 5 minutes. Stir together cooked onion, ground chicken, cooked rice, eggs, garlic, salt, pepper, and marjoram in a bowl."
    },
    {
      "position": 5,
      "text": "Place some of the meat mixture in the center of each cabbage leaf. Roll leaf and tuck ends in to enclose filling. Secure each roll with a toothpick if necessary. Place rolls into the prepared baking dish. Pour tomato sauce over the rolls."
    },
    {
      "position": 6,
      "text": "Bake, covered, in the preheated oven until the meat in the rolls is no longer pink, 45 to 60 minutes. An instant-read thermometer inserted into the center of the casserole should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

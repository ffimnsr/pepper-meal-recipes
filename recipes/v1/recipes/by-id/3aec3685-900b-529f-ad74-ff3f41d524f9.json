  "id": "3aec3685-900b-529f-ad74-ff3f41d524f9",
  "slug": "everything-bagel-deviled-eggs-recipe-8729732",
  "name": "Everything Bagel Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These everything bagel seasoning deviled eggs are absolutely delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice eggs in half lengthwise, remove yolks, and place them in a bowl. Place egg whites aside."
    },
    {
      "position": 2,
      "text": "Mash egg yolks. Stir in mayonnaise and mustard until well combined. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place egg yolk mixture in a piping bag and pipe mixture into egg whites. Sprinkle generously with Everything Bagel seasoning."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "966f1c6b-0bf7-5cd5-bd0c-cc6369531bc0",
  "slug": "copycat-panera-mac-and-cheese-recipe-11979298",
  "name": "Copycat Panera Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "Skip the caf\u00e9 line and make Panera\u2019s famous creamy mac and cheese right at home with this easy copycat recipe. Tender shell pasta is coated in a rich, velvety cheese sauce made with white Cheddar and Gruy\u00e8re for the ultimate comfort food that's better than the original.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook according to package directions. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Add flour, salt, pepper, ground mustard, and paprika. Cook, whisking constantly until smooth, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Gradually whisk in whole milk and heavy cream. Cook, whisking constantly, until sauce is thickened and bubbly, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Reduce heat to low. Add cheddar cheese and Gruy\u00e8re cheese; stir until melted and smooth. Add cooked pasta and stir until evenly coated. Serve immediately."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

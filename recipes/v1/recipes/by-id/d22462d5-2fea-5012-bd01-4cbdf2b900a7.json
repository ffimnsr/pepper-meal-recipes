  "schema_version": 1,
  "id": "d22462d5-2fea-5012-bd01-4cbdf2b900a7",
  "slug": "scrumptious-oven-baked-egg-rolls",
  "name": "Scrumptious Oven-Baked Egg Rolls Recipe",
  "recipe_type": "appetizer",
  "brief_description": "Homemade oven-baked egg rolls filled with Persian cucumber, cabbage, tofu, and carrots is a scrumptious recipe and an impressive appetizer for parties.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Heat olive oil and 1/2 teaspoon sesame oil in a skillet over medium-high heat. Add tofu in batches; cook and stir, until lightly browned on one side, 2 to 3 minutes. Flip using chopsticks; cook and stir until lightly browned on other side, 2 to 3 minutes. Repeat with remaining tofu."
    },
    {
      "position": 3,
      "text": "Whisk 3 tablespoons water, soy sauce, garlic, brown sugar, cornstarch, and ancho chile pepper together in a bowl, adding more water if sauce gets clumpy."
    },
    {
      "position": 4,
      "text": "Combine tofu, green onions, cucumber, carrot, cabbage, and cilantro in a bowl; stir in sauce until coated. Spoon tofu filling down middle of each egg roll wrapper; roll wrapper around the filling. Wet edges of each wrapper with water so they stick together. Arrange egg rolls on the prepared baking sheet; coat with cooking spray."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, flipping halfway through, until golden brown, 20 to 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

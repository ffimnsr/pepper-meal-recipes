  "id": "3ea051a8-ef52-5ac6-a75f-8a93b5583e63",
  "slug": "grandmas-cranberry-orange-gelatin-salad",
  "name": "Grandma’s Cranberry-Orange Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "A classic cranberry-pineapple gelatin salad expected on everyone’s Thanksgiving menu, this version adds a flavor twist with orange zest and pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place gelatin into a bowl, pour in boiling water, and stir until gelatin dissolves. Mix in cranberry sauce, pineapple, celery, pecans, and orange zest until evenly blended."
    },
    {
      "position": 2,
      "text": "Pour gelatin mixture into a mold or serving dish. Chill in the refrigerator for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "To make topping, beat cream cheese with 1/2 of the whipped topping. Fold in remaining whipped topping until well blended."
    },
    {
      "position": 4,
      "text": "Unmold gelatin, then spread with topping mixture."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

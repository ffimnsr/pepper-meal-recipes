  "id": "e78f0a23-b7d5-55e5-ab22-7b6f9ffcedb6",
  "slug": "easy-pizza-sauce-i",
  "name": "Easy Homemade Pizza Sauce",
  "recipe_type": "side",
  "brief_description": "This pizza sauce is a simple, no-cook recipe made with just 5 ingredients: tomato paste, olive oil, garlic, oregano, basil, and rosemary.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together water, tomato paste, and olive oil in a large bowl or jar. Add garlic, oregano, basil, rosemary, salt, and pepper; mix well."
    },
    {
      "position": 3,
      "text": "For best results, let sauce stand for several hours to allow the flavors to blend. No cooking is necessary; just spread on pizza crust."
    }
  ],

  "slug": "royal-icing-i",
  "name": "Royal Icing",
  "recipe_type": "dessert",
  "brief_description": "This royal icing recipe makes a sweet white icing that dries quickly, making it perfect for decorating gingerbread houses and holiday cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a large glass, metal, or ceramic bowl with an electric mixer at high speed until foamy."
    },
    {
      "position": 3,
      "text": "Gradually add sugar and lemon extract; continue to beat on high speed until thickened."
    },
    {
      "position": 4,
      "text": "Use to pipe or decorate cookies."
    }
  ],

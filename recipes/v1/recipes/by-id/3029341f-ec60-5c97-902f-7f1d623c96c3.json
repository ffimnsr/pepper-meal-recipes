  "id": "3029341f-ec60-5c97-902f-7f1d623c96c3",
  "slug": "easy-pumpkin-muffins",
  "name": "Easy Pumpkin Muffins",
  "recipe_type": "dessert",
  "brief_description": "These easy pumpkin muffins, made with cake mix, canned pumpkin puree, and warm spices, are moist and delicious. Sure to become a favorite fall treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin pan or line with paper liners."
    },
    {
      "position": 2,
      "text": "Mix cake mix, pumpkin puree, cinnamon, nutmeg, and cloves in a large bowl until no dry spots remain and the batter is smooth."
    },
    {
      "position": 3,
      "text": "Spoon equal amounts of batter into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of one comes out clean, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

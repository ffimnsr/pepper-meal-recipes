  "schema_version": 1,
  "id": "296926d0-82e3-572d-a746-d488a1fea6dd",
  "slug": "russian-pelmeni",
  "name": "Russian Pelmeni",
  "recipe_type": "appetizer",
  "brief_description": "Pelmeni are boiled Russian dumplings made with a simple dough of flour, egg, oil, water, and salt filled with a mixture of ground beef and onion.",
  "cuisine": "Russian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make dough: Combine egg, oil, and salt in a liquid measuring cup; add enough warm water to fill to 1 cup."
    },
    {
      "position": 3,
      "text": "Pour into a large bowl and knead in 3 cups flour until smooth and elastic."
    },
    {
      "position": 4,
      "text": "Cover with a dish towel and let dough rest for 30 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, make filling: Combine ground beef, onion, water, salt, and pepper in a medium bowl; mix thoroughly by hand or using a fork. Set aside."
    },
    {
      "position": 6,
      "text": "Dust a baking sheet lightly with 1 tablespoon flour; set aside."
    },
    {
      "position": 7,
      "text": "Roll out a portion of dough very thinly on a lightly floured surface; keep remaining dough covered with a dish towel to avoid drying out."
    },
    {
      "position": 8,
      "text": "Cut out 2 1/2-inch rounds with a cookie cutter."
    },
    {
      "position": 9,
      "text": "Place about 1 teaspoon filling on one side of each dough circle."
    },
    {
      "position": 10,
      "text": "Fold dough over and seal the edges using your fingers, forming a crescent."
    },
    {
      "position": 11,
      "text": "Join the ends and pinch them together."
    },
    {
      "position": 12,
      "text": "Place on the prepared baking sheet. Repeat with remaining dough and filling. Freeze pelmeni for 30 minutes to prevent them from sticking together."
    },
    {
      "position": 13,
      "text": "Bring a large pot of lightly salted water to a simmer. Working in batches, cook frozen pelmeni in simmering water until meat is cooked through and pelmeni float to the top, about 5 minutes."
    },
    {
      "position": 14,
      "text": "Continue cooking for 5 more minutes."
    },
    {
      "position": 15,
      "text": "Transfer to serving plates using a slotted spoon. Serve and enjoy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,

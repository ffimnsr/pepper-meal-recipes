  "id": "994aecf0-aa9a-5a2c-a620-ce398ab4e9ef",
  "slug": "shrimp-fajita-rice-casserole-recipe-8788221",
  "name": "Shrimp Fajita Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This shrimp fajita rice bake is relatively simple but the flavors really shine. Bright bell peppers, warm poblano peppers, and fire-roasted tomatoes bake with cooked rice and shrimp, and every serving is topped with avocado, sour cream, and cilantro.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a 2-quart baking dish with nonstick cooking spray."
    },
    {
      "position": 3,
      "text": "Heat oil in a 12-inch skillet over medium-high heat. Add peppers and onion. Cook and stir until softened, 6 minutes."
    },
    {
      "position": 4,
      "text": "Stir in garlic, salt, pepper, cumin, and oregano. Cook and stir until fragrant, 1 minute."
    },
    {
      "position": 5,
      "text": "Stir together pepper mixture, shrimp, undrained tomatoes, and rice in a large bowl. Transfer to prepared baking dish. Cover tightly with foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until heated through, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Top servings with avocado, sour cream, and cilantro. Serve with lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

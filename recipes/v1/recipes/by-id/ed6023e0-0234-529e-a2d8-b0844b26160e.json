  "id": "ed6023e0-0234-529e-a2d8-b0844b26160e",
  "slug": "funeral-sandwiches",
  "name": "Funeral Sandwiches",
  "recipe_type": "main",
  "brief_description": "Funeral sandwiches made with ham and Swiss cheese on soft rolls are brushed with a mustard and poppy seed butter, then baked until golden and gooey!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a cookie sheet with cooking spray. Place ham and Swiss cheese slices on the bottom of each bread roll and cover with tops; arrange rolls in an even layer on the prepared sheet."
    },
    {
      "position": 2,
      "text": "Mix butter, brown sugar, Worcestershire, mustard, and poppy seeds together in a small bowl; spoon over sandwich tops. Let sit for 10 minutes or up to 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, uncovered, until golden on top and cheese is melted, about 12 to 18 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "73c648f0-bab3-54d7-9b52-39fb2f71dcb4",
  "slug": "thai-shrimp-fried-rice-kao-pad-goong",
  "name": "Thai Shrimp Fried Rice (Kao Pad Goong)",
  "recipe_type": "main",
  "brief_description": "This Thai shrimp fried rice, or kao pad goong, is a complete and satisfying one-dish meal that tastes better than takeout.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together oyster sauce, fish sauce, soy sauce, and brown sugar in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Heat 1/2 tablespoon oil in a large cast iron skillet or wok over medium heat. Add shrimp, 1/4 cup green onions, and 1 tablespoon garlic. Cook, stirring constantly, until shrimp are firm and opaque, 3 to 4 minutes. Transfer to a bowl."
    },
    {
      "position": 3,
      "text": "Without cleaning the skillet, add another 1/2 tablespoon oil over medium heat. Add remaining 1/4 cup green onions, remaining 1 tablespoon garlic, and mixed vegetables. Cook, stirring often, until vegetables are tender, about 4 minutes. Push to the side of the skillet and add another 1 tablespoon oil to the center. Add beaten egg and let sit for 20 seconds; then stir gently until large curds form, about 1 minute. Stir cooked eggs and vegetables together."
    },
    {
      "position": 4,
      "text": "Increase heat to medium-high and add remaining 1 tablespoon oil. Stir in cooked rice and reserved sauce; flatten rice in skillet. Cook, flipping and turning occasionally, until rice is brown and crispy in some spots, about 5 minutes. Remove from heat and stir in cooked shrimp."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c6d26d00-08e9-576b-87df-054873a3015e",
  "slug": "pickled-peppers",
  "name": "Pickled Peppers",
  "recipe_type": "snack",
  "brief_description": "These homemade pickled peppers are simple to make with red bell peppers, vinegar, and sugar for a crunchy condiment or delicious snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, vinegar, sugar, and salt in a saucepan; bring to a boil. Add bell peppers to boiling water mixture. Reduce heat to medium-low and simmer until peppers are softened, 8 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer peppers and liquid to glass jars. Screw on the lids and refrigerate for 8 hours to overnight."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

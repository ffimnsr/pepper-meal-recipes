  "id": "692389ac-a683-5dc6-8032-701de7744e6e",
  "slug": "spritz-cookies-v",
  "name": "Spritz Cookies V",
  "recipe_type": "dessert",
  "brief_description": "Spritz cookies that are light and won't last long. The dough handles better when slightly chilled.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the egg, then stir in the vanilla and almond extracts. Combine the flour and cornstarch; stir into the creamed mixture until well blended. Fill cookie press and press out dough onto ungreased cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 8 to 10 minutes in the preheated oven, until edges are golden. Remove from baking sheets to cool on wire racks."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "e3b3fac3-eb9a-5f69-a826-7fcc8feb32db",
  "slug": "sophies-shepherds-pie",
  "name": "Sophie's Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This English shepherd's pie, made with lamb mince, tomatoes, and gravy is super tasty and versatile \u2014 sure to become a favorite with the whole family!",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place the potatoes into a saucepan and fill with enough water to cover. Bring to a boil, then cook over medium heat until tender enough to pierce with a fork, about 10 minutes. Drain and mash with butter and milk to your desired texture."
    },
    {
      "position": 3,
      "text": "Meanwhile, crumble the ground lamb into a large skillet. Cook and stir until no longer pink. Season with Worcestershire sauce and beef bouillon. Add the mushrooms and onion; continue to cook and stir until tender. Transfer the contents of the skillet to a large casserole dish."
    },
    {
      "position": 4,
      "text": "Mix the baked beans, diced tomatoes, gravy mix and carrots in with the lamb. Dollop big blobs of mashed potatoes over the top and carefully spread evenly to cover the entire top. Rake over it with a fork to create a crispy texture on top when it browns."
    },
    {
      "position": 5,
      "text": "Bake for 10 minutes in the preheated oven, until the top is browned and crisp."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

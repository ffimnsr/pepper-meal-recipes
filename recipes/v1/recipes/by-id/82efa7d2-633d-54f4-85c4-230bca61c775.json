  "id": "82efa7d2-633d-54f4-85c4-230bca61c775",
  "slug": "eggless-vanilla-eggnog",
  "name": "Eggless Vanilla Eggnog",
  "recipe_type": "dessert",
  "brief_description": "Skim milk, instant pudding mix, egg substitute, vanilla extract and nutmeg create this all-time favorite holiday drink It's best when refrigerated overnight.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl combine 2 cups milk and pudding mixture; stir well until thickened."
    },
    {
      "position": 2,
      "text": "To the pudding add remaining 2 cups milk and egg substitute; mix well. Stir in vanilla extract, salt and nutmeg until well blended and coats a spoon."
    },
    {
      "position": 3,
      "text": "Refrigerate overnight."
    }
  ],
  "servings": 10,

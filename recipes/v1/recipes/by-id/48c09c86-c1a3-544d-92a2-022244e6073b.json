  "slug": "champagne-punch-iii",
  "name": "Champagne Punch",
  "recipe_type": "dessert",
  "brief_description": "A refreshing punch made with cranberry juice, lemonade, white wine, club soda and champagne. Fruity, but not too sweet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large punch bowl, combine cranberry juice concentrate, pink lemonade concentrate, limeade concentrate, white wine, club soda, and champagne. Garnish with lemon slices and fresh mint leaves."
    }

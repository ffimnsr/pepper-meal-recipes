  "id": "def1335b-963b-54f6-a77c-ded0c5fedce3",
  "slug": "restaurant-style-egg-drop-soup",
  "name": "Restaurant Style Egg Drop Soup",
  "recipe_type": "appetizer",
  "brief_description": "This chicken egg drop soup is easy to make with chicken broth, flavored with ginger, chives, and silky ribbons of egg for a savory Chinese appetizer.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Reserve 3/4 cup of chicken broth, and pour the rest into a large saucepan. Stir in chives, salt, and ginger; bring to a rolling boil. Stir reserved 3/4 cup of broth and cornstarch until smooth. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk eggs and egg yolk together in a small bowl with a fork. Using a fork, drizzle eggs, a little at a time, into boiling broth. Eggs will cook immediately."
    },
    {
      "position": 4,
      "text": "Stir in cornstarch mixture gradually until soup reaches desired consistency."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

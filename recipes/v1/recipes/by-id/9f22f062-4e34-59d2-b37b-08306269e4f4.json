  "id": "9f22f062-4e34-59d2-b37b-08306269e4f4",
  "slug": "slow-cooker-apple-crisp",
  "name": "Slow Cooker Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "Easy crockpot apple crisp made in the slow cooker with sugar-sweetened apples and a delicious walnut crumb topping flavored with cinnamon and nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the topping: Mix flour, brown sugar, white sugar, cinnamon, nutmeg, and salt together in a bowl. Add butter and mix with your fingers or a fork until coarse crumbs form. Stir in walnuts."
    },
    {
      "position": 2,
      "text": "To make the apple filling: Whisk sugar, cornstarch, ginger, and cinnamon together in a small bowl."
    },
    {
      "position": 3,
      "text": "Place apples in a slow cooker. Stir in cornstarch mixture. Add lemon juice and toss to combine. Sprinkle topping over apples. Cover and cook until apples are tender, on Low for 4 hours or High for 2 hours."
    },
    {
      "position": 4,
      "text": "Turn off the slow cooker, partially uncover, and let stand until topping has hardened, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,

  "id": "d2315330-0d7a-5173-9980-186366de723c",
  "slug": "jalapeno-bacon-cheddar-deviled-eggs",
  "name": "Jalape\u00f1o Bacon Cheddar Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "This jalape\u00f1o bacon Cheddar deviled eggs recipe is a spin on an old classic \u2014 the combination of Cheddar, bacon, and jalape\u00f1o makes everything better.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan; cover with water. Bring to a boil, remove from heat, and let eggs stand in water for 15 minutes. Remove eggs from water, cool under cold running water, and peel."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet; cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels; crumble when cool."
    },
    {
      "position": 3,
      "text": "Remove seeds and stems from jalape\u00f1os; mince 1 pepper and slice remaining 2 peppers into 24 very thin strips; set aside."
    },
    {
      "position": 4,
      "text": "Cut eggs in half lengthwise; place yolks in a bowl. Mash with a fork; stir in minced jalape\u00f1o, Cheddar cheese, mayonnaise, red onion, and mustard."
    },
    {
      "position": 5,
      "text": "Place egg whites, cut side up, on a serving platter. Spoon yolk mixture into egg white halves; insert pepper strip into each yolk; sprinkle with crumbled bacon and paprika."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

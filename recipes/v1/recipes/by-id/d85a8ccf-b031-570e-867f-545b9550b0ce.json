{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d85a8ccf-b031-570e-867f-545b9550b0ce",
  "slug": "spicy-beef-and-bean-enchilada-pie",
  "name": "Spicy Beef and Bean Enchilada Pie",
  "recipe_type": "main",
  "brief_description": "Chiles and pepperjack cheese give this hearty beef and black bean enchilada pie a spicy kick!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef and onions in a large skillet over medium-high heat until meat is browned and crumbly, 7 to 10 minutes. Add garlic and cook until fragrant, about 30 seconds. Stir in diced tomatoes, green chiles, cilantro, and taco seasoning mix. Remove from heat."
    },
    {
      "position": 3,
      "text": "Mix black beans and 1 can red enchilada sauce in a bowl until creamy."
    },
    {
      "position": 4,
      "text": "Mix pepperjack cheese and Monterey Jack cheese together in a separate bowl."
    },
    {
      "position": 5,
      "text": "Heat a cast-iron skillet over medium heat. Cook tortillas, one at a time, until slightly crisp, about 15 seconds per side."
    },
    {
      "position": 6,
      "text": "Place one tortilla on the bottom of an 8-inch springform pan. Spread a generous layer of black bean mixture on top of tortilla, then spread a layer of ground beef mixture on top. Sprinkle 1 cup of cheese mixture on top of meat mixture and pour 1/4 cup red enchilada sauce over the top. Repeat the tortilla, bean, meat, cheese, and sauce layering process, finishing with cheese and enchilada sauce on top."
    },
    {
      "position": 7,
      "text": "Cover pan with aluminum foil and bake in the preheated oven until cheese is bubbling and enchiladas are cooked through, about 40 minutes. Cool for 15 minutes and serve with sour cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

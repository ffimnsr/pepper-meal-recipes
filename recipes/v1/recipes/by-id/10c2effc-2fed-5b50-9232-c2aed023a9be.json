  "id": "10c2effc-2fed-5b50-9232-c2aed023a9be",
  "slug": "hot-chocolate-monkey-bread",
  "name": "Hot Chocolate Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "Easy monkey bread recipe layers biscuit pieces in between a Swiss Miss chocolate glaze for a pull apart gooey treat to top with Reddi-wip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F. Spray 10-cup Bundt or fluted tube pan with baking spray; set aside. Combine 2 envelopes hot cocoa mix and 1/4 cup sugar in large resealable food storage bag. Prepare glaze by combining remaining hot cocoa mix and sugar in small bowl; whisk in Parkay and milk until blended."
    },
    {
      "position": 2,
      "text": "Place half of biscuit pieces in cocoa mixture in bag; seal and shake to coat. Arrange coated biscuit pieces in bottom of pan; pour half of glaze over biscuits. Repeat with remaining biscuit pieces and glaze."
    },
    {
      "position": 3,
      "text": "Bake 30 minutes or until brown. Cool in pan 5 minutes. Invert onto serving tray. Pull apart and serve with Reddi-wip."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

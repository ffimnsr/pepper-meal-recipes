{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "30562417-0bce-5201-9d7b-8b692fd909ff",
  "slug": "apple-grape-salad-with-pecan-crusted-goat-cheese-recipe-11790586",
  "name": "Apple-Grape Salad with Pecan-Crusted Goat Cheese",
  "recipe_type": "salad",
  "brief_description": "Pecan-crusted goat cheese, sweet Red Delicious apples, top off red leaf lettuce tossed in tangy balsamic vinaigrette. Get ahead on dinner prep by preparing the goat cheese and shaking up the vinaigrette up to a day in advance.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together goat cheese and herbes de Provence in a small bowl. Roll into 2 (4-inch) logs. Chill, covered, until ready to use."
    },
    {
      "position": 2,
      "text": "Cook pecan pieces, 2 tablespoons butter, and 1/2 teaspoon salt in a very large skillet over medium heat, stirring frequently, until pecans are toasted, about 5 minutes. Cool completely. Finely chop 1 cup pecans and spread in a shallow baking dish."
    },
    {
      "position": 3,
      "text": "Slice each goat cheese log into 6 rounds. Roll the slices in the finely chopped pecans to coat. Chill until ready to serve. (To serve warm, see Cook\u2019s Note below.)"
    },
    {
      "position": 4,
      "text": "Wipe out skillet. Add grapes, onion, 1/4 teaspoon salt, and remaining 2 tablespoons butter. Cook over medium heat, stirring frequently, until onion is tender and grapes have started to blister, 5 to 7 minutes. Add wine and thyme. Simmer until wine is reduced and grapes are coated, about 1 minute."
    },
    {
      "position": 5,
      "text": "To make the vinaigrette: Combine olive oil, vinegar, mustard, honey, black pepper, and remaining \u00bd teaspoon salt in a jar with a tight-fitting lid. Cover and shake until emulsified."
    },
    {
      "position": 6,
      "text": "Put lettuce in a large bowl. Drizzle 1/3 cup vinaigrette over lettuce, tossing to coat. Divide among 4 serving plates. Top with grapes, onion, apples, goat cheese, and remaining pecans. Serve with remaining dressing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "1ce14a53-e49e-5ff2-9e9a-5949256b46b5",
  "slug": "turkey-lettuce-wraps-with-shiitake-mushrooms",
  "name": "Turkey Lettuce Wraps with Shiitake Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "This turkey lettuce wraps with shiitake mushrooms recipe uses lean ground turkey, shiitake mushrooms, and lots of water chestnuts for a tasty filling.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2 cups water to a boil in a small saucepan; turn off heat. Stir in rice noodles, cover the saucepan, and soak until soft, 5 to 7 minutes. Rinse noodles with cold water. Drain well."
    },
    {
      "position": 2,
      "text": "Heat 1 teaspoon vegetable oil in a large skillet over medium-high heat. Add mushrooms; cook until brown and soft, about 2 minutes. Transfer mushrooms to a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat remaining 2 teaspoons vegetable oil in the same skillet. Add turkey; cook until no longer pink, 5 to 7 minutes. Stir in green onions, water chestnuts, ginger, and garlic; cook for 1 minute. Add reserved mushrooms, soy sauce, and sugar; simmer to combine flavors, 1 to 2 minutes. Off heat, stir in vinegar, sesame oil, and orange zest."
    },
    {
      "position": 4,
      "text": "Divide turkey filling among lettuce leaves; top with cooked noodles, a sprinkle of carrots, bean sprouts, peanuts, and cilantro. Serve with sweet chili sauce for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "245ad0e3-b4c9-5bcd-8400-13ef6e77d29e",
  "slug": "amandas-stuffed-peppers",
  "name": "Amanda's Stuffed Peppers",
  "recipe_type": "salad",
  "brief_description": "Serve these beef and mushroom stuffed peppers with salad and breadsticks for a hearty and delicious meal. If you don't like rice, you will love this!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish with aluminum foil."
    },
    {
      "position": 2,
      "text": "Mix together ground beef, bread crumbs, Italian seasoning, garlic, 1/2 cup mozzarella cheese, 1/2 cup Parmesan cheese, egg, onion, and mushrooms in a large bowl. Spoon mixture evenly into the seeded bell peppers. Replace the tops. Place stuffed peppers in the prepared dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until meat stuffing is cooked through, about 1 hour. Remove from the oven and discard the pepper tops."
    },
    {
      "position": 4,
      "text": "Sprinkle stuffed peppers with remaining 1/4 cup mozzarella and 1/4 cup Parmesan cheese. Return to the oven until cheese is melted, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Warm spaghetti sauce in a medium saucepan over medium heat, stirring regularly. When sauce begins to steam, remove from heat and pour over the top of peppers."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

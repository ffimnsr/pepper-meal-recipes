  "id": "be580413-1316-5f7d-bf8f-192fa2b74511",
  "slug": "grandmas-chicken-soup",
  "name": "Grandma's Chicken Soup",
  "recipe_type": "soup",
  "brief_description": "Grandma's chicken soup is the ultimate comfort food and the only remedy for whatever ails you! Packed with root vegetables, this soup cures everything!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Clean chicken, remove and discard some, but not all, fat. Place in a large saucepan with carrots, celery, tomatoes, and onion."
    },
    {
      "position": 2,
      "text": "Tie dill sprigs into a bunch with kitchen twine. Add to the saucepan, and season with salt and pepper. Add water until chicken is covered by 2 inches."
    },
    {
      "position": 3,
      "text": "Cook over medium-low heat until chicken is cooked through, about 3 hours. Remove chicken to a plate and allow to cool, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Remove meat from bones, cut into bite-size pieces, and return to the saucepan. Discard bones. Cook over medium-low heat until heated through, about 30 minutes longer. Remove dill before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 35,

  "id": "a7518f25-86d4-5750-b97f-0154b6d410eb",
  "slug": "ginger-cookies-with-orange-glaze",
  "name": "Ginger Cookies with Orange Glaze",
  "recipe_type": "dessert",
  "brief_description": "These deliciously soft, chewy ginger cookies drizzled with an orange glaze are great for bake sales because they hold their shape well.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, baking soda, ginger, cinnamon, cloves, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, oil, molasses, egg, and 1/4 teaspoon salt in a large bowl; beat with an electric mixer until smooth. Pour over flour mixture; mix until a dough forms."
    },
    {
      "position": 4,
      "text": "Roll dough into 1-inch balls and arrange on ungreased baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm, 8 to 9 minutes. Let cool on the baking sheets for 5 minutes. Transfer to a wire rack to cool."
    },
    {
      "position": 6,
      "text": "Place shortening in a large microwave-safe bowl. Heat in the microwave until melted, about 1 minute."
    },
    {
      "position": 7,
      "text": "Stir confectioners' sugar and orange extract into the melted shortening. Mix in milk a little at a time until glaze runs smoothly off the end of a spoon. Add 1/4 teaspoon salt. Spoon glaze over cooled cookies."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 30,

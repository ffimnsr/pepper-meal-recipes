  "slug": "heirloom-tomato-salad-with-mozzarella-and-basil",
  "name": "Heirloom Tomato Salad with Mozzarella and Basil",
  "recipe_type": "salad",
  "brief_description": "Pair this delicious heirloom tomato salad with any Italian dish, or layer the ingredients for a caprese appetizer.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine balsamic vinegar and basil in a bowl. Pour in olive oil slowly while whisking constantly."
    },
    {
      "position": 2,
      "text": "Place tomatoes and mozzarella in a bowl. Pour vinaigrette over the top. Season with salt and pepper and toss together."
    }
  ],

  "id": "a5cbf5d5-5508-5dab-ae25-132bc11c9fd0",
  "slug": "roasted-red-pepper-panini",
  "name": "Roasted Red Pepper Panini",
  "recipe_type": null,
  "brief_description": "Make this delicious vegetarian roasted red pepper panini sandwich with roasted red peppers, mozzarella, spinach, and basil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine basil, buttery spread, and garlic in the bowl of a food processor or blender; pulse until almost smooth."
    },
    {
      "position": 2,
      "text": "Spread 2 slices bread with buttery basil spread; top with spinach, roasted pepper, mozzarella, and remaining bread slices."
    },
    {
      "position": 3,
      "text": "To cook in a panini press: Preheat a panini press according to the manufacturer's instructions. Add sandwich; cook until golden and crisp, according to the manufacturer's instructions, 3 to 5 minutes. Repeat with remaining sandwich."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

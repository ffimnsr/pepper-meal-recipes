  "schema_version": 1,
  "id": "b33e3bfa-4f48-534e-964b-2915dcfe1755",
  "slug": "mini-lobster-pot-pies",
  "name": "Mini Lobster Pot Pies",
  "recipe_type": "main",
  "brief_description": "Chef John's mini lobster pot pies are topped with a buttery puff pastry crust and make a perfect special dinner for two.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut lobster shell down the middle, crack it open, and pull out the meat. Cut the shell into 1-inch pieces and set aside."
    },
    {
      "position": 2,
      "text": "Cut the meat into \u00bd-inch pieces, checking carefully and removing any veins or missed pieces of shell. Transfer the meat to a plate and keep in the refrigerator until needed."
    },
    {
      "position": 3,
      "text": "Melt 1 tablespoon butter in a saucepan over medium heat. Add lobster shells and cook, stirring often, until they turn brick red, 3 to 4 minutes. Stir in sherry and clam juice and reduce heat to low. Simmer gently to steep lobster shells, 15 to 20 minutes; making sure the liquid does not reduce."
    },
    {
      "position": 4,
      "text": "Remove from the heat and pour broth through a strainer to remove shells."
    },
    {
      "position": 5,
      "text": "Rinse out the saucepan and add remaining 1 tablespoon butter. Place over medium heat to melt. Add carrots, celery, paprika, tomato paste, salt, pepper, and cayenne. Cook and stir until tomato paste is toasted and paprika is fragrant, about 2 minutes. Stir in flour and cook for 1 to 2 minutes. Stir in lobster broth and bring to a simmer."
    },
    {
      "position": 6,
      "text": "Add potatoes and reduce heat to medium-low. Cook at a gentle simmer until potatoes are tender and liquid has reduced just slightly, 10 to 15 minutes."
    },
    {
      "position": 7,
      "text": "While the potatoes are cooking, place puff pastry on a piece of parchment paper. Cut out two 3 \u00bd-inch circles and cut an \"x\" in the center of each one. Brush tops with beaten egg. Transfer to a baking sheet and place in the refrigerator until needed."
    },
    {
      "position": 8,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil."
    },
    {
      "position": 9,
      "text": "Add lemon juice, cream, and tarragon to the potatoes; stir to combine and return to a simmer over medium heat. Simmer until reduced and thickened a bit more, about 5 minutes. Taste and adjust salt if necessary."
    },
    {
      "position": 10,
      "text": "Stir in reserved lobster meat and turn off the heat. Remove from the stove and evenly divide the mixture between two 6-ounce ramekins, stopping about \u00bc inch from the top."
    },
    {
      "position": 11,
      "text": "With the egg wash facing up, place puff pastry circles onto the ramekins, making sure the vents are cut all the way through."
    },
    {
      "position": 12,
      "text": "Bake in the upper center of the preheated oven until bubbly and browned, about 20 minutes. Let rest for at least 5 minutes before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

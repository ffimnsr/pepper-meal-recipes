  "id": "868ab09a-22db-5720-b2ab-a92e94be2a19",
  "slug": "angel-family-chicken-soup-with-matzo-balls",
  "name": "Angel Family Chicken Soup with Matzo Balls",
  "recipe_type": "soup",
  "brief_description": "This Angel family chicken soup with matzo balls recipe uses fresh, delicious ingredients like parsnips, fresh dill, and fresh parsley, for a rich flavor.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Place whole chicken in a large stockpot; add 6 cups water, carrots, celery, parsnips, onion, dill, and parsley. Add more water as needed to cover ingredients; bring to a boil over medium-high heat. Cook until chicken begins to fall apart, about 1 hour. Remove chicken from soup and reserve for another use."
    },
    {
      "position": 2,
      "text": "Whisk eggs and oil together in a medium bowl; stir in matzo meal until well combined. Cover the bowl; refrigerate for 20 minutes. Gently roll matzo mixture into 1-inch balls; be careful not to over roll as this can make matzo balls tough."
    },
    {
      "position": 3,
      "text": "Bring 1 quart chicken stock to a boil in a separate large pot; reduce heat to a simmer. Gently add matzo balls to stock; cook until tender, about 1 hour. Transfer matzo balls to pot with soup and vegetables; season soup with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Place some rotisserie chicken meat in individual soup bowls; ladle in soup and matzo balls."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 45,

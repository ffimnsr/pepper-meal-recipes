  "id": "786f621b-8363-50f4-9e64-af3e5b85659a",
  "slug": "simple-beef-stew",
  "name": "Simple Beef Stew",
  "recipe_type": "soup",
  "brief_description": "You can feel good about serving your family this simple and hearty beef stew that's full of tender beef and lots of vegetables, all combined in a thick gravy-like sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium-high heat. Add meat, flour, onion, and garlic; cook and stir until browned, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Add broth, tomatoes, potatoes, celery, and carrots, then stir in Creole seasoning and basil. Bring to a simmer. Reduce heat to maintain simmer and cook, uncovered, until potatoes are soft, meat is tender, and gravy is thick, about 1 hour."
    }
  ],

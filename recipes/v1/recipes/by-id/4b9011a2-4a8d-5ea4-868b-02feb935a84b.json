  "id": "4b9011a2-4a8d-5ea4-868b-02feb935a84b",
  "slug": "fresh-apple-tarts",
  "name": "Fresh Apple Tarts",
  "recipe_type": "dessert",
  "brief_description": "These apple tarts are made with Granny Smith apples and a sweet, buttery pastry. They\u2019re topped with an optional apricot glaze \u2014 don\u2019t skip it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make the dough: In a large bowl, mix together flour, sugar, and salt. Cut in butter until mixture is crumbly. Add eggs and vanilla and mix until dough forms a ball. Wrap in plastic and refrigerate for at least 1 hour but not more than 1 day."
    },
    {
      "position": 2,
      "text": "While the dough is chilling, make the filling: In a medium bowl, toss apples with sugar and cinnamon. Mix in walnuts."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease sixteen 3-inch tart pans. Remove the dough from the refrigerator and let stand at room temperature for 30 minutes before rolling out."
    },
    {
      "position": 4,
      "text": "Knead dough briefly on a lightly floured surface. Cut into 16 equal portions. Roll each portion into a 6-inch circle."
    },
    {
      "position": 5,
      "text": "Carefully fit one circle into each tart pan. Spoon an equal amount of filling into each tart pan. Fold pastry edges over filling. Place filled tarts onto a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes. Melt apricot jam and brush over finished tarts if desired."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

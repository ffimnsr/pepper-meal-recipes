  "id": "0e66ae51-6eb2-5bc1-847c-f87a85157695",
  "slug": "southern-breakfast-potatoes-recipe-11907741",
  "name": "Southern Breakfast Potatoes",
  "recipe_type": "breakfast",
  "brief_description": "Southern breakfast potatoes are cubed russet potatoes fried slowly in a cast iron skillet. They take time, but are worth it. Topped with melted cheese and chopped green onion and brightened with a little lemon juice, they are scrumptious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Scrub potato, then peel (optional). Slice potato in half, then cut each slice into strips. Chop potato into squares, about 1-inch thick. Add cubed potatoes to a bowl, then drizzle lemon juice over potatoes. Toss gently. Add salt, pepper, and cayenne to the potatoes, then stir again. Set aside."
    },
    {
      "position": 2,
      "text": "Heat a heavy cast iron skillet over medium heat. Add half the olive oil and half the butter to the skillet. Once butter is melted, pour potatoes into the skillet. Smooth them out into a single layer."
    },
    {
      "position": 3,
      "text": "Let potatoes cook undisturbed for 3 minutes. Lift one to see if a crust has started to form, but not burned. Once the crust has started, use a sturdy spatula and turn potatoes over in sections. Add more oil and butter if needed to keep potatoes from sticking. Repeat the process until potatoes are golden brown on all sides. Sprinkle them with cheese, then cover with a fitted lid. Cook until cheese has melted, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Lift potatoes out in sections and transfer to a plate. Sprinkle with green onions. Taste and season with more salt and pepper if desired."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

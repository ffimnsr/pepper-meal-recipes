  "id": "c49d674d-f811-555f-a932-e145ffedf08e",
  "slug": "instant-pot-lentil-and-rice-soup",
  "name": "Instant Pot\u00ae Lentil and Rice Soup",
  "recipe_type": "soup",
  "brief_description": "This warm and comforting lentil and rice soup is easily thrown together in an Instant Pot\u00ae, making it a great choice for busy weeknights.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Soak lentils and rice in cold water to cover for at least 30 minutes. Rinse and drain. Set aside."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Add oil and saute carrots, celery, and onion until softened, 5 to 7 minutes. Stir in coriander, salt, thyme, rosemary, pepper, and chili powder. Stir in drained rice and lentils. Pour in water; add lemon zest. Close and lock the lid."
    },
    {
      "position": 3,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 12 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions for 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Stir in lemon juice. Taste and adjust seasonings. Serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "big-batch-freezer-door-gimlet-recipe-11965693",
  "name": "Big Batch Freezer Door Gimlet",
  "recipe_type": "appetizer",
  "brief_description": "This big batch freezer door gimlet takes 5 minutes to make, and is great to have on hand when company comes. This might be the best summer poolside drink ever - gin and lime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 cup gin from the bottle and save for another use. To the remaining gin in the bottle, add lime juice, simple syrup, and sweetened lime juice. Cover tightly, and tilt gently a few times to mix the ingredients. Place bottle in the freezer for several hours until very well chilled."
    },
    {
      "position": 2,
      "text": "Shake gently before serving. Serve as desired e.g. over ice and garnished with a lime wheel. Store any extra in the freezer until ready to use."
    }
  ],
  "servings": 8,

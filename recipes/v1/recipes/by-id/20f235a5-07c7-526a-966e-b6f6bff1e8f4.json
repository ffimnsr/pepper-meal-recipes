  "id": "20f235a5-07c7-526a-966e-b6f6bff1e8f4",
  "slug": "hybrid-hamburger-stroganoff",
  "name": "Hybrid Hamburger Stroganoff",
  "recipe_type": "main",
  "brief_description": "This hamburger stroganoff, a hybrid of about half dozen stroganoff recipes, is a quick and easy dinner that hits the spot on a cold evening.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add beef, mushrooms, and onion. Cook and stir until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease. Transfer mixture to a bowl. Add garlic and oil to the skillet; saute until garlic is golden brown, about 1 minute."
    },
    {
      "position": 2,
      "text": "Turn skillet heat to high; add red wine and beef stock. Bring to a boil while scraping the browned bits off of the bottom of the pan with a wooden spoon. Reduce heat and simmer until flavors meld, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk sour cream and cornstarch together in a bowl. Mix into the wine/broth mixture. Stir in the browned beef mixture. Bring to a simmer, stirring frequently. Add salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

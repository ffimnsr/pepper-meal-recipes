  "id": "1718b36f-ea29-53e4-b6d8-5ab653531929",
  "slug": "tater-tot-casserole-iii",
  "name": "Green Bean Tater Tot Casserole",
  "recipe_type": "soup",
  "brief_description": "This hearty green bean Tater Tot casserole with ground beef and mushroom soup is sure to become a family favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Brown ground beef in a large skillet over high heat until browned and crumbly; drain fat. Stir in condensed soup, milk, garlic salt, and green beans. Pour mixture into a medium-sized casserole dish and top with a layer of tater tots."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until tater tots are browned and crispy, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

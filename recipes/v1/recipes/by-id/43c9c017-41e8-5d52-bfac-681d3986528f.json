  "id": "43c9c017-41e8-5d52-bfac-681d3986528f",
  "slug": "philly-cheese-steak-sloppy-joes",
  "name": "Philly Cheese Steak Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "Homemade Philly cheese steaks Sloppy-Joe style are quick and easy to make in one skillet and served on whole wheat buns.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Add bell peppers, onion, and garlic; saute until beginning to tenderize, about 5 minutes more."
    },
    {
      "position": 2,
      "text": "Stir water, cornstarch, bouillon, and Worcestershire sauce together in a bowl. Add to beef mixture in skillet. Cover with a lid and reduce heat to low. Simmer until sauce thickens and veggies are tender, 7 to 10 minutes. Season with salt and pepper. Add mozzarella cheese; cover until melted, about 2 minutes. Stir to combine."
    },
    {
      "position": 3,
      "text": "Serve beef mixture on buns, Sloppy Joe-style."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

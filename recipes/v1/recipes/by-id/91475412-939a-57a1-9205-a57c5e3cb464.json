  "id": "91475412-939a-57a1-9205-a57c5e3cb464",
  "slug": "bacon-and-tomato-quesadillas",
  "name": "Bacon and Tomato Quesadillas",
  "recipe_type": "snack",
  "brief_description": "It's like a Mexican version of a BLT! You choose whether you want it smoky or zesty by the flavor of petite diced tomatoes you use. Crispy bacon and fresh basil add a new variation to the classic quesadilla. A perfect party finger food or quick snack.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Layer on half of each tortilla: 1/4 cup cheese, 2 tablespoons diced tomatoes. 1 tablespoon bacon and 1 tablespoon basil. Fold each tortilla in half to form a half circle."
    },
    {
      "position": 2,
      "text": "Lightly coat a large nonstick skillet or griddle with oil. Cook each quesadilla, over medium-high heat for 1 1/2 minutes on each side until cheese is melted and tortilla is lightly browned."
    },
    {
      "position": 3,
      "text": "Cut the quesadilla into 4 wedges and serve with sour cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

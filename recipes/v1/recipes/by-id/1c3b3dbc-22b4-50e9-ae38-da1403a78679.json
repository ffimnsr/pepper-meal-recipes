  "id": "1c3b3dbc-22b4-50e9-ae38-da1403a78679",
  "slug": "air-fryer-chicken-thigh-schnitzel",
  "name": "Air Fryer Chicken Thigh Schnitzel",
  "recipe_type": "main",
  "brief_description": "This air fryer chicken schnitzel recipe is an easy way to cook breaded chicken thighs in the air fryer until crispy for a flavorful spin on a classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken thighs, one at a time, between 2 sheets of parchment paper and flatten with a mallet."
    },
    {
      "position": 2,
      "text": "Combine bread crumbs, salt, and black pepper in a shallow bowl. Place flour in a separate shallow bowl and beaten egg in a third shallow bowl. Dip chicken thighs first in flour, then in beaten egg. Finally, coat with seasoned bread crumbs."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Place breaded thighs in the air fryer basket, making sure they are not touching; work in batches if necessary. Mist with avocado oil and cook for 6 minutes. Flip each thigh, mist with oil, and cook an additional 3 to 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

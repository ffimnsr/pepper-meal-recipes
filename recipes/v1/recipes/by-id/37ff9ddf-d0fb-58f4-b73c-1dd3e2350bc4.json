  "id": "37ff9ddf-d0fb-58f4-b73c-1dd3e2350bc4",
  "slug": "honey-cake-iii",
  "name": "Orange Honey Cake",
  "recipe_type": "dessert",
  "brief_description": "This is a simple orange and honey cake made from scratch; frost with your favorite frosting and grated orange zest for a sweeter treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, baking soda, salt and cinnamon together; set aside."
    },
    {
      "position": 3,
      "text": "Combine sugar, honey, oil, eggs and orange zest in a large bowl. Beat in flour mixture alternately with the orange juice, mixing just until incorporated. Pour cake batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 40 to 50 minutes. Allow to cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

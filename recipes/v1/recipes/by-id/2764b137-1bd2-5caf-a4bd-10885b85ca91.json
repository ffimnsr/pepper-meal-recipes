  "id": "2764b137-1bd2-5caf-a4bd-10885b85ca91",
  "slug": "mince-pies",
  "name": "Mince Pies",
  "recipe_type": "dessert",
  "brief_description": "These mince pies are sweet and delicious, filled with homemade mincemeat made with dried fruit and spices for a traditional British Christmas treat!",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine apples, brown sugar, raisins, golden raisins, currants, orange peel, lemon zest, lemon juice, cinnamon, nutmeg, cloves, allspice, mace, and ginger in a medium saucepan. Mix together and bring to a boil over medium heat."
    },
    {
      "position": 3,
      "text": "Immediately turn the heat down to the lowest setting on your stovetop. Simmer, stirring frequently to ensure the mixture does not stick to the bottom of the pan, 1 1/2 to 2 hours. Remove from the heat and leave to cool while you prepare your pastry."
    },
    {
      "position": 4,
      "text": "Unroll pie crusts onto a flat surface. Cut into 24 circles using a cookie cutter or the bottom of a mug."
    },
    {
      "position": 5,
      "text": "Place a circle into the bottom of each cup of a 12-cup cupcake tin. Fill each of the pastry circles with fruit filling."
    },
    {
      "position": 6,
      "text": "Brush the edges of the pastry with some of the beaten egg and cover with the remaining circles. Brush all of the mince pies with more beaten egg."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 35 to 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 130,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

  "id": "507aed29-9fc7-5124-b058-e12e309070f8",
  "slug": "passover-apple-cake",
  "name": "Passover Apple Cake",
  "recipe_type": "dessert",
  "brief_description": "Want a cake recipe for Passover? This one uses apples, brown sugar, cinnamon, nutmeg, oil, and matzo. It might be the best apple cake you'll ever taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C ). Grease a 9x13-inch glass baking dish."
    },
    {
      "position": 2,
      "text": "Beat oil, sugar, and eggs in a large bowl with an electric mixer until well combined. Stir in matzo meal, potato starch, and 1 teaspoon cinnamon until incorporated. Set aside."
    },
    {
      "position": 3,
      "text": "Toss apples with 1/2 cup brown sugar, remaining 1 teaspoon cinnamon, and nutmeg in a separate large bowl."
    },
    {
      "position": 4,
      "text": "Add 1/2 the batter to the prepared baking dish. Pour apple mixture on top. Add remaining batter, patting over apples as needed. Sprinkle with some brown sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

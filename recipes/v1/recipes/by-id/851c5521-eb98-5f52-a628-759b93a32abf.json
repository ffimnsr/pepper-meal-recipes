  "id": "851c5521-eb98-5f52-a628-759b93a32abf",
  "slug": "easy-chicken-liver-pate",
  "name": "Easy Chicken Liver Pate",
  "recipe_type": "appetizer",
  "brief_description": "Homemade chicken liver with onion, apple, and plenty of butter is easy to prepare using a food processor and a little stovetop cooking.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Set aside 1/2 cup butter to soften slightly."
    },
    {
      "position": 2,
      "text": "Place onion and apple in a food processor with the steel knife blade; process until coarsely chopped."
    },
    {
      "position": 3,
      "text": "Melt 3 tablespoons butter in a large skillet over medium heat. Add onion and apple; cook and stir until lightly browned, 5 to 10 minutes. Return onion and apple to food processor."
    },
    {
      "position": 4,
      "text": "Melt 5 tablespoons butter in the same skillet over high heat; cook chicken livers until browned and just done inside, about 5 minutes. Reduce heat to low and pour in brandy; allow to warm up without stirring. Carefully light the liquid; let flames subside."
    },
    {
      "position": 5,
      "text": "Transfer chicken liver mixture to the food processor with onion and apple. Add cream and process until very smooth. Transfer mixture into a bowl and refrigerate until cool, at least 30 minutes."
    },
    {
      "position": 6,
      "text": "Cut the softened 1/2 cup butter into pieces and process in the food processor; add about 1/3 of the liver mixture and blend about 5 seconds. Repeat 2 more times with remaining liver mixture. Add lemon juice, salt, and pepper and blend well."
    },
    {
      "position": 7,
      "text": "Transfer pate to a serving dish or several small dishes; top with 1 tablespoon melted butter. Cover loosely with plastic wrap; refrigerate until chilled and set, about 3 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "28b98c69-eaaa-5daf-9e03-1dce28544345",
  "slug": "quick-air-fryer-chicken-parmesan",
  "name": "Quick Air Fryer Chicken Parmesan",
  "recipe_type": "main",
  "brief_description": "This quick chicken Parmesan in the air fryer is made with frozen breaded chicken fillets which cuts down on prep time. Perfect for dorm cooking.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, set 2 chicken fillets into the air fryer basket."
    },
    {
      "position": 4,
      "text": "Air fry chicken fillets for 6 minutes. Flip fillets over and cook for 6 minutes on the other side. Spread marinara sauce over fillets. Top each fillet with mozzarella slices. Air fry until cheese is melted, about 3 more minutes."
    },
    {
      "position": 5,
      "text": "Drain spaghetti noodles and divide noodles between 2 bowls. Carefully add a chicken fillet to each bowl. Garnish with basil."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

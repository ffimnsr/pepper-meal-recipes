  "id": "dbf5e523-b2a7-57dd-88a3-53a04f1d79b7",
  "slug": "christmas-tree-cheese-ball",
  "name": "Christmas Tree Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Your cheese ball will be the hit of the party when you shape it into a Christmas tree shape and cover it with chopped parsley 'needles' and pecan and bell pepper 'garlands'.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese, Cheddar cheese, onion, and Worcestershire sauce together in a bowl with an electric mixer until completely blended. Turn cheese mixture onto a sheet of waxed paper and form it into the shape of a Christmas tree. Refrigerate cheese 'tree' until firm, at least 1 hour."
    },
    {
      "position": 2,
      "text": "Cut bell pepper into thin strips and 1 star shape."
    },
    {
      "position": 3,
      "text": "Press parsley into cheese tree to cover. Press bell pepper strips in a row to form a 'garland'. Make another 'garland' using chopped pecans. Place bell pepper star at the top of the 'tree'. Carefully transfer 'tree' to a serving platter."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

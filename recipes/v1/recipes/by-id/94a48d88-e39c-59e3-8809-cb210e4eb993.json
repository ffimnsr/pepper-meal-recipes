  "id": "94a48d88-e39c-59e3-8809-cb210e4eb993",
  "slug": "church-windows-i",
  "name": "Church Window Cookies",
  "recipe_type": "dessert",
  "brief_description": "Church window cookies are a deliciously easy, no-bake, festive chocolate treat with coconut and colorful marshmallows to look like stained glass windows.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place butter in a 2 \u00bd quart glass or metal bowl. Place the bowl over a 3-quart saucepan of gently boiling water (upper bowl should not touch water). Cook over the simmering water until butter is melted."
    },
    {
      "position": 3,
      "text": "Add chocolate chips; stir until melted, then remove from heat. Let cool 10 minutes at room temperature, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Add marshmallows to melted chocolate; gently stir to coat."
    },
    {
      "position": 5,
      "text": "Place two 15x18-inch pieces of parchment paper on work surface. Place half of the chocolate-marshmallow mixture onto the middle of each piece of parchment and shape into a 12-inch long log using a rubber spatula."
    },
    {
      "position": 6,
      "text": "Wrap logs tightly in the parchment and transfer to refrigerator; chill logs for 30 minutes."
    },
    {
      "position": 7,
      "text": "Place two new 15x18-inch pieces of parchment paper on work surface and sprinkle each with 1 cup flaked coconut. Carefully transfer chilled logs (they will still be soft) to the new pieces of parchment with coconut."
    },
    {
      "position": 8,
      "text": "Roll logs in coconut and gently press to fully cover outside and sides."
    },
    {
      "position": 9,
      "text": "Wrap coated logs tightly in the new parchment paper and chill until firm, at least 4 hours up to overnight."
    },
    {
      "position": 10,
      "text": "When well chilled, cut into 1/2-inch thick slices."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

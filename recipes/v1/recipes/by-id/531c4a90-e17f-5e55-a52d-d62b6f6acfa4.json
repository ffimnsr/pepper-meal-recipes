  "id": "531c4a90-e17f-5e55-a52d-d62b6f6acfa4",
  "slug": "ham-and-beans",
  "name": "Ham and Beans",
  "recipe_type": "soup",
  "brief_description": "This ham and beans recipe combines great northern beans with leftover diced ham, onion, brown sugar, and spices, for a comforting and delicious meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse beans; transfer to a large stockpot. Cover with cold water and let stand overnight or at least 8 hours. Drain and rinse beans."
    },
    {
      "position": 3,
      "text": "Return beans to stockpot; add ham, onion, sugar, parsley, and cayenne pepper. Pour in enough water to cover and season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Bring to a boil; reduce heat to low and simmer until beans are tender, adding more water if needed, about 1 1/2 to 2 hours."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

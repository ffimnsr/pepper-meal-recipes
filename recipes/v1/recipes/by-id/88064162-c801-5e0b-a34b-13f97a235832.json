{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "88064162-c801-5e0b-a34b-13f97a235832",
  "slug": "key-lime-pretzel-salad-bars-recipe-12022290",
  "name": "Key Lime Pretzel Salad Bars",
  "recipe_type": "salad",
  "brief_description": "These Key lime pretzel salad bars are layered bars on a salty, crunchy pretzel crust that also taste like a sensational Key lime pie. A fluffy layer of cream cheese and whipped topping with lime juice is topped with a lime jello layer, chilled, and then garnished with thin wheels of Key lime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (180 degrees C). Generously coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "To make the crust: Stir pretzels, butter, lime zest, and 3 tablespoons sugar together in a bowl until well combined. Press the mixture evenly into the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, 8 to 10 minutes. Cool on a wire rack for 15 minutes."
    },
    {
      "position": 4,
      "text": "To make the filling: Beat cream cheese, Key lime juice, and 1 cup sugar in a large bowl with an electric mixer until smooth. Fold in whipped topping until combined. Spread evenly over the cooled crust. Chill, uncovered, for 20 minutes."
    },
    {
      "position": 5,
      "text": "To make the topping: Bring 2 1/4 cups water to a boil in a saucepan over medium-high heat. Whisk in Jell-O until dissolved, about 2 minutes. Remove from the heat, whisk in ice-cold water, and transfer to a medium heat-proof bowl. Chill, uncovered, until slightly thickened, about 20 minutes."
    },
    {
      "position": 6,
      "text": "Carefully pour chilled Jell-O mixture over the chilled cream cheese layer. Refrigerate, uncovered, until set, at least 2 hours or overnight. Garnish with thin Key lime wheels before serving. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

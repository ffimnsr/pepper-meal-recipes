  "id": "b06ab9b5-ed6c-5e13-8e24-5731d0e5880c",
  "slug": "weeknight-shepherds-pie",
  "name": "Weeknight Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Canned potatoes make wholesome, homemade meals like this classic Shepherd's Pie a reality any night of the week.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In 12-inch skillet over medium heat, in hot oil, cook onion and garlic 5 minutes or until softened, stirring occasionally. Remove to plate."
    },
    {
      "position": 2,
      "text": "In same skillet over medium-high heat, cook ground beef until well browned on all sides, stirring frequently. Add flour; cook 1 minute. Add stewed tomatoes and thyme. Over high heat, heat to boiling; reduce heat to low. Simmer uncovered 10 minutes to blend flavors, stirring occasionally. Stir in peas and carrots."
    },
    {
      "position": 3,
      "text": "Preheat oven to 450 degrees F. Spoon mixture into greased deep-dish pie plate or baking dish. Toss sliced potatoes with butter. Arrange potatoes in center of casserole, overlapping slightly. Bake 10 to 15 minutes or until potatoes are lightly golden."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

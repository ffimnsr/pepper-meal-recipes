  "schema_version": 1,
  "id": "396915d9-a7b6-59b8-ad46-6100215ebf78",
  "slug": "mini-crab-cakes-with-curried-tartar-sauce",
  "name": "Mini Crab Cakes with Curried Tartar Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Deliciously flavored mini crab cake balls are served with a tasty curried tartar sauce that really sets this recipe apart.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix mayonnaise, relish, mustard, hot sauce, garam masala, and cilantro for tartar sauce in a bowl until well blended. Cover and chill in the refrigerator until flavors have blended, about 1 hour."
    },
    {
      "position": 2,
      "text": "Melt butter in a frying pan. Add celery, onion, and bell peppers; saute until soft, about 5 minutes. Transfer to a bowl and set aside to cool."
    },
    {
      "position": 3,
      "text": "Place bread crumbs and crabmeat in a large bowl. Add cooled vegetables, eggs, seafood seasoning, pepper, and cayenne; mix until well blended and moist. Form crab mixture into 1 1/2- to 2-inch balls."
    },
    {
      "position": 4,
      "text": "Heat oil in a frying pan over medium or medium-low heat. Add crab balls and flatten the tops with a spatula. Fry to a golden brown, about 5 minutes. Carefully flip and repeat to brown the other side. Drain on a wire rack."
    },
    {
      "position": 5,
      "text": "Serve with curried tartar sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

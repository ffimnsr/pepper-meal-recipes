{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8e45350b-00b8-555d-94a7-14c03a6036c8",
  "slug": "oven-baked-chicken-and-vegetables-in-foil",
  "name": "Oven-Baked Chicken and Vegetables in Foil",
  "recipe_type": "main",
  "brief_description": "Chicken bakes nicely wrapped in foil in the oven. This recipe includes the veggies with the chicken for ease.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut an 18-inch wide roll of heavy-duty aluminum foil into six 12-inch long pieces."
    },
    {
      "position": 3,
      "text": "Slice each chicken breast in half lengthwise, so the thickest part is about 1/2 inch thick and season with salt and pepper to taste. Set each seasoned chicken breast onto a single piece of aluminum foil."
    },
    {
      "position": 4,
      "text": "Combine olive oil, garlic, salt, and pepper in a large bowl. Add sliced carrots, parsnip, red bell peppers, and mushrooms. Stir to combine vegetables with the seasoned oil. Set an even amount of vegetables on top of each piece of chicken."
    },
    {
      "position": 5,
      "text": "Top vegetables with a whole slice of red onion and place a sprig of fresh rosemary on top of the onion."
    },
    {
      "position": 6,
      "text": "Fold aluminum like a book cover over the top of each serving and crimp the edges all around tightly together."
    },
    {
      "position": 7,
      "text": "Place foil packets with the chicken on the bottom onto a 12x18-inch rimmed baking sheet."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, 25 to 30 minutes. Watch out for any steam when you check the chicken for doneness. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 9,
      "text": "Remove foil packets from the oven, open the packets, and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

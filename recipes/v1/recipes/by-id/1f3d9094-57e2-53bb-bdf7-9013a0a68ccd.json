  "id": "1f3d9094-57e2-53bb-bdf7-9013a0a68ccd",
  "slug": "crispy-french-dip-rolls-recipe-11930831",
  "name": "Crispy French Dip Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These crispy French dip rolls are buttery, air fried rollups of thinly sliced deli roast beef and provolone, dipped in a rich jus. They're easy to make and fun to eat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together beef consomm\u00e9, French onion soup, and water in a saucepan. Bring to a simmer over medium heat."
    },
    {
      "position": 2,
      "text": "Add roast beef; cook until heated through, about 2 minutes. Using tongs, transfer roast beef to a plate, letting any excess liquid drip back into saucepan. Reserve jus in saucepan."
    },
    {
      "position": 3,
      "text": "Place bread slices on a work surface. Use a rolling pin to flatten each slice on both sides until smooth and evenly thin."
    },
    {
      "position": 4,
      "text": "Place 1 provolone cheese slice and about 2 slices (about 1 1/4 oz.) of roast beef over each bread slice. Roll bread tightly from short side, pressing seams gently to adhere. Place roll-ups seam side down. Brush each roll-up on all sides with melted butter."
    },
    {
      "position": 5,
      "text": "Lightly coat an air fryer basket with cooking spray. Arrange 6 rolls seam-side down in air fryer basket in a single layer. Cook at 400 degrees F (200 degrees C) until toasted, golden, and crisp, about 5 minutes. Repeat with remaining 6 rolls."
    },
    {
      "position": 6,
      "text": "Divide hot jus among 4 small bowls. Serve rolls with jus for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

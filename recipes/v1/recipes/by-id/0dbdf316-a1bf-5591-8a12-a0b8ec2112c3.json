  "id": "0dbdf316-a1bf-5591-8a12-a0b8ec2112c3",
  "slug": "shrimp-etouffee-ii",
  "name": "Microwave Shrimp \u00c9touff\u00e9e",
  "recipe_type": "soup",
  "brief_description": "This spicy shrimp \u00e9touff\u00e9e recipe with tomato paste, parsley, hot peeper sauce, and cayenne is easy to make in your microwave!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a 2-quart microwave safe dish, combine butter, onion, green onion, bell pepper, garlic and celery. Heat on High settings for 8 to 9 minutes."
    },
    {
      "position": 2,
      "text": "Stir in parsley, tomato paste, soup, shrimp, salt, hot pepper sauce and cayenne. Heat on High setting for 5 minutes. Stir and cook for another 5 minutes until mixture thickens. Serve over white rice."
    }
  ],
  "servings": 6,

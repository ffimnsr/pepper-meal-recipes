  "slug": "three-pepper-pesto",
  "name": "Three Pepper Pesto",
  "recipe_type": "appetizer",
  "brief_description": "Red bell peppers, black pepper, and red pepper flakes are blended with basil and Parmesan cheese in this bright and flavorful pesto. Serve this chilled or at room temperature with toasted bread and fresh vegetables as an easy, make-ahead appetizer.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the Parmesan cheese and olive oil in a blender or food processor; blend until smooth. Add the red bell pepper, basil, red pepper flakes, and black pepper; blend again until smooth."
    }
  ],
  "servings": 12,

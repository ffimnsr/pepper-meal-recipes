  "id": "cdd856f1-1037-522e-bd51-b778ffa1f5a2",
  "slug": "no-sugar-oatmeal-cookies",
  "name": "No-Sugar-Added Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "Low in sugar, these oatmeal cookies sweetened with only applesauce, bananas, and raisins are still sweet enough to satisfy your sweet tooth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Stir oats, bananas, raisins, applesauce, almond milk, vanilla, and cinnamon together in a bowl until well combined."
    },
    {
      "position": 4,
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the edges are golden, 15 to 20 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "96854331-7fd1-5b6b-8ae7-8d76373c8332",
  "slug": "red-sangria-with-truvia-natural-sweetener",
  "name": "Red Sangria with Truvia\u00ae Natural Sweetener",
  "recipe_type": "dessert",
  "brief_description": "The flavor of this red sangria is brimming with fruit and a spicy twist. Enjoy it over lots of ice on a hot summer night. Sweetened with Truvia\u00ae natural sweetener, this refreshing drink contains only 80 calories per serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spiced Simple Syrup: Place all of the ingredients in a medium saucepot, stir."
    },
    {
      "position": 2,
      "text": "Place on high heat, bring to a boil. Reduce heat, and simmer 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat, allow to cool completely."
    },
    {
      "position": 4,
      "text": "Pour syrup through a strainer to remove spices."
    },
    {
      "position": 5,
      "text": "Pour syrup into a jar with lid and store refrigerated. Shake before using."
    },
    {
      "position": 6,
      "text": "Sangria: Combine wine, 3/4 cup spiced simple syrup, sparkling water, orange juice, and fruit slices. Stir briskly."
    },
    {
      "position": 7,
      "text": "Serve over ice in large red wine glasses."
    }
  ],
  "servings": 10,

  "schema_version": 1,
  "id": "18c5bd13-a97f-56c3-935f-972212dcfbdb",
  "slug": "penne-rosa-with-parmesan-crusted-chicken",
  "name": "Penne Rosa with Parmesan Crusted Chicken",
  "recipe_type": "main",
  "brief_description": "Savory slices of chicken breast served with penne pasta and a rose-colored tomato Alfredo sauce make a delicious meal in under an hour.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Cook penne in boiling water, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, add beaten egg whites to a shallow bowl. Place 2 cups Parmesan cheese into a second shallow bowl."
    },
    {
      "position": 4,
      "text": "Dip chicken into egg whites. Press chicken into Parmesan cheese to coat both sides. Gently toss between your hands, so excess cheese falls away. Place coated chicken on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake chicken in the preheated oven until no longer pink in the center and the juices run clear, about 18 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Meanwhile, heat Alfredo sauce, diced tomatoes, tomato sauce, and red pepper flakes in a large saucepan over low heat. Allow sauce to simmer while you finish the remaining steps."
    },
    {
      "position": 7,
      "text": "Heat a large skillet over medium-high heat; cook and stir mushrooms and spinach in the hot skillet until mushrooms are tender, about 5 minutes. Stir vegetables into sauce."
    },
    {
      "position": 8,
      "text": "Place cooked penne into a serving bowl; slice chicken into small pieces and arrange over pasta. Pour sauce over pasta and chicken. Sprinkle with remaining 1 cup Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

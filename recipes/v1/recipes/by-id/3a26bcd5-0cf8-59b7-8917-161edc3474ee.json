  "id": "3a26bcd5-0cf8-59b7-8917-161edc3474ee",
  "slug": "air-fried-vegetarian-chicken-tenders",
  "name": "Air Fried Vegetarian \"Chicken Tenders\"",
  "recipe_type": "main",
  "brief_description": "Adapted for an air fryer, this vegetarian 'chicken tenders' recipe made with imitation chicken breast is crispy without a lot of oil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour flour onto a large plate. Place eggs in a shallow bowl. Combine bread crumbs, garlic powder, paprika, cayenne pepper, black pepper, chili powder, and salt in another shallow bowl."
    },
    {
      "position": 2,
      "text": "Coat imitation chicken strips in flour, dip into eggs, then dredge in bread crumb mixture, and place on a plate."
    },
    {
      "position": 3,
      "text": "Heat an air fryer to 500 degrees F (260 degrees C)."
    },
    {
      "position": 4,
      "text": "Place a row of coated strips in the air fryer basket. Spray with a light coat of cooking spray."
    },
    {
      "position": 5,
      "text": "Cook strips in the air fryer for 6 minutes. Open fryer to flip strips with tongs. Continue cooking until golden brown, 4 to 6 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

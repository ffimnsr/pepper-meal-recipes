  "id": "dc9225c2-80cc-56bf-8580-55f224ec5a55",
  "slug": "mini-sweet-potato-pumpkin-pies",
  "name": "Mini Sweet Potato Pumpkin Pies",
  "recipe_type": "dessert",
  "brief_description": "Everyone can get their own personalized mini sweet potato pie topped with whipped cream and a walnut half for Thanksgiving or Christmas.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place the white of the separated egg in a small bowl and the yolk in a large bowl."
    },
    {
      "position": 3,
      "text": "Beat egg white and brush the edges of each pie crust with egg white."
    },
    {
      "position": 4,
      "text": "Add the second whole egg to the egg yolk; whisk together."
    },
    {
      "position": 5,
      "text": "Stir sweet potatoes, pumpkin pie filling, sugar, butter, milk, pumpkin pie spice, and vanilla extract into the egg and yolk."
    },
    {
      "position": 6,
      "text": "Spoon mixture evenly into the pie crusts. Place pies on a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until middle of each pie is set, about 15 minutes. Cool pies for 15 minutes."
    },
    {
      "position": 8,
      "text": "Place 1 tablespoon whipped cream atop each pie; gently press 1 walnut half into the whipped cream of each pie."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

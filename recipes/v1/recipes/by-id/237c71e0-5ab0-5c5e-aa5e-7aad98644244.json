  "id": "237c71e0-5ab0-5c5e-aa5e-7aad98644244",
  "slug": "broken-glass-cake",
  "name": "Broken Glass Cake",
  "recipe_type": "salad",
  "brief_description": "This broken glass cake is easy to make with 3 different colors of gelatin and whipped cream in a graham cracker crust for a fun retro dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place lime, orange, and strawberry gelatin mixes into 3 separate 9x9-inch glass dishes."
    },
    {
      "position": 3,
      "text": "Pour 1 cup boiling water into each flavor of gelatin mix; stir the gelatin until dissolved."
    },
    {
      "position": 4,
      "text": "Pour 1 cup cold water into each flavor of gelatin, stir to combine, and refrigerate the 3 flavors of gelatin until set, at least 4 hours."
    },
    {
      "position": 5,
      "text": "Heat pineapple juice in a saucepan until hot but not simmering. Stir unflavored gelatin into pineapple juice until dissolved. Refrigerate pineapple juice mixture until cool and thickened, about 30 minutes. Stir occasionally."
    },
    {
      "position": 6,
      "text": "Mix graham cracker crumbs, melted butter, and brown sugar together in a bowl. Set 1 cup of crumb mixture aside for garnish. Press remaining 2 cups crumb mixture into the bottom of a 9x13-inch cake pan to make a crust."
    },
    {
      "position": 7,
      "text": "Pour cream into a large metal mixing bowl and beat with an electric mixer until the cream is fluffy and forms soft peaks, about 3 minutes. Slowly beat sugar into whipped cream, 1 or 2 tablespoons at a time; beat in vanilla extract."
    },
    {
      "position": 8,
      "text": "Cut the different flavors of gelatin into cubes. Use a thin spatula to lift the cubes away from the bottom of the dish and loosen them."
    },
    {
      "position": 9,
      "text": "Very gently fold the thickened pineapple juice and gelatin cubes into the whipped cream mixture until thoroughly combined. Spoon into the graham cracker crust."
    },
    {
      "position": 10,
      "text": "Sprinkle the cake with reserved graham cracker crumb mixture."
    },
    {
      "position": 11,
      "text": "Refrigerate until set, at least 3 hours to overnight."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

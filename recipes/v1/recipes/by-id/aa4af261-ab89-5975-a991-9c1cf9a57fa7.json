  "id": "aa4af261-ab89-5975-a991-9c1cf9a57fa7",
  "slug": "jalapeno-snacks",
  "name": "Jalapeno Snacks",
  "recipe_type": "appetizer",
  "brief_description": "These bacon-wrapped, cream cheese-stuffed jalapenos are addictive.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together the cream cheese, Cheddar cheese, mayonnaise, ranch dressing mix, and garlic powder in a mixing bowl until evenly blended. Spoon some of the cheese mixture into each jalapeno half, wrap with half a bacon strip, and secure with a toothpick. Arrange the wrapped jalapeno halves onto a broiler pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the bacon is no longer pink and beginning to brown, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

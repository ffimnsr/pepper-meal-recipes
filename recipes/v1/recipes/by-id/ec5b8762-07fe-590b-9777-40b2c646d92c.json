  "id": "ec5b8762-07fe-590b-9777-40b2c646d92c",
  "slug": "red-snapper-cocktail-recipe-11816669",
  "name": "Red Snapper Cocktail",
  "recipe_type": "appetizer",
  "brief_description": "This red snapper cocktail is a sophisticated spin on the Bloody Mary, blending botanical gin with savory tomato, bright lemon, and a subtle kick of spice. Customize with your favorite garnishes like olives, pickles, or cheese cubes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle celery salt onto a plate. Moisten the rim of a highball or pint glass with lime wedge. Press the moistened rim into the salt. Fill the glass with ice."
    },
    {
      "position": 2,
      "text": "Add gin, lemon juice, Tabasco sauce, Worcestershire sauce, and tomato juice to the glass. Sprinkle with a pinch of celery salt, if desired, then gently stir to combine. Garnish with lime wedge, celery stick, and any additional toppings."
    }
  ],

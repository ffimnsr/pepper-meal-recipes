  "id": "4bfd2e97-662e-5b1b-96c2-3e26379f09c6",
  "slug": "enchanted-sour-cream-chicken-enchiladas",
  "name": "Enchanted Sour Cream Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "Sour cream and chicken fill these quick and easy enchiladas.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Grease a 9x13 inch baking dish. Combine the chicken, sour cream, salt, and pepper in a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Heat the oil in a skillet over medium-high heat. Dip the corn tortillas into the hot oil one at a time until softened, about 10 seconds each."
    },
    {
      "position": 3,
      "text": "Spoon a heaping tablespoon of chicken mixture onto each tortilla, spread down the center and roll into a cylinder. Place seam side down into the prepared baking dish."
    },
    {
      "position": 4,
      "text": "When all tortillas are filled and rolled, sprinkle the green chiles over all and top with the shredded Monterey Jack cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the cheese has melted and the enchiladas are hot, 12 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

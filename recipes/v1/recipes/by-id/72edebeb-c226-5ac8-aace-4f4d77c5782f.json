  "slug": "herb-watermelon-feta-salad",
  "name": "Watermelon Feta Salad",
  "recipe_type": "salad",
  "brief_description": "This watermelon feta salad made with seedless watermelon, crumbled feta, red onion, and mint, is dressed with lime and balsamic for a refreshing summer salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Gently toss watermelon, onion, basil, cilantro, mint, lime juice, feta cheese, olive oil, balsamic vinegar, salt, and black pepper together in a large bowl."
    }
  ],

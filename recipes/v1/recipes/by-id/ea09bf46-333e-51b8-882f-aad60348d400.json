  "id": "ea09bf46-333e-51b8-882f-aad60348d400",
  "slug": "chef-johns-italian-sausage-chili",
  "name": "Chef John's Italian Sausage Chili",
  "recipe_type": "soup",
  "brief_description": "Chef John's Italian sausage chili combines cannellini beans, red and green bell peppers, and onion for comforting dish with a spicy kick.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium-high heat. Cook and stir hot and mild Italian sausage, onion, and a pinch of salt in hot oil until sausage is browned and crumbly, and most of the liquid is evaporated, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in ancho chile powder, paprika, cumin, black pepper, chipotle chile powder, and oregano; saut\u00e9 until fragrant, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour in water and tomato pur\u00e9e; bring to a simmer. Reduce heat to medium-low and cook at a steady simmer until sausage is tender, about 45 minutes. Add more water as needed and skim any fat that floats to the top."
    },
    {
      "position": 4,
      "text": "Stir in beans and bell peppers. Simmer until vegetables are tender, about 30 minutes. Season with salt."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "schema_version": 1,
  "id": "2f23fe12-2ccc-5d80-99fb-0b0cb7141548",
  "slug": "instant-pot-shrimp-risotto",
  "name": "Instant Pot Shrimp Risotto",
  "recipe_type": "main",
  "brief_description": "This shrimp risotto comes together in a snap in an Instant Pot so you don't need to stand at the stove and stir.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat seafood stock in a microwave-safe container for about 3 minutes on High. Leave in the microwave until ready to use."
    },
    {
      "position": 2,
      "text": "Slice green onions. Separate green and white parts."
    },
    {
      "position": 3,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Melt 1 tablespoon butter. Add garlic and white part of the green onions. Season with salt and pepper and cook, stirring, until onion has softened and garlic is fragrant, about 2 1/2 minutes. Add rice and thyme. Saute, stirring occasionally, until rice begins to have a little color, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Pour in wine and cook, stirring, until wine evaporates, about 30 seconds. Stir in the heated seafood stock, making sure contents of the pot move freely. Turn off Saute function."
    },
    {
      "position": 5,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 6,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Add shrimp, peas, and reserved green onion tops. Close the lid and allow the shrimp to cook using the Keep Warm function, about 7 minutes. Open lid and check to see if shrimp are done."
    },
    {
      "position": 7,
      "text": "Add grated Parmesan cheese and remaining 1 tablespoon butter, stirring until butter is melted. Serve with fresh parsley and lemon wedges."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "0127f294-3a55-5002-b0b4-7f76452ffcdd",
  "slug": "chicken-gyros",
  "name": "Chicken Gyros",
  "recipe_type": "main",
  "brief_description": "Roasted vegetables and marinated chicken join homemade tzatziki in these light and fresh chicken gyro sandwiches.",
  "cuisine": "Greek Inspired American Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Cut chicken into large cubes. Soak bamboo skewers in water."
    },
    {
      "position": 2,
      "text": "Whisk lemon juice, olive oil, lemon zest, garlic, thyme, rosemary, oregano, salt, and pepper for marinade together in a large glass or ceramic bowl. Add chicken and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for at least 20 minutes."
    },
    {
      "position": 3,
      "text": "Mix yogurt, cucumber, garlic, olive oil, dill, vinegar, and salt for tzatziki together in a small bowl. Place in the refrigerator to marinate the flavors until chicken and vegetables are cooked."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line two baking sheets with foil."
    },
    {
      "position": 5,
      "text": "Toss onion, bell pepper, olive oil, salt, black pepper, and garlic powder for veggies together in a large bowl. Pour onto one of the prepared baking sheets."
    },
    {
      "position": 6,
      "text": "Remove chicken from the marinade and shake off excess. Skewer chicken and place on the remaining baking sheet. Discard the remaining marinade."
    },
    {
      "position": 7,
      "text": "Place chicken in the preheated oven on the middle rack, and veggies on the bottom rack. Bake for 15 minutes. Remove veggies. Turn on the broiler and broil chicken until browned, about 2 minutes. An instant-read thermometer should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 8,
      "text": "Remove chicken from the oven. Pull off skewers and place in pitas. Top with cooked veggies, tzatziki, and Sriracha."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,

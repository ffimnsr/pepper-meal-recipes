  "id": "4ddab710-a781-5d4a-bcdb-6f487e4c0493",
  "slug": "chicken-and-tortellini-pesto-skillet",
  "name": "Chicken and Tortellini Pesto Skillet",
  "recipe_type": "main",
  "brief_description": "This delicious and easy chicken and tortellini pesto dinner is cooked in one pan and features a creamy cheese sauce with tomatoes and spinach.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add chicken to the skillet and season with salt and pepper. Saut\u00e9 until chicken is cooked through and has browned, 5 to 10 minutes. Remove from skillet and transfer to a bowl; cover to keep warm. Set aside."
    },
    {
      "position": 2,
      "text": "Deglaze pan with chicken broth over medium heat, scraping up any browned bits. Stir in pesto and heavy cream. Cook until thickened, 3 to 5 minutes. Mix in 1/2 cup Parmesan cheese and stir until melted. Add in spinach and tomatoes. Cook until spinach begins to wilt, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Add tortellini and cooked chicken and continue cooking until bubbly and hot, 5 to 10 minutes. Sprinkle with remaining 1/2 cup Parmesan cheese and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

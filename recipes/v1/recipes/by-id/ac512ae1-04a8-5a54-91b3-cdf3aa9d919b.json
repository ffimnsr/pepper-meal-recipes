  "id": "ac512ae1-04a8-5a54-91b3-cdf3aa9d919b",
  "slug": "king-ranch-chicken-salad-recipe-12031956",
  "name": "King Ranch Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This King Ranch chicken salad is a delicious, slightly spicy, Tex-Mex creamy chicken salad with added Cheddar, corn, and black beans. It\u2019s the perfect foil for corn tortilla chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mayonnaise, sour cream, chili powder, salt, onion powder, ground cumin, and oregano in a large bowl. Stir in diced tomatoes with green chile peppers."
    },
    {
      "position": 2,
      "text": "Add chicken, cheese, corn, beans, bell peppers, and jalape\u00f1os, if using. Stir until evenly coated."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate at least 1 hour before serving. Serve with tortilla chips."
    },
    {
      "position": 4,
      "text": "Garnish with chopped green onions and/or cilantro. Serve with corn tortilla chips. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "b06b64b9-ebc9-5763-adeb-39fe26ab100a",
  "slug": "cream-cheese-havarti-and-parmesan-herbed-christmas-tree",
  "name": "Cream Cheese, Havarti, and Parmesan Herbed Christmas Tree",
  "recipe_type": "appetizer",
  "brief_description": "Shape a cheese ball into a tree and coat it with fresh basil and parsley for a festive Christmas tree appetizer for your holiday party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese, Havarti cheese, Parmesan cheese, 2 tablespoons basil, lemon zest, and garlic together in a bowl. Transfer cream cheese mixture to a piece of plastic wrap. Roll the plastic wrap around cream cheese mixture forming a cone shape, resembling a tree."
    },
    {
      "position": 2,
      "text": "Stand the 'tree' upright and remove the plastic wrap. Cover the visible portion of the 'tree' with 1/4 cup basil and parsley."
    },
    {
      "position": 3,
      "text": "Gently wrap the 'tree' with a fresh sheet of plastic wrap and refrigerate until firm, about 2 hours."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

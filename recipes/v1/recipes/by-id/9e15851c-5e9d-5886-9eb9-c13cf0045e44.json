  "id": "9e15851c-5e9d-5886-9eb9-c13cf0045e44",
  "slug": "chicken-gumbo-soup",
  "name": "Chicken Gumbo Soup",
  "recipe_type": "soup",
  "brief_description": "Chicken gumbo soup with okra is cooked with chicken breast, wild rice and spiral shaped pasta in this rich stew seasoned with hot pepper sauce.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil. Season with garlic powder and hot pepper sauce. Add in carrots and mushrooms. Cook for 5 minutes."
    },
    {
      "position": 2,
      "text": "Add okra, wild rice, and chicken. Reduce the heat to low, and cook for 3 hours."
    },
    {
      "position": 3,
      "text": "Add pasta and cook for 10 minutes. Season with salt and pepper. Serve hot, garnished with green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 200,

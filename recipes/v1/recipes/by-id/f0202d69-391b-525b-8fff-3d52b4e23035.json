  "id": "f0202d69-391b-525b-8fff-3d52b4e23035",
  "slug": "garlic-cheese-grits-with-shrimp",
  "name": "Garlic Cheese Grits with Shrimp",
  "recipe_type": "side",
  "brief_description": "These cheese grits with shrimp are cooked with garlic-flavored processed cheese, and served with tomatoes.",
  "cuisine": "U.S. Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Cook grits according to package directions. Stir in cubed cheese and cayenne pepper. Keep warm over low heat."
    },
    {
      "position": 2,
      "text": "Heat butter and olive oil in a large skillet over medium-high heat. Saut\u00e9 garlic and tomato in hot butter-oil mixture until tomato begins to soften. Stir in shrimp and lemon juice. Saut\u00e9 until shrimp are bright pink on the outside and the meat is opaque. Season with salt."
    },
    {
      "position": 3,
      "text": "Spread warm grits on a serving platter and cover with shrimp mixture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

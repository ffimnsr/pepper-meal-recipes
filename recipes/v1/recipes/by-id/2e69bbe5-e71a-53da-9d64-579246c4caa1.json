{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2e69bbe5-e71a-53da-9d64-579246c4caa1",
  "slug": "air-fryer-baby-back-ribs",
  "name": "Air Fryer Baby Back Ribs",
  "recipe_type": "side",
  "brief_description": "This air fryer baby back ribs recipe uses a liquid smoke and dry spice rub plus a purchased barbecue sauce for a quick, easy, and tasty any night meal.",
  "cuisine": "Southern American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove and discard membrane from back of ribs; pat ribs dry with a paper towel. Cut rack into 4 pieces. Combine olive oil and liquid smoke in a small bowl; rub onto both sides of ribs."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, salt, black pepper, garlic powder, onion powder, and chili powder in a bowl. Generously season both sides of ribs with brown sugar mixture; set ribs aside to enhance the flavor, 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 4,
      "text": "Place ribs, bone-sides down, in the air fryer basket, making sure they are not touching, cook in batches if necessary. Cook for 15 minutes; flip ribs, meat-sides down, and cook 10 minutes more."
    },
    {
      "position": 5,
      "text": "Remove ribs from air fryer; brush 1/2 cup barbecue sauce onto bone-sides of ribs. Place basket back in the air fryer; cook 5 minutes. Flip ribs; brush meat-sides with remaining 1/2 cup barbecue sauce. Cook until desired char is achieved, about 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

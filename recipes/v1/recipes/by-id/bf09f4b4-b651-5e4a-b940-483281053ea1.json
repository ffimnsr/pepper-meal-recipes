  "id": "bf09f4b4-b651-5e4a-b940-483281053ea1",
  "slug": "old-fashioned-potato-salad",
  "name": "Old-Fashioned Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This classic potato salad recipe makes a creamy potato salad with hard-boiled eggs, celery, and relish. Perfect for summer BBQs, picnics, or potlucks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Drain, cool, peel, and chop potatoes."
    },
    {
      "position": 4,
      "text": "While potatoes cook, place eggs in a saucepan and cover with cold water. Bring water to a boil; cover, remove from heat, and let eggs stand in hot water for 10 to 12 minutes."
    },
    {
      "position": 5,
      "text": "Remove eggs from hot water; cool, peel, and chop into chunks."
    },
    {
      "position": 6,
      "text": "Combine potatoes, eggs, celery, onion, relish, mayonnaise, mustard, garlic salt, celery salt, and pepper in a large bowl. Mix together until well combined."
    },
    {
      "position": 7,
      "text": "Chill potato salad in the refrigerator before serving for best flavor results. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

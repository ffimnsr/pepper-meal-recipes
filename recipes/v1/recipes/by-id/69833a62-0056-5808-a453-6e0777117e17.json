  "slug": "gluten-free-pastry",
  "name": "Gluten Free Pastry",
  "recipe_type": "dessert",
  "brief_description": "This gluten-free pastry dough is easy to make with rice flour. Perfect for using in all your favorite pie and pastry recipes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk rice flour, sugar, salt, and baking powder together in a bowl. Cut in shortening until the mixture resembles sand. Stir in water and vanilla extract until dough forms a ball."
    },
    {
      "position": 2,
      "text": "Wrap in plastic wrap and refrigerate, at least 1 hour or up to 3 days."
    }
  ],
  "servings": 8,

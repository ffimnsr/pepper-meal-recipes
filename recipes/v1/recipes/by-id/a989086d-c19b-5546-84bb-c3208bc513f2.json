  "id": "a989086d-c19b-5546-84bb-c3208bc513f2",
  "slug": "slow-cooker-mississippi-chicken-noodle-soup-recipe-11880950",
  "name": "Slow Cooker Mississippi Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This slow cooker mississippi chicken noodle soup has all the ingredients from a typical Mississippi chicken - ranch seasoning mix, au jus jus gravy mix, and pepperoncini peppers - which gives the soup a savory and slightly tangy flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, carrot, celery, pepperoncini peppers, onion, ranch dressing mix, and au jus mix in a 3 1/2- to 4-quart slow cooker. Pour broth over all."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low 5 to 6 hours or on High 2 1/2 to 3 hours, until an instant-read thermometer inserted into the thickest part of the chicken thighs reads at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove chicken from slow cooker. Shred chicken with 2 forks."
    },
    {
      "position": 4,
      "text": "Return shredded chicken and the egg noodles to the slow cooker. Stir in pepperoncini brine."
    },
    {
      "position": 5,
      "text": "Cook on High about 30 minutes, or until noodles are tender."
    },
    {
      "position": 6,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 330,
  "preparation_time_minutes": 15,

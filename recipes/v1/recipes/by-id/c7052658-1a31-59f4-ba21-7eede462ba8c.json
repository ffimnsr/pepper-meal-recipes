  "id": "c7052658-1a31-59f4-ba21-7eede462ba8c",
  "slug": "bang-bang-chicken-fried-rice-recipe-11770457",
  "name": "Bang Bang Chicken Fried Rice",
  "recipe_type": "main",
  "brief_description": "This bang bang chicken fried rice recipe is made with stir fried chicken, leftover rice, and vegetables. Spicy bang bang sauce takes it over the top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken breasts on a plate and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Cut chicken into bite-sized chunks. Heat oil in a wok or large skillet over medium heat. Add chicken and cook, stirring frequently, until chicken is browned and no longer pink at the center, about 5 minutes. Remove from wok and set aside."
    },
    {
      "position": 4,
      "text": "Add additional oil to the wok at medium heat. Add cooked rice and stir for about 1 minute. Add garlic and ginger; cook and stir for 1 minute more, then stir in egg and cook until egg is opaque, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Lower heat to medium-low, then return chicken to the wok. Stir to warm all the way through, then add in the soy sauce and sesame oil. Stir and taste, add more of either to your liking."
    },
    {
      "position": 6,
      "text": "Remove from heat and scoop into bowls. Top with green onions."
    },
    {
      "position": 7,
      "text": "For sauce, stir mayonnaise, sweet chili sauce, and hot sauce together in a bowl. Drizzle over chicken rice bowls before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

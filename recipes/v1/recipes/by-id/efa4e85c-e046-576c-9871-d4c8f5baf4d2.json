  "id": "efa4e85c-e046-576c-9871-d4c8f5baf4d2",
  "slug": "simple-yorkshire-pudding",
  "name": "Simple Yorkshire Pudding",
  "recipe_type": "side",
  "brief_description": "Rather than individual portions, this easy Yorkshire pudding recipe is baked in a baking dish to be cut and served as you wish.",
  "cuisine": "English American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a small glass baking dish; place in oven to heat while you prepare the pudding."
    },
    {
      "position": 2,
      "text": "Beat eggs with a pinch of salt in a bowl until smooth; add milk and flour and whisk until you have a smooth batter."
    },
    {
      "position": 3,
      "text": "Pour batter into the hot baking dish and bake in preheated oven until no longer wet in the center, 10 to 12 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "3b2db569-b9e2-5cf0-a879-d55762f7bba9",
  "slug": "quick-and-easy-brownies",
  "name": "Quick and Easy Brownies",
  "recipe_type": "dessert",
  "brief_description": "This easy brownie recipe makes rich and fudgy chocolate brownies from scratch with cocoa and simple baking ingredients in less than 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan with baking spray."
    },
    {
      "position": 3,
      "text": "Whisk sugar, flour, melted butter, eggs, cocoa powder, vanilla, baking powder, and salt in a large bowl until combined."
    },
    {
      "position": 4,
      "text": "Spread the batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Decorate with walnut halves."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top is crinkled and a toothpick comes out with a few moist crumbs, about 20 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Let cool completely in the pan on a wire rack before slicing into squares. Enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

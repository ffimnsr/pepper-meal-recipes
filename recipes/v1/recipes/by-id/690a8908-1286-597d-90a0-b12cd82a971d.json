  "id": "690a8908-1286-597d-90a0-b12cd82a971d",
  "slug": "stuffed-peppers-with-turkey-and-vegetables",
  "name": "Stuffed Peppers with Turkey and Vegetables",
  "recipe_type": "main",
  "brief_description": "Stuffed peppers with ground turkey makes an easy and hearty meal. Turkey and a variety of vegetables make a delicious filling for bell peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Gather all ingredients."
    },
    {
      "position": 3,
      "text": "Wrap green bell peppers in aluminum foil, and place in a baking dish. Bake for 15 minutes in the preheated oven. Remove from the oven."
    },
    {
      "position": 4,
      "text": "Cook turkey in a skillet over medium heat until evenly brown. Set aside. Heat oil in the skillet, and cook onion, mushrooms, zucchini, red bell pepper, yellow bell pepper, and spinach until tender. Return turkey to the skillet. Mix in tomatoes and tomato paste, and season with Italian seasoning, garlic powder, salt, and pepper. Stuff the green peppers with the skillet mixture."
    },
    {
      "position": 5,
      "text": "Return peppers to the oven, and continue cooking for 15 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

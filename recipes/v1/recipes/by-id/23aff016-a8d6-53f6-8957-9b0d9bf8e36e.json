  "id": "23aff016-a8d6-53f6-8957-9b0d9bf8e36e",
  "slug": "peanut-butter-cookies-iv",
  "name": "Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "A very delicious peanut butter cookie recipe that is easy to make. These cookies stay soft in an airtight container. For special occasions, press five peanut halves into the top before baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking soda, and salt in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Cream together butter, peanut butter, 1/2 cup white sugar, and brown sugar in a large bowl until smooth. Beat in egg, then stir in vanilla. Gradually blend in flour mixture until combined."
    },
    {
      "position": 4,
      "text": "Shape dough into 1-inch balls. Roll in 1/2 cup white sugar, then place 2 inches apart on ungreased cookie sheets. Use fork times to make a crisscross pattern on each dough ball."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are set, 10 to 12 minutes. Cool slightly, then remove cookies to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

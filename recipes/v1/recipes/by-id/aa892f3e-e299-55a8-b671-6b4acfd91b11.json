  "id": "aa892f3e-e299-55a8-b671-6b4acfd91b11",
  "slug": "french-canadian-gorton-pork-spread",
  "name": "French-Canadian Gorton Pork Spread",
  "recipe_type": "appetizer",
  "brief_description": "This gorton recipe features tender, shredded, braised pork cooked with onion and seasoned with cinnamon and clove in this French-Canadian favorite.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork, onion, cinnamon, and clove into a saucepan. Season with salt and pepper. Pour in enough water to just cover pork. Bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low and cook until water has nearly evaporated, about 1 hour. Stir occasionally to ensure pork cooks evenly."
    },
    {
      "position": 3,
      "text": "Use a potato masher or wire whisk to break pork into thin strands. Pour off any remaining liquid, then spoon gorton into a serving bowl. Refrigerate until cold before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 5,

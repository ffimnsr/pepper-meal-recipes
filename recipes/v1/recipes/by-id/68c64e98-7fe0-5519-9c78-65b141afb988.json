  "schema_version": 1,
  "id": "68c64e98-7fe0-5519-9c78-65b141afb988",
  "slug": "curry-stand-chicken-tikka-masala-sauce",
  "name": "Curry Stand Chicken Tikka Masala Sauce",
  "recipe_type": "main",
  "brief_description": "This tikka masala sauce is bright orange and richly flavored with onion, garlic, spices, tomato sauce, and cream, cooked with tender chicken chunks.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat ghee in a large skillet over medium heat. Add onion; cook and stir until translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in garlic; cook and stir just until fragrant, about 1 minute. Stir cumin, 1 teaspoon salt, ginger, cayenne pepper, cinnamon, and turmeric into onion mixture; fry until fragrant, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir tomato sauce into onion and spice mixture; bring to a boil and reduce heat to low."
    },
    {
      "position": 5,
      "text": "Simmer sauce for 10 minutes, then mix in cream, 1 tablespoon sugar, and paprika. Bring sauce back to a simmer and cook, stirring often, until sauce is thickened, 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Heat vegetable oil in a separate skillet over medium heat. Stir chicken into hot oil; add curry powder. Sear chicken until lightly browned but still pink inside, about 3 minutes; stir often."
    },
    {
      "position": 7,
      "text": "Transfer chicken and any pan juices into sauce. Simmer chicken in sauce until no longer pink, about 30 minutes; adjust sugar and salt to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

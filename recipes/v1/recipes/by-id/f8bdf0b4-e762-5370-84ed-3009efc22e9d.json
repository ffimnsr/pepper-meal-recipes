  "id": "f8bdf0b4-e762-5370-84ed-3009efc22e9d",
  "slug": "maui-wowie-shrimp",
  "name": "Maui Wowie Shrimp",
  "recipe_type": "appetizer",
  "brief_description": "This quick and easy Maui-inspired shrimp is coated in mayonnaise and grilled to produce a perfectly golden brown and tasty appetizer. It is perfect for backyard or beach grilling.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat outdoor grill for medium heat, and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Thread shrimp onto skewers. Season both sides of shrimp with garlic salt and black pepper; if using cayenne, see Cook\u2019s Note."
    },
    {
      "position": 3,
      "text": "Generously coat both sides of shrimp with mayonnaise."
    },
    {
      "position": 4,
      "text": "Cook shrimp on heated grill until shrimp are bright pink on the outside and opaque on the inside, and the mayonnaise turns golden brown, 5 to 10 minutes on each side. Serve with lemon wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

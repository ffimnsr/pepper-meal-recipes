  "id": "b3811147-399d-5cfc-99d6-91afb10a5fdd",
  "slug": "avocado-and-tuna-tapas",
  "name": "Avocado and Tuna Tapas",
  "recipe_type": "salad",
  "brief_description": "Avocado halves are filled with a tangy tuna salad in this Spanish tapas style tuna stuffed avocado. This light, healthy dish goes best with crisp white wines and crunchy bread.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together tuna, mayonnaise, green onions, red pepper, and balsamic vinegar in a bowl."
    },
    {
      "position": 3,
      "text": "Season with pepper and garlic salt, then pack the avocado halves with the tuna mixture."
    },
    {
      "position": 4,
      "text": "Garnish with reserved green onions and a dash of black pepper before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

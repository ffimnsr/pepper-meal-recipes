  "id": "e15a4490-82a0-52c6-9b6b-f68be895ee96",
  "slug": "key-lime-pie-vi",
  "name": "Key Lime Pie VI",
  "recipe_type": "dessert",
  "brief_description": "A Key Lime Pie made without sweetened condensed milk. It really enhances the flavor of the lime.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Separate the eggs. Beat the egg yolks and set the whites aside."
    },
    {
      "position": 3,
      "text": "Combine the 1 cup white sugar, flour, cornstarch and salt in a saucepan. Gradually stir in the water. Cook over medium heat until thickened."
    },
    {
      "position": 4,
      "text": "Gradually stir the cooked sugar mixture into the beaten egg yolks, beating constantly. Return the mixture to low heat and cook, stirring constantly, for 2 minutes. Stir in the butter, lime juice and lime zest. Let mixture cool slightly."
    },
    {
      "position": 5,
      "text": "Beat egg whites until light and frothy. Add the cream of tartar and continue beating until stiff peaks form. Gradually beat in the remaining 6 tablespoons white sugar and beat until the meringue is stiff and glossy."
    },
    {
      "position": 6,
      "text": "Pour the lime filling into the prepared pie shell. Then pile the meringue on top, spreading it until it touches the edges of the pastry to prevent the meringue from shrinking. Bake pie at 425 degrees F (220 degrees C) for 5 to 6 minutes or until meringue top is golden brown."
    }
  ],
  "servings": 8,

  "id": "eb9a7f72-ae82-572f-9aa0-3c08983eb0f9",
  "slug": "dill-pickle-cornbread-muffins-recipe-11709282",
  "name": "Dill Pickle Cornbread Muffins",
  "recipe_type": null,
  "brief_description": "These dill pickle cornbread muffins are a new twist on a cornbread muffin. Don\u2019t worry, the dill pickle flavor will not overwhelm, but you\u2019ll taste its subtle essence.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a standard 12-well muffin pan with nonstick cooking spray or line with paper muffin liners."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix cornmeal, flour, baking powder, sugar, and salt."
    },
    {
      "position": 3,
      "text": "Whisk milk, eggs, pickle brine, and butter together in a small bowl. Pour over flour mixture, and stir just until combined. Fold in dill pickle and red bell pepper. Spoon batter evenly into the prepared muffin pan, filling each cup about 2/3 full."
    },
    {
      "position": 4,
      "text": "Bake until muffins are starting to turn golden brown, 15 to 20 minutes, or until a toothpick inserted into the center comes out clean."
    },
    {
      "position": 5,
      "text": "Cool in the pan for about 5 minutes, then remove muffins to a wire rack. Serve warm or at room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

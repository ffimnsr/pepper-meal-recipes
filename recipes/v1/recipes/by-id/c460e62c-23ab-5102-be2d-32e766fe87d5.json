  "schema_version": 1,
  "id": "c460e62c-23ab-5102-be2d-32e766fe87d5",
  "slug": "dog-biscuits-ii",
  "name": "Meaty Homemade Dog Treats",
  "recipe_type": "snack",
  "brief_description": "It may be difficult for your pet to wait for these meaty homemade dog treats. These biscuits can be made with any type of cooked ground meat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly oil two cookie sheets."
    },
    {
      "position": 2,
      "text": "Stir together whole wheat flour, milk powder, beef bouillon, and salt in a medium bowl. Add ground pork, carrot, shortening and egg; mix in to the flour mixture while gradually adding water to form a stiff ball of dough."
    },
    {
      "position": 3,
      "text": "On a lightly floured surface, roll the dough out to 1/4 inch thickness. Cut into desired shapes using cookie cutters. Re-roll and cut scraps until no dough is left. Place cookies 2 inches apart onto the prepared cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the bottoms of the cookies are browned, 25 to 30 minutes. Allow cookies to set for a few minutes on the cookie sheet before removing to wire racks to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

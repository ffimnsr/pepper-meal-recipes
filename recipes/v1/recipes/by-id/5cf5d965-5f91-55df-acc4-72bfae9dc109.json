  "id": "5cf5d965-5f91-55df-acc4-72bfae9dc109",
  "slug": "white-sangria",
  "name": "White Sangria",
  "recipe_type": "drink",
  "brief_description": "This white sangria recipe is refreshingly easy to make with white wine, Cognac, peach Schnapps, ginger ale, and fruit for a Spanish summer punch.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine peach Schnapps, Cognac, sugar, sliced oranges, and sliced mangos in a pitcher; stir and chill for at least 1 hour."
    },
    {
      "position": 3,
      "text": "Pour fruit mixture into a large punch bowl; stir in chilled white wine and ginger ale."
    },
    {
      "position": 4,
      "text": "Serve sangria in glasses with some sliced fruit."
    }
  ],
  "servings": 32,

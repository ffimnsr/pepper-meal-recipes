  "id": "ab6eabb8-5544-5deb-b4b2-9b8c76073b2d",
  "slug": "honey-butter-zucchini-bread",
  "name": "Honey Butter Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "This buttery, honey-sweetened zucchini bread recipe, made with self-rising flour, is full of warm spices and studded with walnuts and coconut flakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Combine flour, cinnamon, salt, and nutmeg in a medium bowl until blended; set aside."
    },
    {
      "position": 3,
      "text": "Whisk sugar, eggs, oil, butter, honey, and vanilla together in a large bowl until well combined. Stir in zucchini, walnuts, and coconut. Add flour mixture; stir until well combined. Divide batter between the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool completely. Store loaves in plastic bags 8 hours to overnight for the best flavor."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,

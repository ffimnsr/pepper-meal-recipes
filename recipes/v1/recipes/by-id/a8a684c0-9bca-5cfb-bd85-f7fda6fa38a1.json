  "id": "a8a684c0-9bca-5cfb-bd85-f7fda6fa38a1",
  "slug": "zaatar-bread",
  "name": "Za'atar Bread",
  "recipe_type": "breakfast",
  "brief_description": "Homemade dough rounds are topped with a mixture of za'atar and olive oil in this authentic recipe for Lebanese za'atar bread.",
  "cuisine": "Lebanese",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast in warm water in a large bowl. Mix in 3 cups flour and salt. Stir in remaining flour, 1/2 cup at a time, beating well after each addition."
    },
    {
      "position": 2,
      "text": "Turn dough out onto a lightly floured work surface. Knead until smooth, about 10 minutes. Place dough in a greased bowl; turn to coat with oil. Cover and let rise in a warm place until doubled, about 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 4,
      "text": "Divide dough into 16 equal pieces and form into rounds. Roll into 1/4-inch-thick circles. Poke rounds with your fingers to create small indentations."
    },
    {
      "position": 5,
      "text": "Mix za'atar and olive oil together in a small bowl. Spread over circles. Place on ungreased baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until dough is golden brown, 5 to 6 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

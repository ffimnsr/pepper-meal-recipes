  "id": "14f6a011-850b-5dde-9168-b8bc5ddb8508",
  "slug": "classic-mincemeat-pie",
  "name": "Classic Mincemeat Pie",
  "recipe_type": "dessert",
  "brief_description": "Talk about a quick and easy recipe! In under an hour you can prep, bake, and serve this classic mincemeat pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Unroll pie crusts. Line an ungreased 9-inch pie plate with one pastry. Fill with mincemeat filling. Cover with the second pasty and press the edges to seal. Cut slits in the top pasty to vent steam."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pastry is golden brown, 25 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,

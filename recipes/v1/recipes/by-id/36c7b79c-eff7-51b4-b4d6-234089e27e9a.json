  "schema_version": 1,
  "id": "36c7b79c-eff7-51b4-b4d6-234089e27e9a",
  "slug": "garlic-mashed-potatoes",
  "name": "Garlic Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These garlic mashed potatoes are smooth, buttery, and can be made with cream for a richer flavor, making them a perfect side dish for entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine potatoes, garlic, and 1 tablespoon salt in a medium saucepan with enough water to cover potatoes by 1 inch; bring to a boil over high heat. Reduce heat to medium-low; simmer until potatoes are fork-tender, 10 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Drain potatoes. Return to hot saucepan; stir until dry, about 1 minute."
    },
    {
      "position": 4,
      "text": "Add butter, 1 piece at a time, stirring gently until melted before adding more."
    },
    {
      "position": 5,
      "text": "Mash in milk using a potato masher until smooth. Stir in 1 teaspoon salt and white pepper."
    },
    {
      "position": 6,
      "text": "Transfer potatoes to a serving bowl; top with more butter, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

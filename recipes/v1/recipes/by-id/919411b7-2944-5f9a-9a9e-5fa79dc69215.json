  "slug": "sugar-free-peanut-butter-cookies",
  "name": "Sugar-Free Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These sugar-free peanut butter cookies are gluten free too. With just three simple ingredients you can satisfy your sweet tooth with no sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with a silicone liner."
    },
    {
      "position": 2,
      "text": "Mix peanut butter, sucralose, and eggs together in a bowl until thoroughly combined. Drop by spoonfuls onto the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the centers appear dry, about 8 minutes."
    }
  ],

  "schema_version": 1,
  "id": "88c715a8-b8da-5194-ad17-c49117c22a3e",
  "slug": "irish-soda-bread",
  "name": "Irish Soda Bread with Caraway Seeds",
  "recipe_type": "dessert",
  "brief_description": "This soda bread recipe made with flour, baking soda, buttermilk, sour cream, and caraway seeds is sweetened with raisins. Best served warm with butter.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round cast iron skillet or a 9-inch round baking or cake pan."
    },
    {
      "position": 2,
      "text": "Combine flour (reserving 1 tablespoon), sugar, baking powder, baking soda, salt, raisins and caraway seeds in a large bowl."
    },
    {
      "position": 3,
      "text": "Blend eggs, buttermilk and sour cream together in a small bowl; stir into flour mixture until flour is just moistened. Knead dough in bowl about 10 to 12 strokes. Dough will be sticky. Place the dough in the prepared skillet or pan and pat down. Cut a 4x\u00be inch deep slit in the top of the bread. Dust with reserved flour."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 65 to 75 minutes. Let cool and turn bread onto a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

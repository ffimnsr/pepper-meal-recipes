{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7ae55713-fa51-517c-ae92-56d71b6fdf77",
  "slug": "chocolate-coatconut-sandwich-cookies",
  "name": "Chocolate C'OAT'conut Sandwich Cookies",
  "recipe_type": "dessert",
  "brief_description": "These vegan sandwich cookies are made with vegan oat beverage margarine, vegan cream cheese, shredded coconut, and chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flax meal and water. Let stand 10 minutes."
    },
    {
      "position": 3,
      "text": "Combine flour, cocoa powder, oats, and baking soda in large bowl; set aside."
    },
    {
      "position": 4,
      "text": "Beat 1 cup Becel\u00ae with Oat Beverage margarine with sugars in another large bowl with electric mixer until light and fluffy, about 5 minutes. Beat in flax meal mixture and vanilla. Gradually beat in flour mixture just until blended. Stir in chocolate chips."
    },
    {
      "position": 5,
      "text": "Drop dough by heaping tablespoonfuls onto prepared baking sheet, 2 inches (5 cm) apart. Recipe will yield about 48 cookies. Bake 10 minutes or until edges are just set. Do not overbake."
    },
    {
      "position": 6,
      "text": "Place baking sheet on wire rack and cool for 5 minutes. Transfer cookies to wire rack and cool completely."
    },
    {
      "position": 7,
      "text": "Beat 1/2 cup Becel\u00ae and non-dairy cream cheese in large bowl with electric mixture until creamy. Add icing sugar, coconut extract, and vanilla extract, and beat until fluffy. Stir in shredded coconut."
    },
    {
      "position": 8,
      "text": "Once cookies have cooled completely, spread about 2 tablespoons coconut cream on flat side of one cookie and top with another cookie, pressing down until cream comes just to the edge. Repeat with remaining cream and cookies."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

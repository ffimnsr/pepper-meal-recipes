  "slug": "guava-margarita-recipe-7495284",
  "name": "Guava Margarita",
  "recipe_type": "appetizer",
  "brief_description": "This guava margarita will make you think you're on a tropical beach. Guava nectar adds a sweet, slightly floral note to the classic margarita flavor.",
  "cuisine": "Mexican Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle salt onto a plate. Moisten the rim of 2 glasses with a lime wedge. Press the moistened rim into the salt. Fill glasses with ice. Divide guava nectar between each glass."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker half-full with ice. Add tequila, triple sec, and lime juice to the shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds. Strain mixture evenly between the glasses and stir. Garnish with remaining lime wedges."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 5,

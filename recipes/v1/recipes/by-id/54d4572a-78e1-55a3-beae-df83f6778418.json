  "id": "54d4572a-78e1-55a3-beae-df83f6778418",
  "slug": "chocolate-rice-pudding",
  "name": "Chocolate Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Cooked rice is combined in a double boiler with milk, sugar, raisins, vanilla and cocoa to make this thick rice pudding.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan bring water to a boil. Add rice and stir. Reduce heat, cover and simmer for 20 minutes."
    },
    {
      "position": 2,
      "text": "In the top of a double boiler over simmering water, combine 1 1/2 cups cooked rice, milk, sugar, vanilla, raisins, butter and cocoa. Cook, stirring occasionally, until thickened, 20 to 30 minutes."
    }
  ],
  "servings": 6,

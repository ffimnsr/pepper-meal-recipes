  "id": "e188098a-07c7-5e8f-97ad-ee582254406c",
  "slug": "cream-of-onion-and-potato-soup",
  "name": "Cream of Onion and Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This is a creamy, rich pureed potato and onion soup that is the best comfort food. Try it with some fresh Italian or French bread, or garnish with croutons.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over high heat, combine potatoes, onions, and water to cover and boil for 30 to 45 minutes, or until tender. Drain the mixture, reserving 3 cups of the cooking liquid. Transfer this in small batches to a blender and puree until smooth."
    },
    {
      "position": 2,
      "text": "In the same pot over medium heat, combine flour and butter, stirring together well, to form a roux. Slowly add milk, stirring constantly, until well blended. Reduce heat to low and add the pur\u00e9ed potato mixture. Let simmer, stirring occasionally for 5 to 10 minutes. Add parsley and season with salt and pepper to taste."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

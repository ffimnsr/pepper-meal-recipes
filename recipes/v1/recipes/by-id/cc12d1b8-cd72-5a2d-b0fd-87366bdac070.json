  "id": "cc12d1b8-cd72-5a2d-b0fd-87366bdac070",
  "slug": "ukrainian-goulash",
  "name": "Ukrainian Goulash",
  "recipe_type": "soup",
  "brief_description": "This Ukrainian take on a beef stew is a mixture of beef, onions, and garlic in a sauce made with steak sauce and paprika.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt shortening in a large pot over medium heat. Cook beef in hot shortening until completely browned, 5 to 7 minutes. Stir onion, garlic, paprika, salt, and pepper into the beef; cook and stir 5 minutes more."
    },
    {
      "position": 2,
      "text": "Pour water and steak sauce into the pot; stir until beef mixture is evenly coated. Bring the mixture to a simmer, reduce heat to low, and cook until the beef is tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Whisk flour into the water in a small bowl; stir into the beef mixture. Continue simmering stew until slightly thickened, 2 to 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

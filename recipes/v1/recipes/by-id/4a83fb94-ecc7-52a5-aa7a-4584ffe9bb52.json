  "id": "4a83fb94-ecc7-52a5-aa7a-4584ffe9bb52",
  "slug": "middle-eastern-stuffed-zucchini",
  "name": "Middle Eastern Stuffed Zucchini",
  "recipe_type": "main",
  "brief_description": "Small zucchinis are stuffed with basmati rice, ground lamb, and mint in this Middle Eastern dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix together the ground lamb, basmati rice, 2 tablespoons tomato puree, 1/2 teaspoon mint, salt, and pepper; mix well, and set aside."
    },
    {
      "position": 2,
      "text": "Slice the ends off of the zucchinis and hollow out the centers using an apple corer. Stuff with lamb mixture."
    },
    {
      "position": 3,
      "text": "Stir together the remaining tomato puree with 1/2 teaspoon salt in a large skillet. Place the stuffed zucchini into the sauce, and add enough water to cover the zucchini. Bring to a simmer over medium-high heat, then reduce heat to medium-low, cover, and simmer for 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir in the garlic, lemon juice, and remaining 1/2 teaspoon of mint. Recover, and simmer an additional 15 minutes. To serve, cut the zucchini crosswise into rounds and arrange on a serving plate. Spoon sauce over the top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

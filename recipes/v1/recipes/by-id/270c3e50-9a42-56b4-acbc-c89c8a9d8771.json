  "id": "270c3e50-9a42-56b4-acbc-c89c8a9d8771",
  "slug": "how-to-make-pico-de-gallo",
  "name": "How to Make Pico de Gallo",
  "recipe_type": "appetizer",
  "brief_description": "This quick and easy recipe shows you how to make pico de gallo using simple, fresh ingredients like tomatoes, jalape\u00f1os, and onions. Perfect as an appetizer.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Prep and gather all your ingredients."
    },
    {
      "position": 2,
      "text": "Combine tomato, onion, jalape\u00f1o, cilantro and green onion in a medium bowl."
    },
    {
      "position": 3,
      "text": "Season with garlic powder, salt, and black pepper; stir until evenly distributed."
    },
    {
      "position": 4,
      "text": "Refrigerate before serving for 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

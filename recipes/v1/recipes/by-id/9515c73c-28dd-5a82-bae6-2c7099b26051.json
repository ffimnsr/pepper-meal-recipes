  "id": "9515c73c-28dd-5a82-bae6-2c7099b26051",
  "slug": "vegan-creamy-mushroom-and-farro-soup",
  "name": "Vegan Creamy Mushroom and Farro Soup",
  "recipe_type": "soup",
  "brief_description": "This vegan soup with mushroom and farro gets its creaminess from coconut milk, which pairs well with the slightly chewy farro.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a pot over medium heat. Add onion, celery, and carrots. Cook until onion is soft and translucent, 3 to 5 minutes. Add garlic, basil, and oregano and cook for another 30 seconds. Mix in mushrooms, salt, and pepper. Cover and cook, stirring occasionally, over medium-low heat for 10 minutes."
    },
    {
      "position": 2,
      "text": "Uncover and add celery leaves, vegetable stock, farro, tomato paste, and soy sauce. Simmer until farro is cooked, 25 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Pour in coconut milk and heat until soup is warmed through, 5 to 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

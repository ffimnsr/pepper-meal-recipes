  "slug": "hot-honey-butter-cream-cheese-stuffed-bagel-recipe-8664575",
  "name": "Hot Honey Butter Cream Cheese Stuffed Bagel",
  "recipe_type": "breakfast",
  "brief_description": "This hot honey butter cream cheese stuffed bagel is a twist on the viral air fryer bagel, with tangy cream cheese inside and a hot honey-caramelized outside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 390 degrees F (199 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Make 8 small cuts in the bagel, taking care not to cut all the way through, to create small openings. Add a piece of cream cheese in each crevice around the bagel. Combine honey and melted butter in a small dish and coat the stuffed bagel liberally. Sprinkle with salt."
    },
    {
      "position": 3,
      "text": "Place bagel in the air fryer until golden brown, 5 to 7 minutes. Drizzle with more honey if desired."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

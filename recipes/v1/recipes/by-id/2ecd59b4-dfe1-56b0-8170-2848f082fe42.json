  "id": "2ecd59b4-dfe1-56b0-8170-2848f082fe42",
  "slug": "4-bean-baked-beans",
  "name": "4-Bean Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "Four different varieties of beans are baked with bacon, molasses, and brown sugar for a sweet and savory picnic side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Add pork and beans, kidney beans, butter beans, and lima beans to a 2-quart casserole dish."
    },
    {
      "position": 3,
      "text": "Heat a saucepan over medium heat. Add bacon, onion, and garlic; cook and stir until bacon browned, about 10 minutes. Drain excess grease."
    },
    {
      "position": 4,
      "text": "Whisk brown sugar, ketchup, vinegar, molasses, and mustard into bacon mixture; simmer until cooked through, about 20 minutes. Pour sauce over beans; stir to combine."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbling, 1 hour 15 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 15,

  "id": "8c542f29-4d0e-5a23-a84b-1c1c560eef6a",
  "slug": "korean-bbq-short-ribs-gal-bi",
  "name": "Korean BBQ Short Ribs (Galbi)",
  "recipe_type": "main",
  "brief_description": "Korean short ribs are a favorite, and they're a snap to make at home with this easy recipe. You can even substitute sliced rib-eye or chicken for ribs.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour soy sauce, water, vinegar, and sesame oil into a large, non-metallic bowl. Whisk in onion, garlic, brown sugar, white sugar, and pepper until sugars dissolve."
    },
    {
      "position": 3,
      "text": "Submerge ribs in marinade; cover the bowl and refrigerate 7 to 12 hours -the longer, the better."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat. Remove ribs from marinade and shake off excess; discard marinade."
    },
    {
      "position": 5,
      "text": "Cook on the preheated grill until the meat is no longer pink, 5 to 7 minutes per side."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

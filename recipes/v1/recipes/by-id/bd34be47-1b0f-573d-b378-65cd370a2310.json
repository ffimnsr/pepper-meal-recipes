  "id": "bd34be47-1b0f-573d-b378-65cd370a2310",
  "slug": "stuffed-bell-peppers",
  "name": "Stuffed Bell Peppers",
  "recipe_type": "main",
  "brief_description": "These TVP stuffed peppers are like what Gram used to make, except they're vegetarian, made with TVP instead of beef, and can easily be made vegan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and rice in a small saucepan; bring to a boil. Reduce heat to low and simmer until rice is tender and liquid has been absorbed, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (205 degrees C)."
    },
    {
      "position": 3,
      "text": "Cut tops off peppers and remove seeds. Arrange peppers in a large baking dish. Chop up usable portion of the tops."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large skillet over medium heat. Saut\u00e9 chopped peppers and onion in hot oil until soft. Stir in textured vegetable protein and parsley. Reduce heat to low and continue cooking for 5 minutes. Mix in cooked rice and 1 1/4 cups tomato sauce. Season with salt and pepper. Spoon mixture into peppers; top each with remaining tomato sauce."
    },
    {
      "position": 5,
      "text": "Cover and bake in the preheated oven for about 45 minutes. Uncover, top each pepper with mozzarella cheese, and continue baking until cheese is melted, about 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

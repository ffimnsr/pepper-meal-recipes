  "id": "72360aef-e94b-5a72-a71d-dcedf84b854f",
  "slug": "uzbek-plov-lamb-and-rice-pilaf",
  "name": "Uzbek Plov (Lamb and Rice Pilaf)",
  "recipe_type": "main",
  "brief_description": "Spiced lamb is simmered with rice and whole heads of garlic in this Central Asia-inspired dish.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place basmati rice in a large bowl; cover with warm water and set aside. Wash whole heads garlic; set aside."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a Dutch oven or large skillet over high heat until smoking. Add lamb; cook, turning occasionally, until evenly browned, about 10 minutes. Stir in onions; cook and stir until softened and browned, about 10 minutes. Stir in carrots; cook and stir until softened, about 10 minutes. Add barberries, cumin, coriander, and peppercorns; drop whole heads garlic into Dutch oven, stirring to evenly distribute. Reduce heat to medium. Cover and cook 30 minutes."
    },
    {
      "position": 3,
      "text": "Wash and drain basmati rice with hot water; add to Dutch oven in an even layer on top of lamb. Slowly pour in 2 cups boiling water. The rice should be covered with about 3/4-inch water. Do not stir. Season with salt; reduce heat to medium-low. Cover and cook until rice is tender and liquid absorbed, about 20 minutes. Stir rice and lamb together; serve with whole garlic heads on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 20,

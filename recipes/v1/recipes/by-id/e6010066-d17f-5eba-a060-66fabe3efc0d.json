  "id": "e6010066-d17f-5eba-a060-66fabe3efc0d",
  "slug": "bazlama-turkish-flat-bread",
  "name": "Bazlama - Turkish Flat Bread",
  "recipe_type": "main",
  "brief_description": "This simple flatbread gets its tang from yogurt. It's best served warm.",
  "cuisine": "Turkish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve the yeast, sugar, and salt in the warm water. Add the water and yogurt to the flour and mix well. The dough will be soft but not sticky. Turn the dough out onto a lightly floured surface and shape it into a ball. Cover the dough with a damp cloth and allow it to rise at room temperature for 3 hours."
    },
    {
      "position": 2,
      "text": "Cut the dough into four portions. Shape the dough into rounds and flatten each round as though you're making pizza dough. Cover the rounds with a damp cloth and let the dough rest for 15 minutes."
    },
    {
      "position": 3,
      "text": "Heat a cast iron skillet or griddle over medium-high heat. Place one dough round in the skillet and bake until brown spots appear on the bottom, about 1 minute. Flip the bread and bake for an additional minute. Remove the bread and wrap it in a clean kitchen towel to keep warm."
    },
    {
      "position": 4,
      "text": "Repeat with the remaining dough rounds. Store any leftover flatbreads in an airtight container."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ebfaa7ec-33d5-5315-a03c-863d8f02027a",
  "slug": "air-fryer-kielbasa-bites-recipe-11882494",
  "name": "Air Fryer Kielbasa Bites",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer kielbasa bites are Hasselback-sliced to hold the tangy and sweet glaze in the grooves. Air frying creates bites that are tender and juicy inside with caramelized edges outside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice 1/4-inch crosswise cuts along kielbasa without cutting all the way through (see Cook\u2019s Note below on Hasselback style)."
    },
    {
      "position": 2,
      "text": "In a small bowl, combine Dijon, honey, whole grain mustard, brown sugar, and vinegar. Divide sauce into 2 bowls. Stir mayonnaise into the first bowl until smooth; set aside for dipping sauce. Use the second bowl to glaze the kielbasa."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 380 degrees F (193 degrees C), and line the fryer basket with a disposable parchment liner (or spray with cooking spray). Cut kielbasa into large links to fit the air fryer basket. Pour or brush mustard sauce over sausage, making sure to get sauce in between slices for maximum flavor."
    },
    {
      "position": 4,
      "text": "Place links in a single layer in the basket, and cook until golden brown with crispy edges, 7 to 9 minutes. Check occasionally to avoid overcooking or burning."
    },
    {
      "position": 5,
      "text": "Remove sausage links from the fryer, cut into 1-inch pieces, and transfer to a serving platter. Sprinkle with parsley or cilantro, and serve with mustard dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

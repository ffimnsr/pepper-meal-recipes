  "slug": "strawberry-daiquiri-recipe-11859853",
  "name": "Strawberry Daiquiri",
  "recipe_type": "appetizer",
  "brief_description": "Blend up this classic strawberry daiquiri anytime using frozen berries for a so-simple sweet-tart cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "If you like, wipe rim of hurricane glasses with lime wedge. Dip rim into freeze-dried strawberry powder. Blend frozen sliced strawberries, ice cubes, white rum, sugar, and lime juice in a blender until smooth, adding more ice as needed. Pour mixture into prepared glasses. Garnish with fresh strawberries."
    }
  ],

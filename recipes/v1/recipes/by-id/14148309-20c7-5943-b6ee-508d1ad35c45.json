  "id": "14148309-20c7-5943-b6ee-508d1ad35c45",
  "slug": "vanilla-ice-cream-v",
  "name": "Homemade Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This easy homemade ice cream is made with just cream, sugar, and vanilla for an old-fashioned vanilla ice cream that's sure to be a summer hit!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine half-and-half, sugar, cream, vanilla, and salt in the freezer container of an ice cream maker."
    },
    {
      "position": 3,
      "text": "Freeze according to the manufacturer's instructions, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Transfer to an airtight container and freeze until firm, about 4 hours."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],

  "id": "79ff7b36-baf7-5ff5-9835-a233d6c57d75",
  "slug": "mexican-pot-roast",
  "name": "Mexican Pot Roast",
  "recipe_type": "main",
  "brief_description": "This slow cooker recipe for Mexican-style beef is seasoned with green chile pepper, hot sauce, taco seasoning, chili powder, and garlic powder.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Season chuck roast with salt and pepper. Heat olive oil in a large skillet over medium-high heat; add roast. Cook until entirely browned, 2 to 3 minutes per side; transfer to a slow cooker."
    },
    {
      "position": 2,
      "text": "Sprinkle diced chile pepper, onion, hot sauce, taco seasoning, chili powder, cayenne pepper, and garlic powder over roast."
    },
    {
      "position": 3,
      "text": "Cook on Low until roast is fall-apart tender, 8 to 10 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 490,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

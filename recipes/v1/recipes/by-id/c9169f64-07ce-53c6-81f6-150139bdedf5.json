  "id": "c9169f64-07ce-53c6-81f6-150139bdedf5",
  "slug": "kens-perfect-hard-boiled-egg-and-i-mean-perfect",
  "name": "Perfect Hard-Boiled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Get perfect hard boiled eggs every time with this foolproof recipe that uses a little salt and vinegar to help make hard boiled eggs easier to peel.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine salt, vinegar, and water in a large pot, and bring to a boil over high heat."
    },
    {
      "position": 3,
      "text": "Add eggs one at a time, being careful not to crack them. Reduce the heat to a gentle boil, and cook for 14 minutes."
    },
    {
      "position": 4,
      "text": "Once eggs have cooked, remove them from the hot water, and place into a container of ice water or cold, running water. Cool completely, about 15 minutes. Store in the refrigerator up to 1 week."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

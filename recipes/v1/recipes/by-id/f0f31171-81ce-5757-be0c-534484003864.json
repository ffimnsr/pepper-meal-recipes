  "id": "f0f31171-81ce-5757-be0c-534484003864",
  "slug": "chicken-fajita-pasta-bake",
  "name": "Chicken Fajita Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This easy chicken fajita pasta bake recipe is made with black beans, corn, and ziti pasta smothered in a tasty sauce made with salsa and cream cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Add ziti and return to a boil. Cook, stirring occasionally, until tender yet firm to the bite, about 10 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a skillet over medium heat. Add onion and green pepper; cook and stir until soft, 5 to 7 minutes. Transfer to a bowl."
    },
    {
      "position": 3,
      "text": "Cook chicken in the same skillet until no longer pink in the center, 7 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Combine salsa, cream cheese, and taco seasoning in a saucepan over low heat; cook and stir until cream cheese is melted, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Combine ziti, chicken, salsa mixture, onion mixture, black beans, and corn in a large bowl. Add 1/2 of the Cheddar cheese and mix until combined. Pour into a baking pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 20 minutes. Sprinkle remaining Cheddar over top. Continue to bake until cheese is melted, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

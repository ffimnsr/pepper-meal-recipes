  "id": "36fb1c90-cf02-565f-99f8-f0a1ecab0dad",
  "slug": "carrot-hummus",
  "name": "Carrot Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This carrot hummus is made by blending carrots, cashews, lemon juice, tamari, and garlic for a delicious veggie dip or sandwich spread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cashews and garlic in a food processor; pulse until finely chopped. Add carrots, lemon juice, tamari, parsley, and mayonnaise; process until smooth. Season with salt."
    }
  ],
  "servings": 10,

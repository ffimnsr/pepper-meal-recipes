  "id": "7e243d50-331b-534b-9ba2-d4c90ea3f485",
  "slug": "chocolate-chess-pie-iii",
  "name": "Chocolate Chess Pie III",
  "recipe_type": "dessert",
  "brief_description": "An easy and delicious recipe that makes 2 chocolate pies. Serve with whipped cream, if desired.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, combine sugar, cocoa and melted butter. Beat until smooth. Beat in eggs, milk and vanilla. Pour filling into pie shells."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until golden brown and filling is set."
    }
  ],
  "servings": 16,

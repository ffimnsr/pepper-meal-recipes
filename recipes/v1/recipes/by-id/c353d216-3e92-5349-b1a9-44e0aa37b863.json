  "id": "c353d216-3e92-5349-b1a9-44e0aa37b863",
  "slug": "jalapeno-cheddar-cornbread-muffins-recipe-7642461",
  "name": "Jalapeno Cheddar Cornbread Muffins",
  "recipe_type": "side",
  "brief_description": "These jalape\u00f1o cornbread muffins with cheese feature sharp Cheddar in the mix, and then each one has a secret chunk of mozzarella inside, hidden by an extra slice of jalape\u00f1o.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line 12 muffin cups."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together cornmeal, flour, baking powder, and salt; stir in honey, egg, milk, and vegetable oil; blend thoroughly. Stir in shredded sharp Cheddar cheese and chopped jalape\u00f1os. Pour or spoon batter into the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Add a mozzarella piece to the center of each muffin and one jalape\u00f1o slice."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center of a muffin comes out clean, about 14 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

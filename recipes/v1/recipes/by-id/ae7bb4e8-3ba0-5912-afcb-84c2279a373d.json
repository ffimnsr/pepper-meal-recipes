  "id": "ae7bb4e8-3ba0-5912-afcb-84c2279a373d",
  "slug": "jamaican-rum-punch",
  "name": "Jamaican Rum Punch",
  "recipe_type": "drink",
  "brief_description": "A tropical rum punch made with three varieties of rum, pineapple juice, lime juice, and orange juice for a refreshingly fruity Caribbean cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir pineapple juice, orange juice, 151 proof rum, dark rum, coconut-flavored rum, lime juice, and grenadine syrup together in a punch bowl."
    },
    {
      "position": 3,
      "text": "Float orange slices, lime slices, and lemon slices in the punch."
    },
    {
      "position": 4,
      "text": "Ladle the punch into ice filled glasses, or chill the punch in the refrigerator until ready to serve."
    }
  ],
  "servings": 8,

  "id": "75ea6295-d897-5ae1-83ff-097214fc0e81",
  "slug": "carrot-cake-with-pineapple-cream-cheese-frosting",
  "name": "Carrot Cake with Pineapple Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "This carrot cake recipe is loaded with pineapple and pecans and topped with pineapple cream cheese frosting for a satisfying, rich, and hearty dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Make cake: Sift together flour, baking soda, cinnamon, and salt in a large bowl. Lightly beat eggs in a second large bowl; add sugar, buttermilk, applesauce, oil, and vanilla and mix until well combined. Stir buttermilk mixture, carrots, pecans, and drained pineapple into flour mixture just until mixed; pour into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 45 to 50 minutes. Cool in the baking dish on a wire rack, about 1 hour. Cover the dish tightly with plastic wrap; refrigerate for 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Make frosting: Beat together Neufch\u00e2tel cheese and 1 tablespoon reserved pineapple juice in a medium bowl with an electric mixer until smooth. Add confectioners' sugar, vanilla, and salt; beat until frosting is smooth."
    },
    {
      "position": 5,
      "text": "Spread frosting over cold cake."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

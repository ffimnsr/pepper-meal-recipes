  "id": "9e616ae6-e4b7-5b0e-80e3-9c9e4cd1e2e2",
  "slug": "quick-and-easy-pancit",
  "name": "Quick and Easy Pancit",
  "recipe_type": "main",
  "brief_description": "This pancit recipe is easy to make with stir-fried chicken, shredded cabbage, and sliced carrots tossed with rice noodles and flavored with soy sauce.",
  "cuisine": "Filipino American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place rice noodles in a large bowl; cover with warm water and let soften for 8 to 10 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a wok or large skillet over medium-low heat. Add onion and garlic; cook and stir until onion is tender, about 3 to 5 minutes. Stir in chicken, cabbage, carrots, and soy sauce. Cook until cabbage begins to soften."
    },
    {
      "position": 4,
      "text": "Toss in noodles and cook, stirring constantly, until heated through."
    },
    {
      "position": 5,
      "text": "Transfer pancit to a serving dish and garnish with lemon wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4cbf982d-063e-5393-be1e-0b3b37814b47",
  "slug": "sun-dried-tomato-basil-orzo",
  "name": "Sun-Dried Tomato Basil Orzo",
  "recipe_type": "salad",
  "brief_description": "Basil and sun-dried tomato add flavor and zing to this simple yet delicious pasta salad recipe. It's perfect for picnics, and great served warm or cold.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook orzo in the boiling water, stirring occasionally until tender yet firm to the bite, 8 to 10 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Add basil leaves and sun-dried tomatoes to the bowl of a food processor; pulse until blended, 4 or 5 times."
    },
    {
      "position": 3,
      "text": "Toss orzo, basil-tomato mixture, Parmesan cheese, olive oil, salt, and pepper together in a large bowl;. serve warm or chilled."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 15,

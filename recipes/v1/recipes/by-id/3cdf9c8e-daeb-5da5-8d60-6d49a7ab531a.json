  "id": "3cdf9c8e-daeb-5da5-8d60-6d49a7ab531a",
  "slug": "mommas-healthy-meatloaf",
  "name": "Momma's Healthy Meatloaf",
  "recipe_type": "main",
  "brief_description": "This healthy meatloaf recipe with extra-lean ground beef, carrots, onion, zucchini, and bell pepper will become a family favorite weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C). Coat a 9x5-inch loaf pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir bell pepper and onion in hot oil until onion is translucent and bell pepper is softened, 5 to 10 minutes. Add garlic and cook until fragrant, 1 to 2 minutes. Remove the skillet from heat."
    },
    {
      "position": 3,
      "text": "Combine ground beef, bread crumbs, carrot, zucchini, eggs, salt, pepper, and bell pepper mixture in a large bowl; mix well using your hands. Press mixture into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, 35 to 40 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 5,
      "text": "Spread ketchup over meatloaf and continue baking until bubbling, about 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

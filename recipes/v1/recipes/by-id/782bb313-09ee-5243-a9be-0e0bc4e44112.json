  "schema_version": 1,
  "id": "782bb313-09ee-5243-a9be-0e0bc4e44112",
  "slug": "chef-johns-breakfast-sausage-patties",
  "name": "Chef John\u2019s Breakfast Sausage Patties",
  "recipe_type": "breakfast",
  "brief_description": "Ask your butcher for coarsely ground pork shoulder (or grind it yourself), add a few tasty seasonings, and enjoy your own homemade breakfast sausage patties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork, fennel seeds, orange zest, salt, black pepper, Italian seasoning, red pepper flakes, and nutmeg into a bowl and stir very lightly with a fork to combine. Do not overmix. Cover and refrigerate overnight."
    },
    {
      "position": 2,
      "text": "Check seasonings before using: Shape about 2 teaspoons sausage into a small patty and fry until brown in a skillet over medium heat. Let cool 1 to 2 minutes and taste for seasoning."
    },
    {
      "position": 3,
      "text": "Cover a cutting board with plastic wrap. Divide sausage into 6 equal pieces, roll into a balls, and wrap each ball with plastic wrap. Press flat into patties and discard plastic."
    },
    {
      "position": 4,
      "text": "Place a heavy skillet, such as a cast iron skillet, over medium-high heat. Cook patties in hot skillet until meat is no longer pink in the center and the sausage is browned, about 3 minutes per side. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

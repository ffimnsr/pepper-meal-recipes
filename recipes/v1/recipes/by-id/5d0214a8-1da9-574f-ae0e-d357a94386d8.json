  "slug": "best-apple-salad",
  "name": "Best Apple Salad",
  "recipe_type": "salad",
  "brief_description": "A wonderful unexpected blend of fresh apples, onions, peppers, and beans, with a great dressing to toss in some zing!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, combine the apples, bell pepper, red onion and kidney beans. In a separate bowl, whisk together the vinegar, honey, mustard and pepper. Pour over the salad, and stir gently to coat."
    }
  ],

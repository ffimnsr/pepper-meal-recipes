  "id": "f3802067-9451-51d5-add6-da2f9a986e91",
  "slug": "sour-cream-coffee-cake",
  "name": "Walnut Sour Cream Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This coffee cake with a cinnamon-walnut topping is great at any time of day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan, springform pan, or tube pan."
    },
    {
      "position": 2,
      "text": "Beat 1 cup sugar and butter with an electric mixer in a large bowl until light and fluffy. Add flour, sour cream, eggs, vanilla, baking powder, baking soda, and salt; continue beating until ingredients integrate into a batter."
    },
    {
      "position": 3,
      "text": "Mix walnuts, 1/2 cup sugar, and ground cinnamon in a separate bowl."
    },
    {
      "position": 4,
      "text": "Pour about half the batter into the prepared pan. Sprinkle about half the walnut topping over the batter and top with remaining batter. Finish by sprinkling remaining topping over the batter."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes (depending on pan used). Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

  "id": "5bd91b41-7373-5c3c-a45b-f50860da4d3a",
  "slug": "best-spanish-rice",
  "name": "Best Spanish Rice",
  "recipe_type": "soup",
  "brief_description": "Fluffy Spanish rice is simple to make at home with white rice, broth, and tomato picante sauce for the perfect accompaniment to Mexican dishes.",
  "cuisine": "Mexican Inspired Spanish Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large, heavy skillet over medium heat. Add onion; cook and stir until tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add rice; cook and stir until rice begins to turn golden brown."
    },
    {
      "position": 4,
      "text": "Stir in chicken broth and picante sauce."
    },
    {
      "position": 5,
      "text": "Reduce heat, cover, and simmer until liquid has been absorbed, about 15 to 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

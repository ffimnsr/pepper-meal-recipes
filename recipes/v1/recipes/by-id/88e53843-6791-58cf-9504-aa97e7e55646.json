  "slug": "williamsburg-butter-frosting",
  "name": "Williamsburg Orange Butter Frosting",
  "recipe_type": "dessert",
  "brief_description": "Enjoy this creamy and buttery frosting made with orange liqueur and orange zest on a Williamsburg orange cake or any cake!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat confectioners' sugar and butter together in a large bowl until well combined. Stir in orange liqueur and orange zest. Beat until light and fluffy. Use to frost a cooled cake."
    }
  ],

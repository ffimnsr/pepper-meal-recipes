  "slug": "easy-broccoli-slaw-salad",
  "name": "Broccoli Slaw",
  "recipe_type": "salad",
  "brief_description": "This crunchy broccoli slaw is made with broccoli coleslaw mix, almonds, and raisins tossed in a sweet and tangy dressing for a refreshing side dish.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, sugar, vinegar, and ramen noodle seasoning packets together in a small bowl."
    },
    {
      "position": 2,
      "text": "Combine broccoli coleslaw mix, broken ramen noodles, almonds, raisins, green onions, and green bell pepper together in a salad bowl; fold in dressing."
    }
  ],

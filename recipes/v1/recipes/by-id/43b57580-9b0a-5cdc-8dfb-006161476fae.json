  "slug": "no-bake-hot-chocolate-dip-recipe-11855155",
  "name": "No-Bake Hot Chocolate Dip",
  "recipe_type": "appetizer",
  "brief_description": "For this no-bake hot chocolate dip, whisk 3 ingredients together. Top with festive toppings, and serve with chocolate cookies, strawberries, graham crackers and pretzels for dipping. It's impossibly easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk marshmallow fluff and whipped topping together in a bowl until well combined. Add hot chocolate mix and whisk until well combined."
    },
    {
      "position": 2,
      "text": "Refrigerate until ready to serve. Garnish with desired toppings before serving."
    }
  ],
  "servings": 12,

  "id": "a0d2a6f0-5795-577e-8b1c-871190a5aae8",
  "slug": "parathas",
  "name": "Parathas",
  "recipe_type": "appetizer",
  "brief_description": "The shallow-fried version of chapatis, these crunchy parathas are quick and easy snack or side, made with a garlic and herb-infused batter.",
  "cuisine": "Indian Inspired Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix all-purpose flour and whole wheat flour in a bowl. Sprinkle salt on top. Add butter, sugar, garlic powder, and dried herbs. Mix together with your fingers. Pour water in gradually; continue to mix by hand until a soft dough is formed."
    },
    {
      "position": 2,
      "text": "Knead dough until smooth and elastic, about 7 minutes. Cover with a damp cloth; let rest for 30 minutes."
    },
    {
      "position": 3,
      "text": "Divide dough into 8 equal portions. Shape into smooth balls; lightly flatten. Dust with flour and roll into thin circles about 1/16-inch thick and 7 inches in diameter."
    },
    {
      "position": 4,
      "text": "Heat oil in a large saucepan over medium heat. Fry each dough circle until golden, about 2 minutes per side. Drain on paper towels."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 4,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

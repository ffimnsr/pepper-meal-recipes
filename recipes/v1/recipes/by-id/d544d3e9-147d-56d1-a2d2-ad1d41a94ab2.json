  "slug": "crown-jewel-holiday-cocktail-recipe-8409667",
  "name": "Crown Jewel Holiday Cocktail",
  "recipe_type": "appetizer",
  "brief_description": "My crown jewel holiday cocktail is especially for the eggnog and whiskey lovers. The orange liquueur adds an interesting twist on the traditional whiskey and eggnog cocktail.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Add whiskey, eggnog, and orange liqueur to a cocktail shaker. Fill shaker with ice and shake well."
    },
    {
      "position": 2,
      "text": "Pour into a frosted martini glass and garnish with a cinnamon stick or orange twist."
    }
  ],

  "slug": "butter-icing-for-sugar-cookies",
  "name": "Butter Icing for Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "This buttercream icing for cookies is quick, easy, and requires no egg whites. It can be tinted any color and is perfect for frosting sugar cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat sugar, butter, vanilla, and 1 tablespoon milk in a large bowl until creamy. Mix in more milk, 1 to 2 drops at a time, to reach desired spreading consistency. Stir in food coloring."
    }
  ],

  "id": "6f9b21df-16fc-54ce-8caa-6748b695e7dc",
  "slug": "strawberry-and-spinach-salad-with-honey-balsamic-vinaigrette",
  "name": "Strawberry and Spinach Salad with Honey Balsamic Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This strawberry spinach salad is a colorful, delicious, and easy summer dish with crunchy nuts and Gorgonzola cheese in a honey balsamic vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine spinach, strawberries, Gorgonzola cheese, and pecans in a large bowl."
    },
    {
      "position": 2,
      "text": "Stir together balsamic vinegar and honey in a medium bowl; slowly stream in olive oil while whisking continuously. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Drizzle dressing over spinach mixture just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

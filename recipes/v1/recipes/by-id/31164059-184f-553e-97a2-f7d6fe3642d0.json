  "id": "31164059-184f-553e-97a2-f7d6fe3642d0",
  "slug": "shish-tawook-grilled-chicken",
  "name": "Shish Tawook Grilled Chicken",
  "recipe_type": "main",
  "brief_description": "Shish tawook are Middle Eastern chicken kabobs. Make them at home by marinating chicken in yogurt, lemon, and spices; skewer with veggies and grill.",
  "cuisine": "Middle Eastern Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix yogurt, lemon juice, oil, garlic, tomato paste, salt, oregano, pepper, allspice, cinnamon, and cardamom in a large bowl. Add chicken and toss to coat; transfer into a resealable plastic bag, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 4 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Thread chicken, onions, and bell pepper onto metal skewers."
    },
    {
      "position": 4,
      "text": "Cook on preheated grill until chicken is golden and no longer pink in the center, about 5 minutes on each side. Sprinkle parsley over the skewers."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

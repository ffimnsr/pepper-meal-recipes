  "id": "bbb4b8dd-9ade-52f6-a6fb-8f6fd3cf60a1",
  "slug": "strawberry-ginger-mint-lemonade",
  "name": "Strawberry-Ginger-Mint Lemonade",
  "recipe_type": "drink",
  "brief_description": "Fresh strawberries are blended with mint leaves, ginger, sugar, and lemon juice to produce this summer-ready, refreshing drink that's delicious as-is, or with alcohol added!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries, mint, lemon juice, 1 cup water, sugar, and ginger into an electric blender and blend well."
    },
    {
      "position": 2,
      "text": "Pour into a pitcher, add 5 cups water, and stir well. Refrigerate or serve immediately over crushed ice."
    }
  ],
  "servings": 8,

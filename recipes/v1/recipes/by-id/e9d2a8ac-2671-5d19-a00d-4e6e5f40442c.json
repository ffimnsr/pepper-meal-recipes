  "id": "e9d2a8ac-2671-5d19-a00d-4e6e5f40442c",
  "slug": "sheet-pan-shrimp-fajitas",
  "name": "Sheet Pan Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "Shrimp, bell peppers, and jalape\u00f1os are tossed with olive oil and fajita seasoning in this quick and easy recipe for sheet pan shrimp fajitas.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix fajita seasoning and olive oil together in a large bowl. Add shrimp; toss to coat."
    },
    {
      "position": 3,
      "text": "Lay out seasoned shrimp in a single layer on a baking sheet. Add bell peppers, red onion, and jalape\u00f1o; mix with shrimp and spread out evenly."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven until shrimp are opaque, 8 to 10 minutes. Transfer shrimp to a serving plate."
    },
    {
      "position": 5,
      "text": "Broil pepper mixture until lightly blackened, 2 to 3 minutes. Transfer to the serving plate with shrimp."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

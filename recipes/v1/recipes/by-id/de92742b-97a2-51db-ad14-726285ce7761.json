  "id": "de92742b-97a2-51db-ad14-726285ce7761",
  "slug": "cast-iron-pan-seared-steak-oven-finished",
  "name": "Cast Iron Pan-Seared Steak (Oven-Finished)",
  "recipe_type": "main",
  "brief_description": "Steak is pan-seared in a cast iron skillet and finished in the oven. A quick 45-minute marinade adds extra flavor to your sirloin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place steaks side by side in large casserole dish. Add orange juice, cider vinegar, and Worcestershire sauce. Marinate, uncovered, in the refrigerator for 45 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Remove casserole dish from refrigerator. Cover steaks with plastic wrap and let allow to come to room temperature, at least 15 minutes."
    },
    {
      "position": 4,
      "text": "Place steaks on a clean work surface and generously rub with steak seasoning and black pepper."
    },
    {
      "position": 5,
      "text": "Heat olive oil in a cast-iron skillet over high heat. Cook steaks in the hot skillet until lightly browned on the bottom, 2 \u00bd minutes."
    },
    {
      "position": 6,
      "text": "Flip and cook until browned on the other side and red in the center, about 2 minutes more. Transfer skillet with the steaks to the oven."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until steaks are firm and reddish-pink to lightly pink in the center, 8 to 10 minutes. An instant-read thermometer inserted into the center should read from 130 degrees F (54 degrees C) to 140 degrees F (60 degrees C)."
    },
    {
      "position": 8,
      "text": "Remove steaks from oven; season with salt. Let rest for 5 minutes before serving."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 12,

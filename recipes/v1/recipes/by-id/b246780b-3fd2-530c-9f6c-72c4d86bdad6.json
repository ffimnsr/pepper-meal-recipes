  "id": "b246780b-3fd2-530c-9f6c-72c4d86bdad6",
  "slug": "mcdonalds-fries",
  "name": "McDonald's Fries",
  "recipe_type": "side",
  "brief_description": "Make your favorite French fries at home with this easy copycat recipe for McDonald's fries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a bowl and cover with water; let sit for 5 minutes. Drain and pat dry."
    },
    {
      "position": 2,
      "text": "Place potatoes in a bowl and cover with boiling water; add sugar and corn syrup and mix well. Place bowl in the refrigerator and let sit for 5 minutes. Drain and pat dry."
    },
    {
      "position": 3,
      "text": "Spread potatoes out in a baking dish, cover the dish with plastic wrap, and freeze for 30 minutes."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Working in batches, fry potatoes in hot oil for 2 minutes. Transfer to a paper towel-lined plate to dry and let cool for 15 minutes."
    },
    {
      "position": 6,
      "text": "Working in batches again, fry potatoes in hot oil until browned and crispy, 5 to 7 minutes. Season fries with sea salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b86b245f-10ec-5c45-9f74-d27c75711940",
  "slug": "goat-cheese-stuffed-lamb-burgers",
  "name": "Goat Cheese-Stuffed Lamb Burgers",
  "recipe_type": "main",
  "brief_description": "These juicy lamb burgers are stuffed with goat cheese and flavored with fresh basil and oregano, but you can use your favorite herbs as desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 teaspoon olive oil in a small skillet over medium heat. Add onion; cook and stir until soft and translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Gently knead together onion, lamb, egg, bread crumbs, garlic, salt, and pepper. Divide mixture into six parts and roll into balls, then cover and refrigerate until ready to use."
    },
    {
      "position": 3,
      "text": "Mix together goat cheese, extra-virgin olive oil, basil, and oregano until well combined; cover and chill for 5 minutes."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Working with one portion of meat at a time, make an indentation in the center of the ball with your thumb. Fill the indentation with a heaping tablespoon of goat cheese mixture. Gently pull and form the meat patty around the cheese filling, making a burger-shaped patty. Repeat with each ball of lamb mixture."
    },
    {
      "position": 6,
      "text": "Grill patties on the preheated grill until no longer pink in the center, about 8 minutes per side. An instant-read thermometer inserted into the center should read at least 130 degrees F (54 degrees C) for medium or 150 degrees F (65 degrees C) for well done."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

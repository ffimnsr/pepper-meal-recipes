  "id": "e91847aa-21bb-50ae-8894-b173aab7688a",
  "slug": "salted-caramel-irish-cream-poke-cake-recipe-8789012",
  "name": "Salted Caramel Irish Cream Poke Cake",
  "recipe_type": "dessert",
  "brief_description": "This salted caramel Irish cream poke cake is the perfect dessert for St. Patrick's Day. Wonderfully moist and full of flavor, it comes together quickly, but plan ahead as it needs to cool to fully develop its flavors.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with cooking spray and line with parchment paper, if desired."
    },
    {
      "position": 2,
      "text": "Beat cake mix, water, eggs, and oil in a large bowl with an electric mixer at low speed until moistened, about 30 seconds. Beat at medium speed until no streaks of flour remain, about 2 minutes. Rinse beaters clean."
    },
    {
      "position": 3,
      "text": "Pour batter into the prepared baking pan."
    },
    {
      "position": 4,
      "text": "Bake in the the preheated oven until a toothpick inserted into the center of the cake comes out clean, 21 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Five minutes before cake is done, whisk together pudding mix and milk in a saucepan; heat over medium, whisking constantly, until mixture starts to thicken, about 4 minutes. Remove from heat. Add salt and 1/2 cup of the Irish cream and whisk vigorously until smooth."
    },
    {
      "position": 6,
      "text": "Poke holes immediately into the warm cake with the round handle of a wooden spoon. (Holes should be at 1-inch intervals and extend down to the bottom of the baking dish.)"
    },
    {
      "position": 7,
      "text": "Immediately pour pudding mixture evenly over the warm cake, making sure to fill all the holes. Let cool in pan on a wire rack until room temperature, about 30 minutes. Cover and refrigerate for at least 2 hours or up to 12 hours."
    },
    {
      "position": 8,
      "text": "Combine heavy cream, 6 tablespoons caramel topping, and remaining 3 tablespoons Irish cream in a large bowl. Beat on medium-high speed until stiff peaks form, about 5 minutes. Refrigerate until needed."
    },
    {
      "position": 9,
      "text": "Spread whipped cream evenly over cooled cake."
    },
    {
      "position": 10,
      "text": "Drizzle with remaining 2 tablespoons salted caramel topping. Sprinkle with flaky sea salt, if desired."
    }
  ],
  "servings": 12,

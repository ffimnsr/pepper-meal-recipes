  "id": "e370d017-37be-5d1b-b891-f82357f762ee",
  "slug": "passover-double-chocolate-almond-torte",
  "name": "Passover Double Chocolate Almond Torte",
  "recipe_type": "dessert",
  "brief_description": "This flourless chocolate torte is perfect for Passover. It has two doses of chocolate and a layer of crushed almonds for a nice rich dessert.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Grease a 9-inch springform pan and dust with 1/2 teaspoon unsweetened cocoa powder."
    },
    {
      "position": 3,
      "text": "Melt chopped chocolate squares and butter in a heavy saucepan over low heat, stirring until smooth, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Whisk egg yolks and vanilla extract together in a large bowl."
    },
    {
      "position": 5,
      "text": "Gradually whisk chocolate and butter mixture into egg yolk mixture until well blended."
    },
    {
      "position": 6,
      "text": "Beat egg whites in a separate bowl with an electric mixer on high speed until soft peaks form. Gradually beat sugar into egg whites until sugar dissolves and egg whites hold stiff peaks."
    },
    {
      "position": 7,
      "text": "Fold 1/3 of the egg white mixture into chocolate mixture. Gently fold in remaining egg white mixture until just blended and batter is smooth and fluffy."
    },
    {
      "position": 8,
      "text": "Spread batter evenly into prepared springform pan."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until sides begin to pull away from pan and top is set in center, about 25 minutes."
    },
    {
      "position": 10,
      "text": "Let torte cool in pan on a wire rack for 10 minutes before removing the sides of pan."
    },
    {
      "position": 11,
      "text": "Place chocolate chips into a microwave-safe bowl and heat in microwave on full power for 1 minute. Stir the chips. Continue to heat in 15-second intervals, stirring after each time, until the chocolate chips have melted and are warm and smooth. Do not overheat."
    },
    {
      "position": 12,
      "text": "Drizzle melted chocolate chips onto torte. Sprinkle crushed almonds and a dusting of confectioners' sugar and 1/2 teaspoon unsweetened cocoa powder, or as needed, onto the torte before serving.."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

  "id": "6a3702a2-3234-5418-834a-3314d72790a9",
  "slug": "chinese-chicken-soup",
  "name": "Chinese Chicken Soup",
  "recipe_type": "soup",
  "brief_description": "This easy Chinese chicken soup with noodles is flavored with turmeric, chile paste, ginger, and soy for a quick and flavorsome meal in one pot.",
  "cuisine": "World Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat sesame oil in a large pot over medium heat. Add chile paste, ginger, and turmeric; cook and stir until fragrant, 1 to 2 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, chicken, celery, soy sauce, and sugar. Bring to a boil; add noodles and simmer for 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in lettuce and remove from heat. Garnish servings with green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

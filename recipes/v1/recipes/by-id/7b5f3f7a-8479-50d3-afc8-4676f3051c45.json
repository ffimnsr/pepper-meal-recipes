  "id": "7b5f3f7a-8479-50d3-afc8-4676f3051c45",
  "slug": "molasses-banana-bread",
  "name": "Molasses Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "This wonderfully flavorful molasses banana bread is sweetened with molasses instead of sugar for a crowd-pleasing treat. What a nice variation!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Cream butter in a large bowl. Beat in banana, molasses, and egg. Mix in both flours, baking soda, salt, and nutmeg. Stir in walnuts until well blended. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, 55 to 65 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

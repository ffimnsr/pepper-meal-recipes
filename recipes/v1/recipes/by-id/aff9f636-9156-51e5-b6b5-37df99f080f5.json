  "id": "aff9f636-9156-51e5-b6b5-37df99f080f5",
  "slug": "slow-cooker-homemade-beans",
  "name": "Slow Cooker Homemade Beans",
  "recipe_type": "side",
  "brief_description": "These slow cooker baked beans are simmered with bacon, onion, ketchup, brown sugar, molasses, and mustard until soft for a flavorful side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Drain soaking liquid from beans; place them in a slow cooker."
    },
    {
      "position": 3,
      "text": "Stir bacon, onion, ketchup, water, brown sugar, molasses, mustard, and salt into beans until well mixed."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 8 to 10 hours; stir occasionally if possible."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 480,

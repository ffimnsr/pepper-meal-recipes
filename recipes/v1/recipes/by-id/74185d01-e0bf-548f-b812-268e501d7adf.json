  "id": "74185d01-e0bf-548f-b812-268e501d7adf",
  "slug": "air-fryer-frozen-french-fries",
  "name": "Air Fryer Frozen French Fries",
  "recipe_type": "side",
  "brief_description": "Use your air fryer to quickly heat up frozen French fries.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place frozen French fries in a large bowl. Add olive oil and toss to coat. Season with salt and toss to coat again."
    },
    {
      "position": 3,
      "text": "Spread out French fries in the basket of the air fryer, making sure to not overcrowd, and cook for 10 minutes. Turn fries over using a spatula and continue cooking until desired crispness, 2 to 4 minutes more."
    }
  ],
  "servings": 2,

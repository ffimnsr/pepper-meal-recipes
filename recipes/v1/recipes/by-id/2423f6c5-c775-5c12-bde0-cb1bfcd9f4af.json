  "id": "2423f6c5-c775-5c12-bde0-cb1bfcd9f4af",
  "slug": "bangers-and-mash",
  "name": "Bangers and Mash",
  "recipe_type": "side",
  "brief_description": "One of the classic meat and potatoes meals. A great British dish my grandmother made for us on those cold and stormy days.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place potatoes in a saucepan with enough water to cover. Bring to a boil, and cook until tender, about 20 minutes. Drain, and mash with 1 teaspoon of butter, and enough milk to reach your desired creaminess. Continue mashing, or beat with an electric mixer, until smooth. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "In a large skillet over medium heat, cook the sausage until heated through. Remove from pan, and set aside. Add remaining teaspoon of butter to the skillet, and fry the onions over medium heat until tender. Mix gravy mix and water as directed on the package, and add to the skillet with the onions. Simmer, stirring constantly, to form a thick gravy."
    },
    {
      "position": 3,
      "text": "Pour half of the gravy into a square casserole dish so that is coats the bottom. Place sausages in a layer over the gravy (you can butterfly the sausages if you wish). Pour remaining gravy over them, then top with mashed potatoes."
    },
    {
      "position": 4,
      "text": "Bake uncovered for 20 minutes in the preheated oven, or until potatoes are evenly brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

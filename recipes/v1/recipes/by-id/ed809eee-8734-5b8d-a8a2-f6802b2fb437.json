{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ed809eee-8734-5b8d-a8a2-f6802b2fb437",
  "slug": "carrot-cake-cupcakes-with-lemon-cream-cheese-frosting",
  "name": "Best Carrot Cake Cupcakes",
  "recipe_type": "appetizer",
  "brief_description": "These carrot cake cupcakes are much easier to make than the classic cake and topped with a lemony cream cheese frosting for a special Easter treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Line 24 muffin cups with liners."
    },
    {
      "position": 2,
      "text": "To make the carrot cake cupcakes: Stir flour, sugar, baking powder, cinnamon, nutmeg, and salt together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Add oil, eggs, and vanilla; mix well. Add carrots; mix until well blended."
    },
    {
      "position": 4,
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into a cupcake comes out clean, about 20 minutes. Cool cupcakes briefly in the pans on a wire rack. Remove cupcakes from the pans; cool completely."
    },
    {
      "position": 6,
      "text": "To make the lemon frosting: Beat cream cheese, butter, and lemon extract together in a large bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 7,
      "text": "Gradually beat in confectioners\u2019 sugar until smooth. If frosting is too thick to spread, gradually beat in milk."
    },
    {
      "position": 8,
      "text": "Frost cooled cupcakes with frosting."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "slug": "slow-cooker-chicken-caesar-sandwiches-recipe-11703247",
  "name": "Slow Cooker Chicken Caesar Sandwiches",
  "recipe_type": "main",
  "brief_description": "These slow cooker chicken Caesar sandwiches essentially are saucy Caesar-dressed shredded chicken sandwiches topped with lettuce. Both chicken breasts and chicken thighs work well in this recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chicken and broth in a 4- to 6-quart slow cooker."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low 3 to 4 hours for breasts or 4 to 5 hours for thighs or on High 1 1/2 to 2 hours for breasts or 2 to 2 1/2 hours for thighs. Transfer chicken to a cutting board and shred with two forks. Discard cooking liquid."
    },
    {
      "position": 4,
      "text": "Add shredded chicken, Caesar dressing, Parmesan cheese, and pepper to the slow cooker. Cover and cook on High for 20 minutes or until heated through. Stir in parsley."
    },
    {
      "position": 5,
      "text": "Divide hot chicken mixture between buns and top with shredded lettuce and additional dressing, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 200,

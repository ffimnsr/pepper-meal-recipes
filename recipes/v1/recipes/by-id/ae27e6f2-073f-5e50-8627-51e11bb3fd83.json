  "id": "ae27e6f2-073f-5e50-8627-51e11bb3fd83",
  "slug": "pumpkin-pie-with-vanilla-meringue",
  "name": "Pumpkin Pie with Vanilla Meringue",
  "recipe_type": "dessert",
  "brief_description": "Michelle Lopez uses \"next-level whipped cream\" to make her pumpkin pie a showstopper.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Follow the directions for making Allrecipes' Simple Pumpkin Pie , then make the meringue."
    },
    {
      "position": 2,
      "text": "Place the sugar, egg whites, cream of tartar, and salt in the top pan of a double boiler or in a heatproof bowl set over a medium, heavy-bottomed saucepan filled with a few inches of simmering water (be sure the bottom of the bowl does not touch the water)."
    },
    {
      "position": 3,
      "text": "Cook over medium heat, using a heatproof rubber spatula to stir the mixture and scrape the sides of the bowl occasionally, until the sugar is completely melted and the candy thermometer inserted in the center of the mixture reads 160 degrees F (70 degrees C)."
    },
    {
      "position": 4,
      "text": "Immediately pour the mixture into the bowl of a stand mixer fitted with the whisk attachment. Whisk on low for 1 minute, then increase the speed to medium-high and whisk for 10 minutes, or until stiff, glossy peaks form and the sides of the bowl should feel cool to touch. Add the vanilla and mix on medium-low speed until combined."
    },
    {
      "position": 5,
      "text": "Use immediately by scooping the meringue over the pumpkin pie. Use a chef's torch (see foot note) to toast the meringue and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

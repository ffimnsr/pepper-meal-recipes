  "id": "845ce519-d3a2-5100-96d7-adf6d433ebc2",
  "slug": "syrian-bread",
  "name": "Syrian Bread",
  "recipe_type": "main",
  "brief_description": "A versatile Middle Eastern-style flatbread that you can serve with lunch or dinner. Mix the dough in your bread machine or stand mixer.",
  "cuisine": "Syrian",
  "instructions": [
    {
      "position": 1,
      "text": "Place ingredients in the pan of the bread machine in the order recommended by the manufacturer. Select Dough cycle; press Start."
    },
    {
      "position": 2,
      "text": "When the Dough cycle is almost complete, preheat the oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface. Divide into eight equal pieces and form into rounds. Cover the rounds with a damp cloth and let rest."
    },
    {
      "position": 4,
      "text": "Roll dough into thin flat circles, about 8 inches in diameter. Cook two at a time on preheated baking sheets or a baking stone until puffed up and golden brown, about 5 minutes. Repeat for remaining loaves."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

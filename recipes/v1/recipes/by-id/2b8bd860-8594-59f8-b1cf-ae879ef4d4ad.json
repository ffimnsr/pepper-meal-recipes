{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2b8bd860-8594-59f8-b1cf-ae879ef4d4ad",
  "slug": "split-pea-soup-with-homemade-ham-bone-stock",
  "name": "Split Pea Soup with Homemade Ham Bone Stock",
  "recipe_type": "soup",
  "brief_description": "This split pea soup with ham stock is delicious, with a rich stock of onion, carrots, celery, garlic, and bay leaves \u2014 the perfect post-Easter meal!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make stock: Combine water, ham bone, baby carrots, celery, tomato, quartered onion, garlic, and bay leaves in a large stockpot. Bring to a boil. Reduce heat to medium and simmer stock for 3 hours."
    },
    {
      "position": 2,
      "text": "Remove 1 1/2 to 2 cups ham meat from bone; dice and set aside for use in soup."
    },
    {
      "position": 3,
      "text": "Pour stock through a strainer and discard solids. Transfer stock to a covered container and refrigerate until fat rises to the top and solidifies, 1 to 3 hours."
    },
    {
      "position": 4,
      "text": "Skim off fat and pour stock into a slow cooker."
    },
    {
      "position": 5,
      "text": "Make soup: Melt butter in a large saucepan. Cook and stir baby carrots, red onion, and garlic in hot butter until browned, 7 to 8 minutes. Pour wine into the pan and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon. Add to the slow cooker."
    },
    {
      "position": 6,
      "text": "Rinse and drain split peas and add to the slow cooker. Add reserved ham meat, potatoes, sazon seasoning, black pepper, and sea salt; stir well."
    },
    {
      "position": 7,
      "text": "Cook on High until soup is thickened, 5 to 6 hours."
    },
    {
      "position": 8,
      "text": "Transfer about 1/3 of the soup to a blender. Cover and hold the lid down with a potholder; pulse a few times before leaving on to blend. Return pur\u00e9e to the slow cooker and stir."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 500,

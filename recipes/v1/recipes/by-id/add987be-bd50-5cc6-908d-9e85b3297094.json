  "id": "add987be-bd50-5cc6-908d-9e85b3297094",
  "slug": "simple-turkey-gravy",
  "name": "Simple Turkey Gravy",
  "recipe_type": "side",
  "brief_description": "This simple turkey gravy recipe is made with turkey pan drippings, flour, and stock for a smooth, flavorful homemade gravy for your Thanksgiving feast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat fat in a medium saucepan over medium-low heat, 2 to 3 minutes. Whisk in flour; continue to cook until paste turns golden, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Gradually whisk in drippings and stock. Increase heat to medium and cook, whisking vigorously, until smooth and thick, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Season gravy to taste with pepper. Serve hot."
    }
  ],

  "id": "7ee6893f-a286-5745-941e-3bf76e7661da",
  "slug": "chicken-saag",
  "name": "Chicken Saag",
  "recipe_type": "main",
  "brief_description": "Chicken saag is a classic Indian dish made with chicken, fresh spinach, and an array of spices. Sour cream makes this dish rich and creamy.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat; add chicken pieces and cook until browned, about 8 minutes per side. Set chicken aside."
    },
    {
      "position": 2,
      "text": "Place spinach into a large pot with 1/4 cup of water; bring to a boil, cover, and remove from heat. Allow spinach to steam for about 10 minutes; transfer into a blender and pulse until very finely chopped. Set spinach aside."
    },
    {
      "position": 3,
      "text": "Place onions, garlic, and ginger into the skillet; fry over medium heat, stirring frequently, until lightly browned, about 10 minutes. Pour in tomatoes, ground coriander, salt, cayenne pepper, turmeric, cardamom, and cloves; stir in 1 tablespoon water, and cook, stirring frequently, for 10 minutes."
    },
    {
      "position": 4,
      "text": "Pour in milk and stir to combine. Add browned chicken pieces; bring to a simmer, reduce heat, cover, and simmer until chicken is tender, about 20 minutes. Stir in spinach and garam masala; cook until spinach starts to stick to the skillet, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Stir in sour cream and bring to a simmer. Remove from heat and stir in butter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "e543b484-9288-567b-baa8-45fa7a537119",
  "slug": "mincemeat",
  "name": "Mincemeat",
  "recipe_type": "dessert",
  "brief_description": "This mincemeat recipe makes a classic fruity filling for Christmas mince pies with apples, brandy, raisins, almonds, and homemade mixed spice.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "To make mixed spice: Combine cinnamon, cloves, ginger, nutmeg, and allspice in a bowl. Reserve 1 heaped teaspoon for the mincemeat. Store the rest in a small jar for a later use."
    },
    {
      "position": 2,
      "text": "Immerse two clean, 12-ounce jars in simmering water until mincemeat is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 3,
      "text": "To make the mincemeat: Combine apple, sultanas, sugar, currants, raisins, and butter in a saucepan. Cook over low heat and stir gently until butter has melted. Stir in chopped almonds, orange zest, 1 teaspoon mixed spice, and cinnamon."
    },
    {
      "position": 4,
      "text": "Bring mixture to a simmer and cook, stirring occasionally, 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove from heat and set mincemeat aside to cool down for 30 minutes. Stir in brandy. Spoon into sterilized jars."
    },
    {
      "position": 6,
      "text": "Refrigerate sealed jars for up to 3 months. Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

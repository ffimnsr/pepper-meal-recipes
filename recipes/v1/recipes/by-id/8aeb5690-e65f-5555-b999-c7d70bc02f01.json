  "id": "8aeb5690-e65f-5555-b999-c7d70bc02f01",
  "slug": "big-mac-tater-tot-casserole-recipe-11806624",
  "name": "Big Mac Tater Tot Casserole",
  "recipe_type": "main",
  "brief_description": "In this Big Mac Tater Tot casserole, savory ground beef and melted American cheese create a rich base, while Thousand Island dressing and mustard add tangy balance. Crisp potato tots give crunch, and dill pickles, sesame seeds, and iceberg lettuce provide a fresh, briny finish reminiscent of the classic Big Mac.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook beef and onion in a 12-inch cast iron skillet over medium heat, stirring often, until beef is no longer pink and onion is softened, 6 to 8 minutes. Remove from heat and let cool slightly, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Add Thousand Island dressing, American cheese, mustard, and 1/2 teaspoon salt to beef mixture; stir until combined. \u200b\u200bSpread mixture evenly in the skillet."
    },
    {
      "position": 4,
      "text": "Sprinkle pickles evenly over beef mixture."
    },
    {
      "position": 5,
      "text": "Arrange tater tots evenly over the beef mixture; sprinkle evenly with toasted sesame seeds and remaining 1/4 teaspoon salt."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tots are crisp, mixture is bubbly, and cheese is melted, 30 to 35 minutes."
    },
    {
      "position": 7,
      "text": "Top evenly with iceberg lettuce, drizzle with Thousand Island dressing, and garnish with additional pickles; serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

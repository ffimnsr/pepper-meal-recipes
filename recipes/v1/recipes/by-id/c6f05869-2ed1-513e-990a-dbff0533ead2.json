  "schema_version": 1,
  "id": "c6f05869-2ed1-513e-990a-dbff0533ead2",
  "slug": "easy-banana-bread-cinnamon-rolls-recipe-11792491",
  "name": "Easy Banana Bread Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "These easy banana bread cinnamon rolls use crescent roll dough\u2014no kneading necessary! The dough oozes with a tender, sweetly spiced banana filling with bit of crunch from toasted walnuts, and the cream cheese frosting makes these the perfect 2-bite sweet!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (180 degrees C). Lightly grease an 8x8-inch baking pan with cooking spray; set aside."
    },
    {
      "position": 2,
      "text": "For rolls, roll out crescent dough sheet onto a clean work surface, and shape into an 8x12-inch rectangle."
    },
    {
      "position": 3,
      "text": "Stir mashed banana and melted butter together in a small bowl until evenly combined. Spread butter mixture evenly on top of crescent dough, leaving a 1/4-inch border along the longer side farthest from you."
    },
    {
      "position": 4,
      "text": "Combine brown sugar, cinnamon, and nutmeg in a small bowl; sprinkle mixture evenly over banana mixture. Sprinkle evenly with chopped walnuts."
    },
    {
      "position": 5,
      "text": "Roll dough up tightly and carefully to form a log, starting from the longer side closest to you. Pinch the seam gently to seal."
    },
    {
      "position": 6,
      "text": "Cut dough log into 9 slices, about 1 1/4-inches thick. Arrange slices, cut side down, about 1/2-inch apart on the prepared baking pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes. Remove from the oven and let rest in baking pan."
    },
    {
      "position": 8,
      "text": "Meanwhile, for icing, beat cream cheese and butter together with an electric mixer on medium speed until combined, 1 to 2 minutes. Add confectioner\u2019s sugar and vanilla extract; beat until smooth, about 1 minute."
    },
    {
      "position": 9,
      "text": "Spread icing over warm rolls, garnish with cinnamon, and serve immediately. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

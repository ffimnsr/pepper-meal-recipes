  "id": "f74d6417-d8b2-58ba-a075-41ddb23055ad",
  "slug": "bing-cherry-gelatin-mold",
  "name": "Bing Cherry Gelatin Mold",
  "recipe_type": "salad",
  "brief_description": "Cherry gelatin mold with Bing cherries, pineapple, and pecans. This has been my family's favorite for Thanksgiving for many, many years.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan, combine the reserved cherry juice with the cola. Bring to a boil, and stir in the gelatin until dissolved. Remove from the heat, and mix in the drained cherries, drained pineapple, and chopped pecans. Pour mixture into a mold sprayed with non-stick cooking spray, and refrigerate for at least 24 hours before serving."
    }
  ],

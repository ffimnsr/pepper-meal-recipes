  "id": "8beeee3b-74f1-5ca9-833a-85502a441e4e",
  "slug": "the-rebbetzin-chefs-persian-walnut-cookies",
  "name": "The Rebbetzin Chef's Persian Walnut Cookies",
  "recipe_type": "dessert",
  "brief_description": "These delicately spiced, rose-scented Persian cookies are the perfect treat for Passover since they contain no flour. They are nutty, rich, and slightly chewy with a crunchy exterior.",
  "cuisine": "Persian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix together ground walnuts, sugar, 3 egg yolks, cardamom, baking soda, and rose water in a medium bowl until well blended. Roll teaspoon-sized pieces of dough into balls and place 2 inches apart onto the prepared baking sheets."
    },
    {
      "position": 3,
      "text": "Whisk together remaining egg yolk and water using a fork. Press a walnut piece into each cookie, then brush with egg yolk glaze."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 20 minutes. The cookies will appear soft and undercooked but they will harden considerably when cooled."
    },
    {
      "position": 5,
      "text": "Remove from the oven and allow to cool on the baking sheets for at least 10 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

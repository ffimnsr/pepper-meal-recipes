  "id": "94025b06-a840-54cd-b3bc-a52154e75d2d",
  "slug": "lemon-cheesecake-bars",
  "name": "Lemon Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "These creamy lemon cheesecake bars are even smoother than regular lemon bars and made 100% from scratch starting with a simple shortbread cookie crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with aluminum foil."
    },
    {
      "position": 2,
      "text": "Mix shortbread crumbs, flour, and brown sugar in a medium bowl. Cut in butter using 2 knives or a pastry blender until mixture resembles coarse crumbs. Press over the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat cream cheese and white sugar using an electric mixer until well blended. Add eggs and flour. Mix well. Blend in lemon juice, lemon zest, and baking powder. Pour filling over the crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until center is set, 25 to 28 minutes. Let cool completely, at least 45 minutes. Refrigerate until well chilled, about 2 hours. Sprinkle with confectioners' sugar right before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

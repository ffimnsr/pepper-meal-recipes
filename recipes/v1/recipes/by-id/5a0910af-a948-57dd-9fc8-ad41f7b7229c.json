  "id": "5a0910af-a948-57dd-9fc8-ad41f7b7229c",
  "slug": "blenty-of-blintzes",
  "name": "Blenty of Blintzes",
  "recipe_type": "breakfast",
  "brief_description": "Not exactly a blintz, but who cares when it tastes as great and is as fun to make as this layered brunch dish? Blenty of blintzes, indeed!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x9 inch baking dish."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix flour, baking powder, butter and sugar. Stir in eggs and milk. In a separate medium bowl, mix cottage cheese, butter, egg, sour cream and salt."
    },
    {
      "position": 3,
      "text": "Place 1/2 the flour mixture in the baking dish. Cover with the cottage cheese mixture, and top with remaining flour mixture."
    },
    {
      "position": 4,
      "text": "Bake 50 minutes in the preheated oven, until puffed and golden brown. Allow to cool slightly, and cut into squares to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "be563b57-4d8e-5322-b593-913919ed7699",
  "slug": "cheese-ball-i",
  "name": "Christmas Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This Christmas cheese ball is made with cream cheese and Cheddar, and coated in chopped pecans. It's perfect for festive gatherings or gifting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, Cheddar cheese, and dressing mix together in a large bowl; form mixture into one large ball or two smaller balls."
    },
    {
      "position": 3,
      "text": "Roll in chopped pecans to coat surface."
    },
    {
      "position": 4,
      "text": "Decorate the top with pecan halves. Refrigerate for at least 2 hours, or overnight."
    }
  ],

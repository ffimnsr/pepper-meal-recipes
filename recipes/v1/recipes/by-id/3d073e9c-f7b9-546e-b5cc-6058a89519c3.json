  "id": "3d073e9c-f7b9-546e-b5cc-6058a89519c3",
  "slug": "chef-johns-flour-tortillas",
  "name": "Chef John's Flour Tortillas",
  "recipe_type": null,
  "brief_description": "With a handful of ingredients \u2014 flour, salt, baking powder, shortening, and hot water \u2014 Chef John's recipe for flour tortillas are tender and flavorful.",
  "cuisine": "American Mexican Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1 \u00be cups flour, salt, and baking powder together in a large bowl. Cut in vegetable shortening using a pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 2,
      "text": "Form a well in the middle. Mix in hot water, working flour mixture and water together with a fork. Transfer to a cutting board."
    },
    {
      "position": 3,
      "text": "Knead until a smooth, soft dough is formed, about 3 minutes. Add more flour if dough is too sticky."
    },
    {
      "position": 4,
      "text": "Flour the cutting board, cover dough with the bowl, and let rest for 15 minutes."
    },
    {
      "position": 5,
      "text": "Cut dough into eight equal parts; cover until needed. Roll out dough balls by hand or with a tortilla press."
    },
    {
      "position": 6,
      "text": "Heat a large skillet over medium-high heat. Place 1 tortilla in skillet; cook until begins to bubble, about 1 minute. Flip tortilla; cook 1 minute more. Flip again and cook 1 minute more. Repeat with remaining tortillas."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3fbbd0d8-17b3-582d-8cfd-4b7c752d5a17",
  "slug": "sausage-and-shrimp-gumbo",
  "name": "Sausage and Shrimp Gumbo",
  "recipe_type": "soup",
  "brief_description": "This sausage and shrimp gumbo features bell peppers, celery, onion, and okra simmered in a rich, thick, spicy broth ladled into bowls over white rice.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Cut sausage into 1/2-inch slices; set aside."
    },
    {
      "position": 2,
      "text": "Combine oil and flour in a 4-quart heavy saucepan; mix until smooth. Cook and stir over medium-high heat for 3 minutes. Reduce heat to medium; cook and stir until roux is a dark reddish brown, 6 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Stir in onion, bell peppers, celery, okra and garlic; cook and stir until vegetables are tender, 8 to 10 minutes. Stir in Cajun seasoning."
    },
    {
      "position": 4,
      "text": "Pour in broth; bring to a boil. Cook and stir for 1 minute. Reduce heat to low; add sausage, pepper sauce, black pepper and salt. Cover and simmer for 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove the lid and bring to a boil; add shrimp and cook until shrimp turn pink, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Portion rice into bowls. Ladle gumbo over rice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

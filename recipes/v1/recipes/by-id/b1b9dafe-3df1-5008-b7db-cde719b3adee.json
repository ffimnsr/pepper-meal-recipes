  "id": "b1b9dafe-3df1-5008-b7db-cde719b3adee",
  "slug": "texas-jambalaya",
  "name": "Texas Jambalaya",
  "recipe_type": "soup",
  "brief_description": "This jambalaya is a hearty, filling meal. A variation of the classic, this dish uses spicy tomatoes with green chiles and ranch-style beans.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan over medium heat. Saut\u00e9 onion, green pepper, and celery until onions are soft and translucent. Stir in garlic, and cook another minute. Add rice, sausage, and ham. Cook 2 to 3 minutes, to coat rice with oil, frequently stirring. Pour in tomatoes with green chiles and chicken broth. Season with thyme and bay leaf. Bring to a boil, then reduce heat. Cover and simmer, 20 to 25 minutes or until liquid is absorbed. Stir in beans, mix well, and heat through."
    }
  ],
  "servings": 6,

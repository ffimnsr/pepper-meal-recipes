  "id": "1d73ec6b-7693-5891-b588-22882d4ea7c8",
  "slug": "fire-roasted-cherry-tomato-salsa",
  "name": "Fire-Roasted Cherry Tomato Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This flavor-packed cherry tomato salsa from Chef John is full of smoky goodness and guaranteed to shine on any snack or appetizer table.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and brush with olive oil."
    },
    {
      "position": 2,
      "text": "Spread tomatoes, onion, garlic, and jalape\u00f1o peppers onto prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Cook under the preheated broiler for 5 minutes. Turn the baking sheet and continue broiling until vegetables are charred, about 5 minutes more. Cool slightly."
    },
    {
      "position": 4,
      "text": "Remove garlic from skins; discard skins."
    },
    {
      "position": 5,
      "text": "Blend tomatoes, onion, peeled garlic, jalape\u00f1os, any accumulated juices from the baking sheet, cilantro leaves, lime juice, cumin, cayenne pepper, and oregano in a blender until salsa is smooth. Transfer to a bowl, cover with plastic wrap, and refrigerate until flavors blend, at least 2 hours. Season with salt and black pepper."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

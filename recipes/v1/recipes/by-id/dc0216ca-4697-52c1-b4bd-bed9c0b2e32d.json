  "id": "dc0216ca-4697-52c1-b4bd-bed9c0b2e32d",
  "slug": "copycat-din-tai-fung-cucumber-salad-recipe-8705202",
  "name": "Copycat Din Tai Fung Cucumber Salad",
  "recipe_type": "salad",
  "brief_description": "This copycat Din Tai Fung cucumber salad is fresh and simple with a sesame chili soy vinaigrette. Sprinkle with crushed chile flakes just before serving if you like more heat.",
  "cuisine": "Asian Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Place cucumbers in a large bowl. Sprinkle with salt and let stand for 30 minutes."
    },
    {
      "position": 2,
      "text": "Rinse cucumbers with water to remove salt, and pat dry with paper towels."
    },
    {
      "position": 3,
      "text": "Whisk soy sauce, vinegar, garlic, sugar, sesame oil, and chili oil in a separate bowl until smooth."
    },
    {
      "position": 4,
      "text": "Add cucumber slices to the oil mixture; stir to combine. Let stand for 10 minutes. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

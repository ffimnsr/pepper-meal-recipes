  "slug": "giblet-gravy-ii",
  "name": "Easy Giblet Gravy",
  "recipe_type": "side",
  "brief_description": "This easy giblet gravy recipe is an old-fashioned, delicious turkey gravy, simple to make and perfect for your Thanksgiving or holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat pan drippings in a large skillet over medium heat; gradually add flour and stir until golden brown."
    },
    {
      "position": 2,
      "text": "Slowly whisk in turkey stock until blended and smooth. Stir in giblets, and season with sage, pepper, and salt. Bring to a boil, reduce heat, and simmer for 8 to 10 minutes, or until thickened."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

  "id": "41b25122-8958-53f9-b786-a6e949a52da8",
  "slug": "watermelon-lemonade",
  "name": "Watermelon Lemonade",
  "recipe_type": "drink",
  "brief_description": "Watermelon lemonade is a deliciously refreshing combination of classic lemonade and freshly pureed watermelon served over ice for a cold summer drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place watermelon into a blender; cover and puree until smooth. Strain through a fine mesh sieve."
    },
    {
      "position": 3,
      "text": "Bring sugar and 1/2 cup water to a boil in a saucepan over medium-high heat until sugar dissolves, about 5 minutes. Remove from heat; stir in 3 cups of cold water and lemon juice."
    },
    {
      "position": 4,
      "text": "Divide ice into 12 glasses; scoop 2 to 3 tablespoons of watermelon puree over ice, then top with lemonade."
    },
    {
      "position": 5,
      "text": "Gently stir before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

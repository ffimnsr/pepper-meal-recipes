{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ee0d1b05-dbf3-5a66-aa6e-242625482df3",
  "slug": "authentic-taralli",
  "name": "Authentic Taralli",
  "recipe_type": "appetizer",
  "brief_description": "This authentic recipe for taralli comes from the Puglia region in Italy. Taralli are a yeast-free, crispy cross between a bagel, a pretzel, and a breadstick.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, 1/4 teaspoon salt, oil, and wine in a stand mixer. Mix ingredients using the paddle attachment until a ball forms. Switch to the dough hook and knead dough for 10 minutes."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with parchment paper. Bring a large pot of water to boil over high heat and add the remaining salt. Spread a large, clean cloth out on a counter or table."
    },
    {
      "position": 3,
      "text": "Pinch off a walnut-sized piece of dough once kneading has finished. Roll dough piece into a snake about 2 1/2 inches long. Form a tear drop shape, lightly pressing the two ends together to seal them into a ring. Repeat with remaining dough."
    },
    {
      "position": 4,
      "text": "Turn down the boiling water to a low boil. Drop taralli into the water a few at a time. Do not stir; they will sink at first, then begin to float. Remove floating taralli with a slotted spoon. Place them on the clean cloth and continue until all the taralli have boiled and are drained on the cloth. Place them on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until taralli are golden and firm on the outside, but still soft on the inside, about 40 minutes. Cool completely and rest for at least 1 hour before serving. Wrap with a clean cloth or place in a paper bag; store at room temperature for up to 1 week."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 40,

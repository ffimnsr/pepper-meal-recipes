  "slug": "creamy-no-churn-mayo-ice-cream-recipe-11979749",
  "name": "Creamy No-Churn Mayo Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This creamy no-churn mayo ice cream is unbelievably smooth, rich, and easy to make with just a handful of ingredients\u2014no ice cream maker required. The mayonnaise adds extra creaminess and a velvety texture, creating a surprisingly delicious frozen treat that\u2019s perfectly scoopable straight from the freezer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sweetened condensed milk, heavy cream, milk, mayonnaise, and vanilla paste in the bowl of a stand mixer fitted with the whisk attachment. Whip at medium speed until thickened slightly and frothy."
    },
    {
      "position": 2,
      "text": "Transfer mixture to a loaf pan and place in the freezer for at least 8 hours ."
    }
  ],
  "servings": 8,

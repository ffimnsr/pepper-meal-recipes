  "id": "fc4291b8-e62d-5fea-9b24-923520181522",
  "slug": "mushroom-and-endive-soup",
  "name": "Mushroom and Endive Soup",
  "recipe_type": "soup",
  "brief_description": "A hearty yet light blend of mushrooms and endive that gets progressively spicier as you eat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil and butter in a Dutch oven or soup pot over medium heat. Add the onion, 1/2 cup of cilantro, and mushrooms; cook and stir until tender. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Pour in the chicken broth, and bring to a boil. Stir in the endive and remaining cilantro. Add the milk, and simmer for about 30 minutes over low heat. Season with cayenne pepper to taste."
    },
    {
      "position": 3,
      "text": "Place the yogurt in a separate pan or bowl, and gradually ladle in about 2 cups of the hot broth while stirring constantly. Stir this mixture back into the main soup pot, and remove from heat. If this procedure is not followed, the yogurt will break down into little bits. It will still taste good, but does not look the same. Ladle into bowls, and garnish with additional fresh cilantro."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d3502798-63ba-5f3f-b851-72b3a0dffe31",
  "slug": "baked-ziti-iv",
  "name": "Baked Ziti IV",
  "recipe_type": "main",
  "brief_description": "Ziti pasta is layered with Provolone, mozzarella, cottage cheese, sour cream and a meaty sauce with ground beef and sausage.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in boiling water for 8 to 10 minutes, or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in large, heavy skillet over medium heat. Cook onion in oil until tender. Stir in rosemary and garlic. Transfer to a small bowl."
    },
    {
      "position": 3,
      "text": "Place ground beef and sausage in the skillet. Cook over medium-high heat until evenly brown. Stir in the onion mixture and the spaghetti sauce. Season with salt. Reduce heat to low, and simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish. In the prepared dish, layer 1/2 of the cooked pasta, provolone cheese, sour cream, cottage cheese, and a little less than 1/2 of the meat mixture. Then layer the rest of the pasta, mozzarella cheese, remaining meat mixture, and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 to 30 minutes, or until heated through and cheeses are melted."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "e2994d58-ba99-52a7-8c8d-709e619acc7d",
  "slug": "baked-french-fries-i",
  "name": "Baked French Fries",
  "recipe_type": "side",
  "brief_description": "This baked French fries recipe uses olive oil and seasons the potatoes with paprika, garlic powder, onion powder, and chili for a fantastic flavor!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut potato into thick wedges."
    },
    {
      "position": 3,
      "text": "Mix olive oil, paprika, garlic powder, chili powder, and onion powder together in a medium bowl. Add potato wedges and toss to coat evenly; arrange on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, turning once or twice, until golden brown and crispy, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

  "id": "09ddc2aa-3e6b-5c23-b0ce-2a2f6c305495",
  "slug": "tex-mex-tuna-salad",
  "name": "Tex-Mex Tuna Salad",
  "recipe_type": "salad",
  "brief_description": "Tuna, olives, lettuce, green onions, and celery are spooned into taco shells and dressed with a wonderful salsa/mayonnaise dressing with just a bit of cumin added for zest. A dollop of sour cream and your ready.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine the tuna, olives, green onions and celery; toss together."
    },
    {
      "position": 2,
      "text": "In a medium bowl, whisk together the salsa, sour cream and cumin. Pour over tuna mixture; lightly toss to mix."
    },
    {
      "position": 3,
      "text": "Line taco shells with shredded lettuce and spoon tuna mixture into shells. Drizzle with additional salsa or top with additional sour cream if desired."
    }
  ],
  "servings": 6,

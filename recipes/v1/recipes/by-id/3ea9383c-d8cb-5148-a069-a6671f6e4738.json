  "id": "3ea9383c-d8cb-5148-a069-a6671f6e4738",
  "slug": "butternut-and-acorn-squash-soup",
  "name": "Butternut and Acorn Squash Soup",
  "recipe_type": "soup",
  "brief_description": "Butternut and acorn squash make for a rich and sweet yet surprisingly simple soup that is wonderful served hot with crusty bread or cold with a dollop of sour cream.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place the squash halves cut side down in a baking dish. Bake 45 minutes, or until tender. Remove from heat, and cool slightly. Scoop the pulp from the skins. Discard skins."
    },
    {
      "position": 2,
      "text": "Melt the butter in a skillet over medium heat, and saute the onion until tender."
    },
    {
      "position": 3,
      "text": "In a blender or food processor, blend the squash pulp, onion, broth, brown sugar, cream cheese, pepper, and cinnamon until smooth. This may be done in several batches."
    },
    {
      "position": 4,
      "text": "Transfer the soup to a pot over medium heat, and cook, stirring occasionally, until heated through. Garnish with parsley, and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

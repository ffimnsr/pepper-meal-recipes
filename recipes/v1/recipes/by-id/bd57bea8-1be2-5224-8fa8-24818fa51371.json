  "id": "bd57bea8-1be2-5224-8fa8-24818fa51371",
  "slug": "pineapple-upside-down-pound-cake",
  "name": "Pineapple Upside-Down Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This pineapple upside-down pound cake recipe is made in a fluted tube pan and filled with pineapple, cherries, cream cheese, plus white and brown sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 10-inch fluted tube pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat cream cheese and butter together in a bowl using an electric mixer until creamy. Add white sugar; beat until light and fluffy. Add eggs, alternating with flour, starting and ending with an egg, beating well after each addition. Beat in almond extract, pineapple extract, and food coloring."
    },
    {
      "position": 3,
      "text": "Pour brown sugar evenly into bottom of the prepared pan. Arrange pineapple rings on top; place 1 cherry in center of each ring. Pour batter evenly over pineapple rings."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top is golden brown and springs back when lightly pressed, about 45 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

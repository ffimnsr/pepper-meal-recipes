  "id": "0b8ad8bb-e4fc-584d-845b-2417ed93a454",
  "slug": "5-ingredient-beef-chili-recipe-11893080",
  "name": "5-Ingredient Beef Chili",
  "recipe_type": "soup",
  "brief_description": "This 5-ingredient beef chili is is savory and mild, comforting and effortless made in the Instant Pot. Feel free to add additional garnishes like chopped onion, sour cream, and a side of cornbread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Crumble ground beef into the pot, and cook until browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Drain off any excess liquid. Sprinkle beef with salt and pepper. Pour in half the bone broth and tomato sauce. Add 1/2 of the chili beans to the pot."
    },
    {
      "position": 3,
      "text": "Pour remaining bone broth and chill beans into a high power blender, such as a Vitamix\u00ae. Cover with lid and blend on High power for 30 seconds. Pour blended mixture into the Instant Pot\u00ae, but do not stir."
    },
    {
      "position": 4,
      "text": "Close and lock the lid. Select high pressure according to manufacturer\u2019s instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build. Release pressure using the natural-release method according to manufacturer\u2019s instructions, about 5 minutes. Release remaining pressure carefully using the quick-release method according to manufacturer\u2019s instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Season with chili powder and stir to combine. Divide evenly into 4 bowls. Garnish with Cheddar cheese if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

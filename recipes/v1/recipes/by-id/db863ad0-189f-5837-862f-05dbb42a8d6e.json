  "schema_version": 1,
  "id": "db863ad0-189f-5837-862f-05dbb42a8d6e",
  "slug": "classic-lasagna",
  "name": "Classic Lasagna",
  "recipe_type": "dessert",
  "brief_description": "For this classic lasagna recipe, choose hot or sweet Italian sausage. The recipe includes ground beef, tomato sauce, herbs, ricotta, and two cheeses.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook ground beef and sausage in a large pot over medium heat; drain. Stir in tomato sauce, mushrooms, garlic salt, oregano, thyme, and basil; season with salt and black pepper. Simmer 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook lasagna noodles with olive oil in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine ricotta cheese, eggs, and Parmesan cheese in a bowl."
    },
    {
      "position": 5,
      "text": "Cover bottom of a 9x13-inch baking dish with a thin layer of meat sauce; layer 3 lasagna noodles over top. Spread about 1/3 ricotta cheese mixture over noodles; sprinkle about 1/4 mozzarella cheese over top. Spoon about 1/3 meat sauce over mozzarella cheese. Repeat layering twice more, finishing with remaining mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese melts and sauce bubbles, about 90 minutes. Cover lasagna with foil if cheese begins to get too dark. Let sit before serving for 10 to 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

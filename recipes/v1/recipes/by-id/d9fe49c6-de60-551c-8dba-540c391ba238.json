  "id": "d9fe49c6-de60-551c-8dba-540c391ba238",
  "slug": "3-minute-fudge",
  "name": "3-Minute Fudge",
  "recipe_type": "dessert",
  "brief_description": "You only need 3 basic pantry ingredients to mix into smooth, creamy fudge when the urge hits. Fudge mixes up in minutes but needs several hours to set until firm.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease an 8x8-inch square baking dish with butter."
    },
    {
      "position": 2,
      "text": "Place sweetened condensed milk, chocolate chips, and baking chocolate in a microwave-safe dish; cook in microwave on low power until chocolate has melted, about 3 minutes. Beat with an electric mixer until smooth, about 1 minute."
    },
    {
      "position": 3,
      "text": "Pour fudge into the prepared baking dish; let stand until set, 3 to 4 hours. Cut into squares to serve."
    }
  ],
  "servings": 35,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 5,

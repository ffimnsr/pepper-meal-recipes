  "id": "0d787baa-1ee6-5139-9e5e-38b055cccd91",
  "slug": "the-perfect-cinnamon-roll-icing",
  "name": "Perfect Cinnamon Roll Icing",
  "recipe_type": "dessert",
  "brief_description": "This creamy cinnamon roll icing made with cream cheese, butter, vanilla, and confectioners' sugar is the perfect sweet glaze for cinnamon rolls.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat butter and cream cheese together in a large bowl with an electric mixer until creamy."
    },
    {
      "position": 3,
      "text": "Blend in milk and vanilla."
    },
    {
      "position": 4,
      "text": "Gradually mix in confectioners' sugar and salt until smooth and fluffy."
    },
    {
      "position": 5,
      "text": "Frost the cinnamon rolls with about \u00bc of the icing when they are still warm. When they\u2019re cooled, top with remaining icing. The bottom layer will not only melt into the pastry, it will serve as a sort of protective barrier that will keep the cinnamon rolls fresher for longer. Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

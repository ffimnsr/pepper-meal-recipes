  "id": "b72f503c-77ce-5237-91d0-4a167c7da017",
  "slug": "tortellini-lasagna-skillet-recipe-8754041",
  "name": "Tortellini Lasagna Skillet",
  "recipe_type": "main",
  "brief_description": "This tortellini lasagna skillet dish is a one pot meal that has the flavor of lasagna without all the work. The creamy cheese-filled tortellini is a perfect substitute for both the noodles and the traditional ricotta filling.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook ground beef and sausage in a deep dish skillet over medium heat, breaking up the meat with a spatula, until browned, about 5 minutes. Add onion; cook and stir for 5 minutes. Add mushrooms and cook for 5 minutes more. Drain any excess grease."
    },
    {
      "position": 3,
      "text": "Stir in tortellini, crushed tomatoes, diced tomatoes, tomato sauce, Italian seasoning, and garlic. Season with salt and pepper. Smooth out mixture in the skillet, and top with mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and golden, about 35 minutes. Garnish with chopped parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

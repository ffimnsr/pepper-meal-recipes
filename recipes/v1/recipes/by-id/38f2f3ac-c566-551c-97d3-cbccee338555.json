  "id": "38f2f3ac-c566-551c-97d3-cbccee338555",
  "slug": "nicholas-chocolate-chip-cookie-dough-truffles",
  "name": "Nichola's Chocolate Chip Cookie Dough Truffles",
  "recipe_type": "dessert",
  "brief_description": "Little balls of chocolate chip cookie dough are dipped in dark chocolate and drizzled with white chocolate for a sweet and pretty truffle.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place brown sugar and butter in a bowl; beat with an electric mixer until creamy, 4 to 5 minutes. Mix in milk, vanilla, and salt. Add flour; mix thoroughly by hand. Fold 1 cup chocolate chips into the dough. Cover and refrigerate for about 1 hour."
    },
    {
      "position": 2,
      "text": "Scoop out tablespoonfuls of cookie dough and roll into round balls. Arrange them on a plate or baking sheet that will fit in the freezer. Freeze until hard, about 1 hour."
    },
    {
      "position": 3,
      "text": "Place 1 1/2 cup chocolate chips and white chocolate chips in separate microwave-safe bowls. Microwave until soft, about 30 seconds. Stir. Continue to microwave in 10-second intervals, stirring after each interval, until completely melted, 30 seconds to 1 minute."
    },
    {
      "position": 4,
      "text": "Dip cookie dough balls in melted chocolate. Drizzle white chocolate on top. Refrigerate until firm, about 30 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 30,

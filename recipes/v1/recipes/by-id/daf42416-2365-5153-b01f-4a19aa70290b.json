  "id": "daf42416-2365-5153-b01f-4a19aa70290b",
  "slug": "pink-lemonade-jello-shots-recipe-11711372",
  "name": "Pink Lemonade Jello Shots",
  "recipe_type": "appetizer",
  "brief_description": "Pink lemonade jello shots, chilled in hollowed-out lemon peels and cut into wedges, are fun and festive, and a little bit fancy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut lemons into halves lengthwise. Use a paring knife to loosen the pith from the rind and carefully remove the insides from lemon halves; reserve the hollowed peels."
    },
    {
      "position": 2,
      "text": "Add pink lemonade to a small sauce pan over medium heat, and stir in gelatin; heat just until gelatin is completely dissolved, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add pink lemonade mixture, vodka, and lemon vodka to a bowl and stir to combine."
    },
    {
      "position": 4,
      "text": "Place lemon peel halves onto a plate or small rimmed baking sheet, side by side, to ensure they stay upright. Secure lemons with foil or ramekins as needed to hold them upright."
    },
    {
      "position": 5,
      "text": "Carefully pour pink lemonade mixture into lemon peels, filling each one to the top."
    },
    {
      "position": 6,
      "text": "Place filled lemons into the refrigerator and chill until firmly set, at least 3 hours."
    },
    {
      "position": 7,
      "text": "Slice lemons into wedges; keep chilled until ready to serve. Sprinkle with sanding sugar and edible glitter before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

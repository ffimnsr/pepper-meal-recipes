  "id": "4116561f-ccd4-5681-adec-94672161b5e9",
  "slug": "southern-fried-catfish",
  "name": "Southern Fried Catfish",
  "recipe_type": "main",
  "brief_description": "This fried catfish recipe is made with fish fillets marinated in buttermilk and coated with Old Bay cornmeal, deep-fried until crisp and golden brown.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix buttermilk, water, salt, and pepper in a small bowl. Pour mixture into a flat pan large enough to hold fillets."
    },
    {
      "position": 3,
      "text": "Arrange fillets in a single layer in the pan, turning to coat each side. Set aside to marinate."
    },
    {
      "position": 4,
      "text": "Combine cornmeal, flour, and seafood seasoning in a 2-gallon resealable plastic bag."
    },
    {
      "position": 5,
      "text": "Add fillets to the bag, a few at a time, and tumble gently until evenly coated."
    },
    {
      "position": 6,
      "text": "Heat oil in a deep fryer to 365 degrees F (185 degrees C). Fry fillets in hot oil until crisp and golden brown, about 3 minutes. Work in batches to avoid overcrowding, so fillets have room to brown properly."
    },
    {
      "position": 7,
      "text": "Drain on paper towels."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

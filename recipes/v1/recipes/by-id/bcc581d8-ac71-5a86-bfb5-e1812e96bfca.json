  "id": "bcc581d8-ac71-5a86-bfb5-e1812e96bfca",
  "slug": "dianes-colcannon",
  "name": "Diane's Colcannon",
  "recipe_type": "side",
  "brief_description": "Colcannon is a traditional Irish dish of buttery mashed potatoes with green cabbage; bacon adds even more flavor to this St Patrick's Day favorite.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes into a saucepan with enough water to cover. Bring to a boil and cook until tender, 15 to 20 minutes. Drain."
    },
    {
      "position": 3,
      "text": "While pototoes are cooking, cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble and set aside. Reserve drippings in the skillet."
    },
    {
      "position": 4,
      "text": "Saut\u00e9 cabbage and onion in drippings in the skillet over medium heat until soft and translucent, 10 to 15 minutes; cover the skillet to decrease cooking time if desired. Remove from heat."
    },
    {
      "position": 5,
      "text": "Mash potatoes with milk in a large bowl; season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Fold in bacon, cabbage and onion."
    },
    {
      "position": 7,
      "text": "Transfer mixture to a large serving bowl. Make a well in the center of potato mixture and pour in melted butter. Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

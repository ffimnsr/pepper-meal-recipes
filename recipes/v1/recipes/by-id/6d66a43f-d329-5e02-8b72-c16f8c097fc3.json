  "id": "6d66a43f-d329-5e02-8b72-c16f8c097fc3",
  "slug": "no-bake-peanut-butter-cookies-iii",
  "name": "No-Bake Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These no-bake peanut butter cookies combine peanut butter and oats with no eggs for a flavor-packed cookie easy to make on the stovetop in 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, and milk in a saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Bring to a rapid boil and boil for 1 minute."
    },
    {
      "position": 4,
      "text": "Remove from heat and stir in peanut butter and vanilla."
    },
    {
      "position": 5,
      "text": "Mix in oats, stirring until mixture begins to cool. (Transfer mixture to a large bowl if ingredients overflow.)"
    },
    {
      "position": 6,
      "text": "Drop batter by teaspoonfuls onto waxed paper."
    },
    {
      "position": 7,
      "text": "Let cool until set. Serve and enjoy!"
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

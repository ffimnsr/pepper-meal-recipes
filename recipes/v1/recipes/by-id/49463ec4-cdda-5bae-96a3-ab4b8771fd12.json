  "id": "49463ec4-cdda-5bae-96a3-ab4b8771fd12",
  "slug": "simple-chicken-mayo-with-parmesan-and-bread-crumbs",
  "name": "Simple Chicken Mayo with Parmesan and Bread Crumbs",
  "recipe_type": "main",
  "brief_description": "This chicken breast recipe with mayonnaise, Parmesan cheese, bread crumbs, and herbs is incredibly juicy and delicious, plus quick and easy to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place chicken breasts in a baking pan."
    },
    {
      "position": 2,
      "text": "Mix Parmesan cheese and mayonnaise together in a bowl until well combined; spread evenly over chicken breasts. Coat with bread crumbs and sprinkle with herbes de Provence."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until chicken breasts are no longer pink in the center and the juices run clear, 20 to 25 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a0a0132d-c34f-595d-b6cd-359f99adf944",
  "slug": "honey-garlic-chicken-bites-recipe-12005800",
  "name": "Honey Garlic Chicken Bites",
  "recipe_type": "salad",
  "brief_description": "These honey garlic chicken bites are sweet, garlicky, a little sticky, and seriously delicious. Add them to a salad, tuck them into a sandwich, serve them over rice, or enjoy them just as they are. The everything bagel seasoning is optional, but it really takes them over the top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat chicken dry with paper towel towels; cut into bite-size pieces (about 1 inch). Sprinkle chicken pieces with salt, pepper, and garlic granules. Lightly dredge chicken pieces into the cornstarch, leaving a thin dusting."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium-high heat; sear chicken pieces until golden on all sides, 3 to 4 minutes per side. Remove chicken pieces and set aside."
    },
    {
      "position": 3,
      "text": "Add minced garlic to the same skillet; saut\u00e9e until fragrant, about 30 seconds. Stir in chicken broth, honey, and soy sauce. Let sauce bubble gently for 1 to 2 minutes, without boiling."
    },
    {
      "position": 4,
      "text": "Return chicken pieces to the pan, and stir to coat; cook until sauce is slightly thickened and clings to chicken pieces. Sprinkle with everything bagel seasoning."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

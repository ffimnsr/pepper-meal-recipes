  "id": "94fc456b-643a-5874-b16a-445a1e64265e",
  "slug": "cake-mix-coffee-cake-recipe-11894247",
  "name": "Cake Mix Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This cake mix coffee cake is a very moist cake with great brown sugar and cinnamon flavor. The cream cheese drizzle icing makes it the perfect thing to eat with morning coffee. It's a great way to elevate a box of cake mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x9-inch baking pan."
    },
    {
      "position": 2,
      "text": "For cake base, combine cake mix, eggs, sour cream, vegetable oil, and vanilla extract in a bowl. Whisk until smooth; set aside."
    },
    {
      "position": 3,
      "text": "For crumble topping, combine brown sugar, oats, cinnamon, and salt in a bowl. Cut in butter with a pastry cutter or fork until coarse crumbs form."
    },
    {
      "position": 4,
      "text": "Spoon the cake base evenly into the prepared baking pan. Sprinkle the crumble topping evenly over the batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Cool for 30 minutes before serving."
    },
    {
      "position": 6,
      "text": "For drizzle topping, whisk cream cheese, confectioner's sugar, milk, and salt together in a bowl until smooth. Drizzle over the cooled coffee cake before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

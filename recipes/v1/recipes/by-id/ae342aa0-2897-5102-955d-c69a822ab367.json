  "slug": "corn-salad-with-lime-vinaigrette",
  "name": "Corn Salad with Lime Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This summer picnic-salad recipe mixes corn, tomato, and avocado in a simple lime dressing for a delicious side dish or dip for chips.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix corn, tomatoes, avocado, onion, jalapeno pepper, and cilantro together in a bowl."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, and lime juice together in a small bowl; drizzle over the corn salad. Season salad with salt and pepper."
    },
    {
      "position": 3,
      "text": "Cover bowl with plastic wrap and refrigerate at least 30 minutes."
    }
  ],
  "servings": 8,

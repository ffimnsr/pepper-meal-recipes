  "id": "e5ac4692-f13d-5c52-b4f8-f9ac33c802f5",
  "slug": "struffoli",
  "name": "Struffoli",
  "recipe_type": "dessert",
  "brief_description": "These crispy Italian struffoli balls are coated in a warm honey glaze and decorated with colorful sprinkles for a festive sweet and sticky treat.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs, 1/4 cup white sugar, 1/4 cup vegetable oil, and vanilla extract together in a bowl; stir in baking powder."
    },
    {
      "position": 3,
      "text": "Slowly stir flour into egg mixture, about 1 tablespoon at a time, adding more flour if needed, until the dough is firm enough to roll into balls."
    },
    {
      "position": 4,
      "text": "Roll dough into small balls."
    },
    {
      "position": 5,
      "text": "Heat 2 cups vegetable oil in a large saucepan to 350 degrees F (175 degrees C) or until you see little waves on the bottom of the saucepan."
    },
    {
      "position": 6,
      "text": "Working in small batches, fry dough balls in hot oil until lightly browned, 2 to 3 minutes per batch. Transfer struffoli to a paper towel-lined plate using a slotted spoon."
    },
    {
      "position": 7,
      "text": "To make the sweet glaze: Heat honey in a saucepan over medium-low heat. Slowly mix 1/2 cup sugar, a few tablespoons at a time, into honey until sugar is melted and glaze is smooth, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Transfer struffoli to a large bowl and pour glaze on top; toss quickly to evenly coat before glaze hardens."
    },
    {
      "position": 9,
      "text": "Arrange struffoli into a tower shape or Christmas tree shape on a serving plate. Sprinkle nonpareil sprinkles over struffoli."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

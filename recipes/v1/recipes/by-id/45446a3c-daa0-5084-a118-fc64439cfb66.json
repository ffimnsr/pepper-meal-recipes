  "id": "45446a3c-daa0-5084-a118-fc64439cfb66",
  "slug": "cottage-cheese-perogies",
  "name": "Cottage Cheese Perogies",
  "recipe_type": "side",
  "brief_description": "Very easy recipe to make, and a wonderful twist to an ordinary perogy. These cheese filled perogies taste great just boiled or fried with a little butter. Eat them with sour cream and you will have a wonderful dinner. You can easily double or triple the recipe and place extras in the freezer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cottage cheese, egg yolks, and 3/4 teaspoon salt in a medium bowl; set aside."
    },
    {
      "position": 2,
      "text": "Whisk flour, remaining 1 teaspoon salt, and baking powder together in a separate bowl. Add cold water and oil; mix or knead into a smooth dough."
    },
    {
      "position": 3,
      "text": "Roll dough out on a lightly floured surface; cut into 3-inch circles using a glass, can, or cookie cutter. Place a spoonful of cottage cheese filling onto each circle. Fold in half and pinch edges together to seal."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Carefully drop pierogies into water; cook until they float, 3 to 4 minutes. Remove from water with a slotted spoon; place on a cooling rack set over a baking sheet to drain."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "b35000b6-5b6c-564a-a4a6-281a960fc992",
  "slug": "salted-caramel-chocolate-sandwich-cookie",
  "name": "Salted Caramel Chocolate Sandwich Cookie",
  "recipe_type": "dessert",
  "brief_description": "Creamy salted caramel and chocolate ganache are sandwiched between two little butter cookies for this pretty anytime treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cream together butter and sugar. Add egg and vanilla extract and beat until well blended."
    },
    {
      "position": 2,
      "text": "Whisk together flour, Diamond Crystal\u00ae Fine Sea Salt, baking powder and baking soda in a separate bowl. Add dry ingredients to wet ingredients and mix until just combined. Form in 2 balls. Cover bowl with plastic wrap. Refrigerate for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F. Line a baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Roll out each ball to 1/4 inch thickness on a sheet of waxed paper sprinkled with confectioner's sugar. Cut out circles or little shapes using a small 1 1/2-inch cookie cutter. Place on prepared baking sheet. (Note: If dough becomes too soft when rolling out, place back in the refrigerator.)"
    },
    {
      "position": 5,
      "text": "Bake 5 to 7 minutes. Allow cookies to cool on the baking sheet for 5 minutes. Remove cookies and place on wire rack to cool."
    },
    {
      "position": 6,
      "text": "Salted Caramel Filling: Use a microwave safe glass measuring cup. Remove wrappers from caramels. Add caramels, Diamond Crystal\u00ae Fine Sea Salt, and heavy whipping cream to measuring cup. Microwave using 20-second intervals, for approximately 1 minute. Stir after each interval."
    },
    {
      "position": 7,
      "text": "Chocolate Ganache: Use a 1 cup measuring cup. Add 1/4 cup of heavy cream. Microwave until the cream starts to bubble. (Approximately 25-30 seconds.) Remove the heavy cream from the microwave. Add chocolate chips. Let the mixture rest for 2 minutes. Then stir with a spoon until smooth."
    },
    {
      "position": 8,
      "text": "To make sandwich cookies, add 1/2 teaspoon of caramel and 1/2 teaspoon of chocolate ganache to the bottom side of half the cookies. Top with another cookie to make a sandwich cookie."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

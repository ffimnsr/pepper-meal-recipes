  "id": "b74f58cd-5ad8-5672-ae8c-caa295aa96a3",
  "slug": "turkish-red-lentil-bride-soup",
  "name": "Turkish Red Lentil \u2018Bride\u2019 Soup",
  "recipe_type": "soup",
  "brief_description": "This traditional Turkish soup with red lentils, bulgur wheat, and dried mint tastes wonderful and is easy to make. Garnish with lemon slices and mint leaves.",
  "cuisine": "Turkish",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over low heat. Cook onions in hot butter until golden brown, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir paprika, lentils, and bulgur into onions to coat with butter."
    },
    {
      "position": 3,
      "text": "Add tomato paste, vegetable stock, and cayenne pepper; bring to a boil and cook until soft and creamy, about 1 hour."
    },
    {
      "position": 4,
      "text": "Crumble dried mint leaves into soup; stir and remove from heat."
    },
    {
      "position": 5,
      "text": "Ladle into bowls and garnish with lemon slices and fresh mint to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

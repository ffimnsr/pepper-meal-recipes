  "id": "3949bf83-431a-52cb-a637-7998fb86bf57",
  "slug": "strawberry-waffles",
  "name": "Strawberry Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Quick and easy waffles flecked with strawberries are a colorful and tasty way to start weekdays or weekend mornings. Serve warm with maple syrup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat and grease a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt together in a bowl. Whisk buttermilk, yogurt, butter, eggs, and sugar together in a separate bowl; stir into flour mixture until batter is smooth. Fold strawberries into batter."
    },
    {
      "position": 3,
      "text": "Pour about 1/3 cup batter into preheated waffle iron; cook until lightly browned, 5 to 7 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

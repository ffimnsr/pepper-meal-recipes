{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b17d5a36-03c8-5f5e-8278-62330d15d5d6",
  "slug": "swedish-tea-ring",
  "name": "Swedish Tea Ring",
  "recipe_type": "breakfast",
  "brief_description": "This is a hand-shaped, filled yeast bread. Sprinkle toasted sliced almonds over the icing if you wish.",
  "cuisine": "Swedish Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Made dough: Place milk, beaten egg, butter, sugar, salt, bread flour, and yeast in the order suggested by the manufacturer. Select the Dough cycle and press Start. When dough is mixed, transfer to a greased bowl; cover with plastic wrap and let rise until doubled, about 60 to 90 minutes."
    },
    {
      "position": 2,
      "text": "Grease 2 baking sheets or line them with parchment paper; set aside."
    },
    {
      "position": 3,
      "text": "Divide dough in half. Roll each piece out into rectangles about 12x16 inches. Spread each dough rectangle with 1 tablespoon softened butter. Mix light brown sugar, raisins, and cinnamon in a small bowl until well combined."
    },
    {
      "position": 4,
      "text": "Sprinkle cinnamon mixture onto buttered dough. Roll them up jelly-roll fashion, along the long side. Pinch the edges to seal. Stretch and twist into rings, pinching the ends together to seal. Place them seam-side down onto the prepared baking sheets. Using clean scissors, cut 2/3 of the way through the loaf at about 1-inch intervals. Spread each cut slightly."
    },
    {
      "position": 5,
      "text": "[At this point, dough can be refrigerated: cover with greased plastic wrap and refrigerate 8 hours to overnight. The next morning, let dough come to room temperature for about 30 minutes before baking as directed in step 7.]"
    },
    {
      "position": 6,
      "text": "Alternatively, cover each ring with a clean towel or greased plastic wrap and let loaves rise until doubled in size, about 40 minutes."
    },
    {
      "position": 7,
      "text": "Arrange the oven racks so that both baking sheets will fit. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven for 10 minutes. Rotate the baking sheets. Continue baking until pastries are light brown and filling is oozing and bubbling, about 10 minutes more."
    },
    {
      "position": 9,
      "text": "Make icing: Combine confectioners\u2019 sugar, milk, and almond extract in a small bowl until desired consistency is reached. Drizzle over warm pastries."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 45,

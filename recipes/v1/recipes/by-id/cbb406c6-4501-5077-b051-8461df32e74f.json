  "id": "cbb406c6-4501-5077-b051-8461df32e74f",
  "slug": "spanakorizo",
  "name": "Spanakorizo",
  "recipe_type": "side",
  "brief_description": "Spanakorizo is a Greek rice pilaf with bright flavors of dill, spinach, lemon, and feta cheese; enjoy it with lamb for a Mediterranean meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over medium-high heat. Saute onion until tender, about 5 minutes. Add the cooked rice and spinach; cook and stir until spinach wilts, 3 to 5 minutes. Add lemon juice, zest, feta cheese, and dill. Remove from heat. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 33,

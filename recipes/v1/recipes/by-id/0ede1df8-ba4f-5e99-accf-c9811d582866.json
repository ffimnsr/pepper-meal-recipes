  "id": "0ede1df8-ba4f-5e99-accf-c9811d582866",
  "slug": "stick-of-butter-breakfast-potatoes-recipe-11810273",
  "name": "Stick of Butter Breakfast Potatoes",
  "recipe_type": "breakfast",
  "brief_description": "These stick of butter breakfast potatoes are great for using up leftover bacon or sausage in the fridge, and so easy to put together. If you love butter and you love potatoes, then you will adore this dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 365 degrees F (185 degrees C)."
    },
    {
      "position": 2,
      "text": "Cover the bottom of a casserole dish with a small, even layer of butter. Layer half the potatoes on the butter, overlapping slices if necessary to cover butter completely."
    },
    {
      "position": 3,
      "text": "Sprinkle half the cheese over potatoes. Cover cheese with half the chopped bacon. Cover bacon layer with remaining potato slices. Sprinkle remaining bacon over potato slices, then sprinkle evenly with remaining cheese."
    },
    {
      "position": 4,
      "text": "Pour remaining butter in an even layer over casserole; cover tightly with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 45 minutes covered, then remove foil and bake for 20 minutes more."
    },
    {
      "position": 6,
      "text": "Remove potatoes from the oven and pierce 1 slice with a fork to ensure it is tender. Use a slotted spatula to serve. Garnish with green onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,

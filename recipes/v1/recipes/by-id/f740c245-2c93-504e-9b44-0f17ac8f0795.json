  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f740c245-2c93-504e-9b44-0f17ac8f0795",
  "slug": "chef-johns-pineapple-upside-down-cake",
  "name": "Chef John's Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This pineapple cake is turned over to reveal its gloriously caramelized surface; serve warm with vanilla ice cream for a truly impressive dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in a 12-inch cast iron skillet over medium-low heat. Stir in brown sugar, pineapple juice, and dark rum. Cook over medium-low heat until sugar is dissolved and mixture is bubbling, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and spread pineapple slices in a layer over the brown sugar mixture, completely covering the mixture. Set skillet aside."
    },
    {
      "position": 4,
      "text": "Melt 1/2 cup butter in small skillet over low heat until the butter begins to brown and release a nutty fragrance, about 5 minutes. Watch carefully, butter burns easily. Remove from heat and let cool for 10 minutes."
    },
    {
      "position": 5,
      "text": "Whisk together flour, cardamom, salt, baking powder, and white sugar in a large bowl. Whisk in egg and cold milk until just combined. Pour in melted butter and stir to mix thoroughly."
    },
    {
      "position": 6,
      "text": "Pour batter over the pineapple slices in the skillet; spread evenly to cover."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until the cake begins to bubble around the edges, the top is browned, and a toothpick inserted into the center comes out clean, about 30 to 35 minutes. Let cool in the skillet for 10 minutes."
    },
    {
      "position": 8,
      "text": "Loosen the cake from the skillet by running a knife around the inside edge of the cake. Invert a large plate over the top of the skillet and flip over, releasing the cake to show the pineapple slices on top."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

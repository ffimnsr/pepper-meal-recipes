  "id": "3910a95b-1546-5252-bd09-e4df6a067b6c",
  "slug": "quick-pickled-jalapeno-rings",
  "name": "Quick Pickled Jalape\u00f1o Rings",
  "recipe_type": "side",
  "brief_description": "These pickled jalape\u00f1os are quick to make using a pickling mixture of vinegar, sugar, garlic, and oregano for a delicious kick on nachos or sandwiches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water, vinegar, sugar, kosher salt, garlic, and oregano in a saucepan over high heat. Bring mixture to a boil, stir in jalape\u00f1o peppers, and remove from heat."
    },
    {
      "position": 3,
      "text": "Let mixture cool for 10 minutes."
    },
    {
      "position": 4,
      "text": "Pack peppers into two 8-ounce jars using tongs and cover with vinegar brine mixture. Let pickles cool completely at room temperature."
    },
    {
      "position": 5,
      "text": "Cover jars with tight-fitting lids and refrigerate until needed."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

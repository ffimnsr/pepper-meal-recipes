  "id": "269ad037-4a6d-5f50-8a29-08e72bda8c7d",
  "slug": "poke-scrambled-eggs-recipe-11945628",
  "name": "Poke Scrambled Eggs",
  "recipe_type": "breakfast",
  "brief_description": "Spring has sprung and poke (or pokeweed) is popping up in abundance in the South. If you know, you know. There aren\u2019t many recipes out there online so I thought I'd share a basic one with you. One where the add-ons are endless. Rule #1 is very important: do not skip the double boil. Poke is only safe to eat when properly cooked.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a saucepan with water and bring to a boil. Boil poke 5 minutes."
    },
    {
      "position": 2,
      "text": "Drain poke in a colander. Discard water from the pot and fill with fresh water."
    },
    {
      "position": 3,
      "text": "Bring water to a boil, add poke and boil 5 minutes again. Drain and transfer poke to a cutting board. Chop when cool enough to handle."
    },
    {
      "position": 4,
      "text": "Combine eggs, cheese, salt, pepper, and chopped poke in a mixing bowl. Whisk until evenly combined."
    },
    {
      "position": 5,
      "text": "Heat a large skillet over medium-high heat. Add egg/poke mixture and cook 3 minutes. Stir once and turn heat off. Transfer to plate and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,

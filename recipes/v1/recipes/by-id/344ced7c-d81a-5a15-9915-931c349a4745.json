  "id": "344ced7c-d81a-5a15-9915-931c349a4745",
  "slug": "hot-honey-white-pizza-recipe-11771906",
  "name": "Hot Honey White Pizza",
  "recipe_type": "appetizer",
  "brief_description": "Serve this hot honey white pizza, with dill pickles and salami, when you want to impress your friends, or for Friday family pizza night. The hot honey and pickle flavors are startlingly tasty together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 2,
      "text": "On a lightly floured surface, roll out or stretch pizza dough to about 12 inches wide and lightly coat with olive oil spray. Place on a baking sheet or pizza stone if you have one."
    },
    {
      "position": 3,
      "text": "Stir ricotta and garlic paste together in a small bowl, and spread a thin layer over dough, leaving a small border around the edges. Evenly distribute mozzarella slices on top, followed by salami and pickle slices."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 8 to 14 minutes. Begin checking for doneness at about 8 minutes. Remove from the oven and immediately drizzle with hot honey."
    },
    {
      "position": 5,
      "text": "Let pizza rest for a couple minutes, and garnish with basil and/or oregano. Cut into 6 wedges for a main dish or into squares for 8 to 10 appetizer servings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

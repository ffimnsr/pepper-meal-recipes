  "id": "27a1327b-0982-51fe-a4a7-1505661d722e",
  "slug": "4-cheese-spinach-artichoke-dip",
  "name": "4-Cheese Spinach-Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "A tasty blend of 4 cheeses replaces Alfredo sauce in this simple stovetop recipe for spinach-artichoke dip that can be served either hot or cold.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add spinach, artichoke hearts, and any marinade oil that remains after chopping them. Add onion, garlic, pepper, salt, and red pepper flakes; cook, stirring regularly so it doesn't burn on the bottom, until spinach has wilted and mixture is wet, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to low and add cream cheese, Parmesan cheese, processed cheese, and Cheddar cheese. Stir occasionally and allow to simmer, uncovered, until cheeses have melted and some of the water from the spinach has cooked off, about 3 more minutes. This allows the herbs and spices to infuse their flavor into the dip. Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

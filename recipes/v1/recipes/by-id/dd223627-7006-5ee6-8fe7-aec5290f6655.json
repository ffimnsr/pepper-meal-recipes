  "id": "dd223627-7006-5ee6-8fe7-aec5290f6655",
  "slug": "cream-cheese-pound-cake-iii",
  "name": "Easy Cream Cheese Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This cream cheese pound cake is rich and deliciously dense in the best way. This recipe uses cream cheese and butter for moist and flavorful results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch tube pan."
    },
    {
      "position": 3,
      "text": "Cream butter and cream cheese together in a mixing bowl until smooth. Gradually add sugar and beat until fluffy."
    },
    {
      "position": 4,
      "text": "Add eggs, two at a time, beating well with each addition. Add flour all at once and mix in. Mix in vanilla. Pour batter into the prepared cake pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour and 20 minutes, checking for doneness at 1 hour. A toothpick inserted into the center of the cake should come out clean. Remove and cool before serving."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 80,

  "id": "1de0c47b-716d-52aa-86ee-a192d277f6a1",
  "slug": "doggie-biscuits-i",
  "name": "Doggie Biscuits",
  "recipe_type": "snack",
  "brief_description": "This dog biscuit recipe makes a pup\u2019s favorite treat, with flour, oats, cornmeal, eggs, and peanut butter \u2014 they are easy to make. Bone app\u00e9tit!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Mix together whole wheat flour, all-purpose flour, cornmeal, and oats. Make a well in the center of the dry ingredients and gradually pour in water, oil, eggs, peanut butter, and vanilla. Mix well."
    },
    {
      "position": 3,
      "text": "On a flat surface, use a rolling pin to roll out the dough. Cut the dough into dog biscuit shapes using a cookie cutter. Place the biscuits onto the prepared cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake the biscuits in the preheated oven for 20 minutes. After 20 minutes, turn off the oven but let the biscuits remain inside the oven for another 20 minutes to harden."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a0e9828e-040e-5381-a0bf-7e9be292d0b6",
  "slug": "microwave-chocolate-mug-cake",
  "name": "Easy Microwave Chocolate Mug Cake",
  "recipe_type": "dessert",
  "brief_description": "This chocolate mug cake recipe is easy to make in the microwave for a deliciously decadent and fudgy chocolate dessert in less than 10 minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, cocoa powder, baking soda, and salt together in a large microwave-safe mug; stir in milk, canola oil, water, and vanilla extract."
    },
    {
      "position": 3,
      "text": "Cook in the microwave until cake is done in the middle, about 1 minute 45 seconds."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

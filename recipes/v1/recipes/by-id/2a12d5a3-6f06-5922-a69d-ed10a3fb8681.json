  "id": "2a12d5a3-6f06-5922-a69d-ed10a3fb8681",
  "slug": "frozen-blueberry-crisp",
  "name": "Frozen Blueberry Crisp",
  "recipe_type": "dessert",
  "brief_description": "Use up frozen blueberries and make this quick and easy baked crisp to serve over vanilla ice cream, or enjoy it by itself.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease the bottom and halfway up the sides of an 8x8-inch glass baking dish."
    },
    {
      "position": 2,
      "text": "Drain thawed blueberries; transfer to a medium mixing bowl. Sprinkle with white sugar and lemon juice; gently combine using your hands. Layer berries evenly in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Mix oats, flour, brown sugar, cinnamon, and nutmeg together in a separate bowl. Cut in butter with 2 knives or pastry blender until mixture is crumbly; sprinkle over berries."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, 40 to 45 minutes. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "4fe89124-5131-5131-8ec8-1a02c12bc9e5",
  "slug": "simply-the-best-deviled-eggs",
  "name": "Simply the Best Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "All recipes for deviled eggs are not the same, but this one is sure to impress with a heavenly combo of flavors including bacon, onion, and paprika.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs into a saucepan, cover with water, and bring to a boil. Remove from the heat and let stand for 15 minutes."
    },
    {
      "position": 2,
      "text": "Remove eggs from hot water and place under cold running water to cool. Peel eggs. Slice each egg in half lengthwise. Place yolks into a small bowl."
    },
    {
      "position": 3,
      "text": "Add 1/2 cup bacon, onion, dill pickle relish, mayonnaise, mustard, and bacon drippings to egg yolks. Mix with a fork until combined but yolks are still chunky. Stir in salt and pepper."
    },
    {
      "position": 4,
      "text": "Scoop yolk mixture into each egg white. Sprinkle paprika over eggs, then garnish with remaining 1/4 cup bacon."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "1cd51b33-a3ca-5fa0-8f5e-2ddb12f04a7a",
  "slug": "tuscan-chicken-soup-recipe-11680831",
  "name": "Tuscan Chicken Soup",
  "recipe_type": "soup",
  "brief_description": "This Tuscan chicken soup features a boneless chicken breast in creamy broth with sun-dried tomatoes and spinach. It\u2019s especially comforting on blustery winter days.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Add oil to a saucepan over medium heat. Once oil is hot, add onion, and saut\u00e9 until translucent, about 5 minutes. Add garlic; saute until fragrant; about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in tomato paste until well combined. Add chicken bone broth, Tuscan seasoning, chicken pieces, sun-dried tomatoes, and torn spinach; stir to combine. Add pasta; simmer until pasta is tender with a bite, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle in Parmesan; stir to combine. Stir in heavy cream. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

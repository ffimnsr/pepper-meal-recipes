  "id": "279f7782-bf47-5ed2-8666-ebc883d9d348",
  "slug": "hot-muffuletta-dip",
  "name": "Hot Muffuletta Dip",
  "recipe_type": "appetizer",
  "brief_description": "Hot muffuletta dip made with cream cheese, olives, giardiniera, and roasted red peppers is a festive appetizer for Mardi gras parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, salami, olives, roasted red peppers, giardiniera, provolone cheese, and garlic together in a bowl; transfer to a 9-inch pie plate."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbling and hot, about 30 minutes. Sprinkle parsley over dip."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "01e6958c-6777-525c-a29e-1794cac271dd",
  "slug": "fried-mini-pickles-with-spicy-ranch-dip-recipe-11971733",
  "name": "Fried Mini Pickles with Spicy Ranch Dip",
  "recipe_type": "appetizer",
  "brief_description": "These fried mini pickles are dill cornichons breaded and cooked in the air fryer until crispy and golden. They make a quick, punchy appetizer that\u2019s festive for any occasion, complete with a creamy dipping sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an airfryer to 400 degrees F (200 degrees C). Drain cornichons and pat dry with paper towels."
    },
    {
      "position": 2,
      "text": "Add flour to a shallow bowl. Whisk egg whites with water in another shallow bowl. In a third bowl whisk together breadcrumbs, cornmeal, and seasoning salt."
    },
    {
      "position": 3,
      "text": "Toss 3 to 4 pickles at a time into flour. Shake off any excess. Dip into egg wash; shake off any excess, then roll in breadcrumb mixture. Carefully press breadcrumbs onto each pickle. Place onto a baking sheet or plate. Spray with an even coat of cooking spray. Repeat with remaining pickles."
    },
    {
      "position": 4,
      "text": "Transfer half the pickles into the airfryer and spray them again with cooking spray if necessary. Cook the pickles for 6 to 8 minutes. Repeat with remaining pickles. Place them onto a paper towel lined plate."
    },
    {
      "position": 5,
      "text": "Whisk ranch dressing mix and milk together; stir in cayenne. Serve alongside pickles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

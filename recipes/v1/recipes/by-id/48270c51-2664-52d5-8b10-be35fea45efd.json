  "id": "48270c51-2664-52d5-8b10-be35fea45efd",
  "slug": "juicy-two-stage-thanksgiving-turkey-marinade",
  "name": "Juicy Two-Stage Thanksgiving Turkey Marinade",
  "recipe_type": "main",
  "brief_description": "Two brines over two days give your holiday bird complex layers of flavor as well as added juiciness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "On the Tuesday morning before Thanksgiving, whisk together salt, orange juice, brown sugar, a cinnamon stick and water in a large nonreactive container with a cover, such as a large stainless steel stockpot. Stir until salt and sugar dissolve, about 5 minutes. Place the turkey into the brine, cover, and refrigerate overnight."
    },
    {
      "position": 2,
      "text": "The next day, remove turkey from the first marinade, shake off excess, and pat the bird dry. Discard the brine. Clean the stockpot or brining container."
    },
    {
      "position": 3,
      "text": "In the clean stockpot, make the marinade by stirring together together sliced oranges, sliced lemons, onion, green bell pepper, parsley, cloves, garlic powder, cinnamon sticks, paprika, olive oil, and pepper. Place the turkey into the stockpot and rub the marinade into the turkey. Cover and refrigerate overnight."
    },
    {
      "position": 4,
      "text": "On Thanksgiving Day, remove turkey from the marinade and shake off the excess. Discard the remaining marinade. Roast the turkey using your favorite method."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "be029be8-2725-5e5e-a2b6-ffa68fb36ed4",
  "slug": "mild-cheesy-chicken-enchiladas",
  "name": "Mild Cheesy Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "Sour cream and Cheddar set a smooth tone for these basic enchiladas baked with tomatoes.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine 3 cups Cheddar cheese and 1/4 cup sour cream in a saucepan over low heat. Cook, stirring occasionally, until melted."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix chicken, remaining 1 cup Cheddar cheese, remaining 3/4 cup sour cream, and onion in a medium bowl until well combined."
    },
    {
      "position": 4,
      "text": "Arrange tortillas on a large, flat work surface. Divide chicken mixture evenly among tortillas, then roll tortillas up over the filling. Arrange in a single layer in the prepared baking dish. Pour cheese sauce over enchiladas, then top with tomatoes and olives."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until hot and bubbly, 20 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

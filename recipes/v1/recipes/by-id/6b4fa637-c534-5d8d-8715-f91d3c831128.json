  "id": "6b4fa637-c534-5d8d-8715-f91d3c831128",
  "slug": "creamy-pumpkin-pie-with-ricotta-cheese",
  "name": "Creamy Pumpkin Pie with Ricotta Cheese",
  "recipe_type": "dessert",
  "brief_description": "Try this delightfully different and delicious recipe for a light and creamy pumpkin pie with ricotta cheese this Thanksgiving.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Press pie crust into a pie plate."
    },
    {
      "position": 2,
      "text": "Beat ricotta cheese into lightly beaten eggs in a large bowl until smooth. Stir pumpkin, brown sugar, evaporated milk, pumpkin pie spice, vanilla extract, and salt into the cheese mixture until smooth; pour into the pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

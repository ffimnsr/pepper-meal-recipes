  "id": "32bdd6a7-9139-5a04-85f1-12cdec9c8aed",
  "slug": "gochujang-fried-rice",
  "name": "Gochujang Fried Rice",
  "recipe_type": "side",
  "brief_description": "This fried rice recipe is flavored with gochujang, a spicy Korean chili paste. Use any vegetable combination you enjoy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a wok or large skillet over medium-high heat, and add vegetable oil. Add garlic and ginger, and cook until fragrant, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Add bell peppers, carrots, and onion, and cook until tender, 4 to 5 minutes. Add a splash of water if the pan gets too dry."
    },
    {
      "position": 3,
      "text": "Add rice, gochujang, soy sauce, and sesame oil, mixing everything well, and stir fry until the rice is hot."
    },
    {
      "position": 4,
      "text": "Garnish with green onions and sesame seeds, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

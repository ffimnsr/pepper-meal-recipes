  "slug": "pickled-onions",
  "name": "Pickled Onions",
  "recipe_type": "salad",
  "brief_description": "Pickled red onions in red wine vinegar are so easy to make at home. This tangy condiment is delicious on sandwiches, burgers, salads, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine onion, both vinegars, salt, and sugar in a saucepan over medium-high heat; bring to a boil. Remove from the heat and allow mixture to steep until onion is tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Cool for at least 30 minutes, then strain and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,

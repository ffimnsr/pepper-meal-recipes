  "slug": "wassail-punch",
  "name": "Wassail Punch",
  "recipe_type": "drink",
  "brief_description": "A spicy apple cider served hot in the winter months.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a slow-cooker or a large pot over low heat, combine apple cider, orange juice and lemon juice. Season with cloves, ginger and nutmeg. Bring to a simmer. If using a slow cooker, allow to simmer all day. Serve hot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 480,

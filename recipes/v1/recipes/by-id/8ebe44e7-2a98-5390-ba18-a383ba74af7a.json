  "id": "8ebe44e7-2a98-5390-ba18-a383ba74af7a",
  "slug": "soft-christmas-cookies",
  "name": "Best Soft Christmas Cookies",
  "recipe_type": "dessert",
  "brief_description": "This Christmas cookie recipe makes soft, tender cut-out sugar cookies that hold their shape and are fun to decorate with colored sugar or icing for gifting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt together in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter in a large bowl with an electric mixer until smooth."
    },
    {
      "position": 4,
      "text": "Beat first egg into butter mixture. Beat second egg into mixture along with vanilla extract; add flour mixture and stir until dough is just combined."
    },
    {
      "position": 5,
      "text": "Wrap dough and chill in the refrigerator for 2 hours."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease two cookie sheets."
    },
    {
      "position": 7,
      "text": "Roll out dough on a clean floured surface to 1/4-inch thickness. Cut out shapes using Christmas cookie cutters; arrange them on the prepared cookie sheets. Gather scraps and repeat this step."
    },
    {
      "position": 8,
      "text": "Bake in batches in the preheated oven until edges are golden, about 6 to 8 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely before frosting or decorating."
    },
    {
      "position": 9,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cc27a66d-51d5-5bae-af32-83c9c34172cb",
  "slug": "microwave-peanut-butter-chocolate-swirl-fudge",
  "name": "Microwave Peanut Butter Chocolate Swirl Fudge",
  "recipe_type": "dessert",
  "brief_description": "This microwave peanut butter and chocolate swirl fudge is easy to prepare and will become a favorite at Christmas parties or holiday get-togethers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8-inch square pan with waxed paper or spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Place 1 almond bark half in a microwave-safe bowl; heat in the microwave, in 30-second intervals, stirring after each melting until smooth, 1 to 3 minutes. Add peanut butter to melted almond bark and mix well. Add the remaining almond bark to the bowl and push to the bottom of the bowl."
    },
    {
      "position": 3,
      "text": "Heat mixture in the microwave for 1 minute; stir to break up any large pieces. Continue heating in microwave, in 30 second intervals, until completely melted. Pour fudge mixture into the prepared square pan."
    },
    {
      "position": 4,
      "text": "Melt chocolate bars in a microwave-safe bowl in 30-second intervals, stirring after each melting, for 1 to 3 minutes. Drizzle melted chocolate over fudge. Swirl the chocolate into the fudge using a knife."
    },
    {
      "position": 5,
      "text": "Refrigerate fudge until solid, about 1 hour."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "589bed47-753e-5d13-b03c-f9055cf17a1f",
  "slug": "easy-cinnamon-roll-casserole",
  "name": "Easy Cinnamon Roll Casserole",
  "recipe_type": "dessert",
  "brief_description": "This cinnamon roll casserole is made with store-bought cinnamon rolls, pecans, and maple syrup; the packaged frosting is a decadent dessert or brunch item.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Pour melted butter into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cut each cinnamon roll into 8 pieces; spread evenly in prepared dish. Set icing aside."
    },
    {
      "position": 3,
      "text": "Whisk eggs, cream, cinnamon, and vanilla extract together in a large bowl until well combined; pour evenly over rolls. Sprinkle with pecans; drizzle with syrup."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 25 minutes. Let cool for 15 minutes."
    },
    {
      "position": 5,
      "text": "Microwave icing for 10 to 15 seconds; drizzle over casserole."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7c8b8923-4548-5cd4-aadd-eee6cc7fcaa3",
  "slug": "chocolate-chocolate-chip-cookies-i",
  "name": "Chocolate Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These chocolate chocolate chip cookies are impossible to resist thanks to a double helping of chocolate in the form of cocoa and chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat sugar, butter, eggs, and vanilla in a large bowl until light and fluffy."
    },
    {
      "position": 3,
      "text": "Combine flour, cocoa powder, baking soda, and salt in another bowl; stir into butter mixture until well blended."
    },
    {
      "position": 4,
      "text": "Stir chocolate chips and walnuts into dough until evenly distributed. Drop rounded tablespoonfuls of dough 2 inches apart onto ungreased baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven just until set, 8 to 10 minutes. Cool slightly on the cookie sheets before transferring to wire racks to cool completely."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

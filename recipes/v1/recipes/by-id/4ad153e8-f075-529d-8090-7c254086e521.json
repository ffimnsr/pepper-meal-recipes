  "id": "4ad153e8-f075-529d-8090-7c254086e521",
  "slug": "ube-panna-cotta",
  "name": "Ube Panna Cotta",
  "recipe_type": "dessert",
  "brief_description": "The main ingredients in this gorgeous panna cotta is ube, a purple yam that's a popular ingredients in jam, cookies, and other desserts in the Philippines.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add ube, cover, and steam until tender, about 20 minutes. Cool until easily handled, about 10 minutes. Pur\u00e9e ube in a blender or food processor, or thoroughly mash it by hand."
    },
    {
      "position": 2,
      "text": "Combine 1 cup pur\u00e9ed ube, 3/4 cup whole milk, coconut milk, and sugar in a blender or food processor; blend until completely smooth."
    },
    {
      "position": 3,
      "text": "Pour remaining 3/4 cup whole milk into a saucepan. Sprinkle gelatin on top and let stand for 5 minutes."
    },
    {
      "position": 4,
      "text": "Heat milk-gelatin mixture over medium-low heat, stirring until gelatin is dissolved, 3 to 5 minutes. Pour in ube mixture and increase the heat to medium. Heat until steam starts to rise from the mixture, stirring occasionally, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Pour mixture into individual serving glasses or molds. Transfer to the refrigerator and chill until set, about 3 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

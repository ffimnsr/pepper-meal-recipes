  "id": "b27585d9-5320-5962-9ab3-7c48a6d12f8b",
  "slug": "easy-baked-banana-french-toast",
  "name": "Easy Baked Banana French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Easy baked banana French toast, made with bananas, eggs, and milk and lightly seasoned with cinnamon and nutmeg is a healthy start to your day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk eggs, milk, brown sugar, butter, vanilla extract, ground cinnamon, and ground nutmeg together in a bowl. Stir bread cubes and bananas into egg mixture until coated; pour into prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until a knife inserted in center comes out clean, 35 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

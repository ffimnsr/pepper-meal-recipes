  "name": "Pumpkin Fluff Dip",
  "recipe_type": "appetizer",
  "brief_description": "This pumpkin fluff dip recipe makes a creamy, dreamy treat that tastes like pumpkin pie and pairs beautifully with everything from fruit to crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix pumpkin, pudding mix, and pumpkin pie spice together in a large bowl."
    },
    {
      "position": 2,
      "text": "Fold in whipped topping."
    },
    {
      "position": 3,
      "text": "Cover chill until ready to serve."
    }
  ],

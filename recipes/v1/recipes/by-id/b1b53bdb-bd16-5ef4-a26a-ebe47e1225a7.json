  "id": "b1b53bdb-bd16-5ef4-a26a-ebe47e1225a7",
  "slug": "bacon-alfredo-tortellini-recipe-11861245",
  "name": "Bacon Alfredo Tortellini",
  "recipe_type": "side",
  "brief_description": "This bacon Alfredo tortellini checks all the boxes. It's rich, creamy, comforting, easy to make, incredibly good, and a bit on the decadent side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 365 degrees F (185 degrees C). Line a sheet pan with a silicon mat. Lay the bacon the sheet pan."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until crisp, turning once, about 30 minutes. Set aside on paper towels to drain. Reserve about 1 tablespoon bacon grease."
    },
    {
      "position": 3,
      "text": "Bring a large pot of salted water to a boil and cook tortellini according to package directions. Drain and set aside."
    },
    {
      "position": 4,
      "text": "Bring the pot back to the stove. Over medium heat, combine garlic, bouillon, cream, and cream cheese. Stir and cook until all melted and thickened, about 5 minutes. Add about half the cheese, and season to taste with salt and pepper."
    },
    {
      "position": 5,
      "text": "Stir in tortellini. Crumble bacon and add to the pot. Stir to combine."
    },
    {
      "position": 6,
      "text": "Serve in wide bowls with remaining Parmesan; garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

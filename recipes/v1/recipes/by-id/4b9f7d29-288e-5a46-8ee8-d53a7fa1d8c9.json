  "id": "4b9f7d29-288e-5a46-8ee8-d53a7fa1d8c9",
  "slug": "lemon-poppy-seed-loaf",
  "name": "Lemon Poppy Seed Loaf",
  "recipe_type": "dessert",
  "brief_description": "This has a nice fresh lemon flavor. Makes nice muffins, also.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Heavily grease and flour two 9x5 inch loaf pans."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking soda, and salt. Set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, cream butter or margarine, and sugar until light and fluffy. Beat in eggs, one at a time."
    },
    {
      "position": 4,
      "text": "Mix lemon juice and yogurt together and add alternately with the sifted flour mixture to the butter mixture. Mix until just blended. Stir in lemon rind and poppy seeds. Pour mixture into prepared pans and smooth tops."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 50 minutes or until browned and a knife inserted in the center comes out clean. Cool on rack for 15 minutes before turning out of pans."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 50,

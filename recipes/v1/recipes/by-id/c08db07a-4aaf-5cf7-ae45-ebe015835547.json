  "slug": "hash-brown-casserole-for-the-slow-cooker",
  "name": "Hash Brown Casserole for the Slow Cooker",
  "recipe_type": "side",
  "brief_description": "The traditional hash brown casserole side dish is made even easier. Prepare ahead of time and start cooking when you need to. This dish is also great to take to parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sour cream, processed cheese, cream of mushroom soup, onion, salt, and black pepper. Gradually stir in hash browns until evenly coated."
    },
    {
      "position": 2,
      "text": "Coat inside of a slow cooker with cooking spray or butter. Add hash brown mixture to slow cooker. Cover, and cook on High for 1 1/2 hours, then reduce heat to Low, and cook for 2 1/2 hours more."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 240,

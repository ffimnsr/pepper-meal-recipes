  "id": "6a41bc2e-cb37-5b55-95fc-b8086d3c51fc",
  "slug": "loaded-tater-tots",
  "name": "Loaded Tater Tots",
  "recipe_type": "appetizer",
  "brief_description": "These loaded tater tots are baked with crisp bacon, sour cream, and shallots for a rich, cheesy, crowd-pleasing casserole great for tailgate snacking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread potato nuggets in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly golden, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a large skillet over medium-high heat. Cook bacon in the hot skillet, turning occasionally, until evenly browned, about 10 minutes. Drain bacon on a paper towel-lined plate, then chop coarsely and set aside."
    },
    {
      "position": 5,
      "text": "Make sauce: Melt butter in a saucepan over medium heat. Cook and stir shallot in hot butter until fragrant. Stir in flour and cook until light golden, about 2 minutes. Whisk in milk and sour cream; stir until smooth and thick, about 5 minutes. Season with black pepper and nutmeg. Stir in 1 cup Cheddar cheese until fully melted."
    },
    {
      "position": 6,
      "text": "Transfer potato nuggets to a 9x13-inch baking dish. Sprinkle bacon on top. Pour cheese sauce over nuggets. Cover with remaining 1/2 cup Cheddar cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven just until cheese melts, about 7 minutes. Garnish with green onions and sour cream to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "17e41f15-6fa0-5256-97d5-55992894f4f0",
  "slug": "chef-johns-whole-wheat-ciabatta",
  "name": "Chef John\u2019s Whole Wheat Ciabatta",
  "recipe_type": "snack",
  "brief_description": "Chef John\u2019s whole wheat ciabatta recipe uses a blend of flours to create the perfect, crusty-yet-chewy bread experience.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Make the sponge: Stir warm water, flours (all-purpose flour, whole wheat, and rye), and yeast together in a large bowl until well combined. Cover the bowl with plastic wrap and let sit until bubbly and doubled in volume, 5 to 6 hours."
    },
    {
      "position": 2,
      "text": "Start the ciabatta: Stir all-purpose flour, whole wheat flour, water, sunflower seeds, polenta, flax seeds, salt, and honey into sponge with a wooden spoon until a very sticky dough ball forms, about 3 minutes. Scrape down the sides of the bowl, cover the bowl with plastic wrap, and let rise until doubled in volume, 10 hours to overnight."
    },
    {
      "position": 3,
      "text": "Line a baking sheet with parchment paper. Dust parchment paper with 1/2 teaspoon all-purpose flour and cornmeal."
    },
    {
      "position": 4,
      "text": "Scrape dough out of the bowl onto a lightly floured work surface; press down to remove air, then form into a smooth oval loaf. Place dough onto the prepared baking sheet. Dust top of loaf lightly with remaining 1/2 teaspoon all-purpose flour, cover with plastic wrap, and let rise until doubled in volume, about 1 1/2 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place a baking dish filled with water on the bottom rack of the oven."
    },
    {
      "position": 6,
      "text": "Remove plastic wrap from risen dough and mist the top of the dough with water."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven, misting the top of the loaf with water every 8 to 10 minutes, until loaf is golden and sounds hollow when tapped, 30 to 35 minutes total. Transfer bread to a cooling rack and let cool completely before slicing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,

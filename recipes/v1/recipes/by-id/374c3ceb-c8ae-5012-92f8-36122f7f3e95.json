  "id": "374c3ceb-c8ae-5012-92f8-36122f7f3e95",
  "slug": "chicken-carbonara",
  "name": "Chicken Carbonara",
  "recipe_type": "main",
  "brief_description": "This chicken carbonara recipe with crispy pancetta, fresh basil and parsley, and Parmesan includes a super creamy sauce, making it a satisfying meal.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large, heavy skillet over medium heat. Add pancetta and garlic; cook until browned and crisp, about 8 minutes. Remove from heat; cool slightly."
    },
    {
      "position": 3,
      "text": "Whisk heavy cream, Parmesan cheese, egg yolks, basil, and parsley together in a large bowl until well blended."
    },
    {
      "position": 4,
      "text": "Stir chicken into pancetta mixture until well combined. Toss in spaghetti and cream mixture over medium-low heat until chicken is heated through and sauce thickly coats spaghetti, about 4 minutes. Do not boil, or eggs will scramble. Season with salt and black pepper. Transfer to a serving bowl."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

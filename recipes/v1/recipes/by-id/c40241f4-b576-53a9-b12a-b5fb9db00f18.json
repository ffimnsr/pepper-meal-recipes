  "id": "c40241f4-b576-53a9-b12a-b5fb9db00f18",
  "slug": "mississippi-sloppy-joes-recipe-12028051",
  "name": "Mississippi Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "These Mississippi sloppy joes combine the bold, tangy flavors of Mississippi pot roast with the ease of classic sloppy joes. Made with ground beef, ranch seasoning, au jus mix, onion, and pepperoncini peppers, they\u2019re a quick, family-friendly dinner everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add onions and cook, stirring often until softened, about 2 minutes. Add ground beef and cook, crumbling with a spoon until browned and crumbled, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add ranch seasoning, au jus mix, pepperoncini, pepperoncini brine, water, pepper, and ketchup, and stir to combine. Bring mixture to a simmer. Reduce heat and simmer until thickened and saucy, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Divide mixture among buns and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "05b0e20d-a625-561e-b3c7-36e253042272",
  "slug": "thai-pasta-salad-recipe-8646006",
  "name": "Thai Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This Thai pasta salad with crunchy veggies, roasted peanuts, and a spicy chili-lime dressing is packed full of flavor and ready in just 30 minutes!",
  "cuisine": "Asian Inspired Thai",
  "instructions": [
    {
      "position": 1,
      "text": "To make the dressing: Whisk sesame oil, vegetable oil, soy sauce, balsamic vinegar, fish sauce, chili-garlic sauce, lime juice, rice vinegar, and sugar together in a small bowl until well combined. Set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 10 to 12 minutes. Drain pasta, rinse with cold water, and return to the pot."
    },
    {
      "position": 3,
      "text": "Drizzle dressing over pasta and stir gently to combine. Add peas, carrots, bell pepper, green onions, cilantro, peanuts, and red pepper flakes; stir until well combined."
    },
    {
      "position": 4,
      "text": "Serve at room temperature with lime wedges, or chill in the refrigerator and serve cold."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

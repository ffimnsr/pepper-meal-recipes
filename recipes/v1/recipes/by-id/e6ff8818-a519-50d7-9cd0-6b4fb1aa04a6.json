  "id": "e6ff8818-a519-50d7-9cd0-6b4fb1aa04a6",
  "slug": "creamy-apple-blueberry-pie",
  "name": "Creamy Apple Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "For this creamy apple blueberry pie recipe, sweet and tender apples and blueberries fill this luscious blueberry apple pie with a crisp crumb topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss apples and blueberries together in pie crust."
    },
    {
      "position": 3,
      "text": "Combine \u00bc cup flour, white sugar, cinnamon, nutmeg, and salt in a bowl. Stir in yogurt, egg, and vanilla extract; pour over apples and blueberries."
    },
    {
      "position": 4,
      "text": "Combine remaining \u00bd cup flour, pecans, oats, and brown sugar in a bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Set aside."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes; reduce heat to 350 degrees F (175 degrees C) and continue baking until crust is lightly browned, about 30 minutes. Sprinkle crumb mixture over pie; continue baking until golden brown, about 15 minutes more. Cool before serving, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

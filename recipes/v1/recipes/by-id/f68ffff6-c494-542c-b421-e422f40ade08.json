  "id": "f68ffff6-c494-542c-b421-e422f40ade08",
  "slug": "basic-keto-cheese-crisps",
  "name": "Cheese Crisps",
  "recipe_type": "appetizer",
  "brief_description": "These baked cheese crisps are a quick, easy, and delicious 1-ingredient crunchy snack that are naturally low-carb, gluten-free, and keto-friendly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Shred generous amounts cheese."
    },
    {
      "position": 3,
      "text": "Arrange cheese in 24 small heaps on the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 7 minutes. Cool for 5 to 10 minutes before removing from baking sheets."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "afa2669c-16b0-5c00-891b-28fe110670ed",
  "slug": "banana-pumpkin-bread",
  "name": "Banana Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "This pumpkin banana bread is made with raisins and walnuts and bakes up extra moist and flavorful thanks to mashed bananas, cinnamon, and pie spice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Stir together bananas, pumpkin, honey, sugar, vegetable oil, and eggs in a large bowl. Combine flour, pie spice, baking powder, baking soda, cinnamon, and salt in a separate bowl. Stir flour mixture into banana mixture until just combined. Fold in raisins and walnuts. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean and the top springs back lightly when touched, 45 minutes to 1 hour. Cool loaf in the pan for 10 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0f1dc516-9feb-50e6-a06d-669f57e74e3f",
  "slug": "western-omelet",
  "name": "Western Omelet",
  "recipe_type": "breakfast",
  "brief_description": "This Western-style omelet recipe includes ham, scallions, sliced mushrooms, and green bell pepper. It's a quick and easy option for a hot breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 teaspoon butter in a small skillet over medium heat. Add green onions, mushrooms, and bell pepper; cook until tender, about 5 minutes. Stir in ham until heated through, about 1 minute; season with salt and black pepper. Transfer mixture to a small bowl; keep filling warm."
    },
    {
      "position": 2,
      "text": "Beat eggs together in a separate bowl; season with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Heat the same skillet over medium-high heat. Add remaining 1 teaspoon butter; heat until foaming. Pour in beaten eggs; cook for 30 seconds. Lift omelet edges so uncooked egg runs under cooked edges and comes into contact with the hot skillet. Shake and tilt the skillet to move uncooked egg. Repeat until top is set, but still moist and soft, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Arrange filling over one side of omelet; fold other half over filling. Slide omelet onto a plate."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

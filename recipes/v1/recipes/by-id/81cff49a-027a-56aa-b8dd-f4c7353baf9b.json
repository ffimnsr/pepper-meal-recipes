  "id": "81cff49a-027a-56aa-b8dd-f4c7353baf9b",
  "slug": "classic-irish-boiled-dinner",
  "name": "Irish Boiled Ham Dinner",
  "recipe_type": "main",
  "brief_description": "This delicious boiled dinner with ham is an old-time Irish classic, made with smoked boneless ham or smoked pork shoulder, potatoes, and cabbage.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place smoked ham or pork shoulder into a large pot and add enough water to cover. Season with salt and pepper, cover, and bring to a boil. Reduce heat to low and simmer for about 30 minutes."
    },
    {
      "position": 2,
      "text": "Add potatoes, cabbage, onions, and carrots to the pot and continue to simmer. Tie green beans into a bundle with kitchen string. Add to the pot, re-cover, and cook until carrots and potatoes are tender, about 25 minutes."
    },
    {
      "position": 3,
      "text": "Transfer pork to a serving dish and arrange vegetables all around. Let pork rest for 10 minutes before slicing and serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

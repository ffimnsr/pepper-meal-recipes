  "name": "Kiwi Smoothie",
  "recipe_type": "dessert",
  "brief_description": "This 4-ingredient kiwi smoothie is sweetened with a frozen banana to eliminate the use of ice. It\u2019s also packed with protein, and the combination of spinach and soy milk will keep you feeling full through the morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place kiwi, banana, spinach, and soy milk in the jar of a blender; cover and blend until smooth, about 1 minute."
    }
  ],

  "id": "4d25627d-342e-598b-a59b-bfb042be080d",
  "slug": "turkey-brine",
  "name": "Turkey Brine",
  "recipe_type": "soup",
  "brief_description": "This turkey brine recipe is easy to make and will produce a juicy, flavorful bird. All you need is vegetable broth, herbs, and a food-safe bucket.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine broth, salt, rosemary, sage, thyme, and savory in a large stockpot. Bring to a boil, stirring frequently until salt dissolves; let cool to room temperature. Pour into a food-grade 5-gallon bucket. Stir in ice water."
    },
    {
      "position": 2,
      "text": "Pat turkey dry; remove giblets from cavity. Place turkey, breast-side down, into brine, making sure cavity fills. Refrigerate at least 8 hours, or overnight."
    },
    {
      "position": 3,
      "text": "Drain off and discard excess brine; pat turkey dry. Cook turkey as desired, reserving drippings for gravy. Note that brined turkeys often cook 20 to 30 minutes faster; start checking for doneness early."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

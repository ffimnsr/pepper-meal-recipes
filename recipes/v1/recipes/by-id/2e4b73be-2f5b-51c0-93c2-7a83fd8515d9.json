  "slug": "berry-overnight-oats",
  "name": "Berry Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Layer milk-soaked oats with Greek yogurt, chia seeds, and mixed fruit and berries, then refrigerate overnight for this berry overnight oats recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add oats to the container of choice; pour in milk."
    },
    {
      "position": 2,
      "text": "Layer in Greek yogurt, chia seeds, and mixed berries and fruit."
    },
    {
      "position": 3,
      "text": "Refrigerate 8 hours to overnight."
    }
  ],

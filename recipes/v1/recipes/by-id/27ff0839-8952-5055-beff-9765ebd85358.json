  "id": "27ff0839-8952-5055-beff-9765ebd85358",
  "slug": "never-kiss-a-yammy",
  "name": "Never Kiss a Yammy",
  "recipe_type": "dessert",
  "brief_description": "I love this sweet potato recipe! It's so tasty and easy to make. It's great as a side dish for Thanksgiving.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 425 degrees F (220 degrees C). Cover a cookie sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Scrub the sweet potatoes, prick them deeply in several places with a fork, and place them on the lined cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake the potatoes in the preheated oven until tender, about 45 minutes. Allow them to cool until they can be handled, about 15 minutes. Scoop out the sweet potato flesh into a large bowl and mash well. Stir in orange juice, brown sugar, margarine, orange peel, and cinnamon. If you prefer the sweet potatoes to be very smooth, you can mix them with an electric mixer. Spread the potatoes in a microwave-safe dish."
    },
    {
      "position": 4,
      "text": "Microwave on HIGH until heated through, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

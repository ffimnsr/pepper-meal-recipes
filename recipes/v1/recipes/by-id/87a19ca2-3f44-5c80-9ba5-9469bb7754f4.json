  "id": "87a19ca2-3f44-5c80-9ba5-9469bb7754f4",
  "slug": "cauliflower-pizza-crust",
  "name": "Cauliflower Pizza Crust",
  "recipe_type": "main",
  "brief_description": "Delicious cauliflower pizza crust. You'll never guess this grain-free crust is made with cauliflower instead of flour. Serve with favorite toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cauliflower pieces through the feeding tube of the food processor using the grating blade; pulse until all the cauliflower is shredded."
    },
    {
      "position": 2,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower, cover, and steam until tender, about 15 minutes. Transfer cauliflower to a large bowl and refrigerate, stirring occasionally, until cooled, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper or a silicone mat."
    },
    {
      "position": 4,
      "text": "Stir Italian cheese blend, parsley, egg, garlic, salt, and pepper into cauliflower until evenly incorporated."
    },
    {
      "position": 5,
      "text": "Pour mixture onto the prepared baking sheet; press and shape into a pizza crust."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly browned, about 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "89a24d39-2a98-596f-9b95-8518d7e4a86b",
  "slug": "tomato-and-ricotta-salata-bruschetta",
  "name": "Tomato and Ricotta Salata Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "This bruschetta with tomatoes and ricotta salata is a perfect appetizer for dinner parties and a definite crowd pleaser.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place bread slices on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until toasted, about 5 minutes. Rub 1 side of the bread with the cut garlic."
    },
    {
      "position": 3,
      "text": "Toss tomatoes, ricotta salata, olive oil, vinegar, onion, basil, salt, and pepper together in a bowl. Divide evenly over bread."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

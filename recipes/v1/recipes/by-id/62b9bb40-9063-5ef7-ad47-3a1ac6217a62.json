  "id": "62b9bb40-9063-5ef7-ad47-3a1ac6217a62",
  "slug": "hearty-tuna-casserole",
  "name": "Hearty Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "This tuna noodle casserole with sour cream may not be your grandma\u2019s, but it is sure to please everybody in the family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 2-quart casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain and transfer to a large mixing bowl."
    },
    {
      "position": 3,
      "text": "Add tuna, celery, and green onions to the noodles. Stir in mayonnaise, sour cream, mustard, thyme, and salt until well combined."
    },
    {
      "position": 4,
      "text": "Spoon 1/2 of the noodle mixture into the prepared casserole dish, then layer 1/2 of the zucchini slices over top. Repeat layers once more, then sprinkle Monterey Jack cheese over the entire casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until hot and bubbly, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and sprinkle with chopped tomato before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bcdbfe27-9517-5260-b458-640e683d1a2e",
  "slug": "vegetarian-nori-rolls",
  "name": "Vegetarian Nori Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Nori seaweed sheets are filled with sticky rice, tofu, cucumber, avocado, and carrot. Serve with wasabi and pickled ginger for a Japanese-style treat.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "In a large saucepan cover rice with water and let stand for 30 minutes."
    },
    {
      "position": 2,
      "text": "In a shallow dish combine soy sauce, honey, and garlic. In this mixture, marinate tofu for at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Bring water and rice to a boil and then reduce heat; simmer for about 20 minutes, or until thick and sticky. In a large glass bowl, combine cooked rice with rice vinegar."
    },
    {
      "position": 4,
      "text": "Place a sheet of nori on a bamboo mat. Working with wet hands, spread 1/4 of rice evenly over nori; leave about 1/2 inch on the top edge of the nori. Place 2 strips of marinated tofu end to end about 1 inch from the bottom. Place 2 strips of cucumber next to tofu, then avocado and carrot."
    },
    {
      "position": 5,
      "text": "Roll nori tightly from the bottom, using the mat to help make a tight roll. Seal by moistening the top 1/2 inch with water. Repeat with remaining ingredients. Slice with a serrated knife into 1-inch thick slices."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fcaf27cd-71de-5fe1-938e-b8367e7c668c",
  "slug": "alfredo-gnocchi-bake-recipe-8732980",
  "name": "Alfredo Gnocchi Bake",
  "recipe_type": "side",
  "brief_description": "For this Alfredo gnocchi bake, pillowy soft gnocchi bake in a quickly-made savory, cheesy garlic Alfredo sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray an 8x8-inch baking pan with nonstick spray."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium-high heat. Add garlic and cook and stir until fragrant, about 40 seconds. Stir in evaporated milk and cream. Add Parmesan and stir until smooth."
    },
    {
      "position": 3,
      "text": "Add gnocchi; toss to coat. Pour gnocchi into the prepared pan. Sprinkle with black pepper."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly, about 25 minutes. Serve hot."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

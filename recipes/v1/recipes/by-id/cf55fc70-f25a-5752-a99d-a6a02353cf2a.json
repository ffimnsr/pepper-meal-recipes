  "schema_version": 1,
  "id": "cf55fc70-f25a-5752-a99d-a6a02353cf2a",
  "slug": "christmas-cake",
  "name": "Christmas Cake",
  "recipe_type": "dessert",
  "brief_description": "This classic Christmas cake made with brandy-soaked dried fruit, nuts, and spices is a decadent and moist festive fruitcake full of rich flavor.",
  "cuisine": "Uk And Ireland British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine candied cherries, citrus peel, and almonds in a medium bowl; add raisins, currants, and dates. Pour in brandy; stir to combine. Cover and let sit for 2 hours to overnight."
    },
    {
      "position": 3,
      "text": "When ready to bake, preheat the oven to 275 degrees F (135 degrees C). Grease a deep 8-inch fruitcake pan, line it with parchment paper, and grease again."
    },
    {
      "position": 4,
      "text": "Toss brandy-soaked fruit with \u00bd cup flour in a bowl."
    },
    {
      "position": 5,
      "text": "Whisk remaining 2 cups flour, cloves, allspice, cinnamon, baking soda, and salt together in a medium bowl."
    },
    {
      "position": 6,
      "text": "Stir molasses and apple juice together in a separate bowl until combined."
    },
    {
      "position": 7,
      "text": "Beat butter in a large bowl until light and fluffy; gradually blend in brown sugar and eggs."
    },
    {
      "position": 8,
      "text": "Add flour mixture in 4 batches, alternating with molasses mixture."
    },
    {
      "position": 9,
      "text": "Fold in floured fruit. Transfer batter to the prepared pan."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until a toothpick inserted into center of the cake comes out clean, 3 to 3 \u00bd hours."
    },
    {
      "position": 11,
      "text": "Remove cake from the pan; peel off parchment paper. Cool cake completely."
    }
  ],
  "servings": 16,

  "id": "bb60f849-1d80-507a-a3ec-bdc836313cfb",
  "slug": "homemade-turkey-breakfast-sausage",
  "name": "Homemade Turkey Breakfast Sausage",
  "recipe_type": "breakfast",
  "brief_description": "Make deliciously seasoned homemade turkey sausage patties in minutes, then cook and eat, or freeze to have on hand for breakfasts throughout the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix sage, salt, black pepper, red pepper flakes, and marjoram together in a small bowl. Place turkey into a large bowl and mix in spice mixture with your hands until well combined. Form into 10 patties."
    },
    {
      "position": 2,
      "text": "Cook patties in batches in a large skillet over medium-high heat until no longer pink in the center and the juices run clear, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

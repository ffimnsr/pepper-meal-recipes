  "id": "d6aa9fb0-518f-50bd-a8e2-2d9ed577b722",
  "slug": "vegan-pumpkin-pancakes",
  "name": "Vegan Pumpkin Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This vegan pumpkin pancake recipe takes on a hint of fall with the savory goodness of pumpkin, cinnamon, and pecans. Serve with pecans and maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine almond milk and vinegar in a measuring cup; set aside for 10 minutes. Combine water and flaxseed meal in a bowl; set aside until gelatinous, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine flour, coconut sugar, baking powder, cinnamon, baking soda, and salt in a medium bowl; stir in almond milk mixture, flaxseed meal mixture, pumpkin pur\u00e9e, and coconut oil until well blended. Fold in pecans."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle; cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

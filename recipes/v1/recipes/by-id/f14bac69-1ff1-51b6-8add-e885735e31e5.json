  "id": "f14bac69-1ff1-51b6-8add-e885735e31e5",
  "slug": "kraft-mac-and-cheese-tuna-casserole",
  "name": "Kraft Mac and Cheese Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "When you combine packaged Kraft mac and cheese with a classic tuna casserole, the result is comfort food at its best.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "Bring 6 cups water to a boil in a medium saucepan. Stir in macaroni from the box and cook for 7 minutes. Drain macaroni, then rinse under cold water and drain again. Set cheese sauce packet aside."
    },
    {
      "position": 3,
      "text": "Melt butter in the same saucepan over medium heat. Add milk and cheese sauce packet; mix well. Stir in condensed soup and cook until heated through, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Combine drained macaroni, peas, and tuna in a bowl. Fold in the cheesy soup mixture. Pour mixture into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Sprinkle with Cheddar cheese, then sprinkle French-fried onions over top. Bake until onions are brown and cheese is melted, another 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

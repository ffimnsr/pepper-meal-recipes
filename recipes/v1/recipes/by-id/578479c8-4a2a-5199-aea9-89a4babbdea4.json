  "id": "578479c8-4a2a-5199-aea9-89a4babbdea4",
  "slug": "cinnamon-roll-cookies",
  "name": "Cinnamon Roll Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cookies put a new twist on the original snickerdoodles by rolling the dough up with cinnamon inside, creating a new favorite dessert that is great for a quick treat or party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sift together all-purpose flour, baking soda, and salt in a bowl."
    },
    {
      "position": 2,
      "text": "Beat together butter and shortening using an electric mixer in another bowl until combined; add sugar and continue beating until light and fluffy, about 5 minutes. Pour in eggs, one at a time, beating well after each addition. Pour in flour mixture and blend until batter is smooth."
    },
    {
      "position": 3,
      "text": "Dust a work surface with flour and roll out cookie dough with a floured rolling pin into a 1/4-inch thick rectangle. Sprinkle cinnamon generously over the dough. Roll up the dough gently into a log starting on one of the long sides. Wrap tightly in plastic wrap and refrigerate for 2 to 3 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Unwrap the dough log and carefully slice into 1/4-inch pieces without smashing down the cookie. Place on an ungreased baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly golden around the edges, about 12 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

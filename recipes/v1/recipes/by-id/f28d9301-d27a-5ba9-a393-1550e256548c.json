{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f28d9301-d27a-5ba9-a393-1550e256548c",
  "slug": "munchable-donut-holes",
  "name": "Munchable Donut Holes",
  "recipe_type": "dessert",
  "brief_description": "These small donuts with vanilla glaze are irresistible. Add dried blueberries or cocoa powder to mix things up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together flour, baking powder, and salt in a bowl. In a large bowl, beat eggs, sugar, and vanilla with an electric mixer at medium speed until thick, about 3 minutes. In a small bowl, stir together milk and melted butter."
    },
    {
      "position": 2,
      "text": "Add flour mixture and milk mixture alternately to egg mixture, beating at low speed after each addition just until combined (stir in the last of the flour mixture, if needed). Chill dough, covered, until easy to handle, about 1 hour."
    },
    {
      "position": 3,
      "text": "Roll dough until 1/2-inch thick on a lightly floured surface. Cut donut holes using a 11/2-inch round cutter. Dip cutter into flour between cuts and reroll dough as needed. Set a wire rack inside a sheet pan."
    },
    {
      "position": 4,
      "text": "Pour oil to a depth of 21/2 to 3 inches in a 4-qt. pot or a deep-fat fryer. [You'll need about 2 qt. oil.] Heat to 365\u00b0F. (Use a frying thermometer to monitor temperature to keep it as close to 365\u00b0F as you can.)"
    },
    {
      "position": 5,
      "text": "Working in batches of 5 to 6 donut holes, fry, turning once halfway through, until light and golden, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Transfer donut holes to prepared rack. Let cool about 2 minutes."
    },
    {
      "position": 7,
      "text": "Whisk together powdered sugar, melted butter, vanilla extract and salt in a bowl to make the vanilla glaze. Whisk in hot water, 1 tablespoon at a time, until desired consistency. If glaze thickens, stir in additional hot water, 1 teaspoon at a time."
    },
    {
      "position": 8,
      "text": "Coat donuts with vanilla glaze. Let stand until glaze is set, about 30 minutes."
    }
  ],
  "servings": 72,

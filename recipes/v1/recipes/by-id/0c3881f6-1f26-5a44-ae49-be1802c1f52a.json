  "id": "0c3881f6-1f26-5a44-ae49-be1802c1f52a",
  "slug": "cheesy-keto-biscuits",
  "name": "Cheesy Keto Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These large biscuits made from almond flour, Cheddar cheese, eggs, and half-and-half fit into a low-carb or keto diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine almond flour and baking powder in a large bowl. Mix in Cheddar cheese by hand. Create a small well in the middle of the bowl; add eggs and half-and-half to the center. Use a large fork, spoon, or your hands to blend in the flour mixture until a sticky batter forms."
    },
    {
      "position": 3,
      "text": "Drop 9 portions of batter onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 20 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

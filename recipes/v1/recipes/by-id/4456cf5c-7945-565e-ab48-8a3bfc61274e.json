  "slug": "eggnog-milkshake",
  "name": "Eggnog Milkshake",
  "recipe_type": "dessert",
  "brief_description": "A seasonal milkshake made with eggnog and butter pecan ice cream. Top with whipped cream and dust with cinnamon to be extra festive.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine eggnog, ice cream, and milk in a blender. Blend on high until incorporated. Pour into a glass, garnish with whipped cream, and dust with cinnamon if desired."
    }
  ],

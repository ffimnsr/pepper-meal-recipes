  "id": "b677247a-cf67-52dc-a6b5-ef3055fe8bc6",
  "slug": "chicken-and-veggie-miso-soup-instant-pot-version",
  "name": "Instant Pot Chicken Miso Soup",
  "recipe_type": "soup",
  "brief_description": "This chicken miso soup is full of fresh ingredients and flavored with garlic, ginger, and miso paste for a delicious Japanese soup made in an Instant Pot.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour grapeseed oil into an electric pressure cooker (such as Instant Pot). Add carrots, leeks, shiitake mushrooms, and onion; cook and stir on the Saut\u00e9 setting until softened, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Season chicken thighs with salt and pepper; add to the pot. Pour in chicken broth. Seal and cook on the Soup setting for 7 minutes. Release pressure naturally for 10 minutes according to the manufacturer's instructions. Cover the vent with a dishtowel and release remaining pressure with the quick-release method."
    },
    {
      "position": 3,
      "text": "Remove chicken thighs and shred with 2 forks on a cutting board; return to the pot and add miso paste, garlic, soy sauce, ginger, and Sriracha. Cook and stir on the Saut\u00e9 setting until miso paste dissolves, about 5 minutes. Stir in cabbage and bok choy; cook until softened, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "88fff631-c4ee-5462-b8b3-1574fa1ec5c4",
  "slug": "air-fryer-falafel-gluten-free",
  "name": "Air Fryer Falafel (Gluten Free)",
  "recipe_type": "main",
  "brief_description": "These delicious, crispy, gluten-free falafel loaded with spices and fresh herbs and made with almond flour are so simple to make in your air fryer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour chickpeas into the basket of a large air fryer. Cook at 220 degrees F (104 degrees C) until mostly dry, about 15 minutes. Check after 10 minutes of cooking; all liquid should be evaporated and chickpeas should still be squishy, not toasted or hardened. Turn air fryer off."
    },
    {
      "position": 2,
      "text": "Transfer chickpeas to a food processor. Add onion, cilantro, parsley, almond flour, garlic, cumin, cayenne, baking powder, salt, pepper, baking soda, and nutmeg. Process on medium-high speed until a chunky paste forms."
    },
    {
      "position": 3,
      "text": "Refrigerate mixture to let flavors develop and to enable more drying, at least 30 minutes, or up to 1 hour."
    },
    {
      "position": 4,
      "text": "Form mixture into 1 1/4-inch balls. Place in the air fryer basket and spray with sesame oil spray; be careful, falafel will be delicate."
    },
    {
      "position": 5,
      "text": "Set the air fryer to 320 degrees F (160 degrees C) and cook for 10 minutes. Coat with more sesame oil if desired, increase temperature to 350 degrees F (175 degrees C), and cook until outsides are toasted, about 10 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

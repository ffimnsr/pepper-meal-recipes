  "id": "2537ea11-34e1-53e0-a2a5-ce776114d376",
  "slug": "manhattan-style-clam-chowder",
  "name": "Manhattan-Style Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "This big-batch Manhattan clam chowder recipe with vegetables, clams, and spices is great when company's coming since it makes enough for 12 people.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine diced tomatoes, crushed tomatoes, and clams together with juices in a large stockpot over medium heat. Stir in Worcestershire sauce, oregano, basil, onion powder, and hot pepper sauce. Simmer for 30 minutes."
    },
    {
      "position": 2,
      "text": "Stir in potatoes, carrots, bell peppers, and celery. Simmer, stirring occasionally, for 2 to 3 hours. Season with salt and pepper."
    }
  ],
  "servings": 12,

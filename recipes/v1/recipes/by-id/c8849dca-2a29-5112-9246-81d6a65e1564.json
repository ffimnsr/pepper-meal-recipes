  "id": "c8849dca-2a29-5112-9246-81d6a65e1564",
  "slug": "banana-nut-scones",
  "name": "Banana-Nut Scones",
  "recipe_type": "dessert",
  "brief_description": "Drizzle banana-nut scones with a sweet maple glaze to balance the earthiness of the walnuts and the heat of the cinnamon.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a cookie sheet."
    },
    {
      "position": 2,
      "text": "Place bananas in a large bowl; beat with an electric mixer until mashed. Add brown sugar, yogurt, egg, and vanilla, beating until smooth. Add cinnamon, baking powder, and salt, beating to combine. Add flour, 1 cup at a time, beating just until combined after each addition. Do not overmix."
    },
    {
      "position": 3,
      "text": "Grate chilled butter into batter using a cheese grater. Beat to combine. Fold in walnuts using a rubber spatula. Drop batter by generous 1/4 cupfuls onto the prepared cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges and tops of scones are golden and a toothpick inserted in the center of a scone comes out with only crumbs, 17 to 20 minutes."
    },
    {
      "position": 5,
      "text": "When scones have a few minutes left in the oven, combine maple syrup and butter for glaze in a small saucepan over medium heat. Cook until butter melts completely; do not boil. Remove from heat. Add just enough confectioners' sugar, whisking in a small amount at a time, to reach desired consistency for glaze."
    },
    {
      "position": 6,
      "text": "Drizzle glaze over scones using a spoon or whisk."
    }
  ],
  "servings": 11,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

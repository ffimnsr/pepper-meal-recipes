  "id": "8e9250b6-7024-5f6d-be1d-585ffad47ac7",
  "slug": "spring-lamb-pan-fried-dumplings",
  "name": "Spring Lamb Pan-Fried Dumplings",
  "recipe_type": "appetizer",
  "brief_description": "A minty dipping sauce perfectly complements Chef John's latest appetizer-pan-fried dumplings stuffed with a rich lamb and pea filling.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine lamb, garlic, green onions, chile pepper, peas, salt, pepper, cayenne, and cumin in a bowl. Mix with 2 forks, starting on the surface of the mixture, until ingredients are evenly combined. Wrap in plastic and chill for 3 hours, or up to overnight."
    },
    {
      "position": 2,
      "text": "Mix rice vinegar, soy sauce, and mint together in a bowl for dipping sauce. Refrigerate until needed."
    },
    {
      "position": 3,
      "text": "Combine beaten egg and water in a small bowl. Brush the edges of a wonton wrapper with some of the egg wash. Drop 2 to 3 teaspoons of filling in the center. Fold over and press edges together while squeezing out any air bubbles. Continue with remaining wrappers and filling. Let rest for about 10 minutes."
    },
    {
      "position": 4,
      "text": "Heat butter in a pan over medium heat. Fry batches of dumplings in the hot butter until meat is no longer pink and dumplings are golden brown, about 3 minutes per side. Serve with dipping sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "5f327bc0-b736-593d-86e8-f8bba0c95f85",
  "slug": "pineapple-upside-down-bars-recipe-7495440",
  "name": "Pineapple Upside Down Bars",
  "recipe_type": "dessert",
  "brief_description": "Moist, buttery pineapple upside down bars are a slightly quicker variation of the traditional pineapple upside down cake, and they're egg-free.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch square pan with enough parchment to have overhang on all sides; spray the parchment with nonstick spray."
    },
    {
      "position": 2,
      "text": "Remove 8 or 9 pineapple rings from the can and pat them dry with a paper towel. Measure out 1/2 cup pineapple juice from the can, and set aside to use for the batter. Reserve any remaining pineapple rings and remaining pineapple juice for another use."
    },
    {
      "position": 3,
      "text": "Pat maraschino cherries with a paper towel to remove excess moisture."
    },
    {
      "position": 4,
      "text": "Place pineapple rings in an even layer in the bottom of the pan, trimming as necessary to fit. Add the cherries to the pan, placing them in and around the pineapple rings, making whatever decorative pattern you would like. Sprinkle pineapple and cherries with the 1 1/2 teaspoons brown sugar."
    },
    {
      "position": 5,
      "text": "In a large bowl, whisk together melted butter, white sugar, and the 1/4 cup brown sugar until thoroughly combined. Add in 1/2 cup reserved pineapple juice, lemon juice, and vanilla extract. Stir until mixture looks curdled. Add in the flour, salt, baking soda, cinnamon, and nutmeg, and whisk until the batter is smooth."
    },
    {
      "position": 6,
      "text": "Place dollops of batter over prepared pineapple and cherries, and gently spread into an even layer with a spatula."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until edges of the bars are golden brown and center is set, 30 to 35 minutes. A toothpick inserted near the center should come out clean."
    },
    {
      "position": 8,
      "text": "Allow bars to cool in the pan for 15 minutes. Carefully invert onto a plate or platter, and gently remove parchment paper. Allow to cool completely. Once bars are cool, carefully run a knife or a long, thin spatula underneath the bars to loosen them from the plate or platter. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

  "id": "c45f1598-3fbb-5acc-902c-7cff3cb0fe92",
  "slug": "curry-red-lentil-soup",
  "name": "Curry Red Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "Fresh vegetables and aromatic spices combine in this comforting red lentil soup that's ready in just under an hour.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium-high heat. Add cauliflower and carrots; saute until softened, 7 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Pour boiling water and vegetable bouillon into a bowl and stir until dissolved. Add broth and coconut milk to cauliflower mixture. Bring to a boil."
    },
    {
      "position": 3,
      "text": "Stir lentils, garlic powder, onion flakes, curry, paprika, turmeric, and cumin into the pot. Cover and let simmer until lentils are fully cooked and tender, about 20 minutes. Stir in kale and let sit over low heat for 5 minutes. Remove from heat and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

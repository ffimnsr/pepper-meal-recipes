{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "dddf3bba-175f-5790-bd26-02e22ca74ef6",
  "slug": "best-homemade-chicken-pot-pie",
  "name": "Best Homemade Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This easy chicken pot pie features chicken, crisp-tender veggies, and a rich and creamy sauce set between two layers of a deliciously buttery, flaky pie crust. After trying this simple, one-pan homemade pot pie, you'll never buy store-bought chicken pot pie again!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a large, deep skillet over medium-high heat. Add onion, carrot, celery, salt, and rosemary and cook, stirring often, until onion is translucent, about 5 minutes. Stir in flour and cook for 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in chicken broth and cream and bring to a simmer. Reduce heat and cook, stirring often, until thick and creamy and vegetables have started to soften, about 5 minutes. Stir in chicken, peas, and parsley until well combined. Season with salt and pepper and remove from the heat."
    },
    {
      "position": 4,
      "text": "Place one crust in the bottom of a 9-inch pie plate. Add filling and place second crust on top. Press crusts together to seal around the edges and use fingers to crimp the dough. Cut small slits in the top and transfer to a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and bubbly, about 30 minutes. Tent the edges with foil while baking if they become too brown. Let stand 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "3ddf9f6c-740a-5853-afb6-bbe89e062b80",
  "slug": "garlic-salmon",
  "name": "Garlic Salmon",
  "recipe_type": "main",
  "brief_description": "A large salmon fillet, steamed in foil and cooked either in the oven or barbecue. It's seasoned with minced garlic, fresh baby dill, lemon slices, fresh ground pepper, and green onions.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray two large pieces of aluminum foil with cooking spray."
    },
    {
      "position": 2,
      "text": "Place salmon fillet on top of one piece of foil. Sprinkle salmon with salt, pepper, garlic, and chopped dill. Arrange lemon slices on top of the fillet and place a sprig of dill on top of each slice. Sprinkle fillet with chopped scallions."
    },
    {
      "position": 3,
      "text": "Cover salmon with the second piece of foil and pinch together the foil to seal tightly. Place on a baking sheet or in a large baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 to 25 minutes until salmon flakes easily."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

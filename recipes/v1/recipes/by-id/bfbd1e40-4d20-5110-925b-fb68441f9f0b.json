  "id": "bfbd1e40-4d20-5110-925b-fb68441f9f0b",
  "slug": "no-bake-pumpkin-cheesecake-pie",
  "name": "No-Bake Pumpkin Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This no-bake pumpkin cheesecake with a sweet and creamy whipped topping filling in a shortbread crust chills until set for an easy holiday dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat pumpkin pie filling, cream cheese, 1 cup whipped topping, and confectioners\u2019 sugar in a large bowl until smooth."
    },
    {
      "position": 3,
      "text": "Spread into the prepared pie crust."
    },
    {
      "position": 4,
      "text": "Spread remaining whipped topping evenly over pie."
    },
    {
      "position": 5,
      "text": "Refrigerate pie until the filling is set, 4 to 6 hours. Sprinkle with cinnamon before serving, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

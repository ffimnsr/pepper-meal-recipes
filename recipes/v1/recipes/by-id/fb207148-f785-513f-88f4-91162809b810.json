  "id": "fb207148-f785-513f-88f4-91162809b810",
  "slug": "vegan-chocolate-chip-cookies",
  "name": "Vegan Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These vegan chocolate chip cookies made with coconut oil, almond milk, and vegan chocolate chips are tender and gooey with delicious crispy edges.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream coconut oil and brown sugar together in a bowl with an electric mixer until thoroughly mixed, about 5 minutes. Mix in almond milk and vanilla until incorporated, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl. Add the flour mixture to the almond milk mixture, stirring until combined; dough will be crumbly. Fold in chocolate chips."
    },
    {
      "position": 4,
      "text": "Roll the dough into tablespoon-sized balls and place on ungreased or parchment-lined baking sheets. Flatten each ball out a bit with your palm, pressing any crumbs back together."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the edges are golden brown and set, about 8 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

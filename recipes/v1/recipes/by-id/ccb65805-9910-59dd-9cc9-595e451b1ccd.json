  "id": "ccb65805-9910-59dd-9cc9-595e451b1ccd",
  "slug": "cheese-ravioli-with-pumpkin-sauce",
  "name": "Cheese Ravioli with Pumpkin Sauce",
  "recipe_type": "dessert",
  "brief_description": "Store-bought fresh or frozen cheese ravioli is topped with a sweet, homemade pumpkin sauce and Parmesan cheese, making it a warm and comforting recipe.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken broth, pumpkin pur\u00e9e, milk, white sugar, brown sugar, butter, ginger, cinnamon, cloves, and nutmeg in a large saucepan; bring to a boil. Reduce heat to medium; simmer, stirring occasionally, until butter melts and sauce is heated through, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a boil; stir in ravioli and return to a boil. Cook uncovered, stirring occasionally, until ravioli float to the top and the filling is hot, 6 to 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Transfer pasta to a serving bowl; top with pumpkin sauce and Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

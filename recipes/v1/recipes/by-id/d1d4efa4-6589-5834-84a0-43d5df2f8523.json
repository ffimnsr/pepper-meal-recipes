  "schema_version": 1,
  "id": "d1d4efa4-6589-5834-84a0-43d5df2f8523",
  "slug": "instant-pot-crispy-chicken-carnitas",
  "name": "Instant Pot Crispy Chicken Carnitas",
  "recipe_type": "main",
  "brief_description": "This Instant Pot crispy chicken carnitas recipe is easy to prepare. It's cooked in an Instant Pot then crisped in the broiler for a tasty, spicy dish.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cumin, chili powder, oregano, salt, and black pepper in a bowl; sprinkle over both sides chicken breasts."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add 1 tablespoon olive oil; sear chicken breasts in batches, 1 to 2 minutes per side. Transfer chicken to a plate."
    },
    {
      "position": 3,
      "text": "Add onion and garlic to the Pot; cook and stir until translucent and golden, about 2 minutes. Return chicken to the Pot; add cilantro, lime juice, chicken broth, orange zest and juice, 1 chipotle pepper with 1 tablespoon adobo sauce, and bay leaf. Close and lock the lid. Select high pressure according to the manufacturer's instructions; set the timer for 8 to 10 minutes, depending on size of chicken breasts. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine mayonnaise, 1 chipotle pepper with 1 tablespoon adobo sauce, milk, 1 pinch salt, and garlic powder in a blender; blend until smooth. Refrigerate sauce until ready to serve."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to the manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 6,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Coat a baking sheet with 1 tablespoon oil."
    },
    {
      "position": 7,
      "text": "Transfer chicken breasts to a work surface; reserve cooking liquid. Shred chicken using 2 forks; place in a large bowl. Drizzle 1/4 cup reserved cooking liquid over chicken; toss to coat. Transfer chicken to the prepared baking sheet; drizzle with remaining 1 tablespoon oil, tossing to coat."
    },
    {
      "position": 8,
      "text": "Broil chicken in the preheated oven for 5 minutes. Toss chicken with 1 to 2 tablespoons reserved cooking liquid; rotate the baking sheet. Continue broiling until chicken is crispy, 5 to 7 minutes more. Serve with chipotle sauce."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,

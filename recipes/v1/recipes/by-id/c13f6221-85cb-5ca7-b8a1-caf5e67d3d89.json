  "id": "c13f6221-85cb-5ca7-b8a1-caf5e67d3d89",
  "slug": "cottage-cheese-banana-bread-recipe-11853295",
  "name": "Cottage Cheese Banana Bread",
  "recipe_type": null,
  "brief_description": "This cottage cheese banana bread is very moist with a strong banana flavor and added protein. If you like you can add chocolate chips to the batter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan and line with parchment paper, leaving an overhang on the long sides."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking soda, baking powder, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Blend cottage cheese in a blender or food processor until smooth; transfer to a bowl. Stir in melted butter or oil, mashed bananas, eggs, and brown sugar until well combined."
    },
    {
      "position": 4,
      "text": "Stir banana mixture into flour mixture just until combined; do not overmix."
    },
    {
      "position": 5,
      "text": "Scrape batter into the prepared pan and smooth the top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 60 to 65 minutes. Internal temperature of quick bread should be 205 to 210 degrees F (96 to 98 degrees C). If needed, cover bread with aluminum foil the last 20 minutes of baking to prevent over-browning."
    },
    {
      "position": 7,
      "text": "Let bread cool in the pan for 10 minutes. Lift out using the parchment overhang and transfer to a wire rack to cool completely, about 1 hour. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b3ce7d57-0835-5ae0-a8fe-be53bfadc4ba",
  "slug": "strawberry-rhubarb-frangipane-bars-recipe-11995619",
  "name": "Strawberry-Rhubarb Frangipane Bars",
  "recipe_type": "dessert",
  "brief_description": "These strawberry-rhubarb frangipane bars have a cake-like base and a gooey almond topping. The strawberry and rhubarb add a nice brightness that complements the almond well. You can enjoy these bars slightly warmed, room temp, or even chilled. I do recommend storing them in the refrigerator to keep them fresh longer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a 9x13-inch pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "In a bowl, toss together rhubarb, strawberries, 1/4 cup white sugar, and cornstarch; set aside."
    },
    {
      "position": 3,
      "text": "For frangipane, beat butter, white sugar, and salt until light and fluffy together in a separate bowl with an electric mixer. Add egg, almond extract, and vanilla, and beat until thoroughly smooth and combined. Add almond flour and beat until thoroughly incorporated. Set frangipane aside until needed."
    },
    {
      "position": 4,
      "text": "For cake layer, beat butter, brown sugar, salt, cinnamon and nutmeg in a large bowl until light and fluffy, about 3 minutes. Add eggs, 1 at a time, beating well after each addition. Add vanilla, almond extract, and buttermilk and mix until incorporated (batter will look curdled at this point). Add in flour and baking powder and mix just until batter looks smooth."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan and spread into an even layer. Dollop 1/2-inch chunks of the frangipane randomly over the batter (batter does not need to be completely covered). Pour over the strawberries and rhubarb, and spread into an even layer. Gently press down on strawberries and rhubarb to slightly flatten into the frangipane. Sprinkle sliced almonds evenly over the top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bars are golden on the edges and firmly set in the center, and the center of the bars have reached an internal temp of 202 to 205 degrees F (94 to 96 degrees C), 60 to 75 minutes. Allow cake to cool in the pan for 15 minutes before carefully removing to a wire rack to cool completely. Cut into 24 bars. Keep extra bars stored in the fridge."
    }
  ],

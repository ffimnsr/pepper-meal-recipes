  "id": "cdbab1ab-f8f5-555f-8e90-7e9f8dc134ab",
  "slug": "apple-flavored-pot-roast",
  "name": "Apple-Flavored Pot Roast",
  "recipe_type": "dessert",
  "brief_description": "This apple-flavored pot roast recipe yields a tender, slightly sweet pot roast made with apple juice, potatoes, and carrots \u2014 a comforting one-pot meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Place beef in a roasting pan or large casserole dish; add about \u00bd inch of water. Stir in apple juice concentrate and soy sauce. Cut several small slits in roast; stuff with garlic. Season roast with onion soup mix. Cover the pan with aluminum foil or a lid."
    },
    {
      "position": 3,
      "text": "Cook in the preheated oven for 2 hours. Add potatoes and carrots. Cover the pan; continue cooking until roast is fork tender, about 2 hours more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

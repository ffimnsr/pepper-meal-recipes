  "id": "6eac923e-ee83-5d2e-a491-03b44ef79173",
  "slug": "peach-blondies-recipe-11956964",
  "name": "Peach Blondies",
  "recipe_type": "dessert",
  "brief_description": "These peach blondies, or peaches n' cream brownies, are made from cake mix with a vibrant canned or fresh peach frosting, perfect for summer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease an 11x7-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat cake mix, melted butter, eggs, and vanilla in a bowl with an electric mixer until well combined. Spread mixture in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick comes out mostly clean when inserted into the center, 16 to 17 minutes (should be gooey). Allow brownies to cool in the pan for about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, puree 4 peach slices in a food processor until smooth."
    },
    {
      "position": 5,
      "text": "Add peach puree and confectioners sugar to a bowl and mix until smooth, adding extra confectioner's sugar as necessary to reach the consistency of a glaze."
    },
    {
      "position": 6,
      "text": "Spread peach glaze evenly over cooled blondies and let stand until completely cooled. Cut into 12 squares and add 1 peach slice onto each piece. Refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

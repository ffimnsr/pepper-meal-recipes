  "id": "95835e24-76ba-5fd2-b068-96cc10a12d6b",
  "slug": "single-serving-frittata-recipe-11971105",
  "name": "Single Serving Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This single serving frittata is a quick-and-easy way to style up breakfast or brunch. In a single serving, you can use small bits of leftovers like potatoes, asparagus, bacon, mushrooms, or spinach, or make this just as the recipe calls for.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk whole egg and egg whites together in a small bowl. Season with salt and pepper, and set aside."
    },
    {
      "position": 3,
      "text": "Heat an 8-inch oven-proof skillet over medium heat, and add bacon. Cook until crisp, remove to a paper towel to drain, and crumble. Add bell pepper, onion, and mushrooms to the same skillet, and saute for 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Scatter bacon evenly over veggies. Pour egg mixture into skillet, covering veggies. Top with sliced tomatoes, and sprinkle with cheese."
    },
    {
      "position": 5,
      "text": "Transfer skillet to the preheated oven; bake until eggs are just set, about 7 minutes. Serve whole or cut into wedges and serve immediately."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

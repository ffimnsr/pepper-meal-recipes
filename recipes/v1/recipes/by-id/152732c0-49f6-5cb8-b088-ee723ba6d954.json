  "id": "152732c0-49f6-5cb8-b088-ee723ba6d954",
  "slug": "bisquick-pie-crust",
  "name": "Bisquick Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "This Bisquick pie crust is made with baking mix for simplicity and ease. It's sure to become your new go-to pie crust for any type of filling!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix baking mix and butter together in a small bowl. Add water and vigorously stir until a soft dough forms. Flour your hands with a bit of baking mix, then press dough into a 9-inch pie plate."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until light golden brown, 8 to 10 minutes. Let cool completely before filling with desired filling."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

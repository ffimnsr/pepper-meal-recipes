  "id": "f03ebbb1-08ef-5f4a-9f16-d85813893b5a",
  "slug": "best-cherry-pie",
  "name": "Best Cherry Pie",
  "recipe_type": "dessert",
  "brief_description": "Sweet, thick and full of cherries, this pie is irresistible. The filling is whipped up from a classic combination of canned sour cherries, sugar, flour, and almond flavoring.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 C). Make pastry and refrigerate."
    },
    {
      "position": 2,
      "text": "Drain cherries, reserving 1 cup liquid. In a saucepan combine sugar, flour and salt. Stir in cherry liquid and bring to a boil, stirring often. Reduce heat and simmer for 5 minutes. Mixture will thicken."
    },
    {
      "position": 3,
      "text": "When mixture is thickened, add butter, almond extract, food coloring and cherries. Cover and refrigerate."
    },
    {
      "position": 4,
      "text": "On lightly covered surface, roll out half of the pastry into an 11 inch circle. Put into 9 inch pie dish. Roll other half of pastry into another 11 inch circle. With a knife or pastry wheel, cut eight 1/2 inch strips."
    },
    {
      "position": 5,
      "text": "Pour cooled cherry filling into pie dish. Place pastry strips horizontally, then vertically, across the top of the pie and lightly brush with egg yolk. Bake 30 to 35 minutes, and cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

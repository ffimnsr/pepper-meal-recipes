  "name": "Red Wine Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "A classic recipe for red wine vinaigrette you can make from scratch in minutes with ingredients you most likely have in your pantry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine olive oil, red wine vinegar, maple syrup, Dijon mustard, shallot, Italian seasoning, salt, and pepper in a jar with a lid. Shake to combine until mixture is emulsified, about 20 seconds. Adjust salt and pepper, if needed."
    }
  ],

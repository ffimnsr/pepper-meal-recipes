  "id": "1bca317c-6f1f-537c-b808-f325170e9c87",
  "slug": "apple-pie-iv",
  "name": "Apple Pie with Pre-Cooked Apple Filling",
  "recipe_type": "dessert",
  "brief_description": "Fill a pie crust with a pre-cooked apple pie filling that you make on the stovetop, then cover with a top crust and finish baking in the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine apples, sugar, cinnamon, and nutmeg in a large pot over low heat. Mix well and cook, stirring frequently, until apples are tender but not mushy, 8 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Place one pie pastry in a 9-inch pie pan. Pour in apple mixture, then cover with remaining pastry. Seal the edges and cut several steam vents in the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is golden brown, 30 to 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

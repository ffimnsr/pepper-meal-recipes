  "id": "dac9dbe6-0f5b-50a2-a6d3-70a83e6292f9",
  "slug": "gingerbread-bundt-cake-recipe-8364140",
  "name": "Gingerbread Bundt Cake",
  "recipe_type": "dessert",
  "brief_description": "This gingerbread Bundt cake is spicy, molasses-y, and oh-so-tasty. Sweet and warmly aromatic, gingerbread cake is often humble comfort food, but baked in a decorative Bundt pan and dusted with powdered sugar, it's elegant enough for any holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a 10-cup Bundt pan with a baking spray containing flour (such as Baker's Joy\u00ae)."
    },
    {
      "position": 2,
      "text": "Whisk together flour, ginger, cinnamon, baking powder, salt, nutmeg, baking soda, cloves, and allspice in a bowl until combined."
    },
    {
      "position": 3,
      "text": "Combine butter, oil, brown sugar, and white sugar in a large bowl. Best with an electric mixer until light and fluffy, about 3 minutes. Add in eggs, 1 at a time, beating well after each addition. After last egg is added, increase mixer speed to medium-high and beat until mixture has doubled in volume, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Mix in molasses and vanilla. Reduce mixer speed; mix in half of dry ingredients until just combined. Add in sour cream and mix until just combined. Pour in remaining dry ingredients and mix until just combined."
    },
    {
      "position": 5,
      "text": "Pour batter evenly into prepared Bundt pan, then place pan on a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a bamboo skewer inserted into the center of the cake comes out clean, 60 to 70 minutes. Allow cake to cool in pan for 20 minutes before removing to a wire rack to cool completely. Sprinkle with powdered sugar before serving, if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

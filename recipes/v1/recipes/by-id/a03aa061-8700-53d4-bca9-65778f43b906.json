  "id": "a03aa061-8700-53d4-bca9-65778f43b906",
  "slug": "apple-tarragon-turkey-sloppy-joes",
  "name": "Apple-Tarragon Turkey Sloppy Joes",
  "recipe_type": "dessert",
  "brief_description": "Sloppy joes get a makeover in this recipe that boosts ground turkey with sweet and tart flavor from Granny Smith apple and anise-flavored tarragon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground turkey, onion, bell pepper, and apple into a large skillet over medium heat. Cook and stir until turkey is browned and crumbly, 7 to 9 minutes."
    },
    {
      "position": 2,
      "text": "Stir ketchup, water, Dijon mustard, cider vinegar, sugar, tarragon, salt, and cloves into the skillet. Reduce heat to low and simmer for 10 minutes, adding a little more water if mixture gets a bit thick."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,

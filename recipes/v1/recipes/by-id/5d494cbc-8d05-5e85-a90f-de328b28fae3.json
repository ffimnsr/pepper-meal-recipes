  "id": "5d494cbc-8d05-5e85-a90f-de328b28fae3",
  "slug": "simple-chicken-gravy",
  "name": "Simple Chicken Gravy",
  "recipe_type": "side",
  "brief_description": "Make chicken gravy from drippings with this simple recipe using flour and water combined with pan drippings from roasted chicken for a basic gravy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place flour in a medium bowl. Pour 2 to 3 tablespoons of water into the flour and whisk until combined and thick, but not pasty."
    },
    {
      "position": 3,
      "text": "Stir flour mixture and remaining water (or stock) into a roasting pan with drippings from roast chicken; whisk to combine and turn heat to medium. Cook, stirring constantly, until gravy is thickened and bubbly, adding more water (or stock) if needed. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

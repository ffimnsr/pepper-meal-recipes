{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1caa8614-a6c8-567f-a5fa-4669503e9601",
  "slug": "popcorn-cookies-recipe-11870055",
  "name": "Popcorn Cookies",
  "recipe_type": "dessert",
  "brief_description": "These popcorn cookies, made with a chocolate chip cookie dough studded with crushed popped popcorn, are the perfect salty-sweet combo, with a wonderful chewy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add popcorn kernels. As soon as one of the kernels pops, put a lid on the skillet and shake the pan often. Continue to cook until most kernels have popped. Pour popped popcorn into a bowl, and discard any unpopped or partially popped kernels. Drizzle popcorn with melted butter and pinch of salt and toss to coat."
    },
    {
      "position": 2,
      "text": "Once popcorn is cool enough to handle, use your hands to break it into pieces, about the size of a pea or smaller. This should yield approximately 1 1/2 cups of crushed popcorn. Set aside."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "For cookie dough, beat 3/4 cup butter, brown sugar, white sugar, salt, and nutmeg together in a large bowl until light and fluffy. Add egg, egg yolk, and vanilla and beat until thoroughly incorporated. Add flour, baking soda, and baking powder and mix until just combined. Fold in crushed popcorn, pecans, and white chocolate chips."
    },
    {
      "position": 5,
      "text": "Scoop out 1 1/2 tablespoon-sized balls of dough and place them 2 inches apart on the prepared baking sheets."
    },
    {
      "position": 6,
      "text": "Bake 1 pan at a time in the preheated oven until golden brown on the bottom, 12 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Remove cookies from the oven and immediately place a large round cookie cutter (slightly larger than the cookie) over the top of one of the cookies and swirl it. Quickly but gently, swirl the cookie with the cookie cutter until it is perfectly round and slightly thicker in texture. Repeat this process with the remaining cookies, making sure to work fast, as this must be done while the cookies are still hot out of the oven (this process is known as \u201cscooting\u201d the cookies; see note)."
    },
    {
      "position": 8,
      "text": "Allow cookies to cool on the baking sheet for 5 minutes, then remove to a wire rack to cool completely."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "e2b7a4fa-fec2-5f11-b6d2-2d7cc949d283",
  "slug": "day-after-thanksgiving-turkey-carcass-soup",
  "name": "Day-After-Thanksgiving Turkey Carcass Soup",
  "recipe_type": "soup",
  "brief_description": "This-day-after-Thanksgiving turkey carcass soup recipe turns leftover turkey, stuffing, and vegetables into a second comforting post-holiday meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place carcass in a large pot. Add stuffing, onion, carrots, celery, poultry seasoning, sage, and bay leaves."
    },
    {
      "position": 2,
      "text": "Pour in chicken broth; add additional water to cover, if needed. Bring to a boil over medium-high heat. Reduce heat to medium; simmer, skimming off and discarding any foam, about 1 hour."
    },
    {
      "position": 3,
      "text": "Remove carcass and any bones; pick off any meat. Return meat to the pot and discard bones and skin."
    },
    {
      "position": 4,
      "text": "Add garlic salt and pepper. Stir in rice and return to a boil over medium-high heat. Reduce heat to medium and simmer for 15 minutes."
    },
    {
      "position": 5,
      "text": "Stir in peas; continue to simmer until rice is tender, about 10 minutes more."
    },
    {
      "position": 6,
      "text": "Adjust seasonings to taste before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

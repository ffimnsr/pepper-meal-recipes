  "id": "257c4bc7-80ad-5caf-ba36-230e823e2c29",
  "slug": "oreo-mint-chocolate-mousse",
  "name": "OREO Mint Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "Instant pudding mix makes short work of this minty chocolate mousse. A garnish of fresh berries and minty cookie halves takes the dish to new heights.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat pudding mix and milk in medium bowl with whisk 2 minutes."
    },
    {
      "position": 2,
      "text": "Chop 10 cookies coarsely; stir into pudding with whipped topping until blended. Spoon into 8 dessert dishes."
    },
    {
      "position": 3,
      "text": "Refrigerate 1 hour. Cut remaining cookies in half. Top desserts with cookie halves and fruit. Garnish with mint, if desired."
    }
  ],
  "servings": 8,

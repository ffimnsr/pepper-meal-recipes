  "id": "e5d40141-a17f-5c8c-a566-f14ad006f092",
  "slug": "cuban-style-chicken-soup-recipe-11851718",
  "name": "Cuban-Style Chicken Soup",
  "recipe_type": "salad",
  "brief_description": "The vegetables and the seasonings in this Cuban-style chicken soup take you straight to the Caribbean. With yucca, plantains, corn, cilantro, plenty of garlic, and fine-textured fideo noodles, we like it with some crusty bread, and sometimes, a simple green salad.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large Dutch oven over medium-high heat until it just begins to shimmer. Add onion and bell pepper, and cook, stirring, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Add chicken and continue cooking about 3 to 5 minutes, stirring frequently."
    },
    {
      "position": 3,
      "text": "Stir in garlic, salt, pepper, Saz\u00f3n, granulated garlic, onion powder, cumin, and oregano, and cook about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add tomatoes with juice, chicken broth, and cilantro, and bring to a boil. Reduce heat to medium and cook, uncovered, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Add carrots, red potatoes, and yucca, and continue cooking until the vegetables are beginning to soften, about 10 minutes. Stir occasionally."
    },
    {
      "position": 6,
      "text": "Stir in corn, fideo noodles, and plantains, and cook until noodles are tender, about 7 minutes more."
    },
    {
      "position": 7,
      "text": "Ladle into bowls and serve with lime wedges and additional cilantro."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

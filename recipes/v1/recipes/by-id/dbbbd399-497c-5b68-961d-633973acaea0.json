  "id": "dbbbd399-497c-5b68-961d-633973acaea0",
  "slug": "blue-cheese-beef-tenderloin",
  "name": "Blue Cheese Beef Tenderloin",
  "recipe_type": "main",
  "brief_description": "A creamy blue cheese sauce tops tender beef tenderloin in this fantastic recipe that is simple enough for a weeknight meal yet fancy enough for guests.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place beef tenderloin in a shallow dish. Combine teriyaki sauce, wine, and garlic in a small bowl; pour over tenderloin. Let marinate in the refrigerator for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove tenderloin from marinade and place on a broiler pan. Discard marinade."
    },
    {
      "position": 4,
      "text": "Cook in the preheated oven for 15 minutes. Reduce heat to 375 degrees F (190 degrees C) and continue cooking to desired doneness, 30 to 40 more minutes. An instant-read thermometer inserted into the center of tenderloin should read at least 145 degrees F (63 degrees C) for medium doneness. Let tenderloin rest while you make sauce."
    },
    {
      "position": 5,
      "text": "Make sauce: Combine blue cheese, sour cream, mayonnaise, and Worcestershire sauce in a saucepan over low heat; stir until smooth."
    },
    {
      "position": 6,
      "text": "Serve sauce over sliced tenderloin."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,

  "id": "a5cc4d00-0e08-5e48-b14c-f749178e3d26",
  "slug": "tribeca-artichoke-dip",
  "name": "TriBeCa Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for a creamy and cheesy dip with jalapeno peppers and artichokes makes a great, easy appetizer.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix artichoke hearts, mayonnaise, mozzarella cheese, white onion, Parmesan cheese, jalapeno peppers, salt, and black pepper in a bowl; spread into a baking dish. Sprinkle paprika over the artichoke mixture."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until hot and beginning to set, about 25 minutes. Cool at least 15 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

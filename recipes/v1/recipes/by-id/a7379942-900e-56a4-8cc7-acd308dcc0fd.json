  "name": "Green Goddess Egg Salad Sandwiches",
  "recipe_type": "salad",
  "brief_description": "Green goddess dressing levels up basic egg salad. Hard-cook the eggs and prep the green goddess dressing ahea",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gently stir together chopped eggs, Green Goddess Dressing, and salt in a bowl until combined. (To store egg salad, chill, covered, up to 3 days.)"
    },
    {
      "position": 2,
      "text": "To serve, top 4 bread slices with lettuce leaves and egg salad."
    }
  ],

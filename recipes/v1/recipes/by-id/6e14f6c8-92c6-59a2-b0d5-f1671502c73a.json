  "id": "6e14f6c8-92c6-59a2-b0d5-f1671502c73a",
  "slug": "slow-cooker-filipino-chicken-adobo",
  "name": "Slow Cooker Filipino Chicken Adobo",
  "recipe_type": "main",
  "brief_description": "This flavorful chicken adobo is a Filipino favorite, made quickly and easily by using simple ingredients and a slow cooker.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken thighs, peppercorns, garlic, bay leaves, soy sauce, and vinegar into the bottom of a slow cooker in that order, making sure peppercorns and bay leaves are submerged into the liquid."
    },
    {
      "position": 2,
      "text": "Cover and cook on High until chicken thighs are no longer pink in the centers, about 5 hours. An instant-read thermometer inserted near the bone of a thigh should read 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 300,

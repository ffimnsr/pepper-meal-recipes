  "id": "e3db7c5a-28c3-588a-9142-0c53b9d78569",
  "slug": "bries-turkey-and-cranberry-dog-bones",
  "name": "Brie's Turkey and Cranberry Dog Bones",
  "recipe_type": null,
  "brief_description": "Every good doggie will love finding these holiday treats in his stocking or under the tree.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease baking sheets, or line them with parchment paper."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk the whole wheat flour and baking powder together until thoroughly combined, and stir in the cooked turkey meat and dried cranberries. Make a well in the center of the flour mixture, and drop the egg into the center; pour in the olive oil and about 1/2 cup of chicken broth. Mix into a soft dough. If mixture is too dry, mix in more chicken broth, about 1 tablespoon at a time, until dough is of desired consistency."
    },
    {
      "position": 3,
      "text": "Turn the dough out onto a floured work surface, and knead for 1 to 2 minutes. Roll the dough out 1/4 inch thick, and cut out with your favorite cookie cutters."
    },
    {
      "position": 4,
      "text": "Bake until the treats turn brown, about 25 minutes. Turn the oven off, and leave the dog treats in the oven an additional 30 minutes to dry out. Refrigerate leftover dog treats."
    }
  ],
  "servings": 45,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

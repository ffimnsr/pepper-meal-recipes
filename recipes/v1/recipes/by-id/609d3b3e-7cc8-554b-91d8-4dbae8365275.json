  "id": "609d3b3e-7cc8-554b-91d8-4dbae8365275",
  "slug": "bbq-pulled-pork-pizza",
  "name": "BBQ Pulled Pork Pizza",
  "recipe_type": "appetizer",
  "brief_description": "This easy appetizer pizza is a great way to use the leftovers from your slow cooker pulled pork. You can add any extra toppings to customize.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place pizza crust on a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine barbecue sauce and chipotle chili powder in a bowl; season with salt and black pepper. Spread over crust."
    },
    {
      "position": 3,
      "text": "Arrange pork, onion, and bell pepper on top sauce."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until toppings hot and crust crisp on bottom, 12 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "5ab49a4e-83ba-5889-8785-2a17e43c310d",
  "slug": "frijoles-refritos-refried-beans",
  "name": "Frijoles Refritos (Refried Beans)",
  "recipe_type": "side",
  "brief_description": "The secret to these frijoles refritos, or refried beans, is that they are slow cooked to perfection over six hours, then quickly fried in oil.",
  "cuisine": "Latin American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, pinto beans, and garlic in a large pot and cover. Cook over low heat for 5 1/2 hours. Stir in salt and continue cooking until beans are very soft, about 30 minutes more, adding more water if needed during the cook time to ensure the beans remain covered."
    },
    {
      "position": 2,
      "text": "Heat canola oil in a skillet over high heat. Spoon the beans into the skillet without draining excess water; mash beans using a potato masher until they begin to lose their shape, about 3 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 363,

  "id": "d9c7801a-a9d6-5e43-9138-a1d971fe0ee8",
  "slug": "cinnamon-chip-pumpkin-mini-muffins",
  "name": "Cinnamon Chip Pumpkin Mini Muffins",
  "recipe_type": "dessert",
  "brief_description": "You only need 3 ingredients to make these quick and easy pumpkin muffins studded with cinnamon chips, great as breakfast or dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a mini muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine cake mix, pumpkin pie mix, and cinnamon chips in a large bowl; mix well with a wooden spoon."
    },
    {
      "position": 3,
      "text": "Scoop mixture into muffin tin, filling each cup 3/4 of the way full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 17 to 20 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 17,
  "preparation_time_minutes": 10,

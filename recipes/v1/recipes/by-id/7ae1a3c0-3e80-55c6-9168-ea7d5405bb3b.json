  "id": "7ae1a3c0-3e80-55c6-9168-ea7d5405bb3b",
  "slug": "pattys-mashed-turnips",
  "name": "Patty's Mashed Turnips",
  "recipe_type": "side",
  "brief_description": "Buttery mashed turnips are a deliciously comforting side dish that make a tasty alternative to mashed potatoes for the Thanksgiving or holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add turnips and cook until very tender when pierced with a fork, 35 to 45 minutes. Drain well."
    },
    {
      "position": 3,
      "text": "Mash turnips with a potato masher in a large mixing bowl. Add butter and enough milk to reach desired creaminess."
    },
    {
      "position": 4,
      "text": "Mash to desired consistency and season with salt and black pepper; serve hot."
    }
  ],
  "servings": 9,

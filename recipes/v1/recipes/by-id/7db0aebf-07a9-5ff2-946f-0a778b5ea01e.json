  "id": "7db0aebf-07a9-5ff2-946f-0a778b5ea01e",
  "slug": "lumpia-filipino-shrimp-and-pork-egg-rolls",
  "name": "Lumpia - Filipino Shrimp and Pork Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Lumpia are Filipino-style egg rolls. This flavor-packed recipe stuffs them with pork, shrimp, and veggies. Serve them with sweet and sour dipping sauce.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground pork, shrimp, onion, carrots, green onions, soy sauce, MSG, salt, and black pepper in a bowl until well mixed."
    },
    {
      "position": 2,
      "text": "Place wrappers on a plate; cover with a damp cloth. Place 1 wrapper on a work surface; spoon ground pork filling in a thin line (the width of your little finger) across one side of wrapper, about 1/2 inch from edge. Roll wrapper tightly around filling; seal edges with egg white. Repeat with remaining wrappers, filling, and egg white."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep heavy pan or deep fryer to 375 degrees F (190 degrees C). Lower lumpia in batches of 3 to 4 carefully into the hot oil; fry, turning once, until rolls float and turn golden brown, about 3 minutes. Drain on paper towels, cut rolls into thirds, if desired. Repeat with remaining lumpia."
    }
  ],
  "servings": 75,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

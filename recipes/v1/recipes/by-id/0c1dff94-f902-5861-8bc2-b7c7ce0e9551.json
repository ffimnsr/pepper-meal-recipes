  "id": "0c1dff94-f902-5861-8bc2-b7c7ce0e9551",
  "slug": "gulab-jamun-or-kala-jam-waffle-balls",
  "name": "Gulab Jamun or Kala Jam (Waffle Balls)",
  "recipe_type": "dessert",
  "brief_description": "Gulab jamun are like deep-fried waffle balls soaked in a rosewater sugar syrup. They're a South Asian bite-size dessert popular on special days.",
  "cuisine": "Pakistani",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, sugar, cardamom, rose water, and saffron in a saucepan; bring to a boil. Reduce heat and simmer until consistency is syrupy, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Mix milk powder, flour, and baking soda in a bowl until well-combined. Slowly mix in butter and yogurt until dough comes together. Let gulab dough rest for 5 minutes. Shape into smooth balls the size of pennies."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Test the temperature of the oil by dropping in a small piece of dough. When it sits at the bottom of the pan for 1 minute before coming to the surface, the oil is ready."
    },
    {
      "position": 4,
      "text": "Fry 4 gulab balls at a time, stirring carefully, until dark golden brown on all sides, about 2 minutes. Drain on a paper-towel lined plate. Repeat with remaining gulab."
    },
    {
      "position": 5,
      "text": "Bring syrup back up to a boil and drop in fried gulab. Remove from heat and let them soak in the syrup, covered, 45 minutes to 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 17,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

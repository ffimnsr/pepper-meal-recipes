  "id": "e4a64c39-8a16-56a7-b11a-a0a051646d4a",
  "slug": "million-dollar-fudge",
  "name": "Million Dollar Fudge",
  "recipe_type": "dessert",
  "brief_description": "This classic million dollar fudge recipe makes an especially rich and creamy delicious chocolate fudge that melts in your mouth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter or line two 9-inch square baking pans with foil; set aside."
    },
    {
      "position": 2,
      "text": "Place chocolate chips, German chocolate, marshmallow creme, and nuts into a large mixing bowl; set aside."
    },
    {
      "position": 3,
      "text": "Combine sugar, salt, butter, and evaporated milk in a 4 quart saucepan; stir over low heat until sugar has dissolved completely and no granules are visible. Bring to a boil, and cook for 6 minutes."
    },
    {
      "position": 4,
      "text": "Pour hot fudge over ingredients in the mixing bowl, beat until all of the chocolate has melted. Pour into prepared pans. Let fudge cool before cutting, about 3 to 5 hours."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "b202818c-797a-58a7-a31c-0fba7893489e",
  "slug": "chef-johns-cheesy-crackers",
  "name": "Chef John's Cheesy Crackers",
  "recipe_type": "salad",
  "brief_description": "Make your own cheese crackers at home and enjoy their fresh, satisfying crunch on salads, in soup, or just as a snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Line a baking sheet with aluminum foil and lightly grease with vegetable oil."
    },
    {
      "position": 2,
      "text": "Place butter into a mixing bowl; add Cheddar cheese, Parmesan cheese, paprika, cayenne pepper, and salt. Mix together with the back of a spatula until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Mix flour into cheese mixture with a fork until crumbly. Sprinkle in cold water, 1 or 2 drops at a time, and mix with spatula until it comes together in a dough that holds its shape when squeezed."
    },
    {
      "position": 4,
      "text": "Transfer dough to a work surface and press into a thick, flattened disk. Wrap in plastic wrap and refrigerate 30 minutes."
    },
    {
      "position": 5,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Roll dough out on a floured work surface to about 1/8-inch thick. Use a pizza cutter to cut 1-inch wide strips from the dough. Cut strips crosswise into rectangles about 1 1/2-inches long."
    },
    {
      "position": 6,
      "text": "Use the back of a bamboo skewer to punch 5 small holes into each cracker. Arrange crackers onto prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until crackers are browned and crisp, about 15 minutes. Let stand about 3 minutes for crackers to cool and release from the foil. Let cool completely before serving."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

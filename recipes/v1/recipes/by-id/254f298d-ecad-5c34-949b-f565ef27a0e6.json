  "id": "254f298d-ecad-5c34-949b-f565ef27a0e6",
  "slug": "peruvian-pickled-onions-salsa-criolla",
  "name": "Peruvian Pickled Onions (Salsa Criolla)",
  "recipe_type": "drink",
  "brief_description": "This salsa criolla recipe combines red onions, cucumbers, tomato, and jalape\u00f1o pickled in lime juice and vinegar to make this classic Peruvian condiment.",
  "cuisine": "Peruvian South American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a bowl with water; stir in salt until dissolved. Add red onions; let soak for 10 minutes. Drain and pat dry."
    },
    {
      "position": 2,
      "text": "Mix onions, cucumbers, tomato, rice vinegar, lime juice, white wine vinegar, jalape\u00f1o pepper, cilantro, olive, and black pepper together in a large bowl. Cover with plastic wrap and let marinate at room temperature before serving, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

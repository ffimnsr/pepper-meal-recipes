  "id": "1328e4ab-8598-5c50-8b88-6a48cb6ded31",
  "slug": "teriyaki-marinade-and-sauce",
  "name": "Teriyaki Marinade and Sauce",
  "recipe_type": "side",
  "brief_description": "This teriyaki marinade is easily made on the stovetop with soy sauce, honey, vinegar, sesame oil, ginger, and garlic and doubles as a sauce.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "To make a marinade: Stir soy sauce, honey, rice vinegar, sesame oil, brown sugar, sesame seeds, garlic, and ginger together in a bowl until well combined."
    },
    {
      "position": 2,
      "text": "To make a sauce: Pour marinade mixture into a small saucepan and warm over medium-high heat. Whisk water and cornstarch together in a small bowl; add to marinade mixture. Bring to a boil, then reduce heat and simmer sauce, stirring frequently, until thickened, about 5 to 7 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

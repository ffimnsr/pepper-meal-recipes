  "id": "3509d3dc-d6b0-5ba7-a6ea-43dedb7c96aa",
  "slug": "wet-wet-wings-recipe-8786824",
  "name": "Wet Wet Wings",
  "recipe_type": "appetizer",
  "brief_description": "These wet wet wings are sure to be a crowd pleaser. Chicken wings and drummettes are air fried and tossed with sweet and spicy wet wet sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss wings in a bowl with oil, salt, and pepper. Transfer to the air fryer basket."
    },
    {
      "position": 2,
      "text": "Air fry the wings at 400 degrees F (200 degrees C) until cooked through and crisp, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "While wings cook, prepare the wet wet sauce and set aside."
    },
    {
      "position": 4,
      "text": "Pour wet wet sauce over wings and toss to until well coated with sauce. Sprinkle with green onions and sesame seeds if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

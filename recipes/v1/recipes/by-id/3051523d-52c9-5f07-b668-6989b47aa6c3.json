  "id": "3051523d-52c9-5f07-b668-6989b47aa6c3",
  "slug": "mexican-quinoa",
  "name": "Mexican Quinoa",
  "recipe_type": "side",
  "brief_description": "Use quinoa instead of rice to make a flavorful, spicy Mexican-style side dish that\u2019s light and healthy. It\u2019s perfect for the gluten-free diet.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir quinoa and onion in hot oil until onion is translucent, about 5 minutes. Add garlic and jalape\u00f1o pepper to quinoa mixture and cook until garlic is fragrant and slightly softened, 1 or 2 more minutes."
    },
    {
      "position": 2,
      "text": "Mix undrained can of diced tomatoes with green chile peppers, taco seasoning mix, and chicken broth into quinoa mixture. Bring to a boil, reduce heat to medium-low, and simmer until liquid has been absorbed, 15 to 20 minutes. Stir in cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

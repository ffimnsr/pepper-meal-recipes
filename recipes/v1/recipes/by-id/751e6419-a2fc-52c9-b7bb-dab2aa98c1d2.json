  "id": "751e6419-a2fc-52c9-b7bb-dab2aa98c1d2",
  "slug": "quick-banana-bread",
  "name": "Quick Banana Bread",
  "recipe_type": "breakfast",
  "brief_description": "Half the measuring is done for you because this recipe calls for a baking mix (e.g. Bisquick). Just add the moist ingredients and nuts, mix and bake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Generously grease the bottom of a 9 x 5 inch loaf pan."
    },
    {
      "position": 2,
      "text": "Measure oil, bananas, vanilla, eggs, baking mix, sugar, and nuts into a large bowl. Beat vigorously with a spoon for about 30 seconds. Pour the batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake until a wooden pick inserted in center comes out clean, about 55 to 65 minutes. Cool for 5 minutes in the pan. Loosen sides of loaf from the pan. Remove to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

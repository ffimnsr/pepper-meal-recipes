  "slug": "spinach-feta-crescent-rolls-recipe-11714771",
  "name": "Spinach Feta Crescent Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These stuffed crescent rolls, filled with fresh spinach and feta cheese, are quick and easy, have only 3 ingredients, and make a great breakfast or lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper and set aside."
    },
    {
      "position": 2,
      "text": "Unroll crescent rolls. Place 5 spinach leaves on dough, top with 1 tablespoon feta cheese and top again with 5 spinach leaves."
    },
    {
      "position": 3,
      "text": "Roll crescents up, starting with the widest side, tucking and pinching the ends. Place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 15 to 17 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

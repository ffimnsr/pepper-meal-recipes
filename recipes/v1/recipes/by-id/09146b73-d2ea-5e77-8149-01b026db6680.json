  "id": "09146b73-d2ea-5e77-8149-01b026db6680",
  "slug": "summery-lime-mango-shortcakes",
  "name": "Summery Lime-Mango Shortcakes",
  "recipe_type": "dessert",
  "brief_description": "This summery lime-mango shortcakes recipe is bursting with fruit and cream, providing a light and delicious filling for the freshly made shortcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine mangoes, strawberries, and blueberries in a large bowl; add honey and lime juice and toss gently. Cover the bowl; refrigerate filling."
    },
    {
      "position": 3,
      "text": "Sprinkle gelatin over water in a large heat-proof bowl; set aside until blooms, about 5 minutes. Place bowl over a pan of simmering water; stir often until dissolved. Transfer to a small bowl; refrigerate until cool, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Beat cream in a large bowl with an electric mixer until cream begins to thicken; add confectioners' sugar, coconut extract, and chilled gelatin. Whip until soft peaks form; cover the bowl and refrigerate whipped cream."
    },
    {
      "position": 5,
      "text": "Whisk flour, sugar, baking powder, lime zest, poppy seeds, and salt in a large bowl; cut in shortening with 2 knives or pastry blender until mixture resembles coarse crumbs. Beat buttermilk and egg together in a small bowl; stir into flour mixture until just moistened. Transfer dough to a floured work surface; knead until it comes together. Roll out to a \u00bd-inch thickness; cut shortcakes with a 3-inch round biscuit cutter. Place on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden, 15 to 18 minutes. Cool slightly; halve each cake horizontally."
    },
    {
      "position": 7,
      "text": "Spoon fruit filling on bottom halves of each cake. Spoon or pipe whipped cream over fruit; top with remaining biscuit halves."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 45,

  "id": "7c9bf69d-99e1-50c0-9adb-11a11e431dad",
  "slug": "ga-peach-pound-cake",
  "name": "Peach Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This buttery peach pound cake is easy to make with fresh, juicy peaches and easy baking ingredients for a delicious and welcome summer treat.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Butter a 10-inch tube pan and dust with white sugar."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a mixing bowl with an electric mixer until light and fluffy; add eggs, one at a time, beating well after each addition. Stir in vanilla."
    },
    {
      "position": 3,
      "text": "Sift 2 \u00be cups flour, baking powder, and salt together into a bowl; gradually stir flour mixture into butter mixture."
    },
    {
      "position": 4,
      "text": "Place remaining 1/4 cup flour into a small bowl. Add peaches and toss to coat, then fold floured peaches into batter. Spread batter evenly into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 70 minutes. Cool in the pan for 10 minutes, then invert onto a wire rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

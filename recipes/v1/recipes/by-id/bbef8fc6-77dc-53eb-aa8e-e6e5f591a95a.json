  "id": "bbef8fc6-77dc-53eb-aa8e-e6e5f591a95a",
  "slug": "classic-pub-style-nachos",
  "name": "Classic Pub Style Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Nachos baked with bubbling Cheddar cheese and fresh tomato salsa make a bright and colorful snack for a party or watching the game.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together the onion, tomatoes, parsley, olive oil, lime juice, salt and pepper in a bowl."
    },
    {
      "position": 3,
      "text": "Spread tortilla chips in a single layer onto a baking sheet, and spoon about 1 teaspoon of the tomato salsa onto each chip. Spread 1 cup of Cheddar cheese over the nachos, top the chips with another teaspoon or so of salsa, and top with the remaining 1 cup of cheese."
    },
    {
      "position": 4,
      "text": "Bake the nachos in the preheated oven until the cheese is bubbling, about 5 minutes. Serve hot with sour cream, guacamole, and any remaining salsa on the side for dipping the chips."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "e045f2b3-6cc9-5c5f-ae7a-f7a768477867",
  "slug": "butter-pecan-fudge",
  "name": "Butter Pecan Fudge",
  "recipe_type": "dessert",
  "brief_description": "Creamy butter pecan fudge comes together in a snap in this classic candy recipe, perfect for an indulgent food or hostess gift.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Butter an 8-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Combine butter, brown sugar, white sugar, and salt in a saucepan; pour in cream. Bring to a boil, stirring until butter melts and sugar is dissolved. Let mixture boil, stirring often, for 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove saucepan from heat; add vanilla extract and mix well. Stir in confectioners' sugar until smooth. Fold pecans into fudge."
    },
    {
      "position": 4,
      "text": "Pour fudge into prepared pan and cool until firm, 1 to 2 hours. Cut into 1-inch squares."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

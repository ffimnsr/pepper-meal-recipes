  "id": "5b1aeb3d-e2d1-551b-b16d-45fd39505472",
  "slug": "sangria-sangria",
  "name": "Sangria! Sangria!",
  "recipe_type": "drink",
  "brief_description": "This sangria recipe is easy to make with Spanish red wine, orange juice, brandy, and freshly chopped fruit for a super refreshing summer party drink.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix red wine, brandy, triple sec, lemonade concentrate, orange juice, lemon juice, and sugar together in a bowl. Add orange, lemon and lime slices, and maraschino cherries."
    },
    {
      "position": 3,
      "text": "Serve immediately over ice, or refrigerate 8 hours to overnight for best flavor. For a fizzy sangria, add club soda just before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

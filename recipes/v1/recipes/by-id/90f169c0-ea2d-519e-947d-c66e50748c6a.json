  "schema_version": 1,
  "id": "90f169c0-ea2d-519e-947d-c66e50748c6a",
  "slug": "turkey-swedish-meatballs",
  "name": "Turkey Swedish Meatballs",
  "recipe_type": "main",
  "brief_description": "This turkey Swedish meatballs recipe uses lean ground turkey and light sour cream in the smooth, savory gravy, for a lighter alternative to the original.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a small skillet over medium heat. Add onion and garlic; cook and stir until softened, about 5 minutes. Cool briefly, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine onion mixture, ground turkey, bread crumbs, egg, 1 tablespoon Worcestershire sauce, 1\u00bd teaspoons parsley, allspice, and nutmeg in a large bowl; mix well. Form mixture into 1-inch meatballs; transfer to the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until meatballs are cooked through, 25 to 30 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Combine beef broth and flour in a jar with a tight-fitting lid; seal and shake vigorously until flour is dissolved. Pour broth slurry into a large skillet over medium-high heat. Add 1 tablespoon Worcestershire sauce, 1\u00bd teaspoons parsley, black pepper, and salt; bring to a boil, stirring frequently. Reduce heat to medium; simmer, stirring occasionally, until thickened, 2 to 3 minutes. Reduce heat to medium-low; stir in sour cream."
    },
    {
      "position": 6,
      "text": "Add meatballs to sauce; cover. Simmer, stirring occasionally, until flavors combine, 10 to 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

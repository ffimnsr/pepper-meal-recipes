  "slug": "mini-asian-crunch-chicken-wraps-recipe-11951616",
  "name": "Mini Crunchy Chicken Wraps",
  "recipe_type": "appetizer",
  "brief_description": "These Asian-inspired crunchy mini chicken wraps feature coleslaw mix and breaded chicken tenders, dressed with stir fry sauce and rolled in a flour tortilla.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice prepared chicken tenders into 1 1/2-inch strips. Set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl combine slaw mix, green onions, cilantro, stir fry sauce and peanuts and toss until the slaw mix is well coated."
    },
    {
      "position": 3,
      "text": "Place one tortilla on a work surface and place a few strips of chicken in the center and top with slaw mix. Fold the ends of the tortilla towards the center and roll. Repeat with the remaining tortillas."
    },
    {
      "position": 4,
      "text": "Cut each wrap in half, securing with a toothpick if needed and place on a platter ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

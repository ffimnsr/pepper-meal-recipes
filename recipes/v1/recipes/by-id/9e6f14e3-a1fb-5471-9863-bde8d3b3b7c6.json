  "slug": "easy-deviled-egg-potato-salad-recipe-8600528",
  "name": "Easy Deviled Egg Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This easy deviled egg potato salad is a simple recipe that brings egg salad and potato salad flavors together in one tasty dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes. Drain. When potatoes are cool enough to handle, peel and cut into 1/2-inch cubes."
    },
    {
      "position": 2,
      "text": "Add potatoes, eggs, mayo, mustard, onion and celery to a bowl and stir until well combined. Chill at least 1 hour prior to serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

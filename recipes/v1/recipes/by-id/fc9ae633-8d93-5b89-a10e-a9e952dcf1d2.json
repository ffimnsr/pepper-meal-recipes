  "id": "fc9ae633-8d93-5b89-a10e-a9e952dcf1d2",
  "slug": "cheese-straws",
  "name": "Cheese Straws",
  "recipe_type": "appetizer",
  "brief_description": "These cheese straws are easy to make for buttery, crisp pastries packed with sharp Cheddar flavor\u2014perfect for a holiday appetizer or party snack.",
  "cuisine": "British Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line baking sheets with parchment paper or lightly grease them."
    },
    {
      "position": 2,
      "text": "Beat butter and Cheddar cheese together in a large bowl with an electric mixer until creamy and well blended. Add flour and salt; mix until a soft dough forms. If the dough seems too crumbly, add milk, 1 teaspoon at a time, until it just comes together."
    },
    {
      "position": 3,
      "text": "Transfer the dough to a lightly floured surface. Roll out to \u00bd inch thickness. Cut into 2-inch strips using a knife, pastry wheel, or cookie press with a star tip for a traditional look."
    },
    {
      "position": 4,
      "text": "Arrange cheese straws 1 \u00bd inches apart on the prepared baking sheets; sprinkle with ground red pepper if using."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and crisp, about 10 to 15 minutes. Cool on the baking sheets for 5 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

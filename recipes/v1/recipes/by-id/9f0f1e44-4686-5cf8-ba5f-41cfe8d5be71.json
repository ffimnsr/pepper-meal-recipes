  "id": "9f0f1e44-4686-5cf8-ba5f-41cfe8d5be71",
  "slug": "chicken-noodle-soup-iii",
  "name": "Chicken Noodle Soup III",
  "recipe_type": "soup",
  "brief_description": "Egg noodles are topped with shredded chicken and bean sprouts, bathed in hot chicken broth, drizzled with thinly sliced shallots cooked in oil and topped with green onion in this quick Asian soup.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "In a small skillet over medium heat, cook shallots in oil until brown and fragrant. Remove from heat and set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Cook noodles in boiling water until just tender, 8 to 10 minutes; drain and rinse under cold water. Set aside."
    },
    {
      "position": 3,
      "text": "Bring a small pot of water to a boil; have ready a bowl of ice water. Blanch bean sprouts by plunging them into boiling water for 1 minute, then into cold water. Drain and set aside."
    },
    {
      "position": 4,
      "text": "In a large saucepan over medium heat, bring chicken broth to a simmer."
    },
    {
      "position": 5,
      "text": "Divide noodles evenly between 6 bowls. Top with bean sprouts and shredded chicken. Pour the heated broth into the bowls. Drizzle with the shallot mixture and garnish with the green onion. Season with salt and pepper. Serve at once."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

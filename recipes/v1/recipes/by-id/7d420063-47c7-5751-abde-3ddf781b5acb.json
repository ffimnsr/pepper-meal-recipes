  "id": "7d420063-47c7-5751-abde-3ddf781b5acb",
  "slug": "cheeseburger-chowder",
  "name": "Cheeseburger Chowder",
  "recipe_type": "soup",
  "brief_description": "Hamburger meat, processed cheese, onion, potatoes, and milk come together in this hearty cheeseburger chowder recipe that the whole family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large pot or Dutch oven over medium-high heat. Add beef; cook and stir beef until browned and crumbly, 5 to 7 minutes. Drain; discard grease. Stir diced potatoes and onion into beef; cook and stir until onion is tender, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir milk, processed cheese food, and Cheddar cheese into beef mixture; bring to a boil. Reduce heat; simmer, stirring often, until heated through and cheese is melted, 15 to 20 minutes. Season with black pepper."
    },
    {
      "position": 3,
      "text": "Stir in mashed potatoes; cook until heated through and thickened, about 5 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

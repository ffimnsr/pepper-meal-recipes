  "id": "155d5adb-a084-5d37-b17a-ba2488392e37",
  "slug": "lamb-meatballs",
  "name": "Lamb Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "This is a great alternative to regular meatballs. I have served these many times at cocktail parties, and they have always been a hit! The sauce adds a nice touch, but I have also served them with Greek marinade and plain.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt the 1 tablespoon butter in a skillet over medium heat. Cook and stir the shallots in the skillet until tender. Transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Mix lamb, bread crumbs, parsley, egg, and lemon zest into the bowl with the shallots. Season with marjoram, salt, and pepper. Let stand 1 hour in the refrigerator."
    },
    {
      "position": 3,
      "text": "Melt 1/2 cup butter and heat olive oil in a skillet over medium-high heat. Form the lamb mixture into small meatballs, and cook in the skillet in batches until evenly brown. Do not drain skillet. Drain meatballs on paper towels, and place in a serving dish."
    },
    {
      "position": 4,
      "text": "Mix tomato sauce, wine, garlic, and cinnamon into the skillet. Cook and stir until well blended and heated through. Drizzle over the meatballs in the dish. Serve with toothpicks."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

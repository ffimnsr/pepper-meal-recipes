  "id": "b755b45a-8a78-589b-91ee-f95dcf1c3e7d",
  "slug": "easy-lasagna-cups-recipe-8584174",
  "name": "Easy Lasagna Cups",
  "recipe_type": "appetizer",
  "brief_description": "These easy lasagna cups taste like the crunchy delicious edges of a lasagna. Made with inside-out pasta shells, filled with meat sauce and cheese, they're a terrific 2-bite lasagna appetizer.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a mini muffin pan."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil over high heat."
    },
    {
      "position": 3,
      "text": "Heat a large deep skillet over medium-high heat. Add ground beef and cook, crumbling with a spoon, until browned, 5 to 7 minutes; drain any excess grease. Add onion and cook until softened, 3 to 4 minutes. Stir in marinara, 1 teaspoon salt, pepper, garlic powder, and Italian seasoning. Bring to a simmer, reduce heat, and cook for 20 minutes, stirring often."
    },
    {
      "position": 4,
      "text": "Add remaining 3 teaspoons salt and pasta to boiling water and cook, stirring occasionally, until tender, 10 to 12 minutes. Drain, rinse with cold water, and drain well."
    },
    {
      "position": 5,
      "text": "Turn pasta shells inside out and place 24 shells into the prepared muffin pan. Save any broken or remaining shells for another use."
    },
    {
      "position": 6,
      "text": "Fill each shell with about 2 teaspoons ricotta and sprinkle 1/4 cup Parmesan cheese evenly over the ricotta. Top with about 1 tablespoon meat sauce and top evenly with mozzarella and remaining Parmesan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until slightly golden around the edges and bubbly inside, about 15 minutes. Let stand for 10 minutes before serving. Sprinkle with parsley if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

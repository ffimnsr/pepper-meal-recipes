  "id": "762d9932-5c21-50ac-a7e4-d4e7cf1f969c",
  "slug": "easy-one-pan-caesar-chicken-bake-recipe-11861679",
  "name": "Easy One Pan Caesar Chicken Bake",
  "recipe_type": "main",
  "brief_description": "This one pan Caesar chicken bake is so easy, with only 5 ingredients, and so delicious drizzled with sauce from the pan and served over rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place chicken breasts in baking dish and sprinkle with salt and pepper. Spread Caesar dressing evenly over chicken and top with cheese slices."
    },
    {
      "position": 3,
      "text": "Crush croutons into coarse crumbs and toss with melted butter until well coated. Spread evenly over casserole."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is browned and bubbly, chicken is no longer pink at the center, and the juices run clear, 25 to 30 minutes. An instant read thermometer inserted near the center should read 165 degrees F (74 degrees C). Let stand 5 minutes."
    },
    {
      "position": 5,
      "text": "Drizzle with sauce from the pan to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

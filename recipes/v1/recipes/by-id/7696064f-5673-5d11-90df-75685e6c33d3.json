  "id": "7696064f-5673-5d11-90df-75685e6c33d3",
  "slug": "bang-bang-chicken-noodle-bowls-recipe-12031915",
  "name": "Bang Bang Chicken Noodle Bowls",
  "recipe_type": "dessert",
  "brief_description": "These bang bang chicken noodle bowls layer rice noodles with crisp cabbage, carrots, creamy avocado, and tender air-fried chicken. A sweet and spicy bang bang sauce pulls everything together for a fresh, flavor-packed meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For bang bang sauce, whisk together mayonnaise, sweet chili sauce, and Sriracha in a large bowl until smooth. Transfer 1/2 cup sauce to a large bowl for the chicken. Reserve the remaining sauce for serving."
    },
    {
      "position": 2,
      "text": "Cook rice noodles according to package directions. Drain and toss warm noodles with carrots, lime juice, and sesame oil in a large bowl until evenly coated."
    },
    {
      "position": 3,
      "text": "Divide cooked noodle mixture evenly among 4 serving bowls. Top with cabbage and avocado. Set aside while preparing the chicken."
    },
    {
      "position": 4,
      "text": "Place flour in a medium bowl. Add chicken and toss to coat."
    },
    {
      "position": 5,
      "text": "Transfer floured chicken to the large bowl containing the reserved 1/2 cup sauce; toss until evenly coated."
    },
    {
      "position": 6,
      "text": "Place panko in a shallow bowl. Working in batches, coat chicken pieces evenly in panko, placing coated chicken on a tray."
    },
    {
      "position": 7,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Working in batches, arrange chicken in the basket in a single layer. Cook until golden brown and an instant-read thermometer inserted into the center reads 165 degrees F (74 degrees C), 5 to 10 minutes. Repeat with remaining chicken. Sprinkle with salt."
    },
    {
      "position": 8,
      "text": "Top noodle bowls with chicken and green onions. Serve with reserved sauce. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

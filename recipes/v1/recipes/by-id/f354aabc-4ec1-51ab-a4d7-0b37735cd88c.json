  "id": "f354aabc-4ec1-51ab-a4d7-0b37735cd88c",
  "slug": "kendras-maid-rite-sandwiches",
  "name": "Kendra's Maid-Rite Sandwiches",
  "recipe_type": "main",
  "brief_description": "Brown sugar, mustard, and Worcestershire sauce flavor this Midwestern icon.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat and stir in the ground beef and onion. Cook and stir until the beef is crumbly, evenly browned, and no longer pink. Drain and discard any excess grease. Stir in the ketchup, brown sugar, vinegar, Worcestershire sauce, mustard, and salt. Bring to a simmer, then reduce heat to medium-low, cover, and simmer 20 minutes longer. Serve on warmed buns."
    }
  ],

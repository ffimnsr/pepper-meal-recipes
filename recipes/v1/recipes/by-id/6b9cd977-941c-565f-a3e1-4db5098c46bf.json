  "id": "6b9cd977-941c-565f-a3e1-4db5098c46bf",
  "slug": "hawaiian-pork-hash",
  "name": "Hawaiian Pork Hash",
  "recipe_type": "main",
  "brief_description": "Very popular Hawaiian pupu - you can even get pork hash at the 7-11 here. My recipe is better - it includes shrimp!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix together the ground pork, shrimp, egg white, water chestnuts, green onion, cornstarch, soy sauce, sugar, garlic, oyster sauce, salt, pepper, and sesame oil."
    },
    {
      "position": 2,
      "text": "Place about 1 tablespoon of this filling onto the center of each dumpling wrapper, and bring the sides up to the top. Do not seal the top, as these dumplings are left open. Place dumplings in a steamer."
    },
    {
      "position": 3,
      "text": "Set the steamer basket over a pan or wok of boiling water. Steam for 30 minutes."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "8038fafe-d61c-59f0-8b9c-a1410bc1fc23",
  "slug": "hatch-chile-relleno-casserole-with-ranchero-sauce",
  "name": "Hatch Chile Relleno Casserole with Ranchero Sauce",
  "recipe_type": "main",
  "brief_description": "Hatch chiles are New Mexico's gift to the world. Here are layers of Hatch chiles and melted cheese wrapped up in a coat of puffy egg and then baked instead of fried.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Place egg whites in a bowl and beat until stiff. Gently fold in evaporated milk, flour, and salt. Cover bottom of baking dish with 1/2 the egg white mixture. Place chiles flat over egg whites. Sprinkle Oaxaca cheese over chiles. Top with remaining chiles and egg white mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until eggs are set, about 30 minutes."
    },
    {
      "position": 4,
      "text": "While casserole bakes, heat oil in a medium saucepan over medium-high heat. Saute onion and garlic for 2 minutes. Add chile powder, salt, and cumin. Cook and stir for another minute. Add bell peppers and cook until soft, 3 to 5 minutes. Add flour and stir for 2 minutes. Slowly add broth, stirring to avoid lumps. Bring to a boil; reduce heat to low and simmer until casserole is ready."
    },
    {
      "position": 5,
      "text": "Serve the sauce with slices of the chile relleno casserole."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "832cfa8a-d5d3-5115-a33c-70cdc20a5c8a",
  "slug": "spicy-shrimp-and-grits",
  "name": "Spicy Shrimp and Grits",
  "recipe_type": "side",
  "brief_description": "This spicy shrimp and grits recipe includes green bell pepper, green onions, diced tomatoes with green chiles, Cheddar cheese, and Monterey Jack cheese.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring chicken broth and salt to a boil in a large saucepan over high heat. Stir in grits, return to a simmer, then reduce heat to medium-low; continue cooking for 20 minutes, stirring frequently."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt margarine in a skillet over medium heat. Stir in green onions, bell pepper, and garlic; cook until peppers have softened, about 5 minutes. Stir in shrimp; cook until they begin to firm."
    },
    {
      "position": 4,
      "text": "Stir shrimp mixture, tomatoes, Monterey Jack cheese, \u00be cup Cheddar cheese, and black pepper into grits; pour into the prepared baking dish. Sprinkle with remaining \u00bc cup Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is bubbly and beginning to brown, 30 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "89f22c1b-8d25-5f78-9a8a-c315ac0def75",
  "slug": "baked-asiago-chicken-and-mushrooms-recipe-11829874",
  "name": "Baked Asiago Chicken and Mushrooms",
  "recipe_type": "main",
  "brief_description": "In this baked asiago chicken and mushrooms, chicken breasts benefit from a dry brining step, and stay juicy and delicious after baking. Made in a single skillet in a creamy, cheesy mushroom sauce, there's minimal prep and almost no cleanup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken breasts on a plate; salt liberally on both sides. Cover loosely with plastic wrap and refrigerate for 1 hour."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium-high heat. Add chicken; cook, turning once, until golden brown on both sides, about 8 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Stir soup, sour cream, mushrooms, and garlic powder together in a bowl. Stir in half the cheese."
    },
    {
      "position": 5,
      "text": "Spread about half the mixture in the bottom of a casserole dish. Lay chicken breasts on top of cream mixture. Spread remaining cream mixture evenly over chicken. Cover with foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 30 minutes. Uncover and sprinkle with remaining cheese. Bake until casserole is golden brown and bubbly and chicken is no longer pink at the center, about 10 minutes more. An instant-read thermometer inserted near the center of chicken should read 165 degrees F (74 degrees C) Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

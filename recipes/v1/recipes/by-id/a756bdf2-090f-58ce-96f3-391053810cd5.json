  "id": "a756bdf2-090f-58ce-96f3-391053810cd5",
  "slug": "fried-rice-with-cilantro",
  "name": "Fried Rice with Cilantro",
  "recipe_type": "main",
  "brief_description": "This cilantro fried rice recipe combines either chicken, pork, bacon, or seafood, like calamari and prawns, and adds in green onion and cilantro.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a wok or large skillet, over medium-high heat. Fry garlic until golden then add chile pepper and chicken meat, and stir-fry until cooked through."
    },
    {
      "position": 2,
      "text": "When chicken is cooked, add rice, sugar, fish sauce, and soy sauce. Cook over medium heat, stirring gently. When mixture is well blended, stir in green onions, basil, and cilantro. Cook for 1 more minute, then serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

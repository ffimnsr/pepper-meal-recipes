  "id": "4631a757-7f84-5e41-ae94-08ba4b700d8a",
  "slug": "topless-blueberry-pie",
  "name": "Topless Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy blueberry pie recipe is made with a pre-baked crust. With only a short time required at the stove, this no-bake pie is perfect for summer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar, cornstarch, and salt in a saucepan. Stir in water and 1 cup blueberries. Cook and stir over medium heat until thick, 8 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Remove from the heat, stir in butter, and let cool for 5 minutes. Stir in remaining 3 cups blueberries."
    },
    {
      "position": 3,
      "text": "Pour blueberries into baked pie shell. Cool in the refrigerator for 2 to 4 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

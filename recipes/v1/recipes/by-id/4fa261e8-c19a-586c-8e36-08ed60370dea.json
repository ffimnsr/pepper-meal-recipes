  "id": "4fa261e8-c19a-586c-8e36-08ed60370dea",
  "slug": "homemade-cereal",
  "name": "Homemade Cereal",
  "recipe_type": "breakfast",
  "brief_description": "Learn how to make your own cereal at home with oats, wheat germ, wheat brain, dried fruit and nuts, honey, and the perfect amount of spices!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix oats, wheat germ, and wheat bran together in a large bowl."
    },
    {
      "position": 3,
      "text": "Stir brown sugar, vegetable oil, honey, and water together in another bowl until blended. Mix in vanilla, cinnamon, nutmeg, and salt. Pour brown sugar mixture into oat mixture and stir until evenly moist. Transfer to a large, shallow baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, stirring every 15 minutes, until lightly browned, about 45 minutes. Add dates, pecans, and coconut to the baking dish and stir to combine. Continue to bake for about 15 more minutes. Remove from the oven and cool to room temperature."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

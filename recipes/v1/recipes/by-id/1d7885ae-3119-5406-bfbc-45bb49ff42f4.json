  "slug": "artichoke-spread",
  "name": "Artichoke Spread",
  "recipe_type": "appetizer",
  "brief_description": "A yummy hot artichoke spread that\u2019s perfect for company and is always a favorite. Serve this creamy, cheesy dip with bread, crackers, or veggies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place artichoke hearts in a food processor and process until smooth. Process cream cheese, Parmesan cheese, mayonnaise, garlic, and dill with artichoke hearts until the mixture is smooth and well blended. Transfer to a 9-inch pie pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbly and lightly brown, 10 to 15 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "1e663186-6cb6-58ac-a642-ed5e118136da",
  "slug": "chicken-florentine-meatballs-recipe-8788437",
  "name": "Chicken Florentine Meatballs",
  "recipe_type": "main",
  "brief_description": "For these chicken Florentine meatballs, baked ground chicken meatballs flavored with spinach and onion are bathed in a creamy garlic-Parmesan white wine and cream sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 10x15-inch baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "For meatballs, heat oil in a large skillet over medium heat. Cook onion and garlic until tender, about 3 minutes. Add chopped spinach and cook until just wilted, about 2 minutes. Set aside to cool."
    },
    {
      "position": 4,
      "text": "Combine ground chicken, panko, cornstarch, Italian seasoning, salt, and crushed red pepper in a large bowl. Gently stir in cooled onion mixture."
    },
    {
      "position": 5,
      "text": "Shape mixture into about 20 meatballs using about 1 1/2 tablespoons per meatball. Place on prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake until an instant read thermometer inserted in the center of meatballs reaches 165 degrees F (74 degrees C), 20 to 25 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile for sauce, heat butter in the same skillet. Add garlic and cook until fragrant, about 1 minute. Add flour and cook 1 additional minute. Add wine and chicken broth. Simmer and stir until thickened and bubbly, 1 to 2 minutes. Stir in cream and Parmesan cheese. Cook until slightly thickened, 2 minutes. Add spinach and cook until just wilted, about 2 minutes. Season with salt and pepper."
    },
    {
      "position": 8,
      "text": "Add meatballs to skillet, stir to coat in sauce. Return to a simmer, about 1 minute."
    },
    {
      "position": 9,
      "text": "Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

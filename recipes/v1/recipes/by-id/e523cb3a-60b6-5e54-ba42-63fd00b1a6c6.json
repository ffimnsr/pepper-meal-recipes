  "id": "e523cb3a-60b6-5e54-ba42-63fd00b1a6c6",
  "slug": "turkey-pot-pie-i",
  "name": "Homemade Turkey Pot Pie",
  "recipe_type": "main",
  "brief_description": "This homemade turkey pot pie, filled with leftover turkey and vegetables in a creamy herb sauce, is baked until golden, bubbling, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Roll out bottom pie crust, press into a 10 inch pie pan, and set aside."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium heat; add onion, celery, carrots, parsley, oregano, salt, and pepper. Cook and stir until vegetables are soft. Stir in bouillon and water. Bring mixture to a boil. Stir in potatoes, and cook until tender but still firm."
    },
    {
      "position": 3,
      "text": "Melt remaining 2 tablespoons butter in a medium saucepan; stir in turkey and flour. Add milk, and stir until heated through. Stir turkey mixture into vegetable mixture, and cook until thickened. Cool slightly, then pour mixture into unbaked pie shell. Roll out top crust, and place on top of filling. Flute edges, and make 4 slits in the top crust to let out steam."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C), and continue baking for 20 minutes, or until crust is golden brown and filling is bubbling."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b2f082bd-77f3-5b7e-826d-0f2aa65dd702",
  "slug": "korean-style-cream-cheese-garlic-bread",
  "name": "Korean-Style Cream Cheese Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This Korean-style bread from Chef John combines rich cream cheese filling, buttery garlic coating, and soft rolls for an irresistible savory treat.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine warm water, yeast, sugar, and 1 cup flour in a bowl. Let rest until foamy and bubbly, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Add remaining 2 cups flour and salt to the bubbly yeast mixture. Beat with an electric mixer fitted with a dough hook until dough is fairly smooth, elastic, and tacky but not sticky, about 5 minutes. Feel free to add more flour if dough is too sticky."
    },
    {
      "position": 4,
      "text": "Knead dough briefly before transferring to a lightly greased bowl."
    },
    {
      "position": 5,
      "text": "Cover and let rise until doubled in size, about 2 hours. At the 30-minute and 60-minute marks, uncover and fold dough with wet fingers 5 to 6 times to develop gluten structure."
    },
    {
      "position": 6,
      "text": "Transfer to a work surface and press flat, squeezing out excess air. Divide with a bench scraper into 6 equal portions. Roll each portion into a smooth ball."
    },
    {
      "position": 7,
      "text": "Transfer rolled dough balls onto a Silpat\u00ae-lined baking sheet and press down gently. Dust lightly with remaining flour."
    },
    {
      "position": 8,
      "text": "Cover with a clean kitchen towel and let rise for 30 minutes. Meanwhile, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 9,
      "text": "Bake rolls in the center of the preheated oven until lightly browned, 20 to 25 minutes. Transfer to a cooling rack and let cool to room temperature, about 30 minutes. Increase the oven temperature to 425 degrees F (220 degrees C)."
    },
    {
      "position": 10,
      "text": "While rolls cool, make cream cheese filling. Mix cream cheese, sugar, salt, black pepper, cayenne, parsley, green onions, and heavy cream together with a spatula until combined."
    },
    {
      "position": 11,
      "text": "Mix melted butter, garlic, salt, parsley, and egg together for coating with a whisk until combined."
    },
    {
      "position": 12,
      "text": "Transfer cooled rolls back onto the lined baking sheet. Use a sharp knife to make 6 cuts on each roll, about 90% of the way through."
    },
    {
      "position": 13,
      "text": "Dip the cut rolls into the garlic butter and coat in between the slits using your hands or a pastry brush."
    },
    {
      "position": 14,
      "text": "Pipe or spread 1/6 of the cream cheese mixture into each of the 6 rolls. Coat each once more in the garlic butter mixture. Top with Parmigiano-Reggiano cheese."
    },
    {
      "position": 15,
      "text": "Bake in the center of the preheated oven until beautifully browned, 15 to 20 minutes. Let cool slightly before serving."
    },
    {
      "position": 16,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,

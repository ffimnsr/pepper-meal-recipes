  "id": "fd927743-5726-5c43-982a-545211f1904d",
  "slug": "caprese-panini",
  "name": "Caprese Panini",
  "recipe_type": "main",
  "brief_description": "Enjoy the traditional caprese combination of mozzarella, tomato, and basil in sandwich form with this easy sourdough panini.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a nonstick skillet over medium-high heat. Add tomato, capers, and pepper flakes; saute until tomatoes just start to break down, about 3 minutes. Remove from the heat and stir in vinegar."
    },
    {
      "position": 2,
      "text": "Brush one side of each bread slice with remaining oil. Spread the other sides with pesto. Place 2 slices of bread, pesto sides up, on a work surface. Layer with mozzarella cheese and then tomato mixture. Sprinkle with salt and pepper and top with remaining bread, oiled sides up."
    },
    {
      "position": 3,
      "text": "Toast sandwiches in a large skillet over medium heat until golden, 5 to 7 minutes per side. Use a heavy skillet on top of the sandwiches to weigh them down as they cook."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e30975ee-b69a-5afd-ae37-bff64da66304",
  "slug": "garys-stuffed-mushrooms",
  "name": "Gary\u2019s Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Dry stuffing mix is the key to these wonderful stuffed mushrooms!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange mushroom caps on a medium baking sheet, bottoms up. Chop and reserve mushroom stems."
    },
    {
      "position": 2,
      "text": "Prepare chicken flavored dry stuffing mix according to package directions."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "In a medium saucepan over medium heat, melt butter. Mix in garlic and cook until tender, about 5 minutes."
    },
    {
      "position": 5,
      "text": "In a medium bowl, mix together reserved mushroom stems, prepared dry stuffing mix, cream cheese and imitation crabmeat. Liberally stuff mushrooms with the mixture. Drizzle with the butter and garlic. Season with salt, pepper, garlic powder and crushed red pepper."
    },
    {
      "position": 6,
      "text": "Bake uncovered in the preheated oven 10 to 12 minutes, or until stuffing is lightly browned."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,

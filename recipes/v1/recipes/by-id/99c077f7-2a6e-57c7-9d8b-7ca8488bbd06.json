  "id": "99c077f7-2a6e-57c7-9d8b-7ca8488bbd06",
  "slug": "pineapple-pound-cake",
  "name": "Pineapple Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "A pound cake made with pineapple and glazed with pineapple sauce. Unlike most cakes, you will not preheat the oven on this one.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease and flour a 10 inch tube pan. Sift together the flour, and baking powder. Set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the shortening, 1 cup butter and sugar until light and fluffy. Add the eggs one at a time, beating well with each addition, then stir in the vanilla. Add the flour mixture alternately with milk; beat well. Stir in the 3/4 cup crushed pineapple."
    },
    {
      "position": 3,
      "text": "Pour into 10 inch tube pan. Place in cold oven. Turn oven to 325 degrees F (175 degrees C) and bake for 90 minutes or until top springs back when touched. Remove from oven and let stand for 10 minutes. Remove carefully from pan."
    },
    {
      "position": 4,
      "text": "To make the glaze: In a small saucepan, combine 1/4 cup butter, confectioners sugar and 1 cup crushed pineapple. heat and stir until melted. Pour over cake as soon as it comes out of the pan."
    }
  ],
  "servings": 14,

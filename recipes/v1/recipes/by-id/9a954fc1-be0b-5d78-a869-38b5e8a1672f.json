  "id": "9a954fc1-be0b-5d78-a869-38b5e8a1672f",
  "slug": "grilled-teriyaki-salmon",
  "name": "Grilled Teriyaki Salmon",
  "recipe_type": "drink",
  "brief_description": "This grilled teriyaki salmon features a marinade of apple juice and garlic that's cooked down to a rich, tasty sauce to drizzle over the cooked fish.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together teriyaki sauce, apple juice, brown sugar, vinegar, garlic, and pepper in a small bowl until marinade is well combined."
    },
    {
      "position": 2,
      "text": "Place salmon fillets in a glass baking dish. Pour marinade over fillets; cover and refrigerate for 4 to 6 hours."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove fillets from marinade and shake off excess. Pour marinade into a small saucepan and bring to a boil. Reduce heat to medium-low and simmer until reduced, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, cook fillets on the preheated grill until fish flakes easily with a fork, 3 to 4 minutes per side."
    },
    {
      "position": 6,
      "text": "Serve fillets with reduced marinade drizzled over the top."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "58bcaea1-5b5e-5a9e-9862-3b2130ba16a4",
  "slug": "chicken-and-rice-casserole-i",
  "name": "Chicken and Rice Casserole I",
  "recipe_type": "main",
  "brief_description": "Still quite convenient, this version incorporates onion flavoring with rice, mushrooms and your choice of chicken pieces.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl mix the rice, dry onion soup mix, cream of mushroom soup, mushroom pieces and milk."
    },
    {
      "position": 3,
      "text": "Place the chicken pieces in a 9x13 inch baking dish and pour the mushroom mixture over the chicken. Cover and bake in the preheated oven for 1 hour. Uncover and bake for 15 more minutes."
    }
  ],

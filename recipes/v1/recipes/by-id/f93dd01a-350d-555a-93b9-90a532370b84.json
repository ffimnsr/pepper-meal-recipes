  "id": "f93dd01a-350d-555a-93b9-90a532370b84",
  "slug": "make-ahead-french-toast",
  "name": "Make Ahead French Toast",
  "recipe_type": "breakfast",
  "brief_description": "We have made this French Toast for Christmas brunch for twenty four years! It originally came from the East Coast. If you like your French toast firmer, then cut back on the milk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, whisk together eggs, milk, cream and vanilla."
    },
    {
      "position": 2,
      "text": "Dip bread slices into egg mixture and place in a lightly greased 9x13 inch baking pan. Refrigerate overnight."
    },
    {
      "position": 3,
      "text": "The next morning: Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "In a small bowl, combine butter, sugar, maple syrup and pecans. Spoon mixture over bread."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until golden, about 40 minutes."
    },
    {
      "position": 6,
      "text": "Let stand 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

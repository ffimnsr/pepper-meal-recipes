  "slug": "dry-rub-for-ribs",
  "name": "Dry Rub for Ribs",
  "recipe_type": null,
  "brief_description": "This dry rub for ribs is easy to make with just five ingredients for a flavorsome seasoning on pork ribs, chops, or chicken before grilling.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix brown sugar, paprika, salt, pepper, and garlic powder together in a small bowl. Rub into pork ribs."
    },
    {
      "position": 3,
      "text": "For best results, allow ribs to marinate overnight. Enjoy!"
    }
  ],
  "servings": 8,

  "id": "cf76db10-88db-5dc0-a730-a167916466fa",
  "slug": "spanakopita-egg-bites-recipe-11866127",
  "name": "Spanakopita Egg Bites",
  "recipe_type": "breakfast",
  "brief_description": "These spanakopita egg bites are made with feta, spinach, and fresh dill. They make the perfect grab and go breakfast.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Generously grease twelve 2 1/2-inch muffin cups with cooking spray."
    },
    {
      "position": 3,
      "text": "Combine spinach, feta, green onions, and dill in a bowl. Add 1/4 cup of the mixture to each muffin cup."
    },
    {
      "position": 4,
      "text": "Whisk together eggs, milk, pepper, and salt in a large bowl until well blended."
    },
    {
      "position": 5,
      "text": "Pour egg mixture over spinach mixture in each muffin cup."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until eggs are set, and an instant-read thermometer inserted into the center registers at least 160 degrees F (71 degrees C), 18 to 20 minutes. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 18,

  "id": "4aa18c72-ca2d-57de-8dbf-afed92ad0add",
  "slug": "pasta-alla-zozzona-recipe-11826945",
  "name": "Pasta Alla Zozzona",
  "recipe_type": "main",
  "brief_description": "This pasta alla zozzona, or \"dirty pasta,\" is made with a sauce that is a combination of two Roman pasta sauces, carbonara and amatriciana, plus pork sausage. It's rich, and so, so delicious.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a pan over medium heat, add onion, and cook until golden, about 7 minutes. Add garlic and pancetta, and cook until pancetta is crispy, about 2 minutes. Add sausage; cook and stir until browned, about 5 minutes, adding additional olive oil as needed."
    },
    {
      "position": 3,
      "text": "Add marinara, stir, and cook for 15 minutes. Season with salt, reduce heat to low, and simmer for 10 minutes more."
    },
    {
      "position": 4,
      "text": "Bring a large pot of salted water to a boil. Add rigatoni; cook until tender with a bite, about 13 minutes. Reserve a mug of pasta water, drain pasta, and keep warm."
    },
    {
      "position": 5,
      "text": "Meanwhile, whisk egg yolks in a bowl; add pecorino Romano and whisk until thick. Season with black pepper, and add a bit of reserved pasta water to loosen the egg sauce."
    },
    {
      "position": 6,
      "text": "Slowly whisk egg sauce into meat sauce."
    },
    {
      "position": 7,
      "text": "Stir sauce into rigatoni; taste, and finish with more cheese, salt, and black pepper. Garnish with fresh basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

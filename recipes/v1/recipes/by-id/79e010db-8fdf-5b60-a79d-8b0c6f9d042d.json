  "id": "79e010db-8fdf-5b60-a79d-8b0c6f9d042d",
  "slug": "blended-baked-oats-5-ways",
  "name": "Blended Baked Oats 5 Ways",
  "recipe_type": "dessert",
  "brief_description": "This blended baked oats recipe makes five individual servings of baked oats, each with a different flavor. They taste more like dessert than breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease five 8-ounce ramekins."
    },
    {
      "position": 2,
      "text": "Make the blended oats: Combine rolled oats, Greek yogurt, almond milk, maple syrup, eggs, vanilla, almond extract, baking powder, baking soda, salt, cinnamon, and nutmeg in a blender. Blend on high speed until batter is smooth, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Make the flavors: Add pumpkin pur\u00e9e, cranberries, walnuts, and pumpkin pie spice to one ramekin. Add coconut, almonds, and almond extract to a second ramekin. Add cherries, chocolate chips, and cocoa powder to a third ramekin. Add blueberries, maple syrup, and lemon zest to a fourth ramekin. Add raisins, walnuts, cinnamon, cloves, and allspice to a fifth ramekin."
    },
    {
      "position": 4,
      "text": "Divide blended oat batter evenly among the prepared ramekins. Carefully stir the batter in each ramekin individually until all additional ingredients are thoroughly incorporated. Transfer ramekins to a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops spring back lightly when touched, 30 to 35 minutes. Allow to cool for 10 minutes before serving. Alternately, cool completely, cover, and place into the refrigerator or freezer for later. Rewarm before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

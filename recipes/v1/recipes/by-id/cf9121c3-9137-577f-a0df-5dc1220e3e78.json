  "id": "cf9121c3-9137-577f-a0df-5dc1220e3e78",
  "slug": "pumpkin-hummus-recipe-7484712",
  "name": "Pumpkin Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Try adding pumpkin puree to hummus for a colorful variety of the Middle Eastern classic. Serve with pita bread and cut-up veggies.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium heat. Add garlic and cumin; cook and stir until fragrant, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Transfer garlic mixture to a food processor or blender. Add chickpeas, pumpkin, water, lemon juice, salt, cayenne, cinnamon, and black pepper. Blend until smooth."
    },
    {
      "position": 3,
      "text": "Transfer into a serving bowl. Garnish with additional olive oil and sprinkle with green onions. Serve with pita bread and cut-up veggies."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 9,

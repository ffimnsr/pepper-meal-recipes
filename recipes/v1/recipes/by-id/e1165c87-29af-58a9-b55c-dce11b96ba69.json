  "slug": "sparkling-mango-pineapple-sangria-recipe-7560880",
  "name": "Sparkling Mango Pineapple Sangria",
  "recipe_type": "appetizer",
  "brief_description": "Make your summer sangria extra fun with bubbles and tropical fruit. This sparkling mango and pineapple sangria with Prosecco will make you want to sit in the sunshine and enjoy.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Stir pineapple juice, mango juice, pineapple rum, mango rum, chunked pineapple, and mango slices together in a large pitcher. Chill for 2 to 4 hours."
    },
    {
      "position": 2,
      "text": "Add Prosecco before serving. Stir and serve cold."
    }
  ],
  "servings": 6,

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f00f430c-8115-5f14-b17f-7565c30b22c0",
  "slug": "chicken-and-andouille-sausage-gumbo",
  "name": "Chicken and Andouille Sausage Gumbo",
  "recipe_type": "soup",
  "brief_description": "This chicken and andouille sausage gumbo recipe, using the Cajun trinity, Creole seasoning, and fil\u00e9 powder, is great if you like gumbo without seafood.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Cook sausage in a Dutch oven over medium heat, stirring constantly until browned, about 5 minutes. Transfer sausage to a bowl; reserve drippings in Dutch oven."
    },
    {
      "position": 2,
      "text": "Cook chicken in drippings over medium heat until both sides browned, 2 to 3 minutes per side. Transfer chicken to a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in the Dutch oven over medium heat. Add flour; cook and stir constantly until roux is thick and chocolate colored, 20 to 30 minutes. Be careful not to burn roux or you'll have to start again."
    },
    {
      "position": 4,
      "text": "Add celery, onion, and bell pepper; cook and stir for 6 minutes. Add garlic; cook until fragrant, about 2 minutes. Stir in hot broth; bring to a boil."
    },
    {
      "position": 5,
      "text": "Add chicken breasts, Worcestershire sauce, Creole seasoning, thyme, pepper flakes, and bay leaves. Reduce heat; simmer, stirring occasionally, until chicken is no longer pink in the center and juices run clear, about 1 hour. Transfer chicken to a plate; cool."
    },
    {
      "position": 6,
      "text": "Add sausage to gumbo; simmer for 30 minutes."
    },
    {
      "position": 7,
      "text": "Shred cooled chicken. Add chicken and green onions to gumbo; simmer for 30 minutes."
    },
    {
      "position": 8,
      "text": "Remove gumbo from heat. Discard bay leaves. Sprinkle gumbo with fil\u00e9 powder; stir. Serve gumbo over hot rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 20,

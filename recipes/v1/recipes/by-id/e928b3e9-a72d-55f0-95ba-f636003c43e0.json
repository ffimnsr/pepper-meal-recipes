  "id": "e928b3e9-a72d-55f0-95ba-f636003c43e0",
  "slug": "dark-chocolate-peppermint-fudge",
  "name": "Dark Chocolate Peppermint Fudge Recipe",
  "recipe_type": "dessert",
  "brief_description": "Dark chocolate fudge topped with crushed peppermint candies is a festive treat to give on Valentine's Day or during the Christmas season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chocolate chips, sweetened condensed milk, butter, peppermint extract, and salt in a large microwave-safe bowl."
    },
    {
      "position": 2,
      "text": "Heat in the microwave on medium-high until chips are melted, 5 to 6 minutes, stirring every 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour chocolate mixture into an 8x8-inch silicone baking dish; top with crushed peppermint candies. Lightly press candies, using the back of a spoon, into chocolate mixture. Refrigerate until set, 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,

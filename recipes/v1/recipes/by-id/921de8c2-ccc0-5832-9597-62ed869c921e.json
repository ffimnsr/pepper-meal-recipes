  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "921de8c2-ccc0-5832-9597-62ed869c921e",
  "slug": "chef-johns-apple-fritters",
  "name": "Chef John's Apple Fritters",
  "recipe_type": "dessert",
  "brief_description": "Chef John cooks the apples first for more flavor and a softer texture, and he uses sparkling apple cider for a lighter-tasting apple fritter.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter over medium-high heat and cook until it turns golden brown, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Add apples and cook over medium-high heat until apples just begin to soften around the edges, 3 to 4 minutes. Sprinkle in 1 tablespoon sugar and continue cooking another 2 minutes. Remove from heat. Drain in a strainer; let cool to room temperature."
    },
    {
      "position": 4,
      "text": "Whisk flour, baking powder, salt, cinnamon, ginger, and nutmeg together in a mixing bowl until well combined."
    },
    {
      "position": 5,
      "text": "Whisk egg, 1/4 cup sugar, and melted butter together in a separate mixing bowl."
    },
    {
      "position": 6,
      "text": "Add cooled apple pieces and sparkling apple cider; add the flour mixture. Stir just until flour is incorporated."
    },
    {
      "position": 7,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Spoon about 2 tablespoons batter per fritter, into hot oil, slightly flattening them out. Cook in batches. Fry on one side until small bubbles appear on the surface, about 2 minutes. Carefully flip fritters over and fry the other side until richly browned, about 2 more minutes."
    },
    {
      "position": 8,
      "text": "Transfer with a slotted spoon to a paper-towel-lined plate to drain grease. Cool slightly before glazing."
    },
    {
      "position": 9,
      "text": "Whisk powdered sugar and cinnamon in a mixing bowl. Add enough apple cider, 1 teaspoon at a time, to form a smooth glaze that is just runny enough to drizzle over fritters. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

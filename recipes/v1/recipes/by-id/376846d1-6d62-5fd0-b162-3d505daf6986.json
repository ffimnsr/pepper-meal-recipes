  "slug": "orange-banana-smoothie",
  "name": "Orange Banana Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This orange and banana smoothie with fat-free vanilla yogurt is a delightful way to start the day. It's filling enough to have for breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine milk, yogurt, sugar, and salt in a blender. Add oranges and banana and blend for about 1 minute. Add ice and blend until smooth."
    },
    {
      "position": 3,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 2,

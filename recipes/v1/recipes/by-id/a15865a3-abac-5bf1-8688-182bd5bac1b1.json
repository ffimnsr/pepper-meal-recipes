  "slug": "overnight-light-pbj-oats",
  "name": "Overnight Light PB&J Oats",
  "recipe_type": "breakfast",
  "brief_description": "Oats, powdered peanut butter, and raspberries soak in almond milk overnight to create this easy on-the-go breakfast inspired by a PB&J.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix almond milk, raspberries, rolled oats, powdered peanut butter, chia seeds, and sugar together in a container. Cover and refrigerate until oats are soft, 8 hours to overnight."
    }
  ],

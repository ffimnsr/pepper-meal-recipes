  "id": "f443c4b5-0ced-5af4-a1de-e79a320e8067",
  "slug": "spicy-pickled-okra",
  "name": "Spicy Pickled Okra",
  "recipe_type": "snack",
  "brief_description": "Pickled okra with some kick and a nice smoky flavor - perfect garnish or snack.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Wash the okra, rubbing lightly to remove any grit and fuzz. Sterilize 2 (1 quart ) canning jars and lids in boiling water for at least 10 minutes, allow to cool before filling with okra."
    },
    {
      "position": 2,
      "text": "Combine the cider vinegar, water, garlic, red pepper flakes, smoked paprika, salt, and peppercorns to a boil in a large pot over medium-high heat. Reduce the temperature and simmer for 15 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Pack fresh, cleaned okra loosely into the jars. Pour the hot brine over the okra, filling the jars to the top. Seal jars, making sure you have cleaned the jar's rims of any residue. Store the jars in the refrigerator. Allow contents to pickle at least one week minimum before eating, two weeks is best."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

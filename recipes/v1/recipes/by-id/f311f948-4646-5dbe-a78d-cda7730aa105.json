  "slug": "eggnog-i",
  "name": "Eggnog I",
  "recipe_type": "dessert",
  "brief_description": "No Christmas is complete without eggnog! Now you can make your own with this recipe using eggs, cream, and sweetened condensed milk.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs; mix in condensed milk, vanilla, quart of milk and salt."
    },
    {
      "position": 2,
      "text": "Beat the whipping cream until soft peaks form. Fold in to egg and milk mixture and sprinkle with nutmeg. Serve chilled."
    }
  ],

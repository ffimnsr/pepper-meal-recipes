{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e60f5396-f1e4-5f49-b52f-60d9983ada08",
  "slug": "stuffed-bell-peppers-with-beef-and-cabbage",
  "name": "Stuffed Bell Peppers with Beef and Cabbage",
  "recipe_type": "main",
  "brief_description": "For this stuffed bell peppers with beef and cabbage recipe, lean ground beef and shredded cabbage combine with seasonings and mozzarella and provolone.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Oil bottom and sides of two rectangular glass baking dishes."
    },
    {
      "position": 2,
      "text": "Melt butter in a 4- to 6-quart stockpot over medium heat. Stir in ground beef, diced tomatoes, green and red cabbage, celery, onion, Worcestershire sauce, garlic, salt, oregano, basil, and black pepper; cook until beef starts to brown and cabbage softens slightly, 8 to 10 minutes. Continue to cook and stir for 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, cut peppers in half from top to bottom. Remove stems, seeds, and white membranes. Rub outsides of peppers with olive oil; arrange, skin-sides down, like edible bowls, in the prepared baking dishes."
    },
    {
      "position": 4,
      "text": "Strain beef mixture to remove and discard excess liquid; divide mixture among peppers until filled, mounding any extra on top or reserving for another use. Cover stuffed peppers with aluminum foil."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven until peppers have softened, 30 to 40 minutes. Remove foil, top with mozzarella and provolone; cook 5 minutes more."
    },
    {
      "position": 6,
      "text": "Cool before serving, 3 to 5 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

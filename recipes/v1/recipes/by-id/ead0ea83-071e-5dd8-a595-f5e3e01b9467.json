  "id": "ead0ea83-071e-5dd8-a595-f5e3e01b9467",
  "slug": "tuna-mushroom-casserole",
  "name": "Tuna Mushroom Casserole",
  "recipe_type": "main",
  "brief_description": "Baked tuna casserole with bow tie pasta and mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 1-quart casserole dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "In a mixing bowl, combine mushroom soup, milk, salt, and pepper. Mix thoroughly. Then add tuna, mushrooms, and pasta. Mix thoroughly. Pour mixture into the greased casserole dish."
    },
    {
      "position": 4,
      "text": "In another mixing bowl, combine bread crumbs, butter, and thyme. Mix well. Sprinkle over the top of the tuna mixture."
    },
    {
      "position": 5,
      "text": "Bake uncovered in a preheated oven until bubbling and golden brown, about 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 53,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

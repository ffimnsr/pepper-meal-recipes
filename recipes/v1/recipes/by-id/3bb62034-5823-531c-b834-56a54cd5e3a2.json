  "id": "3bb62034-5823-531c-b834-56a54cd5e3a2",
  "slug": "how-to-steam-broccoli-recipe-8760150",
  "name": "How to Steam Broccoli",
  "recipe_type": "side",
  "brief_description": "This is how to steam broccoli on the stovetop, preserving its gorgeous green color, texture, and nutritional value. It's easy to make using a steamer basket.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large saucepan with 1-inch of water."
    },
    {
      "position": 3,
      "text": "Add a steamer basket to the saucepan; bring to a boil over high heat."
    },
    {
      "position": 4,
      "text": "Place broccoli florets in steamer basket; reduce heat to medium-low and cover."
    },
    {
      "position": 5,
      "text": "Steam until broccoli is crisp tender, 5 to 6 minutes, or desired doneness."
    },
    {
      "position": 6,
      "text": "Season with olive oil, salt, and pepper, to taste, as desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

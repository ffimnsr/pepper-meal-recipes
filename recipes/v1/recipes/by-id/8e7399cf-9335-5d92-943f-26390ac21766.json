  "id": "8e7399cf-9335-5d92-943f-26390ac21766",
  "slug": "chicken-a-la-king-casserole-recipe-11924423",
  "name": "Chicken a la King Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken à la king casserole is a tasty, creamy twist on the classic dish, combining chicken, egg noodles, and a rich, savory sauce with mushrooms, peas, and pimentos. Finished with a golden, buttery panko topping, it is the perfect comfort food for weeknight dinners.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine chicken, egg noodles, chicken broth, cream, onions, mushrooms, pimentos, peas, Worcestershire sauce, chicken bouillon granules, and black pepper in the prepared baking dish. Stir until well combined."
    },
    {
      "position": 3,
      "text": "Cover the dish tightly with foil and bake until the most of the noodles are tender, 30 minutes."
    },
    {
      "position": 4,
      "text": "Uncover the dish and stir the casserole, pressing any underdone noodles under the sauce. Combine panko and melted butter in a small bowl; sprinkle evenly over the top. Bake uncovered until the topping is golden brown, 15 minutes. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "de0b2ce0-22d8-59e2-bc03-2087bcef4881",
  "slug": "tortellini-alfredo-with-grilled-chicken-breasts",
  "name": "Tortellini Alfredo with Grilled Chicken Breasts",
  "recipe_type": "main",
  "brief_description": "Tortellini Alfredo with grilled chicken in a creamy, homemade sauce is a weeknight dinner the family will love.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Make the chicken: Toss chicken, oil, Italian seasoning, garlic powder, salt, and pepper in a bowl until coated."
    },
    {
      "position": 3,
      "text": "Cook chicken on the preheated grill until no longer pink in the center and the juices run clear, about 6 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Transfer to a plate; cut into bite-sized pieces when cool enough to handle."
    },
    {
      "position": 4,
      "text": "While the chicken is cooking, fill a large pot with lightly salted water and bring to a rolling boil. Add tortellini, return to a boil, and cook, uncovered and stirring occasionally, until tortellini float to the top and cheese filling is hot, about 3 minutes. Drain and keep warm."
    },
    {
      "position": 5,
      "text": "Make the sauce: Melt butter in a saucepan over medium heat. Add garlic and cook for 2 to 3 minutes. Add cream and cook for 3 minutes. Add Parmesan cheese and stir until melted, 2 to 3 minutes. Add Italian seasoning and pepper; bring to a slow boil. Cook at a slow boil for 1 minute, then stir in tortellini and chicken. Cook until heated through, 2 to 3 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

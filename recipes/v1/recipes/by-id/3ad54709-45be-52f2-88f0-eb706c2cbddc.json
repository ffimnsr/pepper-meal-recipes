  "id": "3ad54709-45be-52f2-88f0-eb706c2cbddc",
  "slug": "pumpkin-flan",
  "name": "Pumpkin Flan",
  "recipe_type": "dessert",
  "brief_description": "Try this fun pumpkin flan as a dessert for Halloween. It can be baked in a pumpkin-shaped tart pan and decorated with chocolate ganache to look like a jack-o'-lantern.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place a tart pan on a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine silken tofu, pumpkin puree, applesauce, cornstarch, eggs, maple syrup, vanilla extract, pumpkin pie spice, and food coloring in a bowl. Puree using a stick blender until smooth. Pour batter into the tart pan, filling only halfway."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until flan has set, about 25 minutes. Remove from oven and cool completely before inverting onto a serving plate."
    },
    {
      "position": 4,
      "text": "Place chocolate in a metal bowl. Heat cream, honey, and butter in a small saucepan until almost boiling and pour over chocolate. Leave for 1 minute, then stir well until chocolate has melted. Transfer chocolate ganache to a piping bag fitted with a small tip and decorate pumpkin flan. Refrigerate until serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

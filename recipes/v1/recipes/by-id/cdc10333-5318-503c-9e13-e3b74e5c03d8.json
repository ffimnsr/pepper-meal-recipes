  "id": "cdc10333-5318-503c-9e13-e3b74e5c03d8",
  "slug": "butternut-squash-and-apple-soup",
  "name": "Butternut Squash and Apple Soup",
  "recipe_type": "soup",
  "brief_description": "This hearty butternut squash and apple soup with hints of thyme and sage is loaded with flavor and topped with crumbled bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium-high heat. Saute butternut squash, leeks, carrots, and celery in hot butter until vegetables are softened, 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Stir apples, thyme, and sage into the squash mixture; pour in chicken stock and cider. Bring mixture to a simmer, reduce heat to low, cover pot with a lid, and cook until vegetables and apples are tender, about 30 minutes. Remove soup from heat and cool slightly, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Pour soup into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until smooth. Return mixture to pot and season with salt to taste. Garnish individual servings with crumbled bacon."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

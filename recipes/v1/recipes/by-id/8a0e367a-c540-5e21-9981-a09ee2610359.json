  "id": "8a0e367a-c540-5e21-9981-a09ee2610359",
  "slug": "tender-and-easy-buttermilk-waffles",
  "name": "Tender and Easy Buttermilk Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These buttermilk waffles are crisp on the outside and tender in the middle. They're easy to make and perfect for a family-pleasing weekend breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, baking soda, and salt together in a bowl until evenly combined."
    },
    {
      "position": 3,
      "text": "Whisk buttermilk and melted butter together in a separate bowl; whisk in eggs."
    },
    {
      "position": 4,
      "text": "Stir buttermilk mixture into flour mixture until just combined and batter is slightly lumpy; stir in vanilla extract."
    },
    {
      "position": 5,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 6,
      "text": "To cook each waffle, pour enough batter into the preheated waffle iron to reach 1/2 inch from the edge. Cook according to manufacturer's instructions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

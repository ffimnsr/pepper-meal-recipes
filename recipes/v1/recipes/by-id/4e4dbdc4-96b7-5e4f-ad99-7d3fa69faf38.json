  "slug": "vegan-split-pea-soup-ii",
  "name": "Vegan Split Pea Soup II",
  "recipe_type": "soup",
  "brief_description": "This yellow split pea soup is flavored with olive oil and a pinch of curry. An excellent lunch or dinner because it is easy to make and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan. Cook and stir carrot, onion, celery and curry for about 5 minutes. Add the water, peas and salt. Simmer, stirring occasionally, for 45 to 50 minutes, or until very thick."
    }
  ],

  "id": "e0d52093-ab42-5d2c-a239-74bb4e943211",
  "slug": "6-ingredient-ravioli-casserole-recipe-8782378",
  "name": "6-Ingredient Ravioli Casserole",
  "recipe_type": "main",
  "brief_description": "This 6-ingredient ravioli casserole, cheesy and delicious, takes just a few minutes to assemble and will satisfy the pickiest eaters. It\u2019s similar to lasagna, but so much easier to make.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Crumble sausage into a large skillet over medium-high heat. Cook until browned, about 3 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring water to a boil in a large saucepan. Boil ravioli for 2 minutes; drain."
    },
    {
      "position": 4,
      "text": "Spread drained sausage in the bottom of a 3-quart casserole dish. Top with ravioli."
    },
    {
      "position": 5,
      "text": "Layer spinach over ravioli. Pour vodka sauce evenly over spinach. Spoon pesto evenly over the top. Top with shredded mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is melted and ravioli is heated through, about 35 minutes. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b3ecc81f-bf02-57eb-b4b7-463c12c820aa",
  "slug": "buffalo-chicken-wraps",
  "name": "Buffalo Chicken Wraps",
  "recipe_type": "appetizer",
  "brief_description": "Easy Buffalo chicken wraps, based on the popular dip, are fun to customize with your favorite toppings for a game-winning appetizer or light dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil and butter in a large skillet over medium-high heat until butter melts. Add chicken; cook and stir until no longer pink in the center and the juices run clear, about 10 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Pour hot sauce into the skillet and toss until chicken is coated."
    },
    {
      "position": 4,
      "text": "Lay tortillas out on a work surface. Divide sauced chicken evenly among tortillas."
    },
    {
      "position": 5,
      "text": "Top the chicken with lettuce and celery, then drizzle blue cheese dressing over top."
    },
    {
      "position": 6,
      "text": "Fold in tortilla sides and roll around filling. Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

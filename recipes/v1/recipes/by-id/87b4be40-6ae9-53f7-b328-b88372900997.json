  "id": "87b4be40-6ae9-53f7-b328-b88372900997",
  "slug": "classic-frozen-strawberry-margarita",
  "name": "Classic Frozen Strawberry Margarita",
  "recipe_type": "drink",
  "brief_description": "Make a frozen strawberry margarita with fresh strawberries, lime juice, tequila, triple sec, and ice for a deliciously refreshing cocktail.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place strawberries, tequila, lime juice, triple sec, and 1 teaspoon sugar in a blender; process until smooth."
    },
    {
      "position": 3,
      "text": "Add ice cubes; blend on high until ice is crushed to your liking, about 15 seconds."
    },
    {
      "position": 4,
      "text": "Rub lime wedge around the rim of a glass. Spread 1 teaspoon sugar onto a plate. Dip glass rim in sugar to coat; pour into a margarita glass and enjoy!"
    }
  ],
  "servings": 1,

  "slug": "arugula-salad-with-stone-fruit-recipe-7506181",
  "name": "Arugula Salad with Stone Fruit",
  "recipe_type": "salad",
  "brief_description": "This juicy, vibrant arugula salad features fresh cherries, peaches, and nectarines for a summery flavor. For an extra touch of sweetness, opt for ros\u00e9 vinegar, a ros\u00e9 wine-based vinegar with a bright, fruity flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together olive oil, vinegar, salt, and pepper in a small bowl for the dressing."
    },
    {
      "position": 2,
      "text": "Arrange tomatoes, arugula, basil, nectarines, and peach slices on a large platter. Drizzle with half the dressing. Top with cherries, sea salt, and remaining dressing. Serve immediately. Recipe developed by Karen Rankin"
    }
  ],
  "servings": 4,

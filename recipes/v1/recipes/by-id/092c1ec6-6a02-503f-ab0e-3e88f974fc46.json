{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "092c1ec6-6a02-503f-ab0e-3e88f974fc46",
  "slug": "fried-rice-with-ginger-hoisin-and-sesame",
  "name": "Fried Rice with Ginger, Hoisin, and Sesame",
  "recipe_type": "main",
  "brief_description": "A twist on the average fried rice - a culmination of some of my favorite Asian flavors thrown into a common dish. This recipe is very easy to adjust according to personal tastes; you can make it about as strong or as mild as you prefer. Compliments Teriyaki beef well, or can be easily modified into a stir-fry meal.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Melt the butter in a small saucepan over medium heat. Add the uncooked rice, and cook until toasted, stirring occasionally. Pour in the water and bring to a boil. Reduce heat to low, cover, and cook for about 15 minutes, or until tender."
    },
    {
      "position": 2,
      "text": "While the rice is cooking, mix together the hoisin sauce, barbeque sauce, peanut butter, soy sauce, garlic, and ginger. Set aside."
    },
    {
      "position": 3,
      "text": "When the rice is done cooking, heat the sesame oil in a wok or large skillet over medium-high heat. When it begins to smoke, add the onion and fry until clear. Add the carrot, and cook for about 1 minute, then add the rice, and stir fry for about 2 minutes. Add the broccoli and peas; cook and stir for about 1 minute. Push everything to the sides of the wok, and crack the eggs into the center. Scramble until cooked through, trying to keep the raw egg from mixing with everything else. When the eggs are cooked, stir them in with the rice."
    },
    {
      "position": 4,
      "text": "Turn off the heat, and stir in about half of the sauce, tasting and adding more as desired. You may not need all of the sauce, but if you serve this with a meat it makes a good sauce for that too. Sprinkle with sesame seeds before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

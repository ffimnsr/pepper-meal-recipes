  "id": "2711b2ca-208a-53b7-bc91-ac3e6fe68478",
  "slug": "cha-gio-vietnamese-egg-rolls",
  "name": "Cha Gio Vietnamese Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Cha gio Vietnamese egg rolls feature pork, shrimp, and veggies. Make a double batch of the recipe \u2014 they freeze well. And serve with a tangy sauce.",
  "cuisine": "Vietnamese",
  "instructions": [
    {
      "position": 1,
      "text": "Soak cellophane noodles and shiitake mushroom in warm water until pliable, about 15 minutes. Drain well. Mince mushroom."
    },
    {
      "position": 2,
      "text": "Combine noodles, mushroom, pork, shrimp, carrot, shallot, fish sauce, sugar, salt, and black pepper in a large bowl; toss until ingredients are well mixed, evenly distributed, and to break up pork."
    },
    {
      "position": 3,
      "text": "Place 1 egg roll wrapper diagonally on a flat surface. Spread a scant 2 tablespoons pork filling across wrapper center. Fold bottom corner over filling, then fold in side corners to enclose filling. Brush beaten egg on top wrapper corner; continue rolling to seal. Repeat filling and rolling with remaining wrappers, pork filling, and beaten egg."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep fryer, wok, or large saucepan to 350 degrees F (175 degrees C), or until a drop of water jumps on the surface."
    },
    {
      "position": 5,
      "text": "Lower egg rolls carefully into the hot oil in batches. Fry until golden brown, 5 to 8 minutes. Drain on paper towels or paper bags. Repeat with remaining egg rolls."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

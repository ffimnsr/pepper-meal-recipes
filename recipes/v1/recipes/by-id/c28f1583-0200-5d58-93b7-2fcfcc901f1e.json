  "id": "c28f1583-0200-5d58-93b7-2fcfcc901f1e",
  "slug": "miso-mushrooms-recipe-11880833",
  "name": "Miso Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These miso mushrooms deliver flavor in a hurry. Caramelized in a garlicky miso honey sauce, they will satisfy vegetarians and meat lovers alike.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For sauce, stir miso, butter, garlic, mirin, honey, and rice vinegar together in a bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium-low heat. Add oil and let it warm. Add mushrooms and salt. Stir and let mushrooms cook until they begin to soften, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour in miso sauce. Stir, then cook without stirring until carmelized, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Once golden brown, remove to a plate. Season with salt and garnish with chives."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

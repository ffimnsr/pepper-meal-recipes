  "id": "44a0fabc-308f-5c21-84d5-5c228bf73d4e",
  "slug": "tofu-burgers",
  "name": "Tofu Burgers",
  "recipe_type": "main",
  "brief_description": "Tofu burgers flavored with onion, celery, and Cheddar cheese are a nice alternative to beef burgers when topped with all your favorite burger fixings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large saucepan of water to a simmer. Leave frozen tofu in its package and place into the water. Remove from the heat and let tofu thaw for about 20 minutes in the hot water."
    },
    {
      "position": 2,
      "text": "Remove tofu from the package and transfer to a plate. Place another plate on top of tofu. Set a 3- to 5-pound weight on top. Press tofu for 20 to 30 minutes; drain and discard the accumulated liquid."
    },
    {
      "position": 3,
      "text": "While tofu is draining, heat 2 teaspoons oil in a small skillet over medium heat. Add onion and celery; saut\u00e9 until soft and lightly browned, about 5 minutes. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Finely chop tofu and place into a mixing bowl. Add onion and celery mixture, Cheddar, egg, salt, and pepper; mix until thoroughly combined."
    },
    {
      "position": 5,
      "text": "Pour 1/4 inch oil into a large skillet and heat over medium-high heat. Drop tofu mixture into the skillet in six equal portions. Flatten with a spatula to form patties. Fry until golden brown, 5 to 7 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

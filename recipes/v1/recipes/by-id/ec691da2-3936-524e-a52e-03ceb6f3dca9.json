  "id": "ec691da2-3936-524e-a52e-03ceb6f3dca9",
  "slug": "the-best-easy-pork-tenderloin-recipe-7485158",
  "name": "The Best Easy Pork Tenderloin",
  "recipe_type": "drink",
  "brief_description": "This pork tenderloin is super rich and buttery. The end product is incredibly moist and tender. The pan drippings make the most delicious light sauce with richness from the meat juices and acidity and flavor from the wine and seasonings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Trim the silver skin from each pork tenderloin and season evenly with salt, pepper, garlic, and herbes de Provence."
    },
    {
      "position": 2,
      "text": "Heat oil in a large oven-proof skillet over medium-high heat until barely shimmering. Add both pork tenderloins and cook, undisturbed, until golden brown and easily release from the pan, about 5 minutes. Flip each piece and cook for an additional 3 minutes undisturbed. Add wine and cook for 1 minute. Remove pan from the stove and place in the oven."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pork is slightly pink in the center, 15 to 19 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove from the oven and allow to rest for 5 to 10 minutes before slicing. Serve with pan juices."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

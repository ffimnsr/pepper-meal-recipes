  "id": "db737c22-faa0-5911-b827-7bab735b9f21",
  "slug": "tofu-tacos-i",
  "name": "Tofu Tacos",
  "recipe_type": "drink",
  "brief_description": "A tofu taco recipe for a meatless Taco Tuesday, or any day. Tofu is spiked with chili powder, cumin, cayenne, and lime juice for a delicious filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook tofu, oil, garlic, and onion in a large skillet over medium heat for 5 minutes. Add chili powder, paprika, cayenne, cumin, salt, lime juice, and tomato sauce to the skillet and stir. Cook for 3 minutes."
    },
    {
      "position": 2,
      "text": "Stir in cilantro. Spoon mixture into a bowl."
    },
    {
      "position": 3,
      "text": "Spoon tofu mixture into taco shells. Top the mixture with lettuce, tomatoes, avocado, cheese, and salsa."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

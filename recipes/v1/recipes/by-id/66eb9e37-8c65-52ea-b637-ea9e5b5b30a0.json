  "id": "66eb9e37-8c65-52ea-b637-ea9e5b5b30a0",
  "slug": "pumpernickel-bagels",
  "name": "Pumpernickel Bagels",
  "recipe_type": "main",
  "brief_description": "Rye flour, cocoa powder, instant coffee, and caraway seeds are the secret ingredients to making pumpernickel bagels at home.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine warm water, whole-wheat flour, and yeast in a small bowl. Let stand until the yeast softens and begins to froth and bubble, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Mix rye flour, molasses, cocoa powder, vegetable oil, coffee granules, caraway seeds, and salt in a large bowl. Add yeast mixture and all-purpose flour. Turn dough onto a floured surface; knead until smooth and elastic, about 10 minutes. Grease a large bowl."
    },
    {
      "position": 3,
      "text": "Transfer dough to greased bowl; cover with a warm damp towel or plastic wrap. Let rise in a warm area until doubled in size, about 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a baking sheet."
    },
    {
      "position": 5,
      "text": "Bring water to a boil in a large pot. Divide dough into 13 pieces; shape into balls. Press a hole into the center of each dough ball; pull dough to form a 1-inch hole in the center, keeping dough about 1/2-inch thick. Drop dough circles into boiling water, 3 or 4 at a time. Boil each side for 45 seconds. Remove with a slotted spoon and drain for about 1 minute. Arrange boiled bagels on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake bagels in the preheated oven until just starting to brown on the bottom, 8 to 10 minutes."
    }
  ],
  "servings": 13,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

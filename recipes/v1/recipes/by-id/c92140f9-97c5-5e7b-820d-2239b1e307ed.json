  "id": "c92140f9-97c5-5e7b-820d-2239b1e307ed",
  "slug": "deviled-eggs-with-horseradish",
  "name": "Deviled Eggs with Horseradish",
  "recipe_type": "appetizer",
  "brief_description": "Add a kick to deviled eggs with a special addition of horseradish, along with dill weed and ground mustard, for a crowd-pleasing appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil; remove from heat and let eggs stand in hot water for 15 minutes. Remove eggs and cool under cold running water; peel eggs. Slice each egg in half lengthwise. Remove yolks and transfer to a medium bowl. Place egg whites on a serving platter."
    },
    {
      "position": 2,
      "text": "Mash yolks with a fork. Stir in mayonnaise, horseradish, dill, dry mustard, salt, pepper, and paprika. Spoon equal amounts into egg whites."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

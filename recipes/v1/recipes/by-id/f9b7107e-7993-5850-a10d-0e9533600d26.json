  "id": "f9b7107e-7993-5850-a10d-0e9533600d26",
  "slug": "cream-cheese-pound-cake-i",
  "name": "Classic Cream Cheese Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist pound cake recipe uses cream cheese to make a rich cake flavored with vanilla and almond extracts for a simple homemade dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease one 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Beat butter, cream cheese, and sugar together in a large bowl with an electric mixer until light and fluffy. Add vanilla and almond extracts. Add flour and eggs alternately, beginning and ending with the flour. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour 15 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

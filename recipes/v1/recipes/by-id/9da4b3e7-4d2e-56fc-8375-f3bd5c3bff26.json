  "id": "9da4b3e7-4d2e-56fc-8375-f3bd5c3bff26",
  "slug": "grilled-teriyaki-chicken-thigh-skewers",
  "name": "Grilled Teriyaki Chicken Thigh Skewers",
  "recipe_type": "side",
  "brief_description": "Chicken thighs are marinated in homemade teriyaki sauce, threaded onto skewers, and grilled to perfection on your outdoor grill.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, brown sugar, soy sauce, mirin, agave, garlic, and ginger in a saucepan over medium heat. Combine tapioca flour with 2 tablespoons water in a bowl; whisk until dissolved. Add mixture to the teriyaki sauce in the saucepan."
    },
    {
      "position": 2,
      "text": "Heat sauce until it thickens to your desired thickness. Add more water if sauce becomes too thick."
    },
    {
      "position": 3,
      "text": "Remove sauce from heat and reserve 1/4 cup for basting. Combine remaining sauce and chicken in a bowl and refrigerate for 1 hour."
    },
    {
      "position": 4,
      "text": "Thread chicken strips onto skewers."
    },
    {
      "position": 5,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Grill chicken skewers on the preheated grill for 3 minutes per side, basting with reserved teriyaki sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

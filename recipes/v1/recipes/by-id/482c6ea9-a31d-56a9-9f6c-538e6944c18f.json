  "id": "482c6ea9-a31d-56a9-9f6c-538e6944c18f",
  "slug": "easy-vegetarian-corn-chowder",
  "name": "Easy Vegetarian Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "Creamed corn, whole kernel corn, half-and-half and milk go into this quick corn chowder made with vegetable broth.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large saucepan over medium heat, melt butter. Cook onions and celery in butter 3 minutes. Whisk in flour and cook 6 minutes more, until light brown. Whisk in broth and simmer 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in creamed corn, corn, carrot, half-and-half, milk, nutmeg, pepper and salt. Simmer over low heat 10 minutes more."
    }
  ],
  "servings": 6,

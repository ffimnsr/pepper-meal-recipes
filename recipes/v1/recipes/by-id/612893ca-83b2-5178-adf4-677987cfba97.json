  "id": "612893ca-83b2-5178-adf4-677987cfba97",
  "slug": "ham-and-cheddar-quick-bread-recipe-11881980",
  "name": "Ham and Cheddar Quick Bread",
  "recipe_type": "salad",
  "brief_description": "This ham and Cheddar quick bread with pimento-stuffed olives is great for snacking on its own, or toasted and served with a salad or soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease an 8 1/2 x 4 1/2-inch loaf pan, and set aside."
    },
    {
      "position": 2,
      "text": "Add flour, sugar, baking powder, kosher salt, cayenne, and granulated garlic to a large mixing bowl, and stir to combine."
    },
    {
      "position": 3,
      "text": "In a separate bowl, combine egg and milk, and slowly drizzle in melted butter. Add egg mixture to flour mixture, and stir until dry ingredients are just moistened."
    },
    {
      "position": 4,
      "text": "Stir in Cheddar cheese and deli ham, and fold in olives. Batter will be stiff; do not overmix. Pour into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the center of the preheated oven until a toothpick inserted in the center comes out clean, 35 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Cool in the pan about 10 minutes, remove from the pan and cool on a rack, about 10 minutes more. Using a serrated knife, cut into slices and serve warm, or at room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

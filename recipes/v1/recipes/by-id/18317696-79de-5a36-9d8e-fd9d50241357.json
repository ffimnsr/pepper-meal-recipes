  "slug": "pineapple-cleanser-smoothie",
  "name": "Pineapple Cleanser Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This vibrant cucumber and pineapple smoothie with celery, ginger, parsley, lemon, and coconut water is a very refreshing way to start the day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Blend coconut water, pineapple, celery, cucumber, lemon, parsley, and ginger together in a blender until smooth."
    }
  ],

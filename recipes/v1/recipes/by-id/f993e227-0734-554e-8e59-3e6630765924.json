  "id": "f993e227-0734-554e-8e59-3e6630765924",
  "slug": "shrimp-ramen-stir-fry-recipe-11918624",
  "name": "Shrimp Ramen Stir-Fry",
  "recipe_type": "dessert",
  "brief_description": "This shrimp ramen stir-fry combines shrimp, peppers, zucchini, and mushrooms with easy ramen in a sweet soy, garlic, and ginger sauce. Garnish with a half boiled egg and some carrot matchsticks for color.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, brown sugar, garlic, ginger, rice vinegar, and Sriracha sauce in a bowl and mix well; set sauce aside."
    },
    {
      "position": 2,
      "text": "Bring a pot of salted water to a boil and cook ramen according to package directions; drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat a wok or heavy skillet with butter and 1 1/2 tablespoons sesame oil."
    },
    {
      "position": 4,
      "text": "Add shrimp, cook until opaque, 2 to 3 minutes per side. Remove from wok and set aside."
    },
    {
      "position": 5,
      "text": "Add 1 tablespoon sesame oil to the wok; add zucchini, red bell pepper, yellow bell pepper, onion, and mushrooms. Cook and stir vegetables for 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Push veggies aside; add cooked Ramen noodles and stir to combine."
    },
    {
      "position": 7,
      "text": "Add shrimp and a little of the sauce at a time and mix well. You may have a little sauce left if you don't want your Ramen too saucy."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

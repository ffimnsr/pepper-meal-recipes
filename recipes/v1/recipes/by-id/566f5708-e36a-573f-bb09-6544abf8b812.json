  "slug": "raw-pasta-sauce",
  "name": "Raw Pasta Sauce",
  "recipe_type": null,
  "brief_description": "This raw pasta sauce is packed with nutrient-rich vegetables and is super easy to prepare. Serve over uncooked spaghetti squash.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Puree tomatoes, including seeds and juice, in a food processor or blender. Transfer to a lidded 2-cup container."
    },
    {
      "position": 2,
      "text": "Stir green bell pepper, onion, lime juice, garlic, sea salt, oregano, and rosemary into pureed tomatoes. Place lid on container and refrigerate at least 30 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

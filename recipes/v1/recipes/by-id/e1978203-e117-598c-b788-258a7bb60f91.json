  "id": "e1978203-e117-598c-b788-258a7bb60f91",
  "slug": "mongolian-beef-and-spring-onions",
  "name": "Mongolian Beef and Spring Onions",
  "recipe_type": "dessert",
  "brief_description": "This Mongolian beef recipe features crispy slices of flank steak with a sweet soy-based sauce and green onions for a restaurant-quality dish at home.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons of vegetable oil in a saucepan over medium heat. Add garlic and ginger; cook and stir until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Stir in brown sugar, soy sauce, and water."
    },
    {
      "position": 4,
      "text": "Increase heat to medium-high; stir until sauce boils and slightly thickens, about 4 minutes. Remove sauce from the heat and set aside."
    },
    {
      "position": 5,
      "text": "Place beef into a large bowl; add cornstarch and mix until beef is thoroughly coated."
    },
    {
      "position": 6,
      "text": "Set aside until most of the cornstarch has been absorbed, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Heat vegetable oil in a deep skillet to 375 degrees F (190 degrees C). Shake excess cornstarch from beef slices and drop into hot oil, a few at a time, stirring briefly and frying until edges become crisp, about 2 minutes."
    },
    {
      "position": 8,
      "text": "Remove beef with a large slotted spoon; drain on paper towels."
    },
    {
      "position": 9,
      "text": "Remove excess oil from the skillet, then heat the skillet over medium heat; add beef slices and stir in prepared sauce. Add green onions and bring to a boil; cook until the onions have just softened and are bright green, about 1 to 2 minutes."
    },
    {
      "position": 10,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

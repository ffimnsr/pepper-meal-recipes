  "id": "ed9df04a-c1de-5bf0-89ec-ca9c9a7fe849",
  "slug": "citrus-cranberry-zucchini-bread",
  "name": "Citrus Cranberry Zucchini Bread",
  "recipe_type": null,
  "brief_description": "This citrus cranberry zucchini bread recipe features dried cranberries, lemon extract, and orange zest, making a nice change from standard zucchini bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking soda, and baking powder together in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and eggs together in a large bowl with an electric mixer until well combined; beat in oil until blended. Stir in zucchini, cranberries, orange zest, and lemon extract, then stir in cinnamon, cloves, nutmeg, salt, and ginger. Stir in flour mixture until incorporated. Divide batter between the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 50 to 60 minutes. Cool in the pans for 10 minutes, then transfer loaves to a wire rack to cool completely, about 20 minutes more."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

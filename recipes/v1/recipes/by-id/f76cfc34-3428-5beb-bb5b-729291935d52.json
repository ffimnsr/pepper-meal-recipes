  "slug": "cheesy-garlic-bread-recipe-8658355",
  "name": "Cheesy Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This cheesy garlic bread, topped with melted butter, grated Parmesan and Romano, and plenty of mozzarella is as simple and straightforward as cheesy garlic bread ought to be.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven's broiler to Low. Place bread slices face up on a baking sheet; brush melted butter over tops."
    },
    {
      "position": 2,
      "text": "Divide garlic powder, Parmesan blend, and mozzarella evenly between slices, in that order."
    },
    {
      "position": 3,
      "text": "Place baking sheet on the middle rack. Broil on low until golden and bubbly, about 9 minutes. Sprinkle with chopped parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

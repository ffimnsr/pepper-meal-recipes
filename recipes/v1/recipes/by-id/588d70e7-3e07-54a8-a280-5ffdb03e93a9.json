  "schema_version": 1,
  "id": "588d70e7-3e07-54a8-a280-5ffdb03e93a9",
  "slug": "crispy-restaurant-style-buffalo-chicken-wings",
  "name": "Crispy Restaurant Style Buffalo Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "Restaurant-style buffalo wings are extra crispy and tender because they are fried twice, then seasoned in this easy wing recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make seasoning mix: Combine paprika, black pepper, chili powder, seasoned salt, cayenne pepper, onion powder, garlic powder, white pepper, and mustard powder in a bowl. Mix well."
    },
    {
      "position": 2,
      "text": "Cook chicken: Heat 2 inches vegetable oil and peanut oil in a deep cast iron pot or heavy pot over medium heat to 300 degrees F (150 degrees C). Dry chicken wings thoroughly with a paper towel."
    },
    {
      "position": 3,
      "text": "Fry chicken in 2 batches in hot oil, 4 to 5 minutes. Drain on a paper towel-lined plate."
    },
    {
      "position": 4,
      "text": "Increase oil temperature to 350 degrees F (175 degrees C). Fry chicken in 2 batches in hot oil until skin is crispy and golden brown and meat is no longer pink in the center, 5 to 6 minutes. Drain on a paper towel-lined plate; transfer to a large bowl."
    },
    {
      "position": 5,
      "text": "Sprinkle seasoning mix over chicken and toss to evenly coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

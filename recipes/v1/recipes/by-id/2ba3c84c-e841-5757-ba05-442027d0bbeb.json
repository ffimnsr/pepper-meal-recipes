  "id": "2ba3c84c-e841-5757-ba05-442027d0bbeb",
  "slug": "fried-chicken-tenders",
  "name": "Fried Chicken Tenders",
  "recipe_type": "main",
  "brief_description": "Enjoy this fried chicken tenders recipe that makes crispy, delicious chicken pieces and features an easy, spicy horseradish sauce for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare the breading station: Place flour in a shallow bowl. Place eggs and water in a second shallow bowl. Place bread crumbs in a third shallow bowl, and mix in ground black pepper and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Coat chicken in flour, then eggs, and then bread crumbs, one piece at a time, and set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Fry chicken in small batches until the pieces are golden brown, 6 to 8 minutes. Remove chicken to drain on paper towels or a wire rack."
    },
    {
      "position": 5,
      "text": "Make the dipping sauce: Combine mayonnaise, sour cream, horseradish, mustard, and Worcestershire sauce in a small bowl. Mix well, and serve with chicken."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

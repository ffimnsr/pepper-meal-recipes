  "id": "04783005-97b5-5762-a74d-441225d0ffa2",
  "slug": "pasta-primavera-with-italian-turkey-sausage",
  "name": "Pasta Primavera with Italian Turkey Sausage",
  "recipe_type": "main",
  "brief_description": "A delicious dish created from the fresh bounty of my garden. My whole family has seconds when we have this meal!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Place farfalle in pot and cook 8 to 10 minutes, until al dente; drain."
    },
    {
      "position": 2,
      "text": "Place sausage in a large skillet over medium heat and cook until evenly brown; set aside. Heat 1/4 cup oil in skillet. Stir in garlic and onion, and cook until tender. Mix in zucchini, squash, tomatoes, bell pepper and basil. Dissolve bouillon in the mixture. Season with red pepper. Stir in remaining oil. Continue cooking 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix pasta, sausage and cheese into skillet. Continue cooking 5 minutes, or until heated through."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

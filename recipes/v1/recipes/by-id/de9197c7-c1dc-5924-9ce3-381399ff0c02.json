  "id": "de9197c7-c1dc-5924-9ce3-381399ff0c02",
  "slug": "african-style-oxtail-stew",
  "name": "African-Style Oxtail Stew",
  "recipe_type": "main",
  "brief_description": "This slow-simmered recipe for African-style oxtail stew is rich in flavor with celery, onion, garlic, kidney beans, beef bouillon, and beef oxtail.",
  "cuisine": "African",
  "instructions": [
    {
      "position": 1,
      "text": "Place 10 cups water, celery, tomato paste, bouillon cubes, and garlic in a large Dutch oven; stir until tomato paste dissolves. Add peppercorns and bay leaves; bring to a simmer over medium heat."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a large skillet over medium-high heat. Add oxtail; cook until browned on all sides, about 10 minutes. Transfer oxtail to the Dutch oven. Discard all but 1 tablespoon oil from the skillet. Reduce heat to medium; add onion to the skillet. Cook until softened and translucent, about 5 minutes; transfer to the Dutch oven."
    },
    {
      "position": 3,
      "text": "Cover the Dutch oven. Reduce heat to medium-low; simmer 2 \u00bd hours. Season stew with salt and black pepper. Continue cooking, covered, until oxtail is tender, but not falling off of the bone, about 30 minutes more."
    },
    {
      "position": 4,
      "text": "Transfer oxtail to a serving dish. Add kidney beans to the Dutch oven; return to a simmer. Dissolve cornstarch in \u00bd cup water. Stir into the Dutch oven; simmer until thickened and clear, about 1 minute. Pour sauce over oxtail."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 20,

  "slug": "ploughman-s-sandwich-recipe-8737059",
  "name": "Ploughman\u2019s Sandwich",
  "recipe_type": "main",
  "brief_description": "This ploughman\u2019s sandwich recalls the classic British ploughman's cold meal, often eaten for laborers\u2019 midday break when working in the fields. These days it\u2019s a popular lunch served in UK pubs.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly butter both slices of bread."
    },
    {
      "position": 2,
      "text": "Layer the arugula, pickles, ham, Cheddar, and tomatoes on one slice of buttered bread. Spread the mustard on the remaining buttered bread slice, and place on top. Cut sandwich in half, and serve."
    }
  ],

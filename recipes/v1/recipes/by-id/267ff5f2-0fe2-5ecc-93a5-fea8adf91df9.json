  "id": "267ff5f2-0fe2-5ecc-93a5-fea8adf91df9",
  "slug": "pesto-tofu-pasta",
  "name": "Pesto Tofu Pasta",
  "recipe_type": "main",
  "brief_description": "Tofu, olives, mushrooms, and capers are cooked in a creamy pesto sauce, and served over colorful rotini pasta!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Stir in spiral pasta, and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Blend together milk, 1/4 cup olive oil, and pesto sauce mix in a medium bowl."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons olive oil in a medium skillet over medium heat. Place tofu in the skillet; season with salt and pepper. Cook and stir until evenly browned. Remove from heat and drain on paper towels."
    },
    {
      "position": 4,
      "text": "Place mushrooms into the skillet; cook about 5 minutes. Stir in olives, 2 tablespoons Parmesan cheese, and capers. Mix in tofu and pesto sauce. Continue cooking until heated through, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Serve tofu pesto sauce over spiral pasta. Top with remaining Parmesan cheese and basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

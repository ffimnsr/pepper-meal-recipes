{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0767496f-6084-5f6d-a2f4-2aa1f6564bd7",
  "slug": "streusel-topped-blueberry-muffins",
  "name": "Streusel-Topped Blueberry Muffins",
  "recipe_type": "dessert",
  "brief_description": "The sweet cinnamon streusel topping for these muffins, as well as a bit of lemon zest in the batter, really amplifies the blueberry flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Make the muffins: Place blueberries into a small bowl. Sprinkle 1 1/2 tablespoons flour over top and gently toss to coat."
    },
    {
      "position": 3,
      "text": "Combine 2 cups flour, baking powder, and salt in a medium bowl."
    },
    {
      "position": 4,
      "text": "Beat sugar and butter in a large bowl with an electric mixer until light and fluffy, 2 to 3 minutes. Beat in eggs, one at a time, then mix in vanilla and lemon zest."
    },
    {
      "position": 5,
      "text": "Without overworking the batter, gently fold in 1/2 of the dry ingredients, then all of the milk, followed by the remaining dry ingredients. Gently fold in floured blueberries; don't stir. Spoon batter into the prepared muffin cups."
    },
    {
      "position": 6,
      "text": "Make the topping: Whisk sugar, flour, and cinnamon together in a small bowl. Cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Sprinkle topping over batter in the muffin cups."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, 20 to 25 minutes. Remove from the oven and set on a wire rack to cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bb1fb5ef-9d86-5232-b472-377b70c9e05b",
  "slug": "indian-style-basmati-rice",
  "name": "Indian Style Basmati Rice",
  "recipe_type": "side",
  "brief_description": "Indian rice made with basmati rice, toasted whole spices, and fried onions has a fantastic flavor and makes the perfect side to Indian curry.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place rice into a bowl with enough water to cover. Set aside to soak for 20 minutes."
    },
    {
      "position": 3,
      "text": "In the last 10 minutes of soaking, heat oil in a large pot or saucepan over medium heat. Add cinnamon stick, cardamom pods, and cloves, then stir in cumin seed."
    },
    {
      "position": 4,
      "text": "Cook and stir until fragrant and toasted, about a minute. Add sliced onion and stir."
    },
    {
      "position": 5,
      "text": "Saut\u00e9 until the onion is tender and a rich golden brown color, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Drain water from rice, and stir into the pot. Cook and stir rice until lightly toasted, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Add water and salt, and bring to a boil. Cover and reduce heat to low. Simmer until all the water has been absorbed, about 15 minutes."
    },
    {
      "position": 8,
      "text": "Let stand for 5 minutes, then fluff with a fork before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "medium",

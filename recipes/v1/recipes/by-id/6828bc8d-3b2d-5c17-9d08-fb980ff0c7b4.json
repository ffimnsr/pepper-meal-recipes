  "slug": "garlic-mashed-potatoes-secret-recipe",
  "name": "Garlic Mashed Potatoes Secret Recipe",
  "recipe_type": "side",
  "brief_description": "Red potatoes mashed with butter, Romano cheese, garlic, salt and oregano. A new twist on a familiar favorite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 45 minutes; drain."
    },
    {
      "position": 2,
      "text": "Stir in butter, cheese, garlic, salt, and oregano. Mash with a potato masher or with an electric mixer."
    }
  ],
  "servings": 100,

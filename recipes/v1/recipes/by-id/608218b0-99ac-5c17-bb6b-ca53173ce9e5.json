{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "608218b0-99ac-5c17-bb6b-ca53173ce9e5",
  "slug": "margarets-keftedes-greek-meatballs",
  "name": "Margaret\u2019s Keftedes (Greek Meatballs)",
  "recipe_type": "appetizer",
  "brief_description": "This is my yia yia\u2019s recipe--a family favorite straight from the village of Kyparissia. Serve as an appetizer or with tzatziki, Greek salata, and pita or pasta for a full meal. They taste best served at room temp and make for wonderful leftovers. If you don\u2019t care for lamb, try using all beef instead.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Moisten the bread pieces with the milk in a large bowl, and set aside."
    },
    {
      "position": 2,
      "text": "Mince the garlic in a food processor, then add the onion, mint, salt, and pepper. Process until the onion is finely chopped."
    },
    {
      "position": 3,
      "text": "Add the onion mixture to the bowl with the moist bread, along with the beef, lamb, and eggs. Mix with your hands until thoroughly blended."
    },
    {
      "position": 4,
      "text": "Roll the mixture into balls measuring 1 1/2 to 2 inches in diameter."
    },
    {
      "position": 5,
      "text": "Place the flour in a shallow pan, and roll the balls in the flour to coat. Shake off any excess flour, and place the meatballs onto a plate or baking sheet, pressing to flatten slightly. This will keep them from rolling away."
    },
    {
      "position": 6,
      "text": "Heat 1 inch of oil in a large skillet over medium heat. Add the meatballs, 8 or 10 at a time, and cook until nicely browned on the outside, and no longer pink in the center, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Drain meatballs on a paper towel-lined plate. Repeat with remaining meatballs."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b185a941-1c85-576e-ab86-6dece0dc48c1",
  "slug": "tortilla-breakfast-bake-recipe-11944368",
  "name": "Tortilla Breakfast Bake",
  "recipe_type": "breakfast",
  "brief_description": "For this tortilla breakfast bake, accordion-folded tortillas hold thinly-sliced smoked sausage, followed by green onion, bell pepper, and cheese. Soaked in whisked eggs and half-and-half and baked, the casserole is rich, delicious, and spicy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x13 baking dish."
    },
    {
      "position": 2,
      "text": "Fold each tortilla back and forth with 1 1/2 -inch folds like an accordion. Place each folded tortilla pressed against each other in the baking dish and lightly spread them apart until they fit the length of the dish."
    },
    {
      "position": 3,
      "text": "Place thinly sliced smoked sausage in the folds of the tortillas evenly throughout."
    },
    {
      "position": 4,
      "text": "Reserve 2 tablespoons green onions for garnish and sprinkle remaining green onions evenly over tortillas. Sprinkle with bell peppers and cheese."
    },
    {
      "position": 5,
      "text": "In a medium bowl, whisk together eggs, half and half, salt, pepper and hot sauce until well blended. Pour mixture over the casserole and use a fork or spatula to work the egg mixture within the tortilla folds."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned and bubbly, about 35 minutes. Serve topped with reserved green onions, more hot sauce, or with desired toppings."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

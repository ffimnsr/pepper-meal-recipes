  "id": "b0adafc9-9d6a-5acb-8df9-fd792d40d710",
  "slug": "turkey-sloppy-joes-with-pears-recipe-11775432",
  "name": "Turkey Sloppy Joes with Pears",
  "recipe_type": "dessert",
  "brief_description": "These turkey sloppy joes with pears are extra saucy, with soft ripe pears both in the sauce and in the bun. Try Red d\u2019Anjou and Bartlett pears. A sprinkle of ground cloves adds a bittersweet dimension, but a little goes a long way.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel 1 pear; chop half of it (you should have 1/2 cup chopped). Cook ground turkey, onion, bell pepper, and chopped pear in a large nonstick skillet over medium-high heat, stirring and breaking up turkey, until browned, about 8 minutes."
    },
    {
      "position": 2,
      "text": "Stir tomato sauce, ketchup, mustard, thyme, and cloves into skillet. Bring to a boil; reduce heat to medium-low and simmer, uncovered, 10 minutes, adding a little water if needed to maintain desired consistency. Slice remaining pears; serve in buns with meat mixture."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

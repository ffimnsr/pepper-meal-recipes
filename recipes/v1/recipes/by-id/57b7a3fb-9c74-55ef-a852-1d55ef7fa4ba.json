  "id": "57b7a3fb-9c74-55ef-a852-1d55ef7fa4ba",
  "slug": "traditional-yorkshire-pudding",
  "name": "Traditional Yorkshire Pudding",
  "recipe_type": "main",
  "brief_description": "Chef John's quick and easy five-ingredient traditional Yorkshire pudding recipe is cooked in sizzling beef fat, resulting in warm, fluffy popovers.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs and salt together in a bowl until light and frothy. Whisk in milk and flour until smooth and lump-free; batter will be thin and barely coat the back of a spoon."
    },
    {
      "position": 2,
      "text": "Transfer batter to a 4-cup measuring cup. Chill in the refrigerator at least 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) with oven rack in center position."
    },
    {
      "position": 4,
      "text": "Spoon 1 tablespoon melted beef fat into cups of a 12-cup nonstick muffin tin; use your finger to grease sides and tops of cups. Place the prepared tin on a baking sheet."
    },
    {
      "position": 5,
      "text": "Place in the preheated oven until fat is smoking hot, 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven; spoon batter into the cups, filling each 1/2 full."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until browned and fully puffed, about 25 minutes. Remove from the oven; immediately poke a hole in center of each to release steam. Serve hot, warm, or room-temperature."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

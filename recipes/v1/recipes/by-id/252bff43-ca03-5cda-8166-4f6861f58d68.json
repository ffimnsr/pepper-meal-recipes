  "id": "252bff43-ca03-5cda-8166-4f6861f58d68",
  "slug": "low-carb-cauliflower-mock-potato-salad",
  "name": "Cauliflower \"Potato\" Salad",
  "recipe_type": "salad",
  "brief_description": "This cauliflower \"potato\" salad with tender cauliflower, bacon, and hard-boiled eggs is a flavor-packed low-carb version of traditional potato salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and salt to a boil over medium-high heat. Add cauliflower; bring back to a boil. Cook for 3 minutes. Remove from heat and drain."
    },
    {
      "position": 2,
      "text": "Spread cauliflower pieces onto a metal tray and freeze until cool, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine mayonnaise, celery, bacon, onion, pickles, mustard, and turmeric in a large bowl. Add cooled cauliflower and eggs; toss to combine. Season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

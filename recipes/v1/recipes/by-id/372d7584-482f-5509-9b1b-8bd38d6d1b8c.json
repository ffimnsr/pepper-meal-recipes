  "id": "372d7584-482f-5509-9b1b-8bd38d6d1b8c",
  "slug": "yummy-korean-glass-noodles-jap-chae",
  "name": "Yummy Korean-Style Glass Noodles (Japchae)",
  "recipe_type": "dessert",
  "brief_description": "My simple version of Korean-style japchae isn't traditional, but the slippery-sweet noodles are flavorful and satisfying! Delicious alone or as a side.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Break noodles into medium pieces. Place into a deep dish and cover with hot tap water. Soak for 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk boiling water, soy sauce, and brown sugar together in a 2-cup liquid measure."
    },
    {
      "position": 3,
      "text": "Drain noodles and transfer to a bowl. Pour soy mixture over top and soak for 2 minutes."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium heat. Add noodles and soy sauce mixture. Cook and stir until hot, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Transfer noodles and sauce to serving bowls. Garnish with sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

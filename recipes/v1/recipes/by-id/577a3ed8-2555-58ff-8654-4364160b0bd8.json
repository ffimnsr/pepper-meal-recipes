  "id": "577a3ed8-2555-58ff-8654-4364160b0bd8",
  "slug": "blonde-brownies-with-white-chocolate-and-cranberries",
  "name": "Blonde Brownies with White Chocolate and Cranberries",
  "recipe_type": "dessert",
  "brief_description": "These sweet and gooey blonde brownies make for a lovely afternoon treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F. Line an 8x8x2-inch baking pan with Reynolds Wrap\u00ae Aluminum Foil."
    },
    {
      "position": 2,
      "text": "Whisk together flour and baking powder."
    },
    {
      "position": 3,
      "text": "Combine brown sugar and butter in a large bowl. Mix until fully incorporated. Add egg, vanilla and flour mixture and continue mixing until fully incorporated. Fold in the chocolate chips and cranberries."
    },
    {
      "position": 4,
      "text": "Pour batter into prepared pan and bake for 35 to 40 minutes or until edges are firm and starting to pull away from sides of the pan."
    },
    {
      "position": 5,
      "text": "Cool on a wire rack for 15 minutes before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a6f4ce26-c382-5684-8fc9-7822123253cb",
  "slug": "jambalaya-in-a-jiffy",
  "name": "Jambalaya In a Jiffy",
  "recipe_type": "soup",
  "brief_description": "Using quick-cooking orzo pasta is the secret to this fast and tasty version of jambalaya made with kielbasa sausage.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large, deep skillet over medium heat; cook and stir onion and green bell pepper in the hot oil until tender, 5 to 8 minutes. Stir garlic into vegetables and cook until fragrant and softened, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Stir kielbasa sausage, tomatoes with juice, water, paprika, oregano, thyme, and hot sauce into onion mixture, bring to a boil, and stir in orzo. Reduce heat to low, cover, and simmer until orzo are tender, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

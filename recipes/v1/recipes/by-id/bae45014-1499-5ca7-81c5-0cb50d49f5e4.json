  "id": "bae45014-1499-5ca7-81c5-0cb50d49f5e4",
  "slug": "creamy-lemon-pepper-parmesan-potatoes-recipe-11997524",
  "name": "Creamy Lemon Pepper Parmesan Potatoes",
  "recipe_type": "side",
  "brief_description": "These creamy lemon pepper Parmesan potatoes are coated in a rich, velvety sauce with bright lemon, peppery spice, and plenty of cheesy Parmesan flavor. They're quick and easy enough for a weeknight meal, but delicious enough to become the highlight of the table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add halved potatoes and cook until fork-tender, 8 to 12 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add shallots and garlic, and saute for 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low, pour in cream and Parmesan cheese, and stir to combine. Simmer gently, stirring constantly, until it starts to thicken, about 4 minutes. Stir in lemon pepper until well combined. Taste, and adjust seasoning, to suit your preference."
    },
    {
      "position": 4,
      "text": "Add potatoes to skillet, and gently toss until well coated in the sauce. Sprinkle with parsley, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

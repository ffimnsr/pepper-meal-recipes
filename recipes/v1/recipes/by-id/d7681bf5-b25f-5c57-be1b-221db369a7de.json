  "id": "d7681bf5-b25f-5c57-be1b-221db369a7de",
  "slug": "pork-chops-italiano",
  "name": "Pork Chops Italiano",
  "recipe_type": "main",
  "brief_description": "Pork chops, peppers, mushrooms, and tomatoes are simmered in a savory sauce in this easy recipe that brings tons of Italian flavor to the table.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 1 teaspoon oil in a skillet over medium heat. Stir in mushrooms; cook and stir until tender, 5 to 7 minutes. Transfer to a bowl and set aside until needed."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in the skillet over medium heat. Add pork chops and cook until browned, 3 \u00bd to 5 minutes per side; transfer to a plate. Drain all but 1 tablespoon drippings from the skillet."
    },
    {
      "position": 4,
      "text": "Add onion and garlic to the skillet; cook and stir until onion has softened and turned translucent, about 5 minutes. Stir in tomatoes, basil, oregano, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Add pork chops and simmer until tender and no longer pink in the center, about 45 minutes, adding water if mixture becomes too dry. An instant-read thermometer inserted into the center of each pork chop should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Place a bell pepper slice on top of each pork chop. Add reserved mushrooms and continue to simmer until peppers are tender, 5 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "ace7f57b-9807-5873-b0ff-874d1f759a66",
  "slug": "country-club-potatoes-recipe-11872410",
  "name": "Country Club Potatoes",
  "recipe_type": "soup",
  "brief_description": "Country club potatoes are a terrific special-occasion side dish. These perfectly tender potatoes have a luxurious texture and a rich flavor enhanced by first roasting the potatoes in broth. The ingredients are simple, but the techniques in this recipe produce the best potato gratin you'll ever have.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Peel, rinse, and cut potatoes in half lengthwise. Cut each half into 3 strips, then cut across into 3/8-inch slices. Transfer slices into a large bowl of cold water and let sit for a few minutes to rinse off some of the starch. Transfer into a colander and rinse well; drain very well."
    },
    {
      "position": 3,
      "text": "Transfer potatoes to a 13x9-inch casserole dish. Sprinkle with salt, white pepper, and cayenne pepper; pour broth over and toss thoroughly with a spoon. Press everything down into an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until potato slices are just tender, about 1 hour."
    },
    {
      "position": 5,
      "text": "Meanwhile, add breadcrumbs and butter to a small bowl; stir until the mixture resembles wet sand. Set aside. Mix milk and cream together; set aside."
    },
    {
      "position": 6,
      "text": "Remove potatoes from the oven and turn oven temperature up to 450 degrees F (235 degrees C)."
    },
    {
      "position": 7,
      "text": "Pour cream mixture over potatoes, and toss thoroughly with a spoon. Spread out again into an even layer. Scatter cheese evenly over the top, followed by breadcrumbs."
    },
    {
      "position": 8,
      "text": "Bake potatoes until browned and bubbling around the edges, about 20 minutes more."
    },
    {
      "position": 9,
      "text": "Let stand for 15 minutes. Sprinkle with sliced green onions before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2b98ca94-3ea0-5ef0-aa06-afd93218b162",
  "slug": "pork-roast-with-the-worlds-best-rub",
  "name": "Pork Roast with the World\u2019s Best Rub",
  "recipe_type": "dessert",
  "brief_description": "A spicy pork loin rub featuring brown sugar, red pepper flakes, garlic, mustard, cayenne, cumin, and paprika results in a sweet and savory pork roast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix brown sugar, pepper, salt, garlic powder, mustard powder, ground ginger, onion powder, red pepper flakes, cayenne pepper, cumin, paprika, and thyme in a bowl. Rub spice mixture over pork loin and wrap tightly in plastic wrap. Place pork on a 9x13-inch baking dish and refrigerate for 4 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove plastic wrap from pork and discard; return pork to baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pork is slightly pink in the center, about 50 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Cover pork loosely with aluminum foil and let rest for 10 minutes before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

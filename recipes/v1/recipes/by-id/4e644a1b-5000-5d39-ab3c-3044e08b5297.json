  "id": "4e644a1b-5000-5d39-ab3c-3044e08b5297",
  "slug": "easy-mint-chocolate-truffles",
  "name": "Easy Mint Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "Moist, rich, chocolaty truffles made with brownie mix that taste like a soft Thin Mint(R); cookie. Fancy enough to serve for company or at a party, yet super easy and affordable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a glass 9x13-inch pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine brownie mix, oil, water, and eggs in a large bowl. Stir 50 strokes with a spoon. Spread into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 28 to 31 minutes. Remove from the oven and allow to cool slightly, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Break up warm brownies into a large bowl. Roughly chop mint thins and add to the bowl; stir until well combined, allowing the brownies' heat to slightly melt the chocolate."
    },
    {
      "position": 5,
      "text": "Form mixture into 1 1/2-inch balls, pressing firmly so they hold together. Chill in the refrigerator for 20 minutes."
    },
    {
      "position": 6,
      "text": "Combine chocolate chips and oil in a small microwave-safe bowl; microwave in 30-second intervals, stirring after each one, until melted and smooth."
    },
    {
      "position": 7,
      "text": "Dip each brownie ball into the melted chocolate and turn with a fork to coat. Lift and allow excess chocolate to drip off. Place dipped truffles onto a tray lined with waxed or parchment paper. Top with sprinkles, if desired."
    },
    {
      "position": 8,
      "text": "Refrigerate for 5 minutes (or let sit at room temperature for 20 minutes) until chocolate has set."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

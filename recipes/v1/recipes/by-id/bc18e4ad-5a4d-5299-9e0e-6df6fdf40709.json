  "id": "bc18e4ad-5a4d-5299-9e0e-6df6fdf40709",
  "slug": "coconut-overnight-oats",
  "name": "Coconut Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These wonderfully creamy overnight oats made with coconut milk, coconut flakes, and Greek yogurt make a delicious make-ahead breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, coconut milk beverage, Greek yogurt, chia seeds, and 1 tablespoon coconut flakes in an 8-ounce Mason jar. Stir until well combined, and cover with a lid. Refrigerate for 8 hours, or overnight."
    },
    {
      "position": 2,
      "text": "Top with \u00bd tablespoon coconut flakes, cacao nibs, and almonds flakes when ready to serve. Stir and enjoy."
    }
  ],

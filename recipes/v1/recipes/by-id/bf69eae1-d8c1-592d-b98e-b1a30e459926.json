  "id": "bf69eae1-d8c1-592d-b98e-b1a30e459926",
  "slug": "ultra-creamy-mashed-potatoes-from-swanson",
  "name": "Ultra Creamy Mashed Potatoes from Swanson",
  "recipe_type": "soup",
  "brief_description": "Try mashed potatoes cooked with chicken broth instead of water, for a super savory side dish. Blended with cream and butter, they're perfectly smooth!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine potatoes and chicken broth in a 3-quart saucepan over medium-high heat; bring to a boil. Reduce the heat to medium, cover, and cook until potatoes are tender, about 10 minutes. Drain potatoes well in a colander, reserving the broth."
    },
    {
      "position": 2,
      "text": "Transfer potatoes back to the pan. Add reserved broth, cream, and butter. Mash until smooth and season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

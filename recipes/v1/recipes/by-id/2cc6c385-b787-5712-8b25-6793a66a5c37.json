  "schema_version": 1,
  "id": "2cc6c385-b787-5712-8b25-6793a66a5c37",
  "slug": "air-fryer-mini-blueberry-scones",
  "name": "Air Fryer Mini Blueberry Scones",
  "recipe_type": "breakfast",
  "brief_description": "This mini blueberry scones recipe is sprinkled with a sugary orange topping that is easy to make in your air fryer and will delight your brunch guests in just 30 minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 360 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together flour, 2 tablespoons sugar, baking powder, baking soda, and salt in a medium bowl. Cut in butter with two knives or pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Beat egg with a fork in a small bowl. Remove 2 tablespoons egg to another small bowl; set aside. Add buttermilk and vanilla extract to remaining egg; whisk with the fork until combined. Stir into flour mixture until just moistened. Gently stir in blueberries."
    },
    {
      "position": 4,
      "text": "Transfer dough to a lightly floured surface. Gently knead until dough is no longer sticky, about 8 to 10 strokes. Pat dough into a 6-inch circle. Cut into 8 wedges, without separating, dipping the knife in flour between cuts."
    },
    {
      "position": 5,
      "text": "Combine remaining 2 tablespoons sugar and orange zest in a small bowl. Brush top of dough with reserved egg and sprinkle with sugar mixture. Separate dough wedges and carefully arrange them, using a small wide spatula, in a single layer in the fryer basket, in batches if necessary."
    },
    {
      "position": 6,
      "text": "Cook scones until golden brown, about 6 minutes. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "edcae22d-72af-51fe-890e-75fbace29fca",
  "slug": "boursin-deviled-eggs-recipe-8559172",
  "name": "Boursin Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These Boursin deviled eggs are every bit as easy to make as your go-to recipe, but gain a lot of flavor from Boursin garlic & herb cheese combined with the yolk mixture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Halve eggs lengthwise and scoop egg yolks into the bowl of a mini food processor; set egg whites aside. If you do not have a mini food processor, you can mash all ingredients in a bowl with a fork."
    },
    {
      "position": 2,
      "text": "Add Boursin, mayonnaise, and salt and pepper to the egg yolks; blend well until smooth, scraping down the sides of the bowl. If mixture is too thick, blend in an extra tablespoon of mayonnaise."
    },
    {
      "position": 3,
      "text": "Place yolk mixture into a resealable bag and snip off a corner. Pipe mixture into egg whites. Top with chives and refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

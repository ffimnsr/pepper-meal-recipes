  "id": "8442056c-9eba-5c6a-96d3-e773e8318eac",
  "slug": "best-bean-salad",
  "name": "Best Bean Salad",
  "recipe_type": "salad",
  "brief_description": "This bean salad is easy to make with kidney beans, black beans, garbanzo beans, green beans, and vegetables tossed in a sweet, tangy dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine garbanzo beans, kidney beans, black beans, green beans, wax beans, green pepper, onion, and celery in a large bowl; toss to mix."
    },
    {
      "position": 3,
      "text": "Whisk together sugar, oil, vinegar, salt, and pepper in a separate bowl until sugar is dissolved; pour over bean mixture. Mix well."
    },
    {
      "position": 4,
      "text": "Refrigerate salad until ready to serve."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 18,

  "id": "c72631c2-a1b0-58af-92cc-babbb875da7f",
  "slug": "air-fryer-cinnamon-sugar-doughnuts",
  "name": "Air Fryer Cinnamon-Sugar Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "These doughnuts have a cinnamon-sugar coating which provides a lot of flavor, but cooking them in the air fryer makes them healthier with fewer calories.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place melted butter in a bowl. Combine white sugar, brown sugar, cinnamon and nutmeg in a second bowl."
    },
    {
      "position": 2,
      "text": "Separate biscuit dough into individual biscuits and cut out the centers using a biscuit cutter (or the bottom of a piping tip) to create a doughnut shape. Place doughnuts in the air fryer basket."
    },
    {
      "position": 3,
      "text": "Air fry at 350 degrees F (175 degrees C) until golden brown, 4 to 6 minutes. Flip doughnuts and cook an additional 1 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove doughnuts from air fryer. Dip each doughnut into melted butter (making sure to coat top, bottom, and sides), followed by sugar-cinnamon mixture until completed coated. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

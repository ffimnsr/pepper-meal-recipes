  "id": "31a25e33-8d85-5bb0-83ac-d72b0a7cb2a2",
  "slug": "chicken-parmigiana",
  "name": "Chicken Parmigiana",
  "recipe_type": "main",
  "brief_description": "This chicken parmigiana recipe is made with breaded chicken breasts baked with spaghetti sauce and cheese in this tasty, family-friendly Italian dish.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium baking sheet."
    },
    {
      "position": 2,
      "text": "Pour egg into a small shallow bowl. Place bread crumbs in a separate shallow bowl. Dip chicken into egg, then into bread crumbs. Place coated chicken on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until no longer pink and juices run clear, about 40 minutes. Remove from the oven."
    },
    {
      "position": 4,
      "text": "Pour 1/2 of the spaghetti sauce into a 7x11-inch baking dish. Place chicken breasts over the sauce, then cover with remaining sauce. Sprinkle mozzarella and Parmesan cheeses on top."
    },
    {
      "position": 5,
      "text": "Continue baking until heated through and cheeses have melted, about 20 more minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

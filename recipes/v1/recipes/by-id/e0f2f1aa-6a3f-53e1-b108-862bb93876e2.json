  "id": "e0f2f1aa-6a3f-53e1-b108-862bb93876e2",
  "slug": "sous-vide-eye-of-round",
  "name": "Sous Vide Eye of Round",
  "recipe_type": "main",
  "brief_description": "The long, slow cooking process of sous vide turns this eye of round roast into a juicy, fork-tender main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together salt, garlic granules, onion powder, and pepper in a small bowl."
    },
    {
      "position": 2,
      "text": "Trim and discard any fat from roast. Rub the roast with enough Worcestershire sauce to coat. Rub seasoning mixture over the entire surface of the roast."
    },
    {
      "position": 3,
      "text": "Place seasoned roast into a vacuum bag and seal using a vacuum sealer. Immerse the bag in a heat-proof container of water with a sous vide cooker. Set temperature to 134 degrees F (57 degrees C); cook for 18 hours. Wrap the top of the pot with plastic wrap; this will help retain water."
    },
    {
      "position": 4,
      "text": "When the time is up, remove roast from the bag and pat completely dry with paper towels."
    },
    {
      "position": 5,
      "text": "Heat 2 tablespoons avocado oil in a large skillet over high heat until it shimmers. Add roast and sear until evenly browned, 2 to 3 minutes per side, adding more avocado oil if necessary."
    },
    {
      "position": 6,
      "text": "Move the roast to a serving dish and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 1090,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

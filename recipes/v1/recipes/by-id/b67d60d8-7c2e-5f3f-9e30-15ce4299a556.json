  "id": "b67d60d8-7c2e-5f3f-9e30-15ce4299a556",
  "slug": "chef-johns-scones",
  "name": "Chef John\u2019s Scones",
  "recipe_type": "side",
  "brief_description": "These light and tender scones are perfect with jam, marmalade, or clotted cream.",
  "cuisine": "Uk And Ireland",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, and salt together in a mixing bowl. Cut in butter with a knife or pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Stir together 1/2 cup milk, currants, and sour cream in a small bowl; stir into flour mixture with a fork until just moistened and holding together."
    },
    {
      "position": 4,
      "text": "Transfer dough to a lightly floured surface and pat into a rectangle. Fold the rectangle into thirds. Turn dough a half turn, gather any crumbs, and flatten back into a rectangle; repeat once more. Cut the rectangle into eight triangular pieces and transfer to a silicone baking mat."
    },
    {
      "position": 5,
      "text": "Whisk egg and 1 tablespoon milk together in a small bowl. Brush egg wash over the top of each scone."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until scones have risen and turned golden brown, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and transfer to wire rack to cool."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

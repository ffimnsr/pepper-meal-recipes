  "id": "289a3501-c199-524e-8cb2-7ce419a65f90",
  "slug": "instant-pot-midwest-goulash",
  "name": "Instant Pot Midwest Goulash",
  "recipe_type": "soup",
  "brief_description": "This lighter version of Midwest goulash made with ground turkey, macaroni, and vegetables is easy to prepare in your Instant Pot.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select the Saut\u00e9 function. Add olive oil and turkey; cook until halfway browned and crumbly, 3 to 4 minutes. Stir in carrots, onion, bell pepper, Italian seasoning, garlic powder, seasoned salt, and black pepper."
    },
    {
      "position": 2,
      "text": "Mix water, Worcestershire sauce, and bouillon granules together in a small bowl. Pour into meat mixture and stir until well combined. Bring to a simmer, then stir in macaroni and paprika. Add tomatoes and tomato sauce, making sure not to stir after this addition. Close and lock the lid. Set the timer for 4 minutes. Allow about 10 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 4,
      "text": "Mix well before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

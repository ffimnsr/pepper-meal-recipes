{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5bfd202a-d0df-56c3-af1a-526d0585f5b5",
  "slug": "greek-lemon-chicken-orzo-casserole-recipe-11880811",
  "name": "Greek Lemon Chicken Orzo Casserole",
  "recipe_type": "main",
  "brief_description": "This Greek lemon chicken orzo casserole features Greek-seasoned chicken, tomatoes, zucchini, and olives in a cozy one-dish dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and grease an 8x8-inch oven-safe dish. Sprinkle orzo over the bottom of the prepared pan."
    },
    {
      "position": 2,
      "text": "Combine olive oil, mustard, Greek seasoning and chicken in a resealable plastic bag, seal, and move the chicken pieces inside the bag until evenly coated with seasoning."
    },
    {
      "position": 3,
      "text": "Place seasoned chicken in an even layer over orzo in the prepared pan. Sprinkle cherry tomatoes, bell pepper, zucchini, olives, and 1/4 cup crumbled feta evenly over chicken."
    },
    {
      "position": 4,
      "text": "In a small bowl, stir together chicken broth and Greek yogurt and pour over the dish, submegring chicken and orzo."
    },
    {
      "position": 5,
      "text": "Bake in the center of the preheated oven until chicken is no longer pink at the center and juices run clear, 35 to 40 minutes. An instant read thermometer inserted near the center of chicken should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove from the oven and stir in remaining crumbled feta, parsley, and lemon juice. Taste; season with salt and pepper. Cover with foil, and let stand 10 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with parsley and lemon slices, if desired, and serve warm."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

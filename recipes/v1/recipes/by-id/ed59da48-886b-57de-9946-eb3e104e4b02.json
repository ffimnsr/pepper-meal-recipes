  "id": "ed59da48-886b-57de-9946-eb3e104e4b02",
  "slug": "white-bean-pate",
  "name": "White Bean Pate",
  "recipe_type": "appetizer",
  "brief_description": "Here's a vegetarian-friendly option for a liver pate-like spread packed with flavor.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease a serving bowl with butter."
    },
    {
      "position": 2,
      "text": "Pour olive oil into a skillet; add white pepper, smoked paprika, and cayenne pepper. Place the skillet over medium heat and warm the spices until fragrant, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir shallot into the warm oil and spices; cook and stir until the shallot begins to change color, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir cannellini beans and tomato paste into the shallot and spice mixture. Cook and stir while mashing the beans thoroughly, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir sherry and soy sauce through the mashed bean mixture; cook until the liquid evaporates, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Remove the skillet from heat. Stir melted butter through the bean mixture; season with salt. Pack the bean mixture into the prepared bowl."
    },
    {
      "position": 7,
      "text": "Chill in refrigerator at least 1 hour; garnish with parsley and paprika to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "474c12b0-a395-50d4-a35e-f858d07a7813",
  "slug": "curried-butternut-squash-soup",
  "name": "Curried Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This curried butternut squash soup is rich, creamy, and perfectly spiced with curry powder for a satisfying soup full of sweet and spicy flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large pot over medium heat. Add onion and garlic; cook and stir until softened and browned, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in broth, butternut squash, curry powder, salt, cumin, and cayenne pepper; bring to a boil. Reduce the heat to low and simmer until squash is tender, about 15 minutes. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Stir in half-and-half and honey. Puree soup with an immersion blender until smooth."
    },
    {
      "position": 5,
      "text": "Ladle soup into serving bowls and top with a sour cream dollop."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "10e4952a-4b42-5dc1-b24b-40181cfa3481",
  "slug": "air-fryer-okra-fries",
  "name": "Air Fryer Okra \"Fries\"",
  "recipe_type": "side",
  "brief_description": "If you like the taste of deep-fried okra, cut down on the fat and try this wonderfully crispy, lower-calorie version made in an air fryer.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Wash and dry okra, trim stems and tips, and slice in half, lengthwise. Place in a bowl and toss with olive oil and seasoned salt."
    },
    {
      "position": 3,
      "text": "Put okra slices, cut-sides down, in the basket of an air fryer, in batches if necessary, and cook until crispy, 12 to 15 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

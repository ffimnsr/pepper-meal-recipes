  "id": "76c4bc02-8d8b-5658-9a1b-1cd8b36edffd",
  "slug": "keto-open-faced-chicken-cordon-bleu",
  "name": "Keto Open-Faced Chicken Cordon Bleu",
  "recipe_type": "main",
  "brief_description": "This recipe has all the flavors of chicken cordon bleu but is keto-friendly and easier to assemble since there is no stuffing or rolling involved.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Season chicken cutlets with salt and pepper; set aside."
    },
    {
      "position": 3,
      "text": "Whisk eggs and Dijon mustard together in a shallow bowl. Combine almond flour, Parmesan cheese, and garlic powder in a separate shallow bowl. Dip chicken cutlets into egg mixture, letting excess drip off. Dredge with almond flour mixture, then set on a plate."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken cutlets and cook until golden brown, 3 to 4 minutes. Flip over and cook until chicken is no longer pink inside and the juices are running clear, 3 to 4 minutes more."
    },
    {
      "position": 5,
      "text": "Place chicken cutlets on a baking sheet. Top with ham slices and cover with Swiss cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese has melted, 4 to 5 minutes. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

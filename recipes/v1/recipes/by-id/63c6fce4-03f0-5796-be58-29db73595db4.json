  "id": "63c6fce4-03f0-5796-be58-29db73595db4",
  "slug": "cheesy-chile-eggrolls",
  "name": "Cheesy Chile Eggrolls",
  "recipe_type": "appetizer",
  "brief_description": "These cheesy chile eggrolls are deep-fried and use only 3 ingredients - eggroll wrappers, fire-roasted green chiles, and pepper Jack cheese.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggroll wraps on a work surface. Place 1 whole green chile diagonally on the wrap. Add about 2 tablespoons pepper Jack cheese, or enough to cover chile. Fold bottom corner over filling. Roll snugly halfway to cover filling. Fold in both sides snugly against filling to look like an envelope; moisten edges of last flap with a moistened finger. Roll wrap up and seal top corner using water again to moisten edges to make them stick. Lay flap-side down until ready to cook. Repeat with remaining ingredients."
    },
    {
      "position": 2,
      "text": "Heat canola oil in a deep saucepan over medium heat to 350\u00b0F. Lower eggrolls with the flap side down carefully into the hot oil in batches. Fry until golden, turning occasionally, 2 to 3 minutes. Transfer to a plate lined with paper towels to drain. Repeat with remaining eggrolls."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "87722566-3096-54f8-9359-71d9f2295656",
  "slug": "marshmallow-fondant",
  "name": "Marshmallow Fondant",
  "recipe_type": "dessert",
  "brief_description": "Marshmallow fondant made with mini marshmallows. This sweet, tasty, and fun rolled fondant is much easier to make than a traditional boiled fondant.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place butter in a shallow bowl and set aside until needed for kneading."
    },
    {
      "position": 3,
      "text": "Place marshmallows in a large microwave-safe bowl and microwave on high to start melting the marshmallows, 30 seconds to 1 minute."
    },
    {
      "position": 4,
      "text": "Carefully stir water and vanilla into hot marshmallows; stir until the mixture is smooth."
    },
    {
      "position": 5,
      "text": "Slowly beat in confectioners' sugar, 1 cup at a time, until you have a sticky dough. Reserve 1 cup confectioners' sugar for kneading. The dough will be very stiff."
    },
    {
      "position": 6,
      "text": "Rub your hands thoroughly with butter and begin kneading the sticky dough. As you knead, the dough will become workable and pliable. Turn the dough out onto a working surface dusted with confectioners' sugar and continue kneading until the fondant is smooth and no longer sticky to the touch, 5 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Form the fondant into a ball, wrap it tightly in plastic wrap, and refrigerate, 8 hours to overnight."
    },
    {
      "position": 8,
      "text": "To use, allow the fondant to come to room temperature and roll it out onto a flat surface dusted with confectioners' sugar."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,

  "id": "0089d1e9-038c-50bb-91ef-9a0cc4af58d8",
  "slug": "easy-pecan-pie",
  "name": "Easy Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie recipe makes an easy corn syrup, egg, and sugar filling to pour over whole pecans in an unbaked crust for a favorite holiday dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat eggs, corn syrup, sugar, butter, and vanilla together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Arrange pecans in bottom of pie crust and pour syrup mixture over."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a knife inserted 1 inch from the edge comes out clean, about 1 hour. Allow pie to cool before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

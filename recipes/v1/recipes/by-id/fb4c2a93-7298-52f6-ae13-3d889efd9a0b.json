  "id": "fb4c2a93-7298-52f6-ae13-3d889efd9a0b",
  "slug": "vegan-energy-balls",
  "name": "Vegan Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "Who needs chocolate? These vegan energy balls with protein powder, nuts, and seeds are sweetened with agave and dried apple slices and rolled in a tasty cinnamon-almond coating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground almonds and cinnamon in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Mix almond butter, agave syrup, and protein powder together in a bowl. Add shredded coconut, coconut sap, and nutmeg."
    },
    {
      "position": 3,
      "text": "Combine pumpkin, flax, and sesame seeds in the bowl of a food processor; pulse until blended. Add to almond butter mixture along with sunflower seeds."
    },
    {
      "position": 4,
      "text": "Mince dried apple in the food processor. Add to almond butter mixture along with walnuts. Form into 1-inch balls and roll in the almond-cinnamon mixture to coat."
    },
    {
      "position": 5,
      "text": "Place in the freezer to firm up and store."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,

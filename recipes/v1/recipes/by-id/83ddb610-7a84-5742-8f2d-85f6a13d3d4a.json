  "id": "83ddb610-7a84-5742-8f2d-85f6a13d3d4a",
  "slug": "danish-cinnamon-snails",
  "name": "Danish Cinnamon Snails",
  "recipe_type": "breakfast",
  "brief_description": "This Danish cinnamon snails recipe makes a cardamom-spiced dough that\u2019s delicious beyond all others. Frost with a simple sugar glaze, if you like.",
  "cuisine": "Danish",
  "instructions": [
    {
      "position": 1,
      "text": "Pour warm milk into a bowl; mash in yeast cakes. Mix in butter, eggs, sugar, cardamom, salt, and 3 1/2 cups flour. Use a wooden spoon to mix dough together. If very sticky, add remaining 1/2 cup flour. Cover the bowl; let dough rise for 30 minutes."
    },
    {
      "position": 2,
      "text": "Beat together butter and sugar in a medium bowl until filling is creamy. Stir in cinnamon until combined. Set aside."
    },
    {
      "position": 3,
      "text": "Transfer dough to a floured surface; knead until firm, about 3 minutes. Divide dough in half; roll each half into a 1/2-inch thick rectangle. Spread each rectangle with 1/2 of the filling."
    },
    {
      "position": 4,
      "text": "Stack dough rectangles on top each other, filling-side up. Roll dough into a log starting with edge closest to you. Cut log into 1-inch-thick slices."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper. Alternatively, grease a baking dish or 2 cake pans if you prefer pull-apart rolls."
    },
    {
      "position": 6,
      "text": "Place rolls on the prepared baking sheet about 3 inches apart. If baking pull-apart rolls, arrange in the prepared baking dish or cake pans about 1 inch apart. Let rolls rest at room temperature for 20 minutes."
    },
    {
      "position": 7,
      "text": "Bake rolls in the preheated oven until golden brown, about 10 minutes. Pull-apart rolls will take longer. Reduce the oven temperature to 350 degrees F (175 degrees C). Continue baking until sides are fully set, about 10 minutes more. Cover rolls with foil if browning too quickly."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

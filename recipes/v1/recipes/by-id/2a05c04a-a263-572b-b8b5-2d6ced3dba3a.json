  "id": "2a05c04a-a263-572b-b8b5-2d6ced3dba3a",
  "slug": "cinnamon-and-ginger-caramelized-pumpkin-seeds",
  "name": "Cinnamon and Ginger Caramelized Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "Save your pumpkin seeds, toss them in a buttery cinnamon and ginger mixture, and bake into sweet and spicy pumpkin seeds for Halloween!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 275 degrees F (135 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine 1 1/2 tablespoons butter and 1 tablespoon brown sugar together in a bowl; add cinnamon, ginger, and salt and mix well. Stir pumpkin seeds into butter mixture until evenly coated. Spread seeds in an even layer onto the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes; check seeds and continue baking for 10 minutes more."
    },
    {
      "position": 4,
      "text": "Mix the remaining 2 tablespoons brown sugar and 1 1/2 teaspoons butter together in a bowl and stir onto the pumpkin seeds."
    },
    {
      "position": 5,
      "text": "Continue baking seeds until toasted and fragrant, about 10 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

  "id": "6c1b704e-e6d1-58ad-996e-ec10287cda44",
  "slug": "kettle-corn",
  "name": "Kettle Corn",
  "recipe_type": "appetizer",
  "brief_description": "This kettle corn recipe is made on the stovetop with just three ingredients and tastes deliciously old-fashioned and straight from the county fair.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather this ingredients."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large pot over medium heat. Stir in popcorn kernels and sugar."
    },
    {
      "position": 3,
      "text": "Cover and shake the pot constantly to prevent sugar from burning. When popping has slowed to once every 2 to 3 seconds, remove the pot from the heat and shake for a few minutes until popping stops."
    },
    {
      "position": 4,
      "text": "Pour popcorn into a large bowl and allow to cool, stirring occasionally to break up large clumps."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

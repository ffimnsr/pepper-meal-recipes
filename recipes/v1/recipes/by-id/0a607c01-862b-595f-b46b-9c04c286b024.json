  "id": "0a607c01-862b-595f-b46b-9c04c286b024",
  "slug": "scarborough-fair-roasted-vegetables-recipe-11763940",
  "name": "Scarborough Fair Roasted Vegetables",
  "recipe_type": "side",
  "brief_description": "These Scarborough Fair roasted vegetables featuring potatoes and carrots recall the old song lyrics and are seasoned with parsley, sage, rosemary, and thyme.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C) and place an oven rack in the lowest position. Prepare a rimmed sheet pan with foil or parchment paper."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine carrots and red potatoes."
    },
    {
      "position": 3,
      "text": "Combine olive oil, sage, rosemary, thyme, salt, and pepper in a bowl. Mix well."
    },
    {
      "position": 4,
      "text": "Pour half of olive oil-herb mixture over potatoes and carrots, stir well, and spread in a single layer on the prepared pan."
    },
    {
      "position": 5,
      "text": "Roast in the lowest position in the preheated oven, about 20 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, add garlic to remaining olive oil and herb mixture and stir well."
    },
    {
      "position": 7,
      "text": "Combine onion, zucchini, and mushrooms in the same bowl used for potatoes and carrots. Add garlic-olive oil-herb mixture and stir well."
    },
    {
      "position": 8,
      "text": "At the 20 minute mark, remove sheet pan from the oven and add seasoned onion, zucchini, and mushrooms. Stir to combine, and spread vegetables evenly in the sheet pan."
    },
    {
      "position": 9,
      "text": "Return to the oven and roast until as tender as you like, 20 to 25 minutes more. Garnish with minced fresh parsley. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

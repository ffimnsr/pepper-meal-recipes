  "id": "6fef5fe0-12ec-54fb-adc2-346d9f9c6389",
  "slug": "crockpot-buffalo-chicken-chili-recipe-8710670",
  "name": "Crockpot Buffalo Chicken Chili",
  "recipe_type": "soup",
  "brief_description": "This incredibly easy crockpot buffalo chicken chili is simply delicious. Just add all the ingredients to the slow cooker and a few hours later you have the most flavorfull buffalo chicken chili imaginable!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "In a 6-quart slow cooker, stir together beans, diced tomatoes with garlic, onion, bell pepper, hot sauce, chili powder, and garlic powder; nestle chicken in bean mixture."
    },
    {
      "position": 3,
      "text": "Cover and cook until chicken is tender, about 3 hours on HIGH and 5 hours on LOW."
    },
    {
      "position": 4,
      "text": "Meanwhile, stir together yogurt and ranch dressing mix in a small bowl until smooth. Cover and refrigerate until ready to serve."
    },
    {
      "position": 5,
      "text": "Remove chicken from slow cooker and shred it using two forks."
    },
    {
      "position": 6,
      "text": "Return shredded chicken to slow cooker. Stir in cream cheese until smooth and well combined. Cover and cook on HIGH until warmed through, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Serve with a dollop of yogurt mixture. Garnish with scallions and serve with tortilla chips, if desired. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 15,

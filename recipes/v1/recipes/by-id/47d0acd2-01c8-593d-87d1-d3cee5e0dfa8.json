  "schema_version": 1,
  "id": "47d0acd2-01c8-593d-87d1-d3cee5e0dfa8",
  "slug": "jeris-spicy-buffalo-wings",
  "name": "Jeri's Spicy Buffalo Wings",
  "recipe_type": "appetizer",
  "brief_description": "The sauce in this recipe is made with butter and hot sauce, while the wings have their own flavor from marinating in apple cider vinegar seasoned with onion salt, garlic salt, paprika, and red pepper flakes.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Toss chicken wings in a large bowl with apple cider vinegar, garlic salt, paprika, red pepper flakes, onion salt, and black pepper to coat; cover the bowl with plastic wrap and marinate in the refrigerator for 1 to 4 hours."
    },
    {
      "position": 2,
      "text": "Scatter flour over chicken wings; toss to coat. Discard any remaining marinade."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 4,
      "text": "Heat shortening in a large skillet over medium-high heat; fry chicken in hot shortening until golden, 5 to 7 minutes per side. Transfer fried chicken to a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake chicken in the preheated oven until no longer pink at the bone and the juices run clear, about 20 minutes. Remove chicken to a paper towel-lined platter to drain."
    },
    {
      "position": 6,
      "text": "Make sauce: Melt butter in a large skillet over medium heat. Cook garlic in melted butter until translucent, about 2 minutes. Stir hot sauce into butter-garlic mixture; reduce heat to low and simmer for 5 minutes. Transfer sauce to a large bowl."
    },
    {
      "position": 7,
      "text": "Working in batches, add chicken to sauce in the bowl and turn to coat. Drizzle any remaining sauce over wings to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

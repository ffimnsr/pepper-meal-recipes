  "slug": "ahi-poke-basic",
  "name": "Ahi Tuna Poke",
  "recipe_type": "salad",
  "brief_description": "This easy poke recipe is a Hawaiian salad of cubed ahi tuna tossed with soy sauce, sesame oil, and green onions for a dish full of umami flavor.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place tuna in a medium non-reactive bowl. Add soy sauce, green onions, sesame oil, sesame seeds, macadamia nuts, and red pepper flakes; mix well. Cover and refrigerate at least 2 hours before serving."
    },
    {
      "position": 3,
      "text": "Serve over rice."
    }
  ],
  "servings": 4,

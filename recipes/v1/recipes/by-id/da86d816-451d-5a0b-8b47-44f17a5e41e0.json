  "id": "da86d816-451d-5a0b-8b47-44f17a5e41e0",
  "slug": "easy-pecan-pie-cheesecake",
  "name": "Easy Pecan Pie Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This decadent pecan pie cheesecake is sure to be an instant hit with family and friends at your next holiday party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, sugar, egg, vanilla extract, and salt for pie together in a bowl until creamy. Spread evenly over the bottom of the unbaked pie crust, then sprinkle pecans evenly over top."
    },
    {
      "position": 3,
      "text": "Combine corn syrup, eggs, sugar, and vanilla for topping together in a bowl. Beat until smooth. Pour over pecan layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pecan layer is golden brown, 35 to 45 minutes. Let cool on a wire rack. Serve slightly warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

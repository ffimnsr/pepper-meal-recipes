{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "97981e00-ab5c-56f7-8b02-4c0c6a1803e5",
  "slug": "poochie-meat-cakes",
  "name": "Poochie Meat Cakes",
  "recipe_type": "dessert",
  "brief_description": "Rover's tail will really wag when you serve him these healthful, homemade treats for dogs that blend ground beef, brown rice, eggs, and oatmeal with grated potatoes, carrots, and celery. Baked in convenient, portion-sized muffin cups, they're easy to make and freeze well.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease 36 cups of 3 large muffin tins."
    },
    {
      "position": 2,
      "text": "In a medium saucepan, combine rice with water. Bring to a boil over high heat, uncovered, and cook 10 minutes. Reduce heat to low, cover, and simmer 20 minutes. Remove from heat, let cool for several minutes, then fluff with a fork and set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine potatoes, carrots, celery, ground beef, and eggs. Mix ingredients together using your hands or a sturdy spoon. Add salt, olive oil, rolled oats, and rice; mix well."
    },
    {
      "position": 4,
      "text": "Fill each muffin cup with some meat mixture, and pat down to make it firm. Bake 45 minutes, or until surface feels set. Cool on a rack 10 minutes or longer."
    },
    {
      "position": 5,
      "text": "Remove meat cakes by turning the muffin tin upside down over a sheet of aluminum foil. Tap each muffin cup to release the cake. Refrigerate or freeze in sealed plastic bags. NOTE: Do not feed dogs while still hot."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 35,

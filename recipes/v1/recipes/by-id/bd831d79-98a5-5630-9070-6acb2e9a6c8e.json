  "id": "bd831d79-98a5-5630-9070-6acb2e9a6c8e",
  "slug": "roast-beef-and-cheddar-frittata",
  "name": "Roast Beef and Cheddar Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Let this recipe teach you a very easy way to turn delicatessen roast beef and Cheddar cheese into a delicious brunch-style egg frittata.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare a 2-quart shallow baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir eggs and cream of mushroom soup together in a large bowl until smooth. Stir Cheddar cheese, roast beef, and black pepper into the egg mixture."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until set in the the center and golden brown on top, 45 to 50 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

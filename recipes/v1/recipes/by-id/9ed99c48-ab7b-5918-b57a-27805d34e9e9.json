{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9ed99c48-ab7b-5918-b57a-27805d34e9e9",
  "slug": "eggs-in-a-basket",
  "name": "Eggs in a Basket",
  "recipe_type": "breakfast",
  "brief_description": "Perfectly cooked eggs baked in a basket of golden grated potatoes topped with cheese. A simple and delicious breakfast that'll brighten any day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large 6-cup muffin tin or 6 (6-ounce) custard cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix potatoes, melted butter, salt, and pepper together in a large bowl."
    },
    {
      "position": 3,
      "text": "Divide potato mixture among cups. Press to create a thin crust over the bottom and up the sides of each cup."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are a light golden brown and potatoes are tender, about 30 to 40 minutes. Crack an egg gently into each cup. Continue cooking until egg whites are set and yolk is runny, 10 to 15 minutes. Remove from the oven; cover eggs with provolone cheese."
    },
    {
      "position": 5,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 6,
      "text": "Toss prosciutto with maple syrup and pepper in a small bowl. Spread out on a small baking sheet lined with aluminum foil."
    },
    {
      "position": 7,
      "text": "Place egg baskets and baking sheet under the preheated broiler. Broil until cheese is melted on top of baskets and prosciutto is crisp, about 1 minute."
    },
    {
      "position": 8,
      "text": "Transfer egg baskets to a serving plate. Chop prosciutto and sprinkle on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

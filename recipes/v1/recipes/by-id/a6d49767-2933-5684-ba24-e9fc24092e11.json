  "id": "a6d49767-2933-5684-ba24-e9fc24092e11",
  "slug": "old-italian-meat-sauce",
  "name": "Old Italian Meat Sauce",
  "recipe_type": "main",
  "brief_description": "This Italian meat sauce made with beef, pork, tomato, and mushroom, flavored with dried herbs and red wine, is a must at your next spaghetti dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium heat. Cook beef and pork in the hot skillet until crumbly and no longer pink, 5 to 7 minutes. Remove from the heat and set aside."
    },
    {
      "position": 2,
      "text": "Warm olive oil in another large skillet over medium heat. Saut\u00e9 onions and garlic in hot oil until onions are tender, about 5 minutes. Pour in 1/2 cup wine; mix well."
    },
    {
      "position": 3,
      "text": "Add mushrooms, oregano, rosemary, and thyme to onion mixture. Pour in another 1/2 cup wine; cook and stir until mushrooms are tender, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add browned meat, tomato sauce, and tomato paste to mushroom mixture. Reduce the heat and simmer for 1 hour."
    },
    {
      "position": 5,
      "text": "Pour in remaining 2 cups wine. Continue simmering for 2 to 3 hours, stirring occasionally; serve."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 30,

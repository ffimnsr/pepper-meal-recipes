  "id": "b2e5a86b-f982-5ee9-87db-eaf3f5dfd06e",
  "slug": "buttermilk-chocolate-cake",
  "name": "Buttermilk-Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist ganache-topped buttermilk chocolate Bundt cake is destined to become a family favorite at gatherings and birthday parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt\u00ae)."
    },
    {
      "position": 2,
      "text": "Bring 1/2 cup milk to a boil over medium heat. Remove from the heat and add bittersweet chocolate. Let stand for 5 minutes. Stir until smooth, then let cool for 30 minutes."
    },
    {
      "position": 3,
      "text": "Stir all-purpose flour, whole wheat flour, baking powder, baking soda, and salt together in a medium bowl."
    },
    {
      "position": 4,
      "text": "Beat sugar and margarine in a large bowl with an electric mixer until fluffy. Add eggs, 1 at a time, beating briefly after each addition. Mix in Irish cream liqueur and cooled chocolate mixture. Add flour mixture in 3 batches, alternating with buttermilk, stirring batter briefly after each addition. Pour batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top springs back when lightly touched, 50 to 55 minutes. Cool on a wire rack for 10 minutes. Tap the pan a few times and shake it gently to loosen cake. Invert carefully onto a serving plate and let cool completely, about 20 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, heat milk and oil for ganache in a saucepan over medium heat until boiling. Remove from the heat and add milk chocolate. Let stand for 5 minutes. Stir until smooth, then let cool for 15 minutes. Spread onto cooled cake."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

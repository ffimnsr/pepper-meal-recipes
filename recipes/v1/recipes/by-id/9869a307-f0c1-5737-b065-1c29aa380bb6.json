  "id": "9869a307-f0c1-5737-b065-1c29aa380bb6",
  "slug": "magic-lemon-cobbler-recipe-11979315",
  "name": "Magic Lemon Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This magic lemon cobbler combines a buttery, golden topping with a bright lemon filling for an easy dessert that practically makes itself. Serve it warm with vanilla ice cream, whipped cream, or fresh berries (or all three!) for the perfect sweet-tart treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butter in a 2-quart square glass baking dish; melt in the microwave, about 1 minute."
    },
    {
      "position": 3,
      "text": "Whisk together flour, sugar, baking powder, and salt in a bowl. Whisk in milk, sour cream, vanilla, and lemon zest until smooth."
    },
    {
      "position": 4,
      "text": "Pour batter gently over the butter in the baking dish, do not stir together."
    },
    {
      "position": 5,
      "text": "Drop pie filling in spoonfuls over the batter. Do not stir."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, 45 to 50 minutes."
    },
    {
      "position": 7,
      "text": "Cool on a wire rack 15 minutes before serving."
    },
    {
      "position": 8,
      "text": "Serve with ice cream, whipped cream, and/or dust with powdered sugar."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

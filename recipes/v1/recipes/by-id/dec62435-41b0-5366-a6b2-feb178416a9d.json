  "id": "dec62435-41b0-5366-a6b2-feb178416a9d",
  "slug": "ooey-gooey-fluffernutter-rolls-recipe-11908971",
  "name": "Ooey Gooey Fluffernutter Rolls",
  "recipe_type": "dessert",
  "brief_description": "These ooey gooey fluffernutter rolls may be the best use of Hawaiian rolls ever. Spread with peanut butter and marshmallow creme, brush with cinnamon-sugar-butter, bake until toasty. Oooh la la!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Slice rolls in half lengthwise, while keeping the tops and bottoms connected. Place bottoms on a lined baking sheet."
    },
    {
      "position": 2,
      "text": "Spread peanut butter over the bottom halves of rolls and top evenly with marshmallow creme. Place the top halves on top."
    },
    {
      "position": 3,
      "text": "Brush tops evenly with melted butter. Stir together sugar and cinnamon and sprinkle evenly over tops of rolls."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until rolls are toasted, about 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

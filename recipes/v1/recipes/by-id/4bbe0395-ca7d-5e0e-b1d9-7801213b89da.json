  "id": "4bbe0395-ca7d-5e0e-b1d9-7801213b89da",
  "slug": "scallop-and-bacon-spaghetti-recipe-11830436",
  "name": "Scallop and Bacon Spaghetti",
  "recipe_type": "main",
  "brief_description": "This scallop and bacon spaghetti is made with bay scallops\u2014small, hearty, and less expensive than sea scallops. This is a perfect budget-friendly dinner for two, a tasty, quick-and-easy weeknight meal that\u2019s on the table in under a half hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil, add spaghetti and cook until tender, yet firm to bite, about 10 minutes, or to your desired preference. Drain well."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a large skillet over medium heat, add bacon, and cook until crisp, 3 to 4 minutes. Remove to a paper towel, set aside, and leave bacon fat in skillet."
    },
    {
      "position": 3,
      "text": "Dry and lightly press scallops with a paper towel to remove moisture, and add to skillet. Sprinkle with garlic and red pepper flakes, and stir until scallops are tender, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add the spaghetti to the skillet, and toss until well combined. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Crumble bacon into the pasta, sprinkle with parsley, and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

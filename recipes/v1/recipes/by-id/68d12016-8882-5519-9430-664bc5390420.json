  "id": "68d12016-8882-5519-9430-664bc5390420",
  "slug": "banana-zucchini-bread-muffins",
  "name": "Banana Zucchini Bread Muffins",
  "recipe_type": "breakfast",
  "brief_description": "Two quick bread recipes are combined into a healthy banana zucchini bread recipe made with oats and applesauce that can be baked as muffins or loaves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 36 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine mashed bananas, white sugar, zucchini, applesauce, eggs, brown sugar, and vanilla extract in a bowl. Sift all-purpose flour, whole wheat flour, cinnamon, salt, baking soda, and baking powder together over banana mixture; stir in oats until just combined. Divide batter among the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 20 minutes. Completely cool muffins in the tins before removing."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

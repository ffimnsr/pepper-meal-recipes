  "id": "5afe713c-9af2-5537-9a21-2f8f621eca6d",
  "slug": "sweet-potato-pie-ix",
  "name": "Southern Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pie recipe makes two tasty pies that smell amazing as they bake. Delicious at Thanksgiving or anytime of year!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Add sweet potatoes and cook until tender but still firm, about 30 minutes. Drain and cool; peel and mash."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine sweet potatoes, butter, sugar, vanilla, and nutmeg in a large bowl. Whisk eggs and milk together in a small bowl; blend into sweet potato mixture. Pour filling into pie shells."
    },
    {
      "position": 4,
      "text": "Bake pies in the preheated oven for 60 minutes, or until a knife inserted in the center comes out clean."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

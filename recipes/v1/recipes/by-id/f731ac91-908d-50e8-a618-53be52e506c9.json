  "id": "f731ac91-908d-50e8-a618-53be52e506c9",
  "slug": "sriracha-deviled-eggs",
  "name": "Sriracha Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Sriracha deviled eggs are tasty and easy to make. If you love Sriracha's spicy kick and hard-boiled eggs, you'll surely enjoy this 7-ingredient recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a large saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel."
    },
    {
      "position": 2,
      "text": "Cut eggs in half lengthwise. Place egg yolks in a bowl; mash with a fork. Add mayonnaise, Sriracha, dry mustard, and cayenne pepper; mash until smooth. Season with salt. Spoon yolk mixture into a resealable plastic bag; snip off one corner of the bag."
    },
    {
      "position": 3,
      "text": "Place egg whites, cut-sides up, on a serving platter. Pipe yolk mixture into egg white halves; sprinkle with smoked paprika. Refrigerate deviled eggs, covered, until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

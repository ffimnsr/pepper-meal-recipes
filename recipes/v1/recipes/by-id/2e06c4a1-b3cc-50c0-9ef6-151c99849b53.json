  "id": "2e06c4a1-b3cc-50c0-9ef6-151c99849b53",
  "slug": "baked-gnocchi-mac-and-cheese",
  "name": "Baked Gnocchi Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "For a tasty recipe variation on baked mac and cheese, swap macaroni with potato gnocchi and enjoy a creamy, cheesy, and buttery comfort food dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 1 \u00bd- to 2-quart casserole dish."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter in a medium saucepan over medium heat. Stir in flour until incorporated and foamy, 1 to 2 minutes. Add milk, cream, black pepper, and salt; stir constantly until thickened and gently bubbling, 5 to 10 minutes. Stir in \u00bd cup Cheddar cheese and mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Add gnocchi to the prepared casserole dish; cover with cheese sauce. Combine bread crumbs and 1 tablespoon melted butter in a small bowl; sprinkle over casserole. Top with remaining \u00bc cup Cheddar cheese and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is browned and cheese is bubbling, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

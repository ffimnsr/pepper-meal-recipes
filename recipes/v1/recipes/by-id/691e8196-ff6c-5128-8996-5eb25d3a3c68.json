  "id": "691e8196-ff6c-5128-8996-5eb25d3a3c68",
  "slug": "vegan-arepas-made-with-polenta",
  "name": "Vegan Arepas Made with Polenta",
  "recipe_type": "side",
  "brief_description": "Layers of polenta, tofu, bananas, avocado, and mango salsa combine for a surprising and simple vegan meal.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven's broiler and set an oven rack about 6 inches from the heat source. Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Slice polenta and tofu into slabs of equal thickness; brush with olive oil and arrange on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Cook under the preheated broiler until the tops are crispy, about 5 minutes. Remove from the oven and set aside."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium-high heat. Cook bananas in hot oil until crispy on the outside yet soft on the inside, about 5 minutes. Remove bananas to a plate; set aside."
    },
    {
      "position": 5,
      "text": "Pour black beans into a blender and blend until a thick sauce forms. Set aside."
    },
    {
      "position": 6,
      "text": "Stir together mango, onion, jalape\u00f1o pepper, and salt in a small bowl until salsa is well combined. Set aside."
    },
    {
      "position": 7,
      "text": "To build arepas, place a slice of polenta on each of 4 plates. Top each with about 1/4 of the bean sauce, then a piece of tofu, a few banana slices, some avocado, and about 1/4 of the mango salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

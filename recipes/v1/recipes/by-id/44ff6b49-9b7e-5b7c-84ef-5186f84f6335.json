  "id": "44ff6b49-9b7e-5b7c-84ef-5186f84f6335",
  "slug": "vegetarian-meatloaf-with-vegetables",
  "name": "Vegetarian Meatloaf with Vegetables",
  "recipe_type": "main",
  "brief_description": "Vegetarian imitation ground beef is combined with onion, eggs, bread cubes and savory herbs and spices. The meatless loaf is nestled with carrots and potatoes, and baked.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl combine vegetarian ground beef, vegetarian ground beef crumbles, onion, eggs, Worcestershire sauce, salt, pepper, sage, garlic powder, mustard, oil, bread cubes and milk. Transfer to a 9 x 13 inch baking dish and form into a loaf. Pour tomato sauce on top."
    },
    {
      "position": 3,
      "text": "Place carrots and potatoes around loaf and spray vegetables with cooking spray."
    },
    {
      "position": 4,
      "text": "Bake 30 to 45 minutes; turn vegetables. Bake another 30 to 45 minutes. Let stand 15 minutes before slicing."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

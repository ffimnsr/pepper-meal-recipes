  "id": "0e8f894b-9b3a-5bce-a8be-e2f203c56330",
  "slug": "vegetarian-nachos-supreme-for-two",
  "name": "Vegetarian Nachos Supreme for Two",
  "recipe_type": "appetizer",
  "brief_description": "These delicious vegetarian nachos for two are topped with black beans, meatless crumbles, and Cheddar cheese and get a spicy kick from sliced jalapeno peppers.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium-high heat. Add ground beef substitute and fry for 1 to 2 minutes. Stir in water and taco seasoning. Continue to cook and stir until cooked through, about 8 more minutes."
    },
    {
      "position": 3,
      "text": "Place tortilla chips on an oven-safe plate and top with black beans. Add fried beef substitute and top with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes; make sure the chips do not burn."
    },
    {
      "position": 5,
      "text": "Remove from the oven and top with lettuce, salsa, guacamole, and jalapeno peppers."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

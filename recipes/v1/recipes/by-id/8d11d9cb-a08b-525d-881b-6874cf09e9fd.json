  "id": "8d11d9cb-a08b-525d-881b-6874cf09e9fd",
  "slug": "best-boiled-fruitcake",
  "name": "Best Boiled Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "This boiled fruitcake is an old-fashioned holiday dessert that's moist, flavorful, and dense with walnuts, citrus peel, spices, and candied fruit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (160 degrees C). Line an 8-inch deep cake pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Place sugar, candied mixed fruit, milk, butter, cherries, citrus peel, walnuts, allspice, and baking soda in a medium-sized saucepan. Bring to a boil, reduce heat, and simmer for 5 minutes. Remove from heat and allow to cool slightly."
    },
    {
      "position": 3,
      "text": "Stir flour and eggs into fruit mixture. Pour batter into the prepared pan. Wrap the outside of the pan with brown paper or newspaper."
    },
    {
      "position": 4,
      "text": "Bake cake in the preheated oven for 40 minutes. Reduce temperature to 300 degrees F (150 degrees C) and continue baking cake for 1 1/2 hours."
    },
    {
      "position": 5,
      "text": "Let cake sit at room temperature for 5 minutes, then invert it onto a wired rack. Remove parchment paper, flip cake, and allow to cool completely on the rack. Cake may be stored wrapped in foil and in an airtight container for up to 6 months."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 140,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

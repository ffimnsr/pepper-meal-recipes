  "id": "d135cadc-aa5a-5d5f-99aa-46f9736a6a91",
  "slug": "bite-sized-salmon-tikka",
  "name": "Bite-Sized Salmon Tikka",
  "recipe_type": "snack",
  "brief_description": "Bite-sized salmon tikka is an Indian-inspired recipe with ground cayenne and ground turmeric that is quick, tasty, and ideal as a short snack or a meal.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cayenne, turmeric, and salt in a bowl; add salmon and toss to coat. Set aside for 15 minutes."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium-high heat. While oil is heating, sprinkle cornstarch over salmon; toss to coat."
    },
    {
      "position": 3,
      "text": "Add salmon to the skillet; cook until golden brown, about 1 minute per side."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

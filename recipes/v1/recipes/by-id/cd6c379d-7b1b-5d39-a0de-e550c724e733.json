  "id": "cd6c379d-7b1b-5d39-a0de-e550c724e733",
  "slug": "buffalo-chicken-quesadillas",
  "name": "Buffalo Chicken Quesadillas",
  "recipe_type": "main",
  "brief_description": "Buffalo chicken quesadillas are an easy way to serve up a quick dinner with a lot of flavor. Serve them with Buffalo sauce, ranch dressing, or sour cream.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken tenders in a medium pot, cover with water, and bring to a boil over medium-high heat. Reduce temperature to medium-low; simmer until chicken tenders are cooked through, 6 to 8 minutes. Drain; transfer tenders to a cutting board and cut or shred as desired."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat; cook shallot until soft and translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine cream cheese, ranch dressing, Buffalo sauce, and cooked shallots in a bowl until creamy. Stir in chicken; season with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Spread some Buffalo chicken mixture on 1 tortilla; top with some Gouda and Colby-Jack cheeses. Cover with a second tortilla; set aside. Repeat with remaining tortillas, chicken mixture, and cheeses."
    },
    {
      "position": 5,
      "text": "Heat a skillet over medium heat. Add 1 quesadilla; cook until browned on 1 side, about 3 minutes. Carefully flip; cook until tortilla is crisp and cheese melted, about 3 minutes more. Repeat with remaining quesadillas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

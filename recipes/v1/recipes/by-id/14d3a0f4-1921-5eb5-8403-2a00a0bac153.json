  "id": "14d3a0f4-1921-5eb5-8403-2a00a0bac153",
  "slug": "mashed-butternut-squash-with-blue-cheese-and-pecans",
  "name": "Mashed Butternut Squash with Blue Cheese and Pecans",
  "recipe_type": "dessert",
  "brief_description": "Mashed butternut squash with crunchy toasted pecans, maple syrup, fresh thyme, and tangy blue cheese makes a perfect sweet-savory side dish for fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place butternut squash in a microwave-safe baking dish with a lid. Season with salt and pepper. Microwave, covered, until squash is tender, 8 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Coarsely mash with a potato masher or fork. Stir in pecans, maple syrup, blue cheese crumbles, and fresh thyme leaves until combined."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

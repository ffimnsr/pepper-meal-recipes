  "id": "fc707fb4-6e3a-5e9b-97fc-a292c2f5c6da",
  "slug": "white-gazpacho-recipe-7182068",
  "name": "White Gazpacho",
  "recipe_type": "soup",
  "brief_description": "This white gazpacho features lots of cucumbers in addition to tomatoes creating a wonderfully refreshing cold soup.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Let bread, cashews, and water stand in a high-powered blender 5 minutes."
    },
    {
      "position": 2,
      "text": "Add chopped cucumbers, grapes, garlic, vinegar, and salt to blender; pur\u00e9e until mostly smooth, about 1 minute. With motor running, drizzle in olive oil; pur\u00e9e until smooth, about 30 seconds more. Chill, covered, about 1 hour. Serve soup drizzled with additional olive oil and garnished with chives, sliced grapes, and/or sliced cucumbers. Recipe developed by Julia Levy"
    }
  ],

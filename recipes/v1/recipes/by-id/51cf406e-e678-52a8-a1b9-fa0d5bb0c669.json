  "schema_version": 1,
  "id": "51cf406e-e678-52a8-a1b9-fa0d5bb0c669",
  "slug": "asian-orange-chicken",
  "name": "Orange Chicken",
  "recipe_type": "dessert",
  "brief_description": "This orange chicken recipe is for the sticky, sweet, and delicious Chinese-style dish. It's easier to make than you think for a tasty takeout dinner at home.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water, rice vinegar, lemon juice, soy sauce, and orange juice for sauce into a saucepan over medium-high heat. Stir in brown sugar, green onion, orange zest, ginger, garlic, and pepper flakes; bring to a boil. Remove from heat, and cool for 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Place chicken in a resealable plastic bag. Pour in 1 cup cooled sauce. Seal the bag, and refrigerate for at least 2 hours. Reserve the remaining sauce."
    },
    {
      "position": 4,
      "text": "Mix flour, salt, and pepper in another resealable plastic bag."
    },
    {
      "position": 5,
      "text": "Remove chicken from the marinade and place into the bag of seasoned flour. Seal the bag and shake to coat."
    },
    {
      "position": 6,
      "text": "Heat the olive oil in a large skillet over medium heat. Cook chicken in the hot skillet until browned on both sides."
    },
    {
      "position": 7,
      "text": "Remove to a paper towel-lined plate and cover with aluminum foil. Wipe out the skillet."
    },
    {
      "position": 8,
      "text": "Pour reserved sauce into the skillet and bring to a boil over medium-high heat. Mix together cornstarch and water until completely smooth. Stir into the boiling sauce."
    },
    {
      "position": 9,
      "text": "Reduce heat to medium-low, add the chicken, and simmer, stirring occasionally, until cooked through, about 5 minutes."
    },
    {
      "position": 10,
      "text": "Serve over rice and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

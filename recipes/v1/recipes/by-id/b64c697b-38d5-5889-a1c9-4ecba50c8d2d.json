  "id": "b64c697b-38d5-5889-a1c9-4ecba50c8d2d",
  "slug": "sweet-sticky-rice-with-mangoes",
  "name": "Sweet Sticky Rice with Mangoes",
  "recipe_type": "dessert",
  "brief_description": "This sweet sticky rice with mangoes recipe is a delicious Thai dessert with coconut-scented sticky rice, a sweet coconut sauce, and fresh mangoes on top.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Cover rice with several inches of fresh water in a microwave-safe bowl; let stand for 30 minutes. Drain off water so rice is covered by 1/4 inch of water."
    },
    {
      "position": 2,
      "text": "Microwave rice, covered, on High until water is mostly absorbed but rice is still wet, about 10 minutes; stir and cook until almost dry, 4 minutes more."
    },
    {
      "position": 3,
      "text": "Combine 1/2 coconut milk and 1 cup sugar in a bowl, stirring until sugar dissolved. Pour over rice; stir until rice coated. Cover and let rice stand at room temperature for 20 minutes."
    },
    {
      "position": 4,
      "text": "Pour remaining 1/2 can coconut milk into a saucepan; whisk in remaining 1 tablespoon sugar, cornstarch, and salt until smooth. Bring mixture to a simmer over medium heat, whisking constantly; simmer until thickened, about 2 minutes. Remove from heat; cool."
    },
    {
      "position": 5,
      "text": "Scoop rice into individual serving bowls; top each serving with about 2 tablespoons coconut sauce and several mango pieces."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

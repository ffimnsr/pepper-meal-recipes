  "id": "9a2fb593-a051-50df-9072-24eec3b2b28c",
  "slug": "quick-vegan-sushi",
  "name": "Quick Vegan Sushi",
  "recipe_type": "main",
  "brief_description": "This vegan sushi is simple and quick to prepare--make it the night before and pack it with some wasabi and soy sauce for a delicious lunch at school or work.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cooked rice in a microwave-safe bowl and cover partially. Microwave on high until hot, about 1 minute."
    },
    {
      "position": 2,
      "text": "Place 1 nori sheet on the bamboo mat. Spread 1/2 of the rice evenly on nori sheet, using a little water on your hands or a spoon to keep rice from sticking. Place 1/2 of the cucumber and carrot slices on the top half of the rice, and roll nori sheet around rice and veggies, using the bamboo mat to help. Repeat with remaining nori sheet, rice, and veggies."
    },
    {
      "position": 3,
      "text": "Cut each roll into 6 small pieces and put them in the refrigerator until cool, about 20 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

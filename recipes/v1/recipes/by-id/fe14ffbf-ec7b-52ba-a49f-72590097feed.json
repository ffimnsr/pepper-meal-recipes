  "slug": "steakhouse-wheat-bread-for-the-bread-machine",
  "name": "Steakhouse Wheat Bread for the Bread Machine",
  "recipe_type": "side",
  "brief_description": "Instant coffee, cocoa, and honey may seem like strange partners in a bread recipe until you actually try this one made like a favorite steakhouse version.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place warm water, butter, honey, salt, coffee, cocoa, sugar, bread flour, whole wheat flour, and bread machine yeast in the pan of a bread machine in the order listed. Put on regular or basic cycle with light crust."
    }
  ],

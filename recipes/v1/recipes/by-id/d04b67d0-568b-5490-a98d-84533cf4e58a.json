  "slug": "avocado-tomatillo-salsa",
  "name": "Avocado Tomatillo Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This tasty avocado salsa verde with tomatillos and serrano chile pepper is ready in minutes! Enjoy with grilled meats, on sandwiches, or with tortilla chips for dipping.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place tomatillos into a food processor. Add avocado, cilantro, lime juice, serrano pepper, and salt. Process until smooth. Taste and adjust seasoning, then transfer to a serving bowl."
    }
  ],
  "servings": 10,

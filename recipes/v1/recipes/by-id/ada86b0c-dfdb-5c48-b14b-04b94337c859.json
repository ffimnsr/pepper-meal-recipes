  "id": "ada86b0c-dfdb-5c48-b14b-04b94337c859",
  "slug": "christmas-cherry-cake",
  "name": "Christmas Cherry Cake",
  "recipe_type": "dessert",
  "brief_description": "This cherry cake is a buttery white loaf cake packed with glac\u00e9 cherries for a simple, no-fuss holiday fruitcake\u2014perfect for make-ahead gifting.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 9x5-inch loaf pan and line with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar in a large bowl until light and fluffy. Add eggs, one at a time, beating well after each addition. Mix in orange juice until smooth."
    },
    {
      "position": 3,
      "text": "Sift flour and baking powder. Reserve 1/3 cup of the flour mixture and toss with raisins and cherries to help keep them suspended in the batter. Stir remaining flour mixture into batter until just combined. Fold in floured raisins and cherries."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 2 hours and 15 minutes. Cool completely before wrapping tightly in plastic wrap or foil. Store in an airtight container at room temperature for several days to allow flavor to develop."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "0061874c-8dee-5bc1-83c6-81c10524d5f1",
  "slug": "chinese-chicken-fried-rice-i",
  "name": "Chinese Chicken Fried Rice",
  "recipe_type": "main",
  "brief_description": "This chicken fried rice recipe is made with a colorful array of crisp vegetables and a bounty of rice with a scramble of eggs running throughout.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat sesame oil in a large skillet over medium heat. Add onion and saut\u00e9 until soft. Add cooked chicken and 2 tablespoons soy sauce; stir-fry for 5 to 6 minutes."
    },
    {
      "position": 2,
      "text": "Stir in carrots, celery, red bell pepper, pea pods, and green bell pepper; stir-fry for 5 minutes. Mix in cooked rice until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Stir in scrambled eggs and 1/3 cup soy sauce; cook until heated through and serve hot."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1f0347ac-51b2-58fe-82c8-f993041915fe",
  "slug": "gluten-free-crustless-pumpkin-pie",
  "name": "Gluten Free Crustless Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "When you take a bite of this luscious, creamy pumpkin pie, you won't even notice there's no crust.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat eggs, brown sugar, cinnamon, salt, nutmeg, cloves, and ginger in a bowl until blended. Stir in milk and pumpkin until mixture is smooth; transfer to a 9-inch glass pie dish. Sprinkle with pecans."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 15 minutes; reduce heat to 350 degrees F (175 degrees C) and continue baking until set, 30 to 40 minutes more. Cool for at least 1 hour before slicing and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

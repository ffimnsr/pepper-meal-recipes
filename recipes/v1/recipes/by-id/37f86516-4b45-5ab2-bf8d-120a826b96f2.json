  "id": "37f86516-4b45-5ab2-bf8d-120a826b96f2",
  "slug": "cottage-cheese-pizza-recipe-11830791",
  "name": "Cottage Cheese Pizza",
  "recipe_type": "main",
  "brief_description": "The no-knead dough for this cottage cheese pizza, made in a high-speed blender, bakes up chewy, tender, and flavorful. The dough gets a protein boost from the cottage cheese, and the pizza can be made start to finish in under 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a convection oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Add cottage cheese to a high powered blender, such as a Vitamix. Turn on High for 15 to 20 seconds. Add in flour, Italian seasoning, and Parmesan cheese. Pulse on High for 5 second bursts until a shaggy dough forms."
    },
    {
      "position": 3,
      "text": "Add 1 teaspoon oil to each of 2 small pizza pans. Divide dough evenly in half, and roll out each piece to fit into pans. Place dough into tins. Using a fork, poke holes all over pizza dough."
    },
    {
      "position": 4,
      "text": "Bake pizza crusts in the preheated oven for 6 minutes. Remove from oven, and spread pizza sauce to within 1/2-inch of crust edge. Sprinkle with cheese."
    },
    {
      "position": 5,
      "text": "Return pizzas to the oven, and bake until cheese is melted and golden, about 7 minutes. Remove from oven and let rest for about 2 minutes before cutting."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

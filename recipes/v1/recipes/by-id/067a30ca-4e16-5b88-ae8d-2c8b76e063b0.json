  "id": "067a30ca-4e16-5b88-ae8d-2c8b76e063b0",
  "slug": "beef-stroganoff-ii",
  "name": "Beef Stroganoff with Steak",
  "recipe_type": "soup",
  "brief_description": "This creamy, tasty beef stroganoff is made with sirloin steak, mushroom soup, paprika, and nonfat sour cream for a lighter version of the traditional dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Brown steak strips in a large skillet over medium-high heat; drain excess fat. Add onion and saut\u00e9 for 5 minutes, or until tender. Stir in flour, salt, paprika, and ground black pepper."
    },
    {
      "position": 2,
      "text": "Stir in soup; reduce heat to medium-low and simmer for 15 minutes. Stir in sour cream."
    },
    {
      "position": 3,
      "text": "Prepare egg noodles according to package directions. Serve beef stroganoff over egg noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

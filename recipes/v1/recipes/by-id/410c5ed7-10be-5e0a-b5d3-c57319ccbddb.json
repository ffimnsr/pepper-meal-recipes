  "id": "410c5ed7-10be-5e0a-b5d3-c57319ccbddb",
  "slug": "fall-sangria",
  "name": "Fall Sangria",
  "recipe_type": "drink",
  "brief_description": "Mix fruits, apple cider, cinnamon, triple sec, white wine, and soda water together for a delicious fall sangria cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add all ingredients except soda water into a large pitcher and stir to combine."
    },
    {
      "position": 2,
      "text": "Allow to sit in the refrigerator for 3 to 24 hours."
    },
    {
      "position": 3,
      "text": "Pour sangria and fruit into glasses with ice. Top with soda water."
    }
  ],
  "servings": 6,

  "id": "e4c668be-efac-5a3c-9884-d32f83435b6d",
  "slug": "pumpkin-bread-with-raisins-and-pecans",
  "name": "Pumpkin Bread with Raisins and Pecans",
  "recipe_type": "drink",
  "brief_description": "This easy pumpkin bread with raisins and pecans recipe combines pumpkin pur\u00e9e, pumpkin pie spice, vanilla extract, and orange juice for a taste of fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two loaf pans."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, pumpkin pie spice, salt, and baking soda together in a large bowl. Toss raisins and pecans with 1 tablespoon flour mixture in a separate bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until fluffy. Add pumpkin pur\u00e9e, eggs, orange juice, and vanilla extract; beat until well combined. Slowly add flour mixture; blend thoroughly. Fold in raisins and pecans."
    },
    {
      "position": 4,
      "text": "Divide batter evenly between the prepared pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm and tops spring back when lightly pressed, 30 to 40 minutes. Cool completely on wire racks before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b93538f6-5240-54ed-8d11-2bcfe3e39e08",
  "slug": "spicy-shrimp-pad-thai",
  "name": "Spicy Shrimp Pad Thai",
  "recipe_type": "dessert",
  "brief_description": "Shrimp is the star of this easy pad thai recipe that delivers a tangy, sweet, and slightly spicy combo of flavors in under an hour.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place noodles in a large bowl and cover with hot water. Set aside until noodles are softened, about 15 minutes. Drain and rinse thoroughly."
    },
    {
      "position": 2,
      "text": "Heat oil in a wok over medium heat. Cook and stir onion and garlic until onion is translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine rice wine vinegar, ketchup, fish sauce, chile sauce, peanut butter, soy sauce, lime juice, sugar, red pepper flakes, and cayenne pepper together in a bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Add shrimp to the wok. Cook and stir until pink, about 4 minutes. Add the ketchup mixture and stir. Move all ingredients to one side to clear a small space in the pan. Pour in eggs and cook without stirring until partially set, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir the drained noodles into the shrimp and egg mixture. Add 1/2 cup peanuts, 1/4 cup bean sprouts, and carrots. Cook and stir until noodles are heated through, about 2 minutes. Garnish with the remaining peanuts, bean sprouts, lime wedges, green onions, and cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

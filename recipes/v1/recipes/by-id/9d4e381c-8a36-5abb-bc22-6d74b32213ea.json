  "id": "9d4e381c-8a36-5abb-bc22-6d74b32213ea",
  "slug": "salmon-chowder",
  "name": "Salmon Chowder",
  "recipe_type": "soup",
  "brief_description": "Creamy and comforting salmon chowder made with easy ingredients: cooked salmon, milk, potatoes, creamed corn, and lots of Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large pot over medium heat. Add onion, celery, and garlic powder; saut\u00e9 until onions are tender."
    },
    {
      "position": 3,
      "text": "Add broth; stir in potatoes and carrots. Season with salt, pepper, and dill. Bring to a boil; reduce heat, cover, and simmer 20 minutes."
    },
    {
      "position": 4,
      "text": "Stir in salmon, corn, evaporated milk, and cheese. Cook until heated through."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

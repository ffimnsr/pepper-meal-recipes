  "id": "722a13a2-af86-512f-8539-a79b5bb7805a",
  "slug": "easy-vegan-lemon-curd-recipe-8647046",
  "name": "Easy Vegan Lemon Curd",
  "recipe_type": "dessert",
  "brief_description": "This homemade vegan lemon curd made with coconut milk, lemon juice, and zest is a lusciously sweet and smooth tangy spread made without eggs or dairy.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Stir sugar and cornstarch together in a small saucepan. Shake and stir coconut milk; pour into the saucepan with lemon juice and lemon zest. Cook mixture over medium heat, stirring frequently, until mixture is thick and coats the back of spoon, 6 to 8 minutes. Remove from heat. Whisk in coconut oil and turmeric until melted and smooth."
    },
    {
      "position": 2,
      "text": "Transfer lemon curd to a medium bowl; chill until firm, about 1 hour. Recipe developed by Jasmine Smith"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

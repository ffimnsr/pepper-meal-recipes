  "id": "b125a19a-6910-5b17-9088-540eb19d47bb",
  "slug": "baked-buffalo-chicken-dip",
  "name": "Baked Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "This baked Buffalo chicken dip from Chef John is easy to make with shredded chicken, cream cheese, blue cheese, and hot sauce for a crowd-pleasing dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir chicken, cream cheese, hot pepper sauce, 1/2 cup pepper Jack, blue cheese dressing, blue cheese, seafood seasoning, and a pinch cayenne pepper together in a large bowl until well combined. Transfer to a 9-inch round baking dish and smooth into an even layer. Sprinkle 2 tablespoons pepper Jack over top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned on top, 15 to 20 minutes. Remove from the oven, add another pinch cayenne pepper, and sprinkle green onions over top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

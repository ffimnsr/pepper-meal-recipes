  "id": "03d0e1b0-f0d4-56a4-a574-cbbe523c3802",
  "slug": "quick-and-easy-pretzel-bites-with-nutella-dipping-sauce",
  "name": "Quick and Easy Pretzel Bites with Nutella\u00ae Dipping Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Pizza dough is a handy shortcut in these quick and easy pizza bites complete with 2 dipping sauces: Nutella\u00ae and honey mustard.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Unroll pizza crust and cut into 2-inch squares. Roll each square into a ball and place on a cookie sheet."
    },
    {
      "position": 3,
      "text": "Bring 3 quarts of water to a boil. Stir in baking soda until dissolved. Add pizza balls to the boiling water in batches. Cook until puffed up and floating, 1 to 2 minutes. Transfer to a cookie sheet lined with parchment paper. Sprinkle salt on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes."
    },
    {
      "position": 5,
      "text": "Mix Neufchatel cheese, chocolate-hazelnut spread, and milk together to make chocolate dipping sauce. Add more milk for a thinner dip. Mix mustard and honey together in a separate bowl. Serve warm pretzel bites with dipping sauces."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5e225238-a944-5fec-af85-07047dd4d52b",
  "slug": "asparagus-and-truffle-risotto",
  "name": "Asparagus and Truffle Risotto",
  "recipe_type": "main",
  "brief_description": "Risotto gets a delicious upgrade from asparagus and truffle oil in this recipe that's perfect for impressing guests.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon butter and olive oil in a large pan over medium heat until melted. Stir in bell pepper, onion, and garlic and cook until tender, 2 to 3 minutes. Add rice and stir to coat, 1 to 2 minutes."
    },
    {
      "position": 2,
      "text": "Pour wine into mixture and stir until absorbed. Add 1 cup of broth, stirring until absorbed. Add 1/2 cup of broth, stirring until absorbed; repeat process of adding 1/2 cup of broth until all is used. Stir in asparagus with the last cup of broth. Stirring in the broth should take 15 to 20 minutes in all. When finished, the rice should be tender yet firm to the bite."
    },
    {
      "position": 3,
      "text": "Stir in Parmesan cheese, truffle oil, and remaining 2 tablespoons butter. Stir in milk to taste and to desired creaminess. Cover and let stand for 3 to 5 minutes. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

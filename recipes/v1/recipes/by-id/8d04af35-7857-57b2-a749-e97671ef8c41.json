  "id": "8d04af35-7857-57b2-a749-e97671ef8c41",
  "slug": "moo-shu-chicken",
  "name": "Moo Shu Chicken",
  "recipe_type": "main",
  "brief_description": "This moo shu chicken dish combines sliced chicken with an umami-rich sauce, shredded cabbage, and shiitake mushrooms. Skip eating out and try this at home!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 2 tablespoons water, 2 teaspoons sesame oil, and cornstarch together in a large bowl. Add chicken, toss to coat, and set aside."
    },
    {
      "position": 2,
      "text": "Combine remaining 4 tablespoons water and 1 teaspoon sesame oil in a separate bowl. Whisk in hoisin sauce, oyster sauce, and soy sauce until well combined; set sauce aside."
    },
    {
      "position": 3,
      "text": "Heat 1 teaspoon oil in a skillet over medium heat. Add eggs and cook for 3 minutes; flip and cook until firm and set, about 3 minutes more. Transfer to a cutting board and slice into thin strips."
    },
    {
      "position": 4,
      "text": "Add marinated chicken to the skillet and cook over medium-high heat for 6 minutes. Flip and cook until golden brown on the outside and the juices run clear, about 6 minutes more; transfer to a plate."
    },
    {
      "position": 5,
      "text": "Heat remaining 1 teaspoon oil in the skillet over medium-high heat. Add cabbage, shiitake mushrooms, garlic, and sherry; cook until cabbage starts to wilt, about 2 minutes. Add chicken, sliced egg, and reserved sauce to the skillet; cook, stirring occasionally, until sauce has thickened, about 5 minutes. Toss in green onions and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

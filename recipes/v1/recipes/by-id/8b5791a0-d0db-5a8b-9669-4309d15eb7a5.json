  "id": "8b5791a0-d0db-5a8b-9669-4309d15eb7a5",
  "slug": "pan-fried-green-beans",
  "name": "Pan Fried Green Beans",
  "recipe_type": "side",
  "brief_description": "Learn how to cook fresh green beans with this easy recipe for green beans cooked with garlic and onion powders until tender-crisp and lightly charred.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Combine green beans, garlic powder, onion powder, salt, and pepper in a stainless steel pot over medium-high heat. Cook, covered, until beans begin to sweat. Remove the lid and stir occasionally until beans are tender."
    },
    {
      "position": 3,
      "text": "When beans and spices begin to char on the bottom of the pan, stir in olive oil and turn off heat. Cover and let stand a few minutes."
    },
    {
      "position": 4,
      "text": "Scrape the bottom of the pan to incorporate charred spices. Beans should have a dark, caramel color, but not black."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

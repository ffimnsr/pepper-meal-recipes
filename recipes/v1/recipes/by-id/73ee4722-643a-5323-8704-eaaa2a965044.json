  "slug": "eggs-on-the-grill",
  "name": "Eggs on the Grill",
  "recipe_type": "breakfast",
  "brief_description": "Have you ever tried eggs on the grill by using a muffin pan? Just spray the pan and crack the eggs and put them on the grill. Try adding some chopped peppers and onions or anything to your liking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium high heat."
    },
    {
      "position": 2,
      "text": "Coat all holes of a muffin pan with cooking spray and crack an egg into each hole."
    },
    {
      "position": 3,
      "text": "Place on grill and grill over medium high heat for 2 minutes, or to desired doneness."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

  "id": "288806cc-c153-506a-9e5c-0ae973c0c84f",
  "slug": "easy-chicken-tetrazzini",
  "name": "Easy Chicken Tetrazzini",
  "recipe_type": "soup",
  "brief_description": "Chicken tetrazzini is an easy meal the whole family will love — just layer cooked noodles and chicken with a creamy soup-based sauce and lots of cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Put cooked spaghetti noodles into 9x13-inch baking dish. Place chicken on top of spaghetti."
    },
    {
      "position": 3,
      "text": "Bring condensed soup, water, butter, and bouillon to a boil in a medium saucepan. Pour soup mixture over pasta and chicken. Sprinkle Cheddar on top and press down a bit."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

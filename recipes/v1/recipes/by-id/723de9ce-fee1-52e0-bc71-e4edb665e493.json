  "id": "723de9ce-fee1-52e0-bc71-e4edb665e493",
  "slug": "pimento-cheese-stuffed-meatballs-recipe-12000699",
  "name": "Pimento Cheese-Stuffed Meatballs Have No Business Being So Good",
  "recipe_type": "appetizer",
  "brief_description": "These pimento cheese-stuffed meatballs are the ultimate Southern-inspired party bite. Savory beef meatballs are filled with a pimento cheese center that turns perfectly melty and gooey in the oven. Just plan ahead\u2014the cheese filling needs to freeze before it\u2019s stuffed and baked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Scoop pimento cheese into 16 to 20 small portions (about 1 1/2 teaspoon each) and place them on a parchment-lined plate. Freeze until firm, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Mix the beef, egg, panko, garlic, parsley, salt, paprika, pepper, and Worcestershire sauce together in a bowl until just combined."
    },
    {
      "position": 4,
      "text": "Divide meat mixture into 16 to 20 portions. Flatten each portion into a small patty. Place a frozen pimento cheese portion in the center and wrap the meat around it, sealing completely. Roll gently into a ball."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes; brush with barbecue sauce at the 15-minute mark, if using. An instant-read thermometer inserted into the center should reach 160 degrees F (71 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

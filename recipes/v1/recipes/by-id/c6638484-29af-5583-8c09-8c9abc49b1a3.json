  "id": "c6638484-29af-5583-8c09-8c9abc49b1a3",
  "slug": "baked-butter-beans-recipe-8782057",
  "name": "Baked Butter Beans",
  "recipe_type": "dessert",
  "brief_description": "These baked butter beans are zesty with a hint of sweet, and the secret flavor ingredients are steak sauce and celery seed.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Place sausage, bell pepper, and onion in a large skillet over medium-high heat. Cook and stir until sausage is browned, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk ketchup, steak sauce, liquid smoke, ground mustard, and celery seed in a large mixing bowl. Add sausage mixture and stir to combine. Add drained butter beans and gently stir until evenly combined. Pour into a baking dish; cover."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until hot and bubbly, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

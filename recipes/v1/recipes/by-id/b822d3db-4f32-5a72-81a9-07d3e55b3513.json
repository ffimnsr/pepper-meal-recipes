  "id": "b822d3db-4f32-5a72-81a9-07d3e55b3513",
  "slug": "turkey-tetrazzini-ii",
  "name": "Leftover Turkey Tetrazzini",
  "recipe_type": "main",
  "brief_description": "This leftover turkey tetrazzini recipe makes a creamy, cheesy, and comforting casserole \u2014 perfect for turning turkey into a delicious baked pasta dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cook spaghetti according to package directions until al dente. Drain and transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Melt butter in a medium saucepan over medium heat. Whisk in flour until smooth and lightly golden, about 1 minute. Gradually whisk in chicken broth and milk. Stir until mixture comes to a gentle boil and thickens slightly, about 5 minutes. Stir in 1 1 \u20443 cups cheese until melted; remove from heat."
    },
    {
      "position": 4,
      "text": "Mix broth mixture and turkey with spaghetti. Top with remaining 1/3 cup cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is lightly browned, 45 minutes to 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

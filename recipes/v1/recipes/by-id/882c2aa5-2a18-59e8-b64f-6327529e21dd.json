  "id": "882c2aa5-2a18-59e8-b64f-6327529e21dd",
  "slug": "fried-buttermilk-chicken-strips",
  "name": "Fried Buttermilk Chicken Strips",
  "recipe_type": "main",
  "brief_description": "This fried buttermilk chicken strips recipe bathes chicken tenders in buttermilk before dredging them in seasoned flour for crunchy and moist bites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak chicken tenders in buttermilk in a large glass or ceramic bowl in the refrigerator for 20 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine flour, salt, garlic salt, mustard powder, paprika, and black pepper in a large brown paper bag."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove chicken from buttermilk and lightly shake off excess; discard buttermilk. Chicken should still be damp. Drop chicken into seasoned flour; shake until well-coated."
    },
    {
      "position": 5,
      "text": "Lower chicken carefully into hot oil in batches, about 6 pieces at a time depending on the size of your fryer or saucepan. Fry until golden brown, crispy, and no longer pink in centers, 6 to 8 minutes. Transfer to a paper-towel-lined plate to drain. Season with salt and black pepper while still warm. Repeat with remaining chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

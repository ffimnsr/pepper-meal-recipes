  "id": "c4c11f0d-a0e7-59f1-8659-a1d0c3be5ad7",
  "slug": "lemon-shrimp-pasta",
  "name": "Lemon Shrimp Pasta",
  "recipe_type": "main",
  "brief_description": "This lemon shrimp pasta features fresh linguine and lots of grated Parmesan for a filling but refreshingly light dinner that comes together quickly.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large pan over medium heat. Season shrimp with salt and pepper. Cook and stir shrimp in hot oil until opaque, about 2 minutes per side. Remove from heat."
    },
    {
      "position": 3,
      "text": "Cook linguine in boiling water until tender yet firm to the bite, 1 to 3 minutes. Drain, reserving 2 tablespoons cooking water."
    },
    {
      "position": 4,
      "text": "Combine lemon zest and juice in a small saucepan over medium heat; bring to a simmer. Sprinkle in parsley and stir in butter until melted. Stir in reserved cooking water. Add shrimp to lemon sauce."
    },
    {
      "position": 5,
      "text": "Mix together linguine, lemon-shrimp sauce, and Parmesan cheese in a large serving bowl."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

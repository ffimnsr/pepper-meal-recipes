  "id": "964bb397-a391-58a1-be99-b08ede0466f9",
  "slug": "garlic-chili-oil-noodles-recipe-7496389",
  "name": "Garlic Chili Oil Noodles",
  "recipe_type": "main",
  "brief_description": "These easy garlic chili oil noodles are not for those with a mild palate!",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of water to a boil over high heat. Add ramen noodles, and cook until tender, 3 to 4 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat sesame oil, soy sauce, and chili oil in a wok over medium-high heat."
    },
    {
      "position": 3,
      "text": "Add garlic and stir fry until fragrant, 30 to 45 seconds. Remove from heat. Drain ramen noodles, add to the wok, and toss to coat. Sprinkle with sesame seeds and scallions for garnish. Enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

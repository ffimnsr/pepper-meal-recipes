  "id": "2aa966ff-f895-566f-90d4-3149796c397c",
  "slug": "bbq-salmon-bowls-recipe-11749036",
  "name": "BBQ Salmon Bowls",
  "recipe_type": "appetizer",
  "brief_description": "These BBQ salmon bowls are topped with a colorful mango salsa and pickled red onion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 450 degrees C (230 degrees C). Line a rimmed baking sheet with foil. Coat foil with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "For mango salsa, combine mango, red pepper, green onion, lime zest and juice, 1 tablespoon olive oil, habanero, basil, honey, and 1/4 teaspoon salt in a bowl."
    },
    {
      "position": 3,
      "text": "For BBQ spice mixture, combine brown sugar, chili powder, smoked paprika, onion powder, cumin, and remaining 1/2 teaspoon salt in a small bowl."
    },
    {
      "position": 4,
      "text": "Place salmon fillets on the prepared baking sheet. Brush with remaining 2 tablespoons olive oil. Sprinkle generously with BBQ spice mixture."
    },
    {
      "position": 5,
      "text": "Bake until fish flakes easily when tested with a fork, 4 to 6 minutes per 1/2-inch thickness of fish."
    },
    {
      "position": 6,
      "text": "Arrange rice and beans in four shallow serving bowls. Top with salmon and salsa. Arrange avocado and red onion in the bowls. Serve and enjoy."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 20,

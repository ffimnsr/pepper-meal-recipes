  "id": "e71e7cb0-822b-51c1-b8e1-c07f1e80d1d4",
  "slug": "chicken-cacciatore-sandwich",
  "name": "Chicken Cacciatore Sandwich",
  "recipe_type": "main",
  "brief_description": "Leftover shredded chicken is mixed with a briny tomato and mushroom sauce and heaped onto toasted hoagie rolls with melted provolone in these easy chicken cacciatore sandwiches.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add mushrooms, onion, and garlic; saut\u00e9 until onions are translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add sherry, capers, oregano, and basil; cook until 1/2 of the sherry has cooked out. Add marinara sauce. Stir in chicken and cook until sauce has reduced by a third, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "While the sauce is reducing, set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 4,
      "text": "Place split hoagie rolls on a baking sheet and top each with a slice of provolone cheese."
    },
    {
      "position": 5,
      "text": "Broil until cheese is melted and rolls are toasted, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Fill each toasted bun with chicken mixture and top with sliced olives."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

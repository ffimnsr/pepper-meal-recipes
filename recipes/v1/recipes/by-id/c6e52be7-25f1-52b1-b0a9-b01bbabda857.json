  "id": "c6e52be7-25f1-52b1-b0a9-b01bbabda857",
  "slug": "chicken-chip-bake-recipe-11883909",
  "name": "Chicken Chip Bake",
  "recipe_type": "main",
  "brief_description": "This chicken chip bake is a tasty casserole of chicken, pinto beans, and plenty of red and green enchilada sauce, layered with thick-cut tortilla chips. It's on the table in about 45 minutes.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Stir chicken, green enchilada sauce, and 1 cup cheese together in a bowl. Reserve 2 tablespoons green onions for topping. Add remaining green onions to chicken mixture, and set aside."
    },
    {
      "position": 2,
      "text": "Drizzle oil in the bottom of a deep 9x13-inch baking dish. Add half the chips to the dish and top evenly with beans and 1 cup cheese. Pour 3/4 cup red enchilada sauce over the top."
    },
    {
      "position": 3,
      "text": "Spread chicken mixture evenly over the sauce and top with remaining chips. Pour remaining red enchilada sauce evenly over the casserole; top with remaining cheese. Cover with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes; uncover, and cook until browned and bubbly, about 10 minutes longer."
    },
    {
      "position": 5,
      "text": "Serve topped with desired toppings."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

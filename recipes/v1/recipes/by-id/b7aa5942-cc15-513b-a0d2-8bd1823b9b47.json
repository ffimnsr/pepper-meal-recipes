  "id": "b7aa5942-cc15-513b-a0d2-8bd1823b9b47",
  "slug": "baked-mediterranean-sardines-recipe-11984990",
  "name": "Baked Mediterranean Sardines",
  "recipe_type": "main",
  "brief_description": "These baked Mediterranean sardines combine canned sardines with cherry tomatoes, olives, capers, garlic, and lemon for an easy dish packed with bold flavor. Serve over angel hair pasta or with crusty bread for dipping.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oil and garlic in a baking dish and place dish in the oven. Preheat oven to 450 degrees C (232 degrees C)."
    },
    {
      "position": 2,
      "text": "Remove baking dish from the oven when the garlic is lightly browned, after about 10 minutes. Continue preheating the oven."
    },
    {
      "position": 3,
      "text": "Add tomatoes, capers, olives, red pepper and red wine vinegar to the baking dish. Squeeze one lemon half over the mixture and season with crushed red pepper and black pepper."
    },
    {
      "position": 4,
      "text": "Place sardines, along with the marinade from the cans, on top of the tomato mixture and return to the oven."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until sardines are browned on top and tomatoes have softened, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Sprinkle feta on top and turn oven to broil. Broil until feta is lightly browned, 2 to 3 minutes. Sprinkle with parsley and squeeze remaining lemon half over the top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

  "id": "c08d342f-5738-5425-957a-bc32a1b7b6c1",
  "slug": "easy-air-fryer-latkes",
  "name": "Easy Air Fryer Latkes",
  "recipe_type": "side",
  "brief_description": "These crispy latkes are made with only 4 ingredients and air fried in less than 15 minutes. Serve with sour cream and apple sauce.",
  "cuisine": "Jewish Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes on a clean kitchen towel and squeeze out any excess moisture. Transfer to a bowl and stir in eggs, onion, bread crumbs, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Spray the air fryer basket with nonstick spray. Drop 1/4 cupfuls potato mixture into the basket. Spray tops with nonstick spray."
    },
    {
      "position": 4,
      "text": "Air fry until crispy and golden brown, 8 to 12 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

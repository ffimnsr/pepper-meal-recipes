  "id": "47eff1b9-cf37-5b7a-ae16-d2697beb0b1e",
  "slug": "portobello-mushroom-and-rice-stew",
  "name": "Portobello Mushroom and Rice Stew",
  "recipe_type": "soup",
  "brief_description": "This vegetarian stew boasts portobello mushrooms, veggies, and rice combined in a rich, red wine-based broth--it's a tasty dish reminiscent of a hearty risotto.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter with olive oil in a wok or deep nonstick frying pan over low heat. Increase heat to medium, add shallot and garlic, and saute for 2 minutes. Add mushrooms and saute until soft, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add chicken broth, rice, wine, carrots, celery, salt, pepper, and bay leaf. Cover slightly with a lid and bring to a simmer."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium-low and simmer, stirring occasionally, until rice is cooked, veggies are tender, and sauce is a nice, thick consistency, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

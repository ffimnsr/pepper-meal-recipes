  "id": "0057cbe0-94dd-532c-8f93-4986d9fca67d",
  "slug": "slow-cooker-chicken-spaghetti-recipe-11892541",
  "name": "Slow Cooker Chicken Spaghetti",
  "recipe_type": "main",
  "brief_description": "This slow cooker chicken spaghetti is al dente spaghetti in a creamy, gooey, cheesy sauce with shredded chicken\u2014a savory, comforting dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 6-quart slow cooker with cooking spray. Add cream of chicken soup, cream of mushroom soup, diced tomatoes and green chiles, cream cheese, Velveeta, broth, onion powder, salt, and pepper; mix well. Nestle chicken breasts into soup mixture and cover with the lid."
    },
    {
      "position": 2,
      "text": "Cook on Low for about 3 1/2 hours or until a thermometer inserted into thickest portion of chicken registers 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Transfer chicken to a clean cutting board and allow it to cool slightly. Once chicken is cooled enough to handle, shred it and return to the soup mixture. Add Colby Jack and stir until evenly coated. Cover with lid and turn off heat, let sit until cheese is mostly melted, about 5 minutes. Meanwhile, cook spaghetti according to package directions."
    },
    {
      "position": 4,
      "text": "Drain pasta, reserving 1 cup cooking water; set cooking water aside. Add pasta to slow cooker, stirring until evenly coated. Add a little more cooking water if necessary to maintain a creamy consistency."
    },
    {
      "position": 5,
      "text": "Garnish with parsley and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 220,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

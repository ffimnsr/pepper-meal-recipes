  "id": "36ff4f99-0add-5b98-a101-7b6cb66076f8",
  "slug": "easy-tiramisu",
  "name": "Easy Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "For this easy tiramisu, mascarpone is sweetened with sugar and vanilla and made richer with egg yolks, then layered with coffee soaked ladyfingers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, beat yolks, sugar, and vanilla until smooth and light yellow. Fold mascarpone into yolk mixture. Set aside."
    },
    {
      "position": 2,
      "text": "Dip ladyfingers briefly in coffee and arrange 12 of them in the bottom of an 8x8-inch dish. Spread half the mascarpone mixture over ladyfingers. Repeat with remaining ladyfingers and mascarpone. Cover and chill 1 hour. Sprinkle with cocoa just before serving."
    }
  ],
  "servings": 6,

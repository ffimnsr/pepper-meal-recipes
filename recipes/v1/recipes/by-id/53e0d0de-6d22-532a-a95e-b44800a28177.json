  "slug": "snow-ice-cream-ii",
  "name": "Snow Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This snow ice cream recipe is a fun winter-time treat the whole family can make with just 4 simple ingredients: Clean snow, sugar, vanilla, and milk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a large bowl outside to collect about 1 gallon of clean snowflakes."
    },
    {
      "position": 2,
      "text": "Mix in sugar and vanilla extract. Stir in just enough milk to reach desired consistency. Serve at once."
    }
  ],
  "servings": 8,

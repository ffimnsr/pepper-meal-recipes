  "id": "48a8d2aa-64f8-5289-913f-930f7396b664",
  "slug": "no-cholesterol-chocolate-chip",
  "name": "No Cholesterol Chocolate Chip",
  "recipe_type": "dessert",
  "brief_description": "I was amazed this recipe worked! Produces a cake like cookie which is good for the heart and good for the taste buds too!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a medium bowl, stir together the canola oil, honey, sugar, egg whites, vanilla and water. Sift together the whole wheat flour, all purpose flour, baking powder, salt and cinnamon, stir into the wet ingredients. Mix well, then fold in the chocolate chips."
    },
    {
      "position": 3,
      "text": "Drop cookies by rounded teaspoonfuls onto the prepared cookie sheets. Flatten with a fork dipped in flour. Bake for 8 to 9 minutes in the preheated oven."
    }
  ],
  "servings": 36,

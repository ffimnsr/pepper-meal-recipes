  "name": "Summer Herb Pesto",
  "recipe_type": "side",
  "brief_description": "This summer herb pesto recipe creates an earthy, green pesto with basil, parsley, oregano, and spinach, combined with pine nuts and Parmesan cheese.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine basil, parsley, spinach, oil, oregano, pine nuts, Parmesan cheese, garlic, salt, and black pepper in a blender or the bowl of a food processor; blend until smooth."
    }

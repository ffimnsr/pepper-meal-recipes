  "id": "7d242e9c-f811-51bc-a8da-b3ec50c50d51",
  "slug": "ahi-poke-salad",
  "name": "Ahi Poke Salad",
  "recipe_type": "salad",
  "brief_description": "This Hawaiian ahi tuna poke salad is fresh and bright and can be served as an appetizer or light entr\u00e9e. This version features macadamia nuts.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together ahi tuna, onion, green onion, seaweed, macadamia nuts, sesame oil, red pepper flakes, and ginger in a mixing bowl."
    },
    {
      "position": 2,
      "text": "Cover and refrigerate for the flavors to come together, at least 1 hour."
    },
    {
      "position": 3,
      "text": "Arrange lettuce leaves on a serving platter, spoon ahi poke on top, and garnish with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "e6469e10-598c-5431-8f38-d7fb39cfbd3a",
  "slug": "grandma-gudgels-black-bottom-cupcakes",
  "name": "Grandma Gudgel's Black Bottom Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "A dollop of a rich cream cheese and chocolate chip batter is baked into the center of each of these deliciously moist chocolate cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly butter muffin tins and set aside."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, egg, sugar, and salt together in a large bowl until well combined. Stir in chocolate chips and set aside."
    },
    {
      "position": 3,
      "text": "Sift flour, sugar, cocoa, baking soda, and salt together in a bowl. Add the water, oil, vinegar, and vanilla. Beat until well combined and smooth. Batter will be thin."
    },
    {
      "position": 4,
      "text": "Fill muffin cups 1/3 full with the chocolate batter. Top each one with a spoonful of cream cheese mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 to 35 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "920acc4b-8ac4-53fc-b104-16428dc97a67",
  "slug": "gluten-free-magic-cookie-bars",
  "name": "(Gluten Free) Magic Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "Magic cookie bars can be made gluten-free by making a peanut butter base out of 3 simple ingredients. Layer with chocolate chips, nuts, and coconut for a decadent treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch glass baking dish with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix sugar and eggs together in a bowl until smooth; stir in peanut butter until well blended. Pour peanut butter mixture into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cookie base is partly cooked, 8 minutes."
    },
    {
      "position": 4,
      "text": "Layer semisweet chocolate chips, dark chocolate chips, pecans, almonds, and coconut onto the cookie base. Slowly pour sweetened condensed milk evenly over the toppings."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until coconut is slightly brown, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Cool completely before removing cookie bars from pan. Peel away parchment paper and cut into small squares using a sharp knife."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

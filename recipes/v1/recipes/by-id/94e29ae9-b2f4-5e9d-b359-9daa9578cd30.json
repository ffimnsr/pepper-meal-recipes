  "id": "94e29ae9-b2f4-5e9d-b359-9daa9578cd30",
  "slug": "super-easy-slow-cooker-chicken-enchilada-meat",
  "name": "Super Easy Slow Cooker Chicken Enchilada Meat",
  "recipe_type": "main",
  "brief_description": "This easy slow cooker recipe delivers tender chicken in an enchilada sauce perfect for your favorite Mexican dishes.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken broth, tomatoes, flour, chili powder, garlic, cumin, oregano, salt, and cayenne into a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Place chicken breasts in a slow cooker; pour blended sauce over chicken."
    },
    {
      "position": 3,
      "text": "Cover slow cooker. Cook on Low 8 to 9 hours (or on High 4 to 6 hours)."
    },
    {
      "position": 4,
      "text": "Shred chicken with 2 forks; stir into sauce."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 15,

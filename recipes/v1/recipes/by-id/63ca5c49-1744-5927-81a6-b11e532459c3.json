  "slug": "lemon-garlic-burrata-recipe-12012652",
  "name": "Lemon Garlic Burrata",
  "recipe_type": "appetizer",
  "brief_description": "This lemon garlic burrata is an easy, elegant appetizer that comes together in minutes. Creamy burrata is topped with a bright lemon-garlic dressing for a flavorful dish that\u2019s perfect served with crostini and fresh vegetables or as the centerpiece of a charcuterie board.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add basil, lemon juice, lemon zest, garlic, and olive oil to a mixing bowl. Combine all ingredients well."
    },
    {
      "position": 2,
      "text": "Use a knife to make a slit in the walls of the burrata. Place on a serving plate and squeeze sides gently to loosen the cheese."
    },
    {
      "position": 3,
      "text": "Spoon basil mixture directly on top and drizzle around it as well. Serve with toasted crostini bread or fresh veggies."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

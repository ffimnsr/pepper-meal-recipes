  "id": "d9aa89e3-2d1e-5710-9bd0-c19b4db858ba",
  "slug": "instant-pot-frozen-salmon",
  "name": "Instant Pot Frozen Salmon",
  "recipe_type": "main",
  "brief_description": "This Instant Pot recipe takes salmon from frozen to fabulously moist and delicious in less than 5 minutes for a quick, healthy weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour cold water and lemon juice into a multi-functional pressure cooker (such as Instant Pot). Place a steamer rack inside; coat with cooking spray."
    },
    {
      "position": 3,
      "text": "Place frozen salmon fillets, skin-side down, on the prepared rack. Cover and close the vent."
    },
    {
      "position": 4,
      "text": "Cook on the Steam setting until fish flakes easily with a fork, 3 to 4 minutes. Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Check salmon for desired doneness. Season with salt and pepper. Cover the pot to keep salmon warm until serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

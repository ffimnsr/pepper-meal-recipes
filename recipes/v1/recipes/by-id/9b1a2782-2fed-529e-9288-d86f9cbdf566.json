  "id": "9b1a2782-2fed-529e-9288-d86f9cbdf566",
  "slug": "zucchini-cookies",
  "name": "Zucchini Cookies",
  "recipe_type": "dessert",
  "brief_description": "These moist zucchini cookies are tender and delicious cake-like cookies studded with chewy raisins and flavored with ground cinnamon and cloves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, baking soda, cinnamon, cloves, and salt together in a medium bowl."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until smooth and creamy, 2 to 3 minutes. Beat in egg, then stir in shredded zucchini. Gradually stir in flour mixture until incorporated. Mix in raisins. Cover dough and refrigerate for at least 1 hour or overnight."
    },
    {
      "position": 3,
      "text": "When ready to bake, preheat the oven to 375 degrees F (190 degrees C). Grease two cookie sheets."
    },
    {
      "position": 4,
      "text": "Drop teaspoonfuls of chilled dough 2 inches apart onto the prepared cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set, 8 to 10 minutes, switching racks halfway through."
    },
    {
      "position": 6,
      "text": "Remove from the oven. Allow cookies to cool slightly on the cookie sheets before transferring to wire racks to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

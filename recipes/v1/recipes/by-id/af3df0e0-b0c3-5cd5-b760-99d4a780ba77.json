  "id": "af3df0e0-b0c3-5cd5-b760-99d4a780ba77",
  "slug": "honey-glazed-pork-tenderloin",
  "name": "Honey-Glazed Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "This honey-glazed pork tenderloin is so easy to make. Roasted in the oven and basted with a sweet and tangy sauce, it's a winning choice for dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place pork tenderloins into a roasting pan."
    },
    {
      "position": 3,
      "text": "Stir honey, soy sauce, sesame oil, vinegar, and brown sugar together in a bowl until well blended."
    },
    {
      "position": 4,
      "text": "Roast tenderloins in the preheated oven for 15 minutes."
    },
    {
      "position": 5,
      "text": "Reduce the temperature to 350 degrees F (175 degrees C), and baste tenderloins with honey sauce."
    },
    {
      "position": 6,
      "text": "Continue to roast, basting a few more times with remaining sauce, until pork is slightly pink in the center, about 45 more minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

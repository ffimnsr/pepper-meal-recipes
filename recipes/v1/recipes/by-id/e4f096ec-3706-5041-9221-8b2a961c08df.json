  "id": "e4f096ec-3706-5041-9221-8b2a961c08df",
  "slug": "chocolate-waffles-i",
  "name": "Chocolate Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These chocolate waffles are a favorite. They offer a fun flavor variation on traditional waffles with a touch of cocoa. They are light and fluffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat a waffle iron."
    },
    {
      "position": 2,
      "text": "Make waffles: Stir together flour, sugar, cocoa, baking powder, and salt in a large mixing bowl. Stir in milk, eggs, and butter until the mixture is smooth."
    },
    {
      "position": 3,
      "text": "Make hard sauce: stir together softened butter, confectioners' sugar, vanilla extract, and milk. Sauce should be fairly stiff. Set aside."
    },
    {
      "position": 4,
      "text": "Spray preheated waffle iron with nonstick cooking spray. Pour waffle mix onto hot waffle iron. Cook until golden brown."
    },
    {
      "position": 5,
      "text": "Serve hot with hard sauce."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

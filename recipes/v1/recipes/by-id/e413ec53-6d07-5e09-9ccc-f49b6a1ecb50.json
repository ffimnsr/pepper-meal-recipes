  "id": "e413ec53-6d07-5e09-9ccc-f49b6a1ecb50",
  "slug": "easy-bacon-and-cheese-quiche",
  "name": "Easy Bacon and Cheese Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This is an easy, cheesy bacon quiche that takes no time to prepare using a frozen deep-dish pie crust, bacon bits, cream, and two types of cheese.",
  "cuisine": "French American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place unthawed pie crust in a 9 inch pie plate on a baking sheet. Combine Swiss cheese, onion, Parmesan cheese, and bacon bits in a medium bowl; pour into the crust."
    },
    {
      "position": 3,
      "text": "Whisk eggs and half and half together in a bowl until blended; pour over cheese mixture."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until quiche top begins to turn golden brown, about 35 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e37ed910-fbd7-5da8-b2a8-07299ba5da92",
  "slug": "blackened-shrimp-stroganoff",
  "name": "Blackened Shrimp Stroganoff",
  "recipe_type": "main",
  "brief_description": "This shrimp stroganoff recipe combines Cajun seasoned shrimp with shallots, mushrooms, roasted red peppers, and a white sauce served over fettuccini.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Combine peeled shrimp, oil, and Cajun seasoning in a medium bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter over medium heat in a large frying pan. Cook and stir mushrooms and shallot in butter until tender. Remove from pan. Add shrimp. Cook until shrimp turn pink, about 2 to 3 minutes. Remove from pan. Add 2/3 cup chicken broth to pan and bring to a boil. Cook, uncovered, until reduced to 1/4 cup (2 to 3 minutes)."
    },
    {
      "position": 4,
      "text": "In a small bowl, stir together sour cream and cornstarch; mix in 1 cup chicken broth. Stir into reduced chicken broth in the frying pan. Cook and stir until thick and bubbly. Cook 1 minute more. Stir in shrimp, mushroom mixture, roasted red peppers, and capers. Heat through, and season to taste. Serve over pasta."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

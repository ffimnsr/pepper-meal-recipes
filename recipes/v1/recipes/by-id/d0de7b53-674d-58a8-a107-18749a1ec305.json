  "id": "d0de7b53-674d-58a8-a107-18749a1ec305",
  "slug": "brazilian-grilled-pineapple",
  "name": "Brazilian Grilled Pineapple",
  "recipe_type": "side",
  "brief_description": "These delicious grilled pineapple slices are coated in a simple mix of brown sugar and cinnamon to create this Brazilian steakhouse favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Whisk brown sugar and cinnamon together in a bowl."
    },
    {
      "position": 3,
      "text": "Transfer into a large resealable plastic bag. Add pineapple wedges to the bag; shake well to coat each wedge."
    },
    {
      "position": 4,
      "text": "Grill pineapple wedges on the preheated grill until heated through, 3 to 5 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

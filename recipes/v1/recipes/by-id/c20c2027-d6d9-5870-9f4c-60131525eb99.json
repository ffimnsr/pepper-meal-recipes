  "schema_version": 1,
  "id": "c20c2027-d6d9-5870-9f4c-60131525eb99",
  "slug": "blueberry-lemon-shortcake",
  "name": "Blueberry Lemon Shortcake",
  "recipe_type": "dessert",
  "brief_description": "Fresh blueberries make a wonderful sauce for this buttery pound cake served with homemade lemon curd.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1/2 cup sugar, water, and cornstarch over medium heat. Add blueberries and bring to a boil, stirring constantly. Boil until thickened, about 1 minute. Remove from heat."
    },
    {
      "position": 2,
      "text": "Beat 2 eggs, yolks, 1/2 cup sugar, 2 tablespoons milk, and salt in a saucepan until well mixed. Stir lemon juice and zest into egg mixture. Add 1/3 cup butter."
    },
    {
      "position": 3,
      "text": "Cook and stir egg mixture over medium heat until lemon curd is thick enough to coat the back of a spoon, about 5 minutes. Pour mixture into a bowl and cool. Lemon curd can be covered and refrigerated for up to two weeks."
    },
    {
      "position": 4,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease two 11x17-inch baking sheets."
    },
    {
      "position": 5,
      "text": "Combine flour and baking powder in a small bowl. Mix 1 cup milk, lemon extract, coconut extract, vanilla extract, butter extract, and almond extract in a separate bowl."
    },
    {
      "position": 6,
      "text": "Beat 3 cups sugar, 1 cup softened butter, and shortening in a large bowl until light and fluffy. Beat 5 eggs into butter mixture until smooth. Pour in the flour mixture alternately with milk, mixing until batter is just incorporated. Divide batter into prepared baking sheets, spreading evenly."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until cake springs back when lightly pressed, 25 to 35 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    },
    {
      "position": 8,
      "text": "Cut cake into rounds using a cookie cutter or drinking glass. Place a cake round on a plate and top with blueberry sauce and lemon curd. Top with another cake round, followed by blueberry sauce and lemon curd to make one serving. Repeat with remaining cake, sauce, and curd."
    }
  ],

  "id": "14e0733a-398e-5d45-aaea-a2ad6ad924a3",
  "slug": "hibachi-chicken-and-rice-casserole-recipe-11798799",
  "name": "Hibachi Chicken and Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This hibachi something is a one-skillet dinner that goes from stovetop to table. Boneless chicken thighs, zucchini, and broccoli baked with instant rice make a family-friendly dinner with minimal effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat, add chicken, and cook until it begins to brown, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Add soy sauce, brown sugar, rice wine vinegar, black pepper, and ginger and cook on medium heat until the sauce starts to thicken. Pour chicken mixture into a large bowl and set aside."
    },
    {
      "position": 4,
      "text": "Bring the skillet back to medium heat and saute onions, broccoli and zucchini for 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Add chicken mixture, garlic, rice, and broth to the skillet and stir to combine. Place lid on the skillet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. Remove lid and cook until the top is golden brown, 5 to 10 minutes more."
    },
    {
      "position": 7,
      "text": "Drizzle with yum yum sauce and sprinkle with green onions before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8db5da7d-cc18-5672-9d82-1121d15478f0",
  "slug": "homemade-grain-free-dog-food",
  "name": "Homemade Grain-Free Dog Food",
  "recipe_type": null,
  "brief_description": "This homemade grain-free dog food is an easy alternative to store-bought, and it's got all the vitamins, minerals, and essential fatty acids your dog needs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place carrots, apples, and water into a pot. Bring to a boil, then cover, reduce the heat to low, and simmer until soft, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, crack eggs into a bowl and set aside. Place eggshells onto a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake eggshells in the preheated oven until dry, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Remove eggshells from the oven and pulverize using a mortar and pestle or a coffee grinder."
    },
    {
      "position": 6,
      "text": "Combine ground chicken, chicken livers, reserved eggs, ground eggshells, and sunflower oil in a large skillet. Heat over medium heat, mixing occasionally, until chicken is browned and crumbly and livers are no longer pink, 5 to 7 minutes."
    },
    {
      "position": 7,
      "text": "Place spinach on top of meat mixture, then cover with a lid and steam until soft, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Mash softened carrots and apples in a bowl with a potato masher and add to meat mixture. Mix until well combined."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

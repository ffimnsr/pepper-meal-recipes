  "id": "2bf3e92a-3ba2-573f-ba83-e2b5e20d378d",
  "slug": "funeral-chicken-and-potato-casserole-recipe-11954410",
  "name": "Funeral Chicken and Potato Casserole",
  "recipe_type": "soup",
  "brief_description": "This funeral chicken and potato casserole is creamy, rich, and cheesy, baked with a crunchy cornflake topping, the ultimate comfort food. Cooked chicken and frozen hash browns bake in a sauce of cream of chicken soup, sour cream, and Cheddar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Reserve 3 tablespoons green onions for garnish and set aside."
    },
    {
      "position": 2,
      "text": "Combine remaining green onions, cream of chicken soup, sour cream, Cheddar cheese, dried onion, salt, pepper, chicken, and hash browns in a large bowl and mix well."
    },
    {
      "position": 3,
      "text": "Pour mixture into a lightly greased 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Stir together cornflakes and butter in a small bowl until well blended and sprinkle mixture evenly over the casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until browned, bubbly and heated throughout, 50 to 60 minutes. Let stand 10 minutes before serving. Sprinkle with reserved green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

  "id": "b5cf4d4e-f8ae-568e-b6d9-a3929ffce753",
  "slug": "pumpkin-pecan-pie-i",
  "name": "Pumpkin Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin pecan pie has a rich and nutty pumpkin filling for the perfect combination of two holiday favorites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together one egg, pumpkin, 1/3 cup sugar, and spice. Spread over bottom of pie shell."
    },
    {
      "position": 3,
      "text": "Combine 2 eggs, corn syrup, 1/2 cup sugar, butter and vanilla. Stir in nuts. Spoon over pumpkin mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is set, about 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

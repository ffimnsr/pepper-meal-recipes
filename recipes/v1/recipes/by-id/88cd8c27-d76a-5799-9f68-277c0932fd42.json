  "slug": "citrus-mousse",
  "name": "Citrus Mousse",
  "recipe_type": "dessert",
  "brief_description": "Whipped topping is combined with condensed milk and fruit juices in this quick dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, beat together whipped topping and condensed milk. Gradually beat in lemon and grapefruit juices, until evenly blended."
    },
    {
      "position": 2,
      "text": "Pour the mousse into one bowl or divide it into individual serving dishes. Garnish with fruit, if desired."
    }
  ],
  "servings": 8,

  "id": "ea21d588-fb8d-529e-8361-572526ef8d31",
  "slug": "garlic-prime-rib",
  "name": "Garlic Prime Rib",
  "recipe_type": "main",
  "brief_description": "A simple prime rib marinade made with olive oil, lots of garlic, black pepper, and thyme turns your prime rib roast into a restaurant-worthy meal.",
  "cuisine": "American Australian British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients for marinade."
    },
    {
      "position": 2,
      "text": "Mix garlic, olive oil, salt, pepper, and thyme together in a small bowl."
    },
    {
      "position": 3,
      "text": "Place roast in a roasting pan with the fatty side up. Spread mixture over the top of roast; let roast sit out until it is at room temperature, no longer than 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake roast in the preheated oven for 30 minutes; reduce the temperature to 325 degrees F (165 degrees C), and continue roasting for an additional 60 to 75 minutes. The internal temperature of the roast should be at 135 degrees F (57 degrees C) for medium rare."
    },
    {
      "position": 6,
      "text": "Allow roast to rest for 10 or 15 minutes before carving so the meat can retain its juices."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

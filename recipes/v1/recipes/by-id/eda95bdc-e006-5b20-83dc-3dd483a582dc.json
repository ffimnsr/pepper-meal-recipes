  "id": "eda95bdc-e006-5b20-83dc-3dd483a582dc",
  "slug": "blueberry-upside-down-cake",
  "name": "Blueberry Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "Try this blueberry upside-down cake featuring an easy cake batter baked on a layer of sweet and juicy caramelized blueberries for a fab berry dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch springform pan."
    },
    {
      "position": 2,
      "text": "To make the blueberry topping: Combine blueberries, sugar, flour, and lemon zest in a bowl. Toss until blueberries are coated, then pour into the prepared pan."
    },
    {
      "position": 3,
      "text": "To make the cake: Cream sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in eggs, one at a time, then stir in lemon zest and almond extract."
    },
    {
      "position": 4,
      "text": "Stir flour and baking powder together in a small bowl; beat into butter mixture alternately with milk, mixing just until incorporated. Pour cake batter over blueberries in the pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 60 to 70 minutes. Place a serving plate over the top of the pan and carefully invert the cake and plate together so the berries end up on top. Carefully unlock the buckle on the side of the pan and remove. Sprinkle toasted almonds on top of the cake and serve warm."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

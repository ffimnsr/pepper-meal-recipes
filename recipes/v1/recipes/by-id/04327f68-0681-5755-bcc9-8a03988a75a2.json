  "slug": "sloppy-does",
  "name": "Sloppy Does",
  "recipe_type": "main",
  "brief_description": "These Sloppy Does are a venison version of the famous Sloppy Joes, the ground beef and tomato sauce sandwich that we all remember from our childhoods.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium heat. Add venison and jalape\u00f1o; cook, stirring often, until browned and crumbly; about 10 minutes. Stir in ketchup, garlic, molasses, and mustard. Bring to a boil, then reduce the heat to low. Simmer for at least 10 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

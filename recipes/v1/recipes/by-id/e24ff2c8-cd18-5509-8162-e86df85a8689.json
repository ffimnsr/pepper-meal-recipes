  "slug": "garlic-shrimp-with-three-cheese-tortellini",
  "name": "Garlic Shrimp with Three Cheese Tortellini",
  "recipe_type": "main",
  "brief_description": "Garlic shrimp are saut\u00e9ed with sun-dried tomatoes, pesto, fresh basil, and 3-cheese tortellini for a tasty and elegant meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Prepare pasta according to package directions."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat; cook shrimp, oil, and garlic, stirring frequently, until shrimp turn pink. Remove from heat."
    },
    {
      "position": 3,
      "text": "Toss pasta with pesto. Add sun-dried tomatoes and basil; toss well. Top with shrimp and cheese."
    }
  ],
  "servings": 2,

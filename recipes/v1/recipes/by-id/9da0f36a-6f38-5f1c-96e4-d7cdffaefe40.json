  "id": "9da0f36a-6f38-5f1c-96e4-d7cdffaefe40",
  "slug": "shrimpcargot",
  "name": "Shrimpcargot",
  "recipe_type": "appetizer",
  "brief_description": "This shrimpcargot recipe nestles shirmp into fresh mushroom caps, mimicking escargot with garlic butter. Serve with bread to mop up the garlic butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat butter and garlic in a skillet over medium heat until butter begins to bubble. Add shrimp; cook until they just turn pink, about 3 minutes. Place 1 shrimp into each mushroom cap; place mushroom caps into a small baking dish. Spoon garlic butter into mushroom caps; sprinkle each with mozzarella cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until mushrooms are tender and cheese is golden and bubbly, 10 to 15 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

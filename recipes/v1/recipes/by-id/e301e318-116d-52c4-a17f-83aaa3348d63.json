  "id": "e301e318-116d-52c4-a17f-83aaa3348d63",
  "slug": "maryland-pumpkin-seeds",
  "name": "Maryland Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This oven-toasted Maryland pumpkin seeds recipe with Old Bay seasoning makes a tasty snack. This three-ingredient recipe is quick and easy to prepare.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Rinse pumpkin seeds in a colander. Spread onto paper towels; pat dry."
    },
    {
      "position": 3,
      "text": "Coat a large baking sheet with cooking spray; spread pumpkin seeds in a single layer. Coat seeds with cooking spray; sprinkle with seafood seasoning."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until dry and toasted, stirring occasionally, about 30 minutes. Cool."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

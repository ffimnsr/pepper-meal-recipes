{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e31b4377-27ae-54fd-adf3-eae8466a6f85",
  "slug": "sheet-pan-quesadillas-recipe-8642141",
  "name": "Sheet Pan Quesadillas",
  "recipe_type": "main",
  "brief_description": "These crispy sheet pan quesadillas are baked all at once with tortillas stuffed with chicken and melty cheese for an easy, tasty way to feed a crowd.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Add onion, green bell pepper, and red bell pepper; cook, stirring occasionally, until just softened, about 2 minutes. Remove with a slotted spoon and set aside."
    },
    {
      "position": 3,
      "text": "Add chicken to the same skillet and cook until no longer pink on the outside, about 3 minutes. Return onion and bell peppers to the skillet. Stir in water and fajita seasoning. Cook and stir until the chicken has completely cooked through."
    },
    {
      "position": 4,
      "text": "Oil or grease a 1/4 sheet pan (9x13-inch), then arrange 6 tortillas around edges so half of each hangs over the sides; place 1 tortilla in the center to cover the bottom."
    },
    {
      "position": 5,
      "text": "Spoon chicken mixture evenly over tortillas, avoiding excess liquid. Sprinkle evenly with cheese."
    },
    {
      "position": 6,
      "text": "Place 1 tortilla in the center on top; fold overhanging tortillas toward the center to enclose filling. Top with a second baking sheet to press (this will help the quesadilla hold its shape)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 10 minutes. Remove the top baking sheet and continue baking until the tortillas are golden and crispy, 8 to 12 more minutes."
    },
    {
      "position": 8,
      "text": "Slice into rectangles and serve topped with sour cream, pico de gallo, and cilantro, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "fdca621c-81a2-528a-a044-36f3a8a29b03",
  "slug": "brined-thanksgiving-turkey",
  "name": "Brined Thanksgiving Turkey",
  "recipe_type": "drink",
  "brief_description": "This holiday turkey recipe uses apple juice and chicken stock in a brine and apples, onion, and garlic to stuff the bird, lending a hint of aromatic fruitiness to the centerpiece of your big meal.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir chicken broth, apple juice, brown sugar, salt, dried sage, and peppercorns together in a large stock pot; add apple halves and crushed garlic cloves. Bring the mixture just to a boil, stirring to dissolve sugar and salt. Remove from heat immediately."
    },
    {
      "position": 3,
      "text": "Pour enough ice into a large food-safe container to be about half full. Pour chicken broth mixture over the ice; stir to cool liquid completely and evenly."
    },
    {
      "position": 4,
      "text": "Gently lower turkey into the liquid with the breast facing down."
    },
    {
      "position": 5,
      "text": "Brine turkey 24 to 36 hours, adding ice as needed to keep the brine and turkey cold."
    },
    {
      "position": 6,
      "text": "Preheat oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 7,
      "text": "Remove turkey from the brine and rinse well with cold water. Pat turkey dry with paper towels."
    },
    {
      "position": 8,
      "text": "Mix apple quarters, onion wedges, whole garlic cloves, and fresh sage leaves in a bowl; loosely stuff into cavity of turkey."
    },
    {
      "position": 9,
      "text": "Move the turkey to a shallow roasting pan. Lightly coat the turkey's skin with olive oil."
    },
    {
      "position": 10,
      "text": "Bake the turkey in the preheated oven until the skin on the breast of the turkey is golden brown, about 30 minutes."
    },
    {
      "position": 11,
      "text": "Reduce heat to 350 degrees F (175 degrees C), cover turkey with aluminum foil, and continue roasting the turkey until no longer pink at the bone and the juices run clear, about 6 hours. An instant-read thermometer inserted into the thickest part of the thigh should read 180 degrees F (85 degrees C)."
    },
    {
      "position": 12,
      "text": "Remove the turkey from the oven, cover with a doubled sheet of aluminum foil, and allow to rest in a warm area 10 to 15 minutes before slicing."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "99b0fbe0-5b46-5d6a-942d-982d6525c730",
  "slug": "swedish-meatball-pasta-bake-recipe-11691947",
  "name": "Swedish Meatball Pasta Bake",
  "recipe_type": "main",
  "brief_description": "In this Swedish meatball pasta bake, 'k\u00f6ttbullar', creamy gravy and bowtie noodles come together in a rich, creamy comfort dish.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease a 7x11-inch baking dish."
    },
    {
      "position": 2,
      "text": "Lightly beat egg in a medium bowl. Stir in bread crumbs, onion, milk, salt, nutmeg, allspice, and cayenne pepper. Add ground beef and mix well. Shape 1 1/2 tablespoon portions of the mixture into meatballs."
    },
    {
      "position": 3,
      "text": "Heat oil in a 12-inch skillet over medium-high heat. Add meatballs and brown on all sides, about 8 minutes. They won\u2019t be done at this point, but will get done as they bake."
    },
    {
      "position": 4,
      "text": "Meanwhile, cook pasta according to package directions. Drain and add to the prepared baking dish. Nestle meatballs atop the pasta."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Pour beef broth into the same skillet and bring to a boil while scraping the browned bits of food off the bottom of the skillet with a wooden spoon. Pour in whipping cream and Worcestershire sauce to and bring to a boil. Reduce heat to medium and simmer until sauce has slightly thickened and reduced to 2 1/2 cups, 6 to 8 minutes."
    },
    {
      "position": 7,
      "text": "Pour sauce over meatballs and pasta in the baking dish. Cover dish with foil."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until hot and bubbly, 20 minutes."
    },
    {
      "position": 9,
      "text": "Uncover and sprinkle with cheese. Bake, uncovered until cheese melts, 3 to 5 minutes. Garnish with dill. Squeeze lemon wedge over the dish."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

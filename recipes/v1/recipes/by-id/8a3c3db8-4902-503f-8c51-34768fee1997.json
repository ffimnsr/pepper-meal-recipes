  "slug": "homemade-seasoned-salt",
  "name": "Homemade Seasoned Salt",
  "recipe_type": null,
  "brief_description": "This seasoning salt made with salt, black pepper, paprika, garlic powder, onion powder, and cayenne adds flavor to meats or vegetables for the grill.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine salt, pepper, paprika, garlic powder, onion powder, and cayenne pepper in an airtight container."
    },
    {
      "position": 3,
      "text": "Seal and shake to blend."
    }
  ],

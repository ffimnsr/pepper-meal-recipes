  "id": "ca5407e8-9282-54bf-976e-13e06b5da7f1",
  "slug": "venison-bacon-burgers",
  "name": "Venison Bacon Burgers",
  "recipe_type": "main",
  "brief_description": "An easy venison burger recipe. Crisp, crumbly bacon is mixed into seasoned ground venison to make the best juicy burgers you've ever tasted.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook bacon in a skillet over medium heat until browned and crispy."
    },
    {
      "position": 3,
      "text": "Pour bacon and grease into a heatproof bowl and allow to cool."
    },
    {
      "position": 4,
      "text": "Heat oil in a skillet. Add shallots and garlic. Cook and stir until softened, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Mix with bacon."
    },
    {
      "position": 6,
      "text": "Mix venison with cooled bacon mixture. Season with Worcestershire sauce, parsley, salt, and pepper. Stir in egg until evenly combined. Refrigerate for 20 minutes."
    },
    {
      "position": 7,
      "text": "Preheat an outdoor grill for medium-high heat."
    },
    {
      "position": 8,
      "text": "Shape venison mixture into 6 patties."
    },
    {
      "position": 9,
      "text": "Grill to desired doneness. Serve on toasted hamburger buns with your favorite toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

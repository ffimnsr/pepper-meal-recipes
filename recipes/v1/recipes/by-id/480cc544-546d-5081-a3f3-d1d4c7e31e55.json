{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "480cc544-546d-5081-a3f3-d1d4c7e31e55",
  "slug": "baked-ziti-alfredo-with-cajun-chicken",
  "name": "Baked Ziti Alfredo with Cajun Chicken",
  "recipe_type": "main",
  "brief_description": "This baked ziti Alfredo with Cajun-spiced chicken is a creamy, cheesy comfort food casserole the whole family will love any day of the week.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook ziti in boiling water, stirring occasionally, until tender yet firm to the bite, about 10 minutes. Drain."
    },
    {
      "position": 3,
      "text": "While ziti is cooking, heat olive oil in a large skillet over medium to medium-high heat. Add chicken, Cajun seasoning, and salt. Saut\u00e9 until chicken is cooked through and beginning to caramelize, about 10 minutes. Add bell peppers, onion, and 1/2 of the garlic; cook until tender, 5 to 7 minutes. Add tomatoes and bring to a simmer."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt butter in a medium saucepan over medium heat. Add remaining garlic and saut\u00e9 until fragrant, about 1 minute. Add flour; cook and stir for 1 minute. Slowly whisk in milk and bring to a gentle boil. Stir in Parmesan cheese, salt, and pepper. Add more Parmesan to thicken or more milk to thin to your liking."
    },
    {
      "position": 5,
      "text": "Add cooked ziti to chicken mixture; toss to coat. Transfer to a deep casserole dish. Pour cheese sauce over pasta mixture and top with mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the top is golden and bubbly, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

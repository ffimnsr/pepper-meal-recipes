  "id": "6b4471ad-2044-5a1d-8857-f965f5680ce2",
  "slug": "instant-pot-pasta-primavera",
  "name": "Instant Pot Pasta Primavera",
  "recipe_type": "main",
  "brief_description": "No matter what you serve this with, you and your family will love this 30-minute easy pasta primavera made in the Instant Pot with frozen vegetables.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Add butter and stir until melted. Add onion and cook until translucent, 5 to 7 minutes. Add garlic and cook until fragrant and butter starts to burn, 1 to 2 minutes. Season with pepper."
    },
    {
      "position": 2,
      "text": "Carefully pour in lemon juice; pot will release steam. Add cooking wine and immediately turn pot off. Scrape the bottom of the pot with a spoon to loosen any browned bits. Add pasta, then just enough water to barely cover it."
    },
    {
      "position": 3,
      "text": "Place a steamer basket on top of the pasta. Add frozen vegetables and season with salt and pepper. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 1 minute. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, for 2 minutes, then release remaining pressure carefully using the quick-release method. Unlock and remove the lid. Remove steamer basket and stir vegetables into the pasta."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

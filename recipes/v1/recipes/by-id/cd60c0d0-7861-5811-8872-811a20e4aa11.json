  "id": "cd60c0d0-7861-5811-8872-811a20e4aa11",
  "slug": "irresistible-oatmeal-cream-pies",
  "name": "Irresistible Oatmeal Cream Pies",
  "recipe_type": "dessert",
  "brief_description": "In this irresistible oatmeal cream pie sandwich cookie recipe, cinnamon chips are the secret ingredient. Friends and family will find them hard to resist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat 1 cup butter, brown sugar, white sugar, eggs, molasses, and 1 \u00bd teaspoons vanilla extract in a large bowl with an electric mixer until creamy."
    },
    {
      "position": 3,
      "text": "Combine flour, cinnamon, baking soda, and salt in a separate bowl; stir into butter mixture. Fold in oats and cinnamon chips until well combined."
    },
    {
      "position": 4,
      "text": "Drop tablespoonfuls of dough onto ungreased baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges start to brown, 10 to 12 minutes. Transfer to wire racks to cool."
    },
    {
      "position": 6,
      "text": "Beat confectioners' sugar, \u00bd cup butter, heavy cream, and 1 teaspoon vanilla extract in the bowl of a stand mixer fitted with the paddle attachment on high speed until light and fluffy, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Spread 1 teaspoon cream filling over half cookies; top with remaining cookies."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

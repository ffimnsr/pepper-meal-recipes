  "id": "68737547-ac5e-55d2-897b-c8c2daf5466b",
  "slug": "spicy-indian-gujarati-green-beans",
  "name": "Spicy Indian Green Beans, Gujarati Style",
  "recipe_type": "dessert",
  "brief_description": "These Indian green beans with chile pepper, mustard, and garlic are cooked Gujarati-style, with a distinctive sweet, salty, and spicy flavors all at once.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Cook green beans briefly in the boiling water, removing after 3 to 4 minutes. Drain, rinse with cold water, and drain again. Blot dry."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Stir in garlic and mustard seed; saut\u00e9 until golden brown, 1 to 2 minutes. Stir in chile pepper, then add beans, salt, and sugar. Cook and stir until beans are tender, about 8 minutes. Season with pepper to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

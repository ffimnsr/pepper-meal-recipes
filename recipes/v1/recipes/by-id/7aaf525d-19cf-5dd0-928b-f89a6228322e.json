  "id": "7aaf525d-19cf-5dd0-928b-f89a6228322e",
  "slug": "raw-apple-cake",
  "name": "Raw Apple Cake",
  "recipe_type": "dessert",
  "brief_description": "This raw apple cake recipe made with chopped Granny Smith apples features a rich cream cheese frosting and can include nuts and raisins, if you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F(175 degrees C). Grease and flour a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Whisk oil and eggs together in a bowl. Place apples in a separate bowl: pour oil mixture over top."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk flour, white sugar, baking soda, 1 teaspoon salt, cinnamon, and nutmeg together in a separate bowl; fold into apple mixture until batter is thick but well combined. Pour into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 45 minutes. Cool, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Beat cream cheese, 1 tablespoon milk, vanilla extract, and 1 pinch salt in a bowl until well combined; gradually beat in confectioners' sugar until smooth. Beat in more milk, if needed, 1 tablespoon at a time, until reaches desired consistency."
    },
    {
      "position": 6,
      "text": "Spread cream cheese frosting over cooled cake."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,

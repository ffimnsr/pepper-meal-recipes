  "id": "3a343cbd-a13e-51be-8855-b80922142f41",
  "slug": "picnic-macaroni-salad",
  "name": "Picnic Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "Be picnic-ready with this macaroni salad recipe full of canned tuna, olives, bell peppers, and seasonings, that's easily mixed and chilled in a jiffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain. Cool completely, about 30 minutes. Transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Combine ranch dressing, 2 tablespoons reserved olive juice, mayonnaise, garlic powder, adobo seasoning, and black pepper in a small bowl."
    },
    {
      "position": 3,
      "text": "Pour dressing over macaroni; stir in olives, tuna, and bell pepper until well combined."
    },
    {
      "position": 4,
      "text": "Cover the bowl with plastic wrap; chill in the refrigerator until serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

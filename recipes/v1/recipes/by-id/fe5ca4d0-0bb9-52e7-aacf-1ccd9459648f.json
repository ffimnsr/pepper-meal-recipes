  "id": "fe5ca4d0-0bb9-52e7-aacf-1ccd9459648f",
  "slug": "holiday-spritz-cookies",
  "name": "Holiday Spritz Cookies",
  "recipe_type": "dessert",
  "brief_description": "These classic holiday cookies made with a cookie press are everybody's favorite, both to decorate and to eat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 375 degrees F. Stir flour, salt and baking powder in medium bowl until well blended. Beat shortening, butter and powdered sugar in large bowl with electric mixer on medium speed until light and fluffy. Beat in egg, almond extract and food color. Beat in flour mixture gradually until blended."
    },
    {
      "position": 2,
      "text": "Fit cookie press with Christmas tree or wreath plate according to manufacturer's instructions. Fill cookie press according to instructions. Press dough onto ungreased baking sheets. Bake 6 to 7 minutes or until set, but not brown. Cool 1 minute on baking sheet. Remove to wire rack to cool completely."
    },
    {
      "position": 3,
      "text": "Place frosting in large heavy-duty resealable plastic bag. Microwave on HIGH 20 to 30 seconds to soften. Knead. Cut very small bottom corner off bag. Drizzle over cookies in a decorative pattern. Place candy bits from frosting in medium bowl. Hold cookie over bowl and sprinkle with candy bits. Let stand 15 minutes or until frosting is set."
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 30,

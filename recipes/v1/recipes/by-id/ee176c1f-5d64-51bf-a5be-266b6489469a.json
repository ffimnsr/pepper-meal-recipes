  "id": "ee176c1f-5d64-51bf-a5be-266b6489469a",
  "slug": "shrimp-in-foil",
  "name": "Shrimp Foil Packets",
  "recipe_type": "main",
  "brief_description": "These shrimp foil packets are grilled with a delicious mixture of olive oil, garlic, and parsley for a flavorsome, mess-free summer seafood dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine parsley, olive oil, garlic, red pepper flakes, salt, and black pepper in a large bowl. Add shrimp and mix well. Allow to marinate for 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat an outdoor grill for high heat."
    },
    {
      "position": 3,
      "text": "Lay 1 sheet heavy-duty aluminum foil on a flat surface; fold in half. Fold up edges to create a pouch in the middle. Spread marinated shrimp in the pouch and drizzle with lemon juice. Lightly close to make a packet."
    },
    {
      "position": 4,
      "text": "Cook packet on the preheated grill until shrimp are bright pink on the outside and the meat is opaque, 8 to 10 minutes. Serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

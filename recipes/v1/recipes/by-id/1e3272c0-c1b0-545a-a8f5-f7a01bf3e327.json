  "id": "1e3272c0-c1b0-545a-a8f5-f7a01bf3e327",
  "slug": "egg-free-gingerbread-cookies",
  "name": "Egg-Free Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "Even those with egg allergies can enjoy gingerbread cookies with this recipe that's easy enough for kids to help with.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter and sugar in a bowl."
    },
    {
      "position": 2,
      "text": "Bring water, corn syrup, cinnamon, cloves, and ginger to a boil in a saucepan. Pour over butter and sugar and beat until blended. Gradually stir in flour and baking soda until dough is smooth."
    },
    {
      "position": 3,
      "text": "Halve the dough and form into discs. Wrap discs in plastic wrap and refrigerate, 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Let dough soften slightly. Roll it out to 1/8-inch thickness. Cut dough using gingerbread men cookie cutters. Arrange on ungreased cookie sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tops look dry, 8 to 10 minutes. Cool on wire racks."
    },
    {
      "position": 7,
      "text": "Beat powdered sugar, butter, and vanilla extract together until stiff. Thin mixture out with milk. Spread frosting over cooled cookies."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 40,

  "id": "a7f2d2aa-f796-5679-b3f7-c00336872db9",
  "slug": "low-carb-meatloaf-with-pork-rinds",
  "name": "Low-Carb Meatloaf with Pork Rinds",
  "recipe_type": "main",
  "brief_description": "This keto meatloaf is a tasty combination of ground beef, crushed pork rinds, and Parmesan. It's full of flavor and texture, and it's so easy to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 3,
      "text": "Mix beef, pork rinds, Parmesan, tomato sauce, onion, egg, parsley, salt, pepper, and garlic powder together in a bowl until well combined."
    },
    {
      "position": 4,
      "text": "Press mixture into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until browned and no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

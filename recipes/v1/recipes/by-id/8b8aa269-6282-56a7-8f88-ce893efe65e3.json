  "id": "8b8aa269-6282-56a7-8f88-ce893efe65e3",
  "slug": "chinese-fried-noodles",
  "name": "Easy Chinese Fried Noodles",
  "recipe_type": "side",
  "brief_description": "These stir fried noodles flavored with an easy sesame and soy stir fry sauce are quick and easy to make using ramen noodles and your favorite veggies.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a medium pot of water to a boil. Cook ramen noodles, reserving seasoning packets, in boiling water until softened, about 3 minutes. Drain noodles and set aside."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon vegetable oil in a small skillet. Cook and stir beaten eggs in hot oil until scrambled and firm. Set aside."
    },
    {
      "position": 4,
      "text": "Heat 1 teaspoon vegetable oil in a large skillet or wok over medium heat. Add green onions into hot oil and stir fry until softened, 2 to 3 minutes. Remove green onions to a plate; set aside."
    },
    {
      "position": 5,
      "text": "Heat remaining 1 teaspoon vegetable oil in the same wok or skillet over medium heat. Add carrots, peas, and bell pepper separately; stir frying until softened, removing each to the plate with green onions when done."
    },
    {
      "position": 6,
      "text": "Combine 2 tablespoons sesame oil with remaining 1 tablespoon vegetable oil in the same skillet or a wok over medium heat. Stir fry cooked noodles in hot sesame-vegetable oil, tossing frequently, until golden, 3 to 5 minutes. Season with desired amounts of sesame oil, soy sauce, and reserved ramen seasoning packets; toss to coat."
    },
    {
      "position": 7,
      "text": "Stir in cooked vegetables, tossing frequently, until heated through, about 5 more minutes."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

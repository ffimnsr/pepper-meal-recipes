  "slug": "classic-cosmopolitan-recipe-11927196",
  "name": "Classic Cosmopolitan",
  "recipe_type": "drink",
  "brief_description": "Add extra citrus flavor to the classic cranberry cocktail with citron-flavor vodka. Garnish with lemon, lime, and/or orange wheel or twist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker half-full with ice. Pour in vodka, orange liqueur, lime juice, and cranberry juice. Cover and shake until very cold; strain into a chilled martini glass. Garnish with a citrus wheel or twist."
    }
  ],

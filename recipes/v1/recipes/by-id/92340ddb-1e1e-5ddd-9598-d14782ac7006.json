  "schema_version": 1,
  "id": "92340ddb-1e1e-5ddd-9598-d14782ac7006",
  "slug": "keto-chicken-cordon-bleu-meatballs",
  "name": "Keto Chicken Cordon Bleu Meatballs",
  "recipe_type": "main",
  "brief_description": "These keto chicken Cordon Bleu meatballs are ham-stuffed chicken meatballs topped with a creamy Swiss cheese sauce. Simple and delicious!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, almond flour, salt, garlic powder, onion powder, and egg in a bowl. Form a small portion of chicken mixture into a 1 1/2-inch ball around a cube of ham; place on a plate. Repeat with remaining chicken mixture and ham, making 20 meatballs total."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-high heat. Brown meatballs for 3 minutes on one side; turn and cook an additional 3 to 4 minutes. Transfer meatballs onto a clean plate."
    },
    {
      "position": 3,
      "text": "Return the skillet to medium heat and melt butter. Whisk in chicken broth and Dijon mustard; bring to a simmer for 3 to 4 minutes. Stir in heavy cream and whisk until sauce begins to simmer. Whisk in Swiss cheese until completely melted. Return meatballs to skillet and simmer until sauce has slightly thickened, 3 to 4 minutes. Season with cracked black pepper and parsley. Serve immediately. Sauce will further thicken upon cooling."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

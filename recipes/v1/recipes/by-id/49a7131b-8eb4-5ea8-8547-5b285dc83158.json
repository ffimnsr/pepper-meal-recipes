  "id": "49a7131b-8eb4-5ea8-8547-5b285dc83158",
  "slug": "english-lemon-curd",
  "name": "English Lemon Curd",
  "recipe_type": "dessert",
  "brief_description": "Homemade lemon curd is quick and easy to make using 5 simple ingredients, creating a tangy and sweet topping for scones or croissants.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Combine lemon juice, eggs, butter, sugar, and lemon zest in a 2-quart saucepan; cook over medium-low heat, stirring constantly, until curd is thick and just beginning to boil, about 8 minutes."
    },
    {
      "position": 2,
      "text": "Remove curd from heat and cool to room temperature, stirring occasionally to keep the surface soft, about 30 minutes. Pour curd into clean jars, seal, and store in the refrigerator."
    }
  ],

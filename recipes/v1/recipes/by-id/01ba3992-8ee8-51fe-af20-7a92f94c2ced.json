  "slug": "one-bite-snack-balls-no-bake",
  "name": "One-Bite Snack Balls (No-Bake)",
  "recipe_type": "appetizer",
  "brief_description": "Sweet dates, raisins, and honey flavor these tasty bite-sized snack balls that are perfect to pack for kids' lunches or snacks and take just minutes to prepare.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats and carrots in the bowl of a food processor; pulse until blended. Add dates, brown sugar, cinnamon, and vanilla; blend again."
    },
    {
      "position": 2,
      "text": "Transfer mixture to a bowl and stir in raisins and honey. Roll into 8 balls."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

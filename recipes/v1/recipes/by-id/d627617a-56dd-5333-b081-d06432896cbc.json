  "id": "d627617a-56dd-5333-b081-d06432896cbc",
  "slug": "english-quiche-lorraine",
  "name": "English Quiche Lorraine",
  "recipe_type": "breakfast",
  "brief_description": "This English quiche Lorraine recipe uses puff pastry instead of a traditional crust. The bacon, cheese, and tomato make it a savory breakfast dish.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Press puff pastry into the bottom and up the sides of a shallow casserole dish or 8-inch pie plate."
    },
    {
      "position": 3,
      "text": "Beat milk and eggs together in a bowl until blended; season with salt and black pepper. Sprinkle a thin layer of Swiss cheese on bottom of crust; sprinkle crumbled bacon over cheese. Pour egg mixture into crust; sprinkle with remaining Swiss cheese. Arrange tomato slices on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C). Continue baking until crust is brown, about 30 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

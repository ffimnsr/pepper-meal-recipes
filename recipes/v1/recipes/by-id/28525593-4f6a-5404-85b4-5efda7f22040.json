  "id": "28525593-4f6a-5404-85b4-5efda7f22040",
  "slug": "creamy-tuscan-chicken-with-orzo-recipe-11937715",
  "name": "Creamy Tuscan Chicken with Orzo",
  "recipe_type": "main",
  "brief_description": "Try this creamy Tuscan chicken with orzo for the ultimate comfort meal. Chicken breasts are simmered in a rich and creamy Parmesan cheese sauce with sun-dried tomatoes, spinach, and garlic and served with orzo.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook orzo in the boiling water, stirring occasionally until tender yet firm to the bite, about 11 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large skillet over medium-high heat. Cook chicken until browned and no longer pink in the center, 3 to 5 minutes per side. Remove and set aside."
    },
    {
      "position": 3,
      "text": "Add heavy cream, chicken broth, garlic powder, Italian seasoning, salt, and pepper to the same skillet. Whisk sauce over medium-high heat until starting to thicken, about 5 minutes. Return chicken to the skillet and cook for 2 minutes. Add spinach, sun-dried tomatoes, and Parmesan cheese; simmer until spinach starts to wilt, about 1 minute."
    },
    {
      "position": 4,
      "text": "Stir in cooked orzo, and cook for 1 minute. Remove from heat, and let stand until thickened, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

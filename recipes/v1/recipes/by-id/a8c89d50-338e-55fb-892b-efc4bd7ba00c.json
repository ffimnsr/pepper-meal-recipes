  "id": "a8c89d50-338e-55fb-892b-efc4bd7ba00c",
  "slug": "potato-lasagna",
  "name": "Potato Lasagna",
  "recipe_type": "main",
  "brief_description": "This lasagna is made using potatoes in place of noodles. The perfect mix of fresh veggies, cheese and tomato sauce!",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 2 quart casserole dish."
    },
    {
      "position": 2,
      "text": "In a medium bowl, toss together the carrots, bell pepper, onion, garlic, and spinach. In a separate bowl, blend together the Gouda cheese, mozzarella cheese, and sharp Cheddar cheese. Set aside."
    },
    {
      "position": 3,
      "text": "Place two layers of sliced potatoes in the bottom of the prepared casserole dish. Season the potatoes with a little salt and pepper. Top with a layer of the spinach mixture, and pour about 1/2 cup of sauce over all. Sprinkle with some of the cheese blend. Repeat layering with remaining potatoes, vegetables, sauce and cheese, ending with cheese on the top."
    },
    {
      "position": 4,
      "text": "Bake covered for 35 minutes in the preheated oven. Remove the lid, and bake for 10 more minutes until the top is browned."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

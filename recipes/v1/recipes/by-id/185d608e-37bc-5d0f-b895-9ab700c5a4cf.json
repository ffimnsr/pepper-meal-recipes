  "id": "185d608e-37bc-5d0f-b895-9ab700c5a4cf",
  "slug": "caprese-salad-with-grilled-flank-steak",
  "name": "Caprese Salad with Grilled Flank Steak",
  "recipe_type": "salad",
  "brief_description": "Grilled, marinated flank steak tops a Caprese salad for delicious main course meal that's perfect for summer.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix tomatoes, mozzarella, basil, 1 clove minced garlic, and 1 tablespoon olive oil in a bowl; toss to coat. Cover bowl and refrigerate."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Place steak in a large resealable bag; add 1 clove minced garlic, 1 tablespoon olive oil, salt, and pepper. Seal the bag and distribute the oil mixture over the steak."
    },
    {
      "position": 4,
      "text": "When the grill is preheated, cook steak to your desired degree of doneness, about 5 minutes per side for medium. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C). Let stand for 5 minutes before thinly slicing across the grain."
    },
    {
      "position": 5,
      "text": "Divide lettuce onto 4 serving plates. Drizzle 1 \u00bd teaspoons each of balsamic vinegar and olive oil onto each lettuce portion. Divide steak and tomato mixture evenly between the salads."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

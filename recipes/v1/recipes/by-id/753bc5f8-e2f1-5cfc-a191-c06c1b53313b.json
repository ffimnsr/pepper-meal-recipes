  "id": "753bc5f8-e2f1-5cfc-a191-c06c1b53313b",
  "slug": "tater-tot-breakfast-casserole-recipe-11915346",
  "name": "Tater Tot Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This hearty tater tot breakfast casserole layers both bacon and sausage with cheese and green onions over frozen tater tots. baked in an egg and cheese custard to envelop it all.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Add tater tots to the bottom of a deep 9x13-inch baking dish and top evenly with sausage, bacon, and cheese."
    },
    {
      "position": 3,
      "text": "Reserve 3 tablespoons green onions, and sprinkle remaining onions over cheese."
    },
    {
      "position": 4,
      "text": "Combine eggs, milk, hot sauce, salt, and pepper in a food processor and mix until well blended, about 10 seconds. Pour egg mixture over tater tot mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set and browned around the edges, about 50 minutes; cover during the last 20 minutes loosely with foil if too much browning occurs before casserole sets. Let stand for 10 minutes before serving and serve topped with reserved green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,

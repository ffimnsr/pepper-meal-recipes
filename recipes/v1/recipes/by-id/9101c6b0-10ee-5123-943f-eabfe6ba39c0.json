  "id": "9101c6b0-10ee-5123-943f-eabfe6ba39c0",
  "slug": "mexican-chocolate-cake",
  "name": "Mexican Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This is a moist chocolate cake with a hint of cinnamon. This recipe will make a large one layer cake or a two layer quarter sheet cake.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 12x18 inch pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together the flour, cocoa, sugar, baking soda and cinnamon. Add the margarine, oil, water, sour milk, eggs and vanilla, mix until smooth. Spread evenly into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the cake comes out clean. Allow to cool."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

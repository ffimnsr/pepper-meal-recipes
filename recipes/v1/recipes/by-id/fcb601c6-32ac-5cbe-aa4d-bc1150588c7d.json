  "id": "fcb601c6-32ac-5cbe-aa4d-bc1150588c7d",
  "slug": "brown-sugar-meatloaf",
  "name": "Brown Sugar Meatloaf",
  "recipe_type": "main",
  "brief_description": "This brown sugar meatloaf is glazed with brown sugar and ketchup for a moist and flavorful weeknight dinner that is as easy as it is delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 5x9-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Press brown sugar into the bottom of the prepared loaf pan and spread ketchup over top sugar."
    },
    {
      "position": 3,
      "text": "Mix all remaining ingredients thoroughly in a mixing bowl and shape into a loaf."
    },
    {
      "position": 4,
      "text": "Place on top of the ketchup and sugar crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour or until juices are clear."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "e7db86d1-5565-5213-bdfe-089a3cd2c837",
  "slug": "cajun-potato-soup-recipe-11899984",
  "name": "Cajun Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This Cajun potato soup, with andouille, crawfish, bell pepper, celery, and onion, is partially blended for a creamy texture. Heavy cream makes it rich; Cajun seasoning spices it up.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a Dutch oven over medium heat, and add andouille sausage. Cook until browned, 1 to 2 minutes on each side. Remove from the pan and set aside."
    },
    {
      "position": 2,
      "text": "Add onions, green bell pepper, red bell pepper, celery, and garlic to the Dutch oven. Sprinkle with half the Cajun seasoning; stir, and allow to cook for 3 minutes."
    },
    {
      "position": 3,
      "text": "Add chicken broth and potatoes, stir and bring to a boil; reduce heat and simmer until potatoes begin to soften, about 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Carefully take 3 cups of the potato mixture from the Dutch oven, and put into a food processor. Process until smooth; add up to 1/2 cup broth as needed. Pour back into the Dutch oven and stir."
    },
    {
      "position": 5,
      "text": "Add andouille sausage, crawfish tails, heavy cream, and remaining Cajun seasoning. Stir to combine well, turn heat to low, cover, and allow flavors to blend for 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

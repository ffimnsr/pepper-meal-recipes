  "id": "21eece18-749f-575b-85fe-d896317c1461",
  "slug": "korean-fried-chicken",
  "name": "Korean Fried Chicken",
  "recipe_type": "main",
  "brief_description": "This Korean fried chicken recipe from Chef John's makes the crispiest, crunchiest, and most delicious batter-coated, marinated boneless chicken thighs.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make marinade: Stir together chicken, onion, garlic, salt, and pepper in a medium bowl until chicken is coated. Cover the bowl with plastic wrap and refrigerate, 4 hours to overnight."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep fryer or large saucepan to 340 degrees F (171 degrees C)."
    },
    {
      "position": 4,
      "text": "While oil is heating, make the batter: Whisk cornstarch, flour, sugar, pepper, and salt together in a large bowl. Gradually whisk in cold water until mixture resembles a smooth batter. Use tongs to remove chicken from marinade to batter; stir to coat chicken completely. Discard marinade."
    },
    {
      "position": 5,
      "text": "Working in batches, fry chicken in hot oil for 4 minutes. Transfer chicken to a cooling rack."
    },
    {
      "position": 6,
      "text": "Increase oil temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Working in batches, fry chicken again in hot oil until golden brown and crispy, 3 to 4 minutes. Transfer to a wire rack to drain."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

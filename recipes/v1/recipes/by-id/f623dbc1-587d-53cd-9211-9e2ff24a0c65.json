  "id": "f623dbc1-587d-53cd-9211-9e2ff24a0c65",
  "slug": "cheesy-vegetable-soup-ii",
  "name": "Cheesy Vegetable Soup II",
  "recipe_type": "soup",
  "brief_description": "Canned condensed cheese soup and cheddar or Colby cheeses are used in this soup with carrots, mushrooms, corn, peas and broccoli florets.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet over medium high heat, combine the olive oil, garlic to taste, onions and mushrooms. Saute for about 5 minutes, or until the onions are tender. Remove from heat and reserve for later."
    },
    {
      "position": 2,
      "text": "In a large pot over high heat, combine the potatoes and carrots and add water to cover. Bring to a boil and reduce heat to low. Cover and simmer until vegetables are tender. Drain the water and add the milk. Continue to cook over low heat until milk starts to simmer."
    },
    {
      "position": 3,
      "text": "Stir in the cheese soup, then stir in the flour slowly, until mixed. Add 1 1/2 cups of the cheese, the reserved mushroom mixture, peas, corn and broccoli and heat through. Garnish with remaining 1/2 cup of cheese."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

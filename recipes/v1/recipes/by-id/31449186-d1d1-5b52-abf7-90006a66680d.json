  "id": "31449186-d1d1-5b52-abf7-90006a66680d",
  "slug": "instant-pot-butternut-squash-soup-with-coconut-milk",
  "name": "Instant Pot\u00ae Butternut Squash Soup with Coconut Milk",
  "recipe_type": "soup",
  "brief_description": "This Instant Pot\u00ae butternut squash soup is cooked with coconut milk. Garnish with unsweetened coconut flakes, salted peanuts, Parmesan cheese, or any other topping you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine butternut squash, water, turmeric, and ginger in a multi-functional pressure cooker (such as Instant Pot\u00ae). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 8 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Pour in coconut milk. Using an immersion blender, blend soup until smooth."
    },
    {
      "position": 3,
      "text": "Select Saute function. Gradually add chicken stock until desired consistency is reached. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

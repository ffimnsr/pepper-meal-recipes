  "id": "ef1df879-cd07-52a2-80c9-0f12fc15dfb7",
  "slug": "kombucha-margarita",
  "name": "Kombucha Margarita",
  "recipe_type": "drink",
  "brief_description": "This fizzy and tart margarita uses kombucha for a modern twist!",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker half-full with ice. Add tequila, triple sec, and lime juice to the shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds."
    },
    {
      "position": 2,
      "text": "Sprinkle salt onto a plate. Moisten the rim of a glass with the lime wedge. Press the moistened rim into the salt. Fill glass with ice."
    },
    {
      "position": 3,
      "text": "Strain margarita into the glass and top with kombucha. Stir gently and garnish with lime wedge, if desired."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

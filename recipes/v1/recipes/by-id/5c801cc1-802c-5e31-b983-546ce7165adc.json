  "id": "5c801cc1-802c-5e31-b983-546ce7165adc",
  "slug": "bug-lady-tofu-pate",
  "name": "Bug Lady Tofu Pate",
  "recipe_type": "appetizer",
  "brief_description": "Tofu, peppers and spices are blended into a smooth, delicious vegetarian spread for bread, crackers or veggies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Wrap soft tofu in cheese cloth. Place over a medium bowl, and press to drain as much liquid as possible."
    },
    {
      "position": 2,
      "text": "Place tofu in a medium bowl. Mix in mayonnaise, garlic powder, white pepper, mustard, seasoning salt, nutritional yeast, paprika, orange bell pepper, red chile pepper, celery, parsley, cilantro, dill weed and garlic. Blend until smooth. Cover and chill in the refrigerator until serving."
    }
  ],

  "id": "9b707892-56ca-5aa7-8d8d-34738f3b2eed",
  "slug": "tomato-spinach-and-bean-burrito",
  "name": "Tomato Spinach and Bean Burrito",
  "recipe_type": "main",
  "brief_description": "Tomato, chopped spinach & kidney bean mixture wrapped in a 10 inch tortilla.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet on medium-high heat. Saute onion and garlic for 5 minutes. Stir in chili powder and cumin, and cook 1 minute. Stir in water, tomato, kidney beans and salt. Bring to a boil, then reduce heat and simmer for 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir in spinach and cook 5 minutes more. Spoon 1/4 of the bean mixture into the middle of a warm tortilla. Wrap and garnish with avocado, sour cream and salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

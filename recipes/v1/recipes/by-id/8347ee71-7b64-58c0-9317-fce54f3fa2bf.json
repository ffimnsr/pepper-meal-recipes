  "id": "8347ee71-7b64-58c0-9317-fce54f3fa2bf",
  "slug": "jerky-lovers-jerky-sweet-hot-and-spicy",
  "name": "Jerky Lover's Jerky - Sweet, Hot and Spicy!",
  "recipe_type": "appetizer",
  "brief_description": "This will be your favorite sweet and spicy beef jerky recipe for on-the-go snacks, sporting events, camping, or hiking. Enjoy the balance of flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix together onion powder, garlic powder, and black pepper in a small bowl or cup. Season beef lightly, using only part of the spice blend and reserving the rest. Place beef into an airtight plastic container or bowl, and refrigerate."
    },
    {
      "position": 3,
      "text": "Stir together brown sugar, soy sauce, pineapple juice, balsamic vinegar, teriyaki sauce, Worcestershire sauce, and liquid smoke flavoring. Heat until brown sugar has completely dissolved. Refrigerate marinade until cool."
    },
    {
      "position": 4,
      "text": "Pour cooled marinade over the seasoned meat, and mix by hand to coat. Seal the bowl, and refrigerate for at least 3 hours."
    },
    {
      "position": 5,
      "text": "Arrange beef strips on the rack of a dehydrator, and sprinkle with a little bit more of the spice mixture and red pepper flakes. Dry for 5 hours, or to your desired dryness."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "fe96f9ba-fb3f-5da5-8e7c-a6b7c6b18bcb",
  "slug": "almost-no-fat-banana-bread",
  "name": "Almost No Fat Banana Bread",
  "recipe_type": "appetizer",
  "brief_description": "This banana bread with applesauce and egg whites is low in fat yet still deliciously tender and moist. Cinnamon adds a subtle spiced flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Stir flour, sugar, baking powder, baking soda, and cinnamon together in a large bowl. Add banana, applesauce, and egg whites; stir just until combined. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, 50 to 55 minutes. Turn out onto a wire rack and allow to cool before slicing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

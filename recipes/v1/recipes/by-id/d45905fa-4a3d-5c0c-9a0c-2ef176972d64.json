  "id": "d45905fa-4a3d-5c0c-9a0c-2ef176972d64",
  "slug": "kabobs",
  "name": "Kabobs",
  "recipe_type": "main",
  "brief_description": "Grilled kabobs made with cubes of steak, chicken, bell peppers, onions, and mushrooms in a honey teriyaki sauce are easy to make and delicious to eat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix teriyaki sauce, honey, garlic powder, and ginger in a large resealable plastic bag. Place chicken, beef, red bell peppers, onion wedges, and mushrooms in the bag; coat with marinade, squeeze out excess air, and seal the bag. Refrigerate for 4 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the grill to medium-high heat. Lightly oil the grill grate. Thread meat and vegetables onto skewers, leaving a small space between each item. Discard any remaining marinade."
    },
    {
      "position": 4,
      "text": "Grill skewers, turning as needed, until meat is cooked through and vegetables are tender, about 10 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

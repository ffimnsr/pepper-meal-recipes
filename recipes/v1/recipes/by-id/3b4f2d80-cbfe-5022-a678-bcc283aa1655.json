  "id": "3b4f2d80-cbfe-5022-a678-bcc283aa1655",
  "slug": "old-fashioned-peanut-butter-cookies",
  "name": "Old Fashioned Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This recipe for old-fashioned peanut butter cookies packs in twice the peanut butter and adds peanut butter chips!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 large baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix flour, baking powder and salt in a medium bowl."
    },
    {
      "position": 3,
      "text": "In a large bowl, beat butter, peanut butter, and vanilla with an electric mixer until well blended. Beat in both sugars. Scrape down the sides of the bowl. Stir in half of the dry ingredients into the mixture. Add eggs one at a time, blending well after each addition. Mix in remaining ingredients. Stir in peanut butter chips."
    },
    {
      "position": 4,
      "text": "For each cookie, roll 1 heaping tablespoon full of dough into 1 3/4 inch diameter ball. Arrange balls 2 1/2 inches apart on prepared baking sheets. Using the back of fork, flatten dough balls and form a crosshatch on tops."
    },
    {
      "position": 5,
      "text": "Bake cookies until dry on top, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Cool cookies on baking sheets for 5 minutes. Using a spatula, transfer cookies to cooling racks to cool completely."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

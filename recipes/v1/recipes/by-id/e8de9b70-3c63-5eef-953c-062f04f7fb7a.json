  "id": "e8de9b70-3c63-5eef-953c-062f04f7fb7a",
  "slug": "slow-cooker-baked-beans",
  "name": "Slow Cooker Baked Beans",
  "recipe_type": "side",
  "brief_description": "These beans have that classic baked bean flavor and are cooked conveniently in a slow cooker. Yummy!",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "The night before, combine the Great Northern Beans and water in a large saucepan. Bring to a boil, and cook for 1 1/2 hours. Pour beans and their liquid into a bowl, cover and refrigerate overnight."
    },
    {
      "position": 2,
      "text": "In the morning, drain off liquid, reserving 1 cup. Pour beans and the reserved liquid into the crock of a slow cooker. Stir in the salt pork, onion, molasses, brown sugar, mustard and pepper. Cover, and cook on Low for 12 to 14 hours. Stir before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 840,

  "id": "fecaf471-518f-56d0-b0a1-c447162e7c91",
  "slug": "orange-glazed-carrots",
  "name": "Orange-Glazed Carrots",
  "recipe_type": "side",
  "brief_description": "These mini orange-glazed carrots are easy to make with just five ingredients. They're perfect to serve at special occasions or weeknight dinners.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place carrots in a shallow saucepan and cover with water; bring to a boil. Continue to boil until tender, 4 to 8 minutes. Drain and return to the pan."
    },
    {
      "position": 2,
      "text": "Pour orange juice over carrots and mix well. Simmer over medium heat for 3 to 5 minutes. Stir in brown sugar, butter, and salt; cook until sugar and butter melt."
    }
  ],
  "servings": 4,

  "id": "794fca04-39f3-5f88-b25c-43c988c21176",
  "slug": "chilean-alfajores",
  "name": "Chilean Alfajores",
  "recipe_type": "dessert",
  "brief_description": "Sweet butter cookies are sandwiched together with caramelized condensed milk in this easy, 5-ingredient recipe for Chilean alfajores cookies.",
  "cuisine": "Chilean",
  "instructions": [
    {
      "position": 1,
      "text": "Place the entire, unopened can of condensed milk in a large saucepan. Fill the saucepan with water and bring to a boil. Lower heat to a simmer and cook until milk inside has caramelized, about 2 hours."
    },
    {
      "position": 2,
      "text": "Remove from the heat and set aside to cool while you make the cookies."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "Beat butter and sugar together in a bowl with an electric mixer until creamy. Mix in egg, then mix in flour until well combined."
    },
    {
      "position": 5,
      "text": "Drop batter by small teaspoonfuls onto an ungreased cookie sheet. Dip your finger into flour, and pat each cookie into a very thin, little circle (about the size of a quarter)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until just starting to brown around the edges and no longer doughy in the centers, 10 to 12 minutes. Cool on the cookie sheet for 1 minute before removing to a wire rack to cool, 8 to 10 minutes more."
    },
    {
      "position": 7,
      "text": "Sandwich cooled cookies together with the caramelized condensed milk."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1fc101b5-4b4f-5836-8814-b4c75d1b1d39",
  "slug": "fish-and-chips-recipe-8606787",
  "name": "\u201cFish\u201d and Chips",
  "recipe_type": "main",
  "brief_description": "This \"fish\" and chips, a vegetarian version of a pub favorite, uses a combo of shredded jackfruit and nori. The texture of jackfruit resembles flaky fish, and the nori provides fresh-from-the-water flavor.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "For \u201cfish,\u201d process jackfruit, panko, nori, mayonnaise, mustard, 1 teaspoon seafood seasoning, and salt in a food processor until combined, with some chunks of jackfruit remaining. Mixture should hold together when pressed."
    },
    {
      "position": 2,
      "text": "Shape jackfruit mixture into 1/3-cup fllet-like portions (about 3-1/2x1-1/2 inches). Cover and chill for 1 hour."
    },
    {
      "position": 3,
      "text": "Pour oil to a depth of 2 inches in a deep, heavy-bottomed 4-quart pot or deep fryer. Heat oil to 375 degrees F (190 degrees C). Meanwhile, prepare fries according to package directions; keep warm."
    },
    {
      "position": 4,
      "text": "For batter, whisk together flour, onion powder, garlic powder, paprika, and remaining 1 teaspoon seafood seasoning in a medium bowl. Whisk in beer and egg. Dip jackfruit portions into batter, turning to coat all sides."
    },
    {
      "position": 5,
      "text": "Working in batches, fry 2 or 3 portions at a time in hot oil, turning once, until golden brown, 3 to 4 minutes. Drain on a paper towel-lined plate; keep warm. Garnish with parsley and serve with tartar sauce, lemon wedges, and steak fries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

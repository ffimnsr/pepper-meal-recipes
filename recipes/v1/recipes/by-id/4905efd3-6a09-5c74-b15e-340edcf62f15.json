  "id": "4905efd3-6a09-5c74-b15e-340edcf62f15",
  "slug": "crockpot-cajun-white-chicken-chili-recipe-11895096",
  "name": "Crockpot Cajun White Chicken Chili",
  "recipe_type": "soup",
  "brief_description": "This crockpot Cajun white chicken chili is an easy, hands-off meal that delivers bold flavor without being heavy or spicy. It\u2019s rich, creamy, and comforting, with tender shredded chicken simmered in a lightly spiced broth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine diced onion, bell pepper, celery, and garlic in a crockpot."
    },
    {
      "position": 2,
      "text": "Sprinkle Cajun seasoning, thyme, smoked paprika, cayenne, white pepper over vegetable mixture. Pour in bone broth, coconut milk, and cannellini beans."
    },
    {
      "position": 3,
      "text": "Place chicken breasts on top."
    },
    {
      "position": 4,
      "text": "Cover the crockpot with a lid and cook on High for 4 1/2 hours. Remove chicken and shred. Return shredded chicken to the crockpot; stir together. Adjust seasoning to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

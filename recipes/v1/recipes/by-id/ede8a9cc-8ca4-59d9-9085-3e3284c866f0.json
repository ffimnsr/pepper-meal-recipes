  "id": "ede8a9cc-8ca4-59d9-9085-3e3284c866f0",
  "slug": "hawaiian-bruddah-potato-mac-macaroni-salad",
  "name": "Hawaiian Bruddah Potato Mac (Macaroni) Salad",
  "recipe_type": "salad",
  "brief_description": "Hawaiian bruddah potato mac (macaroni) salad recipe is a favorite local Hawaiian side dish, which includes vinegar, mayonnaise, carrots, and sweet onion.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender but still firm, about 15 minutes. Drain; refrigerate to cool."
    },
    {
      "position": 2,
      "text": "Meanwhile, place eggs in a saucepan in a single layer and cover with water by 1 inch; cover saucepan. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel. Chop cooled eggs; set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain in a colander set in the sink; rinse with cold water."
    },
    {
      "position": 4,
      "text": "Whisk mayonnaise, vinegar, curry powder, celery seeds, salt, and black pepper together in a medium bowl until smooth; set aside."
    },
    {
      "position": 5,
      "text": "Combine cooled potatoes, chopped eggs, macaroni, carrots, onion, and peas in a large bowl. Carefully stir in dressing; cover and refrigerate 8 hours to overnight."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

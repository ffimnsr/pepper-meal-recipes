  "id": "49349d06-af6b-50eb-99f2-0d3d06c7571f",
  "slug": "moms-irish-soda-bread",
  "name": "Mom's Irish Soda Bread",
  "recipe_type": "main",
  "brief_description": "This easy Irish soda bread recipe with golden raisins gets its rise from baking powder, baking soda, and buttermilk.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Spoon 1 tablespoon buttermilk into a small bowl; pour remaining buttermilk into a medium bowl."
    },
    {
      "position": 3,
      "text": "Stir 1 tablespoon melted butter into buttermilk in the small bowl until combined. Stir golden raisins into buttermilk in the medium bowl. Let both bowls sit until needed."
    },
    {
      "position": 4,
      "text": "Whisk together flour, sugar, baking powder, baking soda, and salt in a large bowl. Make a well in the center and pour in remaining melted butter; stir until mixture resembles coarse crumbs. Add egg and mix until thoroughly combined."
    },
    {
      "position": 5,
      "text": "Add buttermilk-raisin mixture to flour mixture; shape into a ball. Transfer dough to the prepared pie dish and lightly pat around the edges so the top is slightly domed. Slice the top in a 1/4-inch deep crisscross with a sharp knife. Brush buttermilk-butter mixture over loaf until thoroughly coated, getting mixture into all crevices."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until loaf is golden brown and a toothpick inserted into the center comes out clean, 55 minutes to 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

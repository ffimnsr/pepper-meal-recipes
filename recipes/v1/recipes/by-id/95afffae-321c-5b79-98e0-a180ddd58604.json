  "id": "95afffae-321c-5b79-98e0-a180ddd58604",
  "slug": "lavash-pizza-recipe-11681521",
  "name": "Lavash Pizza",
  "recipe_type": "appetizer",
  "brief_description": "Lavash pizza is a quick and easy appetizer. Top lavash flat bread with pizza sauce, mozzarella, and pepperoni for the perfect thin-crust pizza.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray one side of lavash with nonstick spray."
    },
    {
      "position": 2,
      "text": "Bake lavash directly on the rack in the preheated oven for 2 minutes."
    },
    {
      "position": 3,
      "text": "Carefully remove lavash from oven; place on a baking tray. Spread 2 to 3 tablespoons pizza sauce on each lavash."
    },
    {
      "position": 4,
      "text": "Sprinkle 2 ounces shredded mozzarella cheese on each lavash. Top with pepperoni."
    },
    {
      "position": 5,
      "text": "Bake pizza until cheese is melted and golden, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

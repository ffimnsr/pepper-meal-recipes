  "id": "68ded8c9-5ed3-51a5-bac2-8c7c5ba87a87",
  "slug": "blue-cheese-chicken-wing-dip",
  "name": "Blue Cheese Chicken Wing Dip",
  "recipe_type": "appetizer",
  "brief_description": "This is an absolutely addicting wing dip recipe. I have had countless requests for the recipe. The whole is greater than the sum of the its parts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken in a pot with enough water to cover. Bring to a boil and cook 25 minutes, until chicken juices run clear. Drain liquid from pot and shred chicken. Mix wing sauce and butter into pot. Bring to a boil, reduce heat to low and simmer 10 minutes."
    },
    {
      "position": 3,
      "text": "Spread cream cheese over the bottom of an 8x8 inch baking dish. Pour chicken mixture over cream cheese. Top with dressing."
    },
    {
      "position": 4,
      "text": "Bake 15 minutes in the preheated oven, until hot and bubbly."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

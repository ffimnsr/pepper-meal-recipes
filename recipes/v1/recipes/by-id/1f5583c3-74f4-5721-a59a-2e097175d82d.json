  "id": "1f5583c3-74f4-5721-a59a-2e097175d82d",
  "slug": "classic-chocolate-tart",
  "name": "Chocolate Tart",
  "recipe_type": "dessert",
  "brief_description": "This glossy chocolate tart has a homemade buttery crust with a rich and silky chocolate ganache filling for a simple yet impressive chocolate dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, sugar, and salt in a food processor; pulse to combine. Add cold butter and pulse until crumbly. Slowly add water to food processor until dough comes together. Wrap dough and refrigerate for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease an 8-inch tart pan."
    },
    {
      "position": 3,
      "text": "Flour a work surface and a rolling pin; roll out dough into a 10-inch disc."
    },
    {
      "position": 4,
      "text": "Carefully place dough into the prepared tart pan. Trim dough from the edges of the pan. Prick holes in the dough on the bottom and along the sides of the pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned, 20 to 23 minutes. Remove from oven and allow to cool completely, about 1 hour."
    },
    {
      "position": 6,
      "text": "Pour heavy whipping cream into a microwave-safe bowl. Microwave for 2 minutes or until bubbles start to form along outside of the bowl. Add chocolate chips and let sit for 15 to 20 seconds. Whisk until smooth. Pour chocolate ganache into cooled crust. Let cool at room temperature until set, about 30 minutes. Keep refrigerated until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

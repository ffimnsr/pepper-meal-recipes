  "id": "1b0bf03d-66ad-56ef-bdc8-b54fd8260470",
  "slug": "cedar-plank-salmon",
  "name": "Cedar Plank Salmon",
  "recipe_type": "dessert",
  "brief_description": "This oven-baked cedar plank salmon topped with a sweet and nutty brown sugar and sesame glaze can be served at your table in under 45 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, sesame oil, sesame seeds, and dill in a small bowl. Mix in water, a little at a time, adding just enough to make the mixture liquid. Stir in soy sauce and pepper."
    },
    {
      "position": 3,
      "text": "Place salmon fillets, skin-side down, onto the soaked cedar plank. Spoon sugar mixture evenly over fillets to fully coat."
    },
    {
      "position": 4,
      "text": "Place cedar plank directly on a rack in the preheated oven; bake until fish flakes easily with a fork, 30 to 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

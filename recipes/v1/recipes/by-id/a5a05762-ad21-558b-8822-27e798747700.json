  "slug": "healthier-pie-crust",
  "name": "Healthier Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "This delicious and healthier pie crust recipe has oats and coconut, tastes great with a cherry filling, and will be a hit each time you serve it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together oats, flour, and coconut. Stir in oil and water. Press dough into a 9-inch pie pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 12 minutes, until lightly browned."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

  "id": "a6e0bf3d-a275-5457-be5e-01e8dfb72211",
  "slug": "easy-peach-cobbler-with-canned-peaches",
  "name": "Easy Peach Cobbler with Canned Peaches",
  "recipe_type": "dessert",
  "brief_description": "This easy peach cobbler with canned peaches is ready in under 1 hour for dessert any night of the week or when unexpected company shows up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour peaches and as much juice as you prefer into a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, and butter in a bowl; mix and knead with hands until crumbly."
    },
    {
      "position": 4,
      "text": "Sprinkle mixture over peaches, then scatter pecans over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until topping is golden brown and peaches are bubbly, 45 minutes to 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "9a7371fe-dcc3-5e70-8d59-c8808b27690e",
  "slug": "authentic-chicken-empanadas-empanadas-de-pollo",
  "name": "Authentic Chicken Empanadas (Empanadas de Pollo)",
  "recipe_type": "appetizer",
  "brief_description": "These chicken empanadas, filled with bell pepper, onion, cilantro, and green olives, are inspired by authentic \u201cempanadas de pollo\u201d found in roadside stands in Puerto Rico.",
  "cuisine": "Puerto Rican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, salt, baking powder, and baking soda together in a large bowl. Add water and 1/4 cup vegetable oil; mix with an electric mixer until well combined and a dough begins to form, about 3 minutes. Remove dough and knead on a lightly floured surface for about 3 minutes. Wrap in plastic wrap and set aside for 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat 2 tablespoons oil in a large skillet over medium-high heat. Add shredded chicken and saute until heated through, about 2 minutes. Add onion, bell pepper, cilantro, olives, garlic, sazon seasoning, tomato paste, salt, and pepper and cook, stirring occasionally, until vegetables have softened, about 10 minutes. Remove from heat and let cool."
    },
    {
      "position": 3,
      "text": "Divide empanada dough into 12 pieces and form each one into a 4-inch circle. Place about 2 tablespoons filling in the center of each circle, fold in half, and press down on the edges with a fork to seal."
    },
    {
      "position": 4,
      "text": "Heat 1 cup oil in a frying pan over medium heat. Add empanadas, working in batches, and fry until golden brown, about 5 minutes per side. Transfer to a paper towel-lined plate."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

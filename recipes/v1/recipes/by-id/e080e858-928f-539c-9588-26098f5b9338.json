  "id": "e080e858-928f-539c-9588-26098f5b9338",
  "slug": "mediterranean-lamb-burgers",
  "name": "Mediterranean Lamb Burgers",
  "recipe_type": "dessert",
  "brief_description": "Ground lamb and beef burgers are juicy and delicious. Grill and serve with green tomato, sweet onion, feta cheese, and an easy-to-make tzatziki sauce.",
  "cuisine": "Mediterranean Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Make the patties: Mix ground lamb, ground beef, mint, ginger, garlic, salt, and pepper in a large bowl until just combined. Divide evenly into four portions and shape into large patties. Set aside."
    },
    {
      "position": 3,
      "text": "Make the sauce: Mix Greek yogurt, lemon zest, garlic, and salt in a bowl; cover and refrigerate."
    },
    {
      "position": 4,
      "text": "Cook burger patties on the preheated grill until cooked to your desired degree of doneness, 3 to 4 minutes per side for well done. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    },
    {
      "position": 5,
      "text": "While burgers are cooking, get ready to assemble: Place slices of onion and green tomato on the grill. Cook until lightly charred, about 1 minute on each side."
    },
    {
      "position": 6,
      "text": "Spread yogurt sauce over sliced ciabatta rolls. Continue assembly by placing each burger patty on a roll. Divide feta cheese slices over the patties. Top each with a slice of grilled tomato, grilled onion, and 2 leaves of arugula, followed by the top half of the roll."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

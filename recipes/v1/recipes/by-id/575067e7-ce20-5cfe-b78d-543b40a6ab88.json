  "id": "575067e7-ce20-5cfe-b78d-543b40a6ab88",
  "slug": "chicken-jambalaya-i",
  "name": "Chicken Jambalaya",
  "recipe_type": "soup",
  "brief_description": "This chicken jambalaya recipe is packed with vegetables and a zippy tomato broth. It's a spicy chicken-and-rice dish with a potent change of pace.",
  "cuisine": "Southern American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium-low heat. Add celery, onion, and green bell pepper; saut\u00e9 until tender. Stir in tomatoes, broth, rice, thyme or basil, garlic salt, ground black pepper, hot pepper sauce, and bay leaf."
    },
    {
      "position": 2,
      "text": "Bring all to a boil; reduce heat, cover skillet and simmer for about 20 minutes or until rice is tender. Stir in cooked chicken and cook until heated through. Discard bay leaf and serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

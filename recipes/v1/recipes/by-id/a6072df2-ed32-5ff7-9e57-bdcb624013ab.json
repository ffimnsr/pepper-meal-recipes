{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a6072df2-ed32-5ff7-9e57-bdcb624013ab",
  "slug": "fajita-cheeseburger-recipe-11701282",
  "name": "Fajita Cheeseburger",
  "recipe_type": "main",
  "brief_description": "Chef John describes his fajita cheeseburger as \"spicy, hot and juicy, and pretty much perfect.\" The spices and fajita vegetables go beautifully with the pan-fried burger and Monterey Jack cheese, and the gorgeous mayo-toasted bun is a signature touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir chili powder, paprika, cayenne, cumin, oregano, garlic powder, and onion powder together in a small bowl; set aside until needed."
    },
    {
      "position": 2,
      "text": "Shape ground beef into a burger as thick as you like, but preferably thinner to increase surface area, and season generously on both sides with salt and pepper. Refrigerate until needed."
    },
    {
      "position": 3,
      "text": "Melt butter with olive oil in a skillet over medium-high heat. Once butter begins to sizzle, transfer in the burger. Add jalapeno, tomato, and red onion around the burger and arrange so vegetables are all touching the pan. Season vegetables to taste with salt."
    },
    {
      "position": 4,
      "text": "Cook burger for about 3 minutes, then apply a very generous sprinkling of fajita spice mixture over burger and vegetables."
    },
    {
      "position": 5,
      "text": "Turn burger and vegetables once they begin to brown around the edges. Generously sprinkle fajita spice over burger and vegetables, and cook until burger is no longer pink in the center, about 4 minutes more. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). If vegetables finish cooking before burger, remove them to a plate and keep warm."
    },
    {
      "position": 6,
      "text": "Meanwhile, spread the bun inside and out with mayonnaise and toast in a dry pan over medium- high heat until golden brown on both sides, about 3 minutes."
    },
    {
      "position": 7,
      "text": "When the burger is almost done, top with a slice of cheese. Let cook for about 30 seconds. Pile fajita vegetables over cheese. Serve on toasted bun with a lime wedge."
    }
  ],
  "servings": 1,

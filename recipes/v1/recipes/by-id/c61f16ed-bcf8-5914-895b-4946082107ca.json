  "slug": "chia-seed-overnight-oats-recipe-11699507",
  "name": "Chia Seed Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These chia seed overnight oats are a fun fusion between chia pudding and overnight oats. Vanilla yogurt and almond butter make this a healthy protein-rich breakfast choice. Top with fruit, nuts, and granola of your choice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oat milk, oats, vanilla yogurt, chia seeds, and almond butter in a large container (or divide into several smaller containers) and stir until well combined. Wait for 3 minutes, then stir again."
    },
    {
      "position": 2,
      "text": "Cover and refrigerate for at least 1 hour, ideally overnight."
    },
    {
      "position": 3,
      "text": "When ready to eat add toppings of your choice, and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,

  "id": "6ab607eb-fe51-56b2-84b2-665ad26cfb92",
  "slug": "garys-turkey-burritos",
  "name": "Gary\u2019s Turkey Burritos",
  "recipe_type": "main",
  "brief_description": "Easy to make, these special low-fat burritos taste awesome! You don\u2019t eat red meat, but love burritos? Well, you can\u2019t taste the difference here. These are medium spicy, not fire hot!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Brown ground turkey in a large skillet over medium-high heat. Stir in tomato sauce, corn, and onion. Reduce heat to medium; simmer, stirring occasionally, until liquids reduce, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Heat beans in a separate medium skillet over medium-low heat."
    },
    {
      "position": 3,
      "text": "Heat tortillas over a gas stovetop burner for 1 to 2 minutes, flipping a few times."
    },
    {
      "position": 4,
      "text": "Fill tortillas with beans, turkey mixture, sour cream, and cheese; serve while still warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

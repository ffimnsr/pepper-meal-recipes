  "id": "9a10a357-e937-5bd5-a8de-6c0c0c6565d4",
  "slug": "homemade-granola-cereal",
  "name": "Homemade Granola Cereal",
  "recipe_type": "breakfast",
  "brief_description": "Learn how to make this delicious homemade granola cereal recipe that is easy to prepare and delicious to eat! A great way to start your morning!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix oats, flour, honey, wheat germ, cashews, almonds, vegetable oil, coconut, brown sugar, vanilla, and salt together in a large bowl; spread onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 15 minutes, stir, and increase heat to 325 degrees F (165 degrees C). Continue cooking until granola is golden brown, about 10 minutes more. Cool granola completely before storing in an airtight container."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "007c0877-44af-5b94-b2bf-0c19c69e09ff",
  "slug": "emergency-garlic-bread",
  "name": "Emergency Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This garlic bread recipe uses sliced hot dog buns brushed with butter and sprinkled with garlic powder for a quick and easy side with 3 ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 3,
      "text": "Separate buns and spread butter onto the cut side of each one."
    },
    {
      "position": 4,
      "text": "Sprinkle with garlic powder. Place on a baking tray."
    },
    {
      "position": 5,
      "text": "Toast under the preheated broiler until golden brown, about 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

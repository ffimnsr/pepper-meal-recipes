  "id": "24eb3ce0-3ad1-5184-ac34-9ae2e3c181ec",
  "slug": "sicilian-sausage-rolls-tomasini-recipe-8421284",
  "name": "Sicilian Sausage Rolls (Tomasini)",
  "recipe_type": "appetizer",
  "brief_description": "Delicious Sicilian sausage rolls (tomasini), are pizza dough spirals filled with Italian sausage and ricotta. Using ready-made pizza dough, they are extremely easy to make.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Roll dough out on a lightly floured surface into a 12x18-inch rectangle. Brush the entire surface of dough with half the beaten egg"
    },
    {
      "position": 3,
      "text": "Beginning about 3 inches from the top edge of the long side of dough, scoop rounded tablespoons of ricotta onto dough in a row, leaving about 1 1/2 inches between each scoop. Make a second row below the first, but offset the ricotta scoops to make a checkerboard pattern. Repeat all the way to the bottom of the dough, using all the ricotta."
    },
    {
      "position": 4,
      "text": "Place rounded tablespoons of sausage into the spaces between ricotta scoops. When finished, the cheese on one row should line up with sausage on the next row and vice versa."
    },
    {
      "position": 5,
      "text": "Season with black pepper, red chili flakes, and salt, keeping in mind that sausage may already be salty. Scatter green onions over, and grate pecorino Romano cheese evenly over."
    },
    {
      "position": 6,
      "text": "Roll dough up from the bottom toward the edge with 3 inches of unfilled dough. Finish with seam on the bottom."
    },
    {
      "position": 7,
      "text": "Cut into 12 equal portions, and place cut side up on the prepared baking sheet. Brush top of each sausage roll with remaining egg, and grate more pecorino Romano cheese over if desired."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until nicely browned, 45 to 50 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "8a9d734c-c38d-5865-980e-3a1b3e715f02",
  "slug": "air-fryer-french-toast-sticks",
  "name": "Air Fryer French Toast Sticks",
  "recipe_type": "breakfast",
  "brief_description": "French toast sticks turn out perfectly crisp outside and are soft and fluffy inside when they're made in the air fryer in just 20 minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix eggs, milk, butter, vanilla extract, and cinnamon together in a bowl."
    },
    {
      "position": 2,
      "text": "Line an air fryer basket with parchment paper. Dip each piece of bread into the milk mixture and place in the basket. Make sure they are not touching; cook in batches if necessary."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 370 degrees F (188 degrees C). Add basket and cook bread for 6 minutes; flip and cook for 3 minutes more. Sprinkle each stick with confectioners' sugar."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

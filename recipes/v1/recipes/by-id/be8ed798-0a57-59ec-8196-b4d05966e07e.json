  "id": "be8ed798-0a57-59ec-8196-b4d05966e07e",
  "slug": "waffle-house-style-waffles",
  "name": "Waffle House-Style Waffles",
  "recipe_type": "breakfast",
  "brief_description": "If you\u2019re craving Waffle House waffles try this easy copycat recipe - you won\u2019t taste the difference. Serve with maple syrup, butter, and chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together flour, cornstarch, salt, baking powder, and baking soda in a bowl."
    },
    {
      "position": 2,
      "text": "Whisk together egg, sugar, butter, and vanilla in a separate large bowl until mixture is smooth. Whisk in half-and-half and buttermilk. Add flour mixture; stir until just combined and a few lumps remain. (Do not overmix.) Chill, covered, at least 1 hour or up to overnight."
    },
    {
      "position": 3,
      "text": "Preheat waffle iron to medium-high; lightly coat with cooking spray. Pour about 2/3 cup batter onto waffle iron. Cook until golden and crisp on edges, 4 to 6 minutes. Transfer to a plate; keep warm. Repeat with remaining batter."
    },
    {
      "position": 4,
      "text": "Serve waffles with maple syrup, chocolate chips, and/or additional butter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "d17db483-2b8b-5c97-9c20-840ca161c557",
  "slug": "banana-baked-oatmeal-cups-recipe-11699825",
  "name": "Banana Baked Oatmeal Cups",
  "recipe_type": "breakfast",
  "brief_description": "These banana bread baked oatmeal cups are like a cross between oatmeal and banana bread. Almond flour and sliced almonds add flavor and texture, while ripe banana keeps them extra soft.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a standard 12-cup muffin tin with a baking spray containing flour."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together mashed banana, honey, egg, milk, oil, vanilla, almond extract, cinnamon, salt, and nutmeg until thoroughly combined. Add in oats, almond flour, sliced almonds, and baking powder and mix until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Divide mixture evenly between the prepared muffin cups. If desired, sprinkle a few extra sliced almonds and oats over batter in each cup."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges of the oatmeal cups are golden brown, and the cups feel set, 25 to 30 minutes. Allow to cool in the pan for 10 minutes, then remove to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "f0bff60d-cc78-5baf-9698-4d3a8154279a",
  "slug": "caramel-corn-i",
  "name": "Caramel Corn I",
  "recipe_type": "dessert",
  "brief_description": "This caramel corn is great for Monday night football. The assortment of nuts makes it deluxe caramel corn. It takes a bit of time, but is more than worth it.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Add 1 tablespoon of the oil to a 4 quart saucepan, and heat over high heat. When oil is hot, add 1/2 cup of popping corn. Keep pan moving constantly. When corn stops popping, remove from heat. Place popped corn in oven to keep warm. Repeat until all corn has been popped. Set aside."
    },
    {
      "position": 3,
      "text": "Melt margarine or butter in a medium saucepan, and then stir in brown sugar, syrup, and salt. Bring to a rolling boil, stirring constantly; boil without stirring for 5 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Stir baking soda, vanilla, peanuts, pecans, and almonds into brown sugar mixture. Quickly pour nut mixture over warm popcorn, and toss until well coated. Spread on greased cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake for 45 minutes, stirring well every 15 minutes. Cool on aluminum foil, and store in an air-tight container."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

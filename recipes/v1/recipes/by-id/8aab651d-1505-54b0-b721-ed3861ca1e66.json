  "id": "8aab651d-1505-54b0-b721-ed3861ca1e66",
  "slug": "vegetarian-mushroom-lentil-soup",
  "name": "Vegetarian Mushroom-Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This light, vegetarian soup is full of flavor and rich in vitamins and minerals thanks to the green lentils and shiitake mushrooms.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a pot or Dutch oven over medium-high heat. Add shallot slices and saute for 1 minute, then add garlic and mushrooms. Saute until mushrooms start to soften, about 3 minutes, stirring frequently so garlic doesn't burn. Add vegetable stock, thyme, and salt and increase heat to high. Bring to a boil, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Stir in lentils and sesame oil, and reduce heat to a simmer. Simmer, stirring occasionally, until lentils are tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Divide soup between 4 bowls and garnish with sliced green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

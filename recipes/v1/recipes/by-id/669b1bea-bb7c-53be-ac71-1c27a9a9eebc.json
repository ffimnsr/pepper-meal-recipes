  "id": "669b1bea-bb7c-53be-ac71-1c27a9a9eebc",
  "slug": "cowboy-sliders-recipe-11722594",
  "name": "Cowboy Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These cowboy sliders are filled with saucy, well-seasoned ground round, Cheddar cheese, bacon, and jalapenos, so gooey and good, you may not want to share.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Heat a large skillet over medium-high heat. Add beef and cook while crumbling with a spoon until no longer pink, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add salt, pepper, garlic powder, onion powder, and Worcestershire, and stir. Add barbecue sauce and stir until well combined. Bring to a simmer and cook for 2 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Place bottom half of Hawaiian rolls on a small rimmed baking sheet. Top with half of the shredded cheese. Top with meat mixture, bacon, jalapenos, crispy onions, and remaining cheese. Place top half of rolls on top and cover the pan with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until rolls are toasted and cheese is melted and gooey, 15 to 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

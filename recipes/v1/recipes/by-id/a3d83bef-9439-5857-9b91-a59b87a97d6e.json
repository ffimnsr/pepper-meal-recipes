{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a3d83bef-9439-5857-9b91-a59b87a97d6e",
  "slug": "good-frickin-paprika-chicken",
  "name": "Good Frickin\u2019 Paprika Chicken",
  "recipe_type": "main",
  "brief_description": "Chef John named his delicious yogurt- and paprika-marinated grilled chicken as an homage to one of the best chicken take-out joints in San Francisco.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together yogurt, garlic, 3 tablespoons paprika, 2 tablespoons olive oil, 1 tablespoon hot chile paste, and cayenne pepper in a large bowl."
    },
    {
      "position": 2,
      "text": "Mix in chicken pieces and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove chicken from the bag and transfer to a plate or baking sheet lined with paper towels. Pat chicken pieces dry with more paper towels. Season with salt."
    },
    {
      "position": 5,
      "text": "Combine 1/4 cup olive oil, sherry vinegar, ketchup, 1/8 teaspoon hot chile paste, pinch paprika, salt, and pepper in a small bowl. Set aside."
    },
    {
      "position": 6,
      "text": "Grill chicken, skin-side down, on the preheated grill for 4 minutes with grill lid closed."
    },
    {
      "position": 7,
      "text": "Turn chicken and grill with lid closed until well-browned and meat is no longer pink in the center, about 6 minutes. An instant-read thermometer inserted into the thickest part of the thigh should read 180 degrees F (82 degrees C)."
    },
    {
      "position": 8,
      "text": "Spoon sherry vinegar mixture over cooked chicken and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

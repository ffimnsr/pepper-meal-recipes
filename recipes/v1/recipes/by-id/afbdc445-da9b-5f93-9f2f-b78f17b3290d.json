  "slug": "chocolate-eggnog-milkshake",
  "name": "Chocolate Eggnog Milkshake",
  "recipe_type": "dessert",
  "brief_description": "The holidays are a time for indulgence so why not sip this delicious chocolate eggnog milkshake? You can easily turn it into an adult beverage by adding a dash of vodka or rum.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ice cream, eggnog, and 2 tablespoons of chocolate syrup in a blender, and process until well-combined."
    },
    {
      "position": 2,
      "text": "Drizzle some chocolate syrup down the sides of the glass in a random pattern, and pour in the milkshake. Top with whipped cream, if desired."
    }
  ],

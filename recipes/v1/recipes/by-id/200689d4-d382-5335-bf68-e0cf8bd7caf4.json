  "id": "200689d4-d382-5335-bf68-e0cf8bd7caf4",
  "slug": "copycat-disney-birria-grilled-cheese-recipe-11967425",
  "name": "Copycat Disney Birria Grilled Cheese",
  "recipe_type": "main",
  "brief_description": "This copycat Disney birria grilled cheese is a sandwich you don't want to miss. Smoky and savory, made with plenty of melty cheese, slasa verde, and Trader Joe's birria, it's even better when you dip it in extra birria sauce.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat. Add onion and cook until softened."
    },
    {
      "position": 2,
      "text": "Add birria meat and continue cooking until heated through."
    },
    {
      "position": 3,
      "text": "In a separate skillet over medium heat melt 1 tablespoon butter and place 2 slices of bread at a time into the skillet. Sprinkle a layer of cheese and salsa verde on each slice. Once cheese begins to melt add birria to one slice and close with the other slice to make a sandwich. Press gently with a spatula and continue to cook until both sides of the bread are golden brown and the cheese has completely melted. Repeat process with remaining ingredients."
    },
    {
      "position": 4,
      "text": "Before serving, slice grilled cheese sandwiches in half and serve with remaining birria sauce for dipping."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

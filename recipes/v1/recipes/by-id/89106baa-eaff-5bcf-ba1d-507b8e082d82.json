  "slug": "apple-crisp-topping",
  "name": "Apple Crisp Topping",
  "recipe_type": "dessert",
  "brief_description": "This simple apple crisp topping is a quick and easy recipe that combines oats, butter, brown sugar, and cinnamon for the perfect topping for any fruit crumble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, flour, cinnamon, salt, and cardamom in a large bowl. Cut in butter until blended and the mixture resembles small peas."
    },
    {
      "position": 3,
      "text": "Mix in oats with a wooden spoon."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,

  "id": "e3c6e6cb-1b0b-5cc8-8fc1-a828de15dc33",
  "slug": "cheesy-chicken-rice-a-roni-casserole-recipe-11822778",
  "name": "Cheesy Chicken Rice-a-Roni Casserole",
  "recipe_type": "main",
  "brief_description": "This cheesy chicken Rice-a-Roni casserole is the perfect tasty weeknight dinner. It's quick and easy to prepare and mighty tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Prepare Rice-a-Roni according to package directions using the water and butter."
    },
    {
      "position": 3,
      "text": "Combine chicken, rice mixture, soup, and sour cream in a large bowl. Stir to combine. Stir in 1/2 cup shredded cheddar cheese."
    },
    {
      "position": 4,
      "text": "Pour mixture into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Top with remaining 1/2 cup cheese. Bake until the cheese is melted and the casserole is bubbly, about 10 minutes longer. Recipe developed by Nicole Irwin."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

  "slug": "steak-sauce",
  "name": "Steak Sauce",
  "recipe_type": "side",
  "brief_description": "This steak sauce is a favorite \u2014 quick and easy to make at home and even better than store-bought. Great on steaks, burgers, fries, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together ketchup, mustard, Worcestershire sauce, vinegar, salt, pepper, and hot pepper sauce in a medium bowl."
    },
    {
      "position": 3,
      "text": "Transfer to a jar and refrigerate until needed."
    }
  ],

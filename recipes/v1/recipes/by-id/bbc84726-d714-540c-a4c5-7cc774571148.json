  "id": "bbc84726-d714-540c-a4c5-7cc774571148",
  "slug": "chicken-wing-dip",
  "name": "Chicken Wing Dip",
  "recipe_type": "appetizer",
  "brief_description": "This spicy chicken wing dip tastes just like hot chicken wings without the mess! It calls for 5 ingredients and takes just 30 minutes to bake!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cream cheese and hot pepper sauce together in a medium bowl until well blended; stir in chicken, dressing, and Cheddar cheese."
    },
    {
      "position": 3,
      "text": "Spread into a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly, about 30 minutes. If oil collects on the top, dab it off using a paper towel."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "herbs-de-provence",
  "name": "Herbs de Provence",
  "recipe_type": "salad",
  "brief_description": "Herbs de Provence is a classic blend of dried herbs used in French and Mediterranean cooking with roasted vegetables, grilled fish, stews, and salads.",
  "cuisine": "French Inspired French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Grind rosemary and fennel seed in a spice grinder; transfer to a mixing bowl."
    },
    {
      "position": 3,
      "text": "Add savory, thyme, basil, marjoram, lavender, parsley, oregano, tarragon, and bay powder to the bowl; stir well. Store in an airtight container between uses."
    }
  ],
  "servings": 48,

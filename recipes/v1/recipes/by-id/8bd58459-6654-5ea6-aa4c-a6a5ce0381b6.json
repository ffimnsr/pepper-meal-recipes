{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8bd58459-6654-5ea6-aa4c-a6a5ce0381b6",
  "slug": "homemade-cavatelli-pasta",
  "name": "Homemade Cavatelli Pasta",
  "recipe_type": "main",
  "brief_description": "Learn how to make cavatelli, a typical Southern Italian pasta, with this authentic Italian recipe and video. You will only need durum wheat semolina flour, water, and salt.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix semolina flour and salt in a large bowl or on a marble work surface. Make a well in the center."
    },
    {
      "position": 2,
      "text": "Pour water into the well a little at a time, mixing it with flour. Add as much water as needed to make a sticky but compact dough."
    },
    {
      "position": 3,
      "text": "Knead dough with your hands by flattening the ball, stretching it, and folding top toward center. Turn 45 degrees and repeat until dough is elastic and smooth, but not too soft, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Shape dough into a ball. Place in a bowl and cover with plastic wrap. Let rest at room temperature for about 30 minutes before using. If you are using cavatelli within a few hours or the following day, wrap in plastic wrap and chill in the refrigerator."
    },
    {
      "position": 5,
      "text": "Work with one portion of dough at a time, keeping remaining dough covered to keep it from drying out. Dust a work surface with semolina flour; roll out dough to make a rope, about 1/3 inch thick."
    },
    {
      "position": 6,
      "text": "Cut off little 1/3-inch-thick pieces. Press and gently drag a small piece of dough toward you with your index and middle finger. The two sides will curl inwards, leaving hollow spaces."
    },
    {
      "position": 7,
      "text": "Proceed the same way with rest of dough. Transfer cavatelli to a floured surface and sprinkle with more semolina flour. Do not overlap cavatelli or they will stick together. Let dry for about 30 minutes before cooking."
    }
  ],
  "servings": 4,

  "id": "743a6ede-e85e-5a50-a796-6c86df37be4a",
  "slug": "bacon-on-the-grill",
  "name": "Bacon on the Grill",
  "recipe_type": "breakfast",
  "brief_description": "Bacon on the grill makes prep and cleanup easy and mess-free. If want to know how to cook bacon this way, check out this recipe using aluminum foil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-low heat."
    },
    {
      "position": 2,
      "text": "Line a large rimmed baking sheet with aluminum foil. Place a cooling rack on top. Place bacon on rack, making sure no pieces are overlapping."
    },
    {
      "position": 3,
      "text": "Place baking sheet on the grill grate, close the lid, and cook bacon until crispy or desired doneness, around 12 minutes. Transfer bacon to a paper towel-lined plate to absorb excess grease."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

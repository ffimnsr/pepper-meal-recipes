  "id": "959f5709-584c-5f83-af68-838bf039c6ee",
  "slug": "easy-rice-pudding",
  "name": "Easy Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This rice pudding recipe is a simple and delicious combination of white rice, sugar, vanilla, milk, and cinnamon that's easy to make in the oven.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Coat a 2-quart casserole dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Place rice, sugar, and salt in the casserole dish; stir in milk and vanilla."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, in preheated oven for 1 1/2 to 2 hours, stirring every 20 minutes. Let stand for 30 minutes. Sprinkle top with cinnamon."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,

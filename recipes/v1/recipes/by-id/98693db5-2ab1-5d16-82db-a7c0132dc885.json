  "id": "98693db5-2ab1-5d16-82db-a7c0132dc885",
  "slug": "original-ranch-spinach-dip",
  "name": "Original Ranch Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "This crowd-pleasing appetizer features a hollowed-out loaf of French bread filled with a creamy mixture of sour cream, spinach, water chestnuts, and Hidden Valley® Original Ranch® Seasoning Mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together dips mix, sour cream, spinach and water chestnuts. Chill 30 minutes or until just before serving."
    },
    {
      "position": 2,
      "text": "Cut top off the bread and remove center (using firm bread pieces as dippers). Fill bread bowl with dip. Serve with cubed bread and vegetables."
    }
  ],
  "servings": 10,

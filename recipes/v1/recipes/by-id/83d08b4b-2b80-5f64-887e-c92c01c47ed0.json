  "slug": "moms-kimchi-egg",
  "name": "Mom's Kimchi Egg",
  "recipe_type": "breakfast",
  "brief_description": "Fry kimchi and eggs together in a bit of oil and get a breakfast item that transcends the sum of its parts. Trust us with this easy, satisfying dish.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet or wok over medium heat. Cook kimchi in hot oil until softened, about 2 minutes; add eggs. Cook and stir eggs and kimchi together until eggs are set, 2 to 3 minutes."
    }
  ],
  "servings": 2,

  "id": "8008224d-f963-5d8a-920c-214a6ac5c180",
  "slug": "dairy-free-vanilla-brownies",
  "name": "Dairy-Free Vanilla Brownies",
  "recipe_type": "dessert",
  "brief_description": "Barley flour and baking powder help make these easy-to-prepare brownies wheat-free and dairy-free.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a small baking dish."
    },
    {
      "position": 2,
      "text": "Beat eggs, vegetable oil, and vanilla extract together in a large bowl. Mix barley flour, sugar, baking powder, and salt together in a separate bowl; add to eggs mixture and stir to make a smooth batter. Pour batter into prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until brown on top and set in the center, 20 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

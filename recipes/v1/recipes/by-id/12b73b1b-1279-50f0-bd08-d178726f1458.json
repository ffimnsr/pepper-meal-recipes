  "id": "12b73b1b-1279-50f0-bd08-d178726f1458",
  "slug": "slow-cooker-chicken-and-lentil-soup",
  "name": "Slow Cooker Chicken and Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This crock pot chicken and lentil soup is simmered in the slow cooker with tomatoes, onion, green lentils, and spices for a no-fuss cold-weather meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine green lentils, tomatoes, onion, minced garlic, cumin, oregano, chili powder, paprika, garlic powder, onion powder, and salt in a slow cooker. Pour in chicken broth and stir gently to evenly distribute seasonings. Settle chicken thighs into broth, ensuring they are submerged in liquid."
    },
    {
      "position": 2,
      "text": "Cook on High for 4 hours. Chicken should be falling off the bone and lentils should be tender (if not, cook a little bit longer)."
    },
    {
      "position": 3,
      "text": "Use tongs to remove chicken from soup to a cutting board. Pull meat off the bones with tongs and either rough chop or break apart into bite-sized pieces; discard the bones. Stir meat into soup and adjust seasonings as desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

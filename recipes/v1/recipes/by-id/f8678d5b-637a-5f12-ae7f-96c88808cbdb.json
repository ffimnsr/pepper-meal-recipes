  "id": "f8678d5b-637a-5f12-ae7f-96c88808cbdb",
  "slug": "spicy-refrigerator-dill-pickles",
  "name": "Spicy Refrigerator Dill Pickles",
  "recipe_type": "dessert",
  "brief_description": "Spicy pickles with a hint of sweetness. This recipe is great for pickling beginners \u2014 all you need is a refrigerator, a few jars, and patience.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cucumbers, water, vinegar, chopped dill, sugar, garlic, salt, pickling spice, dill seed, and red pepper flakes in a large bowl. Stir and let sit at room temperature until sugar and salt dissolve, about 2 hours."
    },
    {
      "position": 3,
      "text": "Transfer cucumbers to 3 wide-mouth, 1 1/2-pint jars, placing 4 cucumbers into each jar. Add enough vinegar mixture to cover cucumbers. Place 1 sprig of fresh dill into each jar and seal with lids. Refrigerate for 10 days before eating. Use within 1 month."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

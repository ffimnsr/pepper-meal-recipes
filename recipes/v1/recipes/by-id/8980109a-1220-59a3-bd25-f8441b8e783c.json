  "id": "8980109a-1220-59a3-bd25-f8441b8e783c",
  "slug": "grandma-rubys-buttermilk-pound-cake",
  "name": "Grandma Ruby's Buttermilk Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "Grandma Ruby's recipe for buttermilk pound cake gets a bright citrus kick from lemon extract. It's a super rich and moist pound cake you will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a fluted tube pan (such as Bundt)."
    },
    {
      "position": 2,
      "text": "Sift flour, salt, and baking soda together into a bowl; repeat sifting twice more."
    },
    {
      "position": 3,
      "text": "Beat sugar and shortening together in a bowl until smooth and creamy. Add flour mixture, eggs, buttermilk, lemon extract, vanilla extract, and butter extract; beat until just combined. Pour batter into the prepared tube pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 75 minutes. Cool in the pan on a wire rack for 15 minutes. Tap the pan firmly a few times, then shake it gently to loosen the cake. Place a wire rack over the pan and invert to release cake onto the rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

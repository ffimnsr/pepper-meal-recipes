  "id": "afef0a27-a0fb-54f0-bbda-ff32f346e47a",
  "slug": "air-fryer-roasted-salsa",
  "name": "Air Fryer Roasted Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This simple restaurant-style salsa is made with tomatoes, onion, garlic, and jalapeno that are first roasted in an air fryer.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 390 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place tomatoes and jalapeno skin-side down into the air fryer basket, along with red onion. Lightly spray vegetables with cooking spray to help the roasting process."
    },
    {
      "position": 3,
      "text": "Air fry vegetables for 5 minutes. Open basket and add garlic cloves. Spray lightly with cooking spray and air fry for an additional 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer vegetables to a cutting board and allow to cool for 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove skins from tomatoes and jalapeno, if desired; they should slip right off. Chop tomatoes, jalapeno, and onion into large chunks and add to the bowl of a food processor. Add garlic, cilantro, lime juice, and salt. Pulse several times until vegetables are finely chopped; do not over-process. Serve at room temperature or refrigerate to let flavors meld."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "6be5016d-36c6-5cbc-98b7-333926c4d118",
  "slug": "apple-crisp-i",
  "name": "Apple Crisp with Instant Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "Apples are topped with a brown sugar, instant oatmeal crust, sprinkled with walnuts, drizzled with maple syrup and baked until tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place apples in a 9x13 inch baking dish. Beat butter and sugar together in a bowl. Stir in flour, instant oatmeal, and salt. Fold in walnuts. Sprinkle oatmeal mixture evenly over apples. Drizzle with maple syrup."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven 50 to 70 minutes, until apples are tender and topping is golden."
    }
  ],
  "servings": 18,

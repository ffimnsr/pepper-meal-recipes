  "schema_version": 1,
  "id": "bac502e3-b209-5d9a-9012-1435a5896ea7",
  "slug": "okees-irish-soda-oatmeal-bread",
  "name": "O'Kee's Irish Soda Oatmeal Bread",
  "recipe_type": "main",
  "brief_description": "A long fermentation time allows complex flavors to develop in this classic Irish oatmeal and buttermilk loaf. Recipe makes 2 loaves. Start this bread the day before your St. Patrick's Day meal.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Mix rolled oats, buttermilk, and molasses in a large bowl until thoroughly combined."
    },
    {
      "position": 2,
      "text": "Whisk together whole wheat flour, all-purpose flour, salt, baking soda, and cream of tartar until combined; pour flour mixture into buttermilk mixture and stir just until moistened."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly-floured work surface and knead 3 or 4 times until dough holds its shape."
    },
    {
      "position": 4,
      "text": "Cut dough in half; pat each half into a 6-inch round loaf."
    },
    {
      "position": 5,
      "text": "Use a sharp knife to deeply score each loaf in quarters, cutting 1-inch deep."
    },
    {
      "position": 6,
      "text": "Wrap each loaf in plastic wrap and allow to stand at least 12 hours at room temperature to ferment. (Loaves can be refrigerated up to 2 more days after this, if desired.)"
    },
    {
      "position": 7,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 8,
      "text": "Place loaves on an ungreased baking sheet."
    },
    {
      "position": 9,
      "text": "Bake loaves for 15 minutes and reduce heat to 350 degrees F (175 degrees C). Continue to bake until loaves are browned and make a hollow sound when tapped on the bottom, about 20 more minutes."
    },
    {
      "position": 10,
      "text": "Allow breads to cool for 10 minutes before slicing. To serve, slice loaves 3/4-inch thick all across the loaf, then cut slices in half."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

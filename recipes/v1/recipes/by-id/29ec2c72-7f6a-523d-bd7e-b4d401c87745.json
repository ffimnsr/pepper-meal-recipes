  "id": "29ec2c72-7f6a-523d-bd7e-b4d401c87745",
  "slug": "english-muffin-breakfast-strata",
  "name": "English Muffin Breakfast Strata",
  "recipe_type": "breakfast",
  "brief_description": "Green chiles give this English muffin breakfast strata recipe some spiciness. Assemble it the night before and bake in the morning for an easy brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add sausage; cook and stir until crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease."
    },
    {
      "position": 2,
      "text": "Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Spread butter on inside of each English muffin half; arrange in the prepared baking dish. Top with \u00bd each sausage, Cheddar cheese, and mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Whisk eggs, sour cream, and green chiles together in a large bowl; pour evenly over sausage and cheese layer. Top with remaining \u00bd each sausage, Cheddar cheese, and mozzarella cheese. Cover strata; chill for 8 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly browned and set in the middle, about 35 minutes. Let stand before serving for 10 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

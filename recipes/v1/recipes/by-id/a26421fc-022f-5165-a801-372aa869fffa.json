  "id": "a26421fc-022f-5165-a801-372aa869fffa",
  "slug": "indian-chole-aloo-tikki",
  "name": "Indian Chole Aloo Tikki",
  "recipe_type": "appetizer",
  "brief_description": "This is a delicious vegan Indian recipe where vegetables and chickpeas are served over small potato cakes. It works well as a starter for four, or as a main for two.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and peel."
    },
    {
      "position": 2,
      "text": "Place cooked potatoes into a bowl and add cornstarch, ginger, cumin, cayenne, cilantro, salt, and pepper. Mash together with a fork. Oil your hands with a little vegetable oil and divide the potato mixture into 4 equal portions. Pat each portion into a potato patty about 1/3-inch thick."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon vegetable oil in a skillet over medium heat. Fry potato cakes until golden, about 3 minutes on each side. Remove from heat and keep warm."
    },
    {
      "position": 4,
      "text": "Grind peppercorns and cloves with a mortar and pestle."
    },
    {
      "position": 5,
      "text": "Heat the remaining 2 tablespoons vegetable oil in a skillet over medium-high heat. Stir in red chile peppers, cumin, bay leaves. Add onion, ginger, and garlic. Cook and stir until onion is golden, about 5 minutes. Add pepper-clove mixture, curry powder, and turmeric."
    },
    {
      "position": 6,
      "text": "Mix tomato paste with water. Stir diluted tomato paste and tomato into the skillet. Cook over medium heat until the tomato has softened, about 5 minutes. Stir in chickpeas and simmer over low heat for 10 minutes."
    },
    {
      "position": 7,
      "text": "Spoon chickpea sauce over the potato cakes and sprinkle with cilantro leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

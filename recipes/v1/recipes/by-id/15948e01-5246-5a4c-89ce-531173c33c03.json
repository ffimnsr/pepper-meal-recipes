  "id": "15948e01-5246-5a4c-89ce-531173c33c03",
  "slug": "instant-pot-harissa-hummus",
  "name": "Instant Pot\u00ae Harissa Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This classic hummus with a kick of harissa is made from scratch with dried chickpeas in your Instant Pot\u00ae--its perfect to serve with warm flatbread or veggies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Soak chickpeas in water for about 2 hours, rubbing occasionally while soaking to help remove the outer skin. Discard any skins that come loose. Drain chickpeas."
    },
    {
      "position": 2,
      "text": "Combine chickpeas, water, and vegetable broth in a multi-functional pressure cooker (such as Instant Pot\u00ae). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 20 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 4,
      "text": "Strain chickpeas, reserving 3/4 cup of cooking liquid. Set aside 1/4 cup cooked chickpeas for garnish and transfer remaining chickpeas into the bowl of a food processor fitted with a blade. Add 2 tablespoons olive oil, tahini, lemon juice, and garlic. Blend until smooth, about 3 minutes, scraping down the sides. Add 1/2 cup of the reserved cooking liquid. Blend until creamy adding more liquid if necessary. Mix in 5 teaspoons harissa paste and salt."
    },
    {
      "position": 5,
      "text": "Scrape hummus into a bowl. Drizzle remaining 1 tablespoon olive oil and 1 teaspoon harissa paste and swirl with a knife, but do not mix in completely. Sprinkle with the reserved, whole chickpeas. Serve at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

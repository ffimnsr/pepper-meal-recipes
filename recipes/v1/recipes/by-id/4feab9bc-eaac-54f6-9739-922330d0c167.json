  "id": "4feab9bc-eaac-54f6-9739-922330d0c167",
  "slug": "polish-poppy-seed-cake",
  "name": "Polish Poppy Seed Cake",
  "recipe_type": "dessert",
  "brief_description": "This traditional Polish poppy seed cake has a shortcrust base filled with a creamy poppy seed filling, and topped with a thick sugar glaze.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Place poppy seeds in a small pot, cover with boiling water, and set aside for 24 hours."
    },
    {
      "position": 2,
      "text": "Line a colander with a cheesecloth and spoon in the poppy seeds. Allow draining for several hours. Once drained, transfer to a food processor and process until fine."
    },
    {
      "position": 3,
      "text": "Combine 1 1/2 cups flour, 3/4 cup margarine, 1/3 cup sugar, 1 egg, and baking powder in a large bowl and knead into a smooth dough."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a deep 9x13-inch deep pan and line it with parchment paper."
    },
    {
      "position": 5,
      "text": "Roll out dough on a slightly floured surface and place in the prepared sheet pan."
    },
    {
      "position": 6,
      "text": "Combine egg yolks, 9 tablespoons margarine, and 1 cup sugar in a large bowl; beat with an electric mixer until light and fluffy. Beat in drained poppy seeds gradually. Add apples, walnuts, raisins, honey, bread crumbs, and almond extract; mix well."
    },
    {
      "position": 7,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form. Lift your beater or whisk straight up: egg whites will form sharp peaks. Fold egg whites into poppy seed mixture; spread over dough in the sheet pan."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven for 1 hour until cake is set; transfer to a wire rack to cool."
    },
    {
      "position": 9,
      "text": "Mix enough boiling water with confectioners' sugar to form a smooth icing. Spread generously over cooled cake."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

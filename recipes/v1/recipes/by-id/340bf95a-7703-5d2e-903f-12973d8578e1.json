  "id": "340bf95a-7703-5d2e-903f-12973d8578e1",
  "slug": "strawberry-cheesecake-french-toast",
  "name": "Strawberry Cheesecake French Toast",
  "recipe_type": "dessert",
  "brief_description": "Cream cheese-stuffed French toast is served with a sweet and warm strawberry glaze and topped with whipped cream in this decadent breakfast favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 100 degrees F ( 40 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat mashed strawberries and 1/2 cup white sugar in a saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Whisk water and cornstarch together in a bowl; stir into mashed strawberries. Cook and stir until thickened, about 5 minutes. Reduce heat to low and simmer while preparing remaining ingredients, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Whisk milk and eggs together in a bowl; set aside."
    },
    {
      "position": 5,
      "text": "Mash cream cheese, remaining 3/4 cup white sugar, and vanilla extract together in a bowl until smooth."
    },
    {
      "position": 6,
      "text": "Spread some cream cheese mixture over 1 triangle-shaped piece of bread; top with another triangle-shaped pieced of bread to cover. Repeat with remaining bread and cream cheese mixture to make 8 triangle-shaped sandwiches."
    },
    {
      "position": 7,
      "text": "Heat butter in a large skillet over medium heat."
    },
    {
      "position": 8,
      "text": "Dip cream cheese-stuffed sandwiches into egg mixture, 2 or 3 at a time; place in the skillet. Cook until golden brown on both sides, about 3 minutes per side. Transfer French toast to a baking sheet and place in the preheated oven to keep warm while cooking remaining sandwiches."
    },
    {
      "position": 9,
      "text": "Top French toast with warm strawberry glaze and sliced fresh strawberries; sprinkle with confectioners' sugar. Serve with a dollop of whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

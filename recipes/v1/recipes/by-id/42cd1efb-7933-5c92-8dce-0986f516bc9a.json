  "id": "42cd1efb-7933-5c92-8dce-0986f516bc9a",
  "slug": "fruit-and-nut-granola-chrissies-granola",
  "name": "Fruit and Nut Granola (Chrissie's Granola)",
  "recipe_type": "breakfast",
  "brief_description": "Make your own homemade cinnamon-and-cocoa accented granola featuring dried fruit and dark chocolate chips using this recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a large baking sheet."
    },
    {
      "position": 2,
      "text": "Pour the oats into a large bowl. Add almonds, cinnamon, cocoa powder, salt, brown sugar, and dried fruit into the oats respectively, stirring each into the mixture before adding the next."
    },
    {
      "position": 3,
      "text": "Mix maple syrup and vanilla extract together in a small bowl. With a rubber spatula, add the maple syrup-vanilla mixture to your dry ingredients. Fold the two together until mixed and all dry ingredients are well coated."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for about 20 minutes, stir, and continue baking until golden brown, about 25 minutes more. Set aside to cool slightly, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Gently fold chocolate chips into the granola mixture, allowing the chocolate to coat the granola as it melts slightly. Cool completely before storing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

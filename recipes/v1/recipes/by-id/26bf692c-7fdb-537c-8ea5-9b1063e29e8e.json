  "id": "26bf692c-7fdb-537c-8ea5-9b1063e29e8e",
  "slug": "balela-salad",
  "name": "Balela Salad",
  "recipe_type": "salad",
  "brief_description": "This balela is a quick Middle Eastern-style bean salad made with garbanzos, black beans, and lots of sweet grape tomatoes tossed in a tangy blender dressing.",
  "cuisine": "Middle Eastern Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together garbanzo beans, black beans, mint, parsley, onion, and grape tomatoes in a large salad bowl until well combined."
    },
    {
      "position": 2,
      "text": "Place jalapeño pepper, garlic, olive oil, lemon juice, and apple cider vinegar into a blender. Blend until dressing is thoroughly combined."
    },
    {
      "position": 3,
      "text": "Pour dressing over salad and toss to mix. Sprinkle with salt and black pepper to serve."
    }
  ],
  "servings": 10,

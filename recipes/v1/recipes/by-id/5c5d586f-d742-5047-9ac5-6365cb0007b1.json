  "id": "5c5d586f-d742-5047-9ac5-6365cb0007b1",
  "slug": "cheater-pot-pie",
  "name": "Cheater Pot Pie",
  "recipe_type": "main",
  "brief_description": "My husband and I fondly refer to this canned chicken potpie as \"Cheater Pot Pie.\" It's similar to a standard pot pie, but doesn't take as long to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Butter a 9-inch deep-dish pie pan with 1 tablespoon melted butter."
    },
    {
      "position": 2,
      "text": "Combine mixed vegetables and chicken in a saucepan over medium heat; cook until vegetables are tender, 5 to 7 minutes. Fold in condensed soup; mix well. Pour in milk and mix until smooth; mixture should not be runny. Season with salt and pepper; bring to a boil."
    },
    {
      "position": 3,
      "text": "Remove from the heat and spread mixture into the bottom of the prepared pie pan. Separate biscuits into layers and place gently on top of chicken-vegetable mixture. Drizzle remaining 2 tablespoons melted butter over biscuits."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and let stand for 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

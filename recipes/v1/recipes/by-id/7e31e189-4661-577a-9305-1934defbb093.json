  "id": "7e31e189-4661-577a-9305-1934defbb093",
  "slug": "pork-sinigang",
  "name": "Pork Sinigang",
  "recipe_type": "soup",
  "brief_description": "Sinigang is a Filipino soup cooked with pork. It is easy to make with tangy, fresh flavors from tamarind, ginger, and tomato \u2014 in a rich pork broth.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a skillet over medium heat. Add onion; cook and stir until softened and translucent, about 5 minutes. Season with salt."
    },
    {
      "position": 2,
      "text": "Stir in ginger, tomatoes, and pork chops. Cover and reduce heat to medium-low. Turn the pork occasionally, until browned."
    },
    {
      "position": 3,
      "text": "Pour in water and tamarind soup base. Bring to a boil, then reduce heat and simmer until the pork is tender and cooked through, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir in green beans and cook until tender."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

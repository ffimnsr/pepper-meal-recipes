  "id": "280c1015-bf50-58e4-a102-1e6dd8c6dc67",
  "slug": "smash-burger-taco-recipe-7485747",
  "name": "Smash Burger Taco",
  "recipe_type": "main",
  "brief_description": "If you're a smash burger fan, try serving them as a taco for a different take!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayo, ketchup, mustard, relish, and hot sauce in a small bowl; set sauce aside."
    },
    {
      "position": 2,
      "text": "Heat a griddle over medium-high heat."
    },
    {
      "position": 3,
      "text": "Divide beef into 4 loose portions and place on the hot griddle. Season with salt and pepper and cook for 2 minutes. Place a tortilla over each portion and firmly press to flatten the beef into a thin layer that reaches the edges of the tortilla."
    },
    {
      "position": 4,
      "text": "Cook until tortilla is golden-brown, 2 to 3 more minutes. Flip each patty over and top with cheese. When cheese is melted and the tortilla is golden brown and crisp, top with lettuce and onions. Drizzle with sauce, remove from the griddle and fold in half like a taco. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

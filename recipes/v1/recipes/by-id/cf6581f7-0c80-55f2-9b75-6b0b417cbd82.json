{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "cf6581f7-0c80-55f2-9b75-6b0b417cbd82",
  "slug": "make-ahead-air-fryer-breakfast-burritos",
  "name": "Make-Ahead Air Fryer Breakfast Burritos",
  "recipe_type": "breakfast",
  "brief_description": "Sausage, egg, and cheese burritos made ahead of time that you can grab out of the freezer, pop in the air fryer, and be on your way in no time.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble sausage into a large skillet over medium-high heat. Cook until no longer pink, about 10 minutes. Transfer to a large bowl using a slotted spoon."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium. Pour beaten eggs into the skillet and season with salt and pepper. Cook for 3 minutes. Stir and cook for 2 minutes more. Turn heat off. Stir one last time, breaking up larger pieces. Pour into the bowl with the sausage, add cheese, and stir to combine."
    },
    {
      "position": 3,
      "text": "Lay out 1 tortilla on a clean work surface. Place 1/4 cup of the sausage-egg mixture on the bottom third of the tortilla, closest to you. Fold the end of the tortilla over the mixture. Fold in both sides of the tortilla over the filling, making an envelope shape. Tuck, roll, and place on a baking sheet seam side down. Repeat with remaining tortillas and filling."
    },
    {
      "position": 4,
      "text": "Place baking sheet into the freezer for 2 hours. Transfer burritos to a covered freezer-safe container until ready to serve."
    },
    {
      "position": 5,
      "text": "When ready to cook, preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 6,
      "text": "Place burrito, seam-side down, in the preheated air fryer, and cook for 5 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "870d3853-a96f-5952-973e-db16e8b51284",
  "slug": "picadillo",
  "name": "Picadillo",
  "recipe_type": "main",
  "brief_description": "This Cuban picadillo features a mixture of ground beef and chorizo sausage simmered with tomatoes, spices, and olives. It's total comfort food!",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add ground beef and sausage; cook and stir until browned and crumbly, about 10 minutes. Drain some grease."
    },
    {
      "position": 2,
      "text": "Add onion and bell pepper; cook and stir until soft, about 5 minutes. Stir in garlic, cumin, chili powder, oregano, paprika, cayenne pepper, and cinnamon; cook until fragrant, about 1 minute. Add tomatoes, stock, and sugar; stir to combine. Reduce the heat to low, cover, and simmer for 20 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Add raisins, olives, vinegar, and capers to the skillet; simmer, uncovered, for 5 minutes. Stir in almonds and lime juice, and cook until warm, 2 to 3 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

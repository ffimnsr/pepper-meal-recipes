  "slug": "big-batch-berry-sangria",
  "name": "Big Batch Berry Sangria",
  "recipe_type": "drink",
  "brief_description": "Perfect for parties and celebrations, this big batch sangria is served with frozen mixed berries in place of ice cubes for a beautiful, fruity treat.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Mix wine, sodas, simple syrup, orange juice, and brandy together in a large pitcher. Drop in orange slices and some of the frozen berries. Place in the refrigerator for 3 hours."
    },
    {
      "position": 2,
      "text": "Pour into glasses and drop in remaining frozen berries instead of ice. Garnish with strawberries."
    }
  ],

  "id": "66f683f4-e0f9-5314-901f-f3ac2f3efb0a",
  "slug": "avocado-egg-salad",
  "name": "Avocado Egg Salad",
  "recipe_type": "salad",
  "brief_description": "This avocado egg salad made with hard boiled eggs, creamy avocado, red onion, pickles, and mustard is a tasty twist on the classic egg salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mash hard-boiled eggs lightly in a bowl with a fork."
    },
    {
      "position": 3,
      "text": "Add avocado, red onion, mayonnaise, pickles, and mustard. Gently mash together until just blended; season to taste with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Store in the refrigerator until ready to serve."
    }
  ],
  "servings": 6,

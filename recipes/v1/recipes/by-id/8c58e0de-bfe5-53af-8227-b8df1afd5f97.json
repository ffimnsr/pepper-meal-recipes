  "id": "8c58e0de-bfe5-53af-8227-b8df1afd5f97",
  "slug": "pudding-shots",
  "name": "Pudding Shots",
  "recipe_type": "dessert",
  "brief_description": "Pudding shots are a great and tasty alternative to traditional gelatin shots. Use Bailey's and chocolate pudding mix to make easy, fun, boozy treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk milk, Irish cream liqueur, vodka, and instant pudding mix together in a bowl until thoroughly combined, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Spoon the pudding mixture into shot glasses or disposable party shot cups. Chill until set, about 30 minutes. The shots will have the consistency of mousse."
    }
  ],

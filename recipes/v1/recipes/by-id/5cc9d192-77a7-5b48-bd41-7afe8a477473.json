  "id": "5cc9d192-77a7-5b48-bd41-7afe8a477473",
  "slug": "slow-cooker-corned-beef-cabbage-and-potatoes",
  "name": "Slow Cooker Corned Beef, Cabbage, and Potatoes",
  "recipe_type": "main",
  "brief_description": "Seasoned corned beef, cabbage, and potatoes simmer in a slow cooker for this easy St. Patrick's Day dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in the bottom of a large slow cooker and cover with water. Rub corned beef with onion flakes, pickling spice, peppercorns, and caraway seeds. Add to the slow cooker. Add cabbage and juniper berries on top; do not worry if the liquid does not cover the cabbage, it will steam and more liquid will come out of the meat to add to the broth."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low until tender, 8 to 12 hours. Serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 5,

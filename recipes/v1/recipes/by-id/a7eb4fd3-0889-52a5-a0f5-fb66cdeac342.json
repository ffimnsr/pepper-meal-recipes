  "id": "a7eb4fd3-0889-52a5-a0f5-fb66cdeac342",
  "slug": "beef-and-pork-guiso-recipe-7494546",
  "name": "Beef and Pork Guiso",
  "recipe_type": "soup",
  "brief_description": "This incredible beef and pork guiso is good by itself, with rice or pasta, or with chips.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Cut beef and pork into very tiny cubes; season with about half of adobo seasoning and cumin."
    },
    {
      "position": 3,
      "text": "Using a food processor, chop onions and garlic, set aside. Chop red pepper, orange pepper, yellow pepper, onions, garlic, green olives, pickled vegetables, capers, and cilantro in a food processor; place together in a bowl. You may have to chop vegetables in batches."
    },
    {
      "position": 4,
      "text": "Heat oil in a very large pot over high heat, add onions and garlic and cook for 5 minutes, stirring occasionally."
    },
    {
      "position": 5,
      "text": "Add chopped red pepper, orange pepper, yellow pepper, olives, pickled vegetables, capers, and cilantro, and cook for 5 minutes, stirring occasionally."
    },
    {
      "position": 6,
      "text": "Pour in wine; cook for 5 minutes, stirring occasionally. Add beef and pork and stir well to combine. Stir in chicken broth; season to taste with salt."
    },
    {
      "position": 7,
      "text": "Bring mix to a rolling boil; turn heat down to medium-low. Cover; simmer until well reduced, stirring occasionally, about 5 hours. After the first 2 hours, taste and add remaining cumin and adobo seasoning as needed."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 315,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "306dd8d2-c9ad-5cda-9726-08a782614f4d",
  "slug": "baked-mashed-potatoes",
  "name": "Baked Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Baked mashed potatoes are light and fluffy! Boil Yukon Golds, then mash them and mix with butter, milk, cream cheese, egg, and onion for amazing results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish."
    },
    {
      "position": 2,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce the heat to medium-low and simmer until tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Drain potatoes and transfer to a large bowl. Add butter and milk, and mash to combine. Add cream cheese and onion; beat with an electric mixer until smooth."
    },
    {
      "position": 4,
      "text": "Whisk egg in a small bowl. Add one spoonful hot potatoes, whisking quickly to avoid scrambling the egg. Pour mixture back into the bowl and stir to combine with remaining potatoes. Season with salt and pepper. Transfer to the prepared casserole dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until puffy and golden brown, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 30,

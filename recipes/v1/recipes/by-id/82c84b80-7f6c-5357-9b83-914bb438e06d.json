  "id": "82c84b80-7f6c-5357-9b83-914bb438e06d",
  "slug": "sous-vide-cold-brew-coffee",
  "name": "Sous Vide \"Cold Brew\" Coffee",
  "recipe_type": "drink",
  "brief_description": "For this sous vide \"cold brew\" coffee recipe, use your favorite fresh-ground coffee and a sous vide immersion cooker to speed up the \"cold brew\" process.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place \u00bc cup ground coffee in each jar; top each with 2 cups water. Screw on lids until just barely tightened; do not overtighten."
    },
    {
      "position": 2,
      "text": "Fill a large pot with enough water to completely cover jars; place a sous vide immersion cooker into water. Set temperature to 150 degrees F (65 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Submerge jars in the water bath; set timer for 2 hours."
    },
    {
      "position": 4,
      "text": "Transfer jars to a cooling rack; cool until easily handled. Strain coffee through a coffee filter to stop the steeping process."
    },
    {
      "position": 5,
      "text": "Serve coffee over ice or return strained coffee to clean jars and store in the refrigerator for up to 1 week."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

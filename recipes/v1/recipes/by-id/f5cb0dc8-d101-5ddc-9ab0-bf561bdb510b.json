  "id": "f5cb0dc8-d101-5ddc-9ab0-bf561bdb510b",
  "slug": "pesto-pasta-caprese-salad",
  "name": "Pesto Pasta Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "Caprese pasta salad made with rotini pasta, prepared pesto, fresh mozzarella, and tomatoes for a colorful pasta version of Italian Caprese salad.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; cook the rotini at a boil until tender yet firm to the bite, about 8 minutes; drain."
    },
    {
      "position": 2,
      "text": "Mix pesto, olive oil, salt, granulated garlic, and black pepper in a bowl; add rotini. Toss to coat. Fold in tomatoes, mozzarella, and fresh basil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

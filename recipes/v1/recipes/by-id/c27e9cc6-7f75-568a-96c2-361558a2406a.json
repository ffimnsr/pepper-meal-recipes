  "id": "c27e9cc6-7f75-568a-96c2-361558a2406a",
  "slug": "dill-pickle-parmesan-chicken-recipe-11862225",
  "name": "Dill Pickle Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "This dill pickle Parmesan chicken delivers a crunchy, golden crust packed with tangy dill pickle flavor. Juicy chicken breasts are coated in dill pickle ranch, then breaded with Parmesan cheese, panko, and ranch seasoning for a bold, savory twist on baked chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For dressing, stir sour cream, buttermilk, dill pickle seasoning, lime juice, and lime zest together in a small bowl. Refrigerate for at least 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C), preferably on convection setting. Line a baking sheet with parchment."
    },
    {
      "position": 3,
      "text": "On a cutting board, cut chicken breasts in half horizontally and then in half vertically. Each chicken piece should be the size of a deck of cards. Season the chicken pieces with salt, big dill pickle seasoning. pepper, and garlic powder."
    },
    {
      "position": 4,
      "text": "Measure out 3/4 cup dressing; pour dressing into a shallow bowl. Mix panko, shredded Parmesan, and dry ranch dressing mix in a separate shallow bowl."
    },
    {
      "position": 5,
      "text": "Dunk each chicken piece into the dill ranch dressing; allow excess dressing to drip off. Coat chicken pieces with panko mix. Place on the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, preferably on convection setting, until chicken is golden, no longer pink at the center, and juices run clear, 15 to 20 minutes. Serve with remaining dill pickle ranch dressing or reserve dressing for another use."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

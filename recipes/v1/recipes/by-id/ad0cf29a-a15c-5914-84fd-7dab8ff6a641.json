  "schema_version": 1,
  "id": "ad0cf29a-a15c-5914-84fd-7dab8ff6a641",
  "slug": "stuffed-chicken-parmesan-sub",
  "name": "Stuffed Chicken Parmesan Sub",
  "recipe_type": "main",
  "brief_description": "The classic flavors of chicken Parmesan and chicken cordon bleu combine in this sub sandwich that makes a hearty, decadent dinner.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice each chicken breast down the center to make 4 cutlets. Place each between 2 pieces of plastic wrap and pound to about 1/2 inch thinness with a meat mallet."
    },
    {
      "position": 2,
      "text": "Marinate chicken breasts in Italian dressing in the refrigerator overnight."
    },
    {
      "position": 3,
      "text": "Remove chicken to bring to room temperature 1 hour before cooking."
    },
    {
      "position": 4,
      "text": "Combine flour and baking powder in one bowl, milk and egg in another bowl, and bread crumbs in a third bowl. Set aside."
    },
    {
      "position": 5,
      "text": "Heat 1 tablespoon butter in a pan over medium heat. Cook prosciutto in the hot butter until it starts to brown, about 5 minutes. Transfer to a paper towel-lined plate."
    },
    {
      "position": 6,
      "text": "Bring marinara sauce to a simmer in a saucepan."
    },
    {
      "position": 7,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C). Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 8,
      "text": "Lay chicken cutlets out flat. Line 1/4 of mozzarella cheese down the center of each and sprinkle 1/4 of prosciutto over cheese. Fold cutlets in half over the stuffing and secure edges together with toothpicks."
    },
    {
      "position": 9,
      "text": "Dunk rolled chicken into the flour mixture, then egg mixture, and finally bread crumbs."
    },
    {
      "position": 10,
      "text": "Drop chicken into the preheated fryer and cook until crumbs are golden brown, chicken floats, and is no longer pink in the center, 6 to 7 minutes. Transfer to a paper towel-lined plate to let grease run off."
    },
    {
      "position": 11,
      "text": "Cut sub rolls down the centers and spread remaining butter into interiors. Assemble sandwiches in the following manner: bottom sub half, chicken cutlet, marinara, provolone cheese, Parmesan cheese, and top sub half. Transfer subs to a baking pan."
    },
    {
      "position": 12,
      "text": "Toast in the preheated oven until bread is crisp and cheeses are melted, about 2 minutes. Serve hot."
    }
  ],
  "servings": 8,

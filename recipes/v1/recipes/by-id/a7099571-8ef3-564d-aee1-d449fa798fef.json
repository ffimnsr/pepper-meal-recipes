  "id": "a7099571-8ef3-564d-aee1-d449fa798fef",
  "slug": "quick-veggie-ramen-stir-fry-recipe-11955780",
  "name": "Quick Veggie Ramen Stir-Fry",
  "recipe_type": "main",
  "brief_description": "This veggie ramen noodle stir-fry puts a delicious twist on fried rice by swapping in quick and easy ramen. Broccoli, onions, mushrooms, and egg are tossed with soy sauce-flavored noodles that fry up golden and crisp in the pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Add instant noodles and cook for 3 minutes. Drain noodles in a colander and run under cold water to stop the cooking. Shake off excess water."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat sesame oil, mushrooms, broccoli, and white part of green onion in a skillet over medium-high heat. Cook until browned, about 6 minutes. Turn heat off and set aside.."
    },
    {
      "position": 3,
      "text": "Drizzle olive oil over noodles and add 1 soy seasoning packet from the instant noodle package. Shake until noodles are evenly coated."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium-high heat. Add noodle mixture and for cook 4 minutes. Flip noodle mixture over and make a well in the center of noodles. Add egg, Cook until egg is set, about 4 minutes more."
    },
    {
      "position": 5,
      "text": "Using a spatula, chop up the egg. Add broccoli-mushroom mixture and stir until everything is combined. Cook 1 minute more."
    },
    {
      "position": 6,
      "text": "Transfer all to a serving dish and sprinkle with green part of green onions and toasted sesame seeds."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

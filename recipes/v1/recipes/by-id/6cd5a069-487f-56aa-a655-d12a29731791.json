  "id": "6cd5a069-487f-56aa-a655-d12a29731791",
  "slug": "nikkis-best-rhubarb-dessert-ever",
  "name": "Best Rhubarb Dessert Ever",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb dessert is a cobbler-style dessert that's delicious hot or cold. Even if you are not a big fan of rhubarb, you'll love this sweet dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix 3 cups flour and brown sugar in a large bowl; cut in softened butter with a knife or pastry blender until mixture resembles coarse crumbs. Reserve 1 \u00bd cups flour mixture; pat remainder into the bottom of prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust is lightly browned, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Beat eggs in a large bowl; mix 1/4 cup flour, white sugar, half-and-half, and salt into eggs, beating until smooth."
    },
    {
      "position": 5,
      "text": "Sprinkle chopped rhubarb over baked crust. Pour egg mixture over rhubarb; top with reserved flour mixture."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until eggs are set and lightly browned, 40 to 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "751d43d7-ff2b-577a-91a4-748dbe4b1552",
  "slug": "caramel-pull-aparts",
  "name": "Caramel Pull Aparts",
  "recipe_type": null,
  "brief_description": "Homemade caramel sauce and biscuit dough come together in this quick and easy caramel pull-aparts recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt\u00ae)."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, butter, milk, and cinnamon together in a saucepan over medium-low heat; cook and stir until caramel sauce is smooth, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle pecans in the bottom of the prepared pan; top with 1/2 of the caramel sauce. Layer biscuits over caramel sauce. Pour the remaining caramel sauce over biscuits."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cooked through, 20 to 30 minutes. Turn pan over onto a plate to serve."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

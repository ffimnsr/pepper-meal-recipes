  "slug": "lemon-ginger-cranberry-applesauce",
  "name": "Lemon Ginger Cranberry Applesauce",
  "recipe_type": "side",
  "brief_description": "Brighten up your Thanksgiving table with this cranberry applesauce featuring lemon and ginger.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir cranberries, apples, water, sugar, and lemonade concentrate together in a saucepan. Bring to a boil, stirring occasionally, and reduce heat to medium low."
    },
    {
      "position": 2,
      "text": "Stir ginger and salt into cranberry mixture and simmer until cranberries burst and apples are tender, 20 minutes. Chill in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,

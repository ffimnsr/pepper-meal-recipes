  "schema_version": 1,
  "id": "527a1bf5-b2b2-5bfa-b724-28df7cc06d77",
  "slug": "sous-vide-chicken-thighs",
  "name": "Sous Vide Chicken Thighs",
  "recipe_type": "main",
  "brief_description": "Cooking chicken thighs sous vide results in extremely juicy and tender chicken. Using chicken thighs with skin ensures you won't overcook the chicken when you sear it in the pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water. Place a sous vide immersion cooker into water and set temperature to 160 degrees F (71 degrees C) according to manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Combine salt, pepper, garlic powder, and paprika in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Place chicken thighs, skin-side down, on a cutting board. Carefully remove bone and any excess fat and flaps of skin. Sprinkle salt mixture over both sides of chicken, rubbing some under the skin. Tuck in sides of chicken to form original thigh shape, then place into 1 large or 2 small vacuum bags. Use a vacuum sealer to seal."
    },
    {
      "position": 4,
      "text": "Place the bag into preheated water and set the timer for 1 1/2 hours. When the timer is up, remove chicken from the bag and pat dry thoroughly with paper towels."
    },
    {
      "position": 5,
      "text": "Heat olive oil in a skillet over high heat. Sear chicken in hot oil, skin-side down, until nicely browned, about 1 minute. Move chicken around the skillet using tongs, holding chicken up against the side of the skillet to get an even brown color on all edges. Remove the skillet from heat and let sit for 2 to 3 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

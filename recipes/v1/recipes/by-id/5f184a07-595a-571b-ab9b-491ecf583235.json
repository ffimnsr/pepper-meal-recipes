  "id": "5f184a07-595a-571b-ab9b-491ecf583235",
  "slug": "moms-turkey-sausage-patties",
  "name": "Mom's Turkey Sausage Patties",
  "recipe_type": "dessert",
  "brief_description": "This easy recipe for turkey sausage patties adds ground ginger, sage, and cayenne pepper to make breakfast extra tasty. Great with pancakes and eggs!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground turkey, black pepper, salt, sage, ginger, and cayenne pepper together in a large bowl until well blended. Form mixture into 8 equal-sized patties."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium-high heat; coat with nonstick spray."
    },
    {
      "position": 3,
      "text": "Add patties and fry until browned on both sides and no longer pink in the center, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "a60669c3-adcb-5650-8641-c37deff4fc35",
  "slug": "potato-latkes-with-caramelized-pears-goat-cheese-and-sherry-vinegar-drizzle",
  "name": "Potato Latkes with Caramelized Pears, Goat Cheese, and Sherry Vinegar Drizzle",
  "recipe_type": "dessert",
  "brief_description": "Enjoy these traditional potato latkes topped with caramelized pears, goat cheese, and a drizzle of sherry vinegar.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Place shredded potatoes in cheesecloth and wring out any excess moisture."
    },
    {
      "position": 2,
      "text": "Mix potatoes, eggs, flour, onion, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Heat 1/2 cup oil in a large skillet over medium-high heat until oil shimmers. Working in batches, drop spoonfuls of the potato mixture into the hot oil, pressing each down to form a pancake. Cook latkes until browned and crisp, 3 to 5 minutes per side; transfer to paper towels to drain."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon oil in a separate skillet over medium-high heat. Cook pears in hot oil and sprinkle 2 tablespoons brown sugar over pears. Cook pears until browned and sugar is melted, 3 to 5 minutes per side."
    },
    {
      "position": 5,
      "text": "Place latkes on a serving platter. Top each latke with 1 round of goat cheese and a pear. Sprinkle brown sugar on the pears and drizzle sherry vinegar over the top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

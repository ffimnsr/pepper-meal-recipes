{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "743bdb6e-9f3a-5b9c-9069-eddac86a7fe8",
  "slug": "sous-vide-and-smoked-east-coast-pastrami",
  "name": "Sous Vide and Smoked East Coast Pastrami",
  "recipe_type": "main",
  "brief_description": "This sous vide pastrami is prepared with a combination of different cooking techniques such as brining, sous vide, and smoking. It's a crowd pleaser!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim off fat cap of brisket; poke some holes in meat with a paring knife."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a large pot on the stovetop. Remove from heat; as it starts to cool down, add white sugar, kosher salt, garlic, and pink curing salt."
    },
    {
      "position": 3,
      "text": "Find a food-grade, nonreactive container with a lid; pour in brine and ice, then add brisket. Keep brisket in brine for 5 to 7 days in the refrigerator. Flip brisket every 24 hours."
    },
    {
      "position": 4,
      "text": "After brining, pull brisket out of the container and rinse under cold water."
    },
    {
      "position": 5,
      "text": "Heat a pan over low heat. Toast coriander seeds, peppercorns, and mustard seeds in the hot pan, about 2 minutes. Remove and transfer to a food processor; add red pepper flakes, cloves, ginger, and bay leaves. Grind well."
    },
    {
      "position": 6,
      "text": "Use 1/2 of the spice mixture to coat brisket; seal in a food saver bag. Reserve remaining spice mixture. Place brisket in a sous vide at 137 degrees F (58 degrees C) for 18 hours."
    },
    {
      "position": 7,
      "text": "Remove from sous vide, cut open the bag, and brisket set out to dry and rest on a wire rack from a smoker for 30 minutes. Use remaining pickling spices to re-coat brisket."
    },
    {
      "position": 8,
      "text": "Place a wire rack in the smoker. Add wood chips according to manufacturer's directions and heat to 225 degrees F (107 degrees C)."
    },
    {
      "position": 9,
      "text": "Smoke brisket until browned, tender, and no longer pink in the center, about 5 hours. Pull brisket from the smoker and let rest for 15 minutes before slicing."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 1390,
  "preparation_time_minutes": 30,

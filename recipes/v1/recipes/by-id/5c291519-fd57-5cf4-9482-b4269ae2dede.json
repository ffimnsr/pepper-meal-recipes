  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5c291519-fd57-5cf4-9482-b4269ae2dede",
  "slug": "seven-layer-sliders-recipe-7500680",
  "name": "Seven Layer Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These seven layer sliders have everything you'd ever want in a burger - a rich flavorful burger served in Hawaiian rolls topped with homemade grilled pico, crunchy lettuce, jalapenos, guacamole, and cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Place tomatoes, onion and 1 jalapeno on the hot grill and cook, undisturbed, until grill marks form, about 2 minutes. Remove tomatoes and jalapeno and set aside to cool. Flip onion slice and cook for 1 more minutes. Remove from heat to cool slightly."
    },
    {
      "position": 3,
      "text": "Finely chop tomatoes, and onion. Remove seeds from jalapeno if desired and finely chop. Add chopped veggies to a bowl and stir in cilantro, lime juice, 1/2 teaspoon salt, and garlic powder. Set grilled pico de gallo aside. Reduce grill heat to medium-high."
    },
    {
      "position": 4,
      "text": "Combine sour cream, mayonnaise, and 1 tablespoon taco seasoning in a small bowl; mix well and set aside."
    },
    {
      "position": 5,
      "text": "Combine ground beef and remaining taco seasoning in a bowl and mix well. Form into 2 rectangular patties."
    },
    {
      "position": 6,
      "text": "Slice whole loaf of rolls in half and place each cut side down on the lightly oiled grill grate. Toast on the hot grill for 1 minute. Remove from heat and set on a cutting board."
    },
    {
      "position": 7,
      "text": "Place burger patties on the grill and cook for 4 minutes. Season top side with remaining 1/2 teaspoon salt and flip. Cook until desired degree of doneness, about 3 more minutes. Top each patty with cheese and cook until cheese is melted, 30 seconds more."
    },
    {
      "position": 8,
      "text": "Remove from heat and place on bottom half of toasted buns. Top cheese with guacamole, grilled pico de gallo, lettuce, and sliced jalapenoes. Spread desired amount of sour cream sauce on the cut side of the bun tops and reserve any remaining sauce to serve on the side."
    },
    {
      "position": 9,
      "text": "Invert the sauced buns on the top of the sliders."
    },
    {
      "position": 10,
      "text": "Cut into 12 sliders. Slice the remaining jalapeno thinly."
    },
    {
      "position": 11,
      "text": "Garnish each slider with an olive, a slice of jalapeno, and a toothpick."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,

  "id": "5a7a35d9-02be-5ecf-afbe-f7baec52c1f3",
  "slug": "mixed-berry-crostata",
  "name": "Mixed Berry Crostata",
  "recipe_type": "dessert",
  "brief_description": "Refrigerated pie dough is the base for this delicious crostata filled with fresh raspberries, blackberries, and blueberries.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line two small cookie sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Unroll pie crust dough rounds separately onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Mix together 1/4 cup sugar and flour in a bowl. Sprinkle 1/2 mixture on each dough round, leaving a 1-inch border."
    },
    {
      "position": 4,
      "text": "Divide and arrange raspberries, blackberries, and blueberries evenly on top of flour-sugar mixture on each dough round. Squeeze juice from 1/2 lemon over each berry mixture."
    },
    {
      "position": 5,
      "text": "Fold in 1-inch border of dough on each round, pleating as you move, in order to keep all the berry juices inside. Brush beaten egg onto the pleated crusts. Sprinkle both crusts and both berry mixtures with 1 tablespoon sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crusts are golden, about 25 minutes. Let cool for 10 minutes or serve warm."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

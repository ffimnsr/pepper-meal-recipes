  "id": "656e211a-1dfa-5a3b-b322-4760d9e31f82",
  "slug": "air-fryer-churros",
  "name": "Air Fryer Churros",
  "recipe_type": "dessert",
  "brief_description": "Air fryer churros are a delicious treat. Who doesn't love fried pastry sticks dusted with cinnamon sugar? These aren't fried but taste just as good!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a saucepan over medium-high heat. Stir in milk and salt. Reduce the heat to medium and bring to a boil, continuously stirring with a wooden spoon. Quickly add flour all at once and keep stirring until the dough comes together."
    },
    {
      "position": 2,
      "text": "Remove from the heat and let cool for 5 to 7 minutes. Mix in eggs with the wooden spoon until incorporated. Spoon dough into a pastry bag fitted with a large star tip. Pipe dough directly into the air fryer basket, making six equal strips."
    },
    {
      "position": 3,
      "text": "Air fry churros at 340 degrees F (175 degrees C) for 5 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, mix sugar and cinnamon together in a small bowl until well combined. Pour onto a shallow plate."
    },
    {
      "position": 5,
      "text": "Remove churros from the air fryer and roll in the cinnamon sugar to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

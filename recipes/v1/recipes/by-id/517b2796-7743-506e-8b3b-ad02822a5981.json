  "id": "517b2796-7743-506e-8b3b-ad02822a5981",
  "slug": "stick-of-butter-chicken-and-rice-recipe-11753461",
  "name": "Stick of Butter Chicken and Rice",
  "recipe_type": "main",
  "brief_description": "Stick of butter chicken and rice is the dinner you make when you don't feel like cooking. This delicious chicken-rice casserole could not be easier to put together and will surely land in your regular rotation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir rice, portobello mushrooms, beef consomme, and French onion soup together in a 9 x 13-inch baking dish. Top with butter pieces and 3/4 cup of the cheese."
    },
    {
      "position": 3,
      "text": "Season chicken evenly with salt, pepper, garlic powder, onion powder, and paprika and place on top of cheese and butter. Top with remaining cheese and cover dish with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 55 minutes. Uncover and bake until top is golden brown, liquid has been absorbed into the rice, and chicken is cooked through, about 20 to 30 more minutes. Sprinkle with fresh parsley if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 5,

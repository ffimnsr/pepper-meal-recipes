  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, celery, pickles, pickle brine, mayonnaise, sugar, onion powder, salt, and pepper in a bowl and stir until well combined and evenly coated. Refrigerate until ready to serve."
    }

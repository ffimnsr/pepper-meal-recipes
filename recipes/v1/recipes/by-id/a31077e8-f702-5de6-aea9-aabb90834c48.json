  "id": "a31077e8-f702-5de6-aea9-aabb90834c48",
  "slug": "christmas-punch",
  "name": "Christmas Rum Punch",
  "recipe_type": "drink",
  "brief_description": "This Christmas, make a delicious rum punch to serve the adult guests. With fruit slices floating in the serving bowl, it\u2019s quite a nice presentation!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a punch bowl, combine sugar, orange juice, and lemon juice; stir until sugar dissolves. Add cherries, triple sec, light rum, orange slices, lemon slices, and pineapple chunks. Refrigerate for 1 to 2 hours to allow flavors to blend."
    },
    {
      "position": 2,
      "text": "Just before serving, pour in carbonated water and add ice."
    }
  ],
  "servings": 20,

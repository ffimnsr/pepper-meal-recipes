  "id": "abea350d-1f67-50f2-97e8-d1236cfce911",
  "slug": "chef-johns-black-lentil-soup",
  "name": "Chef John's Black Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "Chef John\u2019s black lentil soup features a mixture of beluga lentils, aromatics, bacon, and spices that cook up into a thick, satisfying bowl of goodness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large pot over medium heat. Cook and stir bacon in hot oil until browned and crisp, 5 to 7 minutes. Add onion, carrots, celery, and salt; cook and stir until onion is softened and translucent, about 10 minutes. Season with black pepper, cumin, thyme, and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Pour lentils into bacon mixture and stir until completely coated in rendered bacon fat. Add chicken broth and bay leaf; bring to a simmer. Reduce the heat to low and cook, adding more chicken broth as needed, until lentils are tender, 45 minutes to 1 hour."
    },
    {
      "position": 3,
      "text": "Season with salt, black pepper, and cayenne pepper to taste. Stir in 3 tablespoons parsley."
    },
    {
      "position": 4,
      "text": "Ladle soup into bowls, sprinkle remaining parsley over top, and drizzle with extra-virgin olive oil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,

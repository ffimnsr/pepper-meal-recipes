  "id": "9e6772ce-d60f-554c-965d-6bc926e1dae0",
  "slug": "italian-tortellini-salad-recipe-7724664",
  "name": "Italian Tortellini Salad",
  "recipe_type": "salad",
  "brief_description": "This Italian tortellini salad is truly a delicious summertime pasta dish, but we enjoy it all year long. It's an easy make-ahead salad, perfect to pack for a picnic, take to a potluck, or serve at your next backyard BBQ. This makes 6 main course servings or 8 side dishes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, about 3 minutes. Be sure not to overcook, as they\u2019ll start to unfold. Drain well, cool to room temperature, and transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, mozzarella balls, cucumber, bell peppers, pepperoni, banana peppers, red onion, black olives, parsley, salt, and pepper in a separate bowl, and add to the tortellini."
    },
    {
      "position": 3,
      "text": "Drizzle Italian dressing over salad, lightly tossing all ingredients until well coated. Refrigerate for at least 1 hour before serving."
    },
    {
      "position": 4,
      "text": "Stir again right before serving, garnish with grated Parmesan, and serve chilled. Store leftovers in the fridge in an air-tight container."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

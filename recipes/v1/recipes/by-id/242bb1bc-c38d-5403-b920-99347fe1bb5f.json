  "id": "242bb1bc-c38d-5403-b920-99347fe1bb5f",
  "slug": "baked-apple-doughnuts",
  "name": "Baked Apple Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "This easy baked apple doughnut recipe features pieces of juicy apple to create a moist interior, paired with a cinnamon sugar crust for a tasty fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two mini doughnut pans."
    },
    {
      "position": 2,
      "text": "Combine flour, 1 cup sugar, baking powder, salt, nutmeg, and 1 teaspoon cinnamon in a large bowl using a fork until combined. Mix in shortening until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Combine apples, milk, and eggs in a separate bowl. Stir into flour mixture until just blended. Spoon batter into the prepared doughnut pans."
    },
    {
      "position": 4,
      "text": "Bake doughnuts in the preheated oven until slightly browned on the bottoms, about 10 minutes. Invert carefully onto a wire rack. Let cool completely."
    },
    {
      "position": 5,
      "text": "Meanwhile, place melted butter in a shallow bowl. Mix 1 cup sugar and 2 teaspoons cinnamon together in another shallow bowl. Dip cooled doughnuts in butter. Coat with sugar mixture."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

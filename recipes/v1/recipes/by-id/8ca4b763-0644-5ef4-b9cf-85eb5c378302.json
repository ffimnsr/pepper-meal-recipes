  "id": "8ca4b763-0644-5ef4-b9cf-85eb5c378302",
  "slug": "roast-pumpkin-and-feta-risotto",
  "name": "Roast Pumpkin and Feta Risotto",
  "recipe_type": "dessert",
  "brief_description": "This tasty pumpkin and feta risotto dish combines the sweetness of roasted pumpkin and salty taste of feta cheese to create a sensational risotto.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Brush a baking dish with olive oil."
    },
    {
      "position": 2,
      "text": "Place pumpkin in a steamer over 1 inch of boiling water, and cover. Cook until tender but still firm. Transfer pumpkin to baking dish, and brush with oil. Season with salt and pepper. Bake in the preheated oven until golden brown."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a saucepan. Cook onion and garlic until tender."
    },
    {
      "position": 4,
      "text": "Stir in rice, and cook for 1 to 2 minutes. Slowly add vegetable broth 1/2 cup at a time, stirring frequently and allowing all the liquid to be absorbed before adding more broth. Continue cooking until the rice is tender to the tooth, and then season with salt and pepper to taste."
    },
    {
      "position": 5,
      "text": "When roasted pumpkin is almost done, place feta on a baking sheet, and bake in preheated oven until the cheese is hot, and is beginning to melt along the edges."
    },
    {
      "position": 6,
      "text": "Mash 1/2 of the pumpkin, and stir into risotto with spinach. Ladle risotto into bowls, and top with remaining pumpkin cubes and heated feta."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

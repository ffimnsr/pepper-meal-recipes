  "id": "6608d96c-6439-51fb-b5b2-714f0e413ce5",
  "slug": "5-minute-french-dip-sandwiches-recipe-11892889",
  "name": "5 Minute French Dip Sandwiches",
  "recipe_type": "soup",
  "brief_description": "These 5 minute French dip sandwiches also only require 5 ingredients. Canned consomme and French onion soup make the jus for dipping a snap, and a quick broil prepares the sandwich rolls. They'll be on the table in no time, and they are so delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven\u2019s broiler to Low Broil. Place 2 half slices cheese on each half of each roll. Place hoagie rolls on a baking sheet."
    },
    {
      "position": 2,
      "text": "Broil in the center of the oven until cheese is melted."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat beef consomme, French onion soup, and water in a saucepan over medium heat until just simmering. Add beef until just heated through, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove roast beef from soup, allowing any excess liquid to drip back into the saucepan; divide meat evenly among hoagie rolls."
    },
    {
      "position": 5,
      "text": "Divide soup into 4 dipping bowls and serve sandwiches with jus."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

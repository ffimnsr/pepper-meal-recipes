  "slug": "avocado-mango-salsa",
  "name": "Avocado Mango Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This refreshing mango avocado salsa with fiery habanero chile pepper, red onion, lime juice, and cilantro is a magnificent summer appetizer or side.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place avocado in a serving bowl and mix with lime juice."
    },
    {
      "position": 3,
      "text": "Add mango, onion, habanero, cilantro, and salt; toss until evenly combined."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

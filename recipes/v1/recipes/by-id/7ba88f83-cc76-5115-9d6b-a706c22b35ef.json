  "slug": "polynesian-watermelon-drink-otai",
  "name": "Polynesian Watermelon Drink ('Otai)",
  "recipe_type": "drink",
  "brief_description": "Grate a fresh watermelon and mix it with canned crushed pineapple, flaked coconut, and evaporated milk for a refreshing taste of Polynesia.",
  "cuisine": "Oceanic",
  "instructions": [
    {
      "position": 1,
      "text": "Grate watermelon with a fork from the rind into a large bowl, leaving no large chunks. Stir water, pineapple, evaporated milk, and coconut into the grated watermelon. Add sugar; stir until dissolved. Squeeze lime juice into the watermelon mixture."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8fc2c236-b37c-5cc7-9360-2f96fe4297a3",
  "slug": "red-devil-cocktail-meatballs-recipe-11823558",
  "name": "Red Devil Cocktail Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's fiery red devil cocktail meatballs are enveloped in a sticky, sweet, tangy, spicy sauce. They're garnished with white and black sesame seeds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beef and pork in a bowl, and use a fork to gently break up and mix meat together until evenly combined."
    },
    {
      "position": 2,
      "text": "Add egg, milk, salt, black pepper, onion powder, garlic powder, cayenne, and breadcrumbs. Continue mixing with a fork just until everything is evenly combined. Cover, and refrigerate for about 1 hour before using if possible."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Line a sheet pan with foil and lightly grease with 1 teaspoon of vegetable oil."
    },
    {
      "position": 4,
      "text": "Transfer tablespoon sized portions of meat mixture onto the sheet pan. Dampen hands with water and roll the portions into balls, spacing evenly as you do."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until meatballs are lightly browned, 10 to 12 minutes. Set aside while you make the sauce."
    },
    {
      "position": 6,
      "text": "For sauce, add gochujang, rice vinegar, soy sauce, Sriracha, maple syrup, and water to a saucepan and place over medium-high heat. Whisk to combine while sauce comes to a simmer. Reduce heat to medium, and cook until sauce begins to thicken, just a few minutes."
    },
    {
      "position": 7,
      "text": "Transfer the meatballs in, and cook, stirring occasionally, until meatballs are heated through, and sauce has thickened to your liking. Serve immediately with toothpicks. Garnish these fiery meatballs with white and black sesame seeds to represent sparks and ash."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

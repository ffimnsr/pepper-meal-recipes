  "id": "134f16aa-2921-5053-b4ba-1bbb06b5d10d",
  "slug": "tea-punch",
  "name": "Tea Punch",
  "recipe_type": "drink",
  "brief_description": "A different twist to a standard punch. Brewed tea is mixed with orange juice, pineapple juice, lemonade and ginger ale.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a pitcher, combine sugar and tea. Stir until sugar is dissolved. Stir in orange juice, pineapple juice and lemonade. Chill in refrigerator for 4 hours."
    },
    {
      "position": 2,
      "text": "Just before serving, pour chilled juice mixture into a punch bowl and stir in ginger ale."
    }
  ],
  "servings": 24,

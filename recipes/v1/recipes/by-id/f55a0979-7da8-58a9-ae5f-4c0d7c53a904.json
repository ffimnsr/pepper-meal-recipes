  "id": "f55a0979-7da8-58a9-ae5f-4c0d7c53a904",
  "slug": "garlic-kale-with-pancetta-recipe-11866575",
  "name": "Garlic Kale with Pancetta",
  "recipe_type": "side",
  "brief_description": "This garlic kale with pancetta is a very tasty way to get more greens in your diet. I have used kale, but you can use any combination of sturdy greens you like and it will be delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in an oven-safe skillet. Add pancetta and onion; cook and stir for about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in garlic and cook just until fragrant, about 1 minute. Add kale and chicken broth and season with salt and pepper. Stir and cook until kale is slightly wilted, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Spread the mixture evenly over the bottom of the skillet. Sprinkle evenly with Parmesan and panko."
    },
    {
      "position": 4,
      "text": "Turn on the oven\u2019s broiler, and place skillet in the oven until panko is lightly toasted. Serve warm."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

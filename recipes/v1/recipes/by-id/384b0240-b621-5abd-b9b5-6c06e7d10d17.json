  "id": "384b0240-b621-5abd-b9b5-6c06e7d10d17",
  "slug": "first-prize-strawberry-rhubarb-crisp",
  "name": "Rhubarb and Strawberry Crisp",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb and strawberry crisp recipe makes a buttery oat crust that's topped with sweet strawberries and rhubarb to create a delightful dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix oats, flour, brown sugar, and butter together in a bowl; press mixture into the bottom of a 9-inch pie pan. Top with strawberries and rhubarb."
    },
    {
      "position": 3,
      "text": "Stir water, white sugar, and cornstarch together in a saucepan. Bring to simmer, constantly whisking, until mixture bubbles and thickens; pour over fruit layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbling, about 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

  "id": "ac552f8a-14c3-5327-a588-4876bb654430",
  "slug": "yummy-pecan-pralines",
  "name": "Yummy Pecan Pralines",
  "recipe_type": "dessert",
  "brief_description": "In this yummy pecan pralines recipe, pecans are cooked to the soft ball stage with brown sugar, white sugar, evaporated milk, and butter for chewy candies.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Generously grease a large slab or baking sheet."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, white sugar, and milk in a medium saucepan over medium heat; bring to a boil. Stir in pecans, butter, and vanilla; heat, without stirring, to between 234 and 240 degrees F (112 to 116 degrees C) or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from water and placed on a flat surface. Remove the saucepan from heat; cool syrup for 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat pecan-sugar mixture until thickened, then immediately pour onto the prepared surface; let rest until firm. Completely cool before cutting."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

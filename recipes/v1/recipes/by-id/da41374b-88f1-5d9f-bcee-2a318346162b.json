  "slug": "cheesy-lasagna-sheet-pasta-recipe-11703403",
  "name": "Cheesy Lasagna Sheet Pasta",
  "recipe_type": "main",
  "brief_description": "This 3 ingredient cheesy lasagna sheet pasta could not be easier. Serve topped with Parmesan cheese, red pepper flakes, and freshly cracked black pepper if you like.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook lasanga noodles in the boiling water, stirring occasionally, until tender yet firm to the bite, 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Strain noodles and return to the pot. Add tomato sauce and cook on medium heat until sauce is heated through, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add cheese and stir until cheese is melted. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

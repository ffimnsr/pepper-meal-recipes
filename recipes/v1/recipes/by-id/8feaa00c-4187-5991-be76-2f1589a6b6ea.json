  "id": "8feaa00c-4187-5991-be76-2f1589a6b6ea",
  "slug": "soft-pretzel-bites",
  "name": "Soft Pretzel Bites",
  "recipe_type": "snack",
  "brief_description": "These homemade soft pretzel bites can be customized with any topping and paired with the dipping sauce of your choice!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 1/2 cups water, butter, brown sugar, yeast, and salt in the bowl of a stand mixer fitted with the hook attachment. Mix until well combined. Let sit for about 5 minutes."
    },
    {
      "position": 2,
      "text": "Turn mixer on low speed and add 4 cups flour, 1 cup at a time. Add additional 1/2 cup flour if dough appears sticky. Increase speed to medium and knead until dough is smooth and pulls away from the sides of the bowl, 4 to 5 minutes. Sprinkle in more flour if dough still seems a little tacky."
    },
    {
      "position": 3,
      "text": "Oil a large mixing bowl. Add the ball of dough. Cover with plastic wrap and let rise in a warm place for about 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a sheet pan with cooking spray."
    },
    {
      "position": 5,
      "text": "Bring 3 quarts water to a boil in a large saucepan. Slowly add baking soda and return to a boil."
    },
    {
      "position": 6,
      "text": "Meanwhile, remove dough from the bowl, flatten into a disc shape, and cut into 8 wedges. Roll each wedge into a 24-inch rope. Cut each rope into 1-inch pieces."
    },
    {
      "position": 7,
      "text": "Drop batches of dough pieces into the boiling water for about 35 seconds. Remove to the prepared sheet pan. Beat egg with 1 tablespoon water; brush over the tops of each boiled dough piece. Repeat with remaining dough."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden brown, 14 to 16 minutes. Cool slightly before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

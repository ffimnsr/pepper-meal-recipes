  "schema_version": 1,
  "id": "4d526605-2ae1-5483-99a6-0675717405e5",
  "slug": "smoked-prime-rib-roast",
  "name": "Smoked Prime Rib Roast",
  "recipe_type": "main",
  "brief_description": "This smoked prime rib is seasoned with herb oil and smoked over hickory wood chips until tender for the ultimate centerpiece fit for any special occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Sprinkle salt over entire roast; wrap roast in plastic wrap. Refrigerate for 4 hours to overnight."
    },
    {
      "position": 3,
      "text": "Combine olive oil, black pepper, garlic powder, rosemary, thyme, onion powder, paprika, and cayenne pepper in a bowl. Set aside for flavors to blend, about 1 hour."
    },
    {
      "position": 4,
      "text": "Pour 3/4 of the oil mixture over roast; massage into the top and sides of meat. Flip roast; pour remaining oil mixture over roast and massage. Place roast on a plate and refrigerate for at least 1 hour or up to 12 hours."
    },
    {
      "position": 5,
      "text": "Preheat the smoker to 225 degrees F (110 degrees C) to 230 degrees F (107 degrees C). Add hickory or pecan wood chips to the smoker. Insert an oven-safe meat thermometer into the thickest part of roast. Place roast into the smoker and cook until medium-rare, 3 to 3 \u00bd hours. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove roast from smoker and preheat the grill to its highest setting or preheat the oven to 500 degrees F (260 degrees C) to 550 degrees F (288 degrees C). Grill prime rib or roast in the preheated oven until crust is crunchy, producing a reverse sear, about 5 to 10 minutes. Allow roast to rest for 10 to 15 minutes before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 10,

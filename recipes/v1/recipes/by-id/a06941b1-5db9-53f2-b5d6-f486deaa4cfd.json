  "id": "a06941b1-5db9-53f2-b5d6-f486deaa4cfd",
  "slug": "rice-waffles",
  "name": "Rice Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These rice waffles are made with rice flour, tapioca starch, and almond flour and can be enjoyed by brunch fans who avoid wheat and gluten in their diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl with an electric mixer until stiff peaks form."
    },
    {
      "position": 3,
      "text": "Beat egg yolks in a separate bowl using a hand beater. Add rice milk, rice flour, tapioca starch, oil, almond meal, sugar, baking powder, vanilla, and salt; beat just until batter is smooth. Fold in stiff egg whites until incorporated."
    },
    {
      "position": 4,
      "text": "Grease the preheated waffle iron with cooking spray. Portion batter into the waffle iron, cover, and cook until waffles are golden brown and the iron stops steaming, about 5 minutes per waffle."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

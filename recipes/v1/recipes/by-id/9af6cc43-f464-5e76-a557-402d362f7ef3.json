  "id": "9af6cc43-f464-5e76-a557-402d362f7ef3",
  "slug": "roasted-onions",
  "name": "Roasted Onions",
  "recipe_type": "side",
  "brief_description": "A simple baked onion has so much flavor. Enjoy these easy roasted beauties with tasty, caramelized surfaces for a delicious side to any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Adjust the oven rack to the lowest position; preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Peel onions and cut in half."
    },
    {
      "position": 3,
      "text": "Toss onion halves with oil and season generously with salt and pepper."
    },
    {
      "position": 4,
      "text": "Place onions, cut-sides down, on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven until onions are tender and the cut surfaces are golden brown, 25 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and adjust seasonings if necessary. Drizzle with balsamic vinegar to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

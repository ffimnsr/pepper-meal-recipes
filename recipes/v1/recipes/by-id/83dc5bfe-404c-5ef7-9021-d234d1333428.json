  "id": "83dc5bfe-404c-5ef7-9021-d234d1333428",
  "slug": "zucchini-noodle-shrimp-scampi",
  "name": "Zucchini Noodle Shrimp Scampi",
  "recipe_type": "main",
  "brief_description": "Swap out linguine for zoodles in this tasty Shrimp Scampi recipe that uses zucchini noodles for an easy dinner full of bright lemon flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make zucchini noodles using a spiralizer or julienne peeler."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Pour in olive oil. Add shallot; cook and stir until tender, 4 to 5 minutes. Add minced garlic; cook until golden, about 2 minutes. Stir in wine and lemon juice; cook until sauce is reduced by almost half, about 3 minutes. Add shrimp, salt, and black pepper. Cook until shrimp turn pink, 2 to 3 minutes. Transfer shrimp to serving plate."
    },
    {
      "position": 3,
      "text": "Stir zucchini noodles into skillet. Season with salt and black pepper. Cook until noodles are tender, 4 to 6 minutes. Return shrimp to the skillet. Stir in parsley and Parmesan cheese before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e508a45a-794d-53d0-b96d-8e75f0847090",
  "slug": "pepperoni-cheese-balls",
  "name": "Pepperoni Cheese Balls",
  "recipe_type": "appetizer",
  "brief_description": "A delicious cheese ball that combines sour cream, butter, cream cheese, and Worcestershire sauce with finely chopped pepperoni. Try it with crackers or pretzels.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place pepperoni slices in a food processor or blender, and pulse until finely chopped. Set aside."
    },
    {
      "position": 2,
      "text": "In a bowl, stir together cream cheese, Worcestershire sauce, butter, and sour cream. Mix well with a mixer. Add chopped pepperoni, and mix well. Form into small balls, place on a serving platter, and refrigerate."
    }
  ],

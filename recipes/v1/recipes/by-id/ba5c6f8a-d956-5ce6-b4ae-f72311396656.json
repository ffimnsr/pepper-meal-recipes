  "id": "ba5c6f8a-d956-5ce6-b4ae-f72311396656",
  "slug": "no-bake-peanut-butter-pretzel-toffee-bars-recipe-12019217",
  "name": "No-Bake Peanut Butter Pretzel Toffee Bars",
  "recipe_type": "dessert",
  "brief_description": "Peanut butter pretzel toffee bars are an easy, no-bake, protein-packed dessert. These craveable bars get plenty of crunch from pretzels and toffee bits, with just the right amount of salt to balance the sweet chocolate and creamy peanut butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 9x9-inch square baking pan with cooking spray. Line with parchment paper and press down to stick. Set aside."
    },
    {
      "position": 2,
      "text": "Measure out 2 cups pretzels, then place in a food processor and pulse a few times to crush into medium-sized crumbs. Alternatively, place pretzels in a 1-gallon plastic bag and pound into pieces."
    },
    {
      "position": 3,
      "text": "Add pretzels, melted butter, confectioner\u2019s sugar, and 1 cup peanut butter to a bowl. Stir well until pretzel crumbs are fully coated. Pour into the prepared pan; use the back of a spoon to smooth into an even layer."
    },
    {
      "position": 4,
      "text": "Add chocolate chips, remaining peanut butter, and half the toffee bits to a microwave-safe bowl. Melt in the microwave, stirring every 30 seconds until melted. Pour over pretzel layer and smooth the top. Sprinkle with remaining toffee bits and some additional crushed pretzels, if desired."
    },
    {
      "position": 5,
      "text": "Chill for at least 1 hour or up to overnight. Cut into bars to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "6a0c23af-2bdb-5646-8519-c87eb4381388",
  "slug": "heavenly-halibut",
  "name": "Heavenly Halibut",
  "recipe_type": "main",
  "brief_description": "A quick and easy broiled halibut recipe includes a rich cheesy topping that pairs perfectly with mild-flavored halibut for a heavenly weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven\u2019s broiler. Grease a rimmed baking sheet; place halibut fillets on the sheet."
    },
    {
      "position": 2,
      "text": "Broil in the preheated oven until fish flakes easily with a fork, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix Parmesan cheese, butter, mayonnaise, green onions, lemon juice, salt, and hot pepper sauce in a bowl."
    },
    {
      "position": 4,
      "text": "Remove fillets from the oven; spread Parmesan mixture over top. Return to the oven and broil until topping is bubbly and lightly browned, about 2 more minutes."
    },
    {
      "position": 5,
      "text": "Garnish with fresh herbs and lemon slices, if desired. Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

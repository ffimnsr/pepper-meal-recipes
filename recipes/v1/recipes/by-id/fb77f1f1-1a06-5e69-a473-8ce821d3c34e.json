  "id": "fb77f1f1-1a06-5e69-a473-8ce821d3c34e",
  "slug": "easy-tuna-pasta-bake",
  "name": "Easy Tuna Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This tuna pasta bake with penne pasta and Parmesan cheese is a great midweek dinner option that\u2019s easy to make yet deliciously creamy and comforting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an oven-proof baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain and toss pasta with olive oil."
    },
    {
      "position": 3,
      "text": "While pasta is cooking, melt butter in a large saucepan over medium heat. Add onion and cook, stirring frequently, until soft and translucent, about 5 minutes. Add tuna and cook for 2 minutes. Pour in heavy cream; season with nutmeg, salt, and pepper. Add penne and toss well. Transfer to the prepared baking dish and cover with Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

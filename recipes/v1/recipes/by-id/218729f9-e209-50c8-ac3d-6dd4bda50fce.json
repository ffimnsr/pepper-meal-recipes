  "id": "218729f9-e209-50c8-ac3d-6dd4bda50fce",
  "slug": "perfect-crab-stuffed-mushrooms",
  "name": "Perfect Crab-Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Button mushrooms stuffed with crab and Monterey Jack cheese make a delicious bite-size appetizer. Your guests are sure to be dazzled!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a skillet; cook and stir green onion until softened, about 2 minutes. Transfer green onion to a bowl. Stir in crabmeat, bread crumbs, 1/4 cup Monterey Jack cheese, egg, lemon juice, and dill weed until well mixed."
    },
    {
      "position": 3,
      "text": "Pour 1/2 cup melted butter in a 9x13-inch baking dish; turn mushroom caps in butter to coat. Fill mushroom caps with the crab mixture and sprinkle with remaining 1/2 cup Monterey Jack cheese. Pour white wine into baking dish."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until cheese is melted and lightly brown, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

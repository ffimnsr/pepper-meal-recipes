  "id": "e28d1795-7b3e-50c5-9e99-61194f674459",
  "slug": "slow-cooker-risotto",
  "name": "Slow Cooker Risotto",
  "recipe_type": "soup",
  "brief_description": "This crockpot risotto is made with Arborio rice, chicken broth, olive oil, garlic, and wine in a slow cooker for a no-fuss, Italian-inspired dinner.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir broth, rice, olive oil, wine, garlic, onion flakes, salt, and black pepper together in a slow cooker until well combined."
    },
    {
      "position": 2,
      "text": "Cover and cook on High until rice is tender and creamy, 2 to 2 1/2 hours."
    },
    {
      "position": 3,
      "text": "Stir in Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Cook, uncovered, until cheese is melted, about 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 10,

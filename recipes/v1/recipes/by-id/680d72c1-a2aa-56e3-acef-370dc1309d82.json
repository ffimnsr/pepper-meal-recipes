  "slug": "citrus-salad",
  "name": "Citrus Salad",
  "recipe_type": "salad",
  "brief_description": "Fresh summer fruit and lettuce salad made fast and easy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place lime slices, tangerine sections, navel orange, and grapefruit in a bowl. In a separate bowl, mix the lime zest, mandarin orange zest, shallots, lemon juice, olive oil, and salt. Pour over the fruit. Arrange dressed fruit atop romaine lettuce to serve."
    }
  ],

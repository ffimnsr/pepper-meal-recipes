  "id": "07f4467c-77c3-5f84-b52c-0380c895e66a",
  "slug": "farmers-market-martini-recipe-12036487",
  "name": "Farmers Market Martini",
  "recipe_type": "appetizer",
  "brief_description": "This farmers market martini is freshened up with a tomato basil puree. It\u2019s incredibly refreshing, and a perfect cocktail for summer parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomatoes, cucumbers if using, basil leaves, pepperoncini juice, sugar and salt in a blender or food processor. Puree until smooth."
    },
    {
      "position": 2,
      "text": "Strain puree using a fine mesh strainer, over a mixing bowl. Keep the liquid and discard remaining flesh."
    },
    {
      "position": 3,
      "text": "Add ice, gin, vermouth, and 2 ounces of the tomato liquid to a cocktail shaker. Shake until the outside of the shaker is frosted, about 30 seconds; pour into two martini glasses. Garnish with cherry tomatoes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "slug": "bunny-mary-recipe-8739310",
  "name": "Bunny Mary",
  "recipe_type": "appetizer",
  "brief_description": "The Bunny Mary is a twist on a Bloody Mary, made with carrot juice rather than tomato juice, but with all the other ingredients found in the original drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place celery seed on a plate. Moisten the rim of a glass with a lime wedge. Dip rim in celery seed until coated. Set aside."
    },
    {
      "position": 2,
      "text": "Fill a shaker with ice. Add carrot juice, vodka, lime juice, Worcestershire sauce, Tabasco, and horseradish. Shake until well combined. Pour into the prepared glass."
    }
  ],

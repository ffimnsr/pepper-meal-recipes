  "id": "9940d7d8-0ac1-5596-aacb-8bb6372f0506",
  "slug": "cranberry-pomegranate-sauce",
  "name": "Cranberry Pomegranate Sauce",
  "recipe_type": "dessert",
  "brief_description": "This is a delicious fruit-filled version of cranberry sauce. The pomegranate is cooked separately to facilitate seed removal, then both parts are combined to finish cooking. It's wonderful as an accompaniment for poultry, and can be made into a lovely trifle-type dessert with vanilla pudding and pound cake.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Peel and core apples, and put peelings and cores in a small saucepan with pomegranate seeds, 1/2 cup juice, and 1/2 cup sugar. Bring to a boil, and then reduce heat to simmer. Cook for 30 minutes."
    },
    {
      "position": 2,
      "text": "Chop the peeled apples, and place in a large saucepan. Remove zest from half of one orange, chop very fine, and add to apples. Peel oranges, chop coarsely, and add to pan along with cranberries and remaining juice and sugar. Bring to a boil, reduce heat to simmer, and cook for 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove small pan from heat, and strain juice into larger pan. Cool solids slightly, and then push though a sieve to remove seeds and peels, adding remaining pulp to larger pan. Stir in nuts, if desired. Cook about 10 minutes longer. Serve warm, room temperature, or chilled."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

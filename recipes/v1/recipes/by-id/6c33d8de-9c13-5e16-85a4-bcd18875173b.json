  "id": "6c33d8de-9c13-5e16-85a4-bcd18875173b",
  "slug": "green-beans-almondine",
  "name": "Green Beans Almondine",
  "recipe_type": "side",
  "brief_description": "Green beans almondine is a delicious French side dish of buttery green beans with garlic topped with toasted almonds for an elegant addition to any meal.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place beans into a microwave-safe casserole dish with enough water to cover the bottom. Microwave on high power until almost tender, 8 to 10 minutes. Drain in a colander and refresh under cold running water to keep them bright green in color."
    },
    {
      "position": 3,
      "text": "Heat a frying pan over medium heat. Add almonds and cook until just starting to turn golden, about 3 to 5 minutes, watching closely so as to not burn."
    },
    {
      "position": 4,
      "text": "Take pan off of heat and add butter to melt. Return to heat and add garlic. Mix in green beans, season with salt and pepper, and continue to stir until heated through, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

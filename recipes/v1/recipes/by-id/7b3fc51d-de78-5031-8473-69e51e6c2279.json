  "id": "7b3fc51d-de78-5031-8473-69e51e6c2279",
  "slug": "garlic-butter-steak-bites-recipe-11908362",
  "name": "Garlic Butter Steak Bites",
  "recipe_type": "appetizer",
  "brief_description": "These garlic butter steak bites will be gone in minutes. Garlicky, buttery, and so flavorful, they're the perfect weekend meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat steak dry and season with 1 tablespoon oil, salt, pepper, garlic powder, and smoked paprika."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a skillet, sear half the steak for 2 minutes per side until browned, and remove to a plate. Repeat with remaining steak cubes. Remove to a plate."
    },
    {
      "position": 3,
      "text": "For garlic butter, lower heat to medium. Add butter to the skillet. Once melted, stir in garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 4,
      "text": "Return steak bites to the skillet; toss steak bites in garlic butter. Spoon sauce over steak while tossing."
    },
    {
      "position": 5,
      "text": "Sprinkle with parsley. Serve with your favorite sides. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "4dd12fc0-7ba8-5fe1-9b9e-5ae63c9feea7",
  "slug": "thai-beef-fried-rice",
  "name": "Thai Beef Fried Rice",
  "recipe_type": "main",
  "brief_description": "This fried rice made with ground beef is Thai home cooking at its best with a delicious flavor from soy sauce, fish sauce, and fresh tomatoes.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Warm vegetable oil and sesame oil in a wok or large skillet. Add bell pepper, onion, and green onion; cook for 2 minutes. Add ground beef, sprinkle garlic powder over mixture, and cook for 1 minute longer."
    },
    {
      "position": 2,
      "text": "Stir in diced tomato, fish sauce, and soy sauce; saute for 2 minutes. Add rice, mix until combined, and cook until heated through, 7 to 10 minutes. Season with salt and pepper and squeeze lime wedged over top."
    },
    {
      "position": 3,
      "text": "Pour beaten egg into a separate, small pan and let cook for 30 seconds. Lift the edges of the omelet so that any uncooked egg runs under the cooked edges and comes into contact with the hot skillet. Shake and tilt the skillet to move the uncooked egg. Repeat until the top is set, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Divide rice into two portions and serve 1/2 of the omelet over each serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "81c08ba2-630f-5c5a-9185-376bf4372824",
  "slug": "marry-me-butter-beans-recipe-11955860",
  "name": "Marry Me Butter Beans",
  "recipe_type": "side",
  "brief_description": "These marry me butter beans are a high protein, high fiber, one-pot dish with a Mediterranean-style twist. Beans simmer in a rich sauce with Parmesan cheese, cream, sun-dried tomatoes, and spinach. Serve with some crusty bread chunks to dip into the flavorful sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet or pot, heat olive oil over medium heat. Stir in garlic and red pepper flakes, and saute until fragrant, 30 seconds to 1 minute. Add sun-dried tomatoes, tomato paste, oregano, and stir until well combined."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low, gently stir in butter beans and vegetable broth, and simmer for 5 to 7 minutes, stirring occasionally. Stir in baby spinach, and cook until spinach is wilted, 2 minutes more."
    },
    {
      "position": 3,
      "text": "Turn off heat, and move pot to a cool burner. Gently stir in cream and Parmesan until fully incorporated. Season with salt and pepper, garnish with basil or parsley, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

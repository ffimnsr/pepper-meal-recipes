  "id": "59add0d5-80fb-5057-8be9-0598ade42b04",
  "slug": "pistachio-crusted-rack-of-lamb",
  "name": "Pistachio-Crusted Rack of Lamb",
  "recipe_type": "dessert",
  "brief_description": "Serve Chef John's pistachio-crusted rack of lamb for special occasions. Sweet pistachios, spicy Dijon, and crunchy bread crumbs add nice taste and texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Generously season each rack of lamb with herbes de Provence, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large skillet over high heat. Place lamb into the skillet and cook until browned on all sides, 6 to 8 minutes. Transfer to the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Stir pistachios, bread crumbs, melted butter, and olive oil together in a small bowl; season with salt and pepper. Spread mustard over the fatty side of lamb, then press pistachio mixture into mustard."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is golden and lamb is pink in the center, 20 to 25 minutes. An instant-read thermometer inserted into the center should read at least 130 degrees F (54 degrees C) for medium doneness."
    },
    {
      "position": 6,
      "text": "Transfer lamb to a plate and let rest for 10 minutes before slicing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bf350944-6f15-5064-bb7f-dbaf302a8257",
  "slug": "classic-bisquick-peach-cobbler",
  "name": "Bisquick Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This Bisquick peach cobbler is a delicious old-fashioned dessert that's easy to make with canned or fresh juicy peaches and baking mix batter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together Bisquick mix, milk, and nutmeg in an ungreased 8x8-inch baking dish until batter is smooth."
    },
    {
      "position": 3,
      "text": "Stir in melted butter until blended."
    },
    {
      "position": 4,
      "text": "Stir together peaches and sugar in a large bowl until combined; spoon over batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, 50 to 60 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

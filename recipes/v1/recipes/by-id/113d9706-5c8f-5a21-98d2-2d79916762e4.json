  "id": "113d9706-5c8f-5a21-98d2-2d79916762e4",
  "slug": "melt-in-your-mouth-blueberry-cake",
  "name": "Melt in Your Mouth Blueberry Cake",
  "recipe_type": "dessert",
  "brief_description": "This blueberry cake recipe makes a super moist, tender cake bursting with delicious blueberry flavor \u2014 a lovely treat to take along to a summer picnic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8-inch pan."
    },
    {
      "position": 2,
      "text": "Beat butter and 1/2 cup sugar together in a large bowl with an electric mixer until soft and fluffy; mix in vanilla and salt. Add egg yolks and beat until creamy."
    },
    {
      "position": 3,
      "text": "Combine 1 \u00bd cups flour and baking powder in a bowl; add alternately with milk to creamed mixture."
    },
    {
      "position": 4,
      "text": "Toss blueberries with 1 tablespoon flour in a small bowl. Add to the batter and fold in gently."
    },
    {
      "position": 5,
      "text": "Beat egg whites in a separate bowl until soft peaks form. Add remaining 1/4 cup of sugar, 1 tablespoon at a time, and beat until stiff peaks form. Fold egg whites into cake batter."
    },
    {
      "position": 6,
      "text": "Pour batter into the prepared pan. Sprinkle remaining 1 tablespoon sugar over top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, about 50 minutes."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "1bb23ca8-f8ef-56c2-bb17-b8c8695ccdb8",
  "slug": "skinny-cosmopolitan",
  "name": "Skinny Cosmopolitan",
  "recipe_type": "drink",
  "brief_description": "This skinny cosmo recipe reduces calories by relying on the aromatic oils in citrus zest instead of the usual Triple Sec liqueur.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Muddle lemon and orange zest with sugar substitute in a cocktail shaker. Add pomegranate juice and vodka. Fill the shaker halfway with ice and shake vigorously. Strain into a chilled stemmed glass. Garnish with lime slice."
    }
  ],

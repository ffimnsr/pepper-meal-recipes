  "id": "b259ee58-925a-5f70-a6c5-a1ab6375e489",
  "slug": "fettuccine-with-garlic-herb-butter",
  "name": "Fettuccine with Garlic Herb Butter",
  "recipe_type": "main",
  "brief_description": "This is wonderful! Try as much or as little of the fresh herbs to suit your tastes. Serve with freshly grated Parmesan cheese and some warm bread, if desired.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a small saucepan over medium heat, melt 1 teaspoon butter. Add garlic and cook for 30 to 60 seconds or until garlic begins to turn golden."
    },
    {
      "position": 3,
      "text": "In a small bowl, combine parsley, basil, marjoram, thyme, 1 tablespoon butter, salt and ground black pepper with cooked garlic; mix well. Toss with pasta and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

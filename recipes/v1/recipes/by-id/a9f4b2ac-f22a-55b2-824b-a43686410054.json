  "id": "a9f4b2ac-f22a-55b2-824b-a43686410054",
  "slug": "rhubarb-pie-iv",
  "name": "Michelle's Easy Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This is the easiest rhubarb pie ever, and the results are delicious. Most of the ingredients are probably already in your pantry!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place rhubarb into prepared pie crust. Combine sugar and flour; sprinkle over rhubarb. Cover with top crust; cut 4 small slits into crust. Brush with egg."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until filling is bubbling and crust is golden brown, about 30 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

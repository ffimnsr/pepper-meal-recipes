  "id": "7fa2f7db-aa33-5c2e-91e4-74c18f2b82cb",
  "slug": "louisiana-shrimp-and-eggs-gumbo",
  "name": "Louisiana Shrimp and Eggs Gumbo",
  "recipe_type": "soup",
  "brief_description": "This recipe calls for shrimp, but can you use squirrel, rabbit, ham, chicken, or other game for this traditional Louisiana stew. It is delicious over rice, full of okra, peppers, tomatoes, onions, and celery.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a Dutch oven or any heavy pan. Stir in flour to make a roux. Cook, stirring constantly, until roux is dark brown; be careful not to burn. Add onion and garlic, and cook until slightly wilted. Whisk in water."
    },
    {
      "position": 2,
      "text": "Stir in celery, green onions, tomato, green and red peppers, okra, bay leaf, thyme, salt, pepper, and cayenne. Simmer for 1 hour."
    },
    {
      "position": 3,
      "text": "Add shrimp and hard boiled eggs; simmer 15 to 20 minutes longer. Adjust seasoning to taste. Serve gumbo over rice."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "british-shortcrust-pie-pastry",
  "name": "British Shortcrust Pie Pastry",
  "recipe_type": "dessert",
  "brief_description": "Shortcrust pastry dough bakes up crumbly and tender. It's easy to make with just 4 ingredients and perfect to use in any pie, tart, or quiche recipe.",
  "cuisine": "Uk And Ireland British",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, butter, and shortening in a food processor; pulse until crumbly. Mix in water, 1 tablespoon at at time, until dough is soft and pliable."
    },
    {
      "position": 2,
      "text": "Wrap dough in plastic wrap and refrigerate for at least 30 minutes before using."
    }
  ],
  "servings": 2,

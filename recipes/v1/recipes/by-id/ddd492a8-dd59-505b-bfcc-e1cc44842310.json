  "schema_version": 1,
  "id": "ddd492a8-dd59-505b-bfcc-e1cc44842310",
  "slug": "streamline-hungarian-torte",
  "name": "Streamline Hungarian Torte",
  "recipe_type": "dessert",
  "brief_description": "This 3-layer streamlined Hungarian torte recipe is made with walnuts and apricot preserves and topped with a fluffy meringue. This is a showpiece cake.",
  "cuisine": "Hungarian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 11x17-inch jelly roll pan."
    },
    {
      "position": 2,
      "text": "Combine walnuts, \u00be cup sugar, and cinnamon in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Dissolve yeast and 1 teaspoon sugar in warm water in a small bowl. Let stand until yeast softens and begins to form a creamy foam, about 10 minutes. Stir yeast mixture, butter, sour cream, and egg yolks together in a large bowl. Gradually stir in flour until dough becomes too stiff to use a spoon. Knead dough in the bowl using hands until it becomes smooth, about 5 minutes. Divide dough into three equal pieces, form into balls, cover, and set aside to rest for 15 minutes."
    },
    {
      "position": 4,
      "text": "Roll one dough ball between 2 sheets of waxed paper to fit the jelly roll pan; transfer to the prepared baking pan. Spread with \u00be walnut mixture. Repeat rolling with second dough ball; place over walnut layer in the pan. Evenly spread apricot preserves over dough. Repeat rolling with third dough ball; place on top of apricot preserves."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top of torte is golden brown, about 40 minutes."
    },
    {
      "position": 6,
      "text": "Beat egg whites in a glass or metal bowl to soft peaks. Gradually add \u2154 cup sugar while continuing to beat to stiff peaks. Evenly spread meringue over top of torte; sprinkle with remaining \u00bc walnut mixture."
    },
    {
      "position": 7,
      "text": "Bake in the heated oven for 15 minutes more. Cool in the pan on a wire rack. Trim edges for a cleaner presentation. Serve at room temperature."
    }
  ],
  "servings": 32,

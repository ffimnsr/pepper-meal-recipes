  "id": "45f47fe7-b1a0-55bd-8f29-1bf1ddd096a9",
  "slug": "creamy-brown-rice-pudding",
  "name": "Creamy Brown Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This creamy brown rice pudding recipe uses brown rice, cinnamon, and almond extract to make a slightly nutty comfort dessert. You can add raisins, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and brown rice to a boil in a saucepan. Add salt, reduce the heat to low, cover, and simmer until rice is tender and liquid has been absorbed, about 50 minutes."
    },
    {
      "position": 2,
      "text": "Stir milk, evaporated milk, sugar, and almond extract into rice; add cinnamon stick. Simmer, uncovered, until reaches pudding consistency, about 70 minutes, stirring frequently, ."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,

  "id": "a5ce7fd2-ba32-5e68-8a99-77ab4cf9318e",
  "slug": "pear-pecan-cheese-ball",
  "name": "Pear-Pecan Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Sweet pear, salty Cheddar cheese, and crunchy nuts make this delicious cheese ball recipe an irresistible appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cream cheese, Cheddar, pear, scallion white, salt, and pepper together in a medium bowl."
    },
    {
      "position": 2,
      "text": "Coat a large piece of plastic wrap with cooking spray. Scoop the cheese mixture onto it. Using the plastic wrap to help you, form the cheese mixture into a ball, then completely wrap in plastic. Refrigerate for at least 1 hour and up to 2 days."
    },
    {
      "position": 3,
      "text": "Just before serving, combine pecans and the reserved scallion greens in a shallow dish. Roll the cheese ball in the mixture, pressing to adhere."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

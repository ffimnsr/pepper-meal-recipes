  "id": "25065759-54a4-5c04-8862-6d5c845a18f8",
  "slug": "hungarian-goulash-ii",
  "name": "Hungarian Goulash with Ketchup",
  "recipe_type": "soup",
  "brief_description": "A slow cooker version of the traditional paprika stewed beef with dry mustard and Worcestershire for added zip.",
  "cuisine": "Hungarian",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef in a slow cooker and cover with onion. Stir together 1 cup water, ketchup, Worcestershire, brown sugar, salt, paprika, and mustard in a medium bowl. Pour mixture over beef and onion."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low until meat is tender, 9 to 10 hours."
    },
    {
      "position": 3,
      "text": "Mix remaining 1/4 cup water with flour in a small bowl to form a paste; stir into goulash. Cook on High until sauce thickens, 10 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 550,

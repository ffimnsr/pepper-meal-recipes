  "id": "7cfb84a4-b3e1-5d5d-83a6-88b29a1c9893",
  "slug": "sausage-stuffed-mushrooms-ii",
  "name": "Sausage Stuffed Mushrooms II",
  "recipe_type": "appetizer",
  "brief_description": "Pork and cream cheese provide a flavorful, creamy stuffing for cute little mushroom caps.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the broiler."
    },
    {
      "position": 2,
      "text": "Place sausage in a large, deep skillet. Cook over medium high heat until evenly brown. Drain and transfer to a medium bowl."
    },
    {
      "position": 3,
      "text": "Blend cream cheese with the sausage. Stuff mushroom caps with the cream cheese and sausage mixture."
    },
    {
      "position": 4,
      "text": "Arrange stuffed mushroom caps on a medium baking sheet. Broil in the preheated oven 2 to 3 minutes, until lightly browned."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 20,

  "schema_version": 1,
  "id": "eb550531-66f4-5dd8-a13a-5425d2df0c58",
  "slug": "best-toffee-ever-super-easy",
  "name": "Best Toffee Ever - Super Easy",
  "recipe_type": "dessert",
  "brief_description": "This toffee is layered with crunchy almonds and chocolate and tastes rich and buttery. It's a simple recipe and perfect for holiday gifts and parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine butter, sugar, and salt in a large, heavy-bottomed saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Stir constantly in one direction until butter is melted, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, line a 9x13-inch baking dish with a sheet of parchment paper, letting it overhang two sides of the dish."
    },
    {
      "position": 5,
      "text": "Once the butter has melted, stop stirring and bring mixture to a boil. Once boiling, cook, stirring only 2 to 3 times, until it turns a dark amber color and the temperature reaches 300 degrees F (150 degrees C) on a candy thermometer, 20 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Immediately pour toffee into the prepared baking dish. Sprinkle chocolate chips on top and let sit until they soften, 1 to 2 minutes."
    },
    {
      "position": 7,
      "text": "Use a spatula to spread softened chocolate into a thin, even layer."
    },
    {
      "position": 8,
      "text": "Sprinkle nuts over the chocolate and press down slightly; wearing a plastic bag over your hand will minimize the mess."
    },
    {
      "position": 9,
      "text": "Place toffee in the refrigerator until set, about 1 hour. Lift hardened toffee out of the baking dish with the parchment paper."
    },
    {
      "position": 10,
      "text": "Break into pieces and store in an airtight container."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "198538ed-a12c-542d-9c4c-42fc5c2d4ee9",
  "slug": "garlic-mashed-potato-casserole",
  "name": "Garlic Mashed Potato Casserole",
  "recipe_type": "side",
  "brief_description": "This cheesy garlic mashed potato casserole recipe, with a golden crust and buttery interior, is the ultimate comfort food. Make it ahead and freeze it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large pot and cover with lightly salted water. Bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and return to pot."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a glass baking dish. Combine milk, cream cheese, \u2153 cup green onions, butter, egg, garlic, and salt in a bowl; add to potatoes. Mash until smooth; transfer to the prepared baking dish. Sprinkle with Cheddar cheese and remaining green onions."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

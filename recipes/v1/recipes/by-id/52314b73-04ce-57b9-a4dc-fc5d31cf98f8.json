  "id": "52314b73-04ce-57b9-a4dc-fc5d31cf98f8",
  "slug": "slow-cooker-shepherd-s-pie-recipe-11695630",
  "name": "Slow Cooker Shepherd\u2019s Pie",
  "recipe_type": "main",
  "brief_description": "Tasty ground beef topped with cheesy mashed potatoes - this slow cooker shepherd\u2019s pie hits all the spots if your looking for a hearty comfort dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook ground beef and onion in a 12-inch skillet over medium heat until beef is browned and onion is tender; about 8 minutes. Add garlic. Cook and stir until fragrant, about 1 minute; drain fat."
    },
    {
      "position": 3,
      "text": "Add beef mixture and frozen mixed vegetables to a 5- to 6-quart slow cooker."
    },
    {
      "position": 4,
      "text": "Whisk together beef broth, tomato paste, Worcestershire sauce, tapioca, Italian seasoning, salt, and pepper in a small bowl. Pour over beef mixture; stir to combine."
    },
    {
      "position": 5,
      "text": "Cover and cook on Low for 4 to 6 hours or on High for 3 hours."
    },
    {
      "position": 6,
      "text": "Stir the prepared mashed potatoes with cheese. Spread atop the beef mixture."
    },
    {
      "position": 7,
      "text": "Cover and cook on High for 20 minutes."
    },
    {
      "position": 8,
      "text": "Garnish with paprika and parsley"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 200,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

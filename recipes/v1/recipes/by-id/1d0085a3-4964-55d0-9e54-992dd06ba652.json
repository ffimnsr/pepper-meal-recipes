{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1d0085a3-4964-55d0-9e54-992dd06ba652",
  "slug": "farmer-cheese-dumplings",
  "name": "Farmer Cheese Dumplings",
  "recipe_type": "soup",
  "brief_description": "Chef John's American-style farmer cheese dumplings are easy to make and can be simmered in any type of liquid like gravy, soups, or stews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a high saucepan with a lid over medium-high heat. Add chicken thighs and cook, stirring, until lightly browned, about 5 minutes. Add onion and cook, stirring, until soft and translucent, about 5 minutes. Season with salt, pepper, and cayenne. Mix in flour and stir until flour is well mixed in, making a roux, 2 to 3 minutes. You can add more flour if you want a thicker stew."
    },
    {
      "position": 3,
      "text": "Pour in chicken broth and scrape up browned bits from the bottom. Add carrots and celery and bring gravy to a simmer. Lower heat to medium-low and maintain a steady simmer. Add thyme leaves and simmer until gravy is slightly reduced and has thickened, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, make the dumplings: Combine farmer's cheese, egg, rosemary, salt, and pepper in a bowl. Mix with a spoon until smooth. Add self-rising flour and mix until a very stiff batter forms."
    },
    {
      "position": 5,
      "text": "Raise heat to medium and bring gravy back to a steady simmer. Add green onions."
    },
    {
      "position": 6,
      "text": "Remove 1 heaping tablespoon dumpling batter at a time. Shape with the use of a second tablespoon into oval dumplings and carefully drop into the simmering liquid. You should get a total of 6 dumplings out of this recipe. Dust with cayenne pepper, cover, and reduce heat to medium-low."
    },
    {
      "position": 7,
      "text": "Simmer and steam dumplings until they are puffed up and cooked through without stirring or peaking, about 15 minutes. Taste and adjust seasoning with salt if necessary."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

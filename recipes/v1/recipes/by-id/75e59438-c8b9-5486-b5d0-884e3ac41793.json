  "id": "75e59438-c8b9-5486-b5d0-884e3ac41793",
  "slug": "spanish-brown-rice",
  "name": "Spanish Brown Rice",
  "recipe_type": "side",
  "brief_description": "This easy, Spanish-style brown rice recipe uses salsa, tomatoes, and garlic for a tasty change from a typical side dish. Try it as a burrito filling.",
  "cuisine": "American Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rice and garlic in a saucepan; stir in water, salsa, and diced tomatoes. Bring to a boil; stir, reduce heat to low, and simmer, covered, for 50 minutes."
    },
    {
      "position": 2,
      "text": "Turn off heat, let rice sit, covered, for 5 to 10 minutes. Stir rice before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,

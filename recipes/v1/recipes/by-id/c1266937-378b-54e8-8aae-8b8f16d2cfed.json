  "id": "c1266937-378b-54e8-8aae-8b8f16d2cfed",
  "slug": "broccoli-rice-cheese-and-chicken-casserole",
  "name": "Broccoli, Rice, Cheese, and Chicken Casserole",
  "recipe_type": "soup",
  "brief_description": "This chicken broccoli rice casserole with creamy soups and cheese is easy to prep for a comforting meal-in-one casserole that can be made ahead.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a medium saucepan; stir in rice, cover, and remove from heat. Let stand for 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine prepared rice, chicken, broccoli, processed cheese, mushroom soup, chicken soup, milk, butter, and onion in a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted, about 30 to 35 minutes, stirring halfway through cooking to help cheese melt evenly."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

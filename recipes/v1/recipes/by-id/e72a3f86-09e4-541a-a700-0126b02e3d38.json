  "id": "e72a3f86-09e4-541a-a700-0126b02e3d38",
  "slug": "orange-poppy-seed-and-butternut-squash-coffee-cake",
  "name": "Orange, Poppy Seed, and Butternut Squash Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist orange coffee cake with poppy seeds is a delicious way to use leftover butternut squash puree; a crispy streusel topping provides a nice contrast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch springform pan with removable bottom."
    },
    {
      "position": 2,
      "text": "Mix flour, brown sugar, cinnamon, salt, cloves, and nutmeg together in a bowl until well combined. Cut in butter until streusel forms coarse, large crumbs. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, baking soda, salt, cinnamon, cloves, and nutmeg until combined. Set aside."
    },
    {
      "position": 4,
      "text": "Cream sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in eggs one at a time, mixing well after each addition. Mix butternut squash, orange juice, orange zest, and vanilla extract until combined. Mix in 1/2 of the dry ingredients until just combined. Pour in buttermilk, mixing until just combined. Stir in remaining dry ingredients until just incorporated. Fold in poppy seeds."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan and spread into an even layer. Sprinkle streusel mixture evenly over the top of the batter."
    },
    {
      "position": 6,
      "text": "Set springform onto a baking sheet, and place into the preheated oven. Bake until a toothpick inserted into the center of the cake comes out clean, 55 to 60 minutes. Remove from oven and cool for 20 minutes before removing the sides of the pan. Serve slightly warm, or cool to room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

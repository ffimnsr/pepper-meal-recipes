  "id": "a1b01d80-249a-55e1-a970-40a645600e90",
  "slug": "italian-crispy-pasta-salad-recipe-11983110",
  "name": "Viral Crispy Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This twist on Italian pasta salad takes inspiration from the viral crispy pasta salad by adding golden, crunchy air-fried rotini to classic pasta salad fixings: salami, mozzarella, peppers, olives, and Parmesan. Finished with a creamy Italian-style dressing, it's the perfect for potlucks, lunches, or an easy summer dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Toss together pasta, oil, Italian seasoning, salt, pepper, and 1/4 cup of the Parmesan in a medium bowl until evenly coated. Place in air fryer basket in an even layer."
    },
    {
      "position": 2,
      "text": "Cook in the air fryer at 400 degrees F (200 degrees C), shaking basket halfway through, until golden and crispy, about 14 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk together dressing and mayonnaise in a large bowl until combined. Add salami, bell peppers, onion, olives, mozzarella, and remaining 1/2 cup Parmesan cheese; tossing until evenly coated."
    },
    {
      "position": 4,
      "text": "Add crispy pasta and spinach to vegetable mixture and toss to coat. Serve immediately garnished with additional pepper. Recipe developed by Melissa Gray-Streett"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "37278c5d-d104-55dd-acd1-7ab08b9b4d72",
  "slug": "hoisin-glazed-salmon",
  "name": "Hoisin-Glazed Salmon",
  "recipe_type": "dessert",
  "brief_description": "A spicy hoisin-glazed salmon with flavor from soy, chili, ginger, and garlic in the sticky-good sauce for a sweet and spicy dish with a bold taste.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together soy sauce, hoisin sauce, olive oil, lemon juice, chili sauce, ginger, and garlic in a 9x13-inch baking dish. Place salmon fillets into the marinade and turn to evenly coat. Cover the dish with plastic wrap and marinate in the refrigerator for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove and discard the plastic wrap from the salmon. Use a spoon to scoop up the marinade that has collected in the bottom of the baking dish and drizzle it over salmon fillets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

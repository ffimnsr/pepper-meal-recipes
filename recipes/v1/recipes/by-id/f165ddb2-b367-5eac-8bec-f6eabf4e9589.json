  "id": "f165ddb2-b367-5eac-8bec-f6eabf4e9589",
  "slug": "grilled-potato-salad",
  "name": "Grilled Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This grilled potato salad recipe with bacon, green onion, garlic, and parsley is an easy, fuss-free way to prepare and enjoy potato salad all summer long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large bowl; add 2 tablespoons olive oil and toss to coat."
    },
    {
      "position": 3,
      "text": "Cook on the preheated grill until tender, about 30 minutes. Cool, 10 to 15 minutes, cut into quarters, then place in a large bowl."
    },
    {
      "position": 4,
      "text": "Whisk \u00bd cup olive oil, vinegar, salt, black pepper, garlic, and sugar together in a bowl until smooth; pour over potatoes. Add bacon, green onions, and parsley; toss until evenly coated."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "66656e7c-ef07-579a-9aed-1bd4b66902d7",
  "slug": "pretzel-salad",
  "name": "Pretzel Salad",
  "recipe_type": "salad",
  "brief_description": "This is an easy and decorative three-layer salad consisting of a pretzel crust, a cream cheese center, and a strawberry Jell-O topping. It\u2019s just plain delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix crushed pretzels, margarine, and sugar."
    },
    {
      "position": 3,
      "text": "Press crushed pretzel mixture into the bottom of a 9x13-inch baking dish, and bake in the preheated oven, 8 minutes. Remove from heat and allow to cool."
    },
    {
      "position": 4,
      "text": "Blend together cream cheese and sugar. Fold in whipped topping and spread evenly over cooled pretzel mixture."
    },
    {
      "position": 5,
      "text": "In a medium bowl, dissolve strawberry-flavored gelatin in boiling water. Mix in strawberries and set aside to cool for 15 minutes."
    },
    {
      "position": 6,
      "text": "Pour gelatin mixture over cream cheese mixture and refrigerate until set, about 4 hours."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

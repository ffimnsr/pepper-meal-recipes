  "id": "86676517-2766-5564-a1e4-ba35e245352b",
  "slug": "traditional-eggnog",
  "name": "Traditional Eggnog",
  "recipe_type": "dessert",
  "brief_description": "This traditional eggnog recipe blends frothy eggs with vanilla, brandy, rum, cream, and milk to make a rich festive drink that will please any crowd!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs with an electric mixer on medium speed until very frothy, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Gradually beat in sugar, vanilla extract, and 1/4 teaspoon nutmeg."
    },
    {
      "position": 4,
      "text": "Stir in cream, milk, brandy, and rum."
    },
    {
      "position": 5,
      "text": "Cover and chill before serving. Sprinkle individual servings with remaining nutmeg."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": null,

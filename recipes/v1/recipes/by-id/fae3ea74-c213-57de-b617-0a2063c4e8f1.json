  "id": "fae3ea74-c213-57de-b617-0a2063c4e8f1",
  "slug": "crispy-oven-roasted-breakfast-potatoes-recipe-7496452",
  "name": "Crispy Oven-Roasted Breakfast Potatoes",
  "recipe_type": "breakfast",
  "brief_description": "Chef John's breakfast potatoes have an incredibly amazing taste with a crispy exterior and soft creamy center.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, 4 1/2 teaspoons kosher salt, and baking soda in a large pot over high heat and bring to boil. Add potatoes, reduce heat to simmer, and cook until just barely tender, 10 to 12 minutes. Drain and let sit for 30 seconds."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk together olive oil, garlic powder, onion powder, paprika, ground pepper, and cayenne in a large mixing bowl."
    },
    {
      "position": 3,
      "text": "Transfer potatoes into the bowl of seasoned oil and toss with a spatula until potatoes are evenly coated, and are roughened up a bit on the surface."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Spread out potatoes on the prepared baking sheet and smear any excess mashed potato bits in the bowl over the tops of the potatoes. Season with a pinch of salt."
    },
    {
      "position": 6,
      "text": "Roast in the preheated oven until potatoes are browned, and the edges are very crispy, 45 to 60 minutes. For best results, turn potatoes over every 15 to 20 minutes until done."
    },
    {
      "position": 7,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Add onions, peppers, and salt and cook, stirring, until onions are soft and translucent and peppers have softened and sweetened, about 5 minutes. Turn off heat and stir in green onions to be cooked by the residual heat."
    },
    {
      "position": 8,
      "text": "Serve hot, topped with sauteed onions and peppers."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,

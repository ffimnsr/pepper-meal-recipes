  "id": "31319043-80e3-5fe5-86b4-1ffdfcd1a0b1",
  "slug": "summer-green-goddess-pasta-salad-recipe-11997385",
  "name": "Summer Green Goddess Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Green goddess punches up pasta salad. You can swap the goat cheese out for crumbled ricotta salata or feta cheese. If the pasta soaks up the dressing upon storing and the salad feels a little dry, simply drizzle with more dressing just before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook according to package directions, adding asparagus for last 3 minutes of cooking. Add peas, if using, for the last 1 minute of cooking. Drain in a colander and rinse under cold running water to cool quickly."
    },
    {
      "position": 2,
      "text": "Combine pasta mixture, chicken, goat cheese, piquante peppers, shallot, and Green Goddess Dressing in a large bowl; toss to combine. Top with pine nuts just before serving. (To store, chill, covered, up to 3 days.)"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

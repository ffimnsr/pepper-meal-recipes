  "id": "472fcdaa-1cda-52a1-836d-7df8b47a5378",
  "slug": "stuffed-jalapenos",
  "name": "Stuffed Jalapenos",
  "recipe_type": "appetizer",
  "brief_description": "Ground pork sausage is wrapped around cheese stuffed jalapenos, rolled in a coating mix and baked until sizzling in this recipe for a spicy appetizer.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Slice peppers lengthwise, remove seeds and core; fill with cheese."
    },
    {
      "position": 2,
      "text": "Roll out sausage with rolling pin, between two layers of plastic wrap. Remove plastic from sausage, and wrap a thin coating of sausage around each jalapeno."
    },
    {
      "position": 3,
      "text": "Roll peppers in spicy seasoned coating mix."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 15 to 25 minutes or until brown and sizzling and cheese is melted."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": null,

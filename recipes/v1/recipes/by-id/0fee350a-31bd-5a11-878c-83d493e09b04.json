  "id": "0fee350a-31bd-5a11-878c-83d493e09b04",
  "slug": "easy-apple-cobbler",
  "name": "Easy Apple Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This apple cobbler recipe is made with fresh apples and easy pantry ingredients for a delicious, comforting fall dessert that bakes in just 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 3 tablespoons sugar and cinnamon in a bowl."
    },
    {
      "position": 3,
      "text": "Layer apples in an ungreased 9x13-inch baking pan, sprinkling each layer with cinnamon-sugar mixture."
    },
    {
      "position": 4,
      "text": "Combine flour, 1 cup sugar, egg, and baking powder with a fork. Sprinkle over apples in the baking pan. Lightly sprinkle water over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until topping is golden brown, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "air-fryer-baked-yams-recipe-8737640",
  "name": "Air Fryer Baked Yams",
  "recipe_type": "side",
  "brief_description": "These air fryer baked yams free up the oven, which is especially helpful during the holidays, and come out every bit as tender and moist as oven-baked yams.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Scrub yam clean and dry with a paper towel. Rub all over with olive oil."
    },
    {
      "position": 3,
      "text": "Place yam in the preheated air fryer, and cook until tender when pierced with a fork, 15 to 20 minutes."
    }
  ],

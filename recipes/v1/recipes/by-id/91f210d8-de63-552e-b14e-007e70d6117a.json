  "id": "91f210d8-de63-552e-b14e-007e70d6117a",
  "slug": "korean-fried-chicken-sauce",
  "name": "Korean Fried Chicken Sauce",
  "recipe_type": "side",
  "brief_description": "Chef John's recipe for Korean fried chicken sauce is the perfect topper for his recipe for Korean fried chicken.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk ketchup, green onion, garlic, lemon juice, honey, chile-garlic sauce, red pepper flakes, and black pepper together in a saucepan over medium-high heat; add enough water to reach desired sauce consistency. Bring sauce to a simmer; reduce heat to medium-low, and simmer until thick and flavors blend, about 5 minutes. Cool to room temperature and season with salt."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,

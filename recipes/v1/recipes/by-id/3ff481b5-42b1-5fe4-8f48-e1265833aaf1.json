  "id": "3ff481b5-42b1-5fe4-8f48-e1265833aaf1",
  "slug": "italian-cream-cheese-and-ricotta-cheesecake",
  "name": "Italian Cream Cheese and Ricotta Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This creamy ricotta cheesecake is an authentic Italian recipe handed down through generations that your family \u2014 Italian or not \u2014 is sure to enjoy!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch springform pan."
    },
    {
      "position": 3,
      "text": "Mix cream cheese and ricotta cheese together in a mixing bowl until well combined."
    },
    {
      "position": 4,
      "text": "Add eggs, sugar, butter, flour, cornstarch, lemon juice, and vanilla; mix to combine."
    },
    {
      "position": 5,
      "text": "Stir in sour cream and pour into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 1 hour. Turn the oven off; allow cheesecake to cool in the oven with the door closed for 1 hour more to prevent cracking."
    },
    {
      "position": 7,
      "text": "Cool cheesecake completely in the refrigerator before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "slug": "4th-of-july-dump-cake",
  "name": "4th of July Dump Cake",
  "recipe_type": "dessert",
  "brief_description": "For a quick and tasty Fourth of July, or any occasion treat, try this dump cake recipe with cherry pie filling, blueberries, nuts, and white cake mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Layer cherry pie filling, blueberries, cake mix, melted butter, and nuts in a 9x12-inch baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 45 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 45,

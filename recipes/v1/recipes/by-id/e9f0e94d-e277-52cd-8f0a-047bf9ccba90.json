  "id": "e9f0e94d-e277-52cd-8f0a-047bf9ccba90",
  "slug": "crockpot-pastina-soup-italian-penicillin-soup-recipe-11875260",
  "name": "Crockpot Pastina Soup (Italian Penicillin Soup)",
  "recipe_type": "soup",
  "brief_description": "This crockpot pastina soup is the warming chicken soup that winter needs. Thickened by blending tender vegetables and broth together and adding tiny pasta, there's a reason it's called Italian penicillin. It's pure comfort.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a slow cooker. Add onion, celery and carrots and season with salt and pepper. Pour in bone broth and water. Cover and cook on High for 4 hours or until carrots are very tender."
    },
    {
      "position": 2,
      "text": "With slow cooker still on High, use a spoon or small sieve and remove any impurities or foam that have risen to the surface, if desired. Remove chicken from the slow cooker and set aside."
    },
    {
      "position": 3,
      "text": "Use a strainer or slotted spoon to remove all of the onions, carrots, and celery and transfer the vegetables to a blender. Add in 1 cup of liquid from the slow cooker. Remove the center of the blender cap to allow for ventilation and place a towel loosely over the opening. Blend until smooth. Pour mixture back into the slow cooker. Add a little water or stock if necessary to the blender to rinse and add any residual veggie mixture."
    },
    {
      "position": 4,
      "text": "Stir pasta into the slow cooker, cover, and cook on High until pasta is tender and soup has thickened slightly, 35 to 45 minutes. Soup will continue to thicken as it sits. Add more stock or water if desired."
    },
    {
      "position": 5,
      "text": "Meanwhile, remove chicken from the bones and chop into small pieces."
    },
    {
      "position": 6,
      "text": "Stir chicken into the slow cooker and season with salt and pepper to taste. Serve topped with grated Parmesan cheese and fresh parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "33f82b71-7d50-5ad8-b5ad-af4b090b6362",
  "slug": "lobster-roll-khachapuri-recipe-11749292",
  "name": "Lobster Roll Khachapuri",
  "recipe_type": "main",
  "brief_description": "This lobster roll khachapuri fuses two of the greatest sandwiches ever, The buttery Northeastern US lobster roll meets golden-baked Georgian khachapuri in these boat-shaped stuffed flatbreads that feature a succulent lobster tail filling and Monterey Jack cheese.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "For dough, add warm water to the bowl of a stand mixer, and sprinkle yeast over the top. Let sit for about 10 minutes."
    },
    {
      "position": 2,
      "text": "Whisk sugar, egg, and melted butter into the bowl. Add flour and salt, and knead using a dough hook until a very soft, sticky, relatively elastic dough is formed, about 5 minutes, scraping the sides down occasionally if necessary."
    },
    {
      "position": 3,
      "text": "Remove from the mixer and use a spatula to scrape down the sides of the bowl. Cover and let dough rise until doubled in size, 1 to 1 1/2 hours."
    },
    {
      "position": 4,
      "text": "Lightly flour a work surface, and scrape dough out onto the surface. Lightly flour your hands; form dough into a smooth ball, using a bench scraper to assist if necessary. Transfer dough into an oiled resealable plastic bag. Squeeze out most of the air and seal tightly. Place in the refrigerator overnight before using."
    },
    {
      "position": 5,
      "text": "For filling, preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with foil."
    },
    {
      "position": 6,
      "text": "Place lobster tails on the prepared baking sheet and cut each lobster tail down the center with scissors. Spread open the shell to expose the meat and remove the digestive tract if necessary. Grab lobster meat from the thick end, and peel towards the tail, to separate meat from the shell. Lay meat back into the shell in its original position."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until meat has just turned opaque and lightly firm, about 15 minutes. Let cool completely, about 20 minutes, and then dice into 1/4-inch pieces."
    },
    {
      "position": 8,
      "text": "Transfer lobster meat into a bowl. Add tarragon, lemon zest, Old Bay seasoning, cayenne, and mayonnaise. Mix until thoroughly combined, cover, and refrigerate until needed. Turn the oven off if not proceeding immediately."
    },
    {
      "position": 9,
      "text": "For khachapuri, place chilled dough on a lightly floured surface, and divide into 4 equal portions. Form each portion into a ball, and use a rolling pin to roll each dough into a circle about 9 inches across."
    },
    {
      "position": 10,
      "text": "Divide filling into 4 equal portions. For each circle of dough, transfer about 1/3 of the filling portion in a ring pattern about 1 inch away from the edge. Sprinkle Monterey Jack cheese over the whole dough circle, except for a 1-inch border around the edge."
    },
    {
      "position": 11,
      "text": "Roll 2 opposite edges of dough towards the center, until the rolled sides about 1 1/2 inches apart in the middle. Twist the ends together to seal the dough, and twist into 2 points, to create a boat shape."
    },
    {
      "position": 12,
      "text": "Transfer khachapuri to silpat or parchment-lined baking sheets. You should be able to fit 2 per pan. Set the rest of the lobster filling evenly into the centers of each \u201cboat.\u201d Spread filling out to fill the space but don\u2019t pack down."
    },
    {
      "position": 13,
      "text": "Whisk egg and water together in a small bowl; paint exposed dough with egg wash. Top evenly with remaining cheese. If desired, sprinkle with paprika or cayenne."
    },
    {
      "position": 14,
      "text": "Increase the oven temperature to 450 degrees F (235 degrees C)."
    },
    {
      "position": 15,
      "text": "Bake in the preheated oven until nicely browned, 16 to 18 minutes. Transfer onto a cooling rack; let cool for about 10 to 15 minutes before serving. Garnish with additional paprika or cayenne and chopped fresh tarragon."
    }
  ],
  "servings": 4,

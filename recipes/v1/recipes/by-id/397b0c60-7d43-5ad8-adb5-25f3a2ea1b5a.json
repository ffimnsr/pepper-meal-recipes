  "id": "397b0c60-7d43-5ad8-adb5-25f3a2ea1b5a",
  "slug": "peach-tiramisu-recipe-12064358",
  "name": "Peach Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This peach tiramisu is like a fancier version of peaches and cream\u2014but without extra effort. It\u2019s best with ripe, in-season peaches; but you can use what you have.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 2 of the pitted peaches in a blender, along with white sugar, peach schnapps, and lemon juice. Puree until smooth, about 60 seconds. You should end up with about 1 cup pureed peach mixture. Pour mixture into a bowl and set aside until needed."
    },
    {
      "position": 2,
      "text": "Cut the 2 remaining peaches into slices."
    },
    {
      "position": 3,
      "text": "Beat mascarpone, powdered sugar, vanilla, and salt together in a large bowl until smooth and combined. Add heavy cream. Starting on low speed and gradually increasing to medium-high, beat until mixture holds stiff peaks."
    },
    {
      "position": 4,
      "text": "Remove ladyfingers from packaging. Quickly dip 1 ladyfinger in peach puree mixture and place in the bottom of an 8x8-inch square pan. Repeat until entire bottom of the pan is covered, breaking ladyfingers as needed to fit. Top ladyfingers with half of sliced peaches. Place half of whipped mascarpone over peaches and spread into an even layer. Repeat dipping and layering once with remaining ladyfingers, peaches, and mascarpone cream. Loosely cover the pan; chill in the refrigerator for at least 4 hours to overnight."
    },
    {
      "position": 5,
      "text": "When ready to serve, cut tiramisu into 9 pieces. If desired, top with extra sliced peaches. Store tiramisu in the refrigerator."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

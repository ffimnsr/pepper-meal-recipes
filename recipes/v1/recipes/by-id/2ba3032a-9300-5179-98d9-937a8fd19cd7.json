  "id": "2ba3032a-9300-5179-98d9-937a8fd19cd7",
  "slug": "sallys-spinach-mashed-potatoes",
  "name": "Sally\u2019s Spinach Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Sour cream and dill mashed potatoes are mixed with chopped spinach, topped with Cheddar, and baked for a delicious side dish casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium casserole dish."
    },
    {
      "position": 2,
      "text": "Cook spinach according to package directions. Place potatoes in a pot with enough water to cover, and bring to a boil. Cook 15 minutes, or until tender but firm. Drain, cool slightly, and mash."
    },
    {
      "position": 3,
      "text": "Mix spinach, mashed potatoes, butter, sour cream, onion, salt, and dill together in a bowl. Transfer to the prepared casserole dish. Top with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and lightly brown, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0e26e967-c14e-5324-828d-b2c127497f36",
  "slug": "flatbread-with-peach-prosciutto-gorgonzola-and-hot-honey-recipe-11989184",
  "name": "Flatbread with Peach, Prosciutto, Gorgonzola, and Hot Honey",
  "recipe_type": "dessert",
  "brief_description": "Crisp flatbread with sweet ripe peaches, salty prosciutto, creamy Gorgonzola, a drizzle of hot honey, and peppery arugula feels like pizza decided to dress up a little. It\u2019s an effortless summer-inspired dish that\u2019s perfect for entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set out pizza dough and bring to room temperature, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Combine parsley, thyme, basil, lemon zest, shallot powder, \u00bd teaspoon salt and \u00bc teaspoon pepper, and olive oil in a bowl. Drizzle sliced peaches in a bowl with a little olive oil, salt, and pepper. Cut 2 pieces of prosciutto in half and reserve."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Lightly flour your counter, the rolling pin, and your hands. Using your hands, stretch the dough into a circle shape and set on the floured surface. Using the rolling pin, roll pizza dough into desired shape and thickness. Transfer the dough onto the prepared baking sheet and poke holes into the dough using a fork."
    },
    {
      "position": 5,
      "text": "Brush most of the herb mixture generously all over the dough and evenly sprinkle mozzarella on top. Arrange peaches in 4 sections of the dough and nestle the half pieces of prosciutto into the peaches. Tear remaining prosciutto into bite sized pieces and scatter all over the dough."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until flatbread is lightly browned and crips, 15 to 18 minutes. Remove from the oven and brush with remaining herbed oil. Cut flatbread into 4 sections. with the flatbread. Enjoy!"
    },
    {
      "position": 7,
      "text": "Plate each serving. To finish, using a mouli grater, grate gorgonzola cheese over the flatbread and drizzle with hot honey. Toss arugula with olive oil, salt, and pepper and serve as a side with the flatbread."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

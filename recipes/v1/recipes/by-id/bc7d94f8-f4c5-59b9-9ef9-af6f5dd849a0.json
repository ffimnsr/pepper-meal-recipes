  "id": "bc7d94f8-f4c5-59b9-9ef9-af6f5dd849a0",
  "slug": "pangiallo-laziale-italian-christmas-cakes",
  "name": "Pangiallo laziale (Italian Christmas Cakes)",
  "recipe_type": "dessert",
  "brief_description": "Pangiallo laziale are traditional Italian Christmas cakes from Rome made with dried fruits, mixed nuts, olive oil, white wine, and flour.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine prunes, raisins, almonds, walnuts, hazelnuts, sugar, orange marmalade, candied orange peel, and cinnamon in a large bowl and stir to combine with a wooden spoon. Pour in wine and olive oil. Add flour and mix everything into a sticky dough, adding more flour if mixture does not stick together."
    },
    {
      "position": 3,
      "text": "Shape mixture into 8 similar sized logs with wet hands and place onto prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

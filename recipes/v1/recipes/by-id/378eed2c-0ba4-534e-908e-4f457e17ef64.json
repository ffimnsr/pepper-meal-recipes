  "id": "378eed2c-0ba4-534e-908e-4f457e17ef64",
  "slug": "middle-eastern-kibbeh",
  "name": "Middle Eastern Kibbeh",
  "recipe_type": "main",
  "brief_description": "This Middle Eastern Kibbeh recipe is inspired by a dish traditionally made with lamb, bulgur, mint, and onions, then shaped into patties, then fried.",
  "cuisine": "Syrian Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place bulgur in a microwave-safe bowl. Add enough water to cover. Microwave on high until bulgar absorbs water, 1 to 2 minutes. Stir, then set aside to cool."
    },
    {
      "position": 2,
      "text": "Place mint leaves in the bowl of a food processor. Process, gradually adding onion through the feed tube until mixture is finely chopped. Stir mint-onion mixture into bulgur. Stir in cumin, allspice, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Stir bulgur mixture into ground lamb until well combined. Using damp hands, shape lamb mixture into small, palm-sized patties."
    },
    {
      "position": 4,
      "text": "Add oil to a large skillet over medium heat. Cook kibbeh patties until golden brown and cooked through, turning once, about 6 minutes on each side."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

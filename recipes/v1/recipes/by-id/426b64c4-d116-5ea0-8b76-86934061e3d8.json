  "id": "426b64c4-d116-5ea0-8b76-86934061e3d8",
  "slug": "cheesy-corndog-casserole-recipe-11754259",
  "name": "Cheesy Corndog Casserole",
  "recipe_type": "main",
  "brief_description": "This cheesy corndog casserole has the comforting flavors of a corndog with far less effort. Hot dogs, cheese, and corn bread mix combine in an easy casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 3-quart baking dish."
    },
    {
      "position": 2,
      "text": "Heat butter in a skillet over medium-high heat until melted. Add celery and onions and cook until softened, about 4 minutes. Transfer to a mixing bowl."
    },
    {
      "position": 3,
      "text": "Add hot dog pieces to the same skillet and cook until browned on all sides, about 5 minutes. Transfer to mixing bowl with veggies."
    },
    {
      "position": 4,
      "text": "Add in milk, eggs, mustard, hot sauce, cornbread mix, and 1 1/2 cups Cheddar cheese; stir until combined (it\u2019s ok if some lumps remain). Pour into the prepared baking dish. Sprinkle any remaining cheese on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and set, 25 to 30 minutes. A toothpick inserted near the center should come out fairly clean. Let stand 5 to 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

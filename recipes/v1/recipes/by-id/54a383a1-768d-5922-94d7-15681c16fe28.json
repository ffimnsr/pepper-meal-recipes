  "id": "54a383a1-768d-5922-94d7-15681c16fe28",
  "slug": "microwave-corn-on-the-cob",
  "name": "Microwave Corn on the Cob",
  "recipe_type": "dessert",
  "brief_description": "You can microwave corn on the cob easily and save on stove or grill space. Fresh summer sweet corn, ready in minutes with this no-nonsense recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Remove husk and silk from ear of corn."
    },
    {
      "position": 3,
      "text": "Wet a paper towel, then wring it out so it's still moist. Wrap the moist towel around the ear of corn and place it on a microwave-safe plate."
    },
    {
      "position": 4,
      "text": "Cook in the microwave until kernels are tender but still crisp when poked with a knife, 2 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Carefully remove and discard paper towel before serving."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 2,

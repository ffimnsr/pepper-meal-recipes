  "id": "521d6cfc-2182-5d13-815a-56b07a1b0875",
  "slug": "healthier-slow-cooker-gumbo",
  "name": "Healthier Slow Cooker Gumbo",
  "recipe_type": "soup",
  "brief_description": "Loaded with vegetables, this healthier slow cooker gumbo recipe version is rich, hearty, and simple to prepare, making it the perfect recipe for parties.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large, heavy-duty skillet over medium heat. Add flour; cook, stirring constantly, until flour is deep golden and smells toasty, 7 to 10 minutes. Reduce heat if browning too quickly. Transfer to a 6-quart slow cooker."
    },
    {
      "position": 2,
      "text": "Add bell peppers, onion, oil, and garlic to the skillet; cook and stir until tender, 5 to 7 minutes. Transfer to the slow cooker; stir until coated. Stir in tomatoes, broth, sausage, Cajun seasoning, salt, and \u00bc teaspoon black pepper."
    },
    {
      "position": 3,
      "text": "Cover the slow cooker. Cook on Low for 6 to 7 hours or High for 3 to 3 \u00bd hours. Stir in shrimp; cook until opaque, on Low, about 30 minutes, or on High, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place riced cauliflower in a microwave-safe dish; cover, and microwave until heated through, about 4 minutes, stirring halfway through."
    },
    {
      "position": 5,
      "text": "Serve gumbo over cauliflower rice; sprinkle with parsley and season with black pepper."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

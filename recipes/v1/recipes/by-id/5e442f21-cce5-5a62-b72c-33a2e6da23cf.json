  "id": "5e442f21-cce5-5a62-b72c-33a2e6da23cf",
  "slug": "roscoe-s-chilaquiles-recipe-8739658",
  "name": "Roscoe's Chilaquiles",
  "recipe_type": "appetizer",
  "brief_description": "Roscoe's chilaquiles are a stunning Mexican breakfast of crisp tortilla chips in a traditional salsa roja, topped with a fried egg, crema, and avocado.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "For salsa roja, pour boiling water over peppers and let sit until softened, 15 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, add 2 tablespoons olive oil to a skillet over high heat, and sear tomatoes, onions, and garlic until charred for about 2 minutes."
    },
    {
      "position": 3,
      "text": "Place softened peppers, charred vegetables, and 1 cup of the chile soaking water in a blender. Reserve remaining 3 cups chile water. Blend until smooth. Strain the sauce; pour back into the pan."
    },
    {
      "position": 4,
      "text": "Cook sauce over medium heat, scraping any charred bits from the bottom of the pan; add 2 cups of remaining chile water. Simmer until sauce is reduced by 1/3. Stir in bouillon cube and last 1 cup chile water, culantro leaves, lime juice; stir until bouillon cube dissolves. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "For chilaquiles, heat oil to 350 degrees F ( 175 degrees C) in a large saucepan over medium heat. Add tortillas and fry until crisp and golden. 2 minutes per batch."
    },
    {
      "position": 6,
      "text": "For each serving, heat 1 tablespoon oil in a small nonstick pan over medium heat. Crack an egg into the skillet, and cook until outer edges become opaque, about 1 minute. Turn egg over and cook until whites are completely opaque, 1 to 2 minutes more."
    },
    {
      "position": 7,
      "text": "Add a handful of chips to the salsa roja, and turn to coat completely. Remove to a serving plate with a slotted spoon."
    },
    {
      "position": 8,
      "text": "Drizzle with crema, top with an egg, cotija cheese, avocado, cilantro, squeeze of lime juice, and drizzle with more salsa roja. Sprinkle with oregano. Repeat with remaining ingredients."
    }
  ],
  "servings": 4,

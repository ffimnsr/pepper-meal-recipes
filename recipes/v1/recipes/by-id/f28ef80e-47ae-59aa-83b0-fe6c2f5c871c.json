  "id": "f28ef80e-47ae-59aa-83b0-fe6c2f5c871c",
  "slug": "copycat-mcdonald-s-snack-wraps-recipe-11938230",
  "name": "Copycat McDonald's Snack Wraps",
  "recipe_type": "snack",
  "brief_description": "Skip the drive-thru and make these copycat McDonald's snack wraps instead. Tender, crisp chicken gets wrapped in a soft tortilla with lettuce, cheese, and ranch in this easy, delicious recipe.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Stir flour and ranch seasoning together in a shallow bowl. Whisk egg and water together in a second shallow bowl until well combined. Place breadcrumbs in a third shallow bowl."
    },
    {
      "position": 3,
      "text": "Coat each halved chicken tenderloin in the flour mixture, dip into the egg mixture, then press into breadcrumbs until fully coated. Arrange on the prepared baking sheet and coat lightly with nonstick cooking spray."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted in the center registers 165 degrees F (74 degrees C), about 12 minutes, flipping halfway. Meanwhile, spread 1 tablespoon ranch dressing evenly over each tortilla. Top with cheese and lettuce."
    },
    {
      "position": 5,
      "text": "Place one chicken strip on each tortilla, tuck in one end, and wrap tightly, leaving the top open. Serve with additional ranch dressing, if desired. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

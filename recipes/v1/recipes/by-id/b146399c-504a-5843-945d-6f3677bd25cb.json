  "id": "b146399c-504a-5843-945d-6f3677bd25cb",
  "slug": "shortbread-cookies-from-ted-lasso-recipe-11927986",
  "name": "Shortbread Cookies from 'Ted Lasso'",
  "recipe_type": "dessert",
  "brief_description": "In the heartwarming television show \"Ted Lasso\", these buttery soft-set shortbread are coach Ted Lasso\u2019s (Jason Sudeikis) secret to softening up his steely boss, team owner Rebecca Welton (Hannah Waddingham).",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9-inch square baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Cut butter into small chunks and let stand until it reaches room temperature, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Combine flour, sugar, and salt in a stand mixer fitted with a paddle attachment. Add vanilla and butter pieces; mix at medium-low speed until no butter chunks remain and dough just comes together."
    },
    {
      "position": 4,
      "text": "Transfer dough to prepared baking pan, pressing lightly into an even layer. Prick surface a few dozen times with a fork. Bake until golden brown, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Cool completely in pan on a wire rack, about 45 minutes. Once cool, cut into 1x3-inch rectangles."
    }
  ],
  "servings": 27,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 45,

  "id": "29ddf81f-ad90-5579-8c61-9cf897590698",
  "slug": "pumpkin-banana-bread-recipe-11822414",
  "name": "Pumpkin Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin banana bread is a simple, yet delicious, bread that tastes great with a cup of coffee. It\u2019s super-customizable too: swap the olive oil for any other oil you prefer; increase or decrease the amount of spices used; add chopped nuts, dried fruit, or chocolate chips; top it with a cream frosting or icing\u2014the possibilities are endless!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x5-inch loaf pan and line the bottom with parchment paper."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together banana, pumpkin, brown sugar, oil, eggs, vanilla, pumpkin pie spice, cinnamon, salt, and lemon juice until thoroughly combined. Add in flour and baking soda and whisk until incorporated, and no large clumps of flour remain."
    },
    {
      "position": 3,
      "text": "Pour batter into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, 60 to 70 minutes. Allow bread to cool in the pan for 15 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3ab1bbda-fbc5-5afc-a493-3fc3e2e58cee",
  "slug": "chicken-artichoke-dip",
  "name": "Chicken Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This cheesy chicken and artichoke dip is baked with a topping of almonds, and great with your favorite cracker!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, blend chicken, artichoke, Italian-style dressing mix, sour cream, mayonnaise, 1/2 cup Havarti, and Parmesan. Transfer to a small baking dish. Top with remaining Havarti and almonds."
    },
    {
      "position": 3,
      "text": "Bake 25 minutes in the preheated oven, or until bubbly and lightly browned."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

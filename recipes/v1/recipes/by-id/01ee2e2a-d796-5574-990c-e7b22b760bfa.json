  "schema_version": 1,
  "id": "01ee2e2a-d796-5574-990c-e7b22b760bfa",
  "slug": "cheesy-sausage-stuffed-mini-peppers",
  "name": "Cheesy Sausage-Stuffed Mini Peppers",
  "recipe_type": "appetizer",
  "brief_description": "These quick-bite peppers stuffed with a mixture of mushrooms and Jimmy Dean fresh sausage and topped with mozzarella cheese make ideal appetizers or a satisfying meal on their own.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a small frying pan, heat 1 tablespoon of oil over medium-high heat for about 30 seconds. Add Jimmy Dean sausage and cook for 8 to 10 minutes until browned, stirring frequently to break up the sausage into small pieces, then drain. Remove the sausage and set aside."
    },
    {
      "position": 3,
      "text": "To the same pan, add the remaining 1 tablespoon of oil and reduce heat to medium. Add diced mushrooms and saute for about 5 minutes, until mushrooms are softened and brown."
    },
    {
      "position": 4,
      "text": "In a bowl, mix the sausage and mushrooms with the rice and parsley, and 1/2 cup of the mozzarella. Season to taste, and fill each bell pepper halfway with the mixture."
    },
    {
      "position": 5,
      "text": "Top each pepper with additional cheese, and bake for 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Carefully remove the peppers from the oven and let cool for 5 minutes before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d8bb96bf-6017-5bc8-af25-4e55fbc66bac",
  "slug": "fantastic-black-bean-chili",
  "name": "Fantastic Black Bean Chili",
  "recipe_type": "soup",
  "brief_description": "Black bean chili made with ground turkey and flavored with oregano, basil, and a splash of red wine vinegar. Easily doubled to feed a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large heavy pot over medium heat. Add onion and garlic; cook and stir until onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add turkey; cook and stir until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir in beans, tomatoes, chili powder, oregano, basil, and vinegar. Reduce heat to low, cover, and simmer until flavors are well blended, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "9b37c850-6dff-5717-b703-0a7a412fc250",
  "slug": "pan-fried-tofu",
  "name": "Pan-Fried Tofu",
  "recipe_type": "appetizer",
  "brief_description": "Here's how to cook tofu in a pan. This easy tofu is breaded in nutritional yeast and favorite spices. It's a quick vegan main course, savory snack, or crunchy side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice tofu into 1/4-inch-thick slabs."
    },
    {
      "position": 2,
      "text": "Place nutritional yeast on a plate. Mix in garlic powder, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Roll tofu slices in nutritional yeast mixture until evenly coated."
    },
    {
      "position": 4,
      "text": "Heat oil in a nonstick skillet over low to medium heat. Add tofu slices; cook until golden brown and crispy, 3 to 5 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

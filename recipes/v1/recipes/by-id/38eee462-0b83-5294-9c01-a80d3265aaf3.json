  "id": "38eee462-0b83-5294-9c01-a80d3265aaf3",
  "slug": "slow-cooker-pork-and-black-bean-tostadas-recipe-11871516",
  "name": "Slow Cooker Pork and Black Bean Tostadas",
  "recipe_type": "salad",
  "brief_description": "These slow cooker pork and black bean tostadas, piled high with Southwestern salad mix, are a very easy high protein dinner with only 5 ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork tenderloin into a slow cooker. Pour taco sauce over the pork, cover, and cook on High for 2 1/2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Remove pork from the slow cooker and let rest for 5 to 10 minutes. Shred pork and then roughly chop it into smaller pieces. Transfer to a serving dish and top with 1/2 to 3/4 cup cooking liquid from the slow cooker."
    },
    {
      "position": 3,
      "text": "To remaining juices, add beans and mash slightly with a potato masher until slightly thickened. Cook until heated through, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Use a slotted spoon to scoop black beans onto a tostada shell. Top with shredded pork."
    },
    {
      "position": 5,
      "text": "Mix salad mix according to package directions and divide evenly onto the tostadas. Top with additional taco sauce if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "slug": "edible-fake-blood-recipe-8726340",
  "name": "Edible Fake Blood",
  "recipe_type": "dessert",
  "brief_description": "You can easily make your own edible fake blood to drizzle on any Halloween creations you come up with. Use on cupcakes, donuts, or around dips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together cornstarch and water in a small saucepan until cornstarch is dissolved. Add corn syrup to the saucepan and place over medium heat. Add red food coloring until desired color is achieved. Add 1 to 2 drops of blue food coloring to make the \u201cblood\u201d darker."
    },
    {
      "position": 2,
      "text": "Bring mixture to a boil, stirring often. Remove from heat and allow to cool completely. Serve as desired"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,

  "id": "9f01d62a-0c68-5de5-bd3a-796d254b5d14",
  "slug": "best-burger-sauce",
  "name": "Best Burger Sauce",
  "recipe_type": "side",
  "brief_description": "This creamy burger sauce mixes mayonnaise, ketchup, mustard, garlic, and onion to make the best burger sauce that's also a delicious dip for fries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together mayonnaise, ketchup, mustard, onion, garlic, and vinegar in a bowl."
    },
    {
      "position": 3,
      "text": "Season with hot sauce and seasoned pepper."
    },
    {
      "position": 4,
      "text": "Cover and chill at least 1 hour before serving."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],

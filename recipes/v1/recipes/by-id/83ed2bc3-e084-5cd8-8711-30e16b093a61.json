  "id": "83ed2bc3-e084-5cd8-8711-30e16b093a61",
  "slug": "the-perfect-margarita",
  "name": "The Perfect Margarita",
  "recipe_type": "drink",
  "brief_description": "This margarita recipe is the perfect blend of fresh lime juice, white tequila, and triple sec shaken with ice and served in chilled cocktail glasses.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Moisten the rim of a glass with a lime wedge. Sprinkle salt onto a plate. Lightly dip the moistened rim into the salt."
    },
    {
      "position": 3,
      "text": "Place a large ice cube in the glass and freeze the prepared glass until ready to serve."
    },
    {
      "position": 4,
      "text": "Fill a cocktail shaker with fresh ice. Add tequila, triple sec, and lime juice. Cover and shake vigorously until the outside of the shaker has frosted."
    },
    {
      "position": 5,
      "text": "Strain margarita into the salt-rimmed chilled glass and garnish with a slice of lime."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

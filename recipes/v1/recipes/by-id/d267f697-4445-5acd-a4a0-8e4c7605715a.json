  "id": "d267f697-4445-5acd-a4a0-8e4c7605715a",
  "slug": "great-garlic-bread",
  "name": "Great Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This Italian garlic bread is drenched in garlicky herb butter, oven-baked until crisp, topped with melted mozzarella cheese, and ready in 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Melt butter in a small saucepan over medium heat; stir in garlic powder and dried parsley."
    },
    {
      "position": 4,
      "text": "Place bread slices on a medium baking sheet. Using a basting brush, brush bread generously with melted butter mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly toasted, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Sprinkle bread with mozzarella cheese and any remaining butter mixture. Continue baking until cheese is melted and bread is lightly browned, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "9956d0b9-7956-57e9-942b-3f9de6bb33c2",
  "slug": "air-fryer-everything-bagel-salmon-dinner-recipe-7509518",
  "name": "Air Fryer Everything-Bagel Salmon Dinner",
  "recipe_type": "dessert",
  "brief_description": "Salmon fillets are flavored with everything bagel seasoning and cooked in the air fyer with sweet potatoes and broccoli. A perfectly balanced meal for 2 on a weekday.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat air fryer to 400 degrees F (200 degrees C). Coat a sheet of foil with cooking spray."
    },
    {
      "position": 2,
      "text": "Toss sweet potatoes with 1 1/2 teaspoons oil and 1/8 teaspoon each salt and pepper in a bowl. Arrange sweet potatoes in an even layer on the foil; transfer to the air fryer basket. Cook until mostly tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir together mustard, honey, and mayonnaise in a small bowl. In another bowl, toss broccoli with remaining 1 1/2 teaspoons oil and 1/8 teaspoon each salt and pepper."
    },
    {
      "position": 4,
      "text": "Push sweet potatoes to one side of the basket. Add salmon to the other side. Spoon 1 teaspoon mustard mixture onto each fillet; spread to coat tops of fillets. Sprinkle evenly with bagel seasoning. Arrange broccoli around sweet potatoes and salmon. Cook until salmon is opaque and flakes easily with a fork and sweet potatoes and broccoli are tender, 10 to 14 minutes."
    },
    {
      "position": 5,
      "text": "Stir soy sauce into the remaining mustard mixture; drizzle over sweet potatoes and broccoli to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

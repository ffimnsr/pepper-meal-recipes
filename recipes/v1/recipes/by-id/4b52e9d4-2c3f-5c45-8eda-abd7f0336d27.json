  "id": "4b52e9d4-2c3f-5c45-8eda-abd7f0336d27",
  "slug": "ladyfingers",
  "name": "Homemade Lady Fingers",
  "recipe_type": "dessert",
  "brief_description": "These homemade ladyfingers are light, airy, and easy to make with just four simple ingredients\u2014perfect for layering in tiramisu or trifles.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Line two 17x12-inch baking sheets with parchment paper. Fit a large pastry bag with a plain 1/2-inch round tip."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a large bowl with an electric mixer on high speed until soft peaks form. Add 2 tablespoons sugar and continue beating until stiff and glossy."
    },
    {
      "position": 3,
      "text": "Beat egg yolks and remaining sugar in a separate bowl until thick and pale yellow, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Fold half of the beaten egg whites into the yolk mixture. Sift flour and baking powder over the mixture and fold gently until nearly combined. Add the remaining egg whites and fold just until incorporated."
    },
    {
      "position": 5,
      "text": "Transfer the batter to the prepared pastry bag. Pipe 3-inch-long \u201cfingers,\u201d spacing them about 1 inch apart on the baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until firm to the touch and just golden, about 8 minutes. Cool completely on the baking sheets before using or storing."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

  "id": "a133a8c8-bb53-51f3-8ff3-d821becf1f6d",
  "slug": "carols-baked-ziti-casserole",
  "name": "Carol's Baked Ziti Casserole",
  "recipe_type": "side",
  "brief_description": "Packed with cheese, sauce, and pasta, this baked casserole is as comforting as it is filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in ziti and return to a boil. Cook ziti, uncovered, stirring occasionally, until tender yet firm to the bite, about 11 minutes; drain."
    },
    {
      "position": 3,
      "text": "Combine ricotta cheese, 1/4 cup Parmesan cheese, and egg in a bowl. Spread 1/3 spaghetti sauce in the prepared baking dish; top with 1/2 ziti, 1/2 ricotta mixture, 1/3 spaghetti sauce, 1 cup mozzarella cheese, and 2 tablespoons Parmesan cheese. Repeat layers, ending with remaining spaghetti sauce and Parmesan cheese. Cover baking dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until heated through, 45 to 50 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

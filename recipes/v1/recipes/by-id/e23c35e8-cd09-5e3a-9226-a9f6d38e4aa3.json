  "slug": "ginger-sesame-cabbage-recipe-11691855",
  "name": "Ginger Sesame Cabbage",
  "recipe_type": "salad",
  "brief_description": "This ginger sesame cabbage is a side dish that packs a flavor punch. The dressing is ground in a mortar with a pestle, and continues to grow more flavorful after being combined with the cabbage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place garlic, sesame oil, sesame seeds, rice wine vinegar, bouillon powder, brown sugar, lemon juice, ginger paste, and Ac'cent in a mortar and mash with a pestle until the paste is smooth. Taste and adjust seasoning."
    },
    {
      "position": 2,
      "text": "Place cabbage in a bowl; pour dressing over and stir until well coated. Serve with cilantro and green onion on top."
    }
  ],

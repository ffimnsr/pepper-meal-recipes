  "id": "6ea666c7-b007-5230-b984-1987260795da",
  "slug": "cheesy-garlic-zucchini-steaks-recipe-11740595",
  "name": "Cheesy Garlic Zucchini Steaks",
  "recipe_type": "side",
  "brief_description": "These cheesy garlic zucchini steak come out nicely tender and feature Italian flavors from Parmesan, basil, and oregano. Serve as a side or a vegetarian main.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Halve zucchini lengthwise. Score flesh in a criss-cross pattern, 1/4-inch deep at 1/2-inch intervals."
    },
    {
      "position": 3,
      "text": "Sprinkle cut sides of zucchini with salt. Let stand for 15 minutes. Blot any released liquid dry with a paper towel."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon oil in a 12-inch skillet over medium-high. Place zucchini in the skillet, cut side down. Cook until browned, 4 to 5 minutes. Turn and cook on the other side, about 4 minutes. Transfer to the prepared baking sheet, cut sides up."
    },
    {
      "position": 5,
      "text": "Pour remaining 2 tablespoons oil to the skillet. Add garlic, oregano, and crushed red pepper. Cook until fragrant, about 1 minute, and scrape herbed oil into a small bowl."
    },
    {
      "position": 6,
      "text": "Brush zucchini generously with the herbed oil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until tender, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Sprinkle with Parmesan cheese and bake until cheese has melted, about 3 minutes more."
    },
    {
      "position": 9,
      "text": "Garnish with basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

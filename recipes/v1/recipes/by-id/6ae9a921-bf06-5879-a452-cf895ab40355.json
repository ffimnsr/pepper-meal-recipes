  "id": "6ae9a921-bf06-5879-a452-cf895ab40355",
  "slug": "cucumber-feta-quinoa-salad-recipe-8730491",
  "name": "Cucumber Feta Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "This cucumber feta quinoa salad is an easy, healthy, and fresh-tasting salad, with plenty of fresh herbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender, 15 to 20 minutes. Drain, and cool to room temperature, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Combine quinoa, cucumber, red peppers, olives, and red onion in a large bowl; sprinkle with feta cheese."
    },
    {
      "position": 3,
      "text": "Whisk olive oil, vinegar, garlic, mustard, parsley, and oregano together in a small bowl. Pour dressing over salad, toss well to combine, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

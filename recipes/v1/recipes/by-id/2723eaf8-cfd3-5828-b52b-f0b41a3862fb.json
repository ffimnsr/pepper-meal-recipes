  "id": "2723eaf8-cfd3-5828-b52b-f0b41a3862fb",
  "slug": "lentils-with-chorizo",
  "name": "Lentils with Chorizo",
  "recipe_type": "soup",
  "brief_description": "Tender lentils and spicy chorizo sausage team up with bacon, tomatoes, tomatillos, garlic, herbs, and spices in this delicious Mexican-style soup.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place rinsed lentils into a large pot. Add bouillon cube and pour in enough water to cover by 2 inches. Bring to a simmer, then cook until lentils are just tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add chorizo and cook, stirring occasionally, until brown, 10 to 15 minutes. Transfer to a plate."
    },
    {
      "position": 3,
      "text": "Add bacon to the skillet and lightly fry until cooked but still soft, about 5 minutes. Transfer to a cutting board and chop; leave drippings in the pan."
    },
    {
      "position": 4,
      "text": "Cook tomato, tomatillo, onion, and garlic in bacon drippings until soft, about 5 minutes. Stir in 1/2 cup water and cilantro; transfer mixture to a blender. Holding the lid of the blender down with a folded kitchen towel, carefully start the blender; use a few quick pulses to get the mixture moving, then leave it on to pur\u00e9e until smooth."
    },
    {
      "position": 5,
      "text": "Add the pur\u00e9ed vegetables, chorizo, bacon, and cumin to the lentil-broth mixture. Cook and stir over medium heat until hot, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Ladle soup into bowls. Top with cotija cheese and sour cream."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

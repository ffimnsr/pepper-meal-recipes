  "id": "63f2b2e0-ec09-57cf-8bf5-e109f0eb9a49",
  "slug": "mediterranean-flatbread-recipe-11780712",
  "name": "Mediterranean Flatbread",
  "recipe_type": "appetizer",
  "brief_description": "For this Mediterranean flatbread, spread ready-made flatbread with a layer of cream cheese, top with garlicky spinach, artichoke hearts, Kalamata olives, and feta, then bake briefly in a very hot oven.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a sheet pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Place flatbread in the center of the prepared pan and spread with cream cheese."
    },
    {
      "position": 3,
      "text": "In a small bowl, combine spinach, garlic, nutmeg, and dill. Season with salt."
    },
    {
      "position": 4,
      "text": "Spoon spinach mixture over cream cheese, separating any clumps, and press mixture down slightly into cream cheese. Sprinkle parsley on top."
    },
    {
      "position": 5,
      "text": "Place artichoke hearts evenly over spinach layer, and add Kalamata olives around artichoke hearts. Sprinkle with feta cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until heated through, 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and drizzle with olive oil. Cut into 8 triangles."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "a77ff9f2-cb75-5377-b882-2347731141a4",
  "slug": "maple-chess-pie",
  "name": "Maple Chess Pie",
  "recipe_type": "dessert",
  "brief_description": "I was in the middle of making a Chess pie and realized I was out of vanilla extract. I substituted some maple extract I had on hand, added some pecans and the result was delicious. This pie is decadent and rich, so fortunately a small slice will do. I think this would be a great pie for Thanksgiving. Top with sweetened whipped cream or whipped topping if desired.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Press the pie crust into the bottom and up the sides of a 9 inch deep dish pie plate."
    },
    {
      "position": 2,
      "text": "In a medium bowl, beat the butter, sugar, and eggs until light and fluffy. Stir in the cornmeal, vinegar, and maple extract until well blended. Fold in pecans so they are evenly distributed. Pour into the unbaked pie crust."
    },
    {
      "position": 3,
      "text": "Bake for 10 minutes in the preheated oven, then reduce the heat to 350 degrees F (175 degrees C). Bake for 30 additional minutes, or until the top of the pie is golden brown, and the filling is set. When removing the pie from the oven, give it a gentle shake. If there is no movement, the pie is set. The pie will thicken and shrink slightly upon cooling."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "abe650f7-0e12-5a16-b351-7a541a006976",
  "slug": "apple-cinnamon-zucchini-muffins",
  "name": "Easy Zucchini Muffins",
  "recipe_type": null,
  "brief_description": "These easy zucchini muffins with a generous helping of apple and cinnamon are moist, delicious, and bake in just 25 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 24 muffin cups with cooking spray or line with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk sugar, oil, eggs, and vanilla extract together in a bowl until smooth. Stir flour, cinnamon, baking soda, and baking powder into sugar mixture just until batter is combined; fold in shredded zucchini and apple."
    },
    {
      "position": 3,
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until until muffins spring back after pressing the top, about 25 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

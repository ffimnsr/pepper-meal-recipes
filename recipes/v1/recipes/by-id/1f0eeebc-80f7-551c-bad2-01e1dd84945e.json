  "slug": "lentil-soup-iii",
  "name": "Easy Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This simple tomato lentil soup comes together in under 45 minutes with just six ingredients from your pantry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring chicken broth, lentils, onion, tomato paste, garlic, and cumin to a boil in a large saucepan over medium heat. Reduce the heat, cover, and simmer until lentils are soft, 30 to 45 minutes."
    }
  ],

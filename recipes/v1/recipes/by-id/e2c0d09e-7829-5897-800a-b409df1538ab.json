  "id": "e2c0d09e-7829-5897-800a-b409df1538ab",
  "slug": "chili-nachos",
  "name": "Chili Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These easy nachos are perfect for a fun meal. They're loaded with melted cheese, canned chili and beans, and topped with spicy jalape\u00f1os for a kick!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix tomatoes, onion, and cilantro together in a bowl. Squeeze lime into mixture and toss to combine."
    },
    {
      "position": 3,
      "text": "Arrange chips in a single layer on a heatproof platter or baking sheet. Top with spoonfuls of chili, tomato mixture, olives, and cheese. Add jalape\u00f1o slices, if desired. Repeat layers until all ingredients are used."
    },
    {
      "position": 4,
      "text": "Bake until cheese is completely melted., about 15 minutes. Serve nachos hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

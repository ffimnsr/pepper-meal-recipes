  "schema_version": 1,
  "id": "3f791c22-412e-5708-a98d-10073ac3408f",
  "slug": "spam-fries-with-spicy-garlic-sriracha-dipping-sauce",
  "name": "SPAM Fries with Spicy Garlic Sriracha Dipping Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Everyone's favorite luncheon meat, SPAM is transformed into delicious fries with a spicy garlic sriracha sauce!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Process garlic, paprika, and salt in a food processor until smooth. Add mayonnaise, sriracha sauce, and ketchup; process until sauce is well-combined. Transfer sauce to a bowl, cover the bowl with plastic wrap, and refrigerate until chilled."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Rinse luncheon meat 'fries' with cool water and pat dry."
    },
    {
      "position": 3,
      "text": "Working in batches, cook 'fries' in preheated oil until browned and crispy on the outside and still moist on the inside, 4 to 6 minutes. Remove to a paper towel-lined plate. Transfer 'fries' to a plate and serve with chilled dipping sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

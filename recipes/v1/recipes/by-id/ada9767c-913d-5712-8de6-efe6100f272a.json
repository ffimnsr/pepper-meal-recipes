  "id": "ada9767c-913d-5712-8de6-efe6100f272a",
  "slug": "maple-pecan-blondies-recipe-7775410",
  "name": "Maple Pecan Blondies",
  "recipe_type": "dessert",
  "brief_description": "These maple pecan blondies are perfect for pecan lovers. With a brownie like texture, they are chewy and have crunchy edges.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Line an 8x8-inch baking pan with parchment paper, extending the paper over the sides."
    },
    {
      "position": 3,
      "text": "In a large bowl whisk together flour, salt, baking powder, and baking soda; set aside."
    },
    {
      "position": 4,
      "text": "In a medium saucepan combine butter, brown sugar, and maple syrup. Cook and stir over medium heat until melted and smooth, about 6 minutes. Remove from heat; let cool for 10 minutes."
    },
    {
      "position": 5,
      "text": "Stir eggs and vanilla into the butter mixture."
    },
    {
      "position": 6,
      "text": "Stir butter mixture into flour mixture."
    },
    {
      "position": 7,
      "text": "Fold in 1 1/4 cups of the pecans."
    },
    {
      "position": 8,
      "text": "Spread batter in prepared pan."
    },
    {
      "position": 9,
      "text": "Sprinkle remaining 1/4 cup pecans over the top. Bake until set, 35 to 40 minutes. The internal temperature should read 200 degrees F ( (93 degrees C)."
    },
    {
      "position": 10,
      "text": "Cool for 10 minutes on a wire rack before lifting from pan with the parchment paper. Cool completely on a wire rack. Cut into bars for serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "87b02469-0836-5707-a6f0-7b2f2bbd5d1c",
  "slug": "pasta-e-ceci-italian-chickpea-and-pasta-stew-recipe-8400705",
  "name": "Pasta e Ceci (Italian Chickpea and Pasta Stew)",
  "recipe_type": "soup",
  "brief_description": "Pasta e Ceci, or Italian chickpea and pasta stew, is classic Italian comfort food. If you can't find ditalini pasta, use spaghetti that have been broken into pieces.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse chickpeas under cool water. Pick up handfuls of chickpeas and rub them together with your hands under the water to wash chickpeas. Place chickpeas in a large stew pot, cover with water and add baking soda; swirl chickpeas and water to distribute baking soda. Leave to soak for 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "The next day, pour chickpeas through a strainer and rinse well under cold running water, eliminating any skins or discolored chickpeas; set aside."
    },
    {
      "position": 3,
      "text": "Grate onion, celery, zucchini, and carrot on the large teeth of a cheese grater, This step is very important as grated vegetables give a different flavor than diced."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons olive oil in the stew pot over medium heat, and saut\u00e9 grated vegetables for 1 minute. Mix in sage, rosemary, and thyme and saut\u00e9, stirring occasionally, until onions are soft and translucent, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Add 3 cups broth, all the chickpeas, and tomatoes. Bring to a boil, reduce heat, and simmer until chickpeas are tender, about 1 hour. Stir in pasta. Add more broth only as needed to achieve a thick, stew-like consistency."
    },
    {
      "position": 6,
      "text": "Cook until pasta is tender with a bite, 8 to 10 minutes. Taste and season with salt and black pepper. Remove from heat and divide amongst serving bowls. Top each bowl with minced cayenne pepper and a drizzle of extra-virgin olive oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

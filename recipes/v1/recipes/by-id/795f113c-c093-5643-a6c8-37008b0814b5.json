  "id": "795f113c-c093-5643-a6c8-37008b0814b5",
  "slug": "plum-blueberry-upside-down-cake",
  "name": "Plum Blueberry Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This impressive plum upside-down cake is made with black plums and blueberries for a colorful and delicious twist on the classic upside-down cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch cake pan. Combine flour, baking powder, and salt; set aside."
    },
    {
      "position": 2,
      "text": "Combine brown sugar and 3 tablespoons butter in the prepared pan. Place pan inside the preheated oven until butter melts and begins to bubble; set aside."
    },
    {
      "position": 3,
      "text": "Beat 1 cup white sugar and 1/3 cup butter in a large bowl with an electric mixer until light and fluffy. Beat in egg, then stir in vanilla. Beat in flour mixture, alternately with milk, mixing just until incorporated."
    },
    {
      "position": 4,
      "text": "Arrange plums around the edges of the prepared pan, overlapping slightly. Distribute blueberries in the center. Pour batter into prepared pan, covering fruit completely."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 40 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool 15 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

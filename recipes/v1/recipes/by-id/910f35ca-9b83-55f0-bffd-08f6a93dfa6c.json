  "id": "910f35ca-9b83-55f0-bffd-08f6a93dfa6c",
  "slug": "vegan-brownies",
  "name": "Vegan Brownies",
  "recipe_type": "dessert",
  "brief_description": "These vegan brownies are easy to make with high quality cocoa powder and basic pantry ingredients for a gooey, fudgy, and decadent chocolate treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with baking spray; line bottom with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, cocoa powder, baking powder, and salt together in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Pour in water (or coffee), vegetable oil, and vanilla; mix until well-blended. Spread batter evenly in the prepared dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top is no longer shiny and center feels just set when gently pressed, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Let cool for at least 10 minutes before cutting into 15 squares. Enjoy!"
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

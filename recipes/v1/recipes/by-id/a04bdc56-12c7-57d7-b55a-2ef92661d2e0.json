  "schema_version": 1,
  "id": "a04bdc56-12c7-57d7-b55a-2ef92661d2e0",
  "slug": "pineapple-pulled-pork-al-pastor",
  "name": "Pineapple Pulled Pork Al Pastor",
  "recipe_type": "main",
  "brief_description": "Despite the long grilling time, Chef's John's pineapple-brined pulled pork is easy to assemble and hard to mess up thanks to a flavorful al pastor spice rub and pineapple salsa.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork in a large brining vessel. Cut a few slashes into fat side of pork."
    },
    {
      "position": 2,
      "text": "Whisk salt, pineapple juice, and water together in a large bowl. Pour brine over pork. Refrigerate for 12 to 24 hours."
    },
    {
      "position": 3,
      "text": "Combine salt, ancho powder, chipotle powder, garlic powder, cumin, cinnamon, and oregano together for the rub."
    },
    {
      "position": 4,
      "text": "Remove pork from brine and place on a deep baking pan lined with foil. Season generously with spice rub. Reserve remaining spice rub for another use."
    },
    {
      "position": 5,
      "text": "Preheat a charcoal grill between 300 to 325 degrees F (150 to 175 degrees C). Place 2 bricks on the grate, if you like, and place the baking pan on top."
    },
    {
      "position": 6,
      "text": "Grill, occasionally spooning rendered juices over meat, until very tender, about 7 hours. Make sure to maintain the same 25-degree range in temperature by adjusting the vents under, and on top of the grill, or smoker. An instant-read thermometer inserted into the center of pork should read 195 degrees F (91 degrees C)."
    },
    {
      "position": 7,
      "text": "Remove pan from the grill, wrap top in foil, and let rest for 1 hour. Meanwhile, cook pineapple over the last of the coals until nicely charred, 7 to 10 minutes."
    },
    {
      "position": 8,
      "text": "Dice grilled pineapple to get about 2 cups. Combine in a bowl with serrano pepper, red peppers, cilantro, and rice vinegar. Season with salt and a pinch of leftover spice rub."
    },
    {
      "position": 9,
      "text": "Remove pork bone and pull meat apart. Add to a bowl with some of the rendered fat; pull apart with 2 forks. Place some pork over each bottom bun, top with pineapple salsa, and cover with other half bun."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 430,

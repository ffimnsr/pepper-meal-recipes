  "id": "3b99edfe-f1f4-51fc-ad76-2f4b936c30a0",
  "slug": "banana-fritters",
  "name": "Banana Fritters",
  "recipe_type": "dessert",
  "brief_description": "These banana fritters are easy to prep in one bowl. Dust with confectioners' sugar and serve warm for a family-pleasing breakfast or brunch treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine bananas and milk in a large mixing bowl; sift in flour, baking powder, and salt. Add eggs and margarine; mix well to combine. Heat oil in a large, deep skillet to 365 degrees F (180 degrees C)."
    },
    {
      "position": 3,
      "text": "Carefully place spoonfuls of the fritter mixture into the hot oil; cook, flipping once, until golden brown, about 5 minutes. Remove, and drain on a paper towel-lined plate."
    },
    {
      "position": 4,
      "text": "Dust fritters with confectioners' sugar and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

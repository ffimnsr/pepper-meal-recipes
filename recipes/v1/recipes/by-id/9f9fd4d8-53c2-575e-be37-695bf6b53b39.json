  "id": "9f9fd4d8-53c2-575e-be37-695bf6b53b39",
  "slug": "chai-tea-latte",
  "name": "Chai Tea Latte",
  "recipe_type": "drink",
  "brief_description": "Make your own milky chai tea lattes with this homemade recipe that uses boiling water, milk, sugar, honey, and a chai tea bag. Delicious hot or iced!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour boiling water over chai tea bag in a mug; let steep 4 to 6 minutes. Remove and discard tea bag."
    },
    {
      "position": 3,
      "text": "Stir honey and sugar into tea to dissolve. Stir milk through tea to serve."
    }
  ],

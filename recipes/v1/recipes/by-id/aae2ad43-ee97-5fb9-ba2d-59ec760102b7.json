  "id": "aae2ad43-ee97-5fb9-ba2d-59ec760102b7",
  "slug": "tobacco-onions-recipe-7485329",
  "name": "Tobacco Onions",
  "recipe_type": "side",
  "brief_description": "Tobacco onions are made by deep-frying thin slices of onion with cayenne-seasoned flour until crispy and tobacco-colored; a perfect pairing to steaks!",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, cayenne pepper, and salt in a large bowl until combined; add onion slices and toss until well coated."
    },
    {
      "position": 3,
      "text": "Shake off any excess coating and lower onion slices, working in batches, carefully into hot oil. Fry until golden and tobacco-colored, about 3 to 5 minutes. Use a slotted spoon to transfer onion slices onto a paper towel-lined plate to drain and crisp up."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

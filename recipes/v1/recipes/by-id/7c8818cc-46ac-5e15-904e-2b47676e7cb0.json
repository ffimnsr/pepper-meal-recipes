  "id": "7c8818cc-46ac-5e15-904e-2b47676e7cb0",
  "slug": "tortillas-i",
  "name": "Tortillas I",
  "recipe_type": "main",
  "brief_description": "This Mexican flatbread can be filled with almost any savory concoction. You can make them thin or thick, or even puffy, depending on your preference. It is superior to any store-bought tortilla.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together the flour, baking powder, and salt in large bowl. Cut in shortening to resemble cornmeal. Add water slowly, mixing with your hands to make a soft dough. You may not need all the water."
    },
    {
      "position": 2,
      "text": "Knead a few minutes on floured surface until smooth and elastic. Lubricate top with oil, put back in bowl and let rest, covered for 10 minutes."
    },
    {
      "position": 3,
      "text": "Divide into small balls the size of golf balls and proceed to roll out into size and thickness you prefer."
    },
    {
      "position": 4,
      "text": "Cook on top of stove over medium heat using a cast iron grill or heavy skillet until top is slightly bubbly then turning on opposite side for a minute or two."
    },
    {
      "position": 5,
      "text": "Keep stacked and warm inside a clean dish towel."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

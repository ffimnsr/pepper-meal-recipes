  "id": "901f8597-0680-52c9-ab05-d20038c83cb6",
  "slug": "chinese-black-bean-sauce",
  "name": "Chinese Black Bean Sauce",
  "recipe_type": "main",
  "brief_description": "This spicy black bean sauce recipe with fermented black beans helps you make one of the most popular stir-fry sauces on a Chinese food menu at home.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse black beans thoroughly and dry. Remove about 1/4 cup and set aside. Roughly chop the rest of the beans."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large saucepan over medium-low heat. Add chiles, shallot, ginger, and garlic. Fry until soft and fragrant, about 5 minutes. Do not let the ingredients burn. Reduce the heat if necessary. The objective is to slow cook the ingredients."
    },
    {
      "position": 3,
      "text": "Add all the beans; both chopped and whole. Simmer, stirring often, until the beans are soft, about 2 minutes. Add tamari, rice wine, brown sugar, ground Sichuan pepper, and five spice. Simmer until thickened, stirring often. Remove from heat; let cool, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Mix in sesame oil and cover. As the sauce rests, the beans will settle and the oil will float, creating a barrier which will protect it from mold. The sauce is ready to use or store in an airtight container in the refrigerator for up to 1 month."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

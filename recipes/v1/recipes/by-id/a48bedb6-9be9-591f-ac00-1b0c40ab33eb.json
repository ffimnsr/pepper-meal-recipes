  "id": "a48bedb6-9be9-591f-ac00-1b0c40ab33eb",
  "slug": "sausage-peppers-onions-and-potato-bake",
  "name": "Sausage, Peppers, Onions, and Potato Bake",
  "recipe_type": "side",
  "brief_description": "Sausage and potatoes are a classic combination. Combined with peppers, onion, and white wine, this easy Italian bake always delivers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat 2 teaspoons olive oil in a large skillet over medium heat, and cook and stir the sausage until browned, 5 to 10 minutes. Transfer cooked sausage to a large baking dish."
    },
    {
      "position": 4,
      "text": "Pour 1/4 cup of olive oil into the skillet, and cook potatoes, stirring occasionally, until browned, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Place the potatoes into the baking dish, leaving some oil in the skillet."
    },
    {
      "position": 6,
      "text": "Cook and stir green and red peppers and onions in the hot skillet until they are beginning to soften, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Add the vegetables to the baking dish. Pour wine and chicken stock over the vegetables and sausage, and sprinkle with Italian seasoning, salt, and pepper."
    },
    {
      "position": 8,
      "text": "Gently stir sausage, potatoes, and vegetables together."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until hot and bubbling, 20 to 25 minutes. Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

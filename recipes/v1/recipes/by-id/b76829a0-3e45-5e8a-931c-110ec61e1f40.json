  "id": "b76829a0-3e45-5e8a-931c-110ec61e1f40",
  "slug": "3-ingredient-banana-oatmeal-cookies-recipe-7972686",
  "name": "3-Ingredient Banana Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "These 3-ingredient banana oatmeal cookies\u2014just oats, bananas, and raisins\u2014make a great alternative breakfast for when you're on the go, or you can pack them in the kids\u2019 lunch boxes for a healthier snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir bananas and oats together in a bowl until well combined. Stir in raisins. Using a medium sized cookie scoop, drop dough onto the prepared baking sheet. Using your fingers, gently pat down dough to form a round cookie."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until beginning to brown on the bottom, 14 to 15 minutes. Cool on a wire rack."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 15,

  "id": "34bc81e0-e02e-54d0-901a-56f5b2d59b59",
  "slug": "walnut-pumpkin-pie",
  "name": "Walnut Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "A slight twist on the traditional pumpkin pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "In a mixing bowl, combine the pumpkin, condensed milk, egg, 3/4 teaspoon cinnamon, ginger, nutmeg and salt. Pour batter into the pie crust."
    },
    {
      "position": 3,
      "text": "Bake at 425 degrees F (220 degrees C) for 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "In a small bowl, combine brown sugar, flour, and remaining 1/2 teaspoon cinnamon. Cut in the butter or margarine until the mixture is crumbly. Stir in walnuts. Sprinkle mixture evenly over the pie. Bake pie for 40 minutes or until a knife inserted one inch from the edge comes out clean. Cool and garnish as desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

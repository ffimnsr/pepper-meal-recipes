  "id": "4bcaf4ba-d7c2-5d15-b066-5656fbb40950",
  "slug": "bubble-up-pizza-casserole-recipe-11898066",
  "name": "Bubble Up Pizza Casserole",
  "recipe_type": "main",
  "brief_description": "This bubble up pizza casserole is a fun take on pizza. It's a quick and easy weeknight meal made with canned biscuit dough, pizza sauce, and toppings of your choice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cut each biscuit into quarters using kitchen scissors or a knife. Arrange the pieces evenly in the prepared dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Carefully remove from the oven."
    },
    {
      "position": 4,
      "text": "Spoon pizza sauce evenly over the biscuits to cover. Sprinkle evenly with shredded mozzarella cheese and grated Parmesan cheese. Top pizza with pepperoni slices and any additional desired toppings."
    },
    {
      "position": 5,
      "text": "Return to the oven and continue baking until the dough is cooked through and the cheese is fully melted and bubbly, 20 to 25 minutes more. Let stand 10 minutes before serving. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

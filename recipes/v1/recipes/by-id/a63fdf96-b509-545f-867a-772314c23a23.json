  "id": "a63fdf96-b509-545f-867a-772314c23a23",
  "slug": "quick-2-ingredient-nutella-hotteok-korean-sweet-pancakes-recipe-8641238",
  "name": "Quick 2-Ingredient Nutella Hotteok (Korean Sweet Pancakes)",
  "recipe_type": "dessert",
  "brief_description": "Quick Nutella hotteok made with refrigerated biscuit dough for a quick and easy take on sweet Korean pancakes.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Flatten each biscuit into a 4 inch circle. Place 1 tablespoon filling in the center of each biscuit. Wrap dough around the filling into a ball and crimp the dough to seal it tightly. Flatten the filled ball of dough into a patty shape."
    },
    {
      "position": 2,
      "text": "Heat a non stick skillet over medium-low heat. Add 2 teaspoon of oil and, working with 2 to 3 at a time, place the filled dough, seam side down into the skillet. Place lid on skillet and cook until the bottom side is golden brown and toasted, 3 to 4 minutes. Flip the pastries and cook until golden on both sides and the dough along the outside is cooked, an additional 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Repeat with the remaining filled pastries and oil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

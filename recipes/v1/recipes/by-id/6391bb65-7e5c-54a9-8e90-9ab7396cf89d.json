  "id": "6391bb65-7e5c-54a9-8e90-9ab7396cf89d",
  "slug": "parmesan-truffle-fries",
  "name": "Parmesan Truffle Fries",
  "recipe_type": "appetizer",
  "brief_description": "Truffle oil and Parmesan cheese are the key components in these truffle fries that are simply heavenly and will quickly become your favorite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut potatoes into French fry shapes, about 3/8-inch wide and thick, using a mandoline or a knife. Soak potatoes in a large bowl of cold water for about 30 minutes. Drain and pat potatoes dry with a clean towel."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or deep saucepan to 275 degrees F (135 degrees C)."
    },
    {
      "position": 3,
      "text": "Gently lower 1/4 of the potatoes into the hot oil and cook, stirring occasionally, for 2 minutes. Transfer cooked potatoes to a clean towel using a slotted spoon. Repeat frying with remaining potatoes."
    },
    {
      "position": 4,
      "text": "Heat the same oil to 350 degrees F (175 degrees C). Fry potatoes again, working in batches, until golden brown, about 5 minutes. Transfer fries to a clean kitchen towel using a slotted spoon."
    },
    {
      "position": 5,
      "text": "Place fries in a bowl and drizzle truffle oil over warm fries; season with Parmesan cheese, parsley, and sea salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

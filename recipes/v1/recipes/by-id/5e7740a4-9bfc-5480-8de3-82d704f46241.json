  "id": "5e7740a4-9bfc-5480-8de3-82d704f46241",
  "slug": "cherry-cobbler-i",
  "name": "Cherry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Simple and sweet, this cherry cobbler with frozen cherries will garner raves. Cherries, baking powder dough, and a sugary cornstarch syrup bake up sweet, bubbly, and delicious. Serve warm with whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place cherries in the bottom of a 9-inch square pan."
    },
    {
      "position": 3,
      "text": "Mix 3/4 cup sugar, butter, flour, salt, baking powder, and milk together in a bowl. Spread dough over cherries."
    },
    {
      "position": 4,
      "text": "Combine 1 cup sugar and cornstarch in a small bowl. Stir in boiling water. Pour mixture over dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 45 minutes. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "b436c355-3350-525b-9cd1-0dd63c46d5a1",
  "slug": "tuna-and-vegetable-casserole",
  "name": "Tuna and Vegetable Casserole",
  "recipe_type": "main",
  "brief_description": "Tuna and vegetable casserole comes together quickly with this recipe that calls for plenty of fresh and frozen vegetables that are usually on-hand.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in boiling water, occasionally stirring until cooked through but firm to the bite, about 5 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine green beans, squash, peas, and carrots in a microwave-safe glass or ceramic bowl; cook until tender, 3 to 10 minutes. Rinse vegetables with cold water and drain."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a skillet over medium-high heat; sauté mushrooms in hot oil until tender, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Whisk mushroom soup and milk together in a large bowl; add vegetables, mushrooms, tuna, onion, and Cheddar cheese. Mix in Worcestershire sauce, salt, and black pepper. Pour mixture into a casserole dish and top with French fried onions."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bubbling, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

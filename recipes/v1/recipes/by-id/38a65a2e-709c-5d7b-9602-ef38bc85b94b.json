  "id": "38a65a2e-709c-5d7b-9602-ef38bc85b94b",
  "slug": "sweet-potato-minestrone",
  "name": "Sweet Potato Minestrone",
  "recipe_type": "soup",
  "brief_description": "A hearty and delicious vegetarian minestrone soup with sweet potatoes, carrots, green beans, celery, tomatoes, onions and garlic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a soup pot over medium-high heat. Saut\u00e9 onion, celery, Italian seasoning, salt, and pepper until tender, about 5 minutes. Stir in tomatoes with juice, broth, sweet potatoes, carrots, green beans, and garlic. Bring to a boil; reduce heat to low and simmer, stirring occasionally, until vegetables are tender, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

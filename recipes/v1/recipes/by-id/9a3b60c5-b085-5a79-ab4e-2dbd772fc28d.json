  "id": "9a3b60c5-b085-5a79-ab4e-2dbd772fc28d",
  "slug": "sopa-de-lentejas-andalucian-lentil-soup",
  "name": "Sopa de Lentejas (Andalucian Lentil Soup)",
  "recipe_type": "soup",
  "brief_description": "Lentils are cooked with green bell peppers, tomatoes, Spanish chorizo sausage, and potatoes in this versatile, hearty soup. Add carrots or other vegetables if you like.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Cook the bacon just until it starts to brown a bit, 5 to 8 minutes. Add the olive oil, onion, and bell pepper; cook and stir until vegetables begin to soften, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in the garlic, tomatoes, sausage, and bay leaf; cook about 4 minutes. Add lentils and water (water should be about an inch deeper than the level of the lentils). Bring to a boil over high heat. Reduce heat to low; simmer, uncovered, until lentils are just cooked, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Put the potatoes into the soup and continue simmering until potatoes are cooked through, 12 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "slug": "korean-spicy-chicken-and-potato-tak-toritang",
  "name": "Korean Spicy Chicken and Potato (Tak Toritang)",
  "recipe_type": "main",
  "brief_description": "A very easy meal to make! Chicken drumettes, potato, carrots, and onion simmer in a spicy sauce that goes best with white rice.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over medium heat, mix the chicken, potatoes, carrots, onion, sugar, and garlic. Pour in water and soy sauce, and stir in sugar and hot pepper paste."
    },
    {
      "position": 2,
      "text": "Bring to a boil, reduce heat to low, and simmer 45 minutes, until chicken juices run clear, vegetables are tender, and liquid has thickened."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

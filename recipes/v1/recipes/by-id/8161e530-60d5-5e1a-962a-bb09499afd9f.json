  "id": "8161e530-60d5-5e1a-962a-bb09499afd9f",
  "slug": "apricot-brandy-pound-cake-iii",
  "name": "Apricot Brandy Pound Cake III",
  "recipe_type": "dessert",
  "brief_description": "An impressive balance combination of 5 flavors infuse this moist pound cake, which features apricot brandy. This cake freezes well.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 10 inch tube pan. Mix together the flour, baking soda and salt. Set aside."
    },
    {
      "position": 2,
      "text": "Combine the sour cream, rum flavoring, orange extract, almond extract, lemon extract, vanilla extract and apricot brandy. Set aside. In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the eggs one at a time. Beat in the flour mixture alternately with the sour cream and flavorings mixture, stirring just until incorporated."
    },
    {
      "position": 3,
      "text": "Pour batter into prepared pan. Bake in the preheated oven for 60 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

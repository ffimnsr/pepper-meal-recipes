  "id": "94768ff9-f085-5da5-855f-76f661b5f41b",
  "slug": "copycat-nothing-bundt-cake-chocolate-chocolate-chip-cake-recipe-11933688",
  "name": "Copycat Nothing Bundt Cake Chocolate Chocolate Chip Cake",
  "recipe_type": "dessert",
  "brief_description": "This copycat Nothing Bundt Cake chocolate chocolate chip cake is a a copy of their best-selling cake. Hydrating the batter and covering the cooling cake with plastic wrap will make it even more moist. It's chocolaty and delicious!",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Sift cake mix to remove any chocolate chips; if there are any, set them aside. In a bowl combine cake mix, pudding mix, espresso, melted butter, oil, milk, Greek yogurt, and eggs; mix until smooth. Cover bowl with plastic wrap and allow to sit for 15 to 45 minutes to hydrate batter."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat the oven to 350 degrees F (180 degrees C) and grease a 10-cup Bundt pan."
    },
    {
      "position": 3,
      "text": "Combine chocolate chips from cake mix (if any) with 1 cup chocolate chips and toss chocolate chips in a little flour (to help keep chocolate chips from sinking)."
    },
    {
      "position": 4,
      "text": "Once batter is hydrated, fold in chocolate chips. Pour batter into the prepared cake pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out mostly clean, 35 to 45 minutes. Let the cake cool in the pan for 15 minutes, then remove and place on cake plate or wire rack. Wrap cake in plastic wrap to finish cooling."
    },
    {
      "position": 6,
      "text": "Meanwhile, for frosting, combine butter and cream cheese, whip until light and fluffy, then slowly add sugar and vanilla. Add frosting to a piping bag with a large round tip."
    },
    {
      "position": 7,
      "text": "Pipe on frosting, starting outside the cake and moving into the center hole for the cleanest lines."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 45,

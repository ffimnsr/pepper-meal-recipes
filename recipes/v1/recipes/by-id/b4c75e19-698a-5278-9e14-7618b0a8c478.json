  "id": "b4c75e19-698a-5278-9e14-7618b0a8c478",
  "slug": "crab-quiche-ii",
  "name": "Simple Crab Quiche",
  "recipe_type": "breakfast",
  "brief_description": "I love quiche and imitation crab. This combines the best of both worlds. It is a simple and versatile recipe that whips up in a jiffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine the eggs, milk, mayonnaise and cornstarch. Stir in the cheese, imitation crabmeat and pepper. Pour into the pie shell."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes or until a knife inserted in the center comes out clean. Let cool slightly and serve."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,

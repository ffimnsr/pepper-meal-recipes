  "id": "b4d503ae-6f46-5c2f-9a7b-dcc7f73f3aea",
  "slug": "out-of-this-world-turkey-brine",
  "name": "Out of This World Turkey Brine",
  "recipe_type": null,
  "brief_description": "This out-of-this-world turkey brine recipe blends brown sugar, Worcestershire, garlic, and salt to make your turkey tender, juicy, and full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix water, salt, brown sugar, Worcestershire sauce, garlic, and pepper together in a food-grade bucket or container large enough to hold a turkey."
    },
    {
      "position": 2,
      "text": "Place turkey in brine, making sure it is fully submerged."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate. Brine 12 to 24 hours before smoking or roasting."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

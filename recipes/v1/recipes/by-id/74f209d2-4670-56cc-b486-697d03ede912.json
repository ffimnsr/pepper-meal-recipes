  "id": "74f209d2-4670-56cc-b486-697d03ede912",
  "slug": "italian-cream-cake-cookies",
  "name": "Italian Cream Cake Cookies",
  "recipe_type": "dessert",
  "brief_description": "These easy, cute cookies have all the flavor of a slice of Italian cream cake, sure to be a hit with family and friends!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter and sugar in a large bowl; beat with an electric mixer on high speed until creamy, about 2 minutes. Add egg yolks, vanilla, and almond extract; beat until combined. Add flour and salt; mix until just combined. Stir in coconut, making sure it is evenly distributed throughout the dough. Refrigerate dough for about 30 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, make the frosting. Beat cream cheese and butter together until creamy. Add vanilla and almond extract, then gradually stir in powdered sugar until frosting is creamy. Stir in coconut. Refrigerate icing to infuse the flavors, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Beat egg whites in a small bowl until bubbly and frothy. Pour pecans into a shallow bowl."
    },
    {
      "position": 5,
      "text": "Shape the cookies by rolling the cold dough into 1-inch balls. Dip dough into the egg whites then roll in the pecans until covered. Arrange on the prepared baking sheets. Gently press down with your thumb to make a small well in the center of each cookie."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until slightly firm, about 15 minutes. Allow to cool on the baking sheets for a few minutes to firm up. Move cookies to a wire rack. Cool completely before filling with frosting."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

  "id": "48bd7a51-2d9a-5583-ad90-ed4786fa82f5",
  "slug": "southern-pecan-pie-ii",
  "name": "Southern Pecan Pie II",
  "recipe_type": "dessert",
  "brief_description": "A homemade crust made with butter and egg yolk encases this classic Southern style pecan pie.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine 1 1/2 cups flour, 3 tablespoons sugar and salt. Cut in butter until mixture resembles coarse crumbs. Mix yolk with water and stir in until mixture forms a ball. Wrap in plastic and refrigerate for 1 hour or overnight. Roll out and place in a 9 inch pie plate."
    },
    {
      "position": 2,
      "text": "Preheat oven to 450 degrees F (230 degrees C.)"
    },
    {
      "position": 3,
      "text": "Place pecans in the bottom of pie crust. In a large bowl, Stir together 3/4 cup of sugar and flour. Mix in the eggs, corn syrup, milk, melted butter and vanilla. Blend well and pour over pecans in crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Reduce temperature to 350 degrees F (175 degrees C) and bake for 40 to 50 minutes, or until golden brown and filling is set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 90,

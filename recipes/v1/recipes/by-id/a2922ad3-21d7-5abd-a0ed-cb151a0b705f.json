  "id": "a2922ad3-21d7-5abd-a0ed-cb151a0b705f",
  "slug": "worlds-best-peanut-butter-fudge",
  "name": "World's Best Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "This best peanut butter fudge recipe is easy to make on the stove with milk, butter, marshmallow, and peanut butter for a rich, creamy confection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking dish; set aside."
    },
    {
      "position": 2,
      "text": "Combine sugar, milk, and butter in a medium saucepan. Bring to a boil and cook for 5 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Stir in peanut butter and marshmallow creme. Mix in flour gradually until incorporated."
    },
    {
      "position": 4,
      "text": "Spread fudge into the prepared dish. Allow to cool completely before slicing."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

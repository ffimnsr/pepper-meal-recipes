  "id": "abf3f565-c36e-5c4f-a178-6ef12db63a63",
  "slug": "buttermilk-scones",
  "name": "Buttermilk Scones",
  "recipe_type": "breakfast",
  "brief_description": "Light and flaky, this buttermilk scone is tasty as is or made with chopped fruit or grated cheese.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking powder, and salt in a large mixing bowl. Add buttermilk and melted butter; stir until a soft dough is formed."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and press into a rectangle, about 3/4-inch thick and 4-inches wide. Cut into 8 equal pieces and place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "34a95984-edff-53f7-b974-e4ac57e7b18d",
  "slug": "easy-corned-beef-and-cabbage",
  "name": "Easy Corned Beef and Cabbage",
  "recipe_type": "main",
  "brief_description": "This corned beef recipe with cabbage is made in a slow cooker with potatoes and carrots for a quick and easy weeknight or St. Patrick's Day meal.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes, carrots, and onion into a 5-quart slow cooker. Combine water, sugar, vinegar, garlic, black pepper, bay leaf, and contents of spice packet in a small bowl; pour over vegetables. Top with beef brisket and cabbage."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low until beef and vegetables are tender, 8 to 9 hours. Remove bay leaf before serving."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 15,

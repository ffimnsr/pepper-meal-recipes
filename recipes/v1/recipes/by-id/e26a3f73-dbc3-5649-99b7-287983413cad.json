  "id": "e26a3f73-dbc3-5649-99b7-287983413cad",
  "slug": "juicy-pulled-pork",
  "name": "Juicy Pulled Pork",
  "recipe_type": "main",
  "brief_description": "Pulled pork made from pork chops baked in a chunky barbeque sauce become a delicious sandwich filling in this easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine barbeque sauce, mushrooms, tomatoes, onion, brown sugar, garlic, vinegar, salt, and black pepper in a food processor or blender; pulse until mixture is blended but still chunky. If the mixture is too thick, add water."
    },
    {
      "position": 3,
      "text": "Arrange pork chops in a baking dish and cover with barbeque sauce mixture; cover with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pork is very tender, about 3 hours. Shred pork with 2 forks."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 10,

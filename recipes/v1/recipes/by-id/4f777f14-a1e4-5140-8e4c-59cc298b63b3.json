  "id": "4f777f14-a1e4-5140-8e4c-59cc298b63b3",
  "slug": "instant-pot-ribs",
  "name": "Instant Pot Ribs",
  "recipe_type": "main",
  "brief_description": "Instant Pot ribs are so tender they fall off the bone. The best part is that you can cook them from start to finish in just a little over an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine juice, vinegar, and liquid smoke in a multi-functional pressure cooker (such as Instant Pot). Add bay leaves."
    },
    {
      "position": 2,
      "text": "Add a trivet to the pot and place ribs on top, trimming as needed to fit. Close and lock the lid; set valve to sealing. Choose high pressure and set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Unlock and remove the lid."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "e1369136-8f36-53da-9ad2-059367d4de09",
  "slug": "oatmeal-raisin-cookies-ix",
  "name": "Soft and Chewy Oatmeal Raisin Cookies",
  "recipe_type": "dessert",
  "brief_description": "These oatmeal raisin cookies are made with canola oil instead of butter for a soft, chewy, and tender texture. Perfect for a sweet treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two cookie sheets."
    },
    {
      "position": 2,
      "text": "Whisk canola oil, brown sugar, eggs, and vanilla together in a large bowl until well blended. Combine flour, baking soda, salt, cinnamon, and nutmeg in a separate bowl; stir into the canola oil mixture until combined. Stir in oats and raisins until evenly distributed. Drop rounded spoonfuls of dough 2 inches apart onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the edges are lightly browned and the centers are set, 10 to 12 minutes. Let cookies cool on the baking sheets for 5 minutes. Transfer to wire racks and cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

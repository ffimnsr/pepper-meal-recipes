  "id": "84b86a5b-7792-5bff-88dc-928a7b56c072",
  "slug": "easy-summer-pie",
  "name": "Easy Summer Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy summer pie recipe features a sweet cream cheese filling topped with mounds of raspberries, blueberries, mandarin oranges, strawberries, and kiwi.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Roll pie crust on a lightly floured surface into an 11-inch circle. Lay flat on a baking sheet or pizza pan; prick several times with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until light brown, 12 to 15 minutes. Cool completely."
    },
    {
      "position": 4,
      "text": "Beat cream cheese and sugar together in a bowl until creamy and smooth; spread evenly onto cooled crust."
    },
    {
      "position": 5,
      "text": "Arrange kiwi, oranges, strawberries, raspberries, and blueberries in a decorative pattern over cream cheese layer. Chill in the refrigerator until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

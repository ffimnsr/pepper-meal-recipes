  "id": "0b7121aa-a2f2-573a-88b0-87ee304f8713",
  "slug": "melissas-grandmas-ginger-lace-cookies",
  "name": "Melissa's Grandma's Ginger Lace Cookies",
  "recipe_type": "dessert",
  "brief_description": "This recipe for Melissa's Grandma's ginger lace cookies dates from the WWI era. Hence, there is no butter. They feature a spiced ginger and molasses flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat 2 cups sugar, shortening, and molasses in the bowl of a stand mixer fitted with the paddle attachment until uniform, making sure not to overbeat. Add eggs; beat for 30 seconds."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking soda, cinnamon, ginger, and salt together in a separate bowl; beat into sugar mixture until just combined and dough is stiff."
    },
    {
      "position": 4,
      "text": "Pour 2 tablespoons sugar in a shallow bowl. Roll dough into 1-inch balls; roll in sugar, making sure not to flatten. Place on ungreased cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cookies crackle on top for \"lace\" design, 6 to 8 minutes. Cool on cookie sheets for 5 minutes; transfer to a wire rack to cool completely."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "2645f5ff-61ed-59b1-bf67-d1e6230c141e",
  "slug": "instant-pot-pork-tenderloin",
  "name": "Instant Pot Pork Tenderloin",
  "recipe_type": "drink",
  "brief_description": "This super moist and flavorful pork tenderloin is cooked in apple juice in an Instant Pot. Adding cornstarch yields a thick and tasty gravy you can spoon on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Heat olive oil until shimmering, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Season pork tenderloin with Greek seasoning, salt, and pepper. Add to the preheated pot and cook until browned, about 3 minutes per side. Transfer to a plate. Pour apple juice into the pot; scrape up any pork bits left on the bottom. Set rack inside the pot and place tenderloin on the rack."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method for 10 minutes according to manufacturer's instructions. Quick-release any remaining pressure. Unlock and remove the lid. Lift out tenderloin and set aside to rest for 5 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, remove 1/4 cup of the liquid from the pot and mix with cornstarch to make a slurry. Pour slurry back into the pot. Select Saute function and simmer sauce until thickened, about 5 minutes. Slice pork and drizzle sauce on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

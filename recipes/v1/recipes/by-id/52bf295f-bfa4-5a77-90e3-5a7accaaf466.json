  "id": "52bf295f-bfa4-5a77-90e3-5a7accaaf466",
  "slug": "sour-cream-pound-cake",
  "name": "Classic Sour Cream Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This recipe makes a delicious, not-too-sweet pound cake. It's baked in a loaf pan, making it simple to slice and serve.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 8x4-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a large bowl until light and fluffy. Add sour cream and eggs; mix well. Add flour and a pinch of soda, mix until just incorporated. Pour batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into center of cake comes out clean, about 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "dda0d18c-0746-56f8-8f7f-6863f8f5d0ae",
  "slug": "bread-machine-challah-i",
  "name": "Easy Bread Machine Challah",
  "recipe_type": "main",
  "brief_description": "Challah, a yeasted egg bread, is made especially easy in a bread machine.",
  "cuisine": "World American Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Add milk, eggs, margarine, bread flour, white sugar, salt, and yeast to the bread machine pan in the order recommended by the manufacturer."
    },
    {
      "position": 2,
      "text": "Select the Basic Bread cycle and Light Crust setting. Start the machine."
    },
    {
      "position": 3,
      "text": "When the baking cycle is complete, carefully remove the loaf from the pan and transfer it to a wire rack. Let cool before slicing."
    }
  ],

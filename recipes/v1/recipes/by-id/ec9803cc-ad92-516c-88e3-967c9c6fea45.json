  "id": "ec9803cc-ad92-516c-88e3-967c9c6fea45",
  "slug": "sadies-buttermilk-biscuits",
  "name": "Sadie\u2019s Buttermilk Biscuits Recipe",
  "recipe_type": "breakfast",
  "brief_description": "My grandmother Sadie\u2019s country fair award-winning buttermilk biscuit recipe was perfected on the northern Canadian prairies and uses lard for flakiness.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, baking soda, cream of tartar, and salt together in a large bowl; cut in lard using a pastry blender until crumbly. Stir in buttermilk. Turn out mixture onto a floured surface; knead a few times to form a moist dough."
    },
    {
      "position": 3,
      "text": "Roll out dough to 1-inch thickness; cut out biscuits with a cookie cutter or round glass. Place biscuits on an ungreased baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops are golden, about 12 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "390b6fc2-2e6f-522b-856a-f850b612c77a",
  "slug": "sous-vide-marinated-flank-steak",
  "name": "Sous Vide Marinated Flank Steak",
  "recipe_type": "main",
  "brief_description": "Flank steak is marinated in garlic, soy sauce, honey, red wine vinegar, and olive oil, cooked sous vide for a few hours, and then quickly grilled on the barbecue.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, honey, olive oil, vinegar, and garlic in a flat glass dish."
    },
    {
      "position": 2,
      "text": "Trim any surface fat from steak. Place steak into soy sauce mixture; turn to coat. Allow to marinate in the refrigerator for about 5 hours, turning occasionally."
    },
    {
      "position": 3,
      "text": "Place a heat-resistant pad underneath a large pot filled with water. Attach a sous vide precision cooker to the pot and preheat water to 140 degrees F (60 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove steak from marinade and shake off excess liquid; discard marinade. Place steak into a food-grade polyethylene bag and vacuum seal or use the water immersion method to remove all air. Submerge the bag in preheated water; set the timer for 3 hours."
    },
    {
      "position": 5,
      "text": "When the timer is up, remove steak from the bag and pat dry with a paper towel."
    },
    {
      "position": 6,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 7,
      "text": "Place steak on the preheated grill and cook on one side for 2 to 3 minutes. Cut in half and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 10,

  "id": "1cfd625a-11b8-512a-b1ed-1176e416a547",
  "slug": "beef-mushroom-barley-soup",
  "name": "Beef Mushroom Barley Soup",
  "recipe_type": "soup",
  "brief_description": "Starting with stew meat, onion, celery, and carrot, this recipe yields a beef, mushroom, and barley soup sure to become a family favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook beef stew meat in a large skillet over medium heat until completely browned, 5 to 7 minutes; transfer to a large soup pot."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in the same skillet over medium heat; cook and stir onion, celery, and carrot in the hot oil until the onions are tender, about 5 minutes. Add the vegetable mixture to the beef in the pot."
    },
    {
      "position": 3,
      "text": "Pour beef stock into the pot."
    },
    {
      "position": 4,
      "text": "Stir pearl barley into the stock."
    },
    {
      "position": 5,
      "text": "Place soup over medium-low heat, bring to a simmer, and cook, stirring occasionally, until the beef is completely tender, about 2 hours."
    },
    {
      "position": 6,
      "text": "Stir mushrooms through the soup; cook 1 hour more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 190,
  "preparation_time_minutes": 15,

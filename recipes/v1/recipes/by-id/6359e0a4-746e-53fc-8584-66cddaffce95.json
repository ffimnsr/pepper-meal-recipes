  "id": "6359e0a4-746e-53fc-8584-66cddaffce95",
  "slug": "fresh-fruit-flan",
  "name": "Fresh Fruit Flan",
  "recipe_type": "dessert",
  "brief_description": "This U.K.-style fruit flan has cake-like crust, a cream cheese filling, and a layer of fresh berries and kiwi topped with a homemade citrus glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10x15-inch jelly roll pan."
    },
    {
      "position": 2,
      "text": "Make the crust: Sift flour, cream of tartar, and baking soda into a mixing bowl."
    },
    {
      "position": 3,
      "text": "Beat both sugars, butter, oil, egg, and vanilla in a large bowl with an electric mixer until creamy. Gradually mix in flour mixture until well blended. Spread evenly over the bottom of the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes. Remove from the oven and let cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Make the filling and top with fruit: Beat cream cheese, sugar, and vanilla in a bowl until smooth and creamy. Spread over cooled crust and arrange fruit decoratively over top. Refrigerate until glaze is ready."
    },
    {
      "position": 6,
      "text": "Make the glaze: Stir sugar and cornstarch together in a small saucepan. Whisk in water, orange juice, and lemon juice and bring to a boil over medium heat. Boil gently for 1 minute, then remove from the heat and allow to cool completely, 20 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Spoon or brush glaze evenly over fruit. Refrigerate for at least 1 hour before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

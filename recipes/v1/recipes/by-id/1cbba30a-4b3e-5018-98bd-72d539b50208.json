  "id": "1cbba30a-4b3e-5018-98bd-72d539b50208",
  "slug": "turkey-sub-recipe-8647890",
  "name": "Turkey Sub",
  "recipe_type": "salad",
  "brief_description": "This deli-style turkey sub, with turkey, Swiss cheese, lettuce, tomato, banana peppers, and oregano, makes a meal with soup or salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice the sub roll in half lengthwise."
    },
    {
      "position": 2,
      "text": "Stir mayonnaise and mustard together in a small bowl until well combined. Spread mixture on both sides of the roll."
    },
    {
      "position": 3,
      "text": "Layer turkey and Swiss cheese on the bottom half. Top with lettuce, tomatoes, banana peppers, and red onion."
    },
    {
      "position": 4,
      "text": "Sprinkle with oregano, and season with salt and pepper. Place the top half of the roll on the sandwich, and serve."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

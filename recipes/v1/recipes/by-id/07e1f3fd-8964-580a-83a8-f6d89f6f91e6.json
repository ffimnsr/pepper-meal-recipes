  "id": "07e1f3fd-8964-580a-83a8-f6d89f6f91e6",
  "slug": "texas-coleslaw",
  "name": "Texas Coleslaw",
  "recipe_type": "salad",
  "brief_description": "Texas coleslaw with a Southwestern twist! Tangy with lime juice, cayenne and cumin, and bursting with crunchy bits of carrot, green onion and radish.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mayonnaise, lime juice, cumin, cayenne, salt, and pepper in a large bowl. Add cabbage, carrot, green onions, and radishes and stir until well-combined. Chill at least 1 hour before serving."
    }
  ],

  "id": "6dacda75-7ca0-5920-b6cc-9c6ad5ae722b",
  "slug": "grilled-tofu-skewers-with-sriracha-sauce",
  "name": "Grilled Tofu Skewers with Sriracha Sauce",
  "recipe_type": "main",
  "brief_description": "This grilled tofu skewers with Sriracha sauce recipe features tofu and veggies marinated in Sriracha, soy sauce, sesame oil, onion, and jalape\u00f1o.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place tofu, mushrooms, zucchini, and bell pepper in a bowl. Combine soy sauce, onion, Sriracha, sesame oil, jalape\u00f1o, and black pepper in a small bowl; pour over tofu-vegetable mixture and toss lightly to coat. Cover the bowl; marinate tofu and vegetables in the refrigerator for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Thread tofu and vegetables onto skewers; reserve marinade."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill until desired doneness, about 10 minutes. Serve remaining marinade as a dipping sauce."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "ca586e1d-c5fb-569d-8da6-2099b53ade93",
  "slug": "air-fried-sweet-potato-fries",
  "name": "Air Fryer Sweet Potato Fries",
  "recipe_type": "dessert",
  "brief_description": "These air fryer sweet potato fries, seasoned with garlic and paprika, are crisp, savory, and delicious and take just 10 minutes to cook.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut sweet potato into 1/2-inch wide fries. Place in a bowl with canola oil; toss to coat. Season with salt, pepper, garlic powder, and paprika; mix until all fries are evenly coated."
    },
    {
      "position": 3,
      "text": "Working in batches if necessary, place an even layer of fries in the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer until golden, about 10 minutes. Repeat to cook remaining fries."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

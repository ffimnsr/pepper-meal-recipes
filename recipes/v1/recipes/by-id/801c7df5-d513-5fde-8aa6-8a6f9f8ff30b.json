  "schema_version": 1,
  "id": "801c7df5-d513-5fde-8aa6-8a6f9f8ff30b",
  "slug": "the-best-caramel-apples",
  "name": "The Best Caramel Apples",
  "recipe_type": "dessert",
  "brief_description": "The best caramel apple recipe coats tart apples with rich, thick caramel. Sprinkle with nuts, crushed cookies, or whatever you desire for a sweet treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large saucepan of water to a boil. Dip apples in water for a few seconds with a slotted spoon to remove any wax from skins; dry with paper towels. Let cool."
    },
    {
      "position": 2,
      "text": "Insert sticks through bottom core of each apple."
    },
    {
      "position": 3,
      "text": "Line a baking sheet with parchment paper. Stir brown sugar, sweetened condensed milk, corn syrup, and butter together in a medium saucepan over medium-high heat."
    },
    {
      "position": 4,
      "text": "Bring to a boil, stirring constantly; reduce heat to medium. Cook until a candy thermometer reads 248 degrees F (120 degrees C), stirring constantly to prevent burning, 25 to 30 minutes. A teaspoon of caramel dropped in a glass of cold water should form a firm ball."
    },
    {
      "position": 5,
      "text": "Remove from heat; stir in vanilla extract."
    },
    {
      "position": 6,
      "text": "Working quickly, dip each apple into caramel to completely coat apple and about 1/2 inch of the handle."
    },
    {
      "position": 7,
      "text": "Sprinkle apples with desired toppings while still hot."
    },
    {
      "position": 8,
      "text": "Let cool on the prepared baking sheet, about 1 hour. Use caution, caramel is very hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

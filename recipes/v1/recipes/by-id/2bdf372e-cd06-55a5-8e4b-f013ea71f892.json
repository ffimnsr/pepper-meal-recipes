  "schema_version": 1,
  "id": "2bdf372e-cd06-55a5-8e4b-f013ea71f892",
  "slug": "cream-cookies",
  "name": "Cream Cookies",
  "recipe_type": "dessert",
  "brief_description": "These tender little cream cookies need only four simple ingredients; flour, butter, cream, and sugar. You can refrigerate the dough ahead of time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, mash butter and flour together until smooth and creamy. Beat in cream, 1 to 2 tablespoons at a time, until thoroughly combined."
    },
    {
      "position": 2,
      "text": "Scrape dough onto a large sheet of plastic wrap, wrap tightly, and chill at least 1 hour to overnight."
    },
    {
      "position": 3,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Roll dough out 1/4-inch thick on a floured work surface and cut into 2-inch circles with a cutter. Place sugar into a shallow bowl, and dip each cookie into sugar on both sides. Place cookies onto the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake cookies in the preheated oven until the edges turn light golden brown, 10 to 12 minutes. Allow to cool for about 5 minutes on sheets before removing to cool completely on racks."
    }
  ],
  "servings": 50,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

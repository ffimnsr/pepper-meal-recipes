  "id": "aa2c0da2-65be-5060-8ce4-3c0c5f559f03",
  "slug": "flavorful-southern-fried-chicken",
  "name": "Flavorful Southern Fried Chicken",
  "recipe_type": "main",
  "brief_description": "I found a recipe for fried chicken in a cookbook and I added my favorite spices to make it more flavorful.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a large plastic bag, combine the flour, Parmesan cheese, bread crumbs, poultry seasoning, onion powder, garlic powder, salt and pepper. Shake to mix."
    },
    {
      "position": 2,
      "text": "Heat the oil in a large skillet over medium heat until a drop of water evaporates immediately. Dip one piece of chicken at a time into the milk, and then place in the bag with the coating. Shake until fully coated. Place in the frying pan, and continue with remaining chicken."
    },
    {
      "position": 3,
      "text": "Cook until the edges are browned, then flip and cook until browned on the other side. If some chicken is done sooner, keep on a paper towel lined plate in a warm oven, so that the chicken is all still warm at serving time."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

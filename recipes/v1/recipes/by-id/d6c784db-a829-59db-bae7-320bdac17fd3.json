  "schema_version": 1,
  "id": "d6c784db-a829-59db-bae7-320bdac17fd3",
  "slug": "shrimp-and-mushroom-linguini-with-creamy-cheese-herb-sauce",
  "name": "Shrimp and Mushroom Linguini with Creamy Cheese Herb Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Cooked shrimp and sliced fresh mushrooms are bathed in sauteed garlic, cream cheese, fresh parsley and a dash of basil. Toss with hot linguini and serve as an elegant appetizer or main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add linguini and cook until tender, about 7 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat 2 tablespoons butter in a large skillet over medium-high heat. Add mushrooms; cook and stir until tender. Transfer to a plate."
    },
    {
      "position": 3,
      "text": "In the same pan, melt 1/2 cup butter with the minced garlic. Stir in the cream cheese, breaking it up with a spoon as it melts. Stir in the parsley and basil. Simmer for 5 minutes. Mix in boiling water until sauce is smooth. Stir in cooked shrimp and mushrooms; heat sauce through."
    },
    {
      "position": 4,
      "text": "Toss linguini with shrimp sauce and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

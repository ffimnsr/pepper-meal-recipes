  "id": "aa628236-6a89-582b-994b-f5efccff4a80",
  "slug": "everything-bagel-monkey-bread-recipe-11986718",
  "name": "Everything Bagel Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "For a savory take on classic sweet-and-sticky monkey bread, dough is instead dipped in butter and sprinkled with DIY everything bagel seasoning, then served with whipped cream cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat a 12-inch cast-iron skillet with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together sesame seeds, poppy seeds, garlic, onion, and salt in a bowl. Halve each piece of dough to make 36 pieces total. Roll each into a ball. Dip dough balls into melted butter, then in the seed mixture to coat. Arrange dough balls evenly in the prepared skillet. Drizzle tops with any remaining butter. Cover loosely and let rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees Fahrenheit (180 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, in the preheated oven until golden brown and an instant-read thermometer inserted into the center registers 195 degrees F (90 degrees C)."
    },
    {
      "position": 5,
      "text": "Let cool on a wire rack for 10 minutes. Serve warm with whipped cream cheese. Store in an airtight container at room temperature up to 3 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "15b3e399-ed36-54de-887b-0184f555dd31",
  "slug": "make-ahead-spinach-salad-in-a-jar",
  "name": "Make-Ahead Spinach Salad in a Jar",
  "recipe_type": "salad",
  "brief_description": "Prep these salads once and eat for the week! Make sure to firmly pack the spinach into each jar and they will stay fresh all week. Also a great use for leftover quinoa!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender, 15 to 20 minutes. Allow to cool."
    },
    {
      "position": 2,
      "text": "Whisk orange juice, vinegar, orange zest, salt, curry powder, and pepper together in a small bowl. Slowly drizzle in olive oil, whisking continuously until well blended."
    },
    {
      "position": 3,
      "text": "Line up 5 pint jars in an assembly line fashion."
    },
    {
      "position": 4,
      "text": "Place 1 1/2 tablespoons of dressing into the bottom of each jar. Place 1/2 cup cooked quinoa into each jar, and top with 2 tablespoons cherries. Add 1 1/2 tablespoons goat cheese on top of the cherries. Top with 1 cup of spinach per jar and pack down tightly to remove air pockets; jars should be filled to the top. Finish each jar with 1 tablespoon walnuts. Cover jars and refrigerate until ready to eat."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

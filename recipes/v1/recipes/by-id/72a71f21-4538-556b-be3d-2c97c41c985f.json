  "id": "72a71f21-4538-556b-be3d-2c97c41c985f",
  "slug": "white-gelatin",
  "name": "White Gelatin",
  "recipe_type": "salad",
  "brief_description": "Learn how to make white jello by blending cream cheese, milk, vanilla, and whipped topping with gelatin. Use a decorative mold for a pretty presentation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, beat cream cheese and sugar until smooth and well blended."
    },
    {
      "position": 2,
      "text": "In a separate bowl, dissolve gelatin in boiling water; cool slightly, then stir into cream cheese mixture along with milk, lemon juice, and vanilla. Fold in whipped topping. Pour into a mold if desired, and refrigerate until set, about 3 hours."
    }
  ],

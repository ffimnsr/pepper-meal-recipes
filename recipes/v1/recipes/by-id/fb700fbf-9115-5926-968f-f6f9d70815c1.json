  "id": "fb700fbf-9115-5926-968f-f6f9d70815c1",
  "slug": "sopa-de-mariscos-seafood-soup",
  "name": "Sopa de Mariscos (Seafood Soup)",
  "recipe_type": "soup",
  "brief_description": "This Tex-Mex inspired sopa de mariscos, or seafood soup, combines littleneck clams, mussels, shrimp, and cod flavored with tomatoes, corn, and spices.",
  "cuisine": "Tex Mex Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a stockpot over medium heat. Add onion and cook until translucent, 5 to 7 minutes. Add garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Add carrots, corn, and celery and cook until softened, about 5 minutes. Add chicken stock, tomatoes, ancho chili, chili powder, and cumin and bring to a boil. Reduce heat, cover, and simmer for 45 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, place clams and mussels in a bowl of cold water to filter out sand."
    },
    {
      "position": 4,
      "text": "Drain clams and mussels; add to the soup. Stir in cod and shrimp. Cover and boil until cod is white and flaky, mussels and clams are open, and shrimp is pink, 5 to 10 minutes. Serve immediately, topped with cilantro and avocado."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

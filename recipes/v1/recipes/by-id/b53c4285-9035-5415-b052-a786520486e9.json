  "id": "b53c4285-9035-5415-b052-a786520486e9",
  "slug": "maple-walnut-biscotti",
  "name": "Maple Walnut Biscotti",
  "recipe_type": "dessert",
  "brief_description": "This maple walnut biscotti recipe is flavored with pure maple syrup, maple extract, and walnuts, delivering a Canadian take on the Italian cookie.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat \u00bd cup butter and white sugar in a large bowl with an electric mixer until smooth. Beat in eggs, one at a time, beating well after each addition; beat in \u00bd cup maple syrup and maple extract. Stir in flour mixture just until dough forms; fold in walnuts just until combined."
    },
    {
      "position": 4,
      "text": "Divide dough in half. Shape each half into a log the length of a baking sheet; place on the prepared baking sheet. Flatten each log into a rectangle 3-inches-wide and 1-inch-tall."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned on the bottom and slightly cracked on top, about 30 minutes. Remove from oven; cool for 15 minutes, but leave oven on."
    },
    {
      "position": 6,
      "text": "Slice logs diagonally into \u00bd-inch-thick slices; lay slices on their sides on the baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until lightly browned and crisp on the outside, about 8 minutes. Remove from oven; cool 3 to 5 minutes."
    },
    {
      "position": 8,
      "text": "Combine \u00bc cup maple syrup and 1 tablespoon melted butter in a bowl. Gradually stir in confectioners' sugar until smooth. Lightly drizzle maple glaze with a spoon over warm biscotti."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

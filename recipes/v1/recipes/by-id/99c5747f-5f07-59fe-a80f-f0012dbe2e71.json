  "id": "99c5747f-5f07-59fe-a80f-f0012dbe2e71",
  "slug": "artichoke-hearts-gratin",
  "name": "Artichoke Hearts Gratin",
  "recipe_type": "appetizer",
  "brief_description": "Artichoke hearts topped with breadcrumbs and parmesan cheese are broiled for a simple and satisfying appetizer that will have you going back for more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place artichoke heart halves on a paper towel, cut-side down, to drain for about 15 minutes."
    },
    {
      "position": 3,
      "text": "Set the oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and lightly coat with vegetable oil."
    },
    {
      "position": 4,
      "text": "Place artichoke heart halves on the prepared baking sheet, cut-side up. Season with salt and pepper. Sprinkle with breadcrumbs, then cheese, and drizzle with olive oil."
    },
    {
      "position": 5,
      "text": "Broil artichoke hearts until browned on top, about 7 minutes. Serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

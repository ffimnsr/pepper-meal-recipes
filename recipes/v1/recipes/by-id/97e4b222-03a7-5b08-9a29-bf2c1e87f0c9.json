  "id": "97e4b222-03a7-5b08-9a29-bf2c1e87f0c9",
  "slug": "lemon-rosemary-salmon",
  "name": "Lemon-Rosemary Salmon",
  "recipe_type": "main",
  "brief_description": "An easy yet impressive rosemary and lemon salmon, baked with bright, savory flavors. This dish works as a weeknight meal or special occasion dinner.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (250 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange half the lemon slices in a single layer in a baking dish. Layer with 2 sprigs rosemary, and top with salmon fillets. Sprinkle salmon with salt, layer with remaining rosemary sprigs, and top with remaining lemon slices. Drizzle with olive oil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until fish is easily flaked with a fork, 12 to 15 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "17fd7c8e-9cbc-58ee-b1f2-bfdde290672e",
  "slug": "prosciutto-peach-pizza-recipe-8303284",
  "name": "Prosciutto Peach Pizza",
  "recipe_type": "main",
  "brief_description": "This prosciutto peach pizza, with grilled peaches, salty prosciutto, hot honey, and fresh arugula is full of flavor and a great way to enjoy peak summer peaches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a gas grill with all burners on High for 10 to 15 minutes. Grill peach slices until peaches begin to soften and have grill marks, about 5 minutes, set aside."
    },
    {
      "position": 2,
      "text": "Reduce the flame on half of the grill burners to Low, to create areas of direct and indirect heat. Shape pizza dough into a circle. Brush one side of dough with 2 teaspoons olive oil."
    },
    {
      "position": 3,
      "text": "Carefully place dough oil side down onto the grill over direct heat. Close the cover, and grill dough until the bottom is just barely cooked and shows char marks, 1 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Use tongs to turn dough over; move to the indirect heat. Brush dough with pesto, dollop with ricotta cheese, and sprinkle with quesadilla cheese. Scatter on pieces of prosciutto, grilled peaches, and sliced heirloom tomato. Grill until cheese is melted, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Remove pizza from the grill, top with arugula, and drizzle with hot honey and 2 teaspoons olive oil. Cut into wedges and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

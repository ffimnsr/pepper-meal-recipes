  "id": "061c3641-cfb8-50ad-bb1d-11f39be403c0",
  "slug": "loaded-chicken-salad-recipe-11918132",
  "name": "Loaded Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This loaded chicken salad is like a loaded baked potato, but as a chicken salad, with sour cream, Cheddar, bacon, and green onions. I like to serve it on toasted buns for a quick lunch or as an appetizer with crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl mix sour cream, mayo, and ranch powder until evenly incorporated."
    },
    {
      "position": 2,
      "text": "Fold in chicken, cheese, bacon, green onion, salt, and pepper until evenly combined."
    },
    {
      "position": 3,
      "text": "Serve immediately or cover and refrigerate for 1 hour for maximum flavor."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

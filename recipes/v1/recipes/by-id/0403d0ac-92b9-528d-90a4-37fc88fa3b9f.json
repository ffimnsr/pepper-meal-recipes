  "id": "0403d0ac-92b9-528d-90a4-37fc88fa3b9f",
  "slug": "kuku-sabzi",
  "name": "Kuku Sabzi",
  "recipe_type": "appetizer",
  "brief_description": "This kuku sabzi is an easy Persian frittata that uses egg as the binder to showcase the fresh herbs that make this dish delicious and unforgettable.",
  "cuisine": "Persian Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Slice leek in half lengthwise, then slice thinly crosswise."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a 10-inch, nonstick, broiler-safe skillet over medium heat. Add leek and cook, stirring occasionally, until softened and cooked through, 8 to 10 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Preheat the oven's broiler with the rack in the upper third position."
    },
    {
      "position": 4,
      "text": "Whisk eggs in a large bowl. Add baking powder, fenugreek, salt, and turmeric; whisk until thoroughly combined. Fold in parsley, cilantro, dill, and leeks. Gently stir to combine; the mixture will be mostly herbs, with just enough egg for moisture."
    },
    {
      "position": 5,
      "text": "Heat remaining 2 tablespoons olive oil in the same skillet over medium heat. Add herb mixture and distribute evenly in the skillet, smoothing the top. Cover and cook, undisturbed, until the bottom and edges are just set, about 8 minutes."
    },
    {
      "position": 6,
      "text": "Uncover and cook under the preheated broiler until the top and middle are cooked through, 1 to 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

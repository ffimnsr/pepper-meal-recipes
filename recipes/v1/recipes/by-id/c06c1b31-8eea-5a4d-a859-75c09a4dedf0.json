  "slug": "doggie-ice-cream-cake-recipe-8685528",
  "name": "Doggie Ice Cream Cake",
  "recipe_type": "dessert",
  "brief_description": "This doggie ice cream cake is for when the temperatures soar. Cool down your fur babies with this dog-friendly treat. Small portions and all-natural peanut butter are key here.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix yogurt and peanut butter together in a large bowl. Add chopped strawberry/banana mix and stir until evenly combined."
    },
    {
      "position": 2,
      "text": "Transfer mixture to a silicone baking mold. Sprinkle bacon pieces on top. Freeze 8 hours or overnight."
    },
    {
      "position": 3,
      "text": "Empty cake onto a clean work surface and cut into individual servings based on your dog's size. Treat your dog and store remaining pieces in an airtight container in the freezer up to 3 months."
    }
  ],
  "servings": 20,

  "id": "9882f745-d582-5c50-b3a7-9b37bd272abf",
  "slug": "cheese-ravioli-with-three-pepper-topping",
  "name": "Cheese Ravioli with Three Pepper Topping",
  "recipe_type": "main",
  "brief_description": "Cheese ravioli topped with green, red and yellow peppers. A nice change from tomato sauces.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook ravioli in boiling water for 8 to 10 minutes, or until done; drain."
    },
    {
      "position": 2,
      "text": "Heat olive oil in large skillet over medium heat. Saute onion and bell peppers until tender. Add one cup of the broth, season with pepper flakes, and simmer 5 minutes. Stir in remaining broth, and cook until most of broth has evaporated. Spoon pepper mixture over ravioli."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,

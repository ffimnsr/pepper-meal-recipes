  "schema_version": 1,
  "id": "0eff4801-ce26-588d-9ca0-7e11d47429e7",
  "slug": "baked-buffalo-chicken-thighs-recipe-8384547",
  "name": "Baked Buffalo Chicken Thighs",
  "recipe_type": "salad",
  "brief_description": "These baked Buffalo chicken thighs improve the meat to bone ratio of chicken wings dramatically. If you want a meal, try using bone-in, skin-on chicken thighs for a hearty, spicy main dish. If you serve them with carrot and celery strips on Romaine leaves, you'll sneak in a salad, before your family will know it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a sheet pan with parchment paper or foil."
    },
    {
      "position": 2,
      "text": "Trim excess skin and fat from thighs and pat dry with paper towels. Place chicken thighs in a 1-gallon resealable plastic bag."
    },
    {
      "position": 3,
      "text": "Stir together salt, pepper, and baking powder in a small bowl until well blended. Add seasonings to the bag. Seal the bag; shake and move chicken around to evenly coat with seasonings."
    },
    {
      "position": 4,
      "text": "Place seasoned chicken thighs on the prepared pan, skin side up, and spray with olive oil spray."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until chicken skin is brown and crispy, chicken is no longer pink at the center and juices run clear, 40 to 45 minutes. An instant-read thermometer inserted near the center of chicken should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Meanwhile, melt butter in a small saucepan over medium heat. Stir in hot sauce, Worcestershire sauce, garlic, and cayenne. Remove from heat and keep warm."
    },
    {
      "position": 7,
      "text": "Remove chicken from the oven; brush thighs evenly with hot sauce mixture."
    },
    {
      "position": 8,
      "text": "Serve on a bed of Romaine leaves, with fresh carrot and celery sticks, and ranch dressing for dipping. Garnish with fresh parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

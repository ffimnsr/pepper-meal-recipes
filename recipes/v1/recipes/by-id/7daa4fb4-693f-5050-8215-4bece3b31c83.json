  "id": "7daa4fb4-693f-5050-8215-4bece3b31c83",
  "slug": "cranberry-pistachio-pudding-muffins-recipe-8749115",
  "name": "Cranberry Pistachio Pudding Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These cranberry pistachio pudding muffins are perfect for the holidays with their green color and red cranberry specks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Let eggs, sour cream, and milk stand at room temperature for 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line twelve 2 1/2-inch muffin cups with paper bake cups."
    },
    {
      "position": 4,
      "text": "Combine flour, pudding mix, baking powder, and salt in a medium bowl."
    },
    {
      "position": 5,
      "text": "Whisk together eggs, white sugar, and melted butter in a medium bowl until combined. Add sour cream, milk, vanilla, and almond extract. Whisk until combined. Stir in dried cranberries until combined."
    },
    {
      "position": 6,
      "text": "Fold in flour mixture."
    },
    {
      "position": 7,
      "text": "Scoop batter into prepared muffin cups."
    },
    {
      "position": 8,
      "text": "Sprinkle tops with pistachios and turbinado sugar. This may seem like too much topping, but as the cupcakes bake and expand, it will be the right amount."
    },
    {
      "position": 9,
      "text": "Bake for 8 minutes. Reduce oven temperature to 350 degrees F (180 degrees C). Bake until a toothpick inserted into the centers comes out clean, 10 to 12 minutes."
    },
    {
      "position": 10,
      "text": "Cool in muffin cups 5 minutes. Transfer to a wire rack. Serve warm or cooled."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

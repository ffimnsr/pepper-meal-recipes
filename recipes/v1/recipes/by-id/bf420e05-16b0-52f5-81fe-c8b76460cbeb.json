  "id": "bf420e05-16b0-52f5-81fe-c8b76460cbeb",
  "slug": "strawberry-biscuits-recipe-7564428",
  "name": "Strawberry Biscuits",
  "recipe_type": "dessert",
  "brief_description": "These strawberry biscuits make a great on-the-go breakfast, or a nice ending to dinner. Drizzle with glaze to make them a bit sweeter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, the 1/4 cup sugar, baking powder, and salt in a large bowl. Grate frozen butter into dry ingredients. Gently mix. Add strawberries and mix until strawberries are coated with the flour mixture."
    },
    {
      "position": 3,
      "text": "Combine buttermilk and vanilla. Pour into strawberry mixture and stir until barely combined. Do not overmix or biscuits will be tough."
    },
    {
      "position": 4,
      "text": "Use an ice cream scoop to scoop biscuits onto the prepared baking sheet. Brush top of biscuits with heavy cream and sprinkle with the 2 tablespoons sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bottoms are browned, 15 to 17 minutes. Let sit for 5 minutes. Remove biscuits and cool completely on a wire rack."
    },
    {
      "position": 6,
      "text": "Whisk powdered sugar and milk together in a cup. Drizzle over biscuits."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

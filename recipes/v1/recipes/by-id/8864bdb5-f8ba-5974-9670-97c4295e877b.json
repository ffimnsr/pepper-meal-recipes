  "id": "8864bdb5-f8ba-5974-9670-97c4295e877b",
  "slug": "russian-tea-cakes-i",
  "name": "Russian Tea Cakes",
  "recipe_type": "dessert",
  "brief_description": "Russian tea cakes are smooth and nutty cookies rolled in sweet powdered sugar. This recipe from Lithuania has been a family favorite for generations!",
  "cuisine": "Russian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Cream butter and vanilla together in a medium bowl with an electric mixer until smooth, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Whisk flour and 6 tablespoons powdered sugar together in separate bowl. Add to the butter mixture and stir until just blended. Add walnuts and mix until incorporated; mixture may be crumbly."
    },
    {
      "position": 5,
      "text": "Take small scoops of dough and roll between your hands into 1-inch balls. Place balls 2 inches apart on ungreased cookie sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are just turning golden, about 12 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and transfer to a wire rack to cool for 15 minutes."
    },
    {
      "position": 8,
      "text": "Place remaining 1/3 cup powdered sugar in a small bowl. Roll cooled cookies in the powdered sugar once or twice."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "63f96303-17cf-5fef-9d0c-ba8bba330a8d",
  "slug": "everybody-loves-pilaf",
  "name": "Everybody Loves Pilaf",
  "recipe_type": "side",
  "brief_description": "This Mediterranean rice pilaf with butter, toasted pine nuts, and parsley is simple to make and sure to please even the pickiest eaters.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread pine nuts on a baking sheet."
    },
    {
      "position": 2,
      "text": "Toast in the preheated oven until golden brown, about 12 minutes."
    },
    {
      "position": 3,
      "text": "Melt butter in a saucepan over medium-low heat. Increase heat to medium and stir in spaghetti; cook until coated with melted butter and lightly browned, 3 to 5 minutes. Add onion and garlic; cook until tender, about 2 minutes. Stir in rice; cook for 5 minutes."
    },
    {
      "position": 4,
      "text": "Pour broth into the saucepan. Bring to a boil; cover and cook until rice is tender until liquid has been absorbed, about 20 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Mix toasted pine nuts and parsley into the rice mixture."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 47,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

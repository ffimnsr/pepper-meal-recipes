  "id": "1e9986eb-30f8-510d-af83-29bb2b644eee",
  "slug": "breakfast-kolaches",
  "name": "Breakfast Kolaches",
  "recipe_type": "breakfast",
  "brief_description": "Little dough balls, conveniently prepared with the help of the bread machine are stuffed with sausage, cheese, and potatoes in these breakfast kolaches.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make the dough: Place milk, egg, egg yolk, butter, flour, salt, sugar, and yeast into a bread machine in the order listed, or follow the order recommended by your manufacturer if different. Run the Dough cycle, about 1 1/2 hours."
    },
    {
      "position": 2,
      "text": "When the cycle is finished, preheat the oven to 375 degrees F (190 degrees C). Lightly grease a large baking sheet."
    },
    {
      "position": 3,
      "text": "Punch down dough on a lightly floured surface and divide into 36 pieces. Roll pieces into balls. Arrange balls in a single layer on the prepared baking sheet, about 2 inches apart. Allow balls to rise, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Flatten balls, and make a depression in the center of each. Fill each with 1 piece sausage, about 1 tablespoon potatoes, and 1 square Cheddar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned, 15 to 18 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "e464fde6-f07a-50bf-a4c0-28fe5a6f3e78",
  "slug": "bacon-cheeseburger-omelette",
  "name": "Bacon Cheeseburger Omelette",
  "recipe_type": "breakfast",
  "brief_description": "All of the flavors you love in a bacon cheeseburger come together in this hearty breakfast omelette.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Transfer bacon to a paper towel-lined plate, reserving grease in the skillet. Crumble bacon once cool."
    },
    {
      "position": 2,
      "text": "Add onion to the skillet and cook over medium-high heat for 2 minutes. Add ground beef and cook, breaking into smaller pieces, until no longer pink, about 5 minutes. Drain any excess grease."
    },
    {
      "position": 3,
      "text": "Add Worcestershire sauce, mustard, and ketchup to the beef mixture. Bring to a simmer, mixing until everything is incorporated."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a separate skillet over medium heat. Whisk eggs and milk together and pour into the skillet, swirling to coat the bottom. Cook until eggs are just set, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Place bacon, beef mixture, tomatoes, pickles, and lettuce over one half of the omelette. Fold the other half over the filling. Top with Cheddar cheese. Cover skillet and cook until cheese is melted, about 1 minute. Garnish omelette with shoestring potatoes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

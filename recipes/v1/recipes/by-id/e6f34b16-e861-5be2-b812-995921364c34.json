  "id": "e6f34b16-e861-5be2-b812-995921364c34",
  "slug": "easy-and-delicious-mexican-pork-chops",
  "name": "Easy and Delicious Mexican Pork Chops",
  "recipe_type": "main",
  "brief_description": "Pork chops bake up tender in a bed of Mexican-style rice for a dinner you can fix anytime with basics you probably keep on hand.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Season pork chops with salt and black pepper. Heat vegetable oil in a large skillet over medium heat. Add chops; brown on both sides, about 5 minutes per side. Set aside."
    },
    {
      "position": 3,
      "text": "Combine water, rice, tomato sauce, picante sauce, and taco seasoning in the prepared baking dish. Lay chops in rice mixture; top with bell pepper slices. Cover the dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until chops no longer pink inside and rice tender, about 1 hour. An instant-read thermometer inserted into the thickest part of a chop should read 145 degrees F (63 degrees C). Uncover the dish; sprinkle with Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Continue to bake, uncovered, until cheese bubbly and melted, 5 to 10 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "c1b7bbfb-8e65-518c-aebc-5b5b5003a8af",
  "slug": "pressure-cooker-mashed-potatoes",
  "name": "Pressure Cooker Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These fluffy mashed potatoes made in the pressure cooker with butter and milk are seasoned perfectly for a rich and comforting side dish.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a pressure cooker over high heat. When water is boiling, add potatoes. Seal lid and bring cooker up to high pressure. Reduce heat to low, maintaining high pressure, and cook for 15 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Use quick-release method to lower the pressure. Drain potatoes and return them to pressure cooker. Add butter and milk and cover pressure cooker with lid for 5 minutes, allowing the heat from the potatoes to melt the butter and warm the milk."
    },
    {
      "position": 3,
      "text": "Remove lid. Season with kosher salt and white pepper, and use a hand masher to mash potatoes until lumps are mostly gone. Transfer to a bowl and serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

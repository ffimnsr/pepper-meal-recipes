  "id": "26cbc70d-3248-5d6a-86aa-bb19ae6cad78",
  "slug": "salami-ham-and-pepperoni-sandwiches-in-the-air-fryer",
  "name": "Salami, Ham, and Pepperoni Sandwiches in the Air Fryer",
  "recipe_type": "main",
  "brief_description": "Use your air fryer to whip up this delicious warm salami sandwich with ham and pepperoni.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place mushrooms in the basket of the air fryer. Set air fryer to 350 degrees F (175 degrees C) and cook mushroom slices for 5 minutes."
    },
    {
      "position": 2,
      "text": "Spread 1 tablespoon pesto onto the bottom half of the hoagie bun. Arrange salami slices over the pesto. Add ham and pepperoni."
    },
    {
      "position": 3,
      "text": "Place 1 slice of cheese over the ham and pepperoni. Top with mushrooms and olives. Add remaining slice of cheese. Spread remaining tablespoon of pesto on the other half of the bun and place on top to complete the sandwich."
    },
    {
      "position": 4,
      "text": "Place entire sandwich in the basket of the air fryer. Cook until cheese has melted and salami is crisp, about 5 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

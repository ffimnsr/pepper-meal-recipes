  "id": "08a26d2c-7d9f-5ccd-9209-2810f4df6703",
  "slug": "slow-cooker-root-beer-pulled-pork",
  "name": "Slow Cooker Root Beer Pulled Pork",
  "recipe_type": "drink",
  "brief_description": "This root beer pulled pork recipe is easy and tasty. Root beer, liquid smoke, and garlic are all you need for this favorite dish to serve with BBQ.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork roast in a slow cooker, rub with salt, and pour root beer, liquid smoke, and garlic over the top."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 10 hours. Remove pork to a bowl. Strain liquid through a fine-mesh strainer; discard liquid or save for another use (see Editor\u2019s Notes). Add garlic cloves back to pork. Shred pork using two forks. Serve with your favorite BBQ sauce."
    }
  ],

  "id": "27e026df-edcf-57a0-8493-e23bc3bc790a",
  "slug": "cream-of-mushroom-soup-i",
  "name": "Cream of Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "Cream of mushroom soup made from scratch with freshly sliced mushrooms, onion, thyme, stock, cream, and a splash of sherry for a classic favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Simmer mushrooms, stock, onion, and thyme in a large heavy saucepan until vegetables are tender, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Carefully transfer the hot mixture to a blender or food processor. Cover and hold lid down with a potholder; pulse until creamy but still with some chunks of vegetable."
    },
    {
      "position": 4,
      "text": "Melt butter in the same saucepan. Whisk in flour until smooth. Whisk in salt and pepper. Slowly whisk in half-and-half and mushroom mixture."
    },
    {
      "position": 5,
      "text": "Bring soup to a boil and cook, stirring constantly, until thickened."
    },
    {
      "position": 6,
      "text": "Stir in sherry. Taste and season with more salt and pepper if needed."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

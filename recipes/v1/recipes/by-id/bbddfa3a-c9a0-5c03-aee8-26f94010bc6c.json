  "id": "bbddfa3a-c9a0-5c03-aee8-26f94010bc6c",
  "slug": "aracelys-flan",
  "name": "Aracely's Flan",
  "recipe_type": "dessert",
  "brief_description": "This is an authentic and simple flan recipe that is steamed not baked. It has been passed down through 4 generations and is requested at every family gathering. It is to die for!",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together the yolks, condensed milk, and evaporated milk; set aside. Melt margarine in a small saucepan over medium heat. Stir in the brown sugar; keep stirring until the brown sugar has dissolved, and is smooth. Evenly spread the sugar over the bottom of a pie plate, then pour in the custard. Cover with foil. (See Cook's Note.)"
    },
    {
      "position": 2,
      "text": "Fill a large pot approximately 3/4 full with water and bring to a simmer on the stove. Place the pie plate over the simmering water and cook for 65 to 70 minutes, until flan has set. Remove flan from the boiling water and allow to cool for at least 30 minutes."
    },
    {
      "position": 3,
      "text": "To serve, loosen the flan from the pie plate by running a knife around the edges; invert onto a serving plate. Serve at room temperature or cold."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

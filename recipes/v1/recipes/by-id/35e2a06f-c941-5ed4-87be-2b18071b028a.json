  "id": "35e2a06f-c941-5ed4-87be-2b18071b028a",
  "slug": "irish-potato-farls",
  "name": "Irish Potato Farls",
  "recipe_type": "breakfast",
  "brief_description": "Potato farls (also known as potato bread) are easy to make with mashed potatoes, flour, butter, and salt for a delicious addition to an Irish breakfast.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cover potatoes with water in a pot and bring to a boil over high heat. Simmer on medium-high heat until center of potatoes are tender when pricked with a fork, about 20 minutes. Turn off heat. Drain, return potatoes to the pot, and allow to completely dry out over the remaining residual heat."
    },
    {
      "position": 3,
      "text": "Mash with a potato masher until smooth."
    },
    {
      "position": 4,
      "text": "Place warm mashed potato in a medium bowl. Stir in flour, melted butter, and salt. Mix lightly until dough forms."
    },
    {
      "position": 5,
      "text": "Knead dough lightly on a well-floured surface. The dough will be sticky. Use a floured rolling pin to flatten into a 9-inch circle about 1/4 inch thick. Cut into quarters using a floured knife."
    },
    {
      "position": 6,
      "text": "Sprinkle a little flour into the bottom of a skillet and cook farls until evenly browned, about 3 minutes on each side. Season with a little salt and serve straight away."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

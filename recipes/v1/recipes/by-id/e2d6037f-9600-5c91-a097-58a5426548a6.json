  "schema_version": 1,
  "id": "e2d6037f-9600-5c91-a097-58a5426548a6",
  "slug": "chef-johns-classic-macaroni-salad",
  "name": "Chef John's Classic Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John's classic macaroni salad recipe is less sweet than deli-style but this crowd-pleaser is full of colorful veggies and a perfect side for cookouts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1 cup mayonnaise, vinegar, Dijon, salt, black pepper, and cayenne pepper together in a bowl until dressing is well blended; whisk in sugar."
    },
    {
      "position": 2,
      "text": "Stir celery, bell pepper, carrot, green onions, jalape\u00f1o pepper, and poblano pepper into dressing. Cover the bowl with plastic wrap; refrigerate until macaroni is ready."
    },
    {
      "position": 3,
      "text": "Bring a large pot of generously salted water to a boil. Cook macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain in a colander for about 5 minutes, shaking out the moisture from time to time, but do not rinse."
    },
    {
      "position": 4,
      "text": "Transfer macaroni to a large bowl; toss to separate. Cool to room temperature, 10 to 15 minutes. Macaroni should be sticky."
    },
    {
      "position": 5,
      "text": "Add celery mixture to macaroni; stir until evenly distributed. Cover the bowl with plastic wrap; refrigerate until macaroni absorbs dressing, 4 hours to overnight."
    },
    {
      "position": 6,
      "text": "Stir salad; stir water and remaining 1 tablespoon mayonnaise into salad to refresh before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

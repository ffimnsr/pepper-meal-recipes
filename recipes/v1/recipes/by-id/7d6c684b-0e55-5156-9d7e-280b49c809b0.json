  "id": "7d6c684b-0e55-5156-9d7e-280b49c809b0",
  "slug": "cheesy-buffalo-chicken-dip",
  "name": "Cheesy Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Buffalo shredded chicken dip features a tasty blend of ranch and blue cheese dressings for a hot, cheesy, flavorful appetizer served with chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts in a large saucepan; cover with water. Bring to a boil and cook until no longer pink in the center and the juices run clear, about 20 minutes. An instant-read thermometer inserted into the center of a breast should read at least 165 degrees F (74 degrees C). Drain and allow chicken to cool enough to handle. Pull meat from bones and skin. Shred meat and set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat. Cook and stir celery in hot oil until soft. Mix in cream cheese, blue cheese dressing, and ranch dressing. Cook and stir until smooth and creamy. Stir in shredded chicken and hot sauce. Transfer to an 8x8-inch baking dish and sprinkle with shredded cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden and bubbly, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c3a03872-4e5d-5a43-bafe-951d0c3fa6eb",
  "slug": "lemony-chicken-ricotta-meatball-pasta-bake-recipe-11853273",
  "name": "Lemony Chicken Ricotta Meatball Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This pasta bake featuring chicken ricotta meatballs in a lemony cheese sauce hits all the spots. The meatballs come out moist and tasty and fresh spinach adds color and flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the broiler. Line a rimmed baking pan with foil. Grease a 13x9-inch baking dish."
    },
    {
      "position": 3,
      "text": "Cook the pasta according to package instructions. Drain and return to pot. Add spinach. Stir until spinach wilts. Transfer pasta mixture to the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Beat egg in a large bowl. Add ricotta cheese, bread crumbs, onion, Parmesan cheese, parsley, lemon zest, lemon juice, Italian seasoning, crushed red pepper, salt, and pepper. Stir to combine. Add ground chicken and mix well."
    },
    {
      "position": 5,
      "text": "Use a 1 1/2 inch (1 1/2 tablespoon) scoop to portion mixture into 32 meatballs."
    },
    {
      "position": 6,
      "text": "Place on a foil lined pan and broil on the middle rack for 5 minutes."
    },
    {
      "position": 7,
      "text": "Transfer meatballs to the baking dish with pasta mixture, gently nestling meatballs into the pasta; set aside. Reduce oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 8,
      "text": "For the sauce, combine butter and garlic in a large skillet. Cook and stir over medium-high heat until fragrant, 1 to 2 minutes. Add whipping cream and bring to a simmer. Stir in Parmesan cheese, lemon zest, crushed red pepper, salt, and black pepper, stirring until cheese melts."
    },
    {
      "position": 9,
      "text": "Pour sauce over pasta and meatballs. Cover with foil and bake for 15 minutes. Remove foil and bake, uncovered, until heated through, 10 to 15 minutes. Stir before serving. Garnish with additional Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

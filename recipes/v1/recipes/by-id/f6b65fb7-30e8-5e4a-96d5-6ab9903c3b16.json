  "slug": "blue-cheese-and-pear-tartlets",
  "name": "Blue Cheese and Pear Tartlets",
  "recipe_type": "appetizer",
  "brief_description": "Tasty, hot blue cheese tartlet appetizers that take little time to prepare but will impress your guests!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together pear, blue cheese, and cream in a baking dish. Season with pepper. Spoon mixture into phyllo shells."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Serve warm."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 15,

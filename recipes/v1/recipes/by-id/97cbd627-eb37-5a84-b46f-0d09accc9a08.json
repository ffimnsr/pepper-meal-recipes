{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "97cbd627-eb37-5a84-b46f-0d09accc9a08",
  "slug": "bacon-jalapeno-popper-puffs",
  "name": "Bacon Jalape\u00f1o Popper Puffs",
  "recipe_type": "appetizer",
  "brief_description": "If you love bacon-wrapped jalape\u00f1o poppers, you'll love this recipe for light puffs with all the same flavors. Plus they're so much easier to make!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make the dipping sauce: Mix cream cheese, cr\u00e8me fra\u00eeche, green onions, and lime juice together in a bowl. If mixture seems too thick, add enough water to thin it to your preferred consistency."
    },
    {
      "position": 2,
      "text": "Make the puffs: Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned and crisp, about 10 minutes. Drain bacon slices on paper towels. Crumble or finely chop. Drain fat from skillet, reserving 1 tablespoon."
    },
    {
      "position": 3,
      "text": "Place skillet over medium-high heat. Add cold water, butter, reserved bacon fat, and salt. Bring mixture to a simmer; reduce heat to medium. Pour in flour all at once. Stir to mix and mash with a wooden spoon until dough starts to pull together, 2 to 3 minutes. Remove pan from heat; transfer dough to a mixing bowl and let cool for about 5 minutes."
    },
    {
      "position": 4,
      "text": "When dough is cool, whisk in 1 egg. Mixture will separate slightly. Continue whisking in first egg until mixture pulls back together. Repeat with the second egg. Scrape down sides of bowl. Add diced jalape\u00f1o, bacon pieces, shredded cheese, cayenne pepper, and black pepper. Mix thoroughly with a spatula. Wrap dough in plastic wrap and refrigerate until cool, 30 minutes to 1 hour."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Using a small scoop, scoop out rounds of dough. Drop rounds of dough into hot oil and cook until golden brown and cooked through, 3 to 4 minutes. Work in batches if necessary. Transfer to a cooling rack."
    },
    {
      "position": 7,
      "text": "Serve with dipping sauce garnished with a few green onion slices."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

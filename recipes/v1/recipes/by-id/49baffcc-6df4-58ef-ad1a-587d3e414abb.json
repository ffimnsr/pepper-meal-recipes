  "id": "49baffcc-6df4-58ef-ad1a-587d3e414abb",
  "slug": "shortbread-cookies-ii",
  "name": "Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These classic shortbread cookies are buttery, tender, and melt in your mouth\u2014made with just 4 ingredients and perfect for holiday cookie trays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 3,
      "text": "Beat softened butter and sugar together in a large bowl with an electric mixer on medium speed until light and fluffy, about 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Stir in vanilla; add flour gradually, mixing until a smooth dough forms."
    },
    {
      "position": 5,
      "text": "Fill cookie press with dough and form cookies onto two ungreased cookie sheets, spacing them about 1 \u00bd inches apart. Bake in the preheated oven until the edges of the cookies are just starting to turn golden brown, about 10 to 12 minutes."
    },
    {
      "position": 6,
      "text": "Remove the cookie sheets from the oven, and set them on a wire cooling rack for a few minutes. Then transfer the shortbread cookies to the rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "a1d65f62-53a3-5715-a1f3-274623e8b15c",
  "slug": "baked-falafel",
  "name": "Baked Falafel",
  "recipe_type": "main",
  "brief_description": "This falafel is lightly pan-fried, then finished in the oven.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Wrap onion in cheese cloth and squeeze out as much moisture as possible. Set aside. Place garbanzo beans, parsley, garlic, cumin, coriander, salt, and baking soda in a food processor. Process until the mixture is coarsely pureed. Mix garbanzo bean mixture and onion together in a bowl. Stir in the flour and egg. Shape mixture into four large patties and let stand for 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large, oven-safe skillet over medium-high heat. Place the patties in the skillet; cook until golden brown, about 3 minutes on each side."
    },
    {
      "position": 4,
      "text": "Transfer skillet to the preheated oven and bake until heated through, about 10 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

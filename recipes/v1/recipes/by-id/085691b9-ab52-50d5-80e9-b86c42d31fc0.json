  "id": "085691b9-ab52-50d5-80e9-b86c42d31fc0",
  "slug": "grilled-sausage-with-potatoes-and-green-beans",
  "name": "Grilled Sausage with Potatoes and Green Beans",
  "recipe_type": "main",
  "brief_description": "Grilled sausage and vegetables are easy to cook on the grill in a foil packet \u2014 perfect for camping or a crowd-pleasing summer meal!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat."
    },
    {
      "position": 2,
      "text": "Place green beans, red potatoes, onion, and sausage on a large sheet of foil. Season with salt and pepper, sprinkle with oil, and top with butter. Tightly seal foil around the ingredients, leaving only a small opening. Pour water into the opening, and seal."
    },
    {
      "position": 3,
      "text": "Place foil packet on the preheated grill. Cook 20 to 30 minutes, turning once, until sausage is browned and vegetables are tender."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,

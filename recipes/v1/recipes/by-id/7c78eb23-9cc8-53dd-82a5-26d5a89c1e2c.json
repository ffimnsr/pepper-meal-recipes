  "id": "7c78eb23-9cc8-53dd-82a5-26d5a89c1e2c",
  "slug": "west-african-peanut-soup",
  "name": "Easy African Peanut Soup",
  "recipe_type": "soup",
  "brief_description": "A delightful flavor combination of peanut butter and tomatoes make this soup an unconventional favorite. Freezes and reheats well!",
  "cuisine": "West African African",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large stock pot over medium-high heat. Cook onion, bell pepper, and garlic until lightly browned, about 5 minutes. Stir in tomatoes with their juice, vegetable broth, pepper, and red pepper flakes. Simmer, uncovered, for 15 minutes."
    },
    {
      "position": 2,
      "text": "Add rice to soup and stir. Reduce heat, cover, and simmer 25 minutes, or until rice is tender."
    },
    {
      "position": 3,
      "text": "When rice is cooked, whisk in peanut butter and return to a simmer, and serve. Garnish with chopped roasted peanuts, if desired."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "7890b60d-887d-5e7f-87a2-a4a5ec4886cf",
  "slug": "never-never-ever-ever-fail-fudge",
  "name": "Never-Never Ever-Ever Fail Fudge",
  "recipe_type": "dessert",
  "brief_description": "Evaporated milk and sugar are boiled then combined with marshmallows, chocolate chips, vanilla and walnuts in this easy fudge.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan over medium heat, combine evaporated milk, sugar and salt. Bring to a boil, then remove from heat and stir in marshmallows, chocolate chips, vanilla and nuts until marshmallows are melted. Pour into an 8x8 inch dish. Let cool completely before cutting into squares."
    }
  ],

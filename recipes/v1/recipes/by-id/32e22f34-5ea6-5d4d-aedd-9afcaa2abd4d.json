  "id": "32e22f34-5ea6-5d4d-aedd-9afcaa2abd4d",
  "slug": "cheesy-chicken-pot-pie",
  "name": "Cheesy Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This cheesy chicken pot pie is the best meat pie I have ever eaten! This recipe makes good use of any chicken or turkey leftovers. Great comfort food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan combine the stock, chicken, peas, celery, and carrots. Bring to a boil."
    },
    {
      "position": 2,
      "text": "Mix cornstarch with milk and stir into the stock mixture. Cook stirring constantly for 5 minutes. Remove from heat and let cool for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Stir cheese into the filling mixture and pour into a 9-inch pie crust. Top with second crust, seal edges, and cut slits in the top crust. Place on a cookie sheet and bake for 35 to 40 minutes or until the top crust is golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e6c2a74e-9a28-5cf9-a4cd-3d1f8f8661d7",
  "slug": "cheeseburger-casserole-with-tater-tots",
  "name": "Cheeseburger Tater Tot Casserole",
  "recipe_type": "main",
  "brief_description": "This cheeseburger tater tot casserole is easy to make with ground beef, crispy and tender tots, and melted cheese for a comfort food classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place onion in a microwave-safe bowl and cover with water. Microwave on high until soft, 7 to 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch casserole dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Cook and stir ground beef in a large nonstick skillet over medium-high heat until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 4,
      "text": "Transfer beef to the prepared casserole dish and spread onion pieces evenly over top. Spread soup over onions and sprinkle Cheddar cheese evenly over soup. Layer frozen potato nuggets in rows on cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Lightly spray potato nuggets with cooking spray, and bake until cooked through and crunchy, about 10 minutes more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

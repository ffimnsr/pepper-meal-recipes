  "id": "58f3aa33-8872-5324-87a2-d6e9250c6bc6",
  "slug": "sweet-rice",
  "name": "Sweet Rice",
  "recipe_type": "dessert",
  "brief_description": "Sweet rice, known as arroz con leche, is a lovely custard-like Mexican rice pudding with raisins, lightly flavored with cream, vanilla, and cinnamon.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, rice, and butter to a boil in a large saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid is absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Whisk together 2 cups milk, sugar, egg, flour, and vanilla in a bowl; pour over cooked rice in the saucepan and stir to combine. Bring to a simmer over low heat and cook, stirring occasionally, for 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in remaining 1 cup milk, cream, raisins, and cinnamon until thoroughly mixed. Let cool for a few minutes. Serve warm or cold."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f0b76e30-728a-5303-b481-660ec0a4c872",
  "slug": "slow-cooker-jalapeno-chicken-recipe-11774043",
  "name": "Slow Cooker Jalape\u00f1o Chicken",
  "recipe_type": "dessert",
  "brief_description": "This slow cooker jalapeno chicken has a salty-sweet sauce that gets its heat from fresh jalapenos. Serve it over rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, onions, jalapenos, garlic, soy sauce, brown sugar, water, black pepper, and salt in a slow cooker. Cover with lid and cook on Low for 4 hours."
    },
    {
      "position": 2,
      "text": "Combine cornstarch and water in a small bowl. Slowly add to the slow cooker, stirring until well combined and the sauce begins to thicken."
    },
    {
      "position": 3,
      "text": "Garnish with green onions."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 240,

  "id": "373a55cf-2958-585b-b0f9-f73e3f5d640c",
  "slug": "mama-kathys-minestrone",
  "name": "Mama Kathy's Minestrone",
  "recipe_type": "soup",
  "brief_description": "This is a tasty and filling soup for those cold winter nights. The mix of the vegetables tastes wonderful. Make homemade baked bread and you will have a winter's delight.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place the beef, onion, and garlic in a skillet over medium heat. Cook until beef is evenly brown and onion is tender. Drain grease."
    },
    {
      "position": 2,
      "text": "Transfer beef, onion, and garlic to a large pot. Mix in tomatoes, tomato sauce, water, peas, carrots, spinach, bouillon cube, and pepper. Bring to a boil. Reduce heat to low, and cook 1 hour, stirring occasionally. Add more water or tomato sauce as needed."
    },
    {
      "position": 3,
      "text": "Stir macaroni into the soup. Season with Italian seasoning. Continue cooking 10 minutes, or until macaroni is tender."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

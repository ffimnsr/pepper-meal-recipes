  "id": "dfc6ce21-49e6-5e6e-8fab-e2f2a9dde0eb",
  "slug": "crustless-spinach-quiche",
  "name": "Crustless Spinach Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This crustless quiche made with eggs, spinach, and Muenster cheese is quick and easy to bake in just 30 minutes for a delicious breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch pie pan."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Add onions and cook, stirring occasionally, until soft, about 3 minutes. Stir in spinach and continue to cook until excess moisture has evaporated."
    },
    {
      "position": 3,
      "text": "Whisk together eggs, salt, and pepper in a large bowl. Add Muenster cheese and spinach mixture and stir until well blended."
    },
    {
      "position": 4,
      "text": "Pour into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until eggs have set, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool for 10 minutes before serving."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

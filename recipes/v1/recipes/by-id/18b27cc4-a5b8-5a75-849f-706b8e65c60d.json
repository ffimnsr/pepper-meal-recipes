  "id": "18b27cc4-a5b8-5a75-849f-706b8e65c60d",
  "slug": "chocolate-pudding-cake-recipe-11894840",
  "name": "Ooey Gooey Chocolate Pudding Cake",
  "recipe_type": "dessert",
  "brief_description": "This chocolate pudding cake is moist, delicious, fudgy yet fluffy, and so delicious that it will have you wanting seconds. It has a fabulous texture and it's easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a Bundt cake pan (I like Baker\u2019s Joy spray)."
    },
    {
      "position": 2,
      "text": "Chop the chocolate chips; set aside."
    },
    {
      "position": 3,
      "text": "Add cake mix, instant pudding mix, sour cream, eggs, melted butter, and water to a large bowl. Beat with an electric mixer until creamy and fluffy, about 3 minutes. Fold in chopped chocolate chips."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared Bundt pan. Smooth and spread evenly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, 40 to 44 minutes. Remove from the oven, let cool for a full 10 minutes, and then invert onto a cake plate. Let cool completely, about 50 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, for frosting, combine softened butter, confectioner\u2019s sugar, milk, vanilla, and cocoa in a medium mixing bowl. Beat until nice and creamy, about 2 minutes."
    },
    {
      "position": 7,
      "text": "Frost cooled cake. Cut a slice and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

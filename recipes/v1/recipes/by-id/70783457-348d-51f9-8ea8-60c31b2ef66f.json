{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "70783457-348d-51f9-8ea8-60c31b2ef66f",
  "slug": "mediterranean-salmon-baked-in-foil-recipe-8768562",
  "name": "Mediterranean Salmon Baked in Foil",
  "recipe_type": "main",
  "brief_description": "This Mediterranean salmon, baked in foil packets with olives, artichokes, tomatoes, and Mediterranean seasonings, stays moist and tender, and cleanup is minimal.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Brush the center of each foil rectangle with a small amount of olive oil."
    },
    {
      "position": 2,
      "text": "Place a salmon filet in the center of each foil sheet. Brush filets lightly with olive oil; sprinkle with Greek seasoning."
    },
    {
      "position": 3,
      "text": "In a small bowl, combine tomatoes, artichokes, onion, olives, lemon zest and juice, minced parsley, balsamic vinegar, garlic, red pepper flakes, and 1 tablespoon olive oil. Season to taste with salt and pepper."
    },
    {
      "position": 4,
      "text": "Spoon tomato mixture evenly over filets. Pull the long ends of foil rectangles over filets and fold twice to crimp, with the foil not touching the contents. Lift each end of the packet and pinch closed. Place packets on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the center of the preheated oven for 12 to 15 minutes. An instant read thermometer, inserted into the center of filets through the foil packet, should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "To serve, place foil packs on serving plates. Open packets, drizzle with any remaining olive oil, garnish with parsley sprigs, and serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

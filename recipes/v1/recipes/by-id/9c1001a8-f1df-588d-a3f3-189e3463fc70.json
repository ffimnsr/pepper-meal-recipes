  "id": "9c1001a8-f1df-588d-a3f3-189e3463fc70",
  "slug": "superfast-asparagus",
  "name": "Spicy Cajun Asparagus",
  "recipe_type": "side",
  "brief_description": "This spicy Cajun seasoned asparagus is super easy to prep and roast any night of the week for a tasty vegetable side dish in just 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Snap asparagus spears at the tender part of the stalk. Arrange spears in one layer on a baking sheet. Spray lightly with nonstick spray; sprinkle with Cajun seasoning."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender, about 10 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

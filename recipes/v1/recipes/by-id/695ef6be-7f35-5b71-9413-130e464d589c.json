  "id": "695ef6be-7f35-5b71-9413-130e464d589c",
  "slug": "philly-fluff-cake-recipe-8714246",
  "name": "Philly Fluff Cake",
  "recipe_type": "dessert",
  "brief_description": "Philly Fluff is a popular East Coast cake-- similar to a pound cake but lighter and fluffier. Don't skip dusting it with powdered sugar!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a tube or Bundt pan and set aside."
    },
    {
      "position": 2,
      "text": "Beat butter, cream cheese, and shortening together with an electric mixer in a large bowl until light and fluffy, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, and salt together in a bowl. Beat flour mixture into cream cheese mixture and mix until well combined."
    },
    {
      "position": 4,
      "text": "Beat in 1 egg. Add 1/2 cup sugar; mix until combined. Repeat with second egg and remaining sugar; beat in last egg. Beat in vanilla extract. Pour batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 38 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Cool in the pan on a wire rack for 15 minutes. Remove cake from pan and cool completely. When cake is completely cool, sift powdered sugar in a thick layer over the whole cake."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

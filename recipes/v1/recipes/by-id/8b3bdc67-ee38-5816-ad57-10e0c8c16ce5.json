  "id": "8b3bdc67-ee38-5816-ad57-10e0c8c16ce5",
  "slug": "maple-glazed-tofu",
  "name": "Maple Glazed Tofu",
  "recipe_type": "main",
  "brief_description": "This maple tofu is a vegetarian alternative to ham that's great for holidays like Easter and Christmas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together maple syrup, pineapple juice, mustard, and soy sauce in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook and stir tofu in hot oil until evenly browned. Stir in maple syrup mixture and continue to cook until glaze is reduced. Sprinkle with sesame seeds."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

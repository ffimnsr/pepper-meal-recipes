  "id": "0aca0916-f0ed-55b2-a5fb-4f670edaeff8",
  "slug": "peach-upside-down-cake-i",
  "name": "Peach Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This peach upside-down cake with fresh caramelized peach halves makes a wonderful old-fashioned summer dessert. Serve with whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in an 8-inch square pan. Sprinkle with brown sugar and nutmeg. Arrange peach halves, cut-side down, in the prepared pan."
    },
    {
      "position": 3,
      "text": "Cream 1/2 cup butter and 1/2 cup white sugar in a large bowl with an electric mixer until light and fluffy. Beat in egg. Stir flour, baking powder and salt together; add to butter mixture alternately with milk, beating well after each addition. Spread cake batter over peaches."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned on top, 35 to 40 minutes. Remove cake from oven, and let stand in pan for 5 minutes; invert onto serving platter."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

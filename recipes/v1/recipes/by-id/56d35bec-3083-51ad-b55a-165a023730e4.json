  "id": "56d35bec-3083-51ad-b55a-165a023730e4",
  "slug": "rugelach",
  "name": "Rugelach",
  "recipe_type": "dessert",
  "brief_description": "Rugelach are crescent-shaped pastries that are easy to make at home with flaky dough and a sweet walnut-raisin filling for a delicious Jewish holiday treat.",
  "cuisine": "European American",
  "instructions": [
    {
      "position": 1,
      "text": "Place butter, cream cheese, sour cream, flour, and salt in a food processor; pulse until crumbly."
    },
    {
      "position": 2,
      "text": "Shape and press crumbly dough mixture into four equal disks. Wrap each pastry disk; chill in the refrigerator for 1 hour or up to 2 days."
    },
    {
      "position": 3,
      "text": "Combine walnuts, raisins, sugar, and cinnamon in a bowl."
    },
    {
      "position": 4,
      "text": "Roll each pastry disk into a 9-inch round keeping other disks chilled until ready to roll them. Sprinkle round with walnut-raisin mixture; press lightly into dough. Cut each round into 12 wedges with a chefs knife or pizza cutter. Roll wedges from wide to narrow, you will end up with point on outside of cookie. Place on ungreased baking sheets and chill rugelach for 20 minutes before baking."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 6,
      "text": "After rugelach are chilled, bake in the preheated oven on center rack until lightly golden, about 22 to 25 minutes; cool on wire racks."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 40,

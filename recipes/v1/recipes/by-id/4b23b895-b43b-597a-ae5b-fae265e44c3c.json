  "id": "4b23b895-b43b-597a-ae5b-fae265e44c3c",
  "slug": "carrot-cake-energy-balls-recipe-8647034",
  "name": "Carrot Cake Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "Vegan, no-bake, carrot cake energy balls made with carrots, walnuts, and coconut, are sweetened with dried fruit for all the flavors of carrot cake in one bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine dates and apricots in a small measuring cup or bowl. Add enough hot water to cover and allow fruit to soak for 15 minutes to soften."
    },
    {
      "position": 2,
      "text": "Drain dates and apricots and add to the bowl of a food processor. Add carrots, walnuts, coconut flakes, almond butter, flax meal, cinnamon, ginger, nutmeg, vanilla extract, and salt. Pulse, scraping down the sides frequently, until mixture comes together to form a mostly smooth, sticky dough, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Scoop out tablespoon-sized balls of dough using a lightly greased tablespoon measure. Roll into balls with lightly greased hands."
    },
    {
      "position": 4,
      "text": "Place bites into an airtight container and freeze until set, at least 1 hour. Keep stored in the freezer."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "dc46bcd3-05e9-5bf7-830e-2d28d1ae585c",
  "slug": "date-and-dried-cherry-mostarda-recipe-8741651",
  "name": "Date and Dried Cherry Mostarda",
  "recipe_type": "dessert",
  "brief_description": "This sweet and tangy mostarda blends the rich flavors of Medjool dates and tart cherries with a hint of orange and spice. Enjoy it warm or at room temperature for a delightful burst of flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine dates, cherries, shallot, wine, vinegar, orange zest, orange juice, sugar, crystallized ginger, salt, cinnamon, and crushed red pepper in a small saucepan. Bring to a boil; reduce heat to low and simmer, covered, until liquid is absorbed and fruit is softened, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in butter, mustard, and mustard powder. Simmer, uncovered, until mixture is thickened and jam-like, 2 to 3 minutes. Serve warm or at room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,

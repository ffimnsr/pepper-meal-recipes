  "id": "d875d7a5-cdc9-598b-9fda-049fdd953e26",
  "slug": "cheesy-artichoke-dip-by-jean-carper",
  "name": "Cheesy Artichoke Dip by Jean Carper",
  "recipe_type": "appetizer",
  "brief_description": "Here's an easy, lower-fat version of warm artichoke-cheese dip. In new research, artichoke hearts tested surprisingly high in antioxidant activity -- even more per cup than strawberries. Garlic and chives are high in antioxidants, too, and fat-free cottage cheese helps keep the fat and calorie counts down.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees."
    },
    {
      "position": 2,
      "text": "Cook artichokes according to package directions; chop roughly. Set aside."
    },
    {
      "position": 3,
      "text": "In a food processor, mix all ingredients except artichokes and Parmesan cheese until smooth."
    },
    {
      "position": 4,
      "text": "Stir in artichokes. Pour mixture into a 9-inch baking dish. Sprinkle with Parmesan."
    },
    {
      "position": 5,
      "text": "Bake for 30 minutes. If top hasn't browned, put under broiler."
    },
    {
      "position": 6,
      "text": "Let sit for 15 minutes before serving (it may be watery when first removed from the oven). Serve with toasted whole-wheat pita chips."
    }
  ],
  "servings": 9,

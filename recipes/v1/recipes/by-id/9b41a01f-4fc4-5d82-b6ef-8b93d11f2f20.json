  "id": "9b41a01f-4fc4-5d82-b6ef-8b93d11f2f20",
  "slug": "empanada-filling",
  "name": "Empanada Filling",
  "recipe_type": "appetizer",
  "brief_description": "This delicious mixture of ground beef, onions, raisins, olives, and hard-cooked eggs is a Peruvian recipe for empanada filling.",
  "cuisine": "Peruvian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour into water in a small bowl until dissolved. Set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Saut\u00e9 onion in hot oil until softened, about 5 minutes. Add ground beef, olives, cumin, and paprika. Cook and stir until beef is crumbly and completely browned, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Pour flour-water mixture into beef mixture and stir to coat evenly. Stir in raisins and cook until raisins are plump, about 5 minutes. Fold hard-cooked eggs into beef mixture; season with salt and pepper. Set aside to cool before using to fill empanadas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

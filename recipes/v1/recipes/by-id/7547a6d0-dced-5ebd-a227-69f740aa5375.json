{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7547a6d0-dced-5ebd-a227-69f740aa5375",
  "slug": "rock-salt-encrusted-prime-rib",
  "name": "Rock Salt-Encrusted Prime Rib",
  "recipe_type": "main",
  "brief_description": "Try this rock salt prime rib for moist, juicy, and tender meat that\u2019s full of flavor. Make au jus separately since the roast\u2019s drippings will be too salty to use.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Rinse roast and pat dry with paper towels. Mix soup mix and pepper together in a small bowl; rub generously over all sides of roast. Place roast onto a clean, dry baking sheet; let rest for 30 to 45 minutes."
    },
    {
      "position": 3,
      "text": "Mix rock salt, flour, and rosemary together in a bowl. Gradually pour in water and mix by hand (wear gloves if desired) until batter is thick and paste-like, adding more water if necessary."
    },
    {
      "position": 4,
      "text": "Spread salt batter into the bottom of a roasting pan to make a 1/2- to 3/4-inch-thick layer; reserve 1 to 2 cups batter. Place roast, with the bones facing down, on batter in the center of the pan. Pull batter up and around roast until meat is completely covered. Pat on extra batter if necessary. Insert an oven-safe meat thermometer into the roast so its gauge will be visible from the front of the oven."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven for 15 to 20 minutes. Remove from the oven and patch any holes or breaks in the coating with remaining salt batter."
    },
    {
      "position": 6,
      "text": "Return roast to the oven and cook until internal temperature reaches 130 degrees F (54 degrees C), about 3 hours, or to desired doneness. Remove from the oven and let rest until internal temperature reaches 140 degrees F (60 degrees C), 20 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Chip off and discard salt crust, then slice and serve."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 30,

  "slug": "italian-cherry-margarita-recipe-11775821",
  "name": "Italian Cherry Margarita",
  "recipe_type": "appetizer",
  "brief_description": "In this Italian cherry margarita, amaretto and fresh cherries join up with lime and tequila for a refreshing cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cherries and lime juice in a shaker and muddle to loosen the cherry juices."
    },
    {
      "position": 2,
      "text": "Fill shaker with ice, add tequila and amaretto, and shake until well blended and slightly frothy. Strain over ice and garnish with a cherry."
    }
  ],
  "servings": 1,

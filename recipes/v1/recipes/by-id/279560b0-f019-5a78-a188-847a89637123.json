  "id": "279560b0-f019-5a78-a188-847a89637123",
  "slug": "pina-colada-cake-hybrid-pineapple-upside-down-cake",
  "name": "Pina Colada Cake (Hybrid Pineapple Upside-Down Cake)",
  "recipe_type": "dessert",
  "brief_description": "This hybrid pineapple upside-down cake uses crushed pineapple, coconut, and honey, plus a box of yellow cake mix.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a 9x13-inch glass baking pan over low heat on the stove. Add 1 stick butter and heat until melted, about 5 minutes. Remove from heat and cover with brown sugar, mashing it into the butter using a fork. Let cool and refrigerate baking pan until butter hardens, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Remove baking pan from the refrigerator and cover brown sugar mixture with an even layer of crushed pineapple."
    },
    {
      "position": 4,
      "text": "Blend cake mix, 1 cup reserved pineapple juice, eggs, and 1/3 cup melted butter together in a large bowl using an electric mixer until moistened. Beat on low speed for 2 additional minutes and allow batter to thicken, about 3 minutes. Add honey and coconut."
    },
    {
      "position": 5,
      "text": "Pour batter over the crushed pineapple in the baking pan, smoothing to an even layer."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 25 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Serve while still warm. Cut cake and flip over onto plates, with brown sugar and pineapple on top."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

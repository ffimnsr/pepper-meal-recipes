  "id": "cb580cf0-ec90-5358-b9a9-d64ef54b7036",
  "slug": "apple-pie-monkey-bread-recipe-11830799",
  "name": "Apple Pie Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "This apple pie monkey bread layers apple pie filling with cinnamon sugar-coated biscuit dough pieces for a fall-spiced treat. Baked in a Bundt pan and turned out onto a serving plate, this bread is fun to pull apart.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a bundt pan (or a 9x13-inch baking dish if you don\u2019t have one)."
    },
    {
      "position": 2,
      "text": "Open the biscuit cans and cut each biscuit into quarters."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine granulated sugar and cinnamon. Toss biscuit pieces in the mixture until evenly coated."
    },
    {
      "position": 4,
      "text": "Pour apple pie filling into a bowl and roughly chop the apples into smaller bite-sized pieces for easier layering."
    },
    {
      "position": 5,
      "text": "Add half of coated biscuit pieces to the prepared pan. Spoon half of apple pie filling over biscuits. Repeat with remaining biscuits and apple filling."
    },
    {
      "position": 6,
      "text": "In a small bowl, stir melted butter and brown sugar together until combined. Pour evenly over the layered biscuits and apples."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until biscuits are cooked through and golden brown on top, for 35 to 40 minutes. If the top begins to brown too quickly, cover loosely with foil during the last 10 minutes."
    },
    {
      "position": 8,
      "text": "Allow monkey bread to cool in the pan for 10 minutes, then carefully invert onto a serving plate."
    },
    {
      "position": 9,
      "text": "For the optional glaze, whisk confectioner\u2019s sugar and milk together until smooth. Drizzle over warm monkey bread before serving."
    },
    {
      "position": 10,
      "text": "Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

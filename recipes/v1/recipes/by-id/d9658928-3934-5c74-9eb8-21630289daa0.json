  "id": "d9658928-3934-5c74-9eb8-21630289daa0",
  "slug": "million-dollar-stuffed-shells-recipe-11694827",
  "name": "Million Dollar Stuffed Shells",
  "recipe_type": "main",
  "brief_description": "These million dollar stuffed shells are pure comfort food. Shell pasta is stuffed with a creamy cheese filling and baked in a tasty tomato sauce with plenty of sausage.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Cook pasta 2 minutes less than package directions. Drain and rinse with cold water until cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat a large skillet over medium heat. Add Italian sausage, onion, bell pepper, and garlic; cook and stir until sausage is browned and fully cooked."
    },
    {
      "position": 4,
      "text": "Add marinara sauce, Italian seasoning, and crushed red pepper, if using. Cook over medium heat for 10 minutes, stirring occasionally, to meld flavors."
    },
    {
      "position": 5,
      "text": "Spread 2 cups sauce in the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 6,
      "text": "Combine cottage cheese, 1 cup mozzarella cheese, 1/4 cup Parmesan cheese, and parsley in a bowl."
    },
    {
      "position": 7,
      "text": "Divide cheese mixture between pasta shells, stuffing with 1 scant tablespoon per shell."
    },
    {
      "position": 8,
      "text": "Arrange shells evenly over sauce in the baking dish."
    },
    {
      "position": 9,
      "text": "Spoon remaining sauce over shells and sprinkle with remaining mozzarella and Parmesan cheese."
    },
    {
      "position": 10,
      "text": "Bake, uncovered, until cheese is melted and sauce is bubbly, 25 minutes. Tent loosely with foil if it starts to get overbrowned."
    },
    {
      "position": 11,
      "text": "Garnish with additional parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

  "slug": "copycat-cracker-barrel-hash-brown-casserole-shepherds-pie-recipe-8706205",
  "name": "Copycat Cracker Barrel Hash Brown Casserole Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Yes, you can make this copycat Cracker Barrel hash brown casserole shepherd's pie at home. You can use the linked recipes for pot roast and hash brown casserole to create leftovers, or you can use what you have.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place pot roast and gravy in a saucepan over medium heat. Stir in peas and cook until peas are heated through, 3 to 4 minutes, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Add mashed potatoes to a casserole dish and press into the pan in an even layer."
    },
    {
      "position": 3,
      "text": "Place pot roast and peas on top of potatoes. Add hash brown casserole on top of pot roast and spread into a thin even layer. Top with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, in the preheated oven until golden brown around the edges and bubbly, about 35 minutes. Sprinkle with green onions and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

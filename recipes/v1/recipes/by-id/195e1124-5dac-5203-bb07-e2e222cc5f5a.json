  "id": "195e1124-5dac-5203-bb07-e2e222cc5f5a",
  "slug": "crunchy-sugar-free-granola",
  "name": "Crunchy Sugar-Free Granola",
  "recipe_type": "breakfast",
  "brief_description": "This crispy, crunchy, sugar-free granola recipe does not contain added sugar or sugar substitutes and is a healthy, tasty breakfast or anytime snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 225 degrees F (110 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine oats, almonds, coconut, sesame seeds, cinnamon, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form; beat in vanilla extract. Fold egg whites into oat mixture; spread onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until granola is crispy, about 1 hour, stirring every 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

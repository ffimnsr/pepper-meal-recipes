  "id": "181c5570-7a83-5e4e-9782-15ea4d01a693",
  "slug": "alfredo-light",
  "name": "Alfredo Light",
  "recipe_type": "soup",
  "brief_description": "In this light Alfredo dish, whip up a delightful sauce with skim milk, broth, and flour instead of heavy cream. Parmesan cheese gives it a zing.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan, heat oil over medium heat. Add onion and garlic, and saut\u00e9 until golden brown."
    },
    {
      "position": 2,
      "text": "In a small saucepan, stir together milk, chicken broth, flour, salt, and pepper over low heat until smooth and thick. Stir into onion mixture. Continue to cook over medium-low heat, frequently stirring, until sauce is thick. Stir in Parmesan cheese."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook pasta in boiling water. Add broccoli to pasta for the last several minutes of cooking. Continue cooking until pasta is al dente."
    },
    {
      "position": 4,
      "text": "Drain pasta and vegetables, and transfer to a large bowl. Toss with sauce. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

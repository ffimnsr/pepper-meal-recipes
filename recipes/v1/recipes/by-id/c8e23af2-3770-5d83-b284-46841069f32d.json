  "id": "c8e23af2-3770-5d83-b284-46841069f32d",
  "slug": "almond-flour-bread",
  "name": "Almond Flour Bread",
  "recipe_type": "breakfast",
  "brief_description": "Almond flour bread made with almond milk and flaxseed meal; it's low-carb, easy to make, and a delicious choice for anyone who can't eat gluten or dairy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan, or line with parchment paper."
    },
    {
      "position": 3,
      "text": "Mix almond flour, flaxseed meal, eggs, almond milk, olive oil, baking powder, and salt together in a bowl until a soft dough forms."
    },
    {
      "position": 4,
      "text": "Transfer to the prepared loaf pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown on top, about 40 minutes. Cool in the loaf pan for 10 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

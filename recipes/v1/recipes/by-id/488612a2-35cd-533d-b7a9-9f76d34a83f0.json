  "id": "488612a2-35cd-533d-b7a9-9f76d34a83f0",
  "slug": "tuna-pasta-salad-with-dill",
  "name": "Tuna Pasta Salad with Dill Recipe",
  "recipe_type": "salad",
  "brief_description": "This light tuna pasta salad with dill features pickle juice, mayo, and milk for a flavorful and creamy dish ideal for cookouts and large gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil: add pasta. Cook until al dente, 8 to 10 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, milk, pickle juice, dill, salt, and pepper together in a large bowl. Mix in tuna and onion: toss with cooked pasta. Cover and refrigerate 1 to 2 hours before serving."
    }
  ],

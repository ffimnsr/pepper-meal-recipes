  "id": "a091a3ce-612a-5a3a-8753-6f814190d023",
  "slug": "enchilada-sauce-with-chocolate",
  "name": "Enchilada Sauce with Chocolate",
  "recipe_type": "soup",
  "brief_description": "This authentic enchilada sauce is made with tender onions, garlic, cumin, cinnamon, chicken broth, and semisweet chocolate for a real taste of Mexico.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan over medium-high high heat. Saut\u00e9 onion until tender. Stir in garlic, oregano, cumin and cinnamon; saut\u00e9 for a few minutes."
    },
    {
      "position": 2,
      "text": "Stir in flour and chili powder until sauce thickens. Slowly whisk in chicken broth; reduce until sauce reaches desired consistency. Stir in chocolate until melted and well blended."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

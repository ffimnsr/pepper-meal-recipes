  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9d34a998-bfef-5c81-aadf-3b5d2a63f4db",
  "slug": "air-fryer-honey-garlic-chicken-wings-recipe-7501470",
  "name": "Air Fryer Honey Garlic Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "These crispy air fryer honey garlic chicken wings are a flavor explosion in your mouth\u2013the perfect combination of crispy, juicy chicken wings and a sticky-sweet honey garlic sauce, with just the right amount of heat from cayenne pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix baking powder, salt, black pepper, garlic powder, paprika, and cayenne pepper together in a small bowl."
    },
    {
      "position": 3,
      "text": "Pat chicken wings dry with paper towels, then toss them in spice mixture until evenly coated. Arrange wings in a single layer in the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook wings in the preheated air fryer until crispy and golden brown, juices are clear, and meat is no longer pink at the bone, 20 to 25 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Meanwhile, make the honey garlic sauce. Stir honey, soy sauce, garlic, and ginger together in a small saucepan over medium heat."
    },
    {
      "position": 6,
      "text": "In a separate small bowl, whisk together cornstarch and water until smooth, then add to the saucepan. Cook until sauce thickens, 1 to 2 minutes."
    },
    {
      "position": 7,
      "text": "Transfer wings to a large bowl, pour honey garlic sauce over wings, and toss to coat evenly. Garnish with chopped green onions and serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "2165a275-19e8-52a2-85c0-f5c578636911",
  "slug": "slow-cooker-barbeque-chicken",
  "name": "Slow Cooker Barbeque Chicken",
  "recipe_type": "main",
  "brief_description": "This BBQ chicken crockpot recipe combines chicken breasts with bottled BBQ sauce, vinegar, brown sugar, and garlic in a slow cooker for an easy meal.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken breast halves in a slow cooker."
    },
    {
      "position": 3,
      "text": "Whisk together barbeque sauce, vinegar, brown sugar, garlic powder, and pepper flakes in a bowl until sugar dissolves; pour over chicken."
    },
    {
      "position": 4,
      "text": "Cook on Low for 4 to 6 hours."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 240,

  "id": "51590c24-66b7-512c-a9f6-56ffb1dcbb84",
  "slug": "charcuterie-salad-recipe-11952947",
  "name": "Charcuterie Salad",
  "recipe_type": "salad",
  "brief_description": "This charcuterie salad is great for a party, served in mini cups or bowls with a toothpick. An assortment of sausages, cheeses, olives, pickles, and peppers, marinated in a quick vinaigrette, has all the elements of a charcuterie board in one.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut salami, pepperoni, havarti, and Cheddar into 1/4- to 1/2-inch thick slices, and then cut the slices into smaller bite size pieces, about 1/2 inch in size."
    },
    {
      "position": 2,
      "text": "Add meats and cheeses to a large bowl and add red peppers, olives, with marinade, pickles and parsley and toss to combine."
    },
    {
      "position": 3,
      "text": "Add red wine vinegar, balsamic vinegar, garlic, salt, and pepper to a small bowl and whisk in olive oil until combined. Pour mixture over meat and cheese mixture and toss well to coat."
    },
    {
      "position": 4,
      "text": "Allow mixture to marinate in the fridge for at least 4 hours and up to 5 days."
    }
  ],
  "servings": 12,

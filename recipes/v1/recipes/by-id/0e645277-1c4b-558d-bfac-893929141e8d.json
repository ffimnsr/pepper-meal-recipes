  "id": "0e645277-1c4b-558d-bfac-893929141e8d",
  "slug": "pastina-casserole-recipe-11815906",
  "name": "We Turned Italian Penicillin Soup Into a Casserole for the Best 5-Ingredient Comfort-Food Dinner",
  "recipe_type": "soup",
  "brief_description": "This pastina casserole is warm and soothing with a savory, aromatic flavor from the combination of chicken broth and mirepoix. Parmesan adds a nutty complexity, and every bite tastes silky and comforting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Microwave mirepoix in a small bowl, uncovered, on High until thawed, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Add pastina, chicken broth, stock base, and thawed mirepoix to an 8-x 8-inch baking dish and stir carefully to combine. Cover with aluminum foil and very gently place in the oven."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pastina is al dente (tender with a bite) and liquid is almost absorbed, 35 to 40 minutes. Remove foil carefully and stir in Parmesan cheese. Let sit for 5 minutes before serving."
    },
    {
      "position": 5,
      "text": "Serve with additional Parmesan cheese and black pepper. Recipe developed by Isabelle Easter"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,

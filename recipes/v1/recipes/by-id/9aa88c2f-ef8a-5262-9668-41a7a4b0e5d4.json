  "id": "9aa88c2f-ef8a-5262-9668-41a7a4b0e5d4",
  "slug": "chef-johns-irish-soda-bread",
  "name": "Chef John\u2019s Irish Soda Bread",
  "recipe_type": null,
  "brief_description": "This moist soda bread recipe is flavored with buttermilk, honey, and orange zest and is perfect for St. Patrick\u2019s Day \u2014 or any time of year.",
  "cuisine": "Inspired Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper or a silicone baking mat."
    },
    {
      "position": 2,
      "text": "Whisk all-purpose flour, whole wheat flour, oats, salt, baking soda, and baking powder together in a large bowl. Cut butter into flour mixture using a pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Beat buttermilk, egg, honey, and orange zest together in a medium bowl. Pour buttermilk mixture, currants, and raisins into flour-butter mixture; stir with a wooden spoon until a wet, sticky dough comes together."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a well-floured work surface; press dough together into a ball and cut into 2 equal pieces. Form each into a smooth, round loaf."
    },
    {
      "position": 5,
      "text": "Transfer to the prepared baking sheet and let rest for 15 minutes. Cut a 1/2-inch-deep \u201cX\u201d into the top of each loaf using a serrated knife."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and fragrant, about 45 minutes. Transfer loaves to a wire rack to cool completely before slicing."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

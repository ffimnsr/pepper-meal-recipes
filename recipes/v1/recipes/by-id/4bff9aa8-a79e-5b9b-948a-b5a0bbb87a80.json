  "schema_version": 1,
  "id": "4bff9aa8-a79e-5b9b-948a-b5a0bbb87a80",
  "slug": "risotto-with-sunchokes-butternut-squash-and-gorgonzola",
  "name": "Risotto with Sunchokes, Butternut Squash, and Gorgonzola",
  "recipe_type": "dessert",
  "brief_description": "This risotto with earthy sunchokes, sweet butternut squash, and pungent, creamy Gorgonzola cheese is a truly exceptional dish.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Warm broth in a saucepan over low heat."
    },
    {
      "position": 2,
      "text": "Warm olive oil in a large saucepan over medium-high heat. Stir in shallot and butternut squash and cook until soft, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, peel and dice sunchokes, adding them to the saucepan immediately to prevent oxidation. Mix with the other vegetables. Add rice; stir and toast until pale, about 3 minutes. Pour in white wine, stirring constantly until fully absorbed."
    },
    {
      "position": 4,
      "text": "Pour 1/2 cup broth into the rice and stir until absorbed. Continue adding broth, 1/2 cup at a time, stirring continuously, until the liquid is absorbed and the rice is tender yet firm to the bite, 15 to 20 minutes. Turn off the heat and add Gorgonzola cheese. Stir well until cheese is melted. Allow to rest for 2 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "00f576a0-bcc1-5810-be45-430fa87fc2f8",
  "slug": "easy-stovetop-peach-cobbler",
  "name": "Easy Stovetop Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This easy stovetop peach cobbler recipe is the perfect treat when you crave sweets. It works well with fresh or canned peaches, or any fruit you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour peaches and half the juice from the can into a large skillet. Sprinkle with sugar and cinnamon. Sprinkle evenly with cake mix. Dot with margarine pieces."
    },
    {
      "position": 2,
      "text": "Cover the skillet and bring to a simmer over medium-high heat. When steam begins to escape, reduce heat to medium-low. Continue cooking for 10 minutes, undisturbed."
    },
    {
      "position": 3,
      "text": "Remove from heat; let stand, covered, 15 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2f6c75ad-341e-5d55-ab0e-ce7d906c65bd",
  "slug": "cornish-game-hens-with-garlic-and-rosemary",
  "name": "Cornish Game Hens with Garlic and Rosemary",
  "recipe_type": "main",
  "brief_description": "These roasted Cornish hens flavored with garlic, lemon, and fresh rosemary are tender and juicy. Perfect for a simple yet elegant Thanksgiving meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Rub Cornish hens with 1 tablespoon olive oil; lightly season with salt and pepper. Stuff 1 lemon quarter and 1 rosemary sprig into each cavity. Place hens in a large, heavy roasting pan and arrange garlic cloves around them."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven for 25 minutes. Meanwhile, whisk wine, chicken broth, and remaining 2 tablespoons olive oil together in a small bowl."
    },
    {
      "position": 4,
      "text": "Remove hens from the oven; reduce the oven temperature to 350 degrees F (175 degrees C). Pour wine mixture over the hens and continue roasting, basting with pan juices every 10 minutes, until hens are golden brown and juices run clear, about 25 more minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Transfer hens to a platter, pouring any cavity juices into the roasting pan; discard lemons and rosemary. Tent hens with aluminum foil to keep warm."
    },
    {
      "position": 6,
      "text": "Transfer pan juices and garlic cloves to a medium saucepan; boil until reduced to a sauce consistency, about 6 minutes."
    },
    {
      "position": 7,
      "text": "Spoon sauce and roasted garlic on top. Garnish with remaining rosemary sprigs and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

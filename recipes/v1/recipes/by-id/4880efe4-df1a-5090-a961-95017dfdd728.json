  "id": "4880efe4-df1a-5090-a961-95017dfdd728",
  "slug": "apple-crisp-perfect-and-easy",
  "name": "Perfect and Easy Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "This recipe for apple crisp is easy to make with fresh, crisp apples and a buttery cinnamon streusel; bake until golden for a quick and simple dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Lightly grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Arrange apple slices evenly in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Sift flour, sugar, cinnamon, and salt into a bowl."
    },
    {
      "position": 4,
      "text": "Cut in butter using a pastry blender, or 2 knives, until mixture resembles coarse cornmeal; sprinkle over apples."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until topping is golden, 40 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Cool slightly before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

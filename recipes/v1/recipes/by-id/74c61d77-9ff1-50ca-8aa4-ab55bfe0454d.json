  "id": "74c61d77-9ff1-50ca-8aa4-ab55bfe0454d",
  "slug": "he-jia-tuan-yuan-tofu-ball-soup-for-lunar-chinese-new-year",
  "name": "He Jia Tuan Yuan (Tofu Ball Soup for Lunar Chinese New Year)",
  "recipe_type": "appetizer",
  "brief_description": "This tofu ball soup for Lunar Chinese New Year (He Jia Tuan Yuan) recipe simmers tofu-pork meatballs in a savory soup, with pea shoots and dried shrimp.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Mash tofu in a large bowl into a paste with a spoon; stir in pork, cornstarch, egg, 1 teaspoon bouillon granules, and 1 teaspoon salt until well combined."
    },
    {
      "position": 2,
      "text": "Bring water and oil to a boil in a large saucepan. Reduce heat to a lively simmer but not a full boil. Pinch off about 1 tablespoon tofu mixture, using gloved hands; roll it into a ball and carefully lower into water. Repeat forming and adding tofu balls to water with remaining tofu mixture. Simmer tofu balls until they rise to the top without stirring, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Off heat, stir in pea vine shoots, dried shrimp, remaining 1 teaspoon bouillon granules, and remaining \u00bc teaspoon salt."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "64866bce-5622-57a3-b83c-440126ff4146",
  "slug": "chicken-piccata-with-angel-hair-pasta",
  "name": "Chicken Piccata with Angel Hair Pasta",
  "recipe_type": "drink",
  "brief_description": "This chicken piccata pasta features pan-fried chicken and angel hair pasta drenched in a warm vinaigrette made with wine, lemon juice, and capers.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, pepper, and paprika together in a shallow dish. Dredge chicken in flour mixture until evenly coated."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat. Add garlic; cook and stir until golden and fragrant, about 1 minute; transfer to a plate."
    },
    {
      "position": 4,
      "text": "Melt 2 tablespoons butter in the same skillet. Add chicken and cook until browned, about 5 minutes per side; transfer to a plate."
    },
    {
      "position": 5,
      "text": "Pour wine into the hot skillet and bring to a boil over high heat, scraping the browned bits from the bottom and sides of the pan with a wooden spoon. Boil until wine is reduced by half, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Whisk in chicken broth, reserved garlic, lemon juice, and capers; cook for 5 minutes."
    },
    {
      "position": 7,
      "text": "Stir in parsley and remaining 2 tablespoons butter."
    },
    {
      "position": 8,
      "text": "Reduce the heat to medium, return chicken to the skillet, and continue cooking until sauce thickens, about 15 minutes."
    },
    {
      "position": 9,
      "text": "Bring a large pot of lightly salted water to a boil. Cook angel hair pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes. Drain well."
    },
    {
      "position": 10,
      "text": "Transfer chicken pieces to a serving dish and drizzle with a few tablespoons sauce. Add cooked pasta to the skillet and toss to coat with remaining sauce. Portion noodles onto serving plates and top with chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

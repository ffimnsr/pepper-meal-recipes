  "id": "0134bc62-1f4c-582f-9c2b-827feb8897aa",
  "slug": "jack-daniels-very-merry-eggnog",
  "name": "Jack Daniel's Very Merry Eggnog",
  "recipe_type": "drink",
  "brief_description": "Don't wait for December to enjoy this Jack Daniel's eggnog! Make Thanksgiving festive with this deliciously potent, quick and easy, homemade eggnog recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix sugar, rum, bourbon, brandy, vanilla, nutmeg, and salt in a blender on medium speed until combined. Transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Pour half-and-half, cream, and eggs into the blender; mix on low speed until combined. Carefully pour into the liquor mixture and stir to combine."
    },
    {
      "position": 3,
      "text": "Ladle combined mixture back into the blender in batches; blend on low speed. Transfer blended eggnog to a punch bowl or pitcher."
    },
    {
      "position": 4,
      "text": "Refrigerate eggnog until cold, 1 to 2 hours, before serving."
    }
  ],
  "servings": 18,

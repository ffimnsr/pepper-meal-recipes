  "id": "ae4f52c4-22c7-5eb5-ab53-dee8664b5269",
  "slug": "shrimp-and-sausage-southern-fried-cabbage-recipe-11894267",
  "name": "Shrimp and Sausage Southern Fried Cabbage",
  "recipe_type": "main",
  "brief_description": "This shrimp and sausage southern fried cabbage is an easy one-pan recipe with a lot of flavor with minimal ingredients. With tender shredded cabbage, Cajun spices, andouille, and shrimp, it's a nice way to use cabbage.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a 12-inch skillet over medium-high heat. Add andouille and cook until browned, 5 minutes. Remove from skillet."
    },
    {
      "position": 2,
      "text": "Toss shrimp with 1 teaspoon Cajun seasoning. Add to skillet. Cook until shrimp is opaque, 3 minutes. Remove from skillet."
    },
    {
      "position": 3,
      "text": "Add remaining 1 tablespoon oil to skillet. Reduce heat to medium. Add onion and bell pepper; cook until softened, about 3 minutes. Add garlic to skillet; cook until fragrant, about 1 minute."
    },
    {
      "position": 4,
      "text": "Add remaining 2 teaspoons Cajun seasoning to skillet. Cook 1 minute to infuse oil with flavor."
    },
    {
      "position": 5,
      "text": "Add cabbage to skillet. Reduce heat to medium-low. Cover skillet and cook until cabbage is wilted and tender, stirring occasionally, 8 to10 minutes."
    },
    {
      "position": 6,
      "text": "Return andouille and shrimp to skillet. Increase heat to medium. Cook until heated through, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with parsley and serve with lemon wedges."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "de089878-fb61-549e-9910-42fc61296727",
  "slug": "raspberry-tiramisu-trifle",
  "name": "Raspberry Tiramisu Trifle",
  "recipe_type": "dessert",
  "brief_description": "This delicious raspberry dessert is a mix between tiramisu and trifle with raspberries, mascarpone, and ladyfingers you can make in advance.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1 tablespoon sugar, lemon juice, and water in a bowl."
    },
    {
      "position": 2,
      "text": "Combine mascarpone, egg yolks, and 3 tablespoons sugar in a large bowl; beat with an electric mixer until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until until stiff peaks form. Lift your beater or whisk straight up: the egg whites will form sharp peaks. Carefully fold under mascarpone cream."
    },
    {
      "position": 4,
      "text": "Dip 2/3 of the ladyfingers in the lemon juice mixture. Layer the ladyfingers dipped side up and dry side down in a rectangular serving dish. Add a layer of half of the crushed raspberries, followed by half the mascarpone cream. Add another layer of soaked ladyfingers, followed by raspberries and the rest of the mascarpone. Garnish with whole raspberries."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "b37a9c6c-11d0-5d13-9d27-e36baa4bb13b",
  "slug": "grilled-chicken-salad-sandwich",
  "name": "Grilled Chicken Salad Sandwich",
  "recipe_type": "salad",
  "brief_description": "This grilled chicken salad is a creamy combo of mayo, leftover grilled chicken, celery, nuts, and cranberries that tastes great in a sandwich or on lettuce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk 1 cup mayonnaise, pepper, garlic powder, and celery salt together in a small bowl until combined."
    },
    {
      "position": 3,
      "text": "Combine chicken, celery, cashews, and cranberries in a large bowl; pour mayonnaise mixture over chicken mixture and stir until evenly combined."
    },
    {
      "position": 4,
      "text": "Spread 1/2 tablespoon mayonnaise on each slice of toasted bread. Divide chicken salad between 4 toast slices; top each with a lettuce leaf and a tomato slice. Complete each sandwich with remaining 4 toast slices."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

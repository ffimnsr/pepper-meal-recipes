  "id": "5843ae0f-c083-5585-b7cd-1555ac96699c",
  "slug": "citrus-carne-asada-marinade",
  "name": "Citrus Carne Asada Marinade",
  "recipe_type": "drink",
  "brief_description": "Make easy pan-fried carne asada using flank steak marinated for up to 24 hours in a bright and savory mix of 3 citrus juices, chipotle pepper, and lots of spices.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine onion, soy sauce, lime juice, lemon juice, orange juice, cilantro, chili powder, garlic, cumin, oregano, coriander, hot sauce, chipotle pepper, black pepper, and sugar in a 1-gallon plastic zip-top bag. Add steak and seal. Marinate in the refrigerator, turning and massaging meat frequently, for up to 24 hours."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large frying pan over high heat. Add steak and marinade. Cook steak until medium-rare to medium, 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read 130 to 140 degrees F (54 to 60 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

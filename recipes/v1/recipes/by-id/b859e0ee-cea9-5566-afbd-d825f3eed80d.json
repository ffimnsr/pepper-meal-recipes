  "id": "b859e0ee-cea9-5566-afbd-d825f3eed80d",
  "slug": "beckys-moms-cranberry-sauce",
  "name": "Becky's Mom's Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "This recipe calls for fresh cranberries, sugar, and orange liqueur to be baked for 90 minutes and is best made well in advance of serving.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together the cranberries, sugar, and liqueur in a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 1 1/2 hours, stirring every 20 minutes. Store refrigerated in a tightly-covered container."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 5,

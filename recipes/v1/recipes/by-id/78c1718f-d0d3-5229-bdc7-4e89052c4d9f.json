  "id": "78c1718f-d0d3-5229-bdc7-4e89052c4d9f",
  "slug": "moms-scalloped-potatoes",
  "name": "Scalloped Potatoes",
  "recipe_type": "side",
  "brief_description": "Tender scalloped potatoes are the ultimate creamy potato side dish for any holiday gathering. Perfect with baked ham, roast beef, chicken, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Arrange about \u2153 potato slices in the bottom of the prepared baking dish; top with about \u2153 onion slices. Sprinkle 3 tablespoons flour over potato and onion layer; place 2 tablespoons cubed butter on top. Season layer with salt and black pepper. Repeat layering twice more."
    },
    {
      "position": 3,
      "text": "Heat milk in a saucepan over medium-low heat until warm. Pour enough warm milk over mixture in the baking dish until top of the liquid is level with the final layer of potatoes."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until potatoes are tender and sauce is bubbling with a golden brown crust, 45 to 60 minutes. Place a baking sheet underneath the baking dish to catch any drips; the sauce may bubble up over the sides. Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

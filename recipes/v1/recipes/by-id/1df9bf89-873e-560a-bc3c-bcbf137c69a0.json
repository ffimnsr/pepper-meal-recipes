  "name": "Ros\u00e9 Sangria",
  "recipe_type": "drink",
  "brief_description": "This ros\u00e9 sangria is super simple to make with chilled ros\u00e9 wine, sliced strawberries, and pineapple juice for a refreshing, fruity, pretty pink drink!",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir the strawberries, lemonade concentrate, ros\u00e9 wine, and pineapple juice in a punch bowl until combined."
    },
    {
      "position": 3,
      "text": "Stir in the ginger ale just before serving."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

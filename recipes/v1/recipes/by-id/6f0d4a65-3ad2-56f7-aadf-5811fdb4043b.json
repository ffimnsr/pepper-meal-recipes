  "id": "6f0d4a65-3ad2-56f7-aadf-5811fdb4043b",
  "slug": "moist-vanilla-cupcakes",
  "name": "Moist Vanilla Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These moist vanilla cupcakes produce the perfect levels of sweetness and vanilla flavor you'll want to revisit time and time again.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a cupcake pan with 12 paper liners."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a bowl using an electric mixer until light and fluffy. Beat in egg and vanilla extract. Mix in baking powder, baking soda, and salt. Alternate adding flour and milk, stirring until just combined. Fill prepared pan with batter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned on top, about 18 minutes. Cool in the pan for 10 minutes, then remove to wire racks to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

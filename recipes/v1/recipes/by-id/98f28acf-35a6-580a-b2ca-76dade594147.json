  "id": "98f28acf-35a6-580a-b2ca-76dade594147",
  "slug": "chicken-bacon-ranch-stuffed-puffs-recipe-11953979",
  "name": "Chicken Bacon Ranch Stuffed Puffs",
  "recipe_type": "appetizer",
  "brief_description": "These chicken bacon ranch stuffed puffs are zesty with fresh jalapeno, cheesy, golden, crisp, and delicious. They are a great appetizer for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Thaw puff pastry according to package directions."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine chicken, cream cheese, shredded cheese, bacon, jalapenos, ranch seasoning, salt and pepper in a large bowl. Mix until well combined and set aside."
    },
    {
      "position": 4,
      "text": "Roll out 1 sheet of pastry puff with a rolling pin on a lightly floured surface until smooth. Cut into 9 squares."
    },
    {
      "position": 5,
      "text": "Place 1 tablespoon of the chicken mixture in the center of each square. Fold each square in half into a triangle and seal the edges using a fork. Repeat with remaining pastry puff sheets."
    },
    {
      "position": 6,
      "text": "Place stuffed puffs onto prepared baking sheet and lightly brush the tops with butter."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until tops are golden brown, 10 to 12 minutes."
    },
    {
      "position": 8,
      "text": "Serve with spicy ranch dipping sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

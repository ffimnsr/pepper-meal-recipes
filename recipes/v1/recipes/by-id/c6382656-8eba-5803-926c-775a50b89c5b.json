  "id": "c6382656-8eba-5803-926c-775a50b89c5b",
  "slug": "detroit-hot-honey-wings",
  "name": "Detroit Hot Honey Wings",
  "recipe_type": "appetizer",
  "brief_description": "These Detroit-inspired hot honey wings are packed with bold, finger-licking, sweet-spicy flavors. They'll be a hit at your next BBQ or game-day party.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill to medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Pat wings dry with paper towels. Season wings with cayenne, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Cook chicken wings on the preheated grill, brushing wings liberally with 1/2 cup honey while cooking, until cooked through and juices run clear, 20 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Mix butter, hot sauce, and remaining 1/2 cup honey together in a large bowl."
    },
    {
      "position": 5,
      "text": "Remove wings from the grill and immediately toss them in hot honey-butter sauce to coat. Serve wings or return to the grill for 1 minute per side to set sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

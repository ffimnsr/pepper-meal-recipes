  "id": "465be47e-ee4b-536e-93a3-fdb0823ddf93",
  "slug": "sauteed-apples",
  "name": "Saut\u00e9ed Apples",
  "recipe_type": "dessert",
  "brief_description": "Saut\u00e9ed apples cooked in butter with brown sugar and cinnamon until tender, syrupy, and delicious. Spoon on top of porridge, pancakes, or pork chops!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet or saucepan over medium heat."
    },
    {
      "position": 2,
      "text": "Add apples and cook, stirring constantly, until almost tender, 6 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Mix water and cornstarch together in a small bowl until cornstarch is dissolved; pour over apples. Stir in brown sugar and cinnamon. Bring to a boil for 2 minutes, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Remove from heat and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

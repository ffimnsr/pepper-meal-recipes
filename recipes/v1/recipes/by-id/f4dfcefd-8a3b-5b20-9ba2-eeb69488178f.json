  "id": "f4dfcefd-8a3b-5b20-9ba2-eeb69488178f",
  "slug": "best-gluten-free-pita-bread",
  "name": "Best Gluten-Free Pita Bread",
  "recipe_type": "snack",
  "brief_description": "Bake this gluten-free pita bread from scratch with just oat flour, potato starch, cornstarch, and yeast. Great bread for sandwiches and snacks.",
  "cuisine": "Greek African",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oat flour, potato starch, cornstarch, tapioca flour, xanthan gum, yeast, sugar, and salt in the bowl of a stand mixer; whisk until well mixed, about 1 minute."
    },
    {
      "position": 2,
      "text": "Whisk milk, egg, olive oil, and vinegar together in a separate bowl until well combined, about 1 minute. Stir milk mixture in gradually to flour mixture on low speed; mix until a soft dough comes together, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Line 2 baking sheets with parchment paper. Divide dough into 6 equal pieces; roll each piece on a floured surface to a 6-inch circle. Place on the prepared baking sheets; cover with plastic wrap and set aside for 1 to 1 1/2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Heat a pizza stone in the oven."
    },
    {
      "position": 5,
      "text": "Spray pita breads with water and place them straight on the hot pizza stone."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until puffed and lightly golden, 5 to 7 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

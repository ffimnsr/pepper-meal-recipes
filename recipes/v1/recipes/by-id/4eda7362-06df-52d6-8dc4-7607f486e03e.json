  "id": "4eda7362-06df-52d6-8dc4-7607f486e03e",
  "slug": "sweet-bread-strata",
  "name": "Sweet Bread Strata",
  "recipe_type": "dessert",
  "brief_description": "Cubed Hawaiian sweet bread rolls are blanketed with bacon, green onions, eggs, and 3 cheeses to make this simple and delicious bread strata.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut each roll into 8 cubes."
    },
    {
      "position": 3,
      "text": "Spread onto a baking sheet in a single layer. Bake in the preheated oven until toasted, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Layer toasted bread cubes in a 1 1/2-quart baking pan. Sprinkle 1/4 cup Swiss cheese, 1/4 cup Cheddar cheese, 1/2 the bacon, and 2 green onions on top of the bread. Shake to settle the toppings into the bread."
    },
    {
      "position": 5,
      "text": "Beat eggs together with half-and-half, milk, salt, and pepper in a bowl. Pour over the bread cubes, pressing cubes down into the mixture."
    },
    {
      "position": 6,
      "text": "Sprinkle the remaining Swiss cheese, Cheddar cheese, bacon, green onions, and Parmesan cheese on top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until strata is hot in the center, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

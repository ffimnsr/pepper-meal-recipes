  "id": "adc0bb15-c873-5701-9cd4-ce9f7be5e5d5",
  "slug": "terrific-toffee-bars",
  "name": "Terrific Toffee Bars",
  "recipe_type": "dessert",
  "brief_description": "These shortbread bars are really easy and have a great toffee taste!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat butter, brown sugar, vanilla, and egg yolk together in a large bowl until well combined; stir in flour and salt until incorporated. Press dough into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust is light brown, 25 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and immediately sprinkle chocolate chips over hot crust. Let stand until soft, about 5 minutes, then spread evenly; sprinkle with nuts. Cool on a wire rack for at least 30 minutes before slicing."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

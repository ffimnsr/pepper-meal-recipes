{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "00ec8910-1645-5d79-9b99-0e2eaa729a2f",
  "slug": "old-fashioned-apple-dumplings",
  "name": "Old-Fashioned Apple Dumplings",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned apple dumplings recipe features whole apples wrapped in pastry, infused with brown sugar and cinnamon, and topped with a sweet sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Butter a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Roll pastry into a 24x16-inch rectangle on a lightly floured surface. Cut into six 8-inch squares. Place an apple on each pastry square with cored opening facing upward."
    },
    {
      "position": 3,
      "text": "Cut butter into 8 pieces; place 1 piece into each apple; reserve remaining butter for sauce."
    },
    {
      "position": 4,
      "text": "Divide brown sugar between apples, poking some inside each core, and remaining around apple base. Sprinkle evenly with cinnamon and nutmeg."
    },
    {
      "position": 5,
      "text": "Dampen fingers. Bring one corner of pastry to top of apple. Bring opposite corner to top; press together. Repeat with remaining two corners; seal. Slightly pinch dough at sides to seal in apple. Repeat with remaining apples; transfer to the prepared baking dish."
    },
    {
      "position": 6,
      "text": "Combine water, white sugar, vanilla extract, and reserved butter in a large saucepan. Bring sauce to a boil over medium heat. Reduce the heat to low and simmer until sugar dissolves, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Carefully pour sauce over dumplings."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until pastry is golden and crisp, 50 to 60 minutes."
    },
    {
      "position": 9,
      "text": "Place each apple dumpling in a bowl, spoon sauce over top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

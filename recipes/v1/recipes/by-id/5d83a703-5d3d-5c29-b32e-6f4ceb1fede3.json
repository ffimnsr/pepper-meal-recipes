  "id": "5d83a703-5d3d-5c29-b32e-6f4ceb1fede3",
  "slug": "mediterranean-sheet-pan-chicken-recipe-11874611",
  "name": "Mediterranean Sheet Pan Chicken",
  "recipe_type": "drink",
  "brief_description": "This Mediterranean sheet pan chicken, tender chicken breast is marinated in creamy Greek yogurt with shawarma spices, fresh garlic, and dill pickle juice, making every bite tangy, bright, and unbelievably juicy. Pile into a warm pita or serve it over rice with roasted veggies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice chicken breasts into pieces about the size of a deck of cards."
    },
    {
      "position": 2,
      "text": "Add yogurt, pickle juice, garlic, and shawarma seasoning to a resealable plastic bag or shallow dish with a lid. Mix until thoroughly combined. Add chicken; massage the bag to coat chicken breasts. Refrigerate overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) and line a sheet pan with foil. Mist with nonstick spray."
    },
    {
      "position": 4,
      "text": "Remove the chicken pieces from marinade and shake off excess. Place chicken on the prepared sheet pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until no longer pink at the center and juices run clear, 20 to 25 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

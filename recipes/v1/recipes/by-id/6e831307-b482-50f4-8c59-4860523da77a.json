  "id": "6e831307-b482-50f4-8c59-4860523da77a",
  "slug": "quick-and-easy-tuna-casserole",
  "name": "Quick and Easy Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "This easy tuna casserole is quick to prep and ready to serve to a hungry family in just 30 minutes\u2014simple and delicious for busy weeknights!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add noodles and frozen peas; simmer for 8 to 10 minutes, or until noodles are al dente. Drain well, then return noodles and peas to the pot."
    },
    {
      "position": 3,
      "text": "Stir in condensed soup, tuna, cheese, onion, and pepper until well mixed and the cheese has melted. Serve."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3c682a92-2f62-5ed4-9e4c-75274ef9aeae",
  "slug": "waffle-iron-cornbread",
  "name": "Waffle Iron Cornbread",
  "recipe_type": "breakfast",
  "brief_description": "Cornbread made in the waffle maker is a quick-and-easy spin on making the traditional recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat and lightly grease a waffle iron according to the manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Whisk cornmeal, flour, baking powder, baking soda, salt, and paprika together in a bowl. Stir buttermilk, butter, and egg together in a separate bowl; stir into flour mixture until batter is just blended."
    },
    {
      "position": 3,
      "text": "Ladle 1/2 to 3/4 cup batter into the preheated waffle iron; cook waffle according to manufacturer\u2019s instructions until golden brown, about 5 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

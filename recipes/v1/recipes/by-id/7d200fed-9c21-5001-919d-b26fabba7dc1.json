  "id": "7d200fed-9c21-5001-919d-b26fabba7dc1",
  "slug": "buffalo-dip",
  "name": "Buffalo Dip",
  "recipe_type": "appetizer",
  "brief_description": "An easy Buffalo chicken dip recipe with a spicy, cheesy flavor — made with just five ingredients. This dish is always hit at parties and gatherings.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat cream cheese in a deep baking dish until smooth. Add ranch dressing, Buffalo wing sauce, and mozzarella cheese to cream cheese and stir until smooth. Stir in chicken."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until heated through and bubbling, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

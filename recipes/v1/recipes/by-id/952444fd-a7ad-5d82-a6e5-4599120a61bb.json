  "id": "952444fd-a7ad-5d82-a6e5-4599120a61bb",
  "slug": "unicorn-frozen-yogurt-bark-recipe-12035162",
  "name": "Unicorn Frozen Yogurt Bark",
  "recipe_type": "dessert",
  "brief_description": "This unicorn frozen yogurt bark is a great make-ahead and freeze kid-friendly afternoon snack or treat. Customize with desired flavors. We used freeze-dried raspberry powder to tint the yogurt, but you can use your desired food coloring instead.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gently stir raspberry powder into yogurt in a small bowl until desired color and/or leaving swirls as desired (mixture does not have to be thoroughly combined). Line a 9x13-inch (or 10x15-inch) rimmed baking sheet with parchment paper. Spread yogurt onto prepared baking sheet into about a 1/4-inch-thick rectangle."
    },
    {
      "position": 2,
      "text": "Top with desired fruit and sprinkles. Cover with plastic wrap, then freeze until firm, at least 2 hours. Let stand 5 minutes. Break into pieces to serve. (To store, layer pieces between sheets of parchment in a freezer container. Freeze up to 2 weeks)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

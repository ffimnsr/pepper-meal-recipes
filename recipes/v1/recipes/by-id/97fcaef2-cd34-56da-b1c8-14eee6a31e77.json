  "id": "97fcaef2-cd34-56da-b1c8-14eee6a31e77",
  "slug": "no-crust-strawberry-pie",
  "name": "No-Crust Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "It's hard to beat this fresh strawberry no-crust pie made with vanilla pudding and strawberry gelatin. The best part? It has hardly any calories!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse and hull strawberries; pat dry with a paper towel. Spread strawberries evenly in a 10-inch pie plate."
    },
    {
      "position": 2,
      "text": "Combine water, pudding mix, and gelatin mix in a medium saucepan. Stir well and bring to a full boil. Pour mixture over strawberries in the pie plate."
    },
    {
      "position": 3,
      "text": "Chill pie in the refrigerator for at least 4 to 6 hours before serving."
    }
  ],
  "servings": 8,

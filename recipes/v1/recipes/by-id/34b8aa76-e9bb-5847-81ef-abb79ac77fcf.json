  "id": "34b8aa76-e9bb-5847-81ef-abb79ac77fcf",
  "slug": "cheesy-grits",
  "name": "Cheesy Grits",
  "recipe_type": "side",
  "brief_description": "These buttery cheese grits are a quick and easy side dish for any meal \u2014 you'll love the cheesy combination of Cheddar and Parmesan in every bite.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and salt to a boil in a saucepan. Whisk in grits, reduce heat to medium-low, and cook until thickened, 5 to 6 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Stir in Cheddar, Parmesan, and butter until combined and cheese has melted."
    },
    {
      "position": 4,
      "text": "Season with pepper; serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

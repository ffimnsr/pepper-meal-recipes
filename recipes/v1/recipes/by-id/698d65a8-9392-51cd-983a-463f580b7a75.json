  "id": "698d65a8-9392-51cd-983a-463f580b7a75",
  "slug": "sous-vide-parsnips",
  "name": "Sous Vide Parsnips",
  "recipe_type": "side",
  "brief_description": "Parsnips are cooked sous vide and then quickly saut\u00e9ed in butter and thyme\u2014a delicious six-ingredient side dish recipe for holidays or special occasions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a heat-resistant pad underneath a large pot filled with water. Attach a sous vide precision cooker to the pot; set temperature to 195 degrees F (95 degrees C) according to the manufacturer's instructions. Set timer to 30 minutes."
    },
    {
      "position": 2,
      "text": "Cut ends off parsnips; peel. Cut a 2-inch piece off smallest parts of parsnips; cut remaining parts of parsnips into equal-sized pieces. Place into a resealable plastic bag, making sure pieces lay flat and don't overlap. Add olive oil and salt."
    },
    {
      "position": 3,
      "text": "Remove excess air from bag using the water immersion method or a vacuum sealer; seal bag. Immerse into the pot once it has come to temperature."
    },
    {
      "position": 4,
      "text": "Melt butter in a small skillet over low heat when 10 minutes are left on sous vide timer. Add thyme sprigs; simmer for 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove bag from the pot; remove parsnips from the bag. Remove thyme from the skillet; season butter with nutmeg. Increase heat to medium-high; add parsnips to skillet. Cook until parsnips are lightly browned, 2 to 3 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "simple-savory-oatmeal",
  "name": "Simple Savory Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Bacon and Creole seasoning blend flavor this savory version of oatmeal; a hearty, nutritious breakfast ready in 5 minutes in your microwave.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water and oats in a microwave-safe bowl. Cook at 50% power, stirring half way through cooking, until oats are softened, 3 to 5 minutes. Stir in butter until melted. Stir in bacon bits and Creole seasoning until evenly distributed."
    }
  ],

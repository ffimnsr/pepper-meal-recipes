  "id": "73cbc5df-2275-5946-b3a8-bbc4971ab45f",
  "slug": "red-white-and-blueberry-fruit-salad",
  "name": "Red, White, and Blueberry Fruit Salad",
  "recipe_type": "salad",
  "brief_description": "This strawberry and blueberry salad with bananas is tossed with sugar and lemon juice and has all the colors of the U.S. flag for a patriotic dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries and blueberries in a large bowl. Sprinkle with sugar and lemon juice; toss lightly. Refrigerate until cold, at least 30 minutes."
    },
    {
      "position": 2,
      "text": "About 30 minutes before serving, cut bananas into 3/4-inch-thick slices; toss with berries until evenly distributed."
    }
  ],
  "servings": 8,

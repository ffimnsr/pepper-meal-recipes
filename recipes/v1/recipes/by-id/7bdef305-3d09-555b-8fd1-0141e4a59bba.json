  "schema_version": 1,
  "id": "7bdef305-3d09-555b-8fd1-0141e4a59bba",
  "slug": "forgotten-1950-s-salmon-patties-in-20-minutes-recipe-12023126",
  "name": "Forgotten 1950s Salmon Patties in 20 Minutes",
  "recipe_type": "main",
  "brief_description": "These fast, affordable, and very delicious forgotten 1950s salmon patties started in the 30s, and reached its peak popularity in the 50s, but then was forgotten. The first recipes (with only three ingredients) were vastly improved by the 50s with some tantalizing seasonings, making this a recipe worth bringing back to the table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine salmon, crushed crackers, mayonnaise, and egg in a bowl. Mix and mash with a fork until the salmon is broken up into very small pieces and everything is mixed evenly. Add chopped capers, green onions, salt, black pepper, and cayenne; stir to combine."
    },
    {
      "position": 2,
      "text": "Crush a few more crackers onto a plate. Divide mixture into four equal portions and shape into patties with your hands. It\u2019s easier if you moisten your hands with a little bit of water first. Place the formed patties on the plate. More cracker crumbs can be sprinkled over the top and pressed in gently for a crispier patty. Chill in the fridge until needed."
    },
    {
      "position": 3,
      "text": "For remoulade sauce, add mayonnaise, sour cream, Dijon mustard, pickle relish, parsley, tarragon, paprika, black pepper, cayenne, and sugar to a mixing bowl and whisk to combine. Refrigerate until needed."
    },
    {
      "position": 4,
      "text": "Melt butter in a nonstick skillet set over medium heat, and once the butter starts to sizzle, transfer the salmon patties into the skillet. Cook until beautifully browned and heated all the way through, about 3 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve immediately with remoulade sauce."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

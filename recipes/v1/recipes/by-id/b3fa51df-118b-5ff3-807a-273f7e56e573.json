  "id": "b3fa51df-118b-5ff3-807a-273f7e56e573",
  "slug": "teriyaki-grilled-vegetables",
  "name": "Teriyaki Grilled Vegetables",
  "recipe_type": "side",
  "brief_description": "A ready-made teriyaki glaze and assorted fresh vegetables of your choice make this easy grilled side dish a sure winner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Combine mushrooms, onion, zucchini, yellow squash, and bell peppers in a large bowl. Add teriyaki, garlic, and ground pepper. Toss to thoroughly coat vegetables with the sauce; be gentle with the onion to keep it intact."
    },
    {
      "position": 3,
      "text": "Place vegetables on the grill and cook, turning once, until vegetables begin to soften, 5 to 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,

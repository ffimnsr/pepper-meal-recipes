  "id": "e4fd5fbd-a689-5814-b805-33cbf9fed112",
  "slug": "easy-tuna-casserole",
  "name": "Easy Tuna Casserole",
  "recipe_type": "soup",
  "brief_description": "This tuna pasta casserole is made with macaroni, creamy chicken soup, and Cheddar cheese. Top with crispy fried onions for a very comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cooked macaroni, tuna, and condensed soup together in a 9x13-inch baking dish; sprinkle with cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbly, about 25 minutes. Sprinkle with fried onions; bake 5 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

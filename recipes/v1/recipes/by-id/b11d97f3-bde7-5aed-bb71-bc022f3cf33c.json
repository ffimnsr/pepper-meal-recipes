  "slug": "cranberry-salsa",
  "name": "Cranberry Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This cranberry salsa recipe comes together in minutes in a food processor for a bright, tangy-sweet condiment with a lively, fresh jalape\u00f1o kick.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, sugar, cilantro, green onions, jalape\u00f1o, lime juice, and salt in the bowl of a food processor; process to a medium consistency. Adjust flavors to taste."
    },
    {
      "position": 2,
      "text": "Refrigerate to let flavors meld, or serve immediately at room temperature."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

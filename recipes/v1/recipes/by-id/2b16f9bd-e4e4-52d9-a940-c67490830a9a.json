  "schema_version": 1,
  "id": "2b16f9bd-e4e4-52d9-a940-c67490830a9a",
  "slug": "lews-famous-lobster-pot-pie",
  "name": "Lew's Famous Lobster Pot Pie",
  "recipe_type": "main",
  "brief_description": "This lobster pot pie recipe has all the tasty goods. Lobster meat adds a new twist to a traditional dish. It will become a favorite comfort food.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring water and crab boil to a boil in a large saucepan."
    },
    {
      "position": 3,
      "text": "Stir in lobster tails and boil until they turn bright red and the meat becomes opaque, 5 to 8 minutes. Drain and cool lobster tails. Remove shells, and dice lobster meat. Transfer to a bowl."
    },
    {
      "position": 4,
      "text": "Place a pie crust into the bottom of a 9-inch pie pan and set aside."
    },
    {
      "position": 5,
      "text": "Heat butter in a skillet over medium heat. Cook and stir onion and celery in butter until tender, 5 to 8 minutes. Stir flour into onion and celery mixture until vegetables are coated."
    },
    {
      "position": 6,
      "text": "Combine chicken broth and milk in a bowl. Slowly stir broth and milk into onion, celery, and flour mixture until thickened. Stir seafood seasoning, garlic powder, and black pepper into thickened sauce."
    },
    {
      "position": 7,
      "text": "Mix thawed vegetables, diced potato, and cooked lobster meat into the sauce; simmer until potato is tender, about 8 minutes."
    },
    {
      "position": 8,
      "text": "Pour lobster filling into the prepared pie crust."
    },
    {
      "position": 9,
      "text": "Cover with remaining pie crust and seal by crimping the edges of the two crusts together. Cut an X into top of pie crust with a sharp knife to allow steam to escape during baking."
    },
    {
      "position": 10,
      "text": "Bake pie in the preheated oven until crust is golden brown, 40 to 45 minutes."
    },
    {
      "position": 11,
      "text": "Remove from oven and let stand for 10 to 15 minutes to allow sauce to thicken."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

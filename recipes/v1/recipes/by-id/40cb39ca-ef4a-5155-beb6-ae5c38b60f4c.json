  "id": "40cb39ca-ef4a-5155-beb6-ae5c38b60f4c",
  "slug": "creamy-caramelized-onion-pasta-recipe-8710600",
  "name": "Creamy Caramelized Onion Pasta",
  "recipe_type": "side",
  "brief_description": "This creamy caramelized onion pasta is worthy crying over onions for, plus, this is the fastest way to caramelize onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in pasta and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, about 10 minutes, or according to package directions."
    },
    {
      "position": 2,
      "text": "Meanwhile, add butter and oil to a deep skillet over high heat. Add onions, and cook and stir until they take on a little color. Add sugar, salt, pepper, vinegar, and water, and continue to cook on high heat, stirring constantly, until onions are very tender and dark brown, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Turn heat down to low; add milk, garlic, thyme, and grated Parmesan. Blend the sauce until smooth with an immersion blender."
    },
    {
      "position": 4,
      "text": "Drain pasta, reserving a small amount of water to thin sauce if needed. Stir pasta into sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

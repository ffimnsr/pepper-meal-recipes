  "id": "168cf9ad-cde0-5054-bad3-cd9602fdaa84",
  "slug": "orange-marinated-pork-tenderloin",
  "name": "Orange Marinated Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "Simple roasted pork tenderloin with orange and rosemary sauce.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Make the orange marinade by whisking together the orange juice, soy sauce, rosemary, and garlic. Pour over pork tenderloin and marinate for at least one hour, preferably overnight."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (205 degrees C). Drain pork, reserving the marinade, and place on a baking sheet. Season with salt and pepper to taste. Roast for about 20 minutes until internal temperature has reached 145 degrees F (63 degrees C)."
    },
    {
      "position": 3,
      "text": "Meanwhile, strain the reserved marinade and bring it to a simmer in a small saucepan. Serve this as a sauce for the meat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

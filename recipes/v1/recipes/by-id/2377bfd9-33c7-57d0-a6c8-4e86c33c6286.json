{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2377bfd9-33c7-57d0-a6c8-4e86c33c6286",
  "slug": "smash-burgers",
  "name": "Homemade Smash Burgers",
  "recipe_type": "main",
  "brief_description": "Restaurant-style smash burgers are easy and fun to make at home. Here's how.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir ketchup, mayonnaise, pickle relish, vinegar, white sugar, and garlic together in a small bowl. Season to taste with salt and black pepper; cover and set aside,"
    },
    {
      "position": 2,
      "text": "Divide ground beef into 4 even pieces. Roll each piece into a ball; refrigerate until needed. Spread cut sides of each hamburger bun with butter."
    },
    {
      "position": 3,
      "text": "Heat a large cast iron or nonstick skillet over medium-high heat (you can add a little vegetable oil if worried about sticking)."
    },
    {
      "position": 4,
      "text": "Add two hamburger balls to the skillet. Smash meat flat using the bottom of a small sauce pot or a spatula. Hold in place until seared, about 1 minute; season with salt and pepper. Cook until a good crust forms, then flip."
    },
    {
      "position": 5,
      "text": "Once the flip side looks close to being done, cover with cheese slice. Move the patties aside and place buns, butter side down, in skillet until toasted. Continue to cook burgers until cheese is melted, meat is no longer pink in the center, about 5 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove buns to a plate; top each bottom bun with a patty. Spread toasted side of top bun with some of the special sauce."
    },
    {
      "position": 7,
      "text": "Lay a few onions down on the patty, cover with the top bun and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

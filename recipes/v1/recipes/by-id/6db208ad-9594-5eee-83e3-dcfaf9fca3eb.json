  "id": "6db208ad-9594-5eee-83e3-dcfaf9fca3eb",
  "slug": "linzer-tarts",
  "name": "Linzer Tart Cookies",
  "recipe_type": "dessert",
  "brief_description": "These classic Linzer cookies are soft, buttery, cut-out cookies with a delicious sweet jam filling\u2014dust with powdered sugar for a holiday favorite.",
  "cuisine": "Austrian American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter and sugar in a mixing bowl with an electric mixer until light and fluffy, 2 to 3 minutes. Mix in 1/2 cup flour, then ground almonds and cinnamon. Mix in remaining flour, 1/2 cup at a time, until well combined and dough stiffens a bit."
    },
    {
      "position": 2,
      "text": "Divide dough in half and form each half into a disk. Wrap each disk tightly in plastic wrap and refrigerate for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line two baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Working with one dough disk at a time, roll dough on a lightly floured surface to a thickness of 1/8 inch. Use a 2 \u00bd-inch round cookie cutter to cut as many circles from the dough as you can; you should have about 12. Arrange dough circles 1 inch apart onto a prepared baking sheet. Place the baking sheet into the refrigerator."
    },
    {
      "position": 5,
      "text": "Knead any leftover scraps into a ball and roll out again into a 1/8-inch-thick sheet. Cut out more circles; you should have about 12 more circles."
    },
    {
      "position": 6,
      "text": "Place the second batch of circles onto the second baking sheet. Use a 1/2-inch round cookie cutter to cut out the center from 1/2 of all the cookies."
    },
    {
      "position": 7,
      "text": "Bake cookies in the preheated oven until edges are lightly golden, 10 to 15 minutes. Transfer cookies to a wire rack to cool for 20 minutes."
    },
    {
      "position": 8,
      "text": "Spread a thin coating of jam onto the bottom sides of the fully round cookies. Place a cut-out cookie on top of each one, pressing together to form a sandwich. Return to the wire rack and repeat to form 11 more cookies."
    },
    {
      "position": 9,
      "text": "Sift confectioners' sugar over the cookies, then spoon a dab of jam into the cut-out part of each cookie."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

  "id": "7981c4f9-d7b4-51e8-86c6-fabf4f75cd92",
  "slug": "chai-spiced-shortbread-cookies",
  "name": "Chai-Spiced Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These chai-spiced shortbread cookies are meant to taste like a chai tea latte. You can play with the spices and amounts, but don't omit the cardamom.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Grind tea into a fine powder using a spice grinder; transfer to a bowl. Stir in cardamom, cinnamon, ginger, nutmeg, cloves, salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Beat butter, sugar, and vanilla extract with an electric mixer in a bowl until creamy. Add spice mixture; mix thoroughly. Fold in flour, 1/2 cup at a time, until a stiff dough forms."
    },
    {
      "position": 4,
      "text": "Transfer dough to a lightly floured surface; roll out to 1/4-inch thickness. Cut dough out with a 2-inch cookie cutter or knife; place cookies on baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges begin to brown slightly, about 20 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

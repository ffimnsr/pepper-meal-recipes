  "id": "4fed47cb-6d8a-521d-bf57-2d28ba42fbed",
  "slug": "pizza-beans-recipe-11880255",
  "name": "Pizza Beans",
  "recipe_type": "main",
  "brief_description": "These 5-ingredient pizza beans feature cannellini beans baked in tomato sauce and topped with melted mozzarella cheese and pepperoni. So easy and so yummy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine beans, marinara sauce, and Parmesan cheese in a 10-inch ovenproof skillet; stir until evenly coated."
    },
    {
      "position": 3,
      "text": "Top with mozzarella cheese and arrange pepperoni slices evenly over the surface. Cover tightly with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until heated through, 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Move oven rack to the upper third of the oven and preheat the broiler."
    },
    {
      "position": 6,
      "text": "Remove foil and broil 4 to 5 inches from the heat until the cheese is melted and bubbly, 3 to 4 minutes."
    },
    {
      "position": 7,
      "text": "Serve hot with garlic bread or baguette slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

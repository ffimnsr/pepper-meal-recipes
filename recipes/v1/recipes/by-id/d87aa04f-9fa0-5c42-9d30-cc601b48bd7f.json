  "id": "d87aa04f-9fa0-5c42-9d30-cc601b48bd7f",
  "slug": "easy-egg-white-omelet",
  "name": "Easy Egg White Omelet",
  "recipe_type": "breakfast",
  "brief_description": "A carton of refrigerated egg whites plus some onion, green pepper, and mushrooms makes a fast, protein-packed breakfast recipe that cooks in the microwave.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 9x5-inch glass or microwave-safe loaf pan with cooking spray. Sprinkle onion, green bell pepper, and mushrooms into the pan, and toss lightly with a fork just to mix. Season with salt and black pepper, and pour in the egg whites."
    },
    {
      "position": 2,
      "text": "Microwave on High setting for 3 minutes. Remove and stir the cooked egg white from the side of the pan into the rest of the ingredients; cook for 3 more minutes on High."
    },
    {
      "position": 3,
      "text": "If the omelet is still a little runny on top, slice it into chunks and turn them over in the loaf pan; microwave for 30 more seconds on High. Adjust salt and pepper, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "f11c15dc-0d95-5532-b4a7-2c07a1bd09e6",
  "slug": "shepherds-pie-v",
  "name": "Shepherd's Pie V",
  "recipe_type": "main",
  "brief_description": "Ground beef and frozen vegetables are seasoned and topped with mashed potatoes. This is a handy, quick dinner casserole!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender, about 15 minutes. Drain, cool and mash."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 2 quart casserole dish."
    },
    {
      "position": 3,
      "text": "In a large heavy skillet, saute meat until browned on all sides, stirring occasionally. Drain excess fat and return meat to pan over medium heat. Pour in water and season with beef and chicken bouillon, rosemary, salt, pepper, steak seasoning and onion flakes. Stir in frozen vegetables. Cook, stirring occasionally, until most of the water has evaporated."
    },
    {
      "position": 4,
      "text": "Pour meat mixture into a 2 quart casserole dish. Cover top with mashed potatoes. Bake in preheated oven for 20 to 30 minutes, or until top begins to brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 60,

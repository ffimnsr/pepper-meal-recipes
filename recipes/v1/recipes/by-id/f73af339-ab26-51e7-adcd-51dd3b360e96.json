  "id": "f73af339-ab26-51e7-adcd-51dd3b360e96",
  "slug": "make-ahead-meatloaf-muffins",
  "name": "Make-Ahead Meatloaf Muffins",
  "recipe_type": "main",
  "brief_description": "'Frosted' with a brown sugar, ketchup, and vinegar glaze, these meatloaf muffins are easy to prep ahead of time for an on-the-go meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 12-cup muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine beef, tomatoes, bread crumbs, egg substitute, 3 tablespoons ketchup, dried onion, Worcestershire sauce, salt, and pepper in a bowl. Fill muffin cups with the beef mixture."
    },
    {
      "position": 3,
      "text": "Mix remaining 1 tablespoon ketchup with brown sugar and vinegar in a small bowl to create a glaze. Brush or spoon glaze over the muffins."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until muffins are no longer pink in the center, about 35 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "c41dd90b-35fb-5b6e-b52c-08bc7edb626e",
  "slug": "red-lentil-soup-with-lemon-mint-yogurt",
  "name": "Red Lentil Soup with Lemon Mint Yogurt",
  "recipe_type": "soup",
  "brief_description": "A lemon-mint yogurt brings refreshing flavor to Chef John's red lentil soup that's so satisfying, it doesn't need meat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a saucepan over medium-high heat. Add onion, tomato paste, and salt to melted butter. Cook, stirring often, until onion softens and tomato paste turns a deep brick red or brown color, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Add garlic, cumin, and cayenne pepper; cook and stir for 2 minutes. Stir in broth and bring to a boil. Stir in lentils, celery, and carrot. Reduce heat to medium-low and simmer, stirring occasionally, until lentils and vegetables are very tender, 30 to 40 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, make lemon-mint yogurt: Grind mint and salt in a mortar and pestle to a paste. Add yogurt, lemon juice, and zest; stir together until combined. Refrigerate until ready to serve."
    },
    {
      "position": 4,
      "text": "Taste soup for seasoning. Use an immersion blender to pur\u00e9e about 1/2 of the soup to achieve a creamier texture. Serve hot with spoonfuls of lemon-mint yogurt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0a0f7f0b-cf73-5724-9b99-939fe76db43c",
  "slug": "stroganoff",
  "name": "Stroganoff",
  "recipe_type": "soup",
  "brief_description": "Wondering how to make beef stroganoff? Here's a simple, inexpensive version of this popular dinner entr\u00e9e. Saut\u00e9ed ground beef and onions are combined with cream of mushroom soup and sour cream, then served over egg noodles.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet over medium heat, saut\u00e9 beef and onions for 10 minutes, or until meat is browned and onion is tender."
    },
    {
      "position": 2,
      "text": "Stir in flour, salt, and paprika. Add condensed soup, mix well, and cook, uncovered, for 20 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low and add sour cream, stirring well and allowing to heat through. Cover and set this mixture aside."
    },
    {
      "position": 4,
      "text": "Cook egg noodles according to package directions. Drain. Serve beef mixture over noodles."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5d484e64-3919-533f-b707-6e457a13b231",
  "slug": "vegan-enchilada-bake",
  "name": "Vegan Enchilada Bake",
  "recipe_type": "main",
  "brief_description": "This vegan enchilada casserole is a quick, hearty dinner of seitan, vegan cheese, refried beans, rice, and tortillas slathered in tomatoes and green enchilada sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour crushed tomatoes into the bottom of a casserole dish. Layer 1/3 of the rice, 1/3 of the beans, 1/3 of the diced tomatoes, 1/3 of the seitan, 1/3 of the vegan cheese, 1/3 of the tortillas, and 1/3 of the enchilada sauce into the dish, in that order. Repeat with 2 more layers."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until vegan cheese melts and casserole is heated through, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "frito-cowboy-coleslaw-recipe-11805680",
  "name": "Frito Cowboy Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This Frito cowboy coleslaw is a hearty slaw with beans, bacon, and corn and a spicy, creamy lime dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the dressing: Whisk mayonnaise, sour cream, lime juice, adobo sauce, taco seasoning, and ranch seasoning together in a bowl."
    },
    {
      "position": 2,
      "text": "Toss coleslaw mix, corn, black beans, jalapenos, bell pepper, green onions, and bacon together in a large bowl. Pour in dressing and stir until ingredients are completely coated."
    },
    {
      "position": 3,
      "text": "Refrigerate until ready to serve. Immediately before serving, stir in Fritos or serve Fritos on the side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

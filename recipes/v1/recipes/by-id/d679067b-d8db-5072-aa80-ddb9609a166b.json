  "id": "d679067b-d8db-5072-aa80-ddb9609a166b",
  "slug": "one-pan-orecchiette-pasta",
  "name": "One Pan Orecchiette Pasta",
  "recipe_type": "main",
  "brief_description": "Orecchiette pasta with spicy Italian sausage, arugula, and Parmesan all feature in this flavorsome meal that's quick and easy to make in one pot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large, deep skillet over medium heat. Add onion with a pinch of salt; cook and stir until onion has softened and turned translucent, about 5 minutes. Stir in sausage and cook until browned, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Pour 1 1/2 cups chicken broth into sausage mixture and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon."
    },
    {
      "position": 4,
      "text": "Add orecchiette pasta; cook and stir pasta in hot broth, adding remaining broth when liquid is absorbed, until pasta is cooked through and most of the broth is absorbed, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Stir arugula into sausage-pasta mixture until arugula wilts."
    },
    {
      "position": 6,
      "text": "Ladle pasta into bowls and sprinkle with Parmigiano-Reggiano cheese."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

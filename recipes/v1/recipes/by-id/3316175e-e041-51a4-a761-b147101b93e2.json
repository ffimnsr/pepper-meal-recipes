  "id": "3316175e-e041-51a4-a761-b147101b93e2",
  "slug": "banana-pudding-iv",
  "name": "Banana Pudding",
  "recipe_type": "dessert",
  "brief_description": "This banana pudding with cream cheese is easy to make with vanilla wafers, condensed milk, and bananas for a simple and delicious no-bake dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream cheese in a large bowl until fluffy. Beat in condensed milk, then pudding mix. Gradually mix in cold milk until smooth, followed by vanilla."
    },
    {
      "position": 3,
      "text": "Fold in 1/2 of the whipped topping."
    },
    {
      "position": 4,
      "text": "Line the bottom of a 9x13-inch dish with vanilla wafers."
    },
    {
      "position": 5,
      "text": "Arrange sliced bananas evenly on top."
    },
    {
      "position": 6,
      "text": "Cover with pudding mixture."
    },
    {
      "position": 7,
      "text": "Top with remaining whipped topping."
    },
    {
      "position": 8,
      "text": "Cover and chill in the refrigerator for at least 3 hours before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

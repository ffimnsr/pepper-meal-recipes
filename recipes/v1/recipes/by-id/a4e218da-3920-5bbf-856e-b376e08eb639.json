  "id": "a4e218da-3920-5bbf-856e-b376e08eb639",
  "slug": "crepes",
  "name": "Cr\u00eapes",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for cr\u00eapes is made with eggs, milk, flour, salt and oil. The delicately thin pancakes are carefully cooked in an oiled pan until golden brown.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, flour, eggs, 1 1/2 teaspoons oil, and salt in a blender; process until smooth. Cover and refrigerate for 1 hour."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium-high heat and brush with remaining oil. Pour 1/8 of the cr\u00eape batter (about 1/4 cup) into the pan; tilt the pan until batter coats the entire surface. Cook until golden brown, 1 to 2 minutes per side, then remove to a plate. Repeat to cook remaining cr\u00eapes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

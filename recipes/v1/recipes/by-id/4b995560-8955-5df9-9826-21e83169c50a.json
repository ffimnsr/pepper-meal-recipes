  "slug": "hibachi-zucchini-recipe-11781029",
  "name": "Hibachi Zucchini",
  "recipe_type": "side",
  "brief_description": "This hibachi zucchini is so simple to make at home, you can have a Japanese steak house experience any time you like. It's a quick saute of zucchini and onion with garlic, ginger, and soy sauce.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Add onions; cook and stir for 4 minutes. Add garlic and ginger. Cook 1 minute more."
    },
    {
      "position": 2,
      "text": "Add zucchini. Cook 3 minutes more, stirring constantly. Add soy sauce, sesame oil, salt, and pepper. Cook until zucchini is as tender as you like, about 2 minutes more. Garnish with sesame seeds."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,

  "id": "d544cedb-5971-532b-ac87-c9c770bdb4f2",
  "slug": "smoked-sausage-and-tortellini-soup",
  "name": "Smoked Sausage and Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "Nothing beats a bowl of warm smoked sausage and tortellini soup filled with cheesy pasta and meaty smoked sausage. This comfort recipe takes 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Add onion and garlic; cook until soft, about 5 minutes. Stir in sausage and tomato paste; cook 3 to 4 minutes."
    },
    {
      "position": 2,
      "text": "Add broth, diced tomatoes, tortellini, salt, and black pepper; bring to a boil. Reduce heat; simmer for 5 minutes. Stir in spinach; cook 3 to 4 minutes. Top servings with Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

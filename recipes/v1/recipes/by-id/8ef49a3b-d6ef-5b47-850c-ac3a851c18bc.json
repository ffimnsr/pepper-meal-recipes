  "id": "8ef49a3b-d6ef-5b47-850c-ac3a851c18bc",
  "slug": "hot-honey-chicken-and-rice-bowls-recipe-12012344",
  "name": "Hot Honey Chicken and Rice Bowls",
  "recipe_type": "main",
  "brief_description": "These hot honey chicken and rice bowls turn leftover chicken and rice into a bold, spicy dinner. The chicken is warmed in a fiery hot honey-garlic sauce with Sriracha and cayenne, then served over rice with a cooling sour cream sauce to balance every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir sour cream, garlic, dill, onion powder together in a small bowl. Season with salt and pepper; set aside."
    },
    {
      "position": 2,
      "text": "Stir honey, garlic, pepper flakes, cayenne, salt, and pepper together in a small bowl. Add chicken to a skillet over medium heat, and heat chicken through. Stir in hot honey mixture; cook and stir just until heated through; remove from heat."
    },
    {
      "position": 3,
      "text": "To assemble, warm rice in a microwave-safe bowl on High for 1 to 2 minutes. Divide rice between serving bowls. Top with chicken, then drizzle with sour cream sauce. Top with sliced green onion and serve."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

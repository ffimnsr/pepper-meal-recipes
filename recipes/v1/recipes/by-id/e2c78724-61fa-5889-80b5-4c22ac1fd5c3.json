  "id": "e2c78724-61fa-5889-80b5-4c22ac1fd5c3",
  "slug": "air-fryer-potato-apple-latkes-recipe-8347905",
  "name": "Air Fryer Potato-Apple Latkes",
  "recipe_type": "dessert",
  "brief_description": "Use your air fryer to cook up these delicious potato-apple latkes and serve as a side with your favorite mains.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together potatoes, apple, egg yolk, flour, pepper, and salt in a large bowl."
    },
    {
      "position": 2,
      "text": "Lightly coat air fryer basket with cooking spray. Drop 4 (1/4-cup) scoops potato mixture into basket. Press gently with a spatula to flatten; lightly coat tops with cooking spray."
    },
    {
      "position": 3,
      "text": "Set the air fryer to 350 degrees F (175 degrees C). Cook latkes, turning halfway through, until browned on both sides, 8 to 10 minutes. Repeat with remaining potato mixture. Garnish with sliced green onion and serve with sour cream or cr\u00e8me fra\u00eeche."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

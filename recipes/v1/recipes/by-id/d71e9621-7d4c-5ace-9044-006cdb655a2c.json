  "instructions": [
    {
      "position": 1,
      "text": "Combine tomatoes, rice, tomato sauce, chicken broth, corn, bacon, onion, red bell pepper, olives, salsa, and chili powder in a rice cooker. Seal the cooker and select rice setting according to manufacturer's instructions; cook until tender, 20 to 25 minutes."
    }

  "id": "c3bec4c3-0a55-5e7e-a3b8-ee7a2973156f",
  "slug": "fruit-leather",
  "name": "Fruit Leather",
  "recipe_type": "appetizer",
  "brief_description": "Make your own fruit leather out of apples and pears, and enjoy it as a snack any time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 150 degrees F (65 degrees C). Cover a baking sheet with a layer of plastic wrap or parchment paper."
    },
    {
      "position": 2,
      "text": "In the container of a blender, combine the sugar, lemon juice, apple and pear. Cover and puree until smooth."
    },
    {
      "position": 3,
      "text": "Spread evenly on the prepared pan. Place the pan on the top rack of the oven."
    },
    {
      "position": 4,
      "text": "Bake for 5 to 6 hours, leaving the door to the oven partway open. Fruit is dry when the surface is no longer tacky and you can tear it like leather."
    },
    {
      "position": 5,
      "text": "Roll up on the parchment paper or plastic wrap and store in an airtight jar."
    },
    {
      "position": 6,
      "text": "Cut into strips and enjoy."
    }
  ],
  "servings": 16,

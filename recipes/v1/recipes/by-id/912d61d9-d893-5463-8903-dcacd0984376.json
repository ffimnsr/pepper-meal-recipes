  "id": "912d61d9-d893-5463-8903-dcacd0984376",
  "slug": "lemon-cream-cheese-bars",
  "name": "Lemon Cream Cheese Bars",
  "recipe_type": "dessert",
  "brief_description": "This lemon cream cheese bar recipe features layers of crescent roll dough filled with sweetened cream cheese flavored with fresh lemon zest and juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish with aluminum foil, leaving an overhang; coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Unroll 1 crescent roll dough; press into bottom of the prepared baking dish, stretching to edges."
    },
    {
      "position": 3,
      "text": "Combine lemon juice and \u00be lemon zest in a bowl. Beat cream cheese and \u00bd cup sugar into juice-zest mixture with an electric mixer until smooth and creamy; spread over crescent roll dough in the baking dish."
    },
    {
      "position": 4,
      "text": "Unroll remaining 1 crescent roll dough; place over cream cheese mixture, stretching to edges. Brush dough with melted butter. Combine 3 tablespoons sugar and remaining \u00bc lemon zest in a small bowl; sprinkle over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is golden brown, about 30 minutes. Cool for about 20 minutes."
    },
    {
      "position": 6,
      "text": "Lift dessert from baking dish using foil overhang; transfer to a cutting board. Cut into squares, leaving foil in place. Return bars to the baking dish; refrigerate until chilled, at least 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

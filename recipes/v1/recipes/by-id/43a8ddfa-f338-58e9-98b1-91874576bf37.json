  "id": "43a8ddfa-f338-58e9-98b1-91874576bf37",
  "slug": "lebanese-style-red-lentil-soup",
  "name": "Red Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This smooth red lentil soup is a spicy Lebanese-style dish packed with red lentils, onion, and garlic and flavored with cumin, lemon, and cilantro.",
  "cuisine": "Inspired Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring chicken stock and lentils to a boil in a large saucepan over high heat. Reduce heat to medium-low, cover, and simmer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a skillet over medium heat. Stir in onion and garlic; cook until onion has softened and turned translucent, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir onion mixture into lentils; season with cumin and cayenne. Continue simmering until lentils are tender, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Puree soup in a standing blender or with an immersion blender until smooth. Stir in lemon juice and cilantro."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

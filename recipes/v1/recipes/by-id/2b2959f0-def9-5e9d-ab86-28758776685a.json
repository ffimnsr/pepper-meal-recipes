  "id": "2b2959f0-def9-5e9d-ab86-28758776685a",
  "slug": "easy-pumpkin-cheesecake-crescent-bars-recipe-11810022",
  "name": "Easy Pumpkin Cheesecake Crescent Bars",
  "recipe_type": "dessert",
  "brief_description": "Make these easy pumpkin cheesecake crescent bars for fall with pureed pumpkin, cream cheese, and crescent roll dough. This dessert hits all the warm pumpkin-spiced notes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a 9x13-inch pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat cream cheese in a bowl with an electric mixer until smooth. Add white sugar and egg and beat until smooth. Beat in pumpkin and pumpkin spice."
    },
    {
      "position": 3,
      "text": "Lay 1 package crescent roll dough in the prepared pan and pinch openings together. Pour cream cheese filling over dough and spread until smooth with a spatula."
    },
    {
      "position": 4,
      "text": "Carefully roll out the remaining package crescent roll dough over filling. Pinch openings together."
    },
    {
      "position": 5,
      "text": "Whisk egg white and water together in a small bowl. Using a pastry brush, spread the mixture over the top of crust."
    },
    {
      "position": 6,
      "text": "Bake until a toothpick poked into the center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 7,
      "text": "For glaze, whisk confectioner's sugar, milk, and vanilla together in a bowl until smooth. Let the cake cool for 20 minutes, then drizzle with glaze. Serve warm or cold."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,

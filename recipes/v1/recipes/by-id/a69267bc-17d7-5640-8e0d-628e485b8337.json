  "id": "a69267bc-17d7-5640-8e0d-628e485b8337",
  "slug": "chicken-and-broccoli-alfredo",
  "name": "Chicken and Broccoli Alfredo",
  "recipe_type": "soup",
  "brief_description": "Linguini is mixed with pieces of tender chicken and broccoli flowerets and coated with a rich, satiny Alfredo sauce featuring Campbell’s® Condensed Cream of Mushroom Soup to make a quick and fabulous dish.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Cook linguine according to package directions. Add broccoli for last 4 minutes of cooking time. Drain."
    },
    {
      "position": 2,
      "text": "Heat butter in skillet. Cook chicken until browned, stirring often."
    },
    {
      "position": 3,
      "text": "Add soup, milk, cheese, black pepper and linguine mixture and heat through. Serve with additional Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

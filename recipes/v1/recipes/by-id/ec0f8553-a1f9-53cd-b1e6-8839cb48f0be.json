  "id": "ec0f8553-a1f9-53cd-b1e6-8839cb48f0be",
  "slug": "turkey-salad",
  "name": "Turkey Salad",
  "recipe_type": "salad",
  "brief_description": "This turkey salad is a creamy blend of leftover turkey, celery, and red bell pepper to make a tasty spread for crackers or filling for sandwiches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cooked turkey, celery, green onions, and red bell pepper in a blender or food processor. Pulse until finely chopped."
    },
    {
      "position": 3,
      "text": "Transfer turkey mixture to a medium bowl. Mix in mayonnaise, prepared Dijon-style mustard, cider vinegar, white sugar, and salt until well combined. Cover and refrigerate, 8 hours to overnight, before serving."
    }
  ],
  "servings": 24,

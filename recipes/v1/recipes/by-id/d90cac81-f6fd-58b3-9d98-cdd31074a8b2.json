{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d90cac81-f6fd-58b3-9d98-cdd31074a8b2",
  "slug": "chef-johns-tuna-noodle-casserole",
  "name": "Chef John's Tuna Noodle Casserole",
  "recipe_type": "main",
  "brief_description": "It's the king of comfort food casseroles made from scratch with white Cheddar, frozen peas, tuna, and a crispy breadcrumb topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly butter a 9x13-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Melt 3 tablespoons butter in a medium saucepan over medium heat. Saute onion with 1/2 teaspoon kosher salt until it starts to soften up and turn translucent, 3 to 4 minutes. Add the flour, and cook, stirring, for 3 minutes, reducing heat if needed."
    },
    {
      "position": 3,
      "text": "Pour in cold milk and whisk for 1 minute. Raise heat to medium-high and cook, stirring often, until the sauce thickens and comes to a simmer. Remove from heat, whisk in Cheddar cheese, and reserve until needed."
    },
    {
      "position": 4,
      "text": "Fill a large pot with water and remaining salt and bring to a rapid boil. Cook egg noodles for 5 minutes. Drain well and add to a large mixing bowl. Stir in the reserved sauce, followed by tuna, peas, cayenne, black pepper, and Worcestershire sauce. Mix with a spatula until evenly combined."
    },
    {
      "position": 5,
      "text": "Pour the mixture into the prepared dish. Mix bread crumbs, Parmigiano-Reggiano cheese, and olive oil together in a small bowl until combined and resembling wet sand. Sprinkle evenly over the casserole."
    },
    {
      "position": 6,
      "text": "Bake in the center of the preheated oven until browned and bubbly, about 30 minutes. Let sit for 10 minutes before cutting and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

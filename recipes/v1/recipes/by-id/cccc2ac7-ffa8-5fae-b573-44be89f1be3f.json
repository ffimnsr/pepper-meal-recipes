  "id": "cccc2ac7-ffa8-5fae-b573-44be89f1be3f",
  "slug": "apricot-and-peach-fried-pies",
  "name": "Apricot and Peach Fried Pies",
  "recipe_type": "dessert",
  "brief_description": "Dried apricots and peaches are cooked down to make a luscious filling for crispy, flaky hand-held pies.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "To Make Crust: In a large bowl, mix together flour and salt. Cut in shortening until mixture is crumbly. Mix in milk and stir until dough forms a ball. Roll out dough and cut into 18 6-inch circles. Set aside."
    },
    {
      "position": 2,
      "text": "To Make Filling: In a large saucepan, combine apricots, peaches, and sugar. Add enough water to cover fruit. Cover pan and cook over low heat until fruit is falling apart. Remove lid and continue to cook until water is evaporated."
    },
    {
      "position": 3,
      "text": "Place oil or shortening in small high-sided skillet. Place over medium heat. Spoon equal amounts of filling into each pastry circle and fold in half. Seal pastry with a fork dipped in cold water."
    },
    {
      "position": 4,
      "text": "Fry a few pies at a time in hot oil, browning on both sides. Drain pies on paper towels."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "medium",

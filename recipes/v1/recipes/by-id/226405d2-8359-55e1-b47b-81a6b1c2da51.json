  "id": "226405d2-8359-55e1-b47b-81a6b1c2da51",
  "slug": "pineapple-mojito",
  "name": "Pineapple Mojito",
  "recipe_type": "drink",
  "brief_description": "If you love minty and refreshing cocktails, then learning how to make this pineapple mojito recipe is a must and will leave your thirst quenched.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Muddle 8 mint leaves, sugar, and pineapple in a highball glass."
    },
    {
      "position": 2,
      "text": "Fill the glass with ice cubes. Pour in pineapple juice and rum. Top with club soda."
    },
    {
      "position": 3,
      "text": "Garnish with a pineapple wedge and remaining mint leaves to serve."
    }
  ],
  "servings": 1,

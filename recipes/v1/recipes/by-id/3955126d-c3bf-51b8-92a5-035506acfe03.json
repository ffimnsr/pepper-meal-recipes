  "id": "3955126d-c3bf-51b8-92a5-035506acfe03",
  "slug": "spinach-feta-and-rice-casserole-recipe-8672182",
  "name": "Spinach, Feta, and Rice Casserole",
  "recipe_type": "dessert",
  "brief_description": "This spinach, feta, and rice casserole is a perfectly creamy rice casserole, scented with lemon and dill. Sun-dried tomatoes add a pop of sweetness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large ovenproof skillet over medium-high heat. Add scallions, sun-dried tomatoes, garlic, and oregano; cook, stirring often, until scallions soften, about 2 minutes. Add spinach, and cook, stirring occasionally, until thawed, 5 to 6 minutes."
    },
    {
      "position": 3,
      "text": "Stir in broth, rice, lemon zest and juice, salt, pepper, and 1 cup of the feta. Bring to a simmer over high heat, stirring occasionally. Stir in dill, and top evenly with remaining 1/2 cup feta."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until rice is tender and feta begins to brown, about 20 minutes. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

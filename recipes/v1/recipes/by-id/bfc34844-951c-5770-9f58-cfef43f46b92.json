  "id": "bfc34844-951c-5770-9f58-cfef43f46b92",
  "slug": "strawberry-balsamic-pork-chops-recipe-8671638",
  "name": "Strawberry Balsamic Pork Chops",
  "recipe_type": "dessert",
  "brief_description": "These strawberry balsamic pork chops in a sweetly tart glaze are a one-skillet dish that takes full advantage of how well fruit and pork go together, and the delicious combination of strawberries and balsamic vinegar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 1ablespoon unsalted butter in a large, non-stick skillet over medium heat. Stir in balsamic vinegar and cook until mixture is bubbly and fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Add sliced strawberries, honey, a pinch of salt, and fresh thyme sprigs, to taste to the skillet. Stir, and cook until strawberries are softened and the liquid has thickened slightly, 5 to 8 minutes, stirring occasionally. Pour into a small bowl, remove thyme sprigs, and set aside."
    },
    {
      "position": 3,
      "text": "Wipe out the skillet, return to the burner, add the remaining butter, and pour in olive oil."
    },
    {
      "position": 4,
      "text": "Pat chops dry; season to taste with salt and pepper. When butter stops bubbling, add seasoned chops and cook until browned on each side, 1 to 3 minutes. Add strawberry mixture to the skillet, and turn each chop to coat with the liquid. Stack strawberries on top of each chop."
    },
    {
      "position": 5,
      "text": "Simmer until an instant read thermometer inserted near the center of chops reads 145 degrees F (63 degrees C), 6 to 10 minutes. Garnish with additional fresh thyme sprigs, if desired, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

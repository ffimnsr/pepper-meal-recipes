  "id": "331bfbd9-c2eb-590e-b01d-5e78ea7a2555",
  "slug": "churro-cheesecake-bars-recipe-7554374",
  "name": "Churro Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "Churro cheesecake with crescent dough crust and a layer of cinnamon cream cheese filling is topped with cinnamon sugar and cut into bars for easy eating.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a 13x9-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine sugar and cinnamon in a small bowl. Sprinkle \u00bd of the sugar mixture evenly in the bottom of the pan."
    },
    {
      "position": 3,
      "text": "Place one crescent sheet in the pan, trimming to fit as needed."
    },
    {
      "position": 4,
      "text": "To make the filling: Beat cream cheese, egg, vanilla, and orange zest together in a medium bowl with an electric mixer on medium speed until smooth."
    },
    {
      "position": 5,
      "text": "Spread cream cheese filling evenly over crescent crust in pan."
    },
    {
      "position": 6,
      "text": "Gently lay the remaining crescent sheet over the filling."
    },
    {
      "position": 7,
      "text": "Pour melted butter over the top."
    },
    {
      "position": 8,
      "text": "Sprinkle remaining sugar mixture evenly over top."
    },
    {
      "position": 9,
      "text": "Bake until golden brown, about 30 minutes. Cool slightly. Cut into bars. Serve warm or chill and serve within 24 hours. If desired, drizzle with Cajeta just before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

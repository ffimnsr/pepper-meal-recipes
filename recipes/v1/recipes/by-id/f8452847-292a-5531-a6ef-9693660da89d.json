  "id": "f8452847-292a-5531-a6ef-9693660da89d",
  "slug": "neiman-marcus-lemon-squares-recipe-12006508",
  "name": "Neiman Marcus Lemon Squares",
  "recipe_type": "dessert",
  "brief_description": "These Neiman Marcus lemon squares are a twist on the classic ooey-gooey butter cake, with a rich base and cream cheese topping. Packed with bright lemon zest in both layers, they\u2019re irresistibly tart, sweet, and decadent.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking pan. You may also line pan with parchment paper and spray with cooking spray for easy removal."
    },
    {
      "position": 2,
      "text": "Combine cake mix with 2 eggs, butter, and 1 teaspoon lemon zest in a large bowl and mix well. The batter will be stiff. Add cake batter to the prepared pan and spread into an even layer."
    },
    {
      "position": 3,
      "text": "Combine cream cheese, 3 1/4 cups powdered sugar, remaining egg, egg yolk, and remaining zest in a large bowl and mix well. Pour mixture evenly over cake mix layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cake is set around the edges, just beginning to pull away from the sides, and slightly jiggly in the center, 23 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Let cake cool completely before slicing into bars. Sprinkle with remaining powdered sugar and add more lemon zest if desired."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9aaad02d-66e0-51b5-b874-96d5bca09c55",
  "slug": "barbecue-stuffed-sweet-potatoes-recipe-11959450",
  "name": "Barbecue Stuffed Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "These barbecue stuffed sweet potatoes are the perfect balance of comfort food and bold, tangy flavor. Roasted sweet potatoes are topped with barbecue pulled pork, cheese, red onion and pickles and drizzled with a creamy sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Rub olive oil over cut sides of each sweet potato and sprinkle evenly with 1 teaspoon salt and 1/2 teaspoon pepper. Place potatoes, cut side down on a parchment-lined baking sheet and bake until browned around the edges, about 45 minutes. Let stand before serving, cut side down, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, warm barbecue pork on the stovetop or in the microwave until heated throughout, 3 to 5 minutes. Top each potato evenly with pulled pork, cheese, onion, and pickles."
    },
    {
      "position": 4,
      "text": "Combine mayonnaise with remaining salt and pepper, apple cider vinegar, Worcestershire sauce, brown sugar, garlic powder, and cayenne in a small bowl; whisk until well blended. Drizzle sauce over potatoes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

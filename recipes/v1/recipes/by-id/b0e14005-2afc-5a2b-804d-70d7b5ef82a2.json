  "id": "b0e14005-2afc-5a2b-804d-70d7b5ef82a2",
  "slug": "blonde-apple-brownies",
  "name": "Blonde Apple Brownies",
  "recipe_type": "dessert",
  "brief_description": "Blonde apple brownies recipe, made with apples, brown sugar, and cinnamon, take less than an hour to make, and offer a twist on the traditional blondie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat butter, white sugar, brown sugar, and eggs together in a bowl with an electric mixer until smooth; beat in flour until well combined. Beat in baking powder, then stir in cinnamon. Fold in apples. Transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out with moist crumbs, about 45 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "id": "013dc1c2-d4f0-5570-992c-eaa605c4014c",
  "slug": "chicken-fried-chicken",
  "name": "Chicken Fried Chicken",
  "recipe_type": "main",
  "brief_description": "Potato flakes are the secret ingredient that make the saltine crust on this simple chicken-fried chicken dish so tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place crackers in a large resealable plastic bag; seal bag and crush crackers with a rolling pin until they are coarse crumbs. Add the flour, potato flakes, seasoned salt, and pepper and mix well."
    },
    {
      "position": 2,
      "text": "Beat egg in a shallow dish or bowl. One by one, dredge chicken pieces in egg, then place in bag with crumb mixture. Seal bag and shake to coat."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Fry chicken, turning frequently, until golden brown and juices run clear, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

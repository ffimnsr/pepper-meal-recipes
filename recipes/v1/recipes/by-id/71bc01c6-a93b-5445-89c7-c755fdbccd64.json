  "id": "71bc01c6-a93b-5445-89c7-c755fdbccd64",
  "slug": "chicken-thigh-and-orzo-skillet-recipe-11737653",
  "name": "Chicken Thigh and Orzo Skillet",
  "recipe_type": "main",
  "brief_description": "This chicken thigh and orzo skillet is a vibrant, one-pan lemon garlic dish that combines tender marinated chicken and orzo pasta in a light, flavorful sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir Greek yogurt, olive oil, lemon juice, garlic, honey, paprika, herb seasoning, cumin, coriander, black pepper, and salt together in a bowl, add chicken thighs, and marinate in the refrigerator for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place cast iron skillet over medium-high heat. Heat olive oil and butter together until butter is melted."
    },
    {
      "position": 3,
      "text": "Remove chicken from marinade, let excess drip off, and place chicken skin side down in skillet; discard marinade. Cook until skin is golden, about 8 minutes. Remove chicken to a plate and keep warm."
    },
    {
      "position": 4,
      "text": "Add onion to the skillet, saut\u00e9 until translucent and softened, about 5 minutes. Add garlic, cook and stir until fragrant, about 30 seconds. Stir in parsley, orzo, chicken broth, and lemon zest."
    },
    {
      "position": 5,
      "text": "Nestle chicken, skin side up, on top of orzo. Cover skillet with a lid."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until orzo is tender, about 30 minutes. Squeeze a little lemon juice over the top and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

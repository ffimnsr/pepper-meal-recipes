  "id": "fae7dd02-0cc6-58fd-b11b-b1a8b75ed076",
  "slug": "easy-sugar-cookies",
  "name": "Easy Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "This sugar cookie recipe uses easy ingredients you probably already have on hand for soft and chewy cookies that are sure to satisfy a sweet tooth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir flour, baking soda, and baking powder together in a small bowl."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until smooth."
    },
    {
      "position": 4,
      "text": "Beat in egg and vanilla."
    },
    {
      "position": 5,
      "text": "Gradually blend in flour mixture."
    },
    {
      "position": 6,
      "text": "Roll dough into walnut-sized balls and place 2 inches apart onto ungreased baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until edges are just golden, 8 to 10 minutes. Cool on the baking sheets briefly before removing to a wire rack to cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

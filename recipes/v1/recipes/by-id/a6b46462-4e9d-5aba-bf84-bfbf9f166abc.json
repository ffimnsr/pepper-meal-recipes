  "id": "a6b46462-4e9d-5aba-bf84-bfbf9f166abc",
  "slug": "october-oatmeal-pumpkin-muffins",
  "name": "October Oatmeal Pumpkin Muffins",
  "recipe_type": "dessert",
  "brief_description": "These spiced oatmeal-pumpkin muffins are sweetened with maple syrup and are quick to make for a delicious autumn breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray 6 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk all-purpose flour, whole wheat flour, sugar, salt, pumpkin pie spice, baking powder, baking soda, cinnamon, and nutmeg together in a large bowl until thoroughly combined. Stir pumpkin puree, milk, eggs, and maple syrup into flour mixture until batter is smooth; fold oats into batter. Scoop batter into prepared muffin cups, filling them to the top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 30 minutes; set aside to cool 5 to 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b6c30748-53d6-5aa0-ad91-9ce0c619ecab",
  "slug": "soft-caramel-corn",
  "name": "Soft Caramel Corn",
  "recipe_type": "dessert",
  "brief_description": "Try this popcorn recipe for soft caramel corn that's perfect to serve at parties or during the holidays. It's also a great idea for gifting!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place popcorn into a large bowl. Shake the bowl and toss gently until unpopped kernels sink to the bottom. Discard unpopped kernels."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, corn syrup, and butter in a saucepan over medium-high heat. Cook, stirring constantly, until mixture reaches the soft-crack stage. To test, the temperature should be between 270 to 290 degrees F (132 to 143 degrees C) and a small amount of syrup dropped into cold water should form hard but pliable threads."
    },
    {
      "position": 3,
      "text": "Remove from the heat. Carefully pour condensed milk into the saucepan and stir until smooth."
    },
    {
      "position": 4,
      "text": "Pour 1/4 of the caramel at a time over popcorn, stirring well after each addition."
    },
    {
      "position": 5,
      "text": "Let cool for at least 10 minutes before serving."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "7ec91096-157c-5025-aeb2-a3d41648db29",
  "slug": "new-red-potato-salad",
  "name": "New Red Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This simple chilled potato salad recipe makes great use of unpeeled new red potatoes, hard-cooked eggs, celery, and mayonnaise \u2014 perfect for a cookout.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes. Drain, cool, and chop into 1-inch cubes. Transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Meanwhile, place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove eggs from hot water; cool, peel, and dice."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, green onions, milk, vinegar, salt, and black pepper together in a bowl until well combined; pour over potatoes. Add eggs and celery; mix well."
    },
    {
      "position": 4,
      "text": "Cover the bowl with plastic wrap; chill in the refrigerator before serving, about 2 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

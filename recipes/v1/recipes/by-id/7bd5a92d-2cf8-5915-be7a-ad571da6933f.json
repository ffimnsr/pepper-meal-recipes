  "id": "7bd5a92d-2cf8-5915-be7a-ad571da6933f",
  "slug": "shrimp-stir-fry-noodles-with-peanut-sauce-recipe-11859822",
  "name": "Shrimp Stir-Fry Noodles with Peanut Sauce",
  "recipe_type": "main",
  "brief_description": "These shrimp stir-fry noodles with peanut sauce, loaded with shrimp, bell peppers, and peanuts, make a filling and speedy dinner. No rice noodles? No problem. Linguine is an excellent stand-in for this Sriracha-spiced peanut sauce.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta until tender with a bite, 9 to 11 minutes, or according to package directions. Reserve 1/2 cup cooking water; drain."
    },
    {
      "position": 2,
      "text": "To make the peanut sauce: Whisk together peanut butter, soy sauce, maple syrup, lemon juice, 2 teaspoons Sriracha, ginger, and 2 tablespoons reserved cooking water."
    },
    {
      "position": 3,
      "text": "Heat oil over medium-high heat in a very large skillet. Add onion and bell pepper. Cook and stir until softened, 4 minutes. Add shrimp and peas. Cook and stir until shrimp is opaque, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Add pasta and peanut sauce to skillet. Toss to combine. Cook until heated through, 1 to 2 minutes, adding additional pasta water as needed to reach desired sauce consistency. Garnish with cilantro and/or sesame seeds. Serve with Sriracha."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "fcad4eb9-1099-5cc9-9d38-fe5fe8f4e110",
  "slug": "springfield-style-cashew-chicken-recipe-11920478",
  "name": "Springfield Style Cashew Chicken",
  "recipe_type": "main",
  "brief_description": "Springfield-style cashew chicken was invented by Chinese immigrant chef David Leong in Springfield, Missouri. This recipe captures the dish's crispy chicken, savory gravy, and roasted cashews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix the flour, seasoned salt, ground white pepper, granulated garlic, and cayenne pepper (if using)."
    },
    {
      "position": 2,
      "text": "In another medium bowl, whisk the eggs and add the milk, seasoned salt, and white pepper."
    },
    {
      "position": 3,
      "text": "Coat the diced chicken pieces in the flour mixture, then dip them into the milk batter and coat them again in the flour mixture."
    },
    {
      "position": 4,
      "text": "Place the breaded chicken pieces on a cookie sheet until ready to fry."
    },
    {
      "position": 5,
      "text": "Heat the olive oil in a large skillet over medium heat."
    },
    {
      "position": 6,
      "text": "Fry the chicken pieces in batches until golden brown and cooked through, about 3 to 5 minutes per side."
    },
    {
      "position": 7,
      "text": "Remove the chicken from the skillet and place it on a paper towel-lined plate to drain excess oil."
    },
    {
      "position": 8,
      "text": "Combine the chicken broth, salt, sugar, soy sauce, oyster sauce, ground ginger, and sesame oil in a medium saucepan. Bring to a boil."
    },
    {
      "position": 9,
      "text": "Mix the cornstarch with water in a small bowl to create a slurry."
    },
    {
      "position": 10,
      "text": "Slowly add the slurry to the boiling mixture, whisking constantly until the sauce reaches a gravy-like consistency. Stir in cashews."
    },
    {
      "position": 11,
      "text": "Place the fried chicken pieces on a serving platter and pour the cashew chicken sauce over the chicken. Serve with a side of plain or fried rice and steamed vegetables. Recipe excerpted from Route 66 Recipes: A Culinary Cruise Along the Mother Road , reprinted with permission from Arcadia Publishing."
    }
  ],
  "servings": 8,

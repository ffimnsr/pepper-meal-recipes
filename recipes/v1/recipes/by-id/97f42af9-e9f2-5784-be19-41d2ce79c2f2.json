  "id": "97f42af9-e9f2-5784-be19-41d2ce79c2f2",
  "slug": "slow-cooker-green-beans-ham-and-potatoes",
  "name": "Slow Cooker Green Beans, Ham and Potatoes",
  "recipe_type": "main",
  "brief_description": "This crockpot green beans and potatoes recipe is made with green beans simmered in a slow cooker with ham hocks, onion, new potatoes, and spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Halve green beans if they are large; place in a slow cooker with water to barely cover. Add ham hocks and onion. Cover and cook on High until simmering. Reduce heat to Low; cook until beans are crisp but not done, 2 to 3 hours."
    },
    {
      "position": 3,
      "text": "Remove ham hocks from the slow cooker. Add potatoes to the slow cooker; cook on Low for 45 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, remove ham meat from the bones, then chop or shred meat and return to the slow cooker. Season with bouillon, garlic powder, onion powder, seasoning salt, and pepper."
    },
    {
      "position": 5,
      "text": "Use a slotted spoon to transfer green beans, potatoes, and ham into a serving dish with a bit of broth."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 30,

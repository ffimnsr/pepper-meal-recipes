  "id": "8f4ca23f-47f3-5716-889f-24b6c382a7e1",
  "slug": "balsamic-ravioli",
  "name": "Balsamic Ravioli",
  "recipe_type": "main",
  "brief_description": "This ravioli with a balsamic and brown butter sauce will take weeknight dinner to a new level. It\u2019s quick and easy!",
  "cuisine": "Italian American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast walnuts in a skillet over medium heat; cook and stir until browned and fragrant, 8 to 10 minutes. Remove from skillet."
    },
    {
      "position": 2,
      "text": "Fill a pot with lightly salted water and bring to a rolling boil; stir in ravioli and return to a boil. Cook uncovered, occasionally stirring, until ravioli float to the top and filling is hot, 3 to 5 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Warm butter in a skillet over medium heat until slightly brown, about 1 minute. Add balsamic vinegar; cook and stir until melted and combined, 1 to 2 minutes. Stir in ravioli; mix until combined. Top with walnuts and Parmesan cheese."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

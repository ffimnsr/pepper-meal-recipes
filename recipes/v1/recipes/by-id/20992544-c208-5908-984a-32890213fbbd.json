  "id": "20992544-c208-5908-984a-32890213fbbd",
  "slug": "tea-biscuits",
  "name": "Tea Biscuits",
  "recipe_type": "appetizer",
  "brief_description": "These tea biscuits are tender, flaky, and ready in just 30 minutes for a light teatime or brunch treat, perfect served warm with butter and jam.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine flour, baking powder, and salt in a bowl. Cut shortening or cold butter in with 2 knives or a pastry blender until mixture resembles fine crumbs. Stir in milk with a fork to make a soft dough."
    },
    {
      "position": 3,
      "text": "Turn dough onto a lightly floured surface; knead 8 to 10 times until smooth. Roll out to 1/2-inch thickness. Cut into rounds with a floured biscuit cutter. Place on the baking sheet, brush top of biscuits with milk and allow to rest for a few minutes."
    },
    {
      "position": 4,
      "text": "Bake biscuits in the preheated oven until golden on top, 12 to 15 minutes. Serve warm."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9e056723-28a2-59a3-bf74-20512c33fed0",
  "slug": "pineapple-upside-down-monkey-bread",
  "name": "Pineapple Upside Down Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "Take your monkey bread to new heights through the introduction of pineapple to mock a pineapple upside down cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 12-cup tube pan(such as Bundt\u00ae)."
    },
    {
      "position": 2,
      "text": "Unroll and separate biscuits; cut each portion into four or six pieces, depending on your preference. Spray cut biscuits with cooking spray to coat."
    },
    {
      "position": 3,
      "text": "Pour white sugar into gallon-size resealable plastic bag; add biscuits to bag, seal bag, and shake to coat."
    },
    {
      "position": 4,
      "text": "Melt butter in a saucepan over low heat; stir brown sugar and vanilla into the melted butter to dissolve the sugar. Pour butter mixture into the prepared tube pan. Sprinkle chopped pineapple evenly around the pan atop the butter mixture; top with sugar-coated biscuit dough."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until golden brown, 40 to 50 minutes; let cook in pan for 5 to 10 minutes before inverting onto a serving platter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

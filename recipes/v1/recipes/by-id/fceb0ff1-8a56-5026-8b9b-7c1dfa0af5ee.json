  "id": "fceb0ff1-8a56-5026-8b9b-7c1dfa0af5ee",
  "slug": "asparagus-quiche",
  "name": "Asparagus Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This asparagus quiche is packed with fresh spring asparagus, crispy bacon, and Swiss cheese baked in a flaky pie crust for a delicious brunch dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place asparagus in a steamer over 1 inch of boiling water. Cover and cook until tender but still firm, 2 to 6 minutes. Drain and cool."
    },
    {
      "position": 3,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble and set aside."
    },
    {
      "position": 4,
      "text": "Brush pie shells with beaten egg white. Sprinkle crumbled bacon and steamed asparagus into pie shells; sprinkle Swiss cheese over bacon and asparagus."
    },
    {
      "position": 5,
      "text": "Beat eggs, half-and-half, nutmeg, salt, and pepper in a bowl until well combined. Pour egg mixture on top of cheese."
    },
    {
      "position": 6,
      "text": "Bake quiches in the preheated oven until filling is set, about 35 to 40 minutes. Let cool to room temperature before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

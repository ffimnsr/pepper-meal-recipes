  "slug": "popcorn-nachos",
  "name": "Popcorn Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Mexican-style spices and shredded Cheddar cheese are lively additions to plain popcorn.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, mix together butter, crushed red pepper, cumin and paprika."
    },
    {
      "position": 2,
      "text": "Place popcorn in a large bowl. Sprinkle with the butter mixture and Cheddar cheese. Toss until well mixed."
    }
  ],

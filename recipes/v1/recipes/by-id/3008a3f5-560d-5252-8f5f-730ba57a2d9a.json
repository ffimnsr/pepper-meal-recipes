  "id": "3008a3f5-560d-5252-8f5f-730ba57a2d9a",
  "slug": "easy-mochi",
  "name": "Easy Mochi",
  "recipe_type": "dessert",
  "brief_description": "Mochi are small Japanese cakes made with glutinous rice flour that have a soft, chewy outer layer and a deliciously sticky filling made of sweetened red bean paste.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Wrap red bean paste in aluminum foil and place in the freezer until solid, at least 1 hour."
    },
    {
      "position": 3,
      "text": "Mix glutinous rice flour and green tea powder thoroughly in a microwave-safe bowl."
    },
    {
      "position": 4,
      "text": "Stir in water, then sugar; mix until smooth."
    },
    {
      "position": 5,
      "text": "Cover the bowl with plastic wrap and microwave for 3 minutes 30 seconds."
    },
    {
      "position": 6,
      "text": "Meanwhile, remove red bean paste from the freezer and divide into 8 equal balls. Set aside."
    },
    {
      "position": 7,
      "text": "Remove rice flour mixture from the microwave. Stir and heat, covered, for another 15 to 30 seconds."
    },
    {
      "position": 8,
      "text": "Dust a work surface with cornstarch. Roll about 2 tablespoons of hot rice flour mixture into a ball. Flatten the ball and place one ball of frozen red bean paste in the center. Pinch and press the dough around the bean paste until completely covered."
    },
    {
      "position": 9,
      "text": "Sprinkle with additional cornstarch and place mochi, seam-side down, in a paper muffin liner to prevent sticking."
    },
    {
      "position": 10,
      "text": "Repeat Step 6 to make remaining mochi."
    },
    {
      "position": 11,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

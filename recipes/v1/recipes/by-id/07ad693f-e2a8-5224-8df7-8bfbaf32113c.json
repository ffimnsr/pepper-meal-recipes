  "id": "07ad693f-e2a8-5224-8df7-8bfbaf32113c",
  "slug": "mississippi-funeral-chicken-and-potato-casserole-recipe-12031976",
  "name": "Mississippi Funeral Chicken and Potato Casserole",
  "recipe_type": "main",
  "brief_description": "This Mississippi Funeral Chicken and Potato Casserole is warm comfort food at its best, with cheesy chicken and hash browns baked together until hot and bubbly. You\u2019ll love the crunchy, punchy topping of bacon, potato chips, cheese, and pepperoncini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a 13x9-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together soup, sour cream, mayonnaise, cream cheese, ranch mix, and cayenne pepper in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Stir in thawed hash browns, shredded chicken, 1 1/2 cups shredded Cheddar cheese, 1/2 cup pepperoncini peppers, and 1/4 cup chopped chives until fully combined. Transfer mixture to prepared baking dish and spread evenly. Cover with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until heated through, 35 to 40 minutes. Remove from the oven and remove foil."
    },
    {
      "position": 5,
      "text": "Stir together mozzarella cheese, potato chips, bacon, remaining 1/2 cup cheddar cheese, and remaining 1/4 cup pepperoncini peppers in a medium bowl. Spread evenly over the casserole."
    },
    {
      "position": 6,
      "text": "Continue baking, uncovered, until cheese is melted and topping is lightly browned, 15 to 20 minutes more. Let stand for 5 minutes before serving. Garnish with additional chives. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

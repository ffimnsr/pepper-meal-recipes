  "id": "bf43bdb2-746b-53b0-bf61-98efe23dab40",
  "slug": "homemade-tagalongs",
  "name": "Homemade Tagalongs",
  "recipe_type": "dessert",
  "brief_description": "Try these Copycat Girl Scout Tagalongs if you didn't score enough boxes at the last cookie sale.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter in a large bowl with an electric mixer at medium speed for 30 seconds. Add sugar and salt and beat until well combined. Beat in egg yolks and vanilla. Mix in flour until dough forms. Chill, covered, until dough is easy to handle, about 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "On a lightly floured surface, roll dough to 1/4-inch thickness. Cut dough with a 2-inch cookie cutter, rerolling scraps if needed. Arrange cutouts 2 inches apart on an ungreased cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until light brown, 7 to 8 minutes. Transfer to a wire rack to cool completely."
    },
    {
      "position": 5,
      "text": "In another bowl, stir together powdered sugar, peanut butter, and cream. Spread 2 teaspoons . onto each cookie, leaving centers slightly mounded. Arrange on wax paper."
    },
    {
      "position": 6,
      "text": "Meanwhile, arrange a wire rack over wax paper. Heat milk chocolate and candy coating in a small saucepan over low heat until melted. Spoon over cookies to cover, allowing excess to drip off. Let stand on prepared rack until set."
    }
  ],
  "servings": 46,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 30,

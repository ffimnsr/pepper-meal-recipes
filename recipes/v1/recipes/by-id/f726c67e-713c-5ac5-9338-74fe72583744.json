  "id": "f726c67e-713c-5ac5-9338-74fe72583744",
  "slug": "parmesan-cheese-crisps-recipe-7558651",
  "name": "Parmesan Cheese Crisps",
  "recipe_type": "salad",
  "brief_description": "Add these Parmesan cheese crisps to your charcuterie board, garnish a soup, or use in a salad instead of croutons.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or a silicone baking mat."
    },
    {
      "position": 2,
      "text": "Using a tablespoon, create 16 mounds of cheese, about 2 inches in diameter, spaced at least 1 inch apart, on the prepared baking sheet. Press down on the middle of each mound to make them evenly thick."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is completely melted and edges are browned, 4 to 6 minutes. Remove from the oven to cool for 15 minutes. Remove from baking sheet and store at room temperature in an air-tight container for up to 5 days."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

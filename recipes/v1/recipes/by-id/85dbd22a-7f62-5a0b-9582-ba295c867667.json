  "id": "85dbd22a-7f62-5a0b-9582-ba295c867667",
  "slug": "basic-california-roll",
  "name": "Basic California Roll",
  "recipe_type": "main",
  "brief_description": "This is a basic California roll recipe with crab, cucumber, avocado, nori, flying fish roe, sushi rice, and sesame seeds. This recipe makes four rolls.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Stir chopped crab sticks and mayonnaise together in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Slice ends off cucumber; cut into quarters lengthwise. Thinly slice each quarter lengthwise to make spears; set aside."
    },
    {
      "position": 3,
      "text": "Lay 1 sheet nori on bamboo sushi rolling mat. With wet fingers, firmly pat a thin, even layer of prepared rice over nori, leaving a 1/3-inch edge at the bottom. Sprinkle sesame seeds over rice; carefully flip over."
    },
    {
      "position": 4,
      "text": "Place 1 tablespoon crab mixture in a line about one-third from the top. Place 1 to 2 cucumber spears and 1 to 3 avocado slices."
    },
    {
      "position": 5,
      "text": "Roll nori sheet tightly into a cylinder around rice and filling, using the bamboo mat, starting at the top edge. Moisten uncovered edge with water; finish rolling once you reach the bottom. Repeat with the remaining nori, rice, sesame seeds, crab mixture, cucumber, and avocado."
    },
    {
      "position": 6,
      "text": "Slice each roll into 3/4-inch pieces. Garnish each piece with 1/8 teaspoon tobiko."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

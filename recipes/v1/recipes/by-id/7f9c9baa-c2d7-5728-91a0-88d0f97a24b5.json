  "id": "7f9c9baa-c2d7-5728-91a0-88d0f97a24b5",
  "slug": "classic-minestrone-soup",
  "name": "Classic Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "Follow this easy minestrone soup recipe for a hearty pot of soup with fresh vegetables, pasta, cannellini beans, and herbs in a savory tomato-based broth.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan over medium-high heat. Saut\u00e9 onion, carrot, celery, garlic, and rosemary until vegetables begin to soften, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in tomato sauce, beans, water, broth, zucchini, pasta, and pepper; bring to a simmer. Cook, uncovered and stirring occasionally, until pasta is tender, 10 minutes. Stir in parsley. Serve topped with Parmesan and additional parsley if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

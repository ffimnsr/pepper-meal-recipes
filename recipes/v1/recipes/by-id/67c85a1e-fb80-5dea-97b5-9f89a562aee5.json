  "id": "67c85a1e-fb80-5dea-97b5-9f89a562aee5",
  "slug": "game-day-bites",
  "name": "Game Day Bites",
  "recipe_type": "appetizer",
  "brief_description": "These game day bites are moist and cheesy miniature burgers. They will disappear quickly, so be prepared to make a second batch! Great for parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Thoroughly mix ground beef chuck, Cheddar cheese, mayonnaise, and dry onion soup mix in a medium bowl."
    },
    {
      "position": 3,
      "text": "Spread even amounts of ground beef onto the bottom half of each roll. Place top halves on, forming little sandwiches. Place on a baking sheet or baking pan. Cover the pan tightly with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until meat is cooked through, 30 to 35 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

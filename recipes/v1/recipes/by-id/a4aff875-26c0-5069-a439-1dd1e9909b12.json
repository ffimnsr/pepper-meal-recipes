  "id": "a4aff875-26c0-5069-a439-1dd1e9909b12",
  "slug": "chocolate-peanut-butter-protein-bars-recipe-8421618",
  "name": "Chocolate Peanut Butter Protein Bars",
  "recipe_type": "dessert",
  "brief_description": "Chocolate peanut butter protein bars are easy to make in a small batch, and absolutely delicious. Using a good protein powder is the key. If there is a downside, it might be how hard it will be to only eat one.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8 1/2x4 1/2-inch loaf pan with parchment paper, leaving overhang on all sides to make it easy to remove bars from the pan. Set aside."
    },
    {
      "position": 2,
      "text": "Place peanut butter, protein powder, maple syrup, vanilla and salt in a bowl and mix until well combined; press into the prepared pan. Set aside."
    },
    {
      "position": 3,
      "text": "Place chocolate chips and oil in a microwave safe bowl. Microwave for 30 seconds, stir. Repeat until chips are completely melted when stirred. Pour over bars, smooth chocolate. Refrigerate until set, about 30 minutes. Cut into 8 bars."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

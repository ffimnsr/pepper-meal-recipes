  "slug": "mini-pancake-parfait-recipe-7506803",
  "name": "Mini Pancake Parfait",
  "recipe_type": "dessert",
  "brief_description": "Teeny pancakes get the parfait treatment when they\u2019re layered with yogurt, mixed fruit, and pancakes\u2019 bestie: maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For each parfait, layer 1/3 cup vanilla yogurt, 1 tablespoon jam or fruit preserves, 3 mini pancakes, and 1/2 cup mixed berries in a wide-mouthed glass or jar. Repeat yogurt and berry layers. Add 2 additional pancakes and drizzle with maple syrup."
    }
  ],

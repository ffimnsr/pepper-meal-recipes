  "id": "43408590-78d7-5f4d-a768-465960fe555c",
  "slug": "apple-baked-beans",
  "name": "Apple Baked Beans",
  "recipe_type": "side",
  "brief_description": "Combine apples, crispy bacon, and raisins to canned pork and beans to bake a tasty new version of baked beans everyone will love!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir pork and beans, bacon, apples, barbeque sauce, brown sugar, and raisins together in a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 90 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,

  "id": "70cba4e0-9f92-5865-9800-c69f20f45177",
  "slug": "okinawan-style-pad-thai",
  "name": "Okinawan-Style Pad Thai",
  "recipe_type": "main",
  "brief_description": "This chicken Pad Thai dish of rice noodles and scrambled eggs adds sugar and unsalted peanuts for a Japanese twist on the popular Thai menu item.",
  "cuisine": "Asian Inspired Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together rice wine vinegar, 1/2 cup sugar, oyster sauce, and tamarind pulp in a saucepan over medium heat until sugar dissolves, about 5 minutes; remove from heat and set aside."
    },
    {
      "position": 2,
      "text": "Place rice noodles in a large bowl and pour enough cold water to cover noodles. Allow to soften, about 10 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Heat peanut oil in a wok or large skillet over medium heat. Cook and stir eggs and garlic in hot oil until eggs are softly cooked, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir chicken and noodles into eggs and cook until chicken is no longer pink in the center and juices run clear, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Pour rice wine vinegar sauce, 1 1/2 tablespoons sugar, and 1 1/2 teaspoons salt into the noodle mixture."
    },
    {
      "position": 6,
      "text": "Stir peanuts, ground radish, and chili powder into noodle mixture; cook until peanuts soften slightly, about 5 minutes. Add more sugar or chili powder if desired."
    },
    {
      "position": 7,
      "text": "Remove from heat and toss chives with noodle mixture. Top with bean sprouts and garnish with lime wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "salmon-cream-cheese-recipe-8764414",
  "name": "Salmon Cream Cheese",
  "recipe_type": "appetizer",
  "brief_description": "This salmon cream cheese is great spread on a bagel, or as a dip with crackers. It's tart and salty with lemon, fresh dill, and capers, and the whipped cream cheese makes it light enough to use as a dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese, lemon juice, salt, and pepper together in a bowl with an electric mixer until light and creamy."
    },
    {
      "position": 2,
      "text": "Stir dill and capers into whipped cream cheese and gently fold in salmon. Refrigerate until ready to use."
    }
  ],
  "servings": 6,

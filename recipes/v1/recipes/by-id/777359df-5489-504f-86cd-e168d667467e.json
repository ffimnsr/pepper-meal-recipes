  "slug": "garlic-parmesan-hummus-recipe-8646020",
  "name": "Garlic Parmesan Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This garlic hummus is made with a whole head of roasted garlic and Parmesan cheese for a richer flavor and extra creaminess. Great for garlic lovers!",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place garlic head on a piece of aluminum foil. Drizzle olive oil over garlic and season with salt and pepper. Wrap foil around garlic to fully enclose and place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until roasted and tender, about 40 minutes. Remove garlic from aluminum foil; set aside until cool enough to handle, about 10 to 20 minutes. Remove garlic cloves from the peels."
    },
    {
      "position": 4,
      "text": "Combine roasted garlic, chickpeas, tahini, Parmesan cheese, olive oil, lemon juice, 1/2 teaspoon black pepper, cumin, and salt in a food processor or blender until smooth."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9692bddf-50a2-5241-aa04-3ebe5391e14c",
  "slug": "mongolian-ground-beef-noodles-recipe-8763564",
  "name": "Mongolian Ground Beef Noodles",
  "recipe_type": "dessert",
  "brief_description": "These Mongolian ground beef noodles have all the flavors you love in Mongolian beef, but in a simplified, more affordable version. Fragrant with ginger and garlic, in a balanced savory-sweet-salty soy and hoisin sauce, this dish can be on the table in a smidge over half an hour.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes.. Drain and run under cold water to stop cooking. Set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, crumble ground beef in a large skillet over medium-high heat. Cook for 4 minutes. Add garlic and cook 1 minute more. Drain any excess grease."
    },
    {
      "position": 3,
      "text": "Return beef to skillet. Add ginger, brown sugar, soy sauce, hoisin, broth, vinegar, and pepper flakes."
    },
    {
      "position": 4,
      "text": "Add cornstarch and cold water to a small jar with a lid. Cover and shake until combined and mixture is a thick slurry. Pour over beef mixture."
    },
    {
      "position": 5,
      "text": "Cook over medium-high heat until thickened, about 3 minutes. Stir in reserved spaghetti and cook 2 minutes more. Turn heat off and let sit for 1 minute."
    },
    {
      "position": 6,
      "text": "Sprinkle each serving with green onion and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8a86cf56-6dce-5f24-97e1-801a9b27d01b",
  "slug": "teriyaki-flank-steak",
  "name": "Teriyaki Flank Steak",
  "recipe_type": "main",
  "brief_description": "Grilled flank steak in a simple teriyaki sauce is loaded with flavor after marinating overnight. No cooking until it hits the grill!",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large resealable plastic bag, mix the wine, soy sauce, olive oil, brown sugar, ginger, garlic, and pepper. Place steak in the bag, seal, and refrigerate 8 hours, or overnight."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat."
    },
    {
      "position": 3,
      "text": "Remove steaks from the bag, and discard marinade. Place steaks on the grill and cook 6 to 8 minutes per side, to your desired degree of doneness. The internal temperature should be at least 145 degrees F (63 degrees C) for rare. Allow the steaks to sit about 5 minutes before slicing against the grain, and serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

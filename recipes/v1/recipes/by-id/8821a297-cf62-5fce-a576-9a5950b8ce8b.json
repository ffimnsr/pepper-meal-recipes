{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8821a297-cf62-5fce-a576-9a5950b8ce8b",
  "slug": "blue-cheese-crusted-filet-mignon-with-port-wine-sauce",
  "name": "Blue Cheese Crusted Filet Mignon with Port Wine Sauce",
  "recipe_type": "main",
  "brief_description": "Worth the effort! Tender and flavorful, great for a dinner party. Make the sauce a day ahead to cut down on the prep time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add the onion, garlic and thyme. Cook, stirring constantly, until onion is tender. Stir in the beef broth, scraping any onion bits from the bottom of the pan, then stir in the port wine. Bring to a boil, and cook until the mixture has reduced to about 1/2 cup. Set aside. This may also be made ahead of time, and reheated."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Heat oil in a cast-iron or other oven-safe skillet over high heat. Sear steaks quickly on both sides until brown, then place the whole pan into the oven."
    },
    {
      "position": 3,
      "text": "Roast steaks in the oven for about 15 minutes for medium rare - with an internal temperature of 145 degrees F (63 degrees C). You may adjust this time to allow the steaks to finish just below your desired degree of doneness if medium is not what you prefer. Remove from the oven, and place on a baking sheet. Stir together the panko crumbs and blue cheese. Top each steak with a layer of this mixture."
    },
    {
      "position": 4,
      "text": "Preheat the oven's broiler. Place steaks under the preheated broiler until the cheese topping is browned and bubbly. 3 to 4 minutes. Remove from the oven, and let stand for at least 15 minutes before serving. Serve with warm port wine sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "22e9ccda-835b-5a17-8b3c-ea7caf5eead1",
  "slug": "romaine-salad-with-orange-and-olives",
  "name": "Romaine Salad with Orange and Olives",
  "recipe_type": "salad",
  "brief_description": "This citrus-flavored romaine salad features arugula, orange, and olives and is combined with a light olive oil-orange-juice dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together olive oil, orange juice and vinegar in a small bowl. Season with salt and pepper and set aside."
    },
    {
      "position": 2,
      "text": "Cut orange sections in half and add to a large bowl along with romaine lettuce, arugula, olives, and red onion. Toss until well combined."
    },
    {
      "position": 3,
      "text": "Drizzle half the dressing over the salad and toss to combine. Garnish with pine nuts. Serve the remaining dressing on the side to be used at the table."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

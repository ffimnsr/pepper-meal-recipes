  "id": "84f72d89-37cf-53ff-a872-72891694c698",
  "slug": "curried-quinoa",
  "name": "Curried Quinoa",
  "recipe_type": "side",
  "brief_description": "This quinoa's light curry flavor with a kick of heat makes it a delicious side dish. For a nutritious main dish, serve it over a bed of steamed greens.",
  "cuisine": "Indian American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add onion and garlic and cook, stirring until soft, about 2 minutes. Add quinoa and cook, adding more oil if the pan seems dry. Stir until quinoa is lightly toasted, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add broth to the pan and bring to a boil. Reduce heat. Add curry and chile powder. Cover and simmer until broth evaporates and quinoa is tender, about 25 minutes. Season to taste with salt and pepper."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

  "id": "b253754e-50ff-5fa2-aee8-ea313e841eb2",
  "slug": "coconut-macaroon-brownies",
  "name": "Coconut Macaroon Brownies",
  "recipe_type": "dessert",
  "brief_description": "These decadent brownies have a delicious layer of coconut sandwiched between two chocolate layers. They were requested at a political campaign, at a social party and at my fiftieth anniversary.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch baking pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and sugar. Beat in the eggs, one at a time, then stir in 1 1/2 teaspoons vanilla. Combine the flour, cream of tartar and cocoa; stir into the egg mixture until well blended. Fold in walnuts. Spread half of this mixture into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Make the middle layer. In a medium bowl, stir together the coconut, sweetened condensed milk and 1 tablespoon vanilla. Carefully layer this over the chocolate layer in the pan. Top with the remaining chocolate batter. Spread to cover evenly."
    },
    {
      "position": 4,
      "text": "Bake for 45 to 50 minutes in the preheated oven, until top is no longer shiny. Cool in the pan before cutting into bars."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

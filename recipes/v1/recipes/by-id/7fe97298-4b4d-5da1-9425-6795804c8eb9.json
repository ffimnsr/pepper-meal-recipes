  "slug": "make-ahead-greek-yogurt-parfait",
  "name": "Make-Ahead Greek Yogurt Parfait",
  "recipe_type": "dessert",
  "brief_description": "Quick, easy, sweet, and nutritious, these Greek yogurt parfaits feature frozen fruit and granola cereal for a high-protein, make-ahead breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine yogurt, sweetener, and vanilla extract in a large bowl. Stir well."
    },
    {
      "position": 2,
      "text": "Place 1 cup of frozen fruit in each of 8 plastic cups. Top each with 1/2 cup yogurt mixture. Store in the refrigerator until needed."
    },
    {
      "position": 3,
      "text": "Top each cup of fruit and yogurt with 1/4 cup granola before eating."
    }
  ],
  "servings": 8,

  "schema_version": 1,
  "id": "ddb454b1-aeed-54ee-83f9-eb60e62fed55",
  "slug": "no-knead-big-bubble-focaccia",
  "name": "No-Knead Focaccia",
  "recipe_type": null,
  "brief_description": "Chef John's no-knead focaccia has a soft texture with lots of big bubbles, a crispy exterior, and a delicious flavor thanks to a long fermentation.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir yeast into bread flour in a bowl. Add salt, followed by 4 teaspoons oil, and water. Stir with a spoon until a wet, sticky dough forms."
    },
    {
      "position": 3,
      "text": "Cover and let sit at room temperature for 12 to 14 hours."
    },
    {
      "position": 4,
      "text": "Uncover dough and transfer to an oiled work surface. Using oiled hands, press and push the dough into a rectangle, 16x12 inches in size."
    },
    {
      "position": 5,
      "text": "Fold dough into thirds horizontally; fold vertically into thirds. Transfer smooth side up into a generously oiled pan."
    },
    {
      "position": 6,
      "text": "Cover the pan with plastic wrap and let rest until almost doubled in size, for 1 hour."
    },
    {
      "position": 7,
      "text": "Using oiled hands, fold once more into thirds horizontally, then into thirds vertically to develop gluten structure."
    },
    {
      "position": 8,
      "text": "Flip dough, smooth side up, on the pan; cover with plastic wrap and let rest for 1 hour more."
    },
    {
      "position": 9,
      "text": "Unwrap and stretch and fold dough once more in each direction using oiled hands."
    },
    {
      "position": 10,
      "text": "Transfer, smooth-side up, into a generously oiled metal baking pan. Lightly drizzle with additional olive oil and stretch to fit the pan. Cover and let rest for 2 hours."
    },
    {
      "position": 11,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Unwrap and poke holes in the top of the dough using oiled fingers if desired for the traditional focaccia look. Scatter over rosemary and flaky sea salt."
    },
    {
      "position": 12,
      "text": "Bake in the center of the preheated oven until browned, about 30 minutes. Let cool in the pan for 10 minutes; transfer to a wire rack and let cool to room temperature, about 30 minutes."
    },
    {
      "position": 13,
      "text": "Slice and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,

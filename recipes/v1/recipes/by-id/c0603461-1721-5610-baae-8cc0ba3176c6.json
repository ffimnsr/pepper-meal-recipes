  "slug": "pumpkin-cream-cheese-spread-recipe-11829073",
  "name": "Pumpkin Cream Cheese Spread",
  "recipe_type": "appetizer",
  "brief_description": "This creamy, mild pumpkin cream cheese spread is light and fluffy, and so very easy to make. It\u2019s the perfect spread for toasted bagels, cinnamon raisin toast, graham crackers, or as a dip with apple wedges or ginger snaps, one of our favorites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add cream cheese to a bowl, and using an electric mixer, whip until smooth. Add pumpkin puree, brown sugar, honey, pumpkin pie spice, and vanilla, and beat until thoroughly combined and smooth."
    },
    {
      "position": 2,
      "text": "Transfer mixture to an airtight container, and store in the refrigerator. Sprinkle with some cinnamon when serving, if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

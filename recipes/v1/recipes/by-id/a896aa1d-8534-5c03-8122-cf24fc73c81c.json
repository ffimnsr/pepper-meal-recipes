  "id": "a896aa1d-8534-5c03-8122-cf24fc73c81c",
  "slug": "slow-cooker-ground-beef-barbecue",
  "name": "Slow Cooker Ground Beef Barbecue",
  "recipe_type": "main",
  "brief_description": "Serve this classic sloppy joe over hot dogs and piled onto hamburger buns. Everyone will love it, and you'll love that it cooks in the slow cooker while you do other things.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground beef in a large skillet over medium heat, and cook until brown, breaking up the meat as it cooks, about 15 minutes. Drain excess grease."
    },
    {
      "position": 2,
      "text": "Place the cooked meat, onion, garlic, celery, salt, black pepper, cider vinegar, mustard, brown sugar, and ketchup into a slow cooker, and stir to combine. Set the cooker on Low, and cook for 6 to 8 hours."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 375,

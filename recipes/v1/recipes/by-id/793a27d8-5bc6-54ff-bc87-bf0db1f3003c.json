  "id": "793a27d8-5bc6-54ff-bc87-bf0db1f3003c",
  "slug": "sous-vide-egg-bites",
  "name": "Sous Vide Egg Bites",
  "recipe_type": "breakfast",
  "brief_description": "These egg bites are similar to the famous coffee shop egg bites, but are customizable with your favorite ingredients and are double the size! A great snack or breakfast item.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water and place a sous vide immersion cooker into the water. Set temperature to 170 degrees F (77 degrees C) according to manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Combine eggs, cottage cheese, heavy cream, and salt in a blender; mix until thoroughly blended, 15 to 20 seconds."
    },
    {
      "position": 3,
      "text": "Spray mason jars with cooking spray. Divide egg mixture between each jar. Screw on the lids until just barely tightened. Do not over-tighten as the jars can burst in the hot water."
    },
    {
      "position": 4,
      "text": "Submerge mason jars into the water bath and set timer for 55 minutes. When timer is up, remove jars to a cooling rack. If serving immediately, run a knife along the outer edge and invert onto a plate; you can also eat directly from the jar. Let any remaining jars cool, then refrigerate for up to 1 week."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

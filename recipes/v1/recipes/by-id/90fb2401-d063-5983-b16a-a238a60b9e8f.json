  "id": "90fb2401-d063-5983-b16a-a238a60b9e8f",
  "slug": "cheesy-chorizo-frittata",
  "name": "Cheesy Chorizo Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Crumbled chorizo sausage, spinach, cherry tomatoes, and cheese add heat, flavor, and color to this delicious frittata.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Cook chorizo in a large oven-proof skillet on medium-high heat until done, frequently stirring. Remove chorizo from the skillet, reserving drippings in the skillet. Set chorizo aside. Add spinach to the skillet; cook 2 minutes or just until wilted, frequently stirring. Stir in tomatoes, onions, and cooked chorizo. Remove from heat."
    },
    {
      "position": 2,
      "text": "Whisk eggs and milk in a medium bowl until blended; stir in 1 cup of cheese. Add to ingredients in skillet; stir just until blended. Top with remaining cheese."
    },
    {
      "position": 3,
      "text": "Bake 25 minutes or until knife inserted in center comes out clean."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "47e5c83f-16dc-5841-8c33-d73fea0a70a4",
  "slug": "air-fryer-crispy-pickle-chips-with-creole-dipping-sauce-recipe-7509784",
  "name": "Air Fryer Crispy Pickle Chips with Creole Dipping Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Crispy pickle chips easily cooked in the air fryer. Serve with homemade Creole dipping sauce for a tasty snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat air fryer to 350 degrees F (175 degrees C). Lightly coat air fryer basket with cooking spray."
    },
    {
      "position": 2,
      "text": "Put flour in a shallow dish. In a second shallow dish, lightly beat eggs. In a third shallow dish, add panko. Pat pickle chips very dry. Coat pickles in flour, shaking off excess. Dip in eggs, allowing excess to drip off. Toss in panko, lightly pressing to adhere. Arrange pickles in the air fryer basket in an even layer (do not overcrowd), working in batches if needed."
    },
    {
      "position": 3,
      "text": "Cook until pickle chips are golden brown, about 6 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, stir together mayonnaise, Creole mustard, lemon juice, and smoked paprika in a small bowl. Serve dipping sauce with pickles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 15,

  "id": "fcf5cf58-e637-504f-8a93-c6735c3f6fd9",
  "slug": "slow-cooker-chicken-apple-butter-meatballs-recipe-8715002",
  "name": "Slow Cooker Chicken Apple Butter Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "This fall-inspired, slow-cooker recipe combines tender chicken meatballs with a rich, spiced apple butter sauce. With only 20 minutes of prep, this is the perfect cozy recipe to prepare for a fall dinner party or family night in. Here's how to make Slow Cooker Chicken Apple Butter Meatballs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Peel apple; discard peels. Grate apple on the largest holes of a box grater to yield 2/3 cup. Place grated apple in a large bowl."
    },
    {
      "position": 3,
      "text": "Add chicken, panko, egg, salt, thyme, poultry seasoning, and black pepper to bowl with grated apples. Mix until just combined. Shape into 18 balls (about 2 tablespoons each)."
    },
    {
      "position": 4,
      "text": "Stir together apple butter, chicken stock, Worcestershire, and chicken bouillon in a 6-quart slow cooker bowl. Place meatballs in sauce mixture."
    },
    {
      "position": 5,
      "text": "Cover and cook until meatballs are cooked through and sauce thickens enough to coat the meatballs, about 2 hours on HIGH or 4 hours on LOW, stirring halfway through. Stir in butter until melted and season with additional salt to taste."
    },
    {
      "position": 6,
      "text": "Transfer meatballs and sauce to a platter; insert each meatball with a toothpick and garnish with chopped thyme. Recipe developed by Jasmine Smith"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

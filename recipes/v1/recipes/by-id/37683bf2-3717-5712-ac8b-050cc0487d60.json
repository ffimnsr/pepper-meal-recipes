  "id": "37683bf2-3717-5712-ac8b-050cc0487d60",
  "slug": "banana-bread-monkey-bread-recipe-11805820",
  "name": "Banana Bread Monkey Bread",
  "recipe_type": "breakfast",
  "brief_description": "For this banana bread monkey bread, each tiny biscuit has a banana slice wrapped inside. Rolled in cinnamon sugar, layered with walnuts, and baked with a brown sugar syrup, the individual nuggets easily pull apart.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a tube cake pan very well with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Separate each biscuit into 3 pieces by gently pulling the layers apart. Wrap a slice of banana in each piece of dough. Press to seal and lightly roll each piece into a ball shape."
    },
    {
      "position": 3,
      "text": "Combine sugar, 1/4 cup brown sugar, and cinnamon in a large bowl and mix well. Toss half of dough pieces in cinnamon sugar mixture until very well coated. Place coated pieces in the prepared pan and sprinkle with 1/2 cup chopped walnuts. Repeat with remaining dough pieces and remaining nuts. Sprinkle with up to 2 tablespoons of any leftover cinnamon sugar and discard the rest."
    },
    {
      "position": 4,
      "text": "Set a small saucepan over medium heat; add butter, remaining 3/4 cup brown sugar, and vanilla. Whisk constantly until sugar dissolves and mixture is well combined and slightly thickened; pour syrup evenly over biscuits in the tube pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until browned and lightly toasted, 38 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let stand about 3 minutes, then run a small knife or spatula around the sides of the pan to release any stuck sugar mixture from the edges of the pan. Let stand for 3 to 5 more minutes, then invert monkey bread onto a serving plate."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

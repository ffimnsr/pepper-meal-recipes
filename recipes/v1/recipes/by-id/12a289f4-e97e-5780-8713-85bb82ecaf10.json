  "id": "12a289f4-e97e-5780-8713-85bb82ecaf10",
  "slug": "spicy-baked-beans",
  "name": "Spicy Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "This recipe for tangy and sweet old-fashioned baked beans with a little jalapeno is easy to make and perfect for a barbeque.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir bacon in a large skillet over medium-high heat until some fat rendered, 2 to 3 minutes. Stir in onion; cook until bacon crisp and onion tender, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Combine baked beans, ketchup, brown sugar, Worcestershire sauce, prepared mustard, jalape\u00f1o, chili powder, and mustard powder in a large bowl; stir in bacon mixture. Pour into a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until liquid thickened, 45 to 55 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

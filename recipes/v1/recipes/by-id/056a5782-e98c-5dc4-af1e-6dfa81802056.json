  "slug": "baked-skillet-pancake-recipe-8379567",
  "name": "Baked Skillet Pancake",
  "recipe_type": "dessert",
  "brief_description": "This baked skillet pancake is an old family recipe, and it is not your ordinary pancake. It tastes almost like the elephant ears you get at the fair. So good!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place a large cast iron skillet in the oven while preheating."
    },
    {
      "position": 2,
      "text": "Add butter to skillet to melt a few minutes before preheating is complete."
    },
    {
      "position": 3,
      "text": "Whisk flour and milk together in a bowl. Whisk in eggs. Batter will be slightly lumpy."
    },
    {
      "position": 4,
      "text": "Carefully remove skillet from oven; pour batter into the hot skillet over melted butter."
    },
    {
      "position": 5,
      "text": "Return to the oven and bake until lightly golden and crispy around edges, 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Dust with confectioner\u2019s sugar and cinnamon, as desired, while still warm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

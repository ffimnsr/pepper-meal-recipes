  "id": "81cc6b04-24b1-5508-94e9-5e2d08dc6a4b",
  "slug": "maple-syrup-glazed-bacon-breakfast-carbonara",
  "name": "Maple Syrup-Glazed Bacon Breakfast Carbonara",
  "recipe_type": "breakfast",
  "brief_description": "Mapled bacon makes for a unique but easy spaghetti carbonara that kids will love for breakfast or brunch!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, high-sided skillet over medium heat. Add bacon and cook, stirring occasionally and sprinkling with garlic powder, until browned and crispy, 7 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, beat eggs in a separate bowl. Mix in Parmigiano-Reggiano cheese and black pepper."
    },
    {
      "position": 3,
      "text": "Remove bacon onto paper towels to drain, reserving 3 tablespoons of the oil and bacon grease in the pan. Return bacon to the pan, stir in maple syrup, and bring to a simmer. Quickly turn heat down to low and let simmer for 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain pasta in a strainer set over large glass bowl. Pour 1/4 cup of the pasta water into the skillet with the bacon; stir. Add pasta and toss until coated."
    },
    {
      "position": 5,
      "text": "Pour remaining pasta water out of the large bowl. Drop the coated noodles into the bowl. Pour in the egg mixture and quickly toss with the pasta until cheese has melted and sauce is creamy and smooth, 1 to 2 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

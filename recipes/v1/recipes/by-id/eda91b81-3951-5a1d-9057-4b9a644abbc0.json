  "id": "eda91b81-3951-5a1d-9057-4b9a644abbc0",
  "slug": "peanut-butter-french-toast",
  "name": "Peanut Butter French Toast",
  "recipe_type": "breakfast",
  "brief_description": "If you love French toast and you love peanut butter, why not combine them into one easy, delish recipe? Top with sliced strawberries or bananas.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk milk, eggs, peanut butter, sugar, vanilla extract, and cinnamon together in a large bowl."
    },
    {
      "position": 2,
      "text": "Heat oil in a griddle or frying pan over medium heat."
    },
    {
      "position": 3,
      "text": "Dip bread slices in egg mixture, soaking both sides; add to griddle. Cook until golden, about 3 to 4 minutes per side. Serve hot."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,

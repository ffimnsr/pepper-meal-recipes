  "id": "83b42803-437d-56c7-beb2-f062d91e7694",
  "slug": "apple-cider-pork-tenderloin-with-sweet-potatoes-recipe-8774666",
  "name": "Apple Cider Pork Tenderloin With Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "This apple cider pork tenderloin with sweet potatoes roasts nestled in a bed of apples, onions, and white sweet potatoes while a delicious pan reduction of apple cider, vinegar, and mustard is prepared to glaze the entire dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) and line a sheet pan with parchment. Combine garlic, salt, pepper, thyme and smoked paprika in a small bowl."
    },
    {
      "position": 2,
      "text": "Pat tenderloin dry with paper towels. Coat all sides with half of seasoning mixture, using fingertips to rub into the meat. Let seasoned tenderloin stand at room temperature while other ingredients are being prepped."
    },
    {
      "position": 3,
      "text": "Combine apples, red onion, and sweet potato in a bowl. Sprinkle with remaining seasoning mixture and stir to combine. Melt 2 tablespoons butter, pour over seasoned mixture, and stir to coat. Spread in a single layer on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Roast in the center of the preheated oven, uncovered, for about 10 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, melt remaining butter in a large skillet over medium-high heat. When butter stops sizzling, add tenderloin to the skillet and brown on all sides, 2 to 3 minutes per side. Nestle tenderloin into the middle of the sheet pan with apple mixture."
    },
    {
      "position": 6,
      "text": "Return pan to the oven and roast while glaze is prepared, 10 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, for glaze, to the same skillet add apple cider, red wine vinegar, and Dijon mustard. Increase heat to medium-high and bring to a full rolling boil. Allow liquid to reduce to about 1 cup, and spoon generously over tenderloin and apple mixture."
    },
    {
      "position": 8,
      "text": "Continue roasting until the internal temperature of the thickest part of pork reaches 140 degrees F (60 degrees C), 5 to 10 minutes more."
    },
    {
      "position": 9,
      "text": "Remove from the oven and tent with foil. Allow to rest about 5 minutes. Residual cooking should bring pork up to 145 degrees F (63 degrees C), when tested with an instant read thermometer."
    },
    {
      "position": 10,
      "text": "To serve, slice pork into 1/2-inch slices, garnish with fresh thyme, and serve with roasted vegetables and apples."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "c38bdefd-0df2-5a09-a1a1-cd620b8abf96",
  "slug": "honey-garlic-ribs",
  "name": "Honey Garlic Ribs",
  "recipe_type": "dessert",
  "brief_description": "Honey-glazed ribs with an easy-to-prep sauce that's a sweet and savory combination of honey, brown sugar, soy sauce, vinegar, and garlic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice ribs into individual pieces. Combine honey, soy sauce, vinegar, brown sugar, and garlic in a large bowl; stir until honey and sugar are completely dissolved, then stir in baking soda. The mixture will begin to foam. Transfer ribs to the bowl and turn to coat."
    },
    {
      "position": 3,
      "text": "Cover a cookie sheet with foil; arrange ribs meat-side up on the prepared sheet. Pour excess sauce over ribs and sprinkle with garlic salt."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 1 hour, turning every 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

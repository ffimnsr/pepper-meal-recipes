  "id": "b43234e0-2f56-51ed-a74c-cd8de294582b",
  "slug": "buttered-noodles",
  "name": "Buttered Noodles",
  "recipe_type": "side",
  "brief_description": "These saucy buttered noodles with Parmesan cheese are simple to make and perfect to serve as-is for a main dish or as a delicious side for meatballs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water; bring to a rolling boil."
    },
    {
      "position": 3,
      "text": "Stir in fettuccine, bring back to a boil, and cook pasta over medium heat until tender yet firm to the bite, 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Drain; return pasta to the pot. Stir in butter, Parmesan cheese, salt, and black pepper until evenly combined."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "schema_version": 1,
  "id": "7fb21728-1500-5fc4-b4c2-92838eca930d",
  "slug": "nicoles-best-baked-ziti",
  "name": "Nicole's Best Baked Ziti",
  "recipe_type": "main",
  "brief_description": "This budget-friendly baked ziti recipe with Italian sausage is a hearty and flavorful meal that's sure to be a crowd pleaser.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add 1 tablespoon kosher salt to the boiling water and stir in pasta. Cook until just about tender to the bite, about 8 minutes (or 1 to 2 minutes less than package instructions)."
    },
    {
      "position": 3,
      "text": "At the same time, heat a large, deep skillet or saucepan over medium-high heat. Add sausage and beef and cook, crumbling with the back of a spoon, until browned, about 5 minutes. Add onion, garlic, 3/4 teaspoon salt, 1/2 teaspoon pepper, and pepper flakes; cook until onion is translucent and softened, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Drain pasta and return to the pot. Add about 1/2 cup marinara; toss to coat and let sit until needed."
    },
    {
      "position": 5,
      "text": "Add remaining marinara sauce to the browned meat mixture. Pour 1/4 cup water into each jar, shake to release any leftover sauce in the jar, and pour into the skillet. Stir and bring to a simmer. Reduce heat to medium-low and cook, stirring occasionally, for 10 minutes."
    },
    {
      "position": 6,
      "text": "Stir ricotta cheese, 1/2 cup Parmesan cheese, egg, parsley, basil, and remaining 1/4 teaspoon each salt and pepper together in a bowl."
    },
    {
      "position": 7,
      "text": "Add 2 cups meat sauce to the pasta; toss to coat."
    },
    {
      "position": 8,
      "text": "Spread 1/2 cup meat sauce into the bottom of the prepared baking dish. Add ½ of the pasta mixture and top with 2 cups meat sauce. Lightly dollop and spread ricotta mixture over the top and sprinkle evenly with 1 1/2 cups mozzarella cheese. Add remaining pasta mixture, remaining meat sauce, and remaining mozzarella on top. Sprinkle evenly with remaining 1/4 cup Parmesan."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until golden and bubbly, 25 to 30 minutes. Let stand 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

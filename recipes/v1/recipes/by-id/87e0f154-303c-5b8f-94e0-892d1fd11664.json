  "id": "87e0f154-303c-5b8f-94e0-892d1fd11664",
  "slug": "authentic-huevos-rancheros",
  "name": "Easy Huevos Rancheros",
  "recipe_type": "breakfast",
  "brief_description": "This huevos rancheros recipe is easy to make with refried beans, cheese, bacon, and a fried egg on a crispy tortilla to keep you going all morning long!",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Fry two tortillas at a time in the hot skillet until firm, but not crisp, about 30 seconds per side. Drain on paper towels."
    },
    {
      "position": 3,
      "text": "Reduce the heat to medium, and add more oil to the skillet if dry. Crack in eggs and cook until the outer edges become opaque, about 1 minute. Cover, reduce the heat to low, and cook until the whites are completely set, about 4 minutes."
    },
    {
      "position": 4,
      "text": "While the eggs are cooking, combine refried beans and butter in a microwave-safe dish. Cover and microwave on high in 1-minute intervals until hot."
    },
    {
      "position": 5,
      "text": "Place tortillas onto plates and spread with a layer of hot refried beans."
    },
    {
      "position": 6,
      "text": "Top with Cheddar, a fried egg, crumbled bacon, and salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3cf36bfa-c69e-59cd-8cf9-e45404170604",
  "slug": "apple-matzo-kugel",
  "name": "Apple Matzo Kugel",
  "recipe_type": "dessert",
  "brief_description": "This sweet matzo kugel with apple and raisins is great for Passover. Friends and family will love this Jewish dish as a side, breakfast, or dessert!",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish. Break matzo sheets into pieces, and soak in a bowl of water until soft. Drain in a colander, mashing to squeeze the water out."
    },
    {
      "position": 2,
      "text": "Mix eggs, salt, sugar, oil, and cinnamon together in a separate bowl. Add soaked matzo and mix well. Fold in apples and raisins; spoon into the prepared baking dish and spread evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until nicely browned and apples are tender, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

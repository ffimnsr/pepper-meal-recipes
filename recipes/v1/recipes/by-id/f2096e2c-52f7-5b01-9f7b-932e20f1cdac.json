  "id": "f2096e2c-52f7-5b01-9f7b-932e20f1cdac",
  "slug": "matzah",
  "name": "Matzah",
  "recipe_type": null,
  "brief_description": "Matzah is thin, crisp, unleavened bread made with just flour and water. It's easy to make from scratch and a beautiful way to prepare for Passover.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Move an oven rack to the top position. Preheat a heavy baking sheet in the oven."
    },
    {
      "position": 2,
      "text": "Dust a clean work surface and a rolling pin with 1 teaspoon flour, or as needed."
    },
    {
      "position": 3,
      "text": "Place 1 cup flour into a mixing bowl; set a timer for 16 minutes (18 minutes maximum). Start the timer; pour water, 1 tablespoon at a time, into flour. Stir with a fork until dough forms a rough ball."
    },
    {
      "position": 4,
      "text": "Transfer dough to the prepared work surface; knead rapidly and firmly until smooth, 30 seconds to 1 minute."
    },
    {
      "position": 5,
      "text": "Divide dough into 4 equal-sized pieces; cut each piece in half to get 8 pieces. Swiftly roll each piece into a ball. Working from the center, roll out each dough piece into a 5-inch-diameter round, dusting with flour as needed. Continue to gradually roll dough out to a diameter of about 8 inches, increasing each size by about 1 inch, then letting dough rest for a few seconds before rolling again to the finished size. The dough rounds will be very thin."
    },
    {
      "position": 6,
      "text": "Use a fork to quickly pierce through each dough round about 25 times, all over, to prevent rising. Flip dough over and pierce each piece again 25 times."
    },
    {
      "position": 7,
      "text": "With at least 5 minutes left on the timer, remove the hot baking sheet from the preheated oven and place dough rounds onto the baking sheet."
    },
    {
      "position": 8,
      "text": "Bake on the top rack in the preheated oven for 2 minutes; flip matzah over and bake until lightly browned and crisp, about 2 more minutes."
    },
    {
      "position": 9,
      "text": "Transfer to a wire rack to cool. Use a brush to lightly anoint each matzah with olive oil. Season generously with salt."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

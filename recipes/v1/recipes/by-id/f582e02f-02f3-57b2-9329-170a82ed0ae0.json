  "slug": "dill-pickle-deviled-eggs-recipe-11852230",
  "name": "Dill Pickle Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These dill pickle deviled eggs will surprise your taste buds with the salty, briny tang from dill pickle juice and a little crunch from the pickles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice eggs in half lengthwise, remove yolks, and set egg whites aside."
    },
    {
      "position": 2,
      "text": "Add crumbled yolks, mayonnaise, pickle juice, mustard, salt, and pepper to a small bowl, and mash with a fork until smooth; stir in pickles."
    },
    {
      "position": 3,
      "text": "Place egg whites cut side up on a serving platter. Evenly spoon or pipe mixture into each egg white, and garnish with fresh dill. Cover, and refriegerate until ready to serve, at least 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

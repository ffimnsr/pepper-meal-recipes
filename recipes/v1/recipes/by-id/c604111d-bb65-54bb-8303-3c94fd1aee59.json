  "id": "c604111d-bb65-54bb-8303-3c94fd1aee59",
  "slug": "easy-slow-cooker-stroganoff",
  "name": "Easy Slow Cooker Stroganoff",
  "recipe_type": "soup",
  "brief_description": "In this easy slow cooker stroganoff recipe, beef tips, mushroom soup, and fresh mushrooms simmer together for hours until tender for a hot, rich meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream of mushroom soup, mushrooms, butter, and onion in a slow cooker; add beef."
    },
    {
      "position": 2,
      "text": "Cook for 8 hours on Low."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook noodles according to package directions until mostly tender, about 5 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Serve beef tips and sauce over noodles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,

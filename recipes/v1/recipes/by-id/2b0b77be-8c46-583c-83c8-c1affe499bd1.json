  "id": "2b0b77be-8c46-583c-83c8-c1affe499bd1",
  "slug": "strawberry-blintzes",
  "name": "Strawberry Blintzes",
  "recipe_type": "dessert",
  "brief_description": "Strawberry blintzes feature sweet cottage and cream cheese rolled up in homemade blintzes and topped with strawberries in this tasty breakfast recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat flour, eggs, and salt together in a large bowl until smooth. Gradually stir in milk and 1 \u00bd tablespoons melted butter. Cover batter with plastic wrap; rest in the refrigerator at least 2 hours."
    },
    {
      "position": 2,
      "text": "Combine cottage cheese, cream cheese, sugar, and vanilla extract in a blender; blend until filling is smooth."
    },
    {
      "position": 3,
      "text": "Melt a bit of butter in a large skillet or cr\u00eape pan over medium heat. Spoon a small amount of batter into the skillet; immediately swirl the skillet to spread batter in a thin layer. Cook until set, about 30 seconds. Flip; cook until second side is cooked, about 10 seconds more. Transfer to a plate; cool. Repeat with remaining butter and batter."
    },
    {
      "position": 4,
      "text": "Spoon filling onto blintzes; fold. Top with strawberries."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

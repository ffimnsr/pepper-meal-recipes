{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f81db0b4-46d2-5ed1-be92-aa480bca7894",
  "slug": "chef-johns-smothered-pork-chops",
  "name": "Chef John's Smothered Pork Chops",
  "recipe_type": "main",
  "brief_description": "Smothered pork chops are a delicious combo of tender pan-fried pork chops covered in a rich onion gravy; serve with mash for a satisfying Southern-style meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sprinkle both sides pork chops with poultry seasoning, salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large skillet over medium-high heat; add pork chops and brown well on both sides, about 5 minutes per side. Transfer to a plate. Discard excess grease from the skillet."
    },
    {
      "position": 4,
      "text": "Melt butter in the same skillet; reduce heat to medium. Add onion and pinch of salt; cook until onion is very browned and caramelized, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Stir in garlic; cook for 1 minute. Stir in flour; cook for 2 minutes."
    },
    {
      "position": 6,
      "text": "Add chicken broth to the skillet; stir, scraping the browned bits of food off the bottom of the skillet with a wooden spoon."
    },
    {
      "position": 7,
      "text": "Pour any accumulated juices from the plate with pork chops into the sauce."
    },
    {
      "position": 8,
      "text": "Stir in buttermilk until smooth."
    },
    {
      "position": 9,
      "text": "Add water. Bring sauce to a simmer, reduce heat to low, and cook until onions begin to break down and sauce is thickened, 15 to 20 minutes."
    },
    {
      "position": 10,
      "text": "Place pork chops in sauce; spoon sauce over top to coat."
    },
    {
      "position": 11,
      "text": "Reduce heat to low; simmer until chops are tender and cooked through, about 10 minutes. Taste; adjust seasoning. Serve chops with gravy on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

  "id": "16d91e55-5925-5de1-a6ac-052577751052",
  "slug": "sausage-egg-and-cheese-biscuit-casserole-recipe-11695493",
  "name": "Sausage, Egg, and Cheese Biscuit Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This sausage, egg, and cheese biscuit casserole is a quick and easy breakfast for the whole family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Line prepared baking dish with the biscuits, pressing to form an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until puffed and lightly browned, about 8 minutes. Reduce oven temperature to 375 degrees F (190 degrees C). (Leave the oven door open for a bit to let the oven cool down.)"
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add sausage to skillet; cook and stir until fully cooked and browned, about 10 minutes; drain fat."
    },
    {
      "position": 5,
      "text": "Sprinkle cooked sausage and cheese evenly over baked biscuits."
    },
    {
      "position": 6,
      "text": "Whisk together eggs, milk, salt, and pepper in a large bowl. Pour egg mixture over sausage and cheese. (The egg mixture won\u2019t cover the cheese and sausage at this point, but will expand as it bakes.)"
    },
    {
      "position": 7,
      "text": "Bake until casserole is set and internal temperature registers 165 degrees F (74 degrees C), about 25 minutes."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

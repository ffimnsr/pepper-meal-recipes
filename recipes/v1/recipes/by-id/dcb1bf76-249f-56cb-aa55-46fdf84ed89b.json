  "id": "dcb1bf76-249f-56cb-aa55-46fdf84ed89b",
  "slug": "garlic-naan",
  "name": "Garlic Naan",
  "recipe_type": null,
  "brief_description": "Try Chef John's garlic naan recipe for garlicky bread made with yogurt-enriched dough that's cooked in a hot cast iron skillet until nicely charred.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, sugar, and yeast in a bowl. Let stand until yeast softens and forms a creamy foam, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Heat butter in a pan over medium heat until melted and sizzling. Quickly mix in garlic and remove from the heat."
    },
    {
      "position": 3,
      "text": "Add bread flour, yogurt, salt, and 1 tablespoon garlic butter to yeast mixture; stir with a wooden spoon until a shaggy dough forms. Knead by hand until dough pulls away from the sides of the bowl, adding more water or flour as needed. Turn dough out onto the counter and continue kneading until it forms a smooth ball, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Place dough into a large bowl and drizzle a few spoons garlic butter over top. Cover and let rise until doubled in volume, about 2 hours."
    },
    {
      "position": 5,
      "text": "Punch dough down and turn out onto the counter. Shape into a rough rectangle and cut into 6 pieces. Roll each piece into a ball and lightly dust with flour. Cover with plastic wrap and proof until slightly puffy, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Preheat a cast iron skillet over medium heat until very hot, 5 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, roll each piece proofed dough into a 1/8-inch-thick oval. Sprinkle some cilantro on top and press lightly to adhere."
    },
    {
      "position": 8,
      "text": "Working in batches, cook naan in the hot skillet until large bubbles form, 1 to 2 minutes. Flip, press gently, and continue to cook until bubbles on the bottom are charred, 2 to 3 minutes more."
    },
    {
      "position": 9,
      "text": "Brush naan with more garlic butter before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

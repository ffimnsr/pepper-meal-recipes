  "slug": "everything-bagel-popcorn-recipe-11907776",
  "name": "Everything Bagel Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "This everything bagel popcorn really elevates your popcorn game. Use hot-air-popped popcorn, butter, and everything bagel seasoning. It\u2019s easy, quick, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place popped popcorn in a large bowl."
    },
    {
      "position": 2,
      "text": "Melt butter in a small saucepan over low heat."
    },
    {
      "position": 3,
      "text": "Once butter has melted, drizzle half over the bowl of popped popcorn. Sprinkle half the everything seasoning over buttered popcorn. Toss."
    },
    {
      "position": 4,
      "text": "Drizzle remaining butter over the top. Sprinkle remaining everything seasoning over the top. Toss one last time and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "6a8c2824-2498-5996-b890-05f6c402a6cb",
  "slug": "key-lime-pie-sandwich-cookies",
  "name": "Key Lime Pie Sandwich Cookies",
  "recipe_type": "dessert",
  "brief_description": "Key lime pie in cookie form! These graham cracker sandwich cookies filled with a tart cream cheese filling are pure Key lime deliciousness!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, graham cracker crumbs, baking soda, baking powder, and cinnamon in a bowl."
    },
    {
      "position": 3,
      "text": "Cream butter and 1/2 cup sugar together in a bowl with an electric mixer. Add egg yolk and vanilla; blend until combined. Mix in dry ingredients and continue to blend until dough sticks together, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Roll dough into 1-inch balls and roll in remaining sugar to coat. Place on the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bottoms are lightly browned, 6 to 7 minutes. Cool on the baking sheets for 5 minutes before removing to a wire rack to cool, 8 to 10 minutes more."
    },
    {
      "position": 6,
      "text": "Zest all 3 limes; set zest aside. Juice 2 of the limes."
    },
    {
      "position": 7,
      "text": "Beat cream cheese in a bowl with an electric mixer until smooth. Mix in confectioners' sugar. Add lime juice and zest; mix to combine."
    },
    {
      "position": 8,
      "text": "Spread filling on the flat sides of 1/2 of the cookies, then top with remaining cookies to form sandwich cookies."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 35,

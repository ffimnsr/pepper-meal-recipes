  "slug": "4-ingredient-furikake-salmon-recipe-11797367",
  "name": "4-Ingredient Furikake Salmon",
  "recipe_type": "salad",
  "brief_description": "In this 4-ingredient furikake salmon, silky kewpie mayonnaise, spicy sriracha, and crunchy furikake seasoning complement rich salmon. Serve this alongside a macaroni salad or jasmine rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Pat salmon filets dry; sprinkle with salt and pepper. Stir kewpie mayonnaise and sriracha together in a small bowl; brush liberally over salmon. Sprinkle furikake over the salmon."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

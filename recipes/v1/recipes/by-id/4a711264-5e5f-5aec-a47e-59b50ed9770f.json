  "id": "4a711264-5e5f-5aec-a47e-59b50ed9770f",
  "slug": "caramel-chocolate-corn",
  "name": "Caramel Chocolate Corn",
  "recipe_type": "dessert",
  "brief_description": "Popcorn, roasted peanuts, and milk chocolate: perfect for your salty-sweet snack fix!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Place popcorn and peanuts in a paper bag. Set aside."
    },
    {
      "position": 3,
      "text": "In a microwave safe bowl, combine sugar, butter, corn syrup, vanilla and salt. Microwave 4 minutes, until bubbly. Stir in baking soda. Pour over popcorn mixture and shake bag to coat."
    },
    {
      "position": 4,
      "text": "Roll down edges of bag and place bag in microwave. Heat for 2 minutes, shaking three times to mix. Spread mixture onto prepared sheets to cool."
    },
    {
      "position": 5,
      "text": "In a microwave safe bowl, combine chocolate and shortening. Microwave 90 seconds, stirring once, until melted. Drizzle over popcorn mixture. Let cool before serving."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 7,

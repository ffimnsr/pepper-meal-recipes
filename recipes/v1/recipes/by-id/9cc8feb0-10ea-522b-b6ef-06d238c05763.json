  "id": "9cc8feb0-10ea-522b-b6ef-06d238c05763",
  "slug": "gigantes-greek-lima-beans",
  "name": "Gigantes (Greek Lima Beans)",
  "recipe_type": "side",
  "brief_description": "This Greek gigantes recipe uses dried lima beans, canned chopped tomatoes, fresh garlic, and fresh dill to make a tasty side dish.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place lima beans into a large saucepan and add enough water to cover by 2 inches. Soak for 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "When ready to cook, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Place the saucepan with beans and water over medium heat and bring to a boil. Reduce the heat to medium-low and simmer for 20 minutes."
    },
    {
      "position": 4,
      "text": "Drain beans; pour into a 9x13-inch baking dish. Add tomatoes, olive oil, garlic, dill, and salt; stir to combine."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, stirring occasionally and adding water if the mixture appears dry, until beans are tender, 1 1/2 to 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 10,

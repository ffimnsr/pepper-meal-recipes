  "slug": "fireball-root-beer-float-recipe-11873229",
  "name": "Fireball Root Beer Float",
  "recipe_type": "appetizer",
  "brief_description": "This fireball root beer float is surely a twist\u2014vanilla ice cream, root beer, and a shot of cinnamon whiskey make a fun party cocktail, or even dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 to 2 scoops vanilla ice cream into 2 beer mugs or tall glasses."
    },
    {
      "position": 2,
      "text": "Pour 1 1/2 ounces fireball into each glass; divide root beer evenly into each mug. Serve with a straw and spoon."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

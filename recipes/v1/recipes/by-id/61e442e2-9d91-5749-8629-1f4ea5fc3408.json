  "id": "61e442e2-9d91-5749-8629-1f4ea5fc3408",
  "slug": "peanut-butter-and-banana-french-toast",
  "name": "Peanut Butter and Banana French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This banana French toast is easy to make with your favorite bread, creamy peanut butter, and banana slices for a family-pleasing breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly beat egg and vanilla together in a shallow bowl."
    },
    {
      "position": 2,
      "text": "Spread 1 tablespoon of peanut butter on top of each slice of bread. Arrange banana slices on top of peanut butter on one slice of bread; place the other slice of bread, peanut butter-side down, on top of the banana to make a sandwich."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium heat. Dip sandwich into egg mixture until well coated; transfer into the heated skillet. Cook until golden brown on one side, about 2 to 3 minutes; flip and continue cooking until other side is browned, about 2 minutes more. Serve hot."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

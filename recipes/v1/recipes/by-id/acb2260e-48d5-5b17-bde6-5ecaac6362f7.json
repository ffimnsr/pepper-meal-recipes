  "id": "acb2260e-48d5-5b17-bde6-5ecaac6362f7",
  "slug": "spinach-and-potato-frittata",
  "name": "Spinach and Potato Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This tasty potato frittata is loaded with creamy reds, fresh spinach, garlic, green onions, and cheese for a scrumptious brunch or breakfast dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a medium skillet over medium heat. Cook potatoes in hot oil, stirring occasionally, until tender but firm, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix in spinach, green onions, and garlic. Season with salt and pepper. Cook and stir until spinach is wilted, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Beat together eggs and milk in a medium bowl. Pour over vegetables in the skillet. Sprinkle with Cheddar cheese. Reduce heat to low, cover, and cook until eggs are firm, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Slice and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

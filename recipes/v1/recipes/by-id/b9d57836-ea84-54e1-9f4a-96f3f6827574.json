  "schema_version": 1,
  "id": "b9d57836-ea84-54e1-9f4a-96f3f6827574",
  "slug": "5-ingredient-oven-baked-baby-back-ribs-recipe-11971115",
  "name": "5-Ingredient Oven-Baked Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "These oven-baked baby back ribs are coated in BBQ rub, garlic, butter, and liquid smoke for rich, smoky flavor without a grill. Wrapped in foil and baked until fall-apart tender, they're perfect for an easy barbecue dinner.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (189 degrees C) or up to 370 degrees F (188 degrees C). Remove membrane from the back of the slab."
    },
    {
      "position": 2,
      "text": "Drizzle 1 tablespoon liquid smoke on one side of the slab; massage into the meat. Flip over; massage remaining 1 tablespoon liquid smoke into the other side of the slab."
    },
    {
      "position": 3,
      "text": "Sprinkle 1 tablespoons BBQ rub on one side of the slab (or more to taste); rub in thoroughly. Flip over; massage 1 tablespoon BBQ rub into the other side (or more to taste). Sprinkle 1 tablespoon garlic powder over each side of the slab."
    },
    {
      "position": 4,
      "text": "Place 2 tablespoon butter on the meaty side of the slab. Wrap the slab, meaty side up, completely in foil; place on a flat pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour. Remove from the oven and flip the slab over, bony side up. Bake for 30 minutes."
    },
    {
      "position": 6,
      "text": "Melt remaining 2 tablespoons butter; stir remaining 1 tablespoon BBQ rub into melted butter."
    },
    {
      "position": 7,
      "text": "Remove slab from the oven and turn back over to the meaty side. Brush meaty side with half the butter-rub mixture. Leave slab in the foil but do not cover the slab."
    },
    {
      "position": 8,
      "text": "Bake uncovered for 30 minutes more."
    },
    {
      "position": 9,
      "text": "Remove from the oven; brush with remaining butter-rub mixture. Allow to sit for a few minutes before cutting."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

  "id": "5c24d36e-10c9-5d4d-b8be-4059b96cced0",
  "slug": "hash-brown-breakfast-burritos",
  "name": "Hash Brown Breakfast Burritos",
  "recipe_type": "breakfast",
  "brief_description": "This simple hash brown and egg scramble burrito recipe is a wonderful addition to your breakfast offerings. Add your own flair by customizing the filling!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine hash browns and hot water in a bowl; make sure hash browns are completely covered with water. Cover the bowl and let stand until hash browns are rehydrated, 10 to 12 minutes. Drain well."
    },
    {
      "position": 2,
      "text": "Heat oil in a large, nonstick skillet over medium-high heat. Add hash browns and fry, stirring a few times, until golden brown, about 6 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "While the hash browns are cooking, spray a large skillet with cooking spray; warm over medium-high heat. Whisk eggs together in a bowl. Pour into the skillet; cook and stir until eggs are set, about 5 minutes, stirring in chiles during the last minute. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Top each warm tortilla with an equal amount of hash browns and scrambled eggs, then sprinkle green onions and goat cheese over top. Fold the sides of each tortilla in toward the center and roll up from the bottom, tucking in the sides as you roll."
    },
    {
      "position": 5,
      "text": "Serve with salsa verde on the side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "easy",

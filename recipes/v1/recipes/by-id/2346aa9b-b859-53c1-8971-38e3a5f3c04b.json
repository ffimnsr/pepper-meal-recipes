  "id": "2346aa9b-b859-53c1-8971-38e3a5f3c04b",
  "slug": "panzanella-panini",
  "name": "Panzanella Panini",
  "recipe_type": "salad",
  "brief_description": "You'll find all of the fresh flavors of panzanella salad in this hot, crispy, crunchy, and cheesy panini sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a skillet over medium-low heat."
    },
    {
      "position": 2,
      "text": "Sprinkle cut sides of roll with balsamic vinegar. Layer one slice of mozzarella cheese, tomato slices, basil leaves, and the remaining slice of mozzarella cheese on the roll. Close sandwich; rub outside with olive oil."
    },
    {
      "position": 3,
      "text": "Place sandwich in preheated skillet; top with another heavy skillet to press. Cook until bread is toasted and golden, about 3 minutes. Flip sandwich; top with skillet. Cook second side until toasted, about an additional 2 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

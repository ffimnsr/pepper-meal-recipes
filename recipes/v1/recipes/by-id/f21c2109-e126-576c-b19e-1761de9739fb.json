  "slug": "pesto-genovese-authentic-italian-basil-pesto",
  "name": "Pesto Genovese (Authentic Italian Basil Pesto)",
  "recipe_type": "side",
  "brief_description": "Use a mortar and pestle to make authentic pesto Genoese, a smooth paste of basil, garlic, Italian cheeses, and extra-virgin olive oil.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Crush garlic using a mortar and pestle. Add pine nuts; crush with the garlic. Add basil leaves gradually, making circular movements with the pestle, until a smooth paste forms."
    },
    {
      "position": 2,
      "text": "Mix Parmigiano-Reggiano cheese and pecorino Romano cheese using a wooden spoon. Stir in olive oil until pesto is blended."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

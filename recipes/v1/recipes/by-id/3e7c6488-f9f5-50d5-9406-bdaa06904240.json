  "id": "3e7c6488-f9f5-50d5-9406-bdaa06904240",
  "slug": "mock-angel-food-cake",
  "name": "Mock Angel Food Cake",
  "recipe_type": "dessert",
  "brief_description": "This delicious mock angel food cake recipe is a quick and simple way to make a sheet cake that will taste like you bought it straight from a bakery!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift cake flour, sugar, and salt three times then stir in boiling water. Let cool."
    },
    {
      "position": 3,
      "text": "Beat egg whites, cream of tartar, baking powder, vanilla, and almond flavorings until stiff peaks form. Fold into flour mixture and pour batter into one ungreased 12x18-inch baking pan."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 35 minutes. Cool cake inverted in pan, laying a tea towel underneath cake to absorb steam. Frost as desired once cake is cooled."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

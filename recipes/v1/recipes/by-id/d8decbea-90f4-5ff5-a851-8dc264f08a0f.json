  "id": "d8decbea-90f4-5ff5-a851-8dc264f08a0f",
  "slug": "cherry-cobbler-in-the-slow-cooker",
  "name": "Cherry Cobbler in the Slow Cooker",
  "recipe_type": "dessert",
  "brief_description": "Made with frozen cherries instead of canned cherry pie filling, this delicious cherry cobbler is insanely easy to make in your slow cooker.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cherries, 2 tablespoons sugar, lemon juice, cornstarch, and almond extract in a saucepan over low heat. Cook, stirring occasionally and crushing cherries with a spoon, for 5 to 10 minutes. Remove from the heat and pour into a slow cooker."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and cinnamon together in a bowl. Cream 3/4 cup sugar and butter together in a separate, large bowl until light and fluffy. Add eggs, one at a time, beating well after each addition. Beat in milk. Mix in flour mixture just until incorporated. Add to the slow cooker."
    },
    {
      "position": 3,
      "text": "Cook on Low for 4 hours or on High for 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 10,

  "slug": "alabama-style-white-barbecue-sauce",
  "name": "Alabama-Style White Barbecue Sauce",
  "recipe_type": "side",
  "brief_description": "This Alabama white barbecue sauce recipe from Chef John uses easy ingredients for a delicious serving sauce, marinade, basting sauce, and/or dressing!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine mayonnaise, vinegar, horseradish, lemon juice, mustard, black pepper, salt, cayenne pepper, and garlic powder together in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk together thoroughly until creamy and smooth."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate until ready to use."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,

  "slug": "no-bake-fruitcake",
  "name": "No Bake Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "This fruitcake recipe using crushed vanilla wafer cookies, cherries, pecans, raisins, and coconut is easy to make and requires no baking whatsoever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl mix the candied cherries, chopped pecans, sweetened condensed milk, coconut milk, flaked coconut, raisins, vanilla, and crushed vanilla wafers. Batter will be very stiff. Place into pan and store in the refrigerator."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9ebe037a-538a-546f-9200-2f6c58f2fdcc",
  "slug": "souffle-style-pancakes-recipe-11933376",
  "name": "Souffle Style Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These souffle style pancakes are the lightest, jiggliest pancakes ever, made by folding an egg white meringue into the batter. Piped into tall mounds in a pan and steamed, there is nothing better than this fluffy stack, served with a quick and easy blueberry sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For blueberry sauce: combine blueberries, water, lemon juice, and sugar in a small pot. Cook over low-medium heat, stirring occasionally, until thickened, 5 to 7 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "For pancakes, whisk 2 tablespoons sugar, egg yolks, milk, vanilla, and a pinch of salt together in a bowl. Sift flour and baking powder over yolk mixture. Whisk until smooth."
    },
    {
      "position": 3,
      "text": "Whip egg whites with cream of tartar until frothy, then slowly stream in remaining 2 tablespoons sugar while mixing. Continue whipping until stiff, glossy peaks form."
    },
    {
      "position": 4,
      "text": "Fold half of meringue into the pancake mixture until 75% is incorporated (tip: fold lightly to keep it airy). Fold in remaining meringue, stirring just until the last streaks disappear."
    },
    {
      "position": 5,
      "text": "Heat a nonstick skillet over low heat. Grease with a neutral oil and wipe with a paper towel to leave only a thin layer."
    },
    {
      "position": 6,
      "text": "Add batter to a piping bag or resealable plastic bag. Snip a large hole in the corner. Pipe tall mounds of batter into the pan, about 1/2 cup each."
    },
    {
      "position": 7,
      "text": "Add 1 teaspoon water to the pan, and cover with a lid to steam. Cook on low heat, until pancakes have set and no longer look wet on top, about 8 minutes."
    },
    {
      "position": 8,
      "text": "Carefully flip pancakes and add another teaspoon water. Cover and finish cooking for 3 to 4 more minutes."
    },
    {
      "position": 9,
      "text": "Serve pancakes with whipped cream and blueberry sauce."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

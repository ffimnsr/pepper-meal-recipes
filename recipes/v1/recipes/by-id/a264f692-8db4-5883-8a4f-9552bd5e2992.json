  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a264f692-8db4-5883-8a4f-9552bd5e2992",
  "slug": "individual-salmon-wellingtons-recipe-8417008",
  "name": "Individual Salmon Wellingtons",
  "recipe_type": "side",
  "brief_description": "These individual salmon Wellingtons are salmon filets, topped with Dijon and spinach, and encased in golden-brown puff pastry. The salmon is moist and perfectly cooked, inside crisp-tender flaky pastry bundles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper; set aside."
    },
    {
      "position": 2,
      "text": "Pat salmon fillets dry with paper towels. Sprinkle salt and pepper on both sides of the salmon."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise, mustard, oregano, basil, dill, lemon zest, and oregano in a small bowl. Set aside half the mixture for serving."
    },
    {
      "position": 4,
      "text": "Spread remaining mixture on the top of salmon fillets."
    },
    {
      "position": 5,
      "text": "Sprinkle feta cheese on top of the salmon. Top with spinach."
    },
    {
      "position": 6,
      "text": "Cut the pastry sheet in quarters. Roll each portion on a lightly floured surface to a 7x7-inch square."
    },
    {
      "position": 7,
      "text": "Place each salmon fillet, topping side down, in the center of a pastry portion."
    },
    {
      "position": 8,
      "text": "Lift edges of pastry to enclose the salmon. Pinch edges to seal, and place each bundle, seam-side down, on prepared baking sheet."
    },
    {
      "position": 9,
      "text": "Beat together egg and water in small bowl. Brush egg wash on tops and sides of pastry bundles. Cut several small slits in tops of each pastry bundle to allow steam to escape."
    },
    {
      "position": 10,
      "text": "Bake in preheated oven until pastry is golden brown, 20 to 25 minutes. Serve with reserved herb Dijon mixture and lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

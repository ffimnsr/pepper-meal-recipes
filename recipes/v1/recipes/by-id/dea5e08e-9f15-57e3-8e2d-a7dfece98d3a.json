  "id": "dea5e08e-9f15-57e3-8e2d-a7dfece98d3a",
  "slug": "loaded-kimchi-fries-recipe-8648412",
  "name": "Loaded Kimchi Fries",
  "recipe_type": "appetizer",
  "brief_description": "These loaded kimchi french fries are guaranteed to spice up your snack game. Between the melted mozzarella, creamy cheese sauce, and tangy kimchi, these fries offer a bold, flavorful twist that\u2019s perfect for sharing. Here's how to make our easy kimchi fries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 450 degrees F (230 degrees C) with racks in top third and lower third positions."
    },
    {
      "position": 2,
      "text": "Toss together fries and oil in a large bowl until well coated. Spread fries in a single layer on prepared baking sheets. Bake in preheated oven until golden brown and crisp, about 35 minutes, stirring fries and rotating pans front to back and between top and bottom racks twice during bake time."
    },
    {
      "position": 3,
      "text": "Consolidate fries onto one baking sheet, arranging them into an even layer. Top fries evenly with mozzarella balls. Bake at 450 degrees F (230 degrees C) in top third of oven until cheese is slightly melted, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place cheese dip in a small microwave-safe medium bowl, and microwave on HIGH until warm and melted, about 45 seconds, stirring after 30 seconds. Add mayonnaise to cheese dip; stir until combined."
    },
    {
      "position": 5,
      "text": "Evenly drizzle cheese dip mixture and hot sauce over french fry mixture and top with kimchi and scallions."
    },
    {
      "position": 6,
      "text": "Divide between plates and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

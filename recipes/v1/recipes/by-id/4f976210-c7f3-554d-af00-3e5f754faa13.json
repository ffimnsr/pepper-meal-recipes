  "id": "4f976210-c7f3-554d-af00-3e5f754faa13",
  "slug": "philly-cheesesteak-casserole-recipe-11786868",
  "name": "Philly Cheesesteak Casserole",
  "recipe_type": "main",
  "brief_description": "This Philly cheesesteak casserole tastes great. It is a creamy, filling pasta bake with ground beef, and pepper-onion mixture, reminiscent of the famous Philly cheesesteak sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cook pasta according to package directions; drain. Add to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat 1 tablespoon of the oil in a 12-inch skillet over medium heat. Add ground beef, and cook for 4 minutes. Add peppers and onions. Cook until beef is browned and vegetables are tender, about 8 minutes."
    },
    {
      "position": 4,
      "text": "Season with garlic, oregano, salt and crushed red pepper. Cook until fragrant, 1 minute. Dust with flour and cook, stirring, for 1 minute."
    },
    {
      "position": 5,
      "text": "Mix in broth, and bring to a boil, stirring, until thickened and bubbly."
    },
    {
      "position": 6,
      "text": "Add cream cheese to the skillet. Cook and stir until melted."
    },
    {
      "position": 7,
      "text": "Stir in 1 cup provolone cheese until melted."
    },
    {
      "position": 8,
      "text": "Add mixture to the baking dish; stir to combine. Top with remaining 1/2 cup provolone cheese."
    },
    {
      "position": 9,
      "text": "Toss bread crumbs with remaining 2 tablespoons olive oil in a small bowl to coat. Spread over the mixture."
    },
    {
      "position": 10,
      "text": "Bake until browned and bubbly, 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

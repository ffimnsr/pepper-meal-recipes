{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "56032af5-326f-52bb-8cdc-54ac521d853f",
  "slug": "chocolate-lovers-fudge-with-jack-daniels-whiskey",
  "name": "Chocolate Lovers' Fudge with Jack Daniel's\u00ae Whiskey",
  "recipe_type": "dessert",
  "brief_description": "The special ingredient in this dense, rich chocolate fudge is Jack Daniel's\u00ae whiskey. Two types of chocolate are used and the fudge is garnished with pecans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour whiskey into a small bowl, add pecan halves, and allow them to soak in the whiskey for about 3 hours."
    },
    {
      "position": 2,
      "text": "Line 8-inch square pan with aluminum foil. Cut 2 pieces of foil about 14 inches long, and cut or fold each to an 8- inch width. Cover the bottom and 2 sides of the pan from left to right with 1 piece of foil. Use the remaining foil piece to cross the first layer of foil from top to bottom of the pan. Press foil firmly into the corners, and fold any excess over the sides of the pan. You will now have a double foil sling to lift the finished fudge from the pan."
    },
    {
      "position": 3,
      "text": "Drain pecans, reserving 2 ounces of the whiskey, and set aside."
    },
    {
      "position": 4,
      "text": "Place milk and dark chocolate in the top of a double boiler over 1 inch of simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, smooth, and shiny, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Remove melted chocolate from the heat and slowly pour in sweetened condensed milk, stirring until well blended. Add melted butter and salt, stirring continuously. Mix in reserved whiskey and stir until mixture is creamy and smooth."
    },
    {
      "position": 6,
      "text": "Pour into the prepared pan. Use an offset spatula to spread smoothly and evenly. Arrange 16 pecans on top, in 4 rows of 4 pecans each. Refrigerate until firm, at least 2 hours."
    },
    {
      "position": 7,
      "text": "Use the foil sling to lift the fudge from the pan. Place the fudge on a cutting board and cut into 16 pieces with a bench scraper or sharp knife."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,

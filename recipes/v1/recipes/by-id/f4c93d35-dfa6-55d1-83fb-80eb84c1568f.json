  "id": "f4c93d35-dfa6-55d1-83fb-80eb84c1568f",
  "slug": "black-bean-and-corn-guacamole",
  "name": "Black Bean and Corn Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This Nebraska-inspired dip is loaded with black beans, corn and authentic guac flavor, thanks to McCormick\u00ae Guacamole Seasoning Mix. Perfect for dipping with tortilla chips.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir Seasoning Mix and mashed avocados in medium bowl until well blended. Stir in corn, beans and tomato. Cover surface with plastic wrap."
    },
    {
      "position": 2,
      "text": "Refrigerate 30 minutes to allow flavors to blend. Stir before serving. Serve as a dip with tortilla chips."
    }
  ],
  "servings": 24,

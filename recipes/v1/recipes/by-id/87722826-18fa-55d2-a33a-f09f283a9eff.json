  "schema_version": 1,
  "id": "87722826-18fa-55d2-a33a-f09f283a9eff",
  "slug": "mommas-best-chicken-and-dumplings",
  "name": "Momma's Best Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "Made with chicken breast, carrots, and spices, just one bite of these chicken and dumplings will convince you that this recipe is the best.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a stock pot over medium-high heat. Add celery, carrot, onion, garlic, bay leaves, thyme, salt, pepper, and poultry seasoning; cook and stir until flavors combine, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Push vegetable mixture to the sides and add chicken; cook until browned, 3 to 5 minutes per side."
    },
    {
      "position": 4,
      "text": "Pour enough water over the chicken to cover by 3 inches; bring to a boil. Stir, scraping the browned bits off of the bottom of the pot. Reduce heat; simmer until chicken is tender, about 1 hour."
    },
    {
      "position": 5,
      "text": "Transfer chicken and carrots to a serving plate with a large slotted spoon; let cool."
    },
    {
      "position": 6,
      "text": "Ladle 1/4 cup cooking liquid into a bowl; cool slightly, about 5 minutes. Mix in 2 tablespoons flour. Stir back into the pot."
    },
    {
      "position": 7,
      "text": "Place 2 cups flour in a large bowl; cut in shortening with 2 knives until mixture forms pea-sized bits. Mix in chilled chicken broth until dough is combined."
    },
    {
      "position": 8,
      "text": "Turn dough out onto a floured work surface. Knead 5 to 6 times; pat down to 1-inch thickness. Sprinkle lightly with flour; roll out to about 1/8-inch thickness. Cut dough into squares with a sharp knife."
    },
    {
      "position": 9,
      "text": "Drop squares, in batches, into simmering cooking liquid, moving squares to the side with each addition. Partially cover pot; simmer until dumplings are firm, about 12 minutes. Separate any dumplings that stick together. Remove from heat; keep covered."
    },
    {
      "position": 10,
      "text": "Bone chicken; cut into bite-sized pieces and return to the pot. Chop carrot; return to the pot. Cool chicken and dumplings, about 30 minutes, before serving."
    },
    {
      "position": 11,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,

  "id": "7850ba4c-6320-5acc-bc0a-588d95b4f604",
  "slug": "easy-chocolate-chip-cookie-dough-truffles",
  "name": "Easy Chocolate Chip Cookie Dough Truffles",
  "recipe_type": "dessert",
  "brief_description": "Chocolate chip cookie dough truffles are simple to make. Dip egg-free chocolate chip cookie dough in melted chocolate coating, and top with toffee pieces. Yum!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together brown sugar and butter with an electric mixer in a large bowl until smooth. Mix in vanilla. Add flour and sweetened condensed milk alternately, beating well after each addition. Fold in chocolate chips and toffee bits until incorporated."
    },
    {
      "position": 2,
      "text": "Use a small cookie scoop to portion dough into 1-inch balls; place on wax paper-lined baking sheets. Refrigerate until firm, about 1 hour."
    },
    {
      "position": 3,
      "text": "Melt chocolate coating in a microwave-safe glass or ceramic bowl in the microwave in 30-second intervals, stirring after each melting, 1 to 3 minutes. Do not overheat or coating will scorch."
    },
    {
      "position": 4,
      "text": "Dip dough balls in chocolate coating, allowing excess to drip off. Place on wax paper-lined baking sheets and sprinkle with additional toffee bits. Refrigerate until firm, about 15 minutes. Store in the refrigerator."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

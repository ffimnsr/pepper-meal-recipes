  "schema_version": 1,
  "id": "3fb3c55f-aa39-55df-8c04-9875307eb165",
  "slug": "vegetarian-pho-vietnamese-noodle-soup",
  "name": "Vegetarian Pho (Vietnamese Noodle Soup)",
  "recipe_type": "soup",
  "brief_description": "An aromatic broth is ladled over rice noodles, fried tofu, and mushrooms in this bright and fresh Vietnamese-inspired vegetarian pho soup.",
  "cuisine": "Vietnamese",
  "instructions": [
    {
      "position": 1,
      "text": "Place vegetable stock, onion, soy sauce, garlic, cinnamon sticks, ground ginger, star anise, and bay leaves in a large pot; bring to a boil. Reduce heat, cover, and simmer until flavors combine, 30 to 45 minutes. Remove solids with a slotted spoon and keep broth hot."
    },
    {
      "position": 2,
      "text": "Place noodles in a large bowl and cover with boiling water. Set aside until noodles are softened, 8 to 10 minutes. Drain and rinse thoroughly. Divide noodles among 6 serving bowls."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat until shimmering. Add tofu in a single layer and fry, in batches, until golden brown, about 6 minutes per side."
    },
    {
      "position": 4,
      "text": "Simmer fried tofu and mushrooms in broth until heated through, about 5 minutes. Transfer to serving bowls. Top with scallions and cilantro. Ladle in hot broth."
    },
    {
      "position": 5,
      "text": "Serve lime wedges, jalapeno peppers, bean sprouts, and basil alongside for garnishing each bowl."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 64,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

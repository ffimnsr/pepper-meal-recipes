  "id": "0ddca005-0038-5669-81fd-8637f1b67f7f",
  "slug": "caramel-apple-martini-pudding-shots",
  "name": "Caramel Apple Martini Pudding Shots",
  "recipe_type": "dessert",
  "brief_description": "This adults-only caramel apple pudding shot recipe features instant pudding and whipped topping with apple Schnapps, butterscotch Schnapps, and vodka.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat milk and pudding mix together in a large bowl until smooth; stir in apple Schnapps, butterscotch Schnapps, and vodka until blended. Fold in whipped topping until incorporated."
    },
    {
      "position": 2,
      "text": "Divide mixture among 12 shot glasses or disposable shot cups. Freeze until ready to serve."
    }
  ],
  "servings": 12,

  "id": "066c88eb-5f05-5d11-a77e-cb9dc6e18764",
  "slug": "2-ingredient-dough-bagels",
  "name": "2-Ingredient Dough Bagels",
  "recipe_type": "breakfast",
  "brief_description": "Two ingredient dough is the base for these easy, fluffy homemade bagels that are perfect for breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour and Greek yogurt together in a medium bowl until a shaggy dough forms. Transfer to a surface dusted with self-rising flour, and knead for 8 to 10 minutes. Continue adding flour as needed if the dough is too sticky."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Cut the dough into 4 pieces, roughly 4 ounces each. Roll each segment into a smooth ball. Use your thumbs to poke a hole in the center of each round, then gently stretch the dough until it becomes a uniform-sized ring."
    },
    {
      "position": 4,
      "text": "Transfer the dough to a parchment paper-lined baking sheet."
    },
    {
      "position": 5,
      "text": "Whisk the egg in a small bowl to create an egg wash, then brush a light coating on top of the dough. Sprinkle with bagel seasoning."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 20 to 22 minutes. Increase the oven's temperature to 450 degrees F (230 degrees C) and continue to bake until golden, 3 to 4 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "slug": "absolutely-the-best-rich-and-creamy-blue-cheese-dressing-ever",
  "name": "Absolutely the BEST Rich and Creamy Blue Cheese Dressing Ever!",
  "recipe_type": "salad",
  "brief_description": "This homemade blue cheese dressing recipe makes a deliciously creamy salad dressing with a chunky texture that'll rival anything you can buy at the store.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mash blue cheese and buttermilk together in a small bowl with a fork until mixture resembles large-curd cottage cheese."
    },
    {
      "position": 2,
      "text": "Stir in sour cream, mayonnaise, vinegar, sugar, and garlic powder until well blended. Season to taste with salt and pepper."
    },
    {
      "position": 3,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,

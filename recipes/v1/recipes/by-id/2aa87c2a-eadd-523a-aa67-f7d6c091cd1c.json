  "id": "2aa87c2a-eadd-523a-aa67-f7d6c091cd1c",
  "slug": "lighter-chicken-and-dumplings",
  "name": "Lighter Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "A reduced fat rendition benefits from plenty of vegetables and a gravy derived from low fat soups.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large saucepan or Dutch oven, stir together the cream of chicken soup, chicken broth, and milk. Bring to a simmer over medium heat."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a skillet over medium-high heat. Add chicken strips, onion and celery. Sautee until chicken is cooked through, and onions are tender. Transfer the chicken mixture to the soup pot, and mix well. Reduce heat to low, and simmer for 30 to 45 minutes. Season with celery seed and black pepper."
    },
    {
      "position": 3,
      "text": "To Make Dumplings: In a medium bowl, stir together the flour, baking powder and salt. In a small bowl, mix together 1/2 cup of milk and 2 tablespoons of oil. Pour into the dry ingredients, stirring just until moistened."
    },
    {
      "position": 4,
      "text": "Drop tablespoonfuls of the dumpling mixture into simmering chicken stew. Cover pot tightly, and bring to a boil. Simmer for another 12 to 15 minutes - without peeking! Ladle into bowls, and serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

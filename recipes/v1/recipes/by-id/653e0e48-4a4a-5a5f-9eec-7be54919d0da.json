  "id": "653e0e48-4a4a-5a5f-9eec-7be54919d0da",
  "slug": "high-protein-pizza-dough-recipe-11971114",
  "name": "High Protein Pizza Dough",
  "recipe_type": "side",
  "brief_description": "This high-protein pizza dough is a game-changer for quick, healthy homemade pizza nights. Made with self-rising flour, Greek yogurt, and unflavored protein powder, it comes together in minutes with no yeast and no rising time. The result is a soft, chewy crust with crispy edges that holds up well to toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk self-rising flour and protein powder together in a bowl until evenly combined. Add Greek yogurt and stir with a spoon or fork until a shaggy dough forms."
    },
    {
      "position": 2,
      "text": "Knead lightly by hand on a lightly floured surface until smooth and not sticky, 30 to 60 seconds. If too dry or crumbly, add yogurt 1 teaspoon at a time. If too sticky, add a sprinkle of flour. Let dough rest for 10 minutes."
    },
    {
      "position": 3,
      "text": "Roll or press out on parchment paper into your desired shape and thickness. Dust with a little flour if sticky."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake plain crust on a pizza pan or stone in the preheated oven for 5 to 7 minutes. Add sauce, cheese, and toppings, then bake until golden and crispy, 8 to 12 minutes more. Enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

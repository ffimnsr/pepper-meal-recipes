  "id": "95960117-2755-55f3-9c54-938da3bf62b4",
  "slug": "greek-chicken-meatballs-recipe-11748546",
  "name": "Greek Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "These Greek chicken meatballs are flavored with fresh herbs, lemon, and feta. They come out nicely moist and can be baked or made in the air fryer. Serve in a pita as a sandwich or with tzatziki sauce.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line two rimmed baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Lightly beat eggs in a large bowl. Stir in bread crumbs, onion, feta, lemon zest and juice, olive oil, mint, parsley, dill, garlic, oregano, salt, and crushed red pepper. Add chicken; mix well."
    },
    {
      "position": 3,
      "text": "Use a 1 1/2 tablespoon scoop to portion mixture into 1 1/2-inch meatballs. Roll to smooth balls with damp hands. Place meatballs on the prepared baking sheets. Coat meatballs with nonstick cooking spray."
    },
    {
      "position": 4,
      "text": "Bake meatballs until an instant-read thermometer registers 165 degrees F (74 degrees C), 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

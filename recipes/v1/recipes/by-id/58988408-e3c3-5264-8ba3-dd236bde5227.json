  "id": "58988408-e3c3-5264-8ba3-dd236bde5227",
  "slug": "deconstructed-california-roll-sushi",
  "name": "Deconstructed California Roll Sushi",
  "recipe_type": "appetizer",
  "brief_description": "Everything you love about a California roll--imitation crab, cucumber, avocado, and rice--served on a plate so you can eat it with a fork.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse rice 3 times. Place in a saucepan and add water; bring to a boil. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes. Remove from the heat and cool to room temperature, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Divide ingredients evenly and layer onto 4 plates as follows: rice, crab, cucumber slices, and avocado slices. Drizzle teriyaki over each plate and sprinkle with sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

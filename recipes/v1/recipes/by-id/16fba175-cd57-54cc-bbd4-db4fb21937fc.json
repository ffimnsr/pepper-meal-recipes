  "id": "16fba175-cd57-54cc-bbd4-db4fb21937fc",
  "slug": "lemon-pasta-sauce",
  "name": "Lemon Pasta Sauce",
  "recipe_type": "soup",
  "brief_description": "This lemon pasta sauce tossed with hot noodles features a rich, tangy blend of butter, beef broth, and cream flavored with lemon juice and lime zest.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine broth, cream, and butter in a large saucepan or skillet. Bring to a simmer over medium heat; cook until reduced by about half. Stir in lemon juice, lemon zest, and lime zest. Set sauce aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until tender yet firm to the bite, 8 to 10 minutes; drain."
    },
    {
      "position": 3,
      "text": "Add pasta to sauce and toss until well coated."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

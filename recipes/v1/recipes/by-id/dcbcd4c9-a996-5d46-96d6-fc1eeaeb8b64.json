  "id": "dcbcd4c9-a996-5d46-96d6-fc1eeaeb8b64",
  "slug": "jalapeno-popper-potatoes-recipe-11693417",
  "name": "Jalapeno Popper Potatoes",
  "recipe_type": "side",
  "brief_description": "These jalapeno popper potatoes are mashed potatoes baked with pepper Jack cheese, bacon, and jalapenos, for a spicy, rich side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil, then add potatoes and return to a boil. Cook until very tender, 14 to 16 minutes. Drain potatoes and add them to a large bowl."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook bacon until crisp in a large skillet, drain, and set aside. Reserve drippings in pan."
    },
    {
      "position": 4,
      "text": "Add jalapenos to drippings, and cook, stirring constantly until softened, about 2 minutes. Add jalapenos to potatoes."
    },
    {
      "position": 5,
      "text": "Add in reserved bacon, pimento cheese, 1 1/2 cups pepper Jack cheese, and salt. Stir to combine (potatoes will fall apart). Transfer mixture to a casserole dish and top with remaining cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned and bubbly, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

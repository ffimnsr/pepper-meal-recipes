  "id": "567dc7f7-d136-550f-a7b2-6dbb32cb3cb8",
  "slug": "slow-cooker-venison-roast",
  "name": "Slow Cooker Venison Roast",
  "recipe_type": "soup",
  "brief_description": "This venison roast crockpot dinner couldn't be easier: Venison, onion, and 2 soup mixes simmer in the slow cooker for a creamy, tender, delectable meal.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Clean venison roast and place in a slow cooker. Cover with onion slices, then sprinkle with soy sauce, Worcestershire sauce, garlic salt, and pepper."
    },
    {
      "position": 3,
      "text": "Stir onion soup mix and condensed soup together in a small bowl. Pour mixture over venison."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low setting for 6 hours."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 10,

  "id": "36c96f12-06e9-565b-b8d6-6b0b49371000",
  "slug": "rockin-oysters-rockefeller",
  "name": "Rockin' Oysters Rockefeller",
  "recipe_type": "appetizer",
  "brief_description": "Oysters Rockefeller is a classic seafood dish of half oysters in the shell, topped with creamy sauce and bread crumbs, baked until golden and bubbly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Clean oysters, and place them in a large stockpot. Pour in beer and enough water to cover oysters; add 2 cloves of garlic, peppercorns, and seasoned salt. Bring to a boil. Remove from heat, drain, and cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C.)"
    },
    {
      "position": 3,
      "text": "Once oysters are cooled, break off and discard the top shell. Arrange oysters on a baking sheet."
    },
    {
      "position": 4,
      "text": "Melt butter in a saucepan over medium heat. Cook onion and garlic in butter until soft. Reduce heat to low; stir in spinach, Monterey Jack, fontina, and mozzarella. Cook until cheese melts, stirring frequently. Stir in milk; season with salt and pepper. Spoon sauce over each oyster, just filling the shell. Sprinkle with bread crumbs."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and bubbly, approximately 8 to 10 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

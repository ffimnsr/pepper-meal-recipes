  "id": "905432b9-1f7e-5991-acc3-17d83ee370bc",
  "slug": "hot-honey-chicken",
  "name": "Hot Honey Chicken",
  "recipe_type": "dessert",
  "brief_description": "Golden hot honey chicken breasts glazed with a sweet, spicy, and sticky combination of honey and hot pepper sauce cooked to perfection on the grill.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Mix honey, hot sauce, and ground black pepper in a small bowl until well combined."
    },
    {
      "position": 3,
      "text": "Place chicken on the preheated grill and baste with some of the sauce. Cook, basting occasionally, until chicken is golden and sticky and internal temperature reaches 180 degrees F (80 degrees C), about 10 to 15 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

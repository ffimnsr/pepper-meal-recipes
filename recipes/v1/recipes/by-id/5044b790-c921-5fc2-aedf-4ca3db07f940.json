  "id": "5044b790-c921-5fc2-aedf-4ca3db07f940",
  "slug": "easy-roasted-red-pepper-hummus",
  "name": "Easy Roasted Red Pepper Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This roasted red pepper hummus is easy to make in a food processor. It's flavored with garlic, lemon, tahini, and basil for a delicious vegan dip.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chickpeas, tahini, lemon juice, and garlic in the bowl of a food processor; pulse until blended. Add roasted peppers and basil; process until the peppers are finely chopped. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Transfer hummus to a small bowl, cover, and chill until ready to serve."
    }
  ],
  "servings": 18,

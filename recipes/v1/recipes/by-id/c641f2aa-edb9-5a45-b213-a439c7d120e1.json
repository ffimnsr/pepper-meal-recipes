  "id": "c641f2aa-edb9-5a45-b213-a439c7d120e1",
  "slug": "grilled-bacon-sushi-roll",
  "name": "Grilled Bacon Sushi Roll",
  "recipe_type": "main",
  "brief_description": "This meaty twist on sushi, with bacon, ground beef, jalapenos, and pepper Jack cheese, will get you invited to every barbeque in town!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Arrange bacon slices side by side, facing lengthwise, on a sushi mat."
    },
    {
      "position": 2,
      "text": "Mix ground beef and spice rub together in a large bowl. Spread in a thin layer over bacon, leaving 1 inch of bacon uncovered on the end furthest from you. Cover beef with prosciutto. Line jalapeno strips across the end closest to you. Place cheese sticks next to jalapeno strips."
    },
    {
      "position": 3,
      "text": "Roll up bacon tightly towards the uncovered end."
    },
    {
      "position": 4,
      "text": "Preheat grill to 350 degrees F (175 degrees C). Grill bacon roll seam side-down over indirect heat until crisp, about 25 minutes. Brush some barbeque sauce on top. Continue grilling until barbeque sauce is glazed, about 5 minutes. Add remaining barbeque sauce; grill for 5 minutes more."
    },
    {
      "position": 5,
      "text": "Remove from grill and coat evenly with fried onions. Slice and serve with chopsticks."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1a2423df-0d19-5db1-922d-6b5042582161",
  "slug": "korean-mandu-egg-roll",
  "name": "Korean Mandu (Egg Rolls)",
  "recipe_type": "appetizer",
  "brief_description": "Korean egg rolls, also known as mandu, are made with a mixture of beef, pork, and cabbage stuffed in wonton wrappers and fried until golden brown.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef and pork in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Transfer meat mixture to a large bowl, breaking up any large chunks with a wooden spoon."
    },
    {
      "position": 2,
      "text": "While the meat is cooking, place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cabbage, cover, and steam until tender, 2 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep-fryer or large saucepan to 360 degrees F (182 degrees C)."
    },
    {
      "position": 4,
      "text": "Mix cabbage, bean sprouts, celery, green onion, soy sauce, cornstarch, sesame oil, salt, and pepper into meat mixture. Spoon mixture into the center of each wonton wrapper. Brush beaten egg onto two edges of each wrapper and fold wrapper around filling, sealing the edges together."
    },
    {
      "position": 5,
      "text": "Working in batches, fry wontons in hot oil until browned, 3 to 5 minutes. Finish filling and forming remaining wontons while each batch cooks. Drain cooked wontons on a paper towel-lined plate."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

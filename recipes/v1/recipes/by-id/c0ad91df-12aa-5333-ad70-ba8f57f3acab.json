  "id": "c0ad91df-12aa-5333-ad70-ba8f57f3acab",
  "slug": "chef-johns-shrimp-and-grits",
  "name": "Chef John's Shrimp and Grits",
  "recipe_type": "breakfast",
  "brief_description": "This shrimp and grits recipe cooks plump shrimp in a creamy Cajun sauce with bacon; serve on cheesy grits for a Southern classic that's great anytime!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until almost crisp, 5 to 7 minutes. Transfer bacon to a dish; reserve drippings in the skillet."
    },
    {
      "position": 3,
      "text": "Whisk 1/4 cup water, cream, lemon juice, and Worcestershire sauce together in a bowl."
    },
    {
      "position": 4,
      "text": "Combine 4 cups water, butter, and 1 teaspoon salt in a pot; bring to a boil. Whisk in grits; bring to a simmer, reduce heat to low, and cook until creamy, 20 to 25 minutes. Off heat, stir in Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Season shrimp with Cajun seasoning, 1/2 teaspoon salt, black pepper, and a pinch of cayenne pepper in a large bowl."
    },
    {
      "position": 6,
      "text": "Heat bacon drippings in the skillet over high heat. Add shrimp; cook 1 minute. Flip shrimp; add jalape\u00f1o and cook until fragrant, about 30 seconds."
    },
    {
      "position": 7,
      "text": "Stir cream mixture, bacon, green onion, and garlic into shrimp mixture; cook and stir until shrimp cooked through, 3 to 4 minutes, adding water as necessary to thin sauce. Off heat, stir in parsley."
    },
    {
      "position": 8,
      "text": "Ladle grits into a bowl; top with shrimp and sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

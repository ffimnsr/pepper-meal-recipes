  "id": "1d5cdec8-d9f6-555a-a07a-95ee7b2722b4",
  "slug": "italian-style-turkey-meatloaf",
  "name": "Italian Style Turkey Meatloaf",
  "recipe_type": "main",
  "brief_description": "Turkey meatloaf gets an Italian flair through the use of Italian-style bread crumbs and Italian seasoning.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Prepare a baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix turkey, egg, bread crumbs, Italian seasoning, garlic, black pepper, and salt in a large bowl; shape into a loaf and put into prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 40 minutes. Spoon about half the tomato sauce over the loaf and continue baking until the meatloaf is no longer pink in the center, 10 to 15 minutes more. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Rest meatloaf 5 to 10 minutes before slicing to serve."
    },
    {
      "position": 4,
      "text": "While the meatloaf rests, warm remaining tomato sauce in a small saucepan over medium-low heat; serve with the sliced meatloaf."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

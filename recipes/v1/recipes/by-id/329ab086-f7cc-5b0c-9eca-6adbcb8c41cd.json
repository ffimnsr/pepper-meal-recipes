  "id": "329ab086-f7cc-5b0c-9eca-6adbcb8c41cd",
  "slug": "jim-beam-yule-nog",
  "name": "Jim Beam Yule Nog",
  "recipe_type": "drink",
  "brief_description": "Rich, creamy eggnog is the base of this tasty yule log cocktail made with Jim Beam Bourbon and butterscotch liqueur. It tastes just like the holidays!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour eggnog, bourbon, and schnapps into a shaker. Fill with ice, then cover and shake until chilled."
    },
    {
      "position": 2,
      "text": "Strain into a chilled cocktail glass. Garnish with a dusting of fresh ground nutmeg."
    }
  ],

  "id": "feb6abe3-2f9f-5d97-8120-a4654bcd9632",
  "slug": "air-fryer-potato-peel-chips-recipe-11971099",
  "name": "Air Fryer Potato Peel Chips",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer potato peel chips turn scraps into delicious chips to snack on while cooking, or a quick appetizer when your guests are waiting on the main course. You\u2019ll never toss potato peels again.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Rinse peels and pat dry with paper towels. Place peels in a mixing bowl. Add oil, salt, and onion powder; toss to coat."
    },
    {
      "position": 3,
      "text": "Place seasoned peels in the basket of the air fryer (you may need to work in batches). Cook 10 minutes, shaking every 2 minutes."
    },
    {
      "position": 4,
      "text": "Let cool 1 minute and transfer to serving plate. Serve with ketchup or preferred dipping sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

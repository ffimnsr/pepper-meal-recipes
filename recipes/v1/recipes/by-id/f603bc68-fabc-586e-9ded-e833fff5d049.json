  "id": "f603bc68-fabc-586e-9ded-e833fff5d049",
  "slug": "grey-cup-nachos",
  "name": "Grey Cup Nachos",
  "recipe_type": "appetizer",
  "brief_description": "This is a recipe from my early days of cooking. The first time I made these was for the Grey Cup (Canadian Football Championship) of 1992 and they've been yummy ever since. Enjoy.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Place the ground beef in a large skillet over medium-high heat. Cook, stirring to crumble, until no longer pink. Add onion and cook until tender. Drain off grease. Stir in the contents of the seasoning packet and any water if needed in order to prepare according to package directions."
    },
    {
      "position": 2,
      "text": "When the meat is done cooking, add the bell pepper, jalapeno pepper and sliced mushrooms to the skillet, and lower heat to medium. Cook and stir until vegetables are about halfway cooked, 3 to 4 minutes. Stir in the cheese sauce until everything is evenly coated."
    },
    {
      "position": 3,
      "text": "Serve tortilla chips topped with the meat and cheese sauce, or serve buffet style where each person can top their own nachos."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

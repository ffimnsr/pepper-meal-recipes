  "id": "dc83235c-37fe-5c4d-9c2b-8a37b7da4e21",
  "slug": "lau-lau",
  "name": "Lau Lau",
  "recipe_type": "main",
  "brief_description": "Salt butterfish, pork and chicken wrapped in layers of taro leaves and ti leaves, and then steamed.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Season fish, pork and chicken with Hawaiian sea salt. Place 2 ti leaves in an X on a flat surface for each of the 4 servings."
    },
    {
      "position": 2,
      "text": "Place 1/4 of each of the fish, pork and chicken onto the center of 3 or 4 taro leaves. Wrap securely with the taro leaves, then place each wrap on a set of ti leaves. Tie the ends of the ti leaves together with a piece of string."
    },
    {
      "position": 3,
      "text": "Place the bundles in a large steamer, and steam for 3 to 4 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 30,

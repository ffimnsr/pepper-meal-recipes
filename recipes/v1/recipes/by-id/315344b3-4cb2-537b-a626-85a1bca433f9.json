  "id": "315344b3-4cb2-537b-a626-85a1bca433f9",
  "slug": "stefs-super-cheesy-garlic-bread",
  "name": "Stef's Super Cheesy Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This super cheesy garlic bread is made with two types of cheese mixed with green onions, garlic, and mayonnaise to create an incredible tasting bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together butter, mayonnaise, green onions, garlic, Parmesan cheese, and Monterey Jack cheese in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Cut each French bread half into 4 pieces. Spread cheese mixture evenly over each bread piece."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 8 minutes. Turn the broiler to high. Broil until hot and bubbly, about 2 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

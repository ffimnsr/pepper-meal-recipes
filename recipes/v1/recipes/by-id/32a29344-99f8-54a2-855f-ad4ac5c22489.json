  "schema_version": 1,
  "id": "32a29344-99f8-54a2-855f-ad4ac5c22489",
  "slug": "buffalo-chicken-dip-with-sour-cream",
  "name": "Buffalo Chicken Dip with Sour Cream",
  "recipe_type": "appetizer",
  "brief_description": "This 5-ingredient Buffalo chicken dip with sour cream is baked in the oven with ranch dressing, hot sauce, and Cheddar cheese until hot and creamy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Add chicken; cover and reduce heat to medium. Simmer until chicken is no longer pink in the center and juices run clear, about 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove chicken and shred when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Combine ranch dressing and sour cream in a saucepan over low heat. Stir and heat until warm, about 5 minutes. Stir in hot sauce and 1/2 cup Cheddar cheese, followed by shredded chicken."
    },
    {
      "position": 3,
      "text": "Transfer mixture to an 8-inch round baking dish and top with remaining 1 cup Cheddar cheese. Place in the refrigerator to cool for 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove dip from the refrigerator and bake in the preheated oven until cheese is bubbly, 20 to 30 minutes. Let cool slightly before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

  "slug": "whole-lemon-lemonade-recipe-11740223",
  "name": "This 3-Ingredient Lemonade Is Shockingly Easy\u2014and Requires Zero Squeezing",
  "recipe_type": "dessert",
  "brief_description": "Yes, you will use the entire lemon for this whole lemon lemonade recipe. Summer has never tasted sweeter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine lemons, sugar, and 4 cups water in a blender and process until completely smooth, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour lemonade through a fine mesh strainer into a pitcher and discard solids."
    },
    {
      "position": 4,
      "text": "Stir in ice and remaining 2 cups of water."
    }
  ],

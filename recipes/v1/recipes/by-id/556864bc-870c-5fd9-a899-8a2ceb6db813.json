  "id": "556864bc-870c-5fd9-a899-8a2ceb6db813",
  "slug": "moist-pumpkin-bread",
  "name": "Moist Pumpkin Bread",
  "recipe_type": "dessert",
  "brief_description": "This moist pumpkin bread recipe combines autumnal cinnamon and pumpkin spice flavors with canned pumpkin pur\u00e9e and pecans for an easy-to-make loaf.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk sugar, flour, baking soda, salt, cinnamon, and pumpkin pie spice together in a bowl. Add pumpkin pur\u00e9e, vegetable oil, eggs, and water; mix well. Fold in pecans."
    },
    {
      "position": 3,
      "text": "Divide mixture between the 2 prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

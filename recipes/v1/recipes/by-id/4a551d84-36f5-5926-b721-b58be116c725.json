  "id": "4a551d84-36f5-5926-b721-b58be116c725",
  "slug": "best-keto-bread",
  "name": "Best Keto Bread",
  "recipe_type": null,
  "brief_description": "The best keto bread recipe. This delicious low-carb version is easy to make and perfect for slicing for toast or sandwiches. Customize to your liking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 8\u00bd \u00d7 4\u00bd-inch silicone loaf pan with cooking spray."
    },
    {
      "position": 3,
      "text": "Whisk eggs in a bowl until smooth and creamy, about 3 minutes. Add melted butter and olive oil; mix until well combined."
    },
    {
      "position": 4,
      "text": "Combine almond flour, baking powder, xanthan gum, and salt in a separate bowl; mix well. Add gradually to the egg mixture, mixing well until a thick batter is formed."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan and smooth the top with a spatula."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "id": "7ba3a3bb-fa84-5834-b914-bf4f2cd970e5",
  "slug": "beef-and-mushroom-stroganoff-aussie-style",
  "name": "Beef and Mushroom Stroganoff, Aussie Style",
  "recipe_type": null,
  "brief_description": "Tasty beef and mushroom stroganoff. This was my favorite recipe as a kid, my Mum came up with it from the stuff that was left in the cupboard! I've since modified the ingredients to add my own personal touch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt the butter in a large skillet over medium heat. Add the onion and garlic, and fresh mushrooms; cook until the onions are translucent. Stir in curry powder until well blended. Place the meat strips in the skillet, and fry until evenly browned."
    },
    {
      "position": 2,
      "text": "Dissolve the bouillon cubes in the boiling water, then stir into the skillet. Add the mushroom stems and pieces and dried shiitake mushrooms. Let the mixture simmer over medium heat until most of the liquid has evaporated, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add the noodles and cook until tender, about 7 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Reduce the heat under the skillet to low, and pour in the cream, stirring until the sauce is an even color. Simmer for about 5 minutes, but do not boil. Serve over noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

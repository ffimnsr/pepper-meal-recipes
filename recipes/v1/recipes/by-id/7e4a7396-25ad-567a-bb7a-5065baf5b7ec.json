  "id": "7e4a7396-25ad-567a-bb7a-5065baf5b7ec",
  "slug": "apple-cranberry-crisp",
  "name": "Apple-Cranberry Crisp",
  "recipe_type": "dessert",
  "brief_description": "This apple-cranberry crisp made with sweet and juicy baked apples and tart cranberries is topped with a crunchy pecan topping. Perfect for the holidays!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C.) Butter an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Mix apples, cranberries, white sugar, cinnamon, and nutmeg in a large bowl. Place in an even layer in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "In the same bowl, combine oats, flour, and brown sugar for topping. Add butter pieces and mix with a fork until crumbly."
    },
    {
      "position": 4,
      "text": "Stir in pecans. Sprinkle topping over apples in the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until apples are tender and topping is golden brown, 40 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

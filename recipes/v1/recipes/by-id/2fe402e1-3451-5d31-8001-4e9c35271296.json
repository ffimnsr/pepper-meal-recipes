  "slug": "instant-pot-charro-refried-beans",
  "name": "Instant Pot Charro (Refried Beans)",
  "recipe_type": "side",
  "brief_description": "The Instant Pot charro (refried beans) recipe lets the electric pressure cooker do all the work for Mexican \"charro\" beans with onion, cumin, and cilantro.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, pinto beans, onion, salsa, cilantro, jalape\u00f1o, garlic, tomato bouillon, vegetable bouillon, chili powder, paprika, cumin, and black pepper in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select Bean/Chili function; set timer for 45 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove lid."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,

  "id": "ace73004-93b7-5aa0-9d34-b0715f91b83b",
  "slug": "marinated-grilled-shrimp",
  "name": "Marinated Grilled Shrimp",
  "recipe_type": "main",
  "brief_description": "Learn how to marinate shrimp for grilling with this easy marinade of garlicky tomato sauce with vinegar and basil, great with frozen or fresh shrimp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir olive oil, tomato sauce, garlic, and red wine vinegar together in a large bowl. Season with basil, salt, and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Add shrimp to the bowl; stir until evenly coated. Cover and refrigerate for 30 minutes to 1 hour, stirring once or twice."
    },
    {
      "position": 3,
      "text": "Preheat the grill to medium heat. Lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Thread shrimp onto skewers, piercing once near the tail and once near the head. Discard marinade."
    },
    {
      "position": 5,
      "text": "Cook shrimp on the preheated grill until opaque, 2 to 3 minutes per side."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

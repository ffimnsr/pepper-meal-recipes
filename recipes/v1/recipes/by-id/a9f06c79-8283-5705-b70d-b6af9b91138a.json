  "id": "a9f06c79-8283-5705-b70d-b6af9b91138a",
  "slug": "melting-moments-ii",
  "name": "Melting Moments Cookies",
  "recipe_type": "dessert",
  "brief_description": "These melting moments cookies are delicate, buttery cornstarch cookies with a light, crumbly texture that makes them perfect for tea.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter in a large bowl until light and fluffy. Add confectioners\u2019 sugar and beat until smooth."
    },
    {
      "position": 2,
      "text": "Whisk flour and cornstarch together in a separate bowl. Gradually add flour mixture to butter mixture and mix until a soft dough forms. Cover and refrigerate dough until firm, about 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 4,
      "text": "Shape dough into 1-inch balls and place about 1 1/2 inches apart on ungreased baking sheets. Flatten each ball slightly with a lightly floured fork. Flatten with lightly floured fork."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the edges are lightly browned, about 18 to 20 minutes. Let cookies cool on the baking sheets for 5 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

  "id": "dc51e878-cf08-5b8d-a9da-aa28ac723cf4",
  "slug": "good-for-you-greek-salad",
  "name": "Easy Greek Salad",
  "recipe_type": "salad",
  "brief_description": "This Greek cucumber salad with juicy tomatoes is sprinkled with olive oil and lemon juice, then topped with feta cheese for fantastic flavor in every bite.",
  "cuisine": "U.S. Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Toss tomatoes, cucumbers, and red onion together in a shallow salad bowl."
    },
    {
      "position": 3,
      "text": "Drizzle oil and lemon juice over top, then sprinkle with oregano, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Top with feta and olives. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

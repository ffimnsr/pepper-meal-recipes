  "id": "cba94e5b-c35d-54c9-ae6a-e668d81cb5bf",
  "slug": "macaroni-salad-with-pickles",
  "name": "Macaroni Salad with Pickles",
  "recipe_type": "salad",
  "brief_description": "You can double or triple this recipe and make enough for a crowd of hungry friends. The creamy mayonnaise dressing has sour cream, sweet pickle juice and mustard stirred in.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Cook macaroni pasta in a large pot of boiling water until al dente. Drain, rinse with cold water, and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, place eggs in a saucepan and cover with cold water by 1 inch. Bring to a boil. Cover, remove from heat, and let stand for 20 minutes. Transfer eggs to an ice water bath. Peel and chop when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, sour cream, mustard, sweet pickle juice, and celery seed together in a medium bowl. Season with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Combine macaroni, celery, onion, olives, sweet pickles, carrots, green bell pepper, and eggs in a large bowl. Stir in dressing until evenly coated. Cover and refrigerate until chilled before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

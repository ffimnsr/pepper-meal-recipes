  "id": "f1fa67af-1735-5965-b32b-f6f1e9110d0f",
  "slug": "easy-million-dollar-mac-and-cheese-recipe-11827696",
  "name": "Easy Million Dollar Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This easy million dollar mac and cheese is super cheesy, with crumbled bacon, green onions, and a buttery, crunchy panko-Parmesan topping. Using refrigerated prepared mac and cheese saves both prep time and cleanup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Add macaroni and cheese, shredded cheese, bacon, green onions, and cayenne pepper to a bowl and stir until well combined. Transfer mixture to a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, prepare the topping: add panko, Parmesan, almonds, butter, and salt to a bowl and stir until well combined."
    },
    {
      "position": 4,
      "text": "Top mac and cheese with breadcrumb topping and return to the oven. Bake until lightly browned and bubbly around the edges, about 15 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,

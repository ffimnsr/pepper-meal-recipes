  "id": "c6578574-09cd-5e1e-ae7e-912594c9a5ae",
  "slug": "sweet-cornbread-cake",
  "name": "Sweet Cornbread Cake",
  "recipe_type": "dessert",
  "brief_description": "This sweet, moist cornbread is made with cornmeal, honey, eggs, melted butter, and whole milk; simply irresistible served hot from the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Stir flour, sugar, cornmeal, baking powder, and salt together in a mixing bowl. Pour in milk, beaten eggs, vegetable oil, melted butter, and honey; stir just to moisten."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted in the center comes out clean, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f8379d80-bb49-5b0f-b1da-39c372314e2e",
  "slug": "veggie-pot-pie",
  "name": "Veggie Pot Pie",
  "recipe_type": "main",
  "brief_description": "This pot pie is vegetarian. Potatoes, mushrooms, cauliflower, green beans, and carrots are cooked in a savory sauce, then baked a flaky pie crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet or saucepan. Add mushrooms, onions, and garlic; cook for 3 to 5 minutes, stirring frequently. Stir in carrots, potatoes, and celery. Stir in cauliflower and green beans; add vegetable broth and bring to a boil. Reduce heat and simmer until vegetables are just tender, about 5 minutes. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Mix water, cornstarch, and soy sauce in a small bowl until cornstarch is completely dissolved; stir into vegetables and cook until sauce thickens, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Roll out 1/2 of the dough to line an 11x7-inch baking dish. Pour vegetable filling into the pastry-lined dish. Roll out remaining dough; arrange over filling, then seal and flute the edges."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until pie is golden brown on top, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "pineapple-jalapeno-margarita-recipe-11747484",
  "name": "Pineapple Jalape\u00f1o Margarita",
  "recipe_type": "dessert",
  "brief_description": "Spicy but sweet. This pineapple jalape\u00f1o margarita has the best of both worlds!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pineapple and jalapeno slices in a cocktail shaker and muddle. Pour in tequila, pineapple juice, lime juice, and orange juice. Fill with ice and shake until well combined. Set aside."
    },
    {
      "position": 2,
      "text": "Place tajin on a plate. Rub one side of glass with lime slice and roll in tajin. Strain margarita into the prepared glass and garnish with pineapple slice and jalapeno slice if desired."
    }
  ],

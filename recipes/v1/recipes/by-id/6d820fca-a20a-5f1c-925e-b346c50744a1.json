  "id": "6d820fca-a20a-5f1c-925e-b346c50744a1",
  "slug": "blueberry-pie",
  "name": "Homemade Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This blueberry pie has a juicy filling made with fresh blueberries and a gorgeous lattice pastry crust for a sweet summer dessert that's hard to beat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C) with oven rack in lowest position."
    },
    {
      "position": 2,
      "text": "Combine sugar, cornstarch, cinnamon, and salt in a bowl; sprinkle over blueberries in a separate bowl."
    },
    {
      "position": 3,
      "text": "Line a 9-inch pie plate with 1 pie crust. Pour berry mixture into crust; dot with butter. Cut remaining pie crust into \u00bd- to \u00be-inch-wide strips. Moisten the rim of the pie with a small amount of water. Start with the longest strips and lay the first 2 in an X in the center of the pie. Alternate horizontal and vertical strips, weaving them in an over-and-under pattern. Use the shortest strips for the edges of the lattice. Fold the ends of the lattice strips under the edge of the bottom crust and flute the crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven on the lowest oven rack until filling is bubbling and crust is golden brown, about 50 minutes."
    },
    {
      "position": 5,
      "text": "Cut into slices and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

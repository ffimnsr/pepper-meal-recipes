{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9c44bde7-6635-5e12-89c5-ad71c929ce90",
  "slug": "beef-stroganoff-casserole",
  "name": "Beef Stroganoff Casserole",
  "recipe_type": "soup",
  "brief_description": "Whip up this baked beef stroganoff casserole with leftover beef roast, broth, and sweet onion, topped with horseradish sour cream and dill.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain and return to the pot."
    },
    {
      "position": 3,
      "text": "Remove beef roast from the package and place in a bowl, reserving juices. Shred into bite-size pieces using 2 forks."
    },
    {
      "position": 4,
      "text": "Melt butter in a large skillet over medium heat. Add mushrooms, onion, and garlic; cook and stir until tender, 4 to 5 minutes. Stir in flour and tomato paste until combined. Stir in reserved meat juices, broth, Worcestershire sauce, paprika, salt, and pepper. Cook and stir until thickened and bubbly, 6 to 8 minutes. Remove from heat and stir in 1/2 cup sour cream."
    },
    {
      "position": 5,
      "text": "Stir shredded beef and mushroom mixture into the pot of cooked pasta. Spoon mixture into a 9x13-inch baking dish. Cover with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until heated through, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Combine remaining sour cream and horseradish in a small bowl. Add dill. Spoon on top of the casserole."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

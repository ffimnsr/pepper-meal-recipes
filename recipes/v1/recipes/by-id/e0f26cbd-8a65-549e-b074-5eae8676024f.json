  "slug": "portuguese-coconut-cakes-bolos-de-coco",
  "name": "Portuguese Coconut Cakes (Bolos de Coco)",
  "recipe_type": "dessert",
  "brief_description": "These mini flourless Portuguese coconut cakes have the chewy texture of macaroons and come together in minutes, using only 4 ingredients.",
  "cuisine": "Portuguese",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 3 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Mix coconut, sugar, eggs, and lemon zest together in a large bowl. Scoop coconut mixture into lined muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until firm and golden, 15 to 20 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "6cc02588-82e6-559f-b838-8470474a043d",
  "slug": "chocolate-french-toast",
  "name": "Chocolate French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Adding cocoa powder to the basic French toast egg mixture turns the classic French toast into something chocolatey and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat together milk, eggs, sugar, cocoa powder, baking powder, and salt."
    },
    {
      "position": 2,
      "text": "Heat a lightly buttered skillet or griddle over medium heat."
    },
    {
      "position": 3,
      "text": "Dip each slice of bread into egg mixture until well soaked, about 20 seconds per side. Place in pan, and cook on both sides until they are no longer gooey or shiny in the middle when cut in half, about 3 to 4 minutes per side."
    }
  ],
  "servings": 8,

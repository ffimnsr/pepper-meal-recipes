  "id": "e75665ce-b44b-57e6-9cd9-b8e53fddcb80",
  "slug": "coconut-macaroons-iv",
  "name": "Coconut Macaroons IV",
  "recipe_type": "dessert",
  "brief_description": "This is a recipe my aunt made in the 30's. A meringue cookie with coconut and cornflake cereal. I could never eat enough of them.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a large glass or metal bowl, whip egg whites to stiff peaks. Stir in white sugar. Fold in coconut and cornflakes. Drop by teaspoonfuls onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 18 minutes in the preheated oven, or until coconut is golden."
    }
  ],
  "servings": 30,

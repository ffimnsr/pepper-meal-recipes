  "slug": "apple-orchard-punch",
  "name": "Apple Orchard Punch",
  "recipe_type": "drink",
  "brief_description": "This apple orchard punch recipe is alcohol-free and combines apple, cranberry, and orange juices with ginger ale for a perfect drink for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apple juice, cranberry juice concentrate, and orange juice. Stir until dissolved; slowly add ginger ale."
    },
    {
      "position": 2,
      "text": "Thinly slice apple horizontally. Float slices on top of punch."
    }
  ],
  "servings": 12,

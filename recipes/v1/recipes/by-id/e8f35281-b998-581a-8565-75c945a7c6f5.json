  "id": "e8f35281-b998-581a-8565-75c945a7c6f5",
  "slug": "the-ultimate-chili",
  "name": "The Ultimate Chili",
  "recipe_type": "soup",
  "brief_description": "Red wine in chili adds intense flavor! This chili is big on taste with beef, beans, veggies, and spices, and the wine really kicks it up a notch.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir ground beef in a large skillet over medium-high heat until evenly browned, 5 to 7 minutes. Drain off grease, then season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Transfer beef to a slow cooker. Add kidney beans, tomatoes, celery, bell pepper, and vinegar. Season with chili powder, cumin, parsley, basil, and Worcestershire sauce. Stir to distribute ingredients evenly."
    },
    {
      "position": 3,
      "text": "Cook on Low for 8 hours or High for 6 hours. Pour in wine during the last 2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 365,
  "preparation_time_minutes": 15,

  "id": "f2c4a5fe-d4bc-5541-bdf0-b10c2a541ed2",
  "slug": "orange-cream-fudge",
  "name": "Orange Cream Fudge",
  "recipe_type": "dessert",
  "brief_description": "This simple recipe combines cream, butter, marshmallow creme, white chocolate and orange extract to make this classic favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch dish."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, and cream in a medium saucepan over medium heat. Cook to soft-ball stage, 234 degrees F (112 degrees C). Remove from the heat and stir in white chocolate chips and marshmallow creme until smooth. Reserve 1 cup marshmallow mixture."
    },
    {
      "position": 3,
      "text": "Add orange extract and yellow and red food coloring to remaining marshmallow mixture in the saucepan. Stir until well combined, then pour into the prepared dish."
    },
    {
      "position": 4,
      "text": "Pour reserved marshmallow mixture on top. Using a knife, swirl layers for decorative effect."
    },
    {
      "position": 5,
      "text": "Chill in the refrigerator until firm, about 2 hours. Cut into squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

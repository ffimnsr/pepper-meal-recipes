  "id": "9640f66f-2ae3-55a7-853f-395ee3c304ad",
  "slug": "wacky-cake-viii",
  "name": "Wacky Cake",
  "recipe_type": "dessert",
  "brief_description": "Wacky cake is a delicious chocolate cake, created during the Depression, that's easy to make in one pan using simple ingredients and no milk or eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift flour, sugar, cocoa powder, baking soda, and salt together in an 8x8-inch ungreased cake pan. Make 3 depressions in flour mixture; pour oil into one well, vinegar into second, and vanilla into third well. Pour water over all, then stir with a fork until well blended."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

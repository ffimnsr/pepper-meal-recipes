  "id": "38d38516-7901-526d-8bd5-016cdb0c6c28",
  "slug": "easy-steak-and-shrimp-fajitas",
  "name": "Easy Steak and Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "A package of marinated skirt steak speeds up the prep work with these fajitas. Add shrimp, bell peppers, and onion and throw everything on the grill for a quick and easy dinner.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Add skirt steak to the hot grill and cook for 3 minutes per side. Remove steak from the grill and allow to rest for 10 minutes. Skewer shrimp, and cook for 1 minute per side. Remove from the grill."
    },
    {
      "position": 3,
      "text": "Cut onion into 1/2-inch-thick layers, keeping the rings together. Place onion layers and bell peppers onto the grill and allow to to char slightly, about 2 minutes per side. Remove onions and peppers and roughly chop. Wrap tortillas in foil and warm on the grill, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Slice steak into strips and remove shrimp from the skewers. Assemble fajitas with steak, shrimp, onion, and bell peppers."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

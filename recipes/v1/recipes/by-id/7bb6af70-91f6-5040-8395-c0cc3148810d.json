  "id": "7bb6af70-91f6-5040-8395-c0cc3148810d",
  "slug": "ellens-chicken-cacciatore",
  "name": "Ellen\u2019s Chicken Cacciatore",
  "recipe_type": "main",
  "brief_description": "Tender chicken thigh meat simmers in a savory tomato sauce for an Italian-inspired meal that\u2019s ready in just over an hour but tastes like it cooked for hours.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Cook chicken thighs in hot oil until browned, about 5 minutes per side. Remove chicken to a plate and set aside."
    },
    {
      "position": 2,
      "text": "Cook and stir onion and mushrooms in the same skillet until mushrooms have softened, about 10 minutes. Stir in garlic and cook until fragrant, 1 to 2 more minutes."
    },
    {
      "position": 3,
      "text": "Pour in tomatoes with juice, white wine, orange juice, rosemary, salt, and black pepper; stir until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Return chicken and any accumulated juices to the skillet. Cover the skillet and bring to a boil. Reduce heat to medium-low and simmer until chicken is tender and no longer pink on the inside, 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

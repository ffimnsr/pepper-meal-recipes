  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bcfb6ed1-32af-59f4-a7a3-ea51becc47e5",
  "slug": "crustless-zucchini-corn-quiche-recipe-11815928",
  "name": "Crustless Zucchini Corn Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This crustless zucchini corn quiche recipe makes is easy to add some veggies to breakfast or brunch. Corn and zucchini, with a little help from onion and red bell pepper, make a delicious combination.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) and grease a 9-inch pie pan with unsalted butter."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a non-stick skillet over medium heat. When the butter bubbles, add onion and cook, stirring occasionally, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir in zucchini and corn kernels, lightly season skillet contents with salt and pepper, and cook until vegetables are tender crisp, 3 to 5 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "In a large mixing bowl, whisk eggs with cream, salt, pepper, and cayenne until well mixed. Stir in cheese, fresh chopped spinach, and skillet contents."
    },
    {
      "position": 5,
      "text": "Pour egg mixture into the prepared pan, and place red bell pepper rings on top, pressing down into the quiche until the tops of the rings are even with the egg mixture."
    },
    {
      "position": 6,
      "text": "Bake in the center of the preheated oven until lightly browned, and a knife inserted into the center comes out clean, 25 to 30 minutes. Cool on a rack for 5 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with fresh parsley sprigs, and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "41681840-5ce1-5c5b-9496-5401cd05b5ba",
  "slug": "chocolate-cherry-upside-down-cake",
  "name": "Chocolate Cherry Upside Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This is an old favorite from my recipe box that I have had for 25 years that 's non-dairy and egg free!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread pie filling evenly in the bottom of a greased 9x13 inch pan."
    },
    {
      "position": 2,
      "text": "In a large bowl stir together flour, sugar, cocoa, baking soda, and salt."
    },
    {
      "position": 3,
      "text": "In another bowl combine water, oil, vinegar, and vanilla. Add these liquid ingredients to the flour mixture all at once. Stir until just moistened. Pour the batter evenly over the cherry pie filling."
    },
    {
      "position": 4,
      "text": "Bake in a preheated 350 degrees F ( 175 degrees C) oven for 30 to 35 minutes."
    },
    {
      "position": 5,
      "text": "Let cake cool for 10 minutes in pan then invert cake onto a serving dish and continue to cool."
    }
  ],
  "servings": 24,

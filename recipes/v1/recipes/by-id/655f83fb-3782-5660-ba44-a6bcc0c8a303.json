  "id": "655f83fb-3782-5660-ba44-a6bcc0c8a303",
  "slug": "make-ahead-breakfast-bars",
  "name": "Make-Ahead Breakfast Bars",
  "recipe_type": "breakfast",
  "brief_description": "The easiest breakfast to make ahead, these savory 'bars' are packed with enough hash browns, eggs, ham, and Cheddar-Jack cheese to power your morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x11-inch casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix hash browns, eggs, ham, Cheddar-Jack cheese, onion powder, salt, and pepper together. Pour mixture into the prepared dish. Shake dish gently from side to side to level out ingredients."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, in the preheated oven until top starts to brown, about 40 minutes. Cool before cutting into bars."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

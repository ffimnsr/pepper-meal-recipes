  "id": "8b47e51a-0c47-5e7b-8749-0fb262e48d26",
  "slug": "honey-glazed-corn-casserole-recipe-11834936",
  "name": "Honey-Glazed Corn Casserole",
  "recipe_type": "dessert",
  "brief_description": "This honey-glazed corn casserole gives a classic an appealing twist, with a touch of honey that complements the sweet-savory flavor of corn. For a variation, stir in a drained, small can of green chiles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a baking dish with butter or nonstick spray, and set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine corn, creamed corn, sour cream, Cheddar cheese, honey, butter, and red bell pepper, stirring until well combined."
    },
    {
      "position": 3,
      "text": "Whisk cornmeal, baking powder, garlic powder, salt, and pepper together in a separate bowl. Gradually add cornmeal mixture to corn mixture, stirring until combined. Add the eggs, stirring gently, until just incorporated into a batter. Pour batter into the prepared casserole dish, spreading out evenly."
    },
    {
      "position": 4,
      "text": "Bake the casserole in the preheated oven until the top is golden brown, 35 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Allow the casserole to cool for about 5 minutes. Drizzle honey on top if desired for extra sweetness, garnish with parsley, and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

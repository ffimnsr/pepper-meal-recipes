  "id": "02d245af-e27e-53cd-b61d-e4c66918b3b3",
  "slug": "sarahs-rice-pilaf",
  "name": "Sarah's Rice Pilaf",
  "recipe_type": "soup",
  "brief_description": "This rice pilaf brings together nutty orzo pasta, aromatic onion and garlic, and chicken broth for super flavor. An easy, delicious, any-time side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-low heat. Add orzo; cook and stir until orzo is golden brown."
    },
    {
      "position": 3,
      "text": "Stir in onion and cook until onion becomes translucent."
    },
    {
      "position": 4,
      "text": "Add garlic and cook for 1 minute. Stir in rice and chicken broth, turn heat to high, and bring to a boil."
    },
    {
      "position": 5,
      "text": "Reduce heat to medium-low, cover the skillet, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the heat and let stand, covered, for 5 minutes. Fluff with a fork before serving."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

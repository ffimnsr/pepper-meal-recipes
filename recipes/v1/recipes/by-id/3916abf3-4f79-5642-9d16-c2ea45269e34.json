  "id": "3916abf3-4f79-5642-9d16-c2ea45269e34",
  "slug": "almond-flour-waffles",
  "name": "Almond Flour Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These waffles made with almond flour, eggs, and honey turn out rich and fluffy. Try topping them with yogurt and fresh fruit for a gluten-free brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to the manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Combine almond flour, baking soda, and salt in a large bowl. Whisk eggs, honey, and vanilla together in a separate bowl. Stir flour mixture into egg mixture until smooth."
    },
    {
      "position": 3,
      "text": "Spray the preheated waffle iron with cooking spray. Spoon batter onto waffle iron; cook until golden brown and the iron stops steaming, about 5 minutes. Repeat with remaining batter. Serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

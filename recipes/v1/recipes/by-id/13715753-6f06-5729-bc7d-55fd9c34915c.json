  "id": "13715753-6f06-5729-bc7d-55fd9c34915c",
  "slug": "lemon-raspberry-crumb-bars",
  "name": "Lemon Raspberry Crumb Bars",
  "recipe_type": "dessert",
  "brief_description": "This lemon-raspberry crumb bar recipe, with an in-your-face lemon flavor, is quick-to-make anytime. Choose to add a crumb topping for added texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9-inch square pan with enough parchment paper to hang over on all sides."
    },
    {
      "position": 2,
      "text": "Combine 1 \u00bd cups flour, confectioners' sugar, and \u00bc teaspoon salt in a large bowl; cut in butter until mixture resembles coarse crumbs. Reserve \u00bd cup crumb mixture; set aside for topping. Press remaining crumb mixture firmly and evenly into bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine white sugar, eggs, lemon zest, lemon juice, 2 tablespoons flour, baking powder, and remaining \u00bc teaspoon salt in a large bowl."
    },
    {
      "position": 5,
      "text": "Scatter raspberries evenly over crust; evenly pour lemon filling over raspberries, then randomly sprinkle reserved \u00bd cup crumb mixture over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bars are set, 20 to 25 minutes. Cool bars completely in the pan, 30 to 45 minutes, then remove from the pan using the parchment overhang and cut into 9 bars."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

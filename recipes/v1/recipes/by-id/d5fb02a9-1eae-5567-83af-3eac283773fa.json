  "id": "d5fb02a9-1eae-5567-83af-3eac283773fa",
  "slug": "jewish-coffee-cake",
  "name": "Jewish Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "A moist sour cream coffee cake. This is a great recipe from an old friend.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x9 inch pan. Combine the flour, baking soda and baking powder; set aside."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together the sugar, butter and eggs until smooth. Add the flour mixture and beat until smooth. Finally, stir in the sour cream and vanilla. In a separate bowl, combine the nuts, confectioners' sugar and cinnamon."
    },
    {
      "position": 3,
      "text": "Spread half of the batter into the 9x9 inch pan. Sprinkle a layer of the nut mixture, then spread the remaining batter and top with the rest of the nut mixture. Spread the melted butter over the top."
    },
    {
      "position": 4,
      "text": "Bake for 1 hour in the preheated oven, until cake springs back to the touch."
    }
  ],
  "servings": 12,

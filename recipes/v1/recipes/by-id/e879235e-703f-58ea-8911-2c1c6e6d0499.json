  "id": "e879235e-703f-58ea-8911-2c1c6e6d0499",
  "slug": "deviled-egg-pickle-boats-recipe-11954055",
  "name": "Deviled Egg Pickle Boats",
  "recipe_type": "salad",
  "brief_description": "These deviled egg pickle boats, a deviled egg salad stuffed into dill pickles, are a great twist on the old favorite. The stuffed pickle is sure to become a new thing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together cream cheese and mayonnaise until well blended. Add mustard, dill, onion powder, hot sauce, salt and pepper and mix until combined. Grate or finely chop hard boiled eggs and stir them in. Refrigerate mixture for at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Cut each pickle in half lengthwise and scoop out some of the center and discard (you can chop and stir 1 tablespoon chopped pickle into the egg salad if desired)."
    },
    {
      "position": 3,
      "text": "Divide egg mixture among pickle halves and top each pickle evenly with crushed onions. Sprinkle with paprika and serve immediately or refrigerate until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

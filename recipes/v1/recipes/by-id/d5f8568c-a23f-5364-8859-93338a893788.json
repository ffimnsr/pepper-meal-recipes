  "id": "d5f8568c-a23f-5364-8859-93338a893788",
  "slug": "amazing-no-cook-spinach-artichoke-dip",
  "name": "Amazing No Cook Spinach Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "A no-cook version of artichoke dip is quick and easy to prepare with a food processor. Combine a sweet onion, canned artichoke hearts, spinach, and sour cream for a creamy and flavorful dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend onion and garlic in a food processor until finely chopped. Add artichoke hearts; process until chopped. Add spinach, Parmesan cheese, and vegetable soup mix; process until well incorporated. Transfer mixture to a nonmetallic bowl."
    },
    {
      "position": 2,
      "text": "Blend cream cheese, mayonnaise, and sour cream in the food processor until smooth; stir into artichoke mixture."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

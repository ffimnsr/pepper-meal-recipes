  "id": "1a09312f-ae87-5163-9554-7560c0aa2a45",
  "slug": "buffalo-chicken-and-roasted-potato-casserole",
  "name": "Buffalo Chicken and Roasted Potato Casserole",
  "recipe_type": "main",
  "brief_description": "This buffalo chicken casserole with plenty of spicy flavors mimics the taste of Buffalo chicken wings and baked potatoes for a favorite combination.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Heat hot pepper sauce, olive oil, garlic powder, black pepper, paprika, and salt in a large skillet over low heat, stirring until thoroughly combined. Turn off heat."
    },
    {
      "position": 4,
      "text": "Toss potatoes in batches with the hot pepper sauce mixture to coat and use a slotted spoon to transfer potatoes to the prepared baking dish. Leave remaining sauce in the skillet."
    },
    {
      "position": 5,
      "text": "Mix chicken into remaining sauce and allow to marinate while potatoes roast."
    },
    {
      "position": 6,
      "text": "Bake potatoes until tender inside and crisp and brown outside, 45 to 50 minutes, stirring every 10 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Reduce oven heat to 400 degrees F (205 degrees C)."
    },
    {
      "position": 8,
      "text": "Spread chicken cubes over roasted potatoes."
    },
    {
      "position": 9,
      "text": "Sprinkle shredded cheese, cooked bacon, and green onions over chicken. Return to the oven."
    },
    {
      "position": 10,
      "text": "Bake in oven until chicken is cooked through and the cheese topping is bubbling, about 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "1c7b6aaa-7800-564d-9bb1-f149a7d3e5c6",
  "slug": "fluffy-gluten-free-pancakes",
  "name": "Fluffy Gluten-Free Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy gluten-free pancakes are lightly flavored with cinnamon and vanilla for a soft, tender texture. Perfect with syrup and fresh fruit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, salt, cinnamon, and sugar together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Whisk egg, melted butter, vanilla, and milk together in a separate bowl until smooth."
    },
    {
      "position": 4,
      "text": "Add wet ingredients to dry ingredients; stir just until combined (batter should be slightly lumpy). Let batter rest 5 to 10 minutes to thicken. If the batter seems too thick to pour, add 1 to 2 tablespoons more milk."
    },
    {
      "position": 5,
      "text": "Spray a griddle with cooking spray and preheat over medium-low heat."
    },
    {
      "position": 6,
      "text": "Pour about \u00bc cup batter per pancake onto the preheated griddle. Cook until bubbles form on top and edges look set, 2 to 3 minutes. Flip and cook until golden on the second side, 1 to 2 minutes more. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "772d3020-e124-5e64-8cc6-b30d1c58bde0",
  "slug": "instant-pot-beef-stew-with-red-wine",
  "name": "Instant Pot Beef Stew with Red Wine",
  "recipe_type": "soup",
  "brief_description": "Let your Instant Pot deliver this winning family recipe for beef stew starring red wine, rosemary, potatoes, and tons more vegetables.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, Italian seasoning, onion powder, salt, and pepper in a gallon-sized resealable plastic bag. Shake to mix seasoning. Add beef to bag, seal, and shake to coat."
    },
    {
      "position": 2,
      "text": "Select Sear function on a multi-functional electric pressure cooker (such as Instant Pot) according to manufacturer's instructions. Add coated beef cubes and sear until lightly browned on all sides, 7 to 10 minutes. Pour in broth and red wine. Add tomato paste and garlic. Stir in potatoes, onion, carrots, celery, rosemary, and bay leaf."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select Stew setting and set timer for 25 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Serve alongside beef stew."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,

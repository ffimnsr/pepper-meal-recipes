  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3e0f6d5e-d1a4-5ba3-ad94-9a364fe7072e",
  "slug": "sweet-potato-cauliflower-shepherds-pie",
  "name": "Sweet Potato-Cauliflower Shepherd's Pie",
  "recipe_type": "dessert",
  "brief_description": "Shepherd's pie gets lightened up with a savory crust of mashed sweet potatoes and cauliflower covering a more traditional beef filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place sweet potatoes in a pot and add water to cover. Bring to a boil and cook for 15 minutes. Add cauliflower and more water if needed; cook until all vegetables are tender, about 15 minutes more. Drain. Mash sweet potatoes and cauliflower with 1/4 cup broth, butter, 1 teaspoon salt, and 1/2 teaspoon black pepper."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add carrots and onion; saute until softened, about 5 minutes. Add garlic, 1 teaspoon salt, and 1/2 teaspoon black pepper; cook 5 minutes more. Add beef; cook and stir until browned and crumbly, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle tapioca starch over the beef mixture in the skillet. Add 1 cup broth, peas, corn, and tomato paste. Bring to a boil. Reduce heat and simmer for 10 to 15 minutes. Spread beef mixture evenly in a baking dish. Top with mashed sweet potato mixture. Sprinkle Parmesan cheese on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until slightly browned on top, about 25 minutes. Let stand 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

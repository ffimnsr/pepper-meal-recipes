  "id": "0a6663e9-6508-5077-aa74-087ca6519546",
  "slug": "asian-style-ground-beef-cabbage-wraps",
  "name": "Asian-Style Ground Beef Cabbage Wraps",
  "recipe_type": "main",
  "brief_description": "These cabbage wraps filled with ground beef and vegetables are flavored with a gingery chile-garlic sauce. Easy to customize and so delicious!",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook ground beef in the hot skillet, breaking up any large clumps, until browned and crumbly, about 5 minutes. Add mushrooms and onion; cook and stir until vegetables soften, about 4 minutes."
    },
    {
      "position": 2,
      "text": "Add coconut aminos, Sriracha sauce, ginger, garlic, and vinegar. Cook, stirring occasionally, until most of the liquid has evaporated, about 10 minutes. Remove from heat and stir in sesame oil. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Evenly divide mixture among 8 cabbage leaves; sprinkle carrots and onions on top. Sprinkle green onions, cilantro, sesame seeds, and red pepper flakes on top. Roll each cabbage leaf over and around filling to form a packet."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

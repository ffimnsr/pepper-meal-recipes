  "id": "999617f5-27d9-50f3-ac07-d11352607701",
  "slug": "coconut-fudge",
  "name": "Coconut Fudge",
  "recipe_type": "dessert",
  "brief_description": "Sweetened condensed milk and coconut cream are the key ingredients in this creamy and sweet coconut fudge that is always a hit.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking dish with aluminum foil."
    },
    {
      "position": 2,
      "text": "Mix sugar, sweetened condensed milk, coconut cream, and butter together in a pot; bring to a simmer until temperature of milk mixture reaches 225 degrees F (110 degrees C), about 30 minutes."
    },
    {
      "position": 3,
      "text": "Stir coconut extract, ginger, vanilla extract, and bitters into milk mixture; continue simmering until temperature reaches 236 degrees F (113 degrees C), about 10 minutes. Remove pot from heat and let fudge stand for 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour fudge into the prepared baking dish; refrigerate until set, about 2 hours."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

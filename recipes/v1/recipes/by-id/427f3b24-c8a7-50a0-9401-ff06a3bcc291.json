  "id": "427f3b24-c8a7-50a0-9401-ff06a3bcc291",
  "slug": "greek-lemon-cake",
  "name": "Greek Lemon Cake",
  "recipe_type": "dessert",
  "brief_description": "This Greek lemon cake with whole milk yogurt is made with citrus zest, juice, and butter for a tender, delicious tube cake full of bright flavor.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease one 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda, and salt together in a medium bowl. Set mixture aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, beat egg whites until soft peaks form. Gradually add 1/2 cup sugar, beating until stiff glossy peaks form. Set aside."
    },
    {
      "position": 4,
      "text": "Beat butter and remaining 1 1/2 cups sugar in another large bowl with an electric mixer until fluffy, 3 to 5 minutes. The mixture should be noticeably lighter in color."
    },
    {
      "position": 5,
      "text": "Blend in egg yolks, lemon zest, and lemon juice. Add flour mixture alternately with yogurt, mixing until combined. Gently fold in beaten egg whites and pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes. Let cake cool in the pan for 10 minutes, then turn out onto a wire rack to finish cooling."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "32af673a-6c14-5611-b4ef-f39451f9ae8e",
  "slug": "pecan-pie-bars-i",
  "name": "Pecan Pie Bars",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie bars recipe is simpler to make than pecan pie for a sweet and crunchy, crowd-pleasing, handheld treat, perfect for any cookie platter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 10x15-inch jellyroll pan, or line with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, 1/2 cup sugar, and salt in a large bowl. Cut in 1 cup butter until mixture resembles coarse crumbs. Sprinkle mixture evenly over the prepared pan; press firmly to form a crust. Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix corn syrup, 1 \u00bd cups sugar, eggs, 3 tablespoons melted butter, and vanilla extract together in a large bowl until smooth. Stir in pecans; spread filling evenly over hot crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is set, about 25 minutes. Allow to cool completely in the pan on a wire rack before slicing into bars."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

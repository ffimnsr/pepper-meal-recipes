  "id": "7ea70fd3-72ed-5682-aa1a-0358ea596ed8",
  "slug": "cowboy-coleslaw-recipe-8653154",
  "name": "Cowboy Coleslaw",
  "recipe_type": "salad",
  "brief_description": "Inspired by the popular Cowboy Caviar dip, this tangy, spicy coleslaw combines corn, black beans, and other fresh veggies in a crisp and creamy coleslaw recipe. It\u2019s loaded with texture and flavor and it\u2019s ready in just 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Toss coleslaw mix, black beans, corn, red bell pepper, cilantro, and jalape\u00f1o together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, sour cream, lime juice, adobo sauce, taco seasoning, salt, and cumin together in a medium bowl until smooth."
    },
    {
      "position": 4,
      "text": "Pour dressing over the coleslaw mixture and toss until evenly coated."
    },
    {
      "position": 5,
      "text": "Garnish with scallions and serve with lime wedges. Serve immediately, or cover and refrigerate for up to 12 hours before serving. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

  "id": "10bc9427-a8da-5f45-b1f4-7c4d5a8f0efe",
  "slug": "homemade-egg-noodles",
  "name": "Homemade Egg Noodles",
  "recipe_type": "soup",
  "brief_description": "These egg noodles must be allowed to dry for a couple of hours before boiling in chicken broth. Serve alone, or in place of mashed potatoes with a turkey dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sift together the flour, salt and baking powder. Add egg yolks and mix until dry ingredients are moistened."
    },
    {
      "position": 2,
      "text": "Press into a ball and cut in quarters. Roll out on floured surface 1/8 to 1/4 inch thick; cut to desired width and length. Lay on linen dish towel or wooden dowel to dry."
    },
    {
      "position": 3,
      "text": "Add to broth such as chicken or turkey and cook until done."
    }
  ],
  "servings": 4,

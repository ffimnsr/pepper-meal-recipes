  "id": "aae205e2-ac77-5df7-bcef-2c097267b51f",
  "slug": "dairy-free-savory-sausage-gravy",
  "name": "Dairy-Free Savory Sausage Gravy",
  "recipe_type": "breakfast",
  "brief_description": "This dairy-free sausage gravy uses almond milk to create a smooth, rich gravy that's simple and easy to customize. Perfect for biscuits and gravy.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Break sausage apart in a large skillet over medium-high heat. Cook until starting to brown, 3 to 5 minutes. Add Worcestershire sauce and let it heat up before adding beef bouillon and nutmeg. Stir and cook sausage until no longer pink, 3 to 5 minutes more."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low and sprinkle in flour gradually. Cook, stirring constantly, until flour coats sausage and is completely absorbed. Cook for 1 to 2 minutes more."
    },
    {
      "position": 3,
      "text": "Pour in almond milk gradually, stirring constantly until gravy starts to thicken, up to 12 minutes. Add a little more almond milk if too thick. Season with pepper and salt. Continue stirring vigorously until gravy reaches desired thickness."
    },
    {
      "position": 4,
      "text": "Remove from heat and let cool. Taste and adjust seasoning as desired."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

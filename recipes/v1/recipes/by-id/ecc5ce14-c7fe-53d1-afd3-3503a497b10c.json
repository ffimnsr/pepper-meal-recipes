  "slug": "dirty-martini",
  "name": "Dirty Martini",
  "recipe_type": "drink",
  "brief_description": "A dirty martini is the perfect cocktail for olive lovers. It's made with vodka, vermouth, olive brine, and stuffed olives. Serve up or on the rocks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together vodka, dry vermouth, brine, and olives in a mixing glass. Pour into a glass or shaker with ice."
    },
    {
      "position": 3,
      "text": "Serve on the rocks, or strain into chilled cocktail glasses."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

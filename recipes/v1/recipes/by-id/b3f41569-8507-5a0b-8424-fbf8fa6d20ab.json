  "id": "b3f41569-8507-5a0b-8424-fbf8fa6d20ab",
  "slug": "plum-cobbler-recipe-6576991",
  "name": "Plum Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This plum cobbler is made with fresh plums and an easy baking mix shortcake topping; serve fresh from the oven with cream for a comforting dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir plums, 1 cup sugar, water, tapioca, and cinnamon together in a 2-quart baking dish; bake in preheated oven for 25 minutes. Remove from oven and set aside."
    },
    {
      "position": 3,
      "text": "Increase oven temperature to 450 degrees F (230 degrees C). Stir baking mix, 3 tablespoons sugar, milk, and melted butter together in a medium bowl to form a biscuit dough."
    },
    {
      "position": 4,
      "text": "Drop dough by spoonfuls onto pre-baked plum mixture."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until golden brown on top, about 10 minutes. Let cool slightly before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

  "id": "d95dadb8-69a7-55dc-997c-6afc03e31823",
  "slug": "creamy-peanut-butter-fudge",
  "name": "Creamy Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Make this creamy peanut butter fudge with sugar, evaporated milk, peanut butter, and a jar of marshmallow cream. It's melt-in-your-mouth delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine white sugar, evaporated milk, brown sugar, and butter in a medium saucepan over medium heat. Stir constantly until it comes to a boil. Boil for 7 minutes."
    },
    {
      "position": 3,
      "text": "Remove from the heat and stir in marshmallow cream until well incorporated and melted."
    },
    {
      "position": 4,
      "text": "Stir in peanut butter and vanilla until smooth."
    },
    {
      "position": 5,
      "text": "Spread in the prepared pan. Let cool for 30 minutes before cutting into 24 squares."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

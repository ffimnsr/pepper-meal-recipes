  "slug": "pepita-pesto",
  "name": "Pepita Pesto",
  "recipe_type": "drink",
  "brief_description": "A mild vegan pesto made with pepitas, parsley, basil, lemon juice, garlic, and lots of extra virgin olive oil. Tastes great on pasta or bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine parsley, pepitas, basil, lemon juice, water, and garlic salt in the bowl of a food processor; pulse until blended into a coarse meal. Pour olive oil in slowly and pulse a few times until pesto has come together."
    }
  ],
  "servings": 4,

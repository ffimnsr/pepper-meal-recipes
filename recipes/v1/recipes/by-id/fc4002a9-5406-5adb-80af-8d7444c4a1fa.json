  "id": "fc4002a9-5406-5adb-80af-8d7444c4a1fa",
  "slug": "chef-johns-peach-cobbler",
  "name": "Chef John\u2019s Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This fabulous peach cobbler works just as well with canned peaches!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine peaches, Chinese five-spice powder, and lemon zest in a bowl."
    },
    {
      "position": 3,
      "text": "Stir sugar and water together in saucepan pan over medium heat until simmering, 2 to 3 minutes. Stir in peach mixture; cook and stir for 2 minutes. Remove from heat and set aside."
    },
    {
      "position": 4,
      "text": "Combine sugar and self-rising flour in a large bowl. Pour in milk; whisk to form a smooth batter."
    },
    {
      "position": 5,
      "text": "Pour melted butter into a Dutch oven. Pour batter over the melted butter."
    },
    {
      "position": 6,
      "text": "Gently place peaches and syrup on top of batter. As the cobbler bakes, they will sink down into the batter."
    },
    {
      "position": 7,
      "text": "Bake until syrup is bubbling and crust has risen and is golden brown, about 50 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "07d26c75-024b-565a-9f8c-ff1dfe28dd2d",
  "slug": "crab-stuffed-deviled-eggs",
  "name": "Crab-Stuffed Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Simple deviled eggs get an elegant upgrade with a stuffing and topping featuring fresh crabmeat for an elegant twist on the classic party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place 6 eggs in the bottom of a pan and fill with cold water to cover. Place pan over high heat and as soon as the water starts to bubble and simmer and the eggs begin to dance around, turn off the heat, cover quickly with a tight-fitting lid, and let eggs sit for 17 minutes."
    },
    {
      "position": 3,
      "text": "Drain hot water from pan and add cold water to cover eggs, rolling them around in the pan. Drain and refill with fresh cold water; let eggs sit until cool, about 20 minutes. Peel eggs under running water to remove shells and cut in half lengthwise."
    },
    {
      "position": 4,
      "text": "Separate yolks from egg halves; place yolks into a mixing bowl."
    },
    {
      "position": 5,
      "text": "Place crab meat onto a plate and separate into 2 equal portions, one containing the small bits and one containing the attractive larger pink chunks. Reserve portion containing larger chunks."
    },
    {
      "position": 6,
      "text": "Chop the portion of crab meat with the smaller chunks; add to egg yolks. Mash yolks with a fork. Stir in mayonnaise, tarragon, Dijon mustard, lemon juice, hot pepper sauce, seafood seasoning, Worcestershire sauce, salt, and black pepper."
    },
    {
      "position": 7,
      "text": "Transfer yolk mixture into a piping bag fitted with a medium tip. Pipe crab filling into cavities of egg halves."
    },
    {
      "position": 8,
      "text": "Chop largest crab pieces and place remaining crabmeat into a small bowl. Lightly stir in lemon zest, creme fraiche, Aleppo pepper, and cayenne pepper with a fork. Taste and adjust salt. If mixture seems dry, stir in more creme fraiche."
    },
    {
      "position": 9,
      "text": "Top each stuffed egg with a generous pinch of crab mixture."
    },
    {
      "position": 10,
      "text": "Sprinkle each deviled egg with a pinch of chives and a light dusting of cayenne pepper. Transfer eggs to a serving platter; refrigerate until serving time."
    },
    {
      "position": 11,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 12,

  "id": "4e951d7c-85f5-5719-8a98-e7dfcfda332c",
  "slug": "chewy-strawberry-sugar-cookies",
  "name": "Fresh Strawberry Cookies",
  "recipe_type": "dessert",
  "brief_description": "These strawberry cookies are easy to make with a traditional sugar cookie dough and fresh strawberry puree for a chewy, fruity, and delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat 1 \u00bd cups white sugar and butter together in a bowl with an electric mixer until creamy, about 3 minutes. Beat egg into butter mixture. Add strawberry puree."
    },
    {
      "position": 3,
      "text": "Stir flour, vanilla extract, baking powder, and salt into strawberry mixture with a spoon until flour is completely incorporated into dough."
    },
    {
      "position": 4,
      "text": "Stir 1/2 cup white sugar and red sugar together in a shallow bowl."
    },
    {
      "position": 5,
      "text": "Roll dough into walnut-sized balls, roll each ball in red sugar mixture, and place each ball 1 \u00bd inches apart onto prepared baking sheets. Lightly press each dough ball down to flatten."
    },
    {
      "position": 6,
      "text": "Bake cookies in the preheated oven until lightly browned, 10 to 15 minutes. Cool cookies on a wire rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

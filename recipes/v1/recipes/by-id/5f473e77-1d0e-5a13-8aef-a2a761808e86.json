  "slug": "million-dollar-chunk-chicken-salad-recipe-11999981",
  "name": "Million Dollar Chunk Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This million dollar chunk chicken salad, made with chunk chicken, Cheddar cheese, and bacon is easy to put together and really tasty. Enjoy it on lettuce leaves, in a sandwich, or just on its own.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir chicken, mayonnaise, celery, Cheddar, green onions, and Dijon mustard in a bowl. Season with cayenne pepper, salt, and black pepper."
    },
    {
      "position": 2,
      "text": "Serve on lettuce leaves or on its own. Sprinkle each serving with crumbled bacon."
    }
  ],
  "servings": 2,

  "id": "6830b990-6b56-510e-a809-5421fd44c6de",
  "slug": "italian-stuffed-bread",
  "name": "Italian Stuffed Bread",
  "recipe_type": "main",
  "brief_description": "Bread dough stuffed with layers of mortadella, capicola ham, Genoa salami, and provolone cheese bakes up into a hearty Italian main dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place dough in a large bowl. Cover with plastic wrap and let rise in a warm place until doubled in size, 45 minutes to 1 hour."
    },
    {
      "position": 2,
      "text": "Roll dough into a 17x20-inch rectangle about 1/4-inch thick on a large piece of parchment paper. Brush olive oil over dough; sprinkle basil and oregano on top. Layer mortadella, provolone cheese, capicola ham, Genoa salami, tomatoes, and mushrooms over dough."
    },
    {
      "position": 3,
      "text": "Roll dough lengthwise into a log. Brush the top with beaten egg; sprinkle sesame seeds on top. Transfer to a baking sheet. Cover with plastic wrap and let rise until puffy, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 45 minutes. Let cool for 5 minutes before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

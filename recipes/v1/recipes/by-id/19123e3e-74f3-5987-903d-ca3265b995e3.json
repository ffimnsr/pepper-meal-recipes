  "slug": "copycat-chipotle-honey-vinaigrette-recipe-8658747",
  "name": "This Copycat Chipotle Honey Vinaigrette Tastes Just Like the Real Thing",
  "recipe_type": "salad",
  "brief_description": "Get the recipe to recreate Chipotle's fan-favorite Honey Vinaigrette dressing at home.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "In a blender, combine chipotles and adobo, garlic, oregano, honey, red wine vinegar, and cumin. Blend until smooth, then slowly drizzle in oil with the blender running to emulsify."
    },
    {
      "position": 3,
      "text": "Season to taste with salt and pepper and transfer to a sealable jar."
    }
  ],

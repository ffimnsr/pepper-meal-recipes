  "slug": "pork-chops-for-the-slow-cooker",
  "name": "Pork Chops for the Slow Cooker",
  "recipe_type": "main",
  "brief_description": "These slow cooker pork chops are tender, spicy and delicious \u2014 and easy with this method. A perfect weeknight meal that everyone will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place pork chops in a slow cooker."
    },
    {
      "position": 3,
      "text": "Combine soy sauce, ketchup, brown sugar, garlic, and ginger, and pour over pork chops."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 6 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,

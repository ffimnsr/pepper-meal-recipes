  "schema_version": 1,
  "id": "8259f8d2-e776-54b7-bb7c-80bf6390de79",
  "slug": "chicken-piccata-meatloaf-recipe-11914241",
  "name": "Chicken Piccata Meatloaf",
  "recipe_type": "drink",
  "brief_description": "This chicken piccata meatloaf, with capers, Parmesan cheese, and lemon juice, is glazed with a lemon-garlic Parmesan mayonnaise. Serve it drizzled with a simmered lemon-garlic pan sauce and a sprinkle of chopped parsley.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly spray an 8x4-inch loaf pan with cooking spray."
    },
    {
      "position": 2,
      "text": "For meatloaf, stir together chicken, breadcrumbs, shallot, Parmesan cheese, mayonnaise, egg, parsley, capers, salt, pepper, and garlic powder in a large bowl until just combined. Transfer mixture to the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, in the preheated oven for 40 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, for glaze, stir together mayonnaise, Parmesan cheese, lemon juice, and garlic powder in a small bowl."
    },
    {
      "position": 5,
      "text": "Remove loaf from the oven and spread mayonnaise mixture over the top. Return to the oven and bake until an instant-read thermometer inserted into the thickest portion of loaf reads 165 degrees F (73 degrees C), 10 to 15 minutes more."
    },
    {
      "position": 6,
      "text": "Remove loaf from the oven, and let it rest 10 minutes."
    },
    {
      "position": 7,
      "text": "While loaf is resting, prepare the sauce. Heat oil in a large deep skillet over medium-high heat. Add shallot, capers, and garlic to the skillet and cook, stirring constantly, for 1 minute. Pour in wine and stock and bring to a boil. Reduce heat to medium-low; simmer until liquid is reduced by half, stirring occasionally, 6 to 7 minutes."
    },
    {
      "position": 8,
      "text": "Whisk lemon juice into reduced sauce. Add cold butter, and stir constantly until well incorporated and slightly thickened. Remove from heat."
    },
    {
      "position": 9,
      "text": "Slice meatloaf and drizzle generously with sauce to serve. Garnish with chopped parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 10,

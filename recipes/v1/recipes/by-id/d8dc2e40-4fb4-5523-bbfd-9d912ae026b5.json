  "id": "d8dc2e40-4fb4-5523-bbfd-9d912ae026b5",
  "slug": "chicken-alfredo-monkey-bread-recipe-11917581",
  "name": "Chicken Alfredo Monkey Bread",
  "recipe_type": "appetizer",
  "brief_description": "This chicken Alfredo monkey bread is a hearty, savory twist on the pull-apart favorite, with chicken, cheese, and Alfredo sauce inside each bite. Topped with more warm Alfredo sauce, it's comforting, rich, tasty, and most of all, fun.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Generously grease a Bundt pan or loaf pan with cooking spray. Roll out pizza dough slightly and cut into 24 squares."
    },
    {
      "position": 2,
      "text": "Add chicken to a bowl and stir in 1 cup Alfredo sauce."
    },
    {
      "position": 3,
      "text": "Place about 2 teaspoons chicken mixture and 2 teaspoons cheese in each square. Wrap edges around filling and pinch to seal, then shape them into a ball."
    },
    {
      "position": 4,
      "text": "Stir together melted butter, Italian seasoning, and garlic powder in a small bowl. Brush the butter mixture evenly over each dough ball."
    },
    {
      "position": 5,
      "text": "Sprinkle 1 tablespoon Parmesan cheese in the bottom of the prepared pan and top with half the balls. Sprinkle with remaining Parmesan cheese and top with remaining filled dough balls."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes. Let stand in the pan 5 to 10 minutes before carefully loosening bread from the edges and bottom with a small spoon or offset spatula."
    },
    {
      "position": 7,
      "text": "Meanwhile heat remaining alfredo sauce on the stove or in the microwave. Invert the monkey bread onto a serving platter and top with warm Alfredo sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

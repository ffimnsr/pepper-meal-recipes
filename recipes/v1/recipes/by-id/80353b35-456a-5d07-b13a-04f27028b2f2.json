  "id": "80353b35-456a-5d07-b13a-04f27028b2f2",
  "slug": "char-siu-chinese-bbq-pork",
  "name": "Char Siu (Chinese BBQ Pork)",
  "recipe_type": "main",
  "brief_description": "Chinese char sui pork is easy to make at home on your grill with pork tenderloin and a rich and sticky Cantonese marinade that also acts as a glaze.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir soy sauce, honey, ketchup, brown sugar, rice wine, hoisin sauce, red bean curd, and five-spice powder together in a saucepan over medium-low heat. Cook and stir until just combined and slightly warm, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, slice each pork tenderloin lengthwise into 1 \u00bd- to 2-inch-thick strips. Place pork strips in a large, resealable plastic bag."
    },
    {
      "position": 4,
      "text": "Pour marinade into the bag with the pork. Squeeze air from the bag, seal, and turn the bag a few times until pork is well coated. Marinate in the refrigerator, 2 hours to overnight."
    },
    {
      "position": 5,
      "text": "When ready to cook, preheat a charcoal grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 6,
      "text": "Remove pork from marinade and shake to remove excess liquid. Set aside the remaining marinade for basting."
    },
    {
      "position": 7,
      "text": "Rake the hot coals into two equal piles on opposite sides of the charcoal grate. Add a small container of water to the grate. Place pork strips in the center of the grate for indirect cooking."
    },
    {
      "position": 8,
      "text": "Cook pork over indirect heat, turning regularly and basting as desired, until an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), 30 minutes or longer."
    },
    {
      "position": 9,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

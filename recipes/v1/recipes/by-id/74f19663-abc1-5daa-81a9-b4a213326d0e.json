  "id": "74f19663-abc1-5daa-81a9-b4a213326d0e",
  "slug": "seared-ahi-tuna-steaks",
  "name": "Seared Ahi Tuna Steaks",
  "recipe_type": "main",
  "brief_description": "Try this simple ahi tuna steak recipe for elegant slices of seared tuna that rival what you'd get at a fine restaurant.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Pat tuna steaks dry and season on both sides with salt and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-high heat."
    },
    {
      "position": 3,
      "text": "Add olive oil and pepper corns; cook until peppercorns soften and pop, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Gently place seasoned tuna in the skillet and cook to desired doneness, anywhere from 30 seconds to 1 1/2 minutes per side."
    },
    {
      "position": 5,
      "text": "Slice tuna into 1/4-inch thick slices to serve."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

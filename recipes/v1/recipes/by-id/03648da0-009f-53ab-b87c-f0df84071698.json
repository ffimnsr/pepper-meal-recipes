  "id": "03648da0-009f-53ab-b87c-f0df84071698",
  "slug": "luvanns-guacamole",
  "name": "LuvAnn's Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This homemade guacamole recipe made with ripe avocados, zesty jalape\u00f1os, fresh cilantro, and tart lime juice is great served with tortilla chips or tacos.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocados in a medium bowl until desired consistency is reached. Stir in salt. Mix in tomato, onion, jalape\u00f1o peppers, lime juice, and cilantro until combined."
    },
    {
      "position": 2,
      "text": "Cover and chill in the refrigerator for at least 30 minutes before serving."
    }
  ],
  "servings": 16,

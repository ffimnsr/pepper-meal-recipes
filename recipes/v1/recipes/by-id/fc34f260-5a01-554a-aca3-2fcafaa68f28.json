  "id": "fc34f260-5a01-554a-aca3-2fcafaa68f28",
  "slug": "bumbleberry-pie-i",
  "name": "Bumbleberry Pie I",
  "recipe_type": "dessert",
  "brief_description": "If you love apple, raspberry, blackberry, and rhubarb pies, then you're in for a real treat. This pie combines them all!",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir sugar and flour together in large bowl. Add apples, raspberries, blackberries, and rhubarb. Toss together, and turn into pie shell. Cover with pastry top. Trim and seal edges. Cut vents in top."
    },
    {
      "position": 3,
      "text": "Bake at 350 degree F (175 degrees C) for approximately 45 minutes, until crust is brown and apple is cooked."
    }
  ],
  "servings": 8,

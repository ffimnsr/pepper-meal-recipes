  "id": "197f81f0-9088-5469-b6f4-b0d2a6b77006",
  "slug": "peanut-butter-fudge-with-evaporated-milk",
  "name": "Peanut Butter Fudge with Evaporated Milk",
  "recipe_type": "dessert",
  "brief_description": "This smooth and creamy fudge only uses 5 ingredients--peanut butter, evaporated milk, marshmallow cream, butter, and powdered sugar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium-high heat. Add evaporated milk and sugar. Bring to a rapid boil. Stir and boil for 7 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat. Add peanut butter and marshmallow cream and stir until completely blended. Pour into the prepared pan and refrigerate until set, 1 to 2 hours. Cut into squares."
    }
  ],

  "id": "37785c31-3cc3-5770-b396-09e0726330b1",
  "slug": "tuna-noodle-casserole-with-potato-chips",
  "name": "Tuna Noodle Casserole with Potato Chips",
  "recipe_type": "soup",
  "brief_description": "There's nothing like a warm and comforting casserole to soothe an edgy day. Combine egg noodles with a rich blend of cream of mushroom soup, evaporated milk, canned tuna, American cheese and chopped onion. Bake with a crust of potato chips and paprika.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot with boiling salted water cook egg noodles until al dente. Drain."
    },
    {
      "position": 2,
      "text": "In a large bowl combine the cooked egg noodles, cream of mushroom soup, evaporated milk, tuna, grated American cheese, and chopped onion. Pour into a greased 1.5 quart casserole dish. Sprinkle the top with the crumbled potato chips and the paprika."
    },
    {
      "position": 3,
      "text": "Bake in a preheated 425 degree F (220 degree C) oven for 15 to 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": null,

  "id": "cf6bd416-7ec7-507a-9e34-0c9653841240",
  "slug": "hatch-chile-turkey-panini",
  "name": "Hatch Chile Turkey Panini",
  "recipe_type": "main",
  "brief_description": "Hatch chile-infused turkey and cheese meld with spinach and red onions in this easy panini topped with blistered shishito peppers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Layer your ingredients as follows: bread, spinach, Dietz & Watson Hatch Chile Cheese, Dietz & Watson Hatch Turkey, red onion, and bread."
    },
    {
      "position": 2,
      "text": "Place the panini on a panini press for 5 minutes."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Grill the shishito peppers until blistered, 1 to 2 minutes per side."
    },
    {
      "position": 4,
      "text": "Plate the panini with the peppers."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

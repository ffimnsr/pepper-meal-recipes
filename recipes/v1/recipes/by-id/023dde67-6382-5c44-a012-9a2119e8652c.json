  "id": "023dde67-6382-5c44-a012-9a2119e8652c",
  "slug": "spam-fried-rice",
  "name": "Spam Fried Rice",
  "recipe_type": "main",
  "brief_description": "For this Spam fried rice recipe, use up pantry ingredients like Spam by stir-frying it with veggies, eggs, and leftover rice in this satisfying dish.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat; add Spam. Cook until lightly browned, 5 to 7 minutes; transfer to a plate."
    },
    {
      "position": 2,
      "text": "Heat sesame oil in the same skillet until shimmering, about 1 minute. Add onion; saut\u00e9 until slightly softened, about 5 minutes. Reduce heat; add rice and frozen vegetables; cook and stir until heated through, about 5 minutes. Push rice mixture to edges of skillet; add 4 beaten eggs to center. Cook and stir until curds form, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Stir \u00bd Spam into scrambled eggs, then stir into rice mixture to combine. Add soy sauce and Sriracha; stir, then remove from heat."
    },
    {
      "position": 4,
      "text": "Crack remaining 4 eggs into a separate skillet over medium heat. Cook until outer edges become opaque, about 1 minute. Cover, reduce heat to low, and cook until whites are completely set, about 4 minutes; season with salt and black pepper."
    },
    {
      "position": 5,
      "text": "Place fried eggs on top of fried rice; add remaining \u00bd Spam. Garnish with nori, scallions, and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

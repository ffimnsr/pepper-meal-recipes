  "id": "05939369-8898-5e68-bed0-7893f0d5b5bf",
  "slug": "healthier-double-tomato-bruschetta",
  "name": "Healthier Double Tomato Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "This bruschetta features low-fat cheese, less oil, and whole grain bread. Bursting with flavor from sun-dried tomatoes, balsamic vinegar, and basil, you won't notice it's a healthier version of the original.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven on broiler setting. Arrange the artisan bread slices in a single layer on a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine the roma tomatoes, sun-dried tomatoes, garlic, olive oil, vinegar, basil, salt, and pepper in a large bowl. Allow the mixture to sit for 10 minutes."
    },
    {
      "position": 3,
      "text": "Broil the bread until slightly brown, about 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Divide the tomato mixture evenly over the bread slices. Top the slices with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Return the baking sheet to the oven and broil until the cheese is melted, about 1 to 2 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

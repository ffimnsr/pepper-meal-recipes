  "id": "83bd8967-a385-5e9e-bfd9-6d66a37eb4a4",
  "slug": "edamame-hummus-with-garlic-scapes",
  "name": "Edamame Hummus with Garlic Scapes",
  "recipe_type": "appetizer",
  "brief_description": "This edamame hummus with garlic scapes recipe is an inventive, delicious version of hummus made with edamame, cashews, and fresh garden garlic scapes.",
  "cuisine": "American Asian Fusion Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 6 cups water to a boil in a large saucepan. Add edamame; cook until soft, 4 to 5 minutes. Drain; refrigerate to cool, 10 minutes."
    },
    {
      "position": 2,
      "text": "Combine cashews and 1 teaspoon salt in the bowl of a food processor; pulse until finely chopped, scraping the sides of bowl as needed."
    },
    {
      "position": 3,
      "text": "Add edamame, garlic scapes, lemon zest, lemon juice, remaining 2 teaspoons salt, 1 teaspoon black pepper, and coriander; pulse until reaches desired consistency."
    },
    {
      "position": 4,
      "text": "Pour \u00be cup oil in slowly with processor running until hummus is smooth; season with oil, salt, and black pepper."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "4acf28fa-aaee-5063-9872-4a01dcac646b",
  "slug": "spicy-flat-iron-steak-rub",
  "name": "Spicy Flat Iron Steak Rub",
  "recipe_type": "main",
  "brief_description": "Add zesty flavors to basic steak with this spicy rub combining brown sugar, onion powder, garlic powder, and a variety of hot chile powders.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix the brown sugar, garlic powder, onion powder, chili powder, ancho chile powder, chipotle chile powder, salt-free seasoning blend, salt, and pepper together in a bowl until thoroughly blended. Sprinkle over both sides of the steak, and rub into the meat. Cover, and refrigerate at least 30 minutes, or up to 2 days."
    },
    {
      "position": 2,
      "text": "Before cooking, drizzle steak with vegetable oil, and rub the oil into the meat. Cook as desired."
    }
  ],
  "servings": 4,

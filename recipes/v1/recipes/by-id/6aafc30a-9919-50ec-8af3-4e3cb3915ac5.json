  "id": "6aafc30a-9919-50ec-8af3-4e3cb3915ac5",
  "slug": "kartoffelsuppe-nach-bayrischer-art-bavarian-potato-soup",
  "name": "Kartoffelsuppe nach Bayrischer Art (Bavarian Potato Soup)",
  "recipe_type": "soup",
  "brief_description": "Kartoffelsuppe is a classic Bavarian potato soup with pork sausage, vegetables, and fresh herbs. A hearty dinner that's perfect for a cold night!",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Place sausages in a small pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until no longer pink in the center, 10 to 15 minutes. Drain. Cut into slices."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium heat. Cook potatoes in hot oil, stirring often, until they start to crisp on the edges, about 8 minutes. Stir in carrots, onions, leek, scallions, and garlic."
    },
    {
      "position": 3,
      "text": "Dissolve vegetable bouillon in hot water; pour into the pot. Season soup with salt, black pepper, marjoram, paprika, and nutmeg. Bring to a boil; reduce heat and cook, covered, until carrots are tender, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir sausage slices, parsley, and chives into soup. Simmer until flavors combine, about 5 minutes. Stir in sour cream just before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 63,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "0d5c7840-e5fa-5553-bb4a-0bfaf0b6f875",
  "slug": "caramelized-onion-mashed-potatoes-recipe-11719106",
  "name": "Caramelized Onion Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These caramelized onion mashed potatoes are next-level. The deeply savory flavor of slowly caramelized onions adds much more than the simple ingredients would have you think.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For caramelized onions, melt butter with olive oil in a large skillet over medium-low heat. Add onions, beef broth, salt, and pepper. Cook until onions are a deep golden brown, stirring occasionally, 20 to 25 minutes. Remove from heat and set aside."
    },
    {
      "position": 2,
      "text": "Bring potatoes to a boil in a pot with enough cold, salted water to cover by an inch; cook until fork tender, about 20 minutes. Drain; return potatoes to the pot, dry potatoes in the pot over medium-high heat for about 30 seconds."
    },
    {
      "position": 3,
      "text": "Heat butter and milk together in a saucepan over medium heat until butter melts. Coarsely mash potatoes with a potato masher. Add butter mixture and mash until fluffy. Season with salt and pepper. Top mashed potatoes with caramelized onions to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

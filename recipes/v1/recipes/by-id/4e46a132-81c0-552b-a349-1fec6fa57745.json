  "id": "4e46a132-81c0-552b-a349-1fec6fa57745",
  "slug": "easy-beef-stroganoff-in-the-slow-cooker",
  "name": "Easy Beef Stroganoff in the Slow Cooker",
  "recipe_type": "soup",
  "brief_description": "Beef stroganoff is perfect for the slow cooker; this recipe uses cream of mushroom soup, fresh mushrooms, onions, and herbed cream cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beef, mushrooms, cream of mushroom soup, milk, onions, and Worcestershire sauce in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on High for 3 to 4 hours, or on Low for 5 to 7 hours. Stir in cream cheese until well dissolved; cook for 1 hour more."
    },
    {
      "position": 3,
      "text": "During the last 20 minutes of cooking, bring a large pot of lightly salted water to a boil. Add fusilli to the boiling water and cook, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Serve stroganoff over fusilli and garnish with sour cream."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 10,

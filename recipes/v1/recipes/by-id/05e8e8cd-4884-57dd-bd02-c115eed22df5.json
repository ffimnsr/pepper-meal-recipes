  "id": "05e8e8cd-4884-57dd-bd02-c115eed22df5",
  "slug": "red-curry-chicken-mini-pot-pies-recipe-11775513",
  "name": "Red Curry Chicken Mini Pot Pies",
  "recipe_type": "appetizer",
  "brief_description": "These red curry chicken mini pot pies are a spicy spin on classic chicken pot pie. Add red curry paste, then make \u2018em mini and bake up in a muffin tin!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat 8 (2 1/2-inch) muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine condensed soup, coconut milk, and curry paste in a saucepan and bring to a simmer over medium-high heat. Cook, stirring often, until curry paste is incorporated and sauce thickens slightly, about 3 minutes. Remove from heat and stir in chicken, frozen vegetables, and cilantro."
    },
    {
      "position": 3,
      "text": "On a lightly floured surface, roll each pie crust into an 11-inch circle. Cut 8 (4 inch) circles and 8 (3 inch) circles from the crusts, rerolling scraps, if needed. Press 4-inch circles into bottoms and up sides of prepared muffin cups, stretching gently to reach tops of cups."
    },
    {
      "position": 4,
      "text": "For egg wash, beat together egg and water in a small bowl."
    },
    {
      "position": 5,
      "text": "Divide filling evenly among crust-lined cups, about 1/3 cup each. Brush edges of filled crusts with egg wash; top with 3-inch crust circles, gently pressing edges to seal. Crimp edges using fork tines as desired. Cut two 1/4-inch-long slits on top of each pie using a paring knife. Lightly brush tops with egg wash."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until pies are slightly puffed and browned on top, about 20 minutes. Cool in muffin cups 10 minutes. Loosen edges with a thin spatula, then carefully remove from muffin cups. Garnish with additional cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

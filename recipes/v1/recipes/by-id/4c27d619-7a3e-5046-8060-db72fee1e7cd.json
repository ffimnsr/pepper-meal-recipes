  "id": "4c27d619-7a3e-5046-8060-db72fee1e7cd",
  "slug": "vegan-lettuce-wraps",
  "name": "Vegan Lettuce Wraps",
  "recipe_type": "appetizer",
  "brief_description": "A savory mix of tofu, shiitakes, jicama, and red pepper is spiked with sambal oelek and wrapped in lettuce leaves in this easy vegan recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix hoisin sauce, 1 teaspoon water, and 1/2 teaspoon sambal oelek together to make dipping sauce."
    },
    {
      "position": 2,
      "text": "Mix oyster sauce, 1 tablespoon water, 1/2 teaspoon sambal oelek, mushroom seasoning, sesame oil, sugar, and 1/4 teaspoon salt together in a bowl to make seasoning sauce."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Cook and stir ginger until fragrant, about 30 seconds. Add tofu, jicama, shiitake mushrooms, 1/4 teaspoon salt, and pepper; cook and stir until mushrooms are golden brown, about 5 minutes. Add red bell pepper and seasoning sauce; cook and stir until heated through, about 1 minute. Remove from heat."
    },
    {
      "position": 4,
      "text": "Place 1 to 2 tablespoons of tofu mixture in the center of each lettuce leaf. Sprinkle sesame seeds on top. Add 1 teaspoon dipping sauce; roll up lettuce to enclose tofu mixture. Repeat with remaining tofu mixture and lettuce leaves. Serve remaining dipping sauce alongside."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cf4b97ac-9727-5d00-853b-0c924aaaaf2d",
  "slug": "skillet-peach-cornbread-recipe-12020817",
  "name": "Skillet Peach Cornbread",
  "recipe_type": "dessert",
  "brief_description": "This skillet peach cornbread brings together the unexpected flavors of sweet summer peaches and smoky barbecue sauce in a savory twist on a Southern favorite. Baked upside down, the peaches caramelize into a sweet, golden topping that makes every slice irresistible.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Cut a parchment paper round to fit the bottom of a cast-iron skillet. Remove the parchment paper and set aside,"
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place the skillet in the oven while it heats."
    },
    {
      "position": 3,
      "text": "Remove the skillet carefully and place parchment round in the bottom. Add 2 tablespoons butter and barbecue sauce; swirl to coat the bottom and sides. Lay peach slices in the skillet in a single layer in any design you like. You may not need all the peach slices."
    },
    {
      "position": 4,
      "text": "Combine cornbread mix, eggs, milk, yogurt, and 1/4 cup melted butter in a bowl; fold in cheese, paprika, garlic powder, and pepper. Carefully dollop batter evenly into the hot skillet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and a toothpick comes out mostly clean, 30 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Let rest for 5 to 10 minutes, then invert onto a platter. Remove parchment paper and slice to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

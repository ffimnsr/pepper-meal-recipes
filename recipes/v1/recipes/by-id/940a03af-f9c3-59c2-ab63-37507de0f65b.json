  "id": "940a03af-f9c3-59c2-ab63-37507de0f65b",
  "slug": "parmesan-crusted-chicken-cutlets-recipe-12032742",
  "name": "Parmesan-Crusted Chicken Cutlets",
  "recipe_type": "side",
  "brief_description": "These Parmesan-crusted chicken cutlets are coated in a crispy Parmesan crust and cooked until golden brown with juicy, tender chicken inside. They come together in just 15 minutes for a quick and satisfying weeknight meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken cutlets evenly on one side with salt and pepper."
    },
    {
      "position": 2,
      "text": "Whisk eggs and water together in a shallow dish. Stir cheese and breadcrumbs together in a second shallow dish."
    },
    {
      "position": 3,
      "text": "Dip chicken in egg mixture and allow excess to drip off. Place chicken in cheese mixture and coat well on both sides, pressing coating to adhere, and lightly shake off any excess."
    },
    {
      "position": 4,
      "text": "Working in batches if necessary, heat 2 tablespoons oil in a skillet or on a griddle over medium-high heat. Add chicken and cook undisturbed until golden brown and crisp, 2 to 3 minutes. Flip and cook until browned and cooked through, about 2 minutes. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

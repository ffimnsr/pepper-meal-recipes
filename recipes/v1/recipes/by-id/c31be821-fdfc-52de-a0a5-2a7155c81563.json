  "id": "c31be821-fdfc-52de-a0a5-2a7155c81563",
  "slug": "habanero-salsa",
  "name": "Habanero Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This spicy habanero salsa recipe combines fresh chile peppers, tomatoes, garlic, lime juice, and lots of cilantro to make a fiery hot salsa.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Roast jalape\u00f1os over a grill or gas burner until completely blackened. Seal in a plastic bag or a bowl covered with plastic wrap, and allow to steam until skins are loosened. When cool, remove skin, stem, and seeds."
    },
    {
      "position": 3,
      "text": "Place jalape\u00f1os, onions, garlic, sugar, salt, and pepper into the bowl of a blender or food processor. Pulse to chop and blend, then pour into a large bowl, and mix with the can of green chiles, cilantro, and lime juice. Pulse the tomatoes in batches to desired size, and add to green chile mixture."
    },
    {
      "position": 4,
      "text": "Return one cup of chopped tomatoes to the blender along with the habanero, and puree well. Strain the puree to remove any large pieces of habanero, and add to the tomatoes. Mix well, cover, and chill in the refrigerator at least one hour to allow flavors to blend."
    }
  ],
  "servings": 80,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

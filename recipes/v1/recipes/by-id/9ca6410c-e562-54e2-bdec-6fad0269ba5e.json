  "id": "9ca6410c-e562-54e2-bdec-6fad0269ba5e",
  "slug": "instant-pot-peach-cobbler",
  "name": "Instant Pot Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Use canned peaches and your Instant Pot to make this peach cobbler even when fresh peaches are out of season.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Drain peaches and pat dry with a paper towel. Sprinkle peaches with cinnamon sugar."
    },
    {
      "position": 2,
      "text": "Mix dry cake mix with cinnamon. Cut in butter until mixture resembles coarse crumbs. Set 1/2 of the mixture aside."
    },
    {
      "position": 3,
      "text": "Mix peaches with 1/2 of the cake mix mixture; place in a 6-inch round dish. Top peaches with remaining cake mix mixture. Cover dish with foil."
    },
    {
      "position": 4,
      "text": "Pour water into a multi-functional pressure cooker (such as Instant Pot). Set trivet inside. Place round dish on top of the trivet. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 12 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 20 minutes. Unlock and remove the lid. Quick release remaining pressure using the quick-release method, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 7,
      "text": "Carefully remove dish from the pot and uncover. Broil until topping is set, about 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

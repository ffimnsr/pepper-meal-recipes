  "id": "87ccbc1e-a7f1-5c83-aba6-66c8be49c7e3",
  "slug": "easy-dog-cupcakes",
  "name": "Easy Dog Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These easy dog cupcakes provide a special treat for your pet, made with natural, wholesome ingredients they'll love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 8 cupcake cups with paper liners."
    },
    {
      "position": 2,
      "text": "Mix bran, oatmeal, and baking soda together in a bowl; add peanut butter, applesauce, egg, and honey, mixing well."
    },
    {
      "position": 3,
      "text": "Divide between prepared cupcake liners."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, about 18 minutes. Let cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

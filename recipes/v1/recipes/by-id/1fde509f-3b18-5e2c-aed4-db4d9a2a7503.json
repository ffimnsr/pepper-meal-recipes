  "id": "1fde509f-3b18-5e2c-aed4-db4d9a2a7503",
  "slug": "healthier-easy-sugar-cookies",
  "name": "Healthier Easy Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "In this healthier sugar cookie recipe, some of the butter is replaced with non-fat plain yogurt. They taste so good no one will notice!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Stir flour, baking soda, and baking powder in a small bowl."
    },
    {
      "position": 2,
      "text": "Beat butter, yogurt, and sugar with an electric mixer in a large bowl until smooth. Add egg allowing it to blend into butter mixture. Beat in vanilla extract. Mix in flour mixture until just incorporated. Roll dough into walnut-sized balls and place 2-inches apart onto ungreased baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until golden, 8 to 10 minutes. Let stand on baking sheet two minutes before removing to cool on wire racks."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

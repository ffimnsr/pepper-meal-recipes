  "id": "21b60749-ce50-5ce3-9f36-d235f21fc4eb",
  "slug": "dirt-cake-i",
  "name": "Dirt Cake",
  "recipe_type": "dessert",
  "brief_description": "This dirt cake recipe is a favorite, easy, no-bake dessert made with layers of creamy vanilla pudding and finely crushed chocolate sandwich cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Finely crush chocolate cookies in a food processor; set crumbs aside."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, butter, and confectioner's sugar in a large bowl; beat with an electric mixer until smooth."
    },
    {
      "position": 3,
      "text": "Whisk milk, whipped topping, and pudding together in a separate large bowl; fold in cream cheese mixture until well combined."
    },
    {
      "position": 4,
      "text": "Alternately layer crushed cookies and pudding mixture in a medium flower pot, starting and ending with cookies."
    },
    {
      "position": 5,
      "text": "Chill dirt cake in the refrigerator until ready to serve; garnish as desired. Enjoy!"
    }
  ],
  "servings": 10,

  "id": "b837dbfa-451b-58c7-ab2f-97c14959e064",
  "slug": "tex-mex-beef-and-cheese-enchiladas",
  "name": "Tex-Mex Beef and Cheese Enchiladas",
  "recipe_type": "main",
  "brief_description": "Tortillas filled with American cheese are covered with a spicy meat sauce for these tasty enchiladas. Growing up in South Texas, this dish was a staple!",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat ground beef in a large skillet over medium heat. Cook, stirring to crumble, until no longer pink. Drain off grease and season with chili powder, paprika, cumin, garlic powder, and salt. Mix in tomato sauce and 2 cups water. Simmer over low heat."
    },
    {
      "position": 3,
      "text": "Mix remaining water with flour and sugar until flour is dissolved; stir into the simmering meat sauce. Simmer until thickened, about 10 minutes."
    },
    {
      "position": 4,
      "text": "While the sauce is cooking, heat oil in another skillet over medium-high heat. Warm tortillas in hot oil until pliable. Fill each tortilla with a little bit of cheese, and place in a 9x13-inch baking dish, reserving some of the cheese to sprinkle on top. Pour meat sauce evenly over the rolled tortillas. Top with remaining cheese."
    },
    {
      "position": 5,
      "text": "Bake for 25 minutes in the preheated oven, until cheese is melted and lightly browned."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

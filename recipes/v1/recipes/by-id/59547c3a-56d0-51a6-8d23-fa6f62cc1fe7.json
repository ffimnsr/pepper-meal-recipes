  "id": "59547c3a-56d0-51a6-8d23-fa6f62cc1fe7",
  "slug": "zucchini-carrot-bread",
  "name": "Zucchini Carrot Bread",
  "recipe_type": "dessert",
  "brief_description": "This zucchini carrot bread recipe makes a lighter version of a classic zucchini quick bread because it's made with unsweetened applesauce instead of oil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat two 9x5-inch loaf pans with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk flour, cinnamon, salt, baking soda, baking powder, nutmeg, and allspice together in a large bowl until well combined. Beat sugar, applesauce, and eggs together in a separate bowl with an electric mixer until thoroughly combined. Stir in flour mixture until just combined; fold in zucchini and carrots. Divide batter between the prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "slug": "fiesta-slow-cooker-shredded-chicken-tacos",
  "name": "Slow Cooker Chicken Tacos",
  "recipe_type": "soup",
  "brief_description": "These slow cooker chicken tacos are incredibly easy to make with chicken breasts, taco seasoning, and broth for tender and delicious shredded chicken.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chicken broth and taco seasoning mix in a bowl."
    },
    {
      "position": 3,
      "text": "Place chicken in a slow cooker. Pour chicken broth mixture over chicken."
    },
    {
      "position": 4,
      "text": "Cover slow cooker. Cook on Low for 6 to 8 hours. Shred chicken with two forks."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,

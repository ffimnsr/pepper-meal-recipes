  "id": "c88fccd6-58f8-54cc-b880-3a2fa82f0ca9",
  "slug": "no-sweat-mojito",
  "name": "No-Sweat Mojito",
  "recipe_type": "drink",
  "brief_description": "Mix up these no-sweat mojitos for two in just 5 minutes \u2014 the perfect refreshment for summer sipping!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Muddle 4 mint sprigs and sugar together in a mixing glass until crushed."
    },
    {
      "position": 2,
      "text": "Add rum and stir to dissolve sugar. Strain into 2 ice-filled Collins or rocks glasses. Top with lime-flavored seltzer and garnish each glass with a remaining mint sprig."
    }
  ],
  "servings": 2,

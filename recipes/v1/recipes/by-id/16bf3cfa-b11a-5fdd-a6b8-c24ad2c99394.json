  "id": "16bf3cfa-b11a-5fdd-a6b8-c24ad2c99394",
  "slug": "daniel-fast-peanut-butter-balls",
  "name": "Daniel Fast Peanut Butter Balls",
  "recipe_type": "appetizer",
  "brief_description": "These Daniel Fast peanut butter balls made with oats, raisins, and flaked coconut are great little energy snacks that satisfy you any time of the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine brown rice syrup and coconut oil in a saucepan over medium heat; cook and stir until melted and boiling, 3 to 4 minutes. Remove from the heat."
    },
    {
      "position": 2,
      "text": "Add peanut butter and vanilla to the syrup mixture and stir until smooth. Stir in oats, raisins, and coconut until well combined. Refrigerate mixture until cool, at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Form cooled mixture into balls. Freeze balls until set, at least 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

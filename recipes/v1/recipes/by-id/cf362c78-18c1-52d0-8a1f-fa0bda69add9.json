  "id": "cf362c78-18c1-52d0-8a1f-fa0bda69add9",
  "slug": "oven-baked-pulled-ham-recipe-8629515",
  "name": "Oven Baked Pulled Ham",
  "recipe_type": "dessert",
  "brief_description": "Oven baked pulled ham cooks low and slow, and then shreds easily for sandwiches. Sweet, spicy barbecue sauce and BBQ rub provide plenty of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Stir mustard and liquid smoke together in a small bowl. Rub mustard mixture evenly over ham and sprinkle barbecue rub all over. Place ham in a large disposable pan or large deep pan lined with foil; pour cola into pan and cover with foil."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven for 2 hours."
    },
    {
      "position": 3,
      "text": "Remove pan from oven. Increase oven temperature to 300 degrees F (150 degrees C). Stir barbecue sauce and apricot preserves together in a bowl; pour mixture over ham and spread evenly. Cover with foil."
    },
    {
      "position": 4,
      "text": "Bake until a meat thermometer or instant-read thermometer inserted into the center of ham reads 205 degrees F (96 degrees C), 5 to 6 hours. Let stand until ham is cool enough to handle, 10 to 15 minutes. Shred ham with 2 forks and toss with pan drippings."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 420,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

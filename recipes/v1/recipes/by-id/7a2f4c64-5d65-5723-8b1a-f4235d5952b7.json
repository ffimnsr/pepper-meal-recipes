  "id": "7a2f4c64-5d65-5723-8b1a-f4235d5952b7",
  "slug": "whole-wheat-coconut-oil-waffles",
  "name": "Whole Wheat Coconut Oil Waffles",
  "recipe_type": "breakfast",
  "brief_description": "This whole wheat waffle recipe includes coconut oil, a healthy fat, and whole wheat flour, a healthy grain. The waffles freeze well, making breakfast easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to the manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, and salt together in a bowl; make a well in the center."
    },
    {
      "position": 3,
      "text": "Beat milk, coconut oil, egg, and vanilla extract together in another bowl. Pour into well in flour mixture; stir until batter is just combined."
    },
    {
      "position": 4,
      "text": "Ladle batter onto the preheated waffle iron; cook until golden and crisp, 2 to 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

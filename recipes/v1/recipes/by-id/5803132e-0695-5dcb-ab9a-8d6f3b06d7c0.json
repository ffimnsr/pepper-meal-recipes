  "id": "5803132e-0695-5dcb-ab9a-8d6f3b06d7c0",
  "slug": "soft-chewy-rosh-hashanah-honey-walnut-cookies",
  "name": "Soft, Chewy Rosh Hashanah Honey-Walnut Cookies",
  "recipe_type": "dessert",
  "brief_description": "Moist, soft, and chewy cookies flavored with honey, walnuts, cinnamon, brown sugar, and vanilla. This recipe is perfect for Rosh Hashanah or any time.",
  "cuisine": "Jewish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, baking soda, salt, and cinnamon together in a bowl; stir in walnuts."
    },
    {
      "position": 2,
      "text": "Beat butter and brown sugar together in a separate large bowl with an electric mixer until fluffy; stir in honey, egg, and vanilla extract until thoroughly combined. Stir flour mixture into honey mixture just until well combined (don't overmix). Chill dough, 1 hour to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease baking sheets or line with parchment paper."
    },
    {
      "position": 4,
      "text": "Scoop about 1 tablespoon dough; roll into a ball and place onto a prepared baking sheet. Repeat with remaining dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until just puffy (or a little bit flat in the middle for a gooey texture), 8 to 10 minutes. Cool on baking sheets about 5 minutes before removing to wire racks to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "906326b8-ad34-522d-a07a-5e4b807432b8",
  "slug": "healthy-sloppy-joes-with-lentils",
  "name": "Healthy Sloppy Joes with Lentils",
  "recipe_type": "main",
  "brief_description": "This skinny version of Sloppy Joes ups the nutrition ante by swapping the meat for lentils, and adding in extra veggies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large skillet over medium heat. Add onion, carrot, bell pepper, and garlic. Cook, stirring frequently, until vegetables are softened, 7 to 9 minutes. Season with chili powder, cumin, paprika, onion powder, garlic powder, and black pepper. Cook and stir for 30 seconds. Mix in tomato paste, and cook another 60 seconds, stirring constantly."
    },
    {
      "position": 2,
      "text": "Add water, diced tomatoes, and lentils, stirring to combine. Bring mixture to a gentle simmer, cover, reduce heat to low, and cook until lentils are tender, but not falling apart, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Mix in molasses, Worcestershire sauce, mustard, vinegar, and salt. Cook, uncovered, an additional 10 minutes, or until mixture has thickened slightly. Taste, and adjust seasonings as needed. Allow to cool 5 minutes before serving on buns with desired toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

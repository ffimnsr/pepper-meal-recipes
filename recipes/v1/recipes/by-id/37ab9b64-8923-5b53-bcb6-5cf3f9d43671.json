  "id": "37ab9b64-8923-5b53-bcb6-5cf3f9d43671",
  "slug": "maris-banana-cupcakes",
  "name": "Mari's Banana Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Bananas and buttermilk are folded into cupcake batter creating a moist and fluffy treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Grease 14 muffin cups."
    },
    {
      "position": 2,
      "text": "Lightly beat bananas and white sugar together in a bowl until smooth; add eggs, one at a time, until incorporated. Beat in vegetable oil until well blended, 1 to 2 minutes. Stir in flour, baking soda, and buttermilk; mix well. Fold in pecans. Pour batter into the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a cupcake comes out clean, 20 to 30 minutes. Sprinkle cupcakes with confectioners' sugar."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

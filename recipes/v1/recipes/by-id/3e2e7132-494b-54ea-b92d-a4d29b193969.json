  "id": "3e2e7132-494b-54ea-b92d-a4d29b193969",
  "slug": "sheet-pan-paella-recipe-12034787",
  "name": "Sheet Pan Paella",
  "recipe_type": "main",
  "brief_description": "This Sheet Pan Paella proves you don\u2019t need a paella pan\u2014or a lot of effort\u2014to make restaurant-worthy paella at home. The oven toasts the rice for that signature nutty flavor, then veggies, smoky chorizo, and seafood roast together on the same pan for an impressive, flavor-packed meal any night of the week.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees Fahrenheit (180 degrees C). Coat a 13x18-inch rimmed sheet pan with 2 tablespoons olive oil. Heat baking sheet in the oven for 5 minutes."
    },
    {
      "position": 2,
      "text": "Carefully remove pan from the oven using oven mitts. Spread rice on the pan in an even layer. Return to the oven and bake until lightly toasted, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine broth, onion, 1/2 teaspoon smoked paprika, 1/4 teaspoon salt, and the saffron in a bowl. Pour broth mixture over rice in the pan. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake until rice is almost tender, about 20 minutes. Remove pan from oven and discard foil. Increase oven temperature to 425 degrees Fahrenheit (220 degrees C)."
    },
    {
      "position": 5,
      "text": "Combine shrimp with remaining 1 tablespoon olive oil and 1/4 teaspoon each smoked paprika and salt in a bowl; toss to combine."
    },
    {
      "position": 6,
      "text": "To the rice mixture, add tomatoes, chorizo, peas, roasted red pepper, and olives; stir to combine. Top with shrimp and mussels. Bake, uncovered, until rice is tender, shrimp are opaque, and mussels have opened (discard any mussels that do not open), 10 to 12 minutes. Garnish with parsley and serve with lemon wedges and additional olive oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

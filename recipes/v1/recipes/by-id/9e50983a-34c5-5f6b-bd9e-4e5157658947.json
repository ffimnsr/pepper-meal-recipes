  "id": "9e50983a-34c5-5f6b-bd9e-4e5157658947",
  "slug": "fat-petes-fudge",
  "name": "Fat Pete's Fudge",
  "recipe_type": "dessert",
  "brief_description": "A decadent treat made with a smooth blend of milk chocolate, marshmallow cream, and swirls of peanut butter in every bite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking pan. Set aside."
    },
    {
      "position": 2,
      "text": "Bring butter, sugar, and evaporated milk to a boil in a saucepan over medium heat. Boil for 5 to 7 minutes, then remove from heat and quickly stir in the marshmallow cream, chocolate candy, and chocolate chips, until the chocolate has melted and is fully incorporated. Pour chocolate mixture into the prepared baking pan. Dot the top of the fudge with peanut butter. Swirl a knife through the fudge and peanut butter to create a marble effect. Cover and refrigerate until firm, about 1 hour. Cut into squares for serving."
    }
  ],
  "servings": 72,

  "id": "abda3b1f-4d99-5257-8f95-045ab424344f",
  "slug": "brees-chicken-salad",
  "name": "Chicken Salad with Grapes",
  "recipe_type": "salad",
  "brief_description": "This chicken salad with grapes is a quick, easy, and delicious filling for croissants or any bread. A simple treat for outdoor picnics or summer lunch!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Break chicken breast chunks into small pieces in a large bowl. Mix in grapes, celery, and onion. Season with dill, salt, and pepper."
    },
    {
      "position": 2,
      "text": "Whisk together mayonnaise, sugar, and vinegar in a small bowl until sugar dissolves. Pour dressing over chicken mixture; mix until well combined. Cover and refrigerate for 30 minutes before spreading salad onto croissants to make sandwiches."
    }
  ],

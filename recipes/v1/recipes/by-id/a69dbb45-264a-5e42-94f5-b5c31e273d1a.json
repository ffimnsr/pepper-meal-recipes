  "id": "a69dbb45-264a-5e42-94f5-b5c31e273d1a",
  "slug": "classic-cheese-fondue",
  "name": "Classic Cheese Fondue",
  "recipe_type": "appetizer",
  "brief_description": "Try this easy, simple, and foolproof fondue recipe for making the ultimate cheese lover\u2019s dish and serve up some fondue like a Swiss guru!",
  "cuisine": "Swiss American",
  "instructions": [
    {
      "position": 1,
      "text": "Add white wine, cherry brandy, cornstarch, garlic, cayenne, and nutmeg to a saucepan. Whisk to combine and place on the stove over medium heat. Cook, whisking occasionally, until mixture thickens slightly and you can see wisps of steam in the pan, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add Gruy\u00e8re and Emmentaler cheeses, one handful at a time, slowly whisking after each addition until melted. Continue whisking until all cheese is melted and sauce is very smooth. Remove from the heat and transfer into a fondue pot to serve."
    },
    {
      "position": 3,
      "text": "Keep sauce warm while serving so it doesn\u2019t solidify."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "d40e4d23-c20a-5a59-9480-1b5c3737d11b",
  "slug": "marble-cake-i",
  "name": "Marble Cake",
  "recipe_type": "dessert",
  "brief_description": "This gorgeous marble cake recipe features swirls of chocolate batter in a rich vanilla cake. It's easy to make from scratch and sure to be a hit!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch round cake pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt into a bowl."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar together in a separate large bowl with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition. Beat in vanilla extract."
    },
    {
      "position": 4,
      "text": "Add flour mixture in batches, alternating with milk, mixing just until combined."
    },
    {
      "position": 5,
      "text": "Reserve 3/4 cup batter; pour remaining batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Mix cocoa into reserved cake batter until even in color."
    },
    {
      "position": 7,
      "text": "Drop chocolate batter by large spoonfuls on top of vanilla batter and swirl with a knife for a marbled effect."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 28 to 30 minutes. Cool briefly on a wire rack before inverting carefully onto a cooling rack. Let cool completely before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

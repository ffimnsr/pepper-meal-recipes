  "id": "321c3fbb-eb50-5523-a541-07cb57f5ba66",
  "slug": "sufganiyot",
  "name": "Sufganiyot",
  "recipe_type": "dessert",
  "brief_description": "Sufganiyot are fluffy donuts that are served during the Jewish festival of Hanukkah. Serve warm filled with jam and dusted with confectioners' sugar.",
  "cuisine": "World Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine flour, yogurt, eggs, sugar, vanilla sugar, and salt in a large bowl; mix well. Set the dough aside for 30 minutes."
    },
    {
      "position": 3,
      "text": "Form dough into 2-inch balls."
    },
    {
      "position": 4,
      "text": "Heat vegetable oil in a large pot or deep fryer over medium-high heat to 350 degrees F (175 degrees C). Deep-fry sufganiyot, in batches, in hot oil until golden brown, about 3 minutes, flipping halfway through."
    },
    {
      "position": 5,
      "text": "Transfer donuts to a paper towel-lined plate using a slotted spoon. Repeat with remaining dough."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 50,
  "rest_time_minutes": null,
  "difficulty": "medium",

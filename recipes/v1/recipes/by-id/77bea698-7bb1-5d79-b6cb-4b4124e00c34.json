  "id": "77bea698-7bb1-5d79-b6cb-4b4124e00c34",
  "slug": "cinnamon-raisin-monkey-bread-recipe-12035635",
  "name": "Cinnamon-Raisin Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "For this cinnamon-raisin monkey bread, tender dough balls are coated in cinnamon-sugar, sprinkled with raisins and walnuts, and drizzled with butter. A 12-inch skillet ensures the dough balls have room to expand, while the cast iron helps create pillowy bread bites with crispy bottoms. Serve with warmed caramel sauce for an extra-sweet breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat a 12-inch cast-iron skillet with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together white sugar, brown sugar, and cinnamon in a medium bowl. Halve each piece of dough to make 36 pieces total. Roll each into a ball. Dip dough balls into the melted butter, then in cinnamon-sugar mixture to coat. Arrange dough balls evenly in the prepared skillet. Sprinkle with raisins, walnuts, and any remaining cinnamon-sugar and butter. Cover loosely and let rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (90 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, until golden brown and an instant-read thermometer inserted in center registers 195 degrees F (200 degrees C), 30 to 35 minutes. Let cool on a wire rack 10 minutes. Serve warm with caramel sauce ."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

  "id": "1640de7b-c1aa-58c4-8bca-3cc9d780388a",
  "slug": "grandmas-canned-corned-beef-and-cabbage-soup",
  "name": "Grandma's Canned Corned Beef and Cabbage Soup",
  "recipe_type": "soup",
  "brief_description": "Canned corned beef, cabbage, potatoes, and tomatoes combine in soup form in this grandma's version of a classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat; stir in onion. Cook and stir until the onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add potatoes, cabbage, salt, and pepper. Add water to cover and bring to a boil. Reduce heat to a simmer and cook until potatoes are tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Add diced tomatoes, corned beef, cream-style and kernel corns, and pepper. Cook until heated through, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,

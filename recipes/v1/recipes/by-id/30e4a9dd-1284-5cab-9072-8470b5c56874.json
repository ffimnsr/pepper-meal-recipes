  "id": "30e4a9dd-1284-5cab-9072-8470b5c56874",
  "slug": "crispy-polenta-bites-with-jammy-tomato-topper-recipe-8347292",
  "name": "Crispy Polenta Bites with Jammy Tomato Topper",
  "recipe_type": "appetizer",
  "brief_description": "These crispy polenta bites with jammy tomato topper are a tasty vegetarian party app. With a few quick adjustments, this recipe can feed the meat lovers and vegans in your life, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put a rimmed baking sheet in oven. Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring tomatoes, raisins, and red wine to a boil in a medium saucepan over medium-high heat. Reduce heat to low; simmer mixture, uncovered, until raisins are plump and most of liquid has evaporated, about 20 minutes. Remove from heat. Stir in honey, vinegar, thyme, and salt."
    },
    {
      "position": 3,
      "text": "Meanwhile, slice polenta into 1/4-inch-thick rounds. Gently toss polenta with oil in a large bowl. Remove baking sheet from oven. Arrange rounds in an even layer on baking sheet."
    },
    {
      "position": 4,
      "text": "Bake polenta rounds in the preheated oven, turning halfway through, until lightly golden and crisp on both sides, about 15 minutes."
    },
    {
      "position": 5,
      "text": "To serve, top polenta rounds with goat cheese and tomato mixture. Garnish with thyme. Serve warm or at room temperature."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "32aff8ef-9564-5159-8910-47813f5677cf",
  "slug": "brads-slow-cooker-chicken-parmesan",
  "name": "Brad's Slow Cooker Chicken Parmesan",
  "recipe_type": "main",
  "brief_description": "Brad's slow cooker chicken Parmesan recipe simmers chicken breasts with marinara sauce in a slow cooker before topping with mozzarella and Parmesan.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Spread flour on a shallow plate. Beat eggs in a bowl. Pour bread crumbs into a shallow bowl. Dredge 1 chicken breast in flour; shake off excess. Dip into beaten egg. Lift up so excess egg drips back into the bowl. Press into bread crumbs to coat both sides. Place the breaded chicken breast, unstacked, onto a plate. Repeat with remaining chicken breasts."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium heat. Fry breaded chicken breasts, two at a time, until golden brown, 4 to 6 minutes per side. Transfer to a plate. Repeat with remaining butter and chicken breasts."
    },
    {
      "position": 3,
      "text": "Layer chicken breasts in a slow cooker, covering each layer with marinara sauce. Cover slow cooker."
    },
    {
      "position": 4,
      "text": "Cook on Low until flavors combine, 2 1/2 to 3 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 6,
      "text": "Place chicken breasts, side-by-side, into a baking dish; spoon additional sauce on top. Place 2 slices mozzarella cheese over each breast; sprinkle Parmesan cheese, oregano, basil, and garlic powder on top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 170,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "107098c9-02d0-5d56-bf3f-f9732d1cb644",
  "slug": "croque-madame-sandwich",
  "name": "Croque Madame",
  "recipe_type": "main",
  "brief_description": "The Croque Madame isn't just any old ham and cheese sandwich! The French classic includes Gruyere cheese and Black Forest ham and is topped with bechamel and a poached egg.",
  "cuisine": "French Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Melt 1 1/2 tablespoons butter in a saucepan over medium-low heat. Whisk in flour and stir until slightly brown, about 3 minutes. Whisk in milk; bring to a boil, stirring constantly. Once boiling, reduce heat immediately and simmer for 5 minutes. Add 1/2 of the Gruy\u00e8re cheese, salt, pepper, and nutmeg; heat until cheese is melted, about 2 minutes. Remove from the heat and set aside."
    },
    {
      "position": 3,
      "text": "Spread about 1 teaspoon butter on 2 pieces of bread. Spread 1 tablespoon cheese sauce on top and layer each with a ham slice. Spread 1 teaspoon butter on the remaining 2 pieces of bread, then spread Dijon mustard on top and sprinkle with remaining Gruy\u00e8re. Transfer all 4 pieces to a baking sheet."
    },
    {
      "position": 4,
      "text": "Broil in the preheated oven until cheese is almost melted, 2 to 3 minutes. Remove from the oven, place toast slices together to make 2 sandwiches and pour remaining cheese sauce on top of each sandwich. Return to the broiler until sauce starts to brown, about 2 minutes."
    },
    {
      "position": 5,
      "text": "While the sandwiches are broiling, heat remaining butter in a nonstick skillet over medium-high heat. Crack 2 eggs into the skillet, keeping them completely separate from one another. Season with salt and pepper. Add water, cover, and baste until whites are set but yolks are still runny, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Top each sandwich with an egg and sprinkle with dill, if using. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cbcfcc2c-f61b-588b-bd0d-29f89f7fbafb",
  "slug": "sangria-by-the-pros",
  "name": "Sangria by the Pros",
  "recipe_type": "drink",
  "brief_description": "Make sangria like a professional with brandy, red wine, soda, juice, and lots of fruit. This recipe is from a bartender with 20 years of experience.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Slice orange, lemon, and lime into thin rounds. Place the sliced citrus in a pitcher with apples, cherries, and pineapple."
    },
    {
      "position": 2,
      "text": "Pour in brandy and refrigerate for 2 hours or more. Chill the bottle of red wine, lemon-lime soda, and orange juice at the same time."
    },
    {
      "position": 3,
      "text": "Gently crush the fruits with a spoon, then stir in red wine, lemon-lime soda, and orange juice. Add additional brandy or orange juice to taste."
    }
  ],
  "servings": 6,

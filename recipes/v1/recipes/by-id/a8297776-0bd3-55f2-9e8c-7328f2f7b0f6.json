  "id": "a8297776-0bd3-55f2-9e8c-7328f2f7b0f6",
  "slug": "snert-split-pea-soup",
  "name": "Snert (Split Pea Soup)",
  "recipe_type": "soup",
  "brief_description": "A ham hock, bacon, and potatoes add heartiness to a thick split pea soup made in the slow cooker. The soup's name is Dutch.",
  "cuisine": "Dutch",
  "instructions": [
    {
      "position": 1,
      "text": "Place dried split peas, ham hock, and bacon into slow cooker; pour in chicken broth and 3 1/2 cups water."
    },
    {
      "position": 2,
      "text": "Cover cooker and cook on High until peas are tender and broken apart, 3 to 4 hours. Stir in more water as needed to prevent soup from burning on the bottom. Stir occasionally throughout cooking."
    },
    {
      "position": 3,
      "text": "Stir potatoes, carrots, leek, onion, celery, and garlic into soup; mix in more water, if needed. Cover and cook soup on High for 2 more hours."
    },
    {
      "position": 4,
      "text": "Season with salt, black pepper, thyme, nutmeg, and cloves; mix sausage slices into soup. Cover and cook 2 more hours to blend the flavors."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 420,
  "preparation_time_minutes": 30,

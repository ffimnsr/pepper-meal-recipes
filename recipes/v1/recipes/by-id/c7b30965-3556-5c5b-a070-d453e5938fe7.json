  "id": "c7b30965-3556-5c5b-a070-d453e5938fe7",
  "slug": "raspberry-oatmeal-bars",
  "name": "Raspberry Oatmeal Bars",
  "recipe_type": "dessert",
  "brief_description": "This recipe is quick and easy, but the resulting oatmeal bar cookies topped with raspberry jam taste so decadent.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together oats, cake mix, and melted margarine so that it makes nice clumps and there is no dry mix left. Press 1/2 of oats mixture evenly into the bottom of the prepared pan. In a separate bowl, mix jam with water, and spread over oat mixture in the pan. Sprinkle remaining oat mixture evenly over top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 18 to 23 minutes, or until top is lightly browned. Cool before cutting into bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

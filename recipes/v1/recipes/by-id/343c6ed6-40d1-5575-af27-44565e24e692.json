  "id": "343c6ed6-40d1-5575-af27-44565e24e692",
  "slug": "raw-cauliflower-salad",
  "name": "Raw Cauliflower Salad",
  "recipe_type": "salad",
  "brief_description": "With a light salty and almost crispy tangy dressing, this raw cauliflower salad with olives, celery, and peppers is easy to make.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cauliflower, olives, bell pepper, pimento peppers, onion, and celery in a large bowl."
    },
    {
      "position": 2,
      "text": "Combine oil, lemon juice, vinegar, salt, sugar, and black pepper in a small jar with a lid. Close jar and shake until dressing is combined. Pour over vegetables. Marinate cauliflower salad in the refrigerator for 2 to 4 hours."
    }
  ],

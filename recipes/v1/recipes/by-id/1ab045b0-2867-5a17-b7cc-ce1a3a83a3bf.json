  "id": "1ab045b0-2867-5a17-b7cc-ce1a3a83a3bf",
  "slug": "amazing-slow-cooker-chocolate-cake",
  "name": "Amazing Slow Cooker Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This chocolate crockpot cake is worth a try! Basic ingredients come together in minutes with a whisk and transform into a moist cake in your slow cooker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray the crock of a large slow cooker with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk sugar, flour, cocoa powder, baking soda, baking powder, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk milk, oil, eggs, and vanilla together in a medium bowl until well combined. Slowly whisk in boiling water. Add wet ingredients to dry ingredients and mix until well combined; pour batter into the prepared slow cooker."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until cake has no wet spots on top and is pulling away from the sides of the crock, about 3 hours. Turn off slow cooker and let rest for 30 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "slug": "israeli-salad",
  "name": "Israeli Salad Recipe",
  "recipe_type": "salad",
  "brief_description": "This Israeli salad recipe yields a lightly dressed, colorful salad, typically sold at falafel stands in Israel. Serve it alone, as a side, or in a pita.",
  "cuisine": "Israeli",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cucumbers, tomatoes, bell pepper, parsley, green onions, mint, and garlic in a bowl."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil and lemon juice over salad; season with salt and black pepper and toss to coat."
    }
  ],
  "servings": 5,

  "id": "f373208a-41d3-58c4-9c4e-e735e21edd88",
  "slug": "white-bean-and-tomato-pasta-recipe-11703008",
  "name": "White Bean and Tomato Pasta",
  "recipe_type": "drink",
  "brief_description": "For this white bean and tomato pasta, cannellini beans are pureed with garlic, lemon juice, and olive oil to make a smooth sauce. Adding lightly cooked tomatoes, red pepper flakes, Parmesan cheese, it\u2019s then served over penne pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a rolling boil over high heat. Cook pasta in boiling water until cooked through but still firm to bite, about 10 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, puree cannellini beans, garlic, lemon juice, and 1 tablespoon olive oil in a food processor until smooth. Set aside."
    },
    {
      "position": 3,
      "text": "Add 2 tablespoons olive oil, red pepper flakes, and cherry tomatoes to a skillet. Cook over medium heat until tomatoes are warmed, about 2 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Stir pureed bean sauce into the skillet; stir in Parmesan cheese and pasta. Season with salt and pepper, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

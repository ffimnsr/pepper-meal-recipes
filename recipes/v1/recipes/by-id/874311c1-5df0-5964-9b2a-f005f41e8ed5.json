  "id": "874311c1-5df0-5964-9b2a-f005f41e8ed5",
  "slug": "oven-roasted-asparagus",
  "name": "Oven-Roasted Asparagus",
  "recipe_type": "drink",
  "brief_description": "Tender roasted asparagus, seasoned with minced garlic, Parmesan cheese, and lemon juice. Pairs perfectly with roast leg of lamb or grilled fish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place asparagus into a mixing bowl, drizzle with olive oil, and toss to coat."
    },
    {
      "position": 3,
      "text": "Sprinkle with Parmesan cheese and garlic; season to taste with salt and pepper if using. Arrange asparagus in a single layer in a baking dish or on a rimmed baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until just tender, 12 to 15 minutes depending on thickness. Sprinkle with lemon juice just before serving, and serve immediately for the best texture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

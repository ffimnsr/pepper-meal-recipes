  "id": "5e35b30e-29b5-5767-a82d-d5bab3571daa",
  "slug": "one-pot-italian-sausage-and-tortellini-recipe-11838973",
  "name": "One-Pot Italian Sausage and Tortellini",
  "recipe_type": "main",
  "brief_description": "This one-pot Italian sausage and tortellini is creamy, cheesy, and super tasty. It uses pantry and refrigerator staples, comes together quickly and can easily be doubled for a larger group.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Set a large skillet over medium heat. Break up sausage into bite-sized chunks, removing any casings. Add to the pan and cook until browned on all sides, about 5 minutes. Remove sausage to a plate; set aside."
    },
    {
      "position": 3,
      "text": "Let the skillet cool down for about 3 minutes; place back over medium heat and add butter, then garlic. Saute for 1 minute, then add black pepper, onion powder, Italian seasoning, and red pepper flakes; stir."
    },
    {
      "position": 4,
      "text": "Pour in beef broth and heavy cream; stir to combine."
    },
    {
      "position": 5,
      "text": "Add tortellini, cream cheese, and browned sausage to the skillet and stir to combine. Bring to a simmer, cover, reduce heat, and cook until tortellini is tender, about 5 minutes. Check for doneness, and simmer for 2 or 3 minutes more if needed."
    },
    {
      "position": 6,
      "text": "Remove from heat and stir in Parmesan cheese. Serve in bowls with fresh basil on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

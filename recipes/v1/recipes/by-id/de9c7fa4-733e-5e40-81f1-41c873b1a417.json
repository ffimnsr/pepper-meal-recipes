  "id": "de9c7fa4-733e-5e40-81f1-41c873b1a417",
  "slug": "codfish-chowder",
  "name": "Codfish Chowder",
  "recipe_type": "soup",
  "brief_description": "This easy and satisfying cod soup is ready to eat in just 1 hour. The rich chowder has plenty of potatoes, bacon, and corn with tasty, flaky fish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a soup pot over medium heat until crisp and brown, about 10 minutes. Remove bacon with a slotted spoon, leaving drippings in the pot."
    },
    {
      "position": 2,
      "text": "Cook and stir onion and red bell pepper until softened, about 5 minutes; season with salt and pepper. Stir in garlic and seafood seasoning. Cook and stir, 2 more minutes."
    },
    {
      "position": 3,
      "text": "Pour in chicken broth and stir in potatoes and corn; add water if needed to cover vegetables. Bring to a boil and reduce heat to low; simmer until potatoes are tender, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir in milk and butter until butter has melted; mix in reserved bacon. Bring the soup just to the boiling point and stir in cod and parsley; cook, stirring occasionally, until fish flakes easily, 5 to 8 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

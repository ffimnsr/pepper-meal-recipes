  "id": "9dab2c10-00a1-5c15-8f1d-f25b73e3c036",
  "slug": "raspberry-danish-hawaiian-rolls-recipe-11870369",
  "name": "Raspberry Danish Hawaiian Rolls",
  "recipe_type": "dessert",
  "brief_description": "Make these gorgeous raspberry Danish Hawaiian rolls for your holiday brunch! Tender Hawaiian rolls are filled with a cream cheese filling and raspberry preserves, dusted with confectioner's sugar and topped with fresh raspberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x13-inch baking dish, or line with parchment paper. Slice rolls in half horizontally."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, egg, vanilla extract, and salt in a bowl and mix until smooth."
    },
    {
      "position": 3,
      "text": "Place bottom half of rolls in the prepared baking dish, cut side up. Spread cream cheese mixture evenly over the bottom half of rolls."
    },
    {
      "position": 4,
      "text": "Spread raspberry preserves over cream cheese; place top half of rolls on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Let stand for 10 minutes. Dust with confectioner's sugar and top each roll with a fresh raspberry."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

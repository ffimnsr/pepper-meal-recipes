  "id": "b84db92b-2ecb-542a-bce5-9c70ede5447a",
  "slug": "pistachio-thumbprint-kinda-sorta-cookies",
  "name": "Pistachio Thumbprint (Kinda Sorta) Cookies",
  "recipe_type": "dessert",
  "brief_description": "These pistachio cookies don't look like a classic thumbprint cookie but they are filled with salted caramel baking chips and taste delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the pistachios in the bowl of a food processor and grind until finely ground, stopping before it turns into butter. Set aside."
    },
    {
      "position": 2,
      "text": "Combine butter and sugar in a bowl and beat with an electric mixer until creamy. Add almond extract and mix in well. Add 3 tablespoons ground pistachios, flour, and salt; mix until the dough comes together."
    },
    {
      "position": 3,
      "text": "Place dough on a piece of plastic wrap that has been sprinkled with flour. Wrap up and place in the refrigerator for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Combine egg and water in a bowl and beat with a fork. Place remaining ground pistachios in a separate bowl. Shape the dough into 12 equal balls. Roll in the beaten egg and then in the ground pistachios. Set balls 2 inches apart onto the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Make an indentation in the middle of each ball with your thumb or the handle of a wooden spoon. Place 5 to 6 baking chips in each indentation."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes. Allow the cookies to cool on the baking sheet before removing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

  "id": "3881574c-49de-550c-a08e-19b7187bb81f",
  "slug": "hot-honey-salmon-bowls-recipe-8765623",
  "name": "Hot Honey Salmon Bowls",
  "recipe_type": "main",
  "brief_description": "These hot honey salmon bowls feature spicy honey-glazed sauteed salmon, served over tri-color quinoa with green beans, cucumbers, and tomatoes, and drizzled with a honey mustard dressing.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender, 15 to 20 minutes; drain any excess water and set aside."
    },
    {
      "position": 3,
      "text": "Whisk honey, paprika, garlic powder, onion powder, cayenne, and 2 tablespoons water together in a small bowl; set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, fill a large skillet with 1 inch of water. Bring to a simmer over medium heat. Add green beans. Cook, covered, until beans are just tender, 2 to 3 minutes. Drain; set aside."
    },
    {
      "position": 5,
      "text": "Wipe out skillet; heat olive oil in the same skillet over medium heat. Season salmon pieces with salt. Add salmon to skillet; cook until fish flakes easily with a fork, about 4 minutes, turning after 2 minutes. Remove salmon from skillet, set aside."
    },
    {
      "position": 6,
      "text": "Add honey mixture to skillet. Cook and stir until mixture is bubbly and slightly thickened; about 2 minutes. Remove skillet from heat. Return cooked salmon to skillet. Toss to coat in honey sauce; set aside."
    },
    {
      "position": 7,
      "text": "For mustard dressing, whisk together olive oil, vinegar, Dijon mustard, parsley, dill, honey, pepper and salt, in a small bowl."
    },
    {
      "position": 8,
      "text": "To serve, divide quinoa evenly between 2 bowls. Top with hot-honey-sauced salmon, green beans, cucumber, tomatoes, and red onions and/or olives. Serve with with mustard dressing."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,

  "id": "d28a8374-2407-5f7e-911a-f9805e33a364",
  "slug": "habanero-hellfire-chili",
  "name": "Habanero Hellfire Chili",
  "recipe_type": "soup",
  "brief_description": "This habanero hellfire chili recipe is packed with spice from jalape\u00f1os and habaneros, paired with ground beef, pork, tomatoes, and other staples.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large soup pot over medium-high heat until evenly browned. Drain on paper towels; chop. Drain excess drippings from the pot, leaving enough to coat the bottom."
    },
    {
      "position": 2,
      "text": "Brown beef and pork in the same pot over medium-high heat. Stir in whole tomatoes, crushed tomatoes, water, beer, onion, bell pepper, Anaheims, jalape\u00f1os, habaneros, tomato paste, chili powder, chili paste, bouillon granules, cumin, pepper flakes, and garlic."
    },
    {
      "position": 3,
      "text": "Reduce heat to low; simmer, stirring occasionally, 45 to 60 minutes Stir in bacon and beans; simmer 30 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

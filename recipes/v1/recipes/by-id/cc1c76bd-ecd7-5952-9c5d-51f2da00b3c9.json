  "id": "cc1c76bd-ecd7-5952-9c5d-51f2da00b3c9",
  "slug": "greek-orzo-salad",
  "name": "Greek Orzo Salad",
  "recipe_type": "salad",
  "brief_description": "This easy orzo salad is packed with cucumber, feta, tomato, artichokes, and olives for a colorful summer pasta salad full of Greek flavors.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Drain artichoke hearts, reserving liquid."
    },
    {
      "position": 3,
      "text": "Gather prepared ingredients together."
    },
    {
      "position": 4,
      "text": "Combine pasta, artichoke hearts, cucumber, tomato, onion, feta, olives, parsley, lemon juice, oregano, and lemon pepper in a large bowl; toss well. Chill in the refrigerator for 1 hour."
    },
    {
      "position": 5,
      "text": "Just before serving, drizzle reserved artichoke marinade over salad."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b10f1b1b-fcb5-54b9-9431-381a7e258b04",
  "slug": "roasted-acorn-squash-with-sriracha-butter",
  "name": "Roasted Acorn Squash with Sriracha Butter",
  "recipe_type": "dessert",
  "brief_description": "Roasting acorn squash brings out its natural sweetness. Topped with Sriracha butter takes it to the next level.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cut the squash in half vertically, and scoop out the seeds in the middle. Cut each half into 4 wedges and place wedges on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Melt butter in a small saucepan over medium-low heat. Whisk in Sriracha sauce and honey; keep warm."
    },
    {
      "position": 4,
      "text": "Brush squash with olive oil and sprinkle with salt and pepper. Place wedges on their side and roast for 20 minutes; flip wedges over and roast until squash is soft and edges are caramelized, about 15 minutes more."
    },
    {
      "position": 5,
      "text": "Place wedges on a serving platter and drizzle with Sriracha butter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

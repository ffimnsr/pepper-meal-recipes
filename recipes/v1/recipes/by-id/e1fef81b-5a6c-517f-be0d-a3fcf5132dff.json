  "id": "e1fef81b-5a6c-517f-be0d-a3fcf5132dff",
  "slug": "banana-bread-french-toast",
  "name": "Banana Bread French Toast",
  "recipe_type": "dessert",
  "brief_description": "This banana bread French toast recipe relies on sweetened condensed milk, eggs, vanilla extract, and banana bread. It's a decadent way to start the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs, sweetened condensed milk, and vanilla together in a bowl with a fork; set aside. Slice banana bread into 4 thick slices. Dip each bread slice in egg mixture."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add bread slices to skillet. Cook until both sides golden brown. Dust with confectioners' sugar just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

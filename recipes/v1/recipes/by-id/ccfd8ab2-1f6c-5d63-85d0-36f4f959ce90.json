  "id": "ccfd8ab2-1f6c-5d63-85d0-36f4f959ce90",
  "slug": "coquito-coconut-eggnog",
  "name": "Coquito Coconut Eggnog",
  "recipe_type": "drink",
  "brief_description": "Puerto Rican rum is blended with flavors of coconut, almond, cinnamon, and vanilla in this unique non-dairy version of classic eggnog.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour coconut milk, almond milk, cream of coconut, rum, eggs, sugar, honey, vanilla extract, cinnamon, nutmeg, and cloves into a large bowl and whisk well to combine."
    },
    {
      "position": 2,
      "text": "Blend mixture in two batches in a blender on high speed until frothy, 3 to 4 minutes. Pour into a gallon-size glass container and chill overnight or serve over ice."
    }
  ],
  "servings": 16,

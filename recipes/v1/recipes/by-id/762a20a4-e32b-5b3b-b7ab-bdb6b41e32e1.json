  "id": "762a20a4-e32b-5b3b-b7ab-bdb6b41e32e1",
  "slug": "salmon-and-swiss-chard-quiche",
  "name": "Salmon and Swiss Chard Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This Swiss chard quiche with smoked salmon, mushrooms, and onion is a crustless quiche that makes a great option for breakfast, brunch, or lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9-inch pie plate with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add Swiss chard, mushrooms, and onion. Cook, stirring occasionally, until tender and most of the liquid has evaporated, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Spread chard mixture on bottom of prepared pie plate. Break salmon into pieces and arrange evenly over chard. Whisk together eggs, milk, salt, nutmeg, and pepper in a bowl. Pour over salmon."
    },
    {
      "position": 4,
      "text": "Bake until a knife inserted in center comes out clean, 28 to 30 minutes. Cool about 10 minutes before cutting into wedges. Top with chives (if using)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

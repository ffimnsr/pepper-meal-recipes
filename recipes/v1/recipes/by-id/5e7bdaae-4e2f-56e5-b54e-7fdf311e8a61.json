  "id": "5e7bdaae-4e2f-56e5-b54e-7fdf311e8a61",
  "slug": "dubai-chocolate-berry-trifle-recipe-11678673",
  "name": "Dubai Chocolate Berry Trifle",
  "recipe_type": "dessert",
  "brief_description": "For this Dubai chocolate berry trifle, the delicious combo of milk chocolate, pistachio cream, and pistachios pair with crispy kataifi\u2014shredded phyllo dough\u2014and mixed berries. This dessert is a stunner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add kataifi and cook, stirring often, until golden brown, about 10 minutes. Set aside."
    },
    {
      "position": 2,
      "text": "Whisk pistachio cream and tahini together in a bowl until well combined. Set aside."
    },
    {
      "position": 3,
      "text": "Add chocolate chips to the bowl of a double boiler set over medium heat. Cook, stirring constantly, until chocolate is melted and smooth. Stir in coconut oil and turn off heat; keep warm."
    },
    {
      "position": 4,
      "text": "Arrange the trifle just before serving to ensure the chocolate stays loose. In a trifle bowl or medium serving bowl, add half of melted chocolate. Top with half of strawberries, half of raspberries, half of blueberries, and half of blackberries."
    },
    {
      "position": 5,
      "text": "Top with half of pistachio cream mixture. Sprinkle with 3/4 cup toasted kataifi. Add remaining berries and remaining pistachio cream, and top with remaining chocolate. Sprinkle over remaining kataifi and serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

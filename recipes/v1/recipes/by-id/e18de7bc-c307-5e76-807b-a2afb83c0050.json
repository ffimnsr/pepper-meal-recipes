  "id": "e18de7bc-c307-5e76-807b-a2afb83c0050",
  "slug": "roasted-cabbage",
  "name": "Roasted Cabbage",
  "recipe_type": "side",
  "brief_description": "Delicious roasted cabbage with crispy, charred edges seasoned with olive oil, garlic, red pepper flakes, and lemon for an easy-to-prep side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Brush both sides of each cabbage wedge with olive oil. Sprinkle garlic powder, pepper flakes, salt, and pepper over each wedge. Arrange cabbage wedges on a baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven for 15 minutes; flip cabbage wedges and continue roasting until browned and charred in some areas, about 15 minutes more."
    },
    {
      "position": 4,
      "text": "Squeeze lemon over each wedge to serve. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "aa91f7aa-edde-56e1-b58b-431bbdf82644",
  "slug": "two-ingredient-dough-cinnamon-rolls",
  "name": "Two Ingredient Dough Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "Use a simple 2-ingredient dough to create these gooey, baked cinnamon rolls, topped with a homemade cream cheese glaze.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a baking dish or loaf pan."
    },
    {
      "position": 2,
      "text": "Mix flour and Greek yogurt together in a medium bowl until a shaggy dough forms. Transfer to a surface dusted with more self-rising flour, and knead for 8 to 10 minutes. Continue adding flour as needed if the dough is too sticky."
    },
    {
      "position": 3,
      "text": "Roll out the dough with a rolling pin to form a large 10x12-inch rectangle."
    },
    {
      "position": 4,
      "text": "Combine brown sugar, melted butter, and cinnamon in a small bowl. Spread this mixture over the top of the dough. Starting at one of the shorter ends, roll the dough up tightly until it forms a log. Slice into 6 even pieces. Transfer cinnamon rolls to the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "In the meantime, whisk together powdered sugar, cream cheese, softened butter, milk, and vanilla until smooth. When the cinnamon rolls have finished cooking, remove from the oven and drizzle the cream cheese glaze on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

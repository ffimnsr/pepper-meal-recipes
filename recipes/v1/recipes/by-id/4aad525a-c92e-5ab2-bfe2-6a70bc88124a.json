  "slug": "tuna-ball",
  "name": "Tuna Ball",
  "recipe_type": "appetizer",
  "brief_description": "Chopped pecans blended with tuna, cream cheese, and onion give this tuna ball a light crunch. I love this appetizer with crackers and veggies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend cream cheese, tuna, 1/2 of the pecans, and onion in a bowl. Shape into a ball or loaf, then coat with remaining pecans. Refrigerate until serving."
    }
  ],

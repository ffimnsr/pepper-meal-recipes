  "id": "e790fcfa-54b9-5edd-8a5f-28830e29b578",
  "slug": "crazy-creamy-chickpea-curry",
  "name": "Creamy Chickpea Curry",
  "recipe_type": "main",
  "brief_description": "This hearty chickpea curry made with canned chickpeas and veggies is flavored with ginger, curry powder, and coconut milk for added creaminess.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt coconut oil in a heavy 4-quart pot over medium heat. Cook and stir onion until lightly browned, 5 to 7 minutes. Add ginger and garlic; cook and stir until fragrant, about 30 seconds. Add curry powder, pepper flakes, broth, soy sauce, maple syrup, and tomato paste; mix well."
    },
    {
      "position": 2,
      "text": "Add potatoes and carrot, cover pot, and bring to a boil. Immediately reduce heat to a simmer and leave lid ajar. Cook just until potatoes are tender, about 10 minutes. Add cauliflower, chickpeas, coconut milk, and cilantro. Stir gently to incorporate. Return to simmer with lid ajar and simmer just until cauliflower is tender, 5 to 7 minutes. Fold in peas and cook until heated through, about 1 minute."
    },
    {
      "position": 3,
      "text": "Remove from heat and season with salt, if needed. Serve with steamed basmati rice and, for those who'd like more heat, sriracha sauce. Garnish with cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

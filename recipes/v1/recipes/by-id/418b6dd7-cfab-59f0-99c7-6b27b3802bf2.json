  "id": "418b6dd7-cfab-59f0-99c7-6b27b3802bf2",
  "slug": "fabiennes-black-eyed-crab-cakes",
  "name": "Fabienne's 'Black-Eyed' Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "Crab cakes with black-eyed peas in the batter are a tasty new twist on traditional crab cakes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk lemon zest, mustard powder, seafood seasoning, onion powder, and cayenne pepper together in a bowl. Add black-eyed peas to lemon zest mixture and smash with a fork until mixture is crumbly. Stir egg and mayonnaise into pea mixture; gently fold in crab meat and Parmesan cheese until combined."
    },
    {
      "position": 2,
      "text": "Form pea mixture into 5-ounce patties. Pour bread crumbs into a shallow bowl and press patties into bread crumbs, coating both sides. Place patties on a plate and refrigerate until chilled, at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium heat; fry patties until golden brown, about 4 minutes per side."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

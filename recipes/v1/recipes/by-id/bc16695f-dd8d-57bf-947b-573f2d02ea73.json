  "id": "bc16695f-dd8d-57bf-947b-573f2d02ea73",
  "slug": "quick-and-easy-shrimp-fajitas",
  "name": "Quick and Easy Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "This is a twist on a classic recipe using shrimp instead of beef or chicken. I use regular old taco seasoning to make it easier, but any seasoning combination for fajitas will work. Serve with refried beans and Spanish rice to make an easy meal!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon of oil in a large skillet over medium-high heat. Add the red and green bell peppers, and onion. Cook, stirring frequently until peppers are hot, but still slightly crisp, about 5 minutes. Remove from the skillet and set aside."
    },
    {
      "position": 2,
      "text": "Pour the remaining 1/2 tablespoon of oil into the skillet, and add the shrimp. Cook, stirring occasionally, until pink and opaque. Reduce heat to low, and return the peppers and onion to the skillet. Stir in taco seasoning and water so that everything is evenly coated. Simmer until peppers are heated. Serve in warm tortillas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

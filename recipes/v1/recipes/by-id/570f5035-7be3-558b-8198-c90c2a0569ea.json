  "id": "570f5035-7be3-558b-8198-c90c2a0569ea",
  "slug": "quick-pork-fried-rice",
  "name": "Quick Pork Fried Rice",
  "recipe_type": "main",
  "brief_description": "A great recipe for leftover pork chops, roasts, or even chicken. Use cooked rice and a few vegetables for a colorful and hearty fried rice dish.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons vegetable oil in a skillet over medium heat; cook and stir mushrooms until liquid has evaporated, and mushrooms are browned, about 15 minutes. Set mushrooms aside."
    },
    {
      "position": 3,
      "text": "Fluff cooked rice with a fork and stir in 1 tablespoon vegetable oil to separate the grains. Set aside."
    },
    {
      "position": 4,
      "text": "Heat remaining 3 tablespoons vegetable oil in a large skillet or wok over medium heat. Cook and stir pork, garlic, and ginger until fragrant, about 1 minute. Add celery, onion, and carrot. Cook and stir until vegetables begin to soften, 3 to 4 minutes. Stir in bell pepper and cooked mushrooms just until combined."
    },
    {
      "position": 5,
      "text": "Add in cooked rice, lightly tossing until rice is heated through and thoroughly combined with pork and vegetables. Stir in soy sauce, remove from heat, and sprinkle green onions over the top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

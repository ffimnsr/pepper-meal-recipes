  "name": "Tomatillo-Kiwi Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This bright green salsa with tomatillos and kiwi is fruity and refreshing. Serve with tortilla chips.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together tomatillos, kiwi, green onions, lime juice, cilantro, jalape\u00f1o, salt, and pepper in a bowl. Serve immediately or chill, covered, up to 2 hours."
    }
  ],
  "servings": 4,

  "id": "acc04d96-5cad-5b97-8543-469e17b9e545",
  "slug": "one-skillet-breakfast-casserole-recipe-11871369",
  "name": "One-Skillet Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This one-skillet breakfast casserole nestles biscuits into cheesy eggs and sausage, and bakes in the oven until golden. Quick and delicious, this is sure to satisfy everyone.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk eggs with milk, salt, pepper, and garlic powder in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "To a 10-inch cast iron skillet over medium heat, add sausage, onion, and bell pepper. Cook, stirring often, until sausage is browned and crumbled and vegetables are soft, about 10 minutes. Drain oil from the skillet and return it to the stove."
    },
    {
      "position": 4,
      "text": "Add eggs to the skillet and cook, stirring, until eggs are set, 3 to 5 minutes. Remove from heat and stir in half the shredded cheese. Place biscuits on top of egg and sausage mixture, then sprinkle with remaining cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the biscuits are cooked and golden, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

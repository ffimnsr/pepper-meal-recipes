  "id": "4d66272e-82e3-5771-983a-35f3272e8c19",
  "slug": "honey-baked-chicken-ii",
  "name": "Honey-Glazed Baked Chicken",
  "recipe_type": "main",
  "brief_description": "Curried honey mustard imparts a golden hue to tender baked chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken pieces in a shallow baking pan, skin-side up. Stir melted butter, honey, mustard, salt, and curry powder together in a bowl until smooth; pour mixture over chicken."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 1/4 hours, basting every 15 minutes with pan drippings, until the chicken is nicely browned and tender and the juices run clear."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,

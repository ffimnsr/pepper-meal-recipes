  "id": "2021d463-4009-57c6-90e0-30a3b1f8aa8b",
  "slug": "lolas-horchata",
  "name": "Horchata",
  "recipe_type": "breakfast",
  "brief_description": "This horchata recipe is easy to make with long-grain rice, vanilla, sugar, and cinnamon for a refreshing Mexican drink that's great with spicy foods.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water and rice into a blender; mix until rice begins to break up, about 1 minute. Let rice and water stand at room temperature for at least 3 hours."
    },
    {
      "position": 2,
      "text": "Strain rice water into a pitcher and discard rice. Stir in sugar, milk, vanilla, and cinnamon."
    },
    {
      "position": 3,
      "text": "Chill thoroughly before serving over ice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

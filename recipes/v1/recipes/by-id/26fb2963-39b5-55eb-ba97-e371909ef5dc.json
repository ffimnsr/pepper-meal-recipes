  "id": "26fb2963-39b5-55eb-ba97-e371909ef5dc",
  "slug": "easy-oreo-truffles",
  "name": "Easy Oreo Truffles",
  "recipe_type": "dessert",
  "brief_description": "These delicious Oreo truffles are bite-sized chocolaty treats easily made with 3 simple ingredients: Oreo cookies, cream cheese, and melted chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt chocolate in a saucepan over low heat, stirring occasionally, 4 to 6 minutes."
    },
    {
      "position": 3,
      "text": "While the chocolate is melting, place 9 cream-filled sandwich cookies in a food processor and blend until finely crushed. Transfer crumbs to a bowl and reserve for decorating."
    },
    {
      "position": 4,
      "text": "Add remaining cookies to the food processor and blend until finely crushed. Transfer crumbs to a large bowl and stir in cream cheese; mix until well-blended. Roll mixture into 42 balls, about 1-inch in diameter."
    },
    {
      "position": 5,
      "text": "Place each ball in melted chocolate and use two forks to roll it until fully coated. Lift the ball with both forks and allow excess chocolate to drip off."
    },
    {
      "position": 6,
      "text": "Place coated truffle on a wax paper-lined baking sheet and sprinkle with reserved cookie crumbs to decorate. Repeat to make remaining truffles."
    },
    {
      "position": 7,
      "text": "Refrigerate truffles until firm, at least 1 hour. Keep in the refrigerator until just before serving. Enjoy!"
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 35,

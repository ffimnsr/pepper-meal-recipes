  "id": "ad264404-7719-51e2-b261-df58cd88b65c",
  "slug": "cheesecake-stuffed-snickerdoodle-cookie-recipe-8758331",
  "name": "Cheesecake-Stuffed Snickerdoodle Cookie",
  "recipe_type": "dessert",
  "brief_description": "The classic cookie gets a serious upgrade thanks to content creator Sunny Yue. Here, she combines a homemade cheesecake ball and adds it to the center of snickerdoodle cookie dough. Then, you roll the ball in sugar and bake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "For filling, mix softened cream cheese and sugar together until smooth. Scoop filling into small balls and place onto the prepared baking sheet. Freeze for at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine butter, brown sugar, and white sugar in a bowl and beat with an electric mixer until creamy. Add egg and vanilla extract; beat until smooth and fluffy"
    },
    {
      "position": 4,
      "text": "Reduce mixer speed to low and beat in flour, cinnamon, and baking soda just until flour disappears."
    },
    {
      "position": 5,
      "text": "In a separate shallow bowl stir 1/4 cup sugar and 1 teaspoon cinnamon together for the cinnamon sugar."
    },
    {
      "position": 6,
      "text": "Scoop cookie dough by 2 tablespoonfuls and flatten into a circle with your hands. Place a ball of cream cheese filling in the center of the cookie dough. Press cookie dough up and around filling, sealing filling inside."
    },
    {
      "position": 7,
      "text": "Roll each cookie dough ball into the cinnamon sugar mixture and place on a baking sheet lined with parchment paper."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until cookies are just turning golden on the bottom and the edges, 12 to 14 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

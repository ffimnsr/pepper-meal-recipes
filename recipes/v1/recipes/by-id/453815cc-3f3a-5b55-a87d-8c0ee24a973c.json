  "slug": "easy-french-toast",
  "name": "Easy French Toast",
  "recipe_type": "breakfast",
  "brief_description": "An easy to make crispy cinnamon French toast that will light up your morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together egg, milk, cinnamon, vanilla and salt."
    },
    {
      "position": 2,
      "text": "Heat a lightly oiled skillet or griddle over medium heat."
    },
    {
      "position": 3,
      "text": "Soak bread slices in egg mixture for 20 second on each side, or until thoroughly coated. Cook bread until both sides are lightly browned and crisp. Serve hot."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,

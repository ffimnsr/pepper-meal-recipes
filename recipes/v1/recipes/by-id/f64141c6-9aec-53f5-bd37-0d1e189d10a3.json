  "id": "f64141c6-9aec-53f5-bd37-0d1e189d10a3",
  "slug": "easy-mediterranean-baked-chicken-breast",
  "name": "Easy Mediterranean Baked Chicken Breast",
  "recipe_type": "drink",
  "brief_description": "An easy recipe for baked chicken breast for two that is marinated in Mediterranean flavors like lemon juice, olive oil, garlic, and herbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken breasts with salt and pepper on all sides and place in a bowl or lidded container. Combine olive oil, lemon juice, garlic, oregano, and thyme in a small bowl and pour marinade over chicken breasts. Marinate for 10 minutes at room temperature."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Set one oven rack about 6 inches from the heat source."
    },
    {
      "position": 3,
      "text": "Place chicken breasts into a baking dish and pour marinade on top."
    },
    {
      "position": 4,
      "text": "Bake chicken on the middle rack of the preheated oven until no longer pink in the center and the juices run clear, 35 to 45 minutes, depending upon thickness. Move baking dish to the top rack and broil chicken until well browned, about 5 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

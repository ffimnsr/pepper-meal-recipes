  "id": "53bdd609-c94c-5325-910a-f2f0c1658e47",
  "slug": "rolled-fondant",
  "name": "Fondant Icing",
  "recipe_type": "dessert",
  "brief_description": "Fondant icing, made from scratch with confectioners' sugar, glucose, and glycerin, makes a smooth covering and the perfect finishing touch to cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine gelatin and cold water; let stand until thick. Place gelatin mixture in top of double boiler and heat until dissolved."
    },
    {
      "position": 2,
      "text": "Add glucose and glycerin; mix well. Stir in shortening and just before completely melted, remove from heat and stir in vanilla. Mixture should cool until lukewarm."
    },
    {
      "position": 3,
      "text": "Place 4 cups confectioners' sugar in a large bowl. Make a well in the center and using a wooden spoon, stir in lukewarm gelatin mixture. Mix in a little more sugar, in batches, until stickiness disappears. Knead in remaining sugar until fondant is smooth, pliable and does not stick to your hands. If fondant is too soft, add more sugar; if too stiff, add water (a drop at a time). Use fondant immediately or store in airtight container in fridge. When ready to use, bring to room temperature and knead again until soft."
    },
    {
      "position": 4,
      "text": "Use fondant immediately or store in an airtight container in the refrigerator. When ready to use, bring to room temperature and knead again until soft."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,

  "slug": "roasted-chicken-rub",
  "name": "Roasted Chicken Rub",
  "recipe_type": null,
  "brief_description": "This roast chicken seasoning is a herb and spice blend of paprika, garlic powder, thyme, rosemary, and sage \u2014 the perfect rub for whole chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir celery flakes, salt, paprika, garlic powder, onion powder, thyme, sage, black pepper, rosemary, and cayenne pepper together in a bowl."
    },
    {
      "position": 2,
      "text": "Transfer spice mixture to a spice grinder or food processor; blend until smooth."
    }
  ],
  "servings": 6,

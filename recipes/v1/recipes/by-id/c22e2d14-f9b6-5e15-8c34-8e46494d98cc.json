  "id": "c22e2d14-f9b6-5e15-8c34-8e46494d98cc",
  "slug": "tomato-and-mozzarella-bites",
  "name": "Tomato and Mozzarella Bites",
  "recipe_type": "salad",
  "brief_description": "These tomato and mozzarella bites with fresh basil and a balsamic dip are a great way to serve Italian caprese salad as a fun party appetizer!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Thread a tomato half, a basil leaf, a mozzarella ball, and another tomato half onto a toothpick. Repeat with remaining ingredients."
    },
    {
      "position": 2,
      "text": "Arrange toothpicks on a serving platter and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Mix vinegar and oil together in a small bowl to serve as a dipping sauce."
    }
  ],
  "servings": 10,

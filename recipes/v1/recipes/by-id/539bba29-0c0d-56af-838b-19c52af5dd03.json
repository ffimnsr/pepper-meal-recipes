  "id": "539bba29-0c0d-56af-838b-19c52af5dd03",
  "slug": "easy-sweet-potato-casserole",
  "name": "Easy Sweet Potato Casserole",
  "recipe_type": "dessert",
  "brief_description": "This easy sweet potato casserole recipe is a true classic; sweet potatoes flavored with cinnamon and brown sugar, topped with marshmallows, then baked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sweet potatoes in a large pot, cover with salted water, and bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low; simmer until tender, about 20 minutes; drain."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a deep casserole dish."
    },
    {
      "position": 4,
      "text": "Mash sweet potatoes with a potato masher in a bowl until no large lumps remain."
    },
    {
      "position": 5,
      "text": "Stir in white sugar, brown sugar, cinnamon, and butter until well combined."
    },
    {
      "position": 6,
      "text": "Transfer sweet potato mixture to the prepared casserole dish. Cover evenly with marshmallows."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until marshmallows are golden, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

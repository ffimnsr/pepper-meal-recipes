  "id": "263ec614-8781-5d49-a10b-11d8504eb022",
  "slug": "southwestern-falafel",
  "name": "Southwestern Falafel",
  "recipe_type": "appetizer",
  "brief_description": "This is a spicy Southwestern twist on traditional falafel. Pinto beans are substituted for garbanzo beans, and spiked with cayenne powder, taco seasoning, and hot sauce.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place onion, green bell pepper, egg, garlic, taco seasoning, baking powder, peanut oil, cumin, salt, and cayenne pepper in a food processor. Puree until smooth."
    },
    {
      "position": 3,
      "text": "Pour pinto beans into mixture and pulse until pinto beans are chopped and integrated, but not smooth."
    },
    {
      "position": 4,
      "text": "Transfer bean mixture to a large bowl; stir hot sauce into mixture."
    },
    {
      "position": 5,
      "text": "Stir enough bread crumbs into mixture to form a dough that holds together, but isn't sticky."
    },
    {
      "position": 6,
      "text": "Form dough into quarter-sized balls."
    },
    {
      "position": 7,
      "text": "Deep-fry in hot oil until falafel are deep brown, about 3 to 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d556d605-93b4-5b0f-b9f3-7475b4b97786",
  "slug": "white-peachy-sangria",
  "name": "Peachy White Sangria",
  "recipe_type": "drink",
  "brief_description": "This white sangria recipe made with fresh summer peaches, white wine, brandy, and peach schnapps is a delicious light cocktail with a fruity taste.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir Moscato wine, lemon-lime soda, brandy, peach schnapps, peaches, strawberries, mangos, pineapple chunks, and raspberries together in a large container."
    },
    {
      "position": 3,
      "text": "Chill the sangria for 8 hours or overnight. Serve and enjoy!"
    }
  ],
  "servings": 20,

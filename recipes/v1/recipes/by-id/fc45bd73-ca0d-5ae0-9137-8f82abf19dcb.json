  "id": "fc45bd73-ca0d-5ae0-9137-8f82abf19dcb",
  "slug": "bacon-pancakes-recipe-11687812",
  "name": "Bacon Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These bacon pancakes are the sweet-salty combo that will start your day out right. It's a breakfast all in one, with plenty of bacon in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large cast iron or nonstick skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 2,
      "text": "Whisk together baking mix, milk, oil, egg, and cinnamon in a bowl until smooth. Crumble 2 bacon slices into the batter, then mix the batter again."
    },
    {
      "position": 3,
      "text": "Heat a medium-sized non-stick skillet to medium low-heat. Cut 1 of the remaining bacon slices in half, then lay the halves in the pre-heated skillet. Pour just enough batter over 1 half slice to cover it. Repeat with the other half slice of bacon."
    },
    {
      "position": 4,
      "text": "Cook until pancakes have puffed up and bubbles have appeared. Flip and cook the other side until golden brown. Remove pancakes from the pan and repeat with remaining bacon and batter."
    },
    {
      "position": 5,
      "text": "Serve with maple syrup on top and any leftover bacon."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "649ed86f-fe01-5b8a-b680-a904d2b4129c",
  "slug": "mulligatawny-soup-i",
  "name": "Mulligatawny Soup",
  "recipe_type": "soup",
  "brief_description": "This mulligatawny soup recipe combines flavors of chicken, curry, apple, and cream for lovely, Indian-inspired dish \u2014 easy to make comfort in a bowl.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large soup pot over medium heat. Add onions, celery, and carrot and saut\u00e9 until soft, 5 to 7 minutes. Add flour and curry, and cook 5 more minutes, stirring frequently."
    },
    {
      "position": 3,
      "text": "Add chicken broth, mix well, and bring to a boil. Reduce heat and simmer for about 30 minutes. Add apple, rice, chicken, thyme, salt, and pepper. Simmer until rice is tender, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Just before serving, stir in hot cream."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "be319e01-26f8-5959-9368-6e104f5e61c8",
  "slug": "zucchini-bread-in-a-jar",
  "name": "Zucchini Bread in a Jar",
  "recipe_type": null,
  "brief_description": "This zucchini bread in a jar recipe \u201ccans\u201d the bread by baking them in pint-sized Mason jars. It's a simple and unique way of preparing this quick bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Soak raisins in hot water in a bowl until plump, about 10 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, inspect four (pint-sized) jars for cracks and rings for rust, discarding any defective ones. Wash jars and new, unused lids and rings in warm soapy water, then dry and grease with 1 tablespoon shortening."
    },
    {
      "position": 4,
      "text": "Beat sugar, 1 cup shortening, and eggs in a large bowl with an electric mixer until creamy; beat in raisins. Beat in flour, cinnamon, baking soda, salt, and baking powder until blended; fold in zucchini, walnuts, and vanilla."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared jars, filling each \u2154 full. Place jars on a rimmed baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Turn off oven with jars inside. Remove one jar at a time using oven mitts. Trim off any excess cake from top. Wipe rims and screw on lids."
    },
    {
      "position": 7,
      "text": "Place jars several inches apart on a cloth-covered or wood surface; cool completely until sealed, about 2 hours. Store in the refrigerator."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "13371983-fca1-5d42-b836-92c861681813",
  "slug": "easy-japanese-fried-rice",
  "name": "Easy Japanese Fried Rice",
  "recipe_type": "side",
  "brief_description": "This easy Japanese fried rice recipe is made with butter, soy sauce, sesame seeds, fluffy jasmine rice, and scrambled eggs for a quick and delicious dinner.",
  "cuisine": "Asian Inspired Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Place rice, chicken stock, and water in a medium saucepan; bring to a boil. Reduce heat to low, cover, and simmer until rice is tender and liquid is absorbed, 15 to 20 minutes. Off heat, stir in 2 tablespoons butter and cool to room temperature, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add beaten eggs and cook, stirring often to scramble eggs, breaking chunks of eggs into small bits with a spatula."
    },
    {
      "position": 3,
      "text": "Place cooked rice in a large bowl; add scrambled eggs and toss until well combined."
    },
    {
      "position": 4,
      "text": "Melt remaining 2 tablespoons butter in a large skillet over medium-high heat; add rice mixture, sesame seeds, soy sauce, salt, and black pepper. Cook, stirring often, for 8 minutes. Taste; season with butter or soy sauce as desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

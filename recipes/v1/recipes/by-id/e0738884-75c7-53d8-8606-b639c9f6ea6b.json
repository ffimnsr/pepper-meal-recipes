  "id": "e0738884-75c7-53d8-8606-b639c9f6ea6b",
  "slug": "pan-seared-salmon-i",
  "name": "Pan-Seared Salmon",
  "recipe_type": "main",
  "brief_description": "Learn how long to cook salmon on the stove with this quick and easy recipe for pan-seared salmon fillets that are seasoned with capers and lemon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a large heavy skillet over medium heat for 3 minutes."
    },
    {
      "position": 2,
      "text": "Coat salmon fillets with olive oil; place skin-side down in the preheated skillet and increase heat to high."
    },
    {
      "position": 3,
      "text": "Sprinkle with capers, salt, and pepper; cook for 3 minutes on one side. Turn salmon fillets over; continue to cook until salmon flakes easily with a fork, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer salmon to individual plates and garnish with lemon slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

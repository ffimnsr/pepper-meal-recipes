  "id": "19e65ce8-1c87-5d45-9a5f-e202ae3593c7",
  "slug": "pecan-tassies",
  "name": "Pecan Tassies",
  "recipe_type": "dessert",
  "brief_description": "Pecan tassies are easy to make in large batches for holiday gifts, Christmas parties, or cookie swaps. They taste delicious and look beautiful, too!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease mini tart pans or mini muffin pans."
    },
    {
      "position": 2,
      "text": "Beat butter and cream cheese with an electric mixer in a large bowl until smooth. Beat in flour, 1 cup at a time, until mixture forms a smooth dough."
    },
    {
      "position": 3,
      "text": "Roll into small balls, and press into the bottoms and sides of prepared pans."
    },
    {
      "position": 4,
      "text": "Mix brown sugar, eggs, melted butter, vanilla, and salt together in a medium bowl until smooth."
    },
    {
      "position": 5,
      "text": "Stir in pecans; spoon mixture into each crust until 2/3 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crust is golden brown and filling has puffed up, about 15 to 18 minutes. Let cool in the pans briefly before carefully transferring them onto a wire rack to cool completely."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,

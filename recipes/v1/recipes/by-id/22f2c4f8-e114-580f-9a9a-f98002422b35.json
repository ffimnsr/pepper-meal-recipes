  "id": "22f2c4f8-e114-580f-9a9a-f98002422b35",
  "slug": "dubai-chocolate-truffles-recipe-11927264",
  "name": "Dubai Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "Mimic Dubai chocolate bars with truffles that are easier to make and a fraction of the cost. Kataifi (kadayif) is ultrafinely shredded phyllo dough. Find it in the freezer or refrigerated section at major retailers or online.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium-low heat. Add kataifi; cook and stir until golden brown, 4 to 6 minutes."
    },
    {
      "position": 2,
      "text": "Stir together pistachio cream, tahini, and kataifi in a large bowl. Freeze mixture in bowl or in a loaf pan, covered, until firm, about 1 hour."
    },
    {
      "position": 3,
      "text": "Line a baking sheet with parchment paper. Scoop mixture into balls with a 2-teaspoon (#60) scoop. Roll between your palms to form round balls. Place on the prepared baking sheet. Freeze, covered, until set, at least 1 hour or overnight."
    },
    {
      "position": 4,
      "text": "Line another baking sheet with parchment paper. Combine semisweet chocolate and melting wafers in a small bowl; microwave on High, stirring every 30 seconds, until smooth, about 2 minutes. Working in 3 batches, while keeping remaining balls in freezer, dip a ball in melted chocolate using a fork, turning to coat. Transfer to prepared baking sheet. Immediately sprinkle with pistachios. Repeat with remaining balls. Freeze until set, about 15 minutes. (Store in an airtight container at room temperature up to 2 weeks.)"
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,

  "id": "4d93a558-4700-5625-aa2a-4760d4e7b94a",
  "slug": "fluffy-cake-doughnuts",
  "name": "Fluffy Cake Donuts",
  "recipe_type": "dessert",
  "brief_description": "This cake donut recipe makes a dozen crispy cakey donuts in 30 minutes; enjoy them plain, glazed, or rolled in cinnamon sugar!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a donut pan."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking powder, nutmeg, cinnamon, and salt together in a large bowl. Stir in milk, eggs, butter, and vanilla. Beat until well blended. Fill each prepared donut cup approximately 3/4 full."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until donuts spring back when touched, 8 to 10 minutes. Allow to cool slightly before removing from the pan."
    },
    {
      "position": 4,
      "text": "While the donuts are cooling, make the glaze: Blend confectioners' sugar, hot water, and almond extract together in a small bowl. Dip doughnuts in the glaze when serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e13d5bf9-ea2d-5e65-829c-87d8a8bd6ada",
  "slug": "cowboy-oatmeal-cookies",
  "name": "Cowboy Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "This oatmeal cookie recipe is the kids\u2019 favorite. It doesn\u2019t call for nuts, but I sometimes add about 1/2 cup of chopped walnuts or pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking soda, baking powder, and salt in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat brown sugar, white sugar, margarine, and oil with an electric mixer in a large bowl until smooth. Add eggs one at a time, beating well after each addition. Add flour mixture and stir until dough is just combined. Mix in oats and butterscotch chips. Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes. Allow cookies to cool for a few minutes before transferring to wire racks to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

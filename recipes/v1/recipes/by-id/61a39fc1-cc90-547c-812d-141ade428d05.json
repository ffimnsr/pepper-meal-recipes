  "slug": "white-cheese-dip",
  "name": "White Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "This quick and easy, creamy white cheese dip is just like dips served in restaurants that you can eat in the comforts of your own home.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine American cheese, Monterey Jack cheese, half-and-half, cream, and jalapeno peppers in a large saucepan over medium-low heat; gradually stir spinach into mixture, a few tablespoons at a time. Cook and stir dip until melted and smooth, 15 to 20 minutes."
    }
  ],

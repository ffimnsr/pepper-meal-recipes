  "id": "fbac9f22-da3c-53b5-b6ae-51317615b906",
  "slug": "baked-jalapeno-poppers",
  "name": "Baked Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These baked jalape\u00f1o poppers forgo the frying but keep all the creamy goodness of Cheddar and cream cheese in this easy-to-prep, popular appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Fill each jalape\u00f1o pepper half with cream cheese, Cheddar cheese, and bread crumbs, respectively; arrange on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until jalape\u00f1os are tender and cheese melts, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

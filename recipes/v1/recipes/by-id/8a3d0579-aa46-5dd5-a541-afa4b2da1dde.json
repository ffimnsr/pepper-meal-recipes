  "id": "8a3d0579-aa46-5dd5-a541-afa4b2da1dde",
  "slug": "falafel-with-canned-chickpeas",
  "name": "Falafel with Canned Chickpeas",
  "recipe_type": "main",
  "brief_description": "Falafel made with canned chickpeas, onion, bread crumbs, herbs and spices; simply delicious, restaurant-quality, falafel in just 30 minutes.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mash chickpeas in a bowl using a masher. Combine mashed chickpeas, onions, parsley, and garlic in a blender; blend until smooth."
    },
    {
      "position": 3,
      "text": "Mix eggs, cumin, coriander, salt, lemon juice, baking powder, black pepper, and cayenne together in a bowl. Add chickpea mixture and mix together. Add bread crumbs slowly and combine using your hands until mixture will hold together when frying."
    },
    {
      "position": 4,
      "text": "Heat oil in a skillet over medium-high heat. Form mixture into twelve 3-inch diameter patties. Fry patties in hot oil until browned, 3 to 4 minutes per side."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

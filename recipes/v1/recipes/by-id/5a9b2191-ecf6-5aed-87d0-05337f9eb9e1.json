  "id": "5a9b2191-ecf6-5aed-87d0-05337f9eb9e1",
  "slug": "authentic-louisiana-red-beans-and-rice",
  "name": "Authentic Louisiana Red Beans and Rice",
  "recipe_type": "main",
  "brief_description": "This easy authentic Louisiana red beans and rice recipe features Cajun seasoning and andouille sausage for hearty, comforting flavor.",
  "cuisine": "Southern Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse beans, and then soak in a large pot of water overnight."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium heat. Cook onion, bell pepper, celery, and garlic in olive oil for 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Rinse beans, and transfer to a large pot with 6 cups water. Stir cooked vegetables into beans. Season with bay leaves, parsley, thyme, Cajun seasoning, cayenne pepper, and sage. Bring to a boil, and then reduce heat to medium-low. Simmer for 2 \u00bd hours."
    },
    {
      "position": 5,
      "text": "Stir sausage into beans, and continue to simmer for 30 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, prepare the rice. Bring water and rice to a boil in a saucepan. Reduce heat, cover, and simmer for 20 minutes. Serve beans over steamed white rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 25,

  "id": "b377565d-d279-54dc-b7da-a259f1916651",
  "slug": "authentic-new-orleans-red-beans-and-rice",
  "name": "Authentic New Orleans Red Beans and Rice",
  "recipe_type": "side",
  "brief_description": "This New Orleans red beans and rice recipe uses dried red beans with smoked sausage and Creole seasoning to make a Southern comfort food favorite.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt shortening in a skillet over medium heat. Cook and stir onion, bell pepper, and garlic in hot shortening until tender, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Combine water, red beans, and ham hock in a large pot; bring to a boil. Stir onion mixture into the pot; add smoked sausage and celery. Return to a boil. Stir bay leaves, Creole seasoning, thyme, and sage into boiling water. Reduce heat to low, cover the pot, and simmer until beans are tender, about 5 hours."
    },
    {
      "position": 4,
      "text": "Remove and discard ham hock and bay leaves; stir in hot pepper sauce and serve over white rice."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 310,
  "preparation_time_minutes": 20,

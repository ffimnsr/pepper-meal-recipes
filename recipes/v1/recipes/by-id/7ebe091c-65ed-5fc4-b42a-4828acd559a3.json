  "id": "7ebe091c-65ed-5fc4-b42a-4828acd559a3",
  "slug": "banana-pudding-tiramisu-recipe-12006780",
  "name": "Banana Pudding Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This truly no-cook, no-bake dessert combines two classic desserts into one delicious treat. Banana pudding, combined with whipped mascarpone cream, is layered with espresso-soaked ladyfingers and banana slices, then simply chilled.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together pudding mix, cold milk, and nutmeg in a bowl until combined. Set aside to set up for about 5 minutes."
    },
    {
      "position": 2,
      "text": "Whisk warm water, espresso powder, and white sugar together in a separate bowl until dissolved. Add coffee liqueur; whisk until combined. Set aside."
    },
    {
      "position": 3,
      "text": "Beat mascarpone, confectioner\u2019s sugar, vanilla, and salt together in a bowl with an electric mixer until smooth and combined. Pour in heavy cream. Beat on low speed, gradually increasing to medium-high, until mascarpone cream holds stiff peaks."
    },
    {
      "position": 4,
      "text": "Whisk pudding briefly until smooth; fold in half of mascarpone cream until combined."
    },
    {
      "position": 5,
      "text": "Remove ladyfingers from their packaging. Quickly dip them, 1 at a time, into espresso mixture, then place them in a single layer in the bottom of an 8x8-inch square baking dish. Place a layer of sliced bananas over ladyfingers. Top with half of pudding mixture; spread into an even layer over bananas. Repeat this layering of dipped ladyfingers, banana slices, and pudding mixture (pan will be very full). Pipe or spread remaining whipped mascarpone cream over the top of the final pudding layer."
    },
    {
      "position": 6,
      "text": "Refrigerate until chilled, at least 4 hours. Dust top of the tiramisu with cocoa powder just before slicing and serving. Store in the refrigerator."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 35,

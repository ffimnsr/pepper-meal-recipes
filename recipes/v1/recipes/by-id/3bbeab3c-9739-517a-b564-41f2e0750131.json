  "id": "3bbeab3c-9739-517a-b564-41f2e0750131",
  "slug": "brown-rice-chicken-and-chorizo-paella",
  "name": "Brown Rice, Chicken, and Chorizo Paella",
  "recipe_type": "main",
  "brief_description": "This brown rice paella is flavored with saffron and made with apple cider vinegar for an authentically Spanish tang. It's sure to be a favorite!",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine salt, paprika, red pepper, turmeric, and saffron in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a paella pan or large pot over medium heat. Add chicken and chorizo and cook until browned, 5 to 10 minutes. Transfer meat to a platter. Add onion, bell pepper, parsley, and garlic to the pot; cook, stirring occasionally, for 5 minutes. Add rice, tomato, and roasted red peppers; cook until rice begins to brown, about 5 minutes. Add spice mixture and broth, then return chicken and chorizo to the pot, burying them in the paella."
    },
    {
      "position": 3,
      "text": "Increase the heat to high and bring to a boil, stirring every 10 minutes. Reduce the heat to medium and cook, uncovered, for 50 to 55 minutes. Stir in thawed peas and carrots, olives, capers, and apple cider vinegar; cook until everything is heated through, 3 to 5 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "hard",

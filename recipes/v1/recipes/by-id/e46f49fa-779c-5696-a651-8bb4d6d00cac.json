  "id": "e46f49fa-779c-5696-a651-8bb4d6d00cac",
  "slug": "chocolate-peanut-butter-bars-ii",
  "name": "No-Bake Chocolate Peanut Butter Bars",
  "recipe_type": "dessert",
  "brief_description": "This is an easy recipe for rich and delicious no-bake peanut butter bars without the need for a graham cracker crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a pan over low heat. Add confectioners' sugar, peanut butter, brown sugar, and vanilla. Mix well."
    },
    {
      "position": 2,
      "text": "Press into a 9x13-inch pan."
    },
    {
      "position": 3,
      "text": "Melt chocolate chips and spread over the top. Cool until hardened, at least 1 hour."
    }
  ],
  "servings": 24,

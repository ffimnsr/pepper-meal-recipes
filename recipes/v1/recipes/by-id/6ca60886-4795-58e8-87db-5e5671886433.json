  "id": "6ca60886-4795-58e8-87db-5e5671886433",
  "slug": "bjs-easy-blackberry-cobbler",
  "name": "BJ's Easy Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "BJ's easy blackberry cobbler recipe removes the fuss of making a cobbler because a packaged lemon-poppy seed muffin mix is used to make the batter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 9x9-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread blackberries in the prepared baking pan; sprinkle with white sugar and drizzle with lemon juice. Combine lemon-poppy seed muffin mix, milk, egg, and cinnamon in a bowl; stir until moist (it's okay to leave lumps in batter). Pour batter over blackberries."
    },
    {
      "position": 3,
      "text": "Beat brown sugar and butter together in a bowl with an electric mixer on medium speed until mixture resembles coarse crumbs; spread over batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until topping is golden, and blackberries are bubbling, about 1 hour. Cool before serving, 20 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

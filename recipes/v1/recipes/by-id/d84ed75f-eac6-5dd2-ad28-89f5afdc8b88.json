  "id": "d84ed75f-eac6-5dd2-ad28-89f5afdc8b88",
  "slug": "blueberry-lemonade-martini-recipe-11798375",
  "name": "Blueberry Lemonade Martini",
  "recipe_type": "appetizer",
  "brief_description": "This blueberry lemonade martini is sweet, tart, cool, and refreshingly delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add vodka, blueberry lemonade, agave syrup, and lime juice to a cocktail shaker."
    },
    {
      "position": 2,
      "text": "Fill the cocktail shaker with ice and shake until the outside is frosted, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Sprinkle Tajin seasoning on a plate, rub the rim of your favorite glass with a lemon or lime wedge, and dip the glass in seasoning to coat the rim. Strain the cocktail into the glass."
    }
  ],

  "id": "18c0681f-88c3-5383-a302-740fbd0861e8",
  "slug": "slow-cooker-teriyaki-pork-tenderloin",
  "name": "Slow Cooker Teriyaki Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "This sweet and spicy teriyaki pork tenderloin slow cooker recipe is mild enough for young kids. Adjust the spice level with more hot peppers to taste.",
  "cuisine": "American Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium-high heat. Brown tenderloins on all sides, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, mix together chicken broth, teriyaki sauce, and brown sugar in a bowl. Stir in onion, garlic, red chile peppers, and black pepper."
    },
    {
      "position": 3,
      "text": "Put browned tenderloins in a slow cooker and cover with teriyaki sauce mixture. Cook on Low for about 4 hours, turning 2 to 3 times during cooking time to ensure even doneness. The internal temperature of tenderloins should reach 145 degrees F (63 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove tenderloins from the slow cooker and let rest for 5 minutes before slicing. Spoon liquid over slices when serving, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 250,
  "preparation_time_minutes": 25,

  "id": "49c38a18-3803-592d-b4bb-365fe207f2fb",
  "slug": "blueberry-crumb-bars",
  "name": "Blueberry Crumb Bars",
  "recipe_type": "dessert",
  "brief_description": "These blueberry bars have a buttery crust, a delicious fresh blueberry filling, and a cinnamon crumble topping for a delicious summer treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Stir flour, 1 cup sugar, and baking powder together in a medium bowl; mix in salt and cinnamon, if desired. Use a fork or pastry cutter to blend in butter and egg. Dough will be crumbly. Pat half of dough into the prepared pan."
    },
    {
      "position": 3,
      "text": "Stir 1/2 cup sugar and cornstarch together in another bowl; gently mix in blueberries. Sprinkle blueberry mixture evenly over prepared crust. Crumble remaining dough over berry layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top is slightly brown, about 45 minutes. Cool completely before cutting into squares."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

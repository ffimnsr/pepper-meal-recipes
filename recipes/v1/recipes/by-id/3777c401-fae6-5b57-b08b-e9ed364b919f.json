  "id": "3777c401-fae6-5b57-b08b-e9ed364b919f",
  "slug": "cornflake-macaroons",
  "name": "Cornflake Macaroons",
  "recipe_type": "dessert",
  "brief_description": "Chewy, crunchy cookies. If you prefer a more cake-like cookie increase the flour slightly and decrease the cornflakes slightly.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream the butter with the brown sugar and white sugars. Add the eggs and the vanilla and beat well."
    },
    {
      "position": 3,
      "text": "Mix in the flour until well combined. Stir in the corn flakes and the coconut. Drop by teaspoonfuls onto a parchment lined baking sheet."
    },
    {
      "position": 4,
      "text": "Bake at 375 degrees F (190 degrees C) for 8 to 10 minutes."
    }
  ],
  "servings": 24,

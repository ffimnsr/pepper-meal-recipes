  "slug": "taco-slaw",
  "name": "Taco Slaw",
  "recipe_type": "salad",
  "brief_description": "This tangy cabbage slaw for tacos is made with sliced green cabbage, red onion, carrot, jalape\u00f1o, cilantro, and lime for the perfect topping or side.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Finely chop the cabbage, carrot, and cilantro. Mince the red onion. Seed and mince the jalape\u00f1o."
    },
    {
      "position": 3,
      "text": "Combine chopped vegetables and lime juice in a bowl; toss to coat."
    }
  ],
  "servings": 6,

  "id": "6f663926-1242-5b59-ab31-1da46d355f96",
  "slug": "barbequed-cabbage",
  "name": "Barbequed Cabbage",
  "recipe_type": "side",
  "brief_description": "These cabbage stuffed foil packets are cooked on the grill in this recipe, but can easily be cooked in the gently coals of a campfire. This is a delicious way to use up some cabbage and turn someone into a cabbage lover at the same time!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat."
    },
    {
      "position": 2,
      "text": "Divide cabbage among 4 squares of aluminum foil. Sprinkle 2 tablespoons soy sauce over each cabbage mound; place 1 tablespoon butter on top. Season with pepper. Fold the sides of the foil over cabbage, sealing to form a packet."
    },
    {
      "position": 3,
      "text": "Place packets onto preheated grill; cook until cabbage tender, 15 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

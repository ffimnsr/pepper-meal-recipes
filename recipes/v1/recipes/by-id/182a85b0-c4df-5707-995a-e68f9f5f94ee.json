  "id": "182a85b0-c4df-5707-995a-e68f9f5f94ee",
  "slug": "dump-and-go-instant-pot-tortilla-soup",
  "name": "Dump-and-Go Instant Pot Tortilla Soup",
  "recipe_type": "soup",
  "brief_description": "This dump and go tortilla soup is ready in 30 minutes in the Instant Pot.. Perfect for busy weeknights. Serve with your favorite toppings.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour chicken broth, corn, black beans, chunk chicken, tomatoes with green chilies (with their juices), chili powder, seasoning salt, and garlic powder together in a multi-functional pressure cooker (such as Instant Pot\u00ae); stir to combine."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and carefully open the lid."
    },
    {
      "position": 4,
      "text": "Ladle the soup into serving bowls and top with tortilla strips, and shredded cheese, to taste."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

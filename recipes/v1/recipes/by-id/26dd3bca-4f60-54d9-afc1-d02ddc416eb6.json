  "id": "26dd3bca-4f60-54d9-afc1-d02ddc416eb6",
  "slug": "slow-cooker-pot-roast-with-malbec-red-wine",
  "name": "Slow Cooker Pot Roast with Malbec (Red Wine)",
  "recipe_type": "soup",
  "brief_description": "Beef roast is seared with seasonings and simmered in a slow cooker with an onion broth creating an easy pot roast for weeknight dinners.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine steak seasoning, salt, thyme, and rosemary together in a bowl; rub onto the roast."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat and place roast in skillet; cook until roast is browned on all sides, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Place the roast in the slow cooker and add au jus mix and onion soup mix. Pour water and Malbec over roast."
    },
    {
      "position": 4,
      "text": "Cook on High for 5 hours (or cook on Low for 8 to 9 hours)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 310,

  "id": "9bf1e00a-de16-5b26-846b-bb916b232395",
  "slug": "cranberry-chutney-i",
  "name": "Cranberry Chutney",
  "recipe_type": "side",
  "brief_description": "This cranberry chutney with apples, raisins, and spices is a deliciously fruity alternative to regular cranberry sauce on your holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and sugar to a boil in a medium saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Add cranberries, apples, cider vinegar, raisins, cinnamon, ginger, allspice, and cloves. Return to a boil, then reduce heat and simmer gently, stirring often, for 10 minutes."
    },
    {
      "position": 4,
      "text": "Pour mixture into a mixing bowl."
    },
    {
      "position": 5,
      "text": "Place plastic wrap directly on the surface of the fruit. Let cool to room temperature before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

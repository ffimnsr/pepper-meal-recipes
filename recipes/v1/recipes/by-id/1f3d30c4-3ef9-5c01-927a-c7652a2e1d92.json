  "id": "1f3d30c4-3ef9-5c01-927a-c7652a2e1d92",
  "slug": "apple-scones",
  "name": "Apple Scones",
  "recipe_type": "dessert",
  "brief_description": "This recipe delivers fresh apple flavor in these delectable, easy-to-make, not-too-sweet apple scones sprinkled with cinnamon sugar \u2014 great for breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine flour, \u00bc cup sugar, baking powder, baking soda, and salt in a bowl; cut in butter until crumbly. Stir in shredded apple and \u00bd cup milk to form a soft dough."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and knead gently, 8 to 10 times. Pat into two 6-inch circles; place on the prepared baking sheet. Brush tops with 2 tablespoons milk; sprinkle with 2 tablespoons sugar and cinnamon. Score each dough circle into 6 pie-shaped wedges."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned and risen, about 15 minutes. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

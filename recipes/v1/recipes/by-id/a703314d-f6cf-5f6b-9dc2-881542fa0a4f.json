  "id": "a703314d-f6cf-5f6b-9dc2-881542fa0a4f",
  "slug": "pork-rites-taverns",
  "name": "Pork Rites (Taverns)",
  "recipe_type": "main",
  "brief_description": "This take on sloppy joes uses ground pork in place of the beef for a slight variation on a classic American dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground pork in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 2,
      "text": "Stir ketchup, water, vinegar, brown sugar, dry mustard, and salt into the ground beef; bring to a simmer and cook for 20 minutes. Serve on hamburger buns."
    }
  ],
  "servings": 12,

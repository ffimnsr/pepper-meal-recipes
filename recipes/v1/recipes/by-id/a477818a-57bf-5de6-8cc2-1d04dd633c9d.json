  "id": "a477818a-57bf-5de6-8cc2-1d04dd633c9d",
  "slug": "guinness-chili-for-two-recipe-11692381",
  "name": "Guinness Chili for Two",
  "recipe_type": "soup",
  "brief_description": "This Guinness chili for two, inspired by the Irish draught ale, makes ordinary stew meat spectacular. A turn in the oven thickens the chili and deepens the flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Add oil to an oven-safe pot and place over medium heat. Add bacon and cook, stirring occasionally, until golden but not yet crispy, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Season stew cubes with salt and pepper. Place flour in a shallow bowl, and dredge cubes in flour, shaking off excess. Add to the pot and cook in bacon grease, mixing bacon in with beef until beef is browned on all sides. Pour in 1/2 cup beef broth to deglaze the pan and prevent sticking."
    },
    {
      "position": 3,
      "text": "Add onion and garlic to the pot; cook and stir until onion is just translucent, about 3 minutes. Add tomato paste, chili powder, oregano, cumin, paprika, and coriander. Stir to coat onion and meat with spices."
    },
    {
      "position": 4,
      "text": "Pour in Guinness; scrape up any bits on the bottom of the pot. Add tomato sauce and remaining beef broth; season with salt and pepper. Stir, then bring to a boil."
    },
    {
      "position": 5,
      "text": "Transfer to the preheated oven and bake, uncovered, uncovered until chili is thick and meat is tender, 1 1/2 to 2 hours. Stir stew every 30 minutes to prevent scorching; add a small amount of water or broth if stew seems too dry."
    },
    {
      "position": 6,
      "text": "Garnish each bowl with green onion and cilantro leaves."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "c3514402-dc19-538a-8436-8d7229d50008",
  "slug": "vegan-banh-mi",
  "name": "Vegan Banh Mi",
  "recipe_type": "salad",
  "brief_description": "Tempeh marinated in homemade vegan fish sauce meets toasty baguette cubes and crunchy pickled vegetables in this vegan banh mi bowl.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Warm Worcestershire sauce, tamari, water, mushroom, black bean paste, shallot, garlic clove, and seaweed in a saucepan over medium heat. Remove from heat and let cool. Drain sauce and discard the solids."
    },
    {
      "position": 3,
      "text": "Place tempeh in a bowl and pour 1/3 cup of the sauce on top. Marinate for 20 minutes, turning tempeh over halfway."
    },
    {
      "position": 4,
      "text": "Remove 1 teaspoon of the tempeh marinade and whisk together with vegan mayo and sriracha in a separate bowl. Refrigerate until needed."
    },
    {
      "position": 5,
      "text": "Arrange baguette pieces on the prepared baking sheet and drizzle olive oil on top. Toss and arrange bread into a single layer."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. Turn bread and cook until browned, about 8 minutes more. Transfer to a bowl."
    },
    {
      "position": 7,
      "text": "Place the tempeh on the baking sheet; reserve the liquid. Bake for 10 minutes, basting with some of the reserved marinade halfway through. Flip tempeh; bake, basting again, for 10 minutes more."
    },
    {
      "position": 8,
      "text": "Cut tempeh into cubes. Arrange the bread, tempeh, jalapeno slices, pickled daikon, carrot, cucumber, and cilantro into serving bowls. Top with sriracha mayo."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a3d13039-b326-5d22-8add-bbe6927473d3",
  "slug": "apple-pie-ii",
  "name": "Apple Pie II",
  "recipe_type": "dessert",
  "brief_description": "A cooked apple filling makes this pie deliciously juicy. Golden Delicious apples keep their shape well after baking, so you'll get beautiful slices.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine the apple juice, 1/2 cup white sugar, and butter in a large saucepan. Cook over medium heat, stirring occasionally, until sugar has melted. Add the apples and cook until fruit is tender, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Whisk remaining 1/2 cup sugar with the cornstarch. Stir into the fruit mixture, bring mixture to a boil, then cook until juices thicken, about 2 minutes. Allow filling to cool (it will continue to thicken as it cools)."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place a baking sheet on an oven rack."
    },
    {
      "position": 4,
      "text": "Roll out bottom crust to line a 9-inch pie pan. Roll out top crust and set aside. Pour cooled apple filling into the pie shell. Cover with the top crust and seal. Cut or poke holes in top crust to allow steam to escape."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven on baking sheet until crust is golden brown and filling is bubbly, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

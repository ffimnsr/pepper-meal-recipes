{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f771c74a-4cb1-5ef2-ab46-3a7dff81b4b5",
  "slug": "chocolate-fig-biscotti",
  "name": "Chocolate Fig Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Chocolate and figs are the perfect pair in these homemade biscotti dusted with a light sprinkle of cinnamon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly spray a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine flour and baking powder in a bowl."
    },
    {
      "position": 3,
      "text": "Combine butter, brown sugar, and white sugar in a separate bowl. Beat with an electric mixer until light and fluffy. Beat in 6 egg whites, one at a time. Stir in chocolate chips and vanilla extract. Stir in the flour mixture with a wooden spoon until smooth. Stir in figs with the wooden spoon."
    },
    {
      "position": 4,
      "text": "Divide the dough in two. Shape each half into a loaf about 12 inches long and 2 inches wide. Place the loaves 4 inches apart on the baking sheet; flatten tops slightly with your hand. Beat remaining egg white until foamy and brush over the tops. Lightly sprinkle cinnamon on the loaves after brushing on the egg white."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until light brown, 20 to 25 minutes. Let cool, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Lower oven temperature to 325 degrees F (165 degrees C)."
    },
    {
      "position": 7,
      "text": "Cut the baked loaves into 1/2-inch-thick diagonal slices using a serrated knife. Lay slices cut-side down on a baking sheet."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until browned and crisp, about 10 minutes. Cool on a wire rack."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

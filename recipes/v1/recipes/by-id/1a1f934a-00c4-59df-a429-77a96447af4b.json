  "id": "1a1f934a-00c4-59df-a429-77a96447af4b",
  "slug": "chocolate-pecan-pie-i",
  "name": "Chocolate Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This chocolate pecan pie is just like the classic, but with chocolate chips that melt into the filling for a rich, gooey twist to a holiday favorite.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine corn syrup, sugar, melted butter, eggs, and salt in a mixing bowl; beat with an electric mixer until combined."
    },
    {
      "position": 3,
      "text": "Stir in chocolate chips and pecans. Pour mixture into unbaked pie crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is golden and center is set, 40 to 50 minutes."
    },
    {
      "position": 5,
      "text": "Cool completely on a wire rack before slicing to get the perfect gooey texture. The pie will firm as it cools."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

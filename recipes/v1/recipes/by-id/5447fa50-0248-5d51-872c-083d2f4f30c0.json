  "id": "5447fa50-0248-5d51-872c-083d2f4f30c0",
  "slug": "saucy-sesame-gochujang-meatballs-recipe-11722466",
  "name": "Saucy Sesame Gochujang Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These saucy sesame gochujang meatballs feature convenient frozen meatballs in a sweet-spicy soy, sesame, and gochujang sauce. Serve them over jasmine rice as a main dish; they also make a tasty appetizer.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Arrange meatballs in a single layer on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until heated through, about 25 minutes, or cook meatballs according to package directions."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir soy sauce, brown sugar, rice vinegar, ketchup, gochujang, honey, ginger, garlic, sesame oil, water, and cornstarch together in a small saucepan; set aside."
    },
    {
      "position": 4,
      "text": "Near the end of meatball cooking time, heat sauce over medium-high heat until slightly thickened, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Add in the meatballs; toss to coat. Sprinkle with sesame seeds and garnish with sliced green onion."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

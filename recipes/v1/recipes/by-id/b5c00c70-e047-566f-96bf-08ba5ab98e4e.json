{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b5c00c70-e047-566f-96bf-08ba5ab98e4e",
  "slug": "tiktok-baked-spaghetti",
  "name": "TikTok Baked Spaghetti",
  "recipe_type": "main",
  "brief_description": "Get the recipe for TikTok's baked spaghetti which combines marinara and cheesy cream sauce for a comforting baked pasta dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons of the butter in a large nonstick skillet over medium-high heat. Add onion and 1/4 teaspoon of the salt; cook until softened, about 4 minutes. Add Italian seasoning and 1 teaspoon garlic; cook, stirring constantly, until fragrant, 1 minute. Add ground meat mix and 1 teaspoon of the salt; cook, stirring occasionally to crumble, until well browned and cooked through, 6 to 8 minutes. Add marinara sauce and basil; cook, stirring occasionally, until warmed through, about 3 minutes. Remove from heat and set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt remaining 2 tablespoons butter in a medium saucepan over medium heat. Add remaining 2 teaspoons garlic; cook, stirring constantly, until fragrant, about 1 minute. Add heavy cream; cook, whisking often, until thickened and coats the back of a spoon, 8 to 10 minutes. Remove from heat and gradually whisk in Parmesan cheese and remaining 1/2 teaspoon salt."
    },
    {
      "position": 5,
      "text": "Transfer pasta and cream mixture to a greased 13x 9 baking dish; toss gently to combine. Spread meat sauce evenly over pasta and sprinkle with mozzarella and crushed red pepper, if desired."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until bubbly and mozzarella is lightly browned, about 25 minutes. Let stand 10 minutes before serving. Recipe developed by Ali Ramee"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 35,

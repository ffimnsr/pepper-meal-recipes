  "id": "171088a2-a2b1-56ca-871a-a8eb687fafb1",
  "slug": "stuffed-tomatoes-with-grits-and-ricotta",
  "name": "Stuffed Tomatoes with Grits and Ricotta",
  "recipe_type": "appetizer",
  "brief_description": "Ricotta, Parmesan, and Asiago cheese flavor the tender grits that are stuffed into these tasty tomatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small pot combine dry grits, 1 1/2 cups water, and 3/4 teaspoon of salt. Bring to a boil, then simmer until grits are tender, 15 to 20 minutes. Cool."
    },
    {
      "position": 2,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Coat a baking sheet with nonstick cooking spray."
    },
    {
      "position": 3,
      "text": "Beat the eggs in a large bowl, then stir in the cooled grits, ricotta cheese, Parmesan cheese, and Asiago cheese. Stir in the garlic powder, parsley, crushed red pepper, and 1 teaspoon salt. Mix well."
    },
    {
      "position": 4,
      "text": "Slice the top off of each tomato. Use a spoon to hollow out the tomatoes, leaving the outer shells (approximately 1/4 inch thick) intact. Fill each with the grits mixture. Arrange stuffed tomatoes on prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until light golden brown, 30 to 40 minutes. Allow to cool slightly before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

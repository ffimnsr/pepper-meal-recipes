  "id": "79eddb36-0e95-5227-8ddf-5139db3f945b",
  "slug": "moms-pumpkin-pie",
  "name": "Mom's Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "Pumpkin puree is blended with white and brown sugars, milk, cream, and pinches of cinnamon, nutmeg, ginger, and cloves. Altogether, they make a rich and sensational pumpkin pie filling that bakes up perfectly for the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, combine eggs, egg yolk, white sugar and brown sugar. Add salt, cinnamon, nutmeg, ginger and cloves. Gradually stir in milk and cream. Stir in pumpkin. Pour filling into pie shell."
    },
    {
      "position": 3,
      "text": "Bake for ten minutes in preheated oven. Reduce heat to 350 degrees F (175 degrees C), and bake for an additional 40 to 45 minutes, or until filling is set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

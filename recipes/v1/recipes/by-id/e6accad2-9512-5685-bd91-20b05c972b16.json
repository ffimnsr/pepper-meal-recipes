  "id": "e6accad2-9512-5685-bd91-20b05c972b16",
  "slug": "italian-tiramisu",
  "name": "Italian Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "Tiramisu is a classic Italian dessert. Ladyfinger cookies are dipped in coffee, then layered with mascarpone and dusted with cocoa powder. It might become your new favorite dessert!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl beat together the egg yolks and 1/3 cup of sugar. Using a wooden spoon stir in mascarpone cheese, beaten egg whites, cream and kirschwasser; stir until smooth. Set aside."
    },
    {
      "position": 2,
      "text": "Dissolve remaining 2/3 cup sugar in coffee. Quickly, to avoid complete saturation, dip ends of ladyfingers in coffee mixture. Place ladyfingers in a single layer in a 9 x 13 inch glass baking dish. Spread a layer of cheese mixture over the ladyfingers; repeat layers, ending with cheese mixture."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate for several hours. Sprinkle with cocoa just before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "a2bdf172-fa69-5f27-ae8f-05aaa653395e",
  "slug": "freezer-door-key-lime-pie-margaritas-recipe-11977449",
  "name": "Freezer Door Key Lime Pie Margaritas",
  "recipe_type": "dessert",
  "brief_description": "These freezer door key lime pie margaritas come together right in the tequila bottle before chilling in the freezer for an easy make-ahead cocktail. For the best flavor, use a high-quality tequila, and don’t skip the graham cracker rim dipped in sweetened condensed milk—it’s the finishing touch that gives each sip its signature key lime pie-inspired flavor.",
  "cuisine": "Mexican American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour out 12 ounces of tequila from the bottle; reserve for another use."
    },
    {
      "position": 2,
      "text": "Add key lime juice, orange liqueur, and agave nectar directly into the tequila bottle. Replace cap and carefully shake until well combined."
    },
    {
      "position": 3,
      "text": "Place the bottle in the freezer door. Freeze for at least 4 hours."
    },
    {
      "position": 4,
      "text": "To prepare glasses, place graham cracker crumbs on a small plate. Dip rims of glasses into sweetened condensed milk, then dip into crumbs to coat. Fill glasses with ice."
    },
    {
      "position": 5,
      "text": "Remove bottle from freezer and gently shake to recombine. For each drink, pour 3 fluid ounces of the margarita mixture over ice in a cocktail shaker. For a sweeter drink, If desired, add 1 to 2 teaspoons of sweetened condensed milk. Cover and shake for about 1 minute to chill and dilute. Serve over ice. Garnish with key lime slices. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "f9d5478a-b662-5360-bca1-0082ca995174",
  "slug": "warm-dijon-potato-salad",
  "name": "Warm Dijon Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This warm potato salad is a combination of red potatoes, onion, and creamy Dijon mustard dressing for a tangy salad that's perfect for any gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and cut into cubes."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, Parmesan cheese, Dijon mustard, vinegar, cayenne pepper, salt, black pepper, and paprika together in a large bowl."
    },
    {
      "position": 4,
      "text": "Add potatoes, red onion, and green onions; gently toss to combine."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

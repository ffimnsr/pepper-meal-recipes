  "slug": "amaretto-eggnog",
  "name": "Amaretto Eggnog",
  "recipe_type": "drink",
  "brief_description": "Amaretto eggnog is easy to make by stirring a shot of amaretto liqueur into a mug of warm eggnog for a perfect pick-me-up for the holiday season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour eggnog into a microwave-safe mug. Heat in the microwave until warmed through, 30 seconds to 1 minute. Stir in amaretto liqueur."
    }

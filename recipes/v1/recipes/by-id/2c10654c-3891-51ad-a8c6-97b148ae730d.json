  "id": "2c10654c-3891-51ad-a8c6-97b148ae730d",
  "slug": "pork-stew-in-green-salsa-guisado-de-puerco-con-tomatillos",
  "name": "Pork Stew in Green Salsa (Guisado de Puerco con Tomatillos)",
  "recipe_type": "soup",
  "brief_description": "Tender chunks of pork are seasoned, browned, and simmered with tomatillos, cilantro, and green chilies to make a rich, flavorful stew. Serve with Spanish rice and warm tortillas.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, pepper, 1 teaspoon salt, and cumin in a large bowl. Dredge pork in flour mixture until well coated."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large, heavy pan or Dutch oven over medium-high heat until shimmers. Add pork, in batches, in a single layer; brown on all sides, about 15 minutes. Transfer pork to a bowl; cover to keep warm."
    },
    {
      "position": 3,
      "text": "Add onion to pan; cook and stir over medium heat, adding more olive oil if necessary, until translucent and beginning to brown, about 7 minutes. Return pork to pan; stir in tomatillos, water, canned chiles, 1/2 cup cilantro, jalape\u00f1os, garlic, and marjoram. Check seasoning; add 1 pinch salt, if needed. Cover and simmer over low heat, stirring occasionally, until pork tender, about 1 hour. Degrease stew before serving in bowls, garnished with sour cream and cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

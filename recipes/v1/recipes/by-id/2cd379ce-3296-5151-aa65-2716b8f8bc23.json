  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2cd379ce-3296-5151-aa65-2716b8f8bc23",
  "slug": "the-best-white-mac-and-cheese-recipe-11860436",
  "name": "The Best White Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This is the best white mac and cheese you'll ever eat \u2014a creamy baked variation of the oh-so-popular macaroni and cheese dish made with 6 different white colored cheeses and no roux.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Shred white Cheddar, mozzarella, smoked gouda, fontina, Parmesan, and provolone cheeses; set mozzarella aside. Combine white Cheddar, gouda, fontina, Parmesan, and provolone in a large bowl. Separate cheese mix into 3 piles: 3 cups for sauce, 1 1/2 cup to toss with noodles, 1 1/2 cup for topping."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Fill a large pot with half water and half chicken broth; bring to a boil. Add dried pasta and cook for 1 minute less than the package directs for al dente. Drain; then toss noodles with 1/2 teaspoon salt and 1/4 teaspoon pepper."
    },
    {
      "position": 4,
      "text": "Meanwhile, for cheese sauce, melt butter in a large saucepan over medium heat. Season with remaining salt, remaining black pepper, white pepper, onion powder, garlic powder, and dried mustard. Whisk until fully combined with butter, then add heavy cream, half-and-half, and 1 cup chicken broth."
    },
    {
      "position": 5,
      "text": "Whisk until seasonings and cream mixture are combined. Bring just to a simmer; reduce heat. Stir in 3 cups cheese mix, until melted. Add 1 cup shredded mozzarella (this will thicken your sauce) and stir to melt. Sprinkle thyme over sauce and slowly stir to combine."
    },
    {
      "position": 6,
      "text": "Beat eggs in a bowl. To temper the eggs, whisk eggs constantly while adding 1/4 cup hot cheese sauce in a slow, thin stream. Then do the same with 1/2 cup cheese sauce; repeat with another 1/2 cup. Transfer egg mixture to the pot of cheese sauce and combine well."
    },
    {
      "position": 7,
      "text": "Add drained and seasoned noodles to the prepared baking dish, and toss with 1 1/2 cup cheese mix, making sure each noodle is coated. Evenly pour cheese sauce over noodles; stir to combine fully. Let sit for 5 to 10 minutes to allow cheese sauce to settle, then stir again."
    },
    {
      "position": 8,
      "text": "Combine remaining 1 1/2 cup cheese mix with remaining 1 cup mozzarella. Sprinkle mixture on top of noodles."
    },
    {
      "position": 9,
      "text": "Bake macaroni and cheese in the preheated oven until top is bubbly and golden brown, 15 to 20 minutes."
    },
    {
      "position": 10,
      "text": "Bake macaroni and cheese in the preheated oven until top is bubbly and golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 12,

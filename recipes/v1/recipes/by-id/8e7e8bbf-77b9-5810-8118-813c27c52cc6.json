  "id": "8e7e8bbf-77b9-5810-8118-813c27c52cc6",
  "slug": "poached-salmon-in-coconut-lime-sauce-recipe-11994205",
  "name": "Poached Salmon in Coconut-Lime Sauce",
  "recipe_type": "main",
  "brief_description": "This poached salmon in coconut lime sauce has a Pacific Rim flair, with hints of ginger and garlic in the rich sauce. Ready in about a half hour, it is delicious served plain or over rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large nonstick skillet over medium heat. Add onion and cook, stirring occasionally, about 3 minutes. Stir in ginger and garlic and cook until garlic is fragrant, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Add coconut cream, stirring well to break up any solids. Stir in fish sauce, soy sauce, lime zest, and lime juice. Taste the sauce and season with salt and pepper. Bring to a boil, then reduce heat and simmer about 5 minutes."
    },
    {
      "position": 3,
      "text": "Pat salmon filets dry with paper towels, and add to the sauce, skin side down. Spoon some of the liquid over the top of each filet."
    },
    {
      "position": 4,
      "text": "Cover and cook until salmon flakes easily with a fork, about 10 minutes. An instant read thermometer should reach 130 degrees F (54 degrees C). Let salmon rest for 5 to 10 minutes before serving; the temperature will rise."
    },
    {
      "position": 5,
      "text": "Ladle sauce onto each plate, then add a salmon filet, and add a bit of sauce on top. Garnish with fresh cilantro sprigs and lime slices, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

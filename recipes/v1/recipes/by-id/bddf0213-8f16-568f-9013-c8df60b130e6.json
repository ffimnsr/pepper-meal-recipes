  "id": "bddf0213-8f16-568f-9013-c8df60b130e6",
  "slug": "apple-butter-spice-cake",
  "name": "Apple Butter Spice Cake",
  "recipe_type": "dessert",
  "brief_description": "This apple butter spice cake recipe features apple butter, sour cream, and wholesome bran cereal, crowned with a warm-spiced, brown sugar\u2013pecan topping.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, pecans, cinnamon, and nutmeg in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Sift flour, baking powder, baking soda, and salt into a bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Beat white sugar and butter together in a bowl with an electric mixer until light and fluffy; beat in eggs, one at a time, beating well after each addition. Stir in apple butter, bran cereal, and vanilla extract until incorporated. Add flour mixture, alternating with sour cream, mixing well after each addition."
    },
    {
      "position": 5,
      "text": "Pour \u00bd batter into the prepared baking dish; sprinkle with \u00bd brown sugar topping. Cover with remaining \u00bd batter; sprinkle with remaining \u00bd topping."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

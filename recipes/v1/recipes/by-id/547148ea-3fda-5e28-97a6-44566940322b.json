  "id": "547148ea-3fda-5e28-97a6-44566940322b",
  "slug": "spanish-rice-ii",
  "name": "Homemade Spanish Rice",
  "recipe_type": "side",
  "brief_description": "Rice is sauteed with onion and green bell pepper, and then simmered with water, chopped tomatoes and spices.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep skillet over medium heat. Saute rice, onion, and bell pepper until rice is browned and onions are tender."
    },
    {
      "position": 2,
      "text": "Stir in water and tomatoes. Season with chili powder and salt. Cover, and simmer for 30 minutes, or until rice is cooked and liquid is absorbed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,

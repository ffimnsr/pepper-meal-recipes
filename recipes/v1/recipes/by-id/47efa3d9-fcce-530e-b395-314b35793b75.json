  "id": "47efa3d9-fcce-530e-b395-314b35793b75",
  "slug": "tuna-and-macaroni-salad",
  "name": "Best Tuna Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This tuna pasta salad with bow tie noodles, canned tuna, celery, peas, and fresh dill tossed in a creamy mustard dressing is always a favorite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta at a boil, stirring occasionally, until almost tender, about 10 minutes. Add peas and continue cooking for 2 minutes. Drain pasta and peas and chill quickly by rinsing with cold water."
    },
    {
      "position": 3,
      "text": "Transfer pasta and peas to a large bowl. Mix in tuna, celery, green onion, dill, and carrot until well blended."
    },
    {
      "position": 4,
      "text": "Mix mayonnaise, mustard, salt, and pepper together in a small bowl; blend into tuna pasta mixture until well combined."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

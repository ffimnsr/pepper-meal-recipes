  "id": "f0f3f6f6-9f90-5142-80ec-9f1cafeb806a",
  "slug": "easy-mint-chocolate-chip-ice-cream",
  "name": "Easy Mint Chocolate Chip Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This homemade mint ice cream is loaded with chocolate chips and flavored with peppermint for a decadent, creamy, and super refreshing summer dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir milk, cream, sugar, vanilla, peppermint extract, and salt together in a large bowl until the sugar has dissolved. Mix in green food coloring."
    },
    {
      "position": 3,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions."
    },
    {
      "position": 4,
      "text": "Add chocolate chips about 10 minutes into the freezing. Continue churning until ice cream has thickened, about 20 minutes more."
    },
    {
      "position": 5,
      "text": "Transfer to an airtight container and freeze until firm, about 2 hours."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

  "id": "ad65d9db-37c0-5f2e-94fa-5e6350f28a39",
  "slug": "ultimate-pool-sandwich-recipe-8653433",
  "name": "The Ultimate Pool Sandwich",
  "recipe_type": "main",
  "brief_description": "Take a dip into this glorious stuffed sandwich this summer! The bread is baked with a butter and mustard mixture before being filled with meats, cheeses, and lettuce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut a wide circle out of the bread loaf top like you\u2019re making a soup bread bowl. Carefully remove and set aside the loaf top."
    },
    {
      "position": 3,
      "text": "Hollow out the bread interior, being careful not to break through the sides. The loaf interior can be used to make croutons, so there\u2019s no waste."
    },
    {
      "position": 4,
      "text": "Melt butter with mustard in the microwave for 15 seconds in a small bowl. Mix well."
    },
    {
      "position": 5,
      "text": "Brush butter mixture onto the exterior of the bread loaf and top; place loaf and top on a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 10 minutes. Let cool."
    },
    {
      "position": 7,
      "text": "Pat lettuce dry and place a layer in the bottom of the hollowed-out loaf. Layer cheese over lettuce. Add a layer of ham and turkey. Repeat until the loaf is full. Top with reserved bread top."
    },
    {
      "position": 8,
      "text": "Wrap sandwich in plastic wrap and put on a baking sheet. Place another baking sheet on top with something to weigh it down."
    },
    {
      "position": 9,
      "text": "Place the completed sandwich on the baking sheet in the refrigerator for at least 1 hour or overnight."
    },
    {
      "position": 10,
      "text": "Keep the sandwich whole or cut it into easy triangular sections."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

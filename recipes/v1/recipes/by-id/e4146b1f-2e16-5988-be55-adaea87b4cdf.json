{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e4146b1f-2e16-5988-be55-adaea87b4cdf",
  "slug": "griddle-cajun-shrimp-and-sausage-tortellini-recipe-12032673",
  "name": "Griddle Cajun Shrimp and Sausage Tortellini",
  "recipe_type": "main",
  "brief_description": "This griddle Cajun shrimp and sausage tortellini takes full advantage of your outdoor griddle, cooking the sausage, shrimp, vegetables, and cheese tortellini all at once. Finished in a creamy Cajun sauce, it\u2019s an easy dinner packed with bold, savory flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon of oil on a large outdoor griddle, such as a Blackstone, over medium heat."
    },
    {
      "position": 2,
      "text": "Add sausage and cook until browned and fat has rendered, about 3 minutes. Add onion, peppers, and celery to drippings. Add 1 teaspoon Cajun seasoning and cook, stirring occasionally until vegetables are tender, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, add 1 tablespoon oil to the other side of the griddle. Add tortellini and toss to coat lightly. Add water; cover with a griddle dome and cook for 3 to 4 minutes, uncovering and tossing halfway through."
    },
    {
      "position": 4,
      "text": "Push sausage mixture to the side and add remaining oil to the griddle. Season shrimp with Cajun seasoning and add to the oil. Cook, undisturbed 1-2 minutes or until lightly browned. Flip and cook 1 minute longer."
    },
    {
      "position": 5,
      "text": "Toss all ingredients together in the center of the griddle until well combined."
    },
    {
      "position": 6,
      "text": "Add cream and cook until thickened slightly, about one minute, stirring constantly. Add Parmesan and cook 1 to 2 minutes until creamy and well combined. Squeeze lemon on top and stir in fresh parsley. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

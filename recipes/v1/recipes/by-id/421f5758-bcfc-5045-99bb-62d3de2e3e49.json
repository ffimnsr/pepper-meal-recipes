  "id": "421f5758-bcfc-5045-99bb-62d3de2e3e49",
  "slug": "white-chocolate-pumpkin-spice-muffins",
  "name": "White Chocolate Pumpkin Spice Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This pumpkin spice muffin recipe is studded with white chocolate chips and flavored with vanilla and lemon extract. They're perfect for crisp fall days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 9 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk 1 \u00bd cups flour, white sugar, brown sugar, pumpkin pie spice, baking powder, and salt together in a large bowl until well combined. Set aside."
    },
    {
      "position": 3,
      "text": "Combine pumpkin pur\u00e9e, oil, milk, egg, vanilla extract, and lemon extract in a separate large bowl until smooth; stir into flour mixture until batter is just combined."
    },
    {
      "position": 4,
      "text": "Toss white chocolate chips and 1 tablespoon flour together in a small bowl until evenly coated; fold into batter. Spoon batter into the prepared muffin cups."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 20 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

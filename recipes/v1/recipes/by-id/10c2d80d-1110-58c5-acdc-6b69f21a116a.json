{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "10c2d80d-1110-58c5-acdc-6b69f21a116a",
  "slug": "stuffed-cabbage-rolls",
  "name": "Stuffed Cabbage Rolls",
  "recipe_type": "soup",
  "brief_description": "This cabbage rolls recipe features tender cabbage leaves filled with savory beef and rice, simmered in tomato soup for a Polish-inspired favorite.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and rice to a boil in a saucepan."
    },
    {
      "position": 3,
      "text": "Reduce heat to low, cover, and simmer until rice is tender and liquid has been absorbed, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large, wide saucepan of lightly salted water to a boil. Add cabbage leaves and cook for 2 to 4 minutes or until softened; drain."
    },
    {
      "position": 5,
      "text": "Combine ground beef, 1 cup of cooked rice, onion, beaten egg, 2 tablespoons of tomato soup, salt, and pepper in a large bowl; mix thoroughly."
    },
    {
      "position": 6,
      "text": "Spoon about 2 tablespoons of beef mixture onto each cabbage leaf."
    },
    {
      "position": 7,
      "text": "Bring one end of the cabbage leaf over the mixture."
    },
    {
      "position": 8,
      "text": "Roll and tuck in the ends to prevent the filling from falling out."
    },
    {
      "position": 9,
      "text": "Arrange cabbage rolls seam-side down in a large skillet over medium heat."
    },
    {
      "position": 10,
      "text": "Pour remaining tomato soup over the rolls."
    },
    {
      "position": 11,
      "text": "Cover and bring to a boil. Reduce heat to low and simmer, basting with the sauce often, until beef is cooked through, about 40 minutes.."
    },
    {
      "position": 12,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

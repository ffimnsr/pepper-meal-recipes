{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0a0550a9-7a16-515e-a71d-b7c09e199f4e",
  "slug": "steak-and-potato-pie",
  "name": "Steak and Potato Pie",
  "recipe_type": "main",
  "brief_description": "This English pub-style steak and potato pie is loaded with seasoned steak, carrots, potatoes, and onion in an herbaceous red wine-based sauce.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 3/4 cups flour and kosher salt in a large bowl. Cut lard into flour mixture until it resembles coarse bread crumbs. Add ice water, one tablespoon at a time, tossing to mix. Gather dough into a ball, divide it in half, and wrap each piece in plastic wrap. Refrigerate while you prepare the filling."
    },
    {
      "position": 2,
      "text": "Mix 2 1/2 tablespoons flour, 1/2 teaspoon thyme, paprika, pepper, ginger, and allspice together in a bowl. Dredge steak pieces in seasoned flour and set aside."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium-high heat. Stir in seasoned steak and onion; cook and stir until onion has softened and turned translucent and steak is browned on all sides, about 10 minutes. Pour in beef broth and red wine; simmer until sauce thickens, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Roll out one pastry crust on a lightly floured surface to fit a 10-inch pie plate. Place crust into the pie plate, cover it loosely with plastic, and refrigerate. Roll out top crust for the pie and set it aside."
    },
    {
      "position": 5,
      "text": "Stir potatoes and carrots into the skillet and simmer until tender, about 20 minutes. Remove from the heat and allow to cool slightly, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 7,
      "text": "Transfer cooled beef mixture to the pastry-lined pie plate. Sprinkle with remaining 1/2 teaspoon thyme, then cover with the top crust and crimp the edges to seal. Cut vents in the crust or prick with a fork to allow steam to escape."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until crust is golden and filling is bubbly, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 45,

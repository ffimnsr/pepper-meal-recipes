  "id": "1c602bde-0f75-54d3-b666-ad2f0cca6e94",
  "slug": "chocolate-pretzel-treats",
  "name": "Chocolate Pretzel Treats",
  "recipe_type": "dessert",
  "brief_description": "These pretzel-Hershey kiss treats topped with colorful M&Ms candies are a fun chocolaty treat that are so easy to make the kids can help you prep!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 175 degrees F (80 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange pretzels on a baking sheet in a single layer. Place a candy kiss on the center of each pretzel."
    },
    {
      "position": 3,
      "text": "Warm pretzels in the preheated oven until candy kisses are shiny and slightly softened, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Place a candy-coated chocolate piece atop the candy kiss on each pretzel; press down. Chill in the refrigerator for 10 minutes."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

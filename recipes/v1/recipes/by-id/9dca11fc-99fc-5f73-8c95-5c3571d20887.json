  "id": "9dca11fc-99fc-5f73-8c95-5c3571d20887",
  "slug": "easy-festive-focaccia",
  "name": "Easy Festive Focaccia",
  "recipe_type": "main",
  "brief_description": "With a bottom crust reminiscent of a deep-dish pizza, this easy festive focaccia combines hints of garlic, rosemary, and Parmesan with bursts of fresh tomato.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour 1/4 cup olive oil into the bottom of a 9x13-inch baking dish or rimmed baking sheet. Spread pizza crust over the surface to fit."
    },
    {
      "position": 3,
      "text": "Stir together 2 tablespoons olive oil, garlic, parsley, kosher salt, and pepper flakes in a small bowl. Brush oil mixture over the dough. Make indentations all over the surface of the dough by pressing your finger or the end of a wooden spoon into it."
    },
    {
      "position": 4,
      "text": "Create a festive wreath or Christmas tree shape in the center of the dough with rosemary sprigs, cherry tomatoes, and olives. Sprinkle with Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the edges are golden brown, about 17 minutes. Let cool slightly before slicing and serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

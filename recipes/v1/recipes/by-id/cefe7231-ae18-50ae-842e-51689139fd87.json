  "id": "cefe7231-ae18-50ae-842e-51689139fd87",
  "slug": "homemade-pickled-ginger-gari",
  "name": "Homemade Pickled Ginger (Gari)",
  "recipe_type": "side",
  "brief_description": "Pickled ginger, or gari, is served as a palate cleanser alongside sushi or sashimi to help enhance the flavors. Learn how easy it is to make your own.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut ginger into chunks."
    },
    {
      "position": 3,
      "text": "Place in a bowl, sprinkle with sea salt, and stir to coat. Let stand for about 30 minutes, then transfer to a clean lidded jar."
    },
    {
      "position": 4,
      "text": "Stir together rice vinegar and sugar in a saucepan until sugar has dissolved."
    },
    {
      "position": 5,
      "text": "Bring to a boil, then pour the boiling liquid over ginger root pieces in the jar."
    },
    {
      "position": 6,
      "text": "Allow the mixture to cool, then seal the jar. After a few minutes, the liquid may change to a slightly pinkish color; don't be alarmed. Store in the refrigerator for at least 1 week."
    },
    {
      "position": 7,
      "text": "Cut pieces of ginger into paper-thin slices for serving."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

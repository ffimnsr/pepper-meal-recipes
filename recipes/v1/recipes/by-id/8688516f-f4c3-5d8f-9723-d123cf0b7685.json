  "id": "8688516f-f4c3-5d8f-9723-d123cf0b7685",
  "slug": "sweet-matzo-brei",
  "name": "Sweet Matzo Brei",
  "recipe_type": "dessert",
  "brief_description": "This sweet matzo brei is a Passover recipe featuring matzo soaked in milk, sugar, and cinnamon, then fried like a pancake and served drizzled with honey.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Pass matzo sheets one at a time under cool running water briefly, then crumble into a large bowl. Stir in milk, eggs, cinnamon, sugar, and vanilla to form an evenly moist batter. Add more milk if batter is too dry."
    },
    {
      "position": 2,
      "text": "Heat butter in a large skillet over medium heat. Scoop a generous spoonful of batter into hot butter and flatten with the back of a spatula. Cook until golden brown, 3 to 5 minutes per side. Repeat with remaining batter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

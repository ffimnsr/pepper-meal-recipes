  "id": "10a919c2-4f06-5739-8746-8bea043dd4ec",
  "slug": "antipasto-squares",
  "name": "Antipasto Squares",
  "recipe_type": "appetizer",
  "brief_description": "These antipasto squares, made with layers of roasted red bell pepper, deli meats, and cheeses baked inside a crescent roll crust, are perfect for sharing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 C)."
    },
    {
      "position": 2,
      "text": "Unroll one package of crescent roll dough; arrange in the bottom of a 9x13 inch pan. Layer ham, provolone cheese, Swiss cheese, salami, pepperoni, and red peppers on top of dough."
    },
    {
      "position": 3,
      "text": "Beat eggs lightly in a bowl; stir in Parmesan cheese and black pepper. Pour 3/4 of the egg mixture over peppers. Unroll remaining dough and arrange over the top of the peppers; brush with remaining egg mixture. Cover with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 minutes. Remove foil and bake until dough is fluffy and golden brown, another 10 to 20 minutes. Cut into squares; serve warm, or at room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "pumpkin-ice-cream-for-ninja-creami",
  "name": "Pumpkin Ice Cream for Ninja Creami",
  "recipe_type": "dessert",
  "brief_description": "Try this easy pumpkin ice cream developed for the Ninja Creami.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Com,bine pumpkin pie spice coffee creamer, pumpkin butter, milk, pumpkin syrup and pumpkin spice in a bowl. Use a hand mixer or immersion blender to fully incorporate all ingredients. Pour into Ninja Creami\u00ae pint container. Freeze for 24 hours."
    },
    {
      "position": 2,
      "text": "Following manufacturers instructions, insert pint container into outer bowl. Push 'Ice Cream' button. When done spinning, push 'Re-spin' button."
    }
  ],

  "id": "c08fa7ce-543b-5680-b88b-1b47b5996711",
  "slug": "deer-poppers",
  "name": "Deer Poppers",
  "recipe_type": "appetizer",
  "brief_description": "I recently took these to a Halloween party and they did not make it to the barn where the party was at! I bet 15 people asked me for the recipe. If you don't like the gamey taste of deer meat this recipe is for you!! These make great appetizers. Even people who don't like deer meat liked these!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season the venison meat with Greek seasoning and steak seasoning. Place in a bowl, and pour in enough Italian dressing to cover. Refrigerate for at least 2 hours to marinate, but preferably overnight."
    },
    {
      "position": 2,
      "text": "Preheat the grill for medium heat. Drain the marinade from the meat, and discard the marinade. Place a slice of jalapeno on top of a piece of meat, then wrap with a slice of bacon. Secure with a soaked toothpick. Repeat with remaining meat."
    },
    {
      "position": 3,
      "text": "Grill the deer poppers for 15 to 20 minutes, turning occasionally to brown the bacon. Serve and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "medium",

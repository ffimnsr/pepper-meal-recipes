  "schema_version": 1,
  "id": "9b343c86-e891-577f-9e26-a1b78e39a116",
  "slug": "italian-stuffed-cubanelle-peppers",
  "name": "Italian Stuffed Cubanelle Peppers",
  "recipe_type": "main",
  "brief_description": "This recipe for Cubanelle peppers features a stuffing of sausage, Italian bread crumbs, rice, and 3 types of cheese for a tasty, family-friendly dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir sausage in a large skillet over medium heat until crumbly and lightly browned, 5 to 8 minutes. Drain excess grease and transfer sausage to a medium bowl."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon olive oil in the same skillet over medium heat. Cook and stir onion and garlic in hot oil until fragrant, 3 to 5 minutes. Stir in sausage, bread crumbs, Monterey Jack cheese, mozzarella cheese, beaten egg, cooked rice, Romano cheese, and parsley until well combined. Season with salt and black pepper. Transfer to a large bowl."
    },
    {
      "position": 4,
      "text": "Wipe out the skillet and heat remaining 1 tablespoon olive oil over medium heat. Cook and stir Cubanelle peppers in hot oil until lightly browned, 3 to 5 minutes. Remove to a plate to cool slightly."
    },
    {
      "position": 5,
      "text": "Stuff Cubanelle peppers with rice mixture, using a teaspoon to push it into the tip. Arrange stuffed peppers in a 10x13-inch baking dish; cover the dish with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until peppers are tender, about 45 minutes. Remove foil and continue baking for 15 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

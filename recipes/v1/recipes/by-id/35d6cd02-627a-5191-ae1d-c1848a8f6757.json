  "id": "35d6cd02-627a-5191-ae1d-c1848a8f6757",
  "slug": "pumpkin-chocolate-truffles",
  "name": "Pumpkin Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "These yummy little pumpkin chocolate truffles are rich and addictive. You can sprinkle them with powdered sugar or roll them in pumpkin seeds, coconut, or cocoa powder.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine crushed cookies, ground almonds, powdered sugar, and pumpkin spice in a bowl. Mix in coffee liqueur, melted chocolate chips, pumpkin puree, and pumpkin syrup until combined but sticky. Place in freezer until firm, 30 to 50 minutes."
    },
    {
      "position": 2,
      "text": "Roll mixture into 1-inch balls. Sprinkle each ball with powdered sugar and top with 1 pumpkin seed."
    }
  ],

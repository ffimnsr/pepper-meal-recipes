  "id": "9834f076-9f13-5dfc-b514-d40c5b1cce9d",
  "slug": "sambousa",
  "name": "Sambousa",
  "recipe_type": "appetizer",
  "brief_description": "This sambousa recipe for Middle Eastern-style egg rolls features a savory mix of cooked ground lamb or beef, minced carrots, onions, and seasonings.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly. Remove beef from the skillet."
    },
    {
      "position": 2,
      "text": "Saut\u00e9 carrot, onion, green onion, chile pepper, and garlic in the same skillet over medium heat until tender. Stir in tomato paste and season with seasoning salt. Stir in browned beef until well combined."
    },
    {
      "position": 3,
      "text": "Stir together flour and water in a small bowl until a watery paste is formed. Lay an egg roll strip on a clean work surface. Place a teaspoonful of meat mixture in the front part of strip. Starting from the right front corner, fold over to the left. You've started the triangle shape. Continue back and forth (making a triangular shape) until there is no more wrapper. Seal wrapper closed with paste. Continue this process until all of the strips and meat mixture are used."
    },
    {
      "position": 4,
      "text": "Heat oil in a large pot over high heat. Fry egg rolls in hot oil until crisp and golden. Drain on a paper towel-lined plate."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

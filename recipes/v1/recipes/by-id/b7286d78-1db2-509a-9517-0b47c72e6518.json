  "id": "b7286d78-1db2-509a-9517-0b47c72e6518",
  "slug": "garlic-top-sirloin-pot-roast",
  "name": "Garlic Top Sirloin Pot Roast",
  "recipe_type": "main",
  "brief_description": "A top sirloin roast is cooked in the slow cooker with lots of garlic, beef stock, potatoes, onions, and carrots until perfectly tender and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine salt, pepper, and paprika in a small bowl; rub into roast. Make slits in the top of the roast with a small knife; press the garlic slivers into the slits."
    },
    {
      "position": 2,
      "text": "Place potatoes, carrots, and onions into a large slow cooker; place roast on top of vegetables. Pour in water and beef broth; add bouillon cubes and bay leaf."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 8 hours or High for 6 hours. Stir in green peppers for the last half hour of cooking."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,

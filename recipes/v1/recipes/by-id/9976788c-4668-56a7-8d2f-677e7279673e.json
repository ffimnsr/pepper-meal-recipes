  "schema_version": 1,
  "id": "9976788c-4668-56a7-8d2f-677e7279673e",
  "slug": "risotto-with-asparagus-and-bison-bacon",
  "name": "Risotto with Asparagus and Bison Bacon",
  "recipe_type": "main",
  "brief_description": "This recipe is a hearty take on the traditional risotto dish, complete with asparagus and bison bacon.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F. Place asparagus in single layer in a 15x10x1-inch baking pan. Drizzle with olive oil. Bake, uncovered, for 8 minutes or until crisp-tender. Cool slightly. Cut into bite-size pieces; set aside."
    },
    {
      "position": 2,
      "text": "Melt butter over medium heat in a large saucepan. Cook onion in hot butter for 4 to 5 minutes or until tender. Add rice. Cook and stir for 2 minutes. Carefully stir in broth and pepper. Bring to boiling; reduce heat. Simmer, covered, for 20 minutes (do not lift lid)."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook bison bacon, 1/2 at a time, over medium heat in a large skillet for 5 to 6 minutes per batch or until crisp, turning occasionally. If necessary, drain on paper towels. Transfer to a cutting board. Cool slightly; chop into bite-size pieces."
    },
    {
      "position": 4,
      "text": "Remove saucepan from heat. Stir in asparagus. Let stand, covered, for 5 minutes. Stir in bison bacon pieces and Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9d70e5e1-b97e-524c-a0a6-cb4c5c703bf6",
  "slug": "creamy-sausage-tortellini-soup-recipe-8722710",
  "name": "Creamy Sausage Tortellini Soup",
  "recipe_type": "salad",
  "brief_description": "This creamy sausage tortellini soup is loaded with hot Italian sausage and veggies. It\u2019s a comforting full meal with a side salad and some crusty bread.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place sausage, celery, carrots and onions in a Dutch oven over medium heat. Cook and stir until sausage is browned and veggies are tender, 7 to 9 minutes. Add garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Stir in flour and until well incorporated. Pour in chicken broth, scraping bottom of pot to release all browned bits. Cook for 1 minute. Add diced tomatoes and Italian seasoning; bring to a boil."
    },
    {
      "position": 3,
      "text": "Reduce heat, add tortellini, and simmer for 5 minutes. Add cream; cook and stir for 5 more minutes. Add mozzarella cheese and stir until melted; stir in spinach. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

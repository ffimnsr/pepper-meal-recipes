  "slug": "strawberry-melon-summer-salad",
  "name": "Strawberry-Melon Summer Salad",
  "recipe_type": "salad",
  "brief_description": "A lightly sweet lemon yogurt and honey dressing adds to this refreshing and colorful strawberry-melon summer salad recipe with cantaloupe and watermelon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk yogurt, honey, and lemon juice together in a large bowl until combined. Gently stir in watermelon, cantaloupe, and strawberries until evenly coated."
    }

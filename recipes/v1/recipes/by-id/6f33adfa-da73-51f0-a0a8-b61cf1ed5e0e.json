  "slug": "lemon-cream-cheese-frosting",
  "name": "Lemon Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "This tangy lemon cream cheese frosting is super easy to make with just 5 simple ingredients: lemon, cream cheese, butter, vanilla, and sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, butter, lemon juice, lemon zest, and vanilla together in a large bowl using an electric mixer until smooth and fluffy; gradually beat in confectioners' sugar, 1 cup at a time, until desired consistency is reached."
    }
  ],

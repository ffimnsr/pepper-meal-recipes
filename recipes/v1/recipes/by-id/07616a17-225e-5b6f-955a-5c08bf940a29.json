  "id": "07616a17-225e-5b6f-955a-5c08bf940a29",
  "slug": "lemon-ricotta-muffins-recipe-11826885",
  "name": "Lemon Ricotta Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These lemon ricotta muffins, topped with a quick lemon glaze, are delightful for breakfast or brunch. Ricotta cheese makes them tender and light.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Line a 12-cup muffin tin or spray with nonstick spray."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking powder, baking soda, and salt together in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar, ricotta, and butter together in a large bowl with an electric mixer until light and fluffy, about 2 minutes. Add egg, lemon zest, and juice, and mix on low speed until just combined."
    },
    {
      "position": 4,
      "text": "Add flour mixture and mix until just combined. The mixture will be thick. Scoop batter evenly into muffin cups, filling to the top."
    },
    {
      "position": 5,
      "text": "Bake until a toothpick inserted near the center comes out clean, 21 to 24 minutes. Cool in pan for 5 minutes, then transfer muffins to a wire rack to cool completely."
    },
    {
      "position": 6,
      "text": "For glaze, whisk confectioner\u2019s sugar with lemon juice until smooth in a small bowl."
    },
    {
      "position": 7,
      "text": "Drizzle over cooled muffins and let set."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

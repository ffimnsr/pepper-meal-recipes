  "id": "e34f853e-d1db-55c8-8ae3-85bdb4658ca6",
  "slug": "gayes-microwave-fudge",
  "name": "Gaye's Microwave Fudge",
  "recipe_type": "dessert",
  "brief_description": "This chocolaty microwave fudge made with confectioners' sugar, cocoa, milk, and butter is a quick and easy solution to your sugar craving!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x9-inch dish. Stir confectioners' sugar and cocoa together in a microwave-safe bowl; add butter and pour in milk but do not mix."
    },
    {
      "position": 2,
      "text": "Microwave until butter is melted, about 2 minutes. Stir in vanilla, mixing vigorously until smooth. Pour into the prepared dish."
    },
    {
      "position": 3,
      "text": "Chill in the freezer for 10 minutes before cutting into squares."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 2,

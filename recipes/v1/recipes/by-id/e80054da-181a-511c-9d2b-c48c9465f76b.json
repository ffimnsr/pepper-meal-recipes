  "id": "e80054da-181a-511c-9d2b-c48c9465f76b",
  "slug": "slow-cooker-corned-beef-and-cabbage",
  "name": "Slow-Cooker Corned Beef and Cabbage",
  "recipe_type": "main",
  "brief_description": "This slow cooker corned beef is a foolproof and delicious St. Patrick's Day dinner that cooks all day and lets you celebrate the easy way!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes, carrots, and onion into the bottom of a slow cooker; add water and place brisket on top of vegetables."
    },
    {
      "position": 3,
      "text": "Pour beer over brisket; sprinkle over spices from the packet and cover."
    },
    {
      "position": 4,
      "text": "Cook on High for 5 hours; stir in cabbage and cook for 1 more hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

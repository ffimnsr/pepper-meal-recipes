  "id": "2f7d27d1-9795-5b13-bb05-674fd9d19a1d",
  "slug": "ice-cream-base",
  "name": "Custard Ice Cream Base",
  "recipe_type": "dessert",
  "brief_description": "This ice cream base makes a classic custard ice cream with egg yolks, heavy cream, and sugar for the richest, smoothest, creamiest homemade ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat heavy cream and half-and-half in a heavy-bottomed saucepan over medium-low heat until barely simmering, stirring frequently. Reduce heat to low."
    },
    {
      "position": 3,
      "text": "Whisk egg yolks, sugar, and salt together in a large bowl until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Slowly pour about 1/2 cup of hot cream mixture into egg yolk mixture, whisking constantly. Repeat three times more, whisking thoroughly before adding each additional 1/2 cup of hot cream to egg yolk mixture. Pour egg yolk mixture back into the saucepan with remaining hot cream, and whisk constantly over medium-low heat until the mixture thickens and will coat the back of a spoon, 5 to 8 minutes. Do not let mixture boil."
    },
    {
      "position": 5,
      "text": "Pour ice cream base into a bowl and allow to cool for about 20 minutes; place in refrigerator and chill overnight."
    },
    {
      "position": 6,
      "text": "The next day, pour into an ice cream maker, and freeze according to the manufacturer's directions."
    },
    {
      "position": 7,
      "text": "Remove the ice cream, pack into a covered container, and freeze for 2 hours or overnight before serving. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "c3eb731b-d698-5ae3-bab0-01d8de46fb6a",
  "slug": "uova-in-purgatorio-eggs-in-purgatory",
  "name": "Eggs in Purgatory",
  "recipe_type": "breakfast",
  "brief_description": "Eggs in purgatory is a classic Italian recipe that poaches eggs in a rich and flavorsome garlic and tomato sauce for an amazing breakfast or brunch.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over low heat. Add garlic, olives, capers, and anchovy; cook for 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Add tomato sauce and water, bring to a boil, and simmer until flavors combine, about 10 minutes. Add parsley and season with salt."
    },
    {
      "position": 4,
      "text": "Gently add eggs directly into tomato sauce without breaking the yolks. Cook until eggs are just cooked, 3 to 5 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "9a2bd3a7-66c8-5159-8248-3c979fe60792",
  "slug": "easy-polenta-with-tomato-sauce",
  "name": "Easy Polenta with Tomato Sauce",
  "recipe_type": "side",
  "brief_description": "My entire family loves this recipe for cheesy polenta with tomato sauce. Sprinkle extra Parmesan over top if desired. Leftovers are delicious!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Bring milk and chicken stock to a rolling boil in a large pot over medium-high heat. Gradually whisk in cornmeal, making sure there are no lumps. Reduce the heat to low and simmer, stirring constantly, until thick, about 5 minutes. Remove from the heat and stir in Parmesan cheese."
    },
    {
      "position": 3,
      "text": "Pour polenta into the prepared baking dish and spread spaghetti sauce over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until sauce is bubbling, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "325a5541-8854-5300-8f3f-d2ef9dde5c8f",
  "slug": "pattis-triple-cranberry-sauce",
  "name": "Patti's Triple Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "Fresh and dried cranberries cook with cranberry juice and orange flavors for a bright, jewel-like cranberry sauce they'll all be talking about. Serve it in a beautiful glass dish or compote.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir the cranberry juice concentrate and sugar together in a saucepan over medium-high heat, and bring to a boil, stirring until sugar has dissolved. Mix in the fresh and dried cranberries, reduce heat to medium, and cook until the dried cranberries soften and the fresh ones pop, 7 to 10 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Mix in the orange marmalade, orange juice, orange peel, and allspice until thoroughly combined. Allow the cranberry sauce to cool completely. Pour into glass serving dish, cover, and chill until cold, at least 2 hours. Can be made up to 2 days ahead of time and refrigerated until serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

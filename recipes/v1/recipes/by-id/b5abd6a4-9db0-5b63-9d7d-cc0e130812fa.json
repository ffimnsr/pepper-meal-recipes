  "id": "b5abd6a4-9db0-5b63-9d7d-cc0e130812fa",
  "slug": "summer-berry-fool-recipe-12016208",
  "name": "Summer Berry Fool",
  "recipe_type": "dessert",
  "brief_description": "This summer berry fool is an easy, fresh twist on the beloved British dessert, showcasing the best of summer strawberries, raspberries, and blueberries. Light, creamy, and simple to make, it\u2019s a beautiful way to celebrate berry season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add strawberries and raspberries to a bowl; stir in sugar and lemon juice. Cover and refrigerate for at least 15 to 20 minutes, or until ready to serve."
    },
    {
      "position": 2,
      "text": "Meanwhile beat cream and powdered sugar together in a bowl with an electric mixer until stiff peaks form. Keep chilled until ready to serve."
    },
    {
      "position": 3,
      "text": "When ready to serve, mash fruit mixture slightly with a fork to break up some of the pieces and thicken the sauce slightly."
    },
    {
      "position": 4,
      "text": "Fold about 1/2 cup fruit into whipped cream 2 to 3 times. Add another 1/2 cup to the cream mixture and fold another 2 to 3 times."
    },
    {
      "position": 5,
      "text": "Divide cream mixture among serving cups. Top with remaining berry mixture and crumble cookies on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

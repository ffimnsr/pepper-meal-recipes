  "id": "3b480cbf-037a-58e4-b136-991d98c432bf",
  "slug": "apple-yam-casserole",
  "name": "Apple Yam Casserole",
  "recipe_type": "dessert",
  "brief_description": "What Americans call yams are actually a variety of sweet potato. Fragrant sweet potatoes layered with Granny Smith apples and topped with a sweet mixture of brown sugar and raisins make this a great recipe for all holidays, but best for Thanksgiving and Christmas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 2 quart casserole dish."
    },
    {
      "position": 2,
      "text": "In the casserole dish, alternately layer the sweet potatoes and apples."
    },
    {
      "position": 3,
      "text": "In a medium saucepan over medium heat, mix together brown sugar, 1/3 cup water, cinnamon, raisins, butter and salt. Cook 5 minutes."
    },
    {
      "position": 4,
      "text": "In a small bowl, stir together remaining water and flour. Combine with the brown sugar mixture. Pour over the sweet potatoes and apples. Place the lemon slices on top."
    },
    {
      "position": 5,
      "text": "Bake covered in the preheated oven 20 minutes. Uncover and continue baking 20 minutes, or until the sweet potatoes and apples are tender."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

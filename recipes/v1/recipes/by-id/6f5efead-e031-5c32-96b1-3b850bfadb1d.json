  "id": "6f5efead-e031-5c32-96b1-3b850bfadb1d",
  "slug": "marry-me-pork-chops-recipe-11993270",
  "name": "Marry Me Pork Chops",
  "recipe_type": "main",
  "brief_description": "These \u201cmarry me\u201d pork chops are a one-dish meal, baked in a rich Parmesan and sun-dried tomato sauce with tender orzo and spinach that soak up every bit of flavor. Indulgent enough to feel special, it\u2019s still easy enough for a weeknight.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a lightly greased casserole dish mix together orzo, chicken bone broth, cream, garlic, sundried tomatoes, spinach, half the Parmesan, half each of Italian seasoning, smoked paprika, and pepper."
    },
    {
      "position": 3,
      "text": "Nestle pork chops into the casserole so that the bottom halves of chops sit in the broth mixture. Season tops with remaining Italian seasoning, smoked paprika, and pepper; sprinkle with salt and red pepper flakes. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 to 35 minutes. Uncover and add remaining Parmesan cheese. Bake for another 10 minutes. An instant read thermometer inserted in the center of pork chops should reach 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

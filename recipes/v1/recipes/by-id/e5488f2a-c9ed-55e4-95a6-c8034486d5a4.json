  "id": "e5488f2a-c9ed-55e4-95a6-c8034486d5a4",
  "slug": "homemade-copycat-kitkat-bars-recipe-11893977",
  "name": "Homemade Copycat KitKat Bars",
  "recipe_type": "dessert",
  "brief_description": "These homemade copycat kitkat bars are layered, crunchy, and coated with chocolate, a bit like KitKat meets Twix. Buttery crackers provide the crunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange 30 crackers in a single layer on the bottom of a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Add butter, brown sugar, and white sugar to a saucepan over medium heat and bring to a simmer, stirring often. Add milk, salt, and vanilla and stir until well combined. Cook for 2 minutes. Remove from heat. Stir in graham cracker crumbs."
    },
    {
      "position": 3,
      "text": "Pour half of sugar mixture over crackers and top with 30 more crackers. Pour remaining sugar mixture over and top with remaining crackers."
    },
    {
      "position": 4,
      "text": "Place chocolate chips and coconut oil in a microwave safe bowl. Microwave on High in 20- to 30-second intervals, stirring in between, until just melted. Pour melted chocolate over the top layer of crackers and spread evenly all the way to the edges. Refrigerate until set, at least 30 minutes."
    },
    {
      "position": 5,
      "text": "Cut into 30 bars."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

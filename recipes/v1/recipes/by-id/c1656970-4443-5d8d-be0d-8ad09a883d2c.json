  "id": "c1656970-4443-5d8d-be0d-8ad09a883d2c",
  "slug": "vegetarian-shepherds-pie-ii",
  "name": "Vegetarian Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This vegetarian shepherd's pie is loaded with healthy lentils, barley, and veggies baked in a savory gravy and topped with fluffy mashed potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 1 \u00bc cups broth, lentils, barley, and yeast extract in a large saucepan over medium-low heat; simmer for 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine remaining 3/4 cup broth, carrot, onion, and walnuts in a medium saucepan over medium heat; cook until tender, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender but still firm, about 15 minutes. Drain and mash."
    },
    {
      "position": 5,
      "text": "Combine flour and water in a small bowl; stir into carrot mixture and simmer until thickened. Combine carrot and lentil mixtures; season with salt and black pepper."
    },
    {
      "position": 6,
      "text": "Transfer carrot-lentil mixture to a 2-quart casserole dish; spoon mashed potatoes over top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until lightly browned on top, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

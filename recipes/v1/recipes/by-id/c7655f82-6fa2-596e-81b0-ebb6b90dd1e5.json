  "id": "c7655f82-6fa2-596e-81b0-ebb6b90dd1e5",
  "slug": "down-home-chitterlings",
  "name": "Down Home Chitterlings",
  "recipe_type": "main",
  "brief_description": "Chitterlings, made from pigs' intestines, are a favorite among Southern families. They are typically served with greens, vinegar, and hot sauce.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place cleaned chitterlings in a 6-quart pot and cover with cold water."
    },
    {
      "position": 3,
      "text": "Bring to a rolling boil; add onion and season with salt, garlic, and red pepper flakes."
    },
    {
      "position": 4,
      "text": "Simmer until chitterlings are clear to white in color and reach desired tenderness, 3 to 4 hours."
    }
  ],
  "servings": 12,

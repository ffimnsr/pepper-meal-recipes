  "id": "9a71d21f-dc7a-5d9e-82d4-815c84d824b6",
  "slug": "cowboy-caviar",
  "name": "Cowboy Caviar",
  "recipe_type": "appetizer",
  "brief_description": "This cowboy caviar is a crowd-pleasing dip made with black-eyed peas, beans, tomatoes, corn, onion, and cilantro tossed in a vinaigrette dressing.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix black beans, black-eyed peas, diced tomatoes, corn, onion, bell pepper, and jalape\u00f1o peppers together in a large bowl."
    },
    {
      "position": 3,
      "text": "Season with garlic salt, then pour in Italian salad dressing and add cilantro. Mix until well coated."
    },
    {
      "position": 4,
      "text": "Refrigerate until flavors have melded, at least 20 minutes or up to 3 days, before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

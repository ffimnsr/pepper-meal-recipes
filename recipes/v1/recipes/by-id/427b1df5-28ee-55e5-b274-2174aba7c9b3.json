  "id": "427b1df5-28ee-55e5-b274-2174aba7c9b3",
  "slug": "pecan-pie-bites-from-scratch",
  "name": "Pecan Pie Bites from Scratch",
  "recipe_type": "dessert",
  "brief_description": "For a new family favorite during the holidays, let your kids help you prepare these simple pecan pie bites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter and cream cheese for crust with an electric mixer until smooth. Add flour and mix until fully combined. Cover and refrigerate dough for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Remove dough from the refrigerator. Spray a 24-cup mini-muffin tin with nonstick spray."
    },
    {
      "position": 3,
      "text": "Whisk brown sugar, egg, melted butter, and vanilla for filling in a bowl until smooth."
    },
    {
      "position": 4,
      "text": "Roll dough into twenty four 1-inch balls. Press each ball into a muffin cup, so it spreads evenly on the bottom and up the sides. Sprinkle about 1 teaspoon pecans into each muffin cup, then top with about the same amount of egg mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is set, 25 to 30 minutes. Cool on a wire rack for 10 minutes, then remove from the muffin tins."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,

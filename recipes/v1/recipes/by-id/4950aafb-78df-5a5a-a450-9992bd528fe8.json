  "id": "4950aafb-78df-5a5a-a450-9992bd528fe8",
  "slug": "air-fryer-bbq-baby-back-ribs",
  "name": "Air Fryer BBQ Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "These air fryer ribs are juicy, finger-licking delicious with mouthwatering flavor thanks to an easy homemade spice rub and barbeque glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Strip membrane from the back of ribs. Cut ribs into 4 equal portions."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, white sugar, sweet paprika, smoked paprika, granulated garlic, pepper, cumin, onion, and Greek seasoning in a small bowl."
    },
    {
      "position": 4,
      "text": "Rub spice mixture all over ribs. Place ribs in the air fryer basket."
    },
    {
      "position": 5,
      "text": "Cook ribs in the preheated air fryer for 30 minutes, turning once halfway. Brush with barbeque sauce, then air-fry for 5 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

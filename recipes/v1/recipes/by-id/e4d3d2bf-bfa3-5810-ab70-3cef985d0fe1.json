  "slug": "fresh-sweet-cranberry-sauce-with-a-twist",
  "name": "Fresh Sweet Cranberry Sauce with a Twist",
  "recipe_type": "dessert",
  "brief_description": "This is an easy, homemade cranberry sauce recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir sugar, water, and cinnamon together in a saucepan; bring to a boil. Add cranberries to the boiling water mixture and cook until they begin to pop, about 10 minutes. Pour cranberry mixture into a glass bowl."
    },
    {
      "position": 2,
      "text": "Refrigerate, stirring occasionally, until completely chilled."
    }
  ],

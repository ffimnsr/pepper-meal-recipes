  "id": "39bfa92a-c28d-5b42-ba3e-b8436cb12eb7",
  "slug": "peanut-butter-fudge-with-marshmallow-creme",
  "name": "Peanut Butter Fudge with Marshmallow Creme",
  "recipe_type": "dessert",
  "brief_description": "This fluffy peanut butter fudge with marshmallow creme is rich, creamy, and comes together quickly for a sweet holiday treat that's always popular!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x13 inch pan with foil or parchment paper."
    },
    {
      "position": 2,
      "text": "Combine sugar, evaporated milk, and butter In a medium saucepan. Cook over medium heat stirring frequently until it comes to a boil. Boil for 10 minutes, remove from heat and stir in peanut butter and marshmallow creme."
    },
    {
      "position": 3,
      "text": "Pour into the prepared pan and chill until set. Cut into squares and serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

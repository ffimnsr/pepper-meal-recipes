  "id": "aec63a81-380c-5519-9a78-d9e35bbddfe5",
  "slug": "cranberry-corn-bread",
  "name": "Cranberry Cornbread",
  "recipe_type": "dessert",
  "brief_description": "This delicious cranberry cornbread uses sweet and tangy cranberries to add flavor and color to a cornbread that's perfect for the holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Toss cranberries with 1 tablespoon sugar in a bowl; set aside. Whisk flour, cornmeal, \u00bd cup sugar, baking powder, baking soda, and salt together in a separate bowl."
    },
    {
      "position": 3,
      "text": "Whisk milk, eggs, and melted butter together in a third bowl; stir into flour mixture just until batter moistened. Stir cranberries into batter; pour into the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cornbread is golden brown, 18 to 20 minutes. Cool completely in the pan before cutting into squares."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

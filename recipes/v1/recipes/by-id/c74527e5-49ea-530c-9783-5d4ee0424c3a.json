  "name": "Strawberry Jargarita",
  "recipe_type": "drink",
  "brief_description": "You can use any type of jam for this jammy vodka drink. Also a great way to use up the last bits of jam in the glass - just use the jam glass as your shaker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add strawberry preserves, tequila, orange liqueur, fresh lime juice, and ice to a jar fitted with a lid or shaker. Close jar and shake until slightly frothy."
    }
  ],

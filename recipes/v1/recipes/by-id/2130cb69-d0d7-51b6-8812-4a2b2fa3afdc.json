{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2130cb69-d0d7-51b6-8812-4a2b2fa3afdc",
  "slug": "apricot-jam",
  "name": "Apricot Jam",
  "recipe_type": "drink",
  "brief_description": "Homemade apricot jam with just 3 easy ingredients: fresh apricots, lemon juice, and sugar. Spread on toasted bread for a delicious fruity treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix apricots and lemon juice in a large pot over medium heat; add sugar and slowly bring to a boil, stirring until sugar dissolves."
    },
    {
      "position": 3,
      "text": "Continue to cook and stir until apricot mixture thickens, about 25 minutes. Remove from heat and skim foam off the top if necessary."
    },
    {
      "position": 4,
      "text": "Meanwhile, prepare five 1-pint jars with lids and rings by cleaning and sterilizing them in the dishwasher or a boiling water bath. Leave lids in simmering water until ready to seal jars."
    },
    {
      "position": 5,
      "text": "Ladle hot jam into hot sterilized jars, leaving about 1/4 inch of space on top. Run a knife or a thin spatula around the insides of the jars after they have been filled to remove any air bubbles."
    },
    {
      "position": 6,
      "text": "Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with lids, and screw on rings."
    },
    {
      "position": 7,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil, then carefully lower the jars into the pot using a holder, leaving a 2-inch space between the jars. Pour in more boiling water if necessary until the water level is at least 1 inch above the tops of the jars. Bring the water to a full boil, cover the pot, and process for 15 minutes."
    },
    {
      "position": 8,
      "text": "Remove the jars from the stockpot and place them onto a cloth-covered or wood surface, several inches apart, until cool. Once cool, press the top of each lid with a finger, ensuring that the seal is tight and the lid does not move up or down at all. Store in a cool, dark area."
    }
  ],

  "id": "61fd0227-76fe-5386-be9e-fd46156899ac",
  "slug": "kingmans-vegan-zucchini-bread",
  "name": "Vegan Zucchini Bread",
  "recipe_type": "appetizer",
  "brief_description": "This vegan zucchini bread is made with simple baking ingredients, shredded zucchini, and applesauce for a deliciously moist and tender treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk flour, flax seeds, cinnamon, salt, baking soda, baking powder, and arrowroot together in a bowl until evenly blended; set aside."
    },
    {
      "position": 3,
      "text": "Whisk applesauce, white sugar, brown sugar, vegetable oil, and vanilla extract in a separate bowl until smooth. Fold in flour mixture and shredded zucchini until moistened."
    },
    {
      "position": 4,
      "text": "Divide batter between the prepared loaf pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 70 minutes. Cool briefly in the pans before removing to cool completely on a wire rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,

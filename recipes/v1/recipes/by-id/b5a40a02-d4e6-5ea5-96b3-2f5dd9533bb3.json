  "slug": "cucumber-soup-with-tomatoes",
  "name": "Cucumber Soup with Tomatoes",
  "recipe_type": "soup",
  "brief_description": "This five-ingredient recipe for cucumber soup with tomatoes is a quick and refreshing summertime lunch or dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place 2 cucumbers in a blender; pour in chicken stock. Blend cucumber mixture until smooth and pureed; pour cucumber puree into a large bowl."
    },
    {
      "position": 2,
      "text": "Chop the remaining 2 cucumbers. Stir chopped cucumbers, tomato, lime juice, and cayenne pepper into pureed cucumber until well mixed. Refrigerate until chilled, at least 30 minutes."
    }
  ],

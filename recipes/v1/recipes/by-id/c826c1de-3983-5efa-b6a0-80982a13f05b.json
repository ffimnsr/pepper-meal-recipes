{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c826c1de-3983-5efa-b6a0-80982a13f05b",
  "slug": "delicious-spaghetti-bread",
  "name": "Delicious Spaghetti Bread",
  "recipe_type": "main",
  "brief_description": "Spaghetti, ground beef, and Italian cheeses are stuffed into a braided pizza crust and baked for a fun meal everybody will enjoy.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Transfer ground beef to a large bowl."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in boiling water, stirring occasionally, until cooked through but firm to the bite, about 12 minutes. Drain. Transfer spaghetti to the bowl with ground beef; mix in spaghetti sauce and Parmesan cheese until well combined."
    },
    {
      "position": 4,
      "text": "Unroll pizza dough onto a baking sheet. Starting with a long edge, cut the 2 outer thirds of the crust into 1-inch horizontal strips, leaving the center third uncut. Spoon spaghetti mixture onto the center third from top to bottom. Sprinkle mozzarella cheese over spaghetti mixture."
    },
    {
      "position": 5,
      "text": "Begin braiding by pulling a dough strip across the filling, then pulling another strip from the opposite side over the first strip. Pinch strips together and continue to braid until the filling is covered with braided dough."
    },
    {
      "position": 6,
      "text": "Mix olive oil and garlic in a small bowl. Brush olive oil mixture over braid."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the filling is hot and crust is golden brown, 25 to 30 minutes. Cut into slices to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,

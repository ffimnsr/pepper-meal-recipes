  "id": "c0b93a78-1f02-576e-8352-30cc0e86929c",
  "slug": "crispy-gingersnaps",
  "name": "Crispy Gingersnaps",
  "recipe_type": "dessert",
  "brief_description": "This simple recipe helps deliver thin, spicy gingersnap cookies you'll be happy to serve at the holiday cookie exchange.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream the shortening and sugar. Add the egg and beat until light and fluffy, then stir in the molasses. In a separate bowl, mix together the flour, baking soda, salt, ginger and cinnamon. Add to the egg mixture and stir until well blended. Roll bits of dough into 1 inch balls. Dip each ball in sugar and place on cookie sheet, sugared side up about 2 inches apart."
    },
    {
      "position": 3,
      "text": "Bake for 10 to 12 minutes, until cookies have spread and tops have cracked. Let cool on wire rack."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

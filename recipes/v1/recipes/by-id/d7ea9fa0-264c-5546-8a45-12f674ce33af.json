  "id": "d7ea9fa0-264c-5546-8a45-12f674ce33af",
  "slug": "poor-mans-cake-iii",
  "name": "Poor Man's Cake",
  "recipe_type": "dessert",
  "brief_description": "This Poor Man's Cake is a family recipe that has been passed down since the 1930s. No mixer needed, use just one bowl to make this cake with no eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Mix raisins, water, brown sugar, and shortening in a saucepan. Bring to a boil and boil for 3 minutes. Remove from heat and let cool."
    },
    {
      "position": 3,
      "text": "Combine flour, cinnamon, baking soda, nutmeg, cloves, and salt in a large bowl. When raisin mixture is cool, add to dry ingredients and mix well to combine."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 or 40 minutes. Do not overbake or it will be too dry. Test after 30 minutes. A toothpick inserted into the center of the cake should come out clean."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

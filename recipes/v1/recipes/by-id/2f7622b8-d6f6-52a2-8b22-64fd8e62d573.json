  "id": "2f7622b8-d6f6-52a2-8b22-64fd8e62d573",
  "slug": "super-easy-hummus",
  "name": "Super Easy Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This easy hummus recipe simply combines chickpeas, garlic, cumin, salt, olive oil, and lemon juice to make a delicious homemade dip for pita chips.",
  "cuisine": "Mediterranean Inspired Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Blend chickpeas, lemon juice, olive oil, garlic, cumin, salt, and sesame oil in a food processor."
    },
    {
      "position": 3,
      "text": "Stream reserved chickpea liquid into the mixture as it blends until desired consistency is achieved."
    },
    {
      "position": 4,
      "text": "Serve with pita chips or veggies."
    }
  ],
  "servings": 4,

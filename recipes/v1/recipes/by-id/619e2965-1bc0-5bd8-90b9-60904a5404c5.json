  "slug": "vegan-avocado-coconut-milk-ice-cream",
  "name": "Avocado Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This avocado ice cream is made vegan with coconut milk and is super refreshing, thanks to the addition of lemon and lime. Serve with toasted coconut!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend avocados, lemon juice, lime juice, lemon zest, and lime zest together in a food processor until smooth; add coconut milk, agave nectar, and corn syrup and blend until smooth. Cover bowl of food processor and refrigerate for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Pour avocado mixture into ice cream maker and process according to manufacturer's instructions."
    }
  ],

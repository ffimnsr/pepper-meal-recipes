  "id": "542e32c7-bb26-5536-8eab-da3f1772660a",
  "slug": "hash-brown-egg-cups-recipe-12034854",
  "name": "Hash Brown Egg Cups",
  "recipe_type": "breakfast",
  "brief_description": "Frozen shredded hash browns and pepper and onion mix keep prep time to a minimum in these potato-crusted egg bites. Roughly chop any large strips of frozen pepper and onion blend to fit more easily into muffin cups.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Generously coat 12 (2 1/2-inch) muffin cups with cooking spray (see footnote, below)."
    },
    {
      "position": 2,
      "text": "Put hash browns and butter in a large bowl; toss until coated. Divide hash brown mixture evenly among muffin cups, pressing into bottoms and up sides to form a crust. Bake until crisp and lightly golden, about 18 minutes."
    },
    {
      "position": 3,
      "text": "Reduce oven temperature to 350 degrees F (180 degrees C). Divide bell pepper and onion blend among hash brown crusts in muffin cups."
    },
    {
      "position": 4,
      "text": "Whisk together eggs, milk, Parmesan cheese, 1/2 teaspoon each black pepper and Italian seasoning and 1/4 teaspoon salt in a large bowl. Divide egg mixture among muffin cups. Bake until eggs are puffed and a knife inserted in center comes out clean, 12 to 15 minutes (160 degrees Fahrenheit). Let stand 10 minutes before running a thin metal spatula around edges to remove from pan."
    },
    {
      "position": 5,
      "text": "Meanwhile, for sauce, in a small blender or food processor combine drained tomatoes, oil, garlic, and remaining 1/2 teaspoon each black pepper and Italian seasoning, and 1/4 teaspoon salt. Blend until desired consistency. If desired, transfer sauce to a bowl and warm in microwave in 30-second intervals. Stir in basil. Serve hash brown muffin cups with sauce and garnish with additional basil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

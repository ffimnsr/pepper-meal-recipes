  "id": "09a45c6a-4eba-5af1-b120-dbe0aad925b7",
  "slug": "sloppy-joes-i",
  "name": "Sloppy Joes I",
  "recipe_type": "soup",
  "brief_description": "Browned ground beef combined with chicken gumbo soup, ketchup and mustard for a tasty spin on the classic recipe. Serve on toasted hamburger buns with mayonnaise, sliced tomatoes, sliced onion, and lettuce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In large skillet over medium heat, brown meat. Drain any grease from pan."
    },
    {
      "position": 2,
      "text": "Stir in soup, ketchup, yellow mustard, water, salt and pepper. Turn heat to medium-low; simmer uncovered for about 1 hour until liquid is absorbed and mixture is thickened."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,

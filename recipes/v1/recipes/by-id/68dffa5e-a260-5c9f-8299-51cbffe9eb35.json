  "slug": "smoked-salmon-layer-dip-recipe-11860257",
  "name": "Smoked Salmon Layer Dip",
  "recipe_type": "appetizer",
  "brief_description": "This smoked salmon layer dip, with capers, dill, and red onion, is a creamy, lemony sensation that you can stir up in minutes. Serve it with bagel chips or crostini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Finely chop salmon and add to a bowl. Stir in creme fraiche, half the red onion, caper brine, lemon juice, lemon zest, salt, and pepper until well combined."
    },
    {
      "position": 2,
      "text": "Spread salmon mixture in a 1-inch thick layer on the bottom of a serving dish. Top with remaining onion, capers, and dill. Refrigerate until ready to serve. Serve with bagel chips or crostini."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

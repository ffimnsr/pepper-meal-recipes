  "id": "3b346c83-0ed6-5eab-84fa-22c70a6034b4",
  "slug": "butter-chicken-rice-casserole-recipe-11844103",
  "name": "Butter Chicken Rice Casserole",
  "recipe_type": "salad",
  "brief_description": "This butter chicken rice casserole is very easy to put together and is on the table in about 40 minutes. Serve with a salad or simple vegetable side for a great weeknight family dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the butter chicken sauce and broth in a large oven-safe skillet. Bring to boiling over medium-high heat."
    },
    {
      "position": 3,
      "text": "Stir in the chicken, rice, onion, and salt until combined. Bring to a simmer and remove from heat."
    },
    {
      "position": 4,
      "text": "Cover the skillet tightly with the lid or foil and bake until chicken and rice are cooked through, for 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Let stand for 15 minutes. Fluff the rice before serving. Top with cilantro and serve with lime wedges. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

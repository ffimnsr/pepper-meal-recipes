  "id": "dbf189e8-a0a2-51ec-bbff-e8272372ecbe",
  "slug": "pancake-casserole",
  "name": "Pancake Casserole",
  "recipe_type": "dessert",
  "brief_description": "Pancake casserole made with baking mix, Cheddar, bacon, and maple syrup is a family-pleasing breakfast for weekend mornings. Serve with maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Mix baking mix, 1 cup Cheddar cheese, milk, maple syrup, eggs, and sugar together in a bowl; pour into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 to 25 minutes. Sprinkle bacon and remaining 1 cup Cheddar cheese over casserole; return to oven until cheese is melted, about 5 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

  "id": "9890683c-9059-53cf-9305-b29aadc4fa10",
  "slug": "brown-sugar-banana-nut-bread-i",
  "name": "Brown Sugar Banana Nut Bread",
  "recipe_type": "dessert",
  "brief_description": "This brown sugar banana nut bread recipe makes a moist, sweet loaf full of rich vanilla flavor\u2014a homemade classic perfect for sharing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a large bowl until light and fluffy. Stir in the eggs one at a time, beating well with each addition, then stir in vanilla extract and mashed banana. Sift flour, baking powder, and salt together in a separate bowl."
    },
    {
      "position": 3,
      "text": "Blend banana mixture into flour mixture; stir just to combine. Fold in walnuts. Pour batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center of loaf comes out clean, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

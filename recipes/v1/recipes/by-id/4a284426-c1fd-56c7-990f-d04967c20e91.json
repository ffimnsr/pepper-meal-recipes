  "id": "4a284426-c1fd-56c7-990f-d04967c20e91",
  "slug": "chicken-and-feta-burgers",
  "name": "Chicken and Feta Burgers",
  "recipe_type": "main",
  "brief_description": "Ground chicken makes for great, lean burgers with the addition of olive, oregano, and feta cheese.",
  "cuisine": "Mediterranean Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix chicken, oregano, tapenade, feta cheese, and garlic together in a bowl; form into 4 patties. Season burgers with salt and pepper."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate with olive oil."
    },
    {
      "position": 3,
      "text": "Cook patties until charred on bottom, about 5 minutes. Flip the burgers and finish cooking, refraining from flattening with your spatula until no longer pink in the middle, about 5 minutes more. Drain on a plate lined with paper towels before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

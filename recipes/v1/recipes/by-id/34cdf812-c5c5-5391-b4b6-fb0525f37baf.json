  "id": "34cdf812-c5c5-5391-b4b6-fb0525f37baf",
  "slug": "bread-and-butter-pickles-ii",
  "name": "Bread and Butter Pickles",
  "recipe_type": "snack",
  "brief_description": "Homemade bread and butter pickles are a great way to end summer! Cucumber, onion, peppers, and garlic are pickled in a spicy cider vinegar mixture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cucumbers, onions, green bell peppers, garlic, and salt together in a large bowl. Allow to stand approximately 3 hours."
    },
    {
      "position": 2,
      "text": "Mix sugar, cider vinegar, mustard seed, turmeric, celery seed, and whole cloves together in a large saucepan; bring to a boil over high heat."
    },
    {
      "position": 3,
      "text": "Drain any liquid from the cucumber mixture. Stir cucumbers into the boiling vinegar mixture. Remove from heat shortly before the combined mixture comes to a boil."
    },
    {
      "position": 4,
      "text": "Transfer into sterile screw-top jars; seal and chill in the refrigerator until ready to serve."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 50,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 60,

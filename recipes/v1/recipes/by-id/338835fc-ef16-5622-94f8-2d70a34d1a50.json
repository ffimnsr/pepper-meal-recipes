  "id": "338835fc-ef16-5622-94f8-2d70a34d1a50",
  "slug": "chef-johns-grilled-swordfish-bruschetta",
  "name": "Chef John's Grilled Swordfish Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Grill up a taste of summer with Chef John's recipe for grilled swordfish bruschetta with cherry tomatoes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir tomatoes, balsamic vinegar, extra virgin olive oil, basil, cayenne pepper, salt, and black pepper together in a bowl. Let sit until flavors blend, at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Brush bread slices with olive oil."
    },
    {
      "position": 3,
      "text": "Cook bread slices on the preheated grill until browned and crispy, 2 to 3 minutes per side."
    },
    {
      "position": 4,
      "text": "Brush swordfish steaks with grapeseed oil and season with salt and black pepper."
    },
    {
      "position": 5,
      "text": "Cook swordfish steaks on the preheated grill until fish flakes easily with a fork, about 4 minutes per side."
    },
    {
      "position": 6,
      "text": "Divide bread slices between two plates and top each plate with 1 swordfish steak. Spoon 1/2 of the cherry tomato mixture over each steak."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

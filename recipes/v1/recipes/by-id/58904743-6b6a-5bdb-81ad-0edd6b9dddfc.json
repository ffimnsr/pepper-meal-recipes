  "id": "58904743-6b6a-5bdb-81ad-0edd6b9dddfc",
  "slug": "chocolate-chip-belgian-waffles",
  "name": "Chocolate Chip Belgian Waffles",
  "recipe_type": "breakfast",
  "brief_description": "This fluffy Belgian waffles recipe includes vanilla extract with melted chocolate chips in every bite. They're perfect for brunch or a weekend breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg in a large bowl with an electric mixer until fluffy. Add flour, milk, chocolate chips, oil, sugar, baking powder, vanilla extract, and salt; beat just until smooth."
    },
    {
      "position": 2,
      "text": "Coat a Belgian waffle iron with cooking spray; preheat according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Pour about \u00be cup batter onto hot waffle iron; cook until golden brown. Repeat with remaining batter. Serve hot."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

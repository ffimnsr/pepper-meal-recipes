  "id": "d4926695-9468-5b6e-9b7c-1b2dd4bea296",
  "slug": "the-best-garlic-bread",
  "name": "The Best Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This is the best garlic bread ever. It\u2019s spread with mayonnaise, Parmesan cheese, and garlic powder, then broiled until golden brown and bubbly.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven\u2019s broiler."
    },
    {
      "position": 2,
      "text": "Mix together mayonnaise, Parmesan cheese, and garlic powder in a medium bowl until thick and well combined."
    },
    {
      "position": 3,
      "text": "Slice loaf in half lengthwise and spread the cut-side of each piece with mayonnaise mixture. Place halves on a medium baking sheet."
    },
    {
      "position": 4,
      "text": "Cook under the preheated broiler until mayonnaise mixture is bubbling and golden brown, 2 to 5 minutes; check frequently to avoid burning."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 5,

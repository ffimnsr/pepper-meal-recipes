  "id": "fdfb2ccf-2dd6-5414-ae63-dccc87fead16",
  "slug": "cowboy-spaghetti-recipe-8634556",
  "name": "Cowboy Spaghetti",
  "recipe_type": "main",
  "brief_description": "Everyone will love this cowboy spaghetti, a fun twist with bacon, cheese, and pasta in a spicy beef and tomato sauce. The best part is that it\u2019s a one-dish meal, cooked in a cast iron skillet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large cast iron skillet and cook over medium-high heat, turning occasionally, until slightly crisp, about 7 minutes. Remove bacon slices to a paper towel-lined plate. When bacon is cool enough to handle, crumble roughly and set aside."
    },
    {
      "position": 2,
      "text": "Add onion to the same skillet with bacon grease and saut\u00e9 until softened, about 3 minutes. Add garlic, salt, and pepper. Stir until garlic is fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add ground beef. Cook and stir until beef is crumbly and no longer pink, about 5 minutes. Lower heat to medium-low and stir in beef broth, Worcestershire sauce, and hot sauce. Stir in 1/2 of the crumbled bacon."
    },
    {
      "position": 4,
      "text": "Break spaghetti in half. Scatter over ground beef, making sure noodles are separated. Pour tomatoes with green chiles, fire-roasted tomatoes, and tomato sauce over noodles. Cover and cook for 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove the lid and stir to combine the pasta and sauce. Smooth out mixture and scatter shredded cheese evenly over top. Sprinkle with remaining bacon. Cover and let cheese melt, about 5 minutes. Garnish with green onions; serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

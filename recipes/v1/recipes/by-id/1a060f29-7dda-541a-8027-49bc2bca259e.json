  "id": "1a060f29-7dda-541a-8027-49bc2bca259e",
  "slug": "chipotle-bacon-deviled-eggs-recipe-11681684",
  "name": "Chipotle Bacon Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These chipotle bacon deviled eggs are a smoky, spicy upgrade to the classic, with crispy bacon and chipotle peppers. Creamy, flavorful bites combine the richness of egg yolks with tangy mayo and the bold heat of chipotle in adobo.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Halve eggs lengthwise and scoop egg yolks into the bowl of a mini food processor; set egg whites aside. If you do not have a mini food processor, you can mash all ingredients in a bowl with a fork."
    },
    {
      "position": 2,
      "text": "Mince 1 bacon slice and add to the egg yolks; cut the other slice into 12 pieces and set aside for garnish. Add mayonnaise, adobo sauce, dry mustard, and garlic powder to the egg yolks; blend well until smooth, scraping down the sides of the bowl. If mixture is too thick, blend in an extra tablespoon of mayonnaise. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place yolk mixture into a resealable bag and snip off a corner. Pipe mixture into egg whites. Sprinkle eggs with ground chipotle pepper and top with bacon pieces. Refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

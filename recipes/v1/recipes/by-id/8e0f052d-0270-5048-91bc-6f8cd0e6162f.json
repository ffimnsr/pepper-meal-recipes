  "id": "8e0f052d-0270-5048-91bc-6f8cd0e6162f",
  "slug": "macadamia-nut-chocolate-chip-cookies",
  "name": "Macadamia Nut Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "Drop cookies with macadamia nuts and chocolate chips!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease 2 large cookie sheets with vegetable shortening."
    },
    {
      "position": 2,
      "text": "Cream the butter and sugars together in a large bowl. Beat in the egg and vanilla extract until well blended. Sift together the flour, baking soda, and salt; gradually blend into the batter. Stir in the chopped macadamia nuts and chocolate chips. Drop by rounded teaspoonfuls onto the cookie sheets, about 2 inches apart."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 10 to 12 minutes, or until the cookies are golden brown. Remove from the oven, and transfer the cookies to cooling racks."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "383042b9-6050-537b-9bc3-0fb7edd81b7e",
  "slug": "chicken-with-a-creamy-marsala-sauce",
  "name": "Chicken with a Creamy Marsala Sauce",
  "recipe_type": "main",
  "brief_description": "Pan-fried chicken simmers in a creamy Marsala sauce in this quick recipe.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, salt, and pepper in a shallow dish. Press chicken tenders in the flour to coat completely; shake gently to remove any excess flour."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium, tilting the pan to coat the cooking surface in oil. Melt the butter in the skillet. Cook the chicken tenders in the hot butter until evenly browned, 7 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Pour the Marsala wine into the skillet and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon; cook until the wine is hot, about 30 seconds. Pour chicken stock into the skillet."
    },
    {
      "position": 4,
      "text": "Stir heavy cream and mustard together in a bowl; add to the skillet. Bring the mixture to a simmer and cook another 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

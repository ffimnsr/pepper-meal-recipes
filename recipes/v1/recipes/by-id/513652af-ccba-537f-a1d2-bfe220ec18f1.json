  "id": "513652af-ccba-537f-a1d2-bfe220ec18f1",
  "slug": "butterscotch-oatmeal",
  "name": "Butterscotch Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Oatmeal is cooked in milk with brown sugar and butter for a tasty butterscotch flavor. The best oatmeal I've ever had. No need to top this with sugar afterwards. Good with or without milk.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan over medium heat, whisk together the egg, milk and brown sugar. Mix in the oats. When the oatmeal begins to boil, cook and stir until thick. Remove from the heat, and stir in butter until melted. Serve immediately."
    }
  ],

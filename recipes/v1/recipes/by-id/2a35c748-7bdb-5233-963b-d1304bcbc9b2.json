  "id": "2a35c748-7bdb-5233-963b-d1304bcbc9b2",
  "slug": "pork-tenderloin",
  "name": "Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "This pork tenderloin is infused with incredible flavor, thanks to an easy marinade made with tangy mustard, sweet sherry, spicy ginger, and salty soy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Marinate the pork: Whisk sherry, soy sauce, garlic, and ginger together in a large glass baking dish."
    },
    {
      "position": 2,
      "text": "Rub pork with mustard powder and thyme, then transfer to the bowl with marinade. Turn pork until well coated. Cover and refrigerate for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "When ready to cook the pork, preheat the oven to 325 degrees F (165 degrees C). Remove pork from the refrigerator and uncover; leave marinade in the dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, basting occasionally with the marinade, until pork is slightly pink in the center, 60 to 65 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 5,
      "text": "When the pork is almost finished, make the sauce: Heat apple jelly in a small saucepan over medium heat until warm. Stir in sherry and soy sauce, reduce the heat to low, and simmer gently until pork is ready."
    },
    {
      "position": 6,
      "text": "Slice pork tenderloin and serve warm apple jelly sauce over top."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

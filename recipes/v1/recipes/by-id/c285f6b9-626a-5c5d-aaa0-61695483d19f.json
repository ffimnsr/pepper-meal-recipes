  "id": "c285f6b9-626a-5c5d-aaa0-61695483d19f",
  "slug": "crockpot-marinara-chicken-subs-recipe-11890148",
  "name": "Slow Cooker Marinara Chicken Subs",
  "recipe_type": "main",
  "brief_description": "These Crockpot marinara chicken subs are an easy, crowd-pleasing meal made with tender slow-cooked chicken simmered in rich marinara sauce. Piled onto toasted sub rolls and topped with melty cheeses, they\u2019re perfect for game day, busy weeknights, or feeding a hungry group.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, marinara sauce, Italian seasoning, garlic, salt, and pepper in a crockpot. Cook on Low for 4 to 6 hours or on High for 2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Turn off crockpot and transfer chicken to a cutting board. Shred chicken into bite sized pieces using two forks or a hand mixer and return to the crockpot. Stir in Parmesan cheese."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Brush the inside of each sub roll with butter and toast in the preheated oven until golden brown."
    },
    {
      "position": 4,
      "text": "Cover the inside of each toasted bun with shredded mozzarella cheese, spoon chicken mixture into the bun and top with a slice of provolone cheese. Set buns on a baking sheet and return to the oven for 3 to 4 minutes until cheese is melted."
    },
    {
      "position": 5,
      "text": "Garnish sandwiches with chopped fresh parsley and freshly grated Parmesan cheese, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

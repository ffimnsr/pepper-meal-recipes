  "slug": "boars-head-bold-ichiban-teriyaki-style-chicken-salad",
  "name": "Boar's Head Bold Ichiban Teriyaki Style Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Mix fresh vegetables and fruit like celery and Mandarin oranges with the savory taste of Bold Ichiban Teriyaki-Style Chicken for an effortlessly delicious flavor journey.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Slice Teriyaki Chicken into small 1/4-inch cubes. Finely dice celery and scallions. Drain mandarin oranges and slice into small pieces. Place the ingredients into a large mixing bowl and set aside."
    },
    {
      "position": 2,
      "text": "In a separate large mixing bowl, combine the Teriyaki Sauce ingredients. Mix the sauce and pour into the large bowl with the other ingredients. Mix the salad and serve."
    }
  ],
  "servings": 2,

  "id": "54bae120-5f68-56aa-99a6-413e801991eb",
  "slug": "seared-chuck-eye-recipe-8696926",
  "name": "Seared Chuck Eye Steak",
  "recipe_type": "main",
  "brief_description": "This chuck steak cuts like a ribeye. Seared in a hot skillet, then rested while you prepare a quick and easy pan sauce, this steak is tender and delicious. Serve it steakhouse-style, with roasted potatoes, asparagus, and sauteed mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat steaks dry with a paper towel. Season generously with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over high heat. Place steaks in the hot skillet and immediately turn down the heat to medium-high. Cook for 4 minutes. Turn steaks, add 1 tablespoon butter (or more as desired) and thyme sprigs to the pan, and cook for an additional 4 to 6 minutes, depending on your taste. Remove steaks from skillet and let rest, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, make pan sauce: remove skillet from heat. Quickly saute the garlic and shallot for 1 to 2 minutes in the skillet using residual heat. Return the skillet to medium-low heat and add beef broth. Bring to a boil and reduce for 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove pan from heat and whisk in remaining 2 tablespoons butter. Serve sauce over steaks."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "0c93ac6e-30d0-5a48-b470-d8dcd8137f18",
  "slug": "chef-johns-cheese-blintzes",
  "name": "Chef John's Cheese Blintzes",
  "recipe_type": "breakfast",
  "brief_description": "Chef John's cheese blintzes, filled with a lemony ricotta and cream cheese mixture, are perfect for a special brunch. Try them with a fresh berry sauce.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the batter: Combine milk, flour, water, eggs, oil, sugar, salt, and vanilla in a blender. Blend until completely smooth, 1 or 2 minutes, scraping down the sides as needed. Let batter sit at room temperature for 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, make the filling: Whisk ricotta cheese, cream cheese, egg, 2 tablespoons powdered sugar, lemon zest, and salt together in a mixing bowl until thoroughly combined. Cover and refrigerate until needed."
    },
    {
      "position": 4,
      "text": "When batter has rested, heat a 10-inch, nonstick skillet over medium-high heat. Spray with cooking spray and pour in about 1/4 cup batter."
    },
    {
      "position": 5,
      "text": "Immediately swirl batter around to coat the bottom of the skillet. Cook until the surface looks dry, about 1 minute."
    },
    {
      "position": 6,
      "text": "Flip cr\u00eape and briefly cook the other side, about 30 seconds. Transfer to a plate. Repeat to cook and stack remaining cr\u00eapes."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a baking dish."
    },
    {
      "position": 8,
      "text": "Spoon 3 to 4 tablespoons filling onto each cr\u00eape, about 1 inch from the edge nearest you. Fold the edge over filling and flatten slightly."
    },
    {
      "position": 9,
      "text": "Fold in both sides, then roll cr\u00eape into a small filled rectangle (blintz), ending with the seam on the bottom."
    },
    {
      "position": 10,
      "text": "Melt butter in a large skillet over medium heat. Working in batches, cook several blintzes at a time until golden brown, turning gently, about 1 minute per side. Transfer to the prepared baking dish."
    },
    {
      "position": 11,
      "text": "Bake in the preheated oven to firm up the filling, about 12 minutes."
    },
    {
      "position": 12,
      "text": "Cool blintzes for 10 minutes, then dust lightly with remaining powdered sugar and serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

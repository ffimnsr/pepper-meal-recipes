  "id": "d5d5d4e9-acc4-5892-9238-8179b6bbcc3c",
  "slug": "honey-whole-wheat-bread",
  "name": "Honey Whole Wheat Bread",
  "recipe_type": "appetizer",
  "brief_description": "The bread machine makes this honey wheat bread recipe easy yet delicious and soft. This classic flavor combination will be a household favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water, honey, oil, whole wheat flour, bread flour, salt, then yeast into a bread machine in the order listed, or follow the order recommended by the manufacturer if different."
    },
    {
      "position": 2,
      "text": "Run Whole Wheat cycle, light color setting."
    },
    {
      "position": 3,
      "text": "Remove loaf from the machine after the cycle is done, about 3 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 180,

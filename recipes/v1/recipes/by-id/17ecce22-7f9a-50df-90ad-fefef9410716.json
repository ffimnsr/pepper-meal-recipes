  "id": "17ecce22-7f9a-50df-90ad-fefef9410716",
  "slug": "bourbon-and-dp-baked-beans",
  "name": "Bourbon Baked Beans",
  "recipe_type": "drink",
  "brief_description": "Delicious bourbon baked beans are easy to prep, with bacon, brown sugar, bourbon, Dr Pepper, and baked beans with pork for a popular party side dish.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix brown sugar, paprika, mustard, and cayenne pepper together in a bowl. Whisk in pepper soda, ketchup, and Worcestershire sauce until brown sugar is dissolved."
    },
    {
      "position": 3,
      "text": "Cut 4 slices of bacon into small strips. Cook and stir in a large Dutch oven over medium heat until almost crispy, 3 to 5 minutes. Transfer to a bowl, reserving bacon grease."
    },
    {
      "position": 4,
      "text": "Stir onion into the bacon grease in the Dutch oven; cook and stir until soft, 3 to 5 minutes. Add garlic; cook and stir for 1 minute. Pour in bourbon, stirring to scrape up browned bits off the bottom with a wooden spoon. Stir bacon strips back in."
    },
    {
      "position": 5,
      "text": "Pour brown sugar mixture and baked beans into the Dutch oven. Simmer until beans are heated through, about 15 minutes. Arrange remaining 4 slices of bacon on top of the beans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, covered, until beans are bubbly and sauce is syrupy, about 2\u00bd to 3 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 175,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

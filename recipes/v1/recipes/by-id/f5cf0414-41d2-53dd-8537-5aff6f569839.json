  "id": "f5cf0414-41d2-53dd-8537-5aff6f569839",
  "slug": "rose-petal-cookies",
  "name": "Rose Petal Cookies",
  "recipe_type": "dessert",
  "brief_description": "This rose petal cookie recipe combines rose water and dried rose petals with standard cookie ingredients, yielding amazing flavor and pretty pink flecks.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Beat sugar and butter in a large bowl with an electric mixer until light and fluffy, about 5 minutes. Beat in eggs and rose water; fold in rose petals."
    },
    {
      "position": 2,
      "text": "Combine flour, baking powder, and salt in a separate bowl; mix into dough. Cover and chill dough 1 hour to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Roll out dough on a lightly floured surface to about \u2153-inch thickness. Cut into shapes with a shaped cutter or cut into rectangles or squares. Place cookies 1 inch apart on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until light and crisp, 6 to 8 minutes. Cool completely before serving."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "indian-onion-dipping-sauce",
  "name": "Indian Onion Dipping Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Minced onion is mixed with lemon juice, paprika, and cayenne creating a copycat version of an onion dipping sauce from an Indian restaurant.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place onion in a food processor and pulse until onion is minced. Add lemon juice, ketchup, cayenne pepper, paprika, salt, and sugar and pulse until evenly combined. Transfer sauce to an airtight container and refrigerate until flavors combine, 2 to 3 hours."
    }
  ],
  "servings": 10,

  "id": "10691437-e5c8-5599-ab9d-d30389d9ecd3",
  "slug": "steak-and-mushroom-tortellini-alfredo",
  "name": "Steak and Mushroom Tortellini Alfredo",
  "recipe_type": "main",
  "brief_description": "Tender filet mignon and cremini mushrooms combine with tortellini Alfredo for a satisfying meal. Simple yet elegant, it's perfect for a special night in.",
  "cuisine": "American Fusion Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, soy sauce, and steak seasoning together in a small, shallow dish. Add steak strips; toss to coat. Marinate in the refrigerator for 30 minutes."
    },
    {
      "position": 2,
      "text": "Heat a cast-iron skillet over medium-high heat. Add 1 tablespoon butter until melted; add steak. Cook until browned, about 2 minutes per side. Add mushrooms; cook until softened, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, or according to package directions, about 3 minutes. Drain and return to the pot."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt 2 tablespoons unsalted butter in a saucepan over medium heat. Stir in heavy cream until combined. Stir in Parmesan cheese until it melts. Season Alfredo sauce with nutmeg."
    },
    {
      "position": 5,
      "text": "Toss tortellini with Alfredo sauce to coat; top servings with steak and mushrooms."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

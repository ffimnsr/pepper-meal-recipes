  "id": "f6273e63-89d3-506e-825c-4fab9c2e9dd4",
  "slug": "strawberry-eton-mess-for-mothers-day",
  "name": "Strawberry Eton Mess for Mother's Day",
  "recipe_type": "dessert",
  "brief_description": "This strawberry Eton mess for Mother's Day recipe is topped with caramelized almonds, a tart whipped cream, and macerated strawberries for a sweet treat.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries, 2 tablespoons sugar, balsamic vinegar, raspberry vinegar, and basil in a bowl: set aside until strawberries release their juices and absorb flavors, at least 15 minutes."
    },
    {
      "position": 2,
      "text": "Whip heavy cream in a chilled glass or metal bowl with an electric mixer until frothy. Gradually add 1 tablespoon sugar, continually beating until soft peaks form. Beat in sour cream and cream cheese until well blended."
    },
    {
      "position": 3,
      "text": "Sprinkle enough of remaining 3 tablespoons sugar into a heavy saucepan until bottom of pan is covered with a thin layer. Cook over medium heat, adding more sugar as it starts to melt; stir until caramelized and amber in color. Stir in almonds."
    },
    {
      "position": 4,
      "text": "Pour sugar-almond mixture onto a sheet of parchment paper. Place another sheet of parchment paper on top; roll into a thin layer using a rolling pin. Cool. Break into pieces."
    },
    {
      "position": 5,
      "text": "Spoon a layer of macerated strawberries in bottoms of 4 serving dishes; top with a layer of whipped cream and crushed meringue cookies. Continue layering until reaches tops of dishes. Garnish with caramelized almond pieces, crushed meringue cookies, and macerated strawberries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "b5351d95-b46c-57a8-9e32-6fece12adf59",
  "slug": "air-fryer-oven-pork-jerky",
  "name": "Air Fryer Oven Pork Jerky",
  "recipe_type": "appetizer",
  "brief_description": "This pork jerky recipe is made in an air fryer. The jerky comes out full of flavor and is easy to make. It's a perfect snack for camping or any outdoor activity.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground pork, sesame oil, Sriracha, soy sauce, vinegar, salt, pepper, onion powder, and curing salt together in a large bowl until evenly combined. Cover and refrigerate for 8 hours."
    },
    {
      "position": 2,
      "text": "Using a jerky gun, form as many sticks as you can fit on all three of the air fryer oven racks. They will shrink almost immediately, so put them close together and utilize the full length of the racks. (I was able to get 21 sticks the first time.) Cover and refrigerate any leftover pork mixture."
    },
    {
      "position": 3,
      "text": "Set the air fryer to 160 degrees F (71 degrees C). Place all 3 racks in the oven and cook for 1 hour."
    },
    {
      "position": 4,
      "text": "Remove racks from the oven, blot any excess moisture with paper towels, flip each stick, and cook for 1 more hour. Repeat once more."
    },
    {
      "position": 5,
      "text": "Transfer jerky sticks to a paper towel-lined baking sheet. Cover with another layer of paper towels and let sit out until dried, about 8 hours."
    },
    {
      "position": 6,
      "text": "Meanwhile, repeat Steps 2 through 5 to make remaining jerky with leftover pork mixture."
    }
  ],
  "servings": 35,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

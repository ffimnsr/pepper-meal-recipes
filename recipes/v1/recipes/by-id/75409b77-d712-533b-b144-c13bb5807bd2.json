{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "75409b77-d712-533b-b144-c13bb5807bd2",
  "slug": "roasted-pepper-and-lentil-soup",
  "name": "Roasted Pepper and Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "Roast peppers at home to create this summery lentil soup, which can be served cold or hot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set oven rack about 6 inches from the heating element in your oven and preheat the broiler. Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Arrange red bell pepper halves, yellow bell pepper halves, and orange bell pepper halves onto prepared baking sheet with cut sides down."
    },
    {
      "position": 3,
      "text": "Roast peppers under the preheated broiler until the skin of the peppers has blackened and blistered, 5 to 8 minutes. Place the blackened peppers into a bowl and tightly seal with plastic wrap. Steam as they cool until the skin has loosened completely, about 20 minutes. Remove and discard skins. Cut peppers into small dice."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large pot over medium heat; cook and stir onion and carrot in hot oil until onion is translucent, about 10 minutes. Add garlic, tarragon, thyme, and paprika; continue to cook and stir until garlic is fragrant, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Stir roasted peppers, tomatoes, water, and hot sauce into the peppers mixture, place a cover on the pot, and cook until the tomatoes soften, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Pour vegetable broth into the pot; add lentils, bay leaves, salt, and black pepper; bring to a boil, cover the pot, reduce heat to medium-low, and cook until lentils are tender, about 45 minutes."
    },
    {
      "position": 7,
      "text": "Pour soup into a blender or food processor no more than half full. Cover and hold lid down; pulse several time to get the soup to be only slightly chunky. Repeat processing until all soup has been blended."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

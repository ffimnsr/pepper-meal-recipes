  "id": "3df93384-ef11-5d68-b280-f2c6fefd2ce8",
  "slug": "mediterranean-dense-bean-salad-recipe-12003285",
  "name": "Mediterranean Dense Bean Salad",
  "recipe_type": "salad",
  "brief_description": "This Mediterranean dense bean salad is packed with chickpeas, cannellini beans, fresh vegetables, olives, and dill tossed in a bright lemon-Dijon dressing. Hearty, flavorful, and rich in protein and fiber, it's ideal for meal prep, easy lunches, and make-ahead sides\u2014and tastes even better after a day in the fridge.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, white wine vinegar, lemon juice, honey, Dijon mustard, garlic, oregano, Aleppo pepper, salt, and black pepper together in a small bowl or jar until well combined. Set aside."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl, combine garbanzo beans, cannellini beans, bell pepper, roasted red peppers, red onion, kalamata olives, cucumber, and dill."
    },
    {
      "position": 3,
      "text": "Pour the dressing over the salad and toss gently until everything is evenly coated. If time allows, cover and refrigerate for at least 30 minutes before serving to allow the flavors to meld. Before serving, drain any excess liquid, and top with feta cheese."
    },
    {
      "position": 4,
      "text": "Store leftovers in an airtight container in the refrigerator for up to 4 to 5 days."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

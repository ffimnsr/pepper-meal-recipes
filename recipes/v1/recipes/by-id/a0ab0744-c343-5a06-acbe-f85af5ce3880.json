  "id": "a0ab0744-c343-5a06-acbe-f85af5ce3880",
  "slug": "orange-chocolate-chip-cookies",
  "name": "Orange Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This orange chocolate chip cookie recipe is accented with orange zest, chocolate chips, and pecans for an irresistibly happy marriage of flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt into a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat brown sugar, butter, white sugar, orange zest, and vanilla extract together in a large bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 4,
      "text": "Beat in eggs, one at a time, beating well after each addition. Stir in flour mixture until combined; fold in chocolate chips and pecans until well combined."
    },
    {
      "position": 5,
      "text": "Drop dough by slightly rounded tablespoonfuls 2 inches apart on the prepared cookie sheets; flatten slightly."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden, about 15 minutes. Cool briefly on the cookie sheets, then transfer cookies to a wire rack to cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

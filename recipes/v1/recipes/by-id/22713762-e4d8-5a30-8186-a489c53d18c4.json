  "id": "22713762-e4d8-5a30-8186-a489c53d18c4",
  "slug": "easy-chinese-corn-soup",
  "name": "Easy Chinese Corn Soup",
  "recipe_type": "soup",
  "brief_description": "This quick and satisfying Chinese corn soup is delicious and simple enough to make at home anytime for an easy lunch or dinner in just 15 minutes.",
  "cuisine": "Chinese Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine corn and chicken broth in a saucepan. Bring to a boil over medium-high heat."
    },
    {
      "position": 2,
      "text": "Mix together cornstarch and water in a small bowl or cup; pour into the boiling corn soup, and continue cooking for about 2 minutes, or until thickened."
    },
    {
      "position": 3,
      "text": "Gradually add beaten egg while stirring the soup. Remove from heat and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "a89849f2-91d3-5f6d-81e1-310d46b6cbb7",
  "slug": "warm-and-spicy-autumn-punch",
  "name": "Warm and Spicy Autumn Punch",
  "recipe_type": "drink",
  "brief_description": "This warm and spicy autumn punch recipe features apple juice, pineapple juice, and honey, and spiced with clove-studded oranges, cinnamon, and nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stud oranges with cloves; place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes."
    },
    {
      "position": 4,
      "text": "Combine apple juice and cinnamon stick in a large saucepan; bring to a boil. Reduce heat to medium; simmer for 5 minutes. Off heat, stir in pineapple juice, honey, lemon juice, and nutmeg until honey is dissolved."
    },
    {
      "position": 5,
      "text": "Serve hot in a punch bowl with clove-studded baked oranges floating on top."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

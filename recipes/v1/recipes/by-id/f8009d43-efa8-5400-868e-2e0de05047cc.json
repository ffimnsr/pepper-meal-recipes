  "id": "f8009d43-efa8-5400-868e-2e0de05047cc",
  "slug": "taco-bake-i",
  "name": "Taco Bake I",
  "recipe_type": "appetizer",
  "brief_description": "Browned ground beef mixed with dried taco seasoning is layered in a casserole with canned refried beans and salsa. It is topped with shredded Monterey Jack cheese and baked for 20 to 25 minutes.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (160 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large, heavy skillet over medium-high heat, brown ground beef, and drain fat. Mix in dry taco seasoning."
    },
    {
      "position": 3,
      "text": "Spoon browned meat into a 9x13 inch glass baking dish. Spoon a layer of refried beans over meat, then salsa. Top with shredded cheese."
    },
    {
      "position": 4,
      "text": "Bake about 20 to 25 minutes in the preheated oven."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

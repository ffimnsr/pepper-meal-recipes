  "id": "de91f088-4476-5b03-80e0-89b1d575ce51",
  "slug": "blueberry-pumpkin-muffins",
  "name": "Blueberry Pumpkin Muffins",
  "recipe_type": "dessert",
  "brief_description": "This blueberry pumpkin muffins recipe with chewy oatmeal is accented with ground nutmeg and ground cinnamon for a good-for-you and tasty treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease and flour a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, oats, sugar, baking powder, salt, cinnamon, and nutmeg together in a bowl until evenly blended. Combine pumpkin, milk, butter, and egg in a separate bowl; gradually stir in flour mixture just until moistened. Fold in blueberries. Spoon batter into the prepared muffin cups, filling each to the top."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until tops spring back when lightly pressed, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "62d13b2e-03bd-5f69-89af-d4b735cfbc9f",
  "slug": "air-fryer-corn-ribs-with-zesty-sour-cream-recipe-11974451",
  "name": "Air Fryer Corn Ribs with Zesty Sour Cream",
  "recipe_type": "appetizer",
  "brief_description": "These corn ribs are tossed in a spicy marinade, cooked in the air fryer, and served with a zesty sour cream dip-- the perfect appetizer for summer get togethers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Using a sharp knife, carefully cut corn in half vertically. Cut those halves again vertically. Finally cut each quarter in half horizontally."
    },
    {
      "position": 2,
      "text": "Combine olive oil, lemon juice, smoked paprika, chili powder, cumin, parsley, steak seasoning, salt, and pepper in a bowl. Add corn to marinade and toss to coat."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Line the air fryer basket with parchment paper."
    },
    {
      "position": 4,
      "text": "Add corn ribs and cook for 12 to 14 minutes. You might need to cook them in batches."
    },
    {
      "position": 5,
      "text": "Stir together sour cream, hot sauce, lemon juice, salt, chili powder, and cumin in a small bowl. Serve with corn ribs for dipping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

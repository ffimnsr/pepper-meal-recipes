  "slug": "margarita-jell-o-shots",
  "name": "Margarita Jell-O\u00ae Shots",
  "recipe_type": "drink",
  "brief_description": "If you love margaritas and want a fun happy hour treat, try these Jell-O\u00ae shots flavored with real tequila and triple sec.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine boiling water and gelatin mix in a bowl. Stir to dissolve."
    },
    {
      "position": 3,
      "text": "Add tequila, triple sec, and water. Stir again."
    },
    {
      "position": 4,
      "text": "Pour mixture into shot glasses. Refrigerate until set, about 5 hours."
    }
  ],
  "servings": 15,

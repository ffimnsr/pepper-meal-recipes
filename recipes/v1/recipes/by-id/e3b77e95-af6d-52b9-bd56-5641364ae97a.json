  "id": "e3b77e95-af6d-52b9-bd56-5641364ae97a",
  "slug": "salted-cashew-sweet-potato-fudge",
  "name": "Salted Cashew Sweet Potato Fudge",
  "recipe_type": "appetizer",
  "brief_description": "A unique twist on a classic white chocolate fudge recipe! While quick and easy to prepare, Bruce's\u00ae Yams Salted Cashew Sweet Potato Fudge is a nutty, sweet treat that no one will expect but will instantly love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 4 x 5-inch glass dish with non-stick baking spray; set aside."
    },
    {
      "position": 2,
      "text": "Warm a glass bowl and add white chocolate chips. Heat in microwave, stopping every 20 seconds to stir."
    },
    {
      "position": 3,
      "text": "When melted, stir in mashed Bruce's\u00ae Yams Cut Sweet Potatoes, cream, vanilla, salt and nutmeg. Mix quickly, then add cashew butter and continue to mix until very smooth. Pour mixture into prepared dish. Sprinkle with chopped cashews (patting them gently into fudge)."
    },
    {
      "position": 4,
      "text": "Refrigerate for a minimum of 2 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

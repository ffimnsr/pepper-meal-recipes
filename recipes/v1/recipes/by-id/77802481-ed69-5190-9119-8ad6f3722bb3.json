  "id": "77802481-ed69-5190-9119-8ad6f3722bb3",
  "slug": "kims-prime-rib",
  "name": "Kim's Prime Rib",
  "recipe_type": "main",
  "brief_description": "Garlic, soy sauce, and Worcestershire flavored sauce are injected in this roast with a turkey baster. Recipe may be halved or doubled.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine soy sauce, Worcestershire sauce, garlic powder, onion salt, browning sauce, and water. Place roast in a roasting pan, ribs side down, and poke deep holes in roast with a knife. Pour marinade over roast. Using a baster, squirt marinade into the holes you created with a knife and over entire roast a few times."
    },
    {
      "position": 3,
      "text": "Bake for about 1 hour. (Note: Bake for 40 to 45 minutes for a smaller roast so that it does not dry out.)"
    },
    {
      "position": 4,
      "text": "Remove roast from the oven and reduce the temperature in the oven to 200 degrees F (95 degrees C)."
    },
    {
      "position": 5,
      "text": "When the oven has reached 200 degrees F (95 degrees C), return roast to the oven and continue cooking for 18 to 22 minutes per pound, or until internal temperature reaches 145 degrees F (65 degrees C)."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,

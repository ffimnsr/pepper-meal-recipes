  "id": "2d944e20-f90e-5545-8d6a-f706c6e5c3db",
  "slug": "slow-roasted-bbq-beef-roast",
  "name": "Slow Roasted BBQ Beef Roast",
  "recipe_type": "main",
  "brief_description": "BBQ roast beef goes round and round on an outdoor rotisserie grill, coated in a mouthwatering blend of dried spices. Juicy, tender, and full of flavor!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare an outdoor rotisserie grill for medium heat."
    },
    {
      "position": 2,
      "text": "Mix paprika, salt, pepper, rosemary, and thyme together in a small bowl."
    },
    {
      "position": 3,
      "text": "Cut slits on all sides of roast; insert garlic into slits. Rub spice mixture all over meat."
    },
    {
      "position": 4,
      "text": "Place roast on the preheated rotisserie and cook until an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), 2 to 5 hours. Let rest for 20 minutes before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

  "id": "c0295b3e-97da-56d2-9088-3648127bd409",
  "slug": "pizza-roses-recipe-11904904",
  "name": "We\u2019re Obsessed With Pizza Roses\u2014and Will Take Them Over a Bouquet of Real Roses Any Day",
  "recipe_type": "appetizer",
  "brief_description": "These pizza roses are surprisingly easy to make, and come together in minutes with big flavor from herb butter and pesto. They make the perfect appetizer for a romantic dinner or a Valentine's Day party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Unroll the crescent dough onto a clean surface. If needed, gently press seams together to form one rectangle. Cut into long strips about 2 inches wide."
    },
    {
      "position": 3,
      "text": "Spread about 2 teaspoons pizza sauce evenly across each strip and sprinkle with mozzarella cheese. Place large pepperoni slices along one edge, allowing them to slightly overlap the top edge for a \u201crose\u201d appearance."
    },
    {
      "position": 4,
      "text": "Starting at one end, roll each strip into a spiral. Place each rose into the cavity of a muffin tin."
    },
    {
      "position": 5,
      "text": "Stir together melted butter and Cantanzaro herbs in a small bowl. Brush herb butter lightly over each roll and drizzle a small amount of pesto over the tops."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes. Remove from oven and allow to cool for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

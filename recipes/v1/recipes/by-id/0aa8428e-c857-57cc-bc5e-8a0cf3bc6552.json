  "id": "0aa8428e-c857-57cc-bc5e-8a0cf3bc6552",
  "slug": "pear-honey-cranberry-sauce",
  "name": "Pear Honey Cranberry Sauce",
  "recipe_type": "dessert",
  "brief_description": "Refreshingly sweet, tart and tangy - this recipe is incredibly easy and it's a great change of pace from the usual boring cranberry sauce. The flavor of the cranberries mingles wonderfully with the pear, honey and lemon. It freezes well too!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan, stir together the water and sugar over medium-high heat. Bring to a boil. Stir in pears, and reduce heat to medium. Cook, stirring frequently for 3 minutes, then stir in cranberries and honey. Continue to cook until cranberries pop and the mixture thickens slightly, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and stir in the lemon juice and lemon zest. Cool to room temperature, then store covered in the refrigerator for up to one week."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

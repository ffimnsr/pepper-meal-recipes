  "id": "76578e22-81f0-5a85-a049-68771b0be333",
  "slug": "quick-manhattan-clam-chowder",
  "name": "Quick Manhattan Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "Manhattan clam chowder with plenty of clams, tomatoes, carrots, and potatoes is ready in under an hour for a quick weekday lunch or dinner.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Add celery, onion, carrots, basil, garlic, and black pepper until tender, about 10 minutes. Transfer 1/2 vegetable mixture to a food processor."
    },
    {
      "position": 2,
      "text": "Drain 1 can stewed tomatoes; add to the food processor; pulse until smooth. Stir mixture into pot."
    },
    {
      "position": 3,
      "text": "Stir remaining 2 cans stewed tomatoes, clams, clam juice, and potatoes into pot; bring to a boil. Reduce heat and simmer soup until heated through, 15 to 20 minutes. Season soup with Worcestershire sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "ddf7ae12-6f02-5a2f-840f-2d64b4135abf",
  "slug": "instant-pot-pot-roast",
  "name": "Instant Pot 'Pot Roast'",
  "recipe_type": "drink",
  "brief_description": "Cook this pot roast in your Instant Pot with carrots, potatoes, and celery and then turn the pan juices into a delicious gravy to serve alongside it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat roast dry and season liberally with salt and pepper."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot), add oil, and select Saute function. Add roast to the hot pot and brown for 5 to 8 minutes per side. Remove to a plate."
    },
    {
      "position": 3,
      "text": "Add onion to the pot, adding more oil if needed, and saute until browned, 5 to 7 minutes. Add mushrooms; cook and stir until browned, 3 to 4 more minutes. Add wine and scrape up any browned bits with a wooden spoon. Stir in tomato paste, garlic, and thyme."
    },
    {
      "position": 4,
      "text": "Add beef broth. Place roast on top of the mushrooms and onions. Add potatoes, carrots, and celery. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 80 minutes. Allow 5 to 10 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Remove roast and vegetables to a bowl."
    },
    {
      "position": 6,
      "text": "Switch to Saute function. When juices begin to bubble, whisk in flour and cook to thicken, 2 to 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

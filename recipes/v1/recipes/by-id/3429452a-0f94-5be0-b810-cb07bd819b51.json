  "id": "3429452a-0f94-5be0-b810-cb07bd819b51",
  "slug": "easy-baked-potato-salad",
  "name": "Easy Baked Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Try this easy baked potato salad recipe with bacon, sour cream, and mayo. Adjust the amount of seasonings, cheese, and bacon to your liking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Prick potatoes several times with a fork and transfer to a baking sheet. Bake in the preheated oven until potatoes are easily pierced with a fork, 50 minutes to 1 hour."
    },
    {
      "position": 3,
      "text": "Line a baking sheet with aluminum foil and lay bacon strips in a single layer. Transfer baking sheet to the oven while potatoes are baking, cooking bacon until browned and crisp, about 15 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 4,
      "text": "Remove cooked potatoes from oven and set aside to cool."
    },
    {
      "position": 5,
      "text": "Crumble cooled bacon and cut potatoes into bite-sized pieces. Peel the potatoes or leave the skins on, depending on your preference."
    },
    {
      "position": 6,
      "text": "Combine most of the bacon, most of the Cheddar cheese, sour cream, and mayonnaise in a large bowl; season with salt and pepper. Stir to blend. Add diced potatoes and toss gently to coat with a spatula."
    },
    {
      "position": 7,
      "text": "Sprinkle remaining Cheddar cheese and bacon over the top of the salad before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

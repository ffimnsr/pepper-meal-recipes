  "id": "094907e1-11df-5bb6-a9d8-aa2595eba67b",
  "slug": "white-chicken-enchilada-slow-cooker-casserole",
  "name": "White Chicken Enchilada Slow-Cooker Casserole",
  "recipe_type": "soup",
  "brief_description": "An easy, creamy chicken enchilada casserole. Slow cooking gently melds together the flavors of chicken thigh meat, cream of chicken soup, sour cream, and green chiles.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a pot, cover with water, and bring to a boil over high heat. Continue to boil until the chicken is done, about 10 minutes. Drain, allow chicken to cool, and cut into small pieces."
    },
    {
      "position": 2,
      "text": "Place chicken pieces in a large bowl. Stir in soup, garlic, sour cream, and green chiles."
    },
    {
      "position": 3,
      "text": "Spray the inside of slow cooker lightly with non-stick cooking spray."
    },
    {
      "position": 4,
      "text": "Tear tortillas into pieces, and arrange half of the pieces in one overlapping layer across the bottom of the slow cooker. Arrange half of the chicken, half of the soup, and half of the cheese on top. Repeat with remaining tortillas, chicken, soup, and cheese. Top with black olives."
    },
    {
      "position": 5,
      "text": "Cook on Low setting for 3 to 4 hours. Top with chives."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

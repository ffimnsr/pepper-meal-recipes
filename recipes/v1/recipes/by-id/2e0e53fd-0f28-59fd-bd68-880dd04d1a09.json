  "id": "2e0e53fd-0f28-59fd-bd68-880dd04d1a09",
  "slug": "gingerbread-boys",
  "name": "Gingerbread Boys",
  "recipe_type": "dessert",
  "brief_description": "These gingerbread boy cookies without molasses are flavored with clove, cinnamon, and a hint of orange flavor and can be cut into various shapes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cream sugar and butter together in a large bowl. Add egg and mix well. Mix in dark corn syrup and orange zest. Add flour, baking soda, cinnamon, ginger, cloves, and salt; mix until well combined. Wrap dough in plastic and chill in the refrigerator for at least 2 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets."
    },
    {
      "position": 3,
      "text": "Roll dough out on a lightly floured surface to 1/4 inch thickness. Cut into desired shapes using cookie cutters. Place cookies 1 inch apart on the prepared cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are firm and lightly toasted on the edges, 10 to 12 minutes."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

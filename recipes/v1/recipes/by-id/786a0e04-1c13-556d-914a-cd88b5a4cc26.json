  "id": "786a0e04-1c13-556d-914a-cd88b5a4cc26",
  "slug": "pierogi-i",
  "name": "Pierogi I",
  "recipe_type": "main",
  "brief_description": "Fashion delicious pierogi wrappers out of flour, eggs, sour cream, salt and water, then stuff them with a savory sauerkraut filling or a traditional potato and cheese filling. Cook in boiling water or freeze for later use.",
  "cuisine": "U.S. Polish",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, beat together eggs, carton sour cream, and salt. Stir in flour and warm water. Add water until dough feels like velvet. Turn out onto a lightly floured board, and knead until smooth. Roll out to a 1/8 to 1/4 inch thickness. Cut out 3 1/2 inch circles with either the top of a glass or a biscuit cutter. Cover with waxed paper to prevent drying out if not filling immediately."
    },
    {
      "position": 2,
      "text": "Place 1 or 2 tablespoons filling on one side of a circle of dough. Fold over, and seal by pressing the edges with a fork. Repeat until ingredients are used."
    },
    {
      "position": 3,
      "text": "Bring a large pot of water to a boil. Immerse pierogi. Cook until the dumplings float to the surface. (See Cook's Note for tips on freezing extra pierogies.)"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,

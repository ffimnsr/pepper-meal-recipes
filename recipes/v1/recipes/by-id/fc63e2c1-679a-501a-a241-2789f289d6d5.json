  "id": "fc63e2c1-679a-501a-a241-2789f289d6d5",
  "slug": "blueberry-cream-dessert",
  "name": "Blueberry Cream Dessert",
  "recipe_type": "salad",
  "brief_description": "For this blueberry cream dessert recipe, fresh blueberries are folded into a rich, creamy topping that's spread over a buttery graham cracker crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine graham cracker crumbs, melted butter, and \u00bc cup sugar in a medium bowl. Reserve \u00bc cup crust mixture; press remaining crust mixture into the bottom of a 10x6x2-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine cold water, \u00bd sugar, and gelatin in a small saucepan over medium-low heat; cook and stir until gelatin and sugar dissolve, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine sour cream and yogurt in a large bowl; gradually stir in gelatin mixture, then stir in vanilla. Refrigerate mixture until partially set, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Beat heavy cream in a glass or metal bowl until soft peaks form; fold in sour cream mixture. Stir in blueberries until incorporated."
    },
    {
      "position": 5,
      "text": "Spread blueberry cream evenly over crust; sprinkle reserved \u00bc graham cracker mixture over top. Chill in the refrigerator, 8 hours to overnight."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

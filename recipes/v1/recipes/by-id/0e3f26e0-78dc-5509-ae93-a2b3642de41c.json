  "id": "0e3f26e0-78dc-5509-ae93-a2b3642de41c",
  "slug": "heavenly-raspberry-dessert",
  "name": "Heavenly Raspberry Dessert",
  "recipe_type": "dessert",
  "brief_description": "This simple and stunning trifle-style dessert has layers of angel food cake chunks with raspberry cream.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9-inch tube pan. Break angel food cake into chunks; set aside."
    },
    {
      "position": 2,
      "text": "Stir raspberry gelatin and boiling water together in a bowl until gelatin is dissolved; place gelatin in the refrigerator to cool slightly, about 10 minutes. Stir raspberries with syrup into gelatin."
    },
    {
      "position": 3,
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form; fold whipped cream into raspberry mixture."
    },
    {
      "position": 4,
      "text": "Pour about 1/4 cup of raspberry mixture into prepared pan. Place 1/3 of cake chunks into pan; pour 1/3 of remaining raspberry mixture over cake. Repeat layering with remaining ingredients, ending with the raspberry mixture. Chill in refrigerator until firm, about 2 hours."
    },
    {
      "position": 5,
      "text": "To remove from pan, center a serving plate over tube pan; invert."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

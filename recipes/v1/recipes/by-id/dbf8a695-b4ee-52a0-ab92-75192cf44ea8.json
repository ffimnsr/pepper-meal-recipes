  "id": "dbf8a695-b4ee-52a0-ab92-75192cf44ea8",
  "slug": "enchiladas-verdes",
  "name": "Enchiladas Verdes",
  "recipe_type": "main",
  "brief_description": "Enchiladas verdes with shredded chicken in a homemade spicy tomatillo sauce; top with cilantro and cotija cheese for an incredibly delicious Mexican meal.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Cover a large griddle with aluminum foil and preheat to medium-high."
    },
    {
      "position": 2,
      "text": "Cook tomatillos, serrano peppers, and garlic on the hot griddle, turning occasionally, until toasted and blackened \u2014 about 5 minutes for garlic, 10 minutes for peppers, and 15 minutes for tomatillos. Remove to a bowl and allow to cool."
    },
    {
      "position": 3,
      "text": "Heat oil in a small, deep skillet to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Lightly fry tortillas, one at a time, in hot oil until warmed through, 3 to 5 seconds per side. Drain on a paper towel-lined plate."
    },
    {
      "position": 5,
      "text": "Place toasted tomatillos, serrano peppers, and garlic in a blender. Add water and blend until smooth; pour into a saucepan over medium heat and bring to a boil. Dissolve chicken bouillon in the mixture, reduce heat, and cook at a simmer until slightly thickened, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Soak tortillas in sauce, one at a time, for a few seconds. Fill each tortilla with shredded chicken and sprinkle with sauce. Roll up tortillas and place seam-side down in a serving dish."
    },
    {
      "position": 7,
      "text": "Spoon a generous amount of sauce over rolled tortillas. Top with lettuce, cilantro, crema, and cotija cheese. Pour remaining sauce on top or serve on the side."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

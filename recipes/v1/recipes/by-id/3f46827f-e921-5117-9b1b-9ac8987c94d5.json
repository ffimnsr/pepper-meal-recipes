  "id": "3f46827f-e921-5117-9b1b-9ac8987c94d5",
  "slug": "big-picnic-sandwich-recipe-11783475",
  "name": "Big Picnic Sandwich",
  "recipe_type": "main",
  "brief_description": "This big picnic sandwich is an Italian-style sammie piled high with salami, mortadella, ham, and provolone, spread with a quick-blended red pepper sauce and dressed with crunchy lettuce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine roasted red peppers, salt, and red pepper flakes in a blender. Blend on High until a smooth paste forms."
    },
    {
      "position": 3,
      "text": "Cut bread loaf lengthwise along the middle."
    },
    {
      "position": 4,
      "text": "Spread mayonnaise on 1 side of the loaf and red pepper paste on the other."
    },
    {
      "position": 5,
      "text": "Sprinkle chopped pepperoncini on top of the pepper spread, and season with salt and oregano."
    },
    {
      "position": 6,
      "text": "On the mayo side, layer salami, provolone, ham and mortadella, folding meat with some height where appropriate."
    },
    {
      "position": 7,
      "text": "Combine lettuce, olive oil, 1 tablespoon pepperoncini brine, and 1/2 teaspoon oregano in a bowl; mix well and place on top of meats."
    },
    {
      "position": 8,
      "text": "Close the lid of the giant sandwich and insert toothpicks or cocktail skewers to keep in place."
    },
    {
      "position": 9,
      "text": "Slice on arrival into 8 or 10 squares and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

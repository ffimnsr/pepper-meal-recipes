  "id": "94c9a316-037f-55db-8ced-4ee5de2e01cf",
  "slug": "chocolate-chip-bagel-casserole-recipe-11848547",
  "name": "Chocolate Chip Bagel Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Your family will love this chocolate chip bagel casserole. The recipe makes lots of cream cheese drizzle (don't skip!) which you can serve on the side. It\u2019s similar to baked French toast but made with bagels.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk together eggs, sugar, milk, whipping cream, butter, vanilla extract, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Layer bagels and chocolate chips in the baking dish. Pour egg mixture over the bagel pieces. Press down on bagel pieces with the back of a spoon to soak them in the egg mixture. Let stand for 15 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake casserole in the preheated oven until evenly puffed, golden brown, and a knife inserted near the center comes out clean, 45 to 50 minutes. Let casserole stand for 10 minutes before serving."
    },
    {
      "position": 6,
      "text": "For drizzle, whisk together cream cheese and melted butter in a large bowl until smooth. Whisk in powdered sugar, milk, and vanilla."
    },
    {
      "position": 7,
      "text": "Drizzle over the casserole. You will have more drizzle than you need. Serve additional drizzle on the side, or cover and refrigerate for up to a week to save for another use."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

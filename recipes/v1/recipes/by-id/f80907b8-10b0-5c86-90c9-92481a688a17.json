  "id": "f80907b8-10b0-5c86-90c9-92481a688a17",
  "slug": "15-minute-chili-crisp-noodles-recipe-11764811",
  "name": "15-Minute Chili Crisp Noodles",
  "recipe_type": "salad",
  "brief_description": "These 15-minute chili crisp noodles are spicy and bold, ramen noodles in a sauce of peanut butter, soy sauce, and sesame oil, an easy way to add flavor to a quick weeknight dinner. Serve with a cool cucumber salad and more chili crisp on the side.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a pot with water and bring to a boil. Add ramen, and cook until tender, 2 to 4 minutes. Drain noodles; reserve some cooking water to thin the sauce later if needed."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk soy sauce, chili crisp, peanut butter, rice vinegar, sesame oil, and brown sugar together in a small bowl."
    },
    {
      "position": 3,
      "text": "Add cooked noodles to a bowl, pour in sauce, and toss until well coated and combined. If sauce is too thick, stir in some reserved pasta water."
    },
    {
      "position": 4,
      "text": "Garnish with peanuts and sliced green onions and serve with extra chili crisp on the side."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

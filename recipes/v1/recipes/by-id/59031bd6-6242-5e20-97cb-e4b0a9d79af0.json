{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "59031bd6-6242-5e20-97cb-e4b0a9d79af0",
  "slug": "jamaican-brown-stew-chicken",
  "name": "Jamaican Brown Stew Chicken",
  "recipe_type": "soup",
  "brief_description": "Make this tender brown stew chicken full of sweet, savory, and spicy Caribbean flavors with Chef John's recipe for the famous Jamaican stew.",
  "cuisine": "Jamaican Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk garlic, white parts of green onions, brown sugar, thyme, habanero, vinegar, ginger, salt, pepper, paprika, and allspice together in a large mixing bowl."
    },
    {
      "position": 3,
      "text": "Make 2 cuts, about 1-inch apart, into the skin side of each thigh, perpendicular to the bone, cutting all the way down to the bone."
    },
    {
      "position": 4,
      "text": "Add chicken thighs to marinade; mix until evenly coated. Cover and place in the refrigerator to marinate, at least 4 hours or up to 12 hours. If possible, flip thighs several times while marinating."
    },
    {
      "position": 5,
      "text": "Remove chicken from marinade. Scrape off any chunks of marinade from chicken into the bowl and reserve for later."
    },
    {
      "position": 6,
      "text": "Heat 2 tablespoons oil in a large, deep, heavy-bottomed skillet or Dutch oven over medium-high heat until almost smoking. Working in batches, brown the chicken all over, about 5 minutes per side. Transfer chicken to the marinade bowl; set aside."
    },
    {
      "position": 7,
      "text": "Heat 1 tablespoon oil in the same pan over medium-high heat. Add onion and a pinch of salt; cook until golden brown, 3 to 5 minutes. Stir in 1 tablespoon brown sugar and cook until onions are dark brown and caramelized, 3 to 5 minutes more."
    },
    {
      "position": 8,
      "text": "Add chicken broth, ketchup, and bay leaves to the pan; bring to a boil. Add carrots, bell peppers, browned chicken thighs, and reserved marinade."
    },
    {
      "position": 9,
      "text": "Reduce heat to medium-low. Simmer, stirring occasionally, until chicken is tender and no longer pink in the center and sauce has reduced and thickened, 1 to 1 \u00bd hours. Skim excess fat that floats to the top; baste chicken occasionally with sauce."
    },
    {
      "position": 10,
      "text": "Taste and adjust seasoning. Stir in green parts of green onions. Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 40,

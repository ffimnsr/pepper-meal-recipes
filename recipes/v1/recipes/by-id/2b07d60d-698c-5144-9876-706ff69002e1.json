  "id": "2b07d60d-698c-5144-9876-706ff69002e1",
  "slug": "croque-monsieur-sliders-recipe-11728730",
  "name": "Croque Monsieur Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These 5-ingredient croque monsieur sliders are essentially ham and cheese sliders that are neither too sweet or savory and make a fantastic appetizer. The soft fluffy Hawaiian rolls knock this recipe out of the park.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (180 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Open up rolls but keep them attached. Lay them flat on the baking sheet. Stir mustard and butter together; spread over inner sides of rolls, on both top and bottom."
    },
    {
      "position": 3,
      "text": "Add a half piece of ham to bottom half of each roll; fold as needed to fit. Sprinkle each roll with a small amount of cheese. Close rolls over filling. Melt remaining butter and mustard mixture; brush over tops of rolls. Sprinkle each roll evenly with remaining cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is completely melted, about 10 minutes. Serve warm with more mustard for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

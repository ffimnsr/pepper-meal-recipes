  "id": "fa4b77d9-ed0d-53a4-8804-168dc183dae0",
  "slug": "pumpkin-thumbprint-cookies",
  "name": "Pumpkin Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "These pumpkin cookies filled with honey-sweetened crushed walnuts are a fall-inspired twist on classic thumbprint cookies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix whole wheat flour, cinnamon, baking powder, baking soda, nutmeg, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk pumpkin, honey, melted butter, and vanilla extract together in a separate bowl. Pour over the flour mixture and mix until combined."
    },
    {
      "position": 4,
      "text": "Drop cookie dough onto the baking sheets using 2 spoons or a cookie scoop. Use a floured finger to press a dimple into the center of each cookie."
    },
    {
      "position": 5,
      "text": "Mix walnuts, butter, and honey together for the filling. Evenly distribute the walnut filling among the cookie centers."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are firm and start to brown, about 15 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

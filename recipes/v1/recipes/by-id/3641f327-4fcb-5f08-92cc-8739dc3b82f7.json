  "id": "3641f327-4fcb-5f08-92cc-8739dc3b82f7",
  "slug": "no-churn-keto-ice-cream",
  "name": "Keto Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This keto ice cream recipe produces a deliciously rich and creamy vanilla ice cream that's super smooth and easy to make without an ice cream machine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream, sweetener, vodka, vanilla extract, xanthan gum, and salt in a wide-mouth pint-sized jar."
    },
    {
      "position": 2,
      "text": "Blend cream mixture with an immersion blender in an up-and-down motion until cream has thickened and soft peaks have formed, 60 to 75 seconds."
    },
    {
      "position": 3,
      "text": "Cover jar and place in the freezer for 3 to 4 hours, stirring every 30 to 40 minutes."
    }
  ],
  "servings": 3,

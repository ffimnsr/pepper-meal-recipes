  "id": "c913a050-bb9e-5fa7-9bd8-0e66372a336b",
  "slug": "depression-cake-i",
  "name": "Depression Cake I",
  "recipe_type": "dessert",
  "brief_description": "This Depression-era cake is a family recipe that has sugar but no eggs, butter, or milk. It uses shortening, raisins, flour, and spices for flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan combine shortening, water, raisins, cinnamon, nutmeg, allspice, cloves, and sugar. Simmer for 10 minutes. Remove from heat and let stand until cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 3,
      "text": "Stir flour and baking soda into the cooled raisin mixture and mix until just combined. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 45 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

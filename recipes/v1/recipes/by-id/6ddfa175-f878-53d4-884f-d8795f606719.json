  "id": "6ddfa175-f878-53d4-884f-d8795f606719",
  "slug": "minnesota-pork-chops",
  "name": "Minnesota Pork Chops",
  "recipe_type": "main",
  "brief_description": "Scrumptious wild rice and pork chop casserole with creamy mushroom sauce.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a skillet with a small amount of oil, brown the chops seasoned with salt and pepper. Spray a large 9x13 inch casserole dish with nonstick spray. Sprinkle the washed rice evenly in bottom of dish."
    },
    {
      "position": 3,
      "text": "Add water and mushrooms. Sprinkle with chicken bullion. Arrange the chops on top and spoon soup over chops and rice. Cover casserole with aluminum foil and seal tightly. Bake for 1 1/2 hours to 2 hours or until rice and chops are tender."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,

  "id": "57fa79ff-6ef6-55fa-8778-019df7c076f4",
  "slug": "salmon-and-spinach-fettuccine",
  "name": "Salmon and Spinach Fettuccine",
  "recipe_type": "main",
  "brief_description": "Smoked salmon, spinach, capers, and sun-dried tomatoes in a creamy Parmesan cheese sauce are served over fettuccine.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add fettuccine, and cook for 11 to 13 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "In a medium saucepan over medium heat, melt the butter, and blend with milk. Mix in the flour to thicken. Gradually stir in the Parmesan cheese until melted."
    },
    {
      "position": 3,
      "text": "Crumble salmon into the butter mixture. Stir in the spinach, capers, sun-dried tomatoes, and oregano. Cook and stir about 3 minutes, until heated through. Serve over the cooked pasta."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d8dca27a-23ab-5e9c-8e8e-0ec03e3d5c8f",
  "slug": "crunchy-and-delicious-granola",
  "name": "Crunchy and Delicious Granola",
  "recipe_type": "dessert",
  "brief_description": "Applesauce and pure maple syrup sweeten this granola made with dried cherries, pumpkin and sunflower seeds, and wheat germ.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Line 2 baking sheets with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine oatmeal, sunflower seeds, pumpkin seeds, sesame seeds, flax seeds, wheat germ, chopped dried cherries, salt, and cinnamon in a large bowl."
    },
    {
      "position": 4,
      "text": "Mix applesauce, maple syrup, and vanilla in a separate bowl."
    },
    {
      "position": 5,
      "text": "Pour applesauce mixture over the oatmeal mixture; mix until evenly coated."
    },
    {
      "position": 6,
      "text": "Spread the mixture onto the prepared baking sheets; smooth into a single thin layer."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven 20 minutes, stir gently to turn, and continue cooking until crisp and golden brown, another 15 to 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

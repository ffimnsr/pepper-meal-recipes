  "id": "9c74fdf3-4c1f-5144-b7b3-89cdad97cbcd",
  "slug": "cilantro-lime-coleslaw",
  "name": "Cilantro-Lime Coleslaw",
  "recipe_type": "salad",
  "brief_description": "A versatile cabbage slaw with mayonnaise, lime zest, and cilantro makes a great side dish for all kinds of foods, from Asian to Mexican-inspired dishes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, lime zest, lime juice, rice vinegar, garlic, sweet chili sauce, and sugar in a large bowl, stirring to dissolve sugar. Mix cilantro and red onion into dressing. Stir cabbage into dressing mixture, about 1 cup at a time, until all cabbage is coated."
    }
  ],
  "servings": 7,

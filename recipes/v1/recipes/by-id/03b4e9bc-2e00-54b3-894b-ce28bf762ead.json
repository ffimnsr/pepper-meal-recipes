  "id": "03b4e9bc-2e00-54b3-894b-ce28bf762ead",
  "slug": "creamy-israeli-style-hummus",
  "name": "Creamy Israeli-Style Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Whether you're serving this with alongside chips or crudite or using it in a veggie sandwich, you'll love the taste of this creamy hummus flavored with a touch of peanut butter.",
  "cuisine": "Israeli",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 tablespoons chickpea liquid and 1 cup chickpeas in a bowl for hummus. Reserve remaining chickpeas and liquid for another use."
    },
    {
      "position": 2,
      "text": "Combine olive oil, peanut butter, lemon juice, sesame oil, cumin, onion powder, and salt in a blender. Blend until smooth, about 2 minutes. Pour in chickpeas and liquid and blend until creamy, 2 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Transfer to an airtight container and chill in the refrigerator for at least 2 hours before serving. Garnish with green onions to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

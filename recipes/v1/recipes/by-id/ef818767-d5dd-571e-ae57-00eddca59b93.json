  "id": "ef818767-d5dd-571e-ae57-00eddca59b93",
  "slug": "cultured-cashew-cream-cheese-recipe-8424187",
  "name": "Cultured Cashew Cream Cheese",
  "recipe_type": "appetizer",
  "brief_description": "This cultured cashew cream cheese is a vegan cheese spread, made with soaked raw cashews, fermented until tangy. This plant-based spread is wonderfully creamy and tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cashews in a bowl with enough cold water to cover, and soak cashews overnight or up to 24 hours."
    },
    {
      "position": 2,
      "text": "Drain, and add nuts to a blender, along with sea salt, nutritional yeast, vinegar, cashew yogurt, and water. Blend on high until very smooth."
    },
    {
      "position": 3,
      "text": "Transfer into a sterilized glass container (See Note), and let ferment in a warm spot for 8 to 24 hours, or until the mixture is as tangy and fermented as you want."
    },
    {
      "position": 4,
      "text": "This can be done at room temperature, which will take longer, or wrapped in a heating pad set on low (about 90 degrees F (32 degrees C)), which will speed up the process."
    },
    {
      "position": 5,
      "text": "Check, stir, and taste mixture a few times during the process to monitor its progress."
    },
    {
      "position": 6,
      "text": "Once the mixture has fermented as long as you want, season with salt to taste. At this point, additional flavoring can be added such as garlic, herbs, or spices."
    },
    {
      "position": 7,
      "text": "Chill before serving, at least 1 hour. For best results, refrigerate for 24 to 48 hours to let the flavors develop even more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

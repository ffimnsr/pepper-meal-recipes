{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2dc0d8ec-5768-5c21-bd50-ae438d7da64d",
  "slug": "tofu-scramble-wraps",
  "name": "Tofu Scramble Wraps",
  "recipe_type": "dessert",
  "brief_description": "Crunchy sweet potatoes, avocado, and a seitan and tofu scramble fill these on-the-go breakfast tortilla wraps that are totally vegan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking tray with parchment paper or a silicone liner (such as Silpat\u00ae)."
    },
    {
      "position": 2,
      "text": "Combine sweet potatoes, onion, bell pepper, lime juice, coconut aminos, garlic powder, and pepper for potatoes in a medium bowl, stirring so that everything is evenly coated. Transfer to the prepared baking tray."
    },
    {
      "position": 3,
      "text": "Cook in the preheated oven until crisp and tender, 30 to 40 minutes, stirring halfway through cooking time."
    },
    {
      "position": 4,
      "text": "While the potatoes are cooking, crumble the tofu into a large, nonstick pan. Add nutritional yeast, coconut aminos, garlic powder, pepper, and black salt. Cook over low heat, adding 1 tablespoon of water at a time if the tofu starts to stick, for 10 minutes. Add seitan and tomato, and cook until everything is warmed through, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Place a tortilla on a flat surface. Place some potatoes, avocado, and tofu scramble on the tortilla. Start at the bottom and fold the tortilla edge up and over the center into a wrap. Repeat to form remaining wraps."
    },
    {
      "position": 6,
      "text": "Heat a flat-bottomed, cast iron pan over medium heat. Place the wraps in the hot pan, folded-side down. Cook until golden brown and sealed, about 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "32af1d6c-e571-5bbb-a453-a0677e5474db",
  "slug": "spinach-stuffed-portobello-mushrooms-with-avocado",
  "name": "Spinach Stuffed Portobello Mushrooms with Avocado",
  "recipe_type": "appetizer",
  "brief_description": "A colorful blend of sun-dried tomatoes, red bell pepper, and spinach is quickly cooked before being spooned atop a large baked portobello mushroom. Avocado pieces and Parmesan cheese are added just before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak sun-dried tomatoes in a bowl of hot water until softened, about 20 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Line a baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Rub the caps of the portobello mushrooms with 2 tablespoons olive oil, or as needed; arrange mushrooms gill sides up on the prepared baking sheet. Season mushrooms with oregano, sea salt, and black pepper."
    },
    {
      "position": 5,
      "text": "Bake mushrooms in the preheated oven until tender, 8 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Place the mushroom stems, sun-dried tomatoes, red bell pepper, and garlic cloves in a food processor; pulse until finely chopped."
    },
    {
      "position": 7,
      "text": "Heat 1 tablespoon olive oil in a large skillet over medium-high heat. Cook and stir sun-dried tomato mixture in the hot oil until fragrant, about 2 minutes."
    },
    {
      "position": 8,
      "text": "Stir spinach into the skillet; cover, reduce heat to medium-low, and cook until spinach is wilted, about 3 minutes more, stirring occasionally. Drain excess liquid from skillet."
    },
    {
      "position": 9,
      "text": "Spoon spinach mixture over baked mushroom caps."
    },
    {
      "position": 10,
      "text": "Divide diced avocado atop stuff mushrooms and sprinkle with Parmesan cheese to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

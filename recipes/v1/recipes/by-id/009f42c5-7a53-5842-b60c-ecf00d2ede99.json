  "id": "009f42c5-7a53-5842-b60c-ecf00d2ede99",
  "slug": "corned-beef-hash-nachos",
  "name": "Corned Beef Hash Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Canned corned beef hash adds an interesting twist to nachos loaded with black beans, salsa, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray a skillet with cooking spray and heat over medium heat. Add corned beef hash and saute until slightly caramelized, 5 to 7 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Cover a metal cooking tray with nacho chips. Cover nacho chips with corned beef hash, Cheddar cheese, and black beans."
    },
    {
      "position": 4,
      "text": "Cook in the preheated oven until cheese is melted and starting to brown and crisp, 8 to 10 minutes. Remove from the oven and top with salsa, tomato, onion, sour cream, olives, and jalapenos."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

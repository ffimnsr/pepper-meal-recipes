  "id": "2cd350a3-4ae8-551a-8eb8-9b2860d69569",
  "slug": "matts-fried-turkey-brine",
  "name": "Matt\u2019s Fried Turkey Brine",
  "recipe_type": "main",
  "brief_description": "This recipe for deep-fried turkey brine is loaded with flavor from brown sugar, candied ginger, herbs, and spices and will result in a standout turkey!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine vegetable broth, kosher salt, brown sugar, peppercorns, allspice berries, and candied ginger in a large stockpot over medium-high heat. Stir to dissolve sugar and salt; bring mixture to a boil."
    },
    {
      "position": 3,
      "text": "Remove from the heat and cool to room temperature. Cover and refrigerator until well chilled, at least 4 hours."
    },
    {
      "position": 4,
      "text": "Remove from the refrigerator and add water with ice chunks, apple and onion slices, cinnamon stick, rosemary sprigs, and sage leaves. Stir in remaining 1 cup water and brine is ready to use."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

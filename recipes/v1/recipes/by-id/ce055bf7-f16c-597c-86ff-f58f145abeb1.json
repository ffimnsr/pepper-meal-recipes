  "id": "ce055bf7-f16c-597c-86ff-f58f145abeb1",
  "slug": "campbells-slow-cooker-chicken-and-dumplings",
  "name": "Campbell's\u00ae Slow-Cooker Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "The slow-cooker simmers chicken, potatoes, carrots, and celery in a creamy sauce made with Campbell's\u00ae Condensed Cream of Chicken Soup, to be topped with tender dumplings made easy with baking mix.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place the chicken, potatoes, carrots and celery into a 6-quart slow cooker."
    },
    {
      "position": 2,
      "text": "Stir the soup, water, thyme and black pepper in a small bowl. Pour the soup mixture over the chicken and vegetables."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 7 to 8 hours or on High for 4 to 5 hours until chicken is cooked through."
    },
    {
      "position": 4,
      "text": "Stir the baking mix and milk in a medium bowl. Spoon the batter over the chicken mixture. Turn the heat to HIGH. Tilt the lid to vent and cook for 30 minutes or until the dumplings are cooked in the center."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 480,

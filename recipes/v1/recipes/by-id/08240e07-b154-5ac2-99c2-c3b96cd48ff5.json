  "id": "08240e07-b154-5ac2-99c2-c3b96cd48ff5",
  "slug": "streusel-apple-coffeecake",
  "name": "Streusel Apple Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This apple coffee cake, made moist with yogurt, features a fruity layer of Granny Smiths and buttery streusel in the middle, plus more streusel on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9- or 10-inch Bundt pan."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, \u00be cup flour, and cinnamon in a bowl; cut in \u00bd cup cold butter with a fork until crumbly. Stir in walnuts. Set streusel aside."
    },
    {
      "position": 3,
      "text": "Whisk 3\u00bc cups flour, baking powder, and baking soda together in a bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Beat white sugar and \u00be cup butter together in a large bowl using an electric mixer until light and fluffy; beat in eggs, one at a time, beating well after each addition. Stir in yogurt and vanilla extract; stir in flour mixture until just blended."
    },
    {
      "position": 5,
      "text": "Pour 3 cups batter into the prepared Bundt pan; sprinkle with \u00bc streusel then layer with apples. Sprinkle with \u00bd remaining streusel. Pour in remaining batter; top with remaining streusel and lightly pat down into batter."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 60 minutes. Cool in the pan on a wire rack for 15 minutes. Tap the pan firmly a few times, then shake gently to loosen the cake. Place a cookie sheet over the pan and carefully invert to release cake. Remove the pan; transfer cake to the rack and cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "slug": "king-ranch-chicken-sheet-pan-tacos-recipe-11838840",
  "name": "King Ranch Chicken Sheet Pan Tacos",
  "recipe_type": "main",
  "brief_description": "These King Ranch chicken sheet pan tacos are the handheld taco version of the famously delicious King Ranch casserole, quick to assemble, and easy to bake.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix chicken, green chilies, cream of chicken soup, onion powder, and cheese in a bowl. Stir until evenly combined."
    },
    {
      "position": 3,
      "text": "Place tortillas on a large baking sheet (2 sheets if needed) in a single layer. Brush each tortilla with olive oil. Flip tortillas over so the oil side faces down on the baking sheet."
    },
    {
      "position": 4,
      "text": "Spoon chicken mixture down half of each tortilla. Fold the other half of the tortilla over the chicken mixture. Press down to seal."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Turn the oven\u2019s broiler onto Low broil and broil until cheese is melted and tacos are crispy, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

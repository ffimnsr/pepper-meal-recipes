  "id": "e01fee51-8a6c-53e9-bfb7-8fe641d484ff",
  "slug": "gluten-free-zucchini-bread-or-muffins",
  "name": "Gluten-Free Zucchini Bread (or Muffins)",
  "recipe_type": "breakfast",
  "brief_description": "Gluten-free zucchini bread that tastes like regular zucchini bread is easy to make using this recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Mix flour, cinnamon, salt, baking soda, baking powder, and nutmeg together in a bowl. Beat sugar, applesauce, eggs, oil, and vanilla extract together in a separate bowl; stir in zucchini. Slowly mix flour mixture into zucchini mixture until well blended; pour into prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

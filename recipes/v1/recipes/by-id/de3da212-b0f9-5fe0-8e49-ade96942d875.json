  "id": "de3da212-b0f9-5fe0-8e49-ade96942d875",
  "slug": "cannoli-cream-pie-recipe-8416107",
  "name": "Cannoli Cream Pie",
  "recipe_type": "dessert",
  "brief_description": "This cannoli cream pie has a creamy filling loaded with chocolate chips and pistachios for a delicious dessert that tastes just like cannoli filling.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients, and preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Bake graham cracker crust in the preheated oven until golden brown and fragrant, about 10 minutes. Let cool completely on a wire rack."
    },
    {
      "position": 3,
      "text": "Add heavy whipping cream to a clean bowl, and beat with an electric mixer to stiff peaks. Set aside."
    },
    {
      "position": 4,
      "text": "Beat cream cheese and powdered sugar together in another bowl with an electric mixer until smooth. Fold in ricotta, vanilla extract, and salt until thoroughly combined."
    },
    {
      "position": 5,
      "text": "Gently fold whipped cream into ricotta mixture. Gently fold in chopped pistachios and mini chocolate chips."
    },
    {
      "position": 6,
      "text": "Pour the filing into the prepared pie crust and spread evenly. Chill in the refrigerator for 5 hours or up to overnight. Top with mini chocolate chips to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

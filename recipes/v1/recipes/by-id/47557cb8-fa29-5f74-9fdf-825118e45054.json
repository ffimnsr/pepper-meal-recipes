  "id": "47557cb8-fa29-5f74-9fdf-825118e45054",
  "slug": "king-ranch-chicken-casserole-iii",
  "name": "Easy King Ranch Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This recipe makes a popular Tex-Mex casserole of chicken with creamy tomato sauce, tortillas, vegetables and Cheddar.",
  "cuisine": "Tex Mex Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a shallow 3-quart casserole dish."
    },
    {
      "position": 2,
      "text": "Combine broth, chicken soup, mushroom soup, and tomatoes with chiles in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Layer 1/2 each of tortillas, chicken, onion, bell pepper, and cheese in the prepared casserole dish. Pour 1/2 the soup mixture over layers. Repeat layers with remaining 1/2 each tortillas, chicken, onion, and bell pepper; pour remaining 1/2 soup mixture over top, then top with remaining 1/2 cheese. Sprinkle with chili powder and garlic salt."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

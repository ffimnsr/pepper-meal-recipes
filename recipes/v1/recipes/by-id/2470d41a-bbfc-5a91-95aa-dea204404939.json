  "id": "2470d41a-bbfc-5a91-95aa-dea204404939",
  "slug": "coffee-rubbed-steak-recipe-8675624",
  "name": "Coffee-Rubbed Steak",
  "recipe_type": "main",
  "brief_description": "This coffee-rubbed steak uses coffee grounds in a rub to create a deep, dark crust when seared, which enhances a steak's natural umami.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine coffee, brown sugar, chili powder, garlic powder, paprika, salt, and cayenne pepper in a small bowl. Set aside. Let steak come to room temperature."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill to medium-high. Pat steak dry with paper towels and season both sides generously with coffee rub."
    },
    {
      "position": 3,
      "text": "Place steaks on the preheated grill. Close the lid and cook for 4 to 5 minutes. Flip steaks and cook until an instant read thermometer inserted near the center reads 130 to 135 degrees F (54 to 57 degrees C), 4 to 5 minutes more, for medium-rare."
    },
    {
      "position": 4,
      "text": "Remove steak from the grill, tent with foil, and let it rest for a few minutes to allow juices to redistribute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,
  "difficulty": "easy",

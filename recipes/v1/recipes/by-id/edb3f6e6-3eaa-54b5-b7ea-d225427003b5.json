  "id": "edb3f6e6-3eaa-54b5-b7ea-d225427003b5",
  "slug": "potato-crunchy-tenders",
  "name": "Potato Crunchy Tenders",
  "recipe_type": "main",
  "brief_description": "These potato crunchy tenders feature fried chicken fingers coated in garlic-flavored mashed potato flakes before frying, making a quick, easy meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat."
    },
    {
      "position": 2,
      "text": "Meanwhile, beat together milk and egg in a shallow bowl. Stir together instant mashed potatoes, salt, and pepper in another shallow bowl."
    },
    {
      "position": 3,
      "text": "Stir chicken tenders with milk mixture to coat thoroughly, then shake off excess milk and dip each tender into potato flakes."
    },
    {
      "position": 4,
      "text": "Cook breaded tenders in hot oil until golden brown, 7 to 10 minutes. Drain on a paper towel-lined plate."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

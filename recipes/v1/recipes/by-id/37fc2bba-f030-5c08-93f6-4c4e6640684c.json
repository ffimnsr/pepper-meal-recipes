  "id": "37fc2bba-f030-5c08-93f6-4c4e6640684c",
  "slug": "sherrys-perfect-sous-vide-eggs",
  "name": "Sherry's Perfect Sous Vide Eggs",
  "recipe_type": "breakfast",
  "brief_description": "Make sous vide eggs in a water bath until whites are solid and the yolks are soft, creamy, and cooked to perfection with this foolproof recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare a heat-proof container of water with a sous vide cooker. Set temperature to 150 degrees F (66 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a bowl with enough ice water to cover eggs; set aside."
    },
    {
      "position": 3,
      "text": "Fill a saucepan with water and bring to a boil. Add eggs to boiling water and cook until whites are set, exactly 5 minutes. Transfer eggs to the ice bath to stop the cooking process, at least 1 minute."
    },
    {
      "position": 4,
      "text": "Place eggs into the sous vide water bath; set a timer for 40 minutes."
    },
    {
      "position": 5,
      "text": "Serve immediately or refrigerate and reheat for a few minutes in the sous vide or a bowl of hot water."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

  "id": "75579699-401d-5336-90fd-42c29d79ef65",
  "slug": "apricot-cream-cheese-thumbprints",
  "name": "Apricot Cream Cheese Thumbprints",
  "recipe_type": "dessert",
  "brief_description": "Apricot cream cheese thumbprint cookies always look so pretty on the cookie plates I give for Christmas.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, cream together butter, sugar, and cream cheese until smooth. Beat in eggs, one at a time, then stir in lemon juice and zest. Combine flour and baking powder in a bowl; stir into cream cheese mixture until just combined. Cover and chill until firm, about 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Roll tablespoonfuls of dough into balls, and place them 2 inches apart on ungreased cookie sheets. Using your finger, make an indention in the center of each ball and fill with 1/2 teaspoon of apricot preserves."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the edges are golden, switching racks halfway through, about 15 minutes. Allow cookies to cool on the baking sheets briefly before removing to wire racks to cool completely. Sprinkle with confectioner's sugar. Repeat to bake remaining cookies."
    }
  ],
  "servings": 84,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "73128482-4a61-5e7d-9ec4-7c6952d1dc51",
  "slug": "yakamein-new-orleans-style-noodle-soup-recipe-8422264",
  "name": "Yakamein (New Orleans-Style Noodle Soup)",
  "recipe_type": "soup",
  "brief_description": "This is my take on yakamein (New Orleans-style noodle soup) that\u2019s famous only locally, but is one soup you\u2019ll want to know about. Known in New Orleans as a very effective hangover cure\u2014its nickname is Old Sober\u2014it is also a beautifully comforting and delicious thing to eat.",
  "cuisine": "Southern Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef pieces into a bowl and add salt, black pepper, cayenne pepper, and paprika. Toss very thoroughly until meat is evenly coated. Let sit at room temperature for about 20 minutes before browning, or place in the fridge until needed."
    },
    {
      "position": 2,
      "text": "Add oil to a heavy-bottomed pot, and heat on high until oil is shimmering. Add beef in a single layer, and sear until a nice brown crust forms, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Turn beef over, and let other side cook about 2 minutes. The second side will not brown like the first, but that\u2019s okay. Turn heat down to medium-high; remove beef to a bowl and set aside."
    },
    {
      "position": 4,
      "text": "Add onions, celery, peppers, and minced garlic to the pot, and cook, stirring, until onions begin to turn translucent, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Add beef back in along with any accumulated juices. Add soy sauce, Worcestershire sauce, granulated garlic, water, and beef bouillon paste. Stir and wait for soup to come to a simmer. Lower heat to medium-low and simmer until the meat is very tender, 60 to 90 minutes."
    },
    {
      "position": 6,
      "text": "Before serving, taste and adjust with more salt or soy if needed. Keep soup on low heat until ready to serve."
    },
    {
      "position": 7,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender, about 12 minutes. Drain, and divide evenly between 4 large soup bowls."
    },
    {
      "position": 8,
      "text": "Ladle hot soup over noodles, and garnish each bowl with a hardboiled egg , hot sauce, and sliced green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "a8778763-00d1-5f53-a197-0ab1d913f676",
  "slug": "chef-johns-beef-goulash",
  "name": "Chef John's Beef Goulash",
  "recipe_type": "soup",
  "brief_description": "This Hungarian-style goulash is a thick beef stew that is great served over buttered noodles and garnished with sour cream.",
  "cuisine": "Hungarian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season beef with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large skillet over high heat; cook and stir beef in hot oil in batches until browned on all sides, about 5 minutes per batch."
    },
    {
      "position": 4,
      "text": "Transfer to a large stockpot and reserve drippings in the skillet."
    },
    {
      "position": 5,
      "text": "Return skillet to medium heat; stir onions into the reserved drippings, drizzle olive oil over onions, season with 1/2 teaspoon salt and cook until onion has softened, about 5 minutes. Transfer to the stockpot with beef."
    },
    {
      "position": 6,
      "text": "Combine paprika, caraway seeds, black pepper, marjoram, thyme, and cayenne pepper in the skillet and toast over medium heat until fragrant, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Add 1 cup chicken broth and stir; transfer to the beef and onion mixture."
    },
    {
      "position": 8,
      "text": "Stir 3 cups chicken broth into beef mixture. Add tomato paste, garlic, vinegar, sugar, 1/2 teaspoon salt, and bay leaf; place stockpot over high heat and bring to a boil."
    },
    {
      "position": 9,
      "text": "Reduce heat to low and simmer until a fork inserts easily into the meat, 1 1/2 to 2 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

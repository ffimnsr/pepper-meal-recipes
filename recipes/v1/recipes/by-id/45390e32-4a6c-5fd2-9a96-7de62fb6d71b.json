  "id": "45390e32-4a6c-5fd2-9a96-7de62fb6d71b",
  "slug": "slow-cooker-ribs",
  "name": "Slow Cooker Ribs",
  "recipe_type": "drink",
  "brief_description": "These crockpot boneless ribs use a set-it-and-forget-it slow cooker recipe for tender country-style pork cooked in barbecue sauce and orange juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together steak seasoning, garlic salt, black pepper, and chili powder in a small bowl until combined."
    },
    {
      "position": 3,
      "text": "Rub over ribs and place into the bottom of a slow cooker."
    },
    {
      "position": 4,
      "text": "Pour in barbecue sauce, Worcestershire sauce, soy sauce, teriyaki sauce, orange juice, and hot pepper sauce. Liquid should not cover ribs completely."
    },
    {
      "position": 5,
      "text": "Cook on Low until ribs are tender, about 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

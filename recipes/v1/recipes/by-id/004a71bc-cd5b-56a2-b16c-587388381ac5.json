  "id": "004a71bc-cd5b-56a2-b16c-587388381ac5",
  "slug": "air-fryer-potstickers",
  "name": "Air Fryer Potstickers",
  "recipe_type": "main",
  "brief_description": "Cook potstickers in an air fryer with this quick, easy, delicious weeknight dinner recipe for crispy and juicy ground pork and vegetable dumplings.",
  "cuisine": "World Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pork, water chestnuts, mushrooms, sesame oil, soy sauce, and Sriracha in a large skillet over medium-high heat. Cook and stir until pork is crumbly and no longer pink, about 6 minutes. Remove from heat and let sit until cool enough to handle, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Lay 8 dumpling wrappers on a clean work surface. Place a heaping teaspoonful of pork mixture in the middle of each wrapper. Pull both sides up like a taco and pinch the tops until sealed."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 3 minutes. Use tongs to flip potstickers and cook for 3 minutes more. Transfer to a paper towel-lined plate. Repeat steps 3 and 4 until pork mixture is used up."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8d0c008c-4670-55ad-a187-f1c7b0420a3f",
  "slug": "ore-ida-slow-cooker-loaded-potato-soup",
  "name": "ORE-IDA Slow-Cooker Loaded Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This ORE-IDA slow-cooker loaded potato soup recipe makes a hearty, rich, and creamy potato soup with Cheddar cheese, hash brown potatoes, and bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a slow cooker with cooking spray."
    },
    {
      "position": 2,
      "text": "Add sour cream, cream cheese, and pepper to the prepared slow cooker; stir to combine. Gradually stir in milk until combined. Add potatoes, cheese, and bacon; stir to combine."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 3 to 4 hours, or High for 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Sprinkle with onions before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

  "id": "fa64e5fb-2c3a-584e-9b9f-68128147dd2c",
  "slug": "linguine-with-clam-sauce",
  "name": "Linguine with Clam Sauce",
  "recipe_type": "main",
  "brief_description": "Linguini with clam sauce is a quick and easy Italian dinner. The garlicky sauce is made with canned clams in butter, oil, parsley, and basil.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Drain."
    },
    {
      "position": 3,
      "text": "While the pasta is cooking, combine clams with juice, oil, butter, parsley, basil, garlic, and pepper in a large saucepan."
    },
    {
      "position": 4,
      "text": "Cook over medium heat until boiling."
    },
    {
      "position": 5,
      "text": "Serve warm clam sauce over pasta."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

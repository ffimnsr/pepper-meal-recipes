  "id": "7e5e1a82-326f-569f-baef-62ba7d95c3e2",
  "slug": "full-of-veggies-burritos",
  "name": "Full-of-Veggies Burritos",
  "recipe_type": "main",
  "brief_description": "These vegan burritos are packed with healthy vegetables like portobello mushrooms, spinach, tomatoes, onion, and black beans and are flavored with a hot chile-based spice mixture.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium heat until sizzling. Add mushrooms and onion and cook until mushrooms begin to soften, about 5 minutes. Add beans, diced tomatoes, and 2 tablespoons reserved tomato juice. Season with chorizo sausage seasoning and cook, stirring constantly, about 4 minutes. Add spinach and cook until wilted, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add a few tablespoons of the vegetable mixture to the middle of a warmed tortilla. Fold in the outer edges, beginning at the middle edge of tortilla, and fold inward towards the filling; continue rolling until filling is enclosed. Repeat with remaining tortillas and filling."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

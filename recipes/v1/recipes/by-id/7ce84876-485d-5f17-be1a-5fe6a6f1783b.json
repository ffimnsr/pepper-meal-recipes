  "id": "7ce84876-485d-5f17-be1a-5fe6a6f1783b",
  "slug": "quinoa-black-bean-burgers",
  "name": "Quinoa Black Bean Burgers",
  "recipe_type": "main",
  "brief_description": "Vegetarian quinoa-black bean burgers are easy, quick, and delicious served on a whole wheat bun with garlic-lemon mayo, spinach, tomato, and onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, about 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Roughly mash black beans with a fork, leaving some whole, to form a paste-like mixture. Mix quinoa, bread crumbs, bell pepper, egg, onion, garlic, cumin, hot pepper sauce, and salt into black beans using your hands. Form into 5 patties."
    },
    {
      "position": 3,
      "text": "Add olive oil to a large skillet and heat on medium."
    },
    {
      "position": 4,
      "text": "Cook patties until heated through and lightly browned, 2 to 3 minutes per side."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

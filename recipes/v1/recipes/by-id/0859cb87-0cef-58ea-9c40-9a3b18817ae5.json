  "id": "0859cb87-0cef-58ea-9c40-9a3b18817ae5",
  "slug": "old-fashioned-strawberry-pie",
  "name": "Old-Fashioned Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "A wonderful old-fashioned strawberry pie recipe made with fresh strawberries piled into a prepared crust and baked for an easy summer dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place 1 crust in the bottom of a 9-inch pie pan."
    },
    {
      "position": 3,
      "text": "Combine sugar, flour, and cinnamon in a bowl. Mix lightly through strawberries."
    },
    {
      "position": 4,
      "text": "Pour filling into the pastry-lined pan and dot with butter pieces."
    },
    {
      "position": 5,
      "text": "Cover with top crust and cut slits in the top to vent. Seal and flute the edges."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the crust is slightly browned, 35 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,

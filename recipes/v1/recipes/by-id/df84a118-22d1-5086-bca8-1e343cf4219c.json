  "id": "df84a118-22d1-5086-bca8-1e343cf4219c",
  "slug": "sinful-chocolate-biscotti",
  "name": "Sinful Chocolate Biscotti",
  "recipe_type": "dessert",
  "brief_description": "These sinful chocolate biscotti with cocoa powder, chocolate chips, and a touch of espresso taste great with a cup of coffee on a cold day.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine vanilla extract and espresso powder in a small bowl; mix until espresso powder is dissolved."
    },
    {
      "position": 3,
      "text": "Sift flour, cocoa powder, baking powder, and salt into a bowl; mix in chocolate chips."
    },
    {
      "position": 4,
      "text": "Whisk vanilla mixture, sugar, eggs, and oil together in a large bowl. Add flour mixture; stir, by hand if needed, until dough comes together and is thick and stiff."
    },
    {
      "position": 5,
      "text": "Divide dough into 2 equal pieces and place onto the baking sheets. Shape each piece into a log as long as the baking sheet; press down with wet hands to about 1/2 inch thickness."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until firm, about 25 minutes. Remove from oven and cool until easily handled, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Move cooled logs to a cutting board and slice into 1/2-inch long slices with a serrated knife. Return the slices to the baking sheets, placing them on their sides."
    },
    {
      "position": 8,
      "text": "Bake until dry, about 6 minutes per side. Remove from oven and let cool until hardened on wire racks."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 37,
  "preparation_time_minutes": 30,

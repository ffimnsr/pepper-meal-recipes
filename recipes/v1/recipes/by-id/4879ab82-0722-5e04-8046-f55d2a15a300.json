  "id": "4879ab82-0722-5e04-8046-f55d2a15a300",
  "slug": "awesome-irish-nachos",
  "name": "Awesome Irish Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These Irish nachos feature waffle fries garnished with fresh tomatoes, olives, jalape\u00f1os, and lettuce for a first-rate St. Patrick's Day appetizer.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange waffle fries in a single layer on a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until light golden in color, 12 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, cook and stir ground beef in a large skillet until browned and crumbly, 5 to 7 minutes. Drain excess grease. Stir in taco seasoning and cook for 1 to 2 minutes more."
    },
    {
      "position": 5,
      "text": "Transfer baked fries to a 9x13-inch baking pan. Spread seasoned ground beef evenly over fries. Cover beef with cheese."
    },
    {
      "position": 6,
      "text": "Return to the oven until cheese has melted, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with tomatoes, olives, jalape\u00f1os, and lettuce to serve. Dollop sour cream and guacamole on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "437c37f0-8cd5-5a08-9556-2b4d02fcef41",
  "slug": "fresh-strawberry-chia-jam",
  "name": "Fresh Strawberry Chia Jam",
  "recipe_type": "breakfast",
  "brief_description": "Fresh strawberries are blended with lime juice, chia seeds, and agave to make this chunky, 100% raw strawberry jam.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries, agave, 1/4 cup chia seeds, and lime juice in a large bowl. Blend with an immersion blender until strawberries are chunky. Add remaining 2 tablespoons chia seeds and mix well with a wooden spoon."
    },
    {
      "position": 2,
      "text": "Pour the mixture into two 1/2-pint canning jars. Allow to set in the refrigerator or freezer for at least 8 hours before consuming."
    }
  ],

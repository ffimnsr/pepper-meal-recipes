  "id": "c4505f5a-fccf-5fa2-92ec-8d2ce2826677",
  "slug": "cake-mix-gingerbread-men",
  "name": "Cake Mix Gingerbread Men",
  "recipe_type": "appetizer",
  "brief_description": "These adorable little gingerbread guys are quick and easy to make with spice cake mix. Let the kids use their imagination to decorate them!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cake mix, flour, eggs, oil, molasses, and ginger in a large bowl (mixture will be soft). Refrigerate 2 hours."
    },
    {
      "position": 3,
      "text": "Place dough on a lightly floured surface; cover with waxed paper. Roll out dough to 1/4-inch thickness. Cut with a gingerbread man cookie cutter. Place 3 inches apart on an ungreased cookie sheet. Decorate with nonpareil sprinkles."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 8 to 10 minutes, or until edges start to brown. Remove immediately to a cooling rack."
    },
    {
      "position": 5,
      "text": "Place icing in zip-top freezer bag. Snip the tip off one corner to make a small hole. Pipe a face and ruffles onto each cookie."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

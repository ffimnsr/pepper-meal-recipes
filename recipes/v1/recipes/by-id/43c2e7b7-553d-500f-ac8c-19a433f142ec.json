  "id": "43c2e7b7-553d-500f-ac8c-19a433f142ec",
  "slug": "zucchini-pie",
  "name": "Zucchini Pie",
  "recipe_type": "breakfast",
  "brief_description": "This zucchini pie is like a crustless quiche. It's easy to make with shredded zucchini, baking mix, cheese, and herbs for a tasty way to enjoy zucchini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place shredded zucchini in a bowl and toss with 1/2 teaspoon salt; let stand for 15 minutes. Transfer into a clean kitchen towel and wring out excess liquid into the sink."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie plate."
    },
    {
      "position": 4,
      "text": "Combine zucchini, eggs, baking mix, onion, melted butter, Cheddar cheese, Parmesan cheese, rosemary, parsley, and pepper in a large bowl; mix well."
    },
    {
      "position": 5,
      "text": "Spread mixture into the prepared pie plate or baking pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and a knife inserted in the center comes out clean, about 45 minutes."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

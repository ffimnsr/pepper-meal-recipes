  "id": "5554aed5-1413-5b57-9928-f980aa58bdf9",
  "slug": "chili-lime-shrimp-fajitas",
  "name": "Chili-Lime Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "These shrimp fajitas are topped with sauteed vegetables, cilantro, Cheddar cheese, and sour cream for a quick meal in under 1 hour.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, 1/4 cup cilantro, chili powder, garlic, lime juice, and salt together in a bowl; add shrimp, toss to coat, and marinate in the refrigerator for 20 minutes."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat; spray with cooking spray. Add onion, green bell pepper, and serrano chile pepper; saute until tender, 10 to 12 minutes. Transfer vegetables to a bowl and cover with aluminum foil to keep warm."
    },
    {
      "position": 3,
      "text": "Pour shrimp and marinade into the same skillet over medium-high heat; cook until shrimp are pink and opaque, about 2 minutes per side. Stir vegetables into shrimp mixture; cook and stir until heated through, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Spoon shrimp-vegetable mixture onto tortillas and top each with Cheddar cheese, lettuce, sour cream, tomatoes, and remaining 1/4 cup cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

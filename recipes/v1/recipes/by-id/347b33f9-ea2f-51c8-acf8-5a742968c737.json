  "id": "347b33f9-ea2f-51c8-acf8-5a742968c737",
  "slug": "spinach-enchiladas",
  "name": "Spinach Enchiladas",
  "recipe_type": "main",
  "brief_description": "These spinach enchiladas are quick and easy. Made with common pantry ingredients, they're ready in under 45 minutes for your family to enjoy.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Add green onions and garlic; cook and stir until fragrant, 2 to 3 minutes. Stir in spinach and cook for 5 minutes. Remove from the heat and mix in 1 cup Monterey Jack, ricotta cheese, and sour cream."
    },
    {
      "position": 3,
      "text": "Warm one tortilla in a skillet over medium heat until flexible, about 15 seconds. Repeat to warm remaining tortillas. Spoon about 1/4 cup spinach mixture onto the center of each tortilla, roll tortilla around filling, and place into a 9x13-inch baking dish with the seam facing down. Pour enchilada sauce over top and sprinkle with remaining 1 cup Monterey Jack."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until sauce is bubbling and cheese is lightly browned at the edges, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

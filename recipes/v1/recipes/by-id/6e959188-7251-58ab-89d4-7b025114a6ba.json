  "id": "6e959188-7251-58ab-89d4-7b025114a6ba",
  "slug": "lemon-impossible-pie",
  "name": "Lemon Impossible Pie",
  "recipe_type": "dessert",
  "brief_description": "This tangy lemon impossible pie is made with fresh lemon juice, eggs, sugar, milk and coconut for an easy baked dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Lightly grease a 10-inch pie plate. Combine lemon juice, sugar, eggs, coconut, flour, and milk in a large bowl. Stir until well blended and pour mixture into pie dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until center is set but slightly jiggly, about 35 minutes. Let pie cool completely before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,

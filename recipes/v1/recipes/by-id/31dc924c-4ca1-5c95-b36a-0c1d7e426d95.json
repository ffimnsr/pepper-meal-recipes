  "id": "31dc924c-4ca1-5c95-b36a-0c1d7e426d95",
  "slug": "chriss-hawaiian-fluff-salad",
  "name": "Chris's Hawaiian Fluff Salad",
  "recipe_type": "salad",
  "brief_description": "This easy, party-ready Hawaiian fluff salad is full of retro-inspired flavor thanks to pineapple and canned fruits, marshmallows, and whipped topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix whipped topping, sour cream, pudding mix, and food coloring together in a large bowl until combined. Add fruit cocktail, pineapple, marshmallows, mandarin oranges, strawberries, and banana and mix well."
    },
    {
      "position": 2,
      "text": "Chill for 3 to 4 hours before serving."
    }
  ],
  "servings": 12,

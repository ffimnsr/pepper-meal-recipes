  "slug": "copycat-wingstop-cajun-corn-recipe-8681405",
  "name": "Copycat Wingstop Cajun Corn",
  "recipe_type": "side",
  "brief_description": "This copycat Wingstop Cajun corn is seasoned with garlic, cayenne, and herbs, exactly like your favorite restaurant version.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Cut corn into 2-inch thick pieces. Toss corn with olive oil, 1 teaspoon salt and 2 tablespoons melted butter."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions. Add corn to air fryer and cook about 15 minutes, tossing occasionally, until partially golden brown."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine remaining salt and butter with remaining ingredients in a large bowl and mix well."
    },
    {
      "position": 4,
      "text": "Add cooked corn to butter mixture and toss well to coat."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

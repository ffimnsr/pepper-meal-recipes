  "id": "91cb09b4-299c-5224-b89d-d902d480d2aa",
  "slug": "cranberry-pumpkin-cookies",
  "name": "Cranberry Pumpkin Cookies",
  "recipe_type": "dessert",
  "brief_description": "This soft cranberry pumpkin cookie recipe is filled with fresh cranberries, chopped walnuts, cinnamon, and orange zest \u2014 perfect for any dessert table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 baking sheets."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in pumpkin pur\u00e9e, egg, and vanilla extract until well combined."
    },
    {
      "position": 3,
      "text": "Sift flour, baking powder, baking soda, cinnamon, and salt into pumpkin mixture; stir until well blended. Stir in cranberries, walnuts, and orange zest until evenly distributed. Drop teaspoonfuls of dough 2 inches apart onto the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes. Transfer cookies to wire racks to cool."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

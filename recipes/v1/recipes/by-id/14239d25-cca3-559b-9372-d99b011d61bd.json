  "schema_version": 1,
  "id": "14239d25-cca3-559b-9372-d99b011d61bd",
  "slug": "chicken-biscuit-pie",
  "name": "Chicken Biscuit Pie",
  "recipe_type": "main",
  "brief_description": "This easy homemade pot pie combines cooked chicken, peas, carrots, and onion in a creamy chicken sauce. Top with spoonfuls of drop biscuit dough, or use premade refrigerated biscuits.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Butter a 2-quart casserole dish."
    },
    {
      "position": 2,
      "text": "In a large saucepan, saut\u00e9 chopped onion in butter. Stir in flour and cook for 1 minute. Add chicken broth and milk. Heat to boiling, stirring constantly. Reduce heat to medium and cook and stir for 2 minutes more. Season with salt and pepper. Add frozen peas and carrots and cooked chicken. Pour mixture into the prepared casserole dish."
    },
    {
      "position": 3,
      "text": "In a medium bowl, mix together 2 cups flour, baking powder, and 3/4 teaspoon salt. Cut in shortening until mixture is crumbly. Stir in milk just until dough is moistened, then drop by spoonfuls onto chicken mixture."
    },
    {
      "position": 4,
      "text": "Bake at 450 degrees F (230 degrees C) for 12 to 15 minutes, or until biscuits are golden brown, and cooked on bottom. This tends to bubble over so I place a piece of aluminum foil under the pan to catch drips."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

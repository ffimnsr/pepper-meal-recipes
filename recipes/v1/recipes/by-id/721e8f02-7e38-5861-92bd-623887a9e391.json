  "id": "721e8f02-7e38-5861-92bd-623887a9e391",
  "slug": "elisas-famous-fudge",
  "name": "Elisa's Famous Fudge",
  "recipe_type": "dessert",
  "brief_description": "No candy thermometer required for this fudge with butterscotch chips, chocolate chips, marshmallow creme and nuts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8-inch square dish with foil."
    },
    {
      "position": 2,
      "text": "In a heavy saucepan over medium heat, combine sugar, evaporated milk, butter and salt. Bring to a boil and let roll 5 minutes. Remove from heat and stir in marshmallow creme, chocolate chips, butterscotch chips, pecans and vanilla. Continue stirring until marshmallow creme is melted and all ingredients are thoroughly combined. Pour into prepared dish."
    },
    {
      "position": 3,
      "text": "Refrigerate for 2 hours, until firm. Lift from dish, remove foil, and cut into pieces."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

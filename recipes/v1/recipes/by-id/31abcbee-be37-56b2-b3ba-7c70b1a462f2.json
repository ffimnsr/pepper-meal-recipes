  "schema_version": 1,
  "id": "31abcbee-be37-56b2-b3ba-7c70b1a462f2",
  "slug": "spaghetti-squash-chicken-parm",
  "name": "Spaghetti Squash Chicken Parm",
  "recipe_type": "main",
  "brief_description": "This spaghetti squash chicken Parm recipe is a lightened up version of the classic, using spaghetti squash noodles in place of pasta, and omitting the usual heavy Parmesan topping.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Spray spaghetti squash flesh with cooking spray, then place cut-sides down on the prepared baking sheet. Cover with foil."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until tender when pierced with a fork, 40 to 45 minutes."
    },
    {
      "position": 4,
      "text": "After the squash has been cooking for about 20 minutes, place egg whites in a shallow bowl. Combine almond flour, Parmesan cheese, salt, and pepper in a second bowl."
    },
    {
      "position": 5,
      "text": "Dip each chicken breast in egg whites, then move to flour mixture and coat completely."
    },
    {
      "position": 6,
      "text": "Heat olive oil in a large saute pan over medium heat. Add chicken breasts and cook until they begin to brown slightly, about 7 minutes. Flip and cook until golden brown on the other sides, 7 to 8 more minutes."
    },
    {
      "position": 7,
      "text": "As the chicken is cooking, combine tomatoes, garlic, parsley, and Italian seasoning in a large saucepan over medium-low heat; cook until hot, 7 to 10 minutes."
    },
    {
      "position": 8,
      "text": "Remove squash from the oven and use a fork to shred the flesh directly into the sauce. Mix until well coated and heated through, about 5 minutes."
    },
    {
      "position": 9,
      "text": "Spoon squash-sauce mixture onto 5 plates and top each with a chicken breast."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9ea2cc30-df5e-5a7e-81b7-63a5869f3edf",
  "slug": "southwestern-egg-rolls-with-avocado-cilantro-sauce",
  "name": "Southwestern Egg Rolls with Avocado Cilantro Sauce",
  "recipe_type": "appetizer",
  "brief_description": "Mix a blend of Southwestern-style ingredients to make a non-traditional egg roll that excites the palate from Chungah Rhee of Damn Delicious. The cilantro sauce takes the flavors to the next level.",
  "cuisine": "American Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F. Line a large baking pan with Reynolds Wrap\u00ae Heavy Duty Aluminum Foil. Grease or spray foil to prevent sticking."
    },
    {
      "position": 2,
      "text": "Combine cilantro, sour cream, jalapeno, mayonnaise, garlic and lime juice in the bowl of a food processor; season with salt and pepper to taste. Set aside."
    },
    {
      "position": 3,
      "text": "Mash avocados using a potato masher. Add black beans, corn, tomato, lime juice, chili powder, cumin and salt and pepper and gently toss to combine."
    },
    {
      "position": 4,
      "text": "Place avocado mixture in the center of each wrapper. Bring the bottom edge of the wrapper tightly over the filling, folding in the sides. Continue rolling until the top of the wrapper is reached. Using your finger, rub the edges of the wrapper with water, pressing to seal. Repeat with remaining wrappers and avocado mixture."
    },
    {
      "position": 5,
      "text": "Place egg rolls on the prepared baking dish. Lightly coat with nonstick spray."
    },
    {
      "position": 6,
      "text": "Place into oven and bake until golden brown and crisp, about 18 to 20 minutes."
    },
    {
      "position": 7,
      "text": "Serve immediately with cilantro dipping sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

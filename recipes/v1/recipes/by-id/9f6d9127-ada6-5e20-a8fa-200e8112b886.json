  "id": "9f6d9127-ada6-5e20-a8fa-200e8112b886",
  "slug": "individual-bourbon-pecan-french-toast-bakes-recipe-8690600",
  "name": "Individual Bourbon-Pecan French Toast Bakes",
  "recipe_type": "breakfast",
  "brief_description": "In these individual Bourbon-pecan French toast bakes, Bourbon, vanilla, cinnamon, maple syrup and a toasted pecan butter topping unite to create a decadent breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease 4 (8 to 10 ounce) ramekins. Whisk together milk, eggs, maple syrup, bourbon, vanilla, cinnamon, and salt in a large bowl. Add bread. Toss to combine. Divide among prepared ramekins. Chill, covered, at least 2 hours or up to overnight."
    },
    {
      "position": 2,
      "text": "Meanwhile, make Toasted Pecan Butter: Preheat the oven to 325 degrees F (165 degrees C). Spread pecans on a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Toast in the preheated oven, stirring once or twice, until lightly browned and fragrant, 12 to 15 minutes. Watch closely so they don\u2019t burn. Let cool to room temperature."
    },
    {
      "position": 4,
      "text": "Pulse butter, brown sugar, and vanilla in a food processor until combined. Add cooled pecans. Pulse until mixture reaches desired consistency. Chill Toasted Pecan Butter in an airtight container up to 1 month."
    },
    {
      "position": 5,
      "text": "To assemble: Preheat the oven to 350 degrees F (175 degrees C). For streusel, stir together flour and brown sugar in a medium bowl. Cut in butter with a pastry blender or 2 knives until mixture resembles coarse crumbs; stir in pecans. Sprinkle streusel over bread mixture in ramekins."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until puffed and a knife inserted into centers comes out clean, about 30 minutes. Serve warm with Toasted Pecan Butter and garnish with powdered sugar."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

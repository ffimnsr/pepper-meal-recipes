  "id": "59203ba4-4da2-51ef-b1c4-fb0e20bf60cb",
  "slug": "macaroni-tuna-salad",
  "name": "Macaroni Tuna Salad",
  "recipe_type": "salad",
  "brief_description": "This chilled macaroni salad recipe with tuna, mayonnaise, olives, and grape tomatoes makes an excellent side dish or a light and easy meal on its own.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain well in a colander set in the sink; transfer to a bowl, then cool in the refrigerator."
    },
    {
      "position": 2,
      "text": "Toss 1 cup mayonnaise, tuna, celery, and onion together in a large bowl until combined; stir in macaroni, remaining 1 cup mayonnaise, grape tomatoes, and olives. Season with salt and black pepper. Chill in the refrigerator for 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "2321f171-9fda-5f3e-a107-ef859638912c",
  "slug": "white-chocolate-blondies",
  "name": "White Chocolate Blondies",
  "recipe_type": "dessert",
  "brief_description": "These white chocolate blondies are studded with semi-sweet chocolate chips for chewy, buttery treats great for kids' birthday parties and potlucks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan."
    },
    {
      "position": 2,
      "text": "Melt together white chocolate and butter in the top of a double boiler over barely simmering water; stir occasionally until smooth. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Combine flour and salt in a medium bowl; set aside."
    },
    {
      "position": 4,
      "text": "Beat eggs in a large bowl with an electric mixer until foamy. Gradually add sugar and vanilla with the mixer still running. Drizzle in white chocolate mixture; mix well. Stir in flour mixture with a rubber spatula or wooden spoon. Fold in chocolate chips. Spread batter evenly into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the middle comes out clean, about 25 minutes. Cool in the pan on a wire rack before cutting into bars."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

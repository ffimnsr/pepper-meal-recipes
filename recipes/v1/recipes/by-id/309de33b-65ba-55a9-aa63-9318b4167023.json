  "id": "309de33b-65ba-55a9-aa63-9318b4167023",
  "slug": "copycat-chipotle-cilantro-lime-sauce-recipe-11972095",
  "name": "Copycat Chipotle Cilantro Lime Sauce",
  "recipe_type": "appetizer",
  "brief_description": "This copycat Chipotle recipe for cilantro lime sauce is perfect for tacos, bowls, and grilled meats. Bright lime, fresh cilantro, and mellow saut\u00e9ed jalape\u00f1o come together for a smooth, zesty sauce with just the right kick\u2014all blended in minutes.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium heat and saute diced jalapeno until softened, 2 to 3 minutes. Allow to cool slightly."
    },
    {
      "position": 2,
      "text": "Combine saut\u00e9ed jalape\u00f1o, crema, cilantro, lime juice, and salt in a blender. Blend until smooth. Taste and adjust flavor to taste - more lime for brightness, more jalape\u00f1o if you want heat."
    },
    {
      "position": 3,
      "text": "Chill for 15 to 20 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "9c22f442-5b5d-5499-a6aa-30a04e17159c",
  "slug": "spicy-breakfast-quesadillas",
  "name": "Spicy Breakfast Quesadillas",
  "recipe_type": "breakfast",
  "brief_description": "These breakfast quesadillas made with spicy pork sausage and nacho cheese are sure to start your day with a bang!",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a skillet with cooking spray and heat over medium-low heat. Add sausages and cook, turning often, until cooked through and browned, 12 to 16 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C). Remove sausages from the skillet and chop when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Beat eggs in a small bowl with milk."
    },
    {
      "position": 3,
      "text": "Spray a small skillet with cooking spray and set over low heat. Add the beaten eggs, green onions, salt, and pepper; cook until edges are set, then gently turn with a spatula until scrambled, 3 to 5 minutes. Remove eggs to a plate and wipe out the skillet with a paper towel."
    },
    {
      "position": 4,
      "text": "Place 1 tortilla in the skillet over low heat. Top with 1/2 of the nacho cheese sauce, 1/2 of the chopped sausage, and 1/2 of the scrambled eggs. Top with another tortilla and cook, carefully turning once, just until lightly browned on both sides, about 5 minutes. Remove to a plate and repeat to cook remaining quesadilla."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

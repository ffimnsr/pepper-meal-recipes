  "id": "921b6a44-b202-500e-acf1-cfad456bb0bc",
  "slug": "oeufs-cocotte-baked-eggs",
  "name": "Oeufs Cocotte (Baked Eggs)",
  "recipe_type": "breakfast",
  "brief_description": "Oeufs cocotte, also called eggs en cocotte, are delicious French soft baked eggs gently cooked in cream with ham, Gruy\u00e8re cheese, and chives.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a small, lidded casserole dish with olive oil. Boil water in a kettle and set aside."
    },
    {
      "position": 2,
      "text": "Arrange ham in the bottom of the prepared casserole dish. Sprinkle with 1 tablespoon Gruy\u00e8re cheese. Pour in cream and season with black pepper. Crack eggs on top, one at a time, making sure yolks remain intact. Sprinkle with remaining 1 tablespoon Gruy\u00e8re cheese and chives. Season with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Cover the casserole dish and place it into a roasting pan. Pour enough boiled water into the roasting pan so it reaches about halfway up the sides of the casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 9 minutes. Uncover and continue baking until whites are just set and yolks are still runny, 3 to 6 more minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

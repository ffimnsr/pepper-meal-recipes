  "id": "9611ca34-54eb-5434-b07a-54b9bfb08732",
  "slug": "honey-sweetened-fruit-pie",
  "name": "Honey-Sweetened Fruit Pie",
  "recipe_type": "dessert",
  "brief_description": "Given sweetness from honey, this golden-baked pie is stuffed with fresh fruit like apples and gooseberries.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a 9-inch pie pan with 1 pie crust."
    },
    {
      "position": 2,
      "text": "Stir apple, gooseberries, honey, rhubarb, cranberry sauce, flour, and almond extract together in a bowl. Add to the empty pie shell. Dot with butter and cover with remaining pie crust. Cut slits in the top, brush with milk, and sprinkle with sugar."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbling and brown, 40 to 45 minutes. Cover the pie with foil during the last 10 minutes of baking time if it becomes too brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

  "id": "5eed7fb7-db5f-5355-81b2-1b3a0d919284",
  "slug": "tortellini-soup-i",
  "name": "Hearty Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "Italian sausage and tortellini are paired in this beef broth based soup with carrots, celery and zucchini. Serve with grated Parmesan cheese.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Remove casings from sausage. Brown sausage and cook until crumbly. Remove meat from pot. Reserve 1 tablespoon drippings."
    },
    {
      "position": 2,
      "text": "Cook onion and garlic in the drippings until tender. Add broth, water, wine, carrots, tomatoes, basil, oregano, tomato sauce, and the cooked sausage. Bring to a boil; reduce heat and simmer uncovered 30 minutes."
    },
    {
      "position": 3,
      "text": "Add zucchini, green peppers, parsley, and tortellini. Simmer another 25 minutes, covered, for fresh tortellini, or 45 minutes, covered, for frozen tortellini. Serve with fresh parmesan cheese sprinkled over the top."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

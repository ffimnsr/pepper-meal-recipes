  "id": "a625148c-5e65-5def-9171-8b051cd2d223",
  "slug": "joeys-peanut-butter-cookies",
  "name": "Joey's Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "The best peanut butter cookies are made with this easy recipe that uses a double dose of peanut butter for fluffy cookies that melt in your mouth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat peanut butter, butter, white sugar, and brown sugar together in a large bowl with an electric mixer until well blended. Beat in egg until well combined. Mix in milk and vanilla. Combine flour, baking powder, and salt in a separate bowl; stir into peanut butter mixture until incorporated."
    },
    {
      "position": 3,
      "text": "Roll tablespoonfuls of dough into balls. Place cookies 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Press each ball once with fork tines."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are lightly browned, 8 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "92354373-dd44-529d-aee1-a4768a8518e3",
  "slug": "pineapple-zucchini-muffins",
  "name": "Pineapple Zucchini Muffins",
  "recipe_type": "dessert",
  "brief_description": "This big-batch pineapple zucchini muffin recipe, made with crushed pineapple and shredded zucchini, is a great sweet snack and perfect for freezing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour four 12-cup muffin tins or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, baking soda, cinnamon, and salt together in a large bowl; make a well in the center. Pour oil and eggs into the well: stir in zucchini, pineapple, and vanilla extract until batter is smooth."
    },
    {
      "position": 3,
      "text": "Divide batter among the prepared muffin cups, filling each \u2154 to \u00be full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 20 to 25 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "967c76ab-8c8c-57dd-8f82-f0511574fc47",
  "slug": "easy-broccoli-bacon-salad",
  "name": "Easy Broccoli Bacon Salad",
  "recipe_type": "salad",
  "brief_description": "This broccoli bacon salad with red onion, raisins, and sunflowers seeds is quick and easy. It'll convert any broccoli haters into broccoli lovers after one bite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine bacon, broccoli, raisins, onion, and sunflower seeds in a large bowl."
    },
    {
      "position": 3,
      "text": "To make the dressing: Whisk mayonnaise, sugar, and red wine vinegar together in a small bowl until dressing is smooth."
    },
    {
      "position": 4,
      "text": "Pour over broccoli mixture and stir to coat."
    }
  ],
  "servings": 8,

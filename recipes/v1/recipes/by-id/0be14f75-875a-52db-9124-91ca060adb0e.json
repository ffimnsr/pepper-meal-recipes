  "id": "0be14f75-875a-52db-9124-91ca060adb0e",
  "slug": "chicken-or-turkey-tetrazzini-deluxe",
  "name": "Chicken or Turkey Tetrazzini Deluxe",
  "recipe_type": "soup",
  "brief_description": "Cooked chicken or turkey breast, pasta, veggies, sherry and broth with creamy and cheesy elements, all baked into a classic. This casserole is a great way to use leftover turkey or chicken. Delicious and freezes well too.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain and set aside."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a large saucepan over medium heat. Add mushrooms, onion and bell pepper and saute until tender. Stir in cream of mushroom soup and chicken broth; cook, stirring, until heated through. Stir in pasta, Cheddar cheese, peas, sherry, Worcestershire sauce, salt, pepper and chicken. Mix well and transfer mixture to a lightly greased 11x14 inch baking dish. Sprinkle with Parmesan cheese and paprika."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 to 35 minutes, or until heated through."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

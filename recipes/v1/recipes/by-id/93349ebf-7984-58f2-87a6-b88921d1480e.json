  "id": "93349ebf-7984-58f2-87a6-b88921d1480e",
  "slug": "cheesecake-brownies",
  "name": "Cheesecake Brownies",
  "recipe_type": "dessert",
  "brief_description": "These easy cheesecake brownies take boxed brownie mix and add a simple cream cheese topping for a treat that tastes fancy but comes together quickly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Prepare brownie mix: Stir brownie mix, water, oil, and eggs in a medium bowl until well blended. Spread evenly into the prepared pan."
    },
    {
      "position": 3,
      "text": "Prepare cheesecake topping: Beat together cream cheese, egg, and sugar using an electric mixer until smooth. Dollop the cream cheese mixture on top of the brownie batter. Swirl together using a knife or skewer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 22 to 25 minutes. Brownies will be done when a toothpick inserted comes out clean. Cool in the pan, then cut into 24 squares and serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cbf9d9f8-99e7-5056-a57d-eea5c7fcbbe1",
  "slug": "black-bean-hummus",
  "name": "Black Bean Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This creamy black bean hummus is made in minutes with canned black beans, lemon, tahini, and spices; garnish with olives and serve with toasted pita.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Drain beans and reserve liquid."
    },
    {
      "position": 2,
      "text": "Place garlic into the bowl of a food processor and pulse until minced. Add black beans, 2 tablespoons bean liquid, lemon juice, tahini, cumin, salt, and cayenne pepper; process until smooth, scraping down the sides as needed."
    },
    {
      "position": 3,
      "text": "Taste and add additional bean liquid, lemon juice, tahini, cumin, salt, and cayenne pepper as needed. Transfer to a serving bowl and sprinkle with paprika. Arrange Greek olives over top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

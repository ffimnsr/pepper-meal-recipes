{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9c14fac4-5719-5390-af1f-123ef49b1ebb",
  "slug": "daddy-eddies-roast-pork-pernil-puerto-rican-style",
  "name": "Daddy Eddie's Roast Pork (Pernil), Puerto Rican-Style",
  "recipe_type": "main",
  "brief_description": "This pernil recipe makes the most tender marinated pork shoulder seasoned with garlic, olive oil, and vinegar for a traditional Puerto Rican dish.",
  "cuisine": "Puerto Rican Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine garlic cloves, olive oil, vinegar, oregano, salt, and black pepper in a mortar and pestle; mash into a paste."
    },
    {
      "position": 3,
      "text": "Cut deep slits into pork with a small knife. Stuff slits with garlic paste; rub any remaining paste over pork."
    },
    {
      "position": 4,
      "text": "Place pork in a plastic roasting bag and put in a roasting pan with a rack. Let marinate in the refrigerator, 8 to 48 hours."
    },
    {
      "position": 5,
      "text": "Take pork out of the refrigerator, uncover, and bring to room temperature, 1 to 2 hours."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 7,
      "text": "Roast pork skin-side down in the preheated oven until golden-brown, about 2 hours."
    },
    {
      "position": 8,
      "text": "Flip pork and continue roasting, skin-side up, until juices run clear and an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), 2 to 4 hours more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

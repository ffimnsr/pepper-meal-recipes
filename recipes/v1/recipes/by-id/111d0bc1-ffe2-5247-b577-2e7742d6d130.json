  "schema_version": 1,
  "id": "111d0bc1-ffe2-5247-b577-2e7742d6d130",
  "slug": "one-pot-shrimp-scampi-orzo",
  "name": "Shrimp Scampi with Orzo",
  "recipe_type": "main",
  "brief_description": "This shrimp scampi with orzo, garlic, white wine, and lots of lemon is easy to make in one pot for a delicious meal full of Mediterranean flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine olive oil, lemon zest, lemon juice, red pepper flakes, and dried parsley in a small bowl. Add shrimp and toss to coat. Marinate for 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Melt butter in a pot over medium-high heat. Add olive oil. Stir in orzo and onion, toss to coat, and cook, stirring frequently, until onions are translucent and orzo is lightly toasted, 4 to 5 minutes. Mix in garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Deglaze pot with white wine and stir until wine has cooked off. Pour in chicken broth and season with salt and pepper. Cook, stirring frequently, until orzo is tender yet firm to the bite, 8 to 10 minutes. Add peas and shrimp with marinade to the pot, cover, and cook, stirring occasionally, until shrimp are light pink, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Divide between 2 dishes, sprinkle with fresh parsley, and garnish with lemon slices."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

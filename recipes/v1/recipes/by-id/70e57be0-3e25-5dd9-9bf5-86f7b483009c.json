  "id": "70e57be0-3e25-5dd9-9bf5-86f7b483009c",
  "slug": "simple-deviled-eggs",
  "name": "Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These deviled eggs are easy to make with hard-boiled eggs, mayonnaise, and mustard. Double the recipe for holiday parties, picnics, or any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Peel hard-boiled eggs."
    },
    {
      "position": 2,
      "text": "Slice eggs in half lengthwise and remove yolks; set whites aside."
    },
    {
      "position": 3,
      "text": "Mash yolks with a fork in a small bowl. Stir in mayonnaise, sugar, vinegar, mustard, onion, and celery; mix well and season with salt to taste."
    },
    {
      "position": 4,
      "text": "Stuff or pipe egg yolk mixture into egg whites."
    },
    {
      "position": 5,
      "text": "Sprinkle with paprika. Refrigerate eggs until serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

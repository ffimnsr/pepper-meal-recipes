  "id": "5992c805-4532-5b64-9ac1-7aac02f052c2",
  "slug": "german-new-year-pretzel",
  "name": "German New Year Pretzel",
  "recipe_type": "appetizer",
  "brief_description": "A sweet, soft pretzel is eaten on the New Year in Germany for good luck. Serve with butter!",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast in 1/2 cup milk in a bowl; add 4 1/2 tablespoons sugar. Let stand until the yeast softens and begins to form a creamy foam, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir yeast mixture and 2 1/4 cups flour together in a bowl until dough is dry and clumpy. Allow dough to rise for 15 minutes. Add remaining 1/2 cup milk, butter, egg, lemon zest, and salt to dough until evenly mixed."
    },
    {
      "position": 3,
      "text": "Knead dough, adding more flour as needed, until dough is elastic. Cover bowl with a clean damp towel or plastic wrap and allow dough to rise in a warm area until doubled in size, about 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat oven to 390 degrees F (199 degrees C). Grease a baking sheet."
    },
    {
      "position": 5,
      "text": "Gently knead dough; roll into a long rope on the prepared baking sheet and twist into a pretzel shape. Cover dough with a clean towel or plastic wrap and allow to rise for 15 minutes more."
    },
    {
      "position": 6,
      "text": "Brush egg yolk over dough and sprinkle 1 teaspoon sugar over egg yolk."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 25 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

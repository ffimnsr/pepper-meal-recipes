  "id": "94dac0fe-aa59-5e34-9055-05ce56cb57b1",
  "slug": "hot-and-spicy-himalayan-tea-chai-tea",
  "name": "Hot and Spicy Himalayan Tea (Chai Tea)",
  "recipe_type": "drink",
  "brief_description": "Skip the specialty coffee shop and make a steaming hot cup of chai tea at home with warming spices, ginger, milk, brown sugar, and tea leaves.",
  "cuisine": "Indian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, brown sugar, ginger, cinnamon stick, cardamom pods, cloves, bay leaves, fennel seeds, and peppercorns together in a pot; cover and boil for 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove from the heat, add tea leaves, and allow to steep for 10 minutes. Stir milk into tea mixture and bring to a boil. Strain tea into tea cups."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "95d579c1-4811-5e71-b49f-487bcf559a87",
  "slug": "skillet-lamb-meatballs-with-orzo-pilaf-recipe-11775431",
  "name": "Skillet Lamb Meatballs with Orzo Pilaf",
  "recipe_type": "main",
  "brief_description": "Za\u2019atar-spiced lamb meatballs, tender orzo, feta, and pomegranate arils combine for a speedy dinner. You can use beef in place of the lamb.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together bread crumbs, egg, garlic, za\u2019atar, salt, and pepper in a medium bowl. With clean hands, gently mix in lamb. Shape mixture into 16 (1 1/2-inch) meatballs."
    },
    {
      "position": 2,
      "text": "Heat oil in a very large skillet over medium-high heat. Add meatballs and cook, turning occasionally, until browned on all sides, 6 to 8 minutes. Transfer to a plate; cover to keep warm. Pour off grease, leaving 1 tablespoon drippings in skillet."
    },
    {
      "position": 3,
      "text": "Add onion to skillet. Cook, stirring occasionally, until just softened, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour broth into skillet; use a wooden spoon or spatula to scrape up any browned bits from bottom of pan. Bring to a boil over high heat. Stir in orzo and rosemary. Return meatballs to skillet. Reduce heat to medium-low and simmer, covered, 9 to 10 minutes or until pasta is al dente and an instant-read thermometer inserted into centers of meatballs registers 165 degrees F (74 degrees C). If there is excess liquid, let stand 5 minutes before serving."
    },
    {
      "position": 5,
      "text": "Top with feta and pomegranate arils. Garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

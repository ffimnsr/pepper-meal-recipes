  "id": "c2396b08-eabd-5f5a-939f-40de18590139",
  "slug": "bow-tie-pasta-salad",
  "name": "Bow Tie Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This bow tie pasta salad with farfalle pasta, broccoli, celery, and bell pepper is tossed with a deliciously creamy Parmesan and basil salad dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a rolling boil. Cook bow tie pasta at a boil until tender yet firm to the bite, about 12 minutes; drain. Quickly rinse the cooked pasta in cold water to stop it from continuing to cook; drain."
    },
    {
      "position": 3,
      "text": "Mix cooled pasta, broccoli, tomatoes, sliced green onions, celery, red bell pepper, and green bell pepper in a large bowl."
    },
    {
      "position": 4,
      "text": "Gently stir salad dressing and Parmesan cheese together in a bowl until evenly mixed; season to taste with sugar, basil, and salt."
    },
    {
      "position": 5,
      "text": "Pour salad dressing mixture over pasta mixture; gently toss to coat evenly."
    },
    {
      "position": 6,
      "text": "For best results, chill salad in refrigerator before serving to allow flavors to blend."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

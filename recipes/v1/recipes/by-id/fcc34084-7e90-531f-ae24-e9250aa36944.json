  "id": "fcc34084-7e90-531f-ae24-e9250aa36944",
  "slug": "refried-bean-and-cheese-enchiladas",
  "name": "Refried Bean and Cheese Enchiladas",
  "recipe_type": "main",
  "brief_description": "These vegetarian bean enchiladas are a quick and easy Mexican-inspired meal to make on busy weeknights. Add cooked chicken and cilantro if you like.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch casserole dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Mix refried beans, 1 1/2 cups cheese, and onion in a microwave-safe bowl. Microwave on high until cheese is melted, about 1 minute."
    },
    {
      "position": 4,
      "text": "Stack three tortillas on a microwave-safe plate; microwave on high until warm, about 30 seconds. Repeat to warm remaining tortillas."
    },
    {
      "position": 5,
      "text": "Pour enough enchilada sauce onto a small plate to cover. Quickly dip both sides of one tortilla in sauce."
    },
    {
      "position": 6,
      "text": "Spoon bean filling down the middle, then wrap tortilla around filling."
    },
    {
      "position": 7,
      "text": "Place into the prepared baking dish. Repeat to dip, fill, and roll remining tortillas."
    },
    {
      "position": 8,
      "text": "Pour remaining enchilada sauce over filled tortillas and sprinkle with remaining cheese. Cover the dish with aluminum foil."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until sauce is bubbling and cheese is melted, 35 and 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

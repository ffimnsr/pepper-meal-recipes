  "id": "c2941afe-a23f-54d5-9364-ff8dad0af7c5",
  "slug": "hot-water-pie-crust-i",
  "name": "Hot Water Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "Forget everything you \u2018ve heard about chilling your pie crust ingredients. This recipe uses boiling water and the pastry turns out flaky, manageable, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine shortening, salt, milk, and boiling water in a large bowl. Whisk with a fork until smooth and creamy."
    },
    {
      "position": 2,
      "text": "Stir in flour until a soft dough forms and no dry streaks remain."
    },
    {
      "position": 3,
      "text": "Divide dough in half and shape each portion into a disk. Use immediately to prepare one 9-inch double-crust pie or two 9-inch single-crust pies."
    }
  ],

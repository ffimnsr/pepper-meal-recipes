  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix cumin, coriander, cardamom, pepper, cinnamon, cloves, and nutmeg in a bowl."
    },
    {
      "position": 3,
      "text": "Place mix in an airtight container, and store in a cool, dry place."
    }

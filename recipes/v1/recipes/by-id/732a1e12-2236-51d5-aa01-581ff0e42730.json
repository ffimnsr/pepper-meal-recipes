  "id": "732a1e12-2236-51d5-aa01-581ff0e42730",
  "slug": "cranberry-orange-biscotti",
  "name": "Cranberry-Orange Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Make your own crisp biscotti cookies flavored with cranberries and orange and you'll feel like you're in your favorite fancy coffee place. They make great gifts, too.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a bowl until mixture is creamy. Beat in eggs, orange zest, orange extract, and almond extract."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, baking soda, and salt in a separate bowl; mix dry ingredients into moist ingredients to make a stiff dough. Mix sweetened cranberries into dough. Form dough into a ball, cut into halves, and shape each half into a log. Place logs onto prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the edges are lightly browned, 20 to 25 minutes. Let logs cool completely on wire racks."
    },
    {
      "position": 5,
      "text": "Cut logs into slices on a slight diagonal and lay the slices on the parchment-lined baking sheet. Bake biscotti until crisp and lightly golden brown, about 7 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

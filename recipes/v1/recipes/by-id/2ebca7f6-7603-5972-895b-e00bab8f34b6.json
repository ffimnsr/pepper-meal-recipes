  "id": "2ebca7f6-7603-5972-895b-e00bab8f34b6",
  "slug": "hearty-vegan-slow-cooker-chili",
  "name": "Slow Cooker Vegan Chili",
  "recipe_type": "soup",
  "brief_description": "This vegan chili is packed with rich and colorful vegetables, spices, and three kinds of beans for a hearty and crowd-pleasing slow cooker meal.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add onions, bell peppers, and garlic; cook and stir until onions start to brown, 8 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer mixture into a slow cooker. Stir in tomatoes, black beans, garbanzo beans, kidney beans, tomato paste, spinach, corn, zucchini, yellow squash, chili powder, cumin, oregano, parsley, salt, and pepper until thoroughly mixed."
    },
    {
      "position": 3,
      "text": "Pour the tomato sauce and vegetable broth over the ingredients. Cook on Low for 4 to 5 hours. Check seasoning. If chili is too thick, add more tomato sauce and vegetable broth to desired thickness. Cook on Low for an additional 1 to 2 hours."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 310,
  "preparation_time_minutes": 30,

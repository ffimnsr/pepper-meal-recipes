  "id": "b43879d2-362c-512e-8da3-2656475b4a5c",
  "slug": "baked-denver-omelet",
  "name": "Baked Denver Omelet",
  "recipe_type": "breakfast",
  "brief_description": "This baked Denver omelet recipe is really a frittata with ham, bell pepper, onion, and Cheddar cheese\u2014all the classic ingredients of the original.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 10-inch round baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add onion and bell pepper; cook and stir until softened, about 5 minutes. Stir in ham; continue cooking until heated through, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat eggs and milk together in a large bowl; stir in Cheddar cheese and ham mixture. Season with salt and black pepper. Pour into the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until eggs are browned and puffy, about 25 minutes. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

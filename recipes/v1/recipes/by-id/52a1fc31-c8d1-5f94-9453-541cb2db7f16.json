  "id": "52a1fc31-c8d1-5f94-9453-541cb2db7f16",
  "slug": "sausage-hashbrown-breakfast-casserole",
  "name": "Sausage Hashbrown Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This easy breakfast casserole recipe features a combination of all your breakfast favorites in every bite: sausage, hash browns, eggs, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Cook and stir sausage in a hot skillet over medium heat until crumbly and no longer pink, 5 to 7 minutes. Drain and discard grease, and transfer sausage to a bowl."
    },
    {
      "position": 3,
      "text": "Cook hash browns in the skillet in the residual grease over medium heat, stirring occasionally, until lightly browned, about 8 minutes. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Transfer hash browns to the prepared baking dish and spread in an even layer across the bottom. Sprinkle cooked sausage over top, then layer with Cheddar cheese and chile peppers."
    },
    {
      "position": 5,
      "text": "Whisk milk, eggs, salt, pepper, onion powder, and garlic powder together in a bowl. Pour over hash brown mixture."
    },
    {
      "position": 6,
      "text": "Bake casserole, uncovered, in the preheated oven until bubbly and the top is golden brown, 35 to 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

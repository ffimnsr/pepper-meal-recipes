  "slug": "cowboy-butter-ranch-recipe-11795650",
  "name": "Cowboy Butter Ranch",
  "recipe_type": "salad",
  "brief_description": "This cowboy butter ranch is a creamy dressing that combines the flavors of cowboy butter and ranch, and is great on just about anything: grilled meat, fried chicken, pizza, fries, or even a salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add butter, mayonnaise, Greek yogurt, buttermilk, Dijon mustard, garlic, lemon zest, lemon juice, dill, chives, and smoked paprika to a large Mason jar with a lid. Shake vigorously; season to taste with salt and pepper."
    },
    {
      "position": 2,
      "text": "Serve immediately or keep refrigerated until ready to serve. Enjoy with grilled meats, fried chicken, pizza, fries, or salads."
    }
  ],
  "servings": 12,

  "id": "692cbcb6-54be-5f2b-bc6f-ac5c6fdd3656",
  "slug": "easy-caramel-apple-pie-bars",
  "name": "Easy Caramel Apple Pie Bars",
  "recipe_type": "dessert",
  "brief_description": "These apple pie bars have a delicious caramel-apple filling and an easy-to-make crumbly topping for a crowd-pleasing choice, especially when covered with caramel!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, 1 cup butter, 3/4 cup white sugar, egg, baking powder, and 1/2 teaspoon salt in a food processor; pulse until crumbled and easily formed into dough when pinched. Pour 3/4 of the dough into the prepared pan; press down with your hands until crust is even and well-packed."
    },
    {
      "position": 3,
      "text": "Melt 3 tablespoons butter in a skillet over medium heat. Add apples, brown sugar, 1/2 cup white sugar, cinnamon, nutmeg, and salt; cook and stir until apples are softened, about 5 minutes. Stir in cornstarch; mix, adding more cornstarch if needed, until liquid has thickened."
    },
    {
      "position": 4,
      "text": "Pour caramel-apple mixture onto crust; smooth with a spatula until even. Crumble remaining dough on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is golden brown, 30 to 40 minutes. Let cool for 10 minutes; cut into bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6d956b34-ef2b-5e98-b38c-d97e06dde86a",
  "slug": "ground-turkey-and-zucchini-skillet-recipe-11805473",
  "name": "Ground Turkey and Zucchini Skillet",
  "recipe_type": "main",
  "brief_description": "This ground turkey and zucchini skillet is lean and delicious, a family-friendly one-dish dinner with plenty of vegetables. It cooks so quickly that it is perfect for a weeknight.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add ground turkey, and cook until meat is browned and crumbly, 4 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add zucchini, bell pepper, and onion, and stirring occasionally, cook until the veggies are tender, about 5 to 6 minutes. Stir in garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Stir in black beans, tomatoes, potatoes, basil, and thyme. Season with salt and pepper, reduce heat, and simmer for about 5 minutes. Add a little water if it becomes too thick."
    },
    {
      "position": 4,
      "text": "Garnish with parsley and red pepper flakes, and serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

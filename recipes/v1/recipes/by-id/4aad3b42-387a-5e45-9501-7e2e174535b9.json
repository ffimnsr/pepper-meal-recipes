  "id": "4aad3b42-387a-5e45-9501-7e2e174535b9",
  "slug": "mexican-picadillo-recipe-11681065",
  "name": "Mexican Picadillo",
  "recipe_type": "side",
  "brief_description": "This Mexican picadillo is so versatile. It can be served with a side of beans and rice for a complete meal, or serve it in a burrito, in hard shell tacos, or over nachos.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine ground beef and 1/2 of diced onion in a skillet and cook over medium heat, breaking up beef with a spatula, until onion is translucent and beef is browned and crumbly, 5 to 7 minutes. Season with salt and pepper. Drain excess liquid."
    },
    {
      "position": 3,
      "text": "Meanwhile, place tomatoes, remaining 1/2 onion, garlic, and jalapeno in a pot with enough water to cover ingredients. Bring to a boil; cook until tomatoes have burst and onion and jalapeno have softened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Using a slotted spoon, transfer tomatoes, onion, garlic, and jalapeno to the jar of a blender. Add 1/2 cooking water from tomatoes, chicken granules, oregano, and cumin, and blend until smooth. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Add diced potatoes to ground beef mixture and cook, stirring frequently, for 4 to 5 minutes. Add tomato mixture, season with salt and pepper, and cook until potatoes are fork tender, 3 to 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

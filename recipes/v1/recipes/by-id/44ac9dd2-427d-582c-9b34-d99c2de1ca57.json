  "slug": "pumpkin-pie-for-dieters",
  "name": "Pumpkin Pie for Dieters",
  "recipe_type": "dessert",
  "brief_description": "This easy, no-bake pumpkin pie for dieters recipe features a crustless pumpkin pie custard made with low-fat ingredients for a guilt-free fall dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk pumpkin pur\u00e9e, milk, and pudding mix together in a bowl; stir in pumpkin pie spice. Fold in \u00bd whipped topping."
    },
    {
      "position": 2,
      "text": "Transfer pumpkin mixture to an 8-inch pie plate; cover with remaining \u00bd whipped topping. Refrigerate until set, about 1 hour."
    }
  ],

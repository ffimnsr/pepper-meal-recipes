  "schema_version": 1,
  "id": "a11200c6-0c7e-5e03-a39c-f43a13789d8c",
  "slug": "whole-wheat-pumpkin-applesauce-muffins",
  "name": "Whole Wheat Pumpkin Applesauce Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This whole wheat muffin recipe is made with pumpkin, applesauce, raisins, and pecans and a good way to sneak fruits, veggies, and fiber into your diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, pumpkin pie spice, baking powder, salt, and baking soda together in a medium bowl until well combined. Set aside."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, applesauce, pumpkin, eggs, white sugar, buttermilk, and oil in a large bowl until well blended; stir in flour mixture until combined. Fold in raisins and pecans. Divide batter among the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until muffin tops spring back when lightly pressed or until a toothpick inserted into centers comes out clean, 15 to 20 minutes. Cool in the tin for 5 minutes before transferring muffins to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5c8becac-8e61-517c-9d9e-0bd45b449e36",
  "slug": "air-fryer-french-fries",
  "name": "Air Fryer French Fries",
  "recipe_type": "side",
  "brief_description": "Chef John's air fryer French fries recipe uses a cold and hot water trick that yields crispy fries that rival regular ones using a fraction of the oil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut each potato lengthwise into \u215c-inch-thick slices; cut slices into \u215c-inch-wide sticks. Place potato sticks in a bowl of cold water; soak to release excess starches, about 5 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Pour boiling water over potatoes until covered by a few inches; set aside for 10 minutes. Drain potatoes; transfer to some paper towels. Blot excess water from potatoes; cool completely, at least 10 minutes."
    },
    {
      "position": 4,
      "text": "Place cooled potatoes in a bowl; drizzle with oil. Season with cayenne; toss to coat."
    },
    {
      "position": 5,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 6,
      "text": "Stack potatoes in a double layer in the air fryer basket."
    },
    {
      "position": 7,
      "text": "Air fry for 15 minutes. Slide basket out; toss fries. Continue air frying until golden brown, about 10 minutes more. Transfer fries to a bowl; toss with salt. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

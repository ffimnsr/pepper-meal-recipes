  "id": "09e9eb6d-fb66-57bc-9c9b-f716746acbb6",
  "slug": "worlds-best-potato-soup",
  "name": "World's Best Potato Soup",
  "recipe_type": "soup",
  "brief_description": "The combination of potatoes, onions, celery, bacon, mushroom soup, and cream in this recipe with cheddar cheese makes the best potato soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes, onions, celery, and bouillon cubes in a large pot. Add enough water to cover all ingredients. Bring to a boil and simmer on medium heat for 15 minutes."
    },
    {
      "position": 3,
      "text": "Add half and half, bacon, cream of mushroom soup and stir until combined. Add cheese and stir until completely melted. Simmer on low until potatoes are cooked through and tender."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 10,

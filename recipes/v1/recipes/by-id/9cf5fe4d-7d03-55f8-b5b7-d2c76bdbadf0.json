  "id": "9cf5fe4d-7d03-55f8-b5b7-d2c76bdbadf0",
  "slug": "cheesy-tuna-noodle-casserole",
  "name": "Cheesy Tuna Noodle Casserole",
  "recipe_type": "main",
  "brief_description": "This tuna noodle casserole recipe with cheese is a family favorite. Tuna and noodles are coated with a mild Cheddar cheese sauce, topped with seasoned bread crumbs, and baked until crisp and golden brown.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes."
    },
    {
      "position": 3,
      "text": "While the noodles are cooking, heat oil in a medium saucepan over medium heat. Saut\u00e9 onion and bell peppers in the hot oil until tender, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Pour condensed soup into the saucepan. Add tuna, milk, salt, and pepper; mix until well combined. Reduce heat to medium-low."
    },
    {
      "position": 5,
      "text": "Drain egg noodles well. Fold noodles into the tuna mixture until well coated. Transfer to a 2-quart casserole and sprinkle bread crumbs over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the top is crisp and golden brown, 20 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

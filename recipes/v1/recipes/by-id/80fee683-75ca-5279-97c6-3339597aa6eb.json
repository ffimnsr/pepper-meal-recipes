  "id": "80fee683-75ca-5279-97c6-3339597aa6eb",
  "slug": "pumpkin-chip-muffins",
  "name": "Pumpkin Chip Muffins",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin chip muffin recipe is packed with chocolate chips and pumpkin for sweetness while warm spices like cinnamon provides a fall-forward flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease two 12-cup muffin tins or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Beat eggs together in a bowl: beat in sugar, pumpkin, and oil."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking soda, baking powder, cinnamon, and salt together in a bowl; stir into pumpkin mixture. Fold in chocolate chips."
    },
    {
      "position": 4,
      "text": "Divide batter among the prepared muffin cups, filling each to the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 20 minutes. Cool in the tins for 5 minutes, then transfer muffins to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "936cde83-e6f7-5e7b-ac5c-faac426e2eba",
  "slug": "lauries-shepherds-pie",
  "name": "Laurie's Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This savory beef pie is so easy to make and is one of my husband's favorites. The leftovers are perfect for lunch the next day. For added flavor, you could top the potatoes with a cup of shredded Cheddar cheese, if desired.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place the potatoes into a saucepan and fill with enough water to cover. Bring to a boil, and cook for 15 minutes, or until tender. Drain and mash with margarine and milk until fairly smooth."
    },
    {
      "position": 3,
      "text": "Meanwhile, crumble the ground beef into a large skillet over medium-high heat. Add onion and bell pepper. Cook and stir until beef is browned; drain excess fat."
    },
    {
      "position": 4,
      "text": "Place the beef and onion mixture into the bottom of the pie shell, pour the cream-style corn over it. Spread mashed potatoes to cover the top of the pie."
    },
    {
      "position": 5,
      "text": "Bake for 30 minutes in the preheated oven, or until the pie crust and potatoes are golden brown."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "slug": "slow-cooker-spinach-artichoke-dip",
  "name": "Slow Cooker Spinach-Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Easy to prepare using a slow cooker, this spinach-artichoke dip is creamy, cheesy, and perfect for entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine artichokes, spinach, cream cheese, mozzarella cheese, Parmesan cheese, milk, salt, and pepper in the bottom of a slow cooker."
    },
    {
      "position": 2,
      "text": "Cover and cook on High, stirring occasionally to combine, for 2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 5,

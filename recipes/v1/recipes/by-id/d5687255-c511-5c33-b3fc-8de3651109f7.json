  "id": "d5687255-c511-5c33-b3fc-8de3651109f7",
  "slug": "homemade-dog-food",
  "name": "Homemade Dog Food",
  "recipe_type": null,
  "brief_description": "This homemade dog food can be fed to dogs on its own or mixed in with kibble. Made with turkey, rice, and veggies \u2014 it's sure to make some tails wag!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place ground turkey, water, rice, and rosemary into a large Dutch oven. Stir until ground turkey is broken up and evenly distributed throughout the mixture; bring to a boil over high heat, then reduce heat to low and simmer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Add frozen vegetables, and cook for an additional 5 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat and cool."
    },
    {
      "position": 5,
      "text": "Refrigerate until using."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "67a54e52-d5ab-5926-866f-12fc4622a8fc",
  "slug": "dads-leftover-turkey-pot-pie",
  "name": "Dad's Leftover Turkey Pot Pie",
  "recipe_type": "main",
  "brief_description": "Dad's leftover turkey pot pie recipe, made with leftover turkey and frozen veggies, is baked in pie crusts for the perfect post-holiday comfort food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place peas, carrots, beans, and celery in a medium saucepan. Add enough water to cover; bring to a boil. Reduce the heat to medium-low; simmer until vegetables are tender, about 8 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Melt butter in a large saucepan over medium heat. Add onion and cook until translucent, about 5 minutes. Add flour, salt, pepper, celery seed, onion powder, and Italian seasoning; whisk until a paste forms, about 1 minute. Slowly whisk in broth and milk until well combined. Bring to a simmer and cook, whisking constantly, until sauce thickens, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the heat; fold in reserved vegetables and turkey until well coated."
    },
    {
      "position": 5,
      "text": "Fit one pie pastry into each bottom of two 9-inch pie plates. Divide filling between the dishes; top each with remaining pie pastries; seal edges. Cut several small slits in each pastry top to let steam escape; transfer to baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. If crusts brown too quickly, cover with aluminum foil. Continue baking until golden brown, and filling is bubbly, 15 to 20 minutes more."
    },
    {
      "position": 7,
      "text": "Cool for 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

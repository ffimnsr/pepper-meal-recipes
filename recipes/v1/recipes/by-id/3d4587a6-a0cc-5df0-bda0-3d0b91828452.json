  "id": "3d4587a6-a0cc-5df0-bda0-3d0b91828452",
  "slug": "nicole-s-cajun-chicken-and-sausage-jambalaya-recipe-8780968",
  "name": "Nicole's Cajun Chicken and Sausage Jambalaya",
  "recipe_type": "soup",
  "brief_description": "This chicken and sausage jambalaya, made with authentic Cajun seasonings, andouille sausage, and chicken thighs, is classic comfort food, perfect for Mardi Gras or any time.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons bacon grease in a large pot or Dutch oven over medium-high heat. Add sausage and saut\u00e9 until browned on both sides, about 3 minutes. Remove from the pot with a slotted spoon and set aside. Reserve drippings in the pot."
    },
    {
      "position": 3,
      "text": "Add chicken to the pot and sprinkle with salt and pepper. Cook, undisturbed, until chicken easily releases from the bottom and begins to brown, about 2 minutes. Push chicken to one side of the pot and add pork. Cook, crumbling with a spoon, until browned, about 3 minutes. Stir chicken and pork together and remove from the pan with a slotted spoon, and add to the reserved sausage."
    },
    {
      "position": 4,
      "text": "Add onion, bell peppers, celery, and jalape\u00f1o to the pan and cook 2 minutes, stirring constantly to lift off any flavorful bits from the bottom. Reduce heat to medium and cook, stirring often, until well browned and very tender, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Add garlic to the mixture and continue cooking for 2 minutes. Stir in Cajun seasoning, thyme, and bay leaves."
    },
    {
      "position": 6,
      "text": "Pour in 1 cup stock to deglaze the pan, making sure to scrape up any bits from the bottom of the pan. Stir in remaining 5 cups stock and bring to a boil. Add browned sausage, chicken and pork back into the pan; stir in rice and bring to a boil again. Reduce heat, cover, and simmer until rice is tender and most of the liquid has been absorbed, about 25 minutes. Add up to 1 cup additional stock if necessary if liquid is absorbed before rice is tender."
    },
    {
      "position": 7,
      "text": "Remove from heat; let stand 5 minutes before fluffing lightly with a fork. Serve sprinkled with green onions and hot sauce, if desired."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,

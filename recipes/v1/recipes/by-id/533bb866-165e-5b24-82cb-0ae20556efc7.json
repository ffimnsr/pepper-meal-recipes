  "id": "533bb866-165e-5b24-82cb-0ae20556efc7",
  "slug": "baked-french-toast",
  "name": "Baked French Toast",
  "recipe_type": "dessert",
  "brief_description": "This baked French toast is prepared the night before. Delicious served with berries and syrup for a sweet and sumptuous breakfast or brunch treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9x13-inch baking dish; arrange slices of bread on the bottom."
    },
    {
      "position": 2,
      "text": "Beat eggs, milk, cream, vanilla, and cinnamon together in a large bowl. Pour over bread slices, cover, and refrigerate overnight."
    },
    {
      "position": 3,
      "text": "The next morning, preheat the oven to 350 degrees F (175 degrees C). Meanwhile, combine butter, brown sugar, and corn syrup together in a small saucepan; heat until bubbling."
    },
    {
      "position": 4,
      "text": "Pour over bread and egg mixture."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven, uncovered, for 40 minutes."
    },
    {
      "position": 6,
      "text": "Serve with berries and syrup."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "id": "5be6ce8d-7581-534b-991f-593a7ce5f8ce",
  "slug": "cheese-garlic-biscuits",
  "name": "Cheese-Garlic Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "This cheese-garlic biscuits recipe requires only 15 minutes and just five ingredients: baking mix, milk, butter, Cheddar cheese, and garlic powder.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F."
    },
    {
      "position": 2,
      "text": "Combine baking mix, milk, and Cheddar cheese until a soft dough forms; drop by 9 spoonfuls onto an ungreased cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes. Combine butter and garlic powder; brush over warm biscuits."
    }
  ],
  "servings": 9,

  "id": "3d7e4957-d7db-58fa-a635-0f8b741f473d",
  "slug": "yogurt-cake",
  "name": "Yogurt Cake",
  "recipe_type": "dessert",
  "brief_description": "A lemon pound cake made with yogurt instead of sour cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch bundt pan."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a large bowl with an electric mixer until light and fluffy. Beat one egg at a time into the butter mixture; add lemon extract with last egg."
    },
    {
      "position": 3,
      "text": "Sift together the flour, baking soda and salt. Alternately mix in the flour mixture and the yogurt, starting and ending with the dry ingredients. Beat just until incorporated."
    },
    {
      "position": 4,
      "text": "Pour batter into prepared pan. Bake in the preheated oven for 60 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool 10 minutes in the pan, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,

  "id": "e4acc4d8-3f1d-59bf-b2aa-e2946fd71129",
  "slug": "ultimate-breakfast-casserole",
  "name": "Ultimate Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Ham and potato casserole in a creamy sauce. Drizzling butter on top is the key to a delicate golden crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Season beaten eggs with pepper; pour into baking dish. In a large bowl, combine soup, sour cream, hash browns, ham, onion and cheese. Mix thoroughly and pour over eggs."
    },
    {
      "position": 3,
      "text": "Bake uncovered for 30 minutes. Remove and drizzle butter over top of casserole. Return to oven and bake for an additional 15 minutes, until golden."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a173a46d-80fd-515d-bc97-43dd248f3444",
  "slug": "hamburgers-with-grilled-apple-and-chili-crisp-recipe-8637636",
  "name": "Hamburgers with Grilled Apple and Chili Crisp",
  "recipe_type": "dessert",
  "brief_description": "Juicy grilled hamburgers with sweet-tart apples served in buns with thick-cut red onions and spicy mayonnaise.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice 1 apple using a mandoline slicer to create 8 (\u00bc-inch-thick) slices. Shred any remaining scraps plus all or part of the second apple to get 1/2 cup shredded apple. Squeeze shredded apple to extract some of the moisture. Reserve any remaining apple for another use."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill to medium heat (350 to 375 degrees F (175 to 190 degrees C))."
    },
    {
      "position": 3,
      "text": "Combine ground beef, bread crumbs, 3 teaspoons chili crisp, salt, and the 1/2 cup shredded apple in a bowl. Shape into 4 (\u00bd-inch-thick) patties, 4 inches in diameter. Mixture may be wet so be sure to tightly pack patties."
    },
    {
      "position": 4,
      "text": "Oil the grill grate. Grill patties, covered, carefully turning halfway through, until an instant-read thermometer inserted into centers of patties reads 160 degrees F (71 degrees C), 10 to 13 minutes. Grill onion slices, turning halfway through, 8 to 10 minutes. Grill apple slices, turning halfway through, 4 to 5 minutes. If you like, grill buns, cut sides down, until toasted, 1 to 2 minutes. When onions are cool enough to handle, separate rings."
    },
    {
      "position": 5,
      "text": "Stir mayonnaise and remaining 2 teaspoons chili crisp together in a small bowl. Spread buns with mayonnaise mixture and fill with patties, onion, and apple slices. Serve with additional chili crisp if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "e6738656-593b-529f-ab3a-2930a08a7922",
  "slug": "instant-pot-yankee-pot-roast",
  "name": "Instant Pot Yankee Pot Roast",
  "recipe_type": "main",
  "brief_description": "Make Yankee pot roast in the Instant Pot with baby carrots, frozen pearl onions, and a seasoned flour coating that makes a rich, thick sauce.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together flour, salt, and pepper in a small bowl."
    },
    {
      "position": 2,
      "text": "Pat chuck roast dry with a paper towel. Sprinkle flour mixture all over roast, pressing lightly to ensure it sticks to the meat."
    },
    {
      "position": 3,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot), add oil, and select Saut\u00e9 function. Add roast to the hot oil and cook, without turning, until browned, about 3 minutes. Turn roast to brown each side, about 3 minutes per side. Transfer roast to a plate."
    },
    {
      "position": 4,
      "text": "Add onion, garlic, and minced rosemary to the pot; cook, stirring often, until onion is translucent, about 6 minutes. Add beef stock, wine, and tomato paste and simmer while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Return roast to the pot; add bay leaf."
    },
    {
      "position": 5,
      "text": "Close and lock the lid, select Meat/Stew function, and set the timer for 40 minutes."
    },
    {
      "position": 6,
      "text": "Release pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Transfer roast to a plate, tent with aluminum foil, and let rest for 15 minutes."
    },
    {
      "position": 7,
      "text": "Add carrots, pearl onions, and celery to the pot. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 4 minutes. Allow 5 to 10 minutes for pressure to build."
    },
    {
      "position": 8,
      "text": "Release pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 9,
      "text": "Slice roast against the grain, or use 2 forks to pull meat into chunks. Transfer roast, vegetables, and sauce to a serving platter. Discard bay leaf and garnish with rosemary sprigs."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 75,

  "id": "00cf76de-50ac-55f6-bdc5-3b50fa87bef9",
  "slug": "easy-pressure-cooker-potatoes",
  "name": "Easy Pressure Cooker Potatoes",
  "recipe_type": "side",
  "brief_description": "Make perfect pressure cooker potatoes quickly and easily using whole, skin-on potatoes, ready in 20 minutes or less to accompany any meal or recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water into the bottom of a pressure cooker (such as Presto). Place a trivet into the pressure cooker and turn the heat on high."
    },
    {
      "position": 2,
      "text": "Place potatoes in a single layer in the pressure cooker and lock the lid. Cook over high heat until the pressure regulator reaches 15 psi, 5 to 10 minutes. Remove from heat. Allow pressure to drop naturally, 10 minutes. Unlock and remove lid."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

  "schema_version": 1,
  "id": "7102662d-e609-5c11-823c-0f9ce4d51e7b",
  "slug": "bacon-ranch-cheese-ball",
  "name": "Bacon-Ranch Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This is an extra bacon-y version of a classic ranch cheese ball. If you're a bacon or ranch lover (or both), this is the cheese ball dreams are made of, and will be a staple appetizer for entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels and allow to cool. Crumble bacon slices when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Mix together cream cheese, Cheddar cheese, Ranch dressing mix, dried minced onion, garlic powder, and 1/2 of the crumbled bacon in a bowl until well combined. Place the other half of crumbled bacon in the refrigerator until ready to use."
    },
    {
      "position": 3,
      "text": "Form cheese mixture into a round ball (it's helpful to use plastic wrap while shaping it). Wrap in plastic wrap and refrigerate for at least 2 hours."
    },
    {
      "position": 4,
      "text": "Place remaining crumbled bacon on a plate and stir in minced chives. Remove plastic wrap from the cheese ball and roll it in the bacon and chive mixture, lightly pressing the topping to the cheese ball so it sticks."
    },
    {
      "position": 5,
      "text": "Place the coated cheese ball on a serving dish and surround with crackers for dipping."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

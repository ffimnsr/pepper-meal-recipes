  "id": "dd9dae3b-480d-56f4-9cd7-0a05d97522de",
  "slug": "oatmeal-pancakes-ii",
  "name": "Oatmeal Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy oatmeal pancakes are made with a buttermilk and oat batter that's easy to prep in a blender. Delicious topped with apple sauce or syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine buttermilk, flour, oats, egg, oil, sugar, vanilla, baking powder, baking soda, and salt in a blender; pur\u00e9e until smooth."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle or large skillet over medium-high heat. Pour 1/4 cupfuls batter onto the hot griddle. Cook until bubbles form on the surface, 1 to 2 minutes. Flip and cook until browned on the other side, 1 to 2 minutes more."
    },
    {
      "position": 4,
      "text": "Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "a7511128-34ea-585b-a1de-8b5a96fb0c9b",
  "slug": "copycat-philadelphia-strawberry-cheesecake-snack-bars-recipe-11929390",
  "name": "Copycat Philadelphia Strawberry Cheesecake Snack Bars",
  "recipe_type": "dessert",
  "brief_description": "Philadelphia strawberry cheesecake snack bars may be discontinued, but now you can make them at home. With a graham cracker crust, cheesecake filling, and a topping made from fresh and cooked strawberries, this copycat will bring back the memories.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a 9x9-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "For cheesecake crust, combine graham cracker crumbs with 4 tablespoons sugar, mix well, then add melted butter. Mix until all crumbs appear wet. Pour crust into the prepared pan and press flat against the bottom."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven for 10 minutes to set. Remove and allow crust to cool while making cheesecake."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 315 degrees F (157 degrees C)."
    },
    {
      "position": 5,
      "text": "For cheesecake, beat cream cheese with an electric mixer until smooth. Add 1/2 cup plus 2 tablespoons sugar and mix well. Beat in 1 tablespoon vanilla, sour cream, and salt. Whisk 2 eggs in a bowl, and mix manually into cream cheese mixture (this introduces less air into the batter). Pour cheesecake batter onto cooled crust. Tent cheesecake pan with foil."
    },
    {
      "position": 6,
      "text": "Bake cheesecake in the preheated oven for 30 to 35 minutes; remove tent and rotate pan halfway through baking."
    },
    {
      "position": 7,
      "text": "Meanwhile, for strawberry filling, combine half of the diced strawberries and 1/4 cup sugar in a small saucepan over medium-low heat. Heat until strawberries produce juice and come to a bubble, reducing a little. Dissolve cornstarch in cold water; stir into the pan. Cook for 10 minutes, stirring a few times, then remove from heat and add remaining 1 teaspoon vanilla extract and remaining strawberries (for a pop of freshness). Transfer to a heatproof bowl. Refrigerate for 4 hours or up to overnight."
    },
    {
      "position": 8,
      "text": "Remove cheesecake from the oven and allow to cool for 15 minutes. Use a knife to loosen edges from the sides of the pan. Continue to cool at room temperature for 1 to 2 hours more, then transfer to the refrigerator. Refrigerate 4 hours or up to overnight."
    },
    {
      "position": 9,
      "text": "Remove chilled cheesecake from pan and cut into 6 to 8 rectangles (one cut in half horizontally and 2 to 3 even vertical cuts). Feel free to remove edges of cheesecake before cutting into bars."
    },
    {
      "position": 10,
      "text": "Use a spoon to carve out a shallow strip of cheesecake in the center of each bar, not as deep as the crust. Add the strawberry filling to the strip."
    },
    {
      "position": 11,
      "text": "Place white chocolate in a microwave-safe bowl and microwave in 30 second intervals until completely melted. Cool white chocolate and add to a piping bag or resealable plastic bag, cut the tip, and drizzle white chocolate on top of each bar."
    }
  ],
  "servings": 6,

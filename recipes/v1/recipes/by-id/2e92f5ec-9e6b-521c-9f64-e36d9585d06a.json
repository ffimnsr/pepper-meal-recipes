  "id": "2e92f5ec-9e6b-521c-9f64-e36d9585d06a",
  "slug": "rough-puff-pastry-recipe-8647014",
  "name": "Rough Puff Pastry",
  "recipe_type": "dessert",
  "brief_description": "This homemade rough puff pastry is perfect for making crispy pies and tarts with buttery, flaky layers in less time than traditional puff pastry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place flour and salt in the bowl of a stand mixer fitted with a paddle attachment. Add butter and toss with your fingertips until evenly coated with flour."
    },
    {
      "position": 2,
      "text": "Add water to bowl. Mix on low speed until the dough forms a shaggy mass, about 45 seconds."
    },
    {
      "position": 3,
      "text": "Cover bowl with plastic wrap and refrigerate until butter is firm but not brittle, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Transfer dough to a floured work surface and roll into a \u00bd-inch-thick rectangle that is about 10 \u00bd x 6 inches."
    },
    {
      "position": 5,
      "text": "Fold one third of the longer side of the dough over the center third of dough. Fold the final third over the center (like you would fold a letter). Tightly wrap folded dough in plastic wrap and refrigerate until chilled, about 30 minutes. Repeat this process of rolling, folding and refrigerating 4 more times, turning the dough 90 degrees each time before rolling."
    },
    {
      "position": 6,
      "text": "After completing the final fold, wrap the dough tightly in plastic wrap and refrigerate until firm before using, at least 1 hour or up to 2 days. Recipe developed by Anna Theoktisto"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

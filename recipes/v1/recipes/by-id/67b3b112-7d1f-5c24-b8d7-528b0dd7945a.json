  "id": "67b3b112-7d1f-5c24-b8d7-528b0dd7945a",
  "slug": "scones",
  "name": "Scones",
  "recipe_type": "breakfast",
  "brief_description": "These simple scones are made with basic pantry ingredients and ready to eat in just 30 minutes! Delicious with butter or clotted cream and berry jam.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, baking powder, and salt in a large bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 4,
      "text": "Whisk milk and egg in a small bowl; gradually stir into flour mixture until moistened."
    },
    {
      "position": 5,
      "text": "Turn dough out onto a lightly floured surface and knead briefly, 5 or 6 turns."
    },
    {
      "position": 6,
      "text": "Pat or roll dough out into a 1/2-inch thick round. Cut into 8 wedge-shaped pieces and place onto the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake scones in the preheated oven until golden brown on top, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

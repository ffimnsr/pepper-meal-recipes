  "id": "b83df1fa-bc27-5d3d-bf37-5a3a8fb534b4",
  "slug": "egg-roll-in-a-bowl",
  "name": "Egg Roll in a Bowl",
  "recipe_type": "appetizer",
  "brief_description": "Crispy wonton strips top Chef John's version of an egg roll in a bowl for a crunchy makeover of the takeout favorite.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut wonton wrappers into 1/4-inch strips. Transfer cut wonton wrappers to a baking pan and toss with oil. Spread out evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned, about 12 minutes. Let cool and reserve."
    },
    {
      "position": 4,
      "text": "Combine cabbage, carrot, bell pepper, green onions, and garlic for the bowl. Set aside."
    },
    {
      "position": 5,
      "text": "Mix soy sauce, rice vinegar, sake, sesame oil, sugar, ginger, cayenne, pepper, ketchup, and cornstarch together for sauce in a bowl and reserve."
    },
    {
      "position": 6,
      "text": "Add pork to a large skillet set over medium-high heat. Brown the meat well, while breaking up into small crumbles as it cooks, 5 to 7 minutes. Add the vegetable mixture and toss with the meat to combine. Cook, stirring, just until the veggies start to soften, about 2 minutes."
    },
    {
      "position": 7,
      "text": "Stir in the sauce and toss everything to combine. Cook and stir until the sauce has coated everything evenly, and the vegetables are cooked to desired doneness, 1 to 2 minutes more. Serve in a bowl with crispy wonton strips on top."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

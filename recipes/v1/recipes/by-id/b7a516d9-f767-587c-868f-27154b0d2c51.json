  "id": "b7a516d9-f767-587c-868f-27154b0d2c51",
  "slug": "scallops-one-two-three",
  "name": "Bacon-Wrapped Scallops",
  "recipe_type": "appetizer",
  "brief_description": "Bacon-wrapped scallops are a deliciously easy and elegant appetizer made with just three ingredients: sea scallops, bacon, and fresh lemon juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut bacon slices in half and wrap each half around a scallop. Use a toothpick to secure in place. Drizzle lemon juice over scallops. Place on a cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake in a preheated oven for 15 to 20 minutes or until bacon is cooked. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

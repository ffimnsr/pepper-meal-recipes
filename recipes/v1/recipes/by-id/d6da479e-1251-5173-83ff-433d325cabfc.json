  "id": "d6da479e-1251-5173-83ff-433d325cabfc",
  "slug": "asian-lettuce-wraps",
  "name": "Asian Lettuce Wraps",
  "recipe_type": "appetizer",
  "brief_description": "These lettuce wraps are filled with saucy, gingery beef. Super easy to make and bursting with Asian flavors \u2014 they make a fun appetizer to share!",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse whole lettuce leaves and pat dry, being careful not to tear them; set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat. Add beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease; transfer beef to a bowl."
    },
    {
      "position": 4,
      "text": "Add onion to the same skillet; cook and stir until just tender, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Stir in hoisin sauce, garlic, soy sauce, vinegar, ginger, and chile pepper sauce until well combined. Add water chestnuts, green onions, sesame oil, and cooked beef; cook and stir until the onions just begin to wilt, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Arrange lettuce leaves around the outer edge of a large serving platter; spoon beef mixture in the center."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

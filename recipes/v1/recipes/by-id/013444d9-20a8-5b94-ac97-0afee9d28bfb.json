  "id": "013444d9-20a8-5b94-ac97-0afee9d28bfb",
  "slug": "classic-waffles",
  "name": "Classic Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These crispy waffles are easy to make with simple ingredients you probably already have on hand for a light and fluffy breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix flour, salt, baking powder, and sugar together in a large bowl; set aside. Preheat waffle iron to desired temperature."
    },
    {
      "position": 3,
      "text": "Beat eggs in a separate bowl; stir in milk, butter, and vanilla."
    },
    {
      "position": 4,
      "text": "Pour milk mixture into flour mixture; beat until blended."
    },
    {
      "position": 5,
      "text": "Ladle batter into a preheated waffle iron."
    },
    {
      "position": 6,
      "text": "Cook waffles until golden and crisp."
    },
    {
      "position": 7,
      "text": "Serve immediately and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

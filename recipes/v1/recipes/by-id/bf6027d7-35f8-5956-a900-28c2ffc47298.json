  "id": "bf6027d7-35f8-5956-a900-28c2ffc47298",
  "slug": "blackberry-cobbler-with-frozen-blackberries",
  "name": "Blackberry Cobbler with Frozen Blackberries",
  "recipe_type": "dessert",
  "brief_description": "This blackberry cobbler uses frozen blackberries and can be made any time of the year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray an 8-inch or 9-inch square baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "In a large bowl, gently stir the frozen blackberries together with 2 tablespoons sugar, lemon juice, and vanilla extract. Spread into the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine flour, remaining 1 cup sugar, and egg together in a bowl until mixture resembles a coarse meal. Sprinkle mixture evenly over the blackberries. Drizzle melted butter evenly on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned and bubbly, 35 to 40 minutes. Remove from the oven and let cool for 10 minutes. Serve warm topped with whipped topping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

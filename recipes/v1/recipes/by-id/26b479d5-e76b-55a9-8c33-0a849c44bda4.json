  "id": "26b479d5-e76b-55a9-8c33-0a849c44bda4",
  "slug": "leftover-brown-rice-and-mushroom-pilaf-recipe-11826082",
  "name": "Leftover Brown Rice and Mushroom Pilaf",
  "recipe_type": "side",
  "brief_description": "This leftover brown rice and mushroom pilaf turn cooked brown rice into a whole new dish. Slivered almonds, sauteed shallots and celery, plus white mushrooms, add savory flavor and crunchy texture\u2014no one will complain about these 'lefties.'",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large, nonstick skillet over medium heat. When butter stops sizzling, add shallots and celery. Cook, stirring occasionally, until onions begin to turn translucent, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Stir in mushrooms and thyme, and cook about 5 minutes. Season with salt and pepper, and stir in garlic and slivered almonds. Cook until garlic is fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add broth, and cook for 1 minute, then stir in cooked brown rice. Cook until heated through, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Garnish with fresh parsley, if desired, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

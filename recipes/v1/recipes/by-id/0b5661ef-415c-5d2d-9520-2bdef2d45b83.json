  "id": "0b5661ef-415c-5d2d-9520-2bdef2d45b83",
  "slug": "copycat-apple-grande-recipe-11918089",
  "name": "Copycat Apple Grande",
  "recipe_type": "dessert",
  "brief_description": "This copycat apple grande is our take on the cult classic from the regional Taco John\u2019s! Instead of a crispy tostada with a flour tortilla, we made this like a quesadilla, following the fun hack from Nicole McLaughlin. It makes a sort of apple dumpling that is taken to a new level with a sprinkle of salty sharp Cheddar on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) with a rack in the bottom third position. Grease a (9-inch) pie plate or round baking dish with 1 tablespoon butter."
    },
    {
      "position": 2,
      "text": "Cut each tortilla in half. Place about 1/4 cup pie filling onto the center of each tortilla half; fold each end of the tortilla over the filling so that it creates a triangular shape with a point at the bottom. Repeat with remaining tortillas and pie filling until you have 8 triangles."
    },
    {
      "position": 3,
      "text": "Melt remaining 1 tablespoon butter. Arrange tortilla triangles in a circle in the prepared pie plate and brush tops of tortillas with melted butter. Sprinkle top of buttered tortillas evenly with cinnamon sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tortillas are toasted around the edges, 15 to 20 minutes. Remove from the oven and sprinkle with Cheddar cheese. Serve. Recipe developed by Julia Levy"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

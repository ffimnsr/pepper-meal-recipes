  "id": "ee61d778-eead-519a-9ada-1808a4ac91b1",
  "slug": "chickpeas-and-chorizo",
  "name": "Chickpeas and Chorizo",
  "recipe_type": "appetizer",
  "brief_description": "This chickpea chorizo stew is an expansion on a popular Spanish tapas recipe made with potatoes, onion, garlic, and roasted peppers.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place beans into a large container; add enough cool water to cover by several inches. Soak beans for 8 hours to overnight. Drain and rinse before using."
    },
    {
      "position": 2,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil."
    },
    {
      "position": 3,
      "text": "Cut bell peppers in half lengthwise. Remove and discard stems, seeds, and ribs. Arrange pepper halves, cut-sides down, onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Roast peppers under the preheated broiler until blackened and blistered, 5 to 8 minutes; transfer to a bowl, seal tightly with plastic wrap, and let steam until skins are loosened, about 20 minutes. Remove and discard skins. Slice peppers."
    },
    {
      "position": 5,
      "text": "Heat oil in a large pot over medium heat. Cook and stir potatoes in hot oil until browned, about 10 minutes. Add chorizo and continue to cook until hot, 3 to 5 minutes. Stir in sliced peppers, onion, garlic, paprika, and salt; cook, stirring occasionally, until onion is softened, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Stir in beans, then pour in sherry and bring to a boil. Reduce heat to medium-low, cover the pot, and simmer until beans are tender, 10 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

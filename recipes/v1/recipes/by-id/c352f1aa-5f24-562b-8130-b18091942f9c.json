  "id": "c352f1aa-5f24-562b-8130-b18091942f9c",
  "slug": "oreo-tres-leches-cake-recipe-12022708",
  "name": "Oreo Tres Leches Cake",
  "recipe_type": "dessert",
  "brief_description": "This Oreo tres leches cake is an easy, shortcut take on the classic tres leches dessert with a cookies-and-cream twist. With crushed mini Oreos baked into the cake, a rich tres leches soak, and a creamy whipped topping, it\u2019s unbelievably moist and even better the next day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). (If you are using a dark pan, preheat the oven to 325 degrees F (170 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "For cake, whisk eggs, oil, and water together in a large bowl. Add cake mix; mix until smooth. Fold in 1 cup crushed Oreos. Pour batter into the prepared pan and spread evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 28 to 32 minutes. Let the cake cool completely, about 20 minutes."
    },
    {
      "position": 4,
      "text": "For tres leches soak, whisk sweetened condensed milk, evaporated milk, whole milk, and optional vanilla together in a bowl until fully combined; stir in 1/2 cup crushed Oreos."
    },
    {
      "position": 5,
      "text": "Use a fork or skewer to poke holes all over the surface of the cooled cake. Slowly pour milk mixture evenly over the cake, allowing it to soak in. Cover and refrigerate for at least 4 hours, or overnight for the best texture."
    },
    {
      "position": 6,
      "text": "For topping, fold 1/2 cup crushed Oreos into Cool Whip. Spread evenly over chilled cake. Decorate with extra crushed Oreos and mini Oreos. Keep refrigerated until ready to serve. This cake is best served cold."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

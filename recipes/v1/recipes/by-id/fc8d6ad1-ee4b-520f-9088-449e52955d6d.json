  "id": "fc8d6ad1-ee4b-520f-9088-449e52955d6d",
  "slug": "homemade-biscuit-mix",
  "name": "Homemade Biscuit Mix",
  "recipe_type": "dessert",
  "brief_description": "Keep this basic biscuit mix on hand and you'll be able to make quick, tasty homemade biscuits in minutes\u2014or use this in any recipe that calls for biscuit mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, baking powder, sugar and salt in a mixing bowl. Add oil and mix with a fork or pastry blender; you should have small lumps throughout the mixture."
    },
    {
      "position": 2,
      "text": "Store in an airtight container in a cool, dry place for up to three months."
    }
  ],

  "id": "2b33e011-1b24-5381-b488-088b083758e6",
  "slug": "air-fryer-hush-puppies",
  "name": "Air Fryer Hush Puppies",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer hush puppies made with cornmeal and buttermilk are a much lighter alternative to the traditional fritters, which are deep-fried in oil.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 390 degrees F (198 degrees C) according to the manufacturer's instructions. Line the bottom of the air fryer basket with foil and spray the foil with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir cornmeal, flour, baking powder, salt, cayenne, and garlic powder together in a large bowl. Mix in onion and bell pepper."
    },
    {
      "position": 3,
      "text": "Whisk buttermilk and egg together in a separate bowl; pour into dry ingredients and stir to combine. Let mixture rest for 5 minutes."
    },
    {
      "position": 4,
      "text": "Use a 2-tablespoon scoop to drop portions of batter into the prepared basket; leave space between each scoop. Spray with cooking spray."
    },
    {
      "position": 5,
      "text": "Cook in the preheated air fryer until golden brown, crispy, and cooked through, 9 to 10 minutes. Serve hot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

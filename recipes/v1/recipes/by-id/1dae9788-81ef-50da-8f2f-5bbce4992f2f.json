  "slug": "corn-and-black-bean-guacamole",
  "name": "Corn and Black Bean Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This chunky guacamole has red pepper, corn, red onion, and black beans for a colorful dip for tortilla chips.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Stir red bell pepper, red onion, garlic, sweet corn, black beans, and avocado slices together in a large bowl."
    },
    {
      "position": 2,
      "text": "Mix lime juice, salt, black pepper, and cilantro into avocado mixture until desired texture is achieved."
    }
  ],
  "servings": 8,

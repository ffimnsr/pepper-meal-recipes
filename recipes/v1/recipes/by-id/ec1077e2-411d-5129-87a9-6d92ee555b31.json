  "id": "ec1077e2-411d-5129-87a9-6d92ee555b31",
  "slug": "freezer-lemon-fudge",
  "name": "Freezer Lemon Fudge",
  "recipe_type": "dessert",
  "brief_description": "This lemon 'fudge' is sweet, tart, and refreshing, This 'fudge' is a bit on the rich side so a little goes a long way. Be sure to store in freezer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 5x7-inch dish with parchment paper, leaving an overhang for easy removal of fudge. Spray with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Place white chocolate chips and sweetened condensed milk in a microwave-safe bowl. Microwave at 30-second intervals, stirring each time, until mixture is smooth and melted. Add lemon juice, 2 tablespoons lemon zest, lemon extract, and salt. Stir until well combined."
    },
    {
      "position": 3,
      "text": "Pour into the prepared dish and smooth out the top. Sprinkle with remaining 1 tablespoon lemon zest. Freeze for a minimum of 4 hours, or until set."
    },
    {
      "position": 4,
      "text": "Use a hot knife to cut fudge, wiping the knife clean after each cut."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

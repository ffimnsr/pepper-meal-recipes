  "slug": "tangy-cucumber-and-avocado-salad",
  "name": "Cucumber and Avocado Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy cucumber avocado salad with cilantro is easy to prep in minutes and simply dressed with lime juice for an incredibly fresh summer salad.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cucumbers, avocados, and cilantro in a large bowl; stir in garlic, green onions, salt, and pepper. Pour lemon and lime juice over the top; toss well. For best flavor results, cover and refrigerate the salad until chilled before serving."
    }
  ],

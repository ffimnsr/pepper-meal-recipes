  "id": "23e6923d-983c-57c4-9ac1-ec7c17b01186",
  "slug": "chicken-and-waffles-casserole-recipe-8584860",
  "name": "Chicken and Waffles Casserole",
  "recipe_type": "dessert",
  "brief_description": "This chicken and waffles casserole is a great way to change up the brunch casserole. With chicken nuggets, frozen waffles, and maple syrup, it has all the sweet and savory notes you love from chicken and waffles.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish. Arrange waffles on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until lightly toasted on each side, about 4 minutes per side. Remove; cut each waffle into 8 pieces. and arrange waffles in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Cut larger chicken nuggets in half, leaving smaller pieces whole, and arrange chicken pieces among the waffles."
    },
    {
      "position": 4,
      "text": "Whisk together eggs, half-and-half, 2 tablespoons maple syrup, salt, and cayenne pepper in a large bowl until well combined and slightly frothy. Pour egg mixture over waffles and chicken; cover and let stand 15 minutes to soak before baking."
    },
    {
      "position": 5,
      "text": "Bake until eggs are set and top is golden brown, about 1 hour, uncovering halfway through baking time. Let stand 5 to 10 minutes before serving. Drizzle with melted butter and syrup."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

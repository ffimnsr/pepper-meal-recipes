  "id": "b37d880d-783c-596a-b890-44ffa6052033",
  "slug": "cowboy-butter-spaghetti-recipe-11763244",
  "name": "Cowboy Butter Spaghetti",
  "recipe_type": "side",
  "brief_description": "This cowboy butter spaghetti begins with a spicy compound butter; add a little cream and a few more seasonings for a delicious take on buttered noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "To make the cowboy butter: Combine butter, brown mustard, parsley, thyme, lemon juice, paprika, salt, black pepper, cayenne, and red chili flakes in a bowl and mix with a spatula until fully combined."
    },
    {
      "position": 3,
      "text": "Scrape the mixed cowboy butter to the middle of the bowl to form a mound. Set aside to use immediately, or for best results, to allow the flavors to meld, cover in plastic wrap and refrigerate for 2 hours or up to overnight."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Reserve 1/4 cup pasta water, then drain spaghetti. Set aside."
    },
    {
      "position": 5,
      "text": "Meanwhile, melt prepared cowboy butter in a large saucepan over medium-low heat. Add cream, lemon juice, garlic salt, and red pepper flakes, and heat until steaming, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Stir in spaghetti, and add reserved pasta water as needed to thin sauce."
    },
    {
      "position": 7,
      "text": "Season to taste with salt. Serve spaghetti in bowls; garnish with parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

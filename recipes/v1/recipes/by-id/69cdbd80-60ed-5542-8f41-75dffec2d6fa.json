  "id": "69cdbd80-60ed-5542-8f41-75dffec2d6fa",
  "slug": "microwave-bread-and-butter-pickles",
  "name": "Microwave Bread and Butter Pickles",
  "recipe_type": "snack",
  "brief_description": "Who knew the microwave was a pickles best friend? Cucumbers, onions and spices become crisp and delicious in minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium microwave safe bowl, mix cucumber, salt, onion, mustard seeds, white sugar, distilled white vinegar, celery seed and turmeric."
    },
    {
      "position": 2,
      "text": "Microwave on high 7 to 8 minutes, stirring twice, until cucumbers are tender and onion is translucent."
    },
    {
      "position": 3,
      "text": "Transfer to sterile containers. Seal and chill in the refrigerator until serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

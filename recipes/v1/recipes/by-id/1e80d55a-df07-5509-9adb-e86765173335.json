  "id": "1e80d55a-df07-5509-9adb-e86765173335",
  "slug": "sloppy-juan",
  "name": "Sloppy Juan",
  "recipe_type": "main",
  "brief_description": "Give your sloppy joe sandwich a Mexican twist with chorizo, cilantro, chili powder, and cumin.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayonnaise, sour cream, 1/4 cup cilantro, green onions, chipotle chili powder, 1 tablespoon lime juice, garlic basil spread, and cumin in a small bowl. Stir until combined; season with salt and black pepper. Cover and refrigerate for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a large pot or Dutch oven over medium heat; cook and stir chorizo, ground beef, and coriander until meat is browned, about 15 minutes. Drain and discard fat. Season with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Stir cabbage, green bell pepper, yellow bell pepper, orange bell pepper, jalapeno, and water into chorizo mixture; cook and stir until peppers soften, about 10 minutes. Add brown sugar and chili powder; cook and stir until water is evaporated and sauce is thick, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle 1/4 cup cilantro and juice of 1 lime over the chorizo mixture and remove from heat."
    },
    {
      "position": 5,
      "text": "Spread each hoagie bun with 1 tablespoon chipotle mayo. Evenly distribute the chorizo mixture among the 4 sandwiches."
    },
    {
      "position": 6,
      "text": "Heat 1 tablespoon olive oil in a nonstick skillet over medium heat; fry eggs, 2 to 4 at a time if necessary, until whites are set but yolks are still soft, about 2 minutes per side. Place two eggs atop each sandwich."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

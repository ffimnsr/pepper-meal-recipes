  "id": "0a9467b4-1169-5db7-b870-209260176ffa",
  "slug": "cinnamon-apple-scones",
  "name": "Cinnamon-Apple Scones",
  "recipe_type": "dessert",
  "brief_description": "These moist cinnamon-apple round scones give off a comforting, fall-ready flavor thanks to fresh Granny Smith apples, brown sugar, and ground cinnamon.",
  "cuisine": "American British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, baking soda, cinnamon, and salt into a mixing bowl; rub in butter. Add apples and 6 tablespoons brown sugar. Add 1/2 cup milk; work into a dough."
    },
    {
      "position": 3,
      "text": "Press into a 6- to 7-inch round on the prepared baking sheet. Brush with 1 tablespoon milk; sprinkle with remaining 1 tablespoon brown sugar. Score into 8 segments without cutting all the way through."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "7964efae-fbc1-50c1-8f32-97fe83b9bf10",
  "slug": "healthy-shepherds-pie-with-cauliflower-mash",
  "name": "Healthy Shepherd's Pie with Cauliflower Mash",
  "recipe_type": "main",
  "brief_description": "Shepherd's pie is a classic comfort food, and this low-carb version, made with ground turkey and topped with cauliflower mash, is just as comforting and delicious as the original.",
  "cuisine": "British American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat avocado oil in a very large skillet over medium-high heat. Add celery, mushrooms, and onion; saute until onion is translucent, 5 to 7 minutes. Crumble turkey into the skillet. Add parsley, thyme, garlic powder, pepper, red pepper flakes, and salt. Cook until turkey is no longer pink and has absorbed most of the liquid in the skillet, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Sprinkle almond flour over the turkey mixture and cook for 1 minute. Stir in tomato sauce until combined; cook until thickened, about 5 minutes. Transfer to a 9x13-inch baking dish and top with sliced zucchini."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Cook cauliflower rice in a large nonstick skillet over medium heat, stirring occasionally, until hot, about 5 minutes. Set 1 cup aside in a large bowl. Transfer remaining cauliflower rice to a food processor with milk and 1 tablespoon butter; blend until smooth. Mix with reserved rice for added texture."
    },
    {
      "position": 5,
      "text": "Spread cauliflower mixture over the meat and zucchini. Cut remaining 1 tablespoon butter into small pieces and dot over the cauliflower. Sprinkle with paprika."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the cauliflower topping has a golden hue, 30 to 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "094a136c-bf5d-5a21-a33b-202060574a74",
  "slug": "apple-chips",
  "name": "Apple Chips",
  "recipe_type": "appetizer",
  "brief_description": "These apple chips are coated in cinnamon sugar, then baked until crispy for a delicious fruity snack to pack in lunch boxes or take on the road.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 225 degrees F (110 degrees C). Line a metal baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Arrange apple slices in a single layer on prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Mix together sugar and cinnamon in a small bowl; sprinkle over apple slices."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until apples are dried and edges curl, 45 minutes to 1 hour. Use a metal spatula to transfer chips to a wire rack until cool and crispy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

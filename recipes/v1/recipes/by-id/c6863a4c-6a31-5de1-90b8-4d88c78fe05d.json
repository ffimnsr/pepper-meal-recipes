  "id": "c6863a4c-6a31-5de1-90b8-4d88c78fe05d",
  "slug": "pine-cone-cheese-ball",
  "name": "Pine Cone Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's show-stopping pine cone cheese ball is a welcome addition to any holiday party spread and a guaranteed crowd pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cream cheese, goat cheese, parsley, tarragon, thyme, garlic, cayenne pepper, salt, and black pepper together in a bowl until smooth and well-mixed."
    },
    {
      "position": 2,
      "text": "Turn cheese mixture out onto a serving platter and form into a tapered oval shape to resemble a pine cone."
    },
    {
      "position": 3,
      "text": "Starting at the tapered end, press almonds into the cheese cone so that the tip of the almond is facing out and down, and cheese cone is completely covered with almonds and resembles a pine cone. Place rosemary sprigs at the top to resemble pine needles."
    },
    {
      "position": 4,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 16,

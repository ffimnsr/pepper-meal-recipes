  "id": "fb1a6fc9-a38d-5c39-a29e-264a980ad51c",
  "slug": "break-up-pasta-recipe-11694418",
  "name": "Break-Up Pasta",
  "recipe_type": "main",
  "brief_description": "This creamy single serving break-up pasta is the perfect weeknight comfort dinner when you're cooking just for yourself.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Add garlic and cook, stirring constantly, until fragrant, about 30 seconds. Stir in tomato sauce and Sriracha; bring to simmer. Stir in water until smooth and incorporated."
    },
    {
      "position": 3,
      "text": "Stir in pasta and cook on medium heat, stirring often, until sauce has thickened and pasta is al dente, 16 to 18 minutes."
    },
    {
      "position": 4,
      "text": "Stir in heavy cream; cook, stirring constantly, until sauce coats pasta, about 1 minute. Remove from heat and stir in Parmesan cheese until melted and creamy, about 1 minute. If starting to get too thick, add additional water, 1 tablespoon at a time, until pasta has the desired consistency."
    },
    {
      "position": 5,
      "text": "Spoon pasta into a serving bowl and sprinkle with additional Parmesan cheese. Recipe developed by Julia Levy"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

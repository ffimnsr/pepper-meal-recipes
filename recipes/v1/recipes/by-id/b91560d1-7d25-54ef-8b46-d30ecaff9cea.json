  "id": "b91560d1-7d25-54ef-8b46-d30ecaff9cea",
  "slug": "egg-white-breakfast-casserole",
  "name": "Egg White Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This egg white casserole with turkey sausage, vegetables, and Cheddar cheese can be made at the beginning of the week for a quick breakfast each morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a casserole dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk egg whites, yogurt, salt, and pepper together in a bowl. Pour into the prepared dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until starting to set, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, saute mushrooms and onion in a pan until softened, 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Spread mushroom mixture, sausage crumbles, and tomato over the parbaked egg layer. Cover with Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Continue baking until eggs are set and cheese is melted, 10 to 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

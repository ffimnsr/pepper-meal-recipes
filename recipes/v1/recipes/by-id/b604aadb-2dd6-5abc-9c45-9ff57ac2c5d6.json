  "id": "b604aadb-2dd6-5abc-9c45-9ff57ac2c5d6",
  "slug": "candied-apples-ii",
  "name": "Candy Apples",
  "recipe_type": "dessert",
  "brief_description": "This candy apples recipe, with its hard red candy shell, recreates a childhood memory of a sweet treat that's still popular at many carnivals today.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly coat baking sheets with nonstick cooking spray. Insert craft sticks into bottom of apples."
    },
    {
      "position": 2,
      "text": "Combine sugar, water, and corn syrup in a medium saucepan over medium-high heat. Bring to a boil; continue boiling, without stirring, until mixture registers 300 to 310 degrees F (149 to 154 degrees C) on a candy thermometer, or until a small amount dropped into cold water forms hard, brittle threads."
    },
    {
      "position": 3,
      "text": "Remove from heat; stir in food coloring."
    },
    {
      "position": 4,
      "text": "Holding each apple by its stick; dip into syrup, turning to coat evenly. Place on the prepared baking sheet to harden, stem-side down."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

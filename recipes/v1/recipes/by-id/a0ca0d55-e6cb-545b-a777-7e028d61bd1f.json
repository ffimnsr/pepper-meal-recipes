  "schema_version": 1,
  "id": "a0ca0d55-e6cb-545b-a777-7e028d61bd1f",
  "slug": "slow-cooker-pulled-pork-roast",
  "name": "Slow Cooker Pulled Pork Roast",
  "recipe_type": "main",
  "brief_description": "This mouthwatering slow cooker pulled pork recipe is perfect for game night. The slow cooker cooks it and keeps it warm. Try it with tangy coleslaw.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove and discard any string from pork roast; trim excess fat."
    },
    {
      "position": 2,
      "text": "Combine chili powder, oil, garlic, black pepper, cumin, coriander, paprika, allspice, and salt in a bowl; rub all over roast, working spice mixture into pork. Marinate in the refrigerator, 30 minutes to overnight."
    },
    {
      "position": 3,
      "text": "Transfer roast to a slow cooker. Combine ketchup, vinegar, molasses, and mustard; pour over roast. Cover slow cooker."
    },
    {
      "position": 4,
      "text": "Cook on Low until very tender, 8 to 10 hours."
    },
    {
      "position": 5,
      "text": "Transfer roast to a large bowl. Discard any visible fat. Separate pork into long strands, using two forks. Return shredded pork to the slow cooker; stir to combine with juices."
    },
    {
      "position": 6,
      "text": "Strain 1 \u00bd cups cooking liquid into a saucepan. Whisk in cornstarch; bring to a boil. Cook, stirring, until thickened and bubbling. Serve pork on soft rolls drizzled with sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 495,
  "preparation_time_minutes": 15,

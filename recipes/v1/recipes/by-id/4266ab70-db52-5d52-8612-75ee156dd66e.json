  "id": "4266ab70-db52-5d52-8612-75ee156dd66e",
  "slug": "creamy-penne-pasta-primavera",
  "name": "Creamy Penne Pasta Primavera",
  "recipe_type": "main",
  "brief_description": "Creamy pasta primavera made with asparagus, carrots, and tomatoes is a colorful, quick and easy, weeknight meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat-high heat; saute asparagus and carrots until tender yet firm to the bite, about 5 minutes. Add tomatoes and garlic; saute until garlic is fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir Parmesan cheese, cream, and black pepper into vegetable mixture until cheese melts and sauce is smooth, 2 to 3 minutes. Add pasta to sauce and toss to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

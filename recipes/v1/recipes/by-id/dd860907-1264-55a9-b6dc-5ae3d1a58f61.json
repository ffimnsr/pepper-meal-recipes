  "id": "dd860907-1264-55a9-b6dc-5ae3d1a58f61",
  "slug": "pickle-crustburger-recipe-11759717",
  "name": "Pickle Crustburger",
  "recipe_type": "main",
  "brief_description": "This pickle crustburger is a multi-layered beauty with thin beef patties, pickle slices, American cheese, and a quick burger sauce on a golden, buttery pan-toasted bun.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir mayonnaise, mustard, ketchup, and pickle juice together in a small bowl until well blended; set aside."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Spread butter on the outside of the top and bottom bun halves; place bun halves buttered sides down in the skillet and press to flatten. Cook, until toasted, about 1 minute. Flip bun and toast on the other side, about 30 seconds, continuing to press to flatten. Place bun on a work surface with cut sides facing down. Spread desired amount of sauce over buns."
    },
    {
      "position": 3,
      "text": "Divide meat into 2 balled portions and place in a hot skillet. Using 2 spatulas, flatten meat to form a very thin patty. Season with salt and pepper. Cook, undisturbed, until a golden brown crust forms, and small holes appear around the edges."
    },
    {
      "position": 4,
      "text": "Use a spatula to carefully lift 1 patty from the pan. Place 3 pickle slices in the pan and flip burger patty on top of pickle slices. Top patty with cheese and flip second patty on top of the cheese. Scrape the burger from the skillet and place on bottom half of bbun. Place top bun on top with the cut side facing up and return the whole burger to the skillet. Cook and press each side, about 15 seconds. Serve immediately."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

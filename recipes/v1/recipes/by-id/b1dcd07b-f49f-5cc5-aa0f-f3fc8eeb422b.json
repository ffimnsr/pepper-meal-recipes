{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b1dcd07b-f49f-5cc5-aa0f-f3fc8eeb422b",
  "slug": "no-eggplant-moussaka",
  "name": "No Eggplant Moussaka",
  "recipe_type": "main",
  "brief_description": "This no-eggplant moussaka takes some assembly but is well worth it. The casserole uses lots of potatoes and lamb as an eggplant substitute and is covered with cheese sauce. Most of the ingredients are everyday staples... with tasty results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a large casserole dish."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons butter in a large heavy skillet over medium heat. Saut\u00e9 onions and parsley until onion is soft and translucent. Increase heat, add lamb, and cook until evenly brown. Drain off excess fat, and set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine tomatoes, Italian seasoning, and salt and pepper. Chop tomatoes, and mix well with seasonings. Set aside."
    },
    {
      "position": 4,
      "text": "In a saucepan over medium heat, melt 2 tablespoons butter. Stir in flour until smooth. Whisk together milk and egg, then gradually whisk into flour mixture. Cook, stirring constantly, until thick and smooth. Remove from heat, and stir in cheese."
    },
    {
      "position": 5,
      "text": "In casserole dish, place 1/3 of potato slices on the bottom, covering as well as possible. Top with half of meat mixture followed by half of tomato mixture. Repeat layers, ending with a layer of potatoes. Spread cheese sauce evenly over the top."
    },
    {
      "position": 6,
      "text": "Cover, and bake in the preheated oven for 1 1/2 hours. Remove cover, and bake 30 minutes longer, or until lightly browned."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

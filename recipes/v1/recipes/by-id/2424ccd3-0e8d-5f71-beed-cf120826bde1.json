  "id": "2424ccd3-0e8d-5f71-beed-cf120826bde1",
  "slug": "grams-chicken-pot-pie",
  "name": "Gram’s Chicken Pot Pie",
  "recipe_type": "soup",
  "brief_description": "Frozen veggies, canned soup and prepackaged pie crust combine with boiled chicken meat to make this one a breeze to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large heavy pot, place chicken and water to cover. Bring to a boil and let simmer uncovered for 30 minutes, adding water as needed. When chicken is boiled and tender, pick all the meat off of the bones."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Open 1 can of cream of mushroom soup and pour into a small saucepan. Add frozen peas and carrots, water and chicken bouillon to taste. Simmer all together until the soup is smooth. Add chicken meat and mix all together."
    },
    {
      "position": 4,
      "text": "Pour chicken and soup mixture into one pie crust and cover with the other crust. Seal the edges and cut a small steam hole in the top crust. Bake in the preheated oven 30 to 35 minutes or until crust is brown. Yummy!"
    }
  ],
  "servings": 6,

  "id": "8af6d7b1-9336-5bd0-8423-bc0b49aa1aba",
  "slug": "apple-cider-hawaiian-roll-donuts-recipe-11786958",
  "name": "Apple Cider Hawaiian Roll Donuts",
  "recipe_type": "dessert",
  "brief_description": "Try these apple cider stuffed Hawaiian rolls that are reminiscent of apple donuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Separate Hawaiian rolls and cut a 1/2-inch slit in the side of each one. Use a finger or the end of a spoon to create a larger opening and a space large enough to fill each roll with about 1 tablespoon filling."
    },
    {
      "position": 3,
      "text": "Roughly chop apple pie filling and add to a bowl. Stir in 1 packet apple cider mix. Spoon filling into the prepared rolls."
    },
    {
      "position": 4,
      "text": "Melt 4 tablespoons butter and brush each roll on all sides with melted butter. Place rolls on a lined baking sheet."
    },
    {
      "position": 5,
      "text": "Bake rolls in the preheated oven until lightly toasted and golden brown, 12 to 14 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, stir together remaining apple cider packet, sugar, and cinnamon in a shallow dish and melt remaining butter."
    },
    {
      "position": 7,
      "text": "Brush tops of rolls evenly with melted butter and coat each roll in sugar mixture."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

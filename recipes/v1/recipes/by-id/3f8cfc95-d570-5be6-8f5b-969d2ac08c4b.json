  "id": "3f8cfc95-d570-5be6-8f5b-969d2ac08c4b",
  "slug": "neiman-marcus-chicken-recipe-12031813",
  "name": "Neiman Marcus Chicken",
  "recipe_type": "side",
  "brief_description": "This Neiman Marcus Chicken is a rich and elegant chicken dinner filled with cheese, creamy sauce, and slivered almonds, then wrapped in bacon. Baked until crisp on the outside and tender on the inside, this dish delivers over-the-top flavor in every bite.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 10x15-inch rimmed baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Place a chicken breast on a flat work surface. Slice horizontally through the middle, being careful not to cut all the way through to the other side. Open the 2 sides and spread them out like an open book. Repeat with remaining chicken breasts; set aside."
    },
    {
      "position": 3,
      "text": "Stir together cheese, condensed soup, green onions, slivered almonds, sour cream, hot sauce and 1/2 teaspoon garlic powder in a large bowl until well combined."
    },
    {
      "position": 4,
      "text": "Stir together paprika, remaining 1/2 teaspoon garlic powder, and black pepper in a small bowl."
    },
    {
      "position": 5,
      "text": "Fill each chicken breast evenly with soup mixture. Fold chicken breasts closed and season tops evenly with paprika mixture. Wrap each chicken breast with 3 slices of bacon and place onto the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake on a center oven rack in the preheated oven until chicken is nearly cooked through and an instant-read thermometer inserted into the thickest part reads 160 degrees F (71 degrees C), about 25 minutes."
    },
    {
      "position": 7,
      "text": "Turn the oven to broil. Broil chicken breasts until bacon is browned and crisp, about 4 minutes. Top with additional green onions and serve immediately. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "slug": "orange-vinaigrette",
  "name": "Orange Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This orange vinaigrette is made with fresh orange juice, balsamic vinegar, honey, and Dijon for a sweet, tangy, oil-free salad dressing in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine orange juice, vinegar, mustard, honey, and pepper in a small jar with a lid. Cover and vigorously shake until combined."
    },
    {
      "position": 3,
      "text": "Store in the refrigerator for up to 1 week. Shake well before serving."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

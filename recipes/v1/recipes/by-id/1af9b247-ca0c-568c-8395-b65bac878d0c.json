  "id": "1af9b247-ca0c-568c-8395-b65bac878d0c",
  "slug": "onion-pasta",
  "name": "Onion Pasta",
  "recipe_type": "side",
  "brief_description": "A generous mound of thinly sliced onions, cooked in butter and olive oil, becomes a fragrant, caramelized sauce with the addition of bouillon, water and a pinch of basil. Toss with cooked pasta and sprinkle with Parmesan before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet place oil, butter and onions and cook until golden brown."
    },
    {
      "position": 2,
      "text": "Add basil, pepper, water and bouillon and cook on low heat for 10 minutes."
    },
    {
      "position": 3,
      "text": "Add onion mixture to cooked pasta, sprinkle with cheese, toss and serve."
    }
  ],

  "id": "69a210f1-b400-5e36-be59-47c915492116",
  "slug": "butternut-squash-soup",
  "name": "Butternut Squash Soup with Cream Cheese",
  "recipe_type": "soup",
  "brief_description": "This butternut squash soup with cream cheese is blended for a smooth and creamy texture. Marjoram and cayenne pepper add even more delicious flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt margarine in a large saucepan over medium-low heat. Add onion and saut\u00e9 until soft and translucent, about 5 minutes. Add butternut squash, water, bouillon, marjoram, black pepper, and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Bring to a boil over medium-high heat; reduce heat and simmer until squash is tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Pur\u00e9e squash mixture and cream cheese in a blender or food processor in batches until smooth. Return to saucepan and cook until just heated through."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

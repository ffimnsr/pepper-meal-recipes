  "id": "8e4ee21d-28ba-5b79-bf03-cca233e007b5",
  "slug": "instant-pot-popcorn",
  "name": "Instant Pot Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Make popcorn in your Instant Pot with coconut oil for movie theater flavor and zero grease splatter; season with salt or your favorite seasoning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. When the display indicates the pot is hot, add coconut oil and let it melt."
    },
    {
      "position": 2,
      "text": "Add unpopped popcorn and stir with a rubber spatula until kernels are coated. Wait 30 seconds, then stir again; kernels should be sizzling at this point. Cover the pot with the glass lid and cook for 5 minutes. Cancel Saut\u00e9 mode and let sit until kernels have completely stopped popping, about 1 minute."
    },
    {
      "position": 3,
      "text": "Transfer popped popcorn to a large serving bowl and sprinkle with salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

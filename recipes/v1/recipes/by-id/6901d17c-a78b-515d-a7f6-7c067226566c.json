  "slug": "shelia-s-chocolate-martini-recipe-8733019",
  "name": "Shelia's Chocolate Martini",
  "recipe_type": "appetizer",
  "brief_description": "Shelia’s chocolate martini definitely satisfies a sweet tooth, especially if you’re not big on dessert. It’s simple, with just a few ingredients, but delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour chocolate syrup into 2 martini glass; swirl to line the glass, and pour the extra into a cocktail shaker. Place glasses in the freezer until frosted, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Add vodka, RumChata, and milk, to the cocktail shaker. Add ice and shake until the outside of the shaker is frosted, 10 to 15 seconds. Strain into coated martini glasses and enjoy."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

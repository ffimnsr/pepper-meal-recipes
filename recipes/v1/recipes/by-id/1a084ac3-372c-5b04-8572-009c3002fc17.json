  "slug": "original-irish-cream",
  "name": "Homemade Irish Cream",
  "recipe_type": "drink",
  "brief_description": "This homemade Irish cream recipe makes a lovely liqueur with Irish whiskey, cream, and sugar with hints of coffee, chocolate, vanilla, and almond.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sweetened condensed milk, whiskey, cream, chocolate syrup, coffee granules, vanilla extract, and almond extract in a blender. Blend on high speed until well combined, 20 to 30 seconds. Store in a tightly sealed container in the refrigerator for up to 2 months."
    },
    {
      "position": 2,
      "text": "Shake well before serving."
    }
  ],
  "servings": 16,

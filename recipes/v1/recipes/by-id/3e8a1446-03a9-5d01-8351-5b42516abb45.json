  "id": "3e8a1446-03a9-5d01-8351-5b42516abb45",
  "slug": "spicy-mezcal-margarita",
  "name": "Spicy Mezcal Margarita",
  "recipe_type": "drink",
  "brief_description": "This spicy mezcal margarita combines smoky mezcal and spicy jalape\u00f1os with orange and lime juice for a deliciously refreshing margarita with a kick.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1 tablespoon sugar with salt on a small shallow plate. Moisten rims of two 8-inch glasses with a wedge of lime, dip the moistened glass rims into sugar mixture. Fill the glasses with ice, if desired."
    },
    {
      "position": 2,
      "text": "Place jalape\u00f1o and 1 1/2 teaspoons sugar in a cocktail shaker and mash with a cocktail muddler until sugar dissolved and jalape\u00f1o juiced. Pour in orange juice, mezcal, and lime juice; fill with ice. Cover and shake until the outside of the shaker has frosted, about 30 seconds. Strain into the prepared glasses."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

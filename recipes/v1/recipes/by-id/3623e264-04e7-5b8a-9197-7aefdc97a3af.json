  "slug": "bethys-cucumber-basil-lemonade",
  "name": "Bethy's Cucumber Basil Lemonade",
  "recipe_type": "drink",
  "brief_description": "Bethy's easy cucumber and fresh basil lemonade recipe is a refreshing change on the usual summertime beverage. It's a perfect refreshment at picnics.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1 cup cold water and sugar in a small saucepan; bring to a boil. Cook and stir until sugar is dissolved, about 5 minutes. Cool simple syrup to room temperature."
    },
    {
      "position": 2,
      "text": "Combine simple syrup, remaining 7 cups cold water, lemon juice, cucumber, and basil in a pitcher; chill in the refrigerator before serving, at least 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

  "id": "eaed7a70-3b2b-517f-a2d4-5481fc3a066d",
  "slug": "banana-bread-baked-oatmeal-recipe-11880277",
  "name": "Banana Bread Baked Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "This banana bread baked oatmeal takes only minutes to put together before baking in the oven. Works both as a sit down breakfast or as a grab and go.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 9x9-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir together rolled oats, baking powder, cinnamon, and salt in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Mash bananas in a large bowl until smooth. Whisk in milk, eggs, maple syrup, brown sugar, and vanilla extract until well combined."
    },
    {
      "position": 4,
      "text": "Add oat mixture to banana mixture and stir until evenly blended. Pour batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and set, 35 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Transfer the pan to a wire rack and cool completely, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Cut into 9 bars. Serve and enjoy!"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

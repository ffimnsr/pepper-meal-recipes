{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e5d94653-7c79-5769-bd74-0e49fe8769ff",
  "slug": "cacio-e-pepe-taralli-savory-italian-pretzels",
  "name": "Cacio e Pepe Taralli (Savory Italian Pretzels)",
  "recipe_type": "appetizer",
  "brief_description": "Crispy rings of peppery, white wine-infused dough form Chef John's cheese-encrusted take on taralli, a classic Italian snack.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, pepper, and salt in a mixing bowl, and stir with a spoon to combine. Pour in wine and olive oil. Mix until dough starts to come together. Knead by hand until dough is smooth and slightly elastic, about 3 minutes. Wrap dough in plastic and let rest at room temperature for 30 minutes."
    },
    {
      "position": 2,
      "text": "Unwrap dough and cut into 4 pieces. Roll each piece out with your palms into ropes about 10 to 12 inches long. Cut each rope into 3 pieces; roll each piece to a length of 5 or 6 inches. Twist the ends a few times and press them together to form a ring, twisting as needed to fully seal the ends."
    },
    {
      "position": 3,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with a silicone mat (such as SILPAT\u00ae)."
    },
    {
      "position": 4,
      "text": "Bring a pan of water (at least 3 inches) to a boil. Drop in 4 rings of dough at a time. Boil until rings float to the top, 3 to 5 minutes. Remove with a slotted spoon onto a towel-lined plate. Transfer to the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Sprinkle Parmigiano-Reggiano cheese over each ring; flip and grate more cheese on the other side. Flip back to the first side and apply one last grating of cheese, or until rings are thoroughly coated."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly golden and crunchy, 25 to 30 minutes. Remove from the baking sheet onto a wire rack and let cool completely before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

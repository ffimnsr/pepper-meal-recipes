  "id": "374a5106-7b82-5e1e-9b70-5670ff41469f",
  "slug": "cranberry-red-wine-relish",
  "name": "Cranberry Red Wine Relish",
  "recipe_type": "side",
  "brief_description": "This cranberry red wine relish recipe requires only 5 ingredients: cranberries, red wine, sugar, orange zest, and cinnamon. It's a tasty, colorful relish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar and red wine in a medium saucepan; bring to a boil over medium heat. Add cranberries, orange zest, and cinnamon stick. Bring back to a boil, reduce heat, and simmer, stirring often, until most cranberries have burst, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, inspect six 4-ounce jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until relish is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 3,
      "text": "Remove relish from heat; cool slightly. Pack relish into hot, sterilized jars. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly. Store in the refrigerator."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

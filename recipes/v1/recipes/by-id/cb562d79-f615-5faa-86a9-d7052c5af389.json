  "id": "cb562d79-f615-5faa-86a9-d7052c5af389",
  "slug": "grandmas-banana-bread",
  "name": "Grandma's Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "If you're looking for a sweet banana bread, this recipe is for you.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the sugar and margarine until light and fluffy. Stir in the eggs one at a time, beating well with each addition, then stir in the vanilla."
    },
    {
      "position": 3,
      "text": "In a large bowl, sift together flour, baking soda and salt. Blend this mixture into the egg mixture, alternately with the buttermilk; stir just to combine. Fold in the mashed bananas; mixing just enough to evenly combine. Pour batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until a toothpick inserted into center of the loaf comes our clean, about 60 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "28a738ab-a88c-52fb-901b-8604249ab9d8",
  "slug": "cranberry-lemon-bars-recipe-8399101",
  "name": "Cranberry Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "These three-layer cranberry lemon bars are so good, you'll want to load up the freezer with fresh cranberries during the holiday season so that you can make them all year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease an 8x8-inch pan or line with parchment paper on the bottom, leaving a little overhang to easily remove bars."
    },
    {
      "position": 2,
      "text": "Stir melted butter, 3 tablespoons sugar, almond extract, and salt together in a bowl. Add flour, and mix until well incorporated. Press dough mixture into the prepared pan in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges start to turn a light brown, 15 to 20 minutes. Remove from the oven, and set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine cranberries, 1/4 cup sugar, water, and 1 1/2 tablespoons lemon zest in a small saucepan. Cook over medium heat, stirring often. Once cranberries start to pop, mash down with the back of a spoon, until cranberries break down into a smooth consistency, 9 to 12 minutes. Set aside."
    },
    {
      "position": 5,
      "text": "Whisk eggs, 3/4 cup sugar, lemon juice, flour, and 1 tablespoon lemon zest in a bowl until well combined."
    },
    {
      "position": 6,
      "text": "To assemble, spread the cranberry mixture evenly over the crust, and pour the lemon layer mixture over the cranberry layer."
    },
    {
      "position": 7,
      "text": "Return to the oven and bake until filling is set, 20 to 25 minutes."
    },
    {
      "position": 8,
      "text": "Cool completely in the pan, and run a knife around the pan edges. Cut into squares and dust with confectioners sugar right before serving. Store leftovers in an airtight container."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

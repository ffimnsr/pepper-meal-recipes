  "id": "46e52e50-f599-53e5-bc61-13c7805d8d6b",
  "slug": "crescent-roll-pretzels",
  "name": "Crescent Roll Pretzels",
  "recipe_type": null,
  "brief_description": "These quickand easy pretzels are made with premade crescent roll dough.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper and set aside."
    },
    {
      "position": 2,
      "text": "Combine 8 cups water and baking soda in a large pot and bring to a rolling boil over high heat. Once boiling, reduce heat and keep water at a simmer."
    },
    {
      "position": 3,
      "text": "Start at the large end and roll each crescent roll triangle into a large rope, about 12 inches long. Form rope into the shape of a pretzel."
    },
    {
      "position": 4,
      "text": "Using a spider strainer, lower 1 pretzel at a time into the simmering water for 7 to 8 seconds. Place pretzels on parchment lined baking sheet. Combine egg and 1 tablespoon water in a small bowl. Brush each pretzel with egg mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 12 to 14 minutes."
    },
    {
      "position": 6,
      "text": "Remove from oven. Brush each pretzel with melted butter and sprinkle with coarse salt while still hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 15,

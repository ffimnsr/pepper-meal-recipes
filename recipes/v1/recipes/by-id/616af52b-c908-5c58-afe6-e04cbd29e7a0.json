  "id": "616af52b-c908-5c58-afe6-e04cbd29e7a0",
  "slug": "apple-raisin-french-toast-strata",
  "name": "Apple Raisin French Toast Strata",
  "recipe_type": "breakfast",
  "brief_description": "This apple raisin French toast strata recipe is a breakfast casserole with cinnamon raisin bread, cream cheese, apples, half-and-half, and maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Place \u00bd raisin bread in the prepared dish; sprinkle cream cheese evenly over top. Top with apples, then top with remaining \u00bd bread."
    },
    {
      "position": 3,
      "text": "Beat half-and-half, eggs, butter, and maple syrup together in a large bowl; pour over bread mixture. Cover with plastic wrap; press down so all bread pieces are soaked. Refrigerate at least 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 45 minutes. Let stand before serving for 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

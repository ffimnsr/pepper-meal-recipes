  "id": "0ff6c6d4-ab7f-55a4-81c1-0bbcc8b19f70",
  "slug": "pineapple-upside-down-cheesecake",
  "name": "Pineapple Upside-Down Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This pineapple upside-down cheesecake recipe is a delicious combination of two classic desserts. The creamy cheesecake pairs well with fruity pineapple.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix 2 tablespoons butter and brown sugar together in a 9-inch round cake pan until blended; spread mixture to evenly cover the bottom of the pan. Top with pineapple slices, then place one cherry into the center of each slice."
    },
    {
      "position": 3,
      "text": "Mix graham cracker crumbs, 3 tablespoons white sugar, and remaining 3 tablespoons melted butter together in a small bowl until well combined. Press mixture over pineapple slices."
    },
    {
      "position": 4,
      "text": "Beat cream cheese and 3/4 cup white sugar in a bowl until blended. Add sour cream and vanilla; mix well. Add eggs, one at a time, mixing on low speed after each addition until blended. Pour batter into the cake pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the center is almost set, 55 minutes to 1 hour. Remove from the oven."
    },
    {
      "position": 6,
      "text": "Run a knife around the inside edge of the pan to loosen. Allow to cool completely, about 30 minutes. Invert onto a serving plate and refrigerate for at least 3 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

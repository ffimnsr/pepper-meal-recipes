  "id": "0d0f936d-f853-50c2-b520-4c583e4f8ef8",
  "slug": "quick-pickled-spicy-asparagus",
  "name": "Quick-Pickled Spicy Asparagus",
  "recipe_type": "appetizer",
  "brief_description": "This homemade pickled spicy asparagus recipe infuses fresh asparagus spears with spicy flavor from crushed red pepper, garlic, and mustard seed.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place trimmed asparagus in a quart-sized canning jar. Add garlic, pepper flakes, mustard seed, and peppercorns."
    },
    {
      "position": 2,
      "text": "Combine vinegar, water, salt, and sugar in a medium saucepan over medium heat; bring to a boil. Reduce heat and simmer for 5 minutes. Turn heat off."
    },
    {
      "position": 3,
      "text": "Pour vinegar mixture over the asparagus. Screw on the lid and let sit until lid has sealed, about 1 hour."
    },
    {
      "position": 4,
      "text": "Place in the refrigerator until pickled, at least 2 days."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "2c6e1e7e-0404-5d5a-9ced-7398a3f12341",
  "slug": "pumpkin-french-toast",
  "name": "Pumpkin French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Kids won't even notice the whole wheat bread in this cinnamon- and nutmeg-flavored six-ingredient pumpkin French toast recipe with canned pumpkin pur\u00e9e.",
  "cuisine": "French Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs, pumpkin pur\u00e9e, cinnamon, and nutmeg together in a shallow bowl. Dip bread slices into pumpkin mixture until coated on both sides."
    },
    {
      "position": 2,
      "text": "Melt 1 teaspoon butter in a large skillet over medium-high heat. Cook 4 bread slices in the skillet until browned on both sides, about 3 minutes per side. Repeat with remaining butter and bread."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

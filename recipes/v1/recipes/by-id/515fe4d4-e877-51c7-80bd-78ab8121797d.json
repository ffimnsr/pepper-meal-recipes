  "id": "515fe4d4-e877-51c7-80bd-78ab8121797d",
  "slug": "quesadilla-salvadorena",
  "name": "Quesadilla Salvadore\u00f1a",
  "recipe_type": "dessert",
  "brief_description": "Quesadilla Salvadore\u00f1a is a sesame seed-topped sweet bread made with Parmesan cheese that's commonly served with coffee for breakfast or as a snack.",
  "cuisine": "Salvadoran American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until firm but not stiff."
    },
    {
      "position": 4,
      "text": "Combine sugar and melted butter in a large bowl; beat on high speed until creamy."
    },
    {
      "position": 5,
      "text": "Mix in egg yolks until well blended."
    },
    {
      "position": 6,
      "text": "Gradually mix in Parmesan cheese. Add sour cream and baking powder; beat until batter is smooth."
    },
    {
      "position": 7,
      "text": "Sift rice flour over batter, then fold it in with a spatula. Fold in egg whites."
    },
    {
      "position": 8,
      "text": "Pour batter into a 9x13-inch glass baking dish. Sprinkle sesame seeds on top."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until golden brown on top and a toothpick inserted into the center comes out clean, about 38 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

  "id": "ba17a903-79ff-5923-a5d6-382c7e797ddb",
  "slug": "steves-famous-garlic-home-fries",
  "name": "Steve's Famous Garlic Home Fries",
  "recipe_type": "breakfast",
  "brief_description": "Steve's famous garlic home fries recipe cooks potatoes in butter, seasons them with garlic, paprika, salt, pepper, and chives, and yields lots of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium heat. Add potatoes in an even layer; cover and cook for 5 minutes."
    },
    {
      "position": 2,
      "text": "Season with garlic, paprika, salt, and black pepper; stir to coat. Cover; cook 15 minutes more, flipping potatoes occasionally. Stir in chives."
    },
    {
      "position": 3,
      "text": "Increase heat to medium-high; cook until potatoes are tender, about 10 minutes more, stirring frequently."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,

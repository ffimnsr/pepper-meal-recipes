  "id": "bae0263c-db73-5081-9863-6f5ce24c2926",
  "slug": "choux-pastry-recipe-7484640",
  "name": "Choux Pastry",
  "recipe_type": "dessert",
  "brief_description": "Choux pastry is a light, delicate pastry dough made with butter, hot water, flour, and eggs that steams and puffs up in the oven; perfect for profiteroles!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water, butter, sugar, and salt in a medium saucepan over medium heat; cook until butter has melted and mixture comes to a boil."
    },
    {
      "position": 3,
      "text": "Add flour all at once; stir vigorously with a wooden spoon over medium-low heat until mixture forms a ball and the saucepan is coated in a light film of flour, about 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove the pan from heat and let cool for 10 minutes."
    },
    {
      "position": 5,
      "text": "Beat in eggs, one at a time, with the wooden spoon until the mixture forms a sticky dough with a pipeable consistency."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "bdb50dcc-7c52-5c70-93c0-c8b7853c2942",
  "slug": "chef-john-s-chocolate-chip-pumpkin-bread-recipe-7970341",
  "name": "Chef John's Chocolate Chip Pumpkin Bread",
  "recipe_type": "dessert",
  "brief_description": "This chocolate chip pumpkin bread is one of the lightest, moistest, most flavorful pumpkin breads ever, and probably the easiest.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Butter a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Whisk flour, salt, baking soda, cinnamon, ginger, cloves, and nutmeg together in a bowl."
    },
    {
      "position": 3,
      "text": "In another bowl, combine pumpkin, white sugar, brown sugar, vegetable oil, milk, and eggs. Whisk together until smooth."
    },
    {
      "position": 4,
      "text": "Add the flour mixture, and whisk in gently until the flour almost disappears. Stir in the chocolate chips and pumpkin seeds until evenly distributed."
    },
    {
      "position": 5,
      "text": "Use a spatula to transfer batter into the prepared loaf pan. Tap the pan on the table a few times to bring air bubbles to the surface."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick or wooden skewer inserted near the center comes out clean, 60 to 70 minutes."
    },
    {
      "position": 7,
      "text": "Let cool in the pan about 45 minutes; remove to a wire rack to cool completely before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

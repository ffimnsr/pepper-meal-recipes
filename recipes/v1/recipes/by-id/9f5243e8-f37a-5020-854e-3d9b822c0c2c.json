  "id": "9f5243e8-f37a-5020-854e-3d9b822c0c2c",
  "slug": "best-football-dip-ever",
  "name": "Best Football Dip Ever",
  "recipe_type": "appetizer",
  "brief_description": "This meaty, cheesy dip is perfect for a small group gathered to watch Sunday football\u2014it\u2019s hearty, crowd-pleasing, and never lasts long!",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place the ground beef in a large skillet over medium-high heat. Cook, stirring to crumble, until no longer pink. Drain off grease."
    },
    {
      "position": 3,
      "text": "Spread the cream cheese in an even layer in the bottom of a 9-inch square baking dish. Spread a layer of salsa over the cream cheese, then cover with a layer of ground beef. Top with slices of processed cheese and cover the dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake for 15 minutes in the preheated oven, or until heated through. Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

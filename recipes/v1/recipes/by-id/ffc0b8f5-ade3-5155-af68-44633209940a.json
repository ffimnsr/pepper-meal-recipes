  "id": "ffc0b8f5-ade3-5155-af68-44633209940a",
  "slug": "beer-marinated-deer-jerky",
  "name": "Beer-Marinated Deer Jerky",
  "recipe_type": "appetizer",
  "brief_description": "For this recipe, lean deer meat is marinated overnight in beer to develop deep flavors and then dehydrated to become jerky. It's worth the time to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim and discard any fat or gristle from venison."
    },
    {
      "position": 2,
      "text": "Combine beer, soy sauce, Worcestershire sauce, salt, garlic, curry powder, black pepper, and ginger in a medium stainless steel bowl; add venison and toss to evenly coat. Cover the bowl with plastic wrap; marinate in the refrigerator 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Remove venison from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 4,
      "text": "Place venison on the racks of a dehydrator leaving room for air to circulate."
    },
    {
      "position": 5,
      "text": "Dehydrate venison according to manufacturer's instructions until reaches desired consistency, 6 to 8 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

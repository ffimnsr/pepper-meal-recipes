  "id": "8cf77a80-ea15-5c4a-a263-5341dd0d0c47",
  "slug": "delicious-cinnamon-baked-apples",
  "name": "Delicious Baked Apples",
  "recipe_type": "dessert",
  "brief_description": "Juicy baked apples flavored with brown sugar, cinnamon, and nutmeg make a deliciously sweet and easy fall dessert to serve warm with ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large baking dish with butter."
    },
    {
      "position": 2,
      "text": "Mix brown sugar, vanilla sugar, cinnamon, and nutmeg in a small bowl."
    },
    {
      "position": 3,
      "text": "Layer about 1/3 of the apples in the prepared baking dish; sprinkle with 1/3 of the sugar mixture."
    },
    {
      "position": 4,
      "text": "Repeat layers twice more."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for 30 minutes. Pour water over apples and continue baking until tender, about 15 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "570a7182-3532-5a5a-b435-86f740eb780b",
  "slug": "evacuation-tuna-pasta-salad",
  "name": "Evacuation Tuna & Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Living on the coast we are sometimes forced to evacuate during hurricane season. Put this pasta salad in a covered container, and throw it in the cooler. It's a full meal in one bowl. It's easy to serve. Spoon it up into a cup and eat it in the car, camper, or in our case, a motel room! That's why we call it Evacuation Tuna & Pasta Salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain and cool."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine pasta, eggs, tuna Cheddar cheese, celery, onion, roasted red pepper, and lima beans. Whisk together mayonnaise, lemon juice, and paprika. Season with salt. Pour dressing over pasta mixture, and mix together."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

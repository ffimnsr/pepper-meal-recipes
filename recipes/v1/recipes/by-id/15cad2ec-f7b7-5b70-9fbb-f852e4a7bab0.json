  "id": "15cad2ec-f7b7-5b70-9fbb-f852e4a7bab0",
  "slug": "snickerdoodles-iii",
  "name": "Snickerdoodles III",
  "recipe_type": "dessert",
  "brief_description": "This simple and quick recipe delivers a soft sugar cookie with a cinnamon-sugar topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (205 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 1 1/2 cups white sugar, butter or margarine, vanilla and eggs. Mix well."
    },
    {
      "position": 3,
      "text": "Stir in flour, cream of tartar, baking soda and salt. Blend well. Shape dough into 1 inch balls. Combine 2 tablespoons sugar and 2 teaspoons ground cinnamon. Roll dough in sugar/cinnamon mixture and place 2 inches apart on ungreased baking sheets. Bake 8 to 10 minutes or until set. Immediately remove from cookie sheets."
    }
  ],
  "servings": 24,

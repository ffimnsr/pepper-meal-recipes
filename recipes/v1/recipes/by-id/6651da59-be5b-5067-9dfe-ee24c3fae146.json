  "id": "6651da59-be5b-5067-9dfe-ee24c3fae146",
  "slug": "jalapeno-popper-twists-recipe-11736107",
  "name": "Jalapeno Popper Twists",
  "recipe_type": "appetizer",
  "brief_description": "These jalapeno popper twists are made from puff pastry sheets filled with bacon, cream cheese, Cheddar, and jalapenos, sliced into strips, twisted, and baked. This appetizer is a delicious 'twist' on your favorite poppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Chop bacon when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Lightly flour a work surface, and roll out each pastry sheet until folds are smoothed out."
    },
    {
      "position": 4,
      "text": "Place one pastry puff sheet on the prepared baking sheet. Spread cream cheese in a thin layer over pastry; sprinkle with 2/3 shredded Cheddar, half the bacon and half the jalapenos."
    },
    {
      "position": 5,
      "text": "Place second sheet of pastry on top, aligning the edges. Using a sharp knife or pizza cutter, cut the assembled pastry in half lengthwise, then cut into 1.5-inch strips crosswise."
    },
    {
      "position": 6,
      "text": "Brush pastry with beaten egg using a pastry brush. Twist each strip; touch up each twist with more egg wash as needed. Space twists out on the baking sheet; sprinkle with remaining Cheddar cheese, bacon, and jalapenos."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until puffed and golden brown, 12 to 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

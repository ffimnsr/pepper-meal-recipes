{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0f0d5df4-599f-5771-a84f-e9841058fd4d",
  "slug": "hibachi-chicken-noodles-with-yum-yum-sauce-recipe-11885825",
  "name": "Hibachi Chicken Noodles with Yum Yum Sauce",
  "recipe_type": "side",
  "brief_description": "Hibachi Chicken Noodles with Yum Yum Sauce bring the bold, savory flavors of your favorite Japanese steakhouse right to your kitchen in just 40 minutes. Tender chicken, saucy noodles, and crisp broccoli are tossed together and finished with homemade Yum Yum sauce for a comforting, takeout-style meal the whole family will love.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together mayonnaise, Sriracha, ketchup, rice vinegar, sugar, garlic powder, and salt for the Yum Yum Sauce in a small bowl until smooth and well combined. Cover and refrigerate until ready to use."
    },
    {
      "position": 2,
      "text": "Whisk together soy sauce, brown sugar, sesame oil, water, and garlic in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Bring a large saucepan of water to a boil over medium-high heat. Add yakisoba noodles and cook for 1 minute. Drain and set aside to cool slightly."
    },
    {
      "position": 4,
      "text": "Heat oil in a wok or large skillet over medium-high heat. Add broccoli and cook until softened and lightly browned, 3 to 4 minutes. Remove from wok using a slotted spoon and set aside."
    },
    {
      "position": 5,
      "text": "Add butter to the wok. When melted, add chicken in a single layer, working in two batches if necessary. Cook until lightly browned on all sides and cooked through (an instant-read thermometer inserted into the thickest part should read at least 165 degrees F (74 degrees C)), about 5 minutes per batch."
    },
    {
      "position": 6,
      "text": "Pour in soy sauce mixture. Let mixture come to a simmer, and cook until sauce has slightly thickened, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Add broccoli and noodles to the wok. Toss until everything is evenly coated in sauce and heated through."
    },
    {
      "position": 8,
      "text": "Garnish with green onions and sesame seeds. Serve with Yum Yum sauce. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

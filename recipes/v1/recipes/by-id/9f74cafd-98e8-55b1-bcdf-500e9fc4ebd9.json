  "id": "9f74cafd-98e8-55b1-bcdf-500e9fc4ebd9",
  "slug": "southern-style-collard-greens",
  "name": "Southern-Style Collard Greens",
  "recipe_type": "soup",
  "brief_description": "Collard greens are simmered with smoked ham hocks, garlic, and onions in broth until tender for a classic southern side dish loaded with flavor.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine onions, ham hocks, and garlic in a stockpot; add chicken broth and simmer over medium heat until meat is falling off the bone, 1 to 2 hours."
    },
    {
      "position": 3,
      "text": "Stir collard greens, vinegar, sugar, salt, and pepper into the broth mixture; cook until greens have reached desired tenderness, about 2 hours."
    },
    {
      "position": 4,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 10,

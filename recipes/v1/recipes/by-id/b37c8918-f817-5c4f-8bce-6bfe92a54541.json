  "id": "b37c8918-f817-5c4f-8bce-6bfe92a54541",
  "slug": "the-best-swamp-soup-recipe-11796972",
  "name": "The Best Swamp Soup",
  "recipe_type": "soup",
  "brief_description": "The best swamp soup is made with beans, greens, tomatoes with green chiles, and delicious Southern smoked sausage. It's a hearty soup, quick to assemble, and budget-friendly.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium-high heat and add sausage. Cook, stirring often, until sausage is browned and fat has rendered out, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add onion and peppers and cook, stirring constantly until onion softens, about 4 minutes. Add potatoes and cook, stirring often, 2 minutes. Add turnip greens, Hoppin' John, diced tomatoes and green chiles, navy beans, water, and bouillon paste; stir to combine."
    },
    {
      "position": 3,
      "text": "Bring mixture to a boil, cover, reduce heat and simmer until potatoes are tender, 25 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

  "id": "8033a15b-7d94-5365-a36c-8572ed8fa1b4",
  "slug": "greek-chicken",
  "name": "Greek Chicken",
  "recipe_type": "main",
  "brief_description": "This Greek chicken recipe includes a lemon and garlic marinade with fresh oregano for an easy grilled chicken dish that's big on Greek flavor.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Mix olive oil, lemon juice, garlic, rosemary, thyme, and oregano in a glass dish. Place chicken pieces in the mixture; cover and marinate in the refrigerator for 2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Place chicken on the grill, and discard the marinade. Cook until chicken is no longer pink at the bone and the juices run clear, about 15 minutes per side (smaller pieces will not take as long). An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cd7bb3cf-5b83-57f6-8f7a-61573f039d98",
  "slug": "pecan-sour-cream-pound-cake",
  "name": "Pecan Sour Cream Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "A rich and delicious sour cream pound cake is baked in a Bundt pan lined with chopped pecans.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease and flour a 10-inch Bundt or tube pan."
    },
    {
      "position": 2,
      "text": "Sprinkle pecans in bottom of prepared pan; set aside. Sift flour, salt, and baking soda together in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat white sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Beat in 1 teaspoon vanilla. Add flour mixture, alternately, with sour cream. Pour batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 75 to 90 minutes. Cool on a wire rack for 20 minutes. Tap the pan firmly a few times, then shake it gently to loosen the cake. Place a wire rack over the pan and invert to release cake onto the rack; cool completely."
    },
    {
      "position": 5,
      "text": "Combine confectioners' sugar, orange juice, and remaining 1 teaspoon vanilla in a small bowl. Drizzle glaze over cake while still warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

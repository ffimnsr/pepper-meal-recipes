  "id": "5f96f8be-d3ae-5ca7-82f3-cd5ce78fd2c9",
  "slug": "classic-vichyssoise",
  "name": "Classic Vichyssoise",
  "recipe_type": "soup",
  "brief_description": "This vichyssoise recipe is a thick soup made with boiled leeks, onions, potatoes, and herbs blended until smooth and mixed with cream before serving.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large stockpot over low heat. Add leeks and onion; cover and cook for 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in potatoes; season with salt and pepper. Add marjoram, thyme, and bay leaf; stir well. Cover and cook for 12 minutes."
    },
    {
      "position": 4,
      "text": "Pour in chicken broth. Bring to a boil, reduce heat, and cook, partially covered, for 30 minutes."
    },
    {
      "position": 5,
      "text": "Pur\u00e9e soup in a blender or food processor. Allow to cool to room temperature, then stir in cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4cdb9409-6abc-51dd-b563-244442e24bed",
  "slug": "slow-cooker-beef-bourguignon",
  "name": "Slow Cooker Beef Bourguignon",
  "recipe_type": "soup",
  "brief_description": "This slow cooker beef bourguignon is simmered with onions, red wine, carrots, thyme, and bay leaf for a rich stew filled with tender chunks of meat.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter and oil in a large skillet over medium-high heat. Add beef and cook, stirring occasionally, until browned on all sides, 5 to 8 minutes. Brown beef in batches if necessary, making sure not to overcrowd the pan; otherwise, beef will not brown properly. Remove browned beef to the slow cooker."
    },
    {
      "position": 2,
      "text": "Add onions to the same skillet. Cook and stir until softened and beginning to take some color, 3 to 5 minutes. Transfer onions to the slow cooker."
    },
    {
      "position": 3,
      "text": "Place the skillet back over medium-high heat and pour in 1/2 of the wine. Bring to a simmer, scraping up any browned bits from the bottom of the pan with a wooden spoon. Remove from heat and carefully pour into the slow cooker along with remaining wine. Add carrots, thyme, bay leaves, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Cook on Low for 6 to 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 385,
  "preparation_time_minutes": 15,

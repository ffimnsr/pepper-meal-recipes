  "id": "ac8d8db2-03cf-5f92-8224-1257e413dd8a",
  "slug": "zucchini-pizza-bites",
  "name": "Zucchini Pizza Bites",
  "recipe_type": "appetizer",
  "brief_description": "These low-carb zucchini pizza bites are easy to make with zucchini slices, pepperoni, pizza sauce, and mozzarella for a warm and gooey cheesy treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Spread zucchini slices in 1 layer on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until zucchini is tender, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Spoon pizza sauce over each zucchini slice and top with pepperoni and mozzarella cheese. Sprinkle herbs over each."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

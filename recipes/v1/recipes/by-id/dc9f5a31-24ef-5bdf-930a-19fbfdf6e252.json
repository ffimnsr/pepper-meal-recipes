  "id": "dc9f5a31-24ef-5bdf-930a-19fbfdf6e252",
  "slug": "japanese-style-cabbage-salad",
  "name": "Japanese-Style Cabbage Salad",
  "recipe_type": "salad",
  "brief_description": "This Japanese-style cabbage salad is a healthy slaw with green onion and almonds tossed in a sweet dressing of sesame oil, rice vinegar, and ginger.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cabbage, green onions, almond, and sesame seeds in a large bowl."
    },
    {
      "position": 2,
      "text": "Make dressing: Whisk together sesame oil, vinegar, sugar, garlic, ginger, salt, and pepper in a small bowl until sugar is dissolved."
    },
    {
      "position": 3,
      "text": "Pour dressing over cabbage mixture and toss until well combined."
    }
  ],

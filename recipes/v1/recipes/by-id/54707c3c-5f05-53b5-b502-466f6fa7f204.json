  "id": "54707c3c-5f05-53b5-b502-466f6fa7f204",
  "slug": "healthier-monkey-bread-i",
  "name": "Healthier Monkey Bread I",
  "recipe_type": "appetizer",
  "brief_description": "Kids and adults alike will appreciate this healthier version of monkey bread. Made with less sugar, butter instead of margarine, and whole wheat pizza dough instead of biscuit dough, this treat is still full of taste.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Mix white sugar and cinnamon in a plastic bag. Cut pizza dough into 1 1/2-inch pieces. Shake 6 to 8 pieces of dough in the sugar-cinnamon mix. Arrange pieces in bottom of prepared pan. Continue until all dough pieces are coated and placed in pan. Arrange nuts and raisins in and among dough pieces."
    },
    {
      "position": 3,
      "text": "Melt butter and brown sugar in a small saucepan over medium heat. Boil for 1 minute. Pour over dough; let rise for 30 minutes."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until bread is golden brown, about 35 minutes. Let bread cool in pan for 10 minutes, then turn out onto a plate. Pull apart pieces of bread to eat."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

  "id": "5f00ae36-df60-57ef-b6eb-624cdb7d7ef4",
  "slug": "spicy-ramen-stuffed-jalapenos",
  "name": "Spicy Ramen-Stuffed Jalapenos",
  "recipe_type": "appetizer",
  "brief_description": "These jalapenos are stuffed with a spicy ramen noodle and cream cheese mixture and wrapped in bacon. Great as an appetizer for a party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with foil and place a rack on top."
    },
    {
      "position": 2,
      "text": "Roughly chop the cooked ramen noodles. Set aside."
    },
    {
      "position": 3,
      "text": "Mix cream cheese, mozzarella, ginger paste, garlic paste, pepper flakes, and salt together in a bowl."
    },
    {
      "position": 4,
      "text": "Hollow out jalapenos and remove seeds. Stuff each jalapeno evenly with cream cheese mixture. Wrap each with one slice of bacon. Lay the jalapenos on top of the baking sheet rack."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bacon is browned and crisp, 30 to 45 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

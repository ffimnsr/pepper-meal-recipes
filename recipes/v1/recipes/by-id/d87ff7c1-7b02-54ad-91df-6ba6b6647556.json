  "id": "d87ff7c1-7b02-54ad-91df-6ba6b6647556",
  "slug": "curried-squash-mushroom-soup",
  "name": "Curried Squash-Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "This flavorful and nutritious curried butternut squash-mushroom soup recipe is creamy, rich, and just like your grandmother used to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place squash halves on a microwave-safe plate; microwave for 10 minutes. Remove and discard peel and seeds. Place cooked squash flesh in a food processor; pur\u00e9e."
    },
    {
      "position": 2,
      "text": "Melt margarine in a large saucepan over medium-high heat. Add mushrooms and onion; cook 1 to 2 minutes. Stir in flour and curry powder; cook 5 minutes. Gradually stir in chicken stock and wine; cook until smooth and slightly thickened, about 5 minutes. Whisk in cooked squash, honey, and nutmeg; reduce heat and simmer 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir cream into soup; reheat if necessary."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

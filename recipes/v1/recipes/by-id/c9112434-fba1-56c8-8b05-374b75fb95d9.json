  "id": "c9112434-fba1-56c8-8b05-374b75fb95d9",
  "slug": "turkey-burgers-with-rice-krispies-recipe-7969063",
  "name": "Turkey Burgers with Rice Krispies",
  "recipe_type": "main",
  "brief_description": "These grilled turkey burgers with Rice Krispies are light and moist, and use Rice Krispies as a binder instead of breadcrumbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine turkey, Rice Krispies, zucchini, onion, Dijon, tarragon, garlic salt, and black pepper in a bowl. Gently mix with a fork or your hands until just combined."
    },
    {
      "position": 2,
      "text": "Divide the meat into 4 equal portions, shape into patties, and move to the freezer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium high heat, and lightly oil the grate. Remove burgers from the freezer, and place on the grill. Cook over direct heat until no longer pink in the center and the juices run clear, 4 to 5 minutes per side. An instant-read thermometer inserted near the center of burgers should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Place the turkey burgers on the buns, add toppings as desired, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 10,

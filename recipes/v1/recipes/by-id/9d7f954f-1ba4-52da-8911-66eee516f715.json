  "id": "9d7f954f-1ba4-52da-8911-66eee516f715",
  "slug": "chunky-monkey-bars-recipe-11884770",
  "name": "Chunky Monkey Bars",
  "recipe_type": "dessert",
  "brief_description": "Chunky Monkey Bars are soft, banana-packed dessert bars loaded with melty chocolate chunks and crunchy toasted walnuts - and your house will smell incredible while they bake! Perfect for sharing, these easy-to-make treats deliver classic banana bread flavor in a rich, bar-style bite that\u2019s great for parties, potlucks, or snacking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 10x15x1-inch baking pan."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking soda, and salt in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat brown sugar, butter, and granulated sugar in a large bowl with an electric mixer until smooth and creamy."
    },
    {
      "position": 4,
      "text": "Add eggs 1 at a time, beating well after each addition. Mix in mashed bananas, sour cream, and vanilla until well combined."
    },
    {
      "position": 5,
      "text": "Gradually add the flour mixture to the batter, stirring just until combined."
    },
    {
      "position": 6,
      "text": "Fold in 1 1/4 cups chocolate chunks and 1/2 cup chopped walnuts."
    },
    {
      "position": 7,
      "text": "Spread batter evenly into the prepared pan."
    },
    {
      "position": 8,
      "text": "Top with the remaining 1/4 cup chocolate chunks and 1/4 cup chopped walnuts."
    },
    {
      "position": 9,
      "text": "Bake until a toothpick inserted into the center comes out clean, 20 to 25 minutes."
    },
    {
      "position": 10,
      "text": "Cool completely in the pan on a wire rack, about 30 minutes. Cut into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "27a87ae0-8804-5d95-9db5-014e64114610",
  "slug": "vegan-sloppy-joes",
  "name": "Vegan Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "Just because you're vegan doesn't mean you can't enjoy a Sloppy Joe sandwich--this meatless version will bring back fond childhood memories while keeping you on a plant-based diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add onion and cook until soft and translucent, about 5 minutes. Add meatless grounds and break up the clumps with a spoon until crumbly. Cook until browned and heated through, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to low. Add ketchup, brown sugar, apple cider vinegar, ground mustard, dill, and pepper. Mix well, cover, and let simmer until heated through, 3 to 4 minutes. Adjust seasonings if necessary."
    },
    {
      "position": 3,
      "text": "Serve on hamburger buns."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

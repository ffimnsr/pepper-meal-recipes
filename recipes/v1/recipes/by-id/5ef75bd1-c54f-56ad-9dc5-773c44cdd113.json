  "id": "5ef75bd1-c54f-56ad-9dc5-773c44cdd113",
  "slug": "brennans-irish-soda-bread",
  "name": "Brennan's Irish Soda Bread",
  "recipe_type": "breakfast",
  "brief_description": "This soda bread is made with soured milk, flour, and baking soda for a quick bread with a tender crumb that's always a favorite.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Stir milk and vinegar together in a small bowl; allow to stand until curdled, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, baking soda, and salt together in a bowl; gradually stir in soured milk until dough just comes together. Turn dough out onto a well-floured surface; knead lightly and shape into a round."
    },
    {
      "position": 4,
      "text": "Transfer dough to the prepared baking sheet. Cut an \"X\" into the top of the dough to release steam and help the bread keep its round shape while baking."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and the bottom of the loaf sounds hollow when tapped, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "9aa1c4c6-6b5c-5c3b-9e2f-ef22605c26c7",
  "slug": "cake-fondant",
  "name": "Cake Fondant",
  "recipe_type": "dessert",
  "brief_description": "Learn how to make fondant for decorating cakes and cupcakes with just 4 ingredients and this quick and easy recipe. Add coloring for colored fondant.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix butter, sweetened condensed milk, confectioners' sugar, and vanilla extract in a mixing bowl until fondant has the consistency of modeling clay. If fondant is too moist, knead in additional confectioners' sugar."
    },
    {
      "position": 3,
      "text": "Roll fondant out on a work surface generously dusted with confectioners' sugar to desired thickness."
    }
  ],

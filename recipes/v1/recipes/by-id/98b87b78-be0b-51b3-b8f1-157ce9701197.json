  "id": "98b87b78-be0b-51b3-b8f1-157ce9701197",
  "slug": "strawberry-cream-cheese-cobbler",
  "name": "Strawberry Cream Cheese Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This cobbler recipe with cream cheese and strawberries creates a fresh, naturally delicious combination in a dessert that is easy and irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour melted butter into the bottom of a 9x13-inch glass baking dish."
    },
    {
      "position": 3,
      "text": "Mix milk, flour, sugar, baking powder, and salt together in a small bowl; pour over butter in the baking dish. Arrange strawberry halves in a layer in the baking dish. Dot strawberries with cream cheese pieces."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is golden brown and the edges are bubbling, 30 to 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

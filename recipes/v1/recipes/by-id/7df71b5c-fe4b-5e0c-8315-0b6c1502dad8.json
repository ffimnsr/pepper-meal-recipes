  "id": "7df71b5c-fe4b-5e0c-8315-0b6c1502dad8",
  "slug": "easy-and-delicious-crusty-popovers",
  "name": "Easy and Delicious Crusty Popovers",
  "recipe_type": "side",
  "brief_description": "These buttery popovers are very easy to make and tasty. All you need is eggs, flour, milk, salt, butter, and a muffin tin!",
  "cuisine": "U.S. British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Put 12-cup muffin tin in oven to preheat as well."
    },
    {
      "position": 2,
      "text": "Beat eggs and milk together in a bowl with an electric hand mixer. Add flour and salt; continue beating into smooth batter."
    },
    {
      "position": 3,
      "text": "Put about 3/4 teaspoon butter into each muffin tin and carefully spread butter up sides of each cup. Quickly divide batter among prepared cups."
    },
    {
      "position": 4,
      "text": "Bake until popovers are risen well and browned, 30 to 35 minutes. Do not open the oven during baking."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

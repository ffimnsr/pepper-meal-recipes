  "slug": "air-fried-tossed-taquitos-recipe-8784154",
  "name": "Air Fried Tossed Taquitos",
  "recipe_type": "appetizer",
  "brief_description": "These air fried tossed taquitos are frozen chicken taquitos, given a quick upgrade by air frying, tossing in buttered hot sauce, and sprinkling with cotija cheese and chopped cilantro.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat an air fryer to 400 degrees F (200 degrees C). Add taquitos and cook until slightly crispy, about 8 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Stir in hot sauce until well combined. Toss taquitos in butter mixture until well coated and add to a serving platter. Top with cheese and cilantro and serve with sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

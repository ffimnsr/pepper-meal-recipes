  "id": "380b09ee-6dc8-5517-ad88-d588278ab9a0",
  "slug": "danish-chicken-liver-pate",
  "name": "Danish Chicken Liver Pate",
  "recipe_type": "appetizer",
  "brief_description": "Homemade Danish chicken liver pate, made with onion, heavy cream, and eggs, is delicious spread on rye bread and topped with cucumber.",
  "cuisine": "Danish Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 390 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour and water together in a bowl until a thin paste forms, adding more water as needed."
    },
    {
      "position": 3,
      "text": "Combine flour mixture, chicken livers, cream, onion, eggs, butter, salt, nutmeg, and black pepper in a food processor; process until blended and smooth, 30 to 45 seconds."
    },
    {
      "position": 4,
      "text": "Transfer liver mixture to three 7x4-inch disposable pans. Cover pans with aluminum foil and place in a baking pan. Pour enough water into the baking pan to come up halfway up the sides."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 minutes. Remove foil and continue baking until cooked through, about 25 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Cool to room temperature. Cover with lids and refrigerate."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "eae1882d-f279-56a5-8e4b-b2bfed13b21e",
  "slug": "chocolate-peanut-butter-cups",
  "name": "Chocolate Peanut Butter Cups",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter cups have a creamy peanut butter filling and are completely covered in chocolate for a simple and decadent homemade candy treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim 12 paper muffin cup liners to half of their height."
    },
    {
      "position": 2,
      "text": "Place 1/2 chocolate chips in a microwave safe container. Microwave for 2 minutes, stirring after each minute. Spoon melted chocolate into muffin cups, filling halfway. With a spoon, draw the chocolate up the sides of the cups until evenly coated. Cool in the refrigerator until firm."
    },
    {
      "position": 3,
      "text": "Mix peanut butter, confectioners' sugar, and salt together in a small bowl; divide into the chocolate cups. Melt remaining chocolate and spoon over peanut butter filling. Spread chocolate to edges of cups. Let the chocolate cool and set before serving."
    }
  ],
  "servings": 12,

  "id": "2d88b225-416e-5645-9b85-2202982621ca",
  "slug": "sawmill-gravy-without-sausage",
  "name": "Sawmill Gravy without Sausage",
  "recipe_type": "breakfast",
  "brief_description": "This Southern sawmill gravy recipe is vegetarian because it's made without sausage, and it's flavored with rubbed sage and fresh black pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a 4-quart pot or cast iron skillet over medium heat. Stir in flour until a roux paste forms. Cook, stirring constantly, until flour is a light golden color, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Add milk, whisking vigorously. Season with pepper, salt, sage, garlic powder, and onion powder."
    },
    {
      "position": 3,
      "text": "Cook until thickened but not boiling, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

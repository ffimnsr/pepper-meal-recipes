  "id": "5cab21ef-1316-5b2d-ae58-0eddc9f882c4",
  "slug": "fun-finger-gelatin",
  "name": "Fun Finger Gelatin",
  "recipe_type": "salad",
  "brief_description": "Finger jello is a fun dessert that's easy to make with unflavored gelatin and your favorite flavors of flavored gelatin mix for a kid-pleasing treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve the unflavored gelatin in 2 \u00bd cups cold water in a bowl."
    },
    {
      "position": 2,
      "text": "Combine the fruit-flavored Jell-O, sugar, and hot water in a large saucepan; bring to a boil. Stir the unflavored gelatin mixture into the boiling mixture; cook and stir until the gelatin and sugar are completely dissolved, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove the saucepan from heat. Stir 1 cup cold water into the gelatin mixture; pour into a 13x9-inch dish."
    },
    {
      "position": 4,
      "text": "Refrigerate until the gelatin is firm, about 3 hours; cut into squares to serve."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

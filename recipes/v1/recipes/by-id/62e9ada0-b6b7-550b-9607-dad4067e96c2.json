  "id": "62e9ada0-b6b7-550b-9607-dad4067e96c2",
  "slug": "rhubarb-strawberry-crunch",
  "name": "Strawberry Rhubarb Crisp",
  "recipe_type": "dessert",
  "brief_description": "This delightful strawberry rhubarb crisp has a layer of sweet and tangy fruit topped with a buttery oat topping baked until golden and crisp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "To make the fruit layer: Mix strawberries, rhubarb, white sugar, and flour together in a large bowl. Place the mixture in a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "To make the crisp topping: Combine 1 \u00bd cups flour, brown sugar, oats, and butter and mix until crumbly. You may want to use a pastry cutter for this. Sprinkle on top of the rhubarb and strawberry layer."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crisp and lightly browned, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

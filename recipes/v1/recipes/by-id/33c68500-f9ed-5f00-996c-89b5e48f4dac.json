  "id": "33c68500-f9ed-5f00-996c-89b5e48f4dac",
  "slug": "easy-ramen-upgrade-recipe-11864195",
  "name": "The Instant Ramen Upgrade You\u2019ll Actually Do Over and Over Again",
  "recipe_type": "soup",
  "brief_description": "This easy ramen upgrade calls for rotisserie chicken plus only a few fresh ingredients, but adds so much to any ramen with just a little effort. It's still a very easy, one-pot dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vegetable oil into a large stock pot over medium-high heat. Add yellow onion and white part of green onion and cook until softened, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Add garlic and ginger; cook and stir until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add water, seasoning packets and chicken to the stock pot, bring to a boil, and reduce heat; simmer for 5 minutes. Add soy sauce and ramen noodles to the stock pot; simmer until noodles are tender, about 4 minutes, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Serve with jalapenos, green part of green onions, cilantro, and Sriracha."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

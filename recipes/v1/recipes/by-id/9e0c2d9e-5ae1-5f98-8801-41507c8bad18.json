  "id": "9e0c2d9e-5ae1-5f98-8801-41507c8bad18",
  "slug": "brandy-slush-i",
  "name": "Brandy Slush",
  "recipe_type": "drink",
  "brief_description": "This Wisconsin brandy slush is made with lemonade, orange juice, green tea, and lemon-lime soda for a yummy boozy punch. Perfect for any party!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Steep tea bags in 2 cups boiling water for 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, place remaining 3 cups boiling water in a 9x13-inch pan. Stir in sugar until dissolved. Stir in brandy, lemonade concentrate, and orange juice concentrate until combined."
    },
    {
      "position": 4,
      "text": "Remove tea bags and stir tea into brandy mixture."
    },
    {
      "position": 5,
      "text": "Freeze 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "To serve, scoop desired amount into a glass. Fill the glass with lemon-lime soda; stir."
    }
  ],
  "servings": 24,

  "id": "7dfd0424-5f9e-53bd-b5d4-ef31ad4597dc",
  "slug": "neiman-marcus-brownies-recipe-11839031",
  "name": "Neiman Marcus Brownies\u2014Only 5 Ingredients!",
  "recipe_type": "dessert",
  "brief_description": "These quick and easy Neiman Marcus brownies are made with only 5 ingredients. The brownies are fudgy and have a sweet cream cheese topping, almost like a frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine cake mix, melted butter, and 1 egg in a large bowl. Beat with an electric mixer until well combined. The dough will be stiff."
    },
    {
      "position": 3,
      "text": "Press dough evenly into the bottom of the prepared pan. Use the bottom of a measuring cup to press the dough to an even thickness."
    },
    {
      "position": 4,
      "text": "Beat cream cheese with an electric mixer using clean beaters in a medium bowl for 30 seconds. Add remaining 2 eggs and the powdered sugar. Beat until smooth."
    },
    {
      "position": 5,
      "text": "Spread over the chocolate dough."
    },
    {
      "position": 6,
      "text": "Bake until the top is almost set and lightly golden, 30 to 35 minutes. (The top mixture will continue to set as it cools.)"
    },
    {
      "position": 7,
      "text": "Cool completely on a wire rack, 1 to 2 hours."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

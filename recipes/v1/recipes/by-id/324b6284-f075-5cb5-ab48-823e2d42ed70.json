  "id": "324b6284-f075-5cb5-ab48-823e2d42ed70",
  "slug": "spiced-pumpkin-bread",
  "name": "Spiced Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "Buttery pumpkin bread nicely spiced with warm cinnamon, cloves, and nutmeg is a festive treat for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease three (9x5-inch) loaf pans; set aside."
    },
    {
      "position": 2,
      "text": "Mix together white sugar, brown sugar, and melted butter in a large bowl until well combined. Stir in eggs and vanilla; mix in pumpkin until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Whisk together flour, cinnamon, baking powder, baking soda, nutmeg, cloves, and salt in a separate bowl until combined. Mix flour mixture into pumpkin mixture until incorporated. Pour batter into the prepared loaf pans; smooth batter evenly in each pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the middle of each loaf comes out clean, 45 to 50 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

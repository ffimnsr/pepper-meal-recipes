{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0e86606c-0f17-54cb-8227-d9f1b28bf4c9",
  "slug": "stuffed-pork-tenderloin",
  "name": "Stuffed Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "This stuffed pork tenderloin is rolled around prosciutto slices with seasoned mushrooms and spinach for a flavorful main dish to impress your guests.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a skillet over medium heat; cook and stir mushrooms, shallot, thyme, garlic powder, sage, black pepper, and salt in the hot oil until liquid has evaporated and mushrooms and shallots are softened, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Add parsley; cook and stir for 1 minute. Mix in spinach; cook and stir until spinach is wilted, about 5 minutes. Stir in mustard. Remove from heat."
    },
    {
      "position": 4,
      "text": "Place pork tenderloin on a work surface; lay prosciutto atop tenderloin. Spread mushroom-spinach mixture over prosciutto, leaving a 1/2-inch border on all sides."
    },
    {
      "position": 5,
      "text": "Tightly roll tenderloin around filling and tie together with kitchen string to keep closed."
    },
    {
      "position": 6,
      "text": "Heat remaining 2 tablespoons olive oil in a large skillet over medium heat; place rolled tenderloin in the hot oil. Sear until all sides are golden brown, about 10 minutes. Transfer seared tenderloin to a 9x13-inch casserole dish."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until pork is slightly pink in the center, 25 to 30 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "9c00878d-4d79-593c-b5e9-5e53d9a7cf09",
  "slug": "chamoyada",
  "name": "Chamoyada",
  "recipe_type": "dessert",
  "brief_description": "A chamoyada, also called mangonada, is a refreshing, sweet, and spicy Mexican drink made with fresh or frozen mango, chamoy sauce, lime, and chili seasoning.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mango and pineapple juice in a blender; blend until smooth. Set aside."
    },
    {
      "position": 2,
      "text": "Rub lime wedge around the rim of a glass, then dip in 1 teaspoon chili-lime seasoning. Juice lime into the glass; add 1 tablespoon chamoy and remaining 1 teaspoon chili-lime seasoning. Pour 1/2 of the mango-pineapple mixture into the prepared glass. Add remaining 1 tablespoon chamoy sauce and top with remaining mango-pineapple mixture."
    }
  ],

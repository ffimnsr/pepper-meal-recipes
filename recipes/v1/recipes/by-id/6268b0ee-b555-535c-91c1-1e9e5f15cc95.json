  "id": "6268b0ee-b555-535c-91c1-1e9e5f15cc95",
  "slug": "spinach-and-tortellini-salad",
  "name": "Spinach and Tortellini Salad",
  "recipe_type": "salad",
  "brief_description": "This spinach and tortellini salad recipe tosses cheese tortellini with spinach, Parmesan cheese, cherry tomatoes, black olives, and Italian dressing.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, until tortellini float to the top and the filling is hot, about 3 minutes. Rinse under cold water; drain."
    },
    {
      "position": 2,
      "text": "Combine tortellini, tomatoes, spinach, cheese, and olives; add enough salad dressing to coat. Toss; season with salt and black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "347bbf24-2759-5a41-b10e-e6e81b8ddcf4",
  "slug": "prosciutto-wrapped-pork-tenderloin-with-crispy-sage",
  "name": "Prosciutto-Wrapped Pork Tenderloin with Crispy Sage",
  "recipe_type": "main",
  "brief_description": "Prosciutto-wrapped pork tenderloin with crispy sage is a quick and easy meal made with only 5 ingredients for a fancy dinner any night of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Lightly season pork with salt and black pepper. Arrange about 6 sage leaves over tenderloin. Wrap prosciutto around tenderloin and sage, overlapping prosciutto slightly; wrap in plastic wrap and refrigerate to allow prosciutto to set on pork tenderloin, 5 to 10 minutes. Remove plastic wrap."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium heat. Fry wrapped tenderloin in the hot oil until prosciutto is crispy and lightly browned on all sides, 8 to 10 minutes. Transfer wrapped tenderloin to a baking dish, reserving oil in the skillet."
    },
    {
      "position": 4,
      "text": "Bake tenderloin in the preheated oven until pork is cooked through, about 20 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 5,
      "text": "Heat reserved oil in the skillet over medium heat; fry remaining sage leaves until crispy, adding more oil as needed, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Slice tenderloin and serve with crispy sage leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

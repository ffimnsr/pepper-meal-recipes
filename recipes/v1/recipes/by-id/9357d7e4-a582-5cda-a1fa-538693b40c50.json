  "id": "9357d7e4-a582-5cda-a1fa-538693b40c50",
  "slug": "fruit-salad-with-lemon-cinnamon-syrup",
  "name": "Fruit Salad with Lemon-Cinnamon Syrup",
  "recipe_type": "salad",
  "brief_description": "Lemon-cinnamon syrup turns this fruit salad into a refreshing dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the sugar, water, lemon zest, cinnamon, and 2 tablespoons of lemon juice into a small saucepan. Bring to a boil; reduce heat to medium-low and simmer 10 minutes. Strain the syrup through a mesh strainer; refrigerate until cold."
    },
    {
      "position": 2,
      "text": "Place the mango, peaches, apple, raspberries, mint, and 2 tablespoons of lemon juice into a mixing bowl. Pour the chilled syrup overtop and gently stir to combine."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,

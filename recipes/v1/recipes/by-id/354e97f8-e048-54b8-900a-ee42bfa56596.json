  "id": "354e97f8-e048-54b8-900a-ee42bfa56596",
  "slug": "one-pot-spaghetti-with-meat-sauce",
  "name": "One-Pot Spaghetti with Meat Sauce",
  "recipe_type": "main",
  "brief_description": "This one-pot spaghetti dish is the perfect choice for an easy dinner. Everything is cooked together for dinner on the table in less than 45 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground sausage, onions, and garlic in a large pot or skillet with tall sides. Cook over medium heat until sausage is cooked through, 5 to 8 minutes. Drain and discard grease."
    },
    {
      "position": 2,
      "text": "Stir pasta sauce, water, and Italian seasoning into the pot; bring to a boil. Stir in spaghetti noodles, return to a boil, and cook, stirring occasionally, until noodles are cooked through and sauce has thickened, 17 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Serve topped with grated Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

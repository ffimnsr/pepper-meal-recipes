  "id": "59162e1b-2608-5585-975c-2b53de5b8a44",
  "slug": "quick-garlic-breadsticks",
  "name": "Quick Garlic Breadsticks",
  "recipe_type": "appetizer",
  "brief_description": "Use hot dog buns for garlic bread! No need for fancy bread loaves, just slather a buttery, cheesy, herb mixture onto hot dog buns for instant garlic bread.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir Parmesan cheese, garlic powder, and basil together in a small bowl."
    },
    {
      "position": 3,
      "text": "Place hot dog buns, cut-sides up, onto the prepared baking sheet. Spread margarine onto buns, then sprinkle Parmesan mixture over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

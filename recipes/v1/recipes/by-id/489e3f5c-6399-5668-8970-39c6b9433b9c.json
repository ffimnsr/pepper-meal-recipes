  "id": "489e3f5c-6399-5668-8970-39c6b9433b9c",
  "slug": "classic-italian-tiramisu",
  "name": "Classic Italian Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This classic tiramisu recipe layers creamy mascarpone cheese with espresso-soaked ladyfingers and a touch of amaretto for a luscious Italian dessert.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine egg yolks and sugar in a bowl and beat with an electric mixer until light and creamy. Add mascarpone cheese and 2 tablespoons amaretto. Beat well."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl with clean beaters until stiff peaks form. Fold beaten egg whites into the mascarpone mixture."
    },
    {
      "position": 3,
      "text": "Pour espresso and remaining 2 tablespoons amaretto into a shallow dish. Stir well. Working one at a time, quickly dip each ladyfinger into the espresso mixture and line the bottom of an 8-inch glass dish."
    },
    {
      "position": 4,
      "text": "Once the bottom of the dish is covered in an even layer of espresso-soaked ladyfingers, top with 1/2 the mascarpone mixture. Repeat with another ladyfinger layer, followed by the remaining mascarpone mixture. Chill in the refrigerator for about 4 hours."
    },
    {
      "position": 5,
      "text": "Dust with cocoa powder before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

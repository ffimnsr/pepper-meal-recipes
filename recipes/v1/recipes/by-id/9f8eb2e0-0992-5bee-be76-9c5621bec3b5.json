  "schema_version": 1,
  "id": "9f8eb2e0-0992-5bee-be76-9c5621bec3b5",
  "slug": "cod-piccata-recipe-8763624",
  "name": "Cod Piccata",
  "recipe_type": "side",
  "brief_description": "This cod piccata is lemony, bright, and fresh. The most challenging thing about this recipe is to avoid overcooking the cod, while making the tangy and delightful sauce. My trick is to brown only one side of the fish, and allow it to finish in the sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Pat cod filets dry with paper towels and lightly season both sides with salt and pepper. Use a scant teaspoon of flour to very lightly dust one side of cod filets. See note."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium high heat. When butter stops bubbling, add cod filets, floured side down. Cook undisturbed, until a light brown color develops, about 3 minutes. Keeping the floured side up, carefully remove filets from skillet and keep warm."
    },
    {
      "position": 3,
      "text": "Cook lemon slices in the same skillet for 2 to 3 minutes, turning to cook evenly, and add shallots and capers. Cook about 1 minute more."
    },
    {
      "position": 4,
      "text": "Stir in white wine; cook about 1 minute, scraping up any browned bits from the bottom of the skillet. Stir in chicken broth and chopped parsley, and squeeze juice of reserved lemon half into the skillet; cook about 4 minutes."
    },
    {
      "position": 5,
      "text": "Gently return filets to the skillet, floured side up. Cook in the sauce until an instant read thermometer inserted in the center reads 145 degrees F (63 degrees C). Remove to a serving plate, floured side up, and keep warm."
    },
    {
      "position": 6,
      "text": "Remove about 1/4 cup of liquid from skillet; allow to cool slightly."
    },
    {
      "position": 7,
      "text": "Add remaining 2 tablespoons butter to skillet and stir until melted."
    },
    {
      "position": 8,
      "text": "Whisk cooled liquid and remaining flour together to make a smooth slurry. Stir slurry briskly into the skillet, and cook until sauce is thickened and bubbly. Pour sauce over cod filets, and garnish with parsley sprigs."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "69dfff44-451d-5fc8-a644-eac752ea7b6d",
  "slug": "mini-vegetarian-frittatas",
  "name": "Mini Vegetarian Frittatas",
  "recipe_type": "breakfast",
  "brief_description": "These mini vegetarian frittatas filled with Parmesan cheese, Swiss chard, scallions, and mushrooms are a good option for a light brunch or dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 7 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add mushrooms, herbes de Provence, salt, and pepper; cook and stir until mushrooms are tender and begin to brown, about 5 minutes. Stir in scallions and cook until softened, 1 to 2 minutes. Add chard and water; cook and stir until wilted, about 2 minutes. Remove from heat and cool for 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk together eggs, milk, Parmesan cheese, and Dijon mustard in a large bowl until well combined. Fold in mushroom mixture and sun-dried tomatoes. Pour egg mixture into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until puffed and golden brown, about 15 minutes. Cool frittatas for 5 minutes before lifting out of the muffin cups."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3323a775-4c5a-5404-bb8e-a45d7cd1d52e",
  "slug": "mexican-egg-rolls",
  "name": "Mexican Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These birria egg rolls are easy and delicious! Use them as an appetizer or as a main dish. As an appetizer, serve with salsa. As a main dish, serve on a bed of lettuce with all the taco fixings you love.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef into a large skillet over medium-high heat. Cook until evenly browned, then drain off grease. Add taco seasoning and cook according to package directions. Set aside."
    },
    {
      "position": 2,
      "text": "Heat 1-inch-deep oil in a large skillet or preheat a deep fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Lay out one egg roll wrapper at a time. Place a rounded tablespoon of seasoned ground beef in the center. Top with a small spoonful of green chilies and a little bit of shredded cheese. Roll up according to package instructions, and seal edges, wetting with water if necessary. Repeat with remaining wrappers and filling."
    },
    {
      "position": 4,
      "text": "Fry rolls in hot oil until golden brown on all sides, about 5 minutes. Remove from oil to drain on paper towels. Serve hot and fresh."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "05163c50-cde4-5337-bfc5-eb5e4d738d9e",
  "slug": "vegetarian-korma",
  "name": "Vegetarian Korma",
  "recipe_type": "main",
  "brief_description": "This creamy vegetable korma recipe is packed with potatoes, bell peppers, carrots, peas, cilantro, and spices for a flavorsome vegetarian curry.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Add onion; cook and stir until tender, about 2 to 3 minutes. Stir in garlic and ginger; cook and stir until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in carrots, potatoes, tomato sauce, cashews, and jalape\u00f1o. Season with curry powder and salt; cook and stir until potatoes are tender, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir in cream, peas, green bell pepper, and red bell pepper; reduce heat to low, cover, and simmer for 10 minutes. Garnish with cilantro to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

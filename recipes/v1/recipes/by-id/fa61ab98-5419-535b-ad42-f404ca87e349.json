  "id": "fa61ab98-5419-535b-ad42-f404ca87e349",
  "slug": "date-haroset",
  "name": "Date Haroset",
  "recipe_type": "dessert",
  "brief_description": "This date haroset recipe simmers dates, raisins, and wine with cinnamon, and nuts. It's rolled into balls and dusted with sugar for a holiday treat.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Place dates and raisins in a small saucepan; add wine. Cook over low heat, stirring occasionally, until fruit breaks down and thickens into a soft paste. Cool."
    },
    {
      "position": 2,
      "text": "Stir nuts and cinnamon into date paste mixture; form into small, bite-sized balls."
    },
    {
      "position": 3,
      "text": "Roll balls in confectioners' sugar."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 60,

  "id": "7410d7ed-62d5-5e27-a3df-381ccc97e459",
  "slug": "scottish-shortbread-iii",
  "name": "Classic Scottish Shortbread",
  "recipe_type": "dessert",
  "brief_description": "This delicious Scottish shortbread recipe makes 6 dozen shortbread bars or fingers. Perfect for Christmas cookie platters or gift giving,",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream butter and sugar with mixer. Add flour and mix with a wooden spoon. Use hands to thoroughly mix."
    },
    {
      "position": 3,
      "text": "Press into a jelly roll pan. Prick to bottom all over with a fork being sure the fork hits the bottom and the pricks are close together."
    },
    {
      "position": 4,
      "text": "Bake for 10 minutes. Reduce the heat to 300 and continue to bake for 40 minutes more. Wait 2 minutes then cut into finger size bars. Cool thoroughly in pan."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

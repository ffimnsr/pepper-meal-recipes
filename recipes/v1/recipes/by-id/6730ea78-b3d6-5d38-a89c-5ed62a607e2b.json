  "id": "6730ea78-b3d6-5d38-a89c-5ed62a607e2b",
  "slug": "golden-butter-rice-recipe-8599188",
  "name": "Golden Butter Rice",
  "recipe_type": "drink",
  "brief_description": "Chef John's basmati rice, colored gold with turmeric and flavored with butter and ginger, is inspired by a classic Indian drink called golden milk.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a pan or pot with a tight-fitting lid over medium heat. As soon as butter starts to bubble, add in ginger, turmeric, cayenne, brown sugar, and salt. Cook, whisking, for 1 minute."
    },
    {
      "position": 2,
      "text": "Add rice, and stir until every grain is coated with butter. Stir in water, and bring to a boil over high heat. As soon as it begins to boil, gently shake and swirl the pan to settle rice into an even layer, then reduce heat to medium-low."
    },
    {
      "position": 3,
      "text": "Cover tightly and simmer for 15 minutes. Turn off heat, and let rest, covered, for 10 minutes. DO NOT lift the lid or try to stir yet."
    },
    {
      "position": 4,
      "text": "Now, remove the lid and use a fork to fluff and separate rice grains. Season to taste, and serve immediately, garnished with walnuts and green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 10,
  "difficulty": "easy",

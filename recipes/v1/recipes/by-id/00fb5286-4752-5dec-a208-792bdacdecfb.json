{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "00fb5286-4752-5dec-a208-792bdacdecfb",
  "slug": "air-fryer-pork-tenderloin-recipe-7368416",
  "name": "Air Fryer Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "Use your air fryer to cook pork tenderloin much faster than in the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together chili powder, salt, smoked paprika, garlic powder, onion powder, dried oregano, black pepper, and crushed red pepper in a small bowl until evenly combined."
    },
    {
      "position": 2,
      "text": "Place pork on a cutting board and coat with olive oil; rub spice mix over the entire tenderloin until evenly coated."
    },
    {
      "position": 3,
      "text": "Lightly coat air fryer basket with cooking spray. Place tenderloin in basket at a diagonal angle so tenderloin lays flat and straight in basket."
    },
    {
      "position": 4,
      "text": "Cook at 400 degrees F (200 degrees C) for 5 minutes. Reduce temperature to 325 degrees F (165 degrees C) and continue to cook, until an instant-read thermometer inserted into the center should read at least 140 degrees F (60 degrees C), 12 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove from basket and let stand until internal temperature reaches 145 degrees F (63 degrees C), about 5 minutes."
    },
    {
      "position": 6,
      "text": "Cut into 3/4-inch slices and place on a serving platter. Drizzle with honey and serve immediately. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,

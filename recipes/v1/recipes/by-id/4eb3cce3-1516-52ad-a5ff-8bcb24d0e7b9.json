  "id": "4eb3cce3-1516-52ad-a5ff-8bcb24d0e7b9",
  "slug": "cookie-press-shortbread",
  "name": "Cookie Press Shortbread",
  "recipe_type": "dessert",
  "brief_description": "This is my mother's recipe for spritz cookies. It makes delectable little morsels!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together butter, confectioners' sugar, and vanilla in a medium bowl with an electric mixer until smooth. Stir in flour and cornstarch. Pop dough into your cookie press, and away you go! Press cookies out onto ungreased cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 8 to 10 minutes in the preheated oven, or until the peaks are golden."
    }
  ],
  "servings": 24,

  "id": "80e97c1d-ad5e-52f2-a7b9-c7c09ff282f6",
  "slug": "watermelon-rind-candy-recipe-12029345",
  "name": "Watermelon Rind Candy",
  "recipe_type": "dessert",
  "brief_description": "These watermelon rind candies are a true labor of love, transforming a part of the fruit you\u2019d normally toss into a chewy, sweet-and-sour treat coated in sugar. Though they take a couple of days to finish, there\u2019s less than an hour of hands-on work. You\u2019ll never guess this delicious candy started as watermelon rind.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel the green skin off the rind. Slice peeled rind into bite-sized strips. Add to a dish or bowl and coat the pieces in 1 cup sugar; refrigerate overnight."
    },
    {
      "position": 2,
      "text": "Pour watermelon strips with their released liquid into a pot; cook until the liquid is thickened into a syrup and mostly evaporated, 20 to 30 minutes. Remove from heat and spread out on parchment paper. Leave out to dry overnight."
    },
    {
      "position": 3,
      "text": "Toss with 2 tablespoons sugar and citric acid. Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

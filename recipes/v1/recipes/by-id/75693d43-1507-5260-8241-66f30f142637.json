  "id": "75693d43-1507-5260-8241-66f30f142637",
  "slug": "banana-drop-cookies-recipe-11984527",
  "name": "Banana Drop Cookies",
  "recipe_type": "dessert",
  "brief_description": "These banana cookies combine mashed bananas, cinnamon sugar, and a chilled batter for a soft, lightly browned treat baked in just 8 to 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar, Crisco shortening, and vanilla extract in a bowl and beat with an electric mixer until fluffy. Add eggs, 1 at a time, beating well after each addition. Stir in mashed bananas."
    },
    {
      "position": 2,
      "text": "Combine flour, baking powder, soda, and salt in a small bowl. Fold into banana batter and mix well. Cover bowl with plastic wrap and refrigerate for at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet or line with parchment paper."
    },
    {
      "position": 4,
      "text": "Drop 1/2 tablespoon-sized chunks of batter 2 inches apart onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Combine sugar and cinnamon in a small bowl. Sprinkle a little cinnamon sugar on top of each cookie."
    },
    {
      "position": 6,
      "text": "Bake cookies in the preheated oven until lightly browned, 8 to 10 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

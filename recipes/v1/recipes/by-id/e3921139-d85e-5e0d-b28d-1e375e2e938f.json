  "id": "e3921139-d85e-5e0d-b28d-1e375e2e938f",
  "slug": "potato-and-green-chile-soup",
  "name": "Potato and Green Chile Soup",
  "recipe_type": "soup",
  "brief_description": "Potatoes and Hatch green chiles are the backbone of this easy, cheesy soup that's perfect for either lunch or dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter in a large Dutch oven or heavy-bottomed soup pot over medium heat until melted. Add onion; cook and stir until translucent, about 5 minutes. Add garlic and cook until fragrant, about 1 minute. Stir in potatoes and cook for 1 minute."
    },
    {
      "position": 2,
      "text": "Sprinkle in flour and stir until smooth. Cook for 1 minute, stirring continuously, until browned but not burned. Slowly pour in broth and stir until well incorporated; bring to a simmer. Cover and cook, stirring every 15 minutes, until potatoes are tender, about 30 minutes; do not allow to boil."
    },
    {
      "position": 3,
      "text": "Stir in chile peppers, milk, cumin, oregano, and salt. Bring to a simmer, then immediately remove from heat; do not allow to boil. Add Monterey Jack cheese and Cheddar cheese; stir until melted. Season with pepper and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a1ae4bfa-25f3-50b9-8924-da407e65fdd9",
  "slug": "copycat-chicken-salad-chick-kickin-kay-lynne-chicken-salad-recipe-12028462",
  "name": "Copycat Chicken Salad Chick Kickin\u2019 Kay Lynne Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This copycat of Chicken Salad Chick\u2019s Kickin\u2019 Kay Lynne chicken salad lives up to its name. It\u2019s bold and spicy like a firecracker, with ranch seasoning, bacon, Cheddar cheese, and a \u201ckick\u201d from Buffalo sauce, Sriracha, and jalape\u00f1os. Make a sandwich with a croissant or bread, or serve it with crackers or over lettuce.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, Buffalo sauce, Sriracha sauce, ranch seasoning, garlic powder, and pepper together in a medium bowl until smooth. Whisk in milk, 1 teaspoon at a time, if needed."
    },
    {
      "position": 2,
      "text": "Fold in chicken, bacon, Cheddar cheese, and jalapeno until evenly coated. Cover and refrigerate for at least 1 hour before serving."
    }
  ],
  "servings": 4,

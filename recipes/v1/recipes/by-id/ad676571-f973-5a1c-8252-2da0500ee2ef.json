  "id": "ad676571-f973-5a1c-8252-2da0500ee2ef",
  "slug": "eggnog-martini-recipe-8780647",
  "name": "Eggnog Martini",
  "recipe_type": "appetizer",
  "brief_description": "This eggnog martini, with eggnog, vodka, and Irish cream, is creamy and delicious, a perfect cocktail for holiday parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour brown sugar onto a plate. Pour a splash of eggnog on another plate and dip the rim of the glass in eggnog and then in brown sugar."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice. Add eggnog, vodka, and Baileys. Close the shaker and shake until the outside of shaker is frosted, about 30 seconds. Pour into the prepared glass and sprinkle with cinnamon."
    }
  ],

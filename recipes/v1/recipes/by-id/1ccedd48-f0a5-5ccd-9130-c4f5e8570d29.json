  "id": "1ccedd48-f0a5-5ccd-9130-c4f5e8570d29",
  "slug": "potato-fish-chowder",
  "name": "Potato Fish Chowder",
  "recipe_type": "soup",
  "brief_description": "This creamy fish soup with potatoes is made with cod, potatoes, and clam juice. A warm bowl of chowder is comforting on a cold winter day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a 5-quart saucepan over medium heat. Cook and stir onion, celery, and garlic in melted butter until onion is tender, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Stir flour into the saucepan until vegetables are evenly coated. Pour in clam juice and water; whisk until smooth. Add potatoes, bay leaf, and thyme; bring liquid to a boil. Reduce the heat to medium-low and simmer until potatoes are tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Gently stir cod into the soup. Cover the saucepan and cook until cod is flaky, about 8 minutes."
    },
    {
      "position": 4,
      "text": "Stir in milk and simmer until soup is hot, 1 to 2 minutes. Season with salt and pepper. Remove bay leaf to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

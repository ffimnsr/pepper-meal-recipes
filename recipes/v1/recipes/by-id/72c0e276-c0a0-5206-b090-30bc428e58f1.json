  "id": "72c0e276-c0a0-5206-b090-30bc428e58f1",
  "slug": "fluffy-whole-wheat-biscuits",
  "name": "Fluffy Whole Wheat Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These whole wheat biscuits made with all-purpose and whole wheat flour bake up light and fluffy and are ready to eat in less than 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine all-purpose flour, whole wheat flour, baking powder, sugar, and salt in a large bowl. Cut in cold butter with 2 knives or a pastry blender until the mixture resembles coarse crumbs; stir in buttermilk until just moistened."
    },
    {
      "position": 3,
      "text": "Turn dough out on a lightly floured surface; knead gently 8 to 10 times. Roll out to about 3/4-inch thick. Use a 2 1/2-inch round biscuit cutter to cut biscuits; reroll any scraps to cut more biscuits. Place biscuits on an ungreased baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until biscuits are lightly browned, 10 to 12 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

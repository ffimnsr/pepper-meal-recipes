  "id": "53bae464-4cfd-5e6f-9de3-08e6a01af83c",
  "slug": "quaker-banana-bread-overnight-oats",
  "name": "Quaker\u00ae Banana Bread Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "All the delicious warm spices of banana bread are added to these easy-to-prepare overnight oats. Bananas are stirred in for banana bread flavour in a jiffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together milk, honey, brown sugar, vanilla, cinnamon, nutmeg and salt; stir in oats. Cover and refrigerate overnight."
    },
    {
      "position": 2,
      "text": "Mash two bananas and stir into oatmeal. Slice remaining banana. Divide oatmeal evenly among bowls or small Mason jars; top with sliced banana, pecans, and yogurt (if using)."
    }
  ],
  "servings": 6,

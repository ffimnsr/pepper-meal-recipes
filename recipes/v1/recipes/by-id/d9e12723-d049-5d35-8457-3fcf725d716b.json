  "id": "d9e12723-d049-5d35-8457-3fcf725d716b",
  "slug": "mini-vanilla-cupcakes",
  "name": "Mini Vanilla Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Pure vanilla extract takes center stage in these mini vanilla cupcakes with vanilla frosting, perfect for birthday parties, baby showers, or any special event!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 18-cup mini muffin tin or line with cupcake liners."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt into a bowl."
    },
    {
      "position": 3,
      "text": "Whip butter and sugar in a separate bowl with an electric mixer until fluffy. Mix in egg and vanilla extract. Add flour mixture and milk; whip until just combined. Fill the prepared muffin cups 3/4 full with batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 10 to 14 minutes. Cool in the tin for 5 minutes, then transfer to a wire rack and let cool completely, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, whip powdered sugar, butter, and vanilla for frosting in a bowl until well combined. Frost cooled cupcakes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

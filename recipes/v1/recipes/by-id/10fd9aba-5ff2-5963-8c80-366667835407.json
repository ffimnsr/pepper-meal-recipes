  "id": "10fd9aba-5ff2-5963-8c80-366667835407",
  "slug": "traditional-popovers",
  "name": "Traditional Popovers",
  "recipe_type": "breakfast",
  "brief_description": "This recipe is for traditional popovers. They can be served plain, but my family prefers them with raspberry butter.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray a popover pan with nonstick cooking spray. Place pan on center rack of oven and preheat for 2 minutes."
    },
    {
      "position": 3,
      "text": "Blend flour, salt, eggs, milk, and melted butter until it looks like heavy cream, about 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Cut chilled butter into 6 even pieces. Place 1 piece of butter in each cup and place pan back in oven until butter is bubbly (about 1 minute)."
    },
    {
      "position": 5,
      "text": "Fill each cup half full with batter and bake 20 minutes. Reduce heat to 325 degrees F (165 degrees C) and bake for another 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

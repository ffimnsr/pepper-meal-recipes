  "id": "3b066ad8-0572-52e7-9b76-57d9ff536ede",
  "slug": "spinach-garlic-meatballs-recipe-11916584",
  "name": "Spinach Garlic Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These savory, slightly spicy spinach garlic meatballs are a breeze to make, and they are very versatile. They are perfect as appetizers, served on party picks, with a simple marinara dip, or as part of a main dish with spaghetti and red sauce. We love them as the filling of a submarine sandwich, with lots of yummy toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine egg, salt, black pepper, garlic, red pepper flakes, and Italian seasoning in a large bowl; stir until well mixed. Add bread crumbs and Parmesan cheese and stir until just blended."
    },
    {
      "position": 2,
      "text": "Crumble ground beef over the bowl and sprinkle chopped spinach over beef. Mix ingredients until just combined."
    },
    {
      "position": 3,
      "text": "To form meatballs, roll about 2 tablespoons meat mixture between open palms; place on parchment paper. Repeat until all meat mixture is formed into balls."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons olive oil in a large, nonstick skillet over medium heat. Add meatballs to the hot oil, being careful not to overcrowd the skillet. Cook in batches, if necessary, until brown and cooked through, turning as needed, 5 to 8 minutes. Place cooked meatballs on paper towels or a rack."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

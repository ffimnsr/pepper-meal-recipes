  "id": "2ea13300-407c-5a1f-b2fc-9db3d5c0abd2",
  "slug": "coffee-banana-mousse",
  "name": "Coffee-Banana Mousse",
  "recipe_type": "dessert",
  "brief_description": "This coffee banana mousse is a rich and creamy, elegant dessert made with marshmallows, banana, coffee, and heavy cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put a metal bowl and metal beaters in the refrigerator to chill for at least 15 minutes."
    },
    {
      "position": 2,
      "text": "Place marshmallows and coffee in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching until melted. Stir in banana and vanilla extract; set aside to cool."
    },
    {
      "position": 3,
      "text": "Beat cream in the chilled bowl using an electric mixer with chilled beaters on high speed until stiff peaks form. Gently fold whipped cream into marshmallow mixture until well incorporated. Spoon or pipe mixture into small dessert dishes; garnish with chocolate shavings. Refrigerate until chilled, at least 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "584be7be-a558-5ebb-a5a5-da8158bf6553",
  "slug": "air-fryer-chicken-fajitas",
  "name": "Air Fryer Chicken Fajitas",
  "recipe_type": "main",
  "brief_description": "Use your air fryer to make chicken fajitas; the chicken stays nice and moist while the vegetables have a nice crisp to them.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bell peppers and onion into a large bowl. Drizzle 2 teaspoons olive oil over top and season with salt and pepper. Stir until evenly combined."
    },
    {
      "position": 3,
      "text": "Place chicken into a separate bowl and sprinkle with fajita seasoning. Drizzle with remaining 1 teaspoon olive oil and mix with your hands until evenly combined."
    },
    {
      "position": 4,
      "text": "Add chicken to the air fryer basket and cook for 12 minutes, shaking halfway through. Transfer to a plate to let rest."
    },
    {
      "position": 5,
      "text": "Add vegetable mixture to the air fryer basket and cook for 14 minutes, shaking halfway through."
    },
    {
      "position": 6,
      "text": "Divide chicken and vegetable mixture among tortillas."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

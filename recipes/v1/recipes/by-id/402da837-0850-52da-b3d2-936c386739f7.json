  "id": "402da837-0850-52da-b3d2-936c386739f7",
  "slug": "darias-slow-cooker-beef-stroganoff",
  "name": "Daria's Slow Cooker Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "Long, slow cooking (7 to 8 hours) renders top round steak tender enough to use in place of the cuts that are normally required for Beef Stroganoff.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the beef in the bottom of a slow cooker, and season with salt and pepper to taste. Place onion on top of beef, and then add mushroom soup, mushrooms, and water. Season with chives, garlic, Worcestershire sauce, and bouillon."
    },
    {
      "position": 2,
      "text": "In a small bowl, mix together the wine with the flour. Pour over the beef."
    },
    {
      "position": 3,
      "text": "Cover, and cook on Low for 6 to 7 hours. Stir in the sour cream and parsley, and continue cooking for 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "aa35df9c-67ac-5629-ab45-58bc7f396cf2",
  "slug": "easy-cranberry-orange-relish",
  "name": "Easy Cranberry Orange Relish",
  "recipe_type": "side",
  "brief_description": "This easy cranberry-orange relish recipe blends fresh cranberries, a whole orange, sugar, and cinnamon to make a bright and tangy holiday condiment.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grate 2 teaspoons zest from orange; set aside. Peel orange and divide into segments."
    },
    {
      "position": 2,
      "text": "Place segments, zest, cranberries, sugar, and cinnamon in a food processor; pulse until finely chopped."
    },
    {
      "position": 3,
      "text": "Transfer to a bowl. Cover and refrigerate until flavors have blended, at least 2 hours and up to 3 days."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

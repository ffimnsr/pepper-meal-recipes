  "id": "199d2eaf-d55a-5bd9-8549-c129936e2a04",
  "slug": "garlic-pita-bread-bites",
  "name": "Garlic Pita Bread Bites",
  "recipe_type": "appetizer",
  "brief_description": "Pita bread pieces slathered with a buttery garlic mixture are great with Italian food or by themselves as a snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Open pita bread halves and roughly cut into approximately 2 inch pieces. Arrange on a medium baking sheet."
    },
    {
      "position": 3,
      "text": "In a small saucepan over medium heat, melt butter and mix in garlic and dried Italian-style seasoning. Pour the mixture over pita bread pieces."
    },
    {
      "position": 4,
      "text": "Sprinkle bread with Parmesan cheese, adjusting the amount as desired. Bake in the preheated oven 10 minutes, or until lightly browned."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

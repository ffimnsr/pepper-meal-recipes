  "id": "e6ace1a8-84fb-537e-b9bd-bdd94d12e04f",
  "slug": "mincemeat-pie-filling",
  "name": "Mincemeat Pie Filling",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned mincemeat pie filling, made with apple, raisins, and spices, keeps with tradition by including finely chopped leftover beef.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix apples, diced beef, raisins, sugar, beef broth, orange sections, sorghum, pickle juice, pineapple juice, cinnamon, nutmeg, cloves, and salt together in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Store filling in the refrigerator or freeze until ready to use."
    }
  ],

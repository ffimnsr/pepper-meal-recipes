  "id": "752dd739-d436-5bf6-8e0c-2a0cdeae20ab",
  "slug": "spaghetti-alla-nerano-zucchini-pasta-recipe-11985789",
  "name": "Spaghetti Alla Nerano (Zucchini Pasta)",
  "recipe_type": "main",
  "brief_description": "Get ready for a creamy Italian pasta dish that will transport you to the Amalfi Coast. Thinly-sliced, pan-fried zucchini and a creamy Parmesan-garlic sauce bring this recipe together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat a large frying pan with \u00bd cup of extra-virgin olive oil. Turn it up to low-medium heat. Once warm, add the minced garlic, cooking until golden and fragrant\u2014do not over-cook."
    },
    {
      "position": 2,
      "text": "Add the sliced zucchini, and fry until golden-brown, about 4 minutes on each side. Transfer to a baking sheet lined with paper towels to drain the excess oil. Add sea salt to the fried zucchini. Keep the garlic-olive oil mixture in the pan and set aside."
    },
    {
      "position": 3,
      "text": "Boil a large pot of salted water and cook the spaghetti al dente. Do not discard the pasta water once the spaghetti is cooked."
    },
    {
      "position": 4,
      "text": "To the frying pan you set aside, add a ladle of reserved pasta water and \u00be of the fried zucchini to the pan. Then, add the pasta. Turn the heat down to low, and add the Parmesan cheese, sea salt, and black pepper to taste. Toss with tongs to combine. Continue to ladle in the pasta water until desired creamy consistency is achieved."
    },
    {
      "position": 5,
      "text": "Transfer the spaghetti to a large platter. Top with the remaining zucchini, Parmesan cheese, and fresh basil for presentation."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

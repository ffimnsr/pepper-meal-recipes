  "id": "8fc24837-2541-554c-9df2-b1bd5608b0f4",
  "slug": "no-bake-pumpkin-cheesecake-bars-recipe-12031936",
  "name": "No-Bake Pumpkin Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "This No-Bake Pumpkin Cheesecake Bars recipe layers a graham cracker crust with creamy pumpkin cheesecake filling and sweetened whipped cream. Skip baking pumpkin pie this Thanksgiving and serve these easy, festive bars instead.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line bottom and sides of an 8x8-inch baking pan with parchment paper, leaving a 2-inch overhang on opposite sides, set aside."
    },
    {
      "position": 2,
      "text": "Stir graham cracker crumbs, melted butter, and white sugar together in a bowl until evenly moistened. Press mixture firmly into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Beat pumpkin, cream cheese, brown sugar, and pumpkin pie spice together in a large bowl until smooth."
    },
    {
      "position": 4,
      "text": "In a small saucepan over low heat melt the white chocolate. Add melted chocolate to the pumpkin mixture; stir until combined."
    },
    {
      "position": 5,
      "text": "Spread filling evenly over the crust. Cover and refrigerate until firm, at least 4 hours."
    },
    {
      "position": 6,
      "text": "Beat heavy cream in a separate large bowl until foamy. Add confectioner\u2019s sugar and vanilla and beat until stiff peaks form."
    },
    {
      "position": 7,
      "text": "Top with whipped cream and lift the chilled dessert from the pan using parchment overhang. Cut into16 bars. Garnish with cinnamon, if desired. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "e87dd025-023a-5030-9695-9f19cd74cc52",
  "slug": "pumpkin-parmesan-polenta-squares-recipe-11824628",
  "name": "Pumpkin-Parmesan Polenta Squares",
  "recipe_type": "appetizer",
  "brief_description": "Serve these pumpkin-flavored polenta bites with a selection of store-bought toppers, such as pico de gallo, tapenade, mango chutney, and pesto, as well as fresh herbs and cheeses like feta and Parmesan, and let guests top as they please.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together water and pumpkin in a large saucepan. Bring to a boil over high heat, whisking constantly, and season with salt and pepper. With mixture boiling, slowly sprinkle in cornmeal, whisking constantly. Reduce heat to medium-low; cook, stirring occasionally, until cornmeal is creamy, soft, and no longer gritty, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat; fold in Parmesan cheese, milk, butter, and cayenne until melted and incorporated. Generously grease a 9x13-inch baking pan. Spread polenta evenly into the pan. Let cool to room temperature, about 1 hour. Chill, covered, until polenta is cold and set, at least 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 4,
      "text": "Invert cold, firm polenta onto a cutting board and cut into 12 squares. Transfer squares to prepared baking sheet"
    },
    {
      "position": 5,
      "text": "Bake until edges of polenta are golden brown, about 40 minutes. Top with desired toppings."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,

  "name": "Gorgonzola-Walnut Stuffed Dates",
  "recipe_type": "appetizer",
  "brief_description": "Sweet dates stuffed with the tang of Gorgonzola cheese and a walnut piece for some crunch.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese and Gorgonzola cheese together in a bowl."
    },
    {
      "position": 2,
      "text": "Cut a slit into each date so they can be spread flat. Spread cheese mixture into each date; top with a walnut piece."
    }

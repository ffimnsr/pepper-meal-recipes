  "id": "edd26e30-c468-5c4b-a3bb-b671c4c92575",
  "slug": "pulled-pork-nachos-with-sriracha-slaw",
  "name": "Pulled Pork Nachos with Sriracha Slaw",
  "recipe_type": "appetizer",
  "brief_description": "To score big points this game day, try this pulled pork nachos with Sriracha slaw recipe using leftover pulled pork \u2014 no one will be able to resist.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, vinegar, Sriracha, sugar, oregano, and salt in a saucepan; bring to a boil. Off heat, stir; cool for 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine coleslaw and onion in a large bowl; pour Sriracha mixture on top. Stir; set aside while preparing nachos."
    },
    {
      "position": 3,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler on low setting."
    },
    {
      "position": 4,
      "text": "Spread tortilla chips on a baking sheet; scatter pulled pork on top and top with cheese."
    },
    {
      "position": 5,
      "text": "Broil nachos in the preheated oven until cheese is melted, about 6 minutes. Top with Sriracha slaw."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

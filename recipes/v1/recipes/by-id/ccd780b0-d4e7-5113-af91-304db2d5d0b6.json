{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ccd780b0-d4e7-5113-af91-304db2d5d0b6",
  "slug": "smashed-big-mac-pinwheels-recipe-11958354",
  "name": "Smashed Big Mac Pinwheels",
  "recipe_type": "appetizer",
  "brief_description": "These smashed Big Mac pinwheels are savory and juicy with slightly crisp edges, while melted Cheddar adds a rich complexity. Chopped pickles and onions bring that signature tangy crunch, and the tomato adds a bit of freshness. Wrapped in a toasted tortilla, everything gets a lightly crisp, golden exterior. Dip in the creamy special sauce, and reminisce about the fast food burger flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground beef, Cheddar cheese, onion, dill pickles, tomato, salt, garlic powder, and pepper in a large bowl using your hands until well combined."
    },
    {
      "position": 2,
      "text": "Lay tortillas on a clean work surface. Divide beef mixture evenly among tortillas, pressing into an even layer so it adheres to the tortillas and leaving about a 1/2-inch border around edges. Roll tortillas tightly into logs, pressing gently as you roll to compact the filling. Chill for about 20 minutes, if desired, for easier slicing."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 475 degrees F (245 degrees C) with a rack positioned about 6 inches from the heating element. Line a baking sheet with aluminum foil, and generously spray with cooking spray."
    },
    {
      "position": 4,
      "text": "Slice each log into 1-inch-thick pinwheels und place, cut-side down, on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until starting to brown, about 6 minutes. Flip and continue to bake until starting to crisp in spots, about 4 minutes. Increase oven temperature to broil and continue cooking until edges are browned and crispy in spots, 2 minutes per side."
    },
    {
      "position": 6,
      "text": "Meanwhile, for Special Sauce, stir mayonnaise, ketchup, pickle relish, white vinegar, paprika, and garlic powder together in a bowl until well combined."
    },
    {
      "position": 7,
      "text": "Transfer pinwheels to a platter and serve with Special Sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "57eac8f7-08ee-521a-abe9-29996ae658d1",
  "slug": "best-ever-fudge",
  "name": "Best Ever Fudge",
  "recipe_type": "dessert",
  "brief_description": "This fudge is easy and delicious! Making this is our Christmas tradition. Also, you can make it ahead and freeze it for up to 3 months!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease 1 - 11x16 inch jelly roll pan. Set aside."
    },
    {
      "position": 2,
      "text": "Combine sugar, milk, vanilla and butter in large, heavy saucepan. Bring to a boil, stirring occasionally. Boil for 2 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and add marshmallows, semi-sweet chocolate chips, milk chocolate chips and unsweetened chocolate. Stir until melted and smooth. Stir in nuts. Mix well."
    },
    {
      "position": 4,
      "text": "Pour into prepared pans. Let fudge sit at least 24 hours before cutting into squares. Refrigerate for easier cutting."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

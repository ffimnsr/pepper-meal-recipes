  "id": "18b4135a-adba-55cd-80ce-9fe9bb4ba26e",
  "slug": "make-ahead-instant-pot-cauliflower-rice",
  "name": "Make-Ahead Instant Pot\u00ae Cauliflower Rice",
  "recipe_type": "side",
  "brief_description": "Use your Instant Pot\u00ae to make a batch of cauliflower rice ahead of time to serve alongside any main dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 cup water into a multi-functional pressure cooker (such as Instant Pot\u00ae) and set a trivet inside. Place a steamer basket on top of the trivet and place cauliflower inside."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 1 minute. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 2 minutes. Transfer cauliflower to a bowl of ice water to stop the cooking."
    },
    {
      "position": 4,
      "text": "Use a food processor to pulse cauliflower into rice-sized pieces. Place riced cauliflower in a colander and press to remove excess water."
    },
    {
      "position": 5,
      "text": "Scoop individual servings of cauliflower rice into freezer-safe zip-top bags and freeze."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "dc697f0f-5df0-5d5d-8c34-678eae6b0ed4",
  "slug": "carrot-cake-cookies-with-cream-cheese-filling",
  "name": "Carrot Cake Cookies with Cream Cheese Filling",
  "recipe_type": "dessert",
  "brief_description": "Experience the sweet taste of carrot cake in a cookie form with these easy sandwich cookies stuffed with a cream cheese filling!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine white sugar, brown sugar, and butter for cookies in a mixing bowl. Beat until light and fluffy, 3 to 4 minutes. Add eggs and vanilla extract and mix on medium speed until well combined."
    },
    {
      "position": 3,
      "text": "Sift flour, baking soda, baking powder, cinnamon, nutmeg, ginger, and salt together in a bowl. Mix into butter mixture on low speed until well combined. Mix in oats and carrots, followed by raisins and walnuts."
    },
    {
      "position": 4,
      "text": "Chill for 1 hour in the refrigerator."
    },
    {
      "position": 5,
      "text": "Scoop batter onto the prepared baking sheets using a tablespoon-sized scoop, leaving about 2 inches between cookies."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are set, 12 to 15 minutes. Remove from the oven and let cool on a wire rack."
    },
    {
      "position": 7,
      "text": "Beat cream cheese in a mixing bowl to soften. Add butter and mix until combined. Beat in confectioners' sugar, followed by vanilla extract. Beat 30 seconds more to lighten."
    },
    {
      "position": 8,
      "text": "Spread frosting onto one cooled cookie. Sandwich together with another. Repeat with remaining cookies."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

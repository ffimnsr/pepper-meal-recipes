  "id": "5a424f43-94b0-578d-9ab2-faba8f9584b6",
  "slug": "black-bean-stuffed-peppers",
  "name": "Black Bean Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "This recipe for stuffed peppers is vegetarian-friendly, as the filling is a cheesy mixture of rice, beans, and tomatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Pour water into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Stir cream cheese in a bowl until smooth. Fold brown rice, spinach, black beans, diced tomatoes with green chiles, minced onion, cumin, and oregano into cream cheese until evenly mixed."
    },
    {
      "position": 3,
      "text": "Halve bell peppers lengthwise. Remove and discard stems, seeds, and membranes."
    },
    {
      "position": 4,
      "text": "Fill each pepper half with about 3/4 cup rice mixture; arrange into the prepared baking dish. Sprinkle cheese evenly over peppers."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until peppers are tender, 35 to 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

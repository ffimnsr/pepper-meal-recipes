  "id": "f7a671f5-679a-578e-bdf8-53ead4504b97",
  "slug": "christmas-bark-recipe-8758185",
  "name": "Christmas Bark",
  "recipe_type": "dessert",
  "brief_description": "This Christmas bark, with red and green M&Ms and sprinkles, is easy to make\u2014you only need a microwave and refrigerator. The recipe variations, mint chocolate and salted caramel pretzel, offer different choices of color, texture, and flavor, with the flexibility to pick whatever type of chocolate you want.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Line a large baking sheet with heavy foil; grease foil with cooking spray. Combine candy coating, chocolate, and shortening in a large microwave-safe bowl. Microwave on High until chocolate is melted, stirring every 30 seconds, 1 1/2 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour mixture onto the prepared baking sheet; spread out evenly, 1/4 inch thick."
    },
    {
      "position": 4,
      "text": "Sprinkle with candy pieces and sprinkles. Chill until firm, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Break candy into pieces."
    }
  ],
  "servings": 20,

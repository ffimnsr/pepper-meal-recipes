  "id": "c5fe12f9-8dc3-5654-9bbb-5eaa1daf0e88",
  "slug": "creamy-buffalo-chicken-noodle-soup",
  "name": "Creamy Buffalo Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy chicken noodle soup has a spicy kick and can be served with blue cheese crumbles and ranch-flavored croutons--classic buffalo chicken flavors.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cook egg noodles as directed on package, drain."
    },
    {
      "position": 2,
      "text": "Melt butter in a large sauce pan over medium heat. Add onion, celery, and carrots and cook until softened, 10 to 12 minutes. Add garlic and cook until fragrant, 1 minute. Stir in flour and cook until mixture is thickened and beginning to brown, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Pour in Swanson\u00ae Chicken Broth; add chicken, hot pepper sauce, and parsley and bring to a boil. Reduce heat and simmer 10 minutes. Stir in cream and cooked noodles; continue cooking until soup is heated through, about 3 more minutes."
    },
    {
      "position": 4,
      "text": "Garnish with blue cheese crumbles and/or ranch flavored croutons if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

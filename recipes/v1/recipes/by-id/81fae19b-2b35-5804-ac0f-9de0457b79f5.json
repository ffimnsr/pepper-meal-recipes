  "id": "81fae19b-2b35-5804-ac0f-9de0457b79f5",
  "slug": "feta-and-sardine-flatbread-recipe-8633618",
  "name": "Feta and Sardine Flatbread",
  "recipe_type": "main",
  "brief_description": "This feta and sardine flatbread is fresh, affordable, and Mediterranean-inspired. Using canned sardines, it\u2019s on your table in under 30 minutes.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place pizza crust on a round pizza pan."
    },
    {
      "position": 2,
      "text": "Whisk olive oil and Greek seasoning together in a small bowl. Brush mixture over the entire pizza crust, including the edges."
    },
    {
      "position": 3,
      "text": "Divide onion, olives, and sardines over pizza crust. Sprinkle on feta, then scatter on chopped tomatoes."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Remove pizza from the oven; add lemon slices and spinach leaves. Cut into slices and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

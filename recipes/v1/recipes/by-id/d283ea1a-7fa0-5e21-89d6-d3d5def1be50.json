  "id": "d283ea1a-7fa0-5e21-89d6-d3d5def1be50",
  "slug": "fried-rice-with-ham",
  "name": "Fried Rice with Ham",
  "recipe_type": "main",
  "brief_description": "This ham and fried rice recipe features stir-fried green onions, peas, carrots, bean sprouts, and egg with soy sauce for a quick and easy 30-minute meal.",
  "cuisine": "Asian Inspired Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir green onions in hot oil for 1 minute. Add ham, peas and carrots, and beaten eggs. Cook and stir until egg is completely cooked. Add cold rice and bean sprouts; cook and stir until rice is heated through. Remove from heat; season with soy sauce, salt, and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

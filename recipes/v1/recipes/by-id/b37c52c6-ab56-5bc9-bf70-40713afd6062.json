  "id": "b37c52c6-ab56-5bc9-bf70-40713afd6062",
  "slug": "easy-pancakes",
  "name": "Easy Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This easy pancake recipe is quick to make with simple pantry ingredients. They cook up nice and fluffy for a family-pleasing breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, baking powder, and salt in a large bowl; make a well in the center. Pour in milk, oil, and egg; mix until smooth."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle or frying pan over medium-high heat. Pour or scoop about \u00bc cup batter per pancake onto the griddle; cook until bubbles form and the edges are dry, 1 to 2 minutes. Flip; cook until browned on the other side. Repeat with remaining batter."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "slow-cooker-sauerkraut-and-sausage",
  "name": "Slow Cooker Sauerkraut and Sausage",
  "recipe_type": "dessert",
  "brief_description": "This sauerkraut and sausage recipe is easy to make in the slow cooker for a delicious combination of sweet, salty, and sour flavors in every bite.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix sauerkraut and brown sugar together in a medium bowl."
    },
    {
      "position": 2,
      "text": "Pour sauerkraut mixture into a slow cooker; arrange sausages and onion over top. Cook on High for 2 hours. Check for dryness, adding water as necessary."
    },
    {
      "position": 3,
      "text": "Reduce the heat to Low and cook for 2 more hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,

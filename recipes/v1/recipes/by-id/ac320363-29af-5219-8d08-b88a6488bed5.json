  "id": "ac320363-29af-5219-8d08-b88a6488bed5",
  "slug": "italian-sausage-tortellini-soup",
  "name": "Italian Sausage Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "This delicious Italian tortellini soup recipe features sausage, and lots of vegetables. This soup is the best and easy to throw together for a comforting home cooked meal.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place sausage in a large pot over medium-high heat and sauté for 10 minutes, or until well browned. Drain the fat except for about 1 tablespoon, add onions and garlic and sauté for 5 more minutes."
    },
    {
      "position": 2,
      "text": "Next add beef stock, water, wine, tomatoes, carrots, basil, oregano, and tomato sauce. Bring to a boil, reduce heat to low and simmer for 30 minutes, skimming any fat that may surface."
    },
    {
      "position": 3,
      "text": "Add zucchini, tortellini, green bell pepper, and parsley to taste. Simmer for 10 minutes, or until tortellini is fully cooked. Pour into individual bowls and garnish with cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "88cb302d-1e97-5757-9000-03aec6622036",
  "slug": "marinated-grilled-pork-tenderloin",
  "name": "Marinated Grilled Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "This simple marinated pork loin is grilled to perfection, resulting in tender, flavorful bites of juicy pork with hints of soy, honey, and ginger.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make marinade: Whisk together honey, soy sauce, oyster sauce, brown sugar, ginger, ketchup, garlic, parsley, onion powder, cayenne pepper, and cinnamon in a medium bowl; pour into a resealable plastic bag."
    },
    {
      "position": 2,
      "text": "Place pork tenderloins into the bag; coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 1 hour or up to 24 hours."
    },
    {
      "position": 3,
      "text": "Preheat the grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove pork tenderloins from marinade; shake off excess. Discard remaining marinade."
    },
    {
      "position": 5,
      "text": "Cook pork tenderloins on the preheated grill until no longer pink in the center, 20 to 30 minutes, turning occasionally. An instant-read thermometer inserted into the centers should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

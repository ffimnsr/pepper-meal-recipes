  "id": "48288a16-7562-5b18-b750-0269a572ad45",
  "slug": "asparagus-cucumber-and-tomato-salad-with-sesame-soy-vinaigrette-recipe-11728075",
  "name": "Asparagus, Cucumber, and Tomato Salad with Sesame Soy Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This asparagus, cucumber, and tomato salad with a sesame soy vinaigrette showcases fresh spring asparagus. The presentation is lovely.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil, add asparagus, and cook uncovered until bright green and just tender, 1 to 2 minutes. Thick asparagus spears may take just a bit longer."
    },
    {
      "position": 2,
      "text": "Transfer asparagus with a large slotted spoon to a bowl of ice water for a few minutes to stop the cooking. Drain well and pat dry with a paper towel."
    },
    {
      "position": 3,
      "text": "Meanwhile, for dressing, combine vinegar, soy sauce, sesame oil, and sugar in a small bowl. Whisk until well mixed combined."
    },
    {
      "position": 4,
      "text": "Place asparagus, cucumbers, and tomatoes in a large bowl. Drizzle dressing over the veggies, and toss gently until well coated."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "2cf575ff-da11-56ee-8299-84d59198f9c2",
  "slug": "4-ingredient-blueberry-meringue-pie",
  "name": "4-Ingredient Blueberry Meringue Pie",
  "recipe_type": "dessert",
  "brief_description": "A very simple blueberry pie with only 4 ingredients that is ready in 30 minutes, assuming the puff pastry dough has already been thawed.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a springform pan with phyllo dough and trim overhanging edges. Fill with blueberries."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until foamy. Gradually add sugar, continuing to beat until stiff peaks form. Evenly spread egg white mixture over blueberries. Make a decorative pattern with a spoon, if you like."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until meringue topping is golden brown, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

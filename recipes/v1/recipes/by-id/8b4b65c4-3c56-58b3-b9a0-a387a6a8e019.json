  "id": "8b4b65c4-3c56-58b3-b9a0-a387a6a8e019",
  "slug": "vermicelli-noodle-bowl",
  "name": "Vermicelli Noodle Bowl",
  "recipe_type": "salad",
  "brief_description": "This vermicelli bowl combines rice noodles, colorful veggies, herbs, shrimp, crunchy peanuts and a sweet and tangy dressing for a delicious Vietnamese salad.",
  "cuisine": "Vietnamese",
  "instructions": [
    {
      "position": 1,
      "text": "To make the dressing: Whisk vinegar, fish sauce, sugar, lime juice, garlic, and red pepper flakes together in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Heat oil in a small skillet over medium heat. Add shallots; cook and stir until softened and lightly caramelized, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Skewer 4 shrimp on each skewer and grill until they turn pink and are charred on the outside, 1 to 2 minutes per side. Set aside."
    },
    {
      "position": 4,
      "text": "Bring a large pot of water to a boil. Add vermicelli noodles and cook until softened, 12 minutes. Drain noodles and rinse with cold water, stirring to separate noodles."
    },
    {
      "position": 5,
      "text": "Assemble vermicelli bowl by placing cooked noodles in one half of each serving bowl; place lettuce and bean sprouts in the other half. Top each bowl with cucumbers, carrots, daikon, peanuts, cilantro, Thai basil, mint, and caramelized shallots. Serve with shrimp skewers and sauce on the side. Pour dressing on top and toss thoroughly to coat before eating."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

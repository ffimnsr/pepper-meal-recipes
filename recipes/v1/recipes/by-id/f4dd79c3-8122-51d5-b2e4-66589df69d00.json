  "id": "f4dd79c3-8122-51d5-b2e4-66589df69d00",
  "slug": "sardine-pizza-recipe-8633538",
  "name": "Sardine Pizza",
  "recipe_type": "main",
  "brief_description": "This sardine pizza showcases the vibrant flavors of the Mediterranean. With sardines, fresh mozzarella, tomatoes, and fresh and dried herbs, it\u2019s perfectly tangy and salty.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a gas grill with all burners on High for 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Shape pizza dough into a disc. Reduce the flame on half the grill burners to Low, to create areas of direct and indirect heat."
    },
    {
      "position": 3,
      "text": "Carefully place dough onto the grill over direct heat. Close the cover. Let dough grill until the bottom is just barely cooked and shows char marks, 1 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Use tongs to flip pizza dough over; move to the indirect heat. Brush dough with olive oil, and sprinkle with Greek seasoning. Place mozzarella slices, tomatoes, and sardines on pizza."
    },
    {
      "position": 5,
      "text": "Sprinkle oregano evenly over the pizza. Crack open egg and place in center of the pizza."
    },
    {
      "position": 6,
      "text": "Grill until cheese is melted, and egg white is no longer clear, about 3 minutes. Carefully remove pizza from the grill."
    },
    {
      "position": 7,
      "text": "Sprinkle with torn basil; squeeze lemon juice over the pizza."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

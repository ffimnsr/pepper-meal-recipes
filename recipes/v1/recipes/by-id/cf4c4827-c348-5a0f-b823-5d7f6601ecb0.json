  "id": "cf4c4827-c348-5a0f-b823-5d7f6601ecb0",
  "slug": "never-fail-fudge",
  "name": "Never-Fail Fudge",
  "recipe_type": "dessert",
  "brief_description": "Confectioners' sugar, cocoa, butter, milk and vanilla are cooked in a double boiler, then beaten like mad and spread in a pan to cool into fudgey gloriousness.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9x9 inch dish."
    },
    {
      "position": 2,
      "text": "Combine sugar, cocoa, butter, milk, vanilla and salt in the top of a double boiler over simmering water. Cook, stirring, until smooth. Remove from heat and beat until mixture loses its gloss. Stir in chopped nuts and pour quickly into prepared pan."
    },
    {
      "position": 3,
      "text": "Let cool completely before cutting into squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,

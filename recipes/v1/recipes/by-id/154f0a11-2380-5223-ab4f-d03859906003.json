  "id": "154f0a11-2380-5223-ab4f-d03859906003",
  "slug": "pot-roast-in-beer",
  "name": "Pot Roast in Beer",
  "recipe_type": "main",
  "brief_description": "The flavor of this hearty rendition is boosted by the addition of sauteed onion, celery and garlic before braising. Bay leaves and cloves are also used.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a roasting pan over high heat, and coat bottom with oil. Sear meat on all sides. Remove from pan, and set aside."
    },
    {
      "position": 2,
      "text": "Reduce heat to low, saute onion, celery and garlic, scraping up browned bits. Cover, and cook on low for 15 minutes."
    },
    {
      "position": 3,
      "text": "Mix in cream of mushroom soup and beer. Wrap bay leaves and cloves in cheesecloth, tie with string, and add to pan. Place roast on top of vegetables, spooning some sauce over meat. Cover with foil, and place lid over foil to seal well. Reduce heat, and simmer 1 1/2 hours."
    },
    {
      "position": 4,
      "text": "Remove meat from pan, and slice. Return to the pan, and spoon sauce over. Cook an additional 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 15,

  "id": "3047a91f-0b63-5f38-ac8a-3b96c2de8790",
  "slug": "philly-cheese-steak-sliders",
  "name": "Philly Cheese Steak Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These Philly cheese steak sliders with tender slices of steak, peppers, onions, and melted cheese in Hawaiian rolls are a game-day crowd-pleaser!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add steak, onion, and bell pepper; cook and stir until steak is browned and cooked to your liking and onions are tender, 7 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line an 8x8-inch baking pan with aluminum foil."
    },
    {
      "position": 3,
      "text": "Slice the connected rolls in half widthwise to look like 2 giant slices of bread. Place the bottom half into the bottom of the prepared baking pan. Spread mayonnaise evenly on top."
    },
    {
      "position": 4,
      "text": "Place 4 slices of pepper Jack cheese over mayonnaise. Layer steak mixture and remaining cheese on top. Cover with the top half of the bread. Spread melted butter on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bread is browned, about 20 minutes. Slice into individual portions."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

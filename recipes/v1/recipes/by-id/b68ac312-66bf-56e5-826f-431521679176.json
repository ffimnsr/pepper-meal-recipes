  "slug": "high-protein-rice-krispie-treats-recipe-12026570",
  "name": "High-Protein Rice Krispie Treats",
  "recipe_type": "dessert",
  "brief_description": "These high-protein Rice Krispie treats are an easy way to add a little extra nutrition to a nostalgic favorite. Protein powder adds a satisfying boost without changing the crispy, gooey texture you love, while a pinch of salt brings out the sweet, buttery flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease an 11x7-inch or 9x13-inch baking dish (a smaller dish will yield a thicker treat). Heat butter in a large Dutch oven over medium heat until it melts. Add marshmallows and stir until melted while gradually adding in protein powder and salt."
    },
    {
      "position": 2,
      "text": "Stir in cereal and remove from heat. Working quickly, transfer mixture to the prepared dish. Lightly coat hands or a rubber spatula with cooking spray and press mixture evenly into the dish."
    },
    {
      "position": 3,
      "text": "Let cool completely at room temperature, at least 1 hour, before cutting into squares and serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

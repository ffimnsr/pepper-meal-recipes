  "id": "596b092c-21a2-539c-8782-d36e2d536843",
  "slug": "ukrainian-red-borscht-soup",
  "name": "Ukrainian Red Borscht Soup",
  "recipe_type": "soup",
  "brief_description": "Borscht is a hearty beet soup with cabbage, potatoes, and garlic that's popular in Eastern Europe. This Ukrainian recipe includes pork for a delicious, comforting meal.",
  "cuisine": "Ukrainian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Crumble sausage into a skillet set over medium-high heat. Cook and stir until no longer pink. Remove from the heat and set aside."
    },
    {
      "position": 3,
      "text": "Fill a large pot halfway with water (about 8 cups) and bring to a boil."
    },
    {
      "position": 4,
      "text": "Add sausage to pot, cover pot, and return to a boil. Add beets and simmer for 10 minutes. Add carrots and potatoes and continue to cook until potatoes are tender, about 10 minutes more. Stir in cabbage and tomatoes."
    },
    {
      "position": 5,
      "text": "Heat oil in a skillet over medium heat. Add onion and cook until tender. Stir in tomato paste and remaining 3/4 cup water until well blended; transfer to the pot."
    },
    {
      "position": 6,
      "text": "Add garlic to the soup, cover, and turn off the heat. Let stand 5 minutes. Stir in sugar and season with salt and pepper."
    },
    {
      "position": 7,
      "text": "Ladle into serving bowls. Garnish with sour cream and dill. Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

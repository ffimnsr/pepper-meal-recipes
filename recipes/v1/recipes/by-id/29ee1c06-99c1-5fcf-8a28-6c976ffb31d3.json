  "schema_version": 1,
  "id": "29ee1c06-99c1-5fcf-8a28-6c976ffb31d3",
  "slug": "air-fryer-turkey-legs",
  "name": "Air Fryer Turkey Legs",
  "recipe_type": "main",
  "brief_description": "Turkey legs can quickly and easily be cooked in the air fryer. Perfect for a Thanksgiving for Two.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together olive oil, poultry seasoning, parsley, salt, paprika, and pepper in a small bowl until evenly combined."
    },
    {
      "position": 3,
      "text": "Brush 1/2 of oil mixture on all the sides of the turkey legs and place into the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook for 25 minutes. Brush the tops of the turkey legs with some of the oil mixture. Flip turkey legs over and brush with remaining oil mixture. Cook until turkey is no longer pink at the bone and the juices run clear, about 10 more minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f227ee5f-b12f-5c19-92b2-ea02b9fc7242",
  "slug": "easy-chilaquiles",
  "name": "Easy Chilaquiles",
  "recipe_type": "breakfast",
  "brief_description": "Here's a quick and easy version of chilaquiles with tortilla pieces, whisked eggs, green taco sauce, and shredded Monterey Jack cheese.",
  "cuisine": "Mexican Inspired American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium-high heat. Add tortilla pieces to oil and fry until crisp, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour beaten eggs over the tortilla pieces in the skillet. Season with salt and pepper. Cook, stirring occasionally, until eggs have set, about 4 minutes. Remove from heat. Top with taco sauce and Monterey Jack cheese."
    }
  ],
  "servings": 4,

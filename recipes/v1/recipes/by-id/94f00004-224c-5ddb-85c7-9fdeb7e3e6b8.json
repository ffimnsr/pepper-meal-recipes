  "id": "94f00004-224c-5ddb-85c7-9fdeb7e3e6b8",
  "slug": "baked-pumpkin-seeds",
  "name": "Baked Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This baked pumpkin seeds recipe, coats the seeds in a mixture of oil and ranch dressing mix, for a crunchy, tasty treat during the Halloween season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss pumpkin seeds, oil, and ranch dressing mix together in a bowl until evenly coated; spread onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until seeds are lightly browned, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

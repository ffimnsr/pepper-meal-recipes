  "id": "7a3889ed-0e26-5d78-aaf1-a67e3613700e",
  "slug": "zucchini-corn-chowder-recipe-11814949",
  "name": "Zucchini Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This zucchini corn chowder, with soup season just around the corner, makes the best of summer's last vegetables. Choose a small dice for the onion, celery, and potato, about 1/4-inch, for quick cooking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large stock pot, cook bacon until crisp over medium-high heat, about 7 minutes. Remove pot from heat. Remove bacon on a plate lined with paper towels."
    },
    {
      "position": 2,
      "text": "Add onion and celery to bacon fat in the pot and cook over medium heat until vegetables begin to take on color, about 10 minutes. Add garlic; cook until fragrant, about 2 minutes, stirring continuously. Add potatoes, bone broth, and red pepper flakes and bring to a boil over high heat. Reduce heat and simmer until potatoes are tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in half the corn kernels and cook for a few minutes."
    },
    {
      "position": 4,
      "text": "Melt butter in a small saucepan; whisk in flour until smooth. Cook over low heat, whisking constantly, about 5 minutes. Slowly whisk in cream and milk; pour into corn mixture. Cook soup for 5 minutes over medium heat and stir well. Allow soup to cool slightly; blend until smooth with an immersion blender."
    },
    {
      "position": 5,
      "text": "Add remaining corn, bacon, zucchini, and thyme; bring to a low simmer, and cook until the zucchini is tender, about 5 minutes. Taste; season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

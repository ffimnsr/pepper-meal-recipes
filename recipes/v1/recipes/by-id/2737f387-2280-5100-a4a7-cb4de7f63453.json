  "id": "2737f387-2280-5100-a4a7-cb4de7f63453",
  "slug": "bacon-stuffed-avocados",
  "name": "Bacon Stuffed Avocados",
  "recipe_type": "appetizer",
  "brief_description": "Avocado halves are filled with crumbled bacon and topped with a sweet and savory sauce creating a memorable appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble."
    },
    {
      "position": 2,
      "text": "Mix butter, brown sugar, vinegar, soy sauce, and garlic in a saucepan; cook and stir mixture over medium heat until sugar is dissolved, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle avocado halves with salt; fill each half with crumbled bacon. Drizzle sauce over filled avocados."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

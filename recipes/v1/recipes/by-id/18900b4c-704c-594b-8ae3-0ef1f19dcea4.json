  "id": "18900b4c-704c-594b-8ae3-0ef1f19dcea4",
  "slug": "blender-yorkshire-pudding",
  "name": "Blender Yorkshire Pudding",
  "recipe_type": "main",
  "brief_description": "Impress your guests during the holiday season with Yorkshire pudding batter that is mixed in the blender and only requires five ingredients!",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Blend eggs in a blender for 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Sift flour and salt together into a bowl. Add flour mixture and 1/4 cup milk to the blender; blend until smooth, about 1 minute. Scrape batter from the sides of the blender and pour in remaining 3/4 cup milk; blend until smooth, 2 to 3 more minutes."
    },
    {
      "position": 3,
      "text": "Refrigerate batter for 1 to 2 hours before cooking."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 5,
      "text": "Divide beef drippings among six muffin cups in a 12-cup muffin pan. Place the muffin pan into the preheating oven and heat until drippings are very hot."
    },
    {
      "position": 6,
      "text": "Remove pan from the oven. Pour batter over hot beef drippings."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until puffed and slightly browned, 20 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

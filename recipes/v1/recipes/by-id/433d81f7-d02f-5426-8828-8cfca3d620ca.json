  "id": "433d81f7-d02f-5426-8828-8cfca3d620ca",
  "slug": "huevos-rancheros-frittata",
  "name": "Huevos Rancheros Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This tasty Mexican-style frittata based on huevos rancheros is quick and easy to make with salsa, onion, sour cream, and cilantro.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease a 9-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat eggs in a large bowl with a fork until slightly frothy. Mix in sour cream and Mexican seasoning. Add salsa, tomato, onion, and cilantro. Pour into the prepared baking dish. Sprinkle 3/4 cup Mexican cheese blend on top; stir in gently with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until firm and springs back when gently pressed, about 20 minutes. Sprinkle remaining 3/4 cup Mexican cheese blend and jalapeno on top. Continue baking until cheese bubbles and turns golden, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Let frittata stand for 10 minutes before slicing with a serrated knife."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

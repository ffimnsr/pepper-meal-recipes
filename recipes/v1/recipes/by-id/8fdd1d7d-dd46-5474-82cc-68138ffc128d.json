  "id": "8fdd1d7d-dd46-5474-82cc-68138ffc128d",
  "slug": "sun-dried-tomato-and-goat-cheese-sous-vide-egg-bites",
  "name": "Sun-Dried Tomato and Goat Cheese Sous Vide Egg Bites",
  "recipe_type": "dessert",
  "brief_description": "These velvety egg bites are filled with the sweet-tart flavor of sun-dried tomatoes and creamy goat cheese. Extra egg bites last in the fridge for 1 week and they are keto.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water and place a sous vide immersion cooker into the water. Set temperature to 170 degrees F (77 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Drain oil from tomatoes, reserving 1/2 teaspoon. Chop tomatoes finely and place in a small bowl. Add reserved oil, vinegar, garlic powder, salt, and pepper. Stir to combine and set aside. Combine eggs, cottage cheese, goat cheese, heavy cream, and 1/2 teaspoon salt in a blender; mix until thoroughly blended, 15 to 20 seconds."
    },
    {
      "position": 3,
      "text": "Spray mason jars with cooking spray. Divide tomato mixture among the jars. Top with egg mixture. Screw on the lids until just barely tightened. Do not over-tighten as the jars can burst in the hot water."
    },
    {
      "position": 4,
      "text": "Submerge mason jars into the water bath and set timer for 55 minutes."
    },
    {
      "position": 5,
      "text": "Remove jars to a cooling rack. Run a knife along the outer edge of each egg bite and invert onto a plate, or eat directly from the jar. Let any remaining jars cool, then refrigerate for up to 1 week."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

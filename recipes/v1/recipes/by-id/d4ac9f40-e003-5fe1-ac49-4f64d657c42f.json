  "id": "d4ac9f40-e003-5fe1-ac49-4f64d657c42f",
  "slug": "sarahs-banana-bread-muffins",
  "name": "Sarah's Banana Bread Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This is a simple banana bread muffin recipe with crunchy walnuts in every bite. Easy to make and perfectly portable for a quick on-the-go breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Mix sugar, oil, and egg in a large bowl until light and creamy. Stir in bananas and walnuts. Add flour, baking soda, and salt; stir until completely smooth. Spoon batter into the prepared muffin cups, filling each 3/4 full."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 30 to 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "2735b082-2509-5051-9850-dd23f9333fcc",
  "slug": "teenies-accidental-rhubarb-raspberry-pie",
  "name": "Teenie's Accidental Rhubarb Raspberry Pie",
  "recipe_type": "dessert",
  "brief_description": "A delicious accident, this rhubarb pie recipe with raspberries will surprise you with its sweet-tart flavor, plus, use store-bought crust to save time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Press 1 pie crust into a 9-inch deep-dish pie plate. Set aside."
    },
    {
      "position": 3,
      "text": "Combine sugar and flour in a medium bowl; mix in raspberries and beaten egg until incorporated. Stir in rhubarb until evenly coated. Transfer rhubarb mixture to the prepared pie crust. Top with remaining pie crust; crimp around edges to seal. Make a few slits in top crust with a small knife to vent steam."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until rhubarb is tender and juices are thickened, about 35 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5b546420-0813-5381-87e1-41f9317b597a",
  "slug": "chicken-parmesan-pizza-recipe-7369199",
  "name": "Chicken Parmesan Pizza",
  "recipe_type": "main",
  "brief_description": "This chicken Parmesan pizza comes together in a flash and looks like the one you'd get from that fancy pizza joint.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Arrange nuggets in a single layer on a pizza pan."
    },
    {
      "position": 2,
      "text": "Bake nuggets in the pre-heated oven for 10 minutes or according to package directions; transfer to a cutting board and cut each nugget in half."
    },
    {
      "position": 3,
      "text": "Increase the oven temperature to 450 degrees F (230 degrees C)."
    },
    {
      "position": 4,
      "text": "Place pizza crust on the pizza pan; spread on marinara in an even layer. Arrange halved nuggets and sliced mushrooms evenly over marinara; sprinkle with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake pizza in the preheated oven until heated through, about 5 minutes. Sprinkle with Parmesan cheese and scatter basil over cheese; bake for 3 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

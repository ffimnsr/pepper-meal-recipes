{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8dfa1c8c-603e-5afc-b01e-ea2fb29ad35c",
  "slug": "homemade-sweet-zucchini-relish",
  "name": "Homemade Sweet Zucchini Relish",
  "recipe_type": "salad",
  "brief_description": "This homemade sweet zucchini relish recipe features zucchini, bell pepper, and onion, making it a tasty addition to potato salad or homemade dressings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pass zucchini, onions, and bell pepper through a meat grinder into a large bowl; season with salt. Refrigerate at least 10 hours to overnight."
    },
    {
      "position": 2,
      "text": "Combine zucchini mixture, sugar, vinegar, celery seeds, and turmeric in a large pot; bring to a boil, and cook, stirring constantly, 15 to 20 minutes. Stir in cornstarch; boil until thickened, about 5 minutes more."
    },
    {
      "position": 3,
      "text": "Inspect 12 half-pint jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until relish is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 4,
      "text": "Pack relish into hot, sterilized jars, filling to within \u00bc inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 5,
      "text": "Place a rack in bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes."
    },
    {
      "position": 6,
      "text": "Remove jars from the stockpot; rest, several inches apart, until cool. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 192,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

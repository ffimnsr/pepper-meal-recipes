  "id": "225b0e30-6864-5e08-ab1e-9e14ae7d79e0",
  "slug": "vitamix-eggnog",
  "name": "Vitamix Eggnog",
  "recipe_type": "drink",
  "brief_description": "This blender-eggnog recipe whips up a five-ingredient eggnog to help you get in the holiday spirit. Works best with high-performance blenders.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whip eggs, sugar, and rum in high-powered blender on High until a thick custard forms, about 4 minutes."
    },
    {
      "position": 2,
      "text": "Pour milk and add nutmeg to custard; blend on Medium until well-mixed, about 2 minutes. Increase the speed to High for 1 minute."
    },
    {
      "position": 3,
      "text": "Chill for 4 hours before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,

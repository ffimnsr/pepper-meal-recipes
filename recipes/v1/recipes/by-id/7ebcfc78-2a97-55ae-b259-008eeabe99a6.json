  "id": "7ebcfc78-2a97-55ae-b259-008eeabe99a6",
  "slug": "zucchini-gingerbread",
  "name": "Zucchini Gingerbread",
  "recipe_type": null,
  "brief_description": "Make this zucchini gingerbread recipe when summer is fading into fall. Warm spices add flavor to every bite, while zucchini keeps things super moist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat two 9x5-inch loaf pans with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, yogurt, eggs, molasses, and oil in a large bowl; stir in cinnamon, ginger, baking soda, nutmeg, cloves, baking powder, and salt. Gently stir in zucchini, then stir in flour until incorporated. Divide batter between the prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tops are browned and a toothpick inserted into centers comes out clean, 50 to 60 minutes. Cool in the pans for 10 minutes, then transfer loaves to a wire rack to cool completely."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "df46fb3c-5aa4-5ceb-8675-b7113a5e9158",
  "slug": "easy-coconut-ladoo-recipe-6786923",
  "name": "Easy Indian Coconut Ladoo",
  "recipe_type": "dessert",
  "brief_description": "Coconut, cardamom, and condensed milk are cooked together and rolled into ladoos, a super-easy Indian dessert you can gift to family and friends.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "If your flaked coconut is not already fine flakes, place the coconut in a food processor and pulse several times until the coconut is fine in texture."
    },
    {
      "position": 2,
      "text": "Combine coconut and cardamom in a pan over medium heat. Mix well and heat for 1 minute, but do not let coconut brown. Add condensed milk and food coloring, if using. Cook and stir until coconut begins to stick together, 5 to 8 minutes. Add rose water, if using; cook and stir until flavors blend, 8 to 10 minutes more."
    },
    {
      "position": 3,
      "text": "Let mixture cool until safe to handle, but still warm. Roll mixture into approximately 1-inch balls; roll in additional coconut, if desired. Place ladoos in mini cupcake liners or on a serving platter. Serve immediately or refrigerate up to a week."
    }
  ],
  "servings": 26,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

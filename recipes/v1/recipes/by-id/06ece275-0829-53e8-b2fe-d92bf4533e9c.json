  "id": "06ece275-0829-53e8-b2fe-d92bf4533e9c",
  "slug": "red-lobster-cheddar-biscuits",
  "name": "Red Lobster Cheddar Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "Red Lobster biscuits are loaded with Cheddar cheese and brushed with seasoned butter in this easy, no-knead copycat recipe that you can enjoy with any dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, Cheddar cheese, baking powder, salt, and garlic powder together in a bowl."
    },
    {
      "position": 3,
      "text": "Combine milk, \u2153 cup softened butter pieces, and egg in a separate bowl; stir into flour mixture until just combined and chunky, being very careful not to overmix."
    },
    {
      "position": 4,
      "text": "Drop batter by tablespoonfuls onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, stir 2 tablespoons melted butter, parsley, and garlic powder together in a small bowl; brush over top biscuits."
    },
    {
      "position": 7,
      "text": "Return biscuits to the oven; continue baking until golden brown, about 5 minutes more. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

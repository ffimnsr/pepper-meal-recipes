  "id": "5cda9cf4-23c4-5e30-a10e-dfca1a13342c",
  "slug": "slow-cooker-pulled-pork-chalupa-nachos-recipe-12022688",
  "name": "Slow Cooker Pulled Pork Chalupa Nachos",
  "recipe_type": "appetizer",
  "brief_description": "In these slow cooker pulled pork chalupa nachos, you\u2019ll enjoy the flavors of braised pork and beans in a party-friendly format by serving chalupa filling over tortilla chips. Think of these like a mash-up recipe that combines everything you love about nachos and chalupas, all in one easy slow cooker recipe",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a 6-quart slow cooker, add pork, pinto beans, chili powder, cumin, oregano, onion powder, garlic powder, salt, and pepper. Top with enough water or vegetable broth to mostly cover the pork."
    },
    {
      "position": 2,
      "text": "Cook until pork shreds easily with a fork, on High for 6 hours or Low for 8 hours."
    },
    {
      "position": 3,
      "text": "Using tongs, carefully remove the pork from the pot. Shred into bite-sized pieces, then return to the pot."
    },
    {
      "position": 4,
      "text": "Serve warm, scooped over tortilla chips."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

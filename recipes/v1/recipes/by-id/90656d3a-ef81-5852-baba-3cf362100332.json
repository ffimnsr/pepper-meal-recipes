  "slug": "california-coleslaw",
  "name": "California Coleslaw",
  "recipe_type": "salad",
  "brief_description": "A sweet summer slaw filled with fresh vegetables. It tastes better the second day after the vegetables have soaked in the marinade.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a large salad bowl, place the cabbage, onion, green bell pepper, red bell pepper and carrot. Combine the vinegar, sugar, salt, pepper and vegetable oil in the bowl with the vegetables. Toss the mixture until the vegetables are fully coated with the marinade."
    }
  ],
  "servings": 6,

  "id": "73c53fff-f55e-5df8-acfe-a71137ca0661",
  "slug": "to-die-for-fettuccine-alfredo",
  "name": "To Die For Fettuccine Alfredo",
  "recipe_type": "main",
  "brief_description": "Fettuccine Alfredo with Romano and Parmesan cheeses, cream, and butter. This delicious sauce for fettuccine pasta is rich in taste yet simple to make.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Heat butter and cream in a large saucepan over low heat until butter melted; add garlic salt, salt, and black pepper."
    },
    {
      "position": 4,
      "text": "Increase the heat to medium; stir in Romano and Parmesan cheeses until melted and sauce has thickened."
    },
    {
      "position": 5,
      "text": "Add cooked pasta to sauce; toss until thoroughly coated. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fb2e6ea8-3166-5048-bd3c-43537e86cc84",
  "slug": "easy-delicious-crockpot-turkey-breast-recipe-11845289",
  "name": "Easy Delicious Crockpot Turkey Breast",
  "recipe_type": "side",
  "brief_description": "This easy, delicious Crockpot turkey breast is ideal for smaller holiday gatherings. The convenience of boneless turkey breast and the slow cooker cannot be beat; you'll have plenty of time to make the sides.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove gravy packet from turkey package and set aside. Leave netting around the turkey while cooking."
    },
    {
      "position": 2,
      "text": "Season turkey all over with salt, pepper, garlic powder, onion powder, and poultry seasoning. Place seasoned turkey in a slow cooker."
    },
    {
      "position": 3,
      "text": "Top with onion soup mix and cranberry sauce. Pour cider around turkey and cook on High for 2 1/2 to 3 hours or on Low for 5 to 6 hours."
    },
    {
      "position": 4,
      "text": "Remove netting with kitchen shears and let turkey rest while sauce is prepared."
    },
    {
      "position": 5,
      "text": "Strain liquid from the slow cooker into a small saucepan; stir in reserved gravy packet and bring to a simmer."
    },
    {
      "position": 6,
      "text": "In a small bowl whisk together 3 tablespoon cold water and 1 tablespoon cornstarch until cornstarch is dissolved. Whisk cornstarch mixture into gravy and simmer until thickened."
    },
    {
      "position": 7,
      "text": "Slice turkey and serve with gravy."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 10,

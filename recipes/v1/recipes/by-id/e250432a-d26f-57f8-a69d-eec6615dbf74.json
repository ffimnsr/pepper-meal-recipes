  "id": "e250432a-d26f-57f8-a69d-eec6615dbf74",
  "slug": "alfredo-marinara-pasta-bake-recipe-11817873",
  "name": "Alfredo Marinara Pasta Bake",
  "recipe_type": "main",
  "brief_description": "Dump-and-bake fettuccine in a creamy marinara-Alfredo sauce, finished with a crisp, golden cheese topping for a rich, comforting meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Whisk marinara sauce, Alfredo sauce, and water together in a bowl until combined."
    },
    {
      "position": 3,
      "text": "Add fettuccine to the bottom of a 9x13-inch broiler-safe baking dish. Drizzle with oil and sprinkle with Italian seasoning; toss until coated."
    },
    {
      "position": 4,
      "text": "Cover fettuccine with sauce mixture and toss gently to combine. Cover the dish tightly with aluminum foil. Bake in the preheated oven, stirring halfway through, until pasta is tender, about 50 minutes; increase oven temperature to broil."
    },
    {
      "position": 5,
      "text": "Remove foil carefully and stir in 1 cup mozzarella and 1/4 cup Parmesan cheese. Sprinkle with remaining mozzarella and Parmesan; broil, uncovered, until cheese is melted and browned in spots, about 4 minutes."
    },
    {
      "position": 6,
      "text": "Garnish with parsley."
    },
    {
      "position": 7,
      "text": "Serve and enjoy. Recipe developed by Isabelle Easter"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "110650eb-8ad7-5c82-bb57-cc05c94efc7a",
  "slug": "perfect-cranberry-cashew-fudge",
  "name": "Perfect Cranberry Cashew Fudge",
  "recipe_type": "dessert",
  "brief_description": "Cashews and dried cranberries are folded into creamy chocolate creating a festive fudge treat for the holiday dessert tray.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line an 8-inch square pan with aluminum foil or waxed paper."
    },
    {
      "position": 2,
      "text": "Combine marshmallow creme, sugar, evaporated milk, butter, and salt together in a saucepan and bring to a boil. Cook for exactly 5 minutes, stirring constantly. Remove from heat; stir in milk chocolate chips and semisweet chocolate chips until chocolate is melted and mixture is smooth."
    },
    {
      "position": 3,
      "text": "Fold cashews and dried cranberries into the chocolate mixture; stir in vanilla extract. Pour mixture into the prepared pan. Cool at room temperature or in the refrigerator until firm, 2 hours. Cut into 1-inch squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "a6451cdc-b227-5d7c-8dde-c8536d8db84d",
  "slug": "beetlejuice-inspired-shrimp-cocktail-recipe-8701693",
  "name": "Beetlejuice-Inspired Shrimp Cocktail",
  "recipe_type": "appetizer",
  "brief_description": "This Beetlejuice-inspired shrimp cocktail is a perfect appetizer for any occasion. The spicy homemade aioli is what sets this shrimp cocktail apart from all the rest.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place shrimp, shells on, in a large bowl. Add 1 tablespoon olive oil, salt, and pepper and toss."
    },
    {
      "position": 2,
      "text": "Heat a cast iron skillet over medium heat until hot; add 1 tablespoon olive oil to the skillet."
    },
    {
      "position": 3,
      "text": "Cook shrimp in the skillet, without crowding, for 3 to 4 minutes on each side. You may have to work in batches. Remove shrimp from skillet and allow to cool."
    },
    {
      "position": 4,
      "text": "Combine egg, poblano pepper, garlic clove, lime juice, and basil in a food processor and blend until smooth. With processor running, slowly add 1/2 cup grapeseed oil and process until mixture is smooth and thick."
    },
    {
      "position": 5,
      "text": "Transfer mixture to a bowl and very slowly, a drop or two at a time, whisk in remaining 1/2 cup olive oil by hand. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

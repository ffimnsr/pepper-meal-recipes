  "id": "ebda2a20-4fe6-5037-a35a-75a3413a98a4",
  "slug": "buttermilk-brined-turkey",
  "name": "Buttermilk-Brined Turkey",
  "recipe_type": "main",
  "brief_description": "This moist turkey is marinated in a flavorful buttermilk brine seasoned with parsley, coriander, peppercorns, mustard seeds, garlic, and bay leaves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, salt, parsley, coriander, peppercorns, mustard seeds, garlic powder, and bay leaves in a large stockpot and bring to a boil. Boil until salt has dissolved, about 2 minutes. Let cool for 15 minutes. Stir in buttermilk."
    },
    {
      "position": 2,
      "text": "Rinse turkey in cold water. Place in a brining bag and pour buttermilk brine over top. Refrigerate for 24 hours, turning occasionally."
    },
    {
      "position": 3,
      "text": "Discard the brine and rinse turkey thoroughly in cold water. Pat turkey dry with paper towels and place breast-side up in a roasting pan. Rub butter over the skin and let sit for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Cook turkey in the preheated oven until an instant-read thermometer inserted into the thickest part of the thigh near the bone reads 165 degrees F (74 degrees C), about 3 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 190,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

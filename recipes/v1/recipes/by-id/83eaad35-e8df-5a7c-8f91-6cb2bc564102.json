  "id": "83eaad35-e8df-5a7c-8f91-6cb2bc564102",
  "slug": "a-to-z-everything-but-the-kitchen-sink-chocolate-chip-cookies",
  "name": "A to Z Everything-but-the-Kitchen-Sink Chocolate Chip Cookies Recipe",
  "recipe_type": "dessert",
  "brief_description": "These everything-but-the-kitchen sink chocolate chip cookies are studded with nuts, cereal, coconut, and oatmeal to create a cookie that is delightfully chewy and showcases a range of flavor and textures.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease the cookie sheets. Sift together flour, baking soda, salt, cinnamon, mace, nutmeg, and cloves; set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together butter, brown sugar, and white sugar until smooth. Beat in the eggs one at a time, then stir in milk and vanilla. Gradually mix in the sifted ingredients until well blended. Using a wooden spoon, fold in the cornflakes, oats, coconut, chocolate chips, and walnuts. Roll dough into walnut-size balls, and place 2 inches apart on the prepared cookie sheets; flatten slightly."
    },
    {
      "position": 3,
      "text": "Bake for 8 to 10 minutes in preheated oven. Allow cookies to cool on baking sheet for 5 minutes before transferring to a wire rack to cool completely. Slightly underbaking yields wonderfully chewy cookies!"
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

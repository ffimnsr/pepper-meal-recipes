  "id": "1da675a5-0b43-56f8-ab51-9f253c30904b",
  "slug": "italian-frittata",
  "name": "Italian Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Salami, mushrooms, tomatoes, and artichoke hearts are baked in this cheesy egg dish perfect for brunch or a light lunch.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease a shallow 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium heat; cook and stir salami, artichokes, tomatoes, and mushrooms until heated through, about 4 minutes. Transfer salami mixture to baking dish."
    },
    {
      "position": 3,
      "text": "Whisk eggs, milk, green onions, garlic, basil, onion powder, salt, and black pepper in a large bowl; pour eggs over salami mixture. Sprinkle with mozzarella cheese and Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake until eggs are set and cheese is melted, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

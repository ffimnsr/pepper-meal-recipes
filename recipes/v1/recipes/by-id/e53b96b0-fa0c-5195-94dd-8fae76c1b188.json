  "id": "e53b96b0-fa0c-5195-94dd-8fae76c1b188",
  "slug": "key-lime-and-raspberry-pies-in-jars",
  "name": "Key Lime and Raspberry Pies in Jars",
  "recipe_type": "dessert",
  "brief_description": "This quick and easy Key lime and raspberry pies in jars recipe is made with Key lime and topped with fresh raspberries for a perfect portable dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a small pie plate with parchment paper."
    },
    {
      "position": 2,
      "text": "Place graham crackers and 2 tablespoons sugar in the bowl of a food processor; pulse until mixture resembles coarse crumbs. Add melted butter; pulse until combined."
    },
    {
      "position": 3,
      "text": "Press 2 tablespoons graham cracker crumbles into bottom of each jar; place jars on a large, rimmed baking sheet. Press remaining graham mixture into bottom of the prepared pie plate."
    },
    {
      "position": 4,
      "text": "Place baking sheet with jars and pie plate in the preheated oven; bake until graham cracker mixture is golden brown, 12 to 15 minutes. Cool on wire rack. Break up graham cracker crust in pie plate into crumbles or pieces; set aside."
    },
    {
      "position": 5,
      "text": "Reduce the oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Whisk sweetened condensed milk and egg yolks together in a large bowl until smooth; whisk in 1 \u00bd teaspoons lime zest and lime juice until combined. Pour into cooled jars."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until lime mixture has just set, 10 to 12 minutes. Cool on a wire rack, then chill in the refrigerator."
    },
    {
      "position": 8,
      "text": "Beat heavy cream and 1 teaspoon sugar in a bowl with an electric mixer until stiff peaks form."
    },
    {
      "position": 9,
      "text": "Divide raspberries, whipped cream, reserved graham cracker crust crumbles, and remaining 1 \u00bd teaspoons lime zest among jars."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3d45b161-6e74-5264-94a5-6c3cf9b663a9",
  "slug": "quick-and-easy-vegetable-curry",
  "name": "Quick and Easy Vegetable Curry",
  "recipe_type": "main",
  "brief_description": "This one-pot vegetable curry with onion, garlic, tomatoes, mixed vegetables and warm spices comes together quickly for an easy vegetarian meal.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until golden, about 1 to 2 minutes. Stir in curry powder and tomato paste, cook and stir for 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in tomatoes, vegetable bouillon cube, mixed vegetables, water, salt and pepper to taste. Simmer until vegetables are very soft and tender, 20 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle with fresh cilantro and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fa47ec8b-8f8a-5208-a86d-91047c8a2182",
  "slug": "goldilocks-sweet-potato-pie",
  "name": "Goldilocks Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pie is the perfect combination of sweet potato flavor with a smooth texture. It is 'Just right' as Goldilocks would say.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Press pie crust into a 9-inch pie pan."
    },
    {
      "position": 2,
      "text": "Mix sweet potatoes, sugar, butter, milk, eggs, vanilla extract, nutmeg, and cinnamon together in a bowl; pour sweet potato mixture into the prepared pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

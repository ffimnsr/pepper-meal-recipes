  "id": "fff56ca0-ddf3-5490-acf8-a5880c6837df",
  "slug": "escarole-and-beans",
  "name": "Escarole and Beans",
  "recipe_type": "side",
  "brief_description": "Escarole and cannellini beans are saut\u00e9ed in olive oil with garlic, crushed red pepper flakes, and parsley in this rich and creamy concoction.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium heat. Toss in escarole, turning to coat with oil. Season with salt, pepper, and crushed red pepper flakes. Cook, stirring occasionally, about 10 minutes, or until tender."
    },
    {
      "position": 3,
      "text": "Heat remaining 1 tablespoon olive oil in a separate skillet over medium heat; stir in garlic. Pour in beans with juice and simmer until creamy, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir in escarole and parsley; simmer 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

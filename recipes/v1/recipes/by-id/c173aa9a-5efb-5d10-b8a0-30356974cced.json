  "id": "c173aa9a-5efb-5d10-b8a0-30356974cced",
  "slug": "porridge",
  "name": "Porridge",
  "recipe_type": "breakfast",
  "brief_description": "This creamy porridge made with rolled oats, bananas, and cinnamon makes a warm and satisfying breakfast to get your morning off to a good start!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water and oats in a saucepan; season to taste with sugar and salt. Add bananas and cinnamon."
    },
    {
      "position": 3,
      "text": "Bring to a boil, then reduce heat to low, and simmer until the liquid has been absorbed, stirring frequently."
    },
    {
      "position": 4,
      "text": "Pour into bowls, and top each with a splash of cold milk."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

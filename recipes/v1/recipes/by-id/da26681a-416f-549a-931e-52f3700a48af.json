  "id": "da26681a-416f-549a-931e-52f3700a48af",
  "slug": "gingersnap-pumpkin-pie",
  "name": "Gingersnap Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This creamy gingersnap pumpkin pie has a crunchy gingersnap cookie crust and perfectly spiced pumpkin filling for a showstopping Thanksgiving dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the crust: Mix gingersnap crumbs, melted butter, and sugar together in a bowl until well combined. Transfer to a 9-inch pie pan; press into the bottom and up the sides."
    },
    {
      "position": 3,
      "text": "Prebake the crust in the preheated oven until fragrant and lightly browned, 8 to 10 minutes. Remove from the oven and set aside to cool completely while you make the filling; keep the oven on."
    },
    {
      "position": 4,
      "text": "To make the filling: Combine pumpkin puree, evaporated milk, brown sugar, eggs, cornstarch, vanilla, cinnamon, nutmeg, and salt in a mixing bowl. Blend with wire whisk until combined."
    },
    {
      "position": 5,
      "text": "Pour filling into cooled crust. Bake until the edges are set and the center jiggles slightly when shaken, about 1 hour. Cool the pie completely on a wire rack before refrigerating, about 2 hours. Cooling too soon could make the crust soggy. Serve at room temperature or chilled."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

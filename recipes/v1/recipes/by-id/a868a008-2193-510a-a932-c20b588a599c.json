  "id": "a868a008-2193-510a-a932-c20b588a599c",
  "slug": "easy-chicken-alfredo",
  "name": "Easy Chicken Alfredo",
  "recipe_type": "main",
  "brief_description": "Chicken Alfredo recipe with jar sauce, mixed vegetables, and linguine pasta; easy to make when you need quick and creamy comfort on busy weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain well."
    },
    {
      "position": 2,
      "text": "While the pasta is cooking, place cubed cooked chicken, Alfredo sauce, frozen vegetables, mushrooms, and milk in a large saucepan over medium-low heat. Cook and stir until chicken is heated through and vegetables are tender."
    },
    {
      "position": 3,
      "text": "Serve warm Alfredo and chicken sauce over cooked noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "875ab595-9b89-5931-a794-167afc6fca49",
  "slug": "canned-apple-pie-filling",
  "name": "Canned Apple Pie Filling",
  "recipe_type": "dessert",
  "brief_description": "This apple pie filling recipe cans sliced apples with warm spices, sugar, and lemon juice for a great way to get ahead of the holiday pie-making game.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix sugar, cooking starch, cinnamon, and nutmeg in a large pan. Add water and salt and mix well."
    },
    {
      "position": 3,
      "text": "Bring to a boil and cook until thick and bubbly. Remove from heat and add lemon juice and food coloring."
    },
    {
      "position": 4,
      "text": "Sterilize canning jars, lids, and rings by boiling them in a large pot of water. Peel, core, and slice apples."
    },
    {
      "position": 5,
      "text": "Pack the sliced apples into hot canning jars, leaving a 1/2 inch of headspace."
    },
    {
      "position": 6,
      "text": "Fill jars with hot syrup, and gently remove air bubbles with a knife."
    },
    {
      "position": 7,
      "text": "Put lids on and process in a water bath canner for 25 minutes."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 56,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

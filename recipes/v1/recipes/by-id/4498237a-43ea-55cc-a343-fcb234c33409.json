  "slug": "the-arnold-palmer",
  "name": "The Arnold Palmer",
  "recipe_type": "drink",
  "brief_description": "The Arnold Palmer mocktail, named after the famous golfer, is a deliciously simple combo of iced tea and lemonade that'll cool you down on a hot day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine lemonade and iced tea in a highball or tall glass."
    },
    {
      "position": 3,
      "text": "Add ice and stir until chilled."
    }
  ],

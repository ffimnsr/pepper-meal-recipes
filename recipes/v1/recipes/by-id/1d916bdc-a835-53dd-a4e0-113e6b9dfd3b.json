  "id": "1d916bdc-a835-53dd-a4e0-113e6b9dfd3b",
  "slug": "chocolate-chip-pretzel-recipe-7496400",
  "name": "Chocolate Chip Pretzel Cookies",
  "recipe_type": "dessert",
  "brief_description": "Try these chocolate chip pretzel cookies to mix up your cookie game. You\u2019ll be amazed how yummy they are.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (180 degrees C). Line 4 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix together flour, cornstarch, baking soda, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Combine butter, brown sugar, and white sugar in a second bowl."
    },
    {
      "position": 4,
      "text": "Beat butter and sugar with an electric mixer on high speed until light and fluffy, about 5 minutes. Use a rubber spatula to scrape sides of the bowl."
    },
    {
      "position": 5,
      "text": "Add 1 egg. Beat until well combined. Add remaining egg and vanilla extract. Beat until well combined."
    },
    {
      "position": 6,
      "text": "Add dry ingredients to the sugar mixture. Stir with a rubber spatula until barely combined and flour is still visible."
    },
    {
      "position": 7,
      "text": "Add chocolate chips and 1 1/2 cups of pretzels. Stir until combined."
    },
    {
      "position": 8,
      "text": "Portion dough by rounded tablespoons onto the prepared baking sheets. Lightly press remaining 1/2 cup of pretzels into the tops of the cookies."
    },
    {
      "position": 9,
      "text": "Working in two batches, bake cookies until light golden brown at the edges, 10 to 12 minutes. Cool cookies on baking sheets for 2 minutes."
    },
    {
      "position": 10,
      "text": "Transfer cookies to a wire rack to finish cooling."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 10,

  "id": "64ac12cf-7a86-5670-839d-0def796197c9",
  "slug": "lemon-chicken-and-rice-casserole-recipe-8635802",
  "name": "Lemon Chicken And Rice Casserole",
  "recipe_type": "soup",
  "brief_description": "Try this lemon chicken and rice casserole for an easy mid-week dinner. Bone-in chicken thighs are quickly browned and then baked in the oven with rice, lemon, and cream of chicken soup to create a comfort dish for the whole family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Season chicken thighs evenly with salt and pepper on both sides."
    },
    {
      "position": 3,
      "text": "Heat oil in a large oven-safe skillet over medium-high. Add chicken thighs to skillet, skin sides down, and cook until golden brown on both sides, about 8 minutes. Transfer chicken thighs to a plate; set aside. Do not wipe skillet clean."
    },
    {
      "position": 4,
      "text": "Add garlic to drippings in the skillet. Cook, stirring constantly, until fragrant, 10 to 20 seconds. Add rice, cream of chicken soup, lemon juice, lemon zest, tarragon, and crushed red pepper; whisk to combine. Gradually add broth, whisking constantly, until combined and smooth. Arrange chicken thighs, skin sides up, over the rice mixture. For extra lemon flavor place lemon slices over chicken thighs (optional). Cover with aluminum foil or lid, and transfer to the preheated oven."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until rice is cooked through and a thermometer inserted into thickest portion of chicken registers 165 degrees F (73 degrees C), about 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven. Stir rice mixture, and sprinkle with parsley. Divide chicken, lemon slices, and rice evenly among 4 plates. Garnish with additional tarragon and crushed red pepper. Recipe developed by Catherine Jessee"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

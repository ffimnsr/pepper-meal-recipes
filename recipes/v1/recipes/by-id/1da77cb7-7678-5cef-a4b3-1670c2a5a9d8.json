  "slug": "avocado-salad",
  "name": "Avocado Salad",
  "recipe_type": "salad",
  "brief_description": "This avocado salad with sweet tomatoes, onion, cilantro, and rich and creamy avocados is dressed with lime juice for a refreshingly easy summer salad.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine avocados, onion, bell pepper, tomato, cilantro, and lime juice in a large bowl."
    },
    {
      "position": 3,
      "text": "Gently toss until evenly coated. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

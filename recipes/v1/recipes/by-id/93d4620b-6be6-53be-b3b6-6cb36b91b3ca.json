  "id": "93d4620b-6be6-53be-b3b6-6cb36b91b3ca",
  "slug": "slow-cooker-ham-and-beans",
  "name": "Slow Cooker Ham and Beans",
  "recipe_type": "main",
  "brief_description": "Make ham and beans in the crockpot when you don't really have time to cook. Let your slow cooker help with this hearty meal the whole family will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine beans, ham, brown sugar, onion powder, parsley, garlic salt, black pepper, and cayenne pepper in a slow cooker."
    },
    {
      "position": 3,
      "text": "Pour enough water into the slow cooker to cover the mixture by about 2 inches."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low, stirring occasionally, for 12 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 720,

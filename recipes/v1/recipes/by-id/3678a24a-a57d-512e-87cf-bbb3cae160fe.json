  "slug": "burrata-caprese-salad",
  "name": "Burrata Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "Caprese salad is even more delicious when you pair rich, creamy burrata cheese with fresh, ripe tomatoes--a perfect summer starter to share with friends!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange tomato and burrata slices on a platter. Place basil leaves in between and drizzle olive oil over top. Season with salt and pepper and drizzle with balsamic vinegar."
    }
  ],

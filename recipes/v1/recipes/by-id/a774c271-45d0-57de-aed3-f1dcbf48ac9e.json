  "id": "a774c271-45d0-57de-aed3-f1dcbf48ac9e",
  "slug": "the-best-sweet-and-sour-meatballs",
  "name": "The Best Sweet and Sour Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "Sweet and sour meatballs made with ground beef and ingredients you probably have in your pantry! A delicious appetizer or main dish served over rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix beef, onion, egg, and bread crumbs together in a medium bowl until well combined."
    },
    {
      "position": 2,
      "text": "Shape mixture into balls, about 1 1/2-inches in size."
    },
    {
      "position": 3,
      "text": "Cook meatballs in a large nonstick skillet over medium heat until evenly browned, about 10 minutes; set aside."
    },
    {
      "position": 4,
      "text": "Stir water, sugar, vinegar, soy sauce, and flour together in a large saucepan until well combined."
    },
    {
      "position": 5,
      "text": "Add meatballs and bring to a boil; reduce heat to low and simmer, stirring often, for 30 minutes."
    },
    {
      "position": 6,
      "text": "Serve over rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

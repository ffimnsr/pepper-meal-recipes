  "id": "5aa5c53a-7882-5e95-988b-cc79a6337816",
  "slug": "smothered-filet-mignon",
  "name": "Smothered Filet Mignon",
  "recipe_type": "main",
  "brief_description": "This filet mignon recipe cooks marinated steak on the grill, topped with caramelized onions and blue cheese for the perfect flavor combination.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season steaks with seasoned salt and black pepper; arrange in a single layer in a large baking dish. Whisk olive oil, balsamic vinegar, mustard, and rosemary together in a bowl; pour over steaks and turn to coat. Marinate for up to 30 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a skillet over medium heat. Add onion slices; cook until soft, then stir in sugar. Continue cooking until onion slices are caramelized; set aside."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for two-zone grilling, heating one side to high and one side to medium; lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Cook steaks on hotter side of grill for 10 minutes, turning once. When steaks are almost done, move to cooler side of grill. Top each steak with 1/4 each caramelized onions and blue cheese. Close the lid; cook until cheese is melted."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

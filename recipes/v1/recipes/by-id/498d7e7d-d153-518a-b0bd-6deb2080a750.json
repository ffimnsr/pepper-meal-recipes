  "id": "498d7e7d-d153-518a-b0bd-6deb2080a750",
  "slug": "seven-layer-bars",
  "name": "Seven Layer Bars",
  "recipe_type": "dessert",
  "brief_description": "These 7 layer bars are so easy to make, and so rich and delicious! You can use different nuts or baking chips (vanilla or peanut butter) to suit your taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Put butter in 13x9-inch baking dish and place in oven until melted. Swirl to coat bottom and sides with butter."
    },
    {
      "position": 3,
      "text": "Spread graham cracker crumbs evenly over bottom of pan."
    },
    {
      "position": 4,
      "text": "Layer chocolate chips, butterscotch chips, and walnuts over crumbs."
    },
    {
      "position": 5,
      "text": "Pour condensed milk over walnuts and sprinkle with coconut."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until edges are golden brown, about 25 minutes."
    },
    {
      "position": 7,
      "text": "Let cool completely in the pan before cutting into 36 bars."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

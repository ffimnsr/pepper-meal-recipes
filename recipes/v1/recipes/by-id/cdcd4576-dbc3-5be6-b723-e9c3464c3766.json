  "id": "cdcd4576-dbc3-5be6-b723-e9c3464c3766",
  "slug": "baked-pumpkin-bread",
  "name": "Baked Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "This baked pumpkin bread recipe features buttermilk for a moist, tender crumb and cinnamon, brown sugar, and nutmeg for irresistible fall flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda, salt, cinnamon, and nutmeg into a bowl; mix well. Stir in pumpkin, brown sugar, buttermilk, egg, and butter until well blended. Pour batter into a 9x5-inch loaf pan; smooth the top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

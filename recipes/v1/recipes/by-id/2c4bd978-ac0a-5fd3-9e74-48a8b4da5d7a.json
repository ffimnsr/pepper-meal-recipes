  "id": "2c4bd978-ac0a-5fd3-9e74-48a8b4da5d7a",
  "slug": "diabetic-dog-treats",
  "name": "Diabetic Dog Treats",
  "recipe_type": "snack",
  "brief_description": "These diabetic dog treats made with beef liver are easy to prep in a food processor. Even dogs without diabetes will enjoy these home-baked treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 10x15-inch jellyroll pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Place liver into a food processor; pulse until finely chopped. If you have room, add flour and eggs, and process until smooth. Otherwise, transfer to a bowl, and stir in flour and eggs using a wooden spoon. Spread evenly in the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until center is firm, about 15 minutes. Cool in the pan, then cut into squares using a pizza cutter. The treats will have a consistency similar to a sponge. Store in a sealed container in the refrigerator."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

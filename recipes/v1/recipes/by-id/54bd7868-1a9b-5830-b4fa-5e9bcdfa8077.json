  "id": "54bd7868-1a9b-5830-b4fa-5e9bcdfa8077",
  "slug": "copycat-texas-roadhouse-green-beans-recipe-11979330",
  "name": "Copycat Texas Roadhouse Green Beans",
  "recipe_type": "side",
  "brief_description": "These copycat Texas Roadhouse green beans recreate the savory, slow-simmered side dish that makes the restaurant favorite so irresistible. The green beans come out tender and the bacon crisp and the entire dish is incredibly tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in an extra-large skillet over medium heat until crisp, 8 to 10 minutes. Use a slotted spoon to transfer bacon to a paper towel\u2013lined plate. Reserve 2 tablespoons of the rendered bacon grease in the skillet; discard remaining grease."
    },
    {
      "position": 2,
      "text": "Add onion to the skillet with reserved bacon grease. Cook, stirring occasionally, until softened and lightly browned, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Add garlic and vinegar; cook until fragrant and vinegar is slightly reduced, about 1 minute."
    },
    {
      "position": 4,
      "text": "Stir in chicken broth, brown sugar, pepper, and salt; bring to a boil. Add green beans and crumbled bacon. Cover and reduce heat to medium-low. Cook until green beans are tender and flavors are well combined, 10 to 15 minutes. If liquid reduces too quickly, add additional chicken broth, 1 tablespoon at a time, as needed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2cddf9f5-55e4-598d-aa1e-03560632a1ec",
  "slug": "easy-flank-steak-fajitas",
  "name": "Easy Flank Steak Fajitas",
  "recipe_type": "main",
  "brief_description": "This easy flank steak fajitas recipe pairs marinated steak with flavor-packed veggies and creamy toppings, making them perfect for busy weeknight dinners.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place steak in a large resealable plastic bag. Add lime juice, oil, chili powder, salt, and cayenne pepper. Coat steak with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 30 to 60 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove meat from marinade and shake off excess. Discard marinade. Place meat in the center of a (12x18-inch) sheet of heavy-duty aluminum foil. Lift foil sides; double fold top and ends to seal packet, leaving room for heat circulation inside."
    },
    {
      "position": 4,
      "text": "Place peppers, onion, and garlic in the center of a (12x18-inch) sheet of heavy-duty aluminum foil. Repeat folding process to seal packet."
    },
    {
      "position": 5,
      "text": "Wrap tortillas tightly in heavy-duty aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake steak and vegetables in foil packets in the preheated oven until steak reaches desired doneness, 145 degrees F (63 degrees C) for medium-rare, and vegetables are tender, 30 to 35 minutes. Add tortillas to the oven until heated through during the last 10 minutes of baking."
    },
    {
      "position": 7,
      "text": "Open packets carefully by cutting along top fold with a sharp knife, allowing steam to escape. Thinly slice steak."
    },
    {
      "position": 8,
      "text": "Fill warm tortillas with steak and vegetables. Top with guacamole, salsa, and sour cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

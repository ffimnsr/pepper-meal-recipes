  "id": "15bf6592-fe48-5d0a-8202-3a042abefaf4",
  "slug": "savory-rice-krispies-treats-recipe-11840460",
  "name": "Savory Rice Krispies Treats",
  "recipe_type": "appetizer",
  "brief_description": "These savory Rice Krispie treats are an unexpected new spin on an old classic. Toasted sesame seeds, chile seasoned dried mango, sun-dried tomatoes, and sesame oil bring salt, spice, and umami notes to pair with sweet marshmallow. You must try these!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 9-inch square baking pan with cooking spray, and line with parchment paper. Leave an overhang on 2 sides to act as a sling for easy removal."
    },
    {
      "position": 2,
      "text": "Melt butter in a large pot over medium heat. Saute, stirring occasionally, until the milk solids at the bottom start to turn golden brown, 3 to 5 minutes. Reduce the heat to low, and add sesame seeds, chile spiced mango, and sun-dried tomatoes. Saute for 1 to 2 minutes, stirring constantly."
    },
    {
      "position": 3,
      "text": "Fold in marshmallows and salt, and stir until fully melted and combined, 5 to 9 minutes. Turn off the heat and stir in sesame oil."
    },
    {
      "position": 4,
      "text": "Add cereal and quickly fold and stir with a rubber spatula or wooden spoon. Scrape the sticky mixture into the pan; press in evenly with an offset spatula or the back of a spoon."
    },
    {
      "position": 5,
      "text": "Cool completely before removing from the pan. Slice into bars or squares. Store in an airtight container at room temperature."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

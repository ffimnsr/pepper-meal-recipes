  "id": "ca7907b1-3ca8-5cdf-a0d1-8cfb3c3e90b0",
  "slug": "clean-banana-oat-cookies",
  "name": "Clean Banana Oat Cookies",
  "recipe_type": "dessert",
  "brief_description": "These healthy banana oatmeal cookies sweetened with mashed bananas and honey are easy sugar-free, gluten-free, clean-eating snacks to make at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix together mashed bananas, milk, egg, honey, and vanilla in a bowl. Stir in oats, cinnamon, baking powder, and salt until well combined. Add more oats if the batter is too runny."
    },
    {
      "position": 3,
      "text": "Spoon mounds of batter a few inches apart onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the tops look dry and edges are golden, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9de79caf-f455-5d76-8ba2-274ba7accb55",
  "slug": "southern-chicken-and-dumplings",
  "name": "Southern Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "This Southern chicken and dumplings recipe is thick and creamy with a can of condensed cream of chicken soup.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Make the chicken: Melt butter in a large pot over medium heat. Stir in onion and cook until translucent, about 5 minutes. Add chicken breasts, skin-side-down. Pour in chicken broth and just enough water to cover chicken. Increase the heat to high and bring to a simmer. Reduce the heat to medium-low, cover, and simmer until chicken begins to fall off the bone, about 1 hour."
    },
    {
      "position": 2,
      "text": "Transfer chicken to a plate. Remove and discard skin and bones. Allow meat to cool."
    },
    {
      "position": 3,
      "text": "While the chicken is cooling, make the dumplings: Whisk flour, baking powder, and salt together in a mixing bowl. Work in 1/3 cup plus 2 tablespoons shortening with your fingers until mixture resembles coarse crumbs."
    },
    {
      "position": 4,
      "text": "Make a well in the middle and pour in milk; stir until a stiff dough forms. Turn dough out onto a floured surface and knead until smooth. Divide into 16 pieces."
    },
    {
      "position": 5,
      "text": "Make the soup: Add 2 cups water, condensed soup, salt, and pepper to the pot used to cook the chicken."
    },
    {
      "position": 6,
      "text": "Shred chicken, add to the pot, and bring to a boil over medium-high heat. Drop dumplings, one at a time, into soup. Cover, reduce the heat to medium-low, and simmer until dumplings are puffy and no longer doughy in the center, 10 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "expert",

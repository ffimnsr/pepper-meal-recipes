  "id": "f194911c-d862-5b5e-8b02-78352e6c478f",
  "slug": "baked-salmon-in-foil",
  "name": "Baked Salmon in Foil",
  "recipe_type": "main",
  "brief_description": "This baked salmon in foil is made with a large fillet of salmon seasoned with herbs, lemon, and brown sugar, wrapped in a foil packet, then baked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 1/2 cup olive oil, garlic, lemon juice, brown sugar, oregano, thyme, salt, and pepper in a bowl."
    },
    {
      "position": 3,
      "text": "Place a large piece of aluminum foil on a baking sheet and brush with 1 teaspoon olive oil. Place salmon, skin-side down, in the middle of the foil. Drizzle with seasoned olive oil mixture."
    },
    {
      "position": 4,
      "text": "Fold up the edges of the foil over salmon to create a packet, making sure to seal the edges."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 20 to 25 minutes. Garnish with fresh parsley and lemon slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

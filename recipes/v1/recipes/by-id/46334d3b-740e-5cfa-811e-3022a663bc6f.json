  "id": "46334d3b-740e-5cfa-811e-3022a663bc6f",
  "slug": "french-toast-casserole",
  "name": "French Toast Casserole",
  "recipe_type": "dessert",
  "brief_description": "This easy French toast casserole with tender bread cubes and a sweet cinnamon-sugar topping makes a delicious baked breakfast or brunch treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking pan."
    },
    {
      "position": 2,
      "text": "Line the bottom of the prepared pan with bread cubes."
    },
    {
      "position": 3,
      "text": "Beat milk, eggs, 2 tablespoons sugar, salt, and vanilla together in a large bowl until well combined; pour over bread cubes and stir to coat. Dot with butter; let stand for 15 minutes."
    },
    {
      "position": 4,
      "text": "Combine remaining 2 tablespoons sugar with cinnamon; sprinkle over top of casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the center is set and top is golden, about 45 to 50 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

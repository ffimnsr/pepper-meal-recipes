  "id": "f10ba8e7-7b49-50a2-ac8d-6765bc80def6",
  "slug": "slow-cooker-honey-mustard-glazed-ham-recipe-11835939",
  "name": "Slow Cooker Honey Mustard Glazed Ham",
  "recipe_type": "dessert",
  "brief_description": "This slow cooker honey mustard glazed ham is a no-fuss way to prepare a holiday ham that brings maximum flavor. First, honey and Dijon are brushed into all the spiral ham surfaces, then into the slow cooker it goes. An additional fruity, sweet, grainy mustard glaze is applied in the last hour of cooking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together 1 cup honey, butter, and Dijon in a small bowl. Brush ham thoroughly with honey mustard butter mixture making sure to get inside all the layers."
    },
    {
      "position": 2,
      "text": "Place ham face down in the slow cooker. Cover and cook on Low for 7 to 8 hours. Remove 1/2 cup ham drippings and set aside. Continue to cook ham on Low while preparing the glaze."
    },
    {
      "position": 3,
      "text": "Meanwhile, for glaze, in a saucepan over medium-high heat, add pineapple juice, orange juice, whole grain mustard, brown sugar, 3 tablespoons honey, and reserved ham drippings. Bring to a simmer and cook until glaze starts to thicken and is reduced by half."
    },
    {
      "position": 4,
      "text": "Apply the glaze to ham, cover, and cook on Low for about 1 more hour."
    },
    {
      "position": 5,
      "text": "Carefully transfer ham to a serving platter and brush on extra glaze before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 480,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2c738db1-cf9c-5925-8a2e-f65a2fc16e5d",
  "slug": "summer-is-here-triple-berry-peach-pie",
  "name": "Summer is Here Triple Berry Peach Pie",
  "recipe_type": "dessert",
  "brief_description": "This triple berry peach pie recipe bakes up fresh, peaches, strawberries, blueberries, and raspberries in a double-crust that screams, \"Summer is here!\"",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place 1 pie crust in a 9-inch pie plate; brush with \u00bd beaten egg white. Set aside."
    },
    {
      "position": 3,
      "text": "Combine peaches, strawberries, blueberries, and raspberries in a large bowl; set aside. Combine brown sugar, \u00bd cup white sugar, flour, cornstarch, 2 teaspoons cinnamon, and nutmeg in a separate bowl; gently stir into fruit mixture, taking care not to crush berries. Pour fruit mixture into the prepared pie plate; filling will be piled high but will cook down. Dot with butter."
    },
    {
      "position": 4,
      "text": "Cut remaining 1 pie crust into \u00bd-inch strips with a sharp paring knife or pastry wheel. Moisten the rim of the pie with a small amount of water. Start with the longest strips and lay the first 2 in an X in the center of the pie. Alternate horizontal and vertical strips, weaving them in an over-and-under pattern. Use the shortest strips for the edges of the lattice. Fold the ends of the lattice strips under the edge of the bottom crust and flute the crust. Or place remaining 1 pie crust over filling; cut decorative slits in crust to allow steam to escape. Brush top crust with remaining \u00bd egg white."
    },
    {
      "position": 5,
      "text": "Combine 1 tablespoon sugar and 1 teaspoon cinnamon in a small bowl; sprinkle over top of pie. Place pie on a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crust is golden brown and filling is bubbly, 45 to 60 minutes. Turn off the oven; let pie sit in the oven for 30 minutes. Transfer pie to a wire rack to cool. The filling will be loose if served warm but thicken when pie is completely cooled."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

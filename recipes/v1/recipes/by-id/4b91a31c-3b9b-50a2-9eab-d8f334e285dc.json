  "id": "4b91a31c-3b9b-50a2-9eab-d8f334e285dc",
  "slug": "burrito-pie",
  "name": "Burrito Pie",
  "recipe_type": "main",
  "brief_description": "Ground beef, refried beans and tomatoes are combined with chiles and taco sauce, then layered in a casserole with tortillas and cheese, and baked.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large skillet over medium heat, saute the ground beef for 5 minutes. Add the onion and garlic, and saute for 5 more minutes. Drain any excess fat, if desired. Mix in the olives, green chile peppers, tomatoes with green chile peppers, taco sauce and refried beans. Stir mixture thoroughly, reduce heat to low, and let simmer for 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Spread a thin layer of the meat mixture in the bottom of a 4 quart casserole dish. Cover with a layer of tortillas followed by more meat mixture, then a layer of cheese. Repeat tortilla, meat, cheese pattern until all the tortillas are used, topping off with a layer of meat mixture and cheese."
    },
    {
      "position": 4,
      "text": "Bake for 20 to 30 minutes in the preheated oven, or until cheese is slightly brown and bubbly."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "90d02449-3015-5ce9-ad4d-7f4678f4348a",
  "slug": "gluten-free-zucchini-bread",
  "name": "Gluten-Free Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "This gluten-free zucchini bread is moist, tender, and a delicious way to use fresh zucchini. Drizzle a simple lemon glaze on top for a sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Combine zucchini, oil, eggs, and vanilla in a blender; pulse until mixture resembles a milkshake."
    },
    {
      "position": 3,
      "text": "Whisk sugar, rice flours, cornstarch, tapioca starch, baking powder, cinnamon, baking soda, xanthan gum, and salt together in a large bowl. Stir in zucchini mixture until batter is well blended; pour into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pan for a few minutes before removing to cool completely on a wire rack."
    },
    {
      "position": 5,
      "text": "While the bread is cooling, make the glaze: Mix confectioners' sugar and lemon juice together in a small bowl to form a thin glaze. Drizzle over the cooled loaf."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

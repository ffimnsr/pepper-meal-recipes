  "id": "7afaa4e8-500a-52d0-85f1-73079795f5d4",
  "slug": "smoked-pork-chops-with-sauerkraut-recipe-8732958",
  "name": "Smoked Pork Chops with Sauerkraut",
  "recipe_type": "main",
  "brief_description": "These smoked pork chops with sauerkraut make a fairly quick-and-easy, satisfying weeknight meal. The chops are already fully cooked, so they don\u2019t need a lot of time braising.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium-high heat. Quickly sear meat for 2 minutes on each side, and remove from pan. Reduce heat to medium, add onions, and saute for 3 minutes."
    },
    {
      "position": 2,
      "text": "Stir in sauerkraut, apple, beef broth, bacon grease, garlic, juniper berries, and bay leaf. Bring to a boil, reduce heat to low, cover, and simmer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Remove bay leaf, add chops back to skillet, and nestle in the kraut. Simmer just until chops are warmed up, 3 to 5 minutes. Cooking further will dry them out."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "06e82707-a2b7-5085-b0ef-7a04a74867f0",
  "slug": "garlic-ginger-chicken-meatball-bowls-recipe-7570245",
  "name": "Garlic Ginger Chicken Meatball Bowls",
  "recipe_type": "soup",
  "brief_description": "Chicken meatballs star in this dish. In fact, they can be used for Asian-inspired lettuce wraps, in soup, or in a stir-fry. The cooking technique ensures that the meatballs stay tender.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, garlic, ginger, onion, 1 tablespoon light soy sauce, sake, egg, panko, and green onions in a bowl. Gently mix and form into 1-inch meatballs. Place shaped meatballs onto a parchment lined tray."
    },
    {
      "position": 2,
      "text": "For sauce, whisk together 2 teaspoons light soy sauce, dark soy sauce, honey, oyster sauce, water, and cornstarch in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of water to a boil over high heat. Using a spider or slotted spoon, carefully lower chicken meatballs into boiling water - you may have to do this in batches. Cook until meatballs float to the top, 3 to 4 minutes. Remove meatballs with a spider or slotted spoon."
    },
    {
      "position": 4,
      "text": "Heat sesame oil in a wok. Add chicken meatballs, and cook until lightly browned, about 3 minutes. Pour sauce ingredients into the wok. Add the mixed vegetables, toss to mix. Cook until vegetables are crisp-tender, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Place 1/2 cup cooked jasmine rice in each bowl or on each plate. Add cooked vegetables and chicken meatballs. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

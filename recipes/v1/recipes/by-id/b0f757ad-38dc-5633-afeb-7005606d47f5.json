  "id": "b0f757ad-38dc-5633-afeb-7005606d47f5",
  "slug": "plum-crisp",
  "name": "Plum Crisp",
  "recipe_type": "dessert",
  "brief_description": "This plum crisp is a simple fruit dessert with a sweet and crispy baked buttery topping that uses fresh summer plums for an easy, delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Spread chopped plums evenly into the prepared baking dish and sprinkle with 1/4 cup sugar."
    },
    {
      "position": 3,
      "text": "Mix flour, remaining 3/4 cup sugar, baking powder, and salt together in a large bowl; stir in beaten egg. Spoon mixture over plums and drizzle batter with melted butter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until fruit is bubbling and topping is golden brown and crisp, about 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

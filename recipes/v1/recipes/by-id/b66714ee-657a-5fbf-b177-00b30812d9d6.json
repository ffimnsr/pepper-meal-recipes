  "id": "b66714ee-657a-5fbf-b177-00b30812d9d6",
  "slug": "shepherds-pie-daddys-way",
  "name": "Shepherd's Pie Daddy's Way",
  "recipe_type": "soup",
  "brief_description": "This shepherd's pie without vegetables features ground beef, canned golden mushroom soup, and American cheese topped with homemade mashed potatoes.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes into a large saucepan with enough water to cover; bring to a boil. Cook until potatoes are tender, 8 to 10 minutes. Drain, then mash."
    },
    {
      "position": 3,
      "text": "While potatoes are cooking, crumble beef into a large skillet over medium-high heat. Cook and stir until evenly browned. Drain off grease, then stir in condensed soup until well combined."
    },
    {
      "position": 4,
      "text": "Transfer beef mixture to an 8-inch square baking dish and cover with cheese. Spread mashed potatoes evenly over the top. Dot with butter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the top is golden brown, 20 to 25 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

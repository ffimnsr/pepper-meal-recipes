{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ab1aa06f-f743-5e00-b93b-eab8b8edce8d",
  "slug": "tortellini-with-sausage-and-peppers",
  "name": "Tortellini with Sausage and Peppers",
  "recipe_type": "main",
  "brief_description": "This tortellini with sausage and peppers recipe is for a quick homemade meat sauce with sausage, bell peppers, and tomatoes tossed with tortellini.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sausage links and 1 cup water in a large skillet; bring to a boil, about 5 minutes. Cover, reduce heat, and simmer until juices run clear, about 15 minutes. Drain water from skillet."
    },
    {
      "position": 2,
      "text": "Cook links in the skillet, stirring frequently, until browned, 2 to 4 minutes. Remove from skillet, cool, and cut into 1/2-inch diagonal slices. Wipe skillet clean using a paper towel."
    },
    {
      "position": 3,
      "text": "Heat skillet over medium heat; add olive oil. Add onion; cook until tender but not brown, 3 to 5 minutes. Add garlic; cook until fragrant, about 30 seconds. Stir in tomatoes, tomato paste, wine, oregano, and red pepper flakes. Stir in bell pepper and cooked sausage. Bring to a boil, about 5 minutes. Reduce heat, cover, and simmer until reaches desired thickness, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini, reduce heat slightly, and return to a boil. Cook, uncovered, stirring occasionally, until tortellini float to the top, filling is hot, and tender but still firm to the bite, 5 to 10 minutes. Drain. Return tortellini to the warm pot. Stir parsley into sausage mixture; pour sauce over tortellini. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

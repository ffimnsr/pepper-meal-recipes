  "id": "60cf9f07-d39f-5a79-aa7d-a0b447c49c82",
  "slug": "peanut-butter-pie",
  "name": "Peanut Butter Pie",
  "recipe_type": "dessert",
  "brief_description": "This homemade peanut butter pie recipe makes a creamy peanut butter filling with easy ingredients in a graham cracker crust for a delicious sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, peanut butter, and confectioners' sugar together until smooth."
    },
    {
      "position": 3,
      "text": "Fold in 1/2 of the whipped topping, then spoon the mixture into graham cracker crust."
    },
    {
      "position": 4,
      "text": "Spread remaining whipped topping over the peanut butter mixture and garnish with peanut butter cups. Chill for at least 2 hours or overnight before serving."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,

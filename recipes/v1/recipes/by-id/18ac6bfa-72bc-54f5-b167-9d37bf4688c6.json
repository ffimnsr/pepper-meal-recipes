  "schema_version": 1,
  "id": "18ac6bfa-72bc-54f5-b167-9d37bf4688c6",
  "slug": "crunchy-granola-breakfast-cereal",
  "name": "Crunchy Granola Breakfast Cereal",
  "recipe_type": "dessert",
  "brief_description": "A deluxe version of crunchy oat granola is flavored with pumpkin and pecans and sweetened with agave syrup for a bowl of hearty goodness that will keep you going all morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix together rolled oats, flax seed meal, steel-cut oats, oat bran, pecans, and wheat germ in a large bowl until well combined. Whisk together agave nectar, pumpkin, brown sugar, water, canola oil, vanilla, pumpkin pie spice, and sea salt in a separate bowl, stirring until brown sugar and salt are dissolved. Pour pumpkin mixture over oats mixture; stir to coat. Spread mixture on the prepared baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 hour, stirring every 20 minutes. Stir dates into granola and continue baking until granola is lightly golden brown, 20 to 30 more minutes, stirring once. Let cool completely."
    },
    {
      "position": 4,
      "text": "Mix chocolate chips into cooled granola until evenly combined. Store in an airtight container."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

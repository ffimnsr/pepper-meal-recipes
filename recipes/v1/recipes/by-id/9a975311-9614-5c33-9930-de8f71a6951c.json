  "id": "9a975311-9614-5c33-9930-de8f71a6951c",
  "slug": "15-minute-chicken-recipe-11842214",
  "name": "This 15-Minute Chicken Dinner Makes Weeknights Easy\u2014And It's Only 5 Ingredients!",
  "recipe_type": "main",
  "brief_description": "This 15-minute chicken is a quick, budget-friendly weeknight dinner with a few simple ingredients, made in one pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add honey, Dijon, and red pepper flakes to a small bowl and stir until well combined; set aside."
    },
    {
      "position": 2,
      "text": "Combine flour, salt, and pepper in a small dish. Pat chicken tenders dry with a paper towel, add to flour mixture, coating all sides, and shake off excess flour."
    },
    {
      "position": 3,
      "text": "Heat oil in a nonstick skillet over medium heat. Place tenders in the skillet, and cook for about 2 minutes per side, just until no longer pink at the center and juices run clear. An instant read thermometer inserted near the center should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Drizzle honey mixture over chicken tenders, and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

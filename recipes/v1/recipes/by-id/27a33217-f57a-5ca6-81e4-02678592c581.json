  "id": "27a33217-f57a-5ca6-81e4-02678592c581",
  "slug": "sweet-pulled-pork-barbacoa",
  "name": "Sweet Pulled Pork Barbacoa",
  "recipe_type": "dessert",
  "brief_description": "Sweetened with soda and brown sugar and given a zesty kick with chiles and salsa, this pulled pork barbacoa is full of flavor and simple to prepare in a slow cooker.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork shoulder fat-side-up in a slow cooker. Cover with soda, garlic powder, 1 teaspoon salt, and 1/4 teaspoon pepper."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low until pork is tender and can be easily pulled apart with a fork, 8 to 10 hours."
    },
    {
      "position": 3,
      "text": "Remove any bones and solid hunks of fat from pork and discard. Shred with 2 forks; stir pork into its juices. Add brown sugar, green chiles, salsa verde, and habanero pepper. Season with salt and pepper. Stir well to combine."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until flavors are absorbed, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 540,
  "preparation_time_minutes": 10,

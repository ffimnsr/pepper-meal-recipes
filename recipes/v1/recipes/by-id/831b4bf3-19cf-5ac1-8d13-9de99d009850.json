  "id": "831b4bf3-19cf-5ac1-8d13-9de99d009850",
  "slug": "lemon-poppy-seed-bundt-cake",
  "name": "Lemon Poppy Seed Bundt Cake",
  "recipe_type": "dessert",
  "brief_description": "This lemon poppy seed Bundt cake is a cinch to make with lemon cake mix, pudding mix, and poppy seeds for a deliciously moist, crowd-pleasing cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak poppy seeds in milk for 2 hours. Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan."
    },
    {
      "position": 2,
      "text": "Stir cake mix and pudding mix together in a large bowl; make a well in the center and pour in water, oil, and eggs. Beat with an electric mixer on low speed until blended. Scrape bowl, and beat 4 minutes on medium speed. Blend in poppy seed mixture. Pour batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

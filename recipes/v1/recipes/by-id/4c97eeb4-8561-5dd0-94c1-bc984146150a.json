  "id": "4c97eeb4-8561-5dd0-94c1-bc984146150a",
  "slug": "garlic-shrimp-and-asparagus-risotto",
  "name": "Garlic Shrimp and Asparagus Risotto",
  "recipe_type": "main",
  "brief_description": "This shrimp and fresh asparagus risotto with a creamy Parmesan cheese and butter finish is definitely worth the effort it takes to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour chicken broth into a pot; bring to a simmer over medium-low heat."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large saucepan over medium heat. Cook and stir onion and garlic in hot oil until slightly softened, about 2 minutes. Add Arborio rice; cook, stirring frequently, until coated with oil, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Stir 1/2 cup hot chicken broth into the saucepan; cook and stir until rice has absorbed broth, about 2 minutes. Repeat this process 4 more times, stirring constantly, until rice is creamy and tender yet firm to the bite, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir shrimp and asparagus into remaining hot broth. Cook until shrimp turns pink, 2 to 3 minutes. Remove broth from heat."
    },
    {
      "position": 5,
      "text": "Use a slotted spoon to transfer shrimp and asparagus to rice; cook and stir for 1 minute. Stir Parmesan cheese and butter into rice; cook until melted, about 1 minute. Remove rice from heat. Season with salt and pepper. Sprinkle parsley over each serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

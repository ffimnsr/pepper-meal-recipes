  "id": "fac1671c-13e0-5f1b-95fa-33c40cf010f8",
  "slug": "marinated-baked-pork-chops",
  "name": "Marinated Baked Pork Chops",
  "recipe_type": "main",
  "brief_description": "A 15-minute pork chop marinade of soy sauce, Worcestershire, and ketchup makes these oven-baked pork chops moist and flavorful for a delicious supper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Thoroughly blend oil, ketchup, brown sugar, Worcestershire sauce, soy sauce, and lemon juice in a small bowl."
    },
    {
      "position": 3,
      "text": "Place pork chops in a medium baking dish. Pour 1/2 of the sauce over chops."
    },
    {
      "position": 4,
      "text": "Bake pork chops in the preheated oven for 30 minutes. Flip chop and cover with remaining sauce. Continue baking until the internal temperature of the chops reaches 145 degrees F (63 degrees C), about 30 minutes longer."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

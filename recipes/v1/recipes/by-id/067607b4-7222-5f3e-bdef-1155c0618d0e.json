  "id": "067607b4-7222-5f3e-bdef-1155c0618d0e",
  "slug": "quince-jelly",
  "name": "Quince Jelly",
  "recipe_type": "side",
  "brief_description": "Homemade quince jelly is the perfect way to use quince when in season for a wonderful pink fruity preserve that's delicious with cheese!",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Sterilize eight \u00bd-pint jars in boiling water for at least 5 minutes, and have new lids ready."
    },
    {
      "position": 2,
      "text": "Place quinces in a large pot, and pour in water. Bring to a boil, then reduce heat to low; simmer, covered, for 15 minutes. Strain off 4 cups of juice. Mix juice with sugar and lemon juice in a heavy pot, and bring to a boil over high heat, constantly stirring. Stir in pectin, and return to a boil. Boil for 1 full minute, constantly stirring. Remove from heat and skim off foam. Ladle into hot sterile jars, and process for 10 minutes in a hot water bath to seal."
    },
    {
      "position": 3,
      "text": "Store sealed jars in a cool dark place. Refrigerate jelly after opening."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,

  "id": "f140206c-3e10-58a5-ad40-5f59e05e64c7",
  "slug": "southern-baked-beans-recipe-7554356",
  "name": "Southern Baked Beans",
  "recipe_type": "side",
  "brief_description": "Southern baked beans are the perfect side for pulled pork or ribs. They are easy to make and loved by all.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Cook ground beef on a large skillet over medium-high heat until browned, 5 to 8 minutes. Remove from skillet and reserve."
    },
    {
      "position": 3,
      "text": "Cook bacon in the same skillet 5 minutes."
    },
    {
      "position": 4,
      "text": "Add onion and green pepper to skillet. Cook, stirring frequently, until bacon is crisp and onion is translucent, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Add ground beef, brown sugar, ketchup, Worcestershire sauce, and mustard to the bacon mixture; stir until combined."
    },
    {
      "position": 6,
      "text": "Add ground beef mixture and beans to a 13x9-inch baking dish, stir to combine."
    },
    {
      "position": 7,
      "text": "Bake until bubbly, 40 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 58,
  "preparation_time_minutes": 10,

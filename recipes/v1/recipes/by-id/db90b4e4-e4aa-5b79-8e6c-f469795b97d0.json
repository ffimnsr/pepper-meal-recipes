  "id": "db90b4e4-e4aa-5b79-8e6c-f469795b97d0",
  "slug": "white-wine-sangria",
  "name": "Easy White Sangria",
  "recipe_type": "drink",
  "brief_description": "Raspberries, strawberries, honeydew, and watermelon soak in white wine in this easy white sangria recipe for a cool and refreshing summertime beverage.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine white wine, watermelon, honeydew, strawberries, and raspberries in a large pitcher. Chill in the refrigerator to allow flavors to blend, at least 1 hour."
    },
    {
      "position": 2,
      "text": "Pour chilled wine and fruit into goblets; top each with a splash of ginger ale."
    }
  ],
  "servings": 6,

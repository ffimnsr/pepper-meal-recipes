  "id": "60785345-1e53-5a06-ae4b-9839264cd4ad",
  "slug": "borscht-with-meat",
  "name": "Borscht with Meat",
  "recipe_type": "soup",
  "brief_description": "Grated beets, bacon, polish sausage and lean beef chuck are cooked in a piquant broth in this red soup loaded with vegetables.",
  "cuisine": "Russian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1/2 cup of the beets, the vinegar, and sugar in a small bowl; refrigerate, covered, overnight. Refrigerate remaining beets."
    },
    {
      "position": 2,
      "text": "Place beef, water, bacon, salt, peppercorns, parsley sprigs, marjoram, and dill seeds (or basil leaves) in Dutch oven. Heat to boiling. Reduce heat, simmer, partially covered, over medium heat until beef is tender (about 2 hours)."
    },
    {
      "position": 3,
      "text": "Discard parsley sprigs. Add 3 cups beets, the cabbage, leeks, onions, carrot, and sausage; simmer, covered, over low heat 30 minutes."
    },
    {
      "position": 4,
      "text": "To serve, remove beef, bacon, and sausage; cut into 2-inch pieces. Return meats and reserved beet mixture to Dutch oven. Sprinkle with snipped dill. Pass sour cream."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 130,

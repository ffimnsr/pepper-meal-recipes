  "id": "08034c25-c149-54bb-a75a-75b377fcdc42",
  "slug": "jeans-homemade-chicken-noodle-soup",
  "name": "Jean's Homemade Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "Fresh ginger root gives extra zest to this otherwise standard chicken noodle recipe. This soup can be prepared in less than a half hour, and is great comfort food, especially during cold season.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over medium heat combine the broth, water, carrots, celery and ground black pepper and allow to cook. In a medium skillet over medium high heat, combine the ginger, oil and chicken. Saute for about 5 minutes and remove the sliced ginger."
    },
    {
      "position": 2,
      "text": "Add the chicken to the broth mixture, bring to a boil and then add the egg noodles. Continue to cook over medium heat for about 15 minutes until noodles and vegetables are tender."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

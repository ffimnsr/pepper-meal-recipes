  "slug": "fresh-cranberry-relish",
  "name": "Fresh Cranberry Relish",
  "recipe_type": "side",
  "brief_description": "In this uncooked relish, cranberries are coarsely chopped in the bowl of a food processor with crushed pineapple, Mandarin orange slices, and fresh apple chunks.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a food processor, combine cranberries, pineapple, apples and oranges. Blend into small chunks, add sugar if needed. Chill and serve."
    }

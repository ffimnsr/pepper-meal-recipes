  "id": "fc347bf8-62d8-59c6-af50-fd2504f9e6b8",
  "slug": "easy-cheeseburger-garbage-bread-recipe-11844151",
  "name": "Easy Cheeseburger Garbage Bread",
  "recipe_type": "appetizer",
  "brief_description": "This easy cheeseburger garbage bread is pizza dough, filled with all the ingredients you'd find in a 2-cheese burger, in one giant loaf. It's a great game-day food; just slice and serve with burger sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Fry bacon in a skillet over medium heat until crisp, 7 to 10 minutes. Remove from the skillet to drain on paper towels; crumble when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Add onions to the skillet, reduce heat to medium, and continue cooking until softened, about 5 minutes. Remove from heat and stir in bacon, pickles, ketchup, mustard, and Worcestershire sauce; set aside."
    },
    {
      "position": 4,
      "text": "Line a baking sheet with parchment, and sprinkle parchment lightly with flour. Unroll pizza dough onto the baking sheet. Press and stretch dough into a 10x15-inch rectangle."
    },
    {
      "position": 5,
      "text": "Spoon meat mixture down the center of the dough lengthwise. Place American cheese slices over meat; sprinkle evenly with half the Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Make 2-inch cuts into the dough from both long edges toward the meat mixture in the center, about 1 inch apart. Starting at the top, stretch each strip across in a crisscross pattern to form a loaf."
    },
    {
      "position": 7,
      "text": "Brush the loaf with beaten egg. Sprinkle with sesame seeds and top with remaining Cheddar."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until cheese begins to turn golden brown, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

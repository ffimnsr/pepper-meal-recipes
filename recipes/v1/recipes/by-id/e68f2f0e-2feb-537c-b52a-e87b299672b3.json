{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e68f2f0e-2feb-537c-b52a-e87b299672b3",
  "slug": "sweet-potato-black-bean-quesadillas",
  "name": "Sweet Potato-Black Bean Quesadillas",
  "recipe_type": "dessert",
  "brief_description": "Sweet potatoes and black beans are paired in this vegetarian quesadilla for a wonderful take on a classic.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cubed sweet potatoes, olive oil, chili powder, cumin, oregano, garlic powder, onion powder, and a generous amount of salt and cracked pepper in a bowl. Spread cubes out in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 12 minutes, stir, flip, and return to the oven to bake until tender, 10 to 12 more minutes. Taste and season with additional salt if required."
    },
    {
      "position": 4,
      "text": "Lay out one tortilla on a flat surface and place 1/2 cup Cheddar on one half of the tortilla. Top with a few scoops of roasted sweet potatoes and a generous scoop of black beans. Spoon over 2 tablespoons salsa and top with 1/2 cup Monterey Jack cheese. Fold tortilla over the filling and gently press it down."
    },
    {
      "position": 5,
      "text": "Heat a large skillet over medium heat."
    },
    {
      "position": 6,
      "text": "Place quesadilla onto hot skillet without any oil and cook until golden brown, about 2 minutes. Carefully flip quesadilla and continue cooking for 2 more minutes. Repeat with remaining ingredients until all 4 quesadillas are fried up."
    },
    {
      "position": 7,
      "text": "Slice them in half and serve each quesadilla with a couple dollops of sour cream, fresh cilantro, and additional salsa if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

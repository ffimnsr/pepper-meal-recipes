  "id": "eb1a8eaa-49e6-596c-8e9e-e0e4153916ef",
  "slug": "dietetic-banana-nut-muffins",
  "name": "Dietetic Banana Nut Muffins",
  "recipe_type": null,
  "brief_description": "These muffins have no sugar and no fat, but are moist and tasty. Instead of regular applesauce, I sometimes use mango-peach to give the muffins more flavor. Great recipe for diabetics! You can use all white flour instead the whole wheat flour, too.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12 cup muffin tin, or line with paper muffin liners."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together the flour, sugar substitute, baking powder, baking soda, and cinnamon. In a separate bowl, mix together the egg whites, mashed banana and applesauce. Add the wet ingredients to the dry, and mix until just blended. Fill prepared muffin cups 3/4 full."
    },
    {
      "position": 3,
      "text": "Bake for 15 to 18 minutes in the preheated oven, or until the top springs back when lightly touched. Allow muffins to cool in the pan over a wire rack for a little while before tapping them out of the pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

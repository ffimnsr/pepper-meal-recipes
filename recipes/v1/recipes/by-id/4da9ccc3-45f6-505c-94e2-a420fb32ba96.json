  "id": "4da9ccc3-45f6-505c-94e2-a420fb32ba96",
  "slug": "peanut-butter-popcorn-balls",
  "name": "Peanut Butter Popcorn Balls",
  "recipe_type": "dessert",
  "brief_description": "This quick peanut butter popcorn balls recipe only requires a few basic ingredieints you likely have on hand, including peanut butter and popcorn.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine brown sugar, corn syrup, and butter in a large saucepan over medium heat; cook and stir until mixture comes to a rolling boil. Off heat, stir in peanut butter until smooth."
    },
    {
      "position": 2,
      "text": "Place popcorn into a large bowl. Pour peanut butter mixture over top: toss until evenly coated. Form mixture into about 16 balls using buttered hands. Arrange balls on a waxed paper-lined baking sheet and let set for at least 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,

  "id": "0edee956-cd1a-5108-8134-84ac49a7aec3",
  "slug": "easy-cherry-tomato-corn-salad",
  "name": "Easy Cherry Tomato Corn Salad",
  "recipe_type": "salad",
  "brief_description": "This cherry tomato corn salad recipe with cucumber features a sweet lime-basil vinaigrette and chopped jalape\u00f1o, which adds a welcome zing to every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place basil, olive oil, lime juice, sugar, salt, and black pepper in a jar; screw on the lid and shake until vinaigrette is completely blended."
    },
    {
      "position": 2,
      "text": "Combine corn, tomatoes, cucumber, shallots, and jalape\u00f1o in a large bowl; drizzle with vinaigrette and toss to coat. Refrigerate until ready to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

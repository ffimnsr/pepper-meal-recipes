  "id": "b2cfa0fa-0dca-5073-afc3-64e03d4e7443",
  "slug": "southern-tomato-gravy-recipe-12016235",
  "name": "Southern Tomato Gravy",
  "recipe_type": "side",
  "brief_description": "This Southern tomato gravy is a delicious way to use up mountains of fresh summer tomatoes. Made with bacon grease for rich, homestyle flavor, it\u2019s delicious spooned over hot buttered biscuits, fluffy rice, or anything that could use a taste of Southern comfort.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a saucepan over medium-high heat. Add onion and cook until slightly softened, stirring often, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Sprinkle flour over onions and cook, stirring constantly, about 1 minute. Add tomatoes, garlic powder, and chicken broth and stir until well combined. Bring mixture to a simmer."
    },
    {
      "position": 3,
      "text": "Reduce heat, partially cover and cook 15 minutes or until tomatoes are very tender and mixture has thickened, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Season to taste with salt and pepper. Stir in butter and remove from heat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

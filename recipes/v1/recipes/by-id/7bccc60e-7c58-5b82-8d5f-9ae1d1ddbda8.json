  "id": "7bccc60e-7c58-5b82-8d5f-9ae1d1ddbda8",
  "slug": "thanksgiving-turkey-brine",
  "name": "Thanksgiving Turkey Brine",
  "recipe_type": "main",
  "brief_description": "This easy turkey brine recipe makes this year's Thanksgiving turkey the juiciest and most flavorful one you have ever prepared.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix water, chicken broth, and salt together in a 5-gallon bucket with a lid until salt dissolves. Add garlic, rosemary, onion, basil, savory, marjoram, thyme, tarragon, oregano, pepper, and coriander; mix well. Stir 2 cups ice into brine."
    },
    {
      "position": 2,
      "text": "Place turkey into brine, filling cavity with brine. Add enough ice to the bucket to cover turkey. Secure the lid on the bucket. Swish bucket from side to side to chill water. Refrigerate turkey and bucket for 12 to 24 hours; refill with ice every 2 hours as needed."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove turkey from brine and pat dry. Discard brine. Place turkey on a rack inside a roasting pan."
    },
    {
      "position": 5,
      "text": "Bake turkey in the preheated oven, basting every 30 to 40 minutes, until no longer pink at the bone and the juices run clear, 5 to 6 1/2 hours. An instant-read thermometer inserted into the thickest part of the thigh should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove turkey from the oven, cover with a doubled sheet of aluminum foil, and rest for 5 to 10 minutes before slicing."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

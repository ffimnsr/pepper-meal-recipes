  "slug": "tuna-egg-sandwich",
  "name": "Tuna Egg Sandwich",
  "recipe_type": "salad",
  "brief_description": "This tuna salad with egg recipe is perfect for a satisfying sandwich. It's simple to make with canned tuna, hard-cooked eggs, mayo, and celery.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine eggs, tuna, celery, and mayonnaise in a medium bowl. Season with salt and pepper to taste."
    },
    {
      "position": 2,
      "text": "Divide tuna mixture evenly onto two slices of bread; top with remaining slices of bread."
    }
  ],
  "servings": 2,

  "id": "9a4e8bf0-c29d-5af4-880e-3afca04f9948",
  "slug": "grandmas-chocolate-zucchini-bread",
  "name": "Grandma's Chocolate Zucchini Bread",
  "recipe_type": "breakfast",
  "brief_description": "This chocolaty twist on zucchini bread makes you forget it contains zucchini. It's rich and moist, with just the right amount of crunch from walnuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two loaf pans."
    },
    {
      "position": 2,
      "text": "Combine flour, cocoa, salt, baking soda, cinnamon, and baking powder in a medium bowl and mix together. Set aside."
    },
    {
      "position": 3,
      "text": "Cream sugar, butter, oil, and vanilla extract together in a large bowl with an electric mixer until smooth. Add eggs, one at a time, until mixed. Mix dry ingredients slowly into wet ingredients on medium speed until well combined. Fold in chocolate chips, zucchini, and walnuts with a silicone spatula. Pour batter equally into the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in each loaf comes out clean, 40 to 50 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

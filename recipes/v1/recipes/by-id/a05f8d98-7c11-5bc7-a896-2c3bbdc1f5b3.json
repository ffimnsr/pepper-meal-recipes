  "id": "a05f8d98-7c11-5bc7-a896-2c3bbdc1f5b3",
  "slug": "leslies-ham-lentil-soup",
  "name": "Leslie's Ham Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "A ham bone left over from a previous meal gets a second chance when simmered with lentils and vegetables to make a hearty lentil ham bone soup in less than an hour.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and chicken bouillon granules to a boil in a stock pot; stir to dissolve bouillon. Place ham bone in boiling broth, reduce heat to medium-low, and stir in lentils. Simmer until lentils begin to soften, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir celery, carrots, green bell pepper, onion, marjoram, and bay leaf into broth and simmer until lentils and vegetables are tender, 10 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Turn off heat and remove ham bone from soup. Cut ham from bone and cube meat. Return meat to soup and discard bone."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

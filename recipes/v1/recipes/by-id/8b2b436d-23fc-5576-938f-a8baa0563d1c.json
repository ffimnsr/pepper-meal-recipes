  "id": "8b2b436d-23fc-5576-938f-a8baa0563d1c",
  "slug": "tortellini-pesto-salad",
  "name": "Pesto Tortellini Salad",
  "recipe_type": "salad",
  "brief_description": "This tortellini pasta salad with basil pesto, tender broccoli, carrots, red pepper, and olives is loaded with Italian flavors and perfect for picnics.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Place tortellini in the pot and cook until al dente, 7 to 8 minutes. Drain and cool."
    },
    {
      "position": 3,
      "text": "Mix cooked tortellini, bell pepper, broccoli, carrots, olives, and garlic in a large bowl."
    },
    {
      "position": 4,
      "text": "Whisk mayonnaise, pesto, milk, Parmesan cheese, oil, and vinegar together in a separate bowl. Pour over tortellini and vegetables and gently toss to coat."
    },
    {
      "position": 5,
      "text": "For best flavor results, cover and place in the refrigerator until chilled. Serve over spinach leaves."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

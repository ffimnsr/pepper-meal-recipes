  "id": "f74e15aa-8e84-5626-9f67-709f5ec52545",
  "slug": "deep-fried-california-roll-rice-balls",
  "name": "Deep-Fried California Roll Rice Balls",
  "recipe_type": "appetizer",
  "brief_description": "These fried California rolls are loved by sushi eaters. They're made with cream cheese, avocado, imitation crab, and a crunchy bread crumb coating.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Toss together crabmeat and avocado in a medium bowl for the filling and place in the refrigerator to chill until needed. Place bread crumbs in a shallow bowl and set aside."
    },
    {
      "position": 2,
      "text": "Bring water to a boil over high heat. Add rice; stir, cover, and remove from heat. Let sit until water is absorbed, about 5 minutes, then fluff with a fork."
    },
    {
      "position": 3,
      "text": "When rice is set and still hot, blend in cream cheese, soy sauce, garlic salt, and pepper until cream cheese is fully incorporated and no chunks remain."
    },
    {
      "position": 4,
      "text": "Scoop out a golf ball-sized handful of rice mixture and flatten it into a patty. Add about a heaping teaspoon avocado-crab filling into the center. Cup your hand and shape rice around filling. Roll between your hands to seal and get a good round shape; patch any holes with more rice if needed. Roll in bread crumbs until well coated. Repeat with remaining rice mixture and filling."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Cook 1 to 2 rice balls at a time in hot oil. If not fully submerged, let each side of rice ball fry until golden brown, about 30 seconds per side. Remove to a paper towel-lined plate to drain. Repeat with remaining rice balls."
    },
    {
      "position": 7,
      "text": "Combine mayonnaise and Sriracha in a small bowl. Serve with rice balls for dipping."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "778cce64-d774-5357-8dce-1a2c2796701d",
  "slug": "air-fryer-lobster-tails-with-lemon-garlic-butter",
  "name": "Air Fryer Lobster Tails with Lemon-Garlic Butter",
  "recipe_type": "main",
  "brief_description": "Air fry lobster tails until succulent and delicious; top with a lemon garlic butter sauce for an easy, fancy meal for two at home in just 10 minutes.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an air fryer to 380 degrees F (195 degrees C)."
    },
    {
      "position": 2,
      "text": "Butterfly lobster tails by cutting lengthwise through the centers of the hard top shells and meat with kitchen shears. Cut to, but not through, the bottoms of the shells."
    },
    {
      "position": 3,
      "text": "Spread tail halves apart. Place tails in the air fryer basket with lobster meat facing up."
    },
    {
      "position": 4,
      "text": "Melt butter in a small saucepan over medium heat. Add lemon zest and garlic; heat until garlic is fragrant, about 30 seconds."
    },
    {
      "position": 5,
      "text": "Transfer 2 tablespoons of butter mixture to a small bowl; brush this onto lobster tails. Discard any remaining brushed butter to avoid contamination from uncooked lobster. Season lobster with salt and pepper."
    },
    {
      "position": 6,
      "text": "Cook in the preheated air fryer until lobster meat is opaque, 5 to 7 minutes."
    },
    {
      "position": 7,
      "text": "Spoon reserved butter from the saucepan over lobster meat. Top with parsley and serve with lemon wedges."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0e637fbe-39cb-531f-855e-4ce4644ef748",
  "slug": "4-ingredient-banana-bread-recipe-8707031",
  "name": "4-Ingredient Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "This 4-Ingredient banana bread could not be easier - is is wonderfully sweet from overripe bananas and has a nice crust",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9- x 5-inch loaf pan with parchment paper, leaving a 2-inch overhang on all sides; set aside."
    },
    {
      "position": 3,
      "text": "Mash 4 of the bananas in a large bowl using a fork until mostly smooth to equal 1 1/2 cups. Add eggs and 1/2 cup brown sugar; stir until combined."
    },
    {
      "position": 4,
      "text": "Add flour to the banana mixture; stir until just combined and no dry streaks remain, scraping down the sides of the bowl as needed."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared loaf pan and spread into an even layer."
    },
    {
      "position": 6,
      "text": "Slice remaining banana in half lengthwise; lay banana halves over the top, cut side up. Evenly sprinkle remaining 1 tablespoon brown sugar over the top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a wooden pick inserted in the center comes out with a few moist crumbs, 50 to 55 minutes. Let cool in pan on a wire rack for 15 minutes; using parchment paper overhang."
    },
    {
      "position": 8,
      "text": "Remove loaf from pan and slice; serve warm. Enjoy! Recipe developed by Giovanna Vazquez"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

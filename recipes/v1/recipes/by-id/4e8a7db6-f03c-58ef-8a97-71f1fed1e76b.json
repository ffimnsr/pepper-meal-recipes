  "id": "4e8a7db6-f03c-58ef-8a97-71f1fed1e76b",
  "slug": "high-protein-energy-bites",
  "name": "High-Protein Energy Bites",
  "recipe_type": "appetizer",
  "brief_description": "Oats, peanut butter, honey, flax seeds, and coconut are rolled into balls creating high-protein energy bites for a filling on-the-go snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix oats, peanut butter, honey, dark chocolate chips, flax seeds, protein powder, coconut, chia seeds, and coconut extract together in a large bowl; fold in coffee beans. Form mixture into 1-inch balls."
    },
    {
      "position": 2,
      "text": "Place cocoa powder in a small bowl. Roll each ball in the cocoa powder until coated."
    }
  ],
  "servings": 30,

  "id": "1b568680-36fd-5925-b824-96f35390564e",
  "slug": "4-ingredient-lemon-pound-cake-recipe-8600093",
  "name": "4-Ingredient Lemon Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This 4 ingredient lemon pound cake is made with sweetened condensed milk, self-rising flour, eggs, and lemon juice. Dense and moist, it makes a great base for strawberry shortcake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x5-inch loaf pan with nonstick spray, line bottom and sides with parchment paper, and spray again with nonstick cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Whisk eggs, sweetened condensed milk, lemon juice, and lemon zest in a bowl. Add flour and mix just until flour is moistened. Pour batter into the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 55 to 65 minutes. Cool completely on a wire rack before removing from the pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,

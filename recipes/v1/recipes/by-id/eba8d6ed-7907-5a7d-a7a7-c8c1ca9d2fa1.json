  "id": "eba8d6ed-7907-5a7d-a7a7-c8c1ca9d2fa1",
  "slug": "delicious-meatless-baked-ziti",
  "name": "Delicious Meatless Baked Ziti",
  "recipe_type": "main",
  "brief_description": "This meatless baked ziti recipe features fresh mushrooms, spinach, and 3 types of cheeses, making this easy vegetarian dish an instant crowd-pleaser.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook ziti in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium-high heat. Saut\u00e9 spinach and mushrooms in hot oil until soft, about 5 minutes. Remove from heat and add to ziti in the bowl."
    },
    {
      "position": 4,
      "text": "Add ricotta cheese, goat cheese, and 1/2 of the mozzarella cheese to ziti mixture; mix thoroughly. Stir in spaghetti sauce until well combined, then transfer mixture to the prepared baking dish. Sprinkle with remaining mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, in the preheated oven until bubbly and cheese is melted, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

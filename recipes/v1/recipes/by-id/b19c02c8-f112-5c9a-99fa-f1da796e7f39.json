  "id": "b19c02c8-f112-5c9a-99fa-f1da796e7f39",
  "slug": "rose-wine-and-berry-sangria",
  "name": "Ros\u00e9 Wine and Berry Sangria",
  "recipe_type": "drink",
  "brief_description": "This sangria recipe, featuring ros\u00e9 wine, raspberries, blackberries, and limes, is easy to customize with different wines, fruit, and herbs. Perfect for summer entertaining!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir together grapefruit juice and sugar in a pitcher until sugar dissolves. Add wine, raspberries, blackberries, lime slices, and brandy."
    },
    {
      "position": 2,
      "text": "Cover and chill until ready to serve, 1 to 24 hours."
    },
    {
      "position": 3,
      "text": "Gently stir in club soda before serving over ice. Garnish with fresh rosemary sprigs."
    }
  ],
  "servings": 8,

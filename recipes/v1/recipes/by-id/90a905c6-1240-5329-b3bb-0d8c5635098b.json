  "id": "90a905c6-1240-5329-b3bb-0d8c5635098b",
  "slug": "gulab-jamun",
  "name": "Gulab Jamun",
  "recipe_type": "dessert",
  "brief_description": "This is a traditional Indian dessert. Spongy milky balls soaked in rose scented syrup. Delicious with fresh cream, Kulfi, ice cream etc. To make it even more fancy, sprinkle gold-leaf on top of each serving.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, stir together the milk powder, flour, baking powder, and cardamom. Stir in the almonds, pistachios and golden raisins. Mix in the melted ghee, then pour in the milk, and continue to mix until well blended. Cover and let rest for 20 minutes."
    },
    {
      "position": 2,
      "text": "In a large skillet, stir together the sugar, water, rose water and a pinch of cardamom. Bring to a boil, and simmer for just a minute. Set aside."
    },
    {
      "position": 3,
      "text": "Fill a large heavy skillet halfway with oil. Heat over medium heat for at least 5 minutes. Knead the dough, and form into about 20 small balls. Reduce the heat of the oil to low, and fry the balls in one or two batches. After about 5 minutes, they will start to float, and expand to twice their original size, but the color will not change much. After the jamun float, increase the heat to medium, and turn them frequently until light golden. Remove from the oil to paper towels using a slotted spoon, and allow to cool. Drain on paper towels and allow to cool slightly."
    },
    {
      "position": 4,
      "text": "Place the balls into the skillet with the syrup. Simmer over medium heat for about 5 minutes, squeezing them gently to soak up the syrup. Serve immediately, or chill."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

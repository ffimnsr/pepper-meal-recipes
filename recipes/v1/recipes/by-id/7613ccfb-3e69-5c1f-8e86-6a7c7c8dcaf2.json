  "id": "7613ccfb-3e69-5c1f-8e86-6a7c7c8dcaf2",
  "slug": "blood-orange-margarita",
  "name": "Blood Orange Margarita",
  "recipe_type": "dessert",
  "brief_description": "The natural smokiness of the tequila combined with the bitter sweetness of the blood orange makes this a perfect margarita.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tequila, triple sec, sparkling water, blood orange juice, and lime juice in a cocktail shaker. Fill with ice ."
    },
    {
      "position": 2,
      "text": "Shake well and strain into chilled margarita glasses."
    }
  ],
  "servings": 2,

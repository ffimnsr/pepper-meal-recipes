  "id": "ca187953-f661-5615-aea0-5fae42867c92",
  "slug": "monster-eye-pizza-recipe-12034744",
  "name": "Monster-Eye Pizza",
  "recipe_type": "main",
  "brief_description": "This Monster-Eye Pizza turns a double-crust pizza into a fun, spooky centerpiece for your Halloween party. Eye-shaped cutouts in the top crust give you a blank canvas for creating your own one-of-a-kind edible monster.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Shred 6 ounces cheese to make 1 1\u20442 cups. Reserve remaining 2 ounces cheese. Preheat the oven to 425 degrees F (220 degrees C). Place 1 crust on a large pizza pan or baking sheet. Bake for 3 minutes. Let cool 5 minutes."
    },
    {
      "position": 2,
      "text": "Spread marinara over crust. Sprinkle with shredded mozzarella."
    },
    {
      "position": 3,
      "text": "Cut \u201cmonster eye\u201d shapes from remaining crust using 1- to 2-inch round cookie cutters, leaving a 1-inch crust border. (The holes can be randomly spaced over crust.) Place cut crust on top of cheese layer. Discard cutouts or reserve for another use."
    },
    {
      "position": 4,
      "text": "Slice and trim remaining 2 ounces cheese to fit cutout openings; trim pepperoni to fit, if needed (use cookie cutters to easily trim). Stuff olive slices with capers or cocktail onions. Fill cutout openings with pepperoni, then mozzarella slices, and then stuffed olives. Brush top crust with olive oil; sprinkle with Italian seasoning (if using)."
    },
    {
      "position": 5,
      "text": "Bake until top is browned and cheese is melted, 10 to 13 minutes. Cut into 6 slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

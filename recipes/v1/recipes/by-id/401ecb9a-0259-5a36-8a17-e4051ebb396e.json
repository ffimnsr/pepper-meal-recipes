  "schema_version": 1,
  "id": "401ecb9a-0259-5a36-8a17-e4051ebb396e",
  "slug": "russian-cabbage-borscht",
  "name": "Russian Cabbage Borscht",
  "recipe_type": "soup",
  "brief_description": "This Russian cabbage borscht features slowly stewed beets, onion, caraway seeds, potatoes, and carrots with a touch of dill, vinegar, tomato, and honey,",
  "cuisine": "Russian Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes and beets in a medium saucepan over high heat; cover with stock and boil until vegetables are tender. Remove potatoes and beets with a slotted spoon; reserve stock."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Stir in onions, caraway seeds, and salt; cook until onions become soft and translucent. Stir in celery, carrot, and cabbage. Mix in reserved stock; cook, covered, until all vegetables are tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Add potatoes and beets to the skillet. Season with black pepper and dill weed. Stir in cider vinegar, honey, and tomato puree. Cover, reduce heat to medium-low, and simmer for at least 30 minutes."
    },
    {
      "position": 4,
      "text": "Portion borscht into bowls. Top with sour cream, extra dill weed, and chopped tomatoes to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

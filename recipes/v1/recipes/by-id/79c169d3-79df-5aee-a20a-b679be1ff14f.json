  "schema_version": 1,
  "id": "79c169d3-79df-5aee-a20a-b679be1ff14f",
  "slug": "shrimp-scampi-with-tomatoes-pasta-and-roasted-asparagus",
  "name": "Shrimp Scampi with Tomatoes, Pasta, and Roasted Asparagus",
  "recipe_type": "main",
  "brief_description": "This wonderful shrimp scampi recipe is served with penne pasta, tomatoes, and roasted asparagus. Everything is cooked simultaneously, so its on the table in very little time.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain pasta and return to the pot."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a saucepan over medium-low heat. Add Dijon mustard, 1 tablespoon garlic, parsley, lemon juice, and white wine. Place shrimp and tomatoes in a small glass baking dish and pour butter sauce on top. Stir until shrimp and tomatoes are well coated."
    },
    {
      "position": 4,
      "text": "Combine asparagus, olive oil, Parmesan cheese, 1 teaspoon garlic, salt, black pepper, and red pepper in a second glass baking dish."
    },
    {
      "position": 5,
      "text": "Place both baking dishes side by side in the oven and bake until shrimp is fully pink, about 15 minutes. Pour shrimp, tomatoes, and butter over the cooked penne pasta and stir to combine. Add Pecorino Romano cheese and Italian blended cheese; mix to combine. Serve asparagus over top of the pasta."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

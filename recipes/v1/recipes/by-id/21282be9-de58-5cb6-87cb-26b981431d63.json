  "id": "21282be9-de58-5cb6-87cb-26b981431d63",
  "slug": "german-pancakes-ii",
  "name": "German Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These light, golden baked German pancakes are fabulous served with maple syrup or your favorite fruit preserves for an easy special breakfast.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C) with oven rack in center position. Melt butter in a medium baking dish."
    },
    {
      "position": 3,
      "text": "Whisk eggs, milk, flour, and salt together in a medium bowl."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

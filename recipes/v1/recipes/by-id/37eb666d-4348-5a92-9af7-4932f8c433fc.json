  "id": "37eb666d-4348-5a92-9af7-4932f8c433fc",
  "slug": "grilled-lamb-with-brown-sugar-glaze",
  "name": "Grilled Lamb with Brown Sugar Glaze",
  "recipe_type": "dessert",
  "brief_description": "Celebrate spring with these marinated, sweet, and savory tender grilled lamb chops. Serve with green peas, rice, or noodles to make this a hearty meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine brown sugar, ginger, tarragon, cinnamon, pepper, garlic powder, and salt in a medium bowl. Rub lamb chops with seasonings and place on a plate. Cover and refrigerate for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the grill for high heat."
    },
    {
      "position": 3,
      "text": "Brush the grill grate lightly with vegetable oil, and arrange lamb chops on the grill. Cook 5 minutes on each side, or to desired doneness."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

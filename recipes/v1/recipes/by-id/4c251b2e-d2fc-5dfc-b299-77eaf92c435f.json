  "schema_version": 1,
  "id": "4c251b2e-d2fc-5dfc-b299-77eaf92c435f",
  "slug": "sourdough-soft-pretzels",
  "name": "Sourdough Soft Pretzels",
  "recipe_type": "appetizer",
  "brief_description": "Make this sourdough pretzel recipe with sourdough starter for soft, buttery pretzels that are rolled up and twisted completely from scratch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make the dough: Mix flour, sourdough starter, water, powdered milk, melted butter, brown sugar, yeast, and salt in a stand mixer fitted with a dough hook until dough comes together. Knead until smooth and elastic, about 5 minutes. Add additional water, 1 tablespoon at a time, if dough is dry."
    },
    {
      "position": 2,
      "text": "Remove dough from the bowl and shape into a ball. Clean and dry the bowl, then grease lightly. Return dough to the bowl, cover, and let rise at room temperature for 1 hour."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly greased surface. Fold and shape into a rectangle; divide into 12 equal pieces and cover with plastic wrap."
    },
    {
      "position": 4,
      "text": "Roll one piece dough into an 18-inch long rope; keep remaining dough covered while you work. Loop and twist the rope into a pretzel shape, and place onto a baking sheet. Roll and shape remaining pretzels."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 6,
      "text": "Prepare a water bath by bringing 3 cups water to a boil in a pot. Reduce the heat to medium-low and stir in baking soda until dissolved. Lower one pretzel into the water bath and cook for 30 seconds, flipping halfway through. Remove with a slotted spoon or spatula and place back onto the baking sheet. Repeat with remaining pretzels."
    },
    {
      "position": 7,
      "text": "Beat egg with 1 tablespoon water in a small bowl. Brush egg wash over each pretzel, then sprinkle with coarse salt."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until dark golden brown, 12 to 15 minutes. Remove from the oven and brush pretzels with melted butter. Cool for 5 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 35,

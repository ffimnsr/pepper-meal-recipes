  "id": "1f40a70e-7ff8-512b-9fd1-be109a14c381",
  "slug": "ground-turkey-taco-meat",
  "name": "Ground Turkey Taco Meat",
  "recipe_type": "main",
  "brief_description": "Make tasty ground turkey tacos with this spicy seasoning mix featuring chili powder, cumin, paprika, cayenne, garlic, and a touch of brown sugar.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chili powder, cumin, paprika, salt, garlic powder, onion powder, oregano, and cayenne in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat a large nonstick skillet over medium heat. Add ground turkey and cook, stirring to break up clumps, until no longer pink, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in spice mixture and water. Reduce heat and simmer, stirring occasionally, until most of the liquid is absorbed, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Stir in cider vinegar and brown sugar; simmer until flavors combine, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Transfer to a serving bowl."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

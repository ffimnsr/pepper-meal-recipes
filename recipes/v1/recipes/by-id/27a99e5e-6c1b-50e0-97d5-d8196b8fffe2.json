  "id": "27a99e5e-6c1b-50e0-97d5-d8196b8fffe2",
  "slug": "simple-time-pork-chops",
  "name": "Simple Pork Chops",
  "recipe_type": "main",
  "brief_description": "Learn how long to cook pork chops in the oven with this easy, cheesy baked pork chop recipe that makes a delicious dinner any day of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pork chops in a baking pan. Spread 1 teaspoon of butter over each chop, then spread 1 teaspoon of mayonnaise on top of butter."
    },
    {
      "position": 3,
      "text": "Season each chop with seasoning salt, garlic powder, and parsley. Sprinkle 1/4 cup cheese over the top of each chop."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pork is slightly pink in the center, about 35 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a824381e-6c1c-548a-9662-e8dff457b3a8",
  "slug": "grilled-coconut-curry-tofu-kebabs-recipe-8645704",
  "name": "Grilled Coconut-Curry Tofu Kebabs",
  "recipe_type": "main",
  "brief_description": "A serrano-spiced coconut milk marinade maximizes the flavor in these grilled coconut-curry tofu kebabs.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut tofu lengthwise into 8 (1/2-inch thick) rectangles. Wrap between several layers of paper towels and weight down with a heavy pan for about 30 minutes to remove excess liquid."
    },
    {
      "position": 2,
      "text": "Set a large resealable bag in a shallow dish. Whisk together yogurt, coconut milk, oil, serrano pepper, honey, garlic, ginger, curry powder, and salt in a small bowl. Add tofu and yogurt marinade to bag. Seal bag and turn to coat all tofu pieces with marinade. Chill in the refrigerator for 30 minutes or up to 24 hours."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill to low heat (225 degrees F to 250 degrees F / 107 degrees C to 120 degrees C). Generously oil grill grates four times. (Well greased grill grates are essential for this recipe.)"
    },
    {
      "position": 4,
      "text": "Remove tofu from marinade, allowing excess marinade to drip off. Reserve marinade for brushing. Thread tofu lengthwise on skewers."
    },
    {
      "position": 5,
      "text": "Grill kebabs, covered, turning halfway through, for 20 minutes, generously brushing with the reserved marinade in the last 3 minutes of grilling time. Serve kebabs with chutney for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

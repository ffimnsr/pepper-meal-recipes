{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "30859ab5-532a-5567-b339-f6c966457398",
  "slug": "thousand-layer-chocolate-brioche",
  "name": "\"Thousand Layer\" Chocolate Brioche",
  "recipe_type": "dessert",
  "brief_description": "This pastry is light, buttery, and filled with rich chocolate, much like a chocolate croissant, only this version is braided and twisted to make a nice muffin sized treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine warm milk and dry active yeast in the bowl of your stand mixer; let stand for 10 minutes. Add flour, eggs, sugar, and salt. Use the dough hook to knead the mixture until the flour almost disappears, about 1 minute. Add the soft room temperature butter, and continue kneading the dough until a very smooth ball of dough forms, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Set dough into a lightly buttered bowl, cover, and let rise in a warm spot until doubled in size, 2 to 3 hours."
    },
    {
      "position": 4,
      "text": "Punch down the dough and divide in 2 pieces. Form each half into a smooth ball and transfer each one into a plastic bag. Refrigerate bags overnight for best results or the dough can be used immediately. Each half of the dough will make 4 brioche."
    },
    {
      "position": 5,
      "text": "When ready to make, roll and stretch dough into a 14 x 10 inch rectangle. Spread 4 tablespoons of soft room temperature butter over two thirds of the dough, stopping 1/2 inch from the edge."
    },
    {
      "position": 6,
      "text": "Fold unbuttered third up over the top, and then the opposite end to complete the trifold. Gently press and seal the edges together. Fold in thirds again to form a square. Wrap and place in the freezer until cold and slightly firm, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Roll the dough out into a rectangle about 1/4 inch thick, or thin enough to fold, and repeat the two folding in thirds step. Wrap and place in the freezer again until cold and slightly firm, 15 more minutes. A little bit of water can be used to help the dough stick if needed."
    },
    {
      "position": 8,
      "text": "Roll dough out into a rectangle again, just like in the previous step. Fold into thirds, but keep as a rectangle (do not make the second fold). Wrap and place in the freezer until cold and slightly firm, about 15 minutes."
    },
    {
      "position": 9,
      "text": "Roll dough into a 12 x 6 inch rectangle and place in the freezer until cold and slightly firm, about 15 minutes."
    },
    {
      "position": 10,
      "text": "Trim off about 1/8 inch of dough from the sides and cut into 4 rectangles that are about 6 x 3 inches."
    },
    {
      "position": 11,
      "text": "Start with 1 piece (keeping the others in the fridge so they stay cool) and make two cuts starting 1/2 inch from top, all the way to the bottom to create 3 strips of dough. Braid together, and seal at bottom. Flip over and add about 1 tablespoon of dark chocolate chunks along the center of the braided dough, or more to taste. Roll up from the smaller end to create a knot. Place seam side down in buttered muffin tin."
    },
    {
      "position": 12,
      "text": "After all braids are done, cover, and let rise in a warm spot until doubled in size, about 1 hour. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 13,
      "text": "Brush brioche with egg wash, and sprinkle very lightly with some coarse salt. Then sprinkle very generously with the granulated sugar."
    },
    {
      "position": 14,
      "text": "Bake on the center rack of the preheated oven until nicely browned, 20 to 25 minutes. If brioches are getting too dark, tent with aluminum foil after 15 minutes."
    },
    {
      "position": 15,
      "text": "Let cool in the pan for about 5 minutes and then transfer onto a rack to cool completely before serving."
    },
    {
      "position": 16,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,

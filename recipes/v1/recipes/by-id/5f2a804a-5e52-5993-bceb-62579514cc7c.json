  "id": "5f2a804a-5e52-5993-bceb-62579514cc7c",
  "slug": "the-real-deal-korean-beef-ribs",
  "name": "The Real Deal Korean Beef Ribs",
  "recipe_type": "dessert",
  "brief_description": "Beef short ribs are given a long, slow soak in a sweet, garlicky soy marinade flavored with black pepper, sesame oil, and plum wine, then grilled to a dark mahogany color for an authentic Korean taste.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Wash the ribs, removing any stray bits of bone, and allow to drain for 30 minutes."
    },
    {
      "position": 2,
      "text": "Whisk together the soy sauce, sugar, honey, garlic, pepper, water, sesame oil, and plum wine until the sugar has dissolved; pour the mixture into a 1 gallon plastic zipper bag. Place the ribs into the marinade, squeeze all the air out of the bag, zip it up, and refrigerate at least 24 hours."
    },
    {
      "position": 3,
      "text": "The next day, remove the ribs from the refrigerator and allow to come to room temperature before grilling. Remove the ribs from the marinade and discard the marinade."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate. Grill the ribs until browned and no longer pink inside, 4 to 6 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

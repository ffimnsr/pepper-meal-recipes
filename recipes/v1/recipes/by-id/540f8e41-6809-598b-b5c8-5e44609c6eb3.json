  "name": "Herbed Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This easy recipe for herbed garlic bread the perfect addition to round out just about any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Combine all ingredients except bread in small bowl. Arrange bread on baking sheet; spread with herb mixture."
    },
    {
      "position": 3,
      "text": "Broil until golden, about 2 minutes."
    }
  ],

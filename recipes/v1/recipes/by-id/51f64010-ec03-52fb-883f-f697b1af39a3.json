  "slug": "worlds-best-key-lime-pie",
  "name": "World's Best Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "Make and eat this delicious and easy pie within about an hour. Condensed milk, key lime juice and whipped topping are combined, poured into a graham cracker crust and chilled.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix together condensed milk and lime juice. Fold in whipped topping and mix until smooth. Pour mixture into graham cracker crust. Refrigerate at least 1 hour before serving."
    }
  ],

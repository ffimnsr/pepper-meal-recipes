  "id": "ec9865e1-a527-55a2-aa5a-9704fb0caa59",
  "slug": "birds-nest-breakfast-cups",
  "name": "Bird's Nest Breakfast Cups",
  "recipe_type": "breakfast",
  "brief_description": "Fun bird nests made from baked hash brown potatoes enclose beaten egg, bacon, and cheese for a recipe that's perfect for an Easter brunch or a tasty grab-and-go breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease 24 muffin cups."
    },
    {
      "position": 2,
      "text": "Mix hash brown potatoes, salt, black pepper, olive oil, and 2/3 cup shredded Cheddar cheese in a bowl. Divide mixture between prepared muffin cups and use your fingers to shape potato mixture into nests with hollows in the middle."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until hash browns are browned on the edges and cheese has melted, 15 to 18 minutes. Remove hash brown nests."
    },
    {
      "position": 4,
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Whisk eggs and water in a bowl until thoroughly combined; season with salt and black pepper. Pour equal amount of egg mixture into each nest; sprinkle with bacon crumbles and 1 teaspoon Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Bake in the oven until eggs are set, 13 to 16 minutes. Let cool in pans and remove by sliding a knife between potato crust and muffin cup."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

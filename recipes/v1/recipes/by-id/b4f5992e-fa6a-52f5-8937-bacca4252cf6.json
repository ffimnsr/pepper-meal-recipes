  "id": "b4f5992e-fa6a-52f5-8937-bacca4252cf6",
  "slug": "double-chocolate-banana-monkey-bread",
  "name": "Double Chocolate Banana Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "Double chocolate banana monkey bread is flaky layers of spiced, caramelized, double chocolate goodness that is a sweet, gooey delicacy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9-inch cake pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, half of the pudding mix, and cinnamon in a large resealable plastic bag. Seal and shake well until thoroughly combined and no lumps remain."
    },
    {
      "position": 3,
      "text": "Pour the remaining half of the pudding mix and 1/2 cup melted butter into a small bowl. Stir until combined."
    },
    {
      "position": 4,
      "text": "Dip each biscuit piece in the butter mixture and shake in the sugar mixture. Arrange half of the pieces into a layer on the bottom the prepared pan. Drop banana over the layer; sprinkle chocolate chips on top. Cover with a layer of of the remaining biscuit pieces."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and no longer doughy in the center, 18 to 22 minutes. Cool monkey bread in the pan for 10 minutes. Invert onto a serving plate."
    },
    {
      "position": 6,
      "text": "Beat confectioners' sugar, 2 tablespoons butter, and cream in a bowl until smooth. Drizzle over monkey bread."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

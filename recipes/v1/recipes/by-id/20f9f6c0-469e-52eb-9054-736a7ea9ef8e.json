  "schema_version": 1,
  "id": "20f9f6c0-469e-52eb-9054-736a7ea9ef8e",
  "slug": "tempeh-gyros",
  "name": "Tempeh Gyros",
  "recipe_type": "main",
  "brief_description": "Tempeh gyros rely on traditional seasonings and ingredients to turn marinated tempeh and silken tofu into gyros, giving a Greek favorite a vegan makeover.",
  "cuisine": "Greek Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vegetable broth, soy sauce, lemon juice, oregano, thyme, 1 1/2 teaspoons garlic, Himalayan salt, and pinch black pepper in a large bowl."
    },
    {
      "position": 2,
      "text": "Fill a saucepan with water; bring to a boil. Cut tempeh in half; add to the boiling water. Boil tempeh to remove any bitter taste, about 10 minutes, then transfer to a cutting board; cool slightly."
    },
    {
      "position": 3,
      "text": "Cut tempeh into 1/4-inch slices; add to vegetable broth marinade and toss to coat. Cover bowl with plastic wrap; marinate in the refrigerator 8 hours to overnight, stirring occasionally, making sure tempeh is covered with marinade."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Remove tempeh from marinade, letting excess drip off; place on the prepared baking sheet. Discard remaining marinade."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and beginning to crisp at the edges, 30 to 35 minutes, flipping halfway."
    },
    {
      "position": 7,
      "text": "Place pitas in the hot oven until warmed through, 3 to 5 minutes."
    },
    {
      "position": 8,
      "text": "Squeeze excess water from cucumbers using paper towels. Combine cucumbers, tofu, dill, 1 teaspoon garlic, salt, and black pepper in the bowl of a food processor; pulse until blended. Taste tzatziki; adjust seasonings if desired."
    },
    {
      "position": 9,
      "text": "Place 1/4 tempeh slices, tomatoes, and red onions on top of 1 pita; drizzle with tzatziki. Repeat with remaining tempeh, tomatoes, onion, pitas, and tzatziki."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

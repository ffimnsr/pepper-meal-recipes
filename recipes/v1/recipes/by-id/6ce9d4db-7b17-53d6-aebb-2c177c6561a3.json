  "id": "6ce9d4db-7b17-53d6-aebb-2c177c6561a3",
  "slug": "air-fryer-jalapeno-popper-pinwheels-recipe-11860329",
  "name": "Air Fryer Jalapeno Popper Pinwheels",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer jalapeno popper pinwheels bring 2 favorite appetizers together\u2014the ever-popular tortilla pinwheel filled with exciting popper flavors, and air frying brings it all together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cream cheese, shredded cheese, and jalapenos together in a bowl until well combined."
    },
    {
      "position": 2,
      "text": "Spread cream cheese mixture evenly among tortillas, leaving a 1/4 -inch border around the edges."
    },
    {
      "position": 3,
      "text": "Roll each tortilla firmly into pinwheels and place seam side down on a cutting board."
    },
    {
      "position": 4,
      "text": "Trim 1/4 to 1/2 inch from the ends and discard ends. Cut each roll up into 8 pinwheels."
    },
    {
      "position": 5,
      "text": "Heat an air fryer to 400 degrees F (200 degrees C) according to manufacturer\u2019s instructions. Lightly coat the basket of the air fryer with cooking spray. Working in batches if necessary, place rolls, flat side down, into the basket. Spray lightly with avocado oil spray."
    },
    {
      "position": 6,
      "text": "Air fry until browned and lightly toasted, 6 to 8 minutes. Repeat with remaining rolls. Serve with taco sauce for dipping if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

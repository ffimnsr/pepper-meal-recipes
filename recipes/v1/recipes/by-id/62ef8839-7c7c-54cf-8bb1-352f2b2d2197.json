  "id": "62ef8839-7c7c-54cf-8bb1-352f2b2d2197",
  "slug": "serbian-cevapcici",
  "name": "Serbian \u0106evap\u010di\u0107i",
  "recipe_type": "main",
  "brief_description": "\u0106evap\u010di\u0107i is a tasty homemade grilled sausage. This Serbian-style recipe combines ground pork, beef, and lamb with garlic, black pepper, and cayenne.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Combine ground pork, ground beef, ground lamb, and egg white in a large bowl."
    },
    {
      "position": 4,
      "text": "Add garlic, black pepper, salt, baking soda, cayenne pepper, and paprika. Mix well using your hands; form into finger-length sausages about 3/4-inch thick."
    },
    {
      "position": 5,
      "text": "Cook sausages on the preheated grill, turning occasionally, until no longer pink in the center, about 30 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

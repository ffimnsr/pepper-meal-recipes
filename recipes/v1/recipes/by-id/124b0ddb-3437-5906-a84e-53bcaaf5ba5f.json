  "id": "124b0ddb-3437-5906-a84e-53bcaaf5ba5f",
  "slug": "toasted-pumpkin-seeds",
  "name": "Toasted Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "After the jack-o'-lantern is carved, make this oven-toasted pumpkin seed recipe with just vegetable oil and salt for a healthy, fiber-filled snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread pumpkin seeds on a baking sheet; drizzle with oil, season with salt, and toss to evenly coat."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring occasionally, until lightly toasted, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,

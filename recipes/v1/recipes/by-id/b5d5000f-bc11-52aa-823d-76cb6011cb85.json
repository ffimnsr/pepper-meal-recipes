{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b5d5000f-bc11-52aa-823d-76cb6011cb85",
  "slug": "chicken-enchiladas-with-green-chile-sauce-salsa-verde",
  "name": "Chicken Enchiladas with Green Chile Sauce (Salsa Verde)",
  "recipe_type": "main",
  "brief_description": "Use a rotisserie chicken or leftover roast chicken to make these cheesy enchiladas.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a saute pan over medium heat. Add onion; cook and stir until translucent, about 5 minutes. Add garlic and heat until fragrant, about 2 minutes. Remove from heat and let cool."
    },
    {
      "position": 3,
      "text": "Combine chicken, onion mixture, cheese blend, cream cheese, salsa verde, olives, cilantro, and jalapenos in a large bowl for the filling. Mix well."
    },
    {
      "position": 4,
      "text": "Melt butter in a saucepan over medium heat. Stir in flour, then chicken broth. Cook until sauce starts to thicken, 6 to 8 minutes. Stir in sour cream and salsa verde; cook until heated through. Spread a spoonful of sauce over the bottoms of two 9x11-inch casserole dishes."
    },
    {
      "position": 5,
      "text": "Wrap a tortilla in a damp paper towel and microwave for about 30 seconds. Fill with the chicken mixture, roll up, and place seam-side down into a baking dish. Repeat with remaining tortillas until each dish holds 8 enchiladas."
    },
    {
      "position": 6,
      "text": "Spoon remaining sauce over the enchiladas. Sprinkle cheese on top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until heated through, about 20 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

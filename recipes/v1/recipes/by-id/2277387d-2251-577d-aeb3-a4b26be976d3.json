  "id": "2277387d-2251-577d-aeb3-a4b26be976d3",
  "slug": "caramel-apple-monkey-bread",
  "name": "Caramel Apple Monkey Bread",
  "recipe_type": "breakfast",
  "brief_description": "Monkey bread gets an upgrade when frozen bread dough is paired with warm, cinnamon-sugar coated apples.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a fluted tube pan (such as Bundt\u00ae) with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix white sugar and cinnamon together in a medium bowl. Add apple chunks and stir to coat thoroughly. Set aside."
    },
    {
      "position": 3,
      "text": "Divide dough into 20 pieces. Wrap 1 piece of dough around a coated apple chunk and pinch to seal shut. Dip in melted butter, then roll in brown sugar. Arrange balls of dough in even circles in the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Carefully invert pan onto a large plate so caramel mixture runs over each piece. Cool briefly before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0585d216-efa6-5fbc-b800-96d8ebab8876",
  "slug": "blackberry-pistachio-cheesecake-bars-recipe-11816185",
  "name": "Blackberry Pistachio Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "These blackberry pistachio cheesecake bars are not only gorgeous\u2014they are absolutely delicious, as well. Pistachio and cheesecake layers over a graham cracker crust are finished with a sweetened blackberry topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "For crust, place graham crackers in the bowl of a food processor. Pulse several times until crackers are finely ground. Add in pistachios, brown sugar, cinnamon, nutmeg, and salt and pulse a few times to combine. Pour in melted butter and pulse again until mixture is evenly moistened. Pour crumb mixture into the prepared pan and press firmly and evenly into the bottom of the pan."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven until golden on the edges, 10 to 12 minutes. Set aside to cool; leave oven on."
    },
    {
      "position": 4,
      "text": "For filling, beat together cream cheese, white sugar, cornstarch, salt, and nutmeg together in a bowl with an electric mixer until smooth, 1 to 2 minutes. Beat in vanilla, almond extract, and lemon juice until combined. Add heavy cream and mix until smooth. Add egg, and beat on low speed until just incorporated."
    },
    {
      "position": 5,
      "text": "Scoop out 1 1/4 cups cream cheese filling to a separate bowl; add pistachio butter and beat until combined. Pour pistachio filling over crust and smooth into an even layer. Carefully dollop remaining cream cheese filling over pistachio layer, and gently spread to cover evenly."
    },
    {
      "position": 6,
      "text": "Bake bars until edges are set but the middle still has a slight jiggle to it, 45 to 50 minutes. Remove from oven and allow to cool completely to room temperature, about 1 hour."
    },
    {
      "position": 7,
      "text": "Meanwhile, for topping, place frozen blackberries and white sugar in a saucepan over medium-low heat; cook. stirring often, until berries have released their juices and broken down a bit, about 10 minutes. Stir in lemon zest."
    },
    {
      "position": 8,
      "text": "In a small bowl, combine 2 tablespoons cornstarch with lemon juice until combined. Gradually pour cornstarch mixture into blackberries, stirring constantly. Continue to cook until blackberry mixture thickens, 1 to 3 minutes more. Remove from heat; let cool completely to room temperature, about 1 hour."
    },
    {
      "position": 9,
      "text": "Once bars and blackberry topping have cooled, pour blackberry topping over the bars and spread into an even layer. Place bars into the fridge until completely chilled, at least 4 hours or up to overnight."
    },
    {
      "position": 10,
      "text": "When ready to serve, sprinkle 2 tablespoons of chopped pistachios over the bars. Carefully lift bars out of the pan using the parchment overhang, and gently peel parchment away from the edges of the bars. Run a sharp knife under hot water, then dry it off on a kitchen towel. Cut into 16 bars, wiping the knife clean after each cut. Keep extra bars stored in the refrigerator."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8c6b1ad1-3b8b-57f4-b93b-a7cbae44e8ba",
  "slug": "taco-bell-style-cheesy-bean-and-rice-burrito-supremes-recipe-11928000",
  "name": "Taco Bell-Style Cheesy Bean and Rice Burrito Supremes",
  "recipe_type": "main",
  "brief_description": "Creamy jalape\u00f1o sauce and nacho cheese provide tasty nostalgia in every bite in these copycat Taco Bell cheesy bean and rice burritos. If you like, brown burritos in a skillet over medium heat and top with pico de gallo.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a large skillet over medium heat. Stir in tomato paste and 1 1/2 teaspoon Taco Bell-Style Seasoning; cook, stirring constantly, until mixture deepens in color, 1 to 2 minutes. Stir in rice and cook, stirring constantly, until evenly coated and warmed through, about 1 minute. Transfer to a bowl; let cool slightly. Wipe skillet clean."
    },
    {
      "position": 2,
      "text": "Heat remaining 1 tablespoon oil in same skillet over medium-low heat. Add remaining 1 tablespoon Taco Bell-Style Seasoning; cook and stir until fragrant, about 10 seconds. Stir in refried beans; cook, stirring often, until warmed through, about 1 minute. Remove from heat; let cool slightly."
    },
    {
      "position": 3,
      "text": "Wrap tortillas in a damp paper towel and microwave on High until warmed through, 15 to 20 seconds. Lay tortillas flat on a work surface. Spread each tortilla with about 1/3 cup refried beans, leaving a 1 1/2-inch border on all sides. Top evenly with rice mixture, lettuce, tomato, cheese sauce, Creamy Jalape\u00f1o Sauce, sour cream, and tortilla strips."
    },
    {
      "position": 4,
      "text": "Working with 1 burrito at a time, fold left and right sides of tortilla toward center, partially covering filling. Fold bottom edge up and over filling, tucking under filling slightly. While keeping sides tucked in, roll burrito tightly from bottom up; place seam-side down. Repeat folding and rolling with remaining burritos."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "8db8f6e5-5623-51c0-adfb-4dcdfa3db923",
  "slug": "amish-slaw",
  "name": "Best Vinegar Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This easy vinegar coleslaw made with shredded cabbage, onions, and a sweet and tangy vinegar-based dressing is perfect for summer BBQs and picnics.",
  "cuisine": "Amish American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Toss cabbage and onion together in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Combine sugar, vinegar, oil, celery seed, salt, mustard, and pepper in a small saucepan; bring to a boil and simmer, stirring frequently, until sugar is dissolved, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Let mixture cool slightly, about 5 minutes, then pour over cabbage mixture; toss well to coat."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "91949e22-c0b9-547f-b287-32e48c457fe2",
  "slug": "north-african-couscous-with-tempeh",
  "name": "North African Couscous with Tempeh",
  "recipe_type": "main",
  "brief_description": "Smoky tempeh is cooked with couscous, onions, and chickpeas in this North African-inspired dish that is vegetarian and full of flavor.",
  "cuisine": "Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix 1/3 cup water, soy sauce, honey, 1 1/2 teaspoons curry powder, garlic, lemon juice, and liquid smoke together in a bowl until marinade is smooth; add tempeh and turn to coat evenly. Marinate tempeh, turning frequently, for 20 minutes."
    },
    {
      "position": 2,
      "text": "Combine vegetable broth, 1 tablespoon olive oil, 2 1/2 tablespoons curry powder, and salt in a saucepan with a tight-fitting lid; bring to a boil. Add couscous, cover saucepan, and remove from heat. Let stand for 5 minutes. Fluff couscous with a fork."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons olive oil in a skillet over medium-high heat; add tempeh and marinade. Cook tempeh until browned on the bottom, about 5 minutes. Turn and brown the other side, about 5 minutes more. Remove tempeh from skillet."
    },
    {
      "position": 4,
      "text": "Pour remaining 1 tablespoon olive oil into the same skillet; cook and stir onion until fragrant and brown, about 4 minutes. Add chickpeas and water; cook and stir using a wooden spoon to break up brown bits of food on the skillet, 3 to 4 minutes. Reduce heat to low."
    },
    {
      "position": 5,
      "text": "Fold couscous into the onion mixture; add tempeh. Sprinkle mint over couscous; cook and stir until warmed through, 2 to 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 24,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

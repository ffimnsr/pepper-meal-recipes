  "id": "5cb3374d-9244-528e-ac01-2067d3722b2b",
  "slug": "cheesy-mashed-potato-puffs-recipe-11718758",
  "name": "Cheesy Mashed Potato Puffs",
  "recipe_type": "appetizer",
  "brief_description": "These cheesy mashed potato puffs elevate mashed potato leftovers to a new level in this delicious, very easy appetizer. Cheddar cheese, bacon, chives, and green onion make them resemble tiny loaded baked potatoes, with sour cream on the side for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a standard muffin tin liberally with cooking spray."
    },
    {
      "position": 2,
      "text": "Reserve 2 tablespoons shredded Cheddar and 2 tablespoons white Cheddar for topping. Stir mashed potatoes, remaining Cheddar cheese, remaining white Cheddar cheese, eggs, and onion together in a bowl. Season with salt and pepper. Fold in dried chives, Parmesan cheese and bacon."
    },
    {
      "position": 3,
      "text": "Divide mixture evenly into 12 muffin cups. Sprinkle reserved cheese evenly on top."
    },
    {
      "position": 4,
      "text": "Bake until golden brown, about 15 minutes. Remove from the oven; let stand for 5 minutes."
    },
    {
      "position": 5,
      "text": "Using a dinner knife, gently run around each puff and remove carefully. Serve immediately with sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

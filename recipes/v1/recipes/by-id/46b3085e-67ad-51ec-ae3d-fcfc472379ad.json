  "id": "46b3085e-67ad-51ec-ae3d-fcfc472379ad",
  "slug": "farmers-casserole",
  "name": "Farmer's Casserole",
  "recipe_type": "breakfast",
  "brief_description": "A farmer's casserole is a tasty, make-ahead breakfast dish with ham, eggs, hash browns, and spicy pepper Jack cheese that the whole family will love!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray a 2-quart casserole dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Arrange hash brown potatoes evenly in the bottom of the prepared dish. Sprinkle with pepper Jack cheese, then ham, and finally green onions."
    },
    {
      "position": 4,
      "text": "Whisk evaporated milk, eggs, pepper, and salt together in a medium bowl; pour over layers in the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let rest for 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

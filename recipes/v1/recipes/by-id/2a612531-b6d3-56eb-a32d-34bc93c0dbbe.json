  "slug": "shrimp-remoulade-recipe-11846658",
  "name": "Shrimp Remoulade",
  "recipe_type": "appetizer",
  "brief_description": "This shrimp remoulade, a classic sauce for a cold shrimp appetizer, is quickly prepared in a food processor. This showstopping appetizer will elevate any holiday party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine green onions, celery, parsley, mayonnaise, ketchup, Worcestershire, mustard, hot sauce, capers, and lemon juice in a food processor; blend until smooth or until mixture has desired texture. Season to taste. Refrigerate until ready to serve."
    },
    {
      "position": 2,
      "text": "Serve remoulade sauce with cooked shrimp and lemon wedges."
    }
  ],

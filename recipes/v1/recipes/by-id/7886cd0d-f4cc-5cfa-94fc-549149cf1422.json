  "slug": "slow-cooker-chicken-pot-pie-with-biscuits-recipe-8722038",
  "name": "Slow Cooker Chicken Pot Pie With Biscuits",
  "recipe_type": "soup",
  "brief_description": "Use your slow cooker to make chicken pot pie with biscuits on top to sop up the sauce. A delicious comfort dish for fall or winter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chicken, potatoes, frozen mixed vegetables, soup, broth, onion, celery, dill, salt, pepper, smoked paprika, and garlic powder in a 4- to 5-quart slow cooker."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low 7 to 8 hours or on High 3 1/2 to 4 hours."
    },
    {
      "position": 4,
      "text": "When ready to serve, bake biscuits according to package directions. Split and serve a biscuit atop each serving,"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 210,

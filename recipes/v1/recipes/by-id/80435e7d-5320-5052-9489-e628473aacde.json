  "id": "80435e7d-5320-5052-9489-e628473aacde",
  "slug": "spritz-orange-crisps",
  "name": "Spritz Orange Crisps",
  "recipe_type": "dessert",
  "brief_description": "Orange flavored spritz cookies. Try sandwiching them together with melted chocolate.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream the shortening. Gradually add the sugar and the orange juice. Cream well. Beat in the egg and the orange rind."
    },
    {
      "position": 3,
      "text": "Sift the flour, salt and baking soda. Add the flour mixture to the creamed mixture a little at a time. Fill cookie press and form cookies onto an ungreased cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake at 375 degrees F (190 degrees C) for 10 to 12 minutes."
    }
  ],
  "servings": 42,

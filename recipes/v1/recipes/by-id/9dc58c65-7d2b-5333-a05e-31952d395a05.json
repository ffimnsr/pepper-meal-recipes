  "id": "9dc58c65-7d2b-5333-a05e-31952d395a05",
  "slug": "amazing-shrimp-and-langostino-lobster-linguine",
  "name": "Amazing Shrimp and Langostino Lobster Linguine",
  "recipe_type": "main",
  "brief_description": "This shrimp and langostino recipe with fettuccine and a creamy pesto sauce flavored with bacon and red pepper flakes is just perfect for dinner parties!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted and oiled water to a boil. Add linguine and cook until tender yet firm to the bite, about 11 minutes; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large saucepan over medium-high heat. Add bacon, onion, garlic, and pepper flakes; saut\u00e9 until onion is golden brown, 10 to 15 minutes. Add white wine and cook, stirring occasionally, until absorbed, 2 to 4 minutes. Stir in shrimp and langostino and saut\u00e9 until pink, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Reduce the heat to medium and stir in strained linguine. Add peas, pesto sauce, and half-and-half; cook and stir until linguine absorbs the liquid, 5 to 10 minutes. Top each serving with Parmigiano-Reggiano cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

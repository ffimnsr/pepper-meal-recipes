  "id": "113d20a5-466d-5801-ba34-0161d18be026",
  "slug": "greek-couscous",
  "name": "Greek Couscous Salad",
  "recipe_type": "salad",
  "brief_description": "This Greek couscous salad with garbanzo beans, feta cheese, sun-dried tomatoes, and olives is hearty and delicious. Perfect for a hot summer's day.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water and chicken broth into a saucepan; stir in the garlic and bring to a boil. Stir in pearl couscous, cover the pan, and remove from heat. Allow couscous to stand until water has been absorbed, about 5 minutes; fluff with a fork. Allow couscous to cool to warm temperature."
    },
    {
      "position": 2,
      "text": "Lightly toss couscous, chickpeas, sun-dried tomatoes, olives, and feta cheese in a large serving bowl."
    },
    {
      "position": 3,
      "text": "To make the dressing: Mix white wine vinegar, lemon juice, oregano, and black pepper in a small bowl until well combined. Pour over couscous mixture; toss again to serve."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

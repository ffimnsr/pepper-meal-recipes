  "id": "db73d76f-8f6b-5602-b188-7ff1e8a0d7c0",
  "slug": "za-atar-bean-salad-recipe-11970256",
  "name": "Za'atar Bean Salad",
  "recipe_type": "salad",
  "brief_description": "This vibrant za'atar bean salad combines chickpeas and cannellini beans with lemony red onion, roasted red peppers, and fresh herbs. Tossed in a warm, spiced olive oil dressing, it\u2019s bright and hearty, and can be served right away or chilled to let the flavors fully develop.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, toss onion with lemon zest, lemon juice and 1/4 teaspoon salt. Set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a small saucepan over medium heat. Add garlic and immediately turn off the heat; stir in za'atar, smoked paprika, cumin, crushed red pepper, and remaining salt until fragrant. Stir in red wine vinegar and set aside to cool slightly."
    },
    {
      "position": 3,
      "text": "Add chickpeas, cannellini beans, roasted red peppers, parsley, and dill to the onion mixture. Pour dressing over top and toss to combine. If time allows, refrigerate for 1 to 2 hours for flavors to meld."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

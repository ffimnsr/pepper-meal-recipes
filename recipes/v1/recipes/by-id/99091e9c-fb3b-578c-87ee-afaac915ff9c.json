  "id": "99091e9c-fb3b-578c-87ee-afaac915ff9c",
  "slug": "broccoli-pasta-salad",
  "name": "Broccoli Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This broccoli pasta salad with steamed broccoli is a delicious combination of Italian flavors including garlic, olive oil, red pepper flakes, and Romano cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; cook pasta at a boil until tender yet firm to the bite, about 11 minutes; drain and return to pot."
    },
    {
      "position": 2,
      "text": "While the pasta cooks, place a steamer insert into a saucepan and fill with water, just below the bottom of the steamer. Bring water to a boil. Add broccoli, cover, and steam until tender, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a small saucepan over medium heat; cook and stir garlic and red pepper flakes until garlic is fragrant, 1 to 3 minutes. Add garlic mixture and broccoli to pasta; gently toss to coat."
    },
    {
      "position": 4,
      "text": "Add cheese, parsley, black pepper, and salt; toss to combine."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

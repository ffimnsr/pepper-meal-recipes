  "id": "3093697c-8e7b-505e-a15d-495a5412fea8",
  "slug": "twisted-air-fryer-shrimp-tacos",
  "name": "Twisted Air Fryer Shrimp Tacos",
  "recipe_type": "main",
  "brief_description": "Use your air fryer to prepare shrimp tacos. Shrimp shells are edible, but feel free to use peeled shrimp instead.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vodka, orange juice, garlic, cumin, coriander, smoked paprika, paprika, and cayenne in a resealable plastic bag. Add shrimp and marinate for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes."
    },
    {
      "position": 3,
      "text": "Drain off marinade and air-fry shrimp for 6 minutes."
    },
    {
      "position": 4,
      "text": "Divide chopped salad amongst tortillas. Add cilantro, bell pepper, and the white parts of the green onion. Roughly chop shrimp (optional) and add to the tacos. Top with crema con sal and cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

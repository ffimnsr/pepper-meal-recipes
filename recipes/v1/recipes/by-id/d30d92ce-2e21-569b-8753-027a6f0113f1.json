  "id": "d30d92ce-2e21-569b-8753-027a6f0113f1",
  "slug": "broccoli-sprout-salad-recipe-11970265",
  "name": "Broccoli Sprout Salad",
  "recipe_type": "salad",
  "brief_description": "This tangy, refreshing broccoli sprout salad is a nutrient-dense twist on the viral TikTok iceberg salad, swapping in romaine for extra vitamins and crunch. Broccoli sprouts add a fresh, slightly peppery bite and are popular for their sulforaphane content and antioxidant benefits.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut the root end of romaine and separate the leaves. Rinse with cool water and dry thoroughly."
    },
    {
      "position": 2,
      "text": "Stack the leaves and slice into thin ribbons, about 1/4 inches wide. Add to a large bowl."
    },
    {
      "position": 3,
      "text": "Add broccoli sprouts, garlic salt, black pepper, lemon juice, olive oil and white vinegar and toss together until evenly mixed. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

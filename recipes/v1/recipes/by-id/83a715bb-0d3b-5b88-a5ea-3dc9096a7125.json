  "id": "83a715bb-0d3b-5b88-a5ea-3dc9096a7125",
  "slug": "tomato-soup-and-grilled-cheese-casserole-recipe-8769359",
  "name": "Tomato Soup and Grilled Cheese Casserole",
  "recipe_type": "soup",
  "brief_description": "This tomato soup and grilled cheese casserole tastes like the classic combo: Campbell's tomato soup with grilled cheese sandwiches. The baked-in grilled cheese cubes are golden, melty, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Spread 6 slices of bread with 2 tablespoons butter on one side."
    },
    {
      "position": 4,
      "text": "Lay buttered slices of bread, butter side down, on an extra large baking sheet."
    },
    {
      "position": 5,
      "text": "Spread bread slices evenly with cream cheese."
    },
    {
      "position": 6,
      "text": "Top each bread slice with 2 slices of Cheddar cheese"
    },
    {
      "position": 7,
      "text": "Top cheese with remaining bread slices."
    },
    {
      "position": 8,
      "text": "Spread tops of bread slices with 2 tablespoons butter."
    },
    {
      "position": 9,
      "text": "Bake sandwiches for 12 to 14 minutes, flipping once, until cheese is melted. Let sandwiches cool at least 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 10,
      "text": "Meanwhile, prepare soup mixture. Whisk together tomato soup, tomato juice, eggs, Italian seasoning, and garlic powder in a bowl. Stir in chopped tomato."
    },
    {
      "position": 11,
      "text": "Cut toasted sandwiches into 1-inch cubes."
    },
    {
      "position": 12,
      "text": "Pour soup mixture into prepared dish."
    },
    {
      "position": 13,
      "text": "Place cubes evenly over soup mixture in dish; pressing slightly to submerge in soup mixture."
    },
    {
      "position": 14,
      "text": "Sprinkle with shredded Italian blend cheese."
    },
    {
      "position": 15,
      "text": "Bake until heated through, golden brown, and cheese is melted, 25 to 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

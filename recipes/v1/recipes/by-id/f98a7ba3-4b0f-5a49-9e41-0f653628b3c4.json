  "id": "f98a7ba3-4b0f-5a49-9e41-0f653628b3c4",
  "slug": "sweet-corn-gazpacho-recipe-11768539",
  "name": "Sweet Corn Gazpacho",
  "recipe_type": "appetizer",
  "brief_description": "This sweet corn gazpacho is a no-cook, chilled sweet corn soup perfect for hot summer days. Its texture is silky and creamy using fresh, peak-season summer produce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice the corn kernels off the cob; reserve 1/3 cup for garnish."
    },
    {
      "position": 2,
      "text": "Place corn, tomato, yellow bell pepper, cucumber, onion, olive oil, vinegar, lime juice, and garlic in a high speed blender, and process just until smooth, but not totally pureed. Season to taste with salt and pepper."
    },
    {
      "position": 3,
      "text": "Transfer the mixture to an airtight container, and chill in the refrigerator for at least 2 hours. Garnish with basil, a sprinkle of reserved corn kernels, a drizzle of olive oil, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

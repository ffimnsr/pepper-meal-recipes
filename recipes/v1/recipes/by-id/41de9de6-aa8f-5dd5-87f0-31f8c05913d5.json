  "id": "41de9de6-aa8f-5dd5-87f0-31f8c05913d5",
  "slug": "chateaubriand",
  "name": "Chateaubriand",
  "recipe_type": "main",
  "brief_description": "Savory tenderloin filets are quickly seared, then fried in butter. Tastes great with freshly ground black pepper and a Bernaise sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rub the beef with the vegetable oil and season with freshly ground black pepper. Let the beef rest at room temperature for 1 hour."
    },
    {
      "position": 2,
      "text": "Heat a large, heavy skillet over medium-high heat. Quickly sear the meat about 5 seconds on each side, then remove from skillet. Melt and brown the butter in the skillet. Return the meat to the skillet, and fry 4 to 5 minutes on each side. The outside of the meat should be browned and crisp. Remove from the skillet and let stand for about 5 minutes for the juices to settle."
    }
  ],

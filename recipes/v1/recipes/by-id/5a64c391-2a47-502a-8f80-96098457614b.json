  "id": "5a64c391-2a47-502a-8f80-96098457614b",
  "slug": "jalapeno-popper-spread",
  "name": "Easy Jalape\u00f1o Popper Dip",
  "recipe_type": "appetizer",
  "brief_description": "This jalape\u00f1o popper dip recipe is easy to make with cream cheese, Cheddar, canned green chiles and jalape\u00f1o peppers for a warm, creamy, spicy dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream cheese and mayonnaise in a large bowl until smooth. Stir in green chiles and jalape\u00f1o peppers; transfer to a microwave-safe serving dish."
    },
    {
      "position": 3,
      "text": "Sprinkle with Parmesan cheese. Microwave on High until hot and heated through, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

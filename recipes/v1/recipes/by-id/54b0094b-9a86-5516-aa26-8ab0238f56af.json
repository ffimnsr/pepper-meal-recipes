  "id": "54b0094b-9a86-5516-aa26-8ab0238f56af",
  "slug": "sinaloa-style-ceviche",
  "name": "Sinaloa-Style Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "This shrimp and imitation crab ceviche recipe is prepared Sinaloa-style with serrano and jalape\u00f1o chiles, tomatoes, red onion, and fresh lime juice.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine shrimp, \u00bd lime juice, and white onion in a large bowl. Cover with plastic wrap and refrigerate until shrimp is opaque, about 12 hours. Drain; discard accumulated juices."
    },
    {
      "position": 2,
      "text": "Combine remaining \u00bd lime juice with serrano in a large bowl."
    },
    {
      "position": 3,
      "text": "Add shrimp mixture, crabmeat, tomatoes, cucumber, cilantro, red onion, and jalape\u00f1os to the bowl. Stir in tomato and clam juice cocktail; season with salt and black pepper."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,

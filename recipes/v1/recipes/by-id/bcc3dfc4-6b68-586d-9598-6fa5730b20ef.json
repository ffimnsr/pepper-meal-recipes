  "slug": "orangeade",
  "name": "Orangeade",
  "recipe_type": "snack",
  "brief_description": "A refreshing 'ade' made with fresh-squeezed orange juice as well as lemon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2 cups water and sugar to a boil in a small saucepan; cook at a boil for 3 minutes, stirring to dissolve sugar, and creating a simple syrup."
    },
    {
      "position": 2,
      "text": "Combine simple syrup, 6 cups water, orange juice, and lemon juice in a large pitcher; refrigerate until cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

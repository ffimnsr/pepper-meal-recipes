{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ce2ac7ab-3c3d-5f98-ab63-be90b0f1d81a",
  "slug": "frozen-pork-chops-in-the-instant-pot",
  "name": "Frozen Pork Chops in the Instant Pot",
  "recipe_type": "main",
  "brief_description": "Make frozen pork chops in the Instant Pot with a creamy mushroom gravy the whole family will love. Don't let frozen meat stop you from an easy dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add butter once the pot is hot. Add onion and stir frequently until soft and fragrant, about 5 minutes. Add garlic base and pour in water. Stir to combine."
    },
    {
      "position": 2,
      "text": "Mix all-purpose seasoning and shallot salt together in a bowl and sprinkle on both sides of the pork chops. Nestle pork chops on top of the onion. Hit Cancel. Seal and lock the lid into place."
    },
    {
      "position": 3,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 13 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions for 12 minutes. Release remaining pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Remove pork chops to a plate. Hit Cancel and switch to Saut\u00e9 function. Add mushrooms and stir."
    },
    {
      "position": 6,
      "text": "Whisk whipping cream, flour, and browning sauce together in a measuring cup. Add mixture to the pot. Allow to thicken slightly, about 3 minutes. Ladle mushroom gravy on top of pork chops. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

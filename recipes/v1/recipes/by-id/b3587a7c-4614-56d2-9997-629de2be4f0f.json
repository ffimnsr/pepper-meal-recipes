  "id": "b3587a7c-4614-56d2-9997-629de2be4f0f",
  "slug": "italian-cream-cake-ii",
  "name": "Best Italian Cream Cake",
  "recipe_type": "dessert",
  "brief_description": "Creamy Italian frosting and a light and fluffy cake with pecans and coconut create this Italian cream cake that's perfect for special occasions.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour three 8-inch round cake pans."
    },
    {
      "position": 2,
      "text": "Beat egg whites until they form stiff peaks."
    },
    {
      "position": 3,
      "text": "In a large bowl, cream 1/2 cup butter and shortening till light. Add white sugar, and beat till fluffy. Beat in egg yolks. Stir together flour and baking soda, and add alternately with buttermilk into the creamed mixture; mix well after each addition. Stir in 1 teaspoon vanilla, coconut, and 1 cup pecans. Fold in stiffly beaten egg whites. Spoon into prepared pans."
    },
    {
      "position": 4,
      "text": "Bake cakes in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 25 to 30 minutes. Cool in pans for 10 minutes. Remove to wire rack to cool completely, about 1 hour."
    },
    {
      "position": 5,
      "text": "Combine cream cheese, 1/2 cup butter, confectioners' sugar, and 1 teaspoon vanilla in mixer bowl. Beat till smooth. Add coconut if desired. Frost the cooled cake. The remaining 1/2 cup pecans can be stirred into frosting or sprinkled onto the cake after it is frosted."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

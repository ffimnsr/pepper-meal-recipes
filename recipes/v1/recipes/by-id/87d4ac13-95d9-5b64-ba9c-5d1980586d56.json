  "id": "87d4ac13-95d9-5b64-ba9c-5d1980586d56",
  "slug": "asparagus-wrapped-in-crisp-prosciutto",
  "name": "Asparagus Wrapped in Crisp Prosciutto",
  "recipe_type": "appetizer",
  "brief_description": "Prosciutto-wrapped asparagus is a quick, elegant appetizer that's simple to prep with just 2 ingredients and easy to roast to crispy perfection.",
  "cuisine": "Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (220 degrees C). Line a baking sheet with aluminum foil, and coat with olive oil."
    },
    {
      "position": 2,
      "text": "Wrap one slice of prosciutto around each asparagus spear, starting at the bottom, and spiraling up to the tip. Place the wrapped spears on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 5 minutes. Remove, and shake the pan back and forth to roll the spears over. Return to the oven until asparagus is tender and prosciutto is crisp, another 5 minutes. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

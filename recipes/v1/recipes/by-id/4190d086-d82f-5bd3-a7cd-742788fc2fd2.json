  "slug": "layered-egg-salad-dip-recipe-11979008",
  "name": "Layered Egg Salad Dip",
  "recipe_type": "salad",
  "brief_description": "This layered egg salad dip puts a fun twist on classic egg salad with layers of mayo, chopped eggs, pickles, tomatoes, and green onions. It\u2019s quick, easy to make, and perfect for entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread mayonnaise in an even layer on a serving platter."
    },
    {
      "position": 2,
      "text": "Sprinkle evenly with salt and pepper and top evenly with chopped eggs, tomatoes, pickles, and green onions. Sprinkle with more pepper and serve with crackers or refrigerate until ready to serve."
    }
  ],
  "servings": 8,

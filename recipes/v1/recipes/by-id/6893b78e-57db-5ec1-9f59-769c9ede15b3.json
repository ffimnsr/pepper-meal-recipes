{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6893b78e-57db-5ec1-9f59-769c9ede15b3",
  "slug": "mushroom-chicken-piccata",
  "name": "Mushroom Chicken Piccata",
  "recipe_type": "drink",
  "brief_description": "The classic chicken piccata recipe, featuring chicken cooked with white wine, lemon juice, and butter, gets a lovely boost with the addition of mushrooms.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix egg and milk together in a shallow bowl. Mix flour, salt, and paprika together in a second shallow bowl. Dip chicken into egg mixture, then lift up so excess egg drips back into the bowl. Press into flour mixture to coat both sides."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Add chicken and saut\u00e9 until golden brown, 2 to 3 minutes per side. Add mushrooms and onion; saut\u00e9 for 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Mix broth, wine, lemon juice, and cornstarch together in a medium bowl; pour over chicken and mushrooms. Reduce the heat to medium-low and simmer until chicken is cooked through and the juices run clear, about 25 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Sprinkle with parsley and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

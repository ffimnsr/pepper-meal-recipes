  "id": "43a850e6-596c-57dd-9c8d-804758a28175",
  "slug": "mediterranean-fish-soup",
  "name": "Mediterranean Fish Soup",
  "recipe_type": "soup",
  "brief_description": "Orange juice, white wine, bay leaves, and fennel give this shrimp and cod soup its distinctive flavor.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Place broth, tomatoes, onion, bell pepper, tomato sauce, orange juice, wine, mushrooms, olives, bay leaves, garlic, basil, fennel seed, and black pepper into a slow cooker. Cook on Low until vegetables are crisp-tender, 4 to 4 1/2 hours."
    },
    {
      "position": 2,
      "text": "Stir in shrimp and cod. Continue cooking until shrimp are opaque, 15 to 30 minutes. Discard bay leaves before serving."
    }
  ],
  "servings": 6,

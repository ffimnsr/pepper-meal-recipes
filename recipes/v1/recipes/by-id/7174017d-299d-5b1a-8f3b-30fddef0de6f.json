  "id": "7174017d-299d-5b1a-8f3b-30fddef0de6f",
  "slug": "vegan-fajitas-with-tempeh",
  "name": "Vegan Fajitas with Tempeh",
  "recipe_type": "main",
  "brief_description": "Instead of the usual chicken or beef, these vegan fajitas are made with tempeh, soy-based protein that absorbs flavors really well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add red pepper, onion, garlic, and salt. Cook and stir until fragrant, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, mix tempeh, water, and fajita seasoning together in a shallow bowl."
    },
    {
      "position": 3,
      "text": "Add seasoned tempeh to the skillet. Cook over medium-low heat, stirring often, until tempeh absorbs flavors, about 15 minutes. Reduce heat to low and keep warm until ready to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "a3349ee1-61fe-5834-9bf1-f2717028626b",
  "slug": "ricotta-pineapple-upside-down-cake",
  "name": "Ricotta Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This variation on traditional homemade pineapple upside-down cake is made with ricotta cheese for extra flavor and texture.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch round cake pan with at least 2-inch high sides."
    },
    {
      "position": 2,
      "text": "Pour melted butter into the greased pan and swirl to coat. Sprinkle brown sugar evenly over butter. Place pineapple slices in an even layer over the brown sugar, slightly overlapping and trimming pieces to fit as necessary, covering the whole bottom of the pan. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk together flour, baking powder, cornstarch, salt, cinnamon, and nutmeg in a small bowl until combined."
    },
    {
      "position": 4,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form."
    },
    {
      "position": 5,
      "text": "Cream together 3/4 cup plus 2 tablespoons white sugar, softened butter, egg yolks, and vanilla in a large bowl until light and fluffy, about 3 minutes. Add in half of the flour mixture and mix until just combined. Add ricotta cheese and mix until just combined. Add remaining flour mixture, stirring until just combined."
    },
    {
      "position": 6,
      "text": "Add 1/3 of the whipped egg whites to the batter, and fold until no streaks of egg whites remain. Gently fold in remaining egg whites until no streaks of egg whites remain. Pour batter evenly over pineapple slices, and gently smooth into an even layer."
    },
    {
      "position": 7,
      "text": "Place cake pan into the preheated oven and bake until a toothpick inserted into the center of the cake comes out with a few moist crumbs, 50 to 55 minutes."
    },
    {
      "position": 8,
      "text": "Allow cake to cool in the pan 10 minutes before running a knife around the sides to loosen. Invert cake onto a serving platter and let pan sit for a few minutes on top of the cake before removing. Allow cake to cool before serving."
    }
  ],
  "servings": 10,

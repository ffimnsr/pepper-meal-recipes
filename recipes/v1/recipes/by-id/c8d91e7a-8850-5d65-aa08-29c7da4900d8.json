  "id": "c8d91e7a-8850-5d65-aa08-29c7da4900d8",
  "slug": "ginger-scones",
  "name": "Ginger Scones",
  "recipe_type": "breakfast",
  "brief_description": "This recipe yields light, buttery, warmly spiced ginger scones. They're aromatic, thanks to a blend of ground ginger, crystallized ginger, and cardamom.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, 3 tablespoons white sugar, baking powder, ground ginger, cardamom, baking soda, and salt together until thoroughly combined. Grate in frozen butter using a box grater; toss until mixture resembles coarse crumbs. Stir in crystallized ginger."
    },
    {
      "position": 3,
      "text": "Whisk buttermilk, 1 egg, and vanilla extract together in a small bowl or measuring cup until thoroughly combined; mix into flour mixture until no dry clumps of flour remain. Dough will be somewhat sticky; do not overmix."
    },
    {
      "position": 4,
      "text": "Turn dough out onto the prepared baking sheet. Gently press dough together into an even 7-inch circle, lightly flouring your fingers if dough is too sticky to shape. Cut dough into 8 triangles using a bench scraper. Space scones 1 inch apart on the baking sheet."
    },
    {
      "position": 5,
      "text": "Whisk 1 egg and water until combined; gently brush tops of scones with egg wash. Sprinkle with 3 tablespoons coarse sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until scones are lightly browned, 20 to 25 minutes. Cool on the baking sheet for 5 minutes before transferring scones to a wire rack to cool completely."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

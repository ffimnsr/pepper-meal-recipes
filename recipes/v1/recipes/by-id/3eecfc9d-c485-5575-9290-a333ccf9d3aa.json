  "id": "3eecfc9d-c485-5575-9290-a333ccf9d3aa",
  "slug": "mason-jar-lemonade",
  "name": "Mason Jar Lemonade",
  "recipe_type": "drink",
  "brief_description": "You don't need to be a hipster to prepare and drink your lemonade from a Mason jar using this one serving recipe for the classic summertime beverage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Roll lemon on a flat surface; cut in half. Squeeze juice and pulp into a Mason jar; add 12 ounces cold water."
    },
    {
      "position": 2,
      "text": "Combine sugar and remaining 2 ounces cold water in a small saucepan over medium heat; cook until sugar dissolves. Pour simple syrup and ice into the Mason jar; stir."
    }
  ],

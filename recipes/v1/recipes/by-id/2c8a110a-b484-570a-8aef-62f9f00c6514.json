  "id": "2c8a110a-b484-570a-8aef-62f9f00c6514",
  "slug": "broiled-salisbury-steaks",
  "name": "Broiled Salisbury Steaks",
  "recipe_type": "main",
  "brief_description": "Salisbury steaks made with a hint of onion and green bell pepper are a flavorful and comforting main dish for weeknight dinners.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Mix ground beef, onion, green bell pepper, parsley, salt, paprika, garlic, black pepper, and thyme together in a bowl; divide into 4 portions and shape into patties. Arrange patties on the prepared baking sheet. Dust both sides of patties with flour and brush with oil."
    },
    {
      "position": 3,
      "text": "Broil in the preheated oven until steaks are cooked through, 4 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

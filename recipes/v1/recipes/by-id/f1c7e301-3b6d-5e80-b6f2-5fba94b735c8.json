  "id": "f1c7e301-3b6d-5e80-b6f2-5fba94b735c8",
  "slug": "apple-goat-cheese-bruschetta",
  "name": "Apple Goat Cheese Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Topping French bread slices with a mixture of apple, goat cheese, and herbs makes a delicious and quick appetizer.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven's broiler and set the oven rack 3 to 4 inches from the heat source."
    },
    {
      "position": 2,
      "text": "Toss together the goat cheese, apple, thyme, oregano, and pepper in a bowl; set aside. Arrange the bread slices on a baking sheet; toast the bread under the broiler until golden brown, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle the goat cheese mixture evenly over the bread slices. Return bread to oven to broil until cheese is softened, about 1 minute more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 10,

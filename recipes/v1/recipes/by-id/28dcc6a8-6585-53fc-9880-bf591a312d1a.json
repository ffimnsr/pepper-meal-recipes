  "schema_version": 1,
  "id": "28dcc6a8-6585-53fc-9880-bf591a312d1a",
  "slug": "beef-wellington",
  "name": "Beef Wellington",
  "recipe_type": "main",
  "brief_description": "Learn how to make beef Wellington with this recipe that wraps beef tenderloin and mushroom duxelles in golden flaky puff pastry for a holiday classic.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place beef tenderloin in a baking dish. Spread 2 tablespoons softened butter over beef."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned, 10 to 15 minutes. Remove beef from the pan and reserve pan juices; allow beef to cool completely."
    },
    {
      "position": 4,
      "text": "Increase oven temperature to 450 degrees F (230 degrees C)."
    },
    {
      "position": 5,
      "text": "Melt 2 tablespoons butter in a skillet over medium heat. Saut\u00e9 onion and mushrooms in butter for 5 minutes. Remove from heat and let cool."
    },
    {
      "position": 6,
      "text": "Mix pat\u00e9 and remaining 2 tablespoons softened butter together in a bowl; season with salt and pepper. Spread pat\u00e9 mixture over beef. Top with onion and mushroom mixture."
    },
    {
      "position": 7,
      "text": "Roll out puff pastry dough to about 1/4-inch thickness and place beef in the center."
    },
    {
      "position": 8,
      "text": "Fold up and seal all the edges, making sure the seams are not too thick. Place beef in a 9x13-inch baking dish, cut a few slits in the top of dough, and brush with egg yolk."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 425 degrees F (220 degrees C) and continue baking until pastry is a rich, golden brown, 10 to 15 minutes. An instant-read thermometer inserted into the center should read between 122 to 130 degrees F (50 to 54 degrees C) for medium rare. Set aside to rest."
    },
    {
      "position": 10,
      "text": "Meanwhile, place reserved pan juices in a small saucepan over high heat. Stir in beef broth and red wine; boil until slightly reduced, about 5 minutes. Strain and serve with beef."
    },
    {
      "position": 11,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,

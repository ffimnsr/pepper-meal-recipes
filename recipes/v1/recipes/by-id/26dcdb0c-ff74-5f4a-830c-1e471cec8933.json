  "id": "26dcdb0c-ff74-5f4a-830c-1e471cec8933",
  "slug": "eclair-cake",
  "name": "\u00c9clair Cake",
  "recipe_type": "dessert",
  "brief_description": "This easy \u00e9clair cake requires no baking, feeds a crowd, and tastes just like the famous pastry. An impressively simple 5-ingredient dessert!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir milk, whipped topping, and pudding mix together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Arrange a single layer of graham cracker squares in the bottom of a 9x13-inch baking pan."
    },
    {
      "position": 4,
      "text": "Evenly spread half of the pudding mixture over the crackers; top with another layer of crackers and the remaining pudding mixture. Top with a final layer of graham crackers. Cover and refrigerate for 30 minutes."
    },
    {
      "position": 5,
      "text": "Spread frosting over the chilled cake up to the edges of the pan. Cover again and chill for at least 3 \u00bd hours before serving."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 14,
  "cooking_time_minutes": null,

  "slug": "coconut-pecan-frosting-ii",
  "name": "Coconut Pecan Frosting",
  "recipe_type": "dessert",
  "brief_description": "This thick, sweet, and nutty coconut and pecan frosting is ideal for German chocolate cake, but it's also delicious on many other types of cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine milk, sugar, egg yolks, butter, and vanilla in a saucepan over medium heat. Cook, stirring frequently, until thickened, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in coconut and pecans."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,

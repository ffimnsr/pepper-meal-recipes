  "id": "e2d6f361-f9bf-55e7-a53f-90384a19e766",
  "slug": "rizogalo-greek-rice-pudding",
  "name": "Rizogalo (Greek Rice Pudding)",
  "recipe_type": "dessert",
  "brief_description": "Greek rice pudding is a simple, comforting, and delicious dessert. Some Greek versions make rizogalo with eggs, but this is an egg-free version.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Immediately reduce the heat to medium-low and cook, uncovered and at a slow simmer, stirring occasionally, until soft and most of the water has been absorbed, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Add 2 cups milk and sugar. Increase the heat to high and bring to a boil."
    },
    {
      "position": 3,
      "text": "Stir remaining 1/2 cup milk and cornstarch together in a bowl; add to boiling rice-milk mixture along with vanilla. Stir until well combined, then remove from the heat."
    },
    {
      "position": 4,
      "text": "Ladle into individual serving dishes and sprinkle with cinnamon. Let cool to room temperature, about 30 minutes, then refrigerate until well chilled, at least 4 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

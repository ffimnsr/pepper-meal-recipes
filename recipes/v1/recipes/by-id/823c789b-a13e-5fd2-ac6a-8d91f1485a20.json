  "id": "823c789b-a13e-5fd2-ac6a-8d91f1485a20",
  "slug": "healthier-baked-ziti",
  "name": "Healthier Baked Ziti",
  "recipe_type": "main",
  "brief_description": "Baked ziti is made a little healthier when using turkey sausage and reduced-fat sour cream and extra vegetables in the recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook ziti in the boiling water, stirring occasionally until cooked through but firm to the bite, 8 minutes. Drain and transfer pasta to a bowl and toss with spinach and sour cream."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium heat; cook and stir sausage, onion, carrots, and garlic until onion is translucent and sausage is no longer pink, about 7 minutes. Add spaghetti sauce and broccoli to sausage mixture and simmer until sauce mixture is heated through, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Layer 1/2 of the ziti mixture into a 9x13-inch baking dish. Spread 1/2 of the fresh mozzarella cheese, 1/2 of the sauce mixture, the remaining ziti mixture, and fresh mozzarella cheese, respectively, into the baking dish. Sprinkle shredded mozzarella cheese over the dish. Cover dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheeses have melted, about 20 minutes. Remove the aluminum foil and cook until top is lightly browned, about 10 minutes more."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "7d4ffa7f-ac3a-53dc-9588-be5930a716dd",
  "slug": "fresh-cranberry-orange-sauce",
  "name": "Fresh Cranberry-Orange Sauce",
  "recipe_type": "side",
  "brief_description": "Fresh cranberries and oranges combine in this delicious cranberry-orange sauce which is a must-have Thanksgiving or holiday side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine orange juice, cranberry juice, and sugar in a saucepan over medium-high heat; bring to a boil. Cook, stirring occasionally, for about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in 1/2 of the cranberries, pear, orange zest, vanilla extract, star anise, and salt, and return to a boil. Reduce heat and simmer for about 5 minutes. Add the remaining cranberries and cook, stirring often, until cranberries start to burst and mixture starts to thicken, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat. Stir in orange marmalade and set aside. Sauce will continue to thicken as it cools. Cover and refrigerate until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

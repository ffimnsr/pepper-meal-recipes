  "slug": "frozen-chocolate-graham-ice-cream-sandwiches",
  "name": "Frozen Chocolate Graham 'Ice Cream' Sandwiches",
  "recipe_type": "dessert",
  "brief_description": "Perfect to have in the freezer for those ice cream cravings! These frozen treats made with chocolate grahams and whipped topping are sure to become a staple at your house.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Break chocolate graham crackers into squares. Spread a thick layer of whipped topping on half of the squares and place another square on top to make a sandwich. Gently wrap in plastic wrap and freeze for 1 hour or until set."
    }
  ],

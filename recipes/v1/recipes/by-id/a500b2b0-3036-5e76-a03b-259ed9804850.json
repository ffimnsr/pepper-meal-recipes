  "id": "a500b2b0-3036-5e76-a03b-259ed9804850",
  "slug": "mushroom-pilaf-with-pine-nuts-and-dried-cherries-recipe-8691875",
  "name": "Mushroom Pilaf with Pine Nuts and Dried Cherries",
  "recipe_type": "dessert",
  "brief_description": "This simple mushroom pilaf with pine nuts and dried cherries combines savory mushrooms and sweet cherries, a perfect side dish for summer or fall mains.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons oil over medium heat in a large oven-safe skillet. Add mushrooms; cook, stirring occasionally, until browned, about 8 minutes. Add remaining 1 teaspoon olive oil and the rice; cook, stirring occasionally, until rice is fragrant, about 2 minutes. Stir in stock, pine nuts, cherries, salt, and pepper. Bring to a boil."
    },
    {
      "position": 3,
      "text": "Bake, covered, in the preheated oven until liquid is absorbed, about 17 minutes. Let stand, covered, 5 minutes. Fluff with a fork. Sprinkle with fresh basil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9b3455aa-7ca2-5753-93ee-3f9efef183fb",
  "slug": "red-hot-applesauce-jell-o",
  "name": "Red Hot Applesauce Jell-O",
  "recipe_type": "salad",
  "brief_description": "Applesauce jello gets additional flavor from cinnamon candies for a sweet and delicious alternative to cranberry sauce or a light holiday dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve cinnamon candies in water in a medium saucepan over medium heat. Stir in gelatin and allow to dissolve; remove from heat."
    },
    {
      "position": 2,
      "text": "Stir applesauce into gelatin mixture until well combined. Pour mixture into a serving dish and refrigerate until set, about 2 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,

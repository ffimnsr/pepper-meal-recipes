  "id": "89f20337-e2ea-571d-a22b-d2b1e36b403a",
  "slug": "chocolate-walnut-fudge",
  "name": "Chocolate Walnut Fudge",
  "recipe_type": "dessert",
  "brief_description": "Marshmallows, chocolate chips and evaporated milk are the signature ingredients in this chocolate fudge with walnuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter an 8x8 inch dish."
    },
    {
      "position": 2,
      "text": "Place butter, chocolate chips and vanilla in a mixing bowl. Set aside."
    },
    {
      "position": 3,
      "text": "In a medium saucepan over medium heat, combine sugar, milk and marshmallows. Bring to a boil, stirring frequently. Reduce heat to low and cook 6 minutes more, stirring constantly. Remove from heat."
    },
    {
      "position": 4,
      "text": "Pour marshmallow mixture over contents of mixing bowl. Beat entire mixture until it thickens and loses its gloss. Quickly fold in nuts and pour into prepared pan. Refrigerate several hours until firm."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

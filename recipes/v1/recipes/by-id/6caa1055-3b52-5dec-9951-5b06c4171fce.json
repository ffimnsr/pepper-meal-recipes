  "id": "6caa1055-3b52-5dec-9951-5b06c4171fce",
  "slug": "easiest-sheet-pan-tacos-recipe-11700898",
  "name": "Easiest Sheet Pan Tacos",
  "recipe_type": "main",
  "brief_description": "This recipe for the easiest sheet pan tacos presents a way to make beef, bean, and cheese tacos by roasting at high temperature on a sheet pan.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a rimmed baking sheet with foil or parchment paper and lightly coat with 1 tablespoon olive oil."
    },
    {
      "position": 2,
      "text": "Combine beef, onion, green chiles, chili powder, cumin, garlic powder, and salt in a medium bowl and mix until well incorporated."
    },
    {
      "position": 3,
      "text": "Wrap tortillas in a damp paper towel and microwave just until softened, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Spread about 3 tablespoons beef mixture over half of a tortilla in a very thin layer that reaches to the edges Spread about 1 tablespoon beans onto the other half. Sprinkle all over with about 2 tablespoons cheese. Fold tortilla in half to make a taco; place on prepared baking sheet. Repeat with remaining tortillas, meat and cheese. Brush tops of tacos with remaining oil."
    },
    {
      "position": 5,
      "text": "Bake tacos in the preheated oven, flipping halfway through, until lightly browned, toasted, and crisp around the edges, 30 to 35 minutes. Serve with desired toppings."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

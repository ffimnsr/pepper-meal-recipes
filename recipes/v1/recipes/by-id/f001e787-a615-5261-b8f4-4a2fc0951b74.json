  "id": "f001e787-a615-5261-b8f4-4a2fc0951b74",
  "slug": "one-pan-tuna-noodle-casserole-recipe-7373575",
  "name": "One-Pan Tuna Noodle Casserole",
  "recipe_type": "main",
  "brief_description": "This easy one-pan casserole comes together very quickly. Using fully cooked pasta and other prepared ingredients cuts down on prep time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk soup, milk, lemon juice, lemon zest, Worcestershire sauce, and crushed red pepper together in a large bowl. Stir in cooked pasta, tuna, spinach, Monterey Jack cheese, green onions, and roasted red pepper until well combined."
    },
    {
      "position": 3,
      "text": "Transfer to the prepared baking dish. Top with crushed potato chips."
    },
    {
      "position": 4,
      "text": "Cover loosely with foil and bake until hot and bubbly, about 35 minutes. Remove foil for the last 10 minutes of baking."
    },
    {
      "position": 5,
      "text": "Serve immediately and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "puff-pastry-margherita-pizza-recipe-7255338",
  "name": "Puff Pastry Margherita Pizza",
  "recipe_type": "main",
  "brief_description": "This puff pastry pizza is quick and easy to make for a unique pizza crust with a light, flaky texture, and traditional Margherita toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spread each sheet of puff pastry onto a piece of lightly floured parchment paper. Use a rolling pin to roll pastry into even rectangles. Lift pastry (with parchment paper) onto baking sheets."
    },
    {
      "position": 2,
      "text": "Pierce puff pastry all over with a fork. Beat egg with water in a small dish; brush pastry all over with egg wash."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, pulse tomatoes, 1/2 teaspoon of the olive oil, garlic, and a pinch of salt together in a food processor until pureed."
    },
    {
      "position": 5,
      "text": "Carefully press pastry crusts down to deflate them. Spread half the tomato sauce evenly to within about an inch of edges of each crust; drizzle with remaining olive oil. Top evenly with mozzarella cheese and Parmigiano-Reggiano cheese."
    },
    {
      "position": 6,
      "text": "Bake until cheese is melted and crust edges are golden, about 5 minutes more. Remove from the oven and scatter basil leaves over the top. Slice and serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

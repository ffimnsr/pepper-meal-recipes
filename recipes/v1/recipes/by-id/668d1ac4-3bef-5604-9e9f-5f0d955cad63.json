{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "668d1ac4-3bef-5604-9e9f-5f0d955cad63",
  "slug": "the-best-classic-beef-stroganoff",
  "name": "The Best Classic Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "Classic beef stroganoff with no shortcuts means beef tenderloin cooked in butter, onions, mushrooms, and sour cream, served over noodles.",
  "cuisine": "Russian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, salt, and pepper together in a bowl. Pound mixture into the beef. Cut beef into 1/2-inch strips."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Add beef; cook until browned, about 10 minutes. Remove meat with a slotted spoon, transfer to a covered container, and refrigerate while you make the gravy; do not wash the pan."
    },
    {
      "position": 3,
      "text": "Stir water, onion, and garlic into the pan. Cook and stir over medium heat until all of the brown bits have been scraped from the bottom of the pan, about 5 minutes. Add mushrooms and stir in condensed soup. Cook until mushrooms are tender, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Mix beef and gravy in a pot over medium heat until hot but not boiling, about 5 minutes. Add sour cream and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

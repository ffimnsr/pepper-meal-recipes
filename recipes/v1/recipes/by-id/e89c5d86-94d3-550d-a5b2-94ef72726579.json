  "id": "e89c5d86-94d3-550d-a5b2-94ef72726579",
  "slug": "coconut-chia-pudding-with-strawberries-recipe-11997522",
  "name": "Coconut Chia Pudding with Strawberries",
  "recipe_type": "dessert",
  "brief_description": "Creamy coconut chia pudding layered with naturally sweet strawberries makes an easy make-ahead breakfast or snack. Light coconut milk keeps it rich without feeling heavy, while fresh strawberries add bright flavor and color. Best of all, it keeps well in the refrigerator for up to 5 days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, combine coconut milk, chia seed, 1 tablespoon maple syrup, vanilla bean paste, and salt. Transfer to the refrigerator to thicken for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine strawberries and remaining maple syrup. Let sit for 15 to 30 minutes to release their juices."
    },
    {
      "position": 3,
      "text": "Drain excess liquid from strawberries, and set aside about 1/4 cup strawberries for topping."
    },
    {
      "position": 4,
      "text": "Divide remaining strawberries among 4 (8 ounce) jars. Spoon chia pudding evenly over strawberries and top with reserved strawberries. Place lids on jars and refrigerate overnight before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

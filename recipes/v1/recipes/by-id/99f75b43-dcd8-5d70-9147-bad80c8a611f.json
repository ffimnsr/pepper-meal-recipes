  "id": "99f75b43-dcd8-5d70-9147-bad80c8a611f",
  "slug": "fresh-corn-cherry-tomato-and-basil-salad-recipe-11828330",
  "name": "Fresh Corn, Cherry Tomato, and Basil Salad",
  "recipe_type": "salad",
  "brief_description": "This fresh corn, cherry tomato, and basil salad is about the tastiest use of summer garden vegetables you can imagine. With a basic, quick vinaigrette, this salad is on the table in under 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a cast iron pan over medium-high heat; add corn ears to the pan and cook, turning ears occasionally with tongs, until some kernels are blackened on the surface, about 3 minutes. Set corn aside to cool; slice kernels from the cob when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Add corn, cherry tomatoes, basil, and mozzarella to a shallow bowl. Pour vinegar into a small bowl, then whisk in mustard, salt, black pepper, shallot, and parsley. Slowly pour in oil, while whisking vigorously. Spoon by tablespoonfuls over salad until salad is dressed to taste. Refrigerate any extra dressing for another use."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "93203c26-ad9b-5204-8b8c-96d8b8cee69d",
  "slug": "menudo-rojo-red-menudo",
  "name": "Menudo Rojo (Red Menudo)",
  "recipe_type": "soup",
  "brief_description": "Learn how to make menudo with tripe, two kinds of chile peppers, and canned hominy. This vibrantly colored soup is mildly spicy and quite easy to prepare.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the soup: Bring a large pot of water to a boil. Add tripe, reduce the heat, and simmer, periodically skimming off fat, for 2 hours; drain. Fill the pot with fresh water, and simmer tripe for 2 more hours; drain again."
    },
    {
      "position": 3,
      "text": "Pour 1 gallon water over tripe in the pot; bring to a boil. Stir in onion, garlic, red pepper, oregano, salt, and black pepper. Reduce the heat and simmer for 1 hour."
    },
    {
      "position": 4,
      "text": "Meanwhile, set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Arrange \u00e1rbol chiles on a baking sheet. Broil chiles in the preheated oven just until they begin to scorch, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven, slit lengthwise, and remove seeds."
    },
    {
      "position": 6,
      "text": "Place \u00e1rbol chiles into a blender or food processor with japones chiles; blend until minced."
    },
    {
      "position": 7,
      "text": "Stir chile mixture into the pot and continue cooking over low heat for 2 hours."
    },
    {
      "position": 8,
      "text": "Mix hominy into the pot and cook for 1 hour. Serve soup with cilantro, onion, and lime wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 490,
  "preparation_time_minutes": 20,

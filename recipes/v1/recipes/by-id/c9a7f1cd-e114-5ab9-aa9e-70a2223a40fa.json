  "id": "c9a7f1cd-e114-5ab9-aa9e-70a2223a40fa",
  "slug": "fresh-raspberry-balsamic-vinaigrette",
  "name": "Fresh Raspberry Balsamic Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This raspberry vinaigrette is easy to make with fresh raspberries, balsamic vinegar, olive oil, and honey for a quick, summer salad dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix raspberries and sugar together in a bowl; set aside until mixture is juicy, about 10 minutes. Mash raspberries using a fork until liquefied."
    },
    {
      "position": 2,
      "text": "Pour raspberry mixture into a clean jar with a lid; add vinegar, oil, honey, and salt. Cover the jar with a lid and shake until dressing is mixed well. Store in the refrigerator."
    }
  ],
  "servings": 16,

  "id": "cf7432b6-73f7-56a0-927a-1b3f7e8aa4e7",
  "slug": "hot-cocoa-rice-krispie-treat-recipe-11882444",
  "name": "Hot Cocoa Rice Krispie Treats",
  "recipe_type": "dessert",
  "brief_description": "These hot cocoa rice krispie treats are a fun spin on the classic favorite. They're super easy to make and best of all, no baking needed.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x13-inch pan with parchment. Spray parchment with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "In a heavy bottom pot set over medium-low heat, add butter, hot cocoa mix, and 4 cups marshmallows. Stir constantly until marshmallows and butter have completely melted."
    },
    {
      "position": 3,
      "text": "Add in remaining marshmallows, cereal, and vanilla. Stir to make sure everything is coated."
    },
    {
      "position": 4,
      "text": "Pour mixture into the prepared pan, and smooth into an even layer. Lightly press mini chocolate chips and sprinkles onto the top of the treats. Cool for at least 20 minutes before cutting."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

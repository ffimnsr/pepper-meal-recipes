  "id": "c66dac11-c883-581f-ab1b-650b27e1fcd2",
  "slug": "bake-sale-lemon-bars",
  "name": "Bake Sale Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "They are very, very easy to make, and really fabulously delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13 inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine the flour, 2/3 cup confectioners\u2019 sugar, and butter. Pat dough into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake for 20 minutes in the preheated oven, until slightly golden. While the crust is baking, whisk together eggs, white sugar, flour, and lemon juice until frothy. Pour this lemon mixture over the hot crust."
    },
    {
      "position": 4,
      "text": "Return to the preheated oven for an additional 20 to 25 minutes, or until light golden brown. Cool on a wire rack. Dust the top with confectioners\u2019 sugar. Cut into squares."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "id": "cdd35555-9d96-52dc-9e36-c8983c5dc262",
  "slug": "oliebollen-dutch-doughnuts",
  "name": "Oliebollen (Dutch Doughnuts)",
  "recipe_type": "dessert",
  "brief_description": "Olliebollen are traditional Dutch doughnuts made with apples, raisins, and currants. These deep-fried goodies are a festive New Year\u2019s treat.",
  "cuisine": "Dutch",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Break up compressed yeast and stir into warm milk. Let stand for a few minutes to dissolve."
    },
    {
      "position": 3,
      "text": "Sift flour and salt into a large bowl. Stir in yeast mixture and egg until smooth. Fold in currants, raisins, and apple."
    },
    {
      "position": 4,
      "text": "Cover the bowl and set in a warm place to rise until doubled in volume, about 1 hour."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep fryer or heavy pot to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Use two metal spoons to shape scoops of dough into 12 balls."
    },
    {
      "position": 7,
      "text": "Drop them carefully into the hot oil and fry until golden brown, about 8 minutes. Remove doughnuts with a slotted spoon and drain on paper towels."
    },
    {
      "position": 8,
      "text": "Dust warm doughnuts with confectioners\u2019 sugar, transfer to a serving platter, and sprinkle with more sugar just before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

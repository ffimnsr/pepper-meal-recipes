  "id": "baf6586d-42e0-5101-9a54-de7f4c745080",
  "slug": "traditional-victoria-sponge",
  "name": "Best Victoria Sponge Cake",
  "recipe_type": "dessert",
  "brief_description": "Victoria sponge cake is a classic British layer cake made up of two tender sponge cakes sandwiched with jam and cream that's perfect for any occasion!",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 7-inch cake pans and line with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift self-rising flour into a bowl; add sugar, margarine, and 1/2 teaspoon vanilla extract. Crack in eggs; beat with a wooden spoon or an electric mixer until pale and fluffy, about 3 minutes. Divide batter between the cake pans; smooth the tops with the back of a spoon."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until top is golden brown and a toothpick inserted into the center comes out clean, 30 to 40 minutes. Cool in the pans for 5 minutes. Invert onto a wire rack to cool completely, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Sift confectioners' sugar into a bowl; add butter and 1/2 teaspoon vanilla extract. Beat with an electric mixer until frosting is light and fluffy."
    },
    {
      "position": 5,
      "text": "Spread jam over 1 cake layer; cover jam with frosting. Place second cake layer on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

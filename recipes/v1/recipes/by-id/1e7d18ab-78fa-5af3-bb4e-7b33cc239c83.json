  "id": "1e7d18ab-78fa-5af3-bb4e-7b33cc239c83",
  "slug": "texas-sheet-cake-v",
  "name": "Texas Sheet Cake",
  "recipe_type": "dessert",
  "brief_description": "This easy Texas sheet cake is a moist and delicious chocolate cake with chocolate icing and walnuts. It is always a favorite for celebrations.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10x15-inch jelly roll pan."
    },
    {
      "position": 3,
      "text": "To make the cake: Combine flour, sugar, baking soda, and salt in a mixing bowl. Beat in sour cream and eggs."
    },
    {
      "position": 4,
      "text": "Melt butter in a saucepan over low heat. Stir in water and cocoa powder. Bring mixture to a boil then remove from the heat."
    },
    {
      "position": 5,
      "text": "Allow to cool slightly, then stir cocoa mixture into the flour and egg mixture until blended. Pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. While the cake is baking, make icing: Combine milk, cocoa powder, and butter in a large saucepan over medium heat."
    },
    {
      "position": 7,
      "text": "Bring to a boil, then remove from heat. Stir in confectioners' sugar and vanilla, then fold in walnuts, mixing until blended."
    },
    {
      "position": 8,
      "text": "Spread icing over warm cake."
    },
    {
      "position": 9,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

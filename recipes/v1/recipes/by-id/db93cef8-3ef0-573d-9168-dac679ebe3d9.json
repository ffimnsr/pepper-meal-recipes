  "id": "db93cef8-3ef0-573d-9168-dac679ebe3d9",
  "slug": "mariettas-butterscotch-bourbon-biscotti",
  "name": "Marietta's Butterscotch Bourbon Biscotti",
  "recipe_type": "dessert",
  "brief_description": "This biscotti recipe includes bourbon, butterscotch, and pecans to yield a delicious caramel-like flavor that is not too sweet.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk sugar and 3 eggs together in a large bowl until light and fluffy. Mix in butter, bourbon, and vanilla extract."
    },
    {
      "position": 3,
      "text": "Sift flour and baking powder together in a small bowl; add to egg mixture and stir until smooth dough forms. Fold in butterscotch chips and pecans."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a lightly floured work surface; divide into 4 equal pieces. Roll each piece into 2-inch wide by 9-inch long log; place on baking sheet. Brush logs with beaten egg."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until pale golden, about 25 minutes. Cool until firm, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Cut each log diagonally into 1-inch thick slices on a work surface; place slices, cut-side down, on baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in oven until tops are golden, about 10 minutes. Invert slices and bake until tops are golden, about 10 minutes more."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

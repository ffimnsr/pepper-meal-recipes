  "id": "022d7415-df0b-57d0-814a-c4b71736f6f5",
  "slug": "easy-valentine-sandwich-cookies",
  "name": "Easy Valentine Sandwich Cookies",
  "recipe_type": "dessert",
  "brief_description": "Perfect for Valentine's Day, these cute heart-shaped sandwich cookies with pink frosting feature a small heart-shaped cutout in the top cookie to reveal the filling inside.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream butter and confectioners' sugar together in a large bowl. Beat in egg, vanilla, and almond extract."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking soda, and cream of tartar together in a medium bowl. Add to butter mixture; beat until dough is just combined. Divide dough into thirds and shape each portion into a ball."
    },
    {
      "position": 4,
      "text": "Place one portion of dough on a lightly floured surface and roll out to 1/4-inch thickness. For each sandwich cookie, cut out two 3-inch hearts; cut out the center of one of the hearts with a 1 1/2-inch cutter. Place cutout pieces 1 to 2 inches apart on an ungreased cookie sheet. Repeat with remaining dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned, 7 to 8 minutes. Cool completely on wire racks."
    },
    {
      "position": 6,
      "text": "Frost each solid 3-inch cookie with Pink Valentine Frosting and top with an open-centered cookie to form a sandwich. Frost the remaining small hearts and serve as separate cookies."
    }
  ],
  "servings": 17,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 35,

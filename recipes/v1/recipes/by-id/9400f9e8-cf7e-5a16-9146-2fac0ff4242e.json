  "id": "9400f9e8-cf7e-5a16-9146-2fac0ff4242e",
  "slug": "clone-of-a-cinnabon",
  "name": "Clone of a Cinnabon",
  "recipe_type": "breakfast",
  "brief_description": "This Cinnabon recipe makes rolls just like the ones from the chain bakery. A bread machine makes mixing the dough a snap, and the rest is super-easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the dough: Place milk, eggs, margarine, flour, salt, white sugar, and yeast in the pan of a bread machine in the order recommended by the manufacturer. Select dough cycle; press Start."
    },
    {
      "position": 2,
      "text": "When dough has doubled in size, turn it out onto a lightly floured surface. Cover it with a kitchen towel or plastic wrap and let it rest for 10 minutes."
    },
    {
      "position": 3,
      "text": "Roll dough on a lightly floured surface to a 16x21-inch rectangle."
    },
    {
      "position": 4,
      "text": "To make the filling: Combine brown sugar and cinnamon in a small bowl. Spread softened butter over the dough, then sprinkle cinnamon-sugar mixture evenly over top."
    },
    {
      "position": 5,
      "text": "Starting at the longer end, roll up the dough; cut into 12 rolls. Place rolls in a lightly greased 9x13-inch baking pan. Cover and let rise until nearly doubled, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake rolls in the preheated oven until golden brown, about 15 minutes."
    },
    {
      "position": 8,
      "text": "While rolls are baking, prepare icing: Beat confectioners' sugar, butter, cream cheese, vanilla, and salt until creamy."
    },
    {
      "position": 9,
      "text": "Spread icing on warm rolls before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

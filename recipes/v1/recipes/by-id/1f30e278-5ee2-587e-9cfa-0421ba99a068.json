  "schema_version": 1,
  "id": "1f30e278-5ee2-587e-9cfa-0421ba99a068",
  "slug": "red-hot-cinnamon-pickles",
  "name": "Red-Hot Cinnamon Pickles",
  "recipe_type": "side",
  "brief_description": "These cinnamon pickles are a tasty, fiery treat, made with a classic recipe that takes a few days to complete, but the flavor is well worth the wait!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Put cucumber spears in a large container. Stir pickling lime into 1 gallon of water in a large pitcher until lime is dissolved; pour over cucumbers. Refrigerate for 24 hours."
    },
    {
      "position": 2,
      "text": "Drain cucumbers and rinse well; return to large container. Pour enough cold water over the drained cucumbers to cover. Soak at least 3 hours; drain. Transfer cucumbers to a large pot."
    },
    {
      "position": 3,
      "text": "Stir 1 \u00bc cups of vinegar and 1 \u00bc cups of water together in a bowl; add cinnamon red hot candies. Set aside to soak, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Stir 1/2 cup vinegar, red food coloring, and alum together in a bowl until alum is dissolved; pour over cucumbers and add enough water to cover. Put a lid on the pot, place the pot over medium heat, and bring to a boil. Reduce heat to low and simmer for 2 hours; drain and return cucumbers to the pot."
    },
    {
      "position": 5,
      "text": "Pour cinnamon candy mixture into a saucepan; add sugar and cinnamon sticks. Bring the mixture to a boil; cook and stir until the candies and sugar are dissolved completely into a syrupy liquid. Pour liquid over drained cucumbers. Refrigerate 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "Drain liquid from cucumbers into a heavy saucepan; bring to a boil and pour again over the cucumbers. Refrigerate 24 hours."
    },
    {
      "position": 7,
      "text": "Drain liquid again from cucumbers into a heavy saucepan; bring to a boil and pour again over the cucumbers. Refrigerate another 24 hours."
    },
    {
      "position": 8,
      "text": "Heat cucumbers and syrup to a boil."
    },
    {
      "position": 9,
      "text": "Pack cucumbers into hot, sterilized jars, filling to within 1/4 inch of the top. Run a knife or a thin spatula around the insides of the jars after they have been filled to remove any air bubbles. Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with lids and screw on rings."
    },
    {
      "position": 10,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes."
    },
    {
      "position": 11,
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 60,

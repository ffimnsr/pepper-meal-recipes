  "id": "0d4489a4-22df-5f43-90bd-2d124347fd3c",
  "slug": "s-mores-pie-recipe-recipe-11791515",
  "name": "S\u2019Mores Pie",
  "recipe_type": "dessert",
  "brief_description": "This Smores pie has everything you love in a s'more: a graham cracker crust, chocolate pudding and toasted marshmallow top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Follow directions for the Graham Cracker Crust recipe using a deep-dish broiler-safe pie plate. Reserve 2 tablespoons of the crust mixture for garnish."
    },
    {
      "position": 3,
      "text": "Prepare pudding mix according to package directions using the half-and-half, and adding vanilla. Add pudding to cooled crust."
    },
    {
      "position": 4,
      "text": "Cover and chill at least 4 and up to 24 hours."
    },
    {
      "position": 5,
      "text": "Spread marshmallow creme over the chilled pudding."
    },
    {
      "position": 6,
      "text": "Use a culinary torch to toast the marshmallow creme, or place 4 to 6 inches beneath a preheated broiler. Broil until lightly toasted, 30 to 60 seconds."
    },
    {
      "position": 7,
      "text": "Garnish with reserved graham cracker crust mixture and chocolate shavings, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

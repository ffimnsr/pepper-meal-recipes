  "id": "8587d529-38ee-50a4-93bf-13d925708dcc",
  "slug": "easy-sheet-pan-beef-bulgogi",
  "name": "Easy Sheet Pan Beef Bulgogi",
  "recipe_type": "main",
  "brief_description": "Learn how to cook beef bulgogi on a sheet pan in a super hot oven using marinated steak and veggies for a delicious dinner on a busy weeknight!",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Slice steak across the grain as thinly as possible."
    },
    {
      "position": 2,
      "text": "Whisk soy sauce, brown sugar, fish sauce, ginger, sesame oil, chili paste, sesame seeds, and garlic together in a large bowl until combined. Add steak and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 1 hour to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Remove steak from the refrigerator and bring to room temperature."
    },
    {
      "position": 4,
      "text": "Coat a sheet pan with cooking spray. Arrange onion and sugar snap peas on one side of the prepared sheet pan. Drizzle with enough olive oil to coat; season with salt and black pepper. Remove steak from marinade and shake off excess; place on other side of the prepared sheet pan. Discard remaining marinade."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until steak is slightly charred on edges, 10 to 12 minutes. Garnish with green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "feb2ad59-254e-5f81-855c-9659bb6e5b3f",
  "slug": "grilled-jerk-pork-chops-recipe-11998173",
  "name": "Grilled Jerk Pork Chops",
  "recipe_type": "main",
  "brief_description": "A DIY jerk seasoning mix adds major flavor to grilled pork chops. Serve with a mango salsa for even more flavor.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill to medium heat (350 degrees F to 375 degrees F/175 degrees C to 190 degrees F) and lightly oil the grill grates."
    },
    {
      "position": 2,
      "text": "Brush pork chops and onion wedges with oil. Rub pork chops with jerk seasoning and salt."
    },
    {
      "position": 3,
      "text": "Grill chops and onions, covered, turning halfway through, 10 to 12 minutes or until onions are tender and lightly charred and an instant-read thermometer inserted into thickest parts of chops registers 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

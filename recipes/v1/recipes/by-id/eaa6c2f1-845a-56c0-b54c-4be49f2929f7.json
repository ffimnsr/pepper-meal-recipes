{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "eaa6c2f1-845a-56c0-b54c-4be49f2929f7",
  "slug": "cheesecake-from-friends-recipe-11927258",
  "name": "Cheesecake from 'Friends'",
  "recipe_type": "dessert",
  "brief_description": "While the television show \"Friends\" is set in New York City, Mrs. Braverman\u2019s famous cheesecake\u2014stolen by Chandler Bing (Matthew Perry) and Rachel Green (Jennifer Aniston)\u2014is from \u201cMama\u2019s Little Bakery\u201d in Chicago. Chicago-style cheesecakes generally have a softer, creamier, and less dense filling than New York- style cheesecakes. More cream cheese is typically used in Chicago-style, and the crust is often made with shortbread. Here, we matched the \"Friends\" cheesecake, which specifies a \u201cbuttery, crumbly graham cracker crust.\u201d",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add 1 inch of water to an 8- or 9-inch baking pan or oven-safe skillet. Place pan on lower rack of oven; preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together graham cracker crumbs and melted butter in a bowl until evenly combined. Press onto bottom and at least 2 inches up sides of a 9-inch springform pan. (The crust will be thin.)"
    },
    {
      "position": 3,
      "text": "Beat together cream cheese, sugar, and flour in a stand mixer fitted with a paddle attachment at low speed until smooth. Beat in sour cream, milk, and vanilla until just combined, scraping bowl as needed. Using a spatula, stir in eggs until just combined. (Do not overmix.)"
    },
    {
      "position": 4,
      "text": "Pour filling into prepared crust. Bake on center oven rack 15 minutes. Reduce oven temperature to 275 degrees F (135 degrees C). Do not open oven door. Continue baking for 1 hour and 50 minutes more. (The cheesecake will still jiggle slightly in the center but will continue to set up during cooling and chilling.)"
    },
    {
      "position": 5,
      "text": "Turn off the oven and leave oven door slightly ajar until cheesecake is cooled to room temperature, about 1 hour. Remove cheesecake from the oven. Chill, covered, for at least 4 hours (or up to 4 days). Remove sides of pan before slicing and serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 30,

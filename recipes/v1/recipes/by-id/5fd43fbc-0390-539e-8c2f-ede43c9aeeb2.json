  "id": "5fd43fbc-0390-539e-8c2f-ede43c9aeeb2",
  "slug": "simple-spinach-lasagna",
  "name": "Simple Spinach Lasagna",
  "recipe_type": "main",
  "brief_description": "Try this easy spinach lasagna for a filling vegetarian meal. Uncooked noodles are layered with three types of cheese, herbs, and store-bought red sauce.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium heat. Add spinach, onion, garlic, oregano, and basil; saut\u00e9 until onion has softened, 3 to 5 minutes. Pour in spaghetti sauce and water; simmer for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix cottage cheese, mozzarella, parsley, Parmesan, egg, salt, and pepper together in a bowl until well combined."
    },
    {
      "position": 4,
      "text": "Remove sauce from the heat; spoon a small amount into the bottom of a 9x13-inch baking pan. Place four uncooked noodles on top of sauce, then top with 1/3 of the remaining sauce. Layer with four more noodles, 1/2 of the remaining sauce, and 1/2 of the cheese mixture. Repeat layers once more with remaining noodles, sauce, and cheese mixture. Cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 55 minutes. Remove the foil and bake for 15 more minutes. Let sit for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "2d1fe1ba-fc4e-57d4-bec7-328795b62ac5",
  "slug": "bubble-n-squeak",
  "name": "Bubble and Squeak",
  "recipe_type": "side",
  "brief_description": "Bubble and squeak is a delicious way to use leftover potatoes, cabbage, or any veggies for a comforting side dish that makes the most of leftovers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook cabbage in a medium saucepan with a small amount of water until tender, about 3 to 5 minutes. Drain, and set aside."
    },
    {
      "position": 3,
      "text": "Cook bacon and onion in a well-seasoned cast iron skillet until onion is soft and bacon is cooked, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add ham, and cook until heated through. Add butter, then mix in cooked cabbage and potatoes; season with paprika, salt, and pepper. Cook until browned on the bottom, turn, and brown again."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

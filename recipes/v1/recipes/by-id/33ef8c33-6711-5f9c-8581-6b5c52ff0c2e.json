  "id": "33ef8c33-6711-5f9c-8581-6b5c52ff0c2e",
  "slug": "crispy-pork-and-peanut-noodles-recipe-11978989",
  "name": "Crispy Pork and Peanut Noodles",
  "recipe_type": "dessert",
  "brief_description": "These crispy pork and peanut noodles come together in about 10 minutes for a quick and easy weeknight meal. Ground pork, ramen noodles, and a spicy peanut sauce create the perfect balance of sweet, salty, and spicy flavors in every bite.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of water to a boil and add ramen noodles. Cook until just underdone, about 2 \u00bd minutes; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a large skillet over medium-high heat. Heat oil then add pork and cook crumbling until browned and crispy, 3 to 4 minutes. Add in lighter parts of the green onion and garlic and cook for 30 seconds."
    },
    {
      "position": 3,
      "text": "Stir together peanut butter, ground ginger, soy sauce, chili garlic sauce, and brown sugar in a small bowl until well combined. Pour peanut sauce over pork mixture. Stir in noodles until coated. Add water to loosen the sauce as desired and cook for 1 minute. Remove from heat and top with remaining green onions."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "ecb3c0cc-c4d1-592f-a3bf-99b22a18d507",
  "slug": "potato-casserole",
  "name": "Potato Casserole",
  "recipe_type": "side",
  "brief_description": "This potato casserole has layers of creamy, cheesy hash brown potatoes with saut\u00e9ed onions and a golden crisp cornflake top for the perfect side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Pour hash browns into the prepared dish; set aside. Combine cheese, sour cream, and condensed soup in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Melt 1/2 cup butter in a large skillet over medium heat; saut\u00e9 onion in hot butter for 5 minutes. Add to cheese mixture and mix until combined. Spread over hash browns in the dish. Sprinkle with cornflakes."
    },
    {
      "position": 4,
      "text": "Melt remaining 1/2 cup butter in the skillet over medium heat and pour over cornflakes. Bake in the preheated oven for 1 hour."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,

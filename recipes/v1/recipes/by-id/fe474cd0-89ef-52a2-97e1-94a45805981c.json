  "id": "fe474cd0-89ef-52a2-97e1-94a45805981c",
  "slug": "sonya-henie",
  "name": "Sonya Henie",
  "recipe_type": "dessert",
  "brief_description": "A delightful thumbprint cookie. Delicious cream cheese filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a cookie sheet."
    },
    {
      "position": 2,
      "text": "Prepare Cream Cheese Frosting (see footnote for link to recipe)."
    },
    {
      "position": 3,
      "text": "In a medium bowl, cream butter and brown sugar until light and fluffy. Stir in the egg yolk, then stir in the flour until combined."
    },
    {
      "position": 4,
      "text": "Roll dough into 1 inch balls, and dip in egg white. Place 1 inch apart on the cookie sheet. Make an indentation in each cookie with your finger or the end of a wooden spoon."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 8 minutes; remove from oven and fill indentations with Cream Cheese Frosting. Return cookies to the oven for another 3 to 5 minutes, or until golden brown. Let cool for 1 to 2 minutes before removing from pan."
    }
  ],
  "servings": 12,

  "id": "a3fe4cff-9d3a-55b0-90c1-6e8e3f92b3db",
  "slug": "spinach-basil-pesto",
  "name": "Spinach Basil Pesto",
  "recipe_type": "drink",
  "brief_description": "This tasty spinach pesto is easy to make by blending fresh spinach and basil with lemon juice, lemon zest, garlic, olive oil, and Parmesan cheese.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place spinach, basil, pine nuts, Parmesan cheese, 2 tablespoons olive oil, garlic, lemon juice, salt, lemon zest, and pepper into a food processor; blend until nearly smooth, scraping the sides of the bowl with a spatula as necessary."
    },
    {
      "position": 2,
      "text": "Drizzle remaining olive oil into the mixture while processing until smooth."
    },
    {
      "position": 3,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

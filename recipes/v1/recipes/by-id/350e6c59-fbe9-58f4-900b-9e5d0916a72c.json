  "id": "350e6c59-fbe9-58f4-900b-9e5d0916a72c",
  "slug": "sheet-pan-hash-brown-breakfast-pizza-recipe-12035087",
  "name": "Sheet Pan Hash Brown Breakfast Pizza",
  "recipe_type": "breakfast",
  "brief_description": "A few kitchen staples bring this breakfast or breakfast-for-dinner pizza together in no time. Blending a can of tomatoes creates a low-fuss pizza sauce. If you like, season to taste with Italian seasoning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a 10x15-inch rimmed baking sheet with foil and coat with cooking spray."
    },
    {
      "position": 2,
      "text": "To thaw hash browns, place in a large microwave-safe bowl. Microwave on High, stirring once, until thawed, about 6 minutes."
    },
    {
      "position": 3,
      "text": "Stir oil and 1/4 teaspoon each salt and black pepper into hash browns until combined; turn out onto the prepared baking sheet. Press mixture into bottom and 1 inch up sides of baking sheet to make a crust. Bake until edges are browned, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, for sauce, blend tomatoes in a small blender or food processor until smooth."
    },
    {
      "position": 5,
      "text": "Whisk together eggs, garlic powder, and remaining 1/4 teaspoon each salt and black pepper in a medium bowl."
    },
    {
      "position": 6,
      "text": "Spoon sauce onto crust, spreading to edges. Pour egg mixture on top of sauce. Sprinkle with Cheddar cheese, Canadian bacon, and bell pepper and onion blend. Bake until eggs are set, cheese is melted, and vegetables are heated through, 10 to 12 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with chives and/or Parmesan cheese. Slice into 6 pieces."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "rosy-strawberry-rhubarb-applesauce",
  "name": "Rosy Strawberry Rhubarb Applesauce",
  "recipe_type": "dessert",
  "brief_description": "Strawberries add a beautiful rosy hue to this quick and easy applesauce made with sweet Red Delicious apples, tart rhubarb, and vanilla.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apples, strawberries, rhubarb, sugar, and water in a large pot. Bring to a boil; cover and simmer, stirring occasionally, until apples are tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and stir in vanilla."
    }
  ],

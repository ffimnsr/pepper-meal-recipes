{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1b1ee4e5-5475-58ba-a988-360488460c5e",
  "slug": "wolfgang-pucks-cheeseburger-sliders",
  "name": "Wolfgang Puck's Cheeseburger Sliders",
  "recipe_type": "main",
  "brief_description": "This recipe for Wolfgang Puck's cheeseburger sliders is both fast and simple with lean-beef slider burgers, cheese, special sauce, and mini brioche buns.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill or grill pan for medium-high heat (400 to 450 degrees F/200 to 230 degrees C) and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Combine mayonnaise, red onion, ketchup, vinegar, capers, parsley, thyme, and sugar in a small bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Mix beef, 3/4 teaspoon salt, and 1/2 teaspoon black pepper in a large bowl by hand until just combined. Make 12 meatballs using your hands; transfer to a baking sheet. Flatten meatballs slightly. Drizzle with oil; season both sides with remaining each 3/4 teaspoon salt and 1/2 teaspoon black pepper."
    },
    {
      "position": 4,
      "text": "Grill patties on the preheated grill, uncovered, for 3 minutes. Flip; top each patty with 1 quartered piece cheese. Grill, uncovered, until cheese is melted and beef is cooked through, about 2 minutes. Grill buns, cut-sides down, until toasted, about 1 minute."
    },
    {
      "position": 5,
      "text": "Top bun bottoms with a small spoonful sauce; add 1 patty, shredded lettuce, tomato slices, cornichon slices, and top bun to each."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

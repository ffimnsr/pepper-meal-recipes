  "id": "8695a24e-8f6d-56dc-aaac-e86d1f4395cb",
  "slug": "sour-milk-spice-cake",
  "name": "Sour Milk Spice Cake",
  "recipe_type": "dessert",
  "brief_description": "This is a cake my Mother made in the 30's and 40's. Note: To make sour milk combine l cup milk and l tablespoon vinegar. Let sit for l5 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x9 inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine and sift sugar, flour, soda, salt, cinnamon and cloves. Make a well in the center and pour in the milk and oil. Mix until combined, then add nuts."
    },
    {
      "position": 3,
      "text": "Pour into a 9x9 inch pan and bake at 350 degrees F (175 degrees C) for 45 minutes."
    }
  ],
  "servings": 12,

  "id": "3986341c-1974-50aa-84a3-7544c97b8f14",
  "slug": "mini-cherry-pies",
  "name": "Mini Cherry Pies",
  "recipe_type": "dessert",
  "brief_description": "This mini cherry pie recipe requires only five ingredients: pie crust, canned sour cherries, quick-cooking tapioca, white sugar, and almond extract.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Unroll pie crust. Cut two 6-inch rounds from dough; cut remaining dough into \u215b-inch strips for a lattice crust. Fit rounds into two 5-inch pie plates."
    },
    {
      "position": 3,
      "text": "Combine cherries, sugar, tapioca, and almond extract in a bowl; let stand for 5 minutes to soften tapioca. Stir filling; spoon into pie shells."
    },
    {
      "position": 4,
      "text": "Lay 2 strips in an X (using the longest strips) in centers of each pie. Alternate horizontal and vertical strips, weaving them in an over-and-under pattern. Use the shortest strips for the edges of the lattice. Pinch crusts together."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crusts are golden brown and filling is bubbling and thickened, about 30 minutes. Cool before serving, about 30 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

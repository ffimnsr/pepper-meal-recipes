  "id": "2b9824b6-c2b1-50fe-a812-13849b82476c",
  "slug": "pressure-cooker-corned-beef-brisket",
  "name": "Pressure Cooker Corned Beef",
  "recipe_type": "main",
  "brief_description": "This pressure cooker corned beef is perfectly seasoned and produces the most tender, flavorful corned beef in half the time it would take to braise.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place brisket fat-side up on a rack inside an electric pressure cooker. Sprinkle garlic powder and onion powder over brisket; pour beer into the pot."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select \"Meat\" setting according to manufacturer's instructions; set timer for 1 hour 30 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Transfer brisket to a cutting board; remove the top layer of fat and slice across the grain."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 100,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b3141f15-5de7-5f96-a442-644a91c8dbac",
  "slug": "turkey-shepherds-pie-with-butternut-squash",
  "name": "Turkey Shepherd's Pie with Butternut Squash",
  "recipe_type": "dessert",
  "brief_description": "This flavorful ground turkey shepherd's pie recipe is topped with a butternut squash and sweet potato mash \u2014 a hearty yet lighter tweak on the usual.",
  "cuisine": "Scottish Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place squash halves on a baking sheet; brush insides with about 1 tablespoon oil and season with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until squash is very tender, about 30 minutes. Leave oven on."
    },
    {
      "position": 4,
      "text": "Meanwhile, place sweet potatoes in a large pot; cover with water and bring to a boil. Reduce heat to medium-low; simmer until tender, about 20 minutes. Drain."
    },
    {
      "position": 5,
      "text": "Heat remaining 1 tablespoon oil in a skillet over medium-high heat. Add onion and garlic; season with salt and black pepper. Cook until onion is soft and brown, 5 to 7 minutes."
    },
    {
      "position": 6,
      "text": "Set aside \u2153 onion-garlic mixture. Add turkey to the skillet; cook until no longer pink, 5 to 7 minutes. Add gravy, Worcestershire sauce, thyme, and oregano; cook and stir until well combined, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Remove and discard squash seeds; scoop squash flesh into a bowl. Add sweet potatoes, reserved \u2153 onion-garlic mixture, butter, and milk; mash until smooth."
    },
    {
      "position": 8,
      "text": "Spread turkey mixture into bottom of a 9-inch square baking pan; top with corn and peas. Spread squash-potato mixture evenly over top; sprinkle with chili powder."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until top begins to brown, 30 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

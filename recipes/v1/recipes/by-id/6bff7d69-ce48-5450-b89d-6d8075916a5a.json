  "id": "6bff7d69-ce48-5450-b89d-6d8075916a5a",
  "slug": "canadian-tea-biscuits",
  "name": "Canadian Tea Biscuits",
  "recipe_type": "appetizer",
  "brief_description": "A delicious Cheddar cheese and chive savory tea biscuit is perfect for cool Canadian afternoons.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt together in a bowl. Cut in shortening with 2 knives or pastry blender until mixture resembles coarse crumbs. Stir in Cheddar and chives; gradually stir in milk until a soft dough forms."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and knead, with floured hands, until smooth, about 15 times. Roll dough out until 1-inch thick using a floured rolling pin. Cut biscuits with a 2 1/2-inch round cookie cutter; place onto an ungreased baking sheet. Press dough trimmings together, roll out again, and cut remaining dough into biscuits."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

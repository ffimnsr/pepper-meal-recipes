  "id": "613347f3-b384-5054-84a6-5537aeedc13b",
  "slug": "carnation-breakfast-truffles",
  "name": "Carnation Breakfast Truffles",
  "recipe_type": "appetizer",
  "brief_description": "Milk chocolate powder is blended into a mix of peanut butter and Neufchatel cheese to make these breakfast truffles dotted with pecans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate drink mix, peanut butter, and Neufchatel cheese in a mini food processor. Pulse until well combined."
    },
    {
      "position": 2,
      "text": "Roll mixture into eight 1-inch balls. Dip each ball in agave, then in chopped pecans. Serve immediately or refrigerate in an airtight container."
    }
  ],
  "servings": 8,

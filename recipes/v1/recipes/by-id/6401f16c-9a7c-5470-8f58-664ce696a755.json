  "id": "6401f16c-9a7c-5470-8f58-664ce696a755",
  "slug": "baking-mix-blackberry-cobbler",
  "name": "Baking Mix Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This Bisquick blackberry cobbler is super easy to make with fresh or frozen blackberries and baking mix for a comforting, crowd-pleasing dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x9-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk baking mix, milk, 1/3 cup sugar, and oil together in a bowl until no large lumps remain. Pour into the prepared baking dish. Whisk water and 2/3 cup sugar in a clean bowl until mixed. Gently fold in berries until evenly coated; spread berry mixture over baking mix batter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden on top and fruit is bubbling, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

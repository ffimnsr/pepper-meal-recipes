  "slug": "cranberry-sauce-with-bourbon",
  "name": "Cranberry Sauce with Bourbon",
  "recipe_type": "dessert",
  "brief_description": "Mom's cranberry sauce with bourbon is a sweet, tangy, and magical addition to your holiday table. Bourbon really kicks the taste up a notch!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir cranberries, sugar, and bourbon together in a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring occasionally, until thick, about 1 hour."
    }
  ],

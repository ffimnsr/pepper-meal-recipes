{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "01e09efb-6dd4-590e-9dfe-33d4e05eca6e",
  "slug": "gochujang-smashed-potato-salad-recipe-11916843",
  "name": "Gochujang Smashed Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This gochujang smasked potato salad, covered with chicken, bacon, onions, then drizzled with a spicy dressing, is definitely not your typical potato salad but is it ever good. Once you have used gochujang in your recipes, it may quickly become a staple.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Bring a large pot of salted water to a boil. Add potatoes to the water and boil just until fork tender, about 15 minutes. Drain immediately and rinse with cold water. Set aside."
    },
    {
      "position": 2,
      "text": "Line a large baking sheet with parchment paper. Lay potatoes on the prepared sheet, leaving space between each one. Using the bottom of a sturdy glass or coffee cup, gently press down on each potato to smash them. Brush each potato with some olive oil, then season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake potatoes in the preheated oven until brown and crispy, 30 to 40 minutes. Remove from the oven and allow to cool."
    },
    {
      "position": 4,
      "text": "Meanwhile, for dressing, add sour cream, shallot, gochujang, honey, soy sauce, rice vinegar, and ginger to a food processor or blender. Pulse or blend to combine until smooth. Taste and add more sour cream if a thicker dressing is desired."
    },
    {
      "position": 5,
      "text": "To serve, place potatoes on a plate. Sprinkle on chicken, then bacon, and top with green onion. Drizzle dressing over salad and serve extra on the side for dipping."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

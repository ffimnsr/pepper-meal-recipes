  "id": "183a6488-8572-58d3-b10a-8263e5e76fe0",
  "slug": "instant-pot-roasted-whole-chicken",
  "name": "Instant Pot Roasted Whole Chicken",
  "recipe_type": "main",
  "brief_description": "Use your Instant Pot to roast a whole chicken in a hurry for a quick and easy dinner. Make the drippings into a delicious gravy to serve over the tender meat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rub chicken on all sides with salt, pepper, garlic powder, rosemary, and parsley."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot), add olive oil, and select the Saut\u00e9 function. When hot, add chicken, breast-side down. Cook until skin is browned, about 5 minutes. Use tongs to flip chicken and brown on the other side for 5 more minutes. Carefully remove chicken from the pot and set aside. Pour in chicken stock and deglaze the pan, scraping off all the browned bits. Turn off the Saut\u00e9 function."
    },
    {
      "position": 3,
      "text": "Place the rack insert into the pot and place chicken on the rack, breast-side up. Close and lock the lid. Select the Poultry setting and set the timer for 28 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid. Carefully remove chicken to a carving board to rest."
    },
    {
      "position": 5,
      "text": "Turn on the Saut\u00e9 function and whisk cornstarch into the pot with the stock and drippings to make a gravy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

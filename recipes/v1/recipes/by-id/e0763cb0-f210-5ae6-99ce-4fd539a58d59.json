  "id": "e0763cb0-f210-5ae6-99ce-4fd539a58d59",
  "slug": "strawberry-and-feta-salad",
  "name": "Strawberry and Feta Salad",
  "recipe_type": "salad",
  "brief_description": "This strawberry feta salad with romaine, toasted almonds, and a sweet-tangy vinaigrette dressing is a delicious way to enjoy summer strawberries!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place almonds in a skillet over medium-high heat; cook, stirring frequently, until lightly toasted. Remove from heat; set aside."
    },
    {
      "position": 3,
      "text": "To make the dressing: whisk garlic, honey, Dijon mustard, raspberry vinegar, balsamic vinegar, brown sugar, and vegetable oil together until well combined."
    },
    {
      "position": 4,
      "text": "Place toasted almonds, romaine lettuce, strawberries, and feta cheese in a salad bowl; add dressing and toss to coat."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

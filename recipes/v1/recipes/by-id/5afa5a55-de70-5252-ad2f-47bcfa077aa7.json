  "schema_version": 1,
  "id": "5afa5a55-de70-5252-ad2f-47bcfa077aa7",
  "slug": "fat-grannys-minestrone-soup",
  "name": "Fat Granny's Minestrone Soup",
  "recipe_type": "salad",
  "brief_description": "Fresh vegetables, beans, and elbow macaroni are simmered in a seasoned tomato broth creating a flavorful minestrone soup. Serve with garlic cheese bread and a fresh tossed green salad for a complete meal.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine Italian seasoning, onion powder, garlic powder, celery seed, parsley, thyme, basil, oregano, salt, black pepper, and bay leaf in a small bowl."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until cooked through but firm to the bite, 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Heat olive oil and butter together in a large saucepan over medium-high heat; cook and stir carrot, celery, and onion until heated through, 2 to 3 minutes. Add garlic, green bell pepper, red bell pepper, zucchini, and Italian seasoning mixture; stir to combine."
    },
    {
      "position": 4,
      "text": "Stir tomatoes and their juice, tomato sauce, three bean salad, green beans, and chicken stock into seasoned vegetable mixture. Bring to a boil, reduce heat, and simmer, stirring occasionally, until flavors are blended, about 30 minutes. Stir in elbow macaroni before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

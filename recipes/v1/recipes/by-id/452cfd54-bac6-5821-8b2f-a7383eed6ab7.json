  "id": "452cfd54-bac6-5821-8b2f-a7383eed6ab7",
  "slug": "refreshing-watermelon-salad",
  "name": "Watermelon Salad",
  "recipe_type": "salad",
  "brief_description": "This watermelon salad made with sweet and juicy watermelon, pickled red onion, cucumber, and salty feta is a delicious and refreshing crowd-pleasing salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place red onion slices in a small bowl; pour over lime juice. Allow onions to marinate while assembling the salad."
    },
    {
      "position": 3,
      "text": "Gently combine watermelon, cucumber, feta cheese, and cilantro in a large bowl; season with black pepper."
    },
    {
      "position": 4,
      "text": "Toss watermelon salad with marinated onions and season with sea salt just before serving."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 15,

  "id": "163a0b77-1150-54e5-959f-2b81c8c4f04d",
  "slug": "cheesy-meatloaf",
  "name": "Cheesy Meatloaf",
  "recipe_type": "soup",
  "brief_description": "A 'stuffed' meatloaf made with beef, pork, cheese, eggs, soup mix and bread crumbs. Mozzarella cheese jazzes up a classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl combine the beef, pork, soup mix, eggs, bread crumbs, pepper and water. Stir in 1/2 cup of the cheese. Mix well and spread half of mixture into a 9x5 inch loaf pan. Spread remaining 1 1/2 cups cheese over meat loaf mixture. Top with remaining half of meat loaf mixture."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 60 minutes. Let cool 10 to 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

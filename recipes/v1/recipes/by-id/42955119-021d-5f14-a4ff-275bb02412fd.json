  "id": "42955119-021d-5f14-a4ff-275bb02412fd",
  "slug": "easy-drop-cookies",
  "name": "Easy Drop Cookies",
  "recipe_type": "dessert",
  "brief_description": "My mother made these all year round; she simply changed the color of the sugar they were dipped in. Mix a small amount of powdered drink mix (such as Kool-Aid) into white sugar to create different colors and add a hint of flavor (do not omit the sugar, or the flavor will be too strong).",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together butter or margarine and white sugar. Add egg, vanilla and milk. Mix well."
    },
    {
      "position": 3,
      "text": "Gradually add flour, baking soda and salt. Mix well. Roll spoonfuls of dough in your hands and dip one end in colored sugar. Place on baking sheets and press top down with a glass. Bake for 12 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

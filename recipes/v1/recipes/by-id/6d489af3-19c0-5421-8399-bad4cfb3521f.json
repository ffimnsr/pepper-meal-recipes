  "id": "6d489af3-19c0-5421-8399-bad4cfb3521f",
  "slug": "pistachio-torte-recipe-8759774",
  "name": "Pistachio Torte",
  "recipe_type": "dessert",
  "brief_description": "This nostalgic pistachio torte has a nutty shortbread crust layered with cream cheese filling, fluffy pistachio topping, and whipped topping. Sweet, crunchy, and creamy, it is reminiscent of the happy desserts of childhood.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Beat butter with an electric mixer in a bowl until fluffy. Beat in flour, pecans, and 1/4 cup powdered sugar. Spread in an even layer in the prepared dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until light golden brown, about 18 minutes. Cool completely on a wire rack, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Beat cream cheese with an electric mixer in a bowl until fluffy. Beat in remaining 1 cup powdered sugar and vanilla until combined. Fold in half of the whipped topping."
    },
    {
      "position": 6,
      "text": "Spread cream cheese filling evenly over the crust. Chill in the refrigerator for 15 minutes."
    },
    {
      "position": 7,
      "text": "Whisk together milk and pudding mix in a bowl for 2 minutes."
    },
    {
      "position": 8,
      "text": "Pour pistachio pudding evenly over the cream cheese filling. Chill in the refrigerator until set, about 15 minutes."
    },
    {
      "position": 9,
      "text": "Spread remaining whipped topping over the pudding layer. Top with pistachios, or top with pistachios just before serving."
    },
    {
      "position": 10,
      "text": "Cover and chill in the refrigerator 3 hours or up to 4 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

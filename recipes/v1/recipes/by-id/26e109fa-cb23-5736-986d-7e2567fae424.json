  "schema_version": 1,
  "id": "26e109fa-cb23-5736-986d-7e2567fae424",
  "slug": "classic-chicken-salad",
  "name": "Classic Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Perfect for sandwiches, salads, and snacking, this crowd-pleasing recipe for classic chicken salad can be made up to 2 days ahead and stored in the fridge.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Lightly coat a baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Season chicken evenly with 1/2 teaspoon salt, 1/2 teaspoon pepper, and onion powder. Place in the prepared baking dish and cover tightly with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until juices run clear and chicken shreds easily, about 1 hour 20 minutes; don't overcook. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove from the oven, uncover, and let sit until cool enough to handle, about 15 minutes. Reserve any accumulated chicken broth."
    },
    {
      "position": 5,
      "text": "Prepare dressing while chicken cools. Combine 1 cup mayonnaise, sour cream, relish, green onions, parsley, Dijon, lemon juice, dill, and remaining salt and pepper in a large bowl; mix until well combined."
    },
    {
      "position": 6,
      "text": "Break chicken into large pieces and place in the bowl of a food processor. Pulse 3 to 5 times to shred chicken to desired consistency."
    },
    {
      "position": 7,
      "text": "Transfer chicken to a bowl. Add celery and pour dressing over top; toss to coat. If more moisture is desired, add reserved broth or more mayonnaise."
    },
    {
      "position": 8,
      "text": "Cover and chill for at least 2 hours (or up to 2 days) before serving. Stir well before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

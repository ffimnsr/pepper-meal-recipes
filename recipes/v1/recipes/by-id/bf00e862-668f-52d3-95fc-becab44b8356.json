  "id": "bf00e862-668f-52d3-95fc-becab44b8356",
  "slug": "coconut-vanilla-macaroons-gluten-free-nut-free",
  "name": "Coconut Vanilla Macaroons (Gluten-Free, Nut-Free)",
  "recipe_type": "dessert",
  "brief_description": "These coconut vanilla macaroons held together with gluten-free flour instead of eggs are an allergy-friendly sweet finish to a meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine coconut, flour, and sea salt in a large bowl. Add coconut milk, honey, and vanilla extract; stir until thoroughly combined. Drop tablespoonfuls of mixture onto prepared baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden on the bottom and tops are just beginning to brown, about 20 minutes. Cool on the baking sheets for 5 minutes before transferring to a wire rack to cool completely, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Melt chocolate chips in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each melting, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Dip tops or bottoms of macaroons in melted chocolate, letting any excess drip back into the bowl. Place on waxed paper until set, about 10 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 21,

  "id": "5f1c8494-15ea-5408-8827-785a9ac1dbc0",
  "slug": "watermelon-tuna-ceviche-recipe-12035674",
  "name": "Watermelon \u2018Tuna\u2019 Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "Long, slow heat concentrates and dehydrates fruit in this watermelon \u201ctuna\u201d ceviche, giving it a meaty, tuna-like texture. An umami-packed lime-soy marinade adds bright, savory flavor and makes the resemblance even more convincing.",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "For marinade, whisk together soy sauce, vinegar, oil, lime zest and juice, ginger, and honey in a small bowl."
    },
    {
      "position": 2,
      "text": "Remove and discard rind from the watermelon; cut flesh into 1-inch cubes. You should have about 6 cups."
    },
    {
      "position": 3,
      "text": "Place watermelon in a resealable plastic bag set in a shallow dish. Add marinade. Seal bag; turn to coat. Marinate in the refrigerator for at least 4 hours (or up to 12 hours). Drain watermelon, reserving marinade."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a 13x18-inch rimmed baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Spread watermelon on the prepared pan. Bake until watermelon is firm and excess liquid has evaporated, about 1 hour. Slide parchment with watermelon off baking sheet and onto a cooling rack to cool, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Combine cooled watermelon, mango, red onion, and jalape\u00f1o in a large bowl. Add 1/2 cup reserved marinade (see tip, above); toss to combine. Chill, covered, at least 1 hour or up to 24 hours. Stir in avocado just before serving. Serve with tortilla chips and lime wedges."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "pate",
  "name": "Pate",
  "recipe_type": "appetizer",
  "brief_description": "Flavorful braunschweiger liver sausage is the ideal base for this spreadable appetizer ball.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix braunschweiger liver sausage, cream cheese, onion, lemon juice, Worcestershire sauce, salt and pepper. Form into a ball shape. Wrap with plastic wrap. Chill in the refrigerator at least 1 hour before serving."
    }
  ],

  "schema_version": 1,
  "id": "fefe8f9b-e8ef-5daa-803c-532829d59b81",
  "slug": "asian-roll-lettuce-wrap",
  "name": "Asian Roll Lettuce Wrap",
  "recipe_type": "appetizer",
  "brief_description": "A fun dinner that lets the family make them how they want it. Meatballs are grilled then placed into a lettuce leaf with rice and vegetables. Then dip into the zippy Asian-style sauce.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix together ground turkey, 1 tablespoon soy sauce, 1 teaspoon minced garlic and 2 teaspoons ginger. Form into 16 meatballs and roll into ovals. Cover and refrigerate."
    },
    {
      "position": 2,
      "text": "In a medium saucepan over medium heat, combine rice with 2 cups water. Bring to a boil, reduce heat and simmer for 20 minutes, or until rice is tender."
    },
    {
      "position": 3,
      "text": "Preheat the grill or broiler. Arrange rice, lettuce leaves, carrots, scallions, radishes and red peppers onto a serving platter or place each into a small bowl. In a medium bowl, mix together 1/3 cup soy sauce, 1/3 cup water, lemon juice, 2 teaspoons garlic, 1 tablespoon ginger, and sugar. Divide into 4 small dipping bowls."
    },
    {
      "position": 4,
      "text": "Thread two meatballs onto each 10 inch skewer. Grill or broil for 10 to 12 minutes, turning occasionally to brown all sides. If broiling, line the broiler pan with aluminum foil and drain fat after 6 minutes."
    },
    {
      "position": 5,
      "text": "To eat, place a leaf of lettuce onto the palm of your hand, spoon on a little rice, then a meat roll, and a few of the vegetables. Roll up and dip in dipping sauce or spoon sauce over."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

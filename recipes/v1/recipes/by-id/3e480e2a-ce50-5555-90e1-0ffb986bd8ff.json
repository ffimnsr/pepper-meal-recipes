  "id": "3e480e2a-ce50-5555-90e1-0ffb986bd8ff",
  "slug": "salmon-cheese-ball",
  "name": "Salmon Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Walnuts and parsley form the outer layer to this beautiful and addicting salmon and cream cheese ball. Horseradish livens up the mixture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix salmon, cream cheese, lemon juice, green onions, horseradish, salt, hot pepper sauce and Worcestershire sauce. Form the mixture into a ball and wrap in plastic. Chill in the refrigerator 3 hours, or until firm."
    },
    {
      "position": 2,
      "text": "On a large piece of wax paper, mix walnuts and fresh parsley. Roll the ball in the walnuts and parsley until thoroughly coated. Chill in the refrigerator until serving."
    }
  ],

  "name": "Korean Banana Milk",
  "recipe_type": "drink",
  "brief_description": "Korean banana milk tastes delicious - it's made with bananas, milk, water, maple syrup, and vanilla and takes only minutes.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine banana, milk, water, maple syrup and vanilla in the blender cup. Blend until smooth."
    },
    {
      "position": 2,
      "text": "Place ice cubes in glass (if using). Pour banana milk on top."
    }
  ],

  "id": "a84f9ad3-7715-5856-96ff-031677bb9958",
  "slug": "broccoli-pizza-crust",
  "name": "Broccoli Pizza Crust",
  "recipe_type": "main",
  "brief_description": "Try this pizza crust recipe made with fresh broccoli, cheese, and gluten-free bread crumbs for a delicious, celiac-friendly alternative to wheat pizza crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place broccoli florets into a food processor and pulse until broccoli is riced. Transfer to a clean paper towel and squeeze out as much water as possible."
    },
    {
      "position": 3,
      "text": "Place broccoli \"rice\", mozzarella cheese, Parmesan cheese, beaten egg, bread crumbs, garlic, basil, Italian seasoning, salt, black pepper, and red pepper flakes into a large bowl and mix until well combined. Separate into 4 equal golf ball-sized balls. Shape carefully into 4 individual-sized crusts. Place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the bottom is lightly browned, about 30 minutes. Flip crusts and continue to bake until the other side is golden brown, 10 to 12 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "58288b03-85ee-5de7-b8e7-e3044e2ae00d",
  "slug": "roasted-cabbage-with-lemon-herb-dressing-recipe-11935128",
  "name": "Roasted Cabbage with Lemon Herb Dressing",
  "recipe_type": "dessert",
  "brief_description": "This roasted cabbage with lemon herb dressing is a hearty addition to any meal. The cabbage becomes mild and sweet, tangy lemon brightens the dressing, and honey adds a touch of sweetness. Use your favorite combo of fresh herbs, such as parsley, rosemary, thyme, oregano, dill, whatever suits your taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Chop herbs in a mini food processor. Add lemon juice, Dijon, honey, and salt, and process until well combined. Gradually stream in 1/3 cup olive oil until smooth and emulsified; set aside."
    },
    {
      "position": 3,
      "text": "Remove loose outer leaves from the cabbage. Slice off the bottom of the core to create a flat base. Stand the cabbage upright on a cutting board, and slice vertically into 3/4-inch thick slices, keeping the core. This ensures the cabbage slices stay intact and makes it easier to serve."
    },
    {
      "position": 4,
      "text": "Whisk 2 tablespoons olive oil, garlic powder, salt, and pepper in a small bowl. Brush both sides of the cabbage with the oil. Place on the prepared baking sheet in a single layer. Roast until tender and the edges are starting to brown, 35 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Remove cabbage slices from the oven, place on a serving platter, drizzle with lemon herb dressing, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

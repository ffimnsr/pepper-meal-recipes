  "id": "c838969d-df11-5430-8391-ad023dde3c73",
  "slug": "lentil-and-sausage-soup",
  "name": "Lentil and Sausage Soup",
  "recipe_type": "soup",
  "brief_description": "You'll love this hearty sausage and lentil soup in a rich tomato-based broth with lots of herbs for extra flavor. Serve with grated Romano cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook sausage in a large pot over medium-high heat until evenly brown, 7 to 10 minutes. Add onion, celery, and garlic; saut\u00e9 until tender and translucent, about 5 minutes. Stir in water, chicken broth, tomatoes, lentils, carrot, garlic powder, parsley, salt, pepper, oregano, thyme, basil, and bay leaves; bring to a boil. Reduce the heat, cover, and simmer until lentils are tender, 2 1/2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Stir in pasta and cook until tender, 15 to 20 minutes. Remove bay leaves before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 20,

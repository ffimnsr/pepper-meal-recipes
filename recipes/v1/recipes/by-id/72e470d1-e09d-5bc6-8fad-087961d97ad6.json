  "id": "72e470d1-e09d-5bc6-8fad-087961d97ad6",
  "slug": "mediterranean-quinoa-salad",
  "name": "Mediterranean Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "A Mediterranean quinoa salad packed with tender quinoa, feta, red onion, and olives, flavored with lemon and herbs for a light meal full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water, bouillon cubes, and garlic to a boil in a saucepan. Stir in quinoa; reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Discard garlic clove and transfer quinoa into a large bowl."
    },
    {
      "position": 4,
      "text": "Add chicken, onion, bell pepper, olives, feta cheese, parsley, chives, and salt to quinoa; drizzle lemon juice, balsamic vinegar, and olive oil on top. Stir until evenly mixed."
    },
    {
      "position": 5,
      "text": "Serve warm or refrigerate and serve cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

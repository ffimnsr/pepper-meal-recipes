  "id": "018aa8d6-f873-5479-a486-0b6777fea69e",
  "slug": "strawberry-delight-pie",
  "name": "Strawberry Delight Pie",
  "recipe_type": "dessert",
  "brief_description": "This recipe for strawberry delight pie combines glazed strawberries with a fluffy cream cheese filling in a graham cracker crust. No baking required.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese, confectioners' sugar, and lemon juice together in a bowl with an electric mixer on low speed. Add whipped topping; beat until combined. Spoon into graham cracker crust."
    },
    {
      "position": 2,
      "text": "Combine strawberries and glaze in a bowl until berries are coated. Arrange strawberries over cream cheese filling."
    },
    {
      "position": 3,
      "text": "Refrigerate pie until chilled, at least 1 hour."
    }
  ],
  "servings": 8,

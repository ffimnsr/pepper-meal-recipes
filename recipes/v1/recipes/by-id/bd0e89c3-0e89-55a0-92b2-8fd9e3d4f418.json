{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bd0e89c3-0e89-55a0-92b2-8fd9e3d4f418",
  "slug": "sheet-pan-glazed-pork-tenderloin-with-vegetables-recipe-11815727",
  "name": "Sheet Pan Glazed Pork Tenderloin with Vegetables",
  "recipe_type": "main",
  "brief_description": "This sheet pan glazed pork tenderloin with vegetables is glazed with a 3-ingredient chutney sauce and roasted with summer vegetables and mushrooms. The glaze takes it over the top, and you can't beat a sheet pan dinner for ease of cleanup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) and line a sheet pan with parchment paper or aluminum foil. Combine salt, black pepper, granulated garlic, and smoked paprika in a small bowl."
    },
    {
      "position": 2,
      "text": "Pat tenderloin dry with paper towels, and sprinkle dry seasoning mix over the entire surface. Drizzle with 1 tablespoon olive oil, brush over the entire tenderloin, and let stand about 10 minutes."
    },
    {
      "position": 3,
      "text": "Combine Major Grey Chutney, mustard, Worcestershire sauce, and cayenne in a small bowl; set aside."
    },
    {
      "position": 4,
      "text": "Spread out zucchini, yellow squash, bell pepper, onion, and mushrooms on the prepared sheet pan. Drizzle with 2 tablespoons olive oil, and season with salt and pepper. Stir vegetables in the pan until olive oil and seasonings are evenly distributed. Move vegetables toward the edges, and set tenderloin in the center."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven on the center rack for 10 minutes. Remove pan from the oven and brush tenderloin with about 1/3 of the chutney mixture. Return to the oven and bake 10 minutes more."
    },
    {
      "position": 6,
      "text": "Turn tenderloin over and brush the underside with 1/3 chutney mixture. Return to the oven and bake until an instant-read thermometer inserted near the center of the meat reads 145 degrees F (63 degrees C) and vegetables are fork tender, 5 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven to a serving platter, tent with foil, and allow to rest about 5 minutes. Stir vegetables into the drippings in the pan."
    },
    {
      "position": 8,
      "text": "Brush tenderloin with remaining 1/3 chutney mixture and slice into thin slices. Serve pork slices and vegetables warm, and garnish with fresh parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

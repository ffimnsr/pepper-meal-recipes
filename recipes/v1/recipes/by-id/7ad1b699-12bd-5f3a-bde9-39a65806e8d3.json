  "id": "7ad1b699-12bd-5f3a-bde9-39a65806e8d3",
  "slug": "island-style-fried-rice",
  "name": "Island-Style Fried Rice",
  "recipe_type": "main",
  "brief_description": "This Hawaiian fried rice with egg features beloved island delicacies such as pineapple, Chinese lup cheong pork sausage, and Spam for a popular meal.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes. Let rice cool completely."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons oil in a large nonstick skillet over medium heat. Cook and stir luncheon meat and sausage in hot oil until browned. Remove meat mixture to a plate. Pour beaten eggs into the same skillet; cook and stir until eggs are scrambled. Transfer eggs to the plate with meat mixture."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in the same skillet over medium heat. Cook and stir cooled rice in hot oil until heated through and beginning to brown, about 2 minutes. Add garlic powder; toss rice to develop garlic taste, about 1 minute. Stir in cooked meats, scrambled eggs, pineapple, and oyster sauce. Cook and stir until well combined and heated through, 2 to 3 minutes. Stir in green onion to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

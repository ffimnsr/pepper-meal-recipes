  "id": "ab2583b1-b695-5c23-a4cc-ef68d3ea5a9f",
  "slug": "butterscotch-cookie-bars",
  "name": "Butterscotch Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "These cookie bars are simply heavenly. Easy to make and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place butterscotch chips and butter into a glass bowl. Heat in the microwave for about 3 minutes, stirring at 30 second intervals until smooth. Set aside to cool until firm."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch pan."
    },
    {
      "position": 3,
      "text": "In a large bowl, beat the butterscotch chip mixture with eggs and vanilla until well blended. Combine the flour, baking powder, and salt; stir into the batter until evenly mixed. Mix in the brown sugar, chocolate chips, walnuts, and raisins. Spread the batter evenly in the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake for 25 minutes in the preheated oven, just until the bars begin to pull away from the sides of the pan. Cut into squares while warm."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

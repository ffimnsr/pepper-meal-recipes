{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3c58be3c-86c4-5d90-aeaa-54b98395ef69",
  "slug": "chicken-fried-steak-with-cream-pork-sausage-gravy",
  "name": "Chicken Fried Steak with Cream Pork Sausage Gravy",
  "recipe_type": "main",
  "brief_description": "For a special treat, nothing beats a tender chicken-fried beef tenderloin steak, smothered in rich cream sausage gravy.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a bowl, stir together 1 cup flour, 1 teaspoon salt, white pepper, and garlic powder. In a separate bowl, beat eggs with garlic and parsley. Dredge each tenderloin fillet in seasoned flour, dip in egg mixture, and dip back into flour mixture. Shake off any excess flour."
    },
    {
      "position": 3,
      "text": "Gently place the steaks into the hot oil, 2 at a time, and cook until golden brown on both sides, about 3 minutes per side. Drain on paper towels."
    },
    {
      "position": 4,
      "text": "Place the sausages in a small skillet over medium heat, and fry them until very dark brown on all sides, about 10 minutes. Finely chop the sausages, and set aside. In the same skillet, melt butter, and stir in 3 tablespoons of flour. Cook the butter-flour mixture until it turns a pale beige color, about 1 minute, then stir in the sausage, cream, salt, and black pepper. Bring the mixture to a simmer, and cook until thickened, about 5 minutes. Serve sauce over the fried steaks."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

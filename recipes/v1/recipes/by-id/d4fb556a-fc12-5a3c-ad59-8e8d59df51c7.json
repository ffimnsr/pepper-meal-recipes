  "id": "d4fb556a-fc12-5a3c-ad59-8e8d59df51c7",
  "slug": "garlic-butter-meatball-sub-recipe-11795623",
  "name": "Garlic Butter Meatball Sub",
  "recipe_type": "main",
  "brief_description": "These garlic butter meatball subs with toasted buns, toasted mozzarella cheese, and precooked meatballs in marinara sauce, are a quick way to a casual dinner for 6.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Warm meatballs according to package directions. Set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a small saucepan over medium heat. Add garlic and continue cooking until garlic is fragrant, about 30 seconds. Stir in parsley, season with salt and pepper, and remove from heat."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Brush insides of the rolls with garlic butter and toast, buttered side down, in the skillet until golden brown. Set aside."
    },
    {
      "position": 4,
      "text": "Working with 1 or 2 rolls at a time, sprinkle 1/2 cup mozzarella per roll into the skillet. Place roll face down onto the cheese and cook until cheese is melted. Set aside."
    },
    {
      "position": 5,
      "text": "Place 3 meatballs into each roll. Garnish with fresh Parmesan and a light drizzle of garlic butter if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

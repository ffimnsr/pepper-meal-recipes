  "id": "9c0aa5f8-2fe3-5fd8-a10f-985e99f1b1d5",
  "slug": "tangy-cranberry-sauce",
  "name": "Tangy Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "This zesty sauce is a favorite of all our family and friends. It's simple to make, and good with the turkey or on leftover turkey or chicken sandwiches. Adjust the amount of horseradish to taste.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place cranberries and water in a medium saucepan. Over high heat, cook until the cranberries burst."
    },
    {
      "position": 2,
      "text": "Lower heat to simmer. Stir in sugar. Continue cooking 15 minutes."
    },
    {
      "position": 3,
      "text": "Allow mixture to cool. Stir in horseradish. Chill in the refrigerator until serving."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,

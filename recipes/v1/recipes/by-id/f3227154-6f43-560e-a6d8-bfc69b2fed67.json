  "id": "f3227154-6f43-560e-a6d8-bfc69b2fed67",
  "slug": "green-velvet-soup",
  "name": "Green Velvet Soup",
  "recipe_type": "soup",
  "brief_description": "This green velvet soup recipe blends spinach, broccoli, celery, peas, and zucchini into a silky smooth, rich, vibrant, nourishing bowl of goodness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine broth, potatoes, celery, onion, peas, and bay leaves in a large pot over medium heat; bring to a boil. Reduce heat to low, cover, and simmer for 1 hour."
    },
    {
      "position": 2,
      "text": "Remove and discard bay leaves. Stir in broccoli, zucchini, basil, and black pepper; simmer until broccoli is tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Stir in spinach. Remove pot from heat. Pur\u00e9e in batches in a blender, the bowl of a food processor, or using an immersion blender until smooth. Season with salt."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

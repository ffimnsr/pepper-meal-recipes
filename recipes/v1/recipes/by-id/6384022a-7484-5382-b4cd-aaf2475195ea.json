  "slug": "honey-oatmeal-cookies",
  "name": "Honey Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "The oatmeal cookies in this recipe are sweetened with honey for an added touch of flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat together shortening, honey, egg, water, and vanilla until creamy. Add combined remaining ingredients; mix well."
    },
    {
      "position": 3,
      "text": "Drop by rounded teaspoonfuls onto greased cookie sheet. Bake at 350 degrees F (175 degrees C) for 12 to 15 minutes."
    }
  ],
  "servings": 30,

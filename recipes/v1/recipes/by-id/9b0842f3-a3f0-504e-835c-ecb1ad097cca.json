  "id": "9b0842f3-a3f0-504e-835c-ecb1ad097cca",
  "slug": "easy-salsa-meatloaf",
  "name": "Easy Salsa Meatloaf",
  "recipe_type": "main",
  "brief_description": "A crowd pleasing meatloaf, may be made with ground beef or ground turkey. Both are yummy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix the ground sirloin, salsa, bread crumbs, cheese, egg, and garlic. Season with parsley, salt, and pepper. Transfer to a 5x9 inch loaf pan."
    },
    {
      "position": 3,
      "text": "Bake 45 minutes in the preheated oven, or to a minimum internal temperature of 160 degrees F (72 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

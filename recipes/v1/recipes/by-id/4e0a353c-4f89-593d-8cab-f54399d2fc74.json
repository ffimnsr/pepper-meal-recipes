  "id": "4e0a353c-4f89-593d-8cab-f54399d2fc74",
  "slug": "creamy-celeriac-recipe-11889724",
  "name": "Creamy Celeriac",
  "recipe_type": "side",
  "brief_description": "My German family loves celeriac, especially if it's creamy and cheesy. Feel free to adjust butter, cream, and Parmesan cheese quantities to your liking.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Peel celeriac root and cut in half. Cut each half into 1/4-inch thick slices, and julienne."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat, add celeriac sticks, and cook, stirring occasionally, until softened, about 10 minutes. Add cream and Parmesan cheese and cook until cheese has melted. Season with salt."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,

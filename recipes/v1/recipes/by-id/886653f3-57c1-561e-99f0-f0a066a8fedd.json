  "name": "Blackberry Mojito",
  "recipe_type": "appetizer",
  "brief_description": "This blackberry mojito adds fresh blackberries to rum, lime, and mint for a refreshing twist.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Place sugar, lime juice, blackberries and mint leaves in an old fashioned glass, and mash well with a cocktail muddler. Add soda water and rum; stir. Fill with ice."
    }

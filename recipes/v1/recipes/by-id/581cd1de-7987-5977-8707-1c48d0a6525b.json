  "id": "581cd1de-7987-5977-8707-1c48d0a6525b",
  "slug": "giant-pizza-roll-recipe-12064405",
  "name": "Giant Pizza Roll",
  "recipe_type": "main",
  "brief_description": "This Giant Pizza Roll wraps classic pizza flavors into one crispy, cheesy, easy-to-share meal. Stuffed with pepperoni, mozzarella, Parmesan, and pizza sauce, it\u2019s air baked until golden and ready in about 20 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter, parsley, and garlic powder in a microwave-safe dish and cook in the microwave until melted, about 20 seconds. Set aside."
    },
    {
      "position": 2,
      "text": "Lightly flour a work surface. Roll out pizza dough into an even rectangle using a rolling pin."
    },
    {
      "position": 3,
      "text": "Spread pizza sauce evenly over 1/2 of of the rectangle. Top sauce with shredded mozzarella cheese, pepperoni slices, and 1/2 of the Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Fold the undressed side of the pizza dough over to cover the dressed side. Pinch edges to seal and seal with a fork."
    },
    {
      "position": 5,
      "text": "Brush with herb-garlic butter and sprinkle with remaining Parmesan cheese. Using a knife, pierce 5 small slits in the top of the pizza roll."
    },
    {
      "position": 6,
      "text": "Spray a crisper plate with non-stick cooking spray and set pizza roll inside."
    },
    {
      "position": 7,
      "text": "Place into Ninja Crispi Microwave and Air Fryer. Select the air bake setting and cook for 7 minutes. Flip pizza roll and continue air baking until pizza roll is done, about 7 more minutes."
    },
    {
      "position": 8,
      "text": "Allow pizza roll to cool for up to 5 minutes. Cut into 4 squares and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c011fa0b-64e7-50cd-8627-5a11553adfb9",
  "slug": "pumpkin-spinach-toddler-muffins",
  "name": "Pumpkin Spinach Toddler Muffins",
  "recipe_type": "snack",
  "brief_description": "This easy pumpkin spinach toddler muffin recipe, made with canned pumpkin, spinach, oats, and spices, is the perfect finger food or snack for everyone.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners."
    },
    {
      "position": 2,
      "text": "Combine pumpkin pur\u00e9e, eggs, oil, and maple syrup in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk flour, oats, baking powder, baking soda, ground cinnamon, and ground nutmeg together in a bowl until evenly blended; stir into pumpkin mixture. Stir in spinach until evenly dispersed throughout batter."
    },
    {
      "position": 4,
      "text": "Divide batter among the prepared muffin cups, filling each \u2154 full."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes. Cool in the tins for 10 minutes, then transfer muffins to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

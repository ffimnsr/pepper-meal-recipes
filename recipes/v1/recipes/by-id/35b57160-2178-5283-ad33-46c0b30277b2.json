  "id": "35b57160-2178-5283-ad33-46c0b30277b2",
  "slug": "vegetarian-sliders",
  "name": "Vegetarian Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These baked vegetarian sliders filled with gooey cheese, tomatoes, basil, and brushed with garlic butter make a quick and easy appetizer or main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Cut the rolls in half. Set the bottom halves into the bottom of the prepared pan and spread a layer of marinara sauce on each. Place a layer of mozzarella cheese over the marinara and add a layer of tomatoes over the cheese. Spread basil over the tomatoes and add the top halves of the rolls."
    },
    {
      "position": 3,
      "text": "Combine melted butter, Parmesan cheese, garlic, and Italian seasoning in a bowl; stir to combine. Brush over the tops of the sliders."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the insides are gooey and the tops are golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

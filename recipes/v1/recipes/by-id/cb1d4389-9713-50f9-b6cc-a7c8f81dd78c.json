  "slug": "raspberry-balsamic-vinaigrette-dressing",
  "name": "Raspberry Balsamic Vinaigrette Dressing",
  "recipe_type": "salad",
  "brief_description": "This restaurant-worthy raspberry balsamic vinaigrette is simple to make with oil, honey mustard, garlic, and two types of balsamic vinegar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oil, raspberry balsamic vinegar, balsamic vinegar, brown sugar, garlic, and mustard in a sealable jar. Seal the jar and shake vigorously until dressing is well-combined. Refrigerate until flavors combine, at least 1 hour."
    }
  ],

  "id": "6c958d98-474f-5f55-9c29-080cd1d30d2c",
  "slug": "caramelized-butternut-squash-soup",
  "name": "Caramelized Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "Caramelized butternut squash soup recipe includes sweet honey, and a touch of nutmeg for extra flavor in this delicious pur\u00e9ed soup made with heavy cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over high heat. Add squash; cook and stir until completely browned, about 10 minutes. Add onion, butter, 1 tablespoon sea salt, and 1 teaspoon white pepper; cook and stir until onion is completely tender and beginning to brown, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add chicken broth and honey; bring to a boil. Reduce heat to medium-low; simmer until squash is tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Fill blender halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour into a pot. Repeat with remaining soup."
    },
    {
      "position": 4,
      "text": "Stir cream and nutmeg into pur\u00e9ed soup until well blended; season with sea salt and white pepper."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

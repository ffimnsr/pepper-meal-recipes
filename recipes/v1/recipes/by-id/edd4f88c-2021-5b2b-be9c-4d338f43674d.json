  "id": "edd4f88c-2021-5b2b-be9c-4d338f43674d",
  "slug": "copycat-mcchicken-sandwich-recipe-8702751",
  "name": "Copycat McChicken Sandwich",
  "recipe_type": "main",
  "brief_description": "This copycat McChicken sandwich is made with well seasoned chicken breast and chicken thighs. Freezing the patties before frying helps them keep their shape.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, garlic powder, white pepper, 1/2 teaspoon paprika, and 1 teaspoon salt in a food processor. Pulse until finely chopped and it forms a uniform mixture."
    },
    {
      "position": 2,
      "text": "Shape chicken mixture into 6 patties and freeze on a parchment or wax paper-lined baking sheet for 20 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Heat oil to 375 degrees F (190 degrees C). Whisk together flour, cornstarch, remaining salt, remaining paprika, and pepper in a bowl. Lightly coat partially frozen patties in flour mixture and shake off any excess mixture and set patties aside."
    },
    {
      "position": 4,
      "text": "Add club soda to remaining flour mixture in bowl and whisk to combine."
    },
    {
      "position": 5,
      "text": "Working 2 to 3 at a time, dip patties into batter, allow excess to drip off and carefully place into the hot oil. Fry, while maintaining a temperature of 330 to 350 degrees F (165 to 175 degrees C), until golden brown, crispy, and cooked through, 5 to 6 minutes per batch. Drain on a wire rack set inside a paper towel lined rimmed baking sheet. Repeat with remaining patties."
    },
    {
      "position": 6,
      "text": "Serve patties on buns with shredded lettuce and mayonnaise."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

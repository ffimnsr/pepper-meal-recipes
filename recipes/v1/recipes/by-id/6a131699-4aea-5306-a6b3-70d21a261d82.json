  "id": "6a131699-4aea-5306-a6b3-70d21a261d82",
  "slug": "kid-pleasing-sloppy-joes",
  "name": "Kid-Pleasing Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "These kid-friendly Sloppy Joes are an American treasure. The sauce in this version has ketchup as a base, with cider vinegar, brown sugar, mustard, and Worcestershire sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef and onion in the hot skillet until beef is completely browned, 5 to 7 minutes. Drain and discard grease. Return skillet to the heat."
    },
    {
      "position": 2,
      "text": "Stir ketchup, vinegar, brown sugar, Worcestershire sauce, and mustard into the beef mixture; simmer, stirring occasionally, until the liquid is thick, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "e2654967-61d4-5092-b33d-ef1eade2a96e",
  "slug": "butternut-squash-chili-recipe-8725719",
  "name": "Butternut Squash Chili",
  "recipe_type": "soup",
  "brief_description": "If you love chili, add this butternut squash chili to your repertoire. It feels like fall, and has great flavor without being too spicy. It's also a great way to add squash to your menu.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a 4- to 5-quart Dutch oven over medium-high heat. Add onion and tomato paste; cook, stirring until tomato paste begins to darken and onion is tender, 4 to 5 minutes. Add garlic, stirring until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Pour broth into Dutch oven. Add bell pepper, squash, diced tomatoes, and roasted tomatoes. Stir in brown sugar, chili powder, cumin, and crushed red pepper, if using. Cover, reduce heat to medium-low, and simmer until squash is tender, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Add beans and ground meat (if using) to pot. Cover and simmer until flavors have developed, about 15 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Top with cheese, sour cream, cilantro, jalapenos, and avocado, as desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

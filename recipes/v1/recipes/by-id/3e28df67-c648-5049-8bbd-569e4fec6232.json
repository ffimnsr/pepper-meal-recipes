  "id": "3e28df67-c648-5049-8bbd-569e4fec6232",
  "slug": "easy-pot-roast-recipe-8706184",
  "name": "Easy Pot Roast",
  "recipe_type": "main",
  "brief_description": "This easy pot roast recipe is a keeper. Seared in a Dutch oven, then baked in the oven with vegetables, it takes a few hours, but is so worth the wait.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Season roast on both sides with 1 tablespoon salt, 2 teaspoons pepper, and garlic powder."
    },
    {
      "position": 2,
      "text": "Heat oil in a large Dutch oven over high heat. When oil begins to shimmer, place roast in pot and let cook, undisturbed, until browned, about 4 minutes. Flip and repeat on the other side until browned. Brown on all sides, remove roast from pot, and set aside."
    },
    {
      "position": 3,
      "text": "Add onion, celery, and carrots to drippings in the pan. Season with remaining salt and pepper and cook, stirring often, until onion begins to soften. Add butter to pot and allow it to melt. Add flour and cook, stirring constantly, about 1 minute. Add remaining ingredients and stir, using a spoon to scrape browned bits from bottom of pot."
    },
    {
      "position": 4,
      "text": "Return roast to pan, along with any accumulated juices. Bring to a simmer, cover, and remove from heat."
    },
    {
      "position": 5,
      "text": "Bake pot roast in the preheated oven and cook until roast is tender, about 2 1/2 hours. Allow to rest 10 minutes before shredding and serving with vegetables and gravy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 10,

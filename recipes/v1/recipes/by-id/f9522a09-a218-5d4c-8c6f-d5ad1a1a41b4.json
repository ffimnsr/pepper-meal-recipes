  "id": "f9522a09-a218-5d4c-8c6f-d5ad1a1a41b4",
  "slug": "gingerbread-cookies-ii",
  "name": "Kim's Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "This gingerbread cookie recipe looks complicated, but it is actually pretty easy. I have used this recipe for many years and always get compliments on it.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sift together flour, baking powder, ginger, nutmeg, cloves, and cinnamon in a large bowl."
    },
    {
      "position": 2,
      "text": "In the bowl of a stand mixer, beat shortening, molasses, brown sugar, water, egg, and vanilla until smooth and creamy, 3 to 4 minutes. Gradually mix in the dry ingredients until fully incorporated. Divide dough into thirds; form each piece into a 1 1/2-inch-thich disk, wrap in plastic wrap, and refrigerate for at least 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Working with one disk at a time, roll the dough on a lightly floured surface to a thickness of 1/4 inch. Cut into desired shapes with cookie cutters. Place cookies 1 inch apart on ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake for 10 to 12 minutes in the preheated oven, switching racks halfway through. When the cookies are done, they will look dry, but still be soft to the touch. Remove from the baking sheet to cool on wire racks."
    },
    {
      "position": 5,
      "text": "Frost cooled cookies as desired."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

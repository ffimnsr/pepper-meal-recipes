  "id": "6eba6c57-0922-51ad-96f6-bf0d8dd3d7da",
  "slug": "deviled-egg-potato-salad-recipe-8600479",
  "name": "Creamy Deviled Egg Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This deviled egg potato salad combines two classics\u2014deviled eggs and potato salad\u2014into one tasty side dish that is creamy and tangy, budget-friendly, and can be easily doubled to feed a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large saucepan and cover with about 1 inch of salted, cold water. Bring to a boil over medium heat, and cook until tender, but still firm, 15 to 17 minutes. Drain well, and set aside until cool enough to handle."
    },
    {
      "position": 2,
      "text": "Meanwhile, make the dressing: peel eggs and cut in half; set whites aside. Place egg yolks in a small bowl and mash with a fork. Add mayonnaise, yogurt, mustard, vinegar, Old Bay\u00ae seasoning, and garlic powder; season with salt and pepper. Stir until dressing is well combined and smooth."
    },
    {
      "position": 3,
      "text": "Peel potatoes and cut into 1-inch cubes, coarsely chop egg whites, and place in a large bowl. Add red onions and dressing, and stir until well coated."
    },
    {
      "position": 4,
      "text": "Taste and adjust the seasoning, if necessary, and garnish with chopped parsley and a sprinkle of paprika. Store in the fridge to chill. Here\u2019s everything you need to know to make Perfect Hard Boiled Eggs ."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

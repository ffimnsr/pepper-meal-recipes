  "id": "2a0d7caf-f752-53a4-b3a1-51e43a2eed09",
  "slug": "fabulous-fried-cabbage",
  "name": "Fabulous Fried Cabbage",
  "recipe_type": "soup",
  "brief_description": "This cabbage dish has no bacon and is super easy to make by simmering cabbage in a buttery broth until tender and sweet.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring broth and butter to a boil in a large skillet. Reduce heat to low and add cabbage."
    },
    {
      "position": 2,
      "text": "Cover and cook over low heat, stirring frequently, until cabbage is tender and sweet, about 45 minutes. Season with salt and pepper and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

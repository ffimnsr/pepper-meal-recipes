{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1ee33375-7650-5fc7-9b82-f5d58c0b57eb",
  "slug": "theras-canadian-fried-dough",
  "name": "Thera's Canadian Fried Dough",
  "recipe_type": "dessert",
  "brief_description": "This beaver tails dessert is a popular Canadian treat of deep-fried yeasted dough made with milk, whole wheat flour, and egg coated in cinnamon sugar.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together warm water, yeast, and 1 pinch white sugar in a large bowl; let sit until creamy, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, grease a separate large bowl and set it aside."
    },
    {
      "position": 3,
      "text": "Stir warm milk, eggs, 1/3 cup vegetable oil, 1/3 cup white sugar, salt, and vanilla into yeast mixture until sugar is dissolved. Stir in 2 1/2 cups flour until no dry spots remain. Turn dough out onto a floured surface and knead in remaining flour, 1/2 cup at a time, until dough is no longer sticky. Knead until smooth and elastic, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Form dough into a ball and place it into the prepared bowl. Cover with a towel and let rise in a warm place until doubled in volume, about 1 hour."
    },
    {
      "position": 5,
      "text": "Punch down dough and knead a few times to reshape it. Pinch off a piece of dough about the size of an egg, then roll into an oval shape, about 1/4-inch thick. Place on a dish towel, cover with another dish towel, and repeat with remaining dough."
    },
    {
      "position": 6,
      "text": "Heat 4 inches oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Make cinnamon sugar: Combine white sugar and cinnamon in a shallow dish or pie plate; set aside."
    },
    {
      "position": 8,
      "text": "Lower dough carefully into hot oil in batches and fry until golden brown, 1 to 2 minutes per side. Drain on a paper towel-lined plate. Gently press fried dough into cinnamon sugar while still warm; shake off excess sugar."
    }
  ],
  "servings": 20,

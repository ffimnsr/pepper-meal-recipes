  "id": "dc0bfc63-4e84-5f3f-9db6-d322e6f8a453",
  "slug": "old-bay-fries",
  "name": "Old Bay Fries",
  "recipe_type": "side",
  "brief_description": "Taste that beloved seafood flavor with these quick and easy baked fries tossed with Old Bay and served with a cheesy dipping sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Toss French fries and oil together in a large bowl. Add 2 tablespoons seafood seasoning and toss to coat. Place on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crispy, 35 to 45 minutes."
    },
    {
      "position": 4,
      "text": "While fries are baking, make the cheese sauce by combining milk and seafood seasoning in a heavy-bottomed saucepan over low heat. Add cheese when milk begins to steam and little bubbles begin to form around the edges. Stir gently and frequently until all cheese is melted. Serve immediately on the side as a dipping sauce with hot fries."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

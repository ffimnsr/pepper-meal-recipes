  "id": "144110b8-210d-5fb9-aec1-d35fd2ee5a32",
  "slug": "baked-mac-and-cheese-bites-recipe-11857565",
  "name": "Baked Mac and Cheese Bites",
  "recipe_type": "appetizer",
  "brief_description": "These baked mac and cheese bites, crispy around the edges and soft and melty in the center, make a great finger food from an old favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Spray 2 mini muffin pans with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain."
    },
    {
      "position": 3,
      "text": "Melt butter in a large soup pot over medium heat. Whisk in flour until smooth. Add milk and bring to a simmer. Add 1 1/2 cups Cheddar cheese, cream cheese, salt, and pepper. Stir until smooth. Turn heat off."
    },
    {
      "position": 4,
      "text": "Add drained pasta and beaten egg to cheese sauce and stir until evenly combined."
    },
    {
      "position": 5,
      "text": "Using a small spoon, divide mixture between mini muffin tins. Sprinkle each mac and cheese bite with remaining Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 16 minutes. Remove from oven and let stand 5 minutes before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

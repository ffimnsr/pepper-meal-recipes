  "id": "c300ebb5-7c2f-5dc4-b17c-8cc0cae1d446",
  "slug": "my-big-fat-greek-baked-beans",
  "name": "My Big Fat Greek Baked Beans",
  "recipe_type": "side",
  "brief_description": "Proving that the best baked beans are Greek, Chef John bakes big, fat corona beans with tomatoes, dill, olive oil, and feta cheese into a flavorful casserole.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place corona beans in a large bowl. Cover with a generous amount of water and let soak, 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "Drain beans into a pot. Add 3 quarts fresh water and bay leaves. Bring to a boil, stir, and reduce heat to medium. Simmer until just tender but not too soft, 45 to 60 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Drain beans and spread into a large casserole dish. Add red onion, garlic, tomato sauce, tomato paste, honey, 1/2 cup dill, olive oil, salt, pepper, cayenne, vinegar, and water. Mix until well combined. Place the dish onto a lined baking sheet to catch any spills."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is bubbling and caramelized and beans are soft, about 1 hour. Check periodically and add more water if casserole is too dry."
    },
    {
      "position": 6,
      "text": "Stir casserole and smooth the top. Garnish with feta cheese and 1 tablespoon dill."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

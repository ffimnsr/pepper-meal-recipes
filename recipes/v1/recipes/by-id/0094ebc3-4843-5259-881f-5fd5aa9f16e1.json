  "id": "0094ebc3-4843-5259-881f-5fd5aa9f16e1",
  "slug": "slow-cooker-roasted-leg-of-lamb",
  "name": "Slow Cooker Roasted Leg of Lamb",
  "recipe_type": "main",
  "brief_description": "This slow cooker roasted lamb with a flavorsome garlic, mustard, and rosemary paste simmers in red wine until perfectly tender and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour wine into a slow cooker. Mix lemon juice, honey, mustard, garlic, vinegar, rosemary, thyme, sea salt, and pepper in a medium bowl until a thick paste forms. Massage paste into lamb using your hands; gently place into the slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 5 hours. An instant-read thermometer inserted near the bone should read 145 degrees F (65 degrees C). Let lamb rest for 15 to 20 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 10,

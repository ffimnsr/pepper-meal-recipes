  "slug": "overnight-steel-cut-oats-with-yogurt-and-blueberries",
  "name": "Overnight Steel-Cut Oats with Yogurt and Blueberries",
  "recipe_type": "breakfast",
  "brief_description": "These overnight steel-cut oats with yogurt, stevia powder, coconut milk, and blueberries are easy and delicious way to start your day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place oats into the bottom of a 1-pint Mason jar. Stir in yogurt, blueberries, and stevia powder. Pour in coconut milk and stir to combine."
    },
    {
      "position": 2,
      "text": "Cover the jar and refrigerate, 8 hours to overnight."
    }
  ],

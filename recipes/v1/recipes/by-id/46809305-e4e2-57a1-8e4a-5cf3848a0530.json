  "slug": "famous-restaurant-alfredo-sauce",
  "name": "Famous Restaurant Alfredo Sauce",
  "recipe_type": "main",
  "brief_description": "This is a much sought after recipe from a popular chain restaurant --my nephew worked there as a cook and gave it to me.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pasta in a large pot of lightly salted boiling water. Cook until tender, about 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Combine the butter, cream cheese, and half and half in a saucepan. Season with garlic salt and lemon pepper. Bring to a low boil over medium-low heat. Cook, stirring, until thickened slightly. Serve over 12 ounces of pasta."
    }
  ],

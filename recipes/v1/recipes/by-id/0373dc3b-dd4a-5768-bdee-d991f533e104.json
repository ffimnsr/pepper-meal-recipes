  "id": "0373dc3b-dd4a-5768-bdee-d991f533e104",
  "slug": "six-can-chicken-tortilla-soup",
  "name": "Six Can Chicken Tortilla Soup",
  "recipe_type": "soup",
  "brief_description": "This easy chicken tortilla soup recipe uses cans of corn, chicken broth, black beans, chunk chicken, and tomatoes for a tasty meal on busy weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour chicken broth, corn, black beans, chunk chicken, and diced tomatoes with green chiles into a large saucepan or stockpot over medium heat."
    },
    {
      "position": 3,
      "text": "Simmer, stirring occasionally, until chicken is heated through, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot, topped with tortilla chips and shredded cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

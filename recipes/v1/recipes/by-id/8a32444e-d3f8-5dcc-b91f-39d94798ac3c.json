  "id": "8a32444e-d3f8-5dcc-b91f-39d94798ac3c",
  "slug": "perfect-potato-soup",
  "name": "Perfect Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This thick and chunky potato soup with crispy bacon, carrots, celery, and onion is a satisfying family-friendly dinner that's easy to make.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with water; bring to a boil. Cook until fork-tender, about 10 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Place bacon in a large saucepan and cook over medium-high heat, turning occasionally, until crispy, about 8 minutes. Drain bacon slices on paper towels. Pour out bacon grease."
    },
    {
      "position": 3,
      "text": "Melt butter in the saucepan over medium heat, scraping the bottom of the pan with a flat-edged wooden spoon. Add celery, onion, carrots, 1 teaspoon salt, and 1/2 teaspoon pepper; cook and stir until tender, about 10 minutes. Sprinkle in flour; cook and stir for 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour half-and-half and chicken broth into the saucepan. Add potatoes, 1 teaspoon salt, 1/2 teaspoon pepper, thyme, cayenne pepper, and nutmeg. Bring to a boil, stirring frequently. Stir in bacon pieces. Reduce heat and simmer, stirring often, until flavors combine, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Ladle into serving bowls. Garnish with 1/2 teaspoon pepper, green onions, and paprika."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

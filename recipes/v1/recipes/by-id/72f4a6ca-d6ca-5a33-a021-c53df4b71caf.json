  "id": "72f4a6ca-d6ca-5a33-a021-c53df4b71caf",
  "slug": "spelt-pancakes",
  "name": "Spelt Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These spelt flour pancakes use only spelt flour and homemade buttermilk for fluffy whole grain pancakes that make a delicious and healthy breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk and lemon juice in a large bowl and let stand until curdled, about 5 minutes. Stir in beaten egg and melted butter until combined. Set aside."
    },
    {
      "position": 2,
      "text": "Combine spelt flour, sugar, baking powder, baking soda, and salt in a medium bowl. Stir gently into milk mixture until just combined; batter will be lumpy."
    },
    {
      "position": 3,
      "text": "Heat a lightly greased griddle over medium-high heat. Drop batter by large spoonfuls onto the hot griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 1 to 2 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

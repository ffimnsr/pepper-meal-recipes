  "slug": "italian-green-bean-casserole-recipe-11916842",
  "name": "Italian Green Bean Casserole",
  "recipe_type": "side",
  "brief_description": "This Italian green bean casserole, with artichokes, Parmesan cheese, and breadcrumbs, is so easy, and so flavorful. A good olive oil makes the dish\u2014no cream required.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Reserve 2 tablespoons Parmesan cheese for topping and add remaining cheese to a large bowl."
    },
    {
      "position": 2,
      "text": "Add green beans, artichoke hearts, garlic powder, salt, pepper, breadcrumbs, and olive oil to the bowl. Stir until well combined and mixture is evenly coated with olive oil. Add a little more oil if necessary to moisten the mixture. Transfer mixture to a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 to 60 minutes, stirring halfway through. Top with reserved cheese during the last 10 minutes of baking."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

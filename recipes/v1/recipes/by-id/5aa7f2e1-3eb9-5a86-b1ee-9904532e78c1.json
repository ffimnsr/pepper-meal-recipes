  "id": "5aa7f2e1-3eb9-5a86-b1ee-9904532e78c1",
  "slug": "buffalo-cauliflower",
  "name": "Buffalo Cauliflower",
  "recipe_type": "appetizer",
  "brief_description": "Buffalo cauliflower is a tasty appetizer of cauliflower coated in seasoned, gluten-free breading, oven-roasted, and brushed with hot honey sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together water, flour, garlic powder, salt, and pepper in a large bowl until batter is smooth and somewhat runny."
    },
    {
      "position": 3,
      "text": "Add cauliflower pieces to batter and mix until evenly coated; spread onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, 20 to 25 minutes. Set aside."
    },
    {
      "position": 5,
      "text": "Melt butter in a saucepan over medium heat. Remove from heat; stir in hot pepper sauce and honey until smooth."
    },
    {
      "position": 6,
      "text": "Brush hot sauce mixture over each cauliflower piece, repeating until all is used."
    },
    {
      "position": 7,
      "text": "Return to the oven and bake until cauliflower is browned, about 10 minutes. Let cool for 10 to 15 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

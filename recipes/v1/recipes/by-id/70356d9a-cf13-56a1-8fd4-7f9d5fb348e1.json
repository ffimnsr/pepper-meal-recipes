  "id": "70356d9a-cf13-56a1-8fd4-7f9d5fb348e1",
  "slug": "cajun-baked-french-fries",
  "name": "Cajun Baked French Fries",
  "recipe_type": "appetizer",
  "brief_description": "Baked French fries coated in plenty of Cajun seasoning will be a hit with kids and adults alike.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix olive oil, garlic powder, onion powder, chili powder, Cajun seasoning, and sea salt in a large resealable bag. Add potatoes and toss to evenly coat with seasoned oil. Spread coated potatoes in 1 layer onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 35 minutes. Stir potatoes with a spatula and continue cooking until crisp, about 10 more minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

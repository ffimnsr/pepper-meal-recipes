  "schema_version": 1,
  "id": "35d13280-8113-579c-ad6f-c0a97125c96b",
  "slug": "macaron-french-macaroon",
  "name": "Macarons (French Macaroons)",
  "recipe_type": "dessert",
  "brief_description": "Macarons are sweet and delicate French meringue cookies made with ground almonds. Sandwich them with chocolate ganache or frosting for a dainty treat.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with a silicone baking mat."
    },
    {
      "position": 2,
      "text": "Beat egg whites in the bowl of a stand mixer fitted with a whisk attachment until foamy. Add white sugar and beat until egg whites are glossy, fluffy, and hold soft peaks."
    },
    {
      "position": 3,
      "text": "Sift confectioners' sugar and ground almonds in a separate bowl; quickly fold almond mixture into egg whites, about 30 strokes."
    },
    {
      "position": 4,
      "text": "Spoon a small amount of batter into a plastic bag with a small corner cut off and pipe a test disk of batter, about 1 1/2 inches in diameter, onto the prepared baking sheet. If the disk of batter holds a peak instead of flattening immediately, gently fold batter a few more times and retest."
    },
    {
      "position": 5,
      "text": "When batter is mixed enough to flatten immediately into an even disk, spoon into a pastry bag fitted with a plain round tip. Pipe batter onto the baking sheet in rounds, leaving space between the disks. Let piped cookies stand out at room temperature until they form a hard skin on top, about 1 hour."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 285 degrees F (140 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake cookies in preheated oven until set but not browned, about 10 minutes."
    },
    {
      "position": 8,
      "text": "Let cookies cool completely before filling, about 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

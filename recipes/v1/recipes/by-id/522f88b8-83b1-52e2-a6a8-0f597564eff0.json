  "id": "522f88b8-83b1-52e2-a6a8-0f597564eff0",
  "slug": "breakfast-chilaquiles",
  "name": "Breakfast Chilaquiles",
  "recipe_type": "breakfast",
  "brief_description": "Breakfast chilaquiles made with crispy corn tortillas, eggs, enchilada sauce, and cheese are the main components of this quick and easy Mexican dish.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add tortilla squares; cook and stir until crispy, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Whisk eggs, salt, and pepper together in a bowl; stir in Cheddar cheese."
    },
    {
      "position": 3,
      "text": "Pour egg and cheese mixture into the skillet; cook and stir until eggs are firm, about 5 minutes. Pour enchilada sauce on top."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,

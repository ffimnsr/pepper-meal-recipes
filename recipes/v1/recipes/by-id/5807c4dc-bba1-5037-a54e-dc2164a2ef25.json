{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5807c4dc-bba1-5037-a54e-dc2164a2ef25",
  "slug": "dooky-chase-style-fried-chicken-recipe-7971700",
  "name": "Dooky Chase-Style Fried Chicken",
  "recipe_type": "main",
  "brief_description": "Chef John's version of New Orleans' famous fried chicken \"is shockingly simple [yet] likely the most beautiful and delicious fried chicken you will ever make at home.\"",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together 4 teaspoons salt, black pepper, garlic powder, and cayenne in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Whisk eggs, water, and 2 tablespoons of spice mix thoroughly together in a mixing bowl large enough to hold all chicken pieces."
    },
    {
      "position": 3,
      "text": "Cut whole chicken into serving-size pieces, ending up with 2 breast halves, 2 thighs, 2 drumsticks, and 2 wings. Alternately, you can use 4 pounds of bone-in, skin-on pre-cut chicken pieces."
    },
    {
      "position": 4,
      "text": "Add chicken pieces to the egg marinade and toss thoroughly until evenly coated. Press and compact chicken pieces down into the bowl so they are covered with marinade."
    },
    {
      "position": 5,
      "text": "Cover with plastic, and marinate in the refrigerator for 12 to 24 hours. Toss chicken pieces several times during the marinating process."
    },
    {
      "position": 6,
      "text": "Mix flour and the 1 teaspoon salt together in a shallow pan."
    },
    {
      "position": 7,
      "text": "Preheat vegetable oil for deep frying to 350 degrees F (180 degrees C)."
    },
    {
      "position": 8,
      "text": "When ready to fry, use tongs to pull chicken out of marinade, letting excess marinade drip off. Coat thoroughly with seasoned flour, and shake off excess. Carefully place in the hot oil."
    },
    {
      "position": 9,
      "text": "If your fryer is large enough to accommodate the whole chicken, add breast pieces first, and fry for 3 to 4 minutes before adding thighs, legs, and wings. Once all the chicken is in the oil, fry for 15 to 18 minutes, or until chicken is no longer pink at the center and juices run clear. An instant-read thermometer inserted near the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 10,
      "text": "Transfer chicken to a rack to drain, and let cool 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

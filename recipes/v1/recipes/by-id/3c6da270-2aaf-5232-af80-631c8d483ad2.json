  "id": "3c6da270-2aaf-5232-af80-631c8d483ad2",
  "slug": "creamy-tortellini-soup",
  "name": "Creamy Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy tortellini soup combines fresh broccoli, stuffed tortellini pasta, and shredded cheese in a rich broth for a cozy meal in just 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a Dutch oven over medium-high heat. Add onion cook until soft and translucent, about 5 minutes. Add garlic and cook until fragrant, about 30 seconds. Sprinkle flour over onion-garlic mixture. Stir to combine, until flour is incorporated."
    },
    {
      "position": 2,
      "text": "Slowly pour in chicken broth, stirring to combine. Add broccoli, carrot, and tortellini. Season with salt, pepper, paprika, and turmeric. Stir to combine and reduce heat to medium. Cover and simmer until broccoli is tender and tortellini are cooked through, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in cream and cheese until melted. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

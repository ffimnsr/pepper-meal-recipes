  "id": "d1c87f6d-eeb9-5de4-9d72-e14de49cf4ba",
  "slug": "authentic-saag-paneer",
  "name": "Authentic Saag Paneer",
  "recipe_type": "main",
  "brief_description": "Saag paneer is a classic Indian dish of cooked spinach studded with cubes of fried paneer cheese for a hearty, flavorful, and filling vegetarian meal.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large saucepan of water to a boil; add spinach and fenugreek and cook until wilted, about 3 minutes. Drain well."
    },
    {
      "position": 3,
      "text": "Transfer to a food processor and blend until finely chopped, about 5 pulses."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon canola oil in a large skillet over medium heat; add paneer cubes and fry until browned on all sides, about 5 minutes. Transfer paneer onto a plate."
    },
    {
      "position": 5,
      "text": "Heat remaining 2 tablespoons canola oil in the same skillet over medium heat; add cumin seeds and fry until lightly toasted and aromatic, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Add onion; cook and stir until softened, 4 to 5 minutes. Add garlic and ginger and stir to coat."
    },
    {
      "position": 7,
      "text": "Stir in tomato, garam masala, turmeric, and cayenne pepper; cook until tomato breaks down, stirring often, about 10 minutes."
    },
    {
      "position": 8,
      "text": "Stir in pureed spinach mixture, paneer cubes, and cream; add salt to taste."
    },
    {
      "position": 9,
      "text": "Reduce heat to low, cover, and simmer for 15 minutes, stirring occasionally."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

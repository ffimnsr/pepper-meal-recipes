  "id": "27d33a91-8965-5506-a59f-7364de08d871",
  "slug": "spiced-pumpkin-seeds",
  "name": "Spiced Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "Make this snack by roasting fresh pumpkin seeds in margarine, Worcestershire sauce, and garlic salt.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine the margarine, salt, garlic salt, Worcestershire sauce and pumpkin seeds."
    },
    {
      "position": 4,
      "text": "Mix thoroughly and place in shallow baking dish."
    },
    {
      "position": 5,
      "text": "Bake for 1 hour, stirring occasionally."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

  "id": "a008d0cb-b0f4-5c21-83ee-385b4907940f",
  "slug": "raspberry-cream-cheese-coffee-cake",
  "name": "Raspberry Cream Cheese Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This raspberry cream cheese coffee cake is a fruity alternative to those standard coffee cake recipes made with cinnamon, walnuts, and streusel.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch springform pan."
    },
    {
      "position": 2,
      "text": "Make the cake: Combine flour, sugar, and butter in a food processor; pulse until mixture resembles coarse crumbs. Remove 1 cup of mixture and set aside for topping."
    },
    {
      "position": 3,
      "text": "Add sour cream, egg, almond extract, baking soda, baking powder, and salt to the food processor. Process until batter is combined and smooth."
    },
    {
      "position": 4,
      "text": "Pour into the prepared pan. Spread over the bottom and 2 inches up the sides."
    },
    {
      "position": 5,
      "text": "Make the cream cheese layer: Beat cream cheese, sugar, and egg in a bowl with an electric mixer until smooth."
    },
    {
      "position": 6,
      "text": "Pour over batter in the pan and spread evenly. Carefully spread preserves over top."
    },
    {
      "position": 7,
      "text": "Make the topping: Stir 1 cup reserved crumb mixture and almonds together in a small bowl. Sprinkle over preserves."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until filling is set and topping is golden brown, 45 to 55 minutes."
    },
    {
      "position": 9,
      "text": "Remove from the oven and cool in the pan for 15 minutes. Carefully remove the sides of the pan. Chill completely before serving, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,

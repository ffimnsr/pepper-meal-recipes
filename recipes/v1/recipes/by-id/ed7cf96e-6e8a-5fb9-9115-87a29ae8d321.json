  "id": "ed7cf96e-6e8a-5fb9-9115-87a29ae8d321",
  "slug": "veggie-lo-mein-recipe-8620468",
  "name": "Veggie Lo Mein",
  "recipe_type": "dessert",
  "brief_description": "This veggie lo mein is a budget-friendly combination of pasta, healthy veggies, and a slightly spicy-sweet sauce for a satisfying quick-and-easy meal.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk soy sauce, hoisin sauce, sesame oil, brown sugar, and Sriracha together in a small bowl until well blended; set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add pasta, stirring occasionally; cook until nearly tender with a bite, 7 to 8 minutes, and drain well."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat vegetable oil over medium-high heat in a large skillet or wok. Add mushrooms, snow peas, red bell pepper, carrot, onion, and garlic. Cook, stirring frequently, until just tender, 4 to 6 minutes."
    },
    {
      "position": 4,
      "text": "Add spaghetti and sauce to the skillet and toss with the veggies until well coated. Simmer for 2 minutes to allow pasta to soak up the flavor, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

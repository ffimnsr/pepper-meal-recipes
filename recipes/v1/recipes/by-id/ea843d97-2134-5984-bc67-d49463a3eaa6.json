  "id": "ea843d97-2134-5984-bc67-d49463a3eaa6",
  "slug": "chinese-five-spice-air-fryer-butternut-squash-fries",
  "name": "Sweet and Spicy Air Fryer Butternut Squash Fries",
  "recipe_type": "dessert",
  "brief_description": "Make butternut squash fries in the air fryer with garlic, black pepper, and five-spice powder for a sweet-spicy side dish with fewer carbs than regular fries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place cut squash into a large bowl. Add oil, five-spice powder, garlic, sea salt, and pepper. Toss to coat and place into the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook in the preheated air fryer, shaking every 5 minutes, until crisp, 15 to 20 minutes total. Remove fries and season with additional sea salt."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

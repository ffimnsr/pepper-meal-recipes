  "id": "3e4b5f3f-fd5d-578b-a616-e3b51cdc7cd8",
  "slug": "best-tuna-noodle-casserole-from-scratch",
  "name": "Best Tuna Noodle Casserole from Scratch",
  "recipe_type": "main",
  "brief_description": "This creamy casserole is as close to comfort food as you can get with no canned ingredients! It does take some effort to make, but it's worth it.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly oil an ovenproof skillet and an 8x12-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Place tuna in the prepared skillet and bake in the preheated oven until fish flakes easily with a fork, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Fill a large saucepan with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain and set aside."
    },
    {
      "position": 4,
      "text": "Remove tuna from the oven; leave oven on."
    },
    {
      "position": 5,
      "text": "Meanwhile, melt 3 tablespoons butter in a saucepan over medium heat. Cook onion and mushrooms until softened, stirring occasionally, 5 to 7 minutes. Stir in flour until blended. Add milk, bouillon concentrate, adobo seasoning, and black pepper. Cook, stirring constantly, until mixture is slightly thickened, about 5 minutes more. Remove sauce from heat and stir in Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Place remaining butter in a medium-sized microwave-safe bowl and heat in the microwave until melted, about 30 seconds. Stir bread crumbs into melted butter and set aside."
    },
    {
      "position": 7,
      "text": "Add cooked fettuccine and flaked tuna to the cheese sauce and toss to combine. Transfer noodle mixture to the prepared casserole dish and top with torn bread."
    },
    {
      "position": 8,
      "text": "Bake in the hot oven until golden brown, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

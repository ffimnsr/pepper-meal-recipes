  "id": "24360cf3-f6fd-55a7-ae30-16b9add34d0d",
  "slug": "catfish-etouffee",
  "name": "Catfish \u00c9touff\u00e9e",
  "recipe_type": "soup",
  "brief_description": "Bring the flavors of New Orleans home with this Mardi Gras-worthy catfish \u00e9touff\u00e9e. Served over cauliflower rice instead of white rice, for more fiber and fewer calories.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add onion, green pepper, and celery; cook until vegetables are just beginning to soften, about 7 minutes. Add tomatoes, broth, hot sauce, thyme, Worcestershire, salt, and black pepper. Bring to a boil. Reduce heat to medium-low; simmer, uncovered, until thickened and saucy, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Put catfish pieces on top of the vegetable mixture. Cook, covered, until catfish is just cooked through and opaque, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Remove catfish from the skillet and keep warm. Stir parsley into skillet. Serve \u00e9touff\u00e9e and catfish over riced cauliflower. Sprinkle with green onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

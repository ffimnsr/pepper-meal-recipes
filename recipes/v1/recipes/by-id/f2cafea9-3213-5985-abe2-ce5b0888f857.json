  "id": "f2cafea9-3213-5985-abe2-ce5b0888f857",
  "slug": "mediterranean-chicken",
  "name": "Mediterranean Chicken",
  "recipe_type": "main",
  "brief_description": "This Mediterranean chicken recipe features plenty of olives, onion, tomatoes, and herbs for a deliciously light dinner that won\u2019t disappoint.",
  "cuisine": "European",
  "instructions": [
    {
      "position": 1,
      "text": "Heat white wine and oil in a large skillet over medium heat. Add chicken and cook until golden, about 4 to 6 minutes on each side. Remove chicken from skillet and set aside."
    },
    {
      "position": 2,
      "text": "Add garlic to pan drippings; saut\u00e9 for 30 seconds. Add onion; cook and stir until onions are tender, about 3 minutes. Add tomatoes and bring to a boil. Reduce heat to low and add 1/2 cup white wine; simmer for 10 minutes. Add thyme and basil and simmer for 5 more minutes."
    },
    {
      "position": 3,
      "text": "Return chicken to skillet, cover, and cook over low heat until the chicken is cooked through and no longer pink inside. Add olives and parsley; cook for 1 minute. Season with salt and pepper and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "e2f47032-45b3-54a6-8346-dd77f9c9e1a4",
  "slug": "lime-bars",
  "name": "Lime Bars",
  "recipe_type": "dessert",
  "brief_description": "If you love lemon bars, try these delicious lime bars. They\u2019re similar, but they have the bite of fresh lime juice and grated lime peel. Fun to take to a picnic or just make anytime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 12x15-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix 2 cups flour, 1/2 cup confectioners\u2019 sugar, and salt in a bowl; cut in butter with a pastry cutter until crust mixture resembles crumbs. Pat crust evenly into bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven for 10 minutes."
    },
    {
      "position": 4,
      "text": "Whisk eggs, 1/3 cup lime juice, 1/4 cup flour, white sugar, 2 teaspoons lime peel, baking powder, and food coloring in a bowl; pour over the crust."
    },
    {
      "position": 5,
      "text": "Return baking dish to oven; bake until filling is set, about 25 minutes. Cool thoroughly."
    },
    {
      "position": 6,
      "text": "Whisk 1 1/2 cup confectioners\u2019 sugar, 1 tablespoon lime juice, and 1 teaspoon grated lime peel to make a smooth glaze; spread evenly over cooled lime bars. Let glaze set before serving."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,

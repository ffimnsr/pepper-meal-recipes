{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "99f0d67b-27ef-551a-a23f-b1026c0d1784",
  "slug": "tex-mex-pork-crescent-roll-squares",
  "name": "Tex-Mex Pork Crescent Roll Squares",
  "recipe_type": "appetizer",
  "brief_description": "Use convenient crescent roll dough as a base for loaded Tex-Mex-nacho-style pulled pork flatbread appetizers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut a 13x18-inch piece of parchment paper; place on a work surface. Unroll crescent roll dough and place on the parchment paper, slightly overlapping the long sides of the two pieces of dough."
    },
    {
      "position": 3,
      "text": "Lightly flour a rolling pin; roll over the overlapping dough edges and over the perforations to create one 12x17-inch seamless piece of dough. Carefully lift the parchment paper with dough and fit into a 13x18-inch metal sheet pan."
    },
    {
      "position": 4,
      "text": "Sprinkle 1 cup shredded Cheddar evenly over the dough; follow with pulled pork. Scatter drained beans and drained RO-TEL® over pulled pork; sprinkle on green onions, taco seasoning, and remaining 1 cup Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and the visible edges of the crescent dough are browned, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Remove to a wire rack. Sprinkle crumbled cotija cheese over all."
    },
    {
      "position": 7,
      "text": "Scatter jalapeño slices, avocado slices, and chopped cilantro over if using."
    },
    {
      "position": 8,
      "text": "Cut into 32 squares with a sharp knife or a pizza cutter; place on a warmed serving platter with lime wedges, if using."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

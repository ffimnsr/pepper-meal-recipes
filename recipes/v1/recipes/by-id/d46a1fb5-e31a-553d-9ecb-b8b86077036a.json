  "slug": "beer-margaritas",
  "name": "Beer Margaritas",
  "recipe_type": "drink",
  "brief_description": "This beerita recipe uses beer, tequila, water, and frozen limeade concentrate to make a quick and dirty margarita for your boozy loving friends.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour limeade concentrate, tequila, water, and beer into a large pitcher. Stir until limeade has melted."
    },
    {
      "position": 3,
      "text": "Add plenty of ice to the pitcher and garnish with lime wedges. Adjust with additional water if needed."
    }
  ],

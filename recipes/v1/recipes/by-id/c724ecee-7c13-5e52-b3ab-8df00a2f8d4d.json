  "id": "c724ecee-7c13-5e52-b3ab-8df00a2f8d4d",
  "slug": "pumpkin-cranberry-scones",
  "name": "Pumpkin-Cranberry Scones",
  "recipe_type": "breakfast",
  "brief_description": "These pumpkin-cranberry scones deliver the goodness of fall in one treat! Baking them will make your home smell so delightful.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, white sugar, baking powder, cinnamon, ginger, baking soda, and salt together in a bowl. Cut in butter using a pastry cutter until the mixture looks like oatmeal."
    },
    {
      "position": 3,
      "text": "Add pumpkin, cranberries, sour cream, 3 tablespoons milk, and vanilla extract to the flour mixture and gently combine using a fork. Roll dough out onto a floured surface and form a rectangle. Cut into 10 triangles or squares and place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine powdered sugar and milk in a small bowl until smooth. Set glaze aside."
    },
    {
      "position": 6,
      "text": "Remove scones from the oven and let cool 10 minutes before drizzling glaze on top. Serve warm."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

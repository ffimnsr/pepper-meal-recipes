  "id": "e5510498-8109-5557-88af-bcd416dbfbec",
  "slug": "cheese-onion-garlic-bread",
  "name": "Cheese Onion Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "Plenty of garlic and melted Italian cheeses taste wonderful on pieces of sliced French bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the broiler."
    },
    {
      "position": 2,
      "text": "Slice the French baguettes diagonally into 3/4 inch slices."
    },
    {
      "position": 3,
      "text": "In a medium skillet over medium heat, melt the butter. Combine the onions and garlic in the skillet. Cook and stir until tender. Set aside to cool."
    },
    {
      "position": 4,
      "text": "In a mixing bowl, combine the mozzarella cheese, Parmesan cheese and mayonnaise."
    },
    {
      "position": 5,
      "text": "On a cookie sheet, arrange the French bread slices in a single layer. Spread the onion and garlic mixture on the bread slices. Spread the cheese and mayonnaise mixture over the onion and garlic mixture on the bread slices. Broil about 5 minutes, until the cheese is bubbly and slightly browned. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "7a60091d-cc0f-5d5a-b798-ef11d567cdbf",
  "slug": "sourdough-pizza-crust-dough",
  "name": "Sourdough Pizza Crust Dough",
  "recipe_type": "appetizer",
  "brief_description": "This 4-ingredient recipe uses sourdough starter to make a partially baked pizza crust you can top with your favorite sauce and toppings.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix starter, flour, olive oil, and salt together in a bowl until mixture forms a ball. Let dough rest for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 3,
      "text": "Roll out dough on parchment paper or a lightly floured work surface, rotating frequently, until it is the same size as the baking pan. Transfer to the pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pale golden, about 7 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 10,

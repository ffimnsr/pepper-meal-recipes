  "id": "2371a88f-39f5-5906-8fdf-78d83d3e9f5f",
  "slug": "peanut-butter-haystacks",
  "name": "Peanut Butter Haystacks",
  "recipe_type": "dessert",
  "brief_description": "This haystack recipe uses 4 simple ingredients to make sweet, salty, simple, no-bake candy with chow mein noodles, butterscotch, and peanut butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking tray with waxed paper."
    },
    {
      "position": 2,
      "text": "Place butterscotch chips and peanut butter in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until melted, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir noodles and peanuts into melted peanut butter mixture."
    },
    {
      "position": 4,
      "text": "Drop dough by forkfuls onto the prepared tray. Allow to cool at room temperature until set."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

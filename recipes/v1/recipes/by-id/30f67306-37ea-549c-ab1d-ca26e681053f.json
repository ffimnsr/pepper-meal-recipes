  "id": "30f67306-37ea-549c-ab1d-ca26e681053f",
  "slug": "mexican-frittata",
  "name": "Mexican Frittata",
  "recipe_type": "breakfast",
  "brief_description": "The addition of peppers, cumin, and salsa provides Mexican flair to this quick and easy breakfast frittata that's perfect when cooking for one.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a small casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat oil in a 12-inch nonstick skillet over medium heat. Add bell pepper and onion and cook until tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "While pepper and onion are cooking, combine milk, egg whites, whole eggs, salt, pepper, and cumin into a medium bowl using a whisk."
    },
    {
      "position": 4,
      "text": "Transfer cooked vegetables to the prepared casserole dish. Pour egg mixture over the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until eggs are set, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove frittata from the oven and cut into wedges or squares. Place onto a plate and top with salsa."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9e137dbe-e60e-554a-a8c5-4f3aa0544129",
  "slug": "dirty-horchata-recipe-12028949",
  "name": "Dirty Horchata",
  "recipe_type": "dessert",
  "brief_description": "This dirty horchata is an iced espresso drink that begins with homemade horchata. Sweetened condensed milk balances espresso\u2019s gently bitter notes for a creamy, refreshing sip. The horchata makes enough for about 10 drinks, so store the extra in the refrigerator and enjoy another anytime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For horchata, combine rice, cinnamon sticks, and water in a container and let stand for 2 hours."
    },
    {
      "position": 2,
      "text": "Drain rice and cinnamon sticks, but save the water. Combine rice and cinnamon sticks in a food processor or powerful blender. Process or blend until mixture resembles coarse sand."
    },
    {
      "position": 3,
      "text": "Place rice mixture back into soaking water and let sit for 2 hours, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Strain rice mixture through a fine sieve into a container. Add sweetened condensed milk, milk, and vanilla extract. Stir until well combined and refrigerate horchata until ready to use."
    },
    {
      "position": 5,
      "text": "For each dirty horchata, fill a glass with ice cubes and pour 1/2 cup (or as needed) horchata into the glass. Top with espresso; add cold brew coffee to taste."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,

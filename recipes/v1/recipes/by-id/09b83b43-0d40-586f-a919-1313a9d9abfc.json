  "id": "09b83b43-0d40-586f-a919-1313a9d9abfc",
  "slug": "brown-bears",
  "name": "Brown Bears",
  "recipe_type": "breakfast",
  "brief_description": "Brown bears are campfire bread made from canned biscuit dough, butter, white sugar, and ground cinnamon. Both kids and grown-ups will love the recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix sugar and cinnamon together in a shallow bowl. Pour melted butter into a separate shallow bowl."
    },
    {
      "position": 3,
      "text": "Separate biscuits; form each dough piece into a rope 4 to 5 inches long. Wrap dough pieces around skewers."
    },
    {
      "position": 4,
      "text": "Hold skewers over campfire; slowly turn until biscuit dough is browned and set, 8 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Dip biscuits into melted butter, then dredge in cinnamon-sugar."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "4842a00b-da00-5ae6-8987-475ee24eca5a",
  "slug": "italian-potato-salad",
  "name": "Italian Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Very good and very Italian with its garlic, parsley olive oil and vinegar dressing. The potatoes are cooked, chopped, and bathed in this lovely dressing and then chilled overnight.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain, cool and chop."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the garlic, olive oil, vinegar and parsley. Add potatoes and toss to evenly coat."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

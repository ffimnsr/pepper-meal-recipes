  "id": "86346fd3-2ae8-578d-b2ec-983e1c419883",
  "slug": "banana-rum-biscotti",
  "name": "Banana Rum Biscotti",
  "recipe_type": "dessert",
  "brief_description": "These biscotti have a hint of banana and rum, and a nutty crunch of toasted pecans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, baking powder, and salt in a bowl and stir to mix well. Beat the eggs lightly in a bowl, and add the sugar, banana, oil, and rum. Stir the banana mixture into the flour mixture, blend well, and drop in the pecans, mixing them thoroughly into the dough. Form the dough into 4 logs about 1/2 inch thick, place them onto parchment paper-lined baking sheets, and bake for 25 minutes, until the cookie logs begin to brown."
    },
    {
      "position": 3,
      "text": "Lower the oven temperature to 250 degrees F (120 degrees C). Remove the baking sheets from the oven and let the cookie logs cool for 10 minutes. Remove the logs from the parchment paper and cut each log into 1/2 inch thick slices. Place the biscotti back onto the cookie sheets and bake for 15 minutes per side (30 minutes total) until cookies begin to brown. Remove to racks to cool. The biscotti will be soft at first, and will harden as they cool."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 55,

  "id": "2cc7f673-2801-59d8-ac3c-f3a18b6973fa",
  "slug": "jamies-minestrone",
  "name": "Jamie's Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "This minestrone soup recipe is packed with hearty vegetables, beans, pasta, and herbs in a flavorful tomato broth for the best minestrone soup ever!",
  "cuisine": "U.S. Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large stockpot over medium-low heat. Saut\u00e9 garlic in hot oil until fragrant, 2 to 3 minutes. Add onion; cook and stir until translucent, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Add celery and carrots; saut\u00e9 for 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour in tomato sauce, broth, and water; bring to a boil, stirring frequently. Add red wine; reduce heat to low."
    },
    {
      "position": 5,
      "text": "Stir in zucchini, spinach, green beans, kidney beans, basil, oregano, salt, and pepper. Simmer until soup is heated through, 30 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, fill a medium saucepan with water and bring to a boil. Cook seashell pasta in boiling water, stirring occasionally, until tender yet firm to the bite, 7 to 8 minutes. Drain and set aside."
    },
    {
      "position": 7,
      "text": "Place 2 tablespoons cooked pasta into individual serving bowls. Ladle soup over pasta and sprinkle with Parmesan cheese."
    },
    {
      "position": 8,
      "text": "Drizzle with olive oil to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "hard",

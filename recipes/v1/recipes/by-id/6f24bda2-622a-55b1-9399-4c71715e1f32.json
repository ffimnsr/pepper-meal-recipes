  "slug": "freezer-door-pepperon-tini-recipe-11783106",
  "name": "Freezer Door Pepperon'tini",
  "recipe_type": "appetizer",
  "brief_description": "Batch prep this freezer door pepperon'tini, a martini with a twist, for your next party! A gin martini flavored with pepperoncini brine is a super silky, spicy, and herby, a whole bunch of 'tinis with very low effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour 1 cup gin out of the 750 mLbottle. Set aside for another use. Add Vermouth, filtered water, and pepperoncini brine to the gin bottle."
    },
    {
      "position": 3,
      "text": "Chill in the freezer for at least 4 hours, or until ready to serve. If desired, serve with a lemon twist garnish."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,

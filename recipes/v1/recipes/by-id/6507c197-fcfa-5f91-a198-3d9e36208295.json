  "id": "6507c197-fcfa-5f91-a198-3d9e36208295",
  "slug": "awesome-broccoli-cheese-casserole",
  "name": "Awesome Broccoli-Cheese Casserole",
  "recipe_type": "side",
  "brief_description": "This tasty broccoli cheese casserole will turn even the pickiest of eaters into broccoli fans! Pairs well with Thanksgiving turkey or Christmas ham.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk condensed soup, mayonnaise, egg, and onion together in a medium mixing bowl until combined."
    },
    {
      "position": 3,
      "text": "Place frozen broccoli florets into a very large mixing bowl and break it up if necessary; add soup mixture and mix well to coat. Sprinkle with cheese and mix well; spread mixture into the prepared baking dish. Season with salt, pepper, and paprika."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese has melted and the casserole is golden brown on top, 45 minutes to 1 hour."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

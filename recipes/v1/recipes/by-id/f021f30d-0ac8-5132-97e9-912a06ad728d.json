  "id": "f021f30d-0ac8-5132-97e9-912a06ad728d",
  "slug": "rhapple-pie",
  "name": "Rhapple Pie",
  "recipe_type": "dessert",
  "brief_description": "Apple and rhubarb come together in a fruity sweet-tart pie topped with a Chinese-five-spiced crumble.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place rack in lowest position in the oven. Preheat the oven to 375 degrees F (190 degrees C). Line a 9-inch pie plate with pie crust."
    },
    {
      "position": 2,
      "text": "Combine apples and rhubarb in a large bowl. Toss with sugar, 3 tablespoons plus 1 teaspoon flour, and Chinese five-spice. Pour filling over the crust."
    },
    {
      "position": 3,
      "text": "Combine unsifted flour, sugar, oats, salt, and five-spice together in a large bowl. Cut in butter until crumbly. Scatter crumb topping over the pie."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until topping is golden brown and filling is bubbly, 50 to 60 minutes. Let cool completely before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

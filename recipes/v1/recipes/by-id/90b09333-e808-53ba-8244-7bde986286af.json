  "id": "90b09333-e808-53ba-8244-7bde986286af",
  "slug": "simple-turkey-chili",
  "name": "Simple Turkey Chili",
  "recipe_type": "soup",
  "brief_description": "This turkey chili recipe is made with ground turkey, tomatoes, kidney beans, and spices that make it super flavorful. Even better on the second day!",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium heat. Add turkey; cook and stir until evenly browned, 6 to 8 minutes. Stir in onion and cook until softened."
    },
    {
      "position": 3,
      "text": "Add water; stir in tomatoes, kidney beans, and garlic."
    },
    {
      "position": 4,
      "text": "Stir in chili powder, paprika, oregano, cayenne pepper, cumin, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Bring to a boil. Reduce heat to low and simmer, covered, until flavors blend and chili thickens slightly, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

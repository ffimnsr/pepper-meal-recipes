  "slug": "slow-cooker-hawaiian-chicken",
  "name": "Slow Cooker Hawaiian Chicken",
  "recipe_type": "main",
  "brief_description": "Just chicken, pineapple, barbeque sauce, soy sauce, and a slow cooker combine for this delicious chicken dish that will leave your kitchen smelling great.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Put chicken breasts into the crock of a slow cooker; top with barbeque sauce, pineapple slices, and soy sauce."
    },
    {
      "position": 2,
      "text": "Cook on High for 4 to 5 hours."
    }
  ],
  "servings": 9,

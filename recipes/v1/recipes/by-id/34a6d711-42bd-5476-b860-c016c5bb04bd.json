  "id": "34a6d711-42bd-5476-b860-c016c5bb04bd",
  "slug": "rhubarb-torte",
  "name": "Rhubarb Torte",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb torte recipe features a sweet rhubarb filling baked in a simple crust with meringue on top for an elegant dessert made in a 9-inch square pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "Combine 1 cup flour, margarine, and confectioners' sugar in a large bowl; mix until a dough ball forms; press into bottom and up sides of a 9-inch square pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust golden brown, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Combine 1 \u00bd cups white sugar, egg yolks, milk, and 3 tablespoons flour in a saucepan over medium-high heat. Add rhubarb; cook, stirring constantly, until thickened. Pour filling into hot crust."
    },
    {
      "position": 5,
      "text": "Beat egg whites in a large glass or metal bowl until foamy; gradually beat in remaining \u00bc cup sugar until stiff peaks form. Spread meringue over rhubarb filling to completely cover."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top is golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a62b0070-707d-5084-a55f-39bf22fbd4c8",
  "slug": "crunchy-air-fried-deviled-eggs",
  "name": "Crunchy Air-Fried Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Step up your deviled egg game with this air fryer recipe that adds a crispy exterior to that creamy filling everyone loves and expects.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut eggs in half lengthwise and put yolks in a small bowl. Add mayonnaise, mustard, chili powder, salt, and pepper. Mash with a fork until smooth. Set filling aside."
    },
    {
      "position": 2,
      "text": "Place flour in a small bowl. Beat egg and hot sauce together in a separate bowl. Place panko in a third bowl."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 4,
      "text": "Rinse the egg whites and place on a clean work surface. Drop in the bowl of flour; toss until coated. Dip into the beaten egg and then in the panko."
    },
    {
      "position": 5,
      "text": "Place breaded egg whites in the air fryer basket. Spray tops with cooking spray. Cook for 3 minutes. Flip and spray tops with more cooking spray. Cook for 4 minutes more."
    },
    {
      "position": 6,
      "text": "Place the egg whites on a serving tray and spoon yolk mixture into the centers."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "495dfdbd-5373-5d20-ae6e-112697f1a621",
  "slug": "rye-bread-party-pizzas",
  "name": "Rye Bread Party Pizzas",
  "recipe_type": "appetizer",
  "brief_description": "Cheesy rye bread party pizzas topped with a mixture of beef and sausage are always a favorite at any party and can be made ahead and frozen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Cook beef and sausage in a large, deep skillet over medium-high heat until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, microwave processed cheese food in a large microwave-safe bowl on high until melted, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Stir Worcestershire sauce and ketchup into melted cheese, then stir in cooked meat until thoroughly combined."
    },
    {
      "position": 5,
      "text": "Spoon about 2 tablespoons meat and cheese mixture onto each bread slice. Arrange bread in a single layer on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, in batches if necessary, until lightly browned and crisp, 10 to 15 minutes. Serve hot and enjoy!"
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "0eb5e639-5bd3-5f8f-ac06-7d16bf6a390f",
  "slug": "simply-steamed-asparagus",
  "name": "Simply Steamed Asparagus",
  "recipe_type": "side",
  "brief_description": "Steamed asparagus is simple to do and yields tender and tasty results every time. Steamed asparagus makes a delicious, healthy side to any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place 3 cups water in the bottom half of a steamer pan set. Add butter and salt and bring to a boil."
    },
    {
      "position": 3,
      "text": "Trim dry ends off of asparagus. If spears are thick, peel them lightly with a vegetable peeler."
    },
    {
      "position": 4,
      "text": "Place asparagus spears in the top half of the steamer pan set. Steam until asparagus is tender, 5 to 10 minutes depending on thickness."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0c63f279-3d9b-567c-9e56-a3c1f9f5c584",
  "slug": "sausage-stuffed-piquillo-peppers",
  "name": "Sausage-Stuffed Piquillo Peppers",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's sausage-stuffed piquillo peppers pair the sweet taste of the peppers with spicy chorizo sausage.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Brush a baking dish with 1 tablespoon olive oil."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a skillet over medium-high heat. Saute sausage, green onion, and a pinch of salt in hot oil until meat is browned and crumbly and onion is translucent, 5 to 7 minutes. Remove from heat and cool for 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix rice, goat cheese, egg, 2 tablespoons parsley, garlic, cumin, 1 teaspoon blood orange zest, and cayenne pepper together in a bowl. Spoon rice mixture into each pepper. Place stuffed peppers in a single layer in the prepared baking dish. Scatter almonds over the top, drizzle with 1 teaspoon olive oil, and sprinkle with salt."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until stuffed peppers are heated through and filling is hot, 15 to 20 minutes. Drizzle 1 tablespoon blood orange juice, remaining 1 teaspoon olive oil, and remaining parsley over the top."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

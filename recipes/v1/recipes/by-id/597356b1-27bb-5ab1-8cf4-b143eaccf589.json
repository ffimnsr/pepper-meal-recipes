  "id": "597356b1-27bb-5ab1-8cf4-b143eaccf589",
  "slug": "cherry-crunch-cake",
  "name": "Cherry Crunch Cake",
  "recipe_type": "dessert",
  "brief_description": "Cherry pie filling is topped with buttery cake mix crumbles in this quick and easy 3-ingredient crunch cake that's great for birthdays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread cherry pie filling in a 9x12-inch glass dish."
    },
    {
      "position": 3,
      "text": "Pour cake mix into a large bowl. Stir in butter slowly until mixture is crumbly. Sprinkle crumbly mixture over cherry pie filling."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top is golden, 30 to 32 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

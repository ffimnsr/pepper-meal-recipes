  "schema_version": 1,
  "id": "5221fdd3-c61f-5d35-ab7c-e2e5014dbafe",
  "slug": "frosty-strawberry-squares",
  "name": "Frosty Strawberry Squares",
  "recipe_type": "dessert",
  "brief_description": "Strawberry fluff is frozen on a sweet walnut crust before cutting into squares to serve. Enjoy this treat on a hot summer day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "Line a rimmed baking sheet with aluminum foil. In a bowl, stir together the flour, brown sugar, walnuts and melted butter. Toast in the oven until walnuts are fragrant, about 15 minutes; stir occasionally. Sprinkle 2/3 of the walnut mixture evenly over the bottom of the 9x13 inch dish."
    },
    {
      "position": 3,
      "text": "In a large bowl, whip the egg whites with the lemon juice until they can hold a soft peak. Gradually add white sugar while continuing to whip to firm peaks. Fold in the strawberries."
    },
    {
      "position": 4,
      "text": "In a separate bowl, whip the cream with an electric mixer until stiff but not grainy. Fold into the strawberry mixture. Spoon over the crust in the dish and spread evenly. Top with the remaining walnut mixture. Freeze for 6 hours, or overnight."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

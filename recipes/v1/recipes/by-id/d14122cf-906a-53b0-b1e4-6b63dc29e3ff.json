  "slug": "dirty-soda-icebox-pie-recipe-12035801",
  "name": "Dirty Soda Icebox Pie",
  "recipe_type": "dessert",
  "brief_description": "This dirty soda-inspired icebox pie is a light, fluffy, no-bake pie with sweet and creamy cherry cola flavor in a graham cracker crust. Garnish each slice with a dollop of whipped topping and a maraschino cherry, and \u201cthis might be the easiest dessert you make all year.\u201d Inspired by @kyraskitchenofficial\u2019s creation on TikTok.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fold whipped topping and cola together in a large bowl until well combined. Gently whisk in pudding mix until smooth."
    },
    {
      "position": 2,
      "text": "Pour pie filling into pie crust and smooth the top. Place pie into the freezer until set, at least 4 hours or overnight."
    },
    {
      "position": 3,
      "text": "To serve, garnish each slice with a spoonful of whipped topping and a cherry. Keep pie in the freezer when not serving."
    }
  ],
  "servings": 8,

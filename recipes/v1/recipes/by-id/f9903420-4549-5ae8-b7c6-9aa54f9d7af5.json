  "id": "f9903420-4549-5ae8-b7c6-9aa54f9d7af5",
  "slug": "meat-and-veggie-stromboli",
  "name": "Meat and Veggie Stromboli",
  "recipe_type": "main",
  "brief_description": "This meat and veggie stromboli recipe is made with refrigerated bread dough and is filled with pepperoni, Virginia ham, vegetables, and two cheeses.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place thawed bread dough in a bowl in a warm area; let rise until doubled in size, 30 to 60 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Spread dough into a large rectangle on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Combine egg yolks, 2 tablespoons Parmesan cheese, 2 tablespoons vegetable oil, parsley, oregano, garlic powder, and black pepper in a bowl; spread mixture onto dough. Top with pepperoni, ham, and provolone."
    },
    {
      "position": 5,
      "text": "Heat 2 teaspoons vegetable oil in a skillet over medium heat. Add bell pepper, onion, and mushrooms; cook and stir until tender, 5 to 10 minutes. Spoon over provolone layer."
    },
    {
      "position": 6,
      "text": "Roll dough around filling; place stromboli, seam side-down, onto the baking sheet. Beat egg whites in a small bowl; brush on stromboli top. Sprinkle with 1 teaspoon Parmesan cheese and Italian seasoning."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until dough is golden brown, 30 to 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

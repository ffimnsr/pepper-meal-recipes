  "id": "54558f1f-1a25-55e8-a14f-1dc4128ebb1a",
  "slug": "guatemalan-rice",
  "name": "Guatemalan Rice",
  "recipe_type": "side",
  "brief_description": "Rice is a staple Guatemalan food, and this easy side dish gets flavor from tomato, onion, carrot, and celery. It\u2019s a fixture on most Guatemalan tables.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add rice, onion, and tomato; cook and stir until rice turns light golden brown, 3 to 4 minutes."
    },
    {
      "position": 2,
      "text": "Stir water, carrot, celery, and chicken bouillon into the skillet. Simmer until most of the water is absorbed, about 8 minutes. Cover and simmer until rice is tender, 5 to 8 minutes more."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,

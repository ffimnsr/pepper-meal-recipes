  "slug": "creme-de-vie",
  "name": "Creme de Vie",
  "recipe_type": "drink",
  "brief_description": "A yummy drink that is perfect for the holidays. Egg yolks are blended with sugar syrup and evaporated milk, then flavored with rum and vanilla. One sip and you'll be hooked.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan, combine water and sugar. Bring to a boil and cook for 3 minutes."
    },
    {
      "position": 2,
      "text": "Place egg yolks in a blender and process on high speed. Slowly pour in the hot sugar water while blending (pouring too fast might curdle the yolks.) Add condensed milk, rum and vanilla. Blend until smooth. Chill in refrigerator."
    }
  ],

  "id": "71096288-0a33-5cb2-9307-e2901bad3cdc",
  "slug": "potato-soup-with-hash-browns",
  "name": "Hash Brown Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This hash brown potato soup is easy to make with frozen hash browns, condensed soup, cheese, bacon, and green onions — it's like a loaded baked potato in a bowl!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place hash browns into a slow cooker. Add chicken broth, condensed soup, potato, onion, and pepper. Cover and cook on Low until potatoes are tender and soup is hot, 3 to 5 hours."
    },
    {
      "position": 2,
      "text": "Drop in softened cream cheese and stir with a whisk until melted and mixed in. Ladle into bowls and garnish with Cheddar, bacon bits, and green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 185,

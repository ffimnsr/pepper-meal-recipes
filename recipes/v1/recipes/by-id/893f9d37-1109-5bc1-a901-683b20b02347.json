  "id": "893f9d37-1109-5bc1-a901-683b20b02347",
  "slug": "fabulous-fig-scones",
  "name": "Fabulous Fig Scones",
  "recipe_type": "breakfast",
  "brief_description": "This fabulous fig scone recipe is made with fresh figs, whole wheat flour, and rolled oats for a quick, easy, and delightful breakfast or brunch treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper; lightly sprinkle with flour."
    },
    {
      "position": 2,
      "text": "Whisk 1 cup whole wheat flour, oats, baking powder, and salt together in a large bowl. Whisk oil and egg together in a separate bowl until smooth; whisk in honey. Stir oil mixture into flour mixture until just moistened. Toss figs and sugar together in a bowl to coat; fold into dough until evenly distributed."
    },
    {
      "position": 3,
      "text": "Place dough in center of the prepared baking sheet; shape into a 7-inch circle."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Score dough into 8 pieces; continue baking until scones are cooked through and lightly browned on top, about 20 minutes more. Cut into 8 scones; slide every other scone back from center to allow cooling."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "5c3005a7-bcf2-5abd-865f-0c14fe3690eb",
  "slug": "vareniki-russian-pierogi-with-potatoes-and-mushrooms",
  "name": "Vareniki (Pierogi) with Potatoes and Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Vareniki are traditional pierogi or dumplings that are stuffed with a vegetarian filling of potatoes, onion, and fried mushrooms .",
  "cuisine": "Russian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 25 minutes. Drain potatoes and mash; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Combine flour and 1 teaspoon salt in a large bowl while potatoes are cooking. Stir sour cream and baking soda together in a second bowl. Add water to flour mixture and blend in, followed by sour cream mixture. Knead into a smooth dough, cover with plastic wrap, and refrigerate for 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium heat and cook onions until browned, 5 to 10 minutes. Add mushrooms and cook until browned, about 5 minutes. Add to mashed potatoes."
    },
    {
      "position": 4,
      "text": "Divide dough into 4 portions and roll each portion into a 1 1/2-inch thick rope. Cut ropes into small 1/2-inch pieces. Press each dough piece into a small flat circle and place 1 teaspoon of potato filling in the center. Fold dough over into a half-moon shape and seal edges."
    },
    {
      "position": 5,
      "text": "Bring a large pot of salted water to a gentle boil. Add the vareniki in batches and cook until they float to the surface, about 3 minutes. Cook for 2 to 3 minutes more. Remove with a slotted spoon and place in a colander to drain."
    }
  ],
  "servings": 45,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

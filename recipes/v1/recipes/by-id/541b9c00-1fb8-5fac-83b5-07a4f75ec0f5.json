  "id": "541b9c00-1fb8-5fac-83b5-07a4f75ec0f5",
  "slug": "the-best-ever-classic-jewish-noodle-kugel",
  "name": "The Best Ever Classic Jewish Noodle Kugel",
  "recipe_type": "dessert",
  "brief_description": "This best ever classic Jewish noodle kugel recipe is Jewish soul food at its best. It only requires 7 ingredients, is easy to prepare, and smells great.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until slightly firm to the bite, about 5 minutes. Drain well."
    },
    {
      "position": 3,
      "text": "Place noodles in a large bowl; stir in margarine until melted. Stir in applesauce, sugar, eggs, and vanilla extract; transfer to a 9x13-inch baking pan. Sprinkle with cinnamon. Cover the pan with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes. Uncover; continue baking until golden brown, 20 to 30 minutes more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

  "slug": "chicken-seasoning-blend",
  "name": "Chicken Seasoning Blend",
  "recipe_type": null,
  "brief_description": "DIY chicken seasoning? It's easy! This go-to recipe blends herbs and spices you probably have on hand. It's irresistible on poultry and much more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix salt, basil, rosemary, garlic powder, mustard powder, paprika, black pepper, thyme, celery seed, parsley, cumin, cayenne pepper, and chicken bouillon together in a small bowl until blended."
    },
    {
      "position": 3,
      "text": "Use immediately or store in an airtight container for future use."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

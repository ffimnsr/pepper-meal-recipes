  "schema_version": 1,
  "id": "28b1fa92-6914-59be-b0bf-0714dd44a90f",
  "slug": "tender-pan-fried-chicken-breasts",
  "name": "Tender Pan-Fried Chicken Breasts",
  "recipe_type": "main",
  "brief_description": "This pan-fried chicken is coated in spices, pan-seared until golden brown, then baked until moist and tender for a delicious family weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line 2 baking trays with aluminum foil; set aside."
    },
    {
      "position": 2,
      "text": "Stir together flour, salt, pepper, tarragon, ginger, mustard powder, thyme, garlic powder, and oregano in a shallow bowl until well-blended. Beat together egg and milk in a separate bowl until smooth."
    },
    {
      "position": 3,
      "text": "Dredge chicken breasts in flour mixture, shake off excess, then dip in egg, and again in flour. Place coated chicken breasts on one of the prepared baking trays; set aside to rest for 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Dredge chicken breasts in flour once more; shake off excess."
    },
    {
      "position": 6,
      "text": "Heat vegetable oil in a skillet over medium-high heat. Cook chicken breasts in hot oil until golden brown, 2 to 3 minutes per side. Place fried chicken breasts on the second prepared baking tray."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until no longer pink in the center and the juices run clear, about 20 to 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 8,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

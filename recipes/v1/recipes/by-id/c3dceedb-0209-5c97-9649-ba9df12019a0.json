  "schema_version": 1,
  "id": "c3dceedb-0209-5c97-9649-ba9df12019a0",
  "slug": "instant-pot-make-ahead-breakfast-burritos",
  "name": "Instant Pot\u00ae Make-Ahead Breakfast Burritos",
  "recipe_type": "breakfast",
  "brief_description": "Use silicone trays and your Instant Pot\u00ae to prep a large batch of breakfasts burritos ahead of time and freeze for busy mornings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray ice cube trays with nonstick cooking spray. Divide bacon, Cheddar cheese, bell pepper, and green onions among the molds."
    },
    {
      "position": 2,
      "text": "Whisk eggs, half-and-half, salt, and pepper together in a measuring glass with a pour spout. Slowly pour egg mixture into the molds until they are full but not overflowing. Spray foil sheets with cooking spray and seal each mold individually."
    },
    {
      "position": 3,
      "text": "Pour 1 1/4 cups water into the bottom of a multi-functional pressure cooker (such as Instant Pot\u00ae) and place a trivet inside. Carefully stack all 3 molds on top of the trivet."
    },
    {
      "position": 4,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 30 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Unlock and remove the lid. Transfer molds to a clean work surface, remove foil, and let sit for 5 minutes."
    },
    {
      "position": 6,
      "text": "Turn molds over to release the cooked filling. Place one in the center of each flour tortilla and roll into burritos. Let burritos cool. Wrap in parchment paper, place in a large resealable plastic bag, and freeze."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

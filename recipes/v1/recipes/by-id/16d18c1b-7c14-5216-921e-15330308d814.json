  "slug": "jamies-sweet-and-easy-corn-on-the-cob",
  "name": "Jamie's Sweet and Easy Corn on the Cob",
  "recipe_type": "dessert",
  "brief_description": "Corn on the cob is cooked in boiled water that's flavored with a little sugar and lemon juice to make the quickest, sweetest, juiciest corn.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot about 3/4 full of water and bring to a boil. Stir in sugar and lemon juice until sugar is dissolved."
    },
    {
      "position": 3,
      "text": "Gently place ears of corn into boiling water, cover the pot, turn off the heat, and let corn cook in the hot water until tender, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "slug": "fall-in-love-with-guacamole",
  "name": "Fall in Love (with) Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This guacamole will make anyone fall in love with avocados. A smooth dip made with avocados, lime juice, roma tomatoes, and cilantro is perfect for any occasion!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocados, sea salt, garlic powder, and lime juice in a bowl using a fork."
    },
    {
      "position": 2,
      "text": "Mix onion, tomatoes, and cilantro into avocado mixture; season with cayenne pepper."
    }
  ],
  "servings": 6,

  "id": "f794bdfd-21b3-52f8-b42d-247bd2b21d1b",
  "slug": "pork-carnitas-with-cilantro-tomatillo-sauce",
  "name": "Pork Carnitas with Cilantro Tomatillo Sauce",
  "recipe_type": "main",
  "brief_description": "Slow cooking blends the flavors in this pork carnitas sauce.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Cut pork into 1-inch cubes; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet or Dutch oven. Add pork, onions, garlic powder, chili powder, and chipotle chile powder; saut\u00e9 until browned, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Add enough water to barely cover pork; bring to a boil. Cover, reduce heat, and simmer 30 minutes. Remove the lid and continue to simmer until liquid has evaporated, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Combine chopped tomatillos, tomatoes, and cilantro in a small bowl."
    },
    {
      "position": 5,
      "text": "Place an equal amount of pork on each tortilla. Top with tomatillo salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "9bb2a580-4cde-5e1a-bfc7-6e9f7157f505",
  "slug": "baked-green-bean-bundles-recipe-11846688",
  "name": "Baked Green Bean Bundles",
  "recipe_type": "dessert",
  "brief_description": "These bacon-wrapped baked green bean bundles are glazed with a sweet-savory sauce, making an irresistible side dish for your holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment or foil and arrange bacon in a single layer."
    },
    {
      "position": 2,
      "text": "Bake bacon in the preheated oven until partially cooked yet still pliable, 8 to 10 minutes. Let cool until cool enough to handle. Leave the oven on."
    },
    {
      "position": 3,
      "text": "Wrap each piece of bacon around 6 to 8 green beans and secure with a toothpick. Place green bean bundles in a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Combine butter, Worcestershire, soy sauce, and brown sugar in a small saucepan over medium heat. Bring mixture to a simmer, stirring constantly until sugar is dissolved. Pour mixture over green beans and toss lightly to ensure each bundle is evenly coated."
    },
    {
      "position": 5,
      "text": "Bake bundles for 30 minutes, turning over halfway through, until sauce is thickened, green beans are tender, and bacon is fully cooked."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

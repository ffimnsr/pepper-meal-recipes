  "id": "3c30cc8e-a8bb-50c4-aa5d-11265e328c29",
  "slug": "pork-normandy",
  "name": "Pork Normandy",
  "recipe_type": "main",
  "brief_description": "Mom's pork Normandy recipe is a family favorite. Juicy pork tenderloin topped with onions and apples is drenched in a delicious sauce made with hard cider.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in an oven-proof skillet over medium heat. Sear tenderloin in melted butter, then transfer to a plate."
    },
    {
      "position": 3,
      "text": "Add onions to the skillet; cook and stir for 2 to 3 minutes. Stir in apple and cook until golden brown. Stir in flour and cook for about 30 seconds."
    },
    {
      "position": 4,
      "text": "Whisk chicken stock and hard cider together in a bowl; pour into the skillet and bring to a boil while scraping the browned bits of food off the bottom of the pan. Return tenderloin to the skillet; season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Cover the skillet, transfer to the preheated oven, and bake until is pork is slightly pink in the center, about 45 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Transfer tenderloin to a cutting board, and cut into 1 1/2-inch slices."
    },
    {
      "position": 7,
      "text": "Place onions, apples, and all liquid from the skillet into a blender or food processor; pulse until smooth. Return sauce to the pan, and reheat over medium-low. Stir in cream and heat until warm."
    },
    {
      "position": 8,
      "text": "Spoon sauce over sliced tenderloin to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

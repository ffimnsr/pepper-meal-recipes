{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7c79654d-6383-5551-8042-4a478fbc04c6",
  "slug": "best-stuffed-cabbage-rolls",
  "name": "Best Stuffed Cabbage Rolls",
  "recipe_type": "main",
  "brief_description": "Tender leaves of cabbage are wrapped around a hearty sirloin and rice filling in this family-friendly recipe for stuffed cabbage leaves.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Stir in 4 teaspoons salt. Remove loose, outer leaves from the cabbage and place in the boiling water for 1 minute. Remove from the water and set aside."
    },
    {
      "position": 2,
      "text": "Remove core from the cabbage and carefully place the head in the boiling water. Cook for 5 minutes, removing the outer leaves one at a time as they loosen every minute. Set aside 12 large leaves and reserve inner portion of the cabbage for another use."
    },
    {
      "position": 3,
      "text": "Heat oil in a medium saucepan over medium heat. Set aside 2 tablespoons minced onion for cabbage rolls; add remaining onion to the hot oil. Cook, stirring often, until translucent, about 2 minutes. Stir in tomato sauce, undrained diced tomatoes, water, vinegar, 1/2 teaspoon pepper, and 1/2 teaspoon salt; bring to a simmer. Reduce heat to low and cook for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Prepare cabbage rolls: Mix sirloin, rice, garlic, reserved minced onion, remaining 1 1/2 teaspoons salt, remaining pepper, and allspice together in a bowl until well combined."
    },
    {
      "position": 6,
      "text": "Place a softened cabbage leaf on a cutting board and remove the bottom, tough portion of the stem. Place about 3 tablespoons meat filling into the center of the leaf. Fold the sides inward and roll the leaf up tightly, like a burrito or spring roll. Repeat with remaining leaves and filling."
    },
    {
      "position": 7,
      "text": "Pour 1 cup tomato sauce mixture in a bottom of a 9x13-inch or 11x7-inch baking dish. Place cabbage rolls, seam-side down, in the baking dish and pour remaining sauce on top. Cover tightly with foil."
    },
    {
      "position": 8,
      "text": "Bake in preheated oven for 1 hour. Lightly squeeze a wedge of lemon over each serving and garnish with parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

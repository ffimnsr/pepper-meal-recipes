  "schema_version": 1,
  "id": "92120fc1-b3e6-56eb-b662-a161475111c5",
  "slug": "berry-galette",
  "name": "Berry Galette",
  "recipe_type": "dessert",
  "brief_description": "This rustic galette filled with juicy summer berries is an easy dessert you'll definitely want to serve with ice cream or whipped cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pulse flour, sugar, and salt together in a food processor. Add butter and cream cheese; pulse until mixture looks like wet sand."
    },
    {
      "position": 2,
      "text": "Sprinkle 1 tablespoon ice water over the mixture. Pulse until dough just starts to clump together; add a bit more water if it looks very dry."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a sheet of plastic wrap. Gather and gently press together into a cohesive ball. Use the wrap to press dough out into a thick disk. Wrap well and chill until firm, at least 1 hour and up to overnight."
    },
    {
      "position": 4,
      "text": "Line a baking sheet with parchment paper. Lightly dust a flat work surface with flour. Roll dough into a 12-inch circle, moving dough around frequently to prevent sticking. Trim edges if they look very rough. Fold up dough into quarters. Brush off excess flour and transfer to the baking sheet. Unfold gently."
    },
    {
      "position": 5,
      "text": "Refrigerate dough while preparing the filling."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 7,
      "text": "Combine berries, lemon juice, and vanilla extract in a large bowl. Mix sugar, cornstarch, and salt in a small bowl. Pour over berries and toss gently to combine."
    },
    {
      "position": 8,
      "text": "Remove dough from the refrigerator. Spread jam over the middle, leaving a thick border around the edges. Mound berries over the jam. Fold the edges of the dough over the berries and pleat it every few inches."
    },
    {
      "position": 9,
      "text": "Whisk egg and water together. Brush the border of the galette with the egg wash and sprinkle with turbinado sugar."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until crust is deep golden and juices are bubbling, 25 to 30 minutes. Check the underside of the galette is also browned. Transfer baking sheet to a wire rack and let cool before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

  "id": "0fd5276f-9db2-5e1f-b9f5-7f5eb37ef71c",
  "slug": "dried-beef-cheese-ball",
  "name": "Dried Beef Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This dried beef cheese ball is flavored with green onions and Worcestershire sauce, but you can add chopped olives, bacon bits, or whatever you like!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, dried beef, and green onions in a medium bowl. Mix until evenly blended."
    },
    {
      "position": 3,
      "text": "Stir in Worcestershire sauce, onion salt, and MSG (if using). Mix well until smooth."
    },
    {
      "position": 4,
      "text": "Form into a ball and refrigerate for at least 30 minutes before serving to firm up."
    },
    {
      "position": 5,
      "text": "Just before serving, roll in bacon bits and garnish with additional green onion, if desired."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

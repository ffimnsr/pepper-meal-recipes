  "slug": "red-cabbage-slaw-recipe-11935212",
  "name": "Red Cabbage Slaw",
  "recipe_type": "salad",
  "brief_description": "The key to this red cabbage salad with cucumber, green onion, and cilantro is the dressing. Toasted sesame oil, ginger, garlic, and soy sauce give the dressing an East Asian influence.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add olive oil, toasted sesame oil, rice vinegar, sugar, soy sauce, ginger paste, garlic paste, salt, chili paste, and sesame seeds to a jar with a lid. Whisk together and then cover. Store in the refrigerator until ready for use."
    },
    {
      "position": 2,
      "text": "Place cabbage, cucumber, green onions, and cilantro in a bowl. Toss and then drizzle dressing over by teaspoons. Toss and taste before adding more dressing."
    }
  ],
  "servings": 4,

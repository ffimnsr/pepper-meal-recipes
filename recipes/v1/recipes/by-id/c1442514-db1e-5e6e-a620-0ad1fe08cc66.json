  "id": "c1442514-db1e-5e6e-a620-0ad1fe08cc66",
  "slug": "orange-vinaigrette-dressing",
  "name": "Orange Vinaigrette Dressing",
  "recipe_type": "salad",
  "brief_description": "This orange dressing for spinach salad is made with orange juice and grated orange peel, adding a strong citrus flavor to this homemade vinaigrette.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine parsley, orange juice, honey, olive oil, white wine vinegar, grated orange peel, salt, and cayenne pepper in a blender, and pulse until blended. Refrigerate mixture 4 hours for the best flavor. Shake gently just before serving."
    }
  ],
  "servings": 6,

  "id": "cd03405e-0b0e-50c9-a1b3-4882e2d83023",
  "slug": "pad-thai-with-tofu",
  "name": "Pad Thai with Tofu",
  "recipe_type": "main",
  "brief_description": "This is a vegetarian recipe for Pad Thai: tangy-spicy flavors of tamarind and sriracha tossed with rice noodles and tofu, topped with peanuts.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Coat tofu with cornstarch in a bowl. Heat 2 tablespoons vegetable oil in a wok or large skillet over medium heat; fry tofu until lightly browned on all sides, 1 to 2 minutes per side."
    },
    {
      "position": 2,
      "text": "Place noodles in a bowl and pour in enough boiling water to cover; soak until softened, about 3 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Combine water, sriracha, soy sauce, sugar, tamarind concentrate, and red pepper flakes in a saucepan over low heat. Cook and stir sauce until flavors blend, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon vegetable oil in a wok over medium-high heat. Add tofu, noodles, and sliced onion; cook and stir until tofu is golden brown; about 3 minutes. Stir in sauce gradually until noodles are well-coated."
    },
    {
      "position": 5,
      "text": "Push noodle mixture to one side of the wok. Crack egg onto opposite side of wok; stir until beginning to set, 30 seconds to 1 minute. Stir egg into noodles gently. Garnish with green onions, peanuts, and lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

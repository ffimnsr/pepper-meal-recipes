  "id": "ef4f7ac0-060e-5619-b9d2-56cef67733bb",
  "slug": "pierogi-dough",
  "name": "Pierogi Dough",
  "recipe_type": "main",
  "brief_description": "A simple dough of flour, salt, oil, baking powder, egg and water yields plenty of pierogi wrappers, ready to be stuffed with the filling of your choice.",
  "cuisine": "Ukrainian Polish",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl mix together the flour, salt, and baking powder. Make a well in the center."
    },
    {
      "position": 2,
      "text": "In a separate bowl mix together the vegetable oil, warm water, and beaten egg. Pour into the well of the dry ingredients. Knead dough for 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Cover dough and let rest for 2 hours. Roll out and fill as desired."
    }
  ],
  "servings": 30,

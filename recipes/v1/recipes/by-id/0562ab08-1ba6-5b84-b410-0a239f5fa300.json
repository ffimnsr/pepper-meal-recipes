  "schema_version": 1,
  "id": "0562ab08-1ba6-5b84-b410-0a239f5fa300",
  "slug": "true-italian-porcini-mushroom-risotto",
  "name": "True Italian Porcini Mushroom Risotto",
  "recipe_type": "main",
  "brief_description": "This traditional risotto flavored with porcini mushrooms, white wine, butter and Parmesan cheese is as classically Italian as you can get.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place porcini mushrooms in a bowl and cover with hot water. Let soak until soft, about 1 hour. Drain, reserving soaking liquid. Squeeze mushrooms to remove excess water and roughly chop."
    },
    {
      "position": 2,
      "text": "Bring beef stock to a boil in a saucepan. Reduce heat to low and cover to keep warm."
    },
    {
      "position": 3,
      "text": "Heat 3 tablespoons oil in a skillet over medium heat. Add garlic cloves; cook until fragrant, about 2 minutes. Add mushrooms; cook and stir until soft, 5 to 6 minutes. Season with rosemary, salt, and pepper. Discard garlic cloves; pour in 1/2 cup wine. Increase heat to medium-high and simmer until wine reduces, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon oil with 2 tablespoons butter in a saucepan over medium-low heat. Cook and stir shallot until soft, about 3 minutes. Cook and stir Arborio rice until toasted and fragrant, about 3 minutes. Pour in remaining 1/2 cup wine. Simmer until wine is absorbed, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Ladle 1/3 of the warm stock into the saucepan; cook and stir until absorbed. Ladle in remaining stock and reserved soaking liquid in small amounts and cook, stirring constantly, until risotto is tender and creamy, 15 to 18 minutes."
    },
    {
      "position": 6,
      "text": "Remove risotto from the heat; stir in remaining 2 tablespoons butter and Parmesan cheese. Let stand for 3 to 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 39,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

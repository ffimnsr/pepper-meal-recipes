  "id": "3a59b1f7-280e-5a54-90d2-7f3056dbd0b5",
  "slug": "fresh-watermelon-gazpacho",
  "name": "Fresh Watermelon Gazpacho",
  "recipe_type": "soup",
  "brief_description": "This fresh watermelon gazpacho recipe with cucumber, jalape\u00f1o, blueberries, and a touch of red wine vinegar is a tweak on the usual gazpacho recipe.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place 6 cups watermelon, \u00bd cucumber, jalape\u00f1o, and vinegar in a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Transfer gazpacho to a large bowl; stir in remaining 2 cups watermelon and remaining \u00bd cucumber. Refrigerate until chilled, at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Divide gazpacho among 4 bowls; top servings with blueberries."
    }
  ],
  "servings": 4,

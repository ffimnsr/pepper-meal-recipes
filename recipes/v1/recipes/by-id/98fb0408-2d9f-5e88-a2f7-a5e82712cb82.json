  "slug": "cabbage-and-broccoli-slaw-with-vinegar-dressing",
  "name": "Cabbage and Broccoli Slaw with Vinegar Dressing",
  "recipe_type": "salad",
  "brief_description": "This cabbage and broccoli slaw with vinegar dressing recipe includes a zesty dressing, broccoli, cabbage, tomatoes, scallions, almonds, and cranberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage, broccoli coleslaw mix, and tomatoes in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk vinegar, oil, sugar, salt, garlic powder, and black pepper together in a small bowl until combined; pour over coleslaw and toss to coat. Stir in scallions, cranberries, and almonds. Cover with plastic wrap and refrigerate until flavors meld, 8 hours to overnight."
    }
  ],
  "servings": 4,

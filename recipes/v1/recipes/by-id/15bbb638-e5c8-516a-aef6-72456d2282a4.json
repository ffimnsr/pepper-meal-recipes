  "id": "15bbb638-e5c8-516a-aef6-72456d2282a4",
  "slug": "apple-style-omelets",
  "name": "Apple Style Omelets",
  "recipe_type": "breakfast",
  "brief_description": "You'll be surprised how wonderful sauteed apples and eggs taste together! Serve warm with apple butter or maple syrup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet or frying pan, melt butter over medium heat. Add apples and saute until tender but not completely cooked."
    },
    {
      "position": 2,
      "text": "Heat a lightly oiled omelet pan or medium sized skillet. Whisk together eggs, cream, salt, pepper and sugar. Pour egg mixture into omelet pan. When bottom of omelet has begun to set, place half of the apple mixture on top of the eggs."
    },
    {
      "position": 3,
      "text": "When bottom of omelet is completely cooked, fold over omelet, cover and cook through. Serve warm with remaining apples on top or on the side."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

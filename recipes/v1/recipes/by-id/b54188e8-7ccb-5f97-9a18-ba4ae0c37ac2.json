  "id": "b54188e8-7ccb-5f97-9a18-ba4ae0c37ac2",
  "slug": "southern-spicy-fried-chicken",
  "name": "Southern Spicy Fried Chicken",
  "recipe_type": "main",
  "brief_description": "This spicy fried chicken recipe with a peppery buttermilk coating is finger-licking good! It\u2019s a must-try that\u2019s guaranteed to please.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle chicken pieces with salt and pepper; place them in a deep-sided baking dish."
    },
    {
      "position": 2,
      "text": "Whisk buttermilk, hot pepper sauce, and 1 teaspoon cayenne pepper together in a large bowl; pour over chicken, tossing to coat all sides. Cover the dish with plastic wrap; marinate in the refrigerator for about 2 hours."
    },
    {
      "position": 3,
      "text": "Remove chicken from buttermilk mixture; shake off excess. Discard remaining buttermilk mixture."
    },
    {
      "position": 4,
      "text": "Place flour, 1 tablespoon cayenne pepper, garlic powder, paprika, salt, and pepper in a large resealable plastic bag; shake well to combine. Place 2 or 3 pieces of chicken at a time into the plastic bag and shake well to coat chicken pieces with seasoned flour."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Gently place chicken pieces into hot oil and fry until chicken is cooked through and golden brown, about 8 to10 minutes for breasts and wings, and 13 to 15 minutes for thighs and drumsticks. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Drain fried chicken on paper towels."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

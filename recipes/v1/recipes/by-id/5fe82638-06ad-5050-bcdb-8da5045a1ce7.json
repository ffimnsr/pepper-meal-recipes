  "id": "5fe82638-06ad-5050-bcdb-8da5045a1ce7",
  "slug": "grilled-pineapple-upside-down-cake",
  "name": "Grilled Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "These individual grilled pineapple upside-down cakes are a great dessert for your next BBQ party. Using store-bought shortcake makes for easy prep.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat."
    },
    {
      "position": 2,
      "text": "Place a 12x12-inch sheet of aluminum foil onto a work surface. Spoon brown sugar and butter onto the center of the foil. Arrange pineapple ring over brown sugar mixture and place cherry in the center. Top pineapple ring with inverted shortcake shell. Fold the foil around cake to form a packet."
    },
    {
      "position": 3,
      "text": "Grill the packet sugar-side down on the preheated grill until sugar is caramelized and cake is heated through, about 12 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

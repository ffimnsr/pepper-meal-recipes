  "slug": "rotisserie-chicken-salad",
  "name": "Rotisserie Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy rotisserie chicken salad with hard-boiled eggs, pickle relish, and mayo is easy to prep for a flavorsome salad for summer parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, onion, eggs, pickle relish, mustard, paprika, and red pepper flakes in a bowl; stir in mayonnaise by spoonfuls until mixture holds together but isn't too moist. Season with salt and pepper."
    }
  ],

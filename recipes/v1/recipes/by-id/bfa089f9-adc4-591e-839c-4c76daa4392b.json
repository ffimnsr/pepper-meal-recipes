  "id": "bfa089f9-adc4-591e-839c-4c76daa4392b",
  "slug": "boiled-chicken",
  "name": "Boiled Chicken",
  "recipe_type": "main",
  "brief_description": "This boiled chicken recipe is a basic recipe for tender, flavorful whole chicken cooked with onion, celery, carrot, and peppercorn for many uses.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken in a large pot with onion, carrots, celery, and peppercorns; add water to cover by 1 inch."
    },
    {
      "position": 3,
      "text": "Cover the pot and bring to a boil; reduce heat to a gentle boil and cook until meat falls off the bone, about 90 minutes."
    },
    {
      "position": 4,
      "text": "Remove chicken from the pot and let sit until cool enough to handle. Shred or chop meat."
    }
  ],

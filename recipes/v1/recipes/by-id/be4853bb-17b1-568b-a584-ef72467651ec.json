  "id": "be4853bb-17b1-568b-a584-ef72467651ec",
  "slug": "ricardos-pizza-crust",
  "name": "Ricardo's Pizza Crust",
  "recipe_type": null,
  "brief_description": "This herb laced pizza crust is mixed in the bread machine but baked in the oven. Add your favorite toppings to make a delicious main dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, olive oil, sugar, salt in pan of bread machine Add flour, then sprinkle garlic on flour. Lastly add yeast."
    },
    {
      "position": 2,
      "text": "Turn machine on dough cycle. As the dough mixes, sprinkle on oregano and basil until it suits you for color and taste. Let mix for about 15 to 30 minutes. Let the dough rest from 5 to 30 minutes. The longer it rests, the thicker and more tasty the crust. Meanwhile, preheat oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 3,
      "text": "Roll out dough on a lightly floured surface. Spray a large pizza pan with nonstick cooking spray. Place dough on pan and add your choice of pizza toppings."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until golden brown, about 12 to 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "dfa5940e-fb78-5d50-8580-f544478fdc4a",
  "slug": "buffalo-chicken-fingers",
  "name": "Buffalo Chicken Fingers",
  "recipe_type": "main",
  "brief_description": "These garlic-and-cayenne-stoked chicken breast morsels are baked instead of fried for a low fat version of Buffalo Wings.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (205 degrees C). Coat a baking sheet with a nonstick spray."
    },
    {
      "position": 2,
      "text": "In a bag, mix together flour, 1/2 teaspoon garlic powder, 1/2 teaspoon cayenne pepper, and 1/4 teaspoon salt. On a plate, mix the bread crumbs with the rest of the garlic powder, cayenne pepper, and salt."
    },
    {
      "position": 3,
      "text": "Shake the chicken pieces with the seasoned flour. Beat egg whites with 1 tablespoon water, and place egg mixture in a shallow dish or bowl. Dip seasoned chicken in egg mixture, then roll in the seasoned bread crumb mixture. Place on prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake for about 8 minutes in the preheated oven. Use tongs to turn pieces over. Bake 8 minutes longer, or until chicken juices run clear."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

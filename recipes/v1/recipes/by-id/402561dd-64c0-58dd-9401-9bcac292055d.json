  "id": "402561dd-64c0-58dd-9401-9bcac292055d",
  "slug": "mexican-corn-on-the-cob-elote",
  "name": "Mexican Corn on the Cob (Elote)",
  "recipe_type": "side",
  "brief_description": "Elote, or Mexican corn on the cob, is made by rolling charred grilled corn in butter, mayo, and cotija cheese\u2014just like street vendors do in Mexico!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat."
    },
    {
      "position": 3,
      "text": "Grill corn on the preheated grill until hot and lightly charred all over, 7 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Roll corn in melted butter, then spread evenly with mayonnaise. Sprinkle with cotija cheese."
    },
    {
      "position": 5,
      "text": "Serve with lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "ee2fbbe8-011f-53d2-b940-54123e846b31",
  "slug": "boeuf-bourguignon",
  "name": "Boeuf Bourguignon",
  "recipe_type": "soup",
  "brief_description": "Lean beef is cooked low and slow with plenty of onions, mushrooms, and red wine to create this classic French stew, beef bourguignon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, heavy skillet over medium heat. Cook and stir onions in hot oil until tender, about 10 minutes. Transfer to a bowl."
    },
    {
      "position": 2,
      "text": "Cook and stir beef in the same skillet until browned, 1 to 2 minutes per side. Sprinkle flour, marjoram, thyme, and pepper over beef. Pour red wine and beef broth into the skillet; stir well. Reduce heat to low and simmer until beef is tender, 1 1/2 to 2 hours. Add more wine and broth as needed, in a 2:1 ratio, to keep beef barely submerged throughout the cooking time."
    },
    {
      "position": 3,
      "text": "Stir onions and mushrooms into the skillet. Cook, stirring occasionally, until mushrooms are tender and sauce is thick and dark brown, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 20,

  "id": "a2f8f860-820b-5ca2-b255-36a2153630e1",
  "slug": "artichoke-dip",
  "name": "Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This dip is good hot, cold, or room temperature. Serve it with tortilla chips or pita wedges and be sure to get your taste, because it doesn't last long at a party!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the artichoke hearts, mayonnaise, cheese and green chilies. Mix well and pour into a 2 quart casserole dish."
    },
    {
      "position": 3,
      "text": "Bake for 20 to 25 minutes or until lightly browned. Garnish with chopped green onions and chopped tomato if desired."
    }
  ],
  "servings": 15,

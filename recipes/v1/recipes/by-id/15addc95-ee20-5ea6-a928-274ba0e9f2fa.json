  "id": "15addc95-ee20-5ea6-a928-274ba0e9f2fa",
  "slug": "turkey-sausage-potato-brussels-sprouts-and-apple-hash-recipe-8690240",
  "name": "Turkey Sausage, Potato, Brussels Sprouts, and Apple Hash",
  "recipe_type": "breakfast",
  "brief_description": "Juicy apples, Brussels sprouts, and fragrant sage add flavor and flair to this hearty potato hash breakfast dish topped with a fried egg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil and butter in a large skillet over medium heat. Cook Brussels sprouts and potatoes, stirring occasionally, until browned and nearly tender, about 10 minutes. Transfer Brussels sprouts and potatoes to a medium bowl using a slotted spoon."
    },
    {
      "position": 2,
      "text": "Cook sausage and onion in same skillet, stirring and breaking up lumps, until sausage is lightly browned, about 6 minutes. Stir in sage, pepper, and salt."
    },
    {
      "position": 3,
      "text": "Return Brussels sprouts and potatoes to skillet. Stir in apple. Reduce heat to medium-low; cook, stirring occasionally, until apple is crisp-tender, about 8 minutes. Top each serving with a fried egg."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

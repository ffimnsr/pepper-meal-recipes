  "id": "a94a3a02-0c09-5f99-99a8-c870199f1b31",
  "slug": "carrot-cake-muffins",
  "name": "Carrot Cake Muffins",
  "recipe_type": "dessert",
  "brief_description": "These not-too-sweet carrot cake muffins are perfect for breakfast or an after-school snack. Top with cinnamon sugar before baking for a sweeter treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners."
    },
    {
      "position": 2,
      "text": "Beat milk, eggs, applesauce, and vanilla extract together in a bowl. Whisk flour, sugar, baking powder, cinnamon, and salt together in another bowl. Stir carrots into flour mixture; fold in milk mixture and butter until batter is just combined. Spoon batter into prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 18 to 20 minutes. Cool in the pan for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

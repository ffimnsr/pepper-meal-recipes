  "slug": "extra-easy-fudge",
  "name": "Extra Easy Fudge",
  "recipe_type": "dessert",
  "brief_description": "Extra-easy fudge doesn't get easier than this recipe that calls for only 3 ingredients.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line one 8x8 inch square pan with foil. Lightly butter the foil."
    },
    {
      "position": 2,
      "text": "In a small saucepan melt the chocolate chips over low heat, stirring constantly. Remove the melted chocolate from the heat and stir in the frosting and the nuts stirring until smooth. Pour into the prepared pan and refrigerate until firm. Once firm cut in small squares."
    }
  ],

  "id": "fd93c269-1c16-549b-9f5c-2eb4086e5874",
  "slug": "old-fashioned-potato-cakes",
  "name": "Old-Fashioned Potato Cakes",
  "recipe_type": "appetizer",
  "brief_description": "These potato cakes are super easy to make for a tasty side to any meal. If you've got leftover mashed potatoes \u2014 they're ready in just 20 minutes!",
  "cuisine": "American Irish Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix mashed potatoes, flour, onion, egg, black pepper, and salt in a bowl until well combined, similar to a batter consistency."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a skillet over medium heat. Drop 4-inch circles of batter into the hot oil. Cook until golden brown, about 4 to 5 minutes per side."
    },
    {
      "position": 4,
      "text": "Drain on paper towels. Repeat with any remaining batter. Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

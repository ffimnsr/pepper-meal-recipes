  "slug": "3-ingredient-chocolate-cherry-dump-cake-recipe-11729922",
  "name": "3-Ingredient Chocolate Cherry Dump Cake",
  "recipe_type": "dessert",
  "brief_description": "This 3-ingredient chocolate cherry dump cake could not be easier! You only need pie filling, chocolate cake mix, and butter!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Pour pie filling into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Spread cake mix evenly over the pie filling, taking care not to mix it into the fruit. Top evenly with butter slices."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly golden brown and bubbly, about 45 minutes. Let stand at least 5 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

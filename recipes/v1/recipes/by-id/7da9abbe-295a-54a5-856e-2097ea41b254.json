  "id": "7da9abbe-295a-54a5-856e-2097ea41b254",
  "slug": "down-home-baked-beans",
  "name": "Down Home Baked Beans",
  "recipe_type": "side",
  "brief_description": "Chili sauce is the secret ingredient in these beans baked with bacon, onion and brown sugar. This recipe can also be prepared in a slow cooker, if desired.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl combine beans, chili sauce, onion, brown sugar and bacon. Pour into a 9x13 inch casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 45 minutes to 1 hour."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 11,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 10,

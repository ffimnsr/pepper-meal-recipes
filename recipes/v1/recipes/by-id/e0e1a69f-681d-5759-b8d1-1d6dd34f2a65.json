  "id": "e0e1a69f-681d-5759-b8d1-1d6dd34f2a65",
  "slug": "sparkling-pb-and-j-sidecars-recipe-8691881",
  "name": "Sparkling PB&J Sidecars",
  "recipe_type": "appetizer",
  "brief_description": "These sparkling PB&J sidecars inspired by the classic PB&J, feature peanut butter whiskey and raspberry liqueur. Top it off with sparkling water for an effervescent cocktail with a hint of nostalgia.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread sugar on a small plate. Rub rims of 2 cocktail glasses with lemon wedge. Dip rims in sugar to coat."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker half full with ice. Add whiskey, lemon juice, orange liqueur, and raspberry liqueur. Cover and shake until outside of shaker is frosted, about 60 seconds. Strain into prepared glasses. Top each cocktail with 1 1/2 ounces sparkling water and garnish with a raspberry."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

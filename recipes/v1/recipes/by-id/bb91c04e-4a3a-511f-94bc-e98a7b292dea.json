  "id": "bb91c04e-4a3a-511f-94bc-e98a7b292dea",
  "slug": "peanut-butter-oatmeal-protein-cookies-recipe-11945403",
  "name": "Peanut Butter Oatmeal Protein Cookies",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter oatmeal protein cookies strike the perfect balance between indulgent and wholesome. Made with peanut butter powder and protein powder, they deliver a satisfying boost of protein without sacrificing the classic peanut butter cookie flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a small glass bowl in the microwave, then set aside to cool slightly."
    },
    {
      "position": 2,
      "text": "Stir oats, protein powder, peanut butter powder, flour, baking soda, and salt together in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Stir brown sugar, sugar, melted butter, peanut butter, egg, Greek yogurt, and vanilla until smooth. Stir flour mixture into egg mixture to form a dough that is soft but holds together. If needed, add milk, 1 teaspoon at a time."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate dough for 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 6,
      "text": "Scoop dough (about 2 tablespoons per cookie) and flatten slightly."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until edges are set and lightly golden; centers will look slightly underdone, 9 to 11 minutes."
    },
    {
      "position": 8,
      "text": "Let cool for 10 minutes on the pan before moving\u2014edges should be crisp, and the centers chewy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

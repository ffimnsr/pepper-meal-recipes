  "id": "bea6220c-585d-53b7-9c88-9fe82e630e40",
  "slug": "turkey-taco-skillet-lasagna-recipe-12002226",
  "name": "Turkey Taco Skillet Lasagna",
  "recipe_type": "main",
  "brief_description": "This turkey taco skillet lasagna is a one-pot dinner, with ground turkey, salsa, black beans, and Monterey Jack cheese around lasagna noodles that cook right in the same skillet. It's family friendly, budget friendly, and also easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, deep skillet with a tight fitting lid over medium-high heat. Add turkey and onion and cook until meat is browned and crumbly, and the onion is soft, 5 to 7 minutes. Drain any excess liquid and return skillet to medium-high heat."
    },
    {
      "position": 2,
      "text": "Add taco seasoning, salsa, tomatoes, and beans, and stir to combine. Add water and cook, stirring occasionally, for about 3 minutes."
    },
    {
      "position": 3,
      "text": "Break up lasagna noodles into 4 or 5 pieces each and nestle them into the meat and sauce mixture. Reduce heat to medium-low, cover and simmer until the noodles are al dente, 20 to 25 minutes, stirring once or twice to ensure pasta cooks evenly and is coated in the sauce."
    },
    {
      "position": 4,
      "text": "Uncover and top with cheese. Turn off heat, replace the lid, and let stand for 5 minutes. Serve with desired toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "5760289f-0955-5529-837f-0866c6b11773",
  "slug": "simple-slow-cooker-jambalaya",
  "name": "Simple Slow Cooker Jambalaya",
  "recipe_type": "soup",
  "brief_description": "In this simple slow-cooker jambalaya recipe, smoky, spicy andouille sausage, chicken thighs, and shrimp cook up in a rice, vegetable, and spice mixture.",
  "cuisine": "American Creole Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, diced tomatoes, sausage, chicken broth, mirepoix, bell pepper, garlic, Cajun seasoning, thyme, and oregano in a slow cooker; cover. Cook on High until chicken is tender, 4 to 5 hours, stirring occasionally. Stir in rice and shrimp to combine during the last 30 minutes."
    },
    {
      "position": 2,
      "text": "Turn off slow cooker. Let stand, covered, to allow rice to absorb most of the remaining liquid, at least 15 minutes. Garnish with parsley."
    }
  ],
  "servings": 12,

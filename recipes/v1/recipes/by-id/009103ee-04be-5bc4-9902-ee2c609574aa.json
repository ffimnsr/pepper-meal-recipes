  "slug": "game-day-sangria",
  "name": "Game Day Sangria",
  "recipe_type": "drink",
  "brief_description": "This sangria recipe can be made quickly with lemon and orange juices, sugar, brandy, red wine, and club soda.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine lemon juice, orange juice, and sugar in a pitcher; stir until sugar has dissolved completely."
    },
    {
      "position": 2,
      "text": "Add red wine, club soda, and brandy to the pitcher. Serve in glasses with ice."
    }
  ],
  "servings": 8,

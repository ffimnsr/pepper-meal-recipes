  "id": "9be0f675-8b74-59ea-99fd-863acbcb87f5",
  "slug": "chef-johns-cauliflower-pizza-crust",
  "name": "Chef John's Cauliflower Pizza Crust",
  "recipe_type": null,
  "brief_description": "Make cauliflower pizza crust for all your gluten-free friends with Chef John's fantastic and delicious recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place cauliflower into a food processor; blend until finely ground."
    },
    {
      "position": 3,
      "text": "Cook cauliflower, water, and salt in a large skillet over medium-high heat until fragrant and most of the water is evaporated, 5 to 6 minutes. Cool completely."
    },
    {
      "position": 4,
      "text": "Transfer cauliflower to the center of a clean dish towel. Wrap and squeeze tightly to remove excess moisture. You should have about 1 1/2 cups cauliflower pulp."
    },
    {
      "position": 5,
      "text": "Stir together cauliflower pulp, egg, goat cheese, Parmigiano-Reggiano cheese, and cayenne pepper in a large bowl to form a soft dough. Gather into a ball and place in the center of the prepared baking sheet. Press dough into a circle, about 1/4-inch thick."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 40 minutes. Cool and turn crust over before topping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

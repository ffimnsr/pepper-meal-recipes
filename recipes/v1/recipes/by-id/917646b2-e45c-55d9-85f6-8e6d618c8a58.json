  "id": "917646b2-e45c-55d9-85f6-8e6d618c8a58",
  "slug": "root-beer-eggnog",
  "name": "Root Beer Eggnog",
  "recipe_type": "drink",
  "brief_description": "Eggnog gets a twist with this recipe that calls for root beer concentrate to be added to the classic Christmas beverage.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs in a pitcher until light and fluffy. Add milk, sugar, coffee creamer, vanilla extract, and nutmeg to eggs; beat until smooth. Refrigerate until slightly chilled, at least 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir root beer extract into egg mixture."
    }
  ],
  "servings": 7,

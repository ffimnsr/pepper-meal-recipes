  "id": "5cbb2eb5-3111-59ea-9d60-87777ea69da7",
  "slug": "ferns-tuna-casserole",
  "name": "Fern's Tuna Casserole",
  "recipe_type": "soup",
  "brief_description": "Fern's tuna casserole has all the fixings for a night of comfort food just like grandma used to make. Potato chips sprinkled over bubbling egg noodles in cream of mushroom soup makes everyone happy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine mushroom soup, milk, and tuna in a saucepan over medium heat; cook until well blended and warmed through, about 5 minutes. Pour mixture into a 9x13-inch baking dish; add noodles and mix well. Top noodles with cheese food and sprinkle potato chips over cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until casserole is bubbling, 30 to 45 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

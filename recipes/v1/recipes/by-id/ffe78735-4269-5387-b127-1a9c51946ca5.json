  "schema_version": 1,
  "id": "ffe78735-4269-5387-b127-1a9c51946ca5",
  "slug": "zucchini-chip-nachos",
  "name": "Zucchini Chip Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Try something different with that zucchini in your crisper by turning it into nachos. After all, why should tortilla chips have all the fun?",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim ends of zucchini; use a mandoline on the thinnest setting to cut zucchini into 1/8-inch slices. Place slices on a plate lined with paper towels, top with additional paper towels, and press down to remove excess moisture."
    },
    {
      "position": 2,
      "text": "Place zucchini slices on a cutting board and lightly mist with cooking spray. Turn slices over and sprinkle with taco seasoning; lightly mist this side with cooking spray as well. Place slices seasoned-side up on a microwave-safe plate, making sure none are overlapping. Cook in the microwave on high power for 2 minutes and 30 seconds. Carefully flip slices over and cook 30 seconds more. Repeat with remaining zucchini."
    },
    {
      "position": 3,
      "text": "Divide chips between 2 microwave-safe plates. Add black olives, red onion, jalapeno peppers, and Cheddar cheese. Microwave on high power until cheese is melted, about 30 seconds."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "6fdc6f8d-dd19-5114-ac1a-acb1f75536ec",
  "slug": "wasabi-shrimp-sushi-cups-recipe-11695005",
  "name": "Wasabi Shrimp Sushi Cups",
  "recipe_type": "appetizer",
  "brief_description": "These wasabi shrimp sushi cups are shaped cups of sushi rice with carrot, cucumber, edamame, and shrimp, with a delicious wasabi aioli.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "For wasabi aioli; combine wasabi paste, soy sauce, and mayonnaise in a small, zippered food storage bag. Gently squeeze the bag to combine ingredients. Taste and add more wasabi paste, if desired. Seal the bag and refrigerate."
    },
    {
      "position": 2,
      "text": "Place about 1/8 cup cooked and cooled rice in each of 8 silicone muffin cups. Press rice firmly into the cup, using damp fingertips. Shape some of the rice up the sides of the cup. Refrigerate at least 20 minutes."
    },
    {
      "position": 3,
      "text": "To serve, fill rice cups with matchstick carrots, matchstick cucumbers, and edamame. Place one shrimp half on top of each filled cup."
    },
    {
      "position": 4,
      "text": "Snip the tip off 1 corner of wasabi aioli bag, and squeeze contents across the top of each filled cup. Sprinkle with black sesame seeds. Serve immediately with pickled ginger."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "2ba71430-88b5-56c8-b60e-590c5e1d119b",
  "slug": "bacon-egg-and-cheese-strata",
  "name": "Fluffy Egg Strata",
  "recipe_type": "breakfast",
  "brief_description": "Egg strata with fluffy layers of bread, bacon, and cheese; prepare the night before and bake in the morning for a deliciously savory breakfast or bunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients"
    },
    {
      "position": 2,
      "text": "Toss cubed bread, cheese, mushrooms, and bacon together in a large bowl; pour into a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Whisk eggs, half-and-half, and mustard together until smooth; pour evenly over bread mixture."
    },
    {
      "position": 4,
      "text": "You can bake the strata straightaway but for better results, cover the dish with plastic wrap and refrigerate overnight. When ready to bake, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove plastic wrap from the baking dish; bake strata in the preheated oven until eggs are set and top is golden brown, about 1 hour. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

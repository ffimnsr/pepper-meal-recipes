  "id": "23575fcd-0753-5644-bb05-5328c6426d82",
  "slug": "campbells-thai-tacos",
  "name": "CAMPBELL'S\u00ae Thai Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These lettuce cups are a fun, easy and delicious weeknight recipe. Substitute ground turkey for the pork if desired.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In large non-stick skillet, cook pork with ginger until pork is no longer pink, 5 to 7 minutes. Pour in broth and cook until reduced by about half, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in green onions, carrot, red pepper, and hoisin and cook just until vegetables are tender-crisp, about 5 minutes more."
    },
    {
      "position": 3,
      "text": "Serve pork mixture in lettuce leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

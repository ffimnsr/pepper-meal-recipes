  "id": "b83dee86-531a-5833-86d7-266ee22770b7",
  "slug": "roasted-veggie-pasta",
  "name": "Roasted Veggie Pasta",
  "recipe_type": "main",
  "brief_description": "Wonderful rustic Italian style pasta dish! Meal can be dressed up or down with accompaniments to this tasty pasta.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare asparagus by trimming woody base and cutting diagonally into 4 inch pieces."
    },
    {
      "position": 2,
      "text": "In a roasting pan, combine asparagus, bell pepper, mushrooms, roasted garlic and tomato. Sprinkle with rosemary and oregano, then drizzle with olive oil. Bake in preheated oven for 15 minutes."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain. Toss with Parmesan cheese, tapenade and roasted vegetables."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1e056bf0-4834-5997-99c0-185dde8a08bd",
  "slug": "miso-roasted-japanese-eggplant-recipe-11822808",
  "name": "Miso-Roasted Japanese Eggplant",
  "recipe_type": "side",
  "brief_description": "This miso-roasted Japanese eggplant is basted in a gingery miso glaze that packs a punch of flavor. The best part of cooking with Japanese eggplant is that the skin gets soft and there\u2019s no need to peel it. If you're not a fan of cilantro, garnish with scallions instead.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Whisk miso paste, sesame oil, rice vinegar, garlic, and ginger together in a small bowl until smooth."
    },
    {
      "position": 3,
      "text": "Place the halved eggplant on the baking sheet. Brush miso mixture over the eggplant."
    },
    {
      "position": 4,
      "text": "Bake eggplant in the preheated oven until tender and browned, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Transfer to a serving dish and garnish with sesame seeds and cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

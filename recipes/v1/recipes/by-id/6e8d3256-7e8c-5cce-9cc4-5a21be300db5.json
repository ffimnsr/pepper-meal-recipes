  "id": "6e8d3256-7e8c-5cce-9cc4-5a21be300db5",
  "slug": "amazing-oven-roasted-potatoes",
  "name": "Amazing Oven-Roasted Potatoes",
  "recipe_type": "side",
  "brief_description": "Oven-roasted potatoes are a super easy side dish that go well with any meal. This simple recipe uses just a few basic seasonings for fantastic flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Rinse potatoes and dry with a paper towel."
    },
    {
      "position": 3,
      "text": "Place potatoes into a large bowl with oil, seasoned salt, salt, and pepper; mix until well coated."
    },
    {
      "position": 4,
      "text": "Pour onto the prepared baking sheet and spread into an even layer."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, turning occasionally, until potatoes are tender and golden brown, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

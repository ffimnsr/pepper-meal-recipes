  "id": "c5ac007c-94d7-5c9a-9e7e-4d8f40dfd8e5",
  "slug": "easy-homemade-pie-crust",
  "name": "Easy Homemade Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "Chef John's pie crust recipe comes together quickly in a food processor and chills into two buttery, flaky discs\u2014perfect for sweet or savory pies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, butter, and salt in a food processor. Pulse until mixture resembles coarse crumbs, about 10 (1-second) pulses."
    },
    {
      "position": 2,
      "text": "Stir ice water and vinegar in a small bowl."
    },
    {
      "position": 3,
      "text": "Pour 1/2 of the ice water mixture into flour mixture; pulse to combine, about 3 (1-second) pulses. Pour in remaining ice water mixture; pulse until mixture starts to come together, about 8 (1-second) pulses."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a wooden surface, pat it into a circle, and divide it in half. Form each half into a disc, about 5-inches wide."
    },
    {
      "position": 5,
      "text": "Wrap each disc in plastic wrap and refrigerate for at least 30 minutes until ready to use."
    },
    {
      "position": 6,
      "text": "Use in your favorite pie recipe."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

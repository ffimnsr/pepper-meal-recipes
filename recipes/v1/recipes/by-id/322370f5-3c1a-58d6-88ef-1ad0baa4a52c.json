  "id": "322370f5-3c1a-58d6-88ef-1ad0baa4a52c",
  "slug": "italian-chicken-panini",
  "name": "Italian Chicken Panini",
  "recipe_type": "main",
  "brief_description": "This Italian chicken panini layers leftover chicken, pesto, and mozzarella cheese in between toasted slices of Italian bread for a perfect 10-minute lunch.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an electric grill (such as George Foreman\u00ae) for medium heat. Spread olive oil on one side of each bread slice."
    },
    {
      "position": 2,
      "text": "Place one slice of bread, oil-side down, on the preheated grill. Spread 1/2 of the pesto on the bread and put a slice of mozzarella cheese over top. Arrange chicken over the cheese and top with remaining mozzarella. Spread remaining pesto on the other slice of bread and place on top of the sandwich."
    },
    {
      "position": 3,
      "text": "Close the grill and cook until cheese is melted and bread is golden brown and crispy, about 4 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "4141138e-53d7-54f5-ae7c-e087b1bf1970",
  "slug": "dees-dark-chocolate-granola",
  "name": "Dee's Dark Chocolate Granola",
  "recipe_type": "breakfast",
  "brief_description": "This crunchy peanut butter and chocolate granola is great for breakfast, or any time that a chocolate craving hits.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish with aluminum foil and spray with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Melt together the brown sugar, peanut butter, honey, butter flavored spread, and vanilla extract in a small saucepan over low heat. Stir until well combined; remove from heat."
    },
    {
      "position": 3,
      "text": "Combine the oats, cinnamon, and salt in a large bowl. Pour the brown sugar mixture into bowl; stir well to combine. Stir in the chocolate chips, dried cranberries, and almonds. Spoon into the prepared pan; pat down and spread evenly."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until browned, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

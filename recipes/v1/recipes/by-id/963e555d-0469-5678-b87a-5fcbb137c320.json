  "id": "963e555d-0469-5678-b87a-5fcbb137c320",
  "slug": "big-bobs-big-brunch-quesadillas",
  "name": "Big Bob's Big Brunch Quesadillas",
  "recipe_type": "breakfast",
  "brief_description": "This big Bob's big brunch quesadillas recipe combines warm flour tortillas filled with eggs, saut\u00e9ed vegetables, and Cheddar cheese for a tasty meal.",
  "cuisine": "Mexican Inspired Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large nonstick skillet on medium heat; add onion, tomato, jalape\u00f1o, and cilantro. Cook and stir until tender."
    },
    {
      "position": 2,
      "text": "Add eggs; let cook until set. Flip and cook egg on the other side. Transfer egg mixture onto a plate."
    },
    {
      "position": 3,
      "text": "Heat tortillas in the skillet until warm. Place one tortilla on a plate, top with egg mixture and cheese; top with 1 tablespoon guacamole, 1 tablespoon sour cream, and a tortilla. Repeat with remaining ingredients."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

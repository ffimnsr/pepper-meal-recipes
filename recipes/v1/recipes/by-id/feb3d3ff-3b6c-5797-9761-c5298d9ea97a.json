  "id": "feb3d3ff-3b6c-5797-9761-c5298d9ea97a",
  "slug": "pecan-pie-iv",
  "name": "Simple Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "A rich, delicious, and easy pecan pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place pie shell into a 9-inch pie dish."
    },
    {
      "position": 2,
      "text": "Gently beat eggs in a large bowl. Beat in sugar and flour until combined. Mix in corn syrup, melted butter, and vanilla. Fold in pecans. Pour mixture into the prepared pie dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a knife inserted into the center of pie comes out clean, 50 to 60 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

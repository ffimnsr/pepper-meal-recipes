  "slug": "cacio-e-pepe-cauliflower-gratin-recipe-11825538",
  "name": "Cacio e Pepe Cauliflower Gratin",
  "recipe_type": "side",
  "brief_description": "This cacio e pepe cauliflower gratin recipe reinterprets the classic flavor duo of the Roman cheese and pepper pasta, in the form of a creamy cauliflower gratin",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 2-quart baking dish. Place cauliflower florets in the prepared baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Add onion and cook, stirring occasionally, until tender, about 5 minutes. Season with garlic, pepper, and salt. Cook and stir until fragrant, about 1 minute. Gradually stir in flour; cook and stir for 1 minute. Gradually add milk, stirring constantly; cook and stir until thickened and bubbly. Gradually stir in Pecorino and provolone cheeses until melted. Stir in lemon zest and lemon juice. Pour sauce over cauliflower in the baking dish."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, in the preheated oven until hot and bubbly, 25 to 30 minutes. Garnish with additional lemon zest and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "my-favorite-chicken-salad",
  "name": "My Favorite Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This savory chicken salad with crunchy celery and pecans mixed with mayonnaise, relish, mustard, garlic, and dill is delicious as is or on a sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together chicken, celery, pecans, mayonnaise, onion, relish, mustard, pepper, dill, lemon juice, sugar, salt, garlic powder, and paprika in a large bowl until well combined. Refrigerate for at least 1 hour before serving."
    }
  ],

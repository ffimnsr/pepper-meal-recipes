  "id": "87564a1b-9332-5e96-85bd-68afafda4db4",
  "slug": "strawberry-tiramisu-trifle",
  "name": "Strawberry Tiramisu Trifle",
  "recipe_type": "dessert",
  "brief_description": "Strawberries are layered with a sweet cream filling and coffee-soaked ladyfingers for a colorful strawberry tiramisu.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Stir instant coffee granules and water together in a bowl until dissolved. Let cool."
    },
    {
      "position": 2,
      "text": "Beat cottage cheese, cream, and confectioners' sugar together in a separate bowl with an electric mixer on medium-high speed until thickened, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Brush each ladyfinger cookie with coffee. Arrange a few ladyfingers in the bottom of 4 serving glasses. Spread a layer of cream filling atop the ladyfingers. Layer a few strawberry slices atop cream filling. Repeat with remaining ladyfingers, cream filling, and sliced strawberries, ending with a layer of cream filling. Garnish each glass with a whole strawberry."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "0bd567c2-9ed4-53b5-9193-3a34c5a500eb",
  "slug": "copycat-mexican-style-pizzas-recipe-11927302",
  "name": "Copycat Mexican-Style Pizzas",
  "recipe_type": "main",
  "brief_description": "If you\u2019ve ever craved the nostalgic crunch and bold flavors of Taco Bell\u2019s Mexican Pizza, this homemade version delivers all the same satisfaction\u2014only fresher and even more delicious.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Cook beef and Taco Bell-Style Seasoning in a large skillet over medium heat, stirring and breaking up lumps, until beef is browned, 6 to 8 minutes. Transfer beef to a plate; pour off grease."
    },
    {
      "position": 2,
      "text": "Heat oil in same skillet over medium heat. Working with 1 tortilla at a time, fry tortillas, turning halfway through, until lightly toasted, about 1 minute. Transfer to a paper towel-lined plate to drain. Repeat with remaining tortillas, adding more oil as needed."
    },
    {
      "position": 3,
      "text": "Arrange 6 fried tortillas on a 13x18-inch rimmed baking sheet. Spread a thin layer of refried beans on tortillas; top evenly with beef mixture and 1 cup cheese. Top with remaining 6 fried tortillas. Spoon enchilada sauce evenly over top."
    },
    {
      "position": 4,
      "text": "Bake until cheese is melted and tortillas are crisp, about 10 minutes. Top with remaining 1 cup cheese and bake until melted on top, about 5 minutes more. Top with tomatoes, sour cream, and jalape\u00f1os (if using). Cut into wedges to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

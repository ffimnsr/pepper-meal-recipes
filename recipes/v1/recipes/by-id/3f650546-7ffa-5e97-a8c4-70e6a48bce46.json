  "id": "3f650546-7ffa-5e97-a8c4-70e6a48bce46",
  "slug": "slow-cooker-shrimp-boil-recipe-11998691",
  "name": "Slow Cooker Shrimp Boil",
  "recipe_type": "main",
  "brief_description": "This slow cooker shrimp boil recipe has the flavor you love of a shrimp boil, without the open steaming pot, a great way to keep the kitchen cool in the summer. With seasoned shrimp, sausage, potatoes, and corn, it doesn't get any better than this.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place onion, potatoes, and garlic in the bottom of a slow cooker and sprinkle with salt and pepper. Squeeze lemon halves over potatoes; add lemon halves in as well if desired. Add 3 tablespoons Old Bay, hot sauce, Worcestershire, and water and stir to combine. Add bay leaves, cover, and cook 1 to 1 1/2 hours on High or 2 1/2 hours on Low."
    },
    {
      "position": 2,
      "text": "Uncover and remove lemon halves if used and add in sausage and corn. Top with 1 stick butter. Cover and cook 2 hours on High or 4 hours on Low or until potatoes are tender."
    },
    {
      "position": 3,
      "text": "Stir in shrimp and top with remaining butter. Cook on High for 30 minutes, stirring half way through or until shrimp are cooked and everything is heated through."
    },
    {
      "position": 4,
      "text": "Serve topped with parsley and with lemon wedges and cocktail sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 20,

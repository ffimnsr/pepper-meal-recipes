  "schema_version": 1,
  "id": "5e0401c0-5bb2-585b-b385-bd7686f906a0",
  "slug": "frozen-lemon-pavlova",
  "name": "Frozen Lemon Pavlova",
  "recipe_type": "dessert",
  "brief_description": "This frozen version of the spectacular Australian dessert has a lighter-than-air lemon cream filling inside an almond-crusted meringue exterior.",
  "cuisine": "Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 10x15 jelly roll pan and line the pan with parchment. Grease the parchment and dust with the cornstarch."
    },
    {
      "position": 2,
      "text": "Beat the 6 egg whites until foamy in a large glass or metal mixing bowl. Gradually add 1 1/2 cups sugar, continuing to beat until stiff peaks form. Lift your beater or whisk straight up: the egg whites should form a sharp peak that holds its shape. Spread the meringue mixture in the prepared pan."
    },
    {
      "position": 3,
      "text": "Whisk together the cinnamon and 1/4 cup sugar in a small bowl. Sprinkle cinnamon sugar, then almonds, evenly over the meringue mixture."
    },
    {
      "position": 4,
      "text": "Bake meringue in the preheated oven until lightly brown, 12 to 15 minutes. Remove pan from oven; turn over onto a foil-covered surface, almond side down. Set aside to cool completely. Carefully remove parchment when cool."
    },
    {
      "position": 5,
      "text": "Beat the 3 egg whites until foamy in a large glass or metal mixing bowl. Add salt, continuing to beat until stiff peaks form. Gradually beat in 1 cup sugar; then gradually beat in lemon juice and zest."
    },
    {
      "position": 6,
      "text": "In a separate bowl, beat cream until stiff peaks form. Fold whipped cream into lemon mixture."
    },
    {
      "position": 7,
      "text": "Place the filling in the center of the meringue. Using the foil to lift the meringue, fold the sides of the meringue over the filling, making a log shape. Wrap the log in foil and place in freezer for at least two hours."
    },
    {
      "position": 8,
      "text": "To serve, unwrap pavlova. Decorate with lemon slices, mint leaves and strawberries. Serve frozen."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

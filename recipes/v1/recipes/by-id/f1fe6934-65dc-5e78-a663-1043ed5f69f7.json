  "slug": "roasted-asparagus-and-carrots-recipe-11722340",
  "name": "Roasted Asparagus and Carrots",
  "recipe_type": "side",
  "brief_description": "These oven-roasted asparagus and carrots are tossed in olive oil, salt, pepper, and Greek seasoning. It\u2019s a simple yet flavorful side dish, perfect next to a ribeye steak.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a rimmed baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Place asparagus and carrots on the prepared baking sheet. Drizzle with olive oil; sprinkle with Greek seasoning, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Roast for 30 minutes, tossing mixture halfway through the process. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

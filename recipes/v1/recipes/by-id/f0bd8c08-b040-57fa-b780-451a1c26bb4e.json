  "slug": "grandmas-salad-dressing",
  "name": "Grandma's Salad Dressing",
  "recipe_type": "salad",
  "brief_description": "This sweet and tangy salad dressing with ketchup, oil, and vinegar is a family heirloom that has dressed many salads through the generations.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Add oil, vinegar, sugar, ketchup, salt, Worcestershire sauce, and onion to a large jar with a tight-fitting lid. Shake until sugar is dissolved. Refrigerate and shake well before using."
    }
  ],
  "servings": 28,

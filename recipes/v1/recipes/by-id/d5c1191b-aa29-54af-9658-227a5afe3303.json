  "id": "d5c1191b-aa29-54af-9658-227a5afe3303",
  "slug": "turkey-and-yam-spicy-tacos",
  "name": "Turkey and Yam Spicy Tacos",
  "recipe_type": "dessert",
  "brief_description": "Spicy tacos with low fat turkey have a sweet-hot flavor, yams give them a surprising twist.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Put the diced yam in a microwave-safe bowl; cook in the microwave until cooked through and fork-tender, stirring once, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Coat the bottom of a large skillet with olive oil and place over medium heat; cook and stir the turkey until crumbled and evenly brown, 5 to 7 minutes. Stir the onion, garlic, and jalapeno pepper into the turkey and continue cooking until the onions begin to caramelize, 7 to 10 minutes. Season with the chili powder, cumin, Cajun seasoning, and salt. Pour the salsa over everything; fold the sweet potatoes into the mixture. Allow the mixture to cook until the excess moisture evaporates. Garnish with the cilantro. Serve with the warm tortillas."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

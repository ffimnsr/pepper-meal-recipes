  "id": "92d8dfdc-a14d-5b03-b209-7619f2cf8617",
  "slug": "moms-buttermilk-pancakes",
  "name": "Mom\u2019s Buttermilk Pancakes",
  "recipe_type": "dessert",
  "brief_description": "The best buttermilk pancake mix to make light and fluffy pancakes. This favorite family recipe goes well with berry syrup \u2014 a special breakfast treat.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat and lightly grease a large skillet or electric griddle."
    },
    {
      "position": 2,
      "text": "Mix flour, salt, and baking soda together in a bowl. Add egg, buttermilk, and butter; stir together lightly, but keep it lumpy. The batter should look thick, spongy, and puffy."
    },
    {
      "position": 3,
      "text": "Drop 1/3 cup of the batter onto the cooking surface, spreading lightly with the bottom of the cup. Cook until lightly browned on each side, 1 to 2 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

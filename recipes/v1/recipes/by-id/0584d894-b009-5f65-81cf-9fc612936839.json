  "slug": "incredible-turkey-brine",
  "name": "Incredible Turkey Brine",
  "recipe_type": null,
  "brief_description": "This flavorful turkey brine uses brown sugar, kosher salt, Worcestershire, garlic, thyme, and rosemary. Allspice berries are optional but recommended!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together water, salt, brown sugar, Worcestershire sauce, garlic, thyme, rosemary, peppercorns, allspice berries, and bay leaf in a large pot; bring to a boil. Set aside to cool completely before brining turkey."
    }
  ],
  "servings": 1,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ed0382ed-62d1-560a-88e8-80a039e478f9",
  "slug": "argentinean-inspired-beef-mini-empanadas",
  "name": "Argentinean-Inspired Beef Mini Empanadas",
  "recipe_type": "appetizer",
  "brief_description": "These delicious mini empanadas filled with tender beef, veggies, and briny olives can be served as a either a main course or an appetizer.",
  "cuisine": "Inspired South American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare filling: Cook ground beef, onion, bell pepper, and garlic in a large, nonstick skillet over medium to medium-high heat until vegetables are tender and beef is browned and crumbly, about 10 minutes. Add olives, paprika, cumin, salt, and pepper. Stir in chopped eggs."
    },
    {
      "position": 2,
      "text": "Scrape mixture into a bowl. Cover and refrigerate until fully chilled, 1 to 2 hours; this ensures the dough will not be soggy when the empanadas are baked."
    },
    {
      "position": 3,
      "text": "Prepare dough: Whisk flour and salt together in a medium bowl until combined. Cut in butter with a pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 4,
      "text": "Whisk cold water, egg, and vinegar together in a small bowl. Pour into the dry ingredients and blend with a fork. Use your hands to finish blending the ingredients until they come together in a ball. Flatten the ball into a disc, wrap with plastic wrap, and refrigerate for 1 hour."
    },
    {
      "position": 5,
      "text": "When you are ready to cook, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Roll the dough on a lightly floured surface. Use a 3-inch round cutter to cut circles, rerolling the scraps as necessary. I got about 18 circles."
    },
    {
      "position": 7,
      "text": "Hold each circle in your hand and place a heaping tablespoon of filling in the center. Gently fold the ends over the top and press to seal all the way around. Reserve extra filling for another use."
    },
    {
      "position": 8,
      "text": "Set empanadas on a baking sheet. Press around the sealed edges with a fork if desired."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until golden brown on the bottoms, about 18 minutes. Flip and bake until the other side is browned, about 5 more minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "3f7b4621-8963-5f2e-a654-81a31b3c715a",
  "slug": "hot-water-cornbread",
  "name": "Hot Water Cornbread",
  "recipe_type": "dessert",
  "brief_description": "This hot water cornbread is an old-fashioned Southern recipe for easy-to-make cornmeal cakes fried in a skillet in shortening until crisp and golden.",
  "cuisine": "U.S. Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cornmeal, salt, and sugar in a medium bowl. Add boiling water and 1 tablespoon bacon grease; stir until bacon grease melts."
    },
    {
      "position": 3,
      "text": "Pour bacon grease to a depth of 1/2-inch in a large skillet; heat to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Shape cornmeal mixture into 12 flattened balls using a heaping tablespoon as a measuring guide."
    },
    {
      "position": 5,
      "text": "Fry, turning once, in hot oil until crisp and golden brown, about 5 minutes. Drain on paper towels and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

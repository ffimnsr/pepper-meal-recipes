  "id": "29b82531-b34d-545d-b3c8-30f2e33e37d0",
  "slug": "chocolate-cranberry-energy-bars",
  "name": "Chocolate-Cranberry Energy Bars",
  "recipe_type": "appetizer",
  "brief_description": "Packed with energy thanks to walnuts, almonds, dates, cranberries, and coconut, these bars are perfect for on-the-go snacking, camping, or filling lunch boxes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Pulse almonds and walnuts together in the bowl of a food processor until chopped. Add dates and cranberries, a little at a time, and continue to chop. Add coconut, cocoa, and vanilla extract. Process to desired consistency."
    },
    {
      "position": 3,
      "text": "Roll dough into a 2-inch wide log and cut into ten 3/4-inch thick pucks. Place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until set, about 10 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

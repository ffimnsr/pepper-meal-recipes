  "id": "935b7a6b-dbe7-5de3-a924-142b5b33de3b",
  "slug": "classic-restaurant-caesar-salad",
  "name": "Classic Caesar Salad",
  "recipe_type": "salad",
  "brief_description": "This Caesar salad is surprisingly easy to make with romaine, croutons, and a delicious Caesar dressing made from scratch for a restaurant-worthy dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "To make the Caesar dressing: Mash anchovy fillets and garlic in a large salad bowl. Add lemon juice, red wine vinegar, Dijon mustard, egg yolk, and Worcestershire sauce; whisk until smooth and creamy. Gradually stream in olive oil while whisking constantly. Season to taste with salt and black pepper."
    },
    {
      "position": 3,
      "text": "To serve: Gently mix romaine lettuce and Parmesan cheese into dressing until thoroughly coated."
    },
    {
      "position": 4,
      "text": "Top Caesar salad with croutons and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "488bace1-d59d-5ca0-9e08-e68aea29ad66",
  "slug": "slow-cooker-turkey-chili",
  "name": "Slow Cooker Turkey Chili",
  "recipe_type": "soup",
  "brief_description": "All you have to do to make this chili is put the ground turkey, beans, tomatoes, and seasonings in the slow cooker and let your appliance do the rest!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground turkey, tomatoes, kidney beans, pinto beans, chicken stock, onion, hot sauce, chili powder, salt, minced garlic, paprika, oregano, cayenne pepper, cumin, and black pepper together in a slow cooker; stir to break the turkey into small chunks."
    },
    {
      "position": 2,
      "text": "Cook on Low 6 to 8 hours (or High for 4 hours)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 10,

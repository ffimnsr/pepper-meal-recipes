  "id": "6c0081ee-c2b8-5be9-bf05-500927ad97f6",
  "slug": "best-ever-muffins",
  "name": "Best Ever Muffins",
  "recipe_type": "dessert",
  "brief_description": "These muffins can be your starting point for a range of sweet and savory muffins, depending on what you add. From berries to bacon \u2014 it's up to you!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Stir flour, baking powder, salt, and sugar together in a large bowl; make a well in the center."
    },
    {
      "position": 3,
      "text": "Beat egg with a fork in a small bowl or 2-cup measuring cup; whisk in milk and oil."
    },
    {
      "position": 4,
      "text": "Pour egg mixture all at once into flour mixture; mix quickly and lightly with a fork until just moistened. The batter will be lumpy. (Fold in additional ingredients if using; see variations below)."
    },
    {
      "position": 5,
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 25 minutes."
    },
    {
      "position": 7,
      "text": "Enjoy! Get back to basics with this top-rated muffin recipe that comes together easily with kitchen staples."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

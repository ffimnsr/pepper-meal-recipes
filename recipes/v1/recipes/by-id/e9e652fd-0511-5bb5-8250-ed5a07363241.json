  "id": "e9e652fd-0511-5bb5-8250-ed5a07363241",
  "slug": "rice-cooker-recipe-raspberry-applesauce",
  "name": "Rice Cooker Recipe: Raspberry Applesauce",
  "recipe_type": "appetizer",
  "brief_description": "Homemade raspberry applesauce made in the rice cooker is an easy way to use the rice cooker for a sweet treat the kids will love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place apples and raspberries in the rice cooker; add brown sugar, cinnamon, and nutmeg. Add honey, vanilla extract, lemon juice, and water, in respective order."
    },
    {
      "position": 2,
      "text": "Set rice cooker to standard \"cook\" setting, about 30 minutes. Stir mixture halfway through cooking cycle, mashing apples a little bit."
    },
    {
      "position": 3,
      "text": "Remove the applesauce from the heat and cool for 30 minutes. Transfer applesauce to a bowl and chill in the refrigerator for at least 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

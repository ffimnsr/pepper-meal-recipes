  "id": "7344ac6d-eef8-5a95-9116-b4a78a0940ee",
  "slug": "classic-slow-cooker-corn-chowder",
  "name": "Classic Slow Cooker Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "A comforting and creamy corn chowder with potatoes and ham is made in the slow cooker. Chili powder and hot sauce adds a little kick.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir milk, cream-style corn, cream of mushroom soup, chopped green chiles, frozen corn, hash brown potatoes, ham, onion, butter, hot sauce, parsley, and chili powder in a slow cooker. Season with salt and black pepper. Cover and cook on High for 4 hours or on Low and for 6 hours."
    }
  ],
  "servings": 8,

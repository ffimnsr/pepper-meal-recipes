  "id": "b6717522-09af-5f5d-a2f7-dad969663c3b",
  "slug": "vegan-cupcakes",
  "name": "Vegan Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These vegan cupcakes flavored with vanilla are egg-free, made with almond milk and coconut oil, and are quick to make with basic pantry ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin pans or line with 18 paper baking cups."
    },
    {
      "position": 2,
      "text": "Pour apple cider vinegar into a 2-cup measuring cup. Fill with almond milk to make 1 1/2 cups. Let stand until curdled, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk together flour, sugar, baking powder, baking soda, and salt in a large bowl. Whisk together almond milk mixture, coconut oil, and vanilla in a separate bowl. Pour wet ingredients into dry ingredients and stir just until blended. Spoon batter evenly into the prepared cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 15 to 20 minutes. Cool in the pan set over a wire rack."
    },
    {
      "position": 5,
      "text": "Arrange cooled cupcakes on a serving platter. Frost with desired frosting."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

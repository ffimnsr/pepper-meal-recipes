  "id": "25e093ae-a905-5343-837b-c89cc6366aeb",
  "slug": "kevins-teriyaki-chicken",
  "name": "Kevin's Teriyaki Chicken",
  "recipe_type": "main",
  "brief_description": "A quick and easy chicken marinade with pineapple, soy sauce, and garlic. Ready in minutes, with the flavor of cooking all day!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix together the pineapple juice, soy sauce, ginger, garlic powder, and white pepper. Reserve a small amount of the marinade separately for dipping later."
    },
    {
      "position": 2,
      "text": "Place chicken in marinade, and add enough water to cover. Cover, and refrigerate for 24 hours."
    },
    {
      "position": 3,
      "text": "Heat an outdoor grill for medium-high heat."
    },
    {
      "position": 4,
      "text": "Brush grate lightly with oil. Grill chicken 5 to 7 minutes per side, depending on thickness. Chicken is done when inside is no longer pink and juices run clear."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

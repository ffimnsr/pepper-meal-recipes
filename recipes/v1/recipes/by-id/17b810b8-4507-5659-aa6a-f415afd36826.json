  "id": "17b810b8-4507-5659-aa6a-f415afd36826",
  "slug": "creamy-asparagus-pasta",
  "name": "Creamy Asparagus Pasta",
  "recipe_type": "drink",
  "brief_description": "This creamy pasta with saut\u00e9ed asparagus is made with butter, garlic, light cream, linguine, and lemon juice for a simple but delicious 30-minute meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a medium pot of water to a boil. Cook asparagus in boiling water until bright green and slightly crisp, 3 to 4 minutes; drain."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Saut\u00e9 asparagus and garlic in hot butter for 3 to 4 minutes. Stir in cream and simmer for 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of water to a boil. Cook linguine in boiling water until tender yet firm to the bite, 8 to 10 minutes; drain and transfer to a serving dish."
    },
    {
      "position": 4,
      "text": "Stir lemon juice into asparagus mixture; pour mixture over hot pasta."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

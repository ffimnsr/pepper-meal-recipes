  "id": "c4347cd8-0171-59b2-b15a-f743e27649a6",
  "slug": "spicy-chicken-zucchini-meatballs-recipe-7968537",
  "name": "Spicy Chicken Zucchini Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These great spicy chicken zucchini meatballs begin with hot Italian sausage from the grocery, or use \"sweet Italian\" sausage to make them milder. Use these low-carb zucchini meatballs in a main dish, with pasta or zoodles and a sauce of your choice, or use picks to dip in marinara sauce as an appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make a bed of clean kitchen towels or paper towels, and spread out the zucchini shreds on it. Lightly sprinkle with salt, and allow to sit while preparing the other ingredients, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and line a 12x18-inch sheet pan with parchment or foil."
    },
    {
      "position": 3,
      "text": "\u00cen a large mixing bowl, combine chicken sausage, onion, pecorino Romano cheese, and garlic."
    },
    {
      "position": 4,
      "text": "Roll up the towel bed with grated zucchini like a jelly roll, pressing as you go, to squeeze out excess liquid. Unroll, and add zucchini shreds to the other ingredients. Add egg and stir until all meatball ingredients are mixed well."
    },
    {
      "position": 5,
      "text": "Form mixture into 18 to 20 2-inch meatballs and place on the prepared pan. Spray lightly with olive oil spray."
    },
    {
      "position": 6,
      "text": "Bake meatballs in the center of the preheated oven until lightly browned, and an instant-read thermometer reads 165 degrees F (74 degrees C) inserted near the center of meatballs, 25 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Serve with purchased marinara as a dipping sauce, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

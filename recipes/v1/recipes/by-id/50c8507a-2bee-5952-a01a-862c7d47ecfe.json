  "id": "50c8507a-2bee-5952-a01a-862c7d47ecfe",
  "slug": "mexican-taco-meatloaf",
  "name": "Mexican Taco Meatloaf",
  "recipe_type": "snack",
  "brief_description": "Seasoned Mexican meatloaf is pure comfort food in a pan made with crushed tortilla chips, beef, pepper Jack cheese, and onion topped with taco sauce.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together beef, onion, tortilla chips, pepper Jack cheese, and taco seasoning in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Whisk together eggs, milk, and taco sauce in a medium bowl."
    },
    {
      "position": 4,
      "text": "Add to beef mixture and stir until well combined."
    },
    {
      "position": 5,
      "text": "Press mixture into a 9x5x3-inch loaf pan. Pour a strip of taco sauce down the center of loaf."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cooked through and browned on top, 45 to 60 minutes. An instant-read thermometer inserted into the center of loaf should read at least 160 degrees F (72 degrees C)."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

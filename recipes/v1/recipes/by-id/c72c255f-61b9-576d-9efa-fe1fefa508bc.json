  "id": "c72c255f-61b9-576d-9efa-fe1fefa508bc",
  "slug": "kale-and-quinoa-salad",
  "name": "Kale and Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "Kale, quinoa, currants, pecans, and feta cheese are tossed in a basic vinaigrette in this salad recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a saucepan; stir in quinoa. Reduce heat to medium-low, cover saucepan, and cook until water absorbed, about 12 minutes. Remove saucepan from heat, let rest, covered, for 5 minutes. Remove cover; allow quinoa to cool completely."
    },
    {
      "position": 2,
      "text": "Add kale to a large mixing bowl. Whisk olive oil, lemon juice, Dijon mustard, garlic, pepper, and salt together in a separate bowl until emulsified; drizzle over kale."
    },
    {
      "position": 3,
      "text": "Add cooled quinoa, pecans, currants, and feta cheese to dressed kale; toss to combine."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

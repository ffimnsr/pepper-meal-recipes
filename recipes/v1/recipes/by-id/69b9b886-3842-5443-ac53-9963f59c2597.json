  "id": "69b9b886-3842-5443-ac53-9963f59c2597",
  "slug": "baked-omelet",
  "name": "Baked Omelet",
  "recipe_type": "breakfast",
  "brief_description": "This omelet recipe with ham, Cheddar, and mozzarella is baked in the oven for an easy and satisfying egg dish that's ideal for breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Whisk eggs and milk together in a bowl."
    },
    {
      "position": 3,
      "text": "Stir in Cheddar, mozzarella, ham, onion, and seasoning salt."
    },
    {
      "position": 4,
      "text": "Pour into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, in the preheated oven until set, 40 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Serve immediately and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

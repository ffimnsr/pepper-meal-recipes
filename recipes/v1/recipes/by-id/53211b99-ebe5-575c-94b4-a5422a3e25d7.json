  "id": "53211b99-ebe5-575c-94b4-a5422a3e25d7",
  "slug": "low-carb-cream-of-mushroom-soup",
  "name": "Low-Carb Cream of Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "This low-carb, high-fat, tangy cream of mushroom soup is the perfect keto meal. Cream cheese thickens this soup, making it both delicious and filling.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large, heavy saucepan over medium heat. Add mushrooms, onion, and garlic. Cook, stirring often until tender, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add salt, pepper, and thyme. Stir in chicken broth, heavy cream, and cream cheese."
    },
    {
      "position": 3,
      "text": "Reduce heat to a low simmer. Add sherry and continue to cook, stirring constantly, until cream cheese is incorporated, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,

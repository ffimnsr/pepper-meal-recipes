  "schema_version": 1,
  "id": "35c7e2ea-bafa-5095-a231-71f5dcf5b4bf",
  "slug": "irish-shepherds-pie",
  "name": "Irish Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This Irish shepherd's pie made with ground lamb and veggies baked under Irish Cheddar-mashed potatoes is Chef John's version of a comfort food classic.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place olive oil and butter in a Dutch oven over medium heat. Stir in ground lamb and onion; cook and stir until meat is brown and crumbly, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in flour until incorporated. Mix in garlic, ketchup, rosemary, paprika, cinnamon, salt, and pepper; cook and stir until garlic is fragrant, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir in water, scraping up any brown bits from the bottom of the Dutch oven. Reduce heat to medium-low and bring mixture to a simmer; cook and stir until thick, 5 to 6 minutes."
    },
    {
      "position": 5,
      "text": "Remove lamb mixture from heat, then stir in peas and carrots until combined."
    },
    {
      "position": 6,
      "text": "Spread lamb mixture into the bottom of a 9x13-inch baking dish; set aside."
    },
    {
      "position": 7,
      "text": "Place potatoes into a large pot of salted water. Bring to a boil, reduce heat to medium, and cook until tender, about 15 minutes. Drain well and return potatoes to the pot."
    },
    {
      "position": 8,
      "text": "Mash Irish cheese, cream cheese, butter, and cayenne pepper into potatoes until smooth. Season with salt and black pepper."
    },
    {
      "position": 9,
      "text": "Whisk together egg yolk and milk in a small bowl; stir into mashed potato mixture."
    },
    {
      "position": 10,
      "text": "Top lamb mixture in the baking dish with mashed potatoes; spread evenly to cover."
    },
    {
      "position": 11,
      "text": "Bake in the preheated oven until the top is golden brown and sauce is bubbling up around the edges, 25 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 25,

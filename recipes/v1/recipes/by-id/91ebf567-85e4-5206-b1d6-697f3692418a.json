  "id": "91ebf567-85e4-5206-b1d6-697f3692418a",
  "slug": "italian-sausage-tortellini-bake",
  "name": "Italian Sausage Tortellini Bake",
  "recipe_type": "main",
  "brief_description": "This delicious baked Italian sausage tortellini recipe is simple to make with jarred marinara sauce, canned tomatoes, mozzarella, and frozen pasta.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large saucepan over medium heat. Crumble sausage into the pan; add onion and bell pepper. Cook and stir until sausage is completely browned, 7 to 10 minutes. Drain grease."
    },
    {
      "position": 2,
      "text": "Add marinara sauce and tomatoes to sausage mixture; stir in garlic powder. Bring to a simmer, reduce heat to medium-low, and cook until tomatoes break down into sauce, 30 to 45 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook frozen tortellini in boiling water until they float to the top and the filling is hot, 6 to 7 minutes; drain."
    },
    {
      "position": 5,
      "text": "Gently fold tortellini into simmering sauce; cook for 5 minutes. Transfer tortellini and sauce to a 9x13-inch baking dish; sprinkle with mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is golden brown, 20 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

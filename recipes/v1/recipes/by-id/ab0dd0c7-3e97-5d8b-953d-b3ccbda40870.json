  "id": "ab0dd0c7-3e97-5d8b-953d-b3ccbda40870",
  "slug": "garlic-chicken-fried-chicken",
  "name": "Garlic Chicken Fried Chicken",
  "recipe_type": "main",
  "brief_description": "This actually uses my breading for Chicken Fried Steak---my husband suggested we try it with chicken breasts, and it was delicious!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a shallow dish, mix together the garlic powder, pepper, salt, paprika, bread crumbs and flour. In a separate dish, whisk together the milk and egg."
    },
    {
      "position": 2,
      "text": "Heat the oil in an electric skillet set to 350 degrees F (175 degrees C). Dip the chicken into the egg and milk, then dredge in the dry ingredients until evenly coated."
    },
    {
      "position": 3,
      "text": "Fry chicken in the hot oil for about 5 minutes per side, or until the chicken is cooked through and juices run clear. Remove from the oil with a slotted spatula, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

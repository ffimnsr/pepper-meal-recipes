  "id": "9ed4ec4c-1ba2-5f71-8d3d-2bbfaf47ff6f",
  "slug": "stuffed-jalapenos-iii",
  "name": "Stuffed Jalapenos III",
  "recipe_type": "appetizer",
  "brief_description": "Jalapeno halves are stuffed with whipped cream cheese and wrapped with bacon. They're spicy, rich and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stuff each jalapeno half with whipped cream cheese. Wrap a half slice of bacon around each stuffed jalapeno half."
    },
    {
      "position": 3,
      "text": "Arrange wrapped jalapeno halves in a single layer on a medium baking sheet. Bake in the preheated oven 45 minutes, or until bacon is evenly browned and crisp."
    }
  ],

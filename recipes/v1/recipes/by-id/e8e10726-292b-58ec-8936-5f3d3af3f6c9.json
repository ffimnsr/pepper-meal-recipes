  "schema_version": 1,
  "id": "e8e10726-292b-58ec-8936-5f3d3af3f6c9",
  "slug": "slow-cooker-pork-green-chili",
  "name": "Slow Cooker Pork Green Chili",
  "recipe_type": "soup",
  "brief_description": "This slow cooker green chili pork recipe is made with Hatch green chile peppers. It's great by itself or as a topper to burritos, enchiladas, or eggs.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Rub the inside of a slow cooker with about 1 tablespoon oil and turn on Low."
    },
    {
      "position": 2,
      "text": "Mix salt, black pepper, garlic powder, paprika, 1 teaspoon cumin, onion powder, chili powder, and cayenne pepper together in a bowl. Rub spice mixture all over pork. Top pork with cornstarch and pat to coat completely."
    },
    {
      "position": 3,
      "text": "Heat remaining oil in a heavy skillet over medium-high heat. Sear pork in hot oil on all sides until almost black, about 5 minutes. Transfer seared pork to the slow cooker."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium and pour beef stock into the skillet. Whisk until boiling, scraping up browned bits, about 5 minutes. Boil gently for 3 to 4 minutes more. Strain stock into the slow cooker. Add salsa, Hatch chiles, diced tomatoes, and potatoes."
    },
    {
      "position": 5,
      "text": "Combine tomatillos, 1/2 the cilantro, jalape\u00f1o pepper, Anaheim pepper, serrano pepper, remaining cumin, and liquid smoke in a blender. Blend on high power and add to slow cooker."
    },
    {
      "position": 6,
      "text": "Cover and cook on Low for 8 hours."
    },
    {
      "position": 7,
      "text": "Remove pork from the slow cooker and shred using two forks. Return meat to slow cooker. Season with additional salt and pepper."
    },
    {
      "position": 8,
      "text": "Serve chili in bowls with Mexican cheese, sour cream, and remaining cilantro."
    }
  ],
  "servings": 12,

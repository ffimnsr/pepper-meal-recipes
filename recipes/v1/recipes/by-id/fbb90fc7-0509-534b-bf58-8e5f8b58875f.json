  "id": "fbb90fc7-0509-534b-bf58-8e5f8b58875f",
  "slug": "chop-suey",
  "name": "Chop Suey",
  "recipe_type": "main",
  "brief_description": "Chop suey is quick and easy to make with tender diced pork quickly saut\u00e9ed with crisp mixed vegetables and bean sprouts in a thick brown sauce.",
  "cuisine": "Chinese Inspired Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat shortening in a large, deep skillet over medium-high meat. Add pork and sear until it turns white."
    },
    {
      "position": 3,
      "text": "Add onion and saut\u00e9 for 5 minutes. Stir in celery, hot water, salt, and pepper. Cover skillet and simmer for 5 minutes."
    },
    {
      "position": 4,
      "text": "Add sprouts and bring mixture to a boil."
    },
    {
      "position": 5,
      "text": "Combine cold water, cornstarch, soy sauce, and sugar in a small bowl."
    },
    {
      "position": 6,
      "text": "Add to skillet mixture and cook until thickened to desired consistency, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "2c7388bd-30ee-54c6-a2ca-bdd5827f3fea",
  "slug": "plum-and-pecan-muffins-recipe-8302598",
  "name": "Plum and Pecan Muffins",
  "recipe_type": "dessert",
  "brief_description": "These plum and pecan muffins are loaded with fruit, so you\u2019ll get a taste of plum in every bite. The pecans and ginger bring additional layers of flavor to the sweet, ripe plums.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a 12-cup standard muffin tin with cooking spray or line with paper liners."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together flour, sugar, baking powder, ginger, baking soda, and salt."
    },
    {
      "position": 3,
      "text": "In a separate bowl, whisk yogurt, orange juice, eggs, butter, and vanilla until well combined."
    },
    {
      "position": 4,
      "text": "Make a well in the center of dry ingredients; pour yogurt mixture into well and stir just until batter is combined. Gently fold in plums and pecans. Evenly spoon batter into the prepared muffin tin cups."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until muffins are golden and a toothpick inserted near the center comes out clean, 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "Allow muffins to cool in the pan for 5 minutes, then remove to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

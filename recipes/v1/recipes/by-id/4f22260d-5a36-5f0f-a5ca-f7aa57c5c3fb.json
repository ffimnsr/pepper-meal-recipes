  "id": "4f22260d-5a36-5f0f-a5ca-f7aa57c5c3fb",
  "slug": "sauteed-cherry-tomatoes-with-garlic-and-basil",
  "name": "Saut\u00e9ed Cherry Tomatoes with Garlic and Basil",
  "recipe_type": "side",
  "brief_description": "Enjoy cherry or grape tomatoes with this quick and easy recipe. Saut\u00e9ed in olive oil with garlic and basil, these are ready in less than 10 minutes",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a 12-inch frying pan over medium-high heat until oil starts to smoke."
    },
    {
      "position": 3,
      "text": "Add tomatoes to hot oil; season with salt and pepper. Saut\u00e9, shaking pan frequently, until tomatoes soften and skins just begin to wrinkle, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir in garlic and continue shaking the pan until garlic is fragrant."
    },
    {
      "position": 5,
      "text": "Remove from heat; stir in fresh basil and remaining 1 tablespoon olive oil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

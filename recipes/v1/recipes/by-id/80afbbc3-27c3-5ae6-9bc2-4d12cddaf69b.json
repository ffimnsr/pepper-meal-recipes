  "id": "80afbbc3-27c3-5ae6-9bc2-4d12cddaf69b",
  "slug": "doggie-treats-ii",
  "name": "Doggie Treats II",
  "recipe_type": null,
  "brief_description": "These are chicken and Cheddar cheese flavored treats for man's best friend.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease cookie sheets. In a large bowl, stir together the rolled oats, margarine and boiling water. Set aside for 10 minutes."
    },
    {
      "position": 2,
      "text": "Combine the cornmeal, sugar, and bouillon, stir into the oat mixture along with the egg and milk until smooth. fold in the shredded cheese. Gradually stir in the flour until a stiff but workable dough is formed. Knead the dough for a few turns. On a lightly floured surface, roll the dough out to 1/2 inch thickness. Cut with a bone-shaped cookie cutter or cut into 1x3 inch rectangles. Place treats 1 inch apart onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 35 to 40 minutes in the preheated oven, until golden brown. Remove from the baking sheet to cool completely on wire racks."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

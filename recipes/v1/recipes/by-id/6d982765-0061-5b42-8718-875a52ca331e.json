  "id": "6d982765-0061-5b42-8718-875a52ca331e",
  "slug": "blueberry-muffin-bars-recipe-11857303",
  "name": "Blueberry Muffin Bars",
  "recipe_type": "dessert",
  "brief_description": "These blueberry muffin bars are full of blueberries and topped with a delicious streusel topping. They have the best qualities of a muffin and a dessert bar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 10x15-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Prepare oat streusel topping: stir oats, flour, brown sugar, and cinnamon together in a large bowl. Cut in butter with a pastry blender until the mixture is crumbly. Set aside."
    },
    {
      "position": 3,
      "text": "For bars. whisk flour, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "position": 4,
      "text": "Whisk together white sugar and oil in a large bowl until well combined. Whisk in milk, eggs, and vanilla extract."
    },
    {
      "position": 5,
      "text": "Stir flour mixture into egg mixture until just combined."
    },
    {
      "position": 6,
      "text": "Gently fold in blueberries."
    },
    {
      "position": 7,
      "text": "Spread batter evenly into the prepared pan."
    },
    {
      "position": 8,
      "text": "Sprinkle streusel topping evenly over batter."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 28 minutes."
    },
    {
      "position": 10,
      "text": "Let bars cool in the pan on a wire rack 20 to 30 minutes before slicing and serving Recipe developed by Barrett Heald"
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

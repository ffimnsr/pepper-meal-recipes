  "id": "941c0c83-dd3a-5ea7-b9a7-b166539e9cc3",
  "slug": "lemon-lime-vegetable-salad",
  "name": "Lemon Lime Vegetable Salad",
  "recipe_type": "salad",
  "brief_description": "Sweet, salty, cool and crunchy, this salad is a great addition to any family buffet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together the lemon gelatin mix, lime gelatin mix, and boiling water until gelatin has dissolved. Stir in the apple cider vinegar, cover, and refrigerate for about 1 hour to thicken."
    },
    {
      "position": 3,
      "text": "When the gelatin is thick but not set, stir in the celery, olives, and carrot so they are evenly dispersed throughout."
    },
    {
      "position": 4,
      "text": "Pour into a 1 quart mold and refrigerate until firm, at least 3 hours. To serve, unmold onto a plate."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,

  "id": "2851e8b9-6f86-5599-a29d-151ce7653168",
  "slug": "spiced-maple-pumpkin-seeds",
  "name": "Spiced Maple Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This spiced maple pumpkin seeds recipe is made with maple syrup, cinnamon, and nutmeg \u2014 perfect for snacking \u2014 so don't toss the seeds when carving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-low heat. Add pumpkin seeds; cook and stir until seeds turn slightly brown, about 10 minutes. Drain off any excess butter."
    },
    {
      "position": 3,
      "text": "Off heat, stir in maple syrup, cinnamon, and nutmeg until seeds are thoroughly coated. Spread seeds onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crisp and golden brown, 30 to 45 minutes, stirring every 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

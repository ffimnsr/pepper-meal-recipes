  "id": "f144af0c-badc-5299-b77c-5570095ce576",
  "slug": "peach-scones",
  "name": "Peach Scones",
  "recipe_type": "breakfast",
  "brief_description": "These tender scones bursting with juicy peach flavor, perfect for a summery coffee or teatime treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with a silicone mat or parchment paper."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking powder, cinnamon, salt, cardamom, baking soda, and nutmeg together in a large bowl."
    },
    {
      "position": 3,
      "text": "Grate in 1/3 of the butter using the large holes of a box grater. Toss lightly with your fingertips until coated with flour. Repeat twice more with remaining butter."
    },
    {
      "position": 4,
      "text": "Whisk cream, egg, and vanilla extract together in a small bowl with a fork. Pour over the flour-butter mixture."
    },
    {
      "position": 5,
      "text": "Mix with a fork just until large clumps of dough form. Gently fold in peach."
    },
    {
      "position": 6,
      "text": "Turn dough out onto a lightly floured surface. Bring together and gently pat into a 9-inch-long rectangle about 1 inch thick. Sprinkle turbinado sugar on top; press gently to adhere."
    },
    {
      "position": 7,
      "text": "Cut into 8 triangles with a bench knife or sharp knife. Transfer to the prepared baking sheet."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden, about 18 minutes. Place baking sheet on a wire rack and let cool."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

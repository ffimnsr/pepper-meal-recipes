  "id": "b7056a84-d2ae-5767-aac4-fb07071b2fad",
  "slug": "chicken-quesadillas",
  "name": "Chicken Quesadillas",
  "recipe_type": "main",
  "brief_description": "This chicken quesadilla recipe is great for parties. Flour tortillas are filled with fajita-seasoned chicken, peppers, onions, cheese, and bacon bits.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients, preheat the broiler, and lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Toss chicken with fajita seasoning, then spread onto the prepared baking sheet. Place under the broiler and cook until chicken is cooked through and no longer pink in the center, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Heat oil in a large saucepan over medium heat. Stir in bell peppers, onion, and broiled chicken. Cook and stir until vegetables have softened, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Layer half of each tortilla with chicken and vegetable mixture, Cheddar cheese, Monterey Jack cheese, and bacon bits."
    },
    {
      "position": 6,
      "text": "Fold tortillas in half and place onto a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake quesadillas in the preheated oven until cheeses have melted, about 10 minutes. Cut each quesadilla into wedges."
    },
    {
      "position": 8,
      "text": "Serve with sides of salsa and sour cream. Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

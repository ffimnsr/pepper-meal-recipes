  "id": "73f7653c-6ed1-556f-832e-4ee054cfdb43",
  "slug": "mini-heart-shaped-naan-pizzas-recipe-8422932",
  "name": "Mini Heart-Shaped Naan Pizzas",
  "recipe_type": "main",
  "brief_description": "These mini heart-shaped naan pizzas are a fun and easy way to celebrate Valentine\u2019s Day, a child\u2019s birthday party, lunch, or even dinner for the kids. Just about everybody loves pizza, and you can top them with whatever makes everybody happy. Pepperoni hearts take them over the top.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with foil for easy cleanup."
    },
    {
      "position": 2,
      "text": "Use a 4 to 4 1/2-inch heart-shaped cookie cutter to cut each flatbread into a heart shape. Place flatbreads on the prepared baking sheet, evenly spread the pizza sauce on each, and sprinkle with mozzarella."
    },
    {
      "position": 3,
      "text": "Cut each slice of pepperoni into a heart shape using a mini heart-shaped cookie cutter, if desired, and place on top of mozzarella."
    },
    {
      "position": 4,
      "text": "Move the baking sheet to the oven, and cook until cheese is melted and crust is golden brown, 9 to 11 minutes. Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

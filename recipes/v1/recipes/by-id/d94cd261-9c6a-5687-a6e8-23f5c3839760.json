  "id": "d94cd261-9c6a-5687-a6e8-23f5c3839760",
  "slug": "sausage-croissants",
  "name": "Sausage Croissants",
  "recipe_type": "appetizer",
  "brief_description": "This sausage croissant recipe starts with refrigerated crescent roll dough and fills with savory sausage, onion, cream cheese, and jalape\u00f1o chile peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir sausage in a skillet over medium-high heat until browned, about 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Combine sausage, onion, cream cheese, and jalape\u00f1os in a bowl. Spoon about 1 tablespoon sausage mixture onto each crescent dough triangle; fold corners around sausage and roll up into a crescent, ending at the tip of the triangle. Place rolls on baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until rolls are golden brown, about 15 minutes."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

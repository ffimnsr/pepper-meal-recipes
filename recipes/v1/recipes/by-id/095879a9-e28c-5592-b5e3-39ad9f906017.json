  "id": "095879a9-e28c-5592-b5e3-39ad9f906017",
  "slug": "chef-johns-creamy-mushroom-soup",
  "name": "Chef John's Creamy Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "This mushroom soup is creamy, rich, and deliciously savory thanks to the caramelization of the mushrooms in butter that unlocks their earthy flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large soup pot over medium-high heat. Add mushrooms and 1 pinch salt; cook until mushrooms release their juices, 5 to 10 minutes. Reduce heat to medium-low; continue cooking, stirring often, until juices evaporate and mushrooms are caramelized, 15 to 25 minutes. Set aside a few attractive mushroom slices for garnish later, if desired."
    },
    {
      "position": 3,
      "text": "Add onion to mushrooms; cook and stir until onion is soft and translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in flour; cook, stirring often, to remove raw flour taste, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Pour in 4 cups chicken broth and 1 cup water; add thyme bundle and garlic cloves. Reduce heat to low; simmer for 1 hour. Remove and discard thyme bundle."
    },
    {
      "position": 6,
      "text": "Fill blender halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend until smooth and thick. Pour into a pot. Repeat with remaining soup."
    },
    {
      "position": 7,
      "text": "Stir in cream; if too thick, add a little chicken broth or water. Season with salt and black pepper."
    },
    {
      "position": 8,
      "text": "Divide soup among bowls; garnish with reserved mushroom slices and thyme leaves."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

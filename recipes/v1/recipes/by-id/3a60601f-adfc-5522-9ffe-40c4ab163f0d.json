  "id": "3a60601f-adfc-5522-9ffe-40c4ab163f0d",
  "slug": "pimento-cheese-pasta-salad-recipe-11971102",
  "name": "Pimento Cheese Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Pimento cheese is a beloved Southern spread for sandwiches and crackers, but it also makes an incredible pasta salad. Creamy, cheesy, and loaded with bacon and crunchy mix-ins, this crowd-pleasing side dish is perfect for barbecues, potlucks, tailgates, and summer gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add pasta, and cook, stirring occasionally, until tender yet firm to the bite, typically about 7 to 8 minutes, or follow package directions. Drain pasta, then rinse with cold water to stop the cooking. Drain thoroughly again."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk mayonnaise, mustard, garlic powder, salt, and pepper. Stir in Cheddar, pimentos, celery, onions, and cooked pasta until well combined. Fold in bacon, reserving 1 tablespoon for garnish."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

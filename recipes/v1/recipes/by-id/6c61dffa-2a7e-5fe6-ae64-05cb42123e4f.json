  "id": "6c61dffa-2a7e-5fe6-ae64-05cb42123e4f",
  "slug": "creamy-spring-vegetable-and-ham-pasta-recipe-11723236",
  "name": "Creamy Spring Vegetable and Ham Pasta",
  "recipe_type": "main",
  "brief_description": "This creamy spring vegetable and ham pasta is a lovely dish with leeks, asparagus, and peas\u2014a creative use for leftover ham. Made with fettuccine here, rotini or orecchiette would be nice, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain and keep warm."
    },
    {
      "position": 2,
      "text": "Heat butter in a 12-inch nonstick skillet over medium heat. When butter stops sizzling, add leeks and cook until tender, stirring frequently, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add asparagus; cook and stir until asparagus turns bright green and crisp-tender, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in ham and fresh garlic and cook until fragrant, about 1 minute. Add frozen green peas and cook for 2 more minutes."
    },
    {
      "position": 5,
      "text": "Stir in cream, salt, nutmeg, and black pepper until well blended, then add grated Parmesan. Stir until cheese is melted, and cook about 1 minute more."
    },
    {
      "position": 6,
      "text": "Combine sauce with hot pasta, garnish with fresh parsley, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

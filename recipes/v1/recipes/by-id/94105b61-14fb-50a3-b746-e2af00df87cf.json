  "schema_version": 1,
  "id": "94105b61-14fb-50a3-b746-e2af00df87cf",
  "slug": "chocolate-magic-cake-recipe-11949710",
  "name": "Chocolate Magic Cake",
  "recipe_type": "dessert",
  "brief_description": "This chocolate magic cake separates into 3 magic layers while baking: a light cakey top, jello-like center, and a fudgy bottom, and you will see all 3 layers in a cut slice. It has a light chocolate flavor, like milk chocolate, with an espresso bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8x8-inch baking dish or pan."
    },
    {
      "position": 2,
      "text": "Beat egg whites with an electric mixer on medium speed in a medium glass or metal bowl until stiff peaks form. Set aside."
    },
    {
      "position": 3,
      "text": "Beat white sugar and egg yolks with an electric mixer on medium speed in a large bowl until fluffy and lightened in color, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Gradually beat in melted butter, vanilla, instant espresso powder (if using), and salt until smooth and thickened, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Mix in flour and cocoa powder just until combined. Gradually beat in milk until smooth."
    },
    {
      "position": 6,
      "text": "Gently fold egg whites into the batter using a spatula until partially combined. Small lumps and streaks of egg white should still be visible; this will help create the cake's distinct layers. Transfer batter to prepared baking dish."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until top is golden and an instant-read thermometer inserted in the center registers 195 to 200 degrees F (91 to 93 degrees C), 45 to 50 minutes. The center should still jiggle slightly when gently shaken."
    },
    {
      "position": 8,
      "text": "Cool to room temperature on a wire rack, 1 1/2 to 2 hours. Cover and refrigerate until cold, 2 to 4 hours. Chilling also helps the layers fully set."
    },
    {
      "position": 9,
      "text": "Dust with powdered sugar before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

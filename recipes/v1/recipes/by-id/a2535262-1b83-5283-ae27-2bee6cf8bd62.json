  "id": "a2535262-1b83-5283-ae27-2bee6cf8bd62",
  "slug": "beer-brats",
  "name": "Beer Brats",
  "recipe_type": "main",
  "brief_description": "Brats are simmered with onions and spices in beer for fantastic flavor, then finished up on the grill for a perfectly crispy, charred exterior.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine beer and onion slices in a large pot; bring to a boil."
    },
    {
      "position": 3,
      "text": "Add bratwurst, pepper flakes, garlic powder, salt, and pepper to beer and onion mixture. Reduce heat to medium and cook for 10 to 12 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Transfer bratwurst to a plate. Reduce heat to low and let onions simmer until needed."
    },
    {
      "position": 6,
      "text": "Cook bratwurst on the preheated grill, turning occasionally to get char marks, until no longer pink in the middle, 5 to 10 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 7,
      "text": "Serve bratwurst with onions."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

  "id": "d493a7e3-b853-55e1-9650-d78313b40bd9",
  "slug": "chocolate-cheese-frosting",
  "name": "Best Chocolate Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "This chocolate cream cheese frosting is easy to make with cocoa powder for a rich, creamy, and perfectly pipeable topping on cakes and cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat confectioner\u2019s sugar, cream cheese, cocoa powder, butter, 3 tablespoons milk, vanilla, and cinnamon together in a large bowl until it reaches a spreadable consistency. Beat in remaining 1 tablespoon milk if necessary. Pipe or spread frosting onto cooled cake or cupcakes."
    }
  ],

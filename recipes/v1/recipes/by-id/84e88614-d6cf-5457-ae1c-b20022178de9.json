  "id": "84e88614-d6cf-5457-ae1c-b20022178de9",
  "slug": "camp-cornbread",
  "name": "Camp Cornbread",
  "recipe_type": "main",
  "brief_description": "Cream-style corn is added to corn muffin mix, making this recipe easy as well as portable.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking pan."
    },
    {
      "position": 2,
      "text": "Place the muffin mix a large mixing bowl. Stir in the milk and egg. Mix in the cream corn and sugar. Pour batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 30 minutes, or until a knife inserted into the center of pan comes out clean."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

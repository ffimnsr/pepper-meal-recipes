  "id": "b17a509f-9b8c-5429-9d8c-4cced92b0fea",
  "slug": "taco-nachos",
  "name": "Taco Nachos",
  "recipe_type": "appetizer",
  "brief_description": "This straightforward nacho recipe is sure to please. Ground beef and cheese are melted over chips to create a gooey, messy and delicious snack.",
  "cuisine": "Mexican Inspired Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground beef in a large, deep skillet. Cook over medium high heat until evenly brown. Drain and mix in taco seasoning mix and water. Continue cooking 5 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Place processed cheese and milk in a small, microwave safe bowl. Microwave on high until melted, 1 to 2 minutes. Stir until blended and smooth."
    },
    {
      "position": 3,
      "text": "Place tortilla chips on a large, microwave safe dish. Spread with refried beans. Top with beef and cheese and mixtures."
    },
    {
      "position": 4,
      "text": "Microwave approximately 2 minutes on high, until the cheese has melted into the beef. Top with tomato and green onions. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "3943410a-41c0-5a68-a3af-3824c9b5d43c",
  "slug": "snickerdoodle-zucchini-bread-recipe-7971181",
  "name": "Snickerdoodle Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "The top of this sweet and moist snickerdoodle zucchini bread is full of cracks and crevices filled with a cinnamon-sugar snickerdoodle topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a loaf pan with non-stick cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Combine 3/4 cup plus 2 tablespoons sugar, oil, egg, and vanilla in a large bowl; mix well. In another bowl, mix flour, cinnamon, baking soda, salt, baking powder, nutmeg, and cream of tartar. Add flour mixture to oil mixture. Stir until well combined. Batter will be very thick. Add zucchini and stir until well incorporated."
    },
    {
      "position": 3,
      "text": "Whisk 1/4 cup sugar and 1/2 teaspoon cinnamon together in a small bowl. Pour half the batter into the prepared pan, smoothing with a spatula and top with half of the cinnamon sugar. Top with remaining batter, smoothing with a spatula, and top with remaining cinnamon sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 45 to 55 minutes. Let cool on a wire rack for 15 minutes before turning out."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

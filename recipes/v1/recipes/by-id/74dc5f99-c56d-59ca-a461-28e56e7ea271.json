  "slug": "caprese-appetizer",
  "name": "Best Caprese Skewers",
  "recipe_type": "salad",
  "brief_description": "These caprese skewers are super simple to make. Your guests will love these fun, bite-sized salad appetizers of mozzarella, fresh basil, and tomatoes.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Toss tomatoes, mozzarella, olive oil, basil, salt, and pepper together in a bowl until well coated."
    },
    {
      "position": 3,
      "text": "Skewer one tomato and one piece of mozzarella on each toothpick."
    }
  ],
  "servings": 10,

  "id": "801647f2-c3d1-5af9-8aba-1f60b2704853",
  "slug": "mini-frittatas",
  "name": "Mini Frittatas",
  "recipe_type": "breakfast",
  "brief_description": "These are made in muffin tins and are fun to whip up and to eat. A cumin and lemon-spiced egg mixture is stirred into spinach, ricotta, parmesan and cheddar cheese. Then this delicious batter is poured into the waiting pan and baked.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to oven to 375 degrees F (190 degrees C). Lightly grease one 12-cup muffin tin."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine spinach, ricotta cheese, sour cream, Parmesan cheese, and Cheddar cheese."
    },
    {
      "position": 3,
      "text": "In a small mixing bowl, beat eggs, milk, hot sauce, cumin, black pepper, parsley, and lemon pepper. Stir egg mixture into spinach mixture."
    },
    {
      "position": 4,
      "text": "Spoon mixture into the prepared muffin tin. Bake in preheated oven for 20 to 25 minutes. Let stand for 5 minutes. Remove from muffin cups. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

  "id": "184aa92e-1873-5179-a264-6a660531191f",
  "slug": "daddys-shrimp-toast",
  "name": "Daddy's Shrimp Toast",
  "recipe_type": "appetizer",
  "brief_description": "Try this shrimp toast recipe for a special appetizer. Slices of bread topped with a seasoned shrimp and crab paste are pan-fried until crispy and golden.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the shrimp paste: Mix shrimp, onion, water chestnuts, celery, and green onion together in a mixing bowl. Stir in crabmeat, egg, parsley, sesame oil, garlic, soy sauce, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Make the dipping sauce: Whisk soy sauce, parsley, water, sesame oil, sugar, and garlic powder together in a small bowl."
    },
    {
      "position": 4,
      "text": "Make the toast: Heat 1/2 inch oil in a large, heavy skillet over medium heat."
    },
    {
      "position": 5,
      "text": "Spread each slice bread with a thick layer of shrimp paste, pressing gently so it sticks to bread."
    },
    {
      "position": 6,
      "text": "Working in batches, fry bread, paste-side down, in hot oil until golden and shrimp is pink, 2 to 3 minutes. Flip carefully and cook until bread is golden brown, about 1 minute. Drain on paper towels."
    },
    {
      "position": 7,
      "text": "Slice shrimp toasts diagonally and serve with dipping sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

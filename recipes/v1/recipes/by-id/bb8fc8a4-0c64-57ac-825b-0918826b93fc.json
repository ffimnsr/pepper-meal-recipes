  "id": "bb8fc8a4-0c64-57ac-825b-0918826b93fc",
  "slug": "makhani-daal-buttery-lentils",
  "name": "Makhani Daal (Buttery Lentils)",
  "recipe_type": "soup",
  "brief_description": "A spiced onion-tomato mixture is folded into pressure-cooked black lentils, chickpeas, and red kidney beans in this authentic Makhani Daal.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Place black lentils, chickpeas, and red kidney beans in a large container and cover with several inches of cool water; let soak, 6 hours to overnight."
    },
    {
      "position": 2,
      "text": "Pour lentil mixture and soaking liquid into a pressure cooker. Bring to high pressure according to manufacturer's instructions and cook until soft, about 20 minutes. Remove from heat and release pressure through natural release method according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Add onion, ginger, garlic, and cumin seeds; cook and stir until golden brown, about 3 minutes. Add tomatoes; cook and stir until softened, about 2 minutes. Stir in ground coriander, garam masala, red chile powder, turmeric, and salt."
    },
    {
      "position": 4,
      "text": "Fold onion mixture into cooked lentil mixture. Add butter, yogurt, and cilantro leaves; stir to incorporate."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

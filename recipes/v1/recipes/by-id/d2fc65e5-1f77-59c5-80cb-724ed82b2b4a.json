  "id": "d2fc65e5-1f77-59c5-80cb-724ed82b2b4a",
  "slug": "cranberry-jell-o-salad",
  "name": "Cranberry Jell-O Salad with Mandarin Oranges",
  "recipe_type": "salad",
  "brief_description": "A cranberry Jell-O salad with mandarin oranges is made with fresh cranberries, plus pecans, for a tasty, tangy, fruity flavor and a nutty crunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place cranberries, mandarin oranges, and pecans into a food processor and pulse several times to chop; process mixture until finely ground, about 30 seconds. Transfer mixture into a large bowl."
    },
    {
      "position": 2,
      "text": "Mix pineapple, gelatin, and sugar in a separate bowl. Add boiling water and cold water and stir together until gelatin and sugar have dissolved."
    },
    {
      "position": 3,
      "text": "Pour gelatin mixture into cranberry mixture and stir. Pour into a gelatin mold and refrigerate, 8 hours or overnight, before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

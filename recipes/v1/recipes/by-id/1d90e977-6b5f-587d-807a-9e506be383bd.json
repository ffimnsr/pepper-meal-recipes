  "id": "1d90e977-6b5f-587d-807a-9e506be383bd",
  "slug": "spicy-baked-tofu",
  "name": "Spicy Baked Tofu",
  "recipe_type": "main",
  "brief_description": "A spicy tofu marinade featuring soy sauce, hoisin sauce, chili sauce, and fresh ginger adds tons of flavor to baked tofu.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover a plate with two paper towels. Place tofu on top and cover with two more paper towels. Place a heavy plate over the stack and let sit until liquid emerges from tofu, 5 to 30 minutes. Cut tofu into 1/2-inch strips."
    },
    {
      "position": 2,
      "text": "Combine soy sauce, chili sauce, ginger, and hoisin sauce in a large resealable plastic bag. Add tofu, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 4,
      "text": "Remove tofu from marinade and shake off excess. Arrange on the prepared baking sheet. Discard remaining marinade."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm, 30 to 35 minutes, flipping halfway through."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

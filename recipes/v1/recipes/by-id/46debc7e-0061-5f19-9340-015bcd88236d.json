  "id": "46debc7e-0061-5f19-9340-015bcd88236d",
  "slug": "hot-spinach-and-artichoke-dip",
  "name": "Hot Spinach and Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Crowd-pleasing spinach and artichoke dip with crumbled bacon and Parmesan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large, deep skillet over medium-high heat until browned and crispy, 5 to 7 minutes. Drain on paper towels and crumble when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Combine artichoke hearts, spinach, Parmesan, sour cream, cheese spread, and mayonnaise in a mixing bowl. Add crumbled bacon and mix thoroughly. Spread mixture into a 7x11-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and lightly browned, about 20 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

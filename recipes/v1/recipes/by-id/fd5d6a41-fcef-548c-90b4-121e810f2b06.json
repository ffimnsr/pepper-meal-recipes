  "id": "fd5d6a41-fcef-548c-90b4-121e810f2b06",
  "slug": "jeffs-hot-dog-chili",
  "name": "Jeff's Hot Dog Chili",
  "recipe_type": "soup",
  "brief_description": "A hot dog chili recipe made with ground beef, spices, and no beans that's ready in 30 minutes. Serve over a hot dog in a bun for an easy family meal!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place ground beef and water in a large saucepan; break apart beef using a potato masher."
    },
    {
      "position": 3,
      "text": "Stir in tomato sauce, ketchup, chili powder, salt, black pepper, sugar, onion powder, and Worcestershire sauce."
    },
    {
      "position": 4,
      "text": "Bring to a boil, then simmer over medium heat until beef is cooked and chili thickens, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Serve over hot dogs and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

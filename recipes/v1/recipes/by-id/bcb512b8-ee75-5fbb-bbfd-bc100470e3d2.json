  "id": "bcb512b8-ee75-5fbb-bbfd-bc100470e3d2",
  "slug": "curtido-el-salvadoran-cabbage-salad",
  "name": "Curtido (El Salvadoran Cabbage Salad)",
  "recipe_type": "salad",
  "brief_description": "This El Salvadoran cabbage salad is used as a relish or served with pupusas, which are thick, hand-made tortillas, very common in Latin American cuisine.",
  "cuisine": "Salvadoran",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the cabbage and carrot in a large bowl and pour the boiling water over the mixture. Allow the mixture to steep for 5 minutes; drain well. Return the cabbage and carrots to the bowl. Mix in the green onion, vinegar, 1/2 cup of water, and oregano. Toss until all ingredients are combined. Chill for 20 minutes before serving."
    }
  ],
  "servings": 4,

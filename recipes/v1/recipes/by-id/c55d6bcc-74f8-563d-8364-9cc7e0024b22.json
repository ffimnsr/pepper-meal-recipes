  "id": "c55d6bcc-74f8-563d-8364-9cc7e0024b22",
  "slug": "ians-potato-vegetable-soup",
  "name": "Ian's Potato-Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "Start with potatoes, carrots, onions, and celery, and then you decide what other vegetables go in to the pot. Cream of celery soup and parsley are added once the vegetables are tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large stock pot boil potatoes in water and add salt. Cook potatoes until tender and soft and then add carrots, celery, chopped onions, vegetable of your choice, oil and beef bouillon. Mix together and cook until all vegetables are soft."
    },
    {
      "position": 2,
      "text": "Add cream of celery soup and season with parsley, onion powder and pepper. If you desire a thinner type of soup you may want to add 1/2 cup of water."
    },
    {
      "position": 3,
      "text": "Heat soup through, stirring occasionally, and serve."
    }
  ],
  "servings": 5,

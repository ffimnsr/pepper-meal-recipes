  "id": "12dc7c6e-d718-5041-8f51-7269c0995d16",
  "slug": "homemade-dog-food-with-chicken",
  "name": "Homemade Dog Food with Chicken",
  "recipe_type": null,
  "brief_description": "Pup-approved and completely homemade in your very own kitchen, this make-it-yourself dog food recipe stars chicken thighs, green beans, and oatmeal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water and oats into a rice cooker. Seal and select setting according to the manufacturer's instructions; cook until tender, about 15 minutes. Pull out the pot as soon as the unit switches to the Warm setting. Set aside."
    },
    {
      "position": 2,
      "text": "Heat oil over high heat in a large frying pan or wok. Add chicken, cover, and cook for 4 minutes, stirring every minute. Add green beans, cover, and cook for 4 minutes, stirring every minute. Stir in aminos and break up mixture using a spatula. Cover, reduce the heat to low, and simmer for 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in cooked oatmeal and break up again using a spatula. Remove from the heat and let cool completely, 20 to 30 minutes. Package in desired portions for freezing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

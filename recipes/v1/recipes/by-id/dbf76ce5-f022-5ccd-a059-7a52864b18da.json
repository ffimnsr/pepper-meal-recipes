  "id": "dbf76ce5-f022-5ccd-a059-7a52864b18da",
  "slug": "spicy-honey-peanut-baked-chicken-thighs",
  "name": "Spicy Honey-Peanut Baked Chicken Thighs",
  "recipe_type": "dessert",
  "brief_description": "Marinated in powdered peanut butter and hot honey, these baked chicken thighs are a wonderfully sweet and spicy dish. Tastes great served over rice, noodles, or even potatoes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken thighs on both sides with salt and pepper."
    },
    {
      "position": 2,
      "text": "Mix peanut butter powder and water together in a large bowl until fully incorporated. Stir in hot honey, soy sauce, and garlic powder; mix until well combined. Add chicken thighs and turn in marinade, making sure both sides are well coated. Cover bowl and refrigerate 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Transfer chicken thighs to an oven-proof dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until chicken is no longer pink at the bone and the juices run clear, 35 to 45 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

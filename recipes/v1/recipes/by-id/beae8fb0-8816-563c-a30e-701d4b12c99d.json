  "id": "beae8fb0-8816-563c-a30e-701d4b12c99d",
  "slug": "cajun-blackened-catfish",
  "name": "Cajun Blackened Catfish",
  "recipe_type": "main",
  "brief_description": "Blackened catfish fillets are coated in spice and pan-fried in a hot cast-iron skillet for a classically Cajun dish that's quick, easy, and tasty.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together salt, black and cayenne pepper, garlic powder, onion powder, paprika, parsley, oregano, and thyme in a shallow bowl until thoroughly combined. Press catfish fillets into the spice mixture to thoroughly coat."
    },
    {
      "position": 2,
      "text": "Melt butter in a bowl and set aside."
    },
    {
      "position": 3,
      "text": "Arrange a portable heat source outdoors, such as a butane burner or side burner of a gas grill. Light the burner, and place a large cast-iron skillet onto the burner over high heat. Pour about 1/4 cup melted butter into the skillet."
    },
    {
      "position": 4,
      "text": "When butter in the skillet is smoking hot, lay catfish fillets into the skillet. Cook until the spices are burned onto the fillets and the catfish is opaque and flaky inside, about 3 minutes per side. Don't breathe the smoke."
    },
    {
      "position": 5,
      "text": "To serve, pour remaining 1/2 cup butter over the catfish."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "super-simple-salmon",
  "name": "Easy 5-Ingredient Salmon",
  "recipe_type": "main",
  "brief_description": "This easy salmon recipe delivers big flavor with just a few pantry and fridge staples. Pan-searing in butter browns the fillets but keeps them moist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir garlic powder, basil, and salt together in a small bowl."
    },
    {
      "position": 3,
      "text": "Rub the mixture evenly over salmon."
    },
    {
      "position": 4,
      "text": "Melt butter in a large skillet over medium heat. Add salmon and cook until browned and flaky, about 5 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve salmon with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

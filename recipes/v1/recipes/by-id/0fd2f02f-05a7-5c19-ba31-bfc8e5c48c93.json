  "id": "0fd2f02f-05a7-5c19-ba31-bfc8e5c48c93",
  "slug": "luscious-lemon-snaps",
  "name": "Luscious Lemon Snaps",
  "recipe_type": "dessert",
  "brief_description": "This is THE cookie for the lemon lover. Not overly sweet, but tangy from fresh lemons.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F ( 175 degrees C ). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a medium bowl, stir together the flour, sugar, baking soda, salt, and lemon zest. Make a well in the center and fill it with the oil, lemon juice, and vanilla. Stir everything together until it forms a dough. Alternate method: Put everything into the food processor and blend until dough forms."
    },
    {
      "position": 3,
      "text": "Drop cookie dough by teaspoonfuls, about 2 inches apart, onto the prepared cookie sheet. Bake for 10 to 12 minutes in the preheated oven. Edges should be golden brown. For a softer cookie, bake for only 7 minutes. Cool on racks, and store in an airtight container."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

  "id": "d1127bff-ca7f-54b6-ada7-399a18a9c845",
  "slug": "leslies-salty-grilled-potatoes",
  "name": "Leslie's Salty Grilled Potatoes",
  "recipe_type": "side",
  "brief_description": "Get perfectly cooked baked potatoes on the grill that are fluffy and tender inside with crispy, buttery skin that will have everyone asking for more!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-low heat."
    },
    {
      "position": 3,
      "text": "Prepare four foil squares each large enough to fold over one potato. Spread butter onto foil in a large enough area that the potato will be completely covered when rolled up. Sprinkle salt, garlic, pepper, and Italian seasoning evenly over foil. Roll each potato in the foil; puncture the package (including the potato) with a fork or knife a few times."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill until soft, turning potatoes often, about 1 hour."
    },
    {
      "position": 5,
      "text": "Serve with your favorite toppings."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "6b6a5540-8298-5fb9-aec0-0add82555d53",
  "slug": "classic-tiramisu",
  "name": "Classic Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This tiramisu recipe gently cooks egg yolks and whips them with creamy mascarpone; spread over coffee liqueur-soaked ladyfingers and top with cocoa and chocolate curls.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine egg yolks and sugar in the top of a double boiler, over boiling water. Reduce heat to low, and cook for about 10 minutes, stirring constantly. Remove from heat and whip yolks until thick and lemon-colored."
    },
    {
      "position": 3,
      "text": "Add mascarpone to whipped yolks. Beat until combined."
    },
    {
      "position": 4,
      "text": "In a separate bowl, whip cream to stiff peaks. Gently fold into yolk mixture and set aside."
    },
    {
      "position": 5,
      "text": "Split the lady fingers in half, and line the bottom and sides of a large glass bowl. Brush with coffee liqueur."
    },
    {
      "position": 6,
      "text": "Spoon half of the cream filling over the lady fingers."
    },
    {
      "position": 7,
      "text": "Repeat ladyfingers, coffee liqueur and filling layers."
    },
    {
      "position": 8,
      "text": "Garnish with cocoa and chocolate curls. Refrigerate several hours or overnight. Enjoy!"
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

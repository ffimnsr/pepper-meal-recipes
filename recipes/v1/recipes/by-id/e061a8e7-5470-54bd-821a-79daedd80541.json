  "id": "e061a8e7-5470-54bd-821a-79daedd80541",
  "slug": "blackberry-pie-i",
  "name": "Blackberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This tasty blackberry pie recipe is so simple to make with store-bought pie crust. Use fresh or frozen blackberries and serve with vanilla ice cream.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 3 \u00bd cups of blackberries with 1/2 cup sugar and flour in a large bowl. Spoon mixture into the unbaked pie crust. Spread remaining 1/2 cup of blackberries on top of sweetened berries."
    },
    {
      "position": 3,
      "text": "Cover with the top crust. Seal and crimp the edges, and cut vents in the top crust for steam to escape."
    },
    {
      "position": 4,
      "text": "Brush the top crust with milk and sprinkle with remaining 1/4 cup sugar."
    },
    {
      "position": 5,
      "text": "Bake pie in the preheated oven for 15 minutes. Reduce the temperature of the oven to 375 degrees F (190 degrees C) and bake until filling is bubbly and crust is golden brown, an additional 20 to 25 minutes. Cool on wire rack."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 40,

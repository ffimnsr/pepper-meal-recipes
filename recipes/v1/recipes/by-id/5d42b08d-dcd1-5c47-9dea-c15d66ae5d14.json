  "id": "5d42b08d-dcd1-5c47-9dea-c15d66ae5d14",
  "slug": "shepherds-pie-mexicana",
  "name": "Shepherd's Pie Mexicana",
  "recipe_type": "main",
  "brief_description": "Great shepherd's pie with a kick. A classic casserole spiced up with the flavors of Mexico. Adjust seasonings according to your personal taste.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat a 9 inch square baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender enough to pierce with a fork; drain. Mash by hand using a potato masher or sturdy whisk. Mix in butter, milk, garlic powder, and salt and pepper to taste. Set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Add onions; cook and stir until softened, 8 to 10 minutes. Add garlic and ground beef and cook until meat loses its pink color. Season with seasoned salt and taco seasoning. Add peas and corn and stir until blended."
    },
    {
      "position": 4,
      "text": "Pour beef and vegetable mixture into prepared baking dish. Cover with mashed potatoes."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until potatoes are golden and beef and vegetable mixture is hot and bubbly, 30 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

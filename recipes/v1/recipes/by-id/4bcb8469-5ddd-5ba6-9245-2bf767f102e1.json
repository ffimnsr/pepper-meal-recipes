  "slug": "chopped-chili-garlic-green-beans-recipe-11786299",
  "name": "Chopped Chili Garlic Green Beans",
  "recipe_type": "side",
  "brief_description": "These chopped chili garlic green beans are seasoned with chili crisp, garlic, and lime\u2014the perfect side dish for any meat or fish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add green beans and green onions. Cook, stirring often, until green beans begin to turn bright green and slightly char, about 5 minutes. Season with lime juice, soy sauce, garlic, sugar, and salt and continue cooking until sauce starts to thicken, about 2 minutes; remove from heat."
    },
    {
      "position": 2,
      "text": "Add chili crisp, lime zest, and sesame seeds to green beans and toss well before serving. Serve immediately or chill before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "8323d833-2408-5bcc-bae6-8f76e6248f92",
  "slug": "cream-cheese-and-crab-sushi-rolls",
  "name": "Cream Cheese and Crab Sushi Rolls",
  "recipe_type": "appetizer",
  "brief_description": "This crab sushi roll with imitation crabmeat recipe is delicious and surprisingly simple to make. Roll up sushi with crab, cream cheese, and cucumber.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring rice and water to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until the rice is tender, and the liquid has been absorbed, 20 to 25 minutes. Stir in rice vinegar and salt. Allow to cool completely."
    },
    {
      "position": 3,
      "text": "Lay out seaweed sheets. Moisten hands with water, then spread cooled rice evenly on each sheet, leaving a 1/2-inch gap along one edge, lengthwise. Arrange strips of cucumber, imitation crabmeat, and cream cheese on top of the rice in a straight line along the side opposite the gap. Roll up sushi from the toppings to the seaweed sheet's exposed end."
    },
    {
      "position": 4,
      "text": "Using a sharp wet knife, slice each roll into 5 or 6 pieces. Serve with minced ginger on the side."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

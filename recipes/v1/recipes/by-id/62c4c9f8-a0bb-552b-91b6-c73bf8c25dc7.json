{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "62c4c9f8-a0bb-552b-91b6-c73bf8c25dc7",
  "slug": "hawaiian-loco-moco",
  "name": "Hawaiian Loco Moco",
  "recipe_type": "main",
  "brief_description": "Hawaiian loco moco is typically made with Spam, but this comforting version of an island favorite features ground chuck under a fried egg and gravy.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a large skillet with cooking spray and heat over medium heat."
    },
    {
      "position": 2,
      "text": "Divide ground chuck into four equal portions; form into patties."
    },
    {
      "position": 3,
      "text": "Fry patties in the hot skillet until they begin to firm, are hot, and are slightly pink in the center, about 6 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C). Remove patties to a plate, retaining drippings in the skillet."
    },
    {
      "position": 4,
      "text": "Stir onion and water into reserved drippings. Reduce heat to low and cook until onion is slightly softened, about 5 minutes. Add mushrooms; cook and stir until mushrooms are cooked through, about 5 minutes more."
    },
    {
      "position": 5,
      "text": "Pour gravy over onion-mushroom mixture; stir. Cook until gravy is hot, about 5 minutes. Gently lie patties into gravy; simmer until reheated through."
    },
    {
      "position": 6,
      "text": "While patties simmer in gravy, grease a separate skillet with cooking spray and heat over medium heat. Fry eggs in the hot skillet until whites are opaque, but yolks remain runny, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Divide cooked rice between four plates. Top each rice portion with a beef patty and cover each patty with an egg. Pour gravy equally over each portion."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

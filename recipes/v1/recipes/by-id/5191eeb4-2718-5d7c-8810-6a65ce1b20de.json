  "id": "5191eeb4-2718-5d7c-8810-6a65ce1b20de",
  "slug": "seven-layer-taco-dip",
  "name": "Seven-Layer Taco Dip",
  "recipe_type": "appetizer",
  "brief_description": "This taco dip recipe layers refried beans, salsa, lettuce, veggies, Cheddar cheese, sour cream, and olives to make a delicious party appetizer.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Blend refried beans and taco seasoning in a medium bowl; spread mixture onto a large serving platter."
    },
    {
      "position": 3,
      "text": "Mix sour cream and cream cheese in a medium bowl; spread over refried beans."
    },
    {
      "position": 4,
      "text": "Top with salsa. Layer tomato, bell pepper, green onions, and lettuce over top."
    },
    {
      "position": 5,
      "text": "Sprinkle over Cheddar cheese and garnish with black olives."
    }
  ],
  "servings": 56,

  "id": "ee7c23b1-ca87-5cc2-9afa-e436313043c5",
  "slug": "simple-egg-and-cheese-breakfast-quesadillas",
  "name": "Simple Egg and Cheese Breakfast Quesadillas",
  "recipe_type": "breakfast",
  "brief_description": "These simple egg and cheese breakfast quesadillas filled with bell pepper and onion are easy to make ahead and can be warmed in a microwave or toaster oven.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Beat 2 eggs with 1 1/2 tablespoons milk in a bowl."
    },
    {
      "position": 2,
      "text": "Melt 1 teaspoon butter in a 6-inch frying pan over medium heat. Add bell pepper and onion; cook until onion is translucent, about 5 minutes. Remove 1/2 of the mixture and set aside in a bowl."
    },
    {
      "position": 3,
      "text": "Pour egg mixture and remaining vegetable mixture into the skillet. Tilt the pan, gently push one side of the egg, without breaking it, away from the side of the pan, and let the uncooked egg run onto the pan. Repeat with all 4 sides of the egg, cooking until the bottom is set, about 2 minutes. Flip over and cook until bottom is slightly browned, 1 to 2 minutes more."
    },
    {
      "position": 4,
      "text": "Slide omelet onto a tortilla, then slide tortilla back onto the pan. Place 1 cheese slice onto the omelet and top with another tortilla. Cook until the bottom is browned, about 2 minutes. Flip and brown opposite side, about 1 minute more. Slide quesadilla onto a plate and cut into 4 pieces."
    },
    {
      "position": 5,
      "text": "Beat remaining 2 eggs and 1 1/2 tablespoons milk together in a bowl. Grease the same pan with remaining 1 teaspoon butter. Repeat steps 3 and 4 with reserved vegetable mixture and remaining cheese and tortillas."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b933aa7f-efac-539c-9210-87fd3fc98818",
  "slug": "peach-blueberry-streusel-tart",
  "name": "Peach-Blueberry Streusel Tart",
  "recipe_type": "dessert",
  "brief_description": "This delicious peach-blueberry streusel tart recipe features a homemade cinnamon and sugar crust and a rolled oats topping for a perfect summer treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch tart pan with a removable bottom."
    },
    {
      "position": 2,
      "text": "Combine 1 \u2153 cups flour, white sugar, \u00bd teaspoon cinnamon, \u00bc teaspoon salt, \u215b teaspoon nutmeg, and cardamom in a bowl; stir in \u00bd cup melted butter and 1 teaspoon vanilla extract until evenly moistened. Press mixture into bottom and up sides of the prepared pan; prick bottom of crust several times with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until just beginning to brown, 15 to 20 minutes. Cool."
    },
    {
      "position": 4,
      "text": "Toss peaches, blueberries, honey, and lemon juice together in a bowl until combined and coated; pour into cooled crust, slightly mounding filling in the middle."
    },
    {
      "position": 5,
      "text": "Combine \u00bc cup flour, oats, brown sugar, \u00bc teaspoon cinnamon, \u215b teaspoon nutmeg, and 1 pinch salt in a bowl; stir in 3 tablespoons melted butter and \u00bd teaspoon vanilla extract until mixture resembles coarse crumbs. Sprinkle topping evenly over filling."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until topping is lightly browned and filling is bubbling, 37 to 42 minutes. Cool, then remove from pan. Chill in the refrigerator before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

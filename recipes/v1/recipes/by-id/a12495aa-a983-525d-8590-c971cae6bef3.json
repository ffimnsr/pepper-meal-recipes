  "id": "a12495aa-a983-525d-8590-c971cae6bef3",
  "slug": "cheddar-herb-soda-bread-recipe-11849950",
  "name": "Cheddar Herb Soda Bread",
  "recipe_type": "soup",
  "brief_description": "This Cheddar herb soda bread is a wonderful quick bread that is absolutely perfect for soup season. Its dense but light and chewy at the same time. Feel free to vary the fresh herbs and cheese to suit any main course.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment and dust a work surface lightly with flour."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking soda, and salt together in a large bowl. Add green onion tops, rosemary, and thyme, and toss to combine; stir in Cheddar cheese."
    },
    {
      "position": 3,
      "text": "Pour in buttermilk and stir just until no dry flour remains. Dump dough onto the floured work surface and scrape the bowl out completely\u2014dough will be sticky. Flour hands liberally, and knead the dough just until it comes together to form a smooth ball."
    },
    {
      "position": 4,
      "text": "Place dough ball onto the prepared baking sheet. Pat dough out until it forms roughly a 7- to 8-inch round loaf. Using a sharp knife or lame, score a cross onto the surface of the dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Remove from the oven; reduce the temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake another 20 minutes. Check the bottom of the bread. If it is still pale and uncooked, flip bread over so the bottom is now on top, and bake for 10 more minutes. Bread should be golden brown and hollow sounding when tapped."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

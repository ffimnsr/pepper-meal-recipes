  "id": "a70d34ac-c86c-5a74-ae13-64c03d0b061c",
  "slug": "slow-cooker-pineapple-pulled-pork",
  "name": "Slow Cooker Pineapple Pulled Pork",
  "recipe_type": "main",
  "brief_description": "Pulled pork and pineapple are tender, juicy, and easy to make in the slow cooker. Just throw it together, let it cook, and come home to a tasty meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pineapple, garlic, cumin, salt, red pepper flakes, and pepper in a bowl."
    },
    {
      "position": 2,
      "text": "Place pork roast into a slow cooker. Pour pineapple mixture over top. Cover and cook on Low until pork is slightly pink in the center and cooked through, about 8 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove pork roast from the slow cooker. Cut away any fat, then shred meat using two forks. Return meat to the slow cooker and mix with the juices."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 480,

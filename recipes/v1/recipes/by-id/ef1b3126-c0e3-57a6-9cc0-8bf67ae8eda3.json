  "id": "ef1b3126-c0e3-57a6-9cc0-8bf67ae8eda3",
  "slug": "apple-crisp-cups",
  "name": "Apple Crisp Cups",
  "recipe_type": "dessert",
  "brief_description": "This apple crisp cups recipe makes tiny, mini apple crisps, baked in sublime buttery, cinnamon-sugar sweetened oat cups for yummy one-bite treats.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease four 12-cup mini-muffin tins."
    },
    {
      "position": 2,
      "text": "Mix apples, water, white sugar, and 1/2 teaspoon cinnamon together in a medium saucepan; bring to a simmer over medium-low heat, stirring occasionally. Simmer until apples are partially cooked, about 5 minutes; remove from heat."
    },
    {
      "position": 3,
      "text": "Combine flour, oats, brown sugar, remaining 1 teaspoon cinnamon, and nutmeg in a large bowl; cut butter into flour mixture with a pastry cutter until mixture resembles coarse crumbs."
    },
    {
      "position": 4,
      "text": "Press a heaping tablespoon of crust mixture into each muffin cup to cover bottom and sides of cup; patch holes with crust mixture."
    },
    {
      "position": 5,
      "text": "Place about 2 teaspoons filling in each cup. Crumble about 1 teaspoon of remaining crust mixture on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "4b45d1f6-664c-5f43-aaf3-ad44c0c503f4",
  "slug": "loaded-bacon-ranch-mac-and-cheese-casserole-recipe-8758303",
  "name": "Loaded Bacon Ranch Mac and Cheese Casserole",
  "recipe_type": "main",
  "brief_description": "This loaded bacon ranch mac and cheese casserole adds bacon and ranch, Cheddar cheese, sour cream, chicken, and broccoli to boxed mac and cheese for a rich, full, all-in-one dinner casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a casserole dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add macaroni and cook just until al dente, 5 to 6 minutes. Drain; return macaroni to the pot."
    },
    {
      "position": 3,
      "text": "Stir in cream cheese, 4 tablespoons butter, milk, and powdered cheese packets included in mac and cheese box until well combined. Stir in sour cream, 3/4 cup Cheddar cheese, and ranch mix until combined. Add in chicken, broccoli, and bacon. Reserve 2 tablespoons green onions and stir in remaining green onions. Pour mixture into a lightly greased casserole dish and sprinkle with remaining cheese."
    },
    {
      "position": 4,
      "text": "Melt remaining butter and add to a small bowl with panko and pepper. Stir to combine and sprinkle mixture evenly over casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly and lightly browned, 20 to 25 minutes. Sprinkle with reserved green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

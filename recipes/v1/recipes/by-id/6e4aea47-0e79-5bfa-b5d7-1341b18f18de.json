  "id": "6e4aea47-0e79-5bfa-b5d7-1341b18f18de",
  "slug": "hot-artichoke-spinach-dip",
  "name": "Hot Artichoke and Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "Three cheeses bring their distinctive flavors to this rich, delicious hot artichoke dip!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "In a blender or food processor, place artichoke hearts, Romano cheese, Parmesan cheese and garlic . Pulse until chopped, but not ground. Set aside."
    },
    {
      "position": 3,
      "text": "In a medium bowl, mix together spinach, heavy cream, sour cream and mozzarella cheese. Stir in artichoke mixture. Spoon into prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 to 25 minutes, or until cheese is melted and bubbly."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

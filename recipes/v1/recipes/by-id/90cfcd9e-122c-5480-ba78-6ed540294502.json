  "id": "90cfcd9e-122c-5480-ba78-6ed540294502",
  "slug": "pumpkin-ginger-cupcakes",
  "name": "Pumpkin Ginger Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These ginger cupcakes are delicious, light, and fluffy. They taste of fall, and the crystallized ginger gives them a lovely little zing. Even people who don't like pumpkin love these cupcakes. These disappear as fast as I can set them out.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 24 muffin cups or line with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk together flour, pudding mix, crystallized ginger, cinnamon, baking soda, ground ginger, allspice, cloves, and salt in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat butter, white sugar, and brown sugar in a large bowl with an electric mixer until light and fluffy. Add eggs one at a time, mixing well after each addition; beat in pumpkin pur\u00e9e and vanilla with last egg. Stir in flour mixture, mixing until just combined. Divide batter between the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 20 minutes. Cool muffins in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3c258493-6eb0-568f-ac20-9f5acfae7eed",
  "slug": "watermelon-salad-with-mint-dressing",
  "name": "Watermelon Salad with Mint Dressing",
  "recipe_type": "salad",
  "brief_description": "This refreshing watermelon salad recipe with feta and red onion relies on a lime juice and fresh mint leaves dressing for a sweet-salty summer salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine watermelon, red onion, olives, and feta cheese in a large bowl."
    },
    {
      "position": 2,
      "text": "Combine lime juice, mint, salt, and black pepper in a small bowl; whisk in olive oil until blended. Pour over watermelon mixture; stir until evenly coated."
    },
    {
      "position": 3,
      "text": "Chill salad in the refrigerator until ready to serve."
    }
  ],
  "servings": 2,

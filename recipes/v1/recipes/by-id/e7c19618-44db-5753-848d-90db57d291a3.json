  "id": "e7c19618-44db-5753-848d-90db57d291a3",
  "slug": "the-real-mojito",
  "name": "The Real Mojito",
  "recipe_type": "drink",
  "brief_description": "Considered Cuba's national drink, this mojito cocktail is a favorite with pirates, swashbucklers, and colorful characters in the Caribbean and beyond.",
  "cuisine": "Cuban Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place mint leaves and 1 lime wedge into a sturdy glass. Use a muddler and crush to release mint oils and lime juice."
    },
    {
      "position": 3,
      "text": "Add remaining lime wedges and 2 tablespoons sugar, and muddle again to release the lime juice. Do not strain the mixture."
    },
    {
      "position": 4,
      "text": "Fill the glass almost to the top with ice."
    },
    {
      "position": 5,
      "text": "Pour in rum and fill the glass with club soda."
    },
    {
      "position": 6,
      "text": "Stir, taste, and add more sugar if desired."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "a5b637c0-ef29-5764-ad4f-1a0e13d11a16",
  "slug": "slow-cooker-pot-roast",
  "name": "Easy Slow Cooker Pot Roast",
  "recipe_type": "main",
  "brief_description": "An easy slow cooker pot roast recipe that comes together quickly with the help of convenient packaged mixes for delicious flavor and tender beef.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray the inside of a slow cooker with cooking spray. Spread onion slices in the bottom of the cooker."
    },
    {
      "position": 2,
      "text": "Pat roast dry and sprinkle all over with salt and pepper. Spread flour onto a work surface and roll roast in flour to coat all sides, using your hands or a small sturdy plate to pound flour into the meat. Place floured roast into the slow cooker on top of onions."
    },
    {
      "position": 3,
      "text": "Whisk together beef gravy mix, ranch dressing mix, and Italian dressing mix in a bowl, then add water and whisk until smooth. Pour over roast. Distribute carrots around the meat."
    },
    {
      "position": 4,
      "text": "Cover the slow cooker, set to Low, and cook until roast is tender and gravy has thickened, about 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

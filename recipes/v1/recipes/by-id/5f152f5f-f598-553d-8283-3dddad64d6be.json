  "id": "5f152f5f-f598-553d-8283-3dddad64d6be",
  "slug": "sangria-white",
  "name": "White Wine Sangria",
  "recipe_type": "drink",
  "brief_description": "This white wine sangria combines rum and lemon-lime soda with your favorite white wine, apples, and grapes for a deliciously refreshing summer punch.",
  "cuisine": "U.S. Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Stir white wine, rum, orange juice, and sugar together in a large pitcher until sugar is dissolved; add apple, lemon, and lime slices. Gently stir lemon-lime soda into the wine mixture."
    },
    {
      "position": 3,
      "text": "Put frozen grapes into serving glasses and pour sangria over the grapes."
    }
  ],
  "servings": 8,

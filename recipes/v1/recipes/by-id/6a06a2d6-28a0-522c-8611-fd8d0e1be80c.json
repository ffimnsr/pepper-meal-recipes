  "id": "6a06a2d6-28a0-522c-8611-fd8d0e1be80c",
  "slug": "mint-juleps",
  "name": "Mint Julep",
  "recipe_type": "dessert",
  "brief_description": "A mint julep is made with Kentucky bourbon, sweetened with simple syrup, and served chilled with fresh mint for a classic and refreshing cocktail.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Make the simple syrup ahead of when you plan to serve: Bring water, sugar, and chopped mint to a boil over high heat in a small saucepan."
    },
    {
      "position": 3,
      "text": "Cook, stirring occasionally, until sugar is completely dissolved, 1 to 2 minutes. Remove from the heat and let cool ."
    },
    {
      "position": 4,
      "text": "Pour syrup through a strainer to remove mint leaves."
    },
    {
      "position": 5,
      "text": "To make the mint juleps: Fill eight glasses with crushed ice; pour 4 ounces bourbon and 1/4 cup mint syrup into each cup."
    },
    {
      "position": 6,
      "text": "Top each drink with a mint sprig."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

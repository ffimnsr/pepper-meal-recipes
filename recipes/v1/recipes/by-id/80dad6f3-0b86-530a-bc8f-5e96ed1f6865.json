  "id": "80dad6f3-0b86-530a-bc8f-5e96ed1f6865",
  "slug": "chai-spice-monkey-bread",
  "name": "Chai Spice Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "In this quick and easy recipe, the addition of chai spices offers an elegant twist to the classic monkey bread, an irresistible dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt\u00ae)."
    },
    {
      "position": 2,
      "text": "Combine 7 tablespoons brown sugar, white sugar, cinnamon, cardamom, ginger, cloves, and pepper in a large bowl. Add biscuits; coat liberally with sugar-spice mixture."
    },
    {
      "position": 3,
      "text": "Arrange coated biscuits evenly in the prepared pan. Sprinkle 1 tablespoon brown sugar throughout and on top of biscuits; pour melted butter all over."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until puffed and golden brown, 30 to 40 minutes. Cool for about 15 minutes. Invert onto a serving plate."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

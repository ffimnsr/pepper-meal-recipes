  "slug": "creamy-parmesan-polenta",
  "name": "Creamy Parmesan Polenta",
  "recipe_type": "appetizer",
  "brief_description": "Creamy polenta is easy to make when starting with packaged polenta, chicken broth, and Parmesan cheese. It's a delicious side, starter, or base for stew.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine polenta and chicken broth in a saucepan over medium heat. Cook, stirring continuously, until polenta has broken down completely in broth, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Remove from the heat. Stir in Parmesan cheese, pepper, and paprika."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

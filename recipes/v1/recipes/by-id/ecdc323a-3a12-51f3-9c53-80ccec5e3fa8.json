  "id": "ecdc323a-3a12-51f3-9c53-80ccec5e3fa8",
  "slug": "slow-cooker-buffalo-chicken-dip",
  "name": "Slow Cooker Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "This delicious Buffalo chicken dip is prepared solely in your slow cooker! Chicken breasts are cooked and shredded, then cooked with cheese, sour cream, and Buffalo wing hot sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken breasts with salt, pepper, and garlic powder. Place in the slow cooker and cover with the lid."
    },
    {
      "position": 2,
      "text": "Cook on Low until chicken is cooked through, about 3 hours. Drain accumulated juices. Shred chicken using a hand mixer. Add cream cheese, sour cream, Buffalo wing sauce, and Cheddar cheese. Cook on Low for 1 more hour. Stir to combine."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 240,

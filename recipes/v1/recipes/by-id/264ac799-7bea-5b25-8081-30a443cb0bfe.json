  "id": "264ac799-7bea-5b25-8081-30a443cb0bfe",
  "slug": "herb-rubbed-sirloin-tip-roast",
  "name": "Herb Rubbed Sirloin Tip Roast",
  "recipe_type": "main",
  "brief_description": "This sirloin tip roast is rubbed with a homemade marinade of herbs and olive oil, then roasted until juicy, deeply flavored, and beautifully tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix paprika, kosher salt, garlic powder, black pepper, onion powder, cayenne pepper, oregano, and thyme in a small bowl."
    },
    {
      "position": 3,
      "text": "Stir in olive oil; allow mixture to sit for about 15 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 5,
      "text": "Place roast on the prepared baking sheet. Rub spice mixture all over roast."
    },
    {
      "position": 6,
      "text": "Roast in the preheated oven until an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), about 1 hour."
    },
    {
      "position": 7,
      "text": "Let sit 15 minutes before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "66b01a2e-9c4b-5773-ab1d-2c17adec840a",
  "slug": "air-fryer-oven-buffalo-chicken-jerky-sticks",
  "name": "Air Fryer Oven Buffalo Chicken Jerky Sticks",
  "recipe_type": "appetizer",
  "brief_description": "If you love Buffalo chicken, you'll want to make some of this jerky for your next hiking adventure or camping trip.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground chicken, 1/4 cup cayenne pepper sauce, sea salt, pepper, celery seed, garlic powder, onion powder, and pink curing salt in a large bowl; mix until evenly combined. Cover and refrigerate for 8 hours, or overnight."
    },
    {
      "position": 2,
      "text": "Use a jerky gun to form sticks of the meat mixture on air fryer oven racks."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 160 degrees F (70 degrees C)."
    },
    {
      "position": 4,
      "text": "Place racks into the air fryer and set timer for 2 hours. Flip the sticks over using a fork. Brush remaining 2 tablespoons cayenne pepper sauce over the tops. Air fry for 30 minutes more."
    },
    {
      "position": 5,
      "text": "Let cool completely and transfer to an airtight container."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "11011f22-1831-53ed-886e-c99d8ea98c2b",
  "slug": "thai-coconut-curry-potsticker-soup-recipe-11932915",
  "name": "Thai Coconut Curry Potsticker Soup",
  "recipe_type": "soup",
  "brief_description": "This Thai coconut curry potsticker soup has a rich Thai-curry spiced coconut broth seasoned with ginger and lemongrass, simmered with mushrooms, bok choy, and carrots, and potstickers in each bowl.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Cook potstickers according to label instructions and set aside."
    },
    {
      "position": 2,
      "text": "Add sesame oil to a Dutch oven over medium heat. Once heated add onions, red bell peppers, garlic, ginger, lemon grass, and carrot sticks. Cook, stirring often, for 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Add Thai curry paste, mix well with veggies, and cook for 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Slowly add chicken broth and mix well. Add coconut milk, fish sauce, soy sauce, and bok choy; mix well."
    },
    {
      "position": 5,
      "text": "Add lime leaves and mushrooms to broth, reduce heat, cover, and bring broth to a mild simmer for 3 to 5 minutes. Remove from heat and remove lime leaves before serving."
    },
    {
      "position": 6,
      "text": "Place 3 or 4 potstickers in a soup bowl and ladle broth over the potstickers. Add a sprig of Thai basil and a lime wedge for garnish."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

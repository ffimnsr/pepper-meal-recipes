  "id": "6760847c-b957-50bc-984a-1caf1d57bbe1",
  "slug": "fruity-chicken-salad-with-tarragon",
  "name": "Fruity Chicken Salad with Tarragon",
  "recipe_type": "salad",
  "brief_description": "This chicken salad is sweet and juicy from fruit, crunchy from pecans, and has a savory herb element from fresh tarragon. It's perfect served over greens or on a croissant.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, apple, grapes, pecans, red onion, and celery in a medium bowl."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, yogurt, tarragon, Dijon mustard, and lime zest and juice together in a small bowl. Stir dressing into the chicken mixture. Season with salt and pepper."
    }
  ],

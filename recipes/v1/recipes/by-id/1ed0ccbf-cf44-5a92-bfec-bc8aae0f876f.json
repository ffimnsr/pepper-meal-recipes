  "id": "1ed0ccbf-cf44-5a92-bfec-bc8aae0f876f",
  "slug": "zimbabwean-chicken-and-vegetable-soup",
  "name": "Zimbabwean Chicken and Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "This hearty and delicious soup combines a wonderful variety of vegetables with peanut butter, chicken, and a few red pepper flakes for unexpected flavors and just the right amount of kick.",
  "cuisine": "South African",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the olive oil over medium heat in a large soup pot; cook and stir the onion in the hot oil until translucent, about 5 minutes. Whisk 1/2 cup of vegetable stock and the peanut butter into the onions until the mixture is smooth. Beat in remaining vegetable stock, diced tomatoes with their liquid, and crushed red pepper flakes; bring to a boil, reduce heat to medium low, and cook at a simmer for 30 minutes, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Stir in the cabbage, sweet potato, carrot, and turnip; simmer, stirring occasionally, until the vegetables are tender, about 30 more minutes. Stir in the okra and chicken and simmer until the okra is tender, about 30 additional minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "7778ddf4-3afd-5d2e-85a1-b5b65d99831e",
  "slug": "fluffy-microwave-scrambled-eggs",
  "name": "Fluffy Microwave Scrambled Eggs",
  "recipe_type": "breakfast",
  "brief_description": "Learn how to make scrambled eggs for breakfast that are soft, fluffy, and absolutely delicious with this quick and easy 3-ingredient microwave recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Break the eggs into a microwave-proof mixing bowl. Add milk and salt; mix well."
    },
    {
      "position": 3,
      "text": "Pop the bowl into the microwave and cook on high power for 30 seconds. Remove bowl, beat eggs very well, scraping down the sides of the bowl, and return to the microwave for another 30 seconds."
    },
    {
      "position": 4,
      "text": "Repeat this pattern, stirring every 30 seconds for up to 2 \u00bd minutes. Stop when eggs have the consistency you desire."
    },
    {
      "position": 5,
      "text": "Serve warm and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

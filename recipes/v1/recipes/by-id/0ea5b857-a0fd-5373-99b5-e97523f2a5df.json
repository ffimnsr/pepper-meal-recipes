  "slug": "peanut-butter-banana-smoothie",
  "name": "Peanut Butter Banana Smoothie",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter banana smoothie recipe requires just 4 ingredients and a blender to prepare and enjoy for a sweet on-the-go breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place bananas, milk, peanut butter, honey, and ice cubes in a blender."
    },
    {
      "position": 3,
      "text": "Blend until smooth, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }

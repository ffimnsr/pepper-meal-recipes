  "id": "43effc2e-771b-5a78-a241-370a6dc5e11c",
  "slug": "cowboy-cookie-bars-recipe-11803951",
  "name": "Cowboy Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "These cowboy cookie bars are perfectly balanced and tasty. The addition of shredded coconut make them extra moist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix together flour, salt, cinnamon, and baking powder in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Whisk together brown sugar, melted butter, eggs, and vanilla in a medium bowl. Add to flour mixture and stir until moistened"
    },
    {
      "position": 4,
      "text": "Add oats, coconut, chocolate chips, and pecans to the dough. Fold with a spatula until well combined. (The mixture will be thick.)"
    },
    {
      "position": 5,
      "text": "Transfer dough to the prepared baking pan and spread out evenly. Bake until the bars are golden brown and set on the edges, 25 to 30 minutes"
    },
    {
      "position": 6,
      "text": "Transfer pan to a wire rack and cool in the pan. Cut into 12 portions."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

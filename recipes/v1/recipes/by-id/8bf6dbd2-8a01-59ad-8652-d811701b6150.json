  "id": "8bf6dbd2-8a01-59ad-8652-d811701b6150",
  "slug": "raspberry-and-almond-shortbread-thumbprints",
  "name": "Raspberry Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cute raspberry thumbprint cookies, made with shortbread dough, are filled with seedless raspberry jam and topped with a sweet drizzle glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Beat butter and white sugar together in a medium bowl until creamy. Mix in 1/2 teaspoon almond extract. Add flour and mix until dough comes together."
    },
    {
      "position": 4,
      "text": "Form dough into 1 \u00bd-inch balls and place on ungreased cookie sheets about 2 inches apart. Use your thumb to press down and make a dent in the center of each ball, then fill with jam."
    },
    {
      "position": 5,
      "text": "Bake in batches the preheated oven until edges are lightly browned, about 14 to 18 minutes; allow to cool on cookie sheet for a few minutes."
    },
    {
      "position": 6,
      "text": "Mix confectioners' sugar, milk, and remaining 3/4 teaspoon almond extract together in a medium bowl until smooth; drizzle lightly over warm cookies."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "one-dish-chicken-and-rice-bake",
  "name": "One Dish Chicken and Rice Bake",
  "recipe_type": "main",
  "brief_description": "Chicken and rice paired with a creamy mushroom sauce bake together for a delicious one-dish meal that's easy to clean up.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix soup, water, rice, paprika and black pepper in 2-quart shallow baking dish. Top with chicken. Season with additional paprika and pepper. Cover."
    },
    {
      "position": 2,
      "text": "Bake at 375 degrees F 45 minutes or until done."
    }
  ],

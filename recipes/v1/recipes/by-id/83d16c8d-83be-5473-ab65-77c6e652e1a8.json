  "id": "83d16c8d-83be-5473-ab65-77c6e652e1a8",
  "slug": "mexican-cornbread-ii",
  "name": "Mexican Cornbread II",
  "recipe_type": "main",
  "brief_description": "This savory bread is made easy with a shortcut using cornbread mix with creamed corn. Jalapeno peppers and Monterey Jack cheese give this tasty bread an unmistakable South-of-the-Border flair.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a 9x9 inch baking pan."
    },
    {
      "position": 2,
      "text": "Place cornmeal mix in a large bowl. Stir in egg, milk, creamed corn, cheese and diced green chile peppers. Spread batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 25 minutes, or until golden brown and cornbread pulls away from sides of pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

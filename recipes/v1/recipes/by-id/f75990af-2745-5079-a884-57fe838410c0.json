  "id": "f75990af-2745-5079-a884-57fe838410c0",
  "slug": "kielbasa-ramen-noodles-recipe-11914447",
  "name": "Kielbasa Ramen Noodles",
  "recipe_type": "main",
  "brief_description": "These kielbasa ramen noodles are a different way to create a budget-friendly main course with ramen, a soy-based sauce, and savory kielbasa. Feel free to substitute your favorite stir fry veggies, but the star of this dish is the kielbasa.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For sauce, whisk soy sauce, water, Hoisin, cornstarch, sesame oil, and Sriracha sauce together in a small bowl until well combined; set aside."
    },
    {
      "position": 2,
      "text": "For noodles, bring a large pot of water to a boil over medium heat. Add ramen noodles and cook until al dente according to package directions, about 3 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat sesame oil in a large skillet. Add beaten eggs, and scramble just until set, 1 to 2 minutes. Remove to a plate, and set aside."
    },
    {
      "position": 4,
      "text": "Add kielbasa to the same skillet, and cook until browned on all sides, 3 to 4 minutes. Remove to the plate with the eggs."
    },
    {
      "position": 5,
      "text": "Add bell pepper and onion to the skillet, and stirring occasionally, cook until starting to become tender but still partially crisp, 3 to 4 minutes. Add garlic and cook until fragrant, about 30 seconds. Transfer to the plate with the kielbasa-eggs."
    },
    {
      "position": 6,
      "text": "Heat avocado oil in the same skillet over medium heat. Add drained noodles, and fry for 2 to 3 minutes. Fold kielbasa-veggie-egg mixture into noodles, stirring and separating until well combined."
    },
    {
      "position": 7,
      "text": "Give the sauce a good stir, pour into the skillet, toss and cook until the sauce starts to slightly thicken, and all is well coated, 3 to 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

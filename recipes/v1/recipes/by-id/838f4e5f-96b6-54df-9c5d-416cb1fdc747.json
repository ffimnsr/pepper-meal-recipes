  "id": "838f4e5f-96b6-54df-9c5d-416cb1fdc747",
  "slug": "great-grandmas-candied-yams",
  "name": "Great-Grandma's Candied Yams",
  "recipe_type": "dessert",
  "brief_description": "Slowly cooked in orange juice and a sugary blend in the oven, this great-grandma's recipe for candied yams will become a staple at your Thanksgiving table.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil over high heat. Add yams and boil for 10 minutes. Drain and rinse twice with cold water. Soak in cold water for 15 minutes."
    },
    {
      "position": 2,
      "text": "While yams are soaking, preheat the oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 3,
      "text": "Mix white sugar, brown sugar, cinnamon, and nutmeg together in a small bowl."
    },
    {
      "position": 4,
      "text": "Peel and cut yams into chunks and place in a large baking dish. Dot with butter and sprinkle with sugar mixture so all yams are coated. Carefully pour enough orange juice into the bottom of baking dish to measure 1/2 inch."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, basting often, until yams are tender and the liquid is thick and sticky, 3 to 3 1/2 hours. Sprinkle with mini marshmallows. Turn on the oven's broiler. Broil until marshmallows are melted and toasty, about 5 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 230,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b6dc7d31-cc1b-5195-830a-cedde7943e34",
  "slug": "homemade-beef-tamales",
  "name": "Homemade Beef Tamales",
  "recipe_type": "main",
  "brief_description": "The whole family can help make these tamales, a mixture of beef and green chiles encased in homemade masa flour and drizzled with hot sauce.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large cast-iron skillet over medium heat. Add beef, green chiles, hot sauce, salt, 3 cloves garlic, onion, black pepper, and cayenne pepper. Cook and stir until beef is thoroughly browned, 10 to 15 minutes. Drain and reserve the drippings."
    },
    {
      "position": 2,
      "text": "Combine reserved drippings, masa, lard, and baking powder in a large bowl. Mix well. Add up to 1 cup water, 1 teaspoon at a time, until mixture is as thick as biscuit dough. Divide into 50 equal balls. Place dough balls between 2 cutting boards each lined with a sheet of waxed paper; flatten into circles."
    },
    {
      "position": 3,
      "text": "Place each dough circle into a corn husk. Spoon about 3 tablespoons beef mixture in a line across the middle of each husk. Top with a small amount of cheese. Fold opposing sides of the tortilla to overlap the filling. Roll the husk around the tamale and fold in one end."
    },
    {
      "position": 4,
      "text": "Combine the remaining 1 clove garlic, 1 cup water, and chili powder in a small saucepan over medium-high heat. Bring chili sauce to a boil. Remove from heat."
    },
    {
      "position": 5,
      "text": "Stand a batch of the tamales, folded ends-down, in a steamer basket on top of a double boiler over simmering water. Bring water to a boil; cover and steam for 20 minutes. Remove tamales from heat; remove husks and top tamales with the chili sauce. Repeat with remaining tamales."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 60,

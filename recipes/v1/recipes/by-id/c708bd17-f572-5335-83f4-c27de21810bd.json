  "id": "c708bd17-f572-5335-83f4-c27de21810bd",
  "slug": "moms-apple-pie-i",
  "name": "Mom's Apple Pie I",
  "recipe_type": "dessert",
  "brief_description": "This aromatic pie 's secret is a bit of whiskey sprinkled onto the filling just before the top crust is slipped on. It mingles marvelously with the sugar, apples and spices as this luscious pie bakes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (225 degrees C). Fit bottom crust into a 9 inch pie plate."
    },
    {
      "position": 2,
      "text": "In a small bowl, mix together sugar, flour, salt, cinnamon, and nutmeg. Place sliced apples in a large bowl and sprinkle with sugar mixture. Toss until apples are thoroughly coated. Spoon apples into pan."
    },
    {
      "position": 3,
      "text": "Dot apples with butter or margarine, then sprinkle with whiskey. Cover with top crust. Seal edges and cut steam vents in top."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 10 minutes. Lower temperature to 350 degrees F (175 degrees C) and bake an additional 40 minutes. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

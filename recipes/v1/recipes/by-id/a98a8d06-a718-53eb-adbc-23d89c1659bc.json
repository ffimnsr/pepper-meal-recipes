  "id": "a98a8d06-a718-53eb-adbc-23d89c1659bc",
  "slug": "pesto-stuffed-grilled-portobellos",
  "name": "Pesto-Stuffed Grilled Portobellos",
  "recipe_type": "appetizer",
  "brief_description": "Pesto-stuffed, grilled portobello mushrooms are a quick and easy appetizer or side dish to prepare on summer evenings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove stems from mushrooms and finely chop stems."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat; cook and stir chopped mushroom stems, shallot, and garlic until softened, about 5 minutes. Pour wine into the skillet; cook and stir mixture using a wooden spoon until liquid is evaporated, 1 to 2 minutes. Cool mixture to room temperature, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Brush the olive oil mixture over the top each mushroom and place, top-side up, on a grilling pan. Mix pesto and pine nuts with the mushroom stem mixture together in a bowl; spoon into each mushroom. Sprinkle Italian cheese blend over the filling."
    },
    {
      "position": 5,
      "text": "Grill mushrooms on the preheated grill until edges are blackened and stuffing is bubbling, about 10 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

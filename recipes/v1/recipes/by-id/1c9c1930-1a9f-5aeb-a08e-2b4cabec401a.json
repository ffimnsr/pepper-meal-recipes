  "id": "1c9c1930-1a9f-5aeb-a08e-2b4cabec401a",
  "slug": "homemade-pickling-spice",
  "name": "Homemade Pickling Spice",
  "recipe_type": null,
  "brief_description": "Make a pickling spice from scratch with this recipe that uses an old-time combination of herbs and spices. Seal in a jar to keep fresh for up to a month.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place mustard seeds, allspice berries, coriander seeds, and pepper flakes into a small glass jar with a tight-fitting lid."
    },
    {
      "position": 3,
      "text": "Shake to combine. Add ginger to the jar, seal, and shake again."
    },
    {
      "position": 4,
      "text": "Add crumbled bay leaves, cinnamon stick halves, and cloves to the jar. Seal and shake once more to combine."
    },
    {
      "position": 5,
      "text": "Store in a tightly sealed jar for up to 1 month."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "9dcbbf63-3dde-5e2d-a88e-5e36bc5adfcb",
  "slug": "cuban-sliders",
  "name": "Cuban Sliders",
  "recipe_type": "appetizer",
  "brief_description": "This Cuban sliders recipe essentially makes mini Cuban sandwiches on sweet Hawaiian rolls with pulled pork, ham, Swiss cheese, and spicy Dijon butter.",
  "cuisine": "Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease bottom and sides of a 9x13-inch baking dish or disposable aluminum pan."
    },
    {
      "position": 2,
      "text": "Cut Hawaiian rolls in half; arrange 24 bottom halves in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Whisk melted butter, Dijon mustard, onion powder, poppy seeds, and Worcestershire sauce together in a bowl; brush \u00bd over bottom halves."
    },
    {
      "position": 4,
      "text": "Layer pulled pork, ham, Swiss cheese, and 2 pickle chips on each bottom roll, in exact order."
    },
    {
      "position": 5,
      "text": "Cover with roll tops. Brush remaining \u00bd butter mixture over tops; cover dish with aluminum foil and refrigerate for 20 to 30 minutes. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, covered, for 20 minutes. Remove foil; press sliders with a spatula to flatten. Continue baking until sliders are heated through and top is crispy, about 15 minutes more."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "8ccbb3f2-fe68-5e73-b17a-18fc8ac43fe4",
  "slug": "air-fryer-spinach-and-mushroom-frittata",
  "name": "Air Fryer Spinach and Mushroom Frittata",
  "recipe_type": "breakfast",
  "brief_description": "For a quick and easy breakfast for one, this spinach and mushroom frittata cooked in the air fryer is the perfect choice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Spray a 4 1/2-inch ramekin with nonstick spray."
    },
    {
      "position": 2,
      "text": "Whisk eggs and cream together in a bowl. Stir in spinach, mushrooms, Cheddar cheese, salt, and pepper until well combined. Pour into the prepared ramekin and cover tightly with foil."
    },
    {
      "position": 3,
      "text": "Air-fry for 12 minutes. Remove foil and air-fry until top starts to brown and a toothpick inserted into the center comes out clean, 4 to 8 more minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

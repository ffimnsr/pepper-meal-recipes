  "id": "118a120c-b25d-5154-ac32-af88cd38251e",
  "slug": "ham-and-asparagus-fettuccine",
  "name": "Creamy Ham and Asparagus Fettuccine",
  "recipe_type": "main",
  "brief_description": "This ham and asparagus pasta in a homemade Alfredo sauce with cream, butter, and Parmesan is a rich, easy dinner, and it's great for using leftover ham.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in fettuccini and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Stir asparagus into pot during last 5 minutes of cooking; drain and transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat cream and butter in a medium saucepan over medium heat until begins to bubble; stir in Parmesan, garlic powder, black pepper, and cayenne. Continue cooking until mixture thickens, stirring occasionally. Stir in ham until heated through."
    },
    {
      "position": 3,
      "text": "Stir sauce into pasta and asparagus; toss until well combined. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

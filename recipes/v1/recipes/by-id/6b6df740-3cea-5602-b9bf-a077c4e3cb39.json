  "id": "6b6df740-3cea-5602-b9bf-a077c4e3cb39",
  "slug": "amish-poor-mans-steak",
  "name": "Amish Salisbury Steak",
  "recipe_type": "soup",
  "brief_description": "For an inexpensive make-ahead meal, try this Amish Salisbury steak recipe with ground beef and with mushroom soup \u2014 refrigerated before cooking.",
  "cuisine": "Amish American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground beef, milk, crackers, onion, salt, and black pepper in a bowl. Shape mixture into a narrow loaf and place onto a baking sheet. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cut loaf into 1-inch thick slices and sear in the hot skillet until browned, 2 to 3 minutes per side. The inside will still be pink. Arrange slices in a roasting pan. Spread mushroom soup over steaks."
    },
    {
      "position": 4,
      "text": "Bake steaks in the preheated oven until mushroom soup is bubbling and meat is no longer pink inside, about 1 hour. An instant-read meat thermometer inserted into the center of a meat slice should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

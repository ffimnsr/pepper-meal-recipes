  "id": "e14770b6-20c1-5fe1-bcb1-6788ab7dc4fe",
  "slug": "sams-famous-carrot-cake",
  "name": "Sam's Famous Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "Sam's famous carrot cake recipe combines shredded carrots, pineapple, raisins, walnuts, and coconut to make a wonderfully moist and memorable dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8x12-inch pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda, cinnamon, and salt together in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Mix sugar, eggs, buttermilk, oil, and vanilla together in a large bowl; gradually add flour mixture until just combined."
    },
    {
      "position": 4,
      "text": "Combine shredded carrots, pineapple, coconut, walnuts, and raisins in a separate bowl; stir into cake batter using a large wooden spoon until combined. Pour batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour. Allow cake to cool for at least 20 minutes before serving."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

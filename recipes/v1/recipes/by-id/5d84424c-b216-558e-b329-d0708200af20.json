  "id": "5d84424c-b216-558e-b329-d0708200af20",
  "slug": "donna-leighs-creamy-broccoli-slaw",
  "name": "Donna Leigh's Creamy Broccoli Slaw",
  "recipe_type": "salad",
  "brief_description": "Donna Leigh's creamy broccoli slaw recipe combines toasted almonds and ramen noodles tossed in a creamy dressing for a delicious summer broccoli salad.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayonnaise, seasoning packet, vinegar, sugar, and celery seeds in a bowl; chill dressing in the refrigerator until ready to use."
    },
    {
      "position": 2,
      "text": "Heat olive oil and sesame oil in a skillet over medium heat. Add ramen noodles and almonds; cook and stir until toasted, stirring frequently, 3 to 5 minutes. Cool."
    },
    {
      "position": 3,
      "text": "Combine ramen noodle mixture, broccoli coleslaw mix, onion, sunflower seeds, and dressing in a bowl; stir to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "4ffd7d29-0488-55ce-a1dd-c8cd521c9290",
  "slug": "air-fryer-chicken-thighs",
  "name": "Air Fryer Chicken Thighs",
  "recipe_type": "main",
  "brief_description": "These air fryer chicken thighs are incredibly juicy with crispy skin. Ready in 30 minutes, these tasty paprika-rubbed chicken thighs are always a hit!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Pat chicken thighs dry with a paper towel; brush skins with olive oil. Place chicken thighs, skin-sides down, in a single layer on a plate."
    },
    {
      "position": 3,
      "text": "Combine smoked paprika, garlic powder, salt, and black pepper in a bowl; sprinkle \u00bd evenly over thighs. Flip thighs over; evenly sprinkle with remaining \u00bd seasoning mixture. Place thighs, skin-sides up, in a single layer in the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer until thighs are brown and the juices run clear, about 18 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5eac674a-8f6a-5829-a4cb-9758e0504eff",
  "slug": "simple-macaroni-and-cheese",
  "name": "Simple Macaroni and Cheese",
  "recipe_type": "main",
  "brief_description": "This mac and cheese recipe is simple to prepare with seven ingredients you most likely already have on hand for a deliciously rich, comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until tender yet firm to the bite, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a saucepan over medium heat."
    },
    {
      "position": 4,
      "text": "Whisk in flour, salt, and black pepper until smooth, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Slowly pour in milk, while constantly stirring; cook and stir until mixture is smooth and bubbling, about 5 minutes, making sure the milk doesn\u2019t burn."
    },
    {
      "position": 6,
      "text": "Add Cheddar cheese and stir until melted, 2 to 4 minutes."
    },
    {
      "position": 7,
      "text": "Drain macaroni and fold into cheese sauce until coated."
    },
    {
      "position": 8,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cea07276-c0aa-5f51-a40a-4d9c7fa013f7",
  "slug": "leftover-rotisserie-chicken-sliders-recipe-11803108",
  "name": "Leftover Rotisserie Chicken Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These leftover rotisserie chicken sliders are the perfect appetizer for game day, or anytime you just want something delicious. Shredded chicken, tomatoes, and provolone bake until golden and melty under a garlic-buttered bun.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Add olive oil to a skillet over medium heat. Cook and stir onions and garlic until fragrant, about 2 minutes. Stir in chicken and bacon; season lightly with salt and pepper. Stir until heated through and coated in onion and garlic."
    },
    {
      "position": 3,
      "text": "Slice slider buns in half. Place bottom halves in a baking dish. Layer on the garlic chicken mixture. Add sliced tomatoes and provolone on top. Close sliders with top buns."
    },
    {
      "position": 4,
      "text": "In a small saucepan, melt butter with a pinch of garlic or garlic powder. Brush the tops of buns with garlic butter."
    },
    {
      "position": 5,
      "text": "Bake sliders in the preheated oven until cheese is melted and tops are golden, 8 to 10 minutes. Optional: broil sliders for 1 minute for extra crispy tops."
    },
    {
      "position": 6,
      "text": "Remove sliders from the oven and brush with more garlic butter. Garnish with parsley if you\u2019re feeling fancy, and serve hot and melty."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

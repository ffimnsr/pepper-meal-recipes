{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1caaf0b7-5240-510b-a7e3-c3f6f0fbf45c",
  "slug": "black-sesame-rice-krispies-treats-recipe-11887193",
  "name": "Black Sesame Rice Krispies Treats",
  "recipe_type": "dessert",
  "brief_description": "Black sesame Rice Krispies treats are a new take on a familiar favorite, and may just be even tastier than the original. One simple addition\u2014black sesame paste\u2014takes rice cereal treats from good to can\u2019t-stop-eating-them levels of greatness. Black sesame is a common ingredient in Chinese desserts, and adds a nuttiness that accentuates rice cereal\u2019s toasted flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x13-inch pan with aluminum foil, wax, or parchment paper. You can spray this with cooking spray to ensure an easy release."
    },
    {
      "position": 2,
      "text": "Melt butter in a pot over medium heat. Cook, stirring or swirling the pot consistently, until it starts to turn brown and smell nutty."
    },
    {
      "position": 3,
      "text": "Add marshmallows and stir until they melt completely. Add black sesame paste and stir until combined."
    },
    {
      "position": 4,
      "text": "Add cereal to a large bowl, and pour butter-marshmallow mixture over cereal. Fold and stir until all cereal is coated in marshmallow mix."
    },
    {
      "position": 5,
      "text": "Transfer mixture to the prepared pan and press down lightly with a sheet of parchment or wax paper. Try not to pack the treats down too much or they will lose their inherently soft and gooey texture. Sprinkle generously with black sesame seeds and flaky sea salt."
    },
    {
      "position": 6,
      "text": "Set at room temperature for at least 30 minutes. Slice into 12 or 16 squares and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

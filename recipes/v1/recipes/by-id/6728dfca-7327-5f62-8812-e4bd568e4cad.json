  "id": "6728dfca-7327-5f62-8812-e4bd568e4cad",
  "slug": "ecuadorian-seco-de-pollo",
  "name": "Ecuadorian Seco de Pollo",
  "recipe_type": "soup",
  "brief_description": "Chicken thighs are simmered in a broth made from pureed tomatoes, cilantro, and beer in this authentic Ecuadorian soup called Seco de Pollo.",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken thighs with garlic, black pepper, cumin, and oregano."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep saucepan over medium-high heat; cook seasoned chicken until browned on both sides, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine beer, tomato, red onion, and cilantro in a blender; blend until a smooth sauce forms. Pour sauce over chicken and reduce heat to low; simmer until chicken is very tender, 45 minutes to 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

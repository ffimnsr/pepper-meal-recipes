  "id": "f104485a-c7f6-5179-9adf-e977ed57870e",
  "slug": "egg-rolls",
  "name": "Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Crispy fried egg rolls are easy to customize \u2014 from bean sprouts to cabbage, to beef, shrimp, and more. Wonton wrappers make a perfect package for an easy appetizer or meal.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage, bean sprouts, celery, and green onions in a large wok and stir-fry over high heat until vegetables cook down (add a little water if necessary). Mix in shrimp, stir-fry until cooked."
    },
    {
      "position": 2,
      "text": "In a large skillet, brown ground meat. Drain grease and add the meat to the vegetable and shrimp mixture. Continue to fry over high heat; add oyster sauce, soy sauce, garlic, and MSG. When well blended, remove the mixture from heat."
    },
    {
      "position": 3,
      "text": "Place a tablespoon of the meat and seafood mixture (or more, depending on how large your wonton skins are) into the center of each wonton skin. Fold the wonton skin over to make a package of the meat mixture inside, and seal the skin closed by dipping your finger in a little water and pressing the ends together to make egg rolls."
    },
    {
      "position": 4,
      "text": "Fry the egg rolls in 1/4 inch vegetable oil until golden brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,

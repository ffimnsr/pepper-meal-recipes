  "id": "91321f01-652c-591a-adc0-b416258a49c5",
  "slug": "weeknight-chicken-cordon-bleu",
  "name": "Weeknight Chicken Cordon Bleu",
  "recipe_type": "soup",
  "brief_description": "This chicken cordon blue recipe takes chicken breasts, wraps them in sliced ham and Swiss cheese, then bakes them in a creamy chicken soup sauce.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place milk and bread crumbs in two separate shallow bowls. Season chicken with salt and pepper. Place one slice of ham and one slice of cheese on each piece of chicken; roll, and secure with toothpicks. Dip each chicken roll into milk, and then into breadcrumbs."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium-high heat. Brown rolled chicken on all sides. Arrange the chicken in a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "In a small saucepan over medium heat, blend soup and cream; season with salt and pepper to taste. Pour over the chicken."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes, or until chicken is no longer pink and juices run clear."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

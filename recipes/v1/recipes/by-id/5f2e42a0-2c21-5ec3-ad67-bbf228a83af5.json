  "id": "5f2e42a0-2c21-5ec3-ad67-bbf228a83af5",
  "slug": "grandma-sherrills-bagels",
  "name": "Grandma Sherrill's Bagels",
  "recipe_type": "breakfast",
  "brief_description": "This homemade bagel recipe has been in the family for over 30 years and shows you how to make traditional boiled, then baked bagels, perfect for breakfast or lunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, hot water, sugar, yeast, and salt in a large bowl; transfer dough to a work surface and knead for 10 minutes. Place dough in a bowl and let rise for 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Form dough into 24 balls; punch a hole in the middle of each ball with a finger, creating a bagel shape. Place bagels on the prepared baking sheet; let rise for 20 minutes."
    },
    {
      "position": 4,
      "text": "Bring a large pot of water to a boil; cook bagels, working in batches, in the boiling water, about 45 seconds per side. Place boiled bagels on a clean towel to drain. Return bagels to the baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cooked through and lightly browned, 30 to 35 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

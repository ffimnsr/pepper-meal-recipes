  "id": "beb090b6-3a5b-5f77-8741-ffdd69f5e952",
  "slug": "grandmas-slow-cooker-swiss-steak",
  "name": "Grandma\u2019s Slow Cooker Swiss Steak",
  "recipe_type": "main",
  "brief_description": "Swiss steak strips cooked low and slow in the crockpot for hours, making a delicious brown gravy. Great served over mashed potatoes or egg noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place flour into a bowl. Dredge round steak strips in flour to coat."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large skillet over medium heat; brown strips of round steak in the hot oil, 7 to 8 minutes per side."
    },
    {
      "position": 3,
      "text": "Transfer beef strips to a slow cooker. Add cream of mushroom soup, Cheddar cheese soup, onion, green bell pepper, garlic, Worcestershire sauce, and browning sauce; stir. Season mixture with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Cook on High and cook for 4 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 250,
  "preparation_time_minutes": 15,

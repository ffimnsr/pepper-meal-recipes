  "slug": "gingerbread-cookie-frosting",
  "name": "Gingerbread Cookie Icing",
  "recipe_type": "dessert",
  "brief_description": "This gingerbread cookie icing recipe is perfect for festive treats during the holidays. Great for other cookie decorating as well, any time of year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sift confectioners' sugar into a small bowl to remove lumps."
    },
    {
      "position": 2,
      "text": "Gradually stir in milk until icing is smooth, but not runny."
    },
    {
      "position": 3,
      "text": "Add optional color to icing by dividing between small containers, one for each color. Gradually add food coloring until desired shades are reached."
    }
  ],

  "slug": "split-pea-soup-without-pork",
  "name": "Split Pea Soup without Pork",
  "recipe_type": "soup",
  "brief_description": "Just dried peas, celery, carrots, chicken broth and water in this easy, slowly cooked, stovetop soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse and pick through peas. Place them in a large pot with the celery, carrots, broth and water. Bring to a boil, then reduce heat, cover and simmer until peas have fallen apart, 1 to 2 hours. Season with salt and pepper before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 120,

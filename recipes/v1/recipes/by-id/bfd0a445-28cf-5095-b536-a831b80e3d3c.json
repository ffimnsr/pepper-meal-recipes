  "id": "bfd0a445-28cf-5095-b536-a831b80e3d3c",
  "slug": "strawberry-chiffon-pie",
  "name": "Strawberry Chiffon Pie",
  "recipe_type": "dessert",
  "brief_description": "Retro chiffon pie comes back in style with fresh strawberry flavor in the traditional fluffy whipped cream filling we love in this easy recipe that's perfect for summer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries and 1/2 cup sugar in a medium bowl. Set aside for 30 minutes."
    },
    {
      "position": 2,
      "text": "Mix gelatin with cold water in a medium bowl to soften. Add hot water to dissolve; set aside to cool, 5 to 10 minutes. Stir in strawberries, lemon juice, and salt; chill in the refrigerator until mixture mounds when spooned, about 1 hour. Place a large bowl and electric beaters in the freezer."
    },
    {
      "position": 3,
      "text": "Beat whipping cream in the chilled bowl until foamy using an electric mixer and the chilled beaters. Add remaining 1/4 cup sugar, gradually, and almond extract; continue beating until stiff peaks form. Fold chilled strawberry mixture into whipped cream."
    },
    {
      "position": 4,
      "text": "Beat egg whites and cream of tartar in a separate glass, metal, or ceramic bowl using an electric mixer on medium speed until soft peaks form. Increase the mixer speed to high; beat until egg whites are glossy and hold a firm peak. Gently fold into strawberry mixture."
    },
    {
      "position": 5,
      "text": "Pour filling into the prepared pie crust; smooth top. Chill pie in the refrigerator until firm, 4 hours to overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

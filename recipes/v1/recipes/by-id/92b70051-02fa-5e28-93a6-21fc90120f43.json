  "id": "92b70051-02fa-5e28-93a6-21fc90120f43",
  "slug": "deviled-eggs",
  "name": "Mary's Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Make deviled eggs with Miracle Whip for just a touch of sweetness; season with mustard and paprika for an easy, crowd-pleasing appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, cover and remove from heat; let eggs stand in hot water for 10 to 12 minutes. Remove eggs from hot water and cool in ice water."
    },
    {
      "position": 3,
      "text": "Peel eggs and cut in half lengthwise, remove and reserve yolks in a bowl."
    },
    {
      "position": 4,
      "text": "Add mustard, salad dressing, salt, and pepper to egg yolks; mix until smooth."
    },
    {
      "position": 5,
      "text": "Refill each egg half with the yolk mixture and sprinkle with paprika."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

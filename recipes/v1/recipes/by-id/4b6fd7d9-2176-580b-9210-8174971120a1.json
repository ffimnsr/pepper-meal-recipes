  "id": "4b6fd7d9-2176-580b-9210-8174971120a1",
  "slug": "lemony-shrimp-risotto",
  "name": "Lemony Shrimp Risotto",
  "recipe_type": "main",
  "brief_description": "Risotto is easier to make than its reputation. All you need for this lemony shrimp risotto is patience.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon butter in a large skillet over medium heat and add shallots and garlic. Cook until shallots are soft and translucent, 3 to 5 minutes. Season with salt and pepper. Pour in white wine and simmer until wine is reduced by half. Reduce heat to medium-low and stir in rice. Keep stirring until all the liquid has been absorbed."
    },
    {
      "position": 2,
      "text": "Next add hot stock, 1/2 cup at a time, stirring frequently until liquid is absorbed. Continue this process, adding stock 1/2 cup at a time, stirring after each addition, until rice is al dente. You may not need the full 3 cups so test the rice after 20 minutes or when you've used 2 1/2 cups of the stock and adjust accordingly."
    },
    {
      "position": 3,
      "text": "Turn heat to lowest setting and add Parmesan cheese, cream, and lemon juice. Stir until cheese has melted and everything has been incorporated. Adjust seasoning with salt and pepper and turn heat off."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt 1 tablespoon butter in a small skillet over medium heat and add shrimp. Cook until shrimp tails curl up, about 2 minutes. Be careful not to overcook."
    },
    {
      "position": 5,
      "text": "To serve, spoon risotto into bowls, top with shrimp and garnish with fresh parsley and lemon wedge if desired."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

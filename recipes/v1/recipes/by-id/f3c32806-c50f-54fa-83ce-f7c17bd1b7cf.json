  "id": "f3c32806-c50f-54fa-83ce-f7c17bd1b7cf",
  "slug": "cheese-fondue",
  "name": "Cheese Fondue",
  "recipe_type": "appetizer",
  "brief_description": "A classic cheese fondue made with Swiss cheese, Gruy\u00e8re, and white wine. Delicious served with cubes of bread, baby potatoes, or veggies for dipping.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Bring wine to a simmer in a fondue pot over medium-low."
    },
    {
      "position": 2,
      "text": "Stir in flour and nutmeg until well combined."
    },
    {
      "position": 3,
      "text": "Add Swiss and Gruy\u00e8re cheeses, 1/4 pound at a time, mixing after each addition until cheese is melted. Season with salt."
    },
    {
      "position": 4,
      "text": "Serve with cut-up French bread."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

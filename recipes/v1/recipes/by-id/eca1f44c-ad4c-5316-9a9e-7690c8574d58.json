  "schema_version": 1,
  "id": "eca1f44c-ad4c-5316-9a9e-7690c8574d58",
  "slug": "air-fryer-nachos",
  "name": "Air Fryer Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Use your air fryer to prepare these quick and easy nachos, topped with pepper Jack cheese, black olives, tomatoes, and cilantro. They make a perfect party appetizer.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 360 degrees F (180 degrees C) for about 3 minutes. Line air fryer basket with foil or a parchment liner, and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread out chips in the fryer basket in a single layer, slightly overlapping chips, so the cheese doesn't melt through. Lightly dust chips with taco seasoning to get a pop of taco flavor, and sprinkle with shredded cheese. Don't overcrowd the basket."
    },
    {
      "position": 3,
      "text": "Top cheese with olives and tomatoes and place basket in the air fryer."
    },
    {
      "position": 4,
      "text": "Air-fry until cheese is melted and chips are starting to slightly brown on the edges, 5 to 6 minutes. Watch closely to be sure the cheese doesn't burn. If necessary, add additional time until you reach your preferred crispness."
    },
    {
      "position": 5,
      "text": "Move nachos to a plate, garnish with chopped cilantro, and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "d36fd77e-4b88-5395-827a-864feb43ba1a",
  "slug": "overnight-blueberry-french-toast",
  "name": "Overnight Blueberry French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This make-ahead blueberry French toast casserole is easy to prep the night before and bake in the morning for a pleasing holiday breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Prepare casserole: Lightly grease a 9x13-inch baking dish. Arrange 1/2 of the bread cubes in the dish and top with cream cheese cubes."
    },
    {
      "position": 3,
      "text": "Sprinkle blueberries over the cream cheese, then top with remaining bread cubes."
    },
    {
      "position": 4,
      "text": "Whisk eggs, milk, vanilla extract, and syrup together in a large bowl until well-combined; pour over the bread cubes. Cover and refrigerate overnight."
    },
    {
      "position": 5,
      "text": "Remove casserole from the refrigerator about 30 minutes before baking. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake casserole in the preheated oven, covered, for 30 minutes. Uncover, and continue baking until center is firm and surface is lightly browned, about 25 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, prepare blueberry sauce: Mix sugar, water, and cornstarch together in a medium saucepan; bring to a boil and cook, stirring constantly, 3 to 4 minutes. Stir in blueberries, reduce heat to low, and simmer until all the blueberries burst, about 10 minutes. Stir in butter."
    },
    {
      "position": 8,
      "text": "Serve portions of casserole on plates and pour warm syrup over top."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

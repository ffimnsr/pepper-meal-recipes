  "id": "b18ddd90-e07b-588b-91ee-6cc05d392506",
  "slug": "banana-chocolate-chip-bread",
  "name": "Banana Chocolate Chip Bread",
  "recipe_type": "dessert",
  "brief_description": "This chocolate chip banana bread is sweet and moist thanks to the addition of very ripe bananas; lots of chocolate chips turn it into a special treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x5-inch loaf pan, preferably glass."
    },
    {
      "position": 3,
      "text": "Mix flour, baking powder, baking soda, and salt in a bowl."
    },
    {
      "position": 4,
      "text": "Stir bananas, milk, and cinnamon in another bowl."
    },
    {
      "position": 5,
      "text": "Beat sugar and butter together in a third bowl with an electric mixer until light and fluffy; add eggs one at a time, beating well after each addition."
    },
    {
      "position": 6,
      "text": "Stir banana mixture into butter mixture; mix in flour mixture until just blended. Fold in chocolate chips; pour batter into the prepared loaf pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 70 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack before slicing."
    },
    {
      "position": 8,
      "text": "Slice and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "9aa580ff-2ac8-504c-876b-5d95a2c289f5",
  "slug": "no-beans-about-it-chili",
  "name": "No-Beans-About-It Chili",
  "recipe_type": "soup",
  "brief_description": "This no-beans-about-it chili recipe delivers a flavorful chili loaded with tomatoes, beef, onions, and earthy spices, for thick, rib-sticking results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large stockpot or Dutch oven over medium-high heat. Crumble beef into the pot. Add onion and garlic; cook and stir until beef is brown; drain."
    },
    {
      "position": 2,
      "text": "Stir in chili powder, oregano, cumin, and hot sauce until well combined. Pour in tomatoes and vinegar; bring to a boil. Reduce heat to low; simmer for at least 1 hour, stirring occasionally to prevent burning."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,

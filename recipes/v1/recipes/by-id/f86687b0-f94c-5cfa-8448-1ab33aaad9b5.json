  "id": "f86687b0-f94c-5cfa-8448-1ab33aaad9b5",
  "slug": "mediterranean-grilled-salmon-kabobs",
  "name": "Mediterranean Grilled Salmon Kabobs",
  "recipe_type": "main",
  "brief_description": "Salmon marinated in tzatziki sauce is combined with tomatoes, peppers, and red onion for these Mediterranean-inspired grilled salmon kabobs.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tzatziki sauce, lemon juice, and lemon zest in a bowl. Add salmon, toss to coat, and marinate in the refrigerator for 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Combine garlic, oregano, and olive oil in a bowl. Add green peppers, red onions, and grape tomatoes."
    },
    {
      "position": 4,
      "text": "Beginning and ending with salmon, thread salmon, grape tomatoes, red onions, and green peppers onto 8 skewers."
    },
    {
      "position": 5,
      "text": "Cook salmon skewers on the hot grill until fish is opaque in color, turning every 5 minutes, about 15 minutes total. Top with feta cheese and extra tzatziki sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "5e696de4-db63-56fa-9e69-6e582f5073b3",
  "slug": "folded-pizza-sandwich-recipe-8666883",
  "name": "Folded Pizza Sandwich",
  "recipe_type": "dessert",
  "brief_description": "If you love folding your pizza, you\u2019ll love this tasty take on an Italian sandwich. We stuffed a fluffy baked pizza crust with all the Italian flavors you love: salty cured meats, creamy burrata cheese, and sweet balsamic glaze. Here's how to make a folded pizza sandwich.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place pizza dough in a medium bowl greased with cooking spray and cover lightly with plastic wrap; let stand at room temperature until soft and pliable, about 1 hour."
    },
    {
      "position": 3,
      "text": "While dough sits, preheat oven to 450 degrees F (230 degrees C) with a rack in the center position. Stir together grated garlic and 2 tablespoons of the oil in a small bowl. In a separate bowl, whisk together vinegar, salt, and remaining 2 tablespoons oil. Set aside."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a large sheet of parchment; cut dough into 4 equal pieces. Working one piece of dough at a time, stretch and roll dough piece into a (7-inch) circle. Brush dough with garlic-oil mixture; fold dough circle in half. Brush top of dough lightly with garlic-oil mixture. Place on a parchment-lined baking sheet. Repeat with remaining dough pieces and garlic-oil mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until puffed and golden, 8 to 10 minutes. Let cool about 3 minutes."
    },
    {
      "position": 6,
      "text": "Toss spinach with 1 1/2 tablespoons of the vinaigrette in a medium bowl. Tear burrata into 8 pieces. Open pizza bread gently and place 2 pieces of the burrata on the bottom half of each pizza bread."
    },
    {
      "position": 7,
      "text": "Evenly stuff spinach, cured meats, and pepperoncini slices into each pizza bread."
    },
    {
      "position": 8,
      "text": "Drizzle with remaining vinaigrette and balsamic glaze. Serve immediately. Recipe developed by Julia Levy"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

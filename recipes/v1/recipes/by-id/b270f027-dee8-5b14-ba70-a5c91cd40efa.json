  "schema_version": 1,
  "id": "b270f027-dee8-5b14-ba70-a5c91cd40efa",
  "slug": "caramelized-carrot-tarte-tatin-recipe-11979135",
  "name": "Caramelized Carrot Tarte Tatin",
  "recipe_type": "appetizer",
  "brief_description": "This caramelized carrot tarte tatin with applesauce and ginger is a delightful recipe and a stunning presentation for carrots. It takes more time than a usual side dish, but it will wow your family and friends with the flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) and line a sheet pan with foil or parchment. If needed, dry carrots with paper towels or a clean dish towel."
    },
    {
      "position": 2,
      "text": "Toss carrots with olive oil and sweet ginger and garlic seasoning. Spread carrots in a single layer on the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until carrots are just tender, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Bring pie crust to room temperature."
    },
    {
      "position": 5,
      "text": "Meanwhile, for sauce, melt butter in a 12-inch skillet over medium heat. Stir in applesauce, chutney, and balsamic vinegar. Bring to a boil, then reduce heat and simmer until mixture is thick and coats the bottom of the pan, stirring occasionally, 5 to 8 minutes."
    },
    {
      "position": 6,
      "text": "Shake the skillet a bit, to spread applesauce mixture evenly. Arrange carrots in a single layer in a pleasing design, cutting and fitting the carrots as you go, on top."
    },
    {
      "position": 7,
      "text": "Remove wrapper of the pie crust, gently unroll, and place on top of carrots. Use a spatula to tuck in the edges of the pastry, where necessary."
    },
    {
      "position": 8,
      "text": "Bake at 425 degrees F (220 degrees C) for about 20 minutes, then reduce heat to 375 degrees F (190 degrees C), and continue baking until crust is deeply browned, 15 to 20 minutes."
    },
    {
      "position": 9,
      "text": "Select a serving plate that will fit inside the skillet and place upside down on the crust. Holding the plate in place with one hand, use the other hand to flip the skillet, so the tarte Tatin will be crust side down on the serving plate. If any carrots stick to the pan, replace them, prior to serving."
    },
    {
      "position": 10,
      "text": "Stir Greek yogurt and honey together for garnish. Serve warm or at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

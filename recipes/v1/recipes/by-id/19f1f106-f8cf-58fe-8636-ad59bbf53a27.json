  "id": "19f1f106-f8cf-58fe-8636-ad59bbf53a27",
  "slug": "mango-ceviche",
  "name": "Mango Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "This mixture of mango, onion, bell pepper, chile pepper, cilantro, and lime juice is ideal for topping blackened or grilled meat.",
  "cuisine": "Peruvian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix mangos, onion, green bell pepper, red bell pepper, jalapeno peppers, cilantro, and lime juice together in a bowl."
    },
    {
      "position": 2,
      "text": "Cover bowl with plastic wrap and refrigerate until the ceviche is completely chilled, at least 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

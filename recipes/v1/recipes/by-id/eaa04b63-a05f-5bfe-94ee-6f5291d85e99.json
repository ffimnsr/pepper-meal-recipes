  "id": "eaa04b63-a05f-5bfe-94ee-6f5291d85e99",
  "slug": "zucchini-bread-pancakes-recipe-11756631",
  "name": "Zucchini Bread Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These zucchini bread pancakes are a delicious nod to zucchini bread, rich and fluffy with warm spices and threads of zucchini throughout. The best part is that you can have the satisfaction of zucchini bread without heating up the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, baking soda, salt, cinnamon, cloves, and nutmeg together in a large bowl."
    },
    {
      "position": 3,
      "text": "Combine buttermilk, sugar, egg, and butter in a measuring cup; whisk well. Stir in shredded zucchini, and walnuts, then add to the dry ingredients. Fold together just until no dry spots remain."
    },
    {
      "position": 4,
      "text": "Heat a large nonstick skillet or griddle over medium heat; grease with butter."
    },
    {
      "position": 5,
      "text": "Working in batches, scoop 1/4 cup batter per pancake into the skillet. Cook until bubbles begin to form on surface of pancakes and edges start to look dry, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Flip, and cook until fluffy and slightly firm, about 2 minutes. Repeat with remaining batter, adding butter and adjusting heat as needed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

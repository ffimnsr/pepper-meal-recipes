  "id": "19c20f8e-3fe6-5fb7-8992-d7d00471dfb0",
  "slug": "chickpea-blondies-recipe-11747738",
  "name": "Chickpea Blondies",
  "recipe_type": "dessert",
  "brief_description": "Noone can tell that these chickpea blondies have beans in them. The peanut butter and chocolate mask any bean flavor. A tasty way to sneak some fiber into your kids' diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch baking pan with parchment paper. Add chickpeas to a food processor. Process until nearly smooth, Add peanut butter, brown sugar, flour, vanilla, baking soda, and salt. Process until smooth. Mixture will be very thick. Stir in 1/2 cup chocolate chips."
    },
    {
      "position": 2,
      "text": "Spread dough evenly in prepared pan. Top with remaining 2 tablespoons chocolate chips."
    },
    {
      "position": 3,
      "text": "Bake until a toothpick inserted into the center comes out clean, 25 to 28 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle with flaky sea salt"
    },
    {
      "position": 5,
      "text": "Cool in pan on a wire rack 30 minutes. Remove from pan and cool completely on the wire rack, 15 minutes. Cut in squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "27882f96-646f-52c2-8fc3-08b83c36ef41",
  "slug": "neapolitan-whoopie-pies",
  "name": "Neapolitan Whoopie Pies",
  "recipe_type": "dessert",
  "brief_description": "Strawberry cake mix, whipped topping, and Oreo\u00ae cookies make a tasty combination in these Neapolitan whoopie pies that can be enjoyed after an hour in the freezer or made ahead.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cake mix, vegetable oil, and eggs in a large bowl."
    },
    {
      "position": 3,
      "text": "Form dough into eighteen 1-inch balls and place on a cookie sheet. Flatten each ball with the palm of your hand."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are golden, about 6 to 8 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Add whipped topping to one side of each cookie, working in pairs. Sprinkle 1/2 of the cookies with crushed Oreos\u00ae, then sandwich with remaining cookies. Wrap each whoopie pie with plastic wrap and place in a 1-gallon freezer bag."
    },
    {
      "position": 6,
      "text": "Freeze for at least 1 hour before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

  "slug": "vegetarian-chickpea-sandwich-filling",
  "name": "Vegetarian Chickpea Sandwich Filling",
  "recipe_type": "main",
  "brief_description": "Make a chickpea sandwich with this delicious, easy, no-cook spread made with celery, onion, mayo, lemon, and dill that is vegetarian and gluten free.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mash chickpeas in a medium bowl with a fork."
    },
    {
      "position": 3,
      "text": "Mix in celery, onion, mayonnaise, lemon juice, and dill until well combined. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Serve on bread and enjoy!"
    }
  ],
  "servings": 3,

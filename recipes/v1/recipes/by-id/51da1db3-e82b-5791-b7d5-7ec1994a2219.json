  "id": "51da1db3-e82b-5791-b7d5-7ec1994a2219",
  "slug": "cheese-filling-for-pastries",
  "name": "Cheese Filling For Pastries",
  "recipe_type": null,
  "brief_description": "This pastry filling combines cream cheese with sour cream, butter, an egg yolk and brandy soaked raisins.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle raisins with brandy and set aside."
    },
    {
      "position": 2,
      "text": "In a bowl, cream together cream cheese and sugar. Beat in flour, sour cream, vanilla and butter. Beat in egg yolk. Fold in raisins. Chill until using."
    }
  ],

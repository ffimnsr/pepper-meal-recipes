  "id": "daabdc68-4a79-5bc6-9da3-4fdaa125a64c",
  "slug": "garlic-focaccia-muffins-recipe-11899960",
  "name": "Garlic Focaccia Muffins",
  "recipe_type": "side",
  "brief_description": "These garlic focaccia muffins are warm and savory, with Cheddar and Parmesan cheese, bathed in rosemary-garlic butter on top before baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium-sized bowl, add warm water, yeast, and sugar. Stir, then let sit for 5 minutes, or until fully bloomed."
    },
    {
      "position": 2,
      "text": "To the yeast mixture, add flour, olive oil, salt, Cheddar cheese, and Parmesan cheese. Mix to form a shaggy dough."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a clean work surface, Knead dough for 4 to 5 minutes or until all ingredients are incorporated and dough is a smooth, shiny ball."
    },
    {
      "position": 4,
      "text": "Place dough back in the bowl, cover with plastic wrap and let rest until doubled in size, about 1 hour. Preheat the oven to 375 degrees F (190 degrees C). Line a 6-muffin tin with paper muffin cups."
    },
    {
      "position": 5,
      "text": "Punch dough down, then break into 6 even parts. Roll each part into a soft ball, then place each ball into the prepared muffin tin."
    },
    {
      "position": 6,
      "text": "In a small bowl, add butter, rosemary, and garlic. Mash with a spoon until combined. Spread some of the mixture gently on top of each muffin."
    },
    {
      "position": 7,
      "text": "Bake muffins in the preheated oven for 15 minutes, then check for color. Bake until golden brown, about 5 minutes more. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

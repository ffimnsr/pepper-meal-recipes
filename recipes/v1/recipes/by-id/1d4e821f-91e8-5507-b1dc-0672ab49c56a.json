  "id": "1d4e821f-91e8-5507-b1dc-0672ab49c56a",
  "slug": "falafel-hash",
  "name": "Falafel Hash",
  "recipe_type": "main",
  "brief_description": "This hash inspired by the ingredients of falafel and flavored with Indian spices makes a hearty weeknight vegetarian or vegan main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large flat-sided skillet over medium heat. Add onion; cook and stir until translucent, about 5 minutes. Add mushrooms and garlic; cook and stir until softened, about 2 minutes. Add yam and cook for 2 minutes."
    },
    {
      "position": 2,
      "text": "Stir cumin, coriander, onion seeds, black mustard seeds, chile powder, paprika, and turmeric into the skillet; cook and stir until evenly distributed, about 2 minutes. Add cauliflower, chickpeas, salt, and black pepper; stir until combined."
    },
    {
      "position": 3,
      "text": "Mix vegetable stock and tomato paste together in a small bowl; pour into the skillet. Cover and cook until yam is tender, about 15 minutes. Stir in spinach, parsley, lemon juice, and lime juice and cook until flavors combine, about 1 minute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

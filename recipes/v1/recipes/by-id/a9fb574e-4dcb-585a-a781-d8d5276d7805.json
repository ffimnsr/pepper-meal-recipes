  "id": "a9fb574e-4dcb-585a-a781-d8d5276d7805",
  "slug": "creamy-potato-carrot-and-leek-soup",
  "name": "Creamy Potato, Carrot, and Leek Soup",
  "recipe_type": "soup",
  "brief_description": "This potato, carrot, and leek soup is based on one served in a small Irish restaurant. It\u2019s creamy and delicious with a mild flavor the kids will love.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a stockpot over medium-high heat. Add leeks and celery; cook and stir until softened, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add broth, potatoes, carrots, salt, and bay leaf; bring to a boil. Cook until potatoes and carrots are soft, about 20 minutes. Remove and discard bay leaf."
    },
    {
      "position": 3,
      "text": "Blend soup with an immersion blender until smooth. Stir cream into blended soup. Reduce the heat to medium-low and simmer until thickened, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "slug": "cranberry-orange-relish-with-orange-flavored-liqueur",
  "name": "Cranberry Orange Relish with Orange Flavored Liqueur",
  "recipe_type": "side",
  "brief_description": "For this tart and tangy relish, fresh cranberries and a whole orange are chopped in a blender or grinder and macerated with sugar and orange liqueur. It can be made ahead, too.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a food processor, grinder, or blender, combine the cranberries, orange and sugar. Blend until evenly chopped."
    },
    {
      "position": 2,
      "text": "Stir in the liqueur and refrigerate for several hours to allow flavors to blend."
    }
  ],
  "servings": 10,

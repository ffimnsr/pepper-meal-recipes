{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9fcc1c7f-a367-5ad4-bc24-1b058c862946",
  "slug": "chinese-lions-head-soup",
  "name": "Chinese Lion's Head Soup",
  "recipe_type": "soup",
  "brief_description": "Cabbage is simmered with home made pork meatballs in a light chicken broth. This is my family's version of lion's head soup and for me it is the best type of comfort food!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Mix the ground pork, egg, cornstarch, 2 teaspoons of sesame oil, ginger, monosodium glutamate, salt, and half of the chopped green onions together in a bowl. Use your hands to mix until the ingredients are evenly distributed. Set aside."
    },
    {
      "position": 2,
      "text": "Heat the vegetable oil in a wok or large skillet over high heat. When the oil is hot, fry the napa cabbage, stirring constantly, until cabbage begins to wilt, 2 to 3 minutes. Pour in the chicken broth, water, and soy sauce. Bring to a boil, then lower the heat to medium."
    },
    {
      "position": 3,
      "text": "Use a spoon to form the meat mixture into 1 inch balls. Drop them into the boiling soup. When the last ball has been added, cover with a lid and simmer for 10 minutes. Taste, and adjust salt before serving. Garnish with remaining green onions and a drizzle of sesame oil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

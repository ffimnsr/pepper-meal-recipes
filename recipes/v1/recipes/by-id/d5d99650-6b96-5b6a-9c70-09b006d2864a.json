  "slug": "muesli",
  "name": "Muesli",
  "recipe_type": "breakfast",
  "brief_description": "This muesli recipe is packed with oats, bran, wheat germ, raisins, nuts, and seeds for a nutritious homemade breakfast cereal full of healthy whole grains.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, raisins, wheat germ, wheat bran, oat bran, walnuts, brown sugar, and sunflower seeds in a large bowl; mix well. Store muesli in an airtight container at room temperature for up to 2 months."
    }
  ],

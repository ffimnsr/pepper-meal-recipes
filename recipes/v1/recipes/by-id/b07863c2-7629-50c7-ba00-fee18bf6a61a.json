  "id": "b07863c2-7629-50c7-ba00-fee18bf6a61a",
  "slug": "roasted-yams",
  "name": "Roasted Yams",
  "recipe_type": "dessert",
  "brief_description": "Sliced yams are baked in a hot oven until deliciously tender and crispy for a tasty vegetable side dish that takes minutes to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet or shallow baking dish with aluminum foil."
    },
    {
      "position": 2,
      "text": "Arrange yam slices in the prepared pan so they are overlapping slightly. Season with salt and pepper and then drizzle olive oil over them as evenly as possible."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender and yam slices have begun to wrinkle around the edges, about 30 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "a5785a02-264f-5181-b08a-b548cb8c621a",
  "slug": "spinach-mushroom-omelet",
  "name": "Spinach Mushroom Omelet",
  "recipe_type": "breakfast",
  "brief_description": "This mushroom omelet is a hearty but healthy way to start your day, with mostly egg whites, fresh spinach, bell peppers, tomato, and two kinds of cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk egg whites and egg together in a small bowl. Mix in Parmesan, Cheddar, salt, red pepper flakes, garlic powder, nutmeg, and pepper."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Saut\u00e9 mushrooms, green onions, and bell pepper until tender, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add spinach and cook until just wilted, 1 to 2 minutes. Stir in tomato, then pour in egg mixture. As egg mixture starts to set, lift the edges and let the uncooked portion flow underneath."
    },
    {
      "position": 5,
      "text": "Cook until egg mixture sets, 10 to 15 minutes. Cut into wedges and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

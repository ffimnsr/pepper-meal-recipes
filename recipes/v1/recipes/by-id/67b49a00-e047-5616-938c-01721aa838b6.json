  "id": "67b49a00-e047-5616-938c-01721aa838b6",
  "slug": "instant-pot-vegan-split-pea-soup",
  "name": "Instant Pot\u00ae Vegan Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This vegan split pea soup cooked in the Instant Pot\u00ae is a hearty and fuss-free soup that's full of flavor and on your table with very little effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Add olive oil and onion. Cook until soft and translucent, about 4 minutes. Add garlic and cook until fragrant, about 1 minute. Cancel Saute function."
    },
    {
      "position": 2,
      "text": "Add split peas, potatoes, carrots, liquid smoke, thyme, pepper flakes, bay leaf, salt, and pepper; stir to combine. Pour in vegetable broth and mix to combine. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 12 minutes. Allow 20 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 10 minutes. Remove lid, stir, adjust salt and pepper to taste, and let sit for 5 minutes to thicken."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "4a6ea881-de4b-5b09-9f9d-f4c4f26cb60f",
  "slug": "pulled-chicken-shawarma-sandwich-recipe-11733785",
  "name": "Pulled Chicken Shawarma Sandwich",
  "recipe_type": "main",
  "brief_description": "Chef John's pulled chicken shawarma has the same fabulous texture as pulled pork, with an extremely delicious shawarma spice mix. Serve it with thinly sliced red onions, fresh cilantro, and tahini or a yogurt sauce.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "For shawarma spice mix, add salt, cumin, sumac, paprika, chili powder, black pepper, garlic powder, turmeric, cloves, cayenne, and cinnamon to a small bowl and stir together."
    },
    {
      "position": 2,
      "text": "Place chicken in a soup pot, breast side up, and add 1 quart cold water along with garlic, onions, and half the spice mix."
    },
    {
      "position": 3,
      "text": "Place pot over high heat and bring to boil. Reduce heat to low, cover, and simmer gently for 1 hour, turning chicken over every 20 minutes."
    },
    {
      "position": 4,
      "text": "Carefully remove chicken to a bowl, and let cool until it is cold enough to handle, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Remove cooked chicken meat from the carcass, transfer meat into a bowl, cover, and refrigerate until needed."
    },
    {
      "position": 6,
      "text": "Transfer all bones and scraps back into the pot. Rinse the bowl with about 1 1/2 cups cold fresh water, and add to the pot. Bring to simmer over high heat. Reduce heat to low and simmer gently for at least 1 hour, preferably 2 hours."
    },
    {
      "position": 7,
      "text": "Strain broth, and transfer broth back into the pot. Bring to boil over high heat, and cook until liquid is reduced by half, 10 to 15 minutes."
    },
    {
      "position": 8,
      "text": "Shred chicken into about 1/2 inch thick strips and stir it into the pot. Reduce heat to medium, and cook chicken, stirring often, until chicken starts to break apart and absorb the sauce, 10 to 15 minutes. Reduce heat to low."
    },
    {
      "position": 9,
      "text": "Taste for seasoning, and add more salt if needed. Season with additional shawarma spice mix to taste. Finish by stirring in lemon juice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 140,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "06e2e59e-430e-564f-9499-0b581d1911f9",
  "slug": "thick-cut-bacon-in-the-oven",
  "name": "Thick-Cut Bacon in the Oven",
  "recipe_type": "breakfast",
  "brief_description": "Cook thick or thin-cut bacon in the oven for crispy results every time! With no splattering grease or messy cleanup, you'll never pan-fry bacon again.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a rimmed baking sheet with aluminum foil and place a baking rack on top. Arrange bacon strips on the baking rack."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crispy, 15 to 20 minutes."
    }
  ],

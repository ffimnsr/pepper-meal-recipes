  "id": "c63e9f66-312e-5672-964d-d697b2c80e68",
  "slug": "aunt-annes-coffee-cake",
  "name": "Aunt Anne\u2019s Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This coffee cake is moist, full of flavor, and covered with a buttery cinnamon streusel topping, making this a perfect easy breakfast or brunch treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Make streusel topping: Combine sugar, flour, and cinnamon in a medium bowl. Cut in butter until mixture resembles coarse crumbs. Set aside."
    },
    {
      "position": 3,
      "text": "Make cake: Combine flour, sugar, baking powder, and salt in a large bowl. Cut in butter until mixture resembles coarse crumbs. Whisk together egg and milk in a separate bowl; stir in vanilla."
    },
    {
      "position": 4,
      "text": "Pour egg mixture into crumb mixture; mix until just moistened."
    },
    {
      "position": 5,
      "text": "Spread into the prepared pan and sprinkle with streusel topping."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 25 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Allow to cool before slicing."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

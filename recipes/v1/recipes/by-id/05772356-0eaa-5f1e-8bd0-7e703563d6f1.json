  "id": "05772356-0eaa-5f1e-8bd0-7e703563d6f1",
  "slug": "sunflower-seed-pate-in-collard-wrap",
  "name": "Sunflower Seed Pate in Collard Wrap",
  "recipe_type": "main",
  "brief_description": "Homemade sunflower seed pate wrapped in a collard green is a refreshing and filling vegetarian lunch that also fits into a raw food diet and paleo lifestyle.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sunflower seeds in a bowl and add enough water to cover; soak for 8 hours. Drain."
    },
    {
      "position": 2,
      "text": "Blend sunflower seeds, celery, olive oil, lemon zest, lemon juice, thyme, garlic, black pepper, and sea salt in a food processor or blender until pate is smooth. Spread pate onto collard green leaf."
    }
  ],
  "servings": 2,

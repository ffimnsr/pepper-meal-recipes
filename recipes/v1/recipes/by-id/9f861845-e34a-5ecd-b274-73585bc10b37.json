  "id": "9f861845-e34a-5ecd-b274-73585bc10b37",
  "slug": "gandule-rice",
  "name": "Gandule Rice",
  "recipe_type": "side",
  "brief_description": "This exotic pork and rice dish is well worth the effort to track down the specialty ingredients. Achiote seeds from the annatto tree blend with the earthy flavors of onion, garlic, olives and tomatoes. A handful of cilantro makes a refreshing finish.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons of the oil in a large saucepan over medium high heat. Add pork and brown in oil. Meanwhile, place remaining oil in a small saucepan over medium heat and add achiote seeds. Heat until oil becomes very dark orange/red. Remove from heat and set aside."
    },
    {
      "position": 2,
      "text": "To the browned pork add the onion, cilantro, garlic, salt and pepper. Cook to reduce veggies, then add the tomato sauce, pigeon peas and olives. Mix well. Strain achiote/oil mixture into pork mixture and stir together. Reduce heat to low and let simmer for 10 minutes."
    },
    {
      "position": 3,
      "text": "Add uncooked rice and water to pork mixture; stir well. Raise temperature to high, cover saucepan and bring all to a boil. Stir again, reduce heat to low and cover; let cook on low about 10 minutes. Remove cover, stir again, replace cover and cook another 10 minutes; stir again. Remove from heat and allow to stand 15 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": null,

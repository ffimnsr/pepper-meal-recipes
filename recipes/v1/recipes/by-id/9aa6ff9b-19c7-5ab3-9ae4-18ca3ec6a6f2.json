  "id": "9aa6ff9b-19c7-5ab3-9ae4-18ca3ec6a6f2",
  "slug": "chocolate-pecan-pie-ii",
  "name": "Chocolate Pecan Pie II",
  "recipe_type": "dessert",
  "brief_description": "In this dessert for a crowd, the chocolate chips and pecans are mixed into the egg, corn syrup and sugar base before the filling is poured into two 9-inch pie shells.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, blend together the eggs, white sugar, brown sugar, flour, butter, corn syrup and vanilla."
    },
    {
      "position": 3,
      "text": "Add the chocolate chips and pecans; mix well and pour into pie crusts."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 40 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

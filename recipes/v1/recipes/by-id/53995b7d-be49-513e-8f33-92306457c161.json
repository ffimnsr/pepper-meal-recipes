  "id": "53995b7d-be49-513e-8f33-92306457c161",
  "slug": "buffalo-chicken-wings-i",
  "name": "Buffalo Chicken Wings I",
  "recipe_type": "appetizer",
  "brief_description": "Deep-fried chicken wings are simmered in butter and hot sauce to pack quite a kick.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oil in a large skillet or deep fryer to 375 degrees F (190 degrees C). Deep fry chicken wings in oil until done, about 10 minutes. Remove chicken from skillet or deep fryer and drain on paper towels."
    },
    {
      "position": 2,
      "text": "Melt the butter in a large skillet. Stir in the, vinegar and hot pepper sauce. Season with salt and pepper to taste. Add cooked chicken to sauce and stir over low heat to coat. The longer the wings simmer in the sauce, the hotter they will be. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

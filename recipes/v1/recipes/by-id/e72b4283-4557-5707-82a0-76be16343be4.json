  "id": "e72b4283-4557-5707-82a0-76be16343be4",
  "slug": "pesto-zucchini-and-corn-orzo-casserole-recipe-11961784",
  "name": "Pesto Zucchini and Corn Orzo Casserole",
  "recipe_type": "side",
  "brief_description": "This zucchini and corn orzo casserole with pesto is a bright, veggie-packed one-pan side dish, perfect for busy weeknights. It’s creamy, comforting, and ready in under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss zucchini with a little salt and let stand for 10 to 15 minutes. Pat dry."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 3-quart 9x13 or similarly sized baking dish."
    },
    {
      "position": 3,
      "text": "Add orzo, bone broth, corn, garlic, olive oil and half the pesto to the baking dish; stir well to distribute orzo evenly."
    },
    {
      "position": 4,
      "text": "Place zucchini on top in a single layer; do not stir zucchini in. Drizzle lightly with olive oil; season with pepper. Cover tightly with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Remove foil. Gently stir the orzo underneath, and swirl in remaining pesto. Sprinkle mozzarella and Parmesan on top."
    },
    {
      "position": 6,
      "text": "Bake uncovered until the top is lightly golden and orzo is tender, 10 to 15 minutes more. Let the dish rest for 5 to 10 minutes before serving. If desired, garnish with sweety drop peppers."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

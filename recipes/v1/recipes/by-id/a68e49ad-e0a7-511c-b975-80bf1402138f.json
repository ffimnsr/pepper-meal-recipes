  "id": "a68e49ad-e0a7-511c-b975-80bf1402138f",
  "slug": "creamy-creamed-cabbage",
  "name": "Creamy Creamed Cabbage",
  "recipe_type": "side",
  "brief_description": "Enjoy sauce for cabbage with this recipe for cabbage leaves baked with a creamy white sauce and Romano cheese in this delicious method of preparing an old vegetable favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Blend milk, flour, butter, salt, and pepper in a medium saucepan over medium heat. Stir constantly until a thick white sauce has formed. Set aside."
    },
    {
      "position": 3,
      "text": "Bring water to a boil in a separate medium saucepan. Place cabbage in a steamer set over the saucepan and steam until tender but firm."
    },
    {
      "position": 4,
      "text": "Alternate layers of white sauce, steamed cabbage, and grated Romano cheese in a small baking dish."
    },
    {
      "position": 5,
      "text": "Bake until sauce and cheese are bubbly, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

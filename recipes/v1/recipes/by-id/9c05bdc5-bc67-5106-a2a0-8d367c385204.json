  "id": "9c05bdc5-bc67-5106-a2a0-8d367c385204",
  "slug": "chocolate-cobbler",
  "name": "Chocolate Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This rich chocolate cobbler bakes up with a crunchy crust on top and ooey, gooey chocolate on the bottom to make a perfectly pleasing dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Place butter into an 8-inch square baking dish and set in the oven to melt while it preheats."
    },
    {
      "position": 2,
      "text": "Sift flour, 3/4 cup sugar, and 1 \u00bd tablespoons cocoa together into a medium bowl. Stir in milk and vanilla until smooth."
    },
    {
      "position": 3,
      "text": "Stir remaining 1 cup sugar and 1/4 cup cocoa powder together in a small bowl."
    },
    {
      "position": 4,
      "text": "Remove the baking dish from the oven. Pour flour-sugar mixture over melted butter, then sprinkle sugar-cocoa mixture over top. Slowly pour boiling water over everything."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

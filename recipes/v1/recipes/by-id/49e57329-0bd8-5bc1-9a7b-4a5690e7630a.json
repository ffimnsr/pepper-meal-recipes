  "id": "49e57329-0bd8-5bc1-9a7b-4a5690e7630a",
  "slug": "easter-carrot-cheese-log",
  "name": "Easter Carrot Cheese Log",
  "recipe_type": "appetizer",
  "brief_description": "A cream cheese-based dip is formed into a carrot shape and topped with Cheddar cheese is a fun Easter appetizer to serve with crackers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Chop black olives and green olives in a food processor or a food chopper."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, 4 ounces Cheddar cheese, chopped olives, and taco seasoning together in a bowl using an electric mixer on low speed. Increase speed to medium and mix until well combined."
    },
    {
      "position": 3,
      "text": "Transfer cheese mixture to a flat serving plate. Shape cheese mixture into a 2-inch-thick carrot shape using a silicone bowl scraper. Press 2 ounces Cheddar cheese over the entire \"carrot\". Insert parsley sprigs into the top of the \"carrot\". Remove excess cheese from the plate using a damp napkin. Cover with plastic wrap and refrigerate for at least 2 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

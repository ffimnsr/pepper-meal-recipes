  "id": "cab385a8-0316-589e-99c9-413d6e2e22c2",
  "slug": "baked-beans-ii",
  "name": "Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "A little sweet, a little spicy! Canned pork 'n beans are taken to new heights with the addition of bacon, brown sugar, onion, and a few basic condiments.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine canned beans with pork, brown sugar, onion, ketchup, mustard, Worcestershire sauce, vinegar, salt, and pepper in a 9-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Place bacon slices over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until sauce is thickened and bacon is cooked, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

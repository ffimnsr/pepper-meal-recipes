  "schema_version": 1,
  "id": "53fa45be-87f1-5f23-b263-b906dfdf1b8a",
  "slug": "nova-scotia-style-donair",
  "name": "Nova Scotia Style Donair",
  "recipe_type": "dessert",
  "brief_description": "This Nova Scotia-style donair sandwich recipe starts with a meatloaf made with ground beef, ground lamb, and spices, plus a donair sweet milk sauce.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a large baking pan with sides."
    },
    {
      "position": 2,
      "text": "Combine beef, lamb, flour, oregano, salt, dry mustard, 2 \u00bd teaspoons garlic powder, black pepper, cayenne pepper, chile pepper, paprika, and Italian seasoning in a bowl; knead with your hands until mixture is paste-like, about 10 minutes. Roll into a large loaf shape; place into the prepared baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until no longer pink in the center, about 2 hours. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Remove from oven; place loaf on a drip rack to allow juices and fat to drain until completely cool. Refrigerate loaf for 6 hours to overnight."
    },
    {
      "position": 4,
      "text": "Combine evaporated milk, sugar, and 2 teaspoons garlic powder in a small bowl; gradually stir in vinegar just until mixture thickens."
    },
    {
      "position": 5,
      "text": "Slice donair loaf into strips about \u215b-inch to \u00bc-inch thick; fry in a skillet over medium-high heat, in single-sandwich batches, until begins to crisp at edges. Remove from skillet. Quickly rub 1 pita round lightly with water; fry pita in same skillet, turning once, just until warm, about 1 minute."
    },
    {
      "position": 6,
      "text": "Spread pita with about \u00bd tablespoon sauce; top with pan-fried donair meat. Garnish with tomato, onion, and more sauce; repeat with remaining donair and pita."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

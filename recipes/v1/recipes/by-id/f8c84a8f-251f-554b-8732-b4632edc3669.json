  "id": "f8c84a8f-251f-554b-8732-b4632edc3669",
  "slug": "stick-of-butter-mac-and-cheese-recipe-11821863",
  "name": "Stick of Butter Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "This stick of butter mac and cheese is cozy comfort food, and cleanup is minimal. The macaroni bakes in the cheese sauce, without boiling first, and the dish is finished under the broiler for a crispy top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 5 tablespoons butter in a large saucepan over medium heat. Whisk in flour and cook for 1 to 2 minutes, stirring constantly, to form a smooth roux. Gradually whisk in warmed milk. Cook, stirring, until slightly thickened, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low. Add 2 cups Cheddar cheese, stirring until melted and smooth. Stir in Worcestershire, salt, pepper, and mustard powder. Taste and adjust seasoning."
    },
    {
      "position": 4,
      "text": "Place dry macaroni in a 9x13-inch baking dish. Pour cheese sauce over, stirring to coat evenly. Cover tightly with foil."
    },
    {
      "position": 5,
      "text": "Bake until macaroni is tender, 35 to 45 minutes, stirring halfway through cooking time to ensure even cooking. Remove foil for the last 5 minutes."
    },
    {
      "position": 6,
      "text": "Melt remaining 3 tablespoons butter in a microwave-safe bowl. Add panko and stir to combine. Sprinkle panko topping evenly over baked macaroni; sprinkle with remaining Cheddar cheese."
    },
    {
      "position": 7,
      "text": "Turn on the oven\u2019s broiler. Broil until topping is crispy and golden, 1 to 2 minutes. Let rest for 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,
  "difficulty": "medium",

  "id": "663d5a5e-c98e-5db1-89e5-9ee8816ce26e",
  "slug": "duck-fat-steak-fries",
  "name": "Duck Fat Steak Fries",
  "recipe_type": "appetizer",
  "brief_description": "There\u2019s no looking back once you\u2019ve tried these steak fries cooked in duck fat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Place potato wedges in a bowl; sprinkle thyme, cayenne, salt, and black pepper over the top. Drizzle melted duck fat over potatoes and toss to coat."
    },
    {
      "position": 3,
      "text": "Transfer potatoes, skin-side down, to the prepared baking sheet. Season wedges again with salt."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 40 minutes. Increase oven temperature to 450 degrees F (230 degrees C). Turn potatoes onto their sides and bake for 10 minutes. Flip over and cook on the other side until golden brown, about 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

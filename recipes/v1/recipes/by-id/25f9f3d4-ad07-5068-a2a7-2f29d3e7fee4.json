  "id": "25f9f3d4-ad07-5068-a2a7-2f29d3e7fee4",
  "slug": "pineapple-upside-down-cake-v",
  "name": "Best Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This pineapple upside down cake has 2 layers of tender cake with perfectly caramelized crushed pineapple and pineapple rings for the best dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Coat bottoms and sides of two 9-inch round cake pans with 2 tablespoons of melted butter. Sprinkle the bottom of each pan with 1/4 cup of brown sugar."
    },
    {
      "position": 3,
      "text": "In one of the pans, sprinkle coconut over the brown sugar. Lay pineapple rings in a single layer on top of coconut. Place a cherry in the center of each ring. In the other pan, spread the drained crushed pineapple."
    },
    {
      "position": 4,
      "text": "Mix the cake as directed on package, but substitute reserved pineapple juice in place of water. Divide batter between prepared cake pans. Remember which pan has the pineapple rings in it."
    },
    {
      "position": 5,
      "text": "Bake cakes in the preheated oven until a toothpick inserted into cake comes out clean, about 40 to 50 minutes. Cool cakes in pans for 20 minutes."
    },
    {
      "position": 6,
      "text": "While the bottoms of the cake pans are still warm to the touch, invert the layer with the crushed pineapple out onto a serving dish, then gently invert the layer with the pineapple rings on top of it for a dazzling two layer pineapple upside down cake."
    },
    {
      "position": 7,
      "text": "Slice and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "1142e065-a4c6-564e-874d-e67b09106fc4",
  "slug": "butterscotch-monkey-bread",
  "name": "Butterscotch Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "Classic monkey bread gets a sweet and sticky addition of butterscotch in this family-pleasing breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Arrange dinner rolls in a tube pan. Scatter margarine pieces evenly over rolls."
    },
    {
      "position": 2,
      "text": "Mix pudding mix, brown sugar, and cinnamon in a bowl; pour over rolls. Place a towel over tube pan and all dough to rise overnight."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Pour milk over risen dough, allowing milk to seep through any gaps."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until golden brown, 20 to 23 minutes. Allow bread to rest for 5 minutes. Invert pan onto a baking sheet or large plate to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,

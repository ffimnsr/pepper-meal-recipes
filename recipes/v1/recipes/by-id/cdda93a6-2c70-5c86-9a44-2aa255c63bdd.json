  "id": "cdda93a6-2c70-5c86-9a44-2aa255c63bdd",
  "slug": "instant-pot-baby-back-ribs",
  "name": "Instant Pot Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "Tender Instant Pot baby back ribs made with spice-rubbed pork ribs cooked in a pressure cooker and brushed with BBQ sauce until sticky and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine kosher salt, brown sugar, chili powder, paprika, garlic powder, cayenne pepper, and black pepper in a small bowl."
    },
    {
      "position": 2,
      "text": "Cut rib rack into 4 equal portions; rub all sides each portion with spice mixture."
    },
    {
      "position": 3,
      "text": "Pour broth into a multi-functional pressure cooker (such as Instant Pot). Add ribs in a teepee formation. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 30 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 5,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Transfer ribs to the prepared baking sheet. Brush ribs on all sides with barbecue sauce."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 7 minutes. Flip ribs; continue baking until meat easily pulls away from the bones, about 7 minutes more. An instant-read thermometer inserted into center should read 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

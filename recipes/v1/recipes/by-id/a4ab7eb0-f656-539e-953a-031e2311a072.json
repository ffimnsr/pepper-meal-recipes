  "id": "a4ab7eb0-f656-539e-953a-031e2311a072",
  "slug": "mitzies-beef-stroganoff",
  "name": "Mitzie's Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "This is a stroganoff recipe using ground beef. Stirring cream cheese and sour cream through the dish just before serving will give a delightfully creamy texture to the final product.",
  "cuisine": "Russian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Crumble ground beef into the hot skillet; season with salt and pepper. Cook and stir beef until completely browned, 7 to 10 minutes. Drain and discard any excess grease. Transfer beef to a bowl."
    },
    {
      "position": 2,
      "text": "Melt butter in the skillet over medium heat. Cook and stir onion and garlic in hot butter until softened, 3 to 5 minutes. Stir flour into onion mixture; cook and stir until flour is browned, about 1 minute. Return beef to the skillet; stir. Pour beef broth over the mixture in the skillet; bring to a boil. Stir Worcestershire sauce and mustard through the mixture."
    },
    {
      "position": 3,
      "text": "Place a cover on the skillet, reduce heat to medium-low, and cook mixture at a simmer until the consistency is gravy-like, about 1 hour."
    },
    {
      "position": 4,
      "text": "Stir sour cream and cream cheese through the beef mixture to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "623615e5-5f4a-5c23-bf76-e77b0da16bb3",
  "slug": "real-potato-leek-soup",
  "name": "Real Potato Leek Soup",
  "recipe_type": "soup",
  "brief_description": "This fresh leek and baby potato soup is made with chicken broth and milk, and seasoned with salt and pepper. It's best with crumbled bacon bits.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large saucepan with water to cover. Bring to a boil and cook until tender. Meanwhile, saut\u00e9 leeks in butter until translucent."
    },
    {
      "position": 2,
      "text": "When potatoes are done, skin them while they are still hot and cut them into bite-sized pieces. Place potatoes into a stock pot with chicken broth and leeks. Season with salt and pepper. Cook over medium heat until simmering, then remove from heat and stir in milk. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,

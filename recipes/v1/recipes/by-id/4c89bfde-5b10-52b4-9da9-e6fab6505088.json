  "id": "4c89bfde-5b10-52b4-9da9-e6fab6505088",
  "slug": "bread-machine-pizza-dough",
  "name": "Bread Machine Pizza Dough",
  "recipe_type": "main",
  "brief_description": "This pizza dough recipe is made in a bread machine",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place beer, butter, sugar, salt, flour, and yeast in a bread machine in the order recommended by the manufacturer. Select Dough setting and press Start."
    },
    {
      "position": 2,
      "text": "Remove dough from bread machine when cycle is complete. Roll or press dough to cover a prepared pizza pan. Brush lightly with olive oil. Cover and let stand for about 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Spread desired sauce and toppings on top of dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is lightly browned and crispy on the outside, about 24 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

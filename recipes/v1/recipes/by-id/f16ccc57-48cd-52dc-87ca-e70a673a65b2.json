  "id": "f16ccc57-48cd-52dc-87ca-e70a673a65b2",
  "slug": "just-like-wendys-chili",
  "name": "Just Like Wendy's Chili",
  "recipe_type": "soup",
  "brief_description": "This Wendy's chili recipe tastes just like the yummy one served at the restaurants. The generous batch simmers up in about an hour and freezes well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium-high heat. Press ground beef into the hot oil to form one large patty; let the bottom brown, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir and break browned beef into crumbles. Continue to cook until no longer pink, about 5 minutes longer."
    },
    {
      "position": 4,
      "text": "Stir celery, onion, and bell pepper into beef and cook until onion is translucent, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Pour in stewed tomatoes, tomato sauce, diced tomatoes with green chiles, and water."
    },
    {
      "position": 6,
      "text": "Break apart large chunks of stewed tomatoes."
    },
    {
      "position": 7,
      "text": "Stir in chili seasoning. Stir in kidney and pinto beans. Season with salt and pepper."
    },
    {
      "position": 8,
      "text": "Bring to a boil, then reduce heat to low, and simmer for 1 hour."
    },
    {
      "position": 9,
      "text": "Mix vinegar into chili just before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

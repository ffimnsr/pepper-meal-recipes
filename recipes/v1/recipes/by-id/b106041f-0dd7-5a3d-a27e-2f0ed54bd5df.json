  "slug": "poor-mans-ceviche",
  "name": "Poor Man's Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "Use imitation crabmeat in your ceviche to achieve a unique and budget-friendly version of the famous Mexican-style seafood appetizer.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix imitation crabmeat, tomatoes, cilantro, serrano chiles, and green onion together in a large bowl. Pour lime juice over the crabmeat mixture and gently mix; season with salt and pepper."
    }
  ],

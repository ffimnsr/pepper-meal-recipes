  "slug": "green-goddess-sandwich-recipe-11916455",
  "name": "Green Goddess Sandwich",
  "recipe_type": "salad",
  "brief_description": "This green goddess sandwich is crunchy and delicious, packed with fresh green veggies, and dressed in a garlicky, lemony yogurt and green herb sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place parsley, chives, tarragon, anchovy, toum, Greek yogurt, lemon juice, salt, and pepper into a small food processor or blender. Blend until smooth. Taste, and adjust salt and pepper as needed."
    },
    {
      "position": 2,
      "text": "Spread desired amount of dressing over the 2 bread slices. Top 1 slice with lettuce, spinach, tomato, cucumber, cheese, and avocado. Top with the other slice of bread. Serve immediately. Refrigerate any extra dressing in an airtight container."
    }
  ],

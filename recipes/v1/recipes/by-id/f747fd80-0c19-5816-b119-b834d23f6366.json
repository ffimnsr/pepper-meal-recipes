  "id": "f747fd80-0c19-5816-b119-b834d23f6366",
  "slug": "lemon-delights",
  "name": "Lemon Delights",
  "recipe_type": "dessert",
  "brief_description": "Treat your family with these thumbprint cookies filled with lemony goodness!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine all ingredients except egg white, flour, nuts and Lemon Cheese Filling. With mixer, beat until well blended. Beat in flour. Wrap dough in plastic wrap."
    },
    {
      "position": 2,
      "text": "Chill at least 1 hour."
    },
    {
      "position": 3,
      "text": "Shape into 1-inch balls. With mixer, beat egg white lightly. Dip balls in egg white; roll in nuts. Place 2 inches apart on ungreased baking sheets. Press thumb deep into center of each cookie; fill with Lemon Cheese Filling (recipe below)."
    },
    {
      "position": 4,
      "text": "Bake in preheated 375 degrees oven 10 minutes or until filling is set. Cool slightly; remove from baking sheets. Store tightly covered in refrigerator."
    },
    {
      "position": 5,
      "text": "Lemon Cheese Filling Directions: Beat cream cheese, sugar, egg yolk, ReaLemon\u00ae and 1 drop of yellow food coloring, if desired, until well blended and smooth."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,

  "id": "f9962c2a-f0de-5a27-a1b3-a92e1789d8f9",
  "slug": "chana-masala-savory-indian-chick-peas",
  "name": "Chana Masala (Indian Chickpea Curry)",
  "recipe_type": "main",
  "brief_description": "Chana masala is easy to make with chickpeas, tomatoes, onion, green chile, ginger, and a flavorsome blend of spices for a delicious Indian curry.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Grind onion, tomato, ginger, garlic, and chile pepper together in a food processor into a paste."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Fry bay leaves in hot oil until fragrant, about 30 seconds. Pour the paste into the skillet and cook until the oil begins to separate from the mixture and is golden brown in color, 2 to 3 minutes. Season the mixture with chili powder, coriander, gram masala, turmeric, and salt; cook and stir until very hot, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir just enough water into the mixture to get a thick sauce; bring to a boil and stir chickpeas into the sauce. Reduce heat to medium and cook until the chickpeas are heated through, 5 to 7 minutes. Garnish with cilantro."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

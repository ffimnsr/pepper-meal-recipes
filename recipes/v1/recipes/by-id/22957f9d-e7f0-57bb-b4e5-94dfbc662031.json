  "id": "22957f9d-e7f0-57bb-b4e5-94dfbc662031",
  "slug": "fluffy-belgian-waffles",
  "name": "Fluffy Belgian Waffles",
  "recipe_type": "breakfast",
  "brief_description": "This fluffy Belgian waffle recipe makes perfectly crisp and golden waffles that are deliciously fluffy inside for a delightful homemade breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat a Belgian waffle iron according to manufacturer's instructions; coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk eggs until fluffy. Whisk in milk, oil, sugar, salt, baking powder, all-purpose flour, and whole wheat flour, whisking slightly after each ingredient is added in the exact order; do not over mix."
    },
    {
      "position": 3,
      "text": "Pour \u00be cup batter into center of hot waffle iron, spreading with a metal knife if necessary."
    },
    {
      "position": 4,
      "text": "Close iron; bake until it stops steaming, 2 to 5 minutes, depending on iron. Carefully remove waffle with a fork. Repeat with remaining batter."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

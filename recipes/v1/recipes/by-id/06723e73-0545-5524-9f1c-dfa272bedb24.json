  "id": "06723e73-0545-5524-9f1c-dfa272bedb24",
  "slug": "panettone-bread-pudding-recipe-11857032",
  "name": "Panettone Bread Pudding",
  "recipe_type": "dessert",
  "brief_description": "Have you ever tried panettone bread pudding? It's the perfect dessert if you have extra panettone after the holidays with a light texture different from traditional bread pudding and sweet orange flavors.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Spread panettone cubes on a baking sheet. Bake until dry, stirring twice, about 15 minutes. Panettone cubes will continue to dry as they cool. Transfer panettone cubes to the prepared baking dish.*"
    },
    {
      "position": 3,
      "text": "Whisk together eggs, half-and-half, sugar, melted butter, vanilla, and salt in a large bowl. Pour over panettone cubes. Press down panettone cubes with the back of a spoon to submerge and soak in the custard mixture. Cover and chill at least 30 minutes and up to 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bake bread pudding in the preheated oven until puffed, golden brown, and a knife inserted in the center comes out clean, 40 to 45 minutes. (Internal temperature of bread pudding should be 160 to 175 degrees F (71 to 79 degrees C) ."
    },
    {
      "position": 5,
      "text": "Dust with powdered sugar, if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

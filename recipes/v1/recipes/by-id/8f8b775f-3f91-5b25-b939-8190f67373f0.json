  "id": "8f8b775f-3f91-5b25-b939-8190f67373f0",
  "slug": "collard-green-wontons-recipe-7254880",
  "name": "Collard Green Wontons",
  "recipe_type": "appetizer",
  "brief_description": "These collard cream cheese wontons, a fusion of Southern and Asian cuisine, will be a hit at your next gathering.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Heat grapeseed oil in wok over medium heat; cook and stir green onions, red bell pepper, and orange bell pepper for 5 minutes. Add collard greens, garlic, and greens seasoning; cook and stir until greens are wilted, about 10 minutes. Allow to cool for 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir cream cheese and sour cream together in a large bowl until smooth; stir in greens, a little at a time, until well mixed."
    },
    {
      "position": 3,
      "text": "Place \u00bd to 1 teaspoon greens mixture in center of wonton wrapper. Dip a finger into a small bowl of water, and trace edges of wonton wrapper to moisten; fold wonton into a triangle and press edges together to seal securely. Repeat with remaining wonton wrappers and greens."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Fry wontons in small batches until golden and crisp, 2 to 3 minutes. Remove to a paper towel-lined plate."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

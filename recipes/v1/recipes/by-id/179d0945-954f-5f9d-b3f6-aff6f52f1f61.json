  "id": "179d0945-954f-5f9d-b3f6-aff6f52f1f61",
  "slug": "the-mojito-cocktail",
  "name": "The Mojito Cocktail",
  "recipe_type": "drink",
  "brief_description": "This classic cocktail from Cuba is packed with fresh mint, lime juice, and rum and topped with club soda.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Muddle sugar and mint with soda water in pint glass. Squeeze both halves of lime into the glass leaving one hull in the mixture. Add rum, stir, and fill with ice. Top with club soda."
    },
    {
      "position": 2,
      "text": "Garnish with a mint sprig."
    }
  ],
  "servings": 1,

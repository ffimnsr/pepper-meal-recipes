  "id": "e9094859-aa40-5b81-be3f-8e1f4847f62f",
  "slug": "basic-ceviche",
  "name": "Basic Ceviche",
  "recipe_type": "soup",
  "brief_description": "This easy ceviche recipe includes white fish \"cooked\" in lime juice and tossed with cilantro, green onion, and tomato for a refreshing first course.",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "Place fish into a flat dish; cover with lime juice. Chill fish in refrigerator until tender and opaque, at least 3 hours. Drain lime juice."
    },
    {
      "position": 2,
      "text": "Mix tomato, cilantro, green bell pepper, green onion, jalape\u00f1o pepper, garlic, salt, and pepper in a bowl; add fish and stir. Chill in refrigerator until flavors blend, about 1 hour."
    }
  ],

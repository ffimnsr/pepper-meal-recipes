  "schema_version": 1,
  "id": "4b274f1a-fc5c-5ff8-9626-619ba6ddcd66",
  "slug": "beefy-broccoli-cheddar-burritos",
  "name": "Beefy Broccoli & Cheddar Burritos",
  "recipe_type": "main",
  "brief_description": "Beefy, cheesy burritos are baked with salsa and more cheese for this hearty (and quick!) family-pleasing dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F."
    },
    {
      "position": 2,
      "text": "Cook ground beef in 12-inch nonstick skillet over medium-high heat, stirring occasionally, until beef is done, about 5 minutes. Remove beef mixture and set aside."
    },
    {
      "position": 3,
      "text": "Stir Knorr® Rice Sides™ - Cheddar Broccoli, water and beans into same skillet and bring to a boil over high heat. Reduce heat to medium and cook covered 7 minutes or until rice is tender. Stir in beef mixture. Remove from heat and let stand 2 minutes. Stir in 1/2 cup salsa and 1/2 cup cheese."
    },
    {
      "position": 4,
      "text": "Spoon about 3/4 cup rice mixture onto each tortilla; roll-up."
    },
    {
      "position": 5,
      "text": "Evenly spread 1/2 cup salsa in bottom of 13 x 9-inch greased baking dish. Arrange burritos, seam-side-down. Spoon remaining salsa down center of burritos, then sprinkle with remaining 1/2 cup cheese. Cover tightly with aluminum foil and bake 25 minutes or until heated through. Garnish with green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5e7b86a8-5076-5a75-8826-ee95a64b8925",
  "slug": "chicken-noodle-soup",
  "name": "Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This chicken noodle soup recipe is easily made from scratch with vegetables, pasta, bouillon broth, and seasonings for a warm and satisfying meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large stockpot over medium-high heat. Saut\u00e9 celery and onion in hot butter until slightly softened."
    },
    {
      "position": 3,
      "text": "Add water, chicken, bouillon, carrots, parsley, marjoram, pepper, and bay leaf. Simmer for 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir in noodles and simmer until pasta is tender, about 10 more minutes."
    },
    {
      "position": 5,
      "text": "Season to taste. Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

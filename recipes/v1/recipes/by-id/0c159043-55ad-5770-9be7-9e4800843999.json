{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0c159043-55ad-5770-9be7-9e4800843999",
  "slug": "american-lasagna",
  "name": "American Lasagna",
  "recipe_type": "main",
  "brief_description": "This lasagna recipe is made with layers of homemade meat sauce, tender pasta sheets, ricotta filling, and lots of Parmesan and mozzarella cheese.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef, onion, and garlic in a large skillet over medium heat for 5 minutes; drain fat."
    },
    {
      "position": 3,
      "text": "Mix in diced tomatoes, tomato paste, brown sugar, basil, 1 1/2 teaspoons salt, and oregano. Simmer meat sauce, stirring occasionally, for 30 to 45 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook lasagna noodles in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain. Lay noodles flat on towels; blot dry."
    },
    {
      "position": 6,
      "text": "Mix together ricotta, 1/2 cup Parmesan cheese, eggs, parsley, and remaining 1 teaspoon salt in a medium bowl."
    },
    {
      "position": 7,
      "text": "Layer 1/3 of the noodles in the bottom of a 9x13-inch baking dish. Cover with 1/2 of the ricotta mixture."
    },
    {
      "position": 8,
      "text": "Cover the ricotta mixture with 1/2 of the mozzarella cheese, and 1/3 of the meat sauce."
    },
    {
      "position": 9,
      "text": "Repeat. Top with remaining noodles and meat sauce. Sprinkle 2 tablespoons Parmesan cheese over the top."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven for 30 minutes. Let stand for 10 minutes before serving."
    },
    {
      "position": 11,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "c9c6db15-0c83-5c8e-a726-2e91a4bd8fdc",
  "slug": "grilled-delmonico-steaks",
  "name": "Grilled Delmonico Steaks",
  "recipe_type": "main",
  "brief_description": "Try this Delmonico steak recipe for generous 10-ounce rib-eyes soaked in an herby, soy-based marinade and grilled to juicy, tender perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oil, Worcestershire sauce, soy sauce, steak seasoning, steak sauce, salt, pepper, and rosemary in the bowl of a food processor. Add garlic and onion; process until well blended."
    },
    {
      "position": 2,
      "text": "Prick steaks on both sides with a fork, then place into a large glass baking dish. Pour marinade over steaks, and flip steaks several times to coat. Cover and refrigerate for at least 3 hours, or overnight."
    },
    {
      "position": 3,
      "text": "When ready to cook, preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove steaks from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 5,
      "text": "Place steaks on the preheated grill; cover and cook until beginning to firm and are hot and slightly pink in the center, about 10 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

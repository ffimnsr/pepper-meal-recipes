  "schema_version": 1,
  "id": "07e6fdf1-3840-5623-a618-32c53073ed16",
  "slug": "fresh-cranberry-upside-down-cake",
  "name": "Fresh Cranberry Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This festive cranberry upside-down cake recipe features a layer of tart cranberries caramelized with brown sugar, creating a gorgeous, ruby-red top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round cake pan."
    },
    {
      "position": 2,
      "text": "Heat brown sugar and \u00bc cup butter in a saucepan over medium heat, stirring occasionally, until butter melts and sugar dissolves, 3 to 5 minutes; carefully transfer to the prepared cake pan. Scatter cranberries over top; set aside."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, and salt in a bowl; set aside."
    },
    {
      "position": 4,
      "text": "Beat white sugar and \u00bd cup butter together in a separate bowl with an electric mixer on medium-high speed until light and fluffy, 2 to 3 minutes. Add egg yolks, one at a time, beating well after each addition. Add 1 teaspoon vanilla extract; beat well. Fold in flour mixture in 3 batches, alternating with milk, using a silicone or rubber spatula."
    },
    {
      "position": 5,
      "text": "Beat egg whites in a separate glass, metal, or ceramic bowl with an electric mixer or a whisk until soft peaks form. Add cream of tartar; beat until stiff peaks form. Fold beaten egg whites into batter using a spatula. Spoon batter over cranberries in the pan, spreading evenly."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick or skewer inserted into center comes out clean, 55 to 60 minutes. Cool in the pan on a wire rack for 15 minutes. Run a knife around the edges of the pan to loosen cake. Invert onto a serving plate, let stand for 5 minutes, then remove pan."
    },
    {
      "position": 7,
      "text": "Whip heavy cream in a bowl with an electric mixer or a whisk until soft peaks form; stir in confectioners' sugar and \u00bc teaspoon vanilla extract."
    },
    {
      "position": 8,
      "text": "Cut cake into wedges; top with whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "323c2d8b-41d2-5c1f-b8f9-e403186786ec",
  "slug": "minestrone-soup",
  "name": "Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "This Minestrone soup recipe uses vegetable stock for the base and adds beans, orzo, corn, zucchini, cabbage, potatoes, and carrots for a hearty meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large soup pot, combine vegetable stock, undrained tomatoes, potato, onion, celery, carrot, cabbage, and Italian seasoning. Bring to a boil and reduce heat. Simmer for about 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir in beans, corn, zucchini, and pasta; simmer for 10 to 15 more minutes until the vegetables are tender. Season with salt and pepper."
    }
  ],
  "servings": 9,

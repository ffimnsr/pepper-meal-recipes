  "schema_version": 1,
  "id": "f658fb30-1456-5ed2-8d56-80e17e3d89d6",
  "slug": "air-fried-pizza-egg-rolls",
  "name": "Air-Fried Pizza Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "East meets West in this fusion of pizza and egg rolls that are air fried for a little less guilt when a midnight craving hits!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Cut mozzarella cheese into 6-inch sticks."
    },
    {
      "position": 3,
      "text": "Place 1 egg roll wrapper on a flat surface, positioned to look like a diamond. Add 1 teaspoon marinara sauce, 1 mozzarella stick, and 2 tablespoons mini pepperoni to the bottom third of the egg roll wrapper."
    },
    {
      "position": 4,
      "text": "Roll up the bottom point over the filling, towards the center of the wrapper. Fold in the left side of the wrapper to cover the center. Fold in the right side of the wrapper to cover the left fold, like an envelope. Roll up the egg roll until just the top point is exposed. Brush some water on the top point and fold down. You may need to brush a bit more water over the edges to create a seal."
    },
    {
      "position": 5,
      "text": "Repeat for the remaining egg rolls. Brush olive oil over the tops. Sprinkle Italian seasoning and garlic salt over the tops."
    },
    {
      "position": 6,
      "text": "Brush some olive oil over the air fryer basket. Add egg rolls to the basket seam side-down, without letting them touch each other. Reduce the temperature to 360 degrees F (180 degrees C) and air fry for 8 minutes, flipping at the halfway point. Serve with remaining marinara sauce."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

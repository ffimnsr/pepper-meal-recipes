  "slug": "the-ultimate-shaken-bloody-mary",
  "name": "The Ultimate Shaken Bloody Mary",
  "recipe_type": "drink",
  "brief_description": "This recipe is restaurant quality. You will not be disappointed!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pour the tomato juice, hot sauce, Worcestershire sauce, dill, seafood seasoning, celery salt, and vodka into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into ice-filled glasses, and garnish with cornichons to serve."
    }
  ],

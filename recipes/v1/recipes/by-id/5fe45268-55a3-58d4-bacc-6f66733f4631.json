  "id": "5fe45268-55a3-58d4-bacc-6f66733f4631",
  "slug": "poppy-seed-cake-i",
  "name": "Poppy Seed Cake I",
  "recipe_type": "dessert",
  "brief_description": "This cake is moist and delicious; especially so if you love the flavoring of almond extract. The cake is lovely and unusual to look at: white with black dots from the poppy seeds; filled and topped with yellow almond flavored custard. It's easy to take to a picnic, potluck or gourmet dinner. Just take the two cake layers and the bowl of custard. Assemble at your destination. Always a hit.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Soak poppy seeds in water for 2 hours. Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 8 inch round cake pans. Sift nonfat dry milk, flour and baking powder together, and set aside."
    },
    {
      "position": 2,
      "text": "Cream butter and sugar together until light and fluffy."
    },
    {
      "position": 3,
      "text": "Add 1/4 of the flour mixture to the creamed butter mixture and beat well. Continue to add the flour mixture alternately with the poppy seeds and water, beating well after each addition."
    },
    {
      "position": 4,
      "text": "Beat egg whites until stiff and gently fold into batter. Pour batter into prepared pans."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes. Cool, then fill and top with Almond Custard Filling before serving, if desired."
    }
  ],
  "servings": 20,

  "id": "f0b464ba-9c5d-5741-920c-0b8b815d8521",
  "slug": "lazy-dump-lasagna-recipe-12000858",
  "name": "Lazy Dump Lasagna",
  "recipe_type": "main",
  "brief_description": "This lazy dump lasagna uses precooked mini meatballs and sausage, 3 cheeses, and dry pasta. You can mix it all together in a bowl, or mix it directly in the casserole dish. With no boiling required, it\u2019s a streamlined approach to a classic lasagna.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x13 or similarly sized casserole dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "Stir pasta, marinara, bone broth, Cantanzaro herbs, granulated garlic, cottage cheese, meatballs, sausage, pearlini fresh mozzarella, Parmesan, and 1 cup shredded mozzarella together in a large bowl; pour into the casserole dish and top with remaining 1 cup shredded mozzarella."
    },
    {
      "position": 3,
      "text": "Tightly cover casserole with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 50 minutes; remove foil and bake until cheese is golden and melted, about 15 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

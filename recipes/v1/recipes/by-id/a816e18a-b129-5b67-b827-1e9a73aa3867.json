  "id": "a816e18a-b129-5b67-b827-1e9a73aa3867",
  "slug": "cowboy-butter-cabbage-recipe-11914348",
  "name": "Cowboy Butter Cabbage",
  "recipe_type": "side",
  "brief_description": "Cowboy butter is so versatile, and not only does it makes this a stellar cabbage dish, you will have extra to have on hand in the fridge, making meal prep on other dishes easier throughout the week. You can also freeze it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For cowboy butter, add butter, garlic, parsley, Dijon, lemon juice, chives, paprika, salt, black pepper, thyme, chili powder, and red pepper flakes to a bowl, and stir until well combined. Store butter in an airtight container in the refrigerator."
    },
    {
      "position": 2,
      "text": "For cabbage, melt 3 tablespoons prepared cowboy butter in a large pan over medium heat. Add cabbage, corn, red onion, and bell pepper, and toss until well coated. Cover, and cook, stirring occasionally, until cabbage is tender, but still a bit firm, 8 to 12 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

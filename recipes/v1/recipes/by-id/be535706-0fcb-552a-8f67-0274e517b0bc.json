  "id": "be535706-0fcb-552a-8f67-0274e517b0bc",
  "slug": "creamy-cajun-deviled-eggs",
  "name": "Creamy Cajun Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Creamy deviled eggs have a hint of spice thanks to hot sauce and a sprinkle of Cajun seasoning for garnish.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs into a saucepan, cover with cold water, and place over high heat. When water is boiling, cover saucepan with a lid, reduce heat to low, and simmer for 18 minutes. Remove from heat and cool eggs under cold running water until eggs can be handled. Peel eggs."
    },
    {
      "position": 2,
      "text": "Cut eggs in half lengthwise and scoop yolks into a mixing bowl. Beat yolks, cream cheese, creamy salad dressing, pickle relish, hot sauce, salt, and black pepper until mixture is creamy and smooth. Spoon yolk mixture into egg white halves. Sprinkle each deviled egg half lightly with Cajun seasoning. Chill before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

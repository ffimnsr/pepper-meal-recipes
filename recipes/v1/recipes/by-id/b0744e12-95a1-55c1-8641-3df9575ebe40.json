  "slug": "my-mango-lassi",
  "name": "My Mango Lassi",
  "recipe_type": "drink",
  "brief_description": "Mango lassi is very rich and luxurious drink with yogurt and mangoes. It is the perfect summer drink when served chilled.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mangos, yogurt, milk, cream, confectioners' sugar, and cardamom in a blender; blend until smooth and frothy. Pour into glasses and serve immediately."
    }
  ],
  "servings": 2,

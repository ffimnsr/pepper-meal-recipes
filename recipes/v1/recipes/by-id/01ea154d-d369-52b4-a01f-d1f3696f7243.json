  "id": "01ea154d-d369-52b4-a01f-d1f3696f7243",
  "slug": "creamy-beef-tips-with-egg-noodles",
  "name": "Creamy Beef Tips with Egg Noodles",
  "recipe_type": "soup",
  "brief_description": "Cubed sirloin tips baked in cream of mushroom soup, red wine, milk, mixed with beef and beef onion soup mix. Served over egg noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Saute beef sirloin tips with onion in the hot skillet until beef is browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir cream of mushroom soup, milk, red wine, and beef with onion soup mix together in a bowl, pour into the skillet, and stir to coat beef in the soup mixture; bring to a simmer, reduce heat to low, place a cover on the skillet, and cook until the beef tips are tender, about 2 hours."
    },
    {
      "position": 3,
      "text": "Reduce heat to lowest setting and continue cooking until the beef pulls apart easily with a fork, at least 4 hours more."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes. Drain."
    },
    {
      "position": 5,
      "text": "Ladle beef tips mixture over egg noodles."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 370,

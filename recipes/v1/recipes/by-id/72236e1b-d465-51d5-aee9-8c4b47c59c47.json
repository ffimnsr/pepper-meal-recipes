  "id": "72236e1b-d465-51d5-aee9-8c4b47c59c47",
  "slug": "creamy-sun-dried-tomato-and-spinach-pasta-recipe-11688336",
  "name": "Creamy Sun-Dried Tomato and Spinach Pasta",
  "recipe_type": "dessert",
  "brief_description": "This Italian-inspired creamy sun-dried tomato and spinach pasta brings together rich cream, sweet sun-dried tomatoes, and fresh baby spinach in a quick-and-easy dish that's on the table in under 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a rolling boil. Add spaghetti and cook, stirring occasionally, until al dente, about 9 to 10 minutes, or to your preferred doneness. Drain, reserving 1/2 cup pasta water."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a large skillet over medium heat. Add sun-dried tomatoes and cook until softened, about 1 to 2 minutes. Stir in garlic, and saute until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in heavy cream, and bring to a low simmer. Add Parmesan, stirring constantly until the sauce thickens, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add cooked spaghetti to skillet, toss until well coated. If too thick, add a small amount of reserved pasta water to achieve your desired consistency. Stir in spinach, cook until just starting to wilt, and season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Garnish with a sprinkle of crushed red pepper flakes and basil, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

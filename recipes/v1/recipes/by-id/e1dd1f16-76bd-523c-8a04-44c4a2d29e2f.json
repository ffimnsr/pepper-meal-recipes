  "slug": "a-very-popular-bbq-sauce",
  "name": "Homemade BBQ Sauce",
  "recipe_type": "dessert",
  "brief_description": "This quick and easy homemade barbecue sauce has just the right mixture of sweetness and spice. Adjust seasoning to your personal taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, ketchup, vinegar, water, and Worcestershire sauce in a blender. Season with mustard, paprika, salt, pepper, and hot pepper sauce. Blend until smooth."
    },
    {
      "position": 3,
      "text": "Enjoy!"
    }
  ],

  "id": "fb11442a-59b4-572f-80ab-5812a8f0b25c",
  "slug": "minestrone-soup-ii",
  "name": "Minestrone Soup II",
  "recipe_type": "soup",
  "brief_description": "This is an extra rich and savory minestrone with bacon, ground beef, red wine, and condensed onion soup. Garbanzo beans, spinach, zucchini, carrots, and celery add nutrition and visual appeal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large stock pot, cook bacon and drain off fat. Add onion, garlic, and beef. When onions are translucent, add celery, carrot, pureed tomatoes, whole tomatoes, broth, condensed soup, water, wine, oregano, basil, salt and pepper. Cook for 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir in zucchini, spinach, pasta, garbanzo beans and parsley. Cook for 15 minutes and serve with fresh Parmesan cheese."
    }
  ],
  "servings": 6,

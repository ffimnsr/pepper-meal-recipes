{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "28013ffd-7ce0-5fcc-89e2-9640efd666d3",
  "slug": "herb-and-garlic-roast-tenderloin-with-creamy-horseradish-sauce",
  "name": "Herb and Garlic Roast Tenderloin with Creamy Horseradish Sauce",
  "recipe_type": "main",
  "brief_description": "In this recipe, beef tenderloin is roasted with herbs, like fresh thyme and rosemary, and garlic, and served with a zesty, creamy horseradish sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 2 tablespoons olive oil, garlic, thyme, rosemary, 1 teaspoon salt, and black pepper in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon olive oil in a large oven-proof skillet over medium-high heat. Add tenderloin; cook until well-browned, 2 to 3 minutes. Flip tenderloin; turn off heat. Spread garlic-herb oil evenly over top and sides of tenderloin."
    },
    {
      "position": 4,
      "text": "Cook in the preheated oven until an instant-read thermometer inserted into the center reads 125 degrees F (50 degrees C), 25 to 30 minutes. Transfer tenderloin to a carving board; tent with foil and let stand 10 minutes. (Internal temperature will rise to 130 degrees F (54 degrees C) for medium-rare.)"
    },
    {
      "position": 5,
      "text": "Meanwhile, combine sour cream, horseradish, remaining 1 tablespoon oil, and remaining \u00bd teaspoon salt in a small bowl; chill until ready to serve."
    },
    {
      "position": 6,
      "text": "Carve tenderloin crosswise into \u00bd-inch thick slices; serve with horseradish sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

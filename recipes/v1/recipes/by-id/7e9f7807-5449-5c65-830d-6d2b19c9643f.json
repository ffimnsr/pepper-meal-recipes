  "id": "7e9f7807-5449-5c65-830d-6d2b19c9643f",
  "slug": "feta-and-olive-meatballs",
  "name": "Feta and Olive Meatballs",
  "recipe_type": "main",
  "brief_description": "These baked, ground lamb meatballs are flavored with feta and green olives.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat your oven's broiler."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together ground lamb with parsley, onion, feta cheese, green olives, eggs, and Italian seasoning. Shape into 16 meatballs, and place 2 inches apart on a baking sheet."
    },
    {
      "position": 3,
      "text": "Broil about 3 inches away from the heat until browned on top. Turn over, and broil on the other side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

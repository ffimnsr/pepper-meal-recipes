  "id": "ee1d0310-949c-58ef-b571-f2385e2fe2aa",
  "slug": "crab-stuffed-mushrooms-ii",
  "name": "Crab Stuffed Mushrooms II",
  "recipe_type": "appetizer",
  "brief_description": "The Dijon mustard adds a different twist to this delicious appetizer! Water chestnuts are optional, but add a nice texture to the smooth cream cheese and crab filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Remove stems from the mushrooms, retaining the caps. Chop the stems. In a medium saucepan, melt the butter. Brush the mushroom caps with melted butter."
    },
    {
      "position": 3,
      "text": "In the remaining butter, cook and stir the chopped mushroom stems and onions until tender. Gradually mix the cream cheese and mustard into the saucepan. Continue stirring until smooth. Stir in the crabmeat, water chestnuts and pimentos. Heat until warm."
    },
    {
      "position": 4,
      "text": "Stuff the mushroom caps with the crabmeat mixture. Sprinkle the stuffed caps with Parmesan cheese. In a shallow pan, bake the caps at 400 degrees for 10 to 15 minutes or until hot."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

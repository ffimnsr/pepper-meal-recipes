  "id": "482f940a-cc68-551e-806e-2770388c162a",
  "slug": "teriyaki-steak",
  "name": "Teriyaki Steak",
  "recipe_type": "main",
  "brief_description": "Strips of skirt steak are marinated overnight with teriyaki sauce and garlic, then broiled or grilled for about 10 minutes in this 3-ingredient recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut skirt steak into individual strips."
    },
    {
      "position": 2,
      "text": "Combine teriyaki sauce and garlic in a bowl; transfer to a resealable plastic bag. Add steak strips, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler (or preheat an outdoor grill and lightly oil the grate)."
    },
    {
      "position": 4,
      "text": "Remove steak strips from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 5,
      "text": "Place meat on a broiler pan (or directly on the grill). Cook to desired doneness, about 5 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

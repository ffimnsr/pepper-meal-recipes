  "id": "d2958038-1211-52ec-9a39-53d32a730d47",
  "slug": "mushroom-bok-choy-soup",
  "name": "Mushroom Bok Choy Soup",
  "recipe_type": "soup",
  "brief_description": "This nourishing bok choy soup with mushrooms is light and flavorsome with a heathy dose of fresh ginger and garlic to help cure what ails you.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat butter in a stockpot over medium heat. Add mushrooms, bok choy, green onions, garlic, and ginger. Sprinkle mushroom mixture with lime juice, then cook and stir just until lightly browned, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Increase the heat to medium-high. Pour in chicken broth and bring to a boil. Reduce the heat to low and simmer until vegetables are soft, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Ladle into bowls and garnish with cilantro and green bok choy leaves."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0dc84891-64bc-5f5e-b8a2-7860dd4ec06d",
  "slug": "salsa",
  "name": "Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This homemade salsa is easy to make, refreshing, and quick to throw together for a popular party appetizer with tortilla chips or topping for tacos.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, onion, tomatillo, cilantro, garlic, lime juice, and salt in a medium-sized mixing bowl. Mix well."
    },
    {
      "position": 3,
      "text": "Add 1/2 of the jalape\u00f1o pepper and taste. If you desire your salsa with more kick, add remaining 1/2 jalape\u00f1o."
    },
    {
      "position": 4,
      "text": "Cover the salsa and chill until ready to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

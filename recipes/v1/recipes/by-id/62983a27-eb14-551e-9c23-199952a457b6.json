  "id": "62983a27-eb14-551e-9c23-199952a457b6",
  "slug": "dads-favorite-peanut-butter-cookies",
  "name": "Dad's Favorite Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "My dad's sister gave me this recipe for killer peanut butter cookies made with shortening.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cream shortening, peanut butter, and both sugars in a large bowl with an electric mixer until light and fluffy. Beat in egg until incorporated. Mix flour, baking soda, baking powder, and salt in a separate bowl; gradually stir into peanut butter mixture until combined. Cover and refrigerate dough for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Roll chilled dough into walnut-sized balls and place 2 inches apart onto baking sheets. Flatten dough balls with a fork dipped in flour to form a crosswise pattern."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are set, 10 to 12 minutes. Transfer cookies to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "49dbb227-9f58-5557-b960-b2b87ec28114",
  "slug": "the-best-lemon-vinaigrette",
  "name": "The Best Lemon Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This tangy lemon vinaigrette is a delicious blend of olive oil, lemon juice, mustard, vinegar, and garlic for a standout dressing on your favorite salad.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk red wine vinegar, Dijon mustard, garlic, oregano, salt, and pepper together in a small bowl."
    },
    {
      "position": 3,
      "text": "Slowly stream olive oil into vinegar mixture, whisking continuously, until well combined."
    },
    {
      "position": 4,
      "text": "Add lemon juice and whisk to combine."
    },
    {
      "position": 5,
      "text": "Pour vinaigrette into a screw-top jar or bottle; seal. Shake before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

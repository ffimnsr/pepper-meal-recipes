  "id": "09dcab30-6418-5bb8-ab9e-ea45a308d9e5",
  "slug": "cornell-chicken",
  "name": "Cornell Chicken",
  "recipe_type": "main",
  "brief_description": "Dr. Baker's Cornell chicken recipe remains a favorite after more than 50 years. An easy seasoned apple cider marinade keeps it moist and flavorful.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Pur\u00e9e cider vinegar, oil, egg, salt, poultry seasoning, and pepper in a blender until smooth."
    },
    {
      "position": 2,
      "text": "Pour marinade into a resealable plastic bag. Add chicken halves, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 4 hours or overnight."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove chicken halves from the bag and transfer to a paper towel-lined baking sheet. Pat chicken dry with more paper towels. Reserve marinade."
    },
    {
      "position": 5,
      "text": "Place chicken, skin-side down, onto the preheated grill over direct heat. Grill for 2 minutes, then turn each piece, brush with marinade, and move to indirect heat. Continue to cook, turning often and brushing with marinade, until nicely browned and meat is no longer pink in the center, about 45 minutes. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read 165 degrees F (74 degrees C). Let rest for 5 to 10 minutes before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

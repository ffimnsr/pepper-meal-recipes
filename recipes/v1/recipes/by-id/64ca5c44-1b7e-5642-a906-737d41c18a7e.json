  "id": "64ca5c44-1b7e-5642-a906-737d41c18a7e",
  "slug": "crustless-cottage-cheese-mini-quiches",
  "name": "Crustless Cottage Cheese Mini Quiches",
  "recipe_type": "breakfast",
  "brief_description": "This crustless cottage cheese and broccoli mini quiche recipe is great for brunch, breakfast, or dinner. A quick and easy option that's full of flavor.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a jumbo 6-cup muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine eggs, cottage cheese, and milk in a blender or Vitamix. Blend on low speed to combine, 1 to 5 seconds. Pour mixture into a medium mixing bowl."
    },
    {
      "position": 3,
      "text": "Add broccoli, Colby-Jack cheese, and bell pepper to cottage cheese mixture; add garlic salt, and pepper. Stir to combine."
    },
    {
      "position": 4,
      "text": "Divide mixture evenly between the prepared muffin cups."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a knife inserted into the center of a quiche comes out clean, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

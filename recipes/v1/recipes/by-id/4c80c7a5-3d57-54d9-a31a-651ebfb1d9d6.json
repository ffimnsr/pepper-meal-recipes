  "id": "4c80c7a5-3d57-54d9-a31a-651ebfb1d9d6",
  "slug": "lazygirls-ground-turkey-stroganoff",
  "name": "Lazygirl's Ground Turkey Stroganoff",
  "recipe_type": "soup",
  "brief_description": "This easy turkey stroganoff recipe features a creamy mixture of ground turkey and condensed cream of mushroom soup served over warm egg noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain and keep warm."
    },
    {
      "position": 2,
      "text": "While the noodles are cooking, heat oil in a large skillet over medium heat. Add turkey and onion; cook and stir until turkey is browned and crumbly, 5 to 7 minutes. Stir in crumbled bouillon."
    },
    {
      "position": 3,
      "text": "Whisk condensed soup and water together in a small bowl; pour into the skillet and cook, stirring occasionally, until heated through, about 5 minutes. Season with paprika and salt. Serve over warm egg noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

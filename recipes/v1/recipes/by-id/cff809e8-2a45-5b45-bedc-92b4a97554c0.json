  "id": "cff809e8-2a45-5b45-bedc-92b4a97554c0",
  "slug": "mini-lemon-tarts-recipe-8641178",
  "name": "Mini Lemon Tarts",
  "recipe_type": "dessert",
  "brief_description": "These cute lemon tarts with a melt-in-the-mouth buttery crust and bright and zesty lemon filling make the perfect sweet and tangy bite-sized dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the filling: Combine sugar, lemon juice, eggs, flour, and lemon zest together in a large mixing bowl, and whisk until well blended. Set aside."
    },
    {
      "position": 3,
      "text": "To make the crust: Combine flour, butter, sugar, and salt in the bowl of a food processor; pulse several times until dough begins to come together in a ball."
    },
    {
      "position": 4,
      "text": "Divide the dough into 6 equal portions: press each portion of dough into the bottom and up the sides of nonstick 6-cup mini tart pan. Spoon lemon filling into each crust."
    },
    {
      "position": 5,
      "text": "Bake tarts in the preheated oven until the filling is set and the crust is lightly browned, 25 to 30 minutes. Cool on a wire rack until mini tarts reach room temperature."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d2e0a285-95f8-5f9e-b3cb-2b9465a703af",
  "slug": "besan-gram-flour-halwa",
  "name": "Besan (Gram Flour) Halwa",
  "recipe_type": "dessert",
  "brief_description": "If you like the flavor of chickpea flour (besan) in sweets, you will love this halwa. Your kids may gobble it up even before it has a chance to cool down.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring the milk and water to a simmer in a saucepan over medium-low heat; stir the cardamom into the mixture. Set aside."
    },
    {
      "position": 2,
      "text": "Melt the ghee in a shallow skillet over medium heat; stir the chickpea flour into the melted ghee and cook until fragrant, about 10 minutes. Add the sugar and stir to incorporate. Slowly pour the milk mixture into the skillet while stirring to avoid lumps. Continue cooking and stirring until the halwa pulls away from the sides of the pan, 10 to 15 minutes. Serve hot or spread the mixture into a rimmed plate and allow to cool. Cut into squares and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

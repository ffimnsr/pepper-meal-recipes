  "id": "10091779-844f-5f5f-8eb2-5aea07552ef3",
  "slug": "plum-kuchen",
  "name": "Plum Kuchen",
  "recipe_type": "dessert",
  "brief_description": "This plum kuchen recipe is a German coffee cake made with fresh plums, topped with a buttery cinnamon crumble, and takes only 15 minutes to prepare.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 7x11-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat \u00bd cup sugar and 2 tablespoons butter together in a bowl with an electric mixer until smooth and creamy. Add 1 cup flour, eggs, baking powder, and salt. Beat in vanilla. Pour batter into the prepared baking dish. Add plums, skin side down, over top."
    },
    {
      "position": 3,
      "text": "Mix 1 cup sugar, \u00bd cup flour, 3 tablespoons melted butter, and cinnamon together in a separate bowl until crumbly: spoon over batter and plums."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until plums are softened, about 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7e99c5a2-0c42-5787-b9f4-ee64234b3688",
  "slug": "steak-fajitas",
  "name": "Steak Fajitas",
  "recipe_type": "drink",
  "brief_description": "Beef strips are marinated for 2 to 4 hours in lime juice with cilantro, then sauteed, and simmered with green pepper, onions, and additional lime juice.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the lime juice, ground pepper and cilantro in a shallow dish. Place steak strips into the marinade and refrigerate for two to four hours."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon vegetable oil in a large skillet over medium-high heat. Add steak strips, and fry until cooked to your liking. Remove meat and set aside."
    },
    {
      "position": 3,
      "text": "Add remaining oil and onions to the skillet. Cook over medium low heat, until translucent, stir in green peppers and steak. Squeeze the juice of 1 lemon over the top and stir. When the green bell peppers are just tender remove the pan from the heat. Season with salt and pepper to taste. Serve the steak fajitas with tortillas and lemon wedges on the side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

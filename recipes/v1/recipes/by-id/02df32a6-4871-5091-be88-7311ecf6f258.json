  "id": "02df32a6-4871-5091-be88-7311ecf6f258",
  "slug": "fried-chicken-gizzards",
  "name": "Fried Chicken Gizzards",
  "recipe_type": "main",
  "brief_description": "Garlic powder is added to a simple breading to give a slightly different flavor to fried chicken gizzards.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim excess fat and gristle from chicken gizzards. Rinse under cold running water."
    },
    {
      "position": 2,
      "text": "Place gizzards in a pot of cold water. Bring water and gizzards to a rolling boil; continue to boil for about 15 minutes. Strain gizzards using a colander. Allow to cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine the flour, seasoned salt, pepper, and garlic powder in a plastic bag. Shake well to combine."
    },
    {
      "position": 4,
      "text": "Preheat vegetable oil in a skillet with a lid over medium-high heat to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Thoroughly coat gizzards with flour mixture and shake off excess. Gently lay the coated gizzards in the hot oil. Cook until brown. Reduce heat to medium; cover skillet with lid and cook another 10 minutes. Remove to paper towels to drain."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

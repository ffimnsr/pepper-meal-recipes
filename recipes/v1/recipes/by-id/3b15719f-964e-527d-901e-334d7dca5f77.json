  "id": "3b15719f-964e-527d-901e-334d7dca5f77",
  "slug": "breakfast-burrito-with-potatoes-and-chorizo-recipe-8608268",
  "name": "Breakfast Burrito with Potatoes and Chorizo",
  "recipe_type": "breakfast",
  "brief_description": "This delicious breakfast burrito with potatoes and chorizo will take your breakfast game up a notch. The rich flavors will have you coming back for more.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium heat. Add chorizo, poblano pepper, onions, and red bell pepper. Cook until vegetables are tender, 5 to 7 minutes. Remove skillet from heat."
    },
    {
      "position": 2,
      "text": "In a microwave-safe bowl, cook potatoes with a small amount of water until fork tender, 7 to 10 minutes, stirring halfway through; drain. Stir potatoes into chorizo mixture."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk eggs, half-and-half, salt, and pepper together in a large bowl."
    },
    {
      "position": 4,
      "text": "Heat butter in a skillet over medium heat. Add egg mixture and scramble until eggs are cooked, about 3 minutes. Remove eggs from heat. Fold in cheese."
    },
    {
      "position": 5,
      "text": "Spoon chorizo mixture in a line across the middle of a tortilla, then add a layer of scrambled eggs. Fold opposing edges of the tortilla to overlap the filling. Roll 1 of the opposing edges around the filling creating a burrito."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

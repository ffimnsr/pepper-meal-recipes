  "schema_version": 1,
  "id": "f6d835d5-e795-5ccd-9def-b7a2073487b9",
  "slug": "dubai-chocolate-strawberry-dip-recipe-8778431",
  "name": "Dubai Chocolate Strawberry Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Dubai chocolate strawberry dip mimics a Dubai chocolate bar. Velvety chocolate pudding, intensified with the addition of melted chocolate chips, is topped with a crunchy, toasted kataifi and pistachio layer, and served with whole strawberries for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat milk in a saucepan over low until steaming, about 3 minutes. Remove from heat and whisk in chocolate chips until smooth."
    },
    {
      "position": 3,
      "text": "Pour melted chocolate into a large shallow bowl. Cover with plastic wrap with wrap touching the surface of the chocolate mixture. Freeze until mixture is thickened and chilled, about 30 minutes."
    },
    {
      "position": 4,
      "text": "While chocolate mixture chills, melt butter in a nonstick skillet over medium heat. Add kataifi and cook, stirring occasionally, until golden brown and crispy, about 6 minutes. Transfer to a bowl; set aside 3 tablespoons for garnish."
    },
    {
      "position": 5,
      "text": "Pour chilled chocolate mixture through a fine-mesh strainer set over a large bowl with instant pudding. Whisk mixture constantly until slightly thickened and pudding mix is dissolved, about 4 minutes. Refrigerate until ready to use."
    },
    {
      "position": 6,
      "text": "Stir pistachio cream and water together in a separate bowl until smooth. Gently fold in kataifi, pistachios, and tahini until combined."
    },
    {
      "position": 7,
      "text": "Transfer kataifi mixture to a shallow serving bowl; spread in an even layer. Spread chocolate pudding on top in an even layer."
    },
    {
      "position": 8,
      "text": "Garnish with reserved kataifi, pistachios, and flaky salt, if desired. Serve with strawberries. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

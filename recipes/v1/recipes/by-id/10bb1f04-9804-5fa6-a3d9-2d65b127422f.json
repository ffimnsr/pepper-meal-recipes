{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "10bb1f04-9804-5fa6-a3d9-2d65b127422f",
  "slug": "brown-rice-and-black-bean-casserole",
  "name": "Brown Rice and Black Bean Casserole",
  "recipe_type": "main",
  "brief_description": "A yummy casserole with rice, beans, chicken, cheese and veggies. It\u2019s easy to prepare and the whole family will love it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix the rice and vegetable broth in a pot, and bring to a boil. Reduce heat to low, cover, and simmer 45 minutes, or until rice is tender."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a large casserole dish."
    },
    {
      "position": 3,
      "text": "Heat the olive oil in a skillet over medium heat, and cook the onion until tender. Mix in the zucchini, chicken, and mushrooms. Season with cumin, salt, and ground cayenne pepper. Cook and stir until zucchini is lightly browned and chicken is heated through."
    },
    {
      "position": 4,
      "text": "In large bowl, mix the cooked rice, onion, zucchini, chicken, mushrooms, beans, chiles, carrots, and 1/2 the Swiss cheese. Transfer to the prepared casserole dish, and sprinkle with remaining cheese."
    },
    {
      "position": 5,
      "text": "Cover casserole loosely with foil, and bake 30 minutes in the preheated oven. Uncover, and continue baking 10 minutes, or until bubbly and lightly browned."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

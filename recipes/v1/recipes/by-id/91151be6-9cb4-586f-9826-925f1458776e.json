  "id": "91151be6-9cb4-586f-9826-925f1458776e",
  "slug": "marinated-carrots",
  "name": "Marinated Carrots",
  "recipe_type": "side",
  "brief_description": "This recipe has been handed down through the generations. It is delicious hot or cold and will make a carrot lover out of anyone. I use either pre-cut carrot coins or baby carrots from the supermarket. Yummy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the carrots in a saucepan with enough lightly salted water to cover. Bring to a boil, and cook until almost done, about 5 minutes depending on how thick you slice them. Drain, and transfer to a large bowl. Add the bell pepper and onion to the bowl with the carrots."
    },
    {
      "position": 2,
      "text": "While the carrots are cooking, combine the vinegar, oil, tomato soup and sugar in a saucepan. Bring to a boil, and cook for 1 minute. Pour the hot dressing over the vegetables. Serve immediately, or store in the refrigerator in a covered container and serve within 1 week."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

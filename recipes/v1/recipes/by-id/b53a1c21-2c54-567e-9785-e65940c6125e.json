  "id": "b53a1c21-2c54-567e-9785-e65940c6125e",
  "slug": "baked-french-fries-ii",
  "name": "Baked French Fries II",
  "recipe_type": "side",
  "brief_description": "Potato strips are baked with Parmesan cheese and a little basil, resulting in fries that are a perfect accompaniment to almost any meal!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a medium baking sheet."
    },
    {
      "position": 2,
      "text": "Arrange potato strips in a single layer on the prepared baking sheet, skin sides down. Spray lightly with cooking spray, and sprinkle with basil, Parmesan cheese, salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake 25 minutes in the preheated oven, or until golden brown."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

  "id": "e4a660a4-0005-539b-b673-a3095353b7d7",
  "slug": "red-garlic-mashed-potatoes",
  "name": "Red Garlic Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These garlic mashed red potatoes make the creamiest, most delicious side. Quick and easy to make, they are always a favorite to serve with any meal.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and fill with enough water to cover. Add 1 teaspoon crushed garlic to the water for flavor. Bring to a boil and cook until potatoes are easily pierced with a fork, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Drain potatoes and add butter. Mash until butter is melted."
    },
    {
      "position": 3,
      "text": "Mix in half-and-half, steak seasoning, garlic powder, sugar, and remaining crushed garlic."
    },
    {
      "position": 4,
      "text": "Mix potatoes with an electric mixer until smooth."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

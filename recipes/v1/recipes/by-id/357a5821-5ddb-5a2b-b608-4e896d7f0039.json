  "id": "357a5821-5ddb-5a2b-b608-4e896d7f0039",
  "slug": "paleo-omelet-muffins",
  "name": "Paleo Omelet Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These paleo-style, muffin-shaped omelets with ham and vegetables are easy to make and easily adaptable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 8 muffin cups or line with paper liners."
    },
    {
      "position": 2,
      "text": "Beat eggs together in a large bowl. Mix ham, bell pepper, onion, salt, black pepper, and water into the beaten eggs. Pour egg mixture evenly into prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until muffins are set in the middle, 18 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

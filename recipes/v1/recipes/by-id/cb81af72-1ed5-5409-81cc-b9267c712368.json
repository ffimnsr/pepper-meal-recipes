  "id": "cb81af72-1ed5-5409-81cc-b9267c712368",
  "slug": "the-original-fantasy-fudge",
  "name": "The Original Fantasy Fudge",
  "recipe_type": "dessert",
  "brief_description": "The original fantasy fudge recipe from the back of the marshmallow creme jar. This foolproof fudge recipe can be made on the stovetop or in the microwave.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Grease a 9x13-inch pan."
    },
    {
      "position": 3,
      "text": "Mix sugar, butter, and evaporated milk in a large, heavy saucepan over medium heat, stirring to dissolve sugar. Bring mixture to a full boil and cook for 5 minutes, stirring constantly, until mixture is slightly thickened."
    },
    {
      "position": 4,
      "text": "Remove from the heat and add chocolate chips; stir until chocolate chips are melted and mixture is thoroughly combined."
    },
    {
      "position": 5,
      "text": "Stir in marshmallow creme until incorporated. Mix in walnuts and vanilla."
    },
    {
      "position": 6,
      "text": "Transfer fudge to the prepared pan and use an offset spatula to spread out evenly and flatten."
    },
    {
      "position": 7,
      "text": "Let cool for at least 1 hour before cutting into squares. Enjoy!"
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

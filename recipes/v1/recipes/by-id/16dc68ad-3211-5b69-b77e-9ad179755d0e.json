  "slug": "4-ingredient-orange-chicken-recipe-8713472",
  "name": "4-Ingredient Orange Chicken",
  "recipe_type": "main",
  "brief_description": "This 4-ingredient orange chicken is great for when you\u2019re craving takeout. It\u2019s so simple to make at home, is very budget-friendly, and only takes 4 ingredients.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place frozen nuggets in a single layer on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until hot and crispy, 11 to 13 minutes, or according to package directions."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk marmalade, BBQ sauce, and soy sauce together in a small saucepan and heat over low heat until hot, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Place nuggets in a large bowl. Drizzle sauce over the top. Toss to coat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

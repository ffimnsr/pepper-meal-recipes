  "id": "c5d83b21-3fbf-50b0-96ef-d0a4a3d3cbef",
  "slug": "fresh-carrot-souffle",
  "name": "Fresh Carrot Souffl\u00e9",
  "recipe_type": "dessert",
  "brief_description": "This delicious carrot souffl\u00e9 made with pur\u00e9ed carrots, sugar, and eggs may remind you of a sweet potato casserole in both texture and taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add carrots and cook until very tender, 7 to 10 minutes. Drain and transfer to a large mixing bowl."
    },
    {
      "position": 3,
      "text": "Use an electric mixer to beat warm carrots with sugar, baking powder, and vanilla extract until smooth. Mix in flour, eggs, and margarine. Transfer to a 2-quart baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is golden brown, about 1 hour. Sprinkle lightly with confectioners\u2019 sugar before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,

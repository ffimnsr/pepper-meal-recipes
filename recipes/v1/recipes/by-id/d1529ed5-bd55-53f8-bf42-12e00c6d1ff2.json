  "slug": "crispy-oven-baked-bacon",
  "name": "Crispy Oven-Baked Bacon",
  "recipe_type": "breakfast",
  "brief_description": "No preheating necessary--this crispy bacon starts out in a cold oven but cooks to perfection in less than 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a rimmed baking sheet with parchment paper. Place bacon on sheet and place in a cold oven."
    },
    {
      "position": 2,
      "text": "Set the oven to 400 degrees F (200 degrees C) and cook bacon until crispy, 25 to 30 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,

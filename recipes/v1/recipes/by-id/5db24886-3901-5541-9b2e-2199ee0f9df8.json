  "id": "5db24886-3901-5541-9b2e-2199ee0f9df8",
  "slug": "blueberry-zucchini-bread",
  "name": "Blueberry Zucchini Bread",
  "recipe_type": "breakfast",
  "brief_description": "Yummy blueberry zucchini bread packed with juicy, fresh blueberries and shredded zucchini. This recipe makes 4 mini loaves \u2014 perfect for gift-giving!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 4 mini loaf pans."
    },
    {
      "position": 3,
      "text": "Beat sugar, oil, eggs, and vanilla together in a large bowl; fold in shredded zucchini."
    },
    {
      "position": 4,
      "text": "Beat in flour, cinnamon, salt, baking powder, and baking soda until just combined."
    },
    {
      "position": 5,
      "text": "Gently fold in blueberries. Pour batter into the prepared pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 minutes."
    },
    {
      "position": 7,
      "text": "Cool in the pans for 20 minutes, then turn out onto a wire rack to cool completely. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

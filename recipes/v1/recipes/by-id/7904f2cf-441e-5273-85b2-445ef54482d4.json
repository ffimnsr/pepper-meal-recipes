  "id": "7904f2cf-441e-5273-85b2-445ef54482d4",
  "slug": "cookie-bar-blondies-for-a-crowd",
  "name": "Cookie Bar Blondies for a Crowd",
  "recipe_type": "dessert",
  "brief_description": "This easy chocolate chip cookie bar recipe is a great idea for your next party--it makes two large pans of decadent blondies that your guests will devour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x13-inch baking pans with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together 3 cups flour, baking powder, baking soda, and salt in a medium bowl. Toss chocolate chips with 1 tablespoon flour in another medium bowl until lightly coated."
    },
    {
      "position": 3,
      "text": "Beat butter and brown sugar in a large bowl with an electric mixer until creamy, 4 to 5 minutes. Add eggs, vanilla, and almond extract; mix well. Gradually add flour mixture, mixing on low speed. Fold in chocolate chips."
    },
    {
      "position": 4,
      "text": "Divide batter evenly between the 2 prepared pans. Spread thinly with the back of a metal spoon; bars will rise when baking."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and edges have started to pull away from the sides of the pan, 22 to 25 minutes. Let cool completely before cutting into squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

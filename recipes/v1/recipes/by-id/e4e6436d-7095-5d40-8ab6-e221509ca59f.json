  "id": "e4e6436d-7095-5d40-8ab6-e221509ca59f",
  "slug": "asparagus-omelette",
  "name": "Asparagus Omelette",
  "recipe_type": "breakfast",
  "brief_description": "Bacon and asparagus omelette is topped with mozzarella cheese for a delicious and fresh breakfast for lazy Sunday mornings or a quick dinner for weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble bacon pieces."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add asparagus and cook until tender yet firm to the bite, 2 to 3 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a skillet over medium-high heat; saute onion, tomato, and mushrooms until tender, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Whisk eggs and cream together in a bowl; add bacon, sauteed vegetables, asparagus, nutmeg, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Pour egg mixture into an oven-proof nonstick skillet and cover skillet. Cook over medium-low until cooked through, 10 to 12 minutes. Sprinkle mozzarella cheese over omelette."
    },
    {
      "position": 6,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 7,
      "text": "Broil omelette in the preheated oven until a golden crust starts to form on the top, about 2 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

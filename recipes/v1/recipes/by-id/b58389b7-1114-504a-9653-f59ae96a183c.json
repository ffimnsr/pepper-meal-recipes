  "schema_version": 1,
  "id": "b58389b7-1114-504a-9653-f59ae96a183c",
  "slug": "black-forest-cake-i",
  "name": "Black Forest Cake",
  "recipe_type": "dessert",
  "brief_description": "This black forest cake has moist chocolate sponge cake layers with cherry filling and sweet whipped cream for the ultimate chocolate gateau experience!",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans; line bottoms with parchment paper. Place a medium bowl in the refrigerator to chill before using it to whip the cream."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, cocoa, baking powder, baking soda, and salt together in a large bowl."
    },
    {
      "position": 4,
      "text": "Add eggs, milk, oil, and vanilla; beat until combined."
    },
    {
      "position": 5,
      "text": "Pour cake batter into the prepared pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, about 35 minutes. Cool layers in pans on wire racks for 10 minutes. Run a paring knife around edges to loosen and invert carefully onto racks to cool completely, 1 to 2 hours."
    },
    {
      "position": 7,
      "text": "While cake layers bake, drain cherries for topping, reserving 1/2 cup juice. Combine reserved juice, cherries, sugar, and cornstarch in a 2-quart saucepan."
    },
    {
      "position": 8,
      "text": "Cook, stirring constantly, over low heat until thickened. Stir in vanilla. Let cool at room temperature for 30 minutes. Transfer to the refrigerator to cool completely before assembling cake."
    },
    {
      "position": 9,
      "text": "To make the frosting: Combine whipping cream and confectioners' sugar in the chilled medium bowl. Beat with an electric mixer at high speed until stiff peaks form."
    },
    {
      "position": 10,
      "text": "Split each cake layer in half horizontally using a long serrated knife."
    },
    {
      "position": 11,
      "text": "Tear one layer into crumbs; set aside."
    },
    {
      "position": 12,
      "text": "Gently brush loose crumbs off top and sides of remaining layers using a pastry brush or your hands. Reserve 1 \u00bd cups of frosting for piping decorations on cake; set aside."
    },
    {
      "position": 13,
      "text": "To assemble, place one cake layer on a cake plate. Spread with 1 cup frosting; top with 3/4 cup cherry topping."
    },
    {
      "position": 14,
      "text": "Top with second cake layer; repeat layers of frosting and cherry topping."
    },
    {
      "position": 15,
      "text": "Top with third cake layer and frost sides of cake."
    },
    {
      "position": 16,
      "text": "Pat reserved cake crumbs onto sides of cake."
    },
    {
      "position": 17,
      "text": "Spoon reserved 1 \u00bd cups frosting into a pastry bag fitted with a star decorator tip. Pipe around top and bottom edges of cake."
    },
    {
      "position": 18,
      "text": "Spoon remaining cherry topping on top of cake."
    },
    {
      "position": 19,
      "text": "Store covered in the refrigerator until ready to serve. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,

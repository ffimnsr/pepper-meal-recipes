  "id": "f8388ee0-ef9a-5232-82f4-b739e34a5460",
  "slug": "herbed-lemon-chicken-and-rice-recipe-12004661",
  "name": "Herbed Lemon Chicken and Rice",
  "recipe_type": "main",
  "brief_description": "This herbed lemon chicken and rice is a modern take on my great-grandma\u2019s baked chicken and rice casserole. Familiar, comforting, and easy to make, it\u2019s a fresh spin on a classic family recipe that\u2019s perfect for busy weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray a glass casserole dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "In the casserole dish combine: rice, bone broth, McCormick seasoning packet, diced onion, minced garlic, lemon juice, pimentos and olive oil. Stir well to dissolve seasoning into the liquid."
    },
    {
      "position": 3,
      "text": "Place chicken thighs on top. Dot chicken with butter pieces. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake until rice is tender and chicken is fully cooked, about 60 minutes. Remove foil, sprinkle with thyme, Cantanzaro herbs, paprika, and parsley, and return to the oven to bake for 20 minutes more."
    },
    {
      "position": 5,
      "text": "Finish with additional fresh lemon juice and parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

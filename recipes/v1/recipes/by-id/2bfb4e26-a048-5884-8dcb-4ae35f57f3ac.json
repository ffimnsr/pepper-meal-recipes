  "id": "2bfb4e26-a048-5884-8dcb-4ae35f57f3ac",
  "slug": "slow-cooker-chicken-rotel-tacos-recipe-12011448",
  "name": "Slow Cooker Chicken Rotel Tacos",
  "recipe_type": "main",
  "brief_description": "These slow cooker chicken Rotel tacos are an easy, crowd-friendly dinner with saucy shredded chicken and mild Tex-Mex flavor. Serve the filling in crispy taco shells, burritos, or burrito bowls, then let everyone build their own straight from the slow cooker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, taco seasoning, and onion in a 3 1/2- to 4-quart slow cooker. Toss to combine. Top with drained cans of diced tomatoes with green peppers."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low 5 to 6 hours or on High 3 hours."
    },
    {
      "position": 3,
      "text": "If using Low heat setting, turn to High heat setting. Coarsely shred chicken with two forks. Add processed cheese food. Cover and cook on High until cheese is melted, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Serve chicken mixture in taco shells with lettuce, sour cream, and taco sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 330,
  "preparation_time_minutes": 15,

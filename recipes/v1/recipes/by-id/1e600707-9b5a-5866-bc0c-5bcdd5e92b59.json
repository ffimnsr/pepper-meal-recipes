  "id": "1e600707-9b5a-5866-bc0c-5bcdd5e92b59",
  "slug": "marry-me-dip-recipe-8773820",
  "name": "Marry Me Dip",
  "recipe_type": "appetizer",
  "brief_description": "This marry me dip is a cross between Tuscan \u201cmarry me\u201d flavors and hot spinach dip, very creamy and rich. With punchy sun-dried tomato bits and gooey melted mozzarella, this dip is just delightful.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon sun-dried tomato oil in a 10-inch enamel-coated cast-iron skillet over medium. Add garlic and tomato paste and cook, stirring constantly, until garlic is fragrant and tomato paste is slightly darker in color, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Remove the skillet from heat and whisk in cream cheese and sour cream until smooth. Fold in spinach, Parmesan, Italian seasoning, pepper, salt, sun-dried tomatoes, and 1 cup mozzarella until evenly combined."
    },
    {
      "position": 4,
      "text": "Spread tomato mixture into an even layer. Sprinkle evenly with remaining 1/4 cup mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until cheese is fully melted and edges are bubbling, 8 to 10 minutes. Without removing skillet from oven, increase oven temperature to broil. Broil until cheese is lightly browned on top, 3 to 5 minutes. Garnish with basil and serve immediately with crostini. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

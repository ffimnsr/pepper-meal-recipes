  "slug": "tangy-poppy-seed-fruit-salad",
  "name": "Tangy Poppy Seed Fruit Salad",
  "recipe_type": "salad",
  "brief_description": "Pineapple, orange, kiwi, grapes and strawberries tossed with a sweet, lime and poppy seed dressing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, toss pineapple, orange, kiwi, grapes and strawberries. In a small cup or bowl, combine lime zest, lime juice, honey, poppy seeds and 1/4 cup reserved pineapple juice. Stir well and toss with fruit."
    }
  ],

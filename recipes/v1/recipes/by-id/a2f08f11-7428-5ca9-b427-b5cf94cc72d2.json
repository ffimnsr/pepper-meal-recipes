  "id": "a2f08f11-7428-5ca9-b427-b5cf94cc72d2",
  "slug": "easy-authentic-spanish-rice",
  "name": "Easy Authentic Spanish Rice",
  "recipe_type": "side",
  "brief_description": "White rice simmers in Mexican-style tomatoes, onions, and jalapeno peppers for a quick and easy side dish of traditional Spanish rice. Top with shredded Cheddar and sour cream, if desired.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium-high heat; cook and stir onions and jalape\u00f1o peppers in butter until softened, 3 to 5 minutes. Stir Mexican-style tomatoes into onion mixture; add rice, salt, and black pepper. Add just enough water to cover rice."
    },
    {
      "position": 2,
      "text": "Bring rice mixture to a boil, reduce heat, cover, and simmer until rice is cooked, 40 to 45 minutes. Garnish with sour cream and Cheddar cheese to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

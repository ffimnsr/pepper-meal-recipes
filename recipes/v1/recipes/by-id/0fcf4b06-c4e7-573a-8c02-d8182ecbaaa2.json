  "id": "0fcf4b06-c4e7-573a-8c02-d8182ecbaaa2",
  "slug": "roasted-tomato-salsa-i",
  "name": "Roasted Tomato Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This roasted tomato salsa is bursting with flavor thanks to sweet and smoky roasted tomatoes, garlic, onion, jalape\u00f1o, cumin, and cilantro.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Place tomatoes, onion, garlic, and jalape\u00f1o in a medium baking dish; drizzle with olive oil."
    },
    {
      "position": 3,
      "text": "Broil, checking often, until the vegetables are charred, about 5 to 10 minutes. Remove vegetables from heat. Remove and discard tomato cores, jalape\u00f1o stem, and garlic skins."
    },
    {
      "position": 4,
      "text": "Transfer charred vegetables into a blender or food processor; process until coarsely chopped. Transfer into a medium bowl; stir in cilantro, lime juice, cumin, and salt."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

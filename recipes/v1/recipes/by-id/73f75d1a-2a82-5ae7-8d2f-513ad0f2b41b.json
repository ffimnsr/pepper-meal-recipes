  "schema_version": 1,
  "id": "73f75d1a-2a82-5ae7-8d2f-513ad0f2b41b",
  "slug": "lemon-blueberry-scones-with-blueberry-glaze",
  "name": "Lemon-Blueberry Scones with Blueberry Glaze",
  "recipe_type": "dessert",
  "brief_description": "This lemon-blueberry scone recipe with blueberry glaze makes tender scones from Greek yogurt, plus cardamom, ginger, and whole wheat flour for flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine whole wheat flour, all-purpose flour, sugar, baking powder, cardamom, lemon zest, baking soda, salt, and ginger in a large bowl. Grate in frozen butter using a box grater; toss until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Combine yogurt, cream, 1 egg, and vanilla extract in a small bowl; stir into flour mixture until forms a crumbly dough and just until no dry clumps of flour remain. Stir in 1 cup unthawed blueberries."
    },
    {
      "position": 4,
      "text": "Pour crumbly dough onto the prepared baking sheet; firmly press together until forms a cohesive 8-inch circle. Flatten top to ensure circle is even. Cut into 8 triangular pieces; space pieces 1 inch apart on the baking sheet."
    },
    {
      "position": 5,
      "text": "Whisk 1 egg and water together in a small bowl; gently brush over tops of each scone."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until tops are golden brown, 20 to 25 minutes. Cool completely, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Press 1/4 cup thawed blueberries through a fine-mesh strainer into a medium bowl using the back of a wooden spoon to extract 2 to 3 tablespoons juice. Discards skins and seeds. Whisk confectioners' sugar and lemon juice into blueberry juice until smooth; drizzle over cooled scones."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

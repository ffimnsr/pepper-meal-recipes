  "slug": "blueberry-banana-and-peanut-butter-smoothie",
  "name": "Blueberry, Banana, and Peanut Butter Smoothie",
  "recipe_type": "snack",
  "brief_description": "This is a perfect peanut butter and berry smoothie to start your day or enjoy as a snack. Flax gives a boost to this recipe. It\u2019s kid-friendly too!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put flaxseed meal into a blender to grind and further break down."
    },
    {
      "position": 2,
      "text": "Place banana, milk, blueberries, yogurt, peanut butter, and honey into the blender. Cover and pur\u00e9e until smooth."
    },
    {
      "position": 3,
      "text": "Pour into glasses to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5d33e662-4d75-5203-8283-667f9b48a2d5",
  "slug": "best-home-style-beef-stroganoff",
  "name": "Best Home-Style Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "Tender strips of sirloin in a savory sauce served over buttery egg noodles\u2014this beef stroganoff is comfort food at its best, plus it's easy on the wallet!",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Slice beef into very thin strips and season with \u00bd teaspoon each salt, pepper, and garlic powder."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons oil in a large skillet over medium-high heat until very hot. Add \u00bd of the beef in a single layer and cook, undisturbed, for 2 minutes. Flip and cook until browned on the other side, about 1 minute. Remove to a plate and repeat with the remaining olive oil and beef."
    },
    {
      "position": 3,
      "text": "Fill a large pot with water and set over high heat on another burner."
    },
    {
      "position": 4,
      "text": "Melt 2 tablespoons butter in the same skillet over medium heat. Add onion and cook until it starts to release its juices, about 2 minutes. Add mushrooms and \u00bd teaspoon salt; cook, stirring often, until tender and lightly browned, 2 to 4 minutes. Sprinkle with flour and cook, stirring constantly, for 1 to 2 minutes. Stir in tomato paste and cook for 1 minute."
    },
    {
      "position": 5,
      "text": "Whisk in 2 cups beef broth and mustard and bring to a simmer, scraping the browned bits of food off the bottom of the pan with a wooden spoon. Add more broth if necessary as sauce thickens. Stir in Worcestershire sauce and add reserved beef and any drippings. Reduce heat to low and simmer, stirring occasionally, while you cook the pasta."
    },
    {
      "position": 6,
      "text": "Add egg noodles and remaining 1 teaspoon salt to the boiling water. Boil until noodles are tender yet firm to the bite, 7 to 9 minutes. Drain noodles and toss with remaining 1 tablespoon butter."
    },
    {
      "position": 7,
      "text": "Add sour cream to the sauce, a little at a time, stirring swiftly to incorporate. Taste and adjust salt and pepper, if needed."
    },
    {
      "position": 8,
      "text": "Ladle sauce over egg noodles and garnish with parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

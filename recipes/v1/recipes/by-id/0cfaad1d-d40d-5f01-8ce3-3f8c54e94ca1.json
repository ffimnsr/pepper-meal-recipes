  "id": "0cfaad1d-d40d-5f01-8ce3-3f8c54e94ca1",
  "slug": "cabbage-boil-recipe-11833184",
  "name": "Cabbage Boil",
  "recipe_type": "side",
  "brief_description": "This cabbage boil recipe is so spicy and delicious! A whole cabbage, seasoned and tightly wrapped, bakes for 2 hours to become meltingly tender and fully infused with flavor. Serve with rice.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 385 degrees F (196 degrees C)."
    },
    {
      "position": 2,
      "text": "Remove core from cabbage and make 6 2-inch cuts down from the core about 1/4 of the way down. Coat the cabbage with oil."
    },
    {
      "position": 3,
      "text": "Season cabbage with a 1 teaspoon each of the following seasonings: garlic powder, smoked paprika, paprika, Cajun seasoning, Old Bay, and chicken bouillon. Squeeze 1/2 lemon over cabbage and rub spices into cabbage until completely coated."
    },
    {
      "position": 4,
      "text": "Place 3 tablespoons butter in the center of cabbage and wrap tightly using two sheets of foil. Place on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour."
    },
    {
      "position": 6,
      "text": "Meanwhile, melt remaining butter and whisk in remaining 1 teaspoon each garlic powder, smoked paprika, paprika, Cajun seasoning, Old Bay, and lemon juice. Set aside."
    },
    {
      "position": 7,
      "text": "After 1 hour, remove cabbage from the oven and spoon 1 to 2 tablespoons of butter mixture over the cabbage. Re-wrap cabbage in the same foil."
    },
    {
      "position": 8,
      "text": "Bake for 1 additional hour. Remove from oven and allow cabbage to cool for 5 to 10 minutes. Season with salt and black pepper; serve with remaining butter mixture for dipping if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

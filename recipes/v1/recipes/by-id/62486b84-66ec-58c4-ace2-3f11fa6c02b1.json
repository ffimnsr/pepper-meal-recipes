  "slug": "spiked-strawberry-lemonade-recipe-7564731",
  "name": "Spiked Strawberry Lemonade",
  "recipe_type": "appetizer",
  "brief_description": "Spiked strawberry lemonade, made from a puree of fresh strawberries and lemon juice, is a delicious drink to cool you down on hot summer days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries, lemon juice, and 1 cup water in a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour into a pitcher and add remaining 2 cups water. Taste; add sugar as desired."
    },
    {
      "position": 3,
      "text": "Fill each glass with ice, add 2 ounces vodka per glass, and top off with strawberry lemonade."
    }
  ],
  "servings": 4,

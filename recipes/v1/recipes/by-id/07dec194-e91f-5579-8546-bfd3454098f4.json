  "id": "07dec194-e91f-5579-8546-bfd3454098f4",
  "slug": "crab-chowder",
  "name": "Crab Chowder",
  "recipe_type": "soup",
  "brief_description": "Dungeness crab is put to good use in this creamy crab chowder that is quick and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Cook and stir onion, celery, thyme, salt, and pepper in hot butter until onion and celery start to soften, about 5 minutes. Stir potatoes, milk, broth, cream, and clam juice into onion mixture. Bring to a simmer; cook until potatoes are soft, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Pour broth mixture into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until smooth. Return pureed soup to pot and stir in crabmeat. Cook until soup is hot and crab is heated through, about 5 minutes. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "561bb562-5d79-5827-ba95-10478c624520",
  "slug": "amelias-tuna-macaroni-salad",
  "name": "Tuna Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "This tuna macaroni salad is super easy to make with macaroni pasta, canned tuna, and peas mixed with mayo and relish and topped with hard-boiled eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and rinse under cold running water."
    },
    {
      "position": 3,
      "text": "Stir together macaroni, peas, celery, tuna, and onion in a large bowl."
    },
    {
      "position": 4,
      "text": "Mix in mayonnaise, relish, salt and pepper."
    },
    {
      "position": 5,
      "text": "Garnish with egg wedges and a sprinkle of paprika. Cover and chill for at least 1 hour before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

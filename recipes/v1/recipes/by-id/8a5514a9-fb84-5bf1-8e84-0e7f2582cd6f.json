  "id": "8a5514a9-fb84-5bf1-8e84-0e7f2582cd6f",
  "slug": "slow-cooker-spicy-black-eyed-peas",
  "name": "Slow Cooker Spicy Black-Eyed Peas",
  "recipe_type": "side",
  "brief_description": "These hearty slow cooker black-eyed peas with jalape\u00f1o pepper, garlic, cumin, ham, bacon, and bell peppers make a deliciously spicy side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour water into a slow cooker; add bouillon cube and stir to dissolve."
    },
    {
      "position": 3,
      "text": "Stir in black-eyed peas, ham, bacon, onion, bell pepper, jalape\u00f1o, garlic, cumin, black pepper, cayenne pepper, and salt."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until beans are tender, 6 to 8 hours."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 360,

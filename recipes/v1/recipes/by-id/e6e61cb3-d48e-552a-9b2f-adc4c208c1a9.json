  "id": "e6e61cb3-d48e-552a-9b2f-adc4c208c1a9",
  "slug": "irish-stout-beer-pot-roast",
  "name": "Irish Stout Beer Pot Roast",
  "recipe_type": "main",
  "brief_description": "This Irish pot roast is made with beer, so it's extra moist and cooks up in a delicious gravy that's perfect for sopping up with some crusty bread.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together beer, condensed soup, onion, onion soup mix, and garlic in a slow cooker until combined. Season beef chuck roast with salt and pepper; place in the slow cooker. Arrange potatoes and carrots around roast."
    },
    {
      "position": 2,
      "text": "Cook on Low for 6 hours."
    },
    {
      "position": 3,
      "text": "Add celery to the slow cooker. Continue cooking until roast falls apart easily and potatoes are softened, about 2 hours more. Serve meat and vegetables with gravy on top."
    }
  ],
  "servings": 4,

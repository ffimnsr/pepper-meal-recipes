  "id": "5e427454-339a-5dec-96a3-3c146fb670bd",
  "slug": "puerto-rican-sancocho",
  "name": "Puerto Rican Sancocho",
  "recipe_type": "soup",
  "brief_description": "This sancocho recipe is a Puerto Rican beef stew loaded with many delicious vegetables and makes for a warm and comforting meal for cold days.",
  "cuisine": "Puerto Rican Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium-low heat. Add onion, garlic, cilantro, white pepper, oregano, and salt. Cook and stir until onion is browned and very tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Add stew meat; cook and stir until meat is browned on all sides, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Pour enough water over meat mixture to fill the pot 3/4 full. Add tomato sauce and beef bouillon."
    },
    {
      "position": 5,
      "text": "Stir in the remaining ingredients, one at a time, cooking slightly after each addition in the following order: green beans, carrots, celery, chayote squash, white beans, cabbage, green banana, yellow plantain, llautias, potatoes, pumpkin, corn, and green bell pepper."
    },
    {
      "position": 6,
      "text": "Cook until all the vegetables are tender and stew has formed a rich broth, 2 to 3 hours. Add more water or salt if needed."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "expert",

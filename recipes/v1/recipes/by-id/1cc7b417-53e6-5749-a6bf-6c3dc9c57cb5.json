  "id": "1cc7b417-53e6-5749-a6bf-6c3dc9c57cb5",
  "slug": "sugar-coated-pecans",
  "name": "Sugar-Coated Pecans",
  "recipe_type": "appetizer",
  "brief_description": "These sugar-coated pecans are coated in egg white and cinnamon sugar, then slow-roasted until crunchy for a wonderfully sweet candied snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C). Grease a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together egg white and water in a medium bowl until frothy."
    },
    {
      "position": 3,
      "text": "Mix together sugar, salt, and cinnamon in a separate bowl."
    },
    {
      "position": 4,
      "text": "Add pecans to egg white mixture; stir to coat."
    },
    {
      "position": 5,
      "text": "Transfer pecans to sugar mixture; toss to coat."
    },
    {
      "position": 6,
      "text": "Spread pecans out on the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until crisp, about 1 hour; stir every 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

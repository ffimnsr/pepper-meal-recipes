  "slug": "boiling-water-pastry",
  "name": "Boiling Water Pastry",
  "recipe_type": "dessert",
  "brief_description": "There\u2019s no surprise in this simple, no-fail how water pastry recipe. There\u2019s pastry flour and boiling water in this wonderfully flaky pie crust. It\u2019s perfect for your favorite pie filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place shortening into a heat-proof bowl. Pour in boiling water and whip mixture until creamy."
    },
    {
      "position": 2,
      "text": "Mix together flour and salt in a separate bowl. Add flour mixture to shortening mixture. Stir until pastry stops sticking to the sides of the bowl. Refrigerate pastry before rolling it out."
    }
  ],

  "id": "9d3fa57e-2b00-58eb-983c-0a4fe96a8f29",
  "slug": "pasta-carbonara-i",
  "name": "Creamy Pasta Carbonara",
  "recipe_type": "main",
  "brief_description": "This carbonara recipe with cream, whipped egg, and Parmesan cheese features crisp bacon bits tossed with hot, buttery noodles for an indulgent dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir bacon in a large skillet over medium-high heat until evenly browned and crisp, about 10 minutes. Drain on a paper towel-lined plate and set aside."
    },
    {
      "position": 2,
      "text": "Beat together eggs and cream in a medium bowl until just blended. Stir in Parmesan cheese and set aside."
    },
    {
      "position": 3,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook pasta in boiling water until tender yet firm to the bite, about 8 minutes. Drain and return pasta to the pot."
    },
    {
      "position": 4,
      "text": "Add softened butter to the pot and toss with pasta until butter is melted. Add bacon and egg-cheese mixture. Stir until the heat of pasta cooks eggs, then garnish with parsley and black pepper to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

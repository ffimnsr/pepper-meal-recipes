  "id": "929c96fe-7b41-5631-988f-585dc46e4d51",
  "slug": "old-fashioned-honey-pecan-pie",
  "name": "Old-Fashioned Honey Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned pecan pie is made with honey instead of white sugar. It's a sweet treat that's perfect for a holiday dessert or any special occasion.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Press pastry into a 9-inch pie pan."
    },
    {
      "position": 2,
      "text": "Bring honey to a boil in a saucepan. Remove from the heat and quickly whisk in eggs. Stir in pecans, butter, vanilla, and nutmeg. Pour into the prepared pie pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "ba970393-dffe-5c4a-a5c6-54bf94a4a215",
  "slug": "avocado-and-bacon-stuffed-eggs",
  "name": "Avocado and Bacon-Stuffed Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Mashed avocado and bacon add great taste and texture to deviled eggs in this quick and easy recipe that takes them to a new level.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 5 minutes. Drain on paper towels."
    },
    {
      "position": 2,
      "text": "Mash avocado in a large bowl with a fork. Mix in bacon, yolks from the hard-boiled eggs, mayonnaise, mustard, and lime juice."
    },
    {
      "position": 3,
      "text": "Spoon avocado mixture into the egg whites. Garnish eggs with red pepper flakes. Chill until ready to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

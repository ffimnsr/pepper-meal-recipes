  "schema_version": 1,
  "id": "997c9c69-6fe3-53fa-af39-1fa5016c6599",
  "slug": "parmesan-zucchini-rings-with-zucchini-ranch-recipe-12033652",
  "name": "Parmesan Zucchini Rings with Zucchini Ranch",
  "recipe_type": "salad",
  "brief_description": "These Parmesan zucchini rings, encrusted with panko and air-fried, are served with a creamy dip made from the zucchini centers. Crunchy and golden brown, these rings are a novel way to serve abundant summer zucchini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice zucchini into 3/4-inch rounds. Use a milk bottle cap to punch out the centers; set centers aside. Lightly salt the rings and let sit for 20 minutes. Pat dry."
    },
    {
      "position": 2,
      "text": "Place beaten eggs in a shallow bowl."
    },
    {
      "position": 3,
      "text": "Mix panko, Parmesan cheese, cornstarch, garlic powder, onion powder, paprika, Italian seasoning, 1/2 teaspoon salt, and pepper together in another shallow bowl."
    },
    {
      "position": 4,
      "text": "Coat rings in this order: Dip in flour, egg, then panko, then dip in egg again, and panko again. Lay on a plate to rest for 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Lay rings in the basket of an air fryer and spray with avocado oil."
    },
    {
      "position": 6,
      "text": "Air fry at 350 degrees F (180 degrees C) for 6 to 7 minutes. Flip rings and spray again with avocado oil; continue to air fry until golden brown, 6 to 7 minutes more."
    },
    {
      "position": 7,
      "text": "Meanwhile, for zucchini ranch dip, saut\u00e9 zucchini centers in avocado oil until lightly browned and tender. Let cool."
    },
    {
      "position": 8,
      "text": "Place centers in the jar of a blender with sour cream, mayonnaise, buttermilk, dill, chives, parsley, garlic powder, onion powder, lemon juice, Worcestershire,1/4 teaspoon salt, and black pepper."
    },
    {
      "position": 9,
      "text": "Chill dressing for 30 minutes before serving. Make ahead if desired."
    },
    {
      "position": 10,
      "text": "Serve zucchini rings warm with zucchini ranch for dipping and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

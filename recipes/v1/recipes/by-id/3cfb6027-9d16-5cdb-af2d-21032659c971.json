  "id": "3cfb6027-9d16-5cdb-af2d-21032659c971",
  "slug": "pecan-tarts",
  "name": "Pecan Tarts",
  "recipe_type": "dessert",
  "brief_description": "This pecan tarts recipe makes eight tiny tarts filled with a sweet, buttery pecan filling. Pipe a whipped cream rosette on top for a fancy dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease eight 3-inch tart tins."
    },
    {
      "position": 2,
      "text": "Roll out pastry and cut out eight 5-inch circles; fit pastry circles into greased tart tins."
    },
    {
      "position": 3,
      "text": "Mix sugar, eggs, corn syrup, melted butter, and vanilla extract in a large bowl until combined; stir in pecans. Spoon filling into each pastry-lined tart tin, filling each 3/4 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pastry is golden brown and filling is set, about 30 to 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "03901993-5156-52ff-83c1-6e32343a096c",
  "slug": "irish-chicken-and-dumplings",
  "name": "Chicken and Dumplings with Vegetables",
  "recipe_type": "soup",
  "brief_description": "This creamy chicken and dumplings dish with vegetables is topped with biscuit dough dumplings for a hearty and comforting dish on a cold night.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soup, water, chicken, celery, onion, salt, poultry seasoning, and pepper in a large, heavy pot. Cover and cook over low heat for 1 \u00bd hours."
    },
    {
      "position": 2,
      "text": "Add potatoes and carrots; cover and cook for another 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove chicken from pot, shred it, and return to pot. Add peas and cook only 5 minutes longer."
    },
    {
      "position": 4,
      "text": "Add dumplings. To make dumplings: Mix baking mix and milk until a soft dough forms. Drop by tablespoonfuls onto boiling stew. Simmer covered for 10 minutes, then uncover and simmer an additional 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,

  "id": "f47fe8a0-22db-5cf4-be71-8d17bb5a0431",
  "slug": "six-egg-pound-cake",
  "name": "Six-Egg Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "Made with six eggs, this pound cake recipe outshines other pound cake recipes with its lofty height and just needs a dusting of sugar to enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease and flour a Bundt pan. Do not preheat the oven."
    },
    {
      "position": 2,
      "text": "Mix flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Cream sugar and butter in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Add vanilla. Add flour mixture alternately with milk; beat until smooth. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Place cake into the cold oven. Set the temperature to 350 degrees F (175 degrees C); bake until a toothpick inserted into the center comes out clean, 1 to 1 1/2 hours. Cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Let cool completely, 20 to 30 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,

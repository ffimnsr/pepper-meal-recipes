  "id": "662cd983-f185-5f32-8f1b-bd04fbba8a9c",
  "slug": "mini-ham-and-swiss-frittatas",
  "name": "Mini Ham and Swiss Frittatas",
  "recipe_type": "breakfast",
  "brief_description": "This quick and easy recipe has only five ingredients and makes delicious ham and cheese mini-frittatas.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Prepare 24-cup mini-muffin pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Toss cheese and ham together in a bowl; distribute evenly between the 24 prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Beat eggs, onion powder, garlic powder, and pepper together with a whisk in a bowl; pour in equal amounts over ham and cheese in muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until tops turn light golden brown, about 12 minutes. Remove frittatas form cups with a spoon."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

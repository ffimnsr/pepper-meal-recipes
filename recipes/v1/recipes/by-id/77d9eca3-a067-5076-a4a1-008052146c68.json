  "id": "77d9eca3-a067-5076-a4a1-008052146c68",
  "slug": "salted-caramel-spritz",
  "name": "Salted Caramel Spritz",
  "recipe_type": "dessert",
  "brief_description": "These salted caramel spritz cookies use simple ingredients and are quick and easy to prepare, making them perfect for holiday entertaining or gifting.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine caramels and half-and-half in a saucepan. Cook over low heat, stirring until caramels are melted, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat butter and brown sugar together in a bowl using an electric mixer until fluffy. Beat in egg and salt. Beat in fluid caramel sauce. Add flour; beat until combined."
    },
    {
      "position": 4,
      "text": "Fill a cookie press with the dough and press onto baking sheets, 1 to 2 inches apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "b9f38dc0-e795-5ec3-a8fd-512bde0e2301",
  "slug": "cheesy-shrimp-and-grits",
  "name": "Cheesy Shrimp and Grits",
  "recipe_type": "side",
  "brief_description": "This recipe for cheesy shrimp and grits is an easy, creamy, flavorful classic Southern dish loaded with gooey cheese, tender shrimp, and crispy bacon.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Cook grits until tender according to package directions. Off heat, stir in Cheddar cheese and butter; season with salt and black pepper. Cover and set aside."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels, leaving drippings in the skillet."
    },
    {
      "position": 3,
      "text": "Meanwhile, rinse shrimp; pat dry."
    },
    {
      "position": 4,
      "text": "Cook shrimp in drippings in the same skillet over medium heat until begin to turn opaque, about 2 minutes. Add bacon, scallions, parsley, lemon juice, and garlic; continue cooking until shrimp are bright pink, about 3 minutes more."
    },
    {
      "position": 5,
      "text": "Spoon grits into a serving bowl. Add shrimp mixture; mix well. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

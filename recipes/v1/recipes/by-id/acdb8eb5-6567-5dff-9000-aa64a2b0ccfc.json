  "id": "acdb8eb5-6567-5dff-9000-aa64a2b0ccfc",
  "slug": "berries-and-cream-smoothie",
  "name": "Berries and Cream Smoothie",
  "recipe_type": "dessert",
  "brief_description": "Sweet, thick, and a great alternative to dessert, this berries and cream smoothie is blended up in minutes to enjoy on-the-go.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour cream and half-and-half into an electric blender and blend on low speed until it begins to thicken. Add sugar and vanilla extract and mix for about 30 seconds. Add blueberries, strawberries, raspberries, and blackberries. Blend until smooth, adding milk if necessary to make blending easier."
    }
  ],
  "servings": 3,

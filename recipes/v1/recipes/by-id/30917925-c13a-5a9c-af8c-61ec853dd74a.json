  "id": "30917925-c13a-5a9c-af8c-61ec853dd74a",
  "slug": "apple-pie-filling",
  "name": "Apple Pie Filling",
  "recipe_type": "dessert",
  "brief_description": "This homemade apple pie filling recipe lets you stock up on your favorite apple in season and make extra filling to freeze and enjoy all year long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place apples in a bowl. Toss apples with lemon juice in a large bowl and set aside."
    },
    {
      "position": 3,
      "text": "Pour water into a Dutch oven over medium heat. Combine sugar, cornstarch, cinnamon, salt, and nutmeg in a bowl; add to water, stir well, and bring to a boil. Boil for 2 minutes, constantly stirring."
    },
    {
      "position": 4,
      "text": "Add apples and return to a boil. Reduce heat, cover, and simmer until apples are tender, 6 to 8 minutes. Cool for 30 minutes."
    },
    {
      "position": 5,
      "text": "Ladle into 5 freezer containers, leaving 1/2 inch of headspace. Cool at room temperature no longer than 1 1/2 hours. Seal and freeze. Can be stored for up to 12 months."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 40,

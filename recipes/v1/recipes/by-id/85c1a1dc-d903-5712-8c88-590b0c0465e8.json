  "id": "85c1a1dc-d903-5712-8c88-590b0c0465e8",
  "slug": "peanut-butter-quesadillas",
  "name": "Peanut Butter Quesadillas",
  "recipe_type": "snack",
  "brief_description": "What could be more simple than spreading peanut butter on a tortilla and heating it in the skillet with a little butter? Your children will love these great snacks.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Spread one side of tortilla with peanut butter; fold in half with peanut butter inside. Place in the skillet; heat until lightly browned, 2 minutes per side. Slice into wedges. Serve with jelly as a dipper."
    }
  ],

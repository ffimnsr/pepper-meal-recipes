  "id": "e2785400-e033-5002-9f54-b38f8c06ec19",
  "slug": "the-denver-omelet",
  "name": "The Denver Omelet",
  "recipe_type": "breakfast",
  "brief_description": "This Denver omelet is Chef John's version of beaten eggs firmly cooked and filled with green bell pepper, smoked ham, onions, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs in a small bowl until just combined; do not overbeat."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium-high heat. Add ham, onion, and bell pepper; season with salt and pepper. Cook and stir until onions soften and ham begins to caramelize, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium-low and pour in eggs. Mix briefly with a spatula while shaking the pan to ensure ingredients are evenly distributed."
    },
    {
      "position": 5,
      "text": "Quickly run the spatula along edges of omelet."
    },
    {
      "position": 6,
      "text": "Sprinkle Cheddar cheese and cayenne pepper over omelet."
    },
    {
      "position": 7,
      "text": "Cook, shaking the pan occasionally, until top is still wet but not runny, about 5 minutes. Use a spatula to fold omelet in half and transfer it to a plate."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

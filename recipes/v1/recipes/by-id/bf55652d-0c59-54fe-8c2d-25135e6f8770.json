  "id": "bf55652d-0c59-54fe-8c2d-25135e6f8770",
  "slug": "churros",
  "name": "Churros",
  "recipe_type": "appetizer",
  "brief_description": "Churros, sweet Mexican fritters rolled in cinnamon sugar, are easy to make at home. They're excellent served warm with chocolate sauce for dipping.",
  "cuisine": "U.S. Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water, 2 \u00bd tablespoons sugar, 2 tablespoons vegetable oil, and salt in a small saucepan over medium heat; bring to a boil then remove from heat."
    },
    {
      "position": 3,
      "text": "Stir in flour, stirring constantly, until mixture forms a ball."
    },
    {
      "position": 4,
      "text": "Heat 2 quarts oil in a deep fryer or deep pot to 375 degrees F (190 degrees C). Transfer dough to a sturdy pastry bag fitted with a medium star tip."
    },
    {
      "position": 5,
      "text": "Carefully pipe dough, working in batches of a few 5- to 6-inch strips at a time, into the hot oil."
    },
    {
      "position": 6,
      "text": "Cook until golden; transfer churros to paper towels to drain using a spider or slotted spoon."
    },
    {
      "position": 7,
      "text": "Combine \u00bd cup sugar and cinnamon in a bowl; roll churros in cinnamon and sugar mixture. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "name": "The Best Fresh Tomato Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This salsa recipe is easy to make with fresh tomatoes, chopped onion, jalape\u00f1os, cilantro, lime juice, and cumin for a sensational party dip.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir tomatoes, onion, green bell pepper, cilantro, lime juice, jalape\u00f1o pepper, cumin, salt, and pepper together in a bowl until just combined."
    },
    {
      "position": 3,
      "text": "Serve and enjoy!"
    }
  ],

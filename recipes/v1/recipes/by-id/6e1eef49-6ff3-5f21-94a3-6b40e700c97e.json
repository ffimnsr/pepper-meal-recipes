  "id": "6e1eef49-6ff3-5f21-94a3-6b40e700c97e",
  "slug": "salsa-verde-pork",
  "name": "Salsa Verde Pork",
  "recipe_type": "main",
  "brief_description": "This easy slow cooker recipe leads to succulent and delicious shredded pork loin in green salsa for enchiladas, tamales, or burritos.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in large Dutch oven over medium-high heat. Add pork loin; brown 2 to 3 minutes per side."
    },
    {
      "position": 2,
      "text": "Transfer pork to a slow cooker. Pour salsa over pork."
    },
    {
      "position": 3,
      "text": "Cover slow cooker. Cook on Low for 5 hours."
    },
    {
      "position": 4,
      "text": "Shred pork using two forks; stir with sauce to coat and combine. Continue cooking on Low for 1 to 3 hours more."
    }
  ],
  "servings": 6,

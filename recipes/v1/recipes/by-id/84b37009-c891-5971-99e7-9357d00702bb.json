  "id": "84b37009-c891-5971-99e7-9357d00702bb",
  "slug": "nectarine-cobbler-recipe-8698923",
  "name": "Nectarine Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This nectarine cobbler has a crunchy topping and a soft bottom crust that soaks up the delicious fresh nectarine juices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray an 8x8-inch baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Stir 2 cups sugar, flour, eggs, butter, and vanilla extract together in a bowl to make a smooth batter. Spread half of the batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust is golden brown, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, toss sliced nectarines with remaining 1/4 cup sugar. Spread fruit over base layer. Drop the remaining batter by spoonfuls evenly over fruit."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cobbler is golden, and fruit is bubbly, 28 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Optional: Heat an air fryer to 400 degrees F (200 degrees C). Place cobbler in the air fryer until topping is crunchy, about 5 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

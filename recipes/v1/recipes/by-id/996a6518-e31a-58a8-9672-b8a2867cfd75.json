  "id": "996a6518-e31a-58a8-9672-b8a2867cfd75",
  "slug": "broccoli-cheese-soup",
  "name": "Broccoli Cheese Soup",
  "recipe_type": "soup",
  "brief_description": "This broccoli cheese soup recipe makes an easy-to-prepare, creamy soup with lots of cheese, frozen broccoli, and chicken broth; everyone will love it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onion and cook, stirring occasionally, until soft; stir in broccoli."
    },
    {
      "position": 2,
      "text": "Add broth and simmer until broccoli is tender, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat; add cheese, and stir until melted. Stir in milk and garlic powder."
    },
    {
      "position": 4,
      "text": "Stir cornstarch and water together in a small bowl until smooth. Stir into soup; cook, stirring frequently, until thick."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "dd0e7c01-8c32-5518-a917-75ed58e2a488",
  "slug": "grilled-turkey-cuban-sandwiches",
  "name": "Grilled Turkey Cuban Sandwiches",
  "recipe_type": "main",
  "brief_description": "This grilled turkey Cuban panini-style sandwich recipe combines turkey breast, smoked ham, Swiss cheese, dill pickles, spices, and honey mustard.",
  "cuisine": "American Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat and lightly coat the cold grate with cooking spray. Arrange a drip pan on grill."
    },
    {
      "position": 2,
      "text": "Pat turkey dry with paper towels; discard gravy packet (or refrigerate and use within 2 to 3 days). Lift and shift string netting position for easier removal after cooking. Cut small slits, at least 1 inch apart, over entire surface of turkey. Insert 1 garlic slice into each slit; brush turkey with oil."
    },
    {
      "position": 3,
      "text": "Combine cumin, salt, and black pepper; sprinkle over turkey."
    },
    {
      "position": 4,
      "text": "Place turkey over drip pan on the preheated grill; grill, covered, until an instant-read thermometer inserted into the center reads 170 degrees F (77 degrees C), 1 \u00bc to 1 \u00be hours. Transfer to a cutting board; rest 10 minutes. Keep grill on."
    },
    {
      "position": 5,
      "text": "Remove string netting. Cut half of turkey into six \u215b-inch-thick slices; set aside. Refrigerate unsliced turkey for another use."
    },
    {
      "position": 6,
      "text": "Halve bread loaves, lengthwise, then, cut each into 3 pieces (for 6 sandwiches). Spread each bread bottom with 2 teaspoons mustard; top with sliced turkey, ham, Swiss cheese, pickles, and bread tops. Press sandwiches with hands to flatten; tightly wrap each in aluminum foil."
    },
    {
      "position": 7,
      "text": "Grill wrapped sandwiches, each weighted with a heavy iron-skillet or brick, until heated through, 3 to 5 minutes per side."
    },
    {
      "position": 8,
      "text": "Serve sandwiches warm, wrapped in aluminum foil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 10,

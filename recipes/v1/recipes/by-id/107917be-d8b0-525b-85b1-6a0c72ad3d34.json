{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "107917be-d8b0-525b-85b1-6a0c72ad3d34",
  "slug": "spinach-artichoke-chicken-casserole-recipe-11893633",
  "name": "Spinach Artichoke Chicken Casserole",
  "recipe_type": "dessert",
  "brief_description": "In this spinach artichoke chicken casserole, juicy chicken breasts are topped with a creamy, cheesy spinach-artichoke layer. Sweety drop peppers give a pop of color and tangy-sweet flavor. Baked until bubbly and golden, this is a delicious, effortless meal, perfect for busy nights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C), Lightly grease a baking dish."
    },
    {
      "position": 2,
      "text": "Season chicken breasts with Cantanzaro herbs, salt, and pepper. Arrange chicken in a single layer in the baking dish."
    },
    {
      "position": 3,
      "text": "Stir cream cheese, garlic, artichokes, spinach, Parmesan cheese, Cheddar cheese, and sweety drop peppers together in a bowl. Add 1 to 2 tablespoons bone broth only if mixture seems too thick. Spread topping mixture evenly over each chicken breast. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Remove foil, return pan to the oven, and bake until cheese is bubbly and lightly golden, chicken is no longer pink at the center, and juices run clear, 10 to 15 minutes more. An instant-read thermometer inserted near the center of chicken should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Optional: Preheat the oven\u2019s broiler, and broil until browned, 1 to 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

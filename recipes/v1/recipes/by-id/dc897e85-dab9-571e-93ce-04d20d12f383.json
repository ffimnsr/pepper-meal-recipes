  "id": "dc897e85-dab9-571e-93ce-04d20d12f383",
  "slug": "ultimate-sugar-cookies",
  "name": "Ultimate Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "This Crisco sugar cookie recipe can be made with pancake syrup instead of corn syrup if you wish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat sugar and shortening on medium speed with an electric mixer in a bowl until well blended. Add eggs, corn syrup, and vanilla; beat well. Combine flour, baking powder, baking soda, and salt in a separate bowl. Gradually add flour mixture to egg mixture on low speed until well blended."
    },
    {
      "position": 3,
      "text": "Wrap dough in plastic wrap and chill in the refrigerator for 1 hour."
    },
    {
      "position": 4,
      "text": "Roll out dough between 2 sheets of lightly floured wax paper. Cut out desired shapes with a floured cutter and place them on ungreased cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake cookies in the preheated oven until the centers are set, 6 to 10 minutes. Baking time will depend on the size and thickness of cookies; do not overbake. Cool briefly, then remove from the cookie sheets to cool to room temperature."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

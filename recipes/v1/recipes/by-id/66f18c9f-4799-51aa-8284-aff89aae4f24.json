  "id": "66f18c9f-4799-51aa-8284-aff89aae4f24",
  "slug": "rustic-blueberry-and-fig-crostata",
  "name": "Rustic Blueberry and Fig Crostata",
  "recipe_type": "dessert",
  "brief_description": "This rustic crostata pairs blueberries with figs and tarragon for an unexpected flavor combination that's fresh and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Roll pie crust out on a floured work surface to about 10 inches. Transfer to the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Combine blueberries, flour, sugar, tarragon, lemon zest and juice, and almond extract in a medium bowl. Mix well."
    },
    {
      "position": 4,
      "text": "Spoon blueberry mixture into the center of the pie crust, leaving about a 2-inch border. Place fig slices in the center in a circular pattern. Fold crust up all around the edge of the blueberries, crimping and pinching to create pleats."
    },
    {
      "position": 5,
      "text": "Whisk egg and water together in a small bowl. Brush edges of crust with mixture and sprinkle with turbinado sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crust is crispy and golden brown, about 20 minutes. Remove from the oven and set aside to cool and set, 15 to 30 minutes. Serve warm or at room temperature."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

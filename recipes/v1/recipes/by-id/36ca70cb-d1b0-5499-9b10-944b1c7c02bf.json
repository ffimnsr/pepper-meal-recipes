  "id": "36ca70cb-d1b0-5499-9b10-944b1c7c02bf",
  "slug": "slow-cooker-chicken-carnitas",
  "name": "Slow Cooker Chicken Carnitas",
  "recipe_type": "main",
  "brief_description": "These chicken carnitas are seasoned with Mexican spices and slow-cooked with onions and peppers in a juicy lime-orange sauce.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve chicken bouillon in boiling water."
    },
    {
      "position": 2,
      "text": "Heat oil in a saute pan over medium heat. Add onion; cook and stir until translucent and browned, about 5 minutes. Add jalapenos and cook until softened, about 5 minutes. Add green chiles; cook for 3 minutes more."
    },
    {
      "position": 3,
      "text": "Mix salt, cilantro, Mexican seasoning, cumin, basil, oregano, garlic powder, seasoning blend, chile powder, paprika, mustard powder, and black pepper together in a bowl."
    },
    {
      "position": 4,
      "text": "Trim chicken as needed. Coat all sides with the seasoning blend."
    },
    {
      "position": 5,
      "text": "Place onion mixture in a slow cooker. Add chicken broth, juice and zest from the limes and orange, and garlic cloves. Place chicken on top. Cover and cook on Low until chicken is no longer pink inside and very tender, 4 to 6 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 255,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "expert",

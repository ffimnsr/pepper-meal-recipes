  "id": "6b4249e9-7f70-5eb4-83f5-342cd3dc6ffd",
  "slug": "strawberry-raisin-rhubarb-pie",
  "name": "Strawberry Raisin Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This strawberry raisin rhubarb pie recipe uses raisins to add additional sweetness, texture, and depth of flavor to a classic strawberry-rhubarb pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine rhubarb, strawberries, sugar, raisins, flour, and ginger in a bowl; set filling aside for 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, roll out half the dough to fit a 9-inch pie plate; place into a 9-inch pie plate. Roll out remaining dough on a floured work surface into a 10-inch circle. Cut into \u00be-inch wide strips with a sharp knife or pastry wheel; set aside."
    },
    {
      "position": 4,
      "text": "Brush bottom crust with egg white; pour in filling and dot evenly with butter. Place pie on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Moisten the rim of the pie with a small amount of water. Start with the longest strips and lay the first 2 in an X in the center of the pie. Alternate horizontal and vertical strips, weaving them in an over-and-under pattern. Use the shortest strips for the edges of the lattice. Fold the ends of the lattice strips under the edge of the bottom crust and flute the crust."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 20 minutes. Reduce the oven temperature to 400 degrees F (205 degrees C); bake until golden, about 20 minutes more. Line crust edges with aluminum foil if they begin to brown too quickly."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

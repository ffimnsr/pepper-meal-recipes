  "id": "3c0028bf-14b3-56a9-97c3-a245bf771f73",
  "slug": "easy-rosemary-focaccia",
  "name": "Easy Rosemary Focaccia",
  "recipe_type": "main",
  "brief_description": "If you haven't tried your hand at yeast bread, this simple recipe for rosemary and olive oil focaccia bread is a good place to start.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 5 tablespoons warm water, yeast, and sugar in a large bowl. Let stand until creamy, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add flour and 1/4 teaspoon salt to the yeast mixture; stir well to combine. Stir in 1 tablespoon additional water at a time, if necessary, until all flour is absorbed and mixture has pulled together into a dough. Turn out onto a lightly floured surface and knead until springy, 4 to 6 minutes."
    },
    {
      "position": 3,
      "text": "Lightly oil a large bowl. Place dough in the bowl and turn to coat with oil. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 465 degrees F (240 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 5,
      "text": "Deflate dough and turn out onto a lightly floured surface. Knead briefly, then pat or roll dough into a sheet and transfer to the prepared baking sheet. Brush with remaining oil and make dimples across the surface with your fingertips. Sprinkle with rosemary leave and extra salt to taste."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven to desired crispness, about 10 minutes for light and fluffy or 20 minutes for crunchier and darker on the outside."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

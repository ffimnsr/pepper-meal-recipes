  "slug": "delicious-healthy-strawberry-shake",
  "name": "Delicious Strawberry Shake",
  "recipe_type": "drink",
  "brief_description": "This easy strawberry shake is a simply blend strawberries with milk, honey, and vanilla for a refreshing summer drink just like mom used to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, frozen strawberries, honey, and vanilla in a blender. Blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour into glasses and serve."
    }
  ],
  "servings": 2,

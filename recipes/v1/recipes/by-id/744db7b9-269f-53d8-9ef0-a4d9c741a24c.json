  "id": "744db7b9-269f-53d8-9ef0-a4d9c741a24c",
  "slug": "potato-leek-latkes",
  "name": "Potato Leek Latkes",
  "recipe_type": "dessert",
  "brief_description": "Flaxseed meal, not flour, acts as the binder in these quick and easy gluten-free potato and leek latkes with a golden Parmesan cheese crust.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine potatoes and leek in a food processor; process until mashed. Add eggs, flaxseed meal, and salt; pulse until incorporated."
    },
    {
      "position": 3,
      "text": "Spoon potato mixture onto the lined baking sheet. Flatten gently into 3-inch circles. Sprinkle Parmesan cheese on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until Parmesan cheese is melted and golden brown, about 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

  "id": "39a4114c-5e6c-5cc2-99d1-f1813523f518",
  "slug": "pumpkin-spice-rice-krispie-treats-recipe-8387013",
  "name": "Pumpkin Spice Rice Krispie Treats",
  "recipe_type": "dessert",
  "brief_description": "These pumpkin spice Rice Krispies treats combine pumpkin puree and pumpkin pie spices into a treat for those who can't get enough pumpkin each fall!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking pan or casserole dish with butter or cooking spray."
    },
    {
      "position": 2,
      "text": "Add butter and pumpkin puree to a large pot set over medium heat. Stir well and add vanilla, cinnamon, ginger, cloves, and salt. Once the mixture is heated through and homogenous, add marshmallows. Stir constantly, still over medium heat, until marshmallows have melted, about 5 minutes. Remove from heat; cool for 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Pour in cereal and mix well. This will require some elbow grease to get all of the cereal evenly coated in the pumpkin-marshmallow mixture!"
    },
    {
      "position": 4,
      "text": "Pour mixture into the prepared pan and use a spatula to flatten and spread out evenly. Place in the freezer until cool to the touch, 15 to 30 minutes."
    },
    {
      "position": 5,
      "text": "To slice and serve, run a knife along the sides of the pan and invert onto a cutting board. Using a large chef's knife, cut treats into bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

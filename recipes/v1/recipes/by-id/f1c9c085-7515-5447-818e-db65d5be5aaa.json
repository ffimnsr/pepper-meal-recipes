{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f1c9c085-7515-5447-818e-db65d5be5aaa",
  "slug": "spicy-miso-soup-with-roasted-shiitake-mushrooms-and-green-beans",
  "name": "Spicy Miso Soup with Roasted Shiitake Mushrooms and Green Beans",
  "recipe_type": "soup",
  "brief_description": "A vegetarian miso broth flavored with sesame oil, chili pepper and rice vinegar poured over rice noodles, roasted shiitake mushrooms and green beans from Dan Seidman of The Chef Dan.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F and line a baking sheet with Reynolds\u00ae Parchment Paper. Place mushrooms on baking sheet and drizzle with half the olive oil and half the salt. Set aside momentarily."
    },
    {
      "position": 2,
      "text": "Center green beans on a sheet of Reynolds Wrap\u00ae Aluminum Foil and drizzle with remaining olive oil and salt. Fold over edges of foil to create a packet. Ensure it is tightly sealed."
    },
    {
      "position": 3,
      "text": "Place the mushrooms and the foil pack of green beans in the oven and roast for 10 minutes, stirring the mushrooms halfway through."
    },
    {
      "position": 4,
      "text": "Heat vegetable broth to a low simmer in a medium pot. Pour in the soy sauce, sesame oil, and rice vinegar. Add the whole Thai chili to simmering broth (this will be removed later)."
    },
    {
      "position": 5,
      "text": "Whisk the miso paste with hot water in small bowl until smooth then add to the broth. Continue to simmer for an additional 10 minutes."
    },
    {
      "position": 6,
      "text": "Cook noodles according to package directions while the broth is simmering. When the noodles are done, evenly divide them into two serving bowls."
    },
    {
      "position": 7,
      "text": "Bring a small pot of water to a boil and carefully drop in the egg to cook for 6 minutes. Remove from water and peel."
    },
    {
      "position": 8,
      "text": "Divide the mushrooms and green beans between the two bowls and then pour the broth evenly between the bowls."
    },
    {
      "position": 9,
      "text": "Slice the egg in half and place 1 half in each bowl. Garnish with sliced green onion."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

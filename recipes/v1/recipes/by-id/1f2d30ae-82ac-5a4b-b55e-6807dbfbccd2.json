  "id": "1f2d30ae-82ac-5a4b-b55e-6807dbfbccd2",
  "slug": "paneer-tikka-masala",
  "name": "Paneer Tikka Masala",
  "recipe_type": "main",
  "brief_description": "This paneer tikka masala has chunks of paneer cheese cooked in butter with onions and peppers in a creamy, perfectly spicy tomato curry sauce.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Add paneer cubes; cook and stir until golden, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add onions, bell pepper, jalape\u00f1os, ground cashews, garlic paste, ginger paste, cayenne pepper, cumin, coriander, and garam masala; cook and stir until well combined and fragrant, about 1 minute."
    },
    {
      "position": 4,
      "text": "Mix tomato sauce, half-and-half, and salt into paneer mixture; simmer until thickened, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

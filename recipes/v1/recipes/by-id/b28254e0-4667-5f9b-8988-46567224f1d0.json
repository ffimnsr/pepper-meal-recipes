  "id": "b28254e0-4667-5f9b-8988-46567224f1d0",
  "slug": "crispiest-buttermilk-fried-chicken",
  "name": "Crispiest Buttermilk Fried Chicken",
  "recipe_type": "side",
  "brief_description": "This is the crispiest fried chicken that you will prepare. It features a buttermilk and flour-based cayenne coating, deep fried to crispy perfection, perfect for picnics.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cold water and kosher salt together in a large bowl until salt dissolves. Add chicken legs. Cover entire bowl with plastic wrap and refrigerate for 2 hours."
    },
    {
      "position": 2,
      "text": "Remove bowl from the refrigerator; drain and pat chicken dry with paper towels."
    },
    {
      "position": 3,
      "text": "Place chicken legs in a plastic bag with 1 cup all-purpose flour and shake to coat."
    },
    {
      "position": 4,
      "text": "Pour buttermilk into a bowl. Mix remaining flour, baking powder, salt, and cayenne in another bowl. Dip each chicken leg in buttermilk; move to flour mixture and coat well."
    },
    {
      "position": 5,
      "text": "Heat canola oil in a deep-fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Fry chicken legs in hot oil in batches until no longer pink at the bone and the juices run clear, about 15 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

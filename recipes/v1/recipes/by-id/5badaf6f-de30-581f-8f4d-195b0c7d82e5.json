  "id": "5badaf6f-de30-581f-8f4d-195b0c7d82e5",
  "slug": "corn-relish-iii",
  "name": "Corn Relish III",
  "recipe_type": "side",
  "brief_description": "Corn relish is not difficult to make, and is always a colorful end of summer treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large saucepan, mix corn, cabbage, onion, green bell pepper, red bell pepper, white sugar, ground dry mustard, celery seed, mustard seed, salt, turmeric, apple cider vinegar and water. Bring to a boil. Reduce heat and simmer 20 minutes."
    },
    {
      "position": 2,
      "text": "Transfer the mixture to sterile containers. Seal and chill in the refrigerator until serving."
    }
  ],
  "servings": 128,
  "cooking_time_minutes": 40,

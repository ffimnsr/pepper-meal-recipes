  "id": "7d6a9950-4024-5d78-b211-9e3384886ceb",
  "slug": "italian-almond-macaroons",
  "name": "Italian Almond Macaroons",
  "recipe_type": "dessert",
  "brief_description": "Tinted chewy cookies made with almond paste and topped with chopped nuts.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line cookie sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "In a medium bowl, stir together the almond paste, egg whites and lemon extract until smooth. Sift together the white sugar and confectioners' sugar, then combine sugars with the flour and salt. Stir the dry ingredients into the egg mixture along with the food coloring of your choice. Drop by teaspoonfuls, two inches apart, onto the prepared cookie sheets. Sprinkle some nuts on top of each cookie."
    },
    {
      "position": 3,
      "text": "Bake for 25 to 30 minutes in the preheated oven, until cookies are golden around the edges. Cool for a few minutes on baking sheets before removing to wire racks to cool completely. Store or freeze in an airtight container."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

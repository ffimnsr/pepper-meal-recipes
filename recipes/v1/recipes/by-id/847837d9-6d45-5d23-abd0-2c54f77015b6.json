  "id": "847837d9-6d45-5d23-abd0-2c54f77015b6",
  "slug": "pineapple-margarita",
  "name": "Pineapple Margarita",
  "recipe_type": "drink",
  "brief_description": "This pineapple margarita with silver tequila, triple sec, pineapple juice, and fresh lime juice makes a refreshing cocktail with a tropical twist!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker half-full with ice. Add pineapple juice, tequila, triple sec, and lime juice to the shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds."
    },
    {
      "position": 2,
      "text": "Sprinkle salt onto a plate. Moisten the rim of a glass with a lime wedge. Press the moistened rim into the salt. Fill glass with ice."
    },
    {
      "position": 3,
      "text": "Strain margarita into the glass and garnish with pineapple and lime wedge, if desired."
    }
  ],
  "servings": 1,

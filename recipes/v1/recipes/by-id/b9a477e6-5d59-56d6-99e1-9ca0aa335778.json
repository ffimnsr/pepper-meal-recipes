  "id": "b9a477e6-5d59-56d6-99e1-9ca0aa335778",
  "slug": "humpty-dumpty-dip-recipe-11899438",
  "name": "Humpty Dumpty Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Humpty Dumpty dip is a tasty twist to turn traditional deviled egg flavor into a creamy dip. It\u2019s much simpler than making deviled eggs, but you\u2019ll still have their delicious and comforting flavors. Serve with fresh veggies, crackers, pretzels, bagel chips, or crostini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine hard boiled eggs, cream cheese, mayonnaise, vinegar, mustard, garlic powder, Sriracha, salt, and pepper in a food processor. Pulse or blend until you get a smooth consistency, about 30 to 45 seconds."
    },
    {
      "position": 2,
      "text": "Taste, and if necessary, adjust seasonings to suit your taste. Spoon the dip into a bowl, garnish with chives and a sprinkle of paprika. Store in an airtight container in the fridge."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

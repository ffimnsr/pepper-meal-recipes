  "id": "e0b061be-5e71-5408-9bd7-a911ab48de16",
  "slug": "buffalo-pretzel-snack-mix-recipe-8426433",
  "name": "Buffalo Pretzel Snack Mix",
  "recipe_type": "appetizer",
  "brief_description": "This buffalo pretzel snack mix is perfect for a game day treat, movie night, tailgating, or just when you need a snack attack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line 2 baking sheets with parchment paper for easy cleanup, and set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine Rice Chex\u2122, Honey Nut Chex\u2122, pretzels, Cheddar crackers, and peanuts."
    },
    {
      "position": 3,
      "text": "Stir butter, Buffalo sauce, ranch mix, and garlic powder together in a bowl. Pour over the snack mix and stir until everything is well coated. Spread mixture in a single layer on the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crisped and golden, about 1 hour, stirring halfway through. Remove from the oven, sprinkle with sea salt flakes, and cool completely before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

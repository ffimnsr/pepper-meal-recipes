  "id": "3c48db54-1582-5787-a34d-4fb1c6304346",
  "slug": "authentic-chicken-madras",
  "name": "Chicken Madras",
  "recipe_type": "main",
  "brief_description": "Chicken madras is a flavorful and fragrant classic Indian curry. It's rich and hearty yet simple to make in under one hour with just one pan.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large nonstick pan over medium heat. Add cloves and cardamom pods and wait until they sizzle, about 1 minute. Add onions and saut\u00e9 until dark brown, 7 to 10 minutes. Add chile peppers, garlic, and ginger; cook and stir until fragrant, about 30 seconds. Add ground chili pepper, turmeric, cumin, coriander, and salt. Cook, stirring frequently, until blended in, about 1 minute more."
    },
    {
      "position": 2,
      "text": "Stir in chicken and water; cook, stirring constantly, until water is incorporated, 2 to 3 minutes. Stir in tomato puree and nutmeg. Cover and cook until chicken is no longer pink in the center and the juices run clear, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Ladle into bowls and sprinkle garam masala over top. Garnish with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

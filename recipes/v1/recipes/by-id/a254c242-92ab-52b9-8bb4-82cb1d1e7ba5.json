  "id": "a254c242-92ab-52b9-8bb4-82cb1d1e7ba5",
  "slug": "garlic-quinoa",
  "name": "Garlic Quinoa",
  "recipe_type": "side",
  "brief_description": "This quinoa is simmered with fresh garlic, chicken stock, and butter for an easy 4-ingredient side dish for steak, fish, chicken, veggies \u2014 you name it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over medium heat. Cook and stir garlic in melted butter until just browned, about 5 minutes. Pour chicken broth into the saucepan; add quinoa and stir. Bring to a boil, reduce heat to low, cover, and simmer until liquid is absorbed, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Remove the saucepan from heat and let sit for 5 minutes before fluffing quinoa with a fork."
    }
  ],

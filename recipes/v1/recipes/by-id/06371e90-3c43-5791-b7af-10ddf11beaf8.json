  "slug": "sweet-and-peppery-watermelon-salad",
  "name": "Sweet and Peppery Watermelon Salad",
  "recipe_type": "salad",
  "brief_description": "People will want your recipe for this unique summer salad mixing sweet watermelon and strawberries with peppery arugula and aromatic basil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gently combine arugula, strawberries, watermelon, basil, and red onion in a large bowl."
    },
    {
      "position": 2,
      "text": "Mix olive oil, balsamic vinegar, agave nectar, salt, and pepper together until dressing is uniform. Pour over salad; top with feta cheese."
    }
  ],

  "id": "b32026e7-0f84-587a-9f3a-6734a0598c9f",
  "slug": "cocoa-rum-balls",
  "name": "Rum Balls",
  "recipe_type": "dessert",
  "brief_description": "These rum balls are easy to make with wafer cookies, cocoa, rum, and nuts for bite-size chocolaty holiday treats, perfect for gift-giving to grownups!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine vanilla wafers, nuts, 3/4 cup confectioners' sugar, and cocoa in a large bowl."
    },
    {
      "position": 3,
      "text": "Mix in rum and corn syrup until well combined."
    },
    {
      "position": 4,
      "text": "Shape dough into 1-inch balls; roll in confectioners' sugar to coat."
    },
    {
      "position": 5,
      "text": "Store rum balls in an airtight container for 2 to 3 days to develop flavor. Roll them again in confectioners' sugar before serving."
    }
  ],
  "servings": 24,

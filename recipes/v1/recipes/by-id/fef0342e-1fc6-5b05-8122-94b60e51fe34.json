  "id": "fef0342e-1fc6-5b05-8122-94b60e51fe34",
  "slug": "chef-johns-granola",
  "name": "Chef John's Granola",
  "recipe_type": "breakfast",
  "brief_description": "Try this granola recipe for maple-flavored granola with nuts, seeds, and dried fruit. It makes a great snack or breakfast treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a baking sheet with a silicone liner."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, maple syrup, oil, and salt in a bowl. Add oats, almonds, pumpkin seeds, and coconut. Mix well until all ingredients are evenly coated."
    },
    {
      "position": 3,
      "text": "Pour mixture onto the prepared baking sheet and distribute in an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, lightly stirring every 10 to 15 minutes with the tines of a fork, until evenly toasted and golden brown, about 1 hour."
    },
    {
      "position": 5,
      "text": "Remove from the oven. Transfer hot granola into a large bowl and mix in currants. Let cool to room temperature, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

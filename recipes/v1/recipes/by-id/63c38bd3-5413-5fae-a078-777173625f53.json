  "id": "63c38bd3-5413-5fae-a078-777173625f53",
  "slug": "blueberry-or-cherry-dessert",
  "name": "Blueberry or Cherry Cheesecake Dessert",
  "recipe_type": "dessert",
  "brief_description": "If you have to feed a crowd, and they happen to love cheesecake, then this is the recipe for you. It bakes up in a large 9x13-inch pan and is easy to make. Cherry pie filling may be substituted for blueberry, or use both!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Melt butter in a medium bowl. Stir in 1 cup sugar and graham cracker crumbs until well combined. Press evenly into the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat eggs in a large bowl. Beat in cream cheese, the remaining 1 cup sugar, and vanilla until smooth. Spread the mixture evenly over the crust."
    },
    {
      "position": 3,
      "text": "Bake until the filling is just set in the center, 15 to 20 minutes. Cool completely."
    },
    {
      "position": 4,
      "text": "Spread blueberry or cherry pie filling evenly over the cooled cheesecake layer. Spread whipped topping over the pie filling. Refrigerate until thoroughly chilled before serving."
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

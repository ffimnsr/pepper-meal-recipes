  "schema_version": 1,
  "id": "93ed120a-cd17-51f4-b8e8-444a01c4ee89",
  "slug": "chilean-style-sopaipillas",
  "name": "Chilean-Style Sopaipillas",
  "recipe_type": "appetizer",
  "brief_description": "Give sopaipillas some Chilean flavor using zapallo squash that gets rolled into the dough. Cut into circles and fry to perfection.",
  "cuisine": "Chilean",
  "instructions": [
    {
      "position": 1,
      "text": "Peel, seed, and cut zapallo into chunks. Place in a saucepan, cover with water, and bring to a boil over medium-high heat. Cook until zapallo is soft and easily pierced with a fork, 15 to 20 minutes. Drain and allow to cool slightly."
    },
    {
      "position": 2,
      "text": "Mix flour, baking soda, and salt together in a mixing bowl, and set aside. Stir together squash and melted butter. Stir the flour mixture into the butter mixture until blended. Turn the dough out onto a lightly floured surface and knead until soft and satiny, adding a little more flour if necessary. Cover dough with a towel and allow to rest 15 minutes."
    },
    {
      "position": 3,
      "text": "Roll out the dough to 1/8-inch thick, and cut into 3-inch diameter circles. Poke each circle a few times with a fork to make holes and prevent rising."
    },
    {
      "position": 4,
      "text": "Pour oil into a large, deep skillet and heat over medium-high heat until hot, 385 degrees F (195 degrees C). Place several of the dough circles into hot oil; cook until lightly browned, 3 to 4 minutes. Drain on paper towels. Cook remainder of dough circles in batches."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 15,
  "difficulty": "medium",

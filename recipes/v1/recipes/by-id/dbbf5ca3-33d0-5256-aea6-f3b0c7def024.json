  "schema_version": 1,
  "id": "dbbf5ca3-33d0-5256-aea6-f3b0c7def024",
  "slug": "rock-salt-roast-prime-rib",
  "name": "Rock Salt Roast Prime Rib",
  "recipe_type": "side",
  "brief_description": "A very juicy rock salt prime rib that bakes inside a shell of salt and mustard. It is accompanied by a creamy horseradish sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a roasting pan with aluminum foil."
    },
    {
      "position": 2,
      "text": "Liberally coat roast with mustard so that it is entirely covered. Put a thick layer of rock salt on the foil in the roasting pan, about the size of the bottom of roast. Set roast on salt and press down to embed salt into mustard. Completely cover roast with rock salt, pressing it into mustard. (A lot of salt will fall off into the pan, but that doesn\u2019t hurt anything)."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, in the preheated oven until internal temperature reaches 145 degrees F (65 degrees C), about 1 hour. Let stand for 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, whip cream in a mixing bowl until stiff peaks form. Fold in horseradish to taste."
    },
    {
      "position": 5,
      "text": "The roast will be encased in a shell of salt. Hit the shell sharply with the back of a knife; it will crack open and start to fall off. Remove the shell."
    },
    {
      "position": 6,
      "text": "Place roast on a cutting board. Slice and serve with horseradish sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

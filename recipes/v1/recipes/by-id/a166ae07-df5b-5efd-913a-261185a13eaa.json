  "id": "a166ae07-df5b-5efd-913a-261185a13eaa",
  "slug": "copycat-fancy-nancy-chicken-salad-recipe-12020989",
  "name": "Copycat Fancy Nancy Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This Copycat Fancy Nancy Chicken Salad brings the Chicken Salad Chick favorite home with its signature creamy, sweet, fruity, and crunchy combination. Made with red grapes, Fuji apple, and pecans, it\u2019s great on a croissant or over lettuce.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayonnaise, Dijon, vinegar, agave, garlic powder, dill, parsley, and onion powder in a bowl. Mix well and refrigerate while preparing the salad. If dressing looks too thick, thin it out with milk, 1 teaspoon at a time."
    },
    {
      "position": 2,
      "text": "Chop chicken until finely diced (or pulse in a food proccessor), measuring out 2 cups, set aside. Rinse and dry grapes and then slice in half. Lightly toast pecans in a skillet over medium heat. Allow to cool and roughly chop."
    },
    {
      "position": 3,
      "text": "Fold chicken, diced apple, grapes, and pecans into the dressing. Serve on croissants or on lettuce leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

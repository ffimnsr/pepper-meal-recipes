  "id": "49eed518-b2fc-52ca-9a2e-da2277832d0a",
  "slug": "skillet-cherry-cobbler-gluten-free",
  "name": "Skillet Cherry Cobbler (Gluten-Free)",
  "recipe_type": "dessert",
  "brief_description": "Sweet cherries are seasoned with a touch of citrus in this delicious skillet cobbler that's both gluten-free and vegan, making it an easy choice for a special Valentine's Day dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cherries, sugar, orange juice, orange zest, and salt for base in a stockpot over low heat; cook and stir for 10 minutes. Transfer to a 10-inch cast iron skillet."
    },
    {
      "position": 3,
      "text": "Stir together flour, sugar, almond milk, melted butter, baking powder, and salt for topping in a bowl until well mixed. Scoop over the cherries in the skillet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is slightly browned, 35 to 45 minutes. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

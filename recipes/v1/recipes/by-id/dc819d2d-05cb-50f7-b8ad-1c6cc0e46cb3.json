  "id": "dc819d2d-05cb-50f7-b8ad-1c6cc0e46cb3",
  "slug": "pioneer-cut-dumplings-from-the-1800s",
  "name": "Pioneer Cut Dumplings from the 1800's",
  "recipe_type": "side",
  "brief_description": "With just four ingredients, pioneers made both dumplings and noodles. This original recipe continues to be passed down through generations in our family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour and salt together in a medium bowl. Whisk milk and egg together in a separate bowl. Add milk-egg mixture to flour and mix until it forms a dough."
    },
    {
      "position": 2,
      "text": "Knead on a lightly floured surface until smooth. Roll out to desired thickness for dumplings or roll thinner for noodles. Cut into strips, squares, or any shape you like. Let dry while you prepare broth or soup."
    },
    {
      "position": 3,
      "text": "Drop dumplings into boiling broth, and cook until tender. Timing will depend on the thickness of dumplings and how dry they are."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

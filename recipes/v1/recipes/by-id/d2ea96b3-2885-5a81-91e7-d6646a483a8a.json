{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d2ea96b3-2885-5a81-91e7-d6646a483a8a",
  "slug": "homemade-sweet-italian-sausage-mild-or-hot",
  "name": "Homemade Sweet Italian Sausage (Mild or Hot)",
  "recipe_type": "dessert",
  "brief_description": "An Italian sausage recipe you can tweak to taste. Just start with ground pork (or other meats) and add your own herbs and spices. So easy, so versatile!",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place pork and red wine vinegar in a large mixing bowl. Sprinkle with parsley, garlic powder, onion powder, basil, salt, black pepper, paprika, red pepper flakes, fennel seed, brown sugar, oregano, and thyme."
    },
    {
      "position": 3,
      "text": "Knead until flecks of spice are evenly distributed throughout meat."
    },
    {
      "position": 4,
      "text": "Divide sausage into thirds. Form each into a 3-inch diameter log, wrap securely in plastic wrap, and place in a zip-top bag. Refrigerate for at least 12 hours before cooking."
    },
    {
      "position": 5,
      "text": "When ready to cook, remove logs from the zip-top bags and place on a cutting board. Use a finely serrated knife to cut logs right through the plastic wrapping into 1/4- to 1/2-inch-thick patties. Carefully remove and discard any plastic."
    },
    {
      "position": 6,
      "text": "Heat a large skillet over medium heat. Working in batches, cook sausage patties in the hot skillet until no longer pink in the center, 2 to 6 minutes per side, depending on thickness. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6b67fc7c-ef08-565f-bfde-a7a50ba4d563",
  "slug": "air-fryer-banana-peppers-recipe-11967461",
  "name": "Air Fryer Banana Peppers",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer banana pepper rings are crispy on the outside, tangy on the inside, and deliver all the appeal of fried jalape\u00f1os without too much heat. They make a great sandwich topper or an easy appetizer served with ranch dressing for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, garlic powder, paprika, and pepper in a large resealable plastic bag. Seal and shake to combine."
    },
    {
      "position": 2,
      "text": "Add drained banana peppers to the bag in batches, shaking to coat in between."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C) for 5 minutes. Spray basket with nonstick cooking spray."
    },
    {
      "position": 4,
      "text": "Place flour-coated pepper rings in a single layer in the basket of the air fryer (this may need to be done in batches). Spray tops with nonstick cooking spray."
    },
    {
      "position": 5,
      "text": "Cook for 4 minutes. Shake basket and cook for 4 minutes more."
    },
    {
      "position": 6,
      "text": "Using tongs, transfer pepper slices to a serving plate. Serve with ranch or creamy Italian dressing for dipping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

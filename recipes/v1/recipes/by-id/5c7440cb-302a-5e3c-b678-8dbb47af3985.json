  "id": "5c7440cb-302a-5e3c-b678-8dbb47af3985",
  "slug": "german-marble-cake",
  "name": "German Marble Cake",
  "recipe_type": "dessert",
  "brief_description": "This is a lovely cake with the taste of almond and chocolate and it is almost like a pound cake.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 10 inch tube pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream the butter with the sugar. Beat in the eggs, then the milk and almond extract."
    },
    {
      "position": 3,
      "text": "In another bowl, stir together the flour, baking powder and salt. Beat the flour mixture into the creamed mixture. Turn half of the batter into another bowl and stir in the cocoa and rum."
    },
    {
      "position": 4,
      "text": "Layer the light and dark batters by large spoonfuls and then swirl slightly with a knife."
    },
    {
      "position": 5,
      "text": "Bake the cake in at 350 degree F (175 degree C) for about 70 minutes, or until it tests done with a toothpick. Transfer to a rack to cool. Makes about 14 to 16 servings."
    }
  ],
  "servings": 14,

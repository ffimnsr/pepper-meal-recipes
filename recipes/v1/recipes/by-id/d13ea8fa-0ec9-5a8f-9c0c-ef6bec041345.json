  "id": "d13ea8fa-0ec9-5a8f-9c0c-ef6bec041345",
  "slug": "quick-and-easy-home-fries",
  "name": "Quick and Easy Home Fries",
  "recipe_type": "breakfast",
  "brief_description": "These crispy home fries are super easy to make and simply seasoned; perfect for a family-pleasing hearty breakfast or brunch with your favorite eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse potato cubes with cold water and drain well."
    },
    {
      "position": 3,
      "text": "Melt butter in a large skillet over medium heat. Place potatoes in the skillet and season with salt and pepper; mix well. Cover and cook for 10 minutes."
    },
    {
      "position": 4,
      "text": "Remove the lid and cook, turning frequently, until brown and crisp on all sides, about 10 more minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

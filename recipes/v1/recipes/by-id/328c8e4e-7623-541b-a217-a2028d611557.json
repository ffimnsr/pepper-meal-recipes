  "id": "328c8e4e-7623-541b-a217-a2028d611557",
  "slug": "jajangmyeon-vegetarian-korean-black-bean-noodles",
  "name": "Jajangmyeon (Vegetarian Korean Black Bean Noodles)",
  "recipe_type": "main",
  "brief_description": "Black bean noodles are found in the refrigerated sections of Korean and Asian markets and are the main ingredient for the Korean dish jajangmyeon.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a wok over medium heat. Add garlic, carrot, and potato. Stir and add salt and pepper. Cook until softened, 5 to 7 minutes. Add zucchini and onion; stir."
    },
    {
      "position": 2,
      "text": "Combine cornstarch and water together in a bowl until fully mixed."
    },
    {
      "position": 3,
      "text": "Add water, black bean paste, and sugar to the wok and stir. Add starch mixture to wok slowly while stirring; cook until sauce thickens, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook noodles in boiling water, stirring occasionally, until noodles are tender yet firm to the bite, about 3 minutes. Drain."
    },
    {
      "position": 5,
      "text": "Serve noodles in a large pasta bowl and add black bean mixture on top. Mix well."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "cheese-ball",
  "name": "Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "In this variation on a classic appetizer, two bricks of cream cheese are transformed into a slightly sweet spread for crackers by the addition of pineapple, green pepper and spices.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix together the cream cheese, pineapple, onion, bell pepper and seasoning salt."
    },
    {
      "position": 2,
      "text": "Form into a ball and roll in chopped pecans. Chill and serve with butter crackers."
    }
  ],
  "servings": 20,

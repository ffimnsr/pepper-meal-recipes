  "id": "82a539d2-1ac0-57fb-964e-d8e8c47210f6",
  "slug": "chilled-lo-mein-noodles-with-szechuan-peppercorns-recipe-8741115",
  "name": "Chilled Lo Mein Noodles with Szechuan Peppercorns",
  "recipe_type": "salad",
  "brief_description": "Traditional lo mein noodles are fresh noodles made from wheat flour, egg, and water. This kicky salad uses pantry-friendly dried noodles, which are thinner and a little less chewy.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare noodles according to package directions. Drain; rinse with cold water until cool. Drain well. Use kitchen shears to cut noodles into smaller pieces."
    },
    {
      "position": 2,
      "text": "For vinaigrette, whisk together oil, vinegar, soy sauce, sugar, jalape\u00f1o, garlic, and peppercorns in a small bowl until sugar dissolves."
    },
    {
      "position": 3,
      "text": "In a serving bowl, toss noodles with vinaigrette until well coated. Top with peanuts, green onions, and cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

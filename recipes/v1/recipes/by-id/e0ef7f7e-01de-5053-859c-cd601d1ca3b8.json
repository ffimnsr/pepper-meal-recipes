  "id": "e0ef7f7e-01de-5053-859c-cd601d1ca3b8",
  "slug": "roasted-butternut-squash-and-fennel-soup-with-citrus",
  "name": "Roasted Butternut Squash and Fennel Soup with Citrus",
  "recipe_type": "appetizer",
  "brief_description": "This butternut squash and fennel soup with citrus recipe is the perfect starter for your holiday feast, blending a mix of spices, marmalade, and cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a large rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butternut squash, fennel, onion, and garlic on the prepared baking sheet; drizzle with oil and salt and toss to coat."
    },
    {
      "position": 3,
      "text": "Roast vegetables in the preheated oven until soft and lightly browned, 35 to 40 minutes."
    },
    {
      "position": 4,
      "text": "Combine \u00bd roasted vegetables and \u00bd broth in a blender; blend until smooth. Transfer pur\u00e9ed mixture to a large saucepan set over low heat. Combine remaining \u00bd each vegetables and broth in the blender; blend until smooth. Transfer pur\u00e9ed mixture to the saucepan."
    },
    {
      "position": 5,
      "text": "Stir marmalade and pumpkin pie spice into pur\u00e9ed mixture until heated through. Stir in cream before serving; season with salt and black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

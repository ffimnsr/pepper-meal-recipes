  "id": "4745c6d4-ed4b-50f1-a7c2-8037f2b4d539",
  "slug": "cream-cheese-filled-bagel-balls",
  "name": "Cream Cheese-Filled Bagel Balls",
  "recipe_type": "breakfast",
  "brief_description": "Perfect for breakfast and super easy and quick to make, these cream cheese-filled bagel balls are made with a yogurt-based dough that requires no rising time.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a baking pan."
    },
    {
      "position": 2,
      "text": "Mix 1 cup flour, baking powder, and 1/2 teaspoon salt together. Mix in Greek yogurt and knead until all flour is mixed in; if dough is sticky, add more flour."
    },
    {
      "position": 3,
      "text": "Cut dough into 8 equal pieces. Roll each piece into a ball and press each ball into a flat circle; they should look like mini pizzas."
    },
    {
      "position": 4,
      "text": "Scoop cream cheese into the center of each circle. Fold the edges up and pinch closed so you have a round ball of dough with cream cheese inside. Make sure you seal the edges so the cream cheese doesn't spill out during baking. Place seam side down on the prepared baking pan."
    },
    {
      "position": 5,
      "text": "Mix egg, half-and-half, and a pinch of salt in a small bowl. Brush egg wash on top of each dough ball and sprinkle with bagel seasoning."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 10 minutes. Remove from the oven and brush with melted butter before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d0fba5ca-d810-5e8a-bf67-f48f1c496136",
  "slug": "sweet-potato-pie-from-eagle-brand",
  "name": "Sweet Potato Pie from Eagle Brand",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pie with condensed milk is so easy that even first-time bakers can master it! It has a rich texture and a delicate blend of spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sweet potatoes into a large pot and cover with salted water; bring to a boil. Reduce the heat to medium-low and simmer until tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "While the potatoes are cooking, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Drain potatoes and place into a large mixing bowl. Add butter and beat with an electric mixer until smooth. Mix in condensed milk, eggs, orange zest, vanilla, cinnamon, nutmeg, and salt until smooth; pour into pie shell."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the surface is firm except for a small spot in the center that will jiggle when the pan is gently shaken, about 40 minutes. Let cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,

  "id": "1a58e933-573e-5000-b20b-0a5decfe29fd",
  "slug": "justin-rowlands-philly-cheesesteak-egg-rolls-recipe-8762569",
  "name": "Justin Rowland's Philly Cheesesteak Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "This twist on the Philly classic is made with shaved ribeye, American cheese, and chopped onions. Everything is wrapped up in a large egg roll wrapper before being fried to perfection!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a large skillet over medium heat. Add olive oil and onions and let cook for 4 to 6 minutes, stirring every 2 minutes."
    },
    {
      "position": 2,
      "text": "Once onions are a little crisp, add shaved ribeye meat. Stir in garlic and season with salt and pepper. Continue to cook until steak is fully cooked, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer meat mixture to a large mixing bowl."
    },
    {
      "position": 4,
      "text": "Place an egg roll wrapper on a clear work surface like a diamond and add a slice of cheese. Wet corners with the eggs."
    },
    {
      "position": 5,
      "text": "Fold bottom corner over the filling, fold 2 sides inwards, and roll up tightly."
    },
    {
      "position": 6,
      "text": "Heat oil in a large Dutch oven to 350 degrees F (180 degrees C). Check temperature with a deep fry thermometer."
    },
    {
      "position": 7,
      "text": "Working in batches, add 2 to 3 egg rolls at a time to the hot oil, making sure to not overcrowd the pot. Fry until golden brown, 2 to 5 minutes per side. Transfer to a paper towel lined plate to drain."
    },
    {
      "position": 8,
      "text": "Meanwhile, stir together ketchup and mayonnaise in a bowl for the dipping sauce."
    },
    {
      "position": 9,
      "text": "Slice egg rolls diagonally on a cutting board and serve with the dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

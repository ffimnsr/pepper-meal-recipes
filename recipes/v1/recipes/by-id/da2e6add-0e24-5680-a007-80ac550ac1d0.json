  "id": "da2e6add-0e24-5680-a007-80ac550ac1d0",
  "slug": "muffin-pan-frittatas",
  "name": "Muffin Pan Frittatas",
  "recipe_type": "appetizer",
  "brief_description": "These muffin tin miniature frittatas are loaded with veggies and cheese; perfect for an individual on-the-go breakfast or crowd-pleasing brunch dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 12 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a skillet over medium heat. Add asparagus, green bell pepper, and onion; cook and stir until vegetables are softened, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Whisk eggs, milk, salt, and black pepper together in a bowl. Stir cooked vegetables and Cheddar cheese into egg mixture; spoon about 1/4 cup of mixture into each muffin cup."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until frittatas are set in the middle and lightly browned, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

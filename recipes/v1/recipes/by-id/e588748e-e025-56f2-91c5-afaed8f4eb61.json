  "id": "e588748e-e025-56f2-91c5-afaed8f4eb61",
  "slug": "chocolate-chip-pancakes-recipe-8641191",
  "name": "Chocolate Chip Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy chocolate chip pancakes are chock full of warm gooey chocolate in every bite for the best homemade breakfast treat ever!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the buttermilk: Combine milk and vinegar in a bowl and set aside for 5 minutes to sour the milk."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, baking powder, baking soda, and salt in a large mixing bowl."
    },
    {
      "position": 3,
      "text": "Whisk egg, butter, and vanilla extract into buttermilk mixture until well combined; add flour mixture and whisk until just combined. Fold in chocolate chips. The pancake batter will be thick. Allow batter to rest for 5 minutes."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium-low heat, and coat with cooking spray."
    },
    {
      "position": 5,
      "text": "Pour about \u00bc cup of batter for each pancake onto the skillet. Cook until bubbles appear on the surface, 2 to 4 minutes. Flip pancake with a spatula, and cook until browned on the other side, 2 to 3 more minutes. Repeat with remaining batter. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,
  "difficulty": "easy",

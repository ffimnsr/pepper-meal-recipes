  "name": "Original Bar Cheese Spread",
  "recipe_type": "appetizer",
  "brief_description": "Prepared horseradish, processed cheese spread, Worcestershire sauce, garlic powder, and dry mustard work together to make a snack dip with an interesting bite.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cheese spread, horseradish, Worcestershire sauce, dry mustard, and garlic powder in a mixing bowl."
    },
    {
      "position": 2,
      "text": "Refrigerate 8 hours to overnight."
    }
  ],

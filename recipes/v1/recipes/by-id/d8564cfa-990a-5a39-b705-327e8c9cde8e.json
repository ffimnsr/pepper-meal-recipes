  "id": "d8564cfa-990a-5a39-b705-327e8c9cde8e",
  "slug": "fiesta-chicken-burritos",
  "name": "Fiesta Chicken Burritos",
  "recipe_type": "main",
  "brief_description": "This chicken burrito recipe is for saucy, spicy chicken burritos that are easy to assemble and quick to bake.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Add chicken and cook until no longer pink inside, about 8 minutes. Season with salt and pepper, then transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Add 1 cup shredded cheese, bell pepper, sour cream, olives, salsa, jalape\u00f1o, and cilantro to the chicken; stir to combine."
    },
    {
      "position": 4,
      "text": "Place 1/4 of the chicken mixture onto a tortilla. Fold and roll tortilla to completely enclose filling, then place it, seam-side down, in a small baking dish. Repeat to fill and roll remaining tortillas. Sprinkle the remaining cheese over top."
    },
    {
      "position": 5,
      "text": "Bake in center of the preheated oven until cheese is melted and tortillas are crispy, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "aa29ce6f-63d1-5592-b5fe-db005c648a80",
  "slug": "sticky-monkey-brains",
  "name": "Sticky Monkey Brains",
  "recipe_type": "breakfast",
  "brief_description": "This gooey cinnamon pull apart recipe will impress everyone in your family! It is an easy (and I mean EASY), fast, and tasty modification of my boyfriend's grandmother's monkey brain recipe. I use 6 small Bundt pans instead of one big one so the cinnamon balls are more gooey :) Fun to make and even more fun to eat!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 6 miniature Bundt pans."
    },
    {
      "position": 2,
      "text": "In a small bowl, stir together the white sugar and cinnamon. Set aside. Use scissors or a knife to cut each of the biscuits into various sizes. Each one can be cut into anywhere from 2 to 5 pieces."
    },
    {
      "position": 3,
      "text": "Sprinkle about half of the pecans amongst the 6 prepared pans. Roll pieces of biscuit in the cinnamon-sugar, and place them into the pans, distributing evenly. Sprinkle any remaining cinnamon-sugar over the dough balls."
    },
    {
      "position": 4,
      "text": "Mix together the brown sugar and melted butter. Stir in the remaining pecans. Distribute evenly over the pans of dough balls. For ease of getting in and out of the oven, place all of the pans on a cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake for 20 minutes in the preheated oven, or until the biscuits are toasted and cooked through. Remove from the oven, and invert individual pans onto serving plates while still hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "610da2b9-67be-5b27-921d-b7d4e70e754d",
  "slug": "natashas-chicken-burgers",
  "name": "Natasha\u2019s Chicken Burgers",
  "recipe_type": "main",
  "brief_description": "A chicken burger that\u2019s easy to make with ground chicken, seasoned bread crumbs, grated onion, and garlic. Juicy, delicious, and ready in 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ground chicken, onion, \u00bc cup bread crumbs, egg, and garlic in a bowl; season with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Moisten hands; shape chicken mixture into 4 flat, oval-shaped patties."
    },
    {
      "position": 4,
      "text": "Spread remaining \u00bc cup bread crumbs in a shallow dish; dip patties in bread crumbs to coat."
    },
    {
      "position": 5,
      "text": "Heat olive oil in a large skillet over medium-high heat."
    },
    {
      "position": 6,
      "text": "Add patties; cook until golden and well browned on the bottoms, 5 to 6 minutes."
    },
    {
      "position": 7,
      "text": "Flip patties; cook until other sides are browned, 3 to 4 minutes more. Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

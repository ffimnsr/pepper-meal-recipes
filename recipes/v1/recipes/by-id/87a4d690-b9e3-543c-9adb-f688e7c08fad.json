  "id": "87a4d690-b9e3-543c-9adb-f688e7c08fad",
  "slug": "mall-pretzels",
  "name": "Mall Pretzels",
  "recipe_type": "appetizer",
  "brief_description": "Those big, soft pretzels rolled in coarse salt are yours to bake at home with basic bread ingredients you probably already have in your pantry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast, brown sugar, and salt in 1 \u00bd cups warm water in a large bowl. Stir in flour; knead dough on a lightly floured surface until smooth and elastic, about 8 minutes. Place dough in a greased bowl and turn to coat the dough. Cover and let rise until doubled in size, about 1 hour."
    },
    {
      "position": 2,
      "text": "Combine 2 cups warm water and baking soda in an 8 inch square pan. Line 6 baking sheets with parchment paper."
    },
    {
      "position": 3,
      "text": "After dough has risen, cut into 12 pieces. Roll each piece into a 3-foot rope, pencil thin or thinner. Twist into a pretzel shape, and dip into the baking soda solution. Place onto parchment covered baking sheets, and let rise 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 8 to 10 minutes, or until golden brown. Brush with melted butter, and sprinkle with coarse salt, garlic salt or cinnamon sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

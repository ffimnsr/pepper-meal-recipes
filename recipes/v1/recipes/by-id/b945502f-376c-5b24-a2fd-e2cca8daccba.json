  "id": "b945502f-376c-5b24-a2fd-e2cca8daccba",
  "slug": "oven-fried-chicken-ii",
  "name": "Oven-Fried Chicken",
  "recipe_type": "side",
  "brief_description": "This savory oven-fried chicken is easier and less messy to make than frying; the chicken still gets crispy on top but stays tender and juicy inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place flour in a shallow plate or bowl and season with salt and pepper to taste. Put bread crumbs in another shallow plate or bowl and beat eggs in another bowl."
    },
    {
      "position": 3,
      "text": "Dredge chicken piece by piece in the flour, then the egg, then the bread crumbs, until all pieces are coated."
    },
    {
      "position": 4,
      "text": "Pour oil into a large baking dish; add the breaded chicken thighs and sprinkle with paprika to taste."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes, then turn pieces over and bake for another 30 minutes. Remove from the oven and drain on paper towels."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

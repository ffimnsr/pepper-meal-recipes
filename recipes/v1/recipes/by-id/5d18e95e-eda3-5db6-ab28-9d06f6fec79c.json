  "id": "5d18e95e-eda3-5db6-ab28-9d06f6fec79c",
  "slug": "lentil-soup",
  "name": "Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This lentil soup made with dried lentils is full of flavor thanks to hearty greens, tomatoes, and herbs for a hearty and comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large soup pot over medium heat. Add onions, carrots, and celery; cook and stir until onion is tender, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in garlic, bay leaf, oregano, and basil; cook for 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir in lentils, and add water and tomatoes. Bring to a boil. Reduce heat and let simmer until lentils are tender, about 40 minutes."
    },
    {
      "position": 5,
      "text": "When ready to serve, stir in spinach and cook until it wilts."
    },
    {
      "position": 6,
      "text": "Stir in vinegar and season with salt and pepper; taste and adjust as needed."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

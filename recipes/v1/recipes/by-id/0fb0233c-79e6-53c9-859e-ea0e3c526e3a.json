  "id": "0fb0233c-79e6-53c9-859e-ea0e3c526e3a",
  "slug": "scottish-shortbread-ii",
  "name": "Simple Scottish Shortbread",
  "recipe_type": "dessert",
  "brief_description": "Light and very buttery, like traditional Walkers shortbread. The recipe does not make a large batch, but it's simple enough to make a few batches. The recipe does not double well.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Blend flour, sugar, and butter until well combined; dough will be stiff. Press into the prepared dish and prick the top all over with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pale golden brown on the edges, 20 to 25 minutes. Cool completely before cutting into squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

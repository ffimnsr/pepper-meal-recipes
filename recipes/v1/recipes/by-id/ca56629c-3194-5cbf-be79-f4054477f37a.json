  "id": "ca56629c-3194-5cbf-be79-f4054477f37a",
  "slug": "joes-hummus-with-pine-nuts",
  "name": "Joe's Hummus with Pine Nuts",
  "recipe_type": "appetizer",
  "brief_description": "This toasted pinenut hummus is made with plenty of lemon juice and garlic, with just a hint of tahini for richness.",
  "cuisine": "Mediterranean Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a small skillet over medium heat. Toast pine nuts in a skillet, frequently stirring, until fragrant and beginning to brown, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Blend chickpeas, reserved liquid, lemon juice, 1/4 cup olive oil, tahini, garlic, cumin, paprika, salt, and crushed peppercorns in a food processor until smooth."
    },
    {
      "position": 3,
      "text": "Stir toasted pine nuts into the hummus or sprinkle on top. Drizzle a little olive oil on top before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

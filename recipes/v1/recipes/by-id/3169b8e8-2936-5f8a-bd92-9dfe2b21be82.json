  "id": "3169b8e8-2936-5f8a-bd92-9dfe2b21be82",
  "slug": "peach-and-blueberry-feta-salad-recipe-8674131",
  "name": "Peach and Blueberry Feta Salad",
  "recipe_type": "salad",
  "brief_description": "This peach and blueberry feta salad, with sweet fresh peaches, tart blueberries, and creamy, savory feta, tossed with a peach and basil vinaigrette is the BEST summer salad ever!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put chopped romaine, 2 peaches, cucumbers, and blueberries to a large bowl. Toss well, add feta on top, and set aside."
    },
    {
      "position": 2,
      "text": "Add remaining peach, olive oil, shallot, lemon juice, basil, and agave to a food processor. Blend well, taste, and adjust if needed."
    },
    {
      "position": 3,
      "text": "Drizzle dressing over salad and mix to combine."
    }
  ],
  "servings": 4,

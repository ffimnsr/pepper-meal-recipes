  "id": "507ea113-b0eb-53a1-a358-c96dcc42783a",
  "slug": "sheet-pan-sausage-egg-sandwiches-recipe-11924418",
  "name": "Sheet Pan Sausage Egg Sandwiches",
  "recipe_type": "breakfast",
  "brief_description": "Start your morning the easy way with these sheet pan sausage egg sandwiches. They are perfect for meal prep or busy mornings, freeze well and are a great grab-and-go breakfast sandwich that you can customize to your taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 10x15-inch rimmed baking sheet."
    },
    {
      "position": 2,
      "text": "Whisk eggs, milk, salt, and pepper together in a large bowl until well combined. Pour egg mixture into the prepared baking sheet, spreading evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until eggs are mostly set, 12 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Arrange sausage patties evenly over the eggs in a 3x4 pattern. Sprinkle cheese evenly over the top."
    },
    {
      "position": 5,
      "text": "Return baking sheet to the oven and bake until eggs are fully set and cheese is melted, 6 to 8 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool slightly. Cut eggs into 12 even squares."
    },
    {
      "position": 7,
      "text": "Assemble sandwiches by placing one egg-and-sausage square on each toasted English muffin. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "12f97b53-0216-5f8f-82ed-844b0315c3b3",
  "slug": "spanish-rice-and-shrimp",
  "name": "Spanish Rice and Shrimp",
  "recipe_type": "main",
  "brief_description": "This easy Spanish rice and shrimp recipe is a quick and delicious alternative to traditional paella and makes a great weeknight family meal.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a saucepan. Add rice mix and 1 tablespoon olive oil. Boil for 1 minute; cover and reduce heat. Simmer until water is absorbed, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Heat remaining olive oil in a skillet over medium-high heat. Add onion and saute until just soft, about 2 minutes. Add shrimp, green bell pepper, red bell pepper, and seafood seasoning. Cook, stirring occasionally, until shrimp are bright pink, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Mound rice on each plate; top with a portion of the pepper-shrimp mixture and a generous sprinkling of parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 38,
  "preparation_time_minutes": 25,

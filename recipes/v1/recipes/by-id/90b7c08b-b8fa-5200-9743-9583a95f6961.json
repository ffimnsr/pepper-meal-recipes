  "id": "90b7c08b-b8fa-5200-9743-9583a95f6961",
  "slug": "roasted-cinnamon-spice-pumpkin-seeds",
  "name": "Roasted Cinnamon Spice Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This roasted cinnamon spice pumpkin seeds recipe is a fall favorite. Season with cinnamon, sugar, and ginger for a treat the entire family will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, pumpkin seeds, and salt in a pot; bring to a boil. Reduce heat to low; simmer until seeds are tender, about 10 minutes. Strain seeds; pat dry with a towel."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a baking sheet with olive oil."
    },
    {
      "position": 3,
      "text": "Spread pumpkin seeds onto the prepared baking sheet in a single layer; evenly sprinkle with sugar, cinnamon, and ginger."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, stirring every 10 minutes, until seeds are fragrant and roasted, about 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

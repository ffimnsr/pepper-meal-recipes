{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d3d2e725-b8d3-5f71-bba7-df6b6bc20f1e",
  "slug": "ham-and-gruyere-scones-recipe-8747672",
  "name": "Ham and Gruy\u00e8re Scones",
  "recipe_type": "salad",
  "brief_description": "These ham and Gruy\u00e8re scones, with tiny pieces of ham and nutty grated Gruy\u00e8re, are perfect for any time of day. Crunchy on the outside and tender on the inside, the savory scones are delicious with eggs in the morning, tasty with a bowl of soup or a salad at lunch, and delightful in the evening as a dinner bread.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, sugar, baking powder, and salt in a large mixing bowl. Use a pastry cutter to cut butter into flour mixture until it resembles rice or coarse meal. Stir in ham and Gruy\u00e8re until evenly mixed."
    },
    {
      "position": 2,
      "text": "Moisten flour mixture with cream, until dough begins to come together. Add a bit more cream, milk, or water if dough seems dry."
    },
    {
      "position": 3,
      "text": "Turn out on a floured work surface and fold dough onto itself. Gently stretch dough, turning and folding 3 or 4 times. Lightly flour a rolling pin and roll dough out 1/2- to 3/4-inch thick, turning dough a quarter turn occasionally."
    },
    {
      "position": 4,
      "text": "Cut scones with a lightly floured 3-inch biscuit cutter; press cutter straight down, without twisting. Pat dough scraps together and cut as needed. Line a baking sheet with parchment; place cut scones on the sheet."
    },
    {
      "position": 5,
      "text": "Whisk egg, water, and pinch salt together in a small bowl. Brush tops of scones with egg wash, and refrigerate for about 20 minutes."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 450 degrees F (235 degrees C). Brush the top of the scones with the egg mixture again."
    },
    {
      "position": 7,
      "text": "Bake scones in the center of the preheated oven until tops are crispy and lightly browned, 15 to 20 minutes. Serve warm or at room temperature."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

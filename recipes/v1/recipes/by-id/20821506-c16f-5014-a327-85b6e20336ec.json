  "id": "20821506-c16f-5014-a327-85b6e20336ec",
  "slug": "bisquick-coffee-cake",
  "name": "Bisquick Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This Bisquick coffee cake features a moist, tender cake and a sweet, cinnamon-sugar topping. It's quick and easy \u2014 but nobody will know you used a mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Make the cake: Mix baking mix, milk, egg, sugar, and cinnamon together in a bowl until well combined; spread into the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Make the topping: Mix baking mix, brown sugar, butter, and cinnamon together in a separate bowl using a fork or pastry blender until crumbly. Sprinkle evenly over batter, then drag a butter knife across the top in a crisscross pattern."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 25 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

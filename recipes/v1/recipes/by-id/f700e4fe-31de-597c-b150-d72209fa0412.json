  "id": "f700e4fe-31de-597c-b150-d72209fa0412",
  "slug": "marry-me-tortellini-recipe-12020207",
  "name": "Marry Me Tortellini",
  "recipe_type": "main",
  "brief_description": "This Marry Me tortellini is an easy one-dish meal inspired by the viral Marry Me Chicken recipe. Cheese tortellini and meaty Baby Bella mushrooms simmer in a creamy, garlicky Parmesan sauce with sun-dried tomatoes for a rich and satisfying meatless dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon olive oil over medium heat in a large skillet or pot. Add mushrooms and red onion, and saute stirring occasionally until soft, 4 to 5 minutes. Remove from skillet."
    },
    {
      "position": 2,
      "text": "Heat remaining olive oil in the skillet, and add sun-dried tomatoes, flour, garlic, and Italian seasoning, stirring constantly until well combined, about 1 minute. Whisk in vegetable broth and tomato paste, and simmer until smooth and starting to thicken, 2 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Add tortellini, and stir until well coated. Cook according to package directions until tortellini is tender, being sure not to overcook. Stir in reserved mushrooms and onions; remove from heat."
    },
    {
      "position": 4,
      "text": "Add cream and Parmesan cheese, and stir until cheese is melted. Taste; season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Stir in basil, sprinkle with red pepper flakes and more Parmesan cheese, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

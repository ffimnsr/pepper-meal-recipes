{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "575b5c9c-8152-5c20-acf6-258ef6dfdee7",
  "slug": "dads-basic-moist-pork-roast",
  "name": "Dad's Basic Moist Pork Roast",
  "recipe_type": "main",
  "brief_description": "Make tender pork roast in the oven. Roasting a pork roast straight from the refrigerator allows for a flavorful crust while keeping the center juicy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine oil, pepper, and salt in a bowl; rub oil mixture over pork and refrigerate while the oven preheats. Preheat the oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 3,
      "text": "Place pork on a roasting rack set in a large roasting pan. Roast in the preheated oven for 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove pork from the oven and reduce the heat to 325 degrees F (165 degrees C). Insert an instant-read thermometer into the thickest part of the center. The temperature will range from 80 to 110 degrees F (27 to 43 degrees C)."
    },
    {
      "position": 5,
      "text": "Allow pork to rest uncovered at room temperature until the internal temperature reaches between 115 and 140 degrees F (46 and 60 degrees C), about 30 minutes."
    },
    {
      "position": 6,
      "text": "Return to oven and continue to cook until internal temperature reaches 145 degrees F (63 degrees C), 15 to 30 minutes more."
    },
    {
      "position": 7,
      "text": "Let the roast stand uncovered at room temperature for 15 to 20 minutes before slicing and serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

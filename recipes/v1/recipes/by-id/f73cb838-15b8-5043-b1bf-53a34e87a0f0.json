  "id": "f73cb838-15b8-5043-b1bf-53a34e87a0f0",
  "slug": "strawberry-cream-pie-to-die-for",
  "name": "Strawberry Cream Pie to Die For",
  "recipe_type": "dessert",
  "brief_description": "This strawberry and cream pie recipe combines fresh berries, whipped cream, and cream cheese to create a pretty dessert you'll be proud to serve guests.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together strawberries and glaze in a large bowl until evenly coated. Place in the refrigerator to chill."
    },
    {
      "position": 2,
      "text": "Meanwhile, stir together cream cheese, confectioners' sugar, vanilla, and cinnamon in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Beat heavy cream in a large bowl with an electric mixer just until it begins to thicken; add cream cheese mixture and continue beating until thick. Pour mixture into baked pie crust; top with strawberry mixture. Chill in the refrigerator before serving, at least 1 hour."
    }
  ],
  "servings": 8,

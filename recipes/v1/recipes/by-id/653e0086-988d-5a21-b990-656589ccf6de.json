  "id": "653e0086-988d-5a21-b990-656589ccf6de",
  "slug": "exquisite-pizza-sauce",
  "name": "Exquisite Pizza Sauce",
  "recipe_type": "side",
  "brief_description": "The best pizza sauces are homemade, just like this flavorful no-cook recipe made with tomato paste, garlic, Parmesan, anchovy paste, herbs, and spices.",
  "cuisine": "Italian Inspired American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place tomato paste, water, Parmesan cheese, honey, garlic, anchovy paste, onion powder, oregano, marjoram, basil, black pepper, cayenne pepper, red pepper flakes, and salt into a medium bowl; mix until well blended, breaking up any clumps of cheese."
    },
    {
      "position": 3,
      "text": "Set sauce aside for 30 minutes to allow the flavors to blend; spread over pizza dough and prepare pizza as desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

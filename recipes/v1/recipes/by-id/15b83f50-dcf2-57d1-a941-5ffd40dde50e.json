  "id": "15b83f50-dcf2-57d1-a941-5ffd40dde50e",
  "slug": "watermelon-sour-patch-vodka-slushies-recipe-11840582",
  "name": "Watermelon Sour Patch Vodka Slushies",
  "recipe_type": "appetizer",
  "brief_description": "These watermelon sour patch vodka slushies begin with soaking sour patch candy in vodka overnight. Blended with a few more ingredients, you'll have a delightful sweet-sour, pink, icy vodka cocktail that you can make one-by-one, or in a big batch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vodka into a 1-quart jar with a tight-fitting lid. Add sour patch candy, and soak candy in vodka overnight."
    },
    {
      "position": 2,
      "text": "For each cocktail, add 2 ounces lemonade, 1/2 ounce grenadine, 1/2 ounce simple syrup, 2 ounces infused vodka, and 2 tablespoons vodka-soaked candy."
    },
    {
      "position": 3,
      "text": "Add ice and blend until slushy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

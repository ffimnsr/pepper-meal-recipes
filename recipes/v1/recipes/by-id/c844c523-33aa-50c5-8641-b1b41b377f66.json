  "id": "c844c523-33aa-50c5-8641-b1b41b377f66",
  "slug": "coffee-panna-cotta-recipe-11724806",
  "name": "Coffee Panna Cotta",
  "recipe_type": "dessert",
  "brief_description": "This coffee panna cotta is a light, yet decadent dessert that's incredibly easy to make. If you really want to take it over the top, serve it topped with a dollop of mascarpone whipped cream and a sprinkle of chopped chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk heavy cream, coffee, brown sugar, espresso powder, salt, and vanilla together in a saucepan. Heat over medium-low heat, stirring often, until mixture is hot and sugar and espresso powder have dissolved, 5 to 7 minutes; do not boil."
    },
    {
      "position": 2,
      "text": "Meanwhile, place 1/2 cup whole milk in a small bowl. Sprinkle gelatin over the top and let sit for 5 minutes to allow gelatin to bloom."
    },
    {
      "position": 3,
      "text": "Remove the pan from the heat. Whisk in bloomed gelatin and stir until completely dissolved and incorporated."
    },
    {
      "position": 4,
      "text": "Place a fine mesh strainer over a large heat-safe measuring cup, or a large bowl, preferably with a pour spout. Carefully pour coffee mixture through the strainer."
    },
    {
      "position": 5,
      "text": "Pour strained coffee mixture into glass serving dishes or ramekins, and allow to cool to room temperature, about 30 minutes. Then place panna cottas into the fridge to chill until set, about 4 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

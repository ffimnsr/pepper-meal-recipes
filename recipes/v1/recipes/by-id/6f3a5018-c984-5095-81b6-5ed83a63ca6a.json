{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6f3a5018-c984-5095-81b6-5ed83a63ca6a",
  "slug": "grilled-chicken-burgers",
  "name": "Grilled Chicken Burgers",
  "recipe_type": "main",
  "brief_description": "These grilled chicken burgers are a nice change from ordinary beef hamburgers since they're made with ground chicken, vegetables, and seasonings.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly spray a skillet with cooking spray and heat over medium heat. Add onion and sauté until translucent, about 5 minutes. Add garlic and cook until fragrant, about 30 seconds. Add carrots, bell pepper, tomato, and mushrooms; cook and stir until tender, 5 to 7 minutes. Remove from the heat and let cool completely, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Mix ground chicken and cooled vegetables together in a large bowl. Add bread crumbs, egg, seafood seasoning, salt, and pepper; mix until well combined. Form mixture into eight patties."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill until no longer pink in the center and the juices run clear, 5 to 6 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f93261f8-787c-5776-9b42-c7bc8e60635e",
  "slug": "peanut-butter-microwave-fudge",
  "name": "Peanut Butter Microwave Fudge",
  "recipe_type": "dessert",
  "brief_description": "This 3-ingredient recipe for peanut butter microwave fudge with butter and confectioners' sugar is one to try. It's sweet, creamy, and simple to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking dish with parchment or waxed paper."
    },
    {
      "position": 2,
      "text": "Place peanut butter and butter in a microwave-safe bowl. Microwave at high power in 30-second intervals until melted and thoroughly combined, stirring after each interval. Cool mixture for 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in confectioners' sugar, \u00bd cup at a time, until well incorporated. Press mixture into the prepared dish; place in the refrigerator. Chill for at least 2 hours to overnight for a firmer fudge."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

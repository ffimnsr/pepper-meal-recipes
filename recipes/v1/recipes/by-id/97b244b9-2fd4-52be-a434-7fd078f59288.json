  "slug": "watermelon-feta-and-mint-salad-recipe-7511300",
  "name": "Celebrate Summer with Watermelon, Feta, and Mint Salad",
  "recipe_type": "salad",
  "brief_description": "This watermelon, feta, and mint salad is refreshing, loaded with sweet and salty flavors, and takes minutes to make. The quality of the olive oil and feta cheese is important, so go ahead and splurge a little.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the chilled watermelon cubes in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, lemon juice, lemon zest, kosher salt, and black pepper together in a small bowl."
    },
    {
      "position": 3,
      "text": "Just before serving, drizzle dressing over chilled watermelon, and toss gently. Sprinkle feta cheese and mint over the watermelon, but do not mix in. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

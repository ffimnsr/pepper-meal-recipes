  "id": "c0172c7c-a621-5a0f-bdb9-4c114312d824",
  "slug": "spinach-stuffed-portobello-mushrooms",
  "name": "Stuffed Portobello Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "This cheesy stuffed portobello mushroom recipe has a flavorful filling made of spinach, pepperoni, Parmesan, and mozzarella, topped with bread crumbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Brush both sides of portobello mushrooms with Italian dressing. Arrange mushroom on a baking sheet, gill-sides up."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender, about 12 minutes. Drain any juice that has accumulated in mushrooms."
    },
    {
      "position": 4,
      "text": "Beat egg, garlic, salt, and black pepper together in a large bowl."
    },
    {
      "position": 5,
      "text": "Stir spinach, pepperoni, Parmesan cheese, 3 tablespoons mozzarella cheese, and 3 tablespoons bread crumbs into eggs until evenly mixed."
    },
    {
      "position": 6,
      "text": "Divide spinach mixture over mushroom caps; sprinkle mushrooms with remaining 1 tablespoon mozzarella cheese and 1 tablespoon bread crumbs."
    },
    {
      "position": 7,
      "text": "Return mushrooms to the oven; bake until topping is golden brown and cheese is melted, about 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

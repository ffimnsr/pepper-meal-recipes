  "id": "13ccce4b-9e3a-5ad1-a1c3-66e9d7dccefe",
  "slug": "swedish-hard-tack",
  "name": "Swedish Hard Tack",
  "recipe_type": "appetizer",
  "brief_description": "These slightly sweet, biscuit-like crackers are easy to make and are great with butter, cheese, or jam.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift together flour, sugar, baking soda, and salt into a large bowl. Rub in butter until mixture appears sandy. Stir in buttermilk, a little at a time, until dough holds together."
    },
    {
      "position": 3,
      "text": "Transfer dough to a lightly floured surface and roll out to a 1/8-inch thickness. Cut into 4-inch squares; cut each square diagonally into triangles, then prick with a fork. Place on ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until dry and lightly browned, about 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

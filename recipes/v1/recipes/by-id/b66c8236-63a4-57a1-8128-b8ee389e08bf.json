  "id": "b66c8236-63a4-57a1-8128-b8ee389e08bf",
  "slug": "hot-chicken-wing-dip",
  "name": "Hot Chicken Wing Dip",
  "recipe_type": "appetizer",
  "brief_description": "This hot chicken wing dip recipe gives you the flavor of hot chicken wings dipped in ranch dressing and covered in cheese. Serve it with chips or crackers.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium heat. Add chicken breasts; cook until juices run clear, about 4 minutes per side. Transfer to a cutting board; cool completely. Shred into strands using a fork."
    },
    {
      "position": 3,
      "text": "Combine cream cheese, hot pepper sauce, and ranch dressing in a bowl until well blended. Add shredded chicken; mix well. Transfer mixture to a 9x13-inch baking dish; sprinkle Cheddar cheese over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is bubbling, about 10 minutes."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

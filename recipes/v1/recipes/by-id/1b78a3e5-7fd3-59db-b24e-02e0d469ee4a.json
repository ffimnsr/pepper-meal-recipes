  "id": "1b78a3e5-7fd3-59db-b24e-02e0d469ee4a",
  "slug": "grilled-asparagus",
  "name": "Grilled Asparagus",
  "recipe_type": "side",
  "brief_description": "Grilled asparagus is easy to make in a matter of minutes for a simple summer side dish that allows the natural flavor of asparagus to shine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Lightly coat the asparagus spears with olive oil. Season with salt and pepper to taste."
    },
    {
      "position": 4,
      "text": "Cook asparagus on the preheated grill, turning often until lightly charred and fork-tender about 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

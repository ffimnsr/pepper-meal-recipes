  "id": "cf4343e7-ba7f-58bf-baa3-45ad5e50a058",
  "slug": "chocolate-cherry-coconut-granola-bars",
  "name": "Chocolate-Cherry-Coconut Granola Bars",
  "recipe_type": "appetizer",
  "brief_description": "Perfect for breakfast or a power snack, these chewy, no-bake granola bars are packed with chocolate chips, cherries, almonds, coconut, oats, and peanut butter.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x13-inch baking pan with a piece of parchment paper that is large enough to go up all sides of the pan."
    },
    {
      "position": 2,
      "text": "Combine oats, rice cereal, coconut, almonds, and cherries in a large mixing bowl and set aside."
    },
    {
      "position": 3,
      "text": "Combine honey, peanut butter, brown sugar, coconut oil, vanilla extract, and salt in a small saucepan. Heat over medium heat until brown sugar is melted; continue to simmer for 1 minute more. Pour heated mixture into the dry ingredients and stir to fully combine. Stir in chocolate chips."
    },
    {
      "position": 4,
      "text": "Pour granola into the prepared baking pan and press firmly with a nonstick spatula or lightly oiled hands to tightly compact and distribute evenly throughout."
    },
    {
      "position": 5,
      "text": "Refrigerate for 2 hours."
    },
    {
      "position": 6,
      "text": "Remove from the refrigerator and slice into 20 equal portions. Tightly wrap individually in plastic wrap or serve immediately."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c4cf3760-98df-5ea6-bbc3-2b4d891e7fc5",
  "slug": "risotto-con-zafferano-e-pancetta-in-pentola-a-pressione-saffron-and-pancetta-risotto",
  "name": "Risotto con Zafferano e Pancetta in Pentola a Pressione (Saffron and Pancetta Risotto)",
  "recipe_type": "main",
  "brief_description": "Fragrant, flavorful saffron is the perfect ingredient in this simple, yet tasty risotto finished with pancetta, Parmesan cheese, and butter.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vegetable stock into a saucepan over low heat. Cover and keep warm."
    },
    {
      "position": 2,
      "text": "Combine hot water and saffron threads in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in a stovetop pressure cooker. Cook and stir onion until softened, 3 to 5 minutes. Add Arborio rice; cook and stir until toasted and coated with oil, 2 to 3 minutes. Increase heat and pour in wine; simmer until alcohol has evaporated and rice has absorbed wine, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir vegetable stock and saffron mixture into the pressure cooker. Seal according to manufacturer's instructions. Increase heat to high; cook until cooker whistles, about 5 minutes. Reduce heat to low and cook for 4 minutes."
    },
    {
      "position": 5,
      "text": "Remove cooker from heat and release pressure according to manufacturer's instructions. Remove the lid. Stir in 1/2 cup plus 2 tablespoons Parmesan cheese, pancetta, and butter. Let stand until rice absorbs remaining stock and Parmesan cheese melts, 2 to 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

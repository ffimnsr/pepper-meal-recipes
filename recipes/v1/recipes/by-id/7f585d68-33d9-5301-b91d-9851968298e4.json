  "slug": "jalapeno-pesto",
  "name": "Jalapeno Pesto",
  "recipe_type": "side",
  "brief_description": "Blend a jalapeno pepper with fresh basil, Parmigiano-Reggiano cheese, and walnuts for a spicy version of pesto.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Pulse walnuts and garlic in a food processor until finely chopped. Add basil, Parmigiano-Reggiano cheese, and jalapeno pepper; process until combined. Stream olive oil into basil mixture while food processor is still running until consistency is smooth. Season with salt and black pepper."
    }
  ],
  "servings": 14,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "44f2e319-9eaa-5df9-93f4-8e8edad58266",
  "slug": "coconut-cream-pie-tiramisu-recipe-11943118",
  "name": "Coconut Cream Pie Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This coconut cream pie tiramisu takes a favorite dessert on a tropical vacation. Toasted coconut, coconut milk, and spiced rum stand in for the traditional espresso and cocoa elements. Cold, creamy, and fluffy, it is simply delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place coconut flakes in a large skillet over medium-low heat. Cook, stirring constantly, until coconut flakes are toasted and golden brown, 5 to 7 minutes. Remove from heat, and pour coconut flakes into the cup of a high-speed blender; allow to cool for 15 minutes."
    },
    {
      "position": 2,
      "text": "Once coconut flakes have cooled, pulse them in the blender a few times to finely chop them. Measure out 1/2 cup flakes; set aside for topping."
    },
    {
      "position": 3,
      "text": "Add coconut milk, caramel sauce, vanilla, coconut extract, nutmeg, and salt to the rest of the coconut flakes in the blender cup. Blend on high speed until mixture is smooth and combined, 30 to 60 seconds. Pour out 1/2 cup of this coconut mixture, and set aside to use for dunking the ladyfingers. Pour remaining mixture into a large mixing bowl."
    },
    {
      "position": 4,
      "text": "Add mascarpone to the bowl, and use a hand mixer to beat on low speed until smooth and combined (mixture will still be quite liquid at this point). Add heavy cream and confectioner\u2019s sugar. Starting on low speed, and gradually increasing to medium-high, beat until mixture holds stiff peaks, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Whisk rum into reserved 1/2 cup coconut mixture until combined. Quickly dunk ladyfingers into rum mixture, 1 at a time, and layer evenly into the bottom of a glass 9x9-inch square baking dish. Repeat until the bottom of the pan is covered, breaking ladyfingers to fit as needed. Top with half of whipped coconut mixture, and spread into an even layer."
    },
    {
      "position": 6,
      "text": "Repeat dunking and layering with remaining ladyfingers; place them evenly over whipped coconut mixture. Pour remaining whipped coconut mixture over the top and spread into an even layer. The pan will be quite full. Sprinkle the top with toasted coconut."
    },
    {
      "position": 7,
      "text": "Loosely cover pan; refrigerate for at least 8 hours, preferably overnight. Cut into squares to serve. Store in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,

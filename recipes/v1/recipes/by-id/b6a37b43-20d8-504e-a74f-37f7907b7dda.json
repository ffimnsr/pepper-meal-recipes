  "id": "b6a37b43-20d8-504e-a74f-37f7907b7dda",
  "slug": "greek-lamb-and-orzo",
  "name": "Greek Lamb and Orzo",
  "recipe_type": "main",
  "brief_description": "Orzo pasta is simmered with tomatoes and browned lamb in this Greek-inspired dish.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large saucepan over medium-high heat. Cook and stir ground lamb in the hot pan until browned, crumbly, and no longer pink, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in tomatoes and their juice, celery, orzo, garlic, salt, and cayenne pepper. Bring to a boil; reduce heat to medium-low, cover, and simmer until orzo is tender and has absorbed liquid from tomatoes, about 12 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "b5713001-152d-5ccd-acf3-357203318e91",
  "slug": "brookes-best-bombshell-brownies",
  "name": "Brooke's Best Bombshell Brownies",
  "recipe_type": "dessert",
  "brief_description": "This brownie recipe uses cocoa powder, semi-sweet chocolate morsels, and butter, of course, to make an incredibly rich, fudgy, chocolaty treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine sugar, melted butter, and vanilla in a large bowl. Beat in eggs, one at a time, mixing well after each addition, until thoroughly blended."
    },
    {
      "position": 3,
      "text": "Sift flour, cocoa powder, and salt into a separate large bowl. Gradually stir flour mixture into egg mixture until blended; stir in chocolate chips."
    },
    {
      "position": 4,
      "text": "Spread batter evenly into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 35 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Let cool completely before slicing into 24 squares."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

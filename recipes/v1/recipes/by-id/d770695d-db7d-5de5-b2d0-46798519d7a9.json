  "slug": "savory-mushroom-soup",
  "name": "Savory Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "Dress up a can of cream of mushroom soup with red onion, frozen peas, and sour cream in this recipe which serves two.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In small saucepan saute onion in butter. Add soup, milk, and peas. Heat on medium-low until peas are soft. Add sour cream. Stir. When hot, serve. Add sour cream to thickness desired."
    }
  ],
  "servings": 2,

  "id": "1aac1e17-3d97-5009-b3cb-df88fa14663f",
  "slug": "stuffed-crescent-roll-carrots-recipe-8609705",
  "name": "Stuffed Crescent Roll Carrots",
  "recipe_type": "appetizer",
  "brief_description": "These stuffed crescent roll carrots are cute carrot-shaped crescent rolls, stuffed with a cream cheese and spinach filling. Or choose a favorite sweet or savory filling\u2014the possibilities are endless.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper and set aside. Roll sheets of foil into cone-shaped molds. Separate dough into 4 rectangular pieces. Press diagonal seams together. Using a pizza cutter, cut each rectangle in half lengthwise."
    },
    {
      "position": 2,
      "text": "Wrap 1 strip around bottom of foil mold, pinching together at the tip to seal. Wrap the 2nd strip around the mold, overlapping slightly, to create a carrot shape. Place on the prepared baking sheet, 1 inch apart."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 7 to 10 minutes. Cool completely before removing from foil molds."
    },
    {
      "position": 4,
      "text": "Beat cream cheese, spinach, garlic powder, and nutmeg until smooth. Season to taste with salt and pepper. Fill a piping bag with mixture and pipe evenly into the 4 carrots."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

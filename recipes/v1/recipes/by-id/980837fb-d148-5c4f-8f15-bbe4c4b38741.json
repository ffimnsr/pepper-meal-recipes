  "id": "980837fb-d148-5c4f-8f15-bbe4c4b38741",
  "slug": "parmesan-sesame-chicken",
  "name": "Parmesan Sesame Chicken",
  "recipe_type": null,
  "brief_description": "A yummy way to jazz up your everyday breaded chicken breasts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a bowl, mix the bread crumbs, Parmesan cheese, and sesame seeds. Place the egg in a separate bowl. Dip the chicken in the egg, then dip into the bread crumb mixture to coat. Place the chicken breasts in a shallow baking dish."
    },
    {
      "position": 3,
      "text": "Bake chicken 20 to 30 minutes in the preheated oven, until juices run clear."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

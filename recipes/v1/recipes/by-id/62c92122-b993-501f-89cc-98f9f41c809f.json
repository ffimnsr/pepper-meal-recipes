  "slug": "smashed-avocado-tostadas-recipe-11934136",
  "name": "Smashed Avocado Tostadas",
  "recipe_type": "main",
  "brief_description": "These smashed avocado tostadas are a great way to elevate avocados. Quick and easy to make, especially if you use store-bought tostadas.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Smear 1/2 of the smashed avocado on each tostada. Top with lettuce, onion, cilantro, and tomatoes. Sprinkle with lime juice. Top each with 1 tablespoon crema and avocado slices. Season with salt and pepper."
    }
  ],

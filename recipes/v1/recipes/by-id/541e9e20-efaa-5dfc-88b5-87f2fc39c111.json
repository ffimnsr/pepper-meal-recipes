  "id": "541e9e20-efaa-5dfc-88b5-87f2fc39c111",
  "slug": "burrito-casserole",
  "name": "Burrito Casserole",
  "recipe_type": "main",
  "brief_description": "This burrito casserole made with seasoned beef, refried beans, salsa, tortilla chips, and lots of cheese is sure to become a Tex-Mex family favorite.",
  "cuisine": "Tex Mex Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Coat a casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Cook and stir onion in hot oil until translucent, 3 to 5 minutes. Add beef and increase heat to medium-high. Cook and stir until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Mix together refried beans and burrito seasoning in a large bowl; add to beef mixture in the skillet and stir until well combined."
    },
    {
      "position": 4,
      "text": "Mix together condensed soup and sour cream in a medium bowl."
    },
    {
      "position": 5,
      "text": "Place a layer of tortilla chips into the prepared casserole dish to just cover the bottom, followed by 1/2 of the meat mixture, 1/2 of the soup mixture, 1 cup cheese, and 1/2 of the salsa. Repeat layers once more, then top with remaining cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, uncovered, until hot and bubbly, 20 to 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "28d276cf-7bc8-5d67-bee1-e05c77c0b43d",
  "slug": "artichoke-bruschetta",
  "name": "Artichoke Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "This is a great bruschetta recipe based on an artichoke dip. It's always a huge hit! Try adding spinach or tomatoes!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the broiler."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix marinated artichoke hearts, Romano cheese, red onion and mayonnaise. Top French baguette slices with equal amounts of the artichoke heart mixture. Arrange slices in a single layer on a large baking sheet."
    },
    {
      "position": 3,
      "text": "Broil in the preheated oven 2 minutes, or until toppings are bubbly and lightly browned."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 18,

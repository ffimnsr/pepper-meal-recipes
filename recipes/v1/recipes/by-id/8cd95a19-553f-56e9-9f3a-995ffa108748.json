  "id": "8cd95a19-553f-56e9-9f3a-995ffa108748",
  "slug": "rhubarb-sour-cream-pie",
  "name": "Old-Fashioned Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned rhubarb pie with a creamy, sweet-tart filling and buttery, crumbly topping is sure to be a hit when fresh rhubarb is in season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange pie crust in a 9-inch pie pan. Spread rhubarb in an even layer in the bottom of the crust."
    },
    {
      "position": 3,
      "text": "Whisk egg, white sugar, sour cream, and 1/3 cup of flour together in a medium bowl until smooth. Pour over rhubarb."
    },
    {
      "position": 4,
      "text": "Mix 1/2 cup of flour and brown sugar together in a small bowl; stir in melted butter until mixture is crumbly. Sprinkle over top of the pie."
    },
    {
      "position": 5,
      "text": "Bake for 15 minutes in the preheated oven, then reduce the heat to 350 degrees F (175 degrees C). Continue to bake until the edges have puffed, and the topping is golden, about 40 minutes. The center may still be slightly jiggly. Cool completely before slicing and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

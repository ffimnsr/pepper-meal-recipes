  "id": "c723d429-8a27-5798-9d44-d1f46e4ab442",
  "slug": "baked-turkey-tetrazzini",
  "name": "Baked Turkey Tetrazzini",
  "recipe_type": "main",
  "brief_description": "Combine leftover turkey with assorted veggies, noodles, and a creamy sauce to make this bubbly, rich, and scrumptious baked turkey tetrazzini recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Melt 3 tablespoons butter in a large skillet over medium heat. Add celery, onion, and mushrooms; cook until tender, 5 to 10 minutes. Sprinkle flour over celery mixture; stir to coat."
    },
    {
      "position": 3,
      "text": "Stir milk, cream cheese, Worcestershire sauce, salt, black pepper, and nutmeg into celery mixture; cook and stir until cream cheese melted and sauce is warmed through, 5 to 10 minutes. Stir in turkey and peas."
    },
    {
      "position": 4,
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil, stirring occasionally, until cooked through yet slightly firm, about 5 minutes. Drain. Stir noodles into turkey mixture; transfer to the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Place remaining 3 tablespoons butter in a microwave-safe bowl; microwave until melted. Cool. Stir Parmesan cheese and bread crumbs into melted butter until crumbly. Sprinkle over noodle mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top is browned and sauce is bubbling, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e3610197-2efe-5c00-bb96-b99848129913",
  "slug": "sandys-super-sugar-cookies",
  "name": "Sandy's Super Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "This recipe for buttery, rich, and delicate sugar cookies is sure to become an instant favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift flour, cream of tartar, baking soda, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Beat butter and white sugar together in a large bowl with an electric mixer until light and fluffy; beat in vanilla extract. Add eggs one at a time, beating well after each addition. Gradually add flour mixture to butter mixture on low speed until dough is just-combined."
    },
    {
      "position": 4,
      "text": "Divide dough into 4 portions; refrigerate 3 portions. Roll remaining portion out on a lightly-floured work surface to 1/4-inch thick. Use cookie cutters to cut dough into desired shapes and transfer cookies to prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until slightly golden at the edges, 10 to 12 minutes. Cool on the baking sheet for 5 minutes before transferring to a wire rack to cool completely. Repeat rolling, cutting, and baking process with remaining dough portions."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

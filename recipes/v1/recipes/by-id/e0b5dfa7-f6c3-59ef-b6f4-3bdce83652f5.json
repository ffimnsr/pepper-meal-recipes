  "id": "e0b5dfa7-f6c3-59ef-b6f4-3bdce83652f5",
  "slug": "coffee-gelato",
  "name": "Coffee Gelato",
  "recipe_type": "dessert",
  "brief_description": "This Italian-style coffee gelato is a blend of ground coffee, cream, milk, and sugar to make a sweet frozen treat for coffee lovers.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix milk, cream, and sugar together in a large bowl. Refrigerate to let sugar dissolve."
    },
    {
      "position": 2,
      "text": "Meanwhile, brew coffee grounds with water in a coffee maker or French press. Refrigerate coffee until completely cooled, at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Beat milk mixture using an electric mixture until slightly thickened to the consistency of buttermilk. Stir coffee into milk mixture."
    },
    {
      "position": 4,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer\u2019s instructions, 20 to 30 minutes. Serve or transfer to an airtight container and store in the freezer."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

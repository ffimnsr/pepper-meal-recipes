{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5fb067d6-92f7-5abb-af93-1056d98b5673",
  "slug": "awesome-egg-rolls",
  "name": "Awesome Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Tasty shrimp egg roll recipe featuring egg roll wrappers filled with shrimp, cabbage, carrots, and bean sprouts that are fried to a golden-brown finish.",
  "cuisine": "World Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix cabbage, bean sprouts, carrot, celery, and onion together in a large bowl."
    },
    {
      "position": 3,
      "text": "Stir in shrimp, soy sauce, garlic powder, and pepper."
    },
    {
      "position": 4,
      "text": "Heat 1 teaspoon oil in a nonstick skillet over medium heat. Add egg and cook, without stirring, until the bottom has set. Flip and cook until set on the other side, 1 to 2 minutes."
    },
    {
      "position": 5,
      "text": "Transfer to a cutting board and finely chop."
    },
    {
      "position": 6,
      "text": "Stir in chopped egg, then sprinkle 1 tablespoon cornstarch over top. Mix to combine and let sit for 10 minutes."
    },
    {
      "position": 7,
      "text": "Mix water and remaining 1 tablespoon cornstarch together in a small bowl."
    },
    {
      "position": 8,
      "text": "Place an egg roll wrapper onto a work surface with one corner pointing away from you like a diamond. Spoon 2 to 3 tablespoons shrimp mixture into the center. Moisten the top and side corners with the wet cornstarch mixture."
    },
    {
      "position": 9,
      "text": "Fold the dry bottom corner up and over the filling, making a tight tube."
    },
    {
      "position": 10,
      "text": "Fold the side corners in, pressing to stick against the folded roll, then roll toward the top corner to complete. Repeat to make remaining egg rolls."
    },
    {
      "position": 11,
      "text": "Heat 3 to 4 inches vegetable oil in a deep fryer to 350 degrees F (175 degrees C). Working in batches, carefully fry egg rolls in the preheated fryer until golden brown, 2 to 4 minutes. Drain on paper towels."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "dba5963a-5b08-5939-9ec9-8525a8d9feb7",
  "slug": "72-hour-sous-vide-short-ribs",
  "name": "72-Hour Sous Vide Short Ribs",
  "recipe_type": "main",
  "brief_description": "This recipe for short ribs uses the sous vide method of low-and-slow cooking to yield impossibly tender meat that is packed with flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat water in a sous vide water bath to 133 degrees F (56 degrees C)."
    },
    {
      "position": 2,
      "text": "Trim any areas of fat left on short ribs; coat thoroughly with garlic and salt. Place ribs into a large, resealable plastic bag. (Use two bags if necessary to leave plenty of room between ribs.) Seal, on low pressure if using a vacuum sealer, removing as much air as possible."
    },
    {
      "position": 3,
      "text": "Submerge the bag fully into the water bath and cook, rotating every 12 to 18 hours, for 60 hours. Increase the heat to 144.5 degrees F (62.5 degrees C) and cook an additional 12 hours."
    },
    {
      "position": 4,
      "text": "Remove ribs from the water bath; let rest in the bag on a cooling rack placed over a baking sheet until cool enough to handle."
    },
    {
      "position": 5,
      "text": "Remove ribs from the bag and drain. Place ribs onto a work surface, turn so bones are facing up, and slice meat between the bones to separate. Cut membrane running along the length of each rib; slide the bone loose from the meat. Trim any excess fat and cut into serving portions. Pat ribs dry with paper towels; return to the cooling rack."
    },
    {
      "position": 6,
      "text": "Heat a skillet until smoking hot. Add ribs and brown quickly, 30 to 60 seconds per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 4325,
  "preparation_time_minutes": 20,

  "id": "a786774c-eb0c-5fc1-92c7-918b3e8ace01",
  "slug": "slow-cooker-steak-bites-recipe-11928497",
  "name": "Slow Cooker Steak Bites",
  "recipe_type": "appetizer",
  "brief_description": "These tender slow cooker steak bites come together in 15 minutes before simmering in a rich maple-Dijon Worcestershire sauce. Get restaurant-worthy flavor with effortless Crockpot ease.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut steak into 1 to 2-inch pieces."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-high heat. Quickly sear steak bites for 1 to 2 minutes per side."
    },
    {
      "position": 3,
      "text": "Place onion wedges on the bottom of a slow cooker. Add seared steak bites on top."
    },
    {
      "position": 4,
      "text": "Whisk Worcestershire sauce, Dijon, maple syrup, garlic, and black pepper together in a small bowl; pour over steak and onions. Pour in beef bone broth."
    },
    {
      "position": 5,
      "text": "Cook on Low for 3 hours total. At 1.5 hours; add mushrooms. 15 minutes before the 3-hour mark, remove 2 tablespoons of the cooking liquid and place in a small bowl. Whisk cornstarch into broth; pour back into crockpot. Continue to cook until thickened, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Taste and adjust seasoning with salt, pepper, or maple syrup. Garnish with fresh parsley if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

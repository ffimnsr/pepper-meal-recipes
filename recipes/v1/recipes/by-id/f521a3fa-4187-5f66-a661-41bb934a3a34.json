  "id": "f521a3fa-4187-5f66-a661-41bb934a3a34",
  "slug": "domino-cookies-recipe-11806057",
  "name": "Domino Cookies",
  "recipe_type": "dessert",
  "brief_description": "These domino cookies are a chewy chocolate cookie made with black cocoa and white chocolate chips - think Oreo vibes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter, white sugar, brown sugar, vanilla, and salt together with an electric mixer until light and fluffy, 2 to 3 minutes (if using melted butter instead, just mix until combined). Add egg and egg yolk and mix until incorporated."
    },
    {
      "position": 2,
      "text": "Add flour, black cocoa powder, and baking soda and mix on low speed until a soft dough comes together. Add white chocolate chips and mix until just combined. Wrap the dough in plastic (I usually take it out of the bowl) and refrigerate until firm, at least 2 hours, and preferably overnight."
    },
    {
      "position": 3,
      "text": "Portion the cookies: divide and roll the dough into 12 balls. If using extra chopped white chocolate, press several pieces into each dough ball and place them in the refrigerator."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Place cookies on the prepared baking sheet. You can fit 6 to 8 on a half sheet, leaving some space for spreading between each."
    },
    {
      "position": 6,
      "text": "Bake until cookies have spread and centers no longer look shiny and wet, 13 to 14 minutes. Bang the pan carefully on the counter 1 or 2 times to flatten cookies a bit, giving them chewier centers. Let cool on the pan."
    },
    {
      "position": 7,
      "text": "Let cookies cool on the pan. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

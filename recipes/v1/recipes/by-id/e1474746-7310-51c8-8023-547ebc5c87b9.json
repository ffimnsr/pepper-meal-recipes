  "slug": "guacamole",
  "name": "Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This tasty guacamole is easy to make with ripe avocados, lime juice, tomatoes, garlic, and onion. Cilantro and cayenne give it an extra kick!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mash avocados, lime juice, and salt together in a medium bowl; mix in tomatoes, onion, cilantro, and garlic."
    },
    {
      "position": 3,
      "text": "Stir in cayenne pepper. Serve immediately, or cover and refrigerate for 1 hour for improved flavor."
    }
  ],
  "servings": 4,

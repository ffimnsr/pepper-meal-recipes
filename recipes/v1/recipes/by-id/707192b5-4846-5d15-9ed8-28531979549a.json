  "id": "707192b5-4846-5d15-9ed8-28531979549a",
  "slug": "white-chocolate-buttercream-recipe-7485999",
  "name": "White Chocolate Buttercream",
  "recipe_type": "dessert",
  "brief_description": "White chocolate buttercream is deliciously sweet and a breeze to make with this easy recipe; perfect for piping on cakes, cupcakes, and more!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt white chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Place about \u00bd of the confectioners sugar and butter in a large bowl; beat with an electric mixer while gradually adding the remaining sugar in batches, until mixture is smooth."
    },
    {
      "position": 4,
      "text": "Add cooled white chocolate and mix until smooth. If frosting is too thick, you can beat in milk, or if the frosting is too runny, beat in more confectioners\u2019 sugar to get the desired consistency."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "8e580ac3-60d0-5081-bbc7-a4ee49a55a3c",
  "slug": "ham-bone-chowder",
  "name": "Ham Bone Chowder",
  "recipe_type": "soup",
  "brief_description": "Leftover ham bones are a perfect addition to potato and corn chowder in the slow cooker for a warm and comforting weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ham bone in a slow cooker; top with chicken stock, onion, and garlic."
    },
    {
      "position": 2,
      "text": "Cook on Low for 6 to 8 hours."
    },
    {
      "position": 3,
      "text": "Remove ham bone from the slow cooker; pull meat off bone and shred. Return shredded meat to the slow cooker and discard ham bone. Add potatoes, carrots, parsley, and cumin; mix well."
    },
    {
      "position": 4,
      "text": "Cook on High until potatoes are tender, about 45 minutes. Stir in frozen corn."
    },
    {
      "position": 5,
      "text": "Remove 1 cup soup to a blender. Add milk. Cover and hold the lid down; pulse a few times before leaving on to blend. Return blended soup to the slow cooker and stir well. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 405,
  "preparation_time_minutes": 15,

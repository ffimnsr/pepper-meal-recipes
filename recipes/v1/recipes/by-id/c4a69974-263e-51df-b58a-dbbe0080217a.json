  "id": "c4a69974-263e-51df-b58a-dbbe0080217a",
  "slug": "jeans-swedish-faux-meatballs",
  "name": "Jean's Swedish Faux Meatballs",
  "recipe_type": "main",
  "brief_description": "Burger-style crumbles (or TVP) combined with bread crumbs, onion and milk and formed into 'meat' balls, then baked with a creamy gravy. Excellent served with 'no-yolk' noodles and your favorite vegetable.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl combine bread crumbs, onion, pepper, nutmeg and milk. Stir in burger-style crumbles until well blended. Form into 1 1/2 balls."
    },
    {
      "position": 3,
      "text": "In a large skillet over medium heat, brown the 'meat' balls in butter. Remove with a slotted spoon and place in a 2 quart casserole dish."
    },
    {
      "position": 4,
      "text": "Whisk flour into drippings in skillet; cook until bubbly, stirring constantly. Stir in broth and cream and continue cooking, stirring, until sauce thickens and boils, about 1 minute. Pour over 'meat' balls ."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

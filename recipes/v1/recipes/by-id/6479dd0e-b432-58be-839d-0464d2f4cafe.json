  "id": "6479dd0e-b432-58be-839d-0464d2f4cafe",
  "slug": "blackened-fish",
  "name": "Blackened Fish",
  "recipe_type": "main",
  "brief_description": "Blackened fish seasoned with paprika, cayenne pepper, dry mustard, cumin, and thyme cooked in a hot cast iron pan until charred and flavorful.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together paprika, dry mustard, cayenne pepper, cumin, black pepper, white pepper, thyme, and salt in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat a heavy cast iron pan on high heat until extremely hot, about 10 minutes. While the pan is heating, pour 3/4 cup melted butter into a shallow dish."
    },
    {
      "position": 4,
      "text": "Dip each fillet into butter, turning once to coat both sides."
    },
    {
      "position": 5,
      "text": "Sprinkle both sides of fillets with spice mixture; gently pat mixture onto fish."
    },
    {
      "position": 6,
      "text": "Working in batches, place fillets into the hot pan without crowding. Carefully pour about 1 teaspoon melted butter over each fillet. Cook until fish has a charred bottom, about 2 minutes. Turn fillets and spoon about 1 teaspoon melted butter over each."
    },
    {
      "position": 7,
      "text": "Continue cooking until bottoms are charred, 1 to 2 minutes. Repeat with remaining fish. Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5212bbca-6d3e-5e35-a011-d934499d9354",
  "slug": "honey-baked-chicken-i",
  "name": "Honey Baked Chicken I",
  "recipe_type": "main",
  "brief_description": "Seasoned chicken basks in a honey-egg glaze.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Rub chicken pieces with garlic powder, salt and pepper. In a small bowl, beat egg yolk with honey and butter or margarine, then brush this mixture over chicken pieces. Place chicken pieces, skin side down, in a lightly greased 9x13 inch baking dish."
    },
    {
      "position": 3,
      "text": "Bake at 325 degrees F (165 degrees C) for 45 to 60 minutes or until chicken is cooked through and juices run clear, basting with remaining butter or margarine. Just before serving, turn chicken over and bake for another 10 to 15 minutes to cook the skin on the other side."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

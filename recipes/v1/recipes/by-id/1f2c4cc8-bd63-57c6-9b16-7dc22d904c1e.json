  "id": "1f2c4cc8-bd63-57c6-9b16-7dc22d904c1e",
  "slug": "big-charlies-gumbo",
  "name": "Big Charlie's Gumbo",
  "recipe_type": "soup",
  "brief_description": "A roux cooked to a deep reddish-brown is what gives a gumbo recipe its distinctive flavor. This version uses andouille sausage, cubes of beef, crab and shrimp in a highly seasoned stew.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large skillet over medium heat. Cook garlic, onions, celery, and okra, stirring constantly until golden brown. Set aside."
    },
    {
      "position": 2,
      "text": "In a large heavy-bottomed stock pot over medium-high heat, combine 1/4 cup butter and flour. Cook, stirring constantly, until the roux becomes chocolate brown. Stir in the vegetable mixture, and stew meat. Cook, stirring, until vegetables are tender, and meat is evenly brown. Stir in water, tomatoes, and sugar. Season with parsley, thyme, bay leaves, salt, cayenne pepper, and black pepper. Bring to a boil, reduce heat, and simmer for 2 1/2 hours, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Add shrimp, crabmeat, and andouille to the stock pot. Stir in hot pepper sauce and Worcestershire sauce. Remove seeds from lemon and squeeze juice into the stock pot. Simmer an additional 10 minutes, stirring occasionally. Remove bay leaves, sprinkle with fil\u00e9 powder, and serve over rice."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 210,

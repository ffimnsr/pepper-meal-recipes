  "id": "9e30a181-5d0f-5cee-b650-5a590588b617",
  "slug": "keto-creme-brulee",
  "name": "Keto Cr\u00e8me Br\u00fbl\u00e9e",
  "recipe_type": "dessert",
  "brief_description": "This delicious keto cr\u00e8me br\u00fbl\u00e9e recipe is made with just 4 easy ingredients for an elegant, low-carb, gluten-free dessert in under an hour!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks and vanilla extract in a bowl until combined."
    },
    {
      "position": 3,
      "text": "Pour heavy whipping cream and 1 tablespoon sweetener into a saucepan; heat, whisking continuously, over medium heat until it starts to simmer. Remove from heat; gradually add egg yolk mixture, whisking continuously, until well combined."
    },
    {
      "position": 4,
      "text": "Divide mixture evenly between 4 ramekins and place them in a glass baking dish; pour in enough hot water to come halfway up the sides of the dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven on the middle rack until set, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Sprinkle 1 tablespoon sweetener over each cr\u00e8me br\u00fbl\u00e9e. Use a culinary torch to heat sweetener until caramelized, about 30 seconds. Refrigerate until set, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

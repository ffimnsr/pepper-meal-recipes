  "id": "09baa208-5a94-56d3-8faa-fb4af782e389",
  "slug": "eggless-milkless-butterless-cake",
  "name": "Eggless Milkless Butterless Cake",
  "recipe_type": "dessert",
  "brief_description": "This is a spice type cake. It is from the depression era or war time rationing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 8 or 9 inch square cake pan."
    },
    {
      "position": 2,
      "text": "In a saucepan over medium high heat combine; the sugar, shortening, ground cinnamon, ground nutmeg, ground allspice, salt, raisins, and water bring to a boil and continue boiling for 5 minutes. Remove from heat and let cool."
    },
    {
      "position": 3,
      "text": "Sift the flour, baking powder and baking soda together. Add the flour mixture to the cooled raisin mixture. Stir until just combined. Pour batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

  "slug": "festive-olive-and-cheese-appetizer",
  "name": "Festive Olive and Cheese Appetizer",
  "recipe_type": "appetizer",
  "brief_description": "Festive cherry tomato, olive, and cheese appetizer platter arranged in the shape of a wreath with fresh rosemary springs. Tastes (and smells) amazing!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange rosemary sprigs in a 10-inch-diameter circle to resemble a wreath. Start by placing one sprig at a 45-degree angle with the leafy tip facing outwards. Continue adding sprigs in the same direction until you have formed a full circle."
    },
    {
      "position": 2,
      "text": "Arrange clusters of mozzarella balls, olives, and tomatoes over rosemary sprigs."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

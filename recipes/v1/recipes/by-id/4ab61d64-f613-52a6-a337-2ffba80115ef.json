{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4ab61d64-f613-52a6-a337-2ffba80115ef",
  "slug": "croatian-apple-pie-squares-recipe-7508367",
  "name": "Croatian Apple Pie Squares",
  "recipe_type": "dessert",
  "brief_description": "Croatian apple pie squares feature a fragrant and delicious cooked apple raisin filling, enclosed top and bottom with a flaky crust.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Add flour and butter to a large bowl, and use your fingertips to rub butter into flour until mixture resembles coarse breadcrumbs with no large lumps of butter remaining."
    },
    {
      "position": 2,
      "text": "Add the 1/4 cup Demerara sugar, egg yolks, sour cream, and brandy to flour mixture and combine with a spatula just until the dough comes together. Wrap dough in plastic wrap and chill for at least 2 hours or overnight."
    },
    {
      "position": 3,
      "text": "Meanwhile, place apples, raisins, the 1/3 cup Demerara sugar, vanilla sugar, cinnamon, and lemon juice in a saucepan. Bring to a simmer over medium-low heat and simmer until apples are tender, and mixture is slightly thickened, about 10 minutes. Set aside to cool."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 9x16-inch baking pan with parchment."
    },
    {
      "position": 5,
      "text": "Divide the chilled dough into two equal pieces. Roll the dough out on a lightly floured surface into 2 9x16-inch rectangles. Place one of the rectangles into the prepared baking pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a pale crust develops on top, 10 to 15 minutes. Remove from the oven."
    },
    {
      "position": 7,
      "text": "Carefully brush the semi-baked crust with apricot jam. Evenly distribute filling over the crust. Place the second rectangle of dough on top and prick it all over with a fork."
    },
    {
      "position": 8,
      "text": "Bake until crust is lightly browned and filling is hot and bubbly, about 30 minutes."
    },
    {
      "position": 9,
      "text": "Remove to a wire rack, and allow to cool slightly, about 10 minutes. Dust the still-warm pie with confectioner\u2019s sugar, cut into squares, and serve warm or at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

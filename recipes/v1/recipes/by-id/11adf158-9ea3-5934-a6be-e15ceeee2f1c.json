  "id": "11adf158-9ea3-5934-a6be-e15ceeee2f1c",
  "slug": "cranberry-orange-loaf",
  "name": "Cranberry Orange Loaf",
  "recipe_type": "appetizer",
  "brief_description": "This cranberry-orange loaf recipe makes a very moist, tart, bright loaf wth sweet pecans for crunch; a delicious holiday treat full of festive flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, baking soda, and salt together in a large bowl. Stir in cranberries, pecans, and zest. Set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar, butter, and egg together in another large bowl until smooth. Stir in orange juice."
    },
    {
      "position": 4,
      "text": "Beat in flour mixture until just moist. Pour into prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bread springs back when lightly touched, about 1 hour. Let stand 10 minutes; turn out onto a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c47c5333-a622-583e-95f7-f51bb234ee7d",
  "slug": "pan-fried-pork-chops",
  "name": "Pan-Fried Pork Chops",
  "recipe_type": "main",
  "brief_description": "These pan-fried boneless pork chops take minutes to prepare and have great flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Do not pat chops dry, so seasonings and flour will stick."
    },
    {
      "position": 2,
      "text": "Season both sides of pork chops with salt and pepper, then sprinkle with flour on both sides. Use the back of a spoon to distribute the flour over the entire surface."
    },
    {
      "position": 3,
      "text": "Heat oil in a 12-inch non-stick skillet over medium heat until it shimmers. Carefully add pork chops and pan fry until brown, about 4 minutes. Do not disturb the chops until ready to turn."
    },
    {
      "position": 4,
      "text": "When you see the edges of the chops turn brown, turn, and pan fry the other side until no longer pink on the inside and brown on the outside, an additional 4 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C). Reduce heat, if they are browning too quickly. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

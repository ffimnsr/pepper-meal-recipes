{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b55f00e1-ec0a-52e0-b401-9ff7077805d8",
  "slug": "chicken-fettuccini-alfredo",
  "name": "Creamy Chicken Fettuccine Alfredo",
  "recipe_type": "main",
  "brief_description": "Al dente fettuccine pasta is topped with tender chunks of chicken and a creamy Alfredo sauce made with mushrooms, tomatoes, and lots of cheese.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium heat. Add chicken, 1/2 of the garlic, and Italian seasoning. Cook until chicken is no longer pink in the center and the juices run clear. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove from the skillet and set aside."
    },
    {
      "position": 3,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, 8 to 10 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt remaining 4 tablespoons butter in the skillet. Add onion, mushrooms, and remaining garlic; saut\u00e9 until onion is transparent, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in flour, salt, and pepper; cook for 2 minutes. Slowly add milk and half-and-half; cook and stir until smooth and creamy. Stir in both cheeses until melted."
    },
    {
      "position": 6,
      "text": "Stir in chicken mixture, tomatoes, and sour cream. Serve over cooked fettuccini."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

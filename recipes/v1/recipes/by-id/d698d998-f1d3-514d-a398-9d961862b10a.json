  "id": "d698d998-f1d3-514d-a398-9d961862b10a",
  "slug": "fudge",
  "name": "Fudge",
  "recipe_type": "dessert",
  "brief_description": "Chocolate fudge is easy to make in the microwave with just 3 ingredients and optional add-ins. Perfect for any dessert or holiday food gifting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chocolate chips, condensed milk, and butter in large microwave-safe bowl. Microwave on medium heat until chips are melted, 3 to 5 minutes, stirring once or twice during the cooking."
    },
    {
      "position": 3,
      "text": "Meanwhile, generously grease an 8-inch square glass baking dish."
    },
    {
      "position": 4,
      "text": "Remove chocolate mixture from the microwave and stir in nuts. Pour into the prepared dish."
    },
    {
      "position": 5,
      "text": "Refrigerate until fudge is set, about 2 hours."
    },
    {
      "position": 6,
      "text": "Cut into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,

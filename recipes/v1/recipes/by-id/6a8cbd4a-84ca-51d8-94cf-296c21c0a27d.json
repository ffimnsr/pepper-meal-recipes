  "id": "6a8cbd4a-84ca-51d8-94cf-296c21c0a27d",
  "slug": "shrimp-nachos",
  "name": "Shrimp Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Shrimp is mixed in a creamy and cheesy sauce and spread on tortilla chips that are then broiled into bubbling and delicious shrimp nachos.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Spread tortilla chips onto the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Mix Monterey Jack cheese, shrimp, mayonnaise, chipotle peppers in adobo sauce, cilantro, minced onion, cumin, and black pepper together in a bowl. Spoon mixture onto the tortilla chips."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 3 minutes. Turn on the broiler and broil nachos until lightly browned, 3 to 4 minutes. Allow nachos to sit at room temperature for about 2 minutes before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "dumpling-bake-recipe-11937140",
  "name": "Dumpling Bake",
  "recipe_type": "main",
  "brief_description": "This dumpling bake uses frozen gyoza, baked in a garlicky coconut curry sauce with fresh spinach. It's very easy to assemble, and most of the ingredients can be kept in your pantry or freezer, ready to go.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir coconut milk, red curry sauce, teriyaki sauce, and garlic together in a 9x13-inch baking pan. Scatter spinach evenly on top."
    },
    {
      "position": 3,
      "text": "Arrange gyoza in the baking dish. Use as many as can fit in the dish; up to about 15. Cover with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until heated through, about 35 minutes."
    },
    {
      "position": 5,
      "text": "Drizzle with chili crunch before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

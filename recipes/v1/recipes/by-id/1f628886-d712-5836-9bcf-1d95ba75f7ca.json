  "id": "1f628886-d712-5836-9bcf-1d95ba75f7ca",
  "slug": "restaurant-style-coleslaw-ii",
  "name": "Restaurant-Style Slaw",
  "recipe_type": "salad",
  "brief_description": "This restaurant-style coleslaw recipe tosses finely chopped cabbage and carrots with a creamy, tangy buttermilk dressing for a classic side dish.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk sugar, salt, ground black pepper, milk, mayonnaise, buttermilk, vinegar, and lemon juice together in a large bowl until smooth. Add cabbage and carrots; toss until evenly coated with dressing. Refrigerate for at least 2 hours before serving."
    }
  ],
  "servings": 8,

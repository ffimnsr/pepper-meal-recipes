  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8aeae6c5-3ccb-545e-85cb-3c7065ee9bf7",
  "slug": "spicy-thai-basil-chicken-pad-krapow-gai",
  "name": "Spicy Thai Basil Chicken (Pad Krapow Gai)",
  "recipe_type": "main",
  "brief_description": "Chef John's version of this classic Thai dish, made with freshly chopped chicken thighs and fresh basil, has a rich sauce that cooks down into a caramelized glaze.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Whisk chicken broth, oyster sauce, soy sauce, fish sauce, white sugar, and brown sugar together in a bowl until well blended."
    },
    {
      "position": 3,
      "text": "Heat large skillet over high heat. Drizzle in oil. Add chopped chicken and stir fry until it loses its raw color, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir in shallots, garlic, and sliced chilies. Continue cooking on high heat until some of the juices start to caramelize in the bottom of the pan, about 2 or 3 more minutes."
    },
    {
      "position": 5,
      "text": "Add about a tablespoon of the sauce mixture to the skillet; cook and stir until sauce begins to caramelize, about 1 minute."
    },
    {
      "position": 6,
      "text": "Pour in the rest of the sauce. Cook and stir until sauce has deglazed the bottom of the pan. Continue to cook until sauce glazes onto the meat, 1 or 2 more minutes. Remove from heat."
    },
    {
      "position": 7,
      "text": "Stir in basil. Cook and stir until basil is wilted, about 20 seconds. Serve with rice."
    },
    {
      "position": 8,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

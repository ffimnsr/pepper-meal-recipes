  "id": "89c205ee-366b-55a8-a972-b50b6998b674",
  "slug": "stuffed-orange-peppers",
  "name": "Stuffed Orange Peppers",
  "recipe_type": "main",
  "brief_description": "This orange bell pepper recipe features a stuffing of ground turkey, onion, rice, tomatoes, and Gouda cheese for a quick and easy weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil; cook orange bell peppers in boiling water until slightly softened, about 5 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cook and stir turkey and onion in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 4,
      "text": "Stir tomatoes, rice, 1/2 cup water, and liquid smoke into turkey mixture; cover the skillet and simmer until rice is tender, about 15 minutes. Remove the skillet from heat; stir in Gouda cheese."
    },
    {
      "position": 5,
      "text": "Stuff each orange bell pepper with turkey mixture and place peppers, open-side up, in a baking dish. Cover the dish with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until heated through and cheese is melted, 25 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "strawberry-fluff",
  "name": "Strawberry Fluff",
  "recipe_type": "salad",
  "brief_description": "This is a favorite holiday treat for my family. It can be made with sugar free gelatin, fat free cottage cheese, and fat free cool whip for a lower calorie treat. This is an EASY and quick treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "In a mixing bowl, combine the gelatin mix, cottage cheese, whipped topping and pineapple. Mix together well, refrigerate until chilled and serve."
    }
  ],

  "id": "ee3d055c-93ac-5253-8b30-323de3b3be8e",
  "slug": "cottage-cheese-chicken-enchiladas",
  "name": "Cottage Cheese Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "Cottage cheese lends a lighter texture to chicken and cheese enchiladas, bathed in classic red enchilada sauce.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "To make the chicken mixture: Heat oil in a medium skillet over medium-high heat. Add shredded chicken, onion, and green chile peppers; cook and stir until heated through and lightly browned. Stir in taco seasoning and prepare according to package directions."
    },
    {
      "position": 2,
      "text": "To make the cheese mixture: Combine sour cream, cottage cheese, salt, and pepper in a medium bowl; mix until well blended."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "To assemble the enchiladas: Warm tortillas until soft and pliable. Spoon some of the chicken mixture and cheese mixture down the center of each tortilla, then sprinkle with a little Monterey Jack cheese. Roll up and place seam-side down in a lightly greased 9x13-inch baking dish. Spoon any remaining chicken and cheese mixtures over the enchiladas. Pour enchilada sauce evenly over the top, then sprinkle with remaining Monterey Jack cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

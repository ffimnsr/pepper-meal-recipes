  "id": "20b4310b-ab08-5db2-905d-3d4fbc8e6bdd",
  "slug": "sweet-blueberry-cream-cheese-pie",
  "name": "Blueberry Cream Cheese Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet blueberry cream cheese pie with a rich, nutty crust has a fluffy, creamy filling topped with a zesty, fresh blueberry sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, pecans, and butter in a bowl. Press dough into a 9x13-inch baking dish to form a crust."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until golden brown, about 30 minutes. Allow crust to cool completely."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat blueberries, sugar, cornstarch, and 1 teaspoon lemon juice in a saucepan over medium heat until berries burst and juice thickens, about 10 minutes. Allow blueberry sauce to cool completely."
    },
    {
      "position": 5,
      "text": "Beat cream cheese until fluffy. Add sweetened condensed milk and blend well. Stir in 1/3 cup lemon juice. Pour cream cheese filling into cooled crust and spread blueberry sauce over cream cheese. Chill in refrigerator for at least 2 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

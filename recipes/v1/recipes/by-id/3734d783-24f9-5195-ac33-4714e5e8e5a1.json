  "id": "3734d783-24f9-5195-ac33-4714e5e8e5a1",
  "slug": "instant-ramen-carbonara-recipe-8727364",
  "name": "Instant Ramen Carbonara",
  "recipe_type": "main",
  "brief_description": "This instant ramen carbonara turns ramen noodles, bacon, and Parmesan into a quicker carbonara, using ingredients you probably have on hand.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 6 cups water to a boil in a large saucepan. Add noodles and cook for 3 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Add bacon and cook until crisp, stirring often, about 8 minutes. Using a slotted spoon, transfer bacon to a plate lined with paper towels."
    },
    {
      "position": 3,
      "text": "Whisk eggs, Parmesan, 2 tablespoons water, parsley, and pepper in a mixing bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Add garlic to the skillet with bacon drippings and cook over medium-high heat for 1 minute. Toss in drained noodles and cook 3 minutes more. Turn off heat."
    },
    {
      "position": 5,
      "text": "Pour in reserved egg mixture, toss to coat, and let sit 2 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

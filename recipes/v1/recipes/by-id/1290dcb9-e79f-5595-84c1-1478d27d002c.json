{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1290dcb9-e79f-5595-84c1-1478d27d002c",
  "slug": "chicken-and-shrimp-carbonara",
  "name": "Chicken and Shrimp Carbonara",
  "recipe_type": "main",
  "brief_description": "This mouthwatering chicken and shrimp carbonara recipe is a copycat version of one that's very popular at an Italian-American chain restaurant.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a large skillet over medium-high heat. Add chicken, 1 tablespoon garlic, and 1 tablespoon Italian seasoning; cook and stir until chicken is no longer pink in the center and the juices run clear, 6 to 8 minutes. Transfer to a bowl."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil and 1 tablespoon garlic in the same skillet until fragrant, about 1 minute. Add shrimp and cook until bright pink on the outside and the meat is opaque, 2 to 3 minutes per side. Transfer to the bowl with chicken."
    },
    {
      "position": 3,
      "text": "Cook bacon in the same skillet until just crispy (not crunchy), about 6 minutes. Drain on a paper towel-lined plate; leave grease in the skillet."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Add linguine and remaining 2 tablespoons oil; cook until tender yet firm to the bite, about 11 minutes. Drain and keep warm."
    },
    {
      "position": 5,
      "text": "Mix cream, Parmesan cheese, egg yolks, remaining 1 tablespoon Italian seasoning, salt, and pepper together in a bowl."
    },
    {
      "position": 6,
      "text": "Saut\u00e9 onion in bacon grease over medium heat until translucent, about 5 minutes. Add wine, increase the heat, and bring to a boil."
    },
    {
      "position": 7,
      "text": "Add cream mixture, reduce the heat, and simmer until sauce begins to thicken, 3 to 5 minutes. Stir in chicken, bacon, and shrimp until coated, then serve over linguine."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

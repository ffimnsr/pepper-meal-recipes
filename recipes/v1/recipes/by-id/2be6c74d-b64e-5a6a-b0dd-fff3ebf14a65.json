  "id": "2be6c74d-b64e-5a6a-b0dd-fff3ebf14a65",
  "slug": "stovetop-yankee-pot-roast",
  "name": "Stovetop Yankee Pot Roast",
  "recipe_type": "main",
  "brief_description": "A traditional Yankee pot roast recipe made with carrots, onions, celery, and red wine is easy to make on the stove!",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a heavy, cast iron pot over medium heat. Dredge roast in flour, shake off excess, and brown in hot oil on all sides."
    },
    {
      "position": 2,
      "text": "Stir in onions, carrots, celery, garlic, and allspice; cook until lightly browned. Pour in red wine and bring to a simmer before pouring in beef broth. Reduce heat to low, cover, and cook until beef is tender, 2 to 3 hours."
    },
    {
      "position": 3,
      "text": "Remove meat to a cutting board; allow to rest for 10 minutes."
    },
    {
      "position": 4,
      "text": "While beef is resting, thicken cooking liquid with cornstarch. Slice beef and serve with gravy."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 130,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "expert",

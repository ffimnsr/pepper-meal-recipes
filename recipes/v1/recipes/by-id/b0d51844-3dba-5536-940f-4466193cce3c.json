  "id": "b0d51844-3dba-5536-940f-4466193cce3c",
  "slug": "thick-cut-outs",
  "name": "Thick Cut-Outs",
  "recipe_type": "dessert",
  "brief_description": "A big batch of big thick sugar cookies. These are THE big soft sugar cookies you have been looking for. Frost them while warm and sprinkle with colored sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make the cookies: In a large bowl, cream together the sugar and butter until smooth. Beat in 4 whole eggs and 6 egg yolks, one at a time, mixing well after each. Mix in vanilla extract. Combine flour, baking powder, and salt; stir into the sugar mixture. Cover dough and chill for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets."
    },
    {
      "position": 3,
      "text": "On a floured surface, roll the dough out to 1/2 inch thickness and cut into desired shapes using cookie cutters. Place 2 inches apart on the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack."
    },
    {
      "position": 5,
      "text": "While cookies are baking, make the frosting: Mix together the confectioners\u2019 sugar, oil and 1 teaspoon vanilla until smooth. Gradually add enough hot water to achieve a spreadable consistency."
    },
    {
      "position": 6,
      "text": "Spread frosting over warm cookies."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "pickled-banana-peppers-recipe-8664623",
  "name": "Pickled Banana Peppers",
  "recipe_type": "side",
  "brief_description": "These pickled banana peppers are easy to make, and cure in the refrigerator. They\u2019ll be great on sandwiches and pizza.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pack peppers, garlic, and jalapenos tightly in a glass jar."
    },
    {
      "position": 2,
      "text": "Bring vinegar, water, and salt to a boil, stirring occasionally, until salt is dissolved. Remove from heat and let stand 10 minutes. Pour warm mixture over peppers and seal jar. Refrigerate 12 to 24 hours before using and up to 4 weeks."
    }
  ],

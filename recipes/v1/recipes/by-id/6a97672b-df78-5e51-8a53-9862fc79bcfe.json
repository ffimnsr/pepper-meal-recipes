  "id": "6a97672b-df78-5e51-8a53-9862fc79bcfe",
  "slug": "peanut-butter-fudge-i",
  "name": "Peanut Butter-Marshmallow Fudge",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter fudge with marshmallows is easy to make with pantry staples, including white and brown sugars, butter, milk, and vanilla extract.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9-inch square pan."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, white sugar, milk, and 4 tablespoons butter in a 3-quart saucepan over medium heat. Cook to soft-ball stage, 234 degrees F (112 degrees C). Remove from the heat."
    },
    {
      "position": 3,
      "text": "Stir in marshmallows, peanut butter, and vanilla; continue stirring until marshmallows melt. Pour into the prepared pan, cool completely, then cut into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

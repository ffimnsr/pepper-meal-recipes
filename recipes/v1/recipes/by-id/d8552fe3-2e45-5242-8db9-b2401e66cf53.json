  "id": "d8552fe3-2e45-5242-8db9-b2401e66cf53",
  "slug": "cola-pot-roast-ii",
  "name": "Cola Pot Roast",
  "recipe_type": "soup",
  "brief_description": "Dried onion soup mix, condensed cream of mushroom soup and packaged brown gravy mix make this cola-flavored pot roast easy to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place roast in a roasting pan. Arrange carrots, celery, and garlic around the roast."
    },
    {
      "position": 3,
      "text": "Whisk brown gravy mix and water together in a small bowl until smooth. Stir in onion soup mix, condensed cream of mushroom soup, and cola. Pour mixture over the roast."
    },
    {
      "position": 4,
      "text": "Cover the roasting pan and bake for 1 hour in the preheated oven."
    },
    {
      "position": 5,
      "text": "Reduce oven temperature to 225 degrees F (110 degrees C). Continue baking for 2 hours. Remove the roasting pan from the oven and carefully turn the roast over so it is coated with the gravy. Cover and return to the oven until the roast is fork-tender, at least 2 more hours."
    },
    {
      "position": 6,
      "text": "Transfer the roast to a cutting board and let rest for 10 minutes before slicing. Serve with the vegetables and gravy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 15,

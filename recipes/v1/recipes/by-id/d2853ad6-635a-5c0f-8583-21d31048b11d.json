  "id": "d2853ad6-635a-5c0f-8583-21d31048b11d",
  "slug": "daddys-guacamole-dip",
  "name": "Daddy\u2019s Guacamole Dip",
  "recipe_type": "appetizer",
  "brief_description": "Try a family-favorite recipe for guacamole with cottage cheese for a fun variation of your favorite green dip. It adds a bit of tang and texture!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Scoop avocado flesh out of the skins and place into a medium mixing bowl; discard skins. Add lemon juice to the bowl and mash well. Add cottage cheese, tomatoes, onion, jalape\u00f1o, garlic powder, salt, and pepper; stir until combined. Chill for at least 1 hour before serving."
    }
  ],

  "id": "098ec05d-1824-5549-9dc9-17ca1d55cc39",
  "slug": "blonde-brownies-i",
  "name": "Blonde Brownies",
  "recipe_type": "dessert",
  "brief_description": "These blonde brownies are simple to make with basic pantry staples, chopped nuts, and semisweet chocolate chips for a decadent, chewy, buttery treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x9-inch baking pan."
    },
    {
      "position": 2,
      "text": "Sift together sifted flour, baking powder, salt, and baking soda in a medium bowl. Stir in chopped nuts; set aside."
    },
    {
      "position": 3,
      "text": "Mix brown sugar and melted butter in a large bowl until combined; cool slightly."
    },
    {
      "position": 4,
      "text": "Stir beaten egg and vanilla into brown sugar mixture. Add flour mixture, a little at a time, mixing just until combined. Spread batter into the prepared baking pan. Sprinkle chocolate chips on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 to 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

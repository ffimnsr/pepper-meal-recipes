  "id": "1433865d-eff5-5748-9fe9-036c1da389ba",
  "slug": "chef-johns-minestrone-soup",
  "name": "Chef John's Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "A great Italian soup that incorporates a wide variety of vegetables and is topped with flavorful Parmesan cheese.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in large stock pot over medium-high heat. Add pancetta; cook and stir until it begins to brown, 2 to 3 minutes. Stir in onions and celery; cook and stir until onions start to turn translucent, about 3 minutes. Stir in minced garlic and cook for another minute."
    },
    {
      "position": 2,
      "text": "Pour chicken broth, water, and plum tomatoes into the pancetta and onion mixture. Bring to a simmer."
    },
    {
      "position": 3,
      "text": "Stir cranberry beans, cabbage, garbanzo beans, red pepper flakes, Italian seasoning, and 2 teaspoons salt into broth mixture. Bring to a simmer and cook until cranberry beans are tender, adding more water as needed if the soup becomes too thick, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Stir in Swiss chard and simmer until softened, about 15 minutes. Season with salt and black pepper to taste."
    },
    {
      "position": 5,
      "text": "Stir in pasta and increase heat to medium-high and simmer until pasta is tender, about 15 minutes. Ladle into bowls and top with extra virgin olive oil, Parmigiano-Reggiano cheese, and Italian parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

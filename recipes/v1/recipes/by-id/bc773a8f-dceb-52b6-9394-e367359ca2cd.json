  "id": "bc773a8f-dceb-52b6-9394-e367359ca2cd",
  "slug": "potato-bacon-and-corn-chowder",
  "name": "Potato, Bacon, and Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This potato, bacon, and corn chowder 10-ingredient recipe is for a quick and delicious comforting soup made with canned corn, potatoes and smoky bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large skillet over medium heat until fat has rendered and bacon is crispy, about 8 minutes. Transfer bacon to a paper-towel-lined plate to drain; leave drippings in the skillet. Add celery, carrot, and bay leaf to the skillet; cook 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large pot over medium-low heat. Whisk in flour, whisking constantly; cook for 5 minutes. Slowly whisk in 4 cups milk. Bring to a simmer over medium-high heat; simmer for 5 minutes, whisking frequently."
    },
    {
      "position": 3,
      "text": "Add bacon, cooked vegetables, potatoes, and corn; return to a simmer, then reduce heat to medium-low. Cook until potatoes are tender, about 20 minutes; add milk as needed to achieve desired consistency. Garnish servings with paprika."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4b3d5196-dfb3-5107-8528-63315e9d9c66",
  "slug": "almond-chicken-stir-fry-recipe-11682891",
  "name": "Almond Chicken Stir Fry",
  "recipe_type": "main",
  "brief_description": "This almond chicken stir fry is a wholesome, colorful, tasty meal. Serve this over white rice, or try it over cauliflower rice or zucchini noodles.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine almond butter, coconut milk, chicken broth, rice vinegar, lime juice, soy sauce, black pepper, white pepper, and Sriracha in a bowl and stir to blend. Set sauce aside."
    },
    {
      "position": 2,
      "text": "Pat chicken pieces dry with paper towels, and season lightly with salt and pepper."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large, nonstick skillet over medium-high heat. Cook chicken in the hot oil until browned and cooked through, 6 to 8 minutes. Remove chicken to a plate and keep warm."
    },
    {
      "position": 4,
      "text": "In the same skillet, add red bell pepper slices and shallots. Cook and stir continuously, about 3 minutes. Add zucchini strips and cook, stirring, about 1 minute. Add garlic; cook and stir until garlic is fragrant, about 30 seconds."
    },
    {
      "position": 5,
      "text": "Return chicken to the skillet, add sauce, and stir to combine chicken with the other ingredients. Simmer 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Sprinkle with fresh chopped cilantro and sliced almonds. Serve with lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

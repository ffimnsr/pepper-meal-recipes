  "id": "12fa4674-4675-5a04-8624-fbc2500f64ac",
  "slug": "perfect-key-lime-pie-with-coconut-rum-whipped-cream-recipe-8662000",
  "name": "Perfect Key Lime Pie with Coconut Rum Whipped Cream",
  "recipe_type": "dessert",
  "brief_description": "The perfect key lime pie, served with coconut rum whipped cream, is rich and delicious, sweet and tart, and absolutely the best use of lime juice there is.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Break graham crackers into the bowl of a food processor and add sugar. Pulse until coarsely ground. Add melted butter and pulse about 4 times until mixture resembles damp sand; transfer to a pie plate and very lightly press into bottom and up sides of the dish."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven just until fragrant, 4 to 6 minutes. Let cool."
    },
    {
      "position": 3,
      "text": "Whisk together sweetened condensed milk and lime juice until smooth. Whisk in egg yolks until well combined. Stir in sour cream and zest until smooth."
    },
    {
      "position": 4,
      "text": "Pour filling over graham cracker crust; lightly spread in an even layer. Place pie dish on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until just set around the edges and slightly jiggly in the center, 14 to 16 minutes. Remove to a wire rack to cool to room temperature, about 40 minutes. Chill pie in the refrigerator for at least 8 hours."
    },
    {
      "position": 6,
      "text": "Place cream, powdered sugar, and rum in a mixing bowl. Beat with an electric mixer until cream holds medium peaks. Serve pie with whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

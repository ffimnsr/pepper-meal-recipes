  "id": "facc60db-22f7-53d2-94a7-0d09a955b43b",
  "slug": "overnight-matzo-bake",
  "name": "Overnight Matzo Bake",
  "recipe_type": "breakfast",
  "brief_description": "This Passover-friendly matzo bake with raisins, apricots, apples, and sour cream, is chilled overnight for easy prep.",
  "cuisine": "Jewish Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly coat a 2-quart baking dish with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Break matzo sheets into bite-sized pieces. Whisk together eggs, milk, sugar, sour cream, vanilla, cinnamon, salt, and nutmeg in a large bowl. Stir in raisins, apricots, apples, and matzo pieces. Transfer to the prepared baking dish, smoothing into an even layer. Cover with aluminum foil and transfer to a refrigerator to chill for 8 hours, or overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove baking dish from the refrigerator and uncover."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until puffed and set, 40 to 45 minutes. Remove from the oven and let sit at room temperature for at least 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

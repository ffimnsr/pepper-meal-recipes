  "id": "9a0f3a35-35f0-554c-9123-87452833d91b",
  "slug": "smoked-chicken-thighs",
  "name": "Smoked Chicken Thighs",
  "recipe_type": "main",
  "brief_description": "If you love home-smoked meats, try this simple and savory chicken thigh recipe made with a dry-rub spice mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a smoker to 200 degrees F (93 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine salt, black pepper, red pepper flakes, paprika, garlic powder, thyme, and oregano in a bowl. Apply to chicken thighs as a dry rub."
    },
    {
      "position": 3,
      "text": "Smoke thighs using cherry wood for 1 hour. Rotate and flip thighs and continue smoking until internal temperature reaches 165 degrees F (74 degrees C), about 1 hour more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

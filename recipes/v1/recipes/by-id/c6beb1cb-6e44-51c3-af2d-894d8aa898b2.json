  "id": "c6beb1cb-6e44-51c3-af2d-894d8aa898b2",
  "slug": "copycat-beaver-nuggets-recipe-11908343",
  "name": "Copycat Beaver Nuggets",
  "recipe_type": "appetizer",
  "brief_description": "These copycat beaver nuggets are crunchy, buttery, caramel-coated puffed corn, a homemade version of your favorite Texas snack from your favorite roadside stop.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Add puffed corn to a large bowl. Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butter, brown sugar, and corn syrup in a saucepan. Place over medium-high heat and bring to a boil, stirring often. Boil for 2 minutes and remove from heat. Immediately stir in baking soda, vanilla extract, and salt."
    },
    {
      "position": 3,
      "text": "Pour butter mixture over puffed corn and stir with a rubber spatula until evenly coated. Pour mixture evenly onto prepared baking sheets and spread into an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 45 to 55 minutes, stirring every 15 minutes. Let cool completely before serving or storing into airtight containers."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c73e05a1-9f24-5685-9da5-fba975936376",
  "slug": "baby-back-ribs",
  "name": "Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "These baby back ribs marinate overnight in BBQ sauce, then bake in the oven until extra succulent and flavorful for fall-off-the-bone tender pork.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut ribs into 4 equal portions."
    },
    {
      "position": 3,
      "text": "Tear off 4 pieces of aluminum foil big enough to enclose each portion of ribs. Grease each piece of foil with cooking spray."
    },
    {
      "position": 4,
      "text": "Brush ribs liberally with barbecue sauce; place each portion of ribs on a piece of foil. Wrap tightly and refrigerate for 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Bake ribs wrapped tightly in foil in the preheated oven for 2 \u00bd hours. Remove ribs from foil and serve with more sauce, if desired."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 150,

  "id": "5c3d867a-8a11-5fde-96c4-6406fa78a9d1",
  "slug": "chef-johns-chocolate-energy-bars",
  "name": "Chef John's Chocolate Energy Bars",
  "recipe_type": "appetizer",
  "brief_description": "You'll love these homemade chocolate energy bars made with dates, nuts, and coconut. Try a batch of these before buying expensive bars at the store.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place dates, cashews, almonds, cocoa powder, shredded coconut, coconut oil, cold espresso, vanilla, salt, and cayenne in the bowl of a food processor. Pulse on and off to start, then process for about 1 minute. Check to ensure mixture is sticky and moist enough to come together. Add more coffee if needed. Continue to process until mixture becomes a chunky mass."
    },
    {
      "position": 3,
      "text": "Line a 9x9-inch square baking pan with plastic wrap. Scoop mixture into the pan; press down with a spatula until mixture is even. Place a layer of plastic wrap on the surface and smooth again with your hands. Refrigerate until cold and firm, 2 to 3 hours."
    },
    {
      "position": 4,
      "text": "Remove from the pan and unwrap. Cut into 10 bars."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,

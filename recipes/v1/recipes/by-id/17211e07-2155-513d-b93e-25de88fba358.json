  "id": "17211e07-2155-513d-b93e-25de88fba358",
  "slug": "braised-flank-steak-with-lemon-and-garlic",
  "name": "Braised Flank Steak with Lemon and Garlic",
  "recipe_type": "soup",
  "brief_description": "Braised flank steak becomes flavorful and tender when simmered slowly in chicken broth with garlic, cloves, and lemon juice in an easy stovetop preparation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour and garlic powder together in a shallow dish. Season with salt and pepper. Dip steak into the flour mixture evenly coating both sides. Discard remaining flour mixture."
    },
    {
      "position": 2,
      "text": "Heat cooking oil in a skillet over medium-high heat. Place steak into the skillet and cook until browned, about 5 minutes per side. Stir in chicken broth, lemon juice, garlic, and cloves. Bring to a boil, then reduce the heat to low. Cover and simmer until steak is tender, about 1 1/2 hours."
    },
    {
      "position": 3,
      "text": "To serve, remove steak from the skillet and slice across the grain into thin strips. Place on serving plates and ladle sauce over top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 15,

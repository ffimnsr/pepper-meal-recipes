  "id": "d771711d-b5f5-5141-bb67-de0896663cae",
  "slug": "jalapeno-corn-bread",
  "name": "Jalape\u00f1o Cornbread",
  "recipe_type": "snack",
  "brief_description": "This Mexican-style cornbread is spiked with fresh jalape\u00f1o pepper for a kickin' version of an American favorite quick bread.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Move an oven rack to the center position."
    },
    {
      "position": 2,
      "text": "Mix together cream-style corn, cornmeal, buttermilk, eggs, corn oil, Cheddar cheese, jalape\u00f1o peppers, salt, and baking soda in a large bowl until batter is well combined."
    },
    {
      "position": 3,
      "text": "Put butter into a 9-inch square baking dish and place in the preheated oven until melted, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Pour batter over melted butter in the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, about 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

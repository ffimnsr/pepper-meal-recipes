  "id": "4a875ec0-744b-5aa4-9c4f-b1ef379d00ee",
  "slug": "easy-shakshuka-with-crispy-hash-browns-recipe-12034904",
  "name": "Easy Shakshuka with Crispy Hash Browns",
  "recipe_type": "breakfast",
  "brief_description": "This easy shakshuka with crispy hash browns is a saucy dish of tender eggs cooked in a flavorful, warmly spiced tomato and pepper sauce. Crispy hash brown wedges are perfect for scooping up every bite of this North African-inspired dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a large nonstick skillet over medium-high heat. Add hash browns and season with 1/4 teaspoon each salt and black pepper. Pat hash browns into an even layer to cover bottom of skillet. Cook, without stirring, until bottom and edges of hash browns are golden brown, about 8 minutes."
    },
    {
      "position": 2,
      "text": "Carefully invert hash browns onto a large plate. Add 1 tablespoon oil to skillet and carefully slide hash browns back into skillet. Cook until other side is crisp and golden brown, 6 to 8 minutes. Remove hash browns from skillet; cut into wedges and cover to keep warm."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat remaining 1 tablespoon oil in skillet over medium heat. Add bell pepper and onion blend and jalape\u00f1o. Sprinkle with ras el hanout and remaining 1/4 teaspoon each salt and black pepper. Cook, stirring frequently, until tender and lightly browned, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in tomatoes and water. Cook, using a fork to mash any large tomato chunks, until simmering, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Make 4 indentations in tomato mixture using a measuring cup or spoon. Crack 1 egg into each indentation. Cook, covered, until eggs are set, about 5 minutes for runny yolks, 7 minutes for soft-set, or 9 minutes for hard-cooked yolks. Garnish with cilantro and additional black pepper. Serve with hash brown wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

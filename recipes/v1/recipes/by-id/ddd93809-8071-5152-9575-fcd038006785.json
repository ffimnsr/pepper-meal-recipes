  "id": "ddd93809-8071-5152-9575-fcd038006785",
  "slug": "pumpkin-rice-pudding",
  "name": "Pumpkin Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Delicious for breakfast or dessert, this dish tastes like a combination of pumpkin pie and rice pudding with a smooth, custardy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring the water to a boil in a saucepan over high heat and add the rice. Reduce heat to medium-low and simmer, uncovered, for 7 minutes; drain well."
    },
    {
      "position": 2,
      "text": "Using the same saucepan, bring the milk to a boil over medium-high heat. Stir in the rice, vanilla bean, and salt. Reduce the heat to medium-low and simmer, stirring frequently, until the rice is very soft and absorbs most of the milk, 15 to 18 minutes. Remove the pan from the heat, discard the vanilla bean, and stir in the sugar."
    },
    {
      "position": 3,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 2 quart baking dish."
    },
    {
      "position": 4,
      "text": "Pour half of the rice pudding mixture into a large bowl. Add the pumpkin puree, ground cinnamon, ground ginger, and ground nutmeg. Spoon the pumpkin rice pudding into the prepared baking dish. Mix the raisins into the remaining rice pudding mixture, and spoon it over the pumpkin rice pudding."
    },
    {
      "position": 5,
      "text": "Bake, uncovered until firm, about 30 minutes. Serve warm, sprinkled with cinnamon if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

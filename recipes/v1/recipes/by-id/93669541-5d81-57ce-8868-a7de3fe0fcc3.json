  "id": "93669541-5d81-57ce-8868-a7de3fe0fcc3",
  "slug": "fish-chowder",
  "name": "Fish Chowder",
  "recipe_type": "soup",
  "brief_description": "This fish chowder recipe makes a rich and comforting soup with fresh cod, clam juice, potatoes, and crispy bacon in a delicious creamy broth.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large stockpot over medium heat. Sauté onions, mushrooms, and celery in butter until tender. Add chicken stock and potatoes; simmer for 10 minutes. Add fish; simmer for another 10 minutes."
    },
    {
      "position": 2,
      "text": "Mix together clam juice and flour in a small bowl until smooth; stir into soup and simmer for 1 minute. Season with Old Bay, salt, and pepper. Remove from heat and stir in evaporated milk."
    },
    {
      "position": 3,
      "text": "Portion into soup bowls and top with crumbled bacon."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,

  "id": "b0afd7ab-77a4-51df-9e87-c1bf0116e646",
  "slug": "quick-keto-chocolate-mousse",
  "name": "Quick Keto Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "This keto chocolate mousse is so easy to make. No need to whip the cream, just mix all ingredients together and satisfy your sweet craving in minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese in a large bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 2,
      "text": "Turn mixer to low speed and slowly mix in heavy cream and vanilla. Mix in sweetener, cocoa powder and salt until well incorporated. Turn mixer to high and mix until light and fluffy, 1 to 2 minutes more."
    },
    {
      "position": 3,
      "text": "Serve immediately, or refrigerate for later."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

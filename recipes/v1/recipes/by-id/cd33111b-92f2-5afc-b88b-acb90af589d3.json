  "slug": "hard-cranberry-limeade-recipe-8558931",
  "name": "Hard Cranberry Limeade",
  "recipe_type": "appetizer",
  "brief_description": "Hard cranberry limeade is made with cranberry vodka, lime vodka, and sprite, and has a flavor similar to the cranberry limeade from Sonic, but with vodka.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberry vodka and lime vodka in a tall glass. Add ice, top off with Sprite, and stir. Garnish with lime slice."
    }
  ],

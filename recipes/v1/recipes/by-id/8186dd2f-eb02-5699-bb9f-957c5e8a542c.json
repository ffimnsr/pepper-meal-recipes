  "id": "8186dd2f-eb02-5699-bb9f-957c5e8a542c",
  "slug": "stuffed-morel-mushrooms",
  "name": "Stuffed Morel Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for stuffed morel mushrooms includes a savory cream cheese and crab filling. The mushrooms are then baked for a tasty bite-sized appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Mince mushroom stems. Cut mushroom caps in half, lengthwise; place cut-sides up into prepared baking pan."
    },
    {
      "position": 3,
      "text": "Melt butter in a small skillet over medium heat. Add chopped mushroom stems, red bell pepper, and green onion; cook and stir until green onion is translucent, about 5 minutes. Remove from heat; allow to cool, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Mix cream cheese, crabmeat, celery leaves, egg, Worcestershire sauce, hot sauce, and sea salt together in a large bowl. Fold in cooled onion mixture. Place a dollop of crabmeat filling into each mushroom cap with a small spoon."
    },
    {
      "position": 5,
      "text": "Mix bread crumbs and Parmesan cheese together in a small bowl. Sprinkle on top of filled mushroom caps."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until filling is golden brown, 30 to 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

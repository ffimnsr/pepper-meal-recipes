  "id": "822bdd28-74dc-525f-95a0-e64ac3146d2b",
  "slug": "rosemary-dijon-prime-rib",
  "name": "Rosemary Dijon Prime Rib",
  "recipe_type": "main",
  "brief_description": "This simple yet elegant mouthwatering prime rib recipe delivers a tender, juicy roast every time. Impress everyone at your table with this show-stopper meal!",
  "cuisine": "American British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Make small cuts over the surface of the roast. Fill cuts with garlic slices. Generously salt the entire roast. Spread a thin layer of Dijon mustard over the entire roast. Generously sprinkle mustard coating with rosemary leaves. Place roast, bone-side-down, in a roasting pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes. Reduce oven temperature to 350 degrees F (175 degrees C). Place a meat thermometer in the thickest part of meat, not touching the bone. Cook to desired doneness, or until meat reaches 145 degrees F (65 degrees C) for medium, about 1 1/2 hours. Remove from the oven, cover with a doubled sheet of aluminum foil, and allow to rest in a warm area 10 to 15 minutes before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

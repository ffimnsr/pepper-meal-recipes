{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3ab20e38-7fc7-5b24-8c30-fdef33ed7ec1",
  "slug": "no-bake-lemon-ricotta-cheesecake-bars-recipe-11706597",
  "name": "No-Bake Lemon Ricotta Cheesecake Bars",
  "recipe_type": "dessert",
  "brief_description": "These no-bake lemon ricotta cheesecake bars get an extra creamy boost from the addition of ricotta cheese. Pistachios are used in the graham cracker crust, and as a garnish on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ricotta into a fine mesh strainer set over a bowl. Allow to drain for at least 1 hour before using."
    },
    {
      "position": 2,
      "text": "Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 3,
      "text": "For crust, combine butter, brown sugar, salt, and nutmeg in a microwave-safe bowl. Microwave, stopping to stir after every 30-second interval, until mixture begins to foam and bubble, and sugar is mostly dissolved; about 2 minutes. Stir in graham cracker crumbs, pistachios, and almond extract until evenly moistened."
    },
    {
      "position": 4,
      "text": "Press crust mixture very firmly and evenly into the bottom of the prepared pan. Freeze crust until chilled and set, about 20 minutes."
    },
    {
      "position": 5,
      "text": "For filling, combine drained ricotta and cream cheese in a large bowl. Beat with an electric mixer on medium speed until smooth and combined. Add in confectioner\u2019s sugar, lemon zest, lemon juice, vanilla, and salt and beat on medium speed until smooth and combined."
    },
    {
      "position": 6,
      "text": "Remove crust from freezer. Pour filling over crust and smooth into an even layer. Return pan to the freezer and chill until filling is set, at least 3 hours."
    },
    {
      "position": 7,
      "text": "To cut bars, remove from the pan using the parchment overhang, and place onto a cutting board. Run a sharp knife under hot water for several seconds, then wipe it dry. Cut bars with the hot knife, wiping it off between each cut and running it under hot water and drying again as needed. Sprinkle bars with chopped pistachios before serving."
    },
    {
      "position": 8,
      "text": "Keep bars stored in the freezer, but allow to sit at room temperature to soften for about 30 minutes before serving."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 25,

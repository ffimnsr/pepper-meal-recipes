  "id": "dbeee5eb-5e23-5fcf-ac34-43a6a9168af5",
  "slug": "basic-grilled-panini",
  "name": "Basic Grilled Panini",
  "recipe_type": "main",
  "brief_description": "A deliciously simple panini sandwich with gooey cheese, ham, tomato, and onion made in a grill pan. Experiment with your own favorite fillings.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Drizzle olive oil on 1 side of each bread slice. Spread 1 tablespoon mayonnaise on other side of each slice."
    },
    {
      "position": 2,
      "text": "Arrange layers of ham, Cheddar cheese, tomato, and onion on top. Top with other bread slice, mayonnaise-side down."
    },
    {
      "position": 3,
      "text": "Heat a grill pan over medium-high heat; spray lightly with cooking spray. Place sandwich on grill pan; weigh it down with a heavy pan. Cook until cheese is melted and grill marks appear, 3 to 5 minutes per side."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 10,

  "id": "048b5432-7780-5a3d-9c4a-c6df82877838",
  "slug": "antipasto-pasta-salad",
  "name": "Antipasto Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This antipasto pasta salad is perfect for parties, potlucks, and picnics! A delicious combo of pasta, meat, and cheese, it's hearty and so easy to make.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the salad: Bring a large pot of salted water to a boil. Add shell pasta and cook, stirring occasionally, until tender yet firm to the bite, about 9 minutes. Drain, run under cold water to cool pasta, and drain again."
    },
    {
      "position": 3,
      "text": "Transfer drained pasta to a large bowl. Add Asiago, salami, pepperoni, tomatoes, bell peppers, and olives. Sprinkle dry dressing mix over top and stir until ingredients are thoroughly mixed. Cover and refrigerate for at least 1 hour."
    },
    {
      "position": 4,
      "text": "Make the dressing: Whisk oil, vinegar, oregano, parsley, Parmesan, salt, and pepper together in a small bowl. Cover and set aside until ready to serve."
    },
    {
      "position": 5,
      "text": "When ready to serve, pour dressing over chilled salad and mix until well combined."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

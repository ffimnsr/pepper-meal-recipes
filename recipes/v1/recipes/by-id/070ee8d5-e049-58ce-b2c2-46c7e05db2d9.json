  "id": "070ee8d5-e049-58ce-b2c2-46c7e05db2d9",
  "slug": "teriyaki-steak-quesadillas-recipe-7972550",
  "name": "Teriyaki Steak Quesadillas",
  "recipe_type": "appetizer",
  "brief_description": "These teriyaki steak quesadillas are filled with teriyaki-marinated, saut\u00e9ed skirt steak, cheese, and broccoli.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Add soy sauce, mirin, sake, garlic, brown sugar, ginger, and Thai chili to the jar of a blender. Blend on high until smooth. Reserve 2 tablespoons marinade; pour remaining marinade into a resealable plastic bag."
    },
    {
      "position": 2,
      "text": "Add steak to the resealable bag, close the bag, and marinate in the refrigerator for at least 30 minutes or up to overnight."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Remove steak from the marinade, shake off excess, and cook and stir steak in the skillet until browned, about 5 minutes. Discard the remaining marinade."
    },
    {
      "position": 4,
      "text": "Meanwhile add broccoli to a microwave-safe steamer, and steam in the microwave until tender, about 3 minutes. Roughly chop the broccoli."
    },
    {
      "position": 5,
      "text": "Remove steak to a plate to keep warm, and drizzle with the 2 tablespoons reserved marinade. Rinse the skillet and dry with a paper towel. Place 1 tortilla in the skillet, and add a 1/8 portion each of cheese, steak pieces, broccoli, and bell pepper to tortilla. Fold tortilla in half. Press down with a spatula, and cook until tortilla begins to brown and cheese melts, about 3 minutes. Carefully turn quesadilla over; cook until browned on the other side, about 3 minutes more. Repeat with remaining ingredients."
    },
    {
      "position": 6,
      "text": "Cut quesadillas into wedges. Sprinkle with black sesame seeds and green onions; serve with Yum Yum sauce and teriyaki sauce, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,

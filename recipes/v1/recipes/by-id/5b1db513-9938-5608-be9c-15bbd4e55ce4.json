  "id": "5b1db513-9938-5608-be9c-15bbd4e55ce4",
  "slug": "vegan-pancakes",
  "name": "Vegan Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These vegan pancakes are light, fluffy, and delicious. The dairy-free batter is easy to make with pantry ingredients for perfect pancakes every time!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sift flour, sugar, baking powder, and salt into a large bowl; make a well in the center. Whisk together water and oil in a small bowl."
    },
    {
      "position": 2,
      "text": "Pour oil and water into flour mixture."
    },
    {
      "position": 3,
      "text": "Stir just until blended; mixture will be lumpy."
    },
    {
      "position": 4,
      "text": "Heat a lightly oiled griddle over medium-high heat."
    },
    {
      "position": 5,
      "text": "Drop batter by large spoonfuls onto the griddle. Cook until bubbles form and edges are dry. Flip, then cook until bottoms are browned, 1 to 2 minutes. Repeat with remaining batter."
    },
    {
      "position": 6,
      "text": "Serve with berries."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

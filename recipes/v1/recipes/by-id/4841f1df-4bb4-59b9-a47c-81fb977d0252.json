  "id": "4841f1df-4bb4-59b9-a47c-81fb977d0252",
  "slug": "baked-yam-fries-with-dip",
  "name": "Baked Yam Fries with Dip",
  "recipe_type": "dessert",
  "brief_description": "Oven-baked wedges of yam are served with a dip made with fat-free sour cream and seasoned with taco seasoning and paprika.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Spread the olive oil over a baking sheet."
    },
    {
      "position": 2,
      "text": "Arrange the yams on the prepared baking sheet in a single layer; season with the seasoned salt."
    },
    {
      "position": 3,
      "text": "Bake the yams in the preheated oven until soft, about 25 minutes."
    },
    {
      "position": 4,
      "text": "While the yams bake, stir the sour cream, mayonnaise, taco seasoning, and paprika together in a small bowl. Serve as a dip for the yams."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

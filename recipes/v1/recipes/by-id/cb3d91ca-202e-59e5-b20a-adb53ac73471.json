  "id": "cb3d91ca-202e-59e5-b20a-adb53ac73471",
  "slug": "resurrection-rolls",
  "name": "Resurrection Rolls",
  "recipe_type": null,
  "brief_description": "Resurrection rolls are made by wrapping marshmallows in crescent dough; as they bake, the rolls become empty, representing Jesus\u2019s tomb at Easter.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Separate crescent rolls into individual triangles."
    },
    {
      "position": 3,
      "text": "Mix sugar and cinnamon together in a small bowl."
    },
    {
      "position": 4,
      "text": "Dip a marshmallow into melted butter, then roll in sugar mixture. Place marshmallow into the center of a dough triangle; carefully wrap dough around marshmallow. Pinch the seams together tightly to seal in marshmallow as it melts. Place roll on a baking sheet; repeat with remaining dough and marshmallows."
    },
    {
      "position": 5,
      "text": "Bake rolls in the preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

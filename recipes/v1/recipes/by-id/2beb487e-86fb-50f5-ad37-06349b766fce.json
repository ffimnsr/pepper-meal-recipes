  "slug": "oreo-cookie-pie-crust-recipe-8774711",
  "name": "Oreo Cookie Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "This Oreo cookie pie crust is perfect for cheesecake, and unbelievably simple to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Add cookies to a food processor and grind into very fine crumbs."
    },
    {
      "position": 3,
      "text": "Pour crumbs into a bowl, then pour in melted butter. Mix with a fork until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Press mixture into the bottom of a 9-inch springform pan."
    }
  ],

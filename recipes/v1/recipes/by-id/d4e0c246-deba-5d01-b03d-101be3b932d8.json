  "id": "d4e0c246-deba-5d01-b03d-101be3b932d8",
  "slug": "caprese-plus",
  "name": "Caprese Plus",
  "recipe_type": "salad",
  "brief_description": "Avocado, olives, and artichokes are yummy additions to the basic tomato, basil, and fresh mozzarella layers that make up a Caprese salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Divide tomatoes, mozzarella, avocado, cucumber, green olives, artichoke hearts, and basil between two serving plates, layering them in that order. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil and balsamic vinegar over layers."
    }
  ],
  "servings": 2,

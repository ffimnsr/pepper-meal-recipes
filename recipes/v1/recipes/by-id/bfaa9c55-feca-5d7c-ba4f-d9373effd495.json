  "id": "bfaa9c55-feca-5d7c-ba4f-d9373effd495",
  "slug": "the-brutus-salad",
  "name": "The Brutus Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John's Brutus salad, featuring crisp romaine lettuce, apples, Cheddar, herbs, and toasted pecans, tossed in a Dijon vinaigrette, tastes amazing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mustard, vinegar, oil, Worcestershire sauce, cayenne, and pepper together in a bowl until thoroughly blended, about 1 minute. Transfer to an easy-to-pour container."
    },
    {
      "position": 2,
      "text": "Toast the pecans: Place pecans into a skillet over medium heat and drizzle in 2 teaspoons oil. Cook and stir until pecans smell toasty and have darkened slightly, 1 to 2 minutes. Sprinkle with sugar and salt. Cook and stir for 1 minute, then transfer to a plate to cool."
    },
    {
      "position": 3,
      "text": "Make the salad: Add romaine, apple slices, dill, and tarragon to a large bowl; add a handful of pecans, reserving some for garnish. Grate Cheddar on top, reserving some for garnish. Drizzle in some vinaigrette; toss. Taste; add more salt or vinaigrette, if desired. You may not need all of the vinaigrette."
    },
    {
      "position": 4,
      "text": "Garnish with a few toasted pecans and some grated Cheddar cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

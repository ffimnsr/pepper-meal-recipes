  "id": "21cc422e-e63f-560b-a73e-44e4b6a52ba3",
  "slug": "hatch-chile-salsa",
  "name": "Hatch Chile Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This Hatch chile salsa recipe blends roasted chile peppers with tomatoes, onion, and cilantro for an intensely flavored salsa \u2014 perfect party fare.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Arrange chile peppers on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Cook under the preheated broiler until pepper skins blackened and blistered, 5 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Transfer chile peppers to a bowl; tightly seal with plastic wrap and steam until cool, about 20 minutes. Remove and discard chile pepper skins."
    },
    {
      "position": 5,
      "text": "Combine chile peppers, diced tomatoes, diced tomatoes with roasted garlic, onion, cilantro, and garlic powder in the bowl of a food processor or blender; pulse until reaches desired consistency."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

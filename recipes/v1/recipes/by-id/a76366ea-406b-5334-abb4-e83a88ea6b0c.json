  "id": "a76366ea-406b-5334-abb4-e83a88ea6b0c",
  "slug": "saffron-risotto-in-the-pressure-cooker",
  "name": "Saffron Risotto in the Pressure Cooker",
  "recipe_type": "side",
  "brief_description": "Saffron risotto is a classic Italian dish also known as 'risotto alla Milanese' and is considered by many to be the king of risottos. Making it in the pressure cooker cuts down cooking time.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Soak saffron threads in hot water in a bowl."
    },
    {
      "position": 2,
      "text": "Melt 2 1/2 tablespoons butter in a pressure cooker over low heat. Cook and stir shallot until soft, about 3 minutes. Add rice; cook and stir for a few minutes until rice has absorbed butter and is toasted, about 3 minutes. Pour in wine and allow alcohol to cook off, about 1 minute. Add boiling stock all at once and stir. Close cooker securely and place pressure regulator over vent according to manufacturer's instructions. Increase heat to high. Heat until steam escapes in a steady flow and makes a whistling sound. Reduce heat to low and cook for 4 minutes."
    },
    {
      "position": 3,
      "text": "Remove cooker from heat and release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Carefully open once pressure is completely released and stir well. Stir in saffron, remaining 1 1/2 tablespoon butter, Parmesan cheese, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Let risotto rest for 3 minutes in order to expand, soak up the stock, and absorb flavor. Serve in warmed bowls with extra grated Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

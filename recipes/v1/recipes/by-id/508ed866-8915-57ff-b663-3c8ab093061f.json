  "id": "508ed866-8915-57ff-b663-3c8ab093061f",
  "slug": "chicken-alfredo-soup-recipe-11865458",
  "name": "Chicken Alfredo Soup",
  "recipe_type": "soup",
  "brief_description": "Chicken alfredo soup is a very flavorful take on regular chicken noodle soup! It comes out thick and creamy, and Parmesan cheese adds a nice flavor. Think comfort in a bowl",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large (6-quart) stockpot over medium heat. Add onion. Cook and stir until softened, about 5 minutes. Add garlic and cook for 1 minute."
    },
    {
      "position": 3,
      "text": "Sprinkle flour over onion mixture; cook and stir for 1 minute. Gradually whisk in chicken broth until smooth. Stir in half-and-half, Italian seasoning, salt, and pepper. Bring to a boil."
    },
    {
      "position": 4,
      "text": "Add egg noodles and cook until al dente, stirring occasionally so the noodles do not stick together, about 5 minutes. (If using fettuccine, cook about 8 minutes.)"
    },
    {
      "position": 5,
      "text": "Stir in broccoli florets and cook until crisp-tender, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Add chicken and Parmesan cheese; cook until heated through, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Ladle soup into bowls. Garnish with parsley and serve with additional Parmesan cheese. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "old-bay-seasoned-steamed-shrimp",
  "name": "Old Bay-Seasoned Steamed Shrimp",
  "recipe_type": "appetizer",
  "brief_description": "Steamed shrimp flavored with Old Bay seasoning is perfect for a quick and easy dinner or appetizer, loaded with peppery and smoky flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, vinegar, and seafood seasoning to a boil in a saucepan over high heat. Add shrimp and stir."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium, cover, and steam, stirring once or twice, until bright orange in color, 3 to 5 minutes. Drain."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

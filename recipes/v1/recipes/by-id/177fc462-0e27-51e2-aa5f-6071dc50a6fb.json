  "id": "177fc462-0e27-51e2-aa5f-6071dc50a6fb",
  "slug": "chewiest-brownies",
  "name": "Chewiest Brownies",
  "recipe_type": "dessert",
  "brief_description": "Looking for the best chewy brownie recipe? These deliciously rich, fudgy, chocolaty brownies are irresistible and incredibly easy to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a 9x13-inch pan with greased parchment paper."
    },
    {
      "position": 2,
      "text": "Place sugar, cocoa, flour, melted butter, eggs, vanilla, and salt in a large bowl. Mix until well combined; it will be thick and sticky. Spread brownie batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes. Cool completely; cut into squares and dust with confectioners\u2019 sugar."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

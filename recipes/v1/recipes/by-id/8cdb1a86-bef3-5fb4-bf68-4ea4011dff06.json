  "schema_version": 1,
  "id": "8cdb1a86-bef3-5fb4-bf68-4ea4011dff06",
  "slug": "potato-klubb-norwegian-potato-dumplings",
  "name": "Potato Klubb (Norwegian Potato Dumplings)",
  "recipe_type": "main",
  "brief_description": "Potato dumplings stuffed with a cube of ham are a specialty of the Trondelag region around Trondheim, Norway. Also enjoyed by many Norwegian-American families, the dumplings are boiled and traditionally served whole with melted butter, crispy bacon pieces, and stewed peas, or sliced and fried.",
  "cuisine": "Norwegian Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix the flour, 1/2 teaspoon salt, baking powder, and pepper together in a bowl. Place the potatoes and onion in a large bowl, and stir in the flour mixture until thoroughly blended. Use floured hands to knead the potato mixture in the bowl until it takes on the quality of stiff bread dough. Add additional flour if the dough is too sticky."
    },
    {
      "position": 2,
      "text": "Pinch off a tennis ball-sized piece of dough and shape it around a cube of ham, completely covering the ham, to form a ball. Repeat with remaining dough and ham cubes. Set aside any extra ham."
    },
    {
      "position": 3,
      "text": "Fill a large pot with water, add 2 teaspoons salt and any extra ham, and bring to a boil over medium-high heat. Carefully slide the balls into the boiling water, a few at a time. Loosen any sticking to the bottom of the pot. Simmer for 45 minutes to 1 hour. Remove with a slotted spoon, and drain on a plate. Serve hot with melted butter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

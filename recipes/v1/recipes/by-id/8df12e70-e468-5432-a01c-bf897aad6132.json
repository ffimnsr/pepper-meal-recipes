  "schema_version": 1,
  "id": "8df12e70-e468-5432-a01c-bf897aad6132",
  "slug": "stick-of-butter-smothered-pork-chops-recipe-11783445",
  "name": "Stick of Butter Smothered Pork Chops",
  "recipe_type": "main",
  "brief_description": "This stick of butter smothered pork chop casserole is a rich, creamy dish of rice baked under seasoned pork chops that only takes minutes to assemble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Pour rice into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Add French onion soup, chicken broth, and Worcestershire; stir to combine. Top with butter slices."
    },
    {
      "position": 3,
      "text": "Season both sides of pork chops with salt, pepper, garlic powder, and paprika and place on top of rice mixture."
    },
    {
      "position": 4,
      "text": "Stir sliced onion and mushroom soup together in a medium bowl. Fill soup can with water and stir into onion mixture. Pour mixture over pork chops and cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 40 to 45 minutes. Uncover and, if necessary, gently stir any uncooked rice under or around pork into remaining rice mixture. Continue to bake until pork is no longer pink at the center and onion mixture is lightly browned, about 20 minutes more. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Sprinkle with chopped parsley before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

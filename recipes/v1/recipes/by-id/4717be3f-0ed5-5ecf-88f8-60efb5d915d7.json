  "id": "4717be3f-0ed5-5ecf-88f8-60efb5d915d7",
  "slug": "quick-potato-nachos",
  "name": "Quick Potato Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These potato nachos are a tasty twist on traditional nachos, made with crispy potato wedges topped with cheese, beans, and your favorite fixings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine potatoes, oil, Mexican seasoning, and garlic salt together in a bowl; stir to coat potatoes completely. Spread potatoes in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring occasionally, until potatoes are crisp and golden brown, 25 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Transfer potatoes to a plate and top with Mexican cheese blend, black beans, diced tomatoes, black olives, green onions, and green chiles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

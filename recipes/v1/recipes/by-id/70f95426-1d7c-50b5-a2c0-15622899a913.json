  "id": "70f95426-1d7c-50b5-a2c0-15622899a913",
  "slug": "ceviche-self-portrait",
  "name": "Ceviche Self-Portrait",
  "recipe_type": "appetizer",
  "brief_description": "A delicious shrimp ceviche recipe that only gets better over night! Bright and refreshing, with the uncommon addition of cucumber. Adjust the heat to your personal taste with a sprinkling of hot pepper sauce.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Dice shrimp and place in a mixing bowl. Squeeze lime juice over shrimp until they are completely covered, about 4 limes. Stir in the tomatoes, onion, cucumber, serrano peppers, and salt and pepper. Cover, and refrigerate 1 hour."
    },
    {
      "position": 2,
      "text": "When ready to serve, adjust seasoning with salt and pepper as needed. Serve on top of tostada shells with a splash of hot sauce, if desired."
    }
  ],
  "servings": 6,

  "id": "6b1d4a23-ec55-5b1e-bff4-0c0718f8891b",
  "slug": "sheet-pan-sweet-potato-orange-breakfast-tacos-recipe-11775467",
  "name": "Sheet Pan Sweet Potato-Orange Breakfast Tacos",
  "recipe_type": "dessert",
  "brief_description": "In these sheet pan sweet pototo-orange breakfast tacos, fresh orange brightens vegetarian tacos that will power you through the a.m. hustle and bustle. Skip the cotija cheese to make these vegan friendly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 10x15-inch rimmed sheet pan with parchment paper or foil. Juice 1 orange half (about 2 tablespoons). If you like, slice the remaining half and reserve for serving."
    },
    {
      "position": 2,
      "text": "Whisk together orange juice, agave nectar, oil, salt, paprika, black pepper, cumin, cinnamon, and cayenne in a large bowl. Add beans, sweet potato, and Fresno pepper; toss to combine. Spread on prepared sheet pan."
    },
    {
      "position": 3,
      "text": "Roast until sweet potatoes are tender, stirring halfway through, about 30 minutes. (To make ahead, chill sweet potato mixture for up to 4 days. Reheat before using in Step 4.)"
    },
    {
      "position": 4,
      "text": "Working quickly, run each tortilla under running water to wet on all sides. Arrange tortillas evenly over sweet potato mixture. Roast, turning tortillas halfway through, until warmed through, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Spoon sweet potato mixture into tortillas. Top with avocado. Serve with reserved orange slices and cotija."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

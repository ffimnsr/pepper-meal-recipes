  "id": "7ca8e19a-47b8-54d4-97ca-9c350e78e5fd",
  "slug": "lamb-meatballs-and-sauce",
  "name": "Lamb Meatballs and Sauce",
  "recipe_type": "main",
  "brief_description": "These juicy baked lamb meatballs from Chef John are made with ground lamb, garlic, and herbs simmered in a rich tomato sauce full of Mediterranean flavors.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil; lightly grease with oil."
    },
    {
      "position": 2,
      "text": "Combine bread crumbs and milk in a small bowl; soak until bread crumbs absorb milk, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Combine bread crumb mixture, lamb, egg, garlic, 2 tablespoons olive oil, tomato paste, rosemary, cumin, salt, oregano, black pepper, cinnamon, and cayenne pepper in a large bowl."
    },
    {
      "position": 4,
      "text": "Form lamb mixture into 2-inch meatballs; place on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven until slightly browned, about 15 minutes. Remove from oven; set aside."
    },
    {
      "position": 6,
      "text": "Combine meatballs, tomato sauce, chicken stock, mint, and pepper flakes in a large saucepan over medium heat until meatballs are no longer pink inside, about 45 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "1b0c7e40-136c-5141-bbe6-1904017c956b",
  "slug": "chocolate-chip-pumpkin-bread",
  "name": "Chocolate Chip Pumpkin Bread",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin chocolate chip bread is loaded with sweet mini chocolate chips and chopped walnuts; cinnamon and nutmeg add even more fall flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9x5-inch loaf pans or three empty 16-ounce coffee tins."
    },
    {
      "position": 2,
      "text": "Combine sugar, pumpkin, eggs, oil, and water in a large bowl. Beat with an electric mixer until smooth. Blend in flour, cinnamon, nutmeg, baking soda, and salt."
    },
    {
      "position": 3,
      "text": "Fold in chocolate chips and nuts."
    },
    {
      "position": 4,
      "text": "Evenly divide batter between the prepared pans, filling each 1/2 to 3/4 full."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 1 hour."
    },
    {
      "position": 6,
      "text": "Cool in pans on wire racks before removing to slice and serve. Enjoy!"
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

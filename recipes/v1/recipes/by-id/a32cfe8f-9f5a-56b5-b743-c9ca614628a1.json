  "id": "a32cfe8f-9f5a-56b5-b743-c9ca614628a1",
  "slug": "pork-chops-in-dijon-mustard-cream-sauce-recipe-11994274",
  "name": "Pork Chops in Dijon Mustard Cream Sauce",
  "recipe_type": "main",
  "brief_description": "These juicy seared pork chops are simmered in a Dijon cream sauce infused with fresh rosemary, then finished with a bright panko gremolata of parsley, garlic, and lemon zest for a rich, vibrant dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat pork chops dry. Season both sides with salt, pepper, and garlic powder."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-high heat. Do not overcrowd the pan. Sear pork chops until golden, 3 to 4 minutes per side. Transfer to a plate."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium. Add butter and shallots. Cook until softened, about 2 minutes. Add garlic and rosemary. Cook until fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Pour in chicken bone broth and scrape up browned bits. Stir in cream and Dijon mustard. Simmer until slightly thickened, 3 to 4 minutes. Stir in Parmesan, lemon zest, and lemon juice."
    },
    {
      "position": 5,
      "text": "Return pork chops and juices to the skillet. Simmer gently until pork is no longer pink at the center, 5 to 7 minutes. An instant read thermometer inserted near the center of chops should reach 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "For gremolata, stir parsley, garlic, and lemon zest together in a small bowl."
    },
    {
      "position": 7,
      "text": "For panko topping, sprinkle panko with salt, toast panko in butter in a skillet over medium heat until golden brown, about 3 minutes."
    },
    {
      "position": 8,
      "text": "To serve, top pork chops with cream sauce, gremolata, and toasted panko just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,

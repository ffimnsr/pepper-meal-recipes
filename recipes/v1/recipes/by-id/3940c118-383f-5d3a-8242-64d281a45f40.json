  "id": "3940c118-383f-5d3a-8242-64d281a45f40",
  "slug": "truffle-deviled-eggs-recipe-8739284",
  "name": "Truffle Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Truffle deviled eggs offer a luxurious twist on a classic appetizer, combining a smooth blend of mashed yolks, mayonnaise, a touch of Dijon mustard, and truffle oil for that unmistakable umami flavor. These elegant bites deliver a sophisticated flavor in every bite, perfect for special occasions or gourmet entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Halve eggs lengthwise and scoop egg yolks into the bowl of a mini food processor; set egg whites aside. If you do not have a mini food processor, you can mash all ingredients in a bowl with a fork."
    },
    {
      "position": 2,
      "text": "Add mayonnaise, Dijon mustard, truffle oil, salt, and pepper to the egg yolks; blend well until smooth, scraping down the sides of the bowl. If mixture is too thick, blend in an extra teaspoon or two of mayonnaise."
    },
    {
      "position": 3,
      "text": "Place yolk mixture into a resealable bag and snip off a corner. Pipe mixture into egg whites. Top with chives and shaved truffle, and refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

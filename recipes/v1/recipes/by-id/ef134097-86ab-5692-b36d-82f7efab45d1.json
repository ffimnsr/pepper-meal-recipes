  "id": "ef134097-86ab-5692-b36d-82f7efab45d1",
  "slug": "best-baked-french-fries",
  "name": "Best Baked French Fries",
  "recipe_type": "appetizer",
  "brief_description": "The best baked French fries are deliciously crispy, golden, and garlicky \u2014 you won't be able to resist! Double the recipe if you're feeding a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil; spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Place sliced potatoes in a colander; sprinkle sugar over potatoes. Set aside until liquid is released from potatoes, 20 to 30 minutes. Drain liquid and dry potatoes well."
    },
    {
      "position": 3,
      "text": "Mix potato slices, olive oil, garlic powder, salt, and black pepper in a resealable plastic bag until evenly coated. Spread coated potato slices in a single layer, leaving space around each potato, on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes; flip fries and continue baking until crisp and browned, about 20 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

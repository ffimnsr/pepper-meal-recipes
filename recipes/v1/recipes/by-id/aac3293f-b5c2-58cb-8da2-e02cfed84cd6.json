{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "aac3293f-b5c2-58cb-8da2-e02cfed84cd6",
  "slug": "spice-rubbed-chicken-leg-quarters",
  "name": "Spice-Rubbed Chicken Leg Quarters",
  "recipe_type": "main",
  "brief_description": "Brined chicken gets the full dry-rub treatment with a homemade BBQ rub that adds even more flavor than barbecue sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix water, sugar, salt, and vinegar for brine in a food-grade, nonreactive container."
    },
    {
      "position": 2,
      "text": "Rinse chicken and pat dry. Place it in the brine, cover, and let sit for 2 hours."
    },
    {
      "position": 3,
      "text": "Mix brown sugar, paprika, chile powder, salt, pepper, garlic powder, onion powder, cayenne, cumin, and nutmeg for dry rub together in a small bowl."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking dish with foil."
    },
    {
      "position": 5,
      "text": "Remove chicken from the brine and pat dry. Place it on a tray and generously sprinkle dry rub all over each piece, rubbing it into the skin and meat. (You will have some dry rub remaining.)"
    },
    {
      "position": 6,
      "text": "Place chicken, skin-side down, in the prepared baking dish,. Cover with foil, making sure not to wrap it too tightly."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 1 hour. Remove from the oven. Increase the temperature to 450 degrees F (230 degrees C)."
    },
    {
      "position": 8,
      "text": "Remove the foil cover and turn chicken over. Sprinkle more dry rub onto the skin and return to the oven."
    },
    {
      "position": 9,
      "text": "Bake until skin is crispy, chicken is no longer pink in the center, and the juices run clear, about 20 more minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,

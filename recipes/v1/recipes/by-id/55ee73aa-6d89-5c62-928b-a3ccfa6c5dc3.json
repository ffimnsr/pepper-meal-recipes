  "id": "55ee73aa-6d89-5c62-928b-a3ccfa6c5dc3",
  "slug": "mixed-vegetable-curry-recipe-8737107",
  "name": "Mixed Vegetable Curry",
  "recipe_type": "side",
  "brief_description": "This mixed vegetable curry will add color, flavor, and a little heat to your plate, a suitable side dish for your homemade butter chicken, or tikka masala. Add a side of rice and some naan to round out the menu.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat ghee in a large, nonstick pan over medium heat. Add onion and cook, stirring, until lightly brown, about 8 minutes. Add garlic and ginger and cook, stirring, until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Add tomato, serrano pepper, carrots, peas, potato, turmeric, coriander, cumin, fenugreek, chili powder, and salt, and cook, stirring, for about 5 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low, cover, and let vegetables steam in their own juices until potatoes are fork tender, about 25 minutes. Stir about halfway through cooking time, and make sure the pan isn't too dry. If vegetables are sticking, add 1 or 2 tablespoons water, replace the lid, and continue cooking. Taste; season with salt."
    },
    {
      "position": 4,
      "text": "Garnish with chopped cilantro. Serve warm, with naan, or similar flatbread."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

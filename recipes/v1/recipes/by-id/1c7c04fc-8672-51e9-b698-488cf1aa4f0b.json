  "slug": "spiced-chai-overnight-oats",
  "name": "Spiced Chai Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These low-calorie overnight oats with apple butter and chai tea have no added sugars and can be made ahead for a grab-and-go breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine rolled oats, chai tea, almond milk, and apple butter in a jar or bowl."
    },
    {
      "position": 2,
      "text": "Refrigerate until oats are soft, 2 hours to overnight. Stir before eating."
    }
  ],

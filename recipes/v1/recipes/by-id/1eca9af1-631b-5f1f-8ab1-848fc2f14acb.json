  "id": "1eca9af1-631b-5f1f-8ab1-848fc2f14acb",
  "slug": "easy-pan-fried-zucchini",
  "name": "Easy Pan-Fried Zucchini",
  "recipe_type": "appetizer",
  "brief_description": "Pan-fried zucchini slices flavored with garlic and coated with bread crumbs are a deliciously crispy summer vegetarian side dish, snack, or appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rub zucchini slices with garlic; set aside."
    },
    {
      "position": 2,
      "text": "Place beaten egg, flour, and bread crumbs separately into 3 small bowls."
    },
    {
      "position": 3,
      "text": "Turn zucchini slices in flour, dusting off excess. Dip in egg, then press in bread crumbs to coat."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large skillet over medium-high heat and pan-fry breaded zucchini in batches in hot oil until lightly browned on both sides, about 5 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "fe530d2e-a756-5b96-baa7-39dd125ed3d0",
  "slug": "pierogi-sausage-sheet-pan-dinner-recipe-11834101",
  "name": "Pierogi Sausage Sheet Pan Dinner",
  "recipe_type": "main",
  "brief_description": "Thie pierogi sausage sheet pan dinner combines tender cabbage with kielbasa and frozen purchased pierogi on a sheet pan. Just the right seasonings and a drizzle of a quick vinaigrette and you have the perfect comfort food dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place cabbage, onion, and oil in a large bowl; toss until well combined. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Spread cabbage onto a baking sheet in an even layer. Distribute sausage and pierogies evenly over cabbage. Season with paprika and Cajun seasoning."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Remove from the oven and carefully toss ingredients. Return to the oven and bake until sausage begins to brown, 20 to 30 minutes more."
    },
    {
      "position": 5,
      "text": "Whisk together red wine vinegar, whole grain mustard, and honey together in a small bowl; drizzle over contents of the sheet pan before serving."
    },
    {
      "position": 6,
      "text": "Garnish with fresh parsley and dill. Serve with sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

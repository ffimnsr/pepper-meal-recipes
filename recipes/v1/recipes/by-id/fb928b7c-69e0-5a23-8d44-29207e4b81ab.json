  "id": "fb928b7c-69e0-5a23-8d44-29207e4b81ab",
  "slug": "garlic-and-rosemary-lamb-chops-recipe-11984219",
  "name": "Garlic and Rosemary Lamb Chops",
  "recipe_type": "main",
  "brief_description": "This recipe for garlic and rosemary lamb chops is one of those recipes that hits every time\u2014simple, flavorful, and all about letting the lamb shine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Start by cleaning your rack of lamb: Trim off any excess fat and remove the membrane if needed. Using a knife, poke small holes all over the lamb. Insert garlic pieces into these holes."
    },
    {
      "position": 2,
      "text": "Transfer the lamb to a roasting pan bone-side down. Drizzle with olive oil and season generously with salt, pepper, and garlic powder. Top with fresh rosemary sprigs, cover, and allow to marinate overnight in the refrigerator."
    },
    {
      "position": 3,
      "text": "The next day, remove lamb from the refrigerator and allow to sit at room temperature for about 30 minutes"
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Roast marinated lamb in the preheated oven until an instant-read thermometer inserted in the center of the meat reads 120 to 125 degrees F (48 to 51 degrees C), 20 to 30 minutes total ."
    },
    {
      "position": 6,
      "text": "Remove from the oven and using a sprig of fresh rosemary, baste the lamb with melted garlic butter. Return to the oven and continue roasting until the meat reaches an internal temperature of 130 degrees F (55 degrees C) for medium-rare, 5 to 10 minutes more."
    },
    {
      "position": 7,
      "text": "Remove from the oven and let rack of lamb rest for 10 minutes, then slice between each bone for clean chops."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

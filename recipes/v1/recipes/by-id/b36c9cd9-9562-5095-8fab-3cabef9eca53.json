{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b36c9cd9-9562-5095-8fab-3cabef9eca53",
  "slug": "rabo-encendido-cuban-oxtail-stew",
  "name": "Rabo Encendido (Cuban Oxtail Stew)",
  "recipe_type": "soup",
  "brief_description": "Oxtail is simmered in a savory tomato-based stew until it is falling off the bone in this recipe for Rabo Encendido, a hearty Cuban dish.",
  "cuisine": "Cuban",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk vino seco, 1/4 cup olive oil, and salt together in a large bowl. Add oxtails and mix well to coat. Cover with plastic wrap and marinate in the refrigerator for 12 hours."
    },
    {
      "position": 2,
      "text": "Drain oxtails, discarding all but 1/2 cup of the marinade."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon olive oil in a large pot over medium-high heat and sear oxtails until browned on all sides, about 2 minutes per side. Transfer to a large plate. Heat remaining 1 tablespoon olive oil in the same pot. Saute potatoes, onion, and carrots until onions are translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Mash garlic and 1/2 teaspoon salt into a coarse paste in a mortar and pestle. Add garlic paste to the pot; stir until fragrant, about 30 seconds. Stir in green olives, bay leaves, sazon completa, sazon seasoning, and allspice. Pour in reserved marinade, tomato sauce, and chicken broth."
    },
    {
      "position": 5,
      "text": "Return oxtails to the pot. Bring to a boil, reduce heat, and simmer, covered, until oxtails are fork tender and falling off the bone, about 4 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 254,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "54966b20-fb26-52d0-bca2-feabc2f29b5f",
  "slug": "peanut-blossoms-ii",
  "name": "Peanut Butter Blossoms",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter blossoms are baked for just 10 minutes then topped with a chocolate kiss for a crowd-pleasing treat perfect for holiday cookie trays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease or line cookie sheets."
    },
    {
      "position": 3,
      "text": "Beat shortening, peanut butter, brown sugar, and 1 cup white sugar together in a large bowl with an electric mixer until smooth."
    },
    {
      "position": 4,
      "text": "Beat in eggs one at a time, then stir in milk and vanilla."
    },
    {
      "position": 5,
      "text": "Combine flour, baking soda, and salt; stir into peanut butter mixture until well blended."
    },
    {
      "position": 6,
      "text": "Shape spoonfuls of dough into balls and roll in remaining 1/2 cup white sugar. Place cookies 2 inches apart on the prepared cookie sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 10 to 12 minutes. Remove from the oven and immediately press a chocolate kiss into each cookie."
    },
    {
      "position": 8,
      "text": "Allow to cool completely; the kiss will harden as it cools."
    }
  ],
  "servings": 84,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "70204430-596e-5e52-868a-92dba964f105",
  "slug": "liquor-infused-irish-soda-bread",
  "name": "Liquor-Infused Irish Soda Bread",
  "recipe_type": null,
  "brief_description": "A hearty dose of Bailey's\u00ae Irish cream liqueur takes this soda bread recipe to a whole new level.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking powder, baking soda, and salt together in a large bowl; add softened butter and mix until evenly moistened."
    },
    {
      "position": 3,
      "text": "Make a well in the center of the flour mixture. Pour 1 cup buttermilk, egg, and 1/4 cup Irish cream liqueur into the well; add raisins to the buttermilk mixture. Knead mixture until raisins are spread throughout the dough. Form dough into a disk and cut an 'X' into the top of the dough; place onto prepared baking sheet and set aside."
    },
    {
      "position": 4,
      "text": "Melt butter in a small saucepan over medium-low heat. Stir 1/4 cup buttermilk and 1/4 cup Irish cream liqueur into the melted butter until smooth; remove from heat and generously brush liquid over the dough."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven, brushing liquid onto loaf every 15 minutes, until no longer doughy in the center, about 45 minutes. Let bread cool on pan for 10 minutes before moving to a cooking rack to cool completely."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

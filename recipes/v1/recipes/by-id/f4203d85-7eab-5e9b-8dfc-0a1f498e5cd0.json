  "id": "f4203d85-7eab-5e9b-8dfc-0a1f498e5cd0",
  "slug": "creamy-tuscan-ravioli-recipe-11937496",
  "name": "Creamy Tuscan Ravioli",
  "recipe_type": "main",
  "brief_description": "This creamy Tuscan ravioli has both fire roasted and sun-dried tomatoes in a creamy cheese sauce with Italian sausage. Delicate 4-cheese ravioli is added in the last few minutes of cooking time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ravioli on the counter to thaw completely, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Heat a heavy skillet or Dutch oven over medium heat. Add Italian sausage and cook until no longer pink, 5 to 10 minutes. Remove sausage from skillet and set aside."
    },
    {
      "position": 3,
      "text": "Add up to 1/2 tablespoon olive oil to the same skillet if needed, and scrape up the brown bits. Add onions, garlic, and 1/2 tablespoon Italian seasoning. Stir and cook for 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Add fire roasted tomatoes and sun-dried tomatoes and stir. Cook 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir in chicken broth and heavy cream. Add parmesan cheese and stir well. Allow to simmer and thicken for 2 to 3 minutes. If the sauce is too thick, add a little more chicken broth."
    },
    {
      "position": 6,
      "text": "Add Italian sausage and spinach; combine well. Add ravioli. Use a spoon to cover each ravioli with cream sauce. Turn heat to low, cover, and allow to simmer for 3 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b3b365ee-10b4-5426-ab6b-ce89e03224dc",
  "slug": "skinny-girl-individual-omelets",
  "name": "Skinny Girl Individual Omelets",
  "recipe_type": "breakfast",
  "brief_description": "Omelets made in a muffin tin with egg substitute, spinach, and Cheddar cheese are a skinny, grab-and-go breakfast the whole family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray 12 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix egg substitute, spinach, bell peppers, Cheddar cheese, salt, and black pepper together in a bowl; spoon into the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tops begin to turn golden brown, about 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

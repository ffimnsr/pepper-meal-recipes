  "id": "5dfe5bb8-0410-5894-8e4e-e4fdbbab1e75",
  "slug": "blushing-applesauce",
  "name": "Blushing Applesauce",
  "recipe_type": "side",
  "brief_description": "This homemade blushing applesauce recipe has a beautiful pale pink tone from cooking the apples with their skins on. The skins add subtle flavor, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place apples, sugar, water, and lemon juice in a large pot; bring to a boil, then reduce heat to medium-low, and simmer, uncovered, stirring occasionally, until apples are very soft and lose their shape, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Remove the pot from the heat; cool apples slightly. Transfer apples to the bowl of a food processor or a food mill; pur\u00e9e. If using a food processor, strain apples through a sieve to remove skins. Transfer applesauce to a large bowl."
    },
    {
      "position": 3,
      "text": "Stir cinnamon and nutmeg into applesauce. Serve at room temperature or refrigerate and serve cold."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,

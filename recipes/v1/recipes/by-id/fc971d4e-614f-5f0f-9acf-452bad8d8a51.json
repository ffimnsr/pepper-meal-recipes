  "id": "fc971d4e-614f-5f0f-9acf-452bad8d8a51",
  "slug": "high-protein-banana-bread",
  "name": "High-Protein Banana Bread",
  "recipe_type": "dessert",
  "brief_description": "This high protein banana bread made with chocolate protein powder and oat flour is perfect for a quick breakfast or afternoon snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x5-inch loaf pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix together oat flour, sugar, walnuts, protein powder, cinnamon, baking powder, and baking soda in a medium bowl."
    },
    {
      "position": 3,
      "text": "Mix together mashed bananas, applesauce, milk, egg whites, and vanilla extract in a large bowl. Slowly add flour mixture to banana mixture; stirring until just combined. Transfer batter into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top of bread springs back when lightly pressed and a toothpick inserted into the center comes out clean, 35 to 40 minutes. Cool in the pan for 10 minutes. Transfer to a wire rack to cool completely."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

  "id": "7fc6f96d-4e57-53f7-bada-92e78430e408",
  "slug": "chicken-ramen-soup",
  "name": "Chicken Ramen Soup",
  "recipe_type": "soup",
  "brief_description": "Kick those instant ramen noodles up a notch by serving them with a delicious homemade chicken soup made with rotisserie chicken.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a soup pot over medium heat. Add celery and carrots and season with salt and pepper. Cook until softened, about 10 minutes. Add garlic and ginger paste and cook until fragrant, about 1 minute. Add chicken stock and bring to a boil."
    },
    {
      "position": 2,
      "text": "Add chicken and soy sauce and simmer for 1 hour."
    },
    {
      "position": 3,
      "text": "Bring a large pot of water to a boil. Add ramen and cook, stirring occasionally, until tender yet firm to the bite, 2 to 3 minutes. Drain."
    },
    {
      "position": 4,
      "text": "To serve, ladle ramen into soup bowls, then ladle chicken soup over top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

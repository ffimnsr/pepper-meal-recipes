  "id": "4e3a04f6-f40a-57d7-980d-2e647545d585",
  "slug": "rainbow-rotini-salad",
  "name": "Rainbow Rotini Salad",
  "recipe_type": "salad",
  "brief_description": "This colorful rotini pasta salad is bursting with tomatoes, peppers, broccoli, and mushrooms, tossed with your favorite Italian-style salad dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 to 10 minutes. Drain and rinse in cold water."
    },
    {
      "position": 2,
      "text": "Combine cooked pasta, tomatoes, green bell pepper, onion, cucumber, broccoli, mushrooms, and olives in a large bowl. Add Italian salad dressing; toss to coat."
    }
  ],

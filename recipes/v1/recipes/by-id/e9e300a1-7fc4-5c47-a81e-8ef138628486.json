  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e9e300a1-7fc4-5c47-a81e-8ef138628486",
  "slug": "enchiladas-suizas",
  "name": "Enchiladas Suizas",
  "recipe_type": "main",
  "brief_description": "Enchiladas suizas are Swiss-style enchiladas filled with shredded chicken and cheese, baked in a creamy sauce made with heavy cream and salsa verde.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Make the salsa verde: Melt butter in a skillet over medium heat. Add onion and saut\u00e9 until soft, about 5 minutes. Add flour and stir until fragrant, 1 to 2 minutes. Pour in broth, then add green chiles, garlic, salt, and cumin. Simmer until flavors have blended, about 15 minutes. Remove from the heat."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 3,
      "text": "Make the enchiladas: Mix Monterey Jack and Cheddar together in a bowl."
    },
    {
      "position": 4,
      "text": "Heat 1/4 inch oil in a heavy skillet over medium heat. Fry tortillas, one at a time, until blistering but still soft enough to roll, 10 to 20 seconds per side. Drain on paper towels."
    },
    {
      "position": 5,
      "text": "Dip both sides of each tortilla in salsa verde, then place onto a work surface. Place 2 heaping tablespoons chicken and about 2 tablespoons cheese mixture down the center and roll tortilla around fillings. Place, seam-side down, into a shallow baking dish. Repeat to fill and roll remaining tortillas."
    },
    {
      "position": 6,
      "text": "Spoon some salsa verde over enchiladas and pour in heavy cream. Sprinkle remaining cheese mixture over top and garnish with green onions."
    },
    {
      "position": 7,
      "text": "Bake, uncovered, in the preheated oven until sauce is bubbly and cheese is melted, about 20 minutes. Remove from the oven and garnish with olives and cherry tomatoes. Serve immediately with remaining salsa verde on the side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "72992ea3-a534-54f0-823b-f8864ce4e112",
  "slug": "lemon-pepperoncini-tuna-salad-recipe-12019423",
  "name": "Lemon Pepperoncini Tuna Salad",
  "recipe_type": "salad",
  "brief_description": "Give classic tuna salad a bright Mediterranean twist by adding pepperoncini, fresh herbs, lemon, and avocado mayo. Serve it as a dip with crackers and pita chips, or pile it onto toast, sandwiches, or crisp lettuce leaves for a fresh, protein-packed meal or snack.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together avocado mayonnaise, Dijon mustard, pepperoncini brine, lemon juice, lemon zest, granulated garlic, salt, and pepper in a small bowl until smooth."
    },
    {
      "position": 2,
      "text": "Fold in red onion, celery, pepperoncini, scallions, dill, and basil until everything is evenly coated."
    },
    {
      "position": 3,
      "text": "Gently fold in tuna, keeping some larger pieces intact for texture."
    },
    {
      "position": 4,
      "text": "Taste and adjust seasoning: add more brine if you want it punchier, more lemon if you want it brighter, and a pinch of salt to make everything pop."
    },
    {
      "position": 5,
      "text": "Let it sit for 10 to 15 minutes if you have time so the flavors meld together. Serve topped with feta, pickled onion, and/or a spritz of lemon juice."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

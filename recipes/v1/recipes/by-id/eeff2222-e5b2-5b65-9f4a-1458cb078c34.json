  "id": "eeff2222-e5b2-5b65-9f4a-1458cb078c34",
  "slug": "burgers-with-whipped-blueberry-goat-cheese-recipe-11998032",
  "name": "Burgers with Whipped Blueberry Goat Cheese",
  "recipe_type": "dessert",
  "brief_description": "Whipped goat cheese gets a sweet upgrade with blueberries for a surprisingly complementary beef burger topper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill to high heat (400 degrees F to 450 degrees F/200 degrees C to 232 degrees C)."
    },
    {
      "position": 2,
      "text": "For whipped goat cheese, combine goat cheese and honey in a bowl; beat with an electric mixer at medium speed until light and fluffy, about 1 minute. Swirl in mashed blueberries until just combined."
    },
    {
      "position": 3,
      "text": "In a large bowl, mix together ground beef, chives, salt, and pepper. Shape into 4 (1/2-inch-thick) patties, about 4 inches in diameter."
    },
    {
      "position": 4,
      "text": "Lightly oil grill grates. Grill burgers, turning halfway through, 6 to 10 minutes or until an instant- read thermometer inserted into centers registers 160\u00b0Fahrenheit (or until desired doneness)."
    },
    {
      "position": 5,
      "text": "Spread cut sides of toasted buns with whipped blueberry goat cheese. Serve burgers in buns with arugula."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

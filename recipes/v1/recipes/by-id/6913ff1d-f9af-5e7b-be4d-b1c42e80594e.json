  "id": "6913ff1d-f9af-5e7b-be4d-b1c42e80594e",
  "slug": "brandied-orange-and-cranberry-sauce",
  "name": "Brandied Orange and Cranberry Sauce",
  "recipe_type": "dessert",
  "brief_description": "Try cranberry sauce with brandy for your next holiday meal. Brandy keeps it sweet and fruity while citrus zest and juice add extra interest.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Inspect four 1/2-pint jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until cranberry sauce is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 2,
      "text": "Combine water and orange zest in a small pan over medium heat; cover and bring to a boil. Reduce the heat and simmer for 15 minutes. Drain, reserving all zest and 1/3 cup liquid."
    },
    {
      "position": 3,
      "text": "Return zest and reserved liquid to the pan; add sugar, orange juice, and lemon juice. Bring to a boil, then reduce the heat and simmer, stirring often, for 3 minutes."
    },
    {
      "position": 4,
      "text": "Add cranberries. Increase the heat to medium-high and boil until cranberries have popped and a small spoonful of sauce sets on a cold plate, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the heat and stir in brandy. Pour into the prepared jars, filling to within 1/2 inch of the top. Cool to room temperature, then seal and store in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

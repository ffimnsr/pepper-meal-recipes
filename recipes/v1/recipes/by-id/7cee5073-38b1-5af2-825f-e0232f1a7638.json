  "id": "7cee5073-38b1-5af2-825f-e0232f1a7638",
  "slug": "classic-savory-deviled-eggs",
  "name": "Classic Savory Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Classic deviled eggs with a creamy blend of hard-boiled egg yolks, mayo, mustard, and vinegar. Garlic powder and fresh dill add a delightful flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Scoop egg yolks into a bowl and set egg whites aside."
    },
    {
      "position": 3,
      "text": "Add mayonnaise, vinegar, mustard, 1/2 teaspoon chopped dill, garlic powder, and salt to the egg yolks; mash well until smooth."
    },
    {
      "position": 4,
      "text": "Spoon or pipe yolk mixture into egg whites. Garnish with dill sprigs. Refrigerate until ready to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

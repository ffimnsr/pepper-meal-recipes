  "id": "619588b9-7bf2-5cd6-97ff-716447f685a1",
  "slug": "quick-coffee-cake",
  "name": "Quick Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This coffee cake is wonderful, the cake itself it moist and delicious while the topping is slightly crunchy and sweeter. Together, they make a delightful combination that you will surely enjoy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease and flour a 9 inch square pan."
    },
    {
      "position": 2,
      "text": "In a large bowl mix together the flour, baking powder, sugar and salt. Cut in the shortening with a pastry blender to the size of small peas."
    },
    {
      "position": 3,
      "text": "In a separate small bowl, beat the egg well, then stir in the milk and vanilla. Add the egg-milk mixture to the flour mixture all at once. Stir carefully until just blended."
    },
    {
      "position": 4,
      "text": "Pour batter into prepared pan and spread evenly. Drizzle top with melted butter."
    },
    {
      "position": 5,
      "text": "In a small bowl mix together brown sugar, 2 tablespoons flour and 1/2 teaspoon cinnamon. Sprinkle on top of cake. Bake in the preheated oven for 15 to 20 minutes, or until a toothpick inserted into the center of the cake comes out clean."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

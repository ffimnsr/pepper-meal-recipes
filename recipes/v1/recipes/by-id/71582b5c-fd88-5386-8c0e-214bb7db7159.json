  "id": "71582b5c-fd88-5386-8c0e-214bb7db7159",
  "slug": "four-cheese-chicken-carbonara",
  "name": "Four-Cheese Chicken Carbonara",
  "recipe_type": "main",
  "brief_description": "This creamy chicken carbonara with tender chunks of chicken, crispy bacon, and penne pasta tossed in a rich and silky cheese sauce is sure to please!",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Drain bacon slices on paper towels. Chop into small pieces when cool enough to handle."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and olive oil; cook, stirring occasionally, until tender yet firm to the bite, about 8 minutes."
    },
    {
      "position": 5,
      "text": "While pasta is cooking, melt butter in a large, deep skillet over low heat. Add chopped bacon, garlic, and 1 teaspoon pepper; sauté until fragrant, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Increase heat to medium, add chicken, and cook until chicken is no longer pink in the center and the juices run clear, 5 to 7 minutes."
    },
    {
      "position": 7,
      "text": "Add whipping cream, Parmesan-Romano cheese, and remaining 2 teaspoons pepper to the skillet. Stir and cook until heated through, about 3 minutes. Add Colby-Jack cheese and stir until melted. Stir in beaten eggs and bring to a simmer."
    },
    {
      "position": 8,
      "text": "Add drained pasta and stir until coated with sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "7ecb5197-f559-582d-9bac-0986acbbf141",
  "slug": "red-white-and-blue-pie",
  "name": "Red, White, and Blue Pie",
  "recipe_type": "dessert",
  "brief_description": "This red, white, and blue pie recipe features fresh rhubarb and fresh blueberries nestled in a light oil-based crust, topped with vanilla frozen yogurt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place 1 \u00be cups flour and salt in a bowl; add oil and mix well. Drizzle in water, 1 tablespoon at a time, mixing until dough almost cleans the sides of the bowl. Press dough into a ball; divide in half and flatten each half into a \u00bd-inch-thick round. Set aside to rest for about 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine sugar, \u2153 cup flour, and cinnamon in a large bowl; fold in rhubarb and blueberries. Drizzle with lemon juice; stir until filling evenly combined."
    },
    {
      "position": 4,
      "text": "Roll out dough rounds to fit a 9-inch pie plate; place 1 round into pie plate for the bottom crust. Pour filling into crust; dot with butter. Cover filling with remaining 1 dough round; flute edges together to seal. Cut 1 or 2 vent holes in the top crust using a knife. Place aluminum foil around pie edges to prevent burning."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil; continue baking until crust is golden brown, about 15 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "hard",

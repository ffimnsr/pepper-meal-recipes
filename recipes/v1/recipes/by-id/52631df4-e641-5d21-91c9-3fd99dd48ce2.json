  "id": "52631df4-e641-5d21-91c9-3fd99dd48ce2",
  "slug": "cowboy-bacon-recipe-11879554",
  "name": "Cowboy Bacon",
  "recipe_type": "appetizer",
  "brief_description": "This cowboy bacon is a spicy candied meat treat with a texture somewhere between crispy and chewy. Fully caramelized with a brown sugar-barbecue sauce glaze, this will be the most talked-about snack at your party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Cover a sheet pan with foil and place a baking rack on top. Place bacon strips on the rack, evenly spaced."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven for 10 minutes. Turn bacon over and bake for 10 minutes more."
    },
    {
      "position": 3,
      "text": "Meanwhile, for glaze, stir brown sugar, barbecue sauce, rice vinegar, black pepper, and garlic powder together in a small bowl."
    },
    {
      "position": 4,
      "text": "Remove bacon from the oven, brush with glaze, and bake 7 minutes more."
    },
    {
      "position": 5,
      "text": "Remove from the oven, turn bacon over, brush with glaze, and bake 7 minutes more. Remove from the oven, turn bacon over, and bake 10 minutes more."
    },
    {
      "position": 6,
      "text": "Remove from the oven and flip bacon over."
    },
    {
      "position": 7,
      "text": "Brush bacon with glaze, and bake for 10 minutes more. Remove and brush with glaze. Place pepper rings evenly on top of bacon strips; bake for 10 minutes more. Remove and brush with remaining glaze."
    },
    {
      "position": 8,
      "text": "Place back in the oven and cook until bacon is fully rendered and browned, and pepper rings are tender, about 7 minutes more."
    },
    {
      "position": 9,
      "text": "Transfer bacon to a piece of parchment paper and let cool completely before serving. Strips can be cut in half crosswise to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "3c94ae91-fd0c-5a8e-a286-6af37d341057",
  "slug": "ham-and-cheddar-sous-vide-egg-bites",
  "name": "Ham and Cheddar Sous Vide Egg Bites",
  "recipe_type": "breakfast",
  "brief_description": "You can make these delicious sous vide egg bites with ham and cheese in advance for a homemade quick breakfast to go!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a stockpot with enough water to just cover the jars. Attach a sous vide immersion cooker to the side of the pot. Set temperature to 172 degrees F (77 degrees C)."
    },
    {
      "position": 2,
      "text": "Generously oil the inside of each jar with coconut oil. Add ham and red pepper to the bottom of the jars."
    },
    {
      "position": 3,
      "text": "Whisk eggs and cream together in a bowl until well combined. Stir in Cheddar cheese, salt, and nutmeg. Divide egg mixture among the jars. Close jars with lids and metal bands; tighten using the tips of your fingers only. Do not over-tighten."
    },
    {
      "position": 4,
      "text": "Immerse in the water bath and cook for 1 hour. Carefully remove the jars, using tongs, to a heat-resistant surface. Let rest 10 minutes before opening the jars."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 10,
  "difficulty": "hard",

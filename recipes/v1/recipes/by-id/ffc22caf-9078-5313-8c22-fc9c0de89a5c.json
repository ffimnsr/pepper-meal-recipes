  "id": "ffc22caf-9078-5313-8c22-fc9c0de89a5c",
  "slug": "lemon-poppy-seed-pancakes-recipe-8706892",
  "name": "Lemon Poppy Seed Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Chef John's lemon-poppy seed pancakes turn out perfectly, thanks to his 3 easy techniques. You'll be rewarded with delicious, fluffy pancakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar and lemon zest, and stir to combine. Let stand about 15 minutes."
    },
    {
      "position": 2,
      "text": "Whisk flour, salt, baking powder, and baking soda together in a separate bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Add poppy seeds, egg, and melted butter to the bowl of sugar, and whisk thoroughly. Add lemon juice, milk, and flour mixture. Whisk gently just until flour disappears. Let batter rest for 10 to 15 minutes before using."
    },
    {
      "position": 4,
      "text": "Heat a nonstick skillet over medium heat, and generously grease with melted butter or vegetable oil."
    },
    {
      "position": 5,
      "text": "Transfer about 1/3 cup of batter into the pan for each pancake, and cook until a few bubbles start to pop through the surface, 3 to 4 minutes. Flip and cook the second side 3 to 4 minutes. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,
  "difficulty": "easy",

  "id": "b449ff14-0ab2-5b00-8758-73f5db3a4559",
  "slug": "mexican-street-corn-soup-recipe-11817555",
  "name": "Mexican Street Corn Soup",
  "recipe_type": "soup",
  "brief_description": "This Mexican street corn soup is rich and creamy, a play on elote that is loaded with flavor. Don't be tempted to skip the garnishes; they are important to complete the flavors.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a stovetop grill over high heat. Cook corn for 15 minutes, turning every 5 minutes. Transfer corn to a cutting board. Slice kernels from the cob once cool enough to handle."
    },
    {
      "position": 2,
      "text": "Heat oil in a large soup pot over medium-high heat. Add onion and jalapeno. and cook for 4 minutes. Add garlic and cook for 1 minute more. Reduce heat to medium."
    },
    {
      "position": 3,
      "text": "Add broth, diced green chilies, chili powder, cumin, lime juice, and corn kernels. Cook until heated through, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Place sour cream in a large bowl. Ladle 1 scoop of soup broth over sour cream. Whisk until combined. Repeat this step. It is important to temper the sour cream so that it does not curdle once it goes into the soup."
    },
    {
      "position": 5,
      "text": "Stir the tempered sour cream into the soup. Add pepper Jack cheese and chicken. Cook until cheese is melted, about 10 minutes, stirring frequently."
    },
    {
      "position": 6,
      "text": "Ladle soup into bowls and garnish with cilantro. cotija, and lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

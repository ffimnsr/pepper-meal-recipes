  "id": "f557facc-07fa-5708-b66d-776a94aa2c69",
  "slug": "cast-iron-peach-blueberry-cobbler-recipe-12065275",
  "name": "Cast Iron Peach Blueberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This cast iron peach blueberry cobbler is a delicious, bubbly, no-fuss, no-mess version of classic fruit cobbler. Toss fresh peaches and blueberries with a few ingredients right in the skillet, add a quick crumble topping, and bake. It\u2019s rustic, easy, and so good you\u2019ll want to make it every day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Add peaches and blueberries directly to a 10- to 12-inch cast iron skillet. Add brown sugar, cornstarch, lemon juice, vanilla, cinnamon, nutmeg, and salt. Gently toss everything together in the skillet until the fruit is evenly coated."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, and cinnamon in a separate bowl. Add melted butter and vanilla and stir until a thick, clumpy topping forms."
    },
    {
      "position": 4,
      "text": "Crumble the topping evenly over the fruit, leaving a few openings for the peaches and blueberries to bubble through."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the topping is golden brown and the fruit is bubbling in the center, 45 to 55 minutes."
    },
    {
      "position": 6,
      "text": "Let the cobbler rest for 25 to 30 minutes before serving to allow the filling to thicken. Serve warm with vanilla ice cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 25,
  "difficulty": "medium",

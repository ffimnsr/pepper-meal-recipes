  "slug": "walking-strawberry-pretzel-salad-recipe-7511253",
  "name": "Walking Strawberry Pretzel Salad",
  "recipe_type": "salad",
  "brief_description": "Strawberry pretzel salad walks right off the buffet table in this fun recipe, combining all the elements of pretzel salad right in a snack-size bag of mini pretzels. Strawberries, whipped topping, jell-o, and pudding, plus salty pretzels, make for a winning go-anywhere snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Open pretzel bags and coarsely crush pretzels with your hands."
    },
    {
      "position": 3,
      "text": "Remove 1 tablespoon of crushed pretzels from each bag, and reserve for garnish."
    },
    {
      "position": 4,
      "text": "Dollop half of the vanilla pudding into each bag."
    },
    {
      "position": 5,
      "text": "Dollop half of the strawberry jell-o into each bag."
    },
    {
      "position": 6,
      "text": "Top each with 1/4 cup strawberries."
    },
    {
      "position": 7,
      "text": "Dollop with 1/4 cup of the whipped topping."
    },
    {
      "position": 8,
      "text": "Garnish with reserved pretzels and strawberries."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

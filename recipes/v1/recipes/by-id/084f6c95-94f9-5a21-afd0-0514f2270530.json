  "id": "084f6c95-94f9-5a21-afd0-0514f2270530",
  "slug": "cold-tuna-macaroni-salad",
  "name": "Cold Tuna Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "The ingredients in this cold tuna macaroni salad are classic: tuna, macaroni, mayonnaise, celery and tomatoes. Great for a summer meal!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot of salted boiling water, cook pasta until al dente; rinse under cold water and drain."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine the pasta, tomatoes, celery, and tuna."
    },
    {
      "position": 3,
      "text": "Prepare the dressing by whisking together the mayonnaise, salad dressing, sugar, and pepper. Add to pasta salad, mix together, and refrigerate for 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

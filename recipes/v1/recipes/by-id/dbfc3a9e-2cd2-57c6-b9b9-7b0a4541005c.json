  "id": "dbfc3a9e-2cd2-57c6-b9b9-7b0a4541005c",
  "slug": "amazing-whipped-potatoes",
  "name": "Amazing Whipped Potatoes",
  "recipe_type": "side",
  "brief_description": "These whipped potatoes with butter, cream cheese, and sour cream are deliciously rich and fluffy \u2014 the perfect potato side dish to complete any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes; drain and transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Add butter and cream cheese to potatoes; beat with an electric mixer until butter is nearly melted. Add milk and sour cream; continue to beat until smooth. Season with salt and black pepper."
    }
  ],

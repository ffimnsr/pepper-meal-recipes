  "slug": "brookville-hotel-sweet-and-sour-coleslaw",
  "name": "Brookville Hotel Sweet and Sour Coleslaw",
  "recipe_type": "salad",
  "brief_description": "An easy, 5-ingredient recipe for coleslaw from a famous Kansas restaurant doesn't need mayonnaise. Make the slaw ahead of time and let it chill for several hours before serving. It's great for a potluck.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cream, sugar, vinegar, and salt together in a bowl until sugar and salt have dissolved; cover and refrigerate dressing for 30 minutes to blend flavors. Pour dressing over cabbage in a bowl, toss to combine, and refrigerate until thoroughly chilled, at least 2 hours."
    }
  ],

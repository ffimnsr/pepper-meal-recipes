  "schema_version": 1,
  "id": "6198e97b-8942-5e0c-8756-5cb9dc484749",
  "slug": "low-carb-cauliflower-and-pulled-pork-shepherds-pie",
  "name": "Low-Carb Cauliflower and Pulled Pork Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Mashed cauliflower replaces potato in this lower-carb, pulled pork version of the classic, comforting shepherd's pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place cauliflower in a pot and cover with water; bring to a boil. Reduce heat and let simmer until tender, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "While cauliflower is cooking, spray an 8x10-inch baking dish with cooking spray."
    },
    {
      "position": 4,
      "text": "Layer the bottom of the prepared dish with pulled pork. Layer peas and carrots on top of pork. Spoon cream of mushroom over the top."
    },
    {
      "position": 5,
      "text": "Using a potato masher, mash cauliflower as you would potatoes. Add milk slowly as you mash to a creamy, but chunky, texture. Add mashed cauliflower to the top of your casserole. Season with salt and pepper; sprinkle Cheddar cheese over the top. Cover the dish with foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bubbly and heated through, about 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

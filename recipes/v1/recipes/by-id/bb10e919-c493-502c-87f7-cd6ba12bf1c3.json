  "slug": "cool-as-a-cucumber-soup-recipe-12036795",
  "name": "Cool as a Cucumber Soup",
  "recipe_type": "soup",
  "brief_description": "This cool as a cucumber soup is the best way to beat summer heat. Ice cold and refreshing with English cucumbers, buttermilk, and plenty of herbs, it\u2019s easy to blend in just a few minutes. It will need to chill for two hours.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cucumbers, buttermilk, yogurt, stock, lime juice, mint, dill, ice, salt, and pepper in a blender and blend until smooth. Chill for 2 hours."
    },
    {
      "position": 2,
      "text": "Pour into your favorite pitcher and refrigerate until perfectly chilled."
    },
    {
      "position": 3,
      "text": "Pour the soup into chilled bowls and garnish with dill and/or mint. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

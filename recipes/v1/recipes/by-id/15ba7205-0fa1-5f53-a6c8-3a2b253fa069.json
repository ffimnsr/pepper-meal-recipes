  "id": "15ba7205-0fa1-5f53-a6c8-3a2b253fa069",
  "slug": "baked-spinach-artichoke-dip-without-mayo",
  "name": "Baked Spinach-Artichoke Dip without Mayo",
  "recipe_type": "appetizer",
  "brief_description": "This cheesy spinach-artichoke dip is made without mayo \u2014 it still delivers that classic taste and exceptionally creamy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Place thawed spinach in a kitchen towel; wrap tightly to squeeze out excess water until spinach is just damp. Set aside."
    },
    {
      "position": 3,
      "text": "Mix cream cheese, sour cream, onion powder, salt, and pepper together in a large bowl until smooth and creamy. Add artichoke hearts, drained spinach, hot sauce, and garlic; mix well. Add 1 cup mozzarella cheese and 1/4 cup Parmesan cheese; mix well. Pour into the prepared baking dish and sprinkle with extra cheese if you like a crispy, bubbly cheese layer on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and slightly browned on top, about 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "cbf7375c-f12a-51ba-8045-6855c252e421",
  "slug": "sweet-potato-butternut-squash-pie",
  "name": "Sweet Potato Butternut Squash Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato butternut squash pie recipe uses 9 ingredients, including three spices\u2014cinnamon, nutmeg, and allspice\u2014and has a custard-like texture.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mash sweet potatoes and butternut squash together in a bowl; stir in eggs, milk, cinnamon, nutmeg, and allspice. Pour sweet potato-squash mixture into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes; arrange marshmallows on top of pie. Continue baking until a knife inserted into center comes out clean, about 30 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

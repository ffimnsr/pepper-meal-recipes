  "id": "13e158bb-b14d-518c-8fd6-e64c9411c8a8",
  "slug": "the-best-rolled-sugar-cookies",
  "name": "The Best Rolled Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "This is the best sugar cookie recipe; easy to cut out and they're perfect for decorating. This is the only cookie recipe you'll need for any holiday!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat sugar and softened butter together in a large bowl with an electric mixer until smooth."
    },
    {
      "position": 3,
      "text": "Beat in eggs and vanilla. Stir in flour, baking powder, and salt. Cover, and chill dough for at least 1 hour (or overnight)."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly dust a work surface with flour. Roll out dough to 1/4 to 1/2 inch thickness."
    },
    {
      "position": 5,
      "text": "Cut into shapes with any cookie cutter. Place cookies 1 inch apart on ungreased baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cookies are lightly browned, 6 to 8 minutes. Carefully transfer cookies to a wire rack and cool completely before decorating."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

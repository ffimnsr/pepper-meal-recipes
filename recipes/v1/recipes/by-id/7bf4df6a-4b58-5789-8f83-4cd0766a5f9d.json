  "id": "7bf4df6a-4b58-5789-8f83-4cd0766a5f9d",
  "slug": "mini-crab-cakes-with-sriracha-aioli-recipe-11909192",
  "name": "Mini Crab Cakes with Sriracha Aioli",
  "recipe_type": "appetizer",
  "brief_description": "These mini crab cakes with Sriracha aioli have all the flavors you love in a crab cake, but made bite-sized and topped with zesty Sriracha aioli. They will surely please all of your tailgating friends, or be the first appetizer to disappear at any gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For aioli, whisk 1/4 cup mayonnaise, Sriracha, and 1 teaspoon lemon juice together in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "For crab cakes, add egg, 2 tablespoons mayonnaise, Old Bay, 1 teaspoon lemon juice, drained crab, and Panko bread crumbs to a large bowl. Mix until evenly combined."
    },
    {
      "position": 3,
      "text": "Take 2 tablespoons crab mixture and form into a small patty. Repeat with remaining crab mixture."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook patties for 5 minutes. Using a spatula, flip patties and cook until golden, about 5 minutes more."
    },
    {
      "position": 5,
      "text": "Transfer to a serving platter and serve with reserved Sriracha aioli."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

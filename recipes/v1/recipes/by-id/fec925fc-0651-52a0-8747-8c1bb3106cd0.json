  "id": "fec925fc-0651-52a0-8747-8c1bb3106cd0",
  "slug": "apple-danish-bars",
  "name": "Apple Danish Bars",
  "recipe_type": "dessert",
  "brief_description": "Whether you serve these for dessert or breakfast, you're sure to get an enthusiastic reaction from these sweet apple Danish bars.",
  "cuisine": "Danish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10x15-inch baking pan. Divide egg; set aside egg white for filling."
    },
    {
      "position": 2,
      "text": "Combine flour and salt in a bowl. Cut in shortening with 2 knives or a pastry blender until the mixture resembles coarse crumbs. Mix in milk and egg yolk until incorporated. Divide dough into two equal pieces. Pat one piece into the bottom of the prepared pan; set other piece aside."
    },
    {
      "position": 3,
      "text": "Mix apples, brown sugar, sour cream, flour, butter, and cinnamon together until well combined. Pour over the dough in the pan."
    },
    {
      "position": 4,
      "text": "Roll or pat remaining dough into a rectangle and place on top of filling. Beat reserved egg white until frothy and brush over dough."
    },
    {
      "position": 5,
      "text": "Bake until top and bottom are golden brown, 15 to 20 minutes. Remove from the oven and allow to cool completely, about 30 minutes, before cutting into bars."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

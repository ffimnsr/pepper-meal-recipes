{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4dcb8fbe-2b3b-57ba-bafa-44f77ad3c6c1",
  "slug": "chicken-cacciatore-ii",
  "name": "Chicken Cacciatore II",
  "recipe_type": "main",
  "brief_description": "The Italian favorite recipe for chicken and mushrooms in tomato sauce is enriched with white wine, capers, and fresh herbs.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Season the chicken pieces with salt and black pepper."
    },
    {
      "position": 2,
      "text": "Place the flour in a shallow bowl. Press each chicken piece into the flour and tap off excess."
    },
    {
      "position": 3,
      "text": "Heat the olive oil in a large Dutch oven over medium heat until almost smoking hot."
    },
    {
      "position": 4,
      "text": "Pan-fry the chicken until golden brown on both sides, about 3 minutes per side. Work in batches so as to not overcrowd the pan. Set the browned chicken aside."
    },
    {
      "position": 5,
      "text": "Stir the onion, green bell pepper, and garlic into the Dutch oven; cook, stirring occasionally, until tender, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Stir in the mushroom; cook until they release their juice, 5 to 8 more minutes."
    },
    {
      "position": 7,
      "text": "Mix in oregano, tomatoes, tomato paste, white wine, and chicken stock; bring to a boil."
    },
    {
      "position": 8,
      "text": "Return the chicken pieces to the sauce, cover the pan, reduce heat to medium-low, and simmer until the chicken is no longer pink inside and the juices run clear, 30 to 40 minutes."
    },
    {
      "position": 9,
      "text": "Stir in capers and sprinkle with basil to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

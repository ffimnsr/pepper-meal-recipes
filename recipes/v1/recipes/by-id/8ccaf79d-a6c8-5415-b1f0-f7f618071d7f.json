  "id": "8ccaf79d-a6c8-5415-b1f0-f7f618071d7f",
  "slug": "biscuit-donuts-recipe-11845410",
  "name": "Biscuit Donuts",
  "recipe_type": "dessert",
  "brief_description": "These biscuit donuts are perfect for when you crave a donut and are short on time. Refrigerated biscuit dough is cut, deep fried, and tossed in cinnamon sugar, and you even get donut holes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 3 inches of oil to a large pot over medium-high heat to 350 degrees F (180 degrees C). Line a plate with paper towels."
    },
    {
      "position": 2,
      "text": "Whisk together cinnamon and sugar together in a shallow bowl and set aside."
    },
    {
      "position": 3,
      "text": "Using a small round cookie cutter, make a hole in the center of each biscuit. Reserve donut holes."
    },
    {
      "position": 4,
      "text": "Working in small batches, fry donuts and reserved donut holes until they turn golden brown on one side, about 1 minute. Flip and cook until golden on both sides, about 1 another minute more."
    },
    {
      "position": 5,
      "text": "Remove donuts and donut holes to the prepared plate. Dab off excess oil and toss in cinnamon sugar until well coated."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "0ecced88-368f-56db-b114-d83ca1450b74",
  "slug": "baked-onion-bhajis",
  "name": "Baked Onion Bhajis",
  "recipe_type": "appetizer",
  "brief_description": "Baked onion bhajis are a healthier version of the popular deep-fried Indian onion fritters. They're oniony, crunchy, and loaded with fragrant spices.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cook the onions: Heat oil in a skillet over medium heat. Add onions; cook and stir until translucent, 6 to 8 minutes. Mix in chili powder, then stir in turmeric, coriander, cumin, and ginger until well combined. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Make the batter: Mix chickpea flour, cumin, coriander, and salt together in a bowl until well combined. Mix in onions and tomato pur\u00e9e, then add a little water until mixture is wet and easy to stir."
    },
    {
      "position": 4,
      "text": "Drizzle 1 teaspoon olive oil onto the prepared baking sheet. Place 2 tablespoons onion mixture onto the baking sheet for each bhaji; flatten slightly with the back of a spoon."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 to 25 minutes. Drizzle remaining oil over the bhajis and continue baking until golden brown, about 25 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "egg-nog-dump-cake-recipe-11855078",
  "name": "3-Ingredient Eggnog Dump Cake",
  "recipe_type": "dessert",
  "brief_description": "This 3-ingredient eggnog dump cake could not be easier. Cake mix, eggnog, and butter are all you need for this effortless festive recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Pour 1/3 of the eggnog into the prepared dish. Sprinkle cake mix evenly over eggnog. Pour remaining eggnog evenly over the top of cake mix. No need to stir!"
    },
    {
      "position": 3,
      "text": "Distribute pieces of butter evenly on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown and bubbly, 45 to 50 minutes."
    },
    {
      "position": 5,
      "text": "Allow dump cake to cool for 15 minutes before serving to allow the cake to set slightly. Serve with cool whip, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 5,

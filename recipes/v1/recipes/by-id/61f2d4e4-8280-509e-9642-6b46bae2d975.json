  "id": "61f2d4e4-8280-509e-9642-6b46bae2d975",
  "slug": "marinated-pork-roast",
  "name": "Marinated Pork Roast",
  "recipe_type": "main",
  "brief_description": "This pork roast marinade is a great recipe with Worcestershire, honey, vinegar, and more. It can be used for any meat, like chicken or ribs, as well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine Worcestershire sauce, honey, vinegar, lemon pepper, mustard seed, mustard powder, celery salt, and garlic in a large resealable plastic bag; seal and mix ingredients."
    },
    {
      "position": 2,
      "text": "Place pork roast in the plastic bag, press air out of bag, and seal. Marinate for 2 hours in the refrigerator, turning the roast occasionally to help coat while marinating."
    },
    {
      "position": 3,
      "text": "Meanwhile, prepare grill for indirect heat."
    },
    {
      "position": 4,
      "text": "Lightly oil grill grate. Place roast on grill and discard marinade. Cover and cook until internal temperature is 145 degrees F (63 degrees C), 1 1/2 to 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,

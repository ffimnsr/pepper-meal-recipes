  "slug": "balsamic-glazed-carrots",
  "name": "Balsamic Glazed Carrots",
  "recipe_type": "side",
  "brief_description": "Carrots are sauteed in olive oil, and then briefly tossed with balsamic vinegar and brown sugar in this deceptively simple side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium-high heat. Saute carrots in oil for about 10 minutes, or until tender. Stir in balsamic vinegar and brown sugar, mix to coat and serve."
    }
  ],

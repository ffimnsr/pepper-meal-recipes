  "id": "f0c2ea31-a46a-58ab-b25c-d2a95c7f0d96",
  "slug": "cake-mixes-from-scratch-and-variations",
  "name": "Cake Mixes From Scratch and Variations",
  "recipe_type": "dessert",
  "brief_description": "This homemade cake mix is an easy substitute for store-bought box mix and can make many flavors, including yellow, chocolate, pineapple, and spice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "For a Yellow Cake: Sift together flour, sugar, baking powder, and salt in a large bowl. Cut in shortening until mixture resembles fine crumbs. Add milk, eggs, and vanilla. Beat with an electric mixer on low speed for 1 minute, then on high for 2 minutes, scraping the bowl frequently. Pour batter into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

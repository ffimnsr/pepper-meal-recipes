  "id": "f7e552a3-8294-550b-b929-b26561c929f4",
  "slug": "creamy-smoked-salmon-pasta",
  "name": "Creamy Smoked Salmon Pasta",
  "recipe_type": "main",
  "brief_description": "This smoked salmon pasta features chopped smoked salmon in a creamy Romano cheese sauce with peas and mushrooms for a satisfying weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes; drain."
    },
    {
      "position": 3,
      "text": "Melt butter in a large skillet over medium heat. Saut\u00e9 onion in butter until tender, 2 to 3 minutes. Stir flour and garlic powder into onion."
    },
    {
      "position": 4,
      "text": "Gradually stir in milk. Heat to just below boiling point, then gradually stir in cheese until sauce is smooth. Stir in peas and mushrooms; cook over low heat until warmed through, about 4 minutes."
    },
    {
      "position": 5,
      "text": "Toss in smoked salmon and cook until heated through, about 2 minutes. Serve over pasta."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

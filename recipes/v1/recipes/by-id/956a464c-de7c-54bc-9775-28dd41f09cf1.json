  "id": "956a464c-de7c-54bc-9775-28dd41f09cf1",
  "slug": "ultimate-irish-cream-chocolate-mousse",
  "name": "Ultimate Irish Cream Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "This Irish cream mousse is easy to make with dark chocolate, eggs, cream, and Baileys for a rich, creamy, and deliciously chocolaty dessert.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Melt chocolate in a small saucepan over low heat. Remove from heat and allow to cool."
    },
    {
      "position": 2,
      "text": "Beat egg yolks in a large bowl; stir in cooled melted chocolate and Baileys. Fold in 1/2 of the whipped cream."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a separate bowl until stiff; fold into chocolate mixture."
    },
    {
      "position": 4,
      "text": "Spoon mousse into serving glasses and garnish with remaining whipped cream and chocolate shavings before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

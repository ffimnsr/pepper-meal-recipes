  "id": "5035dfa9-c71b-5f5b-aba9-8a76b87d1ef7",
  "slug": "cheddar-bay-biscuits",
  "name": "Cheddar Bay Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These Cheddar Bay Biscuits are easy to make in 25 minutes for warm, cheesy biscuits brushed with garlic butter, just like you'd get at Red Lobster!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine baking mix, water, and cheese in a large bowl; mix until dough comes together. Use a small scoop to portion dough onto the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes."
    },
    {
      "position": 4,
      "text": "While biscuits are baking, combine melted butter, garlic powder, salt, onion powder, and parsley in a small bowl. Brush over hot biscuits."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

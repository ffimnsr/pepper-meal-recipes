  "slug": "pinnacle-sunday-funday-bloody-mary",
  "name": "Pinnacle Sunday Funday Bloody Mary",
  "recipe_type": "drink",
  "brief_description": "Savory flavors come together with smooth Pinnacle Original Vodka to create a perfect bloody Mary for football parties, Sunday brunch, or just a relaxing weekend afternoon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine all ingredients except celery in an ice-filled shaker and shake until well chilled."
    },
    {
      "position": 2,
      "text": "Strain into a chilled pint glass over fresh ice."
    },
    {
      "position": 3,
      "text": "Garnish with celery and any other fun toppings on hand."
    }
  ],

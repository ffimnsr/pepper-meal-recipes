  "slug": "easiest-teriyaki-marinade-ever",
  "name": "Easiest Teriyaki Marinade Ever",
  "recipe_type": "side",
  "brief_description": "Pork chops and other meats taste great when marinated in this very simple but delicious teriyaki mixture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix water, brown sugar, soy sauce, garlic, and cinnamon. Place desired meat in the mixture. Cover, and marinate in the refrigerator at least 2 hours before grilling as desired."
    }
  ],

  "id": "94a3e9e5-6dd4-5888-8586-b58c872ec017",
  "slug": "melted-snowman-cookies",
  "name": "Melted Snowman Cookies",
  "recipe_type": "dessert",
  "brief_description": "Everyone will love these adorable melted snowman cookies made with marshmallows, homemade icing, and sugar cookies. Impress your friends and family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg whites lightly in a large bowl using an electric mixer until frothy. Slowly beat enough confectioners' sugar into egg whites to make icing that will hold shape; blend in lemon juice until desired consistency is reached."
    },
    {
      "position": 2,
      "text": "Arrange cookies about 1-inch apart on a large sheet of waxed paper. Spread icing onto each cookie, allowing icing to drip over edges to look like melting snow."
    },
    {
      "position": 3,
      "text": "Grease a microwave-safe plate. Place 1 marshmallow onto plate."
    },
    {
      "position": 4,
      "text": "Microwave marshmallow until it starts to puff up, 20 to 30 seconds. Immediately place marshmallow on the edge of 1 cookie while the icing is still wet to look like a melted snowman. Repeat with remaining marshmallows and iced cookies."
    },
    {
      "position": 5,
      "text": "Decorate melted snowmen cookies by piping twig-like arms using black decorating gel on the icing. Make coal eyes and a mouth on the marshmallow using black decorating gel. Make a carrot nose under the coal eyes using orange decorating gel. Make coat buttons by arranging silver nonpareils down the middle of the icing. Make scarves or bow ties using red decorating gel or green decorating gel."
    },
    {
      "position": 6,
      "text": "Allow cookies to fully dry before removing from waxed paper, at least 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 120,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "schema_version": 1,
  "id": "dda1177f-fbe3-5752-bd49-f3a07a276c17",
  "slug": "pineapple-upside-down-cake-with-rum",
  "name": "Pineapple Upside-Down Cake with Rum",
  "recipe_type": "dessert",
  "brief_description": "Spiced with rum and pumpkin pie spice, this moist, 2-layer pineapple upside-down cake is a perfect choice for holiday desserts, but would be a special treat any time of the year.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt brown sugar, butter, and honey for topping in a small saucepan over medium heat, stirring until smooth."
    },
    {
      "position": 3,
      "text": "Pour butter mixture into the bottoms of two ungreased 8-inch round cake pans. Drain pineapple slices and reserve 1/4 cup juice for the cake. Layer pineapple slices on top of the butter mixture."
    },
    {
      "position": 4,
      "text": "Combine buttermilk, rum, and reserved pineapple juice in a small bowl. Combine flour, baking powder, cinnamon, pumpkin pie spice, and salt in another small bowl."
    },
    {
      "position": 5,
      "text": "Beat white and brown sugars with butter in a large bowl until creamy. Add eggs, one at a time, mixing well after each addition. Beat in vanilla. Mix in 1/2 of the flour mixture, then all of the buttermilk mixture, and finally the remaining flour mixture until well combined. Divide cake batter evenly between the two pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cakes are golden and a toothpick inserted in the centers comes out clean, 30 to 35 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven place on wire racks until completely cooled, 30 to 45 minutes. Turn one cake out onto a serving plate, then carefully turn second cake directly on top of the first."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

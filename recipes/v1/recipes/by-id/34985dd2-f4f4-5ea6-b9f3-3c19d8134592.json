  "id": "34985dd2-f4f4-5ea6-b9f3-3c19d8134592",
  "slug": "red-curry-coconut-squash-soup",
  "name": "Red Curry Coconut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "Butternut squash soup gets a makeover with this red curry coconut squash soup recipe featuring fresh ginger, guaranteed to please on a chilly fall day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel butternut squash; cut in half lengthwise and scoop out seeds. Cut flesh into cubes."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter and coconut oil in a soup pot over medium-high heat. Add onion; cook until translucent, about 3 minutes. Stir in squash, roasted peppers, curry paste, ginger, and garlic; cook for 5 to 7 minutes. Add more butter to the pot if it seems dry to avoid burning squash or onion."
    },
    {
      "position": 3,
      "text": "Stir in coconut milk and skim milk; bring to a boil. Reduce heat; simmer soup, stirring often, until squash is soft, about 25 minutes."
    },
    {
      "position": 4,
      "text": "Pour \u2153 soup into a blender. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour into a large bowl. Repeat twice more with remaining soup."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

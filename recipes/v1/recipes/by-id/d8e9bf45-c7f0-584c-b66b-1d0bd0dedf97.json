  "id": "d8e9bf45-c7f0-584c-b66b-1d0bd0dedf97",
  "slug": "lentil-flatbread",
  "name": "Lentil Flatbread",
  "recipe_type": "snack",
  "brief_description": "This 3-ingredient, extremely simple recipe is easier than you may think and may just become your new favorite healthy flatbread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Add lentils and water to a blender, or food processor and soak for at least 3 hours."
    },
    {
      "position": 3,
      "text": "Blend lentils until they are very smooth. Season with salt. (Batter can be used immediately, but for best results refrigerate overnight)."
    },
    {
      "position": 4,
      "text": "To cook, heat a nonstick pan on medium-high. Grease lightly with olive oil and allow to get hot. Add 1/4 to 1/3 cup of batter to the hot pan."
    },
    {
      "position": 5,
      "text": "Use the bottom of a ladle or spoon to spread out into a 5 or 6 inch circle. Lower heat to medium, and adjust from there if needed. Cook the first side for about 1 1/2 to 2 minutes, before flipping over."
    },
    {
      "position": 6,
      "text": "Cook the second side for about 2 minutes, before transferring to a plate. Keep warm flatbreads covered with a towel while cooking and stacking."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

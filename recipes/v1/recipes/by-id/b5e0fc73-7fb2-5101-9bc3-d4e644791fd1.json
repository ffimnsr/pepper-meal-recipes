  "id": "b5e0fc73-7fb2-5101-9bc3-d4e644791fd1",
  "slug": "summery-strawberry-pie",
  "name": "Summery Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This summery strawberry pie recipe has a graham cracker crust, a sweetened Neufch\u00e2tel cheese custard filling, and a glazed fresh strawberry topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bake pie crust in the preheated oven until lightly browned, about 5 minutes. Cool completely."
    },
    {
      "position": 3,
      "text": "Beat Neufch\u00e2tel cheese, sugar, milk, and vanilla extract together in a bowl until smooth; spread into pie crust with a spatula."
    },
    {
      "position": 4,
      "text": "Arrange strawberries on top Neufch\u00e2tel mixture, cut-sides down, pushing slightly into filling; pour glaze over top."
    },
    {
      "position": 5,
      "text": "Refrigerate before serving, at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

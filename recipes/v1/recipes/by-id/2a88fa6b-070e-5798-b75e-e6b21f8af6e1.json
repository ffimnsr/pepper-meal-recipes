  "id": "2a88fa6b-070e-5798-b75e-e6b21f8af6e1",
  "slug": "crackling-cornbread",
  "name": "Crackling Cornbread",
  "recipe_type": "main",
  "brief_description": "Fried pork cracklings add a savory flavor to this spicy cornbread.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Stir together cornmeal, salt, and baking soda in a bowl; set aside. Place shortening into a 9-inch cast iron skillet; place in the preheated oven until the skillet is hot and shortening has melted."
    },
    {
      "position": 2,
      "text": "Bring some water to a boil in a small saucepan. Add pork cracklings and boil until tender, 5 to 8 minutes; drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, beat egg in a bowl along with jalape\u00f1o pepper and buttermilk; stir in cracklings. Stir in cornmeal mixture until moistened; pour batter into the preheated skillet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top of cornbread is brown, and feels firm to the touch, 30 to 40 minutes. Turn out onto a serving plate and cut into wedges; serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

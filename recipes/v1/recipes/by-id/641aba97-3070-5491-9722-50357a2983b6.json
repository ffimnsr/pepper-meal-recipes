  "id": "641aba97-3070-5491-9722-50357a2983b6",
  "slug": "tater-tot-taco-casserole",
  "name": "Tater Tot Taco Casserole",
  "recipe_type": "main",
  "brief_description": "This Mexican-inspired taco Tater Tot casserole is a fun and tasty twist on taco night. It\u2019s easy to make with ingredients you would normally have on hand.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Prepare a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Cook ground beef in a skillet over medium heat until completely browned, 5 to 7 minutes. Add in frozen corn, black beans, onion, garlic, and taco seasoning mix to ground beef; cook and stir another 10 minutes. Set aside to cool slightly."
    },
    {
      "position": 3,
      "text": "Combine ground beef mixture in a large bowl with about 3/4 of the Mexican cheese blend and the potato nuggets; stir to combine."
    },
    {
      "position": 4,
      "text": "Pour about 1/3 of the enchilada sauce into the bottom of the prepared baking dish. Add the tater tot mixture to the baking dish; lightly pat the mixture down into a solid, even layer. Pour remaining enchilada sauce over the potatoes."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 40 minutes. Sprinkle remaining cheese over the casserole and return to the oven until the cheese is melted and bubbly, about 5 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

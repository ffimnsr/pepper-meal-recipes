  "id": "d1da7a1f-6dfa-5cc8-9c09-63c2ae859ad9",
  "slug": "sheet-pan-general-tso-s-chicken-and-broccoli-recipe-8715504",
  "name": "Sheet Pan General Tso's Chicken and Broccoli",
  "recipe_type": "dessert",
  "brief_description": "This sheet pan General Tso\u2019s chicken and broccoli is for those days when you need a shortcut\u2014chicken nuggets to the rescue! Nuggets and broccoli roast together on a sheet pan, then are tossed with a sweet, spicy, savory sauce.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk sambal oelek, rice vinegar, hoisin sauce, soy sauce, sesame oil, brown sugar, and garlic together in a small saucepan. Heat over low heat until warm, about 5 minutes; set aside."
    },
    {
      "position": 3,
      "text": "Place broccoli florets in a microwave safe bowl. Microwave on High for 2 minutes. Add olive oil, salt, and pepper; toss to coat."
    },
    {
      "position": 4,
      "text": "Place nuggets on one half of a large baking sheet. Spread broccoli on the other half of the baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 6,
      "text": "Place nuggets in a large bowl. Drizzle sauce over the top, and toss until evenly coated. Serve chicken over rice with roasted broccoli. Garnish with green onions and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

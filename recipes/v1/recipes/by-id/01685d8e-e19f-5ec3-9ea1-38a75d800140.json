  "id": "01685d8e-e19f-5ec3-9ea1-38a75d800140",
  "slug": "slow-cooker-cheeseburger-soup-recipe-8718390",
  "name": "Slow Cooker Cheeseburger Soup",
  "recipe_type": "soup",
  "brief_description": "A fun and tasty soup that tastes like cheeseburgers. The garnishes are especially fun.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook ground beef and yellow onion in a large skillet over medium heat until browned, stirring to break up with a wooden spoon, about 8 minutes; drain fat."
    },
    {
      "position": 3,
      "text": "Transfer beef mixture to a 4- to 5-quart slow cooker. Add beef broth, potatoes, tomatoes, soup, tomato sauce, ketchup, and mustard. Stir to combine."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low 9 to 10 hours or on High 4 \u00bd to 5 hours, until potatoes are tender."
    },
    {
      "position": 5,
      "text": "Stir Cheddar cheese into the soup."
    },
    {
      "position": 6,
      "text": "Garnish servings with pickles, red onion, additional cheese, ketchup and mustard."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 15,

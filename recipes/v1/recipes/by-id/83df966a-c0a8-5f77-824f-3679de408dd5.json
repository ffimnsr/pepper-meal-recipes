  "id": "83df966a-c0a8-5f77-824f-3679de408dd5",
  "slug": "cottage-cheese-bread-recipe-8711903",
  "name": "Cottage Cheese Bread",
  "recipe_type": "side",
  "brief_description": "Cottage cheese bread is a simple bread with a neutral flavor like regular white bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine warm water and yeast in a large bowl. Let stand until foamy, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine the egg whites and cottage cheese in a blender or food processor. Cover and blend until smooth."
    },
    {
      "position": 4,
      "text": "Add cottage cheese mixture to the yeast mixture and whisk to combine."
    },
    {
      "position": 5,
      "text": "Using a wooden spoon, stir flour and salt into the wet mixture until combined (dough will be sticky)."
    },
    {
      "position": 6,
      "text": "Turn dough out onto a lightly floured surface and knead about 5 minutes or until smooth but still slightly tacky, adding additional flour as needed."
    },
    {
      "position": 7,
      "text": "Shape dough into a ball and place in a lightly greased bowl. Cover and let rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 8,
      "text": "Line a 9x5-inch loaf pan with parchment paper."
    },
    {
      "position": 9,
      "text": "Punch dough down and turn out onto a lightly floured surface. Gently pat and pinch dough into a loaf shape, tucking edges underneath."
    },
    {
      "position": 10,
      "text": "Place shaped dough, seam side down, in prepared loaf pan. Cover and let rise in a warm place until nearly double in size (about 30 minutes)."
    },
    {
      "position": 11,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Using a sharp knife, cut a shallow slit, lengthwise, down the middle of the loaf."
    },
    {
      "position": 12,
      "text": "Bake until bread sounds hollow when lightly tapped, 40 to 45 minutes. Cover loosely with foil for the last 10 to 15 minutes to prevent overbrowning."
    },
    {
      "position": 13,
      "text": "Immediately remove from pan and cool completely on a wire rack before slicing."
    },
    {
      "position": 14,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,

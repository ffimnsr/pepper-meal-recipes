  "id": "e87ab35e-bcfe-52fe-a59f-f35247a80558",
  "slug": "warm-blueberry-cobbler",
  "name": "Warm Blueberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Warm blueberry cobbler is made simple with this quick and easy recipe using 6 ingredients; serve warm with whipped cream or vanilla ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place blueberries in a 6x10-inch baking dish. Sprinkle lemon juice over blueberries."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, and egg together in a bowl until mixture resembles coarse crumbs; spread over blueberries. Drizzle butter over flour mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cobbler is bubbling, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

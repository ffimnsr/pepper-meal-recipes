  "id": "461d1057-5c00-5bf8-9660-5966f67ea0c0",
  "slug": "grilled-spicy-lamb-burgers",
  "name": "Grilled Spicy Lamb Burgers",
  "recipe_type": "main",
  "brief_description": "Something new for all the grill-daddies! An EASY burger to make, and guests rave over this one.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat grill for medium heat."
    },
    {
      "position": 2,
      "text": "Place the lamb in a large bowl, and mix with the mint, cilantro, oregano, garlic, sherry, vinegar, and molasses. Season with cumin, allspice, red pepper flakes, salt, and black pepper, and mix well. Shape into 4 patties."
    },
    {
      "position": 3,
      "text": "Brush grill grate with oil. Grill burgers 5 minutes on each side, or until well done. Heat the pita pocket briefly on the grill. Serve burgers wrapped in pitas with feta cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

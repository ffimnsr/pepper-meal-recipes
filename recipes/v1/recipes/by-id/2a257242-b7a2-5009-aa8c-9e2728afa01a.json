  "id": "2a257242-b7a2-5009-aa8c-9e2728afa01a",
  "slug": "pumpkin-bread",
  "name": "Pumpkin Bread",
  "recipe_type": "appetizer",
  "brief_description": "This bread actually tastes better after being frozen. I make a dozen batches in September and give them as Christmas gifts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two loaf pans."
    },
    {
      "position": 2,
      "text": "In a medium mixing bowl, combine flour, baking soda, salt, baking powder, nutmeg, allspice, cinnamon and cloves."
    },
    {
      "position": 3,
      "text": "In a large bowl with an electric mixer, blend sugar, oil and eggs. Stir in pumpkin. Slowly blend the flour mixture into pumpkin mixture. While blending the mixture add water incrementally. Pour the batter into two prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 90 minutes. Let cool for 10 minutes before removing from the pans."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,

  "id": "f81512af-030e-5cd4-a8b2-d236d75e1463",
  "slug": "zucchini-pineapple-bread-i",
  "name": "Zucchini Pineapple Bread",
  "recipe_type": null,
  "brief_description": "This zucchini pineapple bread is moist and fruity. It's like classic zucchini bread, complete with warm spices, plus pineapple for tropical pizzazz.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Mix sugar, oil, eggs, vanilla, sugar, cinnamon, and nutmeg together in a large bowl. Stir in zucchini and drained pineapple, then stir in dry ingredients. Pour batter into the prepared pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool on wire racks."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

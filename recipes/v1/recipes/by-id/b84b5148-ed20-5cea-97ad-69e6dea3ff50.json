  "id": "b84b5148-ed20-5cea-97ad-69e6dea3ff50",
  "slug": "fabulous-spinach-and-artichoke-dip",
  "name": "Fabulous Spinach and Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "Replicate a popular restaurant appetizer for a cheesy spinach and artichoke dip with this recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Thoroughly mix artichoke hearts, Alfredo sauce, spinach, Parmesan-Romano cheese, cream cheese, mozzarella cheese, garlic, and black pepper in a bowl; spread into an 8-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until cheeses are bubbling and melted, 25 to 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

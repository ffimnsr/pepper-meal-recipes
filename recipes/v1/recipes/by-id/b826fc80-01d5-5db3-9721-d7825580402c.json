  "id": "b826fc80-01d5-5db3-9721-d7825580402c",
  "slug": "foolproof-chocolate-fudge",
  "name": "Foolproof Chocolate Fudge",
  "recipe_type": "dessert",
  "brief_description": "This classic and truly foolproof fudge recipe will be a favorite for years to come. Try one of our suggested variations or personalize the fudge by adding your favorite ingredients to the basic recipe. Fudge also makes a great homemade gift to share with family and friends.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In heavy saucepan, over low heat, melt chocolate chips with sweetened condensed milk and salt. Remove from heat; stir in nuts (optional) and vanilla."
    },
    {
      "position": 2,
      "text": "Spread evenly into wax-paper-lined 8- or 9-inch square pan. Chill 2 hours or until firm."
    },
    {
      "position": 3,
      "text": "Life fudge out of pan and place onto cutting board; peel off paper and cut into squares. Store covered in refrigerator."
    }
  ],

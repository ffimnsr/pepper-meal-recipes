  "id": "e86419f9-718a-5c9a-8fe0-8ca90d9aa6bd",
  "slug": "pizza-sliders",
  "name": "Pizza Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These delicious pizza sliders with pepperoni and a flavorsome pizza sauce are loaded with cheese on Hawaiian rolls, and baked until golden and gooey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with parchment, and place a cooling rack on baking sheet. Spray rack with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir mozzarella, Italian cheese blend, basil, pepper, and 1 \u00bd teaspoons of the Italian seasoning together in a small bowl until combined. Set aside."
    },
    {
      "position": 3,
      "text": "Stir pizza sauce and pesto together in another small bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Without separating the individual rolls, cut the entire slab of rolls in half horizontally using a serrated knife. Place bottom layer of rolls on the prepared baking sheet. Set top layer of rolls aside."
    },
    {
      "position": 5,
      "text": "Sprinkle bottom layer of rolls evenly with half of the cheese mixture; top evenly with half of pepperoni and half of the sauce. Repeat layers once."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese melts, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, combine butter, Parmesan, garlic powder, and remaining 1/2 teaspoon Italian seasoning in a small saucepan; cook over medium, stirring occasionally, until butter melts, 1 to 2 minutes. Set aside."
    },
    {
      "position": 8,
      "text": "Remove rolls from oven, and add top layer of rolls; brush top of rolls evenly with butter mixture. Return to preheated oven, and bake until rolls are golden brown and crisp, about 5 minutes."
    },
    {
      "position": 9,
      "text": "Separate the rolls, and serve immediately."
    },
    {
      "position": 10,
      "text": "Enjoy! Recipe developed by Laura Kanya"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,

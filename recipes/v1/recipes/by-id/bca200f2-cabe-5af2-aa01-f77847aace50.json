  "id": "bca200f2-cabe-5af2-aa01-f77847aace50",
  "slug": "wild-goose-breasts-with-orange-glaze",
  "name": "Wild Goose Breasts with Orange Glaze",
  "recipe_type": "dessert",
  "brief_description": "This is a great recipe for that wild bird you're not sure what to do with. Sweet and tangy at the same time. Wild goose breasts are baked with a zesty orange glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Rinse the breasts in cold water, and place in baking dish. Splash with vermouth, then season with salt; set aside."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine orange zest, orange juice, lemon juice, brown sugar, garlic and soy sauce. Season with mustard and caraway. Pour glaze over breasts in baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 30 minutes, or until no longer pink and juices run clear. Baste at least twice during baking."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

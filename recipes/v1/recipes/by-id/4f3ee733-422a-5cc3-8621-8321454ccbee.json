  "id": "4f3ee733-422a-5cc3-8621-8321454ccbee",
  "slug": "scooters-vegan-tempeh-chili",
  "name": "Scooter's Vegan Tempeh Chili",
  "recipe_type": "soup",
  "brief_description": "Tempeh, bell peppers, and 3 kinds of beans simmer in a tasty, garlicky spice mix to make this vegan chili just perfect for chilly evenings.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium-high heat. Add carrots; cook until tender, about 5 minutes. Add onion and chopped garlic; cook and stir until aromatic, about 3 minutes. Add chili powder, paprika, garlic powder, and cumin; cook and stir for 1 minute. Toss in tempeh, red bell pepper, yellow bell pepper, and orange bell pepper; cook and stir until tempeh is coated in the spices, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour tomatoes, black beans, cannellini beans, kidney beans, corn, and brown sugar into the tempeh mixture. Reduce heat to low. Simmer, covered, until flavors are well blended, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 44,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

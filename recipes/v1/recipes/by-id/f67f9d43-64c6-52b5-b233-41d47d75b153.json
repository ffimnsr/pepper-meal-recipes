{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f67f9d43-64c6-52b5-b233-41d47d75b153",
  "slug": "walnut-shaped-cookies-with-dulce-de-leche",
  "name": "Walnut-Shaped Cookies with Dulce de Leche",
  "recipe_type": "dessert",
  "brief_description": "These adorable walnut-shaped butter cookies are sandwiched together with a sweet caramel, known as 'dulce de leche' in Latin America.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter and sugar with an electric mixer until fluffy. Mix in egg and vanilla extract. Add flour and salt and mix until just incorporated; overmixing will make the dough too stiff. Cover the dough with plastic wrap. Refrigerate for 30 to 60 minutes, or up to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Press about 1 teaspoonful of the chilled dough into the bottom and up the sides of each walnut-shaped mold. Place the molds on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned around the edges, 12 to 18 minutes. Cool for a few minutes. Lightly tap on the bottom of the mold to pop out the cookies. Let cool until easily handled."
    },
    {
      "position": 5,
      "text": "Spoon some dulce de leche onto the bottom of each cookie and sandwich the halves together."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5c4ddc6d-e535-5bc0-9330-71baba71ce9b",
  "slug": "strawberry-milk-bread-doughnuts-recipe-11986079",
  "name": "Strawberry Milk Bread Doughnuts",
  "recipe_type": "dessert",
  "brief_description": "These strawberry milk bread doughnuts are made with tangzhong, a cooked mixture of milk and flour that creates an exceptionally soft, fluffy texture and rich flavor. Finished with a sweet strawberry glaze made from real berries, they\u2019re a bakery-worthy treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare tangzhong: combine 1/2 cup of the milk and 3 tablespoons of the bread flour in a small pot. Cook over medium heat, whisking the entire time, until thickened, 2 to 4 minutes. Set aside to cool."
    },
    {
      "position": 2,
      "text": "Pour remaining milk into a microwave-safe bowl and microwave until warm but not hot, 15 to 20 seconds. Pour into the bowl of a stand mixer fitted with the hook attachment. Add tangzhong, yeast, and melted butter. Whisk together. Add eggs, yolks, sugar, remaining bread flour, and salt to the bowl."
    },
    {
      "position": 3,
      "text": "Knead with the hook attachment until a smooth dough forms, 7 to 8 minutes. Cover and let rise at room temperature for 1 hour, or overnight in the fridge."
    },
    {
      "position": 4,
      "text": "Line a baking sheet with parchment paper and lightly grease the paper"
    },
    {
      "position": 5,
      "text": "Lightly flour a work surface and empty the dough from the bowl onto the work surface. Roll out the dough with a rolling pin to \u00bd-inch thickness. Use a doughnut cutter to portion the dough and set on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Cover doughnuts loosely with plastic and allow to rise until they are very puffy and doubled in size, 60 to 90 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, for the glaze combine diced strawberries, sugar, lemon juice, and cornstarch in a small pot. Cook over medium heat until thickened, 2 to 3 minutes."
    },
    {
      "position": 8,
      "text": "Puree strawberry mixture in a food processor or with an immersion blender until smooth (or you can muddle until saucy if you prefer). Pour strawberry puree into a bowl and whisk in powdered sugar until smooth. Add milk and whisk to combine. Set aside."
    },
    {
      "position": 9,
      "text": "Heat 4 cups of oil in a pot over medium heat until it reaches 350 degrees F (180 degrees C)."
    },
    {
      "position": 10,
      "text": "Carefully lower doughnuts into the hot oil and fry for about 1 minute per side, flipping once it\u2019s turned golden brown. Drain on a wire rack until cool enough to pick up, but still little warm."
    },
    {
      "position": 11,
      "text": "Dip warm doughnuts into the strawberry glaze and return to the wire rack. Allow glaze to set for 10 minutes before serving."
    }
  ],

  "id": "633459ad-7fcd-592f-bb93-0b988e10cbc6",
  "slug": "cherry-cheesecake-dump-cake-recipe-11697086",
  "name": "Cherry Cheesecake Dump Cake",
  "recipe_type": "dessert",
  "brief_description": "This cherry cheesecake dump cake could not be easier. Cherry pie filling and vanilla cake mix are pantry staples you can keep on hand. Add cream cheese, butter, egg, and vanilla, and you're nearly there!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Pour pie filling into a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, egg, sugar and vanilla together in a bowl with an electric mixer until well combined and smooth. Spoon mixture over pie filling."
    },
    {
      "position": 3,
      "text": "Spread cake mix in an even layer over cream cheese mixture, taking care not to mix the layers. Pour melted butter over evenly over the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown and bubbly, 40 to 50 minutes. Let stand 10 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bcfc24ef-85ea-55c7-b503-dae7007e3c93",
  "slug": "swedish-rice-pudding",
  "name": "Swedish Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Swedish rice pudding is baked into a rich dessert that is creamy on the top and dense on the bottom; serve with whipped cream or berries.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a medium saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat the oven to 325 degrees F (165 degrees C). Grease an 8-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Stir milk into cooked rice until evenly combined. Mix in beaten eggs, sugar, pudding mix, butter, vanilla, and salt until incorporated; transfer to the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a knife inserted into pudding comes out clean, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "ec97f611-1859-55ff-afde-6454e157b94f",
  "slug": "fresh-strawberry-pie-i",
  "name": "Fresh Strawberry Pie with Jell-O",
  "recipe_type": "dessert",
  "brief_description": "This strawberry pie with Jell-O is super easy to make with strawberry gelatin and juicy strawberries for a fresh-tasting, no-bake summer dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk sugar and cornstarch together in a saucepan until completely blended."
    },
    {
      "position": 3,
      "text": "Pour in boiling water and cook over medium heat until mixture thickens and is clear in color, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat and stir in gelatin mix until smooth. Let mixture cool to room temperature, 15 to 30 minutes."
    },
    {
      "position": 5,
      "text": "While the mixture is cooling, place strawberries into baked pie shells with the points facing up."
    },
    {
      "position": 6,
      "text": "Pour cooled gelatin mixture over strawberries and refrigerate until set, about 2 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

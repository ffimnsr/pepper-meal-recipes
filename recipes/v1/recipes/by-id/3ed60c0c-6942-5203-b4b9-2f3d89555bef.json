  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3ed60c0c-6942-5203-b4b9-2f3d89555bef",
  "slug": "poblano-cream-sauce-recipe-11944971",
  "name": "Poblano Cream Sauce",
  "recipe_type": "side",
  "brief_description": "This poblano cream sauce is an incredibly versatile pepper sauce, and will become your new summer favorite. We use it on burgers, as a dipping sauce, and as the base for chicken enchiladas.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on the oven\u2019s broiler. Line a baking sheet with aluminum foil. Lay clean peppers on the foil."
    },
    {
      "position": 2,
      "text": "Broil peppers, turning often, until they are blackened on all sides, 5 to 7 minutes, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove from the oven and carefully place the peppers in a plastic bag. Leave a small opening for steam to escape; cool peppers until they can be handled easily, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Remove peppers from the bag. Using a paring knife, remove all the outside skin. Place peppers on a work surface and cut open. Remove all seeds and spine, then dice peppers."
    },
    {
      "position": 5,
      "text": "Melt butter in a heavy-bottomed saucepan over medium heat; add peppers and onions. Cook, stirring often, until onions are softened, 5 to 7 minutes. Add the garlic and stir to combine."
    },
    {
      "position": 6,
      "text": "Add stock and half-and-half to a large measuring cup. Whisk flour into stock mixture, 1 tablespoon at a time, until no lumps remain."
    },
    {
      "position": 7,
      "text": "Slowly add stock mixture to peppers, stirring as you go. Adjust heat if needed; cook, stirring frequently, until sauce has thickened."
    },
    {
      "position": 8,
      "text": "Season with salt, pepper and cumin, then taste to adjust. Add lime juice and cilantro, then stir and taste to see if it needs more seasoning."
    },
    {
      "position": 9,
      "text": "Sauce can be served chunky, or use an immersion blender to blend until smooth. Serve hot or warm."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

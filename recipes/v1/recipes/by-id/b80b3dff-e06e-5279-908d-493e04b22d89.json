  "id": "b80b3dff-e06e-5279-908d-493e04b22d89",
  "slug": "cajun-spiced-popcorn",
  "name": "Cajun-Spiced Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "This spicy popcorn is made by roasting popped corn with butter and a blend of spices to make a tasty crowd-pleasing snack that's perfect for game day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place popped popcorn in a large roasting pan."
    },
    {
      "position": 2,
      "text": "Combine melted butter, paprika, lemon pepper, salt, garlic powder, onion powder, and cayenne pepper in a small bowl; pour over popcorn and stir until it is somewhat evenly coated."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes, stirring every 5 minutes. Remove from the oven and cool completely. Serve immediately, or store in an airtight container for later."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

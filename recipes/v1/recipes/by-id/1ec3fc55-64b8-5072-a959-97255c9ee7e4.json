  "id": "1ec3fc55-64b8-5072-a959-97255c9ee7e4",
  "slug": "thick-style-flour-tortillas",
  "name": "Thick-Style Flour Tortillas",
  "recipe_type": "main",
  "brief_description": "While most flour tortilla recipes use lard or shortening, this one uses canola oil for the same great taste without animal or soy products.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, baking powder, and salt together in a large bowl."
    },
    {
      "position": 2,
      "text": "Combine water and canola oil in a separate bowl. Mix into the flour mixture with a fork until dough forms a ball, adding 1/4 cup water if dough is too dry."
    },
    {
      "position": 3,
      "text": "Knead dough until smooth, 3 to 4 minutes. Divide into 14 egg-size balls. Cover bowl with a cotton towel. Let dough rest for 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Roll 1 ball dough into an 8-inch tortilla on a floured work surface. Repeat with remaining dough."
    },
    {
      "position": 5,
      "text": "Preheat an ungreased cast iron griddle on medium-high heat. Place 1 tortilla on the hot griddle; cook until browned spots form, about 1 minute per side. Transfer to a plate; cover with a cotton towel to keep warm. Repeat with remaining tortillas, stacking them under the towel."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "easy",

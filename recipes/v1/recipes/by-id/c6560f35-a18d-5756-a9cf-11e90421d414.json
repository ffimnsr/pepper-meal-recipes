  "id": "c6560f35-a18d-5756-a9cf-11e90421d414",
  "slug": "easy-marinated-pork-tenderloin",
  "name": "Easy Marinated Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "This pork tenderloin marinade made with olive oil, soy, garlic, and honey mustard results in a juicy, flavorful roast pork with minimal prep.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, soy sauce, garlic, mustard, salt, and pepper together in a bowl."
    },
    {
      "position": 2,
      "text": "Place pork in a large resealable plastic bag and pour in marinade; squeeze out excess air, and seal the bag. Marinate in the refrigerator at least 1 hour before cooking."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Transfer pork to a baking dish; pour marinade over the pork."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven until pork is slightly pink in the center, about 45 to 60 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

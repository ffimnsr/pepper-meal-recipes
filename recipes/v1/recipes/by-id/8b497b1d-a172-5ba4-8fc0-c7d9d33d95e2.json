  "id": "8b497b1d-a172-5ba4-8fc0-c7d9d33d95e2",
  "slug": "eggs-benedict-with-salmon",
  "name": "Eggs Benedict with Salmon",
  "recipe_type": "breakfast",
  "brief_description": "Eggs Benedict with a twist! This smoked salmon Benedict features a delicate yogurt and lemon sauce that perfectly complements savory smoked salmon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the sauce: In the top of a double boiler, whisk together yogurt, lemon juice, egg yolks, mustard, salt, sugar, pepper, and hot sauce. Cook over simmering water, stirring constantly, 6 to 8 minutes, or until sauce is thick enough to coat the back of the spoon."
    },
    {
      "position": 2,
      "text": "In a large stock pot, heat 2 quarts of salted water to a boil. Carefully break eggs one at a time into boiling water. When all eggs have been added, reduce the heat to medium. When eggs float to the top, remove them with a slotted spoon and let drain briefly."
    },
    {
      "position": 3,
      "text": "To assemble final dish: Toast bread slices and place on warm plates. Top each piece of toast with a slice of smoked salmon and a hot poached egg. Drizzle with yogurt sauce; garnish with parsley and capers."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "64ef02db-b85c-5a9a-8ef7-2c68f3cc7e33",
  "slug": "gluten-free-sandwich-cookies-with-dulce-de-leche-alfajores",
  "name": "Gluten-Free Sandwich Cookies with Dulce de Leche (Alfajores)",
  "recipe_type": "dessert",
  "brief_description": "These Alfajores gluten-free sandwich cookie treats are very popular in Latin cultures. The recipe is simply made with cornstarch and dulce de leche.",
  "cuisine": "Argentine",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk cornstarch, flour, baking powder, and baking soda together in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar together in a separate bowl with an electric mixer until light and fluffy. Whisk in egg yolks, one at a time, until well combined, adding lemon zest and vanilla extract with last yolk. Fold into flour mixture with a spoon, mixing until dough holds together and forms a ball. Wrap in plastic wrap; refrigerate for 30 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Roll dough out to about \u00bc-inch thickness; cut with a small round cookie cutter and place on the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set but not browned, 7 to 10 minutes. Transfer immediately to cool on a wire rack."
    },
    {
      "position": 6,
      "text": "Spread flat underside of 1 cookie with 1 teaspoon dulce de leche. Sandwich together with another cookie until filling comes out on the sides; roll sides in shredded coconut. Repeat with remaining cookies, dulce de leche, and coconut."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "70bdf878-b457-5b62-b96e-c42013af8f4f",
  "slug": "philly-steak-sandwich",
  "name": "Philly Cheesesteak",
  "recipe_type": "main",
  "brief_description": "This Philly cheesesteak has perfectly tender sliced steak and caramelized onions in a roll topped with melted cheese to make the ultimate sandwich.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix salt, pepper, paprika, chili powder, onion powder, garlic powder, thyme, marjoram, and basil together in a small bowl."
    },
    {
      "position": 3,
      "text": "Place steak in a large bowl; sprinkle seasoning mixture over top and stir to coat."
    },
    {
      "position": 4,
      "text": "Heat 1/2 of the oil in a skillet over medium-high heat. Add steak in batches if needed to avoid overcrowding the skillet; cook until browned and just cooked through. Transfer cooked steak to a plate."
    },
    {
      "position": 5,
      "text": "Heat the remaining oil in the skillet. Add onion and green pepper; cook and stir until tender and caramelized."
    },
    {
      "position": 6,
      "text": "Preheat the oven on the broiler setting. Divide cooked beef between the bottoms of 4 rolls."
    },
    {
      "position": 7,
      "text": "Layer with onion and green pepper."
    },
    {
      "position": 8,
      "text": "Top with sliced cheese. Place on a cookie sheet."
    },
    {
      "position": 9,
      "text": "Broil in the preheated oven until cheese is melted."
    },
    {
      "position": 10,
      "text": "Cover with tops of rolls and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "739556fe-b3b6-528f-9dcd-2600b77a43ed",
  "slug": "shipwreck-stew-recipe-11924375",
  "name": "Shipwreck Stew",
  "recipe_type": "soup",
  "brief_description": "This shipwreck stew is similar to a traditional ground beef chili but more hearty and filling. It's easy to make and you probably have most of the ingredients in your pantry already.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Brown ground beef and onion in a 4- to 6-quart Dutch oven over medium heat, stirring with a wooden spoon to break into small pieces."
    },
    {
      "position": 2,
      "text": "Layer potatoes, celery, beans, corn, and undrained tomatoes over the beef mixture. Sprinkle with chili powder, Worcestershire sauce, salt, pepper, and crushed red pepper, if using. Pour broth over all."
    },
    {
      "position": 3,
      "text": "Bring to a boil. Reduce heat and simmer, covered, stirring once or twice, until potatoes are tender and flavors are combined, 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

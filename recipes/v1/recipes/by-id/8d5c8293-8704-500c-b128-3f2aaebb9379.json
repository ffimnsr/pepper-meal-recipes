  "id": "8d5c8293-8704-500c-b128-3f2aaebb9379",
  "slug": "easy-garlic-escargots",
  "name": "Easy Garlic Escargots",
  "recipe_type": "appetizer",
  "brief_description": "This escargot recipe is made with canned escargots cooked in butter and garlic, stuffed into mushroom caps, then baked with wine sauce and cheese.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place escargots in a small bowl and cover with cold water. Let sit for 5 minutes to remove any canned flavor they may have. Drain escargots and pat dry with a paper towel."
    },
    {
      "position": 3,
      "text": "Melt butter with garlic in a large skillet over medium-high heat. Add escargots and mushroom caps; cook and stir until mushroom caps begin to soften, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Whisk together wine, cream, flour, tarragon, and pepper in a small bowl until well combined. Pour into the skillet and bring to a boil. Cook, stirring occasionally, until sauce thickens, about 10 minutes. Remove from the heat."
    },
    {
      "position": 5,
      "text": "Place mushroom caps into the prepared baking dish, with the tops facing down. Spoon an escargot into each mushroom cap. Pour sauce from the skillet over mushroom caps, then sprinkle grated Parmesan cheese over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese has turned golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

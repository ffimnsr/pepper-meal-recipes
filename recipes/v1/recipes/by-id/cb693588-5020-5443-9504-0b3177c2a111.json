  "id": "cb693588-5020-5443-9504-0b3177c2a111",
  "slug": "roast-potatoes",
  "name": "Roast Potatoes",
  "recipe_type": "side",
  "brief_description": "Learn how long to bake potatoes at 450\u00b0F with this simple and delicious recipe for creamy, oven-roasted baby red potatoes seasoned with rosemary.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (250 degrees C) and gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large roasting pan and toss with oil, salt, pepper, and rosemary until evenly coated."
    },
    {
      "position": 3,
      "text": "Spread out potatoes in a single layer."
    },
    {
      "position": 4,
      "text": "Bake, stirring occasionally, in the preheated oven until tender, about 20 minutes. Serve warm."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

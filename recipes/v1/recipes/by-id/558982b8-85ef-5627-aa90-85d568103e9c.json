  "schema_version": 1,
  "id": "558982b8-85ef-5627-aa90-85d568103e9c",
  "slug": "peach-snack-cake-recipe-11976197",
  "name": "Peach Snack Cake",
  "recipe_type": "dessert",
  "brief_description": "This peach snack cake showcases sweet summer peaches in a tender, buttery cake. Finished with a simple glaze, it\u2019s an easy dessert that feels special enough for any occasion. If you can't find fresh fruit in season, this recipe also works with frozen or juice-packed canned peaches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch square baking pan with parchment paper and lightly coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking powder, baking soda, and salt in a bowl for the cake. Set aside."
    },
    {
      "position": 3,
      "text": "Beat butter in a large bowl with an electric mixer on medium speed for about 30 seconds. Add sugar and beat until light and fluffy, about 3 minutes. Add eggs, one at a time, beating well after each addition."
    },
    {
      "position": 4,
      "text": "Add sour cream and vanilla; beat until combined. Add flour mixture to butter mixture and fold gently with a rubber spatula until just combined. Fold in diced peaches, being careful not to overmix."
    },
    {
      "position": 5,
      "text": "Spread batter evenly into the prepared pan. Arrange sliced peaches over the top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, 45 to 55 minutes. Cool in the pan on a wire rack for 10 minutes. Remove cake from the pan using the parchment overhang and cool completely on the wire rack, about 1 hour."
    },
    {
      "position": 7,
      "text": "For the glaze, whisk together powdered sugar, almond extract, and salt. Add milk, 1 tablespoon at a time, until smooth and pourable. Drizzle over cooled cake before serving. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

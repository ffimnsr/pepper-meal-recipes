  "id": "49c28200-045c-50d5-9930-e14cd1f2491a",
  "slug": "mamaws-chicken-and-rice-casserole",
  "name": "Mamaw's Chicken and Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This creamy chicken and rice casserole is quick and easy to put together and will remind you of your grandma's cooking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease sides and bottom of a casserole dish."
    },
    {
      "position": 2,
      "text": "Stir chicken, water, rice, cream of chicken soup, cream of celery soup, and cream of mushroom soup together in the prepared casserole dish; season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Arrange butter evenly over the top of the chicken mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the rice is tender and the chicken is cooked through, 60 to 75 minutes."
    },
    {
      "position": 5,
      "text": "Cool 10 to 15 minutes before serving. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

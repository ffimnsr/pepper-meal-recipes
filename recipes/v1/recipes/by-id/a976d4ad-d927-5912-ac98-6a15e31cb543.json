  "id": "a976d4ad-d927-5912-ac98-6a15e31cb543",
  "slug": "tonyas-terrific-sloppy-joes",
  "name": "Tonya's Terrific Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "This recipe is a really simple, quick, and tasty Sloppy Joe. I make this on the stovetop, but you can also let this simmer in a slow cooker after browning the ground beef, if you prefer.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place a large skillet over medium-high heat. Crumble ground beef into skillet; add onion and celery. Cook and stir beef mixture until beef is completely browned, 7 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir ketchup, brown sugar, Worcestershire sauce, vinegar, mustard, and lemon juice through the beef mixture. Reduce heat to medium-low and cook mixture at a simmer until mixture is hot and sauce has thickened, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

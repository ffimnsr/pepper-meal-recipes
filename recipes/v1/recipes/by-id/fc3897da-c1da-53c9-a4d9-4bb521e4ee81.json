  "id": "fc3897da-c1da-53c9-a4d9-4bb521e4ee81",
  "slug": "perfect-flat-iron-steak",
  "name": "Perfect Flat Iron Steak",
  "recipe_type": "main",
  "brief_description": "This flat iron steak recipe includes a garlic-herb marinade to bring out the best flavor in this perfectly cooked, tender cut of beef.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place steak inside a large resealable bag. Stir olive oil, garlic, parsley, rosemary, chives, red wine, salt, pepper, and mustard powder together in a small bowl."
    },
    {
      "position": 2,
      "text": "Pour marinade over steak in the bag. Press out as much air as you can and seal the bag. Marinate in the refrigerator for 2 to 3 hours."
    },
    {
      "position": 3,
      "text": "Heat a nonstick skillet over medium-high heat. Place steak in the hot skillet and discard any remaining marinade; sear and cook steak for 3 to 4 minutes on each side for medium rare, or to your desired degree of doneness. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C) for medium rare."
    },
    {
      "position": 4,
      "text": "Allow steak to rest for about 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

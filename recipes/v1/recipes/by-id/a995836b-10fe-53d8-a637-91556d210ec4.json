  "id": "a995836b-10fe-53d8-a637-91556d210ec4",
  "slug": "pumpkin-whoopie-pies",
  "name": "Pumpkin Whoopie Pies",
  "recipe_type": "dessert",
  "brief_description": "Pumpkin whoopie pies with a simple, sweet filling make a perfect treat everyone is sure to love. These are a perfect addition to the holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease baking sheets."
    },
    {
      "position": 2,
      "text": "To make the cookie dough: Combine brown sugar and oil in a bowl. Mix in pumpkin and eggs, beating well. Add flour, cinnamon, ginger, cloves, salt, baking powder, baking soda, and vanilla together into a separate bowl. Fold dry ingredients into wet ingredients and mix to combine."
    },
    {
      "position": 3,
      "text": "Drop dough by heaping teaspoons onto the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies spring back when lightly touched, 10 to 12 minutes . Cool on baking sheets briefly before transferring to wire racks to cool completely while you make the filling."
    },
    {
      "position": 5,
      "text": "To make the whoopie pie filling: Beat egg white in a bowl and mix in milk, vanilla, then 1 cup confectioners' sugar. Mix well then beat in shortening and remaining 1 cup confectioners' sugar. Beat until light and fluffy."
    },
    {
      "position": 6,
      "text": "Assemble once cookies are cool. Make sandwiches from two cookies filled with whoopie pie filling."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

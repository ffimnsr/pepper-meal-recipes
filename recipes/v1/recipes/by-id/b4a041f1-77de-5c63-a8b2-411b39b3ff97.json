  "id": "b4a041f1-77de-5c63-a8b2-411b39b3ff97",
  "slug": "roasted-vegetable-chicken",
  "name": "Roasted Vegetable Chicken",
  "recipe_type": "main",
  "brief_description": "A whole roasted chicken with carrots, celery, onion, and potatoes. This dish is hearty and delicious on a cold evening \u2014 or any time!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Season chicken with salt and pepper; place in a large roasting pan. Arrange onions, potatoes, carrots, and celery around chicken. Pour water into the pan. Cover the pan tightly with aluminum foil."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven, basting occasionally, until chicken is golden brown, about 2 hours; remove aluminum foil for the last 30 minutes of cooking. An instant-read thermometer inserted into a thigh should read at least 165 degrees F (74 degrees C). Allow chicken to rest for 10 minutes before carving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

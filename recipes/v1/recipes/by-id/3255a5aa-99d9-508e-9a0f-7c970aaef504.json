  "id": "3255a5aa-99d9-508e-9a0f-7c970aaef504",
  "slug": "no-cook-overnight-oatmeal",
  "name": "Easy Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Overnight oats make a delicious make-ahead breakfast for busy mornings. This recipe is easy to customize with your favorite berries, nuts, and seeds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine milk, yogurt, oats, honey, chia seeds, and cinnamon in a \u00bd-pint jar with a lid; cover and shake until combined."
    },
    {
      "position": 3,
      "text": "Fold in blueberries."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate, 8 hours to overnight. Enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,

  "id": "f216291a-3d1e-5340-a088-ac45a525fd21",
  "slug": "mushy-peas-i",
  "name": "Mushy Peas",
  "recipe_type": "side",
  "brief_description": "These vibrant mushy peas are simple to make with green peas, cream, and pepper for a classic side dish for any fried fish, especially cod.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a shallow pot of lightly salted water to a boil over medium-high heat. Add frozen peas, and cook for 3 minutes, or until tender."
    },
    {
      "position": 3,
      "text": "Drain peas and transfer to a blender or large food processor. Add cream, butter, salt , and pepper; process until blended, but still thick with small pieces of peas."
    },
    {
      "position": 4,
      "text": "Adjust seasonings to taste, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

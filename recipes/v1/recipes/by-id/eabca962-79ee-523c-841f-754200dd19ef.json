  "id": "eabca962-79ee-523c-841f-754200dd19ef",
  "slug": "pumpkin-chocolate-chip-cookies-iii",
  "name": "Pumpkin Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin chocolate chip cookies recipe creates a cake-like cookies that include chocolate, nuts, and warm spices for the perfect fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet; set aside."
    },
    {
      "position": 2,
      "text": "Mix pumpkin, sugar, oil, and egg together in a large bowl. Stir baking soda and milk together in a small bowl until baking soda dissolves. Stir into pumpkin mixture until well combined."
    },
    {
      "position": 3,
      "text": "Stir flour, baking powder, cinnamon, and salt together in a medium bowl. Add flour mixture to pumpkin mixture until well combined. Fold in chocolate chips, walnuts, and vanilla extract until just combined."
    },
    {
      "position": 4,
      "text": "Drop by spoonful on the prepared baking sheet; bake in the preheated oven until golden and firm, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Let cool on the baking sheet for 2 minutes; transfer to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

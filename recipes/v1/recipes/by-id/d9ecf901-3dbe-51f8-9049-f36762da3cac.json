  "id": "d9ecf901-3dbe-51f8-9049-f36762da3cac",
  "slug": "vegan-chocolate-cake",
  "name": "Vegan Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "A simple vegan cake recipe made with flour, sugar, cocoa, vanilla, and oil. This tender and moist chocolate cake will delight everyone, vegan or not!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 3,
      "text": "Sift flour, sugar, cocoa, baking soda, and salt together in a large bowl."
    },
    {
      "position": 4,
      "text": "Add water, oil, vanilla, and vinegar; mix together until smooth."
    },
    {
      "position": 5,
      "text": "Pour mixture into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes."
    },
    {
      "position": 7,
      "text": "Serve with berries."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "aef68da5-8f2f-5ed9-925c-6d1a1f23ab92",
  "slug": "my-big-fat-greek-omelet",
  "name": "My Big Fat Greek Omelet",
  "recipe_type": "breakfast",
  "brief_description": "If you\u2019re low-carbing it, try my spinach omelet with tomato and feta filling. If you thaw the spinach and squeeze it dry the night before, this omelet is very doable even for speedy weekday breakfasts.",
  "cuisine": "Greek Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a 12-inch non-stick skillet over low heat. Mix tomatoes, 1/2 teaspoon oregano, 1/4 teaspoon salt, and ground black pepper together in a small bowl. Stir in feta cheese."
    },
    {
      "position": 2,
      "text": "Whisk eggs together in a medium bowl. Stir in spinach, remaining 1/2 teaspoon oregano, remaining 1/4 teaspoon salt, and ground black pepper."
    },
    {
      "position": 3,
      "text": "Add olive oil to the skillet and increase heat to medium-high. Heat until oil is shimmering. Pour in egg mixture. Push set eggs toward the center with a plastic or wooden spatula, tilting the skillet to allow uncooked egg to flow onto the empty portions. Continue cooking until eggs are set with no visible liquid remaining, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Reduce heat to low. Spoon tomato mixture over half of the omelet. Fold untopped half over filling with a spatula. Slide omelet onto a cutting board. Let stand for 1 to 2 minutes for filling to warm."
    },
    {
      "position": 5,
      "text": "Cut the omelet into 4 wedges and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

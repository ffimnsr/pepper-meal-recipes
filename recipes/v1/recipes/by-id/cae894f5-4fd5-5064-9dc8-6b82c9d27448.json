  "id": "cae894f5-4fd5-5064-9dc8-6b82c9d27448",
  "slug": "oat-applesauce-muffins",
  "name": "Oat Applesauce Muffins",
  "recipe_type": "appetizer",
  "brief_description": "These hearty muffins will fill you up with fiber and flavor instead of fat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place oats in a small bowl, pour in buttermilk. Let sit for two hours at room temperature."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners."
    },
    {
      "position": 3,
      "text": "In a large bowl, stir together whole wheat flour, baking powder, baking soda and brown sugar. Stir in oat/buttermilk mixture, applesauce and egg; mix well. Pour batter into prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 30 minutes, until a toothpick inserted into center of muffin comes out clean."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

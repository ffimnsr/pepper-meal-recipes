  "id": "33adfe44-513d-5970-b5c2-d85e5a1ab470",
  "slug": "peach-blueberry-pie",
  "name": "Peach Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This double-crust peach blueberry pie with fresh berries and sweet summer peaches has a delicious flavor combination that's sure to please.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Arrange one pie crust in a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Toss peaches and blueberries in a bowl with lemon juice. Mix sugar, tapioca, and salt in a small bowl and add to peach mixture; stir to combine. Allow fruit to rest for 15 minutes."
    },
    {
      "position": 3,
      "text": "Transfer fruit into prepared pie crust. Scatter butter pieces over fruit and brush the edge of the pie with water. Cover pie with remaining crust; press and seal the top and bottom crusts."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is golden brown and fruit is bubbly, 45 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

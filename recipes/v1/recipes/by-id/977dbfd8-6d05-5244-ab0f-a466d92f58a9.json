  "id": "977dbfd8-6d05-5244-ab0f-a466d92f58a9",
  "slug": "ooey-gooey-lemon-monkey-bread-recipe-11694337",
  "name": "Ooey-Gooey Lemon Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "This ooey gooey lemon monkey bread is easy to make with store-bought biscuit dough.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C) with a rack positioned in lower third position. Grease a (12-cup) Bundt pan with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Combine granulated sugar and lemon zest in a large bowl; rub sugar and zest together until fragrant. Add biscuit pieces and toss to coat each piece evenly with sugar mixture; do not shake off excess sugar."
    },
    {
      "position": 3,
      "text": "Arrange pieces in the prepared pan."
    },
    {
      "position": 4,
      "text": "Melt butter, corn syrup, lemon extract, and any remaining lemon-sugar mixture (scant 1/2 cup) in a small saucepan over medium heat, whisking constantly until sugar is dissolved and mixture is fully combined. Pour butter mixture evenly over biscuits in the pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until biscuits are golden brown and a thermometer inserted into the outer edges of the center biscuits registers 190 degrees F (87 degrees C), about 40 minutes. Let cool in the pan for 10 minutes before inverting onto a serving platter."
    },
    {
      "position": 6,
      "text": "Microwave frosting in a small microwave-safe bowl until runny, 10 to 15 seconds. Stir in vanilla until smooth. Drizzle glaze evenly over Monkey Bread. Recipe developed by Julia Levy"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1c8929b9-b519-5032-b1dc-e76b7798063b",
  "slug": "pan-fried-turkey-burgers",
  "name": "Pan-Fried Turkey Burgers",
  "recipe_type": "main",
  "brief_description": "You don't need a grill to prepare these flavorful pan-fried turkey burgers that are super easy to make on the stovetop.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grate shallot with a medium plane of a grater into a large bowl. Be sure to collect the juice. Add turkey, mayonnaise, steak sauce, and parsley. Mix gently with your hands until fully incorporated. Divide into 4 equal portions and gently form into patties. Season tops with garlic salt and pepper."
    },
    {
      "position": 2,
      "text": "Spray a large skillet with cooking spray and place over medium-high heat. When the pan is hot, place in burgers, seasoned-sides down. Season the opposite sides with more garlic salt and pepper. Cook until browned, 4 to 5 minutes. Flip; continue to cook until no longer pink, 4 to 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "39e711d4-dbf0-5a9b-abf8-e6e7b50425ef",
  "slug": "korean-soft-tofu-stew-soon-du-bu-jigae",
  "name": "Korean Soft Tofu Stew (Soon Du Bu Jigae)",
  "recipe_type": "soup",
  "brief_description": "This versatile tofu stew is hearty and simple to make. Use more Korean chile powder for an added kick or toss in a few clams for an even more exotic treat.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the vegetable oil in a large saucepan over medium heat. Stir in the Korean chile powder and ground beef. Cook and stir until the beef is crumbly, evenly browned, and no longer pink. Stir in the soy bean paste, coating the beef. Pour in the water and bring to a boil. Season with salt and pepper. Gently drop tofu into the soup and continue cooking until the tofu is heated through, 1 to 2 minutes. Remove from heat and quickly add the egg into the soup, stirring gently to break it up. Garnish with sesame seeds and green onion."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,

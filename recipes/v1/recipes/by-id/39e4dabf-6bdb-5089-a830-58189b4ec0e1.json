  "slug": "salmon-brine-thats-oh-so-fine",
  "name": "Salmon Brine That's Oh-So-Fine",
  "recipe_type": "dessert",
  "brief_description": "This salty-sweet salmon brine recipe is divine. Everyone will rave about it. Serve the salmon on a baguette with sour cream-dill-horseradish sauce.",
  "cuisine": "American Eastern European Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Place peppercorns in a resealable plastic bag, seal the bag, and crush on a flat work surface using a rolling pin."
    },
    {
      "position": 2,
      "text": "Combine crushed peppercorns, water, salt, brown sugar, honey, maple syrup, white sugar, jalape\u00f1os, garlic, and onion powder in a large bowl, stirring until sugars and salt completely dissolved."
    }
  ],

  "id": "112bddab-a30a-5bc5-9923-5ce0f85157f9",
  "slug": "lemon-butter-swim-biscuits-recipe-11935532",
  "name": "Lemon Butter Swim Biscuits",
  "recipe_type": "dessert",
  "brief_description": "These lemon butter swim biscuits are like a warm Danish, rich from the butter, with great lemon flavor, and lightly sweet. Crunchy at the edges, soft in the center, they're irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place butter in a 2-quart square glass baking dish and microwave on High until melted."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, salt, and 1 teaspoon lemon zest together in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk together 2 cups buttermilk, 1/2 cup lemon curd, and 1 tablespoon lemon juice in a bowl until smooth. Add to flour mixture. Stir just until combined."
    },
    {
      "position": 4,
      "text": "Pour batter into the baking dish over the melted butter without stirring."
    },
    {
      "position": 5,
      "text": "Dollop remaining 1/4 cup lemon curd evenly over the batter. Score the batter into 9 to 12 portions using a knife."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until biscuits are evenly browned and cooked through and the center registers 195 to 200 degrees F (90 to 93 degrees C) on an instant-read thermometer, 30 minutes. Cool for 5 minutes on a wire rack."
    },
    {
      "position": 7,
      "text": "Whisk powdered sugar, 1 tablespoon buttermilk, 2 teaspoons lemon juice, and 1 teaspoon lemon zest together in a medium bowl until smooth. Pour glaze over warm biscuits and spread evenly."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

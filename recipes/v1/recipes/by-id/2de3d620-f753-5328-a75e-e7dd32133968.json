  "id": "2de3d620-f753-5328-a75e-e7dd32133968",
  "slug": "chili-bacon-cinnamon-rolls-recipe-8605019",
  "name": "Chili-Bacon Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "These chili-bacon cinnamon rolls are a change of pace from classic cinnamon rolls, Just add bacon for a savory-sweet riff on purchased rolls that is worth the hype.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round cake pan."
    },
    {
      "position": 2,
      "text": "Unroll cinnamon roll dough. Sprinkle evenly with chili powder, then separate along perforations into 5 portions."
    },
    {
      "position": 3,
      "text": "Cook bacon in a very large skillet until just starting to crisp, about 7 minutes. While bacon is still warm, lay 2 slices on each dough portion; roll up. Arrange in the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned and tops appear dry, about 25 minutes. Frost with icing. Add desired toppers (if using). Serve warm."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "0176c030-3e56-5358-b872-ca4068859f6f",
  "slug": "classic-minute-rice-pudding",
  "name": "Classic Minute Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Here's our favorite and most requested rice pudding recipe! Everyone will want to taste this classic dessert with dinner!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, rice, sugar, raisins and salt in medium saucepan. Bring to a boil, stirring constantly. Reduce heat to medium-low; simmer 6 minutes, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Beat eggs and vanilla lightly in a small bowl. Stir small amount of hot mixture into eggs. Stirring constantly, slowly pour egg mixture back into hot mixture. Stirring constantly, cook on low heat 1 minute until thickened. DO NOT BOIL."
    },
    {
      "position": 3,
      "text": "Remove from heat. Let stand 30 minutes. If desired, sprinkle with cinnamon. Serve warm. Store any remaining pudding in refrigerator."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

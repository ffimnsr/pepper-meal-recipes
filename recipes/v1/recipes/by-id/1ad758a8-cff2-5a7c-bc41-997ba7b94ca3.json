  "id": "1ad758a8-cff2-5a7c-bc41-997ba7b94ca3",
  "slug": "sweet-and-spicy-gochujang-chicken-recipe-7497391",
  "name": "Sweet and Spicy Gochujang Chicken",
  "recipe_type": "dessert",
  "brief_description": "Sauteed chicken is cooked in a sweet and spicy sauce featuring Korean gochujang sauce and honey in this quick and easy wok dish. Serve over rice.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together gochujang, soy sauce, sweet rice wine, honey, garlic, sesame oil, and ginger in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat oil over medium-high in a wok or large skillet. Add half of the chicken to the wok; cook and stir over medium-high until chicken is no longer pink, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Remove chicken from the wok. Repeat with remaining chicken. Return all cooked chicken pieces to the wok."
    },
    {
      "position": 5,
      "text": "Stir sauce well. Add to the wok; cook and stir until sauce has thickened and is bubbly, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Top with sesame seeds and green onions. Serve immediately with rice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

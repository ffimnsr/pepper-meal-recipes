  "id": "70bbab1e-1eee-51bd-8c22-d009cb8d3769",
  "slug": "pierogi-cabbage-casserole-recipe-11835383",
  "name": "Pierogi Cabbage Casserole",
  "recipe_type": "soup",
  "brief_description": "This casserole combines tender cabbage, sweet onion, and garlic with a creamy, savory sauce of cream cheese, sour cream, and chicken broth. It features cheesy pierogies and smoky kielbasa, all topped with melted Swiss cheese.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in a 12-inch skillet over medium heat. Add cabbage and onion. Cook and stir until tender and wilted, 10 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Add garlic, salt, paprika, thyme, and cayenne pepper. Cook and stir until fragrant, 1 minute."
    },
    {
      "position": 4,
      "text": "Whisk together cream cheese and sour cream in a large bowl until well combined. Whisk in broth until smooth. Fold in cabbage mixture, pierogies, kielbasa, and 1 cup Swiss cheese until combined. Spread out in the prepared baking dish. Cover with foil."
    },
    {
      "position": 5,
      "text": "Bake for 25 minutes. Remove foil and sprinkle with remaining 1 cup Swiss cheese."
    },
    {
      "position": 6,
      "text": "Bake until hot and bubbly and cheese is melted, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

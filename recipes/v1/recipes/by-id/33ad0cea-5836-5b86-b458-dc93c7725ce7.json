  "id": "33ad0cea-5836-5b86-b458-dc93c7725ce7",
  "slug": "fried-egg-tortilla-recipe-7561904",
  "name": "Fried Egg Tortilla",
  "recipe_type": "breakfast",
  "brief_description": "This recipe shows you how to fry an egg, melt the cheese, and warm your tortilla all at once in the same pan. Add your favorite toppings\u2013like salsa, jalape\u00f1o pepper slices, cilantro, and green onions\u2013and enjoy a great tasting breakfast, done in a flash.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "In a 10-inch nonstick skillet, melt butter over medium heat, and swirl the pan to coat the bottom evenly."
    },
    {
      "position": 2,
      "text": "Carefully break egg into buttered skillet and cook until egg white is opaque and egg is firm enough to turn, about 1 minute."
    },
    {
      "position": 3,
      "text": "Turn egg over, being careful not to break yolk; sprinkle with taco seasoning and about half of cheese."
    },
    {
      "position": 4,
      "text": "Gently place tortilla over egg and cheese, and cook about 1 minute. Using a silicone egg turner, flip the egg and tortilla, as one."
    },
    {
      "position": 5,
      "text": "Sprinkle remaining cheese on top of the egg, and continue cooking until the egg is done to your liking and the tortilla is warm and toasty, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Slide tortilla and egg to a serving plate and serve warm."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 4,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

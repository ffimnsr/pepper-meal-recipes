  "schema_version": 1,
  "id": "418ab3b0-0f76-5661-8272-6ba1d1f947e1",
  "slug": "eggplant-parmesan-with-easy-homemade-sauce",
  "name": "Eggplant Parmesan With Easy Homemade Sauce",
  "recipe_type": "main",
  "brief_description": "Breaded eggplant slices in an easy homemade tomato sauce are baked under a topping of Parmesan cheese in this Italian-inspired favorite.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease an 8x14-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix seasoned bread crumbs, 1/4 cup Parmesan cheese, and red pepper flakes in a shallow bowl. Brush eggplant slices with olive oil and press into bread crumb mixture to coat. Lay slices onto a baking sheet and bake in the preheated oven until browned and tender, about 15 minutes. Remove eggplant and reduce oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Whisk tomato paste and water in a saucepan, place over medium heat and bring to a simmer. Stir in basil, oregano, parsley, garlic, brown sugar, salt, and black pepper."
    },
    {
      "position": 4,
      "text": "Place eggplant slices into the prepared baking dish, overlapping the slices. Spoon tomato sauce over eggplant and top with mozzarella cheese and 3/4 cup Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes. If desired, broil for 1 to 2 more minutes to give cheese topping a golden color. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "274becfa-607e-5c64-a5c0-eb8c68cdb253",
  "slug": "fettuccine-alfredo-v",
  "name": "Fettuccine Alfredo",
  "recipe_type": "main",
  "brief_description": "This creamy garlicky Alfredo sauce made rich with lots of butter, heavy cream, and freshly grated Parmesan cheese is perfect with fettuccini pasta.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a large skillet melt butter and add chopped garlic. Cook on low for about 5 minutes, stirring often to prevent garlic from burning."
    },
    {
      "position": 3,
      "text": "Pour about a 1/4 cup of heavy cream into a small bowl. Add egg yolk and beat together; set aside."
    },
    {
      "position": 4,
      "text": "Pour remaining cream into the skillet. Increase heat to medium-high. As cream starts to boil, mix rapidly using a whisk. Add egg mixture slowly to prevent curdling, whisking until well blended. Stir in 1 cup Parmesan cheese until combined."
    },
    {
      "position": 5,
      "text": "Add remaining Parmesan cheese and parsley; mix until smooth. Remove from heat and serve over cooked pasta."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

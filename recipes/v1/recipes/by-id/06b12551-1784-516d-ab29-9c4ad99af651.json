  "slug": "sugo-di-pomodoro-authentic-italian-tomato-sauce",
  "name": "Sugo di Pomodoro (Authentic Italian Tomato Sauce)",
  "recipe_type": "main",
  "brief_description": "A simple traditional sugo, an Italian tomato sauce flavored with extra-virgin olive oil, garlic, and basil. Use on pasta, pizza, gnocchi, and more.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over low heat. Add onion and garlic. Cook and stir until soft and translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add passata, basil, and salt. Cover and simmer over medium heat, stirring occasionally, until tomato sauce has thickened, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Remove garlic halves before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

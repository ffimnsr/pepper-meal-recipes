  "schema_version": 1,
  "id": "f989b0c6-2581-551c-94f6-ae569f921473",
  "slug": "crispy-ground-turkey-tostadas",
  "name": "Crispy Ground Turkey Tostadas",
  "recipe_type": "main",
  "brief_description": "Fresh and crispy, these turkey tostadas are a winning medley of taco spices, tender poblano and chayote, pickled red onions, and lime crema.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place red onion slices and crema in separate small bowls. Zest limes into another small bowl. Halve limes and squeeze juice into a fourth small bowl."
    },
    {
      "position": 3,
      "text": "Stir 1 teaspoon lime juice into the bowl of crema. Add the remaining lime juice to the bowl with the red onions; stir in 1/4 teaspoon salt and let marinate at room temperature until pickled, at least 20 minutes."
    },
    {
      "position": 4,
      "text": "Heat oil in a skillet over medium heat. Add chayote and poblano pepper; cook, stirring constantly, until golden and tender, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Coat tortillas on both sides with cooking spray. Place tortillas on a large baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crisped and lightly brown, 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "Stir the lime zest, 1/2 the cilantro, onion powder, and 1/4 teaspoon salt into the chayote-poblano mixture. Pour mixture into a bowl."
    },
    {
      "position": 8,
      "text": "Heat remaining 1 tablespoon oil in the same skillet over medium heat. Add ground turkey; cook, stirring occasionally, until browned, about 7 minutes. Stir in 1/4 cup water, taco seasoning, and chili powder. Cook until water has evaporated, about 4 minutes."
    },
    {
      "position": 9,
      "text": "Spread guacamole over each crisped tortilla; top with chayote-poblano mixture, ground turkey, pickled onions, lime crema, and remaining cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 29,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a9c423a1-7165-590c-9aee-db25c2ed5224",
  "slug": "ultimate-frozen-strawberry-margarita",
  "name": "Ultimate Frozen Strawberry Margarita",
  "recipe_type": "drink",
  "brief_description": "A strawberry margarita is a refreshing cocktail for a hot summer day. Ready in minutes, this one's made with frozen berries and limeade concentrate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients and fill a blender with ice cubes. Pulse until ice is crushed."
    },
    {
      "position": 2,
      "text": "Pour in tequila and triple sec, then add strawberries and limeade concentrate."
    },
    {
      "position": 3,
      "text": "Blend until smooth, about 30 seconds. Pour into four margarita glasses (with or without salted rims) and serve immediately."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

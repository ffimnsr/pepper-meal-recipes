  "id": "d9739133-eea0-5b6f-908e-27ecfba39eac",
  "slug": "smoked-salmon-breakfast-casserole-recipe-8690566",
  "name": "Smoked Salmon Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This smoked salmon breakfast casserole made with rye bagels, hot-smoked salmon, and cream cheese is a stick-to-your-ribs egg bake, easy to make ahead.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread half of the toasted bagel pieces in prepared dish. Top with 1 1/2 cups Swiss cheese, the cream cheese, and smoked salmon. Top with remaining bagel pieces."
    },
    {
      "position": 3,
      "text": "Whisk together eggs, milk, sour cream, and dill in a bowl. Pour over mixture in baking dish. Press bagel pieces with the back of a spoon to coat in egg mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 45 minutes. Sprinkle with remaining 1/2 cup cheese. Bake 5 to 10 minutes more, until set and an instant-read thermometer inserted into center of casserole registers 160 degrees F (71 degrees C). Let stand about 10 minutes before serving. Garnish with additional dill and serve with capers, lemon wedges, and/or additional sour cream."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

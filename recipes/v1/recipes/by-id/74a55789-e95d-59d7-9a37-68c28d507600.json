  "id": "74a55789-e95d-59d7-9a37-68c28d507600",
  "slug": "magic-m-and-m-bars-recipe-11922320",
  "name": "Magic M&M Bars",
  "recipe_type": "dessert",
  "brief_description": "These magic M&M bars bake into an ooey-gooey bar cookie on a graham cracker base, filled with chocolate chips, coconut, and toffee bits with M&Ms on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a 13x9-inch baking pan with parchment paper, allowing the parchment to come up the sides."
    },
    {
      "position": 2,
      "text": "Stir together graham cracker crumbs and butter until well blended and press mixture into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Sprinkle chocolate chunks, toffee bits, and coconut evenly over the crust."
    },
    {
      "position": 4,
      "text": "Stir together condensed milk and peanut butter in a small bowl until well blended and pour mixture evenly over coconut mixture. Sprinkle evenly with candies."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown around the edges and slightly bubbly, about 20 minutes. Let cool completely, at least 1 hour."
    },
    {
      "position": 6,
      "text": "Use the edges of the parchment paper to carefully lift the magic bars from the pan. Cut into 24 squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "38f546c9-0b44-58e8-aabd-3fe7c44d06c6",
  "slug": "thanksgiving-egg-noodles",
  "name": "Thanksgiving Egg Noodles",
  "recipe_type": "main",
  "brief_description": "Skip the classic Thanksgiving dinner and prepare these homemade fresh egg noodles to pair with a variety of dishes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together flour and salt in a large bowl until combined. Add milk, beaten eggs, and butter. Knead dough until smooth, about 5 minutes. Cover and let rest for 10 minutes."
    },
    {
      "position": 2,
      "text": "Roll dough out on a floured surface to 1/8- or 1/4-inch thickness. Cut into desired lengths and shapes. Allow to air dry before cooking, at least 1 hour."
    },
    {
      "position": 3,
      "text": "Bring chicken stock to a boil in a large pot. Add noodles; cook at a boil until noodles are soft with no bite and broth has thickened, about 15 minutes."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 20,

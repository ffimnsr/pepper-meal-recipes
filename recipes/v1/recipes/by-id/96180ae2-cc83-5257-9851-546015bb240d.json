  "slug": "instant-pot-dump-and-go-seven-can-soup",
  "name": "Instant Pot Dump and Go Seven Can Soup",
  "recipe_type": "soup",
  "brief_description": "The easiest Instant Pot dump and go soup with beans, corn, green beans, and potatoes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine corn, ranch-style beans, chili, green beans, potatatoes, cheese soup, and diced tomatoes and green chilies in a multi-functional pressure cooker (such as Instant Pot\u00ae). Stir to combine."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select highpressure according to manufacturer's instructions; set timer for 15 minutes. Allow 25 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

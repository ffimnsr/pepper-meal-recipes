  "id": "4706b8e8-297f-5b86-964e-9a439d42cba5",
  "slug": "chili-lime-chicken",
  "name": "Chili Lime Chicken",
  "recipe_type": "drink",
  "brief_description": "This chili lime chicken recipe creates a flavorful pollo asado experience in the oven by first marinating chicken in a simple vinaigrette featuring lime juice and ancho and chipotle chili powders.",
  "cuisine": "Tex Mex Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ancho chile powder, salt, garlic powder, onion powder, cumin, and chipotle powder in a medium glass or ceramic bowl. Whisk in canola oil and lime juice until well-combined; thin with additional canola oil if mixture seems too thick."
    },
    {
      "position": 2,
      "text": "Arrange chicken in a glass or ceramic baking dish; pour marinade over chicken, covering it completely. Marinate in the refrigerator for 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 4,
      "text": "Arrange chicken on the baking sheet; do not crowd. Discard any excess marinade."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until chicken is no longer pink in the centers, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove from the oven and let stand for 5 to 6 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4efa6ad3-6edd-5edc-9469-143e32043bca",
  "slug": "gooey-butter-cookies",
  "name": "Gooey Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These gooey butter cookies made with cream cheese, butter, and yellow cake mix are ooey, gooey, and chewy \u2014 you won't be able to stop eating them!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Place confectioners' sugar into a shallow bowl."
    },
    {
      "position": 2,
      "text": "Beat cream cheese and butter with an electric mixer in a medium bowl until creamy. Stir in egg and vanilla."
    },
    {
      "position": 3,
      "text": "Add cake mix and stir until well blended. Roll dough into 1-inch balls."
    },
    {
      "position": 4,
      "text": "Roll balls in confectioners' sugar to coat; place 1 inch apart onto an ungreased cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set, 10 to 13 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and transfer to wire racks to cool."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

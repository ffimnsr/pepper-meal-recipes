  "id": "b2146339-8fcc-5065-a89e-92448d3a448e",
  "slug": "blueberry-oatmeal-breakfast-bars",
  "name": "Blueberry Oatmeal Breakfast Bars",
  "recipe_type": "appetizer",
  "brief_description": "Blueberry oatmeal bars made with whole oats, oat flour, fresh berries, walnuts, and optional coconut are delicious as a grab-and-go breakfast or snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square pan."
    },
    {
      "position": 2,
      "text": "Combine whole oats, oat flour, brown sugar, salt, and baking soda in a bowl. Stir in almond milk, eggs, butter, and vanilla until well combined. Fold in blueberries and walnuts. Spread mixture into the prepared pan; top with shredded coconut."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are golden and coconut is browned; about 35 minutes. Cool in the pan for 10 minutes before cutting into 16 squares."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a022ab3b-aafb-57c9-8f95-286864364eb9",
  "slug": "muddy-hearts",
  "name": "Muddy Hearts",
  "recipe_type": "dessert",
  "brief_description": "Muddy Hearts is a perfect title for these festive chocolate-dipped peanut butter heart cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine egg, peanut butter and sugar in a bowl. The dough should be slightly dry; add small amounts of sugar if it seems too wet."
    },
    {
      "position": 4,
      "text": "Place dough between two sheets of wax paper and roll to 1/2 inch thickness."
    },
    {
      "position": 5,
      "text": "Cut the dough with a heart-shaped cookie cutter."
    },
    {
      "position": 6,
      "text": "Place the hearts on the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the edges are golden, 7 to 10 minutes."
    },
    {
      "position": 8,
      "text": "Cool completely on the baking sheet."
    },
    {
      "position": 9,
      "text": "Melt the chocolate chips in the microwave at 30 second intervals until fully melted, stirring between intervals."
    },
    {
      "position": 10,
      "text": "Dip the bottom and sides of each cookie in the melted chocolate."
    },
    {
      "position": 11,
      "text": "Place cookies on wax paper to dry."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

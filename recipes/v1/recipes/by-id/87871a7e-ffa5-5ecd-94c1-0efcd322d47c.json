  "id": "87871a7e-ffa5-5ecd-94c1-0efcd322d47c",
  "slug": "impossible-coconut-pie-i",
  "name": "Impossible Coconut Pie",
  "recipe_type": "dessert",
  "brief_description": "This impossible coconut pie is so easy! The batter is blended in minutes, then it's baked into a custard-like pie with a chewy coconut topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Combine milk, sugar, baking mix, butter, eggs, and vanilla in blender; blend on low speed for 3 minutes."
    },
    {
      "position": 3,
      "text": "Pour into the prepared pie plate and let stand for 5 minutes. Sprinkle coconut over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes. Let pie cool briefly before slicing; serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "7531b14b-00a1-5c65-bc5b-844e57b4dfa9",
  "slug": "roasted-potatoes-and-onions-easy-and-delicious",
  "name": "Roasted Potatoes and Onions - Easy and Delicious",
  "recipe_type": "side",
  "brief_description": "Roasted potatoes and onions are a quick, easy, and flavorsome alternative to mashed potatoes or fries as a side dish for your weeknight meals.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine potatoes and onion in a roasting pan; cover with canola oil and olive oil. Add garlic, onion soup mix, rosemary, and black pepper; stir until potatoes and onion are evenly coated. Cover roasting pan with aluminum foil."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven for 25 minutes. Remove foil and continue to roast until potatoes and onion are browned and edges are crispy, 15 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

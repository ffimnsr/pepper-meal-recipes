  "id": "a24b744a-1196-5a41-b400-cac324297d55",
  "slug": "risotto-with-truffle-and-parmesan",
  "name": "Risotto with Truffle and Parmesan",
  "recipe_type": "soup",
  "brief_description": "Delicious truffle risotto dish made with creamy Arborio rice is simmered in white wine and chicken broth and finished with truffle oil and Parmesan.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat chicken broth in a stockpot over medium-low heat until warmed, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon butter and olive oil in a large, heavy-bottomed pan until butter melts. Add onion and saut\u00e9 until translucent, about 2 minutes. Stir in rice until coated, then cook, stirring constantly, until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Pour wine into rice mixture; cook and stir until liquid is absorbed, about 5 minutes. Add one ladle hot broth and cook, stirring constantly, until broth is absorbed. Continue adding and stirring in one ladle broth at a time until rice is tender but firm to the bite, 20 to 30 minutes. If you run out of broth before rice is cooked, finish cooking with hot water."
    },
    {
      "position": 4,
      "text": "Stir in Parmesan, remaining 2 tablespoons butter, truffle oil, and milk until fully incorporated, then season with parsley, salt, and pepper. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

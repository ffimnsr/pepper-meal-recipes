  "id": "b7304600-f9b5-5f38-b356-7dabc211f104",
  "slug": "classic-strawberry-shortcakes",
  "name": "Classic Strawberry Shortcakes",
  "recipe_type": "dessert",
  "brief_description": "Bisquick strawberry shortcakes are quick and easy to make for an awesome summer treat; split the shortcakes and fill with juicy strawberries and cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Mix strawberries and 1/4 cup sugar in a large bowl; set aside."
    },
    {
      "position": 2,
      "text": "Stir Bisquick mix, milk, 3 tablespoons sugar, and butter in a medium bowl until soft dough forms. Drop dough by 6 spoonfuls onto an ungreased cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes. Meanwhile, beat whipping cream in a medium bowl with electric mixer on high speed until soft peaks form."
    },
    {
      "position": 4,
      "text": "Split warm shortcakes; fill and top with strawberries and whipped cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

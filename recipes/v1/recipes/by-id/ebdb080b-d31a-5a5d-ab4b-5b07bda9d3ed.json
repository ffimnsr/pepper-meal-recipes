  "id": "ebdb080b-d31a-5a5d-ab4b-5b07bda9d3ed",
  "slug": "ube-halaya",
  "name": "Ube Halaya",
  "recipe_type": "appetizer",
  "brief_description": "Try this ube halaya recipe for a unique and delicious Philippines snack made from the ube aka purple yam.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Place yams into a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and cool until safe to handle, about 20 minutes. Grate yams into the pot."
    },
    {
      "position": 2,
      "text": "Add coconut milk, sweetened condensed milk, brown sugar, evaporated milk, butter, and vanilla extract to the pot over low heat. Cook, stirring constantly, until thick and sticky, about 20 minutes; mixture should be able to drop into room-temperature water and form a small ball when done."
    },
    {
      "position": 3,
      "text": "Transfer mixture into greased molds and chill until set, about 30 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

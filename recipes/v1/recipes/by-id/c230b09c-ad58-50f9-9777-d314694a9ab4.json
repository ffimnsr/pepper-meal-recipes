  "slug": "turkey-bacon-ranch-tortilla-pinwheels-recipe-11944394",
  "name": "Turkey Bacon Ranch Tortilla Pinwheels",
  "recipe_type": "appetizer",
  "brief_description": "These easy turkey bacon ranch tortilla pinwheels are a make-ahead appetizer or lunch that will disappear fast. With simple ingredients, a quick roll-up, and a half hour or more in the refrigerator, they are ready to go.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese, ranch seasoning, and Cheddar in a bowl and mix well. Spread mixture evenly on each tortilla."
    },
    {
      "position": 2,
      "text": "Evenly top tortillas with chopped bacon and a couple of slices of turkey and roll them up tightly. Cover with plastic wrap."
    },
    {
      "position": 3,
      "text": "Refrigerate rolls at least 30 minutes or up to 1 day before serving. To serve, cut each roll into 3/4-inch slices."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

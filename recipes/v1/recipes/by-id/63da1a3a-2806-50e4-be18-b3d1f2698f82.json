  "id": "63da1a3a-2806-50e4-be18-b3d1f2698f82",
  "slug": "applesauce-zucchini-bread",
  "name": "Applesauce Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "This moist zucchini bread with applesauce and cinnamon recipe gets irresistible texture from chopped pecans. Perfect for a breakfast treat or dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk flour, cinnamon, salt, baking soda, and baking powder together in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Combine sugar, oil, and eggs in a separate bowl; stir in zucchini, applesauce, and vanilla extract until well combined. Stir in flour mixture until incorporated; stir in pecans. Divide batter between the prepared pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool slightly before slicing."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

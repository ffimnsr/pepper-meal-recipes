  "id": "1ff5b0e2-9e5e-5b40-9740-83e7bb7844f7",
  "slug": "fathers-day-casserole",
  "name": "Father's Day Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Surprise Dad on Father's Day with a breakfast casserole, complete with sausage, hash browns, biscuits, and eggs. It's so easy, the kids can help make it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Add sausage; cook and stir until crumbly, evenly browned, and no longer pink, about 5 minutes. Drain and discard any excess grease. Stir in hash brown potatoes; cook and stir until potatoes are browned, about 5 more minutes."
    },
    {
      "position": 3,
      "text": "Line the bottom of the prepared baking dish with a layer of buttermilk biscuits, splitting the biscuits in half to completely cover the dish. Spread sausage and hash brown mixture evenly over top, then sprinkle with Mexican cheese. Whisk together eggs and milk in a bowl, and pour over cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until eggs are set, about 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7dc1d1da-2058-5e69-bf7b-066b976d3d47",
  "slug": "squash-and-apple-soup",
  "name": "Squash and Apple Soup",
  "recipe_type": "soup",
  "brief_description": "This squash and apple soup recipe, made with butternut squash, apples, potatoes, and ginger, is flavored with apple cider and yogurt for a hearty soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over medium heat. Add onion; cook, stirring occasionally, until softened, about 4 minutes. Add squash, apples, potato, ginger, and white pepper; stir in water. Cover and bring to a boil; reduce heat to low and simmer until potatoes are tender, 12 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Transfer soup, in batches, to the bowl of a food processor or blender; pulse until smooth. Return pur\u00e9ed soup to the saucepan; repeat with remaining chunky soup. Stir apple cider and brown sugar into pur\u00e9ed soup; heat to boiling."
    },
    {
      "position": 3,
      "text": "Garnish servings with a dollop of yogurt; sprinkle with pecans."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

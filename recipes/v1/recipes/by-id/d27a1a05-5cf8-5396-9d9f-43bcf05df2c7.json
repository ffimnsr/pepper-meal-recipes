  "id": "d27a1a05-5cf8-5396-9d9f-43bcf05df2c7",
  "slug": "luau-punch",
  "name": "Luau Punch",
  "recipe_type": "drink",
  "brief_description": "Luau punch is a non-alcoholic, fruity Hawaiian drink with pineapple and orange juices and citrus soda for a tropical taste. Perfect for summer parties!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour pineapple juice and orange juice concentrate into an empty gallon milk jug or pitcher; shake to mix. Pour in lemon-lime soda. You may need to let the fizz settle and then return to pouring. Leave some room at the top of the gallon pitcher to allow for expansion as it freezes. Freeze for 8 to 10 hours."
    },
    {
      "position": 2,
      "text": "Let the punch start to thaw 2 to 3 hours before serving. Serve slushy."
    }
  ],
  "servings": 10,

  "id": "c5a2f1b5-d986-5e2e-b803-596d512e08cb",
  "slug": "creamy-chicken-piccata-pasta-bake-recipe-8769276",
  "name": "Creamy Chicken Piccata Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This creamy chicken piccata pasta bake is bright with lemon and capers, creamy and cheesy with Alfredo pasta sauce, ricotta, and Parmesan, and it can be made ahead for easy entertaining.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes; drain."
    },
    {
      "position": 4,
      "text": "Zest and juice the lemon to yield 1 teaspoon zest and 3 tablespoons juice."
    },
    {
      "position": 5,
      "text": "Melt butter in a large skillet over medium heat. Add shallot and garlic. Cook and stir until tender, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Whisk together cooked shallot and garlic, lemon juice, Alfredo sauce, ricotta cheese, broth, capers, and pepper in a large bowl. Add penne and chicken; toss to combine."
    },
    {
      "position": 7,
      "text": "Spread in the prepared dish."
    },
    {
      "position": 8,
      "text": "Toss together Parmesan cheese and lemon zest in a small bowl. Spread over the pasta mixture."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until hot and bubbly, 35 to 40 minutes. Garnish with parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

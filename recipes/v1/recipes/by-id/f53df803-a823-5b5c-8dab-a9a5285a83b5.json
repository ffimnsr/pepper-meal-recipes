  "id": "f53df803-a823-5b5c-8dab-a9a5285a83b5",
  "slug": "easy-chili-cavatappi",
  "name": "Easy Chili Cavatappi",
  "recipe_type": "main",
  "brief_description": "Cavatappi pasta is mixed with an easy and hearty chili for a warm and comforting meal ready in less than an hour.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a large pot; add salt. Pour cavatappi into the boiling water and cook until tender but firm to the bite, 10 to 12 minutes; drain and rinse cavatappi."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir onion and garlic in the hot oil until onion is softened and transparent, 5 to 10 minutes. Increase heat to medium-high and stir ground beef into onion mixture. Cook and stir until ground beef is browned and crumbly, 5 to 10 minutes. Drain excess grease and return skillet to heat."
    },
    {
      "position": 3,
      "text": "Mix tomato sauce, chili powder, and cumin into ground beef mixture; cook, stirring occasionally, until tomato sauce is heated through, about 3 minutes. Stir cavatappi into meat sauce until evenly coated; add black beans and pepper. Cook and stir over medium-low heat until flavors have blended, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8afad971-faa0-5c51-b48c-bd3e5fd3f66e",
  "slug": "english-royalty-chocolate-chip-scones",
  "name": "Chocolate Chip Scones",
  "recipe_type": "breakfast",
  "brief_description": "Tender, rich chocolate chip scones made with easy baking ingredients, chocolate chips, and orange juice for a morning treat or afternoon tea delight!",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking sheet with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, and salt together in a large bowl. Cut in butter with a pastry blender or a large fork until the mixture resembles coarse crumbs. Stir in chocolate chips. Mix in orange juice to form a dough."
    },
    {
      "position": 3,
      "text": "Turn out dough on a floured surface. Pat or roll into a 9-inch circle about 1/2 inch thick. With a 2 \u00bd-inch fluted biscuit cutter, cut out 12 scones, pushing the dough scraps together for the last few, if necessary. Transfer the scones to the baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until golden brown, about 12 minutes. Move to wire racks to cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

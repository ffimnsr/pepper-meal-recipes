  "schema_version": 1,
  "id": "5e171354-e241-59ad-ae8e-ab79881cfb61",
  "slug": "my-italian-grandfathers-chicken-cacciatore",
  "name": "My Italian Grandfather's Chicken Cacciatore",
  "recipe_type": "main",
  "brief_description": "This favorite recipe for an Italian grandfather's chicken cacciatore has been handed down for generations and works equally well with rabbit.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a Dutch oven over medium-high heat until shimmering. Add chicken and cook until well browned, 3 to 4 minutes per side. Remove to a plate."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium and add bell pepper, onion, celery, carrot, and garlic. Saut\u00e9 until translucent, about 5 minutes. Add tomato paste and stir to blend into the vegetables."
    },
    {
      "position": 4,
      "text": "Add crushed tomatoes, wine, allspice, bay leaf, seasoning sauce, salt, and pepper. Return chicken to the pan and toss to coat all pieces."
    },
    {
      "position": 5,
      "text": "Cover the Dutch oven and place in the preheated oven. Braise until chicken is falling off the bone and the juices run clear, 1 1/2 to 2 hours. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

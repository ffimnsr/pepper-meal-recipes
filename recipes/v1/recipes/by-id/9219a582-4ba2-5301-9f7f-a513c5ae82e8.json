  "id": "9219a582-4ba2-5301-9f7f-a513c5ae82e8",
  "slug": "ranch-bloody-mary-recipe-8760838",
  "name": "Ranch Bloody Mary",
  "recipe_type": "appetizer",
  "brief_description": "This ranch Bloody Mary is so simple\u2014just rim the glass with dry ranch dressing mix and add a little more ranch to the usual ingredients for a refreshing and tasty twist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1/2 teaspoon dry ranch dressing mix on a plate. Run a piece of lime around the rim of glass. Dip rim in dressing mix until coated. Set aside."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice. Add tomato juice, vodka, lime juice, Worcestershire sauce, Tabasco, horseradish and 1/2 teaspoon dry ranch mix. Shake until the outside of the shaker is frosted, about 30 seconds. Pour into the prepared glass."
    }
  ],

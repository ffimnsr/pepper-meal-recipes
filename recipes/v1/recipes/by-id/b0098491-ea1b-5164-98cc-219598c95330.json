  "slug": "rice-cooker-risotto",
  "name": "Rice Cooker Risotto",
  "recipe_type": "main",
  "brief_description": "This is a simple way to make Arborio rice in a rice cooker, making a perfect item to taking sauteed vegetables or meat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the rice and heated chicken stock into the rice cooker."
    },
    {
      "position": 2,
      "text": "Press Start and let cook until the cycle has completed and has shifted to Keep Warm setting. Let rice sit with cover remaining on the rice cooker until the rice is completely tender, about 10 minutes more."
    },
    {
      "position": 3,
      "text": "Sprinkle Parmesan cheese over the rice and stir."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

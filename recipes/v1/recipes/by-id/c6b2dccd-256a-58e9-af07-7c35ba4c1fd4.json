  "id": "c6b2dccd-256a-58e9-af07-7c35ba4c1fd4",
  "slug": "baked-salmon-ii",
  "name": "Best Baked Salmon",
  "recipe_type": "main",
  "brief_description": "This baked salmon is quick and easy to make by cooking salmon fillets in foil with lemon, garlic, and parsley until tender, flaky, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, garlic, lemon juice, parsley, basil, salt, and pepper together in a medium bowl."
    },
    {
      "position": 2,
      "text": "Arrange salmon fillets in a small glass or ceramic baking dish; pour marinade over salmon. Cover and marinate in the refrigerator for about 1 hour, turning occasionally."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Transfer salmon fillets onto a large piece of aluminum foil. Spoon marinade on top and fold up the foil to seal. Place sealed foil packs on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until fish flakes easily with a fork, about 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ae0e3b13-cef8-5179-8c75-e4fcc92631a1",
  "slug": "tuna-noodle-casserole-i",
  "name": "Creamy Tuna Noodle Casserole",
  "recipe_type": "main",
  "brief_description": "This creamy tuna noodle casserole is easy, filling, and can be quick if you omit the baking step, which I often do.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2-quart casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Cook egg noodles in a large pot of salted boiling water until al dente. Drain well."
    },
    {
      "position": 3,
      "text": "Combine flour, butter, and salt in a medium saucepan over medium heat. Cook and stir until butter is melted and mixture is evenly combined. Gradually add milk; whisk until sauce thickens and begins to boil. Add cheese and whisk until melted and well combined. Stir in tuna, peas, and noodles. Spread mixture evenly in the prepared casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until hot and bubbling, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7f6cc079-a696-5b09-aee8-cf142c7e2d07",
  "slug": "baked-salisbury-steak",
  "name": "Baked Salisbury Steak",
  "recipe_type": "main",
  "brief_description": "These tender beef patties were named for Dr. J.H. Salisbury who, in the late 1800s, advocated eating beef three times a day for good health! This recipe is quick, easy and very savory! Serve with hot cooked Rice and a rich Brown Gravy poured over top!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Lightly grease a large shallow baking dish."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine ground beef, ground pork, tomatoes, eggs, onion, garlic, salt and pepper. Mix well. Shape into 12 (4-inch) round patties. Place in baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 35 minutes, until evenly brown, and juices run clear. Cook to a minimum of 160 degrees F (73 degrees C)."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

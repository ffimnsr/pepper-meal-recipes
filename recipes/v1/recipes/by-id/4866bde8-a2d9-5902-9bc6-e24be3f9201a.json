  "id": "4866bde8-a2d9-5902-9bc6-e24be3f9201a",
  "slug": "halloween-mini-cheesecakes-recipe-8357428",
  "name": "Halloween Mini Cheesecakes",
  "recipe_type": "dessert",
  "brief_description": "This Halloween mini cheesecakes recipe, an eerie twist on a delightful and tasty treat, blends sugar cookies and a no-bake cheesecake for a deliciously haunting bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a cupcake pan with paper liners."
    },
    {
      "position": 2,
      "text": "Place one cookie dough piece in each cupcake liner."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 12 minutes. Remove to cool on a wire rack."
    },
    {
      "position": 4,
      "text": "Beat no bake cheesecake filling with a whisk or spoon until light and fluffy. With a disposable piping bag or spoon, pipe cheesecake on top of each cooled cookie up to the midpoint of cupcake liner. Gently flatten surface with a spoon, ensuring there are no air pockets."
    },
    {
      "position": 5,
      "text": "Refrigerate for 15 minutes to set."
    },
    {
      "position": 6,
      "text": "Place toppings or candy in a small bowl. Decorate with Halloween toppings, candy, icing, and sprinkles. Take out of cupcake liners and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,

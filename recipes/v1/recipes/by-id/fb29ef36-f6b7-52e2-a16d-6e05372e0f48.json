  "id": "fb29ef36-f6b7-52e2-a16d-6e05372e0f48",
  "slug": "swedish-crisp-waffles-frasvafflor",
  "name": "Swedish Crisp Waffles (Frasvafflor)",
  "recipe_type": "breakfast",
  "brief_description": "These Swedish waffles, or frasvafflor, are a lot crisper and lighter than American and Belgian waffles and contain no eggs.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Sift flour, sugar, salt, and baking powder together in a bowl. Whisk in milk, butter, and heavy cream; stir in soda."
    },
    {
      "position": 3,
      "text": "Cook in batches in the preheated waffle iron until waffles are golden brown and the iron stops steaming, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

  "id": "f81adfee-e236-5e6c-84ce-13b1424e5a2c",
  "slug": "toffee-cherry-butter-tarts",
  "name": "Toffee Cherry Butter Tarts",
  "recipe_type": "dessert",
  "brief_description": "Dried cherries replace raisins, and melted toffee bits add a chewy topping in this delicious twist on traditional Canadian butter tarts.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Spray twelve 3-inch tart tins with cooking spray."
    },
    {
      "position": 2,
      "text": "Roll out pie crust on a lightly floured surface and cut twelve 4-inch circles with a cookie cutter, rerolling scraps if necessary. Line tart tins with pastry circles."
    },
    {
      "position": 3,
      "text": "Beat eggs, brown sugar, vinegar, and vanilla together in a bowl until smooth; stir in melted butter, cherries, and walnuts. Fill tart shells 2/3 full with butter mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (180 degrees C) and continue baking until crust is golden and filling is bubbling, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove tarts from oven; sprinkle evenly with toffee bits. Return tarts to the oven; bake until toffee bits are just melted, about 5 minutes. Cool on a wire rack, about 15 minutes. Gently lift tarts from tins."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

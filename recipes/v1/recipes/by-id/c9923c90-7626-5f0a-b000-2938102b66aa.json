  "id": "c9923c90-7626-5f0a-b000-2938102b66aa",
  "slug": "chicken-pineapple-fajitas",
  "name": "Chicken Pineapple Fajitas",
  "recipe_type": "dessert",
  "brief_description": "Browned pineapple and Jamaican jerk seasoning add a sweet and sassy flavor to these chicken-pineapple fajitas.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Wrap tortillas in aluminum foil and heat in the oven."
    },
    {
      "position": 2,
      "text": "Combine chicken, bell peppers, jerk seasoning, and pepper in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat, and coat with cooking spray. Add pineapple and cook until brown, 4 to 6 minutes. Remove pineapple from the pan and set aside."
    },
    {
      "position": 4,
      "text": "Return the skillet to the stovetop and heat vegetable oil. Add chicken and bell peppers; cook and stir until chicken is no longer pink, about 6 minutes."
    },
    {
      "position": 5,
      "text": "Stir in cooked pineapple. Serve fajita mixture in warmed tortillas garnished with cilantro and a squeeze of lime."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

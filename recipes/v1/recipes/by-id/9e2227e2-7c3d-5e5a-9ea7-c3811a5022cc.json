  "id": "9e2227e2-7c3d-5e5a-9ea7-c3811a5022cc",
  "slug": "cherry-crumble-pie-with-frozen-cherries",
  "name": "Cherry Crumble Pie with Frozen Cherries",
  "recipe_type": "dessert",
  "brief_description": "Mix up a tasty crumb topping and all you need is a pie crust, frozen fruit, and a can of pie filling for this super-easy and tasty cherry crumble pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, sugar, cinnamon, allspice, ginger, cloves, salt, and nutmeg for crumble topping in a food processor; process until thoroughly mixed, about 30 seconds. Add butter through the chute and process, scraping the sides as needed, until thoroughly mixed and mixture looks like wet sand."
    },
    {
      "position": 3,
      "text": "Transfer to a large bowl and stir in oats until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Arrange frozen cherries in the pie crust in an even layer. Spread pie filling over top, then sprinkle with crumble topping. Place pie on a sheet pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour. Remove from the oven and let cool for 2 to 3 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

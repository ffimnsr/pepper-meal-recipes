  "id": "42d4b16c-eebc-5dbb-92bf-34a9c0fae7a9",
  "slug": "margies-shortbread-oatmeal-cookies",
  "name": "Margie's Shortbread Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "This is our family recipe for shortbread oatmeal cookies, handed down through the Scottish side of the family. There is nothing better. They are definitely not low in fat.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Dissolve the baking soda in the water."
    },
    {
      "position": 3,
      "text": "Combine the oats, flour and brown sugar. Cut in the butter until the mixture resembles coarse crumbs. Stir in the baking soda mixture and form dough into a ball. Either roll dough out to 1/4 inch thick and cut with cookie cutters or press dough into the bottom of one 9x13 inch baking pan."
    },
    {
      "position": 4,
      "text": "Bake at 375 degrees F (190 degrees C) for 12 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

  "id": "2632f4d9-faae-5e03-879b-80e24afdeabc",
  "slug": "grand-marnier-souffle",
  "name": "Grand Marnier Souffl\u00e9",
  "recipe_type": "dessert",
  "brief_description": "Chef John's Grand Marnier souffl\u00e9 recipe makes 2 light, airy, and elegant orange liqueur-flavored desserts perfect for impressing someone special.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Brush the insides of two (8-ounce) ramekins with 1 tablespoon melted butter; sprinkle with 1 tablespoon sugar. Place on a baking sheet lined with aluminum foil."
    },
    {
      "position": 2,
      "text": "Melt 5 teaspoons butter in a saucepan over medium-low heat; cook and stir flour in hot butter until golden brown and fragrant, about 2 minutes. Pour in milk and cook, stirring continuously, until smooth and thick, 3 to 4 minutes. Pour into a large bowl. Stir in orange liqueur and zest. Add egg yolks and vanilla; mix until smooth."
    },
    {
      "position": 3,
      "text": "Whisk egg whites in a second large bowl until frothy. Slowly add 2 tablespoons sugar and whisk until combined. Add remaining 2 tablespoons sugar and continue to whisk until meringue holds its shape and is thick but not stiff."
    },
    {
      "position": 4,
      "text": "Fold 1/2 of the meringue into egg yolk mixture until combined. Gently fold in remaining meringue until well mixed. Transfer to the prepared ramekins, leaving 1/4-inch space at the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until risen and browned, about 16 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ad50098d-4269-531b-b557-6bd3a9713fee",
  "slug": "instant-pot-salisbury-steak-with-onion-and-mushroom-gravy",
  "name": "Instant Pot Salisbury Steak with Onion and Mushroom Gravy",
  "recipe_type": "main",
  "brief_description": "Next time you are craving Salisbury steak like mom used to make, you can cook it in your Instant Pot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine bread crumbs, onion, egg, parsley, Worcestershire sauce, and garlic in a large bowl. Stir well and add beef and pork. Mix gently and form 8 equal portions. Place patties on a plate, cover with plastic wrap, and refrigerate 1 hour. Remove from the refrigerator 30 minutes before cooking."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add oil. Add patties in batches to avoid overcrowding the pot. Saut\u00e9 2 minutes per side. Transfer cooked patties to a plate. Add onions to the pot and cook until brown, about 2 minutes. Add mushrooms and cook 2 minutes more."
    },
    {
      "position": 3,
      "text": "Pour wine into the pot and stir, scraping up all the brown bits from the bottom. Add broth, tomato paste, salt, and pepper; stir well. Return cooked patties and any accumulated liquid to the pot and turn to coat."
    },
    {
      "position": 4,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 6,
      "text": "Combine 4 tablespoons broth and cornstarch in a bowl and stir until dissolved. Add mixture to the pot slowly, stirring constantly. Select Saute function; cook until thickened, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

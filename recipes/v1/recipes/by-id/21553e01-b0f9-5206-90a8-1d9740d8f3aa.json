  "id": "21553e01-b0f9-5206-90a8-1d9740d8f3aa",
  "slug": "chef-johns-make-ahead-turkey-gravy",
  "name": "Chef John's Make-Ahead Turkey Gravy",
  "recipe_type": "side",
  "brief_description": "Flavorful turkey fond is used in Chef John's fantastic recipe for simple, make-ahead Thanksgiving gravy that's rich, smooth, and a huge timesaver.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients, and preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine onion, carrots, celery, and oil in a large roasting pan; toss to coat. Place turkey wings on top of vegetables."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until turkey wings are browned and vegetables are caramelized and softened, 45 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Transfer turkey wings and vegetables to a large stockpot."
    },
    {
      "position": 5,
      "text": "Place the roasting pan over a stovetop burner set to medium heat. Pour 2 tablespoons cold water into the pan and bring to a boil, scraping up any browned bits."
    },
    {
      "position": 6,
      "text": "Pour mixture into the stockpot and add 10 cups cold water, thyme, and garlic."
    },
    {
      "position": 7,
      "text": "Bring turkey wing mixture to a boil. Reduce heat to low and simmer, uncovered, until meat falls off the bone, about 3 hours. Skim off turkey fat throughout the process, reserving 2 tablespoons."
    },
    {
      "position": 8,
      "text": "Strain turkey stock and reserve 6 cups stock; discard all solids."
    },
    {
      "position": 9,
      "text": "Heat butter and reserved turkey fat in a large saucepan over medium heat. Whisk in flour and cook until it smells like cooked pie crust, 2 to 3 minutes."
    },
    {
      "position": 10,
      "text": "Slowly pour in reserved turkey stock, whisking constantly."
    },
    {
      "position": 11,
      "text": "Increase heat to high and simmer gravy until thick and warmed through, about 5 minutes. Season with cayenne, salt, and black pepper."
    },
    {
      "position": 12,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

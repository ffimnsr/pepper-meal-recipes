  "id": "218481c2-81c3-509e-b411-3b31a1d1b241",
  "slug": "sriracha-deviled-eggs-recipe-8730021",
  "name": "Sriracha Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These Sriracha deviled eggs are taken up a notch with Sriracha, which really enhances the flavor. This recipe serves 2, but it can easily be doubled.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice eggs in half lengthwise, remove yolks, and place them in a mixing bowl. Set egg whites aside."
    },
    {
      "position": 2,
      "text": "Mash the egg yolks. Add mayonnaise, sriracha, and mustard. Mix until well combined. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place egg yolk mixture in a piping bag and pipe mixture into egg whites. Sprinkle with paprika."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

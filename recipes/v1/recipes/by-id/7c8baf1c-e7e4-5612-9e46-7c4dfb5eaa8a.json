  "name": "Banana Bread Frosting",
  "recipe_type": "dessert",
  "brief_description": "This banana bread frosting hack turns store-bought vanilla frosting into a sweet, cinnamon-spiced spread that tastes just like banana bread. Eat it by the spoonful, use it as a dip, or slather it on your favorite sweet treats\u2014it\u2019s the frosting hack you never knew you needed.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove frosting from container and add to a bowl with banana powder, honey butter, and vanilla."
    },
    {
      "position": 2,
      "text": "Whip all ingredients with an electric mixer until well combined and fluffy."
    }
  ],

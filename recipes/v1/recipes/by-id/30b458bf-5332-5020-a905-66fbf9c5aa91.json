  "id": "30b458bf-5332-5020-a905-66fbf9c5aa91",
  "slug": "tex-mex-pork-chops-and-rice-skillet-recipe-7567945",
  "name": "Tex-Mex Pork Chops and Rice Skillet",
  "recipe_type": "soup",
  "brief_description": "For this one-pan Tex-Mex pork chops and rice dinner, you only need to brown some chops, then add vegetables, broth, and rice. A few kitchen tools everyone has on hand will get you there.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil over medium heat in a 12-inch skillet. Season both sides of pork chops with taco seasoning, cumin, smoked paprika, and salt."
    },
    {
      "position": 2,
      "text": "Place chops in the hot skillet and cook, turning once, until browned on both sides, about 2 minutes per side. Remove to a plate, and keep warm."
    },
    {
      "position": 3,
      "text": "In the same skillet, cook and stir onion and bell pepper, until the vegetables just begin to pick up a little color, about 2 minutes. Add garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Pour in diced tomatoes and green chilies, with their juices, and stir, being sure to scrape up any browned bits on the bottom of the skillet."
    },
    {
      "position": 5,
      "text": "Add chili powder and black pepper to the chicken broth, and stir in."
    },
    {
      "position": 6,
      "text": "Add thawed corn kernels, sliced zucchini, and uncooked rice. Stir until vegetables are evenly distributed, and make sure all the rice is submerged in the cooking liquid. Bring to a boil."
    },
    {
      "position": 7,
      "text": "Nestle pork chops into the skillet contents, and add any accumulated juices from the chops. Cover, reduce heat to low, and simmer about 20 minutes."
    },
    {
      "position": 8,
      "text": "Remove cover, and continue to simmer until rice is tender and all the liquid is absorbed, about 5 minutes more. An instant-read thermometer inserted into the center of pork chops should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 9,
      "text": "Garnish with flat-leaf parsley or cilantro and lime slices. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "55952ad8-8f99-5151-aac1-5d93e4ea28bb",
  "slug": "ritz-cracker-cookies-recipe-6590239",
  "name": "Ritz Cracker Cookies",
  "recipe_type": "dessert",
  "brief_description": "These 3-ingredient Ritz cracker cookies with a peanut butter filling are dipped in chocolate for a super-delicious no-bake Christmas treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread peanut butter onto half of the crackers until evenly covered, about 1 teaspoon per cracker. Top with remaining crackers and press gently until filling spreads to the edges."
    },
    {
      "position": 2,
      "text": "Melt chocolate in the top of a double boiler over medium heat, stirring frequently, until smooth, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Dip cracker sandwiches into melted chocolate using a fork until fully coated, allowing excess to drip back into the bowl."
    },
    {
      "position": 4,
      "text": "Arrange coated cookies on waxed paper and chill in the refrigerator until chocolate is set, about 15 minutes. Store in an airtight container in the refrigerator."
    }
  ],
  "servings": 12,

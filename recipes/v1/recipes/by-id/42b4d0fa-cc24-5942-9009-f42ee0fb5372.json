  "id": "42b4d0fa-cc24-5942-9009-f42ee0fb5372",
  "slug": "instant-pot-pork-chops",
  "name": "Instant Pot Pork Chops",
  "recipe_type": "soup",
  "brief_description": "These Instant Pot pork chops with butter, onion soup mix, and apple juice turn out tender and delicious for an easy dinner in just 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place pork chops into a multi-functional pressure cooker (such as Instant Pot)."
    },
    {
      "position": 3,
      "text": "Dot butter over chops, then sprinkle with onion soup mix. Pour in apple juice."
    },
    {
      "position": 4,
      "text": "Close and lock the lid. Select high pressure according to the manufacturer's instructions; set the timer for 5 minutes. Allow 10 to 15 minutes for the pressure to build. Release the pressure using the natural-release method according to the manufacturer's instructions, 10 to 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

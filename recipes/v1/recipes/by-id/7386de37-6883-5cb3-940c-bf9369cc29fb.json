  "id": "7386de37-6883-5cb3-940c-bf9369cc29fb",
  "slug": "pumpkin-spice-cookie",
  "name": "Pumpkin Spice Cookies",
  "recipe_type": "dessert",
  "brief_description": "These soft pumpkin spice cookies are easy to make with just 2 ingredients \u2014 spice cake mix and pumpkin puree \u2014 for a delicious fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 3,
      "text": "Stir together cake mix and pumpkin in a large bowl until well blended."
    },
    {
      "position": 4,
      "text": "Drop rounded tablespoonfuls of dough 2 inches apart on the prepared cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until centers are set and edges fell firm, 18 to 20 minutes. Allow cookies to cool on the baking sheets for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,

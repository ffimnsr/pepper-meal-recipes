  "id": "69520a00-9171-5f65-ab30-b8572fb17be6",
  "slug": "pistachio-frozen-yogurt-recipe-12012175",
  "name": "Pistachio Frozen Yogurt",
  "recipe_type": "dessert",
  "brief_description": "This pistachio frozen yogurt is a tangy, not-too-sweet treat to enjoy on a hot day. Greek yogurt, blended with roasted pistachios and just a touch of honey, tahini, and lemon juice, creates a flavor that\u2019s both complex and refreshing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add yogurt, unsalted pistachios, honey, lemon juice, tahini, vanilla, almond extract, and salt to the jar of a blender and blend until completely smooth. Taste mixture and adjust flavor as needed (i.e. add more honey, tahini, etc., as desired, and blend again to combine)."
    },
    {
      "position": 2,
      "text": "Pour mixture into a freezer-safe container and cover. Freeze until firm, at least 4 hours. This frozen yogurt will freeze solid after several hours. If needed, place container on the counter to soften for 5 or 10 minutes before serving. Top with chopped pistachios just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

  "id": "30f60cdb-8105-5e9f-bb52-0b8b1e31b581",
  "slug": "hot-honey-grilled-carrots-recipe-11723723",
  "name": "Hot Honey Grilled Carrots",
  "recipe_type": "appetizer",
  "brief_description": "These hot honey grilled carrots are lightly charred, then brushed with a sweet and spicy gochujang-honey sauce for an easy summer side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill to medium-high heat, 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Brush carrots with oil and grill, covered, over direct heat until fork-tender and lightly charred, 14 to 16 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk honey, gochujang, butter, lime juice, salt, and crushed red pepper, if using, in a small bowl."
    },
    {
      "position": 4,
      "text": "Brush cooked carrots with honey mixture and grill 1 minute more."
    },
    {
      "position": 5,
      "text": "Transfer carrots to a serving platter. Drizzle with remaining honey mixture. Sprinkle with cilantro to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

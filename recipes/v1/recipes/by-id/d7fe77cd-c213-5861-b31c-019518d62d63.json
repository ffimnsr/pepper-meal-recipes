  "id": "d7fe77cd-c213-5861-b31c-019518d62d63",
  "slug": "antipasto-salad-ii",
  "name": "Antipasto Salad",
  "recipe_type": "salad",
  "brief_description": "This antipasto salad is dressed in vinaigrette with 2 kinds of salami, 2 kinds of cheese, artichoke hearts, olives, tomatoes, and roasted red peppers.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine Genoa and soppressata salamis, provolone, mozzarella, tomatoes, and artichokes in a bowl. Slice roasted red peppers and add them to the bowl with about 3 tablespoons juice from the red pepper jar. Mix in chopped olives."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil over salami mixture, followed by red wine vinegar. Season with pepper. Mix thoroughly. Store in the refrigerator until serving time."
    },
    {
      "position": 3,
      "text": "Before serving, tear fresh basil leaves into bite-sized pieces and fold them into salad."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

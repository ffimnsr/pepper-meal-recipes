  "schema_version": 1,
  "id": "0dbec224-6e43-57e5-8aa1-c45cd5a76719",
  "slug": "air-fryer-bang-bang-tofu",
  "name": "Air Fryer Bang Bang Tofu",
  "recipe_type": "appetizer",
  "brief_description": "This bang bang tofu is seasoned with mayonnaise and chili sauce, coated with bread crumbs, and cooked in an air fryer until crispy on the outside.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place tofu onto a plate lined with several paper towels. Cover tofu with more paper towels and another plate. Set a 3- to 5-pound weight on top and press tofu for 30 minutes. Drain and discard any accumulated liquid and cut tofu into 1/2-inch cubes."
    },
    {
      "position": 2,
      "text": "Place cubed tofu into a large bowl and drizzle with sesame oil. Gently stir and let sit for 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, make bang bang sauce by whisking together mayonnaise, sweet chili sauce, and Sriracha sauce in a medium bowl until smooth. Place bread crumbs in a separate bowl."
    },
    {
      "position": 4,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 5,
      "text": "Mix tofu with 1/2 cup bang bang sauce until evenly combined. Coat tofu in bread crumbs and place in the air fryer basket, making sure tofu pieces do not overlap. Depending on the size of your air fryer, you may need to do this in batches."
    },
    {
      "position": 6,
      "text": "Cook in the preheated air fryer for 5 minutes. Shake and cook for 3 minutes more. Garnish with green onion and serve with remaining bang bang sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

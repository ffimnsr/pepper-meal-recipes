  "slug": "irish-coffee",
  "name": "The Best Irish Coffee",
  "recipe_type": "drink",
  "brief_description": "Irish coffee is a classic cocktail that's easy to make with Irish whiskey, coffee, and whipped cream. This recipe adds Baileys to makes it even more luxurious!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine Irish whiskey and Irish cream liqueur in a glass mug; pour in hot brewed coffee."
    },
    {
      "position": 3,
      "text": "Top with whipped cream and a dash of nutmeg."
    }
  ],

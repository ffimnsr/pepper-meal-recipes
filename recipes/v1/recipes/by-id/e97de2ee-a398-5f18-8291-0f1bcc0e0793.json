  "id": "e97de2ee-a398-5f18-8291-0f1bcc0e0793",
  "slug": "giant-lazy-meatballs-recipe-8715240",
  "name": "Giant Lazy Meatballs",
  "recipe_type": "main",
  "brief_description": "These giant lazy meatballs, made with beef and pork, need no slicing and dicing, precooking, or long simmer. Despite the lazy method, they have the incredible taste and texture of a properly made meatball.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble bread into a bowl and mix in milk thoroughly using a fork. Let stand for 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Combine beef and pork in a large bowl and mix well using 2 forks. Add salt, black pepper, oregano, onion powder, garlic powder, cayenne, olive oil, Parmesan, parsley, eggs, and the breadcrumb mixture. Mix using 2 forks until everything is evenly combined. Wrap and chill in the refrigerator for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a roasting pan or baking dish. Using damp hands, roll 4 giant meatballs, and place in the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until an instant read thermometer inserted near the center of meatballs reads 160 to 165 degrees F (71 to 74 degrees C), 40 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Remove meatballs from the oven, and spoon tomato sauce evenly over meatballs. Sprinkle first with Monterey Jack cheese, and then with Parmigiano-Reggiano."
    },
    {
      "position": 6,
      "text": "Return meatballs to the oven, and bake until sauce is hot and cheese is melted, 5 to 10 minutes more. Top with parsley and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4cb1e30c-69a4-507d-a5e7-067db9471031",
  "slug": "lavash-cracker-bread",
  "name": "Lavash Cracker Bread",
  "recipe_type": "appetizer",
  "brief_description": "Make this lavash cracker bread at home for pennies instead of buying it at your grocery store deli for so much more.",
  "cuisine": "Armenian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir water, flour, and yeast together in the bowl of a stand mixer until moistened. Mix in 1 cup flour and salt. Gradually mix in remaining 2 cups flour with a dough hook attachment until dough comes together."
    },
    {
      "position": 2,
      "text": "Knead dough until elastic, 8 to 10 minutes. Add more flour or water, if needed, to keep dough from getting sticky or too stiff. Cover and let rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 3,
      "text": "Punch down dough and roll into a long log; cut into 30 small walnut-sized pieces. Roll each piece into a ball. Cover with a damp kitchen towel and let rest for 30 minutes."
    },
    {
      "position": 4,
      "text": "Place an ungreased baking sheet on the center rack of the oven; preheat to 500 degrees F (260 degrees C)."
    },
    {
      "position": 5,
      "text": "Roll each ball into a circle about 8 inches in diameter; dough should be paper thin and almost translucent. (If dough is too thick, it will bubble up like pita bread.)"
    },
    {
      "position": 6,
      "text": "Pull out the oven shelf and place as many crackers onto the hot baking sheet as possible. Close the oven and bake until lightly browned on top with small bubbles, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Remove crackers from the oven and transfer to a wire rack to cool."
    },
    {
      "position": 8,
      "text": "Repeat Steps 5 to 7 to bake remaining batches, adjusting dough thickness as necessary."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,

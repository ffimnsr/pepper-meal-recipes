  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "585ec2ef-2bb7-5ab7-a8ef-a78c4833f49c",
  "slug": "pork-chops-al-pastor-recipe-8623640",
  "name": "Pork Chops Al Pastor",
  "recipe_type": "side",
  "brief_description": "These pork chops al pastor are inspired by the popular tacos al pastor. Smoky, spicy, tender, and juicy, the chili marinade also serves as a sauce, with a cold, bracing fresh pineapple salsa on the side. They are double-thick, so each one will make 2 servings.",
  "cuisine": "Middle Eastern Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place chops in a resealable plastic bag set in a bowl. Add pineapple, guajillo, New Mexico chili powder, chipotle, cinnamon, salt, white vinegar, garlic, and onions to the jar of a blender, and blend until marinade is smooth; pour marinade into bag. Massage pork to coat evenly. Press out air, seal the bag, and refrigerate overnight, or up to 48 hours."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat olive oil in an oven-safe pan over medium-high heat. Remove chops from marinade, scraping off as much excess as possible; reserve all marinade for the sauce. Sear chops in the hot pan on both sides until lightly browned, about 3 minutes per side. Remove to a plate; set aside."
    },
    {
      "position": 4,
      "text": "Add yellow onion, cumin, and dried oregano to the pan, and cook, stirring, for 1 minute. If pan seems dry, add another drizzle of oil."
    },
    {
      "position": 5,
      "text": "Turn off heat, and pour in water. Stir, scraping any brown bits off the bottom of the pan. Place chops on top of onion mixture."
    },
    {
      "position": 6,
      "text": "Roast in the preheated oven until pork is cooked to taste, 20 to 30 minutes, basting or brushing chops with pan juices occasionally. An internal temperature of 140 to 145 degrees F (60 to 63 degrees C) will ensure juicy, tender meat. Roasting time will vary greatly depending on size of chops, so check temperature with an instant-read thermometer early and often."
    },
    {
      "position": 7,
      "text": "Meanwhile, pour marinade into a saucepan, and add about 1/2 cup of water, or as needed to achieve desired thickness. Bring to a simmer on medium-high heat, whisking occasionally. Taste sauce for seasoning; keep warm until needed."
    },
    {
      "position": 8,
      "text": "To make salsa, combine white onion, diced pineapple, fresh oregano, \u00bc teaspoon salt, and lime juice in a bowl and mix thoroughly."
    },
    {
      "position": 9,
      "text": "Remove pork from the oven; tent with foil and let rest for 5 to 10 minutes before serving. While resting, tops of chops can be garnished with sauce and a spoon of salsa."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": 5,

  "schema_version": 1,
  "id": "dea03165-2a9e-597c-b59c-19c2bc920816",
  "slug": "eggplant-parmesan-with-fresh-basil-and-smoked-mozzarella",
  "name": "Eggplant Parmesan with Fresh Basil and Smoked Mozzarella",
  "recipe_type": "main",
  "brief_description": "This eggplant Parmesan recipe with fresh basil and smoked mozzarella has plenty of basil, mozzarella cheese, marinara sauce, and fried eggplant slices.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Line a plate with a paper towel; place 2 to 3 eggplant slices in a single layer onto the prepared plate. Sprinkle eggplant with sea salt; top with a paper towel. Repeat layering, salting, paper toweling with remaining eggplant. Place 2 paper towels on top layer; place a plate on top. Place a heavy book or canned food onto plate to squeeze out moisture for 20 minutes to 2 hours. Rinse eggplant slices; pat dry."
    },
    {
      "position": 2,
      "text": "Beat eggs and milk together in a shallow bowl. Place bread crumbs into a separate shallow bowl. Dip eggplant slices into egg mixture. Lift up so excess egg drips back into the bowl. Gently press into bread crumbs to coat both sides. Place breaded eggplant, unstacked, onto a plate. Repeat with remaining eggplant."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large skillet over medium-high heat. Lower eggplant slices carefully into the hot oil in small batches; fry until golden brown, 1 to 2 minutes per side. Drain on paper towels. Repeat with remaining eggplant slices."
    },
    {
      "position": 5,
      "text": "Pour about \u00bc cup marinara sauce into bottom of the prepared baking dish; cover with 1 layer fried eggplant slices. Scatter basil and a few slices smoked mozzarella cheese over eggplant; repeat layers, ending with sauce. Sprinkle Parmesan cheese on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until heated through and cheese has melted, about 15 minutes. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

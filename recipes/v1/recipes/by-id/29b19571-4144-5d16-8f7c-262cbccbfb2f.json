  "id": "29b19571-4144-5d16-8f7c-262cbccbfb2f",
  "slug": "salsa-macha-recipe-8386066",
  "name": "Salsa Macha",
  "recipe_type": "appetizer",
  "brief_description": "Salsa macha originated in the Mexican states of Veracruz and Oaxaca. It\u2019s very similar in appearance to chili crisp but totally different in flavor. This salsa can be made as spicy as you like by adding more chilies de \u00e1rbol or milder by adding less.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Remove the stems and seeds from the chili peppers. Chop into 1/4-inch pieces. Set aside."
    },
    {
      "position": 2,
      "text": "Heat oil over medium heat until it begins to shimmer. Add sesame seeds and garlic. Cook, stirring constantly, until sesame seeds are browned and garlic has crisped up, about 5 minutes. Remove from heat. Add chili peppers and stir until combined. Let sit at room temperature until cool, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in vinegar, salt, and Mexican oregano. Pour mixture into a food processor and pulse several times until the salsa is combined, making sure not to over process. Stir in peanuts."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

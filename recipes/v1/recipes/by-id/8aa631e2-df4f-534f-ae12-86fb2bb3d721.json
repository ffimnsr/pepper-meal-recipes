  "id": "8aa631e2-df4f-534f-ae12-86fb2bb3d721",
  "slug": "grilled-cheese-sloppy-joes",
  "name": "Grilled Cheese Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "Two classic sandwiches are combined into one in this easy recipe that will have grilled cheese and Sloppy Joe fanatics in comfort food heaven!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and minced in the hot skillet until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Add chili sauce and brown sugar. Rinse chili sauce jar with water to get the remnants of the sauce; add to the beef mixture. Stir, reduce heat, and simmer for 10 to 15 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Butter one side of 2 slices of bread. Place one slice, butter-side down, in a new skillet over medium heat. Layer with 1 slice of American cheese, a scoop of Sloppy Joe mixture, another slice of cheese, and the second piece of bread, butter-side up. Cook until sandwich is browned on the bottom and the bottom slice of cheese is melted, 3 to 5 minutes. Flip sandwich over and repeat on the other side. Repeat to assemble and cook remaining sandwiches."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

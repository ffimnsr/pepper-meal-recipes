  "slug": "baby-guinness",
  "name": "Baby Guinness",
  "recipe_type": "drink",
  "brief_description": "A baby Guinness shot is made with coffee liqueur and Irish cream for a delicious St. Patrick's day shooter that looks like a mini pint of Guinness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a shot glass almost to the top with coffee liqueur."
    },
    {
      "position": 3,
      "text": "Top off with Irish cream; it will float on top, making the shot's ''head\" which is what you get on a pint of draught Guinness."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

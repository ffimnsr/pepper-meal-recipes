  "id": "327849e8-57d5-5a42-a4be-5edd0d6c5a7b",
  "slug": "stefs-slow-cooker-creme-brulee",
  "name": "Stef's Slow Cooker Creme Brulee",
  "recipe_type": "dessert",
  "brief_description": "Creme brulee cooked in the slow cooker is an easy way to prepare this creamy dessert and you only need 5 simple ingredients.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk yolks with 1/4 cup sugar and salt in a bowl until smooth; gently whisk in cream and vanilla extract. Strain custard mixture into a liquid measuring cup."
    },
    {
      "position": 2,
      "text": "Line bottom of a 6-quart oval slow cooker with a folded kitchen towel to create a level surface so ramekins won't slide around. Set four 4-ounce ramekins on the towel. Fill slow cooker with enough water to come halfway up sides of ramekins."
    },
    {
      "position": 3,
      "text": "Pour custard evenly into ramekins. Drape paper towels over top of slow cooker liner to absorb any condensation during baking; cover with lid to secure."
    },
    {
      "position": 4,
      "text": "Cook on Low until custard is set but jiggles slightly, about 2 hours."
    },
    {
      "position": 5,
      "text": "Transfer ramekins to a rack to cool completely, about 45 minutes. Refrigerate custards, uncovered, until cold, at least 3 hours."
    },
    {
      "position": 6,
      "text": "Sprinkle 1 teaspoon sugar over each ramekin and shake gently to distribute evenly. Heat the sugar using a culinary torch until melted and browned, about 1 minute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,

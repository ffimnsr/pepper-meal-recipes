  "id": "719d53ef-7c42-5ad4-9ba7-b1149111b8b8",
  "slug": "artichoke-and-crab-spread",
  "name": "Artichoke and Crab Spread",
  "recipe_type": "appetizer",
  "brief_description": "I bought a similar spread at the grocery store a while back, and I thought that I could do it better and cheaper myself. You can use imitation crab, instead of the real thing if you like. I use cooked and frozen artichoke hearts or you can buy fresh artichokes, and cook the hearts up yourself.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place artichoke hearts, crab, green onions, garlic, and lemon juice in a food processor and pulse until chopped fairly small. Add cream cheese and puree until smooth."
    },
    {
      "position": 2,
      "text": "Pour dip into a non-metallic bowl, and chill for 1 hour."
    },
    {
      "position": 3,
      "text": "Serve with crackers or vegetables."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

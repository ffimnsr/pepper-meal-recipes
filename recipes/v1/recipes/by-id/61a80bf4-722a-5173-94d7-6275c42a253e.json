{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "61a80bf4-722a-5173-94d7-6275c42a253e",
  "slug": "chicken-andouille-seafood-gumbo-recipe-11893049",
  "name": "Chicken Andouille Seafood Gumbo",
  "recipe_type": "soup",
  "brief_description": "This chicken andouille seafood gumbo has it all: the Trinity of onion, celery, and bell pepper, and plenty of Cajun spice, crawfish tails, shrimp, andouille, and chicken. Beginning with a deep, dark roux, and served with rice, it's a celebration.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "If using chicken breast, butterfly or cut in half horizontally to make it thinner and cut down on cooking time."
    },
    {
      "position": 2,
      "text": "Season chicken lightly with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Heat 3 tablespoons vegetable oil in a cast iron skillet. Cook chicken until lightly browned, remove from heat, and set aside to cool. It will finish cooking in the hot gumbo broth."
    },
    {
      "position": 4,
      "text": "Place the andouille sausage in the same skillet flat, and cook until lightly charred. (I do this because I like a little charring on the sausage, but you can skip this step)."
    },
    {
      "position": 5,
      "text": "Using a Dutch oven on medium to low heat, heat 1 cup vegetable oil. Be very careful not to scorch or burn the oil. Once oil is hot, slowly whisk in 1 cup plus 2 tablespoons flour."
    },
    {
      "position": 6,
      "text": "Continue whisking or stirring flour and oil mixture until your desired color. This is the roux and is the most important part of making a good pot of gumbo. I prefer a very dark chocolate color roux, which requires constant stirring for about 35 to 40 minutes."
    },
    {
      "position": 7,
      "text": "Once the roux has reached the color you prefer, stir in onions, celery, and bell peppers (the Trinity). Add 2 tablespoons Cajun spices. It will be thick; continue to stir for 10 to 12 minutes until vegetables begin to soften."
    },
    {
      "position": 8,
      "text": "Slowly pour in broth; pour a little, stir a little, and keep repeating until all broth has been added to the pot."
    },
    {
      "position": 9,
      "text": "Turn heat down to medium-low, add 2 bay leaves and cover, and allow to simmer for 10 minutes. Stir and taste for flavor; add 1 tablespoon more Cajun spice if needed."
    },
    {
      "position": 10,
      "text": "Meanwhile, pull chicken into shreds or cut chicken into bite-sized chunks. Add chicken to the pot, cover and simmer for 5 minutes."
    },
    {
      "position": 11,
      "text": "Stir in andouille sausage; cover and simmer for 5 minutes."
    },
    {
      "position": 12,
      "text": "Add shrimp and crawfish tails to the pot. Stir, cover, and simmer until shrimp is opaque, about 3 minutes."
    },
    {
      "position": 13,
      "text": "Turn heat off and allow gumbo to sit, covered, for 10 minutes. Remove bay leaves and serve with a side of rice."
    }
  ],
  "servings": 12,

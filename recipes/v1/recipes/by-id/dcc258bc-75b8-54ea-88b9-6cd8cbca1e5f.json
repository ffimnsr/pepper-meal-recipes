  "id": "dcc258bc-75b8-54ea-88b9-6cd8cbca1e5f",
  "slug": "flavorful-tater-tot-casserole",
  "name": "Flavorful Tater Tot Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This warm and comforting casserole made with a creamy sausage base topped with potato nuggets and cheese is a hearty meal for cold winter days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Add onion and garlic; cook and stir until onion is softened, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix tomatoes with green chile peppers, broccoli, Mexican cheese blend, and cream of celery soup into sausage mixture; spread into the prepared baking dish. Arrange potato nuggets over sausage mixture; season with pepper."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is bubbling and potato nuggets are slightly brown, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

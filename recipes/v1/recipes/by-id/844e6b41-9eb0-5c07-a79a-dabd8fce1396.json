  "id": "844e6b41-9eb0-5c07-a79a-dabd8fce1396",
  "slug": "stroopwafels-with-treacle",
  "name": "Stroopwafels with Treacle",
  "recipe_type": "dessert",
  "brief_description": "A treacle filling is sandwiched between two thin, crispy waffles in this authentic recipe for Dutch stroopwafel, a rich caramel cookie.",
  "cuisine": "Dutch",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, 1 cup melted butter, white sugar, milk, egg, and yeast in a large bowl. Knead until dough is smooth and elastic. Cover loosely with plastic wrap and let rise, about 45 minutes."
    },
    {
      "position": 2,
      "text": "Heat treacle, brown sugar, 1/4 cup butter, and cinnamon in a small saucepan over medium heat until melted together, 3 to 5 minutes. Mix well until filling is smooth."
    },
    {
      "position": 3,
      "text": "Preheat a shallow waffle iron according to manufacturer's instructions."
    },
    {
      "position": 4,
      "text": "Knead dough briefly and divide it into balls about 1 1/2 inches in diameter, or as needed to fit your waffle iron."
    },
    {
      "position": 5,
      "text": "Bake 1 ball of dough the preheated iron until golden brown and iron stops steaming, 30 seconds to 1 minute. Remove with a cake spatula. Press down with a round cutter to trim edges for a perfect circle. Carefully slice horizontally into 2 rounds while still hot. Spread 1 to 2 tablespoons of the filling on each round and sandwich together. Repeat with remaining dough."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

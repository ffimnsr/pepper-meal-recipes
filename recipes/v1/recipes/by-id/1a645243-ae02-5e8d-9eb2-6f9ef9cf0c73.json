  "slug": "easy-energy-bars",
  "name": "Easy Energy Bars",
  "recipe_type": "appetizer",
  "brief_description": "Made with 7 simple ingredients, these chocolate, flax, and oat-stuffed energy bars are the perfect pick-me-up snack when you're on the go.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir oats, chocolate chips, flax meal, peanut butter, honey, vanilla extract, and salt together in a bowl. Roll into 24 balls and refrigerate until firm, at least 30 minutes."
    }
  ],
  "servings": 24,

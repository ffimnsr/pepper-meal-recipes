  "id": "dceee419-6718-502e-a3b7-7e14b03f4d6a",
  "slug": "sarahs-everything-caulipower-crackers",
  "name": "Sarah's Everything Caulipower Crackers",
  "recipe_type": "appetizer",
  "brief_description": "These keto and low-carb cauliflower crackers come together in minutes and need only 4 ingredients. You would never guess they're cauliflower-based with so much flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a rimmed baking sheet with aluminum foil, and place a cooling rack on top."
    },
    {
      "position": 2,
      "text": "Brush both sides of the pizza crust with olive oil and place on top of the cooling rack. Sprinkle with Parmesan cheese and everything bagel seasoning."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 17 minutes. Cut into bite-sized pieces."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 17,
  "preparation_time_minutes": 5,

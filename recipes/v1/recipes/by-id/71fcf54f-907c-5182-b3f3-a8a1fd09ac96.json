  "id": "71fcf54f-907c-5182-b3f3-a8a1fd09ac96",
  "slug": "easy-raspberry-possets-recipe-12034902",
  "name": "Easy Raspberry Possets",
  "recipe_type": "dessert",
  "brief_description": "These raspberry possets are an elegant, creamy dessert with a silky, pudding-like texture that\u2019s surprisingly easy to make. Bright raspberries and fresh lemon add just the right amount of tart sweetness to balance the rich cream.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Place raspberries, cream, sugar, lemon zest, and salt in a heavy-bottomed saucepan over medium heat. Bring to a gentle boil, stirring frequently. Reduce heat to medium-low and cook for 8 minutes, stirring constantly."
    },
    {
      "position": 2,
      "text": "Pour mixture into a fine mesh sieve set over a bowl. Use the back of a spoon or spatula to press on the mixture and extract as much of the liquid as possible. Discard solids. Add lemon juice to the strained raspberry cream mixture, and whisk until mixture begins to slightly thicken, 30 to 60 seconds. Pour mixture evenly into ramekins. Chill ramekins in the refrigerator for at least 4 hours."
    },
    {
      "position": 3,
      "text": "Serve possets cold, garnished with a few extra raspberries, if desired. Store in the refrigerator."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

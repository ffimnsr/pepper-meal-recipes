  "id": "91e53133-3b06-5c64-a25f-855caa4321b0",
  "slug": "the-real-chicago-deep-dish-pizza-dough",
  "name": "The Real Chicago Deep-Dish Pizza Dough",
  "recipe_type": null,
  "brief_description": "This is the real deep dish pizza dough that's used in Chicago. The real thing is nothing like bread, or even pizza dough. It is a buttery, flaky crust.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast and sugar in warm water in a bowl. Let stand until yeast softens and begins to form a creamy foam, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Combine yeast mixture, flour, corn oil, and kosher salt in a large stand mixer fitted with the dough hook; knead until dough holds together but is still slightly sticky, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Form dough into a ball and transfer to a buttered bowl. Turn to coat dough with butter, then cover the bowl with a towel and let rise in a warm place until doubled in volume, about 6 hours."
    },
    {
      "position": 4,
      "text": "Punch down dough and let rest for 10 to 15 minutes. Press dough into a 10-inch deep-dish pizza pan and follow your pizza recipe."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "6083373a-eb1f-5dbd-9f48-8d96a117a33e",
  "slug": "2-ingredient-orange-cake-recipe-11897785",
  "name": "2-Ingredient Orange Cake",
  "recipe_type": "dessert",
  "brief_description": "This 2-ingredient orange cake will be the easiest cake you'll ever bake. Made in a 9x13-inch pan, you can frost, decorate, or top it with anything you like for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine cake mix and soda in a large bowl. Use a hand whisk to mix ingredients until light and smooth, about 3 minutes. Pour batter into a prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake cake in the preheated oven until a toothpick inserted in the center comes out clean, 35 to 40 minutes. Allow cake to cool before frosting, if desired, and cutting. Serve each slice with 1 tablespoon of Cool Whip, if desired."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

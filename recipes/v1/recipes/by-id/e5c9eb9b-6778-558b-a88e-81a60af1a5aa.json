  "id": "e5c9eb9b-6778-558b-a88e-81a60af1a5aa",
  "slug": "rollkuchen-mennonite-fritters",
  "name": "Rollkuchen (Mennonite Fritters)",
  "recipe_type": "snack",
  "brief_description": "Rollkuchen are deep-fried thin and crispy pastry fritters traditionally served with chilled watermelon on hot summer days or at picnics.",
  "cuisine": "Amish American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a large mixing bowl, and beat until frothy. Gradually beat in the flour and salt to make a soft dough. Roll out the dough to be fairly thin, about 1/8 inch, and cut into 2-inch by 5-inch strips. Cut a slit down the center of each strip, and twist so one end slides through the slit and makes a loop."
    },
    {
      "position": 2,
      "text": "Heat 1 \u00bd inches of oil in a deep skillet (or use a deep-fat fryer) to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Cook dough in small batches in preheated oil until golden brown. Drain on paper towels. Serve warm or at room temperature."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

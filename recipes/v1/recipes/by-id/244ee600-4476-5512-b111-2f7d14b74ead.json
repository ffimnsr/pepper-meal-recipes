  "id": "244ee600-4476-5512-b111-2f7d14b74ead",
  "slug": "egg-bites",
  "name": "Egg Bites",
  "recipe_type": "breakfast",
  "brief_description": "This egg bites recipe is made with eggs, spinach, ham, potatoes, onion, and bell pepper baked in muffin cups for the ultimate grab-and-go breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 12-cup muffin tin with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Place a thin layer of potato slices in the bottom of each muffin cup. Add a little butter on top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 5 minutes."
    },
    {
      "position": 4,
      "text": "Mix together eggs, bell pepper, tomato, spinach, ham, and onion in a large bowl. Ladle egg mixture over warm potatoes. Top each muffin cup with a mozzarella cube."
    },
    {
      "position": 5,
      "text": "Continue baking until eggs are set, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

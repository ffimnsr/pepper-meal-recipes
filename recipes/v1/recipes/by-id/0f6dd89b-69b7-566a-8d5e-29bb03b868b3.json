  "slug": "thai-pesto",
  "name": "Thai Pesto",
  "recipe_type": "salad",
  "brief_description": "Add a taste of Thai to noodles, salad, rice, or any dish with this cilantro pesto featuring fish sauce, peanut butter, ginger, and garlic.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Blend cilantro, peanut butter, garlic, olive oil, ginger, fish sauce, brown sugar, and cayenne pepper in a blender until smooth."
    }
  ],

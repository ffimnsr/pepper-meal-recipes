  "id": "ccf310de-ae5c-5dcf-9537-b965d84af628",
  "slug": "easy-doner-style-kebab-recipe-11871835",
  "name": "Easy Doner-Style Kebab",
  "recipe_type": "main",
  "brief_description": "This easy doner-style kebab mimics the kebab meat sliced from a whole with a clever way of baking spiced meat folded into parchment. Serve on pita with fresh tomato and onion, a yogurt sauce, and hot sauce.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ground beef, ground lamb, onion, 3 tablespoons yogurt, olive oil, paprika, cumin, coriander, oregano, salt, and pepper in a bowl. Mix until very well combined and smooth."
    },
    {
      "position": 3,
      "text": "Divide meat mixture among 4 rectangular sheets of parchment paper. Place a piece of parchment on top of the meat and use a rolling pin to spread it all the way to the edges in a very thin layer covering the sheet of parchment paper. Remove the top sheet."
    },
    {
      "position": 4,
      "text": "Starting at the shorter end of the paper, fold the meat covered parchment, several times in about 1 1/2-inch folds. Place folded filled parchment on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 to 35 minutes, draining off some of the accumulated fat and juices halfway through."
    },
    {
      "position": 6,
      "text": "Unravel meat from the paper and return to the baking sheet. If you prefer more browning, return unfolded meat to the oven for 5 to 10 minutes longer. Sprinkle with 1 to 2 tablespoons lemon juice."
    },
    {
      "position": 7,
      "text": "Meanwhile, combine remaining yogurt and lemon juice in a small bowl. Stir in garlic; season with salt. Add 1 or 2 tablespoons water if sauce seems too thick."
    },
    {
      "position": 8,
      "text": "Tear meat into large pieces and serve on warm pita with parsley leaves, sliced onion, and tomato. Drizzle with yogurt sauce and hot sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

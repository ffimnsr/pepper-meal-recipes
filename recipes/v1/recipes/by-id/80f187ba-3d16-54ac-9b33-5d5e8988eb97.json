  "id": "80f187ba-3d16-54ac-9b33-5d5e8988eb97",
  "slug": "spinach-tomato-and-feta-egg-white-omelette",
  "name": "Spinach, Tomato, and Feta Egg White Omelette",
  "recipe_type": "breakfast",
  "brief_description": "This spinach, tomato, and feta egg white omelet recipe is stuffed with veggies and feta cheese for an easy, quick, and filling way to start the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium heat; coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk egg whites, salt, and black pepper together in a bowl; pour into the skillet and swirl until eggs cover entire bottom of skillet. Cook for 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Arrange tomatoes, spinach, and feta cheese in center of eggs. Cook until edges of eggs begin to curl up, 2 to 3 minutes more. Loosen omelet from skillet using a spatula and fold in half; continue cooking until cheese melted, 2 to 3 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "64e90433-7f3c-5dd4-8a9f-6c7d04c896ab",
  "slug": "heirloom-tomato-bruschetta",
  "name": "Heirloom Tomato Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Farmers market heirloom tomatoes and truffle-infused oil bring the wow factor in this easy bruschetta recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss heirloom tomatoes with chopped basil, truffle oil, salt, and pepper. Set aside."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet; add chopped garlic. Cook baguette slices until browned, 2 to 3 minutes per side. Rub each side of the baguette with the halved garlic clove."
    },
    {
      "position": 3,
      "text": "Spoon tomato mixture over the baguette slices."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

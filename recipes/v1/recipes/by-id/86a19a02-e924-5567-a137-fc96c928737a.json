  "id": "86a19a02-e924-5567-a137-fc96c928737a",
  "slug": "thanksgiving-cheese-ball",
  "name": "Thanksgiving Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Similar to other cheese ball recipes, yet different! Double it and freeze one for easy entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a food processor, mix the cream cheese, Cheddar cheese, blue cheese, onion, garlic, and Worcestershire sauce. Process until well blended. Add olives, and pulse into small chunks."
    },
    {
      "position": 2,
      "text": "Shape the mixture into a ball, and roll in the chopped pecans to coat. Wrap in plastic, and chill at least 4 hours in the refrigerator."
    }
  ],
  "servings": 8,

  "schema_version": 1,
  "id": "1e9a6365-4f27-5984-aae3-d7617932cc50",
  "slug": "bobotie-south-african-beef-casserole-recipe-8738400",
  "name": "Bobotie (South African Beef Casserole)",
  "recipe_type": "main",
  "brief_description": "Bobotie, a South African curry beef casserole made of an aromatic meat filling with a bay leaf-infused thin custard on top, is an easy, gorgeous, and extremely delicious one-pan meal.",
  "cuisine": "African",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil and butter in a large oven-proof skillet over medium heat. Add onions and salt, and cook until just beginning to soften and turn translucent, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in curry powder, cumin, turmeric, black pepper, and oregano, and cook for 1 to 2 minutes more."
    },
    {
      "position": 4,
      "text": "Add ground beef, and cook, stirring, while breaking the meat up into small crumbles. Add 1 bay leaf, tomato paste, and garlic, and cook, stirring, for another 2 minutes."
    },
    {
      "position": 5,
      "text": "Stir in lemon juice and zest, vinegar, Worcestershire, and chutney. Smooth the top, and simmer mixture gently for 5 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, add bread to a bowl and cover with 1/2 cup of milk, toss, and let stand for 5 minutes. Squeeze excess milk back into the bowl and add soaked bread to meat. Mash, smash and stir mixture until bread is thoroughly blended in."
    },
    {
      "position": 7,
      "text": "Add remaining 1 cup milk to the bowl; add eggs, cayenne, and pinch of salt, and whisk thoroughly. Pour gently over meat, and top with 3 or more bay leaves."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until custard on top is set and lightly golden brown, about 45 minutes. Let rest 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 5,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "63a5b78f-dee1-500b-a66e-76a2d6d4efa5",
  "slug": "poblano-chicken-enchilada-casserole",
  "name": "Poblano Chicken Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "I've begun making my enchiladas casserole style, which saves a lot time, not to mention burned fingers. :) However, everyone still raves over my enchiladas, and this recipe recently earned a round of applause when I made them on a skiing holiday. The sauce is actually a modified Alfredo recipe and is also great over fajitas.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium heat. Place the chicken breasts in the skillet. Mix in the poblano peppers, jalapeno peppers, and garlic. Squeeze the juice from one lime half over the chicken, and place the lime peel and pulp into the skillet."
    },
    {
      "position": 3,
      "text": "Cover, and simmer 25 minutes, stirring occasionally, until chicken juices run clear. Remove from heat, cool, and cut chicken into cubes. Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Melt 1/4 cup butter in a medium saucepan over low heat. Gradually stir in the flour and half-and-half. Mix in the cilantro, mushrooms, sour cream, and juice of remaining lime half. Cook and stir 10 minutes, until mushrooms are tender."
    },
    {
      "position": 5,
      "text": "Line the bottom of a 9x13 inch baking dish with 6 tortillas. Arrange 1/2 the chicken and pepper mixture over the tortillas. Sprinkle with 1 cup cheese, and cover with remaining tortillas."
    },
    {
      "position": 6,
      "text": "Layer with remaining chicken and pepper mixture, and pour the cilantro sauce evenly over the casserole. Top with remaining cheese."
    },
    {
      "position": 7,
      "text": "Bake 25 minutes in the preheated oven, until cheese is melted and lightly browned."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

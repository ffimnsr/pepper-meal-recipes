  "id": "af99800a-e62f-5ffb-9d5c-f9cea712d3c5",
  "slug": "oatmeal-carmelitas",
  "name": "Oatmeal Carmelitas",
  "recipe_type": "dessert",
  "brief_description": "Chewy gooey caramel, nuts and chocolate. We call them Goober Cookies. They taste great the next day if you get them to last that long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x9 inch square pan."
    },
    {
      "position": 2,
      "text": "Combine the 1 cup flour, baking soda, oats, brown sugar, salt and melted butter. Mix to combine, mixture will be very crumbly. Press half of the mixture into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 10 minutes."
    },
    {
      "position": 4,
      "text": "Let cool slightly then sprinkle over the crust the chocolate chips and chopped nuts. Mix the caramel ice cream topping with the 3 tablespoons of flour and drizzle over the chocolate chips. Top with the remaining oatmeal mixture. You will need to break it into small pieces to cover."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 15 minutes. Let bars cool before cutting."
    }
  ],
  "servings": 36,

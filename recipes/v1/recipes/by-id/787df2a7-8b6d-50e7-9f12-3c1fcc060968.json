  "id": "787df2a7-8b6d-50e7-9f12-3c1fcc060968",
  "slug": "garlicky-appetizer-shrimp-scampi",
  "name": "Garlicky Appetizer Shrimp Scampi",
  "recipe_type": "appetizer",
  "brief_description": "Quick, delicious grilled shrimp in a garlicky olive oil-butter sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat grill for high heat."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together softened butter, olive oil, garlic, shallots, chives, salt, pepper, and paprika; add the shrimp, and toss to coat."
    },
    {
      "position": 3,
      "text": "Lightly oil grill grate. Cook the shrimp as close to the flame as possible for 2 to 3 minutes per side, or until opaque."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 15,

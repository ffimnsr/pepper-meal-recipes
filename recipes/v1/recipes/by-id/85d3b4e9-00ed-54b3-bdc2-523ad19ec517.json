  "slug": "blueberry-cinnamon-overnight-oats-with-greek-yogurt",
  "name": "Blueberry-Cinnamon Overnight Oats with Greek Yogurt",
  "recipe_type": "breakfast",
  "brief_description": "Blueberries, cinnamon, and Greek yogurt are great additions to overnight oats. Everything gets prepared the night before to make your morning breakfast easy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine rolled oats, blueberries, Greek yogurt, soy milk, cinnamon, and sugar in a lidded jar. Cover, shake to mix, and refrigerate 8 hours to overnight."
    }
  ],

  "id": "901866ec-6559-5589-8792-5ddcad1ee519",
  "slug": "grilled-buffalo-wings",
  "name": "Grilled Buffalo Wings",
  "recipe_type": "appetizer",
  "brief_description": "These grilled buffalo wings with a spicy homemade buffalo sauce are easy to cook on the grill instead of frying for a crowd-pleasing party appetizer.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a grill to medium heat."
    },
    {
      "position": 2,
      "text": "Mix hot sauce, cola, cayenne pepper, black pepper and soy sauce together in a large pot; add wings to the sauce. Place the pot on one side of the preheated grill; bring to a simmer."
    },
    {
      "position": 3,
      "text": "Use tongs to transfer wings out of sauce and place on the preheated grill; cook until lightly charred on both sides, about 8 to 10 minutes, then return wings to the sauce to continue cooking. Repeat this process until chicken is cooked and pulls easily off of the bone, and the sauce is hot and thickened, about 50 minutes. You can serve them as sloppy-style wings, or serve right off the grill for dryer wings."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

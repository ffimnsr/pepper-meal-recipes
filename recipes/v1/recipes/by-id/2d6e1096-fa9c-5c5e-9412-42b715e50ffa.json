  "id": "2d6e1096-fa9c-5c5e-9412-42b715e50ffa",
  "slug": "easy-and-simple-korean-bbq-ribs",
  "name": "Easy and Simple Korean BBQ Ribs",
  "recipe_type": "dessert",
  "brief_description": "A streamlined version for Korean barbecued ribs. Beef ribs are marinated in a sweet and garlicky soy marinade for 2 hours instead of overnight, then grilled.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together the soy sauce and sugar in a bowl until the sugar has dissolved, and stir in the black pepper, garlic, green onions, sesame oil, and sesame seeds."
    },
    {
      "position": 2,
      "text": "Place the ribs in a large bowl, and pour the marinade over the ribs. Stir to coat the ribs with the marinade, and refrigerate for 1 hour. Stir the ribs and marinade again, and refrigerate for 1 more hour."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove the ribs from the marinade, discard the marinade, and grill the ribs until brown and no longer pink in the center, about 5 minutes per side. Have a spray bottle of water handy in case the ribs flare up."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

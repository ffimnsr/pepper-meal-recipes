  "slug": "melon-and-prosciutto-salad-recipe-11706384",
  "name": "Melon and Prosciutto Salad",
  "recipe_type": "salad",
  "brief_description": "In this melon and prosciutto salad the combination of sweet ripe melons with savory, salty prosciutto creates the perfect balance. Topped with shaved almonds, feta crumbles, and a champagne dressing, it will be a hit at your next gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine spring mix, feta crumbles, and shaved almonds in a large bowl. Add champagne salad dressing, toss well, and set aside."
    },
    {
      "position": 2,
      "text": "Very carefully wrap the prosciutto around 1 wedge of melon at a time and place on top of the salad mixture. Repeat with remaining melon and prosciutto."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

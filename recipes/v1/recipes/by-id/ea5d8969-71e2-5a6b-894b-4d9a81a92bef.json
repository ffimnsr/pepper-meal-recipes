  "id": "ea5d8969-71e2-5a6b-894b-4d9a81a92bef",
  "slug": "carrot-cake-roll",
  "name": "Carrot Cake Roll",
  "recipe_type": "dessert",
  "brief_description": "This carrot cake roll flavored with carrots, pineapple, and cinnamon has a sweet cream cheese filling for an impressive dessert perfect for parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a rimmed cookie sheet or jelly roll pan with parchment paper."
    },
    {
      "position": 2,
      "text": "To make the cake: Beat eggs and sugar in a mixing bowl until lighter in color; add carrot and pineapple."
    },
    {
      "position": 3,
      "text": "Mix flour, cinnamon, baking powder, and salt together in a separate bowl. Pour in egg mixture; mix until it comes together. Spread batter on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Allow to cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "To make the filling: Beat cream cheese, powdered sugar, and vanilla extract together in a bowl. Spread cream cheese filling evenly over the cooled cake. Sprinkle walnuts on top of filling."
    },
    {
      "position": 6,
      "text": "Run a spatula under the cake to loosen from the parchment paper. Grab the paper from one end and start rolling, pulling the paper away as you do. Roll up and refrigerate for 1 hour before cutting."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "3830912c-7f76-5dc2-a9b1-e1a71596b778",
  "slug": "copycat-culvers-cheese-curds-recipe-12011486",
  "name": "These Copycat Culver\u2019s Cheese Curds Will Have You Skipping the Drive-Thru",
  "recipe_type": "appetizer",
  "brief_description": "These copycat Culver\u2019s cheese curds deliver the crispy, golden-brown crunch and gooey Cheddar cheese center that made the original famous. Even better, you can bread and freeze them ahead of time, then fry them straight from the freezer whenever company stops by.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 10x15-inch rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir flour, garlic powder, pepper, and salt together in a shallow bowl. Coat each cheese curd in flour mixture. Place on the prepared baking sheet and freeze for 30 minutes."
    },
    {
      "position": 3,
      "text": "Whisk together eggs and milk in a shallow bowl until well combined. Place breadcrumbs in a separate shallow bowl."
    },
    {
      "position": 4,
      "text": "Dip each frozen cheese curd in egg mixture, then roll in breadcrumbs to fully coat. Repeat dipping cheese curds a second time in the egg mixture then in the breadcrumb mixture. Place back on the prepared baking sheet. Freeze for at least 4 hours or overnight. If not cooking right away, transfer to a freezer bag, label, and freeze up to 3 months."
    },
    {
      "position": 5,
      "text": "Heat 1 1/2 inches of oil in a deep fryer or 3-quart saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Fry cheese curds in small batches until golden brown and crisp, 1 to 2 minutes (if you start to see some cheese oozing out, they are done). Transfer to a paper towel\u2013lined plate to drain and serve immediately with ranch dressing. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "a75bc578-10cc-5916-a2a1-a9e050d6ed18",
  "slug": "italian-mashed-potatoes-recipe-11894855",
  "name": "Italian Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "What makes these Italian mashed potatoes Italian, you ask? It's the combination of olive oil in the boiling water, Parmigiano and scamorzza cheese, and a quick bake to melt all of the goodness in.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a pot of salted water with the olive oil to a boil. Then add the potatoes; cook until tender, about 15 minutes. Reserve 1 cup water, and drain potatoes. Transfer to a mixing bowl."
    },
    {
      "position": 3,
      "text": "Mash the potatoes, adding some reserved water to soften and fluff potatoes. You will not need the whole cup of water."
    },
    {
      "position": 4,
      "text": "Fold in parsley, Parmigiano, and scarmozza. Season with salt."
    },
    {
      "position": 5,
      "text": "Transfer to an 8x8-inch baking dish and spread evenly. Sprinkle with breadcrumbs, grate a little Parmigiano over breadcrumbs, and scatter butter pieces on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the top is golden, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ce481b0d-c6b3-5cdf-9b22-576fd34baf74",
  "slug": "homemade-gluten-free-gnocchi",
  "name": "Homemade Gluten-Free Gnocchi",
  "recipe_type": null,
  "brief_description": "Make gluten-free gnocchi at home with this recipe that uses rice flour, eggs, and oven-baked potatoes for an Italian favorite that everyone can enjoy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Prick each potato a few times with a fork and place on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake potatoes in the preheated oven until tender when pierced with a knife, about 50 minutes. Cool until easily handled, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Peel potatoes and pass through a ricer or food mill into a large bowl. Make a well in the center and pour in egg; mix well."
    },
    {
      "position": 4,
      "text": "Whisk potato starch, sweet rice flour, and salt together in a bowl. Sprinkle over potato mixture; stir until a soft dough has formed. Cut dough into 4 equal parts with a knife or pastry cutter."
    },
    {
      "position": 5,
      "text": "Dust the work surface with rice flour to keep dough from sticking. Roll out 1 piece of dough into a rope about 1 inch in diameter. Cut into 1-inch gnocchi. Gently roll each one with the back of a fork to create ridges. Repeat with remaining dough."
    },
    {
      "position": 6,
      "text": "Shake off any excess rice flour and let gnocchi rest, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Bring a large pot of salted water to a boil. Add gnocchi in batches and cook, without stirring, until they float to the top, 1 to 2 minutes. Remove with a slotted spoon."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

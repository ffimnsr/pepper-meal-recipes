  "id": "d716f242-b79d-5fd5-a03a-13410524fccf",
  "slug": "chicken-avocado-and-mango-salad",
  "name": "Chicken, Avocado and Mango Salad",
  "recipe_type": "salad",
  "brief_description": "This is a colorful and very tasty mix of chicken, mangos, and avocados in a spicy lime dressing.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "In a saucepan over medium-high heat, stir together the brown sugar and water. Bring to a boil, then pour into a medium bowl. Stir in the garlic chili sauce and lime juice. Set the dressing aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, toss together the chicken, mangos and avocados."
    },
    {
      "position": 4,
      "text": "Arrange the spring salad mix on serving plates, then top with a few spoonfuls of the chicken mixture. Pour dressing over the top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

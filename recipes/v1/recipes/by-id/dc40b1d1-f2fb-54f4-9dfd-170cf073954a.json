  "id": "dc40b1d1-f2fb-54f4-9dfd-170cf073954a",
  "slug": "pumpkin-chocolate-chip-muffins",
  "name": "Pumpkin Chocolate Chip Muffins",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin chocolate chip muffins recipe makes incredibly moist, easy-to-prepare muffins with canned pumpkin and spices for a delicious fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin pan, or line with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk sugar, eggs, and oil together in a medium bowl. Stir in pumpkin and water until well combined."
    },
    {
      "position": 3,
      "text": "Mix flour, baking powder, baking soda, cinnamon, nutmeg, cloves, and salt together in a large bowl."
    },
    {
      "position": 4,
      "text": "Stir pumpkin mixture into flour mixture until just combined; do not overmix. Fold in chocolate chips."
    },
    {
      "position": 5,
      "text": "Divide batter evenly among muffin cups, filling each about 2/3 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Cool in the pan for a few minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

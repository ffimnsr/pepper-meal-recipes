  "id": "262d0d71-85d1-5a6a-89f4-ee39035745fe",
  "slug": "lime-sandwich-sugar-cookies",
  "name": "Lime Sandwich Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "Delicious sugar cookies sandwiched together with a light green lime flavored icing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, cream together the butter and sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla. Combine the flour, baking powder and salt; stir into the creamed mixture until well blended. Cover or wrap dough, and refrigerate for at least 2 hours. If you are in a big hurry, freeze for a half hour."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). On a lightly floured surface, roll the dough out to 1/4 inch in thickness. Cut into desired shapes with cookie cutters. Place cookies 1 1/2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 7 to 8 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely."
    },
    {
      "position": 4,
      "text": "For the frosting: In a medium bowl, beat the lime juice, milk, confectioners' sugar and green food color until smooth and creamy. Add more milk or sugar if necessary to achieve a good spreading consistency. When cookies are completely cool, spread icing between cookies to make sandwiches."
    }
  ],
  "servings": 55,

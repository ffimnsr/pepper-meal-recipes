  "id": "6f545679-bf63-5e05-8599-8dba54aedcc6",
  "slug": "easy-pineapple-upside-down-cake",
  "name": "Easy Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "A quick and easy pineapple upside-down cake recipe using any biscuit baking mix for a delicious old favorite. A mix makes this classic dish a breeze.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a 9-inch baking pan in the preheating oven. Remove pan."
    },
    {
      "position": 3,
      "text": "Sprinkle brown sugar evenly over butter in the pan."
    },
    {
      "position": 4,
      "text": "Arrange pineapple chunks in a single layer over the butter and brown sugar, then sprinkle with pecans; set aside."
    },
    {
      "position": 5,
      "text": "Beat biscuit baking mix, white sugar, milk, oil, vanilla, and egg together in a large bowl on low speed for 30 seconds, scraping the bowl constantly."
    },
    {
      "position": 6,
      "text": "Increase mixer speed to medium and continue beating until batter is smooth, about 4 minutes more."
    },
    {
      "position": 7,
      "text": "Slowly pour batter over the pineapple mixture."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes."
    },
    {
      "position": 9,
      "text": "Run a paring knife between the cake and the edge of the pan to loosen cake. Cover the cake pan with a plate, and invert it to flip the cake out of the pan and onto the plate. Cool at least 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

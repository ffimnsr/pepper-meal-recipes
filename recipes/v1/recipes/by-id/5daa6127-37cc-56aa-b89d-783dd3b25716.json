  "id": "5daa6127-37cc-56aa-b89d-783dd3b25716",
  "slug": "air-fryer-breakfast-frittata",
  "name": "Air Fryer Breakfast Frittata",
  "recipe_type": "dessert",
  "brief_description": "This versatile air fryer breakfast frittata recipe uses a cake pan that fits in the air fryer basket for fuss-free, light, and fluffy results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C). Spray a nonstick 6x2-inch cake pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine sausage, eggs, cheese, bell pepper, green onion, and cayenne pepper in a large bowl; mix well to combine."
    },
    {
      "position": 3,
      "text": "Pour egg mixture into the prepared cake pan."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer until frittata is set, 18 to 20 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

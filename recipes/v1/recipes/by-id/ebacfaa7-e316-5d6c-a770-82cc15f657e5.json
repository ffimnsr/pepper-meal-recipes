  "id": "ebacfaa7-e316-5d6c-a770-82cc15f657e5",
  "slug": "chewy-chocolate-cookies-ii",
  "name": "Chocolate Cookies",
  "recipe_type": "dessert",
  "brief_description": "Chocolate cookies made with crunchy chopped walnuts are ready in just 10 minutes and always turn out soft and chewy, just like fudge brownies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream sugar and margarine in a large bowl until light and fluffy. Beat in eggs, one at a time, then stir in vanilla."
    },
    {
      "position": 3,
      "text": "Combine flour, cocoa, baking soda, and salt in a separate bowl. Add to the creamed mixture and mix until just blended. Stir in walnuts. Drop spoonfuls of dough 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are set and centers are soft, 8 to 10 minutes. Let sit briefly before transferring to wire racks to cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

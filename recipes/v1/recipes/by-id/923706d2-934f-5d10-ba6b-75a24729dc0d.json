  "slug": "the-girls-chicken-sandwiches",
  "name": "The Girls' Chicken Sandwiches",
  "recipe_type": "salad",
  "brief_description": "Chicken salad made with green onions and poppyseed dressing is served on sweet Hawaiian-style rolls spread with pineapple cream cheese and topped with fresh strawberries for a light and elegant springtime lunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken with green onions in a bowl; moisten with poppyseed salad dressing. Spread both cut sides of each Hawaiian roll with pineapple cream cheese. Place a lettuce leaf half on bottom half of each roll; top with 1/4 cup chicken mixture and about 2 tablespoons of strawberries. Place tops on sandwiches to serve."
    }
  ],

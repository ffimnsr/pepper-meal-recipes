  "id": "be5c7aff-c3b0-5d80-8cef-c3eee9f266a6",
  "slug": "instant-pot-red-posole",
  "name": "Instant Pot Red Posole",
  "recipe_type": "soup",
  "brief_description": "This Instant Pot pozole rojo (red posole) is a rich, brothy soup made with pork shoulder, hominy, and many spices and herbs for a full-flavored dish.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pork, onion, garlic, chili powder, garlic salt, oregano, black pepper, chipotle powder, and cumin in a large bowl; set aside."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Heat olive oil in the pot. Cook and stir pork mixture in hot oil in small batches until pork is browned, about 5 minutes per batch. Turn off the pressure cooker."
    },
    {
      "position": 3,
      "text": "Add broth, enchilada sauce, green chiles, and cilantro to the pot; stir to blend. Close and lock the lid. Select high pressure according to manufacturer's instructions; set the timer for 20 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock the lid and add hominy, stirring to blend."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

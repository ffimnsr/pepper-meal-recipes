  "id": "afd323e5-1a16-53d6-a650-b67897cb877f",
  "slug": "homemade-thin-mints",
  "name": "Homemade Thin Mints",
  "recipe_type": "dessert",
  "brief_description": "If you're a fan of Girl Scout Thin Mints cookies, try making these copycat versions yourself.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter in a large bowl with an electric mixer at medium speed about 30 seconds. Add sugar and salt and beat until combined. Beat in egg yolk and peppermint extract. Beat in flour and cocoa. Shape dough into a 6-inch roll. Wrap in plastic wrap or wax paper. Chill until firm enough to slice, about 2 hours, or freeze about 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Cut roll into 1/8- to 1/4-inch slices. Arrange 2 inches apart on an ungreased baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are firm, 7 to 8 minutes. Cool on the baking sheet on a wire rack (cookies are too delicate to remove until cooled)."
    },
    {
      "position": 5,
      "text": "Microwave semisweet chocolate and candy melts in a small bowl, stirring twice, until melted and smooth, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Dip each cookie into melted chocolate, allowing excess to drip off. Arrange on wax paper-lined trays. Chill until set."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 30,

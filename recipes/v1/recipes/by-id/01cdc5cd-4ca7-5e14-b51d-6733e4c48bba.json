  "id": "01cdc5cd-4ca7-5e14-b51d-6733e4c48bba",
  "slug": "pumpkin-cheese-ball-recipe-8725706",
  "name": "Pumpkin Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This pumpkin cheese ball is a fun make-ahead appetizer for Thanksgiving or Halloween. You can use your favorite cheese, e.g. smoked or flavored cheese and cream cheese are good options.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, hot pepper sauce, paprika, and garlic in a food processor. Process until well combined."
    },
    {
      "position": 3,
      "text": "Add 1 1/2 cups shredded cheese and process until cheese is finely chopped but still very visible."
    },
    {
      "position": 4,
      "text": "Sprinkle about 3 tablespoons of the remaining shredded cheese into a 4-inch pile on a large piece of plastic wrap, and top with a rounded scoop of the cheese ball mixture."
    },
    {
      "position": 5,
      "text": "Sprinkle the cheese ball mound with the remaining shredded cheese."
    },
    {
      "position": 6,
      "text": "Pull sides of plastic wrap up and over the cheese ball mixture to wrap tightly and shape into a ball. (If needed, wrap with an additional piece of plastic wrap to ensure the mixture is very tightly wrapped.)"
    },
    {
      "position": 7,
      "text": "Wrap 4 wide rubber bands around the cheese ball, evenly spacing them to create the indentations that are found on a pumpkin. (Depending on the size of the rubber bands, you may need to double wrap each one to create indentations that are deep enough.)"
    },
    {
      "position": 8,
      "text": "Chill cheese ball in the refrigerator at least 3 hours before serving to allow flavors to meld and the cream cheese to become firm."
    },
    {
      "position": 9,
      "text": "Before serving, remove rubber bands and unwrap cheese ball. Place a bell pepper stem on top of the pumpkin and gently press to adhere. Serve with crackers."
    }
  ],
  "servings": 24,

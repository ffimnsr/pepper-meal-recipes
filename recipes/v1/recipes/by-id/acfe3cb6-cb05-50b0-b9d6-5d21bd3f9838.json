  "id": "acfe3cb6-cb05-50b0-b9d6-5d21bd3f9838",
  "slug": "garlic-herb-linguine",
  "name": "Garlic-Herb Linguine",
  "recipe_type": "main",
  "brief_description": "This linguine pasta recipe features tender linguine tossed with melted butter, garlic, parsley, and seasoned salt. Pair it with any main dish!",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, 10 to 11 minutes."
    },
    {
      "position": 3,
      "text": "Drain and transfer to a large bowl."
    },
    {
      "position": 4,
      "text": "Mix melted butter, garlic, and parsley together in a small bowl."
    },
    {
      "position": 5,
      "text": "Drizzle butter mixture over linguine. Add seasoned salt and toss to coat."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

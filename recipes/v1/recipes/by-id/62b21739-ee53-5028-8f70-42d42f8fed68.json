  "id": "62b21739-ee53-5028-8f70-42d42f8fed68",
  "slug": "chicken-and-dumplings-iii",
  "name": "Mom's Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "This old-time recipe for chicken and dumplings made with condensed cream of celery soup and refrigerated biscuit dough will bring back childhood memories.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over high heat, combine chicken with enough water to cover; bring to a boil. Boil until chicken is no longer pink in the center and the juices run clear, 15 to 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 2,
      "text": "Drain some water, reserving 3 cups in the pot. Remove chicken, allow it to cool slightly, then pull it apart into bite-sized pieces and return to the pot."
    },
    {
      "position": 3,
      "text": "Add condensed soup, season with salt and pepper, and set the heat to medium. Pull biscuit dough into pieces, and add it to the pot. Simmer until dough is cooked through, 7 to 8 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

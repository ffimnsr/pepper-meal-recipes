  "id": "168d3c4d-93a7-5184-88bc-e3c8226f73e0",
  "slug": "smoked-salmon-sandwich",
  "name": "Smoked Salmon Sandwich",
  "recipe_type": "main",
  "brief_description": "This smoked salmon sandwich with crunchy shredded lettuce and smooth goat cheese and cream cheese offers a simple, satisfying contrast of textures.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast bread in a toaster or toaster oven."
    },
    {
      "position": 2,
      "text": "Spread cream cheese and goat cheese on 1 slice of toast. Add smoked salmon on top. Add olive oil, dill, and black pepper. Cover with lettuce and top with the other slice of toast."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,

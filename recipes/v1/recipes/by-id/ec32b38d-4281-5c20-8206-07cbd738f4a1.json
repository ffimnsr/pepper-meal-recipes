  "id": "ec32b38d-4281-5c20-8206-07cbd738f4a1",
  "slug": "strawberry-bellini",
  "name": "Strawberry Bellini",
  "recipe_type": "drink",
  "brief_description": "Whip up a batch of fruity strawberry bellini cocktails with pur\u00e9ed strawberries and sparkling wine, then serve them for any special occasion.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Blend hulled strawberries, confectioners' sugar, and brandy in a blender until smooth. Chill in the refrigerator for 10 minutes."
    },
    {
      "position": 3,
      "text": "Divide the strawberry mixture among three champagne flutes."
    },
    {
      "position": 4,
      "text": "Pour 1/2 cup sparkling wine into each flute and stir to combine."
    },
    {
      "position": 5,
      "text": "Garnish each glass with a whole strawberry."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

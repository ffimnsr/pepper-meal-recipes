  "slug": "berry-chocolate-protein-smoothie-recipe-11711428",
  "name": "Berry Chocolate Protein Smoothie",
  "recipe_type": "dessert",
  "brief_description": "This berry chocolate protein smoothie is the perfect early morning breakfast or the perfect fix for when a sweet craving hits. The chocolate is rich, and the berries provide a little tart sweetness with no added sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add almond milk, strawberries, and blueberries to a high-powered blender, such as a Vitamix\u00ae. Blend on High for 45 seconds. Turn blender off; add protein powder. Blend for 15 seconds more."
    },
    {
      "position": 2,
      "text": "Pour mixture into a glass, top with sugar-free whipped topping and sugar-free chocolate chips."
    }
  ],

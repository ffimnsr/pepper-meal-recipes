  "id": "06632e64-4fbf-5a4b-accb-b2cb3a5a9d4e",
  "slug": "never-bitter-lemonade",
  "name": "Never Bitter Lemonade",
  "recipe_type": "drink",
  "brief_description": "Fresh lemon juice, water, sugar and salt (to remove bitterness) - call the kids in for a glass!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a pot combine water, sugar and salt. Bring to a boil and continue to boil for 2 minutes. Chill the sugar water for at least 60 minutes in the refrigerator."
    },
    {
      "position": 2,
      "text": "In a 2 quart pitcher mix cooled sugar water and lemon juice together. Pour over ice and serve."
    }
  ],
  "servings": 8,

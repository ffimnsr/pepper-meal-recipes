  "id": "9bde4c2a-7547-5639-910f-a5a4b6b5b249",
  "slug": "cranberry-brie-pull-apart-bread-recipe-8732507",
  "name": "Cranberry Brie Pull Apart Bread",
  "recipe_type": "appetizer",
  "brief_description": "This cranberry Brie pull apart bread makes a tasty appetizer or party snack for any holiday occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with foil. Cut bread with a serrated knife from the top nearly to the bottom in diagonal 1-inch diamonds (do not cut through)."
    },
    {
      "position": 3,
      "text": "Combine melted butter, honey, rosemary, thyme, pepper, and salt in a small bowl."
    },
    {
      "position": 4,
      "text": "Gently pull bread open at cuts and evenly drizzle with half of the butter mixture."
    },
    {
      "position": 5,
      "text": "Stuff Brie and cranberries into the cuts as you go."
    },
    {
      "position": 6,
      "text": "Place loaf on prepared baking sheet and drizzle with remaining butter mixture."
    },
    {
      "position": 7,
      "text": "Bake until the Brie is melted and the bread is toasty, 20 to 25 minutes. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

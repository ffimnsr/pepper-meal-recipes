{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0135c9a8-166e-5e8e-b308-e1dec06f5fcb",
  "slug": "simple-classic-chicken-potpie",
  "name": "Simple Classic Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "Add a splash of sherry or white wine to chicken pot pie, and take this comfort-food classic to a whole new level.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Adjust an oven rack to a low-center position and preheat to 400 degrees F (200 degrees C). Press one pie pastry into each of two 9-inch deep-dish pie pans. Reserve remaining pastries until needed."
    },
    {
      "position": 2,
      "text": "Combine broth and evaporated milk in a microwave-safe bowl; microwave on high until steamy, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "At the same time, heat oil in a Dutch oven over medium-high heat. Add onions and celery; saut\u00e9 until just tender, about 5 minutes. Transfer to a bowl."
    },
    {
      "position": 4,
      "text": "Melt butter in the Dutch oven over medium heat. Whisk in flour and thyme, and cook until golden, about 1 minute. Whisk in hot milk mixture and bring to a simmer. Continue to simmer, stirring occasionally, until sauce thickens, about 1 minute."
    },
    {
      "position": 5,
      "text": "Remove the Dutch oven from the heat. Stir in wine, salt, and pepper. Add onion mixture, shredded chicken, frozen vegetables, and parsley; stir until well combined."
    },
    {
      "position": 6,
      "text": "Divide chicken mixture between the prepared pie pans. Place remaining pastries over top, and flute the edges by pinching with your fingers. Place both pie pans onto a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until pastries are golden brown and filling is bubbly, 30 to 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "2410fe37-0e85-5d36-854f-9a9a07795284",
  "slug": "nutella-cream-cheese-pound-cake",
  "name": "Nutella Cream Cheese Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "Not your traditional pound cake, but dense and creamy just the same, with a swirl of Nutella chocolate and hazelnut spread for a delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Whisk together flour and baking powder in a bowl. Cream together sugar and cream cheese with an electric mixer until fluffy. Stir in yogurt. Add eggs one at a time, beating well after each addition. Add vanilla bean paste. Slowly add flour mixture, beating on low speed and taking care not to overmix batter."
    },
    {
      "position": 3,
      "text": "Warm chocolate-hazelnut spread in the microwave at 360 W until warm but not bubbling, about 1 minute. Stir and check consistency. Microwave for an additional 30 seconds if necessary."
    },
    {
      "position": 4,
      "text": "Pour 1/2 of the cake batter into the prepared loaf pan. Pour in 2/3 of chocolate-hazelnut spread in a swirl over the batter. Pour in remaining batter and swirl remaining spread over the top. Use a bamboo skewer to create more swirls by running the skewer through the batter in a circular motion. Take care not to stir the mixture, but simply create a marbled design."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 minutes. Allow to cool before removing from the pan."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

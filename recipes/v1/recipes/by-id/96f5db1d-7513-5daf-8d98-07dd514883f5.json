  "id": "96f5db1d-7513-5daf-8d98-07dd514883f5",
  "slug": "old-fashioned-pineapple-upside-down-cake",
  "name": "Old Fashioned Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This upside-down pineapple cake is made with an easy homemade cake baked in a skillet with pineapple, cherries, and brown sugar until caramelized.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1/2 cup butter over very low heat in a 10-inch heavy skillet with a heat-resistant handle or a cast iron pan. Remove from heat; sprinkle brown sugar evenly into the skillet. Arrange pineapple slices to cover the bottom of the skillet. Distribute cherries around pineapples; set aside."
    },
    {
      "position": 3,
      "text": "Sift together flour, baking powder, and salt in a bowl; set aside."
    },
    {
      "position": 4,
      "text": "Separate eggs; place whites in a large mixing bowl and yolks in a smaller bowl."
    },
    {
      "position": 5,
      "text": "Beat egg whites on medium speed until soft peaks form. Add white sugar gradually, beating well after each addition. Beat until medium-stiff peaks form."
    },
    {
      "position": 6,
      "text": "Beat egg yolks at high speed until very thick and yellow. Using a wire whisk or rubber scraper, gently fold egg yolks and flour mixture into whites with an over-and-under motion until blended."
    },
    {
      "position": 7,
      "text": "Fold 1 tablespoon melted butter and almond extract into batter, then spread batter evenly over pineapple in the skillet."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes. Loosen cake edges with a table knife. Cool cake for 5 minutes before inverting it onto a serving plate."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

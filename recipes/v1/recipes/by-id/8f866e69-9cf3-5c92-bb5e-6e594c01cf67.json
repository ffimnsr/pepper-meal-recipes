  "slug": "easy-chili",
  "name": "Granny's Easy Chili",
  "recipe_type": "soup",
  "brief_description": "This delicious recipe is a snap to make and tastes delicious! It's vegan and vegetarian, too.",
  "cuisine": "American Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "In a large saucepan saute onion, garlic, celery and olive oil until onions are soft."
    },
    {
      "position": 2,
      "text": "Add to saucepan textured vegetable protein, chili beans, tomatoes, water, sugar, salt and pepper, and chili powder. Stir occasionally, let simmer for 30 minutes. The textured vegetable protein will expand when added to liquid."
    }
  ],
  "servings": 8,

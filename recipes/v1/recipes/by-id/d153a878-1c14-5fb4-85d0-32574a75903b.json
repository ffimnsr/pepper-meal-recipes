  "schema_version": 1,
  "id": "d153a878-1c14-5fb4-85d0-32574a75903b",
  "slug": "crispy-oven-beef-and-bean-tostadas",
  "name": "Crispy Oven Beef-and-Bean Tostadas",
  "recipe_type": "main",
  "brief_description": "Bake corn tortillas to get crispy tostadas in this recipe for a homemade version of a Mexican favorite topped with seasoned ground beef and refried beans.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix garlic salt, onion powder, garlic powder, cumin, and black pepper together in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef, onion, and garlic in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Keep warm while preparing tostada shells."
    },
    {
      "position": 4,
      "text": "Brush oil over both sides of tortillas and arrange on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake tortillas in preheated oven until crisped on top, about 5 minutes. Flip tortillas and continue baking until other side crisps, 2 to 3 minutes more."
    },
    {
      "position": 6,
      "text": "Heat refried beans in a saucepan over medium-low, stirring regularly until hot, about 5 minutes (see Cook's Note)."
    },
    {
      "position": 7,
      "text": "Divide refried beans between tostadas and spread over one side of each; spoon ground beef mixture over the beans. Top each tostada with lettuce, Cheddar cheese, and diced tomato."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "73e5abb8-c03b-5aab-8d49-b06191c1635e",
  "slug": "creamy-parmesan-beans-recipe-11945088",
  "name": "Creamy Parmesan Beans",
  "recipe_type": "side",
  "brief_description": "These creamy Parmesan beans are a rich skillet side dish that is easily made in 15 minutes and is delicious paired with pork chops, steak, or chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add garlic and cook 1 minute."
    },
    {
      "position": 2,
      "text": "Add beans, water, paprika, cumin, cayenne, tomatoes, salt, and pepper. Cook for 7 minutes, stirring frequently."
    },
    {
      "position": 3,
      "text": "Stir in lemon juice, Parmesan cheese, and parsley. Cook until cheese is melted, about 2 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

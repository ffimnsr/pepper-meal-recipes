  "schema_version": 1,
  "id": "5440abc0-18ea-51c6-926e-a16bbbfa3a9a",
  "slug": "baked-buttermilk-donuts",
  "name": "Baked Buttermilk Donuts",
  "recipe_type": "breakfast",
  "brief_description": "Crispy on the outside and light and airy on the inside, this recipe for baked buttermilk donuts makes an easy treat you can toss in confectioners' sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) with an oven rack in the upper-middle position. Coat a donut pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Sift flour, white sugar, cornstarch, baking powder, nutmeg, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk buttermilk, eggs, baking soda, and vanilla extract together in a separate bowl."
    },
    {
      "position": 4,
      "text": "Pour melted and cooled shortening into flour mixture; stir until absorbed. Stir in buttermilk mixture; mix well. Let batter rest 10 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Pour batter by scant 1 tablespoonfuls into wells of each prepared donut cup. Distribute batter evenly across bottoms of each cup using the back of a spoon; you won't use all of the batter in this batch."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven on the upper-middle rack until golden brown, 12 to 15 minutes. Cool in the pan for 2 to 3 minutes before transferring donuts to a wire rack."
    },
    {
      "position": 7,
      "text": "Place confectioners' sugar in a small paper bag; add donuts and toss to coat."
    },
    {
      "position": 8,
      "text": "Coat the donut pan with cooking spray. Repeat process with remaining batter and confectioners' sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

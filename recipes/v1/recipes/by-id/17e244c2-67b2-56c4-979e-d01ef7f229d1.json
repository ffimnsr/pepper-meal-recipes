  "schema_version": 1,
  "id": "17e244c2-67b2-56c4-979e-d01ef7f229d1",
  "slug": "air-fryer-shrimp-fajitas",
  "name": "Air Fryer Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "Shrimp fajitas are really easy to make at home in an air fryer. Serve on flour tortillas with your favorite toppings!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place shrimp into a bowl and sprinkle 2 teaspoons fajita seasoning over top. Drizzle with 1 tablespoon oil and toss to combine."
    },
    {
      "position": 3,
      "text": "Place bell pepper and onion strips into a second bowl and sprinkle remaining seasoning over top. Drizzle with remaining 2 tablespoons oil and stir to combine."
    },
    {
      "position": 4,
      "text": "Place vegetables in the basket of the preheated air fryer and cook for 12 minutes, shaking halfway through the cook time. Transfer mixture to a large bowl."
    },
    {
      "position": 5,
      "text": "Place shrimp in the basket of the air fryer and cook for 5 minutes. Flip and cook for 3 minutes more."
    },
    {
      "position": 6,
      "text": "Divide vegetables among tortillas and top with shrimp."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

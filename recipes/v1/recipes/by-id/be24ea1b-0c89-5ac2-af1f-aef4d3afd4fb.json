  "id": "be24ea1b-0c89-5ac2-af1f-aef4d3afd4fb",
  "slug": "chocolate-frosting-i",
  "name": "Chocolate Frosting with Cocoa Powder",
  "recipe_type": "dessert",
  "brief_description": "This chocolate frosting with cocoa powder is made with no butter and just 5 ingredients for a super smooth, creamy icing great on cake and cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat together cocoa and melted margarine in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Add milk and vanilla; beat until smooth."
    },
    {
      "position": 4,
      "text": "Gradually beat in confectioners' sugar until desired consistency is achieved. Adjust with more milk or confectioners' sugar if necessary."
    }
  ],
  "servings": 12,

  "id": "1ed0f149-c973-5b5e-8406-178aec4baed5",
  "slug": "hot-honey-baked-beans-recipe-11704100",
  "name": "Hot Honey Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "Hot honey baked beans are a fun twist on classic baked beans adding sweet and spicy flavors to a classic dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Cook bacon and onion in a 10-inch skillet until onion is tender and bacon is crisp, 6 to 8 minutes. Add garlic and cook until fragrant, 1 minute more."
    },
    {
      "position": 3,
      "text": "Transfer mixture to a large bowl. Add beans, honey, ketchup, mustard, Worcestershire sauce, cayenne pepper sauce, crushed red pepper, and black pepper; stir to combine."
    },
    {
      "position": 4,
      "text": "Pour mixture into the prepared baking dish; cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil and continue baking until mixture is hot and sauce is thickened and bubbly, about 30 minutes longer ."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

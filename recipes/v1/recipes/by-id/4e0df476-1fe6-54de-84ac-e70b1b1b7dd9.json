  "id": "4e0df476-1fe6-54de-84ac-e70b1b1b7dd9",
  "slug": "chicken-nachos",
  "name": "Chicken Nachos",
  "recipe_type": "appetizer",
  "brief_description": "This simple chicken nachos recipe is made with layers of tortilla chips, green chiles, and cheese. Serve them with guacamole, sour cream, and salsa.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, vegetable oil, and cayenne pepper in a bowl; let stand at least 15 minutes, or longer if desired."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat a skillet over medium-high heat. Add chicken mixture; cook until no longer pink. Remove from heat; set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, spread a thin layer of tortilla chips in a 9x13-inch baking dish; top with 1/4 chicken, 1/4 chiles, and 1/4 cheese. Repeat layers three more times ending with cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese melts and nachos heated through, 15 to 20 minutes. Serve with your favorite nacho toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "dff9eb44-7b38-51ea-a8f3-48640f46bee4",
  "slug": "turkey-stuffed-peppers",
  "name": "Turkey-Stuffed Peppers",
  "recipe_type": null,
  "brief_description": "A cheesy roux sauce elevates this stuffed pepper dish made with ground turkey and panko bread crumbs.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 1-quart baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large saucepan of water to a boil. Cook peppers in boiling water until slightly tender, about 3 minutes; drain and rinse with cold water until cooled."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium heat. Cook ground turkey, onions, mushrooms, and garlic in the hot oil until turkey is completely browned; drain grease from the turkey mixture. Transfer drained turkey mixture to a bowl and return skillet to medium heat."
    },
    {
      "position": 4,
      "text": "Melt butter in the skillet; add flour, salt, and black pepper. Stir until smooth. Stream milk and half-and-half into the flour mixture while stirring; bring to a boil. Cook and stir the milk mixture until thickened, 1 to 2 minutes. Return turkey mixture to the skillet; add tomatoes and 2 tablespoons Cheddar cheese. Cook and stir the turkey mixture until hot and the cheese is melted, about 3 minutes; spoon into the bell pepper halves. Arrange stuffed pepper halves into the prepared baking dish; top with remaining Cheddar cheese, Parmesan cheese, and panko. Cover dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until the peppers are tender and the filling is hot, 25 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Switch oven to broil, remove foil, and cook peppers under the broiler until the panko is browned, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

  "id": "8c508e17-5b52-5d94-b8d1-eb76ce048dd4",
  "slug": "hawaiian-hush-puppies",
  "name": "Hawaiian Hush Puppies",
  "recipe_type": "appetizer",
  "brief_description": "Slightly sweet from cream-style corn and crushed pineapple, these tropical hush puppies pair perfectly with fish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep fryer or large saucepan to 365 degrees F (185 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix canned corn, pineapple, cornmeal, flour, Cheddar cheese, onion, sugar, eggs, salt, and pepper together in a large bowl."
    },
    {
      "position": 3,
      "text": "Drop as many teaspoonfuls of batter into the hot oil that the pan will allow; cook until golden brown or until they float to the top, about 5 minutes. Drain on a paper towel-lined plate. Repeat with any remaining batter."
    }
  ],
  "servings": 50,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

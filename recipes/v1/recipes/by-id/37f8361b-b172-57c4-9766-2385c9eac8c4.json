  "id": "37f8361b-b172-57c4-9766-2385c9eac8c4",
  "slug": "sweet-potato-carrot-apple-and-red-lentil-soup",
  "name": "Sweet Potato, Carrot, Apple, and Red Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This carrot, apple, sweet potato, and lentil soup seasoned with ginger, cumin, and chili powder is full of flavor \u2014 it warms you up on a cold winter day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large, heavy-bottomed pot over medium-high heat. Add sweet potatoes, carrots, apple, and onion; cook and stir until onion is translucent, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in lentils, salt, ginger, pepper, cumin, chili powder, and paprika, then pour in broth. Increase the heat to high and bring to a boil. Reduce the heat to medium-low, cover, and simmer until lentils and vegetables are soft, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Pur\u00e9e soup in the pot with an immersion blender until smooth. Increase the heat to medium-high and cook until simmering, about 10 minutes. Add water as needed to thin the soup to your preferred consistency."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

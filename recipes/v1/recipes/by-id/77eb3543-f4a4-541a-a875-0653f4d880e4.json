  "id": "77eb3543-f4a4-541a-a875-0653f4d880e4",
  "slug": "passover-soup-with-chicken-dumplings",
  "name": "Passover Soup with Chicken Dumplings",
  "recipe_type": "soup",
  "brief_description": "Simple and satisfying, a hot bowl of chicken broth becomes a hearty meal when served with easy-to-make chicken meatballs.",
  "cuisine": "World American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a rolling boil. Place 8 eggs in the boiling water; let the eggs boil for one minute, then remove the pan from the heat. Let the eggs sit for 15 minutes before removing them from the pot. Let them cool, remove the shells, the white portion of the eggs (save or discard the white), and chop the yolks."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix ground chicken, beaten egg, matzo meal, salt and pepper to taste, and cinnamon. Form mixture into walnut-sized balls and refrigerate until ready to cook."
    },
    {
      "position": 3,
      "text": "In a large saucepan over high heat, bring chicken broth to a boil. Add rice and chicken meatballs, cover, and lower heat to medium low; simmer for 20 minutes or until the rice and chicken are cooked."
    },
    {
      "position": 4,
      "text": "Ladle into soup bowls and garnish with hard-boiled egg; serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "927a0e41-8c0b-5bc8-882e-576eb7e9426b",
  "slug": "lebanese-restaurant-rice-pilaf",
  "name": "Lebanese Restaurant Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "This Lebanese-inspired rice pilaf with toasted almonds and tahini has plenty of butter and oil, creating a hearty and delicious side dish to chicken and hummus.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large bowl with water. Add rice and let soak for 10 minutes; drain and rinse until water runs clear."
    },
    {
      "position": 2,
      "text": "Heat 1/4 cup butter and 2 tablespoons olive oil in a skillet over medium heat; cook and stir orzo in hot butter-oil mixture until lightly browned, about 5 minutes. Add drained rice and increase heat to medium-high. Cook and stir orzo-rice mixture until rice is coated in butter-oil mixture and starts to turn translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour 4 cups water over rice mixture and add salt; stir and bring to a boil. Cover the skillet, reduce heat to low, and simmer until rice is fluffy and tender yet firm, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat remaining 2 tablespoons olive oil in a separate skillet over medium heat; cook and stir almonds until toasted and fragrant, about 5 minutes. Stir in remaining 1/4 cup butter and tahini until almonds are evenly coated."
    },
    {
      "position": 5,
      "text": "Mix almond mixture into rice mixture."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

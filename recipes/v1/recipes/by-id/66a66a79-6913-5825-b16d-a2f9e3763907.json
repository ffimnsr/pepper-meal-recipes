  "id": "66a66a79-6913-5825-b16d-a2f9e3763907",
  "slug": "cabbage-and-gnocchi",
  "name": "Cabbage and Gnocchi",
  "recipe_type": "side",
  "brief_description": "Haluski, a popular budget-friendly Polish dish, combines cabbage and pasta; this recipe uses gnocchi and is a quick and easy weeknight meal.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter and olive oil in a Dutch oven over medium-high heat. Add onion; saute until softened, about 5 minutes. Stir in cabbage, garlic, and red pepper flakes. Season with salt and pepper. Cook and stir until cabbage is translucent but still crunchy, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Toss cooked gnocchi into the cabbage until combined. Sprinkle Parmesan cheese on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

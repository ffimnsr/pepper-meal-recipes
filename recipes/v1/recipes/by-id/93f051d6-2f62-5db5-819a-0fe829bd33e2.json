  "id": "93f051d6-2f62-5db5-819a-0fe829bd33e2",
  "slug": "quick-pickled-radishes",
  "name": "Quick Pickled Radishes",
  "recipe_type": "salad",
  "brief_description": "This pickled radish recipe is easy to make in minutes for a flavorsome topping on salads, noodle bowls, tacos, sandwiches, and so much more!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place radish slices into a pint-sized jar with a lid."
    },
    {
      "position": 2,
      "text": "Heat vinegar and water in a small non-reactive saucepan over medium heat; whisk in sugar and salt until just dissolved. Remove from heat and add star anise pod, cumin seed, and black peppercorns. Let cool slightly for 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Pour liquid over radishes. Cover and let cool to room temperature, then refrigerate."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "b9f5f5a6-10be-587e-b674-2da2bbb72ee8",
  "slug": "caramel-apple-pie-cookies-recipe-7642173",
  "name": "Caramel Apple Pie Cookies",
  "recipe_type": "dessert",
  "brief_description": "These caramel apple pie cookies taste like mini apple pies. Try them warmed up with ice cream and you'll be reminded ot Thanksgiving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 425 degrees F (220 degrees C). Let pie crusts stand according to package directions. Line 2 baking sheets with parchment paper; set aside."
    },
    {
      "position": 2,
      "text": "Transfer apple pie filling into a food processor. Lightly pulse apple pie filling in a food processor until in 1/4-inch chunks (see Cook's Note)."
    },
    {
      "position": 3,
      "text": "Roll one pie crust into a 14-inch circle on a lightly floured piece of parchment paper."
    },
    {
      "position": 4,
      "text": "Using a pizza cutter or a sharp knife, cut 1/4-inch wide strips."
    },
    {
      "position": 5,
      "text": "Cover cut pie dough with parchment paper or plastic wrap and set aside."
    },
    {
      "position": 6,
      "text": "Roll remaining pie crust dough into a 13-inch circle on lightly floured piece of parchment paper."
    },
    {
      "position": 7,
      "text": "Spread caramel sauce over rolled pastry."
    },
    {
      "position": 8,
      "text": "Spoon apple pie filling over caramel sauce, spreading so that it is evenly distributed."
    },
    {
      "position": 9,
      "text": "Create a lattice top with dough strips by alternately placing strips on top of the filling."
    },
    {
      "position": 10,
      "text": "Using a 2 1/2-inch diameter cookie cutter, cut rounds from pastry."
    },
    {
      "position": 11,
      "text": "Transfer cookies to the prepared baking sheets."
    },
    {
      "position": 12,
      "text": "Stir together sugar and apple pie spice in a small bowl."
    },
    {
      "position": 13,
      "text": "Brush cookies with half and half and sprinkle cookies with sugar and spice mixture."
    },
    {
      "position": 14,
      "text": "Bake in the preheated oven until cookies are golden brown, about 12 minutes (working in batches)."
    },
    {
      "position": 15,
      "text": "Cool on baking sheets on wire racks for 20 minutes. Remove cookies to a serving tray and serve warm."
    }
  ],

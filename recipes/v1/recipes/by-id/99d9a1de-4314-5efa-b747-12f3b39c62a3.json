  "id": "99d9a1de-4314-5efa-b747-12f3b39c62a3",
  "slug": "key-lime-pie-iv",
  "name": "Key Lime Pie IV",
  "recipe_type": "dessert",
  "brief_description": "This easy-to-make and refreshing key lime pie has only three ingredients: lime juice, lemon juice and sweetened condensed milk. When the juices are added to the milk everything thickens. This lovely filling is poured into a prepared crust and chilled.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, lime juice, lemon juice, and food coloring. This mixture will thicken."
    },
    {
      "position": 2,
      "text": "Whip the cream until stiff. Fold into lime mixture. Pour into pie shell. Chill."
    }
  ],

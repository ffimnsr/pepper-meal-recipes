  "id": "385ddbc3-050e-5288-8e47-b38afe1ff3a0",
  "slug": "oat-free-and-gluten-free-granola-bars-clean-eating",
  "name": "Oat-Free and Gluten-Free Granola Bars (Clean Eating)",
  "recipe_type": "appetizer",
  "brief_description": "These gluten-free granola bars combine your choice of nuts and seeds with apricots and coconut and are an excellent choice for clean eating.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place 3/4 cups almonds and 3/4 cups sunflower seeds into a food processor; chop until nuts are in 1/4-inch pieces, 1 to 2 minutes. Remove from food processor and pour in a bowl. Place remaining almonds and sunflower seeds into the food processor; roughly chop into larger pieces, about 1 minute. Mix remaining nuts, seeds, shredded coconut, and dried apricot into the 1/4-inch nuts until fruit-and-nut mixture is combined."
    },
    {
      "position": 2,
      "text": "Combine coconut oil, honey, ground cinnamon, vanilla extract, and salt in a saucepan over medium-low heat; cook until the coconut oil mixture bubbles and turns a lighter color, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour coconut oil mixture over fruit and nut mixture; stir until granola mixture takes on the consistency of wet sand, about 1 minute."
    },
    {
      "position": 4,
      "text": "Line a baking sheet with waxed paper. Pour granola mixture onto sheet; place a second sheet of waxed paper on top of granola mixture. Push down on the waxed paper with your hands until granola mixture has been evenly spread. Pack very tightly so bars will not fall apart."
    },
    {
      "position": 5,
      "text": "Let cool until granola has hardened, 2 to 3 hours. Cut into bars."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 10,

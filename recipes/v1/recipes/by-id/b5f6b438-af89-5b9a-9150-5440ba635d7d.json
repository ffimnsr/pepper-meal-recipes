  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b5f6b438-af89-5b9a-9150-5440ba635d7d",
  "slug": "broccoli-and-cheese-rice-casserole-with-garlic-pretzel-topping-recipe-8775000",
  "name": "Broccoli and Cheese Rice Casserole With Garlic Pretzel Topping",
  "recipe_type": "side",
  "brief_description": "Try this delicious broccoli and cheese rice casserole topped with crushed garlic pretzels for a comfort dish you'll sure be making over and over again.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes. Set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add broccoli, cover, and steam until slightly tender, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (180 degrees F) and grease a 9 x 13 baking dish."
    },
    {
      "position": 4,
      "text": "Melt butter in a large skillet over medium heat. Add diced onion and cook until soft and translucent, 3 to 4 minutes. Add the garlic and cook for another 30 seconds."
    },
    {
      "position": 5,
      "text": "Stir in cream of mushroom soup, sour cream, and milk. Mix until smooth."
    },
    {
      "position": 6,
      "text": "Add 2 cups of shredded Cheddar cheese, salt, pepper, and paprika. Stir in the cheese until it\u2019s melted and the mixture is mostly smooth."
    },
    {
      "position": 7,
      "text": "In a large mixing bowl, combine the cooked rice, steamed broccoli, and cheese mixture. Stir until well combined."
    },
    {
      "position": 8,
      "text": "Transfer the mixture to the prepared baking dish and spread evenly."
    },
    {
      "position": 9,
      "text": "Mix crushed garlic Parmesan pretzels, melted butter, and grated Parmesan cheese in a bowl until combined. Sprinkle topping evenly over the casserole."
    },
    {
      "position": 10,
      "text": "Bake uncovered for 25 minutes until pretzel topping is golden brown. Add remaining cup of cheese and bake until cheese is melted, 3 to 5 minutes."
    },
    {
      "position": 11,
      "text": "Allow casserole to cool for a few minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

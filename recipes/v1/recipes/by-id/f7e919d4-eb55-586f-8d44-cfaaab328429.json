  "slug": "protein-powder-overnight-oats-with-blueberries-and-peanut-butter",
  "name": "Protein Powder Overnight Oats with Blueberries and Peanut Butter",
  "recipe_type": "dessert",
  "brief_description": "Protein powder, blueberries, and peanut butter are combined in these overnight oats for a filling sweet breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix almond milk, oats, peanut butter, chia seeds, agave, and protein powder in a bowl until well combined. Divide mixture between 2 Mason jars. Top each jar with 1/2 cup blueberries. Refrigerate for 8 hours, or overnight."
    }
  ],
  "servings": 2,

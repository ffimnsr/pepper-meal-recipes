{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9b688e90-c04f-5b26-9a67-af633df3d657",
  "slug": "creme-brulee",
  "name": "Cr\u00e8me Br\u00fbl\u00e9e",
  "recipe_type": "dessert",
  "brief_description": "Cr\u00e8me br\u00fbl\u00e9e is a smooth and creamy chilled custard topped with a layer of hardened caramelized brown sugar for a decadent dessert that's sure to impress!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks, 4 tablespoons white sugar, and vanilla extract in a mixing bowl until thick and creamy; set aside."
    },
    {
      "position": 3,
      "text": "Pour cream into a saucepan and stir over low heat until it almost comes to a boil."
    },
    {
      "position": 4,
      "text": "Whisk cream into egg yolk mixture; beat until combined."
    },
    {
      "position": 5,
      "text": "Pour mixture into the top pan of a double boiler. Stir over simmering water until mixture lightly coats the back of a spoon, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Pour into a shallow heat-proof dish or individual ramekins."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until custard is set but still slightly jiggly, about 30 minutes. Let cool to room temperature, then refrigerate until chilled, at least 1 hour or overnight."
    },
    {
      "position": 8,
      "text": "Turn the oven to broil."
    },
    {
      "position": 9,
      "text": "Combine remaining 2 tablespoons white sugar and brown sugar in a small bowl. Sprinkle mixture evenly over custard."
    },
    {
      "position": 10,
      "text": "Place dish under the broiler until sugar melts and caramelizes, about 2 minutes. Watch carefully so as not to burn."
    },
    {
      "position": 11,
      "text": "Allow to cool slightly, then refrigerate until custard is set again, about 10 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "984fabea-8e25-5e69-9e3f-37bdd8a655bd",
  "slug": "shortcut-cherry-danish-recipe-11729528",
  "name": "Shortcut Cherry Danish",
  "recipe_type": "dessert",
  "brief_description": "This shortcut cherry Danish is simple to make with refrigerated crescent dough sheets. Filled with a dollop each of sweetened, whipped cream cheese and cherry pie filling, and glazed after baking, they're delicious without being time-consuming.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Without unrolling, slice crescent dough sheet into 10 equal portions. Place crescent dough rounds onto the prepared baking sheet. Press the back of a tablespoon into the center of each roll to make an indentation."
    },
    {
      "position": 3,
      "text": "For filling, add cream cheese, white sugar, and 1 teaspoon vanilla to a bowl, and beat with an electric mixer until smooth. Dollop filling into the indentations in the rolls."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 8 minutes."
    },
    {
      "position": 5,
      "text": "Remove Danishes from the oven. Add a spoonful of cherry pie filling containing 4 or 5 cherries into each Danish."
    },
    {
      "position": 6,
      "text": "Return to the oven; bake until golden, about 9 minutes more."
    },
    {
      "position": 7,
      "text": "To glaze, whisk confectioner\u2019s sugar, remaining 1/2 teaspoon vanilla, and enough milk together to form a pourable glaze; drizzle over cherry-topped Danishes while still warm and enjoy."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

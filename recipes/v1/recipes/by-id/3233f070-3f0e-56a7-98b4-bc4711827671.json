  "id": "3233f070-3f0e-56a7-98b4-bc4711827671",
  "slug": "sloppy-joe-smash-burgers-recipe-8653695",
  "name": "Sloppy Joe Smash Burgers",
  "recipe_type": "main",
  "brief_description": "This Sloppy Joe smash burger is what you get when you combine a Sloppy Joe and a smash burger, a rich indulgence that is as sinful as it is sloppy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a griddle or large skillet over medium high heat. Add oil, onion, and bell pepper; season with garlic powder and cook, stirring constantly, until softened and browned around the edges, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Arrange onion mixture into 4 mounds. Divide beef into 4 portions and place each portion over a mound of peppers and onions. Using a flat spatula, press down firmly on each section to form thin patties. Season evenly with salt and pepper and cook, undisturbed, until browned on the bottom and around the edges, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Flip burgers and top each with 2 tablespoons of Sloppy Joe sauce. Place cheese slices over two of the burgers and top with remaining 2 burgers."
    },
    {
      "position": 4,
      "text": "Toast each bun in pan drippings and add stacked burgers to buns. Serve with more sauce if desired."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

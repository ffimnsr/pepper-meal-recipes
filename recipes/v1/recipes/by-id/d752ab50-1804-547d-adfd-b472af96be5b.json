  "id": "d752ab50-1804-547d-adfd-b472af96be5b",
  "slug": "pot-roast-vegetables-and-beer",
  "name": "Pot Roast, Vegetables, and Beer",
  "recipe_type": "main",
  "brief_description": "A beef pot roast is braised in dark beer with vegetables, garlic, mustard, and thyme until fall-apart tender. Easy to prep yet packed with flavor!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a Dutch oven. Brown pot roast on all sides in hot oil; remove from pan and set aside."
    },
    {
      "position": 3,
      "text": "Stir onion and garlic into hot oil and cook until onions are just softened and golden brown, about 5 minutes. Add carrots, mushrooms, and potatoes to the pot; cook and stir until they begin to color, 2 to 3 minutes. Mix flour into vegetables; stir continuously for 1 minute. Add beef stock and beer; bring to a boil, stirring continuously. Stir in bay leaf, thyme, brown sugar, mustard, tomato paste, salt, and pepper; place pot roast back in the pot and cover with a lid."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until beef and vegetables are completely tender, about 2 1/2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 170,
  "preparation_time_minutes": 20,

  "id": "4b92e048-72e5-51fc-9739-a25278139196",
  "slug": "jab-chae-korean-noodles",
  "name": "Jab Chae (Korean Noodles)",
  "recipe_type": "dessert",
  "brief_description": "Sweet potato vermicelli noodles are tossed with stir-fried beef and vegetables in this simple jab chae, a Korean noodle dish.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a pot; add vermicelli noodles. Cook noodles until clear and soft, 10 to 12 minutes. Drain noodles in a colander; let sit for 10 minutes. Rinse noodles with cold water. Cut the noodles 2 to 3 times."
    },
    {
      "position": 2,
      "text": "Heat 1 teaspoon oil in a skillet over medium-high heat; saute beef, garlic, salt, and pepper until beef is cooked through, 3 to 4 minutes. Transfer beef to a large bowl."
    },
    {
      "position": 3,
      "text": "Heat 1 teaspoon oil in the same skillet; saute onion, salt, and pepper until slightly tender, 2 to 3 minutes. Add onion to beef. Heat 1 teaspoon oil in the same skillet; saute carrot, salt, and pepper until slightly tender, 2 to 3 minutes. Add carrot to beef mixture. Heat 1 teaspoon oil in the same skillet; saute spring onions, salt, and pepper until slightly tender, about 1 minute. Add spring onions to beef mixture."
    },
    {
      "position": 4,
      "text": "Mix noodles with beef mixture."
    },
    {
      "position": 5,
      "text": "Whisk soy sauce, sugar, sesame seeds, and sesame oil together in a bowl; pour over noodle mixture and mix well."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

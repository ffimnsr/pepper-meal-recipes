  "id": "69606fda-c55a-596a-aaea-b997aad32f58",
  "slug": "classic-pickled-eggs",
  "name": "Classic Pickled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These pickled eggs, made with hard-boiled eggs in a sweet and tangy vinegar brine flavored with salt, sugar, and garlic, are a tasty snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel. Discard hot water."
    },
    {
      "position": 3,
      "text": "Bring vinegar, sugar, and salt to a boil in the same saucepan until sugar is dissolved. Remove from heat."
    },
    {
      "position": 4,
      "text": "Place peeled eggs, garlic, and bay leaf in a 1-quart mason jar; top with vinegar mixture. Seal the jar and refrigerate for at least 1 week before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

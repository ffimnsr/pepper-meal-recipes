  "id": "ffbfa4c0-a56f-5340-862f-8bc8b3c7a26d",
  "slug": "instant-pot-ribs-from-frozen",
  "name": "Instant Pot Ribs from Frozen",
  "recipe_type": "side",
  "brief_description": "This frozen ribs Instant Pot dinner is quickly made with hickory smoke seasoned baby back ribs cooked until tender, then broiled with barbecue sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water into a multi-functional pressure cooker (such as Instant Pot). Set the trivet inside."
    },
    {
      "position": 2,
      "text": "Sprinkle hickory smoke seasoning liberally over frozen ribs; set ribs on top of the trivet. Close and lock the lid."
    },
    {
      "position": 3,
      "text": "Select high pressure according to manufacturer's instructions; set the timer for 45 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Preheat the oven broiler. Set an oven rack about 6 inches from the heat source."
    },
    {
      "position": 6,
      "text": "Transfer ribs to a rimmed baking sheet. Brush with barbecue sauce. Broil until glazed, 4 to 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,

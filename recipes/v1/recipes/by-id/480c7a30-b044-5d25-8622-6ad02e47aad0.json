  "id": "480c7a30-b044-5d25-8622-6ad02e47aad0",
  "slug": "easy-blueberry-cobbler",
  "name": "Easy Blueberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This blueberry cobbler recipe makes a crowd-pleasing summer dessert with just 5 easy ingredients: butter, flour, sugar, milk, and fresh blueberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place butter in an 8-inch, square baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in the preheating oven, about 5 minutes. Remove from oven."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix flour, sugar, and milk in a bowl until combined; pour batter over melted butter in the baking dish. Scatter blueberries over batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

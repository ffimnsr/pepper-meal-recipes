  "id": "fc328f8f-7619-52e7-aa60-7fcfce1f1ee4",
  "slug": "easy-cranberry-applesauce",
  "name": "Easy Cranberry Applesauce",
  "recipe_type": "side",
  "brief_description": "This bright pink cranberry applesauce is simple enough for a weeknight supper and festive enough for special occasions.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir apples, cranberries, sugar, water, cinnamon, and salt together in a saucepan. Bring to a boil, reduce heat to low, and cook until apples and cranberries are tender, about 20 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Stir lemon juice into cranberry mixture."
    },
    {
      "position": 3,
      "text": "Mash cranberry mixture with a wooden spoon or fork to make a chunky sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,

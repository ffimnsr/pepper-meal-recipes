  "schema_version": 1,
  "id": "06afad23-658f-517c-a3d0-7d13341affa9",
  "slug": "canned-green-beans-with-bacon-and-garlic-recipe-11928402",
  "name": "Canned Green Beans with Bacon and Garlic",
  "recipe_type": "soup",
  "brief_description": "This green beans with bacon and garlic recipe shows you how, with just a couple of steps, to turn canned green beans into a side dish you\u2019ll be proud to serve. Seasoned with fresh thyme sprigs and warmed in chicken broth, they are so flavorful.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain and rinse beans in a colander and set aside, to remove as much water as possible."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large, nonstick skillet over medium heat until crispy, about 5 minutes. Remove from the skillet and drain on paper towels."
    },
    {
      "position": 3,
      "text": "To the same skillet, add onion and thyme and cook, until onions begin to turn translucent, 3 to 5 minutes. Add garlic and cook, stirring, until fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Add chicken broth, increase heat to medium-high, and bring to a boil."
    },
    {
      "position": 5,
      "text": "Stir in drained green beans and cook, tossing beans in the liquid frequently until most of the liquid has evaporated, about 5 minutes. Remove thyme sprigs. Season to taste with salt and black pepper."
    },
    {
      "position": 6,
      "text": "Pour beans into a serving dish, crumble bacon over beans, and serve warm. Garnish with fresh thyme sprigs, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

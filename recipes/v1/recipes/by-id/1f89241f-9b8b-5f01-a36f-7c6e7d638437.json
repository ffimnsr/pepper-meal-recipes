  "id": "1f89241f-9b8b-5f01-a36f-7c6e7d638437",
  "slug": "polish-stuffed-cabbage",
  "name": "Polish Stuffed Cabbage",
  "recipe_type": "drink",
  "brief_description": "Boiled cabbage leaves are filled with a mixture of ground beef, egg, and cooked rice. These are simmered for about an hour with tomato juice, vinegar, sugar, and water.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Place the head of cabbage in a large pot over high heat and add water to cover. Boil cabbage for 15 minutes, or until it is pliable and soft. Drain and allow to cool completely."
    },
    {
      "position": 2,
      "text": "Remove the hard outer vein from the leaves."
    },
    {
      "position": 3,
      "text": "In a separate large bowl, combine the beef, rice, garlic powder and the egg, mixing well."
    },
    {
      "position": 4,
      "text": "Place a small amount, about the size of your palm, into the center of a cabbage leaf."
    },
    {
      "position": 5,
      "text": "Fold leaf over, tucking in the sides of the leaf to keep meat mixture inside."
    },
    {
      "position": 6,
      "text": "Pile up the filled leaves in a large pot, putting the larger leaves on the bottom. Add the tomato juice, vinegar and sugar and enough water to cover. Simmer over medium low heat for about 60 minutes. (Note: Keep an eye on them, making sure the bottom of leaves do not burn.)"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

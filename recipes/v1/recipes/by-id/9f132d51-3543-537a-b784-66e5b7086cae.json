  "id": "9f132d51-3543-537a-b784-66e5b7086cae",
  "slug": "roasted-acorn-squash-soup",
  "name": "Roasted Acorn Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This roasted acorn squash soup makes a creamy soup that's fortified with onions, carrots, butter, half-and-half, and warm spices that scream fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange squash, cut-side down, in a baking dish; add enough water to cover bottom of the dish."
    },
    {
      "position": 3,
      "text": "Bake squash in the preheated oven until easily pierced with a fork, about 45 minutes. Remove from the oven; cool until easily handled. Scoop flesh into a bowl and set aside."
    },
    {
      "position": 4,
      "text": "Melt butter in a large pot over medium-high heat. Add onion, carrot, and garlic; stir until onions soften, 5 to 7 minutes. Add stock and squash; simmer for 20 minutes."
    },
    {
      "position": 5,
      "text": "Transfer mixture to a blender in batches and pur\u00e9e until smooth. Return to pot."
    },
    {
      "position": 6,
      "text": "Stir in half-and-half, nutmeg, and cinnamon; season with salt and pepper. Thin the soup with water, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "52f8e3cd-66ac-5893-9109-0d01ba59651c",
  "slug": "caprese-grilled-bread",
  "name": "Caprese Grilled Bread",
  "recipe_type": "salad",
  "brief_description": "Grilled bread topped with a caprese salad of mozzarella, tomato, and basil is a a quick and easy appetizer or side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for low heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil over baguette halves. Add minced garlic and season with salt and pepper. Layer tomato on top; season tomato with salt, pepper, dried parsley, and dried basil. Top tomato with mozzarella cheese."
    },
    {
      "position": 3,
      "text": "Place baguette halves on foil and grill until cheese starts to melt, 5 to 8 minutes. Garnish with fresh basil and parsley. Cut into slices and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

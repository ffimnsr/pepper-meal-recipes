  "id": "b498c352-2ad6-5688-a355-ca0ff57fd6a2",
  "slug": "zucchini-pie-bars",
  "name": "Zucchini Pie Bars",
  "recipe_type": "dessert",
  "brief_description": "This zucchini pie bar recipe sneaks a zucchini into sweet pie crumble bars with sugar and spices for a taste of apple pie that's perfect for a picnic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease sides of a 10x15-inch jelly roll pan."
    },
    {
      "position": 2,
      "text": "Whisk flour, 1 \u00be cups sugar, and \u00bd teaspoon cinnamon together in a large bowl; cut in butter with a fork to make a crumbly dough. Reserve \u00bd cup dough; set aside."
    },
    {
      "position": 3,
      "text": "Press remaining \u00bd dough firmly into the prepared jelly roll pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Combine \u00be cup sugar, lemon juice, \u00bd teaspoon cinnamon, and nutmeg in a large saucepan; add sliced zucchini and bring to a boil, stirring constantly, until zucchini begins to soften. Stir in reserved \u00bd cup dough; cook and stir until mixture thickens, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Spread zucchini mixture over crust; press remaining \u00bd dough lightly on top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until top is lightly browned, 35 to 45 minutes. Cool before slicing into 24 bars, about 20 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

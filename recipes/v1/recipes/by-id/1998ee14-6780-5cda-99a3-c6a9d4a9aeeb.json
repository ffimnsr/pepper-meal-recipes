  "id": "1998ee14-6780-5cda-99a3-c6a9d4a9aeeb",
  "slug": "traditional-style-vegan-shepherds-pie",
  "name": "Vegan Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This hearty vegan shepherd's pie is made with plant-based ground beef and vegan cheese substitutes for a flavorful casserole that's sure to satisfy.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes in a pot, cover with cold water, and bring to a boil over medium-high heat. Turn the heat to medium-low, and boil potatoes until tender, about 25 minutes; drain."
    },
    {
      "position": 3,
      "text": "Stir vegan mayonnaise, soy milk, olive oil, vegan cream cheese, and salt into potatoes, and mash with a potato masher until smooth and fluffy. Set mashed potatoes aside."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and spray a 2-quart baking dish with cooking spray."
    },
    {
      "position": 5,
      "text": "Heat vegetable oil in a large skillet over medium heat. Add onion, carrots, celery, frozen peas, and tomato; cook and stir until softened, about 10 minutes. Stir in Italian seasoning, garlic, and pepper."
    },
    {
      "position": 6,
      "text": "Reduce heat to medium-low and crumble plant-based ground beef into the skillet with vegetables. Cook and stir, breaking up the meat substitute, until the mixture is hot, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Spread vegetarian meat substitute mixture into the bottom of the baking dish."
    },
    {
      "position": 8,
      "text": "Top with prepared mashed potatoes, smoothing them into an even layer. Sprinkle potatoes with shredded soy cheese."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until the cheese is melted and slightly browned and the casserole is hot, about 20 minutes."
    },
    {
      "position": 10,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

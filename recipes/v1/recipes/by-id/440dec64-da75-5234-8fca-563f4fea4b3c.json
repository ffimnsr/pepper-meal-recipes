  "id": "440dec64-da75-5234-8fca-563f4fea4b3c",
  "slug": "shortcut-shepherds-pie",
  "name": "Shortcut Shepherd's Pie",
  "recipe_type": "soup",
  "brief_description": "Cream of mushroom and cream of celery soup add body to this Shepherd's Pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat a 9x13 baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Cook potatoes in boiling water until tender, about 15 minutes. Drain, reserving some of the cooking liquid. Mash potatoes with a little of the cooking liquid. Set aside."
    },
    {
      "position": 3,
      "text": "In a large skillet, cook ground beef until brown over medium-high heat. Drain fat from pan. Stir in mushrooms, mixed vegetables, mushroom soup, celery soup, and salt and pepper; heat through. Pour into prepared baking dish, cover with mashed potatoes, and dot with butter."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 30 minutes, or until potatoes are golden and beef and vegetable mixture is hot and bubbly."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

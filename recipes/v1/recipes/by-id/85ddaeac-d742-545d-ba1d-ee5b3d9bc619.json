  "id": "85ddaeac-d742-545d-ba1d-ee5b3d9bc619",
  "slug": "tangy-coleslaw-for-pulled-pork",
  "name": "Tangy Coleslaw for Pulled Pork",
  "recipe_type": "salad",
  "brief_description": "This tangy and sweet coleslaw spiced with dry mustard and celery seed makes a great topping for barbeque or pulled pork sandwiches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cabbage and red onion in a large bowl."
    },
    {
      "position": 2,
      "text": "Stir sugar, vinegar, vegetable oil, salt, dry mustard, and celery seed together in a saucepan. Bring to a boil; remove from heat."
    },
    {
      "position": 3,
      "text": "Pour sugar and vinegar mixture over the cabbage and red onion. Toss mixture. Let cool, about 10 minutes. Refrigerate for at least 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "13b25226-5061-5180-8b53-361e67f4bbf0",
  "slug": "eggplant-parmesan-bites",
  "name": "Eggplant Parmesan Bites",
  "recipe_type": "appetizer",
  "brief_description": "Breaded and baked eggplant slices are layered on pita chips with a tomato and basil leaf for a fun, bite-size appetizer you can eat while standing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sprinkle 2 teaspoons salt over eggplant rounds in colander; allow to drain at least 30 minutes. Rinse salt off the eggplant."
    },
    {
      "position": 3,
      "text": "Spread bread crumbs into a shallow bowl and beat egg in a separate bowl. Dip eggplant into egg, allowing excess egg to drip off the eggplant; press into bread crumbs until eggplant slices are evenly coated on both sides."
    },
    {
      "position": 4,
      "text": "Arrange coated eggplant on a baking sheet and drizzle with olive oil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Mix remaining 1 teaspoon salt with ricotta cheese in a bowl. Spoon ricotta cheese mixture onto each eggplant."
    },
    {
      "position": 7,
      "text": "Bake eggplant in the oven until cheese is heated through, 5 to 7 minutes."
    },
    {
      "position": 8,
      "text": "Place 1 eggplant slice onto each pita chip; top with a cherry tomato and basil leaf."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e49481c4-0102-5325-a27a-9b5c1d4e8183",
  "slug": "chef-johns-peanut-butter-cookies",
  "name": "Chef John's Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These mouthwatering peanut butter cookies from Chef John are moist, chewy, and full of delicious sweet and salty flavors that make them irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together butter, white sugar, brown sugar, peanut butter, salt, baking powder, and baking soda in a stand mixer until smooth. Scrape down the sides of the bowl and beater with a spatula. Add egg and mix for about 1 minute. Slowly mix in flour with the mixer on low speed. Scrape down the sides of the bowl and beater. Continue mixing until dough comes together, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Form dough into a ball, cover with plastic wrap, and refrigerate for 2 to 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with a silicone baking mat."
    },
    {
      "position": 4,
      "text": "Portion cookie dough into equal-sized balls and place on the prepared baking sheet. Use damp hands to roll dough into smooth balls. Stamp each ball with a fork in a criss-cross pattern."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, about 10 minutes. Let cookies sit on the baking sheet briefly before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

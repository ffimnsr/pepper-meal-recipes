  "id": "13dbf087-2090-52fe-9222-8a757b78c81c",
  "slug": "big-batch-pulled-pork-grilled-cheese-recipe-11978707",
  "name": "Big Batch Pulled Pork Grilled Cheese",
  "recipe_type": "main",
  "brief_description": "This big batch pulled pork grilled cheese is the ultimate comfort food, layered with smoky barbecue flavor and plenty of melty cheese between buttery, golden crescent dough. Easy to bake and made to feed a crowd, it brings together two classics\u2014perfect for game days, parties, and family dinners.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a large rimmed baking sheet with parchment paper and set aside."
    },
    {
      "position": 2,
      "text": "Mix together pork and barbecue sauce in a medium bowl until combined; set aside."
    },
    {
      "position": 3,
      "text": "Unroll 1 can of the dough onto prepared baking sheet. Sprinkle 3 ounces each of the Cheddar and mozzarella (about 1 1/2 cups total) over dough, leaving a 1/2-inch border around the edges. Spread pork mixture evenly over the top of the cheese, then sprinkle remaining 3 ounces each Cheddar and mozzarella (about 1 1/2 cups total) evenly over pork."
    },
    {
      "position": 4,
      "text": "Unroll remaining 1 can dough and place on top of the fillings, stretching as needed. Press edges together, using your fingertips to tightly seal dough."
    },
    {
      "position": 5,
      "text": "Whisk together Dijon, garlic powder, and 2 tablespoons of the butter in a small bowl; brush evenly over dough."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until golden brown, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, whisk together remaining 2 tablespoons butter and scallions in a small bowl. Remove grilled cheese from oven and brush immediately with scallion butter. Slice and serve with additional barbecue sauce. Recipe developed by Isabelle Easter"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

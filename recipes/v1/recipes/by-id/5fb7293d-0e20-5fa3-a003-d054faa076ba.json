  "id": "5fb7293d-0e20-5fa3-a003-d054faa076ba",
  "slug": "overnight-caramel-gingerbread-oats",
  "name": "Overnight Caramel Gingerbread Oats",
  "recipe_type": "breakfast",
  "brief_description": "Give your overnight oats a makeover for fall using a caramel-flavored protein drink and a blend of cinnamon, ginger, and pumpkin pie spice.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a small pan over medium heat. Saute pear, walnuts, and 1/4 teaspoon cinnamon until pear softens, about 5 minutes. Remove from heat and let cool."
    },
    {
      "position": 2,
      "text": "Combine protein drink and oats in a small Mason jar. Mix in cooled pear and walnuts. Seal and refrigerate, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Add pumpkin spice, ginger, and remaining cinnamon to the oats the following morning. Stir to combine."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

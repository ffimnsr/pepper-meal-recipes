  "id": "cb4e5b5a-6be4-56d9-95b7-2c95c4c232ea",
  "slug": "korean-bulgogi-bowl",
  "name": "Korean Bulgogi Bowl",
  "recipe_type": "main",
  "brief_description": "Korean bulgogi is usually made with thinly shaved slices of beef, marinated and flame licked; this recipe is made with ground beef and served as a rice bowl.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Mix in sesame oil."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, soy sauce, water, Asian pear, garlic, ginger, red pepper flakes, and black pepper in a food processor. Blend until combined but still slightly chunky. Pour mixture into the skillet with the beef and cook over medium heat until most of the liquid evaporates, 7 to 9 minutes."
    },
    {
      "position": 3,
      "text": "Place 1/4 the cooked brown rice in the bottom of an individual serving bowl. Top with a portion of beef mixture, lettuce, cucumber, red bell pepper, and sesame seeds. Repeat with remaining rice, beef, and toppings."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

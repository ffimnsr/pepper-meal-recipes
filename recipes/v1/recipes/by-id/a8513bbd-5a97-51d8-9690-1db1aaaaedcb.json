  "id": "a8513bbd-5a97-51d8-9690-1db1aaaaedcb",
  "slug": "white-chocolate-cranberry-scones",
  "name": "White Chocolate-Cranberry Scones",
  "recipe_type": "dessert",
  "brief_description": "Dried cranberries and white chocolate chips combine in these easy scones, perfect for holiday parties or a sweet breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking tray with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, and salt together in a bowl. Cut in butter until the mixture resembles coarse crumbs. Stir in white chocolate chips and cranberries. Mix in buttermilk and egg until just combined and dough forms a shaggy ball."
    },
    {
      "position": 3,
      "text": "Roll out slightly and cut into 12 triangles. Place on the prepared baking tray. Brush each scone with a little cream and sprinkle with some coarse sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until barely golden around the edges, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

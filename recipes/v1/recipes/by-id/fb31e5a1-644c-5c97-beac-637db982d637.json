  "slug": "chicken-chopped-salad-for-one-recipe-11935166",
  "name": "Chicken Chopped Salad for One",
  "recipe_type": "salad",
  "brief_description": "This chopped chicken salad for one is perfect for a quick lunch. Beautifully balanced it is filling and nutritious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place Ranch dressing in the bottom of a salad bowl, and thin with water, if desired."
    },
    {
      "position": 2,
      "text": "Add chicken, black olives, egg, hard cheese, cherry tomatoes, avocado, bacon, and Romaine salad to the bowl and toss, being careful to pull up the salad dressing from the bottom of the bowl."
    },
    {
      "position": 3,
      "text": "Sample; season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Pour salad onto a pretty plate and garnish with croutons. Serve immediately."
    }
  ],
  "servings": 1,

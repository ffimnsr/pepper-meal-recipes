  "id": "ccd9cb0a-23c7-5210-b099-baeabc6100fb",
  "slug": "coney-island-hot-dogs",
  "name": "Coney Island Hot Dogs",
  "recipe_type": "main",
  "brief_description": "Enjoy the famous Coney Island hot dogs at home with Chef John's recipe for the Detroit favorite with a rich meat sauce and fresh chopped onion.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ground beef, water, 1/2 cup diced onion, ketchup, butter, garlic, chili powder, salt, black pepper, cumin, celery salt, and cayenne pepper together in a pot. Mix with a potato masher or spatula over medium-high heat until mixture has a finely ground consistency and begins to bubble, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Bring beef mixture to a simmer, reduce heat to medium-low, and cook, stirring occasionally, until sauce thickens and reduces, about 1 hour. Season with salt and pepper to taste."
    },
    {
      "position": 4,
      "text": "Bring a large pot of water to a boil. Cook hot dogs in boiling water until heated through, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Arrange hot dog buns on a baking sheet. Cook buns in the preheated oven until soft and warm, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Place 1 bun on a plate. Place a hot dog in the bun and top with meat sauce. Drizzle yellow mustard and a portion of remaining diced onion over the meat sauce. Repeat with remaining hot dogs."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

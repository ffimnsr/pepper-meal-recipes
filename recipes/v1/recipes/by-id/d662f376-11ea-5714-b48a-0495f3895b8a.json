  "id": "d662f376-11ea-5714-b48a-0495f3895b8a",
  "slug": "parmesan-crusted-sweet-potatoes-recipe-11960996",
  "name": "Parmesan Crusted Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "These Parmesan crusted sweet potatoes develop a caramelized crust of toasted Parmesan cheese while they roast, a savory, salty contrast to the tender, moist sweet potato inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Cut sweet potatoes in half lengthwise and poke holes in the skin with a fork. Rub with olive oil; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "In a baking dish, place 2 slices of butter per potato. Pile Parmesan over each pair of butter slices in the shape of the potato, then lay a potato half face down on top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until soft inside and crispy on the edges, about 30 minutes. Turn potatoes cut side up and top with green onions to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

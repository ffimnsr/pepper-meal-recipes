  "id": "3bdfe9ee-a874-5ca9-926b-11324fd89642",
  "slug": "fish-puttanesca-recipe-8611251",
  "name": "Fish Puttanesca",
  "recipe_type": "main",
  "brief_description": "This fish puttanesca, cod filets in a simple but robust puttanesca sauce, is served over spaghetti. Any mild white fish will work just fine in this dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large skillet over medium-low heat until it shimmers."
    },
    {
      "position": 3,
      "text": "Add capers, anchovy paste, garlic, and red pepper and cook, stirring frequently, until garlic is soft and fragrant, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Drain off about 1/2 cup of the liquid in the tomato can and discard. With clean hands, crush tomatoes, and add to the skillet with the remaining juice. Stir in olives and minced parsley. Season to taste with salt and black pepper."
    },
    {
      "position": 5,
      "text": "Bring sauce to a boil, add fish filets, and reduce heat to a simmer. Sauce should bubble occasionally, but not boil, once fish have been added."
    },
    {
      "position": 6,
      "text": "Cook until fish flakes easily with a fork, 8 to 10 minutes, spooning sauce over fish occasionally. Thin filets may cook more quickly. An instant read thermometer inserted in the fish should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 7,
      "text": "Evenly divide spaghetti into 4 serving dishes. Place 1 filet in each dish and ladle sauce over all. Garnish with parsley sprigs."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

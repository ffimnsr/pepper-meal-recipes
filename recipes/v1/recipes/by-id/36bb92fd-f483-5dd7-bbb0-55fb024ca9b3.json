  "schema_version": 1,
  "id": "36bb92fd-f483-5dd7-bbb0-55fb024ca9b3",
  "slug": "apple-cider-pepper-pot-roast-pressure-cooker-recipe",
  "name": "Apple Cider Pepper Pot Roast (Pressure Cooker Recipe)",
  "recipe_type": "main",
  "brief_description": "Beef pot roast is pressure-cooked with fresh vegetables and herbs in a hearty apple cider-red wine gravy in this quick one-dish meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place onion, celery, baby carrots, mushrooms, and garlic in a food processor; pulse to coarsely chop."
    },
    {
      "position": 2,
      "text": "Coat roast generously with 2 tablespoons olive oil; season both sides with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Heat remaining 2 tablespoons olive oil in a pressure cooker over medium heat. Cook roast until browned, 2 to 3 minutes per side. Transfer roast to a large plate."
    },
    {
      "position": 4,
      "text": "Place chopped vegetable mixture in the pressure cooker; cook and stir until slightly softened, about 2 minutes. Stir in wine and cook until flavors combine, about 1 minute. Pour in broth and apple cider. Stir in thyme and bay leaves into sauce. Place roast back in the cooker; spoon sauce to cover roast as much as possible."
    },
    {
      "position": 5,
      "text": "Cover and cook at high pressure according to manufacturer's instructions, 50 to 60 minutes. Remove from heat and allow pressure to release naturally according to manufacturer's instructions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 61,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

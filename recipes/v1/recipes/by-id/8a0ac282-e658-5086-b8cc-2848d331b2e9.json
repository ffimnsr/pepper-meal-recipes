  "id": "8a0ac282-e658-5086-b8cc-2848d331b2e9",
  "slug": "sirloin-steak-with-garlic-butter",
  "name": "Sirloin Steak with Garlic Butter",
  "recipe_type": "main",
  "brief_description": "This grilled sirloin steak recipe includes a super garlicky melted butter that's made with freshly minced garlic and garlic powder. Simply delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Melt butter in a small saucepan over medium-low heat."
    },
    {
      "position": 3,
      "text": "Stir in minced garlic and garlic powder. Set aside."
    },
    {
      "position": 4,
      "text": "Season both sides of each steak with salt and pepper."
    },
    {
      "position": 5,
      "text": "Place steaks on preheated grill and cook 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium doneness."
    },
    {
      "position": 6,
      "text": "Transfer steaks to warmed plates; brush the tops liberally with garlic butter and allow to rest for 2 to 3 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

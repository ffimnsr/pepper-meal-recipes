  "slug": "baked-feta-mashed-potatoes-recipe-7253573",
  "name": "Baked Feta Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Feta cheese is baked together with yellow potatoes, roasted red peppers, garlic, and pesto, then mashed\u2014all in one dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Stir potatoes, peppers, pesto, and garlic together in a baking dish; drizzle with olive oil and toss to combine. Season with salt and pepper. Nestle the block of feta cheese into the center of potato mixture."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until potatoes are tender when pierced with a fork, about 45 minutes. Mash potatoes and feta with a potato masher."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 45,

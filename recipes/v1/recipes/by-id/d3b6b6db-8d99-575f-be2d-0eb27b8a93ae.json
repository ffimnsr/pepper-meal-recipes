  "id": "d3b6b6db-8d99-575f-be2d-0eb27b8a93ae",
  "slug": "slow-cooker-asian-zing-chicken-noodles-recipe-11725006",
  "name": "Slow Cooker Asian Zing Chicken Noodles",
  "recipe_type": "dessert",
  "brief_description": "These slow cooker Asian zing chicken noodles are amazing\u2014so much flavor with so little effort. Chicken thighs, slow-cooked in sweet spicy chili-soy-ginger zing sauce are shredded and tossed with quick-cooking fresh lo mein. If your comfort food tends to the spicy, this is for you.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken thighs into a slow cooker. Pour sauce over chicken and cover with the lid. Cook on Low until chicken is very tender, about 3 hours."
    },
    {
      "position": 2,
      "text": "Use two forks to shred chicken into large chunks."
    },
    {
      "position": 3,
      "text": "Bring a large pot of salted water to a boil; add noodles and cook until tender with a bite, 40 seconds to 3 minutes, or according to package directions; drain. Place prepared lo mein into the crockpot with chicken and toss until combined."
    },
    {
      "position": 4,
      "text": "Serve with freshly sliced green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 5,

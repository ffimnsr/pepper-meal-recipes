  "id": "b12c9921-c8ed-5b1b-b73d-4e08bc86dddd",
  "slug": "reverse-sear-prime-rib-roast",
  "name": "Reverse-Sear Prime Rib Roast",
  "recipe_type": "main",
  "brief_description": "This reverse-sear prime rib roast recipe is dry-brined and slow-roasted for rich flavor, then finished with a high-heat sear for a caramelized crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season roast generously with salt."
    },
    {
      "position": 2,
      "text": "Cover loosely with plastic wrap and refrigerate, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Let roast come to room temperature, about 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 200 degrees F (95 degrees C)."
    },
    {
      "position": 5,
      "text": "Mix butter, rosemary, thyme, and black pepper together in a small bowl."
    },
    {
      "position": 6,
      "text": "Spread butter mixture over roast. Place roast in a large roasting pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until internal temperature reaches 115 degrees F (46 degrees C) for medium-rare, about 3 \u00bd hours. Remove from the oven and tent with aluminum foil; let rest, about 20 minutes."
    },
    {
      "position": 8,
      "text": "Meanwhile, increase the oven temperature to 500 degrees F (260 degrees C)."
    },
    {
      "position": 9,
      "text": "Roast until well browned and the internal temperature reaches 125 to 130 degrees F (52 to 54 degrees C) for medium-rare, 6 to 10 minutes. Slice and serve."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 220,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

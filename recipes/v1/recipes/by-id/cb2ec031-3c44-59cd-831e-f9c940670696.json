  "id": "cb2ec031-3c44-59cd-831e-f9c940670696",
  "slug": "delmonico-potatoes",
  "name": "Delmonico Potatoes",
  "recipe_type": "side",
  "brief_description": "These Delmonico potatoes are boiled, shredded, and layered with a savory cheese sauce for an easy, tasty, and comforting baked potato casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Cook potatoes in boiling water until tender, 8 to 10 minutes. Refrigerate potatoes for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish."
    },
    {
      "position": 4,
      "text": "Grate cooked potatoes into a large bowl. Combine melted butter, onion, parsley, salt, and pepper in a small bowl. In a separate small bowl, mix sour cream and milk."
    },
    {
      "position": 5,
      "text": "Layer 1/2 of the potatoes into the bottom of the prepared casserole dish. Sprinkle with 1/2 of the butter and onion mixture. Pour 1/2 of the sour cream mixture over the top; cover with 1/2 cup shredded cheese. Repeat with remaining ingredients."
    },
    {
      "position": 6,
      "text": "Bake casserole in the preheated oven until cheese on top is lightly browned, about 1 hour."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

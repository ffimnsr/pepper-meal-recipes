  "id": "fbd2a656-10e9-5408-a344-8053bf39264f",
  "slug": "lemon-poppy-seed-scones",
  "name": "Lemon Poppy Seed Scones",
  "recipe_type": "breakfast",
  "brief_description": "Make Chef John-level lemon poppy seed scones that are delightfully tender thanks to a slightly messy countertop method followed by a quick 2-ingredient strawberry glaze.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place self-rising flour in a large bowl. Cut in butter using a pastry blender until mixture resembles coarse crumbs. Add poppy seeds, sugar, and lemon zest; mix to combine. Make a well in the center and pour in egg, lemon juice, and milk. Mix with a fork until dough starts to come together. Scoop up with one hand until a shaggy dough forms."
    },
    {
      "position": 3,
      "text": "Pour dough out onto your work surface. Use your hands and a bench scraper to gather and press dough into a neat rectangle about 1- to 1-1/2-inches tall. Cut into 4 squares and then diagonally into 8 triangles. Space scones evenly onto a silicone-lined baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bottoms are golden brown, about 25 minutes. Let cool in pan for 5 minutes, then transfer onto a wire rack to cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Mash strawberries finely to resemble a puree. Whisk in powdered sugar in batches to make a thick, spreadable glaze. Spread glaze over the cooled scones. Let scones cool on the rack until glaze hardens, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

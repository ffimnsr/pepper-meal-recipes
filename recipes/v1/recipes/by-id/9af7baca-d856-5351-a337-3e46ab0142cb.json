  "id": "9af7baca-d856-5351-a337-3e46ab0142cb",
  "slug": "pork-dumpling-hamburger-sliders-recipe-7971775",
  "name": "Pork Dumpling Hamburger Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These pork dumpling hamburger sliders really taste like the inside of a pork dumpling. They are paired with a spicy, creamy sauce that pairs nicely with the sweet bun and a tangy slaw.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cabbage, green onion, rice vinegar, olive oil, 1/2 teaspoon kosher salt, and 1/4 teaspoon pepper for the slaw in a bowl and toss well. Set aside in the refrigerator until ready to serve."
    },
    {
      "position": 2,
      "text": "Stir together mayonnaise and Sriracha in a small bowl and set aside."
    },
    {
      "position": 3,
      "text": "Combine pork, green onion, soy sauce, sesame oil, ginger, garlic powder, 1 teaspoon salt, 1/2 teaspoon pepper, and egg in a bowl and mix well. Stir in breadcrumbs until just combined. Form mixture into 12 patties, each about 3/4-inch thick."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon oil in a large nonstick skillet over medium heat until hot. Working in batches, add \u00bd of the patties to the skillet and cook until browned and cooked through, about 4 minutes on each side."
    },
    {
      "position": 5,
      "text": "Spread mayo on tops and bottoms of slider buns. Add burger patties to bottom buns and top with slaw. Place top bun over slaw and serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

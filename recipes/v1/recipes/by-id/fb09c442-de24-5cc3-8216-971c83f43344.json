  "id": "fb09c442-de24-5cc3-8216-971c83f43344",
  "slug": "grandma-randolphs-noodles",
  "name": "Grandma Randolph's Noodles",
  "recipe_type": "soup",
  "brief_description": "Serve these rustic noodles in place of mashed potatoes with a Thanksgiving dinner, or put them in a turkey carcass soup the day after the feast. Allow a minimum of two hours after cutting for these noodles to dry.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs in a large bowl. Mix in flour, salt, and pepper. Divide dough in half, then roll out the halves to 1/4-inch thick. Let dry for at least 2 hours."
    },
    {
      "position": 2,
      "text": "Cut noodles into long strips, 1/2-inch to 1-inch wide."
    },
    {
      "position": 3,
      "text": "Bring beef broth to a boil over high heat. Drop noodles into boiling broth and cook until soft."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

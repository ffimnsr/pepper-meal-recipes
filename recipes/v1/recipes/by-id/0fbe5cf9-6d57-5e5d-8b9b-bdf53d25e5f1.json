  "schema_version": 1,
  "id": "0fbe5cf9-6d57-5e5d-8b9b-bdf53d25e5f1",
  "slug": "stuffed-green-peppers",
  "name": "Ali\u2019s Stuffed Green Peppers",
  "recipe_type": "main",
  "brief_description": "Stuff bell peppers with a mixture of cooked ground beef and rice in tomato sauce for an American classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a pot of water to a boil. Cook green bell peppers in the boiling water until soft, 5 to 8 minutes; drain."
    },
    {
      "position": 3,
      "text": "Cook ground beef in large skillet over medium-high heat, breaking into small pieces with a spatula as it cooks, until completely browned, 7 to 10 minutes. Drain and discard excess grease. Transfer beef to a large bowl."
    },
    {
      "position": 4,
      "text": "Stir rice, celery, onion, and about half the tomato sauce with the ground beef; season with salt and pepper. Stuff cooked green peppers with the ground beef mixture."
    },
    {
      "position": 5,
      "text": "Arrange stuffed peppers in a baking dish. Pour enough water into the baking dish to about 1-inch deep. Pour remainder of tomato sauce over the peppers."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until heated through, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

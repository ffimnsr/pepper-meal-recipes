  "id": "b46cd1a7-f84c-529c-92a9-cdec3f13cfff",
  "slug": "good-dog-cookies",
  "name": "Good Dog Cookies",
  "recipe_type": "dessert",
  "brief_description": "A gift idea your canine friends will beg for!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Lightly grease one cookie sheet."
    },
    {
      "position": 2,
      "text": "Dissolve bouillon cubes in boiling water and allow to cool."
    },
    {
      "position": 3,
      "text": "Combine the flour, dry milk, egg, oil, beef broth and brown sugar. Mix well and knead dough for 1 minute."
    },
    {
      "position": 4,
      "text": "On a floured surface roll out dough to about 1/4 inch thickness. Cut out bones and place on cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake for 30 minutes and allow to cool."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

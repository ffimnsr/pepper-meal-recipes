  "id": "0a0beda9-3ec3-58ff-9f8c-9da294243fcc",
  "slug": "pecan-chicken-salad",
  "name": "Pecan Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This flavorful pecan chicken salad comes together fast using leftover or rotisserie chicken, herbs, celery, pecans, and a creamy homemade dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix mayonnaise, Greek yogurt, vinegar, garlic powder, thyme, and maple pepper together in a bowl until well combined. Add chicken, celery, pecans, and red onion; stir well to incorporate."
    },
    {
      "position": 2,
      "text": "Serve immediately or refrigerate for up to 3 days."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

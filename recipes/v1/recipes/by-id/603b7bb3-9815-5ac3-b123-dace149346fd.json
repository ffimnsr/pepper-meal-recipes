  "id": "603b7bb3-9815-5ac3-b123-dace149346fd",
  "slug": "pumpkin-pie-ii",
  "name": "Pumpkin Pie without Evaporated Milk",
  "recipe_type": "dessert",
  "brief_description": "For this delicious pumpkin pie, whole milk is stirred into pumpkin pur\u00e9e, so it's a bit lighter than others but still just as delicious and creamy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pumpkin pur\u00e9e, milk, sugar, eggs, flour, cinnamon, nutmeg, salt, and cloves in a large bowl; mix with an electric mixer until smooth. Pour evenly into pie shells."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue to bake until filling is set, 35 to 45 more minutes. Place pies on a wire rack to cool. Serve warm or at room temperature."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "29441025-bb67-5e73-83a4-2bebf66f3c4d",
  "slug": "no-bake-chocolate-peanut-butter-cookies",
  "name": "No Bake Chocolate Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "The wonderful combination of peanut butter and chocolate comes together again in this easy no-bake cookie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with waxed paper."
    },
    {
      "position": 2,
      "text": "Bring sugar, milk, margarine, and cocoa powder to a boil in a large saucepan for 1 1/2 minutes. Remove from heat and stir in oats, peanut butter, and vanilla extract until dough is evenly mixed."
    },
    {
      "position": 3,
      "text": "Drop tablespoonfuls of dough on prepared baking dish and let rest until cooled and set, about 50 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "0301722d-ccf3-5072-89f6-e1a0ab2dd2fd",
  "slug": "chicken-liver-pate-with-currants",
  "name": "Chicken Liver Pate with Currants",
  "recipe_type": "appetizer",
  "brief_description": "This chicken liver pate flavored with orange liqueur, currants, thyme, and allspice is an easy appetizer that will wow dinner guests.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place currants in a small bowl; cover with orange liqueur. Let soak until plump, about 1 hour."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in a large skillet over medium heat. Cook and stir onion and garlic in the hot butter until softened, about 1 minute. Add chicken livers; cook and stir until no longer pink in the center, 5 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Place remaining 3/4 cup butter, chicken liver mixture, heavy cream, thyme, and allspice in a food processor; blend until smooth. Transfer to a bowl and stir in currants and orange liqueur. Season pate with salt and pepper."
    },
    {
      "position": 4,
      "text": "Divide pate among small ramekins. Refrigerate until firm, at least 3 hours."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 20,

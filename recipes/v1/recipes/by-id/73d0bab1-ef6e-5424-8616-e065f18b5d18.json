  "slug": "quick-black-bean-hummus",
  "name": "Quick Black Bean Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Black beans make a delicious and healthy alternative to the usual garbanzo beans in hummus - your vegetarian friends and family will thank you!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend black beans, garlic, lemon juice, tahini, cumin, salt, and black pepper together in a blender. Pour olive oil into blender in a steady stream until desired consistency is reached."
    }
  ],

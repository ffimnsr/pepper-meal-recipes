  "slug": "summer-punch-recipe-11972137",
  "name": "Summer Punch",
  "recipe_type": "drink",
  "brief_description": "This summer punch will definitely get your party started. It's easy to make and perfectly refreshing on hot summer days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vodka, pink lemonade concentrate, limeade concentrate, Sprite, and the juice from 1 jar of cherries into a large beverage dispenser. Stir to melt the concentrates and float half of the lime slices on top."
    },
    {
      "position": 2,
      "text": "Serve over ice and garnish with lime slices and cherries."
    }
  ],
  "servings": 32,

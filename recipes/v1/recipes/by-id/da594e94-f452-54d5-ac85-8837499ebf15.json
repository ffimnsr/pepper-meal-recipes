  "id": "da594e94-f452-54d5-ac85-8837499ebf15",
  "slug": "no-yeast-pizza-crust",
  "name": "No-Yeast Pizza Crust",
  "recipe_type": "main",
  "brief_description": "This no-yeast pizza dough is quick and easy to make without hours of waiting for the dough to rise. Add your favorite pizza toppings for a fun meal!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix flour, baking powder, and salt together in a bowl; stir in milk and olive oil until a soft dough forms."
    },
    {
      "position": 3,
      "text": "Turn dough onto a lightly floured surface and knead 10 times. Shape dough into a ball; cover with an inverted bowl and let sit for 10 minutes. Meanwhile, preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Roll dough into a 12-inch circle on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake the crust in the preheated oven for 8 minutes."
    },
    {
      "position": 6,
      "text": "Add your favorite toppings and bake until the crust is golden brown, about 10 to 15 minutes more. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

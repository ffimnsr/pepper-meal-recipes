  "id": "dbc8625c-92f7-5dfd-8d9f-ab48a6c1423b",
  "slug": "flavorful-spanish-rice-and-beans",
  "name": "Flavorful Spanish Rice and Beans",
  "recipe_type": "side",
  "brief_description": "This easy Spanish rice and beans dish has bold seasonings making it very flavorful. You can also customize this easy side dish with green olives and more.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, rice, and olive oil to a boil in a saucepan over high heat. Mix in onion, Saz\u00f3n seasoning, adobo seasoning, garlic, and black pepper. Reduce heat to medium-low; cover and cook for 10 minutes."
    },
    {
      "position": 2,
      "text": "Add beans and olives and cook until liquid has been absorbed, about 10 minutes. Mix before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

  "id": "f4d76c76-7786-57fc-a975-feacdbeab34f",
  "slug": "meatloaf",
  "name": "Meatloaf",
  "recipe_type": "soup",
  "brief_description": "Mustard, steak sauce, and condensed tomato soup flavor this meatloaf made with ground round, chopped onions, and rolled oats. Makes 9 generous servings.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ground beef, soup, chopped onion, rolled oats, eggs, steak sauce, ketchup, and mustard in a large bowl. Mix well."
    },
    {
      "position": 3,
      "text": "Shape into a loaf, and pat into a loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

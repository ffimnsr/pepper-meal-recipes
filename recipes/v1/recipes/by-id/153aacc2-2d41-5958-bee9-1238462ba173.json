  "id": "153aacc2-2d41-5958-bee9-1238462ba173",
  "slug": "mini-crescent-roll-burgers",
  "name": "Mini Crescent Roll Burgers",
  "recipe_type": "appetizer",
  "brief_description": "Refrigerated crescent rolls make a tasty bun for these kid-friendly beef and cheese snacks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat; cook and stir ground beef until crumbly, evenly browned, and no longer pink, 8 to 10 minutes. Drain and discard any excess grease. Stir in Cheddar cheese and onion soup mix."
    },
    {
      "position": 3,
      "text": "Divide crescent roll dough into triangles along perforated edges. Place 1 tablespoonful beef mixture onto each triangle; roll dough over meat and transfer crescent rolls to a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "01556e57-a5ce-5ba7-abf0-7626cab56c62",
  "slug": "stevens-baked-nachos",
  "name": "Steven's Baked Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Steven's oven-baked nachos recipe has layers of tortilla chips, grated Jack cheese, shredded chicken, refried beans, and sour cream, baked to perfection.",
  "cuisine": "Mexican Inspired Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x9-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place chicken on a microwave-safe plate; cover with a paper towel. Cook on high power until cooked through and no longer pink, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Cool, then shred using a knife; set aside."
    },
    {
      "position": 4,
      "text": "Cook and stir refried beans in a saucepan over medium until thoroughly heated."
    },
    {
      "position": 5,
      "text": "Layer \u00bd the chips, \u00bd cup cheese, and green onions on bottom of the prepared baking dish. Spoon beans over top."
    },
    {
      "position": 6,
      "text": "Layer \u00bd cup cheese and sour cream over beans. Arrange shredded chicken over top, then top with remaining \u00bd chips and \u00bd cup cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese melts throughout, 15 to 18 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

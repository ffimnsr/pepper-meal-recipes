  "id": "cee471a9-ea28-5544-a0d3-7da7a1d01a18",
  "slug": "strawberry-shortcake-kabobs",
  "name": "Strawberry Shortcake Kabobs",
  "recipe_type": "dessert",
  "brief_description": "Mini shortcake biscuits and strawberries are threaded onto skewers in this sweet and clever strawberry shortcake kabobs recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line 2 baking sheets with parchment paper or spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking soda, and salt together in a bowl; cut in cold butter using a pastry blender or your hands until crumbly."
    },
    {
      "position": 3,
      "text": "Stir buttermilk and applesauce together in a separate bowl; pour into the flour mixture until dough comes together and is sticky. Using 2 spoons, drop dough into about 1/2 tablespoon-size mounds onto the prepared baking sheet, making 36 total mounds."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the bottoms are slightly browned, 4 to 5 minutes. Cool biscuits."
    },
    {
      "position": 5,
      "text": "Thread 3 biscuits onto each skewer, alternating with 3 strawberries halves, until all the ingredients are used. Top each skewer with whipped topping."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 4,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "151fd84c-578b-5a45-a9c9-f3a71ba3e8e8",
  "slug": "baked-mexican-rice",
  "name": "Baked Mexican Rice",
  "recipe_type": "side",
  "brief_description": "This baked Mexican rice recipe uses green bell pepper, onion, saz\u00f3n seasoning, ground cumin, ground coriander, garlic powder, tomato sauce, and cilantro.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place rice in a 9-inch square baking dish. Drizzle in canola oil; stir until rice completely coated. Stir in bell pepper, green onions, and chopped onion; season with saz\u00f3n seasoning, cumin, coriander, garlic powder, and salt."
    },
    {
      "position": 3,
      "text": "Combine water and tomato sauce in a microwave-safe bowl or measuring cup. Microwave until simmering, about 2 minutes. Pour over rice; stir briefly. Tightly cover the baking dish with heavy-duty aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes. Let stand, covered, for 5 minutes. Uncover; fluff rice with a fork. Stir in cilantro; squeeze lime juice over top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

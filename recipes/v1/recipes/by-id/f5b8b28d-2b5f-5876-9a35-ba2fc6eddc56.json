{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f5b8b28d-2b5f-5876-9a35-ba2fc6eddc56",
  "slug": "one-pan-buttery-chicken-and-orzo-recipe-11993220",
  "name": "One-Pan Buttery Chicken and Orzo",
  "recipe_type": "main",
  "brief_description": "This one skillet buttery chicken and orzo is so very versatile and is absolutely delicious. Serve with some fresh parsley on top for a beautiful presentation. You\u2019ll be surprised that so few simple ingredients can make such a lovely dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat chicken breasts dry. Cover breasts generously with kosher salt on both sides. Wrap in plastic wrap and place in the refrigerator for several hours or overnight to brine."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Rub the inside of an oven-safe skillet with 1 tablespoon butter. Place chicken breasts in the skillet. Carefully pour the 1/4 cup of chicken stock around chicken, but not on top. Cover the skillet with heavy aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 45 minutes, or until an instant read thermometer inserted in the hottest spot reaches 154 degrees F (68 degrees C). Remove chicken to a board and cut into bite-size pieces. Do not turn the oven off."
    },
    {
      "position": 4,
      "text": "Place the skillet on the stovetop and bring to medium heat. Meanwhile, add remaining 3 cups stock to a saucepan and bring to a simmer."
    },
    {
      "position": 5,
      "text": "Place cut chicken back in the skillet and saute until pieces are lightly browned, about 5 minutes. Remove and keep covered to stay warm."
    },
    {
      "position": 6,
      "text": "Add remaining 3 tablespoons butter to the skillet, then add orzo. Stir for about 1 minute, then add the heated stock."
    },
    {
      "position": 7,
      "text": "Return skillet to the oven and bake or until orzo is tender and starting to absorb the stock, about 30 minutes."
    },
    {
      "position": 8,
      "text": "Remove the skillet and place it back on the stovetop. Bring to a medium-low heat, then stir in Parmesan. Add chicken back to the skillet; stir until sauce begins to thicken and chicken is completely warmed through."
    },
    {
      "position": 9,
      "text": "Season with black pepper; serve in wide bowls with parsley garnish."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 20,

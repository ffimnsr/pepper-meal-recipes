  "id": "13b91d7a-2e4b-5f74-8afb-a3a122979bd9",
  "slug": "easy-baked-beans",
  "name": "Easy BBQ Baked Beans",
  "recipe_type": "side",
  "brief_description": "These baked beans with ketchup are made in one dish with canned pork and beans, bacon, mustard, and barbecue sauce for an easy, flavorful side dish.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir pork and beans, brown sugar, ketchup, barbecue sauce, bacon, and dry mustard together in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring every 20 minutes or so, until bacon fat is rendered throughout bean mixture, about 2 hours 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "name": "Blackberry-Basil Skewers",
  "recipe_type": "appetizer",
  "brief_description": "Fruit, cheese, and basil combine for these light, easy appetizer skewers that are sure to please at your next party or potluck.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Assemble skewers in this order: basil leaf, blackberry, basil leaf, mozzarella ball, basil leaf, and a dried apricot."
    },
    {
      "position": 2,
      "text": "Drizzle skewers with balsamic glaze and serve."
    }

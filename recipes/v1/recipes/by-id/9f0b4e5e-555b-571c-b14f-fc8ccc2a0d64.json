  "id": "9f0b4e5e-555b-571c-b14f-fc8ccc2a0d64",
  "slug": "seitan-fajitas",
  "name": "Seitan Fajitas",
  "recipe_type": "main",
  "brief_description": "This recipe with seitan strips, a wheat gluten-based meat alternative, makes spicy vegetarian fajitas stuffed with bell peppers, onion, and garlic.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir bell peppers and onion in hot oil until tender, 3 to 5 minutes. Add seitan, soy sauce, garlic, chili powder, paprika, and cumin; cook and stir until seitan is heated through, 7 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Spoon seitan filling onto each tortilla and fold tortilla around filling."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

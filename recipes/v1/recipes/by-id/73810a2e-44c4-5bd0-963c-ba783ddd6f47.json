  "id": "73810a2e-44c4-5bd0-963c-ba783ddd6f47",
  "slug": "huli-huli-chicken",
  "name": "Huli Huli Chicken",
  "recipe_type": "drink",
  "brief_description": "A Hawaiian variation of teriyaki chicken is marinated in a pineapple juice mixture and baked in a hot oven. Turn and baste the chicken every 10 minutes for flavorful, brown, tender meat. Serve over sticky rice.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse chicken pieces and pat dry with paper towels. Combine pineapple juice, soy sauce, brown sugar, ketchup, sherry, ginger, garlic, green onions, and dry mustard in a large resealable plastic bag, stirring the marinade until brown sugar has dissolved. Place chicken pieces into the bag, squeeze out air, seal bag, and lomi (massage) bag to coat chicken with marinade. Refrigerate at least 4 hours to overnight."
    },
    {
      "position": 2,
      "text": "Move an oven rack 6 inches from heat source and preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove chicken from marinade and arrange chicken, skin sides up, on a broiler pan."
    },
    {
      "position": 4,
      "text": "Bake chicken in preheated oven until browned on both sides and the juices run clear, turning every 10 minutes, 30 to 45 minutes. Baste with remaining marinade after each turning. An instant-read meat thermometer inserted into the thickest piece of chicken, not touching bone, should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5f352864-3ce4-536b-8b3a-07144164f0a4",
  "slug": "pork-steaks",
  "name": "Pork Steaks",
  "recipe_type": "main",
  "brief_description": "This pork steak recipe is easy to make in one skillet on the stovetop. Tender, flavorful pork butt steaks are cooked in soy sauce and green onion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat; stir in soy sauce. Add green onions and garlic and cook until lightly browned, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Place pork steaks in the skillet. Cover and cook until browned, 8 to 10 minutes per side. Remove the lid and continue cooking until an instant-read thermometer inserted into the thickest part of the steak reads 145 degrees F (63 degrees C), about 10 minutes."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

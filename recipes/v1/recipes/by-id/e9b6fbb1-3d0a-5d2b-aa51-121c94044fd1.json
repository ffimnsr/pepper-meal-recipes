  "schema_version": 1,
  "id": "e9b6fbb1-3d0a-5d2b-aa51-121c94044fd1",
  "slug": "easy-ranch-parmesan-chicken",
  "name": "Easy Ranch-Parmesan Chicken",
  "recipe_type": "snack",
  "brief_description": "Sprinkling ranch dressing mix into the breading gives this baked chicken Parmesan an easy flavor boost.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x13-inch glass baking dish."
    },
    {
      "position": 2,
      "text": "Mix crushed crackers, bread crumbs, Parmesan cheese, ranch dressing, salt, and pepper in a resealable 1-quart storage bag."
    },
    {
      "position": 3,
      "text": "Dip a chicken breast into the beaten eggs. Lift up so excess egg drips back in the bowl. Add chicken to the bag with the breading and shake until completely covered. Place in the prepared baking dish. Dredge remaining chicken breasts. Top each breast with a pat of butter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until chicken is golden brown on the outside and no longer pink on the inside, about 1 hour. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

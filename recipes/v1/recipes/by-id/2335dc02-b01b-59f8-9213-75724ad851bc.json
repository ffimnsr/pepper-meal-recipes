{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2335dc02-b01b-59f8-9213-75724ad851bc",
  "slug": "tender-flank-steak",
  "name": "Tender Flank Steak",
  "recipe_type": null,
  "brief_description": "It's not difficult to make a flavorful and tender flank steak \u2014 just marinate it overnight in a mixture of garlic, soy sauce, and Worcestershire.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk soy sauce, Worcestershire sauce, and garlic together in a bowl; pour into a resealable plastic bag. Add flank steak, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "When ready to cook, preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove flank steak from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 4,
      "text": "Cook steak on the grill until slightly pink in the center and beginning to firm, about 7 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium doneness."
    },
    {
      "position": 5,
      "text": "Slice against the grain to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

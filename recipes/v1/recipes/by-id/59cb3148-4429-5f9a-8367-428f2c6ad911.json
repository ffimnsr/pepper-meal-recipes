  "id": "59cb3148-4429-5f9a-8367-428f2c6ad911",
  "slug": "sous-vide-cod",
  "name": "Sous Vide Cod",
  "recipe_type": "main",
  "brief_description": "Try this sous vide cod recipe for tender, flaky fish cooked with lemon and butter. The hands-on time is minimal, but the results suggest otherwise!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water. Attach an immersion circulator to the pot. Set the temperature to 130 degrees F (54 degrees C) and the timer to 35 minutes."
    },
    {
      "position": 2,
      "text": "Season cod lightly with salt and pepper. Top each piece with 1/2 of the lemon zest, 1 teaspoon butter, and 2 lemon slices."
    },
    {
      "position": 3,
      "text": "Divide shallot slices between 2 resealable plastic bags. Place a cod loin on top of shallot slices. Close the bags, leaving 1 small corner open."
    },
    {
      "position": 4,
      "text": "Lower the bags into the preheated water and submerge until all the air has been expelled. Close the corners and turn on the timer."
    },
    {
      "position": 5,
      "text": "Remove the bags when the timer goes off. Carefully transfer cod to serving plates. Drizzle 1 tablespoon cooking liquid from each bag over each loin. Garnish with extra lemon slices."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "36ace1da-ec7a-591c-99d7-816ad2b3a893",
  "slug": "spooky-jell-o-jigglers",
  "name": "Spooky JELL-O JIGGLERS",
  "recipe_type": "salad",
  "brief_description": "Use your imagination and cut out classic Halloween shapes--cats, jack o' lanterns, bats--and serve as a snack or use as decorations.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir boiling water into dry gelatin mix in large bowl at least 3 min. until gelatin is completely dissolved. Pour into 13x9-inch pan."
    },
    {
      "position": 2,
      "text": "Refrigerate at least 3 hours or until firm."
    },
    {
      "position": 3,
      "text": "Dip bottom of pan in warm water 15 sec. Cut into 24 decorative shapes, using 2-inch Halloween-shaped cookie cutters, making sure to cut all the way through gelatin to bottom of pan. Lift gelatin shapes from pan. Store in tightly covered container in refrigerator."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

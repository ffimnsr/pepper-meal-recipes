  "id": "b201b6d3-7c35-56c6-9e60-93edfedc9b05",
  "slug": "million-dollar-crackers-recipe-11953053",
  "name": "Million Dollar Crackers",
  "recipe_type": "appetizer",
  "brief_description": "These million dollar crackers are rich and salty - the perfect party snack! Sweet, buttery crackers and sharp Cheddar create the base for smoky bacon, cool and tangy sour cream, and fresh scallions. Every sandwiched cracker has a crunchy bite with melted, gooey cheese and chewy bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange half of the crackers, flat-side up, in a single layer on a large rimmed baking sheet lined with parchment paper. Top each cracker with a quartered slice of cheese and a piece of bacon. Top with an additional quartered slice of cheese and remaining crackers, flat-side down."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, 8 to 10 minutes. Let cool 5 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, stir together melted butter, scallions, Dijon, salt, and garlic powder in a medium bowl. Top each cooled cracker evenly with about 1/4 teaspoon butter mixture. Serve with sour cream, if desired. Recipe developed by Isabelle Easter"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

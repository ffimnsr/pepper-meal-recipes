  "id": "0f955462-1bf1-5504-a9ba-ee383f00cc56",
  "slug": "mayonnaise-biscuits",
  "name": "Mayonnaise Biscuits",
  "recipe_type": "main",
  "brief_description": "Mayonnaise biscuits are a Southern tradition. Made with just self-rising flour, milk, and mayo, they're light, fluffy, and absolutely delicious!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir flour, milk, and mayonnaise together in a large bowl until just blended. Drop 12 spoonfuls dough onto the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 12 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,

  "id": "23e66418-4b56-50dd-8ddf-9a7f49cd53ea",
  "slug": "kitchen-sink-hash-brown-and-egg-waffle",
  "name": "Kitchen Sink Hash Brown and Egg Waffle",
  "recipe_type": "breakfast",
  "brief_description": "Perfect for a twist on the classic Sunday brunch, these quick and easy waffles are made with hash browns, eggs, and spicy sriracha sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions; spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix hash browns, eggs, milk, flour, onion, sriracha sauce, garlic, baking powder, salt, and pepper together in a bowl to make batter."
    },
    {
      "position": 3,
      "text": "Pour 1/4 of the mixture onto the preheated waffle iron; spread to the edges with a spatula. Cook until golden and warmed through, 5 to 7 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

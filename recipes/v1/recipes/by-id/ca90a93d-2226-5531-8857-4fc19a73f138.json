  "id": "ca90a93d-2226-5531-8857-4fc19a73f138",
  "slug": "vegetarian-gravy",
  "name": "Vegetarian Gravy",
  "recipe_type": "side",
  "brief_description": "This easy vegetarian gravy gets a savory boost from nutritional yeast and soy sauce. It makes a great accompaniment to vegan and vegetarian dishes.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a medium saucepan over medium heat. Stir in onion and garlic. Cook and stir until onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in flour, nutritional yeast, and soy sauce to form a smooth paste."
    },
    {
      "position": 4,
      "text": "Gradually whisk in broth. Season with sage, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Bring to a boil. Reduce heat, and simmer, stirring constantly, for 8 to 10 minutes, or until thickened. Serve hot."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1a2c952e-0e65-59ed-a2c1-f2bc49376f3f",
  "slug": "instant-pot-shredded-flank-steak",
  "name": "Instant Pot Shredded Flank Steak",
  "recipe_type": "soup",
  "brief_description": "This Instant Pot flank steak recipe turns a tough cut of meat into tender, moist, shredded deliciousness. Serve in sandwiches or as a hearty stew.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select the Saut\u00e9 function. Working in batches, saut\u00e9 steak until browned but not cooked through, 3 to 5 minutes per side. Transfer to a plate."
    },
    {
      "position": 2,
      "text": "Heat avocado oil in the pot. Add mushrooms and onion; saut\u00e9 until onion is translucent, about 5 minutes. Add garlic and thyme; saut\u00e9 until fragrant, about 1 minute. Pour in wine; cook and stir until almost evaporated, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Add broth, Worcestershire sauce, salt, and pepper; bring to a simmer. Add steak and turn to coat with the broth mixture. Select the Meat option, close and lock the lid, and set the timer for 20 minutes. Allow 10 to 15 minutes for the pressure to build."
    },
    {
      "position": 4,
      "text": "Release the pressure using the natural-release method according to manufacturer's instructions, at least 20 minutes. Transfer steak to a plate."
    },
    {
      "position": 5,
      "text": "Stir water and flour together in a small bowl to make a slurry. Select the Saut\u00e9 option and slowly add the slurry to the broth mixture in the pot. Cook until liquid thickens, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Pull steak apart into shreds using two forks. Return shredded steak to the pot and mix with the liquid."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

  "id": "3b9de073-6639-524b-a46a-2833944653b0",
  "slug": "the-best-meatloaf",
  "name": "The Best Meatloaf",
  "recipe_type": "main",
  "brief_description": "This juicy meatloaf with green peppers and onion is topped with steak sauce for a surefire hit any night of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan. Combine bread crumbs and milk in a small bowl; set aside to soften."
    },
    {
      "position": 2,
      "text": "Mix ground beef, onion, bell pepper, steak sauce, egg, salt, and black pepper in a large bowl; add bread crumb mixture and mix with your hands until combined."
    },
    {
      "position": 3,
      "text": "Pat the mixture into the prepared loaf pan; brush the top with 1/4 cup steak sauce."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Allow to stand for 5 minutes before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

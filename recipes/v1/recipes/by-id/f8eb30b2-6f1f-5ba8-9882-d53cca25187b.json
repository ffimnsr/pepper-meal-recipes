  "id": "f8eb30b2-6f1f-5ba8-9882-d53cca25187b",
  "slug": "halloween-eye-of-newt",
  "name": "Halloween Eye of Newt",
  "recipe_type": "appetizer",
  "brief_description": "Bubble, bubble. Toil and trouble. This appetizer is commonly known and used but, I have put my own little twist on this recipe. It is deviled eggs made to look like the eyeballs of a lizard. It a hit with the kids at my Halloween party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place all of the eggs into a large pot so they can rest on the bottom in a single layer. Fill with just enough cold water to cover the eggs. Bring to a boil, then cover, remove from the heat and let stand for about 15 minutes. Rinse under cold water or add some ice to the water and let the eggs cool completely."
    },
    {
      "position": 3,
      "text": "Peel and slice in half lengthwise. Remove the yolks from the eggs and place them in a bowl. Mix in the relish, mayonnaise, celery salt, mustard, and food coloring."
    },
    {
      "position": 4,
      "text": "Spoon this filling into the egg whites and place them on a serving tray. Round the top of the filling using the spoon."
    },
    {
      "position": 5,
      "text": "Place an olive slice on each yolk to create the center of the eye. Dab a tiny bit of mayonnaise in the center of the olive as a finishing touch."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "65102fc3-6c1c-50c0-978b-278eba87b3b1",
  "slug": "broccoli-casserole-with-rice",
  "name": "Broccoli Casserole with Rice",
  "recipe_type": "soup",
  "brief_description": "This creamy broccoli rice casserole is easy to throw together with frozen broccoli, instant rice, mushroom soup, and cheese sauce for a crowd-pleasing side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook instant rice as directed on box and cook broccoli as directed on package; drain."
    },
    {
      "position": 3,
      "text": "Melt butter in a medium pan over medium heat. Add onions; cook and stir until softened, abut 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Combine broccoli, rice, onion, soup, and cheese sauce together: season with salt and pepper. Transfer mixture into a 9x13-inch casserole dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden on top, 30 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

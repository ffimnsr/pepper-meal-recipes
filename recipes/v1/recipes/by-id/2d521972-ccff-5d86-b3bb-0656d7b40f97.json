  "id": "2d521972-ccff-5d86-b3bb-0656d7b40f97",
  "slug": "buffalo-chicken-calzone",
  "name": "Buffalo Chicken Calzone",
  "recipe_type": "snack",
  "brief_description": "This Buffalo chicken calzone made with refrigerated pizza dough is stuffed with shredded meat, wing sauce, and cheese for the perfect game-day snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 410 degrees F (210 degrees C). Grease a 12-inch pizza pan."
    },
    {
      "position": 2,
      "text": "Place chicken into a large pot and cover with salted water; bring to a boil. Cook chicken in boiling water until no longer pink in the center and the juices run clear, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Transfer chicken to a bowl and shred with two forks."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium-high heat. Cook and stir shredded chicken and Buffalo wing sauce in hot butter until chicken is coated and heated through, 2 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Turn pizza dough out onto a generously floured surface. Roll dough into a 12-inch round. Brush dough with 1 tablespoon oil and sprinkle with 1 cup mozzarella cheese, leaving a 1-inch border. Spread chicken mixture over cheese; top with remaining 1 cup cheese."
    },
    {
      "position": 5,
      "text": "Fold pizza dough in half and pinch edges together to seal. Transfer calzone to the prepared pan and brush the top with remaining 1 tablespoon oil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crust is golden brown, 17 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

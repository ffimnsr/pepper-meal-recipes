  "id": "617b33dc-4b05-5c10-bf9a-a5c955d1f615",
  "slug": "tabbouleh-i",
  "name": "Cucumber Tabbouleh",
  "recipe_type": "salad",
  "brief_description": "The combination of nutty cracked wheat or bulgur mixed with cucumber, wonderfully ripe tomatoes, green onions, and lots of fresh mint and parsley is sensational. A bit of olive oil and lemon juice finish it off beautifully.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine bulgur and boiling water in a large bowl. Cover, and set aside to soak for 1 hour."
    },
    {
      "position": 2,
      "text": "Add oil, lemon juice, onions, parsley, mint, tomatoes, and cucumber; toss to combine. Season to taste with salt and black pepper. Cover, and refrigerate for at least 1 hour."
    }
  ],
  "servings": 8,

  "id": "768355bf-f844-5129-9c53-c700554d5369",
  "slug": "smoked-salmon-asparagus-frittata",
  "name": "Smoked Salmon-Asparagus Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Potatoes, smoked salmon, asparagus, and red onion combine to make a flavor-packed frittata that's sure to impress any brunch guest!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain and let cool."
    },
    {
      "position": 2,
      "text": "Whisk 10 eggs in a bowl. Add hot sauce, chopped tarragon, chopped chives, lemon zest, salt, and pepper to eggs and whisk."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Dice potatoes once cooled."
    },
    {
      "position": 4,
      "text": "Heat an ovenproof pan on medium-high heat and add olive oil. Add onions, potatoes, and asparagus to pan and saute for 2 minutes. Reduce heat to medium. Add egg mixture to pan. Stir in smoked salmon and Gruyere cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes or until eggs puff up. Cool for a few minutes and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "3c57e48c-7ee2-5edd-a30e-1cefffe9c0cc",
  "slug": "ultimate-cowboy-breakfast-sliders-recipe-8674868",
  "name": "Ultimate Cowboy Breakfast Sliders",
  "recipe_type": "breakfast",
  "brief_description": "The ultimate cowboy breakfast sliders are made by baking a rectangular slab of sausage, a 9x13-inch pan of eggs, and then layering them with cheese inside a package of Hawaiian rolls. The sliders are then baked again until golden.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 9x13-inch rimmed baking sheet with foil. Press sausage to the sides of the pan, or to a rectangular shape just larger than the shape of the Hawaiian rolls."
    },
    {
      "position": 2,
      "text": "Bake sausage in the preheated oven for 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, coat a second 9x13-inch baking dish heavily with cooking spray. Crack eggs into the prepared pan. Use a knife to break the yolks of each egg and slightly spread the yolks. Drizzle cream over eggs; sprinkle with salt and pepper."
    },
    {
      "position": 4,
      "text": "Bake eggs in the oven on another rack, leaving the sausage in the oven to continue baking, until eggs are set, 5 to 7 minutes. Remove eggs from oven and turn the oven\u2019s broiler to High."
    },
    {
      "position": 5,
      "text": "Broil sausage until browned on top, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Slice Hawaiian rolls in half lengthwise and spread 1 tablespoon Cowboy Butter on the bottom halves of the rolls. Drain sausage and place sausage patty on rolls. Carefully slide eggs from pan onto sausage and trim off any excess, if desired. Sprinkle evenly with green onions and top with cheese slices and top halves of rolls. Place rolls in the baking dish and spread tops evenly with remaining butter."
    },
    {
      "position": 7,
      "text": "Bake until butter is melted and rolls are lightly browned and toasted, about 5 minutes. Cut into 12 servings and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "efb08959-2d19-51e4-a134-45d95c34af3d",
  "slug": "flat-iron-steak-with-mushroom-sauce",
  "name": "Flat Iron Steak with Mushroom Sauce",
  "recipe_type": "main",
  "brief_description": "This flat iron steak with mushroom sauce recipe is comprised of tender slices of flat iron steak served with a creamy, flavorful wine and mushroom sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Season both sides flat iron steak with salt, black pepper, garlic powder, and onion powder. Heat a heavy, oven-proof skillet over medium-high heat; add 2 teaspoons vegetable oil and heat until oil shimmers. Add steak; sear until well browned, about 3 minutes per side. Transfer steak to a plate."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium; add remaining 1 teaspoon vegetable oil to skillet. Add mushrooms; cook and stir until wilted and browned, about 10 minutes. Reduce heat to medium-low; add wine to skillet and bring to a boil. Cook until wine is slightly reduced, 3 to 5 minutes; add beef stock and bring to a simmer."
    },
    {
      "position": 4,
      "text": "Mash butter and flour in a small bowl into a paste using a fork; stir into mushroom mixture and simmer until sauce is thickened, about 5 minutes. Return flat iron steak to the skillet."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven until steak is barely pink inside, about 10 minutes. Cut steak into thin slices on the diagonal against the grain; place on a platter."
    },
    {
      "position": 6,
      "text": "Stir cream into mushroom sauce until heated through, 1 to 2 minutes; pour over steak and garnish with chives."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

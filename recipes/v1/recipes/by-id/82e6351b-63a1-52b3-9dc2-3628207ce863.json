  "id": "82e6351b-63a1-52b3-9dc2-3628207ce863",
  "slug": "baked-apple-fritters-recipe-7504941",
  "name": "Baked Apple Fritters",
  "recipe_type": "dessert",
  "brief_description": "These baked apple fritters are soft and crunchy without frying, and the broiled vanilla glaze makes them extra crisp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together all-purpose flour, brown sugar, baking powder, cinnamon, nutmeg, and salt in a large bowl. Cut in butter with a pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Whisk milk, egg, and vanilla extract together in a cup. Stir into flour mixture just until combined; stir in chopped apple. Use a scoop or spoon to drop 1/4-cup mounds onto prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a skewer inserted near the center of fritter comes out clean, 11 to 12 minutes. Remove to a wire rack."
    },
    {
      "position": 5,
      "text": "Preheat the oven\u2019s broiler. Whisk together confectioner\u2019s sugar, milk, and vanilla extract. Brush a thin layer of glaze over fritters, and place under broiler."
    },
    {
      "position": 6,
      "text": "Broil fritters until glaze is bubbly, about 2 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 13,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

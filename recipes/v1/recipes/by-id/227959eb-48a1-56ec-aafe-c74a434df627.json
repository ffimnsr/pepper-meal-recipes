  "id": "227959eb-48a1-56ec-aafe-c74a434df627",
  "slug": "easy-oven-beef-tenderloin-recipe-11846864",
  "name": "Easy Oven Beef Tenderloin",
  "recipe_type": "main",
  "brief_description": "This easy oven beef tenderloin proves that this beautiful holiday centerpiece dish is within reach of any cook. All you need is a very hot oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Place tenderloin at room temperature about 30 to 45 minutes before cooking."
    },
    {
      "position": 2,
      "text": "Stir butter and soy sauce together; rub mixture over the entire tenderloin. Sprinkle evenly with salt and pepper on all sides. Place tenderloin on a foil-lined baking sheet. Fold the thin tail end underneath so that the tenderloin is at an even thickness."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 25 to 30 minutes or until desired degree of doneness (25 minutes will yield rare-medium rare). Let stand for 20 to 30 minutes before slicing and serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

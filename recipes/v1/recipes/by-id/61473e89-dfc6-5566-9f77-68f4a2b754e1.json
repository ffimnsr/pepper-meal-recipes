  "id": "61473e89-dfc6-5566-9f77-68f4a2b754e1",
  "slug": "monkey-bread-kabobs",
  "name": "Monkey Bread Kabobs",
  "recipe_type": "snack",
  "brief_description": "Thread cinnamon and sugar-coated biscuit dough onto skewers and finish off with a maraschino cherry for a new twist on monkey bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line three baking sheets and three cooling racks with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix white sugar, brown sugar, and cinnamon together in a large resealable bag."
    },
    {
      "position": 3,
      "text": "Cut each biscuit into four pieces. Dip each biscuit piece in melted butter; transfer to sugar mixture. Gently shake bag to coat biscuits in sugar mixture."
    },
    {
      "position": 4,
      "text": "Thread three biscuit pieces onto a skewer; add a maraschino cherry. Repeat with three more biscuit pieces, ending with a maraschino cherry. Repeat with remaining ingredients to make 20 kabobs. Arrange kabobs on the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until biscuits are cooked through, about 15 minutes. Flip kabobs halfway through cooking."
    },
    {
      "position": 6,
      "text": "Transfer kabobs to prepared wire racks and let cool."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

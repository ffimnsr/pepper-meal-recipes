  "id": "59450a23-d332-58f1-a1ed-34a5c65e0517",
  "slug": "artichoke-frittata",
  "name": "Artichoke Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This artichoke frittata made with Cheddar cheese and crumbled saltine crackers is a rich and delicious dish that\u2019s easy to make.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Drain artichoke hearts and reserve 3 tablespoons liquid. Chop artichoke hearts and set aside."
    },
    {
      "position": 2,
      "text": "Heat 3 tablespoons reserved liquid in a large skillet over medium heat. Add green onions; cook and stir until wilted, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Transfer green onions to a mixing bowl. Stir in artichoke hearts, Cheddar, eggs, crackers, parsley, garlic, hot sauce, salt, and pepper until well combined. Pour into a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the center is puffy and no longer moist, about 40 minutes. Cool slightly before cutting into 12 squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

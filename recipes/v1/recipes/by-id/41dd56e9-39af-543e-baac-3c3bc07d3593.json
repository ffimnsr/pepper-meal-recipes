  "id": "41dd56e9-39af-543e-baac-3c3bc07d3593",
  "slug": "beet-orange-and-apple-salad",
  "name": "Beet, Orange, and Apple Salad",
  "recipe_type": "salad",
  "brief_description": "This beet and orange salad with beet greens, apple, sunflower seeds, and raspberry vinaigrette is colorful, nourishing, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Wash and dry beets and greens. Shred greens to measure 2 cups and set aside."
    },
    {
      "position": 2,
      "text": "Place beets in a sauce pan with enough water to cover. Bring to a boil, cover, reduce heat and simmer for 20 minutes or until tender. Drain and allow to cool."
    },
    {
      "position": 3,
      "text": "Trim and peel skins off beets; cut into 8 wedges."
    },
    {
      "position": 4,
      "text": "Combine orange sections, beets, and apples in a bowl."
    },
    {
      "position": 5,
      "text": "Whisk olive oil, vinegar, sugar, salt and garlic together in a bowl; pour over beet mixture and toss well."
    },
    {
      "position": 6,
      "text": "Arrange 1/2 cup beet greens on 4 salad plates. Top with beet mixture, sprinkle with sunflower seeds and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ef3d8b01-06de-59c2-8e19-5b762ef442b8",
  "slug": "air-fryer-fingerling-potatoes",
  "name": "Air Fryer Fingerling Potatoes",
  "recipe_type": "side",
  "brief_description": "These air fryer fingerling potatoes take just 15 minutes to cook. They're golden and crispy on the outside and deliciously tender and creamy inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potato halves in a large bowl. Add olive oil, paprika, parsley, garlic powder, salt, and pepper; stir until evenly coated. Place potatoes in the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook in the preheated air fryer for 10 minutes; stir and cook until desired crispness is reached, about 5 more minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

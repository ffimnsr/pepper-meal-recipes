  "id": "c189fba7-4158-55e0-97d0-66d0be45adc6",
  "slug": "frikadeller-danish-meatballs",
  "name": "Frikadeller (Danish Meatballs)",
  "recipe_type": "main",
  "brief_description": "Frikadeller are Danish meatballs made with veal and pork that are shaped into slightly flattened ovals. This recipe comes straight from the old country.",
  "cuisine": "Danish Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix veal and pork together in a bowl until well combined. Stir in milk, onion, and egg. Mix in bread crumbs, then flour; knead well to mix. Mix in seltzer water, salt, and pepper until well combined. The mixture should be very moist, but not dripping. Cover and refrigerate for 15 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Form about 2 1/2 tablespoons meat mixture into a slightly flattened, oval meatball about the size of a small egg. Repeat to make remaining meatballs."
    },
    {
      "position": 3,
      "text": "Melt margarine in a large skillet over medium heat. Fry meatballs in the hot skillet until no longer pink in the center and well browned on the outside, about 15 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "711a7330-7fa8-5d12-b5a4-d106546e1ff6",
  "slug": "pad-thai",
  "name": "Pad Thai",
  "recipe_type": "main",
  "brief_description": "This simple pad thai recipe with chicken uses rice noodles and has a delicious sauce made with vinegar, sugar, fish sauce, and red pepper.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Soak rice noodles in cold water until soft, 30 to 50 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat butter in a wok; add chicken and saut\u00e9 until browned. Remove chicken and set aside."
    },
    {
      "position": 4,
      "text": "Heat oil in the wok over medium-high heat. Crack eggs into hot oil and cook until firm. Stir in chicken and cook for 5 minutes."
    },
    {
      "position": 5,
      "text": "Add softened noodles, sugar, fish sauce, vinegar, and red pepper; mix well until noodles are tender. Adjust seasonings to taste."
    },
    {
      "position": 6,
      "text": "Stir bean sprouts into wok and cook for 3 minutes."
    },
    {
      "position": 7,
      "text": "Serve topped with green onions, crushed peanuts, and a wedge of lemon."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

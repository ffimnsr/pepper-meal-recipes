  "id": "fd9dd64a-ad21-5beb-97c5-4b5b29775854",
  "slug": "butter-lamb-gravy",
  "name": "Butter Lamb Gravy",
  "recipe_type": "main",
  "brief_description": "Lamb is simmered in a spicy tomato curry enriched with cream. This is a very mouthwatering dish that is easy to make. Serve with hot cooked rice or your favorite bread.",
  "cuisine": "Pakistani",
  "instructions": [
    {
      "position": 1,
      "text": "Season the lamb with garam masala and salt. Heat 1 tablespoon of butter in a large skillet over medium heat. Fry the lamb cubes until browned, stirring constantly. Remove from the skillet and set aside."
    },
    {
      "position": 2,
      "text": "Melt the remaining butter in the same skillet over medium heat. Add the onion; cook and stir until the onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in the turmeric, ginger, and garlic. Cook and stir for 1 minute. Stir in the cayenne and tomato paste until well blended, then stir in the water. Bring to a simmer and return lamb to the skillet. Simmer over low heat for about 20 minutes, or until lamb is tender."
    },
    {
      "position": 4,
      "text": "Stir in the cream and honey. Transfer to a serving dish and garnish with cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

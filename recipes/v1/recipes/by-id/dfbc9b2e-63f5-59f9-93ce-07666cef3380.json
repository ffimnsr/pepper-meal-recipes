  "id": "dfbc9b2e-63f5-59f9-93ce-07666cef3380",
  "slug": "air-fryer-cinnamon-roll-bites-recipe-8553617",
  "name": "Air Fryer Cinnamon Roll Bites",
  "recipe_type": "dessert",
  "brief_description": "For these air fryer cinnamon roll bites, refrigerated cinnamon rolls are cut into bites, air fried, tossed in cinnamon sugar, and served with an orange-flavored creamy dip. They\u2019re kid-sized and just a fun way to serve cinnamon rolls.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 325 degrees F (165 degrees C) according to manufacturer\u2019s instructions. Add sugar and cinnamon to a large resealable plastic bag, and shake to combine."
    },
    {
      "position": 2,
      "text": "Remove the 8 cinnamon rolls from the can, and set icing aside. Cut each roll into 4 equal pieces for a total of 32 bites."
    },
    {
      "position": 3,
      "text": "Line the fryer basket with parchment paper. Place the bites in a single layer in the bottom of the basket, cook for 3 minutes, turn over using tongs, and cook until golden brown, another 2 to 3 minutes. Depending on the brand and size of your air fryer, you may have to cook in batches, and your timing may vary, so watch closely."
    },
    {
      "position": 4,
      "text": "Meanwhile, prepare the dip. Add cream cheese, confectioner\u2019s sugar, orange zest, orange juice, and the packaged icing to a small bowl. Beat with an electric mixer on medium speed until you reach a dipping consistency, about 1 minute."
    },
    {
      "position": 5,
      "text": "Drop the warm pieces into the sugar-cinnamon mixture, and shake. Transfer to a plate or basket, and serve with the dip."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "0addeaa8-63d1-5f62-a478-03e186d1eb25",
  "slug": "bolognese-stuffed-bell-peppers",
  "name": "Bolognese Stuffed Bell Peppers",
  "recipe_type": "main",
  "brief_description": "A rich Italian-style meat and tomato filling is mixed with rice or orzo, and baked in bell peppers.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a skillet over medium heat. Stir in the carrots and celery; cook and stir until the vegetables are tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in ground beef and pancetta, and cook until browned and crumbled; drain off any excess liquid, and return to heat. Add marinara sauce, wine, and red pepper flakes, and simmer for 10 minutes. Stir in cream, half of the Parmesan cheese, and rice. Simmer 5 minutes more, or until most liquid has absorbed."
    },
    {
      "position": 4,
      "text": "Place peppers in a shallow baking dish, and fill with beef mixture. Drizzle with remaining olive oil and top with remaining Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, for 30 minutes in the preheated oven. Serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

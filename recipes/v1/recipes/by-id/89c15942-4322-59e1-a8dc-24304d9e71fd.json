  "id": "89c15942-4322-59e1-a8dc-24304d9e71fd",
  "slug": "2-ingredient-dog-treats",
  "name": "2-Ingredient Dog Treats",
  "recipe_type": null,
  "brief_description": "Just 2 ingredients (pureed carrot baby food and whole wheat flour) are all you need to make these quick and tasty dog treats.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix flour and baby food by hand in a medium bowl to form a stiff dough. Place dough onto a clean, lightly floured work surface. Dust a rolling pin with flour and roll the dough to a thickness of 1/8 inch. Cut into desired shapes and place onto the prepared baking sheets, leaving 1/2 inch between cookies."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes. Turn oven off and leave cookies inside for 30 minutes. Remove and transfer to wire racks to cool."
    }
  ],
  "servings": 38,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

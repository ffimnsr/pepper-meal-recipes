  "id": "672d680c-e180-5ca2-8cb4-4a18704b2822",
  "slug": "easy-homemade-shrimp-fried-rice",
  "name": "Easy Shrimp Fried Rice",
  "recipe_type": "main",
  "brief_description": "Homemade shrimp fried rice is easy to make in one pan and ready in under 30 minutes for a takeaway favorite that's sure to please the whole family!",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat sesame oil and olive oil in a large nonstick skillet or wok over medium-high heat. Add shrimp; cook until bright pink outside and meat is opaque, about 3 minutes, flipping halfway through."
    },
    {
      "position": 2,
      "text": "Transfer shrimp to a plate using a slotted spoon, allowing oils and cooking juices to remain in the skillet. Set aside."
    },
    {
      "position": 3,
      "text": "Add peas and carrots and corn to the skillet; cook, stirring intermittently, until vegetables begin to soften, about 2 minutes. Add garlic; cook and stir for 1 minute. Push vegetables to the side of the skillet, add eggs to the other side; cook to scramble, stirring as necessary, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Add shrimp, rice, and green onions to the skillet; stir. Drizzle with soy sauce; season with salt and pepper. Stir to combine. Cook until shrimp is reheated, about 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

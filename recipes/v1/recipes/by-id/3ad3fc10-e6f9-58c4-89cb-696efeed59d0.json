  "id": "3ad3fc10-e6f9-58c4-89cb-696efeed59d0",
  "slug": "zucchini-carrot-banana-whole-wheat-bread",
  "name": "Zucchini-Carrot-Banana Whole Wheat Bread",
  "recipe_type": "dessert",
  "brief_description": "This zucchini-carrot-banana whole wheat bread recipe is packed with zucchini, carrot, and banana. Freeze it so you have an instant snack at the ready.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan."
    },
    {
      "position": 2,
      "text": "Mash banana in a large bowl; whisk in eggs, sugar, honey, oil, and vanilla extract."
    },
    {
      "position": 3,
      "text": "Combine whole wheat flour, all-purpose flour, cinnamon, baking soda, baking powder, and salt in a separate bowl; stir into banana mixture until batter is moistened."
    },
    {
      "position": 4,
      "text": "Stir zucchini, carrot, and chocolate chips into batter until evenly distributed; pour into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a knife inserted into center comes out clean, 50 to 60 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

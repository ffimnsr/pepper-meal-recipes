  "id": "2b0f036a-fc6a-5a49-99d9-5716ad3fcee8",
  "slug": "jalapeno-poppers-of-champions",
  "name": "Jalapeno Poppers of Champions",
  "recipe_type": "appetizer",
  "brief_description": "Jalapeno pepper halves are filled with cream cheese, wrapped with meatless bacon strips and baked to delicious football-lovin\u2019 perfection!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Fill each jalapeno half with cream cheese. Wrap 1 bacon strip around each jalapeno half and secure with a toothpick. Arrange wrapped jalapenos on baking sheet."
    },
    {
      "position": 3,
      "text": "Bake 12 minutes in preheated oven, or until bacon strips are crisp. Serve warm."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,

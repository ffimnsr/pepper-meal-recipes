  "id": "627b40bf-3611-50dd-a0e8-f6f07d01ed87",
  "slug": "butternut-squash-cheesecake-recipe-8386823",
  "name": "Butternut Squash Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This butternut squash cheesecake is the perfect dessert for Thanksgiving or the holidays\u2014it\u2019s lighter, more flavorful, and just as rich and decadent as its pumpkin cheesecake cousin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Oil a 10-inch springform pan, line with parchment, and set aside. Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Cut butternut squash into thick crosswise slices, remove seeds, and place on the lined baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until very soft, about 1 hour. When cool enough to handle, separate the flesh from the skin; discard skin. Mash squash until smooth, measure out 1 1/2 cups, and set aside to cool completely. Reserve any remaining squash for another use."
    },
    {
      "position": 4,
      "text": "Increase the oven temperature to 425 degrees F (220 degrees C)."
    },
    {
      "position": 5,
      "text": "Add softened cream cheese, sugar, flour, and salt to a bowl, and cream together with a spatula until very smooth."
    },
    {
      "position": 6,
      "text": "Add maple syrup, 1 1/2 cups mashed butternut squash, cinnamon, ginger, and nutmeg. Mix with an electric mixer or whisk until combined; mix in vanilla. Add eggs, one at a time, beating well after each addition. Stir in cream."
    },
    {
      "position": 7,
      "text": "Pour batter into prepared springform pan. Tap the pan lightly on the counter to settle the batter."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until cheesecake is almost fully set, 50 to 60 minutes. The center should wiggle very slightly If the pan is shaken back and forth. If the center seems soupy, continue baking for a few more minutes."
    },
    {
      "position": 9,
      "text": "Remove and let cool for 5 minutes. Run a thin knife between the outside edge of the cheesecake and the inside of the springform ring to release cheesecake from the ring; it will contract as it cools. Let cool 30 minutes more, then remove outside ring."
    },
    {
      "position": 10,
      "text": "Refrigerate cheesecake for a few hours or up to overnight before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 15,

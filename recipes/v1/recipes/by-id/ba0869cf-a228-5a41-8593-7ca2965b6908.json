  "id": "ba0869cf-a228-5a41-8593-7ca2965b6908",
  "slug": "oven-roasted-pulled-pork-and-barbecue-sauce-recipe-11863328",
  "name": "Oven Roasted Pulled Pork and Barbecue Sauce",
  "recipe_type": "main",
  "brief_description": "This oven roasted pulled pork is a reliably delicious, fork-tender meal that never fails, because it's Grandmother's tried-and-true recipe. With a quickly simmered barbecue sauce, you'll enjoy every sumptuous bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (235 degrees C). Use a small paring knife to make 6 to 8 slits in the pork. Press a garlic clove into each cut."
    },
    {
      "position": 2,
      "text": "Season pork evenly all over with salt and pepper. Place pork in a metal pan or cast iron Dutch oven."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until well browned, about 30 minutes. Remove pork from the oven and reduce heat to 325 degrees F (165 degrees C)"
    },
    {
      "position": 4,
      "text": "Add 3/4 cup water and scrape up any bits from the bottom of the pan. Cover with foil."
    },
    {
      "position": 5,
      "text": "Return to the oven to bake until fork tender, about 2 1/2 hours. Let pork stand for 20 minutes before shredding."
    },
    {
      "position": 6,
      "text": "Meanwhile, for the sauce, combine ketchup, tomato sauce, white vinegar, apple cider vinegar, brown sugar, white sugar, salt, pepper, and hot sauce in a small saucepan and bring to a simmer, stirring often. Cook for 10 to 15 minutes. Adjust seasoning to taste."
    },
    {
      "position": 7,
      "text": "Serve sauce with shredded pork."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

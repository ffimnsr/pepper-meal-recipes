  "id": "2dfbcb2f-0a5c-59d7-b96f-7c7c02c66712",
  "slug": "stuffed-jalapeno-firecrackers",
  "name": "Stuffed Jalape\u00f1o Firecrackers",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for yummy cheese-stuffed jalape\u00f1o firecrackers, with spicy hot bacon and Cajun seasoning is perfect for those who can handle the heat!",
  "cuisine": "American Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Fill jalape\u00f1os with cream cheese; sprinkle with Cajun seasoning. Wrap each stuffed jalape\u00f1o with 1 halved strip bacon; secure with a toothpick. Arrange wrapped jalape\u00f1os in a single layer, stuffed-sides down, on a broiler pan."
    },
    {
      "position": 3,
      "text": "Broil in the preheated oven until bacon is crisp, 8 to 15 minutes per side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b93a8bc7-ccef-53ef-8371-9c9e07a25686",
  "slug": "unstuffed-peppers-recipe-11972625",
  "name": "Unstuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These unstuffed peppers have all the glorious flavors of stuffed peppers in a skillet dinner, and it's so much easier to make. It's a comfort dish your family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a pot over medium heat and saut\u00e9 bell peppers and onion until tender, about 5 minutes. Remove from heat and set aside."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cook and stir pork sausage and beef in the hot skillet, breaking up clumps with a spatula, until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Stir in tomato paste, crushed tomatoes, basil, minced garlic, onion powder, garlic powder, and parsley. Mix until well combined."
    },
    {
      "position": 5,
      "text": "Add in the cooked peppers and onion, cooked rice, pasta sauce, and half of the cheese, then stir. Top with remaining mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the cheese melts, about 5 minutes. Top with fresh basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

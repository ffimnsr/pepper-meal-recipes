  "id": "f4526178-d661-5ecf-ad6c-1eba962559e3",
  "slug": "skillet-corn-bread",
  "name": "Skillet Cornbread",
  "recipe_type": "side",
  "brief_description": "This tasty skillet cornbread is simple to make with cornmeal, eggs, butter, milk, and a trusty cast iron skillet for a delicious side to any meal.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place a 9-inch cast iron skillet into the oven and preheat to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix milk and cornmeal together in small bowl. Let soak for 10 minutes."
    },
    {
      "position": 3,
      "text": "Sift flour, baking powder, and salt together into a mixing bowl. Add cornmeal mixture, eggs, and butter; beat until a smooth batter forms, about 1 minute."
    },
    {
      "position": 4,
      "text": "Remove the hot skillet from the oven. Add vegetable oil to the skillet and swish to coat. Pour out any excess oil, then pour batter into the skillet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 18 to 23 minutes. Cut into wedges to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "5e1743a1-819d-568b-885f-74237b6cc152",
  "slug": "guinness-beer-cheese-dip",
  "name": "Guinness Beer Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "This savory beer cheese dip made with Velveeta and flavored with salsa, stout beer, chili, and cayenne is a superb spicy warm dip perfect for parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat cheese in slow cooker on High until melted, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir beer, salsa, Worcestershire sauce, chili powder, onion powder, and cayenne pepper into cheese until smooth and heated through, stirring frequently, about 10 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,

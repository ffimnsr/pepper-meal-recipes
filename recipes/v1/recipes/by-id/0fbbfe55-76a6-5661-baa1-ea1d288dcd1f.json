  "id": "0fbbfe55-76a6-5661-baa1-ea1d288dcd1f",
  "slug": "green-lentil-gumbo-soup-recipe-7968859",
  "name": "Green Lentil \u201cGumbo\u201d Soup",
  "recipe_type": "soup",
  "brief_description": "We're making green lentil \"gumbo\" soup with the same things we put in gumbo, except the signature roux. This delicious soup is gluten-free, dairy-free, and much lower in fat, and the lentils act as the thickener. The best part is that it has all the gumbo flavor you love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add andouille to a dry soup pot and place over medium heat. Cook, stirring, until sausage begins to brown, a few minutes."
    },
    {
      "position": 2,
      "text": "Add all the olive oil, unless a lot of fat was rendered from the sausage, in which case adjust the amount of oil added."
    },
    {
      "position": 3,
      "text": "Add onion, green pepper, celery, and 1/4 teaspoon salt. Cook, stirring, until onions turn translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add paprika, cumin, black pepper, thyme, oregano, and bay leaf. Cook, stirring, for 2 minutes more."
    },
    {
      "position": 5,
      "text": "Stir in broth, raise heat to high, and bring to a simmer. Reduce heat to medium low and stir in chicken, ham, and sliced okra."
    },
    {
      "position": 6,
      "text": "Cook for 10 minutes, then stir in lentils. Simmer soup, stirring occasionally, until lentils are tender, about 1 hour."
    },
    {
      "position": 7,
      "text": "Stir in Worcestershire sauce, hot sauce, parsley, and green onions, and cook for another few minutes. Season to taste with salt. Serve with rice, more green onions, and a shake of cayenne."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,

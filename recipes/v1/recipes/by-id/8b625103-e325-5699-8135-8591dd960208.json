  "id": "8b625103-e325-5699-8135-8591dd960208",
  "slug": "grilled-romaine-caesar-salad-recipe-12035652",
  "name": "Grilled Romaine Caesar Salad",
  "recipe_type": "salad",
  "brief_description": "Add smoky flavor to classic Caesar salad by grilling hearts of romaine. The sturdy green holds up to the heat of the grill, resulting in tender yet weighty knife-and-fork bites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill to medium-high heat (375 degrees F to 400 degrees F/180 degrees C to 200 degrees C). You can also use a stovetop grill pan set over medium-high heat."
    },
    {
      "position": 2,
      "text": "For dressing, mince 2 garlic cloves and transfer to a small bowl. Add mayonnaise, 2 tablespoons Parmesan cheese, anchovies, Worcestershire, mustard, and 1/4 teaspoon each salt and pepper; whisk well to combine."
    },
    {
      "position": 3,
      "text": "Brush cut sides of romaine, bread slices, and lemons with olive oil."
    },
    {
      "position": 4,
      "text": "Lightly oil grill grates (or pan). Place romaine, bread slices, and lemon halves, cut sides down, on grill. Grill lemon halves until lightly charred, 3 to 4 minutes. Grill bread, turning halfway through, until toasted, 2 to 4 minutes. Grill romaine until lightly charred, 1 to 2 minutes. Do not turn romaine halves. (If using a pan, grill in batches.)"
    },
    {
      "position": 5,
      "text": "For croutons, rub remaining garlic clove over cut sides of toast. Cut toast into bite-size cubes."
    },
    {
      "position": 6,
      "text": "Squeeze juice from 1 grilled lemon half. Whisk into dressing."
    },
    {
      "position": 7,
      "text": "Arrange romaine on a large serving platter. Sprinkle with remaining 4 tablespoons Parmesan and 1/4 teaspoon each salt and pepper. Top with croutons. Serve with dressing and remaining grilled lemon halves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

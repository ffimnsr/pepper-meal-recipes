  "id": "a519390c-d014-5dae-a8bd-38032aae9033",
  "slug": "libbys-famous-pumpkin-pie",
  "name": "Libby's Famous Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "Libby's pumpkin pie with evaporated milk is a classic, no-fail holiday dessert that's so easy to make! It's been enjoyed by families for years.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine sugar, cinnamon, salt, ginger, and cloves in small bowl."
    },
    {
      "position": 3,
      "text": "Beat eggs lightly in large bowl."
    },
    {
      "position": 4,
      "text": "Stir in pumpkin and sugar-spice mixture."
    },
    {
      "position": 5,
      "text": "Gradually stir in evaporated milk. Pour into pie shell."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. Reduce temperature to 350 degrees F (175 degrees C) and continue to bake until a knife inserted near the center comes out clean, 40 to 50 more minutes. Remove from the oven and set on a wire rack to cool to room temperature."
    },
    {
      "position": 7,
      "text": "Serve cooled pie immediately or refrigerate until ready to serve. (Do not freeze as this will cause the crust to separate from the filling.)"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

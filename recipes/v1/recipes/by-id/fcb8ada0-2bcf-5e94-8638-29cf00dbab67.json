  "id": "fcb8ada0-2bcf-5e94-8638-29cf00dbab67",
  "slug": "broccoli-cheddar-mac-and-cheese-recipe-8551735",
  "name": "Broccoli Cheddar Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This broccoli Cheddar mac and cheese recipe adds veggies to a classic pasta dish. Cheddar and Parmesan cheese make this mac and cheese extra cheesy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add 4 cups water and soup base to a large saucepan over medium-high heat; stir to dissolve soup base. Stir in evaporated milk, whipping cream, Worcestershire sauce, Dijon mustard, paprika, cayenne, and pinch salt."
    },
    {
      "position": 2,
      "text": "Add in pasta, cover, and bring to a boil. Reduce heat to medium-low, and cook, stirring frequently, until pasta is tender with a bite, 8 to 11 minutes. Stir in Cheddar cheese and Parmesan cheese; allow to melt into the sauce."
    },
    {
      "position": 3,
      "text": "Place broccoli and 3 tablespoons water In a microwave-safe container. Cover; steam broccoli on High in the microwave until tender, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Drain broccoli florets and add to pasta, gently toss to coat, and season to taste with salt and pepper. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0a75578b-2275-5dc5-8874-a7fedf3cdb30",
  "slug": "cheesy-hash-browns",
  "name": "Cheesy Hash Browns",
  "recipe_type": "soup",
  "brief_description": "These cheesy hash browns are baked with sour cream, onion, cream of chicken soup, Colby cheese, and melted butter, all topped with crushed cornflakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together hash brown potatoes, sour cream, onion, cream of chicken soup, Colby cheese, and melted butter in a bowl until well combined; season with salt and black pepper. Transfer mixture to a 9x13-inch baking dish and sprinkle the top with cornflake crumbs."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until casserole is bubbling, about 1 hour."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

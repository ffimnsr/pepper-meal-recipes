  "slug": "sous-vide-dulce-de-leche",
  "name": "Sous Vide Dulce de Leche",
  "recipe_type": "dessert",
  "brief_description": "With the sous vide technique, water heated to 185 degrees F slowly transforms sweetened condensed milk into luscious dulce de leche.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set a sous vide precision cooker to 185 degrees F (85 degrees C) according to manufacturer's directions."
    },
    {
      "position": 2,
      "text": "Pour sweetened condensed milk into the jar and seal. Immerse in the water bath for 14 hours."
    },
    {
      "position": 3,
      "text": "Cool in the refrigerator for 1 hour before serving."
    }
  ],

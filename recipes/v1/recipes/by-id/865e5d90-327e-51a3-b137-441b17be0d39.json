  "id": "865e5d90-327e-51a3-b137-441b17be0d39",
  "slug": "saint-paddys-irish-sandwich",
  "name": "Saint Paddy's Irish Sandwich",
  "recipe_type": "main",
  "brief_description": "Toasted sliced-sourdough, shredded corned beef, fancy mustard, and shredded cabbage in a light vinaigrette make this sandwich to die for--and not just on Saint Paddy's Day.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place corned beef in large pot or Dutch oven and cover with water. Add the spice packet that came with the corned beef. Cover pot and bring to a boil, then reduce to a simmer. Simmer approximately 50 minutes per pound until tender. Remove meat and let rest 15 minutes. Slice meat across the grain."
    },
    {
      "position": 2,
      "text": "Whisk together olive oil, balsamic vinegar, mustard, salt, and pepper in small bowl. Place the shredded cabbage in a large bowl and pour the dressing over it; toss to coat the cabbage with the dressing."
    },
    {
      "position": 3,
      "text": "Spread a layer of mustard on 6 slices of toasted bread. Place some shredded cabbage and corned beef on each slice and top with remaining slices of bread."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 15,
  "difficulty": "expert",

  "id": "e77cf203-e357-50c5-a2fe-476af434a3a3",
  "slug": "one-pan-coconut-chicken-ramen-bake-recipe-11852565",
  "name": "One-Pan Coconut Chicken Ramen Bake",
  "recipe_type": "main",
  "brief_description": "This one pan coconut chicken ramen bake has the complex flavor of a red curry with the ease of a casserole. Stir the sauce together right in the baking dish, add chicken and ramen, and bake.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk coconut milk, water, soy sauce, curry paste, garlic, ginger, and sesame oil together in a 9x13-inch baking dish. Reserve 3 tablespoons green onions for topping and add remaining onion to baking dish. Add chicken pieces and 1 spice packet from the ramen; discard remaining seasoning packets. Toss chicken to coat."
    },
    {
      "position": 3,
      "text": "Add ramen noodles and nestle them into the coconut milk mixture with the chicken pieces surrounding them, taking care to make sure the chicken is not underneath the noodles. Cover the dish with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 22 to 24 minutes. Flip noodles over to submerge the second side, cover, and bake for another 5 minutes."
    },
    {
      "position": 5,
      "text": "Toss everything together until well combined with the sauce and sprinkle with reserved green onions. Serve with Sriracha."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "585da691-6b1d-5995-b519-7bec5721e88e",
  "slug": "roasted-peppers-in-oil-peperoni-arrostiti-sotto-olio",
  "name": "Roasted Peppers in Oil (Peperoni Arrostiti Sotto Olio)",
  "recipe_type": "appetizer",
  "brief_description": "These colorful roasted red peppers in oil are seasoned with garlic, basil, and oregano. Try them on sandwiches, pasta, or alone as a pretty side dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate. Reduce grill heat to medium."
    },
    {
      "position": 2,
      "text": "Grill whole red, yellow, and orange bell peppers on the preheated grill until charred on all sides, turning about every 5 minutes. Place charred peppers in a resealable plastic bag and seal well. Allow peppers to cool in the bag."
    },
    {
      "position": 3,
      "text": "Combine olive oil, garlic, basil, oregano, salt, and pepper in a 1-pint glass jar (or larger, depending on size of peppers)."
    },
    {
      "position": 4,
      "text": "Remove cooled peppers from the bag and scrape off charred skins. Cut peppers in half; remove seeds and stems. Slice peppers into long strips and place in oil mixture. Mix well, ensuring peppers are covered in oil."
    },
    {
      "position": 5,
      "text": "Serve, storing leftover peppers in the refrigerator for up to 5 days."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0fc07e3f-5067-50de-ad78-f9e6e8aa37be",
  "slug": "mezcal-hot-toddy-recipe-8717916",
  "name": "Mezcal Hot Toddy",
  "recipe_type": "drink",
  "brief_description": "This smoky cocktail can be made ahead of time and kept warm in a slow cooker so you can enjoy the party and keep your bartending duties to a minimum.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat water, orange juice, and pure maple syrup just to a boil in a Dutch oven. Remove from heat. Add 8 tea bags (or dried flowers). Cover and steep for 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Remove tea bags (or strain). Add mezcal and chile liqueur. Keep warm over very low heat or transfer to a slow cooker set to Keep Warm. Serve in mugs; garnish with orange slices studded with cloves."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

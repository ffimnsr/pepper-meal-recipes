  "id": "f7cf6de1-2bab-510d-bca1-e52198598d85",
  "slug": "oatmeal-cream-pies-with-chocolate",
  "name": "Oatmeal Cream Pies with Chocolate",
  "recipe_type": "dessert",
  "brief_description": "Oatmeal-chocolate chip cookies sandwich a creamy marshmallow filling in this easy made-from-scratch treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter, brown sugar, and white sugar in a large bowl; beat with an electric mixer until smooth creamy, 3 to 5 minutes. Beat in egg, 1 tablespoon milk, and 1 teaspoon vanilla extract."
    },
    {
      "position": 2,
      "text": "Mix oats, flour, cocoa powder, cinnamon, baking soda, baking powder, and salt together in a separate bowl. Beat into the creamed butter mixture on low speed. Fold in chocolate chips using a rubber spatula."
    },
    {
      "position": 3,
      "text": "Cover bowl with plastic wrap and refrigerate dough until firm enough to scoop, at least 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 5,
      "text": "Scoop small balls of dough onto the lined baking sheets using a small cookie scoop."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden, about 10 minutes. Let cookies sit on the baking sheets for 2 minutes. Transfer to a wire rack to cool completely."
    },
    {
      "position": 7,
      "text": "Combine cream cheese and vegetable shortening in a bowl; beat with an electric mixer until smooth. Add marshmallow cream, 2 teaspoons milk, and 1/2 teaspoon vanilla extract; mix well. Beat in confectioners' sugar, 1/4 cup at a time, until filling reaches a thick consistency."
    },
    {
      "position": 8,
      "text": "Scoop some of the filling onto the flat side of 1 cookie using the cookie scoop. Press another cookie on top to sandwich the filling. Repeat with remaining cookies and filling."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

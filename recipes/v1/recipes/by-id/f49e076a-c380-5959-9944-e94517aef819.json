  "slug": "basil-lemonade",
  "name": "Basil Lemonade",
  "recipe_type": "drink",
  "brief_description": "Give your lemonade a refreshing kick by adding fresh basil and a little lime.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir water, lemonade, sugar, and lime juice together in a pitcher. Add 1/2 cup basil leaves, stir to combine, cover the pitcher, and refrigerate until flavors combine, 8 hours to overnight. Remove basil leaves and discard."
    }
  ],

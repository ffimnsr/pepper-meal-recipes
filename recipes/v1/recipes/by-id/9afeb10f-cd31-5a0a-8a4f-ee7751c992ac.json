  "id": "9afeb10f-cd31-5a0a-8a4f-ee7751c992ac",
  "slug": "nanas-beef-stroganoff",
  "name": "Nana's Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "A traditional beef and mushroom Stroganoff with a touch of tomato and white wine is finished with sour cream for a great skillet dish to serve over rice or egg noodles.",
  "cuisine": "Russian",
  "instructions": [
    {
      "position": 1,
      "text": "Add 1 tablespoon flour and 1/2 teaspoon salt to a large, resealable plastic bag; shake to combine. Add beef; shake to coat."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a skillet over medium-high heat. Add beef; brown, about 3 minutes per side. Add mushrooms, onion, and garlic; cook and stir until garlic fragrant, 3 to 4 minutes. Transfer beef mixture to a bowl; leave drippings in skillet."
    },
    {
      "position": 3,
      "text": "Melt remaining 2 tablespoons butter in skillet over medium heat. Add 3 tablespoons flour; cook and stir until smooth. Stir in tomato paste, then whisk in beef stock. Cook and stir, constantly, until thickened and bubbling, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Return beef mixture to skillet; stir to coat with sauce. Reduce heat to very low; simmer until beef tender, 2 to 3 hours. The longer beef cooks, the more tender it will be. Stir sour cream and white wine into beef mixture just before serving; heat through. Do not boil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 140,
  "preparation_time_minutes": 20,

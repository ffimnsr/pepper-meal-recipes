  "id": "20c1350d-36d6-56c6-b9fe-217275e0693e",
  "slug": "apple-crisp-with-oat-topping",
  "name": "Easy Apple Crisp with Oat Topping",
  "recipe_type": "dessert",
  "brief_description": "This easy apple crisp bakes in the oven until golden brown and bubbly for a simple, fragrant, and deliciously sweet and crunchy fall dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss apples with white sugar and \u00bd teaspoon cinnamon in a medium bowl to coat; pour into a 9-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Mix brown sugar, oats, flour, and 1 teaspoon cinnamon in a separate bowl."
    },
    {
      "position": 4,
      "text": "Cut in cold butter with two knives or a pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 5,
      "text": "Spread over apples and pat down gently until even."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and sides are bubbling, about 40 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

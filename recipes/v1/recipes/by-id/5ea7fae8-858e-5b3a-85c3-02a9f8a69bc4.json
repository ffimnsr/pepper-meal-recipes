  "id": "5ea7fae8-858e-5b3a-85c3-02a9f8a69bc4",
  "slug": "greek-lentil-soup-fakes",
  "name": "Greek Lentil Soup (Fakes)",
  "recipe_type": "soup",
  "brief_description": "Greek lentil soup or fakes is an easy, nutritious soup with brown lentils and vegetables seasoned with herbs and garnished with olive oil and vinegar.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place lentils in a large saucepan; add enough water to cover by 1 inch. Bring water to a boil and cook for 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a saucepan over medium heat. Add onion, carrot, and garlic; cook and stir until onion has softened and turned translucent, about 5 minutes. Pour in lentils, then add 1 quart water, bay leaves, oregano, and rosemary. Bring to a boil. Cover and reduce heat to medium-low; simmer for 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in tomato paste; season with salt and pepper. Cover and simmer, stirring occasionally, until lentils have softened, 30 to 40 minutes. Add additional water if soup becomes too thick. Drizzle with olive oil and red wine vinegar to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

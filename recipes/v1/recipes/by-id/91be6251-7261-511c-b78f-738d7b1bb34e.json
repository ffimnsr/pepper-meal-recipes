  "id": "91be6251-7261-511c-b78f-738d7b1bb34e",
  "slug": "bruschetta-al-pomodoro",
  "name": "Bruschetta al Pomodoro",
  "recipe_type": "appetizer",
  "brief_description": "This bruschetta al pomodoro recipe with toasted Italian bread is a delicious way to use all the extra Roma tomatoes and basil growing in the garden.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven\u2019s broiler."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, basil, garlic, 1 tablespoon olive oil, oregano, pepper flakes, salt, and black pepper in a bowl; add more olive oil to coat salsa, if needed. Set aside for 10 minutes."
    },
    {
      "position": 3,
      "text": "Slice bread into \u00bd-inch-thick slices; arrange on a baking sheet in a single layer."
    },
    {
      "position": 4,
      "text": "Broil in the preheated broiler until lightly browned, about 1 minute per side."
    },
    {
      "position": 5,
      "text": "Spread tomato salsa on toasted bread slices; return to the oven. Broil until salsa is hot but not cooked, 2 to 3 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

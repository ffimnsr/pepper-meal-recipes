  "id": "1d6cb970-396a-55eb-bee6-3cd099f9de30",
  "slug": "portuguese-muffins-bolo-levedo",
  "name": "Portuguese Muffins - Bolo Levedo",
  "recipe_type": "dessert",
  "brief_description": "These are tasty English muffin-like breads from Titia Teolinda in St Micheal, the Azores. They're baked on a griddle, like pancakes.",
  "cuisine": "Portuguese",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, dissolve yeast in warm water with a pinch of the sugar. Set aside to ferment, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer the yeast mixture to a large bowl, and stir in the sugar, eggs, salt, flour, and milk until the dough comes together. Stir in the melted butter, then turn the dough out onto a floured surface, and knead for about 10 minutes, or until smooth and elastic. Cover dough with a cloth and set aside to rise until doubled in bulk, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Divide dough into about 15 to 20 pieces, and shape them into flat round cakes about 1/2 inch thick. Place a cloth on the table and dust it with flour. Arrange the cakes on the cloth, allowing space for rising. Allow them to set for 1 1/2 hours."
    },
    {
      "position": 4,
      "text": "Place the cakes in a heavy ungreased skillet, and cook over low heat. Fry the cakes on each side until golden."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

  "id": "97d45e59-01f6-5bc4-8b6e-5d1fd41a01e4",
  "slug": "grape-jelly-meatballs",
  "name": "Grape Jelly Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These grape jelly meatballs are made in the slow cooker with frozen cocktail meatballs, grape jelly, and chili sauce for an easy party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine grape jelly, chili sauce, and cayenne pepper in a saucepan over medium-high heat; cook until warm, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Place meatballs in a slow cooker and top with grape jelly mixture."
    },
    {
      "position": 4,
      "text": "Cook on Low for 3 to 4 hours."
    },
    {
      "position": 5,
      "text": "Serve warm and enjoy!"
    }
  ],
  "servings": 24,

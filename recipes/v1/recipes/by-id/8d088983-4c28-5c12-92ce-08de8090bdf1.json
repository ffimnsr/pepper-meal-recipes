{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "8d088983-4c28-5c12-92ce-08de8090bdf1",
  "slug": "breaded-pork-tenderloin",
  "name": "Breaded Pork Tenderloin",
  "recipe_type": "side",
  "brief_description": "Thin slices of breaded pork tenderloin are super tender and juicy on the inside, with a light, crunchy bread crumb coating flavored with garlic and oregano.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a 9x13-inch baking dish with aluminum foil."
    },
    {
      "position": 2,
      "text": "Slice tenderloin into 1/4-inch rounds. Pound each slice between sheets of plastic wrap until thin."
    },
    {
      "position": 3,
      "text": "Whisk milk and eggs together in a shallow dish. Whisk bread crumbs, oregano, garlic salt, oregano, salt, and pepper together in a second shallow dish. Dip tenderloins in egg mixture, then in bread crumb mixture until well coated."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium-high heat. Working in batches as necessary, fry breaded tenderloins in the hot skillet and until golden brown on both sides, 2 to 3 minutes per side; they will not be cooked through. Transfer browned tenderloins to the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Mix any leftover egg and bread crumb mixture together, then fry it in the hot skillet. Place into the baking dish with browned tenderloins. Cover the dish tightly."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until no longer pink in the center, about 45 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

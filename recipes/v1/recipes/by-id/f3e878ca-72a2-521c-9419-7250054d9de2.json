  "id": "f3e878ca-72a2-521c-9419-7250054d9de2",
  "slug": "peanut-butter-cookie-in-a-mug",
  "name": "Peanut Butter Cookie in a Mug",
  "recipe_type": "dessert",
  "brief_description": "Grandma's special recipe for peanut butter cookies in a mug is quick, easy, and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place butter and peanut butter in a microwave-safe mug. Microwave until butter and peanut butter are melted, about 30 seconds. Stir brown sugar, white sugar, and salt into butter mixture. Add egg; stir flour into mixture."
    },
    {
      "position": 2,
      "text": "Cook in the microwave until cookie is set, 2 to 4 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

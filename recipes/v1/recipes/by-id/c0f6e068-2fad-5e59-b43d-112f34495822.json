  "id": "c0f6e068-2fad-5e59-b43d-112f34495822",
  "slug": "no-bake-orange-creamsicle-bars-recipe-11956102",
  "name": "No-Bake Orange Creamsicle Bars",
  "recipe_type": "dessert",
  "brief_description": "These no-bake orange creamsicle bars layer a creamy citrus filling over a buttery graham cracker crust. The light summer dessert is reminiscent of the classic Good Humor ice cream truck favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9x9-inch baking dish with parchment paper. In a medium bowl, add the graham cracker crumbs, sugar, and melted butter to a bowl; mix with a fork until it resembles sand. Pour into the prepared pan and press evenly into the bottom of the pan with your fingers. Place in the refrigerator to chill, about 20 minutes."
    },
    {
      "position": 2,
      "text": "For orange filling, add orange gelatin to a bowl; pour in boiling water, and stir until dissolved. Stir in ice water, then place bowl in the refrigerator to cool for at least 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, beat cream cheese with a mixer in a bowl until smooth. Scrape bottom and sides of bowl down, then add confectioner's sugar. Beat again until well combined."
    },
    {
      "position": 4,
      "text": "Blend in cooled orange gelatin on low, until smooth with no cream cheese lumps. Fold in the whipped topping until completely combined, then place bowl back in the refrigerator."
    },
    {
      "position": 5,
      "text": "For creamy filling, add cream cheese to a clean bowl and beat until smooth. Add confectioner\u2019s sugar, vanilla extract, and orange extract. Beat until completely smooth. Fold in whipped topping."
    },
    {
      "position": 6,
      "text": "To assemble, pour half the creamy filling over graham cracker crust; smooth into an even layer with a spatula. Layer on orange filling and smooth out evenly. Add remaining creamy filling on top, and smooth into an even layer. Refrigerate for at least 4 hours."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

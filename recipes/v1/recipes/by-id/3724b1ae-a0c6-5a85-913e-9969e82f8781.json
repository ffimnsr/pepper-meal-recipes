  "id": "3724b1ae-a0c6-5a85-913e-9969e82f8781",
  "slug": "apple-oatmeal-crisp",
  "name": "Apple Oatmeal Crisp",
  "recipe_type": "dessert",
  "brief_description": "This apple crisp recipe with oats and melted butter features a crunchy crust on the top and bottom for a deliciously tasty apple dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square pan."
    },
    {
      "position": 3,
      "text": "Place brown sugar, oats, flour, and melted butter in a large bowl; mix until crumbly."
    },
    {
      "position": 4,
      "text": "Place 1/2 of the crumb mixture in the bottom of the prepared pan. Spread apples evenly over crumb mixture."
    },
    {
      "position": 5,
      "text": "Sprinkle with white sugar and cinnamon; top with remaining crumb mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until apples are bubbling and the top is crisp, golden brown, and caramelized around the edges, 40 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

  "id": "afa45e83-5be9-577a-99ae-cd463da1bfee",
  "slug": "vodka-lemonade-with-mint",
  "name": "Vodka Lemonade with Mint",
  "recipe_type": "drink",
  "brief_description": "This vodka lemonade with mint recipe combines vodka, lemon, and mint for a refreshing lemonade punch that you can whip up for a crowd all summer long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mint and sugar in a large bowl; stir in vodka and lemon juice. Cover the bowl with plastic wrap; refrigerate lemonade, 30 minutes to 2 hours."
    },
    {
      "position": 2,
      "text": "Strain lemonade into a pitcher. Fill six (6- to 8-ounce) glasses with crushed ice; add lemonade."
    }
  ],
  "servings": 6,

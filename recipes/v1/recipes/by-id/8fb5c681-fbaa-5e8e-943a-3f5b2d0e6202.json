  "id": "8fb5c681-fbaa-5e8e-943a-3f5b2d0e6202",
  "slug": "vegan-polenta",
  "name": "Vegan Polenta",
  "recipe_type": "side",
  "brief_description": "Serve this vegan polenta as a savory side to your meals. It goes very well with tomato-based dishes, beans, and sauteed mushrooms.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir together vegetable broth, 1/2 cup water, oat milk, and salt in a saucepan over medium-high heat. Bring to a boil. Reduce heat to medium-low and sprinkle in polenta, stirring constantly. Continue stirring until polenta thickens, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Reduce temperature to low and cook, stirring often, for about 10 minutes. Add vegan cheese and butter. Stir until smooth. Add remaining water, if necessary, to keep consistency velvety and smooth. Pour polenta onto an oiled plate and let stand a few minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

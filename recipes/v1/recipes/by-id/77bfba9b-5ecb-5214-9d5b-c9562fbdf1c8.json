{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "77bfba9b-5ecb-5214-9d5b-c9562fbdf1c8",
  "slug": "fall-off-the-bone-30-minute-instant-pot-ribs",
  "name": "Fall-off-the-Bone Instant Pot Ribs",
  "recipe_type": "dessert",
  "brief_description": "These tender Instant Pot ribs are sweet, spicy, and fall-off-the-bone delicious. They're ready in less than an hour for a family-pleasing dinner!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix brown sugar, chili powder, parsley, salt, garlic powder, pepper, cumin, onion powder, and paprika together in a bowl using a fork, breaking up any large clumps."
    },
    {
      "position": 3,
      "text": "Rub spice mixture over both sides of ribs."
    },
    {
      "position": 4,
      "text": "Place a steam rack inside a multi-functional pressure cooker (such as Instant Pot). Pour water and cider vinegar into the bottom of the pot."
    },
    {
      "position": 5,
      "text": "Lower ribs into the pot by curving them around the edge. Close and lock the lid. Select high pressure according to manufacturer's instructions; set the timer for 25 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 6,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 7,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil; place ribs on the foil. Top with barbecue sauce."
    },
    {
      "position": 8,
      "text": "Broil ribs until sauce is bubbling, about 3 minutes."
    },
    {
      "position": 9,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

  "id": "b2c297de-be6e-588d-b41a-7358b6c96e3e",
  "slug": "copycat-kfc-bowl-casserole-recipe-11869219",
  "name": "Copycat KFC Bowl Casserole",
  "recipe_type": "side",
  "brief_description": "This copycat KFC bowl casserole is pure comfort food, and easy to prepare. Mashed potatoes, layered with cheese, gravy, corn, chicken tenders, and baked in a casserole, are just as delicious as takeout.",
  "cuisine": "Copycat American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C) and spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread mashed potatoes in an even layer in the prepared baking dish. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Sprinkle evenly with half the cheese. Drizzle half the gravy over cheese. Sprinkle an even layer of corn; top with chicken, remaining cheese, and remaining gravy."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted, 15 to 20 minutes. Garnish with fresh parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

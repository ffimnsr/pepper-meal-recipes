  "id": "6bf409dc-4d0e-50f1-aa02-846d1aab59c4",
  "slug": "mangonada-jell-o-shots",
  "name": "Mangonada Jell-O Shots",
  "recipe_type": "drink",
  "brief_description": "If you like the popular Mexican mangonada treat, you'll love these shots made with vodka, chamoy, and Tajin.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat water and gelatin in a small saucepan over medium-high heat; whisk until dissolved, about 5 minutes. Add mango pur\u00e9e, sugar, and lemon juice; whisk until dissolved, about 5 minutes. Remove from heat to cool slightly, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Whisk vodka into cooled mango gelatin until combined."
    },
    {
      "position": 3,
      "text": "Add a few drops chamoy and a sprinkle Tajin to twenty (2-ounce) cups. Fill each cup evenly with mango gelatin and sprinkle with more Tajin. Let set in the refrigerator for 4 hours."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

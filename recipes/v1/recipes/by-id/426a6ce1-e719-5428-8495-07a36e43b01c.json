  "id": "426a6ce1-e719-5428-8495-07a36e43b01c",
  "slug": "crispiest-apple-crisp",
  "name": "Crispiest Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "Rolled oats and Grape Nuts make a crunchy topping for this classic apple crisp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss sliced apples with lemon juice to prevent browning."
    },
    {
      "position": 3,
      "text": "Combine flour, rolled oats, cereal nuggets, 1/2 cup melted butter, 1/4 cup white sugar, and 1/4 cup brown sugar in a large bowl; set aside."
    },
    {
      "position": 4,
      "text": "Melt remaining 2 tablespoons butter in a large skillet over medium heat. Stir in remaining 1/3 cup white sugar, remaining 1/3 cup brown sugar, and cinnamon until sugars begin to dissolve, 3 to 4 minutes. Add apples and water; cook and stir until apples soften and coated with sauce, 4 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Pour apple mixture into a 2-quart baking dish; sprinkle cereal nugget topping evenly over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until top browned and bubbling around edges, 25 to 30 minutes. Cool 10 to 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 22,
  "preparation_time_minutes": 15,

  "id": "4d7dc827-4d2a-56b0-829d-c53d53a034cb",
  "slug": "hot-honey-crispy-chicken-sheetpan-quesadillas-recipe-11867520",
  "name": "Hot Honey Crispy Chicken Sheetpan Quesadillas",
  "recipe_type": "main",
  "brief_description": "These crispy chicken quesadillas are baked in the oven on a sheet pan and served with a hot honey, chili, and lime dipping sauce. They're a quick way to make a bunch of quesadillas at once.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with foil or parchment paper and lightly coat with 1 tablespoon olive oil."
    },
    {
      "position": 2,
      "text": "Combine chicken, onion and taco seasoning in a skillet over medium and cook until onions are soft and chicken is cooked through. Remove from heat."
    },
    {
      "position": 3,
      "text": "Spoon 1/2 cup chicken mixture onto each tortilla. Sprinkle all over with about 1/4 cup cheese. Fold tortilla in half to make a quesadilla; place on prepared baking sheet. Repeat with remaining tortillas, meat and cheese. Brush tops of tacos with remaining oil."
    },
    {
      "position": 4,
      "text": "Bake tacos in the preheated oven, flipping halfway through, until lightly browned, toasted, and crisp around the edges, 10 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, whisk sour cream, honey, chili powder, lime juice, and cayenne together in a bowl until well combined."
    },
    {
      "position": 6,
      "text": "Serve quesadillas with hot honey dip and fresh cilantro."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "5d99f2f1-fc77-5f3e-a395-647af85d2827",
  "slug": "make-ahead-lunch-wraps",
  "name": "Make-Ahead Lunch Wraps",
  "recipe_type": "main",
  "brief_description": "These tasty make-ahead lunch wraps are filled with beans, corn, tomatoes, and cheese. Just make, freeze, and heat in the microwave as needed.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine rice and water in a saucepan and bring to a boil. Reduce the heat to low, cover, and simmer for 35 to 40 minutes, or until tender. Remove from the heat and let and cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, rinse black beans and pinto beans in a colander or strainer. Transfer beans to a large bowl. Mix in corn and diced tomatoes with green chiles, then mix in cooled rice and pepper Jack cheese."
    },
    {
      "position": 4,
      "text": "Divide mixture evenly among tortillas and roll up."
    },
    {
      "position": 5,
      "text": "Wrap individually in plastic wrap, place into a large freezer bag, and freeze. Reheat as needed in the microwave for lunch or snacks."
    },
    {
      "position": 6,
      "text": "Enjoy."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,

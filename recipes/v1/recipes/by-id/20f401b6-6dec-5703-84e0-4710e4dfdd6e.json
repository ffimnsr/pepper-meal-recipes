  "id": "20f401b6-6dec-5703-84e0-4710e4dfdd6e",
  "slug": "rosemary-bacon-pecans-recipe-12065430",
  "name": "Rosemary-Bacon Pecans",
  "recipe_type": "appetizer",
  "brief_description": "These rosemary-bacon pecans are smoky, savory, and lightly sweet, with crisp bacon and maple syrup complementing the rich, buttery nuts. Fresh rosemary and garlic add an aromatic, savory edge, while cayenne brings a gentle heat and flaky salt gives each crunchy bite a bright, salty finish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a 6-quart air fryer to 400 degrees F (200 degrees C) for 5 minutes. Line the air fryer basket with an air fryer liner."
    },
    {
      "position": 2,
      "text": "Arrange bacon in a single layer on liner; cook until bacon begins to brown, about 5 minutes. Turn bacon over and place rosemary sprig underneath. Continue cooking until bacon is browned and crisp, 4 to 5 minutes. Transfer bacon to a cutting board; discard rosemary sprig. Let bacon cool slightly."
    },
    {
      "position": 3,
      "text": "Measure 1 tablespoon drippings from bottom of air fryer into a large bowl; discard remaining drippings or reserve for another use. Stir pecans, maple syrup, garlic, cayenne pepper, salt, and chopped rosemary into drippings until evenly coated."
    },
    {
      "position": 4,
      "text": "Reduce air fryer temperature to 350 degrees F (180 degrees C). Spread pecan mixture in an even layer on air fryer liner. Air fry until pecans are toasted and fragrant, 6 to 7 minutes, stirring every 2 to minutes."
    },
    {
      "position": 5,
      "text": "Chop cooked bacon and stir into pecan mixture. Air-fry at 350 degrees F (180 degrees C) until bacon is heated through and pecans are glossy, about 1 minute."
    },
    {
      "position": 6,
      "text": "Spread pecan mixture in an even layer on a large rimmed baking sheet. Sprinkle with flaky sea salt. Let cool completely, about 15 minutes. Serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

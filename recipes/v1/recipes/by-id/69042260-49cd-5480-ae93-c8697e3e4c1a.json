  "id": "69042260-49cd-5480-ae93-c8697e3e4c1a",
  "slug": "bison-sausage-apple-and-sage-strata",
  "name": "Bison Sausage, Apple and Sage Strata",
  "recipe_type": "breakfast",
  "brief_description": "Autumn flavors of apple and sage are baked with bison breakfast sausage, eggs, and bread cubes in this delicious brunch strata.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F. Coat a 3-quart rectangular baking dish with cooking spray; set aside. Cook bison sausage and onion over medium heat in an extra-large skillet until bison sausage is brown. Add apple and cook for 5 more minutes. Drain off fat."
    },
    {
      "position": 2,
      "text": "Whisk eggs, milk, sage, and pepper in a large bowl."
    },
    {
      "position": 3,
      "text": "Place bread cubes in prepared baking dish. Top with bison sausage mixture and the cheese. Gently mix to evenly distribute ingredients. Pour egg mixture over bread mixture."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, for 40 to 45 minutes or until a knife inserted near the center comes out clean. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 42,
  "preparation_time_minutes": 30,

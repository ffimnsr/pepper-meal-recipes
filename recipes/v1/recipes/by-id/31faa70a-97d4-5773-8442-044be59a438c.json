  "id": "31faa70a-97d4-5773-8442-044be59a438c",
  "slug": "sour-cream-rhubarb-pie",
  "name": "Sour Cream Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "My whole family loves this sour cream rhubarb pie recipe that features a buttery cinnamon crumb topping. Serve warm with a side of vanilla ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat 1 \u00bc cups sugar, sour cream, eggs and 2 tablespoons flour together in a large bowl until smooth; stir in vanilla and salt. Fold in rhubarb until incorporated; pour filling into pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine \u2153 cup sugar, \u2153 cup flour, and cinnamon in a small bowl; cut in butter with a fork or pastry blender until mixture resembles coarse crumbs. Set topping aside."
    },
    {
      "position": 5,
      "text": "Remove pie from the oven. Reduce the oven temperature to 350 degrees F (175 degrees C). Sprinkle topping over pie. Bake until filling is set and topping is golden brown, about 30 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "f772533e-d906-5ccb-a882-0a2c0d2d40cb",
  "slug": "crispy-fried-fish",
  "name": "Crispy Fried Fish",
  "recipe_type": "main",
  "brief_description": "This fried fish recipe is made with cod fillets dipped in seasoned beer batter and coated in a spicy cornflake mixture, then deep-fried until golden.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat together beer, flour, egg, garlic powder, salt, and pepper in a medium bowl until smooth."
    },
    {
      "position": 3,
      "text": "Add cod fillets; stir gently until well coated."
    },
    {
      "position": 4,
      "text": "Mix together cornflake crumbs and Cajun seasoning in a separate medium bowl until well combined."
    },
    {
      "position": 5,
      "text": "Dip cod in cornflake mixture to thoroughly coat all sides."
    },
    {
      "position": 6,
      "text": "Heat oil in a large, heavy skillet or deep fryer to 365 degrees F (185 degrees C). Fry cod in hot oil until golden brown and flesh is easily flaked with a fork. Drain on a paper towel-lined plate."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

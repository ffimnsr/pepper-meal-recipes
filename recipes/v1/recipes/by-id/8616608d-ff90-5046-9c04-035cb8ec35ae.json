  "id": "8616608d-ff90-5046-9c04-035cb8ec35ae",
  "slug": "best-formula-three-cheese-fondue",
  "name": "Best Formula Three-Cheese Fondue",
  "recipe_type": "appetizer",
  "brief_description": "Three kinds of cheese make the best fondue: Gruy\u00e8re adds a nutty flavor, Cheddar adds tanginess, and Emmentaler blends the flavors together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat wine in a small saucepan over low heat until simmering."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a medium saucepan over medium-low heat. Whisk in flour until a thick paste forms."
    },
    {
      "position": 3,
      "text": "Whisk in wine until mixture is smooth. Gradually stir in Gruy\u00e8re, Cheddar, and Emmentaler cheese until melted, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer cheese mixture into fondue pot. Keep warm over a low flame."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "chef-johns-green-goddess-dressing",
  "name": "Chef John's Green Goddess Dressing",
  "recipe_type": "salad",
  "brief_description": "This green goddess dressing recipe makes a delicious creamy salad dressing flavored with parsley, tarragon, chives, lemon, garlic, and rice vinegar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Process mayonnaise, sour cream, parsley, tarragon, chives, lemon juice, rice wine vinegar, anchovy fillet, garlic, cayenne pepper, salt, and black pepper in a blender until smooth and pale green, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Enjoy!"
    }
  ],
  "servings": 16,

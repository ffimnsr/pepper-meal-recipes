  "id": "5aff4982-bb15-5433-8bd6-fe103432c126",
  "slug": "beef-au-jus",
  "name": "Beef au Jus",
  "recipe_type": "soup",
  "brief_description": "This easy au jus recipe from Chef John combines beef drippings with broth to make a rich and flavorsome au jus perfect for prime rib or for dipping.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt drippings in a skillet over medium-high heat. Whisk in flour and cook, whisking constantly, until the mixture thickens, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add beef broth gradually, whisking constantly, then increase heat to high and bring to a boil."
    },
    {
      "position": 4,
      "text": "Season with salt and pepper to taste. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "4163e1d0-84f8-5633-a815-218f0f626d33",
  "slug": "pineapple-stuffing",
  "name": "Pineapple Stuffing",
  "recipe_type": "dessert",
  "brief_description": "Pineapple stuffing made with crushed pineapple and bread cubes makes for a sweet and scrumptious side dish to serve with baked ham on the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Beat in eggs one at a time, then stir in crushed pineapple and bread cubes."
    },
    {
      "position": 4,
      "text": "Transfer mixture into prepared baking dish. Bake in the preheated oven until golden brown on top, about 50 minutes to 1 hour. Let stuffing stand for a few minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,

  "id": "c8f0e1d0-a82c-5409-8a1e-e1e11e24379c",
  "slug": "mexican-wedding-cookies",
  "name": "Mexican Wedding Cookies",
  "recipe_type": "dessert",
  "brief_description": "Delicious, nutty Mexican wedding cookies, a traditional treat that's rolled in powdered sugar and perfect for gift-giving and special occasions.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar in a medium bowl with an electric mixer until light and fluffy. Mix in vanilla and water. Add flour, almonds, and salt; beat on low speed until dough is just combined. Cover and chill for 1 to 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Shape chilled dough into 1-inch balls."
    },
    {
      "position": 4,
      "text": "Place 2 inches apart onto unlined cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 to 20 minutes. Remove cookies from the sheets and transfer to wire racks to cool, 20 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Place powdered sugar in a shallow bowl. Roll cooled cookies in powdered sugar to coat."
    },
    {
      "position": 7,
      "text": "Transfer to an airtight container and store at room temperature."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,

  "id": "b513f739-0eb5-57fa-8b5b-9b3698d6055f",
  "slug": "cheesy-potato-leek-soup",
  "name": "Cheesy Potato Leek Soup",
  "recipe_type": "soup",
  "brief_description": "This cheesy potato leek soup recipe with lots of Colby-Monterey Jack cheese is sure to become a weeknight family favorite this fall and winter!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter and olive oil in a large pot over medium-high heat; add leeks, onion, garlic, bay leaves, and coriander and saut\u00e9 until onions are softened and translucent, about 7 minutes. Add potatoes and chicken bouillon to the pot and pour enough chicken stock over the top to cover vegetables. Bring to a boil, reduce heat to medium-low and simmer, stirring occasionally, until vegetables are tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Mash potatoes to desired consistency with a potato masher. Stir Colby-Monterey Jack cheese and cream into potato mixture, return soup to a simmer, and cook until cheese melts and soup is hot, about 15 minutes more. Season with salt and pepper. Remove and discard bay leaves."
    },
    {
      "position": 3,
      "text": "Ladle soup into bowls and top with chives."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

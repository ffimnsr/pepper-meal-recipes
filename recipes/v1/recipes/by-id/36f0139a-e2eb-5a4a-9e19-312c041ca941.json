{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "36f0139a-e2eb-5a4a-9e19-312c041ca941",
  "slug": "instant-pot-carnitas-with-mango-salsa-recipe-7374995",
  "name": "Instant Pot Carnitas with Mango Salsa",
  "recipe_type": "dessert",
  "brief_description": "These Instant Pot carnitas tacos are crispy on the outside, tender on the inside, and cook in a fraction of the time it takes to make them traditionally. Serve with mango salsa for a sweet touch.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk chicken broth, orange juice, lime juice, garlic, cumin, oregano, salt, and pepper together in a bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Heat olive oil for 30 seconds, then add pork cubes and cook for 4 minutes. Using tongs, turn pork cubes over; cook 4 minutes more. Turn off Saute function."
    },
    {
      "position": 3,
      "text": "Pour chicken broth mixture over the pork. Close and lock the lid. Select High pressure according to manufacturer\u2019s instructions; set timer for 40 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, 20 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Meanwhile stir tomatoes, mango, jalape\u00f1o, red onion, cilantro, and salsa verde together in a bowl."
    },
    {
      "position": 6,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 7,
      "text": "Shred pork using 2 forks; transfer pork to a baking sheet. Ladle half of the juices from the Instant Pot over the pork. Toss to combine and spread out in an even layer onto the baking sheet."
    },
    {
      "position": 8,
      "text": "Broil pork for 8 minutes. Toss and broil 8 minutes more, or until desired crispness is reached."
    },
    {
      "position": 9,
      "text": "Divide pork between tortillas. Top with mango salsa. Serve with lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

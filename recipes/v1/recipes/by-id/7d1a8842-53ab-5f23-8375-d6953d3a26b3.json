  "id": "7d1a8842-53ab-5f23-8375-d6953d3a26b3",
  "slug": "peanut-butter-and-jelly-thumbprint-shortbread-cookies",
  "name": "Peanut Butter and Jelly Thumbprint Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These are just like the shortbread and jam cookies you know, but with the taste of peanut butter and grape jelly.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C); line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat the butter and sugar with an electric mixer in a large bowl until smooth; add the vanilla and continue to beat. Mix in the flour mixture until just incorporated. Roll dough into 1 1/2-inch balls and arrange on prepared baking sheets. Make a small hole in the center of each ball, using your thumb and finger; fill the holes with grape jam."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, about 14 minutes; allow to cool on baking sheet for 1 minute."
    },
    {
      "position": 4,
      "text": "Put the peanut butter in a microwave-safe bowl, and cook in a microwave oven until soft for 10 - 30 seconds, checking every 10 seconds. Be careful not to overheat the peanut butter; do not let it bubble. Stir the vegetable oil through the heated peanut butter; drizzle over the warm cookies."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

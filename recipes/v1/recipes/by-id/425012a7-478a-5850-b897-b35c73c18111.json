  "id": "425012a7-478a-5850-b897-b35c73c18111",
  "slug": "delicious-chicken-casserole",
  "name": "Delicious Chicken Casserole",
  "recipe_type": "soup",
  "brief_description": "Chicken and rice combine with cream of chicken soup and sour cream in this crowd-pleasing casserole topped with a buttery cracker crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Set a 9x13-inch casserole dish aside."
    },
    {
      "position": 2,
      "text": "Combine chicken breasts, celery, 1/2 teaspoon salt, 1/8 teaspoon black pepper, and enough water to cover in a large saucepan; bring to a boil. Cover, reduce heat to medium low; simmer for 35 minutes. Drain, reserving 1 cup liquid. Cool chicken, remove meat from bones, and cut into bite-size pieces; discard bones."
    },
    {
      "position": 3,
      "text": "Combine soup, reserved 1 cup cooking liquid, sour cream, celery salt, garlic powder, and onion powder; season with salt and black pepper. Stir in cooked chicken and rice; spoon into casserole dish."
    },
    {
      "position": 4,
      "text": "Shake crushed crackers and melted butter together in a resealable plastic bag; sprinkle over casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 to 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

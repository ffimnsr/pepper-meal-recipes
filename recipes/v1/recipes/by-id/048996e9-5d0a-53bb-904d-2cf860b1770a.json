  "id": "048996e9-5d0a-53bb-904d-2cf860b1770a",
  "slug": "buffalo-chicken-pastry-sliders-recipe-7495217",
  "name": "Buffalo Chicken Pastry Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These Buffalo chicken pastry sliders take very little time and effort and are a great party treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cut each pastry sheet into 6 rectangles. Stir together buffalo chicken dip and cheese in a bowl. Place a heaping dollop (about 2 tablespoons) chicken mixture in the center of each pastry square, allowing for all 4 sides of the pastry to be exposed. Set on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until sliders are puffed and golden, 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Top each pastry with a drizzle of hot sauce. Sprinkle each pastry evenly with celery and blue cheese and serve with ranch dressing if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

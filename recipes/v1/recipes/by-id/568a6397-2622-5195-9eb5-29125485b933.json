  "id": "568a6397-2622-5195-9eb5-29125485b933",
  "slug": "vanilla-cherry-ice-cream",
  "name": "Fresh Cherry Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This homemade cherry ice cream made with fresh sweet black cherries, cream, and almond extract is a delicious way to celebrate summer cherries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine the cream, milk, and sugar in a bowl. Stir until the sugar is completely dissolved."
    },
    {
      "position": 3,
      "text": "Stir in the vanilla and almond extract. Add chopped cherries."
    },
    {
      "position": 4,
      "text": "Pour mixture into an ice cream maker and churn according to manufacturer\u2019s instructions, about 20 minutes. Transfer to an airtight container and freeze until firm and desired consistency before serving, about 2 to 4 hours."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,

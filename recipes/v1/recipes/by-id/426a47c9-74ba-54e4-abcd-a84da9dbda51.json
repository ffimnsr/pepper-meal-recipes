  "id": "426a47c9-74ba-54e4-abcd-a84da9dbda51",
  "slug": "reuben-sandwich-ii",
  "name": "Reuben Sandwich",
  "recipe_type": "main",
  "brief_description": "A Reuben sandwich is easy to make with corned beef, Swiss cheese, sauerkraut, and Thousand Island dressing grilled between slices of rye bread.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat a large griddle or skillet over medium heat."
    },
    {
      "position": 2,
      "text": "Spread one side of bread slices evenly with Thousand Island dressing."
    },
    {
      "position": 3,
      "text": "On four bread slices, layer one slice Swiss cheese, 2 slices corned beef, 1/4 cup sauerkraut, and a second slice of Swiss cheese. Top with remaining bread slices, dressing-side down. Butter the top of each sandwich."
    },
    {
      "position": 4,
      "text": "Place sandwiches, butter-side down on the preheated griddle; butter the top of each sandwich with remaining butter. Grill until both sides are golden brown, about 5 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve hot. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

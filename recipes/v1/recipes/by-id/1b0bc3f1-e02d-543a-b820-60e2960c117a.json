  "id": "1b0bc3f1-e02d-543a-b820-60e2960c117a",
  "slug": "fusion-hummus",
  "name": "Fusion Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Rosemary adds a Mediterranean accent to this version of hummus made fast and easy in a food processor combining garbanzo beans, balsamic vinegar, olive oil, and a hint of garlic.",
  "cuisine": "Middle Eastern Inspired American Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Strip rosemary leaves from stems, discard stems, and place leaves in the bowl of a food processor. Add garlic and pulse until finely chopped. Pour in the garbanzo beans; process until evenly blended."
    },
    {
      "position": 2,
      "text": "With food processor running, slowly pour in the olive oil, scraping sides of the bowl as necessary. Pour in balsamic vinegar and process until evenly blended. Taste, and add more vinegar, 1 tablespoon at a time, as desired. Pour in the water and process to make a spreadable consistency. Add more water, 1 tablespoon at a time, if necessary. Season with salt and pepper to taste. Chill before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

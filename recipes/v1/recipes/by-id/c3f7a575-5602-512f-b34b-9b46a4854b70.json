  "id": "c3f7a575-5602-512f-b34b-9b46a4854b70",
  "slug": "gnocchi-mac-and-cheese-recipe-8736330",
  "name": "Gnocchi Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "This gnocchi mac and cheese combines two favorites by baking pillowy gnocchi in a rich Cheddar cheese sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium high-heat. Whisk in flour until smooth, and cook about 1 minute."
    },
    {
      "position": 3,
      "text": "Whisk in cream, evaporated milk, Worcestershire, and mustard. Stir in Cheddar cheese and cheese powder and cook until cheese melts, about 2 minutes. If you prefer a thinner sauce, add evaporated milk, 1 tablespoon at a time, until sauce is the consistency you like."
    },
    {
      "position": 4,
      "text": "Stir in gnocchi; pour mixture into a small baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly, about 20 minutes. Serve immediately."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a6182a79-40fe-5dc4-afc2-81ea5835aef8",
  "slug": "artichoke-stuffed-mushrooms",
  "name": "Artichoke Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "This recipe will deliver tasty mushrooms stuffed with cheese, onion, and artichoke hearts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Prepare a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat the olive oil in a skillet over medium heat; cook the onions and mushroom stems in the hot oil until the onion is translucent, about 5 minutes; season with salt and pepper. Transfer the mixture to a large bowl; add the artichoke hearts, cream cheese, sour cream, Italian cheese blend, and Parmesan cheese. Season with salt, pepper, and garlic salt. Stir the mixture until ingredients are evenly distributed. Stuff the mushroom caps with the mixture. Arrange the stuffed mushrooms on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the filling begins to bubble, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

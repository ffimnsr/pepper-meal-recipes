{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f23293d3-5c1f-55b1-a8db-522b268bf75d",
  "slug": "swannys-killer-fajitas",
  "name": "Swanny's Killer Fajitas",
  "recipe_type": "main",
  "brief_description": "Delicious lime-marinated chicken and vegetables are folded into hot corn tortillas and served with fresh lettuce, tomato, and sour cream. Add your favorite toppings like taco sauce, guacamole, and a sprinkle of fresh cilantro if you like.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken strips in a bowl and stir in lime juice, cumin, paprika, chili powder, cayenne pepper, and black pepper; marinate chicken for 15 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Heat a large skillet or wok over medium heat and pour in olive oil. Cook and stir red bell pepper and onion in the hot oil until softened, about 5 minutes; move vegetables to the outer edge of the skillet."
    },
    {
      "position": 3,
      "text": "Place chicken strips with marinade in the center of the skillet and cook and stir until chicken is no longer pink in the center and juices run clear, about 3 minutes; cook and stir chicken and vegetables together until liquid in skillet has evaporated, about 2 more minutes. Set chicken and vegetables aside."
    },
    {
      "position": 4,
      "text": "Place corn tortillas on a microwave-safe plate with damp paper towels separating each tortilla. Cook in microwave until tortillas are hot and flexible, about 30 seconds."
    },
    {
      "position": 5,
      "text": "Place corn tortillas onto 4 serving plates; spread each tortilla with 1 tablespoon sour cream."
    },
    {
      "position": 6,
      "text": "Top each tortilla with 1/4 of the chicken and vegetable mixture; sprinkle with 2 tablespoons shredded Cheddar-Monterey Jack cheese blend."
    },
    {
      "position": 7,
      "text": "Sprinkle each tortilla with 1/4 cup lettuce and 2 tablespoons diced tomato."
    },
    {
      "position": 8,
      "text": "Top with any other desired toppings; repeat with remaining tortillas and ingredients."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

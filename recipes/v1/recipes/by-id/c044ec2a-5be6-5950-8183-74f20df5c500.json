  "id": "c044ec2a-5be6-5950-8183-74f20df5c500",
  "slug": "moist-red-velvet-cupcakes",
  "name": "Moist Red Velvet Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These homemade red velvet cupcakes are deliciously moist little versions of classic red velvet cake made with cocoa for a subtle chocolate flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup cupcake pan with 20 liners."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter in a large bowl with an electric mixer until light and fluffy. Mix in eggs, buttermilk, red food coloring, and vanilla. Stir in baking soda and vinegar. Combine flour, cocoa powder, and salt; stir into the batter just until blended. Spoon batter into the prepared cups, dividing evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the tops spring back when lightly pressed, 20 to 25 minutes. Cool in the pan set over a wire rack. When cool, arrange the cupcakes on a serving platter and frost with desired frosting."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

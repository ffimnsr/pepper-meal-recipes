  "id": "8a0b8717-c8ee-54a8-876f-cb90e07d78e1",
  "slug": "roasted-eggplant-recipe-6737745",
  "name": "Roasted Eggplant",
  "recipe_type": "dessert",
  "brief_description": "Roasted eggplant slices baked in the oven with olive oil until crispy outside and tender, naturally sweet inside, make a delicious vegetable side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or lightly grease."
    },
    {
      "position": 2,
      "text": "Slice eggplant in half lengthwise, then cut each half into quarters lengthwise. Cut each piece in half to make two shorter quarters. Place eggplant skin-side down onto the prepared baking sheet. Brush with olive oil; season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until softened and golden brown, 25 to 30 minutes. Remove from the oven and sprinkle with lemon juice. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

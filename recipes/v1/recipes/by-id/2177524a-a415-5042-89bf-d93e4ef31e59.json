  "id": "2177524a-a415-5042-89bf-d93e4ef31e59",
  "slug": "million-dollar-pasta-salad-recipe-11975369",
  "name": "Million Dollar Chicken Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Million Dollar Chicken Pasta Salad is a spin on the classic Million Dollar Spaghetti recipe. Loaded with chicken, bacon, Cheddar cheese, tomatoes, toasted almonds, and creamy ranch dressing, it\u2019s a hearty dish made for potlucks, picnics, or easy lunches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil over high heat. Add pasta and cook according to package directions until al dente. Drain and rinse briefly under cold water to cool; drain well."
    },
    {
      "position": 2,
      "text": "Whisk together mayonnaise, sour cream, ranch dressing mix, and black pepper in a large bowl until smooth."
    },
    {
      "position": 3,
      "text": "Add cooled pasta, bacon, chicken, tomatoes, red onion, green onions, almonds, and 1 cup of the cheese to the bowl. Toss gently until evenly coated in dressing."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate for at least 1 hour or up to 3 days."
    },
    {
      "position": 5,
      "text": "Stir pasta salad before serving. If needed, stir in a small amount of mayonnaise or milk to loosen. Top with remaining cheddar cheese and garnish with additional green onions. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

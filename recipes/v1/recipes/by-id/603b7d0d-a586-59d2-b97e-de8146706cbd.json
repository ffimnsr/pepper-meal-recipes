  "id": "603b7d0d-a586-59d2-b97e-de8146706cbd",
  "slug": "spicy-african-yam-soup",
  "name": "Spicy African Yam Soup",
  "recipe_type": "soup",
  "brief_description": "An unusual combination of simple ingredients that render a spicy, tasty soup that's ready in less than 45 minutes!",
  "cuisine": "West African",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oil in a stockpot over medium heat. Saute onion, sweet potato, and garlic until onion is soft. Turn down heat if necessary to prevent burning."
    },
    {
      "position": 2,
      "text": "Stir in the chicken broth, thyme and cumin. Bring to a boil, cover and simmer for about 15 minutes. Stir in salsa, garbanzo beans and zucchini. Simmer until tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in the cooked rice and peanut butter until the peanut butter has dissolved. Serve hot with pita chips and a green salad."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d37070e1-bd84-56b0-87f9-4ec3f26831f7",
  "slug": "holiday-cranberry-sauce",
  "name": "Holiday Cranberry Sauce",
  "recipe_type": "dessert",
  "brief_description": "No Thanksgiving or Christmas table is complete without a sweet-tart sauce made from fresh cranberries, sugar, and spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Wrap cinnamon sticks, cloves, and allspice berries in a spice bag."
    },
    {
      "position": 2,
      "text": "Combine cranberries, water, and spice bag in a medium saucepan over medium heat. Cook until cranberries begin to burst, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in sugar and reduce the heat to low. Continue cooking until sugar dissolves, about 5 minutes. Remove from the heat and let cool to room temperature, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove and discard spice bag. Cover cranberry sauce and chill in the refrigerator before serving, 8 hours to overnight."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "69bc236f-42b4-5e80-ba21-048ac8718c2d",
  "slug": "kickin-buffalo-chicken-nachos",
  "name": "Buffalo Chicken Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These buffalo chicken nachos are bursting with flavor \u2014 you'll love the combo of crunchy tortilla chips, spicy buffalo chicken, and cool blue cheese dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large, rimmed baking sheet with aluminum foil and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine 1/4 cup blue cheese dressing, cayenne pepper sauce, and melted butter in a bowl until well blended. Add chicken and toss to coat."
    },
    {
      "position": 3,
      "text": "Spread tortilla chips evenly over the prepared baking sheet. Sprinkle tomato, olives, onion, and jalape\u00f1o peppers over chips. Spread chicken mixture over vegetables and top with crumbled bacon."
    },
    {
      "position": 4,
      "text": "Mix both cheeses together in a bowl; sprinkle mixture evenly over chicken mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and lightly browned, 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven. Drizzle remaining 1/2 cup blue cheese dressing over nachos and garnish with cilantro."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "859d5bf1-e9ab-5d6b-94a5-412081e72f44",
  "slug": "maple-glazed-carrots",
  "name": "Maple Glazed Carrots",
  "recipe_type": "dessert",
  "brief_description": "This maple-glazed carrots recipe makes tender, buttery carrots that are perfectly sweetened with warm syrup for an easy weeknight or holiday side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place carrots in a large saucepan, cover with salted water, and bring to a boil. Reduce heat to medium-low; simmer until tender, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Drain; transfer to a large platter."
    },
    {
      "position": 3,
      "text": "Melt butter in a small saucepan over medium-low heat. Stir in syrup until warmed through, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour over carrots and toss to coat; season with salt and pepper. Garnish with parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

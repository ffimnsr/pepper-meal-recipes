  "id": "827557cc-4b33-58fd-8945-2a1acf5b40fc",
  "slug": "roasted-dill-potatoes-recipe-11934600",
  "name": "Roasted Dill Potatoes",
  "recipe_type": "side",
  "brief_description": "This roasted dill potatoes recipe makes a delicious side dish with some surprising flavors. My method for cooking the potatoes is foolproof: by adding a little bit of water to the roasting pan, you'll get a tender bite while the skin is crisp and golden.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut the yellow baby potatoes in half and add them to a baking dish. I used a 9x9-inch baking dish but you can use any you like."
    },
    {
      "position": 3,
      "text": "Add salt, pepper to taste, and drizzle on some olive oil. Give it a mix, and on one corner push the potatoes to the side a bit with a spoon and pour in the water."
    },
    {
      "position": 4,
      "text": "Bake uncovered in the preheated oven until golden, about 45 minutes."
    },
    {
      "position": 5,
      "text": "In the meantime finely chop the garlic and the fresh dill. The moment the potatoes come out of the oven and they are sizzling hot, add the garlic and dill right away and give it a mix."
    },
    {
      "position": 6,
      "text": "The heat will cook off any of that raw garlic flavour right away. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

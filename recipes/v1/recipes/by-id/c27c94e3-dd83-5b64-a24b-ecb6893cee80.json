{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c27c94e3-dd83-5b64-a24b-ecb6893cee80",
  "slug": "sourdough-discard-bread",
  "name": "Sourdough Discard Bread",
  "recipe_type": "appetizer",
  "brief_description": "Use up sourdough starter discard to prepare this bread loaf, baked in a Dutch oven for amazing texture.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix water, starter discard, and yeast together in a large bowl; whisk or swish around with your fingers. Let mixture sit for 10 minutes."
    },
    {
      "position": 2,
      "text": "Combine 2 cups plus 4 teaspoons whole wheat flour and 2 cups plus 4 teaspoons bread flour in another bowl; sprinkle over the entire yeast mixture and sprinkle salt on top of the flour. Mix well by hand until you can form a ball. Let this dough ball sit covered with a kitchen towel for 30 minutes."
    },
    {
      "position": 3,
      "text": "Knead dough on a floured surface until you have a nice, tight ball; once you notice the surface of the dough start to tear, stop kneading. Be sure not to add too much flour while kneading, you should only need about 1 tablespoon or 2."
    },
    {
      "position": 4,
      "text": "Line a bread basket with a kitchen towel and liberally sprinkle 1/4 cup bread flour on the towel so the dough won't stick while rising. Place dough into the bread basket with the bottom of the loaf facing up. Let rise for 2 hours."
    },
    {
      "position": 5,
      "text": "Place a Dutch oven in the oven and preheat oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 6,
      "text": "Turn dough over onto a piece of parchment paper. Cut a shallow \"X\" across the surface of the dough using a very sharp knife."
    },
    {
      "position": 7,
      "text": "Using hot pads, carefully remove the Dutch oven from the oven. Place it on the stovetop and remove the lid. Hold the sides of the parchment paper to lift the loaf and carefully lower it into the Dutch oven. It's totally fine for the bread to bake with the parchment paper, it makes it easier to handle."
    },
    {
      "position": 8,
      "text": "Cover the Dutch oven and bake in the preheated oven for 40 minutes. Reduce oven temperature to 450 degrees F (230 degrees C) and continue to bake until golden, about 20 minutes more. Remove from the oven and place on a wire cooling rack. Let bread cool for at least 2 hours before cutting."
    }
  ],
  "servings": 12,

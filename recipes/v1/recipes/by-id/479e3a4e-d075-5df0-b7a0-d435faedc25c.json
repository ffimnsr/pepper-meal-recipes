  "name": "Banana Caramel Kefir Smoothie",
  "recipe_type": "dessert",
  "brief_description": "This banana caramel kefir smoothie is made with nutrient rich, high protein, low-fat kefir, similar to a thin yogurt. It brings tanginess, and the sweet caramel syrup contrasts nicely in this banana smoothie. For a thicker smoothie, add a little crushed ice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add bananas, Kefir, caramel syrup, and vanilla to a blender, and process until smooth. Pour into glasses and serve immediately."
    }
  ],

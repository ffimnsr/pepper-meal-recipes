  "id": "3bb546cc-31c9-5703-8da0-20f52722fb71",
  "slug": "two-ingredient-naan",
  "name": "Easy Two-Ingredient Naan",
  "recipe_type": "side",
  "brief_description": "While this two-ingredient Indian naan bread is not totally traditional, it sure works in a pinch and could not be easier as a side dish with any meal.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix self-rising flour and Greek yogurt together in a large bowl until combined. Transfer to a lightly floured work surface and knead until smooth, adding more flour as necessary to keep dough from sticking, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Pat dough into a rough 9x7-inch rectangle. Divide into 8 equal pieces. Lightly dust each piece with flour and flatten into a semi-rectangular shape, about 1/4 inch thick."
    },
    {
      "position": 3,
      "text": "Lightly grease a large skillet and place it over medium heat. Add 1 or 2 of the flattened dough pieces to the skillet. Cook until they begin to bubble and brown, 2 to 4 minutes. Flip over and cook an additional 2 to 4 minutes. Remove from heat and repeat with remaining dough until all pieces are cooked. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

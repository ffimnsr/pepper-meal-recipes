  "id": "5a0c6dc2-7197-55a6-8486-b8d29ec58340",
  "slug": "ragu-no-boiling-lasagna",
  "name": "Rag\u00fa No Boiling Lasagna",
  "recipe_type": "main",
  "brief_description": "This lasagna with no-boil noodles, ricotta, mozzarella, Parmesan cheese, and jarred Rag\u00fa sauce comes together quickly for a delicious Italian meal,",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ricotta, 1 cup mozzarella cheese, eggs, and 1/4 cup Parmesan cheese in a large bowl; mix well and set aside."
    },
    {
      "position": 3,
      "text": "Spread 1 cup sauce in a 9x13-inch baking dish. Layer 4 uncooked noodles, then 1 cup sauce and 1/2 of the ricotta mixture; repeat. Top with remaining 4 uncooked noodles and remaining sauce. Cover the dish tightly with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 1 hour. Remove the foil and sprinkle with remaining 1 cup mozzarella and 1/4 cup Parmesan cheese. Continue baking, uncovered, until cheese is melted, about 10 minutes more. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "bd83d622-77f4-571d-bc27-9137bc0f3123",
  "slug": "las-vegas-galbi-korean-style-beef-ribs",
  "name": "Las Vegas Galbi (Korean-Style Beef Ribs)",
  "recipe_type": "dessert",
  "brief_description": "Korean ribs, Las Vegas style, are beef ribs marinated in a fruity, salty, sweet, and savory marinade and then grilled until perfectly crisp.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place ribs in a large bowl of water; soak for 1 hour. Drain ribs and return to the bowl."
    },
    {
      "position": 2,
      "text": "Combine Asian pear, onion, kiwi, and garlic in a food processor and puree. Transfer to a bowl and stir in soy sauce, brown sugar, honey, sesame, oil, and black pepper. Pour marinade over ribs in the bowl. Cover with plastic wrap and marinate in the refrigerator, turning once, at least 8 hours or overnight."
    },
    {
      "position": 3,
      "text": "Strain marinade and discard."
    },
    {
      "position": 4,
      "text": "Preheat grill for medium heat and lightly oil the grate. Grill ribs until crispy outside and meat is no longer pink, about 8 minutes per side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

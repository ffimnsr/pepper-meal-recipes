  "id": "f39afbc4-b9f4-5e42-b317-75eddd59df41",
  "slug": "granny-mabels-best-bar-cookies",
  "name": "Granny Mabel\u2019s Best Bar Cookies",
  "recipe_type": "dessert",
  "brief_description": "These irresistible bar cookies layer oats, chocolate chips, and caramel ice cream topping into one rich, chewy dessert that\u2019s sure to become a favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Stir flour, oats, brown sugar, salt, and baking soda together in a large bowl. Mix in melted butter until evenly combined. Press half of the mixture into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly toasted, about 10 minutes. Remove from the oven and immediately sprinkle with chocolate chips. Let stand until the chocolate chips soften slightly."
    },
    {
      "position": 4,
      "text": "Mix caramel topping and flour together in a small bowl; drizzle evenly over the chocolate chips. Sprinkle the remaining crust mixture evenly over the caramel layer and press down lightly."
    },
    {
      "position": 5,
      "text": "Bake for 15 more minutes in the preheated oven. Allow to cool completely before cutting into squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,

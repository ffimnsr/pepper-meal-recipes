  "schema_version": 1,
  "id": "59fc228e-e49c-5d9c-a94f-b91f7743a5b3",
  "slug": "spicy-pork-curry",
  "name": "Spicy Pork Curry",
  "recipe_type": "main",
  "brief_description": "This pork curry recipe features thin slices of juicy pork tenderloin cooked in a coconut milk-based peanut sauce that delivers just the right kick!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine water, dried onion, chicken bouillon, garlic powder, rosemary, thyme, and salt in a microwave-safe bowl. Microwave for 1 minute, then let stand until onion is rehydrated and bouillon is dissolved."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat coconut oil, curry powder, and cayenne in a large oven-proof skillet over medium heat, stirring constantly, until oil takes on the color of the curry powder, 5 to 6 minutes."
    },
    {
      "position": 4,
      "text": "Add pork tenderloin to the skillet; cook and stir until pork begins to brown. Sprinkle flour over pork; cook and stir until pork is slightly pink in the center and cooked through; 2 to 3 minutes more."
    },
    {
      "position": 5,
      "text": "Stir in bouillon mixture, coconut milk, and peanut butter. Bring to a boil, stirring constantly. Cover the skillet and transfer to the oven."
    },
    {
      "position": 6,
      "text": "Cook in the preheated oven until pork is tender and sauce is bubbling, about 45 minutes. Remove from the oven, uncover, and let rest until the sauce thickens, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

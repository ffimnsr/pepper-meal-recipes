  "id": "6e618c31-7094-5666-91e4-2b29f45f23b5",
  "slug": "loaded-waffle-fries-recipe-8551264",
  "name": "Loaded Waffle Fries",
  "recipe_type": "appetizer",
  "brief_description": "These loaded waffle fries are topped with all of your favorite bacon cheeseburger fixings\u2014burger-seasoned beef, Cheddar, bacon, and all the right condiments.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk ketchup, mayonnaise, mustard, and dill pickle relish in a small bowl. Set sauce aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil, and arrange waffle fries on the sheet in a single layer."
    },
    {
      "position": 3,
      "text": "Bake fries in the preheated oven until golden, about 20 minutes, or according to package directions."
    },
    {
      "position": 4,
      "text": "Meanwhile, place bacon in a skillet over medium-high heat and cook until crisp, about 5 minutes. Transfer bacon to a paper towel-lined plate. Crumble when cool enough to handle."
    },
    {
      "position": 5,
      "text": "Heat the same skillet over medium-high heat. Crumble beef into the skillet, sprinkle with Worcestershire pub burger seasoning, and cook and stir until browned, about 8 minutes. Drain in a colander."
    },
    {
      "position": 6,
      "text": "Divide beef among the cooked fries and top with cheese. Return baking sheet to the oven and bake until cheese is melted, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Top fries with lettuce, tomato, onion, and bacon. Drizzle reserved sauce over the top and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

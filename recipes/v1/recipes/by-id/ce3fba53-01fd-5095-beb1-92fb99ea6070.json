  "id": "ce3fba53-01fd-5095-beb1-92fb99ea6070",
  "slug": "bacon-and-dill-pickle-cheese-ball",
  "name": "Bacon and Dill Pickle Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Set this cheese ball out at a party and it will disappear like magic before your eyes. Serve it with plain potato chips, crackers, or raw vegetables.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese, sour cream, diced dill pickles, Cheddar cheese, Monterey Jack cheese, dill pickle juice, green onions, paprika, and dried dill in a large bowl. Stir until evenly combined. Form mixture into a ball. Cover and refrigerate for a minimum of 1 hour."
    },
    {
      "position": 2,
      "text": "Just before serving, place pretzels in a food processor and pulse until bread crumb consistency. Combine pretzel crumbs and bacon on a flat plate."
    },
    {
      "position": 3,
      "text": "Roll the cheese ball in the pretzel mixture until all sides are coated."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "15aa98f2-69ac-55f6-804a-b7520781c056",
  "slug": "basic-seitan-wheat-meat-vegan-meat-substitute",
  "name": "Seitan Wheat Meat (Vegan Meat Substitute)",
  "recipe_type": null,
  "brief_description": "Try this easy seitan recipe for a wheat-based meat substitute that transforms any dish into a vegan-friendly meal. Use it in sandwiches or stir-fries.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir wheat gluten, 1/2 cup broth, liquid aminos, nutritional yeast, oil, and garlic together in a bowl until ingredients come together into a ball. Knead until dough has a rubbery texture. Divide dough into 3 equal pieces and shape into 1/2-inch-thick patties."
    },
    {
      "position": 2,
      "text": "Combine remaining 4 cups vegetable broth, water, and tamari in a large pot; bring to a boil. Carefully lower patties into boiling broth; cover the pot and return to a boil. Set the lid slightly askew to vent steam and reduce the heat to low. Continue simmering, turning occasionally, until patties are firm, about 1 hour."
    },
    {
      "position": 3,
      "text": "Remove from the heat and uncover the pot. Allow patties to cool in broth for 15 minutes before serving."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

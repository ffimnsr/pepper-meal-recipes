  "id": "c77a7b3c-1e7a-58f0-a27b-4ed3ac469c67",
  "slug": "aw-some-coleslaw",
  "name": "Aw-some Coleslaw Recipe",
  "recipe_type": "salad",
  "brief_description": "This awesome, tangy coleslaw recipe features crispy cabbage, vibrant carrots, and sweet onion in a creamy sweet-sour dressing for restaurant-style slaw.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, sugar, milk, lemon juice, vinegar, salt, and black pepper together in a large bowl until well combined."
    },
    {
      "position": 2,
      "text": "Add cabbage, carrots, and onion to the bowl; toss well. Refrigerate coleslaw before serving, 3 hours to overnight."
    }
  ],

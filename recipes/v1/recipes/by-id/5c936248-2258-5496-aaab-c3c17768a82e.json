  "id": "5c936248-2258-5496-aaab-c3c17768a82e",
  "slug": "caramel-pecan-pumpkin-pie",
  "name": "Caramel-Pecan Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This caramel-pecan pumpkin pie recipe combines pumpkin filling with a caramelized brown sugar-pecan topping \u2014 enjoy two Thanksgiving favorites in one.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat pumpkin, half-and-half, and eggs together in a bowl until smooth. Stir in sugar, flour, lemon zest, vanilla, salt, cinnamon, nutmeg, and allspice until evenly combined; pour into the prepared pie shell. Cover edges of pie with aluminum foil strips to prevent burning."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine pecans, brown sugar, and butter in a bowl until evenly mixed; carefully spoon over top of pie. Continue baking until topping is golden and bubbly, and a knife inserted into pie center comes out clean, about 20 minutes more. Cool on a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

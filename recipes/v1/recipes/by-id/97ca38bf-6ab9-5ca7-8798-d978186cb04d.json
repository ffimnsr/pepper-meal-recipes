  "schema_version": 1,
  "id": "97ca38bf-6ab9-5ca7-8798-d978186cb04d",
  "slug": "perfect-thai-fried-rice-with-marinated-chicken",
  "name": "Perfect Thai Fried Rice With Marinated Chicken",
  "recipe_type": "main",
  "brief_description": "Marinated chicken is stir-fried with leftover rice, eggs, garlic, and fresh cilantro to make this fantastically flavorsome fried rice dish.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken thighs, 2 tablespoons soy sauce, brown sugar, and black pepper in a bowl. Cover and marinate in the refrigerator, 2 hours to overnight."
    },
    {
      "position": 2,
      "text": "Heat a wok or very large skillet over high heat for 30 seconds. Pour in vegetable oil. Reduce heat to medium; add onion and garlic. Cook and stir until fragrant, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Increase heat to high and add marinated chicken to the wok; cook, stirring constantly, until no longer pink, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Push chicken mixture to one side of the wok; pour eggs into the empty side. Cook until just starting to set, about 2 minutes. Stir eggs slowly until scrambled; mix into chicken mixture. Season with 3 tablespoons soy sauce, sugar, and white pepper; stir for 1 minute."
    },
    {
      "position": 5,
      "text": "Stir rice into the wok until evenly incorporated and heated through, about 4 minutes. Remove from heat; stir in green onion and cilantro. Mix gently until combined."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

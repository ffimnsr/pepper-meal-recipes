  "id": "7a5523eb-f1c8-5851-96dc-8a30972627b1",
  "slug": "tacos-de-carne-asada",
  "name": "Tacos de Carne Asada",
  "recipe_type": "drink",
  "brief_description": "The secret behind crowd-pleasing tacos de carne asada is flank steak strips marinated in orange and lime juice, grilled to juicy perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine jalapeno, garlic, kosher salt, and 1 teaspoon black pepper in a mortar. Grind into a paste."
    },
    {
      "position": 2,
      "text": "Pour lime juice, orange juice, and vinegar into a glass bottle or lidded container; add garlic mixture and shake well. Place steak in a shallow bowl and pour marinade over. Cover with plastic wrap and refrigerate until steak absorbs flavors, 4 to 6 hours."
    },
    {
      "position": 3,
      "text": "Preheat grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove steak from the marinade and place on a cutting board. Season with salt and pepper and slice against the grain into thin strips."
    },
    {
      "position": 5,
      "text": "Grill until slightly charred and light pink in the center, about 5 minutes per side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

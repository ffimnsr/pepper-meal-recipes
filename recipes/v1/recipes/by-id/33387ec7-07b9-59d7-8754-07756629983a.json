  "id": "33387ec7-07b9-59d7-8754-07756629983a",
  "slug": "gazpacho-iv",
  "name": "Gazpacho IV",
  "recipe_type": "soup",
  "brief_description": "A wonderful cold summer soup, great with tortilla chips, crackers, or crusty bread. Can be used as a salsa if thickened.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix the tomatoes, tomato juice, beef broth, green bell pepper, celery, cucumber, onion, garlic, olive oil, lemon juice, and balsamic vinegar. Season with basil, parsley, salt, pepper, cumin, hot pepper sauce, and Worcestershire sauce. Cover bowl, and refrigerate gazpacho 8 hours or overnight before serving."
    }
  ],

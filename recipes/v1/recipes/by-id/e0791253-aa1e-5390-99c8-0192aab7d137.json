  "id": "e0791253-aa1e-5390-99c8-0192aab7d137",
  "slug": "slow-cooker-3-bean-chili",
  "name": "Slow Cooker 3-Bean Chili",
  "recipe_type": "soup",
  "brief_description": "The best beans for chili are pinto, kidney, and black beans, as in this slow cooker recipe for turkey chili with green chile and fire-roasted tomato.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook and stir turkey in a large skillet over medium-high heat until crumbly and browned, 7 to 10 minutes; transfer to a slow cooker."
    },
    {
      "position": 3,
      "text": "Stir in tomatoes, tomato sauce, pinto beans, kidney beans, black beans, onion, green chilies, chili powder, garlic, oregano, and cumin in the slow cooker."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 7 hours or High for 4 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 250,
  "preparation_time_minutes": 10,

  "schema_version": 1,
  "id": "53958940-c6e2-51e7-ada1-733d486dbe0b",
  "slug": "gluten-free-strawberry-shortcake",
  "name": "Gluten-Free Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This gluten-free strawberry shortcake recipe is so tasty, you won\u2019t believe it's completely gluten-free, and it's just as satisfying as the classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet or line with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk rice flour, cornstarch, tapioca flour, baking powder, salt, baking soda, and xanthan gum together in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and shortening together in a large bowl with an electric mixer until light and fluffy. Add flour mixture, alternating with milk, mixing until just combined. Drop batter onto the prepared baking sheet in 8 equal portions."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bottoms are golden brown, 10 to 12 minutes. Transfer to a wire rack to cool."
    },
    {
      "position": 5,
      "text": "Slice each shortcake in half; place bottoms on a plate. Divide strawberries among shortcakes, dollop with whipped topping, top with shortcake tops."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

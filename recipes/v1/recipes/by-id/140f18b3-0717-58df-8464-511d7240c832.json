  "id": "140f18b3-0717-58df-8464-511d7240c832",
  "slug": "breakfast-casserole-ii",
  "name": "Hearty Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Breakfast casseroles are always an enticing, easy, make-ahead option. This hearty casserole features sausage, potatoes, eggs, and mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cook sausage in a skillet over medium-high heat until evenly browned. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Beat eggs, soup, and milk together in a large bowl. Stir in sausage and mushrooms."
    },
    {
      "position": 4,
      "text": "Add to the prepared baking dish. Stir in frozen potato rounds."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the center is set and the casserole reaches 160 degrees F (71 degrees C), 45 to 50 minutes. Sprinkle with cheese, and bake until the cheese melts, about 10 minutes more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

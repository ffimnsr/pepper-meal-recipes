  "id": "2002837d-a22b-5200-ad26-3940fa4980e0",
  "slug": "dis-stuffed-green-peppers",
  "name": "Di's Stuffed Green Peppers",
  "recipe_type": "main",
  "brief_description": "Stuffed green bell peppers filled with ground beef, rice, and mozzarella cheese are easy to prepare for a weeknight meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Chop reserved green bell pepper tops. Measure out 1/4 cup and set aside."
    },
    {
      "position": 2,
      "text": "Bring a pot of water to a boil; cook whole green bell peppers in boiling water until slightly tender, about 5 minutes. Drain and lightly season inside of bell peppers with salt. Set aside."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef, onion, reserved 1/4 cup chopped green bell pepper, and garlic in the hot skillet until ground beef is browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Stir canned tomatoes and liquid, rice, water, Worcestershire sauce, 1 teaspoon salt, hot sauce, and black pepper into ground beef mixture; bring to a boil. Reduce heat, cover the skillet with a lid, and simmer until rice is tender, 15 to 18 minutes."
    },
    {
      "position": 6,
      "text": "Stir 3/4 of the mozzarella cheese and 3/4 of the tomato sauce into ground beef-rice mixture. Stuff bell peppers with ground beef-rice mixture; top each with remaining mozzarella cheese and tomato sauce. Arrange peppers in a baking dish. Cover the dish with aluminum foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cooked through and cheese is melted, 30 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

  "slug": "green-apple-martini-recipe-8721476",
  "name": "Green Apple Martini",
  "recipe_type": "appetizer",
  "brief_description": "This green apple martini is a simple, sour, and delicious version of a traditional vodka martini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add green apple vodka, green apple pucker, lemonade, and agave syrup to a cocktail shaker. Fill the shaker with ice."
    },
    {
      "position": 2,
      "text": "Shake very well and pour into 2 frosted martini glasses. Garnish with green apple slices."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

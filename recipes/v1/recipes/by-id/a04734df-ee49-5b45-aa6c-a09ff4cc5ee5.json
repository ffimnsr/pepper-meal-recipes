  "name": "Lemon Icing",
  "recipe_type": "dessert",
  "brief_description": "This superb lemon frosting comes together in one quick and easy step. It is a tasty icing perfect for baked goods like cake, cupcakes, and cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine butter, lemon juice, vanilla, and confectioners' sugar in a large mixing bowl and beat until light and fluffy. Add more confectioners' sugar, or lemon juice to adjust the consistency as needed."
    }

  "slug": "apple-snicker-salad",
  "name": "Apple Snicker Salad",
  "recipe_type": "salad",
  "brief_description": "Candy bars and apples are folded into a creamy mixture of pudding and whipped topping in this dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Whisk butterscotch pudding mix into milk in a bowl until dissolved."
    },
    {
      "position": 3,
      "text": "Stir whipped cream topping into pudding mixture."
    },
    {
      "position": 4,
      "text": "Fold the candy bar pieces into the pudding mixture."
    },
    {
      "position": 5,
      "text": "Fold the apples into the pudding mixture."
    },
    {
      "position": 6,
      "text": "Serve and enjoy."
    }
  ],

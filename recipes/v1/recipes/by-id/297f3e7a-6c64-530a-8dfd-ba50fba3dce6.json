  "id": "297f3e7a-6c64-530a-8dfd-ba50fba3dce6",
  "slug": "tortellini-salad-with-tomatoes-and-peas",
  "name": "Tortellini Salad with Tomatoes and Peas",
  "recipe_type": "salad",
  "brief_description": "This vegetarian tortellini salad recipe with peas, tomatoes, Parmesan cheese, chives, and parsley is tossed in a lemony vinaigrette, perfect potlucks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook tortellini in the boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain; set aside to cool."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a saucepan of water to a boil; cook peas in the boiling water for 2 minutes. Drain; set aside to cool."
    },
    {
      "position": 3,
      "text": "Combine cooled tortellini, cooled peas, tomatoes, Parmesan cheese, chives, and parsley in a large bowl."
    },
    {
      "position": 4,
      "text": "Whisk olive oil, lemon juice, sugar, \u00be teaspoon salt, and \u215b teaspoon black pepper together in a small bowl until well combined; it will taste sour. Pour vinaigrette over tortellini salad; toss well."
    },
    {
      "position": 5,
      "text": "Cover the bowl with plastic wrap; refrigerate at least 2 hours. Season with salt and black pepper before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

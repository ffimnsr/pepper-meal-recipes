  "id": "5997426f-68e2-5afe-a9ee-2a8ae728101e",
  "slug": "pumpkin-oatmeal-chocolate-chip-cookies",
  "name": "Pumpkin Oatmeal Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "Pumpkin puree brings a colorful dimension to these tasty, chocolate chip oatmeal cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat brown sugar, butter, and white sugar together in a bowl until creamy. Add pumpkin, egg, and vanilla extract; beat until smooth."
    },
    {
      "position": 3,
      "text": "Whisk flour, oats, cinnamon, baking soda, baking powder, and salt together in a separate bowl; stir into butter mixture until combined. Fold in chocolate chips."
    },
    {
      "position": 4,
      "text": "Drop 1 to 2 tablespoonfuls dough onto baking sheets spaced 2 inches apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are lightly browned, 10 to 12 minutes."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

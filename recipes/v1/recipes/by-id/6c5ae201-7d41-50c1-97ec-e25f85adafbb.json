  "id": "6c5ae201-7d41-50c1-97ec-e25f85adafbb",
  "slug": "kongnamool-korean-soybean-sprouts",
  "name": "Kongnamool (Korean Soybean Sprouts)",
  "recipe_type": "side",
  "brief_description": "These Korean bean sprouts made with an aromatic blend of Korean chile powder, garlic, sesame oil, and rice wine vinegar are a true favorite in Korea.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil; add bean sprouts and cook, uncovered, until tender yet still crisp, about 15 seconds."
    },
    {
      "position": 3,
      "text": "Drain in a colander, then immediately immerse in ice water for several minutes to stop the cooking process. Drain well and set aside."
    },
    {
      "position": 4,
      "text": "Whisk sesame oil, soy sauce, Korean chile powder, sesame seeds, and garlic together in a large bowl."
    },
    {
      "position": 5,
      "text": "Stir in bean sprouts and toss to coat; sprinkle with green onions and season with rice wine vinegar. Refrigerate before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

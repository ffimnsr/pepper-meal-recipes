  "id": "fc0d6f85-15d1-5778-baf4-273e6ea3502e",
  "slug": "creamy-spinach-tortellini",
  "name": "Creamy Spinach Tortellini",
  "recipe_type": "main",
  "brief_description": "Cheese tortellini is a family-favorite meal, especially when it\u2019s tossed with tomatoes, mushrooms, and spinach in a super rich and creamy sauce.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Add tortellini and cook, stirring occasionally, until tortellini float to the top and the filling is hot, 3 to 5 minutes. Drain."
    },
    {
      "position": 2,
      "text": "While the tortellini is cooking, melt butter in a large skillet over medium heat. Add onion; cook and stir until soft and translucent, about 5 minutes. Mix in spinach, cream cheese, mushrooms, Parmesan, and milk; stir to combine and cook until cream cheese is melted and mushrooms are soft, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Gently mix tortellini and cherry tomatoes into the skillet; cook until heated through, 5 to 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

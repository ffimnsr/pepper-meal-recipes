  "id": "09e14074-9912-5427-aaa3-ace70b205b2d",
  "slug": "chicken-in-garlic-and-black-bean-sauce",
  "name": "Chicken in Black Bean Sauce",
  "recipe_type": "main",
  "brief_description": "Chicken in black bean sauce is a classic Chinese stir-fry dish that's easy to make at home and packed with the flavors of pungent black bean sauce and garlic.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "To make the marinade: Mix 1 tablespoon cornstarch with 1 tablespoon water in a bowl; stir in light soy sauce, sugar, and salt. Add chicken; toss to combine. Set aside to marinate for 20 minutes."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a saucepan. Add bean sprouts; cook just until blanched, about 30 seconds; drain and set aside."
    },
    {
      "position": 3,
      "text": "Combine 1/4 cup water, oyster sauce, and sugar together in a small bowl; set aside."
    },
    {
      "position": 4,
      "text": "Heat vegetable oil in a skillet over high heat. Add black bean sauce and chopped garlic; cook and stir until fragrant, about 1 minute. Add onion; cook and stir until soft, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Add chicken and marinade mixture; stir-fry until cooked through and no longer pink in the middle, about 4 to 5 minutes. Stir in oyster sauce mixture; cook until heated through. Cover and simmer until flavors blend, about 1 or 2 minutes. Stir in bell pepper; cover and cook until softened, 1 to 2 minutes more."
    },
    {
      "position": 6,
      "text": "Dissolve 2 teaspoons cornstarch in 1 tablespoon water. Stir in bean sprouts and cornstarch mixture; cook until sauce is thickened, 2 to 3 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6f5b6dac-6809-5261-8d66-c73c7cf9919a",
  "slug": "ham-and-cheese-omelette",
  "name": "Ham and Cheese Omelette",
  "recipe_type": "breakfast",
  "brief_description": "This ham and cheese omelet is perfect for a filling breakfast or a fun breakfast for dinner choice. Fresh chives add color and extra flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a skillet over medium heat. Add ham and cook until browned and crispy, stirring frequently, about 7 minutes."
    },
    {
      "position": 2,
      "text": "Beat eggs with 1 teaspoon chives, salt, and pepper in a small bowl."
    },
    {
      "position": 3,
      "text": "Pour egg mixture into the skillet; let cook for 30 seconds. Lift the edges of the omelet so that uncooked egg runs under cooked edges and comes into contact with the hot skillet. Shake and tilt the skillet to move uncooked egg. Sprinkle Cheddar cheese on top and fold omelette in half. Flip and cook until egg is entirely set and cheese has melted, 30 seconds to 1 minute."
    },
    {
      "position": 4,
      "text": "Slide onto a plate and sprinkle with remaining 1 teaspoon chives."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

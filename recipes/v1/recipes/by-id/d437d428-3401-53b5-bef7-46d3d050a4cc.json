{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d437d428-3401-53b5-bef7-46d3d050a4cc",
  "slug": "easy-bacon-onion-and-cheese-stuffed-burgers",
  "name": "Easy Bacon, Onion, and Cheese-Stuffed Burgers",
  "recipe_type": "main",
  "brief_description": "These juicy cheese-stuffed burgers with bacon and onion are full of savory flavor and can be grilled or pan-fried for a family-pleasing meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground beef, barbecue sauce, garlic powder, black pepper, and salt in a large mixing bowl, using your hands. Shape a small handful at a time (approximately 1/4 pound) into 12 thin patties. Lay patties out on a cookie sheet and cover with plastic wrap; place patties in the refrigerator."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 5 minutes. Remove bacon from skillet with a slotted spoon and drain on paper towels. Reduce the heat to medium and cook onions in remaining bacon drippings until soft and just beginning to brown. Mix onions and bacon in a small bowl."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Meanwhile, remove beef patties from the refrigerator; top 6 patties with 1- 1/2 tablespoons of bacon and onion mixture, and sprinkle with shredded cheese. Top each with one of the remaining patties and press the edges together to seal."
    },
    {
      "position": 5,
      "text": "Grill stuffed patties until beef is no longer pink in the center, about 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Serve on hamburger buns with condiments of your choice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

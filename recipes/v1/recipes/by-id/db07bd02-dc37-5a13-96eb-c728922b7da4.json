  "id": "db07bd02-dc37-5a13-96eb-c728922b7da4",
  "slug": "tempeh-ratatouille",
  "name": "Tempeh Ratatouille",
  "recipe_type": "soup",
  "brief_description": "I've always loved ratatouille and I decided to make up my own hearty version. The veggies listed can be changed/ substituted according to what you have in your refrigerator and/or what's in season.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the potatoes, carrot, and onion in a large saucepan, and add enough water to bring the water level to about 2 inches. Bring to a boil. Cover, reduce heat, and simmer for 5 minutes. Mix in eggplant, broccoli, green beans, and zucchini; simmer for 2 minutes. Mix in tempeh, vegetable broth, crushed tomatoes, and garbanzo beans. Season with rosemary and garlic. Cook for 8 to 10 minutes, or until veggies are tender."
    },
    {
      "position": 2,
      "text": "Ladle into bowls, and top with cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

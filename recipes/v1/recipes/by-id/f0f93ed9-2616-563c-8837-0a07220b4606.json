  "schema_version": 1,
  "id": "f0f93ed9-2616-563c-8837-0a07220b4606",
  "slug": "roast-chicken-pan-gravy",
  "name": "Roast Chicken Pan Gravy",
  "recipe_type": "side",
  "brief_description": "Rich gravy made with roasted chicken drippings, a little flour, and chicken stock \u2014 that's it! You can use Chef John's technique for any kind of roast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour fat from drippings into a bowl and reserve. Whisk flour into remaining drippings left in pan; mixture will seem dry. Add 2 tablespoons reserved fat, or as needed, to the drippings mixture to combine with flour."
    },
    {
      "position": 2,
      "text": "Place the pan with drippings mixture over low heat and toast flour until light brown and mixture gives off a nutty fragrance, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Drizzle about 1/3 cup cold chicken stock at a time into pan drippings, whisking each addition of stock into mixture until thoroughly combined. Continue whisking, scraping any browned pan drippings from the bottom of the pan into gravy; bring to a simmer. Continue to cook, whisking constantly, until gravy is thick and flour has combined with the liquid, 8 to 10 minutes. Season with salt and pepper. For the smoothest texture, strain gravy before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

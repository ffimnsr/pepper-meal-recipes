  "id": "62249ca4-b945-5460-b06e-27bc44001ba0",
  "slug": "hot-honey-butternut-squash-recipe-11834981",
  "name": "Hot Honey Butternut Squash",
  "recipe_type": "dessert",
  "brief_description": "This hot honey butternut squash is crispy on the outside, tender on the inside, and savory with a little bit of sweet and heat. Do not be daunted by this large vegetable\u2014a good sharp knife is your best friend when preparing the butternut squash.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place cubed squash in a large bowl. Add oil, thyme, oregano, and salt. Toss until evenly combined. Transfer to a baking sheet in an even layer."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven for 30 minutes. Drizzle hot honey over the mixture. Stir to coat and spread back out in an even layer."
    },
    {
      "position": 4,
      "text": "Roast until tender, about 5 minutes more. Sprinkle with parsley and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

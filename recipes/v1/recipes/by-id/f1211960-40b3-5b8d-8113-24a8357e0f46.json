  "schema_version": 1,
  "id": "f1211960-40b3-5b8d-8113-24a8357e0f46",
  "slug": "homemade-chicken-pot-pie",
  "name": "Homemade Chicken Pot Pie",
  "recipe_type": "soup",
  "brief_description": "This homemade pot pie recipe is so comforting. Chicken is seasoned with rosemary, cooked in broth, then baked to in a buttery, flaky pie crust. Yum!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place 1 pie crust in a 9-inch pie plate. Poke several holes in bottom of crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 5 minutes. Set aside to cool."
    },
    {
      "position": 4,
      "text": "Season both sides chicken breasts with rosemary, parsley, salt, and black pepper. Heat oil in a large skillet over medium-high heat. Add chicken to the skillet; cook until golden brown, 2 to 4 minutes per side."
    },
    {
      "position": 5,
      "text": "Reduce heat to medium-low. Add \u2154 cup chicken broth; simmer until chicken is just cooked and juices run clear, 10 to 15 minutes. Transfer chicken to a plate; rest, about 15 minutes. Reserve drippings in the skillet."
    },
    {
      "position": 6,
      "text": "Melt butter in drippings in the skillet over medium heat. Add garlic; cook until fragrant, about 30 seconds. Add onion, salt, and black pepper; cook until translucent, about 5 minutes. Whisk in flour until mixture thickens."
    },
    {
      "position": 7,
      "text": "Gradually add 1 \u00be cups chicken broth and milk, while whisking constantly, until mixture begins to thicken; remove from heat."
    },
    {
      "position": 8,
      "text": "Cut chicken into bite-sized pieces; stir into broth mixture along with thawed vegetables until combined. Transfer to the par-baked pie crust. Place remaining pie crust on top of pie; cut slits into top crust. Crimp edges to seal; decorate with tongs or a fork, if desired."
    },
    {
      "position": 9,
      "text": "Bake until crust is golden brown, 30 to 40 minutes. Check edges halfway through baking time; cover with aluminum foil if browning too much."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

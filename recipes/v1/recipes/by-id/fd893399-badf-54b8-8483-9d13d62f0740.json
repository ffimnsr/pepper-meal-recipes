  "id": "fd893399-badf-54b8-8483-9d13d62f0740",
  "slug": "mushroom-meatloaf",
  "name": "Mushroom Meatloaf",
  "recipe_type": "main",
  "brief_description": "This mushroom meatloaf is a nice change from your grandmother's meatloaf with minced mushroom mixed in and whole mushrooms on top to keep things moist!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Set aside six whole mushrooms, then mince the rest."
    },
    {
      "position": 3,
      "text": "Mix ground beef, minced mushrooms, bread crumbs, onion, ketchup, eggs, salt, and pepper together in a mixing bowl until well combined. Spread 1/2 of the mixture into the bottom of a 9x5-inch loaf pan. Press the whole mushrooms into the meat with the stems facing down. Top with remaining meat and pat gently to combine with the bottom section."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour and 45 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 105,
  "preparation_time_minutes": 20,

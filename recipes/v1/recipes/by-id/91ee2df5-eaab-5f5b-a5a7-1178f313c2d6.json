  "id": "91ee2df5-eaab-5f5b-a5a7-1178f313c2d6",
  "slug": "famous-chicken-adobo",
  "name": "Famous Chicken Adobo",
  "recipe_type": "main",
  "brief_description": "Delicious chicken adobo with tender, juicy chicken cooked in a rich and flavorful vinegar pepper sauce that\u2019s simple to make and great with rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Cook chicken pieces in oil until golden brown, 2 to 3 minutes per side. Transfer chicken to a plate and set aside."
    },
    {
      "position": 2,
      "text": "Add onion and garlic to the skillet; cook until softened and brown, about 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour in soy sauce and vinegar and season with garlic powder, black pepper, and bay leaf."
    },
    {
      "position": 4,
      "text": "Return chicken to pan, increase heat to high, and bring to a boil. Reduce heat to medium-low, cover, and simmer until chicken is tender and cooked through, 35 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

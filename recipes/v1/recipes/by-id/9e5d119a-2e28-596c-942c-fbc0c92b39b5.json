{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9e5d119a-2e28-596c-942c-fbc0c92b39b5",
  "slug": "salted-caramel-pretzel-brownies-recipe-12014106",
  "name": "Salted Caramel Pretzel Brownies",
  "recipe_type": "dessert",
  "brief_description": "These decadent salted caramel pretzel brownies combine rich, fudgy chocolate brownies with a thick layer of smooth salted caramel and a pretzel topping. The contrast of rich cocoa, buttery sweetness, and salty crunch creates the perfect balance of flavors and textures in every bite. Finished with a sprinkle of flaky sea salt, these brownies are a crowd-pleasing dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (160 degrees C). Grease a 9-inch square baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "For caramel sauce: In a medium saucepan cook sugar, undisturbed, until more than half of it is dissolved, about 5 minutes. Stir and cook, until all sugar is dissolved and turns amber in color, about 2 minutes more. Caramel can go quickly from amber to burned, so do not walk away from the stove. Remove from heat when completely smooth. Then add butter, stirring until melted. Gradually add heavy cream and sea salt, stirring until mixture is smooth and combined. Transfer to a small heatproof bowl and cool at room temperature for 15 minutes before adding to brownies."
    },
    {
      "position": 3,
      "text": "Prepare brownie mix according to package directions using egg, oil, and water."
    },
    {
      "position": 4,
      "text": "Pour half of the brownie batter into prepared pan. Add 3/4 cup of the caramel sauce and swirl into batter with the tip of a knife. Top with remaining half of the brownie batter, covering as much of caramel as possible. Sprinkle with pretzels, and swirl into batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until brownies are set, 45 to 50 minutes. Let cool completely before slicing, about 1 hour. Drizzle with remaining caramel and sprinkle with salt, if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,

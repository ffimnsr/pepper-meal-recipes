  "id": "fbcf6feb-c71e-5bb4-ad9e-f16941ce705c",
  "slug": "keto-chicken-crust-pizza",
  "name": "Keto Chicken Crust Pizza",
  "recipe_type": "main",
  "brief_description": "Chicken pizza crust? Yes, it's possible and also ideal if you're on the keto diet. Top with your favorite toppings or sprinkle with cheese and fresh basil.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Mix ground chicken, mozzarella, Parmesan, garlic, Italian seasoning, salt, and pepper together in a large bowl with your hands until well combined."
    },
    {
      "position": 4,
      "text": "Fold in basil."
    },
    {
      "position": 5,
      "text": "Place chicken mixture between two pieces of parchment paper."
    },
    {
      "position": 6,
      "text": "Gently press on the top piece of parchment and spread mixture into a circle or rectangle with a thickness of 1/4 to 1/2 inch. Remove and discard the top piece of parchment paper."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until starting to brown on the edges, 35 to 45 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

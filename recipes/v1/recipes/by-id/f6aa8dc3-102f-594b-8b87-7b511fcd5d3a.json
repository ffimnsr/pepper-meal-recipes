  "schema_version": 1,
  "id": "f6aa8dc3-102f-594b-8b87-7b511fcd5d3a",
  "slug": "bourbon-vanilla-creme-brulee",
  "name": "Vanilla Cr\u00e8me Br\u00fbl\u00e9e",
  "recipe_type": "dessert",
  "brief_description": "This rich and delicious vanilla cr\u00e8me br\u00fbl\u00e9e is an exquisite French dessert made with just 4 easy ingredients: eggs, sugar, cream, and vanilla paste.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Place egg yolks in a bowl; beat with an electric mixer on high speed until eggs are thick and light yellow, about 5 minutes. Gradually beat in 1/4 cup sugar and vanilla bean paste."
    },
    {
      "position": 2,
      "text": "Pour cream into the top of a double boiler over simmering water and simmer until just hot to the touch, about 3 minutes. Pour 1/2 of the warmed cream into the egg mixture, a little at a time, whisking constantly so eggs do not curdle."
    },
    {
      "position": 3,
      "text": "Pour egg yolk-cream mixture into the remaining cream in the double boiler."
    },
    {
      "position": 4,
      "text": "Cook over medium heat, stirring continuously, until mixture thickens, 8 to 10 minutes. Do not let mixture boil."
    },
    {
      "position": 5,
      "text": "Pour custard into 4 small ramekins and refrigerate for a minimum of 2 hours, up to 24 hours."
    },
    {
      "position": 6,
      "text": "Sprinkle each cr\u00e8me br\u00fbl\u00e9e with some of the remaining tablespoon of superfine sugar."
    },
    {
      "position": 7,
      "text": "Use a blowtorch to melt the sugar on top of the cr\u00e8me br\u00fbl\u00e9e. It will crystallize as it hardens. Alternatively you can use the oven broiler, but be careful to not burn the sugar."
    },
    {
      "position": 8,
      "text": "Lightly tap the crystallized sugar with the back of a spoon to break it before eating."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

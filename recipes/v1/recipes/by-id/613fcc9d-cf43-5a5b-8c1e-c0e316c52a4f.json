{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "613fcc9d-cf43-5a5b-8c1e-c0e316c52a4f",
  "slug": "air-fryer-mini-dark-chocolate-cake-with-brown-butter-frosting-recipe-7509612",
  "name": "Air Fryer Mini Dark Chocolate Cake with Brown Butter Frosting",
  "recipe_type": "dessert",
  "brief_description": "Use your air fryer to make this yummy mini dark chocolate cake topped with brown butter frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat air fryer to 320 degrees F (160 degrees C). Coat a 6-inch cake pan with cooking spray. Line bottom of pan with parchment paper; dust with 2 tablespoons flour, tapping out excess."
    },
    {
      "position": 2,
      "text": "Stir together 1/4 cup flour, the cocoa, baking powder, baking soda, and salt in a small bowl. In another small bowl, whisk together buttermilk, applesauce, oil, espresso powder, and vanilla."
    },
    {
      "position": 3,
      "text": "In a third bowl, beat egg with an electric mixer at low speed. Gradually add sugar. Increase mixer speed to high and continue beating until mixture is thick and pale, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Alternately fold flour mixture and buttermilk mixture into egg mixture with a rubber spatula, stirring until incorporated before adding next addition. Fold in dark chocolate."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan. Arrange pan in the air fryer basket."
    },
    {
      "position": 6,
      "text": "Cook until a toothpick inserted in center comes out clean, about 25 minutes. Let cool in pan on a wire rack about 10 minutes. Remove cake from pan and allow to cool completely on a wire rack."
    },
    {
      "position": 7,
      "text": "For the frosting, melt butter in a heavy saucepan over medium heat; cook, stirring occasionally, until butter begins to turn golden brown and smells nutty, 15 to 20 minutes. Transfer butter to a bowl; cool for 10 minutes."
    },
    {
      "position": 8,
      "text": "Whisk in honey and vanilla. Whisk in powdered sugar until smooth, adding water, 1 teaspoon at a time, until desired consistency. The frosting will look separated but will come together with whisking in water a little at a time."
    },
    {
      "position": 9,
      "text": "Immediately top cooled cake with the frosting and garnish with additional dark chocolate. Recipe developed by Colleen Weeden"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "ffdd2aab-4593-50db-b53b-49076deb72ba",
  "slug": "spicy-grilled-shrimp",
  "name": "Spicy Grilled Shrimp",
  "recipe_type": "main",
  "brief_description": "Grilled shrimp flavored with a simple lemon, garlic, and paprika paste cook quickly on the grill until juicy, tender, and perfect for sharing at any BBQ party!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat a grill for medium heat."
    },
    {
      "position": 2,
      "text": "Crush garlic and salt together in a small bowl with a fork."
    },
    {
      "position": 3,
      "text": "Mix in paprika and cayenne. Stir in olive oil and lemon juice to form a paste."
    },
    {
      "position": 4,
      "text": "Combine garlic paste and shrimp in a large bowl and toss until shrimp are evenly coated."
    },
    {
      "position": 5,
      "text": "Lightly oil the grill grate. Grill shrimp until opaque, 2 to 3 minutes per side."
    },
    {
      "position": 6,
      "text": "Transfer to a serving dish, garnish with lemon wedges, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

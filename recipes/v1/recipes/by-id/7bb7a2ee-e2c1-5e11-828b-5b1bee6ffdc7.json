  "id": "7bb7a2ee-e2c1-5e11-828b-5b1bee6ffdc7",
  "slug": "overnight-french-toast",
  "name": "Overnight French Toast",
  "recipe_type": "dessert",
  "brief_description": "Prepared ahead and chilled overnight, this decadent baked French toast provides a sweet breakfast that everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking dish. Place bread slices in the prepared baking dish, overlapping slices as needed."
    },
    {
      "position": 2,
      "text": "Place eggs, half-and-half, milk, sugar, cinnamon, nutmeg, and salt in a medium bowl and mix thoroughly with a rotary beater or whisk. Pour mixture over bread, making sure all slices are moistened. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

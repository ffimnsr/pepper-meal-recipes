  "id": "62f5e159-39fb-56b4-85a0-c967f0c215cc",
  "slug": "egg-fried-tofu",
  "name": "Egg-Fried Tofu",
  "recipe_type": "side",
  "brief_description": "Slices of tofu are coated with egg and deep-fried in this Korean-inspired vegetarian dish served alongside a tart and spicy dipping sauce.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Slice tofu into 12 equal rectangular pieces. Sprinkle salt on both sides of tofu slices."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large, deep saucepan over medium heat."
    },
    {
      "position": 3,
      "text": "Dip tofu slices into bowl of beaten egg and fry in hot oil until lightly browned, about 3 minutes per side."
    },
    {
      "position": 4,
      "text": "Mix soy sauce, green onions, chile peppers, vinegar, sugar, and red pepper flakes together in a small bowl. Dip fried tofu into dipping sauce."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

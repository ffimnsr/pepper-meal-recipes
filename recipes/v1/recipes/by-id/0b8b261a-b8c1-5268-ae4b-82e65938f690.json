  "slug": "made-in-minutes-no-cook-fudge",
  "name": "Made-in-Minutes No-Cook Fudge",
  "recipe_type": "dessert",
  "brief_description": "This creamy-smooth, chocolaty fudge is made in minutes by mixing coconut oil, cocoa, and honey, and simply refrigerated to harden.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease 8x8 inch baking dish."
    },
    {
      "position": 2,
      "text": "Pour the coconut oil into a bowl, and sift in the cocoa, stirring to blend evenly. Stir in the honey, and mix until smooth. Spread mixture into prepared dish, and refrigerate at least 1 hour. Cut into 1 inch squares."
    }
  ],

  "id": "f02936fb-b633-543a-ac4e-3f8f6e246d54",
  "slug": "french-onion-shepherds-pie",
  "name": "French Onion Shepherd's Pie",
  "recipe_type": "soup",
  "brief_description": "French onion soup brings rich, savory flavor to this shepherd's pie recipe, making this French onion shepherd's pie a perfect dinner choice any night.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Mash potatoes. Add \u00bd cup Cheddar cheese, milk, green onion, and butter; stir until well combined."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium-high heat. Add ground beef, flour, and \u00bc teaspoon black pepper; cook and stir until browned and crumbly, 5 to 7 minutes. Stir in French onion soup and water."
    },
    {
      "position": 5,
      "text": "Place frozen peas in a small, microwave-safe bowl; microwave for 1 minute. Stir peas into beef mixture."
    },
    {
      "position": 6,
      "text": "Transfer beef mixture to a glass casserole dish; spread potatoes over top using a rubber spatula. Top with remaining \u00bd cup Cheddar cheese; sprinkle with black pepper."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until hot and bubbly, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

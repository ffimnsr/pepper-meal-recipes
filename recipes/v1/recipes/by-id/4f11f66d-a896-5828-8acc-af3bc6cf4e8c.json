  "id": "4f11f66d-a896-5828-8acc-af3bc6cf4e8c",
  "slug": "mushroom-and-black-bean-quesadillas",
  "name": "Mushroom and Black Bean Quesadillas",
  "recipe_type": "main",
  "brief_description": "Mushroom and black bean quesadillas made on whole wheat tortillas are a quick-and-easy, vegetarian, and healthy dinner for the whole family.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium-high heat; saut\u00e9 mushrooms and onion in hot oil until lightly browned, about 1 minute. Add black beans, cilantro, salt, and pepper; continue saut\u00e9ing until mushrooms and onions are browned, 2 to 3 minutes more. Remove from heat."
    },
    {
      "position": 2,
      "text": "Place 1 tortilla in a clean, dry skillet. Spread 1/2 of the mushroom mixture onto 1/2 of tortilla. Sprinkle with mozzarella cheese and lime juice; fold tortilla over filling. Cook over medium heat until quesadilla is browned and crispy, about 2 minutes per side. Transfer quesadilla to a cutting board. Repeat this step with second tortilla."
    },
    {
      "position": 3,
      "text": "Cut quesadillas into wedges and serve with salsa."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

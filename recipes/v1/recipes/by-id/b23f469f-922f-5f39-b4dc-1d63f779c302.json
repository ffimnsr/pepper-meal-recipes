  "id": "b23f469f-922f-5f39-b4dc-1d63f779c302",
  "slug": "haldi-ka-doodh-hot-turmeric-milk",
  "name": "Haldi Ka Doodh (Hot Turmeric Milk)",
  "recipe_type": "drink",
  "brief_description": "Hot turmeric milk, or haldi ka doodh, is a traditional Indian beverage made with a blend of warm spices used to soothe sore throats and heal colds.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together turmeric, cardamom, black pepper, ginger, cloves, and allspice in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Heat milk in a small saucepan over medium heat until heated through, 3 to 4 minutes; stir honey and vanilla into milk until completely dissolved."
    },
    {
      "position": 3,
      "text": "Whisk 1 teaspoon turmeric mixture into milk mixture; reduce heat to medium-low and simmer until flavors blend, 2 to 3 minutes. Pour mixture through a strainer."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,

  "id": "e9bc296c-85c7-57b5-98dd-21fe4632ab92",
  "slug": "sesame-date-rolls",
  "name": "Sesame Date Rolls",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for sesame date rolls features a hint of warming spice with a sesame seed coating. This healthful snack tastes even better the next day.",
  "cuisine": "American Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place dates in a small bowl; completely cover with hot water. Soak until softened, 10 to 15 minutes. Drain; reserve soaking liquid."
    },
    {
      "position": 2,
      "text": "Combine soaked dates, almonds, coconut, walnuts, 2 tablespoons toasted sesame seeds, coconut oil, vanilla, cardamom, cinnamon, and salt in the bowl of a large food processor; pulse several times until mixture forms a soft \"dough,\" scraping down the sides of the bowl as needed. If mixture is too dry, add reserved soaking liquid, 1 tablespoon at a time, until desired consistency is reached."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a piece of parchment paper; roll into a 10-inch-long by 1 1/2-inch-wide log using lightly greased hands. Sprinkle remaining 2 tablespoons toasted sesame seeds evenly on all sides of dough log, pressing them in gently. Wrap log in parchment paper; refrigerate until firm, at least 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Cut log into about sixteen 1/2-inch-thick rounds. Serve immediately or store in the refrigerator until ready to eat."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

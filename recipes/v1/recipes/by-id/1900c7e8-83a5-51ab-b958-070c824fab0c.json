  "id": "1900c7e8-83a5-51ab-b958-070c824fab0c",
  "slug": "chewy-peanut-butter-brownies",
  "name": "Chewy Peanut Butter Brownies",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter brownies are an irresistible favorite, so you might as well double the recipe when you make them. Try with chocolate frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C ). Grease a 9x9-inch baking pan."
    },
    {
      "position": 2,
      "text": "Cream together peanut butter and margarine in a medium bowl. Gradually blend in white sugar, brown sugar, eggs, and vanilla; mix until fluffy."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, and salt in a separate bowl. Stir into the peanut butter mixture until well blended."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top springs back when touched, 30 to 35 minutes. Cool and cut into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "de482218-d916-5cef-8227-2e175cfb10b2",
  "slug": "chicken-enchilada-casserole-i",
  "name": "Easy Chicken Enchilada Casserole",
  "recipe_type": "soup",
  "brief_description": "Cook chicken with cheese, chiles, tomatoes and canned soups, then layer with tortillas for an easy take on Mexican enchiladas.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine chicken, cream of celery soup, cream of chicken soup, enchilada sauce, diced tomatoes and green chiles, onion, garlic, chicken broth, chili powder, and cheese in a 5-quart pot. Cook over medium-high heat, stirring occasionally, until cheese is melted and ingredients are well combined."
    },
    {
      "position": 3,
      "text": "Spread a thin layer of chicken mixture in the bottom of a 9x13-inch baking dish. Layer remaining chicken mixture and tortillas in the dish as you would lasagna. Bake in the preheated oven until bubbly and cheese is lightly browned, 45 minutes to 1 hour. Let stand for at least 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

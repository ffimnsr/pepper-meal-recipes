  "id": "91bd1f61-6965-515d-83d9-99b6be8a8505",
  "slug": "vegan-chocolate-mousse-with-aquafaba",
  "name": "Vegan Chocolate Mousse with Aquafaba",
  "recipe_type": "dessert",
  "brief_description": "This is a delicious and light three-ingredient-only chocolate mousse, made with aquafaba (chickpea water) and vegan dark chocolate.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt chocolate in top of a double boiler over simmering water, about 5 minutes. Remove from heat and let cool."
    },
    {
      "position": 2,
      "text": "Beat aquafaba in a stand mixer on high speed until firm peaks form, 10 to 15 minutes. Add sugar gradually into the mixture while continuing to beat. Fold in cooled chocolate gently."
    },
    {
      "position": 3,
      "text": "Spoon mousse into small glass cups and chill in the refrigerator for at least 4 hours before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "5255d010-2e48-5f27-99f6-7d634b67d703",
  "slug": "lemon-pesto-sauce-recipe-11755856",
  "name": "Lemon Pesto Sauce",
  "recipe_type": "side",
  "brief_description": "This lemon pesto sauce, a pesto that hails from the Amalfi Coast of Italy, is bright and rich, made with zesty, slightly bitter lemon zest rather than basil leaves. It has so many uses: try it as a spread, a pasta sauce, over chicken, or as the base of a dip.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Using a Y-peeler, remove yellow zest from lemons in large strips, avoiding the bitter white pith as much as possible. This should yield about 1/2 cup zest. Juice lemons to yield 1/4 cup juice. Discard juiced, skinned lemons; reserve any unjuiced lemons for another use."
    },
    {
      "position": 3,
      "text": "Place lemon zest, lemon juice, Parmesan, almonds, water, garlic, salt, sugar, pepper, and 3 tablespoons oil in the jar of a blender; process until lemon zest is finely chopped and mixture is roughly combined, about 15 seconds, stopping to scrape down sides as needed."
    },
    {
      "position": 4,
      "text": "With blender running, slowly pour remaining 3 tablespoons oil through food chute, processing until mostly smooth and emulsified, about 1 minute, stopping to scrape down sides as needed."
    },
    {
      "position": 5,
      "text": "Use immediately or store in an airtight container for up to 1 week. This recipe was developed by Tricia Manzanero Stuedeman"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

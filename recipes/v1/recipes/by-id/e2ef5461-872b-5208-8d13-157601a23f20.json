  "id": "e2ef5461-872b-5208-8d13-157601a23f20",
  "slug": "seven-layer-casserole",
  "name": "Seven Layer Casserole",
  "recipe_type": "soup",
  "brief_description": "Tasty and filling, this is a wonderful 'got everything in the house' recipe!! This recipe is very versatile. I have substituted many different ingredients like yams, corn and even cheese soup. It all comes out yummy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a lightly greased 9x13 inch baking dish layer the rice, potatoes, onion, carrots, peas, tomato soup with water, and sausage. Salt and pepper to taste."
    },
    {
      "position": 3,
      "text": "Bake covered at 350 degrees F (175 degrees C) for 45 minutes, or until fork tender. Remove cover for last 5 minutes of baking."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

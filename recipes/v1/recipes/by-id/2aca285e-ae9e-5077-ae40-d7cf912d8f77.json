  "id": "2aca285e-ae9e-5077-ae40-d7cf912d8f77",
  "slug": "basic-coquito",
  "name": "Basic Coquito",
  "recipe_type": "drink",
  "brief_description": "This basic coquito recipe, also known as the eggnog of Puerto Rico, is truly the easiest and most delicious to make. It's thick, rich, and very creamy.",
  "cuisine": "Puerto Rican Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Pour sweetened condensed milk, cream of coconut, coconut milk, evaporated milk, rum, and cinnamon into a large container with a lid. Shake or stir well to combine."
    },
    {
      "position": 2,
      "text": "Refrigerate until chilled, at least 1 hour. Shake or stir before serving."
    }
  ],
  "servings": 14,

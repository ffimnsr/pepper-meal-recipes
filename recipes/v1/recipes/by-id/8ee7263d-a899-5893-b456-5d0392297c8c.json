  "id": "8ee7263d-a899-5893-b456-5d0392297c8c",
  "slug": "overnight-slow-cooker-oatmeal",
  "name": "Overnight Slow Cooker Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Have a pot of warm oatmeal, made with dried fruit and almond milk, waiting for you when you awake in the morning thanks to this recipe and your slow cooker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir water, almond milk, applesauce, steel-cut oats, dried cherries, brown sugar, vanilla, and cinnamon together in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 hours overnight."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 480,

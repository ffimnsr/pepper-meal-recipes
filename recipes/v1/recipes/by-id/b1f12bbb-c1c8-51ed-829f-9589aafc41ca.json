  "id": "b1f12bbb-c1c8-51ed-829f-9589aafc41ca",
  "slug": "mini-strawberry-hand-pies",
  "name": "Mini Strawberry Hand Pies",
  "recipe_type": "dessert",
  "brief_description": "I was looking for an easy and simple recipe to use up some strawberries that I had. Made with only 4 ingredients. Serve as-is or top with a powdered sugar and milk glaze.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring pie crust to room temperature. Place strawberries in a bowl and sprinkle with sugar. Set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Roll out pie crust. Use a 4-inch pastry cutter to cut out 6 rounds."
    },
    {
      "position": 4,
      "text": "Divide strawberries equally amongst the 6 rounds. Wet fingers with water and run them along the edges of each round. Fold rounds in half and press edges together using the tines of a fork until sealed. Transfer to the prepared baking sheet. Brush with beaten egg and cut a small slit in each pie."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned, 20 to 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "7fd68b64-6982-5e48-a9eb-c59fb31c4816",
  "slug": "quick-and-easy-mexican-breakfast-tacos",
  "name": "Quick and Easy Mexican Breakfast Tacos",
  "recipe_type": "breakfast",
  "brief_description": "These quick and easy vegetarian breakfast tacos are filled with cheese, black beans, and eggs scrambled with spices, scallions, and spinach.",
  "cuisine": "Mexican Inspired American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a large skillet with cooking spray; warm over medium-high heat. Whisk eggs together in a bowl. Pour into the skillet. Add spinach, green onions, garlic salt, and Cajun seasoning. Cook and stir until eggs are nearly set, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour black beans into a small pot over medium heat. Cook, stirring occasionally, until heated through, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle Mexican cheese blend over tortillas. Place tortillas on microwave-safe plates or paper towels. Microwave 2 tortillas at a time, about 30 minute seconds. Repeat with remaining tortillas."
    },
    {
      "position": 4,
      "text": "Divide egg mixture and beans over the center of the tortillas. Top with salsa and sour cream."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 11,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

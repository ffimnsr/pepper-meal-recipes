  "id": "0e4955d6-3057-592b-8eaf-9302b0252c4d",
  "slug": "chicken-pot-pie-with-crescent-rolls",
  "name": "Chicken Pot Pie with Crescent Rolls",
  "recipe_type": "soup",
  "brief_description": "This chicken pot pie with crescent rolls, rotisserie chicken, condensed soup, canned potatoes, and frozen mixed vegetables is an easy, no-fuss meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line the bottom of an ungreased 9x13-inch baking dish with one can of crescent roll dough, pinching the seams together."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Add chicken breast, rotisserie chicken, frozen vegetables, and sliced potatoes. Cook, stirring frequently, until vegetables are thawed and mixture is heated through, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, warm both cans of condensed soup in a separate pan over medium-low heat. Slowly pour in milk and cook, stirring frequently, until combined and heated through, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Add soup mixture to chicken mixture; stir until well combined. Season with salt and pepper. Pour mixture into the prepared baking dish. Top with the second can of crescent roll dough; do not pinch the seams on these. Cover lightly with aluminum foil to prevent crescent rolls from browning too quickly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through and rolls are golden brown, 40 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f966e888-a1ec-5c3b-9837-64c1f4ba3996",
  "slug": "christmas-ornament-cheese-ball-recipe-8759389",
  "name": "Christmas Ornament Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This Christmas ornament cheese ball is the perfect festive holiday appetizer. It\u2019s a simple mix of cream cheese, ranch seasoning, bacon, and dill pickles, patted into a ball, and topped with a Christmas ornament hanger, as tasty as it is cute.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese, Ranch-style dressing mix, dill pickles, and bacon together in a large bowl; shape mixture into a ball."
    },
    {
      "position": 2,
      "text": "Cover in plastic wrap and chill in the refrigerator for at least 4 hours or overnight before serving."
    },
    {
      "position": 3,
      "text": "Place chopped dill on a plate or in a shallow bowl. Remove chilled cheese ball from plastic wrap and roll the cheese ball in dill until evenly coated on all sides."
    },
    {
      "position": 4,
      "text": "Top with ornament top, optional. Serve with crackers."
    }
  ],
  "servings": 23,

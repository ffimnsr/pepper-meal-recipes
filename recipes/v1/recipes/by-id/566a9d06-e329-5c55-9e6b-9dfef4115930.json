  "id": "566a9d06-e329-5c55-9e6b-9dfef4115930",
  "slug": "cowboy-butter-corn-ribs-recipe-12026973",
  "name": "Cowboy Butter Corn Ribs",
  "recipe_type": "appetizer",
  "brief_description": "These cowboy butter corn ribs are the perfect combination of sweet, savory, and zingy flavors. Cooked until tender, crisped in the air fryer, and brushed with rich, melty cowboy butter, they\u2019re an irresistible side dish. Fair warning\u2014you\u2019ll want to put that cowboy butter on everything!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place corn in a large microwave-safe bowl. Add water and cover with plastic wrap, leaving a corner open for ventilation. Microwave on HIGH until tender, about 3 minutes. Remove and transfer to a cutting board to cool for 1 minute. Using a sharp knife, carefully trim corn ends. Cut each ear of corn in half vertically, rocking the knife carefully as you cut downward. Finally, cut each half lengthwise into 2 two pieces."
    },
    {
      "position": 2,
      "text": "Combine olive oil, salt, and black pepper in a large bowl. Add corn ribs and toss to coat."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Line air fryer basket with parchment paper."
    },
    {
      "position": 4,
      "text": "Cooking in batches, add about 8 corn ribs to the prepared basket in a single layer. Cook until corn is browned in a few spots and ribs are curled, about 10 minutes. Repeat with remaining corn ribs."
    },
    {
      "position": 5,
      "text": "Meanwhile, in a small bowl, microwave cowboy butter on High until melted, about 1 minute and 30 seconds. Generously brush cowboy butter on hot corn ribs. Transfer to a serving plate. Recipe developed by Amanda Stanfield Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

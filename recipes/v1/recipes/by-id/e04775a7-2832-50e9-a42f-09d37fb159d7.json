  "id": "e04775a7-2832-50e9-a42f-09d37fb159d7",
  "slug": "breakfast-grits",
  "name": "Breakfast Grits",
  "recipe_type": "breakfast",
  "brief_description": "Learn how to cook grits with this recipe. Fresh pepper and sharp Cheddar cheese liven up this dish. Simple and tasty, just the way grits should be.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and salt to a boil in a saucepan. Whisk in grits; continue to whisk for 1 minute."
    },
    {
      "position": 3,
      "text": "When the mixture comes to a boil again, turn the heat to low. Stir frequently, cook for 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Remove grits from the heat and add cheese, butter, and pepper; mix well."
    },
    {
      "position": 5,
      "text": "Stir until butter and cheese are melted."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

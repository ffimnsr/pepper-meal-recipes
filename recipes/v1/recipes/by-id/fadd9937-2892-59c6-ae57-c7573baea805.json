  "id": "fadd9937-2892-59c6-ae57-c7573baea805",
  "slug": "quick-beef-stir-fry",
  "name": "Quick Beef Stir-Fry",
  "recipe_type": "main",
  "brief_description": "This beef stir-fry recipe is quick and easy for busy weeknights. Thin slices of beef sirloin are stir-fried with colorful vegetables and soy sauce.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large wok or skillet over medium-high heat; add beef and stir-fry until browned, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Move beef to the side of the wok and add broccoli, bell pepper, carrots, green onion, and garlic to the center of the wok; stir-fry vegetables for 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir beef into vegetables and season with soy sauce and sesame seeds. Continue to cook and stir until vegetables are tender, about 2 more minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

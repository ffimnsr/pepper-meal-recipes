  "id": "393165b1-b2c1-5934-8269-ee66af1a1b86",
  "slug": "coconut-oil-popcorn",
  "name": "Coconut Oil Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Coconut oil popcorn with sea salt is a perfect, delicious, and easy snack alternative to traditional oil-popped popcorn. It's ready in 5 minutes too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place popcorn and oil in a 3-quart pot over medium heat and cover the pot with a lid."
    },
    {
      "position": 2,
      "text": "Shake the pot constantly as popcorn pops. When popping slows to a few seconds between pops, after about 3 to 5 minutes, remove pot from heat and pour popcorn into a large bowl. Season with sea salt."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

  "id": "fb4675d0-868b-5abe-9792-210c6199cee7",
  "slug": "easy-slow-cooker-cheesy-potato-soup-with-ham",
  "name": "Slow Cooker Cheesy Potato Soup with Ham",
  "recipe_type": "soup",
  "brief_description": "This cheesy potato soup with Cheddar, cream cheese, and ham is rich, creamy, and comforting. It's simple to prep, and the slow cooker does the rest!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine hash browns, ham, onion, celery, chicken broth, salt, pepper, and garlic powder in a slow cooker. Stir well to combine. Place the lid on the slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low heat until celery is soft, 4 to 5 hours."
    },
    {
      "position": 3,
      "text": "Mix in cream cheese and Cheddar cheese. Stir until cheese is melted. Cover and cook on Low for an additional 30 minutes, stirring occasionally. Serve topped with chopped green onions as a garnish."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

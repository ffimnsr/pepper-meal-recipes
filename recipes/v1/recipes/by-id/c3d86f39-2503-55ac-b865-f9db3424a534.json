  "id": "c3d86f39-2503-55ac-b865-f9db3424a534",
  "slug": "buffalo-tempeh-sliders",
  "name": "Buffalo Tempeh Sliders",
  "recipe_type": "main",
  "brief_description": "Tempeh is topped with Buffalo sauce, blue cheese, and celery in these pita pocket sliders that will delight vegetarians at your next party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place tempeh in a large bowl and cover with Buffalo sauce. Set aside to marinate, 10 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove tempeh from Buffalo sauce, reserving sauce. Heat oil in a large skillet over medium-high heat. Cook tempeh in a single layer, in batches, until heated through and lightly browned, about 3 minutes per side. Pour some Buffalo sauce back over tempeh to coat."
    },
    {
      "position": 3,
      "text": "Combine blue cheese, cilantro, green bell pepper, celery, and onion in a large bowl. Mix in enough Greek yogurt until topping just holds together."
    },
    {
      "position": 4,
      "text": "Divide tempeh pieces among pita pockets; top with a spoonful of the topping. Top with remaining Buffalo sauce."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,

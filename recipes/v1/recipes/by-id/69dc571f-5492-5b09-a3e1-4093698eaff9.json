  "id": "69dc571f-5492-5b09-a3e1-4093698eaff9",
  "slug": "spinach-stuffed-mushrooms",
  "name": "Spinach Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for savory spinach-stuffed mushrooms includes a cheesy bread crumb filling made with three types of cheese: Gouda, mozzarella, and Parmesan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Lightly grease 30 muffin cups with olive oil. Brush all sides mushrooms with remaining olive oil; place gill-sides-up into the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until mushrooms just tender, about 12 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat egg, garlic, salt, and black pepper together in a bowl; stir in spinach, 1/4 cup Parmesan cheese, Gouda cheese, mozzarella cheese, and bread crumbs until evenly combined."
    },
    {
      "position": 5,
      "text": "Remove mushrooms from oven; drain and discard any accumulated juice. Fill mushroom caps with spinach mixture; return to the muffin cups. Sprinkle mushrooms with remaining 1/4 cup Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Bake until stuffing is hot and golden brown, about 10 minutes."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

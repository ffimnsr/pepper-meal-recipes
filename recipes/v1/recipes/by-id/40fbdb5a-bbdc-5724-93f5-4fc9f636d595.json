  "id": "40fbdb5a-bbdc-5724-93f5-4fc9f636d595",
  "slug": "jalapeno-margaritas",
  "name": "Jalape\u00f1o Margaritas",
  "recipe_type": "drink",
  "brief_description": "Try this jalape\u00f1o margarita made with fresh jalape\u00f1o peppers, tequila, triple sec, agave, and lime juice for a refreshing cocktail with a spicy kick!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1/4 to 1/2 inch of salt onto a small, shallow plate. Moisten the rim of 2 margarita glasses with water and dip into salt. Fill with ice and set aside."
    },
    {
      "position": 2,
      "text": "Fill a shaker with ice. Pour tequila, triple sec, lime juice, agave nectar, and jalape\u00f1o into the shaker. Cover and shake vigorously until the outside of the shaker has frosted."
    },
    {
      "position": 3,
      "text": "Strain into the prepared glasses. Garnish with lime wedges to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

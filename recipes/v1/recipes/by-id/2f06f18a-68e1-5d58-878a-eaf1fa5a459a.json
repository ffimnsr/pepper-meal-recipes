  "id": "2f06f18a-68e1-5d58-878a-eaf1fa5a459a",
  "slug": "old-fashioned-butter-rolls-recipe-11772519",
  "name": "Old-Fashioned Butter Rolls",
  "recipe_type": "breakfast",
  "brief_description": "These old-fashioned butter rolls are made with a buttery biscuit dough formed into cinnamon swirls, then baked under a milky glaze. They\u2019re pillowy and soft, and ready to eat with no rising needed.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Butter a 13x9-inch baking dish."
    },
    {
      "position": 2,
      "text": "For dough, whisk together flour, sugar, baking powder, and salt in a large bowl. Cut in cold butter until mixture resembles coarse crumbs. Stir in milk until a stiff dough forms."
    },
    {
      "position": 3,
      "text": "Lightly flour a work surface, and roll dough out into a 15x13-inch rectangle."
    },
    {
      "position": 4,
      "text": "For filling, stir together sugar, cinnamon, and nutmeg in a small bowl. Spread softened butter evenly over rolled dough, and sprinkle with cinnamon mixture."
    },
    {
      "position": 5,
      "text": "Starting with a short end, tightly roll dough into a 13-inch-long log. Trim ends slightly, and cut log crosswise into 12 (1-inch) rounds using a serrated knife."
    },
    {
      "position": 6,
      "text": "Place rounds, cut sides up, in a single layer, spaced about 1/2 inch apart in the prepared baking dish; set aside."
    },
    {
      "position": 7,
      "text": "For sauce, stir together milk, sugar, butter, and salt in a medium saucepan. Cook over high heat, stirring often, until milk begins to foam and sugar is dissolved, about 5 minutes. Remove from heat and stir in vanilla. Pour mixture evenly over dough rounds. They will be nearly submerged."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until rolls are firm and golden brown on top, about 35 minutes. Let stand for 5 minutes; serve warm. Recipe developed by Giovanna Vasquez"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "91bca41c-a6e2-5336-be59-6311e5a1913a",
  "slug": "spicy-tomato-and-lentil-soup",
  "name": "Spicy Tomato and Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "A quick, easy and tasty recipe for thick lentil soup. Serve with thickly sliced crusty bread for a filling and delicious meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the olive oil in a large saucepan or Dutch oven. Lightly brown the onions in the oil. Add the tomatoes, chili pepper, lentils, cumin and basil to the pan along with the water. Bring to a boil, then reduce heat to medium-low and simmer for about 20 minutes, or until the lentils are tender."
    },
    {
      "position": 2,
      "text": "When the lentils have softened, use a stick blender to puree the soup. Season to taste with salt and pepper. For a special touch, put sour cream in a squirt bottle, and squeeze a spiral onto the top of each bowl of soup, and garnish with a sprig of fresh basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c85f63c2-60ae-59e7-81ff-0532065b0396",
  "slug": "hawaiian-pineapple-chicken",
  "name": "Hawaiian Pineapple Chicken",
  "recipe_type": "dessert",
  "brief_description": "This sweet and tangy baked chicken with pineapple and brown sugar is a family-favorite recipe. It's like a little Hawaiian vacation on a plate!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Add ketchup and brown sugar and stir until sugar dissolves. Whisk cornstarch into vinegar in a small bowl until smooth, then pour into the pan. Whisk in salt, soy sauce, and Worcestershire sauce and bring to a simmer while continuing to whisk constantly. Cook until thickened, about 2 minutes. Stir in pineapple and remove from the heat."
    },
    {
      "position": 3,
      "text": "Arrange chicken pieces in a 9x13-inch baking dish; pour pineapple sauce over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the sauce is bubbling and the chicken is browned and the juices run clear, about 45 minutes. An instant-read meat thermometer inserted into the thickest part of a thigh should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "0ed8d0eb-e289-59fb-a30e-70280730a649",
  "slug": "classic-cinnamon-rolls",
  "name": "Classic Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "First Place Winner at the 2008 Iowa State Fair!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine potatoes, potato water, butter, sugar, salt and hot water in large mixing bowl. Stir until butter melts; set aside and let cool. Combine yeast and 1/2 cup warm water in small bowl. Let rest 5 minutes. Add eggs, 2 cups flour and yeast mixture to potato mixture. Beat until well mixed. Continue adding flour, 1 cup at a time until soft dough forms."
    },
    {
      "position": 2,
      "text": "Knead on a lightly floured surface until smooth and elastic (about 4 to 6 minutes), OR knead with electric mixer using dough hook. Place in a greased bowl, turning to coat. Cover."
    },
    {
      "position": 3,
      "text": "Let rise in a warm, draft free area about 1 hour, until doubled in size. Punch dough down; divide in half."
    },
    {
      "position": 4,
      "text": "Roll one portion of dough on a lightly floured surface to a 12 x 18-inch rectangle. Spread with half the butter. Combine sugar and cinnamon; sprinkle half of the mixture over surface. Roll up tightly lengthwise, sealing edges. Cut into 12 slices. Place in greased 13 x 9-inch pan. Repeat with remaining dough. Cover."
    },
    {
      "position": 5,
      "text": "Let rise 30 to 45 minutes until nearly doubled."
    },
    {
      "position": 6,
      "text": "Bake in preheated 350 degrees F oven for 25 to 30 minutes."
    },
    {
      "position": 7,
      "text": "Cool for 15 minutes. Combine icing ingredients and drizzle over rolls."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": 5,
  "difficulty": "medium",

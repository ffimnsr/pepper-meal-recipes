  "id": "13741e11-9915-557b-85e5-22f315eddc93",
  "slug": "cliffanys-monkey-bread",
  "name": "Cliffany's Monkey Bread",
  "recipe_type": "breakfast",
  "brief_description": "This quick and easy monkey bread recipe calls for refrigerated biscuit dough covered with a brown sugar and cinnamon syrup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine sugar, 2 tablespoons cinnamon, and nutmeg together in a bag. Drop biscuit quarters into bag and shake well to coat biscuits."
    },
    {
      "position": 3,
      "text": "Stir margarine, brown sugar, and 2 teaspoons cinnamon together in a saucepan over medium-high heat. Cook and stir until sugar dissolves and mixture has a syrup consistency, 2 to 5 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Arrange 1/3 the biscuits in bottom of a tube or fluted tube pan (such as Bundt\u00ae) and pour 1/3 the syrup over the top. Repeat layering process 2 more times."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bread is golden and cooked through, about 35 minutes. Cool in the pan for 5 minutes and turn bread out onto a serving plate."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

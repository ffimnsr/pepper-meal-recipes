  "id": "e6843b5e-1761-58f0-a0c2-fa94a3701d9d",
  "slug": "bacon-popcorn",
  "name": "Bacon Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Popcorn kernels are popped in bacon grease and tossed with seasoned salt in this super savory popcorn recipe. Add bacon bits and shredded cheese if you like!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon grease into a 6-quart pot and place over high heat. Add one or two popcorn kernels as testers. When test kernels pop, add remaining popcorn kernels and cover with a lid. As kernels start to pop, shake the pan back and forth constantly to keep unpopped kernels on the bottom. When popping slows down, remove the pan from heat and let it finish popping."
    },
    {
      "position": 2,
      "text": "Pour popcorn into a large bowl or paper sack. Season with 1/2 of the seasoned salt and stir. Taste before adding more salt if desired. Toss with bacon bits and shredded Cheddar cheese for an extra special treat. Store leftovers in lunch sacks or sandwich bags."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,

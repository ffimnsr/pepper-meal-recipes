  "id": "af621b47-bee3-5fc5-a323-f9605efa618d",
  "slug": "nanaimo-bars-iii",
  "name": "Nanaimo Bars",
  "recipe_type": "dessert",
  "brief_description": "These Nanaimo bars have three layers of coconut-graham crust, thick custard, and silky chocolate. A delicious no-bake bar worth the effort to make!",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "In the top of a double boiler, combine 1/2 cup softened butter, cocoa powder, and sugar. Stir occasionally until melted and smooth. Beat in egg and stir until thick, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Remove from the heat and mix in graham cracker crumbs, coconut, and almonds. Press into the bottom of an ungreased 8x8-inch pan."
    },
    {
      "position": 4,
      "text": "For the middle layer, beat remaining 1/2 cup softened butter, heavy cream, and custard powder until light and fluffy. Mix in confectioners' sugar until smooth. Spread over the bottom layer in the pan. Chill to set."
    },
    {
      "position": 5,
      "text": "While the second layer is chilling, melt semisweet chocolate and 2 teaspoons butter together in the microwave or over low heat."
    },
    {
      "position": 6,
      "text": "Spread melted chocolate mixture over chilled bars."
    },
    {
      "position": 7,
      "text": "Let the chocolate set before cutting into squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

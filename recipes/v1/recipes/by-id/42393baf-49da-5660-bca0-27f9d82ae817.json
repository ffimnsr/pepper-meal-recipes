  "id": "42393baf-49da-5660-bca0-27f9d82ae817",
  "slug": "steamed-zucchini",
  "name": "Steamed Zucchini",
  "recipe_type": "side",
  "brief_description": "This steamed zucchini is quick to make for a healthy side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim ends from zucchini. Cut each one in half, then cut each half lengthwise into quarters."
    },
    {
      "position": 2,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add zucchini to the steamer insert; cover and steam until tender, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Transfer zucchini to a large bowl. Mash garlic and place in the bowl with zucchini. Drizzle with olive oil; toss until zucchini is evenly coated."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "814d8708-ceff-5d92-a108-0d8d22268ca8",
  "slug": "baked-beans-with-beef",
  "name": "Baked Beans with Beef",
  "recipe_type": "side",
  "brief_description": "Baked beans, ground beef, and peppered bacon simmer for 4 hours in a slow cooker for the ultimate make-ahead crowd-pleasing baked beans with beef recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add ground beef and onion; cook and stir until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease. Transfer beef mixture to a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook bacon in the same skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Transfer to paper towels to drain. Crumble into small pieces; add to the slow cooker."
    },
    {
      "position": 3,
      "text": "Add baked beans, black beans, light and dark kidney beans, great northern beans, sugar, mustard, and soy sauce to the slow cooker; stir to combine."
    },
    {
      "position": 4,
      "text": "Cover slow cooker; cook on Medium until flavors meld, about 4 hours."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 255,
  "preparation_time_minutes": 15,

  "id": "380f372e-9934-5668-9574-ce015bc3ff7c",
  "slug": "bacon-cheese-frittata",
  "name": "Easy Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Make this classic frittata with eggs, bacon, and cheese, or try other variations with any add-ins you like for a satisfying brunch or meal anytime.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). If you don't have a 10-inch oven-proof skillet, lightly grease a 7x11-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place bacon in a large oven-proof skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble and set aside."
    },
    {
      "position": 3,
      "text": "Whisk eggs, milk, melted butter, salt, and pepper together in a bowl; pour into oven-proof skillet or prepared baking dish. Sprinkle with green onions and crumbled bacon. Cover with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, 25 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

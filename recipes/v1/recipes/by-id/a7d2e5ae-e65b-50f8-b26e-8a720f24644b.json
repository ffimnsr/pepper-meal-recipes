  "id": "a7d2e5ae-e65b-50f8-b26e-8a720f24644b",
  "slug": "vanilla-cupcakes-from-scratch",
  "name": "Vanilla Cupcakes from Scratch",
  "recipe_type": "dessert",
  "brief_description": "Baking vanilla cupcakes from scratch is easier than it sounds. Impress your friends or kids with your baking prowess with this simple recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line two 12-cup muffin tins with paper liners."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt together in a bowl. Whisk milk, eggs, and vanilla together in a separate bowl."
    },
    {
      "position": 3,
      "text": "Beat sugar, butter, and shortening together in a large mixing bowl with an electric mixer until creamy. Mix in flour mixture. Add milk mixture and beat on low speed for 30 seconds. Increase speed to high and beat until smooth, about 2 minutes. Fill the prepared muffin cups 1/2 full with batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes. Cool in the tin for 5 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

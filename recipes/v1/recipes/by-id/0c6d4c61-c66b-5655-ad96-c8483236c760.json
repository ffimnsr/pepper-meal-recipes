  "id": "0c6d4c61-c66b-5655-ad96-c8483236c760",
  "slug": "disappearing-marshmallow-brownies-ii",
  "name": "Disappearing Marshmallow Brownies II",
  "recipe_type": "dessert",
  "brief_description": "This rich butterscotch, chocolate, marshmallow mix is sure to be a hit with all.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "In a heavy saucepan over medium heat, melt butterscotch chips and butter, stirring constantly until smooth. Remove from heat and cool to room temperature. Stir in the flour, brown sugar, baking powder, salt, vanilla and eggs until well blended. Mix in the mini marshmallows and chocolate chips. Spread evenly into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake for 20 to 25 minutes in the preheated oven. Center will shake but it will firm upon cooling. Wonderful with ice cream. Enjoy!!!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

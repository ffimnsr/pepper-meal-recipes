  "id": "97f3f99f-1360-52ad-8701-da424f7fd485",
  "slug": "gluten-free-peach-cobbler",
  "name": "Gluten-Free Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This gluten free peach cobbler bakes juicy peaches topped with a tender gluten free biscuit topping. An easy summer dessert everyone can enjoy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix peaches, sugar, flour, cinnamon, and nutmeg together in a bowl."
    },
    {
      "position": 3,
      "text": "Pour into a 9x13-inch casserole dish and dab butter pieces over top."
    },
    {
      "position": 4,
      "text": "To make the topping: Mix flour, sugar, soy milk, baking powder, xanthan gum, and salt together in a bowl. Sprinkle over peaches in the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until fruit is bubbly and the top is golden brown, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Let cobbler cool before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

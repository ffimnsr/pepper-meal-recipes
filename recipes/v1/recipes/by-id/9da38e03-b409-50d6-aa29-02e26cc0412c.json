  "id": "9da38e03-b409-50d6-aa29-02e26cc0412c",
  "slug": "stuffed-portobello-mushrooms",
  "name": "Sausage-Stuffed Portobello Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Stuffed with pork sausage, shredded and ricotta cheeses, onions and sun-dried tomatoes, these tasty mushroom caps are a sure crowd pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F. Combine sausage, 1 cup shredded cheese, ricotta cheese, onions and tomatoes in large bowl."
    },
    {
      "position": 2,
      "text": "Brush tops of mushroom caps with oil; place, top-sides down, in shallow baking pan."
    },
    {
      "position": 3,
      "text": "Top with sausage mixture. Drizzle with vinegar, if desired. Sprinkle with remaining shredded cheese."
    },
    {
      "position": 4,
      "text": "Bake 10-12 minutes or until mushrooms are tender."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

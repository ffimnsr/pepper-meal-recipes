  "id": "afe9c92b-ee38-51b7-a552-8332180ccce1",
  "slug": "teriyaki-beef-jerky",
  "name": "Teriyaki Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "Strips of beef are marinated in teriyaki sauce, soy sauce, and a blend of pineapple and garlic in this easy smoked jerky recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix teriyaki sauce, soy sauce, brown sugar, and Worcestershire sauce in a large bowl."
    },
    {
      "position": 2,
      "text": "Place pineapple and garlic in a food processor or blender; process until smooth. Pour pineapple mixture and teriyaki mixture into a resealable plastic bag. Add beef, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 6 to 8 hours."
    },
    {
      "position": 3,
      "text": "Preheat smoker to 225 to 250 degrees F (110 to 120 degrees C). Drain beef and discard marinade."
    },
    {
      "position": 4,
      "text": "Smoke beef in the preheated smoker until jerky is dry and chewy but not crispy, 6 to 8 hours. Store jerky in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 15,

  "id": "af510db5-8807-5c20-996a-79f3b05f4f6c",
  "slug": "kristens-bacon-ranch-potato-salad",
  "name": "Kristen's Bacon Ranch Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Kristen's bacon ranch potato salad recipe, with red potatoes, crispy bacon, Cheddar cheese, sour cream, and green onions, is delicious and easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with lightly salted water; bring to a boil over high heat. Reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain; rinse under cold water until cool."
    },
    {
      "position": 2,
      "text": "Combine sour cream and ranch dressing mix in a large bowl. Add potatoes, green onions, Cheddar cheese, and bacon; fold together until well-coated. Cover the bowl with plastic wrap; refrigerate before serving, about 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

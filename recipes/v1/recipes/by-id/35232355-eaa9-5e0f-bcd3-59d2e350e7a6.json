  "slug": "big-batch-limoncello-basil-spritz-recipe-8598096",
  "name": "Big Batch Limoncello Basil Spritz",
  "recipe_type": "appetizer",
  "brief_description": "This big batch limoncello basil spritz combines sweet-tart limoncello, bubbly Prosecco, sparkling water, and zesty basil for a refreshing summer drink in a recipe large enough to serve 8.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Muddle fresh basil leaves in a pitcher."
    },
    {
      "position": 3,
      "text": "Stir in chilled Prosecco, limoncello, and chilled sparkling water. Serve immediately in ice-filled glasses."
    },
    {
      "position": 4,
      "text": "Garnish with additional basil leaves and lime wedges."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

  "id": "700ff00d-79e0-55c7-854a-045cbe5ec7d8",
  "slug": "grandmas-creamy-peanut-butter-fudge",
  "name": "Grandma's Creamy Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Nothing spreads cheer like a batch of homemade peanut butter fudge, made Grandma's style in this easy, no-fuss recipe by Chef John.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sift sugar through a fine-mesh strainer into a large bowl."
    },
    {
      "position": 2,
      "text": "Heat butter and peanut butter in a saucepan over medium heat. Whisk to combine and cook until bubbles appear on the edges, 3 to 5 minutes. Stir in salt and vanilla extract. Pour over powdered sugar in the bowl. Mix together using a spatula until smooth."
    },
    {
      "position": 3,
      "text": "Spread mixture into an 8x8-inch baking pan lined with plastic wrap. Wrap fully and refrigerate until firm enough to cut but not too hard, 1 to 3 hours."
    },
    {
      "position": 4,
      "text": "Unwrap fudge and cut into small cubes. Let warm up on the counter before cutting if needed."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

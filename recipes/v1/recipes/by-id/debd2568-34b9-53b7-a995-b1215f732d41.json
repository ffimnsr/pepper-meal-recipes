  "id": "debd2568-34b9-53b7-a995-b1215f732d41",
  "slug": "three-pepper-pilaf",
  "name": "Three Pepper Pilaf",
  "recipe_type": "side",
  "brief_description": "This colorful dish features red, green and yellow bell peppers with in turmeric-gold rice and scarlet tomatoes. Beautiful to look at, even better to eat.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot, boil chicken pieces in chicken stock, adding onion and garlic to stock before boiling. When chicken is cooked through, remove from stock and set aside. Add turmeric and stir in, then set stock aside."
    },
    {
      "position": 2,
      "text": "In a large skillet, heat oil. Add mushrooms and saute for 1 minute. Add rice, stir for 2 minutes, then add stock. Let all simmer gently for 20 minutes. In the meantime, skin and slice tomatoes and add to pilaf mixture. Cut cooked chicken into bite size pieces and add to the skillet, along with the red, green and yellow bell peppers. Stir all together and simmer over low heat, stirring, until all liquid is absorbed and rice is separate and fluffy."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

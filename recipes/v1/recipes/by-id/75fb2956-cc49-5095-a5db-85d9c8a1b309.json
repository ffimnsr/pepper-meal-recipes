  "id": "75fb2956-cc49-5095-a5db-85d9c8a1b309",
  "slug": "best-brownies",
  "name": "Best Brownies",
  "recipe_type": "dessert",
  "brief_description": "This brownie recipe makes moist, delicious brownies that are cakey on the outside and fudgy in the middle. The chocolate frosting makes them the best!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Melt 1/2 cup butter in a large saucepan. Remove from heat, and stir in sugar, eggs, and 1 teaspoon vanilla. Beat in 1/3 cup cocoa, flour, salt, and baking powder. Spread batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 25 to 30 minutes. Let cool briefly before frosting."
    },
    {
      "position": 4,
      "text": "To make the chocolate frosting: Combine softened butter, confectioners' sugar, 3 tablespoons cocoa, honey, and 1 teaspoon vanilla extract in a bowl. Stir until smooth. Frost brownies while they are still slightly warm."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

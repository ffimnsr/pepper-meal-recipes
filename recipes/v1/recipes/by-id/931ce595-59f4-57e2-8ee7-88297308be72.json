  "id": "931ce595-59f4-57e2-8ee7-88297308be72",
  "slug": "crispy-tofu-bites",
  "name": "Crispy Tofu Bites",
  "recipe_type": "main",
  "brief_description": "The secret to crispy tofu is pressing out all the water; a simple coating also boosts the crunch factor in this quick and easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain tofu, place on a plate, and stack heavy plates on top of tofu to drain any remaining moisture, about 15 minutes. Slice into 24 bite-sized pieces."
    },
    {
      "position": 2,
      "text": "Combine flour, cornstarch, salt, and pepper in a large resealable plastic bag. Toss tofu into the bag, seal, and shake to coat. Transfer tofu to a plate, shaking off any excess flour mixture."
    },
    {
      "position": 3,
      "text": "Pour oil into a skillet over medium-high heat until just smoking. Cook tofu in hot oil, turning often, until golden brown on all sides, about 5 minutes per side."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

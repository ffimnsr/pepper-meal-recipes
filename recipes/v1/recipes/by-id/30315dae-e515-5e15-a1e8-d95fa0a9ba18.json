  "id": "30315dae-e515-5e15-a1e8-d95fa0a9ba18",
  "slug": "satisfying-eggnog",
  "name": "Satisfying Eggnog",
  "recipe_type": "drink",
  "brief_description": "This eggnog uses rich egg yolks, nutmeg, and vanilla extract for traditional flavor, but calls for nonfat milk and sugar substitute to keep things on the lighter side.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together the nonfat milk, evaporated milk, sucralose sweetener, nutmeg, and egg yolks in a heavy saucepan. Warm over very low heat, stirring constantly, until the mixture reaches 160 degrees F (70 degrees C), about 10 minutes. Pour the eggnog through a strainer. Stir in vanilla extract. Refrigerate until chilled, about 2 hours."
    },
    {
      "position": 2,
      "text": "Just before serving, stir in dark rum, if using."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

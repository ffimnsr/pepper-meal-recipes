  "id": "182df780-b030-5f55-b570-b0293fe126d6",
  "slug": "baked-tofu-slices",
  "name": "Baked Tofu Slices",
  "recipe_type": "main",
  "brief_description": "Baked slices of tofu are topped with a mixture of soy sauce, chile-garlic sauce, Sriracha, and sesame seeds in this simple baked tofu recipe.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange tofu slices onto a baking sheet. Brush olive oil over the top of each slice. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned on top, 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, make sauce: Stir together green onion, soy sauce, Sriracha, sesame oil, chile-garlic sauce, sesame seeds, and garlic in a small bowl."
    },
    {
      "position": 5,
      "text": "Spoon sauce over tofu slices. Continue baking until sauce is warmed, 3 to 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

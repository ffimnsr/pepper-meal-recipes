  "id": "5cc93f00-5ea9-5f3c-8736-d034c887806d",
  "slug": "sweet-and-sour-meatballs-suan-tien-niu-jou-po-lo-la-tzu",
  "name": "Sweet and Sour Meatballs (Suan T'ien Niu Jou Po Lo La Tzu)",
  "recipe_type": "appetizer",
  "brief_description": "Beef meatballs, carrot, onion and pineapple pieces simmered in a pineapple sweet and sour sauce. Serve hot over steamed white rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "In a mixing bowl, combine the ground beef, egg, cornstarch, salt, diced onion and pepper. Form into 1-inch meatballs; you'll get about 20 total."
    },
    {
      "position": 2,
      "text": "In a large skillet over medium heat, brown the meatballs; drain fat and set aside."
    },
    {
      "position": 3,
      "text": "Heat the oil in a large saucepan over low heat. Pour in the pineapple juice and simmer for a few minutes."
    },
    {
      "position": 4,
      "text": "In a small bowl, combine the 3 tablespoons of cornstarch, soy sauce, vinegar and water. Stir until smooth and pour into the pineapple juice. Add the sugar and simmer until thickened, stirring constantly."
    },
    {
      "position": 5,
      "text": "Place the meatballs, pineapple pieces, green pepper, carrot and onion into the sauce mixture. Heat thoroughly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

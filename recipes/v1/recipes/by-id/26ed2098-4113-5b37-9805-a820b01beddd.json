  "id": "26ed2098-4113-5b37-9805-a820b01beddd",
  "slug": "jills-cherry-crisp",
  "name": "Jill's Cherry Crisp",
  "recipe_type": "dessert",
  "brief_description": "Jill's cherry crisp recipe includes tart cherries nestled between two crumbly oat layers for a decadent, fruity dessert. Serve with vanilla ice cream.",
  "cuisine": "American British Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, flour, oats, butter, and cinnamon in a bowl until crumbly; press \u00bd crust mixture into the bottom of an 8x8-inch pan. Top crust with cherries."
    },
    {
      "position": 3,
      "text": "Combine water, white sugar, cornstarch, and vanilla extract in a saucepan over medium heat; bring to a simmer. Cook and stir until sugar dissolves and syrup is clear, about 5 minutes. Pour syrup over cherries; top with remaining crust mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until topping is brown and filling is bubbling, 30 to 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

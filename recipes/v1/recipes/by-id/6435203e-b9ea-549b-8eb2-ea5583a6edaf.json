  "id": "6435203e-b9ea-549b-8eb2-ea5583a6edaf",
  "slug": "super-easy-samosa-pie",
  "name": "Super Easy Samosa Pie",
  "recipe_type": "main",
  "brief_description": "No need to fry your samosas when you fill a pie crust with seasoned potatoes in this super easy recipe for samosa pie.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a pot with water and add the salt; bring to a boil. Cook potatoes in the boiling water until tender, about 12 minutes. Transfer potatoes to a bowl and mash until chunky."
    },
    {
      "position": 3,
      "text": "Mix peas, pepper, and coriander into potatoes."
    },
    {
      "position": 4,
      "text": "Press pie crust into a 9-inch pie dish; fill with potato mixture. Sprinkle mint over filling. Carefully place second pie crust over the filling and pinch both crusts together to seal."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "c89e10b6-1b2b-5f30-866f-bcd2076fcd6b",
  "slug": "air-fryer-chicken-quesadillas-recipe-8651412",
  "name": "Air Fryer Chicken Quesadillas",
  "recipe_type": "appetizer",
  "brief_description": "Air fryer chicken quesadillas are an easy dish made even easier using cooked shredded chicken, any combination of melty cheese, and the air fryer.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C), according to manufacturer\u2019s guidelines. Toss chicken with chili powder, cumin, and cayenne in a bowl."
    },
    {
      "position": 2,
      "text": "Place a tortilla on a work surface and cover half the tortilla with about 2 tablespoons grated cheese. Top with 2 tablespoons chicken mixture, then top with 2 additional tablespoons grated cheese."
    },
    {
      "position": 3,
      "text": "Fold tortilla in half and use wooden picks to hold the tortilla halves together. Spray both sides of the filled tortilla with olive oil spray."
    },
    {
      "position": 4,
      "text": "Air fry quesadillas in a single layer until tortillas are lightly browned and cheese is melted, about 4 minutes per side. You may have to cook in batches. Serve warm with your favorite toppings."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

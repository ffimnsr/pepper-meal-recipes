  "schema_version": 1,
  "id": "b89c7ac6-09d5-5db8-85ab-d698364d6d85",
  "slug": "creamy-after-thanksgiving-turkey-soup",
  "name": "Cream of Turkey Soup",
  "recipe_type": "soup",
  "brief_description": "This hearty cream of turkey soup simmers leftover Thanksgiving turkey with veggies and noodles in a rich, creamy broth for a comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place turkey carcass in a large pot or Dutch oven and cover with water. Bring to a boil. Reduce heat to medium, cover, and simmer for 1 hour."
    },
    {
      "position": 3,
      "text": "Remove carcass and allow to cool. Separate turkey meat from bones. Cut meat into bite-sized pieces; discard bones. Reserve 12 cups turkey broth in a large bowl. Save remaining broth for another use."
    },
    {
      "position": 4,
      "text": "Melt butter in the same large pot over medium heat; cook and stir onion, celery, and carrots in hot butter until tender, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Sprinkle with flour; cook and stir until smooth, about 5 minutes. Gradually stir in 4 cups reserved turkey broth. Bring to a boil; cook and stir until thickened, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Stir in remaining 8 cups turkey broth, turkey meat, half-and-half, noodles, stuffing, salt, bouillon, pepper, and poultry seasoning. Reduce heat to medium-low, cover, and simmer until noodles are tender, about 10 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "expert",

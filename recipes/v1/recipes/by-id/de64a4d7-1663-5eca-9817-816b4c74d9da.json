  "schema_version": 1,
  "id": "de64a4d7-1663-5eca-9817-816b4c74d9da",
  "slug": "sous-vide-mashed-potatoes",
  "name": "Sous Vide Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Using your sous vide immersion cooker to make mashed potatoes may take longer than boiling potatoes, but it really intensifies the potato flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water and place a sous vide immersion cooker into the water. Set temperature to 195 degrees F (91 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Peel potatoes and cut into cubes, no bigger than 3/4 inch. Place potatoes in a single layer inside a large vacuum bag, along with cubed butter, 1/2 cup half-and-half, and sour cream. Ensure potatoes are spread out as much as possible. Seal the bag using a vacuum sealer, stopping the sealer early so liquid doesn't escape from the bag."
    },
    {
      "position": 3,
      "text": "Place bag into the water and set timer for 90 minutes. Some air may remain in the bag, and you will need to weigh the bag down with a heavy object to ensure bag is fully submerged. After 45 minutes, remove bag and redistribute potatoes evenly in bag, if needed."
    },
    {
      "position": 4,
      "text": "When timer is up, cut bag open and dump contents into a large bowl. Season with salt and pepper and mash potatoes. Add in additional half-and-half, if needed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

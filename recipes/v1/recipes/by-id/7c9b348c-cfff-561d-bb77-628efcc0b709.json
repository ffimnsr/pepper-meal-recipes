  "id": "7c9b348c-cfff-561d-bb77-628efcc0b709",
  "slug": "grandmas-rhubarb-torte",
  "name": "Grandma's Rhubarb Torte",
  "recipe_type": "dessert",
  "brief_description": "Grandma's rhubarb torte recipe offers a sweet rhubarb filling in a simple homemade crust, topped with a lovely, creamy, golden-brown baked meringue.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat 1 \u00bd cups flour, butter, and 1 tablespoon sugar in a large bowl with an electric mixer until combined; press into the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until firm, about 15 minutes. Leave oven on. Cool crust."
    },
    {
      "position": 4,
      "text": "Combine remaining \u00bc cup flour, rhubarb, 2 cups sugar, evaporated milk, and egg yolks; pour over crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is set, about 1 hour. Leave oven on."
    },
    {
      "position": 6,
      "text": "Beat egg whites in a large glass, metal, or ceramic bowl with an electric mixer until foamy. Beat in remaining \u00be cup sugar and vanilla extract until stiff peaks form; spread meringue over rhubarb filling."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until meringue is golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

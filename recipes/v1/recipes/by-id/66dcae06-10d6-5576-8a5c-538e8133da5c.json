  "slug": "cajun-spice-mix",
  "name": "Cajun Seasoning Spice Mix",
  "recipe_type": null,
  "brief_description": "This easy Cajun seasoning mix can be made at home with common spices from your pantry including paprika, garlic powder, thyme, and cayenne pepper.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir paprika, salt, garlic powder, oregano, thyme, black pepper, onion powder, cayenne pepper, and red pepper flakes together in a bowl until evenly blended."
    },
    {
      "position": 3,
      "text": "Store spice mix in an airtight container."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

  "id": "dfef7e86-d8b2-5dc7-a000-5b9a3fb35411",
  "slug": "tuna-melt-nachos-recipe-8733919",
  "name": "Tuna Melt Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These tuna melt nachos bring the best tuna melt sandwich components to everyone's favorite sports-watching season appetizer, nachos.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Break up tuna in a bowl with a fork into small flakes. Add celery, black pepper, cayenne, and mayonnaise. Mix well, cover, and refrigerate until needed."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Line a sheet pan with foil, and space chips out evenly on the pan. Top each chip with a generous rounded teaspoon tuna salad."
    },
    {
      "position": 3,
      "text": "Place a jalapeno ring on top of tuna, followed by a slice of tomato, pressing down lightly as you do. Top with cheese, piling it as high as possible in the middle of each nacho. Use any extra cheese to cover exposed areas of chips."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and the edges of chips are turning golden brown, 5 to 8 minutes. Alternately, preheat the oven\u2019s broiler and broil nachos for just a few minutes until cheese melts and chip edges are golden."
    },
    {
      "position": 5,
      "text": "Scatter green onions over the top, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

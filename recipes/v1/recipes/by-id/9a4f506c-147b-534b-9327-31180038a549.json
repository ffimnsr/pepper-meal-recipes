  "id": "9a4f506c-147b-534b-9327-31180038a549",
  "slug": "air-fryer-stuffed-peppers-recipe-11808461",
  "name": "Air Fryer Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These air fryer stuffed peppers are made with Italian sausage, and cook quickly enough to serve on a weeknight. Notes are provided if you prefer to make them in a slow cooker, and they are also tasty made with ground beef.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an air fryer to 350 degrees F (180 degrees C), according to manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Cut tops off bell peppers; remove stems, seeds, and membranes; set aside."
    },
    {
      "position": 3,
      "text": "Add Italian sausage, parsley, Italian seasoning, salt, red pepper flakes, black pepper, and garlic powder to a nonstick skillet over medium heat. Cook and stir until sausage is browned, breaking up clumps with a spatula, 7 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir in spaghetti sauce, Roma tomato, rice, mozzarella, and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Spoon mixture into bell peppers."
    },
    {
      "position": 6,
      "text": "Place stuffed peppers in the basket of the air fryer and fry until peppers are soft, 15 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

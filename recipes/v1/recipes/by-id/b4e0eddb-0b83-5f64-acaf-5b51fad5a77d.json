  "id": "b4e0eddb-0b83-5f64-acaf-5b51fad5a77d",
  "slug": "chef-johns-corned-beef-hash",
  "name": "Chef John's Corned Beef Hash",
  "recipe_type": "breakfast",
  "brief_description": "A little roasted tomato salsa is the secret ingredient in Chef John's diner-style corned beef hash recipe that's perfect for brunch.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until almost tender but still firm, about 15 minutes. Drain and finely chop."
    },
    {
      "position": 2,
      "text": "Cook beef in a large cast iron or nonstick skillet over medium heat until fat begins to render. Stir green onions, salt, and pepper into beef. Add garlic and butter; cook and stir until butter is melted and garlic is fragrant, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir potatoes, salsa, and a pinch of salt into beef mixture. Pat mixture down in the skillet with a spatula and divide hash into 4 sections."
    },
    {
      "position": 4,
      "text": "Cook, without stirring, until a crust forms on the bottom, about 5 minutes. Flip sections and cook until a crust forms on the bottom, about 5 minutes more. Repeat cooking and flipping process, flipping every 5 minutes, until hash stays together and has a golden crust, 10 to 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d26fdc2c-664d-5bca-90cd-8dc1d125c92c",
  "slug": "sunset-sangria",
  "name": "Sunset Sangria Recipe",
  "recipe_type": "dessert",
  "brief_description": "This sweet, sunset sangria recipe is made with citrus fruit, raspberries, and pineapple juice for a refreshing offering at your next summer gathering.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine wine, pineapple juice, vodka, simple syrup, and triple sec in a pitcher or large bowl. Refrigerate until chilled, about 1 hour."
    },
    {
      "position": 2,
      "text": "Stir raspberries, oranges, lemons, and limes into chilled sangria, at least 30 minutes before serving. Serve over ice."
    }
  ],
  "servings": 6,

  "slug": "zucchini-pesto-recipe-11829743",
  "name": "Zucchini Pesto",
  "recipe_type": "side",
  "brief_description": "This zucchini pesto, bright green and summery, is made with basil, shredded zucchini, and pumpkin seeds. Use it on pasta, on bruschetta, or in any other way you typically use pesto.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add basil leaves and garlic to the bowl of a food processor. Pulse until chopped and combined. Pat zucchini with paper towels to remove as much liquid as possible. Add to the food processor and pulse until incorporated."
    },
    {
      "position": 2,
      "text": "Add pumpkin seeds and half of cheese mixture to the food processor, then pulse to combine. Add remaining cheese. While the machine is running or in slow batches, process in the olive oil. Taste; season with salt and pepper."
    }
  ],
  "servings": 16,

  "id": "bdb43014-024e-5009-8d61-de0d745da5e1",
  "slug": "robins-cheesy-chipotle-grits",
  "name": "Robin's Cheesy Chipotle Grits",
  "recipe_type": "side",
  "brief_description": "These spicy, creamy grits are a hit at every family barbeque. People ask me for the recipe every time I make them.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Lightly grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "Heat the olive oil in a saucepan over medium heat. Stir in the onion, and cook until the onion softens and turns translucent, about 5 minutes. Pour in the chicken broth and milk. Bring to a boil over high heat, then turn the heat to low. Slowly whisk in the grits, then cover the saucepan, and cook for 5 minutes."
    },
    {
      "position": 3,
      "text": "Once the grits have cooked, stir in the salt, pepper, cumin, chipotle peppers, green chiles, and 1 cup of Cheddar cheese until the cheese has melted. Pour the grits into the prepared 9x13 inch dish, and sprinkle with the remaining 1/2 cup of Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the cheese is bubbly, and has begun to brown, 30-45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

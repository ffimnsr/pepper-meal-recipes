  "id": "938ad4b8-a678-5b0f-858a-8cd62829a239",
  "slug": "grilled-chicken-adobo",
  "name": "Grilled Chicken Adobo",
  "recipe_type": "main",
  "brief_description": "Dark chicken thigh meat is cooked in a rich soy sauce, garlic, and vinegar mixture, then tossed on the grill until crisp. Serve over rice.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat, and lightly oil grate."
    },
    {
      "position": 2,
      "text": "In a large pot, mix soy sauce, water, vinegar, honey, garlic, bay leaves, and pepper. Bring the mixture to a boil, and place the chicken into the pot. Reduce heat, cover, and cook 35 to 40 minutes."
    },
    {
      "position": 3,
      "text": "Remove chicken, drain on paper towels, and set aside. Discard bay leaves. Return the mixture to a boil, and cook until reduced to about 1 1/2 cups."
    },
    {
      "position": 4,
      "text": "Place chicken on the prepared grill, about 5 minutes on each side, until browned and crisp. Serve with the remaining soy sauce mixture."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

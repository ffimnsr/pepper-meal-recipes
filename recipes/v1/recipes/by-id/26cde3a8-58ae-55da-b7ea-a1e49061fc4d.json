  "id": "26cde3a8-58ae-55da-b7ea-a1e49061fc4d",
  "slug": "white-chocolate-thumbprint-cookies",
  "name": "White Chocolate Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "Festive white chocolate thumbprint cookies are drizzled with melted white chocolate for a colorful holiday treat. For the centers, use any flavored jam.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter, sugar, and vanilla extract together in a bowl until smooth and creamy. Combine flour and baking powder in a separate bowl; gradually beat into butter mixture until dough is smooth. Fold in walnuts. Refrigerate dough for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Roll dough into 72 small balls and place 2 inches apart onto baking sheets. Press centers of balls using your thumb to form small wells; fill wells with jam."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are light golden brown, about 18 minutes."
    },
    {
      "position": 5,
      "text": "Cool cookies on baking sheets for 5 minutes; transfer to wire racks to cool completely."
    },
    {
      "position": 6,
      "text": "Meanwhile, place white chocolate and shortening in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until melted; drizzle over cookies."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

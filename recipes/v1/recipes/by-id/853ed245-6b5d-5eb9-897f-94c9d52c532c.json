  "id": "853ed245-6b5d-5eb9-897f-94c9d52c532c",
  "slug": "cheesy-buffalo-chicken-casserole",
  "name": "Cheesy Buffalo Chicken Casserole",
  "recipe_type": "snack",
  "brief_description": "Rice, chicken tenders, and ranch dressing are layered in this hearty, cheesy Buffalo chicken casserole recipe fans of Buffalo wings and cheese will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil; add chicken tenders and cook until no longer pink in centers and an instant-read thermometer inserted into centers reads at least 165 degrees F (75 degrees C), 10 to 15 minutes. Drain; cool until easy to handle, about 5 minutes. Shred chicken with 2 forks."
    },
    {
      "position": 3,
      "text": "Add cream cheese to a blender; blend until smooth. Add ranch dressing, wing sauce, and water; blend until smooth. Stir in shredded chicken and Colby-Jack cheese."
    },
    {
      "position": 4,
      "text": "Spread rice in a 9x13-inch baking dish. Pour Buffalo chicken mixture on top; sprinkle with Cheddar cheese. Cover baking dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, about 45 minutes. Sprinkle chips on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "c74212b8-785d-56a0-bc41-056a7f8fd736",
  "slug": "fried-cabbage-with-bacon-onion-and-garlic",
  "name": "Fried Cabbage with Bacon, Onion, and Garlic",
  "recipe_type": "side",
  "brief_description": "Fried cabbage with bacon creates a delicious combo of flavors for a hearty side. Cooking it low and slow makes it melt-in-your-mouth irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place bacon in a large stockpot and cook over medium-high heat until crispy, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Add onion and garlic; cook and stir until onion caramelizes, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Immediately stir in cabbage and continue to cook and stir another 10 minutes."
    },
    {
      "position": 5,
      "text": "Season with salt, pepper, onion powder, garlic powder, and paprika. Reduce heat to low, cover, and simmer, stirring occasionally, about 30 minutes more."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

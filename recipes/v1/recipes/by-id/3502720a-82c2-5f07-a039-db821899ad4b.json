  "id": "3502720a-82c2-5f07-a039-db821899ad4b",
  "slug": "easy-vegan-gingerbread-cookies",
  "name": "Easy Vegan Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These vegan gingerbread cookies made with coconut oil, molasses, and warm spices make the perfect Christmas treat for vegan friends and family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sift flour, baking powder, cinnamon, baking soda, ginger, allspice, and salt into a bowl."
    },
    {
      "position": 2,
      "text": "Beat coconut oil, molasses, and sugar in a separate bowl with an electric mixer on medium speed until well-combined; add vanilla extract. Stir in flour mixture and mix to form a sticky dough, about 2 minutes. Wrap dough in plastic wrap and chill for 2 hours."
    },
    {
      "position": 3,
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Roll out dough on a floured surface to a thickness of 1/4 inch. Cut dough into desired shapes with cookie cutters, dipping the cutters into flour as needed so they don't stick to the dough; place them on the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm, about 8 to 10 minutes. Cool on the baking sheets briefly before transferring them to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

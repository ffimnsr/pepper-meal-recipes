  "id": "d962de00-ae1d-5c02-87eb-de6dc4384eb2",
  "slug": "winter-root-vegetable-soup",
  "name": "Winter Root Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "This winter root vegetable soup recipe combines the earthy, comfort flavors of parsnips, carrots, celery root, turnips, sweet potato, and butternut squash.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine parsnips, carrots, turnips, butternut squash, celery root, and sweet potato in a large roasting pan. Drizzle with olive oil; season with 1 teaspoon salt and \u00bd teaspoon black pepper. Toss vegetables to evenly distribute seasonings."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until vegetables are easily pierced with a fork, 30 to 45 minutes, stirring every 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, melt butter in a large pot or Dutch oven over medium heat. Stir in diced celery and onion; cook and stir until onion softened and turned translucent, about 5 minutes. Add vegetable broth; bring to a simmer, uncovered. Stir in roasted vegetables; continue simmering for 10 minutes. Pur\u00e9e soup with an immersion blender until smooth. Stir in half-and-half; season with salt and black pepper. Add more vegetable broth if soup seems too thick."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

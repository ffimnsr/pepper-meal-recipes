  "schema_version": 1,
  "id": "d0bce851-84e4-5973-a69e-a122c656b154",
  "slug": "jenns-out-of-this-world-spaghetti-and-meatballs",
  "name": "Jenn's Out Of This World Spaghetti and Meatballs",
  "recipe_type": "main",
  "brief_description": "This authentic spaghetti and meatballs recipe is made with fresh oregano and parsley. Because the meatballs are cooked in the sauce, they are tender and savory.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium heat. Add onion; cook and stir until lightly brown. Mix in 2 cloves garlic and cook for 1 minute. Stir in crushed tomatoes, tomato paste, water, sugar, 1/2 the oregano, and bay leaf. Season with salt and pepper. Bring to a boil, reduce heat to low, and simmer while preparing meatballs."
    },
    {
      "position": 2,
      "text": "Mix ground round, bread crumbs, remaining oregano, remaining garlic, parsley, eggs, and cheese in a large bowl. Season with salt and pepper. Roll into 1 inch balls, and drop into the sauce. Cook 40 minutes in the sauce, or until internal temperature of meatballs reaches a minimum of 160 degrees F (72 degrees C). Remove bay leaf."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil, and stir in the spaghetti. Cook 8 to 10 minutes, until al dente; drain. Serve meatballs and sauce over cooked spaghetti."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

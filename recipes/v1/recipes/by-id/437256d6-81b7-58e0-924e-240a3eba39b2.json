  "id": "437256d6-81b7-58e0-924e-240a3eba39b2",
  "slug": "mexican-layered-dip",
  "name": "Mexican Layered Dip",
  "recipe_type": "appetizer",
  "brief_description": "This layered Mexican dip with refried beans, guacamole, sour cream, and taco seasoning is a no-bake dip that you can easily tuck into with chips.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Spread refried beans in the bottom of a 1-quart shallow glass serving dish. Sprinkle taco seasoning over beans; top with a layer of diced tomatoes, a layer of sour cream, and a layer of guacamole. Sprinkle Cheddar cheese evenly over dip; top with green onions and black olives."
    },
    {
      "position": 2,
      "text": "Cover and refrigerate for 2 hours or until ready to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

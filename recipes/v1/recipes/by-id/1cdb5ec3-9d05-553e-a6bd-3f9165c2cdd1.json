  "id": "1cdb5ec3-9d05-553e-a6bd-3f9165c2cdd1",
  "slug": "pizza-salad-i",
  "name": "Pizza Salad",
  "recipe_type": "salad",
  "brief_description": "Except for the crust, it's pizza! It's got tomato sauce, lots of cheese, salami, olives, herbs, and a great dressing drizzled over everything before serving.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine lettuce, salami, mozzarella cheese, Cheddar cheese, tomato, olives, and chives in a large bowl. Mix well to combine."
    },
    {
      "position": 2,
      "text": "Make dressing: Whisk together tomato sauce, oil, vinegar, sugar, oregano, salt, garlic powder, and pepper in a medium bowl."
    },
    {
      "position": 3,
      "text": "Pour enough dressing over lettuce mixture to coat; toss and serve."
    }
  ],
  "servings": 6,

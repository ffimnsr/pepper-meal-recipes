{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "85678a2e-be2f-56f6-9025-9f7796e0b54d",
  "slug": "fried-mac-and-cheese-balls",
  "name": "Fried Mac and Cheese Balls",
  "recipe_type": "main",
  "brief_description": "Mac and cheese balls are a fun, delicious finger food. This mac takes cheese to the max with 3 kinds, then gets breaded and fried to golden goodness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Fill a pot with lightly salted water and bring to a rolling boil over high heat. Stir in macaroni, and return to a boil. Cook, uncovered, stirring occasionally until macaroni is cooked through but still firm to the bite, about 7 minutes. Drain. Stir in butter, 1/4 cup milk, and cheese packet from the macaroni and cheese package."
    },
    {
      "position": 3,
      "text": "While macaroni is still hot, stir in Cheddar cheese, pimento cheese spread, and Italian cheese blend, and continue to stir until melted."
    },
    {
      "position": 4,
      "text": "Place the macaroni and cheese mixture into a container and refrigerate until firm, about 4 hours."
    },
    {
      "position": 5,
      "text": "Line a baking sheet with parchment paper. Remove the macaroni mixture from the refrigerator, and using a cookie scoop, scoop into balls. Place mac balls on the prepared baking sheet and freeze for at least 2 hours."
    },
    {
      "position": 6,
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C). Make a breading station: Whisk bread crumbs with paprika, chili powder, black pepper, sugar, salt, and cayenne in a shallow dish; set aside. Beat eggs with 3 tablespoons milk in a small bowl. Remove the mac balls from the freezer, coat in egg mixture, and then dredge in breading."
    },
    {
      "position": 7,
      "text": "Fry the mac balls in hot oil in small batches until golden brown, 3 to 5 minutes. Drain briefly on a paper towel-lined plate; serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 40,

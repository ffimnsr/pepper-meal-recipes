  "id": "15505dac-09b9-5c29-98d1-9550b83db3b0",
  "slug": "easy-ranch-spaghetti-carbonara",
  "name": "Easy Ranch Spaghetti Carbonara",
  "recipe_type": "main",
  "brief_description": "Spaghetti carbonara gets a quick and easy flavor upgrade with the addition of ranch seasoning to the classic egg sauce.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add spaghetti and cook until al dente, 10 to 12 minutes. Drain."
    },
    {
      "position": 2,
      "text": "While the pasta is cooking, whisk the eggs, yolks, Hidden Valley\u00ae Original Ranch\u00ae Salad Dressing and Seasoning Mix, a small pinch of black pepper, and cheese together in a mixing bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet set over medium heat. Add the bacon and saute for about about 5 to 7 minutes, until beginning to crisp."
    },
    {
      "position": 4,
      "text": "Drain pasta, reserving 1 cup of the pasta water. Add pasta to the skillet with the bacon over low heat. Stir to coat the pasta. Transfer pasta and bacon to a bowl, add the egg mixture and a small amount of the reserved pasta water for creaminess. Toss well to coat. Serve immediately with extra cheese for garnish."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ad5464e3-4b0b-5227-ba14-e4a813dab621",
  "slug": "best-oyster-chowder-ever",
  "name": "Best Oyster Chowder Ever",
  "recipe_type": "soup",
  "brief_description": "Fresh oysters mixed with potatoes and corn in a cream base make the best oyster chowder ever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook oysters and reserved liquid in a skillet over medium heat until edges curl, 5 to 10 minutes. Remove skillet from heat."
    },
    {
      "position": 2,
      "text": "Combine onion, potato, broccoli, water, and corn in a saucepan; bring to a boil. Reduce heat and simmer until vegetables are tender, 10 to 15 minutes. Drain vegetables and reserve liquid."
    },
    {
      "position": 3,
      "text": "Melt butter in a large pan over medium heat. Stir flour into melted butter until smooth, about 1 minute. Slowly pour reserved vegetable water and milk into butter-flour mixture; cook until thickened, about 5 minutes. Add oysters and vegetables to milk mixture and cook over medium-low heat until heated through, about 5 minutes. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

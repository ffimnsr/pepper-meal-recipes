  "slug": "pesto-quinoa",
  "name": "Pesto Quinoa",
  "recipe_type": "soup",
  "brief_description": "Quinoa is cooked in chicken broth, seasoned with pesto, and mixed with fresh tomato in this Ecuadorian side dish of quinoa with pesto.",
  "cuisine": "South American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring quinoa and chicken broth to a boil in a saucepan; cover, reduce heat to low, and simmer until liquid is completely absorbed, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Remove the saucepan from heat; stir pesto into quinoa. Fold tomato into mixture. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

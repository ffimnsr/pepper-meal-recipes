  "id": "e564b9ef-4dfe-5667-9de5-cebcc674b182",
  "slug": "easy-chicken-marsala",
  "name": "Easy Chicken Marsala",
  "recipe_type": "main",
  "brief_description": "Chicken Marsala made with tender chicken breasts simmered in creamy Marsala wine sauce with mushrooms\u2014a restaurant favorite ready in 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Add chicken and cook, turning once halfway through, until golden brown on both sides and no longer pink in the center, about 10 minutes. An instant-read thermometer inserted into the center should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Add mushrooms and green onions to the skillet; saut\u00e9 until softened and lightly browned, about 5 minutes. Pour in Marsala wine and use a wooden spoon to scrape up any browned bits from the bottom of the pan; bring to a boil."
    },
    {
      "position": 4,
      "text": "Stir in heavy cream and milk. Cook over low heat until warmed through, taking care not to let the sauce boil. Season with salt and ground black pepper. Garnish with fresh parsley and serve with lemon wedges."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

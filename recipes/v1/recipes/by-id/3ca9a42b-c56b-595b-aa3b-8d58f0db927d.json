  "id": "3ca9a42b-c56b-595b-aa3b-8d58f0db927d",
  "slug": "home-style-chicken-piccata",
  "name": "Home-Style Chicken Piccata",
  "recipe_type": "main",
  "brief_description": "Chicken is breaded and cooked in the skillet with a squeeze of lemon in this quick and easy, home-style chicken piccata recipe.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, garlic powder, and paprika together in a bowl. Beat egg in a separate bowl. Melt butter in a skillet over medium heat."
    },
    {
      "position": 2,
      "text": "Dip chicken in egg until coated. Dredge chicken through flour mixture until evenly coated, shaking off excess."
    },
    {
      "position": 3,
      "text": "Fry chicken in the melted butter until browned, 2 to 3 minutes per side. Add chicken broth to skillet, cover, and cook until chicken is not longer pink in the center, about 20 minutes. Squeeze lemon over chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

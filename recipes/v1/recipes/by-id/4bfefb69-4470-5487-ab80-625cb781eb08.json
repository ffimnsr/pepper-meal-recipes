  "id": "4bfefb69-4470-5487-ab80-625cb781eb08",
  "slug": "air-fryer-chile-verde-burritos",
  "name": "Air Fryer Chile Verde Burritos",
  "recipe_type": "main",
  "brief_description": "Try these small chile verde burritos made in the air fryer with leftover pulled pork for a quick and easy lunch or dinner.",
  "cuisine": "U.S. American Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Combine pulled pork, salsa verde, and cojita cheese in a bowl. Stir until evenly combined."
    },
    {
      "position": 3,
      "text": "Place a heaping tablespoon of filling into the bottom half of a tortilla. Make 2 folds on either side of the large fold, creating an envelope shape. Roll it up using the tips of your fingers to tuck the filling in as you go. Repeat with remaining tortillas."
    },
    {
      "position": 4,
      "text": "Spray the basket of the air fryer with nonstick cooking spray. Place some burritos in the basket seam side-down, making sure to not overcrowd. Spray the tops of the burritos with cooking spray."
    },
    {
      "position": 5,
      "text": "Air fry for for 6 minutes. Repeat with remaining burritos. Serve with additional salsa verde for dipping if desired."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "coconut-overnight-oats-with-protein-powder",
  "name": "Coconut Overnight Oats with Protein Powder",
  "recipe_type": "dessert",
  "brief_description": "These protein powder overnight oats are creamy and full of coconut flavor. Feel free to sweeten to taste and top with extra toasted coconut.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix coconut milk beverage, Greek yogurt, oats, coconut, and protein powder in a bowl until well combined. Divide mixture between 2 Mason jars. Refrigerate for 8 hours, or overnight."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "49591969-a5c8-5dc7-a698-6c4dae76403d",
  "slug": "slow-cooker-chicken-and-stuffing-casserole-recipe-11880365",
  "name": "Slow Cooker Chicken and Stuffing Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker chicken and stuffing casserole transforms leftover Thanksgiving stuffing into a deliciously creamy, stick-together chicken and stuffing meal right in the crockpot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For marinade, add melted butter, olive oil, salt, pepper, thyme, garlic powder, Dijon mustard, and maple syrup to a resealable plastic bag; massage the bag to combine. Add chicken, reseal the bag, and massage the bag to coat chicken in marinade. Let rest for about 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, for sauce, melt 2 1/2 tablespoons butter in a heavy saucepan over medium heat. Slowly whisk in flour. Cook for 1 minute."
    },
    {
      "position": 3,
      "text": "Slowly whisk in bone broth. Stir in milk. Cook, stirring, until the sauce becomes noticeably thicker than gravy."
    },
    {
      "position": 4,
      "text": "Add Worcestershire and remove from heat. Let mixture cool slightly. Slowly mix in yogurt to avoid curdling. If using the whisked egg, stir it in now."
    },
    {
      "position": 5,
      "text": "Spray a slow cooker with cooking spray. Add half the stuffing in an even layer. Nestle chicken breasts on top of stuffing. Pour sauce mixture over chicken; add remaining stuffing and press gently into place."
    },
    {
      "position": 6,
      "text": "Cook on Low until chicken is no longer pink at the center and juices run clear, 3 1/2 to 4 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "af51d214-e690-559a-baf9-5e16caa96783",
  "slug": "tortellini-in-chicken-broth",
  "name": "Tortellini in Chicken Broth",
  "recipe_type": "soup",
  "brief_description": "Tortellini soup in chicken broth is called tortellini en brodo in Italy. It is a snap to make after a long day at the office.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir broth and water together in a pot; bring to a boil."
    },
    {
      "position": 2,
      "text": "Stir frozen tortellini into broth mixture and cook, occasionally stirring, until tortellini floats to the top and filling is hot, 6 to 8 minutes. Stir watercress and scallions into broth mixture and cook until watercress wilts, about 2 minutes. Add hot pepper sauce."
    },
    {
      "position": 3,
      "text": "Sprinkle with Romano cheese and black pepper to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

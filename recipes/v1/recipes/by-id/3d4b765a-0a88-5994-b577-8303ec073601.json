  "id": "3d4b765a-0a88-5994-b577-8303ec073601",
  "slug": "heart-shaped-pizza-recipe-8430817",
  "name": "Heart-Shaped Pizza",
  "recipe_type": "main",
  "brief_description": "This heart-shaped pizza is made using pre-made pizza dough and a few simple ingredients. A perfect Valentine's Day dinner or to show the pizza fans in your life that you love them.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Allow dough to come to room temperature, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Divide the dough into 2 unequal pieces. One piece of dough should be smaller. Take the larger piece and press out into a square shape. Take the smaller piece and roll into a circle. Cut the circle in half."
    },
    {
      "position": 4,
      "text": "Take a teaspoon of oil and brush a pizza stone. Position the dough square on the pizza stone with one point of the square pointing down."
    },
    {
      "position": 5,
      "text": "Position the straight side of a dough half circle along the upper left edge of the square. Place the other half circle along the upper right edge of the square. Press seams together to join."
    },
    {
      "position": 6,
      "text": "Spread pizza sauce over dough to 1/2-inch from the edge. Top pizza with shredded cheese, sausage and pepperoni."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted and crust is golden, 17 to 19 minutes. Let rest 3 minutes before slicing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 17,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 3,
  "difficulty": "medium",

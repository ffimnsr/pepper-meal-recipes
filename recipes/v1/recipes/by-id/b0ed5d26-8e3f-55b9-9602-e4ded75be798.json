  "id": "b0ed5d26-8e3f-55b9-9602-e4ded75be798",
  "slug": "ruths-eggplant-caponata",
  "name": "Ruth's Eggplant Caponata",
  "recipe_type": "salad",
  "brief_description": "A side dish, salad, or relish, caponata with eggplant, garlic, tomatoes, herb and spices is delicious on crusty French bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Cook eggplant, onion, garlic, oregano, cinnamon, allspice, salt, and pepper, stirring frequently, until onion is slightly browned, 7 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium and add tomatoes, water, wine, and bay leaf. Simmer, stirring frequently, until eggplant is tender and mixture is thickened, 13 to 15 minutes. Remove from heat and stir in sugar, capers, and vinegar. Let cool 30 minutes, then discard bay leaf. Serve at room temperature or chilled."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,

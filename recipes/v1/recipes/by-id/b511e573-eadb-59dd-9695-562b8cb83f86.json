  "id": "b511e573-eadb-59dd-9695-562b8cb83f86",
  "slug": "spinach-and-ham-quiche",
  "name": "Spinach and Ham Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This easy spinach-crusted quiche is made with baking mix, ham, and two kinds of cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 10-inch pie plate."
    },
    {
      "position": 2,
      "text": "Press spinach in an even, compact layer into the bottom of the prepared pie plate."
    },
    {
      "position": 3,
      "text": "Beat milk, ham, eggs, baking mix, onion, Cheddar cheese, and Monterey Jack cheese together in a bowl; pour over the spinach layer."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until quiche is set in the middle, 35 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

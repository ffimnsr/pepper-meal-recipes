  "id": "b32add74-cee3-5b32-9fbb-b6206a6e3212",
  "slug": "eric-and-debis-seafood-seviche",
  "name": "Eric and Debi's Seafood Seviche",
  "recipe_type": "appetizer",
  "brief_description": "Halibut, scallops, and shrimp are the featured seafood in this tangy and delicious appetizer.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Stir the halibut, shrimp, scallops, lemon juice, and grapefruit juice together in a glass bowl. Cover, and refrigerate at least 6 hours until the halibut turns opaque."
    },
    {
      "position": 2,
      "text": "Stir the bell pepper, jalapeno pepper, onion, olives, ginger, sugar, salt, and tomato paste together in a glass bowl until no chunks of tomato paste remain. Drain the seafood, and add to the vegetable mixture along with the tomatoes. Gently stir until evenly combined, then return to the refrigerator to chill at least 15 minutes before serving."
    }
  ],
  "servings": 10,

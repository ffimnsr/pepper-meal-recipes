  "id": "701989da-fa9b-530b-aa8b-e0b715921cff",
  "slug": "spaghetti-sauce-with-ground-beef",
  "name": "Homemade Spaghetti Sauce with Ground Beef",
  "recipe_type": "main",
  "brief_description": "Top spaghetti or your favorite pasta with this meaty homemade spaghetti sauce with ground beef recipe that\u2019s easy to make, and ready in about an hour.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ground beef, bell pepper, onion, and garlic in a large saucepan over medium-high heat; cook and stir until meat is browned and crumbly and vegetables are tender, 5 to 7 minutes. Drain grease."
    },
    {
      "position": 3,
      "text": "Stir diced tomatoes, tomato sauce, and tomato paste into ground beef mixture; season with oregano, basil, salt, and black pepper. Simmer sauce for 1 hour, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

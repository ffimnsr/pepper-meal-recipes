  "id": "c3cd11bf-60b2-5051-8444-c9444c574f4d",
  "slug": "chef-johns-crab-cakes",
  "name": "Chef John's Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's crab cake recipe makes perfectly seasoned crab cakes with minimal filler that are crispy on the outside and sweet and tender on the inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix crushed crackers, mayonnaise, Dijon, seafood seasoning, Worcestershire sauce, egg, cayenne, and salt together in a large bowl. Add crabmeat and stir until combined but still chunky. Cover and refrigerate for 1 hour."
    },
    {
      "position": 2,
      "text": "Sprinkle bread crumbs onto a plate. Shape chilled crab mixture into four small, thick patties. Coat patties completely with bread crumbs."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium heat. Add crab cakes and cook until golden brown, about 4 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

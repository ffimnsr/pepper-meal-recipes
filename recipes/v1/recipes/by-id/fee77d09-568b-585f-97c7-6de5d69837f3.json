  "id": "fee77d09-568b-585f-97c7-6de5d69837f3",
  "slug": "gluten-free-kalbi-beef",
  "name": "Gluten-Free Kalbi Beef",
  "recipe_type": "main",
  "brief_description": "Beef short ribs are marinated in a savory sauce with sesame oil, green onions, and garlic then grilled in this gluten-free Kalbi recipe.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Toast sesame seeds in a small skillet over medium heat until lightly browned, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine sesame seeds, soy sauce, sugar, green onions, sesame oil, garlic, and red pepper flakes in a saucepan. Simmer over medium-low heat, stirring constantly, until flavors combine, about 10 minutes. Remove from heat and let marinade cool completely, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Place short ribs in large resealable plastic bags and cover with cooled marinade. Seal and let marinate in the refrigerator, at least 1 hour or overnight for maximum flavor."
    },
    {
      "position": 4,
      "text": "Preheat grill for medium heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Drain short ribs, discarding marinade, and cook on the preheated grill until browned, about 5 minutes per side."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "33373fc7-e074-54bf-bc28-327c8d857a13",
  "slug": "baked-tofu",
  "name": "Baked Tofu",
  "recipe_type": "salad",
  "brief_description": "This vegan baked tofu recipe is so easy, you'll want to make it every week. Enjoy the sesame-soy-ginger tofu in salads, or toss it over pasta.",
  "cuisine": "American Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a large baking sheet with cooking spray."
    },
    {
      "position": 3,
      "text": "Whisk soy sauce, agave, sesame oil, garlic, and ginger together in a bowl until evenly combined."
    },
    {
      "position": 4,
      "text": "Gently press tofu pieces to release as much water as possible."
    },
    {
      "position": 5,
      "text": "Arrange tofu on the prepared baking sheet and brush with 1/2 of the soy mixture."
    },
    {
      "position": 6,
      "text": "Bake tofu in the preheated oven for 30 minutes."
    },
    {
      "position": 7,
      "text": "Flip tofu and brush with remaining soy mixture. Sprinkle sesame seeds over top. Continue baking until tofu is crisp, about 30 more minutes."
    },
    {
      "position": 8,
      "text": "Remove from the oven and use a spatula to transfer tofu to a wire rack to cool."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

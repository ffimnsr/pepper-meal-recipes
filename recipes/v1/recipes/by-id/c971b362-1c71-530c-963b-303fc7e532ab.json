  "slug": "mackerel-dip",
  "name": "Mackerel Dip",
  "recipe_type": "appetizer",
  "brief_description": "This simple mackerel dip mixes up in minutes with canned mackerel, mayonnaise, and basic seasonings, and it's ready after just two hours in the fridge.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove and discard mackerel skin and bones. In a medium bowl, mix mackerel with onion and hot pepper sauce with a fork, breaking it into small pieces. Mix in mayonnaise, then season to taste with salt and pepper. Cover and refrigerate for 2 hours."
    }
  ],
  "servings": 12,

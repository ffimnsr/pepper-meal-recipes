{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "45ffd36e-9939-5b1d-b360-f105b5b8c10a",
  "slug": "shrimp-spaghetti-with-tomato-sauce",
  "name": "Shrimp Spaghetti with Tomato Sauce",
  "recipe_type": "soup",
  "brief_description": "Spaghetti is cooked in shrimp broth before it's combined with a bold and spicy tomato sauce featuring bell pepper, parsley, chile pepper, and large tender shrimp.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Peel shrimp and place skin, heads, and tails into a large saucepan. Fill pan with water and bring to a boil. Reduce heat to low and let simmer, about 45 minutes."
    },
    {
      "position": 2,
      "text": "Combine tomatoes and 1/2 the parsley in a blender; puree until smooth."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a separate pan over medium heat. Add onion, bell pepper, and chile pepper; cook and stir until softened, about 5 minutes. Add garlic; cook until fragrant but not browned, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour pureed tomato mixture into the pan with the peppers. Add water, tomato paste, oregano, salt, and black pepper. Stir well; add paprika. Let sauce simmer on low to medium heat until juices have reduced."
    },
    {
      "position": 5,
      "text": "Strain shrimp shells from the water. Bring water back to a boil and add spaghetti. Cook spaghetti, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Reserve 1 cup of the cooking water and drain the rest."
    },
    {
      "position": 6,
      "text": "In the meantime, add shrimp to the tomato sauce. Add the reserved water, stir well, and cook until shrimp is pink, about 3 minutes. Plate spaghetti and spoon the sauce on top; garnish with the remaining parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "4980a1ee-23cc-5893-b0b7-b0be33d491ef",
  "slug": "air-fried-jalapeno-poppers",
  "name": "Air Fryer Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer jalape\u00f1o poppers are stuffed with two cheeses and salami, wrapped in bacon, and cooked until browned and melty.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 390 degrees F (199 degrees C) according to manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Combine cream cheese and Cheddar cheese in a small bowl. Divide cheese mixture evenly among jalape\u00f1o halves. Top each with a piece of salami, then wrap with a strip of bacon. Secure with a toothpick if necessary."
    },
    {
      "position": 3,
      "text": "Arrange jalape\u00f1o poppers in a single layer in the air fryer basket, working in batches if needed. Air fry until bacon is browned and crisp and cheese is melted, 10 to 12 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

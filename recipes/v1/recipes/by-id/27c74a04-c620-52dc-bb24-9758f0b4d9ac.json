  "id": "27c74a04-c620-52dc-bb24-9758f0b4d9ac",
  "slug": "cream-cheese-spritz-cookies",
  "name": "Cream Cheese Spritz Cookies",
  "recipe_type": "dessert",
  "brief_description": "Cream cheese gives regular spritz cookies a delicious boost in this recipe that's quick, easy, and perfect for Christmas entertaining.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream butter and cream cheese together in a bowl using an electric mixer; add sugar and beat well. Mix in vanilla extract and food coloring. Slowly add flour and mix well to combine."
    },
    {
      "position": 3,
      "text": "Fill a cookie press with dough and form cookies onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are set, 8 to 10 minutes, making sure to remove at the first hint of browning."
    }
  ],
  "servings": 54,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

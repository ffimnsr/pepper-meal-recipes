  "schema_version": 1,
  "id": "b5b97e18-ee20-5f6c-9246-74d803d8c79c",
  "slug": "annies-white-chocolate-kahlua-creme-brulee",
  "name": "Annie's White Chocolate-Kahlua\u00ae Creme Brulee",
  "recipe_type": "dessert",
  "brief_description": "White chocolate and Kahlua\u00ae take this creme brulee to another level. This rich, creamy coffee-flavored dessert is sure to wow your guests.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks and 1/3 cup white sugar together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Bring 1 3/4 cup plus 2 tablespoons heavy cream to a simmer in a saucepan over medium-high heat, about 5 minutes. Add white chocolate. Remove from heat and whisk until chocolate is melted."
    },
    {
      "position": 4,
      "text": "Spoon 2 tablespoons of cream mixture into egg yolks, whisking constantly to prevent eggs from scrambling. Pour remaining cream mixture over egg yolks, whisking until custard is thick and smooth. Stir in vanilla extract and coffee liqueur."
    },
    {
      "position": 5,
      "text": "Pour custard into four 6-ounce ramekins. Arrange ramekins in a 9x13-inch baking pan. Pour in enough warm water to come 1 1/2 inches up the sides of the ramekins."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until custard is set, about 45 minutes. Cool to room temperature, about 30 minutes. Cover with plastic wrap and refrigerate until chilled, about 2 hours."
    },
    {
      "position": 7,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 8,
      "text": "Arrange ramekins on a baking sheet. Sprinkle 1 teaspoon white sugar over each custard."
    },
    {
      "position": 9,
      "text": "Broil in the preheated oven until sugar is melted and crispy, about 2 minutes. Chill before serving, 5 to 10 minutes."
    }
  ],
  "servings": 4,

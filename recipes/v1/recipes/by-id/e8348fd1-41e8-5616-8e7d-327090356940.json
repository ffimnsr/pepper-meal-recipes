  "id": "e8348fd1-41e8-5616-8e7d-327090356940",
  "slug": "light-fruit-and-nut-granola",
  "name": "Light Fruit and Nut Granola",
  "recipe_type": "breakfast",
  "brief_description": "A delicious granola without the fat can be made with spelt, flax seeds, and pecans!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Toss the rolled oats, spelt flour, brown sugar, cinnamon, ginger, canola oil, applesauce, maple syrup, dried apricots, pecans and ground flax seed together in a bowl, and mix well. Spread the granola mixture on the lined baking sheet."
    },
    {
      "position": 3,
      "text": "Bake for 20 minutes, stir the granola, then bake for another 15 minutes until dry. Cool completely before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "67701b3f-ca00-581d-9147-5b85d0f3b6fc",
  "slug": "sofrito",
  "name": "Sofrito",
  "recipe_type": "side",
  "brief_description": "Sofrito is a flavorful, aromatic blend of tomatoes, onions, peppers, cilantro, and garlic used as the flavoring base for many Puerto Rican dishes.",
  "cuisine": "Puerto Rican South American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine aj\u00ed dulce peppers, onions, tomatoes, green peppers, red peppers, and garlic in a food processor; pulse a few times. Add cilantro stems, recao stems, salt, and pepper. Process until a semi-chunky salsa (not watery) consistency is reached."
    },
    {
      "position": 2,
      "text": "Store in a resealable plastic freezer bag. Use as needed or freeze in portions."
    }
  ],
  "servings": 80,

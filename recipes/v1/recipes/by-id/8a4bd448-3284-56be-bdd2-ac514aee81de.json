  "id": "8a4bd448-3284-56be-bdd2-ac514aee81de",
  "slug": "roasted-carrots-and-shallots-recipe-11956154",
  "name": "Roasted Carrots and Shallots",
  "recipe_type": "dessert",
  "brief_description": "I make these roasted carrots and shallots for most holidays as a side, but really, it's yummy year round. The carrots turn very sweet in the roasting process. Feel free to just use orange carrots, but I like the different colors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease baking sheet with a little olive oil. Combine carrots, shallots, butter, thyme, salt, and pepper in a bowl. Spread out in a single layer on a baking sheet and cover baking sheet tightly with aluminum foil."
    },
    {
      "position": 2,
      "text": "Roast in the preheated oven until carrots are softened, about 15 minutes. Remove foil and continue roasting for 10 minutes. Stir carrots and continue roasting until carrots are browned and tender, an additional 10 to 15 minutes, stirring one more time during the final roast. Taste and adjust seasoning with salt and pepper. Drizzle a little lemon juice over the vegetables to taste before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 22,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

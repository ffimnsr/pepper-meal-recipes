  "id": "0bd09c82-2b9c-52fc-92fc-52bf3fb215cb",
  "slug": "almond-jelly",
  "name": "Almond Jelly",
  "recipe_type": "salad",
  "brief_description": "Plain gelatin powder and water are transformed, via the addition of sugar, milk, and almond extract, into this tasty Chinese dessert.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 cup water in a bowl; sprinkle the gelatin over the water; stir until the gelatin is partially dissolved. Set aside."
    },
    {
      "position": 2,
      "text": "Bring 1 cup water to a boil in a large saucepan. Reduce heat to medium-low and slowly pour in the gelatin mixture. Add the milk, sugar, and almond extract; stir until the sugar and gelatin are completely dissolved; pour mixture into a large, shallow container. Refrigerate until firm, 3 to 4 hours. Cut into small squares to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,

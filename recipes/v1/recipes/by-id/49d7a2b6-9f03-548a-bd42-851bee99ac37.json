  "id": "49d7a2b6-9f03-548a-bd42-851bee99ac37",
  "slug": "stuffed-pork-chops-ii",
  "name": "Baked Stuffed Pork Chops",
  "recipe_type": "main",
  "brief_description": "Baked stuffed pork chops in the oven are a cozy dinner of butterflied chops filled with corn and bread stuffing smothered in a savory mushroom sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine corn, bread crumbs, egg, and butter in a medium bowl; mix until stiff and well combined."
    },
    {
      "position": 4,
      "text": "Using a paring knife to cut a deep horizontal slit into each chop to create a pocket."
    },
    {
      "position": 5,
      "text": "Fill each pocket with corn mixture. Place chops in a cooking dish, then pour mushroom soup over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until chops are cooked through, about 45 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

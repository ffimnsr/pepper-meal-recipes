  "id": "6ccd92fa-30c4-5413-bc9e-0a3c65485ffd",
  "slug": "brioche-french-toast-casserole-recipe-8634275",
  "name": "Brioche French Toast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This brioche French toast casserole is what delicious mornings should be made of. An easy to fix indulgent breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir brown sugar, flour, melted butter, salt, and 1/2 teaspoon of the cinnamon together in a medium bowl until crumbly; set aside."
    },
    {
      "position": 3,
      "text": "Lightly coat a 9-x 13-inch baking dish with cooking spray. Whisk milk, heavy cream, eggs, maple syrup, vanilla, and remaining 1 \u00bd teaspoons cinnamon together in a large bowl until fully combined. Toss cubed brioche in milk mixture until all pieces are moistened. (Milk mixture will not be completely absorbed)."
    },
    {
      "position": 4,
      "text": "Transfer mixture to prepared baking dish, and sprinkle evenly with granulated sugar."
    },
    {
      "position": 5,
      "text": "Sprinkle brown sugar mixture evenly over top of bread mixture. Let casserole stand 10 minutes at room temperature."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until casserole is set and bread is golden brown and puffy, 35 to 40 minutes. Remove from oven, and serve immediately with additional maple syrup. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "f93c8f74-f7f5-5459-8043-dbcc746a9b0a",
  "slug": "strawberry-sangria",
  "name": "Strawberry Sangria",
  "recipe_type": "drink",
  "brief_description": "This refreshing sangria features white wine, strawberry schnapps, and fresh strawberries, making it the perfect summertime drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine wine, strawberry schnapps, and sugar in a large pitcher. Stir until sugar is dissolved. Add sliced strawberries and refrigerate, 2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Pour over ice and garnish with whole strawberries before serving."
    }
  ],
  "servings": 6,

  "id": "e1f32187-96f6-592f-aed1-73a4dba982bf",
  "slug": "sweet-chili-salmon-recipe-12020937",
  "name": "Sweet Chili Salmon",
  "recipe_type": "dessert",
  "brief_description": "Sweet Thai chili sauce transforms salmon fillets with the perfect balance of sweet heat, bright lime, garlic, and savory umami. Ready in less than an hour, it\u2019s an easy way to add a flavor boost to your usual salmon dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For glaze, combine 6 tablespoons water, sugar, lime juice, rice vinegar, fish sauce, sambal olek, and garlic in a small saucepan. Bring to a gentle simmer and cook for 5 minutes, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Mix cornstarch with remaining water to make a slurry. Stir the slurry into the sauce and simmer until glossy and slightly thickened, about 1 minute. Cool to room temperature before using, about 10 minutes; it will continue to thicken."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Line a baking tray with parchment paper and place salmon fillets skin side down. Pat fillets dry. Sprinkle with salt and pepper. Brush a thin layer of glaze on the salmon."
    },
    {
      "position": 5,
      "text": "Bake salmon in the preheated oven for 6 minutes; brush with glaze. Continue to bake until fish flakes easily with a fork, about 14 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

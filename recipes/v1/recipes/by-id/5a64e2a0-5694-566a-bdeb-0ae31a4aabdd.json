  "id": "5a64e2a0-5694-566a-bdeb-0ae31a4aabdd",
  "slug": "salmon-patties-ii",
  "name": "Simple Salmon Patties",
  "recipe_type": "main",
  "brief_description": "These simple salmon patties are made with canned salmon, egg, and self-rising flour, then pan-fried until crisp and golden brown.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine salmon, egg, and flour in a medium bowl; mix well. Form mixture into patties."
    },
    {
      "position": 2,
      "text": "Heat about 1/4 inch oil in a skillet over medium-high heat. Fry patties in batches until browned, turning once. Drain on paper towels and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

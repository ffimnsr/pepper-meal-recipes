  "id": "ec589b90-b7b9-5bea-a68e-e98a3c0f92c4",
  "slug": "stromboli",
  "name": "Stromboli",
  "recipe_type": "main",
  "brief_description": "This easy stromboli recipe uses a mixture of fresh and packaged ingredients to make a fun pizza sandwich that kids and adults will go go crazy for!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400\u00b0 F (200\u00b0 C). Grease an 10x15x1-inch baking pan; set aside. Cook and stir ground beef in a large skillet over medium heat until browned, 5 to 7 minutes. Drain off and discard grease."
    },
    {
      "position": 3,
      "text": "Add pepper and onion to skillet. Cook over medium heat, stirring occasionally until vegetables are tender, about 5 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Stir in ham, mushrooms and pizza sauce. Set aside."
    },
    {
      "position": 5,
      "text": "Unroll pizza crust onto prepared baking pan."
    },
    {
      "position": 6,
      "text": "Pat dough to a 9 x13-inch rectangle."
    },
    {
      "position": 7,
      "text": "Lay half of the pepperoni lengthwise over half over the crust to within 1/2-inch of the edge."
    },
    {
      "position": 8,
      "text": "Spoon meat mixture over the pepperoni."
    },
    {
      "position": 9,
      "text": "Top with cheese and remaining pepperoni."
    },
    {
      "position": 10,
      "text": "Fold dough over filling."
    },
    {
      "position": 11,
      "text": "Pinch ends and sides together with your fingers to seal in the filling."
    },
    {
      "position": 12,
      "text": "Poke holes in the top with the tip of a sharp knife."
    },
    {
      "position": 13,
      "text": "Brush with melted butter."
    },
    {
      "position": 14,
      "text": "Bake in a preheated oven for 20 minutes or until golden brown."
    },
    {
      "position": 15,
      "text": "Let stand for 15 minutes before serving. Cut into four portions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

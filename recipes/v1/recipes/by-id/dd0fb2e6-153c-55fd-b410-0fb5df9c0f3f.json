  "schema_version": 1,
  "id": "dd0fb2e6-153c-55fd-b410-0fb5df9c0f3f",
  "slug": "bacon-and-gruyere-sous-vide-egg-bites",
  "name": "Bacon and Gruyere Sous Vide Egg Bites",
  "recipe_type": "breakfast",
  "brief_description": "These make-ahead sous vide egg bites are similar to that famous coffee shop's version, but they're double the size and have the same velvety texture!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare a sous vide immersion cooker according to the manufacturer's directions, and set the temperature to 170 degrees F (75 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels. Let cool, then chop each slice into 4 to 5 pieces."
    },
    {
      "position": 3,
      "text": "Combine eggs, cottage cheese, Gruyere cheese, heavy cream, and salt in a blender. Blend until well combined, 15 to 20 seconds."
    },
    {
      "position": 4,
      "text": "Spray mason jars with cooking spray. Divide bacon between jars. Pour egg mixture over bacon. Screw on the lids until just barely tightened. Do not over-tighten, as the jars can burst in hot water."
    },
    {
      "position": 5,
      "text": "Submerge jars into water bath and set timer for 55 minutes. When time is up, remove jars and transfer to a cooling rack."
    },
    {
      "position": 6,
      "text": "If serving immediately, run a knife along outer edge of bites and invert onto a plate, or serve in jars. Let any remaining jars cool, then refrigerate for up to 1 week."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7cb841f0-9bc5-5bcc-bce9-c7606e212736",
  "slug": "mile-high-green-chili",
  "name": "Mile High Green Chile",
  "recipe_type": "soup",
  "brief_description": "This green chile is made in the slow cooker with pork, roasted tomatillos, chiles, herbs, and spices. Cream cheese is added for a creamy finish.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange the halved tomatillos, Anaheim chiles, jalape\u00f1os, onion, and bell pepper on a baking sheet. Drizzle vegetables with 1 tablespoon olive oil and sprinkle with salt."
    },
    {
      "position": 3,
      "text": "Roast vegetables in the preheated oven until they begin to show brown spots, about 30 minutes. Allow to cool, then chop vegetables into bite-sized pieces."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon olive oil in a large skillet over high heat. Add pork and fry until browned, seasoning with salt and black pepper as it cooks, about 12 minutes."
    },
    {
      "position": 5,
      "text": "Transfer pork to a slow cooker; stir in roasted vegetables. Mix in beer, tomatoes, garlic, oregano, parsley, cumin, chili powder, and bouillon. Cover and cook on Low until pork is tender, 4 to 6 hours."
    },
    {
      "position": 6,
      "text": "About 1/2 hour before serving, place cream cheese into a bowl and stir in about 1 tablespoon of the chili liquid until thoroughly combined. Continue stirring in chili broth, a tablespoon at a time, until the cream cheese is almost a liquid. Stir cream cheese mixture back into the chili."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "17e2c088-85b5-5368-8b63-bff31c4ea326",
  "slug": "spaghetti-carbonara-ii",
  "name": "Spaghetti Carbonara",
  "recipe_type": "main",
  "brief_description": "This spaghetti carbonara recipe is a classic pasta dish that cooks in 20 minutes with spaghetti and crispy bacon in a creamy Parmesan and egg sauce.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain, toss spaghetti with 1 tablespoon olive oil, and set aside."
    },
    {
      "position": 2,
      "text": "Place diced bacon in a large skillet over medium heat; cook and stir until evenly browned, about 10 minutes. Drain bacon on paper towels, reserving 2 tablespoons bacon fat in the skillet."
    },
    {
      "position": 3,
      "text": "Add 1 tablespoon olive oil to bacon fat in the skillet. Add chopped onion and cook over medium heat until onion is translucent. Add minced garlic and cook until fragrant, about 1 minute. Add wine and cook 1 minute more."
    },
    {
      "position": 4,
      "text": "Return cooked bacon to the skillet; add cooked spaghetti. Toss to coat and heat through, adding more olive oil if it seems dry or sticks together. Add beaten eggs and cook, tossing constantly with tongs or a large fork, until eggs are barely set. Quickly add 1/2 cup Parmesan cheese and toss again. Season with salt and pepper (remember that bacon and Parmesan are very salty)."
    },
    {
      "position": 5,
      "text": "Serve warm with chopped parsley sprinkled on top and extra Parmesan cheese at the table."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

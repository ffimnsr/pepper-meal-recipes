  "id": "98b3ef44-f167-591f-9057-80375e894300",
  "slug": "classic-pecan-pie",
  "name": "Classic Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie recipe combines eggs, corn syrup, vanilla, and pecans in a pie crust. Bake until golden brown for a classic Thanksgiving dessert.",
  "cuisine": "U.S. Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix corn syrup, sugar, eggs, butter, and vanilla extract together in a large bowl with a spoon; stir in pecans."
    },
    {
      "position": 3,
      "text": "Pour into pie crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until center reaches 200 degrees F (95 degrees C), and it springs back when lightly touched, 60 to 70 minutes. If crust becomes too brown, cover edges with foil."
    },
    {
      "position": 5,
      "text": "Cool for 2 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "hard",

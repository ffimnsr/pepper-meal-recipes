  "id": "bcb95bb4-aa55-5924-97c3-5a33d5063276",
  "slug": "apple-harvest-pound-cake-with-caramel-glaze",
  "name": "Apple Cake with Caramel Glaze",
  "recipe_type": "dessert",
  "brief_description": "This beautiful caramel apple cake is made in a Bundt pan and topped with a sweet, buttery glaze to make a crowd-pleasing holiday or potluck dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch Bundt pan."
    },
    {
      "position": 2,
      "text": "Beat sugar, oil, vanilla, and eggs with an electric mixer in a large bowl until light and fluffy."
    },
    {
      "position": 3,
      "text": "Combine flour, baking soda, cinnamon, and salt; stir into batter just until blended."
    },
    {
      "position": 4,
      "text": "Fold in apples and walnuts using a spoon. Pour into the prepared Bundt pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour to 1 hour 20 minutes. Allow cake to cool in pan for about 15 minutes then invert on to a wire rack."
    },
    {
      "position": 6,
      "text": "To make the caramel glaze: Heat butter, milk, and brown sugar in a small saucepan over medium heat. Bring to a boil, stirring to dissolve sugar, then remove from the heat."
    },
    {
      "position": 7,
      "text": "Drizzle glaze over warm cake."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

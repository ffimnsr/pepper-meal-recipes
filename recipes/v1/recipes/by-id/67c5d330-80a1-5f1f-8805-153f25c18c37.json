  "id": "67c5d330-80a1-5f1f-8805-153f25c18c37",
  "slug": "slow-cooker-chicken-marsala",
  "name": "Slow Cooker Chicken Marsala",
  "recipe_type": "main",
  "brief_description": "This crockpot chicken Marsala recipe is easy to make in your slow cooker. Lightly seasoned chicken is simmered for hours in a Marsala wine sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir oil and garlic together in the bowl of a slow cooker."
    },
    {
      "position": 2,
      "text": "Mix flour, salt, and pepper together in a large resealable plastic bag. Add chicken to the bag, seal, and shake to coat chicken with flour mixture. Pour coated chicken into the slow cooker, then add mushrooms."
    },
    {
      "position": 3,
      "text": "Heat Marsala wine in a small frying pan over medium-high heat until reduced, 2 to 3 minutes; pour into the slow cooker over chicken and mushrooms."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until sauce thickens and chicken is no longer pink in the center and the juices run clear, 4 to 5 hours. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "If the sauce is too thin, mix water and cornstarch together in a small bowl and pour slowly into the slow cooker. Cover and cook on High until thickened, about 15 minutes. Adjust seasonings to taste, garnish with parsley, and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 245,
  "preparation_time_minutes": 10,

  "id": "ecb97257-c526-523d-8f8c-9b788dd5e722",
  "slug": "apple-crisp-iv",
  "name": "Awesome Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "Sweet apple slices are cooked between layers of a delicious crumbly crisp topping made with flour, brown sugar, butter, cinnamon, and oatmeal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, oatmeal, cinnamon, nutmeg, and brown sugar in a large bowl; cut in butter until mixture is crumbly."
    },
    {
      "position": 3,
      "text": "Spoon half of the mixture into the bottom of a 9x13-inch baking dish; pat down with the back of a spoon to form an even layer."
    },
    {
      "position": 4,
      "text": "Cover crumb mixture with apple slices, then sprinkle apple slices with remaining crumb mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until apples are tender, about 45 to 50 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

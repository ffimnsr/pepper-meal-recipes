  "slug": "almond-and-parsley-salsa-verde",
  "name": "Almond and Parsley Salsa Verde",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's recipe for almond and parsley salsa verde is a welcome change from the traditional pesto sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chopped almonds and parsley on a cutting board; chop together again until very finely chopped."
    },
    {
      "position": 2,
      "text": "Transfer almond mixture to a bowl and add garlic. Stir olive oil into almond mixture until a thick sauce forms."
    }
  ],

  "id": "051ec28d-399c-5850-9ce7-1a03d1b96761",
  "slug": "guinness-corned-beef",
  "name": "Guinness Corned Beef",
  "recipe_type": "dessert",
  "brief_description": "Corned beef cooked in Guinness is sweetened with brown sugar for a tender, melt-in-your-mouth St. Patrick's Day favorite.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Rinse brisket thoroughly, then pat dry with paper towels and place on a rack in a roasting pan or Dutch oven. Rub brown sugar all over brisket."
    },
    {
      "position": 3,
      "text": "Pour beer around and gently over brisket to wet sugar."
    },
    {
      "position": 4,
      "text": "Bake, covered, in the preheated oven until tender, about 2 \u00bd hours. An instant-read thermometer inserted into the center of brisket should read at least 190 degrees F (88 degrees C)."
    },
    {
      "position": 5,
      "text": "Allow to rest for 5 minutes before slicing."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 16,

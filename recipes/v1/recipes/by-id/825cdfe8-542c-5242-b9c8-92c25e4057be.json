  "id": "825cdfe8-542c-5242-b9c8-92c25e4057be",
  "slug": "frozen-blueberry-scones",
  "name": "Frozen Blueberry Scones",
  "recipe_type": "dessert",
  "brief_description": "Sweet, tart flavor comes from the addition of frozen blueberries in these easy baked scones that can be frozen and reheated for a busy morning, on-the-go treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place flour, 1/2 cup sugar, baking powder, baking soda, and salt into a food processor. Pulse to combine. Add frozen butter and process until a fine crumb results and no hunks of butter are left."
    },
    {
      "position": 3,
      "text": "Transfer into the bowl of an electric stand mixer or a bowl for hand mixing. Add sour cream and egg. Set mixer on medium speed and blend until crumbs clump up and start to pull away from the sides of the bowl. Add blueberries and mix to combine."
    },
    {
      "position": 4,
      "text": "Take 1/2 of the dough and place on a floured surface. Shape with your hands, pushing blueberries in if they fall out, into a 1/2-inch thick disc, about 8 inches in diameter. Cut into 8 triangles and transfer to a baking sheet. Repeat with remaining dough. Sprinkle a pinch of sugar on each scone."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the tops start to turn golden, 17 to 22 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

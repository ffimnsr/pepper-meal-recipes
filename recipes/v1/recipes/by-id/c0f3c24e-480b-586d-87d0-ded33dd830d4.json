  "slug": "savory-rice-and-quinoa-pilaf",
  "name": "Savory Rice and Quinoa Pilaf",
  "recipe_type": "side",
  "brief_description": "This savory basmati rice and quinoa pilaf flavored with sage and allspice is a quick and easy vegetarian side dish ready in about 30 minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring vegetable broth to a boil in a large saucepan. Stir in basmati rice, quinoa, tomatoes, raisins, parsley, salt, pepper, allspice, and sage. Reduce heat and simmer until broth is absorbed and quinoa is tender, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,

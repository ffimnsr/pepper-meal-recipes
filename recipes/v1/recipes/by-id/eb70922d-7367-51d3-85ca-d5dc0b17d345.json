  "id": "eb70922d-7367-51d3-85ca-d5dc0b17d345",
  "slug": "gnocchi-in-fontina-sauce",
  "name": "Gnocchi in Fontina Sauce",
  "recipe_type": "salad",
  "brief_description": "Rich, decadent gnocchi in white sauce made from Fontina cheese melt in your mouth! Best served with a light salad to balance out the richness.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until tender, about 5 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Once gnocchi goes into the boiling water, start the sauce: Melt butter in a saucepan over medium heat. Add shallots and cook until tender, about 3 minutes. Stir in cream and heat to almost a boil. Gradually mix in Fontina and Parmesan cheeses, being careful not to boil. Stir until smooth, then remove from the heat immediately so the sauce doesn\u2019t clump."
    },
    {
      "position": 3,
      "text": "Place gnocchi into serving dishes and spoon sauce over top. Garnish each serving with basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "54284fcc-90c8-57a4-ac01-29af42a3b8cd",
  "slug": "jewish-apple-cake-ii",
  "name": "Jewish Apple Cake II",
  "recipe_type": "dessert",
  "brief_description": "A homemade yellow cake is filled with a layer of sliced apples and spices in this delicious recipe.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 10 inch tube pan."
    },
    {
      "position": 2,
      "text": "Sprinkle sliced apples with 5 tablespoons white sugar and the ground cinnamon. Toss to coat and set aside."
    },
    {
      "position": 3,
      "text": "Mix the flour, eggs, 2 1/2 cups sugar, baking powder, salt, vegetable oil, orange juice and vanilla until well blended. Batter will be fairly stiff."
    },
    {
      "position": 4,
      "text": "Pour 1/2 of the batter into the prepared pan. Place the apple mixture over the batter then pour the remaining batter over the top."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 60 to 80 minutes. Let cake cool in pan."
    }
  ],
  "servings": 14,

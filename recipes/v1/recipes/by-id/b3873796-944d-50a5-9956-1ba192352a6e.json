  "id": "b3873796-944d-50a5-9956-1ba192352a6e",
  "slug": "red-snapper-livornese",
  "name": "Red Snapper Livornese",
  "recipe_type": "main",
  "brief_description": "This delicious Italian-inspired livornese recipe features red snapper fillets baked with a zesty tomato, onion, caper, and black olive sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium skillet, heat olive oil. Add onion and saut\u00e9 until tender, about 5 minutes. Add garlic and saut\u00e9 for 1 minute. Stir in tomatoes, capers, olives, pepper flakes, and parsley. Bring to a boil, then simmer for 10 minutes."
    },
    {
      "position": 3,
      "text": "Spread 1/2 cup sauce in an 11x7-inch baking dish. Arrange snapper fillets in a single layer over sauce. Drizzle fillets with lemon juice, then pour remaining sauce over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes for 1/2-inch thick fillets, or 30 minutes for 1-inch thick fillets. Baste once with the sauce while baking. Snapper is done when it flakes easily with a fork."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

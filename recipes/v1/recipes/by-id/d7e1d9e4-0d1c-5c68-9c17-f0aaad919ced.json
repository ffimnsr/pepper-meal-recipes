  "id": "d7e1d9e4-0d1c-5c68-9c17-f0aaad919ced",
  "slug": "venison-stew-i",
  "name": "Venison Stew",
  "recipe_type": "soup",
  "brief_description": "This hearty venison stew is slowly simmered with carrots, potatoes, and onions in a savory broth for a comforting dinner on a cold winter day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, heavy pot over medium heat. Add venison; cook and stir until well browned, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Add onions and garlic; cook and stir until translucent, about 5 minutes. Stir in water, Worcestershire sauce, salt, oregano, and bay leaf. Cover and simmer until venison is tender, 1 \u00bd to 2 hours."
    },
    {
      "position": 3,
      "text": "Stir in potatoes and carrots; cook until tender, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Stir flour and water together in a small bowl; pour into stew and cook until thick, 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove bay leaf before serving and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,

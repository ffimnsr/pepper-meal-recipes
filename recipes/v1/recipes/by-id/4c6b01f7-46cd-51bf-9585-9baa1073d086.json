{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4c6b01f7-46cd-51bf-9585-9baa1073d086",
  "slug": "turkey-chops-with-mushroom-gravy-recipe-8363641",
  "name": "Turkey Chops with Mushroom Gravy",
  "recipe_type": "main",
  "brief_description": "These turkey chops with mushroom gravy are one-skillet cooking at its best. Tender, nicely-seasoned turkey cutlets flavor the mushroom pan sauce in this comforting dish, easy enough for a weeknight.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season turkey chops with poultry seasoning, 1/4 teaspoon salt, 1/4 teaspoon black pepper, and cayenne pepper."
    },
    {
      "position": 3,
      "text": "Place flour in a shallow dish. Dredge chops in flour to coat. Reserve remaining flour (about 2 tablespoons)."
    },
    {
      "position": 4,
      "text": "Heat oil in a 12-inch skillet over medium-high heat. Add chops, 2 at a time, to the skillet and cook until nicely browned and no longer pink at the center, 6 minutes, turning once. Remove chops from skillet; cover to keep warm. Repeat with remaining chops."
    },
    {
      "position": 5,
      "text": "Wipe out the skillet to remove excess flour coating, if necessary."
    },
    {
      "position": 6,
      "text": "Add butter to the same skillet and place over medium heat. Add mushrooms and onion to skillet. Cook, stirring, until tender, scraping up browned bits from the bottom of the skillet with a wooden spoon, about 8 minutes. Stir in garlic and cook until fragrant, 1 minute more."
    },
    {
      "position": 7,
      "text": "Sprinkle reserved flour over vegetables. Cook and stir for 1 minute, so flour will not have a raw flavor. Pour in broth and half and half; season with remaining 1/4 teaspoon salt, and 1/4 teaspoon pepper. Cook and stir until mixture is thickened and bubbly, 6 to 8 minutes."
    },
    {
      "position": 8,
      "text": "Return chops to the skillet and heat through, about 2 minutes. Garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

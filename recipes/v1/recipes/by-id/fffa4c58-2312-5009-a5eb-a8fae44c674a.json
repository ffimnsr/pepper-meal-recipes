  "id": "fffa4c58-2312-5009-a5eb-a8fae44c674a",
  "slug": "mixed-salad-recipe-8636580",
  "name": "Mixed Salad",
  "recipe_type": "salad",
  "brief_description": "This mixed salad ensures you \u201ceat the rainbow\u201d and the bright pops of color make for a pretty presentation. Prepare this simple vinaigrette, or feel free to use a vinaigrette you prefer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a food processor, add vinegar, garlic clove, and Italian seasoning. Add lid. Turn to pur\u00e9e and slowly stream in olive oil. Adjust seasoning by adding salt, pepper and sugar to taste."
    },
    {
      "position": 2,
      "text": "Add lettuce, spinach, arugula, cucumbers, carrots, tomatoes, and red onion to a large bowl. Toss to combine."
    },
    {
      "position": 3,
      "text": "Dress salad greens with vinaigrette and add shaved Parmesan cheese. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

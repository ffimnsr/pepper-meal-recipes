  "id": "d7598fa0-c6eb-5933-b922-95338e448d6a",
  "slug": "shorecooks-chocolate-peppermint-biscotti",
  "name": "Shorecook's Chocolate Peppermint Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Chocolate peppermint biscotti get a coating of white candy and crushed candy canes for a tasty gift during the holidays.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat white sugar, butter, and cocoa powder together with an electric mixer in a large bowl until creamy and smooth. Add eggs, one at a time, beating well after each addition. Mix chocolate liqueur and peppermint extract into the sugar-egg mixture."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, and salt in a separate bowl. Slowly mix flour mixture into sugar-egg mixture until fully incorporated; fold mint chocolate chips into the dough."
    },
    {
      "position": 4,
      "text": "Divide dough into 4 equal parts and shape into logs. Arrange the logs on the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Dip a spatula in water and use it to smooth surface of the logs."
    },
    {
      "position": 6,
      "text": "Bake biscotti logs in the preheated oven until firm to the touch, 30 to 35 minutes. Cool biscotti logs completely on wire racks."
    },
    {
      "position": 7,
      "text": "Reduce oven temperature to 300 degrees F (150 degrees C)."
    },
    {
      "position": 8,
      "text": "Cut biscotti logs into 3/4-inch slices and arrange on baking sheets."
    },
    {
      "position": 9,
      "text": "Bake in the oven until biscotti are dry, about 10 minutes per side. Cool completely on wire racks."
    },
    {
      "position": 10,
      "text": "Place candy melts in a wide microwave-safe bowl; heat in microwave until melted, about 2 1/2 minutes, stirring every 30 seconds."
    },
    {
      "position": 11,
      "text": "Dip cooled biscotti in the melted white candy; sprinkle with crushed candy canes."
    }
  ],

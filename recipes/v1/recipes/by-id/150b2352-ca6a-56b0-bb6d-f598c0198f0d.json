  "slug": "homemade-corn-syrup-recipe-12061879",
  "name": "Homemade Corn Syrup",
  "recipe_type": "dessert",
  "brief_description": "This homemade corn syrup turns sweet corn, sugar, and molasses into a rich, flavorful syrup with just the right balance of sweetness and depth. Drizzle it over cornbread or ice cream, or stir it into an iced latte for a sweet, corn-forward twist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine corn, sugar, and molasses in a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Strain into a saucepan using a fine mesh strainer. Simmer over medium-low heat until mixture is reduced and forms a syrup-like consistency, about 5 minutes"
    },
    {
      "position": 3,
      "text": "Allow it to cool slightly before transferring to a jar. Store in the refrigerator."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

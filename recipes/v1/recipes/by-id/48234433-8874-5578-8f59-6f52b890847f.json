  "id": "48234433-8874-5578-8f59-6f52b890847f",
  "slug": "chocolate-almond-fudge",
  "name": "Chocolate Almond Fudge",
  "recipe_type": "dessert",
  "brief_description": "Rich chocolate flavor in a creamy fudge enhanced by the crunchy, nutty flavor of almonds. Add this to a holiday dessert table for rave reviews.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 9-inch baking pan with foil; spray foil with cooking spray."
    },
    {
      "position": 2,
      "text": "In large saucepan, mix powdered sugar, cocoa, and salt. Add almondmilk and buttery sticks. Cook over medium-low heat until buttery sticks melt and mixture is all moistened, stirring frequently. Cook and stir until mixture is smooth."
    },
    {
      "position": 3,
      "text": "Remove from heat. Beat with spoon until mixture loses its shine, about 5 minutes. Stir in almond flavor and almonds."
    },
    {
      "position": 4,
      "text": "Spread in pan. Cool completely, about 2 hours."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

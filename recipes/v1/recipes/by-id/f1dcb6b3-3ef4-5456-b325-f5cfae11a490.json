  "id": "f1dcb6b3-3ef4-5456-b325-f5cfae11a490",
  "slug": "speedy-chili-pot-pie",
  "name": "Speedy Chili Pot Pie",
  "recipe_type": "main",
  "brief_description": "Even kids can make this easy chili pot pie topped with cornbread. All you do is pour, mix, and bake.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together cornbread mix, milk, and egg in a bowl until slightly lumpy."
    },
    {
      "position": 3,
      "text": "Pour turkey chili with beans into a 9-inch pie dish. Spoon cornbread batter over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cornbread edges begin to brown and the center is set, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Top each serving with Cheddar cheese and sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

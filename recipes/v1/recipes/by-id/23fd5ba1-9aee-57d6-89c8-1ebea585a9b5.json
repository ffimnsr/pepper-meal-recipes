  "id": "23fd5ba1-9aee-57d6-89c8-1ebea585a9b5",
  "slug": "easy-cauliflower-ceviche",
  "name": "Easy Cauliflower Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "This easy Mexican cauliflower ceviche recipe features steamed cauliflower, carrots, and tomatoes for a vegan dish. Serve on crispy tostadas or crackers.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer; bring water to a boil. Add cauliflower; cover and steam for 7 minutes. Cool, then finely chop."
    },
    {
      "position": 2,
      "text": "Place cauliflower, carrots, tomatoes, onion, and cilantro in a large serving bowl. Pour lime juice on top; season with salt."
    },
    {
      "position": 3,
      "text": "Cover the bowl with plastic wrap; refrigerate at least 30 minutes. Garnish servings with avocado slices."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4012b444-1704-55a2-874e-52be9d51cc1d",
  "slug": "spicy-pineapple-margarita-recipe-8622042",
  "name": "Spicy Pineapple Margarita",
  "recipe_type": "appetizer",
  "brief_description": "This spicy pineapple margarita brings some jalapeno heat and chili-lime seasoning to a tropical pineapple margarita! Use as little or as much as you like.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle chili lime seasoning onto a plate. Moisten the rim of a glass with lime wedge. Press the moistened rim into the seasoning. Fill the glass with ice."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with tequila and 2 jalapeno slices. Use a muddler to crush the peppers. Add pineapple juice, triple sec, and lime juice to the shaker and add 1 cup of ice. Seal and shake vigorously until outside is frosted, 10 to 15 seconds."
    },
    {
      "position": 3,
      "text": "Strain margarita into the glass and garnish with remaining jalapeno slice, if desired."
    }
  ],
  "servings": 1,

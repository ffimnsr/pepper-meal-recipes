  "id": "8458b33d-4a04-5384-87a6-7bdb285cce7f",
  "slug": "pizza-casserole",
  "name": "Pizza Casserole",
  "recipe_type": "main",
  "brief_description": "This pizza casserole with ground beef, onion, bell pepper, pepperoni, and egg noodles is topped with mozzarella for a yummy, one-dish dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a boil. Cook egg noodles in boiling water until tender yet firm to the bite, 7 to 9 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat a medium skillet over medium-high heat. Cook and stir beef, onion, bell pepper, and garlic in the hot skillet until beef is browned and crumbly, 5 to 7 minutes. Drain excess fat from the skillet. Stir in cooked egg noodles, pizza sauce, pepperoni, and milk until well combined. Pour mixture into a 2-quart casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Sprinkle with cheese and continue baking until cheese is melted, 5 to 10 more minutes."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

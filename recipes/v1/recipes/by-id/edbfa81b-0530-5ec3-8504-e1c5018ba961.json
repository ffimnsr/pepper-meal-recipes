  "schema_version": 1,
  "id": "edbfa81b-0530-5ec3-8504-e1c5018ba961",
  "slug": "butter-biscuit-peach-cobbler",
  "name": "Butter Biscuit Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Southern-style peach cobbler just like grandma used to make is made with buttery biscuits baked into a peach filling and topped with flaky pie crust.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix peaches, 3/4 cup white sugar, brown sugar, butter, cornstarch, vanilla extract, 1 teaspoon cinnamon, 1/2 teaspoon nutmeg, and salt in a large pot over medium heat; cook and stir until sugars are dissolved and butter is melted, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle each biscuit with 1 pinch cinnamon, 1 pinch white sugar, and 1 pinch nutmeg. Flatten biscuits on a lightly floured surface using a rolling pin. Cut each flattened biscuit into 12 to 15 small squares; stir into peach mixture. Reduce heat to medium-low and simmer, stirring occasionally, until thickened, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Pour peach-biscuit mixture into a 9x13-inch baking dish and allow to thicken for 2 to 3 minutes; cover or decorate with pie crust. Cover dish with a sheet of aluminum foil and place dish on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is golden brown, 45 minutes to 1 hour. Cool before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "d8c2d21e-cff9-580d-86a5-f246d806cf3d",
  "slug": "emilys-marinated-venison-steaks",
  "name": "Emily's Marinated Venison Steaks",
  "recipe_type": "main",
  "brief_description": "This venison steak recipe is made with a deliciously bright, acidic savory marinade for venison steaks cooked on a hot grill until juicy and tender.",
  "cuisine": "American Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together Worcestershire sauce, soy sauce, lime juice, onion, red pepper flakes, dry mustard, salt, thyme, black pepper, garlic, and hot pepper sauce in a bowl; pour into a resealable plastic bag. Add venison steaks, coat with marinade, squeeze to remove excess air, and seal the bag. Marinate in the refrigerator for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove venison from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 3,
      "text": "Cook steaks on the preheated grill until they are firm, hot in the center, and just turning from pink to grey, about 5 minutes per side. An instant-read thermometer inserted into the center should read 150 degrees F (65 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

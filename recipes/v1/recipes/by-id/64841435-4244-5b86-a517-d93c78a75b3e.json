  "id": "64841435-4244-5b86-a517-d93c78a75b3e",
  "slug": "cherry-cheese-pie-ii",
  "name": "Cherry Cheese Pie",
  "recipe_type": "dessert",
  "brief_description": "This is a sweet and creamy cherry cheese pie with a cherry topping. Very easy and very good!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese in a mixing bowl until fluffy. Beat in milk until smooth. Stir in lemon juice and vanilla. Pour mixture into graham cracker crust."
    },
    {
      "position": 2,
      "text": "Cover and refrigerate until set, about 3 hours. Top with desired amount of pie filling before serving. Refrigerate leftovers."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

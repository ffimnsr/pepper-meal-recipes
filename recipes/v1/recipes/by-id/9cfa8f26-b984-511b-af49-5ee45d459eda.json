  "slug": "best-bruschetta-ever",
  "name": "Best Bruschetta Ever",
  "recipe_type": "appetizer",
  "brief_description": "Bruschettas make great snacks and appetizers. Parmesan cheese and garlic bring their popular flavors to tomatoes in this recipe.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix tomatoes, dried basil, Parmesan cheese, olive oil, garlic, seasoning salt and ground black pepper. Cover and chill in the refrigerator 8 hours, or overnight, before serving."
    }
  ],

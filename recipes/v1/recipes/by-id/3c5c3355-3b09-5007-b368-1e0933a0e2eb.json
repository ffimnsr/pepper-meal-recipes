  "id": "3c5c3355-3b09-5007-b368-1e0933a0e2eb",
  "slug": "cherry-slump",
  "name": "Cherry Slump",
  "recipe_type": "dessert",
  "brief_description": "This cherry slump recipe is an old-fashioned New England style easy and charming stovetop cobbler, which is even more delicious served with ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cherries, sugar, water, and cinnamon in a saucepan; bring to a boil."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt together in a bowl; gradually stir in milk until well combined. Drop batter by spoonfuls onto cherry mixture."
    },
    {
      "position": 3,
      "text": "Cover the saucepan, reduce heat to medium-low, and cook at a low boil for 25 minutes. Uncover; cook until biscuits are set and no longer soft in centers, about 10 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,

  "id": "47af324e-d4b9-5c18-a4f4-c03f1c46a407",
  "slug": "gluten-free-pizza-crust-or-flatbread",
  "name": "Gluten-Free Pizza Crust or Flatbread",
  "recipe_type": "main",
  "brief_description": "This gluten-free flatbread recipe is for a crust that can be used for pizza or flatbreads. This dough is straightforward and family friendly.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk water and sugar together in a bowl. Whisk in yeast. Let stand until yeast softens and begins to form a creamy foam, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine gluten-free flour, rice flour, Italian seasoning, xanthan gum, gelatin, and salt in the bowl of a stand mixer fitted with the paddle attachment. Whisk vinegar and olive oil into yeast mixture; pour over flour mixture. Mix on high speed until a wet, sticky dough forms, about 6 minutes."
    },
    {
      "position": 4,
      "text": "Transfer dough to the prepared baking sheet. Lay another sheet of parchment paper on top; smooth out dough to fill the baking sheet. Let dough rest, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until dough puffs up, 5 to 10 minutes. Peel parchment paper off the top. Continue baking until dough is golden brown and edges are cooked through, about 20 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

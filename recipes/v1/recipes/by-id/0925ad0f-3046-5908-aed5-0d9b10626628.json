  "slug": "big-batch-freezer-lemon-drop-martinis-recipe-8683079",
  "name": "Big Batch Freezer Lemon Drop Martinis",
  "recipe_type": "appetizer",
  "brief_description": "These big batch freezer lemon drop martinis, easily made right in a half-empty vodka bottle, are ready when you are\u2014stash the bottle in the freezer and serve them up any time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vodka, lemon juice, orange liqueur, and simple syrup into a freezer-safe 750ml bottle. Cover tightly, and tilt gently a few times to incorporate ingredients. Place bottle in the freezer for several hours until very well chilled."
    },
    {
      "position": 2,
      "text": "Shake gently before serving. Serve as desired, as in a sugar-rimmed glass. Store any extra in the freezer until ready to use."
    }
  ],
  "servings": 8,

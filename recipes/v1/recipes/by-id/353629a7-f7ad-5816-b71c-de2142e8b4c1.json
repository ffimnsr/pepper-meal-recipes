  "id": "353629a7-f7ad-5816-b71c-de2142e8b4c1",
  "slug": "orange-creamsicle-margarita-recipe-11744666",
  "name": "Orange Creamsicle Margarita",
  "recipe_type": "drink",
  "brief_description": "This orange creamsicle margarita will take you down memory lane\u2014it tastes just like a classic push-up orange creamsicle from the ice cream truck.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all your ingredients."
    },
    {
      "position": 2,
      "text": "Mix orange zest, sugar, and salt together on a small plate"
    },
    {
      "position": 3,
      "text": "Rim 2 glasses with lime wedge and rotate in the orange zest mixture."
    },
    {
      "position": 4,
      "text": "Combine tequila, orange juice, lime juice, triple sec, and ice cream in a cocktail shaker."
    },
    {
      "position": 5,
      "text": "Fill cocktail shaker with ice and shake very well. Strain into the orange-rimmed glasses and garnish with an orange or lemon slice"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

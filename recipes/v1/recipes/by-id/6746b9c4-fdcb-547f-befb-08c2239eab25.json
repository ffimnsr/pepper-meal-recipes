  "id": "6746b9c4-fdcb-547f-befb-08c2239eab25",
  "slug": "pancit",
  "name": "Pancit",
  "recipe_type": "main",
  "brief_description": "This delicious pancit recipe is from the Philippines and contains rice noodles that are pan-fried with chicken, pork, shrimp, cabbage, and carrots.",
  "cuisine": "Filipino Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Place rice noodles in a large bowl; cover with warm water. Set aside until noodles are softened; cut into 4-inch lengths. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Brown chicken and pork in a skillet over medium heat until no pink shows; season with soy sauce and black pepper. Transfer to a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Cook cabbage and carrots in the same skillet until tender. Stir in noodles, shrimp, and green onions; cook for 4 to 5 minutes. Stir in chicken and pork; cook 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

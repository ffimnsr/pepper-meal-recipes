  "id": "3ec16f23-01bd-524a-b313-da0d3201acd1",
  "slug": "sheet-pan-chicken-piccata-and-potatoes-recipe-11866006",
  "name": "Sheet Pan Chicken Piccata and Potatoes",
  "recipe_type": "main",
  "brief_description": "This sheet pan chicken piccata and potatoes is incredibly flavorful and delicious. Lemon and parsley add color and freshness and the whole dish could not be easier to make.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed 13x18-inch baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Sprinkle chicken with 1/2 teaspoon salt and 1/4 teaspoon pepper."
    },
    {
      "position": 3,
      "text": "Combine flour and Parmesan cheese in a shallow dish. Dredge chicken in flour mixture to coat, shaking off excess."
    },
    {
      "position": 4,
      "text": "Slice one of the lemons. Juice the remaining 2 lemons, you should have about 6 tablespoons of juice."
    },
    {
      "position": 5,
      "text": "Whisk together 3/4 cup chicken broth, oil, lemon juice, smoked paprika, and oregano in a small bowl. Add potatoes to the prepared baking sheet. Sprinkle with remaining 1/4 teaspoon salt and 1/4 teaspoon pepper."
    },
    {
      "position": 6,
      "text": "Pour sauce mixture over the potatoes. Bake in the preheated oven for 10 minutes. Remove from oven."
    },
    {
      "position": 7,
      "text": "Nestle chicken in between potatoes, turning to coat in the sauce mixture, adding additional broth to the baking sheet, if needed."
    },
    {
      "position": 8,
      "text": "Return to oven and bake 30 minutes, until chicken is done (165 degrees F or 74 degrees C), and potatoes are tender. In the last 10 minutes of bake time, top chicken and potatoes with sliced lemon, capers, and garlic."
    },
    {
      "position": 9,
      "text": "Garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

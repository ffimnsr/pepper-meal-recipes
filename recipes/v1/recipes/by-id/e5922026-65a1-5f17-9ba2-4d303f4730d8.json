  "slug": "steel-cut-oats-and-quinoa-breakfast",
  "name": "Steel-Cut Oats and Quinoa Breakfast",
  "recipe_type": "breakfast",
  "brief_description": "This nutritious steel-cut oatmeal and quinoa breakfast cereal with almond meal, flax, and cinnamon is a quick, easy vegan meal to start your day with.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a saucepan; add quinoa and oats. Simmer, stirring frequently, until water is absorbed and quinoa is tender, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir almond meal and flaxseed meal into oat-quinoa mixture; pour into a glass container and top with cinnamon. Let cool for about 15 minutes. Transfer to the refrigerator for storage."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6dbaa090-1b0b-56a1-b004-aae06069d0ca",
  "slug": "chef-johns-stuffed-peppers",
  "name": "Chef John\u2019s Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "This is the best stuffed peppers recipe that simply fills bell peppers with a mix of rice, ground beef and pork sausage for an easy yet satisfying supper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring rice and water to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until the rice is tender, and the liquid has been absorbed, 20 to 25 minutes. Set the cooked rice aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "To make the sauce: Cook onion and olive oil over medium heat until onion begins to soften, about 5 minutes. Transfer 1/2 of the cooked onion to a large bowl and set aside."
    },
    {
      "position": 5,
      "text": "Stir marinara sauce, beef broth, balsamic vinegar, and red pepper flakes into the skillet with cooked onion; cook and stir for 1 minute."
    },
    {
      "position": 6,
      "text": "Pour sauce mixture into a 9x13-inch baking dish and set aside."
    },
    {
      "position": 7,
      "text": "Combine ground beef, Italian sausage, diced tomatoes, Italian parsley, garlic, salt, black pepper, and cayenne pepper into the bowl with reserved onions; mix well. Stir in cooked rice and one cup of Parmigiano Reggiano. Stuff bell peppers with beef and sausage mixture."
    },
    {
      "position": 8,
      "text": "Place stuffed bell pepper halves in the baking dish over tomato sauce; optionally sprinkle with additional Parmigiano Reggiano, cover baking dish with aluminum foil, and bake in the preheated oven for 45 minutes."
    },
    {
      "position": 9,
      "text": "Remove aluminum foil and continue to bake until meat is no longer pink, bell peppers are tender and cheese is browned on top, an additional 20 to 25 minutes. Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

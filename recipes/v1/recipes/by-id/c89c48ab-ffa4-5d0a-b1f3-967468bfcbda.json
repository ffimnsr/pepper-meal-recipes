  "id": "c89c48ab-ffa4-5d0a-b1f3-967468bfcbda",
  "slug": "instant-pot-cranberry-sauce",
  "name": "Instant Pot Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "This Instant Pot cranberry sauce is easy to make in mere minutes for your holiday dinner and will save you precious stovetop space.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, orange juice, water, cinnamon stick, and vanilla extract in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 1 minute. Allow about 10 minutes for pressure to build. As soon as the cooking cycle finishes, turn the Instant Pot off, as overcooking the cranberries will cause the skins to break."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 7 minutes. Unlock and carefully remove the lid."
    },
    {
      "position": 3,
      "text": "Turn Instant Pot back on and select Saut\u00e9 function. Stir white sugar and brown sugar into cranberry mixture until sugar melts. Season with a pinch of salt. As soon as sugar has melted, turn off the Instant Pot to avoid overcooking. Taste cranberry sauce and stir in more sugar, 1 tablespoon at a time, depending on how sweet you like your cranberry sauce."
    },
    {
      "position": 4,
      "text": "Transfer sauce to a serving dish and top with orange peel. Serve warm or cold. Cranberry sauce will thicken as it cools."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

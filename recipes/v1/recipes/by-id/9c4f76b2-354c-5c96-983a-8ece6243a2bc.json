{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9c4f76b2-354c-5c96-983a-8ece6243a2bc",
  "slug": "strawberry-rhubarb-coffee-cake",
  "name": "Strawberry Rhubarb Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This strawberry rhubarb coffee cake is sweet and fruity with a crunchy crumb topping. Adding nuts to the streusel bumps up the crunch.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2/3 cup sugar and cornstarch in a large saucepan; stir in rhubarb and strawberries. Bring to a simmer over medium heat; cook until thickened, about 2 minutes. Remove from the heat, stir in lemon juice, and let cool."
    },
    {
      "position": 2,
      "text": "While the filling cools, preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Combine 3 cups flour, 1 cup sugar, baking powder, and baking soda in a large bowl. Cut in 1 cup cold butter using 2 knives or pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 4,
      "text": "Whisk buttermilk, eggs, and vanilla together in a separate bowl; stir into flour mixture until just moistened. Spoon 2/3 of batter into the prepared pan; spread cooled filling over top, then cover with remaining 1/3 of batter."
    },
    {
      "position": 5,
      "text": "Combine 3/4 cup sugar and 1/2 cup flour in a bowl. Cut in 1/4 cup cold butter using 2 knives or pastry blender until the mixture resembles coarse crumbs; sprinkle over batter."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until topping is golden brown and a tester inserted into the center comes out clean, 45 to 50 minutes. Cool on a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 45,

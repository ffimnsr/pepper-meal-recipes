  "id": "4ad0e5a7-9a8e-53d4-9736-9022499672cf",
  "slug": "meatless-buffalo-dip",
  "name": "Meatless Buffalo Dip",
  "recipe_type": "appetizer",
  "brief_description": "Cannellini beans replace chicken in this vegetarian version of Buffalo chicken dip even your non-vegetarian family and friends will love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, blue cheese dressing, 1/2 cup Cheddar cheese, and Buffalo wing sauce together in a bowl. Slightly mash cannellini beans in a separate bowl; fold into cheese mixture. Spread mixture into a pie pan or baking dish and top with remaining Cheddar cheese and chives."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbly, 20 to 25 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

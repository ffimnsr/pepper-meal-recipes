{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d9f062ed-f1ab-5191-bc04-175869c605c9",
  "slug": "orange-cinnamon-rolls-recipe-8642451",
  "name": "Orange Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "These fluffy orange cinnamon rolls made with fresh orange juice and zest have a sweet cinnamon and brown sugar filling and a sticky orange glaze!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour warmed milk into the bowl of a stand mixer fitted with a paddle attachment for the dough. Sprinkle yeast evenly over the surface of the milk. Let stand until foamy, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Add egg and egg yolk, butter, honey, orange zest, and orange juice to the yeast mixture. Beat on low until combined, about 45 seconds. Add 2 cups flour; beat on low until a wet dough forms, about 1 minute. Turn off mixer; switch to the dough hook attachment. Add 1 \u00bd cups flour and salt, beat on medium until dough is soft and elastic, 7 to 10 minutes. If necessary, add an additional \u00bd cup flour, tablespoon by tablespoon, using as little as possible to achieve a soft dough. The dough should be quite sticky."
    },
    {
      "position": 3,
      "text": "Gather dough into a ball and transfer to a large greased bowl. Cover with plastic wrap and set aside to rise at room temperature until doubled in size, about 1 hour."
    },
    {
      "position": 4,
      "text": "To make the filling: Combine butter, brown sugar, cinnamon, and orange zest in a bowl. Mix with a spatula until smooth and creamy, about 1 minute. Set aside."
    },
    {
      "position": 5,
      "text": "Grease a 13x9-inch baking dish; set aside. Punch down the dough and transfer to a well-floured surface. Roll dough into a large 10x18-inch rectangle. Spread the filling over the surface of the dough, leaving a \u00bd inch border along the top long edge."
    },
    {
      "position": 6,
      "text": "Roll the dough away from you to create a log, and pinch seam to seal."
    },
    {
      "position": 7,
      "text": "Cut dough log into 12 equal rolls (about 1 \u00bd inches wide). Transfer rolls to prepared baking dish. Loosely cover with plastic wrap, and set aside to rise at room temperature until puffy and almost doubled in size, 30 to 45 minutes."
    },
    {
      "position": 8,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 9,
      "text": "Bake rolls in the preheated oven until golden brown, 22 to 25 minutes."
    },
    {
      "position": 10,
      "text": "While rolls are baking, prepare the frosting. Combine cream cheese, powdered sugar, orange zest, orange zest, and salt in the bowl of a stand mixer fitted with the paddle attachment. Beat at medium-high speed until very smooth and creamy, 2 to 3 minutes."
    },
    {
      "position": 11,
      "text": "Remove rolls from oven and transfer to a wire rack. Let cool 2 minutes, then spread frosting evenly over the rolls. Serve warm. Recipe developed by Nicole Hopper"
    }
  ],
  "servings": 12,

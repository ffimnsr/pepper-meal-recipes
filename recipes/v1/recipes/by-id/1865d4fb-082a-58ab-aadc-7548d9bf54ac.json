  "id": "1865d4fb-082a-58ab-aadc-7548d9bf54ac",
  "slug": "easy-caramel-apple-salad",
  "name": "Easy Caramel Apple Salad",
  "recipe_type": "salad",
  "brief_description": "Butterscotch pudding, apples, peanuts, and whipped topping are folded together into an easy caramel apple salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir whipped topping, pineapple, and butterscotch pudding mix together in a large bowl until smooth."
    },
    {
      "position": 2,
      "text": "Fold apples and peanuts into pudding mixture until mixture is well combined."
    },
    {
      "position": 3,
      "text": "Refrigerate at least 30 minutes."
    }
  ],
  "servings": 12,

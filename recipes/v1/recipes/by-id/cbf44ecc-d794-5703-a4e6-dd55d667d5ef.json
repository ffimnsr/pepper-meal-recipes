  "schema_version": 1,
  "id": "cbf44ecc-d794-5703-a4e6-dd55d667d5ef",
  "slug": "marinated-grilled-flank-steak",
  "name": "Marinated Grilled Flank Steak",
  "recipe_type": "main",
  "brief_description": "This marinated grilled flank steak recipe features a spicy, zesty blend of condiments and seasonings before grilling and bursting with flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine horseradish, olive oil, Dijon mustard, soy sauce, garlic, balsamic vinegar, kosher salt, and black pepper in a large resealable plastic bag; add steak, toss to coat, squeeze out excess air and seal the bag. Marinate in the refrigerator 2 to 4 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Cook on the preheated grill until both sides are browned and center is firm and juicy, 5 to 6 minutes per side, making sure not to overcook. An instant-read thermometer inserted into center should read 130 degrees F (54 degrees C) for medium-rare. Rest 5 minutes; slice thinly at an angle."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 5,
  "difficulty": "easy",

  "id": "ca26939e-4c88-5080-abfd-c69a57d96334",
  "slug": "4-ingredient-slow-cooker-peach-cobbler-recipe-8645989",
  "name": "4-Ingredient Slow Cooker Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This comforting peach cobbler made in the slow cooker with sweet juicy peaches, cake mix, and butter might be the easiest dessert you've ever made!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine peaches and sugar in a medium bowl. Stir well and let stand for 5 minutes."
    },
    {
      "position": 2,
      "text": "Liberally spray a slow cooker with cooking spray."
    },
    {
      "position": 3,
      "text": "Stir peaches once more and add to the prepared slow cooker. Sprinkle cake mix evenly over the peaches; don't stir. Distribute butter pieces evenly over cake mix."
    },
    {
      "position": 4,
      "text": "Cover and cook on High until cake is golden and bubbly around the edges, about 3\u00bd hours. Turn off slow cooker and let stand 15 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 10,

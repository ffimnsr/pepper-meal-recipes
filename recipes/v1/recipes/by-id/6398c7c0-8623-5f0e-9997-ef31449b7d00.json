  "id": "6398c7c0-8623-5f0e-9997-ef31449b7d00",
  "slug": "parmesan-chive-biscuits-recipe-7505885",
  "name": "Parmesan Chive Biscuits",
  "recipe_type": "side",
  "brief_description": "These savory Parmesan chive biscuits can go with nearly any dinner main, or will be a superb addition to the brunch buffet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "In a bowl, whisk together flour, Parmesan, chives, baking powder, salt, baking soda, and pepper."
    },
    {
      "position": 3,
      "text": "Stir in sour cream until the mixture resembles coarse grains. Add milk and fold until it just comes together. Scoop the batter by the 1/4 cup using a cookie scoop or an ice cream scoop onto the prepared baking sheet, 1 inch apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Remove and brush with melted butter. Bake until golden brown, 5 to 7 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d628cb29-822c-5fe7-a2c8-fc2b45ce213d",
  "slug": "tex-mex-potato-soup",
  "name": "Tex Mex Potato Soup",
  "recipe_type": "soup",
  "brief_description": "A puree of potatoes boiled in chicken broth is added to a saute of mixed peppers, chilies, and ham in this spicy soup cooked with heavy cream and egg yolk. Serve with shredded cheddar cheese.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Cook potatoes in boiling water until tender, about 15 minutes. Drain and reserve."
    },
    {
      "position": 2,
      "text": "In a skillet, saute onion, green and red pepper in butter for 10 minutes, or until softened. Stir in the ham, green chilies, white pepper and cayenne. Cook for 1 minute longer. Reserve."
    },
    {
      "position": 3,
      "text": "In a blender, combine the potatoes and chicken broth and blend until smooth. Add to the sauteed vegetable mixture."
    },
    {
      "position": 4,
      "text": "Heat soup just to boiling. Beat the egg yolk with the heavy cream in a small bowl. Stir in 1/2 cup hot soup, stir yolk mixture back into sauce pan. Gently heat soup, but do not boil. Garnish with shredded cheddar cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

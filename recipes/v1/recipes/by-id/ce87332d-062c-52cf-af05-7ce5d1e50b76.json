  "id": "ce87332d-062c-52cf-af05-7ce5d1e50b76",
  "slug": "quick-chicken-couscous",
  "name": "Quick Chicken Couscous",
  "recipe_type": "main",
  "brief_description": "Made with chicken and diced veggies of your choice, this quick chicken couscous bowl is an impressive meal that takes just minutes to make once all the ingredients are prepped.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place couscous in a heat-proof mixing bowl. Add salt, pepper, cayenne, and olive oil; stir with a spoon until all couscous is coated with oil. Level off to smooth the top and set aside."
    },
    {
      "position": 2,
      "text": "Season chicken on both sides with salt."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a saucepan over high heat. Add chicken and sear for 2 to 3 minutes on one side. Flip and add onions. Sear chicken on second side, while sauteing onions at the same time, for 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove chicken to a plate and let cool for a few minutes. Cut chicken into 1/2-inch cubes and return to the saucepan."
    },
    {
      "position": 5,
      "text": "Add chicken broth, zucchini, green beans, bell pepper, green onions, paprika, and turmeric to the saucepan. Place over high heat. As soon as it boils, remove from the heat and carefully dump it on top of the couscous; do not stir. Immediately wrap bowl tightly with foil and set a timer for 5 minutes."
    },
    {
      "position": 6,
      "text": "When timer goes off, unwrap foil and toss in parsley. Stir to combine ingredients. Taste and adjust for salt."
    },
    {
      "position": 7,
      "text": "Spoon couscous onto serving plate and garnish with feta cheese, chili flakes, and parsley and a drizzle of olive oil."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

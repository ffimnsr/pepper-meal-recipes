{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "30d0fb55-989e-519a-8a29-45d10bc3419a",
  "slug": "zombie-eyes-halloween-meatballs",
  "name": "Zombie Eyes (Halloween Meatballs)",
  "recipe_type": "appetizer",
  "brief_description": "These spooky Halloween meatballs are full of flavor and fun to make. Serve each scary meatball on a fork with spaghetti and arrange on a party platter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Whisk Parmesan cheese, bread crumbs, egg, garlic, parsley, basil, and oregano together in a large mixing bowl. Fold in ground beef and mix with your hands until blended. Form 16 equal-sized meatballs using a cookie scoop."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large skillet over medium-high heat. Brown meatballs for 3 minutes on each side. Transfer cooked meatballs to a baking sheet using tongs."
    },
    {
      "position": 5,
      "text": "Bake browned meatballs in the oven for 8 minutes."
    },
    {
      "position": 6,
      "text": "While meatballs bake, use a plastic straw to punch a hole through each olive half to create a circular \"pupil.\" Use the same straw to punch a hole through the center of each string cheese slice. Insert the round olive piece inside the hole in the string cheese slice to create \"eyes.\""
    },
    {
      "position": 7,
      "text": "Remove meatballs from the oven; set aside until cool enough to handle."
    },
    {
      "position": 8,
      "text": "Assemble zombie eyes by twirling a few strands of cooked spaghetti around each of 16 forks. Spear a meatball onto each fork and arrange forks on a serving platter. Spoon a dot of spaghetti sauce onto each meatball where you want to place the \"eyes.\" Apply the olive-cheese \"eye\" over the sauce. Spoon remaining spaghetti sauce over the twirled spaghetti on the forks."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 45,

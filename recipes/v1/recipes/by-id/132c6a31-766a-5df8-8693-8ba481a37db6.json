  "id": "132c6a31-766a-5df8-8693-8ba481a37db6",
  "slug": "refried-beans-without-the-refry",
  "name": "Refried Beans Without the Refry",
  "recipe_type": "side",
  "brief_description": "These refried beans seasoned with garlic, jalape\u00f1o, and cumin are simmered with water in a slow cooker for 8 hours until tender and easy to mash.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place beans, onion, jalape\u00f1o, garlic, salt, pepper, and cumin into a slow cooker. Pour in water; stir to combine."
    },
    {
      "position": 3,
      "text": "Cook on High until beans are very tender, about 8 hours; add more water as needed."
    },
    {
      "position": 4,
      "text": "Strain beans and reserve cooking liquid."
    },
    {
      "position": 5,
      "text": "Transfer beans to a large, shallow bowl. Use a potato masher to mash beans, adding reserved cooking liquid as needed to reach desired consistency."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 15,

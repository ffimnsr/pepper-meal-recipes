  "schema_version": 1,
  "id": "6faf1ffd-59e0-53cd-adba-02eaf781931b",
  "slug": "vegan-lettuce-wraps-with-tofu",
  "name": "Vegan Lettuce Wraps with Tofu",
  "recipe_type": "appetizer",
  "brief_description": "These easy to make vegan lettuce wraps will be loved by everyone, including meat eaters. The tofu provides a texture similar to ground chicken.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine hoisin sauce, soy sauce, ginger, rice vinegar, Sriracha sauce, sesame oil, and garlic in a bowl; mix to combine and set aside."
    },
    {
      "position": 2,
      "text": "Place tofu onto a plate and place another plate on top. Set a 3- to 5-pound weight on top. Press tofu for 20 to 30 minutes; drain and discard the accumulated liquid."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet or wok over medium-high heat. Crumble tofu into the skillet and cook for 5 minutes. Add onion and cook and stir for 3 minutes. Stir in mushrooms and water chestnuts and cook for 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir in hoisin mixture and mix well. Cook enough for the liquid to reduce some."
    },
    {
      "position": 5,
      "text": "Serve with lettuce and garnish with green onions and carrots."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

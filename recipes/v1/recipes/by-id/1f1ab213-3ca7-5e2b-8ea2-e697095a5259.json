  "id": "1f1ab213-3ca7-5e2b-8ea2-e697095a5259",
  "slug": "eggnog-from-scratch",
  "name": "Eggnog from Scratch",
  "recipe_type": "drink",
  "brief_description": "Make eggnog from scratch and you'll be amazed how great the real thing is. Mix egg with cream, sugar, rum, and more for a favorite holiday drink.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg yolks in a large mixing bowl. Gradually add sugar. Beat until mixture thickens. Stir in milk and rum. Pour into a large punch bowl and chill for 3 to 4 hours."
    },
    {
      "position": 2,
      "text": "Fold in lightly whipped heavy cream with vanilla before serving."
    }
  ],
  "servings": 12,

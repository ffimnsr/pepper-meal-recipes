  "id": "f418148d-7c0d-5417-9605-8fd65ff31adb",
  "slug": "citrus-turkey-brine",
  "name": "Citrus Turkey Brine",
  "recipe_type": "main",
  "brief_description": "This easy citrus turkey brine adds fresh, bright flavor to your holiday bird and ensures juicy, tender meat \u2014 no matter how you decide to cook it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Rub turkey all over with salt."
    },
    {
      "position": 3,
      "text": "Place remaining salt into a large stainless steel or enameled stockpot. Add onion, orange, and lemon wedges to the pot, along with garlic, bay leaves, thyme, and pepper."
    },
    {
      "position": 4,
      "text": "Place turkey into the pot and pour in cold water. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "When ready to cook, discard brine. Rinse turkey, then pat dry and place in a roasting pan. Refrigerate, uncovered, for 2 to 3 hours. Roast, grill, or deep-fry turkey according to your favorite recipe."
    }
  ],
  "servings": 12,

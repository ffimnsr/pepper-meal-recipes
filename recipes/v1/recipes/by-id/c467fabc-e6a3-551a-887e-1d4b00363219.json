  "id": "c467fabc-e6a3-551a-887e-1d4b00363219",
  "slug": "truffle-lovers-popcorn",
  "name": "Truffle Lovers' Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Your bowl of microwaved popcorn gets a gourmet touch when it's flavored with truffle oil and Parmesan cheese.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix the truffle oil, parsley, and Parmesan cheese in a heat-safe bowl."
    },
    {
      "position": 2,
      "text": "Place unopened package of popcorn into center of microwave oven; cook on High power until the bag fills with popped corn and the pops occur about 2 seconds apart (1 1/2 to 4 minutes, depending on oven's power). Open hot bag carefully and pour into bowl. Toss with truffle oil mixture; season to taste with sea salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

  "id": "581a3f9f-9c31-56a0-af8f-9c6505a630bd",
  "slug": "pesto-spaghetti-squash",
  "name": "Pesto Spaghetti Squash",
  "recipe_type": "side",
  "brief_description": "This pesto spaghetti squash, featuring onions, mushrooms, and kale, gets a cheesy boost from Parmesan for a hearty side or comforting vegetarian meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Place squash skin-side down on prepared baking sheet: bake until cooked through, about 1 hour. Cool for 10 minutes. Scrape flesh into string-like strands with a fork: place in a bowl."
    },
    {
      "position": 3,
      "text": "Melt 1 tablespoon of butter in a large skillet over medium-high heat: add onion. Cook and stir until onion begins to turn translucent. Stir in mushrooms and kale; reduce heat to medium-low."
    },
    {
      "position": 4,
      "text": "Stir in squash, remaining 2 tablespoons butter, garlic salt, Italian seasoning, and red pepper flakes; cook for 2 minutes. Transfer squash mixture to a large bowl."
    },
    {
      "position": 5,
      "text": "Stir pesto and olive oil into squash mixture. Slowly stir in grated Parmesan cheese until evenly mixed."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

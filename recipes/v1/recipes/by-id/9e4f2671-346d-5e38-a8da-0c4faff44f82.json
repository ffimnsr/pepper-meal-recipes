  "id": "9e4f2671-346d-5e38-a8da-0c4faff44f82",
  "slug": "pineapple-slaw",
  "name": "Pineapple Slaw",
  "recipe_type": "salad",
  "brief_description": "This pineapple slaw recipe with cabbage, onions, bell pepper, and a creamy dressing made with vinegar, mayo, and sugar adds sweetness to your slaw.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cabbage, pineapple, green onions, and bell pepper in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk vinegar, mayonnaise, sugar, salt, and black pepper together in a separate bowl; toss into cabbage mixture to coat."
    },
    {
      "position": 3,
      "text": "Cover bowl with plastic wrap and refrigerate before serving, at least 2 hours."
    }
  ],
  "servings": 20,

  "id": "c6a34bff-81de-5b97-bc3e-d4be493ea347",
  "slug": "refrigerator-dill-pickles",
  "name": "Refrigerator Dill Pickles",
  "recipe_type": "side",
  "brief_description": "Easy refrigerator dill pickles perfectly seasoned with just the right amount of dill ang garlic. Crisp, delicious spears, ready to eat in just 3 days!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir water, vinegar, sugar, and sea salt together in a saucepan over high heat; bring to a boil. Remove from the heat and cool completely."
    },
    {
      "position": 3,
      "text": "Combine cucumber spears, garlic cloves, and fresh dill in a large glass or plastic lidded container."
    },
    {
      "position": 4,
      "text": "Pour cooled vinegar mixture over cucumbers, garlic, and dill."
    },
    {
      "position": 5,
      "text": "Seal container with lid and refrigerate for at least 3 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

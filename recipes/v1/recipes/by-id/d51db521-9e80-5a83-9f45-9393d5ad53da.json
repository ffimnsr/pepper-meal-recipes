  "id": "d51db521-9e80-5a83-9f45-9393d5ad53da",
  "slug": "air-fryer-everything-bagel-bites",
  "name": "Air Fryer Everything Bagel Bites",
  "recipe_type": "appetizer",
  "brief_description": "These chewy bagel bites made with Boursin\u00ae cheese and \"Everything\" bagel seasoning are cooked in the air fryer and will have everybody asking for more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 330 degrees F (165 degrees C). Spray the air fryer basket with cooking spray and set aside."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt together in a bowl. Add yogurt and mix with a fork until well combined."
    },
    {
      "position": 3,
      "text": "Dust a work surface with flour. Remove dough from the bowl, and knead until no longer sticky, about 12 times. Add a little bit more flour if necessary."
    },
    {
      "position": 4,
      "text": "Evenly divide dough into 8 pieces and flatten into circles with the palm of your hand. Place 1/2 tablespoon cheese spread in the center of each circle. Pull up the edges of the dough to cover the cheese, roll into a ball, and pinch the seams closed."
    },
    {
      "position": 5,
      "text": "Brush each bagel bite with egg white and sprinkle with bagel seasoning."
    },
    {
      "position": 6,
      "text": "Transfer bagel bites, seam sides down, into the prepared air fryer basket. Do not overcrowd. Depending on the size of your air fryer, you may have to do 2 batches."
    },
    {
      "position": 7,
      "text": "Air fry until golden, 10 to 12 minutes. Remove bagel bites from the basket, and cool for about 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

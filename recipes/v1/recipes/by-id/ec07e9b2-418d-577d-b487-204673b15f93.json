  "slug": "easy-hoppin-john",
  "name": "Easy Hoppin' John",
  "recipe_type": "soup",
  "brief_description": "This easy Hoppin' John recipe uses canned black-eyed peas and instant rice to make a quicker version of the beloved Southern dish in under an hour.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place sausage and onion into a large saucepan over medium heat; cook and stir until sausage begins to brown, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in black-eyed peas, chicken stock, water, and cayenne pepper, and bring to a boil. Stir in rice; cover and cook, stirring occasionally, until rice is tender, 20 to 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "4bcc8aa9-22d2-50e3-9fc6-4a0eabb44836",
  "slug": "one-pan-garlic-bread-tortellini-recipe-11889118",
  "name": "One-Pan Garlic Bread Tortellini",
  "recipe_type": "main",
  "brief_description": "In this one-pan garlic bread tortellini, cheese tortellini cook in a creamy, cheesy sauce with chicken before being topped with a garlicky breadcrumb mixture, then crisped under the broiler. You''ll have all the flavor of garlic bread in a hearty, one-pot dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 2 tablespoons of butter in a deep skillet over medium heat. Add garlic and saut\u00e9 until fragrant, about 1 minute."
    },
    {
      "position": 2,
      "text": "Add 6 tablespoons butter to the skillet and stir constantly until melted. Stir in half-and-half, chicken stock 1/2 teaspoon salt, 1/4 teaspoon garlic powder, black pepper, and cayenne. Add tortellini to the skillet and stir. Bring to a boil, then reduce heat to medium-low. Cook, stirring occasionally, until tortellini are tender and sauce is bubbly and slightly thickened, 6 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Gradually stir in 3/4 cup Parmesan cheese until melted and sauce has thickened. Stir in chicken. Remove from heat and sprinkle mozzarella cheese over the top."
    },
    {
      "position": 4,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 5,
      "text": "In a microwave-safe bowl, melt the remaining 2 tablespoons butter in the microwave. Stir in breadcrumbs, remaining 1/4 cup Parmesan cheese, remaining 1/2 teaspoon garlic powder, remaining 1/4 teaspoon salt, and Italian seasoning. Spread evenly over the top of the tortellini."
    },
    {
      "position": 6,
      "text": "Place the skillet under the broiler and broil until mozzarella is melted and breadcrumbs are toasted."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

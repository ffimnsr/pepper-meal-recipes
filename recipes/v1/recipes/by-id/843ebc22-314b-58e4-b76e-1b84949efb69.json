  "id": "843ebc22-314b-58e4-b76e-1b84949efb69",
  "slug": "air-fryer-french-toast",
  "name": "Air Fryer French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This easy, delicious air fryer French toast with vanilla, butter, and cinnamon can be made with varying flavors by using different milks or extracts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 370 degrees F (190 degrees C). Line the basket with parchment paper and coat with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together eggs, milk, melted butter, vanilla, and cinnamon in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Dip each bread slice in egg mixture, then place in the prepared basket. Make sure they are not touching; work in batches if necessary."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 4 to 6 minutes; flip and cook until golden brown, 2 to 3 minutes more."
    },
    {
      "position": 5,
      "text": "Sprinkle with confectioners' sugar to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

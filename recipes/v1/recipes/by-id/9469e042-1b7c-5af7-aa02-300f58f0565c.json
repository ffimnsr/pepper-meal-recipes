  "id": "9469e042-1b7c-5af7-aa02-300f58f0565c",
  "slug": "white-sloppy-joes",
  "name": "White Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "A quick and easy alternative to regular Sloppy Joes, these are made with ground beef in a creamy white sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground beef in a large skillet over medium-high heat. Cook, stirring to crumble, until evenly browned. Drain off excess grease. Stir in cream of mushroom soup (undiluted), milk and liquid smoke. Reduce heat to low, and cook just until hot. Stir in sour cream, and season with salt and pepper. Remove from heat. Serve on hamburger buns."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

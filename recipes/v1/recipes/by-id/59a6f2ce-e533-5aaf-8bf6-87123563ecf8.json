{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "59a6f2ce-e533-5aaf-8bf6-87123563ecf8",
  "slug": "10000-year-old-hamburger-helper-recipe-12064304",
  "name": "10,000-Year-Old Hamburger Helper",
  "recipe_type": "main",
  "brief_description": "This recipe proves that Hamburger Helper was invented 10,000 years ago, using farro, a beautiful ancient grain that\u2019s still easy to find. Farro has a mild flavor and toothsome texture and, depending on how it\u2019s processed, may cook quickly or take a little more time. In any case, you can stretch a small amount of meat into a big, beautiful, delicious, and nutritious meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse farro under cold water in a strainer, and set aside until needed."
    },
    {
      "position": 2,
      "text": "Add oil, ground beef, and salt to a pan set over high heat. As beef starts to brown, break into small crumbles with a spatula. Add mushrooms and cook, stirring, until mushrooms and beef are as browned as you like, about 5 minutes. The browner the better. You can reduce the heat to medium-high if the pan seems to be getting too hot."
    },
    {
      "position": 3,
      "text": "Add onions and celery and cook, stirring, until onions start to turn translucent, about 3 minutes. Season with black pepper, cumin, paprika, garlic powder, and oregano, and cook, stirring, for 1 minute. Stir in tomato paste, and cook for 1 to 2 more minutes."
    },
    {
      "position": 4,
      "text": "Add farro to the pan, and stir until coated with olive oil and rendered beef fat. Pour in beef broth, and stir to combine. Raise heat to high, and bring pan to a simmer. Stir again, cover the pan tightly, reduce heat to medium-low, and cook for 10 minutes."
    },
    {
      "position": 5,
      "text": "After 10 minutes, uncover and test the farro for doneness. It should have the texture of al dente pasta. Turn off the heat, cover, and let rest for 7 minutes. Uncover, and stir in chives and Cheddar cheese. Taste for seasoning, and adjust if needed. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

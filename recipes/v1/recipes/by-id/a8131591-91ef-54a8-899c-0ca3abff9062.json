  "id": "a8131591-91ef-54a8-899c-0ca3abff9062",
  "slug": "million-dollar-corn-ribs-recipe-12062365",
  "name": "Million Dollar Corn Ribs",
  "recipe_type": "appetizer",
  "brief_description": "These corn ribs are seasoned with garlic, onion, and paprika, broiled until golden, then topped with bacon, green onions, and slivered onions. They deliver the over-the-top spicy, salty, and rich flavors you expect from a million-dollar recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir garlic powder, onion powder, paprika, cayenne, salt, and black pepper together in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Place corn ribs in a large bowl, drizzle with olive oil, and season with 2/3 of the seasoning mixture. Toss well, being sure to smear spices and oil evenly over each rib. Transfer corn ribs onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Turn the oven\u2019s broiler to Low and set a rack about 6 inches from the heat source."
    },
    {
      "position": 4,
      "text": "Broil on Low for 10 minutes and then broil on High until corn starts to blister, 5 to 7 minutes more."
    },
    {
      "position": 5,
      "text": "Add mayonnaise to the remaining seasoning mixture and brush evenly onto corn. Garnish with bacon, almonds, and green onion. Sprinkle with Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,

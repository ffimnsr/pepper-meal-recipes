{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "97fff9d7-8bd7-5903-a4a2-488e58d65dfa",
  "slug": "brown-sugar-cinnamon-bloomin-bread-recipe-11965555",
  "name": "Brown Sugar Cinnamon Bloomin' Bread",
  "recipe_type": "breakfast",
  "brief_description": "This brown sugar cinnamon bloomin' bread could not be easier. Slice a boule deeply in a cross-hatch pattern, brush and drizzle a brown sugar cinnamon butter into the gaps, then bake to turn this loaf into a delicious pull-apart bread. Take it over the top with an easy vanilla icing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice bread loaf using a serrated knife in a cross-hatch pattern. To do so, make vertical lines about 1 to 1.5 inches apart in one direction - slice almost all the way through, but leave about 1/2 inch intact on the bottom of the loaf. Then turn bread loaf 90 degrees and slice vertical lines about 1 to 1.5 inches apart in the opposite direction."
    },
    {
      "position": 3,
      "text": "Stir melted butter, brown sugar, cinnamon and a small pinch of salt together in a small bowl until sugar dissolves in the warm butter. Taste and adjust here - if you\u2019d like it a little sweeter, add more brown sugar in teaspoon increments."
    },
    {
      "position": 4,
      "text": "Brush brown sugar-cinnamon butter between all of the bread slices with a pastry brush. Then, use a spoon to drizzle over any remaining brown sugar-cinnamon butter."
    },
    {
      "position": 5,
      "text": "Wrap up the bread loaf in aluminum foil and place in an oven safe pot or on a sheet tray."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until well warmed through, 15 to 18 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, for vanilla icing, whisk confectioner\u2019s sugar, milk (more milk results in a looser icing), vanilla extract, and a small pinch of salt together until sugar dissolves. Set aside."
    },
    {
      "position": 8,
      "text": "Remove bread from the oven and unwrap the foil. Allow the bread to cool slightly, then simply pull out a slice. Bonus points if you dip in the icing for leveled-up deliciousness."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

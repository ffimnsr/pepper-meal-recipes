  "id": "48cf5edc-4177-55ec-9805-dd398e34dbc1",
  "slug": "quick-chicken-enchilada-skillet-recipe-11978923",
  "name": "Quick Chicken Enchilada Skillet",
  "recipe_type": "main",
  "brief_description": "This quick chicken enchilada skillet is an easy one-pan dinner loaded with chicken, beans, corn, tortilla chips, and plenty of cheese. Ready in just 15 minutes, it delivers all the bold, comforting flavors of enchiladas with minimal prep and cleanup.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven's broiler on a lower setting if available."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep oven-proof skillet over medium-high heat. Add onions and cook until softened, about 2 minutes. Stir in beans, corn, salsa, and chicken until well combined and cook until heated through, about 5 minutes. Pour over half of the enchilada sauce and top with half of the chips. Top with remaining sauce, remaining chips, and shredded cheese."
    },
    {
      "position": 3,
      "text": "Remove from heat and transfer pan to the preheated oven on the middle rack . Bake until cheese is melted and bubbly, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Serve topped with desired toppings."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "ee5aedba-6ea2-59d8-b965-d836fe5c8548",
  "slug": "asian-inspired-carrot-hummus",
  "name": "Asian-Inspired Carrot Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Roasted carrots bring sweetness and ginger adds a little zing to this Asian-inspired carrot hummus that's easy to make.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Distribute carrots and garlic cloves on the baking sheet. Drizzle with 2 teaspoons sesame oil and season with kosher salt; toss to coat."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until carrots are tender, stirring halfway through, about 25 minutes. Remove from the oven and allow carrots to cool to room temperature, 10 to 15 minutes.."
    },
    {
      "position": 4,
      "text": "Add the carrot-garlic mixture, garbanzo beans, cashews, rice vinegar, lime juice, tahini, ginger, Sriracha, paprika, and salt to a food processor; blend until well combined. Stream in the reserved bean liquid though the feed tube, one tablespoon at a time, until hummus is smooth and creamy and has reached desired consistency."
    },
    {
      "position": 5,
      "text": "Taste, and adjust seasoning, if necessary. Transfer to a bowl, and garnish with a drizzle of sesame oil and chopped cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

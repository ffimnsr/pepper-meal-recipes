  "id": "9d622a22-b087-5cb6-966e-f172d85221be",
  "slug": "air-fryer-cajun-crab-cakes",
  "name": "Air Fryer Cajun Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "Quick, easy, and full of Cajun-inspired flavor, these air fryer crab cakes make the perfect appetizer or main dish.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 370 degrees F (188 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Mix bread crumbs, mayonnaise, egg, Worcestershire, mustard, Cajun seasoning, salt, cayenne, and pepper together in a small mixing bowl. Fold in crabmeat gently."
    },
    {
      "position": 3,
      "text": "Form into 3 equal-size crab cakes using a biscuit cutter. Place cakes on a parchment round and transfer to the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 6 minutes. Flip and continue to cook until browned, about 6 minutes more. Serve with remoulade sauce on slider buns."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

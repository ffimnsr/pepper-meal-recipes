  "id": "1d895fe9-64c0-52a5-880f-1ae519cb2c0a",
  "slug": "breaded-parmesan-chicken",
  "name": "Breaded Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "The never-ending search for perfect comfort food may very well lead here, with a pleasing arrangement of chicken coated with herbed parmesan.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a small shallow dish combine the stuffing mix, cheese, parsley, curry powder and seasoning. Mix together."
    },
    {
      "position": 3,
      "text": "In an 8x11 inch baking dish, melt the butter/margarine in the microwave. Dip the chicken breasts in the stuffing mixture, coating both sides of each breast."
    },
    {
      "position": 4,
      "text": "Place chicken in baking dish and sprinkle any leftover stuffing mixture over the chicken. Bake in the preheated oven for 20 minutes, then turn chicken pieces over and bake for another 20 to 25 minutes or until chicken is cooked through. Enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

  "id": "1e766744-a45b-5aad-9c1b-d4d9713ab042",
  "slug": "air-fryer-pasta-tacos-recipe-11720466",
  "name": "Air Fryer Pasta Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer pasta tacos are a fusion of manicotti and tacos. Pasta shells, filled with taco seasoned beef and cheese, are coated in crushed tortilla chips and air fried for a crunchy, savory pasta \"taco\".",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add pasta and cook for 6 minutes. Drain and rinse under cold water. Set aside."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium-high heat. Add beef and cook, crumbling with a spoon, until evenly browned, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Add taco seasoning, green chiles, and RO*TEL and stir, scraping up any browned bits from the bottom of the pan. Remove from heat and stir in Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Fill each pasta shell with beef mixture and freeze for at least 30 minutes or up to 1 hour."
    },
    {
      "position": 5,
      "text": "Meanwhile, whisk together eggs and milk in a shallow dish. Place crushed tortilla chips in a second shallow dish. Lighty coat filled pasta with egg wash and coat in crushed crumbs, pressing lightly to adhere if necessary."
    },
    {
      "position": 6,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer\u2019s instructions."
    },
    {
      "position": 7,
      "text": "Working in 2 batches, air fry the pasta tacos for 10 to 12 minutes. Serve with desired toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

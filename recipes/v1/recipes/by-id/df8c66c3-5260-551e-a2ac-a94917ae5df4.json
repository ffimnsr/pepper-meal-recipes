  "id": "df8c66c3-5260-551e-a2ac-a94917ae5df4",
  "slug": "no-dough-potato-pizza-recipe-11937375",
  "name": "No-Dough Potato Pizza",
  "recipe_type": "main",
  "brief_description": "This potato pizza swaps traditional dough for a crispy crust made from thinly sliced potatoes. Topped with two kinds of cheese, bacon, and green onions, it\u2019s a hearty, customizable dinner made with just one russet potato.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Using the slicing side of a box grater, slice potato into thin rounds."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with parchment paper. Lay potato slices on the parchment paper to form a wide circle, slightly overlapping slices and ensuring no parchment is left uncovered. Drizzle slices with olive oil, then season lightly with salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until potatoes are slightly fork tender, 15 to 20 minutes. Remove from the oven. Cover potatoes with mozzarella cheese, then Cheddar. Return to the oven until cheese melts slightly, about 5 minutes. Remove from the oven and top with bacon. Return to the oven and let bake until cheese is completely melted, 5 to 6 minutes."
    },
    {
      "position": 4,
      "text": "Remove and sprinkle with green onion. Let cool for 3 minutes before removing from parchment to a work surface. Cut into wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

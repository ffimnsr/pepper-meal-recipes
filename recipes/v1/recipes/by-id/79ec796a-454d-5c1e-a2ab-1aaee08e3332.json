  "id": "79ec796a-454d-5c1e-a2ab-1aaee08e3332",
  "slug": "instant-pot-baked-potatoes-recipe-7511106",
  "name": "Instant Pot Baked Potatoes",
  "recipe_type": "side",
  "brief_description": "This method for Instant pot baked potatoes is perfect for when the oven is already in use or you don't want to heat up the kitchen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour water into the bottom of a multi-functional pressure cooker (such as Instant Pot\u00ae). Place a trivet on top. Rinse potatoes and pierce each with a fork several times. Place potatoes on the trivet."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer\u2019s instructions; set timer for 20 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, 10 to 40 minutes. Unlock and remove the lid."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "84707a03-aed8-56a9-827a-a781403772aa",
  "slug": "easy-paneer-tikka",
  "name": "Easy Paneer Tikka",
  "recipe_type": "appetizer",
  "brief_description": "Paneer tikka is an Indian vegetarian tikka dish where paneer cheese, onion, and bell peppers are first marinated, then skewered and grilled.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Line a fine-mesh strainer with muslin or cheesecloth and set inside a small bowl. Pour in yogurt; let drain for 15 minutes. Discard liquid."
    },
    {
      "position": 2,
      "text": "Mix drained yogurt, ginger-garlic paste, lemon juice, turmeric, chile powder, cumin, garam masala, and salt together in bowl. Add paneer, onion, and green bell pepper and mix well. Marinade for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Skewer marinated paneer, onion, and bell pepper onto metal skewers. Grill until vegetables are soft and cheese is browned, 6 to 8 minutes. Brush with vegetable oil and grill for 1 minute more."
    },
    {
      "position": 5,
      "text": "Mix onion rings with green chutney and serve with skewers."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "f3b977ae-e14b-5ca0-a8ec-5e849a185e00",
  "slug": "shrimp-lemon-pepper-linguini",
  "name": "Shrimp Lemon Pepper Linguini",
  "recipe_type": "main",
  "brief_description": "Linguine is tossed with a lemony wine and shrimp mixture!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add linguine, and cook for 9 to 13 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over medium heat, and saute garlic about 1 minute. Mix in chicken broth, wine, lemon juice, lemon zest, salt, and pepper. Reduce heat, and simmer until liquid is reduced by about 1/2."
    },
    {
      "position": 3,
      "text": "Mix shrimp, butter, parsley, and basil into the saucepan. Cook 2 to 3 minutes, until shrimp is opaque. Stir in the cooked linguine, and continue cooking 2 minutes, until well coated."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

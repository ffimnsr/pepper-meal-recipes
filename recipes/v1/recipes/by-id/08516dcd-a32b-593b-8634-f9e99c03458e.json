  "id": "08516dcd-a32b-593b-8634-f9e99c03458e",
  "slug": "smoked-salsa",
  "name": "Smoked Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Homemade smoked salsa is just a few hours away! Use your smoker grill to transform tomatoes, onions, and peppers into the tastiest condiment ever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a smoker grill to 250 degrees F (120 degrees C). Add wood chips according to the manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, onions, bell peppers, and jalape\u00f1os in an aluminum grill pan."
    },
    {
      "position": 3,
      "text": "Place the pan onto the grate of the preheated smoker grill; smoke for 3 hours."
    },
    {
      "position": 4,
      "text": "Remove vegetables from the smoker and transfer to a blender; blend to desired consistency. Mix in lime juice, garlic powder, salt, and pepper. Add fresh cilantro for decoration."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 30,

  "id": "634cf4f3-89f6-56e0-bd05-817de2415c66",
  "slug": "microwave-lemon-curd",
  "name": "Microwave Lemon Curd",
  "recipe_type": "dessert",
  "brief_description": "This microwave lemon curd recipe is one to try when you want to enjoy this rich, delectable dessert topping but don't have time to stand over the stove.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Whisk sugar and eggs together in a microwave-safe bowl until smooth. Stir in lemon juice, melted butter, and lemon zest."
    },
    {
      "position": 3,
      "text": "Microwave on high in 1-minute intervals, stirring after each interval, until thick enough to coat the back of a metal spoon."
    },
    {
      "position": 4,
      "text": "Pour into small sterile jars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

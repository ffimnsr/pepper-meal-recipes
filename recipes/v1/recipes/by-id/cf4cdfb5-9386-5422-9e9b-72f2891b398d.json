  "id": "cf4cdfb5-9386-5422-9e9b-72f2891b398d",
  "slug": "melt-in-your-mouth-shortbread",
  "name": "Melt-in-Your-Mouth Shortbread",
  "recipe_type": "dessert",
  "brief_description": "This is the best shortbread recipe ever, and it's so easy to make with 4 simple pantry ingredients that combine to make a decadent, buttery treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter in a large bowl with an electric mixer until light and fluffy. Add flour, confectioners' sugar, and cornstarch; beat on low for 1 minute, then high for 3 to 4 minutes. Drop spoonfuls of dough 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are golden, 12 to 15 minutes. Cool on the baking sheets briefly before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "014d0dbf-38c9-5c11-956d-3a9c3b009d64",
  "slug": "zucchini-oven-frittata",
  "name": "Zucchini Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This zucchini frittata is packed with sliced zucchini and delicious veggies topped with melted mozzarella and Parmesan cheese for a pleasing brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine zucchini, bell pepper, garlic, and salt in a large, oven-safe skillet. Add 1 cup water and simmer until zucchini is tender, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Drain vegetables in a colander; discard garlic."
    },
    {
      "position": 4,
      "text": "Heat oil in the same skillet over medium heat. Stir in onion, mushrooms, and butter; add drained vegetables. Cook and stir until onion is transparent, about 5 minutes. Stir in beaten eggs and season with salt and pepper. Reduce the heat to low and cook until eggs are set, about 5 minutes. Remove from the heat and sprinkle mozzarella cheese over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Remove from the oven and turn on the broiler."
    },
    {
      "position": 6,
      "text": "Sprinkle Parmesan cheese over frittata. Place under the preheated broiler until cheese is bubbling and golden brown, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and let stand for 5 minutes before cutting into 5 wedges and serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

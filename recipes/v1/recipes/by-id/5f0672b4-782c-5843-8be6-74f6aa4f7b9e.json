  "id": "5f0672b4-782c-5843-8be6-74f6aa4f7b9e",
  "slug": "pumpkin-bread-iv",
  "name": "Incredibly Moist Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "This easy recipe makes three deliciously moist pumpkin bread loaves spiced with cinnamon, cloves, and nutmeg. Perfect for holiday gift-giving!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Mix pumpkin, oil, sugar, and eggs together in a large bowl."
    },
    {
      "position": 3,
      "text": "Combine flour, baking powder, baking soda, salt, cinnamon, nutmeg, and cloves in a separate bowl; stir into pumpkin mixture until well blended."
    },
    {
      "position": 4,
      "text": "Divide batter evenly between the prepared pans."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until a toothpick inserted into the center of each loaf comes out clean, about 45 minutes to 1 hour."
    },
    {
      "position": 6,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "9762bf99-37df-57b8-9086-1d73aa7ea350",
  "slug": "mango-chutney",
  "name": "Mango Chutney",
  "recipe_type": "side",
  "brief_description": "This mango chutney is made with fresh mangos, raisins, ginger, onion, garlic, and lots of spices like cinnamon and cloves. Get those jars ready!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine white sugar, brown sugar, vinegar, chile peppers, allspice, ground ginger, nutmeg, cinnamon, cloves, and salt in a large saucepan. Bring to a boil; boil for 30 minutes."
    },
    {
      "position": 3,
      "text": "Stir in onions, golden raisins, raisins, fresh ginger, and garlic; boil for another 30 minutes."
    },
    {
      "position": 4,
      "text": "Stir in mangos (and almonds if using); reduce heat to low and simmer for 30 minutes."
    },
    {
      "position": 5,
      "text": "Pack chutney into hot, sterilized jars, filling to within 1/4 inch of the top."
    },
    {
      "position": 6,
      "text": "Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    }
  ],
  "servings": 240,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

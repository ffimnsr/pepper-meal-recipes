  "id": "3846074e-5580-5485-9672-0c70499d2760",
  "slug": "spicy-thai-noodle-salad-with-peanut-dressing-recipe-11749845",
  "name": "Spicy Thai Noodle Salad with Peanut Dressing",
  "recipe_type": "salad",
  "brief_description": "This quick spicy Thai noodle salad with peanut dressing, based on fresh, prepared coleslaw mix, is easy to turn into a full meal with the addition of chicken or shrimp.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Combine peanut butter, chili oil, lime juice, garlic, fish sauce, and crushed red pepper in a bowl; stir until sauce is smooth."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add rice noodles; remove pot from heat and soak noodles for 5 minutes or according to package instructions. Drain."
    },
    {
      "position": 3,
      "text": "Combine dressing, noodles, coleslaw, radishes, and snap peas in a large serving bowl. Toss well, garnish with cilantro, and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

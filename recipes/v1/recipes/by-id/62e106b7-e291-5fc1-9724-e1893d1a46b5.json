  "schema_version": 1,
  "id": "62e106b7-e291-5fc1-9724-e1893d1a46b5",
  "slug": "rhubarb-strawberry-herb-crumble-pie",
  "name": "Rhubarb-Strawberry Herb Crumble Pie",
  "recipe_type": "dessert",
  "brief_description": "A departure from the basic rhubarb pie, this strawberry and rhubarb crumble with fresh rosemary and citrus thyme is topped with a sweet and crunchy brown sugar topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line pie crust with a double layer of aluminum foil and a layer of pie weights or dried beans."
    },
    {
      "position": 2,
      "text": "Mix together flour and brown sugar in a bowl. Add cold butter cubes and cut in with your fingers until mostly combined with flour mixture, allowing some medium-sized chunks of butter to remain. Place crumble mixture in the freezer."
    },
    {
      "position": 3,
      "text": "Bake pie crust in the preheated oven until edge of crust is slightly browned, about 8 minutes. Remove from the oven, carefully remove the foil and weights, and set aside. Leave oven on."
    },
    {
      "position": 4,
      "text": "Combine rhubarb, strawberries, white sugar, cornstarch, lemon juice, thyme, and rosemary in a large bowl; mix until fruit is well coated, and transfer mixture into the pie crust. Remove crumble mixture from the freezer and sprinkle over top."
    },
    {
      "position": 5,
      "text": "Bake until filling is bubbly and crumble mixture has melted and browned, about 25 minutes. Allow to cool slightly before cutting."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

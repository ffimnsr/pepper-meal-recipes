  "id": "c1769a7a-70e0-52e0-8f39-742ebbd917d5",
  "slug": "banana-pancakes-i",
  "name": "Banana Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy banana pancakes are made from scratch and sweetened with mashed bananas. Top with syrup and sliced bananas for a delicious breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine flour, white sugar, baking powder, and salt in a bowl. Mix together egg, milk, vegetable oil, and bananas in a second bowl. Stir flour mixture into banana mixture; batter will be slightly lumpy."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle or frying pan over medium high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each pancake."
    },
    {
      "position": 4,
      "text": "Cook until pancakes are golden brown, 3 to 5 minutes per side. Serve hot."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

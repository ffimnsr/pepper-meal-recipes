  "id": "f6b31acb-46b7-5208-8fe7-0e40e8f53d51",
  "slug": "ground-turkey-and-vegetable-stir-fry-recipe-8708979",
  "name": "Ground Turkey and Vegetable Stir Fry",
  "recipe_type": "main",
  "brief_description": "This ground turkey and vegetable stir fry is colorful, saucy, and tasty. Once you start cooking, it goes very quickly, so be sure to have everything ready to go. It\u2019s especially good over steamed rice or cauliflower rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "To make the stir fry sauce, combine chicken stock, white wine or sherry, rice vinegar, sesame oil, soy sauce, white sugar, and cornstarch in a medium mixing bowl. Use a whisk to stir until the cornstarch is dissolved and there are no lumps. Set aside."
    },
    {
      "position": 2,
      "text": "In a large skillet or wok, over medium high heat, combine turkey with granulated garlic, ground ginger, white pepper, and a pinch of salt, stirring and breaking up turkey until cooked through, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove turkey from pan and keep warm. Wipe the pan clean, and heat cooking oil until very hot."
    },
    {
      "position": 4,
      "text": "Add onions, celery, julienne carrots and red bell pepper pieces and cook, stirring continuously, about 1 minute."
    },
    {
      "position": 5,
      "text": "Add shredded cabbage, snow peas, broccoli florets, and green beans and cook, stirring continuously, about 3 minutes. Add garlic and ginger and cook, stirring, about 1 minute."
    },
    {
      "position": 6,
      "text": "Add cooked turkey back to the pan. Give the stir fry sauce a final whisk, and pour in the pan, stirring continuously, until the sauce thickens and comes to a boil."
    },
    {
      "position": 7,
      "text": "Remove from heat and garnish with sesame seeds and sliced green onions, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

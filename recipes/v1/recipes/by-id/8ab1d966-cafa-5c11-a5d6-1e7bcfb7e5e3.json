  "id": "8ab1d966-cafa-5c11-a5d6-1e7bcfb7e5e3",
  "slug": "creamy-sun-dried-tomato-and-basil-pasta-recipe-8710283",
  "name": "Creamy Sun-Dried Tomato and Basil Pasta",
  "recipe_type": "main",
  "brief_description": "This creamy sun-dried tomato and basil pasta includes chicken, but is equally delicious without it. The fragrant sun-dried tomato sauce comes together while the pasta cooks.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes; drain and keep warm."
    },
    {
      "position": 2,
      "text": "Meanwhile, season chicken with 1/2 teaspoon salt and 1/2 teaspoon pepper."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet. Add chicken to skillet, cook and stir for 3 minutes. Add sun-dried tomatoes and garlic, and cook until fragrant, about 1 more minute. Add cream, mozzarella cheese, Parmesan cheese, and 2 tablespoons basil. Cook on low, stirring constantly, until cheese is melted."
    },
    {
      "position": 4,
      "text": "Stir red pepper flakes and fettuccine into sauce. Season with remaining salt and pepper. Top with remaining basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

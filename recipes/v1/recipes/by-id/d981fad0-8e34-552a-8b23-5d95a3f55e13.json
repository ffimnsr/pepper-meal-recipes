  "id": "d981fad0-8e34-552a-8b23-5d95a3f55e13",
  "slug": "5-ingredient-salmon-teriyaki-bowls-recipe-11871553",
  "name": "5-Ingredient Salmon Teriyaki Bowls",
  "recipe_type": "main",
  "brief_description": "These 5-ingredient salmon teriyaki bowls are a riff on the Trader Joe's favorite. They're light and high protein at the same time, perfect to power you through the day.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (235 degrees C). Line a rimmed baking sheet with foil and lightly grease the pan."
    },
    {
      "position": 2,
      "text": "Season salmon with salt and pepper and spread 1 tablespoon teriyaki sauce over each fillet. Set salmon on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, 10 to 12 minutes, or to your preferred doneness."
    },
    {
      "position": 4,
      "text": "Meanwhile prepare rice and edamame according to package directions; keep warm."
    },
    {
      "position": 5,
      "text": "Divide rice among bowls and top with edamame. Flake 1 piece of salmon on top and add avocado."
    },
    {
      "position": 6,
      "text": "Drizzle 1 to 2 tablespoons of remaining teriyaki sauce over each bowl and drizzle with hot sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

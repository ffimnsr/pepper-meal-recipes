  "id": "e90fa4c9-28b8-56f8-9179-1591c585da58",
  "slug": "japanese-style-triple-seared-steak-recipe-8659468",
  "name": "Japanese-Style Triple-Seared Steak",
  "recipe_type": "main",
  "brief_description": "This Japanese-style triple-seared steak technique is an absolute game-changer that produces an incredibly delicious steak with a beautiful crust. Seared first in salt, then Japanese whiskey, then in soy sauce, over very hot charcoal, it is amazing.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Before starting the triple-searing process, build a very hot hardwood charcoal fire. Oak, mesquite or hickory are great choices. The coals should be glowing red, and radiating extreme heat before the meat hits the grill."
    },
    {
      "position": 2,
      "text": "Rub steak all over with oil. Coat with sea salt until entire surface area is completely covered."
    },
    {
      "position": 3,
      "text": "Pour whiskey into a shallow bowl; set aside."
    },
    {
      "position": 4,
      "text": "Place steak on hottest spot on the grill, and sear both sides, about 2 1/2 minutes per side."
    },
    {
      "position": 5,
      "text": "Transfer steak into bowl of whiskey, and turn constantly for at least 1 minute. Most of the salt will rinse off."
    },
    {
      "position": 6,
      "text": "Place steak back onto the hottest spot on the grill, and sear both sides again, about 2 1/2 minutes per side. You can baste steak with a small amount of whiskey while searing."
    },
    {
      "position": 7,
      "text": "Add soy sauce to another shallow bowl. Add steak to the bowl, and turn constantly for at least 1 minute."
    },
    {
      "position": 8,
      "text": "Return steak to the hottest spot on the grill for the 3rd and final sear. Grill both sides for about 2 1/2 minutes, or until desired doneness is reached. For a rosy-pink inside, remove when an instant-read thermometer inserted near the center reads 118 to 120 F (48 to 50 degrees C)."
    },
    {
      "position": 9,
      "text": "Brush steak with melted butter, and let rest for 3 to 4 minutes. Slice and serve with any accumulated juices from the plate."
    }
  ],

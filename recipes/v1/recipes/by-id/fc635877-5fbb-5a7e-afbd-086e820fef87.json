  "id": "fc635877-5fbb-5a7e-afbd-086e820fef87",
  "slug": "grilled-prosciutto-wrapped-peaches-with-burrata-and-basil",
  "name": "Grilled Prosciutto-Wrapped Peaches with Burrata and Basil",
  "recipe_type": "appetizer",
  "brief_description": "Peach sections wrapped in prosciutto are grilled and served with creamy burrata cheese and fresh basil for a stunning appetizer or sweet-and-savory dessert.",
  "cuisine": "Italian Inspired American Italian Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill at medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Cut peaches in half and remove peach stones. Cut each half in half again."
    },
    {
      "position": 3,
      "text": "Wrap prosciutto around each peach section; secure with small bamboo skewers."
    },
    {
      "position": 4,
      "text": "Grill peaches, turning often, until prosciutto gets a little crisp around the edges and peaches begin to caramelize, about 6 minutes."
    },
    {
      "position": 5,
      "text": "To serve, spoon burrata onto serving plates. Remove peaches from skewers; place several grilled peaches around cheese. Drizzle with olive oil. Top with a sprinkle of sea salt and pepper; garnish with basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

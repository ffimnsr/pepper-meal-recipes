  "id": "b185b87e-29d4-56bb-a8a0-b7b90783e811",
  "slug": "rosemary-mashed-potatoes-recipe-8634938",
  "name": "Rosemary Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Spice up your mashed potatoes by adding rosemary and Parmesan cheese for a perfectly seasoned side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 18 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat milk, butter, and rosemary in a small saucepan over low heat until butter is melted. Set aside."
    },
    {
      "position": 3,
      "text": "Drain potatoes, and return to the pot. Sprinkle Parmesan over the potatoes and start mashing with a potato masher or an electric mixer. Gradually pour in milk mixture while continuing to mash. Season with salt and pepper to taste."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,

  "id": "84c0dfb3-29d4-52db-9b3c-078c6dcd4dea",
  "slug": "worlds-best-scones-from-scotland-to-the-savoy-to-the-us",
  "name": "World's Best Scones! From Scotland to the Savoy to the U.S.",
  "recipe_type": "breakfast",
  "brief_description": "This is the best scone recipe! The addition of sour cream gives these a tender crumb. Serve them with clotted cream, butter, and a selection of jams.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Make the scones: Sift flour, baking powder, sugar, and salt into a large bowl. Cut in butter with a pastry blender or by rubbing between fingers until lumps are the size of peas. Stir in currants."
    },
    {
      "position": 3,
      "text": "Whisk milk and sour cream together in a measuring cup; gently stir into flour mixture until dough is moistened, being careful not to overwork the dough."
    },
    {
      "position": 4,
      "text": "With floured hands, pat dough into 2- to 3-inch diameter balls. Place onto the prepared baking sheet and flatten lightly. Scones should slightly touch each other."
    },
    {
      "position": 5,
      "text": "Make the egg wash: Whisk egg and milk together. Brush the tops of scones with egg wash and let them rest for about 10 minutes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the tops are golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

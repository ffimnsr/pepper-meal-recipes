  "id": "c4bea8c4-2fe3-5f2e-b960-4dc10fe8d862",
  "slug": "fast-and-friendly-meatballs",
  "name": "Fast and Friendly Meatballs",
  "recipe_type": "main",
  "brief_description": "These easy turkey meatballs are simple to prepare with just four ingredients, and they bake up in just 20 minutes for a quick, kid-friendly meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with oil, and place it into the oven while preheating."
    },
    {
      "position": 3,
      "text": "Mix turkey, bread crumbs, and egg together in a bowl with your hands."
    },
    {
      "position": 4,
      "text": "Using an ice cream scoop if possible, form mixture into golf ball-sized meatballs. Place meatballs into the hot dish, about 1 inch apart. Press gently on each meatball to flatten the bottom just slightly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Flip meatballs over and continue baking until somewhat crispy on the outside, about 5 more minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Serve with pasta or sauce, or however you'd like."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

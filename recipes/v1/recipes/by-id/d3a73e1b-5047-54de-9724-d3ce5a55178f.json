  "id": "d3a73e1b-5047-54de-9724-d3ce5a55178f",
  "slug": "fasoulia-breakfast-kidney-bean-dish",
  "name": "Fasoulia (Breakfast Kidney Bean Dish)",
  "recipe_type": "breakfast",
  "brief_description": "Get your day going with a bowl of fasoulia \u2014 flavorsome kidney beans in a spicy tomato, onion, and jalape\u00f1o sauce. Perfect with pita bread.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat; cook onion, stirring occasionally, until translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in jalape\u00f1o pepper; cook and stir until softened, about 5 more minutes."
    },
    {
      "position": 3,
      "text": "Mix in tomato and tomato paste; stir well to combine. Pour in kidney beans with their liquid; stir in cumin and curry powder. Bring to a boil, reduce heat to medium-low, and simmer until beans are hot and sauce has thickened, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

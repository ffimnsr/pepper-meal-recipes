  "id": "5eb59386-0c9e-53bc-828a-2ebe446979b6",
  "slug": "dump-and-bake-meatball-casserole-recipe-11695447",
  "name": "Dump and Bake Meatball Casserole",
  "recipe_type": "main",
  "brief_description": "This super easy dump and bake meatball casserole made with frozen meatballs and prepared marinara sauce comes together in minutes and then just needs to bake in the oven. Perfect family staple on weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pasta, water, marinara sauce, meatballs, peppers, and salt in a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Cover tightly with aluminum foil and bake until pasta is al dente, 30 to 35 minutes."
    },
    {
      "position": 4,
      "text": "Remove the foil and stir in 1 cup mozzarella cheese. Sprinkle with remaining 1 cup of mozzarella cheese and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, until cheese is melted, 10 minutes more."
    },
    {
      "position": 6,
      "text": "Serve garnished with fresh herbs, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

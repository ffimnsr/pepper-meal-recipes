  "id": "e66ce1dc-1398-5794-af78-4472422ac6fd",
  "slug": "perfect-grilled-tofu",
  "name": "Perfect Grilled Tofu",
  "recipe_type": "main",
  "brief_description": "Grilled tofu is easy to make with a savory soy sauce, sherry vinegar, and garlic marinade; cook on a hot grill until smoky, charred, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place tofu onto a plate and place another plate on top. Set a 3- to 5-pound weight on top. Press tofu for 20 to 30 minutes; drain and discard the accumulated liquid."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix vinegar, soy sauce, olive oil, garlic powder, salt, cayenne, marjoram, and black pepper together in a small bowl."
    },
    {
      "position": 4,
      "text": "Cut each piece of tofu crosswise into 6 thick slices; place in a baking dish. Pour marinade over tofu, turning to coat, and chill, covered, turning occasionally, for at least 30 minutes or up to 48 hours. Longer is better, but shorter is totally fine."
    },
    {
      "position": 5,
      "text": "Preheat an outdoor grill or charcoal grill for high heat. Reduce heat to medium and lightly oil the grate."
    },
    {
      "position": 6,
      "text": "Remove tofu slices from marinade and shake off excess; reserve remaining marinade to make the sauce."
    },
    {
      "position": 7,
      "text": "Cook tofu on preheated grill, turning once, until well browned but before grill marks get black, 10 to 15 minutes total. Transfer tofu to a platter and cover with foil to keep warm."
    },
    {
      "position": 8,
      "text": "Bring reserved marinade to a boil in a saucepan; simmer until it reduces to about 1 cup, about 2 minutes. Pour over tofu and serve hot, warm, or at room temperature."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

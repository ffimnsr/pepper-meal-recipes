  "id": "01cbed7a-44bc-5522-83fa-7b20065aa3a6",
  "slug": "mojitos-by-the-pitcher",
  "name": "Mojitos by the Pitcher",
  "recipe_type": "drink",
  "brief_description": "This mojito recipe muddles mint and lime together with rum in one big batch for an easy-to-serve refreshing summer cocktail to enjoy with friends.",
  "cuisine": "Cuban American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Muddle sugar and mint leaves together in a pitcher until leaves are well broken down."
    },
    {
      "position": 3,
      "text": "Add limes and muddle until limes are juiced."
    },
    {
      "position": 4,
      "text": "Pour rum into sugar mixture; add club soda and stir until sugar is dissolved."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

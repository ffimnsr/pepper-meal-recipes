{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "22f85a01-2f25-5fea-84b4-4c43aaf8cf2f",
  "slug": "armenian-style-potato-salad",
  "name": "Armenian-Style Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John's Armenian-style potato salad provides a no-mayo, egg-free version of the classic traditional side dish that's full of flavor thanks to mint and bell pepper.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Transfer sliced potatoes into a large pot with enough cold water to cover the potatoes by a couple of inches. Stir in 1 rounded tablespoon kosher salt and 2 \u00bd teaspoons dried mint. Bring to a boil over high heat. Reduce heat to medium and let cook until tender, about 15 minutes, checking every 5 to 6 minutes for doneness. Drain well."
    },
    {
      "position": 3,
      "text": "Transfer cooked potatoes to a large mixing bowl and let cool slightly."
    },
    {
      "position": 4,
      "text": "While potatoes cool, heat \u00bc cup olive oil in a skillet over medium-high heat. Add red onion, red bell pepper, garlic, and a pinch of salt; cook and stir for just 1 minute. Turn off the heat and stir in remaining dried mint."
    },
    {
      "position": 5,
      "text": "Drizzle freshly squeezed lemon juice into potatoes and toss gently with a spatula. Add green onions, red onion mixture, remaining olive oil, fresh mint, fresh parsley, salt to taste, black pepper, chili flakes, and cayenne. Mix with a spatula until combined."
    },
    {
      "position": 6,
      "text": "Cover with plastic wrap and refrigerate until chilled and flavors have melded, 3 to 4 hours."
    },
    {
      "position": 7,
      "text": "Unwrap; stir, taste, and adjust seasonings as needed to personal tastes. The salad almost always needs more salt stirred in once it's tasted after being chilled. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

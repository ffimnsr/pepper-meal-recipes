  "id": "59643072-c9e5-518a-a851-9e70c2cbc9a1",
  "slug": "sausage-and-pepper-sunrise-burrito",
  "name": "Sausage and Pepper Sunrise Burrito",
  "recipe_type": "breakfast",
  "brief_description": "These sausage and pepper burritos with onions, eggs, and Cheddar are the perfect on-the-go breakfast when you're running late and need to eat!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Cook sausage, bell peppers, and onion in a medium nonstick skillet over medium heat until sausage is cooked through and vegetables are crisp-tender, 4 to 5 minutes. Remove from the skillet."
    },
    {
      "position": 2,
      "text": "Add eggs to the skillet and cook, stirring occasionally, over medium heat until set, about 2 min. Stir in sausage mixture and top with shredded cheese."
    },
    {
      "position": 3,
      "text": "Spoon onto tortillas. Fold in opposite sides of each tortilla, then roll up burrito-style."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

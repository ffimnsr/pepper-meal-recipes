  "id": "28931e26-dcfa-5834-807e-6c68ac3420d6",
  "slug": "quick-chicken-piccata",
  "name": "Quick Chicken Piccata",
  "recipe_type": "main",
  "brief_description": "This easy chicken piccata recipe from Chef John pan-fries chicken in a delicious Italian piccata sauce made with lemon, capers, white wine, and parsley.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts between 2 sheets of heavy plastic on a solid, level surface. Firmly pound chicken breasts with the smooth side of a meat mallet to a 1/2-inch thickness."
    },
    {
      "position": 2,
      "text": "Season both sides of chicken breasts with cayenne, salt, and black pepper; dredge lightly in flour and shake off any excess."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium-high heat. Place chicken in the pan, reduce heat to medium, and cook until browned and cooked through, about 5 minutes per side; transfer to a plate."
    },
    {
      "position": 4,
      "text": "Cook capers in reserved oil, smashing them lightly to release brine, until warmed through, about 30 seconds. Pour white wine into the skillet and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Cook until reduced by half, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Stir lemon juice, water, and butter into the reduced wine mixture; cook and stir continuously to form a thick sauce, about 2 minutes. Reduce heat to low and stir parsley through the sauce."
    },
    {
      "position": 6,
      "text": "Return chicken breasts to the pan and turn to coat in sauce. Cook until heated through, 1 to 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

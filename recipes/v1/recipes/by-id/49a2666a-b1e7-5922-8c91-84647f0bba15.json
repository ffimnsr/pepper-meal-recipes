  "id": "49a2666a-b1e7-5922-8c91-84647f0bba15",
  "slug": "homemade-focaccia-bread",
  "name": "Homemade Focaccia Bread",
  "recipe_type": "appetizer",
  "brief_description": "This dimpled Italian flatbread still has yeast, but only one quick rise time before baking into a heavenly bread sprinkled with crushed rosemary. Eat as is, or use as a crust for innovative pizzas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1 cup flour, sugar, salt, and yeast. Mix well. Heat water and vegetable oil until warm, and add to yeast mixture along with the egg. Blend with an electric mixer at low speed until moistened. Beat for 2 additional minutes. Stir in 1 3/4 cup flour while beating, until dough pulls away from side of bowl."
    },
    {
      "position": 2,
      "text": "Knead in 3/4 cup flour on floured surface. Cover dough with a bowl, and let sit for 5 minutes. Place dough on a greased baking sheet. Roll out to 12 inch circle. Cover with greased plastic wrap and a cloth towel. Place in a warm place for 30 minutes."
    },
    {
      "position": 3,
      "text": "Uncover dough, and poke holes in it with a spoon handle at 1 inch intervals. Drizzle olive oil on dough, and sprinkle with crushed rosemary."
    },
    {
      "position": 4,
      "text": "Bake at 400 degrees F (205 degrees C) for 17 to 27 minutes, until just golden. Remove from baking sheet, and cool on rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

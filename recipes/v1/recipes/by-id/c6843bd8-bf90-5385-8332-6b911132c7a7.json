  "id": "c6843bd8-bf90-5385-8332-6b911132c7a7",
  "slug": "italian-popcorn-with-parmesan",
  "name": "Italian Popcorn with Parmesan",
  "recipe_type": "appetizer",
  "brief_description": "Popcorn tossed with Parmesan cheese, Italian seasoning, and garlic salt is a quick and fun Italian-inspired savory snack perfect for movie night.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine popcorn and 1/4 cup olive oil in a 2-quart saucepan; cover. Cook over high heat, continuously shaking the pan, until popcorn is popped and the lid begins to lift, about 5 minutes. Pour popcorn into a large serving bowl."
    },
    {
      "position": 2,
      "text": "Add 2 tablespoons olive oil, Italian seasoning, and garlic salt to popcorn; toss to coat. Add Parmesan cheese and mix well."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,

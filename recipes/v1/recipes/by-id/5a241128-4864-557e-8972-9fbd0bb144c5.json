  "id": "5a241128-4864-557e-8972-9fbd0bb144c5",
  "slug": "appalachian-apple-stack-cake-recipe-12019233",
  "name": "Appalachian Apple Stack Cake",
  "recipe_type": "dessert",
  "brief_description": "This Appalachian apple stack cake is a comforting, five-layer cake full of warm spice and old-fashioned charm. After the layers are baked, spread with apple butter, and stacked, the cake rests for two days so the flavors can meld before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line the bottoms of three 9-inch cake pans with parchment paper and coat with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk together flour, white sugar, baking powder, baking soda, apple pie spice, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk together buttermilk, molasses, and egg in a small bowl."
    },
    {
      "position": 4,
      "text": "Cut shortening into the flour mixture with a pastry blender until the mixture looks like sand."
    },
    {
      "position": 5,
      "text": "Drizzle buttermilk mixture into the flour mixture. Fold together until the mixture is the consistency of cookie dough. Divide into 5 portions; shape each portion into a ball."
    },
    {
      "position": 6,
      "text": "Press a dough portion into a prepared pan using hands coated with nonstick spray until the dough spreads evenly to reach the sides of the pan. Repeat with 2 more dough portions."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the centers spring back when lightly touched, rotating once halfway through baking, 10 to 12 minutes."
    },
    {
      "position": 8,
      "text": "Immediately turn a layer onto a serving platter. Spread 3/4 cup apple butter over the layer. Repeat with the next 2 layers."
    },
    {
      "position": 9,
      "text": "Clean two cake pans, line with parchment and coat with cooking spray. Spread the remaining 2 dough portions in the pan and bake as directed. Spread one of the remaining layers with the remaining apple butter and top with the remaining cake layer."
    },
    {
      "position": 10,
      "text": "Wrap the warm cake well in plastic wrap. Let stand at room temperature for at least 2 days and up to 7 days before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

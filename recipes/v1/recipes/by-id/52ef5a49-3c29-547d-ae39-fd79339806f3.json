  "id": "52ef5a49-3c29-547d-ae39-fd79339806f3",
  "slug": "turkey-spaghetti-zoodles",
  "name": "Turkey Spaghetti Zoodles",
  "recipe_type": "main",
  "brief_description": "Zucchini noodles, or zoodles, are cooked in a tasty marinara sauce filled with ground turkey breast, green bell pepper, and baby spinach.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add turkey breast, green pepper, garlic, Italian seasoning, ground black pepper, salt, and red pepper flakes; cook and stir until turkey is lightly browned, 4 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir marinara sauce and baby spinach into the turkey mixture; cook and stir until marinara sauce is warm through, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir zucchini noodles into the sauce with tongs; cook and stir until the zucchini is slightly tender, 2 to 3 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 9,
  "preparation_time_minutes": 15,

  "id": "711f55aa-b860-529f-9d87-2660d795a9ee",
  "slug": "crockpot-christmas-corn-dip-recipe-11855159",
  "name": "Crockpot Christmas Corn Dip",
  "recipe_type": "appetizer",
  "brief_description": "This slow cooker Christmas corn dip, with 2 types of corn, and both jalapeno and bell peppers, is spicy, creamy, cheesy, and delicious. Serve with tortilla chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add creamed corn and shoepeg corn to a slow cooker."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium-high heat. Add jalapenos, bell pepper, salt, onion powder, and garlic powder and cook until just beginning to soften, about 3 minutes. Transfer mixture to the slow cooker."
    },
    {
      "position": 3,
      "text": "Stir in Monterey Jack cheese and cream cheese. Cook on Low 1 1/2 to 2 hours, stirring every 20 to 30 minutes. Stir in hot sauce. Keep warm until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "2801139c-ffd8-5cf0-b33d-582af0c9dc6e",
  "slug": "frozen-key-lime-pie",
  "name": "Frozen Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "This frozen key lime pie recipe is simple to make with eggs, sugar, sweetened condensed milk, and a graham cracker crust for an easy, no-bake dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg yolks in a large bowl until very light and fluffy. Add sweetened condensed milk; beat until doubled in volume. Beat in lime juice; refrigerate yolk mixture until ready to use."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a large glass or metal bowl with an electric mixer until foamy; gradually add sugar and cream of tartar, continuing to beat until stiff peaks form."
    },
    {
      "position": 3,
      "text": "Gently fold egg whites into yolk mixture until well blended; pour into crust and freeze. Serve frozen."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "4a6ab1b9-8a2e-53cc-8dbb-4b371de947de",
  "slug": "garlic-kale-quinoa",
  "name": "Garlic Kale Quinoa",
  "recipe_type": "side",
  "brief_description": "This quinoa kale recipe is made with saut\u00e9ed garlic, kale, quinoa, and sesame oil for a quick and easy side dish. Serve alongside any main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2/3 cup water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat. Saut\u00e9 kale and garlic in hot oil until kale is wilted, about 5 minutes. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Stir quinoa into kale mixture and add sesame oil; cook until flavors blend, about 5 more minutes. Add 1 tablespoon water to mixture to prevent sticking."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

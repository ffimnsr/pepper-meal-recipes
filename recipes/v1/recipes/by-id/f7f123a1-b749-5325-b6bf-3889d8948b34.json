  "id": "f7f123a1-b749-5325-b6bf-3889d8948b34",
  "slug": "fettuccine-with-sweet-pepper-cayenne-sauce",
  "name": "Fettuccine with Sweet Pepper-Cayenne Sauce",
  "recipe_type": "soup",
  "brief_description": "In this fettuccine dish, red bell peppers, garlic, and cayenne are saut\u00e9ed then simmered with sour cream and chicken broth to make a delicious dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, spray cooking oil in a large skillet and saut\u00e9 red bell peppers, garlic, and cayenne pepper over medium heat for 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in sour cream and broth; simmer uncovered for 5 minutes. Remove from heat and stir in cheese."
    },
    {
      "position": 4,
      "text": "Toss hot pasta with sauce and season with salt and pepper to taste; serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

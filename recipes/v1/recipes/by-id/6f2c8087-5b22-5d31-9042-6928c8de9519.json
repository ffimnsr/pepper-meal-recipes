  "id": "6f2c8087-5b22-5d31-9042-6928c8de9519",
  "slug": "paleo-applesauce-pancakes",
  "name": "Paleo Applesauce Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These paleo pancakes made with tapioca flour, applesauce, and cinnamon are a quick and easy gluten-free breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk eggs lightly in a large bowl. Add applesauce and vanilla extract; mix well to combine."
    },
    {
      "position": 3,
      "text": "Combine almond flour, tapioca flour, cinnamon, baking soda, and salt in a separate bowl."
    },
    {
      "position": 4,
      "text": "Add to egg mixture and mix until just combined. Add water until pancake batter is desired thickness. Set batter aside to rest for 15 minutes."
    },
    {
      "position": 5,
      "text": "Melt coconut oil on a griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form in the center and the edges are dry, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Flip and cook until golden on the other side, 2 to 3 minutes. Repeat with remaining batter."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "2e3f331b-6552-5667-98fa-9bcf34617c49",
  "slug": "lasagna-alfredo-roll-ups",
  "name": "Lasagna Alfredo Roll Ups",
  "recipe_type": "main",
  "brief_description": "Impress dinner guests with these picture-perfect portions of lasagna. Roll up cooked noodles with a spinach/ricotta filling and bake with a blanket of creamy rich Alfredo sauce.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna and cook for 8 to 10 minutes or until al dente. Rinse in cold water and drain well."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a large sauce pan over medium heat add oil and cook broccoli or spinach and green onions until tender, stirring frequently. Remove pan from heat and stir in ricotta cheese, Parmesan cheese, salt and egg."
    },
    {
      "position": 3,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Place noodles in a single layer on a sheet of waxed paper. Evenly spread some of the cheese mixture on each noodle. Roll up each noodle from the short end, jelly-roll style."
    },
    {
      "position": 5,
      "text": "In a 8x12 inch baking dish, spoon about 3/4 of the Alfredo sauce on the bottom and spread evenly. Arrange the rolled noodles, seam side down, in the dish. Top with mozzarella cheese and remaining sauce. Cover loosely with foil and bake in preheated oven for 30 minutes or until hot and bubbly and the cheese is melted. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "d25ff733-3c17-5af6-aea9-3701dce475ca",
  "slug": "crawfish-stuffed-jalapenos",
  "name": "Crawfish-Stuffed Jalapenos",
  "recipe_type": "appetizer",
  "brief_description": "Stuffed with four kinds of cheese, crawfish, bacon, and sausage, then dipped in beer batter and fried golden brown, these jalapenos will be a favorite at your next gathering!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside. Stir the breakfast sausage into the skillet, and cook until crumbly and no longer pink. Meanwhile, place the Monterey Jack, Cheddar, Muenster, and cream cheeses in a large saucepan over medium-low heat. Once melted, stir in the crumbled bacon, breakfast sausage, and chopped crawfish tails. Set aside."
    },
    {
      "position": 2,
      "text": "Remove the stems from the jalapenos, and cut a slit lengthwise down one side. Wear gloves while handling the jalapenos (trust me, I learned the hard way). Remove the seeds through the slit. Hold the seeded jalapenos lengthwise between your thumb and forefinger, and stuff with the meat and cheese mixture (you remembered the gloves, right?). Place the stuffed jalapenos onto a dish, and freeze overnight or until solid."
    },
    {
      "position": 3,
      "text": "Heat oil in deep-fryer to 375 degrees F (190 degrees C). Whisk together the flour, paprika, white pepper, and garlic salt in a bowl until combined, then quickly whisk in the beer until a batter has formed."
    },
    {
      "position": 4,
      "text": "Use a skewer to stab a frozen jalapeno, then dip it into the batter until coated. Place the jalapeno in the hot oil, and hold for a few seconds just below the surface, before twisting out the skewer. This will help keep the jalapeno from sticking to the bottom of the pan. Cook until golden brown all over, then remove and drain on a paper towel lined plate. Repeat with remaining jalapenos."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "dbcac7cf-1a79-5794-8d8f-003535ed663b",
  "slug": "snickerdoodle-bars",
  "name": "Snickerdoodle Bars",
  "recipe_type": "dessert",
  "brief_description": "Think snickerdoodles but in bar shape. Just as delicious as its cookie twin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Cream together butter, 1/2 cup white sugar, and brown sugar in a bowl with an electric mixer until light and fluffy. Mix in egg and vanilla until thoroughly combined. Add in flour, cream of tartar, baking soda, salt, 1/4 teaspoon cinnamon, and nutmeg, and mix until a dough just begins to form."
    },
    {
      "position": 3,
      "text": "Place dough into prepared pan. Using lightly floured hands, press dough firmly and evenly into the bottom of the pan."
    },
    {
      "position": 4,
      "text": "In a small bowl, mix together 1 tablespoon white sugar and 1/2 teaspoon cinnamon. Sprinkle evenly over the dough."
    },
    {
      "position": 5,
      "text": "Place pan into the preheated oven, and bake just until the dough in the center of the pan feels barely set, 20 to 23 minutes. Do not over bake."
    },
    {
      "position": 6,
      "text": "Allow cookies to cool in pan for 10 minutes before removing to a wire rack to cool completely. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "c6aa12c5-6332-5672-b44e-b190d153870d",
  "slug": "chicken-piccata-with-capers",
  "name": "Chicken Piccata with Capers",
  "recipe_type": "drink",
  "brief_description": "This chicken piccata is a popular Italian dish with a buttery sauce of capers, garlic, lemon juice, and white wine that's delicious served over pasta.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place each chicken breast between 2 sheets of heavy-duty plastic wrap. Pound breasts to 1/2-inch thickness using a meat mallet or small heavy skillet."
    },
    {
      "position": 2,
      "text": "Spread flour into a wide, shallow dish. Press chicken into flour to coat completely."
    },
    {
      "position": 3,
      "text": "Melt butter with olive oil in a large skillet over medium-high heat; cook chicken in hot butter mixture until no longer pink in the center and the juices run clear, 3 to 5 minutes per side. Remove chicken to a serving platter and cover with a lid to keep warm."
    },
    {
      "position": 4,
      "text": "Pour white wine, lemon juice, capers, and garlic into the skillet. Bring to a boil while scraping the browned bits of food from the bottom of the skillet with a wooden spoon; cook at a boil until slightly thickened, about 2 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Drizzle sauce over and around chicken; garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "02aa3711-1a7f-56ad-8e34-92c746d56f48",
  "slug": "slow-cooker-marry-me-chicken-sandwiches-recipe-11758491",
  "name": "Slow Cooker Marry Me Chicken Sandwiches",
  "recipe_type": "main",
  "brief_description": "These delicious slow cooker marry me chicken sandwiches feature slow cooked shredded chicken in a creamy, cheesy, sun-dried tomato sauce on toasted brioche buns with crispy bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, chicken broth, garlic, oregano, thyme, sun-dried tomatoes, red pepper, salt, and black pepper in a 6- to 8-quart slow cooker. Cook on Low for 4 hours or on High for 2 hours."
    },
    {
      "position": 2,
      "text": "Use 2 forks or a hand mixer to carefully shred the chicken. Return chicken to the slow cooker; stir in cream cheese, mozzarella, Parmesan cheese, and basil until cheese is melted; keep warm."
    },
    {
      "position": 3,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 4,
      "text": "Serve chicken on toasted brioche buns and top with bacon. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 130,

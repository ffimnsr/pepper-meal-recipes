  "id": "73c80899-1812-53bf-a984-0f9077aa1be2",
  "slug": "louisiana-sweet-potato-pancakes",
  "name": "Louisiana Sweet Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pancake recipe combines mashed sweet potatoes and nutmeg with regular pancake batter for a delicious twist on classic pancakes.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a medium saucepan of lightly salted water to a boil. Add sweet potatoes and cook until tender but still a bit firm, about 15 minutes. Drain, then immediately immerse in cold water to loosen skins. Drain again; remove and discard skins."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, salt, and nutmeg together into a medium bowl."
    },
    {
      "position": 3,
      "text": "Chop sweet potatoes, transfer to another medium bowl, and mash. Mix in milk, melted butter, and egg. Gradually mix in flour mixture until well combined."
    },
    {
      "position": 4,
      "text": "Lightly grease a griddle and preheat over medium heat."
    },
    {
      "position": 5,
      "text": "Working in batches, drop heaping tablespoonfuls batter onto the hot griddle and cook until the surface begins to bubble, 3 to 4 minutes. Flip and cook on the other side until golden brown, 2 to 3 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

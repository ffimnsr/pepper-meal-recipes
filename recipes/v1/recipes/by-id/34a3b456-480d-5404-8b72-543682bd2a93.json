  "id": "34a3b456-480d-5404-8b72-543682bd2a93",
  "slug": "banana-loaf",
  "name": "Banana Loaf",
  "recipe_type": "breakfast",
  "brief_description": "This banana loaf recipe is made with lots of ripe, mashed bananas and walnuts for a flavorful bread, perfect for breakfast or an afternoon snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Cream sugar and butter in a large bowl with an electric mixer on medium speed until light and fluffy. Add eggs, one at a time, beating well after each addition. Mix in mashed bananas. Sift together flour, baking soda, baking powder, and salt in a separate bowl; beat into banana mixture just until combined. Fold in nuts. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

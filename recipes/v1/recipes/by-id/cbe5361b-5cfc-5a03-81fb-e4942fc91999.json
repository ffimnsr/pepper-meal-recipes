  "id": "cbe5361b-5cfc-5a03-81fb-e4942fc91999",
  "slug": "easy-slow-cooker-chicken-and-dumpling-soup",
  "name": "Easy Slow Cooker Chicken and Dumpling Soup",
  "recipe_type": "soup",
  "brief_description": "Made in the slow cooker with condensed soup, frozen vegetables, and biscuit dough, this creamy chicken and dumpling soup is simple to make and a comforting meal for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place diced onion in a slow cooker. Top with chicken."
    },
    {
      "position": 2,
      "text": "Mix both condensed soups, poultry seasoning, and pepper together in a bowl; pour over the chicken in the slow cooker. Pour in chicken broth and cook until chicken is falling apart, on Low for 10 hours, or on High for 5 hours."
    },
    {
      "position": 3,
      "text": "Pour in peas and carrots and cook on Low until soft, 1 to 2 hours more."
    },
    {
      "position": 4,
      "text": "Roll out the biscuit dough thin and flat. Cut into quarters or strips, then cut in half. Add dough pieces to the slow cooker and stir to make sure they are submerged in the liquid. Cook for another 1 to 2 hours on Low."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 420,

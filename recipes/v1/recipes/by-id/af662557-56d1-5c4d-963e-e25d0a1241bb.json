  "id": "af662557-56d1-5c4d-963e-e25d0a1241bb",
  "slug": "baked-salmon-feta-pasta-recipe-11947464",
  "name": "Baked Salmon Feta Pasta",
  "recipe_type": "main",
  "brief_description": "This baked salmon feta pasta is rich and creamy, and simple to make. A salmon filet, a block of feta, and an assortment of delicious vegetables bake on a sheet pan, and then are stirred together with penne pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Season salmon with Italian seasoning."
    },
    {
      "position": 2,
      "text": "Add salmon, feta block, bell peppers, carrots, mushrooms, cherry tomatoes, and spinach to a sheet pan or other oven-safe pan. Drizzle with olive oil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of salted water to a boil and cook penne until tender with a bite, about 11 minutes. Drain and set aside."
    },
    {
      "position": 5,
      "text": "Remove salmon and vegetables from the oven. While everything is still hot, use a fork to blend feta with salmon and vegetables, being careful to keep salmon in at least bite-sized chunks. Use caution smashing tomatoes; juice may splatter."
    },
    {
      "position": 6,
      "text": "Add pasta and combine well. Garnish with sun-dried tomatoes and Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

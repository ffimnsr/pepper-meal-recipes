  "id": "6648cb9d-9db5-5624-b6a1-2d51cc27d8a5",
  "slug": "hot-honey-ham-and-cheese-butterswim-biscuits-recipe-11971642",
  "name": "Hot Honey Ham and Cheese Butter Swim Biscuits",
  "recipe_type": "dessert",
  "brief_description": "These hot honey ham and cheese butter swim biscuits are made with homemade dough studded with ham and sharp Cheddar cheese. Baked in a pool of melted butter and finished with a drizzle of hot honey, they deliver a perfect sweet-savory bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butter in a glass or ceramic 8-inch square baking dish. Microwave for 1 minute. Stir butter; continue to cook in 20 second intervals until fully melted."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, sugar, salt, and cayenne together in a large bowl. Add ham and cheese and stir until coated in the flour mixture. Make a well in the center and pour in buttermilk. Mix until just combined."
    },
    {
      "position": 4,
      "text": "Pour dough into the prepared dish with the melted butter (dough will be thick) and gently spread the dough to the edges."
    },
    {
      "position": 5,
      "text": "Use a paring knife to cut the dough into 9 or 12 squares."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned on the top and around the edges, 22 to 24 minutes."
    },
    {
      "position": 7,
      "text": "Let cool 5 minutes and drizzle the top with hot honey before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

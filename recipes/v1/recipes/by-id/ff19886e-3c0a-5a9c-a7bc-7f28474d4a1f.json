  "id": "ff19886e-3c0a-5a9c-a7bc-7f28474d4a1f",
  "slug": "lemon-pepper-pasta-seafood",
  "name": "Lemon Pepper Pasta Seafood",
  "recipe_type": "main",
  "brief_description": "Lemon pepper pasta served with sauteed garlic seafood. You can substitute the shrimp in this recipe with crab or scallops, or you could use a mixture of all three types of seafood.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to boil, add pasta, and cook for 8 to 10 minutes, or until al dente. Drain, and return pasta to the pot."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat. Cook garlic, lemon pepper seasoning, and shrimp in oil until shrimp is cooked through, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Toss pasta with shrimp and Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

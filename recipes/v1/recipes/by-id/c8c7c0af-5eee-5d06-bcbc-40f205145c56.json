  "id": "c8c7c0af-5eee-5d06-bcbc-40f205145c56",
  "slug": "maple-shortbread-cookies",
  "name": "Maple Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These maple shortbread cookies are made with butter, maple syrup, flour, and salt in this delicious 4-ingredient recipe that bakes in just 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and maple syrup together with an electric mixer in a large bowl until smooth. Stir flour and salt together in a separate bowl; gradually mix flour mixture into butter mixture until dough is just incorporated. Form dough into walnut-sized balls; flatten gently and arrange onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are lightly browned, 10 to 12 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

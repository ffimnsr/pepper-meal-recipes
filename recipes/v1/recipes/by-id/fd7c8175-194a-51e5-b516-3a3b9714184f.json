  "id": "fd7c8175-194a-51e5-b516-3a3b9714184f",
  "slug": "no-tomato-chili",
  "name": "No-Tomato Chili",
  "recipe_type": "soup",
  "brief_description": "This chili without tomatoes has a great kick to it and is perfect for those who don't like chunky tomatoes in their soup. An easy recipe to share.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef into a soup pot over medium-high heat. Cook and stir until browned. Drain off grease and season with salt to taste."
    },
    {
      "position": 2,
      "text": "Add onion, bell pepper, and garlic; cook and stir for about 3 minutes. Reduce heat to medium and season with Worcestershire sauce, chili powder, cumin, and oregano. Cook and stir for another 5 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low and stir in chili sauce, kidney beans, cannellini beans, and beef broth. Cover and simmer for about 35 minutes."
    },
    {
      "position": 4,
      "text": "Ladle into bowls to serve and top with shredded cheese and jalape\u00f1o."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1d7a53b1-2c1f-5dff-8b80-b8763c62d3d3",
  "slug": "potato-broccoli-and-cheese-soup",
  "name": "Potato, Broccoli and Cheese Soup",
  "recipe_type": "soup",
  "brief_description": "A cheesy, potato broccoli soup that tastes great.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large stock pot saute onion in butter. Add potatoes, water and bouillon cubes. Cover, bring to boil and then reduce heat to medium and cook until potatoes are tender, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Remove tough outer skin of broccoli stems and cook broccoli. Once cooked add to soup."
    },
    {
      "position": 3,
      "text": "In a blender or food processor puree half of the soup and return to stock pot. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Add cheese and heat soup through until cheese is melted. Serve warm."
    }
  ],
  "servings": 6,

  "id": "0291a815-790c-5b59-aa2d-a1ad02debbdf",
  "slug": "layered-chicken-and-black-bean-enchilada-casserole",
  "name": "Layered Chicken and Black Bean Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This tasty and easy layered chicken and black bean enchilada casserole recipe features sauce, tortillas, and a seasoned chicken and black bean mixture.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium heat; coat with cooking spray. Add chicken, cumin, and coriander; cook until chicken is cooked through. Transfer to a bowl; stir in black beans, chile peppers, and cilantro."
    },
    {
      "position": 3,
      "text": "Spread ½ enchilada sauce into an 11x7-inch baking dish. Place 4 tortillas over sauce, overlapping if necessary. Spoon ½ chicken mixture over tortillas; sprinkle with ½ cheese and ½ sour cream. Spoon remaining ½ enchilada sauce over top; place 4 tortillas over sauce, overlapping if necessary. Layer remaining ½ chicken mixture over tortillas. Cover dish with a lid or aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes. Uncover; sprinkle remaining ½ cheese over top and dot with remaining ½ sour cream. Continue baking, uncovered, until cheese melts, 5 to 10 minutes more. Let stand 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

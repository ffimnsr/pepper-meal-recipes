  "id": "61ae534b-e81a-527d-93de-b13c10dcf029",
  "slug": "copycat-chicken-crispers-with-honey-chipotle-dipping-sauce-recipe-8784197",
  "name": "Copycat Chicken Crispers with Honey Chipotle Dipping Sauce",
  "recipe_type": "appetizer",
  "brief_description": "These copycat chicken crispers with honey chipotle dipping sauce are delicious fried chicken tenders, served with a hot honey dip. You'll love them for dinner or as a crowd-pleasing appetizer.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Cut chicken breasts into strips about 3 inches long."
    },
    {
      "position": 2,
      "text": "Stir buttermilk and hot sauce together in a medium bowl. Add chicken to buttermilk mixture and toss well to completely cover the chicken. Let stand 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, pour vegetable oil into a large saucepan or very deep skillet to about 4 inches deep. Heat oil to 350 degrees F (180 degrees C)."
    },
    {
      "position": 4,
      "text": "In a large shallow dish, whisk together flour, kosher salt, pepper, paprika, garlic powder, onion powder, and baking powder until well combined."
    },
    {
      "position": 5,
      "text": "Remove each tender from buttermilk mixture and coat lightly with flour mixture, shaking off any excess. Return chicken to buttermilk mixture and finish with a second coat of flour mixture. Set aside on a plate. Repeat with remaining chicken pieces."
    },
    {
      "position": 6,
      "text": "Working in batches, carefully add chicken tenders to hot oil and cook, flipping occasionally, until crispy golden brown and cooked through, about 5 minutes. Drain on paper towels or a wire rack set over a rimmed baking sheet."
    },
    {
      "position": 7,
      "text": "For sauce, whisk barbecue sauce, chipotle pepper, adobo sauce, and honey together in a small bowl. Season to taste with salt. Serve chicken with sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

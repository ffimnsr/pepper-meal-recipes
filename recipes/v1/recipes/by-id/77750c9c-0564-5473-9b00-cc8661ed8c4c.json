  "slug": "copycat-orange-julius-recipe-8724358",
  "name": "Copycat Orange Julius",
  "recipe_type": "breakfast",
  "brief_description": "This copycat Orange Julius, a blended orange and cream drink, is just as frothy, creamy, and fresh-tasting as the original.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place orange concentrate, milk, heavy cream, water, confectioner\u2019s sugar, and vanilla in a blender cup. Blend until well combined. Add ice and blend until frothy. Serve immediately."
    }
  ],

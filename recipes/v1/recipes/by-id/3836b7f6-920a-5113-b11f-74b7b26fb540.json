  "id": "3836b7f6-920a-5113-b11f-74b7b26fb540",
  "slug": "gingerbread-biscotti",
  "name": "Gingerbread Biscotti",
  "recipe_type": "dessert",
  "brief_description": "This spicy Italian gingerbread biscotti cookie recipe is made with ground ginger, ground cinnamon, ground cloves, and ground nutmeg \u2014 perfect with coffee.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a cookie sheet."
    },
    {
      "position": 2,
      "text": "Combine sugar, eggs, oil, and molasses in a large bowl. Combine all-purpose flour, whole wheat flour, ground ginger, baking powder, ground cinnamon, ground cloves, and ground nutmeg in a separate bowl; stir into sugar mixture until a stiff dough forms."
    },
    {
      "position": 3,
      "text": "Divide dough in half; shape each into a roll the length of the cookie sheet. Place rolls on the prepared cookie sheet; pat down to flatten dough until \u00bd-inch thick."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 minutes. Set aside to cool."
    },
    {
      "position": 5,
      "text": "When cool enough to touch, cut into \u00bd-inch thick diagonal slices."
    },
    {
      "position": 6,
      "text": "Place sliced biscotti on the cookie sheet; bake until toasted and crispy, 5 to 7 minutes on each side."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

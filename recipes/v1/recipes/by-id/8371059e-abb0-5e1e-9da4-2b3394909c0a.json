  "id": "8371059e-abb0-5e1e-9da4-2b3394909c0a",
  "slug": "grilled-salmon-tacos-recipe-11868816",
  "name": "Grilled Salmon Tacos",
  "recipe_type": "main",
  "brief_description": "These grilled salmon tacos are made with quick-marinated salmon, grilled to perfection, and tucked into warm tortillas with crisp coleslaw, cucumbers, and radishes for a fresh, savory bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix light brown sugar, white pepper, cilantro, soy sauce, oyster sauce, and garlic together in a bowl. Add salmon and marinate for 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Beginning and ending with salmon, thread salmon, green pepper, red pepper, and red onions onto 4 skewers."
    },
    {
      "position": 4,
      "text": "Cook salmon skewers on the hot grill until fish is opaque in color, turning every 5 minutes, about 15 minutes total."
    },
    {
      "position": 5,
      "text": "To each tortilla add coleslaw, cucumbers, and radishes and top with salmon. Garnish with sliced green onions."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

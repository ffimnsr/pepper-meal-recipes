  "id": "62d3946c-366d-53e8-a80a-adb6b13fbae1",
  "slug": "million-dollar-stuffed-zucchini-recipe-12004421",
  "name": "Million Dollar Stuffed Zucchini",
  "recipe_type": "main",
  "brief_description": "In this million dollar stuffed zucchini recipe, zucchini halves are stuffed with a seasoned mixture of bacon, Cheddar cheese, and toasted almonds with a buttery Ritz cracker topping. Baked until golden and bubbly, these zucchini boats are comfort food that\u2019s impressive enough for guests yet easy enough for a weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 10x15-inch rimmed baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Cut zucchini in half lengthwise. Scoop out pulp with a melon baller or small measuring spoon, leaving 1/4-inch thick shells. Chop pulp (you should have about 3 cups)."
    },
    {
      "position": 3,
      "text": "Toast almonds in a large dry skillet over medium heat until lightly browned and fragrant, about 4 minutes; remove from skillet."
    },
    {
      "position": 4,
      "text": "Cook bacon in a skillet over medium heat until crisp, about 8 minutes. Drain on paper towels."
    },
    {
      "position": 5,
      "text": "Drain all but 1 tablespoon of bacon grease from the skillet. Add zucchini pulp and green onions to the skillet. Cook and stir until tender and any liquid evaporates, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Beat cream cheese with an electric mixer in a large bowl until smooth. Beat in mayonnaise."
    },
    {
      "position": 7,
      "text": "Stir in almonds, bacon, zucchini pulp mixture, Cheddar cheese, and cayenne pepper."
    },
    {
      "position": 8,
      "text": "Stuff zucchini shells with the mixture, heaping full. Arrange shells in prepared baking sheet. Sprinkle with cracker crumbs."
    },
    {
      "position": 9,
      "text": "Bake until zucchini is tender and filling is browned and bubbly, 30 to 35 minutes. Garnish with additional green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

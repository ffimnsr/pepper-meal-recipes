  "id": "5278f033-3935-5bfe-a01e-9713b65c1da7",
  "slug": "bacon-wrapped-cheese-crackers-recipe-11873212",
  "name": "Bacon Wrapped Cheese Crackers",
  "recipe_type": "appetizer",
  "brief_description": "The caramelized bacon around these wrapped cheese crackers is genius. A little assembly (tiny cracker sandwiches!), a slow bake in the oven, and you are serving the best party appetizer imaginable",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Place half the crackers on a parchment or foil lined rimmed baking sheet."
    },
    {
      "position": 2,
      "text": "Top each cracker with a slice of cheese and a slice of jalapeno. Place another cracker on top of each one."
    },
    {
      "position": 3,
      "text": "Wrap each cracker sandwich with a piece of bacon and place, seam side down on the baking sheet. Top each evenly with brown sugar, lightly pressing it into the bacon."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned and caramelized, 1 hour to 1 hour 20 minutes. Let cool slightly before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

  "id": "da5d7208-1378-52b2-aede-f018d8895c05",
  "slug": "ono-butter-mochi",
  "name": "Hawaiian Butter Mochi",
  "recipe_type": "dessert",
  "brief_description": "This butter mochi recipe makes a rich and chewy Hawaiian treat with sweet glutinous rice flour, coconut, and butter\u2014perfect for parties.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk eggs, vanilla, and milk together in a medium bowl. Stir rice flour, sugar, and baking powder together in a separate larger bowl."
    },
    {
      "position": 3,
      "text": "Stir egg mixture into flour mixture until blend. Mix in melted butter and coconut. Pour into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 1 hour. Cool completely in the pan on a wire rack until mochi has set. The texture will improve as it cools. Use a sharp, greased knife to cut into squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

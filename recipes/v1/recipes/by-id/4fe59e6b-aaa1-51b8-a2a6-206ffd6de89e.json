  "id": "4fe59e6b-aaa1-51b8-a2a6-206ffd6de89e",
  "slug": "maple-sriracha-roasted-cauliflower-recipe-11999543",
  "name": "Maple Sriracha Roasted Cauliflower",
  "recipe_type": "dessert",
  "brief_description": "This maple sriracha roasted cauliflower recipe transforms mild, neutral-tasting cauliflower into a sweet-and-spicy side dish that's hard to stop eating. The combination of maple syrup and sriracha creates the perfect balance of caramelized sweetness and bold heat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, maple syrup, sriracha, and soy sauce together in a large bowl until thoroughly combined. Add florets and toss until well coated in the sauce."
    },
    {
      "position": 3,
      "text": "Transfer cauliflower florets to the baking sheet in a single layer; set bowl with any remaining sauce aside."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven until just fork tender, stirring once halfway through, 25 to 35 minutes."
    },
    {
      "position": 5,
      "text": "Add roasted cauliflower back to the reserved maple-sriracha sauce in the bowl, toss well, and serve with optional lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

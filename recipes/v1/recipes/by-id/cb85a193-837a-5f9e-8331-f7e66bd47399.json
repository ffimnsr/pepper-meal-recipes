  "id": "cb85a193-837a-5f9e-8331-f7e66bd47399",
  "slug": "instant-pot-pear-applesauce",
  "name": "Instant Pot\u00ae Pear-Applesauce",
  "recipe_type": "appetizer",
  "brief_description": "An Instant Pot\u00ae delivers fruity pear-applesauce in just minutes, for a quick and easy sweet snack with no added sugar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large bowl halfway with water. Add lemon juice and mix. Peel, core, and slice apples and pears, putting them in the lemon water to prevent browning."
    },
    {
      "position": 2,
      "text": "Drain fruit; do not rinse. Place drained fruit, 1/4 cup water, and cinnamon stick in a multi-functional electric pressure cooker (such as Instant Pot\u00ae). Set the Manual mode to high pressure according to manufacturer's instructions; set timer for 3 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, up to 15 minutes. Unlock lid. Remove and discard cinnamon stick. Pass the cooked fruit through a food mill; sauce will be slightly coarse. Blend fruit with an immersion blender for a smoother sauce."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 13,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "081469d3-65fb-51db-af48-886d837959ae",
  "slug": "peach-amaretto-upside-down-cake",
  "name": "Peach Amaretto Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This lovely peach upside-down cake recipe features fresh sliced peaches baked in a brown sugar and amaretto mixture atop a moist and tender almond cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour and baking powder together in a small bowl until well combined; set aside."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, \u00bc cup melted butter, and amaretto liqueur in a 9-inch pie plate until sugar has dissolved. Arrange peach slices in the pie plate; sprinkle with pecans. Set aside."
    },
    {
      "position": 4,
      "text": "Beat white sugar and \u00bc cup butter together in a large bowl with an electric mixer until light and fluffy. Beat first egg into butter mixture. Beat second egg into mixture along with almond extract. Add flour mixture, alternating with milk, mixing until just incorporated. Gently pour batter over peaches and pecans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean and cake is golden brown, about 25 minutes. Cool in the pie plate for 10 minutes, then run a knife along the edges and invert onto a serving plate to cool."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

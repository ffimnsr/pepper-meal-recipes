  "id": "30ae137b-c09a-5d29-af91-ac237bb6011d",
  "slug": "pork-enchiladas",
  "name": "Pork Enchiladas",
  "recipe_type": "main",
  "brief_description": "Leftover cooked pork gets a Mexican-style makeover when mixed with chilies and enchilada sauce, wrapped in tortillas, and topped with melted cheese.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cooked pork, enchilada sauce, onion powder, 1/2 cup sour cream, green chilies, and one cup of the shredded cheese in a large bowl. In a separate bowl, stir together tomato soup, remaining 1/2 cup sour cream, garlic powder, and cumin."
    },
    {
      "position": 3,
      "text": "Pour a thin layer of the tomato soup mixture into a 9x13 baking dish. Spread pork mixture down the center of each tortilla. Roll tortillas to enclose filling; place seam side down in the baking dish. Pour the remaining soup mixture over the filled tortillas. Top with the remaining 1 cup cheese."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until hot and bubbly, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

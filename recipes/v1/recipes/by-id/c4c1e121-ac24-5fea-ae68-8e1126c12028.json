  "id": "c4c1e121-ac24-5fea-ae68-8e1126c12028",
  "slug": "carolina-red-slaw-recipe-7550726",
  "name": "Carolina Red Slaw",
  "recipe_type": "salad",
  "brief_description": "Sweet, tangy, and spicy Carolina red slaw will be your new favorite barbecue side dish, and we share a few tips that will make every coleslaw better.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add finely chopped cabbage to a large bowl and sprinkle over the salt. Mix well and let sit for 30 minutes. If using fine salt, use half the amount."
    },
    {
      "position": 2,
      "text": "Transfer cabbage to a strainer, and set aside to drain for 10 minutes."
    },
    {
      "position": 3,
      "text": "Add ketchup, red bell pepper, cider vinegar, sugar, smoked paprika, black pepper, cayenne pepper, sambal chili sauce, and sriracha to a bowl; stir until dressing is well combined."
    },
    {
      "position": 4,
      "text": "Use a spatula or your hand to press down on cabbage in the strainer; this will press out excess water. Discard the liquid (it is fine if cabbage is still slightly damp). Add cabbage to the bowl of dressing; mix well."
    },
    {
      "position": 5,
      "text": "Cover slaw and refrigerate for 6 to 24 hours (preferably at least overnight), tossing occasionally. Taste before serving, and adjust salt and pepper, or add more hot sauce if needed. Sprinkle with sliced green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

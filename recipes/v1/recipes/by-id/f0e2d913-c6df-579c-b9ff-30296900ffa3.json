  "id": "f0e2d913-c6df-579c-b9ff-30296900ffa3",
  "slug": "grilled-rock-lobster-tails",
  "name": "Grilled Lobster Tails",
  "recipe_type": "main",
  "brief_description": "Grilled lobster tails seasoned with a flavorful lemon and garlic marinade cook on the grill in just 10 minutes until tender, juicy, and delicious.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Pour lemon juice into a small bowl; slowly whisk in olive oil. Whisk in salt, paprika, white pepper, and garlic powder until combined."
    },
    {
      "position": 4,
      "text": "Split lobster tails lengthwise with a large knife, then brush flesh with some marinade."
    },
    {
      "position": 5,
      "text": "Place lobster tails flesh-side down on the preheated grill and cook, turning once and basting frequently with marinade, until opaque and firm to the touch, about 5 minutes per side. Discard any remaining marinade."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

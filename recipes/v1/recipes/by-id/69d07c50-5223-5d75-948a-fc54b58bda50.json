  "id": "69d07c50-5223-5d75-948a-fc54b58bda50",
  "slug": "authentic-kicked-up-syrian-hummus",
  "name": "Authentic Kicked-Up Syrian Hummus",
  "recipe_type": "appetizer",
  "brief_description": "One grandmother's Syrian hummus recipe is tweaked a bit with five cloves of sweet, nutty roasted garlic, making it a standout dip that everyone will love.",
  "cuisine": "Syrian Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Place unpeeled garlic cloves in the middle of a large square of aluminum foil. Drizzle cloves with 1 tablespoon olive oil; wrap in foil."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven for 10 to 15 minutes until golden brown. Remove from the oven and allow to cool, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Squeeze roasted garlic out of the peels into a food processor. Add garbanzo beans, tahini, lemon juice, cumin, salt, and remaining 1 tablespoon olive oil. Process until very creamy."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "4910e5d9-4dec-5c14-b52b-181bac4161cc",
  "slug": "jalapeno-salsa",
  "name": "Jalapeno Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This medium-hot green salsa features fresh jalapeno peppers and cilantro. Try it on eggs, as a marinade, or with tortilla chips.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place jalapenos in a saucepan with enough water to cover. Bring to a boil. Simmer until jalapenos soften and begin to lose their shine, about 10 to 12 minutes. Remove the jalapenos with a slotted spoon, chop off the stem, and place them in a blender. Add the tomatoes and boil for 2 to 3 minutes to loosen the skin. Peel the skin from the tomatoes and add tomatoes to the blender."
    },
    {
      "position": 2,
      "text": "Place the onion, cilantro, garlic, lime juice, salt, and black pepper in the blender with the jalapenos and tomatoes. Blend to desired consistency."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "cb1c5c1c-38e8-5bb7-a7a7-f8a3f09de583",
  "slug": "butter-snow-flakes",
  "name": "Snowflake Spritz Cookies",
  "recipe_type": "dessert",
  "brief_description": "These buttery snowflake spritz cookies are enriched with an egg yolk. They're great to make ahead for festive food gifts since they freeze very well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Sift together flour, salt, and cinnamon; set aside."
    },
    {
      "position": 2,
      "text": "Cream together butter and cream cheese in a medium bowl. Add sugar and egg yolk; beat until light and fluffy. Stir in vanilla and orange zest. Gradually blend in the dry ingredients. Fill a Spritz snowflake cookie press or pastry bag with dough and form cookies on an ungreased cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the cookies are golden brown on the peaks and on the bottoms, 12 to 15 minutes. Remove from cookie sheets at once to cool on wire racks."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

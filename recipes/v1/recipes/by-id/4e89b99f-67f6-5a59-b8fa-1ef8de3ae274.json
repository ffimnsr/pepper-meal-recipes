  "id": "4e89b99f-67f6-5a59-b8fa-1ef8de3ae274",
  "slug": "sweet-as-sugar-cookies",
  "name": "Sweet as Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "Made with Splenda, this cookie recipe makes a batch of sweet cut-out cookies that will remind you of your childhood.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, baking powder, and salt in a bowl."
    },
    {
      "position": 2,
      "text": "Beat butter in a mixing bowl with an electric mixer on medium speed until creamy. Gradually add sweetener and beat until well combined. Add eggs, one at a time, mixing well after each addition. Stir in vanilla. Gradually beat in flour mixture until just blended; do not overmix."
    },
    {
      "position": 3,
      "text": "Divide dough in half; pat each half into a circle and wrap tightly with plastic wrap. Chill until slightly firm, about 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove dough from the refrigerator. Working with one portion at a time, roll on a lightly floured surface to a thickness of 1/8 inch. Cut with cookie cutters and transfer shapes to the prepared cookie sheets. Sprinkle cookies with colored sugar."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the edges are lightly browned, 8 to 10 minutes. Cool briefly on the cookie sheets before removing to wire racks to cool completely."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

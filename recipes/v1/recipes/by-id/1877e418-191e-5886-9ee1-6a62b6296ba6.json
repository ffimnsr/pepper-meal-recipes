  "slug": "sour-cream-dressing",
  "name": "Sour Cream Dressing",
  "recipe_type": "salad",
  "brief_description": "This sour cream salad dressing has a touch of sweetness and a hint of mustard and garlic. It\u2019s deliciously creamy on a crisp green salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk oil, vinegar, sour cream, salt, mustard, sugar, parsley, garlic, and pepper together in a bowl. Refrigerate at least 6 hours before serving."
    }
  ],

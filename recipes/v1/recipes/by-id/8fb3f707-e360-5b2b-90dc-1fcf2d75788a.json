  "id": "8fb3f707-e360-5b2b-90dc-1fcf2d75788a",
  "slug": "delicious-gluten-free-pancakes",
  "name": "Delicious Gluten-Free Pancakes",
  "recipe_type": "dessert",
  "brief_description": "A delicious gluten-free pancake with a consistency and taste comparable to those made with wheat flour.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, mix or sift together rice flour, tapioca flour, potato starch, dry buttermilk powder, sugar substitute, baking powder, baking soda, salt, and xanthan gum. Stir in eggs, water, and oil until well blended and few lumps remain."
    },
    {
      "position": 2,
      "text": "Heat a large, well-oiled skillet or griddle over medium-high heat. Spoon batter onto skillet and cook until bubbles begin to form. Flip and continue cooking until golden brown on bottom. Serve immediately with condiments of your choice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

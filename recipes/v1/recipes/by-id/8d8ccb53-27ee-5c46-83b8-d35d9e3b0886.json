  "id": "8d8ccb53-27ee-5c46-83b8-d35d9e3b0886",
  "slug": "a-maize-ing-corn-chowder",
  "name": "A-Maize-ing Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This easy soup recipe delivers a creamy corn chowder with canned corn, potatoes, and crumbled bacon for a comforting bowl of warm deliciousness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fry bacon in a Dutch oven until crisp; remove bacon, reserving 2 tablespoons drippings. Crumble bacon and set aside."
    },
    {
      "position": 2,
      "text": "Saut\u00e9 onion in reserved drippings until tender; add potatoes and water. Cover and simmer until potatoes are tender, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Stir in milk, corn, salt, and pepper to taste; continue to cook, stirring frequently, until heated through. Sprinkle with crumbled bacon to serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

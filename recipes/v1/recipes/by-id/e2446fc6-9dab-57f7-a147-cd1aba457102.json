  "id": "e2446fc6-9dab-57f7-a147-cd1aba457102",
  "slug": "leftover-mashed-potato-pancakes",
  "name": "Leftover Mashed Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Mashed potatoes can easily be turned into delicious potato pancakes covered in a crispy bread crumb crust - perfect use for any leftover mashed potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mashed potatoes, egg, and pepper in a bowl and mix well together."
    },
    {
      "position": 2,
      "text": "Pour bread crumbs into a small bowl. Shape potato mixture into 3-inch patties with wet hands and dip in bread crumbs so they are evenly coated."
    },
    {
      "position": 3,
      "text": "Heat oil and butter in a nonstick skillet over medium heat and cook potato cakes on both sides until they are heated through and browned, about 4 minutes per side."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 5,

  "id": "5b548d14-9b27-52f4-832d-fc1ec7868961",
  "slug": "air-fryer-english-muffin-tuna-melt-recipe-11695943",
  "name": "Air Fryer English Muffin Tuna Melt",
  "recipe_type": "salad",
  "brief_description": "This air fryer English muffin tuna melt makes a quick and delicious meal. Begin by toasting the English muffins in the air fryer, top with a quick tuna salad, and finish by melting the cheese air fryer, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 325 degrees F (165 degrees C). Place sliced English muffins in air fryer and toast until lightly browned, 2 to 4 minutes. Remove and set aside."
    },
    {
      "position": 2,
      "text": "Combine tuna, mayonnaise, mustard, celery, onion, salt, and pepper in a bowl and mix until combined. Divide tuna mixture into 4 equal parts, and top each muffin half with tuna. Top each with 1 slice provolone cheese and 1 slice Cheddar cheese. Air fry until cheese is melted, 5 to 8 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "e008eb42-ad3a-5dc3-b4f6-8f7b818ee498",
  "slug": "spanish-tortilla",
  "name": "Spanish Tortilla",
  "recipe_type": "breakfast",
  "brief_description": "Great for breakfast or brunch. Combines eggs with delicious potatoes in a very short time.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Slice edges off of potatoes so that potatoes are roughly square; thinly slice. Heat olive oil in medium skillet over medium heat. Add potatoes and lightly fry. Remove potatoes with a slotted spoon and set aside."
    },
    {
      "position": 2,
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Remove bacon, crumble and set aside. Reserve 1 tablespoon bacon grease and cook ham, onion and red pepper. Remove from heat."
    },
    {
      "position": 3,
      "text": "Beat eggs and paprika together in a bowl; pour into skillet with vegetables. Add bacon and potatoes. Cook over medium heat, without stirring until bottom begins to brown. Turn omelet over and allow both sides to brown. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "88dd2767-4b54-5d46-94e8-7a24ab1e3a26",
  "slug": "beef-empanadas",
  "name": "Beef Empanadas",
  "recipe_type": "appetizer",
  "brief_description": "These Argentine empanadas are filled with a delicious mixture of ground beef, onions, scallions, and spices.",
  "cuisine": "Argentine",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large Dutch oven over medium heat. Add onions, scallions, and bell pepper. Cover and cook, stirring occasionally, until onions are translucent, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Add ground beef, oregano, salt, cayenne pepper, and cumin to the pot. Cook and stir beef until no longer pink, 8 to 10 minutes. Remove from the heat and allow to cool slightly, then cover and place in the refrigerator until meat is completely cooled, about 1 hour."
    },
    {
      "position": 3,
      "text": "Remove filling from the refrigerator and transfer to a colander to drain. Return filling to the Dutch oven."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Liberally grease a baking sheet with butter."
    },
    {
      "position": 5,
      "text": "Place about 2 tablespoons filling into the center of empanada disk. Fold empanada in half into a crescent shape, press the edges of dough together with a fork or your fingers to seal, and place onto the prepared baking sheet. Repeat with remaining empanadas and filling. Brush tops with egg white."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "8cbcf138-6de0-5cce-9c01-23a375517eda",
  "slug": "strawberry-cheesecake-dump-cake-recipe-11730678",
  "name": "Strawberry Cheesecake Dump Cake",
  "recipe_type": "dessert",
  "brief_description": "This strawberry cheesecake dump cake is assembled quickly from cake mix, cream cheese, strawberries, and strawberry pie filling. It's especially delicious served warm with a scoop of ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Pour pie filling into a 9x13-inch baking dish. Gently fold in fresh strawberries."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, egg, sugar, and vanilla together in a bowl with an electric mixer until well combined and smooth. Spoon mixture over strawberries."
    },
    {
      "position": 3,
      "text": "Spread cake mix in an even layer over the cream cheese mixture, taking care not to mix the layers. Pour melted butter over the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown and bubbly, 40 to 50 minutes. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "8c2a7d5d-99eb-59fb-a707-8a6df95657d2",
  "slug": "dutch-oven-pork-stew",
  "name": "Dutch Oven Pork Stew",
  "recipe_type": "soup",
  "brief_description": "Whether you make it in a Dutch oven on the stovetop or simmer it all day in a slow cooker, this hearty, tomato-based pork stew is great comfort food on a cool night.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle pork cubes with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat oil in a Dutch oven over medium-high heat. Add 1/2 of the pork; cook and stir until browned, about 5 minutes minutes. Remove to a paper towel-lined plate and repeat with remaining pork."
    },
    {
      "position": 3,
      "text": "Add onion, celery, chives, parsley, basil, and dill to the Dutch oven. Cook, stirring occasionally, until onions are tender, 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Add pasta sauce, diced tomatoes, potatoes, corn, mushrooms, and carrots. Stir in browned pork and bring to a boil. Reduce heat, cover, and simmer, stirring occasionally, until meat and vegetables are tender, about 1 1/2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 115,

  "id": "183ed884-e3a6-5811-ad98-1100abc48f4a",
  "slug": "vintage-lemonade",
  "name": "Vintage Lemonade",
  "recipe_type": "drink",
  "brief_description": "Lemons, sugar, and water--in a process that has been handed down since the 19th century. A true classic of a lemonade recipe.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Peel the rinds from the 5 lemons and cut them into 1/2 inch slices. Set the lemons aside."
    },
    {
      "position": 2,
      "text": "Place the rinds in a bowl and sprinkle the sugar over them. Let this stand for about one hour, so that the sugar begins to soak up the oils from the lemons."
    },
    {
      "position": 3,
      "text": "Bring water to a boil in a covered saucepan and then pour the hot water over the sugared lemon rinds. Allow this mixture to cool for 20 minutes and then remove the rinds."
    },
    {
      "position": 4,
      "text": "Squeeze the lemons into another bowl. Pour the juice through a strainer into the sugar mixture. Stir well, pour into pitcher and pop it in the fridge! Serve with ice cubes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9cd5897c-b74a-5439-be66-d0b35b98b647",
  "slug": "asparagus-snow-pea-and-radish-salad",
  "name": "Asparagus, Snow Pea, and Radish Salad",
  "recipe_type": "salad",
  "brief_description": "This elegant, seasonal, refreshing asparagus, snow pea, and radish salad recipe showcases delicate springtime vegetables in a bright lime vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large saucepan with water; bring to a boil. Add asparagus; boil 1 minute. Add snow peas to pan with asparagus; boil 1 minute more. Drain and pat dry."
    },
    {
      "position": 2,
      "text": "Transfer asparagus and snow peas to a large bowl. Add radishes, scallions, and dill; toss gently to combine."
    },
    {
      "position": 3,
      "text": "Whisk oil, sugar, salt, and black pepper together in a small bowl; pour over salad and toss to coat. Set aside at room temperature to allow flavors to blend; about 1 hour. Drizzle lime juice over salad; toss gently to coat."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

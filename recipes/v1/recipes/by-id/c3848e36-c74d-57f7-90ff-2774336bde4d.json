  "slug": "banana-bread-espresso-martini-recipe-11786326",
  "name": "Banana Bread Espresso Martini",
  "recipe_type": "appetizer",
  "brief_description": "This banana bread espresso martini is espresso-forward, with fruity floral notes from the banana liqueur and banana simple syrup. The additions of banana simple syrup, ground nutmeg, and walnut bitters help this cocktail actually register as \u201cbanana bread.\u201d",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice, and add vodka, banana liqueur, espresso, banana simple syrup, and bitters."
    },
    {
      "position": 3,
      "text": "Shake until very cold and frothy, about 30 seconds. Strain into a chilled martini glass."
    },
    {
      "position": 4,
      "text": "Grate nutmeg over martini and garnish with espresso beans, banana chips, or skewered banana bread cubes. Serve immediately. Recipe developed by Marianne Williams"
    }
  ],
  "servings": 1,

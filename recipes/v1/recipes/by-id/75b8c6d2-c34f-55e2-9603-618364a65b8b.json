  "id": "75b8c6d2-c34f-55e2-9603-618364a65b8b",
  "slug": "ultimate-low-carb-ham-and-cheese-omelet-for-two",
  "name": "Ultimate Low-Carb Ham and Cheese Omelet for Two",
  "recipe_type": "breakfast",
  "brief_description": "A tasty low-carb keto omelet with Black Forest ham, Swiss cheese, and green onions. It's quick and easy to make for lunch, brunch, or anytime!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray or lightly grease a large skillet and heat over medium heat."
    },
    {
      "position": 2,
      "text": "Beat eggs, heavy cream, salt, and pepper in a bowl. Pour eggs into the heated skillet, swirling the skillet to coat the bottom. Cover and let cook until eggs are firm, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Top with Swiss cheese, ham, and green onions. Fold omelet in half over fillings; cook for 2 minutes more."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

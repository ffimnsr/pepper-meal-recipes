  "id": "f45bcc07-7c47-5200-a111-8d57b7e81018",
  "slug": "vinegar-pecan-pie",
  "name": "Vinegar Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "A favorite pie that is not quite as sweet tasting as the standard pecan pie. Whips up in minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together sugar and margarine. Stir in eggs, vanilla and vinegar. Stir in pecans. Pour into pie shell."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 45 minutes, or until top is lightly browned, and filling is set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

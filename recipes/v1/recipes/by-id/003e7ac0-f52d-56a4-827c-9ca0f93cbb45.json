  "id": "003e7ac0-f52d-56a4-827c-9ca0f93cbb45",
  "slug": "fresh-no-bake-fruit-pie",
  "name": "Fresh No-Bake Fruit Pie",
  "recipe_type": "dessert",
  "brief_description": "Fresh strawberries, blueberries, raspberries, and blackberries fill a prepared shortbread pie crust for an easy and refreshing no-bake pie that won’t heat up your kitchen. Serve with a dollop of your favorite whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Thoroughly combine strawberries, blueberries, raspberries, and blackberries in a bowl. Scoop out 3/4 cup of mixed berries and place into a saucepan with 1 cup water and sugar; set remaining berries aside. Bring the mixture to a boil and reduce heat to medium-low."
    },
    {
      "position": 2,
      "text": "Whisk cornstarch and 1/4 cup water in a bowl until smooth and stir the cornstarch mixture into the hot fruit syrup; stir until the mixture thickens, about 2 minutes. Let the mixture cool completely, stirring occasionally, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Pour the thickened berry mixture into fresh berries until thoroughly combined; pour berries and sauce into shortbread pie crust. Place in refrigerator until chilled, at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

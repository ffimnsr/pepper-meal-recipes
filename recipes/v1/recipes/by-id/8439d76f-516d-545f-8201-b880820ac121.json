  "slug": "tasty-lemonade",
  "name": "Tasty Lemonade",
  "recipe_type": "drink",
  "brief_description": "This lemonade made with brown sugar is good on hot days, and very successful at lemonade stands served with a twist of lemon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pitcher, combine fresh lemon juice and water. Stir in brown sugar until it dissolves. Stir in ice cubes."
    }

  "id": "8b054ab8-2a3e-53c7-836a-eadd1d6df8d6",
  "slug": "asian-garlic-beef-cubes-vietnamese-bo-luc-lac-or-shaking-beef",
  "name": "Asian Garlic Beef Cubes (Vietnamese Bo Luc Lac or Shaking Beef)",
  "recipe_type": "main",
  "brief_description": "Marinated beef cubes and garlic are stir-fried (also known as \"shaking beef\") in this delicious Asian-inspired dish called bo luc lac.",
  "cuisine": "Vietnamese",
  "instructions": [
    {
      "position": 1,
      "text": "Put beef cubes in a container with a lid. Whisk 2 tablespoons olive oil, 2 tablespoons oyster sauce, 4 minced garlic cloves, wine, 1 teaspoon fish sauce, 1 teaspoon black pepper, soy sauce, dark soy sauce, and sesame oil together in a bowl until marinade is well mixed; pour over beef. Allow beef to marinate, 10 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Whisk 1 tablespoon fish sauce, lemon juice, and 1 tablespoon black pepper together in a bowl until dipping sauce is well mixed."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons olive oil in a wok or large skillet over high heat; add beef and marinade. Cook and stir beef mixture, 2 tablespoons oyster sauce, and 4 cloves minced garlic together in hot oil until beef is cooked through and sauce begins to thicken, 5 to 10 minutes. Adding garlic over several times during cooking will produce a better mix of flavors."
    },
    {
      "position": 4,
      "text": "Serve beef alongside dipping sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

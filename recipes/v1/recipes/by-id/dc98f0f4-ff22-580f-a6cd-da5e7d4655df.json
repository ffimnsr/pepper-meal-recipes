  "id": "dc98f0f4-ff22-580f-a6cd-da5e7d4655df",
  "slug": "brown-familys-favorite-pumpkin-pie",
  "name": "Brown Family's Favorite Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This family-favorite pumpkin pie has a rich creamy filling with lots of wonderful spices and a crunchy cinnamon and brown sugar streusel topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix pumpkin, sweetened condensed milk, and egg yolks in a large bowl until smooth. Stir in 1 teaspoon cinnamon, ginger, nutmeg, and salt until well combined."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a clean glass or metal bowl until soft peaks form, about 2 minutes. Fold egg whites into pumpkin mixture until no streaks remain. Pour filling into unbaked pie shell and smooth the top."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 15 minutes. Meanwhile, combine flour, brown sugar, and 1 teaspoon cinnamon in a small bowl until evenly blended. Cut butter into flour mixture until crumbly, about 2 minutes. Stir in chopped walnuts. Sprinkle topping over pumpkin pie."
    },
    {
      "position": 5,
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C).Bake pie until center is set and a knife inserted near the center comes out clean, about 40 minutes. Cool pie on a wire rack until room temperature, about 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "slug": "charoset",
  "name": "Charoset",
  "recipe_type": "dessert",
  "brief_description": "This charoset recipe is easy to make with grated apples, walnuts, honey, and cinnamon for a sweet, fruity relish and a wonderful Passover treat.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix apples, walnuts, grape juice, honey, and cinnamon together in a bowl. Cover with plastic wrap and refrigerate until chilled, 8 hours to overnight."
    }
  ],

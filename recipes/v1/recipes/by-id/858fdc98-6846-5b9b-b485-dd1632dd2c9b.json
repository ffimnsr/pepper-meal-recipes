  "id": "858fdc98-6846-5b9b-b485-dd1632dd2c9b",
  "slug": "quick-and-easy-tomato-basil-gnocchi-recipe-7974793",
  "name": "Quick and Easy Tomato Basil Gnocchi",
  "recipe_type": "side",
  "brief_description": "These quick and easy tomato basil gnocchi dish comes together in just 15 minutes for a fast and fuss-free comforting weeknight dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil over medium high heat. Add gnocchi; cook until they float to the top, 3 to 5 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Add garlic and saut\u00e9 until fragrant, about 30 seconds. Stir in Italian seasoning and cooked gnocchi. Pour in spaghetti sauce and cook until sauce is warmed through, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Divide gnocchi between two bowls. Garnish with Parmesan cheese and basil."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

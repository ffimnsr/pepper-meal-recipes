  "id": "6f08a634-10b9-5682-99e8-5277e9cfe700",
  "slug": "banana-muffins-ii",
  "name": "Banana Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These banana muffins are deliciously moist and tender. Made with ripe mashed bananas and simple pantry ingredients \u2014 they are easy for kids to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, baking soda, and salt together in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Mix bananas, sugar, egg, and melted butter in a separate large bowl until well combined; fold in flour mixture until smooth."
    },
    {
      "position": 4,
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 25 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Cool briefly in the tin, then transfer to a wire rack to cool completely."
    },
    {
      "position": 7,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

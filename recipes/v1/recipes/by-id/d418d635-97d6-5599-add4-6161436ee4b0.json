  "id": "d418d635-97d6-5599-add4-6161436ee4b0",
  "slug": "prosciutto-fave-minestrone-alla-riso",
  "name": "Prosciutto Fave Minestrone alla Riso",
  "recipe_type": "soup",
  "brief_description": "Ham, beans and rice are featured in this hearty soup with tomatoes.",
  "cuisine": "Italian Inspired American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over medium heat, cook bacon in olive oil until brown. Stir in ham and cook a few minutes more. Stir in celery (reserve the leaves), onion and carrot and cook until vegetables are tender, 5 minutes. Stir in garlic and cook 1 minute more."
    },
    {
      "position": 2,
      "text": "Stir in tomatoes, broth, rice, salt and pepper. Bring to a boil, then reduce heat, cover and simmer 20 minutes, or until vegetables are soft and rice is nearly tender."
    },
    {
      "position": 3,
      "text": "Stir in cranberry beans and white beans and heat through. Stir in parsley and celery leaves and remove from heat. Serve hot."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "0a5fc822-7965-5abe-bb2b-05d65090f43e",
  "slug": "stuffed-cabbage",
  "name": "Stuffed Cabbage",
  "recipe_type": "soup",
  "brief_description": "Cabbage leaves are wrapped around a beef and rice mixture, then baked in a sauce made from tomato soup in this old-time favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage head in freezer and freeze overnight. Remove from freezer, thaw and peel away leaves."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine the beef, egg, onion, rice, salt and pepper. Mix together well. Take a small handful and form into a small roll or ball. Place into the center of a cabbage leaf. Fold the sides of the leaf over and roll the ball up into the leaf. Place seam side down in baking dish. Continue until all of the filling is used up."
    },
    {
      "position": 4,
      "text": "Mix together the soup with a 1/2 can water; pour over stuffed cabbage."
    },
    {
      "position": 5,
      "text": "Bake uncovered at 350 degrees F (175 degrees C) for 1 hour; baste often with the sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

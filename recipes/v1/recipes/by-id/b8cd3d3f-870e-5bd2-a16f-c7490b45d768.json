  "id": "b8cd3d3f-870e-5bd2-a16f-c7490b45d768",
  "slug": "20-minute-shrimp-fajitas-sheet-pan-dinner",
  "name": "20-Minute Shrimp Fajitas Sheet Pan Dinner",
  "recipe_type": "main",
  "brief_description": "These 20-minute shrimp fajitas are baked on a sheet pan for a quick and easy weeknight dinner your family will love.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray a rimmed baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine shrimp, bell peppers, red onion, olive oil, chili powder, salt, black pepper, garlic powder, onion powder, cumin, and paprika in a large bowl; toss to combine. Spread mixture on the prepared pan evenly."
    },
    {
      "position": 3,
      "text": "Cook in the preheated oven until shrimp are bright pink and firm, about 8 minutes. Turn on the oven's broiler and cook for an additional 2 minutes."
    },
    {
      "position": 4,
      "text": "Squeeze lime juice over mixture."
    },
    {
      "position": 5,
      "text": "Build fajitas on tortillas with avocado slices and cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

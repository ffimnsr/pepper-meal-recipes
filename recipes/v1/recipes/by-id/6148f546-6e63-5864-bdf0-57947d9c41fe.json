  "id": "6148f546-6e63-5864-bdf0-57947d9c41fe",
  "slug": "easy-peppermint-bark-cheesecake-recipe-11846892",
  "name": "Easy Peppermint Bark Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This easy peppermint bark cheesecake has an Oreo cookie crust, a no-bake filling studded with chopped peppermint bark, and more bark on top. It's an easy but impressive finish for Christmas dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9-inch springform pan."
    },
    {
      "position": 2,
      "text": "Process cookies in a food processor until finely ground. Add melted butter and pulse until just combined. Press cookie mixture into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven until just fragrant, about 10 minutes. Let cool completely."
    },
    {
      "position": 4,
      "text": "Beat cream and confectioner\u2019s sugar together with an electric mixer until stiff peaks form. Set aside."
    },
    {
      "position": 5,
      "text": "Stir together cheesecake filling and chopped peppermint bark until well combined. Fold in whipped cream, spread mixture evenly over crust, and smooth the top."
    },
    {
      "position": 6,
      "text": "Sprinkle the top with additional peppermint bark and place in the freezer to set up, at least 2 hours."
    },
    {
      "position": 7,
      "text": "Let stand at room temperature for 10 to 15 minutes before slicing and serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

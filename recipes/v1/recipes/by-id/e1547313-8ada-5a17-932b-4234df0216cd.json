  "slug": "asparagus-guacamole",
  "name": "Asparagus Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "Guacamole made with asparagus instead of avocado. It is good stuff!",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the asparagus in a pot with enough water to cover. Bring to a boil, and cook 5 minutes, until tender but firm. Drain, and rinse with cold water."
    },
    {
      "position": 2,
      "text": "Place the asparagus, salsa, cilantro, garlic, and green onions in a food processor or blender, and process to desired consistency. Refrigerate until chilled before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

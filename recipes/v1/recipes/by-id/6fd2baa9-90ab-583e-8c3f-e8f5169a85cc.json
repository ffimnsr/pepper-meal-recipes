  "id": "6fd2baa9-90ab-583e-8c3f-e8f5169a85cc",
  "slug": "butternut-squash-and-apple-cider-soup",
  "name": "Butternut Squash and Apple Cider Soup",
  "recipe_type": "appetizer",
  "brief_description": "This butternut squash and apple cider soup recipe, simmered with potatoes and carrots for a sweet-and-savory flavor, is perfect on cold autumn evenings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onion; cook and stir until translucent, 5 to 10 minutes. Add butternut squash, potatoes, celery, apple, and carrot. Add chicken broth and enough apple cider to cover vegetables; bring to a boil. Cover, reduce heat, and simmer, adding more apple cider to cover vegetables as needed, until vegetables are tender, 35 to 40 minutes."
    },
    {
      "position": 2,
      "text": "Blend squash mixture with an immersion blender until smooth; stir in half-and-half, cinnamon, and cloves. Simmer until heated through, 5 to 10 minutes. Divide soup among bowls; top each bowl with about 1 tablespoon sour cream and 1 pinch nutmeg."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

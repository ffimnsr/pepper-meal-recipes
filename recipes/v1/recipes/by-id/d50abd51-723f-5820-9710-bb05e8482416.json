  "id": "d50abd51-723f-5820-9710-bb05e8482416",
  "slug": "zucchini-bread-vii",
  "name": "Sour Cream Zucchini Bread",
  "recipe_type": "breakfast",
  "brief_description": "This sour cream zucchini bread recipe bakes up two fresh loaves that are rich and tangy from the sour cream, yet light and moist from the zucchini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Beat sugar and oil together in a bowl with an electric mixer; beat in eggs, one at a time, beating well after each addition. Stir in vanilla extract."
    },
    {
      "position": 3,
      "text": "Sift flour, baking soda, salt, and baking powder into a separate bowl; stir in sugar mixture, alternating with sour cream, stirring until just combined after each addition. Fold in zucchini and walnuts until just combined. Pour batter into the prepared pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour 20 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

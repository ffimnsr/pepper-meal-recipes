  "id": "e1eaf049-9897-56aa-a7aa-efc9030972f6",
  "slug": "oven-fried-potatoes-i",
  "name": "Oven-Fried Potatoes",
  "recipe_type": "side",
  "brief_description": "This recipe for mouthwatering oven-fried potatoes cooks them in the oven with chopped onion, bacon, and butter until golden and deliciously crispy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Place potatoes in an even layer in the prepared dish. Sprinkle onion and bacon over potatoes; dot with diced butter. Cover the dish with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 45 minutes. Remove foil; stir potatoes. Turn on the broiler and broil until until potatoes are brown and crisp, about 5 minutes. You may need to stir every minute or so for even browning. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

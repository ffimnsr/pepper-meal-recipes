  "id": "764fb003-79aa-5067-aabb-e2e884583e9d",
  "slug": "toms-scrambled-egg-sandwich",
  "name": "Tom's Scrambled Egg Sandwich",
  "recipe_type": "breakfast",
  "brief_description": "Sandwich scrambled eggs between two slices of toast with a little mustard and mayo in this recipe that's been handed down through the generations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs, milk, and salt together in a bowl."
    },
    {
      "position": 2,
      "text": "Heat a small nonstick skillet over medium heat. Cook eggs in hot skillet without stirring until set on the bottom, about 1 1/2 minutes. Flip eggs and cook without stirring until set on the other side, about 1 minute more. Remove from heat."
    },
    {
      "position": 3,
      "text": "Spread 1 tablespoon of mayonnaise on each piece of toast. Spread mustard over mayonnaise onto each piece of toast. Place eggs on one piece of toast and top with remaining toast."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

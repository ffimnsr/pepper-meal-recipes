  "id": "0cb3f0cf-9089-5602-83d3-309004a84b1c",
  "slug": "easy-white-chicken-enchiladas",
  "name": "Easy White Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "These white chicken enchiladas are a cinch to make with ingredients right off the shelf. The only skill required is in measuring, the rest just works itself out!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly spray an 8x8-inch glass baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together the softened cream cheese, sour cream, and salsa until blended. Fold in chicken and shredded cheese. Spread a small amount of white cheese sauce onto the bottom of the baking dish. Evenly divide the filling among the tortillas, and roll into firm cylinders. Place into prepared baking dish and cover with remaining sauce."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until golden and bubbly, about 30 minutes. Allow to rest 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,
  "difficulty": "medium",

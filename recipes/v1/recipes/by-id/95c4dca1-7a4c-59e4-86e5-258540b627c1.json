  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "95c4dca1-7a4c-59e4-86e5-258540b627c1",
  "slug": "shrimp-tostadas-recipe-7496443",
  "name": "Shrimp Tostadas",
  "recipe_type": "main",
  "brief_description": "These shrimp tostadas really stack up! A chipotle slaw, refried black beans, and shrimp pile up on crispy tostada shells for a fun and tasty dinner.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayonnaise, minced chipotle peppers, lime juice, honey, avocado oil, 1 teaspoon cumin, and salt to taste for the slaw in a large bowl. Stir until well blended. Add shredded cabbage and toss to coat. Refrigerate until ready to use."
    },
    {
      "position": 2,
      "text": "Combine water, sofrito base, and cayenne pepper in a large skillet for the slaw. Bring to a boil over medium heat. Add shrimp to the boiling liquid, bring back to a boil, and cook until shrimp turn white and peachy-pink, and make a \u201cC\u201d shape, 3 to 5 minutes. Using a slotted spoon or spider, remove shrimp from the cooking liquid immediately."
    },
    {
      "position": 3,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the broiler. Line a baking tray with aluminum foil."
    },
    {
      "position": 4,
      "text": "Stir refried beans, smoked paprika, 1/2 teaspoon cumin, and garlic granules together in a bowl for the tostadas. Spread each tostada shell with bean mixture, 1 to 2 tablespoons per tostada, or to taste. Sprinkle queso fresco crumbles evenly on each tostada. Place tostadas on the prepared baking tray in a single layer."
    },
    {
      "position": 5,
      "text": "Broil under the preheated broiler until cheese begins to melt, 1 to 2 minutes. Watch that tostada shells do not burn."
    },
    {
      "position": 6,
      "text": "Place about 1/2 cup of the prepared slaw on each tostada. Top with chopped cilantro to taste. Add three shrimp per tostada, and drizzle crema over all. Serve with lime slices, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "71a6e0b8-85d4-5fb3-b5ba-9cb9acb9381d",
  "slug": "slow-cooker-cranberry-sauce",
  "name": "Slow Cooker Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "This easy slow cooker recipe for cranberry sauce tastes wonderful, and makes the house smell like the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine orange juice, water, brown sugar, white sugar, and cinnamon in slow cooker; stir in cranberries. Cook on High for 3 hours, stirring once each hour."
    },
    {
      "position": 2,
      "text": "Remove lid; stir well. Cook on High until sauce has thickened and most cranberries have popped, about 45 more minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 225,

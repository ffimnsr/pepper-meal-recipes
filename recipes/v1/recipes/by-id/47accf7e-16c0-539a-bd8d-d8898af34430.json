  "id": "47accf7e-16c0-539a-bd8d-d8898af34430",
  "slug": "incredibly-easy-chicken-and-noodles",
  "name": "Incredibly Easy Chicken and Noodles",
  "recipe_type": "soup",
  "brief_description": "My aunt's chicken and noodles soup recipe is wonderfully rich thanks to two types of canned condensed soup. It's so simple and easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine chicken broth, both condensed soups, and diced chicken in a large pot. Season with onion powder, seasoning salt, and garlic powder."
    },
    {
      "position": 3,
      "text": "Bring to a boil over high heat and stir in noodles."
    },
    {
      "position": 4,
      "text": "Reduce heat to low and simmer until desired consistency is reached, 20 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

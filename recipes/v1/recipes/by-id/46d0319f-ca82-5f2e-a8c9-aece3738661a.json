  "id": "46d0319f-ca82-5f2e-a8c9-aece3738661a",
  "slug": "erins-blueberry-scones",
  "name": "Best Blueberry Scones",
  "recipe_type": "breakfast",
  "brief_description": "This blueberry scone recipe is quick and easy to make with frozen blueberries for a tender and golden breakfast treat the whole family will enjoy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix flour, 1/2 cup white sugar, baking powder, baking soda, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Cut in butter using a pastry blender or fork until the flour mixture looks like cornmeal."
    },
    {
      "position": 4,
      "text": "Pour in milk, 1 egg, and vanilla extract. Fold in frozen blueberries and mix sparingly."
    },
    {
      "position": 5,
      "text": "Scoop dough onto the prepared baking sheet into 10 equal-sized amounts of dough. Do not flatten. Brush tops with reserved beaten egg. Sprinkle 2 tablespoons sugar evenly over the tops."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

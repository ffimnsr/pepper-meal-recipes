  "id": "a42ac104-7e57-5050-a2f4-aded10ec9e32",
  "slug": "puffed-caramel-corn",
  "name": "Puffed Caramel Corn",
  "recipe_type": "appetizer",
  "brief_description": "This puffed corn recipe is made with store-bought corn puffs baked with peanuts and caramel for the classic snack without hulls or unpopped kernels.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Combine corn puffs and peanuts in a large roasting pan."
    },
    {
      "position": 2,
      "text": "Bring butter, brown sugar, and corn syrup to a boil in a heavy 2-quart saucepan. Cook and stir for 2 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat; stir in baking soda until mixture foams up."
    },
    {
      "position": 4,
      "text": "Pour over corn puff mixture and toss well using rubber spatulas. Bake in the preheated oven, stirring every 10 to 15 minutes, until a cooled piece of corn is crunchy, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Spread on waxed paper to cool. Break apart and store in an airtight container."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

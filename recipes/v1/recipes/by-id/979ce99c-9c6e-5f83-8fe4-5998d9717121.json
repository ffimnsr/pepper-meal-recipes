  "id": "979ce99c-9c6e-5f83-8fe4-5998d9717121",
  "slug": "oh-so-tender-brisket",
  "name": "Oh So Tender Brisket",
  "recipe_type": "soup",
  "brief_description": "Beef brisket seasoned with dry onion soup, liquid smoke and garlic powder then baked slowly until tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 2,
      "text": "Coat the inside of an oven roasting bag with flour. Place brisket inside of bag. Pour liquid smoke over the brisket and sprinkle on garlic powder, dry onion soup mix, and ground black pepper. Seal bag. Using a fork, make two sets of holes in the top of the roasting bag."
    },
    {
      "position": 3,
      "text": "Lay bag in a broiling pan. Bake in a preheated oven for 6 to 8 hours."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 15,

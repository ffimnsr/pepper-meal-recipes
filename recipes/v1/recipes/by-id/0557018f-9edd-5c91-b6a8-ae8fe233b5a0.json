  "id": "0557018f-9edd-5c91-b6a8-ae8fe233b5a0",
  "slug": "sweet-pork-for-burritos",
  "name": "Sweet Pork for Burritos",
  "recipe_type": "dessert",
  "brief_description": "This rich, sweet pork recipe cooks up easily in the slow cooker. Serve it with rice and beans or use as a filling for burritos or tacos.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork roast in a slow cooker and add 4 cups water. Cook on High for 5 hours."
    },
    {
      "position": 2,
      "text": "Remove pork from the slow cooker and drain liquid. Cut pork into 4 pieces and set aside."
    },
    {
      "position": 3,
      "text": "Pur\u00e9e salsa in blender. Combine salsa, cola, brown sugar, fajita seasoning, taco seasoning, and green chiles in the slow cooker. Return pork to the slow cooker and cook on High for 3 hours."
    },
    {
      "position": 4,
      "text": "Remove pork and shred it with 2 forks."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 30,

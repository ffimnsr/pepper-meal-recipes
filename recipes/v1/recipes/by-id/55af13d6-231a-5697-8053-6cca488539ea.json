  "id": "55af13d6-231a-5697-8053-6cca488539ea",
  "slug": "pot-pie-with-leftover-pot-roast-and-vegetables",
  "name": "Pot Pie with Leftover Pot Roast and Vegetables",
  "recipe_type": "main",
  "brief_description": "If you're wondering what to do with your leftover pot roast and vegetables, follow this recipe and make a delicious pot pie to serve the next night.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place one pie crust into a pie pan and press into place; prick the bottom and sides with a fork."
    },
    {
      "position": 2,
      "text": "Bake pie crust in the preheated oven for 3 to 5 minutes; it will still be pliable so you can seal it with the top crust later. Remove from the oven and lower the temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Melt butter in a large pan over medium heat. Whisk in flour to make a roux; cook and whisk until golden, 3 to 4 minutes. Whisk in beef broth and continue to cook, whisking constantly, until thickened, 3 to 5 minutes. Add hot pepper sauce, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Stir in shredded pot roast, potatoes, carrots, onions, peas, and corn. Pour into the partially baked pie crust and cover with the remaining pie crust. Fold the edges of the top crust under the bottom crust and press together to seal. Cut several slits in the top crust to allow steam to escape."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is golden brown, 35 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

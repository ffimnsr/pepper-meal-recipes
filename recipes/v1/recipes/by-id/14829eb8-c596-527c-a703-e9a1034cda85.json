  "slug": "lucky-and-rippys-favorite-dog-food",
  "name": "Lucky and Rippy's Favorite Dog Food",
  "recipe_type": "main",
  "brief_description": "This boiled chicken and rice for dogs is tasty homemade dog food easily made on the stovetop with 4 basic ingredients, including frozen vegetables.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken, rice, and vegetables into a large saucepan or Dutch oven; stir in water until smooth. Place over medium-high heat and bring to a boil; stir constantly."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium-low, cover, and simmer until rice is tender and liquid is absorbed, about 25 minutes. Cool completely before serving; store covered in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,

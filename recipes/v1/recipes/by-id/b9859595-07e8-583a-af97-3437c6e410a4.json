  "id": "b9859595-07e8-583a-af97-3437c6e410a4",
  "slug": "white-chocolate-biscotti",
  "name": "White Chocolate Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Receive rave reviews when you make these Italian cookies at home--who doesn't enjoy crunchy, twice-baked biscotti bursting with almonds, dried apricots, and white chocolate?",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour 2 cookie sheets."
    },
    {
      "position": 2,
      "text": "Combine sugar, butter, and eggs in a large bowl; beat with an electric mixer until smooth and creamy. Add flour, almonds, apricots, orange juice, melted white chocolate, chopped white chocolate, baking powder, salt, and almond extract. Mix until well blended; dough will be sticky and very soft."
    },
    {
      "position": 3,
      "text": "Divide dough in 1/2 and carefully form into 2 long logs, each about 2-inches wide. Place each log on a prepared cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 25 to 30 minutes, keeping a close eye that they don't get too brown. Cool on the cookie sheets for 10 minutes. Cut logs into 1/2-inch wide strips."
    },
    {
      "position": 5,
      "text": "Place cookies back on cookie sheets. Return to the oven and bake for 10 more minutes. Cool completely before serving."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

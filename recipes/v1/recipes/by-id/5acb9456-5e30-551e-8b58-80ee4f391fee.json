  "id": "5acb9456-5e30-551e-8b58-80ee4f391fee",
  "slug": "white-peach-sangria",
  "name": "White Peach Sangria",
  "recipe_type": "drink",
  "brief_description": "This white peach sangria combines peach vodka, white wine, peach slices, and grapes to make a refreshingly fruity summer punch that's sure to please!",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine white wine, peach vodka, lemonade concentrate, and sugar in a large pitcher; stir until sugar is dissolved. Add sliced peaches, red grapes, and green grapes."
    },
    {
      "position": 2,
      "text": "Refrigerate sangria until well chilled and flavors have blended, at least 2 hours to overnight."
    },
    {
      "position": 3,
      "text": "Serve over ice, and use a slotted spoon to include sliced peaches and grapes with each serving."
    }
  ],
  "servings": 6,

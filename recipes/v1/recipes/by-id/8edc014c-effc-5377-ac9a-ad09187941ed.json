  "slug": "cranberry-jalapeno-relish",
  "name": "Cranberry-Jalape\u00f1o Relish",
  "recipe_type": "side",
  "brief_description": "Borrowing from the flavors of the Southwest, this uncooked cranberry-jalape\u00f1o relish uses jalape\u00f1o, lime, cilantro, and cumin to add a twist to a classic.",
  "cuisine": "U.S. Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "In a mixing bowl, combine cranberries, orange juice, onion, cilantro, garlic, jalape\u00f1o, lime juice, cumin, and salt."
    },
    {
      "position": 2,
      "text": "Stir together and chill 2 hours before serving."
    }
  ],

  "id": "e897995b-86bc-5584-bb7b-48ee625949db",
  "slug": "spicy-potsticker-soup-recipe-8777981",
  "name": "Spicy Potsticker Soup",
  "recipe_type": "soup",
  "brief_description": "This spicy potsticker soup is fast, easy, incredibly delicious, and takes very little knife work to accomplish. It's exactly what you want when you don't know what you want.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a soup pot over high heat. Add mushrooms, and cook, stirring occasionally, until they start to brown, about 4 minutes."
    },
    {
      "position": 2,
      "text": "Stir in ginger, garlic, and white parts of sliced green onions, and cook just until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Pour in broth and bring to a simmer. Stir in soy sauce, rice vinegar, sesame oil, and Sriracha."
    },
    {
      "position": 4,
      "text": "Add bok choy, green parts of sliced green onion, and frozen potstickers, and cook, stirring occasionally, until dumplings are heated through, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Just before potstickers are hot, mix miso paste with about 1/2 cup of hot broth, and stir into the soup. Turn off the heat, and stir in chili crisp. Taste for seasoning, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

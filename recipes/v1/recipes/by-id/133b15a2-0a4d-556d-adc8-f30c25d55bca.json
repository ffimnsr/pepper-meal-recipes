  "schema_version": 1,
  "id": "133b15a2-0a4d-556d-adc8-f30c25d55bca",
  "slug": "eggplant-lasagna",
  "name": "Eggplant Lasagna",
  "recipe_type": "main",
  "brief_description": "This eggplant lasagna is made with slices of tender roasted eggplant instead of noodles, layered with sauce and cheese for a comforting low carb meal.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 baking sheets and a 9x13-inch baking dish with 1 teaspoon olive oil."
    },
    {
      "position": 2,
      "text": "Whisk eggs and water together in a shallow dish. Combine Parmesan cheese, bread crumbs, salt, and pepper in a separate shallow dish."
    },
    {
      "position": 3,
      "text": "Dip eggplant slices into egg mixture, then press into bread crumb mixture. Gently tap off any excess crumbs. Arrange breaded eggplant slices on the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the bottoms are golden brown, 20 to 25 minutes. Flip eggplant and continue baking until tender, 20 to 25 minutes. Set aside."
    },
    {
      "position": 5,
      "text": "Increase the oven temperature to 400 degrees F (200 degrees C)."
    },
    {
      "position": 6,
      "text": "Heat 2 tablespoons olive oil in a skillet over medium-high heat. Stir in ground beef; season with salt and pepper. Cook and stir until beef is browned and crumbly, about 10 minutes. Drain excess grease. Stir tomato sauce into ground beef; bring to a simmer, then set sauce aside."
    },
    {
      "position": 7,
      "text": "Place 1/3 of the eggplant slices on the bottom of the prepared baking dish. Pour 1/3 of the meat sauce on top of eggplant layer."
    },
    {
      "position": 8,
      "text": "Sprinkle 1/3 of the mozzarella cheese on top of sauce layer. Repeat this step 2 more times, finishing with a layer of mozzarella cheese."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until cheese is melted and sauce is bubbling, 10 to 15 minutes. Cool for 5 minutes before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

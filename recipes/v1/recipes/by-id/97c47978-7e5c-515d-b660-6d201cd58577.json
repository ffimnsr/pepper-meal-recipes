  "id": "97c47978-7e5c-515d-b660-6d201cd58577",
  "slug": "instant-pot-pork-stew",
  "name": "Instant Pot Pork Stew",
  "recipe_type": "soup",
  "brief_description": "Turn pork shoulder into a flavorful, simple pork stew using your Instant Pot. Red wine, carrots, and tomato paste add richness and flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add oil; heat for 1 minute. Meanwhile, season pork with salt and pepper. Add to the pot; cook and stir until evenly browned on all sides, 4 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add flour; cook and stir for 1 to 2 minutes. Deglaze the pot with wine, broth, and tomato paste, scraping up the browned bits from the bottom."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Stir in onion, carrots, celery, garlic, and bay leaves. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 5 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

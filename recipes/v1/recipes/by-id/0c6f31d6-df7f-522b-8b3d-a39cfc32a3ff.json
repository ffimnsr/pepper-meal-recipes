  "id": "0c6f31d6-df7f-522b-8b3d-a39cfc32a3ff",
  "slug": "vegan-mushroom-risotto",
  "name": "Vegan Mushroom Risotto",
  "recipe_type": "main",
  "brief_description": "This vegan mushroom risotto recipe is chock-full of mushroom flavor in the best possible way, especially if made with homemade vegetable stock with mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vegetable stock into a large pot and bring to a boil over medium heat. Reduce heat to low, cover, and keep warm."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons olive oil in a large Dutch oven over medium-high heat. Add mushrooms and cook, stirring occasionally, until softened, about 10 minutes. Add onion and cook until soft and translucent, about 5 minutes. Stir in celery and garlic, and cook until garlic is fragrant, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add remaining 2 tablespoons olive oil and Arborio rice to the Dutch oven. Cook, stirring often, until rice is opaque and smells slightly toasted, 2 to 4 minutes. Stir in white wine; cook until it evaporates, an additional 2 to 3 minutes. Season with thyme, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Begin stirring in reserved warm vegetable stock, one cup at a time; allow each addition of stock to be fully absorbed before adding in the next, stirring continuously. Continue adding broth gradually, stirring constantly, until rice is tender and creamy, about 20 minutes. Season with additional salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

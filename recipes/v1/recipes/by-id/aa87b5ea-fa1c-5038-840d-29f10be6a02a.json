  "id": "aa87b5ea-fa1c-5038-840d-29f10be6a02a",
  "slug": "langostino-ceviche",
  "name": "Langostino Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "Cooked langostino tails stand in for raw fish in this easy ceviche recipe you'll want to serve as an appetizer at your next dinner party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grate 1 teaspoon orange zest into a bowl. Grate 1 teaspoon lime zest into the same bowl. Juice the orange, 4 limes, and both lemons into the same bowl; set aside."
    },
    {
      "position": 2,
      "text": "Place red onion in a non-reactive bowl. Add 1/4 cup kosher salt and cover with warm water. Juice the remaining lime into the bowl. Let sit for 10 minutes. Drain and rinse well with cold water; drain again."
    },
    {
      "position": 3,
      "text": "Return onion to the non-reactive bowl. Add citrus juice and zest, cilantro sprigs, garlic cloves, serrano peppers, sea salt, oregano, and cayenne. Cover and marinate in the refrigerator, stirring occasionally, for 45 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the refrigerator. Remove and discard garlic, serrano peppers, and cilantro sprigs. Add langostino tails and mix gently to combine with the juices. Cover and refrigerate for 45 more minutes."
    },
    {
      "position": 5,
      "text": "Remove from the refrigerator and add cherry tomatoes, chopped cilantro, and olive oil; mix well until thoroughly incorporated."
    },
    {
      "position": 6,
      "text": "Taste and season with additional kosher salt if needed."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

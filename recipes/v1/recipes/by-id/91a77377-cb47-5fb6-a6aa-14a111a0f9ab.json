  "id": "91a77377-cb47-5fb6-a6aa-14a111a0f9ab",
  "slug": "potato-hay",
  "name": "Potato Hay",
  "recipe_type": "side",
  "brief_description": "Fried spiral potatoes make a favorite side. Potatoes are spiralized into curls and air-fried with only a little oil to make crispy, golden brown hay.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut potatoes into spirals using the medium grating attachment on a spiralizer, cutting the spirals with kitchen shears after 4 or 5 rotations."
    },
    {
      "position": 2,
      "text": "Soak potato spirals in a bowl of water for 20 minutes. Drain and rinse well. Pat potatoes dry with paper towels, removing as much moisture as possible."
    },
    {
      "position": 3,
      "text": "Place potato spirals in a large resealable plastic bag. Add oil, salt, and pepper; toss to coat."
    },
    {
      "position": 4,
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C)."
    },
    {
      "position": 5,
      "text": "Place 1/2 of the potato spirals in the fry basket and insert into the air fryer. Cook until golden, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Increase temperature to 390 degrees F (200 degrees C). Pull out the fry basket and toss potato spirals using tongs. Return basket to the air fryer and continue cooking, tossing occasionally, until golden brown, 10 to 12 minutes."
    },
    {
      "position": 7,
      "text": "Reduce temperature to 360 degrees F (180 degrees C) and repeat with remaining potato spirals."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

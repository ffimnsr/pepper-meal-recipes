  "id": "7767b045-88f3-56f2-a66f-0edce7efd45b",
  "slug": "indian-okra-in-the-air-fryer-kurkuri-bhindi",
  "name": "Kurkuri Bhindi (Crispy Okra) in the Air Fryer",
  "recipe_type": "side",
  "brief_description": "Okra is coated with flavorful Indian spices and cooked in the air fryer until nice and crispy in this recipe for kurkuri bhindi.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Place thawed okra in a bowl. Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a skillet over medium heat. Stir in gram flour, salt, chili powder, coriander, chaat masala, cumin, and amchoor; cook and stir until fragrant, about 2 minutes. Remove from the heat and add to okra; mix until okra is fully coated. Transfer okra to the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook in the preheated air fryer for 5 minutes. Flip okra and continue to cook, flipping in 5-minute intervals, until cooked through and crispy, 5 to 10 more minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

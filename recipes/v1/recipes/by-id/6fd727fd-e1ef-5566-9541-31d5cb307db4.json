  "id": "6fd727fd-e1ef-5566-9541-31d5cb307db4",
  "slug": "banana-egg-waffles",
  "name": "Banana Egg Waffles",
  "recipe_type": "breakfast",
  "brief_description": "No flour to be found in these gluten-free chocolate chip-filled waffles made with eggs and mashed banana.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions and prepare surfaces with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk eggs, bananas, and vanilla extract together in a large bowl until smooth. Stir peanut butter into the egg mixture until smooth. Fold oats and chocolate chips through the egg mixture."
    },
    {
      "position": 3,
      "text": "Cook batter on waffle iron according to manufacturer's instructions until golden brown, about 3 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,

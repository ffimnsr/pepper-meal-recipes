  "id": "da39f553-1cd7-58b1-a4f7-e3da4897a78b",
  "slug": "vegan-pineapple-upside-down-cake",
  "name": "Vegan Pineapple Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "Perfectly moist and with just the right amount of sweetness, this vegan pineapple upside-down cake is easy to make and perfect to serve after any meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Drain pineapple juice from the can into a 1-cup liquid measure and add enough water to make 1 cup; set aside. Dump pineapple chunks into the bottom of a 12-inch springform pan and sprinkle brown sugar over top."
    },
    {
      "position": 3,
      "text": "Combine pineapple juice mixture with oil, vanilla, and vinegar in a bowl."
    },
    {
      "position": 4,
      "text": "Mix flour, sugar, cinnamon, baking soda, and salt together in a large bowl. Mix in wet ingredients, stirring quickly to combine and get out any big lumps. Pour into the the pan on top of the pineapples and brown sugar."
    },
    {
      "position": 5,
      "text": "Bake until the top is golden and a toothpick inserted in the center comes out clean, 25 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool in the pan, about 30 minutes. Loosen the sides of the cake from the pan, then remove the side ring. Place a serving plate on top and flip cake over. Remove the pan bottom and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "968ecf7b-5e0f-564f-b26c-453c7110f377",
  "slug": "sous-vide-maple-chipotle-bbq-pork-chops",
  "name": "Sous Vide Maple Chipotle BBQ Pork Chops",
  "recipe_type": "dessert",
  "brief_description": "Flavorful and juicy pork chops served with a maple-chipotle-BBQ sauce that is sweet, spicy, and savory all at once.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare a thermocirculator and water bath according to manufacturer's directions. Set thermocirculator to 135 degrees F(57 degrees C) (if you want the pork cooked medium instead of medium-rare, set to 145 degrees F (62 degrees C)), and allow water bath to come up to temperature."
    },
    {
      "position": 2,
      "text": "Stir together ketchup, melted butter, vinegar, maple syrup, jalapeno, mustard, chipotles, adobo sauce, Worcestershire, 1 teaspoon salt, chili powder, onion powder, garlic powder, and smoked paprika for the sauce in a bowl. You should have about 2 cups sauce."
    },
    {
      "position": 3,
      "text": "Season all chops evenly with remaining 1 1/2 teaspoons salt and pepper and place chops in an even layer in a large vacuum sealable bag. Pour 1 cup of the sauce into bag. Cover and chill remaining sauce. Massage bag to be sure each chop is evenly coated in sauce, then seal bag with a vacuum sealer according to manufacturer's directions."
    },
    {
      "position": 4,
      "text": "Transfer vacuum-sealed chops to warm water bath with thermocirculator, cover vessel with aluminum foil to reduce evaporation. Cook 40 minutes (meat will be 135 degrees F to 145 degrees C (57 to 62 degrees C) when done depending on desired doneness)."
    },
    {
      "position": 5,
      "text": "Remove bag from water bath and transfer meat from bag onto a rimmed baking sheet and drizzle with canola oil."
    },
    {
      "position": 6,
      "text": "Preheat a grill or a grill pan to medium-high (400 degrees F to 450 degrees F (200 degrees C to 230 degrees C))."
    },
    {
      "position": 7,
      "text": "Grill meat, uncovered, until grill marks appear, basting with 1/2 cup of the reserved sauce, 1 to 2 minutes per side. Serve chops with remaining 1/2 cup sauce and a sprinkle of cilantro. Recipe developed by Karen Rankin"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "11e1e228-67dc-5a5e-8833-0c35e1736029",
  "slug": "grandpas-classic-coney-sauce",
  "name": "Grandpa's Classic Coney Sauce",
  "recipe_type": "side",
  "brief_description": "Coney sauce is ground beef simmered with tangy flavors that gets served on hot dogs with chopped onion. A tasty, nostalgic recipe for any occasion.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place ground beef and onion in a large skillet over medium-high heat. Cook, stirring to crumble, until beef is browned; drain."
    },
    {
      "position": 3,
      "text": "Transfer the beef and onion to a slow cooker and stir in ketchup, sugar, vinegar, and mustard. Season with Worcestershire, salt, celery seed, and pepper."
    },
    {
      "position": 4,
      "text": "Cover and simmer on Low for 3 hours before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 10,

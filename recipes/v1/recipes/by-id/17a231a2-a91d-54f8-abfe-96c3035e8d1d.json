  "id": "17a231a2-a91d-54f8-abfe-96c3035e8d1d",
  "slug": "cream-scones",
  "name": "Cream Scones",
  "recipe_type": "dessert",
  "brief_description": "Scones are very common in the United Kingdom. This easy, tasty cream scones recipe pairs wonderfully with grape or blackberry jelly for extra sweetness.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, sugar, and salt together into a large bowl. Add cream, butter, and milk; stir until a spongy dough forms. Turn dough out onto a lightly floured surface; pat into a rectangle about 3/4-inch thick and 7-inches wide. Cut into 6 triangles; arrange on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, 10 to 13 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

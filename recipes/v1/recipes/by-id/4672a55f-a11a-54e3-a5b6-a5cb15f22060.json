  "id": "4672a55f-a11a-54e3-a5b6-a5cb15f22060",
  "slug": "soft-and-chewy-peanut-butter-cookies",
  "name": "Soft and Chewy Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cookies are incredible... and they always turn out!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine flour, soda, and salt. Mix well with a wire whisk set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, blend sugars, using an electric mixer set at medium speed. Add butter, and mix to form a grainy paste, scraping the sides of the bowl. Add eggs, peanut butter and vanilla and mix at medium speed until light and fluffy."
    },
    {
      "position": 4,
      "text": "Add the flour mixture and mix at low speed until just mixed."
    },
    {
      "position": 5,
      "text": "Drop by rounded spoonfuls onto an ungreased cookie sheet. With a wet fork gently press cookies in a crisscrossed pattern. Bake for 18-22 minutes or until slightly brown along edges."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": null,

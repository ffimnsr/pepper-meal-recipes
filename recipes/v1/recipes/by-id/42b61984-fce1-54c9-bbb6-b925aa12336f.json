  "id": "42b61984-fce1-54c9-bbb6-b925aa12336f",
  "slug": "lemon-garlic-tilapia",
  "name": "Lemon Garlic Tilapia",
  "recipe_type": "main",
  "brief_description": "This healthy tilapia recipe features fresh fish fillets with lemon and a bit of butter seasoned with garlic and parsley and baked to flaky perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Rinse tilapia fillets under cool water, and pat dry with paper towels."
    },
    {
      "position": 3,
      "text": "Place fillets in the prepared baking dish. Pour lemon juice over fillets, then drizzle butter on top. Sprinkle with garlic, parsley, and pepper."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until fish is white and flakes when pulled apart with a fork, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

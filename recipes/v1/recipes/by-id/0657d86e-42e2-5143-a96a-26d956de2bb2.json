  "id": "0657d86e-42e2-5143-a96a-26d956de2bb2",
  "slug": "waffled-falafel",
  "name": "Waffled Falafel",
  "recipe_type": "main",
  "brief_description": "Waffled falafel is a delicious twist on a classic. Falafel is cooked on a waffle iron to make a fun way to enjoy this favorite to serve with toppings.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions. Spray the inside of the waffle iron with cooking spray."
    },
    {
      "position": 2,
      "text": "Process garbanzo beans in a food processor until coarsely chopped. Add onion, egg whites, cilantro, parsley, garlic, flour, cumin, salt, coriander, black pepper, cayenne pepper, and cardamom to garbanzo beans. Pulse, scraping down the sides of the bowl occasionally, until falafel batter resembles a coarse meal. Pour batter into a bowl and stir with a fork."
    },
    {
      "position": 3,
      "text": "Spoon about 1/4 cup falafel batter onto each section of the preheated waffle iron. Cook until evenly browned, about 5 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

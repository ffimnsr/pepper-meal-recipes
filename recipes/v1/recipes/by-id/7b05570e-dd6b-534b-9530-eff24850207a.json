  "id": "7b05570e-dd6b-534b-9530-eff24850207a",
  "slug": "smoked-gouda-mac-and-cheese",
  "name": "Smoked Gouda Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "This smoked Gouda mac and cheese is marvelously smooth and creamy with a bit of a bite. It\u2019s an elevated version of a true comfort-food classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a casserole dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add shell pasta and cook, stirring occasionally, until tender yet firm to the bite, about 9 minutes."
    },
    {
      "position": 3,
      "text": "While the pasta is cooking, melt butter in a small saucepan over medium-low heat. Whisk in flour and stir until mixture becomes paste-like and light golden brown, 2 to 4 minutes. Gradually whisk in milk, salt, and pepper, then bring to a simmer over medium heat. Gradually whisk in shredded cheese; cook, whisking constantly, until sauce is smooth and thick enough to coat the back of a spoon, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Drain pasta and transfer to a large bowl. Pour cheese sauce over top and mix until thoroughly combined. Transfer to the prepared casserole dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

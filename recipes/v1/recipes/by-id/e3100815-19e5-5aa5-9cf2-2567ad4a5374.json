  "id": "e3100815-19e5-5aa5-9cf2-2567ad4a5374",
  "slug": "chef-johns-almond-arugula-pesto",
  "name": "Arugula Pesto",
  "recipe_type": "side",
  "brief_description": "Chef John's arugula pesto is a delicious blend of fresh arugula leaves, almonds, garlic, and olive oil to make a rich vegan sauce exploding with flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add arugula and cook until bright green, about 30 seconds. Remove arugula to a bowl full of ice water for several minutes until cold. Drain and wring out arugula."
    },
    {
      "position": 2,
      "text": "Pulse arugula, olive oil, almonds, and garlic together in a blender, scraping down the sides, until mixture just becomes a coarse puree. Pour puree into a bowl and season with salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

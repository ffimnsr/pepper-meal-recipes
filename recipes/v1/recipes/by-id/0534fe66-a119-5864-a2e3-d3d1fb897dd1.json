  "id": "0534fe66-a119-5864-a2e3-d3d1fb897dd1",
  "slug": "lacy-oatmeal-cookies",
  "name": "Lacy Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "These buttery oatmeal lace cookies are delicate, crispy treats with a chewy center. Great served with ice cream or rolled up and dipped in chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Cover baking sheets with foil, then coat the foil with a nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Combine oats, flour, salt, and baking powder in a medium bowl. Beat sugar and butter in a large bowl until fluffy. Beat in egg and vanilla. Mix in flour and oat mixture until just combined. Drop dough by teaspoonfuls onto the prepared baking sheets, 2 \u00bd inches apart."
    },
    {
      "position": 3,
      "text": "Bake cookies in the preheated oven until edges turn golden, about 10 to 12 minutes. Cool cookies on baking sheet, about 10 to 15 minutes, then peel them off with your fingers. Repeat with remaining dough, re-spraying baking sheets with nonstick cooking spray between batches."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

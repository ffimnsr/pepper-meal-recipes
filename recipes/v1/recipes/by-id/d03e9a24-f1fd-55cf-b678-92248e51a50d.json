  "id": "d03e9a24-f1fd-55cf-b678-92248e51a50d",
  "slug": "lemon-oatmeal-bars",
  "name": "Lemon Oatmeal Bars",
  "recipe_type": "dessert",
  "brief_description": "Satisfy your dessert cravings for tangy lemon bars and chewy oatmeal cookies with this best-of-both-worlds lemon oatmeal bar recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8-inch square baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix brown sugar and butter in a large bowl until combined. Mix flour, oats, baking powder, and salt together in a separate bowl. Add to butter mixture and mix until combined. Press half of the oat mixture in the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes."
    },
    {
      "position": 4,
      "text": "While crust is baking, mix condensed milk, lemon juice, lemon extract, and almond extract in a small bowl."
    },
    {
      "position": 5,
      "text": "Pour lemon mixture over the baked crust and spread evenly. Top with remaining oat mixture and gently pat into lemon mixture."
    },
    {
      "position": 6,
      "text": "Return to the oven and bake until filling has set and top crust is golden brown, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and place on a wire rack to cool completely, about 30 minutes. Place in the refrigerator until chilled, about 2 hours. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

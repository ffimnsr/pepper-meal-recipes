  "id": "13a875ff-c99d-5f79-956c-f7f7fb1614b8",
  "slug": "brookie-bites-recipe-12014051",
  "name": "Brookie Bites",
  "recipe_type": "dessert",
  "brief_description": "Brookie bites are the easiest treat to make, and so, so good! A box of brownie mix, some refrigerated chocolate chip cookie dough, an egg and some oil, and you are on your way. Use a mini muffin pan for these goodies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 24-cup mini muffin pan or line pan with mini cupcake liners."
    },
    {
      "position": 2,
      "text": "Prepare brownie mix according to package directions with eggs, oil and water. Divide brownie mix evenly among muffin cups."
    },
    {
      "position": 3,
      "text": "Place about 1 heaping teaspoon of cookie dough in the center of each brownie filled cup and press it lightly down into the center."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until just set, about 12 minutes. Let cool to room temperature, or at least 15 minutes before removing from pan and serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

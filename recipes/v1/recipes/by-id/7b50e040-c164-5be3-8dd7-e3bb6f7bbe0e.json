  "schema_version": 1,
  "id": "7b50e040-c164-5be3-8dd7-e3bb6f7bbe0e",
  "slug": "quick-and-easy-shrimp-scampi",
  "name": "Quick and Easy Shrimp Scampi",
  "recipe_type": "main",
  "brief_description": "A delicious and quick way to enjoy shrimp - even on a busy weeknight!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil, add pasta, and cook until al dente. Drain pasta, and set aside."
    },
    {
      "position": 3,
      "text": "In a large skillet, melt butter over medium heat. Add most of the garlic, keeping some for later. Coat the garlic completely with butter. Do not let the garlic brown. Add shrimp, and toss to coat. Immediately remove pan from heat; shrimp will not be cooked yet."
    },
    {
      "position": 4,
      "text": "Sprinkle the shrimp with breadcrumbs (enough to coat the shrimp), and transfer the entire mixture to a medium casserole dish. Pour wine and the lemon juice over the shrimp. Cover, and bake at 350 degrees F (175 degrees C) for 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove cover, and bake an additional 5 minutes."
    },
    {
      "position": 6,
      "text": "In a small saucepan heat olive oil with remaining garlic. Toss the pasta with the olive oil and garlic mixture. Serve the shrimp over the pasta with additional lemon slices on the side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

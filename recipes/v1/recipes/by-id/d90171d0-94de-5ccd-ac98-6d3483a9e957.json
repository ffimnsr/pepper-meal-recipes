  "id": "d90171d0-94de-5ccd-ac98-6d3483a9e957",
  "slug": "white-texas-sheet-cake",
  "name": "White Texas Sheet Cake",
  "recipe_type": "dessert",
  "brief_description": "This white Texas sheet cake with pecan frosting is a crowd-pleasing dessert that\u2019s perfect for potlucks and parties, and it\u2019s easy to make a day ahead.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 10x15-inch baking pan."
    },
    {
      "position": 2,
      "text": "Bring butter and water to a boil in a large saucepan. Remove from the heat; stir in flour, white sugar, eggs, sour cream, almond extract, salt, and baking soda until smooth. Pour the batter into the prepared baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the cake is lightly golden and a toothpick inserted into the center comes out clean, 20 to 22 minutes. Cool for 20 minutes."
    },
    {
      "position": 4,
      "text": "While the cake cools, prepare the frosting. Bring butter and milk to a boil in a saucepan. Remove from the heat; stir in confectioners\u2019 sugar and almond extract until smooth, then stir in pecans. Spread the frosting over the warm cake immediately, as it sets quickly. Garnish with additional chopped pecans, if desired."
    }
  ],
  "servings": 24,

  "id": "2362767f-68b7-58a2-a3a4-f281f014186c",
  "slug": "chocolate-covered-key-lime-pie-pops-recipe-12024627",
  "name": "Chocolate-Covered Key Lime Pie Pops",
  "recipe_type": "dessert",
  "brief_description": "These chocolate-covered key lime pie pops turn slices of mini key lime pie into a fun dessert on a stick. Dipped in Magic Shell chocolate topping and chilled until the coating hardens, they\u2019re an adorable treat that\u2019s as easy to make as it is to eat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut each pie into 6 slices and insert a popsicle stick into the wide end of each slice."
    },
    {
      "position": 2,
      "text": "Pour bottle of Magic Shell into a small bowl."
    },
    {
      "position": 3,
      "text": "Carefully dip each slice into the Magic Shell until covered. Allow excess to drip off, then place on a plate or baking sheet."
    },
    {
      "position": 4,
      "text": "Place in refrigerator or freezer for 5 to 10 minutes or until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

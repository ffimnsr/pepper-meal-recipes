  "id": "80bbaf26-936f-5d89-b343-25be0ad3886a",
  "slug": "unbelievable-spinach-calzones",
  "name": "Unbelievable Spinach Calzones",
  "recipe_type": "salad",
  "brief_description": "Delicious, satisfying, and very easy to make. My kids will even eat spinach this way! We serve them with warmed spaghetti sauce to dip them in and a salad. Yum!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the ricotta cheese, eggs, Italian seasoning, mozzarella cheese, Parmesan cheese and spinach. Set aside."
    },
    {
      "position": 3,
      "text": "Divide the bread dough into 8 pieces and roll each piece out to about an 8 inch circle. Spoon about 1/2 cup of the ricotta filling onto each circle, fold over and seal the edges. Place onto a greased cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake for 30 minutes in the preheated oven, or until nicely browned on the tops and bottoms."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

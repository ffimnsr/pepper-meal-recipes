  "slug": "cretons",
  "name": "Cretons",
  "recipe_type": "breakfast",
  "brief_description": "Cretons, a minced pork p\u00e2t\u00e9, is a breakfast staple for many French Canadians in parts of Quebec. It's usually spread on little toasts or multigrain bread.",
  "cuisine": "French Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground pork, milk, onion, garlic, cloves, allspice, salt, and pepper in a large saucepan over medium heat for about 1 hour. Stir in bread crumbs and cook for 10 more minutes. Adjust seasonings to taste. Transfer to a small container and keep refrigerated."
    }
  ],

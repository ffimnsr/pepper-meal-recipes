  "id": "8859ced0-3190-54ba-8337-071a92bf9e3c",
  "slug": "kheer-rice-pudding",
  "name": "Kheer (Rice Pudding)",
  "recipe_type": "dessert",
  "brief_description": "Kheer is a sweet and festive Indian rice pudding dessert made with basmati rice, coconut milk, raisins, cardamom, pistachios, and toasted almonds.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring coconut milk, milk, and sugar to a boil in a large saucepan over medium heat. Add rice, reduce the heat to low, and simmer until mixture thickens and rice is tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir in raisins, cardamom, and rose water; cook for a few more minutes. Ladle into serving bowls and garnish with almonds and pistachios."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

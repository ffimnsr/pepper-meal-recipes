  "slug": "watermelon-tajin-skewers-recipe-12009895",
  "name": "Watermelon Tajin Skewers",
  "recipe_type": "appetizer",
  "brief_description": "These watermelon Tajin skewers are quick and easy to assemble and always a hit at summer picnics, parties, and poolside gatherings. Refreshing, colorful, and easy to customize with more or less Taj\u00edn, they\u2019re a fun snack that both kids and adults will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Thread watermelon, pineapple, and basil leaves onto skewers. Give a lime wedge a good squeeze over the skewers, and sprinkle with Tajin."
    },
    {
      "position": 2,
      "text": "Place the skewers onto a platter, garnish with lime wedges, and serve."
    }
  ],

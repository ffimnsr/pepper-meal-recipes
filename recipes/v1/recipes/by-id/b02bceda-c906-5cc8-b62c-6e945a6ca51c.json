  "id": "b02bceda-c906-5cc8-b62c-6e945a6ca51c",
  "slug": "holiday-cranberry-and-apple-compote",
  "name": "Holiday Cranberry and Apple Compote",
  "recipe_type": "drink",
  "brief_description": "Fresh cranberries and apples simmer together in pumpkin-spiced orange juice to produce this thick compote that works with turkey, ham, or even pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine orange juice, apples, cranberries, white sugar, brown sugar, and pumpkin pie spice in a saucepan over medium-high heat. Bring to a boil, reduce heat, and simmer until apples are tender and sauce has thickened slightly, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Transfer sauce to a dish; stir in softened butter and refrigerate for 1 to 2 hours. Sauce will continue to thicken."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 25,

  "id": "a1a84942-dbde-5b9a-8ae1-1fa16d818457",
  "slug": "fish-tacos",
  "name": "Fish Tacos",
  "recipe_type": "main",
  "brief_description": "These easy fish tacos made with perfectly seasoned crispy cod are served in tortillas and topped with a citrusy mayo and shredded cabbage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the beer batter: Combine flour, cornstarch, baking powder, and salt in a large bowl. Blend beer and egg in a separate bowl, then quickly stir into flour mixture until combined with a few lumps remaining."
    },
    {
      "position": 2,
      "text": "To make the sauce: Mix yogurt and mayonnaise together in a medium bowl; gradually stir in fresh lime juice until consistency is slightly runny. Season with jalape\u00f1o, capers, cayenne, oregano, cumin, and dill."
    },
    {
      "position": 3,
      "text": "To make the fish tacos: Heat oil in a deep-fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Dust fish pieces lightly with flour. Set aside."
    },
    {
      "position": 5,
      "text": "Dip floured fish pieces into beer batter. Set aside."
    },
    {
      "position": 6,
      "text": "Fry battered fish in hot oil until crisp and golden brown. Drain on paper towels. Lightly fry tortillas in hot oil until just crisped, but not too crisp. Drain on paper towels."
    },
    {
      "position": 7,
      "text": "Place fried fish in tortillas; top with shredded cabbage and sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

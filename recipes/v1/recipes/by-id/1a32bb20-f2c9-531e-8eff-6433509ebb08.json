  "id": "1a32bb20-f2c9-531e-8eff-6433509ebb08",
  "slug": "anise-seed-borrachio-cookies",
  "name": "Anise Seed Borrachio Cookies",
  "recipe_type": "dessert",
  "brief_description": "This Spanish anise seed borrachio sugar cookie recipe is easy to make, and flavored with vanilla, anise, and rum. They're tender and melt-in-your-mouth.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place rum and anise seeds in a small bowl. Set aside to marinate, preferably overnight."
    },
    {
      "position": 2,
      "text": "Beat butter, sugar, and vanilla extract together in a medium bowl until smooth; stir in rum mixture. Whisk in egg. Combine flour, cloves, baking powder, and salt in a bowl; stir into butter mixture until well blended. Cover the bowl and chill in the refrigerator, about 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease baking sheets."
    },
    {
      "position": 4,
      "text": "Roll out dough on a lightly floured surface to \u215b inch thickness; cut into desired shapes using cookie cutters. Place cookies on the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown at edges, about 10 minutes. Cool on baking sheets, 3 to 5 minutes, before transferring to wire racks to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

  "id": "060b0552-55a6-5e25-ba14-beab120259db",
  "slug": "vegan-sweet-potato-and-bean-burritos",
  "name": "Vegan Sweet Potato and Bean Burritos",
  "recipe_type": "dessert",
  "brief_description": "These flavorful and filling vegan burritos are filled with sweet potatoes, onions, brown rice, and refried beans. Perfect as-is or topped with guacamole or your favorite sauce.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss sweet potatoes, onion, olive oil, and taco seasoning together in a bowl. Spread out onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven, about 30 minutes or until desired level of doneness."
    },
    {
      "position": 4,
      "text": "Spread 1/4 of the beans down the center of each tortilla. Top each tortilla with 1/4 cup rice, 1/4 of the vegetable mixture, and 1 tablespoon salsa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "e05329c3-5ffc-54f6-8ddf-5223559e2970",
  "slug": "fantastic-focaccia-bread",
  "name": "Fantastic Focaccia Bread",
  "recipe_type": "main",
  "brief_description": "This easy to make focaccia bread is terrific for sandwich making.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, dissolve honey and yeast in warm water. Let stand until creamy, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add 1 cup flour, salt, and 3 tablespoons olive oil to the yeast mixture. Stir until combined and then work in the last cup of flour. Knead the dough until smooth, elastic, and soft, about 7 minutes. Add only enough flour to keep the dough from being sticky. Lightly oil a large bowl, place the dough in the bowl and turn to coat with oil. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 1 hour."
    },
    {
      "position": 3,
      "text": "Deflate the dough and turn it out onto a lightly floured surface. Roll out the dough into a rectangle, about 1/2 inch thick. Place in greased 9x13 inch pan or baking sheet. Cover and let rise until doubled in volume, about 40 minutes. Meanwhile, preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Poke dimples in the bread and drizzle 1 tablespoon of the olive oil on top. Bake at 400 degrees for 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 105,

  "id": "6838b6d2-be4b-55cc-9c85-fe5493034afe",
  "slug": "prime-rib-roast-on-charcoal-grill",
  "name": "Prime Rib Roast on Charcoal Grill",
  "recipe_type": "main",
  "brief_description": "This garlic-and-rosemary-rubbed prime rib is charcoal grilled with wood chips for smokier results than your average baked roast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix olive oil, garlic, pepper, rosemary, salt, and beef base together in a bowl. Cover beef roast completely with the rub."
    },
    {
      "position": 2,
      "text": "Heat a charcoal smoker to 350 degrees F (175 degrees C) on indirect heat. Place the roast directly on the grill grate with a drip pan underneath. Add wood chips according to manufacturer's directions."
    },
    {
      "position": 3,
      "text": "Smoke until an instant-read thermometer inserted into the center of the roast reads at least 125 degrees F (52 degrees C), about 2 hours and 30 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 15,

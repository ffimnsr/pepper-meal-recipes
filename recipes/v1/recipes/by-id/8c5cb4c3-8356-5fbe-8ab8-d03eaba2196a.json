  "schema_version": 1,
  "id": "8c5cb4c3-8356-5fbe-8ab8-d03eaba2196a",
  "slug": "passover-chocolate-torte",
  "name": "Passover Chocolate Torte",
  "recipe_type": "dessert",
  "brief_description": "This Passover flourless chocolate cake is made with kosher margarine, eggs, ground almonds, and plenty of chocolate for a rich and fudgy dessert.",
  "cuisine": "World American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line bottom and sides of a 9-inch springform pan with foil. Grease foil."
    },
    {
      "position": 2,
      "text": "Melt margarine and chocolate over low heat. Stir until smooth and let cool."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a medium-sized mixing bowl until stiff; about 2 minutes. Beat egg yolks and sugar together in a separate bowl until thick and pale; about 1 minute. Blend in chocolate mixture and stir in ground almonds. Fold beaten whites, 1/3 at a time, into chocolate until no streaks of white remain; transfer into prepared pan."
    },
    {
      "position": 4,
      "text": "Place an 8-inch baking pan with 1 inch of water in it on the bottom rack of the oven (this will create steam and make the torte more moist)."
    },
    {
      "position": 5,
      "text": "Bake torte on center rack in the preheated oven for 45 to 50 minutes, or until sides begin to pull away from pan and top is set in center. Cover the torte loosely with foil for the last 20 minutes of baking. Note: Don\u2019t worry if the cake cracks because the top will be on the bottom later."
    },
    {
      "position": 6,
      "text": "Cool on wire rack for 10 minutes and then carefully remove sides of pan. Invert onto a serving plate and cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

  "id": "7ab1b137-a45c-56f2-aa90-5d10ece0bed0",
  "slug": "classic-whiskey-sour",
  "name": "Classic Whiskey Sour",
  "recipe_type": "drink",
  "brief_description": "This lemon whiskey sour is made with your favorite whiskey, lemon juice, and simple syrup with maraschino cherries in this classic homemade cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine whiskey, lemon juice, and simple syrup in a shaker. Fill with ice. Cover and shake until the shaker is frosty, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Strain into 3 martini glasses and garnish each glass with a maraschino cherry."
    }
  ],
  "servings": 3,

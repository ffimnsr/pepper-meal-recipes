  "slug": "watermelon-sangria",
  "name": "Watermelon Sangria",
  "recipe_type": "drink",
  "brief_description": "This watermelon sangria cocktail with white wine, vodka, orange liquor, simple syrup, lime, and fresh fruit tastes just like summertime in a glass!",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Place 9 cups of watermelon cubes in a blender; blend on high until very smooth. Strain juice through a mesh strainer into a large pitcher."
    },
    {
      "position": 2,
      "text": "Pour wine, vodka, triple sec, and simple syrup into the pitcher; stir to combine. Add remaining 3 cups of watermelon cubes, orange sections, blueberries, and lime quarters; chill sangria for 4 hours before serving."
    }
  ],
  "servings": 16,

  "slug": "ramen-and-cabbage-salad-recipe-6605373",
  "name": "Ramen and Cabbage Salad",
  "recipe_type": "salad",
  "brief_description": "This ramen and cabbage salad with Asian-inspired flavors makes a sensational summer or potluck dish. Cabbage combines with green onions, toasted ramen noodles, almonds, and sesame seeds.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Brown ramen noodles, almonds, and sesame seeds with melted butter in a medium skillet over low heat. Once browned, take off heat and cool."
    },
    {
      "position": 2,
      "text": "Bring oil, sugar, and vinegar to a boil in a small saucepan for 1 minute. Cool. Add soy sauce."
    },
    {
      "position": 3,
      "text": "Combine cabbage and green onions in a large bowl. Add noodle mixture and soy sauce mixture. Toss to coat and serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

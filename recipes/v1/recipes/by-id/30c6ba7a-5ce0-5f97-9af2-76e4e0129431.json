  "id": "30c6ba7a-5ce0-5f97-9af2-76e4e0129431",
  "slug": "easy-baked-ham-steaks",
  "name": "Easy Baked Ham Steaks",
  "recipe_type": "main",
  "brief_description": "This baked ham steak recipe makes a quick and easy dinner that satisfies the whole family. Serve it with potatoes or mac and cheese for a tasty meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix water, brown sugar, Worcestershire sauce, and cloves in a baking dish. Arrange ham steaks in baking dish, coating with sugar mixture. Add more water as needed to cover ham."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until ham is tender, 35 to 45 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

  "id": "93571d41-8f61-507b-9a9e-c9c98b14b0e1",
  "slug": "cheesy-garlic-mashed-potatoes-recipe-8752836",
  "name": "Cheesy Garlic Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These cheesy garlic mashed potatoes are so delicious, loaded with cheese, sour cream, and heavy cream, and mixed with a melted garlic butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain; mash potatoes with a potato masher."
    },
    {
      "position": 2,
      "text": "Place butter and garlic in a large microwavable bowl. Microwave for 30 second intervals until the butter is melted and garlic becomes fragrant. Stir into mashed potatoes. Add cheese, sour cream, heavy whipping cream, salt, and pepper. Garnish with green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,

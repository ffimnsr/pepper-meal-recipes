  "slug": "coconut-crust",
  "name": "Coconut Crust",
  "recipe_type": "dessert",
  "brief_description": "Fill this easy, two-ingredient coconut pie crust with your favorite pie filling, or skip the filling entirely and eat it by itself. It\u2019s that delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix coconut and butter together in a bowl until well combined. Press mixture into an 8- or 9-inch pie plate."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden, about 15 minutes."
    }
  ],

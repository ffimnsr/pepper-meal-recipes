  "id": "d909c05e-382d-5e94-a29f-ab81effd70c2",
  "slug": "leek-and-potato-soup",
  "name": "Leek and Potato Soup",
  "recipe_type": "soup",
  "brief_description": "Creamy and comforting for a cold winter day, this leek and potato soup is ready to serve in under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add leeks and cook and stir until softened, about 5 minutes. Stir in celery; cook and stir until softened, about 5 minutes more. Add garlic; cook and stir until fragrant, about 1 minute. Stir in potatoes, vegetable broth, and water; bring to a boil. Reduce heat to medium-low and simmer until potatoes are tender and easily pierced with a fork, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Blend using an immersion blender or in a regular blender in batches. Stir in heavy cream until heated through. Season to taste with salt."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

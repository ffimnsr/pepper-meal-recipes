  "id": "6fda40c4-bc0f-50cb-94f5-380098196f3f",
  "slug": "harissa-butternut-squash-soup-recipe-8781939",
  "name": "Harissa Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "In this harissa butternut squash soup, sweet, creamy butternut squash meets the bold, smoky heat of harissa.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper. Toss butternut squash, onion, and whole garlic with olive oil. Spread out on the prepared baking sheet."
    },
    {
      "position": 2,
      "text": "Roast in the preheated oven until tender and slightly caramelized, 25 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Place cooked vegetables into the jar of a blender. If ingredients are hot, fill blender no more than halfway full, and hold lid down with a potholder. You may have to work in batches. Add broth, harissa paste, cumin, smoked paprika, and brown sugar. Blend until smooth"
    },
    {
      "position": 4,
      "text": "Pour blender contents into a stockpot. Bring to a boil, then reduce heat to a simmer. Cook for 10 minutes to allow the flavors to meld. Stir in heavy cream and season with salt and pepper. Ladle into bowls and serve with a swirl of heavy cream, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

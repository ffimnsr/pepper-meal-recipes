  "id": "3f6d905a-aa5f-5771-819b-d90c03744429",
  "slug": "grandma-leachs-fruitcake",
  "name": "Grandma Leach's Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "This super moist fruitcake packed with juicy raisins, dates, candied mixed fruit, nuts, and warm spices is easy to make for a classic Christmas treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Grease a 9-inch tube pan and one 9x5 inch loaf pan."
    },
    {
      "position": 2,
      "text": "Sift flour, sugar, cocoa, cornstarch, baking soda, salt, cinnamon, and cloves into a large bowl."
    },
    {
      "position": 3,
      "text": "Stir in applesauce and oil, then mix in raisins, dates, mixed fruit, and 2 cups of walnuts."
    },
    {
      "position": 4,
      "text": "Pour into the prepared pans, about 3/4 full."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the crown of the cake comes out clean, about 1 hour."
    },
    {
      "position": 6,
      "text": "Cool cake and decorate with walnut halves and candied cherry halves."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

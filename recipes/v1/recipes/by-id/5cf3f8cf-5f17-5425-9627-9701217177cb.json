  "id": "5cf3f8cf-5f17-5425-9627-9701217177cb",
  "slug": "whipped-shortbread-cookies",
  "name": "Whipped Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "This whipped shortbread cookies recipe is easy to make with simple ingredients like butter, flour, and sugar for rich, melt-in-your-mouth cookies.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat flour, butter, and confectioners\u2019 sugar together in a large bowl with an electric mixer on medium speed until very light and fluffy, 8 to 10 minutes; dough should look pale, soft, and airy."
    },
    {
      "position": 3,
      "text": "Drop tablespoonfuls of dough 2 inches apart on the prepared baking sheets. Top each cookie with a cherry quarter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bottoms are light golden, 18 to 20 minutes. Cool on the baking sheets for 5 minutes; transfer to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

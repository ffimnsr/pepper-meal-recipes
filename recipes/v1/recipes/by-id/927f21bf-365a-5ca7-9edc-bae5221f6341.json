  "slug": "blender-chocolate-mousse-recipe-8648953",
  "name": "Blender Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "This blender chocolate mousse, with espresso powder added to amp up the intensity of the chocolate flavor, is for all of you chocolate lovers\u2013simple, easy, and delicious.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Combine heavy cream, cocoa powder, confectioner's sugar, espresso powder, vanilla extract, and salt in a powerful blender such as a Vitamix. Blend for 30 seconds. Chill at least 1 hour to let flavors meld."
    }
  ],

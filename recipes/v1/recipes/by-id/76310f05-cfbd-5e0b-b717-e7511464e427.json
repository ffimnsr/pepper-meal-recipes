  "id": "76310f05-cfbd-5e0b-b717-e7511464e427",
  "slug": "oolong-orange-and-whiskey-punch",
  "name": "Oolong, Orange, and Whiskey Punch",
  "recipe_type": "drink",
  "brief_description": "Balanced with orange and a light touch of spice, this punch is whiskey-forward without being overpowering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a saucepan over high heat. Stir in sugar, cinnamon stick, and star anise. Remove from heat and add tea bags. Let steep for 3 minutes (or according to package directions for strongest tea). Remove tea bags. Let cool to room temperature, about 1 hour. Remove and discard cinnamon stick and star anise."
    },
    {
      "position": 2,
      "text": "Stir together tea mixture, orange juice, whiskey, and lemon juice in a punch bowl or pitcher. Chill until cold, about 2 hours or up to overnight."
    },
    {
      "position": 3,
      "text": "Garnish with tangerine slices and additional star anise. Ladle into ice-filled glasses. Top each with a tangerine slice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "cb773136-4d65-5128-ae83-a5363fb9aafe",
  "slug": "hamburger-stew-with-cabbage",
  "name": "Hamburger Stew with Cabbage",
  "recipe_type": "soup",
  "brief_description": "Try this comforting hamburger soup with cabbage on a cold night. After browning the beef, add the remaining ingredients and simmer to perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef into a large soup pot; cook and stir over medium-high heat until browned and crumbly, about 5 minutes. Drain grease. Add bell pepper, onion, and celery. Cook and stir for 5 minutes."
    },
    {
      "position": 2,
      "text": "Increase heat to high. Add kidney beans, tomatoes, cabbage, beef broth, water, Worcestershire sauce, bouillon, and garlic; stir to combine. Bring to a boil, reduce heat, and simmer for 30 minutes."
    },
    {
      "position": 3,
      "text": "Ladle soup into bowls and season with salt."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

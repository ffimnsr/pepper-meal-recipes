  "id": "474fd0a3-6850-5ddd-8939-6504711e3f0e",
  "slug": "chunky-cinnamon-orange-applesauce",
  "name": "Chunky Cinnamon-Orange Applesauce",
  "recipe_type": "drink",
  "brief_description": "Spiced chunky applesauce is flavored with cinnamon, nutmeg, orange juice, and lemon zest for a must-have accompaniment to holiday latkes. Serve it warm or chilled.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Cook apples and orange juice in a large heavy pot over medium heat, stirring frequently, until apples begin to soften, about 10 minutes. Stir white sugar, brown sugar, cinnamon, orange zest, lemon zest, nutmeg, and lemon juice into apples. Cook, stirring often, until applesauce is chunky and thickened, about 25 minutes. Serve warm or chilled."
    }
  ],

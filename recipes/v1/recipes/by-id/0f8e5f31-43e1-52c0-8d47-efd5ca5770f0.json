  "id": "0f8e5f31-43e1-52c0-8d47-efd5ca5770f0",
  "slug": "individual-turkey-pot-pies",
  "name": "Individual Turkey Pot Pies",
  "recipe_type": "main",
  "brief_description": "These mini turkey pot pies can be topped any way you like \u2014 puff pastry, pie crust, or mashed potatoes \u2014 and make the most of your leftover turkey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Cook onion, celery, flour, rosemary, thyme, and pepper in melted butter for 3 minutes, stirring constantly."
    },
    {
      "position": 3,
      "text": "Slowly add broth, stirring until smooth. Cook, stirring constantly, until thickened. Stir in turkey, green beans, and peas and carrots. Spoon mixture into four (10-ounce) ramekins."
    },
    {
      "position": 4,
      "text": "Cut 4 circles out of puff pastry sheet, using outer edge of ramekin as a guide. Place pastry over turkey mixture in each ramekin. Blend egg and water in a small bowl; brush over pastry. Place the ramekins on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until pastry is golden brown and puffed, about 25 minutes. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

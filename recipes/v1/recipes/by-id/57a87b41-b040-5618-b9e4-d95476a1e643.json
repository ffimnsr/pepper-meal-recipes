  "id": "57a87b41-b040-5618-b9e4-d95476a1e643",
  "slug": "peanut-butter-cupcakes",
  "name": "Peanut Butter Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Moist and rich peanut butter cupcakes are perfect treats for birthdays or special occasions. Eat them as-is or top them with your favorite frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine flour, cream of tartar, baking soda, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "In a large bowl, beat brown sugar, peanut butter, and shortening until light and fluffy. Beat in eggs, one at a time, then stir in vanilla. Stir in dry ingredients alternately with milk. Spoon into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the tops spring back when lightly pressed, 15 to 20 minutes. Cool in the pan for at least 10 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

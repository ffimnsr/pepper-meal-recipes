  "id": "952059b3-d207-5766-a7ae-31c862a349be",
  "slug": "gluten-free-golden-yam-brownies",
  "name": "Gluten-Free Golden Yam Brownies",
  "recipe_type": "dessert",
  "brief_description": "Gluten-free products, egg replacer, and vegan margarine are some items in this modified yam brownie recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Stir the egg replacer and water together in a small bowl until the powder is completely integrated. Stir the rice flour, xanthan gum, baking powder, and salt together in a separate bowl."
    },
    {
      "position": 3,
      "text": "Beat 1 cup margarine, brown sugar, and 1 cup turbinado sugar with an electric mixer in a large bowl until light and fluffy. Add the egg replacer about 1/2 cup at a time, allowing each addition to blend into the butter mixture before adding the next. Add the vanilla extract with the last of the egg replacer. Pour the rice flour mixture into the batter, mixing until just incorporated. Fold the shredded yam into the batter, mixing just enough to evenly combine. Pour the batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Stir 3/4 cup turbinado sugar, cornstarch, 2 tablespoons margarine, and almond milk together in a small bowl until smooth. Spread over the brownies while still warm; they will absorb some of the glaze. Serve warm."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,

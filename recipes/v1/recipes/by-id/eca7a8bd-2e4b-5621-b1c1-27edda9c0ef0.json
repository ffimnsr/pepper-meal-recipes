  "id": "eca7a8bd-2e4b-5621-b1c1-27edda9c0ef0",
  "slug": "basic-pasta",
  "name": "Basic Homemade Pasta",
  "recipe_type": "main",
  "brief_description": "Making deliciously tender homemade pasta is easy with this three-ingredient recipe. Simply double or triple the amounts if you need more.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine flour and salt in a medium bowl. Make a well in the center and add beaten egg. Mix well until a stiff dough forms, adding up to 2 tablespoons water if needed."
    },
    {
      "position": 3,
      "text": "Knead dough on a lightly floured surface until smooth, 3 to 4 minutes. Wrap dough and let rest for 30 minutes to 1 hour."
    },
    {
      "position": 4,
      "text": "Roll dough by hand or with a pasta machine to desired thickness, then cut into strips of desired width and length."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

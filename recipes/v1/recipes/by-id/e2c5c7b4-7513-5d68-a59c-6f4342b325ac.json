  "id": "e2c5c7b4-7513-5d68-a59c-6f4342b325ac",
  "slug": "miso-soup",
  "name": "Miso Soup",
  "recipe_type": "appetizer",
  "brief_description": "This miso soup is easy to make in just 15 minutes with dashi stock, miso paste, silken tofu, and green onions for a deliciously savory appetizer.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water and dashi granules in a medium saucepan over medium-high heat; bring to a boil."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium and whisk in miso paste."
    },
    {
      "position": 4,
      "text": "Stir in tofu."
    },
    {
      "position": 5,
      "text": "Separate the layers of green onions, and add them to the soup. Simmer gently for 2 to 3 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

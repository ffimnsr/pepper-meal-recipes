  "id": "db2946cc-2db0-54ef-b55e-15aee5261045",
  "slug": "chewy-keto-chocolate-cookies",
  "name": "Chewy Keto Chocolate Cookies",
  "recipe_type": "dessert",
  "brief_description": "These low-carb, sugar-free chocolate cookies are moist, chewy, and so decadent. They're my favorite keto cookies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine almond butter, sweetener, cocoa powder, eggs, vanilla, and salt in the bowl of a food processor; pulse until a dough forms."
    },
    {
      "position": 3,
      "text": "Roll dough into fifteen 1-inch balls. Place balls onto the prepared baking sheet. Press down twice on each ball with a fork to make a crisscross pattern."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are firm, about 12 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and cool briefly on the baking sheet before removing to a wire rack to cool completely."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

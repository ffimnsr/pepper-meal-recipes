  "id": "e26fa4e2-28e6-59cb-b367-70fab0380e5e",
  "slug": "vegetarian-black-bean-burritos",
  "name": "Vegetarian Black Bean Burritos",
  "recipe_type": "main",
  "brief_description": "Vegetarian black bean burritos are a snap to make thanks to this recipe that calls for just a few ingredients, 1 bowl, and a microwave.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, vinegar, hot sauce, salt, and black pepper together in a microwave-safe glass or ceramic bowl."
    },
    {
      "position": 2,
      "text": "Layer garlic, chopped onion, sliced onion, zucchini, olives, cabbage, jalapeno, and black beans, respectively, over hot sauce mixture. Cover the bowl with plastic wrap and poke a few holes in the top."
    },
    {
      "position": 3,
      "text": "Microwave for 5 minutes; stir, recover with plastic wrap, and microwave until filling is hot throughout, about 5 minutes more."
    },
    {
      "position": 4,
      "text": "Spoon hot filling in a line across the middle of a tortilla. Fold opposing edges of the tortilla to overlap the filling. Roll 1 of the opposing edges around the filling into a burrito. Repeat with remaining tortillas and filling."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

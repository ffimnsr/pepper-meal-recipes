  "slug": "cucumber-salad-with-labneh-za-atar-and-mint-recipe-8662239",
  "name": "Cucumber Salad with Labneh, Za\u2019atar, and Mint",
  "recipe_type": "salad",
  "brief_description": "This cucumber salad with labneh, za\u2019tar, and mint combines cucumbers with creamy labneh and fragrant mint for a refreshing summer side salad.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, stir together labneh, mint, za\u2019atar, lemon juice, oil, salt, and pepper. Stir in cucumbers; toss to coat. Garnish with lemon zest and additional fresh mint leaves."
    }
  ],

  "id": "bc356d95-53d1-5539-b6f6-bce6e495cd31",
  "slug": "chicken-enchiladas-ii",
  "name": "Creamy Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "These chicken enchiladas with flour tortillas are a kid-favorite dish that is creamy, satisfying, and a great way to use up leftover chicken.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a large baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium saucepan over medium heat. Saut\u00e9 green onions in hot butter until tender, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Add garlic powder, then stir in condensed soup, green chiles, and sour cream. Mix sauce until well combined. Reserve 3/4 of the sauce in a bowl and set aside."
    },
    {
      "position": 4,
      "text": "Add chicken and 1/2 cup cheese to remaining sauce in the pan; stir until cheese is melted."
    },
    {
      "position": 5,
      "text": "Fill each flour tortilla with chicken mixture and roll up. Place seam-side down in the prepared baking dish."
    },
    {
      "position": 6,
      "text": "Stir milk into reserved sauce in the bowl and spoon over rolled tortillas. Top with remaining 1/2 cup cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is bubbly, 30 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

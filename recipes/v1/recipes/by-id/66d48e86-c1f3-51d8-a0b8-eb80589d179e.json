  "id": "66d48e86-c1f3-51d8-a0b8-eb80589d179e",
  "slug": "sawdust-pie-recipe-8633508",
  "name": "Sawdust Pie",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned favorite deserves a spot back on the dessert table. Sawdust Pie, named for its unique, crumbly texture reminiscent of sawdust, combines the best elements of coconut pie, chess pie and pecan pie into one delectable treat. Here's how to make Sawdust Pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Fit pie crust into a 9-inch pie plate; fold edges over, and crimp with the tines of a fork. Poke holes evenly along the sides and bottom of pie crust with a fork. Bake in the preheated oven until pie crust is dry to the touch on the bottom and sides, about 8 minutes. Remove from oven and let cool for 5 minutes."
    },
    {
      "position": 3,
      "text": "Gently fold together egg whites, flaked coconut, graham cracker crumbs, walnuts, sugar, salt, and vanilla extract in a large bowl until fully combined and a thick mixture forms, about 1 minute."
    },
    {
      "position": 4,
      "text": "Transfer egg white mixture to prepared pie crust and gently spread it into an even layer."
    },
    {
      "position": 5,
      "text": "Return to the oven and bake at 350 degrees F (175 degrees C) until pie crust edges are golden brown and the center is set, about 25 minutes. Remove from oven and let cool completely on a wire rack, about 1 hour."
    },
    {
      "position": 6,
      "text": "Slice and top with whipped cream and sliced bananas."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

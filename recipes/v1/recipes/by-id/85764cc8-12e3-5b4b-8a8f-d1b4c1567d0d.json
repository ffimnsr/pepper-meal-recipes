{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "85764cc8-12e3-5b4b-8a8f-d1b4c1567d0d",
  "slug": "meat-pie",
  "name": "Meat Pie",
  "recipe_type": "main",
  "brief_description": "This meat pie features beef, pork, and potato with herbs and warm spices for a super-comforting meal. Using store-bought pie dough makes it a snap.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potato in a saucepan with enough water to cover. Bring to a boil, and cook until tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Drain, mash, and set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, crumble ground beef and pork into a large saucepan. Add onion, garlic, mustard powder, thyme, sage, cloves, salt, and black pepper. Stir in water. Cook over medium heat, stirring, until meat is evenly browned."
    },
    {
      "position": 5,
      "text": "Remove from the heat and mix in mashed potato."
    },
    {
      "position": 6,
      "text": "Ease one pie crust into a 9-inch pie plate. Fill with meat mixture, then top with the remaining pie crust."
    },
    {
      "position": 7,
      "text": "Trim any excess dough, then crimp the edges with the tines of a fork to seal."
    },
    {
      "position": 8,
      "text": "Prick top crust a few times with a knife to vent steam. Cover the edges of the crust with aluminum foil."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until crust is browned, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

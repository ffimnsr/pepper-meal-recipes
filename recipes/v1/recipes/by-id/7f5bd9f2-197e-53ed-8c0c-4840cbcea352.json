{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7f5bd9f2-197e-53ed-8c0c-4840cbcea352",
  "slug": "homemade-chicken-fajitas",
  "name": "Homemade Chicken Fajitas",
  "recipe_type": "main",
  "brief_description": "In this recipe for chicken fajitas with peppers and onions, you'll start by making your own homemade fajita seasoning, with common spices you most likely already have on hand.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk chili powder, cumin, paprika, salt, pepper, cayenne pepper, and garlic powder for fajita seasoning together in a small bowl."
    },
    {
      "position": 2,
      "text": "Trim chicken of any excess fat and place in a large, lidded bowl. Add 2 tablespoons olive oil and sprinkle with about 3/4 of the fajita seasoning. Toss, adding more oil if necessary, until coated. Poke chicken with a knife to allow penetration of seasoning and oil. Place the lid on the bowl and shake until chicken is thoroughly coated. Marinate in the refrigerator, shaking every couple of hours, for 4 to 6 hours."
    },
    {
      "position": 3,
      "text": "Remove the marinating bowl from the refrigerator and let sit on the counter until chicken is room temperature, about 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Preheat the oven to 350 degrees F (175 degrees C). Make 2 stacks of 4 tortillas, and wrap each one in aluminum foil."
    },
    {
      "position": 5,
      "text": "Heat remaining 2 tablespoons olive oil in a large skillet over medium heat. Add peppers and onion. Stir in remaining fajita seasoning and cook, stirring occasionally, until vegetables are soft, 8 to 10 minutes."
    },
    {
      "position": 6,
      "text": "While vegetables are cooking, place tortillas in the oven to warm. At the same time, grill chicken, turning halfway through, until no longer pink in the center and the juices run clear, 2 to 3 minutes per side."
    },
    {
      "position": 7,
      "text": "To assemble fajitas, fill warmed tortillas with chicken, peppers, and onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

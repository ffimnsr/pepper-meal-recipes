  "id": "9dacb13e-7609-50ca-a36f-864e3470e5e2",
  "slug": "mom-sykes-hungarian-goulash",
  "name": "Mom Sykes' Hungarian Goulash",
  "recipe_type": "soup",
  "brief_description": "The lemon flavor gives you a pleasant surprise in this tender goulash served over egg noodles.",
  "cuisine": "Hungarian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add the stew meat, caraway seeds, onion and paprika. Cook and stir until the meat is browned, and the onions are translucent. Add the garlic and lemon zest, and cook for about a minute, then stir in the tomato paste and beef consomme, adding water if necessary to cover the meat. Cover, and simmer over medium-low heat for 1 1/2 hours."
    },
    {
      "position": 2,
      "text": "Just before the meat is done cooking, bring a large pot of salted water to a boil. Add egg noodles, and cook until tender, about 8 minutes. Drain and serve the goulash spooned over the egg noodles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,

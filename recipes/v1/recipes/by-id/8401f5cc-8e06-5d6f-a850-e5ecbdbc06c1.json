  "id": "8401f5cc-8e06-5d6f-a850-e5ecbdbc06c1",
  "slug": "easy-malted-waffles",
  "name": "Easy Malted Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Homemade waffles receive a new twist thanks to malted milk powder added to the batter for a quick and easy breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer\u2019s instructions. Spray the inside of the waffle iron with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir flour, milk powder, corn meal, sugar, baking powder, and salt together in a bowl. Whisk milk, eggs, butter, and vanilla extract together in a separate bowl; pour into flour mixture and stir just until batter is combined."
    },
    {
      "position": 3,
      "text": "Pour batter, working in batches, into the preheated waffle iron and cook until golden brown, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

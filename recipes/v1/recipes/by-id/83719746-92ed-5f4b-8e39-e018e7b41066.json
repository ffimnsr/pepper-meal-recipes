  "id": "83719746-92ed-5f4b-8e39-e018e7b41066",
  "slug": "quiche-lorraine-i",
  "name": "Quiche Lorraine",
  "recipe_type": "breakfast",
  "brief_description": "This quiche Lorraine with crisp bacon, shredded Swiss cheese, and onion baked in a buttery, flaky crust with a creamy filling is perfect for brunch.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels, then chop coarsely."
    },
    {
      "position": 3,
      "text": "Sprinkle bacon, Swiss cheese, and onion into prepared pastry crust."
    },
    {
      "position": 4,
      "text": "Whisk cream, eggs, salt, sugar, and cayenne pepper in a medium bowl; pour mixture into pastry shell."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 300 degrees F (150 degrees C) and continue baking until a knife inserted 1 inch from the edge comes out clean, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Allow quiche to sit 10 minutes before cutting into wedges and serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

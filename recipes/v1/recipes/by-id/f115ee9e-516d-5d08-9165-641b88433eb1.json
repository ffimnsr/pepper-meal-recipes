  "id": "f115ee9e-516d-5d08-9165-641b88433eb1",
  "slug": "easy-cream-cheese-danish",
  "name": "Easy Cream Cheese Danish",
  "recipe_type": "breakfast",
  "brief_description": "This recipe makes the best cream cheese Danish pastries I have ever tasted. It is very simple to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking pan."
    },
    {
      "position": 2,
      "text": "Line bottom of baking pan with 1 can of crescent rolls. Pinch all seams together to seal."
    },
    {
      "position": 3,
      "text": "In a large bowl, mix together cream cheese, white sugar, lemon juice, vanilla extract and sour cream. Spread filling on top of rolls. Place second can of rolls on top of filling."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 20 to 30 minutes."
    },
    {
      "position": 5,
      "text": "In a small bowl, stir together confectioners' sugar, milk and butter. After Danish has cooled, drizzle with icing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

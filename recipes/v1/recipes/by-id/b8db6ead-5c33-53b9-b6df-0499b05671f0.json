  "id": "b8db6ead-5c33-53b9-b6df-0499b05671f0",
  "slug": "easy-vegetable-pot-pie",
  "name": "Easy Vegetable Pot Pie",
  "recipe_type": "soup",
  "brief_description": "Pull what you need from the freezer or pantry from this one. Frozen pie crust, a can of cream of potato soup, and a mega can of mixed veggies. An egg, some milk and a dash of thyme, and you have the fixings for a wonderful pie that your family will think",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, combine potato soup, mixed vegetables, milk, thyme, and black pepper."
    },
    {
      "position": 3,
      "text": "Spoon filling into bottom pie crust. Cover with top crust, and crimp edges to seal. Slit top crust, and brush with beaten egg if desired."
    },
    {
      "position": 4,
      "text": "Bake for 40 minutes. Remove from oven, and cool for 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

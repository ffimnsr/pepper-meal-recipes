  "id": "2d70263f-8811-5859-8ba2-b3a1c43bb167",
  "slug": "spinach-balls",
  "name": "Spinach Balls",
  "recipe_type": "appetizer",
  "brief_description": "This spinach balls recipe uses stuffing mix, Parmesan cheese, butter, eggs, and savory spices, shaped into balls, then baked for a fun-to-make treat.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine stuffing mix, spinach, eggs, Parmesan cheese, melted butter, garlic powder, Italian seasoning, and black pepper in a large bowl; mix well. Use your hands to shape spinach mixture into walnut-sized balls and place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until heated through and browned, about 20 minutes."
    }
  ],
  "servings": 11,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

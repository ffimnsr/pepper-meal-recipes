{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7bbbdb87-737f-5294-a00a-736f38a8509f",
  "slug": "quick-and-easy-green-chile-chicken-enchilada-casserole",
  "name": "Quick and Easy Green Chile Chicken Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This delicious chicken enchilada casserole recipe simply involves layering shredded chicken with tortillas, sour cream, cheese, and enchilada sauce.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium baking dish."
    },
    {
      "position": 2,
      "text": "Season chicken with garlic salt; arrange in the prepared baking dish. Bake in the preheated oven until no longer pink and juices run clear, about 45 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Cool chicken, shred with two forks, and set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, char each tortilla half over the open flame of a gas stove burner using metal tongs until lightly puffed, about 1 minute."
    },
    {
      "position": 5,
      "text": "Pour about 1/2 inch enchilada sauce into the bottom of a medium baking dish; arrange 6 tortillas in a single layer on top."
    },
    {
      "position": 6,
      "text": "Sprinkle with 1/2 of the chicken, 1/3 of the cheese, 1/2 of the sour cream, and 1/3 of the remaining enchilada sauce."
    },
    {
      "position": 7,
      "text": "Repeat layers. Coat remaining tortillas thoroughly with some of the remaining enchilada sauce and arrange on top. Sprinkle with remaining cheese and top with any remaining enchilada sauce."
    },
    {
      "position": 8,
      "text": "Cover and bake in the preheated oven for 45 minutes."
    },
    {
      "position": 9,
      "text": "Cool slightly before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

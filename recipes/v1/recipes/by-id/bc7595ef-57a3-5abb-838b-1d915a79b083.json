  "id": "bc7595ef-57a3-5abb-838b-1d915a79b083",
  "slug": "cranberry-hummus",
  "name": "Cranberry Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This festive hummus with dried cranberries is the perfect make-ahead appetizer for Thanksgiving or the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain cannellini beans and reserve liquid."
    },
    {
      "position": 2,
      "text": "Combine cannellini beans, cranberries, olive oil, lemon juice, thyme, cinnamon, and garlic in a food processor; blend until smooth. If too thick, thin out to your desired consistency by blending in some of the reserved bean liquid."
    },
    {
      "position": 3,
      "text": "Stir in chopped pecans, and season to taste with salt. Store in the refrigerator in an air-tight container until ready to serve."
    },
    {
      "position": 4,
      "text": "Garnish with additional cranberries, pecans, and a drizzle of olive oil, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "15733c5b-3594-5bfb-abe9-22a25e524330",
  "slug": "strawberry-balsamic-glazed-pork-chop-dinner-recipe-11905677",
  "name": "Strawberry Balsamic Glazed Pork Chop Dinner",
  "recipe_type": "main",
  "brief_description": "For this strawberry balsamic glazed pork chop dinner, pork loin chops, baby potatoes, and asparagus roast on a sheet pan while a quick fresh strawberry sauce simmers on the stovetop. Savory and fruity, it's an elegant dinner with little effort.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large sheet pan or jelly roll pan with aluminum foil and coat with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Combine pork, potatoes, and asparagus in a large bowl. Toss with olive oil. Spread onto the sheet pan in an even layer with the vegetables around the pork chops."
    },
    {
      "position": 3,
      "text": "Sprinkle thyme over pork and vegetables; season with salt and pepper to taste."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the pork reaches an internal temperature of at least 145 degrees F (63 degrees C), and potatoes are fork tender, 20 to 22 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, for glaze, combine strawberries, balsamic vinegar, maple syrup, Dijon, and salt in a small saucepan. Bring to a boil; stirring and mashing while cooking, then reduce heat. Simmer; continue to stir and mash berries occasionally, until berries are soft and the mixture is thick, 7 to 8 minutes."
    },
    {
      "position": 6,
      "text": "Serve pork chops with potatoes and asparagus. Spoon strawberry glaze over pork chops."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

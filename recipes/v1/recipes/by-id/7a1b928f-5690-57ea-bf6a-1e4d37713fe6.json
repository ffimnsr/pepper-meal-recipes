  "id": "7a1b928f-5690-57ea-bf6a-1e4d37713fe6",
  "slug": "norwegian-waffles",
  "name": "Norwegian Waffles",
  "recipe_type": "dessert",
  "brief_description": "This recipe for sweet, rich, Norwegian waffles has been in my husband\u2019s family for generations. It is sure to be a favorite with everyone at the table.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Sift flour and baking powder together into a bowl."
    },
    {
      "position": 3,
      "text": "Beat eggs and sugar in a separate bowl with an electric mixer until fluffy. Add milk, melted shortening, salt, and vanilla; mix until well blended. Mix in flour mixture."
    },
    {
      "position": 4,
      "text": "Spoon 2/3 cup batter onto the preheated waffle iron. Close the iron and cook until waffle is golden brown and the iron stops steaming, about 5 minutes. Repeat to cook remaining waffles."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

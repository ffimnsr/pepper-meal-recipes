  "id": "91877171-8352-56e9-bd52-d272f2c424a8",
  "slug": "smooth-sweet-tea",
  "name": "Smooth Sweet Tea",
  "recipe_type": "dessert",
  "brief_description": "Sweet tea is a classic Southern drink made by steeping tea bags in a pitcher; sweeten with sugar and keep chilled for a refreshing drink on hot days!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Sprinkle a pinch of baking soda into a 64-ounce, heat-proof glass pitcher. Pour in boiling water and add tea bags. Cover and allow to steep for 15 minutes."
    },
    {
      "position": 3,
      "text": "Remove tea bags and discard; stir in sugar until dissolved. Pour in cool water; refrigerate until cold, about 3 hours."
    },
    {
      "position": 4,
      "text": "Enjoy over ice on a hot day!"
    }
  ],
  "servings": 7,

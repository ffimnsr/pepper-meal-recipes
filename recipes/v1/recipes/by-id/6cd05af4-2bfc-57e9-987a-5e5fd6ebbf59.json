  "slug": "cocojito-frozen-mojito",
  "name": "Cocojito (Frozen Mojito)",
  "recipe_type": "drink",
  "brief_description": "This cocojito (frozen mojito) recipe teaches you how to make a yummy frozen coconut drink in a blender with ice, limes, cream of coconut, rum, and mint.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ice, cream of coconut, rum, 2\u00bd limes, and 5 mint sprigs in a blender; blend until smooth. Pour into 2 glasses, garnish with mint sprigs and lime wedges."
    }
  ],

  "id": "22db406a-69c7-511e-957c-8cc5deacab5e",
  "slug": "zucchini-bread-v",
  "name": "Spiced Zucchini Bread",
  "recipe_type": "breakfast",
  "brief_description": "Moist and flavorful, with a spice blend that sets it apart from the usual versions, this zucchini bread recipe is great to share with a friend.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray two 8x5-inch loaf pans with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Combine sugar, oil, eggs, and vanilla extract together in a large bowl. Fold in zucchini."
    },
    {
      "position": 3,
      "text": "Sift flour, ground ginger, baking soda, salt, ground cloves, and baking powder together in another large bowl; blend into zucchini mixture."
    },
    {
      "position": 4,
      "text": "Fold in walnuts and raisins. Divide between the prepared loaf pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour. Cool for 10 minutes; remove from pans to a wire rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

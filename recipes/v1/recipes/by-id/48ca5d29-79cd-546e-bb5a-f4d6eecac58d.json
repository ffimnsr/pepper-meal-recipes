  "schema_version": 1,
  "id": "48ca5d29-79cd-546e-bb5a-f4d6eecac58d",
  "slug": "sausage-risotto",
  "name": "Sausage Risotto",
  "recipe_type": "side",
  "brief_description": "The addition of mild Italian sausage transforms what's normally a side dish into a fabulous main course.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 tablespoon butter in a saute pan over medium heat. Add sausage and cook, breaking it up with a spoon, for 3 minutes. Add shallots, 1 tablespoon butter, and 1/2 teaspoon salt; saute until shallots begin to caramelize, 2 to 3 minutes. Remove from the heat and set aside."
    },
    {
      "position": 2,
      "text": "Melt 1 tablespoon butter in a heavy saucepan over medium heat. Add Arborio rice and stir until it begins to brown, 2 to 3 minutes. Add wine and continue stirring until almost absorbed, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Begin to add broth, 1/2 cup at a time. Stir until broth is almost completely absorbed, then add another 1/2 cup and repeat. Continue adding broth until risotto resembles a thick porridge but still has some bite to it. This process will take 20 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the heat. Stir in the sausage mixture, Parmesan cheese, and remaining 1 tablespoon butter. Season with salt if necessary. Garnish with thyme sprigs and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

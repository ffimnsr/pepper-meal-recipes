  "id": "bbc9e6be-bd04-5326-bb39-8521a0432d4f",
  "slug": "chicken-cacciatore-rice-bowl",
  "name": "Chicken Cacciatore Rice Bowl",
  "recipe_type": "main",
  "brief_description": "Bite-sized chunks of chicken simmered in a traditional pasta sauce with bell peppers are served over piping hot brown rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together a large pinch of salt and pepper with the flour in a large bowl. Add the chicken pieces and toss until evenly coated with flour mixture."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook chicken for about 4 minutes, turning well so each side is evenly browned. Remove to a plate. In the same skillet, saute the pepper, onion, and garlic until the onion is soft and translucent, about 5 minutes. Add wine and chicken broth; simmer until it is reduced by half. Finally, pour in the tomato sauce and add the browned chicken pieces. Simmer for 5 minutes, or until thickened."
    },
    {
      "position": 3,
      "text": "Divide the rice into four deep bowls and top with even amounts of the chicken cacciatore. Serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "simple-orange-glaze",
  "name": "Simple Orange Glaze",
  "recipe_type": "dessert",
  "brief_description": "This easy orange glaze recipe made with freshly squeezed orange juice and zest is ready in minutes to drizzle over all of your favorite baked goods.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place confectioners' sugar into a bowl. Add 1 tablespoon orange juice and 1/4 teaspoon orange zest."
    },
    {
      "position": 3,
      "text": "Whisk until smooth, adding more juice as needed for desired consistency; reserve remaining zest and juice for another use."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

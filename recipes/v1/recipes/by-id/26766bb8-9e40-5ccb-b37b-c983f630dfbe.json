  "id": "26766bb8-9e40-5ccb-b37b-c983f630dfbe",
  "slug": "thai-chicken-larb",
  "name": "Thai Chicken Larb",
  "recipe_type": "main",
  "brief_description": "This flavorful, Thai chicken larb recipe is easy to make at home with ground chicken, fresh herbs, ginger, lime, and fish sauce in just 30 minutes.",
  "cuisine": "Asian Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium heat. Add chicken; cook and stir, breaking it into small pieces, until no longer pink, about 5 minutes. Stir in onion and scallions; cook until onion softened and chicken begins to brown, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Add lime juice, cilantro, mint, ginger, lemongrass, fish sauce, and pepper flakes; cook and stir until flavors blend, about 3 minutes. Season with salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

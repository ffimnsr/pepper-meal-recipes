{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e6ac72c7-2d22-5503-b566-56c36447e539",
  "slug": "grandmas-baked-rice-pudding-with-meringue",
  "name": "Grandma's Baked Rice Pudding with Meringue",
  "recipe_type": "dessert",
  "brief_description": "Grandma's rice pudding with meringue recipe starts with creamy rice pudding that's baked, then topped with a layer of meringue, and then baked again.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan over medium-high heat. Reduce heat to low, stir, and cover pan. Simmer until water is absorbed, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Beat \u00bd cup sugar and egg yolks together in a bowl. Beat in cornstarch and salt; continue beating. Gradually beat in milk. Stir in cooked rice, raisins, and lemon juice; transfer to a baking dish and place inside a larger baking pan. Fill larger pan with water 1 inch up the sides of the smaller baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pudding is creamy and most liquid is absorbed, stirring occasionally, about 1 hour, 30 minutes. Add more water to the larger baking pan as necessary to maintain the level."
    },
    {
      "position": 5,
      "text": "Meanwhile, beat egg whites in a glass or ceramic bowl until soft peaks form. Gradually beat in \u00bc cup sugar; continue beating until meringue forms stiff peaks. Remove pudding from the oven, leaving it in the larger baking pan. Top pudding with meringue, swirling with a spoon to create soft peaks."
    },
    {
      "position": 6,
      "text": "Increase the oven temperature to 400 degrees F (200 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until meringue is golden, 8 to 10 minutes. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

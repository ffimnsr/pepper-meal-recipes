  "id": "dc9ba49f-c60d-5a97-8d48-c906f752d86e",
  "slug": "classic-lard-two-crust-pie-pastry",
  "name": "Classic Lard Two-Crust Pie Pastry",
  "recipe_type": "dessert",
  "brief_description": "This pie crust with lard, flour, salt, and ice water bakes up perfectly flaky and tender every time; add your favorite filling for a classic treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour and salt together in a large bowl. Cut in lard with a knife or pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 2,
      "text": "Sprinkle in water, 1 tablespoon at a time, blending gently with a fork or pastry blender until all flour is moistened and dough almost cleans the sides of the bowl."
    },
    {
      "position": 3,
      "text": "Divide the dough in half and shape flattened rounds. Wrap in plastic and refrigerate for at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

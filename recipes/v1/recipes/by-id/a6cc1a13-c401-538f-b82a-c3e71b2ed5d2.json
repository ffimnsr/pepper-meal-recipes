  "id": "a6cc1a13-c401-538f-b82a-c3e71b2ed5d2",
  "slug": "traditional-rub-for-st-louis-ribs",
  "name": "Traditional Rub for St. Louis Ribs",
  "recipe_type": "main",
  "brief_description": "This St. Louis rib rub made with dark brown sugar, paprika, dry mustard, garlic powder, and coriander adds incredible flavor to slow-grilled ribs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make dry rub: Combine brown sugar, paprika, mustard, sea salt, garlic powder, onion powder, and coriander in a small bowl; mix well."
    },
    {
      "position": 2,
      "text": "Prepare ribs: Coat ribs all over with oil and sprinkle with dry rub. Set aside at room temperature for 1 hour."
    },
    {
      "position": 3,
      "text": "Heat a charcoal or gas grill for indirect cooking to 230 to 250 degrees F (110 to 120 degrees C). Add drained wood chips."
    },
    {
      "position": 4,
      "text": "Place ribs, meaty-side down, over a drip pan and cook on the preheated grill for 2 hours, basting occasionally with sprays of apple juice over both sides of ribs. Add about 12 coals to a charcoal grill about every 45 minutes to maintain heat."
    },
    {
      "position": 5,
      "text": "Remove ribs from the grill and double-wrap each rack in heavy-duty aluminum foil. Return wrapped ribs to the grill and cook over indirect heat until ribs are very tender, 1 hour 30 minutes to 3 hours. Add more coals as needed to maintain the temperature for a charcoal grill."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

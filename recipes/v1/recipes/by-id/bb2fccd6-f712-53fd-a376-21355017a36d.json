  "slug": "hamburger-goulash",
  "name": "Hamburger Goulash",
  "recipe_type": "soup",
  "brief_description": "Hamburger goulash will warm you up anytime! Very good with cornbread or crackers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place ground beef in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside."
    },
    {
      "position": 2,
      "text": "Add all ingredients (except noodles) to browned ground meat and simmer for 1 hour, then add noodles."
    }
  ],
  "servings": 8,

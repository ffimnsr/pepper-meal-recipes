{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "94cf9072-3f4a-5bcf-98d1-5f0d6490cd8d",
  "slug": "lamb-ragu",
  "name": "Braised Lamb Rag\u00f9",
  "recipe_type": "soup",
  "brief_description": "This lamb rag\u00f9 made with braised lamb shoulder in a rich and herby tomato and wine sauce is perfect for serving over pasta for a hearty Italian meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a Dutch over over medium-high heat."
    },
    {
      "position": 2,
      "text": "Season lamb shoulder with salt and pepper; cook in hot oil until well-browned on all sides, 20 to 30 minutes. Remove shoulder to a platter."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Stir onion, celery, carrot, fennel, and garlic into the rendered fat remaining in the Dutch oven; season with salt. Cook and stir vegetables in hot fat, scraping the bottom of the pot to release any dark bits of meat stuck, until vegetables are softened, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Return lamb shoulder to the Dutch oven along with any juices accumulated on the platter. Add tomatoes and wine; stir well. Bundle marjoram, thyme, and rosemary together with kitchen twine; add to the Dutch oven and submerge in liquid. Place a cover on the Dutch oven, bring the liquid in it to a boil, and transfer pot to the oven."
    },
    {
      "position": 6,
      "text": "Braise lamb in preheated oven for 1 hour. Pour 1 cup water into the Dutch oven; stir and continue cooking for 1 hour more."
    },
    {
      "position": 7,
      "text": "Remove lamb to a cutting board, cut or shred into smaller pieces, and return to the Dutch oven. Pour remaining 1 cup water over the lamb and stir."
    },
    {
      "position": 8,
      "text": "Continue to braise ragu in oven until lamb is very tender, about 30 minutes more."
    },
    {
      "position": 9,
      "text": "Stir rosemary, orange zest, and red pepper flakes into the lamb mixture. Add more water if the mixture is too thick."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d44ee926-c9b3-5d28-8891-ad6e323b5920",
  "slug": "crispy-bloomin-eggplant-parmesan-recipe-12010535",
  "name": "Crispy Bloomin\u2019 Eggplant Parmesan",
  "recipe_type": "appetizer",
  "brief_description": "This crispy bloomin\u2019 eggplant Parmesan is one you\u2019ll be proud to set on the table, yet it\u2019s surprisingly easy to make. Baked until golden, cheesy, and tender with an extra-crispy breadcrumb coating, it captures all the flavors of classic eggplant Parmesan in a fun, pull-apart presentation. Serve with warm marinara for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Using a sharp knife, slice eggplant crosswise into 1/2-inch intervals, stopping about 1/2 inch from the bottom so slices remain attached. Rotate eggplant and repeat cutting lengthwise to create a crosshatch pattern, being careful not to cut all the way through."
    },
    {
      "position": 3,
      "text": "Stuff mozzarella cheese evenly into the cuts of the eggplant. Brush with 1 tablespoon of the olive oil. Wrap eggplant in foil and place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil. Transfer eggplant back to the baking sheet. Brush eggplant with remaining 1 tablespoon olive oil. Stir bread crumbs and Parmesan cheese together in a small bowl. Sprinkle mixture evenly over eggplant."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, until golden brown and tender, 25 to 28 minutes. Serve with marinara sauce. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "06071927-e557-52fa-a96e-822bf6a26c95",
  "slug": "semla-swedish-fat-tuesday-buns",
  "name": "Semla (Swedish Fat Tuesday Buns)",
  "recipe_type": "dessert",
  "brief_description": "A semla is a Swedish bun filled with the most delicious almond paste and whipped cream, dusted with powdered sugar for a Fat Tuesday favorite.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour milk into the bowl of a stand mixer. Sprinkle yeast on top, followed by 1 1\u20443 cups flour and mix with a wooden spoon. Allow to stand until foamy, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Add flour, softened butter, powdered sugar, egg, cardamom, and salt; knead with dough hook (or by hand) until a soft, smooth, elastic dough forms, 5 to 6 minutes. Transfer dough to a lightly floured surface and shape into a ball. Divide into 12 equal portions. Using flour as necessary, roll dough under a cupped hand to form perfectly smooth balls."
    },
    {
      "position": 3,
      "text": "Place dough balls evenly on a parchment lined baking sheet, leaving space in between and slightly push down. Dust tops with flour, and cover with a clean kitchen towel. Let rise in a warm spot until doubled in size, about 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 5,
      "text": "Stir together egg and water in a small bowl and brush rolls all over with egg wash."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly golden, about 12 minutes. Transfer buns onto a wire rack and let cool completely."
    },
    {
      "position": 7,
      "text": "Combine almond paste, powdered sugar, milk, and cardamom in a food processor and blend almond filling until smooth."
    },
    {
      "position": 8,
      "text": "Cut a triangle from the top of the buns, and remove some of the crumbs to make room for the filling. Pipe almond filling into each bun, and top with whipped cream. Place the triangle on top and dust with powdered sugar before serving."
    }
  ],
  "servings": 12,

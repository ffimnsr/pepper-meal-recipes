  "id": "a2e84c96-011e-5f0d-b17c-a28a1f083022",
  "slug": "chocolate-fruit-tart",
  "name": "Chocolate Fruit Tart",
  "recipe_type": "dessert",
  "brief_description": "A homemade chocolate tart crust is filled with lemon pastry cream and topped with fresh fruit to make this easy, elegant summertime dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, cocoa powder, and salt together in a bowl. Cut in 1/2 cup plus 3 tablespoons butter using a pastry cutter or 2 knives until mixture resembles coarse meal. Mix in egg and egg yolk until dough comes together."
    },
    {
      "position": 3,
      "text": "Roll out the dough on a lightly floured work surface. Transfer to a 9-inch tart pan with a removable bottom."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until dry to the touch, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, prepare the pastry cream. Bring milk to a simmer in a medium saucepan."
    },
    {
      "position": 6,
      "text": "Whisk eggs, sugar, and flour together in a large bowl until smooth. Whisk in hot milk, a little at a time, until custard is smooth. Pour custard back into the saucepan; add lemon zest. Cook, whisking constantly, until pastry cream thickens and comes to a boil, 5 to 7 minutes. Remove from heat, discard lemon zest, and let cool."
    },
    {
      "position": 7,
      "text": "Remove tart crust from the oven and let cool to room temperature, about 20 minutes."
    },
    {
      "position": 8,
      "text": "Unmold crust and fill with cooled pastry cream. Pile cherries in the center. Arrange peach slices in a ring around the cherries. Arrange kiwi slices in a ring around the peaches."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

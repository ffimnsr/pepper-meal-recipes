  "id": "1fd8cba7-428d-5cb8-91c4-ee48af32e523",
  "slug": "copycat-arbys-curly-fries-recipe-12031515",
  "name": "Copycat Arby\u2019s Curly Fries",
  "recipe_type": "side",
  "brief_description": "This Copycat Arby\u2019s Curly Fries recipe makes it easy to recreate the crispy, seasoned fries at home. Spiralized potatoes get an Arby\u2019s-style batter coating before cooking in the air fryer until crispy outside and tender inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim ends of potatoes so they will stay in place in a spiralizer. Cut potatoes into curls with the largest noodle plate of the spiralizer. Place potato curls in a large bowl. Add enough hot tap water to cover. Let stand for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the air fryer to 375 degrees F (190 degrees C). Place a wire rack over a parchment-lined rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Drain potato curls; blot potato curls dry with paper towels."
    },
    {
      "position": 4,
      "text": "Whisk together milk, flour, cornstarch, salt, smoked paprika, garlic powder, onion powder, and cayenne pepper in a large bowl."
    },
    {
      "position": 5,
      "text": "Add potato curls to bowl; toss in batter to coat. Place on the wire rack to drain excess batter."
    },
    {
      "position": 6,
      "text": "Place potato curls in the air fryer, working in batches. Coat generously with cooking spray."
    },
    {
      "position": 7,
      "text": "Bake until crisp and golden brown, 9 to 10 minutes, turning once. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

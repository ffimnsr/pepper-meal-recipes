  "id": "8ba11c73-f9b1-59a4-9bd4-e09de153ac00",
  "slug": "steamed-lobster-tails",
  "name": "Steamed Lobster Tails",
  "recipe_type": "main",
  "brief_description": "Steamed lobster tail served with melted butter is simply delicious. Follow this recipe for a foolproof method and juicy, succulent lobster every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Pour about 1 inch of water into the bottom of a large stockpot and bring to a boil. Add salt and place a steamer insert inside the pot so that it is just above the water level. Place lobster tails on the steamer rack and cover the pot."
    },
    {
      "position": 3,
      "text": "Steam lobster tails for 8 minutes (without peeking!)."
    },
    {
      "position": 4,
      "text": "Remove lobster tails from the steamer and serve with melted butter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

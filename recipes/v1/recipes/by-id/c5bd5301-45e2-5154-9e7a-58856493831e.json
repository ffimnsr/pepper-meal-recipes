  "id": "c5bd5301-45e2-5154-9e7a-58856493831e",
  "slug": "pork-chop-suey",
  "name": "Pork Chop Suey",
  "recipe_type": "main",
  "brief_description": "This is a very easy, tasty recipe. Serve over rice and sprinkle with chopped green onions.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Trim fat from pork, cut into 1 inch pieces. Combine flour and pork in a resealable bag, seal and shake well."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a large skillet over medium high heat. Add pork, cook 3 minutes or until browned. Remove from pan and keep warm."
    },
    {
      "position": 3,
      "text": "Heat remaining tablespoon oil in pan. Add bok choy, celery, red pepper, mushrooms, water chestnuts and garlic; stir fry for 3 minutes. In a bowl combine chicken broth, soy sauce, cornstarch, sherry and ginger. Stir well with a whisk. Combine pork and broth mixture in skillet, cook 1 minute or until thick."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

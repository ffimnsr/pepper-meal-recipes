  "id": "ad83dc1e-8b8b-5864-84ca-18adecdc93f0",
  "slug": "parisian-style-steak-frites",
  "name": "Parisian-Style Steak Frites",
  "recipe_type": "main",
  "brief_description": "This quick and easy hanger steak frites recipe makes it a cinch to have bistro steak in a white wine and herb glaze. Serve Parisian-style with fries and Dijon.",
  "cuisine": "French Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a heavy skillet over medium-high heat. Cook steaks to desired doneness, about 5 minutes per side for medium; an instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C). Transfer steaks to a plate to rest."
    },
    {
      "position": 2,
      "text": "Place shallots in the skillet and cook until beginning to soften, about 2 minutes. Pour wine into the skillet and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon. Add broth and anchovy; cook until thickened to sauce consistency, 2 to 3 minutes. Remove skillet from heat; whisk butter in gradually. Stir parsley, chervil, and thyme into the sauce. Pur\u00e9e sauce in the skillet with an immersion blender until smooth."
    },
    {
      "position": 3,
      "text": "Cut steaks into thin slices across the grain; spoon sauce over slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

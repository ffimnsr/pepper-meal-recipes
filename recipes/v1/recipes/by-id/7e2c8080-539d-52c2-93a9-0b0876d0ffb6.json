  "id": "7e2c8080-539d-52c2-93a9-0b0876d0ffb6",
  "slug": "caramel-shortbread-squares",
  "name": "Caramel Shortbread Squares",
  "recipe_type": "dessert",
  "brief_description": "Caramel squares (aka millionaire's shortbread) are made with three layers of utter decadence: buttery shortbread, rich caramel, and melted chocolate.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the shortbread: Mix flour, softened butter, and sugar together in a medium bowl until well blended and crumbly. Press into the bottom of a 9-inch square baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until dry and light golden brown, about 20 minutes."
    },
    {
      "position": 4,
      "text": "To make the caramel: Bring butter, brown sugar, condensed milk, and corn syrup to a boil in a saucepan over medium-low heat. Boil for 5 minutes, then remove from the heat and beat vigorously with a wooden spoon for about 3 minutes. Pour over baked crust (crust can be either warm or cool). Let sit at room temperature until caramel begins to firm up, 2 to 3 hours."
    },
    {
      "position": 5,
      "text": "Microwave chocolate in a microwave-safe bowl on high for 1 minute, then stir and continue to heat and stir in 20-second intervals until chocolate is melted and smooth."
    },
    {
      "position": 6,
      "text": "Pour chocolate over caramel layer and spread evenly to cover completely. Chill in the refrigerator until chocolate is set, about 30 minutes. Cut into bars."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fcced77f-e94f-54d4-8c16-a27567e00475",
  "slug": "whole-lime-margarita",
  "name": "Whole Lime Margarita",
  "recipe_type": "appetizer",
  "brief_description": "Lime margaritas made with whole limes (both juice and rinds) are bright, flavorful, and extra delicious. You'll never buy margarita mix again!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut limes into quarters; remove and discard the center part of the rinds. Blend until completely smooth, about 1 minute."
    },
    {
      "position": 3,
      "text": "Transfer lime quarters to a blender with cold water, tequila, sugar, orange-flavored liqueur, and salt."
    },
    {
      "position": 4,
      "text": "Blend until completely smooth, about 1 minute."
    },
    {
      "position": 5,
      "text": "Strain mixture into a large measuring cup or small pitcher"
    },
    {
      "position": 6,
      "text": "Serve over ice and garnish with lime slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

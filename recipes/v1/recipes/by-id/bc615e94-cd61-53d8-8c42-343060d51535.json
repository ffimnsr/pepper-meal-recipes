  "id": "bc615e94-cd61-53d8-8c42-343060d51535",
  "slug": "marys-meatloaf",
  "name": "Mary's Meatloaf",
  "recipe_type": "main",
  "brief_description": "This easy meatloaf is flavored with garlic powder, mustard, ketchup and onion, then topped with a brown sugar, ketchup and mustard sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, thoroughly mix ground beef, onion, salt, pepper and garlic powder. Mix in bread, milk, egg, 2 tablespoons mustard and 1/4 cup ketchup."
    },
    {
      "position": 3,
      "text": "Press the meat mixture into a 9x5-inch loaf pan. In a small bowl, stir together remaining mustard, ketchup and brown sugar; pour on top of the meat loaf."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center reads 165 degrees F (74 degrees C), about 2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "7907da18-1ef2-5549-b292-6d05dd62bc0a",
  "slug": "terris-sloppy-joes",
  "name": "Terri's Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "This sloppy Joe recipe without brown sugar features ground beef and onion simmered in a delicious barbecue sauce with mustard, ketchup, and vinegar.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium heat. Cook and stir ground beef and onion in the hot skillet until beef is completely browned and onion is softened, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in ketchup, barbecue sauce, vinegar, mustard, and sugar until incorporated; simmer mixture for 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,

  "id": "4d931156-586b-56ae-a4d9-150ff0f9983a",
  "slug": "air-fryer-falafel",
  "name": "Air Fryer Falafel",
  "recipe_type": "side",
  "brief_description": "Once you've soaked your chickpeas, you can use a food processor and an air fryer to quickly bake these spicy falafel patties.",
  "cuisine": "Middle Eastern Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Soak chickpeas in a large amount of cool water for 24 hours. Rub the soaked chickpeas with your fingers to help loosen and remove skins. Rinse and drain well. Spread chickpeas on a large clean dish towel to dry."
    },
    {
      "position": 2,
      "text": "Blend chickpeas, cilantro, parsley, onion, and garlic in a food processor until a rough paste forms. Transfer mixture to a large bowl. Add chickpea flour, coriander, cumin, Sriracha, salt, and pepper and mix well. Cover bowl and let mixture rest for 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Add baking powder and baking soda to the chickpea mixture. Mix using your hands until just combined. Form 15 equal-sized balls and press slightly to form patties. Spray falafel patties with cooking spray."
    },
    {
      "position": 5,
      "text": "Place 7 falafel patties in the preheated air fryer and cook for 10 minutes. Transfer cooked falafel to a plate and repeat with remaining 8 falafel, cooking for 10 to 12 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4542bbba-fcd8-51e0-85bb-df5261e4c336",
  "slug": "grandma-jeanettes-amazing-german-red-cabbage",
  "name": "Grandma Jeanette's Amazing German Red Cabbage",
  "recipe_type": "dessert",
  "brief_description": "This German red cabbage recipe is easy to make with shredded red cabbage, apples, sugar, and cider vinegar for a deliciously sweet and sour side dish.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cabbage, apples, sugar, and butter into a large pot. Pour in vinegar and water, then add salt, pepper, and cloves. Bring to a boil over medium-high heat."
    },
    {
      "position": 3,
      "text": "Reduce heat to low, cover, and simmer until the cabbage is tender, 1 \u00bd to 2 hours."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,

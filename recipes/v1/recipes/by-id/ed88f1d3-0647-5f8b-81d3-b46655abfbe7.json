  "id": "ed88f1d3-0647-5f8b-81d3-b46655abfbe7",
  "slug": "grinch-punch-recipe-8362999",
  "name": "Grinch Punch",
  "recipe_type": "appetizer",
  "brief_description": "Fizzy green Grinch punch made with lime sherbet, pineapple juice, and Hawaiian punch is a wonderful, awful idea perfect for a festive holiday party!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Scoop softened lime sherbet into the bottom of a large punch bowl."
    },
    {
      "position": 2,
      "text": "Pour lemon-lime soda, Hawaiian Punch, and 2 cups pineapple juice over lime sherbet and stir."
    },
    {
      "position": 3,
      "text": "Place red sanding sugar in a shallow dish, and some additional pineapple juice in a separate shallow dish. Dip rims of the serving glasses in pineapple juice, then in the sanding sugar to coat the rims generously."
    },
    {
      "position": 4,
      "text": "Ladle the punch into the prepared glasses."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

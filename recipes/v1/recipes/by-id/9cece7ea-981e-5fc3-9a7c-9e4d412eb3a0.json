  "id": "9cece7ea-981e-5fc3-9a7c-9e4d412eb3a0",
  "slug": "empanadas-abiertas-de-humita-creamy-corn-empanadas",
  "name": "Empanadas Abiertas de Humita (Creamy Corn Empanadas)",
  "recipe_type": "appetizer",
  "brief_description": "These open-faced vegetarian empanadas with a creamy corn filling flecked with spring onions are a classic Argentinean snack or appetizer.",
  "cuisine": "Argentine",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease and flour a 12-cup muffin tin."
    },
    {
      "position": 2,
      "text": "Line the muffin cups with the 12 pastry rounds."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons butter in a skillet over medium heat; cook and stir green onions until tender, 3 to 5 minutes. Add corn, salt, pepper, and nutmeg; cook and stir until heated through, about 2 minutes. Remove skillet from heat."
    },
    {
      "position": 4,
      "text": "Heat 3 tablespoons butter in a saucepan over medium heat; add flour and cook, stirring with a wooden spoon, until a paste forms, about 1 minute. Slowly pour in milk, whisking constantly, and cook until a thick sauce forms and starts to bubble, 2 to 3 minutes. Add half of the Parmesan cheese and stir until smooth; remove from heat. Stir sauce into corn mixture."
    },
    {
      "position": 5,
      "text": "Fill pastry with corn mixture and top each with remaining Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 23,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d51de670-a8cf-56f6-91be-6433cd7c0014",
  "slug": "strawberry-lemonade-cookies-recipe-11971094",
  "name": "Strawberry Lemonade Cookies",
  "recipe_type": "dessert",
  "brief_description": "These strawberry lemonade cookies are soft and so delicious; they bring home the lemon flavor with just the right touch of strawberries. They're easy to make with cake mix and a few additional ingredients. If you love strawberry lemonade, these cookies are for you.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Add lemon cake mix to a bowl; add strawberry cake mix to a separate bowl. Add 2 eggs, 1/3 cup vegetable oil, and 1 and 1/2 teaspoons lemon juice to each bowl. Mix until completely combined."
    },
    {
      "position": 2,
      "text": "Cover each bowl with plastic film and refrigerate for at least 30 minutes. Line a large baking sheet with parchment paper. Pour confectioner\u2019s sugar onto a large plate."
    },
    {
      "position": 3,
      "text": "Remove each bowl and uncover. Using clean hands, scoop 1 tablespoon each of strawberry dough and lemon dough; drop into confectioner\u2019s sugar. Toss to coat, then pick up both, and using slight pressure from the palms of your hands, roll into 1 ball. Dust with a little more confectioner's sugar, then place on the baking sheet. Repeat with remaining dough."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crackled on top and lightly golden on the bottom, about 13 minutes. Watch carefully and turn the baking sheet halfway through cooking time if needed. Remove and let cool."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "ff8509cd-fec9-5ab0-8169-1f11786b1aef",
  "slug": "robbis-mms-cookies",
  "name": "Robbi's M&Ms Cookies",
  "recipe_type": "dessert",
  "brief_description": "This M&M cookie recipe makes soft, chewy cookies with crisp edges packed with chocolate candies that melt in your mouth. And no chill time needed!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat shortening, brown sugar, white sugar, eggs, and vanilla in a mixing bowl until light and fluffy, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Add flour, baking soda, and salt; blend well. Stir in 1/2 of the chocolate candies."
    },
    {
      "position": 4,
      "text": "Drop dough by teaspoonfuls onto an ungreased baking sheet. Use remaining candies to decorate dough balls; press down slightly."
    },
    {
      "position": 5,
      "text": "Bake in batches in the preheated oven until lightly browned with soft centers, 9 to 11 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

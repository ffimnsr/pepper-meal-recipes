  "id": "65f33b89-660f-5b5a-9a0f-7911a068d5b5",
  "slug": "monkey-bread-ii",
  "name": "Bread Machine Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "Here is a bread machine monkey bread recipe, though it can easily be done in the conventional muscle-building way.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove the baking pan from the machine. Place yeast, flour, cinnamon, salt, white sugar, 2 tablespoons margarine, and water in the order recommended for the bread machine. Make sure that no liquid comes in contact with yeast. Select dough cycle and press start."
    },
    {
      "position": 2,
      "text": "Transfer dough to a floured surface; knead 10 to 12 times. Set aside to rest."
    },
    {
      "position": 3,
      "text": "Melt 1 cup margarine in a medium saucepan over low heat. Stir in brown sugar and raisins until smooth. Remove from heat."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a Bundt or tube pan."
    },
    {
      "position": 5,
      "text": "Cut dough into 1-inch chunks. Drop a chunk at a time into brown sugar mixture to thoroughly coat. Layer dough pieces loosely in the prepared pan, staggering layers, so you\u2019re plopping each dough chunk over a space between two below. Let rise in a warm, draft-free spot until dough is just over the top of the pan, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes."
    },
    {
      "position": 7,
      "text": "Remove from the oven and cover the pan with a plate. Holding the plate and the pan with oven mitts, flip over both until bread slides out onto the plate. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

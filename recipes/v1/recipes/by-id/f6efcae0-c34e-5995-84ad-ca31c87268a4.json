  "id": "f6efcae0-c34e-5995-84ad-ca31c87268a4",
  "slug": "lime-chili-shrimp-ramen-recipe-11847855",
  "name": "Lime Chili Shrimp Ramen",
  "recipe_type": "soup",
  "brief_description": "This lime chili shrimp ramen has a rich, spicy broth, plenty of shrimp, and is garnished with a boiled egg. Flavorful and filling, it will warm you throughout.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon sesame oil in a Dutch oven or large pot over medium-high heat. Add shrimp and sprinkle with 1 tablespoon chili powder. Cook shrimp for 2 minutes; turn shrimp over and cook until pink and opaque, about 1 minute more. Remove from the Dutch oven and set aside."
    },
    {
      "position": 2,
      "text": "Add 1 tablespoon sesame oil, shallots, garlic, ginger, and mushrooms to the Dutch oven; stir and cook for 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Add broth, soy sauce, lime juice, and 2 teaspoons chilli powder. Allow to simmer for about 10 minutes."
    },
    {
      "position": 4,
      "text": "Bring broth to a boil and add noodles. Cook until noodles are soft, about 4 minutes. Add spinach and cook for another 2 minutes."
    },
    {
      "position": 5,
      "text": "Turn off the heat, mix shrimp with noodles and broth. and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

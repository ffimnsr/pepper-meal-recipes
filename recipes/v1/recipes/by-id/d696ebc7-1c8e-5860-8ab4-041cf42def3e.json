  "id": "d696ebc7-1c8e-5860-8ab4-041cf42def3e",
  "slug": "copycat-crazy-puffs-recipe-8621973",
  "name": "Copycat Crazy Puffs",
  "recipe_type": "appetizer",
  "brief_description": "Learn how to make a copycat version of Little Caesar's crazy puffs at home - all the flavors of pepperoni pizza in little bite-sized puffs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (180 degrees C) Place a baking sheet on the bottom rack oven. Coat a shallow 12 cup muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Roll pizza dough across prepared muffin tin, make sure to stretch dough to cover the entire surface. Using a pizza cutter, cut dough into squares for each muffin tin. Discard any excess dough."
    },
    {
      "position": 3,
      "text": "Press and roll dough squares into each tin and ensure dough comes halfway up the sides of each cup."
    },
    {
      "position": 4,
      "text": "Stir together butter, parsley, Italian seasoning, garlic salt, and black pepper in a small bowl until well combined. Brush butter mixture onto each dough cup."
    },
    {
      "position": 5,
      "text": "Dollop 1 teaspoon pizza sauce into each cup. Layer two slices of pepperoni, add 1 tablespoon cheese overtop, and another 2 slices of pepperoni. Top with another 2 tablespoons of cheese, making sure to press the cheese within each muffin cup. Add Parmesan to butter mixture, and drip butter mix over each puff."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes. Set oven to broil, and broil until golden brown, about 1 minute. Remove from oven and allow to cool for 2 minutes before serving. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

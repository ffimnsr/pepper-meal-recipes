{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7f036238-5446-5d42-8c8e-9562bb56b242",
  "slug": "italian-breakfast-strata-recipe-11738188",
  "name": "Italian Breakfast Strata",
  "recipe_type": "breakfast",
  "brief_description": "Chef John\u2019s Italian breakfast strata is one of the best breakfast casseroles ever, layered with Italian bread cubes, Italian sausage, plenty of spinach, and melty fontina cheese in just the right amount of egg custard. It has a fantastic fluffy texture, rich and satisfying, and yet somehow not heavy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut bread into 1-inch cubes, and spread out in a single layer on the work surface; leave uncovered overnight to become stale."
    },
    {
      "position": 2,
      "text": "Add olive oil to a skillet set over medium-high heat, and add sausage. Cook, while crumbling with a spatula, for a few minutes, just until the sausage starts to brown. Add onions, a large pinch of salt, black pepper, cayenne, oregano, thyme, and rosemary. Cook, stirring until the onions soften and start to turn translucent."
    },
    {
      "position": 3,
      "text": "Transfer the mixture into a bowl, then spoon about 1 tablespoon of rendered sausage fat back into the pan; place pan back over medium-high heat."
    },
    {
      "position": 4,
      "text": "Add spinach and cook, tossing with tongs until it\u2019s just barely wilted and bright green. Transfer into a strainer to cool. Squeeze out any excess water, and chop before using. Or, use scissors to snip into small pieces."
    },
    {
      "position": 5,
      "text": "Whisk eggs with salt until yolks have been incorporated into the whites. Whisk in milk and set aside."
    },
    {
      "position": 6,
      "text": "Grease a 9x13-inch casserole dish with olive oil. Cover the bottom with a single tight layer of stale bread cubes. Top evenly with about 60% of sausage mixture, layer on 60% of spinach, and then scatter over half the cheese."
    },
    {
      "position": 7,
      "text": "Top this with another layer of bread cubes, pressing down lightly with your hands to flatten. Top bread with remaining sausage and spinach. Ladle egg and milk mixture evenly over casserole. Top with the remaining cheese."
    },
    {
      "position": 8,
      "text": "Wrap tightly and place in the refrigerator overnight."
    },
    {
      "position": 9,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 10,
      "text": "Bake strata in the preheated oven until top is lightly browned, and an instant read thermometer inserted into the center reaches 150 degrees F (66 degrees C), about 1 hour 15 minutes."
    },
    {
      "position": 11,
      "text": "Let strata rest for 10 to 15 minutes before serving."
    }
  ],
  "servings": 8,

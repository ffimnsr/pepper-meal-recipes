  "id": "4ed7f687-2696-5b26-a777-d962115317e1",
  "slug": "chicken-potato-soup",
  "name": "Chicken Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This hearty chicken potato soup is a great alternative to chicken noodle soup. With celery, carrots, and potatoes, it's a comforting meal for colder days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large soup pot over medium-high heat. Season chicken with seasoned salt and pepper, add to the pot, and cook, stirring occasionally, until no longer pink in the center, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add onion and cook until almost translucent, about 5 minutes. Add garlic and cook until slightly browned, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Stir in broth, water, potatoes, carrots, and celery; cook until potatoes and carrots are tender, 15 to 20 minutes. Taste and adjust seasoning with salt, pepper, and cayenne."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

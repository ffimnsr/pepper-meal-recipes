  "id": "5a3bc672-63bb-5e3a-b9bc-3c813783fe31",
  "slug": "hillshire-farm-sausage-alfredo",
  "name": "Hillshire Farm Sausage Alfredo",
  "recipe_type": "main",
  "brief_description": "This creamy sausage Alfredo pasta dish gets flavor from Cajun seasoning and smoked sausage. It\u2019s an easy dinner that\u2019s ready in about 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook, stirring occasionally, until tender yet firm to the bite, about 10 minutes depending on shape and package directions; drain and set aside."
    },
    {
      "position": 2,
      "text": "While pasta is cooking, saut\u00e9 sausage in a large skillet over medium-high heat for 5 minutes, turning occasionally."
    },
    {
      "position": 3,
      "text": "Add cream and Cajun seasoning; bring to a boil. Reduce heat and simmer gently until mixture begins to thicken, 3 to 4 minutes. Remove from heat and stir in Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Add pasta to sauce and toss to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

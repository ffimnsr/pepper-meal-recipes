  "id": "1d9acea8-bedf-50d9-a107-032c0e0a8ea6",
  "slug": "rosemary-garlic-white-bean-soup-recipe-11938407",
  "name": "Rosemary Garlic White Bean Soup",
  "recipe_type": "appetizer",
  "brief_description": "This velvety rosemary garlic white bean soup is simmered in bone broth and brightened with fresh lemon. It\u2019s garnished with tender cannellini beans and shaved Parmesan for texture and depth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in a stockpot over medium high heat until shimmering. Add onion and carrot, and cook and stir for 4 to 5 minutes. Add garlic; cook until fragrant, 30 to 45 seconds. Remove pan from heat."
    },
    {
      "position": 2,
      "text": "Rinse and drain cannellini beans. Add half the chicken bone broth to a heavy duty blender, like a Vitamix. Add 1 1/2 can cannellini beans and onion mixture to blender; carefully blend on High until smooth, about 45 seconds."
    },
    {
      "position": 3,
      "text": "Transfer blended mixture back to stockpot; add remaining chicken bone broth. Add rosemary sprig and turn heat to medium-low. Simmer soup about 8 minutes. Remove rosemary sprig."
    },
    {
      "position": 4,
      "text": "Add Parmesan cheese and stir until melted. Taste and season with white pepper and lemon juice."
    },
    {
      "position": 5,
      "text": "Meanwhile in a small skillet, heat remaining olive oil. Add remaining 1/2 can cannellini beans. Allow beans to heat thoroughly being careful not to burn."
    },
    {
      "position": 6,
      "text": "Ladle pur\u00e9ed soup into bowls. Divide heated beans evenly over each serving, sprinkle with Parmesan cheese, and garnish with rosemary. Drizzle with olive oil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

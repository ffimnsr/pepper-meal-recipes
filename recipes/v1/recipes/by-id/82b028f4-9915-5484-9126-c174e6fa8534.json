  "slug": "slow-cooker-potluck-spareribs",
  "name": "Slow Cooker Potluck Spare Ribs",
  "recipe_type": "dessert",
  "brief_description": "These potluck-favorite crockpot spare ribs are ready after just 5 hours of simmering in your slow cooker with a delicious blend of spices and condiments.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Put spare ribs into the bottom of a slow cooker. Top with ketchup, brown sugar, vinegar, honey, soy sauce, ginger, salt, mustard, garlic powder, and black pepper."
    },
    {
      "position": 3,
      "text": "Cover and cook on High for 5 hours."
    }
  ],
  "servings": 12,

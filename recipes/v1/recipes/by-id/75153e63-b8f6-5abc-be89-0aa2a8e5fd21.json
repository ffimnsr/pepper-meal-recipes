  "name": "Picante Chicken",
  "recipe_type": "main",
  "brief_description": "Just simmer chicken breasts in your favorite salsa for an easy, zesty entree.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Open jar of picante sauce and put into a large saucepan. Add chicken breasts to picante sauce and bring to a steady boil. Boil gently for 20 to 25 minutes or until the chicken is no longer pink inside and the juices run clear."
    }

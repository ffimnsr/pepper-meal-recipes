  "id": "c4daee10-9e3f-5569-b02f-b78fcd056510",
  "slug": "no-bake-key-lime-pie",
  "name": "No Bake Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "Lemonade is brought to a boil on the stove, with lime gelatin, cream cheese, and whipped topping stirred in. This creamy, citrusy filling is poured into a graham cracker crust and slipped into the fridge or the freezer -your choice.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat the lemonade and the water to boiling. Add the gelatin and the cream cheese and blend well."
    },
    {
      "position": 2,
      "text": "Fold in the non-dairy whipped topping."
    },
    {
      "position": 3,
      "text": "Pour mixture into the pie shell and chill or freeze. It's a breeze!"
    }
  ],

  "id": "4063edf1-6588-5344-9fb7-3ce0ebe7f8bb",
  "slug": "puttanesca-pasta-bake-recipe-11765835",
  "name": "Puttanesca Pasta Bake",
  "recipe_type": "side",
  "brief_description": "This puttanesca pasta bake is a great variation of the classic Italian pasta with capers, olives, anchovy, and tomatoes. Serve with extra Parmesan cheese and sprinkle with fresh parsley.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Heat oil in a large saucepan over medium heat. Add garlic and anchovies and cook until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Add tomato paste and cook for 1 additional minute."
    },
    {
      "position": 4,
      "text": "Stir in crushed tomatoes, broth, oregano, black pepper, salt, and crushed red pepper. Bring to a boil, reduce heat, and simmer until mixture becomes saucy, stirring occasionally, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, cook pasta to al dente according to package directions. Drain and set aside."
    },
    {
      "position": 6,
      "text": "Add olives and capers to tomato sauce."
    },
    {
      "position": 7,
      "text": "Gently stir cooked pasta into sauce until fully coated."
    },
    {
      "position": 8,
      "text": "Transfer pasta mixture to a 9x13-inch baking dish. Top with mozzarella and Parmesan cheeses. Bake in the preheated oven until cheese is melted, about 10 minutes."
    },
    {
      "position": 9,
      "text": "Top each serving with parsley. Recipe developed by Barrett Heald."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

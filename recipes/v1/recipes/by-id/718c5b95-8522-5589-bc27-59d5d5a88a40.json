  "id": "718c5b95-8522-5589-bc27-59d5d5a88a40",
  "slug": "creamy-frosting",
  "name": "Creamy Frosting",
  "recipe_type": "dessert",
  "brief_description": "Make frosting without powdered sugar with this quick, easy recipe. This vanilla frosting is light, creamy, and perfect for icing cupcakes and cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together milk and flour in a small saucepan until smooth."
    },
    {
      "position": 3,
      "text": "Cook and stir over medium heat until it boils and thickens. Set aside to cool thoroughly."
    },
    {
      "position": 4,
      "text": "Cream butter, sugar, and vanilla in a medium bowl until light and fluffy."
    },
    {
      "position": 5,
      "text": "Add thickened, cooled milk. Beat until mixture resembles whipped cream."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "b601f42e-4cd4-5879-92e4-d82939c9972d",
  "slug": "mmm-mmm-better-brownies",
  "name": "Mmm-Mmm Better Brownies",
  "recipe_type": "dessert",
  "brief_description": "A brownie recipe with oil, cocoa powder, flour, and eggs that's easy to make. Chopped walnuts add a nice crunch factor to this very chocolaty treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Mix sugar, oil, and vanilla together in a medium bowl; beat in eggs until well combined."
    },
    {
      "position": 3,
      "text": "Mix flour, cocoa, baking powder, and salt together in a separate bowl; gradually stir into egg mixture until well blended. Stir in walnuts."
    },
    {
      "position": 4,
      "text": "Spread the batter evenly into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the brownie begins to pull away from the edges of the pan, about 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "Let cool on a wire rack before cutting into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

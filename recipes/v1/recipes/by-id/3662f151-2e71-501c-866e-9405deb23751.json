  "slug": "guavarita-guava-margarita-recipe-8780541",
  "name": "Guavarita (Guava Margarita)",
  "recipe_type": "drink",
  "brief_description": "This guavarita, or guava margarita, made with guava nectar, tequila, and agave syrup, is simply delicious.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Pour salt onto a plate. Rub lime wedge around the rim of a glass, and dip the rim of the glass in the salt."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice. Add guava nectar, tequila, Cointreau, lime juice, and agave syrup. Close the shaker and shake until the outside of the shaker is frosted, about 30 seconds. Pour into the salted glass."
    }
  ],
  "servings": 1,

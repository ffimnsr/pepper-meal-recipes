  "id": "1fb9faf2-6caa-5704-8a43-6f350fd6ade4",
  "slug": "bengali-dhal",
  "name": "Bengali Dhal",
  "recipe_type": "main",
  "brief_description": "Red lentils are flavored with caramelized onions, cherry tomatoes, and chopped cilantro in this colorful Indian-inspired dhal dish.",
  "cuisine": "Bangladeshi",
  "instructions": [
    {
      "position": 1,
      "text": "Wash lentils in a strainer. Combine lentils and water in a saucepan over medium-high heat. Add 1/2 of the sliced onions and garlic, reserving the rest for later. Stir in turmeric, bay leaf, tomatoes, and salt. Add chiles, leaving them whole to add flavor or cut in half to add heat. When mixture begins to boil, reduce heat to a simmer; cook until lentils break apart and thicken slightly, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a skillet, heat vegetable oil over medium heat until oil shimmers. Add reserved sliced onions; cook and stir until onion has softened and translucent, about 5 minutes. Reduce heat to medium-low; continue cooking and stirring until onion is very tender and dark brown, 15 to 20 minutes more. Stir in reserved garlic and cook, stirring constantly, until garlic is fragrant and tender, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Add onion-garlic mixture into cooked lentils and stir. Garnish with chopped cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

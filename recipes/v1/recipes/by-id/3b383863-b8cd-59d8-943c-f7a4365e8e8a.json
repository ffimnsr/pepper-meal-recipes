  "id": "3b383863-b8cd-59d8-943c-f7a4365e8e8a",
  "slug": "gingerbread-gooey-butter-cookies",
  "name": "Gingerbread Gooey Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These gingerbread-flavored gooey butter cookies are Christmas cookie perfection--just the right amount of sweetness and the perfect spice blend.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 1/4 cups plus 1 tablespoon flour, ginger, baking powder, cinnamon, baking soda, allspice, nutmeg, and ground cloves in a bowl. Whisk to combine, then set aside."
    },
    {
      "position": 2,
      "text": "Combine cream cheese and butter in the bowl of a stand mixer. Blend on medium-high speed until smooth and creamy. Add white and brown sugar, molasses, vanilla extract, almond extract, and salt. Blend on medium-high speed until smooth. Add in egg and egg yolk and blend again on medium speed, 1 to 2 minutes. Scrape down the sides as necessary."
    },
    {
      "position": 3,
      "text": "Add the dry mixture slowly just until dough is blended, scraping down sides as necessary. Dough will be very soft. Cover work bowl with plastic wrap and refrigerate for at least 2 hours, up to overnight, to allow dough to chill and firm."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line baking sheets with Silpat\u00ae mat or parchment paper."
    },
    {
      "position": 5,
      "text": "Roll dough into approximately walnut-sized balls. Pour confectioners' sugar into a bowl and roll dough balls in the sugar until very well coated. Set on the prepared baking sheet, leaving 1 1/2 to 2 inches of space in between, about 8 to 12 cookies per sheet, depending on how large you decide to make the cookies."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the edges are just starting to firm and become golden browned and the center looks mostly set, 15 to 17 minutes. Cool on baking sheet for 2 minutes before carefully transferring to a wire rack to cool. This should yield a chewy cookie with slightly crispy edges. Repeat with remaining cookie dough."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,

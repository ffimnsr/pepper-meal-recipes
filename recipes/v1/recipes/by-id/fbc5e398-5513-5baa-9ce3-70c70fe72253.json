  "slug": "2-ingredient-thin-mint-cookies-recipe-12058014",
  "name": "2-Ingredient Thin Mints",
  "recipe_type": "dessert",
  "brief_description": "Satisfying, crunchy Thin Mints-inspired cookies are ready in under 30 minutes with just two ingredients\u2014buttery Ritz crackers and Andes mints. You\u2019ll be surprised at how easy they are to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate mints in a microwave- safe bowl and microwave for 1 to 1 1/2 minutes, stirring every 25 to 30 seconds until melted and smooth."
    },
    {
      "position": 2,
      "text": "Dip each cracker in melted chocolate and remove with a fork. Allow any excess chocolate dip back into the bowl; place dipped crackers on waxed paper or parchment paper."
    },
    {
      "position": 3,
      "text": "Refrigerate 5 minutes to set or allow to sit at room temperature until chocolate is hardened, about 15 minutes"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

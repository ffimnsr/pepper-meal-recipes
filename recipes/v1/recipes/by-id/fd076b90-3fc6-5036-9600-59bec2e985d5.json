  "id": "fd076b90-3fc6-5036-9600-59bec2e985d5",
  "slug": "marinated-mushrooms-for-antipasto",
  "name": "Marinated Mushrooms for Antipasto",
  "recipe_type": "appetizer",
  "brief_description": "These Italian marinated mushrooms are perfect for an antipasto plate and are easy to prepare. They marinate for at least 5 hours, so make ahead for a dinner party.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add mushrooms and cook until softened, about 10 minutes. Drain and set aside to cool."
    },
    {
      "position": 2,
      "text": "Combine olive oil, white wine vinegar, red onion, oregano, thyme, garlic, salt, and pepper in a large jar with a lid. Close the jar and shake well. Add cooked mushrooms and refrigerate at least 5 hours. Remove from refrigerator 10 minutes prior to serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

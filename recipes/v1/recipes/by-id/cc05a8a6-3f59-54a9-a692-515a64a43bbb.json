  "id": "cc05a8a6-3f59-54a9-a692-515a64a43bbb",
  "slug": "quick-hawaiian-haystacks",
  "name": "Quick Hawaiian Haystacks",
  "recipe_type": "main",
  "brief_description": "Hawaiian haystacks are ready in less than 30 minutes and are a fun way to use up leftover rice, chicken, veggies, and coconut for a weeknight dinner.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix chicken soup and chicken together in a saucepan; stir in enough milk to make a gravy-like consistency. Cook and stir chicken sauce over medium heat until smooth and heated through, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Spoon 1/2 cup rice onto each of 8 plates. Layer each serving of rice with chow mein noodles, chicken mixture, pineapple, Cheddar cheese, celery, green peppers, green onions, coconut, almonds, and a drizzle of soy sauce, respectively."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

  "schema_version": 1,
  "id": "65bebe08-831e-5dd9-98d2-1e8d17922b72",
  "slug": "moms-goulash-in-the-microwave",
  "name": "Mom's Goulash in the Microwave",
  "recipe_type": "soup",
  "brief_description": "An excellent ground beef goulash in rich tomato sauce is prepared almost entirely in the microwave. A quick and easy meal that is on the table in record time.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of lightly salted water to a boil. Add the macaroni, and cook until tender, about 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, crumble the ground beef into a 2 quart or larger casserole dish. Add the onion, celery and garlic. Cook in the microwave on High for 5 to 6 minutes, or until beef is no longer pink. Stir once during cooking. Drain off the grease."
    },
    {
      "position": 3,
      "text": "Stir the tomatoes, tomato sauce and sugar into the beef, and season with paprika, oregano, caraway seed, cayenne pepper and salt. Cover, and cook in the microwave on power level 8 for about 14 minutes, or until celery is tender and the flavors have blended."
    },
    {
      "position": 4,
      "text": "Remove from the microwave, and mix in the cooked macaroni. Cook for 2 to 3 more minutes, until heated through. Serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

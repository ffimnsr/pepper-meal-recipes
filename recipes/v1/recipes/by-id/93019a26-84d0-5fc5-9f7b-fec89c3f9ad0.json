  "id": "93019a26-84d0-5fc5-9f7b-fec89c3f9ad0",
  "slug": "puerto-rican-tostones-fried-plantains",
  "name": "Puerto Rican Tostones (Fried Plantains)",
  "recipe_type": "appetizer",
  "brief_description": "Tostones are twice-fried crispy slices of green plantain that are lightly seasoned with salt for a delicious Caribbean-style appetizer or side dish.",
  "cuisine": "Puerto Rican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Peel plantain and cut into 1-inch slices. Fill a bowl with 3 cups of cold water."
    },
    {
      "position": 3,
      "text": "Heat oil in a large deep skillet over medium-high heat; add plantain slices in an even layer and fry on both sides until golden brown, about 3 1/2 minutes per side. Set skillet aside."
    },
    {
      "position": 4,
      "text": "Transfer plantain slices to a chopping board; flatten each one by placing a small plate on top and pressing down."
    },
    {
      "position": 5,
      "text": "Dip plantain slices in cold water."
    },
    {
      "position": 6,
      "text": "Reheat oil in the skillet over medium heat; cook plantain slices for 1 minute on each side."
    },
    {
      "position": 7,
      "text": "Season to taste with salt and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

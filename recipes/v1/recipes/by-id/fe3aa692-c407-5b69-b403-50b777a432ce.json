  "id": "fe3aa692-c407-5b69-b403-50b777a432ce",
  "slug": "lemon-squares-i",
  "name": "Lemon Squares I",
  "recipe_type": "dessert",
  "brief_description": "These lemon-walnut bars are a perfect treat for a hot summer day--or any time you want a blast of citrus sunshine.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (160 degrees C). Grease a 9x13 inch pan."
    },
    {
      "position": 2,
      "text": "To make crust: In a large mixing bowl, beat together the butter, 2 cups of the flour, and confectioners' sugar until fluffy. Scrape mixture into the pan and smooth. Bake 15 minutes."
    },
    {
      "position": 3,
      "text": "In a medium bowl, beat the eggs and sugar. Grate the rind of the lemon and add the rind, along with 6 tablespoons of lemon juice, to the egg mixture. Sprinkle 1 tablespoon of flour and the baking powder over the mixture. Fold in the nuts and mix until well blended. Pour the lemon mixture into the crust."
    },
    {
      "position": 4,
      "text": "Bake for another 35 minutes, until filling is set. Let cool before cutting."
    }
  ],
  "servings": 24,

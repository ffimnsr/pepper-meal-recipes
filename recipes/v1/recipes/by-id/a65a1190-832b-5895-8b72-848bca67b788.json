  "slug": "grandmas-tuna-casserole-with-potato-chips-and-no-noodles",
  "name": "Grandma's Tuna Casserole with Potato Chips and No Noodles",
  "recipe_type": "snack",
  "brief_description": "This old-school recipe for one grandma's tuna casserole is super easy, using just potato chips (no noodles!) and canned goods you most likely have in your pantry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Crush potato chips into a large bowl. Add green beans, condensed soup, and tuna and mix until well combined. Pack into a 10x14-inch casserole dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the top is crispy, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

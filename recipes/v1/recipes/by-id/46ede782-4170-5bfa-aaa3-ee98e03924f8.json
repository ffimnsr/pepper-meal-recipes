  "id": "46ede782-4170-5bfa-aaa3-ee98e03924f8",
  "slug": "joes-fusion-chicken-pad-thai",
  "name": "Joe's Fusion Chicken Pad Thai",
  "recipe_type": "main",
  "brief_description": "This chicken pad Thai's creative ingredients like peanut butter put a spin on the traditional Thai flavors.",
  "cuisine": "Asian Inspired American Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil."
    },
    {
      "position": 2,
      "text": "Season chicken with salt and black pepper; set aside."
    },
    {
      "position": 3,
      "text": "Whisk sugar, cayenne pepper, white wine vinegar, fish sauce, and peanut butter together in a bowl."
    },
    {
      "position": 4,
      "text": "Coat the inside of a large skillet or wok with olive oil and place over high heat."
    },
    {
      "position": 5,
      "text": "Cook and stir chicken in the hot oil just until the meat is white outside but still pink inside, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Remove chicken and set aside in a bowl."
    },
    {
      "position": 7,
      "text": "Lower the heat under the skillet to medium-low. Cook and stir garlic in the skillet until it becomes translucent, 1 to 2 minutes."
    },
    {
      "position": 8,
      "text": "Cook and stir eggs into garlic until loosely cooked, 2 to 3 minutes."
    },
    {
      "position": 9,
      "text": "Pour peanut sauce into the garlic and eggs, and stir to combine. Bring sauce to a simmer."
    },
    {
      "position": 10,
      "text": "Stir rice noodles into the boiling water. Cook until noodles are still slightly tough, about 5 minutes."
    },
    {
      "position": 11,
      "text": "Drain the noodles."
    },
    {
      "position": 12,
      "text": "Return chicken to the skillet with eggs and sauce. Simmer until chicken is no longer pink in the center and the juices run clear, stirring frequently, 5 to 8 more minutes."
    },
    {
      "position": 13,
      "text": "Stir bean sprouts, rice noodles. and beef broth into the skillet. Bring to a simmer, and cook until noodles are tender and most of the broth has been absorbed, about 10 minutes."
    },
    {
      "position": 14,
      "text": "Sprinkle with green onions to serve.."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

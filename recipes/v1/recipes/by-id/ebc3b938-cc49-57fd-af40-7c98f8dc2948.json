  "id": "ebc3b938-cc49-57fd-af40-7c98f8dc2948",
  "slug": "warm-grilled-red-cabbage-slaw",
  "name": "Warm Grilled Red Cabbage Slaw",
  "recipe_type": null,
  "brief_description": "This red cabbage slaw is made on the grill and flavored with apples, maple syrup, and apple cider vinegar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat grill to medium high heat to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour olive oil into a grill pan and saut\u00e9 onion for 2 minutes. Add chopped apples, maple syrup, apple cider vinegar, garlic powder, and onion powder to the grill pan and stir until mixed."
    },
    {
      "position": 3,
      "text": "Reduce heat to low at 300 degrees F (150 degrees C). Add red cabbage to the grill pan and cook until cabbage is wilted and lightly tender, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat and add parsley. Enjoy warm."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fe0d2dcf-094b-54fb-a706-23b3dd7eb7ed",
  "slug": "mango-peach-and-pineapple-salsa",
  "name": "Mango, Peach, and Pineapple Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This fruity peach mango salsa with pineapple, bell peppers, tomatoes, and jalape\u00f1o adds just the right amount of sweet and spicy to any main dish.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place mangos, peaches, tomatoes, onion, red pepper, yellow pepper, pineapple, and cilantro in a large bowl. Stir in water, sugar, lime juice, jalape\u00f1o, garlic, and salt until well combined."
    },
    {
      "position": 2,
      "text": "For best flavor, cover and refrigerate until chilled before serving."
    }
  ],
  "servings": 16,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6cc069ba-7529-5f71-b9fa-75ede0c26738",
  "slug": "pineapple-upside-down-cookies-recipe-11955833",
  "name": "Pineapple Upside-Down Cookies",
  "recipe_type": "dessert",
  "brief_description": "These pineapple upside-down cookies are a bit of a project to make, but they\u2019re tasty, and a fun departure from the usual run-of-the-mill cookie. Cookie dough baked on top of a pineapple slice with a maraschino cherry flips over to reveal the classic look - in a cookie!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place butter in a light-colored saucepan over medium-low heat. Cook, stirring constantly, until butter smells nutty and has turned an amber color, 5 to 7 minutes. Pour browned butter into a large mixing bowl, and set aside to cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 3,
      "text": "Mix 3 tablespoons brown sugar and cornstarch together in a small bowl. Dredge each pineapple slice in the cornstarch mixture, making sure both sides of each slice are well coated, then place onto the prepared baking sheets (6 pineapple slices per baking sheet, spaced several inches apart)."
    },
    {
      "position": 4,
      "text": "Bake pineapple slices in the preheated oven for 10 minutes. Remove from the oven and allow to cool. Keep the oven on at 400 degrees F (200 degrees C)."
    },
    {
      "position": 5,
      "text": "To the mixing bowl with brown butter, add remaining 3/4 cup brown sugar, white sugar, salt, cinnamon, nutmeg, egg yolk, pineapple juice, and vanilla, and whisk until thoroughly smooth and combined, about 1 to 2 minutes. Add flour, baking soda, and baking powder and stir until incorporated; using your hands if needed to mix it in completely. Dough will be thick, and seem somewhat dry."
    },
    {
      "position": 6,
      "text": "Divide dough into 12 pieces and roll into balls, about 2 tablespoons each. If dough breaks apart, just keep pressing it back together as much as needed until it holds its shape. Flatten each ball into a disc about 1/2-inch thick; again, press dough back together as needed if it breaks."
    },
    {
      "position": 7,
      "text": "Place a maraschino cherry half in the center of each one of the pineapple slices. Top each pineapple slice with a disc of dough, pressing down slightly to adhere."
    },
    {
      "position": 8,
      "text": "Bake 1 pan at a time in the preheated oven until golden brown and appear mostly set, 13 to 17 minutes. Remove from the oven and allow cookies to cool for 15 minutes on the pan, then carefully flip over onto a cooling rack to cool completely. Store extra cookies in the refrigerator to prevent them from getting soggy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 35,

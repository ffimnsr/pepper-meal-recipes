  "id": "a92a1c08-3f11-51aa-8fbf-6b8318c32fa9",
  "slug": "chocolate-banana-muffins",
  "name": "Chocolate Banana Muffins",
  "recipe_type": "dessert",
  "brief_description": "These chocolate banana muffins dial up on banana and chocolate flavor and use less sugar. They're so moist, full of flavor, and easy to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a12-cup muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Combine flour, cocoa, baking powder, baking soda, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk sugar, oil, milk, egg, and vanilla extract together in a separate bowl until smooth."
    },
    {
      "position": 4,
      "text": "Stir into flour mixture until just moistened. Fold in bananas and chocolate chips."
    },
    {
      "position": 5,
      "text": "Divide batter among the muffin cups, filling each about 3/4 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

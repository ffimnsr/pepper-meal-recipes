  "name": "Fruit Salad with Vanilla Yogurt",
  "recipe_type": "salad",
  "brief_description": "A bright, pretty salad with summer's sweet fruits has a ready-made dressing of low-fat vanilla yogurt.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large salad bowl, lightly mix together the strawberries, peach, plums, kiwi fruit, cherries, honeydew melon, cantaloupe, pineapple, and grapes until the fruit is well mixed. Serve in bowls with yogurt spooned over the top."
    }

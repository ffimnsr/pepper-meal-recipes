  "slug": "avocado-toast-vegan",
  "name": "Avocado Toast (Vegan)",
  "recipe_type": "appetizer",
  "brief_description": "This avocado toast recipe mashes avocado with lemon juice and parsley and spreads it on whole-grain toast for a hearty and delicious breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast bread in a toaster or toaster oven."
    },
    {
      "position": 2,
      "text": "Mash avocado, parsley, olive oil, lemon juice, salt, black pepper, onion powder, and garlic powder together in bowl using a potato masher; spread on top of toast slices."
    }
  ],
  "servings": 4,

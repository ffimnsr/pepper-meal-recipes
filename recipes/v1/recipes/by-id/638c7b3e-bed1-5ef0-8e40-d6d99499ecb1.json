  "id": "638c7b3e-bed1-5ef0-8e40-d6d99499ecb1",
  "slug": "lemon-orange-orange-roughy",
  "name": "Lemon-Orange Orange Roughy",
  "recipe_type": "drink",
  "brief_description": "This orange roughy recipe is quickly made in a pan with fresh lemon and orange juices \u2014 a delicious preparation for this mild-flavored white fish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat."
    },
    {
      "position": 2,
      "text": "Place fillets into hot oil. Drizzle with orange juice and lemon juice, then sprinkle fillets with lemon pepper. Cook until fish flakes easily with a fork, 2 to 3 minutes per side. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

  "id": "57b6b373-3660-57c2-ac47-a6f5b9c0cb98",
  "slug": "chocolate-chess-pie-ii",
  "name": "Chocolate Chess Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy chocolate chess pie has a rich and gooey chocolate filling made with evaporated milk, eggs, butter, and cocoa for a decadent dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix sugar and cocoa together in a large bowl. Beat eggs in a medium bowl with an electric mixer until light and fluffy; stir into cocoa mixture. Beat in evaporated milk, butter, and vanilla. Pour mixture into unbaked pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, about 45 minutes. Let cool before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

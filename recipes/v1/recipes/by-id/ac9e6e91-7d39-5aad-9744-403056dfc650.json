  "id": "ac9e6e91-7d39-5aad-9744-403056dfc650",
  "slug": "5-hour-beef-stew",
  "name": "5-Hour Beef Stew",
  "recipe_type": "soup",
  "brief_description": "In this beef stew, tapioca is used as a thickener to make it extra rich and delicious as it cooks low and slow in your oven for a total of five hours.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Place beef into a roasting pan. Stir in potatoes, tomato-vegetable juice cocktail, carrots, celery, onion, tapioca, sugar, salt, and pepper. Cover the pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until beef and potatoes are tender, about 5 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 25,

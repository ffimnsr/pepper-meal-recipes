  "id": "46d3c840-9929-55ea-b75f-66525cb58db8",
  "slug": "basic-gingerbread-cookies",
  "name": "Basic Gingerbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "The dough for these basic gingerbread cookies doesn't need to be chilled before you can roll it out, so make sure you have those cookie cutters ready!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 baking trays."
    },
    {
      "position": 2,
      "text": "Sift flour, ginger, and baking soda together into a large bowl. Add butter chunks and stir until they are coated with flour. Mix the butter and flour together with your hands until mixture resembles fine bread crumbs."
    },
    {
      "position": 3,
      "text": "Whisk white and brown sugars, maple syrup, egg, and oil together in a small bowl until combined. Add to flour mixture and knead until a ball of dough forms, adding water, if needed."
    },
    {
      "position": 4,
      "text": "Roll dough on a lightly floured surface to 1/4-inch thickness, cut into desired shapes with cookie cutters, and place on the prepared cookie sheets. Repeat until you have used all the dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes. Let cookies cool on sheets for 5 minutes, then remove to a wire rack."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

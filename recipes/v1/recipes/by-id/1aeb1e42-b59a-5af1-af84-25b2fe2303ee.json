  "id": "1aeb1e42-b59a-5af1-af84-25b2fe2303ee",
  "slug": "simple-flourless-apple-crisp",
  "name": "Simple Flourless Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "This simple flourless apple crisp recipe comes together quickly for a satisfyingly sweet treat for those looking to avoid gluten or cut back on carbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange apple slices in a 9-inch circular glass pie plate. Stir oats, sugar, and cinnamon together in a bowl."
    },
    {
      "position": 3,
      "text": "Microwave butter in 5-second increments until melted, about 20 seconds. Stir melted butter, honey, and oil into oat mixture; crumble over apples."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 35 minutes. Cool on a wire cooling rack, about 45 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

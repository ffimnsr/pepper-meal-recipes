  "id": "f75a9b68-74b3-57d2-b9b4-1eaab4ea05ac",
  "slug": "spinach-and-artichoke-dip",
  "name": "Spinach and Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This easy spinach and artichoke dip is sure to be a hit at your next party. It's creamy, cheesy, and oh-so-good on crackers, pita chips, or toasted bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 1-quart baking dish."
    },
    {
      "position": 2,
      "text": "Combine artichoke hearts, spinach, and mayonnaise in a bowl; mix in 2 cups Monterey Jack, then mix in Parmesan. Transfer to the prepared baking dish and sprinkle with remaining 1/2 cup Monterey Jack."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

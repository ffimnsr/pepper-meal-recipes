{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "46b56f92-facd-5bfc-9cc1-0c8b9f66ef45",
  "slug": "pear-galette-with-ginger-recipe-7693661",
  "name": "Pear Galette with Ginger",
  "recipe_type": "dessert",
  "brief_description": "This pear galette is an informal, rustic pie, made free-form, without a pie pan. Using red pears provides a beautriful color, but Bosc or Anjou pears work just as well. Candied ginger adds a special touch, along with a tiny amount of bourbon.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a sheet pan with parchment paper. Sprinkle about 1/2 tablespoon flour in the center of the pan."
    },
    {
      "position": 2,
      "text": "Following manufacturer\u2019s instructions, bring refrigerated pie crust to room temperature."
    },
    {
      "position": 3,
      "text": "In a medium mixing bowl, toss pear slices with lemon juice. In a small bowl, combine brown sugar, cornstarch, ground ginger, and salt. Sprinkle dry ingredients over pear slices and toss to coat."
    },
    {
      "position": 4,
      "text": "Unroll pie crust and place in the center of the prepared pan. Sprinkle remaining flour over crust, and roll into a 12-inch circle."
    },
    {
      "position": 5,
      "text": "Beginning 2 inches from the edge of the pie crust, arrange pears on the dough in a pleasing design all the way around. Stack any extra slices in the center. Dot with butter, and drizzle any remaining juices in the bowl over the sliced pears."
    },
    {
      "position": 6,
      "text": "Fold the edges of the crust over pears, making a pleat every few inches, as necessary. If the pleats don\u2019t want to hold, lightly moisten with wet fingertips. Lightly brush crust with beaten egg."
    },
    {
      "position": 7,
      "text": "Bake in the center of the preheated oven until crust is brown and pears are bubbly, 35 to 40 minutes."
    },
    {
      "position": 8,
      "text": "Remove galette from the oven. Stir pear or lemon curd together with bourbon in a microwave-safe bowl. Microwave on High until mixture bubbles, about 1 minute. Brush mixture over pear filling. Sprinkle candied ginger over all."
    },
    {
      "position": 9,
      "text": "Using the parchment paper, slide the galette onto a cooling rack and allow to cool completely."
    },
    {
      "position": 10,
      "text": "When ready to serve, use parchment paper to transfer to a serving dish or cutting board, then hold the galette in place and slide the parchment paper out. Cut into 8 wedges and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,

  "id": "014fd859-4ecf-53df-a210-4a745d6df418",
  "slug": "tomato-soup-with-gnocchi-recipe-11971112",
  "name": "Tomato Soup with Gnocchi",
  "recipe_type": "soup",
  "brief_description": "This tomato soup is made with fresh and canned tomatoes, fresh zucchini, and gnocchi. A bit of Greek yogurt makes it creamy. Replete with herbs and garlic, it is far from humble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Add onion and saut\u00e9 until soft and translucent, 5 to 6 minutes. Add garlic for the last minute and cook until fragrant."
    },
    {
      "position": 2,
      "text": "Add crushed tomatoes, fresh diced tomatoes, tomato juice, chicken bone broth, red wine vinegar, Cantanzaro herbs, and sugar. Bring to a gentle simmer and cook uncovered for 12 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and blend until smooth using an immersion blender (or carefully transfer to a blender in batches)."
    },
    {
      "position": 4,
      "text": "Add gnocchi and zucchini; cook for 12 minutes. Turn off the heat and let the soup cool for 5 minutes. Stir in Greek yogurt, 1 tablespoon at a time, until soup is completely smooth and creamy. Stir in most of the chopped basil and parsley. Season with salt and pepper to taste. Garnish bowls with remaining herbs. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

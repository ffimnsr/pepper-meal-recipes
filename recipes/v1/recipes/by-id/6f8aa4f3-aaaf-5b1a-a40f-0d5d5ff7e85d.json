  "id": "6f8aa4f3-aaaf-5b1a-a40f-0d5d5ff7e85d",
  "slug": "sausage-stuffed-potato-pancakes",
  "name": "Sausage-Stuffed Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Chef John's sausage-stuffed potato pancakes are as fun to eat as they are easy to prepare, and they're perfect for breakfast or brunch!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Divide sausage into 6 equal pieces, and press between plastic wrap to flatten into discs about 2 1/2 inches round and about 1/8 inch thick. Keep in the refrigerator until needed."
    },
    {
      "position": 2,
      "text": "Grate potatoes and transfer into a large bowl of cold water. Stir the grated potatoes with your hand for a few seconds, and then drain the potatoes in a strainer. Using your hands and/or a towel, squeeze out as much water as possible."
    },
    {
      "position": 3,
      "text": "Transfer the potatoes to a mixing bowl. Add salt, black pepper, cayenne, flour, and egg; mix thoroughly."
    },
    {
      "position": 4,
      "text": "Heat oil in large nonstick pan over medium-high heat. For each pancake, place down about 3 tablespoons of the potato mixture. Reduce heat to medium; top each pancake with a sausage patty, pressing it down lightly into the surface. Top each sausage patty with another heaping tablespoon of potato mixture and spread over the top until the sausage is covered. Flatten down with a spoon or spatula."
    },
    {
      "position": 5,
      "text": "Cook the first side until very well browned, about 5 minutes. Flip and cook the other side until browned, the sausage is no longer pink, and potatoes are tender, about 5 minutes more. Serve with diced roasted red peppers, sour cream, and fresh chives."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

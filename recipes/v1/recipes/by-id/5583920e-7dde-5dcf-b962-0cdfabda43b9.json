  "id": "5583920e-7dde-5dcf-b962-0cdfabda43b9",
  "slug": "chocolate-cherry-biscotti",
  "name": "Chocolate Cherry Biscotti",
  "recipe_type": "dessert",
  "brief_description": "These are one of my favorites. I make them every holiday season. They are great for mailing and keep for weeks!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a large cookie sheet."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and sugar until smooth. Beat in the eggs one at a time, then stir in the almond extract. Combine the flour and baking powder; stir into the creamed mixture until just blended. Mix in candied cherries and mini chocolate chips."
    },
    {
      "position": 3,
      "text": "With lightly floured hands, shape dough into two 10 inch long loaves. Place rolls 5 inches apart on the prepared cookie sheet; flatten each to 3 inch width."
    },
    {
      "position": 4,
      "text": "Bake for 20 to 25 minutes, or until set and light golden brown. Cool 10 minutes. Using a serrated knife, cut loaves diagonally into 1/2 inch slices. Arrange slices cut side down on ungreased cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake for 8 to 10 minutes, or until bottoms begin to brown. Turn, and bake an additional 5 minutes, or until browned and crisp. Cool completely. Melt white chocolate in the microwave, stirring every 20 to 30 seconds until smooth. Drizzle cookies with melted white chocolate. Store in tightly covered container."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,

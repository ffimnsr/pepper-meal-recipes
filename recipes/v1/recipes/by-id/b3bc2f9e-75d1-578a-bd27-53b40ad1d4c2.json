  "id": "b3bc2f9e-75d1-578a-bd27-53b40ad1d4c2",
  "slug": "pumpkin-stew",
  "name": "Pumpkin Stew",
  "recipe_type": "soup",
  "brief_description": "This tasty pumpkin stew recipe is perfect for an autumn potluck dinner. Impress your guests with this thick beef stew made and served in a pumpkin shell.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a large saucepan over medium-high heat. Add beef; cook until evenly brown. Stir in potatoes, carrots, onion, bell pepper, water, garlic, salt, and black pepper; bring to a boil. Reduce heat; simmer, about 2 hours. Dissolve bouillon into beef mixture; stir in tomatoes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Cut top off pumpkin, remove seeds and pulp, and transfer to a heavy baking pan. Fill pumpkin with beef mixture; brush outside of pumpkin with remaining 1 tablespoon oil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tender, 2 hours. Serve stew from pumpkin, scraping out some pumpkin flesh with each serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 260,
  "preparation_time_minutes": 25,

  "id": "6f327775-f53a-5494-af4c-8b42dec39f13",
  "slug": "stuffed-eggplant-parmesan",
  "name": "Stuffed Eggplant Parmesan",
  "recipe_type": "main",
  "brief_description": "This stuffed eggplant recipe features a filling of scooped-out flesh cooked with onion and garlic, topped with tomato sauce, cheese, and bread crumbs.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Roughly chop eggplant centers."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add chopped eggplant, onion, garlic, oregano, and black pepper: cook and stir until lightly browned."
    },
    {
      "position": 4,
      "text": "Spoon mixture into hollowed-out eggplants."
    },
    {
      "position": 5,
      "text": "Sprinkle each stuffed eggplant with Parmesan cheese, bread crumbs, and parsley. Place in a shallow baking dish. Cover with tomato sauce and mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until eggplant is fork-tender and cheese is bubbly, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cd8f77fc-69d0-5193-9167-fc65051d268f",
  "slug": "my-favorite-pork-turkey-meatloaf",
  "name": "My Favorite Pork Turkey Meatloaf",
  "recipe_type": "main",
  "brief_description": "This tender meatloaf is speckled with vegetables. There's always enough for sandwiches the next day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Set the ground turkey and ground pork out at room temperature to warm slightly."
    },
    {
      "position": 3,
      "text": "Heat the oil in a skillet over medium heat; cook the carrot, bell pepper, onion, garlic, and spinach in the heated oil until soft; set aside to cool."
    },
    {
      "position": 4,
      "text": "Mix together the turkey, pork, bread crumbs, wheat germ, eggs, 2 tablespoons ketchup, salt, and pepper in a large bowl. Add the vegetable mixture and continue to mix until evenly combined; shape into a loaf; lay on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Whisk together the honey and 1 tablespoon ketchup in a small bowl; spread over the meatloaf."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until no longer pink in the center, 60 to 70 minutes; remove to a serving platter and allow to rest 5 minutes before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 25,
  "rest_time_minutes": 5,
  "difficulty": "hard",

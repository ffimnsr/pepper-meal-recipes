  "id": "61b7f791-e851-5d5b-ac6e-54328eb56d3c",
  "slug": "mediterranean-lentil-salad",
  "name": "Mediterranean Lentil Salad",
  "recipe_type": "salad",
  "brief_description": "This lentil salad made with tender brown lentils, carrots, red onion, celery, and a fresh lemon dressing is a delicious and nutritious salad.",
  "cuisine": "European American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine lentils, carrots, onion, garlic, bay leaf, and thyme in a saucepan. Add enough water to cover by 1 inch; bring to a boil, reduce heat and simmer uncovered for 15 to 20 minutes or until lentils are tender but not mushy."
    },
    {
      "position": 3,
      "text": "Drain lentils and vegetables and remove bay leaf. Add olive oil, lemon juice, celery, parsley, salt and pepper. Toss gently to mix and serve at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

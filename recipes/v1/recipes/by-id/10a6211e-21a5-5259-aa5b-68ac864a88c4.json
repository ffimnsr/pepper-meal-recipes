  "id": "10a6211e-21a5-5259-aa5b-68ac864a88c4",
  "slug": "cheese-garlic-biscuits-ii",
  "name": "Easy Cheese Garlic Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These tender cheese biscuits are topped with a garlic butter glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift flour, salt, and baking powder together into a large bowl. Cut in butter until the mixture resembles coarse crumbs. Make a well in the center; add milk and Cheddar cheese, and stir until combined. Drop batter by spoonfuls onto an ungreased baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, about 12 to 15 minutes. While biscuits are baking mix melted butter and minced garlic. Brush garlic butter over hot baked biscuits."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

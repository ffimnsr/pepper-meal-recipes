  "id": "0a9b6869-0655-5b82-ab7d-ef397d42c753",
  "slug": "creamy-spinach-polenta-recipe-12012119",
  "name": "Creamy Spinach Polenta",
  "recipe_type": "side",
  "brief_description": "This creamy polenta is loaded with Parmesan cheese, saut\u00e9ed spinach, and mushrooms for a rich side dish. Silky-smooth and satisfying, it pairs well with a variety of main dishes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add water, chicken broth, and salt to a large saucepan and bring to a boil. Gradually whisk in polenta until no lumps remain."
    },
    {
      "position": 2,
      "text": "Reduce heat to a simmer; whisking often, and cook until polenta starts to thicken, 3 to 4 minutes. Cover the pot and cook for 20 to 30 minutes, or follow package directions, Stir frequently and scrape the bottom to avoid burning, until consistency is creamy and tender. Your timing will depend on the polenta grind, so just keep an eye on it."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a skillet over medium heat. Add mushrooms, and saut\u00e9 for 4 to 5 minutes, stirring occasionally. Add garlic and cook until fragrant; stir in spinach, and cook until wilted, about 3 to 4 minutes; set aside."
    },
    {
      "position": 4,
      "text": "Stir butter and Parmesan into cooked polenta until melted. If polenta is a little thick, stir in more water or chicken broth. Stir in spinach-mushroom mixture until everything is well combined. Season with salt and pepper, garnish with grated Parmesan if desired, and serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

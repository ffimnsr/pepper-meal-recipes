  "id": "e265c39f-381e-5dc6-87b9-0aa349da0299",
  "slug": "mushroom-veggie-burger",
  "name": "Mushroom Veggie Burger",
  "recipe_type": "main",
  "brief_description": "These vegetarian mushroom burgers made with oats, bread crumbs, and Parmesan are pan-fried until golden, ready for your favorite burger toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a large skillet over medium heat. Add mushrooms, onion, garlic, salt, pepper, and oregano; cook and stir until mushrooms have released their juices and the liquid has evaporated, about 10 minutes. Remove from the heat."
    },
    {
      "position": 2,
      "text": "Transfer mushrooms to a cutting board and clean the skillet."
    },
    {
      "position": 3,
      "text": "Chop mushrooms into small chunks, then transfer to a large bowl. Mix in bread crumbs and oats, and season with salt and pepper as needed. Stir in Parmigiano-Reggiano cheese, then eggs; let stand until bread crumbs have absorbed any excess liquid, about 15 minutes. Use moist hands to form mixture, 1/4 cup at a time, into patties."
    },
    {
      "position": 4,
      "text": "Heat remaining 2 tablespoons oil in the skillet over medium heat. Pan-fry patties in the hot skillet until golden brown and cooked through, 2 \u00bd to 3 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

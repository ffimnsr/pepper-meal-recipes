  "id": "aff55630-b7bc-5a9e-a7c6-a24628255a04",
  "slug": "chinese-chicken-fried-rice-ii",
  "name": "Chicken Fried Rice",
  "recipe_type": "main",
  "brief_description": "This chicken fried rice recipe is easy to make with cooked chicken, leftover rice, shredded scrambled egg, and soy sauce for an incredibly tasty meal!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat egg and water together in small bowl. Melt butter in a large skillet or wok over medium-low heat; add egg and cook without stirring, 1 to 2 minutes. Remove egg from skillet and cut into shreds; set aside."
    },
    {
      "position": 3,
      "text": "Heat oil in the same skillet. Add onion; cook and stir until soft, about 3 minutes. Stir in rice, chicken, soy sauce, and pepper. Cook and stir for about 5 minutes; stir in shredded egg. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

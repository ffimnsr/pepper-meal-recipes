  "id": "d782b69a-cefc-5c97-8eea-97e97ff33cf5",
  "slug": "slow-cooker-candied-purple-yams",
  "name": "Slow Cooker Candied Purple Yams",
  "recipe_type": "dessert",
  "brief_description": "Change up your candied yams by using purple ube yams--you'll love the pop of festive color these add to your holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray the inside of a slow cooker with cooking spray."
    },
    {
      "position": 2,
      "text": "Place one layer of yam slices in the prepared slow cooker and sprinkle with brown sugar until covered. Repeat layers until all yams are placed in slow cooker."
    },
    {
      "position": 3,
      "text": "Mix melted butter, vanilla extract, and salt together in a small bowl; pour over yams in the slow cooker."
    },
    {
      "position": 4,
      "text": "Cook until yams are soft when pricked with a fork, 4 hours on Low or 2 hours on High. Transfer yams to a serving dish."
    },
    {
      "position": 5,
      "text": "Pour juices from the slow cooker into a small saucepan and heat over medium-low until juices reach a soft boil."
    },
    {
      "position": 6,
      "text": "Stir together cornstarch and water in a small bowl until smooth; add to the juices in the saucepan and continue to boil, stirring constantly, until sauce has thickened. Pour sauce over yams and sprinkle with shredded coconut."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 135,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "fd085f5c-40fa-533e-ae8d-769e526b8e95",
  "slug": "karaage-japanese-fried-chicken",
  "name": "Karaage (Japanese Fried Chicken)",
  "recipe_type": "main",
  "brief_description": "The only karaage recipe you\u2019ll ever need. Learn two methods of making Japanese fried chicken with a super-thin coating that\u2019s incredibly crispy and crunchy.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Mix garlic, ginger, soy sauce, sake, mirin, sesame oil, black pepper, cayenne, sugar, and salt in a medium bowl."
    },
    {
      "position": 2,
      "text": "Place chicken in the marinade and mix until thoroughly and evenly coated. Cover and refrigerate for 1 to 10 hours."
    },
    {
      "position": 3,
      "text": "Set up your dredging station: Place a wire rack over a foil-lined baking sheet. Add potato starch to a wide, shallow bowl."
    },
    {
      "position": 4,
      "text": "Remove chicken from the refrigerator. Stir to coat with marinade. Toss 2 or 3 pieces at a time in the potato starch until evenly coated. Shake off any excess starch and place chicken on the wire rack. Repeat to dredge remaining pieces."
    },
    {
      "position": 5,
      "text": "Tap the rack on the baking sheet to remove any loose chunks of starch, then transfer the baking sheet and rack of chicken to the refrigerator for 15 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Heat oil in a deep fryer to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Without crowding, lower chicken carefully into the hot oil in batches. Fry, tossing occasionally, until cooked through and the outside is crunchy and browned, 3 to 4 minutes. Transfer to a paper towel-lined plate to drain. Repeat with remaining chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a8ca9855-1302-5349-a82a-72bb284604f6",
  "slug": "smashed-stuffing-sandwich-recipe-8745367",
  "name": "Smashed Stuffing Sandwich",
  "recipe_type": "main",
  "brief_description": "The \"bread\" in this sandwich is smashed and baked leftover stuffing. The sandwich is filled with cranberry sauce, turkey, gravy, and Brie cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine stuffing, eggs, gravy, and salt in a bowl and mix together until combined. Let rest for 10 to 15 minutes to allow everything to hydrate."
    },
    {
      "position": 3,
      "text": "Form mixture into 4 equal-sized balls. Spray 13 x 18 baking pan with nonstick spray or oil"
    },
    {
      "position": 4,
      "text": "Place the stuffing balls on the pan, place parchment paper on top and smash the ball to desired thickness. Spray the top with more oil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the top has browned and the bottom has formed a golden brown crust, about 20 minutes. Remove from the pan using a metal spatula."
    },
    {
      "position": 6,
      "text": "Assemble each sandwich with mayo, gravy, turkey, brie, and cranberry sauce."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

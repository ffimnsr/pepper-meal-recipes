  "id": "c49d9109-2f8d-51a3-8e28-d6bdd0c3e4c1",
  "slug": "cottage-cheese-blender-muffins-recipe-11744086",
  "name": "Cottage Cheese Blender Muffins",
  "recipe_type": "side",
  "brief_description": "These cottage cheese blender muffins are easy to make and full of healthy ingredients like oats and cottage cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine cottage cheese, milk, butter, and egg in a high speed blender (such as Vitamix); blend until smooth. Add in flour, oat flour, sugar, and salt. Blend in 20 seconds increments until ingredients are just combined. Fold in chocolate chips by hand."
    },
    {
      "position": 3,
      "text": "Spoon batter into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed and a toothpick inserted into the center of a muffin comes out clean, 22 to 24 minutes. Cool in the tin for 5 minutes."
    },
    {
      "position": 5,
      "text": "Transfer to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 22,
  "preparation_time_minutes": 8,

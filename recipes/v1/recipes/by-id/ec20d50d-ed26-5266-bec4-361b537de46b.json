  "id": "ec20d50d-ed26-5266-bec4-361b537de46b",
  "slug": "tahini-chicken",
  "name": "Tahini Chicken",
  "recipe_type": "main",
  "brief_description": "Tender tahini chicken tossed in a savory sauce delivers hints of Asian- and Mediterranean-inspired cooking and flavor. Serve over couscous or noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and bouillon cube to a boil in a pot until bouillon is dissolved; decrease heat to low. Whisk tahini, soy sauce, honey, garlic, and ginger into bouillon mixture until smooth. Keep sauce warm over low heat."
    },
    {
      "position": 2,
      "text": "Heat butter in a separate skillet over medium heat; cook and stir chicken until no longer pink in the center, 5 to 10 minutes. An instant-read thermometer inserted into the centers should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Whisk flour into tahini sauce until thickened, 2 to 3 minutes. Add cooked chicken to tahini sauce and toss to coat."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

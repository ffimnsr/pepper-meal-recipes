  "id": "e7d55ffc-cc73-504f-96f1-8204d578f960",
  "slug": "butterscotch-brownies-ii",
  "name": "Butterscotch Brownies",
  "recipe_type": "dessert",
  "brief_description": "These butterscotch brownies are oozing with brown sugary goodness. They're delicious plain, but they're out of this world topped with coffee frosting!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 7x11-inch baking pan."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Make the bars: Beat brown sugar and melted butter until well combined. Beat in eggs and vanilla, then gradually stir in flour mixture. Fold in walnuts until well combined. Spread batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until light golden brown, 30 to 35 minutes. Cool in the pan for 10 minutes, then turn out of the pan and finish cooling on a wire rack, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, make the frosting: Dissolve coffee in water in a small bowl."
    },
    {
      "position": 6,
      "text": "Beat confectioner's sugar and butter in a mixing bowl with an electric mixer until light and fluffy. Beat in coffee mixture until incorporated."
    },
    {
      "position": 7,
      "text": "Spread frosting over cooled bars. Let frosting set before cutting into 36 squares."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

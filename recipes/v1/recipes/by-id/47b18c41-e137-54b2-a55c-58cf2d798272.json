  "id": "47b18c41-e137-54b2-a55c-58cf2d798272",
  "slug": "mexican-spinach-dip",
  "name": "Mexican Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "A hot, easy-to-make dip that always draws requests for the recipe. Any flavors of diced tomatoes with green chilies can be used to vary the flavor and spiciness. I usually use one Milder and one Mexican so everyone can enjoy.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a 2 quart or 9x13 inch casserole dish, combine the cream cheese, sour cream and processed cheese. Heat in the microwave until ingredients are soft enough to stir together, about 1 minute. Stir in the shredded cheese, diced tomatoes with chilies, spinach and taco seasoning mix. Spread evenly."
    },
    {
      "position": 3,
      "text": "Bake uncovered in the preheated oven until hot and bubbly, about 30 minutes. Sprinkle tomatoes and green onions on top before serving. This can also be made ahead of time, refrigerated, and baked just before serving."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

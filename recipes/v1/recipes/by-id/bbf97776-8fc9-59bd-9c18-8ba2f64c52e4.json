  "id": "bbf97776-8fc9-59bd-9c18-8ba2f64c52e4",
  "slug": "carrot-bundt-cake-with-cream-cheese-filling",
  "name": "Carrot Bundt Cake with Cream Cheese Filling",
  "recipe_type": "dessert",
  "brief_description": "Filled with a sweet cream cheese mixture, this carrot Bundt cake makes a delicious addition to any party or potluck.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a fluted tube pan (such as Bundt)."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, and egg in a bowl for filling, mixing until well blended. Set aside."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, baking soda, cinnamon, and salt for cake in a bowl. Add oil and eggs; mix until moistened. Fold in carrots. Reserve 2 cups of batter; pour remaining batter into the prepared pan. Pour cream cheese mixture over batter. Spoon reserved batter carefully over cream cheese mixture, spreading to cover."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 55 minutes. Cool for 10 minutes; remove from the pan. Sprinkle with powdered sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,

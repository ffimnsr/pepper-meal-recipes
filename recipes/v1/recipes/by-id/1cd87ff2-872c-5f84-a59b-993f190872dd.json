  "id": "1cd87ff2-872c-5f84-a59b-993f190872dd",
  "slug": "spinach-artichoke-dip-with-water-chestnuts",
  "name": "Spinach Artichoke Dip with Water Chestnuts",
  "recipe_type": "appetizer",
  "brief_description": "Spinach and artichoke dip gets an extra crunch when water chestnuts are stirring into the mix; serve with chips or Hawaiian bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix artichoke hearts, spinach, water chestnuts, sour cream, mayonnaise, cream cheese, Romano cheese, and garlic together in a small baking dish. Cover dish with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cooked through and bubbling, about 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "5f7d682e-a003-580c-803d-6a7eed394757",
  "slug": "instant-pot-dr-pepper-pulled-pork",
  "name": "Instant Pot Dr Pepper Pulled Pork",
  "recipe_type": "main",
  "brief_description": "A simple and tasty pulled pork recipe made with pork tenderloin, BBQ sauce, and Dr Pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soda and 1/2 cup barbeque sauce in a multi-functional pressure cooker (such as Instant Pot). Add pork tenderloin. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 50 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes."
    },
    {
      "position": 3,
      "text": "Remove pork loin and drain liquid from the pot. Shred pork using 2 forks. Return to the pot and mix in remaining 1 1/2 cups barbeque sauce."
    },
    {
      "position": 4,
      "text": "Serve on hamburger buns and top with coleslaw."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

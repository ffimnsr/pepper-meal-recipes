  "id": "c885d2bc-330d-5fbe-8703-9407174d729a",
  "slug": "tasty-baked-mac-n-cheese",
  "name": "Tasty Baked Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This rich and creamy macaroni and cheese casserole made with sour cream, butter, and 2 kinds of Cheddar cheese is ready in less than an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 9x13-inch baking dish with parchment paper."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until almost cooked through and firm to the bite, about 7 minutes. Drain and transfer to a large bowl. Sprinkle macaroni with 1/2 teaspoon salt and stir 1/2 cup butter into the pasta."
    },
    {
      "position": 3,
      "text": "Mix 1/4 cup butter, sour cream, cream cheese, sharp Cheddar cheese, and egg yolk together in a bowl. Stir flour, 1/2 teaspoon salt, cayenne pepper, and milk into the sour cream mixture."
    },
    {
      "position": 4,
      "text": "Spread 1/4 cup sour cream sauce over bottom of prepared baking dish. Stir remaining sour cream sauce into macaroni. Pour macaroni into baking dish atop sauce layer; sprinkle mild Cheddar cheese over the casserole."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through and cheese topping has melted, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

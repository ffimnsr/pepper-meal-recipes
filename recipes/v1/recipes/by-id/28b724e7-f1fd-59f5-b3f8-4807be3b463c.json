  "id": "28b724e7-f1fd-59f5-b3f8-4807be3b463c",
  "slug": "tequila-and-orange-cranberry-sauce",
  "name": "Tequila and Orange Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "Tequila, orange juice, orange zest, and cranberries make this quick, easy, and flavorful cranberry sauce, perfect for the holidays.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring orange juice, tequila, and orange zest to a boil in a saucepan over medium heat. Add cranberries, sugar, and salt; simmer until a jam-like sauce forms, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Blend sauce with an immersion blender for a smoother consistency. Let cool; sauce will continue to thicken naturally."
    }
  ],

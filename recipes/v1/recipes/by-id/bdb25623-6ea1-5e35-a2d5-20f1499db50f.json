  "id": "bdb25623-6ea1-5e35-a2d5-20f1499db50f",
  "slug": "heinz-classic-family-fajitas",
  "name": "Heinz\u00ae Classic Family Fajitas",
  "recipe_type": null,
  "brief_description": "Take this yummy base recipe and create a personalized fajita bar for your family by adding a smorgasbord of toppings to those already suggested such as black beans, diced tomato, diced avocado, sliced green onion and hot sauce.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat half the oil over medium-high heat. Add onions, peppers and half of the salt and pepper. Cook, stirring, for 5 minutes or until tender. Reserve."
    },
    {
      "position": 2,
      "text": "Add remaining oil to pan. Crumble in turkey, add garlic, chili powder and remaining salt and pepper. Saute until brown, about 5 minutes. Stir in half the chili sauce and all of the ketchup. Bring to a simmer."
    },
    {
      "position": 3,
      "text": "Serve meat and vegetable mixtures with tortillas and bowls of remaining chili sauce, cheese, lettuce and sour cream to make your own fajitas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "003474ab-5e37-5d04-8694-0d980d93e942",
  "slug": "grilled-scampi",
  "name": "Grilled Scampi",
  "recipe_type": "main",
  "brief_description": "Grilled shrimp coated with olive oil, butter, garlic, and oregano.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "With a sharp knife, cut shrimp in half so that the meat is exposed in the shell."
    },
    {
      "position": 2,
      "text": "In a small saucepan, heat olive oil and lightly fry the garlic until just softened. Add butter and Oregano. Heat until butter has melted."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium heat and lightly oil grate."
    },
    {
      "position": 4,
      "text": "Lay shrimp out on a tray and brush generously with the butter mixture. Grill shrimp until lightly golden."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

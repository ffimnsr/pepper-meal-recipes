  "id": "a0883773-ad72-5b7d-9c2c-1d68d00ebda5",
  "slug": "deconstructed-egg-rolls-muffin-tin-style",
  "name": "Deconstructed Egg Rolls Muffin Tin Style",
  "recipe_type": "appetizer",
  "brief_description": "Wonton wrappers pressed into muffin tins are filled with a cabbage and chicken filling in this deconstructed egg roll recipe, a crowd-pleaser.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray 12 muffin cups with cooking spray. Place 2 wonton wrappers into each muffin cup, pressing into the bottom and along the sides."
    },
    {
      "position": 2,
      "text": "Mix cabbage, corn kernels, cilantro, green onions, and almonds together in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, red wine vinegar, lemon juice, white sugar, pepper, salt, paprika, red pepper flakes, Sriracha chile sauce, garlic, sesame oil, honey, and ginger together in a bowl; fold in chicken. Stir chicken mixture into cabbage mixture until evenly combined; spoon into the wonton cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until wontons are crisp and filling is bubbling, about 18 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

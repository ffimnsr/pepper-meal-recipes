  "id": "0d1ebc04-f0ba-5834-a745-4487a26fdcde",
  "slug": "sweet-potato-pie-with-pecans",
  "name": "Sweet Potato Pie with Pecans",
  "recipe_type": "dessert",
  "brief_description": "A cinnamon, ginger, and nutmeg spiced sweet potato filling is sprinkled with chopped pecans in this pie which is served with a hazelnut liquer whipped cream topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Prepare dough for one 9 inch pie. Refrigerate until ready to bake."
    },
    {
      "position": 3,
      "text": "Blend together the butter, sweet potatoes, eggs, brown sugar, ginger, cinnamon, nutmeg, vanilla, salt, corn syrup and evaporated milk. Pour filling into crust and sprinkle with chopped pecans."
    },
    {
      "position": 4,
      "text": "Bake for 40 to 45 minutes, or until inserted knife comes out clean. Set aside to cool."
    },
    {
      "position": 5,
      "text": "Beat together whipping cream, sugar and liqueur until soft peaks form. Top pie with whipped cream and pecan halves."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

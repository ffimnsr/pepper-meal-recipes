{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "33234a3d-fc97-58e5-a445-5062e6d8863d",
  "slug": "pork-chops-with-apples-and-bacon-recipe-11835901",
  "name": "Pork Chops with Apples and Bacon",
  "recipe_type": "main",
  "brief_description": "These pork chops with apples and bacon are fall comfort food meets steakhouse dinner. This cozy, one-pan pork chop dinner, complete with a delicious Bourbon pan sauce, feels fancy but is much easier than you'd think.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large oven-safe skillet over medium heat until crisp, about 5 minutes. Remove with a slotted spoon to a plate lined with paper towels. Pour off all but 1 tablespoon bacon drippings."
    },
    {
      "position": 3,
      "text": "Season pork chops with salt and pepper. Increase heat to medium-high and sear chops in the bacon drippings just until lightly browned, 2 to 3 minutes per side. Remove to a plate."
    },
    {
      "position": 4,
      "text": "Add 1 tablespoon butter to the same skillet. Add apples and thyme, and cook until just beginning to soften, 2 to 3 minutes. Arrange apples in an even layer in the skillet, add the bacon, then nestle the seared pork chops on top."
    },
    {
      "position": 5,
      "text": "Bake uncovered in the skillet in the preheated oven until pork chops are no longer pink at the center, 10 to 15 minutes. An instant read thermometer inserted near the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove pork and apples to a serving platter and tent loosely with foil to keep warm."
    },
    {
      "position": 7,
      "text": "For sauce, place the skillet back on the stovetop over medium heat (don\u2019t wipe it out). Add butter if needed, then saut\u00e9 shallot until softened, about 2 minutes."
    },
    {
      "position": 8,
      "text": "Pour in whiskey to deglaze the pan, scraping up the browned bits on the bottom. Simmer until reduced slightly, 1 to 2 minutes. Stir in cream, Dijon, maple syrup, salt, pepper, and thyme. Simmer gently until thickened, 3 to 4 minutes. Spoon sauce over pork chops and apples. Garnish with additional thyme."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "47fb692e-0aa3-5b76-80bd-571249045edd",
  "slug": "caramel-apple-chocolate-bark",
  "name": "Caramel Apple Chocolate Bark",
  "recipe_type": "dessert",
  "brief_description": "This caramel apple chocolate bark recipe has a wonderful salty-sweet flavor and crispy, chewy texture. All you need is five ingredients and a microwave.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 13x18-inch baking sheet with parchment paper; set aside."
    },
    {
      "position": 2,
      "text": "Place 2 cups chocolate chips in a microwave-safe bowl; melt in the microwave in 30-second intervals until smooth, stirring after each interval."
    },
    {
      "position": 3,
      "text": "Spread chocolate onto the prepared baking sheet in a thin, even layer. Cool."
    },
    {
      "position": 4,
      "text": "Place caramel bits in a separate microwave-safe bowl; melt in the microwave in 30-second intervals until smooth and bubbles, stirring after each interval."
    },
    {
      "position": 5,
      "text": "Drizzle caramel over chocolate, swirling evenly using a spatula; top with pretzels, pecans, and apple chips until fully covered. Place a separate large sheet parchment paper on top; press toppings into caramel by pressing on parchment paper. Chill in the refrigerator, about 15 minutes. Remove and discard top parchment paper."
    },
    {
      "position": 6,
      "text": "Place remaining \u00bd cup chocolate chips in a separate microwave-safe bowl; melt in the microwave. Transfer melted chocolate to a resealable plastic bag; cut off a small corner, then drizzle evenly over bark."
    },
    {
      "position": 7,
      "text": "Chill in refrigerator, 2 to 3 hours. Cut bark into squares or break into large pieces to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "7dd672de-99c6-5cf4-9558-103e67afaa40",
  "slug": "million-dollar-holiday-party-sliders-recipe-8734072",
  "name": "Million Dollar Holiday Party Sliders",
  "recipe_type": "appetizer",
  "brief_description": "Baked ham and cheese sliders are a classic appetizer that everyone loves, but not quite right for holiday parties. Swapping turkey for the ham, Brie for the Swiss cheese, and adding sweet potato fries and cranberries creates holiday party sliders that are perfect for the season celebrations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Spread out sweet potato fries in a 9x13-inch dish. Bake in the preheated oven according to package directions until crisp, 10 to 12 minutes. Tip sweet potato fries out onto a plate and set aside."
    },
    {
      "position": 4,
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Keeping the rolls together, slice them in half horizontally with a bread knife. Place base of the rolls into the same 9x13-inch dish you were using earlier. Mix mustard and mayonnaise together in a small bowl and spread mizture over the cut surface."
    },
    {
      "position": 6,
      "text": "Spread shredded (or sliced) turkey on top of the mayonnaise, then top with crispy sweet potato fries. Lay Brie slices evenly on top. Dot all over with spoonfuls of cranberry sauce."
    },
    {
      "position": 7,
      "text": "Place the tops of the rolls back on. Pour melted butter on top and evenly brush all over using a pastry brush."
    },
    {
      "position": 8,
      "text": "Sprinkle with Parmesan cheese."
    },
    {
      "position": 9,
      "text": "Bake sliders in the preheated oven at 350 degrees F (175 degrees C) until Brie is melty and Parmesan is golden, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "62756221-370a-5632-b7a3-ac328e290089",
  "slug": "peanut-butter-and-banana-chocolate-truffles",
  "name": "Peanut Butter and Banana Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "Chocolate, peanut butter, and banana are simmered together and chilled, creating a delicious truffle treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix chocolate, banana, cream, and peanut butter together in a saucepan over medium heat; cook and stir mixture until melted (it may be partially lumpy due to peanut butter), 5 to 10 minutes. Pour mixture into a bowl and refrigerate until firm, 2 1/2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Scoop chocolate mixture with a melon baller and roll into 1-inch balls. Place confectioners' sugar in a shallow bowl; coat truffles with confectioners' sugar and refrigerate until firm, 1 to 2 more hours."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,

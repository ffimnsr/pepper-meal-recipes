  "slug": "holly-berry-fizz-recipe-8781326",
  "name": "Holly Berry Fizz",
  "recipe_type": "appetizer",
  "brief_description": "This holly berry fizz cocktail is vibrant, fragrant, and brings a sophisticated twist to your holiday celebrations with its balance of sweet and floral notes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add pomegranate juice and elderflower liqueur to a champagne flute. Top with prosecco, pouring gently to preserve the bubbles."
    },
    {
      "position": 2,
      "text": "Drop in a few pomegranate arils and garnish with a sprig of rosemary."
    }
  ],

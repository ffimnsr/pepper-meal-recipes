  "id": "9d7c8dfb-f7d2-5729-8fe9-0084c3861d26",
  "slug": "peanut-butter-balls-ii",
  "name": "Chocolate Peanut Butter Balls",
  "recipe_type": "dessert",
  "brief_description": "These chocolate peanut butter balls with graham crackers are also known as buckeyes. Make these balls of peanut butter coated in chocolate for your holiday cookie platter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together peanut butter, butter or margarine, confectioners' sugar, and graham cracker crumbs. Shape into 1 inch balls and place in the freezer for 15 to 30 minutes, until firm."
    },
    {
      "position": 2,
      "text": "Place chocolate and shortening in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove peanut butter balls from the freezer and dip each ball into the chocolate mixture one at a time, using a toothpick to skewer the ball and cover all sides in chocolate. Remove ball from chocolate and place on a cookie sheet or tray lined with waxed paper. Repeat with remaining balls."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

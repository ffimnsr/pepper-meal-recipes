  "slug": "5-can-clam-chowder-recipe-11892044",
  "name": "5 Can Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "This 5 can clam chowder is the easiest, and probably the quickest, clam chowder ever. Canned cream of potato soup is the base; add clams, evaporated milk, and chopped vegetables, and soup's on!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cream of potato soup, evaporated milk, clams, and vegetables in a stock pot and bring to a boil. Reduce heat and simmer for 20 minutes. Season with salt and pepper; ladle into bowls and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,

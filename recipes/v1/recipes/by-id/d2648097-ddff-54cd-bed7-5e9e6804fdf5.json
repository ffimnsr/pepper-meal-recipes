  "id": "d2648097-ddff-54cd-bed7-5e9e6804fdf5",
  "slug": "simple-lobster-scampi",
  "name": "Simple Lobster Scampi",
  "recipe_type": "drink",
  "brief_description": "This lobster scampi is a simple and elegant blend of pre-cooked lobster, white wine, lemon juice, and Parmesan cheese. Great served with pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add garlic; cook and stir until fragrant, about 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Add lobster and cook until heated through, about 5 minutes. Add wine and lemon juice; bring to a boil. Add Parmesan cheese; cook until melted, about 2 minutes. Add bread crumbs slowly, 2 tablespoons at a time, bringing to a boil after each addition."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

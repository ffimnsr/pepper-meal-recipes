  "id": "60be2fda-5eb0-58b7-8cd5-83b8f9a31fb2",
  "slug": "easy-chewy-flourless-peanut-butter-cookies",
  "name": "Easy, Chewy Flourless Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This small-batch recipe for flourless peanut butter cookies with chocolate chips is easily doubled.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat peanut butter, white sugar, and brown sugar together in a large bowl with an electric mixer until smooth. Stir egg, vanilla extract, and baking soda into peanut butter mixture; stir in chocolate chips."
    },
    {
      "position": 3,
      "text": "Drop mixture by small rounded spoonfuls onto a baking sheet about 2 inches apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are flattened and golden, about 8 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "dec1f384-1b31-55e3-b692-f3f062fd57d9",
  "slug": "peanut-butter-chocolate-chip-cookies-ii",
  "name": "Easy Peanut Butter Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These easy peanut butter chocolate chip cookies made with natural peanut butter are simple to make and ready in just 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease two cookie sheets."
    },
    {
      "position": 2,
      "text": "Beat butter and both sugars in a bowl with an electric mixer until creamy. Add egg and vanilla; mix until well combined. Mix in peanut butter, baking soda, and salt until fully incorporated. Mix in flour, then stir in chocolate chips."
    },
    {
      "position": 3,
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets; flatten slightly with a fork."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until just starting to turn golden brown on the edges, 5 to 6 minutes; don't overcook. Cool on the cookie sheets for 5 to 10 minutes, then transfer to a wire rack to finish cooling."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

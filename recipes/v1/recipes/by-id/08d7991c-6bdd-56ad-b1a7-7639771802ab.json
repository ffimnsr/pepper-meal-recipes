  "id": "08d7991c-6bdd-56ad-b1a7-7639771802ab",
  "slug": "kulfi",
  "name": "Kulfi",
  "recipe_type": "dessert",
  "brief_description": "Kulfi is a delicious Indian ice cream dessert flavored with cardamon; this recipe is easy to make with condensed and evaporated milk and whipped topping.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine evaporated milk, condensed milk, and whipped topping in a blender and blend in pieces of bread until smooth."
    },
    {
      "position": 3,
      "text": "Pour mixture into a 9x13-inch baking dish or two plastic ice cube trays, sprinkle with cardamom."
    },
    {
      "position": 4,
      "text": "Freeze for 8 hours or overnight."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],

  "schema_version": 1,
  "id": "865d9a84-0f7f-5f6a-9bb6-ca76bc6e0c2f",
  "slug": "pizza-dough-pretzels",
  "name": "Pizza Dough Pretzels",
  "recipe_type": "appetizer",
  "brief_description": "These pizza dough pretzels use refrigerated pizza dough to recreate the chewy pretzels you get at the mall. Chef John shows you just how easy it is!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly flour a work surface. Place dough on flour and sprinkle more on top. Begin to knead dough, kneading about 2 tablespoons flour into dough until it is soft and supple but not too sticky, 5 to 10 minutes. Cover with a large bowl and allow dough to rest and come to room temperature, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with parchment paper and sprinkle lightly with cornmeal."
    },
    {
      "position": 3,
      "text": "Place water in a deep skillet. Whisk in baking soda to create an alkaline bath. Bring to a simmer over medium-high heat. Adjust heat to keep water at a low simmer while you shape the dough."
    },
    {
      "position": 4,
      "text": "Dust dough with a sprinkling of flour as needed so that dough does not stick to work surface. Flatten slightly and divide into 6 equal pieces. Shape each piece into a round dough ball."
    },
    {
      "position": 5,
      "text": "Shape each dough ball into a disk, thinner in the middle, thicker around the edges. Poke a hole in the center. Gently keep pulling and stretching until you've achieved a round pretzel shape that's not too thick."
    },
    {
      "position": 6,
      "text": "Transfer pretzels (in batches if necessary) to the simmering alkaline bath. Boil about 30 seconds per side. Transfer to the prepared baking sheet with a slotted spoon. Immediately sprinkle with coarse salt while pretzels are still wet and sticky. Let rest for 5 to 10 minutes before baking."
    },
    {
      "position": 7,
      "text": "Place on center rack in preheated oven until beautifully browned, and stretch marks have formed, about 20 minutes. Exact times will depend on the specific size and shape of your pretzel."
    },
    {
      "position": 8,
      "text": "Transfer pretzels to a wire rack to cool slightly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

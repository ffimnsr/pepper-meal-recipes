  "id": "a241acef-371f-5aa9-bc15-68067cb383ed",
  "slug": "individual-baked-frittatas",
  "name": "Individual Baked Frittatas",
  "recipe_type": "breakfast",
  "brief_description": "Bacon, Cheddar, and broccoli frittatas are baked in mini, single-sized portions in a muffin tin in this recipe that can be easily customized by using different meats or vegetables.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a 12-cup muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Meanwhile, place broccoli and water in a microwave-safe bowl. Cover and cook on high until tender, 1 1/2 to 2 minutes. Carefully remove cover and drain any liquid."
    },
    {
      "position": 4,
      "text": "Crack eggs into a bowl and beat with a whisk. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Layer bacon and broccoli into each muffin cup, filling about 1/3 full. Pour egg mixture into each cup, leaving a bit of space at the top. Sprinkle with Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted at the center comes out clean or nearly clean, 15 to 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cbd7b4da-3c39-5394-8271-a888e7702601",
  "slug": "kofta-kebabs",
  "name": "Kofta Kebabs",
  "recipe_type": "main",
  "brief_description": "Kofta made with ground lamb and aromatic spices, shaped into kebabs and grilled. Serve with pita and yogurt dressing for a delicious Middle Eastern meal.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Mash garlic into a paste with salt using a mortar and pestle or the flat side of a chef's knife on your cutting board."
    },
    {
      "position": 2,
      "text": "Mix garlic into lamb with onion, parsley, coriander, cumin, cinnamon, allspice, cayenne pepper, ginger, and pepper in a mixing bowl until well blended."
    },
    {
      "position": 3,
      "text": "Form mixture into 28 balls. Form each ball around the tip of a skewer, flattening it into a 2-inch oval; repeat with remaining skewers. Place kebabs onto a baking sheet, cover, and refrigerate for at least 30 minutes, or up to 12 hours."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Cook skewers on the preheated grill, turning occasionally, until browned and cooked through, about 5 to 6 minutes. An instant-read thermometer inserted into the center of a kebab should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fd28f5c7-d198-5398-a4a5-23dc3232b595",
  "slug": "penne-primavera",
  "name": "Penne Primavera",
  "recipe_type": "main",
  "brief_description": "Sauteed broccoli, carrots, and peas serve as the summertime toppings for penne pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the olive oil and garlic in a large skillet over medium heat. When garlic is tender, remove from skillet and set aside. Place the broccoli and carrot in the skillet, and cook 2 minutes, just until heated through."
    },
    {
      "position": 2,
      "text": "In a pot, bring the vegetable broth to a boil. Stir in the penne pasta and heated crushed garlic clove. Cook for 5 minutes, or until pasta is almost al dente. Remove and discard garlic clove."
    },
    {
      "position": 3,
      "text": "Transfer the partially cooked pasta and broth to the skillet. Mix in the peas. Cover skillet, and continue cooking 10 minutes over medium heat, or until pasta is al dente and vegetables are tender. Toss with the Parmesan cheese to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

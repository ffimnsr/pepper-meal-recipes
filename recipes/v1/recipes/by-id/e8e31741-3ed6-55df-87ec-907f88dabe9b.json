  "id": "e8e31741-3ed6-55df-87ec-907f88dabe9b",
  "slug": "cranberry-pot-roast",
  "name": "Cranberry Pot Roast",
  "recipe_type": "main",
  "brief_description": "Cranberry sauce flavors beef chuck in this easy and flavorful slow cooker main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring the beef broth and water to a boil in a saucepan over high heat. Stir in the cranberry sauce until dissolved. Pour the sauce into a slow cooker set to High."
    },
    {
      "position": 2,
      "text": "Meanwhile, season the beef roast with salt and pepper, then sprinkle evenly with the flour. Heat the vegetable oil in large skillet over medium heat. Cook the roast in the hot oil until brown on all sides, about 2 minutes per side. Transfer the roast to the slow cooker along with the chopped onion."
    },
    {
      "position": 3,
      "text": "Cook until the roast easily pulls apart with a fork, about 4 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 255,

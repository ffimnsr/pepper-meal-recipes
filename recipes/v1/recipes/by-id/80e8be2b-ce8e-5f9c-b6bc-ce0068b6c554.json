  "id": "80e8be2b-ce8e-5f9c-b6bc-ce0068b6c554",
  "slug": "refreshing-cucumber-lemonade",
  "name": "Refreshing Cucumber Lemonade",
  "recipe_type": "drink",
  "brief_description": "Lemonade with cucumber juice is a unique way to serve this homemade summery drink. Serve cold or over ice garnished with lemon and cucumber slices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Make the simple syrup: Combine water and sugar together in a saucepan over medium heat; heat until just about to boil and sugar has dissolved. Place in refrigerator until cool, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Blend cucumber in a blender or food processor until mashed into a pulp. Pour cucumber pulp into a fine mesh strainer placed over a bowl; allow to sit until you have about 2/3 cup of cucumber juice in the bowl, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir simple syrup, cucumber juice, and lemon juice together in a pitcher. Serve cold."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

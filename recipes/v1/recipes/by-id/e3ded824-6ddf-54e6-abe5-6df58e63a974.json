  "id": "e3ded824-6ddf-54e6-abe5-6df58e63a974",
  "slug": "classic-american-style-potato-salad",
  "name": "Classic American-Style Potato Salad",
  "recipe_type": "salad",
  "brief_description": "A classic potato salad recipe made with low-starch red boiling potatoes for the perfect version of this traditional, favorite side everyone loves.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a pot with water to cover. Bring to a boil, cover and simmer, stirring to ensure even cooking, until a thin-bladed paring knife or a metal skewer inserted into a potato can be removed with no resistance, 25 to 30 minutes. Drain, rinse under cold water, and drain again. Cool slightly."
    },
    {
      "position": 2,
      "text": "Cut warm potatoes into 3/4-inch dice. Layer them in a bowl, seasoning with vinegar, salt, and pepper as you go."
    },
    {
      "position": 3,
      "text": "Cut eggs, celery, and pickle in 1/4-inch dice. Thinly slice scallions. Add to potatoes, along with parsley. Stir in mayonnaise and mustard until everything is combined. Chill, covered, before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

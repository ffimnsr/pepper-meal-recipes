  "id": "3b233c6f-a5f9-5c24-ae92-db1622bc1642",
  "slug": "zucchini-bars-with-spice-frosting",
  "name": "Zucchini Bars with Spice Frosting",
  "recipe_type": "dessert",
  "brief_description": "This recipe for zucchini bars features freshly shredded zucchini, walnuts, ground cloves, and ground cinnamon, plus a spiced cream cheese frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with butter."
    },
    {
      "position": 2,
      "text": "Beat brown sugar, \u00bd cup butter, eggs, and vanilla together in a large bowl until creamy; stir in flour, baking soda, cinnamon, and \u00bd teaspoon cloves until well combined. Beat in zucchini and walnuts until incorporated; transfer batter to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 30 minutes. Cool completely before frosting, about 1 hour."
    },
    {
      "position": 4,
      "text": "Combine cream cheese frosting and \u00bc teaspoon ground cloves in a small bowl."
    },
    {
      "position": 5,
      "text": "Spread frosting over cooled zucchini bars; cut into 16 squares."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

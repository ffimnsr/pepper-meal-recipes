  "schema_version": 1,
  "id": "2610ad0a-eed4-5ffc-82a8-d641b702ff4f",
  "slug": "green-tomato-mincemeat",
  "name": "Green Tomato Mincemeat",
  "recipe_type": "dessert",
  "brief_description": "This green tomato mincemeat combines apples, citrus, raisins, and warm spices into an old-fashioned preserve that\u2019s perfect for pies, cookies, and cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine green tomatoes, apples, brown sugar, suet (or oil), and vinegar in a large stockpot. Add oranges, candied citrus peel, raisins, and lemons; season with salt, cinnamon, cloves, and allspice. Cover; cook over low heat for 3 hours."
    },
    {
      "position": 2,
      "text": "Inspect 30 (pint-sized) jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until mincemeat is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 3,
      "text": "Pack hot mincemeat into hot sterilized jars, filling to within \u00bd inch of tops. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 4,
      "text": "Place a rack in the bottom of a canner or large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove jars from the stockpot and let rest, several inches apart, until cool. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 120,
  "cooking_time_minutes": 195,

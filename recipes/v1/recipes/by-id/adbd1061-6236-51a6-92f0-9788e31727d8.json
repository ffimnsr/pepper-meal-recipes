  "id": "adbd1061-6236-51a6-92f0-9788e31727d8",
  "slug": "fra-diavolo-sauce-with-pasta",
  "name": "Fra Diavolo Sauce With Pasta",
  "recipe_type": "main",
  "brief_description": "Diavolo sauce is a spicy, garlicky, tomato Italian pasta sauce that's delicious with shellfish; serve over hot linguine for a restaurant-worthy meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons of olive oil and garlic in a large saucepan over medium heat. When garlic starts to sizzle, pour in tomatoes and season with salt and red pepper flakes. Bring to a boil, then simmer over low heat, stirring occasionally, for 30 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook pasta for 8 to 10 minutes, or until al dente; drain."
    },
    {
      "position": 3,
      "text": "Heat remaining 2 tablespoons of olive oil in a large skillet over high heat; add shrimp and scallops. Cook, stirring frequently, until the shrimp turn pink, about 2 minutes Add shrimp and scallops to tomato mixture and stir in parsley. Cook until sauce just begins to bubble, about 3 to 4 minutes. Serve sauce over pasta."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

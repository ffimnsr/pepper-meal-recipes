  "slug": "bircher-muesli-swiss-oatmeal",
  "name": "Bircher Muesli",
  "recipe_type": "breakfast",
  "brief_description": "This easy Bircher muesli recipe soaks oats, fruit, walnuts, almonds, and yogurt ahead of time for a delicious and healthier option for breakfast on the go.",
  "cuisine": "Swiss American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, milk, yogurt, apple, banana, raisins, walnuts, almonds, brown sugar, honey, and orange juice in a bowl. Chill in the refrigerator to thicken, at least 1 hour."
    }
  ],
  "servings": 4,

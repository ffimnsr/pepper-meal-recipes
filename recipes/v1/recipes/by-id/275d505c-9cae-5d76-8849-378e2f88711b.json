{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "275d505c-9cae-5d76-8849-378e2f88711b",
  "slug": "chicken-with-gnocchi",
  "name": "Chicken with Gnocchi",
  "recipe_type": "main",
  "brief_description": "Perfect for dinner parties, this quick and easy chicken dish is served with gnocchi and a tomato-balsamic sauce that is sure to impress family and guests alike.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine bacon and onion in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Set aside."
    },
    {
      "position": 2,
      "text": "Heat oil in a pan over medium heat. Add chicken and 1/2 of the lemon juice and cook until no longer pink in the centers and juices run clear, 5 to 7 minutes per side."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix balsamic vinegar, brown sugar, rosemary, red pepper flakes, and remaining lemon juice together in a saucepan and bring to a boil. Reduce heat to medium-low and simmer until mixture bubbles, 5 to 7 minutes. Add tomatoes with some of their juice and continue to simmer while chicken finishes cooking."
    },
    {
      "position": 4,
      "text": "Melt butter in a pan over medium heat. Pan-fry gnocchi in the hot butter until golden brown, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add spinach, cover, and steam until tender, 2 to 6 minutes."
    },
    {
      "position": 6,
      "text": "Place bacon and onion onto a serving plate and top with spinach, gnocchi, and chicken, in that order. Drizzle with tomato-balsamic sauce."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "64aa0cf3-3aec-5ba4-84bb-501db7466fd2",
  "slug": "potato-zucchini-frittata-recipe-11824115",
  "name": "Potato Zucchini Frittata",
  "recipe_type": "breakfast",
  "brief_description": "In this potato zucchini fritttata, chopped tomatoes with green chiles, zucchini, and potatoes bake in a rich custard of eggs, milk, and sour cream.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a 10-inch ovenproof skillet over medium heat. Add onions to the hot oil and cook for 2 to 3 minutes, and then stir in the zucchini slices. Cook, stirring occasionally, about 3 more minutes."
    },
    {
      "position": 3,
      "text": "Stir in thawed potatoes and cook until heated through, about 3 more minutes. Stir in a pinch or two of salt and pepper."
    },
    {
      "position": 4,
      "text": "Add drained Rotel, stir, and remove from heat. Use the back of a spoon to smooth the vegetables into an even layer."
    },
    {
      "position": 5,
      "text": "Whisk eggs, remaining salt and black pepper, smoked paprika, Mexican oregano, and red pepper flakes together in a bowl. Stir in milk, and sour cream until combined. Pour egg mixture into the vegetables in the skillet, and shake gently to eliminate air pockets. Sprinkle evenly with Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Bake in the center of the preheated oven until a knife inserted in the center comes out clean, 25 to 30 minutes. Remove from the oven and let stand about 5 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with sliced green onions, fresh parsley, and tomato slices, and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

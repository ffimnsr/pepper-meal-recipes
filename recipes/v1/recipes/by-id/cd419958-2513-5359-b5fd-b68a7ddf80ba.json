  "id": "cd419958-2513-5359-b5fd-b68a7ddf80ba",
  "slug": "mexican-polenta-pizza-recipe-7508449",
  "name": "Mexican Polenta Pizza",
  "recipe_type": "side",
  "brief_description": "This Mexican polenta pizza is a fun fusion of baked polenta and pizza, and, to give it another twist, it's topped with delicious Mexican flavors.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cornmeal, milk, and salt together in a medium saucepan, and cook over medium-high heat, stirring constantly, until mixture comes to a boil and thickens enough to pull away from the sides of the pan, about 15 minutes. Remove from heat and stir in the olive oil. Spread on a greased cookie sheet. Cool in the refrigerator for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake polenta crust in the preheated oven for 10 to 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a nonstick skillet over medium-high heat, and cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Pour in red chile sauce, and simmer until thickened, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Top polenta crust with meat sauce and cheese. Return to the oven; bake until cheese is melted, 10 to 12 minutes more."
    },
    {
      "position": 6,
      "text": "Top with lettuce, tomato, black olives, and sour cream. Sprinkle with additional shredded cheese, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

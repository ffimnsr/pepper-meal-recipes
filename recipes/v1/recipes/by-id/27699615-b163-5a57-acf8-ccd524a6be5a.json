  "id": "27699615-b163-5a57-acf8-ccd524a6be5a",
  "slug": "one-two-three-fudge",
  "name": "One Two Three Fudge",
  "recipe_type": "dessert",
  "brief_description": "This creamy fudge is sure to please any group of chocolate-lovin' folks. The addition of frosting in the fudge makes this recipe smooth and fail-proof. Just be sure and use a frosting that does not include pudding in the ingredients.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9x13 pan. Set aside."
    },
    {
      "position": 2,
      "text": "In a medium saucepan, melt butter and chocolate chips together over low heat. Remove from heat and stir in frosting. Mix well."
    },
    {
      "position": 3,
      "text": "Pour into prepared pan. Refrigerate for 2 hours. Cut into squares. Store, covered in refrigerator."
    }
  ],

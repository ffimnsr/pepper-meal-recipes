  "id": "3e2aae32-93f4-56dc-b442-a0f3c5571108",
  "slug": "biscochitos-traditional-cookies",
  "name": "Biscochitos Traditional Cookies",
  "recipe_type": "dessert",
  "brief_description": "Biscochitos are a classic New Mexican Christmas cookie. These delicious anise-flavored shortbread-like cookies are dusted with sugar and cinnamon.",
  "cuisine": "Southwestern American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Sift flour, baking powder, and salt into a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Beat lard and 1 \u00bd cups sugar together in a large bowl with an electric mixer until smooth. Add anise seed and beat until fluffy. Stir in eggs, one at a time. Add brandy; stir in flour mixture to form a dough."
    },
    {
      "position": 3,
      "text": "Roll dough with a floured rolling pin to a thickness of 1/4 or 1/2 inch. Cut dough with a fleur-de-lis cookie cutter, or other simple shape. Place cookies onto ungreased baking sheets. Mix 1/4 cup of sugar and cinnamon together in a small bowl; sprinkle over cookies."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the edges are golden brown, about 10 minutes."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

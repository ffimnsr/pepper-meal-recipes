  "id": "b3d9dfd8-cb1e-50f0-8d60-bd79a132893c",
  "slug": "miso-roasted-brussels-sprouts-recipe-11710565",
  "name": "Miso Roasted Brussels Sprouts",
  "recipe_type": "side",
  "brief_description": "Simple miso roasted Brussels sprouts are coated in miso paste and rice vinegar, and pack a ton of flavor. They go great with beef, pork, chicken, and wild game.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) and line a large baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Whisk oil, miso, and vinegar together in a large bowl. Add Brussels sprouts and toss to combine."
    },
    {
      "position": 3,
      "text": "Spread Brussels sprouts on the baking sheet in an even layer. Sprinkle pepper over the top."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven for 10 minutes. Shake the tray; roast until tender, about 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6416a5bf-42eb-52e0-a9a4-ea9d442178bd",
  "slug": "bobs-stuffed-banana-peppers",
  "name": "Bob's Stuffed Banana Peppers",
  "recipe_type": "main",
  "brief_description": "Mild stuffed banana peppers, filled with a cheesy Italian sausage mixture, are baked in a simple tomato sauce for a delicious dish without the heat.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut off the tops of peppers. Remove ribs and seeds; rinse peppers. Chop edible portion of the tops; set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add peppers, reduce heat, and simmer until tender but still firm, about 5 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Heat butter in a medium skillet over medium heat. Saut\u00e9 reserved chopped pepper, onion, and celery in hot butter until tender, 3 to 5 minutes. Stir in crushed tomatoes, tomato sauce, and garlic. Season with 1 \u00bd teaspoons salt, basil, oregano, and \u00bc teaspoon black pepper. Simmer uncovered for 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine Parmesan cheese, egg, Worcestershire sauce, 1 remaining teaspoon salt, and remaining \u00bc teaspoon black pepper in a large bowl. Mix in hot sausage, mild sausage, bread crumbs, and 1 cup tomato sauce mixture until well combined."
    },
    {
      "position": 6,
      "text": "Fill each pepper with sausage mixture using a piping bag or sausage stuffer. Place in a 3-quart casserole dish; pour remaining tomato sauce mixture over peppers."
    },
    {
      "position": 7,
      "text": "Bake uncovered in the preheated oven until sauce is bubbly and sausage is cooked through, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

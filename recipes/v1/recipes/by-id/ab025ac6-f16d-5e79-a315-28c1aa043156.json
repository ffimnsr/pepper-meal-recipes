  "id": "ab025ac6-f16d-5e79-a315-28c1aa043156",
  "slug": "chipotle-barbacoa",
  "name": "Chipotle Barbacoa",
  "recipe_type": "main",
  "brief_description": "This chipotle barbacoa is a copycat recipe that features seasoned beef chuck slow-cooked until fork-tender for a fiery dish with lots of smoky flavor.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over low heat, gradually increasing heat to medium-high. Cook beef in hot oil until browned, about 10 seconds per side. Transfer beef to a slow cooker."
    },
    {
      "position": 2,
      "text": "Combine chipotle peppers, apple cider, lime juice, garlic, cumin, serrano pepper, cayenne pepper, oregano, black pepper, garlic powder, salt, and cloves in a blender or food processor; blend until smooth. Pour over beef in the slow cooker."
    },
    {
      "position": 3,
      "text": "Stir broth, onion, and bay leaves into the slow cooker."
    },
    {
      "position": 4,
      "text": "Cook on Low until beef shreds easily with a fork, 6 to 8 hours. Remove beef from slow cooker and shred beef using 2 forks. Return shredded beef to the slow cooker and stir to combine with sauce before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 365,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "expert",

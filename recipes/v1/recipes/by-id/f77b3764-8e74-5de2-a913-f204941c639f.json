  "id": "f77b3764-8e74-5de2-a913-f204941c639f",
  "slug": "healthy-multigrain-chia-waffles",
  "name": "Multigrain Chia Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These multigrain waffles are easy to make with oats, whole wheat flour, chia seeds, and flax for a hearty and healthier way to start the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to the manufacturer\u2019s instructions; spray the inside with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk almond milk, applesauce, egg, chia seeds, and vanilla extract together in a bowl; let sit until chia seeds start to thicken mixture, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Whisk flour, oats, flax seed meal, baking powder, sugar, and salt into almond milk mixture until batter is smooth."
    },
    {
      "position": 4,
      "text": "Scoop 1/2 cup batter into the preheated waffle iron and cook until crisp and golden, about 5 minutes per waffle. Repeat with remaining batter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5ade8b94-b6f2-51d5-b187-61d5726a44b7",
  "slug": "slow-cooker-beef-neck-bones-and-gravy",
  "name": "Slow Cooker Beef Neck Bones and Gravy",
  "recipe_type": "soup",
  "brief_description": "Slow cooker beef neck bones and gravy is a rich and flavorful meal to serve over rice or mashed potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat slow cooker to High."
    },
    {
      "position": 2,
      "text": "Clean neck bones and remove any excess fat. Season bones with cumin, allspice, black pepper, red pepper flakes, and salt; dust with 1/4 cup flour."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir garlic until fragrant, 1 to 2 minutes. Increase heat to medium-high and add seasoned neck bones; cook until bones begin to brown, about 1 minute per side."
    },
    {
      "position": 4,
      "text": "Transfer neck bones and drippings to the preheated slow cooker; add beef broth and onion."
    },
    {
      "position": 5,
      "text": "Cook on High for 1 hour. Reduce heat to Low and cook 4 to 6 hours."
    },
    {
      "position": 6,
      "text": "Transfer neck bones to a dish. Sprinkle remaining flour into the slow cooker and stir well. Return neck bones to slow cooker. Let stand until gravy thickens, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 320,
  "preparation_time_minutes": 10,

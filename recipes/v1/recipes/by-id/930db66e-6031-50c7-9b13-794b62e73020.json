  "id": "930db66e-6031-50c7-9b13-794b62e73020",
  "slug": "maple-mustard-salmon",
  "name": "Maple Mustard Salmon",
  "recipe_type": "main",
  "brief_description": "A quick roast at high heat is one of the breeziest ways to cook salmon. Stir together a tangy stone-ground mustard glaze and brush it over the fillets: You'll be done with prep before the oven finishes preheating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Whisk together mustard, maple syrup, lemon juice, garlic, and thyme in a small bowl."
    },
    {
      "position": 3,
      "text": "Season salmon on both sides with salt and pepper and brush with oil. Arrange salmon on prepared baking sheet. Brush with mustard mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, 8 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

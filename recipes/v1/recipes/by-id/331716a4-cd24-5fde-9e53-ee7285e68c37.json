  "id": "331716a4-cd24-5fde-9e53-ee7285e68c37",
  "slug": "manti-turkish-ravioli-with-yogurt-sauce",
  "name": "Manti (Turkish 'Ravioli' with Yogurt Sauce)",
  "recipe_type": "main",
  "brief_description": "This savory Turkish pasta recipe uses ravioli but can be traditionally done with a pasta called Manti that you can buy from any Turkish store.",
  "cuisine": "Turkish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Add salt, mint, and ravioli. Cook for 3 to 5 minutes until ravioli float to the top, then drain and keep warm."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a small saucepan over low heat. Stir in paprika, and keep warm as ravioli are cooking. Stir garlic into yogurt."
    },
    {
      "position": 3,
      "text": "To serve, place drained ravioli onto a serving platter or individual plates. Spoon yogurt on top of ravioli, then ladle paprika butter over top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "86044842-920f-55be-afb8-6cfa9939add8",
  "slug": "meatball-pasta-bake",
  "name": "Meatball Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This easy-to-make baked meatball pasta casserole with layers of marinara sauce and 3 different types of cheese is better than lasagna!",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti and cook, stirring occasionally, about 3 minutes less than the package instructions, about 8 minutes. Drain pasta."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 13x9 inch baking dish."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium heat and cook meatballs until browned on all sides, about 5 minutes. Add marinara sauce and ricotta cheese; mix to combine. Add cooked pasta and mix to combine. Season with Italian seasoning and garlic powder."
    },
    {
      "position": 4,
      "text": "Cover the bottom of the prepared baking dish with a layer of sauce without meatballs. Sprinkle 1 cup mozzarella cheese on top. Add another layer of sauce with meatballs on top and sprinkle with 1/3 cup Parmesan cheese. Add another layer of 1 cup mozzarella cheese. Add the rest of the sauce and meatball mixture on top, followed by remaining 1 cup mozzarella cheese and 1/3 cup Parmesan cheese. Cover baking dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, 20 to 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove foil and bake until cheese starts to turn golden brown, 10 to 20 minutes. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

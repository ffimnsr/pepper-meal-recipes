  "id": "5ec97cd7-c93a-54a5-b5fa-a23a7d384cc6",
  "slug": "blueberry-coffee-cake-i",
  "name": "Blueberry Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "Moist blueberry coffee cake baked in a Bundt pan with fresh berries and a layer of sweet cinnamon streusel. Perfect for breakfast with a hot cup of coffee.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Make the streusel: Mix brown sugar, flour, and cinnamon together in a medium bowl. Cut in butter until mixture is crumbly."
    },
    {
      "position": 3,
      "text": "Make the cake: Generously spray a fluted tube pan (such as Bundt) with cooking spray. Whisk flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 4,
      "text": "Beat butter in a large bowl with an electric mixer until creamy. Add sugar and beat until fluffy. Beat in egg and vanilla. Add flour mixture in two batches, alternating with milk, beating batter briefly after each addition."
    },
    {
      "position": 5,
      "text": "Spread 1/2 of the batter in the prepared pan. Sprinkle blueberries over top, then add remaining batter, one spoon at a time."
    },
    {
      "position": 6,
      "text": "Sprinkle streusel over top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until deep golden brown, 55 to 60 minutes. Set on a wire rack to cool, about 30 minutes."
    },
    {
      "position": 8,
      "text": "Invert cake onto a plate and dust with confectioners' sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

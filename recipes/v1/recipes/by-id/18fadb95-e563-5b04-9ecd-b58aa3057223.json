  "id": "18fadb95-e563-5b04-9ecd-b58aa3057223",
  "slug": "triple-cheese-gluten-free-jalapeno-poppers",
  "name": "Triple Cheese Gluten-Free Jalapeno Poppers",
  "recipe_type": "appetizer",
  "brief_description": "Three kinds of cheese and gluten-free bread crumbs make for jalapeno poppers the whole family will love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cut jalapenos in half lengthwise. Put on disposable gloves to remove the seeds and membranes."
    },
    {
      "position": 3,
      "text": "Mix goat cheese, Cheddar cheese, Monterey Jack, chili powder, cumin, and coriander until well combined. Mix bread crumbs, cotija, and oregano together in a separate bowl."
    },
    {
      "position": 4,
      "text": "Fill each jalapeno half with equal amounts of the goat cheese mixture. Gently roll the tops of the filled peppers in the bread crumb mixture. Arrange peppers on the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bread crumbs are browned, about 20 minutes. Garnish with fresh thyme."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a9b57b6f-fbe6-5c9a-a89a-fe68875dfe56",
  "slug": "tater-tot-casserole-ii",
  "name": "Vegetarian Tater Tot Casserole",
  "recipe_type": "soup",
  "brief_description": "This is a recipe for tater tot casserole without meat that everyone will love \u2014 vegetarian or not. Simply bake tots, cheese, and mushroom soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Arrange tater tots in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine sour cream, cheese, and condensed soup in a mixing bowl. Pour this mixture over tater tots. Sprinkle onions over the top of the casserole."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 45 to 60 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

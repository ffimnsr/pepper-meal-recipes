  "id": "76706708-7c40-5aaf-9c91-ba67667e4597",
  "slug": "sweet-coconut-oatmeal",
  "name": "Sweet Coconut Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "In this quick and easy recipe, oats are cooked in coconut milk for an fresh spin on classic breakfast oatmeal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring coconut milk to a gentle boil in a small saucepan over medium-low heat. Stir in oats and honey; lower heat and simmer until milk has mostly been absorbed, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Sprinkle coconut flakes, brown sugar, and cinnamon into oatmeal. Cook until oats are creamy and flavors are combined, about 5 minutes."
    }
  ],
  "servings": 3,

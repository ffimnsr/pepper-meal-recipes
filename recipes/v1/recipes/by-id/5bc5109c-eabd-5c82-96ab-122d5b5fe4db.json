  "id": "5bc5109c-eabd-5c82-96ab-122d5b5fe4db",
  "slug": "chaffles",
  "name": "Chaffles",
  "recipe_type": "breakfast",
  "brief_description": "This chaffles recipe makes a low-carb waffle that can be eaten in many ways but is especially tasty for breakfast with butter and sugar-free syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle maker."
    },
    {
      "position": 2,
      "text": "Whisk egg in a small bowl; stir in mozzarella cheese until batter is well combined."
    },
    {
      "position": 3,
      "text": "Pour 1/2 of the batter onto the preheated waffle maker, spreading it out from the center with a spoon. Close the waffle maker and cook until steaming stops and chaffle is well browned, about 3 minutes. Don't overcook, as that will make it chewy. Repeat with remaining batter."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

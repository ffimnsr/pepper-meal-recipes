{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "74541376-ebf2-51b1-8ffb-4cf9a9c476ae",
  "slug": "ukrainian-beet-green-cabbage-rolls",
  "name": "Ukrainian Beet Green \"Cabbage\" Rolls",
  "recipe_type": "main",
  "brief_description": "This Ukrainian beet greens \"cabbage\" rolls recipe is a traditional dish similar to cabbage rolls, but you don't have to cook the beet greens first.",
  "cuisine": "Ukrainian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high heat. Add onion; cook and stir until softened, about 5 minutes. Cool off heat."
    },
    {
      "position": 3,
      "text": "Meanwhile, place bread crumbs in a large bowl; pour milk over bread crumbs and set aside until all liquid has been absorbed, about 5 minutes. Stir in cooked onion, ground beef, ground pork, egg, salt, and black pepper until filling is well combined."
    },
    {
      "position": 4,
      "text": "Cover bottom of the prepared baking dish with 2 large beet leaves; set aside 2 leaves for the top. Place remaining beet leaves on a flat work surface; add a heaping teaspoon filling to wide end (bottom) of each leaf. Roll leaf around filling, working one at a time; place into the baking dish. Repeat with remaining leaves and filling. Pour chicken broth over rolls; place 2 reserved leaves over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until beet leaves are tender and filling is cooked through, about 1 hour. An instant-read thermometer inserted into centers should read at least 160 degrees F (72 degrees C)."
    },
    {
      "position": 6,
      "text": "Drain liquid from baking dish into a small saucepan. Whisk cream and flour together in a small bowl until smooth; gradually stir into cooking liquid in saucepan. Bring to a bare simmer over medium-low heat; gently cook, but do not boil, until thickened, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Transfer rolls to a serving dish; pour sauce over top. Sprinkle rolls with dill."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

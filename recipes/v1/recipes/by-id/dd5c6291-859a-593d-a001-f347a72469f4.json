  "id": "dd5c6291-859a-593d-a001-f347a72469f4",
  "slug": "my-favorite-pot-roast",
  "name": "My Favorite Pot Roast",
  "recipe_type": "main",
  "brief_description": "Brown your pot roast on the stove before finishing in the oven. Cooking with carrots, potatoes, and onion delivers a rich flavor.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a Dutch oven over medium heat. Cook roast in hot oil until browned on all sides, 2 to 3 minutes per side."
    },
    {
      "position": 3,
      "text": "Mix together brown sugar, salt, mustard, and black pepper in a small bowl; sprinkle evenly over roast. Arrange potatoes, carrots, and onion in the Dutch oven around roast. Pour vinegar and water over vegetables."
    },
    {
      "position": 4,
      "text": "Cover and cook in the preheated oven until roast is hot in the center and just turning from pink to grey, about 4 hours. An instant-read thermometer inserted into the center should read 150 degrees F (65 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 250,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

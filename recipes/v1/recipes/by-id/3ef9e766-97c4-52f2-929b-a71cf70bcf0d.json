  "id": "3ef9e766-97c4-52f2-929b-a71cf70bcf0d",
  "slug": "salisbury-steak-with-mushrooms",
  "name": "Salisbury Steak with Mushrooms",
  "recipe_type": "main",
  "brief_description": "This Salisbury steak with mushroom gravy recipe features seasoned beef patties and an easy homemade sauce for a classic, comforting dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground beef, bread crumbs, chopped onion, egg, salt, and black pepper in a large bowl until evenly mixed. Shape beef mixture into 4 patties, about 3/4-inch thick."
    },
    {
      "position": 2,
      "text": "Fry patties in a large skillet over medium heat until browned on both sides, about 10 minutes. Add beef broth, onion, and mushrooms; bring to a boil. Reduce heat to low, cover, and simmer until patties are no longer pink in the center, about 10 minutes more. Transfer patties to a platter and keep warm."
    },
    {
      "position": 3,
      "text": "Bring onion mixture to a boil. Mix cornstarch and water in a small bowl; stir into onion mixture. Cook and stir until onion gravy is thickened, about 1 minute. Pour over patties to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

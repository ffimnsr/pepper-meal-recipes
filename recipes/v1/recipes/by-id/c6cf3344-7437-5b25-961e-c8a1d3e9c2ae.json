  "id": "c6cf3344-7437-5b25-961e-c8a1d3e9c2ae",
  "slug": "bacon-baked-beans",
  "name": "Bacon Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "These baked beans with bacon are easy to make with fresh apple, ketchup, onion, mustard, and brown sugar for a sticky-sweet side great for any barbecue.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until much of the grease has been released, but bacon is still flexible. Drain on paper towels and set aside."
    },
    {
      "position": 3,
      "text": "Stir together baked beans, onion, apple, brown sugar, ketchup, and mustard in a 9-inch square baking dish until well combined. Top with bacon slices."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, in the preheated oven until bacon is crisp and beans are bubbling hot, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

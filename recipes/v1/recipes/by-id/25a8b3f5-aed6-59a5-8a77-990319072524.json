{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "25a8b3f5-aed6-59a5-8a77-990319072524",
  "slug": "air-fryer-pork-tenderloin-with-sweet-potatoes",
  "name": "Air Fryer Pork Tenderloin with Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "Use your air fryer to cook pork tenderloins and sweet potatoes all in one go for an easy family dinner.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat air fryer to 390 degrees F (200 degrees C), if recommended by manufacturer."
    },
    {
      "position": 2,
      "text": "Combine olive oil, pineapple preserves, garlic granules, cayenne, salt, and white pepper in a large mixing bowl; stir to combine."
    },
    {
      "position": 3,
      "text": "Place sweet potato pieces into the mixing bowl and toss with the pineapple preserves mixture. Remove sweet potatoes to a plate, reserving the remaining pineapple mixture."
    },
    {
      "position": 4,
      "text": "Pat tenderloins dry with paper towels. Place in the mixing bowl with the remaining pineapple mixture and toss to coat."
    },
    {
      "position": 5,
      "text": "Brush interior basket of the air fryer with the remaining olive oil. Place tenderloins in the basket, and in a single layer, add as many sweet potato pieces as will fit around the tenderloins. Set aside extra sweet potato pieces. You will cook them as a second batch."
    },
    {
      "position": 6,
      "text": "Air fry for 10 minutes. Turn tenderloins over, browned side down. Stir sweet potatoes, but keep them in a single layer. Air fry until pork loin is slightly pink in the center, about 10 minutes longer. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). If the tenderloins need more cooking time, turn them again and continue cooking and testing the temperature in 5 minute increments."
    },
    {
      "position": 7,
      "text": "Remove sweet potatoes from the air fryer when they are tender and caramelized. (See Cook's Note)."
    },
    {
      "position": 8,
      "text": "When the tenderloins test done, place them on a platter and tent with foil. Allow to rest while the remaining sweet potatoes cook, about 10 more minutes."
    }
  ],
  "servings": 6,

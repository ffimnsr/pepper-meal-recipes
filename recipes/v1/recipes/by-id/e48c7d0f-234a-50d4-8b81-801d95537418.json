  "schema_version": 1,
  "id": "e48c7d0f-234a-50d4-8b81-801d95537418",
  "slug": "sizzlin-fajitas",
  "name": "Sizzlin' Fajitas",
  "recipe_type": "main",
  "brief_description": "These simple and quick versatile fajitas make for the perfect dinner for a busy weeknight.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Grind garlic with kosher salt with a mortar and pestle until a paste forms. Whisk garlic paste, lime juice, olive oil, cilantro, chili powder, sugar, paprika, and cayenne pepper together in a bowl; pour marinade into a resealable plastic bag. Add skirt steak strips, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 2 hours to overnight."
    },
    {
      "position": 2,
      "text": "Remove steak from marinade and shake off excess; discard remaining marinade."
    },
    {
      "position": 3,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Wrap tortillas tightly in aluminum foil to form a packet and place packet on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until warmed through, about 10 minutes. Keep warm."
    },
    {
      "position": 5,
      "text": "Heat 1 teaspoon canola oil in a large skillet over high heat until oil begins to smoke. Saute onion and bell pepper in hot oil until browned and almost tender, 4 to 5 minutes. Transfer onion and pepper to a plate."
    },
    {
      "position": 6,
      "text": "Heat 1 teaspoon canola oil in the same skillet over high heat until oil starts to smoke. Cook 1/2 of the steak in hot oil until browned on all sides but still pink in the center, 4 to 6 minutes. Transfer cooked steak to the plate with onion and pepper."
    },
    {
      "position": 7,
      "text": "Heat remaining canola oil in the same skillet. Cook remaining steak in hot oil until browned on all sides but still pink in the center, 4 to 6 minutes. Stir cooked steak, onion, bell pepper, and any accumulated juices back into the skillet. Add minced garlic and salt; cook and stir until fragrant and heated through. Remove from heat. Divide steak mixture between warm tortillas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "2f1b4d71-e2c7-5a1e-bb9a-47b8c2c911f2",
  "slug": "mexican-cream-cheese-dip",
  "name": "Mexican Cream Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "Spinach, salsa, seasoning, and Cheddar cheese give zesty, savory flavor to this Mexican cream cheese dip that's perfect for entertaining.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine salsa, spinach, cream cheese, 1 cup Cheddar cheese, and Mexican seasoning in a large bowl. Spread into an oven-safe dish. Sprinkle with remaining Cheddar cheese."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, in the preheated oven until heated through and cheese is melted, 20 to 25 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

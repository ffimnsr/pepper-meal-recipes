  "id": "2ca80668-38c8-57b9-bafa-acee5bc7ba2d",
  "slug": "zucchini-bread-pumpkin-style",
  "name": "Zucchini Bread, Pumpkin Style",
  "recipe_type": "breakfast",
  "brief_description": "Here's a flavorful zucchini bread with a pumpkin-like taste because the zucchini are pureed in a blender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9x5-inch loaf pans; set aside."
    },
    {
      "position": 2,
      "text": "Place zucchini into a large saucepan and cover with water. Bring to a boil and cook until zucchini are tender, about 5 minutes. Drain zucchini, place in a blender, and blend until smooth, about 2 minutes. Let pur\u00e9e cool for about 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix together flour, baking powder, baking soda, salt, cinnamon, nutmeg, and cloves in a medium bowl until well combined; stir to eliminate lumps."
    },
    {
      "position": 4,
      "text": "Place zucchini pur\u00e9e in a large bowl. Add oil, sugar, and eggs; whisk until well combined. Beat in flour mixture to form a thick batter. Divide batter evenly among the prepared loaf pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the tops are lightly browned and the centers spring back when gently pressed, 45 to 60 minutes. A toothpick inserted into the centers should come out clean. Cool in the pans for 10 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

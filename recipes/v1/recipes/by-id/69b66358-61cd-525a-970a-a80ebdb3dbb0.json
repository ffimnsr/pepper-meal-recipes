  "id": "69b66358-61cd-525a-970a-a80ebdb3dbb0",
  "slug": "korean-bbq-galbi",
  "name": "Korean BBQ Galbi",
  "recipe_type": "dessert",
  "brief_description": "This galbi recipe for Korean BBQ uses flanken-cut short ribs soaked in a sweet sesame soy marinade, then grilled for a tender, delicious meaty dish.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place ribs in a large pot and cover with cold water. Soak ribs in the refrigerator for 1 hour to pull out any blood. Drain."
    },
    {
      "position": 2,
      "text": "Combine Asian pear, onion, and garlic in a blender; blend until smooth. Pour into a large bowl and stir in soy sauce, brown sugar, honey, sesame oil, and black pepper. Add ribs to soy mixture; turn to coat evenly. Cover the bowl and marinate in the refrigerator, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove ribs from marinade and cook on the preheated grill until meat is tender and the outside is crusty, 5 to 10 minutes per side. Discard marinade."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

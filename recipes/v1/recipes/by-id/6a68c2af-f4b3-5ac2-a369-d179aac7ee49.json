  "id": "6a68c2af-f4b3-5ac2-a369-d179aac7ee49",
  "slug": "crushed-pretzel-crab-cakes",
  "name": "Crushed Pretzel Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "These quick and easy pan-fried crab cakes are made light and fluffy and with added texture from crushed pretzels.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 3 tablespoons butter in a skillet over medium-high heat. Saute onion in the hot butter until soft, 5 to 7 minutes. Set aside."
    },
    {
      "position": 2,
      "text": "Mix crushed pretzels, garlic powder, paprika, and pepper together in a bowl. Add crabmeat and egg, followed by onion. Mix together and form into small, palm-size patties."
    },
    {
      "position": 3,
      "text": "Melt remaining butter in a pan over medium-high heat. Cook the patties until golden brown, about 4 minutes per side. Serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "7db522d6-9d95-5c14-9bde-5a416913a61b",
  "slug": "applesauce-oatmeal-bites-for-toddlers",
  "name": "Applesauce Oatmeal Bites for Toddlers",
  "recipe_type": "appetizer",
  "brief_description": "In no time at all, applesauce and oats are baked into tasty on-the-go fruit bites that can be packed and taken to the playground or park to appease those hungry toddlers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8-inch square baking dish with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine oats and applesauce until moist. Spread into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until sticky, 10 to 12 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven, flip onto a cutting board, and cut into 1-inch squares. Allow to cool before serving."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "11142f02-e96c-5799-bdea-bfc19f7e4168",
  "slug": "chicken-alfredo-garlic-bread-recipe-11703384",
  "name": "Chicken Alfredo Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This chicken Alfredo garlic bread is delicious with a seasoned Alfredo sauce, chopped chicken, and 3 kinds of cheese, baked on a toasted French loaf.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a small bowl whisk together 5 tablespoons melted butter, 1 tablespoon garlic powder, and 1 tablespoon parsley. Place French bread, cut sides up, on a baking sheet. Brush butter mixture evenly onto cut sides of bread."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are golden brown, 4 to 5 minutes. Remove and set aside. Do not turn the oven off."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat Alfredo sauce in a saucepan over medium heat, stirring often. Add remaining 3 tablespoons butter, 1/4 cup Parmesan, remaining 1/2 teaspoon garlic powder, onion powder, smoked paprika, salt, and pepper. Stir until butter is melted and ingredients are well combined. Remove from heat."
    },
    {
      "position": 5,
      "text": "Spread half of Alfredo mixture evenly over toasted bread. Add chopped chicken over Alfredo, and top evenly with remaining 1/4 cup Parmesan cheese, Gruyere, and Monterey Jack cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is bubbly and golden brown, 8 to 10 minutes."
    },
    {
      "position": 7,
      "text": "To serve, cut into 2-inch slices. Garnish with fresh parsley and serve with remaining Alfredo sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

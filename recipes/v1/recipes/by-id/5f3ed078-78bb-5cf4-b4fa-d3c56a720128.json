  "id": "5f3ed078-78bb-5cf4-b4fa-d3c56a720128",
  "slug": "copycat-cream-cheese-danish-toaster-strudels-recipe-11908817",
  "name": "Copycat Cream Cheese Danish Toaster Strudels",
  "recipe_type": "breakfast",
  "brief_description": "These copycat cream cheese Danish toaster strudels are not difficult, and they don't take much time. Puff pastry is baked over cream cheese, butter, and brown sugar, then turned over. It's an easy way to make delicious breakfast pastry.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Place cream cheese in the freezer for 15 minutes before preparation."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Slice butter into 12 slices. Place 2 slices vertically in 6 sections on the prepared baking sheet. Top each set of butter slices with 1 tablespoon brown sugar."
    },
    {
      "position": 4,
      "text": "Slice partially frozen cream cheese into 12 slices. Set 2 slices side by side on top of brown sugar sections."
    },
    {
      "position": 5,
      "text": "Lightly roll puff pastry on a lightly floured surface. Cut pastry sheet into 6 rectangles. Press pastry around each mound of cream cheese mixture, pressing slightly down on the cream cheese. Use a fork to crimp the edges of each pastry. Brush pastries with beaten egg."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and flaky, 15 to 18 minutes. Let stand on the baking sheet for 10 minutes before carefully turning over."
    },
    {
      "position": 7,
      "text": "Meanwhile, whisk together confectioner\u2019s sugar and milk until smooth. Drizzle desired amount of icing over pastries."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5ad8655d-c522-52ae-913a-cd2f22e50958",
  "slug": "eggnog-latte",
  "name": "Eggnog Latte",
  "recipe_type": "breakfast",
  "brief_description": "This eggnog latte is easy to make with espresso, eggnog, milk, and a pinch of nutmeg for a creamy and delicious coffee drink over the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour milk and eggnog into a steaming pitcher and heat to between 145 degrees F to 165 degrees F (65 to 70 degrees C) using the steaming wand."
    },
    {
      "position": 3,
      "text": "Brew a shot of espresso; pour into a mug. Pour steamed milk and eggnog into the mug, using a spoon to hold back the foam."
    },
    {
      "position": 4,
      "text": "Spoon foam over the top. Sprinkle nutmeg on top of foam."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 1,

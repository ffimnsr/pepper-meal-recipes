  "id": "5a29e139-8009-594c-888e-86a706dc7fef",
  "slug": "oatmeal-chocolate-chip-cookies-iii",
  "name": "Oatmeal Chocolate Chip Cookies III",
  "recipe_type": "dessert",
  "brief_description": "These cookies are great. There good for parties, sleepovers, ect.. You'll love them! Enjoy!!!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter or margarine, sugars and vanilla until light and fluffy. Add flour and salt, mix well."
    },
    {
      "position": 2,
      "text": "Dissolve baking soda in boiling water and add to mixture. Stir in rolled oats, raisins and chocolate chips."
    },
    {
      "position": 3,
      "text": "Drop by teaspoonful onto ungreased cookie sheet. Bake at 350 degrees F (175 degrees C) for 10-12 minutes. Don't over cook. (There are no eggs in this recipe, I didn't forget to type it down)."
    }
  ],

  "id": "12ec88c8-138e-524b-b852-6f2d1feebcab",
  "slug": "easy-garlic-lemon-scallops",
  "name": "Easy Garlic-Lemon Scallops",
  "recipe_type": "main",
  "brief_description": "This scallop recipe makes deliciously tender saut\u00e9ed scallops with a buttery lemon-garlic pan sauce for a restaurant-worthy meal that's easy to make!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Stir in garlic and cook for a few seconds until fragrant."
    },
    {
      "position": 3,
      "text": "Arrange scallops in a single layer in the skillet; cook until golden brown on one side, about 2 minutes. Turn scallops over using tongs and continue cooking until firm and opaque, about 2 minutes more."
    },
    {
      "position": 4,
      "text": "Transfer scallops to a platter, reserving butter in the skillet."
    },
    {
      "position": 5,
      "text": "Whisk lemon juice, salt, and pepper into butter; pour sauce over scallops to serve."
    },
    {
      "position": 6,
      "text": "Enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

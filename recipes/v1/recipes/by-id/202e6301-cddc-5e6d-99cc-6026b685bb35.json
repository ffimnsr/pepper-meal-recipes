  "id": "202e6301-cddc-5e6d-99cc-6026b685bb35",
  "slug": "crab-stuffed-manicotti",
  "name": "Crab-Stuffed Manicotti",
  "recipe_type": "main",
  "brief_description": "Manicotti shells stuffed with crab meat and covered with Alfredo sauce make a great meal for family or company.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add manicotti shells and cook for 8 to 10 minutes, until tender but not mushy. Drain."
    },
    {
      "position": 3,
      "text": "In a medium bowl, stir together the ricotta cheese, crab, parsley and onion. Spoon into the manicotti shells. Place in a buttered 11x7 inch baking dish."
    },
    {
      "position": 4,
      "text": "In a saucepan, stir together the Alfredo sauce and chicken broth. Season with sugar, basil, marjoram, garlic powder and thyme. Heat until warm over medium heat. Pour over the shells in the baking dish."
    },
    {
      "position": 5,
      "text": "Bake uncovered for 30 minutes in the preheated oven. Let stand for about 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

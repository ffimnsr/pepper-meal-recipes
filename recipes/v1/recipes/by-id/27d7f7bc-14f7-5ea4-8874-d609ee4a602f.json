  "id": "27d7f7bc-14f7-5ea4-8874-d609ee4a602f",
  "slug": "stovetop-stuffing-meatloaf-recipe-8686723",
  "name": "Stovetop Stuffing Meatloaf",
  "recipe_type": "main",
  "brief_description": "Try this stovetop stuffing meatloaf for an easy dinner option to whip up any day of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line an 8- x 4-inch loaf pan with a double layer of aluminum foil, leaving a 3-inch overhang on the long sides. Lightly coat with cooking spray and place on a baking sheet."
    },
    {
      "position": 2,
      "text": "Using your hands, mix beef, stuffing mix, water, egg, salt, poultry seasoning, and 1/2 cup of the ketchup in a large bowl until evenly combined without overmixing."
    },
    {
      "position": 3,
      "text": "Press into the prepared loaf pan on the baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top is browned and the sides are bubbly, about 35 minutes."
    },
    {
      "position": 5,
      "text": "While meatloaf bakes, whisk together brown sugar and remaining 1/2 cup ketchup in a small bowl until smooth. Remove meatloaf from the oven and spread ketchup mixture evenly over the top."
    },
    {
      "position": 6,
      "text": "Return to the oven and continue baking at 350 degrees F (175 degrees C) until an instant-read thermometer inserted into the thickest portion of meatloaf registers 160 degrees F (71 degrees C), 10 to 15 minutes. Remove from oven and allow to rest for 5 minutes."
    },
    {
      "position": 7,
      "text": "Remove meatloaf from loaf pan using foil overhang as handles, and transfer to a cutting board. Cut into 8 slices. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

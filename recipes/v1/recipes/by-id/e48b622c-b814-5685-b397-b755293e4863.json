  "id": "e48b622c-b814-5685-b397-b755293e4863",
  "slug": "deviled-egg-potato-salad-recipe-8682219",
  "name": "Deviled Egg Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This deviled egg potato salad has a deviled egg yolk dressing and chopped egg whites to mimic everyone's favorite appetizer. Eggs and potatoes cook together to make prep and cleanup easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with water up to 3 inches above the potatoes. Add salt and eggs and bring to a boil over high heat; reduce heat to a low boil and cook for 10 minutes."
    },
    {
      "position": 2,
      "text": "Remove eggs from water using a slotted spoon and place them in an ice bath. Continue cooking potatoes until tender, 5 to 10 minutes more, and drain. Let cool slightly."
    },
    {
      "position": 3,
      "text": "Peel eggs and cut each one in half. Remove yolks and place in a large bowl. Finely chop whites and set aside. Mash yolks with a fork until fully broken down. Add mayonnaise, mustard, vinegar and pepper to yolks and stir well."
    },
    {
      "position": 4,
      "text": "Add cooked potatoes, reserved egg whites, relish, celery and onion to the bowl and stir until well combined. Season with more salt and pepper to taste. Transfer salad to a serving bowl and sprinkle with paprika and chives."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

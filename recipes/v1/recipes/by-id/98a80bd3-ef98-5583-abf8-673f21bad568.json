  "id": "98a80bd3-ef98-5583-abf8-673f21bad568",
  "slug": "quick-and-easy-coconut-macaroons",
  "name": "Quick and Easy Coconut Macaroons",
  "recipe_type": "dessert",
  "brief_description": "These coconut macaroons are quick and easy to make and delicious to eat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray baking sheets with cooking spray."
    },
    {
      "position": 3,
      "text": "Whisk egg whites and cream of tartar together in a bowl until foamy."
    },
    {
      "position": 4,
      "text": "Gradually whisk sugar into egg white mixture until blended."
    },
    {
      "position": 5,
      "text": "Whisk almond extract and flour into egg white mixture until stiff peaks have formed. The egg whites should form a sharp peak that holds its shape when whisk is held straight up."
    },
    {
      "position": 6,
      "text": "Fold coconut into egg white mixture until incorporated."
    },
    {
      "position": 7,
      "text": "Drop spoonfuls of batter onto prepared baking sheets."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until just golden brown, 8 to 9 minutes. Cool on baking sheets for about 2 minutes; transfer to wire rack to completely cool."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

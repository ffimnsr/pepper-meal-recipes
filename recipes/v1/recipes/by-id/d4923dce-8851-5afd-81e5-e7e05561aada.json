  "id": "d4923dce-8851-5afd-81e5-e7e05561aada",
  "slug": "flat-iron-steak-with-balsamic-reduction",
  "name": "Flat Iron Steak with Balsamic Reduction",
  "recipe_type": "dessert",
  "brief_description": "For this flat iron steak with balsamic reduction recipe, pepper-crusted flat iron steaks are pan seared then drizzled with a sweet and savory syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Brush flat iron steak with olive oil; press into ground peppercorns, then season with salt. Set aside. Melt butter in a large skillet over medium-high heat. Add steak; cook to desired degree of doneness, about 4 minutes per side for medium-rare. Transfer steak to a plate; keep warm."
    },
    {
      "position": 2,
      "text": "Add garlic to the skillet; cook over medium heat until begins to brown around edges, about 1 minute. Pour in balsamic vinegar, increase heat to medium-high, cook until vinegar has reduced by half."
    },
    {
      "position": 3,
      "text": "Thinly slice steak against the grain; arrange on a serving platter. Pour reduced balsamic vinegar over top; sprinkle with chopped parsley to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

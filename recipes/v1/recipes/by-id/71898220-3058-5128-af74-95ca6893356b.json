  "slug": "frogmore-stew",
  "name": "Frogmore Stew",
  "recipe_type": "soup",
  "brief_description": "Frogmore stew is a traditional South Carolina low country boil made with unpeeled shrimp, corn on the cob, new red potatoes, and hot smoked sausage.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and Old Bay seasoning to a boil in a large stockpot over high heat."
    },
    {
      "position": 2,
      "text": "Add potatoes; cook for 15 minutes. Add sausage; cook for 5 more minutes. Add corn; cook for 5 more minutes. Stir in shrimp; cook until shrimp are pink, about 5 minutes. Drain immediately and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "2b05f733-3f28-5f6b-a314-d0e37c39fe21",
  "slug": "chef-johns-chocolate-pecan-pie",
  "name": "Chef John's Chocolate Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "Easy, delicious, and made more decadent with the addition of chocolate chips, this pecan pie is a must-have on your holiday table.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place a foil-lined baking sheet on the lowest shelf."
    },
    {
      "position": 2,
      "text": "Place dough in a 9-inch pie pan and crimp edges if desired."
    },
    {
      "position": 3,
      "text": "Whisk eggs in a large bowl with a wire whisk until pale and frothy, about 2 minutes. Whisk in milk and vanilla. Mix in brown sugar, white sugar, and flour until incorporated. Pour in melted butter and whisk until fully combined. Stir in pecans."
    },
    {
      "position": 4,
      "text": "Spread chocolate chips evenly over the bottom of the pie crust. Gently pour filling over top and gently tap the pie pan so the filling settles."
    },
    {
      "position": 5,
      "text": "Bake in the center of the preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C) and bake until crust is golden brown and filling is set and no longer jiggly, 30 to 35 minutes more."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool to room temperature before serving, about 2 hours. You can refrigerate it once it's reached room temperature and serve cold, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

  "id": "ae018fc6-8991-5d55-bfbe-05fc9f990744",
  "slug": "lemon-garlic-air-fryer-salmon",
  "name": "Lemon-Garlic Air Fryer Salmon",
  "recipe_type": "main",
  "brief_description": "This buttery lemon-garlic salmon is easy to throw together in the air fryer with a few simple ingredients. For best results, use center-cut fillets that are about 1-inch thick.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 390 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine melted butter and minced garlic in a small bowl."
    },
    {
      "position": 3,
      "text": "Rinse salmon fillets and dry with a paper towel. Brush with butter mixture and sprinkle with lemon-pepper seasoning and parsley."
    },
    {
      "position": 4,
      "text": "Spray the basket of the air fryer with cooking spray. Place salmon fillets in the basket, skin-side down, and top each with 3 lemon halves."
    },
    {
      "position": 5,
      "text": "Cook in the preheated air fryer for 8 to 10 minutes. Remove from the air fryer and let rest for 2 minutes before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

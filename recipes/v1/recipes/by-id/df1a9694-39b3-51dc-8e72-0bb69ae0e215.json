  "id": "df1a9694-39b3-51dc-8e72-0bb69ae0e215",
  "slug": "easiest-ever-fruit-cobbler",
  "name": "Easiest Ever Fruit Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Canned peaches and butter are topped with a sweet dough made with self-rising flour and baked in a hot oven for a quick and easy cobbler.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Stir together peaches and juice with melted butter. Pour into prepared pan. In a small bowl mix flour, sugar and salt. Stir in milk. Pour mixture over peaches."
    },
    {
      "position": 3,
      "text": "Bake on bottom rack of preheated oven 15 minutes, or until lightly browned, then move to top rack for 20 minutes more. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

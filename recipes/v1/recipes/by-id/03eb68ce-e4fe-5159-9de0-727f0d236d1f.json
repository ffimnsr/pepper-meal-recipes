  "id": "03eb68ce-e4fe-5159-9de0-727f0d236d1f",
  "slug": "hot-dog-mummies",
  "name": "Hot Dog Mummies",
  "recipe_type": "appetizer",
  "brief_description": "These mummy hot dogs wrapped in crispy crescent roll dough are fun to make for Halloween; decorate with mustard or eyes to look like little mummies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place hot dogs in a saucepan and cover with water; bring to a boil. Reduce heat to medium-low and simmer until warmed through, about 5 minutes. Drain and pat dry with paper towels."
    },
    {
      "position": 3,
      "text": "Unroll crescent dough and separate into 8 strips. Wrap 1 strip of dough around each hot dog, leaving small gaps for the eyes, to create the look of a mummy."
    },
    {
      "position": 4,
      "text": "Place dots of mustard on the top of each for the eyes, nose, and mouth. Arrange hot dogs on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crescent dough is golden brown and flaky, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "5b273704-cfdb-544a-8ad7-4119e1c135f7",
  "slug": "salmon-caesar-salad-recipe-8667191",
  "name": "Salmon Caesar Salad",
  "recipe_type": "salad",
  "brief_description": "This salmon Caesar salad, with Romaine lettuce, topped with cold salmon, toasted croutons, and a homemade Caesar dressing, will be the salad you will make all summer long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set a nonstick skillet over medium high heat. Heat 2 teaspoons oil until it shimmers. Add salmon, skin side down. Brush with honey; sprinkle with salt and pepper. Cover and cook for 4 minutes."
    },
    {
      "position": 2,
      "text": "Carefully flip salmon and reduce the heat to medium. Continue cooking until fish flakes easily with a fork, about 5 minutes more. Remove salmon to a plate or container; cover and refrigerate until very cold, at least 2 hours."
    },
    {
      "position": 3,
      "text": "For dressing, crack an egg into a food processor. Add lemon juice, Worcestershire, Dijon, garlic, anchovies, grated Parmesan and black pepper; pulse to combine. With food processor running, drizzle in oil until mixture emulsifies. Refrigerate dressing until needed."
    },
    {
      "position": 4,
      "text": "For croutons, melt butter in a heavy skillet over medium-high heat. Add bread cubes; sprinkle with Italian seasoning and granulated garlic."
    },
    {
      "position": 5,
      "text": "Toast until croutons are browned, about 5 minutes. Remove from heat; set aside."
    },
    {
      "position": 6,
      "text": "For salad, add lettuce to a large bowl. Flake salmon with a fork into bite-sized pieces and add to the bowl. Drizzle with Caesar dressing; top with croutons and shaved Parmesan."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

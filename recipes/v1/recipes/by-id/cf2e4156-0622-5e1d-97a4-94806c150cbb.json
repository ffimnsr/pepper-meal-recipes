  "id": "cf2e4156-0622-5e1d-97a4-94806c150cbb",
  "slug": "chef-johns-summer-scrambled-eggs",
  "name": "Chef John's Summer Scrambled Eggs",
  "recipe_type": "breakfast",
  "brief_description": "Chef John's recipe for scrambled eggs with cherry tomatoes, feta cheese, and fresh basil is a delicious breakfast option for any time of the year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs and pepper flakes together in a bowl. Stir in tomatoes, feta, and basil."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a nonstick skillet over high heat until starting to shimmer. Pour egg mixture into hot oil and cook, without stirring, for 5 seconds."
    },
    {
      "position": 3,
      "text": "Cook and stir egg mixture until eggs are scrambled and softly set, about 30 seconds. Transfer to a plate and sprinkle with sea salt."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,

  "id": "8e221714-6e4c-533c-bca6-00ebc1a9a76d",
  "slug": "spinach-tortellini-soup",
  "name": "Spinach Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "This spinach tortellini soup is super quick and easy to make by combining frozen spinach and packaged cheese tortellini in a garlicky chicken broth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken broth and spinach in a large pot over high heat; bring to a boil."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low and stir in tortellini; cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, about 3 to 5 minutes. Season with basil, garlic powder, salt, and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

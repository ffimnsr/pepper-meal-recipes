  "schema_version": 1,
  "id": "3d5cbb87-3397-52bd-a79d-0c5cb1cd0735",
  "slug": "leftover-ham-n-potato-casserole",
  "name": "Leftover Ham -n- Potato Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This cheesy ham and potato casserole combines leftover holiday ham and potatoes in a creamy sauce for a comforting post-holiday brunch or easy dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Grease a 1 \u00bd-quart baking dish."
    },
    {
      "position": 3,
      "text": "When the potatoes are almost finished, melt 3 tablespoons butter in a skillet over medium heat. Add ham and onion; cook and stir until the onion has softened and turned translucent, about 5 minutes. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Drain potatoes; add to the ham mixture and stir to combine. Transfer to the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Melt remaining 4 tablespoons butter in a saucepan over medium heat. Whisk in flour and stir until the mixture becomes paste-like and light golden brown, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Gradually whisk milk into the flour mixture; season with salt and black pepper. Continue cooking and stirring until thickened, about 2 minutes. Reduce heat to medium-low and stir in Cheddar cheese until melted."
    },
    {
      "position": 7,
      "text": "Pour cheese sauce over ham and potatoes. Sprinkle bread crumbs over top."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until sauce is bubbly and browned, 25 to 30 minutes."
    },
    {
      "position": 9,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

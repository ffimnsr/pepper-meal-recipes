  "id": "2422f5aa-e823-59ce-9e44-d1480ccfa007",
  "slug": "no-bake-carrot-cheesecake-recipe-11709646",
  "name": "No-Bake Carrot Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This no-bake carrot cheesecake is the perfect combination of carrot cake and cheesecake with a graham cracker crust, a smooth, creamy carrot filling, and topped with whipped cream, coconut, and pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place carrots into a saucepan and cover with water. Bring to a boil. Reduce heat and simmer, covered, until carrots are tender, about 20 minutes. Drain, but reserve cooking liquid. Transfer carrots to a blender container. Cover and blend until smooth, adding reserved liquid, 1 tablesppon. at a time as needed. You should get 1 cup of carrot puree. Chill until ready to use."
    },
    {
      "position": 3,
      "text": "In a small bowl combine graham cracker crumbs, 1/2 cup toasted coconut, butter, 2 tablespoons brown sugar and salt. Press very firmly into the bottom of a 9-inch springform pan. Chill until ready to use."
    },
    {
      "position": 4,
      "text": "Beat whipping cream in a bowl with an electric mixer until stiff peaks form. Set aside."
    },
    {
      "position": 5,
      "text": "Beat cream cheese in a large bowl with an electric mixer until completely smooth and creamy, scraping the bowl as needed."
    },
    {
      "position": 6,
      "text": "Add 1 cup carrot puree, powdered sugar, and remaining 4 tablespoons brown sugar. Beat on medium-high speed until well combined, scraping the bowl as needed. Add thevanilla, cinnamon, ginger, nutmeg and salt and beat until combined and smooth."
    },
    {
      "position": 7,
      "text": "Slowly fold in whipped cream with a spatula until just combined, careful to not deflate the whipped cream."
    },
    {
      "position": 8,
      "text": "Pour filling into the prepared crust, spreading evenly."
    },
    {
      "position": 9,
      "text": "Cover and chill overnight. Serve topped with additional whipped cream, candied pecans and remaining toasted coconut. Recipe developed by Nicole Irwin."
    }
  ],
  "servings": 12,

  "id": "b2d8974a-5994-5d19-9202-0ccf1236d9d5",
  "slug": "yummy-vegan-pesto-classico",
  "name": "Yummy Vegan Pesto",
  "recipe_type": "side",
  "brief_description": "This vegan pesto recipe is easy to make with olive oil, toasted pine nuts, basil, garlic, and nutritional yeast for that cheesy flavor everyone loves!",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place pine nuts in a skillet over medium heat; cook, stirring or shaking the pan often, until lightly toasted."
    },
    {
      "position": 2,
      "text": "Place toasted pine nuts, olive oil, garlic, nutritional yeast, and basil in a food processor; blend until smooth. Season with salt and pepper."
    }
  ],

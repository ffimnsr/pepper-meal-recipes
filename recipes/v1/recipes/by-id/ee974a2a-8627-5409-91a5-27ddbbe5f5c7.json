  "id": "ee974a2a-8627-5409-91a5-27ddbbe5f5c7",
  "slug": "poppy-seed-cake-iii",
  "name": "Poppy Seed Cake III",
  "recipe_type": "dessert",
  "brief_description": "A moist pound cake. Can be baked in tube, Bundt, or 2 loaf pans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F. Grease and flour a 10 inch tube pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix flour, baking soda, salt and sugar. Make a well in the center and add eggs, vanilla, oil and milk. Mix well and fold in the poppy seeds. Pour into a 10 inch tube pan."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour, or until a toothpick inserted into the cake comes out clean. Cool for 10 minutes in the pan, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 60,

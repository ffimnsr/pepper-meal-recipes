  "id": "841ba86e-1e09-5ee3-8b06-a040f6f123ee",
  "slug": "microwave-apple-crisp",
  "name": "Microwave Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "This microwave apple crisp has a layer of tender apple slices cooked with a buttery crisp topping of brown sugar, oats, flour, cinnamon, and allspice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread apples evenly in an 8-inch square microwave-safe baking dish. Mix brown sugar, oats, flour, melted butter, cinnamon, and allspice together in a medium bowl until well combined; sprinkle evenly over apples."
    },
    {
      "position": 2,
      "text": "Cook in the microwave on high until apples are easily pierced with a knife, 10 to 12 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

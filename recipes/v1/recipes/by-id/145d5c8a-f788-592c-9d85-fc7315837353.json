  "id": "145d5c8a-f788-592c-9d85-fc7315837353",
  "slug": "espresso-brownies-recipe-8636011",
  "name": "Espresso Brownies",
  "recipe_type": "dessert",
  "brief_description": "Espresso brownies, made extra rich with espresso powder and baking chocolate, taste even better the second day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 11x7-inch baking pan. Sift flour, espresso powder, baking powder, and salt together in a bowl."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in eggs until smooth batter forms; beat in chocolate and vanilla extract. Stir flour mixture in just until incorporated; fold in walnuts. Spread batter into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, 35 to 40 minutes. Cool completely before cutting."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

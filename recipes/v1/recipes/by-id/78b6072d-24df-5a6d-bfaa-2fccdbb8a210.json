  "id": "78b6072d-24df-5a6d-bfaa-2fccdbb8a210",
  "slug": "bettys-3-bean-hot-dish-a-la-minnesota",
  "name": "Betty's 3-Bean Hot Dish (a la Minnesota)",
  "recipe_type": "side",
  "brief_description": "Comforting, hearty, meaty, and savory, this three-bean hot dish is perfect for potlucks, and it's easy to keep warm in the slow cooker.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble when cooled. Wipe out skillet with a paper towel."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Add onion and cook until clear, about 5 minutes more."
    },
    {
      "position": 3,
      "text": "Combine cooked bacon, cooked beef, pork and beans, kidney beans, butter beans, ketchup, brown sugar, vinegar, and mustard in a slow cooker. Stir to combine. Cook on High until heated through, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

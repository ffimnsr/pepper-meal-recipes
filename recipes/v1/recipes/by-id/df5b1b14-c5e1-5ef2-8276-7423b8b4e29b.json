  "id": "df5b1b14-c5e1-5ef2-8276-7423b8b4e29b",
  "slug": "chorizo-latkes",
  "name": "Chorizo Latkes",
  "recipe_type": "dessert",
  "brief_description": "Spicy beef chorizo gives these Polish potato pancakes a Mexican twist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Shred potatoes; wring out excess water in a dish towel. Transfer to a large bowl and mix in eggs. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat 1 teaspoon oil in a large skillet over medium heat. Add chorizo; cook and stir until browned, 4 to 5 minutes. Drain, reserving 1 teaspoon grease in the skillet. Add onion; cook and stir until translucent, about 4 minutes. Fold into potatoes until well-combined."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon oil in another large skillet until almost smoking. Add heaping tablespoonfuls of the potato mixture; press down to flatten slightly. Cook until golden brown, about 2 minutes per side. Continue with remaining potato mixture. Drain on paper towels."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,

  "id": "ba0c2677-459f-5fbd-9287-b03eb172391b",
  "slug": "tuscan-pork-tenderloin",
  "name": "Tuscan Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "This baked pork tenderloin is so easy and ready in under half an hour. Season it with garlic, rosemary, and oregano, then bake it to perfection.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine garlic, rosemary, oregano, salt, and pepper in a small bowl."
    },
    {
      "position": 4,
      "text": "Rub spice mixture all over pork tenderloin. Place on a wire rack over a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until pork is slightly pink in the center, 20 to 25 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Remove from the oven and let stand for 5 minutes before slicing."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

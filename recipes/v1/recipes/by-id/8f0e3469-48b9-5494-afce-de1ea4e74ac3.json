  "id": "8f0e3469-48b9-5494-afce-de1ea4e74ac3",
  "slug": "gluten-free-banana-bread",
  "name": "Gluten Free Banana Bread",
  "recipe_type": null,
  "brief_description": "A yummy, kid-approved gluten-free banana bread that will satisfy your pickiest eaters!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine flour, baking powder and salt. In a separate bowl, cream together butter and sugar. Stir in eggs, maple syrup and mashed bananas until well blended. Add the banana mixture to the flour mixture; mix until batter is just moist. Pour batter into prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 20 to 30 minutes, until a toothpick inserted into center of the loaf comes out clean. If using muffin or cupcake tins, bake for 15 minutes or until a toothpick inserted into the center of a muffin comes out clean."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

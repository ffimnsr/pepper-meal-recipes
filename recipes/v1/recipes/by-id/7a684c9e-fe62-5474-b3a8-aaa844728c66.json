  "slug": "homemade-coleslaw",
  "name": "Homemade Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This no-sugar coleslaw is a classic, doused in a vinegar and mayonnaise dressing.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl combine vinegar, mayonnaise, and mustard."
    },
    {
      "position": 2,
      "text": "In a large bowl combine cabbage, carrots, bell peppers, and celery."
    },
    {
      "position": 3,
      "text": "Pour dressing over vegetables, mixing evenly to coat. Chill and serve over lettuce leaves."
    }
  ],
  "servings": 8,

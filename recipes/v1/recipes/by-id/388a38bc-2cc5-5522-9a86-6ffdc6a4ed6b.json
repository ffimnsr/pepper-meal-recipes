  "slug": "easy-strawberry-shortcake",
  "name": "Easy Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This strawberry shortcake is super quick to make using just 4 ingredients, including fresh strawberries and store-bought cake for a delicious summer treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries in a bowl; add sugar and stir to coat. Cover and refrigerate until sugar has dissolved, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Place 1 dessert cup in each serving bowl and smother with sweetened strawberries. Top each with whipped cream."
    }
  ],
  "servings": 6,

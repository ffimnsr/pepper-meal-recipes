  "id": "a0c92fe2-b56d-5a5a-a0f0-6b09f118a090",
  "slug": "delicious-raspberry-oatmeal-cookie-bars",
  "name": "Delicious Raspberry Oatmeal Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "This oatmeal cookie bar recipe is easy to make with seedless raspberry jam sandwiched between buttery brown sugar-oat cookie crusts for a sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch square pan; line with greased foil."
    },
    {
      "position": 2,
      "text": "Combine flour, oats, brown sugar, baking soda, and salt in a large bowl. Rub in butter using your hands or a pastry blender to form a crumbly mixture."
    },
    {
      "position": 3,
      "text": "Press 2 cups oat mixture into the bottom of the prepared pan."
    },
    {
      "position": 4,
      "text": "Spread jam to within 1/4 inch of the edge."
    },
    {
      "position": 5,
      "text": "Sprinkle remaining crumb mixture on top; press down lightly into jam."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly browned, 35 to 40 minutes."
    },
    {
      "position": 7,
      "text": "Allow to cool before cutting into bars."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "50f5568c-a4b6-5f03-aad5-3fc812188db7",
  "slug": "southwestern-pulled-pork-sliders-recipe-8786436",
  "name": "Southwestern Pulled Pork Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These Southwestern pulled pork sliders are a great way to use leftover cooked pork. Shred it, stir in into a tasty sauce, top with zippy slaw, and re-purpose your pork as sliders.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For slaw, combine mayonnaise, chipotle peppers, adobo sauce, salt, and cilantro in the bowl of a blender or food processor. Pulse 4 or 5 times, scrape down the sides of the bowl, replace the lid, and puree until smooth. Toss with slaw mix and set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) and line a sheet pan with foil."
    },
    {
      "position": 3,
      "text": "For pork, in a microwave-safe bowl, combine lime juice, honey, tomato paste, cumin, smoked paprika, cayenne, pepper, coriander and garlic. Stir to combine. Add shredded pork and stir well. Heat on 50% power until warm, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, place open buns on the prepared pan. Add a slice of smoked Gouda to the bottom half of each bun; trim any overhang, and add as a second layer of cheese."
    },
    {
      "position": 5,
      "text": "Bake buns in the preheated oven until cheese has begun to melt, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and place 2 tablespoons pork mixture on top of cheese. Add slaw to taste on each slider, and cover with top half of bun. Serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

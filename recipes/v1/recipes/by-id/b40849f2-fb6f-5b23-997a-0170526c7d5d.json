  "id": "b40849f2-fb6f-5b23-997a-0170526c7d5d",
  "slug": "sausage-jalapeno-poppers",
  "name": "Sausage Jalapeno Poppers",
  "recipe_type": "appetizer",
  "brief_description": "Jalapeno pepper slices are stuffed with a sausage and cream cheese mixture, then wrapped with bacon. They're a spicy, mouthwatering party favorite! Secure the bacon with toothpicks.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place ground sausage in a large, deep skillet. Cook over medium high heat until evenly brown."
    },
    {
      "position": 3,
      "text": "Drain sausage and place in a medium bowl. Mix with the cream cheese."
    },
    {
      "position": 4,
      "text": "Cut jalapenos in half lengthwise. Remove the seeds. Stuff each jalapeno half with equal portions of the sausage and cream cheese mixture. Wrap with half slices of bacon. Secure bacon with toothpicks."
    },
    {
      "position": 5,
      "text": "Arrange wrapped jalapenos in a large, shallow baking dish. Bake in the preheated oven 20 minutes, or until the bacon is evenly brown."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 60,

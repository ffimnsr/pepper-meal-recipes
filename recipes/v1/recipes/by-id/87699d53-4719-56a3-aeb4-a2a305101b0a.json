  "id": "87699d53-4719-56a3-aeb4-a2a305101b0a",
  "slug": "smoked-sausage-and-tortellini-skillet",
  "name": "Smoked Sausage and Tortellini Skillet",
  "recipe_type": "main",
  "brief_description": "This one-pan sausage tortellini skillet meal is delicious, cheesy, and even better, easy! Mix onion and pepper with sausage, tortellini and cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large 12-inch oven-safe skillet over medium-high heat and add smoked sausage. Cook until brown. Add garlic, onion, and bell pepper. Lower heat to medium and stir until vegetables are soft, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in cooked tortellini, marinara sauce, 1 cup cheese, and oregano."
    },
    {
      "position": 4,
      "text": "Top with remaining cheese. Bake in the preheated oven until cheese is melted and bubbly, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

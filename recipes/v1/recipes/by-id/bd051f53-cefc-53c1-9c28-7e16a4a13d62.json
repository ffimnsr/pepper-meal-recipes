  "id": "bd051f53-cefc-53c1-9c28-7e16a4a13d62",
  "slug": "famous-amos-chocolate-chip-cookies",
  "name": "Famous Amos Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "Make this Famous Amos chocolate chip cookie recipe for a nice large batch of warm, gooey cookies to share with everyone. They\u2019re irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together white sugar, brown sugar, butter, oil, egg, milk, and vanilla until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Add in flour, salt, cream of tartar, and baking soda. Mix in chocolate chips and walnuts."
    },
    {
      "position": 4,
      "text": "Drop dough by teaspoons onto ungreased cookie sheets. Bake in the preheated oven for 8 to 12 minutes. Cookies are light in color when done."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

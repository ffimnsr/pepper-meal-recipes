  "id": "579fa45a-a27f-54d1-a0ef-2c5a568b6d30",
  "slug": "cheesy-kielbasa-pasta-recipe-11731929",
  "name": "Cheesy Kielbasa Pasta",
  "recipe_type": "main",
  "brief_description": "This cheesy kielbasa pasta dish is a hearty, comforting dish made with sliced smoked sausage, protein pasta, vegetables, and a rich, creamy cheese sauce.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil, add penne and cook until tender with a bite, about 7 minutes; remove from heat."
    },
    {
      "position": 2,
      "text": "Meanwhile, add kielbasa to a skillet over medium-high heat. Cook until kielbasa coins are lightly browned. Add butter; when melted, add onion and saut\u00e9 until softened, about 4 minutes. Add garlic and cook until fragrant, about 30 seconds. Add in broccoli florets and mushrooms."
    },
    {
      "position": 3,
      "text": "Pour in chicken broth, cover, reduce heat, and simmer for 5 minutes. Stir in cream, Parmesan, Italian seasoning, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Strain pasta and stir into kielbasa mixture. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

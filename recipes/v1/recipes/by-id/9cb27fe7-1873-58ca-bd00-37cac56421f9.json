  "schema_version": 1,
  "id": "9cb27fe7-1873-58ca-bd00-37cac56421f9",
  "slug": "homemade-manti-traditional-turkish-dumplings",
  "name": "Homemade Manti (Traditional Turkish Dumplings)",
  "recipe_type": "main",
  "brief_description": "This manti recipe for boiled dumplings with seasoned ground meat wrapped in homemade egg pasta is served with garlicky yogurt sauce and pepper oil.",
  "cuisine": "Turkish",
  "instructions": [
    {
      "position": 1,
      "text": "Make dough: Combine flour and salt in a large bowl. Add eggs and water, mixing well with your hands. Add more water, if needed, to form a soft dough. Cover and set aside for at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Make filling: Shred onions and place them in a colander or sieve set over a bowl; drain and discard juice. Combine drained onion, ground beef, salt, and pepper in a medium bowl; mix well with a spoon until mashed. Set filling aside."
    },
    {
      "position": 3,
      "text": "Lightly flour a work surface and a large plate."
    },
    {
      "position": 4,
      "text": "Divide dough in half. Working with one piece at a time, roll dough on the floured surface into a rectangle as thin as possible. Cut into 2-inch squares using a knife or pastry wheel."
    },
    {
      "position": 5,
      "text": "Place about 2 teaspoons filling in the center of each square. Gather the edges of dough and pinch them together at the top to form a bundle. Transfer manti to the prepared plate; sprinkle more flour on top to prevent sticking."
    },
    {
      "position": 6,
      "text": "Make oil: Heat oil and red pepper flakes in a small skillet over low heat just until pepper flakes begin to color oil. Remove from heat and keep warm."
    },
    {
      "position": 7,
      "text": "Make sauce: Stir together yogurt and garlic in a small bowl; set aside."
    },
    {
      "position": 8,
      "text": "Bring a large pot of salted water to a boil over medium-high heat. Cook manti in boiling water until filling is no longer pink and dough is tender, 20 to 25 minutes. Drain well."
    },
    {
      "position": 9,
      "text": "Divide manti onto 4 plates. Spoon yogurt sauce over manti and drizzle with pepper oil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

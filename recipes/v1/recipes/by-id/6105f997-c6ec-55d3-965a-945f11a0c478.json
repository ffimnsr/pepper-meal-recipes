{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6105f997-c6ec-55d3-965a-945f11a0c478",
  "slug": "baked-chicken-and-sausage-gumbo",
  "name": "Baked Chicken and Sausage Gumbo",
  "recipe_type": "soup",
  "brief_description": "Chef John takes gumbo to the oven, baking up a beautiful golden brown roux right alongside the chicken, sausage, and Holy Trinity in this dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir flour, oil, and melted butter together to form a paste. Transfer roux to the center of a large roasting pan and spread out into a rough rectangle about 1/2-inch thick, leaving enough room around the outside to place chicken and sausage."
    },
    {
      "position": 3,
      "text": "Lay chicken thighs, skin-side down, and sausage pieces around roux in the pan. Season chicken generously with salt."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 40 minutes. Remove from the oven and scatter onion, celery, and bell pepper evenly over chicken, sausage, and roux. Briefly stir roux in the center, then spread it back out. Continue baking for 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven. Transfer chicken and sausage to a plate and reserve until needed. Stir vegetables and roux together in the pan, spread back out into an even layer, and bake until roux is as browned as you like, about 20 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, make the cooking liquid: Mix chicken broth, salt, pepper, thyme, cayenne, and bay leaf in a large bowl or pitcher. Refrigerate until needed."
    },
    {
      "position": 7,
      "text": "When the vegetables and roux are finished baking, pour cooking liquid into the pan and whisk until well combined. Stir in tomatoes and okra, then add sausage and chicken, skin-side up. Continue baking, stirring gently and occasionally, until liquid is thick and chicken is very tender, 30 to 40 minutes more."
    },
    {
      "position": 8,
      "text": "Taste and adjust seasonings as desired. Garnish with green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "expert",

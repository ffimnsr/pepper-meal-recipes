  "id": "ff067e2d-211a-50a9-8491-dd425f48cd73",
  "slug": "grilled-bacon-jalapeno-wraps",
  "name": "Grilled Bacon Jalape\u00f1o Wraps",
  "recipe_type": "appetizer",
  "brief_description": "Grilled jalape\u00f1o poppers stuffed with cream cheese and wrapped with crispy bacon make a popular party snack. You might want to double the recipe!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Spread cream cheese in each jalape\u00f1o half; wrap with bacon. Secure with a toothpick if needed."
    },
    {
      "position": 3,
      "text": "Cook on the preheated grill until bacon is crispy, turning often, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

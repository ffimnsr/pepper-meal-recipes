  "id": "66dbe502-65ae-5936-b67a-347961de6a43",
  "slug": "peach-cobbler-v",
  "name": "Peach Cobbler V",
  "recipe_type": "dessert",
  "brief_description": "With this versatile recipe, you can whip a wonderful peach cobbler up with fresh, frozen or canned peaches. And the same basic recipe works beautifully for other berries and fruit. The only thing you have to remember is that when you spoon the biscuit batter and the peaches into the baking pan, don 't stir.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place butter or margarine in a 9x13 inch pan and melt in oven while it is preheating."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together flour, sugar, and baking powder. Stir in milk."
    },
    {
      "position": 3,
      "text": "Remove pan of melted butter or margarine from oven. Pour mixture into pan, but DO NOT STIR. Spread pie filling onto batter, without stirring."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 50 to 60 minutes, until fruit is bubbly and batter is set and golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

  "id": "4ab240a8-f2ea-5f9e-b3df-cb18a478328f",
  "slug": "ground-beef-enchiladas",
  "name": "Ground Beef Enchiladas",
  "recipe_type": "soup",
  "brief_description": "These are beef filled tortilla shells baked in a creamy chicken soup and cheese sauce. My husband absolutely loves these. I served them to guests once with Mexican rice, and they went home with the recipe! Enjoy!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large skillet over medium heat, cook the ground beef, green onion, and jalapeno pepper until the beef is evenly brown. Stir in water and taco seasoning. Simmer until water has evaporated."
    },
    {
      "position": 3,
      "text": "In a medium bowl, mix together yogurt, condensed soup, and cheese."
    },
    {
      "position": 4,
      "text": "Divide the meat mixture evenly between tortillas. Place a couple of tablespoons of cheese mixture over meat, and roll up. Place in a 7x11 inch baking dish. Repeat for each tortilla. Spoon remaining cheese mixture over the top of the tortillas."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for 20 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "f245dee8-9cc9-5cba-bdc3-6a22e204882d",
  "slug": "blueberry-cornmeal-upside-down-cake",
  "name": "Blueberry Cornmeal Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This blueberry cornmeal upside-down cake features a sweet, buttery cake with sour cream, and a fresh blueberry topping that is baked to perfection in a cast iron pan.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix all-purpose flour, cornmeal, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Cream together butter and sugar with an electric mixer until smooth. Beat in eggs one at a time, scraping down the bowl after each addition. Add sour cream and vanilla; combine until smooth. Add flour mixture and mix until incorporated. Set aside."
    },
    {
      "position": 4,
      "text": "Divide butter between two 9-inch cast iron pans; melt over medium-low heat, about 1 minute. Add 1/2 of the brown sugar to each pan; cook until butter and sugar begin to bubble, 2 to 3 minutes. Divide blueberries between the two pans and remove from stove top."
    },
    {
      "position": 5,
      "text": "Divide cornmeal batter between the pans; place each on a sheet pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the middle comes out clean, 45 to 50 minutes."
    },
    {
      "position": 7,
      "text": "Let cool slightly, about 15 minutes. Run a knife around the outer edges of each cake and invert onto a cutting board for slicing."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

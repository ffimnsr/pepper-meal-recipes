  "id": "e6d35a72-5881-5a80-8de1-1e92f3165c4e",
  "slug": "cranberry-pecan-scones",
  "name": "Cranberry Pecan Scones",
  "recipe_type": "breakfast",
  "brief_description": "Based on traditional Scottish biscuits, these scones are packed with cranberries and crunchy pecans. You may add food coloring to the glaze, if desired.",
  "cuisine": "U.S. British Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine 3/4 cup milk and vinegar in a bowl and let stand until milk curdles, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine flour, sugar, baking powder, baking soda, salt, and nutmeg in a large bowl. Cut butter in with a pastry blender. Smooth any butter clumps with fingers. Stir in milk mixture, cranberries, and pecans. Knead until dough just comes together."
    },
    {
      "position": 4,
      "text": "Place dough onto a floured work surface. Roll dough into a square, about 3/4 inches thick. Cut into long strips, about 2 inches wide. Cut strips into triangles. Transfer to the baking sheet. Brush tops with egg white."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops are golden brown, about 15 minutes. Let scones cool to room temperature before glazing."
    },
    {
      "position": 6,
      "text": "Combine confectioners' sugar and 2 tablespoons milk in a small bowl. Mix until combined. If glaze is too thick, add more milk 1 teaspoon at a time. Drizzle glaze over scones."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

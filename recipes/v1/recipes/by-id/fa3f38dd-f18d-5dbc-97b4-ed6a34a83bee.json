  "id": "fa3f38dd-f18d-5dbc-97b4-ed6a34a83bee",
  "slug": "chocolate-cupcakes",
  "name": "Easy Moist Chocolate Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "This chocolate cupcake recipe makes moist, rich, chocolaty cupcakes from scratch with simple baking ingredients. Frost with chocolate buttercream for the perfect party treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin pan with paper or foil liners."
    },
    {
      "position": 2,
      "text": "Spoon flour into a measuring cup and level off with a knife. Sift flour, cocoa, baking powder, baking soda, and salt into a large bowl."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter together in a separate large bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 4,
      "text": "Add eggs, one at a time, beating well after each addition. Stir in the vanilla. Add flour mixture in two batches, alternating with milk; mix only until no streaks of flour remain."
    },
    {
      "position": 5,
      "text": "Spoon batter into the prepared muffin cups, filling each 1/2 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 15 to 17 minutes. Remove from the oven and let cool in the pan for a few minutes before transferring to a wire rack to cool completely before serving or frosting."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

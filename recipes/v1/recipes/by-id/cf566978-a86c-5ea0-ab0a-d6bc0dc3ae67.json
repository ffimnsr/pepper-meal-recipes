  "id": "cf566978-a86c-5ea0-ab0a-d6bc0dc3ae67",
  "slug": "chicken-with-chanterelle-mushrooms-and-marsala-wine",
  "name": "Chicken with Chanterelle Mushrooms and Marsala Wine",
  "recipe_type": "main",
  "brief_description": "This chanterelle chicken and mushroom recipe is perfect for a special dinner at home, any night of the week. Serve with potatoes or over noodles.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour and paprika together into a shallow dish. Remove and set aside 1 tablespoon of flour mixture for later use. Dredge chicken in remaining flour mixture to coat evenly."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a skillet over medium heat; cook and stir chanterelle mushrooms in melted butter until they release their liquid and begin to brown, about 5 minutes. Transfer to a bowl and set aside."
    },
    {
      "position": 3,
      "text": "Melt remaining 4 tablespoons butter in the skillet. Cook chicken breasts in the melted butter until browned, about 3 minutes per side. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Return cooked mushrooms to the skillet and stir in chicken broth, reserved 1 tablespoon of flour mixture, Marsala wine, and dried tarragon. Cover the skillet, reduce the heat to low, and cook until sauce is thick, about 20 minutes. The chicken should no longer be pink in the center and the juices should run clear. An instant-read thermometer inserted into the center of a chicken breast should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

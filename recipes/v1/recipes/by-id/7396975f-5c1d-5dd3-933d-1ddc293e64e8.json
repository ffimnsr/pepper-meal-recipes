  "id": "7396975f-5c1d-5dd3-933d-1ddc293e64e8",
  "slug": "old-time-kentucky-bacon-milk-gravy-for-biscuits",
  "name": "Old-Time Kentucky Bacon Milk Gravy for Biscuits",
  "recipe_type": "side",
  "brief_description": "Milk gravy made with bacon grease is an old-time Kentucky favorite. Serve it over biscuits alongside bacon and eggs for a hearty start to your day.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat bacon drippings in a skillet over medium heat; whisk flour into drippings until smooth. Reduce the heat to low and cook, stirring constantly so it doesn't burn, until roux is caramel brown in color, about 15 minutes. Stir in salt and black pepper."
    },
    {
      "position": 2,
      "text": "Add milk, 1/2 cup at a time, whisking until thoroughly blended after each addition. Bring gravy to a simmer, then whisk constantly until thick, smooth, and bubbling."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,

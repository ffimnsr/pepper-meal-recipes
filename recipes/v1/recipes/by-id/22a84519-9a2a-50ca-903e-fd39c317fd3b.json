  "id": "22a84519-9a2a-50ca-903e-fd39c317fd3b",
  "slug": "loaded-sweet-pepper-nachos-recipe-12026392",
  "name": "Loaded Sweet Pepper Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These loaded sweet pepper nachos pile sweet pepper halves high with seasoned taco beef, beans, and cheese before they\u2019re baked until hot and melty. Topped with a creamy lime yogurt sauce, jalape\u00f1os, and fresh fixings, they\u2019re a colorful, flavorful nacho experience you won\u2019t miss the tortilla chips in.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium high heat. Add ground beef and cook until browned and crumbled, about 5 minutes. Add taco seasoning and water and continue cooking on low heat until the beef has become saucy, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Place sweet peppers, cut side up, on the prepared baking sheet. Spoon meat mixture and black beans on top. Sprinkle cheese over meat and beans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the cheese is melted and bubbly, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, stir together yogurt, lime juice. and salt together in a bowl. Set aside."
    },
    {
      "position": 6,
      "text": "Top nachos with salsa, yogurt sauce, fresh cilantro, avocado and jalapenos."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

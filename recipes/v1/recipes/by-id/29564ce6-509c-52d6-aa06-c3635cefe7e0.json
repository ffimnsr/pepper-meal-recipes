  "id": "29564ce6-509c-52d6-aa06-c3635cefe7e0",
  "slug": "microwave-divinity",
  "name": "Microwave Divinity",
  "recipe_type": "dessert",
  "brief_description": "Traditional divinity candy is a quick and easy dessert to prepare when cooked in the microwave, and this version comes out perfectly every time.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix sugar, corn syrup, and water together in a microwave-safe bowl."
    },
    {
      "position": 2,
      "text": "Cook sugar mixture in the microwave until mixture is 250 degrees F (120 degrees C), or until a small amount of sugar mixture dropped into cold water forms a rigid ball, 3 minutes."
    },
    {
      "position": 3,
      "text": "Beat egg whites in a glass or metal bowl until stiff peaks form. Lift your beater or whisk straight up: the egg whites will form sharp peaks."
    },
    {
      "position": 4,
      "text": "Stir sugar mixture into egg whites until no longer glossy, about 7 minutes. Stir in vanilla extract."
    },
    {
      "position": 5,
      "text": "Drop candy by teaspoonfuls onto a sheet of waxed paper. Let stand until cooled, 15 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

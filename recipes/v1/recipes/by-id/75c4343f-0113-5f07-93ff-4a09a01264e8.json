  "slug": "frozen-vegetable-stir-fry",
  "name": "Frozen Vegetable Stir-Fry",
  "recipe_type": "side",
  "brief_description": "This quick stir fry with frozen veggies has a tasty Thai-style flavor thanks to the addition of soy sauce, peanut butter, and brown sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, brown sugar, peanut butter, and garlic powder in a small bowl."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add frozen mixed vegetables; cook and stir until just tender, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and fold in soy sauce mixture."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,

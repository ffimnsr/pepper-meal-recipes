  "id": "217a4546-5404-56db-9f5c-d1e81d50c9b8",
  "slug": "zucchini-oatmeal-waffles",
  "name": "Zucchini Oatmeal Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Adding shredded squash to this easy zucchini bread waffle recipe, made with oatmeal and whole wheat flour, is a great way to up your vegetable intake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Whisk milk, zucchini, eggs, and melted butter together in a large bowl until well combined. Combine flour, oats, brown sugar, baking powder, salt, and cinnamon in a separate bowl until well mixed; gradually stir into zucchini mixture until blended."
    },
    {
      "position": 3,
      "text": "Drop batter onto the preheated waffle iron, in batches, and cook until golden and crisp, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "2ab5b51b-2403-500b-8c5e-e02729460dc0",
  "slug": "chocolate-y-iced-mocha",
  "name": "Chocolate-y Iced Mocha",
  "recipe_type": "dessert",
  "brief_description": "Use coffee, almond milk, cocoa mix, and chocolate syrup to make your own iced mocha at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1/4 cup coffee in microwave in a mug until warmed, about 30 seconds. Stir cocoa mix into the coffee until dissolved."
    },
    {
      "position": 2,
      "text": "Fill a large glass with ice cubes. Pour 1 cup cold coffee and almond milk over the ice cubes; stir the cocoa mixture and chocolate syrup into the coffee and almond milk."
    }
  ],

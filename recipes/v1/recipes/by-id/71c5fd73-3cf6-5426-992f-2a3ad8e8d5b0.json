  "slug": "lemony-dill-bulgur-pilaf-recipe-8691944",
  "name": "Lemony-Dill Bulgur Pilaf",
  "recipe_type": "side",
  "brief_description": "Make this whole-grain lemony-dill bulgur pilaf for a nutrient-dense and flavorful side dish. Carbohydrates tend to get a bad rap, but they\u2019re vital to fuel our bodies, protect our hearts, and boost gut health.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a medium saucepan over medium heat. Add bulgur; cook, stirring occasionally, until toasted, about 4 minutes. Stir in broth, garlic, salt, and pepper. Bring to a boil over high heat. Reduce heat to low. Simmer, covered, until grain is tender."
    },
    {
      "position": 2,
      "text": "Remove from heat and let stand 10 minutes; drain any excess liquid. Stir in dill, lemon zest, and lemon juice. Spoon tzatziki over servings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

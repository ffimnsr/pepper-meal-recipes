  "id": "eb370a43-a630-564e-a257-9e2e7ee7b013",
  "slug": "hoppin-juan",
  "name": "Hoppin' John",
  "recipe_type": "main",
  "brief_description": "Hoppin' John made with black-eyed peas, bacon, and rice gets a kick from jalape\u00f1os and habanero chilies for a spicy twist on the New Year's classic.",
  "cuisine": "Southwestern Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pan over medium heat; cook and stir onion, red bell pepper, jalape\u00f1o peppers, and garlic in hot butter until onion is translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir cooked rice, black-eyed peas, diced tomatoes with habanero peppers, bacon, salt, and black pepper into vegetables. Cook for 10 minutes to blend flavors, stirring frequently."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,

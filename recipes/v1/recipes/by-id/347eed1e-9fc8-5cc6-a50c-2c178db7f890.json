  "id": "347eed1e-9fc8-5cc6-a50c-2c178db7f890",
  "slug": "hunts-easy-tomato-bruschetta",
  "name": "Hunt\u2019s\u00ae Easy Tomato Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Classic bruschetta made with simple ingredients of petite diced tomatoes, basil, and garlic.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F."
    },
    {
      "position": 2,
      "text": "Place bread slices on a baking sheet. Brush tops with 2 tablespoons olive oil. Bake 12 to 15 minutes or until lightly toasted."
    },
    {
      "position": 3,
      "text": "Combine remaining 2 tablespoons olive oil, drained tomatoes, basil, garlic, salt, and pepper in a small bowl."
    },
    {
      "position": 4,
      "text": "Divide tomato mixture evenly over toasted bread. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "9b476286-45ec-5998-ad8e-38a518afc065",
  "slug": "carrot-coffee-cake-recipe-11724352",
  "name": "Carrot Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This carrot coffee cake is a classic streusel coffee cake with a carrot cake profile. Nicely spiced and moist, with finely shredded carrots, walnuts, and a cream cheese glaze, it's just right for a spring brunch buffet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Line a 9x13-inch baking pan with foil. Coat foil with cooking spray."
    },
    {
      "position": 2,
      "text": "For batter, whisk together flour, baking powder, cinnamon, salt, and nutmeg in a medium bowl."
    },
    {
      "position": 3,
      "text": "Beat softened butter in a large bowl with an electric mixer until light and fluffy. Gradually beat in sour cream, then white sugar, and brown sugar. Beat in eggs, 1 at a time."
    },
    {
      "position": 4,
      "text": "Stir in carrots and vanilla. Fold in flour mixture with a rubber spatula until just combined."
    },
    {
      "position": 5,
      "text": "Spread batter in prepared pan. The batter will be shallow, but will increase in volume as it bakes."
    },
    {
      "position": 6,
      "text": "For streusel, combine walnuts, brown sugar, cinnamon, and salt in a small bowl. Stir in melted butter until crumbly. Sprinkle streusel over cake batter."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 35 to 40 minutes. Let cool in pan for 10 minutes; lift from the pan with the edges of the foil."
    },
    {
      "position": 8,
      "text": "For glaze, beat together cream cheese and butter in a small bowl until smooth. Beat in 1/4 teaspoon vanilla, then powdered sugar. Beat in enough milk to make drizzling consistency."
    },
    {
      "position": 9,
      "text": "Serve coffee cake warm or at room temperature. Drizzle glaze over warm or cooled cake, or over each serving."
    }
  ],

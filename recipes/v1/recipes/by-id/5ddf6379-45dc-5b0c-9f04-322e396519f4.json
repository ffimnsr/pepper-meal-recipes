{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5ddf6379-45dc-5b0c-9f04-322e396519f4",
  "slug": "sour-cream-and-chive-skillet-dinner-rolls-recipe-11715730",
  "name": "Sour Cream and Chive Skillet Dinner Rolls",
  "recipe_type": "side",
  "brief_description": "These sour cream and chive skillet dinner rolls are pillowy-soft yeast rolls that get a flavor and texture boost from the addition of sour cream and chives. They can be made with a stand mixer or by hand.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together warm milk, pinch of sugar, and yeast in a small bowl. Allow to sit in a warm place until yeast begins to foam, about 5 minutes."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together 2 cups flour, 1/4 cup sugar, chives, salt, onion powder, and black pepper until combined. Add in yeast mixture, sour cream, olive oil, and eggs and mix until combined. Gradually mix in another 1 to 1 1/2 cups flour until mixture begins to pull away from the sides of the bowl. Turn dough out onto a lightly floured surface and knead until mixture is smooth and elastic, 10 to 15 minutes, adding more flour as needed to keep dough from sticking. Cover dough, and allow it to rest for 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, grease a 10-inch cast iron skillet with olive oil."
    },
    {
      "position": 4,
      "text": "After the dough has rested, divide it evenly into 14 pieces. Roll each piece into a ball and place into the skillet. Place 10 rolls around the outside of the pan, and 4 in the middle; they will be a bit snug. Cover rolls loosely with a greased piece of plastic wrap and allow to rise in a warm, draft-free place until doubled, 1 to 2 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Remove plastic wrap from rolls."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until rolls are golden brown on top and sound hollow when tapped, 25 to 30 minutes. If desired, brush the tops of the warm rolls with extra olive oil or butter and sprinkle with a few extra chives. Allow rolls to cool slightly before serving."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 40,
  "rest_time_minutes": 10,

  "schema_version": 1,
  "id": "27312f72-c9ec-51df-a7d1-1721b7ce7e3d",
  "slug": "the-works-tater-tot-breakfast-pizza-recipe-11946157",
  "name": "'The Works' Tater Tot Breakfast Pizza",
  "recipe_type": "breakfast",
  "brief_description": "This tater tot breakfast pizza is loaded with \"the works\"\u2014scrambled eggs, cheese, vegetables, sausage, bacon, and ham on a crispy tater tot crust. Hearty and customizable, it\u2019s the perfect dish for feeding the whole family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray a 12-inch oven-safe skillet with cooking spray, and add tater tot rounds, making sure to cover the bottom and come up the sides."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat half the butter in a nonstick skillet over medium heat. When the butter is sizzling, add bell pepper, onions, and mushrooms. Cook and stir frequently, until onions just begin to turn translucent, 2 to 3 minutes. Add spinach and cook until just wilted, 1 to 2 minutes. Remove vegetables from the pan."
    },
    {
      "position": 5,
      "text": "Add remaining butter to the same skillet over medium heat. When butter sizzles, add beaten eggs and cook until just set. They will cook more in the oven."
    },
    {
      "position": 6,
      "text": "Remove tater tots from the oven. Use a spatula or smaller pan to press down on tater tots to form an even layer, and to smash the tots together."
    },
    {
      "position": 7,
      "text": "Sprinkle 1 cup Cheddar cheese over tots, then layer in eggs; spread them evenly to edges of the skillet. Sprinkle with cooked vegetables, then add sausage. Sprinkle with ham, remaining 1 cup cheese, and finally add bacon."
    },
    {
      "position": 8,
      "text": "Return to the oven and bake until cheese is melted and pizza is heated through, about 10 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

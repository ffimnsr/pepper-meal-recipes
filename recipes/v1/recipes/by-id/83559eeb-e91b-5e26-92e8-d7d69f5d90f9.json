  "id": "83559eeb-e91b-5e26-92e8-d7d69f5d90f9",
  "slug": "passover-rolls-i",
  "name": "Passover Rolls",
  "recipe_type": "main",
  "brief_description": "These freshly baked Passover rolls are made with matzo meal and eggs for a fluffy alternative to matzos. Sure to be a big hit at any Seder!",
  "cuisine": "World American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a cookie sheet."
    },
    {
      "position": 2,
      "text": "Combine matzo meal, salt, and sugar in a large mixing bowl; mix well."
    },
    {
      "position": 3,
      "text": "Bring water and oil to a boil; pour boiling water over matzo meal mixture, and stir until blended. Beat one egg at a time into the mixture. Let stand 15 minutes."
    },
    {
      "position": 4,
      "text": "Shape dough into rolls with oiled hands. Arrange rolls on the prepared cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cooked through, 50 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

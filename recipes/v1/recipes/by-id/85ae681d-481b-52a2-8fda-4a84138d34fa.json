  "id": "85ae681d-481b-52a2-8fda-4a84138d34fa",
  "slug": "shoepeg-corn-salad",
  "name": "Shoepeg Corn Salad",
  "recipe_type": "salad",
  "brief_description": "Jalapeno peppers lend a little heat to the homemade dressing for this creamy salad with shoepeg corn and tomatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, green onions, vinegar, jalapeno peppers, parsley, and olive oil together in a bowl until smooth; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Gently stir corn and tomatoes into the dressing to coat. Transfer salad to a serving dish, cover with plastic wrap, and refrigerate at least 2 hours."
    }
  ],
  "servings": 8,

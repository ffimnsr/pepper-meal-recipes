  "id": "07759eed-38f9-59e5-9caa-b4d3236533f3",
  "slug": "pinto-bean-soup-recipe-11852830",
  "name": "Pinto Bean Soup",
  "recipe_type": "soup",
  "brief_description": "This pinto bean soup, a simple, hearty, stick-to-your-ribs Mexican-inspired soup comes together quickly. Serve with your favorite toppings, such as shredded Cheddar cheese, chopped cilantro, chopped green onions, sour cream, guacamole, and salsa.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large stockpot over medium-high heat. Add onion and jalapeno. Cook 2 minutes. Add garlic and cook 1 minute more."
    },
    {
      "position": 2,
      "text": "Add potato, carrots, coriander, paprika, cumin, chicken broth, pinto beans, and tomatoes to the pot."
    },
    {
      "position": 3,
      "text": "Bring to a boil. Reduce heat to a simmer, cover, and cook for 30 minutes."
    },
    {
      "position": 4,
      "text": "Ladle into bowls, season with salt and pepper, and add toppings of choice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "50ce4a84-2a82-5d3a-8fed-19aa15c6d240",
  "slug": "strawberry-rhubarb-pie-iii",
  "name": "Spring Strawberry Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "Orange zest and tapioca are stirred into the strawberry-rhubarb filling, making this pie luscious. Choose between a crumb or pastry crust topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (205 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a 9-inch pie plate with 1 pastry crust. Set aside."
    },
    {
      "position": 3,
      "text": "Mix together rhubarb, strawberries, 1 \u00bd cups sugar, tapioca, and orange zest until well combined; spoon into crust."
    },
    {
      "position": 4,
      "text": "Roll out remaining pastry on a lightly floured surface and place over rhubarb mixture. Seal the edges, brush the top crust with milk, then sprinkle with 1 tablespoon sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Reduce the heat to 350 degrees F (175 degrees C) and bake for 35 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

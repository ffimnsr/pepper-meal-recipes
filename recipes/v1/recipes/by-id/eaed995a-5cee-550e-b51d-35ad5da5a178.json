  "id": "eaed995a-5cee-550e-b51d-35ad5da5a178",
  "slug": "easy-lima-beans",
  "name": "Easy Lima Beans",
  "recipe_type": "soup",
  "brief_description": "This easy lima bean recipe transforms a 16-ounce package of frozen baby lima beans into a tasty, low-fat side dish with onion and chicken broth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a large saucepan with cooking spray and heat over medium heat. Add onion to the hot pan and saut\u00e9 until translucent, about 5 minutes. Pour in chicken broth and bring to a boil."
    },
    {
      "position": 2,
      "text": "Add lima beans and enough water just to cover. Return to a boil, then reduce the heat to low, cover, and simmer until beans are tender, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,

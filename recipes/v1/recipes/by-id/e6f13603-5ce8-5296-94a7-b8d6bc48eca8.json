  "id": "e6f13603-5ce8-5296-94a7-b8d6bc48eca8",
  "slug": "eggless-pasta",
  "name": "Eggless Pasta",
  "recipe_type": null,
  "brief_description": "This eggless pasta recipe is easy to make at home with just three ingredients. It's sure to be a favorite for anyone on a low-cholesterol or vegan diet.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour and salt together in a large bowl. Add warm water and stir to make a stiff dough; add more water if dough seems too dry."
    },
    {
      "position": 2,
      "text": "Pat dough into a ball and turn out onto a lightly floured surface. Knead for 10 to 15 minutes. Cover and let rest for 20 minutes."
    },
    {
      "position": 3,
      "text": "Working with 1/4 of the dough at a time and keeping the rest covered to prevent it from drying out, roll dough by hand to a thickness of 1/16 inch. If using a pasta machine, stop at the third to the last setting. Cut pasta into desired shapes."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in the boiling water until tender yet firm to the bite, 3 to 5 minutes. Drain."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

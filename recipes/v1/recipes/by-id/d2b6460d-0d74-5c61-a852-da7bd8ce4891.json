  "id": "d2b6460d-0d74-5c61-a852-da7bd8ce4891",
  "slug": "ground-turkey-lettuce-wraps",
  "name": "Ground Turkey Lettuce Wraps",
  "recipe_type": "appetizer",
  "brief_description": "A saucy Asian-inspired ground turkey mixture is gathered up in lettuce leaves to make these easy wraps.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a pan over medium-high heat. Add onion and soy sauce; cook until tender, about 5 minutes. Stir in garlic; cook until fragrant, about 1 minute. Add turkey and cook, breaking into smaller pieces, until no longer pink, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Make the sauce by whisking soy sauce, rice vinegar, brown sugar, sesame oil, red pepper flakes, and ginger together in a small bowl. Pour over turkey mixture and simmer until slightly reduced, 2 to 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

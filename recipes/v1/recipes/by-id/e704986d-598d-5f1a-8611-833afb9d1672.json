  "id": "e704986d-598d-5f1a-8611-833afb9d1672",
  "slug": "apple-slice-squares",
  "name": "Apple Slice Squares",
  "recipe_type": "dessert",
  "brief_description": "This apple slice squares recipe has all the fixings of apple pie, complete with a homemade crust, for a delicious dessert the whole family will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk 2 cups flour and salt together in a bowl; cut in butter using a pastry blender or a fork until crumbly. Whisk eggs, water, and lemon juice together in a separate bowl until combined; stir into flour mixture until dough forms a ball."
    },
    {
      "position": 3,
      "text": "Split dough ball in half; roll each half on a lightly floured work surface into about a 9x13-inch rectangle. Press 1 rectangle into a 9x13-inch baking dish to form bottom crust; set remaining dough rectangle aside."
    },
    {
      "position": 4,
      "text": "Toss apple slices, sugar, 3 tablespoons flour, and cinnamon together in a bowl until apples are evenly coated; spread over crust."
    },
    {
      "position": 5,
      "text": "Cover apple filling with remaining dough rectangle to form top crust, piecing together scraps to cover any holes. Cut several ventilation slits into top crust for steam to escape while baking."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are browned and crisp, 45 to 60 minutes. Cool to room temperature before slicing into squares, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "45fb5196-4bee-5acd-b261-7fff02be03f3",
  "slug": "spooky-witches-fingers",
  "name": "Spooky Witches' Fingers",
  "recipe_type": "dessert",
  "brief_description": "This spooky witches' fingers recipe uses a homemade cookie dough decorated with red jam and almonds for bloody fingernails for a tasty Halloween treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter, confectioners' sugar, egg, almond extract, and vanilla extract together in a large bowl with an electric mixer until smooth. Gradually beat in flour, baking powder, and salt until combined. Wrap dough in plastic wrap. Refrigerate for 20 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease baking sheets."
    },
    {
      "position": 3,
      "text": "Scoop 1 heaping teaspoon of dough at a time onto a piece of waxed paper; keep remaining dough in the refrigerator. Roll dough into a thin finger-shaped cookie using the waxed paper. Press 1 almond into one end of cookie to give the appearance of a long fingernail. Squeeze cookie near the tip and near the center to give the impression of knuckles. You can also cut into dough with a sharp knife at the same points to give a more finger-like appearance. Repeat with remaining dough. Arrange shaped cookies on the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are slightly golden in color, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Remove almonds from ends of each cookie; squeeze a small amount of red decorating gel into cavities. Replace almond to cause jam to ooze out around tips of cookies."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 20,

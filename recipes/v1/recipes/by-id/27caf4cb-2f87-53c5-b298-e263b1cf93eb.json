  "id": "27caf4cb-2f87-53c5-b298-e263b1cf93eb",
  "slug": "lady-lunch-brownies-recipe-11978229",
  "name": "Lunch Lady Brownies",
  "recipe_type": "dessert",
  "brief_description": "These lunch lady brownies are rich, fudgy, and topped with a thick layer of creamy chocolate frosting for the ultimate nostalgic dessert. Just like the classic cafeteria treat, they\u2019re soft, chewy, and perfect for feeding a crowd or satisfying your chocolate craving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9 x 13 rimmed baking sheet or pan with parchment paper and lightly grease with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together butter and cocoa powder in a large bowl until well combined. Add sugar and salt and mix well. Stir in flour. Mix in eggs and vanilla until well blended."
    },
    {
      "position": 3,
      "text": "Pour mixture into prepared baking sheet and bake until just done, 18 to 21 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile whisk together butter, cocoa powder, vanilla, and milk in a bowl. Gradually add in powdered sugar and whisk until thick and creamy."
    },
    {
      "position": 5,
      "text": "Let brownies cool for 10 minutes and spread frosting over brownies while they are still warm. Let cool completely before cutting into squares and serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,

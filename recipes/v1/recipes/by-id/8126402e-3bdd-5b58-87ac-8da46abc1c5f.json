  "id": "8126402e-3bdd-5b58-87ac-8da46abc1c5f",
  "slug": "brownie-dip-recipe-12026981",
  "name": "Brownie Dip",
  "recipe_type": "appetizer",
  "brief_description": "This brownie dip is an easy no-bake dessert that delivers all the rich, fudgy flavor of brownies in a cool, creamy dip. Serve it chilled with strawberries, cookies, graham cracker sticks, or salty pretzels for an unexpected treat everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spread brownie mix onto a rimmed baking sheet in an even layer."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven for 10 minutes, stirring halfway through. Let cool, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Whip cream cheese in a mixing bowl. Gradually add brownie mix until it is all incorporated and smooth (mixture will be thick). Fold in whipped topping. Add milk as needed to achieve a smoother, more dippable consistency."
    },
    {
      "position": 4,
      "text": "Transfer mixture to a serving bowl and top with chocolate chips. Serve with desired accompaniments."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

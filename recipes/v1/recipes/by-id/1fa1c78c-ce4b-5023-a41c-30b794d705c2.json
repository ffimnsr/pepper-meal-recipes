  "id": "1fa1c78c-ce4b-5023-a41c-30b794d705c2",
  "slug": "enchilada-casserole",
  "name": "Vegetarian Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This vegetarian enchilada casserole has layers of tortillas with enchilada sauce loaded with black beans, spicy peppers, tempeh, and lots of cheese.",
  "cuisine": "Mexican Inspired Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees (175 degrees C). Lightly oil a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine beans, garlic, onion, chile peppers, jalape\u00f1o pepper, and tempeh in a medium bowl. Pour enchilada sauce into a shallow bowl."
    },
    {
      "position": 3,
      "text": "Dip three tortillas in enchilada sauce, and place them in the prepared baking dish. Be sure to cover bottom of the dish as completely as possible. Place 1/2 of the bean mixture on top of the tortillas, and repeat. Drizzle remaining sauce over the casserole, and sprinkle with olives and shredded cheese."
    },
    {
      "position": 4,
      "text": "Cover, and bake for 30 minutes. Uncover, and continue baking for an additional 15 minutes, or until the casserole is bubbling and the cheese is melted."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

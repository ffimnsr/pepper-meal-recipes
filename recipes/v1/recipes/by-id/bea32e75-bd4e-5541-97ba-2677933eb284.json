  "id": "bea32e75-bd4e-5541-97ba-2677933eb284",
  "slug": "tia-and-davids-deep-fried-tortellini",
  "name": "Tia and David's Deep-Fried Tortellini",
  "recipe_type": "appetizer",
  "brief_description": "Real party pleasers, these fried tortellini are shaken up with bread and cornflake crumbs, then deep-fried to a golden brown. Dip in tomato sauce.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Cook tortellini according to package directions. Rinse under cool water and allow to cool slightly."
    },
    {
      "position": 2,
      "text": "Combine bread crumbs, cornflake crumbs, salt, pepper, and parsley in a large resealable plastic bag."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep fryer or deep skillet over medium heat."
    },
    {
      "position": 4,
      "text": "Dip tortellini in egg and place in resealable bag in small batches. Shake to coat and set aside on a plate until the oil is hot."
    },
    {
      "position": 5,
      "text": "Deep-fry breaded tortellini in batches until golden brown."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

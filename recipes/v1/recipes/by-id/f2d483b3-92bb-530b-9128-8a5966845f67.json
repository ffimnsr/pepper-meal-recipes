  "id": "f2d483b3-92bb-530b-9128-8a5966845f67",
  "slug": "easy-chicken-piccata",
  "name": "Easy Chicken Piccata",
  "recipe_type": "main",
  "brief_description": "This chicken piccata recipe cooks chicken breasts in a buttery white wine sauce with capers and lots of lemon flavor for a family favorite dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Slice chicken breasts horizontally to yield 4 pieces. Place breasts between 2 sheets of plastic wrap and pound to 1/4-inch thin. Place flour on a plate and dredge each breast on both sides in flour."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Put chicken into the skillet and season tops with salt and pepper. Turn when nicely browned, about 4 minutes, and season again. Cook second side until browned, about 4 minutes. Transfer breasts to a plate, reserving skillet drippings."
    },
    {
      "position": 3,
      "text": "Add wine and lemon juice to the skillet, stirring to scrape up any browned bits. Simmer to reduce and thicken sauce, about 5 minutes more. Add capers and pour sauce over chicken breasts on the plate. Sprinkle with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

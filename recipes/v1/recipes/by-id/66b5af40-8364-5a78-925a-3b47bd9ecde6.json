  "id": "66b5af40-8364-5a78-925a-3b47bd9ecde6",
  "slug": "japanese-sweet-omelet",
  "name": "Japanese Sweet Omelet",
  "recipe_type": "dessert",
  "brief_description": "A quick and easy breakfast recipe, the tamagoyaki is a tasty Japanese sweet omelet made by adding sugar to eggs and folding into a square.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Mix eggs, water, soy sauce, and sugar in a bowl with a fork until combined."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium heat. Pour egg mixture into skillet and stir with a fork. Cook until omelet begins to set and liquid is no longer visible, 3 to 5 minutes. Fold in half twice."
    }
  ],

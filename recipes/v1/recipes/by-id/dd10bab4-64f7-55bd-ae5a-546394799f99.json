  "id": "dd10bab4-64f7-55bd-ae5a-546394799f99",
  "slug": "thai-curry-tofu",
  "name": "Thai Curry Tofu",
  "recipe_type": null,
  "brief_description": "Tofu is fried, then simmered in a curry coconut sauce with cilantro. A delicious light meal that goes great with rice or noodles.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add tofu cubes, season with seasoned salt and fry until golden on all sides, stirring occasionally, about 15 minutes. Remove to paper towels, and set aside."
    },
    {
      "position": 2,
      "text": "Melt butter or margarine in the same skillet over medium heat. Add the onion and garlic; cook and stir until tender. Stir in coconut milk, curry powder, salt, pepper and cilantro. Return the tofu to the skillet. Simmer over low heat for 15 minutes, stirring occasionally."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

  "id": "dc3a3d77-1fe0-56b6-98f9-19f32ffabc71",
  "slug": "paella-i",
  "name": "Spanish Paella",
  "recipe_type": "main",
  "brief_description": "A traditional Spanish paella recipe made with Spanish chorizo, chicken, squid, mussels, and shrimp cooked with saffron rice in a paella pan.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in paella pan over medium heat. Add onion, garlic, and pepper; cook and stir for a few minutes. Add chorizo sausage, diced chicken, and rice; cook for 2 to 3 minutes. Stir in 3 \u00bd cups stock, wine, thyme leaves, and saffron. Season with salt and pepper. Bring to the boil, and simmer for 15 minutes; stir occasionally."
    },
    {
      "position": 2,
      "text": "Taste the rice, and check to see if it is cooked. If the rice is uncooked, stir in \u00bd cup more stock. Continue cooking, stirring occasionally. Stir in additional stock if necessary: use up to 2 cups additional stock, 5 cups total. Cook until rice is done."
    },
    {
      "position": 3,
      "text": "Stir in squid, tomatoes, and peas. Cook for 2 minutes. Arrange prawns and mussels on top. Cover with foil, and leave for 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Remove the foil, and scatter parsley over the food. Serve in paella pan, garnished with lemon wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

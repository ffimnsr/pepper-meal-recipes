  "id": "4ce566f6-13b0-5241-b835-400456b71d88",
  "slug": "peanut-butter-and-jelly-oat-crumble-bars-recipe-12004399",
  "name": "Peanut Butter and Jelly Oat Crumble Bars",
  "recipe_type": "dessert",
  "brief_description": "These Peanut Butter and Jelly Oat Crumble Bars transform the classic sandwich into an easy dessert. With layers of creamy peanut butter, sweet jelly, and a buttery oat crumble topping, they\u2019re packed with nostalgic flavor and the perfect peanut butter-to-jelly ratio.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x9-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, peanut butter, and butter in a large bowl. Beat with an electric mixer until smooth. Add egg and vanilla; beat until well combined."
    },
    {
      "position": 3,
      "text": "Stir together rolled oats, oat flour, baking powder, and salt in a bowl. Gradually add oats mixture to the peanut butter mixture, mixing until just combined."
    },
    {
      "position": 4,
      "text": "Press 2/3 of the dough evenly into the bottom of the prepared pan. Dollop jelly evenly over the dough, then sprinkle with peanut butter chips. Drop remaining dough over the top in small pieces."
    },
    {
      "position": 5,
      "text": "Bake until lightly browned on top, 30 to 35 minutes. Cool in the pan on a wire rack for 1 hour before removing and cutting into bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

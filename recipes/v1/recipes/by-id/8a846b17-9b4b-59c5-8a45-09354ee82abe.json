  "id": "8a846b17-9b4b-59c5-8a45-09354ee82abe",
  "slug": "baked-asian-rockfish-recipe-7814108",
  "name": "Baked Asian Rockfish",
  "recipe_type": "main",
  "brief_description": "Baked rockfish with a delicate Asian-inspired sauce is quick, easy, and delicious.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a shallow baking pan with aluminum foil, and spray with cooking spray. Place filets onto the prepared baking pan."
    },
    {
      "position": 2,
      "text": "In a small bowl combine sesame oil, soy sauce, lime juice, honey, ginger, garlic, and pepper flakes. Spoon mixture evenly over top of filets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 10 to 15 minutes. Sprinkle filets with scallions before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

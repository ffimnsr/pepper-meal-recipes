  "id": "5ac19d3e-e58f-513f-a169-d4650c1a66fb",
  "slug": "apple-crumble-coffee-cake",
  "name": "Apple Crumble Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "Chef John's tempting apple crumb cake recipe has diced apples layered with a buttery cinnamon-walnut crumble for an elevated, irresistible coffee cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C) with an rack in the center position. Generously butter a 9x12-inch baking dish with 2 teaspoons butter."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking powder, baking soda, and \u00bd teaspoon sea salt together in a bowl; set dry ingredients aside."
    },
    {
      "position": 4,
      "text": "Combine walnuts, \u2153 cup brown sugar, \u2153 cup white sugar, 3 tablespoons melted butter, cinnamon, and \u00bc teaspoon salt in a bowl until walnuts and sugars are thoroughly coated with butter; set crumble mixture aside."
    },
    {
      "position": 5,
      "text": "Beat 1 cup white sugar and \u00bd cup butter together in a separate bowl with a spatula until well blended."
    },
    {
      "position": 6,
      "text": "Whisk in 1 egg until mixture is smooth, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Whisk in second egg until thoroughly incorporated. Add yogurt and vanilla; whisk together."
    },
    {
      "position": 8,
      "text": "Add flour mixture to yogurt mixture; whisk just until flour disappears. Do not overmix."
    },
    {
      "position": 9,
      "text": "Remove and discard cores from apples. Cut apples into \u215b- to \u00bc-inch slices. Stack a few slices; cut down the center, lengthwise, then dice, crosswise, into cubes."
    },
    {
      "position": 10,
      "text": "Fold apples into cake batter with a spatula until just combined."
    },
    {
      "position": 11,
      "text": "Spread \u00bd the batter into the prepared baking dish; evenly scatter \u00bd crumble mixture over top."
    },
    {
      "position": 12,
      "text": "Dollop remaining \u00bd batter on top crumble mixture; spread carefully to evenly distribute, trying not to disturb the crumbs."
    },
    {
      "position": 13,
      "text": "Top with remaining \u00bd crumble mixture; press crumbs into the batter very gently."
    },
    {
      "position": 14,
      "text": "Bake in the center of the preheated oven until a toothpick or bamboo skewer inserted into the center comes out clean, about 40 minutes."
    },
    {
      "position": 15,
      "text": "Cool to room temperature before slicing and serving, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,

  "slug": "paloma-martini-recipe-11713787",
  "name": "Paloma Martini",
  "recipe_type": "appetizer",
  "brief_description": "This paloma martini combines tequila, fresh grapefruit juice, and grapefruit soda in a refreshing cocktail, perfect for summer nights on the patio.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add tequila, lime juice, grapefruit juice, and agave nectar into a cocktail shaker. Add ice and shake until the outside of the shaker is frosted, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Pour into a frosted martini glass, leaving enough room for a splash of grapefruit soda. Garnish with a grapefruit slice or lime slice or both."
    }
  ],
  "servings": 1,

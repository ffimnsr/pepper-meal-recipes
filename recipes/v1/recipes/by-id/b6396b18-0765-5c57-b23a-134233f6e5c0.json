  "slug": "best-hummus",
  "name": "Best Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This hummus recipe is easy to make by blending canned chickpeas, tahini, olive oil, lemon juice, and garlic into a smooth and creamy dip or spread.",
  "cuisine": "Lebanese Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place chickpeas, tahini, olive oil, lemon juice, water, garlic, and cumin into a food processor and process until smooth, about 1 minute. Transfer to a bowl and sprinkle top of hummus with paprika and fresh parsley."
    }
  ],

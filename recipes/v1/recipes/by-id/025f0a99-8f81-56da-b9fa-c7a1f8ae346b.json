  "id": "025f0a99-8f81-56da-b9fa-c7a1f8ae346b",
  "slug": "cool-cucumber-salsa",
  "name": "Cool Cucumber Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This refreshing cucumber salsa with jalape\u00f1o, tomatoes, green bell pepper, cilantro, and a burst of lime is a great way to use summer cucumbers.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Stir cucumbers, tomatoes, green pepper, jalape\u00f1o pepper, onion, garlic, lime juice, parsley, cilantro, dill, and salt together in a medium bowl; cover and refrigerate until chilled, about 30 minutes to 1 hour."
    },
    {
      "position": 3,
      "text": "Serve with tortilla chips."
    }
  ],
  "servings": 12,

  "id": "5c6d2096-dcba-5d4c-a5b9-3a87dc7efe5a",
  "slug": "shrimp-fajitas",
  "name": "Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "Skip the tacos and serve up these easy and flavorful shrimp fajitas, marinated in a zesty blend and served with sauteed onion and peppers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk chili powder, olive oil, lime juice, and garlic salt together in a medium bowl. Add shrimp and toss to coat. Let marinate for 10 minutes."
    },
    {
      "position": 2,
      "text": "While shrimp marinates, heat a large skillet or griddle over medium-high heat. Spray with cooking spray. Add bell peppers and onion; saute until tender, 7 to 8 minutes. Transfer to a bowl and cover with foil to keep warm."
    },
    {
      "position": 3,
      "text": "Pour shrimp and the marinade into the same skillet. Cook shrimp until they are bright pink on the outside and the meat is opaque, about 2 minutes per side."
    },
    {
      "position": 4,
      "text": "Serve shrimp, onion, and peppers in flour tortillas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

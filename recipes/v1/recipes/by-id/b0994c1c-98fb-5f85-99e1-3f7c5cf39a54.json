  "id": "b0994c1c-98fb-5f85-99e1-3f7c5cf39a54",
  "slug": "barons-blackberry-cobbler",
  "name": "Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This blackberry cobbler, bursting with fresh, juicy blackberries and topped with a simple batter, is the perfect dessert to enjoy at summer gatherings.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "To prepare the blackberries: Whisk sugar and cornstarch together in a small bowl. Place blackberries into a mixing bowl and drizzle with melted butter. Sprinkle cornstarch mixture over top, then toss until evenly coated."
    },
    {
      "position": 4,
      "text": "Spread blackberry mixture into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "To make the batter: Whisk flour, sugar, baking powder, and salt together in a mixing bowl until evenly blended. Stir in milk, melted butter, and vanilla until combined but still slightly lumpy."
    },
    {
      "position": 6,
      "text": "Pour over blackberries in the baking dish."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until berries are tender and the crust is golden brown, 55 to 60 minutes."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

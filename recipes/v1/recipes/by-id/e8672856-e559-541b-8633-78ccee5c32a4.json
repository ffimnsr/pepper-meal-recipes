  "id": "e8672856-e559-541b-8633-78ccee5c32a4",
  "slug": "carrot-marmalade-recipe-11712226",
  "name": "Carrot Marmalade",
  "recipe_type": "dessert",
  "brief_description": "For this carrot marmalade, shredded carrots are cooked down with orange and lemon zest and juice plus sugar into a sticky, sweet marmalade. Serve over cream and scones, on top pf crostini, or over lamb.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water, orange zest and juice, lemon zest and juice, and carrots in a large saucepan. Bring to a boil over medium-high heat, stirring occasionally. Reduce heat to medium-low and simmer, stirring occasionally, until carrots are tender-crisp, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in sugar, cardamom, and salt until sugar is dissolved, about 30 seconds. Simmer over medium-low, stirring occasionally, until thickened and a candy thermometer registers 220 degrees F (104 degrees C), 40 to 45 minutes."
    },
    {
      "position": 4,
      "text": "Skim and discard any foam off top. Pour carrot mixture into a 16-ounce jar."
    },
    {
      "position": 5,
      "text": "Cover with lid and refrigerate until fully cooled, at least 4 hours or up to 3 weeks. Recipe developed by Melissa Gray-Streett"
    }
  ],
  "servings": null,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

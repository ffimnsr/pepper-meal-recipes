  "id": "d7d52e3f-f47d-59fc-b140-994e3b8d6ac4",
  "slug": "best-oven-baked-french-toast",
  "name": "Best Oven Baked French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This baked French toast is lightly spiced with a buttery combination of cinnamon and brown sugar, perfect for a special brunch, and can be made ahead.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour melted butter into a 9x13-inch baking dish; grease the sides with butter and let remaining butter sit in the bottom of the dish."
    },
    {
      "position": 3,
      "text": "Sprinkle brown sugar and cinnamon evenly over melted butter. Arrange two layers of bread slices on top."
    },
    {
      "position": 4,
      "text": "Whisk eggs, milk, and salt together in a bowl; pour over bread slices. Cover and refrigerate 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bake in the preheated oven until golden brown, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Serve with the toppings of your choice and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

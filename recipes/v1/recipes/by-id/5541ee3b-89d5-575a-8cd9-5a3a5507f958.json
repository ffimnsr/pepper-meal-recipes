  "id": "5541ee3b-89d5-575a-8cd9-5a3a5507f958",
  "slug": "no-bake-lemon-bars-recipe-11919141",
  "name": "No-Bake Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "These no-bake lemon bars need a few hours to chill, but are quick to assemble. A fluffy texture, buttery shortbread crust, and intense lemon flavor make them irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line bottom and sides of an 8x8-inch baking pan with parchment paper, leaving a 2-inch overhang on opposite sides; set aside."
    },
    {
      "position": 2,
      "text": "Stir together shortbread crumbs, melted butter, sugar, and 1/4 teaspoon salt in a bowl until evenly moistened. Press mixture firmly into the bottom of the prepared pan."
    },
    {
      "position": 3,
      "text": "Whisk together sweetened condensed milk, lemon zest, lemon juice, and remaining 1/4 teaspoon salt in a large bowl until smooth."
    },
    {
      "position": 4,
      "text": "If using heavy cream, beat in a separate large bowl until stiff peaks form. Gently fold into the lemon mixture until fully combined. If using whipped dessert topping, fold directly into the lemon mixture until fully combined."
    },
    {
      "position": 5,
      "text": "Spread filling evenly over the crust. Cover and refrigerate until firm, at least 4 hours."
    },
    {
      "position": 6,
      "text": "Lift chilled dessert from the pan using parchment overhang. Cut into 16 bars and garnish with additional lemon zest, if desired. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

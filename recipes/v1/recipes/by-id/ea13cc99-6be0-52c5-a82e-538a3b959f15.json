{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ea13cc99-6be0-52c5-a82e-538a3b959f15",
  "slug": "chicken-cordon-bleu-in-the-air-fryer",
  "name": "Chicken Cordon Bleu in the Air Fryer",
  "recipe_type": "main",
  "brief_description": "Breaded chicken breasts are stuffed with ham and Swiss cheese in this delicious version of chicken Cordon Bleu cooked in the air fryer.",
  "cuisine": "French Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place each chicken breast on a cutting board between 2 pieces of parchment paper. Being careful not to pound all the way through, use a mallet or a foil-wrapped brick to flatten each breast to a thickness of 1/4 inch."
    },
    {
      "position": 2,
      "text": "Cut ham and Swiss cheese slices in half so you have 4 pieces of each. Stack 1 piece ham and 1 piece of cheese in the middle of each flattened chicken breast. Roll up like a jelly roll, tucking the ham and cheese inside the breast as you roll. Secure the ends and sides with toothpicks so the cheese won't run out. Transfer to the refrigerator for at least 15 minutes, or up to 4 hours."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C), if recommended by the manufacturer."
    },
    {
      "position": 4,
      "text": "Combine flour, salt, and pepper in a small bowl. Place beaten egg in second bowl. Place bread crumbs in a third bowl."
    },
    {
      "position": 5,
      "text": "Dip each chicken bundle in flour mixture, then in egg, and finally in bread crumbs to coat. If you notice any spots that are just coated in flour, lightly pat with beaten egg and bread crumbs. Gently pat each bundle with melted butter and place in the air fryer basket."
    },
    {
      "position": 6,
      "text": "Air-fry until crust is nicely browned and chicken is no longer pink in the center and the juices run clear, about 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

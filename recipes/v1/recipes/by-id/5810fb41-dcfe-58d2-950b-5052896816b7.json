  "slug": "neiman-marcus-chicken-salad-recipe-11763842",
  "name": "Neiman Marcus Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This Neiman Marcus chicken salad, a copycat of the department store\u2019s signature cafe recipe, is quick to make and very satisfying as a cold supper. Serve over lettuce or fill a sandwich.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine chicken, celery, grapes, almonds, parsley, mayonnaise, salt, and pepper. Stir until well mixed."
    },
    {
      "position": 2,
      "text": "In a separate bowl, whip heavy cream until soft peaks form. Gently fold whipped cream into the chicken mixture until fully incorporated. Taste; adjust seasoning if desired."
    },
    {
      "position": 3,
      "text": "Chill until ready to serve."
    }
  ],
  "servings": 6,

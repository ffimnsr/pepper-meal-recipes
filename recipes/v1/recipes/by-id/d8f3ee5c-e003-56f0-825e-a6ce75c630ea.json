  "id": "d8f3ee5c-e003-56f0-825e-a6ce75c630ea",
  "slug": "red-cabbage-salad-ii",
  "name": "Red Cabbage Salad",
  "recipe_type": "salad",
  "brief_description": "Colorful, crisp red cabbage salad is tossed with a delightful oil and vinegar dressing. Easy to prepare ahead, it gets better the longer it sits.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix red wine vinegar, canola oil, sugar, salt, seasoned salt, pepper, and onion powder in a bowl."
    },
    {
      "position": 2,
      "text": "Place cabbage in a large glass bowl. Pour dressing over cabbage and toss to coat. Cover and refrigerate, 8 hours to overnight, stirring occasionally. Drain before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

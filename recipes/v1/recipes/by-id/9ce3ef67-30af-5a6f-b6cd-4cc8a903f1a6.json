  "id": "9ce3ef67-30af-5a6f-b6cd-4cc8a903f1a6",
  "slug": "sweet-potato-chews-for-dogs",
  "name": "Sweet Potato Chews for Dogs",
  "recipe_type": "appetizer",
  "brief_description": "Sweet potato is the one ingredient you need to make chewy dog food at home. Just peel, slice, and bake! It's that easy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cut sweet potato into 1/4-inch slices crosswise and cut larger slices in half. Place slices on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 hour. Turn slices over and bake for 1 1/2 hours more. Turn oven off and leave chews in the oven until completely cooled."
    }
  ],

  "id": "ce0d6b82-6bdc-5fdd-8756-aaa2b528947c",
  "slug": "copycat-popeye-s-red-beans-and-rice-recipe-11938256",
  "name": "Copycat Popeyes Red Beans and Rice",
  "recipe_type": "side",
  "brief_description": "These copycat Popeyes red beans and rice taste so much like the original. Saucy Cajun-seasoned beans with crisp bacon have a hint of smoky flavor and are paired with fluffy, seasoned rice.",
  "cuisine": "Copycat Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon slices in a 12-inch skillet over medium heat until bacon is crisp, flipping halfway, 8 to 10 minutes. Drain bacon on a paper towel lined plate."
    },
    {
      "position": 2,
      "text": "Add beans to the skillet with rendered bacon fat. Add 3/4 teaspoon Cajun seasoning, the hot sauce, and liquid smoke. Using a potato masher or fork mash about half of the beans in the skillet."
    },
    {
      "position": 3,
      "text": "Crumble bacon into skillet. Bring to a boil, then reduce heat to medium-low. Cover and simmer, stirring occasionally, over medium-low until thickened and flavors develop, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir together cooked rice, melted butter, remaining 1/4 teaspoon Cajun seasoning, and salt in a medium bowl until rice is well coated."
    },
    {
      "position": 5,
      "text": "Serve beans with seasoned rice on top. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

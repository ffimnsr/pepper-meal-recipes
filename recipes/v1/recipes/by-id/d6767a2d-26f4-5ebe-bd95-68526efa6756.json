  "id": "d6767a2d-26f4-5ebe-bd95-68526efa6756",
  "slug": "manicotti-italian-casserole",
  "name": "Manicotti Italian Casserole",
  "recipe_type": "main",
  "brief_description": "Whether you call this recipe manicotti or Italian casserole, this family-favorite baked pasta dish with ground beef and sausage is hearty and delicious.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook rigatoni in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, brown ground beef and Italian sausage in a large skillet over medium heat; transfer to a baking dish using a slotted spoon. Stir spaghetti sauce, mushrooms, and rigatoni into beef and sausage mixture. Sprinkle mozzarella cheese and pepperoni over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is brown and bubbly, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

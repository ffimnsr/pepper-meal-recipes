  "id": "e7a21d31-28fc-55ca-810d-a445a12c6bd4",
  "slug": "picnic-baked-bean-casserole",
  "name": "Picnic Baked Bean Casserole",
  "recipe_type": "side",
  "brief_description": "This picnic baked bean casserole recipe with canned beans is cooked with brown sugar, ketchup, and onion and topped with crumbled bacon for a BBQ side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2 \u00bd-quart baking dish with nonstick spray."
    },
    {
      "position": 2,
      "text": "Combine pork and beans, kidney beans, lima beans, onion, brown sugar, ketchup, and dry mustard in a large bowl; transfer to the prepared baking dish. Sprinkle with bacon. Cover the dish with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes. Remove foil; continue baking until bubbling, about 30 minutes more."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

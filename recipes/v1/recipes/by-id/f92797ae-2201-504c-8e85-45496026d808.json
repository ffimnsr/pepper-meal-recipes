  "id": "f92797ae-2201-504c-8e85-45496026d808",
  "slug": "chicken-stroganoff-recipe-11694838",
  "name": "Chicken Stroganoff",
  "recipe_type": "main",
  "brief_description": "This easy chicken stroganoff recipe cooks flavorful chicken thighs in a creamy mushroom sauce flavored with Dijon mustard and Worcestershire.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken with 1/4 teaspoon salt and 1/4 teaspoon pepper. Sprinkle 2 tablespoons of flour over chicken and toss to coat."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a 12-inch skillet over medium heat. Add half of the chicken and brown on each side, 3 minutes. Transfer chicken to a plate. Repeat with remaining chicken, adding up to 1 tablespoon additional oil, if needed."
    },
    {
      "position": 3,
      "text": "Melt butter in the skillet. Add mushrooms and onion and cook until mushrooms release liquid and liquid cooks away, 6 to 8 minutes. Add garlic to skillet. Cook until fragrant, about 1 minute. Sprinkle with remaining 1 tablespoon flour. Cook and stir 1 minute."
    },
    {
      "position": 4,
      "text": "Add broth, Worcestershire sauce, mustard, remaining 1/4 teaspoon salt, and remaining 1/4 teaspoon pepper to skillet. Bring to a boil while scraping the browned bits of food off the bottom of the skillet with a wooden spoon."
    },
    {
      "position": 5,
      "text": "Add sour cream to a small bowl. Gradually whisk about 1/2 cup of the hot broth mixture into the sour cream. Add the sour cream mixture back to the skillet. Return to a boil."
    },
    {
      "position": 6,
      "text": "Return chicken to the skillet. Simmer until heated through and sauce thickens slightly, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Serve with rice and sprinkle with paprika and chives. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "62b3d22f-ef16-5112-83f5-f3d9e5fbbc90",
  "slug": "mangonada",
  "name": "Mangonada",
  "recipe_type": "dessert",
  "brief_description": "A Mexican mangonada, or chamoyada, is a blended frozen mango drink with lime, chamoy, and chili-lime seasoning for a sweet and salty summer treat.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 teaspoon chamoy on a plate. Place 1 teaspoon chili-lime seasoning on another plate. Dip rim of glass first in chamoy, then in chili-lime seasoning. Set aside."
    },
    {
      "position": 2,
      "text": "Combine frozen mango, water, and lime juice in a blender; blend until smooth."
    },
    {
      "position": 3,
      "text": "Place 1/2 tablespoon chamoy in the bottom of the glass. Add 1/2 teaspoon chili-lime seasoning and 1/2 of the blended mangoes. Repeat layers and top with diced fresh mango."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "6972d2ab-336d-5a4e-a3c8-ccc98141ccb3",
  "slug": "loaded-baked-potato-bites-recipe-11882468",
  "name": "Loaded Baked Potato Bites",
  "recipe_type": "appetizer",
  "brief_description": "These loaded baked potato bites have all the things you love on a baked potato in bite-sized form. Not only are they cute, they are packed full of flavor and will be the first thing to disappear on your appetizer spread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large bowl. Drizzle oil over the top; toss. Add salt; toss. Place potatoes on the baking sheet in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until easily pierced with a fork, about 20 minutes. Remove from the oven and let stand 5 minutes."
    },
    {
      "position": 4,
      "text": "Using a sharp knife, cut a wedge in the top of each potato."
    },
    {
      "position": 5,
      "text": "Top each potato with sour cream, Cheddar cheese, bacon, and green onions. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "0edc8376-baa2-593a-aee0-c8bb7a8a7954",
  "slug": "pineapple-cheese-ball",
  "name": "Pineapple Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This creamy pineapple cheese ball is easy to make with celery, bell pepper, pineapple, and pecans for a delicious sweet and savory party appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix drained pineapple, cream cheese, celery, bell pepper, and onion together in a medium bowl until well combined. Divide mixture in half and form into two balls."
    },
    {
      "position": 2,
      "text": "Place chopped pecans in a shallow dish. Roll each cheese ball in pecans to coat. Cover and chill for at least 2 hours or until firm."
    }
  ],

  "id": "edab5a17-2dc7-5618-98bb-fda681b21aa8",
  "slug": "chocolate-chip-pudding-cookies",
  "name": "Chocolate Chip Pudding Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cookies change flavors if you change the flavor of the pudding and or the flavor of the chips. They are very cake-like in texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the flour and baking soda. Set aside."
    },
    {
      "position": 3,
      "text": "Mix the butter, brown sugar, white sugar, pudding mix, and vanilla. Beat until creamy. Add the eggs and mix well. Gradually stir in the flour mixture. Stir in the chocolate chips and the chopped nuts. Drop from teaspoon onto ungreased cookie sheets about 1 inch apart."
    },
    {
      "position": 4,
      "text": "Bake at 375 degrees F (190 degrees C) for 8 to 10 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,

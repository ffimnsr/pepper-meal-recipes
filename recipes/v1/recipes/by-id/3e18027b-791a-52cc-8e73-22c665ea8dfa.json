  "id": "3e18027b-791a-52cc-8e73-22c665ea8dfa",
  "slug": "tofu-stir-fry-with-peanut-sauce-vegan",
  "name": "Tofu Stir-Fry with Peanut Sauce (Vegan)",
  "recipe_type": "main",
  "brief_description": "You'll love this delicious tofu stir-fry with peanut sauce whether you're vegan, vegetarian, or none of the above. It's perfect any night of the week!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk coconut milk, peanut butter, soy sauce, brown sugar, lime juice, Sriracha sauce, and ground chili pepper together in a bowl until a smooth sauce forms."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Add carrots and bell pepper; saut\u00e9 until just tender, 1 to 2 minutes. Add tofu and saut\u00e9 until lightly browned, about 4 minutes per side. Add garlic and ginger; cook and stir until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Pour sauce into the skillet and stir to coat tofu and vegetables. Cook until flavors combine, about 5 minutes. Reduce the heat to low, then stir in spinach, 1 cup at a time, until wilted. Serve over brown rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "4b636f8c-2162-51e3-adcc-9346c2692792",
  "slug": "swedish-cream",
  "name": "Swedish Cream",
  "recipe_type": "salad",
  "brief_description": "Almond-vanilla flavored cream is set in a mold and then smothered in lingonberries to make a surprisingly simple dessert that looks like it took you a lot of time. This is a dish my sister makes for special occasions. It is not too sweet and very rich and creamy. If you like a sweeter dish, double the sugar. This makes for a lovely presentation that looks like you went to a lot of effort but didn't.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the cream, water, sugar, and gelatin in a saucepan over low heat. Stir constantly until the gelatin has dissolved. Remove from the heat and let cool slightly until thickened, about 10 minutes; it should be the consistency of beaten eggs. Fold in the sour cream, vanilla extract, and almond extract. Pour into a mold, cover, and refrigerate until set, at least 4 hours, preferably overnight."
    },
    {
      "position": 2,
      "text": "Loosen from mold by dipping into hot water. Invert onto a serving plate to unmold. Pour lingonberries over top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

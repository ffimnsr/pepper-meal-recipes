  "id": "1ba21e56-5bac-5c49-aeb2-84153ab7725d",
  "slug": "egg-noodles",
  "name": "Easy Egg Noodles",
  "recipe_type": "soup",
  "brief_description": "These homemade egg noodles are easy to make with just 5 ingredients! They're delicious in soups, or anytime you want an old-fashioned side to soak up gravy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir flour and salt together in a large bowl. Add eggs, milk, and butter."
    },
    {
      "position": 3,
      "text": "Knead dough until smooth, about 5 minutes. Let rest in a covered bowl for 10 minutes."
    },
    {
      "position": 4,
      "text": "On a floured surface, roll dough out to a thickness of 1/8 to 1/4 inch. Cut into desired lengths and shapes."
    },
    {
      "position": 5,
      "text": "Allow to air-dry before cooking, 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Cook noodles in a large pot of salted boiling water until al dente, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

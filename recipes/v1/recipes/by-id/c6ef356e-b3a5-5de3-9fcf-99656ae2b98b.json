  "id": "c6ef356e-b3a5-5de3-9fcf-99656ae2b98b",
  "slug": "creme-de-menthe-grasshopper-pie",
  "name": "Grasshopper Pie",
  "recipe_type": "dessert",
  "brief_description": "This Grasshopper pie has a creamy mint filling made with marshmallow fluff and cr\u00e8me de menthe for a festive holiday or St. Patrick\u2019s Day dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Crush cookies and set aside 1/4 cup of crumbs. Place remaining crumbs in a medium bowl and mix in melted butter; press mixture firmly into the bottom and sides of a 9-inch springform pan."
    },
    {
      "position": 3,
      "text": "Mix marshmallow fluff and cr\u00e8me de menthe together in a large mixing bowl until smooth."
    },
    {
      "position": 4,
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form; fold into marshmallow mixture."
    },
    {
      "position": 5,
      "text": "Pour mixture into prepared crust and sprinkle reserved cookie crumbs on top. Freeze until firm, at least 2 hours. Remove from freezer 20 minutes before serving to soften slightly."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

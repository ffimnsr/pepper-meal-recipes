  "id": "0a49975d-c8a2-5df1-a92e-4e5045425be1",
  "slug": "easy-bok-choy",
  "name": "Easy Bok Choy",
  "recipe_type": "side",
  "brief_description": "This bok choy recipe lets you enjoy the leafy green's crisp, delicate flavor with just oil, garlic, and salt cooked on the stove in just 10 minutes.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet or wok over medium heat; cook garlic in hot oil until fragrant, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Mix in bok choy; cook and stir until the leafy green parts turn bright green and the stalks become slightly translucent, 5 to 8 minutes. Sprinkle with salt and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

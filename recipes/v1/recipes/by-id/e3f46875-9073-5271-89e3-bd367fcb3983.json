  "id": "e3f46875-9073-5271-89e3-bd367fcb3983",
  "slug": "make-ahead-freezer-chicken-parmesan",
  "name": "Make-Ahead Freezer Chicken Parmesan",
  "recipe_type": "main",
  "brief_description": "By baking and freezing this make-ahead chicken Parmesan dish, you can simply thaw and reheat on busy weeknights!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Pound chicken breasts to 1/2-inch thickness or less."
    },
    {
      "position": 3,
      "text": "Place beaten egg in a bowl. Combine bread crumbs, Parmesan cheese, Italian seasoning, and garlic powder in another bowl. Dip each chicken breast in egg, then roll in bread crumb mixture to coat evenly. Place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Turn and continue to cook until chicken is no longer pink in the center and juices run clear, about 10 minutes more. Let cool, 20 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Freeze in a 1-gallon resealable bag with smaller bags of tomato sauce and mozzarella cheese."
    },
    {
      "position": 6,
      "text": "To serve: Thaw in the refrigerator overnight. Reheat chicken at 375 degrees F (190 degrees C) until heated through and crispy, 15 to 20 minutes. Top chicken with tomato sauce, sprinkle with mozzarella cheese, and bake until cheese is melted, an additional 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "085a8427-ddab-5272-bf1c-13fb2b485f35",
  "slug": "apple-and-pear-crumble",
  "name": "Apple and Pear Crumble",
  "recipe_type": "dessert",
  "brief_description": "This pear crumble is packed with sweet and tender fruit and topped with a buttery oat and almond topping for a simply irresistible fall dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix oats, 3/4 cup brown sugar, flour, and butter together in a bowl until crumbly."
    },
    {
      "position": 3,
      "text": "Mix pears, apples, remaining 3/4 cup brown sugar, and cinnamon together in a separate bowl; spread into the bottom of a 9x9-inch glass pan."
    },
    {
      "position": 4,
      "text": "Sprinkle oat mixture atop apple-pear mixture; top with almonds."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is bubbling and crumble topping is crisp and golden brown, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

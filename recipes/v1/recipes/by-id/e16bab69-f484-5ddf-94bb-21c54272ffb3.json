  "schema_version": 1,
  "id": "e16bab69-f484-5ddf-94bb-21c54272ffb3",
  "slug": "mouthwatering-crabmeat-pan-seared-filets",
  "name": "Mouthwatering Crabmeat Pan Seared Filets",
  "recipe_type": "main",
  "brief_description": "Pan-seared beef filet mignon steaks in olive oil, simply topped with jumbo lump crabmeat tossed in butter, is the perfect celebration recipe for two.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) with oven rack in middle position. Oil a baking sheet."
    },
    {
      "position": 2,
      "text": "Pat filets dry; season with salt and black pepper. Set aside. Toss crabmeat with cooled melted butter; set aside."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large heavy skillet over medium-high heat until hot, but not smoking. Add filets; brown on both sides, about 3 minutes per side. Transfer to the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven until filets start to firm and are reddish-pink and juicy in centers, about 10 minutes. An instant-read thermometer inserted into centers should read 130 degrees F (54 degrees C). Top filets with crabmeat mixture."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

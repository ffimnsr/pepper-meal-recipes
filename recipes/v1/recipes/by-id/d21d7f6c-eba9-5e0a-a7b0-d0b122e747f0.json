  "id": "d21d7f6c-eba9-5e0a-a7b0-d0b122e747f0",
  "slug": "oven-baked-omelet",
  "name": "Oven Baked Omelet",
  "recipe_type": "breakfast",
  "brief_description": "Make an omelet in the oven with this perfectly puffy recipe made with sour cream and milk. This is a great dish to make when cooking for several people!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish with butter."
    },
    {
      "position": 2,
      "text": "Beat eggs, sour cream, milk, and salt in a bowl until blended. Stir in green onions. Pour the mixture into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, 25 to 30 minutes. Sprinkle Cheddar cheese over eggs and continue baking until cheese is melted, 2 to 3 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

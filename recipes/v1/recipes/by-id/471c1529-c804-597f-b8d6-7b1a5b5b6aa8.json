  "id": "471c1529-c804-597f-b8d6-7b1a5b5b6aa8",
  "slug": "stuffed-pepper-casserole-recipe-7372944",
  "name": "Stuffed Pepper Casserole",
  "recipe_type": "side",
  "brief_description": "Stuffed peppers are deconstructed in this casserole and given a subtle taco flair.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Spray a 13x9-inch baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large nonstick skillet over medium-high heat, and cook and stir ground beef, onion, green bell pepper, red bell pepper, and garlic until meat is browned and crumbly, 7 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Drain excess fat; season with salt and pepper. Stir in RO-TEL tomatoes, tomato sauce, and taco seasoning."
    },
    {
      "position": 4,
      "text": "Spread rice in the bottom of the baking dish; pour in beef broth. Fold pepper mixture into rice with a spatula, and spread evenly into the dish."
    },
    {
      "position": 5,
      "text": "Sprinkle with Colby cheese and pepper Jack cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, covered with foil, until rice is tender, about 50 minutes. Remove foil and cook until cheese is golden, about 5 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

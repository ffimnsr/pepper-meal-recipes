  "schema_version": 1,
  "id": "4afe7af8-8b30-5a83-a365-62552b310c7c",
  "slug": "blueberry-upside-down-mini-cakes",
  "name": "Blueberry Upside-Down Mini Cakes",
  "recipe_type": "dessert",
  "brief_description": "This recipe for blueberry upside-down mini cakes is a tasty way to bake your leftover blueberries with a touch of ginger and lemon zest into petite cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter six 4-inch ramekins and place in a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine blueberries, 2 tablespoons white sugar, and lemon zest in a small bowl; set aside."
    },
    {
      "position": 3,
      "text": "Microwave 2 tablespoons butter in a microwave-safe bowl until melted, about 30 seconds; stir in brown sugar. Divide brown sugar butter among bottoms of each ramekin. Divide blueberry mixture among ramekins."
    },
    {
      "position": 4,
      "text": "Beat 1/2 cup butter and 1/2 cup white sugar in a large bowl with an electric mixer until fluffy. Beat in eggs, one at a time, beating well after each addition. Beat in lemon juice and vanilla extract. Add flour, baking powder, ginger, and salt; beat to combine. Beat in milk. Divide batter among ramekins on top blueberry mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 25 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Cool in the ramekins for 5 minutes. Run a knife around edges of cakes; invert onto plates."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

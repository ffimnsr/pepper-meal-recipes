{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c5c4bdfb-99e0-5d4a-bc34-de74b9e53667",
  "slug": "crispy-and-creamy-doughnuts",
  "name": "Crispy and Creamy Doughnuts",
  "recipe_type": "dessert",
  "brief_description": "This homemade donut recipe is easier than you think and tastes just the glazed donuts from your favorite shop: crispy, fluffy, sweet perfection!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle the yeast over the warm water, and let stand for 5 minutes, or until foamy."
    },
    {
      "position": 2,
      "text": "Mix yeast mixture, milk, sugar, salt, eggs, shortening, and 2 cups of the flour together in a large bowl for a few minutes with an electric mixer at low speed, or stir with a wooden spoon. Beat in remaining flour, \u00bd cup at a time, until the dough no longer sticks to the bowl. Knead for about 5 minutes, or until smooth and elastic. Place the dough into a greased bowl, and cover. Set in a warm place to rise until double. Dough is ready if you touch it, and the indention remains."
    },
    {
      "position": 3,
      "text": "Turn the dough out onto a floured surface, and gently roll out to \u00bd-inch thickness. Cut with a floured doughnut cutter. Let doughnuts sit out to rise again until double. Cover loosely with a cloth."
    },
    {
      "position": 4,
      "text": "Melt butter in a saucepan over medium heat. Stir in confectioners' sugar and vanilla until smooth. Remove from heat, and stir in hot water one tablespoon at a time until the icing is somewhat thin, but not watery. Set aside."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep-fryer or large heavy skillet to 350 degrees F (175 degrees C). Slide donuts into the hot oil using a wide spatula. Turn donuts over as they rise to the surface. Fry donuts on each side until golden brown. Remove from hot oil, to drain on a wire rack. Dip donuts into the glaze while still hot, and set onto wire racks to drain off excess. Keep a cookie sheet or tray under racks for easier clean up."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "fbd76091-8520-544a-b161-2cfcec54a092",
  "slug": "the-best-steamed-asparagus",
  "name": "The Best Steamed Asparagus",
  "recipe_type": "side",
  "brief_description": "This asparagus cooked in the microwave turns out great. It is steamed with white wine and butter for a quick vegetable side dish with amazing flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place asparagus in a microwave-safe dish. Pour in wine and dot with butter."
    },
    {
      "position": 2,
      "text": "Cover loosely and cook in the microwave on high until bright green and tender, about 3 minutes. Allow to stand for 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

  "slug": "apple-pecan-salad-recipe-8720990",
  "name": "Apple Pecan Salad",
  "recipe_type": "salad",
  "brief_description": "This apple pecan salad with a simple homemade vinaigrette, has crunch, sweetness, and a salty kick.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vinegar, Dijon, shallots, salt, and pepper in a small bowl. Whisk in olive oil until dressing starts to emulsify."
    },
    {
      "position": 2,
      "text": "Combine mixed greens, apple, pecans, cranberries, and bacon in a large bowl and toss. Drizzle as much dressing over the salad as you like, and toss again. Sprinkle with feta, and serve."
    }
  ],
  "servings": 4,

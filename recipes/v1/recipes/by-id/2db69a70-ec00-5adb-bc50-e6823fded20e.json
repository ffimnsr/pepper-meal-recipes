  "slug": "haroset",
  "name": "Haroset",
  "recipe_type": "dessert",
  "brief_description": "Crunchy chopped apples and walnuts are tossed with just the right amount of sugar, cinnamon and Kosher red wine to make this traditional holiday relish. Refrigerate, allowing the sweet, spicy flavors to blossom before serving.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Mix apples, nuts, sugar and cinnamon together in a bowl. Add wine and mix in to thoroughly blend. Keep in refrigerator until ready to put out on the table for Passover Seder."
    }
  ],
  "servings": 4,

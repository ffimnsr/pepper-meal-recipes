  "id": "ce8a8e2f-48b6-5b14-8d8b-f51524314c1a",
  "slug": "cream-cheese-cupcakes",
  "name": "Cream Cheese Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Quick and Easy recipe. A hit with those who like cheese cake. Top with your favorite pie filling.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line 2 (12 cup) muffin tins with paper liners."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine cream cheese and sugar. Mix until soft. Add eggs and combine. Add vanilla."
    },
    {
      "position": 3,
      "text": "Distribute evenly into 2 (12 cup) lined muffin tins and bake at 325 degrees F (165 degrees C) for 35 minutes."
    },
    {
      "position": 4,
      "text": "When done, the centers will fall in a bit while cooling. When cool, fill depressions with 2 to 3 tablespoons of your favorite fruit pie filling. Store in the refrigerator."
    }
  ],
  "servings": 24,

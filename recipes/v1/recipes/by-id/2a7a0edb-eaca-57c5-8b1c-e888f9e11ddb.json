  "slug": "pesto",
  "name": "Pesto",
  "recipe_type": "side",
  "brief_description": "This basic pesto is a no-fail recipe made with aromatic basil, olive oil, garlic, Parmesan, pine nuts, and parsley. Great as a dip, spread, or sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine basil, Parmesan cheese, olive oil, pine nuts, and garlic in the bowl of a food processor or blender. Blend to a smooth paste. Add lemon juice, if desired, and quickly pulse to combine."
    }
  ],

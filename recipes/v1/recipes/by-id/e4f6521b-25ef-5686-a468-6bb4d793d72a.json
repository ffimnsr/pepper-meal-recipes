  "id": "e4f6521b-25ef-5686-a468-6bb4d793d72a",
  "slug": "low-carb-chicken-and-mushroom-soup",
  "name": "Low-Carb Chicken and Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "A rich addition to any keto diet, this satisfying chicken and mushroom soup is thickened with heavy cream and enhanced with fresh tarragon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a Dutch oven over medium-high heat. Add chicken; saut\u00e9 until lightly browned, about 3 minutes. Add onion and garlic; saut\u00e9 until softened, about 5 minutes. Stir in mushrooms; saut\u00e9 until tender, 5 to 10 minutes. Pour in chicken stock and 2 tablespoons tarragon; reduce heat to low. Season with salt. Cover and simmer soup until flavors are combined, about 25 minutes."
    },
    {
      "position": 2,
      "text": "Stir cream into soup; cook until heated through but not boiling. Serve soup with pepper and remaining tarragon on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

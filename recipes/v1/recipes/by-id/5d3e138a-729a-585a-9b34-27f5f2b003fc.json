  "id": "5d3e138a-729a-585a-9b34-27f5f2b003fc",
  "slug": "pumpkin-pie-seeds",
  "name": "Pumpkin Pie Seeds",
  "recipe_type": "appetizer",
  "brief_description": "The pumpkins are carved, the pies are all baked, and you have a bunch of pumpkin seeds just waiting to be turned into a sweet, spicy snack. Here's your recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place pumpkin seeds, water, and salt in a saucepan, bring to a boil, and reduce heat to medium; boil seeds for 10 minutes. Drain seeds but do not rinse. Pat seeds dry with paper towels and spread out onto a work surface or a baking sheet for 30 minutes to dry."
    },
    {
      "position": 2,
      "text": "Preheat oven to 250 degrees F (120 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 3,
      "text": "Melt butter in a large microwave-safe bowl until melted, about 1 minute. Toss seeds in the melted butter and mix in 1 tablespoon sugar, cinnamon, ginger, nutmeg, cloves, and cardamom; toss again to coat seeds thoroughly with spices. Spread seeds out onto the prepared baking sheet in a single layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until toasted and crunchy, 45 minutes to 1 hour. Stir several times during baking. Sprinkle toasted seeds with 1 tablespoon sugar or as desired; cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "dff2f8c6-9bd4-57f9-9ba3-c814f65fa010",
  "slug": "manhattan-clam-chowder",
  "name": "Manhattan Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "This Manhattan clam chowder is a zesty soup with a tomato juice base, plus potatoes, bell pepper, and green onions. Ready in less than 45 minutes!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Chop clams, reserving juice; set clams aside. Strain clam juice to remove bits of shell. Measure juice; add enough water to equal 1 1/2 cups liquid."
    },
    {
      "position": 2,
      "text": "Combine clam juice mixture, clam-tomato juice cocktail, potatoes, bell peppers, scallions, and black pepper in a large saucepan; heat to a boil. Reduce heat, cover, and simmer for about 15 minutes or until potatoes are just tender."
    },
    {
      "position": 3,
      "text": "Stir in undrained tomatoes and chopped clams and heat through."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

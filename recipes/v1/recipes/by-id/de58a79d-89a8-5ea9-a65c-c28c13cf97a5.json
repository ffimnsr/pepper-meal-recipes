  "id": "de58a79d-89a8-5ea9-a65c-c28c13cf97a5",
  "slug": "garden-tomato-salsa",
  "name": "Garden Tomato Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This garden tomato salsa recipe is made with fresh tomatoes, onion, bell pepper, cilantro, pickled jalape\u00f1os, fresh lime, red wine vinegar, and oil.",
  "cuisine": "World American",
  "instructions": [
    {
      "position": 1,
      "text": "Place onion, bell pepper, cilantro, and jalape\u00f1os in the bowl of a food processor; pulse until finely chopped. Add tomatoes; pulse several times until tomatoes are coarsely chopped. Transfer to a bowl with a tight-fitting lid."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, red wine vinegar, lime juice, and salt together in a small bowl until vinaigrette well combined."
    },
    {
      "position": 3,
      "text": "Pour vinaigrette over tomato mixture; stir well. Cover; refrigerate before serving for at least 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "a61bb099-ec80-5b55-bbdb-accbd08e4702",
  "slug": "potato-cheese-soup-with-velveeta",
  "name": "Potato Cheese Soup with Velveeta",
  "recipe_type": "soup",
  "brief_description": "This rich, comforting potato cheese soup is loaded with tender potatoes, carrots, celery, and onion in a creamy, cheesy broth. Chicken soup base adds savory depth, making this an easy family favorite for chilly nights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine potatoes and carrot in a large pot. Add enough water to cover and bring to a boil over high heat. Cook until vegetables are tender, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add celery and onion; cook, stirring occasionally, until softened, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Drain the potatoes and carrots, reserving about 2 cups cooking liquid. Return vegetables and reserved liquid to the pot. Stir in 4 cups milk, then season with salt and pepper. Reduce heat to low."
    },
    {
      "position": 4,
      "text": "Transfer the onion and celery mixture to the pot and stir in the chicken soup base. Heat slowly, then add the cheese. Allow the cheese to melt, stirring all together well."
    },
    {
      "position": 5,
      "text": "Whisk cornstarch and remaining 1/2 cup milk together in a small bowl until smooth. Stir into the soup and cook until slightly thickened, 2 to 3 minutes. Serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,

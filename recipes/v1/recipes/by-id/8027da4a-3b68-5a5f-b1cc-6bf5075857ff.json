  "id": "8027da4a-3b68-5a5f-b1cc-6bf5075857ff",
  "slug": "ground-turkey-ricotta-meatballs",
  "name": "Ground Turkey-Ricotta Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for savory, pillowy-soft turkey-ricotta meatballs with basil is great for a quick dinner or crowd-pleasing appetizer. They freeze well, too.",
  "cuisine": "American Fusion Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine turkey, ricotta, bread crumbs, basil, egg, salt, and black pepper in a bowl until just mixed."
    },
    {
      "position": 3,
      "text": "Scoop mixture into meatballs using a 1-ounce measure onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes; flip meatballs. Bake until browned and no longer pink in centers, about 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

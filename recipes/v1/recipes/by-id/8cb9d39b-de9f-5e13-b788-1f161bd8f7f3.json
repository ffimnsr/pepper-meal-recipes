  "id": "8cb9d39b-de9f-5e13-b788-1f161bd8f7f3",
  "slug": "cottage-cheese-tomato-soup-recipe-11682446",
  "name": "Cottage Cheese Tomato Soup",
  "recipe_type": "soup",
  "brief_description": "This cottage cheese tomato soup is creamy and with a high-protein twist\u2014cottage cheese, bone broth, and nutritional yeast add flavor and nutrients to classic tomato soup",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place tomatoes, shallot, and garlic on a baking tray. Spritz with olive oil and sprinkle with salt."
    },
    {
      "position": 2,
      "text": "Roast in the preheated oven until soft, 20 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile add cottage cheese, bone broth, tomato paste, nutritional yeast, and Italian seasoning into the jar of a blender. Blend until smooth."
    },
    {
      "position": 4,
      "text": "Remove roasted tomatoes from oven and add to blender. To blend hot soup, cover blender with the lid, and hold lid down tightly with a kitchen towel; blend until smooth. Contents will be hot! Taste and add salt if needed."
    },
    {
      "position": 5,
      "text": "Pour soup into bowls; serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

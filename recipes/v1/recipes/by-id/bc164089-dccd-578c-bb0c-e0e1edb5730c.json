  "id": "bc164089-dccd-578c-bb0c-e0e1edb5730c",
  "slug": "blueberry-strata",
  "name": "Blueberry Strata Recipe",
  "recipe_type": "breakfast",
  "brief_description": "The best breakfast strata includes blueberries, cream cheese, and French bread baked in a creamy custard to create the best breakfast ever!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat a 9x13-inch baking dish with cooking spray. Place half the bread cubes in the dish; top with 1 \u00bd cups blueberries. Scatter cream cheese over berries. Cover with remaining bread cubes. In a mixing bowl, whisk together eggs, maple syrup, and milk. Pour egg mixture over bread in dish. Cover, and chill overnight."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake strata in the preheated oven, covered, for 30 minutes. Remove cover, and bake for an additional 30 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, prepare the blueberry syrup: Combine sugar, cornstarch, and water in a saucepan. Bring mixture to a boil over high heat; cook for 5 minutes. Pour in remaining 1 \u00bd cups blueberries; continue cooking for 10 minutes. Remove from heat, and stir in butter. Serve warm over slices of the strata."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 15,

  "id": "55c4c769-5b8f-5a11-a786-1186d77d0032",
  "slug": "chef-johns-classic-potato-pancakes",
  "name": "Chef John\u2019s Classic Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Follow Chef John\u2019s recipe for his classic potato pancakes, and you will get perfectly crisp latkes every time. Top with salmon, sour cream, and dill.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes and onion into a large bowl and pour enough cold water in the bowl to cover by several inches. Let rest until potatoes and onion are completely soaked, 20 to 30 minutes. Pour potato mixture into a colander, rinse, drain, and squeeze repeatedly to remove all moisture."
    },
    {
      "position": 2,
      "text": "Whisk eggs, flour, salt, black pepper, and cayenne pepper together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Mix potato mixture and egg mixture together in a large bowl with a spatula."
    },
    {
      "position": 4,
      "text": "Heat 1/4-inch oil in a heavy skillet over medium-high heat. When oil shimmers, drop large spoonfuls of potato batter into hot oil and flatten with a spatula to about 1/2-inch thick. Cook until the edges of pancakes are golden brown and crispy, 3 to 5 minutes. Reduce heat to medium, flip pancakes, and cook until golden brown and crispy on the other side, about 5 minutes more. Repeat cooking process with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

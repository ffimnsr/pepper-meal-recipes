  "id": "97e56673-47c3-5a71-80bd-2ca8eb8675df",
  "slug": "sarahs-easy-shredded-chicken-taco-filling",
  "name": "Sarah's Easy Shredded Chicken Taco Filling",
  "recipe_type": "main",
  "brief_description": "This shredded chicken taco recipe is made with chicken breasts simmered in tomato sauce with cumin and chili powder for a super-quick taco filling.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken breasts in a saucepan and cover with water. Bring to a boil over medium heat, then simmer until no longer pink, 10 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Transfer chicken breasts to a bowl. Allow to cool briefly, then shred with 2 forks."
    },
    {
      "position": 4,
      "text": "Heat vegetable oil in a saucepan over medium heat. Add onion and cook until translucent, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir in shredded chicken, tomato sauce, cumin, and chili powder. Bring to a boil, then reduce heat to low and simmer until chicken is hot and flavors have blended, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

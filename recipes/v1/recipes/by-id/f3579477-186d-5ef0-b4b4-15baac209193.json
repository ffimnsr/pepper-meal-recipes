  "slug": "oatmeal-energy-balls",
  "name": "Oatmeal Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "For this recipe, rolled oats, peanut butter, honey, and raisins are rolled into little oatmeal energy balls that are perfect for on-the-go snacking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, peanut butter, raisins, and honey in a bowl with a fork; knead by hand until fully incorporated. Roll into 1-inch balls. Refrigerate for at least 1 hour."
    }
  ],

  "id": "a216dd6a-fe88-5dc5-94d4-936cb626fb0b",
  "slug": "creamy-lemon-garlic-salmon-recipe-11923780",
  "name": "Creamy Lemon Garlic Salmon",
  "recipe_type": "side",
  "brief_description": "This creamy lemon garlic cream salmon features a silky, white, lemon, garlic, cream, and cheese sauce over oven-baked salmon filets. Serve over buttery orzo with roasted broccoli on the side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Place salmon on the prepared baking sheet; drizzle with olive oil and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, about 15 minutes. Cooking time will vary based on thickness of filets."
    },
    {
      "position": 4,
      "text": "Meanwhile, for sauce, melt butter in a saucepan over medium-low heat. Add garlic and cook just until fragrant, about 30 seconds. Stir in milk and cream; simmer for 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Lower heat to very low. Add Swiss cheese and Parmesan cheese in small handfuls, whisking constantly until melted; remove from heat."
    },
    {
      "position": 6,
      "text": "Stir in lemon zest. Add lemon juice slowly to taste; season with salt and white pepper. Garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

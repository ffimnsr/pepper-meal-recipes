  "id": "28c14c18-cb78-50b9-934f-31c82fe42583",
  "slug": "pumpkin-cake-i",
  "name": "Easy Pumpkin Cake",
  "recipe_type": "dessert",
  "brief_description": "This easy pumpkin cake made with canned pumpkin puree and warm spices in a Bundt cake pan is a fall favorite, but tastes delicious any time of the year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch Bundt or tube pan."
    },
    {
      "position": 2,
      "text": "Blend oil, beaten eggs, pumpkin and vanilla together in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Sift flour, sugar, baking soda, ground nutmeg, ground allspice, ground cinnamon, ground cloves and salt together. Add flour mixture to pumpkin mixture and stir until just combined. Fold in chopped walnuts; pour batter into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in the middle comes out clean, about 1 hour. Let cake cool in the pan for 5 minutes. Turn out onto a plate and dust with confectioners\u2019 sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "a4a8b10a-f32c-57fe-8eb2-cecffd53248b",
  "slug": "cream-cheese-pound-cake",
  "name": "Cream Cheese Pound Cake with Lemon Glaze",
  "recipe_type": "dessert",
  "brief_description": "Butter and cream cheese provide the rich taste in this deliciously dense pound cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (160 degrees C). Grease and flour a 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Beat butter and cream cheese together with an electric mixer in a large bowl until smooth. Beat sugar into butter mixture until light and fluffy. The mixture should be noticeably lighter in color. Add the eggs two at a time, allowing each pair of eggs to blend into the butter mixture before adding the next. Beat in vanilla and almond extracts with the last eggs. Pour the flour and nutmeg into the bowl and beat until just incorporated. Pour the batter into the prepared tube pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 80 minutes. Check for doneness after 1 hour. Cool in the pan for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,

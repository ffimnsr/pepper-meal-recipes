  "id": "80d67016-8f9f-5bc3-9556-18963129ebba",
  "slug": "fresh-salmon-patties-recipe-11760442",
  "name": "Fresh Salmon Patties",
  "recipe_type": "main",
  "brief_description": "These fresh salmon patties, with a crispy, golden exterior and a tender, bold, zesty interior, are bursting with flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place salmon, salt, Old Bay, and Cajun seasoning in a food processor. Pulse until only bite-sized pieces remain. Transfer to a bowl. Gently fold in onion, bell pepper, garlic paste, parsley, mustard, mayonnaise, eggs, and panko, mixing thoroughly with your hands, leaving larger pieces intact."
    },
    {
      "position": 2,
      "text": "Form into 4 equal patties. Place the patties on a large plate."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (225 degrees C). Line a small baking sheet with foil and place in the oven."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large ovenproof nonstick skillet over medium-high heat. When hot, place patties in the pan. Cook for 2 minutes on one side. Transfer patties to the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake patties in the preheated oven for 4 to 5 minutes. Remove from the oven; turn patties over and bake for 1 to 2 minutes more."
    },
    {
      "position": 6,
      "text": "Line a plate with paper towels; transfer patties to the plate to drain any excess oil. Top each patty with a generous dollop of tartar sauce, garnish with fresh dill, and squeeze fresh lemon juice over to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

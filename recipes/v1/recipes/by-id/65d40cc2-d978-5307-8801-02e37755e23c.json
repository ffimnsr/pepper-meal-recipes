{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "65d40cc2-d978-5307-8801-02e37755e23c",
  "slug": "cookies-and-cream-rice-krispie-treats-recipe-8782998",
  "name": "Cookies and Cream Rice Krispie Treats",
  "recipe_type": "dessert",
  "brief_description": "Oreo cookies combine with classic Rice Krispie treats for a delicious cookies and cream version.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Grease a 9 x 13 inch pan with nonstick spray."
    },
    {
      "position": 2,
      "text": "Place the cookies in a resealable bag and use a rolling pin to coarsely crush them\u2013the goal is to end up with mostly larger, bite-sized pieces and less powdery bits (some is ok)."
    },
    {
      "position": 3,
      "text": "Melt butter in a large pot over medium heat. Add mini marshmallows and 1/2 the marshmallow cream. Reduce heat to medium-low, and stir well with a silicone spatula to melt the marshmallows and combine the mixture evenly. Stir in vanilla extract."
    },
    {
      "position": 4,
      "text": "Remove mixture from the heat. Add cereal and the powdery portion of the crushed cookies, and stir well to combine. Add larger crushed cookie pieces, and mix to combine."
    },
    {
      "position": 5,
      "text": "Dollop about half of the remaining marshmallow cream over the surface of the mixture, and fold a few times to partially incorporate it. Dollop the rest of the marshmallow cream over the surface, and fold a few more times to partially incorporate it. There should be visible streaks of marshmallow cream throughout the mixture."
    },
    {
      "position": 6,
      "text": "Pour mixture into the prepared pan, and use a spatula to push it into an even layer and compress it slightly."
    },
    {
      "position": 7,
      "text": "Let the pan sit at room temperature to firm up, 30 minutes to 1 hour, before slicing and serving. Store the pan tightly wrapped in plastic wrap at room temperature. They\u2019re gooiest in the first 24 hours, but will keep well for up to 5 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,

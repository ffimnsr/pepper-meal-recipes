  "id": "62871a26-24d3-5bca-9eab-49319f54b6b6",
  "slug": "parmalet-crisp-parmesan-omelet",
  "name": "Parmalet (Crisp Parmesan Omelet)",
  "recipe_type": "breakfast",
  "brief_description": "By creating a crisp grated cheese crust as the base of this Parmesan omelet, the eggs turn out moist and tender. Easy and delicious for a different way to cook eggs.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Crack eggs into a mixing bowl. Add 1/4 teaspoon water. Whisk together until just beaten (do not overmix)."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil into an 8-inch nonstick skillet. Brush evenly over the bottom of the pan. Evenly grate cheese into the skillet approximately 1/2-inch deep (or just shy of 1 ounce)."
    },
    {
      "position": 3,
      "text": "Place pan over medium-high heat. Cheese will slowly start to melt. When cheese starts to bubble and turn golden brown, about 4 minutes, pour eggs evenly over cheese. Reduce heat to low. Sprinkle with salt, pepper, and cayenne. Cover and let eggs cook on low until they are set, checking after the first 30 seconds. For 2 eggs, this should take about 1 minute, total cooking time."
    },
    {
      "position": 4,
      "text": "Remove pan from heat. Carefully use a spatula to fold parmalet in half. Transfer to a serving plate."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "67da9468-dfbe-5ada-ad29-b6925ae1b472",
  "slug": "potato-and-vegetable-frittata",
  "name": "Potato and Vegetable Frittata",
  "recipe_type": "salad",
  "brief_description": "This vegetable frittata with potatoes is an easy and filling dish. It\u2019s great with cooked greens or a tossed salad and some sprouted grain bread.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven\u2019s broiler."
    },
    {
      "position": 2,
      "text": "Heat oil in a frying pan with an ovenproof handle. Saut\u00e9 onion, garlic, and bell pepper over low heat until vegetables are tender but not browned. Add zucchini and continue cooking, stirring occasionally, until tender but still crisp. Add potatoes and continue cooking, stirring frequently, until potatoes are heated through and starting to stick to the pan. Stir in chopped tomatoes and black olives and cook just until tomatoes begin giving up their juice."
    },
    {
      "position": 3,
      "text": "Whisk eggs together with salt, pepper, oregano, and cayenne; pour over cooked vegetables."
    },
    {
      "position": 4,
      "text": "Arrange tomato slices over the top and sprinkle mozzarella and Parmesan over tomato slices. Cook gently over low heat until eggs are almost set (firm around the edges and a bit runny in the middle)."
    },
    {
      "position": 5,
      "text": "Place the pan under the preheated broiler for 1 to 2 minutes, or until eggs are fully set and cheese is melted and slightly browned. Cut into wedges and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "e19abd1e-0a05-5923-aeff-15a50286c31f",
  "slug": "chicken-hariyali-tikka",
  "name": "Chicken Hariyali Tikka",
  "recipe_type": null,
  "brief_description": "Chicken breast meat is rubbed with an intoxicating paste made with cilantro, mint, and other distinctive flavors. Chicken legs may also be used, or a combination of legs and breasts. This recipe is cooked in the oven, but will work well on the grill. Serve hot with onion rings.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, grind together the cilantro, mint leaves, ginger garlic paste, lemon juice, green chile paste, and salt. Place the chicken in the bowl, and rub with the mixture. Cover, and refrigerate 2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Preheat the oven broiler. Lightly grease a baking dish."
    },
    {
      "position": 3,
      "text": "Place the chicken in the baking dish, and broil 20 minutes, or until chicken juices run clear."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

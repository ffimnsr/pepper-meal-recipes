  "id": "d7850d8d-5908-590a-9c88-1220e191d4b0",
  "slug": "homemade-melt-in-your-mouth-dark-chocolate-paleo",
  "name": "Homemade Melt-In-Your-Mouth Dark Chocolate",
  "recipe_type": "dessert",
  "brief_description": "Learn how to make chocolate at home with cocoa, coconut oil, honey, and vanilla for a rich, melt-in-your-mouth chocolate treat. Great for gifting!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Gently melt coconut oil in a saucepan over medium-low heat. Stir cocoa powder, honey, and vanilla extract into melted oil until well blended."
    },
    {
      "position": 3,
      "text": "Pour the mixture into a candy mold or pliable tray."
    },
    {
      "position": 4,
      "text": "Refrigerate until chilled, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

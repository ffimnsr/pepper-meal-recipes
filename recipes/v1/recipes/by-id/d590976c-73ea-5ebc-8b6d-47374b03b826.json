  "id": "d590976c-73ea-5ebc-8b6d-47374b03b826",
  "slug": "red-eye-gravy",
  "name": "Easy Red Eye Gravy",
  "recipe_type": "side",
  "brief_description": "This easy red-eye gravy recipe combines coffee and ham stock instead of pan drippings to make a comforting, flavorful addition to any meal.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Dissolve ham stock and coffee granules in water in a large mixing bowl to create a stock."
    },
    {
      "position": 3,
      "text": "Melt butter in a medium saucepan over medium-high heat; add flour. Cook butter and flour, stirring constantly, until brown, to create a roux, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add stock mixture, \u00bd cup at a time to the roux, stirring constantly, until it has the consistency of gravy, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Stir in black pepper. Remove from heat."
    },
    {
      "position": 6,
      "text": "Serve warm with meal of choice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "3a88b5a1-dad8-5a71-bf40-f024e8017296",
  "slug": "freezer-door-manhattan-recipe-11948281",
  "name": "Freezer Door Manhattan",
  "recipe_type": "appetizer",
  "brief_description": "This freezer-door Manhattan, intensely smooth with a velvety texture, with the rye's spice rounded by vanilla, oak, and a lingering peppery finish. Sweet vermouth adds a dark, herbal sweetness and balancing bitterness. Served ice-cold without dilution and a Maraschino cherry, it is clean, strong, and dangerously easy to sip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour out about 1 cup whiskey from bottle to make room for remaining ingredients (reserve for another use). Using a funnel, add sweet vermouth and bitters. Seal bottle tightly, and gently invert several times to combine."
    },
    {
      "position": 2,
      "text": "Transfer bottle to freezer; chill until very cold, at least 2 hours."
    },
    {
      "position": 3,
      "text": "To serve, pour mixture into chilled coupe glasses. Garnish with cherries."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

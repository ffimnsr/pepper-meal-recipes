  "id": "bc54c8e3-5757-523d-86b3-824e29eb5e18",
  "slug": "garlic-bread-spread",
  "name": "Garlic Bread Spread",
  "recipe_type": "appetizer",
  "brief_description": "This garlic bread spread is perfect to use on Italian bread for delicious homemade garlic bread. It's easy to make with Parmesan, garlic, and herbs.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix butter, Parmesan cheese, garlic, marjoram, basil, fines herbs, oregano, parsley, and pepper together in a bowl until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Slice Italian bread loaf in half lengthwise; spread each half generously with the garlic butter mixture. Transfer onto a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake on the top rack of the preheated oven until butter mixture melts and bubbles, about 10 to 15 minutes. Turn on the oven's broiler and broil until the bread is your desired shade of golden brown, 1 to 2 more minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

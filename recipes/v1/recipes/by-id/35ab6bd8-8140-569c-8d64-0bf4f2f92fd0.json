  "id": "35ab6bd8-8140-569c-8d64-0bf4f2f92fd0",
  "slug": "pasta-pancetta",
  "name": "Pasta Pancetta",
  "recipe_type": "main",
  "brief_description": "This pancetta pasta recipe with flavorful Italian bacon, shallots, mushrooms, Parmesan, garlic, and oregano teaches you how long to cook pancetta.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Drain, transfer back to the pot, and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Cook pancetta in hot oil until just beginning to brown. Stir in shallots, mushrooms, garlic, pepper, and oregano; cook until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Pour in chicken broth; bring to a boil over medium-high heat, stirring occasionally, for 1 to 2 minutes. Reduce heat, cover, and simmer for 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Strain liquid from the pan into pasta; toss to coat. Divide pasta onto individual serving plates, then top with equal portions of pancetta and mushrooms. Serve with Parmesan cheese and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ee95e75a-0dd8-52eb-bc2e-35192e9b113f",
  "slug": "chef-johns-macaroni-and-cheese",
  "name": "Chef John's Macaroni and Cheese",
  "recipe_type": "main",
  "brief_description": "This panko mac and cheese is Chef John's easy-to-make, old-fashioned casserole with a crisp, buttery breadcrumb topping and a gooey, cheesy center.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Melt 1/4 cup butter in a large saucepan over medium heat. When butter starts to foam and bubble, stir in flour; cook on medium heat until flour begins to turn pale yellow, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Add thyme, cayenne, and white pepper; cook and stir another minute, then whisk in 1 cup milk until smooth. Pour in remaining milk and whisk again. Bring sauce just to a simmer."
    },
    {
      "position": 5,
      "text": "Stir in salt, Worcestershire sauce, and nutmeg. Simmer, whisking often, on medium-low heat until thickened, about 8 minutes."
    },
    {
      "position": 6,
      "text": "Turn heat off, then add 2 1/4 cups Cheddar cheese; stir until melted and combined. Mix in Dijon mustard."
    },
    {
      "position": 7,
      "text": "Transfer macaroni into a 8x8-inch casserole dish, then pour in cheese sauce; stir to thoroughly combine pasta with sauce."
    },
    {
      "position": 8,
      "text": "Mix together panko bread crumbs and 1 tablespoon melted butter in a small bowl."
    },
    {
      "position": 9,
      "text": "Sprinkle mixture over macaroni and cheese. Sprinkle remaining 3/4 cup Cheddar cheese on top."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until top is golden brown, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

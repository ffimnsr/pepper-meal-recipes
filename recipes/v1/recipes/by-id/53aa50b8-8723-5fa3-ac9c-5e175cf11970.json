  "id": "53aa50b8-8723-5fa3-ac9c-5e175cf11970",
  "slug": "blueberry-pierogi",
  "name": "Blueberry Pierogi",
  "recipe_type": "dessert",
  "brief_description": "Pierogi are best known as savory Polish dumplings but they also make great desserts like this six-ingredient recipe filled with sweetened blueberries.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Place 8 cups flour on a clean work surface; make a well in the center. Crack eggs into well, add butter, and pour in a little warm water; start mixing together, adding a bit more water if needed. Knead dough well, continuing to add more water as needed. Continue kneading until dough is soft and smooth, adding a little more flour only if needed."
    },
    {
      "position": 2,
      "text": "Dust a work surface with flour. Cut dough into 4 pieces; roll out 1 piece to 1/8-inch thickness. Cut dough into circles using a glass or a round pastry cutter."
    },
    {
      "position": 3,
      "text": "Fill each dough circle with 1 teaspoon blueberries; sprinkle with sugar. Fold dough into a half-moon shape; seal edges. Set aside on a tea towel. Repeat with remaining dough, blueberries, and sugar."
    },
    {
      "position": 4,
      "text": "Bring a large pan of salted water to a gentle boil. Add pierogi, in batches; cook until they float to the surface, 5 to 7 minutes, then cook 2 to 3 minutes more. Transfer to a colander with a slotted spoon; drain."
    }
  ],
  "servings": 80,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,

  "id": "f028fc31-6c1e-5709-82ee-a02d877417d4",
  "slug": "classic-canadian-caesar",
  "name": "Classic Canadian Caesar",
  "recipe_type": "drink",
  "brief_description": "This classic Caesar drink is Canada's famous version of a Bloody Mary made with vodka, spices, and clam tomato juice for the perfect brunch cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Wet the rim of a cocktail glass with lime wedge; set lime wedge aside for garnish."
    },
    {
      "position": 3,
      "text": "Place celery salt in a small dish; press the rim of the glass into salt to coat. Add ice to the glass."
    },
    {
      "position": 4,
      "text": "Pour vodka, Worcestershire sauce, and hot pepper sauce over ice."
    },
    {
      "position": 5,
      "text": "Top with tomato-clam juice."
    },
    {
      "position": 6,
      "text": "Garnish with lime wedge and celery stick. Serve with a straw."
    }
  ],
  "servings": 1,

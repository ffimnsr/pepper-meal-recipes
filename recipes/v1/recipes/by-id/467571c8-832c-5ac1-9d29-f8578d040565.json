  "id": "467571c8-832c-5ac1-9d29-f8578d040565",
  "slug": "maple-turkey-brine",
  "name": "Maple Turkey Brine",
  "recipe_type": "dessert",
  "brief_description": "This dark sweet brine, enriched with maple syrup and whiskey, can be used on any kind of poultry and pork. It gives a sweet, maple flavor to meats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 2 quarts of water in a large pot over medium heat, and stir in brown sugar, soy sauce, maple syrup, sea salt, garlic cloves, bay leaves, thyme sprigs, peppercorns, and whiskey. Stir to dissolve brown sugar and salt; bring to a boil. Remove from heat, and stir in remaining 2 quarts of water. Allow brine to cool completely before using."
    }
  ],
  "servings": 18,

  "id": "9ffee886-07c0-539f-ba5c-efdfc52a1c72",
  "slug": "blackened-shrimp-tacos-with-pineapple-recipe-8629864",
  "name": "Blackened Shrimp Tacos with Pineapple",
  "recipe_type": "main",
  "brief_description": "These blackened shrimp tacos with pineapple are bright and summery. Shrimp is grilled with a homemade blackened seasoning, and a delicious grilled fresh pineapple salsa tops them off.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat; lightly oil the grate. Combine paprika, onion powder, oregano, cayenne pepper, garlic salt, and black pepper in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Cut the pineapple lengthwise into wedges. Grill pineapple wedges for 4 to 5 minutes on each side. Chop pineapple and combine in a bowl with red onions, cilantro, fresh lime juice, and salt."
    },
    {
      "position": 3,
      "text": "Thread shrimp onto skewers; brush with melted butter, and coat with seasoning mix. Grill shrimp until they are bright pink on the outside and the meat is opaque, about 3 minutes per side."
    },
    {
      "position": 4,
      "text": "Place tortillas on the hot grill and heat until lightly grilled, 20 to 30 seconds per side."
    },
    {
      "position": 5,
      "text": "Place shrimp on each tortilla and top with pineapple mixture."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

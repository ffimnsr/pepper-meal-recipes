  "id": "bbcf80ee-ebc5-5149-9e3c-665629d152fc",
  "slug": "restaurant-style-hashbrown-casserole",
  "name": "Restaurant-Style Hashbrown Casserole",
  "recipe_type": "soup",
  "brief_description": "This quick and easy hashbrown casserole is made with frozen hashbrown potatoes, chopped onions, a can of cream of chicken soup, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch dish with nonstick cooking spray."
    },
    {
      "position": 3,
      "text": "Gently mix potatoes, soup, cheese, onion, butter, salt, and pepper in a large bowl. Pour into the prepared dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned, about 1 hour."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

  "id": "0108bd9a-6238-556e-8163-3a5e8186289b",
  "slug": "garlic-lovers-pizza-crust-for-the-bread-machine",
  "name": "Garlic Lover's Pizza Crust for the Bread Machine",
  "recipe_type": null,
  "brief_description": "A delicious chewy crust with the wonderful flavor of garlic baked right in! Quick and easy-to-make recipe for the bread machine. The recipe can be doubled to make 2 pizzas.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place the ingredients into the pan of a bread machine in the order recommended by the manufacturer. Close the lid, select the Dough cycle, and press Start."
    },
    {
      "position": 2,
      "text": "When the machine signals the end of the cycle, remove the dough and knead into a tight ball on a lightly floured surface. Let rest for about 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Stretch the dough out to fit your desired pizza pan. Let rise for about 20 minutes for a thicker crust."
    },
    {
      "position": 4,
      "text": "Top with sauce, cheese and desired pizza toppings. Bake for 10 to 20 minutes in the preheated oven, or until the crust is lightly browned on the bottom when you lift up to take a peek."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "92b373d0-410e-5278-9e59-562dee3551a5",
  "slug": "thai-lettuce-cups-with-red-curry-potatoes",
  "name": "Thai Lettuce Cups with Red Curry Potatoes",
  "recipe_type": "appetizer",
  "brief_description": "This Thai-influenced dish combines savory curry roasted potatoes with crunchy fresh vegetables and a light dressing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F. Stir oil and curry paste to blend in large bowl. Add potatoes and toss to coat. Spread potatoes out on heavy large rimmed baking sheet. Roast potatoes until golden and tender, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile: Stir lime juice, sugar and fish sauce to blend in small bowl for sauce."
    },
    {
      "position": 3,
      "text": "Arrange lettuce leaves on platter. Top with carrots, cilantro, green onions and mint, dividing evenly. Spoon potatoes into cups. Serve, passing sauce separately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

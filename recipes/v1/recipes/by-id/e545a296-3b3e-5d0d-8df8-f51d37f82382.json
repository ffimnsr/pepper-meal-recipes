  "id": "e545a296-3b3e-5d0d-8df8-f51d37f82382",
  "slug": "loaded-mashed-potatoes",
  "name": "Loaded Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Loaded mashed potatoes with crispy bacon bits, sour cream, and cheese \u2014 the best parts of a loaded baked potato and mashed potatoes rolled into one!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until crisp and browned, about 10 minutes; drain on paper towels."
    },
    {
      "position": 3,
      "text": "Meanwhile, place potatoes into a large pot of lightly salted water and bring to a boil; reduce heat to medium-low and simmer until tender, about 20 minutes. Drain well and return potatoes to the pot."
    },
    {
      "position": 4,
      "text": "Mash butter into the potatoes using a potato masher or electric hand mixer until well combined. Add sour cream and continue to mash or beat until combined. Crumble bacon into potato mixture; stir in Cheddar cheese and chives. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

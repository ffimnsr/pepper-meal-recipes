  "id": "abb89b6f-f1bf-5ec8-b0a3-61db68031a12",
  "slug": "after-the-holidays-chicken-cordon-bleu-casserole",
  "name": "After the Holidays Chicken Cordon Bleu Casserole",
  "recipe_type": "main",
  "brief_description": "Leftover holiday ham joins chicken and Swiss cheese in this easy cordon bleu casserole that delivers fancy flavor in a comfort food dish that's super simple to throw together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large frying pan over medium heat. Coat the hot pan with olive oil; add chicken and cook until browned on all sides, 5 to 7 minutes. Season with paprika, salt, and pepper. Add onion and garlic; cook until softened, about 5 minutes. Add ham and cook for 2 more minutes."
    },
    {
      "position": 3,
      "text": "Mix condensed soups, sour cream, 1/2 cup Swiss cheese, and chicken broth together in a separate bowl. Add to the chicken mixture and stir until well combined. Transfer to a large casserole dish and top with remaining Swiss cheese."
    },
    {
      "position": 4,
      "text": "Cook in the preheated oven until casserole is cooked through and cheese is melted, 20 to 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

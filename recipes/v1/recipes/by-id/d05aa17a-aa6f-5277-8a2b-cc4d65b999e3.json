{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d05aa17a-aa6f-5277-8a2b-cc4d65b999e3",
  "slug": "baby-back-ribs-smoked-to-perfection",
  "name": "Baby Back Ribs, Smoked to Perfection",
  "recipe_type": "main",
  "brief_description": "With this baby back ribs, smoked to perfection recipe, learn how long it takes to smoke ribs at 250 degrees. It is a variation of the 2-2-1 technique.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 3 fist-sized chunks of wood in a smoker according to manufacturer's directions. Preheat the smoker to 250 degrees F (121 degrees C)."
    },
    {
      "position": 2,
      "text": "While wood burns down, combine salt, black pepper, garlic powder, onion powder, chili powder, and cumin in a bowl; apply to both sides ribs."
    },
    {
      "position": 3,
      "text": "Once thin blue smoke appears, place ribs in the smoker, bone-sides down; smoke for 2 hours."
    },
    {
      "position": 4,
      "text": "Reduce heat to 225 to 250 degrees F (107 to 121 degrees C). Wrap ribs lightly in aluminum foil to retain juices; continue smoking for 1 \u00bd hours more."
    },
    {
      "position": 5,
      "text": "Remove foil; continue to smoke until meat is tender but still stays on the bone, about 1 hour more, brushing lightly with barbecue sauce in the last 15 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 10,

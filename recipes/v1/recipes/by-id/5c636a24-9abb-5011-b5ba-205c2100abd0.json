  "id": "5c636a24-9abb-5011-b5ba-205c2100abd0",
  "slug": "mediterranean-flatbread-recipe-11730877",
  "name": "Mediterranean Flatbread",
  "recipe_type": "appetizer",
  "brief_description": "These Mediterranean flatbreads are packed with fresh flavor, piled with tomatoes, Kalamata olives, red onion, pepperoncini, and feta cheese. They look a little fancy, but are uncomplicated and perfect for a quick meal or appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine olive oil and garlic in a small bowl. Lightly brush a little garlic olive oil over the flatbreads."
    },
    {
      "position": 3,
      "text": "Add tomatoes, olives, onion, and pepperoncini to a bowl; drizzle with remaining garlic olive oil, and gently combine."
    },
    {
      "position": 4,
      "text": "Evenly top flatbreads with the tomato mixture, sprinkle with feta cheese, and place on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake. in the preheated oven until flatbreads are starting to turn golden brown, 12 to 15 minutes. Sprinkle with chopped oregano and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

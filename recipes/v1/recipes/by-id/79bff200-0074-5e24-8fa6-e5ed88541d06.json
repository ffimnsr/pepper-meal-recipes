  "id": "79bff200-0074-5e24-8fa6-e5ed88541d06",
  "slug": "korean-street-toast",
  "name": "Korean Street Toast",
  "recipe_type": "dessert",
  "brief_description": "Chef John's take on Korean street toast features a sweet and savory vegetable patty, ham, and Cheddar sandwiched between crispy, buttery bread.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cabbage, carrot, green onion, salt, pepper, and cayenne with your hands in a bowl until soft, about 30 seconds. Mix in eggs with a fork until thoroughly combined."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a nonstick skillet over medium heat. Add bread slices and flip a few times to make sure both sides are coated with butter. Grill bread until beautifully toasted, golden brown, and a little crispy on both sides. Transfer to a plate."
    },
    {
      "position": 3,
      "text": "Melt remaining 1 tablespoon butter in the same skillet over medium heat. Add cabbage mixture; cook and simultaneously mix by using the edge of a spatula to chop down on the surface while pushing the edges up and over the top. As the mixture starts to hold its shape, form it into a rectangle that's about twice as long as it is wide. Split the rectangle in half into two square patties; continue to cook until golden brown, 1 1/2 to 2 minutes per side."
    },
    {
      "position": 4,
      "text": "Stack patties on top of one another onto one slice of toast and sprinkle with sugar."
    },
    {
      "position": 5,
      "text": "Place ham slices into the hot skillet; cook over medium heat until sizzling, 1 to 2 minutes. Flip and top with Cheddar slice; cook until melted, about 1 minute."
    },
    {
      "position": 6,
      "text": "Place ham and cheese on top of patties; top with ketchup, mayonnaise, and remaining slice of toast. Cut in half and serve."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

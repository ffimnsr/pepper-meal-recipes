  "slug": "cheese-ring",
  "name": "Cheese Ring",
  "recipe_type": "appetizer",
  "brief_description": "This zesty cheese ring recipe includes Cheddar, mayonnaise, green onions, cayenne pepper, and garlic salt. Raspberry preserves add the finishing touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine Cheddar cheese, mayonnaise, green onion, cayenne pepper, and garlic salt in a medium bowl until well blended. Generously coat a ring shaped gelatin mold with cooking spray; spoon cheese mixture into mold, cover, and chill to set for 2 to 3 hours."
    },
    {
      "position": 2,
      "text": "Unmold cheese ring onto a serving plate; pour raspberry preserves into center. Arrange crackers around ring."
    }
  ],
  "servings": 16,

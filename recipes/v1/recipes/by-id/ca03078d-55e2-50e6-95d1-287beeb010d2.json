  "id": "ca03078d-55e2-50e6-95d1-287beeb010d2",
  "slug": "gnocchi-with-tomato-sauce-and-mozzarella",
  "name": "Gnocchi with Tomato Sauce and Mozzarella",
  "recipe_type": "main",
  "brief_description": "Known as 'gnocchi alla sorrentina', this is a classic Italian pasta dish that uses simple ingredients but tastes delicious. Use homemade or bought gnocchi.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a saucepan over medium heat; cook onion until soft and translucent, about 5 minutes. Add passata and salt; simmer over low heat while you prepare the gnocchi."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 4,
      "text": "Pour 1 ladle of tomato sauce into the bottom of a baking dish. Add gnocchi, remaining tomato sauce, and Parmesan cheese; toss to combine. Arrange cubes of mozzarella cheese evenly on top."
    },
    {
      "position": 5,
      "text": "Place baking dish in the oven and broil until mozzarella cheese is melted and sauce has slightly reduced, 5 to 10 minutes. Remove from oven and garnish with basil leaves before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

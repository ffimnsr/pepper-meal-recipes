  "id": "ef9f4222-f3fb-5d51-8bcb-960fa772cfc3",
  "slug": "my-moms-swiss-steak",
  "name": "My Mom's Swiss Steak",
  "recipe_type": "main",
  "brief_description": "This is so easy and all done in one pot! It is delicious and everyone including kids will love it! This recipe is tried and true, impossible to fail! It can also be doubled or tripled without problems, but lower the heat on the second and third batch when browning, as not to burn.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large Dutch oven over medium-high heat. Place steaks into the pot one at a time, quickly browning on each side. Remove steaks, and set aside. Add the onion to the pot, and cook over medium-low heat until wilted, about 3 minutes. Return the steaks to the pot, and add the tomatoes, mushrooms, celery and green pepper. Season with oregano and add the bay leaf."
    },
    {
      "position": 2,
      "text": "Cover the pot, and cook over medium-low heat for about 1 1/2 hours, or until meat is fork tender. If you wish to thicken the gravy, remove the meat to a plate. Stir together the cornstarch and water; stir into the pan juices. Let simmer for about 2 minutes to thicken. Return the beef to the pot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

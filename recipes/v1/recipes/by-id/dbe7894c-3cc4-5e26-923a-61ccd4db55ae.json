  "schema_version": 1,
  "id": "dbe7894c-3cc4-5e26-923a-61ccd4db55ae",
  "slug": "cookie-mold-sugar-cookies",
  "name": "Cookie Mold Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "Sugar cookies for cookie molds. The yield depends upon the size of your cookie molds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter in a mixing bowl with an electric mixer for 1 minute. Add sugar and beat until light and fluffy, about 3 minutes. Add eggs and vanilla; beat for 1 minute. Add flour and salt; beat until combined, about 1 more minute, scraping the sides of the bowl as necessary. Refrigerate dough for 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "When ready to bake, preheat the oven to 375 degrees F (190 degrees C). Spray a cookie mold with floured cooking spray."
    },
    {
      "position": 3,
      "text": "Press chilled dough into the prepared cookie mold. Scrape off excess dough with a knife, so dough is flush with the edge of the mold. Loosen the dough and let it fall onto an ungreased cookie sheet. Repeat to form remaining cookies."
    },
    {
      "position": 4,
      "text": "Bake in batches in the preheated oven until lightly browned, 12 to 15 minutes. Let cool briefly on the cookie sheet before removing to a wire rack to cool."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9bac7932-e26f-5b62-a544-d6d4be537ca8",
  "slug": "smashed-meatball-subs-recipe-11978863",
  "name": "Smashed Meatball Subs",
  "recipe_type": "main",
  "brief_description": "These smashed meatball subs are a quick, cheesy twist on the classic sandwich, with seasoned beef smashed onto the bread and seared until crispy and flavorful. Topped with marinara and melted mozzarella, they come together fast for an easy, crowd-pleasing meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat broiler to high heat."
    },
    {
      "position": 2,
      "text": "Stir together egg, breadcrumbs, milk, Parmesan cheese, onion, and garlic powder in a bowl. Add ground beef and season with salt and pepper. Mix well and spread mixture evenly into a thin layer over the cut sides of the rolls."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet or griddle over medium-high heat. Place rolls, meat side down in the skillet and cook until browned and cooked through, 4 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Flip rolls and top with desired amount of marinara and cheese. Transfer rolls to a rimmed baking sheet and place in the preheated oven under the broiler until cheese is melted and bread is toasted around the edges, about 1 minute."
    },
    {
      "position": 5,
      "text": "Fold rolls to close and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 4,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "ddc695f3-0c56-5c44-b114-bbe15f8bbe6b",
  "slug": "cremini-mushroom-and-rice-soup",
  "name": "Cremini Mushroom and Rice Soup",
  "recipe_type": "soup",
  "brief_description": "Hearty and thick, this easy mushroom soup with rice has a double dose of mushrooms--dried porcini and fresh cremini--which add a meaty texture and satisfying umami flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse dried porcini mushrooms, then mince. Transfer to a large saucepan."
    },
    {
      "position": 2,
      "text": "Add chicken broth, rice, soy sauce, thyme, 1/4 teaspoon salt, and bay leaves to the saucepan; bring to a boil. Reduce heat and simmer until needed."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a large Dutch oven over high heat. Add cremini mushrooms, onion, and 1/4 teaspoon salt; cook until all moisture has evaporated and mushrooms begin to brown, about 10 minutes. Stir in the broth-rice mixture and carrots; bring to a simmer."
    },
    {
      "position": 4,
      "text": "Cook until carrots and rice are tender, 7 to 10 minutes. Turn off heat and remove the bay leaves. Season with salt and pepper and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

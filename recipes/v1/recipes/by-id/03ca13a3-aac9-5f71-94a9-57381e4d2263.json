  "id": "03ca13a3-aac9-5f71-94a9-57381e4d2263",
  "slug": "pear-and-sour-cherry-crisp",
  "name": "Pear and Sour Cherry Crisp",
  "recipe_type": "dessert",
  "brief_description": "This pear and cherry crisp is a delicious mixture of sweet and tart. It's an easy dessert to make for company.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Mix pears, cherries, cornstarch, 2/3 cup sugar, and almond extract in prepared baking dish. Combine flour, 1/3 cup sugar, salt, and nutmeg in a bowl; cut in butter with a knife or pastry blender until mixture resembles coarse crumbs. Sprinkle flour mixture over fruit."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until crust is golden, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

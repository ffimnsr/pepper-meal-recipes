  "id": "f41896f9-eac9-51b4-8f56-24e1e1adc4f5",
  "slug": "trader-joe-s-lobster-casserole-recipe-11794906",
  "name": "Trader Joe's Lobster Casserole",
  "recipe_type": "soup",
  "brief_description": "This lobster casserole takes advantage of Trader Joe's convenient frozen langostino tails and ready-made lobster bisque. It is a delicious, creamy, cheesy rich penne pasta casserole, absolutely fantastic and pretty easy to put together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes."
    },
    {
      "position": 2,
      "text": "Drain penne and return pasta to the pot; place over medium-high heat, and stir in cream cheese and bisque. Season with salt and pepper, and continue to stir until well combined. Remove from heat."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Add butter to a 9x13 baking dish and place into the oven while it preheats until butter is melted."
    },
    {
      "position": 4,
      "text": "Remove baking dish from the oven; add langostino tails and garlic. Toss until garlic is fragrant and golden brown."
    },
    {
      "position": 5,
      "text": "Add penne mixture and tomatoes to the baking dish and carefully toss all the ingredients until combined. Top with cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is melted and casserole is bubbly, 10 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with a squeeze of lemon juice, a sprinkling of Parmesan and fresh parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "931183a5-0226-592e-a9f6-92432bc00362",
  "slug": "jalapeno-popper-butter-swim-cornbread-recipe-12058751",
  "name": "Jalape\u00f1o Popper Butter Swim Cornbread",
  "recipe_type": "side",
  "brief_description": "This jalape\u00f1o popper butter swim cornbread is spicy, buttery, and delicious. It\u2019s incredibly easy to make with boxed mix that gets added pizzazz from pickled jalape\u00f1os, Cheddar cheese, and bacon. You\u2019ll never make cornbread the same way again.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place butter in a square baking dish and microwave until melted, about 1 minute."
    },
    {
      "position": 2,
      "text": "Stir cornbread mix, flour, egg, chopped jalapenos, jalapeno brine, Cheddar cheese, crumbled bacon, and buttermilk together in a bowl, and pour mixture into the buttery baking dish. Use a spatula to spread the thick batter to the edges."
    },
    {
      "position": 3,
      "text": "Use a paring knife to score the dough into 9 squares, cutting through to the bottom. Place a jalapeno slice on each section."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned, and a toothpick inserted near the center comes out clean, 22 to 24 minutes. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "8be8522a-516b-550b-b498-c77a5e69d183",
  "slug": "peanut-butter-blossom-bars-recipe-11857295",
  "name": "Peanut Butter Blossom Bars",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter blossom bars are perfect for everyone who loves peanut butter. Definitely serve with a glass of milk!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking soda, baking powder, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Beat butter and peanut butter together in the bowl of an electric stand mixer fitted with the paddle attachment until well combined, about 1 minute."
    },
    {
      "position": 4,
      "text": "Add 1/2 cup white sugar and the brown sugar; beat on high until light and fluffy, 2 to 3 minutes. Beat in egg and vanilla extract until incorporated."
    },
    {
      "position": 5,
      "text": "Mix in flour mixtures just until combined."
    },
    {
      "position": 6,
      "text": "Press dough evenly into the bottom of the prepared baking pan."
    },
    {
      "position": 7,
      "text": "Sprinkle remaining 2 tablespoons white sugar evenly over the top. Bake until puffed and golden, 16 to 18 minutes."
    },
    {
      "position": 8,
      "text": "Remove from the oven and immediately press chocolate kisses evenly into the top so each bar has one."
    },
    {
      "position": 9,
      "text": "Let cool completely on a wire rack before cutting into bars. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 15,

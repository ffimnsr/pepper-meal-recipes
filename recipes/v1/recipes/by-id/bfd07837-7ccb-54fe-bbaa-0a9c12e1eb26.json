  "id": "bfd07837-7ccb-54fe-bbaa-0a9c12e1eb26",
  "slug": "fall-minestrone-soup",
  "name": "Fall Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "Made with hearty chard and potatoes, this comforting minestrone soup is perfect for chilly fall evenings.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium heat. Add carrots, celery, zucchini, and onion; saute until the vegetables are soft, about 10 minutes. Add garlic and rosemary; cook, stirring so the garlic doesn't burn, for another 2 minutes. Add tomatoes, potatoes, and chard."
    },
    {
      "position": 2,
      "text": "Bring to a simmer and cook until the chard is wilted, about 5 minutes. Add beef stock and beans, bring to a simmer, and cook until potatoes are tender, about 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,

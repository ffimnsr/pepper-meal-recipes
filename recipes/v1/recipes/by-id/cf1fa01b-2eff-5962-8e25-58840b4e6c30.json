  "id": "cf1fa01b-2eff-5962-8e25-58840b4e6c30",
  "slug": "easy-tuna-noodle-casserole",
  "name": "Easy Tuna Noodle Casserole",
  "recipe_type": "soup",
  "brief_description": "If you are looking for an easy tuna noodle casserole from scratch, try this recipe with canned tuna, Cheddar cheese, and fusilli pasta but no canned soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook fusilli in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a saucepan over medium heat. Whisk in flour, stirring constantly for about 1 minute. Remove from heat and gradually pour in milk, whisking constantly the entire time to avoid lumps from forming. Return to heat and cook, stirring constantly, until slightly thickened, about 2 minutes. Stir in 1/2 of the Cheddar cheese. Add lemon juice, mustard powder, salt, and pepper and mix well."
    },
    {
      "position": 4,
      "text": "Drain fusilli and fold into the sauce. Mix in tuna. Pour mixture into an 8-inch casserole dish and sprinkle with breadcrumbs. Top with remaining Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and golden, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

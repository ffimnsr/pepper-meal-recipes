  "id": "f81e653c-dfca-5dff-ac93-a74bc2f357e9",
  "slug": "potato-cakes-with-smoked-salmon-recipe-8780500",
  "name": "Potato Cakes with Smoked Salmon",
  "recipe_type": "appetizer",
  "brief_description": "These potato cakes with smoked salmon are appetizers that feature golden, crispy potato patties made from shredded potatoes and smoked salmon, lightly seasoned and pan-fried to perfection. Each cake is topped with a dollop of sour cream, a slice of smoked salmon, and green onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add grated potatoes, onions and white part of green onion to a large mixing bowl. Stir in eggs and flour until combined."
    },
    {
      "position": 2,
      "text": "Set a small amount of salmon aside for garnish, then stir in salmon and Old Bay seasoning."
    },
    {
      "position": 3,
      "text": "Heat oil in a cast iron skillet over medium heat. Add potato mixture by spoonfuls to the skillet, and flatten with a spatula to make patties. Leave space between potato cakes; you may have to fry in batches."
    },
    {
      "position": 4,
      "text": "Cook until golden brown, 2 to 3 minutes per side. Garnish with remaining smoked salmon, green part of green onion, and sour cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

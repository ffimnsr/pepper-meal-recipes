  "id": "10c7a06c-9df3-5791-ab95-1987a3df2596",
  "slug": "baked-fresh-cherry-pie",
  "name": "Baked Fresh Cherry Pie",
  "recipe_type": "dessert",
  "brief_description": "If you\u2019ve never eaten a fresh cherry pie, you\u2019re in for a treat. It\u2019s a bit of work to pit the cherries, but once this is done, there\u2019s not much left to do to make the filling: just mix the cherries with almond and vanilla extracts, sugar, tapioca, and a pinch of salt.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (205 degrees C). Place bottom crust in pie pan. Set top crust aside, covered."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl combine tapioca, salt, sugar, cherries, and extracts. Let stand 15 minutes. Turn out into bottom crust and dot with butter. Cover with top crust, flute edges and cut vents in top. Place pie on a foil-lined cookie sheet--in case of drips!"
    },
    {
      "position": 3,
      "text": "Bake for 50 minutes in the preheated oven, until golden brown. Let cool for several hours before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "slug": "corn-and-roasted-red-pepper-salad",
  "name": "Corn and Roasted Red Pepper Salad",
  "recipe_type": "salad",
  "brief_description": "This sweet-and-sour corn salad makes a great accompaniment for any Tex-Mex meal.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Combine corn, red wine vinegar, red peppers, cilantro, sugar, olive oil, cumin, red pepper flakes, chili powder, and ginger together in a saucepan; bring to a boil, stirring frequently to dissolve the sugar. Reduce heat to medium-low and cook until the liquid evaporates, about 25 minutes."
    }
  ],

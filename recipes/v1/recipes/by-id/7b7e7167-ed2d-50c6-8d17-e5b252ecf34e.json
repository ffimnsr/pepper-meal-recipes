  "id": "7b7e7167-ed2d-50c6-8d17-e5b252ecf34e",
  "slug": "the-best-vegetarian-chili-recipe-11804690",
  "name": "The Best Vegetarian Chili",
  "recipe_type": "soup",
  "brief_description": "The best vegetarian chili recipe is the only one you will ever need. It makes a big batch, is full of healthy veggies, and just hot enough.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large Dutch oven over medium-high heat. Add onion and cook 2 minutes, stirring often until it begins to soften. Add poblano pepper, jalapeno pepper, bell pepper, carrots, celery, and sweet potatoes and stir to combine."
    },
    {
      "position": 2,
      "text": "Add chili powder, cumin, garlic powder, salt, pepper, and chipotle in adobo and cook, stirring occasionally, 3 minutes."
    },
    {
      "position": 3,
      "text": "Add tomatoes and stock and bring to a boil. Add black beans and chili beans, reduce heat, cover, and simmer until veggies are tender, about 25 minutes. Stir in refried beans and return to a simmer. Cover and cook 15 more minutes, stirring occasionally."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

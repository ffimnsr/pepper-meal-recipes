  "id": "c3dfb831-d528-526d-96fd-6c0fa536ec1b",
  "slug": "aunt-roses-cheese-ball",
  "name": "Aunt Rose's Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "A smooth blend of cheeses, olives, and green onions results in a delicious cheese ball rolled in nuts!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix the cream cheese, Cheddar cheese, blue cheese, butter, olives, green onions, garlic salt, and Worcestershire sauce. Cover, and refrigerate 30 minutes, until firm."
    },
    {
      "position": 2,
      "text": "Form the mixture into 2 balls, and roll in the walnuts to coat."
    }
  ],
  "servings": 16,

  "id": "63919160-2635-5718-9f00-bac9b216942f",
  "slug": "puff-pastry-pizza-poppers-recipe-11886672",
  "name": "Puff Pastry Pizza Poppers",
  "recipe_type": "appetizer",
  "brief_description": "These puff pastry pizza poppers are the best way (probably the only way,?) to enjoy a proper puff pastry pizza. These miniature pizzas are savory, flaky, maximally crispy, and a great party snack. Every bite is textural perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Transfer frozen puff pastry onto a piece of parchment paper. While puff pastry is still nearly frozen, use a 2 1/4-inch round cookie cutter to cut out circles of dough. Transfer cut circles onto the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Once as many circles are cut as possible, stack up 2 or 3 pieces of trimmings together and roll between parchment paper to the original thickness; punch out more circles. Again, chill dough in freezer as needed."
    },
    {
      "position": 4,
      "text": "Making sure dough is still very cold and firm, use a smaller 1 1/2-inch round cookie cutter to punch out a circle in the center of each dough circle. Do not remove the center piece, but carefully push it back into place."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until pastry is light golden brown and puffed, about 20 minutes. Let cool for 5 minutes. Flip each popper over, and generously grate Parmesan on the bottom of each one, covering completely. Flip back over, trapping cheese underneath. Use a teaspoon to firmly press down the center circle of pastry dough, leaving the outside ring of pastry untouched."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 7 minutes. Remove and let cool for about 10 minutes before topping."
    },
    {
      "position": 7,
      "text": "Fill the center of each popper with a generous tablespoon of pizza sauce. Top with mozzarella cheese. Place 1 slice of pepperoni on each and press down lightly with your finger."
    },
    {
      "position": 8,
      "text": "Bake until the edges of pepperoni and cheese start to brown, about 20 minutes."
    },
    {
      "position": 9,
      "text": "Transfer onto a cooling rack and let cool to warm or room temperature before serving, about 10 minutes."
    }
  ],
  "servings": 16,

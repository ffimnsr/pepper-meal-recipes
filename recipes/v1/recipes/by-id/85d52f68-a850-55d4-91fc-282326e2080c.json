  "id": "85d52f68-a850-55d4-91fc-282326e2080c",
  "slug": "tomato-gorgonzola-soup",
  "name": "Tomato Gorgonzola Soup",
  "recipe_type": "soup",
  "brief_description": "Made easy with canned tomatoes, this soup takes its rich, sophisticated flavor from Gorgonzola cheese and a splash of heavy cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a medium saucepan over medium heat. Add the onion, pepper, and garlic; cook and stir 4 to 5 minutes or until vegetables are soft."
    },
    {
      "position": 2,
      "text": "Add the cheeses, cream, and milk; heat mixture until cheeses melt and the mixture is simmering."
    },
    {
      "position": 3,
      "text": "Stir in the tomatoes (including their liquid), tomato juice, basil, sugar, and pepper. Continue to simmer mixture for 15 to 20 minutes while stirring constantly. Do not boil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

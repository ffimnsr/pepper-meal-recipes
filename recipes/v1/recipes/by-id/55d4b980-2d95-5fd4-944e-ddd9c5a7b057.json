  "id": "55d4b980-2d95-5fd4-944e-ddd9c5a7b057",
  "slug": "spicy-pumpkin-pie-ii",
  "name": "Easy Spiced Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This spiced pumpkin pie has a creamy pumpkin filling that's flavored with a generous amount of ground cinnamon, nutmeg, ginger, and cloves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C.)"
    },
    {
      "position": 2,
      "text": "Combine pumpkin puree, milk, cream, brown sugar, and white sugar in a large bowl; mix in cinnamon, salt, nutmeg, ginger, and cloves. Beat in flour and eggs. Pour filling into prepared pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes, then reduce the temperature to 350 degrees F (175 degrees C) and bake until filling has set, about 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

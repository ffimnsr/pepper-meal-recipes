  "id": "091e843d-5a7c-5111-b54b-5a8173a137c1",
  "slug": "shepherds-pie",
  "name": "Simple Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Here is a shepherd's pie, made easy, that your family will love.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Cook beef and onion in 10-inch skillet over medium-high heat until well browned, stirring to break up meat. Pour off fat."
    },
    {
      "position": 2,
      "text": "Stir soup, ketchup, black pepper and peas and carrots into skillet. Spoon beef mixture in 9-inch pie plate."
    },
    {
      "position": 3,
      "text": "Heat milk and butter in 2-quart saucepan over medium-high heat to a boil. Remove from heat. Slowly stir in potatoes. Spoon potatoes over beef mixture."
    },
    {
      "position": 4,
      "text": "Bake at 400 degrees F for 15 minutes or until potatoes are lightly browned."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

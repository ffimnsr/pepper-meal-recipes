  "id": "acb86c70-c387-5852-a2fa-3268c1b83357",
  "slug": "3-ingredient-cake-mix-cobbler",
  "name": "3-Ingredient Cake Mix Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This peach cobbler made with cake mix is a quick and easy recipe with just 3 ingredients for the perfect fruity treat any time of the year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour peaches into a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Sprinkle cake mix on top and pour melted butter all over."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until top of cobbler is golden brown, about 50 minutes."
    }
  ],
  "servings": 8,

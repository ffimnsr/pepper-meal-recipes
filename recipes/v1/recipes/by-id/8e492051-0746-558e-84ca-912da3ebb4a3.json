  "id": "8e492051-0746-558e-84ca-912da3ebb4a3",
  "slug": "trinidads-ponche-de-creme-punch-with-cream",
  "name": "Ponche de Cr\u00e8me (Trinidad's Eggnog)",
  "recipe_type": "drink",
  "brief_description": "Ponche de cr\u00e8me is Trinidad's traditional Christmas drink that's rich, creamy, and generously spiked with rum for a festive drink similar to eggnog.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Beat eggs and lime zest in a large bowl using an electric mixer until light and fluffy."
    },
    {
      "position": 2,
      "text": "Gradually pour in condensed milk while continuing to mix, and then pour in evaporated milk."
    },
    {
      "position": 3,
      "text": "Stir in rum and bitters and sprinkle with nutmeg. Transfer to a bottle and chill for at least 1 hour before serving."
    },
    {
      "position": 4,
      "text": "Serve over crushed ice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

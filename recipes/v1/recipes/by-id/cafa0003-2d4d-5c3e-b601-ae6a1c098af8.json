  "id": "cafa0003-2d4d-5c3e-b601-ae6a1c098af8",
  "slug": "traditional-reuben-casserole",
  "name": "Traditional Reuben Casserole",
  "recipe_type": "main",
  "brief_description": "This mouthwatering Reuben casserole with canned corned beef has similar flavorings as the sandwich for an easy comfort food dish to feed a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix together Thousand island dressing, sour cream, and onion in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Arrange dark and light rye bread cubes in the bottom of the prepared baking dish, reserving about 1/2 cup each for topping. Top bread cubes with corned beef and sauerkraut. Spread dressing mixture evenly over the top. Sprinkle with Swiss cheese, top with reserved bread cubes, and drizzle with melted margarine."
    },
    {
      "position": 4,
      "text": "Bake, covered, in the preheated oven for 15 minutes. Uncover and continue baking until bubbly and lightly browned, about 10 minutes more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "efa64bb8-20a5-5497-b560-6acf60722e5e",
  "slug": "smoked-turkey-collard-green-dip-recipe-8742549",
  "name": "Smoked Turkey Collard Green Dip",
  "recipe_type": "appetizer",
  "brief_description": "This smoked turkey collard green dip with cheese is a creamy, crowd-pleasing hot dip, and a great way to use holiday leftovers. Serve with an assortment of crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat cream cheese and sour cream together in a large bowl with an electric mixer on medium speed until smooth. Fold in collard greens, turkey, 1 1/2 cups cheese, and hot sauce. Transfer to the prepared baking dish and top with remaining 1 cup cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted and golden brown, 20 to 25 minutes. Garnish with smoked paprika and parsley. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6425ca32-6921-5842-8d02-f5a687da5d53",
  "slug": "summer-watermelon-gazpacho",
  "name": "Summer Watermelon Gazpacho",
  "recipe_type": "appetizer",
  "brief_description": "This refreshing summer watermelon gazpacho recipe combines fresh tomato, bell pepper, and seedless cucumber for the perfect cold soup. Garnish with feta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine watermelon, tomatoes, bell pepper, cucumber, shallot, lime juice, vinegar, salt, and black pepper in a high-powered blender; blend until smooth, 20 to 30 seconds. Transfer soup to a bowl; cover with plastic wrap and refrigerate to meld flavors and chill soup, at least 1 hour."
    },
    {
      "position": 2,
      "text": "Stir gazpacho before serving; divide between four bowls. Top servings with feta cheese and cilantro."
    }
  ],
  "servings": 4,

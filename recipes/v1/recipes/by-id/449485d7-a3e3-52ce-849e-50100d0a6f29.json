  "id": "449485d7-a3e3-52ce-849e-50100d0a6f29",
  "slug": "rolled-buttercream-fondant",
  "name": "Rolled Buttercream Fondant",
  "recipe_type": "dessert",
  "brief_description": "This rolled buttercream fondant recipe uses shortening and confectioners' sugar for a buttercream flavor with the appearance of traditional fondant.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, stir together shortening and corn syrup. Mix in salt and vanilla flavoring, then gradually mix in confectioners' sugar until it is a stiff dough. If you are using a stand mixer, use the dough hook attachment. Otherwise, knead by hand. If the dough is sticky, knead in more confectioners' sugar until it is smooth. Store in an airtight container at room temperature or in the refrigerator."
    },
    {
      "position": 2,
      "text": "To use: Roll fondant out on a clean surface that has been dusted with confectioners' sugar until 1/8-inch thick. Drape over frosted and chilled cakes and smooth the sides down, or cut into strips to make bows and other decorations."
    }
  ],
  "servings": 45,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

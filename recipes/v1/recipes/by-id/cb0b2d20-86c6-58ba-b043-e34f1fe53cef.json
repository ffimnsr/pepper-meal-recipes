  "id": "cb0b2d20-86c6-58ba-b043-e34f1fe53cef",
  "slug": "easy-eggless-strawberry-ice-cream",
  "name": "Easy Strawberry Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This strawberry ice cream is egg-free and easy to make with mashed fresh strawberries, milk, and heavy cream for a delightfully fruity frozen dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine mashed strawberries, milk, cream, sugar, vanilla, salt, and food coloring in a large bowl."
    },
    {
      "position": 3,
      "text": "Pour strawberry mixture into the freezer bowl of an ice cream maker; freeze according to the manufacturer's directions."
    },
    {
      "position": 4,
      "text": "Transfer ice cream to an airtight container and freeze until firm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

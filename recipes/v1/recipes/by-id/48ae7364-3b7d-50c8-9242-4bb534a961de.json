  "id": "48ae7364-3b7d-50c8-9242-4bb534a961de",
  "slug": "vegan-butternut-squash-soup-with-almond-milk",
  "name": "Vegan Butternut Squash Soup with Almond Milk",
  "recipe_type": "soup",
  "brief_description": "This pur\u00e9ed vegan butternut squash soup with almond milk recipe includes roasted garlic, saut\u00e9ed onion, and vegetable broth. It's super easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut top \u00bc-inches off garlic cloves; brush with a small amount of olive oil. Wrap in aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until garlic is tender and browned, about 45 minutes. Cool until safe to handle, about 5 minutes; chop."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons olive oil in a 5-quart pot over medium-high heat. Add onion and garlic; saut\u00e9 until onion is translucent, about 5 minutes. Add butternut squash and broth; season with salt and black pepper. Bring to a boil, reduce heat, and simmer until squash is soft, about 30 minutes. Cool soup about 30 minutes."
    },
    {
      "position": 5,
      "text": "Fill blender halfway with soup; add \u00bd cup almond milk. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend for 1 minute. Pour into a pot. Repeat with remaining soup and almond milk. Warm soup over low heat until heated through, about 3 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

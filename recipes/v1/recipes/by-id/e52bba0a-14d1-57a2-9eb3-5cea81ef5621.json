  "id": "e52bba0a-14d1-57a2-9eb3-5cea81ef5621",
  "slug": "baked-panko-breaded-zucchini-fries",
  "name": "Baked Panko-Breaded Zucchini Fries",
  "recipe_type": "side",
  "brief_description": "These breaded zucchini sticks are dipped in egg, coated in panko, Italian seasoning, and Parmesan, then baked for a healthier alternative to fries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Season zucchini with salt; set aside."
    },
    {
      "position": 3,
      "text": "Place beaten eggs in a shallow bowl. Mix together bread crumbs, Parmesan cheese, and Italian seasoning in a second shallow bowl."
    },
    {
      "position": 4,
      "text": "Dip zucchini in beaten eggs, then press into bread crumbs to coat. Gently toss between your hands to remove excess bread crumbs."
    },
    {
      "position": 5,
      "text": "Arrange breaded zucchini in a single layer on the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake zucchini in the preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

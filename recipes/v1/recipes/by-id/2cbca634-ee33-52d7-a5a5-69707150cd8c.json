  "slug": "easy-slow-cooker-bbq",
  "name": "Easy Slow Cooker BBQ",
  "recipe_type": "main",
  "brief_description": "Your favorite barbeque sauce tops tender slow cooked pork in this Boston butt BBQ crockpot recipe, perfect for sandwiches.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork shoulder in the slow cooker. Pour vinegar over pork, coating all sides; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Cook on Low for 10 to 12 hours."
    },
    {
      "position": 3,
      "text": "Transfer pork to a platter. Drain and discard juices from the slow cooker. Chop pork and return to the slow cooker."
    },
    {
      "position": 4,
      "text": "Add barbeque sauce and continue cooking for 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 630,

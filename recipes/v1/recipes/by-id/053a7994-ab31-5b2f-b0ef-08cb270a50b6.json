  "id": "053a7994-ab31-5b2f-b0ef-08cb270a50b6",
  "slug": "spicy-beef-burritos",
  "name": "Spicy Beef Burritos",
  "recipe_type": "main",
  "brief_description": "Warm tortillas are topped with refried beans, seasoned ground beef, and a delicious mix of peppers in these bold and spicy homemade burritos.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix jalapeno peppers, tomato, green chile peppers, green bell pepper, red bell pepper, onion, hot sauce, and cayenne pepper together in a large bowl."
    },
    {
      "position": 2,
      "text": "Cook beef in a large skillet over medium-high heat, stirring to break up clumps, about 5 minutes. Drain excess grease. Add jalapeno pepper mixture and burrito seasoning; cook, covered, stirring occasionally, until flavors combine, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Pour refried beans into a saucepan over medium-low heat. Cook and stir until heated through, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Warm each tortilla in the microwave until soft, 15 to 20 seconds. Spread a layer of refried beans on top. Divide beef mixture among tortillas. Top with lettuce, sour cream, and Cheddar cheese. Fold in opposing edges of each tortilla and roll up into a burrito."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ac4ef56c-c4f6-55a2-ab4a-718574c9ecc0",
  "slug": "jalapeno-popper-cups",
  "name": "Jalapeno Popper Cups",
  "recipe_type": "appetizer",
  "brief_description": "Mini phyllo cups filled with a creamy, cheesy jalapeno filling are a more sophisticated version of the jalapeno popper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Place phyllo cups onto a baking sheet."
    },
    {
      "position": 2,
      "text": "Stir together cream cheese, Cheddar cheese, jalapenos, and hot sauce in a bowl. Spoon mixture into phyllo cups. Sprinkle bacon bits on top. Bake in preheated oven until golden brown, about 15 to 20 minutes. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,

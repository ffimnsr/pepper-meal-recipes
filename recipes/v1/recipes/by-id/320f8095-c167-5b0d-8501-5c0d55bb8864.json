  "id": "320f8095-c167-5b0d-8501-5c0d55bb8864",
  "slug": "spinach-ricotta-quiche",
  "name": "Spinach Ricotta Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This spinach and ricotta quiche is creamy, cheesy, and full of flavor \u2014 it tastes like it came from your local bakery! Serve it for any meal of the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Press pie pastry into a 9-inch deep-dish pie pan; prick all over the bottom with a fork."
    },
    {
      "position": 2,
      "text": "Bake crust in the preheated oven for 10 minutes. Remove from the oven and let cool until needed."
    },
    {
      "position": 3,
      "text": "While the crust is cooling, melt butter in a skillet over medium heat; add onion and cook for 1 minute. Stir in spinach and cook until starting to wilt, about 1 minute. Cover and cook until condensation builds inside the skillet, about 1 minute. Remove the lid, stir to combine, and turn off the heat."
    },
    {
      "position": 4,
      "text": "Blend ricotta, cream, Parmigiano-Reggiano, eggs, basil, salt, and pepper in a blender or food processor until smooth."
    },
    {
      "position": 5,
      "text": "Spread spinach mixture evenly over crust, then pour in ricotta and egg mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the center is set and the top is lightly browned, about 40 minutes. Let stand for 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

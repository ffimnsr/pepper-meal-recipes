  "id": "449e894a-f21b-5010-b9ed-27aa589a39eb",
  "slug": "cheesy-italian-tortellini",
  "name": "Cheesy Italian Tortellini",
  "recipe_type": "main",
  "brief_description": "A delicious marinara sauce is cooked all day in the slow cooker. When it's time for dinner, throw in some tortellini, and sprinkle with cheese. When the noodles are cooked, pass around the bread, and enjoy!",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and Italian sausage in the hot skillet until crumbly and browned, about 10 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Combine ground meats, marinara sauce, tomatoes, and mushrooms in a slow cooker. Cover and cook on Low for 7 to 8 hours."
    },
    {
      "position": 3,
      "text": "Stir tortellini into marinara meat sauce. Sprinkle with mozzarella and Cheddar cheese. Cover and cook on Low until tortellini is tender, about 15 more minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 445,

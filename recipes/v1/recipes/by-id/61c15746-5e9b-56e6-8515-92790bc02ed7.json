  "id": "61c15746-5e9b-56e6-8515-92790bc02ed7",
  "slug": "bread-and-butter-pudding",
  "name": "Bread and Butter Pudding",
  "recipe_type": "dessert",
  "brief_description": "Bread and butter pudding is a deliciously easy way to use up bread by combining it with a rich custard, dried fruit, and warm spices for a cozy dessert.",
  "cuisine": "English British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round pie dish or cake pan."
    },
    {
      "position": 2,
      "text": "Butter bread on both sides and cut into triangles. Arrange a single layer of buttered bread in the bottom of the prepared pan, slightly overlapping the triangles."
    },
    {
      "position": 3,
      "text": "Sprinkle with 1/2 of the sugar and 1/2 cup currants. Arrange remaining bread on top, then sprinkle with remaining sugar."
    },
    {
      "position": 4,
      "text": "Beat milk, eggs, and nutmeg together in a bowl. Pour over bread and press down firmly to compress pudding and help bread absorb milk mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and set, about 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

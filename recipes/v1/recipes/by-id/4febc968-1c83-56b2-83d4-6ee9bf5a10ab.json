  "id": "4febc968-1c83-56b2-83d4-6ee9bf5a10ab",
  "slug": "million-dollar-baked-beans-recipe-8749108",
  "name": "Million Dollar Baked Beans",
  "recipe_type": "side",
  "brief_description": "These million dollar baked beans are amped up with crispy bacon, sausage, brown sugar, mustard, and molasses, baked until bubbling and caramelized.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Cook bacon in a large skillet over medium heat until crisp, turning occasionally, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Remove bacon from pan, draining all but two tablespoons of bacon fat from the skillet."
    },
    {
      "position": 5,
      "text": "Add ground pork, onion, and bell pepper to the skillet with the reserved bacon fat. Cook over medium heat until meat is browned and cooked through, stirring occasionally, 8 to 10 minutes."
    },
    {
      "position": 6,
      "text": "Stir baked beans, ketchup, brown sugar, mustard, molasses, Worcestershire sauce, and vinegar together in a large bowl."
    },
    {
      "position": 7,
      "text": "Add pork mixture and 1/2 cup of the bacon to the bowl. Stir to combine."
    },
    {
      "position": 8,
      "text": "Transfer to the prepared baking dish."
    },
    {
      "position": 9,
      "text": "Sprinkle with remaining bacon."
    },
    {
      "position": 10,
      "text": "Bake until bubbling and the top is caramelized, 55 to 60 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

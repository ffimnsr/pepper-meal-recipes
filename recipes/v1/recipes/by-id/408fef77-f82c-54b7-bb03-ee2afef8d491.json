  "id": "408fef77-f82c-54b7-bb03-ee2afef8d491",
  "slug": "applesauce-custard-pie",
  "name": "Applesauce Custard Pie",
  "recipe_type": "dessert",
  "brief_description": "Simple and delicious, this recipe makes this pie just a bit different from traditional apple pie. Applesauce, eggs, sugar, butter and vanilla are stirred up and poured into an unbaked pie shell. A bit of nutmeg is sprinkled on the top and it 's baked until the custard is set.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium mixing bowl combine butter or margarine, sugar, and eggs. Beat until smooth. Add applesauce and vanilla. Mix thoroughly."
    },
    {
      "position": 3,
      "text": "Pour custard mixture into pie shell. Sprinkle top lightly with cinnamon."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 30 to 40 minutes or until set in center."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

  "id": "1af7575c-d5fa-523a-83cb-fed84d790cc8",
  "slug": "yellowhammer-jell-o-shots-recipe-12014099",
  "name": "Yellowhammer Jell-O Shots",
  "recipe_type": "drink",
  "brief_description": "The Yellowhammer is an iconic Alabama gameday cocktail. This recipe takes the beloved pineapple-orange drink and converts it to a form that\u2019s easy to transport and fun to eat. For a unique twist on the classic Jell-O shot, hollow orange halves are used in place of a plastic container.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Squeeze the juice from each orange half to yield 3/4 cup. Use a spoon to scrape the flesh from each orange half in order to hollow them out. Transfer halves, cut side up, to a muffin pan or small rimmed baking sheet."
    },
    {
      "position": 2,
      "text": "Combine the orange juice and pineapple juice in a small saucepan. Sprinkle the gelatin on top and allow it to sit, undisturbed, for 5 minutes."
    },
    {
      "position": 3,
      "text": "Warm the juice mixture over medium-low heat, whisking until the gelatin is dissolved, about 3 minutes (do not allow it to boil). Remove from heat and pour in the vodka, rum, and amaretto."
    },
    {
      "position": 4,
      "text": "Pour mixture into 7 of the prepared orange halves. Transfer to the refrigerator and let set until firm, about 4 hours."
    },
    {
      "position": 5,
      "text": "To serve, cut each orange in half again to yield 14 slices."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

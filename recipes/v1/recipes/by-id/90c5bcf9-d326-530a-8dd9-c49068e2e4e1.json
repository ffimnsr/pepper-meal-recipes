  "id": "90c5bcf9-d326-530a-8dd9-c49068e2e4e1",
  "slug": "panini-sandwiches",
  "name": "Panini Sandwiches",
  "recipe_type": "main",
  "brief_description": "Turkey and Swiss cheese panini with sundried tomato mayonnaise made with dinner rolls are quick and delicious!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat grill pan or panini machine to medium heat."
    },
    {
      "position": 2,
      "text": "Spread center of each roll with 1 tablespoon mayonnaise. Assemble sandwiches with remaining ingredients, except butter. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Spread small amount of butter on top and bottom of each roll; place sandwich either in pan on onto panini machine and grill. Cook 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "(If using a pan, press sandwich down with a pan lid. Cook sandwiches about 3 to 4 minutes on each side or until bread is toasted.)"
    },
    {
      "position": 5,
      "text": "For mayonnaise: whisk all ingredients together in small bowl. Refrigerate until ready to use."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

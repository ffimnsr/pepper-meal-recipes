  "id": "f4899c14-d82f-59ea-9cf1-41c5ae5bf6ac",
  "slug": "southern-green-beans",
  "name": "Southern Green Beans",
  "recipe_type": "side",
  "brief_description": "These Southern green beans cooked with potatoes get great flavor from onion saut\u00e9ed in butter, crisp bacon, and a splash of white balsamic vinegar.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook chopped bacon in a skillet over medium heat, stirring occasionally, until evenly browned, 8 to 10 minutes. Drain bacon pieces on a paper towel-lined plate."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet with a lid over medium-low heat. Add onion; cook and stir until onion is translucent, about 5 minutes. Stir in cooked bacon, green beans, potatoes, garlic, and chicken broth."
    },
    {
      "position": 4,
      "text": "Bring to a boil, cover, and simmer over low heat until green beans are tender, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Sprinkle with vinegar, salt, and pepper; serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

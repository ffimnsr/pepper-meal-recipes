  "id": "8ffe4877-620e-51b2-9812-4462d14a6afc",
  "slug": "air-fryer-roasted-broccoli-and-cauliflower",
  "name": "Air Fryer Roasted Broccoli and Cauliflower",
  "recipe_type": "side",
  "brief_description": "This air fryer broccoli and cauliflower recipe produces perfectly roasted broccoli and cauliflower for a fast, easy, and tasty vegan side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place broccoli florets in a large, microwave-safe bowl. Cook in the microwave at full power for 3 minutes; drain any accumulated liquid."
    },
    {
      "position": 3,
      "text": "Add cauliflower, olive oil, garlic powder, sea salt, paprika, and black pepper to the bowl with broccoli; mix well to combine. Pour mixture into the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 12 minutes, tossing vegetables halfway through cooking time for even browning."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

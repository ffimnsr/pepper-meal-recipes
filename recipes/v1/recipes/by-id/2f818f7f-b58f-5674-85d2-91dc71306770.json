  "id": "2f818f7f-b58f-5674-85d2-91dc71306770",
  "slug": "potato-salad-with-chives",
  "name": "Potato Salad with Chives",
  "recipe_type": "salad",
  "brief_description": "This potato salad with chives recipe makes an easy, simple, potato side dish with a creamy and deliciously light oniony flavor from the fresh chives.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a medium saucepan; fill with just enough water to cover. Bring to a boil, then reduce heat to low; simmer until tender, about 10 minutes. Drain; cool under cold running water."
    },
    {
      "position": 2,
      "text": "Combine sour cream, \u00bd cup chives, and mayonnaise in a large bowl; fold in potatoes. Season with salt and black pepper; garnish with remaining \u00bd cup chives."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

  "id": "87d92bf5-34e1-5318-8950-84c5b5ac9b08",
  "slug": "overnight-apple-cinnamon-french-toast",
  "name": "Overnight Apple Cinnamon French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Overnight apple cinnamon French toast, made with apple pie filling, cinnamon, and white bread, is a great brunch recipe \u2014 perfect for large gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Stir brown sugar, melted butter, and cinnamon together in a small bowl; spread into the prepared pan. Spread apple pie filling evenly over top, then layer on bread slices, pressing down as you go."
    },
    {
      "position": 3,
      "text": "Beat milk, eggs, and vanilla together in a bowl; slowly pour over bread, making sure egg mixture is completely absorbed. Cover pan with aluminum foil; refrigerate 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, covered, for 1 to 1 \u00bc hours. Turn on the broiler. Uncover pan; drizzle maple syrup on top. Broil until syrup begins to caramelize, 2 minutes. Remove from oven; let stand for 10 minutes, then cut into squares. Invert pan onto a serving tray or baking sheet so apple filling is on top. Serve hot."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

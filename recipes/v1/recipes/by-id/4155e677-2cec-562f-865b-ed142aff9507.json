  "id": "4155e677-2cec-562f-865b-ed142aff9507",
  "slug": "lunch-lady-texas-goulash",
  "name": "Lunch Lady Texas Goulash",
  "recipe_type": "soup",
  "brief_description": "Full of delicious grown-up flavor but reminiscent of school lunch days, this favorite goulash will bring back childhood memories.",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir ground beef, bell pepper, and onion in a large pot over medium-high heat until beef is browned and crumbly and vegetables are soft, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Pour pinto beans into a saucepan and cook over medium heat until heated through, about 5 minutes. Stir in tomato paste."
    },
    {
      "position": 3,
      "text": "Combine 2 cups plus 2 tablespoons water, chili powder, sugar, salt, and pepper in a small bowl; stir into the beef mixture. Add pinto bean mixture. Cover and simmer for 20 minutes."
    },
    {
      "position": 4,
      "text": "While goulash cooks, bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 5,
      "text": "Mix cooked macaroni into the goulash, cover, and simmer for 30 minutes to 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

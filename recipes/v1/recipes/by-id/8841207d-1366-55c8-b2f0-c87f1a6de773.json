  "id": "8841207d-1366-55c8-b2f0-c87f1a6de773",
  "slug": "best-buttercream-frosting",
  "name": "Best Buttercream Frosting",
  "recipe_type": "dessert",
  "brief_description": "Buttercream frosting with granulated sugar instead of confectioners\u2019! Made with a thick roux that\u2019s cooled and beaten into whipped butter and sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk milk and flour together in a small saucepan over medium-low heat until mixture starts to thicken, 4 to 5 minutes. Then, whisk vigorously until mixture is lump-free, creamy, sticky, and significantly thicker, 2 to 3 more minutes; it may appear to ball up. Immediately remove from the heat and transfer to a plate; let cool to room temperature."
    },
    {
      "position": 2,
      "text": "While the milk mixture is cooling, beat butter and sugar in a mixing bowl with an electric mixer for at least 10 minutes. Mixture should be very fluffy; you may need to mix for 5 more minutes. Gradually mix in cooled milk mixture on high speed; continue to mix until fluffy and smooth. Mix in vanilla."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate until frosting reaches a spreading consistency, about 30 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

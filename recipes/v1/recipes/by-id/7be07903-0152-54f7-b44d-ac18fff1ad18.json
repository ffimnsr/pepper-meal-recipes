  "slug": "watermelon-serrano-salsa-recipe-8601115",
  "name": "Watermelon-Serrano Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Dip and dollop with this sweet and spicy watermelon-serrano salsa. Try this fruit salsa with chips or served over grilled fish.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together tomatoes, watermelon, red onion, lime juice, cilantro, serrano pepper, salt, and black pepper in a bowl. Serve immediately or chill, covered, up to 2 hours."
    }
  ],
  "servings": 4,

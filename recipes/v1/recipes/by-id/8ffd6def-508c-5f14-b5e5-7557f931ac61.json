  "id": "8ffd6def-508c-5f14-b5e5-7557f931ac61",
  "slug": "grilled-polenta-bites-with-black-bean-salsa",
  "name": "Grilled Polenta Bites with Black Bean Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Grilled polenta rounds are crispy on the outside, tender on the inside, and topped with a fresh black bean salsa for a light and refreshing appetizer in the hot summer months.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine black beans, tomato, onion, jalapeno, cilantro, lime juice, and 1 teaspoon salt in a bowl. Stir to combine. Set aside."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Lay polenta rounds on a clean work surface and brush the tops with olive oil. Flip the rounds over and brush the other side with olive oil. Lightly season one side."
    },
    {
      "position": 4,
      "text": "Grill polenta rounds for 5 minutes. Using a spatula, flip them over and grill for 5 minutes longer. Top with black bean salsa just before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

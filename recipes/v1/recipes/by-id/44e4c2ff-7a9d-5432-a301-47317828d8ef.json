  "id": "44e4c2ff-7a9d-5432-a301-47317828d8ef",
  "slug": "black-olive-and-rosemary-focaccia",
  "name": "Black Olive and Rosemary Focaccia",
  "recipe_type": "appetizer",
  "brief_description": "Serve this crispy, rich, rosemary-scented focaccia as an appetizer, hors d'oeuvre, or as a wonderful tasting change from pizza.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together the water, sugar, and yeast until dissolved, allow to stand for 5 minutes. Stir in 2 tablespoons olive oil, 1/4 cup rosemary, flour, and salt until a dough forms. Turn onto a lightly floured surface, and knead until smooth and elastic, about 10 minutes. Gently knead in the black olives during the last few minutes of kneading. Place into a lightly oiled bowl, cover with a towel, and let rise in a warm place until almost doubled in bulk, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet, or sprinkle liberally with corn meal."
    },
    {
      "position": 3,
      "text": "Deflate dough, and press into prepared baking sheet. Brush dough with 1 tablespoon olive oil. Toss sliced tomatoes, and garlic with remaining 2 tablespoons olive oil. Season with 2 tablespoons minced rosemary, salt, and pepper. Arrange the tomato slices over the dough in an even layer. Sprinkle with grated cheese."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until puffed and golden brown; 15 to 20 minutes. Cut into squares and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 50,
  "rest_time_minutes": null,
  "difficulty": "medium",

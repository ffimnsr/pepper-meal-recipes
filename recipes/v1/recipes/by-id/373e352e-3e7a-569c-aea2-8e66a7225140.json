  "id": "373e352e-3e7a-569c-aea2-8e66a7225140",
  "slug": "harissa-egg-salad",
  "name": "Harissa Egg Salad",
  "recipe_type": "salad",
  "brief_description": "Boiled eggs, avocado, and harissa are stars in this spicy twist on a classic. Serve on toast or try in lettuce leaves for a refreshing touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1/2 the avocado and lime juice in a bowl. Mash with a fork. Scoop egg yolks into the bowl. Add harissa, mayonnaise, and mustard. Mix until creamy. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Add cornichons, radishes, and onion to the bowl. Mix to coat the vegetables."
    },
    {
      "position": 3,
      "text": "Coarsely chop remaining avocado and egg whites. Fold into salad mixture in the bowl, taking care to leave some chunks of avocado. Top with cilantro and paprika before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

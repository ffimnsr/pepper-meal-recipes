  "id": "864483dc-1bc7-571e-bc1e-50c763dd1904",
  "slug": "easy-breakfast-casserole-recipe-11864265",
  "name": "This Easy Breakfast Casserole Will Save Your Holidays",
  "recipe_type": "breakfast",
  "brief_description": "This easy breakfast casserole is the perfect dish for family and friends during the holidays. For an even easier morning, you can prepare the casserole the night before and bake it off in the morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Butter a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Set aside to cool slightly."
    },
    {
      "position": 3,
      "text": "Add butter to a griddle over medium-high heat; spread potatoes in an even layer, and cook until golden, 5 to 6 minutes per side. Add potatoes to the bottom of the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Whisk eggs and cream together in a large bowl. Whisk in dry mustard and season with salt and pepper. Stir sausage and 8 ounces Cheddar cheese into eggs. Pour mixture over potatoes, and smooth out the top. Cover the dish tightly with foil or an oven-safe lid."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until eggs are nearly set, 30 to 40 minutes. Remove from the oven, remove foil, and scatter remaining cheese over the top."
    },
    {
      "position": 6,
      "text": "Return casserole to the oven and bake until eggs are no longer jiggly, about 10 minutes. Turn the oven up to Broil, and broil until top is browned and crispy, a few minutes more."
    },
    {
      "position": 7,
      "text": "Serve immediately with hot sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

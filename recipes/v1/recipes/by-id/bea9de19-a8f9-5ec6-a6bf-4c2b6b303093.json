{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bea9de19-a8f9-5ec6-a6bf-4c2b6b303093",
  "slug": "bourbon-bbq-glazed-baby-back-ribs",
  "name": "Bourbon-BBQ Glazed Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "Baby back ribs are glazed with bourbon barbecue sauce. The recipe is made with molasses, ketchup, vinegar, Dijon, Worcestershire sauce, and brown sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 tablespoons brown sugar, 1 tablespoon sea salt, 1 tablespoon black pepper, garlic powder, \u00be teaspoon onion powder, coriander, dry mustard, and cayenne pepper in a small bowl; set rub aside."
    },
    {
      "position": 2,
      "text": "Tear a large enough piece aluminum foil to fully cover rib rack; place rib rack on foil, meat side up. Evenly coat both sides of ribs with dry rub, pressing it in with your hands."
    },
    {
      "position": 3,
      "text": "Fold up sides of the foil to create a rim; pour apple juice around rib rack. Fold foil over ribs; crimp to create a tight seal. Tear a larger piece of foil; wrap foil rib bundle again to ensure a tight seal."
    },
    {
      "position": 4,
      "text": "Marinate wrapped ribs in the refrigerator for 2 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 225 degrees F (110 degrees C)."
    },
    {
      "position": 6,
      "text": "Cook ribs in the preheated oven until easily pierced with a fork, but not falling off the bone, about 4 hours. Unwrap ribs."
    },
    {
      "position": 7,
      "text": "Meanwhile, combine ketchup, bourbon, cider vinegar, Worcestershire sauce, Dijon mustard, 1 \u00bd tablespoons brown sugar, molasses, soy sauce, 1 teaspoon onion powder, 1 teaspoon black pepper, minced garlic, and 1 pinch salt in a medium saucepan over medium heat; bring to a boil. Reduce to a simmer; simmer until sauce thickens and reduces by about \u2153, stirring occasionally."
    },
    {
      "position": 8,
      "text": "Preheat an outdoor grill to high heat and cover the grate with aluminum foil."
    },
    {
      "position": 9,
      "text": "Place cooked ribs, meat side up, on the grill; brush top with 1 layer sauce. Close grill; cook until sauce is mostly dried, about 5 minutes. Brush another layer sauce on top; close grill and cook 5 minutes more. Transfer ribs to a cutting board; lightly brush with 1 layer sauce."
    },
    {
      "position": 10,
      "text": "Cut ribs into individual pieces; serve with remaining sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 250,
  "preparation_time_minutes": 15,

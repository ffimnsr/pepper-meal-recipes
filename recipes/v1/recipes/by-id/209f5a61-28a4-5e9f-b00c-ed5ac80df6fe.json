  "slug": "cool-whipped-frosting",
  "name": "Cool Whipped Frosting",
  "recipe_type": "dessert",
  "brief_description": "A light cool whip frosting that resembles Bavarian cream. Easy to mix up and serve as a topping on cakes, cupcakes, and more \u2014 just like the bakery.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine pudding mix with milk and vanilla in a medium bowl. Mix until smooth."
    },
    {
      "position": 3,
      "text": "Gently fold in whipped topping until no streaks remain. Spread evenly over cake."
    }
  ],

  "id": "24d20a68-da4c-55e5-932b-21074e77b4b6",
  "slug": "grandmas-lace-cookies",
  "name": "Grandma's Lace Cookies",
  "recipe_type": "dessert",
  "brief_description": "These delicate lace cookies are made with butter and oats and flavored with vanilla for an easy-to-make sweet treat, perfect for afternoon tea.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil and grease with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat butter in a microwave-safe bowl in the microwave until melted."
    },
    {
      "position": 3,
      "text": "Add sugar and stir to combine. Add beaten egg and mix well. Stir in oats, flour, vanilla, salt, and baking powder."
    },
    {
      "position": 4,
      "text": "Drop spoonfuls of dough 3 inches apart onto the prepared baking sheet as the dough will spread."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are golden brown, about 8 minutes."
    },
    {
      "position": 6,
      "text": "Let cookies cool completely before removing them from the baking sheet."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

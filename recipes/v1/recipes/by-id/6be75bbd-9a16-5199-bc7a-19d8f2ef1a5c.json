  "id": "6be75bbd-9a16-5199-bc7a-19d8f2ef1a5c",
  "slug": "moussaka-cottage-pie",
  "name": "Moussaka Cottage Pie",
  "recipe_type": "main",
  "brief_description": "One nice feature of this dish is that you can cook and bake the pie in the same skillet.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 Tbs. oil in a 12-inch ovenproof skillet over medium-high heat. Saute onions until tender, about 5 minutes. Add garlic, cinnamon and cloves; cook about 1 minute. Add meat, stirring to break it up, and cook about 5 minutes. Stir in tomatoes and raisins; simmer 10 minutes."
    },
    {
      "position": 2,
      "text": "Arrange eggplant slices on a lipped cookie sheet. Brush both sides with remaining oil, and season with salt and pepper. Broil on upper oven rack, turning once with kitchen tongs, until golden brown, about 5 minutes per side."
    },
    {
      "position": 3,
      "text": "Reduce heat to 400 degrees. Lay eggplant in a single layer over meat mixture. Whisk egg into mashed potatoes; spread over eggplant. Bake on lower rack until sauce is bubbly, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "hard",

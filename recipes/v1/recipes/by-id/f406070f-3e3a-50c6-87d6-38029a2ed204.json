  "id": "f406070f-3e3a-50c6-87d6-38029a2ed204",
  "slug": "dashs-donair",
  "name": "Dash's Donair",
  "recipe_type": "dessert",
  "brief_description": "This donair recipe is made with boldly spiced ground beef, baked, and then sliced for an authentic Halifax meat sandwich with a sweet garlic sauce.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Make loaf: Mix together salt, oregano, flour, black pepper, Italian seasoning, garlic powder, onion powder, and cayenne pepper in a cup or small bowl."
    },
    {
      "position": 3,
      "text": "Place ground beef in a large steel mixing bowl on a sturdy surface; use your hands to blend in spice mixture. Pick up meat and throw it down with force about 20 times, kneading it after each throw. This will help meat hold together better when sliced."
    },
    {
      "position": 4,
      "text": "Form meat into a loaf; place on a broiler pan or baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour and 15 minutes, rotating loaf halfway through to ensure even baking. Serve warm with sauce or allow meat to chill before slicing and reheating."
    },
    {
      "position": 6,
      "text": "Make sauce: Mix together evaporated milk, sugar, and garlic powder in a medium bowl. Gradually whisk in white vinegar, 1 teaspoon at a time, until thickened to your desired consistency."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

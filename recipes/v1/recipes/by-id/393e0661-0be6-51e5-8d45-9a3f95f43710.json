  "id": "393e0661-0be6-51e5-8d45-9a3f95f43710",
  "slug": "southern-pecan-pie-bars",
  "name": "Southern Pecan Pie Bars",
  "recipe_type": "dessert",
  "brief_description": "Classic Southern pecan pie, with its sticky, nutty filling, gets simplified into easy-to-eat bars featuring a crunchy shortbread crust.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper, leaving a 2-inch overhang on at least 2 sides. Spray the parchment paper with baking spray."
    },
    {
      "position": 2,
      "text": "Combine flour, butter, powdered sugar, and salt in a food processor and pulse 6 or 7 times to combine. Transfer mixture to the lined pan and press into an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly golden brown, about 20 minutes. Transfer pan to a wire rack."
    },
    {
      "position": 4,
      "text": "Combine eggs, brown sugar, melted butter, flour, and salt together in a large bowl. Mix in syrup until well combined. Stir in pecans. Pour over the still-warm shortbread crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is set, 25 to 30 minutes. Cool completely in the pan for at least 1 hour. Run a knife around the edge of the pan and pull out using the parchment overhang. Slice into bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

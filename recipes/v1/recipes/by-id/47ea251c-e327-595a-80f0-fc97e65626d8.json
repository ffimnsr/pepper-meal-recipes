  "id": "47ea251c-e327-595a-80f0-fc97e65626d8",
  "slug": "meyer-lemon-and-blueberry-cheese-tart",
  "name": "Meyer Lemon and Blueberry Cheese Tart",
  "recipe_type": "dessert",
  "brief_description": "A creamy mascarpone and lemon curd filling is topped with a fresh blueberry sauce in this summery dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Thoroughly mix crushed lemon cookies and butter together in a bowl."
    },
    {
      "position": 2,
      "text": "Press cookie mixture into the bottom of an 8-inch springform pan."
    },
    {
      "position": 3,
      "text": "Place blueberries and sugar in a saucepan over medium-low heat; simmer until sugar has dissolved and a thin sauce forms, 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir cornstarch into blueberry sauce; simmer until sauce has thickened, about 10 minutes. Remove from heat and cool for 10 minutes."
    },
    {
      "position": 5,
      "text": "Stir mascarpone, lemon curd, and whipped topping together in a bowl until well blended and smooth."
    },
    {
      "position": 6,
      "text": "Spread mascarpone mixture over the crust in the springform pan. Cover with waxed paper and freeze until semi-firm, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Spread blueberry sauce over mascarpone layer; cover with waxed paper and refrigerate until set, at least 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

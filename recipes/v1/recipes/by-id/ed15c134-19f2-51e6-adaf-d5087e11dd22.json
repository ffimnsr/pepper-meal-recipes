  "id": "ed15c134-19f2-51e6-adaf-d5087e11dd22",
  "slug": "prickly-pear-cactus-margarita",
  "name": "Prickly Pear Margarita",
  "recipe_type": "dessert",
  "brief_description": "A prickly pear margarita is a unique and refreshing cocktail made with tequila, lime juice, and prickly pear syrup for a delicious sweet-tart flavor.",
  "cuisine": "Mexican Inspired South American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour salt onto a small plate. Wet the rim of a margarita glass and dip rim into salt."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice; pour tequila, sweet and sour mix, triple sec, lime juice, and prickly pear syrup over ice. Cover shaker and shake vigorously; strain into prepared margarita glass."
    }
  ],

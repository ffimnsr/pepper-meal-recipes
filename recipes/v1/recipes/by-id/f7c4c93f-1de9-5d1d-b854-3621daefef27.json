  "id": "f7c4c93f-1de9-5d1d-b854-3621daefef27",
  "slug": "moist-chocolate-muffins",
  "name": "Moist Chocolate Muffins",
  "recipe_type": "dessert",
  "brief_description": "Chocolate muffins made with cocoa and chocolate chips are full of chocolaty goodness. A little plain yogurt in the batter makes them super moist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, \u00be cup chocolate chips, cocoa powder, and baking soda in a large bowl."
    },
    {
      "position": 4,
      "text": "Whisk yogurt, milk, oil, egg, and vanilla extract together in separate bowl until smooth."
    },
    {
      "position": 5,
      "text": "Pour yogurt mixture into the chocolate mixture and stir until batter is just blended."
    },
    {
      "position": 6,
      "text": "Divide batter among the prepared muffin cups, filling each \u00be full; sprinkle with remaining \u00bc cup chocolate chips."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 20 minutes. Cool in the tin for 10 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

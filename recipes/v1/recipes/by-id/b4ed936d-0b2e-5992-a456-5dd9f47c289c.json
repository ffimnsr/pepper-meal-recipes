  "id": "b4ed936d-0b2e-5992-a456-5dd9f47c289c",
  "slug": "chicken-alfredo",
  "name": "Chicken Alfredo",
  "recipe_type": "main",
  "brief_description": "A quick and easy chicken Alfredo dinner with broccoli, zucchini, and red bell pepper. The sauce is enriched by cream cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta, and cook for 8 to 10 minutes, or until al dente; drain."
    },
    {
      "position": 2,
      "text": "While pasta is cooking, melt cream cheese and butter in a skillet over low heat. Stir until smooth. Stir in milk, and season with garlic powder, salt, and pepper. Simmer for 3 minutes, or until thickened, stirring constantly."
    },
    {
      "position": 3,
      "text": "Mix in chicken, broccoli, zucchini, and red pepper. Cook 3 minutes over medium heat, then reduce heat, and simmer 5 minutes, or until vegetables are tender. Serve hot over fettuccine and top with grated Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

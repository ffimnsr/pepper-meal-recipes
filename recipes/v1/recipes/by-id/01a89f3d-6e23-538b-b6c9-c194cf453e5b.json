{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "01a89f3d-6e23-538b-b6c9-c194cf453e5b",
  "slug": "chef-johns-pumpkin-spice-snickerdoodles",
  "name": "Chef John\u2019s Pumpkin Spice Snickerdoodles",
  "recipe_type": "dessert",
  "brief_description": "The flavors of pumpkin spice work beautifully in these classic buttery, cinnamon sugar cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with a silicone mat or parchment paper."
    },
    {
      "position": 2,
      "text": "Place flour, salt, baking soda, and cream of tartar in a mixing bowl. Add cinnamon, ginger, allspice, clove, and nutmeg. Whisk until thoroughly mixed, 1 or 2 minutes."
    },
    {
      "position": 3,
      "text": "Place butter, sugar, and brown sugar in a separate mixing bowl. Cream together with a spatula or wooden spoon until mixture is smooth, 2 or 3 minutes. Add vanilla and egg. Stir until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Pour flour mixture into butter mixture. Stir until just combined or until the flour disappears."
    },
    {
      "position": 5,
      "text": "Wrap bowl in plastic wrap. Chill dough in refrigerator for about 1 hour."
    },
    {
      "position": 6,
      "text": "Stir cinnamon and sugar together in a shallow bowl or plate."
    },
    {
      "position": 7,
      "text": "Scoop dough into 2 tablespoon balls. Roll in cinnamon-sugar mixture to coat all sides. Roll into smooth ball and place on prepared baking sheet, 3 to 4 inches apart. Flatten slightly."
    },
    {
      "position": 8,
      "text": "Bake in preheated oven until browned, 10 to 12 minutes."
    },
    {
      "position": 9,
      "text": "Cool on baking sheet 5 minutes; sprinkle with additional cinnamon-sugar mixture, if desired. Transfer cookies to cooling rack to cool completely."
    },
    {
      "position": 10,
      "text": "If you\u2019d like to add a bit of a shine to your cookies, you can brush them with a simple glaze. Mix confectioners\u2019 sugar with milk or lemon juice to achieve brushing consistency. Brush onto cookies. Sprinkle with more cinnamon sugar or pumpkin pie spice, if desired."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,

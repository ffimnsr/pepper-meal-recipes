  "id": "eb7ab296-d6ac-5cd6-bef0-c2da855d00cb",
  "slug": "crispy-baked-gau",
  "name": "Crispy Baked Gau",
  "recipe_type": "dessert",
  "brief_description": "This is a baked version of the Chinese Gau, a dessert that is usually steamed and served for Chinese New Years.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line an 8x12 inch pan with aluminum foil, going up the sides."
    },
    {
      "position": 2,
      "text": "Sift the rice flour, brown sugar, white sugar, and baking soda into a large bowl. Make a well in the center and pour in the coconut milk, milk, and vanilla extract. Stir together until smooth. Pour the batter into the prepared pan, and sprinkle sesame seeds over the top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 55 minutes. Let cool in pan for 30 minutes, then remove the foil and place on a cutting board top side up. Cut into 1 inch squares."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "42933ca3-dca4-5fa6-a3d6-5868c45ca6ea",
  "slug": "cheddar-popcorn-recipe-8408073",
  "name": "Cheddar Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Simple homemade Cheddar popcorn can be made with just 3 ingredients. Unlike popcorn from a bag or tin, this is hot and fresh. I've been making this since I was a kid. It got me in trouble though, because I used to snag the packet from the boxed mac and cheese in the pantry. Thankfully, they sell the Cheddar powder on its own now.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place oil in a large stock pot over medium-high heat. Place 3 popcorn kernels in the pot. Cover."
    },
    {
      "position": 2,
      "text": "Wait for all 3 kernels to pop. Add remaining popcorn kernels. Cover the pot with a lid and cook until two seconds go by and kernels are no longer popping, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Transfer popped corn to a large bowl. Sprinkle 1 tablespoon Cheddar cheese powder over popcorn; toss. Sprinkle remaining 1 tablespoon cheese powder over popcorn; toss again. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 4,

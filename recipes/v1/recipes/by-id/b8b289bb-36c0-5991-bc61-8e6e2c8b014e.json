  "id": "b8b289bb-36c0-5991-bc61-8e6e2c8b014e",
  "slug": "oh-so-easy-caramel-sauce",
  "name": "Easy Caramel Sauce",
  "recipe_type": "dessert",
  "brief_description": "This caramel sauce recipe is easy to make at home with brown sugar, butter, and milk for a delicious dessert sauce perfect for drizzling on ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine brown sugar, butter, and milk in a saucepan over medium heat; bring to a boil. Cook until thickened, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Off heat, stir in vanilla extract."
    },
    {
      "position": 4,
      "text": "Serve over ice cream and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

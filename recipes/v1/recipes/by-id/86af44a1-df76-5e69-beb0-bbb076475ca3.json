  "id": "86af44a1-df76-5e69-beb0-bbb076475ca3",
  "slug": "homemade-saffron-pasta",
  "name": "Homemade Saffron Pasta",
  "recipe_type": "main",
  "brief_description": "Try making fresh egg pasta from scratch! Saffron flavors this homemade pasta and also adds a lovely yellow color.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Soak saffron threads in hot water for 30 minutes."
    },
    {
      "position": 2,
      "text": "Place flour on a marble or wooden work surface. Make a well in the center and crack in eggs; add salt and saffron water. Gently beat eggs, saffron, and water using a fork, incorporating the surrounding flour, until mixture is runny. Pull remaining flour into the center using a bench scraper, incorporating it until dough forms a ball. Add more water, 1 tablespoon at a time, if dough is too stiff."
    },
    {
      "position": 3,
      "text": "Knead dough with your hands by flattening the ball, stretching it, and folding the top towards the center. Turn 45 degrees and repeat until dough is soft and smooth, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Shape dough into a ball. Place in a bowl and cover with plastic wrap. Refrigerate until firm, 30 minutes to 1 hour."
    },
    {
      "position": 5,
      "text": "Roll out the dough with a pasta machine or with a rolling pin and cut into lasagna sheets or tagliatelle."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

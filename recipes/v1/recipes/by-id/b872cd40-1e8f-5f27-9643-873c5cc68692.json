  "id": "b872cd40-1e8f-5f27-9643-873c5cc68692",
  "slug": "basic-margarita",
  "name": "Basic Margarita",
  "recipe_type": "drink",
  "brief_description": "It's back to basics with tequila, triple sec, limeade, salt and ice.",
  "cuisine": "Southwestern Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Salt the rims of 2 large margarita glasses. To do so, pour salt onto a small plate, moisten the rims of the glasses on a damp towel and press them into the salt."
    },
    {
      "position": 2,
      "text": "In a blender combine tequila, triple sec and limeade concentrate. Fill blender with ice cubes. Blend until smooth. Pour into glasses, garnish with slice of lime and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

  "id": "1db47f13-19a3-587b-ac78-3da4c26c2aad",
  "slug": "baked-shotgun-shells-recipe-8404342",
  "name": "Baked Shotgun Shells",
  "recipe_type": "appetizer",
  "brief_description": "These baked shotgun shells are an out of this world appetizer - pasta shells are stuffed with ground sirloin and cheese, wrapped in bacon, and baked until crispy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil. Add pasta and cook 5 minutes. Drain and rinse with cold water. Spread shells out on a paper towel lined baking sheet and allow to drain."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (160 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine ground sirloin, Italian sausage, onion, salt, pepper, garlic powder, cheese, and cream cheese in a bowl. Stir until well combined and spoon mixture into a piping bag or resealable bag and cut off one corner of the bag."
    },
    {
      "position": 4,
      "text": "Fill each pasta shell evenly with the filling and wrap each filled shell with bacon. Place shells on a lightly greased rack set inside a baking sheet and brush evenly with barbecue sauce."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes, flip each shell, and brush again with barbecue sauce."
    },
    {
      "position": 6,
      "text": "Return to the oven and bake until deep golden brown and the bacon is slightly crispy, 25 to 30 minutes morr. Flip once more and brush with any more BBQ sauce if desired and cook 5 more minutes."
    },
    {
      "position": 7,
      "text": "Remove from oven, sprinkle with jalapeno slices and let stand 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "23a4601a-880b-5650-a19b-c1486013d6d0",
  "slug": "eggnog-french-toast",
  "name": "Eggnog French Toast",
  "recipe_type": "breakfast",
  "brief_description": "This delicious eggnog French toast is flavored with pumpkin pie spice and cinnamon for the perfect holiday breakfast or brunch treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk eggnog, eggs, cinnamon, and pumpkin pie spice together in a mixing bowl until well blended; pour into a shallow dish."
    },
    {
      "position": 3,
      "text": "Preheat an electric skillet to 300 degrees F (150 degrees C). Lightly grease the skillet."
    },
    {
      "position": 4,
      "text": "Dip one slice of bread at a time into eggnog mixture, being sure to coat each side of the bread thoroughly."
    },
    {
      "position": 5,
      "text": "Place prepared bread slices into the preheated skillet, and cook, turning once, until golden brown on each side."
    },
    {
      "position": 6,
      "text": "Place cooked bread slices on a serving plate and cover with foil to keep warm until all the slices are cooked. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

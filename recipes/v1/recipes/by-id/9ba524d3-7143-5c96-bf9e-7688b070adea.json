  "id": "9ba524d3-7143-5c96-bf9e-7688b070adea",
  "slug": "tzatziki-chicken-naan-pizza-recipe-11768334",
  "name": "Tzatziki Chicken Naan Pizza",
  "recipe_type": "appetizer",
  "brief_description": "This tzatziki chicken naan pizza is a quick prep that will make you feel like you\u2019re at the pub. Naan is topped with tzatziki, chicken, and feta, then baked until melty and scattered with fresh tomatoes, cucumber, and red onion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Place naan breads on a baking sheet; brush each with olive oil. Sprinkle evenly with garlic powder and dried dill. Top each naan with half of tzatziki sauce, 1/2 cup chicken, and half of feta cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is bubbly and the edges are nice and brown, about 7 minutes. Remove from the oven and top with red onion, tomatoes, and cucumber. Serve warm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "52b06b32-bb38-5727-986f-ae1d29b441e2",
  "slug": "air-fryer-calamari",
  "name": "Air Fryer Calamari",
  "recipe_type": "appetizer",
  "brief_description": "This calamari air fryer recipe uses less oil to make crispy calamari for a quick and easy seafood appetizer that you can enjoy guilt-free at home!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place flour in a bowl. Whisk egg and milk in a separate bowl. Combine panko, salt, and pepper in a third bowl."
    },
    {
      "position": 3,
      "text": "Coat calamari rings first in flour, then in egg mixture, and finally in panko mixture."
    },
    {
      "position": 4,
      "text": "Place rings in the basket of the air fryer so that none overlap. Work in batches if needed. Spray tops with nonstick cooking spray."
    },
    {
      "position": 5,
      "text": "Cook in the preheated air fryer for 4 minutes. Flip rings, spray with nonstick cooking spray, and cook until browned and crispy, about 3 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

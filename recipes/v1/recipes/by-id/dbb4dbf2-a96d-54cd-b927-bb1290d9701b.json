  "id": "dbb4dbf2-a96d-54cd-b927-bb1290d9701b",
  "slug": "onion-jam",
  "name": "Onion Jam",
  "recipe_type": "dessert",
  "brief_description": "This onion jam is made by cooking chopped onions in caramelized sugar until thick and jammy for a deliciously sweet spread for sandwiches or crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a heavy skillet over medium heat. Stir sugar into oil with a wooden spoon, stirring constantly, until mixture is a light caramel color, about 10 minutes. Mixture will be very hot."
    },
    {
      "position": 3,
      "text": "Stir onion, salt, and black pepper into sugar mixture. Onions will immediately start to caramelize. Stir frequently over medium heat until sugar has dissolved and onions are browned, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Pour red wine vinegar into onion mixture; simmer until mixture reaches a jam consistency, about 30 minutes. Let cool to serve."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,

  "id": "b96210e9-8c67-574b-afcd-e36a7739fb32",
  "slug": "baked-shrimp-scampi",
  "name": "Baked Shrimp Scampi",
  "recipe_type": "drink",
  "brief_description": "Tender shrimp are tossed with butter, garlic, and lemon juice and baked with Italian-seasoned bread crumbs in this rich and flavorful dish.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place shrimp into a saucepan, cover with water to a depth of 2 inches over shrimp, and bring to a boil. Cover pan and cook until shrimp are pink, 2 to 3 minutes; drain."
    },
    {
      "position": 2,
      "text": "Combine butter, white wine, lemon juice, parsley, cayenne pepper, and garlic in a 2-quart casserole dish."
    },
    {
      "position": 3,
      "text": "Place casserole dish in oven and preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "When butter is melted, lightly toss shrimp in butter mixture until coated. Sprinkle bread crumbs over shrimp."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bread crumbs are lightly golden brown, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fbd1c28c-dd7f-55ec-b4d2-a0d8abd369e3",
  "slug": "curry-split-pea-soup",
  "name": "Curry Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This recipe makes a big pot of delicious split pea soup with the flavor of curry. It serves a bunch for a little, and you don't need a ham bone or any meat leftovers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large soup pot over medium heat, heat the olive oil, and stir in the lemon juice, garlic, carrots, onions, and celery. Cook and stir until the carrots become soft enough to break apart with a fork, about 20 minutes. Transfer the vegetables and their juices into a bowl, and refrigerate. Once slightly cool, place them into a blender, and blend until the mixture forms a smooth puree."
    },
    {
      "position": 2,
      "text": "Pour the water into the soup pot, and stir in the chicken bouillon cubes until they dissolve. Pour in the vegetable puree, and bring the mixture to a boil over medium heat. Stir in split peas, Italian seasoning, cumin, salt, black pepper, cayenne pepper, and curry powder. Reduce heat to medium-low, and cook until the peas soften and break down into a thick soup, at least 45 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "f8ff5b9a-b51b-5930-9574-4302eb5e01a7",
  "slug": "drunken-mussels",
  "name": "Drunken Mussels",
  "recipe_type": "soup",
  "brief_description": "This mussels recipe from Chef John cooks the mussels in a delicious broth made with white wine, garlic, and lemon for one of the easiest shellfish recipes ever.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large stockpot over medium heat. Add garlic and let sizzle for about 30 seconds. Stir in lemon zest and red pepper flakes for about 45 seconds."
    },
    {
      "position": 3,
      "text": "Quickly pour wine into the pot and season with black pepper. Bring sauce to a boil; add mussels and cover immediately. Shake pot and let boil for 1 minute."
    },
    {
      "position": 4,
      "text": "Stir mussels, replace cover, and let boil for 2 more minutes. The shells will begin to open. Stir in parsley, cover, and cook until all shells are open, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5d30fe5b-5f4b-5354-9c86-7fa23d278b25",
  "slug": "creamy-fettuccine-with-prosciutto-and-peas-recipe-11915424",
  "name": "Creamy Fettuccine with Prosciutto and Peas",
  "recipe_type": "salad",
  "brief_description": "This creamy fettuccine with prosciutto and peas (pasta alla papalina) is a dreamy dinner. When you need something special, and you need it quickly, this will fit the bill. Rich, tasty, and quick, this main dish only needs a green salad and some lovely bread to make a complete dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil, add fettuccine, and cook until tender with a bite, about 8 minutes. Reserve 1/2 cup pasta water; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, cook prosciutto in a large non-stick skillet over medium-high heat. Cook and stir until prosciutto is crispy, 3 to 5 minutes, and remove from the skillet."
    },
    {
      "position": 3,
      "text": "To the same skillet add peas, and cook, stirring, until peas are heated through and lightly cooked, about 3 minutes. Remove from skillet."
    },
    {
      "position": 4,
      "text": "Add butter to the same skillet and melt; add cream, stirring, until it comes to a boil, then reduce heat to medium and add garlic and ground nutmeg. When garlic is fragrant, add grated Parmesan. Stir until melted."
    },
    {
      "position": 5,
      "text": "Stir cooked prosciutto and peas back into skillet. Taste, season with salt and pepper. If sauce is thicker than desired, add 2 tablespoons pasta water, and stir, adding up to 1/2 cup as needed. Add pasta and toss."
    },
    {
      "position": 6,
      "text": "Garnish with fresh parsley, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

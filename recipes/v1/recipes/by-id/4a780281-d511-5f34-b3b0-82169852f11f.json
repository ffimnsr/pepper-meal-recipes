  "id": "4a780281-d511-5f34-b3b0-82169852f11f",
  "slug": "easy-southern-fried-green-tomatoes",
  "name": "Easy Southern Fried Green Tomatoes",
  "recipe_type": "appetizer",
  "brief_description": "These easy fried green tomatoes are covered in a crispy, golden brown coating. Serve them as an appetizer or in a BLT sandwich as an unexpected surprise.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with waxed paper."
    },
    {
      "position": 2,
      "text": "Place flour into a shallow bowl. Whisk eggs and water together in a second shallow bowl. Whisk cornmeal, salt, and pepper together in a third shallow bowl."
    },
    {
      "position": 3,
      "text": "Dip one tomato slice into flour, then dip into egg mixture. Press tomato into cornmeal mixture, then shake off excess and place onto the prepared baking sheet. Repeat with remaining tomato slices, arranging them in a single layer on the baking sheet."
    },
    {
      "position": 4,
      "text": "Heat 1/4 inch canola oil in a large skillet over medium heat until shimmering. Working in batches, fry tomatoes in hot oil until golden and crisp, 3 to 4 minutes per side. Drain on paper towel-lined plates."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

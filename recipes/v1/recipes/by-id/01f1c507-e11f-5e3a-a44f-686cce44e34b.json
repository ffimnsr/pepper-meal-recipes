{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "01f1c507-e11f-5e3a-a44f-686cce44e34b",
  "slug": "carrot-honeycomb-toffee-recipe-11712353",
  "name": "Carrot Honeycomb Toffee",
  "recipe_type": "dessert",
  "brief_description": "For carrot honeycomb toffee, fresh carrot juice, honey, and sugar are cooked to the hard crack stage before vanilla and baking soda are added to make the mixture foamy, creating the honeycomb candy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Line a 13x9 inch baking high-rimmed baking pan with parchment paper or foil. Coat parchment or foil with nonstick cooking spray: set aside."
    },
    {
      "position": 2,
      "text": "In a 6-quart heavy-bottom pan combine carrot juice, sugar, honey, and kosher salt. Stir to combine. Bring to boiling over medium-high, stirring occasionally (this should take 4 to 5 minutes.)"
    },
    {
      "position": 3,
      "text": "Attach a candy thermometer to pan making sure that the bulb of the thermometer is immersed in the candy mixture. Cook, stirring occasionally, until mixture reaches 300 degrees F (150 degrees C), 20 to 25 minutes. The temperature rises very quickly in the last few minutes of cooking."
    },
    {
      "position": 4,
      "text": "Watch closely during this time as mixture foams up. If mixture foams to the top of the pan, stir vigorously to stir down the foam."
    },
    {
      "position": 5,
      "text": "Remove from heat. Stir in vanilla. Working quickly, add baking soda and whisk just until combined. ( Avoid overmixing as this deflates the bubbles.)"
    },
    {
      "position": 6,
      "text": "Pour onto prepared pan and use a rubber scrapper to transfer candy mixture to the pan. (Do not spread it out, it is okay if the top of the candy mixture is uneven.) Let cool until set, about 1 hour."
    },
    {
      "position": 7,
      "text": "Break into pieces. Store toffee in an airtight container at room temperature up to 2 weeks."
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

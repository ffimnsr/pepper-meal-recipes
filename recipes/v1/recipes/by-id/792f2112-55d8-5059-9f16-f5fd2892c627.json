  "id": "792f2112-55d8-5059-9f16-f5fd2892c627",
  "slug": "italian-penicillin-soup-recipe-8751324",
  "name": "Italian Penicillin Soup",
  "recipe_type": "soup",
  "brief_description": "Italian Penicillin, also called Sick Day Soup or Chicken Pastina Soup, is a rich, aromatic twist on classic chicken noodle soup. Blended vegetables, fresh herbs, and a Parmesan rind create a hearty, flavorful broth perfect for battling a cold.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring broth, onion, carrots, celery, garlic, and salt to a boil in a large saucepan or small Dutch oven over high. Reduce heat to medium-low, and simmer until vegetables are softened, about 10 minutes. Using a slotted spoon, transfer vegetables and 1 cup of broth to a blender."
    },
    {
      "position": 3,
      "text": "Secure lid on blender, and remove center piece to allow steam to escape. Place a clean towel over opening. Process until smooth, about 30 seconds. Stir blended carrot mixture back into soup."
    },
    {
      "position": 4,
      "text": "Add thyme sprigs, bay leaves, and Parmigiano-Reggiano cheese rind. Bring to a boil over medium-high. Add pasta, reduce heat to medium-low, and simmer, stirring occasionally, until pasta is tender, 18 to 20 minutes, adding shredded chicken in the last 3 minutes of cooking."
    },
    {
      "position": 5,
      "text": "Remove from heat. Remove and discard thyme sprigs, bay leaves, and Parmigiano-Reggiano cheese rind."
    },
    {
      "position": 6,
      "text": "Serve immediately; garnish with parsley and grated Parmigiano-Reggiano. Recipe developed by Craig Ruff"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "fruit-pizza-chopped-bagel-recipe-8605156",
  "name": "Fruit Pizza Chopped Bagel",
  "recipe_type": "breakfast",
  "brief_description": "This fruit pizza chopped bagel, filled with a cream cheese and chopped fruit spread, made quickly on a cutting board, delivers perfect bites all around.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast bagel until golden brown, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, slightly spread cream cheese on a cutting board. Add powdered sugar and fruit and chop and mix until chunky and well incorporated."
    },
    {
      "position": 3,
      "text": "Gather mixture together; scrape up with a spatula or bench scraper. Spread mixture onto bottom of toasted bagel and place top piece on top. Serve immediately."
    }
  ],

  "id": "f96cac99-09d1-5a4b-9c3e-1b97bc55b03f",
  "slug": "spicy-lettuce-noodles-recipe-11702855",
  "name": "Spicy Lettuce Noodles",
  "recipe_type": "dessert",
  "brief_description": "Chef John's spicy lettuce noodles are more than a simple, great garlic noodle dish. Crunchy lettuce ribs and wilted lettuce add marvelous texture, and lettuce contributes a subtle bittersweet flavor to sweet, salty, spicy noodles, making a truly interesting dish.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Slice lettuce crosswise into 1-inch strips and transfer into a large bowl."
    },
    {
      "position": 2,
      "text": "Add vegetable oil to a large skillet, and place over medium-high heat."
    },
    {
      "position": 3,
      "text": "When the oil is hot, add shallots, green onions, and garlic, and cook and stir until shallots start to turn translucent, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add brown sugar, rice vinegar, fish sauce, tamarind paste, soy sauce, chili sauce, and Sriracha, and stir to combine. As soon as the sauce starts to boil, turn off heat and set aside until needed."
    },
    {
      "position": 5,
      "text": "Meanwhile, bring a large pot of salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until barely tender yet firm to the bite, about 11 minutes, or about 30 seconds less than package directions."
    },
    {
      "position": 6,
      "text": "Use tongs to transfer noodles into the pan of sauce, and cook, stirring, over medium-high heat for about 30 seconds."
    },
    {
      "position": 7,
      "text": "Transfer noodles and sauce to the bowl of lettuce, and toss until everything is evenly combined, about 1 minute, or longer if you prefer the lettuce more wilted."
    },
    {
      "position": 8,
      "text": "Serve with fresh lime, more hot sauce, and freshly chopped cilantro if desired."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

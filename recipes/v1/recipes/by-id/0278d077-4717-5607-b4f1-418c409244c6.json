  "id": "0278d077-4717-5607-b4f1-418c409244c6",
  "slug": "fluffy-pancakes",
  "name": "Fluffy Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This fluffy pancake recipe is easy to make for the best breakfast or brunch. Topped with butter and syrup or berries and cream \u2014 they're impossible to resist!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine milk and vinegar in a medium bowl and set aside for 5 minutes to make sour milk."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, baking powder, baking soda, and salt in a large mixing bowl."
    },
    {
      "position": 4,
      "text": "Whisk egg and butter into soured milk."
    },
    {
      "position": 5,
      "text": "Pour flour mixture into milk mixture and whisk until lumps are gone."
    },
    {
      "position": 6,
      "text": "Heat a large skillet over medium heat, and coat it with cooking spray. Pour 1/4 cupfuls of batter onto the skillet, and cook until bubbles form and the edges are dry, about 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Flip with a spatula, and cook until browned on the other side. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

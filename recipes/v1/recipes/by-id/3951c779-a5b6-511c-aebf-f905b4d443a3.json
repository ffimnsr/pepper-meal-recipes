  "id": "3951c779-a5b6-511c-aebf-f905b4d443a3",
  "slug": "texas-chili-recipe-7482913",
  "name": "Texas Chili",
  "recipe_type": "soup",
  "brief_description": "This Texas chili is rich and hearty with just the right amount of heat. The beef is wonderfully tender and perfectly absorbs the smoky, savory seasoning of the pepper paste and spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place peppers in a large skillet and heat over medium-low heat; cook, turning once, until lightly toasted and fragrant, 2 to 3 minutes per side. Transfer chiles to a bowl and cover with hot water; let stand for 30 minutes."
    },
    {
      "position": 3,
      "text": "Drain chiles, reserving about 1/2 cup of the soaking water. Use a paring knife to slice open each pepper, and remove and discard stems and seeds by running under a gentle stream of tap water."
    },
    {
      "position": 4,
      "text": "Combine chiles, chipotle pepper, and reserved 1/2 cup water in a blender; blend until a smooth paste forms, 15 to 30 seconds. Set aside."
    },
    {
      "position": 5,
      "text": "Heat oil in a Dutch oven over medium-high heat. Toss beef cubes in a large bowl with salt and pepper until evenly coated. Add half of the beef to the Dutch oven and cook, stirring occasionally to brown most sides, about 3 minutes per side. Transfer to a large plate. Repeat with remaining beef."
    },
    {
      "position": 6,
      "text": "Add onions and garlic to drippings in Dutch oven and cook, stirring constantly, until soft and translucent, 3 to 4 minutes. Add cumin and cinnamon, and cook, stirring constantly, until darkened and fragrant, about 1 minute."
    },
    {
      "position": 7,
      "text": "Add blended chili paste and cook, stirring constantly, for 1 minute."
    },
    {
      "position": 8,
      "text": "Add 1/4 cup of the water and masa harina, whisking until incorporated to avoid lumps. Add stock and remaining 1 1/4 cups water and stir to combine."
    },
    {
      "position": 9,
      "text": "Add bay leaves and reserved beef and bring to a simmer over medium-high. Reduce heat to maintain a very low simmer and cook, partially covered, stirring occasionally, until liquid is thickened, about 2 hours. Stir in brown sugar and vinegar."
    },
    {
      "position": 10,
      "text": "Remove from heat and let stand for 20 minutes before serving warm with sour cream and lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 20,

  "id": "35721c07-53d8-5157-a0a9-88a7c33b4aa0",
  "slug": "spiced-air-fried-chickpeas",
  "name": "Spiced Air-Fried Chickpeas",
  "recipe_type": "appetizer",
  "brief_description": "Chickpeas are mixed with nutritional yeast, paprika, garlic, cumin, and salt and fried in an air fryer for a quick and easy vegan snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Spread chickpeas on a double layer of paper towels, cover with another layer of paper towels, and let dry for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat air fryer to 355 degrees F (180 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine dry chickpeas, nutritional yeast, olive oil, smoked paprika, garlic, salt, and cumin in a bowl; toss to coat."
    },
    {
      "position": 4,
      "text": "Add chickpeas to the air fryer and cook until crispy, 20 to 22 minutes, shaking them every 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

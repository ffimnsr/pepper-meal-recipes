  "id": "051b3af3-4007-58ad-b3e7-bb6ea963f0e7",
  "slug": "chocolate-chip-zucchini-bread",
  "name": "Chocolate Chip Zucchini Bread",
  "recipe_type": "breakfast",
  "brief_description": "This moist chocolate chip zucchini bread is packed with shredded zucchini and has gooey chocolate chips in every bite for a delicious summer treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8X4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Beat eggs in a large bowl until light and foamy. Mix in shredded zucchini, sugar, oil, and vanilla until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Whisk flour, cocoa powder, salt, baking soda, and baking powder together in a separate bowl; stir into zucchini mixture. Mix in nuts and chocolate chips. Pour batter into the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaves comes out clean, about 1 hour. Let loaves sit in the pans for 10 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

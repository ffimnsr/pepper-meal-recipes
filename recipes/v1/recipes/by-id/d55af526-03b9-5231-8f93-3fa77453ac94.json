  "id": "d55af526-03b9-5231-8f93-3fa77453ac94",
  "slug": "italian-mac-and-cheese",
  "name": "Italian Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This Italian mac and cheese combines tender pasta with a rich, creamy Italian cheese sauce seasoned with garlic and baked until golden and delicious.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until penne start to get tender, about 8 minutes. Drain and reserve 1/4 cup pasta water."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook Italian sausage in a heavy skillet over medium-high heat until brown and crumbly, about 5 minutes. Transfer to a paper towel lined plate."
    },
    {
      "position": 4,
      "text": "Melt butter in a skillet over medium heat. Saut\u00e9 minced garlic and red pepper flakes until garlic is fragrant, 30 to 45 seconds. Sprinkle flour over mixture and stir to combine, making sure there are no lumps."
    },
    {
      "position": 5,
      "text": "Pour in milk, cream, and reserved pasta water. Mix mozzarella, provolone, Fontina, and Parmesan cheeses in a bowl and stir in about 4/5th of the cheese mixture. Stir to combine. Add penne, cooked Italian sausage, and julienned sun dried tomatoes to the cheese sauce. Mix to combine and pour into an 8x8 inch casserole dish. Sprinkle with remaining cheese mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is melted and lightly browned, about 25 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "best-guacamole",
  "name": "Best Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "The best guacamole recipe. For chips or a taco topping, guacamole enhanced with lemon and onion is a forever favorite. And it\u2019s easy to make.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Cut avocados into halves. Remove seeds and scoop out the pulp into a small bowl. Use a fork to mash the avocado."
    },
    {
      "position": 2,
      "text": "Stir in lemon juice, onion, olive oil, and salt. Cover the bowl and refrigerate for 1 hour before serving."
    }
  ],
  "servings": 16,

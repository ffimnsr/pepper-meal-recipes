  "id": "26409575-4bef-59e4-a6d4-7ee5797e10e1",
  "slug": "chocolate-mousse-with-cocoa-powder",
  "name": "Chocolate Mousse with Cocoa Powder",
  "recipe_type": "dessert",
  "brief_description": "This chocolate mousse with cocoa powder doesn't need to be cooked and is egg free. It doesn't get much easier than this for an elegant dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream, 1/2 cup powdered sugar, and cocoa powder in a large chilled bowl. Beat with an electric mixer with chilled beaters until stiff peaks form; set aside."
    },
    {
      "position": 2,
      "text": "Beat whipped cream cheese in a separate bowl until soft. Add 2 tablespoons powdered sugar gradually and beat until well combined. Mix in almond extract and beat until well incorporated. Fold the cream cheese mixture into the chocolate whipped cream until both are completely blended."
    },
    {
      "position": 3,
      "text": "Spoon or pipe mousse into small serving dishes. Top with grated chocolate."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

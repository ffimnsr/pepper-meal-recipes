  "id": "faea4120-67a2-5ac3-a627-1c3833a9ac49",
  "slug": "dairy-free-honey-pumpkin-pie",
  "name": "Dairy-Free Honey Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "Honey adds delicate sweetness to this easy dairy-free twist on classic pumpkin pie made with almondmilk.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 400 degrees F."
    },
    {
      "position": 2,
      "text": "In medium bowl, mix flour and 1/4 teaspoon salt. With pastry blender or 2 knives, cut shortening into flour until texture is crumbly. Sprinkle 3 tablespoons of the almondmilk over mixture and mix with fork until mixture comes together in a ball. If necessary, sprinkle a little more almondmilk over the mixture."
    },
    {
      "position": 3,
      "text": "Sprinkle a little flour over a 12-inch square of waxed paper. Place ball of dough in center; pat into disc. Sprinkle with flour and top with another square of waxed paper. Roll very thinly into 12-inch circle. Remove top piece of waxed paper and turn crust upside down over a 9-inch deep-dish pie plate. Fit into pie plate and remove waxed paper. Crimp edges."
    },
    {
      "position": 4,
      "text": "To make the filling, beat the rest of the ingredients and remaining 1/2 teaspoon salt with electric mixer on low speed in a large bowl until well-mixed. Pour into crust."
    },
    {
      "position": 5,
      "text": "Bake 50 to 55 minutes or until knife inserted 1 inch from edge comes out clean. Cover edges of crust with strips of foil to keep from over-browning, if necessary. Cool completely, about 2 hours. Store in refrigerator."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

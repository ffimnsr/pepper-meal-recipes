  "id": "a1a0e498-8d01-57d9-a36f-250ba4988b3e",
  "slug": "no-bake-pb-and-j-bars-recipe-11806533",
  "name": "The 15-Minute No-Bake Bars That Taste 'Just Like a PB&J!'",
  "recipe_type": "dessert",
  "brief_description": "These no-bake PB&J bars are a stellar combination of salty and sweet. A sweet strawberry jam layer tops a fluffy peanut butter filling above a salty pretzel crust; once chilled, it's like a supremely satisfying PB&J sandwich in bar form.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "For pretzel crust, process pretzels in a food processor until small crumbs form, 15 to 30 seconds. Add sugar, butter, and salt; pulse until evenly combined, about 5 pulses."
    },
    {
      "position": 3,
      "text": "Transfer pretzel mixture to an 8-inch square baking dish, and press firmly into an even layer. Chill, uncovered, until firm, about 10 minutes."
    },
    {
      "position": 4,
      "text": "For peanut butter filling, beat cream cheese, peanut butter, confectioner's sugar, and salt in a large bowl with an electric mixer on medium speed until smooth and creamy, 1 to 2 minutes, stopping to scrape down sides of bowl as needed."
    },
    {
      "position": 5,
      "text": "Fold in whipped topping until evenly distributed, about 1 minute. Spread filling evenly over cooled crust."
    },
    {
      "position": 6,
      "text": "Spread strawberry preserves evenly over filling."
    },
    {
      "position": 7,
      "text": "Cover and chill until set, at least 4 hours or up to 12 hours. Slice into 9 equal portions and serve chilled. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 9,
  "cooking_time_minutes": null,

  "id": "6f02eb59-f962-5d26-b145-6dea724ab6ab",
  "slug": "nutmeg-cake",
  "name": "Nutmeg Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist nutmeg cake is made with buttermilk and frosted with caramel icing. It makes one frosted 9-inch layer cake or about 15 cupcakes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 (9-inch) round cake pans."
    },
    {
      "position": 2,
      "text": "Make nutmeg cake: Beat butter and white sugar with an electric mixer in a large bowl until light and fluffy. The mixture should be noticeably lighter in color. Add eggs, one at a time, until well-blended. Stir in vanilla."
    },
    {
      "position": 3,
      "text": "Sift together flour, baking powder, baking soda, nutmeg, and salt."
    },
    {
      "position": 4,
      "text": "Pour 1/3 of the flour mixture into the bowl; mix just until incorporated. Stir in 1/2 of the buttermilk, mixing gently. Continue adding flour mixture alternately with buttermilk, mixing until combined. Spread batter into the prepared pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cakes comes out clean, about 25 to 30 minutes. Let cakes cool in the pans for 10 minutes, then invert them on a wire rack to cool completely before icing."
    },
    {
      "position": 6,
      "text": "Make caramel icing: Combine brown sugar, cream, and butter in a medium saucepan over medium-high heat. Boil for 2 minutes, then remove from heat and let cool."
    },
    {
      "position": 7,
      "text": "Stir in confectioner's sugar and beat until smooth. Add more cream or confectioner's sugar to achieve desired spreading consistency."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,

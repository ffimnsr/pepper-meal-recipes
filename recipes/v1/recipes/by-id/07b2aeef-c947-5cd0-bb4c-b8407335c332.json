  "id": "07b2aeef-c947-5cd0-bb4c-b8407335c332",
  "slug": "oatmeal-craisin-cookies",
  "name": "Oatmeal Craisin Cookies",
  "recipe_type": "dessert",
  "brief_description": "This craisin cookie recipe uses dried cranberries, oatmeal, and raisins for a delicious, chewy treat perfect for lunch boxes and afternoon snacks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "Beat together butter, sugars, eggs, and vanilla in a large bowl with an electric mixer until light and fluffy, about 5 minutes. Combine oats, flour, baking soda, baking powder, and salt in a separate bowl. Add flour mixture, 1 cup at a time, beating batter briefly after each addition. Mix in raisins and cranberries. Drop by spoonfuls onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are golden, 12 to 14 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

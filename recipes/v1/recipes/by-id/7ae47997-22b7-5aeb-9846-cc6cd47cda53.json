  "id": "7ae47997-22b7-5aeb-9846-cc6cd47cda53",
  "slug": "big-mac-onion-rings-recipe-12015220",
  "name": "Big Mac Onion Rings",
  "recipe_type": "appetizer",
  "brief_description": "These Big Mac onion rings are a fun appetizer that delivers all the flavors of a Big Mac, heavy on the onion and minus the bun. Crispy cheese, ground beef, pickles, lettuce, and tangy Mac sauce pile on the classic flavors, while sesame seeds give a nod to the missing bun.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For Mac sauce, whisk together mayonnaise, relish, mustard, vinegar, and paprika in a small bowl. Let chill while you make the onion rings. Makes 2/3 cup."
    },
    {
      "position": 2,
      "text": "For onion rings, preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 3,
      "text": "Sprinkle Parmesan and Cheddar cheeses in an even layer on the prepared baking sheet. Arrange onion slices over the cheese. Brush onion slices with olive oil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the cheese is golden brown and crispy and the onions are tender, 15 to 18 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, cook ground beef and garlic powder in a medium skillet over medium heat until browned; drain fat."
    },
    {
      "position": 6,
      "text": "Remove onion rings from oven. Let stand 1 to 2 minutes until cheese stops bubbling."
    },
    {
      "position": 7,
      "text": "Top with ground beef, 3 tablespoons Mac Sauce, dill pickle chips, lettuce, and sesame seeds. Serve immediately with additional Mac Sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

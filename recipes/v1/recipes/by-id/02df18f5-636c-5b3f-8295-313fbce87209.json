  "id": "02df18f5-636c-5b3f-8295-313fbce87209",
  "slug": "apple-cranberry-relish",
  "name": "Apple Cranberry Relish",
  "recipe_type": "side",
  "brief_description": "This tasty and colorful dish combines oranges, cranberries, apples and celery. It needs to be refrigerated overnight, so plan ahead!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grate peel of orange; reserve. Peel oranges and discard white membranes. Separate oranges into sections and place half in a food processor or blender. To the food processor add half of the cranberries, apples and celery. Process until coarsely chopped. Transfer to a bowl; repeat with remaining oranges, cranberries, apples and celery. Stir in sugar and reserved orange peel. Cover and refrigerate overnight."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "819c392e-ca0f-5d3b-afb6-1ae590364c9c",
  "slug": "chicken-parmesan-with-zucchini-pasta",
  "name": "Chicken Parmesan with Zucchini Pasta",
  "recipe_type": "side",
  "brief_description": "Zucchini noodles are served alongside chicken topped with marinara and cheese in this gluten-free version of chicken Parmesan.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place zucchini spirals in a colander and sprinkle 1 teaspoon salt and Italian seasoning over zucchini; toss to coat. Set colander over a bowl to allow water from zucchini to drain."
    },
    {
      "position": 3,
      "text": "Wrap chicken in plastic wrap and place on a work surface; pound into 1/4- to 1/2-inch thickness. Remove plastic wrap and season chicken with salt and pepper."
    },
    {
      "position": 4,
      "text": "Heat marinara sauce in a saucepan over low heat."
    },
    {
      "position": 5,
      "text": "Coat a nonstick skillet with cooking spray and place over medium-high heat. Cook chicken in the hot skillet until browned and no longer pink in the center, 4 to 5 minutes per side. Transfer chicken to the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 7,
      "text": "Place zucchini in the same nonstick skillet over medium-high heat; cook and stir until tender yet firm to the bite, 3 to 4 minutes."
    },
    {
      "position": 8,
      "text": "Spoon marinara sauce over each chicken breast and top with mozzarella cheese."
    },
    {
      "position": 9,
      "text": "Broil chicken in the preheated oven until cheese is melted, 1 to 2 minutes."
    },
    {
      "position": 10,
      "text": "Transfer zucchini to each serving plate and add chicken. Spoon warm marinara over each piece of chicken and top with Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 20,

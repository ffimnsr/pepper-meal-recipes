  "id": "254be8de-bf90-5f6b-a691-5c1976ed7e0a",
  "slug": "ginger-lemonade",
  "name": "Ginger Lemonade",
  "recipe_type": "drink",
  "brief_description": "Ginger and lemon play well together to create an invigorating, crisp twist on lemonade. Freeze into cubes so the drink stays cold on a hot summer day.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar, water, and ginger root in an 8-quart saucepan. Heat to boiling, stirring occasionally until sugar melts. Remove from heat."
    },
    {
      "position": 2,
      "text": "Stir in lemon juice. Cool 15 minutes. Remove ginger. Refrigerate lemonade at least 1 hour, or until chilled."
    },
    {
      "position": 3,
      "text": "Serve over ice, and garnish with lemon slices."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

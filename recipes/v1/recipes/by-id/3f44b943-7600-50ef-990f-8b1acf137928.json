  "id": "3f44b943-7600-50ef-990f-8b1acf137928",
  "slug": "muhammara-roasted-pepper-walnut-spread",
  "name": "Muhammara (Roasted Pepper & Walnut Spread)",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's recipe for muhammara \u2014 a roasted red pepper and walnut spread \u2014 is perfect as a dip with fresh pita bread or as a topping for any bread.",
  "cuisine": "Turkish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium heat. Add walnuts and drizzle with 1 tablespoon olive oil. Cook and stir frequently until walnuts smell toasted and are lightly browned, about 5 minutes. Remove from heat and transfer walnuts to a plate to cool. Reserve 2 or 3 to coarsely chop and use for garnish."
    },
    {
      "position": 2,
      "text": "Place the skillet over medium heat; add 1 tablespoon olive oil. Sprinkle in bread crumbs; cook and stir frequently until crumbs turn golden brown, 3 or 4 minutes. Remove from heat and sprinkle onto plate with walnuts."
    },
    {
      "position": 3,
      "text": "Place peppers in bowl of a food processor. Add walnuts, toasted bread crumbs, garlic, lemon juice, pomegranate molasses, salt, paprika, Aleppo pepper flakes, cumin, and cayenne pepper. Drizzle with remaining 2 tablespoons olive oil."
    },
    {
      "position": 4,
      "text": "Pulse on and off, scraping mixture down occasionally, until mixture is fairly fine and smooth. Transfer to a bowl; cover and refrigerate until chilled, about 2 hours."
    },
    {
      "position": 5,
      "text": "Transfer to a shallow serving bowl. Use the back of a spoon to swirl indentations on the surface to capture the garnishes. Garnish with reserved chopped walnuts, a drizzle of olive oil, pepper flakes, and chopped parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

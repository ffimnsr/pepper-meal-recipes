  "id": "28e0a4d4-d0ea-527c-9f4c-f5f7eed5026b",
  "slug": "sticky-popcorn",
  "name": "Sticky Popcorn",
  "recipe_type": "dessert",
  "brief_description": "This sticky popcorn is made by melting marshmallows, butter, and brown sugar in the microwave, then pouring it over popped kernels for a sweet snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine marshmallows, butter, and brown sugar in a microwave-safe bowl. Heat in the microwave until marshmallows are melted and mixture is smooth, 30 to 60 seconds."
    },
    {
      "position": 2,
      "text": "Place popcorn in a large serving bowl. Pour marshmallow mixture over popcorn; stir to coat."
    }
  ],
  "servings": 5,

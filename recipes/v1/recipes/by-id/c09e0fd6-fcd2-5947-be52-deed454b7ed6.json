  "id": "c09e0fd6-fcd2-5947-be52-deed454b7ed6",
  "slug": "dump-and-bake-meatball-stroganoff-recipe-11789524",
  "name": "Dump and Bake Meatball Stroganoff",
  "recipe_type": "main",
  "brief_description": "This dump and bake meatball stroganoff could not be easier. A creamy pasta bake with meatballs, mushrooms, and a crispy onion topping",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk together sour cream and cream cheese in a 9x13-inch baking dish until smooth. Gradually whisk in broth. Stir in Worcestershire sauce, mustard, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Stir in mushrooms, onion, and garlic."
    },
    {
      "position": 4,
      "text": "Fold in noodles and meatballs; lightly press with the back of a spoon to submerge noodles in the liquid as much as possible."
    },
    {
      "position": 5,
      "text": "Cover dish tightly with foil and bake in the preheated oven for 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and stir mixture, pressing noodles down again to submerge in the mixture. (If some noodles look underdone at this point, it\u2019s fine, they will get done while it finishes baking and standing.)"
    },
    {
      "position": 7,
      "text": "Top with French-fried onions. Bake uncovered until topping is golden and mixture is heated through, 10 minutes more."
    },
    {
      "position": 8,
      "text": "Let sit for 10 minutes before serving. Garnish with chopped parsley. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

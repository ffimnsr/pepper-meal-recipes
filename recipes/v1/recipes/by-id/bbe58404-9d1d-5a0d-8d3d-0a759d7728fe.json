  "id": "bbe58404-9d1d-5a0d-8d3d-0a759d7728fe",
  "slug": "grilled-eggplant-parmesan",
  "name": "Grilled Eggplant Parmesan",
  "recipe_type": "side",
  "brief_description": "Cheesy grilled eggplant sits on top of a bed of homemade smoky grilled tomato sauce for an eggplant Parmesan dish like no other, making a perfect summer side or vegetarian main.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggplant in a large bowl. Add 4 tablespoons olive oil, lemon juice, and 1/4 teaspoon salt. Stir to combine and let marinade for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Thread shallot and tomatoes onto skewers and brush 1 tablespoon of olive oil over them. Grill for 4 minutes. Flip and grill 4 minutes more."
    },
    {
      "position": 4,
      "text": "Transfer grilled tomatoes and shallot to a blender. Add vinegar, garlic, crushed chili flakes, 1/2 teaspoon salt, and remaining 2 tablespoons olive oil. Pulse until blended but still chunky. Set aside."
    },
    {
      "position": 5,
      "text": "Grill eggplant slices for 5 minutes. Flip, and sprinkle the remaining 1/4 teaspoon of salt over them. Top each with a slice of mozzarella and grill until cheese begins to melt, about 2 minutes."
    },
    {
      "position": 6,
      "text": "Spoon tomato mixture on a serving platter. Top with eggplant. Sprinkle grated Parmesan cheese over the top and garnish with fresh basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "26dcf719-472a-5491-b2e8-1ef64b95cb2f",
  "slug": "air-fryer-crispy-artichoke-hearts-recipe-12023375",
  "name": "Air Fryer Crispy Artichoke Hearts",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer crispy artichoke hearts are an appetizer to remember. Golden and crispy on the outside, yet tender and flavorful on the inside, they\u2019re quick, easy, and perfect for dipping into your favorite sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place drained artichokes in a bowl and drizzle with melted butter. Gently toss to coat."
    },
    {
      "position": 2,
      "text": "In a separate bowl combine breadcrumbs, grated cheese, paprika, salt, and pepper. Spray the air fryer basket with avocado oil spray."
    },
    {
      "position": 3,
      "text": "Working in batches, gently coat artichoke quarters with breadcrumb mixture. Space out artichoke quarters in the airfryer basket."
    },
    {
      "position": 4,
      "text": "Air fry artichokes at 400 degrees F (200 degrees C) until golden brown, 6 to 8 minutes. Garnish with chopped parsley and serve with aioli."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "b309d794-b682-5959-b7c4-3b9ba469f501",
  "slug": "herb-marinated-tenderloin",
  "name": "Herb-Marinated Tenderloin",
  "recipe_type": "main",
  "brief_description": "Filet mignon is the king of steaks. It's lean, tender, you can add any desired flavor to it and it will absorb it all, and you can cut it with a butter knife. This is a perfect special-occasion meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut a few 2-inch slits in the side of the fillet; stuff the sage leaves and garlic pieces into the slits. Wrap the thyme sprigs around the fillet. Store in refrigerator to allow the meat to absorb the flavors for 4 to 12 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat; lightly oil the grate. Cut the tenderloin in half and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Cook the fillets 4 to 6 minutes per side, until no longer pink, or to desired doneness."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "19ab283d-a86c-56fa-8b67-ae8e85f73a2e",
  "slug": "caramel-filled-carrot-cake-roll",
  "name": "Caramel-Filled Carrot Cake Roll",
  "recipe_type": "dessert",
  "brief_description": "Perfect for entertaining a crowd, this big batch recipe for carrot cake produces two large carrot cake rolls that are filled with a caramel-flavored cream cheese filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine carrots and 1 teaspoon sugar in a saucepan; add water to cover. Cover the pan, bring to a boil over medium-high heat, and cook until fork tender, 3 to 4 minutes. Drain carrots, mash with a fork, and set aside to cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease two 10x15-inch baking pans and line with parchment paper. Lightly grease parchment paper and dust with flour."
    },
    {
      "position": 3,
      "text": "Combine flour, cinnamon, baking powder, and salt in a medium bowl."
    },
    {
      "position": 4,
      "text": "Beat eggs in a large bowl with an electric mixer on high speed for 5 to 7 minutes. Beat in 2 cups white sugar until thick. Mix in mashed carrots and vanilla extract. Fold in flour mixture. Spread batter into the prepared baking pans and sprinkle with walnuts."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top springs back when lightly touched, 10 to 12 minutes."
    },
    {
      "position": 6,
      "text": "While cakes are baking, dust 2 linen towels with confectioners' sugar."
    },
    {
      "position": 7,
      "text": "Remove cakes from the oven and cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Invert each cake carefully onto the sugar-dusted towels. Peel off parchment paper and roll cakes up in the towels to cool."
    },
    {
      "position": 8,
      "text": "Meanwhile, combine cream cheese, butter, caramel topping, and vanilla extract for the frosting in a large bowl; beat with an electric mixer until smooth and creamy. Gradually mix in confectioners' sugar until fluffy."
    },
    {
      "position": 9,
      "text": "Carefully unroll cakes and spread filling to 1 inch from the edges. Roll up cakes, cover, and chill until serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 35,

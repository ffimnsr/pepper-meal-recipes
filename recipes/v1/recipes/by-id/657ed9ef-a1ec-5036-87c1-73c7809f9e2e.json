  "id": "657ed9ef-a1ec-5036-87c1-73c7809f9e2e",
  "slug": "slow-cooker-lengua-beef-tongue",
  "name": "Slow Cooker Lengua (Beef Tongue)",
  "recipe_type": "main",
  "brief_description": "Beef tongue, or lengua, is slow-cooked with onions, garlic, and bay leaf until tender, then saut\u00e9ed in butter for a juicy, flavorful taco filling.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef tongue, onion, garlic, and bay leaf in a slow cooker; generously season with salt. Pour in enough water to cover beef mixture."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 hours."
    },
    {
      "position": 3,
      "text": "Transfer beef tongue to a work surface and cool slightly. Peel outer layer of skin from beef tongue and remove rough end."
    },
    {
      "position": 4,
      "text": "Chop meat into bite-sized pieces."
    },
    {
      "position": 5,
      "text": "Heat butter in a skillet over medium heat; cook and stir chopped meat until tender, 5 to 10 minutes. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 485,
  "preparation_time_minutes": 10,

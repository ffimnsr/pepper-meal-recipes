  "schema_version": 1,
  "id": "6ef2e1f5-68ec-5dd6-940d-7a7938e3e14d",
  "slug": "pineapple-upside-down-cake-from-scratch",
  "name": "Pineapple Upside-Down Cake from Scratch",
  "recipe_type": "dessert",
  "brief_description": "This pineapple upside-down cake from scratch is an old-fashioned German recipe. You can use Italian prunes or pitted fresh cherries instead of pineapple.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x2 \u00bd-inch round cake pan."
    },
    {
      "position": 2,
      "text": "Combine brown sugar and \u00bc cup melted butter in a bowl; spread evenly into the prepared pan. Place 10 pineapple pieces around outer edge of pan, facing the same way, place remaining 2 pieces in the center. Place 1 cranberry between each pineapple piece."
    },
    {
      "position": 3,
      "text": "Beat white sugar and \u00bd cup softened butter together in a bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well and scraping sides of the bowl after each addition. Beat in baking powder, vanilla extract, almond extract, cinnamon, and salt until combined."
    },
    {
      "position": 4,
      "text": "Add flour and milk to batter in 3 additions, adding \u00bd cup flour and \u00bc cup milk at a time, mixing well after each addition, until thoroughly combined."
    },
    {
      "position": 5,
      "text": "Pour batter over pineapple slices, making sure batter gets between them. Spread and smooth batter using an offset spatula."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 7,
      "text": "Cool cake on a wire rack for 15 to 20 minutes. Run a knife around the edges to loosen. Place a plate over pan and quickly invert to release cake, waiting a few seconds and tapping the pan several times if it doesn\u2019t immediately separate from the pan."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

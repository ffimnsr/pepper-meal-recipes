  "id": "de6d2b6a-3440-5928-898b-153c564022df",
  "slug": "white-chocolate-cream-cheese-fruit-tart",
  "name": "White Chocolate-Cream Cheese Fruit Tart Recipe",
  "recipe_type": "dessert",
  "brief_description": "This white chocolate-cream cheese fruit tart recipe features a white chocolate and cream cheese filling, a golden crust, fresh fruit, and a sweet glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 12-inch tart pan."
    },
    {
      "position": 2,
      "text": "Beat butter and confectioners' sugar together in a bowl using an electric mixer until light and fluffy. Mix in flour until mixture is crumbly. Press into the prepared tart pan."
    },
    {
      "position": 3,
      "text": "Bake crust until lightly browned, 25 to 30 minutes. Cool completely."
    },
    {
      "position": 4,
      "text": "Beat melted and cooled white chocolate and heavy cream together in a bowl until smooth. Beat in cream cheese until thoroughly combined. Spread over cooled crust. Chill in the refrigerator for 30 minutes."
    },
    {
      "position": 5,
      "text": "Combine 1/2 cup water and white sugar in a saucepan; bring to a boil. Mix remaining 1/2 cup water and cornstarch together in a bowl until cornstarch dissolves; add to sugar mixture. Cook and stir until mixture thickens and becomes clear, about 5 minutes. Stir in corn syrup; return to a boil. Remove glaze from heat; cool for 10 minutes."
    },
    {
      "position": 6,
      "text": "Arrange strawberries, blueberries, and raspberries over cream cheese layer; brush with glaze. Chill in the refrigerator for at least 1 hour before serving; store in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

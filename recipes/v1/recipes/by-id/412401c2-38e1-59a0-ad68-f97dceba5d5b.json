  "id": "412401c2-38e1-59a0-ad68-f97dceba5d5b",
  "slug": "traditional-kimchi",
  "name": "Traditional Kimchi",
  "recipe_type": "salad",
  "brief_description": "This classic kimchi recipe proves just how easy it is to make crunchy, fermented veggies at home. It's delicious on sandwiches and salads, or in fried rice!",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Place cabbage and radish into a large colander. Sprinkle liberally with salt, mix to combine, and let sit for 1 hour. Sprinkle with additional salt, mix again, and let sit for 1 more hour. Rinse cabbage and let drain."
    },
    {
      "position": 2,
      "text": "Combine onion, garlic, ginger, and rice vinegar in a blender. Add water and blend on high power until well combined."
    },
    {
      "position": 3,
      "text": "Transfer drained cabbage to a large bowl. Add blended onion mixture, persimmon, cucumber, green onions, and red pepper flakes; mix until well combined."
    },
    {
      "position": 4,
      "text": "Transfer kimchi to sterilized airtight containers and refrigerate for three days before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

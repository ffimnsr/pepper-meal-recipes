  "id": "939bfc48-a748-5889-ae6c-9f24585f9dc5",
  "slug": "easy-yorkshire-pudding",
  "name": "Easy Yorkshire Pudding",
  "recipe_type": "side",
  "brief_description": "This easy recipe for Yorkshire pudding only requires 4 simple ingredients and only takes 10 minutes to bake!",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, milk, and eggs together in a bowl; let sit for 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Divide the vegetable oil among 6 large muffin cups and place in oven for 5 minutes."
    },
    {
      "position": 3,
      "text": "Spoon flour mixture into the prepared muffin cups. Increase oven temperature to 425 degrees F (220 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

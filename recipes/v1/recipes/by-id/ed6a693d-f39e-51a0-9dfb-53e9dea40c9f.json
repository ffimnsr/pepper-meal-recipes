  "id": "ed6a693d-f39e-51a0-9dfb-53e9dea40c9f",
  "slug": "dairy-free-chowder",
  "name": "Dairy-Free Chowder",
  "recipe_type": "soup",
  "brief_description": "This easy formula for dairy-free chowder adapts to any main ingredient you want, whether it's clams, fish, mixed seafood, or even corn.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1/4 cup oil a large pot over medium heat. Add onion, celery, and bacon to hot oil; cook and stir until bacon fat renders and onion is translucent, about 5 minutes. Add potatoes and clam juice. Increase heat to medium-high and bring to a boil. Cook until potatoes are fork-tender, 15 to 20 minutes. Add clams and cook for 10 minutes more."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine remaining 1/4 cup oil and flour in a separate saucepan over medium heat. Stir until paste-like and light golden brown, 3 to 5 minutes. Gradually whisk in almond milk; cook and stir until mixture becomes a thick slurry, 6 to 7 minutes more."
    },
    {
      "position": 3,
      "text": "Stir slurry into clam chowder until thickened. Season with salt and pepper; serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

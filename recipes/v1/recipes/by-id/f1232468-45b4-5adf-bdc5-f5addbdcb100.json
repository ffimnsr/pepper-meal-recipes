  "id": "f1232468-45b4-5adf-bdc5-f5addbdcb100",
  "slug": "easy-dark-chocolate-mousse",
  "name": "Easy Dark Chocolate Mousse",
  "recipe_type": "dessert",
  "brief_description": "Easy to make ahead and chill overnight, this dark chocolate mousse is a decadent dessert that's great for entertaining.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat 3/4 cup sugar and egg yolks together in a bowl."
    },
    {
      "position": 2,
      "text": "Melt chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes. Add butter gradually and beat until smooth. Beat into the egg yolk mixture."
    },
    {
      "position": 3,
      "text": "Beat egg whites and salt together in another bowl until stiff peaks form. Sprinkle 1 tablespoon sugar over and beat for 2 minutes more. Stir egg whites slowly into chocolate bowl. Refrigerate for at least 6 hours; overnight is best."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "757a82bd-8be8-5ffd-a443-f03fe813771c",
  "slug": "mums-irish-apple-pie",
  "name": "Mum\u2019s Irish Apple Pie",
  "recipe_type": "dessert",
  "brief_description": "This Irish apple pie recipe is from my mum. She was from Cork in southern Ireland, so I\u2019m guessing the recipe is Irish and possibly the same one her mother taught her.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "To make the crust: Combine flours, sugar, and salt in a large bowl. Cut in butter and shortening with 2 knives or a pastry blender until mixture resembles coarse crumbs. Mix in sour cream and lemon juice until dough comes together; some lumps are okay. Divide dough in half and shape into 2 disks. Wrap each in plastic wrap and chill in the refrigerator for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie dish."
    },
    {
      "position": 3,
      "text": "Roll 1 dough disk out to fit the prepared 9-inch pie dish. Roll out remaining dough disk for top crust; set aside."
    },
    {
      "position": 4,
      "text": "To make the filling: Place apples into crust in the pie dish. Stir together sugar, flour, and nutmeg in a small bowl; sprinkle over apples. Drizzle with lemon juice."
    },
    {
      "position": 5,
      "text": "Brush outer edge of bottom crust with beaten egg. Cover with top crust; trim and crimp edges together. Brush top with beaten egg and cut 4 steam vents."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 45 minutes. Allow pie to completely cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

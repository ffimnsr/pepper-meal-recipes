  "id": "3d1cfb97-c9eb-5728-9107-65b277644e04",
  "slug": "dandans-strawberry-cream-pie",
  "name": "DanDan's Strawberry Cream Pie",
  "recipe_type": "dessert",
  "brief_description": "This strawberry cream pie is light as air with a filling of sweet cream cheese, whipped cream, and fresh berries piled high on a graham cracker crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together cream cheese, white sugar, and vanilla in a large bowl until smooth. Stir in 3/4 cup mashed strawberries until well combined."
    },
    {
      "position": 2,
      "text": "Beat together heavy cream and confectioners' sugar in a glass or metal bowl until stiff peaks form. Fold whipped cream into cream cheese mixture until evenly mixed; fold in 1/4 cup sliced strawberries."
    },
    {
      "position": 3,
      "text": "Spoon strawberry mixture into graham cracker crust. Chill in the refrigerator for at least 3 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "be93e535-dc3a-5d1a-bf67-e6404a8c8979",
  "slug": "mesquite-smoked-jerky",
  "name": "Mesquite Smoked Jerky",
  "recipe_type": "appetizer",
  "brief_description": "This beef jerky tastes just like the store-bought kind. If you like those kinds, you'll enjoy this very much. You can use hickory-smoked flavoring instead, if desired.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together soy sauce, brown sugar, liquid smoke, garlic, paprika, and salt in a shallow glass baking dish. Lay beef strips in soy sauce mixture in a single layer. Cover the dish and refrigerate for at least 6 hours."
    },
    {
      "position": 2,
      "text": "Arrange beef strips in a dehydrator and let dry to desired doneness, about 6 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 360,

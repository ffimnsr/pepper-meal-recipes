  "id": "76af4ec1-90df-5517-a387-43fa83814648",
  "slug": "beef-and-broccoli-ramen-stir-fry-recipe-11707290",
  "name": "Beef and Broccoli Ramen Stir Fry",
  "recipe_type": "main",
  "brief_description": "This beef and broccoli ramen stir fry comes together quickly - adding the noodles with the steak prevents overcooking. Make sure you have all your ingredients prepped before you start cooking.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together broth, soy sauce, honey, cornstarch, vinegar, ginger, garlic, sesame oil, and crushed red pepper in a small bowl for the sauce."
    },
    {
      "position": 3,
      "text": "Bring water to a boil in a large saucepan. Break each ramen bundle in four pieces for shorter lengths. Add ramen and broccoli to boiling water, omitting seasoning packets. Cover and cook 3 minutes, stirring occasionally; drain."
    },
    {
      "position": 4,
      "text": "In a 12-inch skillet, heat vegetable oil over medium-high heat. Season steak strips with salt. Add steak strips to hot skillet and stir-fry until browned, about 2 minutes. Remove steak from skillet."
    },
    {
      "position": 5,
      "text": "Add sauce mixture to the skillet. Cook and stir until sauce is thickened and bubbly, about 2 minutes. Return steak and ramen mixture to skillet; toss to combine. Continue cooking and stirring until heated through, about 1 minute more."
    },
    {
      "position": 6,
      "text": "Garnish with green onions and toasted sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

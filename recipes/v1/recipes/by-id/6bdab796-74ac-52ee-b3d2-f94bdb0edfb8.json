  "id": "6bdab796-74ac-52ee-b3d2-f94bdb0edfb8",
  "slug": "healthy-ham-and-egg-muffins",
  "name": "Healthy Ham and Egg Muffins",
  "recipe_type": "breakfast",
  "brief_description": "Ham and egg muffins with a touch of feta cheese are a quick and easy breakfast to eat on the run and can be made in advance and frozen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray 12 muffin cups with cooking spray or line with paper liners."
    },
    {
      "position": 2,
      "text": "Combine eggs, spinach, red bell pepper, ham, egg whites, feta cheese, water, salt, and pepper in a large bowl. Ladle egg mixture into the prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set in the middle, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b3032b92-3661-5f34-9a92-1e18fc90640a",
  "slug": "new-york-style-crumb-cake-recipe-8667166",
  "name": "New York-Style Crumb Cake",
  "recipe_type": "dessert",
  "brief_description": "New York-Style crumb cake is a tender cake known for its mile-high crumble. Using cake flour in the crumble produces a lighter topping. The cake is sturdy enough to cut into bars but you may lose some of the crumbs!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking pan; set aside."
    },
    {
      "position": 2,
      "text": "For crumble, whisk cake flour, brown sugar, white sugar, cinnamon, and salt together in a bowl. Pour in melted butter. Crumble with your hands until mixture forms chunks. Let stand for at least 10 minutes for flour to absorb butter."
    },
    {
      "position": 3,
      "text": "For cake, stir all-purpose flour, sugar, baking powder, and salt together in another bowl until well combined. Add egg, buttermilk, oil, and vanilla and stir until well incorporated. Spread into the prepared pan."
    },
    {
      "position": 4,
      "text": "Add crumble over cake batter by breaking into large chunks."
    },
    {
      "position": 5,
      "text": "Bake until a wooden skewer inserted in the center comes out clean, for 45 to 55 minutes. Cool on a wire rack for at least 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f1839c6b-2e94-5823-abf5-7e3f9ea1f763",
  "slug": "crispy-brie-and-cranberry-rice-paper-bites-recipe-8734076",
  "name": "Crispy Brie and Cranberry Rice Paper Bites",
  "recipe_type": "appetizer",
  "brief_description": "A perfect pairing of gooey Brie cheese and tangy cranberry sauce comes together in crispy rice paper bites that add holiday flavors to traditional Vietnamese rolls.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cut the Brie into 15 equal-sized pieces, about 1/2 inch thick."
    },
    {
      "position": 3,
      "text": "Take a wide, shallow bowl or a deep-rimmed plate and fill with warm water. Take one rice paper wrapper and dip it into the water, submerging it for a few seconds until slightly softened. It should still feel a bit rigid - this is key as it\u2019ll make the wrapper easier to handle."
    },
    {
      "position": 4,
      "text": "Lay the soaked rice paper onto a cutting board. Place about 1 teaspoon cranberry sauce in the center, top with a slice of Brie, and a sprinkle of chopped rosemary."
    },
    {
      "position": 5,
      "text": "Fold the bottom half of the rice paper up and over the Brie."
    },
    {
      "position": 6,
      "text": "Fold one side over top and one side underneath."
    },
    {
      "position": 7,
      "text": "Finally, fold the top underneath."
    },
    {
      "position": 8,
      "text": "Repeat the soaking and wrapping process with the rest of your ingredients. Place parcels on a lightly greased baking sheet."
    },
    {
      "position": 9,
      "text": "Heat 1 tablespoon of oil in a non-stick frying pan over medium heat. Once hot, add a few rice paper parcels. Do not crowd the pan or they will stick to each other. Leave them to fry until the underside looks bubbly and lightly golden in places. Flip all the parcels over and let them cook on the other side."
    },
    {
      "position": 10,
      "text": "Remove parcels to a baking sheet. Continue frying remaining parcels, adding more oil as needed. Serve warm."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

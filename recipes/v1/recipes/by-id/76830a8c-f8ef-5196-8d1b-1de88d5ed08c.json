  "id": "76830a8c-f8ef-5196-8d1b-1de88d5ed08c",
  "slug": "baked-acorn-squash",
  "name": "Baked Acorn Squash",
  "recipe_type": "side",
  "brief_description": "Tender baked acorn squash seasoned with salt, pepper, brown sugar, cinnamon, and butter makes a deliciously simple fall side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Place squash in a shallow baking pan, cut-side down."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until tender, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Turn cut-side up; season with salt and pepper, dot with butter, and sprinkle with brown sugar and cinnamon."
    },
    {
      "position": 6,
      "text": "Return squash to oven and bake until squash is soft and lightly caramelized, about 20 minutes more. Serve warm, spooning melted butter-sugar mixture from the center over squash before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,

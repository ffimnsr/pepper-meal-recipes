  "id": "d36f5bfc-5698-5dbc-89e5-b604b04b7353",
  "slug": "grilled-bananas-with-coconut-caramel-sauce-recipe-11942993",
  "name": "Grilled Bananas with Coconut Caramel Sauce",
  "recipe_type": "dessert",
  "brief_description": "Bananas are grilled directly in their peel in this sweet treat sauced with a DIY coconut cream-caramel sauce. For best results, use ripe yet firm bananas\u2013they\u2019ll slip right out of their peel after grilling. Serve with coconut flakes and ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For caramel sauce, stir together brown sugar, coconut cream, butter, and corn syrup in a saucepan. Bring to a boil over medium heat, whisking occasionally to dissolve sugar. Reduce heat to medium-low and simmer, uncovered, 5 minutes. Remove from heat; whisk in vanilla and salt. Keep warm."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat an outdoor grill to medium heat (350 degrees F to 375 degrees F/175 degrees C to 190 degrees C). Lightly oil the grate"
    },
    {
      "position": 3,
      "text": "Halve bananas lengthwise, leaving peel on. Stir together white sugar and cinnamon in a small bowl. Sprinkle cut side of bananas with cinnamon-sugar."
    },
    {
      "position": 4,
      "text": "Grill bananas, cut sides down, until lightly browned and caramelized, 3 to 4 minutes. If you like, transfer to a cutting board and cut banana halves crosswise."
    },
    {
      "position": 5,
      "text": "Drizzle each banana serving with about 2 tablespoons warm caramel sauce (reserve remaining sauce for another use)."
    },
    {
      "position": 6,
      "text": "Serve with ice cream and toasted coconut (if using). (To store remaining sauce, cover and chill up to 1 week. Caramel will separate; stir and warm before using.)"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

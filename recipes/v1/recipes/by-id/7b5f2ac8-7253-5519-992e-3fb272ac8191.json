  "id": "7b5f2ac8-7253-5519-992e-3fb272ac8191",
  "slug": "monkey-bread-v",
  "name": "Five-Ingredient Monkey Bread",
  "recipe_type": "breakfast",
  "brief_description": "A delightfully gooey, pull-apart monkey bread recipe made easy with refrigerated biscuit dough and a simple cinnamon-sugar glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a tube pan. Mix together 3/4 cup sugar and cinnamon."
    },
    {
      "position": 2,
      "text": "Quarter biscuits with kitchen shears. Dip shears in water after each cut to keep biscuits from getting too sticky. Dip biscuits pieces into sugar mixture and place in prepared pan. Repeat until all biscuit pieces are used."
    },
    {
      "position": 3,
      "text": "Melt margarine and mix in 3/4 cup sugar; pour mixture over biscuits in pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 to 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

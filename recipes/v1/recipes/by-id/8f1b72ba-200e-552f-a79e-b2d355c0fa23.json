  "id": "8f1b72ba-200e-552f-a79e-b2d355c0fa23",
  "slug": "st-louis-pork-steaks",
  "name": "St. Louis Pork Steaks",
  "recipe_type": "main",
  "brief_description": "Grilled pork steaks are juicy and tender in this family recipe. A simple dry rub coats the steaks, which are basted with cider vinegar while on the grill.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-low heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Season both sides of pork steaks with some of the seasoned salt and pepper. Combine vinegar and water in a large bowl and stir in remaining salt and pepper."
    },
    {
      "position": 3,
      "text": "Place pork steaks on the preheated grill. Cook and baste with vinegar mixture on both sides of steaks during the first 15 minutes of grilling. Continue to cook steaks to desired doneness, 10 to 15 more minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Discard remaining vinegar mixture."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

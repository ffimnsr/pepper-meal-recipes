  "id": "87fc9dae-743e-5eec-9b70-51f8073638df",
  "slug": "london-broil-ii",
  "name": "London Broil",
  "recipe_type": "main",
  "brief_description": "This London broil recipe is a quick fix for an inexpensive cut. Mix up a flavorful marinade and let the meat sit overnight for a perfect flank steak.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix soy sauce, ketchup, vegetable oil, garlic, salt, pepper, and oregano together in a small bowl."
    },
    {
      "position": 3,
      "text": "Score both sides of steak in a diamond cut, about 1/8 inch deep. Rub marinade into both sides of the meat. Store in a covered dish or resealable plastic bag in the refrigerator to marinate for 5 to 6 hours, or overnight. Flip meat every few hours."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for high heat, and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Place steak on the preheated grill. Cook for 3 to 7 minutes per side, or to the desired doneness."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

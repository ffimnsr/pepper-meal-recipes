  "id": "57264a5f-0c1f-5ea9-b27e-30792a5bccba",
  "slug": "slow-cooker-cowboy-casserole-recipe-11688565",
  "name": "Slow Cooker Cowboy Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker cowboy casserole is a family-friendly, budget-friendly layered casserole of ground beef, sliced potatoes, and Cheddar cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Cook lean ground beef and onion over medium heat until beef is browned and onion is soft and translucent, 6 to 7 minutes. Add garlic and cook until fragrant, about 1 minute. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Stir soup and milk together in a bowl."
    },
    {
      "position": 4,
      "text": "Line a slow cooker with a slow cooker bag. Place a layer of potatoes, overlapping as needed, at the bottom of slow cooker. Season with salt and pepper. Top with a layer of ground beef, a layer of soup mixture and 1 cup cheese. Repeat layers with remaining ingredients."
    },
    {
      "position": 5,
      "text": "Cook on High until potatoes are fork tender, 3 to 4 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 190,
  "preparation_time_minutes": 15,

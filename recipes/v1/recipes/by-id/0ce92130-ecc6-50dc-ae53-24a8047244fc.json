  "id": "0ce92130-ecc6-50dc-ae53-24a8047244fc",
  "slug": "asparagus-cucumber-and-tomato-salad-recipe-11735098",
  "name": "Asparagus, Cucumber, and Tomato Salad",
  "recipe_type": "salad",
  "brief_description": "This asparagus, cucumber, and tomato salad combines lightly sauteed asparagus with cherry tomatoes, feta, and cucumber in a very simple honey, lemon, garlic, and mustard dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 teaspoons olive oil in a large, nonstick skillet over medium heat until hot. Add asparagus pieces and a pinch of salt. Cook, stirring frequently, until asparagus is bright green and tender-crisp, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and add to a bowl. Add cherry tomatoes, cucumber, feta cheese, and parsley; toss gently to combine."
    },
    {
      "position": 3,
      "text": "Add remaining 2 tablespoons olive oil, lemon juice, honey, Dijon mustard, and garlic to a small container with a lid; season with salt and pepper. Shake briskly until blended. Pour dressing over salad ingredients and toss to combine."
    },
    {
      "position": 4,
      "text": "Place salad in a serving dish; garnish with lemon zest and additional parsley sprigs, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

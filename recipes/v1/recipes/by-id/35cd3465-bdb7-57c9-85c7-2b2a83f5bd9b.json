  "slug": "slow-cooker-beef-stroganoff-i",
  "name": "Slow Cooker Beef Stroganoff",
  "recipe_type": "soup",
  "brief_description": "Creamy slow cooker beef stroganoff made with beef stew meat in a crock pot with mushroom soup, onion, and cream cheese for a comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beef, soup, onion, water, and Worcestershire sauce in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 hours or High for 5 hours. Stir in cream cheese just before serving to prevent curdling."
    },
    {
      "position": 3,
      "text": "Enjoy hot served over cooked noodles."
    }
  ],
  "servings": 4,

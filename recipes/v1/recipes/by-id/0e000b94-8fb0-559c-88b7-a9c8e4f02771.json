  "id": "0e000b94-8fb0-559c-88b7-a9c8e4f02771",
  "slug": "little-debbie-christmas-tree-truffles-recipe-8408468",
  "name": "These 3-Ingredient Little Debbie's Christmas Tree Truffles Are a Must-Try This Holiday Season",
  "recipe_type": "dessert",
  "brief_description": "Forget Oreo balls\u2014this year, you should be making these super-easy, 3-ingredient Little Debbie Christmas Tree Truffles for the holidays.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cakes in the bowl of a stand mixer fitted with a paddle attachment. Pulse mixer until cakes are crumbled, about 10 pulses."
    },
    {
      "position": 3,
      "text": "Add cream cheese and beat on low speed until smooth, about 1 minute."
    },
    {
      "position": 4,
      "text": "Using a 2 teaspoon cookie scoop, portion dough into 1-inch balls and arrange on a parchment-lined baking sheet. Freeze, uncovered, until firm, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Roll dough portions in your palms until smooth (dough will be sticky, gloves are recommended). Return to freezer until firm, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Microwave candy melts in a medium microwaveable bowl on 50% power until melted, stopping to stir every 30 seconds, 2 to 3 minutes total."
    },
    {
      "position": 7,
      "text": "Using a fork, dip truffles into melted candy melts, using side of the bowl to scrape off excess chocolate. Transfer to a clean parchment-lined baking sheet. Immediately sprinkle with sprinkles."
    },
    {
      "position": 8,
      "text": "Pipe cookie icing in curved lines over truffles. Set aside to set completely before serving, about 15 minutes. Recipe developed by Nicole Hopper"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

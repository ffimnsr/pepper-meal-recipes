  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5dcd8255-1827-565c-80d6-3f30abd2e384",
  "slug": "autumn-apple-slab-pie",
  "name": "Autumn Apple Slab Pie",
  "recipe_type": "dessert",
  "brief_description": "Apple pie with the addition of walnuts, raisins, and warm spices in a large quantity? Yes, please! Tastes like autumn in a pan!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, butter, and salt in a food processor. Pulse until mixture resembles coarse crumbs."
    },
    {
      "position": 2,
      "text": "Stir water and vinegar together in a bowl."
    },
    {
      "position": 3,
      "text": "Pour 1/2 the water mixture into the flour mixture in the food processor. Pulse to combine. Pour in remaining water mixture and pulse until dough just starts to come together but is still crumbly."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a wooden surface. Pat into a round shape and cut into 3 equal pieces. Form each into a disc about 5 inches wide, wrap each in plastic wrap, and refrigerate until ready to use."
    },
    {
      "position": 5,
      "text": "Toss apples and lemon juice together in a bowl. Sprinkle flour over apples and toss to coat. Gently mix in brown sugar, cinnamon, vanilla extract, salt, cloves, nutmeg, and allspice until apples are thoroughly coated. Fold in raisins and walnuts."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Flour a work surface and roll out 2 of the 3 dough pieces into a rectangle about 12x18 inches in size and about 1/4-inch thick. Gently place crust into a 10x15-inch jelly roll pan and press dough into corners. Trim excess dough so there is only 1 inch of overhang on all sides. Gently fold overhanging dough underneath itself and crimp along all edges of the pan. Use a fork to poke indentations sporadically in the bottom of the crust to prevent bubbling."
    },
    {
      "position": 8,
      "text": "Pour filling into the crust and spread out evenly."
    },
    {
      "position": 9,
      "text": "Roll out remaining dough piece on a floured surface to 1/4-inch thickness. Use decorative cookie cutters to cut out several pieces of pie dough and place cut-outs on top of filling in a pattern."
    },
    {
      "position": 10,
      "text": "Beat egg and water together in a bowl. Gently brush egg wash over the edges of the pie crust and on the pie crust cut-outs."
    },
    {
      "position": 11,
      "text": "Bake in the preheated oven until crust is golden brown and apples are soft when gently pierced with a knife, 55 to 65 minutes. Allow to cool completely before cutting and serving, about 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 55,

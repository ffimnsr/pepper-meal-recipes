  "id": "159b9259-2c31-5d80-8e7b-a67637ce257b",
  "slug": "french-dip-sliders-recipe-11751199",
  "name": "French Dip Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These French dip sliders may seem time-consuming to make, but they use a lot of shortcuts, so they're easier than you think. Caramelizing onions does take some time\u2014feel free to use crispy fried onions instead if you're in a rush.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Slice the slider buns in half horizontally without separating them, and place the bottom half in the prepared dish."
    },
    {
      "position": 3,
      "text": "In a heavy skillet over medium heat, melt 1 tablespoon butter; add onion and cook, stirring occasionally, until soft and golden, 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Layer roast beef evenly over bottom buns, then layer cheese slices over beef. Scatter caramelized onion over cheese, and add top buns back on."
    },
    {
      "position": 5,
      "text": "Melt remaining butter and stir in garlic powder, Worcestershire sauce, and parsley; brush over tops of buns. Cover with foil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. Uncover and bake until tops are golden and cheese is melted, about 5 minutes more."
    },
    {
      "position": 7,
      "text": "Meanwhile, for jus, combine bone broth, Worcestershire, soy sauce, garlic powder, onion powder, and fish sauce in a small saucepan. Bring to a simmer, stirring occasionally, over medium heat. Stir cornstarch and water together in a small bowl to create a smooth slurry; add to the broth, and simmer until slightly thickened, 2 to 3 minutes."
    },
    {
      "position": 8,
      "text": "Serve sliders with the jus for dipping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

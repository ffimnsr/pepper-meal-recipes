  "id": "78b870ec-f2b3-56f5-a981-c7d3106c849a",
  "slug": "roasted-red-pepper-soup",
  "name": "Roasted Red Pepper Soup",
  "recipe_type": "soup",
  "brief_description": "A puree of roasted red peppers is the base for this hearty pasta soup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place roasted red peppers in a blender or food processor, and blend until smooth."
    },
    {
      "position": 2,
      "text": "In a large saucepan, mix roasted red peppers, chicken broth, and mushrooms. Season with basil, oregano, garlic powder, salt, and pepper. Bring the mixture to a boil. Stir in tortellini, and continue cooking 8 to 10 minutes, or until pasta is al dente."
    }
  ],
  "servings": 8,

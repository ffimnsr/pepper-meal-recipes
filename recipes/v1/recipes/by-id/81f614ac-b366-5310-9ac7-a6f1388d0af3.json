  "schema_version": 1,
  "id": "81f614ac-b366-5310-9ac7-a6f1388d0af3",
  "slug": "marsala-cream-chicken-with-asparagus",
  "name": "Marsala Cream Chicken with Asparagus",
  "recipe_type": "main",
  "brief_description": "Using a deli-roasted chicken from your local grocery store speeds the prep time on this pasta dish with a creamy Marsala wine sauce.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook penne pasta at a boil until cooked through yet firm to the bite, about 11 minutes; drain."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large skillet over medium-high heat. Cook and stir shallot in melted butter until fragrant, about 5 minutes. Stir mushrooms, asparagus, and sun-dried tomatoes into shallot and butter mixture; cook and stir until asparagus begins to soften, about 10 minutes more."
    },
    {
      "position": 3,
      "text": "Pour chicken broth and Marsala wine into the skillet; bring to a boil, reduce heat to medium-low, and stir chicken and cream into mixture."
    },
    {
      "position": 4,
      "text": "Mix softened butter and flour into a paste in a bowl; stir into chicken mixture. Cook, stirring continually, until the flour is cooked and the liquid thickens, 1 to 2 minutes; ladle over the cooked penne pasta and top with Parmesan cheese to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

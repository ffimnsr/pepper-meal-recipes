  "id": "2962ddec-06b3-57c1-9cdb-20c9055c8db4",
  "slug": "cranberry-gelatin-salad-i",
  "name": "Cranberry Jell-O Salad",
  "recipe_type": "salad",
  "brief_description": "This holiday cranberry Jell-O salad is made with cherry-flavored gelatin, cranberry sauce, and crushed pineapple for fruity flavor. Top with pecans!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine boiling water and gelatin mix in a bowl; stir until gelatin is dissolved."
    },
    {
      "position": 3,
      "text": "Stir in cranberry sauce and crushed pineapple."
    },
    {
      "position": 4,
      "text": "Transfer to a large glass serving dish or 12 individual dishes. Sprinkle pecans on top."
    },
    {
      "position": 5,
      "text": "Chill until set, 3 to 4 hours for individual dishes, or 4 hours to overnight for one large serving dish."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

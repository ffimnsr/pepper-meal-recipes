  "id": "fe812d09-d6e0-52ea-a557-8ddd10404a9c",
  "slug": "pumpkin-spice-dutch-baby",
  "name": "Pumpkin Spice Dutch Babies",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin spice Dutch baby recipe combines warm cinnamon, ginger, cloves, and nutmeg for an impressive fall brunch that\u2019s ready in 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Preheat a cast iron skillet over high heat."
    },
    {
      "position": 2,
      "text": "Blend milk, eggs, flour, cinnamon, ginger, allspice, salt, vanilla extract, cloves, and nutmeg together in a blender until batter is smooth."
    },
    {
      "position": 3,
      "text": "Melt clarified butter in the preheated skillet; pour in batter."
    },
    {
      "position": 4,
      "text": "Bake on the middle rack of the preheated oven until golden brown and puffed up to your liking, 20 to 25 minutes. Dust with powdered sugar."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

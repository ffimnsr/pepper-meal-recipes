  "id": "281e7ced-f3a7-51a3-90ac-8b7ddbb713db",
  "slug": "navy-bean-soup-i",
  "name": "Navy Bean Soup",
  "recipe_type": "soup",
  "brief_description": "This flavorsome navy bean soup is slow-simmered to perfection for a hearty meal chock-full of tomatoes, celery, ham, herbs, and spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine 6 cups of water, beans, tomatoes, ham, onion, celery, Worcestershire sauce, minced garlic, bouillon, parsley, garlic powder, and bay leaf in a stock pot; bring to a boil. Reduce heat, cover, and simmer for two hours."
    },
    {
      "position": 3,
      "text": "Add 3 cups of water; stir in salt and pepper. Simmer for an additional two hours. Discard bay leaf before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 250,
  "preparation_time_minutes": 15,

  "id": "a2ea10ca-f507-5ab5-a41c-9a86777a0f53",
  "slug": "million-dollar-deviled-eggs-recipe-8669008",
  "name": "Million Dollar Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These million dollar deviled eggs have a secret ingredient. Butter lends a velvety texture, transforming a simple, classic deviled egg into something a bit more special.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice eggs in half lengthwise. Remove egg yolks, and place in a bowl."
    },
    {
      "position": 2,
      "text": "Add mayonnaise, butter, mustard, pickle juice, Sriracha, salt, and pepper to the yolks. Mash with a fork or use a small food processor until filling is very smooth and creamy."
    },
    {
      "position": 3,
      "text": "Evenly scoop or pipe egg yolk mixture into each egg white. Top with bacon crumbles. Move to the refrigerator to chill or serve immediately."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

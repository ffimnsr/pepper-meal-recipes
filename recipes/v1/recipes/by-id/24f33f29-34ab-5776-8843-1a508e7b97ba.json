  "id": "24f33f29-34ab-5776-8843-1a508e7b97ba",
  "slug": "cream-cheese-frosting-without-powdered-sugar",
  "name": "Cream Cheese Frosting without Powdered Sugar",
  "recipe_type": "dessert",
  "brief_description": "This cream cheese frosting without powdered sugar is made with cream cheese, brown sugar, honey, and butter, whipped in a jiffy to sweet perfection.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese, butter, brown sugar, vanilla, and almond extract with an electric mixer in a large bowl until mixture begins to stiffen."
    },
    {
      "position": 2,
      "text": "Pour in honey. Continue beating until a whipped consistency is reached; do not overmix as it will collapse. Use immediately or store covered in the refrigerator."
    }
  ],
  "servings": 8,

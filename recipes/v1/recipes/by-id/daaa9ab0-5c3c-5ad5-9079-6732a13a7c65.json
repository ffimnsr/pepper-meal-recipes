  "id": "daaa9ab0-5c3c-5ad5-9079-6732a13a7c65",
  "slug": "moms-chicken-and-dumplings-slow-cooker-version",
  "name": "Mom's Chicken and Dumplings (Slow Cooker Version)",
  "recipe_type": "soup",
  "brief_description": "Mom's chicken and dumplings have never been this easy thanks to this simple slow cooker recipe that calls for Bisquick\u00ae to make the dumplings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir chicken broth, chicken, potatoes, carrots, and broccoli together in a slow cooker."
    },
    {
      "position": 2,
      "text": "Whisk water and quick-mixing flour together in a bowl until a paste-like consistency is reached; stir into slow cooker mixture. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Cook on Low for 5 hours. Stir baking mix and milk together in a bowl. Drop milk mixture by the teaspoonful into the slow cooker on top of the chicken mixture. Continue cooking, turning the dumplings once, until dumplings are cooked through, about 1 hour more."
    }
  ],
  "servings": 6,

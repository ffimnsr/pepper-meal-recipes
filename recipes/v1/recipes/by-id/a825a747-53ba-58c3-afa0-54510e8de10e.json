  "id": "a825a747-53ba-58c3-afa0-54510e8de10e",
  "slug": "cream-cheese-kolacky",
  "name": "Cream Cheese Kolacky",
  "recipe_type": "appetizer",
  "brief_description": "Kolacky are cream cheese pastries that you can fill with your favorite fruit jam. You may want to double this recipe \u2014 these holiday treats go fast!",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix cream cheese and butter together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Gradually stir in flour until just combined. Shape dough into a ball; cover the bowl and refrigerate for at least 3 hours or overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 5,
      "text": "Roll out dough on a floured pastry board to a thickness of 1/8 inch. Cut into 2 \u00bd-inch squares and place about 1/2 teaspoon of jam or preserves in the center."
    },
    {
      "position": 6,
      "text": "Overlap opposite corners and pinch together to seal. Place on ungreased baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden, about 10 to 12 minutes. Cool on wire racks. Dust kolacky lightly with confectioners sugar."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

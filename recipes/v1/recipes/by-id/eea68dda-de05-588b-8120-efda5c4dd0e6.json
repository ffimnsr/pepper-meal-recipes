  "id": "eea68dda-de05-588b-8120-efda5c4dd0e6",
  "slug": "butternut-squash-and-turnip-soup",
  "name": "Butternut Squash and Turnip Soup",
  "recipe_type": "soup",
  "brief_description": "This spiced-up soup is naturally sweet and chock full of flavorful veggies. Leave it chunky, or puree it for a smooth soup. It's a tasty way to warm up on a chilly day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the butter and olive oil in a skillet over medium heat. Stir in the butternut squash, turnips, celery, onion, and garlic; cook and stir until the vegetables just begin to brown, about 10 minutes. Meanwhile, heat the chicken stock in a large pot over medium heat until simmering."
    },
    {
      "position": 2,
      "text": "Transfer the vegetables to simmering stock, and add the bay leaf, honey, pepper, nutmeg, coriander, cayenne pepper, and salt. Continue simmering until all the vegetables are softened, about 20 minutes. Remove the bay leaf before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

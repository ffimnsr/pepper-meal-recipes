  "id": "2de8987e-d425-5265-99cd-52e311c57a2e",
  "slug": "black-garlic-chocolate-protein-bites",
  "name": "Black Garlic Chocolate Protein Bites",
  "recipe_type": "appetizer",
  "brief_description": "Black garlic is naturally sweet and pairs perfectly with chocolate in these nutty, protein-rich truffles.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine peanut butter, protein powder, black garlic, and Neufchatel cheese in a mini food processor. Pulse until well combined."
    },
    {
      "position": 2,
      "text": "Roll mixture into sixteen 1-inch balls. Roll in sanding sugar. Serve immediately or store in an airtight container in the refrigerator."
    }
  ],
  "servings": 16,

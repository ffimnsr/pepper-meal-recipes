  "id": "0c7e7369-9c13-5097-92e8-45f16185b50f",
  "slug": "boozy-fresh-cranberry-orange-sauce",
  "name": "Boozy Fresh Cranberry-Orange Sauce",
  "recipe_type": "dessert",
  "brief_description": "This fresh cranberry-orange sauce is spiked with Cointreau\u00ae which gives the sauce an extra flavor boost. It's perfect with ham, chicken, or turkey, whether it's a holiday or not.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, sugar, water, orange zest, orange juice, orange-flavored liqueur, and salt in a saucepan over medium heat. Stir constantly and bring to a boil. Reduce heat to a simmer and cook, stirring frequently, for about 20 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and allow to cool. Sauce with thicken as it cools, to a soft-preserves stage. Refrigerate until ready to serve."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 25,

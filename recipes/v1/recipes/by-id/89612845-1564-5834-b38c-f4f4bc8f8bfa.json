  "id": "89612845-1564-5834-b38c-f4f4bc8f8bfa",
  "slug": "best-ever-popcorn-balls",
  "name": "Best Ever Popcorn Balls",
  "recipe_type": "dessert",
  "brief_description": "This best-ever popcorn balls recipe makes sweet, crunchy, irresistible treats to share and enjoy. They're great snacks for parties or holiday gifts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place popcorn in a large, heatproof bowl."
    },
    {
      "position": 2,
      "text": "Combine confectioners' sugar, marshmallows, corn syrup, butter, and water in a medium saucepan over medium heat. Cook, stirring often, until marshmallows melt and mixture begins to boil."
    },
    {
      "position": 3,
      "text": "Pour marshmallow mixture over popcorn. Stir with a buttered spatula until popcorn is evenly coated."
    },
    {
      "position": 4,
      "text": "Coat hands with cooking spray; quickly shape popcorn into balls before mixture cools and hardens."
    },
    {
      "position": 5,
      "text": "Wrap popcorn balls in plastic wrap or cellophane; store at room temperature for up to 1 week."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "dc74039f-b88a-53e9-b734-a56d303e21bd",
  "slug": "savory-pumpkin-hummus",
  "name": "Savory Pumpkin Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Traditional hummus gets a colorful twist with the addition of pumpkin puree. Serve with your favorite vegetables and pita bread!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pulse lemon juice, tahini, garlic, and salt together in a food processor or blender until smooth."
    },
    {
      "position": 3,
      "text": "Add garbanzo beans and olive oil and pulse until smooth."
    },
    {
      "position": 4,
      "text": "Add pumpkin, cumin, and cayenne pepper; process until well blended. Transfer hummus to a container with a lid and refrigerate at least 2 hours."
    },
    {
      "position": 5,
      "text": "Fold pumpkin seeds into hummus; garnish with paprika."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

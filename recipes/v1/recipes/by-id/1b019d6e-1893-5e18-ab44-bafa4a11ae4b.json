  "id": "1b019d6e-1893-5e18-ab44-bafa4a11ae4b",
  "slug": "kefta",
  "name": "Kefta",
  "recipe_type": "main",
  "brief_description": "This is a twist on the traditional meatloaf! A lamb loaf is made with a generous amount of parsley and onion, and seasoned elegantly with lemon zest and allspice. Serve with pita bread or rice.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the parsley, onions, lamb, allspice, lemon zest, salt and butter until well blended. Use your hands for best results. Place in a baking dish, or pat into a 2 inch tall round on a baking sheet with sides. Arrange tomato slices on top."
    },
    {
      "position": 3,
      "text": "Bake uncovered for 50 minutes in the preheated oven, until no longer pink and the internal temperature has reached at least 160 degrees F (72 degrees C). Serve with pita bread or rice."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

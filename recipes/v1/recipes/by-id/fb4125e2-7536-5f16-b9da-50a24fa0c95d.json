  "id": "fb4125e2-7536-5f16-b9da-50a24fa0c95d",
  "slug": "guava-cake",
  "name": "Guava Cake",
  "recipe_type": "dessert",
  "brief_description": "This unique old-fashioned guava cake recipe uses guava pulp and guava nectar to make a spice cake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Sift together flour, nutmeg, baking soda, cinnamon, and cloves in a bowl."
    },
    {
      "position": 3,
      "text": "Combine guava pulp and nectar in a separate bowl."
    },
    {
      "position": 4,
      "text": "Cream together butter and sugar in a mixing bowl. Add eggs, one at a time, beating well after each addition. Add flour mixture and guava mixture alternately to creamed mixture. Pour batter into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d1d38b92-4a56-5738-b734-1c493ac8783d",
  "slug": "pulled-pork-tamale-casserole",
  "name": "Pulled Pork Tamale Casserole",
  "recipe_type": "main",
  "brief_description": "Pulled pork, enchilada sauce, black beans, cornbread, and cheese are baked into this comforting pulled pork tamales casserole full of Mexican flavors.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pulled pork, enchilada sauce, green chile peppers, black beans, corn, onion, and olives in a large bowl. Spread mixture into a 9x13-inch casserole dish."
    },
    {
      "position": 3,
      "text": "Combine corn bread mix, milk, egg, and butter in a separate bowl. Pour over pork mixture. Spread Cheddar cheese on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and casserole is hot, about 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

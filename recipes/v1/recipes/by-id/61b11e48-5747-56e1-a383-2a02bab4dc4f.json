  "id": "61b11e48-5747-56e1-a383-2a02bab4dc4f",
  "slug": "chocolate-pudding-shots",
  "name": "Chocolate Pudding Shots",
  "recipe_type": "dessert",
  "brief_description": "These chocolate pudding shots made with pudding mix, milk, vodka, and Irish cream liqueur are a fun alternative to Jell-O shots at your next party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cold milk and pudding mix in a bowl with an electric mixer until smooth and beginning to thicken, 1 to 2 minutes. Stir in Irish cream liqueur and vodka, then fold in whipped topping until smooth."
    },
    {
      "position": 2,
      "text": "Spoon into 16 small cups. Serve immediately, or refrigerate or freeze until ready to serve."
    }
  ],
  "servings": 16,

  "id": "cd3c6113-5432-512d-86e4-7a3f576bd17b",
  "slug": "everything-bagel-casserole-recipe-7975027",
  "name": "Meet the Everything Bagel Casserole: The Ultimate Breakfast Comfort Food",
  "recipe_type": "breakfast",
  "brief_description": "Our newest breakfast casserole uses everything bagels for an extra-special texture and flavor. This recipe has all the elements of a classic breakfast bake, with thick-cut bacon, creamy eggs, and melty cheese, but gets an extra boost of savory flavor from everything-but-the-bagel seasoning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Grease a 2-qt. baking dish with cooking spray. Cook bacon in a large nonstick skillet over medium, stirring occasionally, until crisp, about 8 minutes. Transfer to a paper towel-lined plate."
    },
    {
      "position": 3,
      "text": "Toss together bagel pieces, cheese, and 1/2 cup of the bacon in a medium bowl; spread evenly in prepared baking dish. Set aside."
    },
    {
      "position": 4,
      "text": "Whisk together eggs, milk, and bagel seasoning in medium bowl."
    },
    {
      "position": 5,
      "text": "Pour egg mixture evenly over bagels."
    },
    {
      "position": 6,
      "text": "Sprinkle evenly with remaining 2 tablespoons bacon and dot with cream cheese pieces. Refrigerate, covered, for at least 1 hour and up to 24 hours."
    },
    {
      "position": 7,
      "text": "Preheat oven to 350\u00b0F. Bake, covered, until lightly bubbly around the edges, about 40 minutes. Uncover and continue to bake until browned and crisp on top, about 10 more minutes."
    },
    {
      "position": 8,
      "text": "Sprinkle with chives and serve hot. Recipe developed by Julia Levy"
    }
  ],
  "servings": 4,

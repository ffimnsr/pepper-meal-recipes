  "id": "3ddc36b3-c9e9-5eb2-aa2e-0f1a07a8e40c",
  "slug": "easy-shepherds-pie",
  "name": "Easy Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This shepherd's pie has a layer of ground beef in savory gravy with vegetables and a rich and cheesy potato topping for classic comfort food.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Brown meat in a large skillet."
    },
    {
      "position": 3,
      "text": "While the meat is browning, mix potatoes, cream cheese, 1/2 cup shredded cheese, and garlic until well blended."
    },
    {
      "position": 4,
      "text": "Drain meat. Return to skillet; stir in vegetables and gravy."
    },
    {
      "position": 5,
      "text": "Spoon into a 9-inch square baking dish."
    },
    {
      "position": 6,
      "text": "Cover with potato mixture and remaining 1/2 cup shredded cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until heated through, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

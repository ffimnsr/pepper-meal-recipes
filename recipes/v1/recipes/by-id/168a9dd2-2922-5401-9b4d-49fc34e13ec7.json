  "id": "168a9dd2-2922-5401-9b4d-49fc34e13ec7",
  "slug": "chilaquiles-breakfast-casserole-recipe-8684756",
  "name": "Chilaquiles Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Chef John's Mexican-inspired breakfast casserole is made with layered tortilla chips and cheese baked in a spiced chile sauce. Topped with fried or poached eggs, and plenty of delicious fixings, it's a great dish for breakfast or brunch.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Add enchilada sauce, salsa, Hatch chilies, lime juice, chili powder, cumin, oregano, and green onions to a bowl and whisk thoroughly."
    },
    {
      "position": 3,
      "text": "Toss Monterey Jack and Cheddar cheeses together; set aside."
    },
    {
      "position": 4,
      "text": "Transfer 1 ladle of sauce into the bottom of a 9x12-inch baking dish. Top with half the chips, arranging into an even layer. Ladle over half the remaining sauce. Top evenly with half the cheese mixture."
    },
    {
      "position": 5,
      "text": "Top with remaining chips, arranging into an even layer. Ladle over remaining sauce. Top evenly with the remaining cheese mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the casserole is heated through and cheese is starting to brown, 20 to 25 minutes."
    },
    {
      "position": 7,
      "text": "In the last few minutes of baking time, prepare the eggs by frying or poaching, or bake them on top of the casserole as shown in the video. See Chef's Note for directions."
    },
    {
      "position": 8,
      "text": "Serve casserole hot, topped with avocado, queso fresco, cilantro, sour cream, and hot sauce. Add a fried or poached egg to the top of each serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

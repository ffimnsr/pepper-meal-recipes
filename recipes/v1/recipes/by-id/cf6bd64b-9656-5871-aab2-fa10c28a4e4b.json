  "id": "cf6bd64b-9656-5871-aab2-fa10c28a4e4b",
  "slug": "chicken-wild-rice-soup-i",
  "name": "Chicken and Mushroom Wild Rice Soup",
  "recipe_type": "soup",
  "brief_description": "This deliciously creamy soup with chunks of chicken, sliced mushrooms, cooked wild rice, and hearty vegetables is flavored with spices and sherry.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Stir in onion, celery, and carrots and saut\u00e9 for 5 minutes. Add mushrooms and saut\u00e9 for 2 more minutes. Then add flour and stir well."
    },
    {
      "position": 3,
      "text": "Gradually pour in chicken broth, stirring constantly, until all has been added. Bring just to a boil, reduce heat to low and let simmer."
    },
    {
      "position": 4,
      "text": "Add rice, chicken, salt, curry powder, mustard powder, parsley, ground black pepper, almonds, and sherry."
    },
    {
      "position": 5,
      "text": "Allow to heat through, then pour in the half-and-half. Let simmer for 1 to 2 hours. (Note: Do not boil or your roux will break.)"
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 130,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "4e0e6464-781d-5e83-8f60-57dbf9b58093",
  "slug": "oven-baked-chicken-fajitas",
  "name": "Oven-Baked Chicken Fajitas",
  "recipe_type": "main",
  "brief_description": "Chicken seasoned with fajita seasoning, onion, and red bell peppers is cooked in the oven in this quick and easy baked fajita recipe.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a 9x13-inch glass baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread red bell peppers and onion in the baking dish."
    },
    {
      "position": 3,
      "text": "Coat chicken strips with a few pinches of the fajita seasoning mix. Heat 2 teaspoons vegetable oil in a skillet over medium heat; cook and stir seasoned chicken until browned, about 2 minutes per side."
    },
    {
      "position": 4,
      "text": "Place chicken in the baking dish with bell peppers and onion; top with remaining fajita seasoning mix and vegetable oil. Stir until chicken and vegetables are evenly coated."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, stirring halfway through baking, until chicken is no longer pink in the center, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Spoon chicken mixture into each tortilla and top with sour cream, salsa, and cilantro."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 34,
  "preparation_time_minutes": 25,

  "id": "6083730c-34cd-553a-a947-8c67e5f2f637",
  "slug": "hawaiian-pork-tenderloin",
  "name": "Hawaiian Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "Hawaiian-inspired pork tenderloin is coated in pineapple preserves, brown sugar, and a sprinkling of chili powder for a sweet and spicy main dish.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Drain pineapple juice and mandarin juice into a liquid measuring cup; stir to combine. Set fruit aside."
    },
    {
      "position": 3,
      "text": "Place pork tenderloin into a shallow 9x13-inch baking dish. Sprinkle brown sugar, chili powder, garlic powder, and black pepper over tenderloin, then spread with pineapple preserves. Arrange onion and bell peppers on and around tenderloin. Pour at least 1/2 cup pineapple-mandarin juice into the baking dish."
    },
    {
      "position": 4,
      "text": "Cook in the preheated oven for 25 minutes. Spoon mandarin oranges and pineapple over tenderloin and continue to cook until no longer pink in the center, 20 to 35 minutes longer. An instant-read thermometer inserted into the thickest part should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

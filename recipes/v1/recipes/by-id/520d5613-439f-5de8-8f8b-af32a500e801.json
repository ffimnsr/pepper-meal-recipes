  "schema_version": 1,
  "id": "520d5613-439f-5de8-8f8b-af32a500e801",
  "slug": "the-best-salmon-cakes-recipe-8764931",
  "name": "The Best Salmon Cakes",
  "recipe_type": "appetizer",
  "brief_description": "The best salmon cakes have just the right amount of onion, bell pepper, and parsley, are lightly seasoned with Dijon, Worcestershire, and Old Bay, and held together with just enough panko breadcrumbs. They fry up crisp and tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Set a wire rack inside a rimmed baking sheet and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat butter in a small skillet over medium-high heat. Add onion, bell pepper, and celery and cook, stirring often, until softened, about 4 minutes. Remove from heat, let cool slightly, and add to a bowl."
    },
    {
      "position": 3,
      "text": "Add parsley, Dijon mustard, mayonnaise, Worcestershire, Old Bay, egg, lemon juice, salt, and pepper, and mix until well combined. Stir in 2/3 cup bread crumbs until moistened. Fold in salmon and mix until just combined."
    },
    {
      "position": 4,
      "text": "Add remaining breadcrumbs to a shallow dish. Form salmon mixture into 6 balls. Roll each ball in breadcrumbs to cover completely; gently flatten balls into patties."
    },
    {
      "position": 5,
      "text": "Heat oil in a large skillet over medium-high heat. Add half patties to skillet and cook, turning once, until browned, about 3 minutes per side. Transfer patties to prepared wire rack. Repeat with remaining patties."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cooked through, 10 to 15 minutes. An instant read thermometer inserted near the center should read 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "6cb18d36-ad77-5807-819b-1ff5ed73a508",
  "slug": "calis-sinful-creme-brulee",
  "name": "Cali's Sinful Creme Brulee",
  "recipe_type": "dessert",
  "brief_description": "Chocolate lined ramekins filled with absolutely sinful creme brulee. Top with fresh berries when in season. Perfect for that special dinner, but easy enough to make everyday!",
  "cuisine": "French Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Place about 2 tablespoons of the chocolate chips into each of four 6 ounce ramekins. Place them in the microwave, and heat on full power for 30 second intervals. Stir, and continue heating until chocolate has melted. Spread to cover the sides and bottom of each ramekin."
    },
    {
      "position": 3,
      "text": "Bring a large pot of water to a boil."
    },
    {
      "position": 4,
      "text": "Meanwhile, in a saucepan, whisk together the cream, 1/4 cup sugar, and salt. Set over medium heat, and warm until steam rises from the surface. Then in a separate bowl, whisk together the egg yolks and vanilla. When the cream is hot, ladle a little bit into the egg yolks while whisking quickly. Ladle in a bit more to bring the yolks up to a high temperature without scrambling them. Whisk the yolk mixture into the rest of the cream. Ladle into the chocolate lined ramekins."
    },
    {
      "position": 5,
      "text": "Place a towel in the bottom of a baking dish, and place the filled ramekins on top of the towel. Place in the oven, and pour boiling water carefully into the baking dish until it comes half way up the sides of the ramekins. Cover the dish loosely with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake for 35 to 40 minutes in the preheated oven, just until the custard is set. Remove ramekins from the dish, and refrigerate for 4 to 6 hours."
    },
    {
      "position": 7,
      "text": "Before serving, sprinkle 1 tablespoon of sugar over the top of each creme brulee. Use a kitchen torch or your oven's broiler to caramelize the sugar. It may take 2 to 3 minutes in the broiler. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "953f546e-7971-5dd7-a477-126a6de763aa",
  "slug": "loukoumades",
  "name": "Loukoumades",
  "recipe_type": "dessert",
  "brief_description": "This loukoumades recipe makes yeast-risen dough puffs that are deep-fried until golden brown, drizzled with honey syrup, and sprinkled with cinnamon.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle yeast over 1 cup warm water in a small bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Mix together warm milk, sugar, and salt in a large bowl until sugar and salt are dissolved. Pour in yeast mixture and stir to combine."
    },
    {
      "position": 3,
      "text": "Beat in flour, eggs, and butter until mixture forms a smooth, soft dough. Cover the bowl and let rise at room temperature until doubled in volume, about 30 minutes. Stir dough well, cover, and let rise again for 30 more minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, mix together honey and 1/2 cup water in a small saucepan; bring to a boil over medium-high heat. Turn off the heat and allow honey syrup to cool."
    },
    {
      "position": 5,
      "text": "Heat 2 inches oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Place a large serving or soup spoon in a glass of water near dough. Scoop up about 2 tablespoons dough per puff with the wet spoon, drop it into the wet palm of your hand, and roll it back into the spoon to create a round shape. Do not overhandle the puffy, soft dough."
    },
    {
      "position": 7,
      "text": "Drop dough balls into hot oil in batches, wetting the spoon each time you make a dough ball. Fry in hot oil until golden brown on the bottom, then roll them over to cook the other side, 2 to 3 minutes per batch. Gently set loukoumades aside to drain on a paper towel-lined plate."
    },
    {
      "position": 8,
      "text": "Place loukoumades on a baking sheet. Drizzle with honey syrup and sprinkle with cinnamon. Serve warm."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

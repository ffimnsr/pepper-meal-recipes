  "id": "d985d080-ecc8-560f-8d63-1ff629d4e4fe",
  "slug": "traditional-indiana-breaded-tenderloin-sandwich",
  "name": "Traditional Indiana Breaded Tenderloin Sandwich",
  "recipe_type": "main",
  "brief_description": "This Indiana pork tenderloin sandwich with breaded cutlets, kaiser rolls, and traditional burger fixings could almost be called the official state food.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Flatten pork slices, one at a time, by placing in between two pieces of sturdy plastic and pounding with a meat mallet until 1/4-inch thick and about 3 1/2x5 inches in size."
    },
    {
      "position": 3,
      "text": "Whisk egg and milk together in a shallow bowl; stir in salt, pepper, garlic powder, onion powder, seasoned salt, marjoram, and oregano until well blended. Place bread crumbs into another shallow bowl."
    },
    {
      "position": 4,
      "text": "Dip each flattened cutlet into seasoned egg mixture, then dip into bread crumbs until thoroughly coated. Set breaded cutlets in a single layer on a piece of parchment or waxed paper."
    },
    {
      "position": 5,
      "text": "Heat oil in a large skillet until shimmering. Gently lower cutlets into the hot skillet and fry until golden brown, about 4 minutes per side. Drain on paper towels."
    },
    {
      "position": 6,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Place kaiser rolls, split-sides up, onto a baking sheet."
    },
    {
      "position": 7,
      "text": "Broil in the preheated oven until toasted and hot, about 1 minute."
    },
    {
      "position": 8,
      "text": "Remove from the oven and assemble sandwiches: Place fried cutlets on roll bottoms."
    },
    {
      "position": 9,
      "text": "Add toppings in the desired order: mayonnaise, ketchup, mustard, pickle, onion, tomato, and lettuce. Top sandwiches with roll tops and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 45,

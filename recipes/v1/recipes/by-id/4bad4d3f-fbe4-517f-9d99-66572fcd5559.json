  "id": "4bad4d3f-fbe4-517f-9d99-66572fcd5559",
  "slug": "authentic-mexican-corn-bread",
  "name": "Authentic Mexican Corn Bread",
  "recipe_type": "dessert",
  "brief_description": "This sweet Mexican cornbread uses two kinds of corn, condensed milk, and cornmeal to make a rich, sweet cornbread that's more like a spoon bread.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Whisk sweetened condensed milk and sugar together in a large bowl. Whisk in eggs, and vanilla. Stir in whole kernel corn, cream-style corn, and butter."
    },
    {
      "position": 3,
      "text": "Whisk cornmeal, flour, baking soda, and salt in a separate bowl; stir cornmeal mixture into the corn mixture."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake until a toothpick inserted into the center of the cornbread comes out clean, about 45 minutes. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "miso-ramen-stir-fry-recipe-11765179",
  "name": "Miso Ramen Stir Fry",
  "recipe_type": "main",
  "brief_description": "For these 15-minute miso ramen noodles with asparagus and mushrooms, discard that seasoning packet and amp up your instant ramen with fresh veggies and miso, which adds an umami flavor bomb.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of water to a boil, and add ramen, breaking up noodles if desired. Cook until tender, about 3 minutes, or according to package directions. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Heat sesame oil in a large skillet over medium heat, Add sliced mushrooms. Cook 4 minutes."
    },
    {
      "position": 3,
      "text": "Add rice vinegar and soy sauce. Cook 4 minutes."
    },
    {
      "position": 4,
      "text": "Add asparagus and cook 1 minute. Stir in butter and miso paste. Cook 1 minute more. Turn heat off."
    },
    {
      "position": 5,
      "text": "Stir in drained noodles. Ladle into serving dishes and garnish with scallions and sesame seeds."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

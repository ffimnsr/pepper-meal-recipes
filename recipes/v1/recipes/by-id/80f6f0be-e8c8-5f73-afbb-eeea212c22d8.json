  "slug": "egg-style-avocado-salad-sandwiches",
  "name": "Egg-Style Avocado Salad Sandwiches",
  "recipe_type": "salad",
  "brief_description": "Avocado and kala namak salt work together to create the texture and flavor of eggs in this egg-free egg-salad-like picnic salad.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, green onion, mustard, black pepper, and paprika together in a mixing bowl; add diced avocado, sprinkle with black salt, and stir."
    },
    {
      "position": 2,
      "text": "Divide salad between 4 bread slices. Top with remaining bread slices to finish sandwiches."
    }
  ],
  "servings": 4,

  "id": "531316a3-ab13-5cd6-ad9d-4d5bd59ccbf4",
  "slug": "chewy-peanut-butter-chocolate-chip-cookies",
  "name": "Chewy Peanut Butter Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter chocolate chip cookies are soft and chewy with great peanut butter flavor. They're easy to make and bake in less than 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream sugars, butter, and peanut butter in a large bowl until smooth."
    },
    {
      "position": 3,
      "text": "Beat in eggs one at a time, then stir in corn syrup, water, and vanilla."
    },
    {
      "position": 4,
      "text": "Combine flour, baking soda, and salt in a separate bowl; stir into peanut butter mixture. Fold in chocolate chunks."
    },
    {
      "position": 5,
      "text": "Scoop 1/4-cup portions of dough 3-inches apart onto ungreased baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are golden, 12 to 14 minutes."
    },
    {
      "position": 7,
      "text": "Allow cookies to cool for 1 minute before transferring to wire racks."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

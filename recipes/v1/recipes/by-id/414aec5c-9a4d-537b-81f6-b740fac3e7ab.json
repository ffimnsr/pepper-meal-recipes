  "id": "414aec5c-9a4d-537b-81f6-b740fac3e7ab",
  "slug": "chef-johns-spaghetti-alla-carbonara",
  "name": "Chef John's Spaghetti alla Carbonara",
  "recipe_type": "main",
  "brief_description": "Spaghetti alla carbonara in its authentic form: peppery, creamy without using cream, cheesy, and delicious.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook guanciale with olive oil and 1 teaspoon ground black pepper in a Dutch oven over medium-low heat until almost crisp, about 5 minutes. Reduce heat to low."
    },
    {
      "position": 2,
      "text": "Whisk eggs, 3 tablespoons Parmigiano-Reggiano cheese, 3 tablespoons Pecorino Romano cheese, and 1 teaspoon ground black pepper in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally until cooked through but firm to the bite, 10 to 12 minutes. Drain, reserving 1 cup of the pasta water."
    },
    {
      "position": 4,
      "text": "Pour reserved pasta water and drained spaghetti into the bacon-pepper mixture; stir to combine."
    },
    {
      "position": 5,
      "text": "Slowly pour egg mixture into the pasta mixture; cook, stirring constantly until the egg mixture forms a thick sauce, 1 to 2 minutes. Remove from heat."
    },
    {
      "position": 6,
      "text": "Stir remaining 3 tablespoons Parmigiano-Reggiano cheese and 3 tablespoons Pecorino Romano cheese into the pasta mixture and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9a1bb768-071c-5f19-8281-2cd9b2aff57e",
  "slug": "chicken-vegetable-stir-fry",
  "name": "Chicken & Vegetable Stir-Fry",
  "recipe_type": "main",
  "brief_description": "This quick and easy stir-fry dish, with chicken, mixed vegetables, and a tasty garlic-ginger soy sauce is so much better than take-out.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Stir the cornstarch, Swanson\u00ae Chicken Broth, and soy sauce in a small bowl until the mixture is smooth."
    },
    {
      "position": 2,
      "text": "Spray a 12-inch skillet with vegetable cooking spray and heat over medium-high heat for 1 minute. Add the chicken and stir-fry until well browned, about 5 minutes. Remove the chicken from the skillet."
    },
    {
      "position": 3,
      "text": "Add the vegetables, ginger and garlic powder to the skillet. Stir-fry until the vegetables are tender-crisp, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir the cornstarch mixture in the skillet. Cook and stir until the mixture boils and thickens. Return the chicken to the skillet and cook until the chicken is cooked through, 5 to 10 minutes. Serve the chicken mixture over the rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

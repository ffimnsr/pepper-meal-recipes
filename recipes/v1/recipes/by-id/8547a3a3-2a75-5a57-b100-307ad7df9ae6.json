  "id": "8547a3a3-2a75-5a57-b100-307ad7df9ae6",
  "slug": "seafood-fettuccine",
  "name": "Seafood Fettuccine",
  "recipe_type": "main",
  "brief_description": "This impressive seafood Alfredo recipe with shrimp, scallops, and fettuccine pasta is bound to rival your favorite restaurant's version of the same dish!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a large nonstick skillet over medium-high heat. Stir in green onions and garlic; cook for 1 minute. Stir in shrimp and scallops; cook for 3 minutes, then reduce the heat to medium-low."
    },
    {
      "position": 4,
      "text": "Pour in half-and-half and season with salt and pepper; stir constantly and bring to a simmer, making sure it does not boil. Gradually stir in 1/2 cup Parmesan; cook and stir for 1 more minute, then remove from the heat."
    },
    {
      "position": 5,
      "text": "Drain pasta. Add to the skillet and toss with sauce until thoroughly coated. Sprinkle remaining Parmesan over top and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

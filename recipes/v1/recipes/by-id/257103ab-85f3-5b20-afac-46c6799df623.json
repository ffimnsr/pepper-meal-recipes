  "id": "257103ab-85f3-5b20-afac-46c6799df623",
  "slug": "best-ziti-ever",
  "name": "Best Ziti Ever",
  "recipe_type": "main",
  "brief_description": "Ziti is layered with sausage, ricotta, mozzarella and tomato sauce, then baked until bubbling.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Place sausage in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside. In a large saucepan, heat marinara with 1 teaspoon basil until bubbling. In a medium bowl, mix together ricotta, 1 teaspoon Italian seasoning, salt and pepper."
    },
    {
      "position": 3,
      "text": "Spread bottom of a 9x13 inch baking dish with sauce. Layer 1/2 of the ziti, 1/2, the sausage, 1/2 of the ricotta, and 1/2 the mozzarella. Spoon half of the sauce over top. Repeat layers. Sprinkle top with remaining 1/2 teaspoons basil and Italian seasoning."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 40 to 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

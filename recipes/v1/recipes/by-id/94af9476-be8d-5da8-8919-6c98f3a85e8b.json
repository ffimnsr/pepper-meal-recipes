  "id": "94af9476-be8d-5da8-8919-6c98f3a85e8b",
  "slug": "fayes-pulled-barbecue-pork",
  "name": "Faye\u2019s Pulled Barbecue Pork",
  "recipe_type": "main",
  "brief_description": "Faye\u2019s pulled barbecue pork recipe starts with a pork roast seasoned with cayenne, garlic, and onions, simmered in barbecue sauce until fork-tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rub garlic, seasoning salt, black pepper, and cayenne pepper onto roast."
    },
    {
      "position": 2,
      "text": "Place roast in a large Dutch oven; fill halfway with water. Add onion; bring to a rolling boil over high heat. Reduce heat; simmer until meat falls off the bone, 3 to 4 hours (depending on the size of the roast)."
    },
    {
      "position": 3,
      "text": "Place hot roast in a serving bowl. Pour in barbecue sauce; stir until well combined. Serve on buns."
    }
  ],
  "servings": 11,

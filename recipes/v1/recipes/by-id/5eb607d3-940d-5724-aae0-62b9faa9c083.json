  "slug": "spicy-creamy-cucumber-salad-recipe-8737021",
  "name": "Spicy Creamy Cucumber Salad",
  "recipe_type": "salad",
  "brief_description": "You can knock out this spicy creamy cucumber salad super fast using a food processor to slice the cucumbers. Just a few quick ingredients\u2014Greek yogurt, lime juice, sweet Thai chili sauce, ketchup, and hot sauce\u2014are needed to make this refreshing salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sliced cucumbers into a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk Greek yogurt, lime juice, Thai chili sauce, ketchup, and hot sauce together in a small bowl until smooth; stir into sliced cucumbers. Refrigerate for 30 minutes before serving."
    }
  ],
  "servings": 4,

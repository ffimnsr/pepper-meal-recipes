  "id": "bff592f5-7781-5051-9643-36aae1e321bb",
  "slug": "onion-boil-recipe-11889694",
  "name": "Onion Boil",
  "recipe_type": "side",
  "brief_description": "The onion boil takes its cue from a seafood boil even though there is no boiling involved. The onions are filled with butter and a mix of Old Bay and Cajun seasoning, and baked until tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place each onion on a sheet of aluminum foil."
    },
    {
      "position": 2,
      "text": "Using a sharp knife or corer, make a well in the center of each onion, 1/3 of the way down the onion. Stuff 1 tablespoon butter into the well of each onion."
    },
    {
      "position": 3,
      "text": "Whisk olive oil, Cajun seasoning, Old Bay seasoning, and parsley flakes together in a cup until smooth. Pour oil mixture over butter in the well, allowing it to overflow and drip down the sides of the onions."
    },
    {
      "position": 4,
      "text": "Fold aluminum foil up around each onion creating a packet that sits upright. Place packets on a rimmed baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tender, about 1 hour. Peel away the tough outer layer, and discard. Transfer onions to serving plates, and enjoy."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

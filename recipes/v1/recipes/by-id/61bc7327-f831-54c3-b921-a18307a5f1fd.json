  "id": "61bc7327-f831-54c3-b921-a18307a5f1fd",
  "slug": "chicken-meatloaf-recipe-8635675",
  "name": "Chicken Meatloaf",
  "recipe_type": "dessert",
  "brief_description": "This chicken meatloaf is tender, moist, and well-seasoned. Parmesan cheese and Worcestershire sauce add umami flavor and it's topped with a sweet ketchup glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray an 8-x 4-inch loaf pan with cooking spray."
    },
    {
      "position": 3,
      "text": "Stir together chicken, onion, panko, Parmesan cheese, parsley, mayonnaise, garlic, thyme, Worcestershire sauce, salt, garlic powder, and black pepper in a large bowl until just combined. Do not overmix."
    },
    {
      "position": 4,
      "text": "Transfer mixture to the prepared loaf pan. Stir together ketchup, brown sugar, mustard, and vinegar in a small bowl until combined. Evenly spread ketchup mixture over the top of the meatloaf."
    },
    {
      "position": 5,
      "text": "Bake, uncovered, in the preheated oven until an instant-read thermometer inserted into thickest portion of meatloaf reads 165 degrees F (73 degrees C), 50 to 55 minutes. Remove loaf from oven, and let rest 10 minutes before slicing and serving. Recipe developed by Craig Ruff"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,
  "difficulty": "medium",

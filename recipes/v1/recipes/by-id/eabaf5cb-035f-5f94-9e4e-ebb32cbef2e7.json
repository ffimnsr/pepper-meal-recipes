  "id": "eabaf5cb-035f-5f94-9e4e-ebb32cbef2e7",
  "slug": "early-american-eggnog",
  "name": "Early American Eggnog",
  "recipe_type": "dessert",
  "brief_description": "This early American eggnog recipe is a creamy blend of egg yolks and whites, heavy cream, milk, rum, brandy, and sherry. Aging achieves its mellow taste.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Add brandy, sherry, rum, and whiskey to a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Place egg yolks and egg whites into two separate, large bowls; set egg whites aside. Beat egg yolks with an electric mixer until light and frothy; gradually beat in sugar until light colored. Slowly beat in brandy mixture; beat in milk and heavy cream, with the mixer running, until thoroughly blended. Beat egg whites using a clean beater until soft peaks form; gently fold into milk mixture."
    },
    {
      "position": 3,
      "text": "Pour eggnog into two clean, gallon-sized plastic milk containers. Refrigerate 5 to 10 days (10 for a smoother taste). Shake containers occasionally to keep alcohol from separating."
    },
    {
      "position": 4,
      "text": "Pour eggnog into a punch bowl; whisk to blend. Add vanilla ice cream; garnish with nutmeg."
    }
  ],
  "servings": 27,

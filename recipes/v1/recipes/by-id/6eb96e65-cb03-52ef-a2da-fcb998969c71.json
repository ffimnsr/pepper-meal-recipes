  "id": "6eb96e65-cb03-52ef-a2da-fcb998969c71",
  "slug": "cheeseburger-meatloaf",
  "name": "Cheeseburger Meatloaf",
  "recipe_type": "side",
  "brief_description": "This cheeseburger meatloaf is stuffed with Cheddar cheese inside, but it can be substituted with other ingredients, like saut\u00e9ed onions and mushrooms.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine beef, bread crumbs, onion, eggs, salt, and pepper in a large bowl; mix well. Pat out meat mixture into a 14x18-inch rectangle on a piece of wax paper."
    },
    {
      "position": 3,
      "text": "Spread cheese over meat, leaving a 3/4 inch border along the edges. Roll up jelly-roll fashion to enclose the filling and form a pinwheel loaf. Press meat in on both ends to enclose cheese. Place meatloaf in a 10x15-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cooked through, about 1 hour. An instant-read thermometer inserted into the center of meatloaf should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "96c082fa-ab1b-53dc-adbd-a3c184948f86",
  "slug": "air-fryer-smashed-broccoli-recipe-11910899",
  "name": "Air Fryer Smashed Broccoli",
  "recipe_type": "appetizer",
  "brief_description": "For this air fryer smashed broccoli, crisp bacon, melted Swiss cheese, and a lemon pepper panko topping transform simple broccoli into a cheesy, crave-worthy air fryer side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of salted water to a boil. Add broccoli florets and cook until fork-tender but not soft, 3 to 4 minutes. Drain well and pat completely dry."
    },
    {
      "position": 2,
      "text": "Place broccoli on a parchment-lined tray or plate. If florets are too large, cut them in half. Gently smash each floret with the bottom of a glass or measuring cup. Lightly spray with olive oil and sprinkle with lemon pepper and panko. Lightly press evenly over the smashed surfaces to help panko adhere. Mist lightly again with oil and sprinkle with a small portion of the bacon crumbles."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Arrange broccoli in a single layer and cook until edges are browned and panko is golden and crisp, 9 to 11 minutes."
    },
    {
      "position": 4,
      "text": "During the last 2 minutes, add Swiss cheese and remaining bacon crumbles. Air fry until cheese is melted, 1 to 2 minutes more. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

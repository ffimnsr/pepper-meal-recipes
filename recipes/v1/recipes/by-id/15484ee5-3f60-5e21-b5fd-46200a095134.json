  "id": "15484ee5-3f60-5e21-b5fd-46200a095134",
  "slug": "dark-chocolate-mint-truffles",
  "name": "Dark Chocolate Mint Truffles",
  "recipe_type": "dessert",
  "brief_description": "For a decadent holiday treat, transform a package of mint Oreo\u00ae cookies into minty chocolate truffles with just a few ingredients and a couple hours of chilling time.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Put entire bag of cookies in the bowl of a food processor and pulse to a fine crumb consistency. Transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "Add cream cheese and mix until well combined. Roll into 1-inch balls. Chill in the refrigerator for 1 hour."
    },
    {
      "position": 3,
      "text": "Place chocolate chips in a microwave-safe bowl. Microwave on high power for 1 minute. Stir, then repeat in 1-minute increments until melted and smooth. Mix in peppermint extract."
    },
    {
      "position": 4,
      "text": "Drop chilled balls in the chocolate to coat, let any excess drip off, and place on waxed paper. Sprinkle crushed candy canes over wet chocolate. Return to the refrigerator until chocolate sets, about 1 hour."
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

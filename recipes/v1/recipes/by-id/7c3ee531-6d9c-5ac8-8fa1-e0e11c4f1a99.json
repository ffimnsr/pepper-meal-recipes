  "slug": "spicy-pickle-jar-margarita-recipe-11978220",
  "name": "Spicy Pickle Jar Margarita",
  "recipe_type": "dessert",
  "brief_description": "This spicy pickle jar Margarita is the perfect cocktail for pickle lovers who enjoy a sweet, salty, and slightly spicy twist on a classic margarita. It's made right in the pickle jar for easy prep.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill the rest of the pickle jar with ice and add tequila, orange liqueur, lime juice and agave syrup. Place the lid back on and shake for 10 to 20 seconds."
    },
    {
      "position": 2,
      "text": "Serve over ice if desired."
    }
  ],
  "servings": 3,

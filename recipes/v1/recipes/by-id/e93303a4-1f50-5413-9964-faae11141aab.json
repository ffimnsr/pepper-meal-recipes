  "id": "e93303a4-1f50-5413-9964-faae11141aab",
  "slug": "italian-sushi-recipe-11806926",
  "name": "Italian Sushi",
  "recipe_type": "appetizer",
  "brief_description": "This Italian sushi\u2014trending on TikTok\u2014is nothing more than Italian favorites wrapped in prosciutto to resemble a sushi roll. They make a delicious, easy appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lay a piece of parchment on a work surface. Lay 3 slices of prosciutto on the paper, making sure each piece slightly overlaps the other."
    },
    {
      "position": 2,
      "text": "Cover prosciutto with basil leaves, about 5 leaves per slice. Layer tomatoes on top of basil. Season with pepper."
    },
    {
      "position": 3,
      "text": "Tear provolone cheese into pieces, then lay on top of tomatoes. Drizzle with balsamic vinegar."
    },
    {
      "position": 4,
      "text": "Starting from the bottom edge, gently roll prosciutto upwards into a cylinder. Wrap roll in the parchment, compressing it slightly so that it holds together."
    },
    {
      "position": 5,
      "text": "Refrigerate the roll until ready to serve. Slice the roll into even pieces and remove parchment. Drizzle with more balsamic vinegar."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "2949def1-6e0c-550f-8e81-1ce2ad7c9e99",
  "slug": "best-lemon-squares",
  "name": "Best Lemon Squares",
  "recipe_type": "dessert",
  "brief_description": "Lemony custard is baked on top of a simple crust in this recipe for the best lemon squares that has been passed down through many family generations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine 2 cups flour, butter, and 1/2 cup confectioners\u2019 sugar in the bowl of a food processor; pulse until mixture resembles coarse crumbs. Press into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust edges are golden brown, 18 to 22 minutes. Cool to room temperature."
    },
    {
      "position": 4,
      "text": "Beat white sugar, eggs, 1/4 cup flour, lemon juice, baking powder, and lemon zest together in a bowl using an electric mixer until light and fluffy; pour onto the cooled crust."
    },
    {
      "position": 5,
      "text": "Bake in the oven until custard is set, 25 to 28 minutes. Completely cool lemon squares; dust top with confectioners\u2019 sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

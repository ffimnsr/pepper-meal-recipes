  "id": "a0188354-9712-56c8-9610-740a7e6c4119",
  "slug": "vegetarian-stout-french-onion-soup",
  "name": "Vegetarian Stout French Onion Soup",
  "recipe_type": "soup",
  "brief_description": "This vegetarian French onion soup simmered with stout beer and mushrooms is a festive meal to prepare on St. Patrick's day. Serve with your favorite stout!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Toss mushrooms and flour together in a bowl until coated."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir coated mushrooms until browned, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Combine potatoes, carrots, onion, garlic, and rosemary in a large stockpot; top with cooked mushrooms. Stir beer, vegetable broth, tomato paste, Worcestershire sauce, salt, and pepper into vegetable mixture. Cover stockpot and cook over medium-high heat until vegetables are tender and soup flavors have blended, about 1 hour."
    },
    {
      "position": 4,
      "text": "Whisk water and cornstarch together in a bowl until dissolved; stir into soup until thickened, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Set oven rack about 5 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 6,
      "text": "Arrange bread slices on a baking sheet and sprinkle Swiss cheese over each slice."
    },
    {
      "position": 7,
      "text": "Broil bread in the preheated oven until cheese is melted and golden, about 1 minute."
    },
    {
      "position": 8,
      "text": "Ladle soup into bowls using a slotted ladle; top each with a bread slice. Ladle broth over bread until saturated."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

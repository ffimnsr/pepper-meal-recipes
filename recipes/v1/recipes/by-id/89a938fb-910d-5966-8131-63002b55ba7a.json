  "id": "89a938fb-910d-5966-8131-63002b55ba7a",
  "slug": "sour-cream-and-chive-mashed-potatoes",
  "name": "Sour Cream and Chive Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These delicious mashed potatoes made with sour cream, milk, and chives are velvety smooth and the perfect accompaniment to almost any main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot with enough water to cover 2 inches from the bottom. Bring to a boil. Cook potatoes in boiling water until fork tender, 20 to 25 minutes. Drain and mash well."
    },
    {
      "position": 2,
      "text": "Using a potato masher or an electric mixer, mix milk into mashed potatoes until fluffy. Stir in sour cream and chives until incorporated. Season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

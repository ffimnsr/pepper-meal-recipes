  "slug": "kimchi-bokkeumbap-kimchi-fried-rice-recipe-11907556",
  "name": "Kimchi-Bokkeumbap (Kimchi Fried Rice)",
  "recipe_type": "main",
  "brief_description": "This kimchi-bokkeumbap, or kimchi fried rice, transforms leftover rice into a spicy, tangy, umami flavor bomb in about 20 minutes. It's so good, you will be making extra rice just to make this dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add bacon and cook for 5 minutes. Add kimchi and cook for 5 minutes."
    },
    {
      "position": 2,
      "text": "Add rice and sesame oil. Cook and stir until heated through, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Transfer to serving dishes. Garnish with green onions and sesame seeds. Top each dish with prepared egg of choice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "b77e444b-1ab0-5756-b9a9-282ae9679e70",
  "slug": "chicken-cacciatore-delight",
  "name": "Chicken Cacciatore Delight",
  "recipe_type": "main",
  "brief_description": "Cut-up chicken pieces simmered in tomato sauce with onion, green pepper, and mushrooms makes a great, simple Italian-inspired meal.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse and pat the chicken pieces dry with paper towels, then coat with flour in a bowl or a resealable plastic zipper bag. Heat the peanut oil in a large skillet over medium heat, and brown the chicken on all sides until golden brown, about 15 minutes. Remove the chicken, and set aside in a bowl."
    },
    {
      "position": 2,
      "text": "Cook the onions, green bell pepper, and garlic in the oil left in the hot skillet until the onion slices are translucent, about 5 minutes; stir in mushrooms, and cook and stir until the mushrooms have given up their liquid and are almost tender, about 10 more minutes. Pour in crushed tomatoes, tomato sauce, salt, oregano, and sherry, and mix well; stir in the chicken pieces and any juices that have collected."
    },
    {
      "position": 3,
      "text": "Simmer until the chicken meat is tender and no longer pink in the thickest part of a thigh, and the juices run clear, 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

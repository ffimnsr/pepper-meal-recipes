  "id": "ed5900ee-224b-5a61-9ca2-4ba37666a507",
  "slug": "mckagens-beef-jerky",
  "name": "McKagen's Beef Jerky",
  "recipe_type": "appetizer",
  "brief_description": "Balsamic vinaigrette combines with teriyaki and Worcestershire sauces to flavor this jerky.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine the teriyaki sauce, Worcestershire sauce, balsamic vinaigrette, garlic powder, onion powder, liquid smoke, salt, and hot sauce in a resealable plastic bag. Add the meat strips and coat evenly with the marinade. Seal and refrigerate 24 hours."
    },
    {
      "position": 2,
      "text": "Preheat an oven to 175 degrees F (80 degrees C). Line a baking sheet with aluminum foil and place a wire rack on top."
    },
    {
      "position": 3,
      "text": "Remove the beef strips from the marinade and shake off excess marinade. Discard the remaining marinade. Place the meat strips onto the wire rack and sprinkle with black pepper. Bake in the preheated oven until firm and dry, at least 3 hours. Allow the jerky to cool completely before storing in a sealed container."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

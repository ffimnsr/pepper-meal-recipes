  "id": "787e5e45-f530-54e0-8679-ae5af842291b",
  "slug": "artichoke-dip-i",
  "name": "Warm Cheesy Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This warm artichoke dip is made with mozzarella and Parmesan for a double dose of cheese. Serve alongside crackers or French bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, thoroughly mix mayonnaise, Parmesan, artichoke hearts, mozzarella, and garlic powder; transfer to an 8-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes, or until the surface is lightly browned and bubbly. Sprinkle with paprika and serve warm."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "64835ee1-c6b5-5f01-a60f-41c9fd7fc966",
  "slug": "caramel-bacon-stuffed-dates-recipe-11811164",
  "name": "Caramel Bacon Stuffed Dates",
  "recipe_type": "appetizer",
  "brief_description": "These caramel bacon stuffed dates are a delicious sweet-savory appetizer. But add the thin-sliced date \"antennae\" and they become a delightfully creepy-crawly Halloween treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove about 4 dates from the package. Slice very thinly lengthwise; set aside."
    },
    {
      "position": 2,
      "text": "Fill each remaining date with a spoonful of cream cheese and place on a plate or serving platter."
    },
    {
      "position": 3,
      "text": "Drizzle each date with caramel sauce and sprinkle with bacon crumbles."
    },
    {
      "position": 4,
      "text": "Place 2 thin slices at the front of each date for \"antennae\"."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": null,

  "id": "45b63baa-908e-519f-a2f1-b03fa8dc4063",
  "slug": "tapioca-rice-pudding",
  "name": "Tapioca Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This is a recipe I found in my grandmother's secret book it is so good I have to share it with the world - it might make it a better place! Serve with whipped cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Soak the tapioca pearls in milk overnight in the refrigerator."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Combine the tapioca, milk, and rice in a large pan over medium heat. Stir in the eggs, sugar, salt, cinnamon and nutmeg. Cook over medium heat, stirring constantly for 15 minutes. Do not bring to a boil. Pour into a 9x13 inch baking dish, and stir in raisins. Cover with a lid or aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake for 40 minutes in the preheated oven, but stir in the vanilla after 20 minutes. Cool to room temperature, then refrigerate until cold."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

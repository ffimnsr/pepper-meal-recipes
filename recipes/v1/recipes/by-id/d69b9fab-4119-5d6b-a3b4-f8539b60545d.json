  "id": "d69b9fab-4119-5d6b-a3b4-f8539b60545d",
  "slug": "homemade-granola-with-ginger",
  "name": "Homemade Granola with Ginger",
  "recipe_type": "dessert",
  "brief_description": "This homemade granola features crystallized ginger, nuts, seeds, oats, and a slew of spices, such as turmeric and cardamom, which add a sweet-spicy taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together rolled and quick-cooking oats, pecans, walnuts, almonds, and pepitas in a large bowl until well combined. Spread out evenly on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Remove from the oven and transfer to the same large bowl. Reduce oven temperature to 225 degrees F (110 degrees C)."
    },
    {
      "position": 4,
      "text": "Stir together maple syrup, coconut oil, crystallized ginger, turmeric, ground ginger, cinnamon, salt, cardamom, and pepper in a medium bowl until well combined; pour over oats-nuts mixture and mix thoroughly. Transfer mixture onto the baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the oven for 30 minutes. Turn the oven off and leave granola in the oven for 1 hour."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool to room temperature, about 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

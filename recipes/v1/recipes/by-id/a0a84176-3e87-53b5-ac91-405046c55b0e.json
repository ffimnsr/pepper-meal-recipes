  "id": "a0a84176-3e87-53b5-ac91-405046c55b0e",
  "slug": "big-mac-sliders-recipe-8415430",
  "name": "Big Mac Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These fun big mac sliders are easy to make and the perfect appetizer for game day or any other viewing party,",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Line a large-rimmed baking sheet with aluminum foil. Press ground chuck into a thin, even 11- x 9-inch rectangle on prepared baking sheet. Sprinkle evenly with salt, pepper, and garlic powder."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until a thermometer inserted into thickest portion of beef registers 140\u00b0F to 145\u00b0F, about 10 minutes. Using 2 large spatulas, transfer beef to a cutting board lined with paper towels; discard foil."
    },
    {
      "position": 4,
      "text": "Line same baking sheet with a new piece of foil; lightly coat with cooking spray. Using a serrated bread knife, cut rolls in half horizontally, keeping top halves and bottom halves intact. Place the bottom half of rolls cut-side up on prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Spread Big Mac Sauce evenly over bottom half of rolls."
    },
    {
      "position": 6,
      "text": "Place beef patty over sauce, topping evenly with cheese slices, pickles, and onion."
    },
    {
      "position": 7,
      "text": "Place top half of rolls over pickles and onions. Brush tops and sides of rolls with melted butter, and sprinkle evenly with sesame seeds."
    },
    {
      "position": 8,
      "text": "Bake in preheated oven until top buns are golden brown and cheese is melted, about 10 minutes."
    },
    {
      "position": 9,
      "text": "Carefully remove bun tops, sprinkle lettuce in an even layer, and replace bun tops."
    },
    {
      "position": 10,
      "text": "Cut sliders into 12 portions; serve with additional Big Mac Sauce."
    },
    {
      "position": 11,
      "text": "Whisk together all ingredients in a small bowl until fully combined. Chill in an airtight container for up to 5 days. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

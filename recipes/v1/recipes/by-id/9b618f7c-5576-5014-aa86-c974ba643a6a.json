  "id": "9b618f7c-5576-5014-aa86-c974ba643a6a",
  "slug": "meatless-grain-bowl-recipe-8584633",
  "name": "Meatless Grain Bowl",
  "recipe_type": "dessert",
  "brief_description": "This meatless grain bowl is made with tofu, \"jerked\" to perfection. Roasted sweet potatoes multicolored bell peppers, and black beans complete the vegetarian bowl.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes. Keep warm."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Toss cubed sweet potatoes in 1 tablespoon oil. Spread evenly on a baking sheet."
    },
    {
      "position": 4,
      "text": "Roast sweet potatoes in the preheated oven until tender but not too soft, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Heat a cast iron skillet with 1 tablespoon coconut oil over medium-high heat; add red, green, and orange bell peppers and saute for 2 to 3 minutes. Remove from the skillet and set aside."
    },
    {
      "position": 6,
      "text": "Add remaining 1 tablespoon coconut oil to the same skillet. Add tofu evenly. Cook for 2 minutes and gently flip to the other side. Continue cooking, turning occasionally, until tofu gets a little crisp on the edges, 6 to 8 minutes."
    },
    {
      "position": 7,
      "text": "Add jerk marinade, being deliberate about making sure tofu is covered. Once tofu starts to caramelize from the marinade, remove from heat."
    },
    {
      "position": 8,
      "text": "Warm black beans in a microwave-safe dish until hot, 2 to 3 minutes, stirring every 30 seconds."
    },
    {
      "position": 9,
      "text": "Assemble grain bowls: divide rice, tofu, peppers, sweet potatoes, and black beans evenly into individual serving bowls."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

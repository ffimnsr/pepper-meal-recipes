  "slug": "hawaiian-millionaire-pie",
  "name": "Hawaiian Millionaire Pie",
  "recipe_type": "dessert",
  "brief_description": "This no-bake Hawaiian-inspired millionaire pie features a deliciously creamy maraschino cherry, walnut, and pineapple filling.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large mixing bowl, fold pineapple, lemon juice, whipped topping, cherries, condensed milk, and walnuts together. Pour into pie shell and chill for at least one hour before serving."
    }
  ],

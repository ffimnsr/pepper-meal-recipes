  "id": "651cfae6-87da-5daf-b76d-b5ffbecda502",
  "slug": "creamy-cauliflower-egg-salad",
  "name": "Creamy Cauliflower Egg Salad",
  "recipe_type": "salad",
  "brief_description": "A creamy salad made with cauliflower, celery, and hard-cooked eggs looks and tastes like potato salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cauliflower into a microwave-safe bowl, cover, and cook in microwave oven until tender, about 7 minutes. Uncover and cool for 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir eggs, creamy salad dressing, celery, green onions, sour cream, apple cider vinegar, sugar, salt, and black pepper in a bowl until thoroughly combined. Mix cauliflower into dressing. Chill at least 1 hour before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

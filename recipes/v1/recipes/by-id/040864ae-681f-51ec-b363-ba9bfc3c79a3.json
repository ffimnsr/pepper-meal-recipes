  "schema_version": 1,
  "id": "040864ae-681f-51ec-b363-ba9bfc3c79a3",
  "slug": "tvs-grits-casserole",
  "name": "TV's Grits Casserole",
  "recipe_type": "side",
  "brief_description": "Sausage, bell pepper, onion, and celery work with grits in this Southern recipe.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Butter a 2-quart casserole dish."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium heat; cook the sausage in the hot skillet until completely browned, 5 to 7 minutes. Add the onion, celery, and green pepper; cook and stir until tender, about 5 minutes more. Transfer to the prepared casserole dish."
    },
    {
      "position": 3,
      "text": "Bring the grits, water, and salt to a boil in a saucepan; reduce heat to medium-low, cover, and simmer until the grits are tender, about 30 minutes. Add to the sausage mixture in the casserole dish and stir; press into an even layer. Pour the soup over the mixture in an even layer. Sprinkle the Cheddar cheese over the soup."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the cheese has melted, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "758ffe01-fb41-5149-9a93-4783eb2b1775",
  "slug": "ultra-creamy-mashed-potatoes",
  "name": "Ultra Creamy Mashed Potatoes",
  "recipe_type": "soup",
  "brief_description": "Potatoes, chicken broth, half and half, and butter is all you need for these ultra creamy mashed potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes and Swanson\u00ae Chicken Broth in a 3-quart saucepan. Heat over high heat to a boil, then cover and cook (still on high) for 10 minutes or until the potatoes are tender."
    },
    {
      "position": 2,
      "text": "Drain the potatoes, reserving the broth."
    },
    {
      "position": 3,
      "text": "Mash the potatoes with the cream, butter and about 1/2 cup reserved broth (the consistency will vary depending on the type of potatoes used, so you may want to add more of the reserved broth- see ingredient note). Season with salt and freshly ground black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "cc69d7fe-9728-5910-a731-476808ad8502",
  "slug": "blackberry-lemon-cornbread-muffins-recipe-11906449",
  "name": "Blackberry Lemon Cornbread Muffins",
  "recipe_type": "dessert",
  "brief_description": "These blackberry lemon cornbread muffins are tender and moist. Savory cornmeal joins sweet blackberries, and lemon brightens the flavor. If you\u2019re not into hot honey, regular honey is fine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a standard 12-well muffin tin with cooking spray or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine flour, cornmeal, brown sugar, baking powder, and salt."
    },
    {
      "position": 3,
      "text": "In a small bowl, whisk milk, butter, hot honey, egg, lemon juice, and lemon zest; pour into dry ingredients, and stir until just combined. Gently fold in the blackberries, and spoon batter equally into the prepared muffin tin."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. A toothpick inserted near the center should come out clean. Allow to cool for 5 minutes, remove from the pan, and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

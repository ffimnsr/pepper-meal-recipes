  "id": "a178dbce-3b82-5df1-821e-743c3f430f5f",
  "slug": "juiciest-hamburgers-ever",
  "name": "Juiciest Hamburgers Ever",
  "recipe_type": "main",
  "brief_description": "Juicy, flavorful hamburgers are just what you need for a perfect summer BBQ, party, or potluck, and these are super easy to prepare for guests.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an outdoor grill for high heat and lightly oil the grill grate."
    },
    {
      "position": 2,
      "text": "Combine ground beef, bread crumbs, evaporated milk, egg, Worcestershire sauce, cayenne pepper, and garlic in a large bowl using your hands."
    },
    {
      "position": 3,
      "text": "Form mixture into 8 patties."
    },
    {
      "position": 4,
      "text": "Cook patties on the preheated grill until browned and no longer pink, about 5 minutes per side. Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "9f601b84-3d1f-5715-a801-517d3d6decab",
  "slug": "baked-hawaiian-sandwiches",
  "name": "Baked Hawaiian Sandwiches",
  "recipe_type": "appetizer",
  "brief_description": "Cheesy ham and turkey sliders on Hawaiian rolls, topped with a honey-mustard sauce, then baked until golden brown. Sure to be a hit!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a rack into lower half of the oven and preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange bottom halves of Hawaiian rolls on a baking sheet. Place a half slice each of ham, Swiss cheese, smoked turkey, and provolone cheese onto each roll bottom. Place top halves onto each bottom to make sandwiches."
    },
    {
      "position": 3,
      "text": "Melt butter in a saucepan over low heat; stir in sugar, dried onion flakes, poppy seeds, and honey mustard until mixture is smooth and sugar has dissolved, about 2 minutes; brush over the tops of each sandwich."
    },
    {
      "position": 4,
      "text": "Bake sandwiches on the preheated oven's lower rack until tops are golden brown and fillings are hot, about 15 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

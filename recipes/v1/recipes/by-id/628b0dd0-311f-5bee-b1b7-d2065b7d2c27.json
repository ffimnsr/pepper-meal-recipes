  "schema_version": 1,
  "id": "628b0dd0-311f-5bee-b1b7-d2065b7d2c27",
  "slug": "grilled-chicken-pineapple-sliders",
  "name": "Grilled Chicken Pineapple Sliders",
  "recipe_type": "main",
  "brief_description": "This grilled chicken pineapple sliders recipe grills marinated chicken plus pineapple rings, then layers onto Hawaiian rolls with red onion and lettuce.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk lemon juice, lime juice, cider vinegar, salt, and black pepper together in a large glass or ceramic bowl. Add chicken; toss to coat. Cover the bowl with plastic wrap; marinate in the refrigerator for 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove chicken from marinade; shake off excess. Discard remaining marinade. Cook chicken on the preheated grill until juices run clear when pierced with a fork, 5 to 7 minutes per side. Grill pineapple until heated through and grill marks appear, 2 to 3 minutes per side."
    },
    {
      "position": 4,
      "text": "Spread 1 teaspoon teriyaki sauce on bottom half of 1 toasted roll; add 1 lettuce leaf, 1 halved chicken breast, 1 pineapple slice, 1 onion slice, and top half roll. Repeat with the remaining teriyaki sauce, rolls, lettuce, chicken, pineapple, and onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

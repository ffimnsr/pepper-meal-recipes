  "id": "8f041a29-a2c2-5add-abc4-8aa582fb7531",
  "slug": "healing-cabbage-soup",
  "name": "Healing Cabbage Soup",
  "recipe_type": "soup",
  "brief_description": "This simple, comforting cabbage soup with diced tomatoes and garlic is sure to warm you up on a cold day or if you're feeling under the weather.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large stockpot over medium heat. Stir in onion and garlic; cook until onion has softened, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in water, bouillon, salt, and pepper. Bring to a boil, then stir in cabbage. Simmer until cabbage wilts, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in tomatoes. Return to a boil, then simmer 15 to 30 minutes, stirring often."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

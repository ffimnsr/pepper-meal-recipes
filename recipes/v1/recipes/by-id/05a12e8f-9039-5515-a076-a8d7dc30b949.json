  "id": "05a12e8f-9039-5515-a076-a8d7dc30b949",
  "slug": "maple-glazed-ribs",
  "name": "Maple Glazed Ribs",
  "recipe_type": "dessert",
  "brief_description": "Baby back ribs are basted with a sweet and pungent sauce made from maple syrup, brown sugar, Worcestershire, mustard, ketchup and vinegar.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place ribs in a large pot, and cover with water. Cover, and simmer for 1 hour, or until meat is tender. Drain, and transfer ribs to a shallow dish."
    },
    {
      "position": 2,
      "text": "In a small saucepan, stir together the maple syrup, brown sugar, ketchup, vinegar, Worcestershire sauce, salt, and mustard powder. Bring to a low boil, and cook for 5 minutes, stirring frequently. Cool slightly, then pour over ribs, and marinate in the refrigerator for 2 hours."
    },
    {
      "position": 3,
      "text": "Prepare grill for cooking with indirect heat. Remove ribs from marinade. Transfer marinade to a small saucepan, and boil for several minutes."
    },
    {
      "position": 4,
      "text": "Lightly oil grate. Cook for about 20 minutes, basting with the cooked marinade frequently, until nicely glazed."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

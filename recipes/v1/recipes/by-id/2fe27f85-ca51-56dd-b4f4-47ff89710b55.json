  "id": "2fe27f85-ca51-56dd-b4f4-47ff89710b55",
  "slug": "creamy-cheesy-spinach-dip",
  "name": "Creamy Cheesy Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "This hot spinach dip without mayo or sour cream is extra cheesy and delicious with four kinds of cheese, melted to perfection for an irresistible dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 1 1/2-quart shallow baking dish with 1 teaspoon olive oil."
    },
    {
      "position": 2,
      "text": "Heat 2 teaspoons olive oil in a large pot over medium heat. Cook and stir onion and garlic in hot oil until lightly browned, 4 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Add spinach and simmer until spinach is hot, about 5 minutes. Drain any liquid from the mixture and transfer to a bowl."
    },
    {
      "position": 4,
      "text": "Pour milk into the pot and return it to medium heat. Melt cream cheese into milk; cook and stir together, about 3 minutes. Return spinach mixture to pot with 1/2 cup mozzarella cheese and Cheddar cheese; stir to combine. Season the mixture with Worcestershire sauce, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Pour the mixture into the prepared baking dish and top with remaining 1/2 cup mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bubbly and golden brown on top, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

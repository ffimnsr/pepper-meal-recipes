  "id": "6b4a1f63-5c09-5721-be93-9ef45b228b24",
  "slug": "air-fried-purple-yam-fries-with-sour-cream-sriracha-sauce",
  "name": "Air-Fried Purple Yam Fries with Sour Cream Sriracha Sauce",
  "recipe_type": "dessert",
  "brief_description": "Use purple yams or sweet potatoes to make fries in your air fryer. Serve them with a delicious dipping sauce made of cool sour cream and spicy Sriracha.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 320 degrees F (160 degrees C)."
    },
    {
      "position": 2,
      "text": "Place yam fries into a bowl. Add olive oil and Sriracha-flavored salt; toss to coat evenly. Pour into the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook in the preheated air fryer for 16 minutes. Increase the heat to 400 degrees F (200 degrees C). Shake the basket and cook for 5 minutes more."
    },
    {
      "position": 4,
      "text": "Meanwhile, mix sour cream and Sriracha sauce in a bowl. Serve alongside yam fries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

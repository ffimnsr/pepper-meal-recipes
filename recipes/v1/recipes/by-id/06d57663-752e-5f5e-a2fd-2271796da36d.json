  "slug": "buffalo-chicken-dip-in-the-slow-cooker",
  "name": "Buffalo Chicken Dip in the Slow Cooker",
  "recipe_type": "appetizer",
  "brief_description": "A perfect dip while watching the Super Bowl\u00ae, this slow cooker chicken dip flavored with Buffalo wing sauce comes together quickly and is sure to please.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, cream cheese, Colby-Jack cheese, goat cheese, Buffalo wing sauce, blue cheese dressing, bell pepper, onion, and celery in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 4 hours. Transfer dip to a bowl and sprinkle with chopped scallions."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 240,

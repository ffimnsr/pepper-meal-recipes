  "id": "e67fe62c-6d48-5b1a-9418-a5ae6a75a3ac",
  "slug": "artichoke-casserole-recipe-11941228",
  "name": "Artichoke Casserole",
  "recipe_type": "side",
  "brief_description": "You'll go crazy over this artichoke casserole\u2014who wants to stuff an artichoke when you can have this? Delicious, with a beautiful texture, you will love it. You can use frozen artichokes without even thawing, or use canned.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Add artichokes, breadcrumbs, 1/2 cup grated Parmesan, olive oil, lemon juice, garlic, parsley, salt, and pepper to a large bowl; stir to combine."
    },
    {
      "position": 3,
      "text": "Spread half the mixture into a 9x9-inch deep baking dish, then top with 4 slices provolone or mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Add remaining artichoke mixture on top. Sprinkle with remaining Parmesan cheese and drizzle with olive oil; tear remaining provolone slice into pieces and add on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and bubbly, 30 to 35 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

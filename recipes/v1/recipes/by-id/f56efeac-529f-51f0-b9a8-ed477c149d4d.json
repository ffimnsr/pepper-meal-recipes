  "id": "f56efeac-529f-51f0-b9a8-ed477c149d4d",
  "slug": "cheesecake-egg-rolls",
  "name": "Cheesecake Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Not your typical egg rolls, these cheesecake-inspired ones are filled with sweet cream cheese and a smattering of chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese and sugar in a bowl until smooth. Stir in vanilla extract. Thin filling with a little milk if it appears too thick; it should be the consistency of jelly."
    },
    {
      "position": 2,
      "text": "Lay out 1 egg roll on a flat work surface. Add about 2 tablespoons of the cream cheese filling down the middle. Sprinkle a few chocolate chips on top. Brush edges of the wrapper with water. Fold in sides and roll up, pressing in edges to seal. Place seam side-down on a plate. Repeat with remaining wrappers, filling, and chocolate chips."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep saucepan over medium heat. Fry egg rolls in batches until golden brown, 1 to 2 minutes per side. Drain on paper towels."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

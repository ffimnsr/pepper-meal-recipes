  "id": "f06dc0ee-1348-59ea-aee6-709951bfbdb7",
  "slug": "grilled-tomatoes",
  "name": "Grilled Tomatoes",
  "recipe_type": "dessert",
  "brief_description": "These grilled tomatoes flavored with olive oil and fresh garlic are cooked on a hot grill for a fantastic sweet and smoky summer side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil over the cut-sides of tomatoes. Sprinkle with garlic; season with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Cook tomatoes, cut-sides up, on the preheated grill until they start to sizzle and have blackened grill marks, about 4 minutes. Flip tomatoes over and continue grilling until garlic turns golden brown, about 3 more minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,

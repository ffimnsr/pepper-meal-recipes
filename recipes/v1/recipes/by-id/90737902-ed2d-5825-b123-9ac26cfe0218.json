  "id": "90737902-ed2d-5825-b123-9ac26cfe0218",
  "slug": "baked-oats-three-ways-recipe-7372045",
  "name": "Baked Oats - 3 Ways",
  "recipe_type": "dessert",
  "brief_description": "A sweet treat to start your day: try these creamy and delicious baked oats in three different flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). blend for 1 minute."
    },
    {
      "position": 2,
      "text": "Combine rolled oats, Almond Breeze Unsweetened Vanilla Almondmilk, banana, egg, baking powder, cinnamon, vanilla extract, honey, and salt in a blender; blend for 1 minute."
    },
    {
      "position": 3,
      "text": "Grease 3 small ramekins with cooking spray. Pour oatmeal mixture evenly into the ramekins. Mix in and top with ingredients from the flavor of your choice."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick poked in the center comes out clean, 20 to 30 minutes. Remove from the oven and allow to cool for a few minutes before enjoying warm!"
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

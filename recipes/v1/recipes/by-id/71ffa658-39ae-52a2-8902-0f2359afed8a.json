  "id": "71ffa658-39ae-52a2-8902-0f2359afed8a",
  "slug": "best-ever-split-pea",
  "name": "Best Ever Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This tasty split pea soup recipe is made with dried yellow and green split peas. It's simple to make and really sticks to your ribs, even with no ham!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a Dutch oven over medium heat. Add onion, carrot, celery, and garlic; cook and stir until onion is translucent, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir in broth, split peas, and seasoning blend; cover and bring to a boil. Reduce heat to low and simmer, stirring frequently, until split peas are tender, about 2 \u00bd hours."
    },
    {
      "position": 4,
      "text": "Puree the soup with an immersion blender and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 160,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "8923e50d-72ba-53a4-a593-d54f668e0765",
  "slug": "shepherds-pie-vi",
  "name": "Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Make this shepherd's pie with a rich and hearty layer of savory ground beef or lamb, topped with cheesy mashed potatoes for a comfort food classic!",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and mash. Mix in butter, finely chopped onion and 1/4 cup shredded cheese. Season with salt and pepper to taste; set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of salted water to a boil. Add carrots and cook until tender but still firm, about 15 minutes. Drain, mash and set aside. Preheat oven to 375 degrees F (190 degrees C.)"
    },
    {
      "position": 4,
      "text": "Heat oil in a large frying pan. Add onion and cook until clear. Add ground beef and cook until well browned. Pour off excess fat, then stir in flour and cook 1 minute. Add ketchup and beef broth. Bring to a boil, reduce heat and simmer for 5 minutes."
    },
    {
      "position": 5,
      "text": "Spread the ground beef in an even layer on the bottom of a 2 quart casserole dish. Next, spread a layer of mashed carrots. Top with the mashed potato mixture and sprinkle with remaining shredded cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 20 minutes, or until golden brown. Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a7815890-564d-5a51-83ec-d406c77fb4e8",
  "slug": "maple-bacon-monkey-bread",
  "name": "Maple Bacon Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "This maple monkey bread recipe has a special addition \u2014 bacon! It's a wonderful mix of sweet and salty and will make everyone happy at brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat the inside of a 9-inch fluted tube pan (such as Bundt) with cooking spray."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels. Crumble when cool enough to handle; discard any pieces that are all fat."
    },
    {
      "position": 3,
      "text": "Melt margarine in a small saucepan over medium heat; stir in brown sugar and maple syrup and bring to a boil. Cook and stir until mixture begins to foam, about 1 minute. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Mix white sugar and cinnamon in a resealable plastic bag. Add 6 to 8 biscuit pieces at a time to the bag; shake until well coated. Place sugared biscuits onto a plate and repeat to coat the rest."
    },
    {
      "position": 5,
      "text": "Empty any sugar mixture from the resealable bag into maple syrup mixture; place the saucepan over medium heat and stir until sugar dissolves, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Make four layers of ingredients in the prepared pan as follows: bacon, maple syrup mixture, biscuits. Finish with the last drizzle of maple syrup mixture."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until biscuits are cooked through, about 35 minutes. Allow to cool in the pan for 10 to 20 minutes, then invert onto a serving plate."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

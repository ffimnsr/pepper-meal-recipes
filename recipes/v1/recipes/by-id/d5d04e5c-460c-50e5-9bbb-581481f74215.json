  "slug": "bacon-date-cream-cheese-dip-recipe-12005836",
  "name": "Bacon Date Cream Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "This bacon date cream cheese dip is the perfect blend of sweet, savory, smoky, and salty. Crispy bacon, honey-like dates, green onions, and a touch of chili crisp come together in an easy appetizer that\u2019s perfect for scooping up with crostini, fresh veggies, or your favorite crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add cream cheese, sour cream, garlic powder, and onion powder to a mixing bowl. Using an electric mixer, blend until smooth and creamy."
    },
    {
      "position": 2,
      "text": "Stir in dates and chili crisp until well combined. Taste, and adjust seasonings, if necessary."
    },
    {
      "position": 3,
      "text": "Transfer the dip to a serving bowl, garnish with bacon and green onions, and serve. Store in an airtight container in the refrigerator."
    }
  ],
  "servings": 6,

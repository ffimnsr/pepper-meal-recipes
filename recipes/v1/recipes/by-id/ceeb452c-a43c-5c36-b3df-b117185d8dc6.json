  "id": "ceeb452c-a43c-5c36-b3df-b117185d8dc6",
  "slug": "instant-pot-salsa-chicken",
  "name": "Instant Pot Salsa Chicken",
  "recipe_type": "soup",
  "brief_description": "This salsa chicken Instant Pot recipe uses frozen chicken breasts rubbed with taco seasoning, then cooked in salsa and broth for an easy Tex-Mex meal.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts in a multi-functional cooker (such as Instant Pot). Sprinkle all sides with taco seasoning. Pour salsa and chicken broth on top."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select Poultry setting; set the timer for 15 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, about 20 minutes. Unlock and remove the lid."
    },
    {
      "position": 4,
      "text": "Shred chicken and serve as desired."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

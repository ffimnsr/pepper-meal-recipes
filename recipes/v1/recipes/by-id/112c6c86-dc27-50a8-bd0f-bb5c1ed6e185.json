  "id": "112c6c86-dc27-50a8-bd0f-bb5c1ed6e185",
  "slug": "easy-creamy-chicken-ramen",
  "name": "Easy Creamy Chicken Ramen",
  "recipe_type": "main",
  "brief_description": "A handful of ingredients turns an ordinary package of ramen into a comforting bowl of goodness in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a heavy skillet over medium heat. Add minced garlic and cook, stirring, until fragrant, about 30 seconds. Add chicken broth, cream, and ramen noodles. Cook, stirring occasionally, until noodles soften, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Add soy sauce and chopped cooked chicken. Allow to get hot."
    },
    {
      "position": 3,
      "text": "Serve garnished with everything bagel seasoning if desired."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

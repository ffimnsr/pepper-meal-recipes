  "id": "f7be08c7-b86b-5a66-80be-1117da8a8bec",
  "slug": "johnnycakes",
  "name": "Johnnycakes",
  "recipe_type": "dessert",
  "brief_description": "A cornmeal and milk batter gives texture to these pancakes. Serve with butter and honey, or with maple syrup.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Cream the cornmeal, salt, and butter together. Add the milk and enough water to make a moist but firm batter."
    },
    {
      "position": 2,
      "text": "Drop by large spoonfuls onto a hot greased griddle, and flatten slightly with the back of a spoon. When brown, turn and cook the other side."
    }
  ],

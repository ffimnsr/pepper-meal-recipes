  "id": "e0975100-986c-5726-b655-8b9d77b2b51d",
  "slug": "slow-cooker-zuppa-toscana",
  "name": "Slow Cooker Zuppa Toscana",
  "recipe_type": "soup",
  "brief_description": "This creamy Crockpot zuppa Toscana recipe is loaded with pork sausage, potatoes, garlic, and kale for a comforting, flavorsome slow cooker meal.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Add onion and garlic; saut\u00e9 until onion is tender and translucent, 3 to 5 minutes. Drain and discard grease."
    },
    {
      "position": 2,
      "text": "Place potatoes in a slow cooker; add cooked sausage and onion mixture. Season with salt, black pepper, and red pepper flakes. Pour in chicken broth and up to 2 cups water to completely cover potatoes. Stir soup gently and cover."
    },
    {
      "position": 3,
      "text": "Cook on Low for 5 to 6 hours or High for 3 to 4 hours."
    },
    {
      "position": 4,
      "text": "Pour in heavy cream and stir in kale to combine. Cover and cook on High until flavors are incorporated, about 30 minutes more. Garnish with Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 220,

  "id": "f2b19fd9-7386-5a3f-a9a0-8ed04e064a74",
  "slug": "king-ranch-chicken-soup-recipe-11817758",
  "name": "King Ranch Chicken Soup",
  "recipe_type": "soup",
  "brief_description": "This King Ranch Chicken Soup, the famous casserole in soup form, is a hearty, Tex-Mex\u2013inspired comfort dish that\u2019s creamy, flavorful, and satisfying enough to warm you up any night of the week.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large Dutch oven over medium-high heat. Add onion and bell peppers; cook, stirring occasionally, until tender, about 8 minutes."
    },
    {
      "position": 3,
      "text": "Add chili powder, cumin, garlic powder, and onion powder, and cook, stirring constantly, until spices are fragrant, about 1 minute."
    },
    {
      "position": 4,
      "text": "Add cream of mushroom and cream of chicken soups, diced tomatoes, and chicken broth, and stir until combined; bring to a boil over high."
    },
    {
      "position": 5,
      "text": "Reduce heat to medium; add shredded chicken, tortilla strips, and cream cheese. Cook, stirring occasionally, until cream cheese has melted, about 2 minutes. Season with salt to taste."
    },
    {
      "position": 6,
      "text": "Remove from heat and divide among 6 serving bowls. Garnish with Cheddar cheese, sliced jalape\u00f1o, and cilantro leaves, if desired. Recipe developed by Isabelle Easter"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1fbdaebf-b624-5a02-9a18-e404b2456600",
  "slug": "instant-pot-applesauce",
  "name": "Instant Pot\u00ae Applesauce",
  "recipe_type": "snack",
  "brief_description": "Five minutes of high pressure is all you need to get a smooth, fragrant applesauce - the Instant Pot\u00ae does all the work!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Use a vegetable peeler to remove 2 thick strips of lemon peel, being careful to avoid the bitter pith. Tie up lemon peel, cinnamon stick, ginger, star anise, and cloves in cheesecloth for easy retrieval after cooking."
    },
    {
      "position": 2,
      "text": "Place apples in a multi-functional pressure cooker (such as Instant Pot\u00ae). Add cheesecloth bundle, water, and salt. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 15 to 20 minutes. Avoid releasing pressure manually as hot applesauce may splutter up through the vent. Remove the cheesecloth bundle with a slotted spoon and discard."
    },
    {
      "position": 4,
      "text": "Mix brown sugar into the applesauce until dissolved. Taste and adjust the level of sweetness if needed."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "ad7b33b4-58f9-55fd-8c93-e5b7872ef9ee",
  "slug": "mini-chocolate-chip-pancakes",
  "name": "Mini Chocolate Chip Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These gooey chocolate chip pancakes are easy to make and always a fun way to start your day. Top these tasty delights with maple syrup and dig in!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Sift flour, sugar, baking powder, and salt into a separate bowl."
    },
    {
      "position": 3,
      "text": "Whisk milk and egg together in a bowl until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Stir melted butter into the flour mixture, then whisk in milk mixture until smooth."
    },
    {
      "position": 5,
      "text": "Fold in chocolate chips."
    },
    {
      "position": 6,
      "text": "Heat a small nonstick skillet over low heat. Pour about 1/3 cup batter into the hot skillet and cover with a lid. Cook pancake until browned on the bottom, about 3 minutes."
    },
    {
      "position": 7,
      "text": "Flip pancake, then cover and cook until browned on the other side, 2 to 3 minutes. Remove to a plate and repeat to make remaining pancakes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

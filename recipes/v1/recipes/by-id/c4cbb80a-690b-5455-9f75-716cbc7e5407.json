  "id": "c4cbb80a-690b-5455-9f75-716cbc7e5407",
  "slug": "cream-of-chicken-breasts",
  "name": "Cream of Chicken Breasts",
  "recipe_type": "soup",
  "brief_description": "This baked chicken with cream of chicken soup recipe is made with boneless breasts smothered in creamy chicken soup and baked until tender and juicy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken in a 9x13-inch baking dish; season with poultry seasoning."
    },
    {
      "position": 3,
      "text": "Mix together condensed soup and milk in a bowl. Pour soup mixture evenly over chicken."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and juices run clear, 40 to 50 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,

  "id": "f6a47c6f-0ed9-53a3-8e84-9e669cd0cc2f",
  "slug": "chicken-and-sausage-jambalaya-recipe-8726289",
  "name": "Chicken and Sausage Jambalaya",
  "recipe_type": "soup",
  "brief_description": "Chicken and sausage jambalaya is a classic one pot meal, with the Holy Trinity of Louisiana cooking\u2014celery, onion, and bell pepper\u2014combined with chicken and rice. Tasso and andouille bring the spice and flavor.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Add canola oil to a large Dutch oven set over medium heat. Salt and pepper chicken liberally and sear on both sides until golden brown, about 5 minutes per side. Remove from Dutch oven."
    },
    {
      "position": 3,
      "text": "Open canned tomatoes and strain liquid into a 4-cup measuring cup. Pour in enough chicken stock to total 4 cups; set aside. Roughly chop tomatoes."
    },
    {
      "position": 4,
      "text": "Add celery, onion, bell pepper (the trinity), chopped tomatoes, cayenne, bay leaves, and garlic to the Dutch oven and stir until combined on medium heat. Mix in stock with tomato juice, seared chicken, tasso, andouille, and rice. Bring this to a nice simmer. Cover the pot."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Remove the pot from the oven and continue to let jambalaya steam for an additional 5 minutes."
    },
    {
      "position": 6,
      "text": "Garnish with scallions and a few dashes of hot sauce when ready to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

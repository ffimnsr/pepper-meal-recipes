  "id": "4bb808db-8d77-5f21-b8ee-3b80e3ebfe76",
  "slug": "ukrainian-prune-torte",
  "name": "Ukrainian Prune Torte",
  "recipe_type": "dessert",
  "brief_description": "A delicate almond cake is layered with a sweet dried plum filling in this traditional Eastern European dessert. This torte needs to be made a day ahead to allow the layers to set.",
  "cuisine": "Ukrainian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour 5 (8 inch) round pans."
    },
    {
      "position": 2,
      "text": "Grind the blanched almonds in a food processor with 1/4 cup confectioners' sugar. Cream the butter with the remaining 3/4 cup confectioners' sugar until light and fluffy. Beat in the egg. Stir in the almond extract, salt, and ground almond mixture. Add the flour and mix thoroughly. Divide the dough into 5 equal parts. Roll each piece between 2 sheets of waxed paper or parchment paper to fit the pans, or pat each piece of dough into the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the edges begin to brown, about 20 minutes. Remove from the pans while still hot."
    },
    {
      "position": 4,
      "text": "To make the Prune Filling: Place the prunes in a saucepan with the water. Bring to a boil, remove from heat and let stand for 10 minutes. Drain and reserve the liquid. Puree the prunes in a food processor."
    },
    {
      "position": 5,
      "text": "Return the prune puree to the saucepan and add the white sugar, cinnamon, lemon juice and 4 tablespoons reserved prune liquid. Bring the mixture to a boil, then remove from heat. Assemble the torte layers, spreading them with warm prune filling. Let stand for 24 hours before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

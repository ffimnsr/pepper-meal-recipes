  "id": "b31335cc-352f-5a92-967c-da81376f901d",
  "slug": "easy-broccoli-quiche",
  "name": "Easy Broccoli Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This broccoli quiche with lots of fresh broccoli and mozzarella cheese is a snap to make in a prepared pie crust and looks great on your brunch table!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter in a large saucepan over medium-low heat. Add broccoli, onion, and garlic; cook, stirring occasionally, until vegetables are soft."
    },
    {
      "position": 3,
      "text": "Spoon vegetables into pie crust and sprinkle with mozzarella cheese; set quiche on a baking sheet."
    },
    {
      "position": 4,
      "text": "Combine eggs and milk together in a bowl; season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Stir in remaining 1 tablespoon melted butter; pour egg mixture over vegetables."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until the center of the quiche has set, about 40 to 50 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3d44a538-4ff8-5043-948e-13c003be8712",
  "slug": "russian-tomato-salad-bruschetta",
  "name": "Russian Tomato Salad Bruschetta",
  "recipe_type": "salad",
  "brief_description": "Paired with sweet onions, dressed with a simple, tangy, creamy sauce, and served on charred bread, Chef John's Russian tomato salad bruschetta is the perfect summer appetizer.",
  "cuisine": "Russian Italian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Mix garlic and olive oil in a small bowl and let sit for about 1 hour, or until needed."
    },
    {
      "position": 2,
      "text": "Mix the yogurt and sour cream together in a bowl until combined. Add the onions and tomatoes and toss until well coated. Season with salt, freshly ground black pepper, and cayenne. Wrap in plastic wrap and chill in a refrigerator until needed."
    },
    {
      "position": 3,
      "text": "Preheat a charcoal grill until coals are white and ashy."
    },
    {
      "position": 4,
      "text": "Grill bread over hot charcoal, rotating as needed, until both sides are nicely toasted and slightly charred."
    },
    {
      "position": 5,
      "text": "Brush grilled bread with the garlic olive oil and use a slotted spoon to transfer the tomato salad over top of each. Excess dressing can be spooned over if desired. Garnish with chives and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "efe8ea2e-feda-51e8-a70a-0621415d9ba4",
  "slug": "homemade-blackberry-lemonade",
  "name": "Homemade Blackberry Lemonade",
  "recipe_type": "drink",
  "brief_description": "Blackberry lemonade is easy to make from scratch with fresh blackberries and lemon juice for a refreshing drink with a beautiful flavor and color.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 3/4 cup sugar and 1/2 cup water in a small saucepan over medium heat. Cook and stir until sugar has dissolved, about 2 minutes. Let cool."
    },
    {
      "position": 2,
      "text": "Place blackberries and remaining 2 tablespoons of sugar in a blender; blend until smooth."
    },
    {
      "position": 3,
      "text": "Combine simple syrup, blended blackberries, remaining 4 cups of water, and lemon juice. Place a fine-mesh sieve over a pitcher and pour lemonade into the pitcher; discard solids. Serve over ice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

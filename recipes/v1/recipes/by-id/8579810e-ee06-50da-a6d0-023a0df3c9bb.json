  "id": "8579810e-ee06-50da-a6d0-023a0df3c9bb",
  "slug": "indian-chicken-curry-ii",
  "name": "Indian Chicken Curry",
  "recipe_type": "main",
  "brief_description": "This creamy Indian chicken curry has an unbeatable combination of flavors thanks to an array of aromatic warm spices, plain yogurt, and coconut milk.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium heat. Saut\u00e9 onion until lightly browned."
    },
    {
      "position": 2,
      "text": "Stir in garlic, curry powder, cinnamon, paprika, bay leaf, ginger, sugar, and salt. Continue stirring for 2 minutes."
    },
    {
      "position": 3,
      "text": "Add chicken pieces, tomato paste, yogurt, and coconut milk. Bring to a boil, reduce heat, and simmer for 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Remove bay leaf, and stir in lemon juice and cayenne pepper. Simmer 5 more minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0d2bf315-6ae4-53aa-8322-901eafc0fd8c",
  "slug": "spicy-ranch-cauliflower-crackers",
  "name": "Spicy Ranch Cauliflower Crackers",
  "recipe_type": "appetizer",
  "brief_description": "These cauliflower crackers are low in carbs and perfect if you're living a keto lifestyle. Ranch seasoning mix, Parmesan cheese, and cayenne pepper make them very tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper and a strainer with cheesecloth; set aside."
    },
    {
      "position": 2,
      "text": "Place riced cauliflower in a microwave-safe bowl. Cover the bowl and heat in the microwave for 3 to 4 minutes. Transfer to the prepared strainer and allow to cool for 15 minutes. Gather the edges of the cheesecloth, twist, and squeeze moisture out of cooled cauliflower."
    },
    {
      "position": 3,
      "text": "Combine cauliflower, egg, ranch mix, and cayenne pepper in a large bowl; mix well. Stir in Parmesan cheese until incorporated."
    },
    {
      "position": 4,
      "text": "Use a small cookie scoop to portion cauliflower mixture onto the prepared cookie sheet. Flatten with a small rolling pin, a cup, or your hand to about 1/16-inch thickness. (The thinner the dough, the crispier the cracker.)"
    },
    {
      "position": 5,
      "text": "Bake crackers in the preheated oven for 10 minutes. Flip, then continue baking for 10 more minutes. Cool crackers on a wire rack."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

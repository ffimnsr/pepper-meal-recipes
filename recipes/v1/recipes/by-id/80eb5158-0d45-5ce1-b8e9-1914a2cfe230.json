  "id": "80eb5158-0d45-5ce1-b8e9-1914a2cfe230",
  "slug": "parmentier-potatoes-crispy-french-style-potatoes-recipe-11943694",
  "name": "Parmentier Potatoes (Crispy French Style Potatoes)",
  "recipe_type": "side",
  "brief_description": "These Parmentier potatoes are classic French-style cubed roasted potatoes with herbs. They're crispy on the outside, pillowy and fluffy on the inside, and fragrant with rosemary and thyme.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Line a rimmed baking sheet with non-stick aluminum foil. Add oil and swirl to coat. Place baking sheet in the oven and preheat to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Add potatoes to the preheated baking sheet and stir to coat with oil."
    },
    {
      "position": 3,
      "text": "Roast potatoes in the preheated oven for 20 minutes. Stir and roast for 20 minutes more."
    },
    {
      "position": 4,
      "text": "Meanwhile combine garlic, rosemary, thyme, salt, and pepper in a small bowl. Divide herb mixture on top of potatoes."
    },
    {
      "position": 5,
      "text": "Roast 5 minutes more. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

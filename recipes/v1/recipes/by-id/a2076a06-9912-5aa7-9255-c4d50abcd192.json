  "id": "a2076a06-9912-5aa7-9255-c4d50abcd192",
  "slug": "whoopie-pies-i",
  "name": "Whoopie Pies",
  "recipe_type": "dessert",
  "brief_description": "This whoopie pie recipe makes tender chocolate cake-like cookies sandwiched with a fluffy vanilla filling. Perfect for holiday cookie trays!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "To make the cookies: Beat sugar, shortening, and egg yolks together in a large bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 3,
      "text": "Sift flour, cocoa, baking powder, baking soda, and salt together in a separate bowl; add to shortening mixture in batches, alternating with milk, beating briefly after each addition until smooth. Stir in vanilla. Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until centers spring back when lightly touched, 10 to 12 minutes. Cool on the pans briefly, then transfer to wire racks to cool completely."
    },
    {
      "position": 5,
      "text": "To make the filling: Beat confectioners' sugar, shortening, reserved egg whites, and salt together in a large bowl with an electric mixer until light and fluffy. Stir in vanilla."
    },
    {
      "position": 6,
      "text": "Choose 2 cookies of the same size; spread a thick layer of filling on the flat side of one cookie; top with remaining cookie. Repeat with remaining cookies and filling."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

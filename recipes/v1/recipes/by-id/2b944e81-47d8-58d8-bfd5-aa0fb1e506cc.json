  "id": "2b944e81-47d8-58d8-bfd5-aa0fb1e506cc",
  "slug": "inside-out-ravioli-i",
  "name": "Inside Out Ravioli",
  "recipe_type": "side",
  "brief_description": "This inside-out ravioli recipe includes what you'd expect stuffed in a ravioli: spinach, bread crumbs, and cheese, plus pasta and a meaty tomato sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in pasta and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, 8 to 12 minutes. Drain well."
    },
    {
      "position": 2,
      "text": "Meanwhile, cook spinach according to package directions."
    },
    {
      "position": 3,
      "text": "Meanwhile, brown ground beef, onion, and garlic in a large skillet over medium heat. Stir in spaghetti sauce, tomato sauce, and tomato paste; simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Combine pasta, spinach, mozzarella cheese, bread crumbs, olive oil, and eggs in a bowl. Transfer to a 9x13-inch baking dish; top with beef mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

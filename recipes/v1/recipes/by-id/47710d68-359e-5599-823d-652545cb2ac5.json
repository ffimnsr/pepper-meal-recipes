  "id": "47710d68-359e-5599-823d-652545cb2ac5",
  "slug": "one-skillet-corned-beef-hash-breakfast",
  "name": "One Skillet Corned Beef Hash Breakfast",
  "recipe_type": "breakfast",
  "brief_description": "Corned beef hash, onions, and bell pepper are browned in a skillet, topped with eggs and chopped tomatoes, then broiled until just set.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine corned beef hash, onion, and bell pepper in an ovenproof skillet. Cook, stirring occasionally, over medium-high heat until vegetables begin to soften and hash begins to brown, 10 to 15 minutes. Make 4 indentations in the hash for the eggs. Remove from heat."
    },
    {
      "position": 2,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 3,
      "text": "Carefully crack an egg into each indentation. Top with chopped tomatoes."
    },
    {
      "position": 4,
      "text": "Place skillet under broiler; broil until eggs are cooked to preferred doneness, 4 to 10 minutes. Check often to avoid burning eggs. Remove skillet from oven. Top with shredded cheese; sprinkle with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 19,
  "preparation_time_minutes": 10,

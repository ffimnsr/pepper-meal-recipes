  "id": "4c8ccb5e-7831-53e1-8e56-afe4bc235560",
  "slug": "bread-machine-challah-ii",
  "name": "Bread Machine Challah",
  "recipe_type": "appetizer",
  "brief_description": "This bread machine challah recipe is simple to make with basic pantry staples and bakes up 2 rich, tender, slightly sweet loaves with a pillowy crumb.",
  "cuisine": "Jewish Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place warm water, sugar, oil, eggs, honey, salt, flour, and yeast into a bread machine in the order listed, or follow the order recommended by the manufacturer if different. Select Dough cycle; press Start."
    },
    {
      "position": 2,
      "text": "Remove dough from the machine after the cycle is done and place on a lightly floured board. Punch dough down and let rest for 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, grease a baking tray."
    },
    {
      "position": 4,
      "text": "Divide dough in half, then divide each half into 3 equal pieces. Roll each piece into ropes, about 12- to 14-inches long. Braid 3 ropes into a loaf to form 2 loaves. Gently place loaves onto the prepared baking tray. Mist loaves with water and cover loosely with plastic wrap. Let rise in a warm, draft-free place until doubled in size, 1 to 1 1/2 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Make egg wash: Beat together egg and water in a small bowl until well combined."
    },
    {
      "position": 7,
      "text": "Brush the top and sides of loaves with egg wash."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven for about 20 to 25 minutes. If loaves begin to brown too soon, cover them loosely with aluminum foil."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

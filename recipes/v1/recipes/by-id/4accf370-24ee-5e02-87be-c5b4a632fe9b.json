  "id": "4accf370-24ee-5e02-87be-c5b4a632fe9b",
  "slug": "quick-and-simple-broccoli-and-cheese",
  "name": "Quick and Simple Broccoli and Cheese",
  "recipe_type": "side",
  "brief_description": "This is an easy broccoli and cheese recipe that anyone can make. Turn eating your veggies into a treat that kids and grown ups alike will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place broccoli in a steamer over 1 inch of boiling water and cover. Cook until tender but still firm, 2 to 6 minutes. Drain and transfer to a microwave-safe casserole dish."
    },
    {
      "position": 2,
      "text": "Pour melted butter over broccoli and season with salt and pepper. Sprinkle cheese over the top and microwave on high until cheese is melted, about 1 minute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

  "id": "8f10dd52-793d-5bbf-9a33-506d7f6ad2a5",
  "slug": "ground-pork-tacos-with-pineapple-salsa-recipe-8642408",
  "name": "Ground Pork Tacos with Pineapple Salsa",
  "recipe_type": "dessert",
  "brief_description": "These easy ground pork tacos with warm tortillas and homemade salsa are smoky, spicy, and sweet for a family-pleasing dinner in less than 30 minutes.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ground pork, liquid seasoning, ground chipotle powder, and garlic in a bowl. Set aside briefly for flavors to meld."
    },
    {
      "position": 2,
      "text": "Meanwhile, make the salsa: Combine pineapple, red onion, jalape\u00f1o, cilantro, lime juice, and salt in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Preheat a large skillet over high heat. Crumble ground pork into the hot skillet. Cook and stir until pork is completely browned and edges begin to crisp, 7 to 10 minutes. Drain any excess grease. Place pork in a bowl and keep warm. Wipe out skillet."
    },
    {
      "position": 4,
      "text": "Warm tortillas in skillet over medium-low heat, about 20 seconds per side. Divide meat mixture between tortillas and top with pineapple salsa."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

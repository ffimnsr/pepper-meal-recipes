  "id": "ad377f9a-b51d-57d0-a5a6-750c12b30a8a",
  "slug": "cantuccini",
  "name": "Cantuccini",
  "recipe_type": "dessert",
  "brief_description": "This is the original Italian biscotti recipe: a crispy, crunchy, elegant dessert cookie flavored with aniseed and hazelnuts that is just sweet enough.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, eggs, egg yolk, baking powder, and vanilla extract in a food processor. Blend until the mixture forms a ball, scraping the sides of the bowl once or twice. Turn mixture onto a lightly floured surface and knead in hazelnuts, almonds, and anise seeds."
    },
    {
      "position": 3,
      "text": "Beat egg yolk and water together in a bowl."
    },
    {
      "position": 4,
      "text": "Divide dough into 3 pieces and roll into logs about 1 1/2 inches wide. Place onto the prepared baking sheet at least 2 inches apart. Brush with egg yolk-water mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes."
    },
    {
      "position": 6,
      "text": "Remove from oven and reduce heat to 300 degrees F (150 degrees C). Cut logs diagonally into 1-inch slices and lay cut-sides down on the baking sheet. Return cantuccini to the oven until dry and firm, 30 to 40 minutes more."
    },
    {
      "position": 7,
      "text": "Cool on a wire rack and store in an airtight container."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

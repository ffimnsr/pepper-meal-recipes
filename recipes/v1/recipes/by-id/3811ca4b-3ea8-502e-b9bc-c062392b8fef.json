  "id": "3811ca4b-3ea8-502e-b9bc-c062392b8fef",
  "slug": "potato-chip-crispy-treats-recipe-7485538",
  "name": "Potato Chip Crispy Treats",
  "recipe_type": "appetizer",
  "brief_description": "Ruffled potato chips replace the cereal in Rice Krispies Treats for the most irresistible salty-sweet snack. This recipe is easy, crowd-pleasing, and your new go-to for spring gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium-low heat. Add marshmallows and stir until smooth. Once combined with no lumps remaining, stir in vanilla extract, then remove saucepan from heat."
    },
    {
      "position": 3,
      "text": "Add crushed potato chips and stir to combine. Once fully coated, pour the mixture into the buttered baking pan."
    },
    {
      "position": 4,
      "text": "Melt chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes. Drizzle melted chocolate over the top of the treats."
    },
    {
      "position": 5,
      "text": "Let rest for 1 to 2 hours until hardened. Cut into squares and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 12,
  "rest_time_minutes": null,
  "difficulty": "easy",

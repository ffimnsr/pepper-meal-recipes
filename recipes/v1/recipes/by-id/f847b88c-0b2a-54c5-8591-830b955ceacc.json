  "id": "f847b88c-0b2a-54c5-8591-830b955ceacc",
  "slug": "asian-coleslaw",
  "name": "Asian Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This Asian coleslaw recipe combines crunchy cabbage and veggies with a light and creamy homemade peanut dressing flavored with garlic and ginger.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "To make the peanut dressing: Whisk rice vinegar, oil, peanut butter, soy sauce, brown sugar, ginger, and garlic together in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "To make the coleslaw: Mix green cabbage, red cabbage, napa cabbage, red bell peppers, carrots, green onions, and cilantro in a large bowl."
    },
    {
      "position": 4,
      "text": "When ready to serve, pour dressing over cabbage mixture and toss well to combine."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

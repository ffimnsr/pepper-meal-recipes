{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a0652931-93e3-5ff5-90e7-bee1fb55c0b0",
  "slug": "s-mores-stuffed-chocolate-chip-cookies-recipe-12010544",
  "name": "S\u2019mores Stuffed Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These s\u2019mores stuffed cookies are irresistible chocolate chip cookies to begin with, but then, ooh l\u00e0 l\u00e0! A surprise center of chocolate, graham cracker, and marshmallow turns them into the perfect mash-up of two favorite treats in one bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line two large baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat butter, brown sugar, and white sugar in the bowl of a stand mixer fitted with the paddle attachment on medium-high speed until light and fluffy, about 2 minutes. Add eggs and vanilla; beat until well combined."
    },
    {
      "position": 3,
      "text": "Whisk together flour, baking soda, baking powder, cornstarch, and salt in a separate bowl. Gradually add to butter mixture, beating just until combined. Stir in chocolate chips."
    },
    {
      "position": 4,
      "text": "Pat dough into a rectangle and cut into 18 portions (6x3 cut) or scoop and level dough into portions using a #16 cookie scoop (or 1/4 cup measuring cup). Place on prepared baking sheet. Chill for 30 minutes."
    },
    {
      "position": 5,
      "text": "Flatten each portion of dough into a 3-inch round. Place a graham cracker square in the center of the dough portions, then top with a piece of chocolate and 2 marshmallow halves. Top with another flattened dough round and pinch edges to seal completely."
    },
    {
      "position": 6,
      "text": "Arrange cookies on prepared baking sheets, spacing at least 3 inches apart. Freeze for 15 minutes."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake cookies in the preheated oven until golden brown, 15 to 18 minutes. Let cool on baking sheet for 2 minutes. Carefully transfer to a wire rack to cool completely. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

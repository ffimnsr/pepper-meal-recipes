  "id": "2117a18e-e167-5d99-bfd0-883ccc8a7a00",
  "slug": "sri-lankan-milk-toffee",
  "name": "Sri Lankan Milk Toffee",
  "recipe_type": "dessert",
  "brief_description": "Condensed milk, sugar, cashew nuts, and butter combine to make this fudge-type milk toffee, a treat enjoyed in Sri Lanka on special occasions.",
  "cuisine": "Sri Lankan Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a square 9-inch baking pan with 2 teaspoons butter."
    },
    {
      "position": 2,
      "text": "Combine sugar and water in a large saucepan over medium heat. Cook and stir until sugar dissolves. Pour in sweetened condensed milk; cook and stir until mixture starts to bubble, about 5 minutes. Reduce heat to low. Add cashews; cook, stirring frequently, until mixture thickens, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir 2 tablespoons butter, vanilla, and rose extract into the mixture. Continue to cook, stirring frequently, until mixture is very stiff, 8 to 10 minutes. Pour into the buttered baking pan. Spread flat using a spatula or the back of a spoon."
    },
    {
      "position": 4,
      "text": "Cool toffee until firm, about 15 minutes. Cut into 1-inch pieces and transfer to an airtight container."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

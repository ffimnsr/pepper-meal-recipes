  "id": "b673c4ce-2697-5482-a181-2f01859de918",
  "slug": "savory-cheddar-zucchini-muffins",
  "name": "Savory Cheddar Zucchini Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This breakfast-friendly savory Cheddar zucchini muffin recipe features Parmesan for extra cheesy flavor and crispy bacon for a salty, crunchy bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine flour, baking powder, baking soda, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Stir milk, zucchini, butter, egg, and garlic together in a separate bowl until well blended. Mix flour mixture into milk mixture, \u00bd cup at a time, stirring well after each addition, until the flour mixture is incorporated. Fold in Cheddar, Parmesan, and crumbled bacon: pour batter into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 30 to 35 minutes. Cool slightly before removing from muffin cups. Serve warm; refrigerate leftovers."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

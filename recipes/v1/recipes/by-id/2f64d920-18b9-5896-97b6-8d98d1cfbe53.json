  "slug": "greek-pulled-pork",
  "name": "Greek Pulled Pork",
  "recipe_type": "main",
  "brief_description": "This easy, Greek-style pulled pork recipe starts with a pork tenderloin sprinkled with Greek seasoning and a jar of pepperoncini cooked in a slow cooker.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork tenderloin in a slow cooker; generously season with Greek seasoning. Pour pepperoncini with juice over pork."
    },
    {
      "position": 2,
      "text": "Cover slow cooker. Cook on High for 4 hours."
    },
    {
      "position": 3,
      "text": "Shred pork using 2 forks. Cook 10 to 15 minutes more."
    }
  ],

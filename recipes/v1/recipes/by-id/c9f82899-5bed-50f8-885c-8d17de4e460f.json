  "id": "c9f82899-5bed-50f8-885c-8d17de4e460f",
  "slug": "best-chicken-panini",
  "name": "Best Chicken Panini",
  "recipe_type": "main",
  "brief_description": "These panini sandwiches are simply the best featuring chicken strips, mozzarella cheese, bacon, pesto, tomato, and avocado.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a panini grill on the highest setting. Brush 2 pieces of bread with butter. Assemble panini with chicken, bacon, and mozzarella. Lower panini press. Cook until bread is golden and cheese is melted, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Carefully separate bread and add in some sliced avocado, tomato, and pesto. Repeat above steps for additional panini sandwiches."
    },
    {
      "position": 3,
      "text": "Reassemble sandwiches and cut in half. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,

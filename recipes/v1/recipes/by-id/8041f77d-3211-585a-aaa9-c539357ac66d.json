  "id": "8041f77d-3211-585a-aaa9-c539357ac66d",
  "slug": "no-bake-double-chocolate-cheesecake-recipe-11747511",
  "name": "No-Bake Double Chocolate Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "In this no-bake double chocolate cheesecake, a chocolate cookie crust comes together with a chocolate-cocoa filling for an epic oven-free dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line bottom of an 8- or 9-inch springform pan with parchment paper. Stir cookie crumbs and melted butter together in a small microwave-safe bowl. Press crumb mixture into bottom of the prepared pan. Chill crust while preparing filling. Wipe out bowl."
    },
    {
      "position": 2,
      "text": "Microwave chocolate in same bowl on High, stirring every 15 seconds, until melted, 1 1/2 to 2 minutes. Let cool 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk cocoa powder and hot water together in a bowl until smooth. Add cream cheese and sugar. Beat with an electric mixer at medium speed until well combined. Fold in cooled melted chocolate."
    },
    {
      "position": 4,
      "text": "In a large bowl, beat cream with an electric mixer at medium speed until soft peaks form. Fold in chocolate-cream cheese mixture until well combined; spoon into chilled crust, spreading evenly."
    },
    {
      "position": 5,
      "text": "Chill, covered, at least 4 hours or up to 1 week before serving. Garnish with additional cookies."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2eaacc3c-c810-5eea-a2ff-08d79e4a414e",
  "slug": "filet-mignon-with-garlic-shrimp-cream-sauce",
  "name": "Filet Mignon with Garlic Shrimp Cream Sauce",
  "recipe_type": "main",
  "brief_description": "Tender beef tenderloin filets are cooked to perfection, then topped with a delectable creamy shrimp sauce for a special meal to share.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a heavy steel or cast-iron skillet over medium-high heat. Brush both sides of each filet with 1 tablespoon olive oil, and sprinkle with salt. Gently place the filets into the hot skillet, and cook until they start to become firm and are reddish-pink and juicy in the center, about 3 to 4 minutes per side. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C). Set the filets aside to rest, covered loosely with foil."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter with 2 tablespoons of olive oil in the skillet over medium heat until the foam subsides from the butter. Cook and stir the shallot and garlic until tender, about 2 minutes. Pour in the wine, and cook and stir until the wine reduces by half, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in the shrimp, cream, 1 tablespoon of butter, and a pinch of salt and pepper to taste. Cook and stir until the sauce is thickened and velvety and the shrimp are pink, about 2 minutes."
    },
    {
      "position": 4,
      "text": "To serve, place filets on serving plates, and top each with half the shrimp sauce. Sauce will thicken slightly as it cools."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "87d5edb2-e028-5b7a-8bbb-8d24deb1d451",
  "slug": "4-ingredient-kimchi-quesadillas-recipe-11928585",
  "name": "4-Ingredient Kimchi Quesadillas",
  "recipe_type": "snack",
  "brief_description": "These kimchi quesadillas have only 4 ingredients, but tons of flavor. They are a quick and easy solution to lunch or a hearty snack. Spicy or not - that decision is yours!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a small skillet over medium-high heat. Add diced Spam and cook for 2 minutes. Flip and cook 2 minutes more. Turn off heat and set aside."
    },
    {
      "position": 2,
      "text": "Place tortillas on a clean work surface. Fold each tortilla in half and press until you have a crease."
    },
    {
      "position": 3,
      "text": "Layer the ingredients, dividing evenly, on the bottom half of each tortilla: half the cheese, spam, kimchi, remaining cheese. Fold the other half of the tortilla over filling and press to seal."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium heat. Place quesadillas in the skillet and cook for 3 minutes. Turn over gently with a spatula, and cook 3 minutes more. Transfer to a cutting board and cut into wedges."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "9dd49a95-e723-587e-9a4c-ca8ab85e9a6b",
  "slug": "slow-cooker-turkey-breast",
  "name": "Slow Cooker Turkey Breast",
  "recipe_type": "main",
  "brief_description": "This slow cooker turkey breast recipe is always reliable and comes out juicy, tender, and flavorful every time, plus you'll only need two ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat turkey dry with paper towels. Remove excess skin, leaving skin on breast."
    },
    {
      "position": 2,
      "text": "Rub soup mix over outside and under skin of turkey."
    },
    {
      "position": 3,
      "text": "Place in a slow cooker. Cover, and cook on High for 1 hour; set to Low, and cook for 7 hours. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Serve with gravy."
    }
  ],
  "servings": 12,

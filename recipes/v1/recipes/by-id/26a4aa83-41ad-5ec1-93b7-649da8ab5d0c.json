  "schema_version": 1,
  "id": "26a4aa83-41ad-5ec1-93b7-649da8ab5d0c",
  "slug": "polish-potato-soup-recipe-8550310",
  "name": "Polish Potato Soup",
  "recipe_type": "soup",
  "brief_description": "What makes this Polish potato soup extraordinary is the addition of chopped dill pickle, pickle juice, and plenty of fresh dill. These ingredients, plus tangy sour cream, create a delicious, complex, comforting potato soup.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a soup pot over medium heat and add kielbasa. Cook, stirring, for a few minutes to flavor the oil. Add onions, celery, and carrots, and cook, stirring, until onions turn translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, quarter potatoes and cut into 1/4-inch thick slices. Transfer about 1/3 of the potatoes into cold water, and reserve in the refrigerator until needed. Stir remaining sliced potatoes into the vegetables."
    },
    {
      "position": 3,
      "text": "Add broth, water, salt, pepper, cayenne, pickles, pickle juice, and half the fresh chopped dill. Raise the heat to high, and wait for soup to start to simmer. While soup is coming up to temperature, stir in sour cream."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium-low, and simmer, stirring occasionally, until potatoes are tender, 40 to 45 minutes. Use a potato masher to break up potatoes."
    },
    {
      "position": 5,
      "text": "Drain and add the reserved sliced potatoes, and let soup simmer until potatoes are very soft and tender, about 40 to 45 minutes more. During the last 30 minutes, be careful to stir gently to maintain whole pieces of potato."
    },
    {
      "position": 6,
      "text": "Taste for seasoning and adjust. Stir in remaining dill, and serve immediately, garnished with more sour cream and dill."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

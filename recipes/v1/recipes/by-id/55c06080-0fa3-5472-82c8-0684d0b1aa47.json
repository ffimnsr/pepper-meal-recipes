  "id": "55c06080-0fa3-5472-82c8-0684d0b1aa47",
  "slug": "buffalo-caesar-chicken-crust-pizza-recipe-8648525",
  "name": "Buffalo Caesar Chicken Crust Pizza",
  "recipe_type": "salad",
  "brief_description": "This Buffalo Caesar chicken crust pizza turns canned chicken and Parmesan into pizza crust. Topped with Caesar salad and Buffalo sauce, it's a delicious alternative to conventional pizza and salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Combine chicken, Parmesan cheese, Buffalo sauce, and egg in a bowl and mix well. Pat mixture firmly into a 10-inch circle on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown and toasted, about 40 minutes. Let cool for about 5 minutes."
    },
    {
      "position": 4,
      "text": "Drizzle about 2 teaspoons of dressing from the salad kit over crust. Toss half of salad mix with half of remaining dressing packet, according to package directions. (Reserve croutons, if desired, and remaining half of salad mix and dressing for later use.)"
    },
    {
      "position": 5,
      "text": "Place tossed salad on top of crust, and sprinkle evenly with celery and blue cheese. Drizzle with additional Buffalo sauce and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

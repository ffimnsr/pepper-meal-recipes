  "id": "e35103c8-5e69-5b21-9cda-d1503f12d9c7",
  "slug": "baguette-pizza-recipe-7565207",
  "name": "Baguette Pizza",
  "recipe_type": "main",
  "brief_description": "A baguette pizza is easy to make. Simply slice a baguette in half lengthwise, and top with pizza sauce, cheese, and any pizza toppings you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Split baguette in half lengthwise. Warm pizza sauce in a microwave-safe bowl until hot, about 45 seconds."
    },
    {
      "position": 3,
      "text": "Spread pizza sauce on baguette, sprinkle on cheese, and scatter sausage and pepperoni on top as desired. Place pizza onto a baking tray."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is golden, about 18 minutes. Optional step: turn on the oven\u2019s broiler, set a rack 6 inches below the heating element, and broil the pizza for a deeper color, 1 to 2 minutes."
    },
    {
      "position": 5,
      "text": "Cut pizza crosswise into slices. Serve and enjoy."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 20,

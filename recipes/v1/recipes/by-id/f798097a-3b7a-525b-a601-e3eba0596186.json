  "id": "f798097a-3b7a-525b-a601-e3eba0596186",
  "slug": "easy-chicken-stuffed-manicotti",
  "name": "Easy Chicken Stuffed Manicotti",
  "recipe_type": "main",
  "brief_description": "Chicken tenders seasoned and stuffed into manicotti shells, smothered in Alfredo sauce and Parmesan cheese, and baked until bubbly. Easy and delicious!",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix Alfredo sauce and water in a bowl. Spread about 1/3 sauce mixture on the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Season chicken tenders with garlic powder and stuff chicken into manicotti shells. Arrange manicotti in the prepared baking dish. Pour remaining 2/3 sauce over manicotti and sprinkle with steak seasoning. Cover baking dish tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pasta is tender, about 1 hour. Remove foil and sprinkle Parmesan cheese over manicotti. Continue to bake until cheese is melted, about 5 minutes more."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

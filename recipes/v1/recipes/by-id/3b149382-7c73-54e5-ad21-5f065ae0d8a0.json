  "id": "3b149382-7c73-54e5-ad21-5f065ae0d8a0",
  "slug": "mexican-style-spaghetti-squash-recipe-7974289",
  "name": "Mexican Style Spaghetti Squash",
  "recipe_type": "side",
  "brief_description": "For this veggie-rich Mexican style spaghetti squash with mushrooms, spinach, red bell pepper, and pepitas, it is easy to chop the ingredients while the squash bakes, making it quick to prep.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a baking pan with parchment or aluminum foil. Cut spaghetti squash in half lengthwise, scrape out seeds, and place cut side down on the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender when pierced with a sharp knife, about 30 minutes. Remove from the oven, and when cool enough to handle, shred inside of the squash into strings using a fork."
    },
    {
      "position": 4,
      "text": "Toast pepitas until fragrant in a large, dry skillet over medium heat, about 2 minutes. Remove from skillet and set aside."
    },
    {
      "position": 5,
      "text": "Heat oil in a large skillet over medium heat. Add mushrooms, garlic, and adobo seasoning, and cook and stir until mushrooms are beginning to wilt, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Stir in bell pepper, and cook until beginning to soften, 3 to 4 minutes more. Stir in spinach; cook and stir until spinach is wilted, about 2 more minutes."
    },
    {
      "position": 7,
      "text": "Add spaghetti squash, thoroughly combine with other ingredients, and saut\u00e9 until heated through, 3 to 4 minutes."
    },
    {
      "position": 8,
      "text": "Remove from heat; add cotija and pepitas and mix thoroughly. Taste and adjust adobo seasoning. Season with salt and pepper. Serve with diced avocado on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

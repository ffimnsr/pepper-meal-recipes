  "id": "78a7e76a-2213-5373-a8e1-73d6619becc1",
  "slug": "crispy-air-fryer-gnocchi-with-garlic-and-parmesan-recipe-12062565",
  "name": "Crispy Air Fryer Gnocchi with Garlic and Parmesan",
  "recipe_type": "appetizer",
  "brief_description": "These crispy gnocchi are seasoned with garlic, crushed red pepper, and Parmesan cheese. Refrigerated gnocchi is a superb shortcut ingredient, and the air fryer gets each bite perfectly golden in no time. Eat them by the handful or dip them in marinara or pesto.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss gnocchi with olive oil, melted butter, garlic butter, salt, red pepper, and Parmesan cheese."
    },
    {
      "position": 2,
      "text": "Air fry at 390 degrees F (199 degrees C) until crisp and golden brown, 15 to 18 minutes, shaking the basket every 5 to 6 minutes for even cooking."
    },
    {
      "position": 3,
      "text": "Sprinkle with more cheese and parsley if desired. Let cool slightly before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

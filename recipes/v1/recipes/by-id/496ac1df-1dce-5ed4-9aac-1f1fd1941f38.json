  "id": "496ac1df-1dce-5ed4-9aac-1f1fd1941f38",
  "slug": "split-pea-soup",
  "name": "Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This chunky split pea soup with potatoes, carrots, celery, and chunks of ham is the perfect comfort food on a cold and blustery day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place peas in a large stockpot and cover with several inches of cold water; let soak, 1 hour to overnight. Drain, rinse, and return peas to the pot."
    },
    {
      "position": 3,
      "text": "Add 2 quarts of cold water, ham bone, onion, salt, pepper, and marjoram to the stockpot. Cover, bring to a boil, and simmer for 1 \u00bd hours, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Remove ham bone; cut off meat, dice, and return meat to soup."
    },
    {
      "position": 5,
      "text": "Add celery, carrots, and potatoes."
    },
    {
      "position": 6,
      "text": "Cook slowly, uncovered, until vegetables are tender, about 30 to 40 minutes."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

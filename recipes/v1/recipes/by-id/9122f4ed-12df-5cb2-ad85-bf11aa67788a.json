  "id": "9122f4ed-12df-5cb2-ad85-bf11aa67788a",
  "slug": "best-potatoes-youll-ever-taste",
  "name": "Best Potatoes You'll Ever Taste",
  "recipe_type": "side",
  "brief_description": "A simple mayonnaise blend will transform your grilled potatoes into a flavorful cookout sensation!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "In a small bowl, mix mayonnaise, garlic, oregano, salt , and pepper. Set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of salted water to a boil. Add potatoes, and cook until almost done, about 10 minutes. Don't overcook otherwise the potatoes will break apart. Drain, and cool."
    },
    {
      "position": 4,
      "text": "Preheat oven broiler. Line a baking tray with aluminum foil, and lightly grease the aluminum foil."
    },
    {
      "position": 5,
      "text": "Arrange potatoes in the prepared baking tray. Spoon the mayonnaise mixture over the potatoes."
    },
    {
      "position": 6,
      "text": "Broil in the preheated oven until potatoes are tender and mayonnaise mixture is lightly browned, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

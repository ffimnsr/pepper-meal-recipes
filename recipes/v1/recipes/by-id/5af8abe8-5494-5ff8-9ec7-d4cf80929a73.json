  "id": "5af8abe8-5494-5ff8-9ec7-d4cf80929a73",
  "slug": "brooklyn-style-pizza-dough",
  "name": "Brooklyn-Style Pizza Dough",
  "recipe_type": "main",
  "brief_description": "This Brooklyn-style crust is a simple recipe for the famous New York pizza dough that can be made ahead so you can have a homemade slice anytime.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 cups bread flour, warm water, yeast, and salt in a bowl with an electric mixer fitted with the dough hook attachment. Mix on lowest speed until blended but still moist, about 2 minutes. Cover the bowl with a towel and let rise in a warm place until dough is doubled in volume, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Uncover the bowl and mix with the electric mixer on low speed until dough has pulled together, about 5 minutes. Sprinkle in remaining 1 cup flour , a little at a time, until soft, sticky dough forms, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Increase mixer speed to medium and mix until dough pulls away from sides of bowl, about 8 minutes. Cover the bowl with a towel and let rest, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, rub olive oil evenly into a plastic container."
    },
    {
      "position": 5,
      "text": "Transfer dough onto a floured work surface. Dust hands with flour and knead dough until soft but still wet on the inside. Form into a ball and place into the prepared container. Refrigerate dough for at least 1 day and up to 7 days."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

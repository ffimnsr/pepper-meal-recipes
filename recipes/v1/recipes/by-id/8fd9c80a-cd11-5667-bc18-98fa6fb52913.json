  "id": "8fd9c80a-cd11-5667-bc18-98fa6fb52913",
  "slug": "apple-mincemeat-pie",
  "name": "Apple Mincemeat Pie",
  "recipe_type": "dessert",
  "brief_description": "An easy apple mincemeat pie recipe. Use mincemeat plus apples and ready-made crusts to make a very tasty dessert perfect for fall and winter.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Place apples, butter, and lemon juice into a saucepan over medium heat and cook, stirring often, until apples are tender, 8 to 10 minutes. Stir in sugar, vanilla, cinnamon, and nutmeg. Mix in mincemeat and walnuts until thoroughly combined and set the pie filling aside."
    },
    {
      "position": 3,
      "text": "Fit pie crust into a 9-inch pie dish; pour filling into crust. With a brush dipped in water, moisten the edge of the bottom crust. Top pie with the second crust and crimp the two crusts together with a fork to seal. Cut 4 slits into top crust for steam vents. Whisk egg yolk with water in a small bowl and brush the yolk mixture over top crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes, then reduce oven temperature to 350 degrees F (175 degrees C). Remove pie from the oven and cover the crust edges with strips of aluminum foil to prevent overbaking. Return pie to the oven and bake until crust is golden brown and filling is bubbling, 30 to 35 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

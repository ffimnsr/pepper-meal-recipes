  "id": "11edd668-07ae-592a-bbbb-312bccea1b60",
  "slug": "miso-chicken-noodle-soup-recipe-8748347",
  "name": "Miso Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This miso chicken noodle soup, with thick, chewy udon noodles and a savory miso broth, is a tasty\u2014and very easy\u2014remake of traditional chicken noodle soup.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan over medium high heat, heat water to boiling. Add udon noodles. Cook until noodles are softened, 4 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add rotisserie chicken. Turn heat to low. Remove 2 to 3 tablespoons water, and stir miso paste into water until smooth. Mix diluted miso paste back into noodles. Cook for 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Ladle soup into bowls and garnish with everything bagel seasoning."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "c6d9ca90-09e2-5260-bf84-8e0889bd6457",
  "slug": "brazilian-style-flan-pudim-de-leite-condensado",
  "name": "Brazilian Style Flan (Pudim de Leite Condensado)",
  "recipe_type": "dessert",
  "brief_description": "This Brazilian-style flan (pudim de leite condensado) with rich caramel syrup is a decadent and creamy pudding made with eggs, sugar, and condensed milk.",
  "cuisine": "Brazilian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt sugar in a heavy saucepan over low heat, stirring constantly. Cook until sugar becomes a golden brown syrup, about 10 minutes. Pour immediately into a round baking dish, swirling so caramel syrup coats the sides of the dish. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Place egg yolks into a blender and blend on medium speed for 5 minutes. Add condensed milk, 3/4 cup plus 2 tablespoons milk, and egg whites. Continue to blend until well combined. Pour over hardened caramel syrup in the baking dish, then cover the dish with aluminum foil."
    },
    {
      "position": 4,
      "text": "Line a roasting pan with a damp kitchen towel. Place the baking dish on the towel inside the roasting pan, then place the roasting pan on the oven rack. Fill the roasting pan with boiling water to reach halfway up the sides of the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a knife inserted 1 inch from the edge comes out clean, 45 to 50 minutes. The center of flan will still be soft. Allow flan to cool before unmolding onto a plate. Refrigerate before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

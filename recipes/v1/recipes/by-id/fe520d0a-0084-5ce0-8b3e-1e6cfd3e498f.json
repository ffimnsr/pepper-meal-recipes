  "id": "fe520d0a-0084-5ce0-8b3e-1e6cfd3e498f",
  "slug": "ottilienkuchen-german-chocolate-sprinkles-cake",
  "name": "Ottilienkuchen (German Chocolate Sprinkle Cake)",
  "recipe_type": "dessert",
  "brief_description": "This is an authentic German recipe for a traditional German 'Ottilienkuchen' - a cake made with almond flour and chocolate sprinkles.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 355 degrees F (180 degrees C). Grease a loaf pan."
    },
    {
      "position": 2,
      "text": "Combine butter, sugar, and vanilla sugar in a bowl and beat with an electric mixer until creamy. Add eggs, 1 at a time, beating well after each addition. Mix in rum."
    },
    {
      "position": 3,
      "text": "Sift flour, cornstarch, baking powder, and salt into a separate bowl; stir into butter mixture, 1 tablespoon at a time. Mix in almond flour and chocolate sprinkles. Pour cake batter into prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick comes out clean, about 1 hour. Turn off oven and leave cake in the warm oven for 10 more minutes."
    },
    {
      "position": 5,
      "text": "Remove from oven and carefully unmold onto a wire rack. Cool completely before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

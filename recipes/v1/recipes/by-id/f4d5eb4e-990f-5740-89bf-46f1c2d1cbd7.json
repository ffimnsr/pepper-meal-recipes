  "id": "f4d5eb4e-990f-5740-89bf-46f1c2d1cbd7",
  "slug": "teriyaki-chicken-sliders-recipe-11828745",
  "name": "Teriyaki Chicken Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These teriyaki chicken sliders might be a little bit messy, but they are full of flavor! The easy recipe uses a rotisserie chicken, a homemade chili mayonnaise sauce, and a gingery homemade slaw to put it all together with some Asian flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "For mayonnaise sauce, stir mayonnaise, chili sauce, Sriracha, and rice vinegar together in a small bowl until smooth. Set aside."
    },
    {
      "position": 3,
      "text": "For slaw, mix cabbage, carrots, green onions, cilantro, lime juice, rice vinegar, soy sauce, fish sauce, garlic, and ginger together in a bowl. Set aside."
    },
    {
      "position": 4,
      "text": "In a separate bowl, stir chicken, teriyaki sauce, and sesame seeds together."
    },
    {
      "position": 5,
      "text": "Slice rolls open horizontally. Coat cut sides of top rolls with mayonnaise sauce. Add slaw to the cut sides of roll bottoms, top with chicken mixture. Add top rolls and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 35,

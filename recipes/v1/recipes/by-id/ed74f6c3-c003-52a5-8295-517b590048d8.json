  "id": "ed74f6c3-c003-52a5-8295-517b590048d8",
  "slug": "avocado-egg-salad-tostada-filling",
  "name": "Avocado-Egg Salad Tostada Filling",
  "recipe_type": "salad",
  "brief_description": "Hard-boiled eggs, bacon, and tomato are stirred into avocado in this savory tostada filling.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place the eggs into a saucepan in a single layer and fill with water to cover the eggs by 1 inch. Cover the saucepan and bring the water to a boil over high heat. Once the water is boiling, remove from the heat and let the eggs stand in the hot water for 15 minutes. Pour out the hot water, then cool the eggs under cold running water in the sink. Peel and chop once cold."
    },
    {
      "position": 2,
      "text": "Place the bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on a paper towel-lined plate. Crumble once cool."
    },
    {
      "position": 3,
      "text": "Mash the avocado in a mixing bowl with the lime juice, mustard powder, paprika, and salad dressing. Stir in the chopped eggs, crumbled bacon, diced tomato, and diced onion until evenly combined. Season to taste with salt and cayenne pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "95843d75-a042-54ed-8719-c4a8b1c972bd",
  "slug": "super-moist-meatloaf",
  "name": "Super Moist Meatloaf",
  "recipe_type": "main",
  "brief_description": "This moist meatloaf with onion, green bell pepper, sage, and a ketchup glaze is made with chunks of bread instead of crumbs for a juicier texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together ground beef, onion, bread, beaten eggs, milk, bell pepper, salt, sage, and black pepper in a large bowl until well combined. Press into a 9x5-inch loaf pan. Spread ketchup over the top of loaf."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until no longer pink in the center, about 45 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

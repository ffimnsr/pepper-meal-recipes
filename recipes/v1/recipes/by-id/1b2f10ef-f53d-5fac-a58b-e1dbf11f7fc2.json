{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1b2f10ef-f53d-5fac-a58b-e1dbf11f7fc2",
  "slug": "lime-pickles",
  "name": "Lime Pickles",
  "recipe_type": "side",
  "brief_description": "Homemade lime pickles, made with pickling lime or slaked lime, are worth the wait using this DIY recipe. Serve them with ham for a delicious pairing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 gallons water and pickling lime in a large bowl; add cucumbers and soak, stirring often, for 24 hours."
    },
    {
      "position": 2,
      "text": "Drain cucumbers; thoroughly rinse under cold water. Fill a large bowl with ice water; add cucumbers and soak for 3 hours. Drain."
    },
    {
      "position": 3,
      "text": "Pour cold vinegar into a large pot; stir in sugar, pickling spice, salt, celery seeds, cloves, and food coloring until dissolved. Add cucumbers; set aside, 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Bring cucumber mixture to a boil; remove pot from the heat."
    },
    {
      "position": 5,
      "text": "Inspect 11 pint-sized jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until pickles are ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 6,
      "text": "Pack cucumber mixture into hot, sterilized jars, filling to within \u00bc inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims of jars with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 7,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 15 minutes."
    },
    {
      "position": 8,
      "text": "Remove jars from the stockpot and place onto a cloth-covered or wood surface, several inches apart, until cool. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],

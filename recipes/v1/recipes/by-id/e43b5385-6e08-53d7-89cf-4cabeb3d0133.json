  "slug": "basil-walnut-pesto-recipe-6563576",
  "name": "Basil Walnut Pesto",
  "recipe_type": "side",
  "brief_description": "This basil walnut pesto is flavor-packed, and simple to make. Just pulse a few ingredients together with a food processor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine basil, walnuts, Parmesan, oil, garlic, and salt in a food processor. Cover; process until nearly smooth. If needed, add water, a tablespoon at a time, to thin to desired consistency."
    },
    {
      "position": 3,
      "text": "Transfer to a bowl; cover surface of pesto with plastic wrap. Chill up to 3 days."
    }
  ],

  "id": "9eb6fb7d-6499-5d63-a70c-0c165188a3cc",
  "slug": "rosemary-garlic-knots",
  "name": "Rosemary Garlic Knots",
  "recipe_type": "appetizer",
  "brief_description": "Here is a quick-and-easy recipe for garlic knots that are extremely flavorful. Try them for parties and other get-togethers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Shape biscuit dough into 12 balls. Roll each ball into a 4- to 6-inch long strip."
    },
    {
      "position": 3,
      "text": "Combine olive oil, rosemary, garlic, chili powder, salt, basil, oregano, and pepper in a bowl. Dip dough strips one-by-one into the oil mixture and roll until totally covered. Tie each strip into a knot, stretching as needed. Place knots on an ungreased baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

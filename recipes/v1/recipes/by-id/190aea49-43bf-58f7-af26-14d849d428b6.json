  "id": "190aea49-43bf-58f7-af26-14d849d428b6",
  "slug": "shrimp-quesadillas",
  "name": "Shrimp Quesadillas",
  "recipe_type": "side",
  "brief_description": "This shrimp quesadilla recipe with bell peppers, spicy shrimp, and melted Mexican cheese inside golden crispy tortillas is a real crowd-pleaser.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a large skillet over medium-high heat. Add onion and bell peppers; cook, stirring frequently, until onion is translucent and peppers are soft, 6 to 8 minutes. Add salt, cumin, and chili powder; stir to coat vegetables."
    },
    {
      "position": 2,
      "text": "Add shrimp; cook and stir until shrimp are opaque and no longer pink in the center, 3 to 5 minutes. Remove from the heat and stir in minced jalape\u00f1o and lime juice."
    },
    {
      "position": 3,
      "text": "Heat another skillet over medium heat and brush with about 1 teaspoon oil. Place one tortilla in the hot skillet; spoon about 1/6 of the shrimp filling and 1/2 cup Mexican cheese blend onto one side of tortilla. Fold tortilla in half. Cook until lightly browned on the bottom, about 5 minutes. Flip and cook until lightly browned on the other side, 3 to 5 minutes. Repeat to make remaining quesadillas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

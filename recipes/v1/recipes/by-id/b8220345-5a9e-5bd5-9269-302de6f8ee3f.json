  "id": "b8220345-5a9e-5bd5-9269-302de6f8ee3f",
  "slug": "asparagus-cashew-rice-pilaf",
  "name": "Asparagus Cashew Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "Toasted cashews and tender asparagus are mixed with seasoned jasmine rice and cooked pasta.",
  "cuisine": "Armenian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium saucepan over medium-low heat. Increase heat to medium, and stir in spaghetti, cooking until coated with the melted butter and lightly browned."
    },
    {
      "position": 2,
      "text": "Stir onion and garlic into the saucepan, and cook about 2 minutes, until tender. Stir in jasmine rice, and cook about 5 minutes. Pour in vegetable broth. Season mixture with salt and pepper. Bring the mixture to a boil, cover, and cook 20 minutes, until rice is tender and liquid has been absorbed."
    },
    {
      "position": 3,
      "text": "Place asparagus in a separate medium saucepan with enough water to cover. Bring to a boil, and cook until tender but firm."
    },
    {
      "position": 4,
      "text": "Mix asparagus and cashew halves into the rice mixture, and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

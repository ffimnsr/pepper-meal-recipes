  "id": "ff384e32-e844-5b07-8b46-8e7e9eabd80a",
  "slug": "tomato-tortellini-soup-recipe-11817706",
  "name": "Tomato Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "This tomato tortellini soup, a velvety soup with creamy cheese tortellini, cooks in one pot and is cozy and comforting on a nippy fall day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a stock pot over medium heat. Add tomatoes; cover and cook until tomatoes soften, about 10 minutes. Stir and crush tomatoes. Stir in onion, shallots, garlic, and Cantanzaro herbs. Season with salt and pepper; cover and cook for an additional 8 minutes."
    },
    {
      "position": 2,
      "text": "Pour in bone broth. Using an immersion blender, blend until mixture is smooth and no lumps remain. Stir in heavy cream and tortellini; simmer until tortellini is tender with a bite, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Garnish soup with basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

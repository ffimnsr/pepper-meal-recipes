  "id": "64c1a346-b6cd-5bf4-b384-df86a7738d9e",
  "slug": "pineapple-sriracha-salsa-recipe-8663130",
  "name": "Pineapple Sriracha Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This pineapple Sriracha salsa is so refreshing and delicious, bursting with all kinds of flavor, and it will even be better after it is chilled. The most difficult part of this recipe will be deciding what to serve it on - it\u2019s equally good on tacos and pulled pork, and\u2014believe it or not\u2014it\u2019s superb on ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a strainer over a bowl, and transfer in pineapple chunks. Let drain well, and reserve juice."
    },
    {
      "position": 2,
      "text": "Preheat the oven\u2019s broiler to High and set a rack 8 inches from the heat source. Line a rimmed baking sheet with foil, and lightly oil the foil."
    },
    {
      "position": 3,
      "text": "Spread pineapple chunks onto the prepared pan. Add onion and garlic and spread out evenly."
    },
    {
      "position": 4,
      "text": "Broil pineapple until tops of pineapple chunks and onions are charred, about 5 minutes. Let cool to room temperature, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove garlic cloves and set aside. Transfer pineapple and onions into a blender. Peel garlic cloves; add to the blender; add in reserved pineapple juice, Sriracha, mint leaves, salt, and vinegar. Blend until the mixture is as smooth or chunky as you like. Taste for seasoning."
    },
    {
      "position": 6,
      "text": "Cover and refrigerate for at least 1 hour before serving. Salsa can be made up to 3 days ahead."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

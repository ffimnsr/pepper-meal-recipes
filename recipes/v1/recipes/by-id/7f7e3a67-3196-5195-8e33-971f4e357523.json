  "slug": "italian-amaretto-margaritas-on-the-rocks",
  "name": "Italian Amaretto Margaritas On the Rocks",
  "recipe_type": "drink",
  "brief_description": "This quick and easy recipe for an Italian-style margarita calls for amaretto, triple sec, and tequila for a delicious twist on a classic cocktail.",
  "cuisine": "Mexican Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Slightly moisten rims of four 12-ounce glasses and dip in confectioners' sugar to rim the glasses; fill each with crushed ice."
    },
    {
      "position": 2,
      "text": "Combine sweet and sour mix, tequila, amaretto, and orange liqueur in a pitcher; stir. Pour mixture into the prepared glasses. Garnish each drink with orange and lime slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

  "id": "df97b9b8-3c15-51c5-801e-6fbc04aaf6cc",
  "slug": "lauras-maryland-crab-cakes",
  "name": "Laura's Maryland Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "This recipe delivers a Maryland-style crab cake thanks to the addition of seafood seasoning, parsley, and mayonnaise.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Mix egg, Worcestershire sauce, mayonnaise, parsley, seafood seasoning, baking powder, and salt together with your hands in a large mixing bowl. Tear bread into tiny bits; add to the egg mixture. Gently fold in crabmeat; form into 4 cakes and arrange onto a lined baking sheet."
    },
    {
      "position": 2,
      "text": "Refrigerate at least 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake crab cakes until heated through and lightly browned, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

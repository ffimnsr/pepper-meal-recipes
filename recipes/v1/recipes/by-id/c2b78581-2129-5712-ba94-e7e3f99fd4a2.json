  "id": "c2b78581-2129-5712-ba94-e7e3f99fd4a2",
  "slug": "eggplant-with-garlic-sauce",
  "name": "Chinese Eggplant with Garlic Sauce",
  "recipe_type": "dessert",
  "brief_description": "Chinese eggplant slices cooked with garlic, soy and oyster sauce, sugar, and chili flakes for a sweet and spicy side dish that doesn't skimp on flavor!",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over high heat. Cook and stir eggplant in hot oil until soft, about 4 minutes. Stir in water, garlic powder, and red pepper flakes. Cover and simmer until water is absorbed."
    },
    {
      "position": 2,
      "text": "Meanwhile, whisk soy sauce, oyster sauce, sugar, and cornstarch together in a small bowl until sugar and cornstarch are dissolved."
    },
    {
      "position": 3,
      "text": "Stir soy sauce mixture into eggplant until evenly coated; continue cooking until sauce has thickened."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

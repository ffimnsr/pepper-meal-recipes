  "id": "2795dad1-b4a8-5ab8-827f-e64e52636542",
  "slug": "butter-lettuce-salad-with-lemon-garlic-yogurt-dressing-recipe-12012519",
  "name": "Butter Lettuce Salad with Lemon-Garlic Yogurt Dressing",
  "recipe_type": "salad",
  "brief_description": "This butter lettuce salad with lemon-garlic yogurt dressing is a fresh, easy side that goes with just about anything. Add your favorite vegetables, like cucumbers, carrots, or radishes, or keep it simple\u2014the creamy, herby dressing ties everything together beautifully.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place parsley, Greek yogurt, toum, lemon juice, lemon zest, Italian seasoning, salt, and pepper into a food processor or blender. Puree until smooth. Taste, and add more lemon juice, salt, or pepper as needed."
    },
    {
      "position": 2,
      "text": "Place lettuce in a large bowl or on a plate. Top with red onion, grape tomatoes, and croutons. Drizzle with dressing and serve immediately. Refrigerate any extra dressing."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "113c2b1d-3f8e-588c-af79-f32032746cee",
  "slug": "easy-sous-vide-corned-beef",
  "name": "Easy Sous Vide Corned Beef",
  "recipe_type": "main",
  "brief_description": "Try cooking corned beef sous vide for Saint Patrick's Day--all you need is a bit of planning ahead.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Remove corned beef from the packaging and submerge in water. Discard seasoning packet. Cover and refrigerate overnight, up to 8 hours."
    },
    {
      "position": 2,
      "text": "Drain corned beef the next morning and pat dry. Paint all the sides with browning liquid. Sprinkle garlic powder and onion powder all over."
    },
    {
      "position": 3,
      "text": "Place seasoned corned beef in a sealable plastic bag and seal in a food vacuum-type sealer."
    },
    {
      "position": 4,
      "text": "Place sealed bag into the sous vide container and secure. Set circulator for 165 degrees Fahrenheit (74 degrees Celsius), set timer for 10 hours, and start the circulator."
    },
    {
      "position": 5,
      "text": "Carefully remove sealed bag from the water bath and allow to cool until it can easily be handled, about 10 minutes. Slice corned beef into 1/4-inch-thick slices, or to desired thickness."
    }
  ],

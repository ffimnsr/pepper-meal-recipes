{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a4404ea6-7692-53bc-963c-d83117e41f52",
  "slug": "beef-and-mushroom-stuffed-peppers",
  "name": "Beef and Mushroom Stuffed Peppers",
  "recipe_type": "side",
  "brief_description": "A beefy alternative to 'Italian-style' stuffed peppers, great with any white rice-based side dish, or mashed potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Brown beef in a large skillet over medium-high heat. Halfway through browning, add mushrooms and onion. Continue cooking until meat is fully browned; drain fat from skillet. Stir in enough gravy to bond mixture without making it soupy. Season with salt and pepper, and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat a medium saucepan of water until boiling. Place peppers in water, and boil for 2 to 3 minutes, until just tender; remove from water. Place peppers, hollow side up, in a 9x13 inch baking dish, and fill each with beef mixture."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 15 to 20 minutes, until bubbling. Top with cheese, and bake for an additional 5 to 10 minutes. Serve in a small pool of gravy."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

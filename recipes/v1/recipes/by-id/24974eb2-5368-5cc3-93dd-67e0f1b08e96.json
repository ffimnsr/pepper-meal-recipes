  "id": "24974eb2-5368-5cc3-93dd-67e0f1b08e96",
  "slug": "daves-georgia-black-eyed-peas",
  "name": "Dave's Georgia Black-Eyed Peas",
  "recipe_type": "side",
  "brief_description": "This tasty black-eyed peas recipe involves cooking the black-eyed peas low and slow with bacon, onion, and ham. Serve with cornbread for a hearty meal.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse, pick over, and place peas in a large bowl. Cover with several inches of cool water; let stand 8 hours to overnight. Drain and rinse."
    },
    {
      "position": 3,
      "text": "Pour water into a large saucepan or stockpot. Add bouillon cubes and bring to a boil, stirring occasionally to dissolve bouillon. Stir in peas; reduce heat and bring to a simmer."
    },
    {
      "position": 4,
      "text": "Place bacon in a large, deep skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on a paper towel-lined plate. Crumble bacon and set aside."
    },
    {
      "position": 5,
      "text": "Melt butter in the pan with bacon grease; cook and stir onions until they begin to turn brown at the edges, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Stir onions and cooking fat into peas; add crumbled bacon, ham, salt, and pepper to taste. Simmer over low heat for 8 hours, stirring every hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 500,
  "preparation_time_minutes": 15,

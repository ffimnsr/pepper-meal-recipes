  "id": "29667bf0-e2a2-5ca6-ba71-e8b0323b8976",
  "slug": "vinegar-pickled-carrots",
  "name": "Vinegar Pickled Carrots",
  "recipe_type": "salad",
  "brief_description": "This tasty pickled carrots recipe is easy to prepare and sure to please everyone. It makes a great accompaniment to sandwiches or garnish for salads.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix distilled white vinegar, water, white sugar, salt, and pepper in a medium saucepan. Bring the mixture to a boil. Remove from heat and allow to cool slightly."
    },
    {
      "position": 2,
      "text": "Place carrots in sterile containers. Cover with the vinegar solution."
    },
    {
      "position": 3,
      "text": "Seal the containers, refrigerate and marinate carrots, 12 hours or overnight before serving."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 15,

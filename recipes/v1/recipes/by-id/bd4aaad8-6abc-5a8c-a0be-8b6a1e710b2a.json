{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bd4aaad8-6abc-5a8c-a0be-8b6a1e710b2a",
  "slug": "lepinja-balkan-flatbread",
  "name": "Lepinja (Balkan Flatbread)",
  "recipe_type": null,
  "brief_description": "This lepinja made with yeast rises three separate times before baking, giving it a complex flavor.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle the yeast over the warm milk in a small bowl. Let stand for 5 minutes until the yeast softens and begins to form a creamy foam. Stir the warm water and sugar into the yeast mixture."
    },
    {
      "position": 2,
      "text": "Stir the flour and salt together in a separate bowl; add all but about 1/2 cup of the flour mixture to the yeast mixture; mix with your hands until a soft dough forms, adding the last of the flour mixture a little at a time until it clears the sides of the bowl. Cover the bowl with a light cloth and let the dough rise in a warm place (80 to 95 degrees F (27 to 35 degrees C)) until doubled in volume, about 1 hour."
    },
    {
      "position": 3,
      "text": "Deflate, or 'punch down,' the dough and turn out onto a work surface lightly dusted with flour; knead for about 5 minutes. Return the dough to the bowl, cover again with a light cloth, and allow the dough to again rise until doubled in volume, about 30 minutes more."
    },
    {
      "position": 4,
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 5,
      "text": "Deflate the dough and turn turn out onto a work surface lightly dusted with flour; knead lightly. Place the dough onto the prepared baking sheet; shape into an oval about 1/2-inch thick. Set aside to rise a third time for about 30 minutes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until nicely browned and hollow sounding when thumped, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

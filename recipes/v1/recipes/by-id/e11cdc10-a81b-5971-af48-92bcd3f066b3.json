  "id": "e11cdc10-a81b-5971-af48-92bcd3f066b3",
  "slug": "chicken-cordon-bleu-bites",
  "name": "Chicken Cordon Bleu Bites",
  "recipe_type": "appetizer",
  "brief_description": "Appetizer-size ham and chicken meatballs have the surprise of melted Swiss cheese tucked inside. Easy to make, these tasty chicken Bordon Bleu bites are coated in bread crumbs, then deep-fried and baked.",
  "cuisine": "New England Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine chicken, ham, and egg in a large bowl until well-blended. Gradually add bread crumbs until mixture loses its stickiness and can be easily formed into balls. Season with salt and pepper to taste."
    },
    {
      "position": 3,
      "text": "Form chicken mixture around cheese cubes, forming 2-inch balls. Place on a plate."
    },
    {
      "position": 4,
      "text": "Heat 1 1/2 inches of oil in a deep skillet to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Fry balls in hot oil until golden brown, about 4 minutes. Drain on paper towels and place in a baking dish."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cooked through and cheese is soft, about 20 minutes. Cool briefly before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

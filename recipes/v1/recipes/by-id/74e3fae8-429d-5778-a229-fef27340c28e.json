  "id": "74e3fae8-429d-5778-a229-fef27340c28e",
  "slug": "pumpkin-wheat-honey-muffins",
  "name": "Pumpkin Wheat Honey Muffins",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin wheat honey muffin recipe is sweetened with honey and studded with plump raisins and chopped walnuts for a wholesome snack any time of day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Place raisins in a cup; add hot water to cover. Set aside to plump, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk whole wheat flour, brown sugar, pumpkin pie spice, baking powder, baking soda, and salt together in a large bowl; make a well in the center. Add pumpkin pur\u00e9e, oil, honey, and eggs to the well; mix well."
    },
    {
      "position": 4,
      "text": "Drain excess water from raisins. Stir raisins and walnuts into batter. Spoon batter into the prepared muffin cups, filling each \u2154 full."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops spring back when lightly touched, about 18 minutes. Cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

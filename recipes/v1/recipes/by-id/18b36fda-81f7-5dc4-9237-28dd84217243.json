  "id": "18b36fda-81f7-5dc4-9237-28dd84217243",
  "slug": "chicken-parmesan-casserole",
  "name": "Chicken Parmesan Casserole",
  "recipe_type": "main",
  "brief_description": "This easy chicken Parmesan casserole with cooked chicken, pasta, mozzarella, marinara, and bread crumbs makes a tasty twist on the Italian classic.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Cook rotini in boiling water until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Stir together cooked rotini, chicken, and mozzarella cheese in a large casserole dish."
    },
    {
      "position": 4,
      "text": "Pour marinara sauce over pasta mixture; sprinkle with bread crumbs. Cover the dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, about 35 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

  "id": "cb1de5ba-eeaa-5fe6-8290-77006fb7b09d",
  "slug": "peaches-with-burrata-basil-and-raspberry-balsamic-syrup",
  "name": "Peach Burrata Salad",
  "recipe_type": "salad",
  "brief_description": "This colorful peach burrata salad, with juicy peach slices, creamy burrata cheese, and basil leaves, is dressed with a delicious balsamic syrup.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gently tear open the burrata cheese to expose the soft, creamy core and place in the center of a plate. Arrange peach slices in and around the cheese. Sprinkle basil leaves over cheese and drizzle with olive oil."
    },
    {
      "position": 2,
      "text": "Bring raspberry balsamic vinegar to a boil in a small saucepan; reduce heat to medium-low and simmer until vinegar reduces to a thick syrup, about 5 minutes. Spoon balsamic syrup over peaches and cheese; season with sea salt and black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

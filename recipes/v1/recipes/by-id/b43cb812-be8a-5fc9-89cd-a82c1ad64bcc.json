  "schema_version": 1,
  "id": "b43cb812-be8a-5fc9-89cd-a82c1ad64bcc",
  "slug": "instant-pot-pot-roast-with-potatoes-and-carrots",
  "name": "Instant Pot Pot Roast with Potatoes and Carrots",
  "recipe_type": "side",
  "brief_description": "In your Instant Pot, carrots and potatoes cook alongside a delicious pot roast, then the drippings are thickened and cooked to make a savory gravy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons oil in a multi-functional pressure cooker (such as Instant Pot) set to the Saut\u00e9 function. Add roast to hot oil and cook until browned all over, 4 to 5 minutes per side. Pour in broth."
    },
    {
      "position": 3,
      "text": "Combine potatoes, carrots, onion, soup mix, and remaining 2 tablespoons oil in a resealable plastic bag. Seal the bag and shake until vegetables are evenly coated."
    },
    {
      "position": 4,
      "text": "Pour mixture into the pressure cooker and spread out evenly."
    },
    {
      "position": 5,
      "text": "Close and lock the lid. Select high pressure according to the manufacturer's instructions; set the timer for 60 minutes. Allow 10 to 15 minutes for the pressure to build. Release the pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 6,
      "text": "Transfer roast and vegetables to a serving platter, leaving drippings in the pot."
    },
    {
      "position": 7,
      "text": "Select the Saut\u00e9 function and bring drippings to a boil. Combine water and cornstarch in a bowl; pour into the drippings. Cook, stirring frequently, until gravy is slightly thickened, 2 to 3 minutes. Season with garlic salt and pepper. Slice roast and serve with vegetables and gravy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

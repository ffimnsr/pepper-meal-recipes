  "id": "efe64426-aa86-5137-9da5-46e48b5c8d66",
  "slug": "savory-turkey-gravy",
  "name": "Savory Turkey Gravy",
  "recipe_type": "side",
  "brief_description": "This gravy for your Thanksgiving turkey is easy to make with turkey stock, poultry seasoning, celery salt, and black pepper.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring turkey stock to a boil in a medium saucepan."
    },
    {
      "position": 2,
      "text": "Whisk water and flour together in a small bowl until smooth; gradually whisk into turkey stock. Season with poultry seasoning, salt, pepper, and celery salt."
    },
    {
      "position": 3,
      "text": "Bring to a boil, reduce heat, and simmer until thickened, 8 to 10 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

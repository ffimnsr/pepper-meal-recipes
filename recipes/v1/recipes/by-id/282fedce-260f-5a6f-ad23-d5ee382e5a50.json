  "id": "282fedce-260f-5a6f-ad23-d5ee382e5a50",
  "slug": "easy-rotisserie-chicken-enchiladas-recipe-11706233",
  "name": "Easy Rotisserie Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "These easy rotisserie chicken enchiladas can be assembled in no time, and are a timesaver for busy weekday nights. Rotisserie chicken and premade enchilada sauce save the day!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place a wire rack on a baking sheet."
    },
    {
      "position": 2,
      "text": "Heat oil in a heavy skillet. Quickly fry tortillas in the hot oil, about 5 seconds per side. Remove tortillas to the wire rack to drain. Dab excess oil with a paper towel."
    },
    {
      "position": 3,
      "text": "Pour a thin layer of enchilada sauce into the bottom of a casserole dish."
    },
    {
      "position": 4,
      "text": "Place shredded chicken in a bowl, sprinkle enchilada seasoning over chicken; toss to combine. Place 3 tablespoons chicken along center of each enchilada. Sprinkle with 1 1/2 tablespoons cheese. Roll up to form enchiladas. Place enchiladas seam side down in the casserole dish. Top with remaining enchilada sauce and sprinkle evenly with cheese. Cover with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 minutes. Turn on the oven\u2019s broiler, remove foil from enchiladas, and broil until cheese is melted and golden, about 5 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

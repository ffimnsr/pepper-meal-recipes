  "id": "bd04ddba-c1c3-5745-95f4-2a94ea230620",
  "slug": "hot-german-potato-salad-iii",
  "name": "Hot German Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This hot German potato salad recipe is packed with flavor thanks to the addition of crispy bacon, tender onions, sugar, vinegar, and black pepper.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain, cool, and slice thin."
    },
    {
      "position": 2,
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside, reserving drippings."
    },
    {
      "position": 3,
      "text": "Saut\u00e9 onions in bacon drippings over medium heat until they are golden brown."
    },
    {
      "position": 4,
      "text": "Whisk flour, sugar, salt, celery seed, and pepper together in a small bowl; stir into onions and cook until bubbling, then remove from heat. Stir in water and vinegar; bring to a boil over medium heat, stirring constantly, and simmer for one minute. Gently stir bacon and sliced potatoes into the onion mixture until potatoes are heated through."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

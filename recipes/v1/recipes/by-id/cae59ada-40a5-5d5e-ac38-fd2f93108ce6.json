  "id": "cae59ada-40a5-5d5e-ac38-fd2f93108ce6",
  "slug": "potluck-pasta-salad-recipe-11998743",
  "name": "Potluck Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This is the best potluck pasta salad, with ditalini, pepperoni, provolone, bell pepper, pepperoncini, cucumber, and red onion tossed in a classic red wine vinaigrette. It\u2019s easy to prepare, packed with flavor, and serves a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add pasta, and cook until al dente according to package directions. Drain, rinse and set aside."
    },
    {
      "position": 2,
      "text": "For salad, add pasta, pepperoni, provolone, red onion, cucumber, pepperoncini, red bell pepper, black olives, and parsley to a large bowl."
    },
    {
      "position": 3,
      "text": "For dressing, combine olive oil, wine vinegar, pepperoncini brine, garlic, Dijon mustard, salt, black pepper, oregano, and Parmesan in a jar or bowl, and mix until well blended."
    },
    {
      "position": 4,
      "text": "Pour dressing over pasta mixture and toss well to coat. Cover and refrigerate until ready to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "48b51b40-a2a8-5baa-a1cc-3a9a09538635",
  "slug": "pork-sausage-gravy",
  "name": "Pork Sausage Gravy",
  "recipe_type": "side",
  "brief_description": "Hearty pork sausage and gravy to pour over homemade biscuits or toast. Water may be substituted for the milk.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Break up sausage in a skillet and brown. Remove from the skillet and set aside."
    },
    {
      "position": 2,
      "text": "Add flour and stir until all drippings are absorbed, adding more flour if necessary."
    },
    {
      "position": 3,
      "text": "Stir in milk a little at a time until creamy. Add cooked sausage back to the skillet and season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

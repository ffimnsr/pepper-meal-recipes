  "id": "730beb9b-ba2b-5496-9723-3aa176e5ad9d",
  "slug": "ezekiel-bread-i",
  "name": "Ezekiel Bread",
  "recipe_type": "appetizer",
  "brief_description": "Ezekiel bread is made with nutrient-rich flour. You can make your own Ezekiel bread at home by grinding a variety of whole grains and legumes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix water, honey, olive oil, and yeast in a large bowl. Let sit for 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir together wheat berries, spelt flour, barley, millet, lentils, great northern beans, kidney beans, and pinto beans together until well mixed."
    },
    {
      "position": 4,
      "text": "Grind in a flour mill."
    },
    {
      "position": 5,
      "text": "Add fresh milled flour mixture and salt to yeast mixture; stir until well mixed, about 10 minutes. The dough will be loose."
    },
    {
      "position": 6,
      "text": "Pour dough into two greased 9x5-inch loaf pans. Let rise in a warm place until dough has reached the top of the pan, about 1 hour."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until loaves are golden brown, 45 to 50 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

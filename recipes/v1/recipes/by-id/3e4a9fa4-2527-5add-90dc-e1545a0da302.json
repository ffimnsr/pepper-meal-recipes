  "id": "3e4a9fa4-2527-5add-90dc-e1545a0da302",
  "slug": "quesadillas-i",
  "name": "Easy Quesadillas",
  "recipe_type": "appetizer",
  "brief_description": "Learn how to make quesadillas with this easy recipe that melts cheese, hot sauce, and avocados inside crunchy tortilla triangles for a cheesy treat.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large frying pan or griddle over a medium heat. Place one tortilla flat on the frying pan. Cook for 1 minute, then flip the tortilla over."
    },
    {
      "position": 3,
      "text": "Sprinkle a little more than 1/4 cup cheese on top of tortilla, followed by some olives, avocado, and hot pepper sauce. Place another tortilla on top to make a sandwich; cover with a lid. Cook for 1 minute, then flip the quesadilla. Cook until cheese has melted on the inside; transfer quesadilla to a plate. Repeat with remaining ingredients."
    },
    {
      "position": 4,
      "text": "Cut the quesadillas into triangles and serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

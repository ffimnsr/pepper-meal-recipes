  "slug": "easy-coleslaw-dressing",
  "name": "Easy Coleslaw Dressing",
  "recipe_type": "salad",
  "brief_description": "For a coleslaw recipe that's creamy and delicious, toss this easy-to-make, 5-minute homemade dressing with a bag of store-bought coleslaw mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, sugar, lemon juice, vinegar, pepper, and salt together in a bowl until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Store in an airtight container in the refrigerator for up to 1 week. Stir before using."
    }
  ],

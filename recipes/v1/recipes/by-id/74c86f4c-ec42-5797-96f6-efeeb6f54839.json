{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "74c86f4c-ec42-5797-96f6-efeeb6f54839",
  "slug": "spanakopita-greek-spinach-pie",
  "name": "Spanakopita (Greek Spinach Pie)",
  "recipe_type": "main",
  "brief_description": "This authentic Greek spanakopita with layers of crispy, flaky phyllo dough and a rich spinach and feta cheese filling makes an impressive main dish.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly oil a 9-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Heat 3 tablespoons olive oil in a large skillet over medium heat. Add chopped onion, green onions, and garlic; cook and stir until soft and lightly browned, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in spinach and parsley, adding spinach in batches if it doesn't all fit in the skillet at once; cook until spinach is limp and excess liquid has evaporated, about 5 minutes. Remove from the heat; set aside to cool."
    },
    {
      "position": 4,
      "text": "Combine feta cheese, ricotta cheese, and eggs in a large bowl until well combined; stir in spinach mixture. Lay one phyllo dough sheet in the prepared baking pan; brush lightly with olive oil. Lay another phyllo dough sheet on top; brush with olive oil. Repeat with two more phyllo dough sheets; the sheets will overlap the pan."
    },
    {
      "position": 5,
      "text": "Spread spinach and cheese mixture into the pan. Fold any overhanging phyllo dough over filling; brush with oil."
    },
    {
      "position": 6,
      "text": "Layer in remaining 4 phyllo dough sheets, brushing each with oil. Tuck overhanging phyllo dough into the pan to seal the filling."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 30 to 40 minutes."
    },
    {
      "position": 8,
      "text": "Cut into squares and serve while hot."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,

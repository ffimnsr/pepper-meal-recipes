{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "23246ff5-0a43-55f6-b291-f721abbdb390",
  "slug": "veggie-frittata",
  "name": "Veggie Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This nutritious recipe is a favourite of egg farmers Mark and Joanie Hamel of Watford. The vegetables can be varied to your preference.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium (10-inch/25 cm) frying pan over medium heat. Add mushrooms, peppers and onion; saute until tender."
    },
    {
      "position": 2,
      "text": "While vegetables are cooking, whisk together eggs and water. Pour egg mixture over vegetables in the frying pan. Cover and cook over medium heat, occasionally poking through the mixture to allow uncooked egg to flow to the bottom of the pan."
    },
    {
      "position": 3,
      "text": "When bottom is cooked and top is almost set, finish cooking the frittata on the stove top by covering it with a lid for a few minutes, or flip it over in the pan to cook the top, or cook the top under the broiler."
    },
    {
      "position": 4,
      "text": "To flip the frittata, place a dinner plate over the pan holding it firmly in place, then turn the frying pan and plate upside down. The frittata will fall into the plate, top side down. Slide the frittata back into the frying pan, top down. Cook for a few minutes until top (now the bottom) is cooked."
    },
    {
      "position": 5,
      "text": "Alternately, place the frying pan under a preheated broiler until the top is cooked and slightly puffed, about a minute or two. The frying pan must be ovenproof in order to do this. To ovenproof the handle, wrap it with a double thickness of aluminum foil."
    },
    {
      "position": 6,
      "text": "Cut into wedges and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "d719ced0-77e2-55ef-8998-8dd357d348cc",
  "slug": "crispy-coconut-shrimp-tacos-recipe-11748596",
  "name": "Crispy Coconut Shrimp Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These crispy coconut shrimp tacos are simply delicious. They are served with homemade pineapple avocado salsa and cilantro-lime crema for extra flavor.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pat shrimps dry with paper towels."
    },
    {
      "position": 3,
      "text": "Combine flour, 1/2 teaspoon salt, and 1/4 teaspoon black pepper in a shallow bowl. Whisk together egg and coconut milk in another shallow bowl. Stir together panko and shredded coconut in a third shallow bowl."
    },
    {
      "position": 4,
      "text": "With basket inserted in the appliance, preheat air fryer to 350 degrees F (175 degrees C) for 10 minutes. Preheat oven to 170 degrees F (77 degrees C) (or the warm setting)."
    },
    {
      "position": 5,
      "text": "Working in batches, dredge shrimp in flour mixture to coat, shaking off excess. Dip shrimp in egg mixture, letting excess drip off, and toss shrimp in panko mixture, pressing gently to adhere. Place breaded shrimp on a large plate. Generously coat shrimp on top and sides with cooking spray."
    },
    {
      "position": 6,
      "text": "Coat the air-fryer basket generously with the cooking spray. Arrange half of the shrimp in the prepared basket. Do not crowd shrimp. Air-fry until shrimp are golden brown and crispy, shaking the basket or turning the shrimp once halfway through cooking, 7 to 9 minutes. Transfer cooked shrimp to a baking sheet and place in the warm oven while cooking the remaining shrimp."
    },
    {
      "position": 7,
      "text": "For salsa, combine pineapple, avocado, bell pepper, red onion, cilantro, lime juice, and hot sauce in a small bowl."
    },
    {
      "position": 8,
      "text": "For crema, combine sour cream, cilantro, mayonnaise, lime juice, and salt in a small bowl."
    },
    {
      "position": 9,
      "text": "Divide hot coconut shrimp (about two each) among tortillas. Spoon salsa over shrimp and top with crema. Serve immediately with additional hot sauce if you like."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

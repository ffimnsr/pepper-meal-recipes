  "id": "f2738e30-a06f-5ecd-a483-2418461bc079",
  "slug": "spicy-apple-cake",
  "name": "Spicy Apple Cake",
  "recipe_type": "dessert",
  "brief_description": "This delicious spicy apple cake recipe is made with fresh apples, spices, and sugar. It's a wonderfully perfect treat for the apple harvest season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch square pan."
    },
    {
      "position": 2,
      "text": "Sift flour, 1 teaspoon cinnamon, baking powder, \u00bc teaspoon nutmeg, baking soda, and salt into a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat brown sugar, \u00bd cup shortening, and white sugar together in a large bowl until light and fluffy; beat in eggs, one at a time, then stir in vanilla extract. Beat in flour mixture, alternating with regular milk, beating until just combined. Stir in apples. Transfer batter to the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 35 to 40 minutes. Cool."
    },
    {
      "position": 5,
      "text": "Beat confectioners' sugar, \u00bc cup shortening, \u00bc teaspoon cinnamon, and 1 pinch nutmeg together in a medium bowl with an electric mixer until frosting is light and creamy; beat in evaporated milk, 1 tablespoon at a time, until reaches desired spreading consistency. Spread over cooled cake."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "66641255-b16b-542f-9c21-5a9912f608a3",
  "slug": "mushroom-pork-chops",
  "name": "Mushroom Pork Chops",
  "recipe_type": "soup",
  "brief_description": "These pork chops with cream of mushroom soup, chopped onions, garlic, and fresh mushrooms are deliciously savory, comforting, and easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season pork chops with salt, pepper, and garlic salt."
    },
    {
      "position": 3,
      "text": "Brown chops on both sides over medium-high heat in a large nonstick skillet; transfer browned chops to a plate."
    },
    {
      "position": 4,
      "text": "Add mushrooms and onion to the same skillet and saut\u00e9 for one minute."
    },
    {
      "position": 5,
      "text": "Arrange browned chops on top of mushroom mixture. Pour soup over chops. Cover, reduce the heat to medium-low, and simmer until chops are cooked through and no longer pink in the center, 20 to 30 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

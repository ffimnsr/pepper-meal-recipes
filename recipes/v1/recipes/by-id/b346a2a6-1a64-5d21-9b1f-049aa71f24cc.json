{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b346a2a6-1a64-5d21-9b1f-049aa71f24cc",
  "slug": "falafels-with-yogurt-dill-sauce",
  "name": "Falafels with Yogurt-Dill Sauce",
  "recipe_type": "appetizer",
  "brief_description": "These falafels topped with yogurt-dill sauce are loaded with herbs and spices for a hearty dish. Wrap in a tortilla for lunch or dinner.",
  "cuisine": "Middle Eastern Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chickpeas, 3/4 cup panko bread crumbs, red potato, red onion, garlic, egg, 1 tablespoon olive oil, cilantro, 1 teaspoon lemon juice, cumin, salt, and black pepper in a large bowl."
    },
    {
      "position": 2,
      "text": "Form mixture into 2-inch patties. Place 1/4 cup panko crumbs in a shallow bowl. Gently press patties into the crumbs to coat."
    },
    {
      "position": 3,
      "text": "Heat canola oil in a large skillet over medium-high heat."
    },
    {
      "position": 4,
      "text": "Fry patties in the hot oil until golden brown, about 4 minutes per side. Set patties aside."
    },
    {
      "position": 5,
      "text": "Stir yogurt, dill, lemon juice, garlic salt, and white pepper together in a bowl. Serve sauce drizzled over falafels."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

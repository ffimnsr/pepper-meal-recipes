  "id": "eb927a7d-5a74-54c9-a754-aa8e738ae35e",
  "slug": "vegan-snickerdoodles",
  "name": "Vegan Snickerdoodles",
  "recipe_type": "dessert",
  "brief_description": "This quick and easy cookie recipe uses applesauce and almond milk to deliver vegan sugar cookies rolled in cinnamon-sugar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking soda, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat vegetable oil, applesauce, almond milk, and vanilla extract together in a separate large bowl; add flour mixture and stir until combined."
    },
    {
      "position": 4,
      "text": "Divide dough into 14 portions and roll into balls. Spread cinnamon-sugar into a wide, shallow bowl. Roll dough balls in the cinnamon-sugar and arrange onto a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until golden brown, about 10 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "ab5ce3a0-2079-5239-a136-f8bc9fe62723",
  "slug": "chocolate-cake-batter-hummus",
  "name": "Chocolate Cake Batter Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Dessert hummus is a thing, and this chocolate cake batter version is absolutely decadent. Serve with pretzels, strawberries, or graham crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine chickpeas, cocoa powder, maple syrup, water, tahini, vanilla extract, and salt in the bowl of a mini food processor. Blend until smooth, scraping down the sides of the bowl. Add additional water, 1 tablespoon at a time, until hummus is smooth."
    },
    {
      "position": 3,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 8,

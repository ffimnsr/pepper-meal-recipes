  "id": "201b6847-a74d-5738-abd8-09cfbb4fd89a",
  "slug": "easy-oven-finished-fried-chicken",
  "name": "Easy Oven-Finished Fried Chicken",
  "recipe_type": "appetizer",
  "brief_description": "Beautifully juicy, tender, and crispy fried chicken fillets are perfect for sandwiches, or for serving alongside your favorite sides.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Slice each chicken breast horizontally into 2 thin fillets. Place chicken in a resealable zip-top bag with buttermilk, Buffalo sauce, and garlic powder. Seal the bag and shake to blend ingredients and evenly coat the chicken. Refrigerate for at least 2 hours or overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine flour, poultry seasoning, and pepper in a shallow dish or pie plate. Blend with a fork or whisk."
    },
    {
      "position": 4,
      "text": "Remove chicken from the marinade and shake off excess. Dip chicken in the breading mixture until well and evenly coated on both sides. Discard the remaining marinade."
    },
    {
      "position": 5,
      "text": "Add enough oil to a large skillet so that it thickly coats the bottom; heat over medium-high heat until sizzling but not smoking. Place 2 chicken fillets in the skillet so they fit comfortably; do not overcrowd. Fry until crispy and golden brown, 2 to 3 minutes per side. Drain chicken on paper towels and repeat, adding more oil as necessary, to fry remaining chicken. Transfer chicken to a baking sheet."
    },
    {
      "position": 6,
      "text": "Finish chicken breasts in the preheated oven until chicken is no longer pink in the center and the juices run clear, 8 to 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "d13b73e0-4a14-522a-98c2-b4e560088341",
  "slug": "pineapple-upside-down-cake-gluten-free",
  "name": "Pineapple Upside-Down Cake (Gluten Free)",
  "recipe_type": "dessert",
  "brief_description": "A gluten-free version of a classic pineapple upside-down cake with caramelized brown sugar, fresh pineapple, and rum garnished with maraschino cherries.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in a 12-inch cast iron skillet over medium-low heat. Stir in brown sugar, pineapple juice, and rum. Cook until sugar is dissolved and mixture is bubbling, about 5 minutes. Remove from heat and place pineapple slices in the skillet in a single layer, covering sugar mixture completely. Set skillet aside."
    },
    {
      "position": 3,
      "text": "Melt 1/2 cup butter in small skillet over low heat until butter begins to brown and releases a nutty fragrance, about 5 minutes, being careful to not burn the butter. Remove from heat and let cool for 10 minutes."
    },
    {
      "position": 4,
      "text": "Combine gluten-free flour and almond flour in a bowl. Mix in white sugar, baking powder, salt, and cardamom until well combined. Whisk in eggs and cold milk; mix until just combined. Pour in melted butter from the small skillet and stir until batter is mixed thoroughly. Pour batter over pineapple slices in the 12-inch skillet. Use a spatula to smooth out surface and spread evenly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cake begins to bubble around the edges, the top is browned, and a toothpick inserted into the center comes out clean, 30 to 35 minutes. Let cool in the skillet for 10 minutes."
    },
    {
      "position": 6,
      "text": "Run a knife around the edge of the cake to loosen it from the skillet. Place a large plate on top of the skillet and flip over, presenting the cake with pineapple slices on top. Garnish with maraschino cherries."
    }
  ],
  "servings": 12,

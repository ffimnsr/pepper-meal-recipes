  "id": "66a814f5-287a-55e8-becb-c678f7194325",
  "slug": "mushroom-and-rice-pilaf",
  "name": "Mushroom and Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "This 5-ingredient mushroom and rice pilaf recipe is quick and easy and a perfect side dish to serve with pork chops.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add onion and saute until the onion has softened and turned golden brown, 5 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Add consomme and mushrooms; bring to a boil."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in rice. Cover and let sit until rice has absorbed all liquid, about 5 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

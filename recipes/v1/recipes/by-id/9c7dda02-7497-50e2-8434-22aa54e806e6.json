  "slug": "blackberry-sangria",
  "name": "Blackberry Sangria",
  "recipe_type": "drink",
  "brief_description": "Red wine and brandy are mixed with blackberries, strawberries, pineapple, and apple in this blackberry sangria recipe perfect for summer.",
  "cuisine": "Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine wine, brandy, triple sec, orange juice, and sugar together in a pitcher or bowl; add blackberries, strawberries, pineapple, apple, and ice and mix well. Refrigerate for 8 hours to overnight."
    }
  ],

  "id": "c67a081b-d54f-5a33-b997-80b9b67fb694",
  "slug": "super-easy-stir-fried-cabbage",
  "name": "Super Easy Cabbage Stir Fry",
  "recipe_type": "side",
  "brief_description": "This easy cabbage stir fry with garlic, soy sauce, and Chinese rice wine is cooked in a wok until perfectly tender yet crunchy for a superb side dish.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a wok or large skillet over medium heat. Stir in garlic and cook until it begins to brown, 3 to 5 seconds."
    },
    {
      "position": 2,
      "text": "Stir in cabbage until coated in oil; cover the wok and cook for 1 minute."
    },
    {
      "position": 3,
      "text": "Pour in soy sauce; cook and stir for another minute. Increase heat to high and stir in Chinese cooking wine. Cook and stir until cabbage is tender, about 2 minutes more."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

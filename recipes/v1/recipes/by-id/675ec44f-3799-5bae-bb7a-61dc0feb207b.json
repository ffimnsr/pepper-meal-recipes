  "name": "Buttermilk Ranch",
  "recipe_type": "salad",
  "brief_description": "This buttermilk ranch dressing will easily become your go-to dressing and dipper, and it's easy to make at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together buttermilk, sour cream, mayonnaise, chives, dill, garlic, mustard, salt, and pepper in a medium bowl. Chill, covered, up to 5 days."
    }

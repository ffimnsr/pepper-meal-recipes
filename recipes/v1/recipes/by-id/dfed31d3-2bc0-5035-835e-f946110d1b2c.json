  "id": "dfed31d3-2bc0-5035-835e-f946110d1b2c",
  "slug": "meringue-crust",
  "name": "Meringue Crust",
  "recipe_type": "dessert",
  "brief_description": "This recipe makes a sensational stiff and glossy meringue shell that\u2019s baked on a pie plate. Top with whipped cream and berries \u2014 delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, beat egg whites, cream of tartar, and salt until soft peaks form. Add vanilla; slowly beat in sugar until very stiff and glossy. Spread meringue mixture into a 9-inch pie plate to form a shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 minutes. Turn the oven off; leave meringue in oven for 1 hour. Let cool."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

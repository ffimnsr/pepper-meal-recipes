{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ef455ac7-f9e8-526e-936f-1110077b61aa",
  "slug": "crunchy-chicken-tacos-with-bacon-jam-and-avocado-recipe-12035296",
  "name": "Crunchy Chicken Tacos with Bacon Jam and Avocado",
  "recipe_type": "dessert",
  "brief_description": "These crunchy chicken tacos layer seasoned chicken and melty cheese with creamy avocado sauce, homemade sweet and smoky bacon jam, and crispy fried shallots. Pan-fried until golden and crisp, they just might be the best thing you have ever had.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken breasts with garlic powder, ranch seasoning, and salt. Heat a cast iron skillet over medium heat; cook chicken until no longer pink at the center and juices run clear, 3 to 5 minutes per side. Remove from skillet and dice chicken into small pieces on a cutting board; set aside."
    },
    {
      "position": 2,
      "text": "For bacon jam, fry bacon pieces and onion together in the same skillet over medium heat, stirring occasionally, until bacon is cooked to your liking. Stir in apricot jam and cook on low heat for about 2 minutes. Refrigerate to cool before serving."
    },
    {
      "position": 3,
      "text": "For avocado sauce, add olive oil, avocados, cilantro, mayonnaise, salt, pepper, and water to a blender and blend until smooth. Set aside."
    },
    {
      "position": 4,
      "text": "Heat oil for deep frying to medium-high heat; deep fry shallots until crisp and golden, about one minute. Remove to a paper towel-lined plate; set aside."
    },
    {
      "position": 5,
      "text": "To assemble, lay one tortilla on a work surface. Add a tablespoon of cheese; top with chicken and another tablespoon of cheese. Fold taco and press together."
    },
    {
      "position": 6,
      "text": "Heat a skillet over medium-high heat with a few tablespoons oil; fry taco in the hot oil until crisp, 3 to 5 minutes, turning once. Remove from the skillet to cool for a few minutes."
    },
    {
      "position": 7,
      "text": "Open the taco; add avocado sauce, bacon jam, and fried shallots and fold back together. Repeat with remaining tortillas, cheese, chicken, avocado sauce, bacon jam, and fried shallots."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

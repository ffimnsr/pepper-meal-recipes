  "schema_version": 1,
  "id": "b314cb7c-3341-559c-8c47-6dc53ee7dcd3",
  "slug": "gluten-free-fruitcake",
  "name": "Gluten-Free Fruitcake",
  "recipe_type": "dessert",
  "brief_description": "Almond flour, brown rice flour, and potato and tapioca starches make for a dense but far-from-gummy gluten-free fruit cake filled with nuts and colorfully festive mixed fruit.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Put raisins, golden raisins, cranberries, and cherries in a bowl. Pour rum and orange juice over dried fruit. Set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Butter a 9x5-inch loaf pan."
    },
    {
      "position": 3,
      "text": "Whisk brown rice flour, almond meal, potato and tapioca starches, cinnamon, nutmeg, cloves, cardamom, and ginger together in a bowl. Set aside 3 tablespoons of this mixture. Add baking powder to remaining larger portion; mix well."
    },
    {
      "position": 4,
      "text": "Combine orange zest, dates, figs, and 1/4 cup candied mixed fruit in a bowl. Sprinkle in 2 tablespoons reserved flour mixture and toss to coat."
    },
    {
      "position": 5,
      "text": "Beat butter and sugar together with an electric mixer until creamy. Mix in vanilla. Add eggs, one at a time, beating well after each addition. Mix in applesauce."
    },
    {
      "position": 6,
      "text": "Drain dried fruit, reserving soaking liquid. Add drained fruit to date mixture and toss with remaining 1 tablespoon reserved flour mixture."
    },
    {
      "position": 7,
      "text": "Mix soaking liquid into butter mixture. Gradually add flour mixture, stirring just until combined; do not overmix. Fold in hazelnuts, walnut halves, and pecan halves."
    },
    {
      "position": 8,
      "text": "Pour batter into the prepared loaf pan. Decorate top with almonds and candied fruit slices."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven for 1 hour. Reduce oven temperature to 290 degrees F (145 degrees C). Continue baking until browned on top and a toothpick inserted into the center comes out clean, about 30 minutes more."
    },
    {
      "position": 10,
      "text": "Remove from the oven and let cool for at least 15 minutes before removing from the pan. Brush cherry brandy on top. Let cake rest 24 hours for best results."
    }
  ],
  "servings": 12,

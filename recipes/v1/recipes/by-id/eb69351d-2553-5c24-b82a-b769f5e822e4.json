  "schema_version": 1,
  "id": "eb69351d-2553-5c24-b82a-b769f5e822e4",
  "slug": "chef-johns-paper-pork-shoulder",
  "name": "Chef John's Paper Pork Shoulder",
  "recipe_type": "main",
  "brief_description": "Wrapped in parchment and aluminum foil, this pork shoulder roast cooks in a slow oven for hours, and the resulting tender and juicy meat makes great pulled pork sandwiches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 225 degrees F (110 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix salt, black pepper, paprika, brown sugar, onion powder, garlic powder, and cayenne pepper together in a bowl."
    },
    {
      "position": 3,
      "text": "Sprinkle rub mixture evenly and thoroughly on each surface of the pork roast, pressing it onto the surface."
    },
    {
      "position": 4,
      "text": "Cut a 4-foot piece of unbleached parchment. Place roast at one end and roll roast tightly in the parchment. Cut a second piece of parchment and roll the roast, positioning it in the opposite direction before rolling."
    },
    {
      "position": 5,
      "text": "Cut a long piece of heavy duty aluminum foil and tightly wrap the parchment-wrapped roast. Wrap the roast in a second piece of foil, and then a third, rotating the position of the roast each time. Place wrapped roast in a roasting pan with folded edges facing up to minimize leaking."
    },
    {
      "position": 6,
      "text": "Place in preheated oven and roast until tender, about 12 1/2 hours (or 1.75 hours per pound of pork)."
    },
    {
      "position": 7,
      "text": "Remove pan from oven and allow the wrapped roast to rest at least 1 hour before unwrapping. Brush roast with accumulated juices in the parchment paper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 750,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

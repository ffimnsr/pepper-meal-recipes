  "id": "6ddc3c0c-b49b-58eb-86ce-67a472d66065",
  "slug": "hawaiian-chicken-salad",
  "name": "Hawaiian Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "A whipped cream cheese and pineapple juice dressing make this Hawaiian salad pretty special. It complements the other ingredients of pineapple chunks, chicken, grapes, and almonds perfectly. Chilling brings out all the flavors.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese in a medium bowl until fluffy. Mix in salad dressing and 2 tablespoons reserved pineapple juice."
    },
    {
      "position": 2,
      "text": "Stir in pineapple tidbits, chicken, almonds, and grapes until evenly coated. Chill in the refrigerator until serving."
    }
  ],
  "servings": 6,

  "id": "06f5aeaf-049c-5ff0-be4a-b73f7bd034c5",
  "slug": "gochujang-glazed-salmon",
  "name": "Gochujang Glazed Salmon",
  "recipe_type": "dessert",
  "brief_description": "A quick and easy recipe for baked salmon with a sweet and spicy gochujang and pineapple juice glaze.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)"
    },
    {
      "position": 2,
      "text": "Whisk together gochujang and pineapple juice in a small bowl . to form a glaze. Brush mixture over salmon and place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake until salmon flakes easily with a fork, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle salmon with sesame seeds and green onion."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

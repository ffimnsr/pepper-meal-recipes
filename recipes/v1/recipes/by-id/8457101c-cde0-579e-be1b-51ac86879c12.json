  "slug": "spinach-and-strawberry-salad",
  "name": "Spinach and Strawberry Salad",
  "recipe_type": "salad",
  "brief_description": "This easy spinach strawberry salad is packed with greens, fresh strawberries, and a deliciously sweet sesame and poppy seed vinaigrette dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss spinach and strawberries together in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk oil, sugar, vinegar, sesame seeds, poppy seeds, and paprika together in a medium bowl; pour over spinach and strawberries, and toss to coat."
    }
  ],

  "id": "8891ee87-97bf-5ef2-a378-3126b80ecb8a",
  "slug": "grilled-yams",
  "name": "Grilled Yams",
  "recipe_type": "dessert",
  "brief_description": "My husband never liked yams until I served yams cooked on the grill. The yams create their own glaze on the grill. You can add more herbs and spices to suit your tastes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the grill to high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Coat yam slices with cooking spray and season with salt."
    },
    {
      "position": 3,
      "text": "Arrange yam slices on the grate crosswise, so they don't fall through. Cook until tender and glazed, 10 to 12 minutes per side. Serve with butter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

  "id": "f91c2673-22b8-534b-ba4f-3598391414a3",
  "slug": "golden-potato-soup",
  "name": "Golden Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy potato soup recipe, made with simple ingredients, like chicken broth, celery, onion, and chopped ham, is full of cheesy goodness kids love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes, water, celery, onion, chicken bouillon, parsley, salt, and black pepper into a large stockpot over medium heat; simmer until potatoes and celery become tender."
    },
    {
      "position": 2,
      "text": "Whisk milk and flour together in a small bowl until well blended; stir into soup and cook until thickened."
    },
    {
      "position": 3,
      "text": "Stir in cheese and ham until incorporated; simmer until cheese is melted."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 40,

  "id": "3f73c36f-d267-5d04-82e3-9a4ec54e059a",
  "slug": "ham-egg-salad",
  "name": "Ham & Egg Salad",
  "recipe_type": "salad",
  "brief_description": "This protein-packed breakfast requires no cooking, takes only minutes to make, and is an egg-cellent make-ahead morning meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Halve the hard-boiled eggs and remove the yolks to a bowl. Coarsely chop the egg whites and set aside."
    },
    {
      "position": 2,
      "text": "To the bowl with the egg yolks, add the mayonnaise, mustard, hot sauce, salt, and pepper. Using a fork, smash the mixture until smooth. Add the reserved chopped egg whites, ham, shallot, and celery. Toss to combine. If you like a creamier texture, add more mayonnaise."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

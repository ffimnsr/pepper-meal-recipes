  "id": "b7496290-0995-50cb-bd58-1bfb0f07115d",
  "slug": "biscones",
  "name": "Biscones",
  "recipe_type": "breakfast",
  "brief_description": "Biscuits meet scones in this quick-and-easy recipe for \"biscones\" that can be served at breakfast, lunch, or dinner!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Combine flour, baking powder, sugar, and salt together in a bowl. Cut butter into flour mixture using a fork, your hands, or a pastry blender until mixture resembles coarse crumbs. Mix buttermilk into flour mixture until dough starts to stick together."
    },
    {
      "position": 3,
      "text": "Turn dough onto a floured work surface and shape into a 1/2-inch thick circle. Cut dough into 4 wedges and then into 8 wedges using a sharp knife. Arrange wedges on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until biscones are lightly browned, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

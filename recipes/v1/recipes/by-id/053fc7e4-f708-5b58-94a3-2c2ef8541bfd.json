  "id": "053fc7e4-f708-5b58-94a3-2c2ef8541bfd",
  "slug": "slow-cooker-greek-lemon-chicken-and-potatoes-recipe-11884791",
  "name": "Slow Cooker Greek Lemon Chicken and Potatoes",
  "recipe_type": "main",
  "brief_description": "This slow cooker Greek lemon chicken and potatoes recipe comes together quickly\u2014the slow cooker does most of the work. Both chicken and potatoes come out tender and flavorful and have a robust lemon flavor.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken, potatoes, onion, and garlic in a 6-quart slow cooker."
    },
    {
      "position": 2,
      "text": "Whisk together lemon juice, olive oil, Dijon mustard, oregano, rosemary, salt, pepper, and crushed red pepper in a small bowl. Drizzle over chicken and vegetables and toss to coat."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 6 to 7 hours or on High for 2 \u00bd to 3 \u00bd hours, or until an instant-read thermometer inserted into the thickest part of a chicken thigh reads at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Optional step (to brown chicken and potatoes): Preheat the broiler. Line a rimmed baking sheet with aluminum foil. Transfer chicken thighs to the prepared baking sheet and place 4 to 5 inches from the heat. Broil until browned, 2 to 3 minutes. Transfer to a serving dish."
    },
    {
      "position": 5,
      "text": "Transfer vegetables with a slotted spoon to the baking sheet. Broil until browned, 2 to 3 minutes. Add to the serving dish with the chicken."
    },
    {
      "position": 6,
      "text": "Drizzle with cooking liquid. Garnish with lemon zest."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 365,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "a994f9ea-5345-50bf-bb9d-fac2a6cf5f07",
  "slug": "healthier-creamy-rice-pudding",
  "name": "Healthier Creamy Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "A more healthy version of rice pudding using brown rice instead of white and low-fat milk instead of whole. A favorite creamy dessert everyone loves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine water and rice over high heat in a saucepan and bring to a boil. Reduce heat to medium-low, cover, and simmer until tender, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Combine cooked rice, 1 1/2 cups milk, sugar, and salt in a clean saucepan."
    },
    {
      "position": 4,
      "text": "Cook over medium heat until thick and creamy, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Stir in remaining 1/2 cup milk, beaten egg, and raisins. Cook 2 minutes more, stirring constantly."
    },
    {
      "position": 6,
      "text": "Remove from heat and stir in butter and vanilla. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

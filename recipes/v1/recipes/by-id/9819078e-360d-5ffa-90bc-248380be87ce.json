  "id": "9819078e-360d-5ffa-90bc-248380be87ce",
  "slug": "creamy-butternut-squash-pasta",
  "name": "Creamy Butternut Squash Pasta",
  "recipe_type": "main",
  "brief_description": "This butternut squash pasta with tender squash, sage, thyme, and Parmesan cheese in a creamy homemade sauce makes a cozy vegetarian meal in the fall.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook, stirring occasionally, until tender yet firm to the bite, 10 to 11 minutes. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Add squash and saut\u00e9 until fork-tender, 10 to 15 minutes. Add garlic, sage, and thyme; cook until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Fold in cream and spinach; bring to a simmer. Add 1/4 cup Parmesan cheese and season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Add ziti and toss until evenly coated. Cook until sauce has thickened, 1 to 3 minutes. Remove from heat."
    },
    {
      "position": 5,
      "text": "Divide between 8 bowls. Top with walnuts and more Parmesan."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f46a3bb2-0ffb-55f4-86c0-979e175ac006",
  "slug": "slow-cooker-adobo-chicken-with-bok-choy",
  "name": "Slow Cooker Adobo Chicken with Bok Choy",
  "recipe_type": "main",
  "brief_description": "This is a slow cooker version of a classic dish from the Philippines using chicken thighs, bok choy, apple cider vinegar, onion, and garlic.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Combine onions, garlic, apple cider vinegar, soy sauce, brown sugar, and bay leaf in slow cooker. Season with black pepper. Place chicken thighs atop mixture. Sprinkle paprika over chicken thighs."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low for 8 hours."
    },
    {
      "position": 3,
      "text": "Switch slow cooker to High. Add bok choy to chicken mixture; cook another 5 minutes. Garnish with green onion."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 485,
  "preparation_time_minutes": 10,

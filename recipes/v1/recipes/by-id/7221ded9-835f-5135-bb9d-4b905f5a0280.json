{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7221ded9-835f-5135-bb9d-4b905f5a0280",
  "slug": "stuffed-acorn-squash-with-sausage-recipe-7489389",
  "name": "Sausage and Apple Stuffed Acorn Squash",
  "recipe_type": "main",
  "brief_description": "This hearty winter recipe for acorn squash halves stuffed with a sausage and cabbage filling hits home on a cold day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut both acorn squash in half. Using a spoon, remove the seeds and fibers, and discard. Leave as much of the squash as possible within the skins. Place squash halves, cut side down, in a baking pan with 1/2-inch water in the bottom."
    },
    {
      "position": 3,
      "text": "Bake squash in the preheated oven for 40 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, prepare the filling. Place almonds in a single layer on a small baking sheet, and toast in the oven until lightly browned, about 5 minutes; remove from the oven and set aside."
    },
    {
      "position": 5,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, about 5 minutes. Drain and discard excess fat."
    },
    {
      "position": 6,
      "text": "Add olive oil to the same skillet, reduce heat to medium, and cook and stir onion, apple, cabbage, and almonds with sausage until vegetables are tender, about 10 minutes. Stir in almonds, sage, and thyme. Season to taste with salt and pepper."
    },
    {
      "position": 7,
      "text": "Turn squash cut-side up on the baking pan, and fill centers with cabbage mixture."
    },
    {
      "position": 8,
      "text": "Return to the oven and bake until the filling is hot, and squash is tender and easily pierced with a fork, about 20 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

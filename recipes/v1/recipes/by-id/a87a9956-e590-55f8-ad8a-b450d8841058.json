  "id": "a87a9956-e590-55f8-ad8a-b450d8841058",
  "slug": "roasted-okra",
  "name": "Roasted Okra",
  "recipe_type": "side",
  "brief_description": "This roasted okra seasoned with olive oil, salt, and pepper is simple to make and turns out with a texture that is firm and toothsome, not gummy.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 3,
      "text": "Arrange okra in a single layer on the prepared baking sheet. Drizzle with olive oil; sprinkle with kosher salt and pepper."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven until okra is lightly browned and tender, 10 to 15 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "slug": "slow-cooker-loaded-potato-chowder-recipe-8752868",
  "name": "Slow Cooker Loaded Potato Chowder",
  "recipe_type": "soup",
  "brief_description": "This slow cooker loaded potato chowder is the easiest soup there is- just dump and go. The cream cheese makes it perfectly creamy, and the best part of this recipe is that it only takes 5 minutes to put together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place frozen hash browns, cream of celery soup, broth, ranch packet, and 1/2 cup bacon bits in the slow cooker. Stir to combine. Cook on Low for 4 hours."
    },
    {
      "position": 2,
      "text": "Remove lid and mash potatoes to desired consistency (or leave them whole for a thinner chowder). Add cream cheese. Cover and cook for 1 hour more. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Ladle into bowls and garnish with cheese, green onions, and remaining bacon bits."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 5,

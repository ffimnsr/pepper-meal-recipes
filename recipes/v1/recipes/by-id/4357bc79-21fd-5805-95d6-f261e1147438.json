  "id": "4357bc79-21fd-5805-95d6-f261e1147438",
  "slug": "slow-cooker-lentil-and-ham-soup",
  "name": "Slow Cooker Lentil and Ham Soup",
  "recipe_type": "soup",
  "brief_description": "This slow cooker lentil soup features ham, celery, carrots, and onion simmered in a tomatoey broth with basil, oregano, and thyme for a soothing meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ham, lentils, celery, carrots, onion, and garlic in a 3 1/2-quart or larger slow cooker. Season with basil, oregano, thyme, pepper, and bay leaf."
    },
    {
      "position": 3,
      "text": "Stir in chicken broth, water, and tomato sauce."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 11 hours. Discard bay leaf before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 660,

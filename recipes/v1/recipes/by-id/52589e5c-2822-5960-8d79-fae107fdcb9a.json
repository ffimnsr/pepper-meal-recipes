  "slug": "4-ingredient-pepper-pizza-bites-recipe-11716499",
  "name": "4-Ingredient Pepper Pizza Bites",
  "recipe_type": "appetizer",
  "brief_description": "These 4-ingredient pepper pizza bites stack pepperoni pizza ingredients on a mini bell pepper base. Baked until golden and bubbly, these crunchy, saucy, cheesy bites will be the first appetizer to go at your party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and line a baking sheet with parchment. Place sliced mini bells on the baking sheet, cut sides up."
    },
    {
      "position": 2,
      "text": "Divide marinara sauce between peppers using a small spoon. Top peppers with cheese. Place 3 slices of mini pepperoni on top of cheese in each pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 12 minutes. Turn the oven\u2019s broiler to High, and broil peppers until cheese is melted and starting to brown, about 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

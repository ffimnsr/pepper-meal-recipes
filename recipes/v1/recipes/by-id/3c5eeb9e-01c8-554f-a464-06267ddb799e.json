  "id": "3c5eeb9e-01c8-554f-a464-06267ddb799e",
  "slug": "grown-up-spaghettios-recipe-11920279",
  "name": "Grown Up SpaghettiOs",
  "recipe_type": "main",
  "brief_description": "These grown up SpaghettiOs are perfect if you love the idea of SpaghettiOs, but want a little something extra. Homemade meatballs, ring-shaped anelletti pasta, and a light, savory tomato sauce make it all so, well, grown up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ground beef, sausage, egg, breadcrumbs, milk, Italian seasoning, salt, and pepper in a large bowl. Roll meat mixture into 1-inch meatballs and place onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake meatballs in the preheated oven until cooked through, 15 to 20 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C)."
    },
    {
      "position": 4,
      "text": "Meanwhile melt butter in a large skillet over medium heat. Add olive oil and onion; continue cooking until softened, about 5 minutes. Add garlic, red pepper flakes, salt, pepper and tomato paste; stir continuously until fragrant, about 1 minute."
    },
    {
      "position": 5,
      "text": "Pour in water and bring to a boil. Stir in pasta, reduce heat, and cover with a lid. Continue cooking until pasta is al dente, stirring occasionally, 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Before serving, stir in meatballs and cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

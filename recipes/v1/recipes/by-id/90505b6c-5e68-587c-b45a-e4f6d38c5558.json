  "id": "90505b6c-5e68-587c-b45a-e4f6d38c5558",
  "slug": "granola-oatmeal-cookies",
  "name": "Granola Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "Chef John's granola oatmeal cookies might be the best cookie you'll ever taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with a silicone baking mat (such as Silpat\u2122) or parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, salt, baking powder, and baking soda in a bowl and whisk for 30 seconds until dry ingredients are well combined."
    },
    {
      "position": 3,
      "text": "Combine butter, light brown sugar, and granulated sugar in a second bowl. Cream with an electric beater until mixture is light and fluffy. Add egg and mix on high speed until well combined. Add vanilla extract and cinnamon and beat in."
    },
    {
      "position": 4,
      "text": "Add egg and mix on high speed until well combined. Add vanilla extract and cinnamon and beat in."
    },
    {
      "position": 5,
      "text": "Fold in dry ingredients with a spatula just until flour disappears."
    },
    {
      "position": 6,
      "text": "Fold in granola and oats until well combined."
    },
    {
      "position": 7,
      "text": "Scoop out tablespoonfuls of dough onto the prepared baking sheet, leaving ample space between the dough balls as they will spread out, about 8 per baking sheet."
    },
    {
      "position": 8,
      "text": "Bake on the center rack in the preheated oven until cookies are golden brown, 13 to 15 minutes. Remove from oven and allow to cool on the baking sheet for 10 minutes. Transfer to a wire rack and cool completely. Repeat with remaining dough."
    },
    {
      "position": 9,
      "text": "Transfer to a wire rack and cool completely. Repeat with remaining dough."
    },
    {
      "position": 10,
      "text": "Serve and enjoy!"
    }
  ],

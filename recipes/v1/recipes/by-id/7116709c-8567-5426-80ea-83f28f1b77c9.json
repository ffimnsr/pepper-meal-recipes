  "schema_version": 1,
  "id": "7116709c-8567-5426-80ea-83f28f1b77c9",
  "slug": "mini-christmas-cakes",
  "name": "Mini Christmas Cakes",
  "recipe_type": "dessert",
  "brief_description": "Homemade mini Christmas cakes, made with brandy-soaked fruit, are topped with marzipan and fondant for a fun holiday treat that's perfect for gifting!",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "To make the cakes: Combine currants, raisins, sultana raisins, and candied cherries in a plastic container with a lid. Pour brandy over dried fruit; stir in orange and lemon zest. Close the container and let fruit soak, stirring or shaking every few hours, overnight or up to 3 days."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line a baking sheet with 24 silicone cupcake liners or ramekins."
    },
    {
      "position": 3,
      "text": "Combine 1 cup plus 2 tablespoons butter and 1 cup plus 2 tablespoons brown sugar in a bowl; beat with an electric mixer until well combined. Mix in eggs and molasses until well combined. Stir in chopped almonds, both flours, and mixed spice until well combined. Fold in ground almonds and soaked fruit. Spoon mixture into the prepared liners."
    },
    {
      "position": 4,
      "text": "Bake in the center of the preheated oven until a toothpick inserted in the center comes out clean, about 1 \u00bd hours. Remove from the oven and let cool to room temperature, 30 to 45 minutes."
    },
    {
      "position": 5,
      "text": "When ready to decorate, heat jam in the microwave until soft and warm. Brush onto each cake."
    },
    {
      "position": 6,
      "text": "Roll out marzipan between two sheets of plastic wrap. Cut out 24 circles the same diameter as the top of each cake; place one on top of each cake. Return to the airtight containers and let sit for 8 hours before continuing."
    },
    {
      "position": 7,
      "text": "Roll out fondant between two sheets of plastic wrap. Cut out 24 circles the same diameter as the top of each cake. Place a cookie stencil on top of each circle, and paint in the stencil using a small brush and the food coloring. Place fondant circles on top of each cake."
    }
  ],
  "servings": 24,

  "id": "411ea698-cb15-5db4-abac-52891c2bcde5",
  "slug": "greek-tzatziki",
  "name": "Greek Tzatziki",
  "recipe_type": "side",
  "brief_description": "Tzatziki is a creamy cucumber dip made with yogurt, fresh dill, lemon, and garlic that's delicious on pita, in gyros, on lamb, or whatever you like!",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine yogurt, grated cucumber, lemon juice, olive oil, and garlic together in a large bowl."
    },
    {
      "position": 3,
      "text": "Add dill, salt, pepper, and lemon zest; mix until smooth."
    },
    {
      "position": 4,
      "text": "Pour into a serving dish. Garnish with fresh dill."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

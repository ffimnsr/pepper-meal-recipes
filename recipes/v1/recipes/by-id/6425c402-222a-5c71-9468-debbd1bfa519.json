  "id": "6425c402-222a-5c71-9468-debbd1bfa519",
  "slug": "mashed-potato-topped-turkey-pot-pie",
  "name": "Mashed Potato-Topped Turkey Pot Pie",
  "recipe_type": "main",
  "brief_description": "A simple turkey pot pie with a mashed potato topping that uses items like leftover turkey, mashed potatoes, and gravy packets from your holiday meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Press pie crust into the bottom of a 9x13-inch baking dish, then layer turkey meat over crust; spoon cream of chicken soup over turkey."
    },
    {
      "position": 3,
      "text": "Bring 1 cup of water to a boil in a saucepan over medium heat and stir in mixed vegetables; cook until vegetables are tender, about 5 minutes. Whisk dry gravy mix with remaining 1 cup of water, then stir gravy mixture into mixed vegetables. Bring to a boil, then simmer until thickened, about 1 minute. Pour vegetables and gravy over cream of chicken soup layer in the pan. Spread mashed potatoes over the top of pie."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is bubbling, about 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "a98ccade-7f55-5378-a805-b2803e4c81d5",
  "slug": "low-carb-pecan-pie-with-almond-flour-crust",
  "name": "Low-Carb Pecan Pie with Almond Flour Crust",
  "recipe_type": "dessert",
  "brief_description": "A delicious alternative with an almond flour crust for those following a low carb plan, or just trying to cut back on sugar. Great for Thanksgiving and Christmas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix almond flour and 4 tablespoons melted butter together in a small bowl. Press into an ungreased 9-inch pie pan. Chill in the refrigerator while preparing the filling."
    },
    {
      "position": 3,
      "text": "Combine sweetener, syrup, eggs, 2 tablespoons melted butter, and vanilla in a medium bowl. Stir in pecans. Pour mixture into pie crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is set, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

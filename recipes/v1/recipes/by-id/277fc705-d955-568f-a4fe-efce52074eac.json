  "slug": "summertime-tuna-pasta-salad",
  "name": "Summertime Tuna Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This summertime tuna pasta salad recipe tosses crisp, fresh broccoli, carrots, celery, and cucumber with pasta, creamy salad dressing, and dried dill.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine salad dressing, dill, and black pepper in a large bowl until well mixed. Stir in macaroni, broccoli, carrots, celery, cucumber, and tuna until well blended. Cover the bowl; refrigerate until ready to serve."
    }
  ],

  "id": "2291eb80-5e8a-5564-adb9-48f6b12022e3",
  "slug": "chocolate-candy-corn-pretzel-bites",
  "name": "Chocolate-Candy Corn Pretzel Bites",
  "recipe_type": "appetizer",
  "brief_description": "This 3-ingredient recipe will surely become a favorite fall treat. The salty-sweet bites are super tasty and look adorable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Arrange the pretzels in a single layer on the tray. Place a single Hersey's Hug on the center of each pretzel."
    },
    {
      "position": 3,
      "text": "Bake until hugs start to melt slightly, 4 to 5 minutes. You want the chocolate candies to be soft but not entirely melted."
    },
    {
      "position": 4,
      "text": "Remove from the oven and quickly place a candy corn on top of each hug, pressing down to secure in the chocolate. Move to the fridge to cool for about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "0e182243-3efd-5873-916e-6dc0e36bdb53",
  "slug": "vegan-split-pea-soup-i",
  "name": "Vegan Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This vegan split pea soup recipe is made with barley, carrot, celery, and potato cooked with garlic, basil, and thyme for a healthy vegetarian soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium-high heat. Saut\u00e9 onion, garlic, and bay leaf in hot oil until onions are translucent, about 5 minutes. Add water, peas, barley, and salt; bring to a boil. Reduce heat to low and simmer for 2 hours, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Add potatoes, carrots, celery, parsley, basil, thyme, and pepper. Simmer until peas and vegetables are tender, about 1 hour."
    }
  ],
  "servings": 10,

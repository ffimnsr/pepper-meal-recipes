  "id": "a3e26237-f748-5ddb-bff8-82711fcb1bf8",
  "slug": "nordy-bars-recipe-11865645",
  "name": "Nordy Bars",
  "recipe_type": "dessert",
  "brief_description": "Nordstrom's famous Nordy bars are soft and gooey dessert bars with butterscotch chips, chocolate chips, marshmallows, and crispy bits of pecans. For as scrumptious as they are, they are surprisingly easy to make at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper and lightly coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Melt butter, butterscotch chips, and brown sugar in a saucepan over low heat until just melted, stirring often (mixture may slightly separate). Remove from heat; transfer mixture to a large bowl and let cool for about 20 minutes."
    },
    {
      "position": 3,
      "text": "Beat eggs and vanilla into the butterscotch mixture with an electric mixer until combined. Stir in flour, baking powder, baking soda, and salt until incorporated."
    },
    {
      "position": 4,
      "text": "Fold in chocolate chips, marshmallows, and pecans."
    },
    {
      "position": 5,
      "text": "Spread mixture evenly into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, 20 to 25 minutes."
    },
    {
      "position": 7,
      "text": "Cool completely in the pan at room temperature, about 2 hours. Cut into 20 bars to serve. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "e6ea74f5-b67f-5e7f-aeef-2142fd66f184",
  "slug": "almond-you-must-be-nuts-crackers",
  "name": "Almond \"You Must Be Nuts!\" Crackers",
  "recipe_type": "appetizer",
  "brief_description": "Homemade almond crackers made with almond meal, flax meal, and walnuts are a paleo-friendly snack to serve alongside guacamole or other dips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix almond flour, walnuts, flax seed meal, and salt together in a bowl until well combined. Add water and olive oil; mix until dough is moist and holds together."
    },
    {
      "position": 3,
      "text": "Turn dough onto the prepared baking sheet. Place a second piece of parchment over the dough and use a rolling pin to roll it into a 1/16-inch-thick rectangle. Remove the top piece of parchment and cut the sides of dough to make an even rectangle. Add excess dough to corners or one end of the rectangle and re-roll to a uniform thickness."
    },
    {
      "position": 4,
      "text": "Cut dough into 1-inch squares using a pizza cutter, keeping dough still attached."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the outside edges of dough are browned, about 15 minutes. Cool crackers on the baking sheet, then break into squares."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

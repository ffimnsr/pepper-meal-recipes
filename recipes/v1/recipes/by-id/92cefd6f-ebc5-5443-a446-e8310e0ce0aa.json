  "schema_version": 1,
  "id": "92cefd6f-ebc5-5443-a446-e8310e0ce0aa",
  "slug": "shrimp-with-lobster-sauce",
  "name": "Shrimp with Lobster Sauce",
  "recipe_type": "dessert",
  "brief_description": "Make shrimp with lobster sauce at home with stir-fried shrimp and pork in a sweet and salty sauce made with soy, sugar, and egg. That's right, no lobster!",
  "cuisine": "New England Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve 1 1/2 teaspoons cornstarch in sherry in a medium bowl. Add shrimp and toss to coat."
    },
    {
      "position": 2,
      "text": "Heat oil in a wok over medium-high heat. Add shrimp and stir-fry until pink, 3 to 5 minutes. Use a slotted spoon to transfer shrimp to a plate; leave as much oil in the wok as possible."
    },
    {
      "position": 3,
      "text": "Add garlic to the wok and stir-fry for a few seconds, then add ground pork. Stir-fry until pork is no longer pink, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Mix 1 cup water, soy sauce, sugar, and salt together in a small bowl; pour into the wok and stir to combine. Bring to a boil, then cover, reduce the heat to medium, and simmer for about 2 minutes."
    },
    {
      "position": 5,
      "text": "Whisk 1/4 cup cold water and 1 1/2 tablespoons cornstarch together in a small bowl; pour into the wok. Add shrimp and bring to a simmer. Drizzle beaten egg into the wok, stirring quickly as it cooks. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

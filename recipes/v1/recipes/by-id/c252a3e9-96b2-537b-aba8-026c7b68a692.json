  "id": "c252a3e9-96b2-537b-aba8-026c7b68a692",
  "slug": "sheet-pan-neiman-marcus-tacos-recipe-11965143",
  "name": "Sheet Pan Neiman Marcus Tacos",
  "recipe_type": "side",
  "brief_description": "These sheet pan Neiman Marcus tacos are creamy, smoky, and irresistibly crisp. The filling is rich with tender chicken, tangy sour cream, and salty bacon, all melted together with sharp Cheddar. The tortillas bake up golden and crunchy on the outside while staying soft around the filling. Each bite is savory and indulgent, with a fresh pop from scallions.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Position oven racks in top third and lower third of oven; preheat oven to 450 degrees F (235 degrees C). Generously spray 2 parchment-lined baking sheets with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together chicken, sour cream, bacon, scallions, salt, black pepper, and 1/2 cup Cheddar cheese in a bowl until well combined."
    },
    {
      "position": 3,
      "text": "Wrap tortillas in damp paper towels; microwave on High until warm and pliable, 30 to 45 seconds."
    },
    {
      "position": 4,
      "text": "Carefully place 6 tortillas on each prepared baking sheet. Spread chicken mixture evenly over 1 half of each tortilla (about 1/4 cup each); top each evenly with remaining Cheddar cheese (about 2 tablespoons each). Fold tortillas in half, and gently press to adhere. Spray each folded tortilla generously with more cooking spray."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, rotating baking sheets between top and bottom racks halfway through, until tortillas are golden and crisp, about 16 minutes."
    },
    {
      "position": 6,
      "text": "Remove from oven; let stand 5 minutes. Serve warm, topped with more sour cream, crumbled bacon, and thinly sliced dark greens of scallions. Recipe developed by Marianne Williams"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

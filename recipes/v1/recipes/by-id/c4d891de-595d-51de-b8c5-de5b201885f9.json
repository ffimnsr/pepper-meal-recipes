  "id": "c4d891de-595d-51de-b8c5-de5b201885f9",
  "slug": "nanas-southern-pickled-peaches",
  "name": "Nana's Southern Pickled Peaches",
  "recipe_type": "salad",
  "brief_description": "These sweet, cinnamon-flavored pickled peaches are a family favorite. They're great as a condiment on salads or a side at Sunday supper.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect five quart-sized jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until peaches are ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 2,
      "text": "At the same time, bring sugar, vinegar, and water to a boil in a large pot. Boil until syrupy, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Press one to two cloves into each peach. Place peaches into boiling syrup and boil until tender, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Spoon peaches into hot, sterilized jars, and top with liquid, filling to within 1/2 inch of the rim. Insert one cinnamon stick into each jar. Wipe the rims with a clean dry cloth, then seal with lids and rings."
    },
    {
      "position": 5,
      "text": "Place a rack into the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes to seal, or consult times recommended by your local extension."
    },
    {
      "position": 6,
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

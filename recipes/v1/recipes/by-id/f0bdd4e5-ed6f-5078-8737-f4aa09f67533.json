  "id": "f0bdd4e5-ed6f-5078-8737-f4aa09f67533",
  "slug": "the-best-mashed-potatoes",
  "name": "The Best Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "This best mashed potato recipe uses fresh garlic mashed into Yukon Gold potatoes with cream cheese, Parmesan, butter, and chives for a bold side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Peel and quarter potatoes; place in a large pot. Cover with salted water and bring to a boil. Cook until tender but still firm, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Drain and return potatoes to the pot over low heat to dry for 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Add Parmesan cheese, cream cheese, chives, butter, garlic, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Use a potato masher to mash until smooth and serve."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

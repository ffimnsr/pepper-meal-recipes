  "id": "a3f9a2a0-e58c-5659-a6ed-c933453f91e9",
  "slug": "turkey-goulash",
  "name": "Turkey Goulash",
  "recipe_type": "soup",
  "brief_description": "Lean turkey is simmered with tomatoes and pasta.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet over medium heat, cook the turkey until browned."
    },
    {
      "position": 2,
      "text": "Stir in the stewed tomatoes, garlic, tomato sauce, sugar and basil, and then simmer for about 20 minutes."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente, and then drain. Combine the pasta and turkey mixture; toss and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,

  "slug": "all-fruit-smoothies",
  "name": "All-Fruit Smoothies",
  "recipe_type": "drink",
  "brief_description": "There's nothing in this smoothie except pineapple juice, banana, and frozen strawberries and blueberries. It's smooth, frosty, and dairy-free.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour pineapple juice into a blender and add banana, strawberries, and blueberries. Cover and blend until smooth, about 1 minute. Pour into 2 glasses."
    }
  ],

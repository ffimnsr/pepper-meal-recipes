  "id": "05d8e047-be65-5b3a-b8f7-86ecf15e1a68",
  "slug": "savannahs-best-marinated-portobello-mushrooms",
  "name": "Savannah\u2019s Best Marinated Portobello Mushrooms",
  "recipe_type": "main",
  "brief_description": "Marinate portobello mushroom caps for 15 minutes with a mixture of garlic, balsamic vinegar, and soy so they\u2019ll be just the right texture after cooking.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Mix cooking wine, soy sauce, vinegar, oil, and garlic together in the bottom of a baking dish. Place mushroom caps into the baking dish with the gills facing up. Spoon marinade into the cavities, cover with foil, and marinate for 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 25 minutes. Flip mushrooms and bake until mushrooms are tender and juicy, about 8 more minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

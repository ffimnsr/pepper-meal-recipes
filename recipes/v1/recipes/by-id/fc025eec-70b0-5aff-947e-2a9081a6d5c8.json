  "id": "fc025eec-70b0-5aff-947e-2a9081a6d5c8",
  "slug": "spanish-gazpacho",
  "name": "Spanish Gazpacho",
  "recipe_type": "soup",
  "brief_description": "This classic Spanish gazpacho with tomatoes, cucumber, and bell pepper is blended with olive oil to make a rich and refreshing chilled soup. Perfect for summer!",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomatoes, cucumber, bell pepper, onion, vinegar, garlic, and salt in the bowl of a food processor; pulse until blended. Pour olive oil in slowly, with the processor running, until gazpacho is smooth. Add small amounts of cold water as needed to achieve desired consistency."
    },
    {
      "position": 2,
      "text": "Serve gazpacho chilled with chopped onion, bell pepper, and cucumber sprinkled over each serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

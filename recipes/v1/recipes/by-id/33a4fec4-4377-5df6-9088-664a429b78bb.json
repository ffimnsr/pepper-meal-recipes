  "id": "33a4fec4-4377-5df6-9088-664a429b78bb",
  "slug": "vegetable-and-feta-latkes",
  "name": "Vegetable and Feta Latkes",
  "recipe_type": "dessert",
  "brief_description": "Try this colorful take on traditional potato pancakes. Stir shredded zucchini, potatoes and carrots into a batter of eggs, matzo meal, parsley and feta cheese. Fry until golden brown. You'll love the creamy bite of feta with the tender veggie crunch.",
  "cuisine": "World Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Place the zucchini, potato and carrots in a colander, place paper towels or a cheesecloth over the top and squeeze out as much moisture as possible. Sprinkle salt over the vegetables and let them drain for 15 minutes. Squeeze vegetable again in paper towels."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl combine eggs, vegetables, salt and pepper. Mix well. Stir in matzo meal or flour, parsley and feta."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a large frying pan. Place vegetable mixture, formed into pancake sized cakes in hot oil and fry until golden brown on both sides. (Cook two to three minutes per side). Add more oil as needed to keep cakes frying up well. Drain fried latkes on paper towels."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "b9fb84f2-77e9-5191-8a76-32e7092754bb",
  "slug": "caramel-popcorn-with-marshmallow",
  "name": "Caramel Popcorn with Marshmallow",
  "recipe_type": "dessert",
  "brief_description": "This marshmallow caramel popcorn recipe combines three classic treats into one sweet treat using only six ingredients you likely have in your pantry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir marshmallows, brown sugar, butter, corn syrup, and vanilla extract together in a large pot over medium-low heat until marshmallows melt, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Place popcorn in a large bowl; pour marshmallow mixture over popcorn and gently stir to coat."
    }
  ],

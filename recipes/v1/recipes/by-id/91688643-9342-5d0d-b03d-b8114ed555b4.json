  "id": "91688643-9342-5d0d-b03d-b8114ed555b4",
  "slug": "mamas-blackberry-cobbler",
  "name": "Mama's Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This easy blackberry cobbler is made with fresh blackberries and 4 other ingredients in less than 1 hour. The perfect excuse to go blackberry picking!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour melted butter into the bottom of an 8-inch square baking pan. Mix sugar, self-rising flour, and milk together until moistened; pour mixture over butter. Don't be tempted to stir. Spread blackberries evenly over batter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the top is golden brown and the cobbler is bubbling, about 45 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

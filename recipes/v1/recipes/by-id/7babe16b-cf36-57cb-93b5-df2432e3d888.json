  "id": "7babe16b-cf36-57cb-93b5-df2432e3d888",
  "slug": "cranberry-bars",
  "name": "Cranberry Bars",
  "recipe_type": "dessert",
  "brief_description": "These easy cranberry bars are a nice alternative to brownies for dessert. They\u2019re tart and sweet with warm notes of ginger and cinnamon in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, white sugar, and water in a saucepan over medium heat. Cook, stirring occasionally, until the cranberries have popped and the mixture has thickened, about 15 minutes. Remove from the heat and let cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Stir together cake mix, melted butter, eggs, oats, brown sugar, ginger, and cinnamon in a large bowl until combined. Reserve 1 1/2 cups of the mixture. Press the remaining mixture evenly into the bottom of the prepared baking dish. Spread the cooled cranberry mixture over the crust. Crumble the reserved mixture evenly over the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is lightly browned, 35 to 40 minutes. Cool in the pan for about 40 minutes before slicing into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

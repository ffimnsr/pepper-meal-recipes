  "id": "4736d7c5-8ac7-5d57-b8e3-fc0d5cd6e4c3",
  "slug": "baked-swedish-rice-pudding",
  "name": "Baked Swedish Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Swedish rice pudding is a decadent treat topped with a baked meringue.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish."
    },
    {
      "position": 2,
      "text": "Bring milk to a boil in a large saucepan. Stir rice and salt into milk, reduce heat to medium-low, and cook, stirring frequently, until rice is tender, about 18 minutes."
    },
    {
      "position": 3,
      "text": "Beat egg yolks, 1/2 cup sugar, butter, and vanilla extract together in a bowl until combined. Stir 1 cup of the hot rice mixture into egg mixture until well-mixed."
    },
    {
      "position": 4,
      "text": "Pour egg mixture into rice mixture in the saucepan; bring to a boil, stirring constantly, until mixture thickens, about 1 minute. Pour into prepared casserole dish."
    },
    {
      "position": 5,
      "text": "Beat egg whites in a glass or metal bowl until soft peaks form. Gradually add 3 tablespoons sugar, continuing to beat until stiff peaks form. Lift your beater or whisk straight up: the egg whites will form sharp peaks. Spread egg white mixture over rice mixture, ensuring that egg whites are spread to the edges of the casserole dish."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

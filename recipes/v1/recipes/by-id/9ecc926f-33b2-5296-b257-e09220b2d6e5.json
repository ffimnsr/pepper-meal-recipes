  "id": "9ecc926f-33b2-5296-b257-e09220b2d6e5",
  "slug": "beer-cheese-fondue",
  "name": "Beer Cheese Fondue",
  "recipe_type": "appetizer",
  "brief_description": "This beer cheese fondue is made with sharp Cheddar, Swiss cheese, beer, and hot pepper sauce. Perfect for dipping French bread cubes and vegetables.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Combine Cheddar cheese, Swiss cheese, flour, salt, and black pepper in a bowl."
    },
    {
      "position": 2,
      "text": "Rub cut side of garlic clove around bottom and sides of the fondue pot."
    },
    {
      "position": 3,
      "text": "Pour beer into fondue pot and slowly bring to a simmer over medium-low heat, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Gradually stir cheese mixture into beer, adding small amounts at a time, until cheese melts, 10 to 15 minutes. Stir in hot pepper sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

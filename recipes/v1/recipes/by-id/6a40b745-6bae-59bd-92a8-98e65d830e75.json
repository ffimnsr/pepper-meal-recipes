  "schema_version": 1,
  "id": "6a40b745-6bae-59bd-92a8-98e65d830e75",
  "slug": "mrs-paysons-spam-and-grits-brunch-casserole",
  "name": "Mrs. Payson's SPAM\u00ae and Grits Brunch Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Grits, cheese, and luncheon meat combine into a breakfast casserole that can be put together the night before.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring the water to a boil in a large saucepan over high heat. Slowly pour the grits into the water while stirring constantly. Reduce heat to medium-low, and simmer until the grits are tender and thick, 3 to 4 minutes. Stir the grits constantly as they cook. Set aside."
    },
    {
      "position": 3,
      "text": "Heat a skillet over medium-high heat, and sprinkle in the grated luncheon meat. Cook, turning occasionally, until the luncheon meat has browned. Pour off any excess grease, and stir half of the luncheon meat into the grits along with the tomatoes, sour cream, and half of the Cheddar cheese. Pour the grits into the prepared baking dish, and sprinkle with the remaining luncheon meat and Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the casserole is hot and the cheese has melted and is bubbly, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

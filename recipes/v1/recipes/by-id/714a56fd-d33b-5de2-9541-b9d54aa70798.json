  "id": "714a56fd-d33b-5de2-9541-b9d54aa70798",
  "slug": "basic-cream-cheese-frosting",
  "name": "Basic Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "This smooth cream cheese frosting is easy to make with butter, cream cheese, and confectioners' sugar for a sweet and tangy topping for cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, softened butter, and vanilla together in a large bowl with an electric mixer until light and creamy."
    },
    {
      "position": 3,
      "text": "Gradually beat in confectioners' sugar until smooth."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

  "id": "5564fa64-8182-547a-9f23-db5b1a461e2d",
  "slug": "rhubarb-and-strawberry-pie",
  "name": "Strawberry Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This strawberry rhubarb pie has a ruby-red filling with a delicious sweet-tart flavor in a buttery crust to make a sensational springtime dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour and sugar together in a large bowl."
    },
    {
      "position": 3,
      "text": "Add strawberries and chopped rhubarb. Toss with sugar and flour and let stand for 30 minutes."
    },
    {
      "position": 4,
      "text": "Pour filling into prepared pie crust. Dot top with butter, and cover with top crust. Seal edges of top and bottom crust with water."
    },
    {
      "position": 5,
      "text": "Brush egg yolk on top of pie with a pastry brush."
    },
    {
      "position": 6,
      "text": "Sprinkle with sugar."
    },
    {
      "position": 7,
      "text": "Cut several slits in the top crust to allow steam to escape."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until bubbly and brown, about 35 to 40 minutes. Cool pie on rack."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

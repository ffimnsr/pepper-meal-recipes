{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2ab35690-7812-5ec3-8985-3739be508f3f",
  "slug": "grilled-pizza-bianca-recipe-7559340",
  "name": "Grilled Pizza Bianca",
  "recipe_type": "main",
  "brief_description": "With prepared pizza dough you can grill a tasty white pizza\u2013pizza bianca\u2013in under 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a small saucepan over medium-high heat. Add garlic and cook until fragrant, about 30 seconds; stir in cream. Add 2/3 cup Parmesan cheese, and stir until smooth. Let Alfredo sauce cool to room temperature, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat a gas grill with all burners on High for 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Divide pizza dough in half. Shape each portion of the pizza dough into an 8 to 10-inch disc. Reduce the flame on half the grill burners to Low, to create areas of direct and indirect heat."
    },
    {
      "position": 4,
      "text": "Carefully place discs of dough, one at a time, onto the grill over direct heat. Close the cover. Let dough grill until the bottom is just barely cooked and shows char marks, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Turn crust ninety degrees (do not flip dough over). Grill until crust shows light grill marks, 1 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Move pizza dough to indirect heat. Spoon Alfredo sauce over dough. Top each crust with four slices mozzarella cheese. Sprinkle remaining 1/3 cup Parmesan cheese evenly over pizzas."
    },
    {
      "position": 7,
      "text": "Grill until cheese is melted, about 3 minutes. Carefully remove pizza from the grill."
    },
    {
      "position": 8,
      "text": "Preheat the oven\u2019s broiler. Broil pizza until cheese is golden, about 5 minutes. Allow pizza to rest a few minutes before cutting into wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

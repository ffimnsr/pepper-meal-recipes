  "id": "d604741e-4055-563e-b070-bf252cbf3d91",
  "slug": "state-fair-pickle-lemonade-recipe-11781666",
  "name": "State Fair Pickle Lemonade",
  "recipe_type": "snack",
  "brief_description": "In this state fair pickle lemonade, sour dill pickles and tart lemons bring serious pucker to a summer favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine lemon wedges, chopped pickle spear, and sugar together in a deli container. Muddle firmly for 1 minute, or until the lemon rinds are broken down and juice is fully extracted. The mixture should be aromatic and syrupy."
    },
    {
      "position": 3,
      "text": "Add ice, water, and pickle juice to the muddled mixture. Place lid on the container and shake well."
    },
    {
      "position": 4,
      "text": "Insert a straw and enjoy directly from the container, or, strain the mixture through a mesh strainer for a smoother lemonade."
    },
    {
      "position": 5,
      "text": "Garnish with a lemon slice and pickle spear. Enjoy!"
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

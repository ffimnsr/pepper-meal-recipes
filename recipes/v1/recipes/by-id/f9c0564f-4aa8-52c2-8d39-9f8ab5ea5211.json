  "id": "f9c0564f-4aa8-52c2-8d39-9f8ab5ea5211",
  "slug": "nutella-ice-cream-recipe-7508716",
  "name": "Nutella Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This exquisite homemade Nutella ice cream is full of nutty flavor, and everyone will simply love it. Nutella gives this ice cream an unbelievable hazelnut taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, cream, and 1/2 cup sugar in a saucepan over medium heat. Cook until sugar dissolves, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Beat egg yolks with the remaining 1/4 cup sugar in a bowl with an electric mixer until eggs become thick and pale yellow, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Pour 1/2 cup warm milk mixture into egg mixture and stir. Add this mixture back into the saucepan. Cook over very low heat, stirring constantly, until the mixture becomes thick enough to coat the back of a wooden spoon, 7 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Place a strainer over a bowl and pour the warm custard mixture through the strainer. Stir in vanilla and hazelnut spread until it dissolves."
    },
    {
      "position": 5,
      "text": "Chill mixture completely, about 1 hour. Pour into an ice cream maker and churn until frozen according to manufacturer\u2019s instructions, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Transfer to a plastic container and place in the freezer for an hour before serving. Top with crushed hazelnuts for serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

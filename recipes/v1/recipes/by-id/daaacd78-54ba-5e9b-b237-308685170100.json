  "id": "daaacd78-54ba-5e9b-b237-308685170100",
  "slug": "brown-sugar-and-balsamic-glazed-pork-tenderloin",
  "name": "Brown Sugar and Balsamic Glazed Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "The brown sugar, soy, and balsamic vinegar glaze is brushed on the pork tenderloin as it bakes and then served with the finished dish, providing an extra sweet and savory punch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk brown sugar, water, balsamic vinegar, soy sauce, and cornstarch together in a small saucepan over medium heat; cook, stirring constantly, until thickens, 4 to 6 minutes. Set aside off heat."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking sheet."
    },
    {
      "position": 3,
      "text": "Combine garlic, sage, salt, and black pepper in a small bowl; rub on pork tenderloins."
    },
    {
      "position": 4,
      "text": "Heat oil in a large skillet over medium-high heat. Add tenderloins; brown evenly, 2 to 3 minutes per side. Transfer to the prepared baking sheet; brush with balsamic glaze."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Flip tenderloins; brush with glaze. Continue cooking until slightly pink in the center, about 20 minutes more, or until desired doneness. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Transfer tenderloins to a platter; let rest 10 minutes. Drizzle a little glaze over top. Carve. Serve remaining glaze on the side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,
  "difficulty": "medium",

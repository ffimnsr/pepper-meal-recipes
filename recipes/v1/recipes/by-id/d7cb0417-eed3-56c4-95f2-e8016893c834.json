  "id": "d7cb0417-eed3-56c4-95f2-e8016893c834",
  "slug": "creamy-one-pot-italian-wedding-soup-pasta-recipe-11889511",
  "name": "Creamy One-Pot Italian Wedding Soup Pasta",
  "recipe_type": "soup",
  "brief_description": "This creamy one-pot Italian wedding soup pasta features meatballs, orzo, and spinach in a creamy, cheesy sauce. It's is on the table in half an hour and there's virtually no cleanup.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Saut\u00e9 onion until soft and translucent, 3 to 4 minutes. Add garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Add frozen meatballs to the pot, pour in chicken broth, and bring to a simmer."
    },
    {
      "position": 3,
      "text": "Add pasta and simmer according to package instructions until al dente, 7 to 10 minutes, stirring occasionally. Meatballs will heat through while the pasta cooks."
    },
    {
      "position": 4,
      "text": "Stir in spinach until wilted. Lower heat and stir in heavy cream and Parmesan cheese until creamy and smooth."
    },
    {
      "position": 5,
      "text": "Taste and adjust seasoning if desired with salt, pepper, or red pepper flakes. Serve hot with extra Parmesan on top. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

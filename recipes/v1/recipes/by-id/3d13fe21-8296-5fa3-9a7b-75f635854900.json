  "id": "3d13fe21-8296-5fa3-9a7b-75f635854900",
  "slug": "pear-cobbler-recipe-6648732",
  "name": "Pear Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This pear cobbler, sweetened with maple syrup, has a rich and buttery cinnamon oat topping for a delightful fall dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss pears and lemon juice together in a bowl until coated; spread into a 9x9-inch baking dish. Pour maple syrup and 2 tablespoons melted butter over pear mixture; toss to coat."
    },
    {
      "position": 3,
      "text": "Mix oats, brown sugar, 1/2 cup melted butter, flour, and cinnamon together in a bowl until crumbly; sprinkle over pear mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is golden and pears are tender, about 45 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

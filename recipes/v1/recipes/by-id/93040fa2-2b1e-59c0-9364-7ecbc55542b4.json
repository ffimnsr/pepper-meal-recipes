  "id": "93040fa2-2b1e-59c0-9364-7ecbc55542b4",
  "slug": "justines-artichoke-chicken-spinach-dip",
  "name": "Justine's Artichoke Chicken Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for spinach and artichoke dip uses canned chicken to give some extra heft to this popular party dip.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine the spinach, artichokes, chicken, mayonnaise, cheese, garlic, and liquid smoke in a large bowl; mix well. Spoon mixture into a glass baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until the edges turn golden brown, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

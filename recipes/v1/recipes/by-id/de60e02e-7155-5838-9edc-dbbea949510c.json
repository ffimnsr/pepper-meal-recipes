  "id": "de60e02e-7155-5838-9edc-dbbea949510c",
  "slug": "bean-soup-with-kale",
  "name": "Bean Soup with Kale",
  "recipe_type": "soup",
  "brief_description": "This white bean and kale soup is simple to make with creamy cannellini beans in a rich tomato and garlic broth for a nourishing homemade meal.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium-high heat. Cook and stir onion and garlic in hot oil until soft."
    },
    {
      "position": 3,
      "text": "Add kale; cook and stir until wilted."
    },
    {
      "position": 4,
      "text": "Add 3 cups broth, 2 cups beans, tomatoes, herb seasoning, salt, and pepper; bring to a boil, then reduce heat and simmer for 5 minutes."
    },
    {
      "position": 5,
      "text": "Mix remaining beans and broth in a blender or food processor until smooth."
    },
    {
      "position": 6,
      "text": "Stir into soup to thicken, then simmer for 15 minutes. Ladle into bowls; sprinkle with parsley to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

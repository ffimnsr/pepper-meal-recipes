  "id": "78095193-14a1-5cdd-a0e4-139074e459a4",
  "slug": "brown-rice-raisin-pudding",
  "name": "Brown Rice Raisin Pudding",
  "recipe_type": "dessert",
  "brief_description": "This warm brown rice and raisin pudding is spiced with nutmeg and vanilla for a filling sweet treat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir brown rice, 1 1/4 cup milk, sugar, and salt together in a saucepan over medium heat until thick and creamy, 15 to 20 minutes. Lower heat to medium-low."
    },
    {
      "position": 2,
      "text": "Stir 1 cup milk, egg, cinnamon, and raisins into rice mixture, stirring constantly, until desired thickness, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir butter and vanilla extract into mixture."
    },
    {
      "position": 4,
      "text": "Pour pudding into serving dish and garnish with nutmeg. Allow to cool to room temperature before serving, about 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

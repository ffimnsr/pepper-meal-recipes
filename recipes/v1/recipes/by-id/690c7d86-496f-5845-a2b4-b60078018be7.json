  "id": "690c7d86-496f-5845-a2b4-b60078018be7",
  "slug": "black-raspberry-cobbler",
  "name": "Black Raspberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Black raspberries are combined with basic pantry ingredients and baked in this quick and easy cobbler recipe that delivers sweetness in a snap.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour melted butter into an 11x7-inch baking dish."
    },
    {
      "position": 3,
      "text": "Mix 1 cup sugar, flour, milk, and baking powder together in a bowl. Pour on top of melted butter in the baking dish, making sure not to stir. Place raspberries on top of mixture, making sure not to stir. Top with remaining 1/4 cup sugar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is browned and set, 30 to 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

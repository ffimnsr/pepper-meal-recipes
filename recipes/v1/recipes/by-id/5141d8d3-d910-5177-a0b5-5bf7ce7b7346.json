  "name": "Mock Cheese Cake Pie",
  "recipe_type": "dessert",
  "brief_description": "What could be simpler? Instant pudding mixed with cherry pie filling and yogurt! Excellent served with whipped topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl combine yogurt and instant vanilla pudding. Mix well. Stir in cherry pie filling. Pour filling into pie crust and chill for 30 to 60 minutes."
    }

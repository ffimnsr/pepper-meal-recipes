{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6d1fe5f5-31e3-5a35-858c-cb50fa208948",
  "slug": "old-fashioned-butter-cookies-with-butter-frosting",
  "name": "Butter Cookies with Buttercream Frosting",
  "recipe_type": "dessert",
  "brief_description": "These tender butter cookies will melt in your mouth. Perfect for cut-out cookies or topped with a sweet vanilla buttercream for a delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare cookies: Beat butter and white sugar in a large bowl until creamy. Beat in egg, milk, and vanilla until smooth."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt in a separate bowl. Gradually stir dry ingredients into wet ingredients to make a smooth dough. Chill dough in refrigerator for 2 to 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Dust a pastry cloth or kitchen towel generously with flour."
    },
    {
      "position": 4,
      "text": "Divide dough into thirds and roll each third out 1/8-inch-thick on the prepared pastry cloth. Cut shapes out of the rolled dough with cookie cutters. Place cookies onto ungreased baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cookies are barely browned, 5 to 8 minutes. Let cookies cool on baking sheets for 5 minutes before removing to finish cooling on a wire rack."
    },
    {
      "position": 6,
      "text": "While cookies are cooling, prepare frosting: Beat 3 cups powdered sugar, butter, 9 teaspoons evaporated milk, and vanilla in a bowl until smooth. Gradually stir in remaining 6 cups powdered sugar into mixture until combined. Continue to beat on high speed until frosting is fluffy; stir in additional evaporated milk or confectioners\u2019 sugar if needed to reach desired consistency."
    },
    {
      "position": 7,
      "text": "Frost cooled cookies."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8e5b698f-e68c-5412-816e-8e843f2a2f80",
  "slug": "peanut-butter-chip-pecan-pie",
  "name": "Peanut Butter Chip Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "Peanut butter chips and pecans baked in a simple and delicious pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, combine flour and sugar. Blend in melted butter, eggs and vanilla. Stir in peanut butter chips and chopped pecans. Pour filling into pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 to 40 minutes, or until golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,

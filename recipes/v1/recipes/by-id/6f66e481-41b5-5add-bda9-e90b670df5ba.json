  "slug": "pineapple-sangria",
  "name": "Pineapple Sangria",
  "recipe_type": "drink",
  "brief_description": "This pineapple sangria recipe is fruity and fizzy with white wine, pineapple juice, and citrus fruit for a great make-ahead drink.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine Sauvignon Blanc, pineapple juice, triple sec, and brandy in a large pitcher. Add lemon, pineapple, orange, and lime. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Stir in lemon-lime soda before serving."
    }
  ],

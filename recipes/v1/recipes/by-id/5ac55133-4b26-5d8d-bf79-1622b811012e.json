  "id": "5ac55133-4b26-5d8d-bf79-1622b811012e",
  "slug": "mrs-ps-biscotti",
  "name": "Mrs. P's Biscotti",
  "recipe_type": "appetizer",
  "brief_description": "A versatile basic biscotti recipe can flavored any way you like by changing the extract you use, or by adding dried fruit, nuts, or chocolate.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy; beat in eggs, egg yolk, and vanilla extract. Whisk flour and baking powder together in a bowl. Stir flour mixture into butter mixture to form a fairly sticky dough."
    },
    {
      "position": 3,
      "text": "Divide dough in half; with wet hands, shape dough into two loaves, about 1-inch high at the center, on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes; remove to cool completely on a wire rack, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Slice loaves into 1/2-inch slices with a serrated knife. Place cookie slices back onto lined baking sheet, cut sides up."
    },
    {
      "position": 6,
      "text": "Increase oven temperature to 450 degrees F (230 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, turning once, 3 to 4 minutes per side."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bb79f471-cb86-587d-951f-a020fc5b8a39",
  "slug": "chocolate-raspberry-icing",
  "name": "Chocolate-Raspberry Icing",
  "recipe_type": "dessert",
  "brief_description": "For this recipe, what starts as a fresh raspberry jam is cocoa-fied into this chocolate-raspberry icing that'll give your chocolate cake a fruity edge.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring raspberries, white sugar, and lemon juice to a boil in a medium saucepan. Reduce heat to medium; simmer, stirring occasionally, for 5 minutes. Strain; cool 5 minutes."
    },
    {
      "position": 2,
      "text": "Add confectioners' sugar, milk, butter, and cocoa powder; whisk until smooth. Taste and adjust flavorings as needed."
    },
    {
      "position": 3,
      "text": "Beat with a whisk for a thick and creamy icing. Cool before using."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

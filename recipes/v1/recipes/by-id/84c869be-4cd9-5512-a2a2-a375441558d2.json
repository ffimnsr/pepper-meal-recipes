  "id": "84c869be-4cd9-5512-a2a2-a375441558d2",
  "slug": "chili-relleno-casserole",
  "name": "Easy Chili Relleno Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This easy chili relleno casserole recipe has a layer of green enchilada sauce and lots of shredded cheese for a meltingly good, easy dinner.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Split chiles open and spread half of the chiles into the bottom of the prepared baking dish. Layer with Cheddar cheese and top with remaining canned chiles. Whisk eggs, flour, and evaporated milk together in a bowl; pour mixture over chiles and cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, about 30 minutes; remove casserole, and top with Monterey Jack cheese. Pour green enchilada sauce over the top; return to the oven and bake until cheese is melted, about 15 more minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fa8c2889-cfea-56ef-801c-b5038952882e",
  "slug": "real-pistachio-cupcakes",
  "name": "Real Pistachio Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These real pistachio cupcakes get their flavor and pale green color from ground roasted pistachios. This recipe yields a sweet treat for St. Paddy's Day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine 1/2 cup sugar and pistachios in a blender; blend until finely ground."
    },
    {
      "position": 3,
      "text": "Sift all-purpose flour, cake flour, baking powder, and salt together into a medium bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Beat remaining 1 cup sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in eggs, one at a time, beating well after each addition."
    },
    {
      "position": 5,
      "text": "Combine milk and vanilla in a small bowl."
    },
    {
      "position": 6,
      "text": "Stir flour mixture into butter mixture in several batches, alternating with milk mixture, beginning and ending with flour mixture; stir until batter just comes together. Fold in pistachios until incorporated. Spoon batter into the prepared muffin cups, filling each about 2/3 full."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 18 minutes. Cool in the muffin cups for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "7fd48516-f8d7-5ff7-9c53-c59d73a092e8",
  "slug": "potato-chip-cookies-recipe-8413963",
  "name": "Potato Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "These potato chip cookies are the most delicious and texturally fascinating chocolate chip cookies you\u2019ll ever bake. They don\u2019t taste like potatoes, in case you were concerned about that. The potato chips add flavor that pairs perfectly with the dark chocolate, and add a gorgeous color to the cookie\u2014but it\u2019s the texture that makes them truly irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, baking soda, and salt together in a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Beat butter, white sugar, and brown sugar together with an electric mixer until light and fluffy. Add egg and mix until fully incorporated and the mixture is smooth. Add milk and vanilla and repeat."
    },
    {
      "position": 3,
      "text": "Stir potato chips and chocolate chips in with a spatula until just combined. Add flour mixture; continue mixing in with a spatula until flour disappears and dough comes together."
    },
    {
      "position": 4,
      "text": "Wrap and chill dough for about 30 minutes, or until ready to bake. Dough can be used immediately if desired."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line baking sheets with parchment."
    },
    {
      "position": 6,
      "text": "Scoop dough by rounded tablespoons onto the prepared baking sheet. Space evenly, as dough will spread when baked."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until outside edges of cookies are lightly browned, about 12 minutes. Cool on the pan for about 5 minutes, before removing cookies to a wire rack to cool completely. For best results, let cool completely before serving."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,

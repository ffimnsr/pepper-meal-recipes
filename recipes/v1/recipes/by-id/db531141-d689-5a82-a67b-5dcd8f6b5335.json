{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "db531141-d689-5a82-a67b-5dcd8f6b5335",
  "slug": "funfetti-cake-donuts-recipe-11934253",
  "name": "Funfetti Cake Donuts",
  "recipe_type": "dessert",
  "brief_description": "These funfetti cake donuts are cute and fun, like we all want to be. Crisp on the outside, tender on the inside, they're made with both sour cream and buttermilk, and just sweet enough.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add flour, sugar, baking powder, and salt to a large bowl. Cut butter into small cubes and add to the bowl."
    },
    {
      "position": 2,
      "text": "Break butter into the dry ingredients, pinching between your fingers until butter is fully broken in."
    },
    {
      "position": 3,
      "text": "Combine egg, egg yolk, sour cream, buttermilk, and vanilla in a small bowl. Add egg mixture and sprinkles to flour mixture and stir just until a soft dough comes together and no flour streaks remain."
    },
    {
      "position": 4,
      "text": "Empty the dough onto a lightly floured work surface and knead together. Optionally, if dough is sticky, chill for 30 minutes to firm it up."
    },
    {
      "position": 5,
      "text": "Roll the dough out 1/2-inch thick. Use a floured donut cutter to cut the donuts. Place them on squares of parchment."
    },
    {
      "position": 6,
      "text": "Add a quart of oil to a pot and heat to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Meanwhile, for glaze, whisk powdered sugar, milk, and dash of vanilla together until smooth; place glaze in a shallow bowl."
    },
    {
      "position": 8,
      "text": "To fry donuts, carefully add 2 to 3 donuts to the hot oil. Fry 2 to 3 minutes per side, until golden brown. Remove to a wire rack and let cool for 2 minutes."
    },
    {
      "position": 9,
      "text": "Dip donuts into the glaze while still warm and place on the wire rack to set. Top with more sprinkles and let dry for 5 minutes. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

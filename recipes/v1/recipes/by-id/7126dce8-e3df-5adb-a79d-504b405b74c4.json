  "id": "7126dce8-e3df-5adb-a79d-504b405b74c4",
  "slug": "boneless-buffalo-wings",
  "name": "Boneless Buffalo Wings",
  "recipe_type": "appetizer",
  "brief_description": "These boneless wings are made with strips of skinless chicken breasts dipped in egg and seasoned flour, then fried until juicy, crispy, and golden.",
  "cuisine": "Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, salt, black pepper, cayenne pepper, paprika, and garlic powder in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk egg and milk together in a small bowl."
    },
    {
      "position": 4,
      "text": "Dip each piece of chicken in egg mixture, then roll in flour mixture. Repeat so that each piece of chicken is double-coated. Refrigerate breaded chicken for 20 minutes."
    },
    {
      "position": 5,
      "text": "Fry chicken in hot oil in batches. Cook until golden brown and juices run clear, 5 to 6 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Combine hot sauce and butter in a microwave-safe bowl. Heat sauce in the microwave until melted, 20 to 30 seconds. Pour sauce over fried chicken; mix to coat."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

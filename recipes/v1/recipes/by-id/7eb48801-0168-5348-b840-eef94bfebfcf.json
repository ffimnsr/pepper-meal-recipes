  "id": "7eb48801-0168-5348-b840-eef94bfebfcf",
  "slug": "meat-pie-tourtiere",
  "name": "Tourti\u00e8re (French Canadian Meat Pie)",
  "recipe_type": "main",
  "brief_description": "A tourti\u00e8re is a French Canadian meat pie made with deliciously seasoned ground pork, mashed potatoes, and onion in a double crust pie pastry.",
  "cuisine": "French Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Prick potato several times with a fork and place onto a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until easily pierced with a fork, 50 minutes to 1 hour. Let cool for 10 minutes, then discard skin and mash flesh. Turn the oven off."
    },
    {
      "position": 5,
      "text": "Place mashed potato into a large skillet with ground pork, onion, water, pepper, cinnamon, cloves, and allpsice. Bring to a boil, then reduce the heat and simmer until very thick, at least 1 hour."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Line a deep-dish pie plate with one pastry. Spoon in pork and potato filling."
    },
    {
      "position": 8,
      "text": "Cover with remaining pastry. Brush with beaten egg and sprinkle with paprika. Cut a steam vent in pastry."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven for 50 minutes. If the edges brown too fast, cover them with a strip of foil. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "fe639842-6a71-5a90-a04d-08492f011f19",
  "slug": "classic-southern-deviled-eggs",
  "name": "Classic Southern Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Hits of sweet pickle relish and rice vinegar make these deviled eggs a flavorful addition to any potluck, Southern or otherwise.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Remove egg yolks and place into a mixing bowl. Set whites aside. Add mayonnaise, vinegar, relish, mustard, sugar, cayenne, and black pepper to the yolks; mix well with a fork."
    },
    {
      "position": 2,
      "text": "Place mixture into a small resealable zip-top bag and snip the end off one of the corners. Pipe mixture into the egg whites. Sprinkle tops with more black pepper and cayenne. Chill until ready to serve."
    }
  ],
  "servings": 12,

  "id": "923d9fbe-0630-57c4-9485-ed63d8c67148",
  "slug": "cornbread-chicken-pot-pie",
  "name": "Cornbread Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "You'll think back to simpler times when you serve this rich, cornbread-topped pot pie right in your own home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oven to 400 degrees F. Stir the soup, corn and chicken in a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Stir the muffin mix, milk and egg in a small bowl just until blended. Spread the batter over the chicken mixture."
    },
    {
      "position": 3,
      "text": "Bake for 30 minutes or until the topping is golden brown. Sprinkle with the cheese. Let stand until the cheese is melted."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "06f6f421-e0f8-58d5-96fd-df07ab143de9",
  "slug": "french-chocolate-mousse-with-orange",
  "name": "French Chocolate Mousse with Orange",
  "recipe_type": "dessert",
  "brief_description": "A traditional chocolate mousse with a hint of orange flavor. This luxurious dairy-free and low-carb mousse is made simply with eggs and chocolate.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Grind orange zest using a mortar and pestle until it forms a smooth paste."
    },
    {
      "position": 2,
      "text": "Combine chocolate, coffee, and orange zest in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Stir until smooth and remove from heat. Allow to cool slightly"
    },
    {
      "position": 3,
      "text": "Beat egg whites and salt in a glass, metal, or ceramic bowl until stiff peaks form (see Editor's Note)."
    },
    {
      "position": 4,
      "text": "Add egg yolks to the slightly cooled chocolate mixture and stir until well combined. Pour over egg whites. Carefully fold together using a spatula until just combined."
    },
    {
      "position": 5,
      "text": "Pour mixture into 10 small dessert glasses or 1 large serving dish. Refrigerate at least 6 hours to overnight."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "dfefc72c-ae2d-5786-8c42-e2daa9ec6092",
  "slug": "candied-pecans",
  "name": "Candied Pecans",
  "recipe_type": "appetizer",
  "brief_description": "Candied pecans are an easy, make-at-home holiday gift. Baked in a sweet cinnamon coating, these tasty pecans are great to have on hand for snacking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix sugar, cinnamon, and salt together in a small bowl."
    },
    {
      "position": 3,
      "text": "Whisk egg white and water together in a large bowl until frothy."
    },
    {
      "position": 4,
      "text": "Toss pecans in the egg white mixture to coat."
    },
    {
      "position": 5,
      "text": "Slowly pour in sugar mixture and stir until pecans are evenly coated."
    },
    {
      "position": 6,
      "text": "Spread onto a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 10 minutes. Stir pecans and rearrange into a single layer. Continue to cook, stirring every 10 to 15 minutes, until pecans are evenly browned, another 30 to 50 minutes."
    },
    {
      "position": 8,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

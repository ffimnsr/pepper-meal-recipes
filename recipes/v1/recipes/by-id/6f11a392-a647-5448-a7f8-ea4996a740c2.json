  "slug": "unsoggy-salad-recipe-12013413",
  "name": "Unsoggy Salad",
  "recipe_type": "salad",
  "brief_description": "This quinoa, corn, and white bean salad is never soggy! Packed with quinoa, corn, white beans, fresh tomatoes, and bell pepper, it holds up beautifully at barbecues, picnics, and potlucks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For dressing, whisk lime juice olive oil, honey, and Dijon mustard together in a large bowl. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "For salad, add quinoa, corn, tomatoes, bell pepper, onion, chickpeas, feta, avocado, and basil to the same bowl; stir to combine with dressing."
    }
  ],
  "servings": 3,

  "slug": "vasos-de-fruta-mexican-fruit-cups-recipe-12000030",
  "name": "Vasos de Fruta (Mexican Fruit Cups)",
  "recipe_type": "salad",
  "brief_description": "These vasos de fruta, or Mexican fruit cups are fruity, spicy, crunchy, and delicious. Fresh fruits are layered in a glass, seasoned with spicy chili, and easy to enjoy anywhere.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Layer fruits in a tall glass or glass jar in this order: watermelon, cantaloupe, green grapes, red grapes, strawberries, blackberries, and pineapple. Add the jicama sticks into the top of the glass."
    },
    {
      "position": 2,
      "text": "Drizzle with chamoy, and sprinkle with Tajin seasoning."
    }
  ],

  "id": "bb8d05aa-b957-5ca8-ac0c-400aa8dc9eaf",
  "slug": "caesar-salad-deviled-eggs-recipe-11897751",
  "name": "Caesar Salad Deviled Eggs",
  "recipe_type": "salad",
  "brief_description": "For these Caesar salad deviled eggs, season the yolks with Parmesan cheese and Caesar dressing. They are so good! Top with crushed Caesar croutons and a little black pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil over medium-hight heat. Boil for 1 minute, cover, and turn off heat. Let stand for 10 minutes."
    },
    {
      "position": 2,
      "text": "Drain eggs and add to a bowl of ice water for 2 minutes. Peel eggs and cut them in half lengthwise."
    },
    {
      "position": 3,
      "text": "Remove yolks from the center of the egg and add yolks to a bowl. Use a fork to finely mash the yolks. Stir in parsley, Caesar dressing, Parmesan cheese, lemon juice, salt, and pepper until very well combined."
    },
    {
      "position": 4,
      "text": "Transfer mixture to a resealable plastic bag, seal, and use scissors to cut a small hole in one lower corner of the bag. Pipe filling evenly into the egg whites. Top evenly with crushed croutons and season with pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

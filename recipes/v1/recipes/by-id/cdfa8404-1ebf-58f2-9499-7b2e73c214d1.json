  "id": "cdfa8404-1ebf-58f2-9499-7b2e73c214d1",
  "slug": "new-york-knish-yo",
  "name": "New York Knish - Yo!",
  "recipe_type": "appetizer",
  "brief_description": "These savory potato and onion filled phyllo pastries are a bite of New York City.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes into a pot with enough water to cover. Bring to a boil, and cook until tender. Drain, and set aside."
    },
    {
      "position": 2,
      "text": "While the potatoes are boiling, heat 1/4 cup butter in a large skillet over medium heat. Stir in onions, and cook until soft and translucent."
    },
    {
      "position": 3,
      "text": "In a large bowl, mash the potatoes until smooth. Mix in onion and butter mixture, crumbled bouillon, and salt and pepper to taste."
    },
    {
      "position": 4,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a baking sheet."
    },
    {
      "position": 5,
      "text": "Layer 3 sheets of phyllo dough one on top of the other, and cut this triple-layered sheet in half. Drop one spoonful of potato mixture into each phyllo piece. Roll dough around mixture, tucking ends under. Repeat this step with remaining sheets of phyllo dough to make 12 knishes. Brush with remaining 1/4 cup butter, and place on baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in a preheated oven 30 to 40 minutes, or until golden brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "280e3ccf-21e7-557e-8aae-12f9b13c8678",
  "slug": "baked-doughnuts",
  "name": "Baked Doughnuts",
  "recipe_type": "dessert",
  "brief_description": "These aren't like deep-fried doughnuts, but they are a yummy breakfast treat! Shape them however you like - by any other shape, they'll taste as sweet!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet, or donut baking pan."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix sugar, baking powder, baking soda, nutmeg, cloves, cinnamon and flour. Mix buttermilk, eggs, honey and butter in a separate medium bowl, and stir into the dry ingredients. Spoon the mixture onto the prepared pan in doughnut shapes."
    },
    {
      "position": 3,
      "text": "Bake 12 minutes in the preheated oven, until golden brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 18,
  "rest_time_minutes": null,

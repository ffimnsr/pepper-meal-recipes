  "id": "79ead1f3-5aa7-5bac-8028-faf1e2d76292",
  "slug": "quick-and-easy-tater-tot-casserole",
  "name": "Quick and Easy Tater Tot Casserole",
  "recipe_type": "main",
  "brief_description": "This is a quick and easy tater tot casserole the whole family will love, especially those picky eaters!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Crumble ground beef into a 9x13-inch baking pan. Sprinkle beef with garlic powder, salt, and pepper. Cover beef with tater tots."
    },
    {
      "position": 3,
      "text": "In a bowl, stir together mushroom soup, celery soup, and milk. Pour the soup mixture over the tater tots and beef and sprinkle with additional garlic powder."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 60 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

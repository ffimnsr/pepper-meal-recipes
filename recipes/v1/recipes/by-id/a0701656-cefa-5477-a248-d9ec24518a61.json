  "id": "a0701656-cefa-5477-a248-d9ec24518a61",
  "slug": "skinny-buffalo-chicken-dip",
  "name": "Skinny Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "Fat-free ingredients star in this Buffalo chicken dip for a skinny version of a delicious party and potluck favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat. Saute chicken in the hot oil with garlic powder until no longer pink in the center and juices run clear, 5 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Spread cream cheese onto the bottom of an oven-proof round pie dish. Add cooked chicken and blue cheese crumbles."
    },
    {
      "position": 4,
      "text": "Mix blue cheese salad dressing and Buffalo sauce together in a bowl; pour evenly over cream cheese and chicken. Top with smoked Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through and cheese is melted, about 25 minutes. Remove from the oven and let rest for 2 to 3 minutes; stir to mix ingredients."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7d34bf0b-aa7c-5f0e-9c1d-f8ff8b036e78",
  "slug": "curry-pasta-pakistani-style",
  "name": "Curry Pasta - Pakistani Style",
  "recipe_type": "main",
  "brief_description": "Toss spaghetti or your favorite pasta with this spicy golden sauce of diced chicken, coconut milk, and red bell pepper, and garnish with chopped cilantro and lemon slices.",
  "cuisine": "Pakistani",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a small skillet over medium heat. Add the chickpea flour and cook, stirring frequently, until the flour darkens slightly and smells fragrant, about five minutes. Remove the pan from the heat and pour the toasted chickpea flour into a bowl to cool."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium-high heat. Add the red bell peppers and curry leaves and cook for 2 minutes, stirring constantly. Mix in the cubed chicken and cook, stirring frequently, until no longer pink, about 5 minutes. Stir in the ginger-garlic paste and fry for 30 seconds."
    },
    {
      "position": 3,
      "text": "Combine the turmeric, cayenne pepper, and chickpea flour. Sprinkle the spice mixture over the chicken mixture and cook, stirring constantly, for 2 minutes. Pour in 1/4 cup of water to prevent the spices from sticking to the bottom of the pan. Dissolve the coconut powder in 1 cup of water. Pour it over the chicken mixture and reduce the heat to low. Stir the mixture occasionally while you prepare the pasta."
    },
    {
      "position": 4,
      "text": "Fill a large pot with well-salted water and bring to a rolling boil over high heat. Once the water is boiling, stir in the spaghetti, and return to a boil. Cook the pasta uncovered, stirring occasionally, until the pasta has cooked through but is still firm to the bite, about 12 minutes. Drain well in a colander set in the sink."
    },
    {
      "position": 5,
      "text": "Transfer the hot spaghetti to a serving bowl and pour the chicken mixture over the pasta. Garnish with sliced green chilies, cilantro, and lemon slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

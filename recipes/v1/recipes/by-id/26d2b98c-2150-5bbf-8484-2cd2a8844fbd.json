  "id": "26d2b98c-2150-5bbf-8484-2cd2a8844fbd",
  "slug": "cindys-pumpkin-pie",
  "name": "Cindy's Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "Cindy's pumpkin pie recipe uses warm spices like ground cinnamon and ginger, but swaps melted ice cream for evaporated milk for rich and creamy results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk eggs together in a large bowl. Stir in pumpkin pur\u00e9e, sugar, salt, cinnamon, ginger, and nutmeg. Add ice cream, stirring until smooth. Divide filling between pie shells."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until filling sets, 30 to 40 minutes more."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

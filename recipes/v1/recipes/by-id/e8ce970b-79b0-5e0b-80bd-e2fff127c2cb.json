  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e8ce970b-79b0-5e0b-80bd-e2fff127c2cb",
  "slug": "pan-fried-polenta-with-corn-kale-and-goat-cheese",
  "name": "Pan-fried Polenta with Corn, Kale and Goat Cheese",
  "recipe_type": "side",
  "brief_description": "Fancy, fancy polenta. First the corn and parmesan polenta is whipped up. Then the polenta is cut into triangles, fried, topped with thick slices of tomato and a sprinkling of chevre and broiled. This glorious triangle is served on a bed of kale.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan, heat the butter over medium heat. Add the garlic and stir constantly for 1 minute; don't let the garlic brown. Add 3 cups of the water, and bring it to a boil."
    },
    {
      "position": 2,
      "text": "While the water heats, whisk together in a bowl the cornmeal, salt, and 1 cup water to make a smooth mixture."
    },
    {
      "position": 3,
      "text": "When the water in the saucepan comes to a boil, pour the mixture into it. Whisk constantly for 3 minutes to prevent lumps from forming. Turn the heat to low. Cook for 40 minutes, stirring with a wooden spoon every 10 minutes. Stir in the corn kernels and cook the polenta 5 minutes more. Stir in the pepper and Parmesan cheese. Pour the polenta into a lightly oiled 8x8 inch pan and smooth the top with a spatula. Chill the polenta in a refrigerator for 1 hour."
    },
    {
      "position": 4,
      "text": "While the polenta is cooling, cut away the stems and center stalks of the kale. Cut the leaves into 3-inch pieces."
    },
    {
      "position": 5,
      "text": "Cut the chilled polenta into 4 large triangles. Heat the olive oil in a large non-stick skillet over medium-high heat. When the oil begins to smoke, carefully add the polenta triangles. Fry the polenta until it is golden brown on the underside, then turn the polenta over and cook it until it is golden brown on the other side. Arrange the polenta on a baking sheet."
    },
    {
      "position": 6,
      "text": "Preheat the broiler on your oven."
    },
    {
      "position": 7,
      "text": "Place the kale and 1/3 cup water into the skillet that was just used to fry the polenta. Cover the skillet and cook the kale over a medium-high heat for 4 minutes."
    },
    {
      "position": 8,
      "text": "Place the tomato slices on top of the polenta triangles. Sprinkle the goat cheese on top of the tomato slices. Broil the polenta until the cheese melts and the tomatoes begin to cook."
    },
    {
      "position": 9,
      "text": "Arrange the kale on a serving platter. Place the hot polenta triangles on top of the kale and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 60,

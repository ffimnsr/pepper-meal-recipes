  "id": "ae532180-168e-5339-9218-7e35743fb476",
  "slug": "drunken-pumpkin-seeds",
  "name": "Drunken Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This drunken pumpkin seeds recipe simmers the seeds in a sweet whiskey mixture with bacon drippings, brown sugar, and salt before toasting in the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pumpkin seeds, whiskey, bacon drippings, brown sugar, and 2 teaspoons salt together in a saucepan over medium-low heat; bring to a simmer and cook until seeds begin to turn gray in the middle, 15 to 20 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Spread pumpkin seeds on a baking sheet in a single layer; season with salt."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven until crisp and golden brown, 1 to 1 \u00bd hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 5,

  "id": "e252ef08-a922-54c8-b101-bca74c324edf",
  "slug": "poor-mans-hamburger-steaks",
  "name": "Hamburger Steaks with Creamy Mushroom Gravy",
  "recipe_type": "main",
  "brief_description": "This recipe for hamburger steaks in the oven is a comforting, inexpensive meal that bakes ground beef patties with a rich and creamy mushroom sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix ground beef, crackers, milk, pepper, salt, garlic powder, and Italian seasoning together in a large bowl until well combined. Form into eight large patties and place into a 9x13 inch baking dish. Pour condensed soup evenly over patties, then sprinkle canned mushrooms over top. Cover the pan with a lid or aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until patties are no longer pink in the center, about 45 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

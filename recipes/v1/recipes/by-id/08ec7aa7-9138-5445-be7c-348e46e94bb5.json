  "id": "08ec7aa7-9138-5445-be7c-348e46e94bb5",
  "slug": "air-fryer-korean-chicken-skewers-recipe-11906522",
  "name": "Air Fryer Korean Chicken Skewers",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer Korean chicken skewers are chicken thighs marinated in a spicy-sweet Korean inspired marinade, skewered, and cooked to perfection in the air fryer.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk brown sugar, gochujang, soy sauce, sesame oil, rice vinegar, garlic, ginger paste, and smoked paprika together in a bowl."
    },
    {
      "position": 2,
      "text": "Add chicken pieces and stir to combine until evenly coated. Cover and refrigerate for at least 1 hour."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C). Thread chicken pieces on skewers."
    },
    {
      "position": 4,
      "text": "Place skewers in a single layer in the basket of the air fryer. Cook 6 minutes. Flip and cook 6 minutes more. An instant read thermometer inserted into the thickest part should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Transfer to serving plates and garnish with green onions and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

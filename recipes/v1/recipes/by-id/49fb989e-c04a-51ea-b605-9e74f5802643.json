  "id": "49fb989e-c04a-51ea-b605-9e74f5802643",
  "slug": "ultimate-pumpkin-custard-pie-recipe-8746429",
  "name": "Ultimate Pumpkin Custard Pie",
  "recipe_type": "dessert",
  "brief_description": "The ultimate pumpkin custard pie has the perfect balance of warm spices, and is unlike any you\u2019ve ever made or tasted. It is sure to become a favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and set a rack in the center."
    },
    {
      "position": 2,
      "text": "Lightly flour a work surface, and roll pastry to a 14-inch round. Press dough evenly into the bottom and sides of a 9-inch pie pan. Trim any excess dough and flute the edges. Freeze pie shell for 15 minutes or refrigerate for 30 minutes before baking,"
    },
    {
      "position": 3,
      "text": "Poke bottom and sides of pie shell with the tines of a fork; line with parchment paper and fill with pie weights or dried beans."
    },
    {
      "position": 4,
      "text": "Bake crust in the preheated oven for 30 minutes. Carefully remove weights and parchment and return the shell to the oven. Continue baking until golden and firm to the touch, about 5 more minutes. Set aside to cool while preparing filling."
    },
    {
      "position": 5,
      "text": "Add eggs, cinnamon, ginger, nutmeg, cloves, allspice, cardamom, and salt to a large bowl; whisk until well combined. Whisk in whipping cream, sour cream, vanilla bean paste, sugar, bourbon and pumpkin pur\u00e9e until well combined. Pour mixture into pie shell."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, 50 to 60 minutes. Transfer the pie to a rack to cool completely."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

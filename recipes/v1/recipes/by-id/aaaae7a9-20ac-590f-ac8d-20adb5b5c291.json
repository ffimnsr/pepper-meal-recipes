{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "aaaae7a9-20ac-590f-ac8d-20adb5b5c291",
  "slug": "broiled-and-slow-roasted-butterflied-leg-of-lamb-with-cumin-and-garlic",
  "name": "Roasted Butterflied Leg of Lamb",
  "recipe_type": "main",
  "brief_description": "This roasted butterflied leg of lamb that's seasoned with garlic, lemon, and fresh herbs is perfect for Easter and makes a stunning centerpiece.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix oil, garlic, salt, pepper, cumin, and oregano; spread paste on both sides of the lamb and let stand for an hour until meat comes to room temperature."
    },
    {
      "position": 2,
      "text": "Adjust oven rack to upper or upper-middle position (depending on lamb's thickness) and preheat broiler on high for at least 10 minutes."
    },
    {
      "position": 3,
      "text": "Place lamb, cut-side up, on a large wire rack set over a foil-lined roasting pan. Broil, moving pan so entire surface browns evenly, about 8 minutes. Turn lamb over; continue to broil until well browned on the other side, about 8 minutes longer. Turn off broiler, remove lamb from oven and let rest for 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 5,
      "text": "Stick a meat thermometer into the thickest portion of the lamb; roast in the preheated oven for a total of 50 minutes to 1 hour, until thermometer registers a rosy-pink 140 degrees F (60 degrees C). Check lamb several times after 30 minutes."
    },
    {
      "position": 6,
      "text": "As soon as lamb comes out of the oven, squeeze on lemon juice and sprinkle with fresh herbs. Carve, slicing across the grain when possible. Arrange on a platter, drizzle with accumulated juices, and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

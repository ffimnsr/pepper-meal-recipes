  "id": "db2456bf-f9fc-5044-bea2-71027f8c16c5",
  "slug": "saltine-cracker-pancakes-recipe-11920220",
  "name": "Saltine Cracker Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These saltine cracker pancakes will surprise you. With crisp edges, they're tender inside, moist but not soggy, and the little bit of cinnamon really makes them tasty. Serve them the way you always serve pancakes, with some fruit and a drizzle of syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add crackers to a large bowl and pour milk on top. If necessary add a little more, just enough to come to the top of the crackers. Allow mixture to sit until well softened and crackers have absorbed the milk, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in egg, sugar, cinnamon, vanilla, and melted butter."
    },
    {
      "position": 3,
      "text": "Heat butter in a large skillet or griddle over medium heat. Working in batches as necessary, add about 1/3 cup cracker mixture to the skillet and flatten slightly. Cook, undisturbed, until browned around the edges. Flip and cook until browned and cooked through."
    },
    {
      "position": 4,
      "text": "Serve topped with more butter if desired and drizzle with syrup. Top with fresh berries if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "506f2d5e-2db7-5923-9754-3fc2dad55dd9",
  "slug": "easy-breakfast-egg-muffins",
  "name": "Easy Breakfast Egg Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These breakfast egg muffins with cheese, bell peppers, and bacon can be customized to your tastes and made ahead for a yummy on-the-go morning meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Place bell peppers and green onions into a large bowl."
    },
    {
      "position": 3,
      "text": "Add eggs, bacon, milk, garlic powder, onion powder, salt, and pepper."
    },
    {
      "position": 4,
      "text": "Sprinkle Cheddar cheese into the bowl and whisk until incorporated."
    },
    {
      "position": 5,
      "text": "Pour mixture equally into the prepared muffin cups."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 30 minutes. Let cool slightly before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

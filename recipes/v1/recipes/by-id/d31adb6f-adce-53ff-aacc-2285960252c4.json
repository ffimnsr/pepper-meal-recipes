  "id": "d31adb6f-adce-53ff-aacc-2285960252c4",
  "slug": "turkey-breakfast-sausage",
  "name": "Turkey Breakfast Sausage",
  "recipe_type": "breakfast",
  "brief_description": "This turkey breakfast sausage is made from scratch with ground turkey, brown sugar, sage, thyme, marjoram, and red pepper flakes for a breakfast side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together turkey, brown sugar, salt, black pepper, sage, thyme, marjoram, and red pepper flakes in a bowl until well combined. Shape turkey mixture into patties."
    },
    {
      "position": 2,
      "text": "Working in batches, fry patties in a large skillet over medium-high heat until golden brown and no longer pink in the center, 6 to 8 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

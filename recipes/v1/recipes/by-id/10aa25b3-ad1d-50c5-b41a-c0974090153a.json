  "id": "10aa25b3-ad1d-50c5-b41a-c0974090153a",
  "slug": "classic-standing-beef-rib-roast",
  "name": "Classic Standing Beef Rib Roast",
  "recipe_type": "main",
  "brief_description": "Enjoy a mouthwatering standing beef rib roast, the perfect choice for your holiday feast. This recipe is a special treat that'll impress everyone.",
  "cuisine": "American British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Season beef generously with salt and black pepper; place into a roasting pan, rib-side down."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until medium-rare or desired doneness, about 2 hours 20 minutes. Transfer beef to a cutting board; let stand for 20 minutes."
    },
    {
      "position": 4,
      "text": "Discard any fat from pan drippings; stir wine into drippings. Bring to a boil over medium heat while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Reduce the heat to medium; cook 5 minutes more. Strain wine mixture through a fine-mesh sieve into a saucepan."
    },
    {
      "position": 5,
      "text": "Whisk stock and flour together in a bowl; gradually whisk into wine mixture. Cook and stir over medium heat until sauce boils and thickens, about 5 minutes; season with salt and black pepper. Serve sauce with beef."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 140,
  "preparation_time_minutes": 15,

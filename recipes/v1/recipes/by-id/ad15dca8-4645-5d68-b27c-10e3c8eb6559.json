  "id": "ad15dca8-4645-5d68-b27c-10e3c8eb6559",
  "slug": "cake-mix-cookies-viii",
  "name": "Chocolate Cake Mix Cookies",
  "recipe_type": "dessert",
  "brief_description": "These chocolate cake mix cookies are quick and easy to make with just 4 ingredients for super fudgy, decadent treats studded with chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together cake mix, butter, and eggs in a large bowl until smooth and well blended. Mix in chocolate chips until incorporated. Drop by spoonfuls onto ungreased baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges are set, 8 to 10 minutes. Cool cookies on the baking sheets for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,

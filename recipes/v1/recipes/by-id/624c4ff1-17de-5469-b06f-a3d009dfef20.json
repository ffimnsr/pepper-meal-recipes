  "id": "624c4ff1-17de-5469-b06f-a3d009dfef20",
  "slug": "bacon-jalapeno-corn-recipe-11764770",
  "name": "Bacon Jalape\u00f1o Corn",
  "recipe_type": "dessert",
  "brief_description": "This bacon jalapeno corn has a trio of flavors that may turn out to be your new favorite this summer. Look for sweet, salty, and spicy in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Pour out all but 1 tablespoon bacon fat."
    },
    {
      "position": 2,
      "text": "Add butter to the skillet and allow to melt. Stir in corn, bell pepper, red onion, and jalape\u00f1o. Cook until corn is becoming tender but still slightly crisp, about 5 minutes. Season with dried basil, salt, and pepper and stir until well combined."
    },
    {
      "position": 3,
      "text": "Crumble or chop bacon, and stir half into the corn mixture. Sprinkle the remainder over the top, garnish with fresh basil, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

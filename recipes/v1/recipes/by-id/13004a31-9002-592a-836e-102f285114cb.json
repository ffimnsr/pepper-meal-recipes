  "id": "13004a31-9002-592a-836e-102f285114cb",
  "slug": "pumpkin-patch-tarts",
  "name": "Pumpkin Patch Tarts",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin patch tarts recipe makes individual pies with sweet pumpkin filling and a whipped cream topping; meet your new favorite holiday dessert!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place tart shells on baking sheets."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 1 minute. Remove from the oven; leave the oven on."
    },
    {
      "position": 4,
      "text": "Combine pumpkin puree, evaporated milk, eggs, brown sugar, pumpkin pie spice, cinnamon, and vanilla in a large bowl; whisk until filling is well combined. Pour evenly into tart shells."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes. Rotate the baking sheets and continue baking until filling is set, about 12 minutes more."
    },
    {
      "position": 6,
      "text": "Cool tarts for 10 minutes; refrigerate until chilled, about 1 hour. Serve with whipped cream."
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

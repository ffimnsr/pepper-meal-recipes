  "id": "b0f918a3-d9ef-5d5b-af72-737ab3c74db5",
  "slug": "one-pan-balsamic-chicken-recipe-8780488",
  "name": "Best Balsamic Chicken",
  "recipe_type": "main",
  "brief_description": "This balsamic chicken dish made with baked seasoned chicken breasts, balsamic glaze, orzo, and tomatoes is loaded with flavor and ready in just over 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Slice chicken breasts in half horizontally to create 4 thin chicken breasts."
    },
    {
      "position": 3,
      "text": "Stir Cantazaro herbs, garlic granules, onion powder, salt, and black pepper together in a small bowl; season chicken on all sides with mixture."
    },
    {
      "position": 4,
      "text": "Pour olive oil into a deep cast iron skillet or other ovenproof skillet and place over medium-high heat until oil is hot. Add chicken and sear until golden, 3 to 4 minutes per side. Turn off heat; remove chicken to a plate."
    },
    {
      "position": 5,
      "text": "Pour orzo into the skillet; add chicken broth and balsamic vinegar. Add chicken back to the skillet along with any accumulated juices. Scatter cherry tomatoes around, and top chicken with slices of fresh mozzarella."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until an instant read thermometer, inserted near the center of chicken, reads 165 degrees F (74 degrees C), about 20 minutes. If needed, turn on the oven\u2019s broiler and broil until cheese is golden, about 2 minutes."
    },
    {
      "position": 7,
      "text": "Sprinkle with basil and drizzle with balsamic glaze to taste."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

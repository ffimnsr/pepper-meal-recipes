  "id": "fd89e723-1e19-5a82-9033-26cc547772a0",
  "slug": "maryland-crab-cakes-ii",
  "name": "How to Make Maryland Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "Maryland is famous for its crab cakes\u2014try this delicious recipe made with crabmeat, bread crumbs, mustard, parsley and mayo and you\u2019ll know why!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven\u2019s broiler. Lightly grease a broiler pan or baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix crabmeat, bread crumbs, parsley, salt, and pepper together in a large bowl."
    },
    {
      "position": 3,
      "text": "Mix egg, mayonnaise, mustard, and hot sauce together in a small bowl; stir into crab mixture until well combined."
    },
    {
      "position": 4,
      "text": "Form into patties and place on the prepared broiler pan or baking sheet."
    },
    {
      "position": 5,
      "text": "Broil crab cakes under the preheated broiler until golden brown on both sides, about 5 to 7 minutes per side."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "959ef999-ae85-5b21-a8bc-5a1514f00ece",
  "slug": "spicy-tuna-rolls",
  "name": "Spicy Tuna Rolls",
  "recipe_type": "main",
  "brief_description": "Even if you're new to sushi making, this recipe for fresh and spicy tuna rolls is easy to make at home.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Cut off the bottom quarter of each nori sheet; reserve for another use."
    },
    {
      "position": 2,
      "text": "Combine chopped tuna, mayonnaise, green onions, and hot sauce in a bowl."
    },
    {
      "position": 3,
      "text": "Center 1 sheet of nori on a bamboo sushi mat. Wet your hands. Spread a thin layer of rice on the nori using your hands; press into a thin layer, leaving a 1/2-inch space at the bottom edge. Sprinkle with sesame seeds. Arrange 1/4 of the tuna mixture in a line across the rice, about 1/3 of the way down from the top of the sheet."
    },
    {
      "position": 4,
      "text": "Wet the uncovered edge of the nori. Lift the top end of the mat and firmly roll it over the ingredients. Roll it forward to make a complete roll. Repeat with remaining ingredients."
    },
    {
      "position": 5,
      "text": "Slice the rolls into 3/4-inch pieces using a wet knife. Serve immediately or refrigerate until serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "08bfda3d-2204-5479-a16b-e8486aeb06e2",
  "slug": "lentil-chili-carrot-dogs-recipe-8661707",
  "name": "Lentil Chili Carrot Dogs",
  "recipe_type": "main",
  "brief_description": "These lentil chili carrot dogs\u2014vegetarian hot dogs\u2014are a must-have for summer barbecues and get-togethers. With a few adjustments, it can feed the vegans and meat eaters in your life, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Make Lentil Chili: Reserve 1/2 cup onion for serving. Heat oil in a medium saucepan over medium-high heat. Add remaining 1/2 cup onion; cook, stirring occasionally, until translucent, about 4 minutes. Add chili powder, paprika, cumin, garlic powder, pepper, and salt. Cook, stirring constantly, 1 minute."
    },
    {
      "position": 2,
      "text": "Add lentils, tomato sauce, vinegar, and brown sugar. Bring to a boil over medium-high heat; reduce heat to low. Simmer, uncovered, to allow flavors to meld, about 15 minutes; keep warm."
    },
    {
      "position": 3,
      "text": "Prepare Carrot Dogs: Meanwhile, trim carrots to about 7 inches (see Cook\u2019s Note)."
    },
    {
      "position": 4,
      "text": "Whisk together brown sugar, water, soy sauce, and liquid smoke in a large saucepan. Add carrots and enough additional water to cover. Bring to a boil over high heat; reduce heat to medium-low and simmer, covered, until carrots are tender, 10 to 15 minutes. Remove from heat. Keep warm in cooking liquid until ready to serve; drain."
    },
    {
      "position": 5,
      "text": "Serve carrots in buns; top with chili, cheese, and reserved 1/2 cup onion. Serve with mustard."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a136d6e8-3f69-5d52-8a80-12868855f6a0",
  "slug": "dads-pad-thai",
  "name": "Dad's Pad Thai",
  "recipe_type": "drink",
  "brief_description": "This pad thai recipe features a homemade sauce made with brown sugar, fish sauce, and lime juice. It rivals what you'll find in top restaurants!",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of water to a boil. Blanch bean sprouts in the boiling water for approximately 30 seconds, then remove with a slotted spoon and drain well. When the water returns to a boil, add rice noodles. Cook until tender but firm, 3 to 5 minutes. Drain and rinse under cold water."
    },
    {
      "position": 2,
      "text": "Whisk eggs in a small bowl; add a pinch of salt. In a separate bowl, stir together lime juice, ketchup, brown sugar, and fish sauce."
    },
    {
      "position": 3,
      "text": "Heat oil in a wok or large skillet over medium-high heat. Add garlic and fry for a few seconds. Add pepper flakes and carrots; cook for 1 minute then remove from the wok. Add beaten eggs to the wok and gently scramble. When eggs have set, pour in carrots, sauce, bean sprouts, noodles, peanuts, and green onions; toss together."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "bloody-maria-recipe-8730420",
  "name": "Bloody Maria",
  "recipe_type": "breakfast",
  "brief_description": "This Bloody Maria is a perfect example of the popular Bloody Mary with a twist, with tequila instead of vodka and Tajin seasoning instead of celery salt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place Tajin on a plate. Moisten the rim of a glass with a lime wedge. Press the moistened rim into Tajin. Set aside."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with ice. Add tomato juice, tequila, lime juice, Worcestershire sauce, Tabasco, horseradish, and celery seed. Shake until the outside of shaker is frosted; strain into the prepared glass."
    }
  ],

  "id": "203dfc7b-2642-5517-a4ae-a84bff71c07a",
  "slug": "make-ahead-garlic-toast",
  "name": "Make-Ahead Garlic Toast",
  "recipe_type": "appetizer",
  "brief_description": "Homemade garlic toast straight from your freezer! Slices of Italian bread spread with Parmesan garlic butter are frozen until you're ready to eat them.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix butter, Parmesan, parsley, and garlic powder together in a bowl until well combined."
    },
    {
      "position": 2,
      "text": "Arrange bread slices on a large baking sheet; spread with seasoned butter. Place the baking sheet in the freezer until bread is frozen solid, about 1 hour. Transfer bread to a resealable plastic freezer bag and store in the freezer until needed."
    }
  ],

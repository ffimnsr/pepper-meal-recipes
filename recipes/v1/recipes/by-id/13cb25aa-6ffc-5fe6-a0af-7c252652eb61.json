  "slug": "spinach-walnut-pesto",
  "name": "Spinach Walnut Pesto",
  "recipe_type": "side",
  "brief_description": "This flavorful pesto with spinach, parsley, walnuts, and Parmesan cheese is quick and easy to make and will spruce up any bowl of pasta!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place spinach, Parmesan cheese, parsley, walnuts, water, garlic, salt, and pepper in a food processor; blend until well combined. Pour in oil slowly, while processor is running, until mixture forms a smooth paste."
    }
  ],
  "servings": 4,

  "id": "5e085f0b-c061-5517-92f8-1ec1004d9601",
  "slug": "spinach-and-cheese-stuffed-pasta-shells",
  "name": "Spinach and Cheese Stuffed Pasta Shells",
  "recipe_type": "main",
  "brief_description": "A stuffed shells recipe for magnificent jumbo pasta bursting with cheesy spinach filling.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Gently place pasta shells in boiling water; return water to a boil. Cook until shells are just tender; drain well."
    },
    {
      "position": 3,
      "text": "Squeeze spinach dry and place in a large mixing bowl. Add ricotta, 1/3 cup Parmesan cheese, fennel, basil, and garlic. Season with salt and pepper; mix well."
    },
    {
      "position": 4,
      "text": "Spread 1/2 cup spaghetti sauce evenly over the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 5,
      "text": "Fill each pasta shell with spinach-cheese mixture. Arrange shells, filling-side up, in the baking dish. Spoon remaining spaghetti sauce over shells. Sprinkle remaining Parmesan cheese on top of shells."
    },
    {
      "position": 6,
      "text": "Cover the pan loosely with aluminum foil and bake in the preheated oven until heated through, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

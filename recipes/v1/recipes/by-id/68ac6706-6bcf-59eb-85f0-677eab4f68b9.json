  "id": "68ac6706-6bcf-59eb-85f0-677eab4f68b9",
  "slug": "cinnamon-sugar-biscotti",
  "name": "Cinnamon Sugar Biscotti",
  "recipe_type": "dessert",
  "brief_description": "This cinnamon biscotti is an Italian version of cinnamon toast. Everyone is sure to enjoy these!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift together flour, 1 1/2 teaspoons cinnamon, baking powder, and salt; set aside."
    },
    {
      "position": 3,
      "text": "In a medium bowl, cream together 2/3 cup sugar and butter. Beat in egg, egg yolk, and vanilla. Stir in flour mixture."
    },
    {
      "position": 4,
      "text": "On a lightly floured surface, divide dough in half. Roll each piece into a log about 9-inches long and 1 1/2-inches wide. Place logs on the prepared baking sheet and flatten slightly. Brush with beaten egg."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and firm to the touch, 25 to 30 minutes. Cool for 15 minutes."
    },
    {
      "position": 6,
      "text": "On a cutting board, slice each log crosswise at a diagonal into 1/2-inch-thick slices using a serrated knife. Place cut-side down onto the baking sheet. Combine 3 tablespoons sugar and 1 teaspoon cinnamon in a small bowl; sprinkle over biscotti."
    },
    {
      "position": 7,
      "text": "Return to the oven until toasted, 15 to 20 more minutes. Cool on wire racks and store in an airtight container."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

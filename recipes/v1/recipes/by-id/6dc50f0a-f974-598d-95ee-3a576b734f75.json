  "id": "6dc50f0a-f974-598d-95ee-3a576b734f75",
  "slug": "one-pot-teriyaki-chicken-casserole-recipe-11960287",
  "name": "One-Pot Teriyaki Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This teriyaki chicken casserole is a tasty dish packed with rice, flavorful chicken, and crisp, tender stir-fry vegetables. Everything, including the rice, bakes together in one dish, making it a foolproof recipe for an easy weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (176 degrees C). Lightly grease a 9x13-inch (3-quart) baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Place rinsed and drained rice in the prepared baking dish. Carefully pour boiling water over rice. Cover the dish tightly with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until water is absorbed and rice is tender, 20 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and let stand, covered, for 5 minutes. Uncover and fluff rice with a fork."
    },
    {
      "position": 5,
      "text": "Stir in chicken, cooked vegetables, and teriyaki sauce until well combined."
    },
    {
      "position": 6,
      "text": "Bake, uncovered, until casserole is heated through, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with green onions and sesame seeds. Serve with additional teriyaki sauce and Sriracha, if desired. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

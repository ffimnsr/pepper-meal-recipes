  "id": "6d701af4-e364-59f0-bad8-41cb4f5a89e9",
  "slug": "creamy-spicy-guacamole",
  "name": "Creamy, Spicy Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This guacamole recipe yields a creamy result thanks to the use of sour cream. The addition of prepared salsa adds extra flavor.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocado in a large bowl. Stir tomato, green onions, lime juice, salsa, garlic, sour cream, vinegar, cayenne pepper, and cumin with the mashed avocado until evenly mixed; season with salt and black pepper."
    },
    {
      "position": 2,
      "text": "Cover bowl with plastic wrap and refrigerate until the flavors blend, about 30 minutes."
    }
  ],
  "servings": 16,

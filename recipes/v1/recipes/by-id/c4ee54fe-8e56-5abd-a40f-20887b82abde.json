  "id": "c4ee54fe-8e56-5abd-a40f-20887b82abde",
  "slug": "easy-baked-bbq-pork-chops",
  "name": "Easy Baked BBQ Pork Chops",
  "recipe_type": "main",
  "brief_description": "These baked BBQ pork chops are quick and easy to prepare with minimal ingredients when you are short on time, but want a homemade meal for dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk onion, ketchup, vinegar, honey, brown sugar, Worcestershire sauce, mustard, and cayenne pepper together in a bowl until barbeque sauce is smooth."
    },
    {
      "position": 3,
      "text": "Place pork chops on a baking sheet and season with salt and pepper. Top each pork chop with 2 tablespoons of barbeque sauce."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pork chops are cooked through, about 30 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "68b2e1f2-39bc-52a0-9380-bd309359306a",
  "slug": "no-cream-pasta-primavera",
  "name": "No-Cream Pasta Primavera",
  "recipe_type": "main",
  "brief_description": "Spring veggies benefit from a quick roasting in olive oil and herbs before being tossed with penne. No cream here, just the fresh flavors of olive oil, balsamic vinegar, and lemon.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne pasta and cook until tender yet firm to the bite, 10 to 12 minutes; drain."
    },
    {
      "position": 3,
      "text": "Toss squash, zucchini, carrot, red bell pepper, tomatoes, green beans, and asparagus together in a bowl with 2 tablespoons olive oil, salt, pepper, lemon juice, and Italian seasoning. Arrange vegetables on the lined baking sheet."
    },
    {
      "position": 4,
      "text": "Roast vegetables in preheated oven until tender, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Heat remaining olive oil and butter in a large skillet. Cook onion and garlic in hot oil until tender, 5 to 7 minutes. Mix cooked pasta, lemon zest, basil, parsley, and balsamic vinegar into the onion mixture. Gently toss and cook until heated through, 3 to 5 minutes. Remove from heat and transfer to a large bowl. Toss with roasted vegetables and sprinkle with Romano cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

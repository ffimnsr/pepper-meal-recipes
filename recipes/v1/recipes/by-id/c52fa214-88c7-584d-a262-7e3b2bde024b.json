  "id": "c52fa214-88c7-584d-a262-7e3b2bde024b",
  "slug": "grilled-portobello-mushrooms",
  "name": "Grilled Portobello Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These grilled portobello mushrooms are marinated in a sweet and savory balsamic marinade then cooked on a hot grill until tender and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Clean mushrooms; remove stems, reserving them for another use. Place mushroom caps gill-side up in a shallow dish."
    },
    {
      "position": 3,
      "text": "Combine oil, balsamic vinegar, onion, and garlic in a small bowl. Pour mixture evenly over mushroom caps; let marinate at room temperature for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the grill to medium-high heat; grease the grate. Grill over the hot grill until caramelized and tender, about 5 to 8 minutes; serve warm."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

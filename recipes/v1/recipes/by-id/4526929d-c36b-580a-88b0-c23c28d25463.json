  "slug": "easy-creamy-artichoke-dip",
  "name": "Easy Creamy Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This quick and easy party dip is made simply by blending canned artichokes, mayonnaise, sour cream, Parmesan cheese, and garlic.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend artichoke hearts, Parmesan cheese, mayonnaise, sour cream, and garlic in a blender until smooth; transfer to a serving bowl. Stir lemon juice, salt, and pepper into the dip."
    }
  ],

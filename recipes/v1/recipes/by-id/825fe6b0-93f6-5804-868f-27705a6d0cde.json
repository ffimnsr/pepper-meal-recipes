{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "825fe6b0-93f6-5804-868f-27705a6d0cde",
  "slug": "king-ranch-chicken-casserole",
  "name": "King Ranch Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This classic King Ranch chicken casserole, bursting with chicken, corn tortillas, tomatoes, peppers, and cheese makes a supreme supper or potluck dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over high heat. Add onion and bell peppers; saut\u00e9 until they begin to soften, about 2 minutes. Transfer to a large bowl."
    },
    {
      "position": 3,
      "text": "Stir mushroom and chicken condensed soups, diced tomatoes with chile peppers, chicken broth, sour cream, cumin, ancho chile powder, oregano, and chipotle chile powder into onion mixture until sauce is well combined."
    },
    {
      "position": 4,
      "text": "Reserve 1/2 cup sauce and 1/2 cup Cheddar cheese for topping. Spread a few tablespoons of the remaining sauce into a 9x13-inch baking dish. Top with 1/2 of the chicken, 1/2 of the remaining sauce, 1/2 of the remaining Cheddar cheese, and 1/2 of the tortillas."
    },
    {
      "position": 5,
      "text": "Top tortillas with the remaining chicken, remaining sauce, remaining Cheddar cheese, and remaining tortillas. Spread the reserved 1/2 cup sauce over the tortillas and sprinkle with the reserved 1/2 cup Cheddar cheese."
    },
    {
      "position": 6,
      "text": "Bake casserole in the preheated oven until bubbling, about 40 minutes."
    },
    {
      "position": 7,
      "text": "Turn on the broiler; broil until the top is golden, 2 to 3 minutes more."
    },
    {
      "position": 8,
      "text": "Serve hot. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

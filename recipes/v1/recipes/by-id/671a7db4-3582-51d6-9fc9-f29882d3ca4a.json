{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "671a7db4-3582-51d6-9fc9-f29882d3ca4a",
  "slug": "hearty-vegetarian-minestrone",
  "name": "Hearty Vegetarian Minestrone",
  "recipe_type": "soup",
  "brief_description": "Loaded with tomatoes, beans, and macaroni, this vegetarian minestrone is a simple and hearty soup that will warm you up on a cold day.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Add onion and cook until soft, about 3 minutes. Add garlic and cook until fragrant, about 1 minute. Add carrots and celery; cook and stir until soft, 5 to 6 minutes."
    },
    {
      "position": 2,
      "text": "Stir in green beans, oregano, basil, salt, and pepper; cook for about 5 minutes. Add diced and crushed tomatoes and vegetable broth; bring to a boil. If it looks too thick, add a bit of water."
    },
    {
      "position": 3,
      "text": "Reduce heat to low and simmer for 20 minutes. Stir in kidney beans, cannellini beans, and macaroni; cook until pasta is tender yet firm to the bite, 7 to 10 minutes. Taste and adjust salt and pepper, if needed."
    },
    {
      "position": 4,
      "text": "Ladle into bowls and garnish with Parmesan-style cheese and fresh basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

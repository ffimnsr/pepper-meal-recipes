  "slug": "fabulous-fruit-salad",
  "name": "Fabulous Fruit Salad",
  "recipe_type": "salad",
  "brief_description": "How could this recipe miss with ripe nectarines, apples, walnuts, and dried cranberries, all stirred in a bowl with lemon yogurt. Chill and enjoy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine red apple, Granny Smith apple, nectarine, celery, dried cranberries, and walnuts. Mix in yogurt. Chill until ready to serve."
    }
  ],

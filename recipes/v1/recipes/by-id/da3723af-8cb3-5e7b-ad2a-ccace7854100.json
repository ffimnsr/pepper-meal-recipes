  "schema_version": 1,
  "id": "da3723af-8cb3-5e7b-ad2a-ccace7854100",
  "slug": "portuguese-pork-with-red-peppers",
  "name": "Portuguese Pork with Red Peppers",
  "recipe_type": "main",
  "brief_description": "Lemon slices top garlic coated pork medallions and sauteed red bell peppers in this elegant yet easy dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "With a large mortar and pestle, mash the garlic, coarse salt, 1 tablespoon olive oil, and peppercorns into a fine paste. Transfer to a large bowl."
    },
    {
      "position": 2,
      "text": "With a mallet, flatten the pork medallions to 1/4 inch thick. Place in the bowl with the garlic mixture, tossing to coat. Cover, and marinate 2 to 4 hours in the refrigerator."
    },
    {
      "position": 3,
      "text": "Heat the remaining oil in a large skillet over high heat. Stir in the pork and remaining garlic mixture. Quickly brown pork about 1 minute on each side. Remove from heat, and set aside."
    },
    {
      "position": 4,
      "text": "Place red peppers into the skillet, and saute 2 to 5 minutes, until tender but firm. Pour white wine into the skillet, and scrape up the browned bits. Reduce heat to low, return pork to skillet, and continue cooking 10 to 15 minutes, to an internal temperature of 180 degrees F (80 degrees C)."
    },
    {
      "position": 5,
      "text": "Slice 1 1/2 lemons into thin rounds. Transfer the pork and pepper mixture to a serving platter. Squeeze juice of remaining 1/2 lemon over the pork and peppers, and garnish with the lemon rounds."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

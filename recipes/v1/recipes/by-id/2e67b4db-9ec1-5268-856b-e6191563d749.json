  "id": "2e67b4db-9ec1-5268-856b-e6191563d749",
  "slug": "pitcher-perfect-margaritas",
  "name": "Pitcher Perfect Margaritas",
  "recipe_type": "dessert",
  "brief_description": "This margarita pitcher recipe uses tequila, triple sec, fresh lime juice, sweetened lime juice, and ice to make the perfect margarita for parties!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ice, tequila, triple sec, fresh lime juice, and sweetened lime juice in a large pitcher; stir."
    },
    {
      "position": 2,
      "text": "Pour kosher salt onto a plate. Rub the rim of a glass with lime wedge. Dip the rim of the glass into salt; fill the glass with margarita mixture; repeat for each serving."
    }
  ],

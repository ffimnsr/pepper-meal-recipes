  "slug": "homemade-poultry-seasoning",
  "name": "Homemade Poultry Seasoning",
  "recipe_type": null,
  "brief_description": "You don't have to buy poultry seasoning. DIY by combining herbs and spices you probably have on hand. You could save money, and a trip to the store!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix sage, thyme, marjoram, rosemary, nutmeg, and black pepper in a small bowl."
    },
    {
      "position": 3,
      "text": "Transfer seasoning to an airtight container."
    },
    {
      "position": 4,
      "text": "Label and store with your other spices."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7e7aad90-4e0a-5853-b5fc-eab1427f7cdd",
  "slug": "karens-slow-cooker-chicken-fajitas",
  "name": "Karen\u2019s Slow Cooker Chicken Fajitas",
  "recipe_type": "main",
  "brief_description": "Getting delicious chicken fajitas on the table is a breeze using a slow cooker; and clean up takes no time with a disposable Reynolds\u00ae Slow Cooker Liner.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Open Reynolds\u00ae Slow Cooker Liner and place it inside a 5- to 6 1/2-quart slow cooker bowl. Fit liner snugly against the bottom and sides of bowl; pull top of liner over rim of bowl."
    },
    {
      "position": 2,
      "text": "Place chicken in Reynolds\u00ae Slow Cooker Liner. Place onions and bell peppers on top of chicken."
    },
    {
      "position": 3,
      "text": "Mix salsa, fajita seasoning mix and cayenne pepper in a medium bowl. Pour over chicken. Place lid on slow cooker."
    },
    {
      "position": 4,
      "text": "Cook on LOW for 6 to 7 hours OR on HIGH for 3 to 4 hours until chicken is done."
    },
    {
      "position": 5,
      "text": "Carefully remove lid to allow steam to escape. Gently stir chicken and sauce with a plastic or wooden slotted spoon. Spoon 1/2 cup of chicken mixture into center of each tortilla; add desired toppings and fold tortilla over filling. Do not lift or transport liner with food inside. Cool slow cooker completely; remove Reynolds\u00ae Slow Cooker Liner and toss."
    }
  ],
  "servings": 16,

  "id": "0f72d57b-6495-504f-ae0e-31ab03c13435",
  "slug": "italian-wedding-cookies-iii",
  "name": "Italian Wedding Cookies",
  "recipe_type": "dessert",
  "brief_description": "These Italian wedding cookies are tender, buttery, and full of nutty flavor; coat with powdered sugar for a sweet, melt-in-your-mouth holiday treat.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butter, 3/4 cup confectioners' sugar, and salt in a large bowl; beat with an electric mixer until smooth and creamy, about 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Mix in ground almonds and vanilla."
    },
    {
      "position": 4,
      "text": "Blend in flour gradually until well-combined."
    },
    {
      "position": 5,
      "text": "Shape into balls (or crescents) using about 1 teaspoon for each cookie; place 1 inch apart on ungreased cookie sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the edges of the cookies are just browned, 15 to 20 minutes."
    },
    {
      "position": 7,
      "text": "Let sit until slightly cooled, about 15 minutes. Roll cookies in remaining confectioners' sugar. Enjoy!"
    }
  ],
  "servings": 80,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

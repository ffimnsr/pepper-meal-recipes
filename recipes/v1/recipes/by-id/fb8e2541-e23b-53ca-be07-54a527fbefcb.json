  "id": "fb8e2541-e23b-53ca-be07-54a527fbefcb",
  "slug": "creamy-blackened-chicken-ramen-recipe-11892038",
  "name": "Creamy Blackened Chicken Ramen",
  "recipe_type": "soup",
  "brief_description": "This creamy chicken ramen elevates humble ramen to new heights with a simple but tasty broth. Served with blackened chicken and fresh onion\u2014you will definitely say yes to this one.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Add flour to a shallow plate. Add cayenne, garlic powder, half of salt, and half of black pepper. Mix well."
    },
    {
      "position": 2,
      "text": "Lightly season chicken breast with remaining salt and pepper. Dredge chicken breast in seasoned flour and shake off any access."
    },
    {
      "position": 3,
      "text": "Heat oil in a heavy-bottomed pot over medium heat. Lay chicken breast in the pan, and cook, turning every 1 to 2 minutes, until each side is deeply blackened. Remove to a plate to rest."
    },
    {
      "position": 4,
      "text": "Lower heat to medium-low, then add garlic, chili flakes, marinara sauce, smoked paprika, and oregano. Stir continuously until fragrant, 30 seconds to 1 minute. Stir in half the chicken stock and cream. Add remaining stock, then bring heat up to medium-high."
    },
    {
      "position": 5,
      "text": "Add ramen noodles; cook in broth according to package instructions. Bring down the heat to medium-low and simmer for a few minutes."
    },
    {
      "position": 6,
      "text": "Slice chicken. To serve, ladle broth and noodles into shallow bowls. Lay some chicken pieces on top, then garnish with Parmesan, green onions, and cilantro."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

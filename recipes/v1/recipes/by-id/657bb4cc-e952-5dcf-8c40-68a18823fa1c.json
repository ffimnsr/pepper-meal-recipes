{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "657bb4cc-e952-5dcf-8c40-68a18823fa1c",
  "slug": "green-goddess-pasta-salad-recipe-11710692",
  "name": "The Potluck Pasta Salad Everyone Will Be Begging You to Bring Next Time",
  "recipe_type": "salad",
  "brief_description": "Get the recipe for Green Goddess Pasta Salad that's a summery take on the viral Green Goddess Salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a pot of heavily salted water to a boil over medium-high heat. Add the pasta to the boiling water and cook according to package instructions, or until the pasta is al dente. Drain the pasta. Transfer the pasta to a large bowl to allow to cool."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine spinach, basil, chives, shallot, garlic, cashews, Parmesan cheese, nutritional yeast, vinegar, and lemon juice in the container of a blender. Pulse to start blending. Add olive oil in a stream to emulsify to desired consistency. Season with salt and pepper. Set aside."
    },
    {
      "position": 4,
      "text": "Steam peas and asparagus until they slightly soften and become bright green, 2 to 3 minutes. (You can opt to blanch your vegetables here as well, or simply microwave with a little water for the same amount of time.) Remove from heat, rinse with cold water, drain, and transfer on top of the pasta along with the green onions."
    },
    {
      "position": 5,
      "text": "Add the dressing over the pasta and vegetables and toss gently to combine. You may or may not use all of it depending on how coated you like the pasta. Add feta and herbs, and taste for seasoning."
    },
    {
      "position": 6,
      "text": "Enjoy immediately or refrigerate for 30 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

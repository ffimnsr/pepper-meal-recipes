  "id": "95215374-ad06-5852-aa5f-f8acc419d1d5",
  "slug": "gluten-free-holiday-bliss-cookie-bars",
  "name": "Gluten-Free Holiday Bliss Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "Made with gluten-free flour, white chocolate chips, cranberries, coconut, and topped with cream cheese frosting, these cookie bars are full of Christmas flavor!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Beat butter, brown sugar, white sugar, eggs, cinnamon, and vanilla extract together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Stir flour, baking soda, salt, and xanthan gum together in a separate bowl. Stir 1/2 of the flour mixture into the egg mixture; mix well. Stir in remaining flour mixture, along with white chocolate chips and coconut. Mix well. Press into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the edges start to brown, about 23 minutes. Let cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Frost with cream cheese frosting and sprinkle with cranberry bits. Cut into 48 triangles."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

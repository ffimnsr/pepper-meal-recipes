  "id": "3aa65927-d113-5a00-bbac-c41424534d31",
  "slug": "mussels-and-pasta-with-creamy-wine-sauce",
  "name": "Mussels and Pasta with Creamy Wine Sauce",
  "recipe_type": "main",
  "brief_description": "Frozen mussel meat is an affordable, delicious option for easy weeknight meals like this creamy mussels and pasta dish. And there's no defrosting needed!",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine according to package directions until tender yet firm to the bite. Reserve cooking water."
    },
    {
      "position": 2,
      "text": "Place mussel meat in a fine-mesh strainer and rinse thoroughly with cold water."
    },
    {
      "position": 3,
      "text": "Melt 1 teaspoon butter in a medium skillet over medium-low heat. Add mussels and cook until thawed, about 3 minutes. Remove to a bowl and set aside."
    },
    {
      "position": 4,
      "text": "Wipe out the skillet with paper towels. Melt remaining 3 teaspoons butter. Cut large mushrooms into smaller pieces. Add to the skillet and sprinkle with pepper. Cook until soft, 3 to 5 minutes. Add garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 5,
      "text": "Add wine and red pepper flakes to the skillet. Cook until wine reduces by half, 2 to 3 minutes. Add cream and mussels. Heat until warmed through, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Transfer linguine to the skillet with tongs. Toss to coat in sauce. Add some reserved cooking water to thin sauce, if desired. Transfer to a plate and garnish with lemon zest."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

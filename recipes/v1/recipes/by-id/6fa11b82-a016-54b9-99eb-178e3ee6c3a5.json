  "id": "6fa11b82-a016-54b9-99eb-178e3ee6c3a5",
  "slug": "paella-ii",
  "name": "Seafood Paella",
  "recipe_type": "main",
  "brief_description": "This seafood paella with saffron-infused rice is brimming with mussels, shrimp, and squid for a classic Spanish dish that's perfect for sharing.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of lightly salted water to the boil: add mussels and cook until they open. Drain, and discard any unopened mussels. Boil shrimp and squid in a separate pot of lightly salted water, until opaque, 3 to 4 minutes. Drain, reserving liquid."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet. Add chicken pieces; cook and stir until golden brown, about 5 minutes. Transfer chicken to a plate."
    },
    {
      "position": 3,
      "text": "Place garlic, bell pepper, and tomato cubes into the skillet; cook and stir until softened, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring fish stock and 3 cups salted water to a boil; mix in 3 cups rice, saffron, and paprika. Bring to a boil again, cover, and reduce heat; simmer until rice is tender, about 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Stir peas into the rice. Pour rice mixture into a large serving dish. Arrange cooked vegetables, chicken, and shellfish around rice. Serve hot."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

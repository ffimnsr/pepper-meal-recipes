  "id": "9ad7fa66-b7cb-58c3-9604-757d3db6ca7e",
  "slug": "simple-and-easy-stuffed-peppers",
  "name": "Simple and Easy Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These beefy and cheesy peppers are easy and delicious!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large nonstick skillet over medium-high heat. Stir in the ground beef, and cook until brown and crumbly. Pour off excess grease, then stir in garlic, onion, and tomatoes. Cook and stir until the onions soften just a bit, about 3 minutes. Stir the cheese into the mixture, and set aside."
    },
    {
      "position": 3,
      "text": "Cut the tops off of the peppers, and remove the veins and seeds. Fill each pepper with the ground beef mixture and pour in some of the chicken broth. Place into the cups of a muffin tin, and replace the tops."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

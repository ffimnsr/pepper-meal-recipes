  "id": "4cf75c6f-a660-5319-ac77-dfde21937505",
  "slug": "maryland-crab-soup",
  "name": "Maryland Crab Soup",
  "recipe_type": "soup",
  "brief_description": "This crab soup recipe is authentic Chesapeake Bay food made with Old Bay, lima beans, corn, carrots, and Maryland blue back-fin crab meat and claws.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place stewed tomatoes, 3 cups water, beef broth, lima beans, corn, sliced carrots, chopped onion, and Old Bay seasoning in a 4-quart pot. Bring to a simmer over medium heat; cover and cook for 5 minutes."
    },
    {
      "position": 3,
      "text": "Bring 1 gallon water to a boil in a large pot. Add crab claws and boil for 6 minutes; drain."
    },
    {
      "position": 4,
      "text": "Stir crabmeat and boiled crab claws into tomato and vegetable mixture. Cover and simmer for 10 to 15 minutes. Serve hot."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

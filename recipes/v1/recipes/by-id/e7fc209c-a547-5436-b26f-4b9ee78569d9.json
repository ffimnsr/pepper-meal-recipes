  "id": "e7fc209c-a547-5436-b26f-4b9ee78569d9",
  "slug": "jalapeno-cranberry-sauce",
  "name": "Jalape\u00f1o Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "A moderately spicy jalape\u00f1o cranberry sauce with sherry for extra flavor is easy to make for your holiday meal. Leftovers are great on sandwiches!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix water and sugar together in a saucepan over medium heat until sugar is dissolved and mixture is boiling, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add cranberries, jalape\u00f1o peppers, and lemon juice; return to boil."
    },
    {
      "position": 4,
      "text": "Reduce heat to a gentle simmer and cook, stirring occasionally, until cranberries have broken down and sauce has thickened, 10 to 25 minutes. Stir in sherry."
    },
    {
      "position": 5,
      "text": "Remove from the heat and let cool to room temperature. Serve or transfer to a glass container, cover, and refrigerate until ready to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

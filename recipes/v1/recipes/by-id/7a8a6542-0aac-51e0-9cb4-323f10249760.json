  "id": "7a8a6542-0aac-51e0-9cb4-323f10249760",
  "slug": "german-apple-cake-i",
  "name": "German Apple Cake",
  "recipe_type": "dessert",
  "brief_description": "This German apple cake recipe makes an easy, moist, dense cake bursting with chunks of fresh apples and warming cinnamon spice for a delicious treat.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch cake pan."
    },
    {
      "position": 2,
      "text": "Beat oil and eggs in a large bowl with an electric mixer until creamy. Add sugar and vanilla extract; beat until well combined."
    },
    {
      "position": 3,
      "text": "Sift flour, cinnamon, baking soda, and salt together in a medium bowl."
    },
    {
      "position": 4,
      "text": "Gradually stir flour mixture into oil-egg mixture until just combined; batter will be very thick. Fold in apples using a wooden spoon or spatula."
    },
    {
      "position": 5,
      "text": "Spread batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, about 45 minutes. Cool cake on a wire rack before slicing."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "id": "dd0b3a9b-89b6-552f-9e45-17ddb13c1d97",
  "slug": "chili-crunch-queso-recipe-11966944",
  "name": "Chili Crunch Queso",
  "recipe_type": "appetizer",
  "brief_description": "We made a simplified version of this viral chili crunch queso, and it's a winner. Creator Jet Tila uses Mr Bing's Chili Crisp to add a little heat and crunch to white queso dip. With two kinds of cheese, cumin, and green chiles, chili crisp is the superb finishing touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat milk in a saucepan until just simmering. Reduce heat slightly, and gradually add in Cheddar and American cheeses, stirring constantly until melted."
    },
    {
      "position": 2,
      "text": "Stir in chiles, cumin, garlic powder, and salt until well combined. Remove from heat."
    },
    {
      "position": 3,
      "text": "Top with chili crunch and gently swirl it into the top of the queso. Serve immediately or keep warm until ready to serve with tortilla chips."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "9a171d99-4256-531f-9bb1-de99391247f1",
  "slug": "moms-tuna-casserole-with-ritz-cracker-topping",
  "name": "Mom's Tuna Casserole with Ritz\u00ae Cracker Topping",
  "recipe_type": "snack",
  "brief_description": "Corn, cashews, and a creamy, bacon-flavored sauce are unique additions to this mom's tuna casserole with Ritz\u00ae cracker topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes."
    },
    {
      "position": 3,
      "text": "At the same time, melt 1/4 cup butter in a skillet over medium heat. Add onion and bacon and cook until onion is tender and bacon is crisp, 8 to 10 minutes. Add flour; cook and stir for 2 minutes. Whisk in chicken stock, milk, mayonnaise, and soy sauce until combined. Remove from the heat and transfer sauce mixture to a large bowl."
    },
    {
      "position": 4,
      "text": "Drain pasta and add to the sauce mixture. Stir in Cheddar cheese, corn, celery, cashews, salt, and pepper. Transfer to the prepared casserole dish and spread crushed Ritz\u00ae crackers over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

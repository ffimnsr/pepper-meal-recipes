  "id": "c898b625-c616-583b-ad0f-4832a46a6c4f",
  "slug": "sausage-stuffed-jalapenos",
  "name": "Sausage Stuffed Jalape\u00f1os",
  "recipe_type": "appetizer",
  "brief_description": "Stuffed jalape\u00f1os with a cheesy sausage filling are baked until golden and bubbly on top. Serve with ranch dressing for a delicious spicy treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Place sausage in a skillet over medium heat. Cook and stir until evenly brown; drain."
    },
    {
      "position": 4,
      "text": "Mix sausage, cream cheese, and Parmesan cheese together in a large bowl."
    },
    {
      "position": 5,
      "text": "Spoon about 1 tablespoon of sausage mixture into each jalape\u00f1o half; arrange stuffed halves in baking dishes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bubbly and lightly browned, about 20 minutes. Serve with ranch dressing."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,

  "id": "c4aa34a9-4333-5055-89b6-f6678dc00863",
  "slug": "african-chicken-stew",
  "name": "African Chicken Stew",
  "recipe_type": "soup",
  "brief_description": "Delicious African chicken stew with vegetables, peanut butter, and a medley of spices to add a little heat. This recipe lends itself beautifully to improvisation.",
  "cuisine": "West African",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken and brown for 3 to 4 minutes; remove to a plate."
    },
    {
      "position": 2,
      "text": "Add potato, onion, and garlic to the skillet. Reduce the heat to medium-low and saut\u00e9 for 2 to 3 minutes, making sure garlic does not brown too much. Stir in cumin, coriander, pepper flakes, salt, and black pepper, then pour in water. Add reserved chicken and any accumulated juices and cover with a tight-fitting lid. Simmer, stirring occasionally, for 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in peanut butter and garbanzo beans until peanut butter is blended in. Cover and simmer until chicken is cooked through and potatoes are tender, about 10 minutes. Remove from the heat, adjust seasoning, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a05fbc86-080b-5b6d-82c6-9bd9306cbaa9",
  "slug": "candy-bar-clusters-recipe-12014996",
  "name": "Candy Bar Clusters",
  "recipe_type": "dessert",
  "brief_description": "These candy bar date clusters are a quick, no-bake treat made with Medjool dates, peanut butter, chocolate, and peanuts. They taste like a candy bar but come together in minutes with just a handful of ingredients and no added sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Open and flatten out each date. Place them on a baking sheet lined with parchment paper."
    },
    {
      "position": 2,
      "text": "Spoon about \u00bd teaspoon of peanut butter onto each date."
    },
    {
      "position": 3,
      "text": "Combine chocolate and coconut oil in a microwave-safe glass or ceramic bowl and melt in 15-second intervals, stirring after each interval, 1 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Drizzle each date with about a teaspoon of melted chocolate chips and top with crushed peanuts and sea salt if desired."
    },
    {
      "position": 5,
      "text": "Transfer baking sheet to the fridge or freezer to chill for at least 20 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

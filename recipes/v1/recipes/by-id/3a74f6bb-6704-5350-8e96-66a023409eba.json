  "id": "3a74f6bb-6704-5350-8e96-66a023409eba",
  "slug": "sugar-free-peach-and-banana-cobbler",
  "name": "Sugar-Free Peach and Banana Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This banana and peach cobbler is a sugar-free dessert recipe made with just one tablespoon of any sugar substitute, though you can add more if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Combine peaches, bananas, 2 tablespoons flour, and 1 teaspoon sugar substitute in a large bowl until fruit is evenly coated; transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Whisk 1 cup flour, baking powder, salt, and cinnamon in the same large bowl; stir in skim milk, egg, corn oil, remaining 2 teaspoons sugar substitute, and vanilla extract until well combined. Pour batter over fruit in an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cobbler is golden brown and a toothpick inserted into center comes out clean, about 30 minutes. Transfer to a wire rack; cool before serving, at least 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

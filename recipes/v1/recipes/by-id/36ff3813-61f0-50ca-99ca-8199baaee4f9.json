  "id": "36ff3813-61f0-50ca-99ca-8199baaee4f9",
  "slug": "crispy-sheet-pan-bbq-ranch-chicken-tacos-recipe-11943561",
  "name": "Crispy Sheet Pan BBQ Ranch Chicken Tacos",
  "recipe_type": "main",
  "brief_description": "Dinner tonight is crispy sheet pan BBQ ranch chicken tacos, made by baking chicken breasts in BBQ sauce until it shreds easily, and topping baked tortillas with chicken, cheese, shredded lettuce and tomato, and a delicious ranch sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place chicken in a small baking dish. Reserve 1 tablespoon ranch seasoning and sprinkle remaining seasoning over chicken. Pour barbecue sauce over chicken, cover with foil."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until chicken is done and shreds easily with a fork, 50 to 60 minutes."
    },
    {
      "position": 3,
      "text": "Increase oven to 400 degrees F (200 degrees C). Working with 2 pans or in batches with 1 pan, lightly coat a rimmed baking sheet with avocado oil."
    },
    {
      "position": 4,
      "text": "Bake tortillas in the oven for 4 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, shred chicken and return to the pan with juices; set aside. Top tortillas evenly with shredded chicken and cheese."
    },
    {
      "position": 6,
      "text": "Bake tacos until crisp, 8 to 10 minutes. Fold tortillas in half to form a taco and top with shredded lettuce and pickles."
    },
    {
      "position": 7,
      "text": "Stir together remaining ranch seasoning with sour cream, mayonnaise, and pickle brine. Serve sauce with tacos."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6eb9fd31-0cdc-5999-9ebf-51a67d2d60f6",
  "slug": "sheet-balsamic-pork-tenderloin-with-rainbow-vegetables",
  "name": "Sheet Pan Balsamic Pork Tenderloin with Rainbow Vegetables",
  "recipe_type": null,
  "brief_description": "Pork tenderloins roast in a bed of colorful carrots and butternut squash in this easy sheet pan recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a sheet pan with parchment paper or foil."
    },
    {
      "position": 2,
      "text": "Place 2 tablespoons olive oil, dates, vinegar, rosemary, garlic, salt, and pepper in a blender or small food processor. Pulse several times to mix, then puree until smooth, about 1 minute. Reserve 2 tablespoons of the mixture for later use."
    },
    {
      "position": 3,
      "text": "Combine rainbow carrots, butternut squash, and red onion in a large bowl. Toss with balsamic mixture, and place on the prepared sheet pan."
    },
    {
      "position": 4,
      "text": "Roast vegetables, uncovered in the preheated oven for 20 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, blot tenderloins with paper towels. Heat 1 tablespoon oil in a large skillet over medium-high heat. Place tenderloins in skillet and cook until lightly browned, about 2 minutes per side."
    },
    {
      "position": 6,
      "text": "Stir vegetables; nestle tenderloins into vegetables. Brush each tenderloin with 1 tablespoon reserved balsamic mixture and return the sheet pan to the oven."
    },
    {
      "position": 7,
      "text": "Roast, uncovered, until vegetables are tender and pork is slightly pink in the center, about 20 minutes. The internal temperature of the meat should read at least 145 degrees F (63 degrees C)."
    },
    {
      "position": 8,
      "text": "Drizzle vegetables and tenderloins with remaining 1 tablespoon olive oil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

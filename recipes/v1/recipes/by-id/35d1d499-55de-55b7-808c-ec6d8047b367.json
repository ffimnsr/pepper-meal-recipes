  "id": "35d1d499-55de-55b7-808c-ec6d8047b367",
  "slug": "homemade-turkey-sausage-patties-recipe-11686402",
  "name": "Homemade Turkey Sausage Patties",
  "recipe_type": "breakfast",
  "brief_description": "These homemade turkey sausage patties are leaner and have less sodium than prepared patties, plus they can be seasoned in a variety of ways, simply by choosing a different salt-free seasoning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together ground turkey, apple, salt-free seasoning, pepper, and salt in a large bowl until well combined. Shape mixture into 6 (1/4-inch-thick) patties, 4 inches in diameter (about 3 ounces per patty). Coat both sides of patties with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a very large nonstick skillet over medium heat. Working in batches if needed, add patties and cook, turning halfway through, until browned on both sides and an instant-read thermometer inserted into centers registers 165 degrees F (74 degrees C), about 6 minutes."
    },
    {
      "position": 3,
      "text": "Remove from skillet; cover to keep warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

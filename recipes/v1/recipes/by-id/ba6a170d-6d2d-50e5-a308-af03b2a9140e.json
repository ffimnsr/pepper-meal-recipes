{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ba6a170d-6d2d-50e5-a308-af03b2a9140e",
  "slug": "plant-based-chicken-pot-pie",
  "name": "Plant-Based \"Chicken\" Pot Pie",
  "recipe_type": "main",
  "brief_description": "Chicken-style seitan stands in for real chicken in this veggie-loaded, \"chicken\" pot pie that's perfect for a plant-based main course.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine carrots, peas, corn, celery, and bouillon cube in a saucepan. Add just enough water to cover and bring to a boil over medium heat. Cook until veggies are fork-tender, 3 to 5 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon of the oil in a skillet over medium heat. Add onion and cook until translucent and soft, about 5 minutes. Mix in flour, remaining oil, celery salt, garlic powder, salt, and pepper. Stir in broth and milk and reduce heat to low. Cook, stirring frequently, until sauce is thick, 5 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Place bottom crust in a 9-inch pie plate. Place seitan and cooked veggies over the crust in an even layer. Pour sauce over top and cover with top crust. Seal edges and poke 4 or 5 large vent holes in the top crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned and filling is bubbling, 30 to 35 minutes; check on the crust halfway through and if the edges are browning too quickly, cover with foil."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool for 10 to 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

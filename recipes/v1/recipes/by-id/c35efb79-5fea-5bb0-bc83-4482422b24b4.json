  "id": "c35efb79-5fea-5bb0-bc83-4482422b24b4",
  "slug": "homemade-waffles",
  "name": "Homemade Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Of all the recipes for waffles, this one might just produce the lightest and fluffiest. And with vanilla, cinnamon, and nutmeg, you can't beat the taste!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to the manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Whisk eggs in a large bowl until fluffy. Mix in milk, vegetable oil, and vanilla until combined."
    },
    {
      "position": 3,
      "text": "Combine flour, sugar, cinnamon, nutmeg, baking powder, and salt in a separate bowl. Slowly pour flour mixture into egg mixture, stirring as you pour. Mix until few to no lumps remain, being careful not to overmix. Add more flour if the batter is too thin, or more milk if the batter is too sticky or thick."
    },
    {
      "position": 4,
      "text": "Ladle some of the batter onto the preheated waffle iron. Cook until the waffle is golden brown and the iron stops steaming, 2 to 5 minutes. Repeat to make the remaining waffles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

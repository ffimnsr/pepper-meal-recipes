  "id": "d38cc3c7-23b8-583a-8538-23c37710ab42",
  "slug": "steak-nachos",
  "name": "Steak Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Steak replaces ground beef in this quick and hearty recipe for velvety nachos made with a quick roux.",
  "cuisine": "American Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a frying pan with cooking spray. Heat over medium heat. Cook and stir steak until barely any pink remains, 5 to 7 minutes. Drain fat from pan; add taco seasoning to the steak. Let simmer until desired consistency is reached, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Warm milk in a medium saucepan over medium heat until small bubbles appear along the sides. Remove from heat."
    },
    {
      "position": 3,
      "text": "Melt butter in another medium saucepan over medium-high heat. Add flour once bubbles disappear. Cook, stirring constantly with a whisk, until mixture becomes paste-like and light golden brown, about 5 minutes. Gradually whisk in the warm milk and bring to a simmer over medium heat. Cook and stir until the mixture is thick and smooth, 10 to 15 minutes. Reduce heat to low and stir in shredded cheese."
    },
    {
      "position": 4,
      "text": "Add black beans, salsa, and the steak pieces. Stir and serve with tortilla chips."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "d64c7c52-e8e6-5b4b-937b-2bf9dcc197e6",
  "slug": "chef-johns-french-toast",
  "name": "Chef John's French Toast",
  "recipe_type": "breakfast",
  "brief_description": "For amazing French toast, use this two-step method. And everyone--including the cook--gets to sit down for breakfast at the same time!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk eggs, milk, vanilla extract, cinnamon, allspice, and salt together in a large bowl. Place bread slices in egg mixture and soak, turning to coat, until bread is completely saturated."
    },
    {
      "position": 3,
      "text": "Melt butter in a cast-iron skillet over medium heat. Working in batches, cook bread in hot butter until golden, about 3 minutes per side. Transfer toasted bread to a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake toast in the oven until outside is crisp and slightly puffed, 12 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

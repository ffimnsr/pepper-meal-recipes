  "id": "581721d4-f72f-593e-bf9f-de749846b8a8",
  "slug": "instant-pot-meatloaf",
  "name": "Instant Pot Meatloaf",
  "recipe_type": "dessert",
  "brief_description": "This instant pot meatloaf is topped with a sweet ketchup and mustard sauce and finished off under the broiler for a family-pleasing, comforting meal.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Make the meatloaf: Mix beef, bread crumbs, onion, apple, egg, garlic powder, salt, and pepper in a large bowl until evenly blended."
    },
    {
      "position": 2,
      "text": "Shape the beef mixture into a loaf and place on a large piece of aluminum foil. Fold the foil up and around the edges of the meatloaf, creating a makeshift loaf pan."
    },
    {
      "position": 3,
      "text": "Pour 1/2 cup water into a multi-functional pressure cooker (such as Instant Pot) and place the steam rack inside with the handles up. Place the meatloaf on top of the rack. Close and lock the lid; seal the vent. Select high pressure according to manufacturer\u2019s instructions; set timer for 25 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven\u2019s broiler."
    },
    {
      "position": 5,
      "text": "Release cooker pressure carefully using the quick-release method according to the manufacturer\u2019s instructions, about 5 minutes. Unlock and remove the lid. Transfer meatloaf, still on the rack, to a baking sheet. Broil meatloaf in the oven until browned, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, make the topping: Combine ketchup, mustard, and brown sugar in a small bowl."
    },
    {
      "position": 7,
      "text": "Brush over meatloaf and broil again until caramelized, 1 to 2 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

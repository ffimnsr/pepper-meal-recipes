  "id": "082943a3-8dbc-5f36-a5cd-a1b1f740b7b9",
  "slug": "rhubarb-cream-pie",
  "name": "Rhubarb Cream Pie",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb cream pie recipe is easy to follow and makes a lovely deep-dish custard pie studded with lots and lots of fresh rhubarb with warm nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together sugar, flour, and nutmeg in a large bowl. Stir in eggs. Add rhubarb; toss until thoroughly coated. Pour filling into pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 to 60 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,

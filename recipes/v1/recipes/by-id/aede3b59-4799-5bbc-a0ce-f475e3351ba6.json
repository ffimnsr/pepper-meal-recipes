  "id": "aede3b59-4799-5bbc-a0ce-f475e3351ba6",
  "slug": "quick-and-easy-baked-buffalo-chicken-dip",
  "name": "Quick and Easy Baked Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "Traditional Buffalo chicken dip is quick and easy when you bake it in the oven; serve while you watch the big game or as an appetizer!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking dish."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, hot sauce, 1/2 cup pepper Jack cheese, and blue cheese dressing together in a large bowl; fold in chicken until completely coated. Pour mixture into the prepared baking dish and top with crumbled blue cheese and 1/3 cup pepper Jack cheese."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted and dip is bubbling up the sides, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

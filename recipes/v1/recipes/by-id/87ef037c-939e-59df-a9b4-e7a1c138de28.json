  "id": "87ef037c-939e-59df-a9b4-e7a1c138de28",
  "slug": "meat-filled-manicotti",
  "name": "Meat Filled Manicotti",
  "recipe_type": "main",
  "brief_description": "A pleasing blend of ground beef, cottage cheese, mozzarella, Parmesan, egg whites and dried oregano is stuffed into large tubes of cooked manicotti in this satisfying baked dish. Blanket the stuffed pasta with spaghetti sauce, top with cheese and bake.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente. Drain and cool. Reserve."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a large skillet brown beef on medium heat. Drain and cool."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Combine beef, cottage cheese, 1 cup mozzarella cheese, Parmesan cheese, egg whites and oregano. Mix well. Stuff shells with mixture."
    },
    {
      "position": 5,
      "text": "Lightly grease a 9x13 inch baking dish. Pour enough spaghetti sauce in dish to cover the bottom. Place stuffed noodles in the dish. Cover with spaghetti sauce and top with the remaining 1 cup mozzarella cheese. Bake in preheated oven for 50 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6ee0fc4f-8735-558f-a8ef-44d1de8eba12",
  "slug": "homemade-chili",
  "name": "Homemade Chili",
  "recipe_type": "soup",
  "brief_description": "This homemade beef chili recipe with kidney beans, chili powder, garlic, and green chile peppers is always a winner \u2014 top with Cheddar and corn chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-low heat. Add onion and garlic; cook and stir until onion is translucent, about 5 minutes. Add ground beef; cook and stir until browned, 8 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer beef mixture to a 6-quart slow cooker. Stir in kidney beans, diced tomatoes, tomato pur\u00e9e, water, green chile peppers, chili powder, salt, cumin, and black pepper."
    },
    {
      "position": 3,
      "text": "Cover the slow cooker. Cook on Low until flavors combine, 4 to 6 hours."
    },
    {
      "position": 4,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 255,
  "preparation_time_minutes": 10,

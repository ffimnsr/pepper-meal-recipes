{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0f2e8b26-c818-5744-b613-c72c1d964c24",
  "slug": "lisas-favorite-carne-asada-marinade",
  "name": "Lisa's Favorite Carne Asada Marinade",
  "recipe_type": "main",
  "brief_description": "This popular carne asada recipe includes a delicious spicy citrus and soy marinade to ensure the steak is juicy and tender when it comes off the grill.",
  "cuisine": "Latin",
  "instructions": [
    {
      "position": 1,
      "text": "Combine orange juice, lemon juice, and lime juice for marinade in a large glass or ceramic bowl. Add cilantro, soy sauce, garlic, chili powder, cumin, paprika, black pepper, chipotle pepper, and oregano; stir to combine."
    },
    {
      "position": 2,
      "text": "Slowly whisk in olive oil until well combined. Remove 1 cup of the marinade and place in a small bowl; cover with plastic wrap and refrigerate for use after the steak is cooked."
    },
    {
      "position": 3,
      "text": "Place steak between two sheets of heavy plastic (resealable freezer bags work well) on a solid, level surface. Firmly pound steak with the smooth side of a meat mallet to a thickness of 1/4 inch."
    },
    {
      "position": 4,
      "text": "After pounding, poke steak all over with a fork. Place steak in the marinade in the large bowl, cover, and marinate in the refrigerator for 24 hours."
    },
    {
      "position": 5,
      "text": "When ready to cook, preheat an outdoor grill for medium-high heat, and lightly oil the grate."
    },
    {
      "position": 6,
      "text": "Remove steak from the marinade and shake off excess. Discard the remaining marinade."
    },
    {
      "position": 7,
      "text": "Cook steak on the preheated grill to desired doneness, about 5 minutes per side for medium-rare."
    },
    {
      "position": 8,
      "text": "Remove steak from grill and slice across the grain."
    },
    {
      "position": 9,
      "text": "Place on a serving platter and pour the reserved, unused marinade over top. Serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

  "id": "a3f78597-99f9-574e-8b9f-066ef9f3b376",
  "slug": "blt-pasta-carbonara",
  "name": "BLT Pasta Carbonara",
  "recipe_type": "main",
  "brief_description": "The addition of summer tomatoes and spinach to this traditional pasta carbonara dish brings things to a whole new level.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Add bacon; cook, stirring occasionally until crisp and fat has rendered, 5 to 7 minutes. Remove bacon using a slotted spoon and set aside. Pour bacon fat into a small bowl and set aside, but do not wash the skillet."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil."
    },
    {
      "position": 3,
      "text": "Mix Parmesan cheese, eggs, egg yolk, and 1/8 teaspoon black pepper together in a bowl."
    },
    {
      "position": 4,
      "text": "Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain into a colander set over a large, heatproof bowl. Reserve 1 cup of the cooking water and pour the rest out, keeping the now-heated bowl in place."
    },
    {
      "position": 5,
      "text": "Return 1 teaspoon reserved bacon fat to the large skillet over medium heat. Add garlic and cook until fragrant, about 30 seconds. Cook 30 seconds more and add tomatoes. Cook, stirring occasionally, until heated through but not falling apart, about 5 minutes. Stir in spinach."
    },
    {
      "position": 6,
      "text": "Add cooked bacon, cooked tomato mixture, and cooked pasta to the heated bowl. Whisk 1/2 cup of the reserved cooking water into the egg mixture. Pour this over the pasta mixture in the bowl and toss for 3 minutes. Thin sauce if necessary by adding additional reserved cooking water. Season with salt and pepper. Serve immediately with additional Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

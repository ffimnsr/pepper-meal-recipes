{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4988d4e3-ee8a-5315-93e0-2579ec4512f6",
  "slug": "meatball-stuffed-garlic-bread-sliders",
  "name": "Meatball-Stuffed Garlic Bread Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These meatball sliders from Chef John made with homemade meatballs stuffed in rolls with spicy tomato sauce and garlic butter are super fun football food!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon olive oil in a saucepan over medium heat. Add onion and 2 cloves garlic; cook and stir until onion is soft, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Place beef in a large bowl. Add onion-garlic mixture, parsley, egg, bread crumbs, and 1 large handful of fontina cheese, reserving the rest for topping. Season with salt, pepper, and cayenne. Mix by hand until just combined. Scoop meat mixture into 24 mini muffin cups; meatballs need not be perfectly round."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the centers, about 12 minutes. Leave oven on. Let meatballs cool briefly while you make the garlic butter."
    },
    {
      "position": 5,
      "text": "Melt butter in a saucepan over medium heat. Add remaining minced garlic once butter starts to bubble; stir, then immediately remove from heat. Stir well and set aside."
    },
    {
      "position": 6,
      "text": "Line a rimmed baking sheet with foil; coat foil with remaining olive oil. Transfer rolls, still attached, to the baking sheet. Cut a hole in the top of each roll, about 2/3 of the way down. Brush garlic butter over the insides and outsides of the rolls."
    },
    {
      "position": 7,
      "text": "Bake until golden brown, about 8 minutes. Pour about 1 tablespoon tomato sauce into each hole. Stuff meatballs into the holes. Top each roll with a spoonful of tomato sauce and remaining fontina cheese. Sprinkle Parmesan cheese on top."
    },
    {
      "position": 8,
      "text": "Continue baking until cheese is melted, 12 to 15 minutes. Garnish with more parsley. Let rolls sit for 5 to 10 minutes to firm up; transfer to a serving platter."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,

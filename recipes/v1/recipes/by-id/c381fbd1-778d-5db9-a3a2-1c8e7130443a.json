  "id": "c381fbd1-778d-5db9-a3a2-1c8e7130443a",
  "slug": "butter-swim-biscuits",
  "name": "Butter Swim Biscuits",
  "recipe_type": "main",
  "brief_description": "Butter swim biscuits are buttermilk biscuits baked in a pool of melted butter. They're fluffy, delicious, and easy to make with basic pantry items.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Place butter in a glass or ceramic 8-inch square baking dish. Microwave for 1 minute. Stir butter; continue to cook and stir in 20-second intervals until butter is fully melted."
    },
    {
      "position": 4,
      "text": "Sift flour, baking powder, sugar, and salt into a bowl."
    },
    {
      "position": 5,
      "text": "Stir in buttermilk until combined."
    },
    {
      "position": 6,
      "text": "Pour into the baking dish and spread over melted butter. Use a bench scraper to cut dough into 9 equal pieces."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until starting to brown on top, 20 to 25 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

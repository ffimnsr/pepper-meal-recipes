  "id": "15a75f68-884c-5093-87d4-0ee3a2071fb2",
  "slug": "microwave-breakfast-ring",
  "name": "Microwave Breakfast Ring",
  "recipe_type": "breakfast",
  "brief_description": "Similar to monkey bread or pull-apart loaf, this easy variation is a time-saving recipe prepared quickly in the microwave.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix brown sugar, water, butter, and cinnamon together in a microwave-safe bowl; heat in microwave until the butter melts, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Stir biscuit dough and apple with the sugar mixture to coat dough pieces completely. Spread the mixture evenly around the ring of a microwave-safe tube pan (such as Bundt\u00ae)."
    },
    {
      "position": 3,
      "text": "Cook in microwave oven on High for 3 minutes. Let rolls finish cooking as they rest at room temperature for 5 minutes. Invert onto a serving platter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

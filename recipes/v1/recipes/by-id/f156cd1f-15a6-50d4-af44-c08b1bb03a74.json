  "id": "f156cd1f-15a6-50d4-af44-c08b1bb03a74",
  "slug": "pulled-pork-split-pea-soup",
  "name": "Pulled Pork Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This pulled pork split pea soup recipe uses leftover pulled pork. This hearty, comforting split pea soup is perfect for chilly autumn and winter nights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a 4-quart pot over medium-low heat. Add yellow and red onions, garlic, salt, oregano, bay leaf, and black pepper; cook and stir until onions are translucent, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, pork, split peas, and carrots; bring to a boil. Reduce heat to low; simmer until split peas are soft, about 1 1/2 hours."
    }
  ],
  "servings": 12,

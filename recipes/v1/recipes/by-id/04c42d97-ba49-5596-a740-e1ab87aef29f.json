  "id": "04c42d97-ba49-5596-a740-e1ab87aef29f",
  "slug": "creamy-cordon-bleu-bake",
  "name": "Creamy Cordon Bleu Bake",
  "recipe_type": "soup",
  "brief_description": "This casserole version of a French classic relies on the ease of canned soups to sauce chicken with ham and Swiss cheese.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken breasts in a lightly greased 9x13 inch baking dish. Pour soups over the chicken. Then spread the ham around and over the soups. Top all with the cheese and cracker crumbs."
    },
    {
      "position": 3,
      "text": "Bake at 375 degrees F (190 degrees C) for 50 minutes, making sure chicken is fully cooked."
    }
  ],
  "servings": 6,

  "slug": "buttermilk-coleslaw",
  "name": "Buttermilk Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This creamy buttermilk coleslaw, made with mayonnaise, sugar, celery seed, and packaged slaw mix, is a simple side dish to serve at your next barbecue.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together mayonnaise, buttermilk, sugar, celery seed, and black pepper in a large bowl until well combined. Fold in coleslaw mix until evenly coated. Refrigerate before serving, at least 2 hours."
    }
  ],
  "servings": 12,

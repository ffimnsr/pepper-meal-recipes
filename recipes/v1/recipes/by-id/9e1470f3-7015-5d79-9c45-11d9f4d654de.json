  "id": "9e1470f3-7015-5d79-9c45-11d9f4d654de",
  "slug": "pesto-turkey-burgers",
  "name": "Pesto Turkey Burgers",
  "recipe_type": "main",
  "brief_description": "This Mediterranean-style turkey burger is flavored with basil pesto and crumbled feta cheese. It\u2019s delicious, fancy, and ready in only 20 minutes! Serve on buns with lettuce and tomato.",
  "cuisine": "Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat."
    },
    {
      "position": 2,
      "text": "Mix together ground turkey, pesto, garlic, feta cheese, 1 1/2 teaspoons seasoned salt, and breadcrumbs in a bowl until evenly blended. Form into 4 patties."
    },
    {
      "position": 3,
      "text": "Grill pesto burgers until no longer pink in the center, about 5 minutes per side. Sprinkle with seasoned salt halfway through cooking."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

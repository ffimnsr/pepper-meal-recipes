  "id": "e2314716-16a5-581f-804c-97b97702d59a",
  "slug": "rhubarb-upside-down-cupcakes-recipe-7182120",
  "name": "Rhubarb Upside-Down Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These refreshing rhubarb upside-down cupcakes are the perfect little treat in late spring.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat 18 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Spoon 1 teaspoon melted butter into each prepared muffin cup, followed by 1 Tablespoon brown sugar and about 2 Tablespoons rhubarb. Use a muddler or the back of a wooden spoon to press it into an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until rhubarb just begins to soften, 7 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat cake mix, water, eggs, oil, and almond extract in a large bowl with an electric mixer at low speed until moistened, about 30 seconds. Increase speed to medium and beat for 2 minutes."
    },
    {
      "position": 5,
      "text": "Pour batter over rhubarb in hot muffin cups, filling each just over 3/4-full."
    },
    {
      "position": 6,
      "text": "Return to the oven and bake until a toothpick inserted into centers comes out clean, 18 to 20 minutes."
    },
    {
      "position": 7,
      "text": "Cool in the muffin cups 5 minutes before inverting onto a wax paper-lined cooling rack. Serve warm drizzled with any syrup in cups."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

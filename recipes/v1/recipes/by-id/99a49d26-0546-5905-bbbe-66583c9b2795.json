{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "99a49d26-0546-5905-bbbe-66583c9b2795",
  "slug": "the-best-ever-vegan-sushi",
  "name": "The Best Ever Vegan Sushi",
  "recipe_type": "main",
  "brief_description": "This vegan sushi meal is the best ever with fried tofu, avocado, and colorful veggies in sushi rice and nori, dipped in a spicy vegan mayo.",
  "cuisine": "Asian Inspired Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rice, water, and a pinch of salt in a saucepan; bring to a boil. Stir once with a bamboo rice spatula or a thin wooden spoon. Reduce the heat to low, cover, and cook until all water is absorbed and rice is tender, about 20 minutes. Let cool."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a small saucepan over medium heat; add rice vinegar, sugar, and 1/8 teaspoon salt. Heat mixture until all sugar has dissolved and liquid begins to simmer. Remove from the heat and let cool until safe to handle, at least 10 minutes. Fold small portions of the cooled liquid slowly into the cooled rice until mixture is slightly wet and sticky but not gooey; you may not need all of the liquid."
    },
    {
      "position": 3,
      "text": "Press excess liquid out of the tofu using a paper towel. Cut tofu into strips."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a small skillet over medium heat. Add tofu strips, onion, and garlic; cook and stir until tofu is golden brown, about 4 minutes per side."
    },
    {
      "position": 5,
      "text": "Mix vegan mayonnaise and Sriracha together in a small bowl."
    },
    {
      "position": 6,
      "text": "Lay a sheet of nori, rough-side up, on a sushi mat. With wet fingers, firmly pat a thick, even layer of prepared rice over the nori, covering it completely. Arrange tofu strips, avocado, cabbage, carrots, and cucumber in a line along the bottom edge of the sheet."
    },
    {
      "position": 7,
      "text": "Roll nori and sushi mat over the filling. Remove the mat and wrap the roll with plastic wrap, twisting ends tightly to compress the roll. Refrigerate until set, 5 to 10 minutes. Repeat with remaining nori and filling."
    },
    {
      "position": 8,
      "text": "Remove sushi roll from the plastic wrap, slice into pieces, and top with the Sriracha mayonnaise."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

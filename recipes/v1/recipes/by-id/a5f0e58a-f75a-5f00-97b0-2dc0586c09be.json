  "id": "a5f0e58a-f75a-5f00-97b0-2dc0586c09be",
  "slug": "carrot-apple-and-zucchini-muffins",
  "name": "Carrot, Apple, and Zucchini Muffins",
  "recipe_type": "breakfast",
  "brief_description": "Hearty muffins made with zucchini, carrot, and apple make a nice breakfast, a snack, or an on-the-go light meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat 24 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir zucchini, carrots, and apple together in a large bowl. Mix in yogurt, sucralose and brown sugar blend, eggs, applesauce, skim milk, canola oil, lemon zest, and orange zest until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Whisk all-purpose flour, whole wheat flour, baking powder, baking soda, salt, cinnamon, nutmeg, and allspice in a separate bowl. Gently stir dry ingredients into wet ingredients until just combined. Fold walnuts into batter. Pour batter into prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

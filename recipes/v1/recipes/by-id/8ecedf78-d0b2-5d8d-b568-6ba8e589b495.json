  "id": "8ecedf78-d0b2-5d8d-b568-6ba8e589b495",
  "slug": "easy-fried-chinese-chicken-balls",
  "name": "Easy Fried Chinese Chicken Balls",
  "recipe_type": "main",
  "brief_description": "These fried Chinese chicken balls are dipped in a cornstarch batter, then fried until golden for a crispy, succulent bite better than any restaurant.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Make batter: Combine flour, baking powder, and salt in a large bowl. Drizzle in sesame oil. Gradually add water, whisking constantly until smooth; batter should be the consistency of cream. Let sit for at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Fill a deep pan or wok with oil and slowly heat to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Prepare chicken: Mix together cornstarch and white pepper in a large shallow dish. Dust chicken in cornstarch mixture, then dip into batter, evenly coating each piece."
    },
    {
      "position": 4,
      "text": "Working in batches, fry coated chicken in hot oil until golden and no longer pink in the center, 4 to 5 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Use a slotted spoon to remove fried chicken to a clean kitchen towel to drain."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "16283e1d-a2ba-5729-9e29-0fbcc2dd7ab5",
  "slug": "easy-leek-and-potato-soup",
  "name": "Easy Leek and Potato Soup",
  "recipe_type": "soup",
  "brief_description": "A classic soup, simply done, this leek and potato recipe is easy to prepare and takes less than 1 hour from stovetop to dining table.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over medium heat. Add onion and garlic; cook, stirring frequently, until slightly softened, about 3 minutes. Add stock, potatoes, leeks, parsley, bouquet garni, bouillon cube, salt, and pepper; bring to a boil. Reduce the heat and simmer until potatoes are tender, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Remove soup from the heat; discard bouquet garni. Pur\u00e9e soup with an immersion blender until smooth."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

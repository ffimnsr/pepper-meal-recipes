  "schema_version": 1,
  "id": "c3fe0580-d9ea-560e-a14e-db68aa5539e6",
  "slug": "pumpkin-brownies",
  "name": "Pumpkin Brownies",
  "recipe_type": "dessert",
  "brief_description": "These fudgy pumpkin brownies are the perfect combination of chocolate, pumpkin puree, walnuts, and fall spices swirled together for a decadent treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking pan."
    },
    {
      "position": 2,
      "text": "Stir flour, baking powder, and salt together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Stir sugar, melted butter, and vanilla together in a large bowl."
    },
    {
      "position": 4,
      "text": "Add one egg and mix with a spoon until well incorporated. Repeat to add remaining 2 eggs, mixing well after each addition."
    },
    {
      "position": 5,
      "text": "Gradually add flour mixture and stir the batter until evenly moistened. Pour 1/2 of the batter back into the medium bowl that held the flour mixture."
    },
    {
      "position": 6,
      "text": "Stir chocolate chips and cocoa into one bowl of batter. Stir pumpkin puree, walnuts, cinnamon, cloves, and nutmeg into the second bowl of batter."
    },
    {
      "position": 7,
      "text": "Spread 1/2 of the chocolate batter into the bottom of the prepared baking pan, and follow with 1/2 of the pumpkin batter. Repeat the two layers once more."
    },
    {
      "position": 8,
      "text": "Drag a kitchen knife or small spatula gently through the layers in a swirling motion to create a marbled appearance."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until the brownies begin to pull away from the sides of the pan, and a toothpick inserted into the center comes out clean, 40 to 45 minutes."
    },
    {
      "position": 10,
      "text": "Remove from the oven and let cool in the pan before cutting into 16 squares."
    },
    {
      "position": 11,
      "text": "Serve warm, topped with a scoop of vanilla ice cream. Enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

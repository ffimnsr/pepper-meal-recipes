  "id": "b4ee7880-5b54-5600-9a0b-5e1ac55cc561",
  "slug": "tar-heel-pie",
  "name": "Tar Heel Pie",
  "recipe_type": "dessert",
  "brief_description": "This tar heel pie recipe yields a very rich pie made with chocolate chips, coconut, and pecans. It\u2019s best if it\u2019s underbaked and gooey, like a brownie.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "Pour warm melted butter over \u00be cup chocolate chips in a large bowl; stir until smooth. Whisk flour, brown sugar, and white sugar together in a separate bowl; stir into chocolate mixture. Stir in eggs and vanilla extract. Fold in pecans, coconut, and remaining \u00bc cup chocolate chips; pour into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until top is set (it might crack slightly), 35 to 40 minutes. The pie is best if underbaked."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

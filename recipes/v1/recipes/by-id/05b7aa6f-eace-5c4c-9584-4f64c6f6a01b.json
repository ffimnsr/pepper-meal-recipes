  "id": "05b7aa6f-eace-5c4c-9584-4f64c6f6a01b",
  "slug": "easy-microwave-chilaquiles",
  "name": "Easy Microwave Chilaquiles",
  "recipe_type": "breakfast",
  "brief_description": "This recipe is a speedy alternative to the more traditional Mexican breakfast dish. Enchilada sauce, tortilla chips, and Mexican cheese are assembled in layers, and then heated in the microwave to meld the flavors together.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Cover the bottom of a shallow microwaveable dish, with some of the enchilada sauce. Arrange a layer of tortilla chips on top. Follow with another layer of sauce, then a layer of sour cream. Sprinkle cheese over the top. Repeat layers to use up all ingredients, finishing with cheese on top."
    },
    {
      "position": 2,
      "text": "Cook in the microwave on high for 2 minutes, or until cheese has melted throughout. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 15,

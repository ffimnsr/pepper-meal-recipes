  "id": "f4a3447e-f872-5ff2-bbfb-54bd0504dc61",
  "slug": "chicken-marsala-florentine",
  "name": "Chicken Marsala Florentine",
  "recipe_type": "main",
  "brief_description": "This is a gorgeous chicken dish with sun-dried tomatoes, spinach, and mushrooms. It is so wonderful when served with garlic mashed potatoes. It tastes fantastic!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts between two pieces of wax paper, and pound to 1/4 inch thick with a meat mallet. Dust chicken with flour, salt , pepper and oregano."
    },
    {
      "position": 2,
      "text": "In a skillet, fry chicken in olive oil over medium heat. Cook until done, turning to cook evenly. Set aside, and keep warm."
    },
    {
      "position": 3,
      "text": "In the same pan, melt the butter over medium heat; add mushrooms, sun-dried tomatoes, and Marsala wine. Cook for approximately 10 minutes, stirring occasionally. Mix in spinach, and cook for about 2 minutes. Serve over chicken."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "56e86b1b-f227-5e65-abc5-70e44258ac3b",
  "slug": "bacon-wrapped-stuffed-mushrooms",
  "name": "Bacon Wrapped Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "A classic favorite stuffed mushroom is taken to new heights by wrapping in a slice of bacon. Simple, but will melt in your mouth!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together the green onions and cream cheese . Stuff mushroom caps with the cheese mixture. Wrap each mushroom with a half-slice of bacon, and secure with toothpicks. Place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake for 20 minutes in the preheated oven, until the bacon is cooked through."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

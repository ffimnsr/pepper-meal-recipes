  "id": "90a537a0-b222-5233-88e8-7abba3961af1",
  "slug": "instant-pot-pasta-and-meat-sauce-recipe-7498554",
  "name": "Instant Pot Pasta and Meat Sauce",
  "recipe_type": "main",
  "brief_description": "This Instant Pot pasta and meat sauce recipe takes under an hour and you only have one pot to clean when you're done!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select the saut\u00e9 function. Add onion and olive oil. Cook and stir until onion is slightly soft, about 5 minutes. Add beef, Italian seasoning, pepper flakes, garlic, salt, garlic powder, and black pepper. Cook and stir until beef is browned and crumbly, 5 to 7 minutes. Hit Cancel. Pour 1/4 cup water into the pan and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon."
    },
    {
      "position": 2,
      "text": "Layer spaghetti strands on top of meat in a crisscross pattern. Pour marinara sauce over pasta. Pour diced tomatoes over sauce. Pour remaining 3 cups water around sides and on top of tomatoes. Push down lightly with a spatula to make sure water gets through layers and all pasta is covered."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions for 5 minutes. Release remaining pressure carefully using the quick-release method, about 5 minutes. Unlock and remove the lid. Stir spaghetti and meat sauce together well before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

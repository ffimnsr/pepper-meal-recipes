  "id": "eec175fb-95b3-5caa-bfd5-7cae2a8e5f39",
  "slug": "hummus-iii",
  "name": "Hummus III",
  "recipe_type": "appetizer",
  "brief_description": "As a spread, dip or garlicky pita filling, classic hummus is both delicious and satisfying. Best of all, it's whipped up in seconds in a blender or food processor.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place the garbanzo beans, tahini, lemon juice, salt and garlic in a blender or food processor. Blend until smooth. Transfer mixture to a serving bowl."
    },
    {
      "position": 2,
      "text": "Drizzle olive oil over the garbanzo bean mixture. Sprinkle with paprika and parsley."
    }
  ],
  "servings": 16,

  "id": "c26bd0e8-2396-5b47-bc53-ea3e9287ec01",
  "slug": "instant-pot-black-eyed-peas-recipe-8423796",
  "name": "Instant Pot Black-Eyed Peas",
  "recipe_type": "side",
  "brief_description": "These Instant Pot black-eyed peas with lots of bacon don\u2019t require an overnight soak before cooking. Using the pressure function on the Instant pot will ensure fast prep for a dish commonly served on New Year\u2019s Day. Sounds like good luck for the New Year!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse black-eyed peas and set them aside."
    },
    {
      "position": 2,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Add bacon; cook and stir until bacon is evenly browned, about 10 minutes. Stir in minced garlic; cook until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Add rinsed black-eyed peas, water, and chicken broth to the pot; stir to combine. Select Cancel."
    },
    {
      "position": 4,
      "text": "Close and lock the lid. Select high pressure according to manufacturer\u2019s instructions; set timer for 30 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, 10 to 40 minutes. Remove the lid, and add garlic powder, oregano, dill and black pepper. Fluff the mixture and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

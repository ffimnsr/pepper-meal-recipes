  "id": "56519037-a5db-5938-baf2-7dc90cee3135",
  "slug": "bombay-chicken-wings",
  "name": "Curry-Spiced Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "Chicken wings with a light curry flavor will make a nice snack, appetizer, or game day treat.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken wings, vegetable oil, soy sauce, green onion, garlic, curry powder, turmeric, and pepper in a resealable plastic bag. Squeeze out any excess air, seal the bag, and refrigerate for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Spread chicken wings into a large baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until wings are browned, about 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

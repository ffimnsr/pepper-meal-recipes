  "id": "e4c86c19-2b82-5d6d-8360-245f799b92d9",
  "slug": "pasta-with-fennel-and-onions",
  "name": "Pasta with Fennel and Onions",
  "recipe_type": "side",
  "brief_description": "In this pasta with fennel and onions recipe, fennel and linguine are served in a white wine sauce topped with plenty of freshly shaved Parmesan cheese.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut fennel bulbs in half, lengthwise; remove tough cores. Thinly slice fennel bulb halves lengthwise. Slice onions in half lengthwise; thinly slice onions lengthwise."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Add fennel and onions; cook and stir until onions are translucent, about 8 minutes. Add wine; increase heat to medium-high. Cook, stirring often, until wine has nearly evaporated and fennel and onions begin to brown, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Reserve 1/4 cup pasta water. Drain linguine; keep warm."
    },
    {
      "position": 4,
      "text": "Stir tomatoes into fennel mixture; cook until tomatoes soften, about 3 minutes. Stir lemon juice and pine nuts into fennel mixture."
    },
    {
      "position": 5,
      "text": "Stir linguine into fennel mixture; stir in reserved pasta water. Cook over high heat, stirring until hot and thoroughly combined, about 2 minutes. Top servings with Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

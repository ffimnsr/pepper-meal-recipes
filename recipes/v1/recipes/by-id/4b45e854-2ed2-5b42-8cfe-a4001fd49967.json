  "id": "4b45e854-2ed2-5b42-8cfe-a4001fd49967",
  "slug": "easy-lamb-gyros",
  "name": "Easy Lamb Gyros",
  "recipe_type": "main",
  "brief_description": "Just because you don't own a vertical, rotating spit doesn't mean you can't make gyros at home. This recipe makes it easy to enjoy the popular Greek street food at any time!",
  "cuisine": "Turkish American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Spray a large loaf pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine lamb, Greek seasoning, and egg in a bowl. Mix until ingredients are very well combined (overmixing is preferable here.) Firmly press mixture into the prepared loaf pan, making sure there are no air pockets under the meat. Cover with foil."
    },
    {
      "position": 3,
      "text": "Cook in the preheated oven until an instant-read thermometer inserted into the center reads at least 160 degrees F (70 degrees C), about 2 hours."
    },
    {
      "position": 4,
      "text": "Remove from the oven and let rest, covered, until all the grease on top is absorbed, 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove meat from the pan and cut into thin slices."
    },
    {
      "position": 6,
      "text": "Load meat into the center of warmed pitas. Top with lettuce, tomatoes, onion, and tzatziki sauce. Serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "schema_version": 1,
  "id": "111cb5a4-1cb0-5b9e-b8c2-b0213d46e3df",
  "slug": "classic-goulash",
  "name": "Classic Goulash",
  "recipe_type": "soup",
  "brief_description": "This goulash recipe is made on the stovetop with ground beef, tomatoes, herbs, and mararoni for a classic one-pot meal the whole family will enjoy.",
  "cuisine": "Eastern European American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large Dutch oven over medium-high heat. Add onion and cook 3 minutes, stirring often."
    },
    {
      "position": 3,
      "text": "Add ground beef and cook, breaking up the meat until it is evenly browned, about 5 minutes. Add garlic and cook 3 minutes, stirring often."
    },
    {
      "position": 4,
      "text": "Stir in water, tomato sauce, diced tomatoes, soy sauce, Italian seasoning, seasoned salt, and bay leaves. Bring to a simmer, cover and cook 5 minutes, stirring halfway through."
    },
    {
      "position": 5,
      "text": "Stir in uncooked macaroni, cover, and simmer over medium heat until pasta is tender, 11 to 13 minutes, stirring occasionally."
    },
    {
      "position": 6,
      "text": "Remove from heat, discard bay leaves, and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

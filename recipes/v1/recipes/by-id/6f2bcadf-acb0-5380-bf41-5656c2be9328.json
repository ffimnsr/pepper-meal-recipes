  "id": "6f2bcadf-acb0-5380-bf41-5656c2be9328",
  "slug": "bread-machine-thin-crust-pizza-dough",
  "name": "Bread Machine Thin Crust Pizza Dough",
  "recipe_type": "main",
  "brief_description": "This bread machine pizza dough recipe is made with just a few basic pantry ingredients for a large, flavorsome, and chewy pizza crust.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour warm water into the bread machine pan; add flour on top of water. Sprinkle over yeast, salt, and sugar. Set the machine on the dough setting, and push the start button."
    },
    {
      "position": 3,
      "text": "When the machine signals that the dough is finished, transfer dough to a well-floured work surface."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 5,
      "text": "Roll or stretch dough out into a thin crust about 14 inches in diameter, leaving dough thick at the edge. Place dough onto a 14-inch pizza baking sheet; brush dough with olive oil."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 5 minutes; remove and top with desired ingredients before final baking."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 70,

  "id": "93e40951-047b-5649-9be1-93e9e7b790f5",
  "slug": "teriyaki-ground-beef-skillet",
  "name": "Teriyaki Ground Beef Skillet",
  "recipe_type": "dessert",
  "brief_description": "This easy teriyaki ground beef skillet dinner is quick to make for a sweet and savory kid-friendly dinner. Serve with white rice.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Brown ground beef and onions in a large skillet over medium heat, crumbling as it cooks, until the beef is no longer pink and the onion is soft, about 5 minutes. Drain if necessary."
    },
    {
      "position": 2,
      "text": "Add teriyaki sauce, water chestnuts, pineapple, garlic, and ginger to the skillet; stir to combine. Reduce heat and simmer for about 5 minutes."
    },
    {
      "position": 3,
      "text": "Sprinkle with sesame seeds and sliced green onion. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

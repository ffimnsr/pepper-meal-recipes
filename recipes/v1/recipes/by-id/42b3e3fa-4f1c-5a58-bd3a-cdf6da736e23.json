  "id": "42b3e3fa-4f1c-5a58-bd3a-cdf6da736e23",
  "slug": "blaukraut-german-red-cabbage",
  "name": "Blaukraut (German Red Cabbage)",
  "recipe_type": "side",
  "brief_description": "Red cabbage (Blaukraut) is flavored with apples and cider vinegar in this traditional and popular German side dish that's perfect for Christmas.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large stock pot. Add sugar and stir until it has a light caramel color, about 5 minutes. Add onion and apples; cook and stir until the onions start to soften, about 5 minutes. Add cabbage and cook until heated through, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in broth, apple cider vinegar, and salt. Cover and simmer until flavors are well combined, about 30 minutes. Season with salt and pepper and stir in lingonberry jam towards the end of the cooking time if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

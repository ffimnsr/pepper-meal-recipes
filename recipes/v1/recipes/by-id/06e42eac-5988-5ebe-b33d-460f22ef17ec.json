  "id": "06e42eac-5988-5ebe-b33d-460f22ef17ec",
  "slug": "pimento-cheese-deviled-eggs-recipe-8551682",
  "name": "Pimento Cheese Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These pimento cheese deviled eggs put a Southern twist on deviled eggs, a staple at every potluck, church picnic, backyard BBQ, or family get-together. Filling them with a pimento cheese mixture really adds pizzazz to the tried-and-true.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice eggs in half lengthwise and remove yolks."
    },
    {
      "position": 2,
      "text": "Place yolks, cheese, salad dressing, mustard, vinegar, Worcestershire, garlic powder, salt, and pepper in a food processor. Blend until mixture is smooth."
    },
    {
      "position": 3,
      "text": "Fold in pimentos, and scoop or pipe mixture into egg white halves."
    },
    {
      "position": 4,
      "text": "Garnish with pimentos, bacon, and dill, and chill in the refrigerator until ready to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

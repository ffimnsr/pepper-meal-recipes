  "id": "374449ac-f482-5924-8b78-2db4bc9d2dfb",
  "slug": "snickerdoodles-with-a-hint-of-ginger",
  "name": "Snickerdoodles With a Hint of Ginger",
  "recipe_type": "dessert",
  "brief_description": "Based off of Mrs. Sigg's popular recipe for snickerdoodles, this recipe uses all butter and adds a hint of ginger for an extra zing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat 1 1/2 cups sugar, butter, eggs, and vanilla extract together in a large bowl until smooth and creamy."
    },
    {
      "position": 2,
      "text": "Sift all-purpose flour, oat flour, cream of tartar, and baking soda together into a bowl. Beat 1/2 of the flour mixture into butter mixture; and remaining flour mixture and beat until dough is just combined. Cover the bowl with plastic wrap and refrigerate until chilled, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Whisk 2 tablespoons sugar, cinnamon, and ginger together in a shallow bowl."
    },
    {
      "position": 5,
      "text": "Roll chilled dough into 1 1/2-inch balls and roll each ball in cinnamon-sugar mixture to coat. Place coated dough 2-inches apart on prepared baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden and set, 9 to 11 minutes. Cool on the baking sheet for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

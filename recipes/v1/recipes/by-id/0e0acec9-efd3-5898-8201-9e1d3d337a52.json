  "id": "0e0acec9-efd3-5898-8201-9e1d3d337a52",
  "slug": "spritz-cookies-recipe-8415391",
  "name": "Spritz Cookies",
  "recipe_type": "dessert",
  "brief_description": "These spritz cookies are exactly the cookies you remember from your Fancy Aunt, buttery, with just enough almond flavor to bring back the memories. Decorate them with sprinkles, or with an optional drizzled icing, and of course, more sprinkles!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter with an electric mixer in a large bowl for 30 seconds."
    },
    {
      "position": 3,
      "text": "Add sugar, baking powder, and salt. Beat until combined, scraping sides of bowl occasionally. Beat in egg, vanilla, and almond extract until combined."
    },
    {
      "position": 4,
      "text": "Beat in as much of the flour as you can using the mixer. Stir in any remaining flour with a wooden spoon"
    },
    {
      "position": 5,
      "text": "Force room-temperature dough through a cookie press onto ungreased cookie sheets. If desired, sprinkle cookies with colored sugar or nonpareils."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are firm but not brown, 6 to 8 minutes. Transfer to wire racks to cool completely."
    },
    {
      "position": 7,
      "text": "For powdered sugar icing, combine powdered sugar, milk, and vanilla in a small bowl. If necessary, add more milk, 1 teaspoon at a time, to make icing drizzling consistency."
    },
    {
      "position": 8,
      "text": "If desired, drizzle cooled cookies with powdered sugar icing and decorate with sprinkles."
    }
  ],
  "servings": 72,

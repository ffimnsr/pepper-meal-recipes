  "id": "fa180291-9cf4-5f1a-9df2-59f71fda296d",
  "slug": "light-and-fresh-mexican-gazpacho",
  "name": "Light and Fresh Mexican Gazpacho",
  "recipe_type": "soup",
  "brief_description": "This light and fresh cold Mexican gazpacho soup recipe includes cucumbers, avocados, bell peppers, and cilantro in a tomato base with a hint of spiciness.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomato and claim juice cocktail, tomato-vegetable juice cocktail, celery, avocados, bell peppers, cucumbers, hot pepper sauce, green onions, cilantro, red onion, red wine vinegar, lemon juice, minced garlic, and garlic powder in a large nonreactive bowl; season with salt and black pepper. Refrigerate to blend flavors, at least 6 hours."
    }
  ],
  "servings": 10,

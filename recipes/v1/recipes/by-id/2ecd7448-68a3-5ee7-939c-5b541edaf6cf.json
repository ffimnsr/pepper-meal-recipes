  "id": "2ecd7448-68a3-5ee7-939c-5b541edaf6cf",
  "slug": "turkey-in-a-bag",
  "name": "Turkey in a Bag",
  "recipe_type": "main",
  "brief_description": "Cooking turkey in a bag is easy with this recipe. Your Thanksgiving turkey will be perfectly moist and tender when done. Plus, cleanup is a snap!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove and discard giblets."
    },
    {
      "position": 4,
      "text": "Rinse turkey and pat dry."
    },
    {
      "position": 5,
      "text": "Season turkey with salt and pepper."
    },
    {
      "position": 6,
      "text": "Sprinkle the bottom of the turkey bag with flour."
    },
    {
      "position": 7,
      "text": "Place turkey in the bag and add celery and onions."
    },
    {
      "position": 8,
      "text": "Seal the bag and transfer into a roasting pan; poke several holes in the bag with a fork."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until turkey is cooked and the juices run clear, about 3 to 3 1/2 hours. An instant-read thermometer inserted into the thigh meat should read 180 degrees F (85 degrees C)."
    },
    {
      "position": 10,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 15,

  "id": "e03a9507-e659-5491-83fb-0dbfec2ea995",
  "slug": "honey-chicken",
  "name": "Honey Chicken",
  "recipe_type": "main",
  "brief_description": "A tinge of curry and paprika color this orange-honey chicken marinade.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "To Marinate: In a nonporous glass dish or bowl, combine the orange juice, lemon juice, oil, honey, salt, pepper, curry powder and paprika. Mix well, then add chicken breasts and toss to coat. Cover dish and refrigerate to marinate overnight."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove chicken from marinade, discarding of any remaining marinade, and place in a lightly greased 9x13 inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for about 20 to 25 minutes, or until chicken is cooked through and juices run clear."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

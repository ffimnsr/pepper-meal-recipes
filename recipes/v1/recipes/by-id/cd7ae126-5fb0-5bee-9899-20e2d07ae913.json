  "slug": "red-cabbage-slaw",
  "name": "Red Cabbage Slaw",
  "recipe_type": "salad",
  "brief_description": "This red cabbage slaw made with sliced red cabbage, grated carrots, and walnuts tossed in a creamy dressing makes a colorful, crunchy side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cabbage, carrot, mayonnaise, cranberries, walnuts, milk, cider vinegar, and sugar in a bowl; stir well. For best flavor results, cover and refrigerate until chilled."
    }
  ],

  "id": "96b472c2-b657-5bf2-91eb-bbe130c22f62",
  "slug": "air-fryer-pizookie-recipe-7501307",
  "name": "Air Fryer Pizookie",
  "recipe_type": "dessert",
  "brief_description": "No oven or cast iron pan needed for this air fryer pizookie! Enjoy a chocolate chip mega-cookie with this easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 360 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Get a large piece of aluminum foil and fold it into an 8x8-inch square. You can make a little dish out of the foil by folding the edges upward."
    },
    {
      "position": 3,
      "text": "Place 1 piece of cookie dough in the middle of your foil. Arrange remaining cookie dough pieces around it in a pattern similar to the 5-side of a die."
    },
    {
      "position": 4,
      "text": "Bake cookie in the air fryer for 6 minutes. Open the air fryer and gently push down the top of the cookie; continue to bake until deep golden brown, 2 to 4 minutes more."
    },
    {
      "position": 5,
      "text": "Add gelato, whipped cream, and a drizzle of melted chocolate, and enjoy!"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

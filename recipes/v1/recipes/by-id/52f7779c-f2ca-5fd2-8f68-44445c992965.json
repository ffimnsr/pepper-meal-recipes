  "slug": "turkey-wings-with-yellow-rice",
  "name": "Slow Cooker Turkey Wings with Yellow Rice",
  "recipe_type": "main",
  "brief_description": "This slow cooker turkey wings with yellow rice recipe is budget-friendly and easy. Turkey wings simmer all day in seasoned gravy for a creamy comfort dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place turkey wings, cream of mushroom soup, salt, black pepper, garlic powder, and seasoned salt in a 6-quart slow cooker. Add enough water to cover; stir to combine."
    },
    {
      "position": 2,
      "text": "Cover slow cooker. Cook on High for 6 hours or Low for 8 hours."
    },
    {
      "position": 3,
      "text": "Stir rice into slow cooker; continue cooking until rice is tender, 15 to 20 minutes more."
    }
  ],
  "servings": 6,

  "id": "55301119-20f3-5503-a088-73967ef02f2c",
  "slug": "fried-rice-restaurant-style",
  "name": "Easy Fried Rice",
  "recipe_type": "side",
  "brief_description": "This fried rice recipe with leftover rice, peas, eggs, soy sauce, and carrots is ready in minutes and easy to customize for a delicious side dish or main.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Assemble ingredients."
    },
    {
      "position": 2,
      "text": "Place carrots in a small saucepan and cover with water. Bring to a low boil and cook for 3 to 5 minutes. Stir in peas, then immediately drain in a colander."
    },
    {
      "position": 3,
      "text": "Heat a wok over high heat. Pour in vegetable oil, then stir in carrots, peas, and garlic; cook for about 30 seconds. Add eggs; stir quickly to scramble eggs with vegetables."
    },
    {
      "position": 4,
      "text": "Stir in cooked rice. Add soy sauce and toss rice to coat. Drizzle with sesame oil and toss again."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

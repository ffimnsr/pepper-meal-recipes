  "id": "2945dbdf-bd90-528c-88cf-e340262b976f",
  "slug": "lemon-ricotta-pancakes",
  "name": "Lemon Ricotta Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These fluffy lemon ricotta pancakes are made from scratch using Chef John's recipe for delicious, soft, and tender pancakes with bright zesty flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk cold water and baking soda in a mixing bowl. Add ricotta cheese, egg, lemon zest, vegetable oil, sugar, and vanilla; whisk until smooth, breaking up any lumps of cheese as you mix."
    },
    {
      "position": 2,
      "text": "Whisk in 1 cup plus 2 tablespoons self-rising flour, melted butter, and lemon juice until most of flour disappears into batter. Let batter sit at room temperature for 15 minutes."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle over medium-high heat."
    },
    {
      "position": 4,
      "text": "Drop batter by large spoonfuls onto the hot griddle and cook until bubbles form and the edges are dry, 2 to 3 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

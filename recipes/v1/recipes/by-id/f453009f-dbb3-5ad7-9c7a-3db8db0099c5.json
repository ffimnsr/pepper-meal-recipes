  "id": "f453009f-dbb3-5ad7-9c7a-3db8db0099c5",
  "slug": "mock-chopped-liver",
  "name": "Mock Chopped Liver",
  "recipe_type": "appetizer",
  "brief_description": "Delicious mock chopped liver made with tender ground lentils, soft onion, and walnuts for a vegetarian appetizer that tastes just like the real thing!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water, lentils, and bouillon cubes in a pot; cover and simmer over medium heat until tender, about 30 minutes. Drain well."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat; add onion and saut\u00e9 until soft and translucent."
    },
    {
      "position": 3,
      "text": "Blend cooked lentils, onions, and walnuts in a food processor until it reaches the desired consistency for p\u00e2t\u00e9. Season to taste with salt and pepper. Chill before serving."
    }
  ],
  "servings": 4,

  "id": "6fadd764-4fba-552b-a0df-72b9047b5dd3",
  "slug": "3-ingredient-shortbread-cookies",
  "name": "3-Ingredient Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These melt in your mouth. The secret is in the beating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C.)"
    },
    {
      "position": 2,
      "text": "Combine butter or margarine, flour, and confectioners' sugar; beat for 10 minutes."
    },
    {
      "position": 3,
      "text": "Drop spoonfuls of dough 2 inches apart onto an ungreased cookie sheet. Decorate with maraschino cherry pieces."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 to 18 minutes or until bottoms are lightly browned."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,

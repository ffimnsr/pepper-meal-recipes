  "id": "dd7346a0-6b74-54bc-acd7-9923d2fffe40",
  "slug": "quick-and-easy-ginger-chicken-and-cabbage-salad-recipe-11970252",
  "name": "Quick and Easy Ginger Chicken and Cabbage Salad",
  "recipe_type": "salad",
  "brief_description": "This quick and easy chicken and cabbage salad comes together with a few smart shortcuts for those days when you don\u2019t have time to make everything from scratch. Tossed with a flavorful ginger dressing, crunchy almonds, and fresh herbs, it\u2019s a crunchy, satisfying salad that\u2019s hearty enough for a main dish.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare chicken tenders according to the package instructions. If using the air fryer, it will take about 13 minutes, or in the microwave on High, about 4 minutes. Allow to cool, cut into bite-sized pieces, and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, for salad, combine coleslaw mix, cilantro, basil, mint, and sliced almonds in a large salad bowl. Reserve about 3 tablespoons sliced green onions, and add the rest to the salad."
    },
    {
      "position": 3,
      "text": "Toss ingredients with salad dressing, and adjust quantity to taste."
    },
    {
      "position": 4,
      "text": "Top the salad with prepared, cut-up chicken, reserved green onions, and sesame seeds. Serve immediately."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

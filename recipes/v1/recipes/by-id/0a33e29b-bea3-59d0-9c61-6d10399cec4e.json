  "id": "0a33e29b-bea3-59d0-9c61-6d10399cec4e",
  "slug": "eggy-veggie-bake",
  "name": "Eggy Veggie Bake",
  "recipe_type": "breakfast",
  "brief_description": "Seasoned sauteed vegetables are topped with eggs and cheese and baked. It's that simple, and it is delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray an 8x8 inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat the olive oil in a skillet over medium-high heat. Place zucchini, green onions, onion, tomatoes, mushrooms, and spinach in the skillet. Sprinkle with lemon juice, Worcestershire sauce, and hot sauce. Season with garlic powder, salt, and pepper. Cook until tender. Transfer to the prepared baking dish. Pour egg substitute over the vegetables in the dish. Top with cheese."
    },
    {
      "position": 3,
      "text": "Bake 20 minutes in the preheated oven, or until egg substitute is set and cheese is melted. Cut with a spatula and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

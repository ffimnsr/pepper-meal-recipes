  "schema_version": 1,
  "id": "533ad278-6115-5250-87d1-8754bb6df16d",
  "slug": "oven-bag-pot-roast",
  "name": "Oven Bag Pot Roast",
  "recipe_type": "main",
  "brief_description": "This oven bag pot roast with mushrooms, carrots, onions, and a flavorsome gravy produces tender and juicy results for a crowd-pleasing main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, paprika, garlic powder, onion powder, and black pepper together in a bowl. Dredge roast in flour mixture to evenly coat."
    },
    {
      "position": 3,
      "text": "Melt butter in a large pot over medium-high heat; brown roast in melted butter, about 5 minutes per side. Transfer roast to an oven bag and place into a 9x13-inch casserole dish."
    },
    {
      "position": 4,
      "text": "Whisk condensed beef consomme, water, garlic, onion soup mix, and Worcestershire sauce together in a bowl; pour into the oven bag over the roast. Seal the bag and cut 6 small slits in the top of the oven bag for ventilation."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour 45 minutes; add carrots, mushrooms, and onion to the oven bag and bake until vegetables are tender and roast is cooked through, about 45 minutes more. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

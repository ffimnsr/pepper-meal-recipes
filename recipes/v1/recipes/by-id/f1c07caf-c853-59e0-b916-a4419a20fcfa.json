  "id": "f1c07caf-c853-59e0-b916-a4419a20fcfa",
  "slug": "4-ingredient-bacon-ranch-cheese-ball",
  "name": "4-Ingredient Bacon Ranch Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "You only need 4 ingredients for this easy bacon ranch cheese ball. Serve with tortilla chips or crackers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Transfer bacon strips to a lined baking sheet with a drip tray. Refrigerate bacon until crisp."
    },
    {
      "position": 2,
      "text": "In a bowl spread out cream cheese and sprinkle ranch seasoning over the cheese. Blend together until well combined."
    },
    {
      "position": 3,
      "text": "Chop bacon until it resembles fine crumbs. Reserve 2 tablespoons. Add remaining bacon to the cream cheese mixture. Using clean (gloved) hands roll cream cheese mixture into a ball. Refrigerate for 30 minutes"
    },
    {
      "position": 4,
      "text": "Combine chopped pecans and reserved bacon in a small bowl. Cover cream cheese ball with pecan bacon mixture. Refrigerate until ready to serve. Let come to room temperature about 30 minutes before serving."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

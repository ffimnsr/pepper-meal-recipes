  "id": "70090ef4-9620-58af-b2b5-16d791d8c40b",
  "slug": "poppyseed-dressing",
  "name": "Poppy Seed Dressing",
  "recipe_type": "salad",
  "brief_description": "This poppy seed dressing is slightly thick, sweet, and tangy. It's easy to make in minutes and is a wonderful complement to almost any salad!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place vinegar, sugar, onion, mustard, and salt into a blender or food processor; blend for 20 seconds. With the blender running, gradually add oil in a thin steady stream until combined."
    },
    {
      "position": 3,
      "text": "Transfer dressing to a bowl and stir in poppy seeds."
    }
  ],
  "servings": 14,

  "id": "54ee3ea0-e210-5df5-a96d-89963bbc67a1",
  "slug": "chili-crisp-peanut-noodle-salad-recipe-12027341",
  "name": "Chili Crisp Peanut Noodle Salad",
  "recipe_type": "salad",
  "brief_description": "This chili crisp peanut noodle salad is a cold noodle salad, fragrant with ginger and garlic. The heat from comes from chili crisp, which you can adjust to your taste. You can also add cooked shrimp or chicken if you\u2019d like to serve it as a main dish.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to boil. Add bucatini and cook until tender with a bite, about 10 minutes, or according to package directions for al dente. Drain well and let cool for a few minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, for sauce, whisk peanut butter, soy sauce, balsamic vinegar, rice vinegar, garlic paste, ginger paste, sesame oil, boiling water, and chili crisp together in a large bowl until combined. Taste; add more of the chili crisp if desired."
    },
    {
      "position": 3,
      "text": "Rinse noodles with cold water, then allow to sit in cold water for a few moments. Drain noodles thoroughly, then add to the bowl with dressing."
    },
    {
      "position": 4,
      "text": "Top noodles with cucumber and green onions. Mix thoroughly until well incorporated. Cover bowl with plastic wrap and refrigerate for at least one hour before serving. Garnish with green onion and sesame seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

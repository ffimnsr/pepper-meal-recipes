  "id": "85049d85-74b9-5b30-bf19-ea8b0b79f329",
  "slug": "stained-glass-gelatin-cake",
  "name": "Stained Glass Gelatin Cake",
  "recipe_type": "salad",
  "brief_description": "This colorful no-cook stained glass gelatin cake combines cubes of rainbow Jell-O with creamy white gelatin for a fun, retro dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour each gelatin mix into a separate bowl. Pour 1/2 cup boiling water into one bowl and stir until gelatin is completely dissolved, about 2 minutes; stir in 1/2 cup cold water. Repeat to dissolve remaining gelatin colors. Refrigerate all bowls until completely set, 4 hours to overnight."
    },
    {
      "position": 2,
      "text": "Spray a 9-inch cake pan with cooking spray."
    },
    {
      "position": 3,
      "text": "Remove gelatin from the refrigerator and slice each color into cubes. Transfer cubes to a bowl and gently toss together to mix colors randomly. Transfer into the prepared pan."
    },
    {
      "position": 4,
      "text": "Pour remaining 1 cup cold water into a bowl and sprinkle unflavored gelatin over top; let sit until dissolved, 2 to 3 minutes. Add remaining 1 cup boiling water and stir until gelatin is completely dissolved."
    },
    {
      "position": 5,
      "text": "Combine condensed milk, cream, gelatin mixture, and vanilla in a blender. Blend until smooth and well mixed, about 30 seconds. Pour evenly over gelatin cubes in the cake pan. Use a spatula to evenly distribute milk mixture."
    },
    {
      "position": 6,
      "text": "Refrigerate until set, 4 hours to overnight."
    },
    {
      "position": 7,
      "text": "Run a knife along the sides of the cake pan and carefully invert cake onto a plate."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

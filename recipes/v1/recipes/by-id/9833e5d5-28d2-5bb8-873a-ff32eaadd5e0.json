  "id": "9833e5d5-28d2-5bb8-873a-ff32eaadd5e0",
  "slug": "skillet-strawberry-shortcake",
  "name": "Skillet Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This impressive strawberry shortcake made in a pan features one giant biscuit-style shortcake, topped with sweetened strawberries and fluffy cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 10-inch cast iron skillet; line the bottom with a round of parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, and salt for shortcake together in a large mixing bowl. Whisk buttermilk, egg yolk, and vanilla together in a glass measuring cup until evenly combined; set aside."
    },
    {
      "position": 3,
      "text": "Scatter the butter pieces over the flour mixture. Use a rubbing motion with your fingertips and cut the butter into the flour mixture to distribute. Create a well in the center of the flour mixture. Pour the buttermilk mixture into the center of the well. Use a rubber spatula to mix the flour into the buttermilk mixture to form a moist, shaggy dough."
    },
    {
      "position": 4,
      "text": "Transfer the dough to the prepared skillet. Smooth the dough to distribute evenly in the pan. Press the sliced strawberries gently into the surface."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown and baked through, 25 to 30 minutes. Cool for 10 minutes."
    },
    {
      "position": 6,
      "text": "To prepare the topping, stir together the quartered strawberries, sugar, and lemon zest in a medium mixing bowl to macerate."
    },
    {
      "position": 7,
      "text": "To prepare the whipped cream, combine whipping cream, sugar, and vanilla in a chilled mixing bowl. Using an electric mixer fitted with a whisk attachment, beat at medium speed until soft peaks form."
    },
    {
      "position": 8,
      "text": "Spoon the strawberries and juices over the shortcake. Serve with whipped cream."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

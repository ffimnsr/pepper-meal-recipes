  "id": "9a1a60fd-a94e-52de-890e-8f8f97a06869",
  "slug": "lithuanian-saltibarsciai-cold-beet-soup",
  "name": "Lithuanian \u0160altibar\u0161\u010diai (Cold Beet Soup)",
  "recipe_type": "soup",
  "brief_description": "Try this old family recipe for Lithuanian \u0161altibar\u0161\u010diai in summer for a cold, creamy, purply-pink borscht that's as refreshing as it is beautiful.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs into a saucepan in a single layer and cover with water by 1 inch. Cover the saucepan and bring to a boil. Remove from the heat and let eggs stand in hot water for 15 minutes. Drain, then run under cold water to cool."
    },
    {
      "position": 2,
      "text": "Peel and chop eggs; place into a large bowl. Add buttermilk, beets, cucumber, dill, and chives; stir gently to combine. Chill in the refrigerator for 24 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a3ff83bb-2d9e-522d-b046-39bca13071e5",
  "slug": "strawberry-rhubarb-crumble-recipe-11724393",
  "name": "Strawberry Rhubarb Crumble",
  "recipe_type": "dessert",
  "brief_description": "This strawberry rhubarb crumble has a superb balance of sweet and tart and a crumble that delivers both a hint of lemon zest and the rich flavor of almonds. Served warm or at room temperature, with vanilla ice cream or whipped cream, it's the ultimate spring dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "For topping, stir together flour, almonds, 3/4 cup sugar, melted butter, lemon zest, and 1/4 teaspoon salt in a medium bowl until clumps form. Cover and chill topping while preparing filling."
    },
    {
      "position": 3,
      "text": "For filling, combine strawberries and rhubarb in a very large bowl. In a small bowl stir together remaining 1 cup sugar, cornstarch, and salt; add to fruit and toss well to combine."
    },
    {
      "position": 4,
      "text": "Transfer filling to a 3-quart rectangular baking dish. If using frozen fruit, let fruit mixture stand for 45 minutes at room temperature."
    },
    {
      "position": 5,
      "text": "Cover filling with topping."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until fruit is bubbly in the center and topping is golden, about 1 hour (1 1/2 hours if using frozen fruit). If topping is browning too quickly, cover with foil during the last 30 minutes of baking time."
    },
    {
      "position": 7,
      "text": "Let stand for 30 minutes before serving. Serve warm or at room temperature. If desired, serve with whipped cream or ice cream."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

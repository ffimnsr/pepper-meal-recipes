  "id": "0187ff86-d3b3-5051-b394-6dc048da4135",
  "slug": "apple-cider-cranberry-sauce",
  "name": "Apple Cider Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "Apple cider, a hint of orange, and warm spices make this cranberry sauce very special indeed.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the apple cider, sugar, cinnamon sticks, orange zest, and cloves in a large saucepan. Bring to a boil over high heat. Turn heat to low; simmer until sugar is dissolved and the flavors are blended, 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir cranberries into the saucepan, turn heat to high, and bring to a boil. Cook, stirring constantly, until cranberries begin to pop, 5 to 10 minutes. Reduce heat to low, and cook until sauce begins to thicken, about 5 minutes. Remove cinnamon sticks and cloves. Pour into shallow dish to cool and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

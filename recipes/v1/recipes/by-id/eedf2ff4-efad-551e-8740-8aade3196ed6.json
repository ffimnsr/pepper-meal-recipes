  "id": "eedf2ff4-efad-551e-8740-8aade3196ed6",
  "slug": "cheese-wafers",
  "name": "Cheese Wafers",
  "recipe_type": "appetizer",
  "brief_description": "The secret ingredients in this cheese wafers recipe are pungent spices like red pepper flakes and hot pepper sauce, along with crunchy chopped pecans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend together butter and flour in a medium bowl. Mix in Cheddar cheese, salt, red pepper flakes, hot pepper sauce, and pecans. Form dough into a roll and wrap in parchment paper. Refrigerate dough 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Slice dough into very thin wafers and place onto a baking tray."
    },
    {
      "position": 4,
      "text": "Bake wafers in the preheated oven until crisp, 15 to 20 minutes."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

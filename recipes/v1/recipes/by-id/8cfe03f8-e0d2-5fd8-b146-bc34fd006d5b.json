  "id": "8cfe03f8-e0d2-5fd8-b146-bc34fd006d5b",
  "slug": "mini-sweet-potato-samosas",
  "name": "Mini Sweet Potato Samosas",
  "recipe_type": "appetizer",
  "brief_description": "These attractive little samosas of curried sweet potatoes make a nice appetizer or cocktail party hors d'oeuvre!",
  "cuisine": "Indian Inspired American Middle Eastern Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Simmer sweet potatoes with a little water until very soft. Drain, and mash with butter, milk, onion soup mix, and curry powder."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Place about 1 teaspoon of the sweet potato mixture into the center of each wonton wrapper. Brush two adjacent edges of wrapper with water, fold into a triangle, and press the edges together to seal. Brush both sides with sesame oil. Place the samosas on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 10 minutes, then turn over, and bake for 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

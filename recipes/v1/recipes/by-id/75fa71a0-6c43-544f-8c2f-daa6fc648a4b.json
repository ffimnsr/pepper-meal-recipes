  "id": "75fa71a0-6c43-544f-8c2f-daa6fc648a4b",
  "slug": "raspberry-jalapeno-jelly",
  "name": "Raspberry Jalape\u00f1o Jelly",
  "recipe_type": "side",
  "brief_description": "Homemade raspberry pepper jam made with fresh or frozen raspberries, and bell peppers is livened up with spicy jalape\u00f1o peppers.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Sterilize jars and lids by immersing in boiling water for at least 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine raspberries, bell pepper, and jalape\u00f1o peppers with sugar and cider vinegar in a saucepan. Bring to a boil over medium-high heat, and boil rapidly for 1 minute. Remove from heat and let stand for 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in the liquid pectin, and run the mixture through a strainer to remove bits of peppers. Pour the strained liquid into sterilized jars, and seal. Store in a cool dark place. Refrigerate after opening."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

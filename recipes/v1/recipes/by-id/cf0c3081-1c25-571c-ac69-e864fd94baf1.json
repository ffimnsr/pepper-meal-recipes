  "id": "cf0c3081-1c25-571c-ac69-e864fd94baf1",
  "slug": "sweetest-southern-sweet-potato-pie",
  "name": "Sweetest Southern Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "In this sweetest Southern sweet potato pie recipe, sweet potatoes are whipped until light and fluffy. Serve the pie warm or cold with whipped cream.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking dish with aluminum foil."
    },
    {
      "position": 2,
      "text": "Place sweet potatoes in the prepared baking dish. Bake in the preheated oven until easily pierced with a fork and skins loosen, 30 to 45 minutes. Cool potatoes, then peel and discard skins. Transfer potato flesh to a bowl."
    },
    {
      "position": 3,
      "text": "Mash potatoes with a potato masher. Beat in sugar, evaporated milk, butter, corn syrup, eggs, flour, vanilla extract, apple pie spice, and salt with an electric mixer until fluffy, about 5 minutes. Pour sweet potato batter into pie crust. Excess batter can be reserved for another use."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until pie is set and crust is browned, 45 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

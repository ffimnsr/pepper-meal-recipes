  "id": "8ebdef5d-0f9b-58ff-8fee-b4aa1833da50",
  "slug": "4-ingredient-pesto-tortellini-bake-recipe-11748620",
  "name": "4-Ingredient Pesto Tortellini Bake",
  "recipe_type": "salad",
  "brief_description": "This 4-ingredient pesto tortellini bake packs a lot of flavor for very little effort\u2014a package of tri-color cheese tortellini, a smidge of prosciutto, prepared pesto, and shredded mozzarella are all you need. It's a nice weeknight baked pasta to serve with a green salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until tortellini float to the top and the filling is hot, about 3 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Stir tortellini, prosciutto, pesto, and 1/2 cup mozzarella together in a large bowl."
    },
    {
      "position": 4,
      "text": "Pour into a baking dish. Sprinkle remaining mozzarella over the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and golden, about 10 minutes. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

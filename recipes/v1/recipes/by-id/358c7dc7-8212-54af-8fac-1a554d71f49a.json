  "id": "358c7dc7-8212-54af-8fac-1a554d71f49a",
  "slug": "buffalo-chicken-sliders-recipe-8417946",
  "name": "Buffalo Chicken Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These Buffalo chicken sliders with shredded chicken smothered in Buffalo sauce baked on Hawaiian rolls with cheese are great for a game-day crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a large-rimmed baking sheet with aluminum foil; lightly coat with cooking spray. Cut rolls in half horizontally, using a serrated bread knife, keeping top halves and bottom halves intact; place bottom rolls, cut-sides up, on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Sprinkle ¾ cup cheese evenly over bottom rolls."
    },
    {
      "position": 4,
      "text": "Combine warmed chicken, hot sauce, ranch dressing, and 3 tablespoons ranch dressing mix in a large bowl until evenly coated."
    },
    {
      "position": 5,
      "text": "Top bottom rolls evenly with chicken mixture; sprinkle with remaining ¾ cup cheese."
    },
    {
      "position": 6,
      "text": "Place top rolls over cheese, cut-sides down; brush tops and sides with melted butter. Sprinkle tops of rolls evenly with remaining ½ tablespoon ranch dressing mix."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted, tops of rolls are golden brown, and chicken mixture is heated through, about 10 minutes. Cut into 12 sliders; serve immediately. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

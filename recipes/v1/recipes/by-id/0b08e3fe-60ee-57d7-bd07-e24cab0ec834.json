  "id": "0b08e3fe-60ee-57d7-bd07-e24cab0ec834",
  "slug": "korean-bbq-sauce",
  "name": "Korean BBQ Sauce",
  "recipe_type": "side",
  "brief_description": "This homemade Korean BBQ sauce is easy to make with brown sugar, vinegar, soy sauce, ginger, and Korean gochujang hot pepper paste for a fiery kick!",
  "cuisine": "Korean Inspired Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir soy sauce, brown sugar, garlic, rice wine vinegar, gochujang paste, black pepper or gochugara chili powder, ginger, and sesame oil together in a saucepan; bring to a boil."
    },
    {
      "position": 3,
      "text": "Whisk cornstarch and water together in a small bowl until cornstarch dissolves. Whisk cornstarch mixture into the boiling soy sauce mixture."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium-low and cook, stirring constantly, until sauce is thickened, about 3 to 5 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "c7be1c0e-26c3-5e20-a01d-623de1bdf27e",
  "slug": "cowgirl-candy-candied-jalapenos-and-pineapple-recipe-11968468",
  "name": "Cowgirl Candy (Candied Jalape\u00f1os and Pineapple)",
  "recipe_type": "dessert",
  "brief_description": "From TikTok's Trazia Rae, this cowgirl candy is even better than candied jalape\u00f1os. Fresh pineapple and jalape\u00f1os are pickled in a sweet vinegar for a tart, fruity, hot, can't-stop-eating treat.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vinegar, brown sugar, white sugar, salt, turmeric, garlic powder, and red pepper in a saucepan and bring to a boil, stirring frequently. Boil for 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Add jalapeno slices and return to a boil. Reduce heat slightly and simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove jalapenos with a slotted spoon and set aside. Return sugar mixture to a boil and cook until slightly thickened, 6 to 8 minutes. Let cool completely."
    },
    {
      "position": 4,
      "text": "Add jalapenos and pineapple alternately to a jar or glass container fitted with a lid. Pour cooled sugar mixture over the top and seal the jar. Let stand until completely cooled. Cover and refrigerate at least 4 hours before serving. Refrigerate for up to 1 month."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

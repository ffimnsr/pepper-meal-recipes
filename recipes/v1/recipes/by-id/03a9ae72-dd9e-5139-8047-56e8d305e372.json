  "id": "03a9ae72-dd9e-5139-8047-56e8d305e372",
  "slug": "the-ultimate-brunch-casserole-recipe-8624537",
  "name": "The Ultimate Brunch Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This easy casserole combines spicy chorizo, sour cream, cheddar cheese, eggs, and frozen hash browns. It's an easy, creamy breakfast or brunch that everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-by-13-inch baking dish. Spread hash browns over the bottom of the baking dish."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat. Add chorizo and onion, using a flat wooden spoon to break up the meat into smaller pieces. Cook until browned, about 8 to 10 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Whisk eggs, 2 cups Cheddar cheese, 1 cup sour cream, milk, salt, and pepper in a large bowl. Stir in chorizo mixture."
    },
    {
      "position": 5,
      "text": "Pour egg mixture over hash browns in baking dish. Dollop remaining 1/2 cup sour cream over eggs, and sprinkle with remaining 1 cup cheese."
    },
    {
      "position": 6,
      "text": "Bake for 35 to 45 minutes, until just set in the center. Sprinkle with green onions, avocado, and pickled jalape\u00f1os, if using. Cut into squares and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

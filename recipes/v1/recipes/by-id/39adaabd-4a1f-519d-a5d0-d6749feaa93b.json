{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "39adaabd-4a1f-519d-a5d0-d6749feaa93b",
  "slug": "grandma-minnies-old-fashioned-sugar-cookies",
  "name": "Grandma Minnie's Old-Fashioned Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "These old-fashioned sugar cookies are soft, buttery, and lightly golden\u2014easy to roll, cut, and decorate for any holiday.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C) ."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, salt, and sugar in a large bowl until combined. Cut butter into flour mixture with two knives or a pastry blender until mixture resembles coarse crumbs, about 2 minutes. Stir in egg, cream, and vanilla until dough comes together and forms a soft ball, about 1 minute. Chill dough for 30 minutes, if desired, to make rolling easier."
    },
    {
      "position": 3,
      "text": "Roll dough on a floured surface to 1/8-inch thickness. Sprinkle lightly with sugar. Cut into desired shapes using cookie cutters. Transfer cookies to ungreased baking sheets, spacing 1 inch apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are lightly golden, about 6 to 8 minutes. Cool cookies briefly on the pan for 2 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 78,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

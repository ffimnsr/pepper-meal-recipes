  "id": "7cf4e889-4765-57f2-b38b-c55961674d23",
  "slug": "peppys-pita-bread",
  "name": "Peppy's Pita Bread",
  "recipe_type": "main",
  "brief_description": "It's easy to make homemade pita-style bread in your own oven using this easy-to-follow recipe.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place all ingredients in bread pan of your bread machine, select Dough setting and start. When dough has risen long enough, machine will beep."
    },
    {
      "position": 2,
      "text": "Turn dough onto a lightly floured surface. Gently roll and stretch dough into a 12 inch rope. With a sharp knife, divide dough into 8 pieces. Roll each into a smooth ball. With a rolling pin, roll each ball into a 6 to 7 inch circle. Set aside on a lightly floured countertop. cover with a towel. Let pitas rise about 30 minutes until slightly puffy."
    },
    {
      "position": 3,
      "text": "Preheat oven to 500 degrees F (260 degrees C). Place 2 or 3 pitas on a wire cake rack. Place cake rack directly on oven rack. Bake pitas 4 to 5 minutes until puffed and tops begin to brown. Remove from oven and immediately place pitas in a sealed brown paper bag or cover them with a damp kitchen towel until soft. Once pitas a softened, either cut in half or split top edge for half or whole pitas. They can be stored in a plastic bag in the refrigerator for several days or in the freezer for 1 or 2 months."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "69211596-63a2-5a67-9440-fc4192d4461f",
  "slug": "buffalo-chicken-mac-and-cheese",
  "name": "Buffalo Chicken Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This Buffalo chicken mac and cheese made with three kinds of cheese is rich and spicy, and great served as a quick-and-easy weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in the boiling water, stirring occasionally until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Cut wings and legs off rotisserie chicken. Remove skin and bones from wings and legs; chop or shred dark meat into bite-sized pieces."
    },
    {
      "position": 3,
      "text": "Melt butter in a large Dutch oven over medium heat. Gradually whisk in flour until a thick paste forms. Cook until golden, about 1 minute."
    },
    {
      "position": 4,
      "text": "Pour in milk, whisking constantly, until thickened and bubbling, about 5 minutes. Continue to cook and stir until sauce is smooth, about 1 minute more. Reduce heat and season with pepper."
    },
    {
      "position": 5,
      "text": "Stir Cheddar and Monterey Jack into the sauce until melted and combined."
    },
    {
      "position": 6,
      "text": "Stir in hot sauce to the desired level of spiciness."
    },
    {
      "position": 7,
      "text": "Add Gorgonzola, chicken, and macaroni; mix well to combine."
    },
    {
      "position": 8,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "aea36778-3c99-5ce3-ac4d-fe52b793c0a1",
  "slug": "gingerbread-dip-recipe-11890638",
  "name": "Gingerbread Dip",
  "recipe_type": "appetizer",
  "brief_description": "This gingerbread dip is a quick-and-easy small bite option to a heavy cheesecake or big dessert. Good dippers are graham crackers, gingersnaps, vanilla wafers, sugar cookies, and even strawberries and apple wedges.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cream cheese in a bowl; add ginger, cinnamon, cloves, and salt, and beat with an electric mixer until light and fluffy."
    },
    {
      "position": 2,
      "text": "Add marshmallow fluff and molasses and blend until creamy and smooth. Fold in gingersnap cookie crumbs until well combined."
    },
    {
      "position": 3,
      "text": "Store in an airtight container in the refrigerator, and serve with your favorite cookies or fruits."
    }
  ],
  "servings": 8,

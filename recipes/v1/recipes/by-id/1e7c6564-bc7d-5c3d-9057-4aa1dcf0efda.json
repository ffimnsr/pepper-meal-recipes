  "id": "1e7c6564-bc7d-5c3d-9057-4aa1dcf0efda",
  "slug": "street-market-fried-quesadillas",
  "name": "Street-Market Fried Quesadillas",
  "recipe_type": "main",
  "brief_description": "Corn tortillas are filled with a mixture of roast beef hash, peppers, onions, and cheese, and then pan fried until golden and crispy.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium heat. Add olive oil. Cook and stir onions and red bell pepper until starting to soften, about 3 minutes. Add corn and serrano pepper; cook 2 to 3 minutes. Add garlic and cook 1 minute more."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium-low. Add HORMEL\u00ae MARY KITCHEN\u00ae Roast Beef Hash and chipotle pepper. Cook until the hash is heated and well mixed with the rest of the ingredients, about 2 or 3 minutes."
    },
    {
      "position": 3,
      "text": "Heat tortillas in a skillet, turning once, until they are soft and can be folded without breaking."
    },
    {
      "position": 4,
      "text": "Heat vegetable oil in a skillet over medium heat."
    },
    {
      "position": 5,
      "text": "Spoon 2 tablespoons of the hash filling and 1 1/2 tablespoons of mozzarella cheese on each tortilla. Fold tortillas in half. Fry in vegetable oil until quesadillas are golden and crispy, about 3 minutes on each side. Transfer to a paper towel-lined plate."
    },
    {
      "position": 6,
      "text": "Mix cilantro and onions together in a small bowl."
    },
    {
      "position": 7,
      "text": "Serve the quesadillas with salsa, sour cream, onions, and cilantro. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

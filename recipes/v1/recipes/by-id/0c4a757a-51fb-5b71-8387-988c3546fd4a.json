  "slug": "creamy-spiced-coleslaw",
  "name": "Creamy Spiced Coleslaw",
  "recipe_type": "salad",
  "brief_description": "This creamy coleslaw recipe features mild spices like celery seed, onion powder, and garlic powder which complement each other for a delicious result.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix mayonnaise, sugar, cider vinegar, salt, pepper, celery seed, garlic powder, and onion powder together in a large bowl. Add coleslaw mix and toss to coat. Cover and chill for at least 1 hour before serving."
    }
  ],

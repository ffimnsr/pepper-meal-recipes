  "id": "a7731998-3c4f-5674-9f7e-16d9adda5c40",
  "slug": "dark-chocolate-buttermilk-pecan-pie",
  "name": "Dark Chocolate Buttermilk Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "Dark chocolate buttermilk pie is topped with plenty of pecans and is baked into a crowd-pleasing dessert perfect for any family gathering.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Press pie crusts into two 9-inch pie pans."
    },
    {
      "position": 2,
      "text": "Melt chocolate chips in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching."
    },
    {
      "position": 3,
      "text": "Mix sugar, flour, and salt together in a bowl."
    },
    {
      "position": 4,
      "text": "Whisk buttermilk, eggs, and vanilla extract in a separate bowl; stir buttermilk mixture into sugar mixture. Slowly pour melted chocolate into mixture, while beating with an electric mixer, until filling is smooth. Pour half the filling into each prepared pie crust. Sprinkle pecans over each pie."
    },
    {
      "position": 5,
      "text": "Bake pies in the preheated oven until cooked through, about 1 hour. Cool for at least 1 hour before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

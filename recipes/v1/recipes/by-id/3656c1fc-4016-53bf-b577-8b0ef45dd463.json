  "id": "3656c1fc-4016-53bf-b577-8b0ef45dd463",
  "slug": "orange-scones-with-orange-glaze",
  "name": "Orange Scones with Orange Glaze",
  "recipe_type": "dessert",
  "brief_description": "These scones bursting with refreshing orange flavor are dunked in a sweet orange glaze while still warm.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and grease with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix flour, 1 tablespoon sugar, baking soda, baking powder, and salt. Cut in butter using a pastry cutter. Mix in orange zest."
    },
    {
      "position": 3,
      "text": "Make a well in the center of the flour mixture. Whisk orange juice, egg, and vinegar together and pour into the flour mixture. Stir until moistened and sticky."
    },
    {
      "position": 4,
      "text": "Transfer dough to a floured surface and knead gently about 10 times. Pat into a 6x8-inch rectangle. Cut rectangle into 4 squares; cut each square diagonally into 8 triangles. Arrange scones on the prepared baking sheet. Brush tops with milk and sprinkle with remaining 1 tablespoon sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Make the orange glaze while the scones are baking. Mix 1/2 cup plus 2 tablespoons confectioners' sugar and orange juice until thick and smooth; glaze should drip slowly off the back of a spoon. Mix in orange zest."
    },
    {
      "position": 7,
      "text": "Dunk warm scones in the glaze to fully coat the tops. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "17b91a2d-c8fb-5771-85a3-8a51d839bc64",
  "slug": "alis-amazing-bruschetta",
  "name": "Ali's Amazing Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "This bruschetta will turn out every time you make it. Use small slices of bread for a unique appetizer, or serve with Italian dishes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, onion, olive oil, oregano, basil and parsley in a medium bowl. Place bread on a baking sheet, and top with tomato mixture. Sprinkle with Parmesan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 8 to 10 minutes, or until bottom of bread is browned. Allow to cool 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

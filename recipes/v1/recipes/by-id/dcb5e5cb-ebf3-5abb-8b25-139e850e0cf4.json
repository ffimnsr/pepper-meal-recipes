  "id": "dcb5e5cb-ebf3-5abb-8b25-139e850e0cf4",
  "slug": "pumpkin-pie-spiced-chocolate-truffles",
  "name": "Pumpkin Pie-Spiced Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "This is a classic chocolate truffle recipe made with semi-sweet chocolate and heavy cream, but the truffles are rolled in pumpkin pie spice for a fall twist.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate into a heat-proof bowl and drop butter on top."
    },
    {
      "position": 2,
      "text": "Warm cream in a saucepan over medium-low heat to a simmer, just below boiling. Remove from heat and pour hot cream evenly over chopped chocolate and butter. Allow to sit for 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir chocolate until melted. Add vanilla extract and continue stirring until chocolate is completely melted. Pour chocolate into a flat and shallow dish. Freeze for 1 hour or place refrigerate for 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Mix pumpkin pie spice with sugar in a small bowl. Scoop the set chocolate mixture into mounds the size of 1 to 2 teaspoons. Roll into balls and then roll into pumpkin pie spice mixture. Refrigerate until ready to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "692278ec-9d8d-57e0-ac09-c91fc660bdc1",
  "slug": "black-eyed-pea-cornbread",
  "name": "Black-Eyed Pea Cornbread",
  "recipe_type": "breakfast",
  "brief_description": "Up your cornbread game with this family recipe featuring black-eyed peas, spicy breakfast sausage, pickled jalape\u00f1o peppers, and cheese.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Cook sausage and onion in a large skillet over medium heat, stirring until sausage is crumbly and no longer pink, about 5 minutes. Drain on paper towels."
    },
    {
      "position": 3,
      "text": "Mix cornmeal, flour, salt, and baking soda together in a large bowl."
    },
    {
      "position": 4,
      "text": "Whisk buttermilk, oil, and eggs together in a small bowl. Add to cornmeal mixture, stirring just until moistened. Stir in sausage mixture, black-eyed peas, Cheddar cheese, corn, chile peppers, and jalape\u00f1os. Pour batter into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

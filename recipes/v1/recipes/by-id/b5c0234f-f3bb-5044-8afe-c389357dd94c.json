  "id": "b5c0234f-f3bb-5044-8afe-c389357dd94c",
  "slug": "panzanella-salad",
  "name": "Panzanella Salad",
  "recipe_type": "salad",
  "brief_description": "Panzanella is an Italian salad made with toasted bread cubes, ripe tomatoes, and basil, tossed with a simple vinaigrette for a delicious summer salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss bread with 1/3 cup olive oil, salt, pepper, and garlic in a large bowl."
    },
    {
      "position": 3,
      "text": "Arrange on a baking sheet and toast in the preheated oven until golden, about 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Transfer bread back into the bowl and set aside to cool slightly."
    },
    {
      "position": 5,
      "text": "Whisk 1/4 cup of olive oil and balsamic vinegar together in a small bowl; set aside."
    },
    {
      "position": 6,
      "text": "Add tomatoes, onion, basil, olives, and mozzarella into the bowl with bread; toss with vinaigrette."
    },
    {
      "position": 7,
      "text": "Let stand for 20 minutes before serving. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

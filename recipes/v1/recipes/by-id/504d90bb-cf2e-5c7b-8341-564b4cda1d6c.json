  "id": "504d90bb-cf2e-5c7b-8341-564b4cda1d6c",
  "slug": "traditional-pecan-pie-in-a-jar",
  "name": "Traditional Pecan Pie in a Jar",
  "recipe_type": "dessert",
  "brief_description": "These single serving pecan pies in a jar are delicious and easy to make with pre-made pie crust. Great as a gift or an anytime treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread pecans on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake pecans in the preheated oven until lightly toasted, 6 to 8 minutes. Cool to room temperature."
    },
    {
      "position": 3,
      "text": "Bring sugar, light corn syrup, and dark corn syrup to a boil in a saucepan; boil for 2 minutes. Remove from heat and cool slightly, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Whisk eggs in a large bowl until frothy. Add syrup mixture slowly, whisking constantly to prevent eggs from curdling. Whisk in butter, vanilla extract, and salt until batter is smooth."
    },
    {
      "position": 5,
      "text": "Spray 8 small jars with cooking spray. Press pieces of pie crust dough into bottom and sides of jars. Add a layer of toasted pecans to each jar. Spoon in batter, leaving 1/4 inch rim at top."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until darkened on the top, about 40 minutes. Cool to room temperature before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 48,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

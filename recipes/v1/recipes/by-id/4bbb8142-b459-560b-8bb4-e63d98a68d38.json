  "slug": "german-potato-soup-with-sausage-recipe-11971096",
  "name": "German Potato Soup with Sausage",
  "recipe_type": "soup",
  "brief_description": "This German potato soup with sausage is a hearty, stick-to-your-ribs meal that\u2019s simple to make and full of flavor. Potatoes, carrots, celery, and onions pair perfectly with smoky sausage in every bite.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large soup pot over medium heat. Add onion, celery, carrots, thyme, and parsley. Cook 5 minutes."
    },
    {
      "position": 2,
      "text": "Add potatoes, sausage, and broth. Bring to a boil. Reduce heat and simmer 25 minutes."
    },
    {
      "position": 3,
      "text": "Ladle into bowls. Season with salt and pepper. For a thicker consistency, smash some of the potatoes with the ladle prior to serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 16,

  "id": "5f33870d-9b11-5fa7-a1df-de5106307b1e",
  "slug": "mommas-wheat-germ-cookies",
  "name": "Momma\u2019s Wheat Germ Cookies",
  "recipe_type": "dessert",
  "brief_description": "Momma\u2019s wheat germ cookie recipe includes oatmeal, wheat germ, flaked coconut, chopped pecans, and chopped pitted dates. The recipe yields 5 dozen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter, white sugar, and brown sugar together in a large bowl with an electric mixer until smooth. Beat in eggs, one at a time, then stir in vanilla. Whisk oats, wheat germ, flour, baking powder, baking soda, and salt together in a separate bowl; stir into butter mixture. Stir in pecans, coconut, and dates."
    },
    {
      "position": 3,
      "text": "Drop rounded spoonfuls of dough onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned and edges are set, 8 to 10 minutes. Cool cookies on cookie sheets for 1 to 2 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 45,

  "slug": "spicy-lentil-guacamole",
  "name": "Spicy Lentil Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "Cooked sprouted green lentils bring extra flavor and texture to this spicy guacamole with jalapeno peppers and fresh lime juice.",

  "id": "e64e8a2a-b3c6-5edf-9b13-23e02fc55299",
  "slug": "lemon-curd-thumbprint-cookies",
  "name": "Lemon Curd Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "Lemon curd cookies are a double delight: Shortbread cookies are always a favorite, but the addition of lemon curd and zest makes them fabulous.",
  "cuisine": "Scandinavian British",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a bowl until thoroughly creamed. Gradually mix in flour, 1 cup at a time. Add lemon zest and mix until well blended."
    },
    {
      "position": 3,
      "text": "Roll dough into 1-inch balls and place on an ungreased cookie sheet. Make an indent in the center of each using your thumb. Put a small spoonful of lemon curd into each indent."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are golden, 15 to 20 minutes. Cool on the cookie sheet for 1 minute before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

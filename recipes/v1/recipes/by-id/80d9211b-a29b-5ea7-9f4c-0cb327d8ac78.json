  "id": "80d9211b-a29b-5ea7-9f4c-0cb327d8ac78",
  "slug": "carrot-ceviche-vegan",
  "name": "Carrot Ceviche (Vegan)",
  "recipe_type": "appetizer",
  "brief_description": "This Mexican recipe for ceviche de zanahoria, carrot ceviche, is vegan and tastes great served on tostadas, sprinkled with avocado.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix carrots, tomato, onion, serrano pepper, and cilantro together in a bowl."
    },
    {
      "position": 2,
      "text": "Combine ketchup, orange juice, lime juice, and hot sauce in a separate bowl. Pour over vegetables and season with salt. Let stand for 1 hour until flavors are well combined. Drain."
    },
    {
      "position": 3,
      "text": "Serve on tostadas and garnish with avocado."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

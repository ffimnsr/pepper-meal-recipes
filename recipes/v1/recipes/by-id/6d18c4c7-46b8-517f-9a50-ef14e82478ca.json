  "id": "6d18c4c7-46b8-517f-9a50-ef14e82478ca",
  "slug": "linguine-with-peppers-and-sausage",
  "name": "Linguine with Peppers and Sausage",
  "recipe_type": "main",
  "brief_description": "This quick sausage linguine features saut\u00e9ed chopped red bell peppers, onion, garlic, and white wine tossed with hot pasta and grated Parmesan cheese.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes."
    },
    {
      "position": 2,
      "text": "While pasta is cooking, saut\u00e9 sausage in a heavy skillet over medium-high heat until light brown, breaking up clumps with the back of a spoon. Add peppers, onion, and garlic; saut\u00e9 until tender. Pour in wine and simmer until liquid is slightly reduced, about 6 minutes."
    },
    {
      "position": 3,
      "text": "Drain pasta and add to the skillet. Toss to combine. Add cheese; toss to blend."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

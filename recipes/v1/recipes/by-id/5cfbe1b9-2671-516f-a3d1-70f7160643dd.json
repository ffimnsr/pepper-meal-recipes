  "id": "5cfbe1b9-2671-516f-a3d1-70f7160643dd",
  "slug": "cinnamon-apple-and-banana-granolameal",
  "name": "Cinnamon Apple and Banana \"Granolameal\"",
  "recipe_type": "breakfast",
  "brief_description": "Cinnamon, apple, and banana are combined with granola and oats to make this \"granolameal\" recipe that is a quick and easy twist on breakfast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place apple, bananas, granola, cinnamon, sugar, and cocoa powder in a container with a lid. Cover and shake until combined."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium-high heat. Add apple mixture; increase heat slightly and cook, stirring constantly, until cinnamon starts to darken and turn into a paste, 2 to 3 minutes. Stir in milk."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium; cook, covered, until flavors combine, about 1 minute. Uncover and stir. Cover and simmer for 1 minute more. Remove from heat and stir."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

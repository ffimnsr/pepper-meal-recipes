  "id": "5a233fd4-af5f-500b-a3ca-6e58b2eea5d5",
  "slug": "cheddar-beer-fondue",
  "name": "Cheddar-Beer Fondue",
  "recipe_type": "appetizer",
  "brief_description": "Cheddar and beer fondue is easy to prepare and is perfect for dipping bread, vegetables, or apples at your next dinner party or special occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix Cheddar cheese and flour together in a bowl."
    },
    {
      "position": 2,
      "text": "Bring beer to a light boil in a fondue pot; add garlic, Worcestershire sauce, and mustard powder and stir. Gradually stir cheese mixture into beer mixture. Reduce heat to low; cook and stir mixture until cheese is melted, about 5 minutes."
    }
  ],
  "servings": 8,

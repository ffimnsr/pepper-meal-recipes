  "id": "b07dc41f-f546-500c-bbaf-b8ae833357d3",
  "slug": "spicy-pumpkin-fudge",
  "name": "Spicy Pumpkin Fudge",
  "recipe_type": "dessert",
  "brief_description": "Oh soo good! A nice alternative to traditional chocolate fudge. This recipe is a family favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 9x13 inch pan and set aside."
    },
    {
      "position": 2,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Arrange almonds on a cookie sheet and place in oven to toast. Stir frequently. Do not burn. Remove from oven and set aside."
    },
    {
      "position": 3,
      "text": "In a heavy saucepan, combine sugar, butter, milk, pumpkin, and spice; bring to a boil, stirring constantly. Continue boiling over medium heat until mixture reaches 234 degrees F (118 degrees C) on a candy thermometer, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Remove from heat. Stir in butterscotch chips. When chips are melted, add marshmallow cream, nuts, and vanilla. Mix until well blended."
    },
    {
      "position": 5,
      "text": "Immediately pour butterscotch mixture into prepared pan. Spread evenly. Cool at room temperture. Cut into squares, and store in the refrigerator in an air-tight container."
    }
  ],
  "servings": 36,

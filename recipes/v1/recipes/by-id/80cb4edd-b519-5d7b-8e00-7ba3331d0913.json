  "id": "80cb4edd-b519-5d7b-8e00-7ba3331d0913",
  "slug": "vegan-fudge",
  "name": "Vegan Fudge",
  "recipe_type": "dessert",
  "brief_description": "In this quick and easy fudge recipe, regular ingredients are swapped out with vegan ones resulting in a fudge that melts in your mouth but stays solid at room temperature.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease an 8-inch square glass baking dish with coconut oil."
    },
    {
      "position": 2,
      "text": "Combine chocolate chips, sweetened condensed coconut milk, and 1/4 cup coconut oil in a saucepan. Let sit over low heat, stirring only as needed until chips are melted, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour mixture into the prepared baking dish. Refrigerate until fudge is firm, 3 to 4 hours, or put in the freezer for a faster setting time."
    }
  ],
  "servings": 25,
  "cooking_time_minutes": 5,

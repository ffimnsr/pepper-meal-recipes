  "id": "f5468c8d-7804-502d-82ad-2eba9bee628b",
  "slug": "pork-and-wild-rice-casserole",
  "name": "Pork and Wild Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This creamy wild rice and pork sausage casserole with bacon, celery, mushrooms, and parsley is a delicious way to use wild rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place rice and water in a pot and bring to a boil. Reduce heat to low, cover, and cook 45 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Place bacon in a large skillet over medium-high heat and cook until evenly brown. Drain, crumble, and set aside. Place pork in skillet and cook until evenly brown. Drain and set aside."
    },
    {
      "position": 4,
      "text": "Reduce skillet heat to medium and melt butter. Stir in onion and celery, and cook until tender; set aside. Mix flour into remaining butter until smooth. In a bowl, mix the reserved mushroom liquid and half and half; stir into the skillet and cook until thickened. Stir in the soup. Mix in 6 cups cooked rice, cooked bacon, cooked pork, mushrooms, almonds, pimento, parsley, salt, and pepper."
    },
    {
      "position": 5,
      "text": "Transfer into a 9x13-inch casserole dish. Bake in the preheated oven for 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

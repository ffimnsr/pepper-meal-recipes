  "id": "7f7211f5-b7f3-519c-afcb-bd55165f241d",
  "slug": "easy-healthy-no-cook-overnight-oats",
  "name": "Easy, Healthy No-Cook Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Rolled oats layered with banana, chia seeds, almond butter, and almond milk are soaked overnight for an easy, no-cook breakfast in a jar.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place 3 to 4 slices of banana in the bottom of a jar. Layer 1 1/2 teaspoon of almond butter, 1/2 teaspoon chia seeds, and 1/2 cup oats on top. Repeat layering remaining almond butter, chia seeds, and oats, leaving a 1-inch gap at the top."
    },
    {
      "position": 2,
      "text": "Mix almond milk, maple syrup, and vanilla extract in a bowl. Pour over oats, leaving a 1/2-inch gap at the top to allow oats to expands as they soak. Push a knife or fork vertically through the jar to make sure milk mixture soaks all the way through."
    },
    {
      "position": 3,
      "text": "Cover jar tightly and refrigerate until oats are moist, 4 hours to overnight."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

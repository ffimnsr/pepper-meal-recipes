  "id": "3892da74-aac8-56bb-ab31-3316e259b7fb",
  "slug": "homemade-dog-liver-bites",
  "name": "Homemade Dog Liver Bites",
  "recipe_type": null,
  "brief_description": "Made with either chicken or beef liver, these dog treats are full of protein, easy to make, and freezable. Double the batch for Fido and his friends.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9-inch square baking dish and line it with parchment paper."
    },
    {
      "position": 2,
      "text": "Add oats to the bowl of a food processor; pulse until finely chopped, 10 to 15 seconds. Transfer oats to a large bowl and mix in flour."
    },
    {
      "position": 3,
      "text": "Place livers in the food processor and process until smooth, 10 to 15 seconds. Add eggs and blend until well combined, about 10 seconds. Add oil and process until incorporated."
    },
    {
      "position": 4,
      "text": "Add liver mixture to oat and flour mixture; stir until well blended. Spoon into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm to the touch but not hard and crispy, 30 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool completely before cutting into 50 pieces."
    }
  ],
  "servings": 50,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

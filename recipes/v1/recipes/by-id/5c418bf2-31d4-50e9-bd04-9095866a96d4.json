  "id": "5c418bf2-31d4-50e9-bd04-9095866a96d4",
  "slug": "sweet-irish-bread",
  "name": "Sweet Irish Bread",
  "recipe_type": "dessert",
  "brief_description": "A sweet breakfast bread with raisins that tastes most excellent toasted.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5 inch loaf pan. I use a glass one."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together the butter and sugar until smooth. Beat in the eggs one at a time, then stir in the sour cream. Sift together the flour, baking soda, cream of tartar and salt; stir into the sour cream mixture until just blended. Fold in raisins. Transfer the batter to the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake for 50 to 60 minutes in the preheated oven, or until a small knife inserted into the crown, comes out clean."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

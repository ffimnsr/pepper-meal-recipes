  "id": "18f48e5b-b090-552e-b478-6ecde905eada",
  "slug": "peppermint-white-russian-recipe-11811979",
  "name": "Peppermint White Russian",
  "recipe_type": "appetizer",
  "brief_description": "This peppermint white Russian begins with a peppermint-infused vodka, and is poured into glasses rimmed with marshmallow fluff and crushed peppermint candy for a festive twist on a classic cocktail.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For peppermint infusied vodka, add peppermint candies to a pint jar and top with vodka. Place the lid on the jar and shake gently. Cover and let sit for a minimum of 4 hours or overnight."
    },
    {
      "position": 2,
      "text": "Strain the peppermint vodka infusion into an airtight container. Discard any undissolved peppermints."
    },
    {
      "position": 3,
      "text": "To prepare the garnish, place a few peppermint candies inside a plastic bag. Crush with a rolling pin into fine pieces."
    },
    {
      "position": 4,
      "text": "Rim the cocktail glass with marshmallow fluff and dip in crushed peppermint."
    },
    {
      "position": 5,
      "text": "Add ice to the rimmed glass, then pour in peppermint vodka and coffee liqueur."
    },
    {
      "position": 6,
      "text": "Using the back of a spoon, slowly pour heavy cream on top to suspend the cream on top of the alcohol."
    },
    {
      "position": 7,
      "text": "Garnish the top with extra crushed peppermint candies. Enjoy!"
    }
  ],
  "servings": 1,

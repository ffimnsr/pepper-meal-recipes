  "id": "c748cf6a-c46d-5e9e-b665-52dc291acc3f",
  "slug": "texas-straw-hats-recipe-11894208",
  "name": "Texas Straw Hats",
  "recipe_type": "appetizer",
  "brief_description": "These Texas straw hats are such a fun dinner idea. It's crunchy corn chips with a tomato-beef chili on top broiled with melted, bubbly cheese, all on a sheet pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add ground beef, onion, and green bell pepper to a large skillet over medium-high heat. Cook, stirring occasionally, until beef is browned and crumbled and vegetables are tender, 6 to 8 minutes. Drain any excess grease."
    },
    {
      "position": 2,
      "text": "Stir in diced tomatoes, tomato paste, water, taco seasoning, and Worcestershire sauce. Bring to a simmer over medium-low and cook, stirring occasionally, until thickened, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Preheat broiler to High, and place an oven rack about 6 inches away from the heat source."
    },
    {
      "position": 4,
      "text": "Spread corn chips in a single layer on a 10x15-inch rimmed baking sheet. Spoon beef mixture evenly over the chips, then sprinkle with shredded cheese."
    },
    {
      "position": 5,
      "text": "Broil until cheese is melted and bubbly, 1 to 3 minutes. Remove from the oven and garnish with chopped chives. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

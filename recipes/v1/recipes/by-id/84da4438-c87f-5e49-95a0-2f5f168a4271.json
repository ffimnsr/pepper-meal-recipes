  "schema_version": 1,
  "id": "84da4438-c87f-5e49-95a0-2f5f168a4271",
  "slug": "herbed-cream-cheese-omelet",
  "name": "Herbed Cream Cheese Omelet",
  "recipe_type": "breakfast",
  "brief_description": "Omelet phobia? Not with this cream cheese omelet recipe. Follow the directions and create not only perfect omelets but omelets that your guests will swoon over.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together cream cheese and cilantro in a bowl. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat 1/4 of the butter in a well-seasoned omelet pan or 8-inch nonstick frying pan over medium-high heat. When butter is hot and bubbling, swirl it around in the pan."
    },
    {
      "position": 3,
      "text": "Just before butter begins to brown, beat 2 eggs and pour into the pan. Reduce heat."
    },
    {
      "position": 4,
      "text": "After 10 seconds or so, omelet will coagulate. Push omelet to one side of the pan with a spoon or spatula to allow raw egg to flow onto the cleared skillet. Repeat this one more time, then remove the skillet from heat."
    },
    {
      "position": 5,
      "text": "Dab 1/4 of the herbed cream cheese in a line along the middle of omelet. Season with salt and pepper. If omelet has not completely set, place the pan over medium heat for 30 more seconds."
    },
    {
      "position": 6,
      "text": "Slide omelet from the pan onto a plate, so it rolls up, enclosing herbed cream cheese filling. Make 3 more omelets the same way."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

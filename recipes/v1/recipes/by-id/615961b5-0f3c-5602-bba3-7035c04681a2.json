  "schema_version": 1,
  "id": "615961b5-0f3c-5602-bba3-7035c04681a2",
  "slug": "halloween-oreo-mummies",
  "name": "Halloween Oreo Mummies",
  "recipe_type": "dessert",
  "brief_description": "Turn chocolate-covered Oreo cookies into these adorable little mummy cookies that are just spooky enough for Halloween without being too scary for little ones.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt candy melts in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes. Scoop a heaping tablespoon into a resealable plastic bag and set aside."
    },
    {
      "position": 2,
      "text": "Working 1 at a time, use a butter knife to spread the candy melt over the top and around the sides of each cookie. Place on wax paper."
    },
    {
      "position": 3,
      "text": "Seal the resealable plastic bag and snip off 1 of the corners with scissors. Pipe stripes over the top of the cookies in a back-and-forth pattern. It's okay if the stripes are uneven or at different angles."
    },
    {
      "position": 4,
      "text": "Before the stripes dry, stick two candy eyeballs on the top of each cookie."
    },
    {
      "position": 5,
      "text": "Allow the candy coating to dry and harden before serving (you can expedite the hardening process by placing the wax paper and cookies into the refrigerator for a few minutes)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 30,

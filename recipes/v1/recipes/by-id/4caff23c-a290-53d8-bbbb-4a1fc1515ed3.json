  "schema_version": 1,
  "id": "4caff23c-a290-53d8-bbbb-4a1fc1515ed3",
  "slug": "perogies",
  "name": "Perogies",
  "recipe_type": "main",
  "brief_description": "These perogies made with homemade dough rounds filled with potato, bacon, cheese, and sauerkraut are boiled for 5 minutes for a quick-and-easy dish.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Make dough: Combine flour, cold water, beaten egg, and salt in a bowl; mix until a smooth dough forms. Cover the bowl and set aside."
    },
    {
      "position": 2,
      "text": "Make potato filling: Place potatoes in a large pot. Add water to cover, bring to a boil, and cook until tender, 25 to 35 minutes. Drain and mash in the pot until smooth."
    },
    {
      "position": 3,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble and stir into mashed potatoes. Stir in cheese; season with salt and pepper. Set aside."
    },
    {
      "position": 4,
      "text": "Make sauerkraut filling: Place bacon in the skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain, crumble, and place in a medium bowl. Stir in sauerkraut, then sour cream. Mix well."
    },
    {
      "position": 5,
      "text": "Roll dough out on a floured surface to 1/8- to 1/4-inch thickness. Cut out 3-inch circles with a cookie cutter or an upside-down drinking glass. Place a spoonful of potato or sauerkraut filling in the center of each circle and fold over, pinching edges together to seal."
    },
    {
      "position": 6,
      "text": "Bring a large pot of lightly salted water to a boil; drop perogies in boiling water and cook until they float, 4 to 5 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

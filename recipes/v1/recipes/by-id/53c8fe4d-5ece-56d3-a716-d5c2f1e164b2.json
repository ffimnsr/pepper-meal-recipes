  "id": "53c8fe4d-5ece-56d3-a716-d5c2f1e164b2",
  "slug": "barm-brack",
  "name": "Barm Brack",
  "recipe_type": "dessert",
  "brief_description": "Delicious Irish fruit cake. Serve thickly sliced with butter.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Put the tea, sugar, raisins and peel into a bowl, cover and leave to soak overnight."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 8 inch round pan."
    },
    {
      "position": 3,
      "text": "Sift the flour into the fruit mixture, add the egg and beat well."
    },
    {
      "position": 4,
      "text": "Pour into the cake pan and bake at 350 degrees F (175 degrees C) for 1 hour and 45 minutes, or until toothpick inserted into center of cake comes out clean. Leave in the pan for 5 minutes, then turn out onto a wire rack."
    }
  ],
  "servings": 10,

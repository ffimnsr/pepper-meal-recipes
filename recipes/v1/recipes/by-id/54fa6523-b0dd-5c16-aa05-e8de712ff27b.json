  "id": "54fa6523-b0dd-5c16-aa05-e8de712ff27b",
  "slug": "bettys-famous-eggnog",
  "name": "Betty's Famous Eggnog",
  "recipe_type": "drink",
  "brief_description": "This rich eggnog is made the old-fashioned way by blending beaten egg yolks, whipped egg whites, sugar, and heavy cream with bourbon, rum and brandy. A dusting of nutmeg accents the creamy flavors.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat the eggs and sugar together in a very large bowl until thick and light-colored. Stir in the bourbon and rum, mixing until sugar has dissolved. Let stand about 1 hour."
    },
    {
      "position": 2,
      "text": "Meanwhile, whip the egg whites in a separate bowl until stiff peaks form."
    },
    {
      "position": 3,
      "text": "Stir the whipping cream and half and half into the egg yolk mixture until thoroughly blended. Slowly stir in the brandy. Fold in the egg whites, blending evenly. Cover and refrigerate two hours before serving. May be stored in the refrigerator up to one week."
    },
    {
      "position": 4,
      "text": "Serve in small cups or glasses dusted with a pinch of nutmeg."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

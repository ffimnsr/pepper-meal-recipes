  "id": "95d8ec72-5cd8-5c1b-8875-48133e13b0a5",
  "slug": "reuben-nachos",
  "name": "Reuben Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These Reuben nachos let you enjoy all the elements of the popular sandwich in a shareable form, from corned beef, Swiss cheese, dill, and sauerkraut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together mayonnaise, ketchup, sour cream, relish, red onion, Dijon mustard, and garlic salt in a small bowl until well blended. Set sauce aside."
    },
    {
      "position": 3,
      "text": "Layer 1/2 of the tortilla chips in an even layer on a baking sheet. Top with 1 cup Swiss cheese, 1/2 cup Cheddar cheese, and 1/4 teaspoon dill. Repeat layers with remaining chips, cheeses, and dill."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheeses are melted, about 5 minutes. Remove from the oven. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 5,
      "text": "Top nachos evenly with corned beef and sauerkraut."
    },
    {
      "position": 6,
      "text": "Cook under the preheated broiler until heated through, 1 to 2 minutes. Top nachos with sauce to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

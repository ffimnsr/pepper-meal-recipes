  "id": "94435b88-1ef3-5701-8f13-7307b54759ea",
  "slug": "family-latkes",
  "name": "Family Latkes",
  "recipe_type": "side",
  "brief_description": "This family recipe for crisp, deep-fried potato latkes are the perfect side dish for any Jewish holiday--or any day of the week.",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in salted water and let sit for about 15 minutes."
    },
    {
      "position": 2,
      "text": "Grate potatoes on a medium or fine setting. Press out liquid; this should produce about 4 cups grated potato."
    },
    {
      "position": 3,
      "text": "Place grated potato in a bowl and stir in flour, onion, salt, and pepper. Fold in eggs."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 5,
      "text": "Heat enough oil in a deep pan to reach 1/4 inch up the sides. Heat over medium-high heat until a drop of batter sizzles. Lower heat to medium."
    },
    {
      "position": 6,
      "text": "Working in batches, drop batter into the hot oil in desired size and flatten into pancakes; brown on both sides, 5 to 7 minutes per side. Transfer to the prepared pans and keep warm in the preheated oven while you fry remaining batter."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

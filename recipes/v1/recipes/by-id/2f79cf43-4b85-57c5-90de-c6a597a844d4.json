  "id": "2f79cf43-4b85-57c5-90de-c6a597a844d4",
  "slug": "cranberry-sauce-i",
  "name": "Cranberry Sauce with Orange Juice",
  "recipe_type": "drink",
  "brief_description": "This cranberry sauce with orange juice recipe makes an easy, homemade condiment in just 20 minutes, with fresh cranberries, orange juice, and sugar.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar and orange juice in a medium saucepan over medium heat; stir until sugar dissolves. Add cranberries; cook, stirring occasionally, until they start to pop, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer to a bowl; cranberry sauce will thicken as it cools."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,

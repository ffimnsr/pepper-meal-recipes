  "id": "4c278f93-af40-596d-9522-3e78059c1464",
  "slug": "vanilla-chantilly-cream",
  "name": "Vanilla Chantilly Cream",
  "recipe_type": "dessert",
  "brief_description": "Chantilly cream is sweetened whipped cream flavored with real vanilla for a luscious topping on layered desserts or rich filling for cakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Split vanilla bean lengthwise with the tip of a sharp knife. Holding the pod open, scrape seeds from each half using the flat side of the knife. Transfer seeds to a large bowl; discard pod."
    },
    {
      "position": 3,
      "text": "Pour cream over vanilla seeds; add sugar and vanilla extract."
    },
    {
      "position": 4,
      "text": "Whip cream with an electric mixer until soft peaks form, 3 to 5 minutes; cover with plastic wrap and chill until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

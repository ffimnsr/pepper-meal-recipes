  "id": "1c74b161-6e66-5cb9-9262-24802f4f33ef",
  "slug": "whipped-pumpkin-pie",
  "name": "Whipped Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "With all the flavor of a traditional pumpkin pie, this whipped pumpkin pie boasts a lighter texture and a graham cracker crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine graham cracker crumbs, 2/3 cup sugar, and melted butter in a mixing bowl. Mix until evenly moistened, then press into the bottom and halfway up the sides of a 9-inch springform pan. Place pan on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake the crust in the preheated oven until lightly browned and toasted, about 10 minutes. Remove from the oven and allow crust to cool."
    },
    {
      "position": 4,
      "text": "Beat cream cheese and 1/2 cup sugar together in a large bowl with an electric mixture until light and fluffy, 2 to 3 minutes. Beat in pumpkin puree until completely incorporated."
    },
    {
      "position": 5,
      "text": "Fold whipped topping into pumpkin mixture; stir in nutmeg and pumpkin pie spice. Pour pumpkin mixture into graham cracker crust. Cover pie with plastic wrap and refrigerate overnight. Gently remove pie from springform pan."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

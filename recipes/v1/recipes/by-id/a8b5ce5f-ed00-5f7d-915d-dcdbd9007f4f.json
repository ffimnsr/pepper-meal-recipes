  "id": "a8b5ce5f-ed00-5f7d-915d-dcdbd9007f4f",
  "slug": "no-bake-energy-bites",
  "name": "No-Bake Energy Bites",
  "recipe_type": "appetizer",
  "brief_description": "These energy bites are perfect for on-the-go snacking. Peanut butter and chocolate chips make them irresistible, and oats and flax keep them healthy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir oats, chocolate chips, flax seed, peanut butter, honey, and vanilla extract together in a bowl."
    },
    {
      "position": 3,
      "text": "Roll dough into 24 balls with your hands. Arrange balls on a baking sheet and freeze until set, about 1 hour."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 24,

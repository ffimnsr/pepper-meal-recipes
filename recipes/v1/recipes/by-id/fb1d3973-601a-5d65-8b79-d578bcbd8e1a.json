  "id": "fb1d3973-601a-5d65-8b79-d578bcbd8e1a",
  "slug": "egg-and-cheese-tortilla-cups-recipe-11908718",
  "name": "Egg and Cheese Tortilla Cups",
  "recipe_type": "breakfast",
  "brief_description": "These egg and cheese tortilla cups are a quick, fun idea for brunch or for any kind of breakfast gathering, these little seasoned egg, bacon, and cheese bites will be perfect. They are very simple to put together and incredibly versatile\u2014really, you can use whatever vegetables or meat you wish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 6-cup muffin pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Beat eggs and sour cream together until frothy in a bowl. Fold in cheese, onion, and bacon. Season with cayenne, salt, and pepper."
    },
    {
      "position": 3,
      "text": "On a clean work surface, cut out 4 circles from the flour tortilla using the rim of a heavy glass or a cookie cutter. Lay 1 circle in each of 4 muffin cups. Gently press the tortilla to fit snugly to the sides of the cup."
    },
    {
      "position": 4,
      "text": "Pour egg mixture into each muffin cup. Sprinkle lightly with more cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes, then check for doneness - a toothpick inserted in the middle should come out clean. Let the pan sit for about 5 minutes, then remove the entire cup to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

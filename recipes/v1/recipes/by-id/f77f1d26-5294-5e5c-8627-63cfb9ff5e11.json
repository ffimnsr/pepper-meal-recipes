  "id": "f77f1d26-5294-5e5c-8627-63cfb9ff5e11",
  "slug": "crisp-oatmeal-cookies",
  "name": "Crisp Oatmeal Cookies",
  "recipe_type": "dessert",
  "brief_description": "Use this recipe with coconut, oatmeal, and chocolate chips to make crispy, delicious oatmeal cookies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the shortening, white sugar and brown sugar. Mix in the egg and vanilla until well blended. Combine the flour, baking powder, baking soda and salt; stir into the batter until well blended. Mix in the oats, coconut and chocolate chips until evenly distributed. Roll dough into walnut sized balls and place 2 inches apart onto prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 12 minutes in the preheated oven, or until edges are lightly browned."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,

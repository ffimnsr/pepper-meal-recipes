  "id": "f0be2ac6-b61c-5a3a-b07c-ec799e0a514f",
  "slug": "hot-mexican-spinach-dip",
  "name": "Hot Mexican Spinach Dip",
  "recipe_type": "appetizer",
  "brief_description": "Take your taste buds on a wild joyride to old Mexico with this hot, creamy dip. Spinach, salsa and Monterey Jack cheese are blended in a harmonious flamenco of flavors that's great with tortilla chips.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium baking dish, mix together salsa, chopped spinach, Monterey Jack cheese, cream cheese, evaporated milk, black olives, red wine vinegar, salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake mixture in the preheated oven 12 to 15 minutes, or until bubbly."
    }
  ],
  "servings": 56,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

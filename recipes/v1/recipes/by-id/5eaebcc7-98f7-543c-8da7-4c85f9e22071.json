  "id": "5eaebcc7-98f7-543c-8da7-4c85f9e22071",
  "slug": "black-bean-and-rice-burritos",
  "name": "Black Bean and Rice Burritos",
  "recipe_type": "main",
  "brief_description": "Bean and rice burritos are the perfect meal when you're on a budget! They're tasty and filling and can be garnished with any of your favorite toppings.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan over high heat. Reduce the heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt 1 tablespoon butter in a large skillet over medium heat. Cook and stir onion and garlic in melted butter until onion is translucent, 5 to 6 minutes. Add remaining 1 tablespoon butter and let melt. Stir in chili powder, paprika, cumin, black pepper, cayenne pepper, cloves, and nutmeg; cook, stirring often, for 2 more minutes."
    },
    {
      "position": 3,
      "text": "Stir in black beans and tomato sauce, then bring to a simmer. Reduce the heat to low and cook until flavors blend, about 10 minutes. Remove from the heat and stir in cilantro. Let sit until cilantro wilts, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Fill warm tortillas with bean mixture and rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

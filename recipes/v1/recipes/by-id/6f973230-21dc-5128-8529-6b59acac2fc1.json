  "id": "6f973230-21dc-5128-8529-6b59acac2fc1",
  "slug": "hazels-cranberry-sauce",
  "name": "Hazel's Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "This is a deep red, spicy holiday sauce that goes with everything from turkey to toast. Some people eat it with a spoon when you're not looking! This recipe makes enough to last until spring.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan, stir together the apple cider, white sugar, brown sugar, allspice, cloves, nutmeg and cranberries. Bring to a boil, then reduce the heat to low and simmer for about 15 minutes, until most of the cranberries have popped. Continue cooking until the consistency is thick."
    },
    {
      "position": 2,
      "text": "Ladle into sterile jars to within 1/2 inch of the rim, seal with lids and rings. Process in a simmering water bath for 10 to 15 minutes to seal, or just transfer to containers, cool, and refrigerate. It will last at least a week if it can escape being gobbled up!"
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

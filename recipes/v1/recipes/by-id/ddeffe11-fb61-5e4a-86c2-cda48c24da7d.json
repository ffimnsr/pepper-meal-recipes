{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ddeffe11-fb61-5e4a-86c2-cda48c24da7d",
  "slug": "grilled-mojo-pork-and-pineapple-skewers-recipe-11750702",
  "name": "Grilled Mojo Pork and Pineapple Skewers",
  "recipe_type": "drink",
  "brief_description": "These grilled mojo pork and pineapple skewers are marinated in Cuban-inspired mojo sauce. Usually based on a citrus fruit known as bitter orange\u2014hard to find in US stores\u2014this recipe uses a combination of orange and lime juice to make the garlicky marinade.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare the marinade at least 2 hours ahead of grilling. Combine olive oil, lime zest. lime juice, orange juice concentrate, water, 2 tablespoons cilantro, black pepper, salt, cumin, coriander, and garlic in a bowl, and stir until well blended. Place half of marinade in a container with a lid; refrigerate to use later for the sauce."
    },
    {
      "position": 2,
      "text": "Place remaining marinade in a large resealable plastic bag. Add pork, squeeze out most of the air, seal the bag, and massage until pork is coated with the marinade. Marinate in the refrigerator for at least 2 hours, or up to overnight."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor gas grill to 400 degrees F (200 degrees C). Clean and oil the grates."
    },
    {
      "position": 4,
      "text": "Meanwhile, for skewers, thread pork and pineapple pieces alternately and evenly onto 6 skewers. Discard marinade in the bag."
    },
    {
      "position": 5,
      "text": "Grill skewers on the preheated grill until no longer pink at the center, 3 to 4 minutes per side. An instant read thermometer inserted into pork should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove skewers from the grill, tent with foil, and allow to rest, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, for sauce, add bacon drippings, mint, and remaining cilantro to the reserved marinade and stir well."
    },
    {
      "position": 8,
      "text": "Drizzle sauce over finished skewers, and serve warm with lime wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 5,
  "difficulty": "medium",

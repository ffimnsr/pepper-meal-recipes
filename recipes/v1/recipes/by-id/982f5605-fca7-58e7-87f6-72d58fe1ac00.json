  "id": "982f5605-fca7-58e7-87f6-72d58fe1ac00",
  "slug": "felix-ks-dont-even-try-to-say-these-arent-the-best-youve-ever-eaten-because-they-are-chocolate-chip-cookies",
  "name": "Felix K.\u2019s \u2018Don\u2019t even try to say these aren\u2019t the best you\u2019ve ever eaten, because they are\u2019 Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This recipe makes the best chocolate chip cookies you\u2019ve ever eaten! Made with pantry staples, you can make a batch right now to taste for yourself.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Gently mix the flour, baking powder, baking soda, and salt with a fork in a bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat the butter, brown sugar, and white sugar with an electric mixer in a large bowl until smooth. Add the eggs one at a time, allowing each egg to blend into the butter mixture before adding the next. Beat in the vanilla with the last egg."
    },
    {
      "position": 4,
      "text": "Mix in the flour mixture until just incorporated. Fold in the chocolate chips, mixing just enough to evenly combine."
    },
    {
      "position": 5,
      "text": "Divide the dough into 24 3-tablespoon-sized balls. Flatten the balls to about 1/4-inch thick onto a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until the edges are golden, 15 to 17 minutes. Allow the cookies to cool on the baking sheet until the centers begin to set, about 20 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

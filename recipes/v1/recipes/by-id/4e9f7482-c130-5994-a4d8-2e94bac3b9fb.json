{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4e9f7482-c130-5994-a4d8-2e94bac3b9fb",
  "slug": "peach-custard-pie-recipe-8678564",
  "name": "Peach Custard Pie",
  "recipe_type": "dessert",
  "brief_description": "This peach custard pie, a cross between peach pie and southern chess pie, has just the right amount of peach to balance with the tender custard and the flaky crust. Blind baking the crust is optional, but it does ensure that the bottom crust will be crisp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To blind bake the crust (optional): Chill pastry-filled pie pan at least 20 minutes before baking to prevent shrinkage."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line pastry with parchment or a double layer of aluminum foil and a layer of pie weights or dried beans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for about 15 minutes. Remove from the oven, carefully remove the foil and weights, and let cool to room temperature, about 20 minutes. The base of the crust will have turned a very light golden brown. Reduce the oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "For custard: combine eggs, white sugar, and brown sugar in a bowl, and whisk vigorously until sugar is dissolved, about 2 minutes. Add flour, cornmeal, salt, vanilla, vinegar, milk, and butter, and whisk vigorously until you achieve a smooth, emulsified batter, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Arrange 12 peach slices on the bottom of the crust. Whisk batter again, and slowly ladle into the crust, being careful not to move the peach slices out of place."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven at 350 degrees F (175 degrees C) until top is browned and a very sharp knife inserted near the center comes out clean, 50 to 60 minutes. The pie should not be liquid, but jiggle when the pie dish is moved back and forth."
    },
    {
      "position": 7,
      "text": "Let cool completely before serving. For best results, chill in the refrigerator before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

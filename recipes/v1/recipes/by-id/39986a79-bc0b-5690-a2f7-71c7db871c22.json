  "schema_version": 1,
  "id": "39986a79-bc0b-5690-a2f7-71c7db871c22",
  "slug": "lobster-colorado",
  "name": "Lobster Colorado",
  "recipe_type": "main",
  "brief_description": "Bacon-wrapped filet mignons are broiled and topped with lobster meat for a very special dinner. Elegant for dinner parties or a romantic dinner for two. If you desire crabmeat instead of lobster, go for it!",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Set oven to Broil at 500 degrees F (260 degrees C)."
    },
    {
      "position": 2,
      "text": "Sprinkle tenderloins all over with salt, pepper, and garlic powder. Wrap each filet with bacon, and secure with a toothpick. Place on a broiling pan, and broil to desired doneness, about 8 to 10 minutes per side for medium rare."
    },
    {
      "position": 3,
      "text": "While tenderloins are cooking, melt 1/4 cup of butter over medium heat with 1/2 teaspoon Old Bay\u00ae seasoning. Stir in chopped lobster meat, and cook until done. Spoon lobster meat over cooked tenderloins, and return them to the broiler until the lobster meat begins to brown."
    },
    {
      "position": 4,
      "text": "While the lobster is in the oven, heat the remaining 1/4 cup of butter in a small saucepan over medium-high heat, cook until it browns, turning the color of a hazelnut. To serve, spoon the browned butter over the steaks, and sprinkle with the remaining Old Bay\u00ae seasoning."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "750db389-bf6c-55e2-bf84-d8c4ec55ecc7",
  "slug": "last-minute-lemon-spaghetti-and-shrimp",
  "name": "Last-Minute Lemon Shrimp Pasta",
  "recipe_type": "drink",
  "brief_description": "This lemon shrimp pasta dish is easy to make with spaghetti, shrimp, fresh basil, lemon juice and zest for a delicious dinner in less than 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in boiling water, stirring occasionally, for 9 minutes. Add shrimp and cook for 3 more minutes. Drain."
    },
    {
      "position": 2,
      "text": "Whisk Parmesan cheese, olive oil, lemon juice, pepper, and salt in a large bowl. Add spaghetti, shrimp, and peas to sauce. Sprinkle with basil and lemon zest; toss to coat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

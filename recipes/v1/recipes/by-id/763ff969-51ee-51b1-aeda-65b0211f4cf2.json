  "id": "763ff969-51ee-51b1-aeda-65b0211f4cf2",
  "slug": "rotel-biscuit-bombs-recipe-8559227",
  "name": "Rotel Biscuit Bombs",
  "recipe_type": "appetizer",
  "brief_description": "Rotel biscuit bombs are easy to make with biscuit dough filled with ground beef, Rotel tomatoes, cheese, and plenty of Taco seasoning for a Mexican taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add onion and cook, stirring constantly, about 1 minute. Add ground beef and cook, stirring, until browned and crumbly, 5 to 7 minutes. Stir in taco seasoning and cook for 1 minute. Mix in tomatoes and reduce heat to medium-low."
    },
    {
      "position": 2,
      "text": "Cook, stirring constantly, until mixture comes to a simmer. Cook for 3 minutes and reduce heat to low. Add in cheese and stir until melted and fully combined. Remove from heat and let cool completely."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins."
    },
    {
      "position": 4,
      "text": "Roll out biscuits, 1 at a time, into 4-inch circles. Spoon about 1 tablespoon of filling onto the center of each circle."
    },
    {
      "position": 5,
      "text": "Bring dough up around the filling, pinching it together to seal the bottom. Work your way around until the filling is fully encased in the biscuit bomb."
    },
    {
      "position": 6,
      "text": "Place each biscuit bomb seam side down into prepared muffin tins."
    },
    {
      "position": 7,
      "text": "Brush each biscuit bomb with melted butter and sprinkle with taco seasoning."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven, rotating once halfway through, until deep golden brown, about 20 to 25 minutes."
    },
    {
      "position": 9,
      "text": "Rest biscuit bombs on a cooling rack for 15 minutes before eating. Serve on their own or with taco sauce on the side for dipping."
    }
  ],
  "servings": 16,

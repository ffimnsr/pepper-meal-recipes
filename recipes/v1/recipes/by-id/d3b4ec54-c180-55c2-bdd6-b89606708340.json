  "id": "d3b4ec54-c180-55c2-bdd6-b89606708340",
  "slug": "bacon-wrapped-peanut-butter-jalapenos",
  "name": "Bacon-Wrapped Peanut Butter Jalape\u00f1os",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for simple and tasty bacon-wrapped peanut butter jalape\u00f1os is sure to be a hit at your next party as everything is better wrapped in bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill each halved jalape\u00f1o with peanut butter; wrap each with a halved bacon strip. Secure wrapped jalape\u00f1os with a toothpick; arrange on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bacon is dark brown, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

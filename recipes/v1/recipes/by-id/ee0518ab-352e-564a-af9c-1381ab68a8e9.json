  "id": "ee0518ab-352e-564a-af9c-1381ab68a8e9",
  "slug": "homemade-cherry-ice-cream",
  "name": "Homemade Cherry Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This delicious homemade cherry ice cream is easy to make with cream and blended fresh summer cherries flavored with vanilla and balsamic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cherries, 1/2 cup sugar, lemon juice, and balsamic vinegar in a bowl and mix well. Set aside for 2 hours. Drain, reserving juice."
    },
    {
      "position": 2,
      "text": "Mash 1/2 the cherries with a fork or puree in a blender."
    },
    {
      "position": 3,
      "text": "Combine milk and remaining 1/2 cup sugar in a bowl and beat with an electric mixer until sugar has dissolved, 1 to 2 minutes. Add reserved cherry juice, cream, pureed cherries, vanilla extract; mix to combine."
    },
    {
      "position": 4,
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions, about 20 minutes. Add remaining quartered cherries and freeze for an additional 5 minutes. Ice cream should be nice and creamy. If you prefer it harder, transfer to an airtight container and freeze until firm, about 4 hours. Remove from freezer 10 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,

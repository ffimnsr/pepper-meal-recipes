  "id": "6686b9ed-b789-5083-96d0-f4d5bcf1cc5e",
  "slug": "southern-broccoli-and-cauliflower-salad",
  "name": "Southern Broccoli and Cauliflower Salad",
  "recipe_type": "salad",
  "brief_description": "This delicious Southern-inspired broccoli and cauliflower salad with a super creamy dressing, sweet raisins, crunchy almonds, and savory bacon is perfect for a potluck.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels until cool enough to handle, then chop into small pieces."
    },
    {
      "position": 2,
      "text": "Place bacon in a very large bowl with broccoli, cauliflower, almonds, raisins, Cheddar cheese, red onion, and celery."
    },
    {
      "position": 3,
      "text": "Whisk together mayonnaise, sour cream, cream cheese, sugar, and lemon juice in a separate bowl until creamy. Pour over broccoli-cauliflower mixture; stir until well combined. Refrigerate until flavors have melded, at least 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

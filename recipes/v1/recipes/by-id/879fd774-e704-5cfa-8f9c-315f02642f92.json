  "id": "879fd774-e704-5cfa-8f9c-315f02642f92",
  "slug": "best-air-fryer-pork-tenderloin-recipe-11895582",
  "name": "Best Air Fryer Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "This air fryer pork tenderloin first spends some time in a rich, deeply flavored marinade, and then is air fried until tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork, balsamic, soy sauce, honey, Dijon mustard, Worcestershire, olive oil, onion powder, garlic powder, and black pepper in a large zip lock bag.Seal bag and massage mixture around the meat until well combined and coated. Refrigerate at least 4 hours and up to 2 days."
    },
    {
      "position": 2,
      "text": "Remove pork from marinade and discard marinade. Sprinkle tenderloins with salt."
    },
    {
      "position": 3,
      "text": "Heat an air fryer to 400 degrees F (200 degrees C). Lightly coat air fryer basket with cooking spray or use an air fryer liner. Add pork tenderloins and cook 20 minutes, flipping halfway through. Let rest for 5 to 10 minutes before slicing and serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,
  "difficulty": "medium",

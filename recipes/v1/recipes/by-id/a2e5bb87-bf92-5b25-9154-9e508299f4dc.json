  "id": "a2e5bb87-bf92-5b25-9154-9e508299f4dc",
  "slug": "5-minute-microwave-cornbread",
  "name": "5 Minute Microwave Cornbread",
  "recipe_type": "appetizer",
  "brief_description": "This microwave cornbread is made with basic pantry ingredients in one bowl and will be on your dinner table in just 5 quick minutes. You'll be amazed!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together flour, cornmeal, milk, egg, sugar, oil, baking powder, and salt in a microwave-safe glass or ceramic bowl until well combined."
    },
    {
      "position": 2,
      "text": "Heat in the microwave on high until a toothpick inserted into the center comes out clean, about 3 minutes. Rotate the bowl halfway through cooking if the microwave does not have a turntable."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

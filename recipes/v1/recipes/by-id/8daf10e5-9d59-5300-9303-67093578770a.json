  "id": "8daf10e5-9d59-5300-9303-67093578770a",
  "slug": "pumpkin-oat-scones",
  "name": "Pumpkin Oat Scones",
  "recipe_type": "breakfast",
  "brief_description": "This pumpkin oat scones recipe features a warming blend of fall spices, including cloves and nutmeg, before being drizzled with a cinnamon-ginger icing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, oats, baking powder, 1 teaspoon cinnamon, nutmeg, salt, \u00bd teaspoon ginger, and cloves together in a bowl; cut in cold butter with a pastry blender or fork until the mixture resembles coarse crumbs. Whisk pumpkin pur\u00e9e, 2 tablespoons cold milk, egg, and vanilla extract together in a bowl; fold into flour mixture until just blended."
    },
    {
      "position": 3,
      "text": "Divide dough in half on a lightly floured surface. Shape each half into a ball; knead 10 to 12 times. Flatten balls to \u00bd-inch thickness; place 2 inches apart on a nonstick baking sheet. Cut rounds into sixths with a butter knife; do not separate wedges."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bottoms and edges are just golden brown, 12 to 16 minutes. Cool."
    },
    {
      "position": 5,
      "text": "Whisk confectioners' sugar, remaining 1 tablespoon milk, 1 pinch cinnamon, and 1 pinch ginger together in a small bowl; transfer to a resealable plastic bag, snip off a corner, and drizzle icing over cooled scones in a zig-zag pattern."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

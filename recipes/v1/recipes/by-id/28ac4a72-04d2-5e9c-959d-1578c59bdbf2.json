  "id": "28ac4a72-04d2-5e9c-959d-1578c59bdbf2",
  "slug": "potato-pancakes-ii",
  "name": "Easy Leftover Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Wondering what to do with leftover mashed potatoes? Make these easy, cheesy potato pancakes; serve with fried eggs for a delicious breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix potatoes, cheese, beaten egg, and salt in a medium bowl until well combined. If the mixture is very wet, mix in flour as needed to bind mixture together."
    },
    {
      "position": 3,
      "text": "Melt butter on a large griddle over medium heat."
    },
    {
      "position": 4,
      "text": "Drop potato mixture onto the hot griddle, 1/4 cup at a time."
    },
    {
      "position": 5,
      "text": "Flatten each pancake with the back of a spatula to 1/2-inch thickness."
    },
    {
      "position": 6,
      "text": "Fry until golden brown, about 5 minutes per side. Serve hot."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

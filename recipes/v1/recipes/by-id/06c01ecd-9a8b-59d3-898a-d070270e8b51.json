  "id": "06c01ecd-9a8b-59d3-898a-d070270e8b51",
  "slug": "fresh-tomato-curry-recipe-8690957",
  "name": "Fresh Tomato Curry Sauce",
  "recipe_type": "dessert",
  "brief_description": "Chef John's fresh tomato curry sauce is the best thing to make when you want to cook sweet, vine-ripened tomatoes. Simple, beautiful, and amazing, it's shown here with pork, but you can make this sauce for just about anything.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Use scissors to snip 4 or 5 small cuts around the edge of each chop to prevent curling. Season chops on both sides with salt, pepper, and cayenne. Add oil to a nonstick skillet over high heat, and sear pork chops on both sides until lightly browned, about 1 1/2 minutes per side. Remove meat to a plate, and reduce heat to medium."
    },
    {
      "position": 2,
      "text": "Add onions, jalapeno, ginger, garlic, and the 1/2 teaspoon salt to the pan. Cook, stirring, until onions start to turn translucent, 3 to 5 minutes. Add garam masala, cumin, and turmeric and cook, stirring, until spices are fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Add tomatoes and tamarind, and stir everything together. Add water; simmer until tomatoes completely soften and collapse, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Place a mesh strainer over a bowl, and pour in the tomato mixture. Press and scrape with the back of a spoon or ladle until only the tomato seeds and skins remain in the strainer."
    },
    {
      "position": 5,
      "text": "Transfer the strained sauce back into the pan, and add the meat, and any accumulated juices back in. Bring to a gentle simmer over medium heat; then reduce heat to maintain a low simmer, and cook until meat is tender, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Taste sauce for seasoning, and if desired, serve topped with yogurt, red onion, cashews, and cilantro leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

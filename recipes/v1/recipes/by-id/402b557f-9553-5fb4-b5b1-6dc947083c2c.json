  "id": "402b557f-9553-5fb4-b5b1-6dc947083c2c",
  "slug": "flank-steak-with-mushroom-sauce",
  "name": "Flank Steak with Mushroom Sauce",
  "recipe_type": "main",
  "brief_description": "Trendy, tasty, and impressive, this steak flank with mushroom sauce recipe is a mouthwatering way to prepare flank steak. The flavorful sauce is divine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a 10-inch skillet over medium heat. Add beef; cook until well browned on both sides and reaches desired doneness. An instant-read thermometer inserted into the center should read 130 degrees F (63 degrees C) for medium-rare, about 10 minutes. Remove beef from the skillet."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon butter and remaining 1 tablespoon oil in the same skillet. Add mushrooms; cook until tender, stirring occasionally, about 5 minutes. Add shallot, garlic, and rosemary; cook until just fragrant, about 30 seconds. Stir in concentrated broth, water, and remaining 1 tablespoon butter until butter melts. Remove from heat."
    },
    {
      "position": 3,
      "text": "Cut beef diagonally into thin slices against the grain. Serve mushroom sauce over beef."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c8599077-b1bf-5fbb-aed3-057e436169c0",
  "slug": "sous-vide-poached-eggs",
  "name": "Sous Vide \"Poached\" Eggs",
  "recipe_type": "breakfast",
  "brief_description": "Sous vide eggs with a perfectly set white and a runny yolk; this foolproof recipe might become your go-to method for perfectly poached eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water and place a sous vide immersion cooker into the water. Set temperature to 167 degrees F (75 degrees C) according to manufacturer's instructions; allow 15 minutes for the water to heat."
    },
    {
      "position": 2,
      "text": "Gently lower eggs into the water using a slotted spoon. Immediately set a kitchen timer for 13 minutes."
    },
    {
      "position": 3,
      "text": "Remove eggs from water once timer is up and let cool for 3 minutes. Gently crack egg around the middle and peel top half of shell. Slide egg out into a small bowl or serve over toast. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "three-bean-salad",
  "name": "Three Bean Salad",
  "recipe_type": "salad",
  "brief_description": "This three bean salad made with green beans, wax beans, and kidney beans keeps well, serves a lot of people, and is great for summer picnics and cookouts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together green beans, wax beans, kidney beans, onion, sugar, vinegar, vegetable oil, salt, pepper, and celery seed. Chill in refrigerator for at least 12 hours."
    },
    {
      "position": 3,
      "text": "Enjoy!"
    }
  ],

  "id": "0eb4d881-e2c2-542a-8017-9e0290cce653",
  "slug": "carrot-apple-pancakes-recipe-11804389",
  "name": "Carrot Apple Pancakes",
  "recipe_type": "salad",
  "brief_description": "These carrot apple pancakes, inspired by a carrot apple salad, are more like carrot cake meets apple fritter meets pancakes. If you'd like a perfect bite of a perfect pancake, here it is.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel and grate enough carrot to fill a 1-cup measuring cup, unpacked. Melt 3 tablespoons butter in a large nonstick skillet over medium-high heat. Add grated carrots and salt, and cook, stirring, until carrot begins to lose its raw character and softens only slightly, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Transfer carrots into a bowl, and add ginger, cinnamon, white sugar, egg, and lemon juice. Stir well to combine. Grate apple into the bowl, and stir to combine."
    },
    {
      "position": 3,
      "text": "Add self-rising flour, and stir until it disappears. Let batter rest about 5 minutes. Meanwhile, melt remaining 2 tablespoons butter in the same skillet used for carrots over medium heat."
    },
    {
      "position": 4,
      "text": "Once the butter melts, transfer in about 1/4 cup batter per pancake, and flatten slightly with the back of the spoon. Cook pancakes until browned and cooked through, about 3 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve topped with an optional spoon of yogurt, maple syrup, and chopped walnuts if desired."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 5,
  "difficulty": "easy",

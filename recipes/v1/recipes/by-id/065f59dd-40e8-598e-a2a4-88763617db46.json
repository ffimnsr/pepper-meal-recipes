  "id": "065f59dd-40e8-598e-a2a4-88763617db46",
  "slug": "grilled-veggie-skewers",
  "name": "Grilled Veggie Skewers",
  "recipe_type": "side",
  "brief_description": "These veggie kabobs with grilled zucchini, bell pepper, mushrooms, onions, and tomatoes make an easy and flavorful vegetable side dish for summer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Alternately thread pineapple chunks, zucchini slices, yellow squash slices, mushrooms, onion chunks, tomatoes, and bell pepper chunks onto skewers."
    },
    {
      "position": 3,
      "text": "Whisk olive oil, basil, oregano, salt, and black pepper in a bowl; brush some of the mixture over vegetables."
    },
    {
      "position": 4,
      "text": "Cook skewers on the preheated grill until vegetables are tender and lightly charred, turning and basting vegetables with remaining olive oil mixture occasionally, 10 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

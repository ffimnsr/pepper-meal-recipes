  "id": "e4401dc2-9ce1-5bce-b536-c49497655c6f",
  "slug": "cordon-bleu-chicken-rolls",
  "name": "Cordon Bleu Chicken Rolls",
  "recipe_type": "main",
  "brief_description": "Breaded chicken stuffed with ham and cheese tastes extraordinary. This cordon bleu chicken recipe is the best with an easy cream sauce to boot.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Make the chicken rolls: Place each chicken breast half between sheets of plastic wrap and pound with a meat mallet to about 1/8 inch thickness."
    },
    {
      "position": 3,
      "text": "Place a piece of cheese on each ham slice and sprinkle lightly with thyme and salt and pepper to taste. Roll up seasoned ham and cheese jellyroll-style, then roll each chicken breast with ham and cheese inside. Tuck in ends and fasten with toothpicks."
    },
    {
      "position": 4,
      "text": "Place melted butter in a small bowl and place cereal crumbs in a shallow dish or bowl. Dip each chicken roll in butter, then roll in crumbs, turning to coat thoroughly. Place coated rolls in the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until chicken is golden brown and juices run clear, about 40 minutes."
    },
    {
      "position": 6,
      "text": "While the chicken is cooking, prepare the cordon bleu sauce: Mix together condensed soup, sour cream, and lemon juice in a small saucepan. Heat over low heat, stirring occasionally, until combined."
    },
    {
      "position": 7,
      "text": "Serve sauce hot over chicken rolls. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "50407031-3e8d-5669-8408-a10b8d4476df",
  "slug": "apple-crisp-iii",
  "name": "Cinnamon Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "This apple and cinnamon crisp recipe is the easiest apple dessert ever. It has a very traditional buttery crisp topping without oats!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Cream sugar and butter together in a bowl with an electric mixer. Blend in flour."
    },
    {
      "position": 3,
      "text": "Place apples into the prepared baking dish and sprinkle with cinnamon. Pour in water, then sprinkle sugar-butter mixture evenly over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until apples are tender and the crust is golden, 30 to 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

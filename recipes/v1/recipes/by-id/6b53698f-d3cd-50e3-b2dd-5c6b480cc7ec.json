  "id": "6b53698f-d3cd-50e3-b2dd-5c6b480cc7ec",
  "slug": "chocolate-chip-cookie-bars-recipe-8417110",
  "name": "Chocolate Chip Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "These chocolate chip cookie bars with mini chocolate chips and toasted walnuts have all the flavor of chocolate chip cookies and all the ease of a bar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Line bottom and sides of a 13x9-inch baking pan with heavy duty aluminum foil, leaving a 2-inch overhang on all sides, lightly spray with baking spray; set aside."
    },
    {
      "position": 3,
      "text": "Beat together white sugar, brown sugar, and butter with a stand mixer fitted with paddle attachment on medium speed until light and fluffy, about 3 minutes, stopping to scrape down sides as needed."
    },
    {
      "position": 4,
      "text": "With mixer running on low, add eggs, one at a time, beating until just combined after each addition. Beat in vanilla until just combined."
    },
    {
      "position": 5,
      "text": "Whisk together flour, baking powder, salt, and baking soda in a medium bowl until combined. With stand mixer running on low speed, gradually beat in flour mixture until almost fully incorporated, about 2 minutes, stopping to scrape down sides as needed."
    },
    {
      "position": 6,
      "text": "Stir in chocolate chips and toasted walnuts until combined."
    },
    {
      "position": 7,
      "text": "Transfer dough into prepared baking pan, spreading into an even layer."
    },
    {
      "position": 8,
      "text": "Bake in preheated oven until golden brown and set, about 35 to 40 minutes, rotating baking pan front to back halfway through."
    },
    {
      "position": 9,
      "text": "Let cookie cool completely in pan on wire rack, about 1 hour. Using foil overhang as handles, lift cookie out of pan."
    },
    {
      "position": 10,
      "text": "Cut into 24 (about 2-inch) squares. Enjoy! Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,

  "schema_version": 1,
  "id": "730a7343-b622-56d2-ae1f-73b21194ccac",
  "slug": "pumpkin-conchas",
  "name": "Pumpkin Conchas",
  "recipe_type": "dessert",
  "brief_description": "Pumpkin puree adds a seasonal twist to this famous Mexican sweet bread that is perfect for breakfast or brunch during pumpkin season.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, pumpkin puree, warm milk, egg yolk, melted butter, sugar, active dry yeast, salt, and vanilla extract in the bowl of a stand mixer with the dough hook attachment. Mix until a smooth, slightly elastic ball forms or knead by hand for about 5 minutes."
    },
    {
      "position": 2,
      "text": "Place the dough in a lightly greased mixing bowl, cover, and let rise in a warm place until doubled in size, about 2 hours."
    },
    {
      "position": 3,
      "text": "While dough is rising, combine powdered sugar, flour, butter, cinnamon, allspice, nutmeg, salt, and vanilla extract in a bowl for the topping. Mix with your hands or a spatula until a moldable dough forms. Mix in orange food coloring if you like."
    },
    {
      "position": 4,
      "text": "Divide topping dough into 6 equal portions and shape them into balls; set onto a parchment lined baking sheet. Cover each ball with a sheet of plastic and press down with something flat and heavy (like the bottom of a glass or measuring cup) into a flat circle. Take the tip of a knife and score a pumpkin design into the topping. Place in the refrigerator to allow butter to firm up."
    },
    {
      "position": 5,
      "text": "After the dough rises, transfer it onto a work surface and press down to remove the air. Cut into 6 equal portions and roll each portion into a smooth ball. Transfer balls onto a Silpat-lined baking sheet and press down to flatten lightly. Place the topping on top of the dough balls. Allow to proof until doubled in size, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the center of a preheated oven until puffed up and golden, about 20 minutes. Allow to cool to room temperature, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

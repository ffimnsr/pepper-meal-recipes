  "schema_version": 1,
  "id": "e7ca1a66-6e15-5fb2-956c-d992fa5f5ed6",
  "slug": "old-fashioned-chicken-and-dumplings",
  "name": "Old Fashioned Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "A whole chicken is boiled in water with salt and pepper to create the stock for this one-dish meal with chicken meat and steamed dumplings made from scratch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with water, and add whole chicken. Bring to a boil, and then reduce heat. Simmer until tender, about 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken from broth, and set aside to cool. Reserve broth. When cool enough to handle, remove meat from bones; cut into bite size pieces. Discard skin and bones."
    },
    {
      "position": 3,
      "text": "In a medium bowl, stir together flour and salt. Break one egg into flour, and stir with fork till stiff. Continue adding eggs one at a time until all are incorporated. The dough should be very stiff."
    },
    {
      "position": 4,
      "text": "Bring broth to a boil. Add bouillon cubes; stir until cubes have dissolved."
    },
    {
      "position": 5,
      "text": "Using a fork and knife, pick up dough on fork. Hold over boiling broth, and cut off small pieces into broth until all the dough has been used. Stir, cover, and simmer for 20 minutes."
    },
    {
      "position": 6,
      "text": "Add chicken meat, and stir. Serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

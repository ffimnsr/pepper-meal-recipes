  "id": "8a95e3a8-02a2-5692-9ab5-c7ddc75ef676",
  "slug": "dirty-martini-deviled-eggs-recipe-11932822",
  "name": "Dirty Martini Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These Dirty Martini deviled eggs have a cocktail-inspired twist with a briny, boozy edge. They're a great appetizer for a summer pool party or a cocktail party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice eggs in half lengthwise, carefully remove yolks, and set egg whites aside."
    },
    {
      "position": 2,
      "text": "Add yolks to a bowl, and mash using a fork. Stir in mayonnaise, gin, olive brine, dry vermouth, mustard powder, salt, and pepper until well combined and smooth (for a totally creamy texture, place everything in a mini food processor, and blend until smooth). Stir in minced green olives until well combined."
    },
    {
      "position": 3,
      "text": "Add yolk mixture to a piping bag and using a large tip, pipe into each egg white. You also can fill with a spoon, or use a resealable plastic bag with a corner clipped to pipe out the yolks."
    },
    {
      "position": 4,
      "text": "Chill until ready to serve. Garnish each deviled egg with a whole olive, secured with a toothpick."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

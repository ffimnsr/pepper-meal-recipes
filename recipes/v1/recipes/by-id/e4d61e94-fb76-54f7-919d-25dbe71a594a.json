  "id": "e4d61e94-fb76-54f7-919d-25dbe71a594a",
  "slug": "chocolate-covered-caramel-corn",
  "name": "Chocolate-Covered Caramel Corn Recipe",
  "recipe_type": "dessert",
  "brief_description": "In this chocolate-covered caramel corn recipe, buttery popcorn is tossed with peanuts, glazed with caramel, and baked until crunchy. A drizzle of chocolate makes this a big-batch snack that will please a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 bag popcorn in the microwave; cook on high until popping begins to slow down, about 2 1/2 minutes. Repeat with remaining bags. Open bags carefully; divide popcorn between 2 shallow baking dishes. Mix in peanuts."
    },
    {
      "position": 2,
      "text": "Preheat oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, margarine, corn syrup, and salt in a saucepan over medium heat. Bring to a boil, stirring to blend. Simmer, stirring constantly, for 5 minutes. Remove from heat; mix in vanilla extract and baking soda until mixture is light and foamy."
    },
    {
      "position": 4,
      "text": "Pour brown sugar mixture over popcorn-peanut mixture; stir to coat."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, stirring every 25 minutes, until a cooled piece of popcorn is crunchy, about 1 hour."
    },
    {
      "position": 6,
      "text": "Line a flat work surface with waxed paper. Pour popcorn onto the waxed paper. Break up any large clusters."
    },
    {
      "position": 7,
      "text": "Melt chocolate almond bark in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring each time until smooth, 1 to 3 minutes. Pour into a resealable plastic bag; snip off 1 corner. Drizzle melted chocolate over popcorn. Let popcorn cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,

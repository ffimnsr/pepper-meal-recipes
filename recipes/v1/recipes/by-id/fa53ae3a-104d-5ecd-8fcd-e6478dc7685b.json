  "id": "fa53ae3a-104d-5ecd-8fcd-e6478dc7685b",
  "slug": "samhain-pumpkin-bread",
  "name": "Samhain Pumpkin Bread",
  "recipe_type": "dessert",
  "brief_description": "This super-moist Samhain pumpkin bread recipe blends warming spices\u2014cloves, nutmeg, and cinnamon\u2014with canned pumpkin for rich, fall-forward flavors.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 loaf pans."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, cinnamon, baking soda, nutmeg, allspice, cloves, and salt in a large bowl. Whisk pumpkin, eggs, water, vegetable oil, and vanilla together in a separate bowl. Whisk pumpkin mixture into flour mixture until everything is well mixed: fold in walnuts. Divide batter between the 2 prepared loaf pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until top is golden and springs back when lightly pressed, 50 to 60 minutes. Cool for 20 minutes before removing from the pans."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

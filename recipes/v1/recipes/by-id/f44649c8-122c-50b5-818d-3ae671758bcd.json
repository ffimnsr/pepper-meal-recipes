  "id": "f44649c8-122c-50b5-818d-3ae671758bcd",
  "slug": "oven-beef-stew",
  "name": "Oven Beef Stew",
  "recipe_type": "soup",
  "brief_description": "Potatoes, carrots, and condensed onion and mushroom soups cook along with the meat for 4 to 5 hours. Green peas are added in the last 15 minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "In a 2 to 3 quart casserole dish, combine the stew meat, potatoes, carrots, mushroom soup, French onion soup and water. Mix together well."
    },
    {
      "position": 3,
      "text": "Bake, uncovered, for 4 to 5 hours, stirring occasionally. Mix in the peas 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

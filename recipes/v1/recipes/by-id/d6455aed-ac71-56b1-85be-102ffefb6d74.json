  "id": "d6455aed-ac71-56b1-85be-102ffefb6d74",
  "slug": "french-toast-without-milk",
  "name": "French Toast without Milk",
  "recipe_type": "breakfast",
  "brief_description": "Fluffy French toast without milk flavored with cinnamon, nutmeg, and vanilla for a delicious, easy-to-make, family-approved breakfast dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs in a wide mixing bowl; mix in sugar, vanilla extract, cinnamon, and nutmeg."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium-low heat."
    },
    {
      "position": 4,
      "text": "Dip 2 slices of bread into egg mixture, ensuring both sides are covered; place in the skillet and cook until golden brown, about 4 minutes per side. Repeat with remaining 2 slices of bread. Serve warm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

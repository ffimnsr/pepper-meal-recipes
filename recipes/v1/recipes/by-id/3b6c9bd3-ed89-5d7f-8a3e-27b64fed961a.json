  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3b6c9bd3-ed89-5d7f-8a3e-27b64fed961a",
  "slug": "the-cheesecake-factory-thai-chicken-lettuce-wraps-recipe-11705828",
  "name": "The Cheesecake Factory Thai Chicken Lettuce Wraps",
  "recipe_type": "salad",
  "brief_description": "These copycat Cheesecake Factory Thai chicken lettuce wraps are a glorious platter of chicken satay, peanut sauce, coconut curry noodles, and cucumber salad, all to add to lettuce to make fresh wraps.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "For peanut sauce, stir peanut butter, soy sauce, lime juice, rice vinegar, grated garlic, grated ginger, sesame oil, sweet chili sauce, and crushed red pepper together in a bowl until well combined; refrigerate until ready to serve."
    },
    {
      "position": 2,
      "text": "For chicken satay, whisk yellow curry paste, honey, grated ginger, grated garlic, coconut milk, lime juice, salt, and oil together in a bowl until well combined. Add chicken tenders and toss to coat. Cover and refrigerate at least 45 minutes or up to overnight."
    },
    {
      "position": 3,
      "text": "For cucumber salad, toss cucumbers with salt in a colander; leave in the sink to drain for 30 minutes. Rinse with cold water, then drain and pat dry with paper towels."
    },
    {
      "position": 4,
      "text": "Whisk sugar and vinegar together in a mixing bowl until sugar has dissolved. Add cucumbers, jalape\u00f1os, and cilantro; toss to combine. Sprinkle chopped peanuts on top just before serving."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Heat a lightly greased grill pan over high heat. Add tenders to the hot grill pan and cook, undisturbed, until they are browned and release easily from the pan, about 2 minutes. Flip and cook 1 minute more. Transfer chicken to a baking sheet."
    },
    {
      "position": 6,
      "text": "Bake chicken in the preheated oven until no longer pink at the center and juices run clear, 8 to 10 minutes. Keep warm or refrigerate until ready to serve."
    },
    {
      "position": 7,
      "text": "For coconut curry noodles, bring a large pot of water to a boil over high heat. Add 2 teaspoons salt and rice noodles and cook for 2 minutes; drain and rinse with cold water. Using a knife or kitchen shears, cut noodles into smaller pieces and set aside."
    },
    {
      "position": 8,
      "text": "Return the pot to medium heat and add coconut milk, yellow curry paste, and remaining salt and whisk to combine. Bring to a simmer and cook until slightly thickened, about 4 minutes. Add noodles to sauce and stir until well coated; remove from heat. Sprinkle with black sesame seeds if desired."
    },
    {
      "position": 9,
      "text": "Serve chicken, peanut sauce, and noodles on a large platter with cucumber salad, cabbage, lettuce, carrots, and cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 60,

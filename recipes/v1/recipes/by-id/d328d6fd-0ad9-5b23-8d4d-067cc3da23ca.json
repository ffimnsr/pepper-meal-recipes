  "id": "d328d6fd-0ad9-5b23-8d4d-067cc3da23ca",
  "slug": "simple-french-toast-in-a-cup",
  "name": "Simple French Toast in a Cup",
  "recipe_type": "breakfast",
  "brief_description": "This French toast in a cup is quick and easy to make and is great for breakfast, lunch, or a snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in the bottom of a large microwave-safe mug in the microwave, about 30 seconds. Tilt mug to coat all sides with melted butter."
    },
    {
      "position": 2,
      "text": "Stir melted butter, milk, egg, cinnamon, sugar, and vanilla extract together in the mug. Press bread cubes into milk mixture."
    },
    {
      "position": 3,
      "text": "Microwave on High until set, about 90 seconds."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

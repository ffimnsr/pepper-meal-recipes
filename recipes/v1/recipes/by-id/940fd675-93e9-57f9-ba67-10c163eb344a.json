  "id": "940fd675-93e9-57f9-ba67-10c163eb344a",
  "slug": "flannerys-bacon-avocado-burritos",
  "name": "Flannery's Bacon Avocado Burritos",
  "recipe_type": "breakfast",
  "brief_description": "Make these filling bacon and avocado burritos when you're on the go!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 1/2 teaspoons butter in a skillet over medium heat. Cook and stir potatoes in hot butter until tender, 10 to 15 minutes. Transfer potatoes to a bowl."
    },
    {
      "position": 2,
      "text": "Melt remaining butter in the same skillet over medium-high heat. Saute onion in hot butter until onion is soft and translucent, 5 to 10 minutes. Transfer onion to a bowl."
    },
    {
      "position": 3,
      "text": "Beat eggs, salt, and pepper together in a bowl. Reduce heat under skillet to medium. Cook and stir eggs in hot skillet until set, 3 to 5 minutes; transfer to a plate."
    },
    {
      "position": 4,
      "text": "Spread tortillas out onto a work surface. Spoon potatoes, onion, eggs, bacon, Cheddar cheese, avocado, salsa, and sour cream in a line across the middle of a tortilla. Fold opposing edges of each tortilla to overlap the filling. Roll 1 of the opposing edges around the filling into a burrito."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "972fa8c9-cca1-5934-9df8-64c4f10211ba",
  "slug": "cajun-shrimp-and-andouille-nachos",
  "name": "Cajun Shrimp and Andouille Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Cajun-seasoned shrimp, andouille sausage, and the trinity are piled high on tortilla chips and smothered in melty cheese for nachos you won't soon forget.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium-high heat. Add andouille and cook for 2 minutes. Add onion and cook for 2 minutes more. Add bell peppers and cook for 2 minutes more. Remove from heat and stir in celery."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with foil and place tortilla chips on top. Cover chips with the sausage mixture."
    },
    {
      "position": 3,
      "text": "Place shrimp in a bowl; add oil and seafood seasoning. Stir to coat. Place shrimp in the same skillet and cook over medium-high heat for 3 minutes. Scatter shrimp on top of the sausage mixture. Sprinkle Colby Jack cheese over the nachos."
    },
    {
      "position": 4,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler to low. Broil nachos until cheese has melted, about 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

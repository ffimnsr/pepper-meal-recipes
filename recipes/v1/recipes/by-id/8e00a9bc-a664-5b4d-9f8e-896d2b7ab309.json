  "id": "8e00a9bc-a664-5b4d-9f8e-896d2b7ab309",
  "slug": "fresh-pear-cake",
  "name": "Fresh Pear Cake",
  "recipe_type": "dessert",
  "brief_description": "This beautiful pear cake is bursting with soft chunks of fresh pear and crunchy pecans. It's flavored with warm spices for a fragrant fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine pears and sugar in a large bowl; let stand for one hour."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Generously spray a 10-inch Bundt pan with non-stick cooking spray."
    },
    {
      "position": 4,
      "text": "Beat egg whites until combined; mix in oil, chopped pecans, and pear mixture."
    },
    {
      "position": 5,
      "text": "Mix flour, salt, baking soda, nutmeg, cinnamon, and cloves together; stir into pear mixture. Pour cake batter into the prepared Bundt pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour and 10 minutes. Let cool on a wire rack for 10 minutes before removing from the pan."
    },
    {
      "position": 7,
      "text": "Invert carefully onto a serving plate or rack and let cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

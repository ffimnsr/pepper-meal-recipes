  "id": "e0c2d9ab-b965-5894-ba0c-1890915135ec",
  "slug": "cha-chas-white-chicken-chili",
  "name": "Cha Cha's White Chicken Chili",
  "recipe_type": "soup",
  "brief_description": "Cha Cha's chili with chicken and white beans is easy to make with leftover chicken, canned jalape\u00f1os and chile peppers, and Monterey Jack cheese.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over medium-low heat. Add onion; cook and stir until tender, 5 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Add jalape\u00f1o peppers, chile peppers, garlic, cumin, oregano, and cayenne pepper; cook and stir for 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir in beans, chicken broth, and chicken. Simmer for 15 minutes, stirring occasionally."
    },
    {
      "position": 5,
      "text": "Remove from the heat. Slowly stir in cheese until melted."
    },
    {
      "position": 6,
      "text": "Serve warm. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

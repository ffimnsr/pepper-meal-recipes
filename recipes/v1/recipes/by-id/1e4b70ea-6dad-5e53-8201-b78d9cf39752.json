  "id": "1e4b70ea-6dad-5e53-8201-b78d9cf39752",
  "slug": "slow-cooker-oats",
  "name": "Slow Cooker Oats",
  "recipe_type": "dessert",
  "brief_description": "Start steel-cut oats in the crockpot at night and you'll wake up to a slow cooker bubbling with a hot, hearty mixture of sweet oats, apples, and raisins.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, steel-cut oats, apple, raisins, butter, brown sugar, cinnamon, and vanilla in a slow cooker; stir until well combined and sugar is dissolved. Cover and cook on Low until oats are tender and creamy, 6 to 7 hours. For a softer texture, cook for 8 hours. If your slow cooker runs hot, cook on the Warm setting instead of Low."
    }
  ],

  "id": "7edc83cb-5cf4-5d8b-ae9b-71d98249ed7b",
  "slug": "apple-cinnamon-roll-casserole-recipe-11849180",
  "name": "Apple Cinnamon Roll Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This apple cinnamon roll casserole, made with refrigerated cinnamon roll dough, is puffy and warm, with a crunchy streusel topping and a drizzle of cinnamon icing. It's perfect for holiday breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut each cinnamon roll into 1-inch pieces and set icing aside."
    },
    {
      "position": 2,
      "text": "Lightly grease a 9x13-inch baking dish; add cinnamon roll pieces to the dish. Dollop apple pie filling randomly among cinnamon roll pieces and pour heavy cream evenly over the casserole."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate at least 4 hours or overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 5,
      "text": "Combine butter, flour, brown sugar, oats, and 1 1/2 teaspoons cinnamon in a bowl, and use a pastry cutter or a fork to mix until large crumbs form and everything is well combined. Uncover the casserole and spread the streusel topping evenly over the top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until browned and bubbly, about 45 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, whisk icing from the package and remaining cinnamon together in a small bowl. Drizzle over the warm casserole."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

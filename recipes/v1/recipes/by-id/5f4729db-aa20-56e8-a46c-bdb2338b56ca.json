  "slug": "frozen-fruit-smoothie-recipe-8624320",
  "name": "Frozen Fruit Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This frozen fruit smoothie is fast, simple, nutritious, and tasty with extra protein from the Greek yogurt. It\u2019s a great on-the-go breakfast or afternoon snack. With a banana as a base, choose your favorite frozen fruits such as strawberries, cherries, pineapple, raspberries, and blueberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add juice, frozen fruit, frozen banana, and yogurt to the jar of a blender, and process until smooth. If too thick, add a little more pineapple juice until you reach your desired consistency."
    },
    {
      "position": 2,
      "text": "Pour into glasses and serve."
    }
  ],
  "servings": 3,

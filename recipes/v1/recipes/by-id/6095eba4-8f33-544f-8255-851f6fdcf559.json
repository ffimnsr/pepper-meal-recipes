  "id": "6095eba4-8f33-544f-8255-851f6fdcf559",
  "slug": "cajun-crab-cakes-no-breadcrumbs",
  "name": "Cajun Crab Cakes (No Breadcrumbs)",
  "recipe_type": "appetizer",
  "brief_description": "These Creole-spiced crab cakes make a delicious side dish or appetizer. The key is to use a small amount of crumbled crackers instead of breadcrumbs for a lighter, less-starchy cake.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large, heavy skillet over medium heat. Stir in onion; cook and stir until the onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in the celery, bell pepper, green onion, carrot, and garlic. Continue to cook and stir until vegetables are tender, about 10 minutes more."
    },
    {
      "position": 3,
      "text": "Season with 1 tablespoon parsley flakes, 2 teaspoons Creole seasoning, basil, pepper, dill weed, oregano, and thyme. Cook and stir until fragrant, 5 minutes more."
    },
    {
      "position": 4,
      "text": "Transfer cooked vegetables to a large bowl; allow to cool for about 10 minutes. Set skillet aside for later use."
    },
    {
      "position": 5,
      "text": "Stir the beaten eggs into the vegetables. Mix in the crabmeat and cracker crumbs with your hands, making sure not to break up the chunks of crab too much."
    },
    {
      "position": 6,
      "text": "Shape the crab mixture into 12 small cakes."
    },
    {
      "position": 7,
      "text": "Heat vegetable oil in the skillet over medium high heat."
    },
    {
      "position": 8,
      "text": "Pan-fry the crab cakes in batches until golden brown on each side, about 3 minutes."
    },
    {
      "position": 9,
      "text": "To make dipping sauce: Whisk together the mayonnaise, chile-garlic sauce, 2 teaspoon Creole seasoning, 2 teaspoon parsley flakes, and paprika."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

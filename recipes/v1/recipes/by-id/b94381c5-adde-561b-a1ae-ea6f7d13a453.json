  "id": "b94381c5-adde-561b-a1ae-ea6f7d13a453",
  "slug": "quick-and-easy-hamburger-stroganoff",
  "name": "Quick and Easy Hamburger Stroganoff",
  "recipe_type": "soup",
  "brief_description": "This hamburger stroganoff recipe uses canned cream of mushroom soup and cream of chicken soup for an easy beef stroganoff to serve over noodles.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes; drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter in a large skillet over medium-high heat. Saut\u00e9 onion in hot butter until tender and translucent, about 5 minutes. Add ground beef in small chunks; cook and stir beef until browned and crumbly, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle flour over beef mixture; cook and stir for 1 minute. Stir in mushrooms and garlic salt."
    },
    {
      "position": 5,
      "text": "Pour in mushroom soup and chicken soup; cook and stir until heated through, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Stir in sour cream until smooth and heated through, 2 to 3 minutes more. Serve beef mixture over cooked egg noodles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

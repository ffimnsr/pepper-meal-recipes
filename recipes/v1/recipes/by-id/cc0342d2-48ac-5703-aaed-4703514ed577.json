  "id": "cc0342d2-48ac-5703-aaed-4703514ed577",
  "slug": "apple-streusel-pie",
  "name": "Apple Streusel Pie",
  "recipe_type": "dessert",
  "brief_description": "Bake this apple streusel pie for feast or family. The enticing smell of apples and cinnamon wafting out of the oven will make it clear why one pie will not suffice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 C)."
    },
    {
      "position": 2,
      "text": "Prepare the topping by combining the butter, brown sugar, flour and chopped pecans. Cut in all ingredients with pastry cutter until pea-sized. Set aside"
    },
    {
      "position": 3,
      "text": "Combine the apples, sugar, flour and cinnamon. Toss gently together and set aside."
    },
    {
      "position": 4,
      "text": "Place apple mixture in unbaked pie shells. Heap the apples up high in each shell and fill completely. Sprinkle topping on top of each."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 50 minutes. Do not allow topping to get too dark."
    }
  ],
  "servings": 16,

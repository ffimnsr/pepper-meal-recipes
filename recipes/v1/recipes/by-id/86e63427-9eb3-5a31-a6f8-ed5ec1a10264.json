  "id": "86e63427-9eb3-5a31-a6f8-ed5ec1a10264",
  "slug": "chef-johns-pumpkin-scones",
  "name": "Chef John's Pumpkin Scones",
  "recipe_type": "appetizer",
  "brief_description": "Pumpkin puree is a great addition to these scones.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees. Line a baking sheet with parchment paper or a silicone baking mat."
    },
    {
      "position": 2,
      "text": "Whisk together 1 3/4 cup flour, 1/4 cup sugar, baking powder, baking soda, and salt in a large bowl until combined. Mix butter into flour mixture using a pastry cutter until the mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Make a well in the center of the flour-butter mixture. Stir in pumpkin puree, buttermilk, and pine nuts until just combined."
    },
    {
      "position": 4,
      "text": "Sprinkle a work surface with 2 tablespoons flour. Turn out dough onto the floured work surface. Shape into a rectangle about 1 inch thick. Fold the rectangle in thirds, sprinkle with more flour as needed, and flatten to about 1 inch thick. Repeat 2 more times. Cut final rectangle into 6 equally-sized squares. Cut each square into triangles and transfer the scones to the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Whisk egg and milk together in a small bowl. Lightly brush the top of each scone with egg wash. Sprinkle 1 teaspoon sugar over scones."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes. Transfer to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,

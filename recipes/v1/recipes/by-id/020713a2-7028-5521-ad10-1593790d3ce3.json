  "id": "020713a2-7028-5521-ad10-1593790d3ce3",
  "slug": "ham-and-cheese-pretzel-panini",
  "name": "Ham and Cheese Pretzel Panini",
  "recipe_type": "main",
  "brief_description": "These quick and easy grilled pretzel panini with ham and Havarti are fun to make for a crowd, pressed using a heavy skillet or foil-wrapped bricks.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill to medium heat (325 to 375 degrees F (160 to 190 degrees C). Lightly oil grill grate."
    },
    {
      "position": 2,
      "text": "Divide ham and cheese among 8 pretzels arranged salt-sides down on a baking sheet. Top with remaining pretzels, salt-sides up."
    },
    {
      "position": 3,
      "text": "Transfer pretzel panini to grill and top with a heavy oven-safe skillet or bricks wrapped in foil to weigh them down. Close lid; grill panini until cheese is melted, 2 to 3 minutes per side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "acf69542-6940-527f-b720-d46ff6c824a1",
  "slug": "grilled-balsamic-and-soy-marinated-flank-steak",
  "name": "Grilled Balsamic and Soy Marinated Flank Steak",
  "recipe_type": "main",
  "brief_description": "Soy sauce, balsamic vinaigrette, onion, and garlic combine for a tasty marinade, ideal for flank steak before going on the grill.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk onion, garlic, olive oil, balsamic vinegar, soy sauce, Dijon mustard, rosemary, salt, and pepper together in a mixing bowl."
    },
    {
      "position": 2,
      "text": "Place flank steak into a large resealable plastic bag. Pour marinade into the bag and coat steak with the marinade. Squeeze excess air from the bag and seal. Marinate in the refrigerator at least 30 minutes, up to 2 days."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove steak from marinade and shake to remove excess liquid. Reserve marinade."
    },
    {
      "position": 5,
      "text": "Cook steak until firm, hot in the center, and just turning from pink to grey, 6 to 8 minutes per side, brushing occasionally with reserved marinade. An instant-read thermometer inserted into the center should read 150 degrees F (65 degrees C). Remove steak to a cutting board and rest meat 5 minutes before slicing thinly across the grain."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "3b29f392-9858-52ac-a239-bd27c078bb40",
  "slug": "summertime-strawberry-mojito",
  "name": "Summertime Strawberry Mojito",
  "recipe_type": "drink",
  "brief_description": "Strawberry syrup adds a delicious fruity twist to the lime and mint base of this refreshing summertime favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Juice 4 limes, yielding about 1/2 cup juice, and cut remaining lime into 6 wedges."
    },
    {
      "position": 2,
      "text": "Grasp mint sprig stems and slap leaves against a work surface to help release their oil; transfer to a sturdy glass pitcher. Stir in lime juice, rum, and strawberry syrup. Add club soda."
    },
    {
      "position": 3,
      "text": "Spread 1/4 to 1/2 inch sugar on a small, shallow plate. Run a lime wedge around the rim of each glass, then dip glass into sugar. Fill with ice. Pour in mojito mixture. Garnish with mint sprigs and strawberries."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "356fcd35-d8bf-51b4-9e81-a32416f86996",
  "slug": "ginger-turmeric-herbal-tea",
  "name": "Ginger-Turmeric Herbal Tea",
  "recipe_type": "dessert",
  "brief_description": "This ginger turmeric tea is a tasty way to add anti-inflammatory spices to your diet. Warm yourself up with this soothing drink sweetened with honey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a small saucepan; add turmeric, ginger, and cinnamon."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium-low and simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "Strain tea into a large glass."
    },
    {
      "position": 5,
      "text": "Stir in honey and serve with lemon wedge."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

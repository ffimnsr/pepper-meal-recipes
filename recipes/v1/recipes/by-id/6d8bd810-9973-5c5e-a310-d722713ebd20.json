  "id": "6d8bd810-9973-5c5e-a310-d722713ebd20",
  "slug": "sun-dried-tomato-chicken-and-veggie-quiche-recipe-11770246",
  "name": "Sun-Dried Tomato, Chicken, and Veggie Quiche",
  "recipe_type": "soup",
  "brief_description": "In this super-rich sun-dried tomato, chicken, and veggie quiche a can of condensed soup replaces the usual milk or cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly dust a work surface and roll dough into a 12-inch circle. Transfer dough circle to a 9-inch pie dish, pressing into bottom and up sides. Trim overhanging dough to about 1 inch beyond edges; fold dough under and crimp as desired. Prick bottom and sides of crust with a fork. Freeze until firm, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, place an oven rack in lower third of oven; preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake crust on the lower rack until light brown, about 10 minutes. Cool on a wire rack 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat sun-dried tomato oil in a large skillet over medium heat. Stir in frozen vegetables and sun-dried tomatoes; cook, stirring often, until tomatoes are dark red and vegetables are heated through, about 2 minutes. Stir in chicken and garlic powder. Remove from heat and let cool for 10 minutes."
    },
    {
      "position": 5,
      "text": "Whisk together eggs and condensed soup in a bowl."
    },
    {
      "position": 6,
      "text": "Spoon chicken mixture in an even layer in bottom of pie crust. Pour egg mixture over chicken mixture. Using a fork, gently stir filling two to three times to allow egg mixture to seep down into chicken mixture."
    },
    {
      "position": 7,
      "text": "Bake on the lower rack in the preheated oven until edges of filling are set but center still jiggles slightly, 35 to 40 minutes (loosely cover crust with foil if needed to prevent overbrowning). Cool on a wire rack at least 15 minutes before serving. Garnish with black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

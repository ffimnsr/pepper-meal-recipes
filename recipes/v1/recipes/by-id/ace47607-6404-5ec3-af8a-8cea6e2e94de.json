  "id": "ace47607-6404-5ec3-af8a-8cea6e2e94de",
  "slug": "cheesecake-truffles",
  "name": "Cheesecake Truffles",
  "recipe_type": "dessert",
  "brief_description": "These bite-sized, almond-flavored cheesecake truffles are dipped in white chocolate for the ultimate decadent dessert that's perfect for parties.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch springform pan."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, sugar, and almond extract in a bowl and whip using an electric mixer on low speed until combined. Beat in eggs 1 at a time. Pour into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, 30 to 35 minutes. Remove from the oven and let cool for 1 hour; refrigerate for at least 3 hours more."
    },
    {
      "position": 4,
      "text": "Scoop cheesecake into small balls using a melon baller or a tablespoon-sized scoop. Place on a wax paper-covered cookie sheet. Freeze cheesecake balls, 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "Place chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Stir in shortening until consistency is smooth and easy to work with."
    },
    {
      "position": 6,
      "text": "Dip each cheesecake ball into chocolate to coat; replace on the cookie sheet. Garnish with sliced almonds while chocolate is still warm."
    },
    {
      "position": 7,
      "text": "Refrigerate for 2 hours before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

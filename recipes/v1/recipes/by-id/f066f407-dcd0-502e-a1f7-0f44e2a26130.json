  "id": "f066f407-dcd0-502e-a1f7-0f44e2a26130",
  "slug": "grilled-sea-bass",
  "name": "Grilled Sea Bass",
  "recipe_type": "main",
  "brief_description": "This grilled sea bass recipe includes a delicious garlic-parsley butter for a truly flavorful fish dish that's elegant enough to serve to guests.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat grill for high heat."
    },
    {
      "position": 3,
      "text": "In a small bowl, stir together the garlic powder, onion powder, paprika, lemon pepper, and sea salt."
    },
    {
      "position": 4,
      "text": "Sprinkle seasonings onto the fish."
    },
    {
      "position": 5,
      "text": "In a small saucepan over medium heat, melt the butter with the garlic and parsley. Remove from heat when the butter has melted, and set aside."
    },
    {
      "position": 6,
      "text": "Lightly oil grill grate. Grill fish for 7 minutes, then turn and drizzle with butter. Continue cooking for 7 minutes, or until easily flaked with a fork. Drizzle with olive oil before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

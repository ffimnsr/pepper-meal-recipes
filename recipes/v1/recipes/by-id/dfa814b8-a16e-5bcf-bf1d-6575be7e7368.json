  "id": "dfa814b8-a16e-5bcf-bf1d-6575be7e7368",
  "slug": "really-creamy-fettuccine-alfredo",
  "name": "Really Creamy Fettuccine Alfredo",
  "recipe_type": "side",
  "brief_description": "Basil and nutmeg add a subtly different feel to this Philadelphia cream cheese Alfredo sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, Parmesan, margarine, milk, garlic powder, and basil in a medium saucepan. Stir over low heat until smooth and creamy, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Toss sauce with pasta and sprinkle with nutmeg."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

  "schema_version": 1,
  "id": "f0bd94c8-eba2-570c-8eb8-124828163e12",
  "slug": "mighty-granola",
  "name": "Mighty Granola",
  "recipe_type": "breakfast",
  "brief_description": "Make a big batch of this Mighty Granola packed with oats, amaranth, seeds, nuts, and dried fruit and you'll be set for breakfast for weeks.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line two baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine oats, amaranth, sunflower seeds, pecans, walnuts, almonds, flaxseed meal, and ground chia seeds in a very large bowl; stir until thoroughly mixed."
    },
    {
      "position": 3,
      "text": "Mix honey, maple syrup, coconut oil, brown sugar, butter, vanilla extract, cinnamon, and salt together in a large saucepan over medium heat. Bring to a boil, stirring constantly. Cook and stir, about 1 minute. Remove maple syrup mixture from heat."
    },
    {
      "position": 4,
      "text": "Pour maple syrup mixture over oat mixture in the bowl; stir until oat mixture is moist. Spread evenly on the baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until toasted, stirring mixture halfway through, about 20 minutes. Remove from oven and let cool, about 5 minutes. Transfer to a very large bowl. Add raisins, cherries, and blueberries; stir until thoroughly mixed."
    }
  ],
  "servings": 88,
  "cooking_time_minutes": 26,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

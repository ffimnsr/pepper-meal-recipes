  "id": "85c25eb1-a5fd-5852-9bcd-211afc34c21b",
  "slug": "tender-onion-baked-chicken",
  "name": "Tender Onion Baked Chicken",
  "recipe_type": "soup",
  "brief_description": "Chicken gets a flavor bang when baked with dried onion soup mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken in a 9x13 inch baking dish. Pour melted margarine over the chicken strips. Season with salt and pepper, and sprinkle with dry onion soup mix."
    },
    {
      "position": 3,
      "text": "Bake 40 minutes in the preheated oven, or until chicken is no longer pink and juices run clear."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,

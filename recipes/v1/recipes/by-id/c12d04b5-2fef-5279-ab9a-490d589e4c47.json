  "id": "c12d04b5-2fef-5279-ab9a-490d589e4c47",
  "slug": "summer-strawberry-trifle-recipe-12010264",
  "name": "Summer Strawberry Trifle",
  "recipe_type": "dessert",
  "brief_description": "This wonderful summer strawberry trifle, with sliced fresh strawberries, angel food cake, and instant pudding, has a center layer of cream cheese and whipped topping, rich and tangy, that adds a special touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Take half of the cake and \u201cpick\u201d it into chunks; place chunks into a trifle bowl. Mix 1 package of vanilla instant pudding with 3 cups milk, as directed on pudding package. Spread evenly over cake pieces. Add 1 layer of sliced strawberries."
    },
    {
      "position": 2,
      "text": "Mix together cream cheese, confectioner\u2019s sugar, and 1 (8 ounce) container whipped topping in a bowl with an electric mixer. Spread this over the strawberries."
    },
    {
      "position": 3,
      "text": "Repeat the first 3 layers: pick remaining cake half into chunks and place cake over cream cheese layer. Mix remaining package pudding with milk as directed, spread evenly over cake, and then add remaining strawberries on top."
    },
    {
      "position": 4,
      "text": "Cover strawberries remaining container of whipped topping. Refrigerate overnight."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "0dc5b68e-00e0-5ed1-9b9f-d844d8e2b726",
  "slug": "easy-arugula-salad",
  "name": "Easy Arugula Salad",
  "recipe_type": "salad",
  "brief_description": "Let this simple arugula salad take your main dish to stellar heights! With Parmesan, tomatoes, avocado, and pine nuts, it's quick, easy, and delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine arugula, tomatoes, pine nuts, Parmesan, oil, and vinegar in a large, lidded plastic bowl. Season with salt and pepper, then cover with the lid and shake to mix."
    },
    {
      "position": 2,
      "text": "Divide salad onto serving plates and top with avocado slices."
    }
  ],
  "servings": 4,

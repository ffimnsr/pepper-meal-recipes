  "schema_version": 1,
  "id": "4e2dfdd2-a125-5284-b2ab-8cb0058a376f",
  "slug": "ham-bone-and-green-split-pea-soup",
  "name": "Ham Bone and Green Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "This split pea soup with ham bone is quick to prepare. The addition of onion, celery, carrots, and garlic create a hearty combination of flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter and oil in a stockpot or Dutch oven over medium-low heat. Add celery, carrot, onion, and salt; cook and stir until tender, about 5 minutes. Stir in peas and garlic."
    },
    {
      "position": 3,
      "text": "Nestle ham bone into the pot; add stock and diced ham. Add enough water so that liquid is about 1 1/2 inches from the top of the pot; bring to a boil."
    },
    {
      "position": 4,
      "text": "Reduce heat to low and cover. Simmer, stirring every 30 minutes and scraping the bottom of the pot, until peas are mostly disintegrated, about 2 1/2 hours. Turn ham bone and skim the surface for fat once every hour."
    },
    {
      "position": 5,
      "text": "Remove ham bone from the pot and place on a cutting board until cool enough to handle. Remove any meat from the bones and cut into bite-sized pieces; stir into soup until warmed through and season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 155,
  "preparation_time_minutes": 15,

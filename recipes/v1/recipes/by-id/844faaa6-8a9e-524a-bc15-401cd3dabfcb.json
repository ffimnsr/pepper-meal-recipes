  "id": "844faaa6-8a9e-524a-bc15-401cd3dabfcb",
  "slug": "south-of-the-border-shrimp-and-grits",
  "name": "South of the Border Shrimp and Grits",
  "recipe_type": "main",
  "brief_description": "Made with pantry staples and Mexican-inspired ingredients, this shrimp and grits dinner takes only 30 minutes to prepare.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine evaporated milk, grits, chicken broth, and butter in a saucepan over medium-high heat; bring to a boil. Cook, stirring constantly, until thickened, 5 to 7 minutes. Add Cheddar cheese and stir until incorporated. Remove from the heat and set aside."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until crisp and browned, about 3 minutes per side. Drain bacon slices on paper towels and chop when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Add bell peppers to the bacon grease. Add shrimp and taco seasoning. Cook and stir until peppers are heated through and shrimp are bright pink on the outside and the meat is opaque, 3 to 5 minutes. Stir in chopped bacon."
    },
    {
      "position": 4,
      "text": "Place a dollop of grits in each bowl and top with shrimp mixture and hot sauce."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

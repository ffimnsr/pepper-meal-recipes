  "id": "cf93cd97-491b-5f82-91fa-e719ef73de87",
  "slug": "potato-chip-latkes-recipe-8764568",
  "name": "Potato Chip Latkes",
  "recipe_type": "appetizer",
  "brief_description": "Chef John\u2019s potato chip latkes, made with crushed kettle potato chips, are much more than a time-saving hack\u2014they actually are the intensely potato-flavored, perfectly-textured potato latke of your dreams.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potato chips in a bowl, and crumble with your hands until finely crushed; you will need 1 cup crushed chips."
    },
    {
      "position": 2,
      "text": "To make the potato latke batter; whisk egg, milk, water, salt, flour, baking powder, black pepper, onions, and cayenne together in a large bowl until combined. Add the 1 cup of crushed potato chips and stir together until evenly combined."
    },
    {
      "position": 3,
      "text": "Wrap bowl and refrigerate until mixture has thickened, 30 to 60 minutes, or up to overnight."
    },
    {
      "position": 4,
      "text": "Heat oil in nonstick skillet set over medium heat. Drop batter in 4 equal portions into the hot oil. and cook on the first side, undisturbed, until browned, about 4 minutes."
    },
    {
      "position": 5,
      "text": "Turn latkes over and cook on the second side until browned, 3 to 4 minutes. Remove to a plate lined with a paper towel to drain for 1 minute."
    },
    {
      "position": 6,
      "text": "Serve with apple sauce, sour cream, and fresh chives."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

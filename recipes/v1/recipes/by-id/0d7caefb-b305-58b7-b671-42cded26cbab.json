  "id": "0d7caefb-b305-58b7-b671-42cded26cbab",
  "slug": "ratatouille-chicken-pot-pie-recipe-11960320",
  "name": "Ratatouille Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This chicken pot pie gets a fresh, flavorful, lighter twist with zucchini, peppers, onion, and tomato, inspired by ratatouille. The golden brown puff pastry crust adds the perfect flaky finish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (204 degrees C). Lightly grease a 2-quart rectangular baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Heat oil in an extra-large skillet over medium. Add onion; cook and stir until softened, 4 to 5 minutes. Add garlic and cook until fragrant, 1 minute."
    },
    {
      "position": 3,
      "text": "Add zucchini, bell peppers, and salt. Cook, stirring occasionally, until tender, about 8 minutes. Stir in diced tomatoes."
    },
    {
      "position": 4,
      "text": "Whisk together chicken stock, cornstarch, Herbes de Provence, and pepper in a small bowl until well combined. Pour into skillet and bring to a boil over medium-high heat."
    },
    {
      "position": 5,
      "text": "Stir in chicken. Transfer mixture to prepared baking dish."
    },
    {
      "position": 6,
      "text": "Quickly roll puff pastry to fit the top of the baking dish and lay on top of chicken and vegetable mixture. Brush with beaten egg. Slice or pierce a few holes along the top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until pastry is puffed and golden brown, about 20 minutes."
    },
    {
      "position": 8,
      "text": "Let pie stand for at least 10 minutes before serving. Garnish with fresh parsley. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

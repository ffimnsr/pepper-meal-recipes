  "id": "3a837868-7408-5432-b984-87a9a3f7838e",
  "slug": "bok-choy-ramen-salad",
  "name": "Bok Choy Ramen Salad",
  "recipe_type": "salad",
  "brief_description": "This easy bok choy ramen salad recipe pairs bok choy with ramen noodles, sesame seeds, and slivered almonds and is tossed in a sweet soy vinaigrette.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk canola oil, 1/2 cup sugar, red wine vinegar, and 2 tablespoons soy sauce together in a bowl."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over low heat; add 2 tablespoons sugar and stir until dissolved. Crumble ramen noodles into butter mixture, then stir in ramen seasoning packets, sesame seeds, almonds, and 1 tablespoon soy sauce; cook until lightly toasted, stirring constantly to prevent burning, 2 to 3 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Toss vinaigrette, ramen mixture, bok choy, and green onions together in a large bowl."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

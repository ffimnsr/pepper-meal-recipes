  "slug": "pina-colada-pudding-shots",
  "name": "Pi\u00f1a Colada Pudding Shots!",
  "recipe_type": "dessert",
  "brief_description": "Pi\u00f1a colada shots are crowd-pleasing, quick-and-easy pudding treats to make for your next party.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together milk, vodka, rum, and pudding mix in a large bowl until combined. Stir in whipped topping until a pudding-like consistency is reached."
    },
    {
      "position": 2,
      "text": "Spoon into shot glasses and refrigerate until set, at least 30 minutes."
    }
  ],

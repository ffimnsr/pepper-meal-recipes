  "id": "5ff48a32-e768-5596-b14c-8dc546d5302f",
  "slug": "the-best-lavender-sugar-cookies-ever",
  "name": "The Best Lavender Sugar Cookies Ever",
  "recipe_type": "dessert",
  "brief_description": "Simple lavender ribbon cookies with just a few ingredients have the delicate taste of lavender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper and grease the paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, and baking powder in a bowl. Stir butter and egg into flour mixture until smooth. Add vanilla extract and lavender; gently mix until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Drop cookie dough by tablespoon about 2 inches apart onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cookies are fragrant and edges turn light golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

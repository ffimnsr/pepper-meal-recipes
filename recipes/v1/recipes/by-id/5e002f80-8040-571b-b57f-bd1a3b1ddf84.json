  "id": "5e002f80-8040-571b-b57f-bd1a3b1ddf84",
  "slug": "chicken-biscuit-stew-recipe-11700236",
  "name": "Chicken Biscuit Stew",
  "recipe_type": "soup",
  "brief_description": "This chicken biscuit stew is a good recipe to use rotisserie chicken. It\u2019s so simple to make, one pot, easy cleanup, and tastes like homemade potpie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in an ovenproof skillet over medium heat. Sprinkle in flour and whisk continuously to make a roux, 1 to 2 minutes. Gradually add broth and milk whisking until thick, smooth, and bubbly, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in chicken, frozen vegetables, and onion. Cook for 1 to 2 minutes, then season with salt and pepper. Place biscuits on top of the chicken mixture, lightly pressing each down."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until biscuits are golden brown, 20 to 25 minutes. Check at about 15 minutes, and if biscuits are browning too quickly, cover with a piece of foil. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "29a84050-59bf-54a4-9850-2cfddba3b641",
  "slug": "homemade-turkey-gravy",
  "name": "Homemade Turkey Gravy",
  "recipe_type": "soup",
  "brief_description": "Smooth homemade turkey gravy made with turkey pan drippings, flour, and chicken broth for a rich and flavorsome addition to your Thanksgiving table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Separate oil from liquid in turkey drippings by pouring drippings into a clear 4-cup measuring cup; allow drippings to settle and separate into oil on top and juices on the bottom."
    },
    {
      "position": 2,
      "text": "Transfer \u00bc cup oil to a saucepan using a kitchen syringe or baster."
    },
    {
      "position": 3,
      "text": "Stir flour into oil in the saucepan; cook and stir over medium-low heat until color changes to a light brown, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir 1 cup juice from drippings in the measuring cup into flour mixture (roux); cook and stir, adding more drippings for a thinner gravy, until gravy is heated through and smooth, about 5 minutes. Stir chicken broth into gravy; cook and stir until heated through, adding more broth for a thinner gravy, about 5 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

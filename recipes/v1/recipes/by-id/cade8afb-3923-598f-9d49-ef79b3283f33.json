  "id": "cade8afb-3923-598f-9d49-ef79b3283f33",
  "slug": "easy-chicken-enchiladas",
  "name": "Easy Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "These easy chicken enchiladas are stuffed tortillas with creamy shredded chicken and salsa filling, beans, and cheese for a quick and tasty dinner.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine cream cheese and salsa in a small saucepan over medium heat; cook and stir until well blended. Stir in chicken and pinto beans."
    },
    {
      "position": 3,
      "text": "Fill tortillas with chicken mixture, roll up and place into the prepared baking dish. Sprinkle shredded cheese on top. Cover pan with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for until heated through, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

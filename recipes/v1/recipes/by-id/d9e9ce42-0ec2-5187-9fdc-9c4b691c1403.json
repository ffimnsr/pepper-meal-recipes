  "slug": "easiest-eggnog",
  "name": "Easiest Eggnog",
  "recipe_type": "drink",
  "brief_description": "This easiest eggnog recipe is made with milk, eggs, sugar, vanilla, and nutmeg for a creamy, festive drink \u2014 delicious on its own or spiked with brandy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, eggs, sugar, vanilla extract, and nutmeg together in a blender and process until well combined; transfer to a large pitcher."
    },
    {
      "position": 2,
      "text": "Chill before serving."
    }
  ],
  "servings": 3,

  "id": "71d36e0e-65a1-5336-b253-eaf5d01a1480",
  "slug": "glazed-pumpkin-donuts",
  "name": "Glazed Pumpkin Donuts",
  "recipe_type": "dessert",
  "brief_description": "This perfectly spiced pumpkin cake donut recipe is baked, then lightly glazed with a vanilla icing or covered in cinnamon sugar for a cozy fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a donut pan. Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, baking powder, pumpkin pie spice, salt, and baking soda in a bowl; beat in pumpkin pur\u00e9e, eggs, milk, and \u00bc cup softened butter with an electric mixer on low speed until batter is just combined. Spoon batter into the prepared donut pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until donuts spring back when gently pressed, 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat confectioners' sugar, \u00bc cup melted butter, water, and vanilla extract together in a bowl until glaze is smooth."
    },
    {
      "position": 5,
      "text": "Dip warm donuts into glaze, allowing any excess glaze to drip back into the bowl. Place glazed donuts onto the prepared baking sheet to cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

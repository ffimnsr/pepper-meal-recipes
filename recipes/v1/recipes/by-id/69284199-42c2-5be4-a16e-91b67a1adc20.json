  "id": "69284199-42c2-5be4-a16e-91b67a1adc20",
  "slug": "italian-red-lentil-and-brown-rice-soup",
  "name": "Italian Red Lentil and Brown Rice Soup",
  "recipe_type": "soup",
  "brief_description": "This thick and filling soup makes a delicious vegetarian or vegan meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium heat. Add onion and garlic; cook and stir until softened, about 5 minutes. Stir in broth, diced tomatoes, red lentils, brown rice, Italian seasoning, celery flakes, white pepper, and marjoram. Bring soup to a boil; reduce heat, cover, and simmer until lentils break down and rice is tender, about 55 minutes."
    },
    {
      "position": 2,
      "text": "Stir balsamic vinegar into the soup just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 65,

  "id": "2fe74238-656f-5615-93bf-0689209728bd",
  "slug": "red-velvet-brownies-recipe-11889549",
  "name": "Red Velvet Brownies",
  "recipe_type": "dessert",
  "brief_description": "These chewy red velvet brownies are topped with a tangy cream cheese frosting. Feel free to play around with the amount of cocoa powder in the recipe; use anywhere from 1 to 3 tablespoons, depending on how chocolaty you want them to be.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Whisk melted butter, brown sugar, white sugar, and salt together in a large bowl until mixture begins to lighten in color, about 1 minute. Add in egg, vanilla, and vinegar and whisk until smooth and combined. Add in cocoa powder and espresso powder, and whisk until completely smooth and combined. Whisk in red food coloring until thoroughly incorporated. Add in flour and baking soda and whisk until just combined."
    },
    {
      "position": 3,
      "text": "Pour batter into the prepared pan and spread into an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until brownies look set and begin to pull away from the edges of the pan, 25 to 30 minutes. Allow bars to cool completely in the pan."
    },
    {
      "position": 5,
      "text": "To make frosting, beat butter in a bowl until light and fluffy. Add in cream cheese and beat until smooth and combined. Add in confectioner's sugar, 1/2 teaspoon vanilla, and pinch of salt and beat until mixture is completely smooth, 2 to 3 minutes. Add in heavy cream and beat until frosting is light and fluffy, 2 to 3 minutes more."
    },
    {
      "position": 6,
      "text": "Place frosting on cool brownies and spread into an even layer. If desired, place brownies into the fridge to allow frosting to set before cutting. Cut into 16 bars."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

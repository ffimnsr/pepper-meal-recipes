  "id": "c67eb709-4533-555a-865f-c21af1225ec9",
  "slug": "easy-black-bean-soup-for-two-recipe-8725146",
  "name": "Easy Black Bean Soup for Two",
  "recipe_type": "soup",
  "brief_description": "For this easy black bean soup for two, canned black beans are partially blended for a creamy base. This is a comforting soup for days when you don\u2019t want to spend hours in the kitchen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pan over medium-high heat. Add onion and jalapeno. Cook until onions are translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chili powder, cumin, and oregano. Blend one can of beans in a blender until smooth and add to pot."
    },
    {
      "position": 3,
      "text": "Rinse and drain the other 2 cans of black beans and add to pot. Add water or broth. Bring pot to a boil. Reduce heat and simmer for 20 minutes. Season with salt to taste."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d1b415e5-5479-53af-b6de-71b0ce8ee423",
  "slug": "portobello-mushroom-burgers",
  "name": "Portobello Mushroom Burgers",
  "recipe_type": "main",
  "brief_description": "This meaty portobello mushroom burger has a juicy grilled, marinated mushroom, topped with melty cheese, served in a bun with your favorite toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place mushroom caps, smooth side up, in a shallow dish."
    },
    {
      "position": 3,
      "text": "Whisk together balsamic, oil, garlic, basil, and oregano in a small bowl. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Pour vinaigrette over mushrooms. Let stand at room temperature for 15 minutes or so, turning twice. Preheat grill for medium-high heat."
    },
    {
      "position": 5,
      "text": "Brush grill grates with oil. Place mushrooms on grill, reserving marinade for basting."
    },
    {
      "position": 6,
      "text": "Grill until just tender, 5 to 8 minutes per side, brushing with marinade frequently."
    },
    {
      "position": 7,
      "text": "Top mushrooms with cheese."
    },
    {
      "position": 8,
      "text": "Continue grilling until cheese is melted, about 2 minutes."
    },
    {
      "position": 9,
      "text": "Serve in buns with lettuce, tomato, and red onion, or your favorite toppings. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d4795e55-72a9-58ae-980d-889bf663045b",
  "slug": "turkey-patties",
  "name": "Turkey Patties",
  "recipe_type": "main",
  "brief_description": "These turkey patties, seasoned with garlic, ginger, and soy sauce, are quickly pan-fried for a tasty dinner that's ready in just 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix turkey, bread crumbs, egg, green onion, soy sauce, ginger, and garlic in a large bowl until combined. Shape into 4 patties."
    },
    {
      "position": 3,
      "text": "Heat oil in a wide skillet over medium heat. Add patties and cook until no longer pink in the center and the juices run clear, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Garnish with chopped parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "a170feb9-3595-5d17-b320-c57d9a4d5caa",
  "slug": "tuna-panini-melt",
  "name": "Tuna Panini Melt",
  "recipe_type": "main",
  "brief_description": "Tuna is mixed with mayonnaise, balsamic vinegar, pickle, and onion in these tasty, crispy tuna melt sandwiches made in a panini press.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tuna, mayonnaise, balsamic vinegar, onion, and dill pickle in a bowl."
    },
    {
      "position": 2,
      "text": "Spread tuna mixture over 2 slices bread. Top with American cheese and remaining 2 slices bread."
    },
    {
      "position": 3,
      "text": "Preheat a panini press according to manufacturer\u2019s instructions."
    },
    {
      "position": 4,
      "text": "Cook in the preheated panini press until bread crispy and cheese melted, 3 to 4 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "3e617568-395b-560e-b55c-acc24bfe6468",
  "slug": "skillet-meatballs-recipe-8362352",
  "name": "Skillet Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These skillet meatballs are tender on the inside and have a neutral taste, so they can be used any way you like \u2014in pasta, soup, sandwiches, or as appetizers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, beat egg, and add in 1 tablespoon milk. Stir in panko breadcrumbs; let stand for 1 minute to soften slightly. Add ground beef."
    },
    {
      "position": 2,
      "text": "Place onion in the bowl of a food processor and pulse until finely chopped."
    },
    {
      "position": 3,
      "text": "Add onion, Parmesan, garlic, salt, and pepper to the bowl of ground beef. Using clean, gloved hands, combine mixture gently. If mixture feels tough, add 1 tablespoon milk. Shape mixture into 1 1/2-inch meatballs."
    },
    {
      "position": 4,
      "text": "Heat oil and butter in a heavy skillet over medium heat. Place meatballs in a single layer, without crowding, into the skillet, and cook, turning and moving them around every 2 or 3 minutes, until well browned on all sides and no longer pink at the center, 10 to 14 minutes, adjusting temperature as needed. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C). You may have to cook meatballs in batches."
    },
    {
      "position": 5,
      "text": "Remove meatballs to a foil-lined drip tray. Serve with pasta and sauce if desired."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

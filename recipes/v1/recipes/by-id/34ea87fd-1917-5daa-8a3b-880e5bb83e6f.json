  "schema_version": 1,
  "id": "34ea87fd-1917-5daa-8a3b-880e5bb83e6f",
  "slug": "chef-johns-pumpkin-cinnamon-rolls",
  "name": "Chef John's Pumpkin Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "Chef John's pumpkin cinnamon roll recipe spices up ordinary cinnamon rolls with pumpkin pur\u00e9e, ground ginger, and allspice \u2014 they're the perfect treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine brown sugar, \u00bc cup white sugar, and cinnamon together in a small bowl; set aside."
    },
    {
      "position": 2,
      "text": "Dissolve yeast and \u00bd teaspoon white sugar in warm water in the bowl of a stand mixer. Whisk together; let stand until yeast softens and begins to form a creamy foam, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir pumpkin pur\u00e9e, heavy cream, remaining \u00bc cup white sugar, \u00bc cup melted butter, salt, \u00bd teaspoon vanilla, ginger, and allspice into yeast mixer in the bowl of the stand mixer. Add 2 cups flour and egg; fit mixer with dough hook attachment and mix until combined, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add remaining 2 \u00bc cups flour; mix on low until dough is slightly sticky, smooth, and elastic, 6 to 7 minutes, adding more flour if mixture is too sticky."
    },
    {
      "position": 5,
      "text": "Remove dough from hook; shape into a ball. Lightly coat the stand mixer bowl with vegetable oil, return dough to the bowl, turning to coat with oil. Cover bowl with aluminum foil; set aside to rise in a warm place until doubled in volume, about 1 \u00bd hours."
    },
    {
      "position": 6,
      "text": "Generously butter a 13x9-inch baking dish."
    },
    {
      "position": 7,
      "text": "Turn dough out onto a well-floured surface. Flatten into a rectangular shape about 1-inch thick using your hands. Generously sprinkle both sides of dough with flour; roll out to about a 20x12-inch rectangle. Pour 5 tablespoons melted butter over top; evenly brush over surface, leaving 2 inches along one wide edge unbuttered. Sprinkle brown sugar mixture over dough; moisten unbuttered edge with water. Roll dough tightly into a log, starting at the buttered wide edge; press firmly along moistened wide edge to seal."
    },
    {
      "position": 8,
      "text": "Trim and discard uneven ends from the roll. Slice rolled dough into 16 equally-sized pinwheels; place pinwheels, cut-sides up, in the prepared baking dish. Cover with plastic wrap; set aside to rise in a warm place until doubled in volume, 45 to 60 minutes."
    },
    {
      "position": 9,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until golden brown, about 30 minutes; set aside to cool slightly while mixing glaze."
    },
    {
      "position": 11,
      "text": "Whisk confectioners' sugar, cream cheese, milk, and remaining \u00bc teaspoon vanilla extract together in a large bowl until smooth; drizzle over warm cinnamon rolls. Sprinkle pumpkin seeds over rolls to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

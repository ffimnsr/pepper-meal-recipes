  "slug": "simple-beef-flavored-gravy",
  "name": "Simple Beef-Flavored Gravy",
  "recipe_type": "side",
  "brief_description": "The best gravy recipe that comes together in no time. Made quick and easy with beef bouillon, flour, onion, and butter. Perfect for any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a small saucepan over medium heat. Stir in flour to combine and add onion. Pour in water and season with bouillon."
    },
    {
      "position": 3,
      "text": "Bring to a boil over medium heat and cook until thickened."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

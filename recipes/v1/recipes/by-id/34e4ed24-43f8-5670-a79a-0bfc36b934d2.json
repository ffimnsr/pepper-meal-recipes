  "id": "34e4ed24-43f8-5670-a79a-0bfc36b934d2",
  "slug": "baked-corn-tortilla-strips-for-mexican-soups",
  "name": "Baked Corn Tortilla Strips for Mexican Soups",
  "recipe_type": "soup",
  "brief_description": "Baked corn tortilla strips are a staple in Mexican soups. Use them in your favorite tortilla soup or to garnish other Mexican soups or stews.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut tortillas in half, then slice crosswise into 1/8-inch strips. Place strips into a bowl and toss with oil until fully coated."
    },
    {
      "position": 3,
      "text": "Transfer oiled strips to a baking sheet and arrange in a single layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crisp and lightly browned, about 15 minutes. Remove from the oven and let cool before using."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

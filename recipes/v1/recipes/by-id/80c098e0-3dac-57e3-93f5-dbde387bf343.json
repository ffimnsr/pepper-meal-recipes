  "id": "80c098e0-3dac-57e3-93f5-dbde387bf343",
  "slug": "creamy-vegetarian-tortellini-soup",
  "name": "Creamy Vegetarian Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "You won't miss the meat in this tasty vegetarian tortellini soup with zucchini, cream, and Parmesan cheese.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a saucepan until shimmering over medium heat. Add chopped onions and cook until soft and translucent, about 5 minutes. Add garlic and cook until fragrant, about 45 seconds. Add 1/2 of diced tomatoes with liquid. Season with Italian seasoning, garlic, onion powder, salt, and pepper. Stir to combine."
    },
    {
      "position": 2,
      "text": "Add in half of the diced tomatoes with liquid. Add in Italian seasoning, salt, pepper, garlic granules and onions powder. Stir to combine."
    },
    {
      "position": 3,
      "text": "Pour remaining tomatoes into a bowl and puree with an immersion blender. Add to sauce with vegetable broth."
    },
    {
      "position": 4,
      "text": "Mix in zucchini and tortellini. Cover and cook until tortellini float on the top and are cooked through, 8 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Stir in cream and cheese until well combined. Taste and adjust seasoning to taste. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

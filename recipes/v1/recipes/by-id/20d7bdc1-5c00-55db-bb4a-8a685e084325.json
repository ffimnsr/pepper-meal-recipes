  "id": "20d7bdc1-5c00-55db-bb4a-8a685e084325",
  "slug": "linguini-with-broccoli-and-red-peppers",
  "name": "Linguine with Broccoli and Red Peppers",
  "recipe_type": "side",
  "brief_description": "Linguine with broccoli and red peppers get saut\u00e9ed in olive oil and garlic, then topped with Parmesan cheese for a quick, delicious meal or side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Steam broccoli with 2 tablespoons water in the microwave for 6 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil and butter in a 10-inch skillet over low heat. Stir in garlic (more or less to suit your tastes), then red pepper slices; saut\u00e9 gently."
    },
    {
      "position": 4,
      "text": "Drain broccoli and add to skillet. Sprinkle lightly with garlic salt and saut\u00e9 broccoli with peppers until soft."
    },
    {
      "position": 5,
      "text": "Toss vegetable mixture with hot pasta. Sprinkle with Parmesan cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "41764289-98c1-5c8f-ba71-4c2e60f565a3",
  "slug": "green-goddess-egg-salad-recipe-11780717",
  "name": "Green Goddess Egg Salad",
  "recipe_type": "salad",
  "brief_description": "This green goddess egg salad is a unique twist on traditional egg salad with an herb-rich dressing. It makes a great sandwich on bread, an appetizer on crostini, or just serve over some tasty fresh greens.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Roughly chop eggs and place in a bowl."
    },
    {
      "position": 3,
      "text": "In a small bowl, whisk mayonnaise, dill, chives, Dijon, parsley, lemon juice, and anchovy paste together until smooth. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Add dressing to chopped eggs, and gently fold in until well combined. Cover and refrigerate if not serving immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

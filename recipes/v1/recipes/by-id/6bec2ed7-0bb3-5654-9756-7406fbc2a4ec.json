  "id": "6bec2ed7-0bb3-5654-9756-7406fbc2a4ec",
  "slug": "gravy-baked-pork-chops",
  "name": "Gravy Baked Pork Chops",
  "recipe_type": "soup",
  "brief_description": "This baked and smothered pork chop recipe uses simple pantry ingredients and condensed cream of mushroom soup with incredibly delicious results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Season pork chops with salt and pepper. Melt butter in a large skillet over medium-high heat; add pork chops and saut\u00e9 for about 5 minutes per side."
    },
    {
      "position": 4,
      "text": "Combine milk, water, and condensed soup in a separate medium bowl."
    },
    {
      "position": 5,
      "text": "Arrange pork chops in a 9x13-inch baking dish; pour soup mixture over chops."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 45 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

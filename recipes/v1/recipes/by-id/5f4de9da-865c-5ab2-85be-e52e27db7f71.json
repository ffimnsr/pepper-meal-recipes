  "id": "5f4de9da-865c-5ab2-85be-e52e27db7f71",
  "slug": "horrible-hand-ham-and-cheese-board-recipe-7974921",
  "name": "\u201cHorrible Hand\u201d Ham and Cheese Board",
  "recipe_type": "appetizer",
  "brief_description": "Ideal for Halloween, this \"horrible hand\" ham and cheese board will be the life of your party. This exceptionally creepy skinned hand is best served very cold, with crackers, hot sauce \"blood\"\u2014and a dagger.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add cream cheese, red pepper, parsley, black pepper, garlic powder, salt, and cayenne to a bowl and mix thoroughly. Cover surface with plastic wrap, and chill until firm, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Trace your hand on a piece of parchment. Turn parchment over, and place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Use two teaspoons to fill in the hand template with the chilled cheese mixture. Build cheese up in appropriate spots to form the 3-dimensional shape of a hand and wrist."
    },
    {
      "position": 4,
      "text": "Cover with plastic wrap and freeze until very firm, about 1 hour."
    },
    {
      "position": 5,
      "text": "Use a knife to separate fingers from hand and hand from wrist. Wrap each piece with prosciutto, tucking extra meat underneath. Cover, and place in freezer about 1 hour, or until ready to complete assembling the hand."
    },
    {
      "position": 6,
      "text": "Place the hand section on a serving board first, then attach the fingers and the wrist. Use your own hand as a reference for placing parts of the hand. Use more prosciutto to cover seams, and to add detail and definition. Refrigerate until ready to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

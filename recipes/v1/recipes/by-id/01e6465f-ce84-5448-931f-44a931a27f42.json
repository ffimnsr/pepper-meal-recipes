  "id": "01e6465f-ce84-5448-931f-44a931a27f42",
  "slug": "worlds-easiest-peanut-butter-blossoms",
  "name": "Easy Peanut Butter Blossoms",
  "recipe_type": "dessert",
  "brief_description": "These peanut butter blossom cookies are simple to make and turn out perfect every time. With chocolate candy kisses on top \u2014 they're ideal for the holidays!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Place 1/2 cup sugar into a shallow bowl."
    },
    {
      "position": 2,
      "text": "Stir peanut butter, remaining 1 \u00bc cups sugar, and eggs together in a mixing bowl until well combined. Roll into 36 small balls."
    },
    {
      "position": 3,
      "text": "Roll balls in reserved sugar until coated, then arrange 1 inch apart on ungreased baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until very lightly browned on the bottom and the edges are beginning to crack, 12 to 14 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and immediately press one chocolate kiss into the center of each cookie. Cool on the baking sheets for 1 to 2 minutes, then transfer to a wire rack to cool completely, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

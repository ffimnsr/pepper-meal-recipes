  "slug": "pico-de-gallo",
  "name": "Pico de Gallo",
  "recipe_type": "appetizer",
  "brief_description": "Pico de gallo is a fresh, flavor-packed Mexican salsa that's easy to make with chopped ripe tomatoes, red onion, jalapeño, coriander, and lime juice.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place tomatoes, onion, cilantro, jalapeño pepper, lime juice, garlic, garlic powder, cumin, salt, and pepper in a bowl."
    },
    {
      "position": 3,
      "text": "Stir well until combined."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

  "schema_version": 1,
  "id": "e0f5c36e-2af0-5892-a68b-0a444cbf81ea",
  "slug": "scrumptious-shrimp-scampi-linguine",
  "name": "Scrumptious Shrimp Scampi Linguine",
  "recipe_type": "main",
  "brief_description": "This scrumptious shrimp scampi linguine recipe simmers tender shrimp and bell peppers in a garlic cream sauce with pepper flakes tossed with linguine.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Reserve 1 cup pasta water; drain linguine well in a colander set in the sink."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter with 1 \u00bd tablespoons olive oil in a large skillet over medium heat. Add bell peppers and garlic; cook and stir until peppers have softened, about 10 minutes. Stir in shrimp; cook and stir until shrimp are opaque and pink, about 5 minutes. Transfer shrimp to a bowl and set aside, leaving peppers and garlic in the skillet."
    },
    {
      "position": 3,
      "text": "Stir wine, clam juice, and lemon juice into the skillet; bring to a boil over medium heat. Add remaining 2 tablespoons butter and remaining 1 \u00bd tablespoons olive oil; return shrimp to the skillet. Stir in reserved 1 cup pasta water, parsley, cream, pepper flakes, and salt. Add cooked linguine; toss lightly to coat. Simmer scampi over medium-low heat to let linguine absorb some sauce, about 5 minutes; serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

  "id": "a16588c1-3eab-50a3-bb55-a2f1c17e21ce",
  "slug": "smores-at-home",
  "name": "S'mores at Home",
  "recipe_type": "dessert",
  "brief_description": "S'mores indoors at home, this recipe is messy, gooey, and oh-so-delicious. This sweet treat will hit the spot and satisfy your sweet tooth in minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine graham cracker crumbs, melted butter, and sugar in a bowl. Mix until evenly moistened; press 1/2 into the bottom of the prepared baking dish. Top with chocolate chips and marshmallows; sprinkle remaining crumb mixture over marshmallows. Press crumb mixture down with a spatula."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until marshmallows are melted, about 10 minutes. Cool completely before cutting into squares."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "343df55b-1649-55bf-90f9-42e6b5039ca9",
  "slug": "blueberry-s-pie",
  "name": "Blueberry 'S' Pie",
  "recipe_type": "dessert",
  "brief_description": "A quick oat streusel sandwiches a filling of sweet blueberries in this easy dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together the butter and brown sugar. Stir in flour, salt and oats. Mix until well combined."
    },
    {
      "position": 3,
      "text": "Pat 2/3 of the mixture into an ungreased 9-inch pie pan to form the bottom crust. Spread blueberries evenly into crust. Pat the remaining oat mixture onto top of blueberries."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until topping is golden brown and filling is bubbly, 40 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

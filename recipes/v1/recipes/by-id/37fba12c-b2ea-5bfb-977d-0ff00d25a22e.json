  "id": "37fba12c-b2ea-5bfb-977d-0ff00d25a22e",
  "slug": "green-salad-with-cranberry-vinaigrette",
  "name": "Green Salad with Cranberry Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This green salad with cranberry vinaigrette recipe tosses mixed greens, almonds, red onion, and crumbled blue cheese in a tangy, cranberry vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange almonds in a single layer on a baking sheet. Toast in the preheated oven until nuts begin to brown, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine oil, cranberries, vinegar, water, Dijon mustard, garlic, salt, and black pepper in a blender or the bowl of a food processor; blend until vinaigrette is smooth."
    },
    {
      "position": 4,
      "text": "Toss mixed greens, almonds, onion, and blue cheese with vinaigrette in a large bowl until evenly coated."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

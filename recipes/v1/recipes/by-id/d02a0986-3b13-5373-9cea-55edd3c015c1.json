  "id": "d02a0986-3b13-5373-9cea-55edd3c015c1",
  "slug": "toasted-marshmallow-cupcakes",
  "name": "Toasted Marshmallow Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Moist chocolate cupcakes are topped with a marshmallow and broiled into tasty, toasted marshmallow cupcakes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 12 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, cocoa powder, baking soda, baking powder, and salt together in a large bowl; stir in warm water, eggs, milk, butter, sour cream, and vanilla extract until batter is smooth. Fill each muffin cup halfway with batter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a cupcake comes out clean, 15 to 18 minutes. Cool cupcakes for about 5 minutes."
    },
    {
      "position": 4,
      "text": "Turn on the oven's broiler."
    },
    {
      "position": 5,
      "text": "Place 1 marshmallow vertically in the center of each cupcake."
    },
    {
      "position": 6,
      "text": "Place cupcakes back into the oven and broil, watching the whole time, until marshmallows are golden brown and slightly puffed, 10 to 30 seconds. Press marshmallows into cupcakes to cover the whole top using the back of a spoon."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

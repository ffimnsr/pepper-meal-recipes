  "id": "70662a29-de90-5063-a0c7-0d4e9160aeaf",
  "slug": "sweet-and-sour-pork-iii",
  "name": "Sweet and Sour Pork",
  "recipe_type": "dessert",
  "brief_description": "Sweet and sour pork made with stir-fried tender cubed pork and veggies, coated in a delicious Chinese pineapple sauce made with apple cider vinegar.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cubed pork in a medium bowl and season with soy sauce, salt, and sugar for marinade."
    },
    {
      "position": 3,
      "text": "Add egg white and green onions and mix until well-combined. Cover and place in the refrigerator for at least 1 hour."
    },
    {
      "position": 4,
      "text": "Heat 1 quart oil to 365 degrees F (185 degrees C) in a large, heavy saucepan or deep fryer. Coat pork with cornstarch."
    },
    {
      "position": 5,
      "text": "Fry in hot oil until evenly browned, about 10 minutes. Drain on paper towels and set aside."
    },
    {
      "position": 6,
      "text": "Heat oil for vegetables in a wok over medium heat. Stir in celery, bell pepper, and onion; cook until tender, about 5 minutes. Season with pinch of sugar and salt. Remove from heat and set aside."
    },
    {
      "position": 7,
      "text": "Mix 1 cup water, 3/4 cup sugar, apple cider vinegar, ketchup, soy sauce, and salt in a large saucepan; bring to a boil over high heat."
    },
    {
      "position": 8,
      "text": "Stir in cooked pork, celery mixture, and pineapple chunks with juice."
    },
    {
      "position": 9,
      "text": "Return to a boil, then mix in remaining 1/4 cup water and cornstarch. Cook until thickened and warmed through, about 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

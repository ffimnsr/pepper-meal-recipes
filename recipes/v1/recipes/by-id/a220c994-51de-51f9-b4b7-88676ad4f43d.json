  "id": "a220c994-51de-51f9-b4b7-88676ad4f43d",
  "slug": "shrimp-leek-and-spinach-risotto",
  "name": "Shrimp, Leek and Spinach Risotto",
  "recipe_type": "main",
  "brief_description": "Wonderful seafood risotto is made with shrimp, scallops, red peppers, and spinach!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon of olive oil in a large, heavy bottomed saucepan over medium-high heat. Pour in the rice, and stir until the rice is coated in oil and has started to toast, 2 to 3 minutes. Reduce the heat to medium and stir in one-third of the boiling vegetable broth; continue stirring until incorporated. Repeat this process twice more, stirring constantly. Incorporating the broth should take 15 to 20 minutes in all."
    },
    {
      "position": 2,
      "text": "While you are cooking the rice, heat the remaining tablespoon of oil in a pan. Stir in the garlic, leeks, red chili, shrimp, and scallops. Cook until the seafood is just beginning to turn color. Add the red bell pepper and spinach; cook until the seafood is opaque. Combine with the rice, and season to taste with pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

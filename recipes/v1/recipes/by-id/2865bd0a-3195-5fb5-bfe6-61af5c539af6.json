  "id": "2865bd0a-3195-5fb5-bfe6-61af5c539af6",
  "slug": "roasted-sweet-potato-and-kale-salad-recipe-6737836",
  "name": "Roasted Sweet Potato and Kale Salad",
  "recipe_type": "salad",
  "brief_description": "A fantastic kale sweet potato salad with chunks of tender roasted sweet potatoes, caramelized onions, and kale seasoned with red wine vinegar and thyme.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Toss sweet potato cubes with 2 tablespoons of olive oil in a bowl. Season to taste with salt and pepper; arrange evenly onto a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until the yams are tender, 20 to 25 minutes. Cool to room temperature in the refrigerator."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat remaining 1 tablespoon of olive oil in a large skillet over medium heat. Add onion and garlic; cook and stir until onion has caramelized to a golden brown, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir in kale, cooking until wilted and tender. Transfer kale mixture to a bowl; cool to room temperature in the refrigerator."
    },
    {
      "position": 5,
      "text": "Once all the ingredients have cooled, combine yams, kale, red wine vinegar, and fresh thyme in a bowl. Season to taste with salt and pepper, and gently stir to combine."
    },
    {
      "position": 6,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

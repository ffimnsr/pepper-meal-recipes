{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "df1d4b7a-ce5d-5906-a3b5-aee9dcc79fd5",
  "slug": "lemon-buttermilk-pound-cake-with-aunt-evelyns-lemon-glaze",
  "name": "Lemon Pound Cake with Aunt Evelyn's Lemon Glaze",
  "recipe_type": "dessert",
  "brief_description": "This lemon pound cake, flavored with lemon extract, has a sweet, tangy glaze made with lemon juice and zest to make the perfect dessert for lemon fans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a fluted tube pan (such as Bundt)."
    },
    {
      "position": 2,
      "text": "To make the cake: Sift flour, salt, and baking soda together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter in a bowl with an electric mixer for 10 minutes. Add eggs, one at a time, beating well after each addition. Add flour mixture in three batches, alternating with buttermilk, beating well after each addition and ending with the flour mixture. Stir in lemon extract. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Place into the preheated oven and immediately reduce the oven temperature to 325 degrees F (165 degrees C). Bake until a toothpick inserted into the center of the cake comes out clean, 60 to 75 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the oven and cool in the pan for 10 minutes. Tap the pan firmly a few times, then shake it gently to loosen the cake. Place a wire rack over the pan and invert to release cake onto the rack. Set the rack and cake over a sheet of parchment paper."
    },
    {
      "position": 6,
      "text": "To make the glaze: Beat confectioner's sugar, lemon juice, butter, and lemon zest in a bowl with an electric mixer until smooth."
    },
    {
      "position": 7,
      "text": "Pour about 1/2 of the glaze over the warm cake. Let cool for 20 minutes, then pour remaining glaze over top."
    },
    {
      "position": 8,
      "text": "Enjoy!"
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

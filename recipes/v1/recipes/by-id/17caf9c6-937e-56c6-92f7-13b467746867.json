  "id": "17caf9c6-937e-56c6-92f7-13b467746867",
  "slug": "chicken-enchiladas-with-creamy-green-chile-sauce",
  "name": "Chicken Enchiladas with Creamy Green Chile Sauce",
  "recipe_type": "main",
  "brief_description": "Make this recipe for enchiladas with green chile sauce, featuring tasty chicken- and cheese-filled corn tortillas baked under a creamy sauce peppered with chiles.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in a skillet over medium-high heat. Fry tortillas (one at a time) for 5 seconds on each side to soften and make them pliable. Add more oil to the pan as needed."
    },
    {
      "position": 4,
      "text": "Drain between layers of paper towel and keep warm."
    },
    {
      "position": 5,
      "text": "Divide chicken, 10 ounces Monterey Jack cheese, and onion among 12 tortillas."
    },
    {
      "position": 6,
      "text": "Roll up each tortilla and place seam-side down in the prepared pan."
    },
    {
      "position": 7,
      "text": "Melt butter in a saucepan over medium heat. Add flour and whisk until mixture begins to boil. Slowly add chicken broth, stirring with a whisk until thickened. Mix in sour cream and green chiles, stirring occasionally. Heat thoroughly but do not boil."
    },
    {
      "position": 8,
      "text": "Pour mixture over enchiladas."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until bubbly and heated through, about 20 minutes. Top with remaining Monterey Jack cheese and bake for 5 more minutes."
    },
    {
      "position": 10,
      "text": "Garnish with chopped green onions and cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

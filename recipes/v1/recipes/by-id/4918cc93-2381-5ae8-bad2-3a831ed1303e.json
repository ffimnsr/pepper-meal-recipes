  "id": "4918cc93-2381-5ae8-bad2-3a831ed1303e",
  "slug": "easy-ice-cream-tiramisu-recipe-12026960",
  "name": "Easy Ice Cream Tiramisu",
  "recipe_type": "dessert",
  "brief_description": "This ice cream tiramisu captures all the flavors of the classic Italian dessert in a cool, creamy frozen treat. Layers of coffee-soaked ladyfingers and ice cream are topped with homemade whipped cream and a dusting of cocoa for a make-ahead dessert that\u2019s easy to slice and serve.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Lightly coat a 13- x 9-inch baking dish with cooking spray. Stir together coffee, coffee liqueur, and granulated sugar in a shallow dish until sugar dissolves. Refrigerate, uncovered, until cooled to room temperature, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Working with 1 ladyfinger at a time, quickly dip half of the ladyfingers in coffee mixture, about 1 second per side. Arrange dipped ladyfingers in a single layer in bottom of prepared dish, trimming ladyfingers as needed to fit. Spoon half of the softened ice cream (about 4 cups) over ladyfingers. Using an offset spatula, spread ice cream into an even layer. Repeat with remaining ladyfingers, coffee mixture, and ice cream. Cover with plastic wrap and freeze until very firm, about 6 hours."
    },
    {
      "position": 3,
      "text": "When ready to serve, beat heavy whipping cream, powdered sugar, and vanilla in a large bowl with an electric mixer on medium-high speed until stiff peaks form, 2 to 3 minutes. Spread whipped cream evenly over frozen ice cream. Sift cocoa powder evenly over whipped cream."
    },
    {
      "position": 4,
      "text": "Let stand at room temperature 5 minutes before slicing. Cut into 15 bars. Serve immediately. Recipe developed by Nicole Hopper"
    }
  ],
  "servings": 15,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "easy",

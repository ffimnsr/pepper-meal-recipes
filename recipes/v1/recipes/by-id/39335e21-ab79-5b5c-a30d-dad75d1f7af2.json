  "id": "39335e21-ab79-5b5c-a30d-dad75d1f7af2",
  "slug": "dragon-fruit-mojito",
  "name": "Dragon Fruit Mojito",
  "recipe_type": "drink",
  "brief_description": "This mojito kicks the traditional lime to the curb and replaces it with dragon fruit. If you like, you can serve the drinks in the emptied dragon fruit halves.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix 2 tablespoons plus 2 teaspoons sugar with mint in the bottom of a highball glass."
    },
    {
      "position": 2,
      "text": "Combine rum and dragon fruit flesh in a blender; blend until smooth. Pour rum mixture over the muddled mint mixture. Stir to incorporate."
    },
    {
      "position": 3,
      "text": "Divide mixture between 4 double old-fashioned glasses. Top each drink with equal amounts of club soda."
    }
  ],
  "servings": 4,

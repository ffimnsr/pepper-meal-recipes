  "id": "ea7d0269-3525-5fa0-87fc-c57e47428abd",
  "slug": "my-grandmas-peanut-butter-fudge",
  "name": "My Grandma's Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Using crunchy peanut butter gives this fudge some texture to go with its delicious taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together the peanut butter and marshmallow cream in a bowl; set aside. Lightly grease a square glass dish with butter."
    },
    {
      "position": 2,
      "text": "Stir together the sugar and milk in a saucepan over medium-high heat; stirring occasionally, bring to a boil at 234 degrees F (110 degrees C) and then immediately remove from heat and stir in the peanut butter mixture and the vanilla; pour into the prepared dish and allow to cool to room temperature before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,

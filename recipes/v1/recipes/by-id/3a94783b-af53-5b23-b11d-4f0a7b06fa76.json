  "id": "3a94783b-af53-5b23-b11d-4f0a7b06fa76",
  "slug": "quiche-supreme",
  "name": "Quiche Supreme",
  "recipe_type": "breakfast",
  "brief_description": "This quiche recipe makes the best hearty quiches with tender veggies and ham, baked in a flaky crust with herby egg filling and plenty of cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Par-bake crusts in the preheated oven for 10 minutes. Set aside to cool on a wire rack."
    },
    {
      "position": 3,
      "text": "Saut\u00e9 onion, mushrooms, and green pepper in a large skillet until onion is soft and translucent. Remove from heat and set aside."
    },
    {
      "position": 4,
      "text": "Whisk together cream and eggs in a large bowl until well combined. Stir in ham, Jack cheese, Swiss cheese, and saut\u00e9ed vegetables. Stir in vinegar and season with tarragon, garlic powder, nutmeg, parsley, salt and pepper. Divide filling evenly between par-baked pie crusts."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is set and crusts are golden brown, 55 to 60 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,

  "id": "555414b0-ec52-5394-914c-dff9fb366603",
  "slug": "open-faced-wontons-recipe-11913244",
  "name": "Open-Faced Wontons",
  "recipe_type": "appetizer",
  "brief_description": "These open faced wontons are for you if you love the taste of wontons but hate how long it takes to make them. With a delicious soy-chili sauce, you'll fry them like a smashburger, fold them like a taco, dip in sauce, and enjoy!",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir soy sauce, chili garlic sauce, water, sesame oil, rice wine vinegar, sesame seeds, and sugar together in a small bowl for the sauce; set aside."
    },
    {
      "position": 2,
      "text": "Combine ground beef and pork, cole slaw mix, garlic, ginger, soy sauce, sugar, sesame oil, and green onion in a bowl. Stir until well combined. Spread filling in a thin layer to the edges of each wonton wrapper."
    },
    {
      "position": 3,
      "text": "Brush sesame oil on a skillet over medium-high heat. Add wontons, meat side down, into the pan; brush oil on the back of wonton wrappers. Cook until browned, 2 to 3 minutes. Turn wontons gently and fry until crisp, about 2 minutes. You may need to work in batches."
    },
    {
      "position": 4,
      "text": "Serve with chili oil and sauce. To eat, fold each wonton in half like a taco, dip in the sauce, and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

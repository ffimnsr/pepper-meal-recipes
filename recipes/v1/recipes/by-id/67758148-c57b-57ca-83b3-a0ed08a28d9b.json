  "id": "67758148-c57b-57ca-83b3-a0ed08a28d9b",
  "slug": "vegan-butternut-squash-soup",
  "name": "Vegan Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This vegan butternut squash soup is deliciously rich, creamy, and perfectly seasoned for fall with fragrant spices, ginger, and maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium heat. Add onions, garlic, and ginger. Cook and stir until browned, about 5 minutes. Stir in \u00bd teaspoon salt, allspice, nutmeg, cinnamon, cumin, cloves, coriander, paprika, and chili flakes. Add butternut squash, yam, carrots, and celery. Add enough water to just cover."
    },
    {
      "position": 2,
      "text": "Increase heat and bring soup to a boil. Reduce heat and simmer until all vegetables are fork-tender, 30 to 45 minutes."
    },
    {
      "position": 3,
      "text": "Fill a blender halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour back into the saucepan. Repeat with remaining soup. Add maple syrup, apple cider vinegar, and remaining 1 teaspoon salt."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

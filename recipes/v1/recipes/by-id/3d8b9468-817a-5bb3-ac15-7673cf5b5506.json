  "id": "3d8b9468-817a-5bb3-ac15-7673cf5b5506",
  "slug": "honey-glazed-ham",
  "name": "Honey Glazed Ham",
  "recipe_type": "main",
  "brief_description": "This honey-glazed ham recipe is studded with whole cloves and then basted while baking with a simple glaze made of honey, butter, and dark corn syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a roasting pan with foil."
    },
    {
      "position": 2,
      "text": "Score ham in a crosshatch pattern; stud with whole cloves. Place ham in the prepared pan."
    },
    {
      "position": 3,
      "text": "Heat honey, butter, and corn syrup in the top half of a double boiler on medium heat until butter melts. Keep glaze warm while ham bakes."
    },
    {
      "position": 4,
      "text": "Brush glaze over ham; bake in the preheated oven for 1 hour and 15 minutes."
    },
    {
      "position": 5,
      "text": "Baste ham with glaze every 10 to 15 minutes. Broil to caramelize glaze during last 4 to 5 minutes of cooking time. Remove from oven and let sit a few minutes before serving."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,

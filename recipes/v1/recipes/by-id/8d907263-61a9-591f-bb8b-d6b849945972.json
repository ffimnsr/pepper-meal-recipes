  "id": "8d907263-61a9-591f-bb8b-d6b849945972",
  "slug": "jalapeno-popper-wontons",
  "name": "Jalape\u00f1o Popper Wontons",
  "recipe_type": "appetizer",
  "brief_description": "These delicious jalape\u00f1o popper wontons add an Asian twist to a party classic! To add even more flavor, serve them with a sweet chili sauce.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, stir together cream cheese and jalape\u00f1o peppers. Arrange wonton wrappers a few at a time on a clean dry surface. Set a cup or small bowl of water nearby. Place about a teaspoon of cream cheese mixture onto the center of each wrapper. Moisten your fingertip in the bowl of water and trace the edges of wonton wrappers. Fold into triangles or follow directions on the package for desired shapes. This part can be done ahead of time and refrigerated or frozen."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep fryer to 375 degrees F (190 degrees C). When hot, fry wontons a few at a time until golden brown, about 2 minutes. Drain on paper towels. Repeat with all wontons, then serve with sweet chili sauce for dipping."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

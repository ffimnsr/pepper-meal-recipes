{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ea961dc0-3fbc-5e61-bf47-3d635f2657ea",
  "slug": "flourless-chocolate-cake-i",
  "name": "Flourless Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This decadent flourless chocolate cake is easy to make for a rich, fudgy, and naturally gluten-free dessert that's perfect for any special occasion.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Grease a 10-inch round cake pan; set aside."
    },
    {
      "position": 2,
      "text": "Combine sugar, water, and salt in a small saucepan over medium heat. Stir until completely dissolved; set aside."
    },
    {
      "position": 3,
      "text": "Melt bittersweet chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes. Pour chocolate into the bowl of an electric mixer."
    },
    {
      "position": 4,
      "text": "Cut butter into pieces; beat butter, one piece at a time, into chocolate until combined."
    },
    {
      "position": 5,
      "text": "Beat in hot sugar water. Slowly beat in eggs, one at a time."
    },
    {
      "position": 6,
      "text": "Pour batter into the prepared cake pan."
    },
    {
      "position": 7,
      "text": "Have a pan larger than the cake pan ready; put the cake pan in the larger pan and fill the larger pan with boiling water halfway up the sides of the cake pan."
    },
    {
      "position": 8,
      "text": "Bake cake in the water bath in the preheated oven for 45 minutes. The center will still look wet. Place cake in the refrigerator until thoroughly chilled, 8 hours to overnight."
    },
    {
      "position": 9,
      "text": "To unmold, dip the bottom of the cake pan in hot water for 10 seconds and invert onto a serving plate."
    },
    {
      "position": 10,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,

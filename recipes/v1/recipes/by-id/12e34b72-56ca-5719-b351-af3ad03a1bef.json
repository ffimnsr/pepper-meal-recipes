{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "12e34b72-56ca-5719-b351-af3ad03a1bef",
  "slug": "panko-sesame-crusted-salmon-bites-recipe-8785036",
  "name": "Panko Sesame Crusted Salmon Bites",
  "recipe_type": "appetizer",
  "brief_description": "These air-fried panko sesame crusted salmon bites have a crunchy, nutty crust surrounding tender, buttery perfectly-cooked salmon. You'll have time to stir up the sweet-savory Kewpie mayonnaise, soy, sesame, chili-garlic-lime dipping sauce while the salmon bites are in the fryer.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sprinkle salmon evenly with 1/2 teaspoon salt. Whisk together granulated garlic, 1/4 cup mayonnaise, 1 1/2 teaspoons sesame oil, 1 1/2 teaspoons soy sauce, 1 teaspoon lime juice, and remaining 1/2 teaspoon salt in a bowl. Add salmon to mayonnaise mixture and gently toss to coat."
    },
    {
      "position": 3,
      "text": "Stir together panko, sesame seeds, and 1 teaspoon sesame oil in a shallow bowl. Working in 4 batches, dredge salmon in panko mixture, gently pressing to adhere, and transfer to a large plate or baking sheet."
    },
    {
      "position": 4,
      "text": "Lightly coat the air fryer basket with cooking spray. Place half of salmon in basket, spaced at least 1 inch apart. Cook at 400 degrees F (200 degrees C) until browned and an instant-read thermometer inserted into the thickest part of salmon registers 125 degrees F (52 degrees C), about 5 minutes. Transfer cooked salmon to a plate, and repeat with remaining salmon."
    },
    {
      "position": 5,
      "text": "While salmon cooks, stir together chili garlic sauce, honey, remaining 1/4 cup mayonnaise, 1 1/2 teaspoons soy sauce, 1/2 teaspoon toasted sesame oil, and 1/2 teaspoon lime juice in a small bowl. Drizzle chili garlic mixture over cooked salmon and serve with lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

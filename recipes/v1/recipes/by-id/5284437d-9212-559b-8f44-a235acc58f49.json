  "slug": "no-bake-energy-balls",
  "name": "Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "Energy balls are easy to make with oats, nutritious seeds, peanut butter, and chocolate chips for a fantastic on-the-go breakfast or healthier snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine oats, peanut butter, ground flaxseed, chocolate chips, honey, chia seeds, and vanilla extract together in a bowl. Cover and chill the dough in the refrigerator for 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove chilled dough from the refrigerator; roll into twenty 1-inch diameter balls."
    }
  ],
  "servings": 20,

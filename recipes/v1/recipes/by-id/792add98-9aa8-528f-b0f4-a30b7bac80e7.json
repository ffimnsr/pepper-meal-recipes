  "id": "792add98-9aa8-528f-b0f4-a30b7bac80e7",
  "slug": "malted-milk-ball-brownies-recipe-11775372",
  "name": "Malted Milk Ball Brownies",
  "recipe_type": "dessert",
  "brief_description": "These malted milk ball brownies are fan-favorite chocolate brownies, with an added roasty, rich flavor and crunch from malted milk balls.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line an 8-inch square baking pan with parchment paper, extending over the edges of pan."
    },
    {
      "position": 2,
      "text": "Melt butter and chocolate in a medium saucepan over low heat. Remove from heat; let cool 10 minutes."
    },
    {
      "position": 3,
      "text": "Whisk together flour, malted milk powder, baking soda, and salt in a small bowl."
    },
    {
      "position": 4,
      "text": "Stir sugar into melted chocolate mixture. Add eggs, one at a time, beating well with a wooden spoon. Stir in vanilla. Stir in flour mixture until combined. Stir in 3/4 cup chopped malted milk balls. Spread batter in prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until center is set, about 30 minutes. Immediately sprinkle with milk chocolate chips and remaining 1/2 cup chopped malted milk balls; gently press into brownies. Cool in the pan on a wire rack. Use parchment to lift brownies from pan to a cutting board. Cut into 9 brownies. Garnish with sprinkles and additional chopped malted milk balls."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

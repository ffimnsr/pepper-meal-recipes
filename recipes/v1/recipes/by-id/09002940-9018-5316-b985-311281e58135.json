  "id": "09002940-9018-5316-b985-311281e58135",
  "slug": "grandmas-secret-pie-crust",
  "name": "Grandma\u2019s Secret Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "The secret\u2019s out! A great basic pie crust from Grandma\u2019s secret recipes. Vinegar is the key to this dough that rolls out perfectly, and the bakes beautifully.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "In large bowl mix flour and salt. Cut in shortening with two butter knives."
    },
    {
      "position": 3,
      "text": "In a separate bowl, mix together egg, vinegar, and water. Drizzle wet mixture into dry mixture, cutting it in."
    },
    {
      "position": 4,
      "text": "Roll out dough, and fit into two 9-inch pie pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 12 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "2c151214-e688-5e6b-bfc6-9e56d4ebf337",
  "slug": "simple-baked-beans",
  "name": "Easy Baked Beans",
  "recipe_type": "side",
  "brief_description": "These easy baked beans are made with canned beans, molasses, brown sugar, and onion baked in the oven until thick and flavorful for a simple meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix together baked beans with pork, molasses, onions, brown sugar, ketchup, and mustard together in a large bowl."
    },
    {
      "position": 3,
      "text": "Transfer mixture to the prepared dish and top with chopped bacon."
    },
    {
      "position": 4,
      "text": "Cover and bake in the preheated oven until thickened, about 3 hours."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 15,

  "id": "a88f622a-eaeb-5332-a3ea-a56d1ed9699a",
  "slug": "crunchy-cucumber-and-edamame-salad-recipe-12063101",
  "name": "Crunchy Cucumber and Edamame Salad",
  "recipe_type": "salad",
  "brief_description": "Fresh, crunchy, and full of flavor, this salad combines crisp cucumber, edamame, radishes, and creamy avocado with a sweet and tangy dressing. Ready in under 30 minutes, it\u2019s an easy side dish or light lunch. I buy precut radish matchsticks to save time, but you can certainly cut your own.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl or jar, whisk together the avocado oil, rice wine vinegar, honey, soy sauce, sesame oil, Sriracha and garlic. Set aside."
    },
    {
      "position": 2,
      "text": "Cut cucumber in half lengthwise, then slice thinly into half-moons. Place in a large bowl, along with radishes, avocado, green onions, and cilantro."
    },
    {
      "position": 3,
      "text": "Pour dressing over the salad and gently toss to coat. Taste and season with salt and pepper, if desired. Best served the same day, but can be refrigerated up to 3 days."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

  "id": "a7db16a9-882c-5658-b1a3-9bc421eda7e0",
  "slug": "monster-breakfast-cookies",
  "name": "Monster Breakfast Cookies",
  "recipe_type": "dessert",
  "brief_description": "This breakfast cookie is packed with grains and seeds to help give a quick boost you can just grab and go!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 4 baking sheets."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar with an electric mixer in a large bowl until smooth. Beat the first egg into the butter until completely blended. Add second egg with vanilla extract; continue beating. Continue beating while adding vegetable oil, honey, oats, whole wheat flour, ground flax seed, sesame seeds, poppy seeds, flax seeds, baking soda, and ground cinnamon, respectively. Fold raisins into the dough."
    },
    {
      "position": 3,
      "text": "Use a 1/4 cup measuring cup to create monster cookie size and drop onto prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are just browning, about 20 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

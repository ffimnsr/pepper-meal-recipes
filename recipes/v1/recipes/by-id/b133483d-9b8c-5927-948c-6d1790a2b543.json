  "id": "b133483d-9b8c-5927-948c-6d1790a2b543",
  "slug": "sweet-and-spicy-high-protein-snack-mix",
  "name": "Sweet and Spicy High-Protein Snack Mix",
  "recipe_type": "appetizer",
  "brief_description": "This sweet and spicy high-protein snack mix recipe uses honey, cayenne, and chili powder along with smoked beef sticks, cereal, sunflower seeds, and nuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine wheat cereal squares, mixed nuts, oat cereal, pretzels, crackers, and sunflower seeds in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Combine butter, honey, Worcestershire sauce, salt, cayenne pepper, chili powder, garlic powder, and onion powder in a small saucepan over medium-low heat until butter is melted and spices are blended; pour over wheat cereal square mixture and stir until well combined. Transfer to a large baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 1 hour, stirring every 15 minutes. Cool completely."
    },
    {
      "position": 5,
      "text": "Stir in dried cherries and smoked beef stick pieces."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

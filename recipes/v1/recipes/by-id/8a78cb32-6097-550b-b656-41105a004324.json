  "id": "8a78cb32-6097-550b-b656-41105a004324",
  "slug": "spicy-butternut-squash-and-carrot-soup",
  "name": "Spicy Butternut Squash and Carrot Soup",
  "recipe_type": "soup",
  "brief_description": "Full of spicy, comforting flavor, this easy butternut squash and carrot soup recipe makes a simple weeknight meal that goes perfectly with toasted bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place squash and carrots in a large bowl. Drizzle with 1 tablespoon olive oil; season with curry powder, chili powder, black pepper, and salt and toss until evenly coated. Transfer squash mixture to a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until vegetables are soft, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine onion, habanero, garlic, and remaining 1 tablespoon olive oil in a large pot over medium heat; cook until soft and fragrant, 5 to 7 minutes. Add water and bouillon, increase heat to medium-high, and bring to a boil."
    },
    {
      "position": 5,
      "text": "Stir roasted squash and carrots into soup, reduce heat, and simmer 10 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Fill a blender (or the bowl of a food processor) halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour into a pot. Repeat with remaining soup."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4f910fb7-13ef-51d8-836e-b04386474462",
  "slug": "spruced-up-zatarains-jambalaya",
  "name": "Spruced-Up Zatarain's Jambalaya",
  "recipe_type": "soup",
  "brief_description": "A box of Zatarain's jambalaya mix is combined with andouille sausage, onion, and a can of diced tomatoes with green chile peppers for fantastic results.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium-high heat. Add sausage and onion; saut\u00e9 until sausage is browned and onion is translucent, 7 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Pour in water, then add jambalaya mix and diced tomatoes with chile peppers; bring to a boil. Reduce the heat to low, cover, and simmer until water is mostly absorbed and rice is tender, about 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

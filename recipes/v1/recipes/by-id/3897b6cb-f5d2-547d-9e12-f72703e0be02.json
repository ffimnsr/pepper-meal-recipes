  "id": "3897b6cb-f5d2-547d-9e12-f72703e0be02",
  "slug": "brownie-cookie-whoopie-pies",
  "name": "Brownie Cookie Whoopie Pies",
  "recipe_type": "dessert",
  "brief_description": "Soft, chewy cookies with rich, chocolate brownie flavor are filled with a sweet, creamy, marshmallow filling in this tasty whoopie pie recipe using brownie mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper. Lightly coat a wire rack with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir brownie mix and flour together in a medium bowl until well combined. Add chocolate chips, oil, and eggs; stir until well blended."
    },
    {
      "position": 3,
      "text": "Scoop 20 rounded tablespoons onto the prepared baking sheets. Decorate 1/2 of the cookies with candy sprinkles."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 9 to 10 minutes. Remove from the oven and let stand for 2 to 3 minutes before removing to the sprayed rack to cool completely, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine powdered sugar, butter, and vanilla in the bowl of a stand mixer fitted with the paddle attachment; blend until light and fluffy, about 4 minutes. Fold in marshmallow creme."
    },
    {
      "position": 6,
      "text": "Place marshmallow mixture in a large zip-top bag and cut a small hole in one corner. Pipe filling onto the center of one plain cookie and top with a sprinkled cookie. Repeat with remaining filling and cookies."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

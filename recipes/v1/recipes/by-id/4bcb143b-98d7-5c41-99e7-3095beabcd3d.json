{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4bcb143b-98d7-5c41-99e7-3095beabcd3d",
  "slug": "baked-bbq-baby-back-ribs",
  "name": "Oven-Baked Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "Chef John's oven-baked baby back ribs are seasoned with a homemade dry rub, then glazed with barbeque sauce and baked until tender and delicious. No grill required!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients and preheat the oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix ancho chile powder, white and brown sugars, salt, black pepper, cumin, dry mustard, cayenne, and chipotle pepper in a small bowl until combined."
    },
    {
      "position": 3,
      "text": "Place rib rack, meat-side down, on heavy-duty aluminum foil. Prick back of the rack several times with a knife. Generously apply a coating of dry rub to all sides of the rack. Store any remaining dry rub in an airtight container for future use."
    },
    {
      "position": 4,
      "text": "With the meat facing down, fold foil around the rack to create a tight seal. Transfer to a sheet pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tender and cooked through, about 2 hours. Remove and cool 15 minutes."
    },
    {
      "position": 6,
      "text": "Increase oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Open foil, drain and discard any accumulated juices and fat. Brush barbeque sauce on all sides of the rack."
    },
    {
      "position": 8,
      "text": "Turn the rack on the foil so the meat is facing up. Return to the oven, leaving the foil open and bake for 10 minutes. Remove from the oven and brush another layer of barbeque sauce on the meat side only. Repeat baking and brushing with sauce 4 more times, for a total of 50 minutes baking time."
    },
    {
      "position": 9,
      "text": "Cut rack into individual rib segments and serve with more barbeque sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 170,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "slug": "deviled-egg-salad",
  "name": "Deviled Egg Salad",
  "recipe_type": "salad",
  "brief_description": "With its creamy, rich texture and bold taste, this deviled egg salad recipe is a versatile option for sandwiches, wraps, or a low-carb salad topping.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mayonnaise, green onion, mustard, salt, garlic powder, paprika, and black pepper in a bowl until smooth. Add eggs; gently stir until coated in mayonnaise mixture."
    }
  ],

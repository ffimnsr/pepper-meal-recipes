  "id": "4de1c539-322b-58ab-9d2d-0c2a56d82a04",
  "slug": "easy-pecan-sticky-buns-recipe-8745327",
  "name": "Easy Pecan Sticky Buns",
  "recipe_type": "dessert",
  "brief_description": "Made with just Hawaiian rolls, pecans, and a homemade sticky sauce, this 30-minute breakfast couldn't be easier to make at home. Talk about sweet!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 8x8 cake pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine butter, sugar, salt, and honey in a pan set over medium heat. Stir while cooking until the sugar dissolves and mixture starts to bubble a little bit, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Turn off the heat and add vanilla bean paste, heavy cream, and chopped pecans. Mix until the pecans are fully coated and set aside to cool slightly"
    },
    {
      "position": 4,
      "text": "Pour all of the sauce in the pan into the prepared cake pan and spread it out into an even layer. Add Hawaiian rolls, top side down."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the sauce is very bubbly and the buns are slightly browned , 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Let it cool for up to 5 minutes before flipping onto a cutting board or plate"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

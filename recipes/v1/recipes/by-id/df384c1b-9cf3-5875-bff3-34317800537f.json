  "id": "df384c1b-9cf3-5875-bff3-34317800537f",
  "slug": "classic-macaroni-salad",
  "name": "Classic Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "This easy macaroni salad with crunchy veggies tossed in a creamy, tangy dressing is always a popular side dish at every cookout, potluck, and picnic!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Rinse under cold water and drain."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise, sugar, vinegar, mustard, salt, pepper, and macaroni pasta together in a large bowl."
    },
    {
      "position": 4,
      "text": "Stir in celery, onion, green pepper, carrot, and pimentos."
    },
    {
      "position": 5,
      "text": "Refrigerate salad for at least 4 hours before serving, but preferably overnight."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

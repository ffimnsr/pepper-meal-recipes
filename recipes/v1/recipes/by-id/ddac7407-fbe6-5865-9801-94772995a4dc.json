  "slug": "dominican-style-oatmeal",
  "name": "Dominican-Style Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "While living in the Dominican Republic, I discovered their creamy, easy, and flavorful way of preparing oatmeal. Such a comforting way to begin the day!",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, oats, sugar, cinnamon, nutmeg, and salt in a saucepan. Add lemon zest, if using. Bring to a boil, stirring constantly, until oats are tender, about 2 minutes."
    }
  ],
  "servings": 2,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "42b2b276-c091-5821-bc57-15ab4672d892",
  "slug": "chef-johns-french-fries",
  "name": "Chef John's French Fries",
  "recipe_type": "side",
  "brief_description": "Learn how to make French fries that are super crispy with Chef John's twice-fried method. Soft on the inside, and perfectly crunchy on the outside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Soak potato strips in a large bowl of water for about 30 minutes."
    },
    {
      "position": 2,
      "text": "Pat with paper towels until thoroughly dry."
    },
    {
      "position": 3,
      "text": "Heat oil in a deep-fryer or large saucepan to 275 degrees F (135 degrees C). Gently add potatoes to the hot oil and fry for about 5 minutes, stirring and flipping the potatoes occasionally."
    },
    {
      "position": 4,
      "text": "Use a slotted spoon to transfer potatoes to a paper towel-lined plate. Let cool completely."
    },
    {
      "position": 5,
      "text": "Heat oil again, but this time to 350 degrees F (175 degrees C). Add potatoes and fry a second time until golden brown, 5 to 6 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the deep-fryer and blot with a paper towel. Sprinkle with salt to serve."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "curried-egg-sandwiches",
  "name": "Curried Egg Sandwiches",
  "recipe_type": "salad",
  "brief_description": "Delicious curried egg salad sandwiches are simple and satisfying. The curry powder gives a nice flavor twist that complements the mayo and egg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather your ingredients."
    },
    {
      "position": 2,
      "text": "Mix together mayonnaise and curry powder in a bowl. Gently stir in eggs, then season to taste with salt and pepper."
    },
    {
      "position": 3,
      "text": "Evenly divide between 4 slices of bread, top with remaining 4 slices."
    }
  ],
  "servings": 4,

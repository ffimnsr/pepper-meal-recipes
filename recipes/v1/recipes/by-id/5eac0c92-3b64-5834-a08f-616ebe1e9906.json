{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5eac0c92-3b64-5834-a08f-616ebe1e9906",
  "slug": "balsamic-braised-pork-tenderloins-with-fresh-figs",
  "name": "Balsamic Braised Pork Tenderloins with Fresh Figs",
  "recipe_type": "main",
  "brief_description": "Pork tenderloins are braised in balsamic vinegar with fresh figs and shallots. A wonderful dish for fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pat tenderloins dry and remove silver skin, if present. Season with kosher salt and freshly ground pepper, to taste."
    },
    {
      "position": 3,
      "text": "Pour oil into a large, oven-proof skillet and heat over medium-heat until oil shimmers. Carefully place seasoned tenderloins into the hot oil and brown on all sides, 7 to 10 minutes total."
    },
    {
      "position": 4,
      "text": "Add sliced shallots around tenderloins and stir, about 1 minute. Add figs, chicken broth, and balsamic vinegar. When the mixture begins to bubble, sprinkle minced rosemary over everthing."
    },
    {
      "position": 5,
      "text": "Cover, place in the preheated oven and bake until pork is no longer pink in the center, 25 to 30 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 6,
      "text": "Using tongs, remove pork from the skillet and place on a serving platter. With a slotted spoon, remove figs from the skillet and place around the tenderloins. Cover loosely with foil."
    },
    {
      "position": 7,
      "text": "Place skillet back onto the stovetop over medium-high heat. Bring pan juices to a boil and allow to reduce to about 3/4 cup, 10 to 15 minutes."
    },
    {
      "position": 8,
      "text": "Slice tenderloins, drizzle reduced liquid over the meat, and garnish with fresh rosemary sprigs, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

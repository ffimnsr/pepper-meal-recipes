  "id": "7d43ddbf-5b7c-5128-8adf-abaaad67c3e1",
  "slug": "baked-mac-n-cheese-with-chicken-meatballs-recipe-7569687",
  "name": "Baked Mac ‘n' Cheese with Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "This easy dinner adds bold flavors to pre-cooked chicken meatballs and boxed mac 'n' cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a saucepan. Add macaroni and cook until tender, 7 to 8 minutes; drain. Stir in margarine, milk, and cheese sauce packet. Set aside to cool slightly."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch baking dish."
    },
    {
      "position": 3,
      "text": "Stir together prepared mac and cheese, Cheddar cheese, onions, jalapeno, egg, garlic powder, onion powder, and paprika until well combined. Stir in meatballs. Pour macaroni mixture into the prepared dish. Top with bread crumbs."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes. Top with barbeque sauce and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "red-white-and-blue-strawberry-shortcake",
  "name": "Red, White, and Blue Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This red, white, and blue cake with whipped topping is decorated with blueberries and strawberries for the stars and stripes on the American flag.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare cake according to package directions and bake in a 9x13-inch pan. Cool completely."
    },
    {
      "position": 2,
      "text": "Frost cake with whipped topping. Place blueberries in a square in the corner, and arrange sliced strawberries as stripes to make an American flag. Chill until serving."
    }
  ],

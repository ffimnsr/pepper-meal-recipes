  "id": "7135e2ef-3447-5d7f-b3c8-687d010f4087",
  "slug": "chef-neals-strawberry-rhubarb-sour-cream-pies",
  "name": "Chef Neal's Strawberry-Rhubarb Sour Cream Pies",
  "recipe_type": "dessert",
  "brief_description": "Chef Neal's strawberry-rhubarb sour cream pie recipe uses sour cream as the secret ingredient for an extra-rich filling and yields two 9-inch pies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line 2 pie plates with pie crusts."
    },
    {
      "position": 2,
      "text": "Combine sour cream and eggs in a large bowl; stir in sugar, \u00bc cup flour, vanilla, and salt until well blended. Fold in strawberries and rhubarb until evenly distributed; divide filling between pie crusts. Cover pie crusts with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust is lightly browned, about 15 minutes. Reduce heat to 350 degrees F (175 degrees C); continue baking until filling is soft and nicely thickened, about 20 minutes more."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine brown sugar and remaining \u00bd cup flour in a medium bowl; cut in butter until mixture resembles coarse crumbs."
    },
    {
      "position": 5,
      "text": "Sprinkle pies with crumb mixture; continue baking until filling is set, 20 to 25 minutes more."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,

  "id": "6eb21f34-3a9a-5ec2-b8e2-70c0f85633ea",
  "slug": "bc-cherry-jam",
  "name": "Cherry Jam",
  "recipe_type": "dessert",
  "brief_description": "This beautiful red cherry jam is a delicious way to preserve sweet cherries so you can enjoy a little taste of summer later in the year!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cherries, apple juice, lemon juice, and pectin into a large saucepan over medium heat; bring to a boil and mix in sugar. Cook jam at a rolling boil for 2 minutes, stirring constantly. Remove from heat and skim off any foam."
    },
    {
      "position": 2,
      "text": "Sterilize the jars and lids in boiling water for at least 5 minutes. Pack cherry jam into the hot, sterilized jars, filling the jars to within 1/4 inch of the top. Run a knife or a thin spatula around the insides of the jars after they have been filled to remove any air bubbles. Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with lids, and screw on rings."
    },
    {
      "position": 3,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil over high heat, then carefully lower the jars into the pot using a holder. Leave a 2 inch space between the jars. Pour in more boiling water if necessary until the water level is at least 1 inch above the tops of the jars. Bring the water to a full boil, cover the pot, and process for 15 minutes, or the time as recommended by your county Extension agent."
    },
    {
      "position": 4,
      "text": "Remove the jars from the stockpot and place onto a cloth-covered or wood surface, several inches apart, until cool. Once cool, press the top of each lid with a finger, ensuring that the seal is tight (lid does not move up or down at all). Store in a cool, dark area."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

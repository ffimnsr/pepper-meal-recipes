  "id": "df6c8efc-2398-5460-a0b1-14a044ad0561",
  "slug": "mexican-bean-and-tortilla-soup-sopa-tarasca",
  "name": "Mexican Bean and Tortilla Soup (Sopa Tarasca)",
  "recipe_type": "soup",
  "brief_description": "Vegetarians will love this easy, authentic Mexican bean and tortilla soup filled with roasted tomatoes, pasilla chiles, and serrano peppers.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons oil in a skillet over medium-low heat. Cook pasilla chiles until light brown, being careful not to burn them, 1 to 2 minutes. Transfer chiles to a plate. Increase skillet heat to medium-high; cook tortillas in the same oil until crisp and golden brown, about 3 minutes. Remove from skillet."
    },
    {
      "position": 2,
      "text": "Wipe out skillet and place back over medium-high heat. Add tomato and serrano peppers. Roast in the dry skillet, turning occasionally, until skin is charred and flesh is soft, 8 to 12 minutes. Let cool briefly. Peel tomatoes and place in a blender along with serrano peppers. Add water and blend until smooth."
    },
    {
      "position": 3,
      "text": "Heat remaining 1 tablespoon oil in a saucepan over medium heat. Add onion; cook and stir until translucent, about 5 minutes. Pour in the tomato mixture; cook until thickened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Pour beans into the blender; process until smooth. Add to the saucepan with the tomato mixture. Add oregano and season with salt. Bring soup to a simmer until beans are heated through, about 5 minutes. Garnish soup with the toasted pasilla chile, tortilla strips, and Cotija cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

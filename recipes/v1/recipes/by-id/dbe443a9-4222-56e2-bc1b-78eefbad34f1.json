  "id": "dbe443a9-4222-56e2-bc1b-78eefbad34f1",
  "slug": "breakfast-enchilada-casserole-recipe-11706588",
  "name": "Breakfast Enchilada Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This breakfast enchilada casserole is a perfect dish to serve guests. Scrambled eggs with ham and cheese filled in corn tortillas, then dressed with enchilada sauce, and baked topped with queso until bubbly.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk eggs, salt, pepper, 1/4 cup cheese, and ham in a mixing bowl. Heat a large skillet over medium-high heat. Pour egg mixture in and cook for 3 minutes. Stir and cook for 2 minutes more."
    },
    {
      "position": 3,
      "text": "Divide egg mixture equally into tortillas, about 2 tablespoons each. Roll tortillas up and place seam side down in a glass casserole dish. Pour enchilada sauce over the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Top with remaining 1 3/4 cups cheese and cook until cheese is melted and golden, about 10 minutes more."
    },
    {
      "position": 5,
      "text": "Let stand for 5 minutes before serving. Garnish with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,

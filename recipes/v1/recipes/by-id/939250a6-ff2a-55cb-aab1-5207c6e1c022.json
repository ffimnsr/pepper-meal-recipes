  "id": "939250a6-ff2a-55cb-aab1-5207c6e1c022",
  "slug": "beef-pot-pie-i",
  "name": "Beef Pot Pie I",
  "recipe_type": "main",
  "brief_description": "This version of a traditional family favorite calls for beef tenderloin, and includes porcini mushrooms, carrots, celery, and potatoes. Packaged puff pastry makes the topping.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large skillet, cook bay leaf, oregano, onions and mushrooms in olive oil until soft. Stir in garlic, carrots, celery, potatoes, and meat."
    },
    {
      "position": 3,
      "text": "Cook and stir for 10 minutes, or until meat starts to brown. Pour in wine. Bring to a boil, and reduce heat to simmer. Simmer for 35 to 45 minutes."
    },
    {
      "position": 4,
      "text": "Place in pie dish, sprinkle with parsley, and cover with pastry. Brush with egg whites."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes to 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 60,

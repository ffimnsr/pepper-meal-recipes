  "id": "f41e5094-a368-5a52-90e2-08c3e696b8e6",
  "slug": "bake-sale-chocolate-chip-oatmeal-brownies",
  "name": "Bake Sale Chocolate Chip Oatmeal Brownies",
  "recipe_type": "dessert",
  "brief_description": "These moist, delicious chocolate chip oatmeal brownies are a winner with everyone and make for a popular bake sale item.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and sugars with an electric mixer until light and fluffy. Beat in eggs and vanilla extract. Blend in flour, baking powder, cinnamon, and salt. Mix in oats and 1 cup chocolate chips."
    },
    {
      "position": 3,
      "text": "Spread batter evenly in an ungreased 9x13-inch baking pan. Sprinkle remaining 1 cup chocolate chips evenly on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are browned and center is light brown, 20 to 22 minutes. Do not overbake. Cool completely before cutting into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

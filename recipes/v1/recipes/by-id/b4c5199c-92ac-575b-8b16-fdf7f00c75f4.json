  "id": "b4c5199c-92ac-575b-8b16-fdf7f00c75f4",
  "slug": "coconut-tamari-mushroom-soup",
  "name": "Coconut-Tamari Mushroom Soup",
  "recipe_type": "soup",
  "brief_description": "Mushrooms, coconut milk, and seaweed combine in this Thai-inspired vegan soup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve the vegetable bouillon cubes in the boiling water, then stir in the sliced mushrooms; set aside for 20 minutes. Place the seaweed in a small bowl, and cover with warm water; set aside."
    },
    {
      "position": 2,
      "text": "Heat the olive oil in a large saucepan over medium-low heat. Stir in the garlic and cook until softened, about 5 minutes. Strain the mushrooms from the vegetable broth and squeeze dry; reserve the broth. Stir the mushrooms into the pot; cook and stir until the mushrooms have browned and are tender, about 15 minutes. Pour in the coconut milk and reserved vegetable broth. Drain the wakame and squeeze out excess water. Add the wakame to the pot along with the cilantro, lime juice, and tamari. Bring to a boil over medium-high heat, then reduce heat to medium-low, cover, and simmer to let the flavors mingle, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

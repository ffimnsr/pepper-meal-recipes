  "id": "5e623a7a-b6e5-510a-aba7-bcb10e02f79a",
  "slug": "italian-peas",
  "name": "Italian Peas",
  "recipe_type": "side",
  "brief_description": "Frozen peas are made fabulous by saut\u00e9ing with garlic and onions, then simmering with chicken stock until tender. A fresh take on a classic side dish.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat. Stir in onion; cook until softened, about 5 minutes. Stir in garlic and cook for 1 minute."
    },
    {
      "position": 3,
      "text": "Add frozen peas and stir in stock. Season with salt and pepper. Cover and cook until the peas are tender, about 5 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

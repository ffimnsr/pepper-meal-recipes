  "id": "a0cd7d38-f993-5552-9e0f-36f0c4d01d3b",
  "slug": "panettone-french-toast",
  "name": "Panettone French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Try this French toast recipe for a special holiday twist on a breakfast classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather your ingredients."
    },
    {
      "position": 2,
      "text": "Whisk milk, egg, and cinnamon together in a shallow bowl."
    },
    {
      "position": 3,
      "text": "Dip panettone slice in the milk mixture; turn to ensure both sides are coated and most of the liquid has been absorbed."
    },
    {
      "position": 4,
      "text": "Melt butter in a nonstick skillet over medium-low heat. Cook panettone in the hot butter until golden brown, about 5 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve with warm maple syrup or your favorite toppings."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

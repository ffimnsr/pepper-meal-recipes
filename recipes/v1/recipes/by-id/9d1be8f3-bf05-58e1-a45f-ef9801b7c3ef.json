  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9d1be8f3-bf05-58e1-a45f-ef9801b7c3ef",
  "slug": "asian-inspired-pork-and-mushroom-sloppy-joes-recipe-7369808",
  "name": "Asian-Inspired Pork and Mushroom Sloppy Joes",
  "recipe_type": "dessert",
  "brief_description": "These pork and mushroom Sloppy Joes are a fabulous fusion, a perfect balance of sweet, slightly spicy, and umami flavors, with a delectably crunchy, tangy slaw.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Add coleslaw mix, green onions, and cilantro to a bowl. Whisk rice vinegar, 1 1/2 tablespoons sesame oil, 1 tablespoon Sriracha, 1 1/2 teaspoons soy sauce, and 1 teaspoon sesame seeds together in a cup. Pour dressing over slaw and toss to coat. Set aside to marinate, tossing occasionally, at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Whisk water, hoisin sauce, 1 tablespoon Sriracha, fish sauce, and 2 teaspoons sesame oil together in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat a 12-inch skillet over medium heat. Cook and stir pork in the hot skillet with a generous pinch Kosher salt, breaking up pork with a spatula, until browned and crumbly and fat has rendered, 8 to 10 minutes. Remove pork to the bowl with water-hoisin sauce mixture."
    },
    {
      "position": 4,
      "text": "Pulse mushroom pieces in a food processor until the size of green peas, 8 to 10 times. Heat 1 teaspoon olive oil in the same skillet over medium heat. Cook and stir mushrooms with a generous pinch of salt until liquid has evaporated and mushrooms are beginning to turn golden brown, 8 to 10 minutes. Transfer mushrooms to the bowl with pork."
    },
    {
      "position": 5,
      "text": "Meanwhile, pulse onion chunks, bell pepper chunks, and jalape\u00f1o together in the food processor until vegetable mixture resembles pico de gallo, about 15 times."
    },
    {
      "position": 6,
      "text": "Heat 1 teaspoon olive oil in the pan. Add onion mixture and a pinch of salt and cook until onions are translucent and most of the liquid has evaporated, 5 to 7 minutes."
    },
    {
      "position": 7,
      "text": "Process garlic cloves in the food processor until small enough that all the bits are sticking to the sides, about 10 seconds. Stir garlic and ginger paste into the skillet with onion mixture and cook until fragrant, about 30 seconds. Return meat and mushroom mixture to the skillet. Stir to combine; simmer until meat is coated in a thick sauce and most liquid has evaporated, 10 to 12 minutes."
    },
    {
      "position": 8,
      "text": "Mix mayonnaise and sesame oil in a small bowl. Spread a thin coat of mayonnaise mixture inside of both top and bottom buns. Add to a nonstick pan and toast over medium heat until golden, about 2 minutes."
    },
    {
      "position": 9,
      "text": "Top prepared buns with sloppy joe mix, coleslaw, cilantro leaves, and a drizzle of Sriracha. Top with the other bun half."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,

  "slug": "berrylicious-frozen-sangria-slush",
  "name": "Berrylicious Frozen Sangria Slushie",
  "recipe_type": "drink",
  "brief_description": "This frozen sangria or wine slushie recipe is a refreshing icy blend of red wine, frozen berries, and fresh orange juice. Perfect for summer drinking!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine red wine, ice cubes, blueberries, raspberries, strawberries, orange-flavored liqueur, orange juice, and sugar in a blender; process until smooth. Serve immediately or freeze."
    }
  ],
  "servings": 2,

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d03a9c8a-0d1c-57ed-9c7c-49d723f66ca1",
  "slug": "smothered-beef-short-ribs",
  "name": "Smothered Beef Short Ribs",
  "recipe_type": "main",
  "brief_description": "This beef short ribs recipe skips the oven in favor of the stovetop. Flour-dredged ribs are seared, then simmered with veggies and herbs in a savory stock.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Season ribs with salt and pepper, then dredge in flour."
    },
    {
      "position": 3,
      "text": "Heat oil in a large pot over medium-high heat. Sear ribs in hot oil in small batches, adding oil as needed, 2 to 3 minutes per batch. Transfer to a plate."
    },
    {
      "position": 4,
      "text": "Add onions to the pot and saut\u00e9 for 2 minutes. Add celery and carrots; saut\u00e9 for 1 minute."
    },
    {
      "position": 5,
      "text": "Season with salt and pepper, then stir in garlic, thyme, and bay leaves. Cook until fragrant, about 1 minute."
    },
    {
      "position": 6,
      "text": "Pour wine into the pot and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Add stock and bring to a boil."
    },
    {
      "position": 7,
      "text": "Reduce the heat to low and add ribs."
    },
    {
      "position": 8,
      "text": "Simmer until meat pulls away easily from the bone and sauce has thickened, about 2 hours."
    },
    {
      "position": 9,
      "text": "Discard bay leaves. Stir in parsley and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

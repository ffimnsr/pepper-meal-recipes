  "id": "d2c72543-d187-5fd6-a52d-b2146d3d953a",
  "slug": "slow-cooker-chicken-gumbo-with-shrimp",
  "name": "Slow Cooker Chicken Gumbo with Shrimp",
  "recipe_type": "soup",
  "brief_description": "This crockpot gumbo features chicken thighs, shrimp, and veggies simmered with stewed tomatoes in a slow cooker for a no-fuss meal served over rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 5- to 6-quart slow cooker with Reynolds slow cooker liner."
    },
    {
      "position": 2,
      "text": "Place tomatoes, chicken, broth, green pepper, onion, celery, garlic, Cajun seasoning, black pepper, and cayenne pepper into the prepared slow cooker. Stir gently with a wooden spoon or rubber scraper to combine."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 6 hours."
    },
    {
      "position": 4,
      "text": "Remove the lid and stir in shrimp gently with a wooden spoon or rubber scraper. Cover and continue cooking on Low until shrimp is opaque, about 3 minutes more. Serve over cooked rice."
    }
  ],
  "servings": 8,

  "id": "be7626dd-22bf-5295-80d1-3434df4acc3f",
  "slug": "ham-and-cheese-omelet-casserole",
  "name": "Ham and Cheese Omelet Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This ham, egg, and cheese breakfast casserole made without bread is a simple way to start your day. Try it with a few sliced scallions or fresh herbs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 9-inch deep-dish pie pan."
    },
    {
      "position": 2,
      "text": "Whisk eggs in a large bowl until frothy on top. Whisk in milk, salt, and pepper until well combined. Stir in ham and then cheese until well combined; pour into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set in the center and lightly browned on top, 50 to 60 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

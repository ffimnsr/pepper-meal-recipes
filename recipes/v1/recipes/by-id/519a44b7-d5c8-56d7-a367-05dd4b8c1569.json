  "id": "519a44b7-d5c8-56d7-a367-05dd4b8c1569",
  "slug": "quick-italian-pasta-salad",
  "name": "Italian Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This Italian pasta salad with salami, mozzarella, bell pepper, and rotini pasta tossed in zesty Italian dressing is sure to be a summer favorite.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook rotini pasta at a boil until tender yet firm to the bite, about 8 minutes. Drain and rinse with cold water until cool."
    },
    {
      "position": 3,
      "text": "Combine pasta, salami, bell peppers, onion, mozzarella balls, and olives in a large bowl. Add salad dressing and toss to coat."
    },
    {
      "position": 4,
      "text": "Season pasta salad with dry salad dressing mix and stir to combine."
    },
    {
      "position": 5,
      "text": "Sprinkle with Parmesan cheese before serving. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "027bfccd-0e8c-52dd-8a39-ee435e7088d8",
  "slug": "pan-fried-asparagus",
  "name": "Pan-Fried Asparagus",
  "recipe_type": "side",
  "brief_description": "Learn how to cook asparagus on the stove by pan-frying it in butter with olive oil and garlic for a flavorsome, family-pleasing vegetable side dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Add olive oil, salt, and pepper; cook and stir until garlic is fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add asparagus and cook until fork-tender, turning asparagus often to ensure even cooking, about 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

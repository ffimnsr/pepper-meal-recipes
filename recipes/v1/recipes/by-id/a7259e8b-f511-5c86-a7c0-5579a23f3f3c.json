{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a7259e8b-f511-5c86-a7c0-5579a23f3f3c",
  "slug": "air-fryer-calzones-with-two-ingredient-dough",
  "name": "Air Fryer Calzones With Two-Ingredient Dough",
  "recipe_type": "appetizer",
  "brief_description": "These quick and easy calzones are made with two-ingredient dough and cooked in the air fryer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour and yogurt together in a bowl to form a soft dough."
    },
    {
      "position": 2,
      "text": "Transfer to a lightly floured work surface. Roll out into a large circle, about 1/4 to 1/8 inch thick. Use a cereal bowl (or any other smaller bowl), coat the rim with flour, and press down into the dough to cut out 4 circles."
    },
    {
      "position": 3,
      "text": "Spread pizza sauce on the bottom half of each circle, leaving about 1/16th inch of rim space. Sprinkle sauce with mozzarella cheese, then top cheese with 4 slices of pepperoni."
    },
    {
      "position": 4,
      "text": "Fold the top half of the circle over, forming a half circle. Press the edges together to seal. Using the tines of a fork, crimp all the way around the sealed edges of each half circle."
    },
    {
      "position": 5,
      "text": "Spray each calzone with cooking spray and sprinkle Parmesan cheese on top."
    },
    {
      "position": 6,
      "text": "Set an air fryer to 350 degrees F (175 degrees C). Spray air fryer basket with cooking spray. Set calzones into the air fryer basket."
    },
    {
      "position": 7,
      "text": "Air-fry for 5 minutes, flip calzones, and cook until lightly browned, 4 to 5 minutes. Depending on the size of your air fryer you might need to work in batches."
    },
    {
      "position": 8,
      "text": "Check calzones for color and air-fry them for few more minutes if necessary. Remove and allow to cool a few minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

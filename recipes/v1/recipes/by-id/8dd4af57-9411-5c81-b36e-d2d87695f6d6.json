  "slug": "pesto-chicken-pasta-salad-recipe-11747803",
  "name": "Pesto Chicken Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This pesto chicken pasta salad features a tangy pesto dressing, fresh juicy tomatoes, peppery arugula, chicken, cheese, and toasty pine nuts.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook rotini according to package directions. Drain and rinse well under cold water; set aside."
    },
    {
      "position": 3,
      "text": "Stir together pesto, vinegar, garlic, and salt in a large bowl."
    },
    {
      "position": 4,
      "text": "Add chicken, cooked rotini, arugula, tomatoes, half of the cheese, and half of the pine nuts. Toss well. Serve at once or cover and chill up to 6 hours."
    },
    {
      "position": 5,
      "text": "Top with remaining cheese and pine nuts before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "ab546d50-558f-53c9-a72d-911691b388b0",
  "slug": "german-hamburgers-frikadellen",
  "name": "German Hamburgers (Frikadellen)",
  "recipe_type": "main",
  "brief_description": "This frikadellen recipe with ground pork and beef, onion, parsley, egg, and hot paprika makes a batch of delicious pan-fried German meat patties.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Soak kaiser roll in a medium bowl of water for 10 minutes. Drain and squeeze out excess water; crumble into a large bowl."
    },
    {
      "position": 2,
      "text": "Add ground meats, onion, parsley, egg, paprika, salt, and black pepper to crumbled roll; mix until well blended. Shape mixture into large flattened meatballs."
    },
    {
      "position": 3,
      "text": "Heat a large nonstick skillet over medium heat. Fry meatballs in the hot skillet until browned and no longer pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center of a patty should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f8c62529-938d-5019-a5e9-1dba497d3f52",
  "slug": "jalapeno-poppers-i",
  "name": "Cheesy Baked Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "Cheddar cheese and cream cheese are combined to make a rich, delicious filling for these jalape\u00f1o poppers that are baked rather than fried.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium baking sheet."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, Cheddar cheese, and mayonnaise in a medium bowl; stuff into jalape\u00f1o halves."
    },
    {
      "position": 3,
      "text": "Whisk eggs and milk together in a small bowl. Place crushed corn flakes in a separate small bowl."
    },
    {
      "position": 4,
      "text": "Dip 1 stuffed jalape\u00f1o half into egg mixture, letting excess drip back into the bowl. Press into crushed corn flakes to coat; place in a single layer on the prepared baking sheet. Repeat with remaining stuffed jalape\u00f1os."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is bubbly and lightly browned, about 30 minutes."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,

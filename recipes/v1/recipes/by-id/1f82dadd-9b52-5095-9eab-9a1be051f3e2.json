  "id": "1f82dadd-9b52-5095-9eab-9a1be051f3e2",
  "slug": "chicken-spectacular",
  "name": "Chicken Spectacular",
  "recipe_type": "main",
  "brief_description": "Cubed leftover chicken, wild rice, pimentos, green beans, and water chestnuts flavor this easy breezy casserole.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water and wild rice in a saucepan, and bring to a boil. Reduce heat, cover, and simmer for 50 minutes, or until tender."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "In a large bowl, toss together the cooked rice, chicken, cream of celery soup, pimentos, onion, green beans, mayonnaise, water chestnuts, salt, and pepper. Transfer to a 3 quart casserole dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until heated through."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "fe6c1016-8a78-5f13-b74a-ad15003ff8a7",
  "slug": "campbells-easy-chicken-and-cheese-enchiladas",
  "name": "Campbell's Easy Chicken and Cheese Enchiladas",
  "recipe_type": "main",
  "brief_description": "A creamy filling of chicken, sour cream, and cheese gets an added \"kick\" stirred into it with Pace Picante Sauce. Rolled up in tortillas and baked until bubbly, these enchiladas couldn't be easier, or any more delicious.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Stir soup, sour cream, picante sauce, and chili powder in a medium bowl until combined."
    },
    {
      "position": 2,
      "text": "Transfer 1 cup of the soup-sauce mixture into a large bowl; stir in chicken and cheese."
    },
    {
      "position": 3,
      "text": "Divide chicken mixture among the tortillas. Roll up the tortillas and place them seam side up in 11x8-inch shallow baking dish. Pour the remaining picante sauce mixture over the filled tortillas. Cover the baking dish."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F until the enchiladas are hot and bubbling, about 40 minutes. Top with tomato and onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

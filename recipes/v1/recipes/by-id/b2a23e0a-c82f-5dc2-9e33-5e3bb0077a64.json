  "id": "b2a23e0a-c82f-5dc2-9e33-5e3bb0077a64",
  "slug": "pork-and-apple-meatballs-in-bao-style-buns-recipe-11796406",
  "name": "Pork and Apple Meatballs in Bao-Style Buns",
  "recipe_type": "appetizer",
  "brief_description": "Purchased prepared pizza dough offers a shortcut to making tender bao-style buns at home.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Stir together egg, breadcrumbs, applesauce, green onions, soy sauce, salt, and pepper in a bowl. Add ground pork and shredded apple. Mix until combined."
    },
    {
      "position": 2,
      "text": "Shape into 16 (1 1/2 ounce) meatballs. Arrange in a foil-lined shallow baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 to 25 minutes or until an instant-read thermometer inserted into centers registers 160 degrees F (71 degrees C)."
    },
    {
      "position": 4,
      "text": "Whisk together hoisin, sambal oelek, and vinegar in a small bowl. Brush onto meatballs."
    },
    {
      "position": 5,
      "text": "Serve meatballs in Pizza Dough Bao-Style Buns. Garnish with green onions and sesame seeds."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

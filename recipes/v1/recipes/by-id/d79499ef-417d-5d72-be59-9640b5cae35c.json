  "id": "d79499ef-417d-5d72-be59-9640b5cae35c",
  "slug": "grandmas-rice-pudding",
  "name": "Grandma\u2019s Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Grandma\u2019s rice pudding recipe is a simple hot rice pudding served with cinnamon, It\u2019s made with long-grain rice, 2-percent milk, and evaporated milk.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Add milk, evaporated milk, sugar, and butter; stir well and cook until creamy, about 20 minutes more. Sprinkle with cinnamon, then serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,

  "id": "87bb4325-465a-5faa-adcb-2fad7aaed97a",
  "slug": "chef-johns-apple-butter",
  "name": "Chef John's Apple Butter",
  "recipe_type": "side",
  "brief_description": "This recipe for apple butter combines chopped apples with sugar and spices in a slow cooker. Simmer all day until rich and concentrated for a fabulous fruity spread!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place apple pieces into a large slow cooker. Add white sugar, brown sugar, salt, cinnamon, nutmeg, allspice, and vinegar. Add water and mix well."
    },
    {
      "position": 2,
      "text": "Cover and cook on High until apples are starting to soften and release liquid, 1 to 2 hours. Reduce heat to Low and cook, uncovered, until all the apple flesh is dissolved, 5 to 6 hours. Stir occasionally."
    },
    {
      "position": 3,
      "text": "Puree using an immersion blender until smooth. Continue cooking, stirring occasionally, until darkened and thick, about 4 hours more. Pass apple butter through a strainer if desired. Seal in a glass container and refrigerate until cool."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 600,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

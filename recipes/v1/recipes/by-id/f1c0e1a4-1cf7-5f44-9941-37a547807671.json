  "id": "f1c0e1a4-1cf7-5f44-9941-37a547807671",
  "slug": "rhubarb-cobbler",
  "name": "Rhubarb Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb cobbler has a delicious rhubarb filling and buttery biscuit dough topping. Bake until hot and bubbling for a gorgeous springtime dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9-inch square baking dish."
    },
    {
      "position": 2,
      "text": "To make the filling: Mix sugar and cornstarch together in a large saucepan. Stir in rhubarb and water. Bring to a boil; cook and stir for 1 minute. Transfer to the prepared baking dish. Dot with butter and sprinkle with cinnamon."
    },
    {
      "position": 3,
      "text": "To make the topping: Sift together flour, 1 tablespoon sugar, baking powder, and salt in a medium bowl. Cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Beat together milk and egg in a small bowl; add to flour mixture all at once and stir until just moistened."
    },
    {
      "position": 4,
      "text": "Drop spoonfuls of topping over rhubarb filling. Sprinkle with remaining 2 tablespoons sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven rhubarb is bubbling and topping is crisp and lightly browned, about 20 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

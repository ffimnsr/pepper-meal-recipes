  "id": "c22c2e71-7433-5586-90ed-13dce3b299d3",
  "slug": "ranger-cookie-bars-recipe-11851514",
  "name": "Ranger Cookie Bars",
  "recipe_type": "dessert",
  "brief_description": "These ranger cookie bars have a bit of everything\u2014chocolate, corn flakes, coconut, pecans, oats\u2014you name it! These flavors all come together in an easy-to-make, and deliciously chewy, treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line an 8x8-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Beat butter, brown sugar, white sugar, salt, and nutmeg together in a large bowl until light and fluffy in a large bowl. Add egg and vanilla and beat until thoroughly incorporated. Add flour and baking soda and mix until just combined. Stir in corn flakes, chocolate chips, coconut, oats, and pecans. Dough will be somewhat thick."
    },
    {
      "position": 3,
      "text": "Pour dough into the prepared pan. Use slightly damp hands to press dough evenly into the pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bars are puffy and golden, 25 to 30 minutes. Allow bars to cool in the pan for 15 minutes before removing to a wire rack to cool completely. Cut into 12 bars."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

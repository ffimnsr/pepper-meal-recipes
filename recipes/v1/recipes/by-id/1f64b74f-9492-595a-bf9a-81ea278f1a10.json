  "id": "1f64b74f-9492-595a-bf9a-81ea278f1a10",
  "slug": "whole-wheat-wraps",
  "name": "Whole Wheat Wraps",
  "recipe_type": "main",
  "brief_description": "These are great! Make your favorite Mexican dish, or alternate sandwiches or even cut these in wedges and fry for whole wheat tortilla chips! You may omit the baking powder if you wish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, stir together flour, salt and baking powder. Pour in water; stir to combine. Mix in additional water in 1 tablespoon increments, until a soft pliable dough is formed."
    },
    {
      "position": 2,
      "text": "Knead briefly on a lightly floured surface. Divide dough into 16 equal pieces. Cover and let rest for 20 minutes."
    },
    {
      "position": 3,
      "text": "Flour each ball well, place between two pieces of wax paper and roll out to desired size and thickness."
    },
    {
      "position": 4,
      "text": "Heat an ungreased skillet or frying pan over medium-high heat. Peel away wax paper and grill rounds until brown flecks appear underneath. Turn and cook other side. Serve warm or cool and store in an airtight container in the refrigerator or freezer."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

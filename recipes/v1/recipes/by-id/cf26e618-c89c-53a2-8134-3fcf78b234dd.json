  "id": "cf26e618-c89c-53a2-8134-3fcf78b234dd",
  "slug": "healthier-beef-stroganoff-iii",
  "name": "Healthier Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "This healthier beef stroganoff features reduced-sodium stock, light sour cream, and less butter. Serve it with whole wheat egg noodles for a new classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Remove fat and gristle from roast; cut into strips 1/2-inch thick by 2-inches long. Season with 1/2 teaspoon salt and 1/2 teaspoon black pepper; set aside."
    },
    {
      "position": 2,
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat. Add mushrooms and green onions; cook, stirring occasionally, until mushrooms are browned, about 6 minutes. Transfer to a bowl. Add 1 tablespoon butter to the same skillet. Add 1/2 beef strips; cook and stir until browned, about 5 minutes. Transfer to a separate bowl. Repeat with remaining 1 tablespoon butter and remaining 1/2 beef strips. Pour wine into the hot skillet; scrape the browned bits of food off the bottom of the skillet with a wooden spoon."
    },
    {
      "position": 3,
      "text": "Combine 1/4 cup beef broth and flour in a jar with a tight fitting lid; shake until combined. Stir into the skillet, whisking until smooth; stir in remaining broth and mustard, then return beef strips to the skillet. Bring to a simmer; cover and simmer until beef strips are tender, about 1 hour."
    },
    {
      "position": 4,
      "text": "Stir in mushroom mixture and sour cream until heated through, 5 minutes before serving; season with salt and black pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "hard",

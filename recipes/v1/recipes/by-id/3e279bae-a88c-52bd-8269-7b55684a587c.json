  "id": "3e279bae-a88c-52bd-8269-7b55684a587c",
  "slug": "summer-meat-slaw-recipe-8666307",
  "name": "Summer Meat Slaw",
  "recipe_type": "salad",
  "brief_description": "This summer meat slaw, with pulled pork, crisp carrots, and red bell peppers, and lightly saut\u00e9ed cabbage, is unlike any coleslaw you've ever had.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Halve and core cabbage; cut each half into 2 pieces, and slice cabbage into 1/4-inch thick strips; set aside."
    },
    {
      "position": 2,
      "text": "Add green onions, bell pepper, and garlic to a large mixing bowl. With a vegetable peeler, peel thin strips of carrot over the top."
    },
    {
      "position": 3,
      "text": "Place a nonstick skillet over high heat and add pork. Cook until pork is very hot and a brown crust is forming on the meat, about 5 minutes. If meat is lean, 1 to 2 tablespoons of oil can be added to the pan as needed. Pour hot pork over veggies and mix with tongs to combine."
    },
    {
      "position": 4,
      "text": "Add 2 tablespoons oil to the same pan and place over high heat. Transfer in cabbage and salt. Cook, stirring, until cabbage softens and starts to brown in spots, but still retains a bit of crunch."
    },
    {
      "position": 5,
      "text": "Add cabbage, black pepper, Sriracha, and rice vinegar to the bowl; mix slaw thoroughly. Add cilantro, and mix thoroughly. Taste for seasoning, and adjust salt and pepper, heat, and vinegar as needed."
    },
    {
      "position": 6,
      "text": "Serve hot, warm, or at room temperature, garnished with thinly sliced green onion. If making ahead, warm slaw before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

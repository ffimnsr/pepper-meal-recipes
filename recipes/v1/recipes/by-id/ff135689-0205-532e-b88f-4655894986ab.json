  "id": "ff135689-0205-532e-b88f-4655894986ab",
  "slug": "caprese-garlic-bread-recipe-8705713",
  "name": "Caprese Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "This caprese garlic bread is crusty garlic bread, but with tomatoes, mozzarella, basil, and a drizzle of balsamic. The flavor is sensational. French, Italian and ciabatta are all good bread choices.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and line a baking sheet with parchment paper. Cut bread in half lengthwise, lightly spray with olive oil, and place on the baking sheet, cut side up."
    },
    {
      "position": 2,
      "text": "In a small bowl, combine butter and garlic; spread evenly on the bread halves, and top with mozzarella slices."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cheese is melted, and bread edges are starting to brown, 8 to 11 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven, place tomato slices on top of the cheese, season with salt and pepper, and sprinkle with basil. Drizzle with balsamic glaze, cut into slices, and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "0a64476d-1e21-501b-977f-1b2eda98c821",
  "slug": "southern-pecan-pie-i",
  "name": "Southern Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This Southern pecan pie recipe combines sugar, dark corn syrup, and lots of pecans in a buttery crust for a sticky and sweet Southern dessert treat.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat eggs slightly in a medium bowl. Whisk in sugar, then stir in corn syrup, butter, vanilla, salt, and pecans."
    },
    {
      "position": 3,
      "text": "Pour filling into unbaked pie shell."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Reduce temperature to 350 degrees F (175 degrees C) and continue baking until the pie is golden brown and slightly puffed on top, 35 to 40 minutes. The filling should be set around the edges and slightly jiggly in the center."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

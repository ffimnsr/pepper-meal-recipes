  "id": "197ed0b0-8a69-5e17-94fc-46b1fd9939b7",
  "slug": "instant-pot-old-fashioned-rice-pudding",
  "name": "Instant Pot\u00ae Old-Fashioned Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Combine old-fashioned taste with modern technology by preparing this easy and delicious rice pudding in an Instant Pot\u00ae.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Stir in milk and sugar. Warm the mixture, stirring continuously, until sugar dissolves, 3 to 4 minutes. Turn Instant Pot\u00ae off. Add rice. Close and lock the lid."
    },
    {
      "position": 2,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, at least 10 minutes."
    },
    {
      "position": 4,
      "text": "Beat eggs in a bowl. Remove lid of the Instant Pot\u00ae. Scoop 1 cup of pudding mixture out of the pot; add to the beaten eggs and whisk until completely blended. Pour back into the Instant Pot\u00ae and add raisins, vanilla extract, and cinnamon."
    },
    {
      "position": 5,
      "text": "Select Saute function. Cook until mixture thickens, about 3 minutes. Serve warm or chilled."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "89ddcb1d-f558-5f7f-a7f1-bc41a36489ba",
  "slug": "satiny-chocolate-glaze",
  "name": "Satiny Chocolate Glaze",
  "recipe_type": "dessert",
  "brief_description": "Glossy chocolate drizzle for Bundt cake, cookies, and donuts that's easy to make with 4 ingredients: chocolate chips, butter, corn syrup, and vanilla.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chocolate chips, butter, and corn syrup in a double boiler over hot, but not boiling water."
    },
    {
      "position": 3,
      "text": "Gently stir until chocolate is melted and mixture is smooth, then add vanilla."
    },
    {
      "position": 4,
      "text": "To use, spread warm glaze over top of your cooled cake, letting it drizzle down the sides."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

  "id": "b97b0b05-d367-56cd-913f-e0ac9595f3fc",
  "slug": "spinach-con-queso",
  "name": "Spinach Con Queso",
  "recipe_type": "appetizer",
  "brief_description": "Spinach queso dip, a spinach and cheese dip, is a creamy and simple appetizer to make for guests and potlucks. Simply delicious.",
  "cuisine": "U.S. Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil and butter together in a 3-quart saucepan over medium heat; cook and stir onion until translucent, about 10 minutes. Add garlic and cook until fragrant, about 1 minute. Stir red bell pepper and jalape\u00f1o pepper into onion mixture; cook until softened, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to low and mix pepperjack cheese and spinach into onion mixture; cook, stirring constantly, until cheese is melted and mixture is thick, 5 to 10 minutes. Slowly pour enough evaporated milk into the cheese mixture, stirring constantly, until desired consistency is reached; season with salt. Continue to cook and stir over low heat until warmed through, at least 5 minutes more."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

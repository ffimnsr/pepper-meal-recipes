  "id": "e7b9bf54-0cc5-563a-8f2d-a3445fab8810",
  "slug": "breakfast-rice-from-japan",
  "name": "Breakfast Rice from Japan",
  "recipe_type": "breakfast",
  "brief_description": "This breakfast rice recipe combines leftover white or brown rice with scrambled egg and soy sauce for a deliciously crispy and filling breakfast.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Spread rice in a flat layer in hot oil; cook until crispy on the bottom, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Stir egg into rice until scrambled, about 2 minutes more. Sprinkle green onions on top and season with soy sauce."
    }
  ],

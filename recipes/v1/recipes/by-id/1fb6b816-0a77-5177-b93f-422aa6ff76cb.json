  "id": "1fb6b816-0a77-5177-b93f-422aa6ff76cb",
  "slug": "ground-beef-stroganoff-noodles",
  "name": "Ground Beef Stroganoff Noodles",
  "recipe_type": "main",
  "brief_description": "Here's Chef John's shortcut version of the classic comfort food: a one-pan meal featuring flavorful ground beef, mushrooms, and noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter and oil in a skillet over medium-high heat. Add mushrooms, season with salt, and saute, stirring occasionally, until they turn golden brown, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Add onion and ground beef. Cook, stirring, until meat is browned and crumbly, and onions turn soft and translucent, about 5 minutes. Season with black pepper and cayenne."
    },
    {
      "position": 4,
      "text": "Stir in minced garlic and flour, and cook for 1 minute."
    },
    {
      "position": 5,
      "text": "Pour in vodka and allow to evaporate, about 30 seconds."
    },
    {
      "position": 6,
      "text": "Stir in beef broth and water and bring to a simmer. Cook, stirring occasionally, for 10 minutes."
    },
    {
      "position": 7,
      "text": "Reduce heat to medium, and mix in noodles. Cover with a tight-fitting lid and simmer for 5 minutes. Uncover and stir thoroughly. Cover again and cook until noodles are just tender, about 3 minutes. (See Chef's Note.)"
    },
    {
      "position": 8,
      "text": "Once noodles are cooked, reduce heat to low, and stir in sour cream."
    },
    {
      "position": 9,
      "text": "Serve immediately with additional sour cream and green onions or chives if so desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

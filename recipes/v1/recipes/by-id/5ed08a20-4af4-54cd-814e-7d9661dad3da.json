  "id": "5ed08a20-4af4-54cd-814e-7d9661dad3da",
  "slug": "quick-almond-flour-pancakes",
  "name": "Quick Almond Flour Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These almond flour pancakes are naturally gluten-free and a delicious and filling way to start your day. Serve with your favorite pancake toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk almond flour, water, eggs, maple syrup, and salt together in a large bowl until smooth."
    },
    {
      "position": 3,
      "text": "Heat oil on a griddle over medium heat. Drop batter by large spoonfuls onto the griddle."
    },
    {
      "position": 4,
      "text": "Cook until bubbles form and edges are dry, 3 to 5 minutes. Flip and cook until bottoms are browned, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Repeat with remaining batter. Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

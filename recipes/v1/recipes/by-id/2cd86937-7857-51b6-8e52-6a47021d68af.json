  "id": "2cd86937-7857-51b6-8e52-6a47021d68af",
  "slug": "chef-johns-russian-tea-cakes",
  "name": "Chef John\u2019s Russian Tea Cakes",
  "recipe_type": "appetizer",
  "brief_description": "These Russian tea cakes are Chef John\u2019s version of tender, nutty cookies made with flour, butter, and walnuts, twice-coated in confectioners\u2019 sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Arrange a rack in the center position of the oven. Line a rimmed baking sheet with a silicone mat."
    },
    {
      "position": 2,
      "text": "Place butter, walnuts, 1/3 cup packed powdered sugar, vanilla, and salt in a large bowl. Top with 2 cups plus 2 tablespoons flour. Mix with clean hands until dough starts to clump up. Keep mixing by hand until all flour and clumps of butter are evenly mixed into dough."
    },
    {
      "position": 3,
      "text": "Scoop out dough and roll by hand into uniformly round balls, just slightly larger than 1 inch. Place about 2 inches apart on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly golden, 15 to 25 minutes depending on the size of cookies."
    },
    {
      "position": 5,
      "text": "Let cool for exactly 5 minutes, then roll warm cookies in 1 cup confectioners\u2019 sugar in a medium bowl. Let cookies cool completely, then toss them again in confectioners\u2019 sugar."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

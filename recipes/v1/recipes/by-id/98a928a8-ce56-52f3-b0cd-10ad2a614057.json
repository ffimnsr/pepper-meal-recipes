  "slug": "copycat-chicken-noodle-o-soup",
  "name": "Copycat Chicken Noodle-O Soup",
  "recipe_type": "soup",
  "brief_description": "Lemon juice is the secret ingredient that really brings out the tang in this copycat version of Campbell's\u00ae Chicken NoodleO's\u00ae soup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring broth, water, carrots, soup base, marjoram, thyme, and onion powder to a boil in a large pot. Reduce heat and simmer for 15 minutes."
    },
    {
      "position": 2,
      "text": "Add pasta and return to a boil. Boil for 15 minutes. Turn heat off and stir in chicken and lemon juice."
    }
  ],
  "servings": 4,

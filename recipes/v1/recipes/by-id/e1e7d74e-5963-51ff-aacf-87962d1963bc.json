  "id": "e1e7d74e-5963-51ff-aacf-87962d1963bc",
  "slug": "chef-johns-pavlova-with-strawberries",
  "name": "Chef John's Pavlova with Strawberries",
  "recipe_type": "dessert",
  "brief_description": "This recipe for Pavlova produces a light-tasting meringue dessert that's sweet, gooey, and crunchy. It tastes great with whipped cream and strawberries.",
  "cuisine": "New Zealand Australian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a baking sheet with a silicone baking mat or parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk sugar and cornstarch together in a bowl. Beat egg whites in a second bowl until foamy with a thick, ribbony texture, 2 to 3 minutes. Whisk in 1/4 of the sugar mixture until completely incorporated, about 30 seconds. Repeat with the remaining sugar mixture, whisking after each addition, until all is incorporated and egg whites are glossy and thick."
    },
    {
      "position": 3,
      "text": "Add 1 teaspoon vanilla and vinegar; whisk until you can lift the beater or whisk straight up and egg whites form a sharp peak that holds its shape, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Spoon egg white mixture onto the prepared baking sheet; spread out into a 2x6-inch disk."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour. Turn off the oven, crack open the oven door, and let the Pavlova cool for 1 hour."
    },
    {
      "position": 6,
      "text": "Transfer cooled Pavlova to a serving plate."
    },
    {
      "position": 7,
      "text": "Whip cream, sugar, and remaining 1 teaspoon vanilla in a bowl until soft peaks form, 3 to 4 minutes. Spread over Pavlova and top with fresh strawberries."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,

  "slug": "peanut-butter-chicken-meatballs-recipe-7553256",
  "name": "Peanut Butter Chicken Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These Thai-inspired chicken meatballs are a quick appetizer made with creamy peanut butter, sweet Thai chili sauce, and fresh ginger.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix ground chicken, egg, bread crumbs, peanut butter, sweet Thai chili sauce, and ginger together in a large bowl."
    },
    {
      "position": 3,
      "text": "Form the mixture into 1 1/2-inch balls and arrange on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until browned and no longer pink in the center, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

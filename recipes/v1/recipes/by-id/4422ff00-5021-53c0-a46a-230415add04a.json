{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4422ff00-5021-53c0-a46a-230415add04a",
  "slug": "strawberry-rhubarb-meringue-dessert",
  "name": "Strawberry Rhubarb Meringue Dessert",
  "recipe_type": "dessert",
  "brief_description": "Strawberry rhubarb meringue dessert is an almost-pie with a crumb crust, rich creamy strawberry-rhubarb filling, and golden brown meringue topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Whisk 2 cups flour and 2 tablespoons sugar together in a bowl. Cut in cold butter with a pastry blender or 2 knives until the mixture resembles coarse crumbs. Press crust into the bottom and up sides of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Combine 2 cups sugar, cream, egg yolks, 1/3 cup flour, and salt in a large bowl until well combined; stir in rhubarb and strawberries. Pour filling into the baked crust."
    },
    {
      "position": 5,
      "text": "Bake in the heated oven until filling is set, 50 to 60 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, beat egg whites and cream of tartar in a large glass, metal, or ceramic bowl with an electric mixer on medium-high speed until soft peaks form; gradually beat in 3/4 cup sugar until glossy and stiff peaks form. Beat in vanilla extract. Remove dessert from oven; top with meringue, swirling and lifting spatula to make decorative peaks and swirls."
    },
    {
      "position": 7,
      "text": "Bake in the heated oven until meringue is pale golden brown, about 15 minutes more. Cool to room temperature, then chill to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

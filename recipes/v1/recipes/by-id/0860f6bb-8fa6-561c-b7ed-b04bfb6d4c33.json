  "id": "0860f6bb-8fa6-561c-b7ed-b04bfb6d4c33",
  "slug": "easy-macaroni-tuna-casserole",
  "name": "Easy Macaroni Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "This tasty tuna-macaroni casserole is easy to prepare. It's topped with buttery bread crumbs for a surefire hit with family and friends!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until cooked through but firm to the bite, 8 minutes. Drain and return macaroni to the pot."
    },
    {
      "position": 3,
      "text": "Stir in 1/4 cup butter, 1/4 cup milk, and the envelope of powdered cheese from the package. Add mushroom soup, tuna, and 1/2 cup milk; stir to combine. Pour macaroni mixture into the prepared baking dish; top with Cheddar cheese and parsley."
    },
    {
      "position": 4,
      "text": "Mix bread crumbs, 1/4 cup melted butter, and dill in a small bowl; sprinkle over Cheddar cheese layer."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and the top is golden brown, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "b-and-ls-strawberry-smoothie",
  "name": "B and L's Strawberry Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This strawberry smoothie recipe blends fresh strawberries, milk, yogurt, sugar, and vanilla for a tasty, icy treat. Great for breakfast, or anytime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine strawberries, milk, yogurt, sugar, and vanilla in a blender. Add ice and blend until smooth and creamy."
    },
    {
      "position": 3,
      "text": "Pour into glasses and serve immediately. Enjoy!"
    }
  ],
  "servings": 2,

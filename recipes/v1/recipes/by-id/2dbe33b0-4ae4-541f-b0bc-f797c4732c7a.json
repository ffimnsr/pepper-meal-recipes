  "id": "2dbe33b0-4ae4-541f-b0bc-f797c4732c7a",
  "slug": "five-spiced-grilled-cheese-sandwiches-recipe-11998226",
  "name": "Five-Spiced Grilled Cheese Sandwiches",
  "recipe_type": "side",
  "brief_description": "A five-spice seasoned mayonnaise is spread on the outsides of sandwich bread to create an ultra-crispy grilled cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together mayonnaise and five-spice powder in a small bowl; spread onto 1 side of each of the whole-grain bread slices."
    },
    {
      "position": 2,
      "text": "Onto uncoated sides of each of 4 bread slices, layer 1 slice white cheddar cheese, 1 slice Gouda cheese, and 4 thin slices apple. Spread about 1 1/2 teaspoons apricot jam over each of the apple layers. Top with the remaining bread slices, mayonnaise sides up."
    },
    {
      "position": 3,
      "text": "Heat a very large skillet over medium heat. Arrange sandwiches in the skillet. Cook, turning halfway through, until golden and cheese is melted, 3 to 4 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

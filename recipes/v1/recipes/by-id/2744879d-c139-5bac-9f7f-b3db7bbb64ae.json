  "id": "2744879d-c139-5bac-9f7f-b3db7bbb64ae",
  "slug": "chantilly-potatoes",
  "name": "Chantilly Potatoes",
  "recipe_type": "side",
  "brief_description": "Turn leftover mashed potatoes into a flavorful chantilly potato side dish by adding a creamy cheese mixture and baking them to golden perfection.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a shallow 1 1/2-quart baking dish."
    },
    {
      "position": 2,
      "text": "Spread mashed potatoes in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Whip heavy cream in a bowl until stiff; fold in Swiss cheese and add salt and pepper to taste. Spread over the potatoes."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is delicately brown, 25 to 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

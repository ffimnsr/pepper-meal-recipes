  "id": "46b96afc-050c-5ac3-bea2-ecfd811a101d",
  "slug": "aunt-teens-creamy-chocolate-fudge",
  "name": "Aunt Teen's Creamy Chocolate Fudge",
  "recipe_type": "dessert",
  "brief_description": "The best fudge recipes are those that have been passed down through the family! Add your favorite nuts to this chocolate fudge for a delicious treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Line an 8-inch square pan with aluminum foil; set aside."
    },
    {
      "position": 2,
      "text": "Combine sugar, marshmallow cream, evaporated milk, butter, and salt together in a large saucepan over medium heat; bring to a full boil and cook for 5 minutes, stirring constantly."
    },
    {
      "position": 3,
      "text": "Remove from heat and add milk chocolate chips and semisweet chocolate chips; stir until chocolate is melted and mixture is smooth. Stir in nuts and vanilla."
    },
    {
      "position": 4,
      "text": "Pour into prepared pan; chill in refrigerator for 2 hours, or until firm."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

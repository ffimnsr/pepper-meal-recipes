  "id": "6066adf8-a1f9-54a1-baaa-0c324b9ee8fa",
  "slug": "grilled-teriyaki-tuna",
  "name": "Grilled Teriyaki Tuna",
  "recipe_type": "main",
  "brief_description": "Yellowfin tuna marinated in teriyaki sauce and garlic, then grilled to perfection. This is great at a tailgate party, or at your Saturday afternoon summer barbecue.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "In a large resealable plastic bag, combine the teriyaki sauce, oil, garlic, and pepper. Place the tuna fillets in the bag. Seal the bag with as little air in it as possible. Give the mix a good shake, to ensure the tuna fillets are well coated. Marinate for 30 minutes in the refrigerator."
    },
    {
      "position": 2,
      "text": "Meanwhile, preheat an outdoor grill for high heat, and lightly oil grate."
    },
    {
      "position": 3,
      "text": "Remove tuna from marinade, and place on grill. For rare tuna, grill for 3 to 5 minutes on each side. For medium, grill 5 to 8 minutes per side. For well done, grill for 8 to 10 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

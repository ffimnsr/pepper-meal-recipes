  "id": "00e0ac33-3aa1-5d82-a740-6f445a3e44e1",
  "slug": "clam-stuffed-portobello-mushrooms",
  "name": "Clam-Stuffed Portobello Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "This is a restaurant-worthy appetizer for portobello mushrooms stuffed with clams, parsley, breadcrumbs, and Parmesan cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 9x13-inch pan with 2 tablespoons olive oil."
    },
    {
      "position": 2,
      "text": "Use a dry vegetable brush or paper towel to lightly scrub mushrooms to remove any dirt. Separate stems from mushroom caps. Use a small spoon to carefully scoop out the dark mushroom gills to make more room for the stuffing; discard gills. Chop mushroom stems finely and set aside."
    },
    {
      "position": 3,
      "text": "Place remaining 2 tablespoons olive oil in a skillet and heat over medium heat for a few minutes. Add garlic and mushroom stems and cook, stirring constantly, for 4 to 5 minutes. Turn off heat. Add clams, panko, Parmesan cheese, Italian seasoning, parsley, salt, and pepper and mix to combine."
    },
    {
      "position": 4,
      "text": "Fill mushroom caps with the mixture and place in the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until sizzling, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

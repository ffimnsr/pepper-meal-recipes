  "id": "2e252bf3-3caa-538a-875d-66007ba12213",
  "slug": "no-bake-tiramisu-cheesecake",
  "name": "No-Bake Tiramisu Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "Butter and chocolate graham crackers make a crust for this otherwise 'no-bake' tiramisu-style cheesecake.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a 9x13-inch pan with aluminum foil, making sure to cover the sides and leaving several inches of aluminum foil on each end."
    },
    {
      "position": 2,
      "text": "Mix graham crackers and butter in a bowl until crackers are moist; pat down into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until firm, about 12 minutes. Set aside to cool."
    },
    {
      "position": 4,
      "text": "Beat cream cheese in a bowl with an electric mixer until fluffy. Add sweetened condensed milk; continue beating until incorporated. Blend sour cream and lemon juice into the cream cheese mixture. Chill in refrigerator for 20 minutes."
    },
    {
      "position": 5,
      "text": "Dip each vanilla wafer cookie in the brewed coffee for a few seconds and arrange in a layer onto the cooled crust with about 1/2 inch between each cookie. Spread about 1/3 of the cream cheese mixture over the cookies. Repeat layering of cookies and cream cheese mixture twice more."
    },
    {
      "position": 6,
      "text": "Refrigerate until center is set, 2 1/2 to 3 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

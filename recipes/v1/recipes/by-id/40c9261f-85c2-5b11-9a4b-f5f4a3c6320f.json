  "id": "40c9261f-85c2-5b11-9a4b-f5f4a3c6320f",
  "slug": "chocolate-chip-cookies-from-in-the-raw-sweeteners",
  "name": "Chocolate Chip Cookies from In The Raw Sweeteners",
  "recipe_type": "dessert",
  "brief_description": "Stevia In The Raw is the perfect sugar alternative when you crave a lower-calorie, lower-sugar chocolate chip cookie without sacrificing flavor!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Beat together melted butter, egg, vanilla extract, and Stevia Extract In The Raw\u2122 in a large bowl. Set aside."
    },
    {
      "position": 2,
      "text": "Mix flour, baking soda, and salt in a separate bowl. Add dry ingredients to wet ingredients and stir well to combine. Slowly fold in chocolate chips and nuts until well combined."
    },
    {
      "position": 3,
      "text": "Drop dough by spoonfuls onto a large, ungreased baking sheet. Bake until done, about 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,

  "id": "34d5017f-86e8-5d4b-9b2f-3f2d420d5625",
  "slug": "delicious-grilled-hamburgers",
  "name": "Delicious Grilled Hamburgers",
  "recipe_type": "main",
  "brief_description": "These meaty grilled burgers made with lean ground beef and seasoned with garlic and Worcestershire sauce are juicy, smoky, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Combine ground beef, Worcestershire sauce, liquid smoke, and garlic powder in a medium bowl; lightly mix until just combined."
    },
    {
      "position": 4,
      "text": "With minimal handling, form mixture into three patties."
    },
    {
      "position": 5,
      "text": "Brush oil onto both sides of each patty, then season with salt."
    },
    {
      "position": 6,
      "text": "Cook patties on the preheated grill until no longer pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

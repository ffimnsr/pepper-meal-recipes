  "id": "69dfd413-2f84-54a2-81c6-988952a89eb2",
  "slug": "bison-and-brown-rice-stuffed-peppers",
  "name": "Bison and Brown Rice Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "In this recipe, green bell peppers are stuffed with bison and brown rice in an Italian-seasoned tomato sauce for a twist on the usual stuffed peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat; add bison. Cook and stir until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 4,
      "text": "Arrange bell peppers, cut-sides up, in a baking dish. Slice bottoms of peppers if needed so they stand upright."
    },
    {
      "position": 5,
      "text": "Combine rice, bison, tomato sauce, Worcestershire sauce, oregano, all-purpose seasoning, garlic powder, onion powder, salt, and black pepper in a bowl; spoon into each bell pepper."
    },
    {
      "position": 6,
      "text": "Combine diced tomatoes and Italian seasoning in a bowl; pour over stuffed peppers."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until peppers are tender, about 1 hour, basting with diced tomato mixture every 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

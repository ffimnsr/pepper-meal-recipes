  "id": "1fc5dee6-b2c5-5446-81ea-ef0eac53aafa",
  "slug": "sheet-pan-chicken-gyros-recipe-11940546",
  "name": "Sheet Pan Chicken Gyros",
  "recipe_type": "main",
  "brief_description": "This sheet pan chicken gyros is pre-portioned, a quick lunch or summery dinner of spiced ground chicken, baked then broiled on a sheet pan. Serve on pita, and offer a selection of typical gyros toppings, like chopped Roma tomatoes, thinly sliced red onion, tzatziki sauce, crumbled feta, sliced cucumbers, and shredded lettuce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 10x15-inch rimmed baking sheet with nonstick cooking spray. Move top oven rack to 6 inches below heat."
    },
    {
      "position": 2,
      "text": "Combine ground chicken, breadcrumbs, olive oil, egg, lemon zest, lemon juice, garlic, oregano, thyme, cumin, smoked paprika, salt, and black pepper in a large bowl. Mix until well combined."
    },
    {
      "position": 3,
      "text": "Spread the chicken mixture evenly on the prepared baking sheet. Score the surface with a knife to create 12 rectangular portions, being careful not to cut all the way through."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 8 minutes. Switch oven to broiler and broil until the chicken is browned on top and cooked through, and an instant-read thermometer inserted into the center registers 165 degrees F (74 degrees C), 6 minutes."
    },
    {
      "position": 5,
      "text": "Serve warm with pita bread and desired toppings. Recipe develped by Jaelyn Luong"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

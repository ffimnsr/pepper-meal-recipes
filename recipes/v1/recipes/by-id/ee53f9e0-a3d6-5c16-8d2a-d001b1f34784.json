  "id": "ee53f9e0-a3d6-5c16-8d2a-d001b1f34784",
  "slug": "mediterranean-smashed-sweet-potatoes-recipe-11880921",
  "name": "Mediterranean Smashed Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "These Mediterranean smashed sweet potatoes are coated in a savory garlic butter with Greek herbs and Parmesan, delivering rich, comforting flavor in every bite. A drizzle of balsamic glaze adds a sweet-tangy contrast that makes this side dish irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Wash and dry sweet potatoes. Prick each potato 4 to 6 times with a fork. Microwave on a plate until just tender, flipping halfway through, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper. Cut sweet potatoes into 1-inch-thick slices. Place sliced sweet potatoes on the prepared sheet and gently smash each to about 1/2-inch-thick using a glass."
    },
    {
      "position": 3,
      "text": "In a small skillet, melt butter over medium heat. Add garlic and saut\u00e9 until fragrant, 30 to 60 seconds. Stir in Greek seasoning, salt, and pepper. Remove from heat."
    },
    {
      "position": 4,
      "text": "Brush or spoon the garlic butter over each smashed potato. Drizzle with olive oil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are golden and slightly crisp, 20 to 25 minutes. Remove potatoes from the oven."
    },
    {
      "position": 6,
      "text": "Sprinkle with Parmesan and thyme. Drizzle with balsamic glaze just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

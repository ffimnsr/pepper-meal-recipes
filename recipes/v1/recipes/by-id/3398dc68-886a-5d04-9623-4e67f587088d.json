  "id": "3398dc68-886a-5d04-9623-4e67f587088d",
  "slug": "orange-walnut-gorgonzola-and-mixed-greens-salad-with-fresh-citrus-vinaigrette",
  "name": "Orange, Walnut, Gorgonzola and Mixed Greens Salad with Fresh Citrus Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This summery salad is made with salad greens, fresh oranges, red onions, glazed walnuts, and Gorgonzola cheese, then topped with a homemade citrus vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the walnuts in a skillet over medium heat. Cook 5 minutes, stirring constantly, until lightly browned."
    },
    {
      "position": 2,
      "text": "In a large bowl, toss the toasted walnuts, salad greens, oranges, and red onion."
    },
    {
      "position": 3,
      "text": "In a large jar with a lid, mix the olive oil, vegetable oil, orange juice, sugar, vinegar, mustard, oregano, and pepper. Seal jar, and shake to mix."
    },
    {
      "position": 4,
      "text": "Divide the salad greens mixture into individual servings. To serve, sprinkle with Gorgonzola cheese, and drizzle with the dressing mixture."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

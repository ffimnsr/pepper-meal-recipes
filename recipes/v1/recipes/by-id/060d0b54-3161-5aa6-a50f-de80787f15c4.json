  "id": "060d0b54-3161-5aa6-a50f-de80787f15c4",
  "slug": "okra-gumbo",
  "name": "Okra Gumbo",
  "recipe_type": "soup",
  "brief_description": "Vegetarians rejoice! This thick, rich gumbo contains no meat or seafood, but is full of great flavor.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon oil in a large saucepan over medium heat. Stir in garlic, onion, and green bell pepper, and saute until tender. Stir in okra, mushrooms, diced tomatoes and their liquid, tomato paste, file powder, bay leaves, salt, and pepper. Cook, stirring occasionally, 40 minutes."
    },
    {
      "position": 2,
      "text": "Heat 2 tablespoons oil in a medium skillet over medium heat. Stirring constantly, add flour, and cook 2 to 5 minutes, until a golden brown roux has formed."
    },
    {
      "position": 3,
      "text": "Spoon the roux into the okra mixture, and continue to cook, stirring occasionally, 5 to 10 minutes, until thickened."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "9a2adcbb-3b0d-5979-bbb8-2b90987e69e9",
  "slug": "easy-sausage-and-shrimp-gumbo",
  "name": "Easy Sausage and Shrimp Gumbo",
  "recipe_type": "soup",
  "brief_description": "Sausage and shrimp gumbo is a nice twist on the classic Cajun stew traditionally served over rice and is perfect for cold evening meals.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir oil and flour in a skillet over medium heat until mixture is thick and the color of peanut butter, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir onion, green bell pepper, and celery into flour mixture; cook and stir until softened, about 5 minutes. Add sausage; cook and stir until browned, about 5 minutes. Add Cajun seasoning, garlic, and black pepper; cook and stir until fragrant, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour chicken stock over vegetable-sausage mixture; reduce heat to low and simmer for 30 minutes. Add shrimp and cook until shrimp are pink and cooked through, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 72,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "0a4f83f1-2277-5a76-a2d5-2d5466734c9f",
  "slug": "fresh-homemade-salsa",
  "name": "Fresh Homemade Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This salsa recipe is quickly made in a food processor with fresh tomatoes, onions, canned green chiles, cilantro, and garlic for a simple dip.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, red onion, yellow onion, green chiles, lime juice, cilantro, garlic, cumin, and salt in the bowl of a food processor."
    },
    {
      "position": 3,
      "text": "Pulse until mixture is combined but still chunky."
    },
    {
      "position": 4,
      "text": "Transfer salsa to a bowl, cover with plastic wrap, and refrigerate at least 1 hour before serving."
    },
    {
      "position": 5,
      "text": "Serve with chips."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

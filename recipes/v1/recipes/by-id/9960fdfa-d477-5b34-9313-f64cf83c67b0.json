  "id": "9960fdfa-d477-5b34-9313-f64cf83c67b0",
  "slug": "see-mas-butternut-squash-and-cauliflower-soup",
  "name": "See Ma's Butternut Squash and Cauliflower Soup",
  "recipe_type": "soup",
  "brief_description": "Apple and garam masala add upgraded layers of flavor to this fall-inspired butternut squash and cauliflower soup, making it a delicious option for Thanksgiving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan over medium heat. Saute onion and garlic in the hot oil until golden, 12 to 15 minutes. Add squash, cauliflower, and apple; stir together. Pour in vegetable stock, garam masala, and red pepper flakes. Bring to a boil, reduce heat to low, and let simmer until vegetables are soft, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Puree mixture using an immersion blender or food mill until soup is creamy. Season with salt and pepper. Swirl in sour cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,

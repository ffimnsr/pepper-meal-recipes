  "id": "8f9152ce-89be-5a6c-8e47-34464c9e764f",
  "slug": "how-to-make-gravy-from-scratch-recipe-7497364",
  "name": "How to Make Gravy from Scratch",
  "recipe_type": "side",
  "brief_description": "This gravy recipe is quick and easy to make from scratch with pan drippings and stock for delicious depth of flavor and a great addition to any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour pan drippings into a large measuring cup. Scrape the browned bits into a 2 cup measure."
    },
    {
      "position": 3,
      "text": "Skim and reserve fat from drippings."
    },
    {
      "position": 4,
      "text": "Pour \u00bc cup fat into a medium saucepan. (If you don\u2019t have \u00bc cup fat, add enough butter to equal \u00bc cup). Set over medium heat."
    },
    {
      "position": 5,
      "text": "Whisk in flour; cook for 1 to 2 minutes, whisking constantly."
    },
    {
      "position": 6,
      "text": "Add stock or broth to the remaining drippings in the measuring cup to equal 2 cups."
    },
    {
      "position": 7,
      "text": "Slowly whisk in stock mixture until fully incorporated."
    },
    {
      "position": 8,
      "text": "Cook, stirring frequently, over medium heat until thickened and bubbly; cook and stir 1 minute more. Season with salt and black pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

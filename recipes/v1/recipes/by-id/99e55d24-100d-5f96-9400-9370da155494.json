  "id": "99e55d24-100d-5f96-9400-9370da155494",
  "slug": "artichoke-dip-with-fresh-spinach",
  "name": "Artichoke Dip with Fresh Spinach",
  "recipe_type": "appetizer",
  "brief_description": "Lots of fresh herbs add flavor to this Alfredo-based artichoke dip made with fresh spinach and Italian cheeses.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine onions, shallots, parsley, chives, sage, garlic, ginger, and rosemary leaves in the bowl of a food processor; pulse until blended. Pour olive oil in slowly, with the processor running, until pureed."
    },
    {
      "position": 3,
      "text": "Transfer pureed mixture to a large bowl. Add Alfredo sauce and whisk until fully combined, about 3 minutes. Whisk in cream cheese until smooth with no lumps. Stir in Italian cheese. Add spinach and artichokes and mix until all ingredients are evenly incorporated. Transfer to a baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly, about 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

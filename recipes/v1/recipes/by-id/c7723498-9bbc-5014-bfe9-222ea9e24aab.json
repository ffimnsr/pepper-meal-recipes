  "id": "c7723498-9bbc-5014-bfe9-222ea9e24aab",
  "slug": "marinated-pretzels",
  "name": "Marinated Pretzels",
  "recipe_type": "appetizer",
  "brief_description": "These seasoned pretzels get their flavor from a savory marinade made with tangy ranch-style dressing, garlic, and dill. Perfect for parties!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Break the pretzels into a large bowl."
    },
    {
      "position": 2,
      "text": "Blend olive oil, ranch-style dressing mix, garlic powder, and dill weed in a medium bowl; pour the mixture over pretzels. Let pretzels marinate for 1 hour, tossing approximately every 10 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Spread marinated pretzels on a large cookie sheet. Bake in the preheated oven for 8 to 10 minutes. Allow the pretzels to cool, then serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 70,

  "id": "534588b5-7167-59fe-a4d4-bd7d586db3cb",
  "slug": "sharlotka",
  "name": "Sharlotka",
  "recipe_type": "dessert",
  "brief_description": "Sharlotka is a traditional Russian apple cake that can be made in a deep pie dish, but you can also use the batter to make a single loaf cake, mini loaves, or cupcakes.",
  "cuisine": "Russian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an oversized, deep, glass pie dish and spread apples inside."
    },
    {
      "position": 2,
      "text": "Combine eggs and sugar in the bowl of a stand mixer fitted with the wire whisk attachment. Mix on the highest setting until eggs are foamy and change in color, 5 to 7 minutes. The goal is to achieve a consistency something close to meringue."
    },
    {
      "position": 3,
      "text": "Turn stand mixer off and switch the attachment to the standard mixing paddle. With the machine on its lowest setting, add flour, sour cream, salt, baking powder, and vanilla extract. Mix until just incorporated. Batter should be thick, fluffy, and airy. Do not overmix, as it will deflate the batter. Pour batter over apples in the pie dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top turns golden brown and a knife comes out clean, about 40 minutes. Let cool just until it is safe to handle the pan; loosen edges and flip the cake onto a serving platter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "peppermint-egg-nog-milkshake",
  "name": "Peppermint Eggnog Milkshake",
  "recipe_type": "dessert",
  "brief_description": "Use your holiday eggnog in this yummy milkshake flavored with peppermint extract.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine eggnog, vanilla ice cream, and peppermint extract in a blender, blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour milkshake into a glass and garnish with whipped cream and crushed peppermint. Serve immediately."
    }
  ],

  "id": "ffe5186c-5d43-5cc6-b1fb-6ea2bcfb28dd",
  "slug": "italian-sausage-and-cheese-party-puffs-recipe-11849155",
  "name": "Italian Sausage and Cheese Party Puffs",
  "recipe_type": "appetizer",
  "brief_description": "These Italian sausage and cheese party puffs, French bread slices baked with a cream cheese, Parmesan, and sausage topping, are a quick, easy, and popular appetizer. They\u2019re even more delicious served with marinara for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Mix sausage with cream cheese and Parmesan cheese in a bowl until well combined. Spread a thin layer of mixture over each bread slice and place on the prepared sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until sausage is cooked and bread is lightly browned, 15 to 17 minutes. Turn on the oven\u2019s broiler and cook until further browned on top, about 2 minutes. Serve as is or with marinara for dipping,"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

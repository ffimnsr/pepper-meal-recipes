  "id": "7acc3623-97c5-518f-a269-f17ff8c3221c",
  "slug": "hearty-vegetable-lasagna",
  "name": "Hearty Vegetable Lasagna",
  "recipe_type": "main",
  "brief_description": "This hearty vegetable lasagna is packed full of flavor from mushrooms, peppers, and onions. And it\u2019s easy to make and is the perfect comfort food.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Cook lasagna noodles in a large pot of boiling water for 10 minutes, or until al dente. Rinse with cold water, and drain."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan. Add mushrooms, green peppers, onion, and garlic; cook and stir until tender, about 5 minutes. Stir in pasta sauce and basil; bring to a boil. Reduce heat, and simmer for 15 minutes."
    },
    {
      "position": 3,
      "text": "While the sauce is simmering, mix together ricotta, 2 cups mozzarella cheese, and eggs in a medium bowl."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 5,
      "text": "Spread 1 cup cooked tomato and vegetable sauce into the bottom of the prepared baking dish. Lay down 1/2 of the lasagna noodles and layer 1/2 each of the ricotta mix, sauce, and Parmesan cheese on top. Repeat layering again with noodles, ricotta mix, sauce, and Parmesan cheese. Top with remaining 2 cups mozzarella."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, uncovered, for 40 minutes. Let stand for 15 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

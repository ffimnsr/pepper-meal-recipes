  "id": "1cd81ab4-ecce-5881-b47e-d68be201609b",
  "slug": "one-pan-chicken-broccoli-cheddar-pasta-bake-recipe-12002232",
  "name": "One-Pan Chicken Broccoli Cheddar Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This one-pan chicken broccoli Cheddar pasta bake is an all-in-one dinner, vegetables included. Rotini pasta cooks in the baking dish, surrounded by chicken, with a cheesy sauce made with Cheddar and cream cheese. It\u2019s delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Brush oil on the bottom and sides of a 9x13-inch baking dish. Place a block of cream cheese in the center of the pan and pour rotini around it. Pour in chicken broth."
    },
    {
      "position": 2,
      "text": "Toss chicken with ranch seasoning, salt, and pepper and place chicken on top of the pasta. Cover tightly with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes. Uncover and stir. Stir in 1 1/2 cups cheese and broccoli. Top with crackers and remaining cheese."
    },
    {
      "position": 4,
      "text": "Bake, covered, for 25 minutes; uncover for the last 10 to 15 minutes, or until cheese is melted and casserole is golden brown and bubbly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1f860a0f-7587-5997-b950-6e39f061329c",
  "slug": "georgia-nuggets",
  "name": "Georgia Nuggets",
  "recipe_type": "dessert",
  "brief_description": "A light browns sugar candy similar to Divinity is studded with pecans. This is a candy recipe that I share with all my family and friends at Christmas.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the brown sugar and evaporated milk in a medium saucepan. Heat over medium-high heat, stirring to dissolve the sugar. When the mixture begins to boil, connect a candy thermometer to the side of the pan."
    },
    {
      "position": 2,
      "text": "Heat to 232 degrees F (112 degrees C), or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from the water and placed on a flat surface."
    },
    {
      "position": 3,
      "text": "Remove from the heat and use a sturdy wooden spoon to stir in vanilla. Add butter and pecans and continue to stir until thick and creamy. It will lose some of its shine. Drop spoonfuls onto waxed paper and allow to cool at room temperature until set. Store in an airtight container at room temperature."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

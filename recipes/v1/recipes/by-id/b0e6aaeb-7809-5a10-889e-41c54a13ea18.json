  "id": "b0e6aaeb-7809-5a10-889e-41c54a13ea18",
  "slug": "candied-jalapenos-recipe-8642442",
  "name": "Candied Jalape\u00f1os",
  "recipe_type": "dessert",
  "brief_description": "Candied jalape\u00f1os are easy to make at home with sliced jalape\u00f1os, sugar, vinegar, and spices for a sweet and crunchy condiment with delicious heat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "While wearing gloves, rinse jalape\u00f1os and remove stem. Cut into 1/4-inch slices and set aside. To reduce the heat from the peppers, you may core out the centers with the seeds and discard before slicing."
    },
    {
      "position": 2,
      "text": "Combine brown sugar and apple cider vinegar in a saucepan over medium heat. Add garlic powder, celery seed, turmeric, cumin seed, anise seed, salt, and red pepper flakes. Bring to a simmer for 3 minutes. Add sliced jalape\u00f1o peppers and simmer for an additional 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Remove jalape\u00f1os to a jar using a slotted spoon. Continue simmering liquid over medium-low heat until slightly thickened, about 10 minutes more."
    },
    {
      "position": 4,
      "text": "Pour liquid over the jalape\u00f1os and let cool. Use a strainer to remove excess seeds from the liquid, if desired. Refrigerate for a minimum of 3 days before eating. Store in the refrigerator for up to 3 months."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

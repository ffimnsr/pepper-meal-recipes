  "slug": "indian-rice-pilaf",
  "name": "Indian Rice Pilaf",
  "recipe_type": "side",
  "brief_description": "Indian-inspired rice is nicely spiced with curry powder, cinnamon, and garlic powder for a delicious and aromatic side dish.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and chicken broth to a boil."
    },
    {
      "position": 2,
      "text": "Combine rice, curry powder, garlic powder, cinnamon, paprika, and cloves in a bowl; stir to mix. Add spiced rice and onion to the boiling broth. Cover and cook until rice is tender, 20 to 25 minutes."
    }
  ],
  "servings": 4,

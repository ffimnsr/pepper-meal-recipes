  "id": "2abd50c0-d2db-5442-bd58-e39f001a5b34",
  "slug": "gramma-browns-corn-chowder",
  "name": "Gramma Brown's Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This corn chowder recipe features bacon, onion, celery, potatoes, and carrots simmered in milk for a comforting soup perfect on cold winter days.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until almost done. Add onion and celery; saut\u00e9 until vegetables are lightly browned. Transfer mixture to a large soup pot."
    },
    {
      "position": 2,
      "text": "Stir in kernel corn, cream-style corn, broth, and margarine. Add potatoes and carrots. Bring to a boil. Reduce heat and simmer for about 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix together flour and a little water in a small bowl to form a paste."
    },
    {
      "position": 4,
      "text": "Stir flour paste into soup. Simmer for 30 minutes more or until you are ready to eat. Season with salt and pepper."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

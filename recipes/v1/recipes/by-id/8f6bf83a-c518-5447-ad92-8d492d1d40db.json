  "id": "8f6bf83a-c518-5447-ad92-8d492d1d40db",
  "slug": "caramel-apple-tofu-and-noodle-stir-fry-recipe-8745592",
  "name": "Caramel-Apple Tofu and Noodle Stir-Fry",
  "recipe_type": "dessert",
  "brief_description": "It\u2019s a disservice to only drizzle in rich, buttery caramel sauce during the dessert course. The ice cream topping teams up with soy sauce, peanut butter, and chili paste in this stir-fried main.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, for sauce, whisk together caramel topping, soy sauce, peanut butter, vinegar, chili paste, and toasted sesame oil in a small bowl."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon vegetable oil in a very large skillet over medium-high heat. Cook tofu, stirring frequently, until browned on all sides, about 8 minutes. Remove from skillet."
    },
    {
      "position": 4,
      "text": "If needed, add more vegetable oil to the skillet. Cook onion and garlic, stirring frequently, until softened, about 3 minutes. Add cabbage and carrot; cook, stirring frequently, until nearly tender, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Add tofu, sauce, and apple to skillet; cook, stirring frequently, until apple starts to soften, 1 to 2 minutes. Add pasta; toss and cook until heated through, 1 to 2 minutes. Garnish with peanuts and cilantro. Serve with lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

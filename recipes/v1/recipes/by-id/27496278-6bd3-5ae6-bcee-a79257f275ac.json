  "id": "27496278-6bd3-5ae6-bcee-a79257f275ac",
  "slug": "kimchi-fried-rice-kimchi-bokkeumbap",
  "name": "Kimchi Fried Rice",
  "recipe_type": "main",
  "brief_description": "Kimchi fried rice is a delicious way to use leftover rice and kimchi; spice things up with Korean chile paste and top with a fried egg for a quick and easy dinner.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat canola oil in large nonstick skillet over high heat. Add ground beef and green onion white parts; reduce heat to medium. Cook and stir until beef is browned and onion is fragrant, 1 to 2 minutes."
    },
    {
      "position": 2,
      "text": "Stir kimchi and gochujang into beef mixture; cook until warmed through and fragrant, 2 to 4 minutes. Add rice; cook and stir until rice is heated through and coated with gochujang, 3 to 5 minutes more."
    },
    {
      "position": 3,
      "text": "Drizzle sesame oil over rice mixture; stir to coat. Garnish with green onion green parts."
    },
    {
      "position": 4,
      "text": "Melt 1 teaspoon butter in a skillet over medium-high heat. Crack egg into the skillet; cook until white is completely set and yolk is thick, 3 to 4 minutes. Place egg over fried rice."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

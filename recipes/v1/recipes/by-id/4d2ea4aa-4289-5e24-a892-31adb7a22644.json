  "id": "4d2ea4aa-4289-5e24-a892-31adb7a22644",
  "slug": "golden-sweet-cornbread",
  "name": "Golden Sweet Cornbread",
  "recipe_type": "dessert",
  "brief_description": "This made from scratch cornbread recipe is a family-favorite that complements any dish. A must-have at barbecues or to use in cornbread dressing!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch round cake pan."
    },
    {
      "position": 3,
      "text": "Whisk flour, cornmeal, sugar, baking powder, and salt together in a large bowl."
    },
    {
      "position": 4,
      "text": "Add milk, vegetable oil, and egg; whisk until well combined."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the pan comes out clean, 20 to 25 minutes."
    },
    {
      "position": 7,
      "text": "Slice and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

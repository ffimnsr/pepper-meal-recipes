  "id": "8ab75a1e-3b16-5221-8d61-32fc70ab1d68",
  "slug": "spicy-sweet-buffalo-popcorn",
  "name": "Spicy-Sweet Buffalo Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Spicy Buffalo sauce meets sweet kettle corn to make this crunchy, addictive popcorn snack mix that your football party guests will destroy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a large bowl with cooking spray. Fill with popcorn."
    },
    {
      "position": 2,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper or a silicone pad."
    },
    {
      "position": 3,
      "text": "Combine sugar and water in a saucepan and bring to a boil over medium-high heat. Cook, without stirring and swirling pan gently as needed, until sugar has melted and the caramel is a deep amber color, 8 to 12 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Stir Buffalo sauce and butter carefully into the caramel; it will spit and bubble and may form a ball. Return to heat; bring to a boil, stirring until caramel is dissolved, about 3 minutes. Remove from heat and stir in the baking soda and cayenne pepper."
    },
    {
      "position": 5,
      "text": "Pour spicy caramel mixture carefully over the popcorn. Toss to completely coat, guarding your hands from the hot caramel. Spread the coated popcorn onto the prepared baking sheet."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until dry, 15 to 20 minutes. Let cool for 10 minutes; stir."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 36,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

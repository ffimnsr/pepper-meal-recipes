  "slug": "sweet-restaurant-slaw",
  "name": "Sweet Restaurant Slaw",
  "recipe_type": "salad",
  "brief_description": "This sweet coleslaw recipe uses a prepared coleslaw mix tossed with a tangy, flavorful dressing and poppy seeds. Perfect with fried chicken.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine coleslaw mix and onion in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk salad dressing, sugar, vegetable oil, vinegar, poppy seeds, and salt together in a medium bowl until blended."
    },
    {
      "position": 4,
      "text": "Pour dressing over coleslaw mixture and toss to coat. Chill for at least 2 hours before serving."
    }
  ],
  "servings": 8,

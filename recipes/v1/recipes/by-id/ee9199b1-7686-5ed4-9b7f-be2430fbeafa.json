  "id": "ee9199b1-7686-5ed4-9b7f-be2430fbeafa",
  "slug": "rich-butter-cake-recipe-11895540",
  "name": "Rich Butter Cake",
  "recipe_type": "dessert",
  "brief_description": "This rich butter cake is perfect for any occasion! With just some basic pantry staples, it comes together quickly, and tastes amazing. Serve it alongside a cup of tea or coffee\u2014or top it off with some fresh fruit for an extra treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line 9x9-inch square pan with enough parchment paper to have overhang on all sides."
    },
    {
      "position": 2,
      "text": "Beat butter, 3/4 cup plus 2 tablespoons white sugar, brown sugar, salt, and nutmeg together in a large bowl until light and fluffy, 3 to 5 minutes. Add eggs 1 at a time, mixing well after each addition. Beat in vanilla and almond extract. Add in 1 cup flour, baking powder, and baking soda, and mix on low speed until just combined. Add sour cream and milk, and mix until just incorporated. Add in remaining 3/4 cup flour and mix until just combined."
    },
    {
      "position": 3,
      "text": "Pour batter into the prepared pan and spread into an even layer. Sprinkle remaining 2 tablespoons white sugar evenly over the top of the batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 40 to 50 minutes. Allow cake to cool in the pan for 20 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2d4242eb-e425-5abb-8735-3fb8a8f7b0b7",
  "slug": "bundt-pan-doritos-locos-nachos-recipe-11926084",
  "name": "Bundt Pan Doritos Locos Nachos",
  "recipe_type": "appetizer",
  "brief_description": "These delectable Bundt pan Doritos locos nachos are a whole new way to make nachos. The ingredients are the same\u2014taco-seasoned beef, Mexican shredded cheese, tomatoes, and lettuce\u2014but they bake in the shape of a Bundt pan.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 12 to 14-quart nonstick Bundt pan generously with cooking spray."
    },
    {
      "position": 2,
      "text": "Add beef to a large nonstick skillet; cook over medium-high, breaking up meat into small pieces until browned, about 5 minutes. Stir in taco seasoning and water; cook according to package directions. Transfer cooked beef to a plate to cool, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add about a third of the chips to the bottom of the prepared Bundt pan, followed by half of the beef mixture. Sprinkle with 1/2 cup tomatoes, top with 1 1/2 cups cheese. Repeat layers once. Top with remaining Doritos and 1 cup cheese."
    },
    {
      "position": 4,
      "text": "Generously coat a sheet of aluminum foil with cooking spray; tightly cover the Bundt pan with foil, sprayed side down."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Discard foil and carefully invert pan onto a large serving platter. Top with lettuce, sour cream, hot sauce, and jalapenos. Serve with guacamole, salsa, or cheese sauce, if desired. Recipe Developed by Amanda Stanfield"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

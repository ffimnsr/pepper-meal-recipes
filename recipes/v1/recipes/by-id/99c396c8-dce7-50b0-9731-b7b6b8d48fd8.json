  "id": "99c396c8-dce7-50b0-9731-b7b6b8d48fd8",
  "slug": "sizzling-chicken-spaghetti-recipe-11879847",
  "name": "Sizzling Chicken Spaghetti",
  "recipe_type": "main",
  "brief_description": "This sizzling chicken spaghetti is the dish to turn to when you want something that is hot, fast and unbelievably delicious. The humble chicken breast is elevated through spices that have been bloomed in sizzling hot oil\u2014a true taste delight!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet to medium heat. Add the tallow, then add chicken and cook until no longer pink in the center. Remove to a plate and cover to keep warm."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes."
    },
    {
      "position": 3,
      "text": "Halfway through spaghetti cooking time, heat oil in a medium-sized pot to a low shimmer. Add garlic, then chili flakes, 2 tablespoons parsley, rosemary, thyme, oregano, and pepper. Stir and allow seasonings to \"bloom\", become fragrant, and infuse the oil, 1 to 2 minutes; remove from heat."
    },
    {
      "position": 4,
      "text": "Stir in chicken, along with any accumulated juices from the plate, then using a spider, remove spaghetti and add to chicken mixture. Stir it all together."
    },
    {
      "position": 5,
      "text": "Serve in shallow bowls with grated Parmesan cheese on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "dca0d093-ed65-52bf-b716-e495538bb0f8",
  "slug": "3-ingredient-ube-ice-cream-recipe-8681790",
  "name": "3 Ingredient Ube Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This 3 ingredient ube ice cream is super easy to make, absolutely delicious, and purple! I was thrilled when I discovered ube sweetened condensed milk at my local Filipino market, and this is the result.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour heavy cream into a chilled bowl. Using a hand mixer, whip until soft peaks form, 3 to 4 minutes. Add ube sweetened condensed milk and continue whipping until stiff peaks form. Add ube flavoring and mix until just combined."
    },
    {
      "position": 2,
      "text": "Pour into a freezer-safe container with a lid. Freeze overnight."
    },
    {
      "position": 3,
      "text": "Before serving, let sit on counter for a few minutes to soften a bit."
    }
  ],
  "servings": 6,

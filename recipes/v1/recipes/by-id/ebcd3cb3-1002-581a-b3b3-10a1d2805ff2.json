  "id": "ebcd3cb3-1002-581a-b3b3-10a1d2805ff2",
  "slug": "refried-black-beans",
  "name": "Refried Black Beans",
  "recipe_type": "side",
  "brief_description": "This recipe for homemade refried black beans with plenty of green chiles and seasoning is easy to make and tastes much better than the canned version.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place black beans into a large container and cover with several inches of cool water; let stand 8 hours to overnight. Drain."
    },
    {
      "position": 2,
      "text": "Place beans in a pot and add enough water to cover; bring to a boil. Reduce heat to medium-low and simmer beans until very tender, about 1 hour."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium; cook and stir onion and garlic until onion is soft and translucent, about 10 minutes. Add black beans, green chiles, chili powder, and cumin; cook and stir until flavors blend, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Blend black bean mixture in a food processor until smooth. Add tomato paste, chicken broth, vinegar, and salt; blend until desired consistency is reached. Return beans to pot and cook until heated through, about 5 minutes more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 15,

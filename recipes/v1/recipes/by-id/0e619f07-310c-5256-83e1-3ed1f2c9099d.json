  "id": "0e619f07-310c-5256-83e1-3ed1f2c9099d",
  "slug": "oven-fried-parmesan-chicken",
  "name": "Oven Fried Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "Lots of garlic butter and Parmesan guarantee intense flavor in this baked chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a shallow glass dish or bowl, combine the crushed garlic with the melted butter or margarine. In another small bowl mix together the bread crumbs, cheese, parsley, salt and pepper. Dip chicken pieces into garlic butter, then into crumb mixture to coat."
    },
    {
      "position": 3,
      "text": "Place coated chicken pieces into a lightly greased 9x13 inch baking dish. Drizzle with remaining garlic butter and bake uncovered in the preheated oven for 1 to 1 1/4 hours, or until chicken is cooked through and juices run clear."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,

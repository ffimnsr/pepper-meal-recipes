  "id": "ce6f373a-1361-571f-9f59-15b29bff3b98",
  "slug": "walnut-raisin-scones",
  "name": "Walnut Raisin Scones",
  "recipe_type": null,
  "brief_description": "Lemon peel provides a lovely counterpoint to the walnuts and raisins in these buttermilk scones.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl combine flour, sugar, baking powder, baking soda, salt and lemon peel."
    },
    {
      "position": 2,
      "text": "With a pastry blender or 2 knives, cut in butter until mixture resembles coarse meal. Mix in all but 2 tablespoons of the nuts and the raisins. Mix in buttermilk with fork."
    },
    {
      "position": 3,
      "text": "Gather the dough into a ball and knead for about 2 minutes on lightly floured board."
    },
    {
      "position": 4,
      "text": "Roll or pat out 3/4 inch thick. With a chef's knife cut into 3 inch triangles. Place, spaced 1inch apart, on a greased baking sheet. Brush tops with remaining 1 tablespoon buttermilk; sprinkle with the remaining sugar and the nuts."
    },
    {
      "position": 5,
      "text": "Bake in center of 425 degree F (220 degrees C) oven about 15 minutes or until nicely browned. Serve warm with butter or jam."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "ce0ed37a-ebb9-562a-b63c-62a88d410e76",
  "slug": "authentic-no-shortcuts-louisiana-red-beans-and-rice",
  "name": "Louisiana Red Beans and Rice",
  "recipe_type": "main",
  "brief_description": "Easy red beans in the crockpot to serve over rice! Just simmer the beans with sausage, a ham hock, peppers, and some seasoning \u2014 and check back in 8 hours!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Brown sausage in a large skillet over medium-high heat, 5 to 7 minutes. Use a slotted spoon to transfer sausage to a slow cooker, leaving drippings in the skillet."
    },
    {
      "position": 3,
      "text": "Add onion, bell pepper, jalape\u00f1o, and garlic to drippings in the skillet; cook and stir over medium heat until tender, about 5 minutes. Transfer to the slow cooker."
    },
    {
      "position": 4,
      "text": "Add soaked beans and ham hock to the slow cooker, then pour in water. Add basil, Creole seasoning, and pepper. Cover and cook on Low until beans are tender, about 8 hours."
    },
    {
      "position": 5,
      "text": "If the bean mixture is too watery, remove the lid, increase the heat to High, and cook until beans are creamy. Serve with cooked rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 490,
  "preparation_time_minutes": 20,

  "id": "1a5ac6b7-c6cc-5d3a-b710-85c06fa39ea0",
  "slug": "tofu-pumpkin-pie",
  "name": "Tofu Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "Try this pumpkin pie made with tofu instead of eggs and dairy. Now all plant-based eaters at your holiday table can have your pie and eat it too!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Blend pumpkin pur\u00e9e, tofu, pumpkin, sugar, cinnamon, salt, ginger, and cloves in a blender until smooth. Pour into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the heat to 350 degrees F (175 degrees C) and continue baking until a knife inserted into the center comes out clean, about 40 minutes more. Let cool completely before serving, about 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,

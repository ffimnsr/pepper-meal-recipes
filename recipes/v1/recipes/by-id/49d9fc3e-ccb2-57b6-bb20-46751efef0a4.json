  "id": "49d9fc3e-ccb2-57b6-bb20-46751efef0a4",
  "slug": "one-egg-lemon-pound-cake",
  "name": "One Egg Lemon Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "My Grandmother used to make this and it quickly became a household favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C) grease and flour an 8x4 inch loaf pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix flour, baking powder, sugar and salt. Cut in butter. Break 1 egg into a measuring cup and then fill to the 1 cup line with milk. Add to dry ingredients and beat well. Add vanilla and lemon flavoring."
    },
    {
      "position": 3,
      "text": "Pour batter into an 8x4 inch loaf pan. Bake at 350 degrees F (175 degrees C) for 30 minutes or until a toothpick inserted into the center of cake comes out clean."
    }
  ],
  "servings": 10,

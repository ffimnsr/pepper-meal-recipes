  "id": "c60f8d57-a1a6-5e8e-aff1-7320fc644f0d",
  "slug": "stuffed-french-toast-ii",
  "name": "Stuffed French Toast",
  "recipe_type": "dessert",
  "brief_description": "Stuffed French toast made with thick slices of golden bread and a sweet cream cheese and raspberry filling makes a wonderful special breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Spread softened cream cheese on 4 bread slices; spread raspberry jam on remaining 4 bread slices."
    },
    {
      "position": 3,
      "text": "Press cream cheese and jam bread slices together to form 4 sandwiches."
    },
    {
      "position": 4,
      "text": "Beat eggs, milk, and almond extract together in a shallow bowl."
    },
    {
      "position": 5,
      "text": "Melt butter in a large, heavy skillet over medium-high heat. Dip sandwiches in egg mixture to coat evenly."
    },
    {
      "position": 6,
      "text": "Cook sandwiches on both sides until golden brown, 2 to 4 minutes per side."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

  "id": "50d3af37-b22a-5a88-8331-01ba048a3722",
  "slug": "pistachio-cream-cinnamon-rolls-recipe-11678509",
  "name": "Pistachio Cream Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "This pistachio cream cinnamon roll recipe uses puff pastry to make cinnamon rolls in a novel way. They're finished with a lovely glaze made with mascarpone and pistachio cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment or grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine 1/2 cup mascarpone, white sugar, brown sugar, cinnamon, melted butter, and 1/8 teaspoon salt in a bowl and mix until smooth."
    },
    {
      "position": 3,
      "text": "Roll pastry sheets out on a lightly floured surface. Divide sugar mixture among the 2 sheets and spread into a thin layer going almost to the edges. Sprinkle each sheet evenly with chopped pistachios and drizzle each with 2 tablespoons pistachio cream."
    },
    {
      "position": 4,
      "text": "Roll each sheet into a log and place seam side down on the cutting board. Use a sharp knife to cut each log into 6 pinwheels. Place cinnamon rolls, cut side up, into the prepared pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly golden brown, 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, add remaining mascarpone, pistachio cream, heavy cream, and salt to a bowl and beat with an electric mixer until smooth. Gradually add powdered sugar and beat until smooth and slightly fluffy. Spread frosting over warm cinnamon rolls and sprinkle with additional chopped pistachios if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

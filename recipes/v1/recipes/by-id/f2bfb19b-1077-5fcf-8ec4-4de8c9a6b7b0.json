  "slug": "bang-bang-deviled-eggs-recipe-8649787",
  "name": "Bang Bang Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Make these bang bang deviled eggs as an easy side dish for your next gathering. The yolks are mixed with Japanese mayonnaise, sweet Thai chili sauce, sriracha, and rice vinegar before being piped into the egg white halves as a sweet-spicy-tangy take on classic deviled eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel hard-cooked eggs and then slice half lengthwise; remove yolks into a small mixing bowl."
    },
    {
      "position": 2,
      "text": "Gently mash yolks with a fork into a paste and then add your kewpie mayonnaise, sweet Thai chili sauce, sriracha, and rice vinegar; mix well to combine."
    },
    {
      "position": 3,
      "text": "Spoon or pipe mixture into egg whites."
    },
    {
      "position": 4,
      "text": "Garnish eggs with paprika and chopped green onions. Refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 10,

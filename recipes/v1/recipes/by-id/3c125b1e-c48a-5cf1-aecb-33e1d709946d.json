  "schema_version": 1,
  "id": "3c125b1e-c48a-5cf1-aecb-33e1d709946d",
  "slug": "peaches-n-cream-yogurt-clusters-recipe-12003850",
  "name": "Peaches 'n Cream Yogurt Clusters",
  "recipe_type": "dessert",
  "brief_description": "These peaches and cream yogurt clusters are super simple little treats. Chopped fresh peaches and yogurt are frozen, then coated with white chocolate. They are delightfully cold, mildly sweet, and very satisfying.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a large baking sheet with parchment paper. Stir together peaches and yogurt until evenly distributed, then scoop and drop mixture into 12 (about 2 tablespoons) mounds on prepared baking sheet, spacing at least 1 inch apart. Freeze clusters, uncovered, until set, about 1 1/2 hours."
    },
    {
      "position": 2,
      "text": "Place chocolate and coconut oil in a medium, microwave-safe bowl. Microwave on High in 15-second intervals, stirring after each interval, until melted and smooth, about 1 minute."
    },
    {
      "position": 3,
      "text": "Working with 1 cluster at a time, dip into melted chocolate mixture to fully coat. Let excess drip off, then return to baking sheet. Repeat with remaining 11 clusters. Freeze clusters, uncovered, until set, about 15 minutes. Let sit at room temperature 15 minutes before serving. Recipe developed by Craig Ruff"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

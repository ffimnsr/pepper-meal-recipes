  "id": "93045df2-7867-5f04-82d4-3b89abc6541d",
  "slug": "grilled-butternut-squash",
  "name": "Grilled Butternut Squash",
  "recipe_type": "salad",
  "brief_description": "Slices of grilled butternut squash are quick and easy to make in just 15 minutes on a preheated grill for a tender and delicious side dish or topping for salads.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Brush both sides of butternut squash slices with olive oil."
    },
    {
      "position": 3,
      "text": "Cook squash on the pre-heated grill, flipping as needed, until softened and browned, 15 to 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

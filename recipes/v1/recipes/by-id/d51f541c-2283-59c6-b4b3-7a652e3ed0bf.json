  "id": "d51f541c-2283-59c6-b4b3-7a652e3ed0bf",
  "slug": "air-fryer-salt-and-vinegar-fries-for-one",
  "name": "Air Fryer Salt and Vinegar Fries for One",
  "recipe_type": "side",
  "brief_description": "This air fryer recipe lets you fry up one serving of crispy salt and vinegar french fries in no time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel potato and cut lengthwise into 1/2-inch sticks. Rinse potato sticks under cold running water for a few seconds. Transfer to a large bowl. Add vinegar and just enough water to cover the potatoes. Let soak for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the air fryer to 320 degrees F (160 degrees C)."
    },
    {
      "position": 3,
      "text": "Drain and pat the potatoes dry. Toss with oil, salt, and pepper in a bowl and transfer to the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer until soft but not browned, about 16 minutes. Shake the basket and raise the temperature to 355 degrees F (180 degrees C). Air fry for 6 minutes, shake, and check for doneness. Cook until outsides of fries are crispy and browned, about 6 minutes more. Taste and adjust salt before serving."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

  "id": "aa0b6f0c-4668-5e96-a07e-88335c55a37f",
  "slug": "onion-quiche",
  "name": "Onion Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This simple quiche is a versatile dish that can be served with almost anything.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Over medium-low heat melt butter in a large saucepan. Add onions and cook slowly, stirring occasionally, until onions are soft."
    },
    {
      "position": 3,
      "text": "In a small bowl, beat together eggs and cream. Stir in cheese. Spread onions in bottom of pastry shell. Pour egg mixture over onions."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 30 minutes, or until eggs have set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

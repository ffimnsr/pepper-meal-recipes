{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ed16c974-919e-5e0b-ad99-6151c05fba36",
  "slug": "vegetable-cornish-pasties",
  "name": "Vegetable Cornish Pasties",
  "recipe_type": "main",
  "brief_description": "This recipe makes four generous pasties, enough for a very proper lunch. Prepared, whole wheat pastry dough is cut into squares and heaped with a hearty, cooked filling of onions, carrots, diced potatoes, turnips, mushrooms and Cheddar cheese. The pastries are folded into triangles, sealed and baked until golden brown.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Divide pastry dough into four equal portions and roll each one out in a square shape. Set pastry aside to rest."
    },
    {
      "position": 3,
      "text": "Place a large skillet over medium heat. Add butter or margarine and allow to melt. Add onion and saute for 5 minutes, until translucent and beginning to brown. Add carrot, turnip, potato, mushrooms, and water. Lower heat and cover skillet. Allow mixture to cook for 10 minutes, stirring occasionally."
    },
    {
      "position": 4,
      "text": "In a small bowl, dissolve yeast extract in milk. Whisk in 1 egg. Stir this mixture into cooked vegetables. Continue to stir until mixture thickens. Add cheese, and salt and pepper to taste. Set aside to cool."
    },
    {
      "position": 5,
      "text": "Place 1/4 of filling on one half of each pastry square. Fold pastry diagonally and seal edges. Brush tops of pastry with beaten egg."
    },
    {
      "position": 6,
      "text": "Place pasties on a baking sheet and bake in preheated oven for 30 minutes, until pastry is golden brown."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

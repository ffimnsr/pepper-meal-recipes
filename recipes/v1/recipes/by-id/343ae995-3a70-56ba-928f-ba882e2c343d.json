  "id": "343ae995-3a70-56ba-928f-ba882e2c343d",
  "slug": "japanese-tamago-egg",
  "name": "Japanese Tamago Egg",
  "recipe_type": "appetizer",
  "brief_description": "Tamago is a light, slightly sweet and savory Japanese rolled omelet also known as tamagoyaki \u2014 it will make a great addition to your sushi platter!",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat eggs thoroughly in a bowl; whisk in dashi stock, sugar, mirin, and soy sauce until sugar has dissolved. Lightly grease a tamago pan or a small nonstick skillet and heat over medium heat."
    },
    {
      "position": 3,
      "text": "Pour a thin layer of egg mixture into the hot pan and swirl to coat the pan. Cook until egg layer is firm on the bottom but still slightly liquid on top, about 1 minute."
    },
    {
      "position": 4,
      "text": "Then lift up one edge using a spatula and roll up the egg layer."
    },
    {
      "position": 5,
      "text": "Push omelet roll to one side of the skillet. Oil the skillet again and pour in another thin layer of egg, lifting the first omelet roll up slightly to allow the egg to flow underneath."
    },
    {
      "position": 6,
      "text": "Roll up the first omelet in the new layer of egg and push omelet to the edge of the skillet as before."
    },
    {
      "position": 7,
      "text": "Repeat the process with the remaining egg mixture, oiling the pan each time if needed."
    },
    {
      "position": 8,
      "text": "Remove rolled omelet to a serving platter and cut into 6 equal pieces to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e385d79f-583c-58ad-8c84-1d960ce0ea5d",
  "slug": "barbecued-beef-sandwiches",
  "name": "Barbecued Beef Sandwiches",
  "recipe_type": "main",
  "brief_description": "This recipe couldn't be much easier. Simply combine all ingredients and cook for 3 hours, then shred the meat. Serve it on buns of your choice...and then sit back and take in the compliments!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place roast in a Dutch oven, and sprinkle with chopped onions. Cover with tomatoes, water, sugar and Worcestershire sauce. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Cook over medium heat with lid slightly ajar for 3 hours."
    },
    {
      "position": 3,
      "text": "Remove meat, and shred with 2 forks. Discard bones, fat and gristle. place shredded meat back into sauce, and cook until liquid is reduced, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,

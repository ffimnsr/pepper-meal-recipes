  "id": "03369d24-bfee-5a4c-8bfc-a646f2a5faa6",
  "slug": "gluehwein",
  "name": "Gl\u00fchwein",
  "recipe_type": "drink",
  "brief_description": "This Gl\u00fchwein recipe makes a hot spiced red wine with cinnamon, orange, and clove; it's an easy, warming drink that feels cozy from the very first sip.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, sugar, and cinnamon in a large saucepan; bring to a boil. Reduce heat to low."
    },
    {
      "position": 2,
      "text": "Cut one orange in half; squeeze juice into sugar mixture. Push 5 cloves into each orange peel; add to the saucepan. Simmer over low heat until thick and syrupy, 20 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Slice remaining orange; set aside for serving."
    },
    {
      "position": 4,
      "text": "Remove mixture from heat; stir in wine. Discard orange peels and cinnamon stick."
    },
    {
      "position": 5,
      "text": "Ladle into mugs and garnish with reserved orange slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f9621eae-039c-5c9b-973d-19c4176c24ce",
  "slug": "irish-soda-bread-scones-recipe-8550478",
  "name": "Irish Soda Bread Scones",
  "recipe_type": "breakfast",
  "brief_description": "These Irish soda bread scones are deliciously fluffy and bursting with raisins. They're quick to make with no rise time required for a breakfast treat.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together flour, oats, baking powder, salt, baking soda, and 1/4 cup sugar in a large bowl until combined."
    },
    {
      "position": 3,
      "text": "Cut butter into flour mixture with your fingers or a pastry cutter until dough resembles coarse meal."
    },
    {
      "position": 4,
      "text": "Add raisins, orange zest, and 3/4 cup plus 1 tablespoon buttermilk; stir until just combined."
    },
    {
      "position": 5,
      "text": "Transfer dough to a lightly floured work surface; pat dough into a 7-inch circle, about 3/4-inch thick. Line a baking sheet with parchment."
    },
    {
      "position": 6,
      "text": "Using a floured bench scraper or knife, cut dough circle into 8 wedges; place wedges on the prepared baking sheet, spacing about 1 inch apart. Alternatively, scoop 8 (1/3-cup) mounds of dough onto a parchment-lined baking sheet, about 2 inches apart. Brush each scone evenly with remaining 2 tablespoons buttermilk, and sprinkle with remaining 1 tablespoon sugar. Place baking sheet in freezer, and freeze until chilled, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake scones in the preheated oven until bottoms and tops are golden, about 20 minutes. Remove from the oven, and let cool completely on the baking sheet, about 30 minutes. Serve warm or at room temperature with butter and jam, if desired. Recipe developed by Julia Levy"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

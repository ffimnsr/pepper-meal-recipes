  "id": "99ec3e01-9ede-5b50-82af-2bb3970a7818",
  "slug": "spicy-slow-cooked-chili",
  "name": "Spicy Chili",
  "recipe_type": "soup",
  "brief_description": "A spicy chili recipe made in the slow cooker with beef, kidney beans, cayenne pepper, and chili powder for a satisfying dinner with a spicy kick!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Combine ground beef, kidney beans, diced tomatoes, tomato sauce, onions, bell pepper, garlic, chili powder, cayenne pepper, salt, and black pepper in a slow cooker."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low for 10 hours or High for 4 hours."
    },
    {
      "position": 5,
      "text": "Garnish each serving with a spoonful of sour cream and shredded cheese."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 250,

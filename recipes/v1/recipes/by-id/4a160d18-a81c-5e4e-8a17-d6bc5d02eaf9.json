  "id": "4a160d18-a81c-5e4e-8a17-d6bc5d02eaf9",
  "slug": "my-special-shrimp-scampi-florentine",
  "name": "My Special Shrimp Scampi Florentine",
  "recipe_type": "main",
  "brief_description": "My special shrimp scampi Florentine recipe has the fresh flavors of tomatoes, fresh spinach, and pesto. Serve it over rice with hot Italian bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine butter and olive oil in a large skillet over medium heat. Stir in tomatoes, pesto, and garlic; simmer until tomatoes start to soften, about 2 minutes. Season with pepper flakes and black pepper."
    },
    {
      "position": 2,
      "text": "Stir shrimp into sauce; cook just until they turn pink, 3 to 5 minutes. Add spinach; stir until wilted, about 1 minute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

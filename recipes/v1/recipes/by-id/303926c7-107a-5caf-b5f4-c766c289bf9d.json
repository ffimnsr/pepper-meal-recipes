  "id": "303926c7-107a-5caf-b5f4-c766c289bf9d",
  "slug": "show-off-stroganoff",
  "name": "Show-Off Stroganoff",
  "recipe_type": "main",
  "brief_description": "This creamy beef stroganoff made with mushrooms and pearl onions is so delicious it has been named Show-Off Stroganoff.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil and butter together in a skillet over low heat until smooth."
    },
    {
      "position": 2,
      "text": "Whisk flour, salt, and pepper together in a shallow bowl. Coat beef strips in flour mixture, gently shaking off any excess flour."
    },
    {
      "position": 3,
      "text": "Increase heat under skillet to medium. Add beef to skillet and cook and stir until browned, 1 to 2 minutes per side. Mix mushrooms into beef, adding more oil if pan is dry; cook and stir until mushrooms are lightly browned, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Pour wine into the skillet and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon; continue cooking until liquid is reduced by half, 5 to 10 minutes. Add beef broth and return to a boil."
    },
    {
      "position": 5,
      "text": "Cover skillet and cook until beef is tender, 20 to 25 minutes."
    },
    {
      "position": 6,
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes. Drain."
    },
    {
      "position": 7,
      "text": "Mix onions into beef mixture; cook and stir until onions are warmed, 3 to 5 minutes. Remove skillet from heat and gently stir sour cream into beef mixture; serve over noodles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4f858d38-074e-53d9-9d4b-fe47d2cdb672",
  "slug": "middle-eastern-rice-pilaf-with-pomegranate",
  "name": "Middle Eastern Rice Pilaf with Pomegranate",
  "recipe_type": "side",
  "brief_description": "This Middle Eastern-inspired rice pilaf with pomegranate seeds, allspice, pistachios, and saffron tastes great with grilled fish or meat, like lamb.",
  "cuisine": "Middle Eastern Inspired Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a saucepan over medium heat. Add onion and cook until soft and translucent, about 5 minutes. Add rice and toast until fragrant, 2 to 3 minutes. Pour in hot vegetable broth and bring to a boil. Add saffron and allspice; reduce the heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, toast pistachios in a skillet over medium heat until nuts start to turn golden brown and become fragrant, 5 to 10 minutes. Set aside."
    },
    {
      "position": 3,
      "text": "Stir butter into cooked rice. Remove from the heat and mix in pistachios and pomegranate seeds. Fluff with a fork and season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

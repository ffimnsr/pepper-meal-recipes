  "slug": "slow-cooker-baked-beans-using-canned-beans",
  "name": "Slow Cooker Baked Beans Using Canned Beans",
  "recipe_type": "side",
  "brief_description": "These slow cooker baked beans with canned beans, ham, bell pepper, and onion are simmered in barbecue sauce and brown sugar for a versatile side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together barbecue sauce, ketchup, brown sugar, and mustard in a 4-quart slow cooker until smooth. Stir in beans, bell pepper, onion, and ham until well combined."
    },
    {
      "position": 2,
      "text": "Cook on Low until thickened, 8 to 12 hours."
    }
  ],
  "servings": 12,

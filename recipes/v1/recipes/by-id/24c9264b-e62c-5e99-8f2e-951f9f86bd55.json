  "id": "24c9264b-e62c-5e99-8f2e-951f9f86bd55",
  "slug": "shiitake-and-baby-bella-mushroom-risotto",
  "name": "Shiitake and Baby Bella Mushroom Risotto",
  "recipe_type": "main",
  "brief_description": "Shiitake and cremini mushrooms pair with fresh thyme in this rich, vegetarian risotto. It takes time, but good risotto is always worth the effort!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium-high heat. Cook and stir shallot in hot oil for 30 seconds. Add mushrooms and continue cooking until they begin to brown. Stir in rice and 2 tablespoons butter; reduce heat to medium. Cook and stir until shallot and mushrooms turn golden brown."
    },
    {
      "position": 2,
      "text": "Pour in wine; simmer until evaporated, stirring constantly. Season with thyme, celery salt, salt, and pepper. Reduce heat to medium-low; pour in 1/3 of the hot vegetable stock. Cook until evaporated, stirring constantly, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Pour in 1/2 of the remaining hot vegetable stock; continue to cook and stir until evaporated. Repeat once more with remaining hot stock. Stir constantly until rice is tender and creamy. Add hot water if needed to continue cooking until rice has softened."
    },
    {
      "position": 4,
      "text": "Stir in Parmesan cheese, parsley, and remaining 2 tablespoons butter to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

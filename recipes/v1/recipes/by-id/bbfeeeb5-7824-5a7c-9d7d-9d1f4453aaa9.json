  "id": "bbfeeeb5-7824-5a7c-9d7d-9d1f4453aaa9",
  "slug": "easy-tofu-and-watercress-salad",
  "name": "Easy Tofu and Watercress Salad",
  "recipe_type": "salad",
  "brief_description": "This easy tofu and watercress salad recipe is a beloved local favorite in Hawaii. It's simple to make, refreshingly light, and always a crowd-pleaser.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut watercress into 1 1/2-inch lengths. Combine watercress, tofu, bean sprouts, tomatoes, tuna, and green onion in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk shoyu, oil, sugar, sesame seeds, garlic, and ginger together in a bowl; drizzle over salad (a little goes a long way) and toss well before serving."
    }
  ],
  "servings": 6,

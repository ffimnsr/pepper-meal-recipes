  "id": "4d8f2889-7e5b-5327-a0b8-036110384a68",
  "slug": "grandmas-blueberry-buckle",
  "name": "Grandma's Blueberry Buckle",
  "recipe_type": "dessert",
  "brief_description": "Grandma's blueberry buckle recipe is baked in a 9x13-inch dish and features a delicious, tender berry-filled cake topped with a buttery cinnamon crumble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Beat 1 \u00bd cups sugar and \u00bd cup softened butter together in a large bowl using an electric mixer until creamy and smooth. Beat in eggs, one at a time, beating well after each addition. Whisk 4 cups flour, baking powder, and salt together in a separate bowl until well combined; stir into egg mixture, alternating with milk, until just combined. Fold in blueberries until evenly distributed. Pour batter into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine 1 \u2153 cups sugar, 1 cup flour, and cinnamon in a medium bowl; cut in \u2154 cup cold butter using a pastry blender or 2 knives until crumbly. Sprinkle topping evenly over batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 45 minutes. Cool on a wire rack."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

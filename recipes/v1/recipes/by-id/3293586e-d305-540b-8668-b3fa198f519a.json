  "id": "3293586e-d305-540b-8668-b3fa198f519a",
  "slug": "soy-chorizo-omelet",
  "name": "Soy Chorizo Omelet",
  "recipe_type": "breakfast",
  "brief_description": "A great way to cook soy chorizo from Trader Joe's\u00ae is this simple yet filling omelet that gets a nice spice from the vegetarian soyrizo.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in an ovenproof skillet over medium heat; cook onion and garlic until soft and translucent, about 5 minutes. Add soy chorizo and cook, stirring often, until hot, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 3,
      "text": "Beat eggs, milk, and salt in a small bowl. Pour into skillet and stir gently to make sure egg mixture reaches the bottom of skillet. Cook until eggs are set on the bottom and almost set on the top, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer skillet to the preheated oven and broil until the top is set and starts to brown, 3 to 5 minutes. Let rest 5 minutes before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 5,
  "difficulty": "easy",

  "id": "0b75a555-c12a-53d8-bb37-57b858faca50",
  "slug": "key-lime-pie-i",
  "name": "Homemade Key Lime Pie",
  "recipe_type": "dessert",
  "brief_description": "This classic Key lime pie is light, creamy, and refreshing with a homemade graham cracker crust. Fresh whipped cream and lime slices make a beautiful finishing touch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Combine graham cracker crumbs, white sugar, and melted butter in a medium bowl. Press evenly into a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Bake the crust in the preheated oven until lightly set, about 5 minutes. Let cool."
    },
    {
      "position": 3,
      "text": "Separate 2 eggs, placing the egg whites in a large bowl and the yolks in another bowl. Add the remaining whole egg to the yolks. Whisk in key lime juice and sweetened condensed milk until smooth."
    },
    {
      "position": 4,
      "text": "Beat egg whites with salt and cream of tartar until stiff peaks form. Gently fold into the lime mixture until no streaks remain. Pour filling into the cooled crust."
    },
    {
      "position": 5,
      "text": "Bake until the filling is just set, 10 to 15 minutes. Let cool to room temperature."
    },
    {
      "position": 6,
      "text": "Freeze until firm, at least 4 hours or overnight."
    },
    {
      "position": 7,
      "text": "Beat heavy whipping cream until stiff peaks form. Garnish the pie with whipped cream and lime slices before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "98d375cf-d642-5084-8e33-344e511aacde",
  "slug": "dirty-dirty-rice",
  "name": "Dirty, Dirty Rice",
  "recipe_type": "main",
  "brief_description": "Learn how to make dirty rice even dirtier with pork shoulder, andouille sausage, tons of aromatic vegetables, and a full half pound of chicken liver.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a high-sided pan over medium-high heat. Add pork; cook and stir until well browned and fat is rendered, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Add onion, celery, and bell pepper; saut\u00e9 until translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in paprika, cumin, black pepper, cayenne, garlic powder, oregano, and thyme. Cook, stirring occasionally, as vegetables continue to soften, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Reduce the heat to medium and add andouille sausage; cook and stir to release some flavor, 2 to 3 minutes. Stir in rice and chicken livers until well coated."
    },
    {
      "position": 6,
      "text": "Add broth and salt; bring to a simmer over medium-high heat."
    },
    {
      "position": 7,
      "text": "Add bay leaf and Worcestershire sauce, cover tightly, and reduce the heat to medium-low. Cook, without stirring, until most of the liquid is absorbed and rice is starting to get tender, about 25 minutes."
    },
    {
      "position": 8,
      "text": "Add green onions and parsley; mix well. Cover and continue cooking over low to medium-low heat until rice is tender, about 10 minutes."
    },
    {
      "position": 9,
      "text": "Taste for seasoning and discard bay leaf before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

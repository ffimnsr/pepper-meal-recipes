  "id": "71f9558f-e385-545b-b1e1-1844de7d0664",
  "slug": "butterfinger-bars-recipe-6581522",
  "name": "Butterfinger Bars",
  "recipe_type": "dessert",
  "brief_description": "These very easy butterfinger bars use just 4 ingredients: cornflakes, smooth peanut butter, sugar and corn syrup. Kids love them!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat syrup and sugar, stirring continuously, until mixture comes to a boil."
    },
    {
      "position": 2,
      "text": "Remove from heat; add peanut butter and stir until smooth. Pour mixture over cornflakes in a large bowl. Mix until cereal is thoroughly coated."
    },
    {
      "position": 3,
      "text": "Spread in a buttered 9x13-inch pan and press down lightly with buttered hands. Allow to cool."
    },
    {
      "position": 4,
      "text": "Place chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Pour or spread melted chocolate on top of the cornflake mixture. Allow to harden and cut into squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

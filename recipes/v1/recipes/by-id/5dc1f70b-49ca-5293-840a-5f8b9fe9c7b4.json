{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5dc1f70b-49ca-5293-840a-5f8b9fe9c7b4",
  "slug": "canned-spiced-pickled-beets",
  "name": "Canned Spiced Pickled Beets",
  "recipe_type": "drink",
  "brief_description": "This recipe for canned spiced pickled beets with cinnamon and clove yields 6 quarts. Don't throw away the juice; use it to make pickled beet eggs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine white vinegar, sugar, water, cinnamon, salt, and cloves in a large pot; bring to a boil and stir until sugar has dissolved. Stir in beets and simmer until tender, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, inspect six 1-quart jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until beets are ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 3,
      "text": "Pack sliced beets into hot, sterilized jars, using a slotted spoon, then pour in beet liquid filling to within \u00bc inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 4,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 30 minutes."
    },
    {
      "position": 5,
      "text": "Remove jars from the stockpot and place onto a cloth-covered or wood surface, several inches apart, until cool. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "46bbe876-1341-50d3-9ca2-2855e3213247",
  "slug": "blueberry-butter-swim-biscuits-recipe-11849211",
  "name": "Blueberry Butter Swim Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These blueberry butter swim biscuits are even easier than drop biscuits. Blueberry biscuit dough is poured into melted butter, scored, baked, and glazed. If you have never made biscuits before, this recipe would be a good place to start.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Place butter in a square baking dish and microwave on High until melted."
    },
    {
      "position": 2,
      "text": "Whisk together flour, sugar, baking powder, salt, and lemon zest in a bowl. Add blueberries and toss to coat. Stir in 2 cups buttermilk until just blended and pour mixture into the baking dish with the melted butter."
    },
    {
      "position": 3,
      "text": "Use a knife to score the batter into 9 to 12 squares."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until biscuits are evenly browned and cooked through, 27 to 30 minutes. Let cool for 5 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine confectioner\u2019s sugar, 1 tablespoon buttermilk, and lemon juice in a bowl; whisk together until smooth. Pour glaze on top of the warm biscuits and spread out evenly."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,

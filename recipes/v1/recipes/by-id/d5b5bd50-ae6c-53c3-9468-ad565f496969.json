  "id": "d5b5bd50-ae6c-53c3-9468-ad565f496969",
  "slug": "eggnog-hot-chocolate",
  "name": "Eggnog Hot Chocolate",
  "recipe_type": "drink",
  "brief_description": "Creamy, hot eggnog is combined with rich, dark hot chocolate and spiked with coffee liqueur.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt milk with chocolate in a medium saucepan over medium-low heat. Remove from heat and let stand for 2 minutes. Whisk mixture until melted and smooth."
    },
    {
      "position": 2,
      "text": "Stir in eggnog. Heat gently over low heat until very warm but not boiling. Remove from heat; stir in vanilla and coffee liqueur."
    },
    {
      "position": 3,
      "text": "Pour into mugs. Serve topped with whipped cream and a cinnamon stick garnish."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "26229b6f-5176-5d76-8ced-dc910af04c3b",
  "slug": "grannys-cherokee-casserole",
  "name": "Granny's Cherokee Casserole",
  "recipe_type": "soup",
  "brief_description": "A delicious casserole with cream of mushroom soup, tomatoes, rice, and onions with browned ground beef, covered with cheese in a baked one-dish meal.",
  "cuisine": "Native American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place ground beef and onions in a large, deep skillet. Cook over medium-high heat until beef is evenly brown. Drain any excess fat."
    },
    {
      "position": 3,
      "text": "Add tomatoes, condensed soup, rice, sugar, garlic powder, thyme, and oregano. Mix well and cook over medium heat for 10 minutes. Place in a 9x13-inch casserole dish."
    },
    {
      "position": 4,
      "text": "Top with cheese slices and bake until cheese is bubbling and browning, 15 to 20 minutes."
    }
  ],
  "servings": 11,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

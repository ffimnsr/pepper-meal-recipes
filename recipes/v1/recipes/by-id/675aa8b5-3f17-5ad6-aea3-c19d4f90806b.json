  "id": "675aa8b5-3f17-5ad6-aea3-c19d4f90806b",
  "slug": "cranberry-orange-sauce",
  "name": "Cranberry Orange Sauce",
  "recipe_type": "drink",
  "brief_description": "This homemade cranberry orange sauce is quick and easy to make with just 4 simple ingredients: fresh cranberries, brown sugar, orange juice and cinnamon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix cranberries, brown sugar, orange juice, orange zest, and cinnamon stick together in a saucepan; bring to a boil."
    },
    {
      "position": 3,
      "text": "Reduce heat and simmer until cranberries pop and sauce is thickened, about 15 minutes."
    },
    {
      "position": 4,
      "text": "For best results, transfer cranberry sauce to a bowl and refrigerate until chilled, at least 1 hour."
    },
    {
      "position": 5,
      "text": "Remove cinnamon stick from sauce and serve at room temperature."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

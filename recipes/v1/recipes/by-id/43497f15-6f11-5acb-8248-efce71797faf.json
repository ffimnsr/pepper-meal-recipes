  "id": "43497f15-6f11-5acb-8248-efce71797faf",
  "slug": "baked-chicken-and-artichoke-orzo-casserole-recipe-11958189",
  "name": "Baked Chicken and Artichoke Orzo Casserole",
  "recipe_type": "salad",
  "brief_description": "This baked chicken artichoke orzo combines tender chicken, artichokes, and orzo in a rich, creamy cheese sauce, all baked together in one dish. Easy to make and satisfying, it\u2019s the perfect low-cleanup dinner with a simple salad and crusty bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch baking dish with olive oil spray."
    },
    {
      "position": 2,
      "text": "Pour chicken stock and heavy cream into the prepared baking dish; add orzo, chicken, spinach, tomatoes, 1/2 of the mozzarella, 1/2 of the Parmesan cheese, artichoke hearts, garlic powder, Italian seasoning, salt, pepper, and pepper flakes."
    },
    {
      "position": 3,
      "text": "Stir everything together, then smooth the top evenly. Sprinkle casserole with remaining mozzarella and Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, uncovered, until orzo is as tender as you like, 40 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Allow casserole to rest for 10 minutes. Stir gently, garnish with fresh parsley, and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 10,
  "difficulty": "medium",

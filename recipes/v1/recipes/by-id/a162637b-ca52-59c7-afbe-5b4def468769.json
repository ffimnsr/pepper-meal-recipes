  "id": "a162637b-ca52-59c7-afbe-5b4def468769",
  "slug": "harissa-baked-salmon-recipe-8645607",
  "name": "Harissa Baked Salmon",
  "recipe_type": "main",
  "brief_description": "In this baked harissa salmon dish, a wild salmon fillet is topped with a creamy paste flavored with harissa and smoky paprika for a fiery fish dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Coat the inside of a 9x12-inch baking dish with vegetable oil."
    },
    {
      "position": 2,
      "text": "Place salmon fillet into the baking dish; sprinkle with salt and pepper. Arrange lemon slices and onion rings on the salmon."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise, lemon juice, harissa, and smoked paprika together in a bowl until well combined; spread on top of salmon, lemon, and onion slices. Drizzle orange juice and wine around salmon."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until salmon is hot and has begun to turn opaque, 10 to 12 minutes. Remove the baking dish from the oven, set a broiler rack about 5 inches from the broiler, and turn the broiler on. Broil the fish until nicely browned, about 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

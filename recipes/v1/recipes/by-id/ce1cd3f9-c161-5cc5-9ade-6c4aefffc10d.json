  "id": "ce1cd3f9-c161-5cc5-9ade-6c4aefffc10d",
  "slug": "easy-and-delicious-purple-yam-cookies",
  "name": "Easy and Delicious Purple Yam (Ube) Cookies",
  "recipe_type": "dessert",
  "brief_description": "Ube cookies, made with purple yam powder, are a bright purple color and have a soft, cake-like texture, a nice quick and easy recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or grease lightly."
    },
    {
      "position": 2,
      "text": "Mix sugar, oil, eggs, vanilla extract, salt, baking powder, purple yam powder, and flour, in this order, in a large bowl until dough is well blended. Drop tablespoons of dough onto the baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cookies look firm, 8 to 10 minutes. Cool for at least 5 minutes before gently transferring to a wire rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

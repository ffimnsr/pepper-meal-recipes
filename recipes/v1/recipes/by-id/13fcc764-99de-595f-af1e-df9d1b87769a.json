  "id": "13fcc764-99de-595f-af1e-df9d1b87769a",
  "slug": "lolahs-chicken-adobo",
  "name": "Lolah's Chicken Adobo",
  "recipe_type": "main",
  "brief_description": "You'll find the traditional flavors of Filipino Chicken Adobo in this updated recipe.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat until oil is shimmering. Cook garlic in oil for no more than 30 seconds. Add all of the chicken to the pot; cook, stirring frequently, until chicken is white all over. Do not brown."
    },
    {
      "position": 2,
      "text": "Pour in soy sauce, vinegar, and water, and add the pickling spice. Make sure the spice ball is submerged. Bring to a boil, reduce heat to simmer, and place lid on pot so that some steam can escape. Simmer for 1 hour, or until chicken is very tender."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,

  "id": "a19d0ff2-a7ad-505a-aa94-5c07e8572073",
  "slug": "lauras-quick-slow-cooker-turkey-chili",
  "name": "Laura's Quick Slow Cooker Turkey Chili",
  "recipe_type": "soup",
  "brief_description": "This is an easy crockpot turkey chili recipe you can throw in the slow cooker and forget about until dinner. Zesty flavor meets convenience here.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium heat. Place turkey in the skillet, and cook until evenly brown; drain."
    },
    {
      "position": 3,
      "text": "Coat the inside of a slow cooker with cooking spray, and mix in turkey, tomato soup, kidney beans, black beans, and onion."
    },
    {
      "position": 4,
      "text": "Season with chili powder, garlic powder, cumin, red pepper flakes, black pepper, allspice, and salt."
    },
    {
      "position": 5,
      "text": "Cover, and cook on Low for 8 hours, or on High for 4 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "expert",

  "id": "eb607cf2-0a57-5a07-8a13-4a27db872e66",
  "slug": "copycat-disneyland-pickle-corn-dog-recipe-11977282",
  "name": "Copycat Disneyland Pickle Corn Dog",
  "recipe_type": "dessert",
  "brief_description": "This copycat Disneyland pickle corn dog lets you make the popular concession item at home. The meaty hot dog paired with the tart and juicy pickle and lightly sweet batter work so well together. Then the crispy breading from the panko breadcrumbs combined with the creamy peanut butter is a delight to the senses.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add oil to a fryer and preheat to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Use an apple corer to cut a hole into the center of the pickle lengthwise."
    },
    {
      "position": 3,
      "text": "Skewer a hot dog with a 6-inch skewer and insert the hot dog into the hole in the pickle. Pat the outside of the pickle dry with a paper towel. Repeat with remaining pickles and hot dogs."
    },
    {
      "position": 4,
      "text": "Add cornmeal, flour, sugar, and baking powder to a bowl and whisk to combine. In a separate smaller bowl, add egg and milk and whisk to combine. Add the wet ingredients to the dry ingredients and whisk until well blended and smooth with the consistency of a thick pancake batter."
    },
    {
      "position": 5,
      "text": "Place panko bread crumbs into a shallow dish. Dip the pickle dog into the batter, turning to coat completely in a thick layer, then swirl to smooth any excess drips. Roll the battered dog in the panko to coat."
    },
    {
      "position": 6,
      "text": "Carefully place the battered, coated dog into the preheated oil. Deep fry, turning occasionally if needed, until deep golden brown, about 4 minutes. Using tongs, remove to a paper towel-lined plate to dry. Repeat the last two steps with the remaining pickle dogs."
    },
    {
      "position": 7,
      "text": "Serve with peanut butter for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

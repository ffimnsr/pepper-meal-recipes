  "id": "4024cbb5-8e59-5587-9ba2-9efcab53f587",
  "slug": "seafood-boil",
  "name": "Seafood Boil",
  "recipe_type": "main",
  "brief_description": "This seafood boil recipe is made with shrimp, crab, corn, potatoes, and sausage boiled in one pot with seasoned water, perfect for outdoor gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large, 40-quart pot half full with water; bring water to a full boil."
    },
    {
      "position": 2,
      "text": "Add potatoes, sausage, shellfish boil seasoning, and salt. Cook until potatoes are halfway cooked."
    },
    {
      "position": 3,
      "text": "Stir in corn, lemons, and chile pepper; continue boiling until vegetables are tender. Turn off heat."
    },
    {
      "position": 4,
      "text": "Mix in shrimp and crab. Cover the pot and let sit until shrimp are pink and crabmeat is opaque and flaky, 10 to 15 minutes. Remove vegetables and shellfish from the pot; drain well. Serve immediately."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

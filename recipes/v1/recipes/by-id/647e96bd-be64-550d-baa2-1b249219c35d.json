  "id": "647e96bd-be64-550d-baa2-1b249219c35d",
  "slug": "best-ever-corn-muffins",
  "name": "Best Ever Corn Muffins",
  "recipe_type": "main",
  "brief_description": "This recipe was handed down to me from my mother. It's easy to make and the ingredients are probably already in your kitchen. Enjoy!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Stir in the eggs one at a time, beating well with each addition, then stir in the vanilla."
    },
    {
      "position": 3,
      "text": "In a separate bowl, stir together baking mix and cornmeal. Blend this mixture into the butter/egg mixture, alternately with the milk; stir just until combined. Spoon batter into prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 20 to 30 minutes, until golden."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 8,
  "rest_time_minutes": null,

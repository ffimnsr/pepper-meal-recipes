  "id": "f2558486-7298-51d2-b86d-67bccb237b7e",
  "slug": "honey-peanut-granola",
  "name": "Honey Peanut Granola",
  "recipe_type": "dessert",
  "brief_description": "This sweet, crunchy homemade granola combines quick oats with peanuts, wheat germ, honey, brown sugar, and vanilla. Baked in the oven, it's easy to make.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 250 degrees F (120 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine oats, peanuts, and wheat germ."
    },
    {
      "position": 3,
      "text": "In a separate bowl, combine honey, brown sugar, vegetable oil, water, salt, and vanilla. Stir well; then pour into the oat mixture, and stir. Spread out on a cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake for 1 hour, stirring every 15 minutes. Remove from oven, and cool before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

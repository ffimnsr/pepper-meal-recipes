  "id": "e932e255-5987-53a4-b402-23f66f6b5aff",
  "slug": "honey-garlic-pork-tenderloin-recipe-8786645",
  "name": "Honey Garlic Pork Tenderloin",
  "recipe_type": "dessert",
  "brief_description": "This honey garlic pork tenderloin, delicious and perfectly cooked, begins with a Chinese five spice-based rub, and bakes while you make the sweet-savory honey garlic sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 10x15-inch baking pan with a wire rack."
    },
    {
      "position": 3,
      "text": "Trim silver skin and excess fat from the pork tenderloin."
    },
    {
      "position": 4,
      "text": "Combine brown sugar, salt, Chinese five spice powder, garlic powder, onion powder and black pepper in a small bowl."
    },
    {
      "position": 5,
      "text": "Sprinkle tenderloin all over with spice mixture, rubbing to coat."
    },
    {
      "position": 6,
      "text": "Heat oil in a 12-inch skillet over medium-high heat. Sear tenderloin until browned on all sides, 8 to 10 minutes. Place tenderloin on the rack in the prepared pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted near the center reads 140 degrees F (61 degrees C), 20 to 25 minutes."
    },
    {
      "position": 8,
      "text": "Remove from oven, tent with foil, and let rest 10 minutes. Internal temperature will rise to 145 degrees F (63 degrees C) or higher."
    },
    {
      "position": 9,
      "text": "Meanwhile for sauce, heat honey, soy sauce, vinegar and garlic in the same skillet. Simmer until liquid reduces and thickens, about 5 minutes."
    },
    {
      "position": 10,
      "text": "Slice pork and serve with warm sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,
  "difficulty": "hard",

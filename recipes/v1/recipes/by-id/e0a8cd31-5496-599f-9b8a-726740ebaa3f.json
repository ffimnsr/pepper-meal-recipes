  "id": "e0a8cd31-5496-599f-9b8a-726740ebaa3f",
  "slug": "campfire-apple-pie",
  "name": "Campfire Apple Pie",
  "recipe_type": "dessert",
  "brief_description": "White bread, butter, and apple pie filling (or any of your choice) make a campfire classic in this easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a cast iron pie cooker with nonstick cooking spray. Evenly spread one side of each slice of bread with softened butter. Lay a slice of bread, butter side down, into the cooker. Spoon on pie filling, and top with second slice of bread, butter side up."
    },
    {
      "position": 2,
      "text": "Close up cooker, and cook over a hot campfire, turning occasionally, until the pie is hot and golden brown, about 4 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,

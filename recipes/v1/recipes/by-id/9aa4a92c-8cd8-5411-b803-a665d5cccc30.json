  "slug": "tomato-and-bocconcini-salad",
  "name": "Tomato and Bocconcini Salad",
  "recipe_type": "salad",
  "brief_description": "This tomato and bocconcini salad recipe includes small bocconcini cheese balls, spinach, arugula, oil, and balsamic vinegar in this updated caprese salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine olive oil, vinegar, garlic, salt, and black pepper in a jar with a lid; set aside."
    },
    {
      "position": 2,
      "text": "Combine spinach, arugula, tomatoes, bocconcini cheese, and onion in a salad bowl. Shake vinaigrette vigorously to combine; drizzle over salad to serve."
    }
  ],
  "servings": 6,

  "id": "0286ad3a-1146-5f7f-9a84-5667c2fdc629",
  "slug": "easy-tiktok-pizza-appetizer-recipe-8660871",
  "name": "This Easy TikTok Pizza Is the 3-Ingredient Recipe of Our Dreams",
  "recipe_type": "appetizer",
  "brief_description": "Get the recipe for the viral, thee-ingredient pizza appetizer that's made incredibly easy with store-bought pizza dough, fresh tomatoes, and basil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C) with a rack in the center position. Lightly oil a 13- by 18-inch rimmed baking sheet."
    },
    {
      "position": 2,
      "text": "Thinly slice tomatoes and place them on a paper towel-lined plate. Pat the tops of the tomatoes dry."
    },
    {
      "position": 3,
      "text": "Gently stretch and press pizza dough to each corner of the rimmed baking sheet. Drizzle with oil, then season all over with salt, pepper, and oregano (or Italian seasoning)."
    },
    {
      "position": 4,
      "text": "Cover the pizza dough with sliced tomatoes (they should touch). Bake pizza until the crust is golden brown and the tomatoes look roasted, 22 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Let cool slightly, then transfer to a cutting board and cut into small squares. Sprinkle with a pinch of salt and garnish with fresh basil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 22,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

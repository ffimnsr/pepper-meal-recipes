  "id": "fcb403a2-e33a-5898-b5b4-ab994729cc04",
  "slug": "easy-salisbury-steak",
  "name": "Easy Salisbury Steak",
  "recipe_type": "soup",
  "brief_description": "These easy Salisbury steaks are made with ground beef, oats, ketchup, and minced dried onion and are topped with cream of mushroom soup and onion rings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix ground beef, oats, egg, Worcestershire sauce, ketchup, water, dried minced onion, salt, and pepper in a bowl until evenly combined; shape into 6 oval-shaped patties."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium heat. Cook patties in hot skillet until browned completely, 2 minutes per side. Transfer browned patties to a baking dish."
    },
    {
      "position": 4,
      "text": "Top patties with onion rings. Stir mushroom soup and milk together in a bowl; pour over patties. Cover baking dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until firm, hot, and grey in the center, about 45 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

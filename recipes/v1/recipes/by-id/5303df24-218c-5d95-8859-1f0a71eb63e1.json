  "slug": "graham-cracker-crust-i",
  "name": "Graham Cracker Crust",
  "recipe_type": "dessert",
  "brief_description": "This graham cracker crust is made in minutes with crushed graham crackers, sugar, and butter\u2014perfect for homemade cheesecakes and no-bake desserts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine graham cracker crumbs, sugar, melted butter, and cinnamon in a mixing bowl; mix until well blended."
    },
    {
      "position": 3,
      "text": "Press mixture into the bottom and up the sides of a 9-inch pie plate."
    },
    {
      "position": 4,
      "text": "Follow directions for a baked or no-bake crust."
    }
  ],
  "servings": 8,

  "id": "3e2fdac4-1766-5623-b20a-5a1f51758418",
  "slug": "baked-teriyaki-chicken",
  "name": "Baked Teriyaki Chicken",
  "recipe_type": "main",
  "brief_description": "This teriyaki chicken recipe uses a homemade teriyaki sauce to glaze chicken thighs that are baked in the oven for the most delicious sticky chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine sugar, soy sauce, vinegar, cornstarch, cold water, garlic, ginger, and black pepper in a small saucepan over low heat; simmer, stirring frequently, until teriyaki sauce thickens and bubbles, 3 to 5 minutes. Remove from the heat."
    },
    {
      "position": 3,
      "text": "Place chicken thighs in the prepared baking dish; brush both sides of each thigh with teriyaki sauce. Reserve any extra sauce for basting."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes."
    },
    {
      "position": 5,
      "text": "Flip chicken; brush with sauce. Continue baking, basting with remaining sauce every 10 minutes, until no longer pink and juices run clear, 20 to 30 minutes more."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a5f16dca-048b-5d13-a055-67e07211d8fb",
  "slug": "baked-gnocchi",
  "name": "Baked Gnocchi",
  "recipe_type": "main",
  "brief_description": "This easy baked gnocchi recipe is the perfect choice when you're cooking for one--it's got just 3 ingredients and will be on the table for you to enjoy in no time.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, about 3 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Spread 1/2 of the pasta sauce on the bottom of a 5-inch round casserole dish. Layer with gnocchi and spread the remaining pasta sauce on top. Sprinkle with mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 25 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

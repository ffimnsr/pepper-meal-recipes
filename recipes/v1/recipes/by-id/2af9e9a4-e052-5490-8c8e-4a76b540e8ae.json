{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2af9e9a4-e052-5490-8c8e-4a76b540e8ae",
  "slug": "rhubarb-strawberry-and-blueberry-cobblerette",
  "name": "Rhubarb, Strawberry, and Blueberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This rich cobbler made with rhubarb, strawberries, and blueberries is topped with an easy cinnamon batter for a fruity sweet-tart dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Butter a 2 \u00bd-quart baking dish."
    },
    {
      "position": 2,
      "text": "Stir rhubarb, blueberries, strawberries, lemon juice, pearl tapioca, and 1 cup raw sugar in a bowl. Transfer to prepared baking dish."
    },
    {
      "position": 3,
      "text": "Place butter into a separate bowl and chop into small pieces with a pastry cutter. Cut in flour, 2 tablespoons raw sugar, salt, and cinnamon; stir in water, 1 tablespoon at a time, until the dough holds together. Drop small pieces of the dough on the fruit."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the filling is bubbly and the cobbler is lightly browned, 40 to 50 minutes. Allow to stand 10 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

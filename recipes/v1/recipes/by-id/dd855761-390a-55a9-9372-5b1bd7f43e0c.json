  "id": "dd855761-390a-55a9-9372-5b1bd7f43e0c",
  "slug": "creme-patissiere-recipe-7486405",
  "name": "Creme Patissiere (Vanilla Pastry Cream)",
  "recipe_type": "dessert",
  "brief_description": "Cr\u00e8me p\u00e2tissi\u00e8re is a rich vanilla pastry cream made with egg yolks thickened with cornstarch to make a silky, sturdy filling perfect for French pastries.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1/3 of the cold milk and cornstarch together in a medium bowl until smooth."
    },
    {
      "position": 2,
      "text": "Pour remaining milk and sugar into a small saucepan. Heat over medium heat, stirring occasionally, until milk begins to simmer; remove from heat and set aside."
    },
    {
      "position": 3,
      "text": "Stir egg and egg yolks into cornstarch mixture; gradually whisk in hot milk. Pour mixture back into the small saucepan; cook over medium-low heat, whisking constantly, until thickened and mixture coats the back of a spoon, about 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Remove custard from heat; whisk in butter and vanilla until smooth."
    },
    {
      "position": 5,
      "text": "Transfer into a bowl and cover directly with plastic wrap to prevent a skin forming; allow to cool before using."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

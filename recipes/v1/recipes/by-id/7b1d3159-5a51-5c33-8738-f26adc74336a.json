  "id": "7b1d3159-5a51-5c33-8738-f26adc74336a",
  "slug": "mothers-potato-salad",
  "name": "Mother's Potato Salad",
  "recipe_type": "salad",
  "brief_description": "My mother's potato salad recipe, which includes olives, chopped sweet gherkins, and hard-cooked eggs, is chunky, sweet, tangy, and richly flavored.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil over high heat. Reduce heat to medium-low, cover, and simmer until tender, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Drain potatoes; steam dry 1 to 2 minutes. Cool, then peel and cut into cubes."
    },
    {
      "position": 3,
      "text": "Place eggs in a saucepan in a single layer; cover with water by 1 inch. Cover the saucepan; bring to a boil over high heat, then remove from heat, and let eggs stand in hot water for 15 minutes."
    },
    {
      "position": 4,
      "text": "Remove eggs from hot water; cool under cold running water. Peel and slice eggs; reserve 1 attractive slice for garnish."
    },
    {
      "position": 5,
      "text": "Combine mayonnaise and mustard in a bowl. Combine potatoes, eggs, olives, gherkins, celery, and onion in a separate large bowl; add mayonnaise mixture and gently toss until ingredients coated. Season with salt."
    },
    {
      "position": 6,
      "text": "Top salad with bell pepper slices; place reserved egg slice in the center. Chill until ready to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

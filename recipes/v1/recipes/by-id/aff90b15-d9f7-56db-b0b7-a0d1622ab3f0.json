  "id": "aff90b15-d9f7-56db-b0b7-a0d1622ab3f0",
  "slug": "red-velvet-cupcakes",
  "name": "Red Velvet Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "These red velvet cupcakes are soft, moist, and buttery. They're topped with a homemade tangy vanilla cream cheese frosting for a gorgeous sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C). Line 30 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Make cake: Mix together flour, cocoa powder, baking soda, and salt in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar and butter in a large bowl with an electric mixer on medium speed until light and fluffy, about 5 minutes. Beat in eggs, one at a time."
    },
    {
      "position": 4,
      "text": "Mix in sour cream, milk, food color, and vanilla."
    },
    {
      "position": 5,
      "text": "Gradually beat in flour mixture on low speed until just blended; do not over-beat. Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into a cupcake comes out clean, about 20 minutes. Cool in the pans on a wire rack for 5 minutes. Remove cupcakes from the pans; cool completely."
    },
    {
      "position": 7,
      "text": "While cupcakes are cooling, make frosting: Beat cream cheese, butter, sour cream, and vanilla extract in a large bowl until light and fluffy. Gradually beat in confectioners' sugar until smooth."
    },
    {
      "position": 8,
      "text": "Spread or pipe frosting onto cooled cupcakes."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

  "id": "f50ea9d9-a137-5311-8336-144d763334f3",
  "slug": "air-fryer-shortbread-cookie-fries",
  "name": "Air Fryer Shortbread Cookie Fries",
  "recipe_type": "dessert",
  "brief_description": "Cut cookie dough into shortbread 'fries' for a fun air fryer sweet treat served with strawberry-chipotle 'ketchup' and lemon curd 'mustard.'",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour and sugar in a medium bowl. Cut in butter with a pastry blender until mixture resembles fine crumbs and starts to cling. Form the mixture into a ball and knead until smooth."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 350 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Roll dough to 1/4-inch thickness on a lightly floured surface. Cut into 1/2-inch-wide \"fries\" about 3- to 4-inch long. Sprinkle with additional sugar."
    },
    {
      "position": 4,
      "text": "Arrange fries in a single layer in the air fryer basket. Cook until lightly browned, 3 to 4 minutes. Let cool in the basket until firm enough to transfer to a wire rack to cool completely. Repeat with remaining dough."
    },
    {
      "position": 5,
      "text": "To make strawberry \"ketchup,\" press jam through a fine mesh sieve using the back of a spoon. Stir in ground chipotle. Whip the lemon curd to make it a dippable consistency for the \"mustard.\""
    },
    {
      "position": 6,
      "text": "Serve sugar cookie fries with the strawberry ketchup and lemon curd mustard."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

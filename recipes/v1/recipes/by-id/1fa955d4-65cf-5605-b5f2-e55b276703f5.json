  "id": "1fa955d4-65cf-5605-b5f2-e55b276703f5",
  "slug": "mexican-chicken-corn-chowder",
  "name": "Mexican Chicken Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This creamy chicken and corn chowder, made spicy with ground cumin, green chilies, and hot pepper sauce, will warm you right through. Shredded Monterey jack cheese and half and half make this soup rich and delicious.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "In a Dutch oven, brown chicken, onion, and garlic in butter until chicken is no longer pink."
    },
    {
      "position": 2,
      "text": "Dissolve the bouillon in hot water; Pour into Dutch oven, and season with cumin. Bring to a boil. Reduce heat to low, cover, and simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in cream, cheese, corn, chilies, and hot pepper sauce. Cook, stirring frequently, until the cheese is melted. Stir in chopped tomato. Garnish with cilantro."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

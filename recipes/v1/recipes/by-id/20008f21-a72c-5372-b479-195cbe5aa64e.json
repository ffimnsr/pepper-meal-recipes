  "id": "20008f21-a72c-5372-b479-195cbe5aa64e",
  "slug": "ham-egg-and-cheese-quesadillas",
  "name": "Ham, Egg, and Cheese Quesadillas",
  "recipe_type": "breakfast",
  "brief_description": "A delightful alternative to breakfast burritos, these quesadillas consist of a satisfyingly crunchy crust filled with flavor-packed protein.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together eggs, water, salt, and pepper in a medium bowl until well blended."
    },
    {
      "position": 2,
      "text": "Melt 1 tablespoon butter in a medium nonstick skillet over medium heat. Cook eggs, stirring frequently, until scrambled to desired consistency. Transfer to a bowl and set aside."
    },
    {
      "position": 3,
      "text": "Spread 1 teaspoon butter over 1 tortilla and place butter-side down in the same skillet over medium heat. Sprinkle 1/3 cup cheese over entire tortilla. Add 1/2 cup scrambled egg and 1/3 cup ham to one half. Cook until cheese is melted, about 3 minutes. Fold cheese side over egg-ham filling, then flip quesadilla. Cook until golden and toasted, about 2 more minutes. Cut into 2 or 3 pieces. Repeat this step to make 5 more quesadillas."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

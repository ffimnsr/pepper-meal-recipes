  "id": "c2806fc4-d256-5ce0-be07-7a50351d138e",
  "slug": "bbq-country-style-pork-ribs-sous-vide",
  "name": "BBQ Country-Style Pork Ribs - Sous Vide",
  "recipe_type": "main",
  "brief_description": "Slow cooked with a sous vide and then finished in the oven with a coat of barbeque sauce, these country-style pork ribs are easy and tasty.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix salt and sugar together in a small bowl. Sprinkle all over ribs. Coat with red pepper flakes, five-spice powder, and black pepper. Slide ribs into a large vacuum-seal bag; pour in liquid smoke. Seal."
    },
    {
      "position": 2,
      "text": "Immerse bag in a heat-proof container of water with a sous vide cooker. Set temperature to 140 degrees F (60 degrees C); cook for 8 hours."
    },
    {
      "position": 3,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Set oven rack about 6 inches from the heat source and turn on the broiler. Place a wire rack on top of a baking sheet."
    },
    {
      "position": 4,
      "text": "Pull ribs out of the bag; spread onto the prepared baking sheet and brush with barbeque sauce."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly, 4 to 5 minutes. Flip and continue baking until other side bubbles, 2 to 3 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 482,
  "preparation_time_minutes": 10,

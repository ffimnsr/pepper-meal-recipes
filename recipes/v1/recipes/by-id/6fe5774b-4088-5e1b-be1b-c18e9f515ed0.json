  "id": "6fe5774b-4088-5e1b-be1b-c18e9f515ed0",
  "slug": "fabulous-beef-tenderloin",
  "name": "Fabulous Beef Tenderloin",
  "recipe_type": "main",
  "brief_description": "This tenderloin will melt in your mouth and wow your guests. Simple to prepare with just 3 ingredients: beef tenderloin roast, soy sauce, and butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place roast into a shallow, glass baking dish. Pour soy sauce and melted butter over the tenderloin."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 10 minutes, then turn roast over and continue cooking, basting occasionally until the internal temperature of the roast reaches 140 degrees F (60 degrees C) for medium, 35 to 40 minutes (or cook to desired degree of doneness)."
    },
    {
      "position": 4,
      "text": "Let meat rest for 10 to 15 minutes before slicing."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

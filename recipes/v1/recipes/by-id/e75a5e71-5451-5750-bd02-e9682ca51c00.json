  "id": "e75a5e71-5451-5750-bd02-e9682ca51c00",
  "slug": "easy-pork-tacos-with-pineapple-salsa-recipe-11750027",
  "name": "Easy Pork Tacos with Pineapple Salsa",
  "recipe_type": "main",
  "brief_description": "These easy pork tacos with pineapple salsa feature well-seasoned ground pork with black beans and a quick fresh pineapple salsa. Serve on flour tortillas with an optional topping of shredded cabbage.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pineapple, red onion, cilantro, jalapeno, lime juice, olive oil, and 1/4 teaspoon salt in a bowl and stir well, set aside."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Add pork and press to flatten. Cook, undisturbed, about 4 minutes or until browned. Flip and continue to cook, crumbling with a spoon until no longer pink. Season with remaining salt, chili powder, cumin, onion powder, and black pepper and cook 1 minute, stirring constantly."
    },
    {
      "position": 3,
      "text": "Stir in tomatoes and beans and bring to a simmer. Cook 5 minutes, stirring occasionally; remove from heat."
    },
    {
      "position": 4,
      "text": "Heat tortillas as desired. Divide pork mixture evenly among the tortillas and top with pineapple salsa and shredded cabbage if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "63e4ae23-b07a-524c-95bf-f8f4a26b4959",
  "slug": "sweet-barbeque-beans",
  "name": "Sweet Barbeque Beans",
  "recipe_type": "dessert",
  "brief_description": "Sweet barbecue beans packed with smoky bacon and ground beef deliver a rich, hearty flavor. These beans are irresistibly delicious \u2014 pure comfort food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large skillet until crisp. Drain on paper towels; set aside. Crumble ground beef into the skillet; cook and stir until no longer pink. Drain off grease. Transfer ground beef and bacon to a slow cooker; stir to combine."
    },
    {
      "position": 2,
      "text": "Stir in baked beans, navy beans, kidney beans, ketchup, brown sugar, vinegar, honey garlic sauce, sweet and sour sauce, onion powder, garlic salt, ground mustard, and Worcestershire sauce until combined."
    },
    {
      "position": 3,
      "text": "Cover slow cooker. Cook on High for 1 hour."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

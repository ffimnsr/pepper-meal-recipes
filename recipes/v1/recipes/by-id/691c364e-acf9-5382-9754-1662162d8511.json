  "id": "691c364e-acf9-5382-9754-1662162d8511",
  "slug": "summer-fresh-strawberry-pie",
  "name": "Summer Fresh Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "An easy summer fresh strawberry pie recipe made with fresh strawberries takes little time to prep to create a perfect sweet dessert for entertaining.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine white sugar, cornstarch, and salt in a medium saucepan; stir in 3 tablespoons water until becomes a paste."
    },
    {
      "position": 2,
      "text": "Bring remaining water to a boil in a pot over medium-high heat; slowly add to sugar mixture. Reduce heat to low; simmer, stirring constantly, until thick and clear, about 5 minutes. Off heat, stir in lemon juice, almond extract, and food coloring. Cool for at least 15 minutes. Fold in strawberries."
    },
    {
      "position": 3,
      "text": "Pour strawberry filling into pie crust. Chill in the refrigerator, at least 1 hour."
    },
    {
      "position": 4,
      "text": "Beat heavy cream in a large bowl with an electric mixer; slowly add confectioners' sugar until combined. Spread whipped cream over chilled pie."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

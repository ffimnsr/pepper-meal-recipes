  "slug": "shrimp-gazpacho",
  "name": "Shrimp Gazpacho",
  "recipe_type": "soup",
  "brief_description": "This shrimp gazpacho recipe is so easy and uses unique ingredients like tomato-clam juice cocktail, avocado, and seafood for a refreshing summer soup.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomato and clam juice cocktail, shrimp, avocados, tomatoes, cucumbers, onion, cilantro, lemon juice, salt, and pepper together in a large bowl."
    },
    {
      "position": 2,
      "text": "Cover the bowl with plastic and refrigerate until ready to serve."
    }
  ],

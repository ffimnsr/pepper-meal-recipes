{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2bd52804-c83c-5369-a389-031e60346d62",
  "slug": "vegan-apple-pie",
  "name": "Vegan Apple Pie",
  "recipe_type": "dessert",
  "brief_description": "This vegan apple pie has a flaky crust made with dairy-free margarine and a towering pile of caramel apples. A vegan version of the classic pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 2 1/3 cups all-purpose flour, 1 cup vegan margarine, 1 tablespoon white sugar, and salt in a food processor; pulse until mixture clumps together. Pour water in slowly and pulse a few times until a dough forms."
    },
    {
      "position": 2,
      "text": "Transfer dough to a flat work surface; knead for 30 seconds and shape into a disk. Wrap with plastic wrap and refrigerate until firm, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "Dust a flat work surface with flour. Roll dough out into two 10-inch crusts. Press 1 crust gently into a 9-inch pie plate."
    },
    {
      "position": 5,
      "text": "Combine brown sugar, 1/2 cup vegan margarine, 1/4 cup white sugar, rice milk, 3 tablespoons flour, cinnamon, and nutmeg in a saucepan; cook and stir over medium heat until margarine melts and brown sugar is dissolved, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Place apple slices in a large bowl. Pour brown sugar mixture on top; mix until apples are evenly coated. Pile apples into the bottom crust. Cover with second crust. Cut slits in the top crust with a sharp knife."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until crust is golden brown and apples are semitranslucent, 45 to 60 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "488fea4b-eafb-5abc-bd9c-a3702ac5568e",
  "slug": "keto-breakfast-frittata",
  "name": "Keto Breakfast Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This keto frittata is dressed up with lots of low-carb vegetables including bell peppers, spinach, and mushrooms for great flavor and texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Crumble sausage into a 12-inch nonstick, oven-proof skillet over medium heat. Cook until browned, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, whisk eggs in a large bowl. Add cream and hot pepper sauce; mix well."
    },
    {
      "position": 4,
      "text": "Add butter to the skillet with browned sausage and melt around the inside rim of the skillet. Add mushrooms, red bell pepper, onion, salt, and pepper. Cook until onion is soft and translucent, about 4 minutes. Turn off heat and stir in spinach. Cook for 1 minute in the hot skillet, then sprinkle with Cheddar cheese. Pour egg mixture on top, making sure all ingredients are submerged."
    },
    {
      "position": 5,
      "text": "Place skillet in the preheated oven and bake until eggs are set and no longer jiggle, about 20 minutes. Remove from oven and allow to sit for 1 to 2 minutes before cutting into serving pieces."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

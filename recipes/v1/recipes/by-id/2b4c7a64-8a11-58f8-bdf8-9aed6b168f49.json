  "id": "2b4c7a64-8a11-58f8-bdf8-9aed6b168f49",
  "slug": "mediterranean-chicken-with-eggplant",
  "name": "Mediterranean Chicken with Eggplant",
  "recipe_type": "main",
  "brief_description": "I've learned to make this dish from my grandmother who still lives on the shore of the Mediterranean.",
  "cuisine": "European",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggplant strips in a big pot of lightly salted water and soak for 30 minutes (this will improve the taste; they will leave a brown color in the pot)."
    },
    {
      "position": 2,
      "text": "Remove eggplant from pot and brush lightly with olive oil. Saute or grill until lightly browned and place in a 9x13 inch baking dish. Set aside."
    },
    {
      "position": 3,
      "text": "Saute diced chicken and onion in a large skillet over medium heat. Stir in tomato paste and water, cover skillet, reduce heat to low and simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 5,
      "text": "Pour chicken/tomato mixture over eggplant. Season with oregano, salt and pepper and cover with aluminum foil. Bake in the preheated oven for 20 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 50,
  "rest_time_minutes": null,

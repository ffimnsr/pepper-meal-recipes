{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c938ddb7-9fe9-54fe-8cdd-c0cd5d1a56ae",
  "slug": "duck-fesenjan",
  "name": "Duck Fesenjan",
  "recipe_type": "main",
  "brief_description": "Fesenjan (fesenjoon) is an amazing Persian stew that Chef John makes with duck legs, pomegranate molasses, and walnuts for his version of this classic favorite.",
  "cuisine": "Persian",
  "instructions": [
    {
      "position": 1,
      "text": "Season duck legs all over with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large skillet over high heat. Place duck legs, skin-side down, in hot oil and cook until browned, 2 to 5 minutes. Turn and cook until browned on the other side, 2 to 4 minutes. Transfer legs to a plate; pour rendered duck fat into a bowl."
    },
    {
      "position": 3,
      "text": "Pour water into the skillet and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Place about 2 tablespoons duck fat into a Dutch oven; add olive oil and heat over medium heat until hot. Add onion and saut\u00e9 until golden brown, 7 to 10 minutes. Add turmeric, cinnamon, and nutmeg; cook and stir until fragrant, 1 minute."
    },
    {
      "position": 5,
      "text": "Pour chicken broth, pomegranate molasses, honey, and reserved water mixture from the skillet into the Dutch oven; bring to a simmer."
    },
    {
      "position": 6,
      "text": "Meanwhile, grind walnuts to a fine powder in a food processor."
    },
    {
      "position": 7,
      "text": "Cook and stir ground walnuts in a dry skillet over medium heat until fragrant, 2 to 3 minutes; stir into broth mixture."
    },
    {
      "position": 8,
      "text": "Place duck legs into broth and press gently to submerge. Reduce the heat and simmer until duck legs are no longer pink at the bone and the juices run clear, 3 to 4 hours. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 9,
      "text": "Bring broth to a boil; cook until reduced and desired sauce consistency is reached. Season with salt. Ladle sauce over duck legs to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 220,
  "preparation_time_minutes": 10,

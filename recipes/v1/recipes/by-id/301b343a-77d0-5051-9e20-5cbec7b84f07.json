  "slug": "caper-pesto-recipe-8741129",
  "name": "Caper Pesto",
  "recipe_type": "side",
  "brief_description": "This fresh, herby pesto combines basil, dill, and capers with a bright twist of lemon and Parmesan for a zesty, aromatic spread. Perfect for pasta, sandwiches, or as a dip, this pesto puts a briny twist on a timeless Italian sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Process basil, Parmesan, oil, pine nuts, green onions, dill, capers, juice, zest, garlic, salt, and pepper in a food processor until nearly smooth."
    },
    {
      "position": 3,
      "text": "Chill in an airtight container up to 1 week; freeze up to 3 months."
    }
  ],
  "servings": 12,

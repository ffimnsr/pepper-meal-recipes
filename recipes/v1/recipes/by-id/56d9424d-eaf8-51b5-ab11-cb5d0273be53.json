  "id": "56d9424d-eaf8-51b5-ab11-cb5d0273be53",
  "slug": "scottish-shortbread-iv",
  "name": "Scottish Shortbread",
  "recipe_type": "dessert",
  "brief_description": "Shortbread is a classic Scottish cookie that's easy to make with real butter for a crumbly, melt-in-your-mouth texture and irresistible buttery flavor.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Beat butter and brown sugar together until smooth and creamy."
    },
    {
      "position": 4,
      "text": "Add 3 to 3 3/4 cups flour; mix well."
    },
    {
      "position": 5,
      "text": "Sprinkle board with remaining flour. Knead for 5 minutes, adding enough flour to make a soft dough."
    },
    {
      "position": 6,
      "text": "Roll out dough to 1/2-inch thickness. Cut into 3x1-inch strips."
    },
    {
      "position": 7,
      "text": "Prick shortbread cookies with a fork and place on ungreased baking sheets."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until edges are golden brown, 20 to 25 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

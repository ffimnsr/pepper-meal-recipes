  "id": "08f86a93-5869-53fe-a9dc-423540cdc4ff",
  "slug": "peach-quinoa-salad-recipe-8699665",
  "name": "Peach Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "This peach quinoa salad is a lively version of spinach salad, using fresh summer peaches, quinoa, pecans, feta cheese, and a simple honey-Dijon vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place quinoa in a fine mesh strainer and rinse under cold water. Drain."
    },
    {
      "position": 2,
      "text": "Bring broth to a boil over medium heat in a saucepan. Add quinoa, cover, and reduce heat to low. Simmer until the liquid is absorbed and quinoa is tender, about 15 minutes. Remove from heat and let stand, covered, about 5 minutes. Fluff with a fork and allow to cool to room temperature, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, combine spinach, bell pepper, pecans, and drained red onion slices in a salad bowl."
    },
    {
      "position": 4,
      "text": "In a small bowl, toss peach slices with orange juice (to slow oxidation) and add to the salad bowl."
    },
    {
      "position": 5,
      "text": "For dressing, combine olive oil, balsamic vinegar, Dijon mustard, honey, and salt and pepper in a small container or jar with a lid. Place the lid on the container and shake until ingredients are well blended."
    },
    {
      "position": 6,
      "text": "Add quinoa to the salad ingredients, pour dressing over, and gently toss to combine. Garnish with feta crumbles and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "ba53b8b6-c8fd-52e9-ac1b-b44f89df7ca7",
  "slug": "easy-breeze-sugar-cookies",
  "name": "Easy Breeze Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "Almondmilk helps these tender sugar cookies come together in no time! Customize them for any event by sprinkling with colored decorator sugar or sprinkles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 375 degrees F. Line cookie sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "In large bowl, beat 1 cup shortening, 1 1/2 cups granulated sugar, egg, and vanilla with electric mixer on medium speed until creamy, scraping sides of bowl if necessary. Add flour, baking soda, baking powder, and cream of tartar. Mix on low speed until well mixed. Add 2 tablespoons of the Almondmilk and beat until smooth."
    },
    {
      "position": 3,
      "text": "Form into 1 1/4-inch balls, using rounded tablespoonfuls of dough. Place 2 inches apart on cookie sheets. Place 3 to 4 tablespoons granulated sugar in small bowl. Spray flat bottom of measuring cup or drinking glass with cooking spray; dip in sugar. Press each cookie flat, dipping into sugar every other time."
    },
    {
      "position": 4,
      "text": "If desired, lightly brush tops of cookies with remaining Almondmilk and sprinkle with colored decorator sugar or sprinkles, or leave plain and frost when cooled."
    },
    {
      "position": 5,
      "text": "Bake 8 to 10 minutes or until edges start to brown. Cool on cookie sheets 2 minutes. Remove to cooling racks."
    },
    {
      "position": 6,
      "text": "In large bowl, beat powdered sugar, 3/4 cup shortening, vanilla, and 3 tablespoons of the Almondmilk with electric mixer on low speed until moistened. Beat on medium-high speed until smooth and creamy, adding Almondmilk for desired spreading consistency. Tint as desired with food coloring."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

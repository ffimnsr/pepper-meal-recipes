  "id": "311b80cb-4ecf-589c-9838-0891a6ea1d28",
  "slug": "toasted-coconut-pecan-and-caramel-pie",
  "name": "Toasted Coconut, Pecan, and Caramel Pie",
  "recipe_type": "dessert",
  "brief_description": "The filling for this decadent pie is a combination of a very creamy, cream cheese and whipped topping. Then toasted coconut and caramel sauce is sprinkled and drizzled over it. Another cream cheese layer is spooned on, and then the pie is finished with more toasted coconut. This recipe makes two fantastic pies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium skillet, melt butter or margarine over medium heat. Add coconut and pecans. Toss well, and saute until coconut is lightly browned. Set aside to cool."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl, beat cream cheese until fluffy. Add condensed milk and mix until smooth. Fold in whipped topping. Spread 1/4 of cream cheese mixture into each pastry shell. Sprinkle 1/4 of coconut mixture over each pie. Drizzle 1/2 of caramel topping over each coconut layer. Follow with remaining cream cheese mixture, then remaining coconut mixture."
    },
    {
      "position": 3,
      "text": "Pies may be served chilled or frozen."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "88b789ec-2537-5312-ae04-8ab0c3765fa0",
  "slug": "french-canadian-tourtiere",
  "name": "French Canadian Tourti\u00e8re",
  "recipe_type": "main",
  "brief_description": "French Canadian tourti\u00e8re is a double-crusted meat pie with savory pork, beef, onion, and spice filling, perfect for a festive holiday gathering.",
  "cuisine": "French Canadian American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pork, beef, onion, garlic, water, salt, thyme, sage, black pepper, and cloves in a saucepan. Cook, stirring occasionally, over medium heat until mixture boils. Reduce heat to low and simmer until meat is cooked, about 5 minutes. Allow to cool to room temperature."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Spoon meat mixture into pie crust. Cover with top crust and pinch edges to seal. Cut slits in top crust so steam can escape. Cover edges of pie with strips of aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes; remove foil and return to the oven. Bake until golden brown, 15 to 20 minutes. Let cool 10 minutes before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

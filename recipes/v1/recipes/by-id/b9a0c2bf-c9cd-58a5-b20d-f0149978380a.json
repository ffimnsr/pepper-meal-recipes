  "id": "b9a0c2bf-c9cd-58a5-b20d-f0149978380a",
  "slug": "peanut-butter-bread-recipe-11898055",
  "name": "Peanut Butter Bread",
  "recipe_type": "breakfast",
  "brief_description": "This tender peanut butter bread is peanut butter forward, but not overpowering. It has a nutty flavor and a soft bread texture, and served with jam, it tastes like a PB & J.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line an 8x4-inch loaf pan with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together flour, sugar, baking powder, salt, and baking soda in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk together milk, 3/4 cup peanut butter, eggs, and honey in a bowl until well combined (some flecks of peanut butter are fine)."
    },
    {
      "position": 4,
      "text": "Pour milk mixture into flour mixture and stir just until combined. Pour batter into the prepared loaf pan."
    },
    {
      "position": 5,
      "text": "Place remaining 2 tablespoons peanut butter in a small heatproof bowl. Microwave on High until just melted, about 20 seconds."
    },
    {
      "position": 6,
      "text": "Drizzle melted peanut butter over the batter. Using a small knife or toothpick, gently swirl the peanut butter into the batter."
    },
    {
      "position": 7,
      "text": "Bake until a toothpick inserted into the center comes out mostly clean, 50 to 60 minutes. Tent with foil for the last 10 minutes to prevent overbrowning. Cool in the pan for 10 minutes, then transfer to a wire rack to cool completely, about 1 hour."
    },
    {
      "position": 8,
      "text": "Serve slices with jelly. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

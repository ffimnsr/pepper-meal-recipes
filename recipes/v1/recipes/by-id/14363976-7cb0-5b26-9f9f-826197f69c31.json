  "slug": "greek-yogurt-oatmeal",
  "name": "Greek Yogurt Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Greek yogurt oatmeal with bananas, strawberry jam, and peanut butter is quick and easy to prepare in the microwave for busy weekday mornings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, banana, cinnamon, and salt in a microwave-safe bowl; add water and stir. Cook in microwave until water is absorbed, 2 to 3 minutes. Stir to evenly distribute cinnamon; let stand until slightly cooled, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Spoon Greek yogurt, strawberry jam, and peanut butter over oatmeal; stir."
    }
  ],

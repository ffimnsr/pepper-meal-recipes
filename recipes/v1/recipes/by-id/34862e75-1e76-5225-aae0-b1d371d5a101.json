  "id": "34862e75-1e76-5225-aae0-b1d371d5a101",
  "slug": "no-peek-meatball-alfredo-casserole-recipe-11842368",
  "name": "No-Peek Meatball Alfredo Casserole",
  "recipe_type": "main",
  "brief_description": "This tasty no-peek meatball Alfredo casserole is big on flavor with minimal effort. It\u2019s baked into one cozy, cheesy dish, with no boiling, no fuss\u2014just comfort in a dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Add uncooked pasta, frozen meatballs, broccoli, mushrooms, Alfredo sauce, and half-and-half to the dish. Season with a bit of Italian seasoning. Stir gently until everything is coated and mostly submerged. Cover tightly with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until pasta is nearly tender, about 35 minutes. Uncover, stir, and top with mozzarella and Parmesan."
    },
    {
      "position": 4,
      "text": "Bake uncovered until cheese is melted and bubbly and pasta is fully cooked, about 10 minutes more. Let rest 5 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 5,
  "difficulty": "medium",

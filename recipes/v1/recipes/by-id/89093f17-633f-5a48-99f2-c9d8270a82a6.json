  "id": "89093f17-633f-5a48-99f2-c9d8270a82a6",
  "slug": "instant-pot-guinness-corned-beef",
  "name": "Instant Pot Guinness Corned Beef",
  "recipe_type": "main",
  "brief_description": "Corned beef in Guinness is cooked quickly and easily in an Instant Pot pressure cooker with potatoes, carrots, and cabbage for one delicious dinner.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, beer, and garlic in a multi-functional pressure cooker (such as Instant Pot). Place trivet inside."
    },
    {
      "position": 2,
      "text": "Rub all sides of brisket with brown sugar. Place on the trivet and sprinkle spice packet on top. Close and lock the lid."
    },
    {
      "position": 3,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 90 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Transfer brisket to a baking sheet."
    },
    {
      "position": 5,
      "text": "Cover brisket with aluminum foil; let rest for 15 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, remove the trivet from the pot. Place potatoes, carrots, onion, and cabbage in the bottom of the pressure cooker. Close and lock the lid."
    },
    {
      "position": 7,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 8,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Serve vegetables with rested brisket."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 115,
  "preparation_time_minutes": 30,

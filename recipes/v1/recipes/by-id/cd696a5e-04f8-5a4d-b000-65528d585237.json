  "id": "cd696a5e-04f8-5a4d-b000-65528d585237",
  "slug": "maryland-crab-cakes-iii",
  "name": "Maryland Crab Cakes III",
  "recipe_type": "appetizer",
  "brief_description": "Spicy crab cakes made with onion, celery, and brown mustard. Broiled to a golden brown.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven on broiler setting. Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together crushed saltine crackers, mayonnaise, brown mustard, onion, celery, and Old Bay seasoning. Gently stir in the crabmeat. Shape into 6 patties. Place on prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Broil crab cakes 8 to 10 minutes on each side, or until golden brown."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

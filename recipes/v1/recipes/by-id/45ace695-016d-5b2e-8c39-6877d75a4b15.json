  "id": "45ace695-016d-5b2e-8c39-6877d75a4b15",
  "slug": "2-ingredient-mini-pumpkin-muffins-recipe-12067992",
  "name": "2-Ingredient Mini Pumpkin Muffins",
  "recipe_type": "appetizer",
  "brief_description": "These mini pumpkin muffins are made in the air fryer and are beyond easy. Two ingredients\u2014boxed spice cake mix and a can of pumpkin puree\u2014and about 15 minutes are all you need for delicious, bite-sized treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cake mix and pumpkin puree together in a large bowl."
    },
    {
      "position": 2,
      "text": "Grease a silicone mini muffin mold. Fill each section of the prepared mold with a tablespoon of muffin batter."
    },
    {
      "position": 3,
      "text": "Air fry at 375 degrees F (190 degrees C) until a toothpick inserted near the center of muffins comes out clean, 6 to 7 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 6,
  "preparation_time_minutes": 5,

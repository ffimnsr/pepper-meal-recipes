  "id": "1880e5fa-a387-572c-a450-1942ea86aa86",
  "slug": "deep-dish-strawberry-pie",
  "name": "Deep Dish Strawberry Pie",
  "recipe_type": "dessert",
  "brief_description": "This deep-dish strawberry pie recipe features a chocolate-painted crust, which prevents the strawberry filling from leaking. Serve with whipped cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Roll out pastry dough to fit a 9-inch deep-dish pie plate; press into pie plate. Prick bottom and sides of dough with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly brown, 10 to 12 minutes. Cool completely on a wire rack."
    },
    {
      "position": 4,
      "text": "Melt chocolate chips in a saucepan over medium-low heat, stirring constantly, 1 to 3 minutes. Paint melted chocolate on bottom and up sides of pie crust; freeze to harden, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Place prettiest strawberry, cut-side down, in center of crust. Arrange as many strawberries as possible in a single layer around center strawberry, radiating from center outwards to crust sides."
    },
    {
      "position": 6,
      "text": "Mash remaining strawberries in a bowl; transfer to a saucepan. Add sugar and lemon juice; bring to a boil, stirring frequently."
    },
    {
      "position": 7,
      "text": "Whisk ginger ale and cornstarch together in a bowl until smooth; gradually stir into mashed strawberry mixture. Reduce heat to medium-low; simmer, stirring constantly, until thickened, 12 to 14 minutes. Cool, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Spoon strawberry sauce over strawberries in pie shell. Chill in the refrigerator until pie sets, 8 hours to overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

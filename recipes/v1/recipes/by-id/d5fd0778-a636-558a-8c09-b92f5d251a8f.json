  "schema_version": 1,
  "id": "d5fd0778-a636-558a-8c09-b92f5d251a8f",
  "slug": "pumpkin-pecan-biscotti",
  "name": "Pumpkin Pecan Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Pumpkin biscotti with pecans, flavored with cinnamon, ginger, and nutmeg, are so nice for dipping into coffee or hot cider. They make great little gifts, too.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper. Whisk together the flour, white sugar, brown sugar, baking powder, salt, cinnamon, nutmeg, and ginger in a large bowl until thoroughly combined."
    },
    {
      "position": 2,
      "text": "In a separate bowl, beat the eggs with pumpkin puree and vanilla extract; stir in pecans. Pour in the dry ingredients, and stir to make a stiff dough. Divide the dough in half, and form each half into a log about 10 inches long and 2 inches wide. Place the logs onto the parchment-lined baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, 25 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Let the logs cool on the baking sheet for 5 minutes; remove to a work surface and slice the logs into individual cookies about 1/2-inch thick. Use a sharp knife and a light sawing motion to cut up the cookies. Place the cookies back onto the parchment-lined baking sheet."
    },
    {
      "position": 5,
      "text": "Return the cookies to the oven, and bake until lightly browned, about 8 minutes; turn the cookies over and bake until crisp, another 8 minutes. Let cool on wire racks."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

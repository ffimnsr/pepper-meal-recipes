  "schema_version": 1,
  "id": "663b008c-d88a-56d5-bcc2-561318c5fc69",
  "slug": "easy-3-ingredient-vanilla-creme-brulee",
  "name": "Easy 3-Ingredient Vanilla Cr\u00e8me Br\u00fbl\u00e9e",
  "recipe_type": "dessert",
  "brief_description": "This ice cream cr\u00e8me br\u00fbl\u00e9e is made with just 3 simple ingredients for a smooth and creamy restaurant-quality dessert that will impress your guests.",
  "cuisine": "American French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (162 degrees C). Place two small ovenproof ramekins in a baking dish with a high rim."
    },
    {
      "position": 2,
      "text": "Heat ice cream in a microwave-safe bowl in the microwave for 20-second intervals, stirring between, until melted. Let cool for 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk egg yolks, one at a time, into melted ice cream until smooth and well combined. Pour evenly into the two ramekins in the baking dish. Carefully pour boiling water into the baking dish until halfway up each ramekin."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until set but still jiggly in the center, 40 to 50 minutes. Allow to cool completely, then wrap with plastic wrap and transfer to the refrigerator for at least 2 hours and up to 3 days."
    },
    {
      "position": 5,
      "text": "When ready to serve, let the ramekins come to room temperature for 30 minutes. Sprinkle 1 tablespoon sugar evenly over each cr\u00e8me br\u00fbl\u00e9e. Use a kitchen blow torch to heat sugar until golden and bubbly."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6ee319b2-0aa8-5c01-bb87-62fb6496c2e0",
  "slug": "jalapeno-cream-cheese-chicken-enchiladas",
  "name": "Jalape\u00f1o Cream Cheese Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "This jalape\u00f1o cream cheese chicken enchiladas recipe yields creamy green chile enchiladas with shredded chicken and spicy jalape\u00f1os baked with cheese.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Season chicken breasts with 1/2 teaspoon garlic powder, 1 teaspoon cayenne pepper, salt, and black pepper; place in a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until chicken is no longer pink inside and juices run clear, 30 to 35 minutes. Cool chicken, then shred with two forks. Set aside."
    },
    {
      "position": 4,
      "text": "Heat butter in a large nonstick skillet over medium heat. Add onion and jalape\u00f1os; cook until onion is translucent, about 5 minutes. Stir in cream cheese; cook until melted. Stir in remaining 3 teaspoons garlic powder, remaining 1/2 teaspoon cayenne pepper, paprika, chili powder, and cumin. Stir in shredded chicken; remove from heat."
    },
    {
      "position": 5,
      "text": "Pour 1/2 enchilada sauce in bottom of a 9x13-inch baking dish. Lay tortillas on a work surface; spoon chicken mixture in a line across center of each tortilla. Sprinkle each with about 1 tablespoon Monterey Jack cheese. Roll up tortillas; place in sauce in the dish, seam-sides down. Pour remaining 1/2 sauce over enchiladas. Sprinkle remaining 4 ounces cheese over top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until filling is hot and bubbly and cheese has melted, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

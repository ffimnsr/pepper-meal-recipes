  "id": "fef96de4-dde4-5df5-b285-41b57c9e7a61",
  "slug": "yummy-artichoke-dip",
  "name": "Yummy Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This warm dip with marinated artichokes, cream cheese, mayo, and Parmesan cheese is a flavorful favorite. Green chile peppers add a spicy thrill!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix artichoke hearts, mayonnaise, 1 cup Parmesan cheese, cream cheese, and green chile peppers. Scoop mixture into a pie pan or medium baking pan. Top with remaining 1/2 cup of Parmesan cheese."
    },
    {
      "position": 3,
      "text": "Bake for 25 minutes or until bubbly and slightly browned. Serve warm."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

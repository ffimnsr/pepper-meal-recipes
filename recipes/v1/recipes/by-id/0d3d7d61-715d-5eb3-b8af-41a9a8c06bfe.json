  "id": "0d3d7d61-715d-5eb3-b8af-41a9a8c06bfe",
  "slug": "oil-pie-crust",
  "name": "Oil Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "Very easy recipe from my Grandmother. Crust can be rolled out a second time if necessary and it won't get tough.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour and salt together. Pour milk and oil into one measuring cup, do not stir, and add all at once to flour. Stir until mixed, and shape into 2 flat balls. Wrap in plastic wrap. Refrigerate for 15 minutes or more."
    },
    {
      "position": 2,
      "text": "Roll out on lightly floured surface."
    }
  ],

  "schema_version": 1,
  "id": "72dc3b94-1012-579d-8c29-8d1021f7a346",
  "slug": "stuffed-peppers",
  "name": "Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "Stuffed peppers filled with savory beef, rice, and herby tomato sauce are baked until the bell peppers are tender for an easy dinner full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients, and preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring water and rice to a boil in a covered saucepan. Reduce heat to low and simmer until rice is tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a skillet over medium heat. Add ground beef and cook until evenly browned and crumbly, 7 to 9 minutes."
    },
    {
      "position": 4,
      "text": "Hollow out bell peppers by removing and discarding the tops, seeds, and membranes. Slice the bottoms of the peppers if necessary to make sure they stand up straight."
    },
    {
      "position": 5,
      "text": "Arrange peppers in a baking dish with the hollowed sides facing upward."
    },
    {
      "position": 6,
      "text": "Prepare filling by mixing cooked beef, cooked rice, 1/2 of the tomato sauce, Worcestershire sauce, garlic powder, onion powder, salt, and pepper. Spoon an equal amount of filling into each hollowed pepper."
    },
    {
      "position": 7,
      "text": "Mix remaining tomato sauce and Italian seasoning in a bowl, and pour over the stuffed peppers."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven, basting with sauce every 15 minutes, until peppers are tender, about 1 hour."
    },
    {
      "position": 9,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 5,

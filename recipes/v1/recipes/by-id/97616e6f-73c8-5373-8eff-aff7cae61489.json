  "id": "97616e6f-73c8-5373-8eff-aff7cae61489",
  "slug": "remoulade-sauce-a-la-new-orleans",
  "name": "Remoulade Sauce \u00e0 la New Orleans",
  "recipe_type": "appetizer",
  "brief_description": "This remoulade sauce recipe is made with mayonnaise, herbs, capers, and hot sauce for a creamy, tangy New Orleans staple for po' boys and crab cakes.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together mayonnaise, chili sauce, mustard, olive oil, lemon juice, hot sauce, and Worcestershire in a medium bowl. Stir in scallions, parsley, olives, celery, capers, and garlic. Season with salt, chili powder, and black pepper."
    },
    {
      "position": 2,
      "text": "Cover, refrigerate, and serve chilled."
    }
  ],

  "id": "f690dd0f-543b-5434-98d8-de398e31477b",
  "slug": "mini-cucumber-sushi-rolls",
  "name": "Mini Cucumber Sushi Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Thin cucumber slices are rolled around shredded carrot, cream cheese, and raisins for a little sushi-shaped finger food that's tied with a fresh chive.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "With a peeler, slice cucumber into 8 1/8-inch thick slices lengthwise. Cut each slice into 3 pieces crosswise."
    },
    {
      "position": 2,
      "text": "Place about 1 teaspoon shredded carrot onto the bottom edge of a cucumber slice; place about 1 teaspoon cream cheese onto the carrot, and press 2 or 3 raisins into the cream cheese. Roll the cucumber slice into a little sushi roll, starting at the filled end. Tie roll with a chive to secure. Repeat with remaining ingredients."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,

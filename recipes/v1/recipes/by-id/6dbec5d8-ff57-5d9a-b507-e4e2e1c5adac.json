  "id": "6dbec5d8-ff57-5d9a-b507-e4e2e1c5adac",
  "slug": "chocolate-orange-possets-recipe-12014306",
  "name": "Chocolate Orange Possets",
  "recipe_type": "dessert",
  "brief_description": "These chocolate orange possets look elegant but are surprisingly easy to make. This creamy no-bake dessert is topped with a simple ganache and served in orange shells for the perfect balance of bright citrus and decadent chocolate.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Cut two large oranges in half. Remove pulp with a spoon. Squeeze pulp and use the juice for step 3, adding additional juice as needed to reach 1/4 cup."
    },
    {
      "position": 2,
      "text": "Rub zest of 1 orange (about 2 teaspoons) into the sugar. Add to cream and heat over medium just until simmering, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in orange juice and lemon juice. Pass through a fine mesh strainer to remove zest."
    },
    {
      "position": 4,
      "text": "Divide cream mixture between the hollowed orange halves, filling generously. Refrigerate for 6 hours or overnight to set."
    },
    {
      "position": 5,
      "text": "The next day, add chocolate chips, butter, and cream to a microwave-safe measuring glass. Heat in 30 second intervals, stirring between each, until chocolate is melted and mixture is smooth and glossy."
    },
    {
      "position": 6,
      "text": "Pour the chocolate topping onto the chilled possets, spreading in a thin layer. Refrigerate again for 15 to 20 minutes before serving to allow chocolate layer to set. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

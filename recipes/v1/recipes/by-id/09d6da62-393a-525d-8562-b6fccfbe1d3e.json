  "id": "09d6da62-393a-525d-8562-b6fccfbe1d3e",
  "slug": "garlic-butter-smoked-shrimp",
  "name": "Garlic Butter Smoked Shrimp",
  "recipe_type": "main",
  "brief_description": "These marinated smoked shrimp, lightly seasoned with butter and garlic, cook up in your smoker in just 30 minutes, letting the flavor shine through.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place shrimp in a resealable plastic bag. Sprinkle with Cajun seasoning and drizzle with olive oil; toss shrimp around in the bag to evenly distribute seasoning. Refrigerate for 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat a smoker to 250 degrees F (120 degrees C). Add wood chips according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Place butter in a microwave-safe dish and cook on high until completely melted, 20 to 30 seconds. Stir in lemon peel, garlic, red pepper flakes, and black pepper."
    },
    {
      "position": 4,
      "text": "Arrange shrimp in even rows in an 8x10-inch aluminum pan. Place thyme sprigs between each row. Drizzle butter mixture over shrimp."
    },
    {
      "position": 5,
      "text": "Place in the preheated smoker and cook shrimp until firm and orange-pink in color, about 30 minutes. Try not to overcook as the shrimp will become rubbery. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

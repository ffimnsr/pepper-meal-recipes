  "id": "74434047-d861-5123-bf64-3c59854e4041",
  "slug": "ozark-poutine-recipe-11920698",
  "name": "Ozark Poutine",
  "recipe_type": "side",
  "brief_description": "The Big Chief Roadhouse was a Route 66 staple outside St. Louis. This Ozark Poutine recipe brings its comfort-food legacy to your table with crispy fries, garlic cream sauce, and bacon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prep the Fries: Preheat your oven to 425 degrees F (220 degrees C). Toss the potato fries with vegetable oil, salt, and pepper. Spread them out in a single layer on a baking sheet lined with parchment paper."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until the fries are golden and crispy, flipping halfway through, 25 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Roast the Garlic: Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Cut the top off the head of garlic, drizzle with olive oil, and wrap it in aluminum foil."
    },
    {
      "position": 5,
      "text": "Roast until the garlic cloves are soft and golden, 30 to 35 minutes, ."
    },
    {
      "position": 6,
      "text": "Make the Roasted Garlic Cream Sauce: Squeeze the roasted garlic cloves into a small saucepan. Add heavy cream and heat over medium-low heat, stirring occasionally."
    },
    {
      "position": 7,
      "text": "Once the cream is hot, whisk in the Parmesan cheese until smooth. Season with salt and pepper to taste. Keep warm."
    },
    {
      "position": 8,
      "text": "Assemble the Poutine: Place the baked fries on a serving platter."
    },
    {
      "position": 9,
      "text": "Drizzle the roasted garlic cream sauce generously over the fries."
    },
    {
      "position": 10,
      "text": "Sprinkle the crumbled bacon, diced tomatoes, and chopped green onions over the top. Recipe excerpted from Route 66 Recipes: A Culinary Cruise Along the Mother Road , reprinted with permission from Arcadia Publishing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,

  "id": "3907672f-85cd-5896-a308-d6c4d2533eed",
  "slug": "easy-chicken-pot-pie",
  "name": "Easy Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This easy chicken pot pie made with prepared pie crusts is filled with creamy vegetables and chunks of cooked chicken for a quick and easy comfort food classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine chicken, mixed vegetables, condensed soup, and milk in a bowl."
    },
    {
      "position": 3,
      "text": "Pour the mixture into the bottom pie crust."
    },
    {
      "position": 4,
      "text": "Cover with second crust. Seal the edges and poke holes in top crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is golden brown, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

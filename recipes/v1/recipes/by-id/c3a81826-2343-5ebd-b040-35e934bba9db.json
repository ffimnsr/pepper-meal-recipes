  "slug": "slow-cooker-boiled-peanuts-recipe-11883872",
  "name": "Slow Cooker Boiled Peanuts",
  "recipe_type": "side",
  "brief_description": "These slow cooker boiled peanuts are the easiest recipe ever\u2014peanuts, salt, and water, plus time in a slow cooker. You'll love them.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Wash peanuts, then pour them into a crockpot set on High."
    },
    {
      "position": 2,
      "text": "Pour 1 cup kosher salt over peanuts. Pour in enough water to fully submerge peanuts; stir well."
    },
    {
      "position": 3,
      "text": "Cook peanuts for 12 hours, stirring occasionally."
    }
  ],

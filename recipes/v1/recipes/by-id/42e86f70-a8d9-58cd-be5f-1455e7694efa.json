  "schema_version": 1,
  "id": "42e86f70-a8d9-58cd-be5f-1455e7694efa",
  "slug": "mediterranean-turkey-meatball-sheet-pan-dinner-recipe-7562426",
  "name": "Mediterranean Turkey Meatball Sheet Pan Dinner",
  "recipe_type": "main",
  "brief_description": "This ground turkey meatball sheet pan dinner takes on all the flavors of fresh herbs, shallot, garlic, and lemon zest you\u2019ll find in Greek cooking. They add loads of flavor to both the turkey meatballs and the veggies.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a sheet pan with foil or parchment paper."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine parsley, rosemary, oregano, dill, mint, salt, and pepper. Stir to combine. Set aside 2 tablespoons of herbs to use with vegetables later in the recipe."
    },
    {
      "position": 3,
      "text": "To the large bowl, add breadcrumbs, shallot, garlic, and lemon zest; stir to combine. Whisk beaten egg with 1 tablespoon olive oil, and stir into the breadcrumb mixture. Add ground turkey."
    },
    {
      "position": 4,
      "text": "Mix all ingredients well using your hands. If meatballs seem too wet, work in another tablespoon of bread crumbs. Form into 18 (1 1/4-inch) meatballs and place on the prepared pan. Spray meatballs with olive oil spray."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, combine lemon juice, reserved 2 tablespoons herb mixture, and remaining 1 tablespoon olive oil, and toss with red pepper, green pepper, red onion, and zucchini slices."
    },
    {
      "position": 7,
      "text": "Remove meatballs from the oven; distribute vegetables around the meatballs on the pan."
    },
    {
      "position": 8,
      "text": "Return the pan to the oven; continue baking until vegetables are tender and meatballs are no longer pink in the center, about 15 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 9,
      "text": "Sprinkle with crumbled feta cheese, chopped tomatoes, and olives. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

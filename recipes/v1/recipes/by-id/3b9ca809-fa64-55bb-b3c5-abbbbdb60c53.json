  "id": "3b9ca809-fa64-55bb-b3c5-abbbbdb60c53",
  "slug": "spaghetti-alla-carbonara-the-traditional-italian-recipe",
  "name": "Spaghetti alla Carbonara",
  "recipe_type": "main",
  "brief_description": "Carbonara made with cured pork, eggs, Pecorino cheese, spaghetti, and lots of pepper. This authentic Italian recipe is the only one you'll ever need!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat; add guanciale (see Cook's Note). Cook, turning occasionally, until evenly browned and crispy, 5 to 10 minutes. Remove from heat and drain on paper towels."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally until tender yet firm to the bite, about 9 minutes. Drain and return to the pot. Let cool, stirring occasionally, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk eggs, 1/2 of the Pecorino Romano cheese, and some black pepper in a bowl until smooth and creamy."
    },
    {
      "position": 4,
      "text": "Pour egg mixture over pasta, stirring quickly, until creamy and slightly cooled. Stir in guanciale."
    },
    {
      "position": 5,
      "text": "Top with remaining Pecorino Romano cheese and more black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

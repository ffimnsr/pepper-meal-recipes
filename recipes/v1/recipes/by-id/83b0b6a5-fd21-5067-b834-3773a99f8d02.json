  "id": "83b0b6a5-fd21-5067-b834-3773a99f8d02",
  "slug": "easy-lemon-lovers-bundt-cake",
  "name": "Easy Lemon Lover's Bundt Cake",
  "recipe_type": "dessert",
  "brief_description": "This easy lemon lover's Bundt cake recipe uses sour cream, oil, lemon juice, zest, extract, and pudding. It is a moist, lemony cake that is easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a fluted tube cake pan."
    },
    {
      "position": 2,
      "text": "Beat cake mix, sour cream, eggs, vegetable oil, lemon juice, pudding mix, lemon zest, poppy seeds, and lemon extract together in a bowl with an electric mixer on low speed for 1 minute. Increase speed to medium; beat for 3 minutes. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Cool in the pan on a wire rack for 10 minutes. Tap the pan firmly a few times, then shake it gently to loosen the cake. Place the wire rack over the pan and invert to release cake onto the rack; cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b34ad6f5-2ebb-5697-90aa-f4b00cd9b2e8",
  "slug": "copycat-mcdonalds-apple-pies-recipe-8411642",
  "name": "Copycat McDonald's Apple Pies",
  "recipe_type": "dessert",
  "brief_description": "This copycat McDonald's apple pie recipe will cure any craving. Here's how to make copycat McDonald's apple pies\u2014in the air fryer and baked in the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir apples and lemon juice together in a bowl; sprinkle with 2 tablespoons white sugar, brown sugar, and \u00bd teaspoon cinnamon. Set aside until apples release some juice, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Heat butter in a medium saucepan over medium-high heat until melted and bubbling. Add apple mixture, reduce heat to medium, and cook, stirring occasionally, until apples softened and juices just slightly reduced, 6 to 9 minutes. Stir in cornstarch and vanilla; cook, stirring constantly, until mixture is bubbling and thickened, about 1 minute. Set aside off heat until slightly cooled, 15 to 30 minutes."
    },
    {
      "position": 4,
      "text": "Roll out 1 pie crust into a 12-inch circle."
    },
    {
      "position": 5,
      "text": "Cut crust into 8 (4x2-inch) rectangles, discarding scraps or reserving for another use; cover dough with plastic wrap. Repeat with remaining 1 pie crust. Place 8 dough rectangles on a work surface; lightly brush with egg all the way to edges."
    },
    {
      "position": 6,
      "text": "Spoon about 1 \u00bd tablespoons apple filling in center of each rectangle, leaving a \u00bc-inch border on all sides and leaving excess juices in the bowl."
    },
    {
      "position": 7,
      "text": "Top filled rectangles with remaining dough rectangles, slightly stretching as needed to align edges with base dough; crimp edges using fork tines and brush tops lightly with egg."
    },
    {
      "position": 8,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) for 5 minutes according to manufacturer's directions. Meanwhile, make 3 evenly spaced diagonal cuts on each pie top to vent."
    },
    {
      "position": 9,
      "text": "Combine remaining 1 tablespoon white sugar and remaining \u00bd teaspoon cinnamon in a small bowl; sprinkle on pie tops."
    },
    {
      "position": 10,
      "text": "Lightly coat air fryer basket with cooking spray; add 4 pies to basket. Bake in the preheated air fryer until golden brown and crisp, 14 to 17 minutes. Repeat with remaining pies."
    },
    {
      "position": 11,
      "text": "Serve warm."
    }
  ],
  "servings": 8,

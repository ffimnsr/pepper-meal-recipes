  "id": "d81827d5-3d08-5763-bcdc-232f9d579c29",
  "slug": "soft-cinnamon-rolls",
  "name": "Soft Cinnamon Rolls",
  "recipe_type": "breakfast",
  "brief_description": "Nothing beats hot cinnamon rolls fresh out of the oven first thing in the morning.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, dissolve yeast in warm water. Let stand until creamy, about 10 minutes."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine the yeast mixture with the sugar, salt, egg and 1 cup flour; stir well to combine. Stir in the remaining flour, 1/2 cup at a time, beating well with each addition. When the dough has pulled together, turn it out onto a lightly floured surface and knead until smooth and elastic, about 8 minutes. Cover with a damp cloth and let rest for 10 minutes."
    },
    {
      "position": 3,
      "text": "Lightly grease an 8x8 inch square baking pan. Roll dough out on a lightly floured surface to 1/4 inch thick rectangle. Smear the dough with butter and sprinkle with cinnamon and brown sugar. Roll up the dough along the long edge until it forms a roll. Slice the roll into 16 equal size pieces and place them in the pan with the cut side up."
    },
    {
      "position": 4,
      "text": "Cover pan with plastic wrap and refrigerate overnight or cover and let rise at room temperature until doubled in volume, about 45 minutes."
    },
    {
      "position": 5,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Bake rolls until golden brown, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

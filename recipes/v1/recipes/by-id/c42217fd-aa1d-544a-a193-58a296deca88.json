  "id": "c42217fd-aa1d-544a-a193-58a296deca88",
  "slug": "fudgy-black-forest-bars-recipe-8781403",
  "name": "Fudgy Black Forest Bars",
  "recipe_type": "dessert",
  "brief_description": "These fudgy Black Forest bars are a decadent dessert that is somewhere between brownie and cake, loaded with chocolate and bathed in cherries. They're fabulous with coffee.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a bowl with an electric mixer until creamy. Beat in vanilla. Add eggs, 1 at a time, beating in each egg completely before adding the next."
    },
    {
      "position": 3,
      "text": "Stir in flour and cocoa powder until fully combined. Stir in chocolate chunks."
    },
    {
      "position": 4,
      "text": "Spread mixture into prepared pan, then pour pie filling over the top, smoothing it out."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 40 minutes, then check for doneness. A toothpick inserted near the center should come out with just a few moist crumbs. Bake up to 10 minutes more, if needed."
    },
    {
      "position": 6,
      "text": "Cool completely; sprinkle with confectioner\u2019s sugar. Cut into bars."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9d2d26bf-4343-539a-9526-6207e2395e37",
  "slug": "knoephla-soup",
  "name": "Knoephla Soup",
  "recipe_type": "soup",
  "brief_description": "Knoephla soup is a rich and creamy German potato soup with homemade dumplings that will keep you warm and satiated during the cold winter months.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Make soup: Melt butter in a large skillet over medium heat. Saut\u00e9 potatoes, onion, and pepper in hot butter until just tender, about 20 minutes. Stir in milk and heat until almost boiling, about 5 minutes. Remove the skillet from heat."
    },
    {
      "position": 3,
      "text": "Bring water and chicken bouillon to a boil in a Dutch oven or heavy pot."
    },
    {
      "position": 4,
      "text": "Make knoephla: Mix together flour, milk, beaten egg, dill weed, parsley, pepper, and salt in a bowl until dough is stiff. Add more milk, 1 tablespoon at a time, if needed."
    },
    {
      "position": 5,
      "text": "Roll dough into ropes about 1/2-inch thick on a work surface. Cut ropes into 1/4-inch pieces and drop them into boiling broth."
    },
    {
      "position": 6,
      "text": "Reduce heat, cover the Dutch oven with a lid, and simmer until knoephla begin to float, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Stir potato mixture into broth and knoephla; simmer until potatoes are tender, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

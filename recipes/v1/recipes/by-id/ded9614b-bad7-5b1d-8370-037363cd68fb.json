  "id": "ded9614b-bad7-5b1d-8370-037363cd68fb",
  "slug": "chocolate-chip-cookies-for-special-diets",
  "name": "Chocolate Chip Cookies for Special Diets",
  "recipe_type": "dessert",
  "brief_description": "Be sure to use a heat-stable sugar substitute in these sugar-free chocolate chip cookies. Since substitutes vary in strength, use an amount equal to 3/4 cup regular sugar according to the package.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together butter and sugar substitute. Mix in water, vanilla, and egg."
    },
    {
      "position": 3,
      "text": "Sift together flour, baking soda, and salt; stir into the creamed mixture. Mix in the chocolate chips and pecans."
    },
    {
      "position": 4,
      "text": "Drop dough by heaping teaspoonfuls onto cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven 10 to 12 minutes. Remove from the cookie sheets to cool on wire racks."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

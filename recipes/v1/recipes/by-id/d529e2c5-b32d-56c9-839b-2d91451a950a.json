  "id": "d529e2c5-b32d-56c9-839b-2d91451a950a",
  "slug": "bananas-foster-ii",
  "name": "Bananas Foster",
  "recipe_type": "dessert",
  "brief_description": "Elegant bananas foster made with bananas cooked in a bubbling mixture of brown sugar, butter, rum, walnuts, and cinnamon, served over ice cream.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large, deep skillet over medium heat. Stir in brown sugar, rum, vanilla, and cinnamon; bring to a low boil."
    },
    {
      "position": 3,
      "text": "Place bananas and walnuts in the pan. Cook until bananas have softened, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Serve at once over vanilla ice cream. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

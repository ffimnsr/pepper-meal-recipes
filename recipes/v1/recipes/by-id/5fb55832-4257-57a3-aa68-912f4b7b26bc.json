  "id": "5fb55832-4257-57a3-aa68-912f4b7b26bc",
  "slug": "double-chocolate-biscotti",
  "name": "Double Chocolate Biscotti",
  "recipe_type": "dessert",
  "brief_description": "This chocolate biscotti recipe uses chocolate chips and white chocolate to make a sweet and crunchy Italian cookie that's great with coffee.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Gradually beat in cocoa and baking powder. Beat for 2 minutes. Beat in the eggs one at a time. Stir in flour by hand. Mix in white chocolate and chocolate chips. Cover dough, and chill for about 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a cookie sheet. Divide dough into two parts, and roll each part into a 9-inch long log. Place logs on prepared cookie sheet, about 4 inches apart. Flatten slightly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 20 to 25 minutes. Cool on cookie sheet for 5 minutes, then carefully transfer to a wire rack to cool for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F ( 165 degrees C). Cut each loaf into 1/2-inch wide diagonal slices. Place slices on an ungreased cookie sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 9 minutes. Turn cookies over, and bake for 7 to 9 minutes. Cool completely, then store in an airtight container."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

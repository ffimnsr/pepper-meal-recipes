  "id": "4d1c7395-6526-53a5-bd70-470df5d7dd47",
  "slug": "air-fryer-corn-on-the-cob",
  "name": "Air Fryer Corn on The Cob",
  "recipe_type": "appetizer",
  "brief_description": "Air fryer corn on the cob is a breeze to make with ears of fresh corn; coat with mayo, chili, lime, and cotija, for tender roasted street corn in minutes.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix mayonnaise, cotija cheese, lime juice, and chili powder in a shallow dish."
    },
    {
      "position": 3,
      "text": "Roll each piece of corn in the mayonnaise mixture until all sides are covered."
    },
    {
      "position": 4,
      "text": "Place all 4 pieces of corn in the air fryer basket; cook in the preheated air fryer until golden, crisp, and tender, about 8 minutes. Garnish with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "4c4515d8-4390-5146-920e-88cc35eb4215",
  "slug": "currant-scones",
  "name": "Currant Scones",
  "recipe_type": "dessert",
  "brief_description": "These are without doubt the lightest, tastiest, most buttery scones you've ever had. Not too sweet, but a light coating of crystal sugar gives them a slightly crunchy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cover currants with warm water in a bowl and set aside to moisten."
    },
    {
      "position": 3,
      "text": "Sift flour, baking powder, and baking soda in the bowl of a stand mixer. Using the paddle attachment at low speed, mix white sugar and salt into the flour mixture. Add all the unsalted butter to the mixer bowl and mix on low speed until butter cubes reduce to the size of small peas, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Drain currants and discard soaking water; mix currants, buttermilk, and lemon zest into the flour mixture on low speed just until the dough starts to hold together."
    },
    {
      "position": 5,
      "text": "Turn dough out onto a lightly floured work surface and gently shape into a rectangle 18 inches long, 5 inches wide, and 1 1/2 inches thick. Brush dough with melted butter and sprinkle with sugar crystals."
    },
    {
      "position": 6,
      "text": "Cut the dough in half crosswise with a sharp knife; cut each half into thirds, and cut each third diagonally to make 12 triangular-shaped scones. Place on the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until scones are lightly golden brown, about 18 minutes. Eat warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "302472a9-3cd9-55be-84c6-8fac4aad530b",
  "slug": "chef-johns-waldorf-salad",
  "name": "Chef John's Waldorf Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John uses chopped celery root in his version of this classic salad--just 4 ingredients and a creamy dressing is all it takes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, creme fraiche, lemon juice, tarragon, sugar, salt, black pepper, and cayenne together in a bowl."
    },
    {
      "position": 2,
      "text": "Place apples, celery root, grapes, and walnut pieces in a large bowl. Toss with about 1/2 cup of dressing. Add more dressing until salad components are well coated but not swimming in dressing. You might not need all the dressing."
    },
    {
      "position": 3,
      "text": "Serve immediately or cover and refrigerate for up to 24 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

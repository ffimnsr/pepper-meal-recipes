  "id": "094e015d-6978-54b2-812c-a59a7f14391a",
  "slug": "chicken-fajita-bowl",
  "name": "Chicken Fajita Bowl",
  "recipe_type": "main",
  "brief_description": "This colorful fajita bowl recipe features tender chicken, creamy avocado, and low-carb cauliflower rice with tomatoes, saut\u00e9ed bell peppers, and cheese.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a skillet with cooking spray and heat over medium heat. Add chicken, season with salt and pepper, and cook, stirring occasionally, until no longer pink, about 7 minutes. Transfer to a plate."
    },
    {
      "position": 2,
      "text": "Add onion and bell pepper slices to the skillet. Increase the heat to medium-high and saut\u00e9 until slightly browned, about 5 minutes. Mix in diced tomatoes and cooked chicken. Cook until liquid is mostly evaporated, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, microwave cauliflower rice following the package instructions for 5 minutes. Let stand for 1 minute."
    },
    {
      "position": 4,
      "text": "Carefully open the package of cauliflower rice and divide between two bowls. Divide chicken and vegetable mixture evenly between the bowls. Top with Cheddar cheese, avocado, salsa, and sour cream."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

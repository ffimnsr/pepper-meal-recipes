  "id": "9f6fac14-e49b-5777-b5dd-18edca225aa2",
  "slug": "tex-mex-chicken-pasta-bake-recipe-11944046",
  "name": "Tex-Mex Chicken Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This Tex-Mex chicken pasta bake adds fun bow-tie pasta to the elements of a taco for a delicious new experience. With chicken, Cheddar cheese, and salsa, it's a family dinner you can have on the table in under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish, and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook bow-tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Combine salsa, sour cream, taco seasoning, and tomato paste in a large bowl and stir until well blended."
    },
    {
      "position": 4,
      "text": "Add cooked pasta, black beans, fiesta corn, green chilies, and chicken. Add in 1 cup shredded Cheddar cheese, and stir until combined. Pour ingredients into the prepared pan and cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the center of the preheated oven for about 20 minutes. Remove foil, sprinkle remaining Cheddar on top, and bake until cheese is melted and bubbly, about 10 minutes more."
    },
    {
      "position": 6,
      "text": "Cool on a rack for about 10 minutes, then garnish with avocado, green onions, and cilantro, if desired. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8f977627-88e8-5f29-ac17-185e87b96f9a",
  "slug": "amazing-monkey-bread",
  "name": "Amazing Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "Frozen bread dough rises overnight with a sweet and sticky blend of butterscotch pudding mix, sugar, and cinnamon. Chopped pecans add a terrific crunch to this popular brunch bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Arrange dinner roll dough in a grease tube pan."
    },
    {
      "position": 2,
      "text": "Heat butter and brown sugar in a small saucepan over medium-low heat until sugar is dissolved about 5 minutes; pour over rolls. Sprinkle with pecans and pudding mix. Mix white sugar and cinnamon in a bowl; sprinkle over pudding mix. Pour corn syrup evenly over cinnamon mixture. Cover tube pan with a sheet of greased aluminum foil and allow dough to rise overnight."
    },
    {
      "position": 3,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Move rack to the lower half of the oven."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until golden brown, 35 to 40 minutes. Allow bread to rest for 10 to 15 minutes. Invert pan onto a baking sheet or large plate to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

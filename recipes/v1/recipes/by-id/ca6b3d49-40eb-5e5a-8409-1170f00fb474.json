  "id": "ca6b3d49-40eb-5e5a-8409-1170f00fb474",
  "slug": "baked-polenta-marinara-recipe-8739375",
  "name": "Baked Polenta Marinara",
  "recipe_type": "side",
  "brief_description": "This baked polenta marinara\u2014a layer of polenta, baked topped with marinara sauce, mozzarella, and prosciutto\u2014makes a unique and delicious side dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly oil a 9x13-inch baking dish; set aside."
    },
    {
      "position": 2,
      "text": "Bring chicken broth to a boil in a saucepan, and whisk in polenta and salt. Immediately reduce temperature to medium, and cook polenta, stirring continuously, until most of the liquid is absorbed and polenta is thick, about 15 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Stir Parmesan cheese, 1/4 cup mozzarella, and butter into polenta. Pour mixture into the prepared baking dish and smooth the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until polenta is fairly firm, about 40 minutes. It will firm a bit more on standing."
    },
    {
      "position": 5,
      "text": "Remove polenta from the oven; let stand for 5 minutes. Spread marinara over the top, then sprinkle evenly with remaining 1/2 cup mozzarella. Sprinkle top with shredded prosciutto."
    },
    {
      "position": 6,
      "text": "Bake polenta until cheese is bubbling and golden brown, about 15 minutes more. Let stand for 5 to 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

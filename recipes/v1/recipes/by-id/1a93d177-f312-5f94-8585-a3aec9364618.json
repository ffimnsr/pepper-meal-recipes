  "id": "1a93d177-f312-5f94-8585-a3aec9364618",
  "slug": "braised-flank-steak-in-the-oven",
  "name": "Braised Flank Steak in the Oven",
  "recipe_type": null,
  "brief_description": "A long, slow braise in the oven in an oniony sauce ensures a tender flank steak with extra sauce leftover for gravy.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with foil."
    },
    {
      "position": 2,
      "text": "Whisk water, steak sauce, and soup mix together in a small bowl. Pour a little into the bottom of the prepared pan. Add the steak, then the remaining sauce. Cover with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender and hot and slightly pink in the center, 1 to 2 hours. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

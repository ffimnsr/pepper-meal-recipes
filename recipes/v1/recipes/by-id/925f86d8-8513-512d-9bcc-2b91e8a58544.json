{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "925f86d8-8513-512d-9bcc-2b91e8a58544",
  "slug": "chicken-manicotti-alfredo",
  "name": "Chicken Manicotti Alfredo",
  "recipe_type": "main",
  "brief_description": "Large manicotti noodles are stuffed with an aromatic blend of marinated chicken, ricotta cheese, egg, basil, oregano and marjoram. Blanket with a velvety Alfredo sauce, top with mozzarella cheese and bake to perfection.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large resealable plastic bag, marinate chicken with vinegar, olive oil, and garlic for at least 30 minutes. Saute in a little olive oil until done. Set aside."
    },
    {
      "position": 2,
      "text": "Cook pasta in a large pot of boiling water until al dente. Drain, and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt butter or margarine in a small saucepan over medium-high heat. Add heavy cream, salt, nutmeg, and ground black pepper, and stir until sauce thickens. Reduce heat to low. Add grated Parmesan cheese, and stir until the cheese melts. Set Alfredo sauce aside."
    },
    {
      "position": 4,
      "text": "In a large bowl, mix together ricotta cheese, egg, oregano, marjoram, and basil. Mix in cooked chicken."
    },
    {
      "position": 5,
      "text": "Stuff cooked manicotti shells with chicken and ricotta mixture. Cover the bottom of a 9x13 inch baking dish with half of the Alfredo sauce. Place stuffed shells on top of sauce. Pour remaining sauce over shells. Top with one cup shredded mozzarella cheese. Cover with aluminum foil."
    },
    {
      "position": 6,
      "text": "Bake at 350 degree F (175 degree C) oven for 45 minutes. Let stand 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

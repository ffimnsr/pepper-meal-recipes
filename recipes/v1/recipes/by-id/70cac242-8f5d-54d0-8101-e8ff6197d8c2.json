  "id": "70cac242-8f5d-54d0-8101-e8ff6197d8c2",
  "slug": "easy-california-roll-sushi-salad",
  "name": "Easy California Roll Sushi Salad",
  "recipe_type": "salad",
  "brief_description": "This easy, yummy California roll salad is a great choice for anyone who loves California rolls, but doesn't have the patience or the equipment to make their own.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse rice in a strainer under cold water until water runs clear. Transfer rice to a medium saucepan, add 3 cups water, and bring to a boil. Reduce heat to low, cover, and cook under rice is tender and water is absorbed, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine rice wine vinegar, sugar, and sake in a microwave-safe bowl. Microwave on high until sugar is completely dissolved, about 1 minute."
    },
    {
      "position": 3,
      "text": "Place cooked rice in a large bowl. Stir in vinegar mixture until well combined and let sit for 2 minutes. Stir again. Add imitation crabmeat, cucumber, and chopped avocado; mix well. Use soy sauce to season individual portions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ba2e887d-5985-5c58-b015-5e964ebccae7",
  "slug": "slow-cooker-lamb-stew",
  "name": "Slow Cooker Lamb Stew",
  "recipe_type": "soup",
  "brief_description": "This slow cooker lamb stew recipe combines lots of veggies, cubes of lamb, beef broth, and fresh rosemary for a rich, hearty, and comforting meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium-high heat. Add lamb and onions; cook and stir until lamb is browned and onions are starting to soften, about 5 minutes. Transfer lamb mixture to a slow cooker."
    },
    {
      "position": 2,
      "text": "Add potatoes, carrots, celery, and mushrooms. Stir in beef broth, tomato paste, beer, Worcestershire sauce, rosemary, salt, and pepper; cover."
    },
    {
      "position": 3,
      "text": "Cook on High for 7 hours. Add peas and cook for an additional 15 minutes. Season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 445,
  "preparation_time_minutes": 15,

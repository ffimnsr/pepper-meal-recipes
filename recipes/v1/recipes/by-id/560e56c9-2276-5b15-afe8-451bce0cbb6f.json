  "id": "560e56c9-2276-5b15-afe8-451bce0cbb6f",
  "slug": "strawberry-cheesecake-bites",
  "name": "Strawberry Cheesecake Bites",
  "recipe_type": "dessert",
  "brief_description": "Mini strawberry cheesecake bites dipped in melted semisweet chocolate are easy to make with a cream cheese filling and a crushed graham cracker topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with waxed paper. Place graham cracker crumbs into a shallow bowl."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, confectioners' sugar, and vanilla in a bowl until smooth. Spoon mixture into a piping bag fitted with a large round tip."
    },
    {
      "position": 3,
      "text": "With a sharp paring knife, cut a cone shape out of the top of each strawberry to leave a small hollow. Pipe about 1 tablespoon of the cream cheese filling into each strawberry, making sure the filling overflows a bit out of the top of the strawberry."
    },
    {
      "position": 4,
      "text": "Hold each strawberry upside down to dip filling into crumbs until coated."
    },
    {
      "position": 5,
      "text": "Melt chocolate and canola oil in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each interval, until warm and smooth, 1 to 3 minutes (depending on your microwave)."
    },
    {
      "position": 6,
      "text": "Dip strawberry tips into melted chocolate, then place onto the prepared baking sheet and refrigerate until set."
    },
    {
      "position": 7,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

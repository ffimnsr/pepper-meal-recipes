  "id": "6dda9dc5-d1e6-5c7d-90b1-265609fa0dbc",
  "slug": "sourdough-rosemary-crackers",
  "name": "Sourdough Rosemary Crackers",
  "recipe_type": "appetizer",
  "brief_description": "This sourdough cracker recipe saves your \u201cdiscard\u201d from being discarded! Just one cup makes a large batch of deliciously crunchy rosemary crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour, sourdough starter discard, olive oil, rosemary, and kosher salt in a bowl. Mix with a wooden spoon to incorporate the ingredients. Turn out onto a work surface and knead until a smooth dough forms. Divide dough into two pieces and shape each piece into a small rectangle."
    },
    {
      "position": 3,
      "text": "Lightly flour a large sheet of parchment paper and place one piece of dough on top. Sprinkle dough lightly with flour, then roll into a large, 1/16-inch-thick rectangle. Cut into 1 1/4-inch squares. Spray tops with cooking spray and sprinkle with flaked sea salt. Carefully transfer the parchment paper and dough to a baking sheet. Repeat with the remaining dough."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crackers are golden brown, about 24 minutes, turning halfway through."
    },
    {
      "position": 5,
      "text": "Remove from the oven and let cool on a baking rack."
    }
  ],
  "servings": 90,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

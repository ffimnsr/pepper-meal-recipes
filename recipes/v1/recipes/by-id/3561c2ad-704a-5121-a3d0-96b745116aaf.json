  "id": "3561c2ad-704a-5121-a3d0-96b745116aaf",
  "slug": "honey-bbq-pulled-pork-in-the-slow-cooker",
  "name": "Honey BBQ Pulled Pork in the Slow Cooker",
  "recipe_type": "main",
  "brief_description": "Full of flavor and easy to prepare, this honey BBQ pulled pork in a slow cooker makes a delicious addition to potlucks or parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place onions into the bottom of a slow cooker and scatter garlic over top. Set pot roast in the cooker and season with pepper and salt. Pour BBQ sauce over pot roast, making sure roast, onions, and garlic are completely covered. Drizzle honey over roast only."
    },
    {
      "position": 2,
      "text": "Cover and cook until meat is easily shredded with 2 forks, on Low for about 12 hours or High for about 6 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 15,

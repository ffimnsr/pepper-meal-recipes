  "id": "81b83395-2e92-5864-b51d-b912cbe91e04",
  "slug": "bread-machine-honey-oat-wheat-bread",
  "name": "Bread Machine Honey-Oat-Wheat Bread",
  "recipe_type": null,
  "brief_description": "This recipe uses the dough cycle of a bread machine, but is baked in a traditional oven for a dense and flavorful loaf that's great for sandwiches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water, sugar, and yeast in the pan of a bread machine. Allow yeast to dissolve and foam, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, mix together all-purpose flour, whole wheat flour, rolled oats, powdered milk, and salt in a large bowl until well combined; set aside."
    },
    {
      "position": 3,
      "text": "Add honey, vegetable oil, and butter to yeast mixture, then pour flour mixture on top."
    },
    {
      "position": 4,
      "text": "Select the Dough cycle; press start. Allow the bread machine to complete the cycle, about 1 hour and 30 minutes."
    },
    {
      "position": 5,
      "text": "Transfer dough to a 9x5-inch loaf pan sprayed with cooking spray. Allow dough to rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the top is golden brown, about 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

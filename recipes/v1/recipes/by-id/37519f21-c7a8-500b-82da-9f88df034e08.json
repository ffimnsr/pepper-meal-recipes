  "id": "37519f21-c7a8-500b-82da-9f88df034e08",
  "slug": "copycat-disneyland-grilled-cheese-recipe-11865191",
  "name": "Copycat Disneyland Grilled Cheese",
  "recipe_type": "side",
  "brief_description": "For this copycat Disneyland grilled cheese, provolone and Cheddar slices encase a Cheddar and cream cheese spread in hearty white bread. A garlic-mayonnaise smear on the outside is the secret to grilled perfection.",
  "cuisine": "Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cream cheese, shredded cheese, heavy cream, and 1/4 teaspoon salt together in a small bowl until well combined; set aside."
    },
    {
      "position": 2,
      "text": "Stir mayonnaise, garlic, and remaining salt together in a separate bowl; set aside."
    },
    {
      "position": 3,
      "text": "Place 2 slices Cheddar cheese on each of 4 pieces of bread. Spread cream cheese mixture evenly among the 4 Cheddar-topped slices; top each with 2 slices provolone cheese. Add remaining bread slices on top."
    },
    {
      "position": 4,
      "text": "Spread half of mayonnaise mixture evenly over tops of sandwiches."
    },
    {
      "position": 5,
      "text": "Heat a large nonstick skillet over medium heat. Place sandwiches in skillet, mayonnaise side down. Spread the top of each sandwich with remaining mayonnaise mixture."
    },
    {
      "position": 6,
      "text": "Cook sandwiches until golden brown on both sides, flipping occasionally until cheese is melted and bread is well toasted."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

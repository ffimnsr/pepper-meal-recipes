  "id": "3c391821-0355-5cb8-a7c4-d6c22f461584",
  "slug": "peanut-butter-and-bran-cookies",
  "name": "Peanut Butter and Bran Cookies",
  "recipe_type": "dessert",
  "brief_description": "This peanut butter and bran cookies recipe is a guaranteed way to cure your sweet tooth while also being a healthier alternative to regular cookies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a bowl, beat together butter, brown sugar, white sugar, vanilla, peanut butter, and eggs. In a separate bowl, mix flour, bran, oats, and baking soda. Stir flour mixture into butter mixture until smooth. Drop by rounded teaspoons onto an ungreased cookie sheet."
    },
    {
      "position": 3,
      "text": "Bake for 15 to 18 minutes in the preheated oven. Remove to a rack to cool."
    }
  ],
  "servings": 84,
  "cooking_time_minutes": 15,

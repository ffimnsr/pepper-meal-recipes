  "id": "74842083-b7e4-50bb-a389-a02bf612139c",
  "slug": "buffalo-pretzels-recipe-8426520",
  "name": "Buffalo Pretzels",
  "recipe_type": "appetizer",
  "brief_description": "Buffalo pretzels are spicy, crisp, and very easy to make with only 3 ingredients. They're a great party snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pretzel twists in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk vegetable oil and Frank's seasoning in a separate bowl until smooth. Pour mixture over the pretzels. Gently stir to coat. Let stand for 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Gently toss the pretzel mixture again; let stand for 15 minutes while the oven preheats. Divide pretzels between 2 large rimmed baking sheets in an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crisp, about 20 minutes. Remove baking sheets from the oven to cool for 15 minutes. Store in an airtight container."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

  "id": "d1280879-20a6-5691-96db-2b9d3bb07242",
  "slug": "roasted-beetroot-and-garlic-hummus",
  "name": "Roasted Beetroot and Garlic Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Take your hummus to the next level with this recipe that adds roasted beetroot and garlic to create a pretty and delicious appetizer.",
  "cuisine": "Middle Eastern Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Poke beets all over with a fork; transfer to a microwave-safe bowl. Cover bowl with plastic wrap, leaving some room for air to escape. Cook beets in the microwave for 4 minutes. Wrap each beet with aluminum foil and place on a baking sheet."
    },
    {
      "position": 3,
      "text": "Season garlic halves with 1 tablespoon olive oil, salt, and pepper. Wrap each half with aluminum foil and place on the baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until beets are tender when pierced with a fork, about 35 minutes."
    },
    {
      "position": 5,
      "text": "Cool beets until running water for 1 minute. Peel off skins and transfer to a food processor."
    },
    {
      "position": 6,
      "text": "Squeeze garlic cloves into the food processor. Drizzle in any olive oil remaining on the aluminum foil. Add chickpeas, 1/4 cup olive oil, lemon juice, tahini, cumin, salt, pepper, and cayenne. Pulse until combined. Add Greek yogurt; process until smooth."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 39,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0f8ad3f9-07d2-5aac-a8e8-b3c76f6ba2a8",
  "slug": "puerto-rican-mondongo",
  "name": "Puerto Rican Mondongo",
  "recipe_type": "soup",
  "brief_description": "This simple, hearty mondongo with beef tripe, cassava, yam, potatoes, corn, and pumpkin is a distinctive and authentic Puerto Rican stew.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tripe and lemon juice in a large bowl. Let sit, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer tripe and lemon juice to a large pot. Cover with 2 inches of water. Bring to a boil; reduce heat to low and cook, stirring occasionally, until slightly softened, about 10 minutes. Drain and rinse tripe."
    },
    {
      "position": 3,
      "text": "Return tripe to the pot. Cover with 2 quarts beef broth, adding water as needed. Bring to a boil; reduce heat and cook until tender, about 2 hours."
    },
    {
      "position": 4,
      "text": "Stir remaining beef stock, cassava, potatoes, yams, pumpkin, sweet potatoes, tomato sauce, sofrito, and corn into the pot. Cook until tender, about 20 minutes more. Season with salt and pepper."
    }
  ],
  "servings": 8,

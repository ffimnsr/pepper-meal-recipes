  "id": "1075b410-e1c6-5bb1-94af-67b462c108d3",
  "slug": "armenian-rice-pilaf",
  "name": "Armenian Rice Pilaf",
  "recipe_type": "soup",
  "brief_description": "This easy-to-prepare rice dish with noodles and chicken broth is a staple of Armenian homes. It's great as a side dish with baked chicken.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in large saucepan over medium-high heat. Add the egg noodles and stir until they begin to brown, being careful not to burn the butter. Stir in the rice. Continue stirring until rice is coated with butter."
    },
    {
      "position": 2,
      "text": "Pour in the chicken broth and add the bouillon cubes. Bring to a boil; reduce heat to low and cover tightly. Cook without uncovering pot until all the liquid has been absorbed, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

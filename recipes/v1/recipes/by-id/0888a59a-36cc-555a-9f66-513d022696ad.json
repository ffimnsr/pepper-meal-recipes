  "slug": "gluten-free-bread-in-a-bread-machine",
  "name": "Gluten-Free Bread in a Bread Machine",
  "recipe_type": null,
  "brief_description": "This gluten-free bread machine recipe is basic yet reliable, made with gluten-free all-purpose flour. It is perfect for sandwiches, toast, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water, eggs, oil, vinegar, flour, xanthan gum, salt, sugar, and yeast, in that order, in a bread machine."
    },
    {
      "position": 2,
      "text": "Run Basic cycle and select Light or Medium for the crust."
    },
    {
      "position": 3,
      "text": "Remove when cycle ends. Cool completely before slicing."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

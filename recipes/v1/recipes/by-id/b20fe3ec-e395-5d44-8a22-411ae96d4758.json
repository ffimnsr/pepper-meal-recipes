  "id": "b20fe3ec-e395-5d44-8a22-411ae96d4758",
  "slug": "simple-slow-cooker-pinto-beans-and-ham",
  "name": "Simple Slow Cooker Pinto Beans and Ham",
  "recipe_type": "soup",
  "brief_description": "This crockpot pinto beans and ham dish is simmered in a slow cooker until tender for super flavorful comfort food that's great served with cornbread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 8 cups water and pinto beans to a boil in a large pot. Remove the pot from heat, cover, and let stand for 1 hour. Drain and rinse."
    },
    {
      "position": 2,
      "text": "Transfer beans to a slow cooker. Add ham bone, onion, garlic, and ham base. Pour in remaining 6 cups water or enough to cover beans."
    },
    {
      "position": 3,
      "text": "Cook on Low until beans are tender, about 8 hours."
    },
    {
      "position": 4,
      "text": "Remove ham bone, shred meat, and return to beans. Discard bone. Serve hot, seasoned with hot sauce, salt, and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 485,
  "preparation_time_minutes": 10,

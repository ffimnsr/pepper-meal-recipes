  "id": "d51a83dd-a0e6-593a-bd46-da42ccf956b3",
  "slug": "pizza-skulls-recipe-8363266",
  "name": "Pizza Skulls Are the Deliciously Spooky Snack You Need This Halloween",
  "recipe_type": "appetizer",
  "brief_description": "These trending Pizza Skulls, stuffed with pizza sauce, cheese, and pepperoni, took TikTok by storm, now you can easily make them at home with store-bought pizza dough and your favorite pizza toppings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400\u2109. Working on a clean surface, roll out dough to a 15- x 10-inch rectangle. Cut dough into 6 (5- x 5-inch) squares."
    },
    {
      "position": 3,
      "text": "Working with one piece of dough at a time, lay one square of dough in one cavity of a nonstick 6-cavity skull-shaped cakelet pan."
    },
    {
      "position": 4,
      "text": "Fill the dough by layering 1 tablespoon mozzarella, 1 tablespoon pizza sauce, 1 tablespoon pepperoni, 1 tablespoon mozzarella, 1 tablespoon pizza sauce, 1 tablespoon mozzarella, 1 tablespoon parmesan, and 1/4 teaspoon Italian seasoning in the center of the dough square."
    },
    {
      "position": 5,
      "text": "Fold sides of dough together and pinch tightly to seal, trimming and discarding any excess dough if necessary."
    },
    {
      "position": 6,
      "text": "Repeat filling and sealing process with remaining dough squares and remaining cheese, pizza sauce, pepperoni, and Italian seasoning."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until baked through and lightly golden, 16 to 18 minutes."
    },
    {
      "position": 8,
      "text": "Carefully remove baked skulls from pan and transfer to a serving plate. Let cool 5 minutes before serving with additional pizza sauce for dipping, if desired. Recipe developed by Nicole Hopper"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

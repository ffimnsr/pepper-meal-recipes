  "id": "f431ee45-1309-58bb-bff5-3e446ea4998e",
  "slug": "lemon-cheesecake-mousse",
  "name": "Lemon Cheesecake Mousse",
  "recipe_type": "dessert",
  "brief_description": "Easy to prepare and perfect for entertaining in the hot summer months, this creamy, tangy, lemon mousse stars cream cheese and a homemade graham cracker crust.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend butter into crushed graham crackers in a bowl using a fork or an electric mixer until combined. Press 1 tablespoon crust mixture into the bottom of 12 dessert dishes or glasses."
    },
    {
      "position": 2,
      "text": "Dissolve sugar into lemon juice in a bowl using a spoon. Set aside."
    },
    {
      "position": 3,
      "text": "Whip cream cheese and sweetened condensed milk in a mixing bowl using an electric mixer on low speed until combined. Increase to medium speed and mix until smooth. Slowly add heavy cream while continuing to mix on medium speed until combined. Blend mixture on high speed for 2 minutes."
    },
    {
      "position": 4,
      "text": "Reduce mixing speed to medium; incorporate lemon-sugar mixture until well blended, adding extra lemon juice to taste if desired. Whip on high speed until mixture is fluffy and holds its shape when blades are lifted, 3 to 4 minutes. Spoon or pipe filling into prepared crusts."
    },
    {
      "position": 5,
      "text": "Refrigerate at least 1 hour until ready to serve. Sprinkle lemon zest on top of each serving. Garnish each with 1 quarter lemon slice and mint leaf."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

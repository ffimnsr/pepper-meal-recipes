  "id": "230921ca-fd42-55cb-a73e-790e2504bc9b",
  "slug": "mexican-rice-and-beans",
  "name": "Mexican Rice and Beans",
  "recipe_type": "main",
  "brief_description": "This Mexican beans and rice recipe is an easy vegetarian dish with poblanos, basmati rice, and pinto beans seasoned with paprika, oregano, and cumin.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a medium pot over medium-high heat. Cook and stir onion, poblano pepper, and garlic in hot oil for 2 to 3 minutes. Add rice and cook, stirring occasionally, until rice is completely coated in oil, about 2 minutes. Season with paprika, cumin, oregano, salt, and black pepper."
    },
    {
      "position": 2,
      "text": "Stir in tomato paste and cook for 1 to 2 minutes. Add vegetable broth and pinto beans. Bring to a boil; reduce heat to low. Cover and simmer until rice is tender, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Remove the pot from the heat, keep covered, and let stand for at least 5 minutes. Fluff with a fork."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

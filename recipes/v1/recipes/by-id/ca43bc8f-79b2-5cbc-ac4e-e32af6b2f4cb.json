{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ca43bc8f-79b2-5cbc-ac4e-e32af6b2f4cb",
  "slug": "chicken-cordon-bleu-sandwich",
  "name": "Chicken Cordon Bleu Sandwich",
  "recipe_type": "main",
  "brief_description": "Classic chicken cordon bleu flavors \u2014 chicken, ham, and Gruy\u00e8re \u2014 are all here in this easy, satisfying sandwich that takes half the effort to prepare.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with heavy-duty aluminum foil."
    },
    {
      "position": 2,
      "text": "Combine bread crumbs and 1 teaspoon melted butter in a small bowl."
    },
    {
      "position": 3,
      "text": "Melt 2 tablespoons butter in a saucepan over medium heat. Add ham and onion; cook until onion turns translucent, about 5 minutes. Stir in thyme; cook for 1 minute. Add flour; cook, stirring constantly, until flour smells nutty, about 3 minutes. Off heat, add 1/2 cup plus 1 tablespoon milk. Return saucepan to medium heat; cook, stirring constantly, until sauce thickens, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Off heat, add 1/2 cup Gruy\u00e8re cheese, Dijon, cayenne pepper, nutmeg, salt, and black pepper; stir to combine. Fold in chicken and pickle."
    },
    {
      "position": 5,
      "text": "Place toasted bread slices on the prepared baking sheet; divide and brush one side of each slice with remaining 1 tablespoon melted butter. Flip slices; top each with 1/4 chicken mixture. Divide and sprinkle remaining 1/4 cup Gruy\u00e8re cheese over sandwiches; top with bread crumb mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is bubbling and chicken mixture is hot, 15 to 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

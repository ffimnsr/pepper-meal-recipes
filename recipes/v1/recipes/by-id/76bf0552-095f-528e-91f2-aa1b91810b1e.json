  "schema_version": 1,
  "id": "76bf0552-095f-528e-91f2-aa1b91810b1e",
  "slug": "cheesy-mushroom-puff-pastry-bites-recipe-8647032",
  "name": "Cheesy Mushroom Puff Pastry Bites",
  "recipe_type": "appetizer",
  "brief_description": "This crispy puff pastry appetizer has a deliciously savory caramelized onion and mushroom filling topped with melted cheese for the perfect party bites.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray cups of two 12-cup mini muffin pans with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat. Add onion and cook until the edges of the onion begin to brown and caramelize, about 3 minutes. Add mushrooms and garlic, and cook until mushrooms are soft. Season with salt and pepper. Transfer vegetables to a paper towel-lined plate with a slotted spoon."
    },
    {
      "position": 3,
      "text": "Roll out puff pastry sheet into a horizontal rectangle on a large, lightly floured cutting board. Use a pizza slicer to cut pastry into 4 rows horizontally and 6 rows vertically so that you have 24 (2 \u00bd-inch) squares. Press each dough square into each mini muffin cup and prick with the tines of a fork."
    },
    {
      "position": 4,
      "text": "Divide mushroom mixture amongst pastry cups. Top with shredded Gruy\u00e8re and Parmesan cheeses. Sprinkle with thyme."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the pastry is puffed up and the corners are golden brown, about 15 minutes. Briefly cool in the pans on a wire rack before transferring the bites to a serving dish. Serve warm."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

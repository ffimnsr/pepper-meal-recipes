  "id": "fc356da8-dd7b-55ed-8da5-07a59f574799",
  "slug": "sesame-parmesan-popcorn",
  "name": "Sesame Parmesan Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Freshly popped popcorn is tossed with butter, sesame oil, and Parmesan cheese in this light and flavorful snack that's ready in minutes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Pop popcorn in a hot air popper or microwave popper according to manufacturer's instructions. Pour into a large bowl."
    },
    {
      "position": 2,
      "text": "Mix butter and sesame oil together in a small bowl. Drizzle over popcorn. Add Parmesan cheese, salt, and pepper; toss well to coat."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,

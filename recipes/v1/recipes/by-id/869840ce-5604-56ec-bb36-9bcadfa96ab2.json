  "id": "869840ce-5604-56ec-bb36-9bcadfa96ab2",
  "slug": "fluffy-white-frosting",
  "name": "Fluffy White Frosting",
  "recipe_type": "dessert",
  "brief_description": "This fluffy, egg-white frosting is made by combining hot syrup with whipped egg whites to create a meringue-style frosting for your favorite cake.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir sugar, water, and cream of tartar together in a saucepan. Cook over medium-high heat until sugar is dissolved and syrup is bubbly."
    },
    {
      "position": 2,
      "text": "Beat egg whites and vanilla in a glass, metal, or ceramic bowl until foamy. Gradually add hot syrup mixture, continuing to beat until stiff peaks form, about 7 to 10 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

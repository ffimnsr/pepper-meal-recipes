  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c1c72c2f-bbc3-5476-b332-71afd540c701",
  "slug": "lahmacun-turkish-pizza",
  "name": "Lahmacun Turkish Pizza",
  "recipe_type": "main",
  "brief_description": "A flavorful sauce of ground lamb, herbs, tomatoes, and bell peppers tops this Turkish flatbread pizza.",
  "cuisine": "Turkish American",
  "instructions": [
    {
      "position": 1,
      "text": "Make lamb sauce: Combine onion, parsley, bell peppers, basil, mint, lemon juice, olive oil, garlic, paprika, coriander seed, and cumin. Pulse until vegetables are finely chopped. Add tomatoes and process until mixture is a thick puree."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium heat. Add lamb, pureed vegetable mixture, and tomato paste; mix well. Cook and stir until lamb is cooked through, 10 to 15 minutes. Stir in cayenne pepper and salt to taste. Transfer mixture to a shallow baking dish to cool to room temperature. Cover with plastic wrap and refrigerate, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Make dough: Dissolve yeast and sugar in 1 cup warm water. Combine flour and salt in a large bowl and stir well. Add 1/2 cup water and oil to yeast mixture and pour over flour mixture. Use your hands to mix dough. Turn dough out onto a lightly floured surface and knead until smooth and elastic, about 8 minutes."
    },
    {
      "position": 4,
      "text": "Shape dough into a ball and transfer to an oiled bowl. Cover with a wet towel and let rise in a warm place until doubled in bulk, about 1 hour. Remove lamb sauce from the refrigerator and allow to come up to room temperature."
    },
    {
      "position": 5,
      "text": "Meanwhile, make garlic sauce: Combine yogurt, parsley, and garlic in a small bowl. Season with salt and pepper. Stir well and set aside."
    },
    {
      "position": 6,
      "text": "Punch dough down, transfer it to a floured work surface, and cut into 10 portions. Shape each portion into a round. Flatten each round with your hand; use a rolling pin to roll each piece into a 10-inch circle. The dough should be thin, like a crepe. Place the rounds on parchment paper."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 8,
      "text": "Stir lamb sauce and spoon it onto a dough round. Spread it thinly to the edges and press down lightly so it sticks. Place on the prepared baking sheets."
    },
    {
      "position": 9,
      "text": "Bake pizzas on the lowest oven rack in the preheated oven until the edges are a light tan color, 8 to 10 minutes. Place on a wire rack to cool. The pizzas can be stored in an airtight container in the refrigerator for 3 days or in the freezer for 3 months. To reheat, place pizzas in a 350 degrees F oven (175 degrees C) for 8 minutes."
    },
    {
      "position": 10,
      "text": "Assemble lahmacun: Drizzle pizzas with garlic sauce, top with shredded cabbage, and roll up to eat."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 120,

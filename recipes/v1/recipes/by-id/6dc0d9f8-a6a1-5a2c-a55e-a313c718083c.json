  "id": "6dc0d9f8-a6a1-5a2c-a55e-a313c718083c",
  "slug": "simple-broccolini",
  "name": "Simple Broccolini",
  "recipe_type": "drink",
  "brief_description": "Broccolini are blanched, then pan-fried with garlic and a squeeze of lemon juice for a vibrant side dish that's ready to serve in just 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place broccolini in a large skillet with about 2 inches of water; bring to a boil and cook until bright green, 1 to 2 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Heat olive oil in the same skillet over medium heat. Stir in garlic and cook until golden and fragrant, 1 to 2 minutes. Add broccolini; cook and stir until heated through, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Squeeze lemon juice over broccoli and season with red pepper flakes, salt, and pepper."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

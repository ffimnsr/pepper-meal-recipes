  "id": "c42f0775-f64a-5f61-ade8-39e864a606a6",
  "slug": "jersey-fresh-stewed-tomatoes",
  "name": "Jersey Fresh Stewed Tomatoes",
  "recipe_type": "side",
  "brief_description": "Try this easy stewed tomato recipe for thick stewed tomatoes made from fresh vegetables from your garden. It's so much better than anything from a can!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook and stir tomatoes, bell pepper, onion, and celery in a large skillet over medium heat until fragrant, about 10 minutes. Reduce heat and continue to cook until bell pepper and onion are soft, about 5 minutes. Stir in sugar, salt, oregano, basil, and pepper."
    },
    {
      "position": 3,
      "text": "Whisk water and cornstarch together in a small bowl."
    },
    {
      "position": 4,
      "text": "Stir into the skillet. Simmer tomato mixture until thickened, about 5 minutes. Serve warm and enjoy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

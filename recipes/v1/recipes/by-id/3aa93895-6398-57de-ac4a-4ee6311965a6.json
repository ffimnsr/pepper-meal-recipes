  "id": "3aa93895-6398-57de-ac4a-4ee6311965a6",
  "slug": "bean-and-cheese-toasterdilla",
  "name": "Bean and Cheese Toasterdilla",
  "recipe_type": "main",
  "brief_description": "This easy recipe shows you how to fill a tortilla with refried beans and cheese and cook it in the toaster for a toaster quesadilla, or toasterdilla!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Lay tortillas flat on a clean work surface. Spread refried beans down the middle third from top to bottom, leaving a 1-inch space halfway down to allow for a fold. Sprinkle cheese on top, lightly pressing into the beans."
    },
    {
      "position": 2,
      "text": "Fold the left side over the beans, then the right side on top, so the two sides are overlapping in the middle. Fold in half vertically so the bottom edge meets the top edge."
    },
    {
      "position": 3,
      "text": "Place the quesadillas into the toaster slots and set the toaster to medium heat. Toast for 1 cycle. Carefully remove quesadillas and reverse the vertical fold, so that the inside is now the outside. Return to the toaster and toast until lightly browned, about half a toasting cycle."
    },
    {
      "position": 4,
      "text": "Carefully remove the hot quesadillas to a plate. Cut in half at the fold to make 4 pieces."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

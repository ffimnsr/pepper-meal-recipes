  "id": "1c2d1cd2-2072-5920-8f4b-457e4b0fb09a",
  "slug": "beginner-chicken-and-dumplings",
  "name": "Beginner Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "It's easy to make chicken and dumplings with this recipe using boneless breast and thigh meat. Baking mix dumplings quickly add the finishing touch.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onions; cook and stir until they begin to soften, about 3 minutes. Add chicken; cook and stir until no longer pink in the center, about 10 minutes. Add water, condensed soup, bouillon cubes, and poultry seasoning; stir to combine. Increase the heat to medium-high and bring to a simmer."
    },
    {
      "position": 2,
      "text": "Meanwhile, pour milk into a mixing bowl. Add baking mix and stir until a dough forms."
    },
    {
      "position": 3,
      "text": "Drop spoonfuls of dumpling mix into simmering soup. Reduce the heat to medium-low, cover, and simmer for 10 minutes. Turn dumplings over and continue to simmer until no longer doughy in the center, about 10 more minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

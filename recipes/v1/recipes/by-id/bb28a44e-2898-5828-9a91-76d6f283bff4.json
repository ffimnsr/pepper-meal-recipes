  "id": "bb28a44e-2898-5828-9a91-76d6f283bff4",
  "slug": "easy-lemon-cookies",
  "name": "Easy Lemon Cookies",
  "recipe_type": "dessert",
  "brief_description": "These lemon cake mix cookies are easy to prepare with just 5 ingredients. They're rolled in powdered sugar and baked until sweet, tart, and crinkly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour cake mix into a large bowl. Stir in eggs, oil, and lemon extract until well blended."
    },
    {
      "position": 3,
      "text": "Working in batches, drop teaspoonfuls of dough into a bowl of confectioners' sugar. Roll dough in sugar until lightly coated, then place 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the bottoms are light brown, 6 to 9 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

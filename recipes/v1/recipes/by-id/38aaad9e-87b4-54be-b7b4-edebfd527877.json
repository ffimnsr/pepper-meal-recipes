  "id": "38aaad9e-87b4-54be-b7b4-edebfd527877",
  "slug": "buckwheat-and-orange-shortbread-cookies-recipe-8684166",
  "name": "Buckwheat and Orange Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "All-butter shortbread with orange zest, plus dark buckwheat flour for a nutty, savory flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine butter, light brown sugar, and white sugar in a bowl and beat with an electric mixer until fluffy, 2 to 3 minutes. Beat in egg yolks and orange zest."
    },
    {
      "position": 3,
      "text": "Combine flour and buckwheat flour in a small bowl. Stir flour mixture into butter mixture until you have a soft dough."
    },
    {
      "position": 4,
      "text": "Divide the dough in halves and set on a sheet of parchment paper or plastic wrap. Shape into 2 logs, about 2 inches in diameter, using the paper or wrap, and wrap up tightly. Refrigerate until firm, at least 6 hours."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line 2 baking sheets with parchment paper. Unwrap dough logs and brush each log with beaten egg."
    },
    {
      "position": 6,
      "text": "Pour demerara sugar into a shallow dish and roll the egg-washed logs in the sugar, until encrusted all around with sugar."
    },
    {
      "position": 7,
      "text": "Cut each log into 1/2-inch slices and arrange on the prepared baking sheets. Sprinkle with buckwheat groats if you like."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until lightly browned, 12 to 14 minutes. Cookies will firm up as they cool."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "383fad9e-53cb-5137-b702-2948cee4a3b2",
  "slug": "ultimate-gulf-coast-gumbo",
  "name": "Ultimate Gulf Coast Gumbo",
  "recipe_type": "soup",
  "brief_description": "This gumbo recipe is made with shrimp, crab, chicken, sausage, vegetables, and Cajun spices. Serve it over rice with garlic bread and a cold beer.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Peel and devein shrimp. Place shrimp into a bowl; cover and refrigerate until needed. Place shrimp heads and shells into a large pot."
    },
    {
      "position": 2,
      "text": "Pour 2 quarts water into the pot, cover, and simmer over medium-low heat until liquid is reduced by half. Strain out and discard shrimp heads and shells. Reserve shrimp broth."
    },
    {
      "position": 3,
      "text": "Heat oil in a very large stockpot over medium-high heat. Add flour; cook and stir with a long-handled spoon until dark brown and flour puffs and starts to absorb oil, 10 to 15 minutes. Slowly stir in chicken broth and 1 cup water. Place chicken into the pot; add tomatoes, onions, celery, bell pepper, garlic, seafood seasoning, salt, cayenne pepper, and bay leaves. Bring to a boil and cook until chicken is no longer pink at the bone and the juices run clear, about 1 1/2 hours. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove chicken from the pot and set aside until cool enough to handle. Remove and discard bones; chop meat into 1-inch pieces."
    },
    {
      "position": 5,
      "text": "Return chopped chicken to the pot, along with reserved shrimp broth, crabmeat, sausage, shrimp, and fil\u00e9 powder; stir from the bottom of the pot to combine. Bring to a boil, then immediately remove from the heat."
    },
    {
      "position": 6,
      "text": "Stir gumbo from the bottom for 1 minute. Remove bay leaves and serve."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 90,
  "rest_time_minutes": null,

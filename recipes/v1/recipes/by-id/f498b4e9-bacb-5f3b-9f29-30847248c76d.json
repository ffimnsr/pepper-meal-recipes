  "id": "f498b4e9-bacb-5f3b-9f29-30847248c76d",
  "slug": "chocolate-covered-matzo",
  "name": "Chocolate-Covered Matzo",
  "recipe_type": "dessert",
  "brief_description": "Gooey chocolate covered matzo is the perfect Passover dessert and a great way to use leftover matzo. Get creative and try it with white chocolate too!",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Line a baking sheet with aluminum foil and spray with cooking spray; arrange matzo boards to fit in a single layer, breaking if necessary."
    },
    {
      "position": 3,
      "text": "Combine butter and brown sugar together in a saucepan over medium heat; bring to a boil, stirring constantly, then boil for about 3 minutes."
    },
    {
      "position": 4,
      "text": "Pour butter mixture evenly over matzo on the prepared baking sheet. Transfer baking sheet into the preheated oven and immediately reduce heat to 350 degrees F (175 degrees C); bake for 10 minutes. Reduce heat to 325 degrees F (165 degrees C) if the matzo are smoking too much."
    },
    {
      "position": 5,
      "text": "Remove baking sheet from oven and sprinkle matzo with chocolate chips. Let stand to melt chocolate, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Spread melted chocolate over matzo; place in refrigerator until chilled and set. Break into pieces when cooled."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "bff20282-ae22-5a30-9a5d-f39275debdec",
  "slug": "barbecued-pork-skewers",
  "name": "Barbecued Pork Skewers",
  "recipe_type": "main",
  "brief_description": "Chef John's BBQ pork skewers are glazed with barbecue sauce and grilled to juicy perfection \u2014 they're perfect for summer entertaining!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Slice pork shoulder in half lengthwise, then slice each half crosswise into 1/8-inch-thick slices."
    },
    {
      "position": 2,
      "text": "Transfer pork to a mixing bowl; add onion, garlic, brown sugar, salt, pepper, paprika, cumin, and cayenne, and mix with your hands until thoroughly combined. Cover tightly with plastic wrap and refrigerate for 4 to 8 hours."
    },
    {
      "position": 3,
      "text": "When ready to cook, preheat a charcoal grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Weave pork slices onto metal skewers, folding any longer pieces in half as needed; press slices snugly together."
    },
    {
      "position": 5,
      "text": "Cook skewers on the preheated grill, turning frequently, until browned on the outside and no longer pink in the center, about 30 minutes. Brush on barbecue sauce and turn skewers several times until sauce caramelizes, about 10 minutes more. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c01fdcce-1844-5537-9b84-fcd6df15d454",
  "slug": "mothers-day-garden",
  "name": "Mother's Day Garden",
  "recipe_type": null,
  "brief_description": "Use an array of colorful fruits to create a gorgeous garden you and your kids can munch on together.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In large saucepan melt butter over low heat. Add marshmallows and stir until completely melted. Remove from heat."
    },
    {
      "position": 2,
      "text": "Add Kellogg's\u00ae Rice Krispies\u00ae cereal. Stir until well coated."
    },
    {
      "position": 3,
      "text": "Using buttered spatula or wax paper evenly press mixture into 13 x 9 x 2-inch pan coated with cooking spray. Cool."
    },
    {
      "position": 4,
      "text": "Cut fruits into flower shapes and arrange on top. Use tinted frosting to add flower stems and grass. Cut into 2-inch squares. Serve the same day."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

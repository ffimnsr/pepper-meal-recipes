  "id": "7cff465c-20c5-5075-8038-1c6c0ad1f1f1",
  "slug": "patsys-half-baked-blueberry-pie",
  "name": "Patsy's Half-Baked Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "Patsy's half-baked blueberry pie recipe has a layer of cream cheese topped with fresh blueberries, coated with a blueberry filling, and served chilled.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Press pie crust dough into a 9-inch pie plate; poke small holes into dough with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until light brown, about 15 minutes. Cool to room temperature."
    },
    {
      "position": 4,
      "text": "Place cream cheese in a small microwave-safe bowl. Microwave on high to soften, about 20 seconds. Spread cream cheese into bottom of crust; layer 2 \u00bd cups blueberries on top."
    },
    {
      "position": 5,
      "text": "Whisk water and cornstarch in a small bowl until cornstarch is dissolved; stir into remaining 2 \u00bd cups blueberries, sugar, and lemon zest in a medium saucepan. Cook over medium heat until thick, 5 to 10 minutes. Spread blueberry mixture into pie crust."
    },
    {
      "position": 6,
      "text": "Cool pie in the refrigerator until set, at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

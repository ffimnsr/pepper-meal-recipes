  "schema_version": 1,
  "id": "df6de928-51a3-5760-9e98-721a46d6ff51",
  "slug": "drumstick-sundae-jars-recipe-11769556",
  "name": "Drumstick Sundae Jars",
  "recipe_type": "dessert",
  "brief_description": "Like those Drumstick ice cream cones from childhood, but ten times better! Chef John's ice cream sundae jars let you enjoy the best parts\u2014the chocolate shell coating studded with peanuts\u2014in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 4 jars in the freezer."
    },
    {
      "position": 2,
      "text": "Use a serrated knife to score around the bottom of the sugar cones, about 1 1/2 to 2 inches from the tip. Snap the tip off, and reserve."
    },
    {
      "position": 3,
      "text": "Break or smash the rest of the cones into small pieces; transfer into a bowl."
    },
    {
      "position": 4,
      "text": "Use the bottom of the Mason jar to trace 12 circles on a piece of parchment paper. Turn the paper over before using."
    },
    {
      "position": 5,
      "text": "Add chocolate chips to a microwave-safe bowl. Remove 2 tablespoons to a smaller bowl and reserve."
    },
    {
      "position": 6,
      "text": "Microwave chocolate chips for 30 seconds, then stir and continue to microwave, 10 to 15 seconds at a time, until chocolate is hot and will liquefy when stirred. Stir in reserved chocolate chips, and continue to stir until completely melted."
    },
    {
      "position": 7,
      "text": "Transfer at least 1 rounded teaspoon chocolate into the center of each circle on the parchment, and spread evenly to the outline. Dip the base of each reserved cone tip into chocolate; set each one upright in the center of 1 of the chocolate circles."
    },
    {
      "position": 8,
      "text": "Sprinkle chopped peanuts onto the exposed chocolate of all 12 circles. Let sit until completely cooled and firm, 30 to 60 minutes."
    },
    {
      "position": 9,
      "text": "Spoon remaining melted chocolate over the bowl of crushed cones and stir to coat. Spread out in a single layer on a piece of parchment; let cool until firm."
    },
    {
      "position": 10,
      "text": "To assemble each jar, make 2 layers of ice cream, cone pieces, and peanut chocolate circles, filling the jar about 2/3 full. Add a top layer of ice cream, filling nearly to the rim of the jar; top with a chocolate peanut circle containing a cone."
    },
    {
      "position": 11,
      "text": "As each jar is assembled, transfer quickly into the freezer. Cover loosely and let freeze for 1 hour before serving for best results."
    }
  ],

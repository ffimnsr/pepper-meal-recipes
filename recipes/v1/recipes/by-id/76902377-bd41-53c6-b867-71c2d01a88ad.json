  "id": "76902377-bd41-53c6-b867-71c2d01a88ad",
  "slug": "horchata-latte-cake-recipe-11822802",
  "name": "Horchata Latte Cake",
  "recipe_type": "dessert",
  "brief_description": "This horchata latte cake is soaked with additional horchata after baking. Topped with whipped topping, espresso powder. and cinnamon, it's a dirty horchata in cake form!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (or 175 degrees C). Grease and flour a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Whisk together flour, baking powder, salt, and cinnamon in a bowl."
    },
    {
      "position": 3,
      "text": "Beat butter in a large bowl with an electric mixer on medium for 30 seconds. Gradually beat in sugar 1/4 cup at a time. Scrape bowl. Beat until light and fluffy, 2 minutes more."
    },
    {
      "position": 4,
      "text": "Add eggs one at a time, beating after each. Beat in 4 teaspoons espresso powder, the vanilla, and almond extract."
    },
    {
      "position": 5,
      "text": "Alternately add flour mixture and 1 3/4 cups horchata, beating on low after each addition until just combined. Batter may appear curdled, it will be fine. Spread batter into prepared pan."
    },
    {
      "position": 6,
      "text": "Bake until a toothpick inserted into the center of the cake comes out clean, 35 to 40 minutes."
    },
    {
      "position": 7,
      "text": "Whisk together remaining 3/4 cup horchata, the sweetened condensed milk, and remaining 2 teaspoons espresso powder."
    },
    {
      "position": 8,
      "text": "Poke holes all over cake with a skewer or chopstick. Gradually pour horchata mixture evenly over the cake."
    },
    {
      "position": 9,
      "text": "Cool cake completely on a wire rack."
    },
    {
      "position": 10,
      "text": "Top cake with whipped topping. Cover and chill at least 1 hour."
    },
    {
      "position": 11,
      "text": "Sprinkle with additional cinnamon and espresso powder before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

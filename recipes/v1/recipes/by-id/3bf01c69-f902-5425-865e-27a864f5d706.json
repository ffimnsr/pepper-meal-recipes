  "id": "3bf01c69-f902-5425-865e-27a864f5d706",
  "slug": "baked-chicken-tortellini-alfredo",
  "name": "Baked Chicken Tortellini Alfredo",
  "recipe_type": "main",
  "brief_description": "This baked tortellini Alfredo with grilled chicken is a guaranteed hit with a rich and creamy Alfredo sauce made with white wine, Parmesan, and nutmeg.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Add tortellini, stir, and return to a boil. Cook, uncovered and stirring occasionally, until tortellini float to the surface and the filling is hot, about 3 minutes. Drain."
    },
    {
      "position": 3,
      "text": "While the tortellini is cooking, melt butter in a saucepan over medium heat. Add flour and cook, stirring constantly, for 2 to 3 minutes. Pour in heavy cream and chicken broth; mix well and simmer for 5 minutes, making sure not to boil. Add Parmigiano-Reggiano cheese, white wine, garlic, nutmeg, salt, and pepper. Cook, stirring constantly, until cheese is melted and sauce is smooth."
    },
    {
      "position": 4,
      "text": "Toss drained tortellini and chicken together in an ungreased 11x17-inch casserole dish. Pour Alfredo sauce over top, then cover with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and golden brown, 20 to 30 minutes. Garnish with fresh parsley and serve hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

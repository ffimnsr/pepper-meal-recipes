  "id": "00ca8495-02f3-5756-bcb4-11f3b547c4be",
  "slug": "potato-latkes-from-simply-potatoes",
  "name": "Potato Latkes from Simply Potatoes",
  "recipe_type": "breakfast",
  "brief_description": "These simple hash brown latkes are made with whole wheat flour plus green onions for a mild, peppery flavor. Top with applesauce or sour cream.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, stir together hash browns, egg substitute, flour, green onion, pepper, salt, and baking powder."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a 12-inch nonstick skillet over medium heat."
    },
    {
      "position": 3,
      "text": "Cook four latkes at a time. For each latke, spread 1/4 cup potato mixture into a 3 1/2-inch circle in the hot skillet. Cook for 4 to 5 minutes, turning once. Repeat with remaining potato mixture, adding more oil to the skillet as needed. Season with salt and pepper if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

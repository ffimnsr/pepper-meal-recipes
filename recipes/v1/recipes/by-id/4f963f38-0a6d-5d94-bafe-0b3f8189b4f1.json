  "id": "4f963f38-0a6d-5d94-bafe-0b3f8189b4f1",
  "slug": "greek-yogurt-bowls-with-granola",
  "name": "Greek Yogurt Bowls with Granola",
  "recipe_type": "dessert",
  "brief_description": "Breakfast, brunch, or post-workout, these Greek yogurt bowls with homemade granola will satisfy your hunger and sweet tooth without busting your diet.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line 2 rimmed baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine walnuts and honey in a jar, cover, and set aside."
    },
    {
      "position": 3,
      "text": "Combine oats, groats, buckwheat flakes, almonds, hazelnuts, sunflower seeds, cinnamon, nutmeg, allspice, and ginger in a bowl; toss until completely mixed."
    },
    {
      "position": 4,
      "text": "Stir together olive oil, coconut sugar, and brown rice syrup in a small saucepan over low heat until combined. Cook until heated through, about 5 minutes. Remove from the heat and stir in vanilla extract. Pour over the dry mixture and mix until evenly combined; spread over the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 minutes. Stir, rotate baking sheets, and bake for another 15 minutes. Stir, rotate again, and bake until golden brown, about 15 more minutes. Sprinkle coconut, flax seeds, and raisins over the granola and toss to mix. Turn the oven off, but leave trays inside and prop the oven door open with a wooden spoon for 10 minutes. Remove from the oven and allow to cool."
    },
    {
      "position": 6,
      "text": "Place 1/2 cup yogurt in a deep single-serve bowl. Top with a scant 1/3 cup granola, 1/4 cup raspberries, and 1/8 cup walnut-honey mix. Repeat to assemble remaining bowls."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

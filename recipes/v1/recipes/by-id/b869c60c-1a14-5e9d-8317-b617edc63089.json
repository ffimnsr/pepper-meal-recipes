  "id": "b869c60c-1a14-5e9d-8317-b617edc63089",
  "slug": "rice-pudding-i",
  "name": "Rice Pudding I",
  "recipe_type": "dessert",
  "brief_description": "Baked rice pudding flavored with nutmeg and cinnamon and flecked with raisins.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a saucepan, bring salted water to a boil. Add rice, reduce heat, cover and simmer for 20 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine 2 1/2 cups cooked rice, sugar, melted butter, milk, eggs, cinnamon, nutmeg and raisins and mix well. Pour into a 9x13 inch baking dish."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until top is golden, 30 to 60 minutes. Serve warm or cold."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,

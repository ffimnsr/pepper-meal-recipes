  "id": "e76ca5f8-e50f-52de-b24f-84406bb67b9f",
  "slug": "nans-peanut-butter-fudge-with-marshmallows",
  "name": "Nan's Peanut Butter Fudge with Marshmallows",
  "recipe_type": "dessert",
  "brief_description": "This quick and easy peanut butter fudge is made with crunchy peanut butter, evaporated milk, and mini marshmallows--it will delight your entire family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter an 8-inch square pan."
    },
    {
      "position": 2,
      "text": "Combine sugar, evaporated milk, and butter in an electric skillet. Set control to 260 degrees F (120 degrees C)."
    },
    {
      "position": 3,
      "text": "Bring to a boil and boil 5 minutes, stirring constantly. Turn off heat and add peanut butter, marshmallows, and vanilla extract. Stir until marshmallows and peanut butter are melted and blended. Pour into the prepared pan."
    },
    {
      "position": 4,
      "text": "Allow to cool and cut into squares."
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

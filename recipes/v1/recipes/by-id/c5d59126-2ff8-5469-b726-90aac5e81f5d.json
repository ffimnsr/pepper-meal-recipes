  "slug": "smiling-caprese-salad",
  "name": "Smiling Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "You get all the delicious flavor of a Caprese salad in minutes when you just toss tomatoes, mozzarella cheese, and basil with a simple balsamic dressing.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir tomatoes, olive oil, balsamic vinegar, and basil together in a large salad bowl; gently fold in mozzarella cheese ; season with salt and black pepper. Chill before serving."
    }
  ],

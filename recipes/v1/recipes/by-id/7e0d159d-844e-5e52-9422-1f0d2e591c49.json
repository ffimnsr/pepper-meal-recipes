  "slug": "quick-strawberry-shortcake",
  "name": "Quick Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This quick strawberry shortcake recipe is truly quick, easy, and delicious. It uses condensed milk, whipped cream, and shortcake cups to save time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place strawberries and sugar in a bowl; stir in condensed milk and mash with a fork until juicy. Cover the bowl; refrigerate 30 to 60 minutes."
    },
    {
      "position": 2,
      "text": "Place each shortcake cup on a dessert plate; top with strawberries and juice. Top with whipped cream; serve."
    }
  ],

  "id": "ccf0fb5f-9188-51f5-ae21-145a0e437105",
  "slug": "applesauce",
  "name": "Applesauce",
  "recipe_type": "appetizer",
  "brief_description": "This easy homemade applesauce comes together in 35 minutes with just apples, sugar, and spices for a family favorite that\u2019s perfect fresh or canned.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apples, water, cinnamon, and cloves in a 2-quart saucepan over medium heat. Bring to a boil, then reduce heat to medium-low and simmer until apples are tender, about 10 minutes. Stir in sugar and continue simmering for 5 minutes more."
    },
    {
      "position": 2,
      "text": "Allow the applesauce to cool, then transfer to an airtight container. Store in the refrigerator for up to three days."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

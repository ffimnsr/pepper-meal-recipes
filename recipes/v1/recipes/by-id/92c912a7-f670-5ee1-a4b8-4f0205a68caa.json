  "id": "92c912a7-f670-5ee1-a4b8-4f0205a68caa",
  "slug": "one-pot-lemon-pasta-recipe-12018974",
  "name": "One-Pot Lemon Pasta",
  "recipe_type": "soup",
  "brief_description": "This one-pot lemon pasta is a quick, brightly flavored side dish that comes together in just two steps. Simmered right in the broth and finished with lemon zest, lemon juice, Parmesan, and black pepper, it\u2019s creamy without heavy cream and perfect with grilled meat or seafood.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter and olive oil in a stock pot over medium heat. Add garlic and stir until fragrant, about 30 seconds. Pour in chicken stock and bring to a medium boil. Add pasta and cook until most of the stock is absorbed and pasta is tender with a bite, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add lemon juice, lemon zest, and black pepper. Stir, then add Parmesan cheese. Stir until cheese is melted and the pasta is creamy. Garnish with parsley, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

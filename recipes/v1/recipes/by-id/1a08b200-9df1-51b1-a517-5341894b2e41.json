  "id": "1a08b200-9df1-51b1-a517-5341894b2e41",
  "slug": "hungarian-dill-potato-salad-recipe-11945457",
  "name": "Hungarian Dill Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This Hungarian dill potato salad is a quick-to-make dish from classic Hungarian cuisine. It has a subtle vinegar dressing with fresh dill and no mayonnaise. It\u2019s perfect for picnics, backyard BBQs, potlucks, or as a light, healthy side dish.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot, and fill with salty water, covering potatoes by about 1 inch. Bring to a boil over medium-high heat, and cook until tender, but still hold their shape, 12 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Drain potatoes, let sit for 5 minutes until cool enough to handle, and cut each in half. Place in a bowl, and stir in red onion and dill."
    },
    {
      "position": 3,
      "text": "Whisk oil and vinegar together in a small bowl and drizzle over potatoes. Sprinkle with sugar, and toss until well coated."
    },
    {
      "position": 4,
      "text": "Season with salt and pepper, and serve at room temperature."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",
